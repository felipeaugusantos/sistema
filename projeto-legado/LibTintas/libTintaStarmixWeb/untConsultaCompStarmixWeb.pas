{****************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta StarmixWeb *}
{*************************************************************************AC*}
unit untConsultaCompStarmixWeb;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompStarmixWeb = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompStarmixWeb }

procedure TConsultaCompStarmixWeb.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadStaWebNovasFormulas');
end;

end.
