function TCadastroNovasFormulasKresil.ValidarBase(const strCodbas, strProduto: string; const tela: ITelaCadLibTintas): Boolean;
Var
  qryGen: IDataSet;
begin
  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.Close;
  qryGen.SQL := '';
  qryGen.SQL := qryGen.SQL + '  SELECT                    ';
  qryGen.SQL := qryGen.SQL + '    *                       ';
  qryGen.SQL := qryGen.SQL + '  FROM                      ';
  qryGen.SQL := qryGen.SQL + '    KRE_CADBAS              ';
  qryGen.SQL := qryGen.SQL + '  INNER JOIN CADITE ON              ';
  qryGen.SQL := qryGen.SQL + '    BAS_CODITE = ITE_CODITE                 ';
  qryGen.SQL := qryGen.SQL + '  WHERE                     ';
  qryGen.SQL := qryGen.SQL + '    BAS_BASE__ = :CODBAS         ';

  If Not TStrUtils.fEmptyStr(strProduto) Then
    qryGen.SQL := qryGen.SQL + ' AND    BAS_PRODUT = :PRODUT            ';

  qryGen.ParamByName('CODBAS').AsString := strCodBas;

  If Not TstrUtils.fEmptyStr(strProduto) Then
    qryGen.ParamByName('PRODUT').AsString := strProduto;

  qryGen.Open;

  Result := Not qryGen.IsEmpty;
end;

function TCadastroNovasFormulasKresil.ValidarColorante(
  const strCodCol: string): Boolean;
begin
  Result := TAutcomTintaFactory.Get.GetValorCampo(
    ' SELECT                     ' +
    '   COUNT(0) AS QTD          ' +
    ' FROM                       ' +
    '   KRE_CADCOL               ' +
    ' INNER JOIN CADITE ON ITE_CODITE = COL_CODITE ' +
    ' WHERE COL_CODCOL = :CODCOL ',
    'QTD', [strCodCol]
  ) > 0;
end;

function TCadastroNovasFormulasKresil.ValidarColoranteJaCadastrado(
  const tela: ITelaCadLibTintas; const strCodCol, strNomCam: string): Boolean;
var
  intCont: Integer;
begin
  Result := True;
  For intCont := 1 To 20 Do
  Begin
    If (RightStr(strNomCam, 2) <> TStrUtils.fStrZero(intCont,2)) And
       (Not TStrUtils.fEmptyStr( tela['dbeForm' + TStrUtils.fStrZero(intCont,2)]['Text'].Value )) Then
    Begin
      If tela['dbeForm' + TStrUtils.fStrZero(intCont,2)]['Text'].Value = strCodCol Then
        Result := False;
    End;
  End;
end;

function TCadastroNovasFormulasKresil.VerificarNovaFormulaMovimentada: Boolean;
begin
  Result := True;
  Try
    Try
      Result := fVerificarNovaFormulaMovimentada('SELECT COUNT(0) AS QTD '+
                                                 '  FROM %0:s '+
                                                 ' INNER JOIN KRE_CADKRE ON %1:s_ITETIN = KRE_MD5KEY '+
                                                 ' WHERE %1:s_IDEPRO = "KRE" '+
                                                 '   AND KRE_CODIGO = :CODNFM',
        [GetQueryCadastro.FieldByName('NFM_CODIGO').AsString]);
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
  End;
end;

