function TCadastroNovasFormulasJotun.fRetDescUnidadesBase: String;
var
  qryGen     : IDataSet;
  strMens    : String;
//  intPosBase : Integer;
//  intTamDesc : Integer;
begin
  Result := '';

  strMens := '';

  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.SQL := ' SELECT                         ' +
                '   BAS_CODUNI                   ' +
                ' FROM                           ' +
                '   JOT_CADBAS                   ' +
                '  INNER JOIN CADITE             ' +
                '     ON ITE_CODITE = BAS_CODITE ' +
                ' WHERE BAS_CODBAS = :CODBAS     ' +
                '   AND BAS_TIPO__ = :TIPO__     ' ;
//                '   AND BAS_DESCRI = :DESCRI     ' ;

  If (Not blnAtualizaUnidade) And (Not TStrUtils.fEmptyStr(strUnidadeMenor)) Then
    qryGen.SQL := qryGen.SQL + ' AND BAS_CODUNI <> :CODUNI ';

//  intPosBase := Length(GetQueryCadastro.FieldByName('NFM_BASE__').AsString) + 2;
//  intTamDesc := Length(GetQueryCadastro.FieldByName('NFM_DESCRI').AsString);

//  qryGen.ParamByName('DESCRI').AsString := Copy(GetQueryCadastro.FieldByName('NFM_DESCRI').AsString,1,(intTamDesc - intPosBase));
  qryGen.ParamByName('TIPO__').AsString := GetQueryCadastro.FieldByName('NFM_TIPO__').AsString;

  qryGen.ParamByName('CODBAS').AsString := GetQueryCadastro.FieldByName('NFM_BASE__').AsString;

  If (Not blnAtualizaUnidade) And (Not TStrUtils.fEmptyStr(strUnidadeMenor)) Then
    qryGen.ParamByName('CODUNI').AsString := strUnidadeMenor;

  qryGen.Open;

  qryGen.First;
  While Not qryGen.Eof Do
  Begin

    If qryGen.FieldByName('BAS_CODUNI').AsString = 'GL' Then
      Result := Result + 'Galao';

    If qryGen.FieldByName('BAS_CODUNI').AsString = 'LA' Then
      Result := Result + 'Lata';

    qryGen.Next;
  End;

  If Pos('Galao', Result) > 0 Then
  Begin
    If qryGen.RecordCount = 1 Then
      strMens := strMens + 'Galão '
    Else If (qryGen.RecordCount = 2) And (Pos('Litro', Result) <= 0) Then
      strMens := strMens + 'Galão e '
    Else If qryGen.RecordCount = 2 Then
      strMens := strMens + 'Galão '
    Else If qryGen.RecordCount > 2 Then
      strMens := strMens + 'Galão e ';
  End;

  If Pos('Lata', Result) > 0 Then
  Begin
    strMens := strMens + 'Lata ';
  End;

  Result := strMens;
end;

procedure TCadastroNovasFormulasJotun.pExisteUnidadeMenorCadastrada(const tela: ITelaCadLibTintas);
var
  qryGen: IDataSet;
begin
  strUnidadeMenor := '';

  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.SQL := ' SELECT BAS_CODUNI              ' +
                '      , BAS_EMBALA              ' +
                '   FROM JOT_CADBAS              ' +
                '  INNER JOIN CADITE             ' +
                '     ON ITE_CODITE = BAS_CODITE ' +
                ' WHERE BAS_CODBAS = :CODBAS     ' +
                '   AND BAS_TIPO__ = :TIPO__     ' ;

  qryGen.ParamByName('TIPO__').AsString := GetQueryCadastro.FieldByName('NFM_TIPO__').AsString;
  qryGen.ParamByName('CODBAS').AsString := GetQueryCadastro.FieldByName('NFM_BASE__').AsString;

  qryGen.Open;

  qryGen.First;
  While Not qryGen.Eof Do
  Begin

    If ((qryGen.FieldByName('BAS_CODUNI').AsString = 'GL')
      And (GetQueryCadastro.FieldByName('NFM_EMBALA').AsString > qryGen.FieldByName('BAS_EMBALA').AsString )) Then
    Begin
      strUnidadeMenor   := 'GL';
      strEmbalagemMenor := qryGen.FieldByName('BAS_EMBALA').AsString;
      Break;
    End
    Else
    If ((qryGen.FieldByName('BAS_CODUNI').AsString = 'LA')
      And (GetQueryCadastro.FieldByName('NFM_EMBALA').AsString > qryGen.FieldByName('BAS_EMBALA').AsString )
      And (GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString <> 'GL')) Then
    Begin
      strUnidadeMenor   := 'LA';
      strEmbalagemMenor := qryGen.FieldByName('BAS_EMBALA').AsString;
      Break;
    End;

    qryGen.Next;
  End;

  If (Not TStrUtils.fEmptyStr(strUnidadeMenor)) Then
    If fAjustarQuantidade(strUnidadeMenor, strEmbalagemMenor) Then
      pAjustaQuantidade(strUnidadeMenor, tela, strEmbalagemMenor);
end;

procedure TCadastroNovasFormulasJotun.pGetMd5KeyPedidos(
  const qryCadastro: IDataSet; stlMd5Key: TStringList);
var
  qryGen: IDataSet;
begin
  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.Close;
  qryGen.SQL := '   SELECT * FROM JOT_CADJOT        ';
  qryGen.SQL := qryGen.SQL + '  WHERE JOT_NOMCOR = :CODIGO      ';
  qryGen.ParamByName('CODIGO').AsString := GetQueryCadastro.FieldByName('NFM_CODNFM').AsString;
  qryGen.Open;

  While Not qryGen.Eof Do
  Begin
    stlMd5Key.Add(qryGen.FieldByName('JOT_MD5KEY').AsString);
    qryGen.Next;
  End;
end;

function TCadastroNovasFormulasJotun.fAjustarQuantidade(strUnidade: String; strEmbalagem : String): Boolean;
begin
  Result := False;
  blnAtualizaUnidade := False;

  If TAutcomTintaFactory.Get.fMensagem('QUESTÃO', 'Existe uma nova unidade cadastrada para a base selecionada,' + #13#10 +
                                                  'essa unidade é inferior a atual cadastrada na nova fórmula.' + #13#10 +
                                                  'Deseja atualizar para a unidade nova ?' + #13#10 +
                                                  'Unidade Atual : ' + GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString +' '+GetQueryCadastro.FieldByName('NFM_EMBALA').AsString + #13#10 +
                                                  'Unidade Nova  : ' + strUnidade + ' '+ strEmbalagem, ['&Sim','&Não']) = 1 Then
  Begin
    Result := True;
    blnAtualizaUnidade := True;
  End;
end;

procedure TCadastroNovasFormulasJotun.pAjustaQuantidade(strUnidade: String; const tela: ITelaCadLibTintas; strEmbalagem : String);
var
  intCont: Integer;
begin
  Tela['Label5']['Caption'].Value := 'Informar a quantidade sempre em ' + fRetDescUnidade(strUnidade);
  For intCont := 1 To 20 Do
  Begin
    If (strToFloatDef(tela['dbeQtdC' + TStrUtils.fStrZero(intCont, 2)]['Text'].Value, 0) > 0) Then
    Begin
      GetQueryCadastro.FieldByName('NFM_QTDC' + TStrUtils.fStrZero(intCont, 2)).AsFloat := StrToFloat(FormatFloat('#0.00',StrToFloat(tela['dbeQtdC' + TStrUtils.fStrZero(intCont, 2)]['Text'].Value) / fRetFatorEmbalagem(tela['dbeEmbala']['Text'].Value)    ))* strToFloat(strEmbalagem);
    End;
  End;
  GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString := strUnidade;
end;

