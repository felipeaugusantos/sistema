{*************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta Grafftex*}
{**********************************************************************PH*}
unit untConsultaCompGrafftex;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompGrafftex = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompGrafftex }

procedure TConsultaCompGrafftex.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadGraNovasFormulas');
end;

end.
