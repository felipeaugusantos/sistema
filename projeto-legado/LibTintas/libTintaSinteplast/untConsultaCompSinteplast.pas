{**********************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta Sinteplast *}
{*******************************************************************************AC*}
unit untConsultaCompSinteplast;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompSinteplast = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompSinteplast }

procedure TConsultaCompSinteplast.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadSINNovasFormulas');
end;

end.
