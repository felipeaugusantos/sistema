{**********************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta Annetta *}
{*******************************************************************************AC*}
unit untConsultaCompAnnetta;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompAnnetta = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompAnnetta }

procedure TConsultaCompAnnetta.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadANNNovasFormulas');
end;

end.
