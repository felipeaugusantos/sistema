{**********************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta Lukscolor *}
{*******************************************************************************AC*}
unit untConsultaCompLukscolor;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompLukscolor = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompLukscolor }

procedure TConsultaCompLukscolor.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadLKSNovasFormulas');
end;

end.
