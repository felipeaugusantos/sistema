{************************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta Alessi Imobiliaria *}
{*********************************************************************************AC*}
unit untConsultaCompAlessiImobiliaria;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompAlessiImobiliaria = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompAlessiImobiliaria }

procedure TConsultaCompAlessiImobiliaria.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadAleNovasFormulas');
end;

end.
