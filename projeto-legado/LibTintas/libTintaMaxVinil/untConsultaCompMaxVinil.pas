{**********************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta MaxVinil *}
{*******************************************************************************AC*}
unit untConsultaCompMaxVinil;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompMaxVinil = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompMaxVinil }

procedure TConsultaCompMaxVinil.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadMAXNovasFormulas');
end;

end.
