procedure TCadastroNovasFormulasMaxVinil.pAtivaCadMAX;
var
  qryGen: IDataSet;
begin
  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.SQL := 'UPDATE MAX_CADMAX ' +
                '   SET MAX_ATIVO_ = :ATIVAD ' +
                ' WHERE MAX_CODIGO = :CODNFM ';
  qryGen.ParamByName('ATIVAD').AsString := TAutcomTintaFactory.Get.IIF(GetQueryCadastro.FieldByName('NFM_ATIVO_').AsString = 'S','N','S');
  qryGen.ParamByName('CODNFM').AsString := GetQueryCadastro.FieldByName('NFM_CODIGO').AsString;
  qryGen.ExecSQL;
end;

procedure TCadastroNovasFormulasMaxVinil.pAtivaNfm;
var
  qryGen: IDataSet;
begin
