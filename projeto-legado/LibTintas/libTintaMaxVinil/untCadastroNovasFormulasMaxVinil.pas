function TCadastroNovasFormulasMaxVinil.ValidarBaseCompleto(strBase, strProduto,
  strColecao: String): Boolean;
Var
  qryGen: IDataSet;
begin
  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.Close;
  qryGen.SQL := '';
  qryGen.SQL := qryGen.SQL + '  SELECT                ';
  qryGen.SQL := qryGen.SQL + '    *                   ';
  qryGen.SQL := qryGen.SQL + '  FROM                  ';
  qryGen.SQL := qryGen.SQL + '    MAX_CADBAS          ';
  qryGen.SQL := qryGen.SQL + '  WHERE                 ';
  qryGen.SQL := qryGen.SQL + '    BAS_CODBAS = :CODBAS          ';

  If Not TStrUtils.fEmptyStr(strProduto) Then
    qryGen.SQL := qryGen.SQL + '  AND BAS_PRODUT = :PRODUT      ';

  qryGen.ParamByName('CODBAS').AsString := strBase;

  If Not TStrUtils.fEmptyStr(strProduto) Then
    qryGen.ParamByName('PRODUT').AsString := strProduto;

  qryGen.Open;

  Result := (Not qryGen.IsEmpty);
end;

function TCadastroNovasFormulasMaxVinil.ValidarColorante(
  const strCodCol: string): Boolean;
begin
  Result := TAutcomTintaFactory.Get.GetValorCampo(
    ' SELECT                     ' +
    '   COUNT(0) AS QTD          ' +
    ' FROM                       ' +
    '   MAX_CADCOL            ' +
    ' INNER JOIN CADITE ON ITE_CODITE = COL_CODITE ' +
    ' WHERE COL_CODCOL = :CODCOL ',
    'QTD', [strCodCol]
  ) > 0;
end;

function TCadastroNovasFormulasMaxVinil.ValidarColoranteJaCadastrado(
  const tela: ITelaCadLibTintas; const strCodCol, strNomCam: string): Boolean;
var
  intCont: Integer;
begin
  Result := True;
  For intCont := 1 To 20 Do
  Begin
    If (RightStr(strNomCam, 2) <> TStrUtils.fStrZero(intCont,2)) And
       (Not TStrUtils.fEmptyStr( tela['dbeForm' + TStrUtils.fStrZero(intCont,2)]['Text'].Value )) Then
    Begin
      If tela['dbeForm' + TStrUtils.fStrZero(intCont,2)]['Text'].Value = strCodCol Then
        Result := False;
    End;
  End;
end;


function TCadastroNovasFormulasMaxVinil.VerificarNovaFormulaMovimentada: Boolean;
begin
  Result := True;
  Try
    Try
      Result := fVerificarNovaFormulaMovimentada('SELECT COUNT(0) AS QTD '+
                                                 '  FROM %0:s '+
                                                 ' INNER JOIN MAX_CADMAX ON %1:s_ITETIN = MAX_MD5KEY '+
                                                 ' WHERE %1:s_IDEPRO = "MAX" '+
                                                 '   AND MAX_CODIGO = :CODNFM', [GetQueryCadastro.FieldByName('NFM_CODIGO').AsString]);
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
  End;
end;


