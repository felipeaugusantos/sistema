  Configurar('USATIN', 'Utilizar essa tinta de máquina:', 'S', tpSimNao, 'GERAL');
  Configurar('USAFOR', 'Utilizar Formulação:', 'S', tpSimNao, 'GERAL');
  Configurar('MODVEN', 'Modo de Venda', '0', tpModoVenda, 'GERAL');
  Configurar('DOXARQ', 'Utilizar os seguintes arquivos:', '0', tpArqDox, 'GERAL');
  Configurar('PROCOD', 'Próximo código novas fórmulas:', '00001', tpNumero_5, 'GERAL');
  Configurar('PRODOX', 'Produto para Venda:', '', tpBotaoVenda, 'GERAL');
  Configurar('DOXPLT', 'Produto Embalagem (Litro):', '', tpBotao, 'EMBALAGEM');
