{**********************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta Dacasa *}
{*******************************************************************************AC*}
unit untConsultaCompDacasa;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompDacasa = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompDacasa }

procedure TConsultaCompDacasa.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadDCANovasFormulas');
end;

end.
