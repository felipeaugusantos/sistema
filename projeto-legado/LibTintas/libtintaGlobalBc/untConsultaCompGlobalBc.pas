{**********************************************************************************}
{* Classes responsável pelos botões da tela de consulta da tinta GlobalBc *}
{*******************************************************************************AC*}
unit untConsultaCompGlobalBc;

interface

uses
  untIConsultaCompTintaNovaConfigurador, Dialogs, untAbstractConsultaComp, untIAutcomTintaWrapper;

type
  TConsultaCompGlobalBc = class(TAbstractConsultaComp)
  public
    procedure pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador); override;
  end;

implementation

uses
  untAutcomTintaFactory;

{ TConsultaCompGlobalBc }

procedure TConsultaCompGlobalBc.pTarefaVenda(const Sender: TObject; const configurador: IConsultaCompTintaNovaConfigurador);
begin
  TAutcomTintaFactory.Get.CriarNovasFormulasDllsGeneric('mnuCadGBCNovasFormulas');
end;

end.
