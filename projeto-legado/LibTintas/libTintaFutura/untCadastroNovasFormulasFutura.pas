  strDesBas: String): Boolean;
begin
  Result := True;
  if (not TStrUtils.fEmptyStr(strCodFml)) And
     (not TStrUtils.fEmptyStr(strDesBas)) then
  begin
    Result := TAutcomTintaFactory.Get.GetValorCampo(
      ' SELECT                          ' +
      '   COUNT(0) AS QTD               ' +
      ' FROM                            ' +
      '   FUT_CADBAS                    ' +
      '   INNER JOIN CADITE             ' +
      '     ON BAS_CODITE = ITE_CODITE  ' +
      ' WHERE BAS_CODFML = :CODFML      ' +
      '   AND BAS_DESCRI = :DESBAS      ',
      'QTD', [strCodFml, strDesBas]
    ) > 0;
  end;
end;

