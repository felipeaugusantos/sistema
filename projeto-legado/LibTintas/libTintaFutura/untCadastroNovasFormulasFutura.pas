  End;
end;

function TCadastroNovasFormulasFutura.ValidarProduto(strCodFml, strDesBas,
  strProduto, strCodUni: String; const tela: ITelaCadLibTintas): Boolean;
begin
  Result := True;
  if (not TStrUtils.fEmptyStr(strCodFml)) and
     (not TStrUtils.fEmptyStr(strDesBas)) and
     (not TStrUtils.fEmptyStr(strCodUni)) then
  begin
    Result := TAutcomTintaFactory.Get.GetValorCampo(
      ' SELECT                     ' +
      '   COUNT(0) AS QTD          ' +
      ' FROM                       ' +
      '   FUT_CADBAS            ' +
      '   INNER JOIN CADITE              ' +
      '     ON BAS_CODITE = ITE_CODITE   ' +
      ' WHERE BAS_CODFML = :CODFML ' +
      '   AND BAS_DESCRI = :DESBAS ' +
      '   AND BAS_CODUNI = :CODUNI ' +
      '   AND BAS_PRODUT = :PRODUT ',
      'QTD', [strCodFml, strDesBas, strCodUni, strProduto]
    ) > 0;

    If Not Result Then
    Begin
      GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString := fRetMenorUnidade(strProduto, strDesBas, strCodUni);
      Tela['Label5']['Caption'].Value := 'Informar a quantidade sempre em ' + fRetDescUnidade(GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString);
    End;
  end;
end;

