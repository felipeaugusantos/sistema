procedure TCadastroNovasFormulasFutura.pExisteUnidadeMenorCadastrada(
  const tela: ITelaCadLibTintas);
var
  qryGen: IDataSet;
begin
  strUnidadeMenor := '';

  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.SQL := ' SELECT                         ' +
                '   BAS_CODUNI                   ' +
                ' FROM                           ' +
                '   FUT_CADBAS                   ' +
                '  INNER JOIN CADITE             ' +
                '     ON ITE_CODITE = BAS_CODITE ' +
                ' WHERE BAS_CODFML = :CODFML     ' +
                '   AND BAS_CODBAS = :CODBAS     ' +
                '   AND BAS_PRODUT = :PRODUT     ';

  qryGen.ParamByName('CODFML').AsString := GetQueryCadastro.FieldByName('NFM_CODPRO').AsString;
  qryGen.ParamByName('CODBAS').AsString := GetQueryCadastro.FieldByName('NFM_BASE__').AsString;
  qryGen.ParamByName('PRODUT').AsString := GetQueryCadastro.FieldByName('NFM_PRODUT').AsString;

  qryGen.Open;

  qryGen.First;
  While Not qryGen.Eof Do
  Begin

    If ((Pos(qryGen.FieldByName('BAS_CODUNI').AsString, 'LT_QT_') > 0) And (Pos(GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString, 'LT_QT_') <= 0)) Then
    Begin
      strUnidadeMenor := TAutcomTintaFactory.Get.IIF(qryGen.FieldByName('BAS_CODUNI').AsString = 'LT', 'LT', 'QT');
      Break;
    End
    Else If ((qryGen.FieldByName('BAS_CODUNI').AsString = 'GL') And (GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString <> 'GL') And
        (Pos(GetQueryCadastro.FieldByName('NFM_UNIDAD').AsString, 'LT_QT_') <= 0)) Then
    Begin
      strUnidadeMenor := 'GL';
      Break;
    End;

    qryGen.Next;
  End;

  If (Not TStrUtils.fEmptyStr(strUnidadeMenor)) Then
    If fAjustarQuantidade(strUnidadeMenor) Then
      pAjustaQuantidade(strUnidadeMenor, tela);
end;

procedure TCadastroNovasFormulasFutura.pGetMd5KeyPedidos(
  const qryCadastro: IDataSet; stlMd5Key: TStringList);
var
  qryGen: IDataSet;
begin
  qryGen := TAutcomTintaFactory.Get.fGetDataSet;
  qryGen.Close;
  qryGen.SQL := '   SELECT * FROM FUT_CADFUT        ';
  qryGen.SQL := qryGen.SQL + '  WHERE FUT_REFERE = :CODIGO      ';
  qryGen.ParamByName('CODIGO').AsString := GetQueryCadastro.FieldByName('NFM_CODNFM').AsString;
  qryGen.Open;

  While Not qryGen.Eof Do
  Begin
    stlMd5Key.Add(qryGen.FieldByName('FUT_MD5KEY').AsString);
    qryGen.Next;
  End;
end;

