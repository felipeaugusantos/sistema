  End;
end;

class procedure TfrmCfgRepositorio.pAdicionarConfiguracao(strCodCfg, strDescri,
  strValCfg, strGruCfg: String; blnSetaDefaultNovaEmpresa: Boolean;
  intNumHlp: Integer = 0);
begin
  { ********************************************************************************* }
  { * "blnSetaDefaultNovaEmpresa = True"  (Ao criar uma nova empresa no cadastro, a * }
  { *   configuração ficára com o valor default na nova empresa criada              * }
  { * "blnSetaDefaultNovaEmpresa = False" (Ao criar uma nova empresa no cadastro, a * }
  { *   configuração da nova empresa ficará com o valor igual ao da empresa logada  * }
  { * OBS: TODOS OS SEQUENCIAIS DEVEM FICAR COMO TRUE                               * }
  { ******************************************************************************RN* }
  SetLength(arrCamposCfg, Length(arrCamposCfg) + 1);
  arrCamposCfg[Length(arrCamposCfg) - 1].strCodCfg := strCodCfg;
  arrCamposCfg[Length(arrCamposCfg) - 1].strDescri := strDescri;
  arrCamposCfg[Length(arrCamposCfg) - 1].strValCfg := strValCfg;
  arrCamposCfg[Length(arrCamposCfg) - 1].strGruCfg := strGruCfg;
  arrCamposCfg[Length(arrCamposCfg) - 1].blnSetaDefaultNovaEmpresa :=
    blnSetaDefaultNovaEmpresa;
  arrCamposCfg[Length(arrCamposCfg) - 1].intNumHlp := intNumHlp;
end;

