  i: Integer;
begin
  AValue := '';

  For i := Low(ACheckStates) To High(ACheckStates) Do
  Begin
    If ACheckStates[i] = cbsChecked Then
      AValue := AValue + 'S'
    Else
      AValue := AValue + 'N';
  End;
end;

