Function TfrmCfgRepositorio.fRetValorCfg(strCodCfg, strValCfg: String): String;
Var
  AProperties: TcxCustomEditProperties;
  intIndice: Integer;
Begin
  Result := strValCfg;

  If Not fEmptyStr(strValCfg) Then
    Try
      pRetProperties(strCodCfg, AProperties);

      If (AProperties IS TcxCustomExtLookupComboBoxProperties) Then
      Begin

      End

      Else If (AProperties IS TcxCustomRadioGroupProperties) Then
      Begin
        With TcxCustomRadioGroupProperties(AProperties) Do
          For intIndice := 0 To Items.Count - 1 Do
            If (Items[intIndice].Value <> Null) And
              (SameText(Items[intIndice].Value, strValCfg)) Then
            Begin
              Result := Items[intIndice].Caption;
              Break;
            End;
      End

      Else If (AProperties IS TcxColorComboBoxProperties) Then
      Begin
        Result := strValCfg;
      End

      Else If (AProperties IS TcxCustomComboBoxProperties) Then
      Begin
        With TcxCustomComboBoxProperties(AProperties) Do
        Begin
          If (Items.IndexOf(strValCfg)) > -1 Then
            Result := Items[Items.IndexOf(strValCfg)]
          Else
            Result := strValCfg;
        end;
      End

      Else If (AProperties IS TcxCustomCheckGroupProperties) Then
      Begin
        Result := '';
        For intIndice := 0 To Length(strValCfg) - 1 Do
          With TcxCustomCheckGroupProperties(AProperties) Do
            If SameText(strValCfg[Succ(intIndice)], 'S') Then
              Result := Result + ' ' + Items[intIndice].Caption;
        Result := Trim(Result);
      End

      Else If (AProperties IS TcxCustomMaskEditProperties) Then
        With TcxCustomMaskEditProperties(AProperties) Do
        Begin
          If (Not fEmptyStr(EditMask)) And
            (Pos('TODAY', UpperCase(EditMask)) <= 0) Then
            Result := FormatMaskText(EditMask, strValCfg);
        End

    Except
      On E: Exception Do
      Begin
        Result := strValCfg;
        pMensagensErro(E.Message, '[TfrmCfgRepositorio.fRetValorCfg]');
      End;
    End;
End;

function TfrmCfgRepositorio.fRetCst: String;
Var
  qryGen: TUniQuery;
  strSql: String;
  stlCst: TStringList;
Begin
  qryGen := fCriaQuery;
  stlCst := TStringList.Create;

  With qryGen Do
  Begin
    strSql := '';
    strSql := strSql + ' SELECT ';
    strSql := strSql + '   CST_CODCST ';
    strSql := strSql + ' FROM ';
    strSql := strSql + '   CSTPIS ';

    Close;
    SQL.Clear;
    SQL.Add(strSql);
    Open;

    stlCst.Clear;
    stlCst.Add('');
    First;
    While Not Eof Do
    Begin
      stlCst.Add(FieldByName('CST_CODCST').AsString);
      Next;
    End;

    Result := stlCst.Text;
  End;

  FreeAndNil(qryGen);
  FreeAndNil(stlCst);

end;

Function TfrmCfgRepositorio.fRetModalidades: String;
Var
