procedure TfrmCfgRepositorio.DataModuleCreate(Sender: TObject);
var
  intContador: Integer;
  intMaxOpc: Integer;
begin
  { **************************************************** }
  { *  DESABILITA OS BOTÕES SAVE, LOAD e EDIT DO FAST  * }
  { *11/05/2015**************************************RB* }
  For intContador := 0 To Self.ComponentCount - 1 Do
  Begin

    If (Self.Components[intContador] Is TfrxReport) Then
    Begin
      TfrxReport(Self.Components[intContador]).PreviewOptions.Buttons :=
        TfrxReport(Self.Components[intContador]).PreviewOptions.Buttons -
        [pbSave, pbLoad, pbEdit];
    End;
  End;

  cmbRelacionaCliPro.Properties.Items.Clear;
  intMaxOpc := Ord(High(TOpcCliPro));

  While (intMaxOpc <> 0) Do
  Begin
    With cmbRelacionaCliPro.Properties.Items.Add Do
    Begin
      Index := 0;
      Caption := fRetDescOpcCliPro(TOpcCliPro(intMaxOpc));
    End;

    If intMaxOpc = 1 Then
      intMaxOpc := 0
    Else
      intMaxOpc := Trunc(intMaxOpc / 2);

  End;

  cbxModalidades.Properties.Items.Text := fRetModalidades;
  cbxCST.Properties.Items.Text := fRetCst;
  cdsCfgSis := Nil;
  pMontaModelosLayoutCoral;
end;

