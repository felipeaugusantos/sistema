procedure TfrmCfgRepositorio.cxRepositorioCurrencyItem1PropertiesValidate
  (Sender: TObject; var DisplayValue: Variant; var ErrorText: TCaption;
  var Error: Boolean);
begin
  If (Not fEmptyStr(DisplayValue)) Then
  Begin
    If (DisplayValue > 360) Or (DisplayValue < 0) Then
    Begin
      Error := True;
      ErrorText := '';
      pMensagemOk('Informe um valor entre 0 e 360 ou deixe o campo em branco!');
    End;
  End;

end;

procedure TfrmCfgRepositorio.cmbRelacionaCliProPropertiesEditValueToStates
  (Sender: TObject; const AValue: Variant; var ACheckStates: TcxCheckStates);
Var
  intValue: Integer;
  intChkInd: Integer;
  intBitOpc: Integer;
begin
  intChkInd := High(ACheckStates);
  intValue := AValue;
  intBitOpc := Ord(High(TOpcCliPro));

  While (intBitOpc <> 0) do
  Begin
    If intValue >= intBitOpc Then
    Begin
      ACheckStates[intChkInd] := cbsChecked;
      intValue := intValue - intBitOpc;
    End
    Else
      ACheckStates[intChkInd] := cbsUnChecked;

    if intBitOpc = 1 Then
      intBitOpc := 0
    Else
      intBitOpc := Trunc(intBitOpc / 2);

    Dec(intChkInd);
  End;

end;

procedure TfrmCfgRepositorio.cmbRelacionaCliProPropertiesStatesToEditValue
  (Sender: TObject; const ACheckStates: TcxCheckStates; out AValue: Variant);
Var
  intChkInd: Integer;
  intBitOpc: Integer;
begin
  AValue := 0;
  intBitOpc := 1;

  For intChkInd := Low(ACheckStates) To High(ACheckStates) Do
  Begin
    If ACheckStates[intChkInd] = cbsChecked Then
      AValue := AValue + intBitOpc;

    intBitOpc := intBitOpc * 2;

  End;

end;

