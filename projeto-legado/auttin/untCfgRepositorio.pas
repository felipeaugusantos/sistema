procedure TfrmCfgRepositorio.edtTexto_Tam20PropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
Const
  ValidChars
    : String = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
Var
  intCont: Integer;
  Resultado: String;
  Entrada: String;
begin
  inherited;

  Resultado := '';
  Entrada := DisplayValue;
  For intCont := 1 To Length(Entrada) Do
  Begin
    If Pos(Entrada[intCont], ValidChars) > 0 Then
      Resultado := Resultado + Entrada[intCont];
  End;
  DisplayValue := Resultado;
end;

