procedure TfrmCfgRepositorio.spnValInt_Tam_4PropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
var
  intValue: Integer;
begin
  Try
    intValue := StrToInt(DisplayValue);
    if Length(DisplayValue) > 4 then
    begin
