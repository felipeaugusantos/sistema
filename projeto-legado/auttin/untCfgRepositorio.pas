procedure TfrmCfgRepositorio.chgOpcIteSpoPropertiesEditValueToStates
  (Sender: TObject; const [Ref] AValue: Variant;
  var ACheckStates: TcxCheckStates);
Var
  i: Integer;
begin
  For i := 1 To 4 Do
  Begin
    If Copy(AValue, i, 1) = 'S' Then
      ACheckStates[i - 1] := cbsChecked
    Else
      ACheckStates[i - 1] := cbsUnChecked;
  End;
end;

procedure TfrmCfgRepositorio.chgOpcIteSpoPropertiesStatesToEditValue
  (Sender: TObject; const ACheckStates: TcxCheckStates; out AValue: Variant);
