  strSql := 'SELECT ';
  strSql := strSql +
    '   (IF(SIS_VALCFG IS NULL, "N", IF(SIS_VALCFG = "", "N", "S"))) AS SIS_VALCFG, ';
  strSql := strSql + '   SIS_CODEMP ';
  strSql := strSql + ' FROM ';
  strSql := strSql +
    '    ( SELECT SIS_CODEMP, SIS_CODCFG, GROUP_CONCAT(SIS_VALCFG SEPARATOR "") AS SIS_VALCFG FROM CFGSIS ';
  strSql := strSql +
    '      WHERE      (SIS_CODCFG = "CFG_BBAGMC" OR SIS_CODCFG = "CFG_ITAGMC" OR SIS_CODCFG = "CFG_STAGMC") ';
  strSql := strSql + '      GROUP BY SIS_CODEMP ';
  strSql := strSql + '      ) AS TAB1 ';
  strSql := strSql + ' WHERE TRUE ';
