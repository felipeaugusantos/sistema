  ACheckStates[0] := cbsUnChecked;
  ACheckStates[1] := cbsUnChecked;
  ACheckStates[2] := cbsUnChecked;
  ACheckStates[3] := cbsUnChecked;
  ACheckStates[4] := cbsUnChecked;
  ACheckStates[5] := cbsUnChecked;

  If VarToStr(AValue).Contains('A') Then
