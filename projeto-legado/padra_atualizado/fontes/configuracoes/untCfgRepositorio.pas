  Result := edtValDin;
  Result.Properties.DecimalPlaces :=  fCfgSis('CSDMOR', VarInteger);
  Result.Properties.DisplayFormat := '#,##0.' + LZerosCasas+';(#,##0.' + LZerosCasas +')';
  Result.Properties.EditFormat := '#,##0.' + LZerosCasas;
  Result.Properties.UseThousandSeparator := True;

end;

