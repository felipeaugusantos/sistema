Function TfrmCfgRepositorio.fRetDescricaoValoresCfg(strCodCfg, strValCfg: String): String;
  Var
    AProperties: TcxCustomEditProperties;
    intIndice: Integer;
Begin
  If dicDescricaoValoresConfiguracao.ContainsKey(strCodCfg + strValCfg) Then
    Exit(dicDescricaoValoresConfiguracao[strCodCfg + strValCfg]);

  Result := strValCfg;

  If Not fEmptyStr(strValCfg) Then
  Try
    pRetProperties(strCodCfg, AProperties);

    If (AProperties IS TcxCustomExtLookupComboBoxProperties) Then
    Begin

    End

    Else If (AProperties IS TcxCustomRadioGroupProperties) Then
    Begin
      Result := '';
      With TcxCustomRadioGroupProperties(AProperties) Do
        For intIndice := 0 To Items.Count - 1 Do
          If (Items[intIndice].Value <> Null) Then
            Result := Result + ' ' + Items[intIndice].Caption;
    End

    Else If (AProperties IS TcxColorComboBoxProperties) Then
    Begin
      Result := strValCfg;
    End

    Else If (AProperties IS TcxCustomComboBoxProperties) Then
    Begin
      Result := '';
      With TcxCustomComboBoxProperties(AProperties) Do
        For intIndice := 0 To Items.Count - 1 Do
          Result := Result + ' ' + Items[intIndice];
    End

    Else If (AProperties IS TcxCustomCheckGroupProperties) Then
    Begin
      Result := '';
      With TcxCustomCheckGroupProperties(AProperties) Do
        For intIndice := 0 To Items.Count - 1 Do
          Result := Result + ' ' + Items[intIndice].Caption;
    End

    Else If (AProperties IS TcxCustomMaskEditProperties) Then
    With TcxCustomMaskEditProperties(AProperties) Do
    Begin
      If (Not fEmptyStr(EditMask)) And (Pos('TODAY', UpperCase(EditMask)) <= 0) Then
        Result := FormatMaskText(EditMask,strValCfg);
    End

  Except
    On E: Exception Do
      Result := strValCfg;
  End;

  dicDescricaoValoresConfiguracao.AddOrSetValue(strCodCfg + strValCfg, Result);
end;
class function TfrmCfgRepositorio.fRetFPG: String;
Var qryGen: TUniQuery;
    strSql: String;
    strRetorno : String;
Begin
  qryGen := fCriaQuery;
  strRetorno := '';

  strSql := '';
  strSql := strSql + ' SELECT ';
  strSql := strSql + '   FPG_CODIGO, FPG_DESCRI ';
  strSql := strSql + ' FROM ';
  strSql := strSql + '   CADFPG ';
  strSql := strSql + ' ORDER BY FPG_CODIGO ';

  qryGen.Close;
  qryGen.SQL.Clear;
  qryGen.SQL.Add(strSQL);
  qryGen.Open;
  qryGen.First;
  While Not qryGen.Eof Do
  Begin
    strRetorno := strRetorno + qryGen.FieldByName('FPG_CODIGO').AsString+'_';
    qryGen.Next;
  End;

  FreeAndNil(qryGen);
  Result := strRetorno;
end;

{$ENDIF}

{$IFNDEF LINUX}
Function TfrmCfgRepositorio.fRetValorCfg(strCodCfg, strValCfg: String): String;
  Var
    AProperties: TcxCustomEditProperties;
    intIndice: Integer;
Begin
  Result := strValCfg;

  If Not fEmptyStr(strValCfg) Then
  Try
    pRetProperties(strCodCfg, AProperties);

    If (AProperties IS TcxCustomExtLookupComboBoxProperties) Then
    Begin

    End

    Else If (AProperties IS TcxCustomRadioGroupProperties) Then
    Begin
      With TcxCustomRadioGroupProperties(AProperties) Do
      For intIndice := 0 To Items.Count - 1 Do
        If (Items[intIndice].Value <> Null) And
           (SameText(Items[intIndice].Value, strValCfg)) Then
        Begin
          Result := Items[intIndice].Caption;
          Break;
        End;
    End

    Else If (AProperties IS TcxColorComboBoxProperties) Then
    Begin
      Result := strValCfg;
    End

    Else If (AProperties IS TcxCustomComboBoxProperties) Then
    Begin
      With TcxCustomComboBoxProperties(AProperties) Do
      Begin
        If (Items.IndexOf(strValCfg)) > -1 Then
          Result := Items[Items.IndexOf(strValCfg)]
        Else
          Result := strValCfg;
      end;
    End

    Else If (AProperties IS TcxCustomCheckGroupProperties) Then
    Begin
      Result := '';
      For intIndice := 0 To Length(strValCfg) - 1 Do
      With TcxCustomCheckGroupProperties(AProperties) Do
        If SameText(strValCfg[Succ(intIndice)], 'S') Then
          Result := Result + ' ' + Items[intIndice].Caption;
      Result := Trim(Result);
    End

    Else If (AProperties IS TcxCustomMaskEditProperties) Then
    With TcxCustomMaskEditProperties(AProperties) Do
    Begin
      If (Not fEmptyStr(EditMask)) And (Pos('TODAY', UpperCase(EditMask)) <= 0) Then
        Result := FormatMaskText(EditMask,strValCfg);
    End

  Except
    On E: Exception Do
    Begin
      Result := strValCfg;
      pMensagensErro(E.Message, '[TfrmCfgRepositorio.fRetValorCfg]');
    End;
  End;
End;
{$ENDIF}

{$IFNDEF LINUX}
class function TfrmCfgRepositorio.fRetCfgPaths(pgbProgresso: TcxProgressBar): TArray<String>;
Var
  I: Integer;
  AProp: TcxCustomEditProperties;
  strLisCfgPat: String;
  strValorDefault: String;
begin
  SetLength(Result, 0);
  pCriarFormularios(TfrmCfgRepositorio, frmCfgRepositorio);
  strLisCfgPat := fCampoTabela('GROUP_CONCAT(SIS_CODCFG)', 'CFGPAT', [], []);
  Try
    pMontaArrConfiguracoes;

    If Assigned(pgbProgresso) Then
      pgbProgresso.Properties.Max := Length(arrCamposCfg);

    For I := 0 To Length(arrCamposCfg) -1 Do
    Begin
      If Assigned(pgbProgresso) Then
      Begin
        pgbProgresso.Position := I + 1;
        If I Mod 50 = 0 Then
          Application.ProcessMessages;
      End;

      If (arrCamposCfg[I].strCodCfg = 'CFG_TAXDIA') Then
        Continue;

      If (Pos(arrCamposCfg[I].strCodCfg, strLisCfgPat) > 0) Then
        Continue;

      strValorDefault := Trim(AnsiUpperCase(arrCamposCfg[I].strValCfg));

      If (Length(strValorDefault) = 1) Then
      Begin
        If (CharInSet(strValorDefault[1], ['+','-','%','$','0'..'9','A'..'Z'])) Then
         Continue;
      End;

      frmCfgRepositorio.pRetProperties(arrCamposCfg[I].strCodCfg, AProp);
      If Assigned(AProp) Then
      Begin
        If (AProp Is TcxButtonEditProperties) Then
        Begin
          If (TcxButtonEditProperties(AProp).ImeMode = imOpen) Then
          pAddDados(Result, arrCamposCfg[I].strCodCfg);
    End;
      End;
    End;

    Application.ProcessMessages;
  Finally
    pFreeAndNil(frmCfgRepositorio);
  End;
end;
{$ENDIF}

