{$IFNDEF LINUX}
class function TfrmCfgRepositorio.pRetCfgRelacionadaArquivo(strNomArq: String): String;
  Var
    AProperties,
    RProperties: TcxCustomEditProperties;
    intCorre : Integer;
begin
  Try
    AProperties := Nil;
    pCriarFormularios(TfrmCfgRepositorio, frmCfgRepositorio);

    if SameText(strNomArq, 'CADCID') then AProperties := frmCfgRepositorio.btnConCidade.Properties;
    if SameText(strNomArq, 'CADMAR') then AProperties := frmCfgRepositorio.btnConMarcas.Properties;
    if SameText(strNomArq, 'CADUNI') then AProperties := frmCfgRepositorio.btnConUnidade.Properties;
    if SameText(strNomArq, 'CADDIV') then AProperties := frmCfgRepositorio.btnConDiversos.Properties;
    if SameText(strNomArq, 'CADCLI') then AProperties := frmCfgRepositorio.btnConCliente.Properties;
    if SameText(strNomArq, 'CADITE') then AProperties := frmCfgRepositorio.btnConItem.Properties;
    if SameText(strNomArq, 'CADFOR') then AProperties := frmCfgRepositorio.btnConFornecedor.Properties;
    if SameText(strNomArq, 'CADCTA') then AProperties := frmCfgRepositorio.btnConCta.Properties;
    if SameText(strNomArq, 'CADOPE') then AProperties := frmCfgRepositorio.btnConOperador.Properties;
    if SameText(strNomArq, 'CADOCO') then AProperties := frmCfgRepositorio.btnConOcorrencia.Properties;
    if SameText(strNomArq, 'CADTPA') then AProperties := frmCfgRepositorio.btnConCadTpa.Properties;
    if SameText(strNomArq, 'CADSER') then AProperties := frmCfgRepositorio.btnConServico.Properties;
    if SameText(strNomArq, 'AJUICM') then AProperties := frmCfgRepositorio.btnConAjuICM.Properties;
    if SameText(strNomArq, 'CRMCAT') then AProperties := frmCfgRepositorio.btnConCatCrm.Properties;
    if SameText(strNomArq, 'CADEVE') then AProperties := frmCfgRepositorio.btnConEvento.Properties;

    pMontaArrConfiguracoes;

    For intCorre := 0 To High(arrCamposCfg) do
    begin
      frmCfgRepositorio.pRetProperties(arrCamposCfg[intCorre].strCodCfg, RProperties);
      if AProperties = RProperties then
      Begin
        Result := Result + '"' + arrCamposCfg[intCorre].strCodCfg + '",';
      End;

    end;

    // Tirando a última Virgula
    Result := Copy(Result, 1, Length(Result)-1);

  Finally
    FreeAndNil(frmCfgRepositorio);
  End;

end;
{$ENDIF}

