procedure TfrmCfgRepositorio.pSetPontosImpressao(arrPontosImpressao: TArray<TPontoImpressao>);
var
  LPontoImpressao: TPontoImpressao;
begin
  cbxImprimirParaArquivo.Properties.Items.Clear;
