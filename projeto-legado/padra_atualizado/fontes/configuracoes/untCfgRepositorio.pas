{$IFNDEF LINUX}
procedure TfrmCfgRepositorio.btnConHisPadPropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
  Var
    qryConsulta: TUniQuery;
    LcdsAux: TUniClientDataSet;
    LstrHisTpl, LstrTplaco: string;
begin
  inherited;
  LstrHisTpl := 'N';
  If SameText(ErrorText,'VALID') Then
  Begin
    LcdsAux := TUniClientDataSet.Create(Nil);
    try
      LcdsAux.Data := cdsCfgSis.Data;

      LcdsAux.Filtered := False;
      LcdsAux.Filter   := 'SIS_CODCFG = ' + QuotedStr('CFG_HISTPL') + ' AND SIS_CODEMP = ' + QuotedStr(VS_strCodEmp);
      LcdsAux.Filtered := True;

      if not LcdsAux.Eof then
        LstrHisTpl := LcdsAux.FieldByName('SIS_VALCFG').AsString ;
    finally
      FreeAndNil(LcdsAux) ;
    end;


    Try
      Error := True;
      qryConsulta := fCriaQuery;

      With qryConsulta Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT                 ');
        SQL.Add('  COUNT(*)             ');
        SQL.Add('FROM                   ');
        SQL.Add('  HISPAD               ');
        SQL.Add('WHERE                  ');
        SQL.Add('  PAD_CODIGO = :CODIGO ');
        ParamByName('CODIGO').AsString := DisplayValue;
        if fCampoExiste('CADEMP', 'EMP_TPLACO') and fCampoExiste('HISPAD', 'PAD_TPLACO') then
        begin
          if LstrHisTpl <> 'S' then
          begin
            SQL.Add(' AND IFNULL(PAD_TPLACO, "") = "" ')
          end
          else
          begin
            SQL.Add(' AND PAD_TPLACO = :TPLACO ');
            LstrTplaco := fCampoTabela('EMP_TPLACO', 'CADEMP', ['EMP_CODEMP'], [VS_strCodEmp], False);
            if fEmptyStr(LstrTplaco) then
              LstrTplaco := '000000';
            ParamByName('TPLACO').AsString := LstrTplaco;
          end;
        end;

        Open;
        If Fields[0].AsInteger > 0 Then
          Error := False;
        Close;
      End;
    Finally
      FreeAndNil(qryConsulta);
    End;
  End
end;
{$ENDIF}

