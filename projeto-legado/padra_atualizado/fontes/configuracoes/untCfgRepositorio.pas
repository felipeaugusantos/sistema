{$IFNDEF LINUX}
procedure TfrmCfgRepositorio.btnConClassedeLocalPropertiesValidate(
  Sender: TObject; var DisplayValue: Variant; var ErrorText: TCaption;
  var Error: Boolean);
  Var
    qryConsulta: TUniQuery;
begin
  If SameText(ErrorText,'VALID') Then
  Begin
    Try
      Error := True;
      qryConsulta := fCriaQuery;

      With qryConsulta Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT                 ');
        SQL.Add('  COUNT(*)             ');
        SQL.Add('FROM                   ');
        SQL.Add('  CLASSE               ');
        SQL.Add('WHERE                  ');
        SQL.Add('  CLA_SIGLA_ = :SIGLA_ ');
        ParamByName('SIGLA_').AsString := DisplayValue;
        Open;

        If Fields[0].AsInteger > 0 Then
          Error := False;

        Close;
      End;

    Finally
      FreeAndNil(qryConsulta);
    End;
  End;
end;
{$ENDIF}

