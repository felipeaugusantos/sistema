procedure TfrmCfgRepositorio.btnConMatrizIcmsPropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
  Var
    qryConsulta: TUniQuery;
begin
  inherited;

  If SameText(ErrorText,'VALID') Then
  Begin
    Try
      Error := True;
      qryConsulta := fCriaQuery;

      With qryConsulta Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT                 ');
        SQL.Add('  COUNT(*)             ');
        SQL.Add('FROM                   ');
        SQL.Add('  MATICM               ');
        SQL.Add('WHERE                  ');
        SQL.Add('  ICM_CODMAT = :CODMAT ');
        ParamByName('CODMAT').AsString := DisplayValue;
        Open;

        If Fields[0].AsInteger > 0 Then
          Error := False;

        Close;
      End;

    Finally
      FreeAndNil(qryConsulta);
    End;
  End

end;

