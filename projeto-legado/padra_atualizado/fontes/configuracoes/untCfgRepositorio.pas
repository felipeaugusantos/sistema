procedure TfrmCfgRepositorio.btnPatSndPropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
begin
  If (Not fEmptyStr(DisplayValue)) Then
  Begin
    If VarToStr(DisplayValue).ToLower.StartsWith('\\tsclient') then
    Begin
      Error := True;
      ErrorText := '';
      pMensagemOk('Não é permitido informar um arquivo sonoro do computador local!');
    End
    Else If Not FileExists(DisplayValue) Then
    Begin
      Error := True;
      ErrorText := '';
      pMensagemOk('Arquivo "' + DisplayValue + '" não existe!');
    End
    Else If Not ExtractFileExt(DisplayValue).ToLower.Equals('.wav') Then
    Begin
      Error := True;
      ErrorText := '';
      pMensagemOk('Arquivo sonoro deve ter a extensão ".wav"!');
    End;
  End;
end;

