class function TfrmCfgRepositorio.fGetIteEsp: String;
  Var
    strValCfg: String;
begin
  strValCfg := fCampoTabela('SIS_VALCFG', 'CFGSIS', ['SIS_CODCFG', 'SIS_CODEMP'], ['CFG_ITESPO', VS_strCodEmp]);

  If (Length(strValCfg) = 4) Then Begin
    Result := strValCfg;
  End Else Begin
    If (strValCfg = '1') Then
      Result := 'SNNN'
    Else If (strValCfg = '2') Then
      Result := 'SSNN'
    Else If (strValCfg = '3') Then
      Result := 'SSSS'
    Else
      Result := 'SSSS';
  End;
end;

