{$IFNDEF LINUX}
procedure TfrmCfgRepositorio.btnPatEndPropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
begin
  If Not(fEmptyStr(DisplayValue)) Then
  Begin
    If cdsCfgSis.FieldByName('SIS_CODCFG').AsString = 'CFG_CLIPAT' Then
    Begin
      If DisplayValue = fCfgSisL('FORPAT', VarString) Then
      Begin
        pMensagemOk('Diretório já definido na configuração [CFG_FORPAT] favor informar outro diretório.');
        Exit;
      End;
    End Else
    If cdsCfgSis.FieldByName('SIS_CODCFG').AsString = 'CFG_FORPAT' Then
    Begin
      If DisplayValue = fCfgSisL('CLIPAT', VarString) Then
      Begin
        pMensagemOk('Diretório já definido na configuração [CFG_CLIPAT] favor informar outro diretório.');
        Exit;
      End;
    End;

  End;

end;
