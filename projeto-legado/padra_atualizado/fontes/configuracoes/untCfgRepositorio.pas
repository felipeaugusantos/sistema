{$IFNDEF LINUX}
// Handlers do chkEDUNIF - CFG_EDUNIF armazena string com prefixos concatenados
// dos marketplaces habilitados (ex: 'MLB_SHP_TIKTOK_'). Prefixos vem direto
// de VS_arrMarketplaces (untTypesSistema, fonte unica da verdade).
procedure TfrmCfgRepositorio.chkEDUNIFPropertiesEditValueToStates(Sender: TObject;
  const AValue: Variant; var ACheckStates: TcxCheckStates);
var
  strValor: String;
  intI: Integer;
begin
  inherited;
  strValor := VarToStr(AValue);
  for intI := Low(VS_arrMarketplaces) to High(VS_arrMarketplaces) do
  begin
    if intI > High(ACheckStates) then Break;
    if strValor.Contains(VS_arrMarketplaces[intI].Prefixo) then
      ACheckStates[intI] := cbsChecked
    else
      ACheckStates[intI] := cbsUnchecked;
  end;
end;

procedure TfrmCfgRepositorio.chkEDUNIFPropertiesStatesToEditValue(Sender: TObject;
  const ACheckStates: TcxCheckStates; out AValue: Variant);
var
  strResultado: String;
  intI: Integer;
begin
  inherited;
  strResultado := '';
  for intI := Low(VS_arrMarketplaces) to High(VS_arrMarketplaces) do
  begin
    if intI > High(ACheckStates) then Break;
    if ACheckStates[intI] = cbsChecked then
      strResultado := strResultado + VS_arrMarketplaces[intI].Prefixo;
  end;
  AValue := strResultado;
end;

procedure TfrmCfgRepositorio.pPopularItensEDUNIF;
var
  intI: Integer;
  itemNovo: TcxCheckGroupItem;
begin
  chkEDUNIF.Properties.Items.Clear;
  for intI := Low(VS_arrMarketplaces) to High(VS_arrMarketplaces) do
  begin
    itemNovo := chkEDUNIF.Properties.Items.Add;
    itemNovo.Caption := VS_arrMarketplaces[intI].NomeAmigavel;
  end;
end;
{$ENDIF}

