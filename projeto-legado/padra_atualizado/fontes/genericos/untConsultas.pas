function fPesqTabelaPreco(Self     : TForm;                    {* Formulário                                  *}
                          edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                          edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                          qryTabela: TUniQuery;                {* Query                                       *}
                          Var chrKey: Char;                    {* Key                                         *}
                          Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                          blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                          strCodFor: String = ''): Boolean;
  Var
    strTitulo,
    strSQL,
    strWhere: String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrTitCol  : TColunasArray; {* Títulos das Colunas  *}
    arrPesq: Array of String;

    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;

    objLoadSql: TLoadConsultaSQL;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrCamposConsulta, Succ(Length(arrCamposConsulta)));
    arrCamposConsulta[High(arrCamposConsulta)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean = True): String;
  Begin
    Result := '';
    If Not fEmptyStr(strCodFor) Then
      result := ' AND TAB_CODFOR = ' + QuotedStr(strCodFor);
  End;

  Procedure pConsultaAntiga;
  Begin
    SetLength(arrTitCol, 0);

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE  ';
      strSQL := strSQL + '  TAB_CODTAB,        '; pAddNomeColuna('Código');
      strSQL := strSQL + '  TAB_NOMTAB,        '; pAddNomeColuna('Nome');
      strSQL := strSQL + '  TAB_CODFOR,        '; pAddNomeColuna('Fornecedor');
      strSQL := strSQL + '  FOR_NOMFOR,        '; pAddNomeColuna('Nome Fornecedor');
      strSQL := strSQL + '  TAB_ATICMP,        '; pAddNomeColuna('Ativo compra');
      strSQL := strSQL + '  TAB_DTACAD,        '; pAddNomeColuna('Cadastro');
      strSQL := strSQL + '  T.AUTOINCREM       ';
      strSQL := strSQL + 'FROM                 ';
      strSQL := strSQL + '  TABPRE T           ';
      strSQL := strSQL + 'INNER JOIN CADFOR ON FOR_CODFOR = TAB_CODFOR ';

      strWhere := ' WHERE TRUE ' +  fSQLWhere;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));

    objLoadSQL.pCarregaDadosConsulta;

    arrSQLConsulta    := objLoadSQL.arrSQL;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;


      objConsulta := TDefConsulta.Create;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      strTitulo := 'Consulta de Tabelas de Preços';

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin

        pTrataConsultaConfigurada;

      End Else
      Begin

        pConsultaAntiga;
        SetLength(arrSQLConsulta, 2);
        arrSQLConsulta[0] :=strSQL;
        arrSQLConsulta[1] :=strWhere;

        SetLength(arrPesq, 4);
        arrPesq[0] := 'TAB_NOMTAB';
        arrPesq[1] := 'FOR_NOMFOR';
        arrPesq[2] := 'TAB_CODFOR';
        arrPesq[3] := 'TAB_CODTAB';

      End;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   arrPesq,
                   '',
                   'TABPRE',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'TAB_CODTAB',
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('TAB_CODTAB').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('TAB_CODTAB').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('TAB_NOMTAB').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 6)
            Else
              edtCodigo.Text := fStrZero('0', 6);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;
      End;
      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

      FreeAndNil(objLoadSQL);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

