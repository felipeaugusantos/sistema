{***********************************************************}
{* CONSULTA DE DOCUMENTO DE AQUISIÇÃO DE ATIVO/IMOBILIZADO *}
{********************************************************JZ*}
function fPesqAtivoImobDocumentos(Self     : TForm;          {* Formulário                                        *}
                        edtCodigo: TCustomEdit;              {* Edit do Código                                    *}
                        edtDescri: TEditFocus;               {* Edit da Descrição                                 *}
                        qryTabela: TUniQuery;                {* Query                                             *}
                        Var chrKey: Char;                    {* Key                                               *}
                        Var arrSel: TConsultasArray;         {* Array de Seleção                                  *}
                        blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select)       *}
                        strDtaBas : String = '';             {* Data Base (Carregado de outros filtros)           *}
                        strCodEmp : String = '';             {* Código da Empresa (Carregado de outros filtros)   *}
                        strClaImo : String = '';             {* Classificação (Carregado de outros filtros)       *}
                        strVendid : String = ''): Boolean;   {* Vendido (Carregado de outros filtros)             *}

  Var
    strSQL      : String;
    strWhere    : String;
    qryConsulta : TUniQuery;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE DISTINCT ';
      strSQL := strSQL + '  CADIMO.IMO_DOCAQU, ';
      strSQL := strSQL + '  CADIMO.IMO_ESPAQU, ';
      strSQL := strSQL + '  MOVGER.GER_VLRCON, ';
      strSQL := strSQL + '  CADFOR.FOR_CODFOR, ';
      strSQL := strSQL + '  CADFOR.FOR_NOMFOR  ';
      strSQL := strSQL + 'FROM                 ';
      strSQL := strSQL + '  CADIMO             ';
      strSQL := strSQL + '  LEFT JOIN MOVGER ON MOVGER.GER_NUMDOC = CADIMO.IMO_DOCAQU ';
      strSQL := strSQL + '    AND MOVGER.GER_ESPDOC = CADIMO.IMO_ESPAQU ';
      strSQL := strSQL + '    AND MOVGER.GER_SERIE_ = CADIMO.IMO_SERAQU ';
      strSQL := strSQL + '    AND MOVGER.GER_CODFOR = CADIMO.IMO_FORAQU ';
      strSQL := strSQL + '  LEFT JOIN CADFOR ON CADFOR.FOR_CODFOR = MOVGER.GER_CODFOR ';

      strWhere := 'WHERE TRUE AND IFNULL(IMO_DOCAQU, "") <> "" ';

      If (strDtaBas <> '') And (strDtaBas <> '  /') Then
      Begin
        strWhere := strWhere + ' AND STR_TO_DATE(CONCAT( SUBSTR(' + QuotedStr(strDtaBas) + ',4,4), ",", SUBSTR(' + QuotedStr(strDtaBas) + ',1,2),",","01"),"%Y,%m,%d") ' ;
        strWhere := strWhere + ' BETWEEN STR_TO_DATE(CONCAT( YEAR(IMO_DTAAQU), ",", MONTH(IMO_DTAAQU),",01"),"%Y,%m,%d") ';
        strWhere := strWhere + ' AND DATE_ADD(LAST_DAY(STR_TO_DATE(CONCAT( YEAR(IMO_DTAAQU), ",", MONTH(IMO_DTAAQU),",01"),"%Y,%m,%d")),INTERVAL (IMO_VIDUTI * 12) MONTH) ';
      End;

      If strCodEmp <> '' Then
      Begin
        strWhere := strWhere + ' AND IMO_CODEMP = ' + QuotedStr(strCodEmp);
      End;

      If strClaImo <> '' Then
      Begin
        strWhere := strWhere + ' AND IMO_TIPIMO = ' + QuotedStr(strClaImo);
      End;

      If strVendid <> '' Then
      Begin
        strWhere := strWhere + ' AND LOCATE(IMO_VENDID, ' + QuotedStr(strVendid) + ') > 0 ';
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta([strSQL, strWhere],
                  ['Documento',
                   'Espécie',
                   'Valor Contábil',
                   'Cód. Fornecedor',
                   'Fornecedor'],
                   ['IMO_DOCAQU','IMO_ESPAQU','GER_VLRCON','FOR_CODFOR','FOR_NOMFOR'],
                   'IMO_DOCAQU',
                   'CADIMO',
                   Self.Name,
                   'Consulta de Documentos de Aquisição de Ativo/Imobilizado',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'IMO_DOCAQU') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('IMO_DOCAQU').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('IMO_DOCAQU').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('IMO_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 6)
            Else
              edtCodigo.Text := fStrZero('0', 6);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

{************************}
{* CONSULTA DE DIVERSOS *}
{*********************DP*}
function fPesqDiversos(Self        : TForm;                  {* Formulário                                  *}
                       edtCodigo   : TCustomEdit;            {* Edit do Código                              *}
                       edtDescri   : TEditFocus;             {* Edit da Descrição                           *}
                       qryTabela   : TUniQuery;              {* Query                                       *}
                       Var chrKey  : Char;                   {* Key                                         *}
                       Var arrSel  : TConsultasArray;        {* Array de Seleção                            *}
                       blnConSim: Boolean = True;            {* Consulta Simples ou Múltipla (multi select) *}
                       blnVerStatus: Boolean = False;        {* Verifica Status (Ativo Sim ou Não)          *}
                       blnVerEmpAce: Boolean = False;
                       strCodCli   : String  = ''): Boolean; {* Apenas profissionais vinculados ao cliente  *}
  Const
    SQL_ATIVIDADE = '(SELECT ATI_DESATI FROM CADATI WHERE ATI_CODATI = DIV_CODATI)';
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrTitCol: TColunasArray;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
      strFiltroCliente: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
       strWhere := '';

      if (blnVerStatus) Then
        strWhere := strWhere + ' AND DIV_STATUS = "A" ';

      If (blnVerEmpAce) Then
        strWhere := strWhere + ' AND LOCATE(' + QuotedStr(VS_strCodEmp) + ', DIV_EMPACE) ';

      If (Not fEmptyStr(strCodCli)) Then
      Begin
        strFiltroCliente := ' AND DIV_CODDIV IN (SELECT DIV_CODDIV FROM CLIDIV WHERE DIV_CODCLI = ' + QuotedStr(strCodCli) + ') ';

        If (fCfgSis('OBDVCL') = 'S') or (fCfgSis('OBDVCL') = 'O') Then
        Begin
          If fCfgSis('OBDVCL') = 'O' Then
          Begin
            If fClienteTemProfissionaisVinculados(strCodCli) Then
            strWhere := strWhere + strFiltroCliente;
          End
          Else
            strWhere := strWhere + strFiltroCliente;
        End
      End;

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  DIV_CODDIV,       ';
      strSQL := strSQL + '  DIV_NOMDIV,       ';
      strSQL := strSQL + '  DIV_RAZSOC,       ';
      strSQL := strSQL + '  DIV_ENDERE,       ';
      strSQL := strSQL + '  CID_NOMCID,       ';
      strSQL := strSQL + '  CID_ESTADO,       ';
      strSQL := strSQL + '  DIV_FONE01,       ';
      strSQL := strSQL + '  DIV_FONE02,       ';
      strSQL := strSQL + '  DIV_CELULA,       ';
      strSQL := strSQL + '  DIV_C_G_C_,       ';
      strSQL := strSQL + '  DIV_DTACAD,       ';
      strSQL := strSQL + '  DIV_OBSERV,       ';
      strSQL := strSQL + '  ATIVIDADE,        '; // <-- "ALIAS" DE SUBCONSULTA
      strSQL := strSQL + '  DIV_PERCOM,       ';
      strSQL := strSQL + '  DIV_PERCOP,       ';
      strSQL := strSQL + '  CADDIV.AUTOINCREM, ';

      If (fCfgSis('EMPDIV', varBoolean)) Then
        strSQL := strSQL + '  DIV_EMPACE,   ';

      strSQL := strSQL + '  DIV_CGCCPF        ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADDIV ';
