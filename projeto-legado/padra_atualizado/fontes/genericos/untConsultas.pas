  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

