function fPesqNotaFiscalServicoSubstituicao(Self     : TForm;               {* Formulário                                  *}
                                            qryTabela: TUniQuery): Boolean; {* Consulta Simples ou Múltipla (multi select) *}
Var
  strSQL : String;
  strWhere : String;
  qryConsulta: TUniQuery;
  arrSel: TConsultasArray;
begin

  Result := False;

  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  FIS_NUMDOC, ';
    strSQL := strSQL + '  FIS_ESPDOC, ';
    strSQL := strSQL + '  FIS_SERIE_, ';
    strSQL := strSQL + '  FIS_FORCLI, ';
    strSQL := strSQL + '  CLI_NOMCLI, ';
    strSQL := strSQL + '  FIS_ACESSO, ';
    strSQL := strSQL + '  FIS_DTAENT, ';
    strSQL := strSQL + '  FIS_DTADOC, ';
    strSQL := strSQL + '  CADFIS.AUTOINCREM ';
    strSQL := strSQL + 'FROM CADFIS ';
    strSQL := strSQL + 'INNER JOIN CADCLI ON CADCLI.CLI_CODCLI = CADFIS.FIS_FORCLI ';
    strSQL := strSQL + 'INNER JOIN LOGNFE LN ON NFE_ESPDOC = FIS_ESPDOC ';
    strSQL := strSQL + '  AND NFE_NUMDOC = FIS_NUMDOC ';
    strSQL := strSQL + '  AND IFNULL(NFE_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';
    strSQL := strSQL + '  AND NFE_CODCLI = FIS_FORCLI ';
    strSQL := strSQL + '  AND NFE_CODEMP = FIS_CODEMP ';

    strWhere := '';
    strWhere := strWhere + 'WHERE FIS_ESPDOC = "NS" ';
    strWhere := strWhere + '  AND FIS_CODEMP = ' + QuotedStr(VS_strCodEmp);
    strWhere := strWhere + '  AND IFNULL(FIS_ACESSO, "") <> "" ';
    strWhere := strWhere + '  AND IFNULL(NFE_STATUS, "") IN ("AT","CN") ';

    If Not Assigned(qryTabela) Then
      qryConsulta := fCriaQuery(Nil)
    Else
      qryConsulta := qryTabela;

    If fConsulta([strSQL, strWhere],
                ['Documento',
                 'Espécie',
                 'Série',
                 'Cliente',
                 'Nome',
                 'Chave de Acesso',
                 'Dt.Entrada',
                 'Dt.Documento'],
                 ['FIS_NUMDOC',
                  'FIS_ESPDOC',
                  'FIS_SERIE_',
                  'FIS_FORCLI',
                  'CLI_NOMCLI',
                  'FIS_ACESSO',
                  'FIS_DTAENT',
                  'FIS_DTADOC'],
                 '',
                 'CADFIS',
                 Self.Name,
                 'Selecione a Nota de Serviço que será Substituida',
                 qryConsulta,
                 Nil,
                 True,
                 arrSel,
                 'AUTOINCREM') Then
    Begin

      Result := True;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

    End;

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '');
    End;
  End;

end;

function fPesqPontosImpressaoNFE(Self     : TForm;                       {* Formulário                                  *}
