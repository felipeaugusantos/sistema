function fPesqCashbackDevolucaoEmbalagem(
                           Self       : TForm;                      {* Formulário                                  *}
                           var AAutInc: String;                     {* Autoincremento da tabela VENCSH             *}
                           var chrKey : Char): Boolean;
var
  strSQL,
  strWhere   : String;
  qryConsulta: TUniQuery;
  objConsulta: TDefConsulta;
  arrTitCol  : TColunasArray; {* Títulos das Colunas  *}
  arrSel     : TConsultasArray;

  procedure pAddNomeColuna(strNomCol: String);
  begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  end;

begin
  Result  := False;
  AAutInc := EmptyStr;

  if fEntraCons(chrKey) then
  begin
    try
      qryConsulta := nil;
      objConsulta := nil;
      try
        chrKey := #0;
        objConsulta := TDefConsulta.Create;
        qryConsulta := fCriaQuery(nil);

        strSQL := EmptyStr;
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  VCB_NUMCSH, ';            pAddNomeColuna('Cashback');
        strSQL := strSQL + '  VCB_CODCLI, ';            pAddNomeColuna('Cód. Cliente');
        strSQL := strSQL + '  (CASE ';
        strSQL := strSQL + '     WHEN (IFNULL(CON_NOMCON,"") <> "") THEN ';
        strSQL := strSQL + '       CON_NOMCON ';
        strSQL := strSQL + '   ELSE ';
        strSQL := strSQL + '     CLI_NOMCLI ';
        strSQL := strSQL + '   END) AS VCB_NOMCLI, ';   pAddNomeColuna('Cliente');
        strSQL := strSQL + '  VCB_VLRDSP, ';            pAddNomeColuna('Valor Disponível');
        strSQL := strSQL + '  VCB_DTAENT, ';            pAddNomeColuna('Dta Cashback');
        strSQL := strSQL + '  VCB_TELCON, ';            pAddNomeColuna('Telefone');
        strSQL := strSQL + '  VCB_CGCCON, ';            pAddNomeColuna('CPF/CNPJ');
        strSQL := strSQL + '  VCB_CODEMP, ';            pAddNomeColuna('Cód. Empresa');
        strSQL := strSQL + '  VCB_CODOPE, ';            pAddNomeColuna('Cód. Operador');
        strSQL := strSQL + '  VENCSH.AUTOINCREM ';
        strSQL := strSQL + 'FROM VENCSH ';
        strSQL := strSQL + '  LEFT JOIN CADCLI ON CLI_CODCLI = VCB_CODCLI ';
        strSQL := strSQL + '  LEFT JOIN CLICON ON CON_C_P_F_ = VCB_CGCCON ';
        strSQL := strSQL + '                  AND (CON_CELULA = VCB_TELCON ';
        strSQL := strSQL + '                   OR  CON_FONE01 = VCB_TELCON) ';

        strWhere := EmptyStr;
        strWhere := strWhere + 'WHERE VCB_ORIGEM = "E" ';
        strWhere := strWhere + '  AND IFNULL(VCB_VLRDSP,0) > 0 ';
        strWhere := strWhere + '  AND VCB_STATUS = "A" ';

        objConsulta.pFormataDecimal('VCB_VLRDSP', 3);

        if fConsulta([strSQL, strWhere],
                     arrTitCol,
                     ['VCB_CODCLI', 'VCB_TELCON','VCB_CGCCON','VCB_DTAENT','VCB_CODEMP','VCB_CODOPE'],
                     '',
                     'VENCSH',
                     Self.Name,
                     'Consulta de Cashback - Devolução de Embalagens',
                     qryConsulta,
                     nil,
                     True,
                     arrSel,
                     'AUTOINCREM',
                     objConsulta) then
        Begin
          AAutInc := qryConsulta.FieldByName('AUTOINCREM').AsString;
          Result  := True;
        end;
    finally
      FreeAndNil(qryConsulta);
      FreeAndNil(objConsulta);
    end;
    except
      on E: Exception do
      begin
        pMensagensErro(E.Message, '');
      end;
    end;
  end;
end;

