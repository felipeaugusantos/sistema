      strSQL := strSQL + '  EQL_GARANT, ';              pAddNomeColuna('Garantia (meses)');
      strSQL := strSQL + '  EQL_DTULMN, ';              pAddNomeColuna('Data da Última Manutenção');
      strSQL := strSQL + '  EQL_RPULMN, ';              pAddNomeColuna('Responsável pela Última Manutenção');
      strSQL := strSQL + '  EQL_MODELO, ';              pAddNomeColuna('Modelo');
      strSQL := strSQL + '  EQL_ANOFAB, ';              pAddNomeColuna('Ano de Fabricação');
      strSQL := strSQL + '  EQL_ESPECF, ';              pAddNomeColuna('Especificações');
      strSQL := strSQL + '  EQL_LOCFIS, ';              pAddNomeColuna('Localização Física');
      strSQL := strSQL + '  DESITE,     ';              pAddNomeColuna('Produto');
      strSQL := strSQL + '  EQL_DTAVEN, ';              pAddNomeColuna('Data de Venda do Equipamento');

      strSQL := strSQL + '  SITUACAO,   ';              pAddNomeColuna('Situação');

      If (dtaContratoIni > 0) And (dtaContratoFin > 0) Then
      Begin
        strSQL := strSQL + '  MIN(DTAINI) LOC_DTAINI, ';  pAddNomeColuna('Locação inicial');
        strSQL := strSQL + '  MAX(DTAFIN) LOC_DTAFIN, ';  pAddNomeColuna('Locação final');

        objConsulta.pIncluiCampoProcessado('LOC_DTAINI');
        objConsulta.pIncluiCampoProcessado('LOC_DTAFIN');
      End;

      strSQL := strSQL + '  EQL_VLLOCD,   ';              pAddNomeColuna('Valor Locação Diária');
      strSQL := strSQL + '  EQL_DSCVEN,   ';              pAddNomeColuna('Desc.Vendedor');
      strSQL := strSQL + '  EQL_DSCSGE,   ';              pAddNomeColuna('Desc.SubGerente');
      strSQL := strSQL + '  EQL_DSCGER,   ';              pAddNomeColuna('Desc.Gerente');
      strSQL := strSQL + '  EQL_VLRCAU,   ';              pAddNomeColuna('Valor Caução');

      strSQL := strSQL + '  CADEQL.AUTOINCREM  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADEQL ';
      strSQL := strSQL + 'INNER JOIN CADITE ON ITE_CODITE = EQL_CODITE ';

      If (dtaContratoIni > 0) And (dtaContratoFin > 0) Then
      Begin
        strSQL := strSQL + 'LEFT JOIN( ';
        strSQL := strSQL + '  SELECT ';
        strSQL := strSQL + '    EQD_SEQEQL, ';
        strSQL := strSQL + '    TIMESTAMP(EQL_DTAINI, EQL_HORINI) DTAINI, ';
        strSQL := strSQL + '    TIMESTAMP(EQL_DTAFIN, EQL_HORFIN) DTAFIN  ';
        strSQL := strSQL + '   FROM CONEQL ';
        strSQL := strSQL + '   JOIN EQLDET ON EQD_SEQCON = CONEQL.AUTOINCREM ';
        strSQL := strSQL + '  WHERE EQL_STATUS NOT IN ("C","F") ';
        strSQL := strSQL + '    AND TIMESTAMP(EQL_DTAINI, EQL_HORINI) <= "'+ FormatDateTime('yyyy-mm-dd hh:nn', dtaContratoFin) +'" ';
        strSQL := strSQL + '    AND TIMESTAMP(EQL_DTAFIN, EQL_HORFIN) >= "'+ FormatDateTime('yyyy-mm-dd hh:nn', dtaContratoIni) +'" ';

        If Not fEmptyStr(strCodContrato) Then
          strSQL := strSQL + '  AND EQL_NROCON <> "'+ strCodContrato +'" ';

        strSQL := strSQL + ')LOC ON EQD_SEQEQL = EQL_CODIGO ';
      End;

      pAddCamposKey('EQL_DESCRI');
      pAddCamposKey('EQL_CODIGO');

      If (Not Assigned(qryTabela)) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta.pIncluiSubConsulta('DESITE', 'CONCAT(EQL_CODITE, "-", ITE_DESITE)');
      objConsulta.pIncluiSubConsulta('SITUACAO', '(CASE WHEN EQL_STATUS = "A" THEN "ATIVO" ' +
                                                 '      WHEN EQL_STATUS = "I" THEN "INATIVO" ' +
                                                 '      WHEN EQL_STATUS = "B" THEN "BLOQUEADO" ' +
                                                 ' END)');
      objConsulta.pIncluiCampoSimNao('SITUACAO', ['ATIVO', 'INATIVO', 'BLOQUEADO', 'TODOS']);

      strWhere := ' WHERE TRUE ';
      strGroup := '';

      If (dtaContratoIni > 0) And (dtaContratoFin > 0) Then
        strGroup := ' GROUP BY EQL_CODIGO ';

      strSQLAux := ' ) AS CONS ';

      If fConsultaConfig([strSQL, strWhere, strGroup, strSQLAux],
                   arrTitCol,
                   arrCamKey,
                   'EQL_CODIGO',
                   'CADEQL',
                   Self.Name,
                   'Consulta de Equipamentos para Locação',
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'EQL_CODIGO',
                   '',
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('EQL_CODIGO').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('EQL_CODIGO').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('EQL_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 5)
            Else
              edtCodigo.Text := fStrZero('0', 5);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';
        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, 'fPesqCadastroEquipLocacao');
      End;
    End;
  End;
end;

function fPesqContratoLocEquip(Self      : TForm;                                {* Formulário        *}
                               edtCodigo : TCustomEdit;                          {* Edit do Código    *}
                               edtDescri : TEditFocus;                           {* Edit da Descrição *}
                               qryTabela : TUniQuery;                            {* Query             *}
                               Var chrKey: Char;                                 {* Key               *}
                               Var arrSel: TConsultasArray;                      {* Array de Seleção  *}
                               blnConSim: Boolean = True;                        {* Consulta Simples  *}
                               blnFiltraEmp : Boolean = True): Boolean;

  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    arrTitCol,
    arrCamKey: TColunasArray;
    objConsulta: TDefConsulta;
    strGroup: String;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Procedure pAddCamposKey(strNomCol: String);
  Begin
    SetLength(arrCamKey, Succ(Length(arrCamKey)));
    arrCamKey[High(arrCamKey)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If (Not fCfgSis('LOCEMP', VarBoolean)) Or (blnFiltraEmp) Then
      strWhere := strWhere + ' AND EQL_CODEMP = ' + QuotedStr(VS_strCodEmp);

    Result := strWhere;
  End;

begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin
    Try
      SetLength(arrTitCol, 0);
      SetLength(arrCamKey, 0);

      chrKey := #0;

      strSQL := 'SELECT SQL_NO_CACHE ';

      If fCfgSis('PDRCTR', VarBoolean) Then
      Begin
        strSQL := strSQL + ' CONCAT(FGO_NUMDOC, "-", FGO_CODEMP) AS FGO_NUMDOC, '; pAddNomeColuna('N° Pedido ');
      End;

      If fCfgSis('LOCEMP', VarBoolean) Then
      Begin
        strSQL := strSQL + '  EQL_CODEMP, ';   pAddNomeColuna('Empresa');
      End;

      strSQL := strSQL + '  EQL_NROCON, ';   pAddNomeColuna('Número do contrato');
      strSQL := strSQL + '  STATUS,     ';   pAddNomeColuna('Status');
      strSQL := strSQL + '  EQL_CODCLI, ';   pAddNomeColuna('Código do cliente');
      strSQL := strSQL + '  CLI_NOMCLI, ';   pAddNomeColuna('Nome do cliente');
      strSQL := strSQL + '  EQL_DTAINI, ';   pAddNomeColuna('Data inicial');
      strSQL := strSQL + '  EQL_HORINI, ';   pAddNomeColuna('Hora inicial');
      strSQL := strSQL + '  EQL_DTAFIN, ';   pAddNomeColuna('Data final');
      strSQL := strSQL + '  EQL_HORFIN, ';   pAddNomeColuna('Hora final');
      strSQL := strSQL + '  EQL_QTDEQU, ';   pAddNomeColuna('Quantidade de equipamentos');
      strSQL := strSQL + '  EQL_TOTCON, ';   pAddNomeColuna('Valor total do contrato');
      strSQL := strSQL + '  NSERIE,     ';   pAddNomeColuna('N° Série');
      strSQL := strSQL + '  CONEQL.AUTOINCREM  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CONEQL ';
      strSQL := strSQL + 'INNER JOIN CADCLI ON CLI_CODCLI = EQL_CODCLI ';
      strSQL := strSQL + 'LEFT  JOIN FATGOR ON FATGOR.AUTOINCREM = EQL_AUT_PD ';
      strSQL := strSQL + 'INNER JOIN EQLDET ON CONEQL.AUTOINCREM = EQD_SEQCON ';

      strGroup := ' GROUP BY CONEQL.AUTOINCREM ';

      pAddCamposKey('EQL_NROCON');
      pAddCamposKey('EQL_CODCLI');
      pAddCamposKey('CLI_NOMCLI');
      pAddCamposKey('EQL_DTAINI');
      pAddCamposKey('EQL_DTAFIN');

      If (Not Assigned(qryTabela)) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;

      objConsulta.pIncluiSubConsulta('STATUS', '(CASE EQL_STATUS WHEN "O" THEN "ORÇAMENTO" ' +
                                                               ' WHEN "A" THEN "ATIVO"      ' +
                                                               ' WHEN "F" THEN "FATURADO"   ' +
                                                               ' WHEN "C" THEN "CANCELADO"  ' +
                                                               ' WHEN "E" THEN "ENCERRADO" END)');
      objConsulta.pIncluiCampoSimNao('STATUS', ['ORÇAMENTO', 'ATIVO', 'FATURADO',
                                                    'CANCELADO', 'ENCERRADO', 'TODOS']);

      objConsulta.pIncluiSubConsulta('NSERIE', '(SELECT GROUP_CONCAT(EQL_NSERIE) FROM CADEQL WHERE EQD_SEQEQL = EQL_CODIGO)');

      If fConsultaConfig([strSQL, fSQLWhere(True), strGroup],
                         arrTitCol,
                         arrCamKey,
                         'EQL_NROCON',
                         'CONEQL',
                         Self.Name,
                         'Consulta de Contratos de Locação de Equipamentos',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'EQL_NROCON',
                         fSQLWhere(False),
                         '',
                         False,
                         objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
             (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('EQL_NROCON').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('EQL_NROCON').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('EQL_NROCON').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 12)
            Else
              edtCodigo.Text := fStrZero('0', 12);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';
        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, 'fPesqContratoLocEquip');
      End;
    End;
  End;
end;

