function fPesqLoteItens(Self       : TForm;                            {* Formulário                                  *}
                        edtNumLote : TCustomEdit;                      {* Edit do Número do Lote                      *}
                        edtCodIte  : TCustomEdit;                      {* Edit do Código do Item                      *}
                        intDecUni  : Integer;                          {* Casas decimais                              *}
                        qryTabela  : TUniQuery;                        {* Query                                       *}
                        Var chrKey : Char;                             {* Key                                         *}
                        Var arrSel : TConsultasArray;                  {* Array de Seleção                            *}
                        blnConSim  : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                        strCodIte  : String = '';
                        strCodEmp  : String = '';
                        blnSoAtivos: Boolean = False;
                        blnRetNumLot: Boolean = False;
                        stlItensComLoteSemLocalizacao : TStringList = nil;
                        blnConsiderarLoteGarantia : Boolean = True;
                        blnConsiderarADefinir: Boolean = True;
                        blnApenasLoteComLocalizacao: Boolean = False): Boolean;
  var
    strSQL       : String;
    qryConsulta  : TUniQuery;
    blnSomaEntFut,
    blnArmazem   : Boolean;
    strName      : String;
    strTitulo    : String;
    arrTitCol    : TColunasArray;
    objConsulta  : TDefConsulta;
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
    intDecQtd : Integer;
  Procedure pAddNomeColuna(strTitCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strTitCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
  	  strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND LOT_CODEMP = ' + QuotedStr(strCodEmp);

    If blnSoAtivos Then
      strWhere := strWhere + ' AND LOT_STATUS = "S" ';

    if not blnConsiderarLoteGarantia then
    begin
      strWhere := strWhere + ' AND LOT_GARPRI = "N" ' ;
    end;

    if not blnConsiderarADefinir then
    begin
      strWhere := strWhere + ' AND LOT_NUMLOT <> "A DEFINIR" ' ;
    end;

    If Not fEmptyStr(strCodIte) Then
      strWhere := strWhere + ' AND LOT_CODITE = ' + QuotedStr(strCodIte)
    Else
      If Assigned(edtCodIte) And (Not fEmptyStr(edtCodIte.Text)) Then
        strWhere := strWhere + ' AND LOT_CODITE = ' + QuotedStr(edtCodIte.Text);

    If ( Assigned(stlItensComLoteSemLocalizacao) And (stlItensComLoteSemLocalizacao.Count > 0)) Then
    Begin
      strWhere := strWhere + ' AND LOT_CODITE IN (' + fCommaText(stlItensComLoteSemLocalizacao, True) + ')' ;
      strWhere := strWhere + ' AND LOT_NUMLOT <> "A DEFINIR" ';
      strWhere := strWhere + ' AND ((CADLOC.AUTOINCREM IS NULL) OR ( LOT_LOCFIS = "" )) ';
    End;

    If blnApenasLoteComLocalizacao Then
      strWhere := strWhere + ' AND LOT_LOCFIS IS NOT NULL ';

    Result := strWhere;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin
    If blnArmazem Then
      objLoadSql.fIncluiSubConsulta('AMZDESCRI', 'AMZ_DESCRI', 'Descrição do Armazém');

    If fCfgSis('CADLOC', VarBoolean) Then
      objLoadSql.fIncluiSubConsulta('LOCDESCRI', 'LOC_DESCRI', 'Descrição Loc. Física');

    If (not blnSomaEntFut) Then
      objLoadSql.fIncluiSubConsulta('LOT_SALDOS', 'ROUND(LOT_SALDOS, 3)', 'Saldo')
    Else
      objLoadSql.fIncluiSubConsulta('LOT_SALDOS', 'ROUND(LOT_SALDOS + ' + fGetSQLSomaCamposEntregaFutura('L', True, True) + ', 3)', 'Saldo');

    If fUsaRotinaWMS Then
    Begin
      objLoadSql.fIncluiSubConsulta('LOTMLBAL', 'LOT_ML_BAL', 'Saldo Balanço (ML/GR)');
      objLoadSql.fIncluiSubConsulta('LOTSALML', 'LOT_SAL_ML', 'Saldo Atual (ML/GR)');
    End;

    If blnArmazem Then
      objLoadSql.stlJoins.Add(' INNER JOIN CADAMZ ON AMZ_CODAMZ = LOT_NUMLOT AND AMZ_CODEMP = LOT_CODEMP ');

    If fCfgSis('CADLOC', VarBoolean) Or ( Assigned(stlItensComLoteSemLocalizacao) And (stlItensComLoteSemLocalizacao.Count > 0)) Then
      objLoadSql.stlJoins.Add(' LEFT JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS AND LOC_CODEMP = LOT_CODEMP ');

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

  Procedure pConsultaAntiga;
  var
    intCont: Integer;
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  LOT_NUMLOT , '; pAddNomeColuna(VS_strTitLot);

    If blnArmazem Then
    Begin
      strSQL := strSQL + '  AMZ_DESCRI, '; pAddNomeColuna('Descrição do Armazém');
    End;

    strSQL := strSQL + '  LOT_LOCFIS , '; pAddNomeColuna('Loc. Física');

    If fCfgSis('CADLOC', VarBoolean) Then
    Begin
      strSQL := strSQL + '   LOC_DESCRI , '; pAddNomeColuna('Descrição Loc. Física');
    End;

    strSQL := strSQL + '  LOT_CODITE , '; pAddNomeColuna('Cód.Item');
    strSQL := strSQL + '  ITE_DESITE , '; pAddNomeColuna('Descrição do Item');
    strSQL := strSQL + '  ITE_CODMAR , '; pAddNomeColuna('Cód. Marca');
    strSQL := strSQL + '  MAR_DESMAR , '; pAddNomeColuna('Desc. Marca');
    strSQL := strSQL + '  ITE_REFERE , '; pAddNomeColuna('Referência do Item');
    strSQL := strSQL + '  UNI_SIGUNI , '; pAddNomeColuna('Unidade');

    strSQL := strSQL + '  LOT_DTAFAB , '; pAddNomeColuna('Fabricação');
    strSQL := strSQL + '  LOT_DTAVAL , '; pAddNomeColuna('Validade');
    strSQL := strSQL + '  LOT_SALBAL , '; pAddNomeColuna('Saldo Balanço');
    strSQL := strSQL + '  LOT_SALDOS , '; pAddNomeColuna('Saldo Atual');

    If (not blnSomaEntFut) Then
      objConsulta.pIncluiSubConsulta('LOT_SALDOS', 'ROUND(LOT_SALDOS, '+ intToStr(intDecQtd)+' )')
    Else
      objConsulta.pIncluiSubConsulta('LOT_SALDOS', 'ROUND( LOT_SALDOS + ' + fGetSQLSomaCamposEntregaFutura('L', True, True) + ', '+ intToStr(intDecQtd)+')');

    {Com Saldo? Sim/Não}
    strSQL := strSQL + '   COMSALDO,    '; pAddNomeColuna('Com Saldo?');
    objConsulta.pIncluiSubConsulta('COMSALDO', 'IF((IFNULL(LOT_SALDOS, 0) > 0), "SIM", "NÃO")');
    objConsulta.pIncluiCampoSimNao('COMSALDO');

    If fCfgSis('MARMOR', varBoolean) Then
    Begin
      If fCfgSis('CTRLCH', varString) = '2' Then
      Begin
        strSQL := strSQL + '  LOT_NCHAPA , '; pAddNomeColuna('Qtd Chapa');
        objConsulta.pIncluiSubConsulta('LOT_NCHAPA', 'LOT_SALDOS / (IFNULL(LOT_MEDL_L, 0) * IFNULL(LOT_MEDL_A, 0))');
      End
      Else
      begin
        strSQL := strSQL + '  LOT_NCHAPA , '; pAddNomeColuna('Chapa');
        strSQL := strSQL + '  LOT_MGLPRI , '; pAddNomeColuna('Lote Principal');
        objConsulta.pIncluiSubConsulta('LOT_MGLPRI', 'CAST(IF(LOT_CHAPA_ = "S", REVERSE(SUBSTRING(REVERSE(LOT_NUMLOT), POSITION("/" IN REVERSE(LOT_NUMLOT)) + 1, LENGTH(LOT_NUMLOT))), "") AS CHAR(30))');
      End;

      strSQL := strSQL + '  LOT_MEDB_L , '; pAddNomeColuna('Medida Bruta - Largura');
      strSQL := strSQL + '  LOT_MEDB_A , '; pAddNomeColuna('Medida Bruta - Altura');
      strSQL := strSQL + '  LOT_MEDL_L , '; pAddNomeColuna('Medida Líquida - Largura');
      strSQL := strSQL + '  LOT_MEDL_A , '; pAddNomeColuna('Medida Líquida - Altura');
      strSQL := strSQL + '  LOT_ESPESS , '; pAddNomeColuna('Espessura');
      If fCfgSis('MARENT', varBoolean) Then
      Begin
        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          begin
            strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço M² Retira (R$) - ' + IntToStr(intCont));
          end;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          begin
            strSQL := strSQL + '  LOT_VENTO' + IntToStr(intCont) + ' , '; pAddNomeColuna('Valor Total M² Retira (R$) - ' + IntToStr(intCont));
          end;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          begin
            strSQL := strSQL + '  LOT_PRVEE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço M² Entrega (R$) - ' + IntToStr(intCont));
          end;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          begin
            strSQL := strSQL + '  LOT_VETOE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Valor Total M² Entrega (R$) - ' + IntToStr(intCont));
          end;
        end;
      End
      Else
      Begin
        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          begin
            strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço M²(R$) - ' + IntToStr(intCont));
          end;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          begin
            strSQL := strSQL + '  LOT_VENTO' + IntToStr(intCont) + ' , '; pAddNomeColuna('Valor Total M² (R$) - ' + IntToStr(intCont));
          end;
        end;
      End;

      strSQL := strSQL + '  LOT_CALLIQ , '; pAddNomeColuna('Qtd. M² Líquido');
      objConsulta.pIncluiSubConsulta('LOT_CALLIQ', 'LOT_MEDL_L * LOT_MEDL_A');
    End;


    If fUsaRotinaWMS Then
    Begin
      strSQL := strSQL + '  LOT_ML_BAL , '; pAddNomeColuna('Saldo Balanço (ML/GR)');
      strSQL := strSQL + '  LOT_SAL_ML , '; pAddNomeColuna('Saldo Atual (ML/GR)');
    End;

    strSQL := strSQL + '  LOT_PRECUS , '; pAddNomeColuna('Preço de Custo');

    If fCfgSis('MARENT', varBoolean) Then
    Begin
      for intCont := 1 to Length(VS_strTabVen) do
      begin
        if (VS_strTabVen[intCont] = 'S') then
        begin
          strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço de Venda Retira - ' + IntToStr(intCont));
        end;
      end;

      for intCont := 1 to Length(VS_strTabVen) do
      begin
        if (VS_strTabVen[intCont] = 'S') then
        begin
          strSQL := strSQL + '  LOT_PRVEE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço de Venda Entrega - ' + IntToStr(intCont));
        end;
      end;
    End
    Else
    Begin
      for intCont := 1 to Length(VS_strTabVen) do
      begin
        if (VS_strTabVen[intCont] = 'S') then
        begin
          strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço de Venda - ' + IntToStr(intCont));
        end;
      end;
    End;

    strSQL := strSQL + '  LOT_BROKER , '; pAddNomeColuna('Lote Broker');
    objConsulta.pIncluiSubConsulta('STATUS_SN', 'IF(LOT_STATUS = "S", "ATIVO", "INATIVO") ');
    objConsulta.pIncluiCampoSimNao('STATUS_SN', ['ATIVO', 'INATIVO', 'TODOS']);
    strSQL := strSQL + '  STATUS_SN, '; pAddNomeColuna('Status');
    strSQL := strSQL + '  L.AUTOINCREM ';
    strSQL := strSQL + 'FROM      ';
    strSQL := strSQL + '  CADLOT L ';
    strSQL := strSQL + 'INNER JOIN CADITE ON ITE_CODITE = LOT_CODITE ';
    strSQL := strSQL + 'LEFT  JOIN CADUNI ON UNI_CODUNI = ITE_CODUNI ';
    strSQL := strSQL + 'LEFT  JOIN CADMAR ON ITE_CODMAR = MAR_CODMAR ';

    If blnArmazem Then
      strSQL := strSQL + 'INNER JOIN CADAMZ ON AMZ_CODAMZ = LOT_NUMLOT AND AMZ_CODEMP = LOT_CODEMP ';

    If fCfgSis('CADLOC', VarBoolean) Or ( Assigned(stlItensComLoteSemLocalizacao) And (stlItensComLoteSemLocalizacao.Count > 0)) Then
      strSQL := strSQL + ' LEFT JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS AND LOC_CODEMP = LOT_CODEMP ';

    arrSQLConsulta    := [strSQL, fSQLWhere(True)];
    arrCamposConsulta := arrTitCol;
  End;
begin
  intDecQtd := fCfgSis('DECQTD', varInteger);

  If fEmptyStr(strCodEmp) Then
    strCodEmp := VS_strCodEmp;

  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      objConsulta := TDefConsulta.Create;
      objConsulta.pAdicionaTabela('CADLOT', 'L');

      strTitulo := 'Consulta de ' + VS_strTitLts + ' dos Itens';

      blnArmazem := (fCfgSis('CTLEST') = '2');
      blnSomaEntFut := fUsaQtdPendenteEntregaFutura;

      objConsulta.pFormataDecimal('LOT_SALDOS', intDecQtd);

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      strName := 'fPesqLoteItens';
      If Assigned(Self) Then
        strName := Self.Name;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['LOT_NUMLOT','LOT_LOCFIS','ITE_DESITE','LOT_CODITE'],
                   '',
                   'CADLOT',
                   strName,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   IIF(blnRetNumLot, 'LOT_NUMLOT','AUTOINCREM'),
                   objConsulta) Then
      Begin
        If Assigned(edtNumLote) then
        Begin
          If (edtNumLote Is TEditFocus) Then
            (edtNumLote As TEditFocus).Text := qryConsulta.FieldByName('LOT_NUMLOT').AsString
          Else
            edtNumLote.Text := qryConsulta.FieldByName('LOT_NUMLOT').AsString;
        End;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtNumLote) then
          Begin
            If (edtNumLote Is TEditFocus) Then
             // (edtNumLote As TEditFocus).Text := fStrZero('0', 3)
              (edtNumLote As TEditFocus).Text := '+1'
            Else
             // edtNumLote.Text := fStrZero('0', 3);
              edtNumLote.Text := '+1';
          End;

          (*
          If Assigned(edtCodIte) then
          Begin
            If (edtCodIte Is TEditFocus) Then
              (edtCodIte As TEditFocus).Text := fStrZero('0', 5)
            Else
              edtCodIte.Text := fStrZero('0', 5);
          End;
          *)

        End Else
        Begin
          If Assigned(edtCodIte) then
          Begin
            If (edtCodIte Is TEditFocus) Then
              (edtCodIte As TEditFocus).Text := qryConsulta.FieldByName('LOT_CODITE').AsString
            Else
              edtCodIte.Text := qryConsulta.FieldByName('LOT_CODITE').AsString;
          End;
        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  end;

end;


function fPesqLoteRastreamento(Self       : TForm;                            {* Formulário                                  *}
                               edtNumLote : TCustomEdit;                      {* Edit do Número do Lote                      *}
                               edtCodIte  : TCustomEdit;                      {* Edit do Código do Item                      *}
                               intDecUni  : Integer;                          {* Casas decimais                              *}
                               qryTabela  : TUniQuery;                        {* Query                                       *}
                               Var arrSel : TConsultasArray;                  {* Array de Seleção                            *}
                               blnConSim  : Boolean = True                    {* Consulta Simples ou Múltipla (multi select) *}
                               ): Boolean;
  var
    strSQL   : String;
    qryConsulta  : TUniQuery;
    strName      : String;
    arrTitCol    : TColunasArray;
    objConsulta  : TDefConsulta;

  Procedure pAddNomeColuna(strTitCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strTitCol;
  End;

begin

  Result := False;
  Try

    objConsulta := TDefConsulta.Create;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  LOT_NUMLOT , '; pAddNomeColuna('Número Lote');
    strSQL := strSQL + '  LOT_CODITE , '; pAddNomeColuna('Cód.Item');
    strSQL := strSQL + '  ITE_DESITE , '; pAddNomeColuna('Descrição do Item');
    strSQL := strSQL + '  ITE_REFERE , '; pAddNomeColuna('Referência do Item');
    strSQL := strSQL + '  LOT_CODFOR , '; pAddNomeColuna('código do Fornecedor');
    strSQL := strSQL + '  FOR_NOMFOR , '; pAddNomeColuna('Nome do Fornecedor');

    strSQL := strSQL + '  LOTRAS.AUTOINCREM ';
    strSQL := strSQL + 'FROM      ';
    strSQL := strSQL + '  LOTRAS ';
    strSQL := strSQL + 'INNER JOIN CADITE ON ITE_CODITE = LOT_CODITE ';
    strSQL := strSQL + 'LEFT JOIN CADFOR ON FOR_CODFOR = LOT_CODFOR ';

    If Not Assigned(qryTabela) Then
      qryConsulta := fCriaQuery(Nil)
    Else
      qryConsulta := qryTabela;

    strName := 'fPesqLoteRastreamento';
    If Assigned(Self) Then
      strName := Self.Name;

    If fConsultaConfig([strSQL],
                 arrTitCol,
                 ['LOT_NUMLOT'],
                 '',
                 'LOTRAS',
                 strName,
                 'Consulta Lote de Rastreamento dos Itens',
                 qryConsulta,
                 Nil,
                 blnConSim,
                 arrSel,
                 'AUTOINCREM',
                 '',
                 '',
                 False,
                 objConsulta) Then
    Begin
      If Assigned(edtNumLote) then
      Begin
        If (Length(arrSel) > 1) Then
          edtNumLote.Text := '+1'
        else
        begin
          edtNumLote.Text :=                   'Lot:' + qryConsulta.FieldByName('LOT_NUMLOT').AsString;
          edtNumLote.Text := edtNumLote.Text + '     Item:' + qryConsulta.FieldByName('LOT_CODITE').AsString;
          edtNumLote.Text := edtNumLote.Text + '     Fornecedor:' + qryConsulta.FieldByName('LOT_CODFOR').AsString;
        end;
      End;

      Result := True;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);
    End;
    FreeAndNil(objConsulta);

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '');
    End;
  End;

end;

function fPesqLoteFat(Self       : TForm;                            {* Formulário                                  *}
                      edtNumLote : TCustomEdit;                      {* Edit do Código                              *}
                      intDecUni  : Integer;                          {* Casas decimais                              *}
                      strCodIte  : String;                           {* Código do produto                           *}
                      blnSalPos  : Boolean;                          {* Boleana                                     *}
                      blnSemADef : Boolean;                          {* Boleana                                     *}
                      qryTabela  : TUniQuery;                        {* Query                                       *}
                      Var chrKey : Char;                             {* Key                                         *}
                      Var arrSel : TConsultasArray;                  {* Array de Seleção                            *}
                      strEmpLot  : String = '';                      {* Empresa do Item para consulta do Lote       *}
                      objFrmPnl  : TPanelCx = Nil;                   {* Painel                                      *}
                      blnConSim  : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                      arrNumLot  : TStringArray = Nil;               {* Array com lista de Lotes a serem mostrados  *}
                      blnSoAtivo : Boolean = True;                   {* Mostra somente os Lotes Ativos ou Não       *}
                      blnApenasAprovados : Boolean = False;
                      blnApenasPrincipalVendaOuCheckout: Boolean = False;
                      bnlMovimentacaoProgramada: Boolean = False;
                      blnApenasChapa: Boolean = False;
                      arrLotesAdd: TStringArray = Nil;               {* Lotes já adicionados no Pedido              *}
                      strPicking: String = '';
                      blnSemGarantia : Boolean = False;              {* Boleana, sem lote Garantia                  *}
                      blnChamadaViaFaturamento : Boolean = False;
                      blnMostrarLotePickingCheckout : Boolean = False;
                      strEspDoc: String = '';
                      fltValorUnitario: Double = 0;
                      fltSaldoMinimo: Double = 0;
                      blnSemGar:Boolean = False;
                      stlListaNumLotExcluido: String = '';
                      strTabPre: String = '';
                      strEntRet: String = '';
                      blnSomentePicking : Boolean = False;                {* Mostra somente os Lotes PICKING             *}
                      blnNaoExibeLotTransi : Boolean = False):Boolean;    {* Não exibe Lotes em Transição                *}
var
  strSQL      : String;
  strTitulo   : String;
  qryConsulta : TUniQuery;
  blnArmazem  : Boolean;
  blnSalRes   : Boolean;
  objConsulta : TDefConsultaLotFat;
  arrTitCol,
  arrOrd,
  arrSQLConsulta,
  arrCamposConsulta: TColunasArray;
  objLoadSql: TLoadConsultaSQL;
  intDecQtd: Integer;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
      intContador : Integer;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND LOT_CODITE = ' + QuotedStr(strCodIte) + ' AND ';

    If blnSalPos Then
    Begin
      strWhere := strWhere + '  ( ( ( IFNULL(LOT_SALDOS, 0) > 0 ) AND ';
      strWhere := strWhere + '      ( LOCATE(LOT_NUMLOT, "A DEFINIR") <= 0 ) ) ';
      strWhere := strWhere + '   OR ( LOCATE(LOT_NUMLOT, "A DEFINIR") > 0  ) ) AND ';
    End;

    If blnSemADef Then
    Begin
      strWhere := strWhere + '  LOCATE("A DEFINIR", LOT_NUMLOT) <= 0 AND ';
    End;

    If blnSemGarantia Then
    Begin
      strWhere := strWhere + '  LOCATE("GARANTIA", LOT_NUMLOT) <= 0 AND ';
    End;

    strWhere := strWhere + '   LOT_CODEMP = ' + QuotedStr(IIF(fEmptyStr(strEmpLot), VS_strCodEmp, strEmpLot));

    If Assigned(arrNumLot) And (Length(arrNumLot) > 0) Then
    Begin
      strWhere := strWhere + ' AND ( ';
      For intContador := 0 To Length(arrNumLot) -1 Do
      Begin
        strWhere := strWhere + ' (LOT_NUMLOT = ' + QuotedStr(arrNumLot[intContador]) + ')';
        If intContador < (Length(arrNumLot) -1) Then
          strWhere := strWhere + ' OR ';
      End;
      strWhere := strWhere + ' ) ';
    End;

    if blnSoAtivo then
      strWhere := strWhere + ' AND LOT_STATUS = "S" ';

    If blnApenasAprovados Then
      strWhere := strWhere + ' AND LOT_LOTAPR = "S" ';

    If blnApenasPrincipalVendaOuCheckout Then
    begin
      If fCfgSis('CADLOC', VarBoolean) Then
        strWhere := strWhere + ' AND (LOT_ARMOPV = "S" OR LOT_ARMPRI = "S" OR LOC_BALCAO = "S") '
      else
        strWhere := strWhere + ' AND (LOT_ARMOPV = "S" OR LOT_ARMPRI = "S") ';
    end;

    if blnApenasChapa tHEN
      strWhere := strWhere + ' AND (LOT_CHAPA_ = "S") ';
    if bnlMovimentacaoProgramada then
    Begin
      strWhere := strWhere + ' AND LOT_NUMLOT <> "A DEFINIR" ' +
                             ' AND LOT_NUMLOT <> "A REGULARIZAR"' +
                             ' AND LOT_BROKER = ''N''' +
                             ' AND IFNULL(LOC_CRITIC,"N") = "N"' +
//                             ' AND IFNULL(LOC_PICKIN,"N") = "S"' +
                             ' AND ((LOT_SALDOS > 0) OR (IFNULL(LOC_PICKIN,"N") = "S"))' +
                             ' AND ((SELECT COUNT(0) FROM MOVLOT' +
                             '       WHERE MLT_CODEMP = LOT_CODEMP' +
                             '         AND MLT_CODITE = LOT_CODITE' +
                             '         AND MLT_LOTORI = LOT_NUMLOT' +
                             '         AND MLT_QTDMOV = 0' +
                             '         AND MLT_DTAREA IS NULL) = 0)';
    End;

    If fCfgSis('CADLOC', VarBoolean) and (not fEmptyStr(strPicking)) Then
      strWhere := strWhere + '  AND LOC_PICKIN = "' + strPicking + '" ';

    If (blnChamadaViaFaturamento And fCfgSis('PICOUT', varBoolean)) Then
    Begin
      If Not blnMostrarLotePickingCheckout Then
        strWhere := strWhere + '  AND LOC_PICKIN <> "C" ';
    End;

    If Not fEmptyStr(stlListaNumLotExcluido) Then
      strWhere := strWhere + '  AND LOT_NUMLOT NOT IN  (' + stlListaNumLotExcluido + ') ';

    If blnSomentePicking Then
    Begin
      If blnSemADef Then
        strWhere := strWhere + ' AND LOC_PICKIN = "S" '
      Else
        strWhere := strWhere + ' AND (LOC_PICKIN = "S" OR LOT_NUMLOT = "A DEFINIR") ';
    End;

    If blnNaoExibeLotTransi Then
      strWhere := strWhere + ' AND LOT_TRANSI = "N" ';

    Result := strWhere;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin
    If blnArmazem Then
    begin
      objLoadSQL.fIncluiSubConsulta('AMZDESCRI', 'AMZ_DESCRI', 'Descrição do Armazém');
      SetLength(arrOrd, 4);
      arrOrd[0] := 'LOT_NUMLOT';
      arrOrd[1] := 'AMZ_DESCRI';
      arrOrd[2] := 'LOT_DTAFAB';
      arrOrd[3] := 'LOT_DTAVAL';
    end
    else
    begin
      SetLength(arrOrd, 3);
      arrOrd[0] := 'LOT_NUMLOT';
      arrOrd[1] := 'LOT_DTAFAB';
      arrOrd[2] := 'LOT_DTAVAL';
    end;

    If blnSalRes Then
    Begin
      objLoadSQL.fIncluiSubConsulta('LOTSALDOS', '0.0000', 'Saldo Atual');
      objLoadSQL.fIncluiSubConsulta('SALRES',    '0.0000', 'Saldo Reservado');
      objLoadSQL.fIncluiSubConsulta('SALDIS',    '0.0000', 'Saldo Disponível');

      objConsulta.pFormataDecimal('SALRES', intDecQtd);
      objConsulta.pFormataDecimal('SALDIS', intDecQtd);
    End
    Else
    Begin
      objLoadSQL.fIncluiSubConsulta('LOTSALDOS', 'LOT_SALDOS', 'Saldo Atual');
    End;

    objLoadSQL.fIncluiSubConsulta('STATUS_SN', 'IF(LOT_STATUS = "S", "ATIVO", "INATIVO")'     , 'Status');
    objLoadSQL.fIncluiSubConsulta('COMSALDO' , 'IF((IFNULL(LOT_SALDOS, 0) > 0), "SIM", "NÃO")', 'Com Saldo?');

    If fUsaRotinaWMS Then
    Begin
      objLoadSQL.fIncluiSubConsulta('LOTMLBAL', 'LOT_ML_BAL' , 'Saldo Balanço (ML/GR)');
      objLoadSQL.fIncluiSubConsulta('LOTSALML', 'LOT_SAL_ML' , 'Saldo Atual (ML/GR)');
    End;

    If fCfgSis('CADLOC', VarBoolean) Then
    Begin
      objLoadSQL.fIncluiSubConsulta('LOCDESCRI', 'LOC_DESCRI', 'Descrição Loc. Física');
    End;

    If blnSalRes Then
    Begin
      objLoadSQL.fIncluiSubConsulta('LOTCODEMP', 'LOT_CODEMP', 'Empresa');
      objLoadSQL.fIncluiSubConsulta('LOTCODITE', 'LOT_CODITE', 'Item');
      objLoadSQL.fIncluiSubConsulta('SALATU',    'LOT_SALDOS', 'Saldo');
    End;

    If blnArmazem Then
      objLoadSql.stlJoins.Add(' LEFT JOIN CADAMZ ON AMZ_CODAMZ = LOT_NUMLOT AND AMZ_CODEMP = LOT_CODEMP ');

    If fCfgSis('CADLOC', VarBoolean) Then
      objLoadSql.stlJoins.Add(' LEFT JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS AND LOC_CODEMP = LOT_CODEMP ');

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

  Procedure pConsultaAntiga;
  var
    intCont: Integer;
  Begin
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   LOT_NUMLOT , '; pAddNomeColuna('Número do ' + VS_strTitLot);

    If blnArmazem Then
    begin
      strSQL := strSQL + '   AMZ_DESCRI, '; pAddNomeColuna('Descrição do Armazém');

      SetLength(arrOrd, 4);

      arrOrd[0] := 'LOT_NUMLOT';
      arrOrd[1] := 'AMZ_DESCRI';
      arrOrd[2] := 'LOT_DTAFAB';
      arrOrd[3] := 'LOT_DTAVAL';
    end
    else
    begin

      SetLength(arrOrd, 3);

      arrOrd[0] := 'LOT_NUMLOT';
      arrOrd[1] := 'LOT_DTAFAB';
      arrOrd[2] := 'LOT_DTAVAL';
    end;

    strSQL := strSQL + '   LOT_DTAFAB , '; pAddNomeColuna('Fabricação');
    strSQL := strSQL + '   LOT_DTAVAL , '; pAddNomeColuna('Validade');
    strSQL := strSQL + '   LOT_SALBAL , '; pAddNomeColuna('Saldo Balanço');

    objConsulta.pFormataDecimal('LOT_SALBAL', intDecQtd);

    If blnSalRes Then
    Begin
      strSQL := strSQL + '   0.0000 AS LOT_SALDOS, '; pAddNomeColuna('Saldo Atual');
      strSQL := strSQL + '   0.0000 AS SALRES, ';     pAddNomeColuna('Saldo Reservado');
      strSQL := strSQL + '   0.0000 AS SALDIS, ';     pAddNomeColuna('Saldo Disponível');

      objConsulta.pFormataDecimal('SALRES', intDecQtd);
      objConsulta.pFormataDecimal('SALDIS', intDecQtd);
    End
    Else
    Begin
      strSQL := strSQL + '   LOT_SALDOS , '; pAddNomeColuna('Saldo Atual');
      strSQL := strSQL + '   0.0000 AS SALRES, ';     pAddNomeColuna('Saldo Reservado');
      strSQL := strSQL + '   0.0000 AS SALDIS, ';     pAddNomeColuna('Saldo Disponível');

      objConsulta.pFormataDecimal('SALRES', 3);
      objConsulta.pFormataDecimal('SALDIS', 3);
    End;

    If fUsaRotinaWMS Then
    Begin
      strSQL := strSQL + '  LOT_ML_BAL , '; pAddNomeColuna('Saldo Balanço (ML/GR)');
      strSQL := strSQL + '  LOT_SAL_ML , '; pAddNomeColuna('Saldo Atual (ML/GR)');
    End;

    If fCfgSis('MARMOR', varBoolean) Then
    Begin
      If fCfgSis('CTRLCH', varString) = '2' Then
      Begin
        strSQL := strSQL + '  LOT_NCHAPA , '; pAddNomeColuna('Qtd Chapa');
        objConsulta.pIncluiSubConsulta('LOT_NCHAPA', 'LOT_SALDOS / (IFNULL(LOT_MEDL_L, 0) * IFNULL(LOT_MEDL_A, 0))');
      End
      Else
      begin
        strSQL := strSQL + '  LOT_NCHAPA , '; pAddNomeColuna('Chapa');
        strSQL := strSQL + '  LOT_MGLPRI , '; pAddNomeColuna('Lote Principal');
        objConsulta.pIncluiSubConsulta('LOT_MGLPRI', 'CAST(IF(LOT_CHAPA_ = "S", REVERSE(SUBSTRING(REVERSE(LOT_NUMLOT), POSITION("/" IN REVERSE(LOT_NUMLOT)) + 1, LENGTH(LOT_NUMLOT))), "") AS CHAR(30))');
      End;

      strSQL := strSQL + '  LOT_MEDB_L , '; pAddNomeColuna('Medida Bruta - Largura');
      strSQL := strSQL + '  LOT_MEDB_A , '; pAddNomeColuna('Medida Bruta - Altura');
      strSQL := strSQL + '  LOT_MEDL_L , '; pAddNomeColuna('Medida Líquida - Largura');
      strSQL := strSQL + '  LOT_MEDL_A , '; pAddNomeColuna('Medida Líquida - Altura');
      strSQL := strSQL + '  LOT_ESPESS , '; pAddNomeColuna('Espessura');

      If fCfgSis('MARENT', varBoolean) Then
      Begin
        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          Begin
            strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço M² Retira (R$) - ' + IntToStr(intCont));
            objConsulta.pFormataDecimal('LOT_PREVE' + IntToStr(intCont), intDecUni);
          End;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          Begin
            strSQL := strSQL + '  LOT_VENTO' + IntToStr(intCont) + ' , '; pAddNomeColuna('Valor Total M² Retira (R$) - ' + IntToStr(intCont));
            objConsulta.pFormataDecimal('LOT_VENTO' + IntToStr(intCont), intDecUni);
          End;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          Begin
            strSQL := strSQL + '  LOT_PRVEE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço M² Entrega (R$) - ' + IntToStr(intCont));
            objConsulta.pFormataDecimal('LOT_PRVEE' + IntToStr(intCont), intDecUni);
          End;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          Begin
            strSQL := strSQL + '  LOT_VETOE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Valor Total M² Entrega (R$) - ' + IntToStr(intCont));
            objConsulta.pFormataDecimal('LOT_VETOE' + IntToStr(intCont), intDecUni);
          End;
        end;
      End
      Else
      Begin
        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          Begin
            strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço M² (R$) - ' + IntToStr(intCont));
            objConsulta.pFormataDecimal('LOT_PREVE' + IntToStr(intCont), intDecUni);
          End;
        end;

        for intCont := 1 to Length(VS_strTabVen) do
        begin
          if (VS_strTabVen[intCont] = 'S') then
          Begin
            strSQL := strSQL + '  LOT_VENTO' + IntToStr(intCont) + ' , '; pAddNomeColuna('Valor Total M² (R$) - ' + IntToStr(intCont));
            objConsulta.pFormataDecimal('LOT_VENTO' + IntToStr(intCont), intDecUni);
          End;
        end;
      End;

     strSQL := strSQL + '  LOT_CALLIQ , '; pAddNomeColuna('Qtd. M² Líquido');
      objConsulta.pIncluiSubConsulta('LOT_CALLIQ', 'LOT_MEDL_L * LOT_MEDL_A');
    End;

    strSQL := strSQL + '   LOT_PRECUS , '; pAddNomeColuna('Preço de Custo');
    objConsulta.pFormataDecimal('LOT_PRECUS', intDecUni);

    If fCfgSis('MARENT', varBoolean) Then
    Begin
      for intCont := 1 to Length(VS_strTabVen) do
      begin
        if (VS_strTabVen[intCont] = 'S') then
        Begin
          strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço de Venda Retira - ' + IntToStr(intCont));
          objConsulta.pFormataDecimal('LOT_PREVE' + IntToStr(intCont), intDecUni);
        End;
      end;

      for intCont := 1 to Length(VS_strTabVen) do
      begin
        if (VS_strTabVen[intCont] = 'S') then
        Begin
          strSQL := strSQL + '  LOT_PRVEE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço de Venda Entrega - ' + IntToStr(intCont));
          objConsulta.pFormataDecimal('LOT_PRVEE' + IntToStr(intCont), intDecUni);
        End;
      end;
    End
    Else
    Begin
      for intCont := 1 to Length(VS_strTabVen) do
      begin
        if (VS_strTabVen[intCont] = 'S') then
        Begin
          strSQL := strSQL + '  LOT_PREVE' + IntToStr(intCont) + ' , '; pAddNomeColuna('Preço de Venda - ' + IntToStr(intCont));
          objConsulta.pFormataDecimal('LOT_PREVE' + IntToStr(intCont), intDecUni);
        End;
      end;
    End;

    strSQL := strSQL + '   LOT_DTABAL , '; pAddNomeColuna('Data Balanço');
    strSQL := strSQL + '   LOT_LOCFIS , '; pAddNomeColuna('Loc. Física');

    If fCfgSis('CADLOC', VarBoolean) Then
    Begin
      strSQL := strSQL + '   LOC_PICKIN , '; pAddNomeColuna('Picking?');
      objConsulta.pIncluiCampoSimNao('LOC_PICKIN');
      strSQL := strSQL + '   LOC_DESCRI , '; pAddNomeColuna('Descrição Loc. Física');
    End;

    {Com Saldo? Sim/Não}
    strSQL := strSQL + '   COMSALDO,    '; pAddNomeColuna('Com Saldo?');
    objConsulta.pIncluiSubConsulta('COMSALDO', 'IF((IFNULL(LOT_SALDOS, 0) > 0), "SIM", "NÃO")');
    objConsulta.pIncluiCampoSimNao('COMSALDO');

    If blnSalRes Then
    Begin
      strSQL := strSQL + '   LOT_CODEMP , ';
      strSQL := strSQL + '   LOT_CODITE , ';
      strSQL := strSQL + '   LOT_SALDOS AS SALATU, ';
    End
    Else
    Begin
      strSQL := strSQL + '   CAST("" AS CHAR(1)) AS LOT_CODEMP , ';
      strSQL := strSQL + '   CAST("" AS CHAR(1)) AS LOT_CODITE , ';
      strSQL := strSQL + '   0.0 AS SALATU, ';
    End;

    strSQL := strSQL + '   "N" FABANT,  ';
    strSQL := strSQL + '   LOT_CHAPA_,  ';
    strSQL := strSQL + '   L.AUTOINCREM '; // pAddNomeColuna('AUTOINCREM');
    strSQL := strSQL + ' FROM           ';
    strSQL := strSQL + '   CADLOT L     ';
    strSQL := strSQL + ' INNER JOIN CADITE ON ITE_CODITE = LOT_CODITE ';

    If blnArmazem Then
    Begin
      strSQL := strSQL + ' LEFT JOIN CADAMZ ON AMZ_CODAMZ = LOT_NUMLOT AND AMZ_CODEMP = L.LOT_CODEMP ';
      If fCfgSis('CTRAMZ', varBoolean)  Then
      Begin
        strSQL := strSQL + ' INNER JOIN OPEAMZ Z ON Z.OPE_CODOPE = ' + QuotedStr(strLoginUsuarioLogado);
        strSQL := strSQL + '                    AND Z.OPE_CODAMZ = CADAMZ.AUTOINCREM ';
      End;
    End;

    If fCfgSis('CADLOC', VarBoolean) Then
      strSQL := strSQL + ' LEFT JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS AND LOC_CODEMP = LOT_CODEMP ';


    arrSQLConsulta    := [strSQL, fSQLWhere(True)];
    arrCamposConsulta := arrTitCol;
  End;
begin
  Result := False;
  intDecQtd := Max(4, fCfgSis('DECQTD', varInteger));

  If fEntraCons(chrKey) Then
  Begin
    Try
      objConsulta := TDefConsultaLotFat.Create(arrLotesAdd);
      objConsulta.pAdicionaTabela('CADLOT', 'L');
      objConsulta.strEspDoc        := strEspDoc;
      objConsulta.fltValorUnitario := fltValorUnitario;
      objConsulta.strTabPre        := strTabPre;
      objConsulta.strEntRet        := strEntRet;
      strTitulo := 'Consulta de ' + VS_strTitLts + '.';

      chrKey := #0;

      blnArmazem := (fCfgSis('CTLEST') = '2');

      blnSalRes := (fCfgSis('USAPDV', varBoolean, VS_strCodEmp)) Or
                   (fCfgSis('GARANT', varBoolean, VS_strCodEmp));

      objConsulta.pFormataDecimal('LOT_SALDOS', intDecQtd);

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   arrOrd,
                   '',
                   'CADLOT',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'LOT_NUMLOT',
                   objConsulta,
                   False,
                   False,
                   '',
                   pAtualizaSaldoLote,
                   True,
                   True,
                   True,
                   Nil,
                   Nil,
                   Nil
                   {VS_Application}) Then
      Begin
        If Assigned(edtNumLote) then
        Begin
          If (edtNumLote Is TEditFocus) Then
            (edtNumLote As TEditFocus).Text := qryConsulta.FieldByName('LOT_NUMLOT').AsString
          Else
            edtNumLote.Text := qryConsulta.FieldByName('LOT_NUMLOT').AsString;
        End;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtNumLote) then
          Begin
            If (edtNumLote Is TEditFocus) Then
              (edtNumLote As TEditFocus).Text := fStrZero('0', 3)
            Else
              edtNumLote.Text := fStrZero('0', 3);
          End;

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

      FreeAndNil(objConsulta);
      FreeAndNil(objLoadSQL);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

End;

