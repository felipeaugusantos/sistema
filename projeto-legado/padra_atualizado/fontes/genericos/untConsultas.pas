function fSQLNomCam: string;
begin
  Result := '';
  Result := Result + '  CASE WHEN A.ALT_NUMCAM = "03" THEN "NOME" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "04" THEN "CÓD PAÍS" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "05" THEN "CNPJ" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "06" THEN "CPF" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "07" THEN "INSC. ESTADUAL" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "08" THEN "CÓD MUNICÍPIO" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "09" THEN "SUFRAMA" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "10" THEN "ENDEREÇO" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "11" THEN "NÚMERO ENDEREÇO" ';
  Result := Result + '       WHEN A.ALT_NUMCAM = "12" THEN "COMPLEMENTO ENDEREÇO" ';
  Result := Result + '   ELSE "BAIRRO" END ';
end;

function fPesqMovFlex(Self     : TForm;                       {* Formulário                                  *}
                      edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                      qryTabela: TUniQuery;                   {* Query                                       *}
                      Var chrKey: Char;                       {* Key                                         *}
                      Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                      blnConSim: Boolean = True;              {* Consulta Simples ou Múltipla (multi select) *}
                      intOpc: Integer = 3): Boolean;          {* Tipo - 0 = Todos 1 = Baixados 3 = Abertos   *}
  Var
    strSQL : String;
    qryConsulta: TUniQuery;
    objConsulta : TDefConsulta;
    arrTitCol: TColunasArray;                                 {* Títulos das Colunas                         *}

  procedure pAddCol(strTit: String);
  begin
    SetLength(arrTitCol, Length(arrTitCol) + 1);
    arrTitCol[Length(arrTitCol) - 1] := strTit;
  end;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If (intOpc In [1,2]) And (Not fEmptyStr(strWhere)) Then
    Begin
      strWhere := strWhere + ' AND ';
    End;

    Case intOpc Of
      1: strWhere := strWhere + ' FLE_CREDEB = "C"';
      2: strWhere := strWhere + ' FLE_CREDEB = "D"';
      3: strWhere := strWhere + '';
    End;

    Result := strWhere;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  F.FLE_CODSEQ, '; pAddCol('Código');
      strSQL := strSQL + '  F.FLE_DTALAN, '; pAddCol('Data Lançamento');
      strSQL := strSQL + '  V.OPE_CODOPE, '; pAddCol('Cod. Vendedor');
      strSQL := strSQL + '  V.OPE_NOMOPE, '; pAddCol('Vendedor');
      strSQL := strSQL + '  F.FLE_NUMDOC, '; pAddCol('Documento');
      strSQL := strSQL + '  F.FLE_ESPDOC, '; pAddCol('Espécie');
      strSQL := strSQL + '  F.FLE_CODEMP, '; pAddCol('Empresa');
      strSQL := strSQL + '  C.CLI_CODCLI, '; pAddCol('Cod. Cliente');
      strSQL := strSQL + '  C.CLI_NOMCLI, '; pAddCol('Cliente');
      strSQL := strSQL + '  I.ITE_CODITE, '; pAddCol('Cod. Produto');
      strSQL := strSQL + '  I.ITE_DESITE, '; pAddCol('Produto');
      strSQL := strSQL + '  FLEHISTOR,    '; pAddCol('Histórico');
      strSQL := strSQL + '  F.FLE_CREDEB, '; pAddCol('Cré./Déb.');
      strSQL := strSQL + '  F.FLE_VALLAN, '; pAddCol('Valor');
      strSQL := strSQL + '  F.AUTOINCREM  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  MOVFLE F ';
      strSQL := strSQL + '  LEFT JOIN CADOPE V ON V.OPE_CODOPE = F.FLE_CODVEN ';
      strSQL := strSQL + '  LEFT JOIN CADCLI C ON C.CLI_CODCLI = F.FLE_CODCLI ';
      strSQL := strSQL + '  LEFT JOIN CADITE I ON I.ITE_CODITE = F.FLE_CODITE ';

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('FLEHISTOR', 'CAST(IFNULL(REPLACE(F.FLE_HISTOR, "<<csq>>", " "), " ") AS CHAR(255))');

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrTitCol,
                   ['FLE_CODSEQ'],
                   '',
                   'MOVFLE',
                   Self.Name,
                   'Consulta de Conta Corrente FLEX',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'FLE_CODSEQ',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
