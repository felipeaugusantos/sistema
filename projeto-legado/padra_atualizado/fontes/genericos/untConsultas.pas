function TDefConsultaLotFat.fGetCellStyle(AView: TcxGridDBTableView;
  ARecord: TcxCustomGridRecord; AItem: TcxCustomGridTableItem;
  ADataSet: TDataSet): TcxStyle;
var
  ARowInfo: TcxRowInfo;
  strChapa: String;
  blnLotAdd: Boolean;
  strCampo: String;

  function fIdxColumn(strCampo: String): Integer;
  begin
    Result := -1;

    If ADataSet.FindField(strCampo) <> nil Then
      Result := fGetIndexColumnByFieldName(AView, strCampo);
  end;

  function fGetValor(ColumnIndex: Integer): Variant;
  begin
    Result := Null;
    ARowInfo := AView.DataController.GetRowInfo(ARecord.Index);

    With AView, DataController Do
      If ColumnIndex > -1 Then
      Begin
        Result := Values[ARowInfo.RecordIndex, ColumnIndex];
      End;
  end;
begin
  Result := nil;

  If (fCfgSis('MARMOR', varBoolean)) And (fCfgSis('CTRLCH', varBoolean)) And
     (ARecord.IsData And (ARecord.Index > -1)) Then
  Begin
    strChapa  := IfNull(fGetValor(fIdxColumn('LOT_CHAPA_')), 'N');
    blnLotAdd := False;

    if Assigned(arrLotesAdd) and (Length(arrLotesAdd) > 0) then
      blnLotAdd := MatchStr(IfNull(fGetValor(fIdxColumn('LOT_NUMLOT')), ''), arrLotesAdd);

    If ((IfNull(fGetValor(fIdxColumn('SALRES')), 0) > 0) or blnLotAdd) and (strChapa = 'S') Then
    Begin
      cxsStyle.TextColor := clRed;
      Result := cxsStyle;
    End;
  End;

  If (Pos(FEspDoc, 'PD_OR_VN_') > 0) And
     (ARecord.IsData And (ARecord.Index > -1)) Then
  Begin
    If fCfgSis('MARENT', varBoolean) And (FEntRet = 'E') Then
      strCampo := 'LOT_PRVEE' + FTabPre
    Else
      strCampo := 'LOT_PREVE' + FTabPre;

    If (IfNull(fGetValor(fIdxColumn(strCampo)), 0) < FValorUnitario) And
       (IfNull(fGetValor(fIdxColumn(strCampo)), 0) > 0) Then
    Begin
      cxsStyle.TextColor := clGreen;
      Result := cxsStyle;
    End;
  End;
end;

procedure TDefConsultaLotFat.SetEspDoc(const Value: String);
begin
  FEspDoc := Value;
end;

procedure TDefConsultaLotFat.SetEntRet(const Value: String);
begin
  If Value = '' Then
    FEntRet := 'R'
  Else
    FEntRet := Value;
end;

procedure TDefConsultaLotFat.SetTabPre(const Value: String);
begin
  If Pos(Value, '1234567') = 0 Then
    FTabPre := '1'
  Else
    FTabPre := Value;
end;

procedure TDefConsultaLotFat.SetValorUnitario(const Value: Double);
begin
  FValorUnitario := Value;
end;

function fPesqGrupoServicos(Self     : TForm;                              {* Formulário                                  *}
                              edtCodigo: TCustomEdit;                      {* Edit do Código                              *}
                              edtDescri: TEditFocus;                       {* Edit da Descrição                           *}
                              qryTabela: TUniQuery;                        {* Query                                       *}
                              Var chrKey: Char;                            {* Key                                         *}
                              Var arrSel: TConsultasArray;                 {* Array de Seleção                            *}
                              blnConSim: Boolean = True): Boolean;         {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE   ';
      strSQL := strSQL + '  GRUSER.GRU_CODGRU,  ';
      strSQL := strSQL + '  GRUSER.GRU_DESGRU,  ';
      strSQL := strSQL + '  GRUSER.GRU_CODEMP,  ';
      strSQL := strSQL + '  GRUSER.AUTOINCREM   ';
      strSQL := strSQL + 'FROM                  ';
      strSQL := strSQL + '  GRUSER              ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL],
                  ['Código',
                   'Descrição',
                   'Empresa'],
                   ['GRU_DESGRU', 'GRU_CODGRU', 'GRU_CODEMP'],
                   '',
                   'GRUSER',
                   Self.Name,
                   'Consulta de Grupos de Serviços',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'GRU_CODGRU') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('GRU_CODGRU').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('GRU_CODGRU').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('GRU_DESGRU').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', Length(qryConsulta.FieldByName('GRU_CODGRU').AsString))
            Else
              edtCodigo.Text := fStrZero('0', Length(qryConsulta.FieldByName('GRU_CODGRU').AsString));
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqCest(Self: TForm;                            {* Formulario                                  *}
                   edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                   edtDescri: TEditFocus;                  {* Edit da Descrição                           *}
                   qryTabela: TUniQuery;                   {* Query                                       *}
