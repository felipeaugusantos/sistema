                   'AUTOINCREM',
                   'AGEVIS',
                   Self.Name,
                   'Consulta de Agendamento de Visitas',
                   qryConsulta,
                   Nil,
                   True,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False)) Then
      Begin
        strNumLote := qryConsulta.FieldByName('AGE_CODLOT').AsString;
        strAutoIncrem := qryConsulta.FieldByName('AUTOINCREM').AsString;

