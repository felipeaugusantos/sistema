function fPesqPedidoCompraNFImportVincItem(Self : TForm;
                                           var strNumPed: String;
                                           strCodIte: string;
                                           strCodFor: string): Boolean;  {* Consulta Simples ou Múltipla (multi select) *}
var
  strSQL   : String;
  qryConsulta: TUniQuery;
  arrSel: TConsultasArray;

  function fSQLWhere(blnCompleto: Boolean): String;
  var
    strWhere: String;
  begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND PCMGER.PCG_BAIXAD = "0" ';
    strWhere := strWhere + ' AND PCMGER.PCG_PEDIMP = "S" ';
    strWhere := strWhere + ' AND PCMGER.PCG_CODFOR = ' + fQuotedStr(strCodFor);
    strWhere := strWhere + ' AND PCMDET.PCD_CODITE = ' + fQuotedStr(strCodIte);

    Result := strWhere;
  end;
begin
  Result := False;
  //If fEntraCons(chrKey) Then
  Begin
    Try
      //chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  PCG_NUMPED , ';
      strSQL := strSQL + '  PCG_NUMCTN , ';
      strSQL := strSQL + '  FOR_CODFOR , ';
      strSQL := strSQL + '  FOR_NOMFOR , ';
      strSQL := strSQL + '  PCG_DTAPED , ';
      strSQL := strSQL + '  PCG_CONPAG , ';
      strSQL := strSQL + '  PCMGER.AUTOINCREM ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  PCMGER ';
      strSQL := strSQL + '  INNER JOIN CADFOR ON PCG_CODFOR = FOR_CODFOR ';
      strSQL := strSQL + '  INNER JOIN PCMDET ON PCG_NUMPED = PCD_NUMPED ';
      strSQL := strSQL + '    AND PCG_ESPDOC = PCD_ESPDOC AND PCG_CODEMP = PCD_CODEMP ';

      qryConsulta := fCriaQuery(Nil);

      try
        If fConsultaConfig([strSQL, fSQLWhere(True)],
                    ['Pedido',
                     'Container',
                     'Cód.Forne.',
                     'Fornecedor',
                     'Data Pedido',
                     'Cond. Pgto.',
                     'AUTOINCREM'],
                     ['PCG_NUMPED'{,'FOR_NOMFOR','FOR_CODFOR'}],
                     '',
                     'PCMGER',
                     Self.Name,
                     'Consulta Pedido de Compra',
                     qryConsulta,
                     Nil,
                     True,
                     arrSel,
                     'AUTOINCREM',
                     fSQLWhere(False)) Then
        Begin
          Result := True;
          strNumPed := qryConsulta.FieldByName('PCG_NUMPED').AsString;
        End;
      finally
        FreeAndNil(qryConsulta);
      end;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  end;
end;


