function fPesqOrdProIndustrial(Self     : TForm;                            {* Formulário                                  *}
                               edtCodigo: TCustomEdit;                      {* Edit do Código                              *}
                               edtDescri: TCustomEdit;                      {* Edit da Descrição                           *}
                               qryTabela: TUniQuery;                        {* Query                                       *}
                               Var chrKey: Char;                            {* Key                                         *}
                               Var arrSel: TConsultasArray;                 {* Array de Seleção                            *}
                               tpcPsqOPI: TPesquisaOPI;
                               blnConSim: Boolean = True;
                               staState: TStateOPI = staTodas;              {* Consulta Simples ou Múltipla (multi select) *}
                               strCodIte: String = '';
                               strCodCor: String = '';
                               strComponenteA: String = '';
                               strComponenteB: String = '';
                               strCodigoItem: String = '';
                               blnConsultaEditor: Boolean = False;
                               objFrmPnl: TPanelCx = Nil):Boolean;
  Var
    strSQL, strGroup, strTitulo : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefMascaraOPIndustrial;
    arrTitCol,                                                              {* Títulos das Colunas                         *}
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  procedure pAddCol(strTit: String);
  begin
    SetLength(arrTitCol, Length(arrTitCol) + 1);
    arrTitCol[Length(arrTitCol) - 1] := strTit;
  end;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND ORD_CODEMP = ' + QuotedStr(VS_strCodEmp);

    if not fEmptyStr(strCodIte) Then
      strWhere := strWhere + ' AND O.ORD_CODITE = ' + QuotedStr(strCodIte);

    if not fEmptyStr(strCodCor) Then
      strWhere := strWhere + ' AND ORD_CODCOR = ' + QuotedStr(strCodCor);

    If strComponenteA = 'S' Then
    Begin
      strWhere := strWhere + '  AND G.ITE_COMPNB = "S" ';
      strWhere := strWhere + '  AND G.ITE_CODITE = "'+strCodigoItem+'" ';
    End;

    If strComponenteB = 'S' Then
    Begin
      strWhere := strWhere + '  AND G.ITE_COMPNA = "S" ';
      strWhere := strWhere + '  AND G.ITE_CODITB = "'+strCodigoItem+'" ';
    End;

    Case staState Of
      staAbertas : strWhere := strWhere + ' AND ORD_DTABAI IS NULL ';

      staBaixadas: Begin
                     strWhere := strWhere + ' AND ORD_DTABAI IS NOT NULL ';
                   End;
      Else
        Case fMensagem('','Selecione o status:', ['Abertos', 'Bx. com prd.', 'Bx. não prd.','Todos'],1) Of
          1: strWhere := strWhere + ' AND ORD_DTABAI IS NULL ';
          2: strWhere := strWhere + ' AND ORD_DTABAI IS NOT NULL AND IFNULL(ORD_BAINPD,"N") = "N" ';
          3: strWhere := strWhere + ' AND ORD_DTABAI IS NOT NULL AND ORD_BAINPD = "S"';
        End;
    End;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    If fCfgSis('ARMAMO', varBoolean) Then
    Begin
      objLoadSql.fIncluiSubConsulta('ORDLOCORP', 'ORD_LOCORP', 'Loc. Fis. Amostra');
      objLoadSql.fIncluiSubConsulta('LOPDESCRI', 'LOP_DESCRI', 'Descrição Loc. Fis. Amostra');
      objLoadSql.stlJoins.Add(' LEFT JOIN LOCORP  ON LOP_LOCFIS = ORD_LOCORP ');
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    SetLength(arrTitCol, 0);
    strSQL := strSQL + ' SELECT ORD_NUMLOT,                                        '; pAddCol('Número do Lote');
    strSQL := strSQL + ' MAX(ORD_CODORD) AS ORD_CODORD,                            '; pAddCol('Código da OP');
    strSQL := strSQL + ' MAX(ORD_DTACAD) AS ORD_DTACAD,                            '; pAddCol('Data de Cadastro');
    strSQL := strSQL + ' MAX(O.ORD_CODITE) AS ORD_CODITE,                          '; pAddCol('Cód.Item');
    strSQL := strSQL + ' MAX(G.ITE_DESITE) AS ITE_DESITE,                          '; pAddCol('Descrição do Item');
    strSQL := strSQL + ' MAX(ORD_CODCOR) AS ORD_CODCOR,                            '; pAddCol('Cód.Cor');
    strSQL := strSQL + ' MAX(COR_DESCOR) AS COR_DESCOR,                            '; pAddCol('Descrição da Cor');
    strSQL := strSQL + ' IF(IFNULL(ORD_DTABAI,0) = 0, "NÃO", "SIM") AS ORD_BAIXAD, '; pAddCol('Baixada');
    strSQL := strSQL + ' MAX(ORD_DTABAI) AS ORD_DTABAI,                            '; pAddCol('Data da Baixa');
    strSQL := strSQL + ' MAX(G.ITE_REFERE) AS ITE_REFERE,                          '; pAddCol('Referência');
    objConsulta.pIncluiCampoProcessado('ITE_REFERE');
    strSQL := strSQL + ' SUM(IF(UNI_KILLIT="K", IF(GMT_PESREA > 0, ((ORD_QTDPRO * UNI_PESLIT) / GMT_PESREA),0), ORD_QTDPRO * UNI_PESLIT )) AS VOLUME, '; pAddCol('Volume');
    strSQL := strSQL + ' SUM(IF(UNI_KILLIT="K", ORD_QTDPRO * UNI_PESLIT, ORD_QTDPRO * UNI_PESLIT * GMT_PESREA )) AS   PESTOT,                         '; pAddCol('Peso Total');
    strSQL := strSQL + ' ORD_PEDIDO,         '; pAddCol('Pedido de Venda');

    objConsulta.pIncluiSubConsulta('ORD_PEDIDO',  '(SELECT GROUP_CONCAT(FDO_NUMDOC SEPARATOR " - ") ' +
                                                  '  FROM EXTDOR ' +
                                                  '   LEFT JOIN FATDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO ' +
                                                  '  WHERE FDO_SEQOPI = O.AUTOINCREM ) ');

    strSQL := strSQL + ' NUMRES,         '; pAddCol('Pedido da Reserva Matéria Prima');
    objConsulta.pIncluiSubConsulta('NUMRES',  'CONCAT(FATGOR.FGO_NUMDOC, "-", FATGOR.FGO_ESPDOC, "-", FATGOR.FGO_CODEMP) ');

    If fCfgSis('ARMAMO', varBoolean) Then
    Begin
      strSQL := strSQL + ' ORD_LOCORP,  '; pAddCol('Loc. Fis. Amostra');
      strSQL := strSQL + ' LOP_DESCRI,  '; pAddCol('Descrição Loc. Fis. Amostra');
    End;
    strSQL := strSQL + ' ORD_DTAPRE,                                               ';    pAddCol('Data de Previsão');
    strSQL := strSQL + ' O.AUTOINCREM,                                          ';
    strSQL := strSQl + ' O.ORD_OBSEXT,                                          ';
    strSQL := strSQL + ' ORD_TOTPRO                                             ';

    objConsulta.pIncluiSubConsulta('ORD_TOTPRO',  '(SUM(ORDDET.ORD_QTDPRO))');
    strSQL := strSQL + 'FROM ORDGER O                                           ';
    strSQL := strSQL + 'INNER JOIN ORDDET ON ORD_SEQGER = O.AUTOINCREM          ';
    strSQL := strSQL + 'INNER JOIN CADITE G ON O.ORD_CODITE = G.ITE_CODITE      ';
    strSQL := strSQL + 'INNER JOIN CADITE D ON D.ITE_CODITE = ORDDET.ORD_CODITE ';
    strSQL := strSQL + 'LEFT  JOIN CADUNI ON UNI_CODUNI = D.ITE_CODUNI          ';
    strSQL := strSQL + 'INNER JOIN CADCOR ON ORD_CODCOR = COR_CODCOR            ';
    strSQL := strSQL + 'LEFT  JOIN GEIMAT ON GMT_CODITE = O.ORD_CODITE          ';
    strSQL := strSQL + '                 AND GMT_CODCOR = ORD_CODCOR            ';
    strSQL := strSQL + '                 AND GMT_FORMUL = ORD_FORMUL            ';

    strSQL := strSQL + ' LEFT JOIN EXTGOR ON EXTGOR.FGO_ORDIND = O.AUTOINCREM      ';
    strSQL := strSQL + ' LEFT JOIN FATGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';

    If fCfgSis('ARMAMO', varBoolean) Then
      strSQL := strSQL + 'LEFT JOIN LOCORP  ON LOP_LOCFIS = ORD_LOCORP          ';

    strGroup := strGroup + ' GROUP BY O.AUTOINCREM ';

    arrSQLConsulta    := [strSQL, fSQLWhere(True), strGroup];
    arrCamposConsulta := arrTitCol;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;
      strTitulo := 'Consulta de Ordens de Produção';
      objConsulta := TDefMascaraOPIndustrial.Create;
      objConsulta.pAdicionaTabela('ORDGER', 'O');
      objConsulta.pAdicionaTabela('ORDDET', '');
      objConsulta.pAdicionaTabela('CADITE', 'G');
      objConsulta.pAdicionaTabela('CADITE', 'D');
      objConsulta.pAdicionaTabela('CADUNI', '');
      objConsulta.pAdicionaTabela('CADCOR', '');
      objConsulta.pAdicionaTabela('GEIMAT', '');
      objConsulta.pAdicionaTabela('EXTGOR', '');
      objConsulta.pAdicionaTabela('FATGOR', '');
      objConsulta.pIncluiCampoSimNao('ORD_BAIXAD');
      objConsulta.pIncluiConflito('ORD_CODITE', 'O.ORD_CODITE');
      objConsulta.pIncluiConflito('ITE_DESITE', 'G.ITE_DESITE');
      objConsulta.pIncluiSubConsulta('ORD_NUMLOT', 'CONCAT(DATE_FORMAT(ORD_DTACAD,"%d%m%y"), ORD_CODORD)');



      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['ITE_DESITE','ORD_NUMLOT','O.ORD_CODITE','ORD_CODORD'],
                   '',
                   'ORDGER',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   IIF(not blnConsultaEditor, 'AUTOINCREM', 'ORD_CODORD'),
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If tpcPsqOPI = poiCodigo Then
          Begin

            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('ORD_CODORD').AsString
            Else
              edtCodigo.Text := qryConsulta.FieldByName('ORD_CODORD').AsString;

            If (edtDescri Is TMaskEditFocus) Then
              (edtDescri As TMaskEditFocus).Text := qryConsulta.FieldByName('ORD_DTACAD').AsString
            Else
              edtDescri.Text := qryConsulta.FieldByName('ORD_DTACAD').AsString;

          End Else
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text :=
                FormatDateTime('DDMMYY', qryConsulta.FieldByName('ORD_DTACAD').AsDateTime) +
                qryConsulta.FieldByName('ORD_CODORD').AsString
            Else
              edtCodigo.Text := FormatDateTime('DDMMYY', qryConsulta.FieldByName('ORD_DTACAD').AsDateTime) +
                                qryConsulta.FieldByName('ORD_CODORD').AsString;

            If Assigned(edtDescri) Then
              edtDescri.Text := qryConsulta.FieldByName('ORD_CODITE').AsString + '-' +
                                fRetNomProduto(qryConsulta.FieldByName('ORD_CODITE').AsString);
          End;
        End;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 9)
            Else
              edtCodigo.Text := fStrZero('0', 9);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

        FreeAndNil(objConsulta);

      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqGrupoProduto(Self         : TForm;                            {* Formulário                                  *}
                           edtCodigo    : TCustomEdit;                      {* Edit do Código                              *}
                           edtDescricao : TEditFocus;                       {* Edit da Descrição                           *}
                           qryTabela    : TUniQuery;                        {* Query                                       *}
                           Var chrKey   : Char;                             {* Key                                         *}
                           Var arrSel   : TConsultasArray;                  {* Array de Seleção                            *}
                           blnConSim    : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                           strCodFor    : String = ''): Boolean;
  Var
    strSQL,
    strWhere: String;
    qryConsulta: TUniQuery;
    blnTabPrd: Boolean;
    arrCampos: TColunasArray;
Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin
    Try
      blnTabPrd := fCfgSis('TABPRD', varBoolean);

      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  PRD_CODGRU,       ';
      strSQL := strSQL + '  PRD_DESGRU,       ';

      If blnTabPrd Then
      Begin
        strSQL := strSQL + '  PRD_CODFOR,     ';
        strSQL := strSQL + '  FOR_NOMFOR,     ';
      End;

      strSQL := strSQL + '  G.AUTOINCREM      ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  GRPPRD G          ';

      strWhere := '';

      If blnTabPrd Then
      Begin
        strSQL := strSQL + 'LEFT JOIN CADFOR ON FOR_CODFOR = PRD_CODFOR ';

        If Not fEmptyStr(strCodFor) Then
        Begin
          strWhere := strWhere + ' WHERE            ';
          strWhere := strWhere + '   PRD_CODFOR = ' + QuotedStr(strCodFor);
        End;

        arrCampos := ['Código', 'Descrição',
                      'Fornecedor',
                      'Nome do Fornecedor'];

      End Else
      Begin
        arrCampos := ['Código', 'Descrição'];
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, strWhere],
                         arrCampos,
                         ['PRD_DESGRU', 'PRD_CODGRU'],
                         'PRD_CODGRU',
                         'GRPPRD',
                         Self.Name,
                         'Consulta de Grupo de Produtos',
                         qryConsulta,
                         Nil,
                         blnConSim,
                         arrSel,
                         'PRD_CODGRU') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('PRD_CODGRU').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('PRD_CODGRU').AsString;
        End;

        If Assigned(edtDescricao) Then
          edtDescricao.Text := qryConsulta.FieldByName('PRD_DESGRU').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 5)
            Else
              edtCodigo.Text := fStrZero('0', 5);
          End;

          If Assigned(edtDescricao) Then
            edtDescricao.Text := '+1'
          Else
            edtCodigo.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
End;

