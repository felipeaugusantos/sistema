function fPesqNegociacaoOS(Self      : TForm;                            {* Formulário                                  *}
                           qryTabela : TUniQuery;                        {* Query                                       *}
                           Var chrKey: Char;                             {* Key                                         *}
                           Var arrSel: TConsultasArray) : Boolean;       {* Array de Seleção                            *}
var
  strSQL,
  strWhere: String;
  qryConsulta: TUniQuery;
  arrTitCol,
  arrCamKey  : TColunasArray; {* Títulos das Colunas  *}
  objConsulta: TDefConsulta;

  procedure pAddNomeColuna(strNomCol: String);
  begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  end;

  procedure pAddCamposKey(strNomCol: String);
  begin
    SetLength(arrCamKey, Succ(Length(arrCamKey)));
    arrCamKey[High(arrCamKey)] := strNomCol;
  end;
begin
  Result := False;
  strWhere := ' WHERE TRUE ';

  if fEntraCons(chrKey) then
  begin
    try
      objConsulta := TDefConsulta.Create;
      SetLength(arrTitCol, 0);
      SetLength(arrCamKey, 0);

      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT  ';

      strSQL := strSQL + '    NEGOSE.NEG_NRONEG, '; pAddNomeColuna('Nro. Negociação');
      strSQL := strSQL + '    NEGOSE.NEG_CODEMP, '; pAddNomeColuna('Emp. Negociação');
      strSQL := strSQL + '    CADCLI.CLI_CODCLI, '; pAddNomeColuna('Cód. Cliente');
      strSQL := strSQL + '    CADCLI.CLI_NOMCLI, '; pAddNomeColuna('Nome Cliente');
      strSQL := strSQL + '    CASE NEGOSE.NEG_STATUS WHEN "A" THEN "Em Aberto" ELSE "Finalizada" END NEG_STATUS, '; pAddNomeColuna('Status');
      strSQL := strSQL + '    NEGOSE.NEG_DTACAD, '; pAddNomeColuna('Data Cadastro');
      strSQL := strSQL + '    CADOPE.OPE_CODOPE, '; pAddNomeColuna('Cód. Operador');
      strSQL := strSQL + '    CADOPE.OPE_NOMOPE, '; pAddNomeColuna('Nome Operador');
      strSQL := strSQL + '    NEGOSE.NEG_TOTNEG, '; pAddNomeColuna('Total Negociação');
      strSQL := strSQL + '    EQU_NUMOSE, '       ; pAddNomeColuna('Ordem de Serviço');
      strSQL := strSQL + '    EQU_CODEMP, '       ; pAddNomeColuna('Emp. O.S');
      objConsulta.pFormataDecimal('NEG_TOTNEG', 2);
      strSQL := strSQL + '    NEGOSE.AUTOINCREM  ';

      pAddCamposKey('NEG_NRONEG');

      strSQL := strSQL + ' FROM NEGOSE ';
      strSQL := strSQL + ' INNER JOIN CADOPE ON NEGOSE.NEG_CODOPE = CADOPE.OPE_CODOPE ';
      strSQL := strSQL + ' INNER JOIN CADCLI ON NEGOSE.NEG_CODCLI = CADCLI.CLI_CODCLI ';
      strSQL := strSQL + ' INNER JOIN NEGEQU ON NEGOSE.AUTOINCREM = NEGEQU.NEG_SEQNEG ';
      strSQL := strSQL + ' INNER JOIN EQUGER ON NEGEQU.NEG_SEQGER = EQUGER.AUTOINCREM ';

      if (not fCfgSis('MAOSEM', varBoolean)) then
        strWhere := strWhere + ' AND NEG_CODEMP = ' + QuotedStr(VS_strCodEmp) + '  ';

      if not Assigned(qryTabela) then
        qryConsulta := fCriaQuery(Nil)
      else
        qryConsulta := qryTabela;

      if fConsulta([strSQL, strWhere],
                   arrTitCol,
                   arrCamKey,
                   'AUTOINCREM',
                   'NEGOSE',
                   Self.Name,
                   'Consulta de Negociações Globais de Ordem de Serviço',
                   qryConsulta,
                   Nil,
                   True,
                   arrSel,
                   'AUTOINCREM',
                   objConsulta) then
      begin
        Result := True;

        if not Assigned(qryTabela) then
          FreeAndNil(qryConsulta);
      End;

      FreeAndNil(objConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
End;


