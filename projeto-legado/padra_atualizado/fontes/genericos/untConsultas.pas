      strSQL := strSQL + '  AJU_VALAJU, '; pAddNomeColuna('Valor Ajuste');
      strSQL := strSQL + '  AJU_CODEMP, '; pAddNomeColuna('Cód. Empresa');
      strSQL := strSQL + '  AJU_OBSERV, '; pAddNomeColuna('Observação');
      strSQL := strSQL + '  SUBSTRING(AJU_NUMNOT, 1, 12) AS AJU_NUMNOT, '; pAddNomeColuna('Nota Fiscal');
      strSQL := strSQL + '  AJ.AUTOINCREM, ';
      strSQL := strSQL + '  CF.AUTOINCREM AS AUTOCADFIS ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  AJUICM AJ ';
      strSQL := strSQL + '  LEFT JOIN CADFIS CF ON AJ.AUTOINCREM = CF.AUTOINCREM ';

