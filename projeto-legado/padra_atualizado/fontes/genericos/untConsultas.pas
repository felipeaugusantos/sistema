{******************************}
{* CONSULTA DE LOTES DE PREÇO *}
{***************************JU*}
function fPesqLotePre(Self      : TForm;                                    {* Formulário                                  *}
                      qryLotPre : TUniQuery;                                {* Query                                       *}
                      Var chrKey: Char;                                     {* Key                                         *}
                      Var arrSel: TConsultasArray;                          {* Array de Consulta                           *}
                      blnConSim : Boolean = True;                           {* Consulta Simples ou Múltipla (multi select) *}
                      strTitulo : String  = 'Consulta de Lotes de Preço';
                      objFrmPnl : TPanelCx = Nil): Boolean;                 {* Painel                                      *}
  Var
    arrTitCol,                                                              {* Títulos das Colunas                         *}
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    strSQL     : String;
    strGroup   : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsultaLotePreco;
    objLoadSql: TLoadConsultaSQL;
    blnEtrAut : Boolean;
  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If fExigeConferenciaQuandoConfiguradoConferenciaDepoisEntrada Then
      strWhere := strWhere  + ' AND	DET_DTAENT IS NOT NULL ';

    strWhere := strWhere  + ' AND	LTP_BAIXAD = "N" ';

    If Not (fCfgSis('EMPGER', varBoolean) And fCfgSis('LOTGER', varBoolean)) Then
      strWhere := strWhere  + ' 	AND LTP_CODEMP = "' + VS_strCodEmp + '" ';

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    If fConferenciaDepoisDaEntrada Then
    Begin
      objLoadSQL.fIncluiSubConsulta('SIT_PRENOTA','IF(GER_DOCENT IS NULL, "SEM PRÉ-NOTA", IF(GER_DTACON IS NULL, "CONFERÊNCIA PENDENTE", "CONFERIDA"))', 'Situação Pré-Nota');
      objLoadSql.stlJoins.Add('   LEFT JOIN GERELE ON GER_DOCENT = DET_NUMDOC AND '+
                              '                       GER_ESPENT = DET_ESPDOC AND '+
                              '                       GER_EMPENT = DET_CODEMP AND '+
                              '                       B07_SERIE  = DET_SERIE_ AND '+
                              '                       GER_CODFOR = DET_CODFOR     ');
    End;

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    objConsulta.pIncluiSubConsulta('QUANTIDADE', 'COUNT(*)');

    objConsulta.stlCamposComplementares.Add('QTDORI');

    If fConferenciaDepoisDaEntrada Then
    Begin
      If blnEtrAut Then
        objConsulta.pIncluiSubConsulta('SIT_PRENOTA', 'IF(GER_DOCENT IS NULL, "SEM PRÉ-NOTA", IF(((GER_DTACON IS NULL) AND (ENTDES.ENT_SEQENT IS NULL)), "CONFERÊNCIA PENDENTE", "CONFERIDA"))')
      Else
        objConsulta.pIncluiSubConsulta('SIT_PRENOTA', 'IF(GER_DOCENT IS NULL, "SEM PRÉ-NOTA", IF(GER_DTACON IS NULL, "CONFERÊNCIA PENDENTE", "CONFERIDA"))');
    End;


    strSql := '';
    strSql := strSql  + ' SELECT SQL_NO_CACHE ';
    strSql := strSql  + '   DET_DTAENT, ';     pAddNomeColuna('Data de Entrada');
    strSql := strSql  + '   DET_NUMDOC, ';     pAddNomeColuna('Documento');
    strSql := strSql  + '   DET_ESPDOC, ';     pAddNomeColuna('Espécie');
    strSql := strSql  + '   DET_SERIE_, ';     pAddNomeColuna('Série');
    strSql := strSql  + '   DET_CODEMP, ';     pAddNomeColuna('Emp.');
    strSql := strSql  + '   DET_CODFOR, ';     pAddNomeColuna('Cód.Forn.');
    strSql := strSql  + '   FOR_NOMFOR, ';     pAddNomeColuna('Fornecedor');
    strSql := strSql  + '   LTP_OPERES, ';     pAddNomeColuna('Cód.Resp.');
    strSql := strSql  + '   OPE_NOMOPE, ';     pAddNomeColuna('Responsável');
    strSql := strSql  + '   QUANTIDADE, ';     pAddNomeColuna('Qtd.Itens');

    If fConferenciaDepoisDaEntrada Then
    Begin
        strSql := strSql  + '   SIT_PRENOTA, ';  pAddNomeColuna('Situação Pré-Nota');
    End;

    objConsulta.pIncluiSubConsulta('QTDORI','(SELECT  COUNT(1) FROM MOVDET WHERE DET_SEQGER = D.DET_SEQGER)');

    strSql := strSql  + '   QTDORI, ';
    strSql := strSql  + '   L.AUTOINCREM, ';
    strSql := strSql  + '   LTP_SEQDET ';
    strSql := strSql  + ' FROM LOTPRE L ';
    strSql := strSql  + '   INNER JOIN MOVDET D ON L.LTP_SEQDET = D.AUTOINCREM ';
    strSql := strSql  + '   INNER JOIN CADFOR F ON F.FOR_CODFOR = D.DET_CODFOR ';
    strSql := strSql  + '   LEFT  JOIN CADOPE R ON R.OPE_CODOPE = L.LTP_OPERES ';

    If fConferenciaDepoisDaEntrada Then
    Begin
      strSql := strSql  + '   LEFT JOIN GERELE ON GER_DOCENT = DET_NUMDOC AND ';
      strSql := strSql  + '                       GER_ESPENT = DET_ESPDOC AND ';
      strSql := strSql  + '                       GER_EMPENT = DET_CODEMP AND ';
      strSql := strSql  + '                       B07_SERIE  = DET_SERIE_ AND ';
      strSql := strSql  + '                       GER_CODFOR = DET_CODFOR     ';

      If blnEtrAut Then
       strSql := strSql  + '   LEFT JOIN ENTDES ON ENT_SEQENT = D.DET_SEQGER ';
    End;

    strGroup := strGroup  + ' GROUP BY ';
    strGroup := strGroup  + ' 	DET_NUMDOC, ';
    strGroup := strGroup  + ' 	DET_ESPDOC, ';
    strGroup := strGroup  + ' 	DET_SERIE_, ';
    strGroup := strGroup  + ' 	DET_CODFOR, ';
    strGroup := strGroup  + ' 	DET_CODEMP, ';
    strGroup := strGroup  + ' 	LTP_OPERES  ';

    arrSQLConsulta    := [strSQL, fSQLWhere(True), strGroup];
    arrCamposConsulta := arrTitCol;
  End;
Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin

    chrKey := #0;

    Try

      blnEtrAut := fCfgSis('ETRAUT', varBoolean);
      objConsulta := TDefConsultaLotePreco.Create;

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryLotPre) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryLotPre;

        If fConsulta(arrSQLConsulta, arrCamposConsulta,
                   ['DET_NUMDOC','FOR_NOMFOR','DET_CODFOR'],
                   'AUTOINCREM',
                   'LOTPRE',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   objConsulta) Then
      Begin

        Result := True;

        If Not Assigned(qryLotPre) Then
          FreeAndNil(qryConsulta);

      End;
      FreeAndNil(objConsulta);
      FreeAndNil(objLoadSQL);
    Except

      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;

    End;

  End;

End;

