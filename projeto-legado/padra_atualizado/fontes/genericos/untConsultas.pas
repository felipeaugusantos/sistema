                                  objDefConsultaPlanoContabil)
      Else
        blnConsulta := fConsultaConfig([strSQL, fSQLWhere(True)],
                                 ['Código',
                                  'Descrição',
                                  'Empresa',
                                  'Prazo',
                                  'Conta Contábil',
                                  'Qtd. Máxima de Parcelas',
                                  'Plano Contábil',
                                  'Ativo',
                                  'AUTOINCREM'],
                                 ['CAR_DESCAR','CAR_CODEMP','CAR_CODCAR'],
                                  '',
                                  'CADCAR',
                                  Self.Name,
                                  'Consulta de Cartões',
                                  qryConsulta,
                                  Nil,
                                  blnConSim,
                                  arrSel,
                                  'CAR_CODCAR',
                                  fSQLWhere(False),
                                  '',
                                  False,
                                  objDefConsultaPlanoContabil);

      If blnConsulta Then
