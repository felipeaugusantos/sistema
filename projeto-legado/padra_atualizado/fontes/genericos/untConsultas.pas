function fPesqFornecedor(opcConFor: TTipoConsultaFornecedor;
                         Self     : TForm;                        {* Formulário                                  *}
                         edtCodigo: TCustomEdit;                  {* Edit do Código                              *}
                         edtNomEmp: TCustomEdit;                  {* Edit do Nome da Empresa                     *}
                         qryTabela: TUniQuery;                    {* Query                                       *}
                         Var chrKey: Char;                        {* Key                                         *}
                         Var arrSel: TConsultasArray;             {* Array de Seleção                            *}
                         blnConSim: Boolean = True;               {* Consulta Simples ou Múltipla (multi select) *}
                         objFrmPnl: TPanelCx = Nil;
                         strWhere : String = '';
                         strCodIte: String = ''):Boolean;
  {$Region 'Métodos locais'}
  function fSubQueryUltimaCompra(blnCodEmp: Boolean = False): String;
  begin
    Result := EmptyStr;
    Result := Result + ' SELECT DISTINCT A2.DET_CODFOR, A2.DTAENT, A2.HORENT, D.DET_SEQGER, D.DET_NUMDOC, D.DET_ESPDOC, D.DET_CODEMP ';

    Result := Result + ' FROM (SELECT  A.DET_CODFOR, A.DTAENT, MAX(D2.DET_HORENT) AS HORENT ';
    Result := Result + '       FROM (SELECT DET_CODFOR, MAX(DET_DTAENT) AS DTAENT ';
    Result := Result + '             FROM MOVDET ';

    if blnCodEmp then
      Result := Result + ' 	         WHERE IFNULL(DET_CODFOR,"") <> "" AND DET_CODITE = "%0:s" AND DET_TIP_FC = "F" AND DET_CODEMP = "%2:s" '
    else
      Result := Result + ' 	         WHERE IFNULL(DET_CODFOR,"") <> "" AND DET_CODITE = "%0:s" AND DET_TIP_FC = "F" ';

    Result := Result + ' 	                AND LOCATE(DET_CLAFIS, "%1:s")  > 0 ';
    Result := Result + '             GROUP BY DET_CODFOR) A ';

    Result := Result + ' 	     JOIN MOVDET D2 ON D2.DET_CODFOR = A.DET_CODFOR AND D2.DET_DTAENT = A.DTAENT AND D2.DET_CODITE = "%0:s" AND D2.DET_TIP_FC = "F" ';

    if blnCodEmp then
      Result := Result + ' 	         AND D2.DET_CODEMP = "%2:s" AND LOCATE(D2.DET_CLAFIS, "%1:s")  > 0  '
    else
      Result := Result + ' 	         AND LOCATE(D2.DET_CLAFIS, "%1:s")  > 0 ';

    Result := Result + '       GROUP BY A.DET_CODFOR, A.DTAENT) A2 ';

    Result := Result + ' JOIN MOVDET D ON D.DET_CODFOR = A2.DET_CODFOR AND D.DET_DTAENT = A2.DTAENT AND D.DET_HORENT = A2.HORENT AND D.DET_CODITE = "%0:s" AND D.DET_TIP_FC = "F" ';
    Result := Result + '               AND LOCATE(D.DET_CLAFIS, "%1:s")  > 0 ';

    if blnCodEmp then
      Result := Result + ' WHERE DET_CODEMP = "%2:s" ';
  end;
  {$Endregion}
  Var
    qryConsulta: TUniQuery;
    objConsulta: TDefMascaraFornecedor;
    strSQL: String;
    arrTitCol: TColunasArray;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strSQLWhere: String;
  Begin
    If blnCompleto Then
      strSQLWhere := ' WHERE TRUE '
    Else
      strSQLWhere := '';

    If (Not fEmptyStr(strWhere)) Then
      strSQLWhere := strSQLWhere + ' AND ' + strWhere;

    Result := strSQLWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';

      Case opcConFor Of
        conForCompleta: Begin
                          strSQL := strSQL + 'SELECT          ';
                          strSQL := strSQL + '  F.FOR_CODFOR, ';
                          strSQL := strSQL + '  F.FOR_NOMFOR, ';
                          strSQL := strSQL + '  F.FOR_NOMFAN, ';
                          strSQL := strSQL + '  F.FOR_ENDERE, ';
                          strSQL := strSQL + '  F.FOR_BAIRRO, ';
                          strSQL := strSQL + '  C.CID_NOMCID, ';
                          strSQL := strSQL + '  C.CID_ESTADO, ';
                          strSQL := strSQL + '  F.FOR_CONTAT, ';
                          strSQL := strSQL + '  F.FOR_C_G_C_, ';
                          strSQL := strSQL + '  F.FOR_I_E_S_, ';
                          strSQL := strSQL + '  F.FOR_C_E_P_, ';
                          strSQL := strSQL + '  F.FOR_FONE01, ';
                          strSQL := strSQL + '  A.ATI_DESATI, ';
                          strSQL := strSQL + '  F.FOR_STATUS, ';
                          strSQL := strSQL + '  F.FOR_CGCCPF, ';
                          strSQL := strSQL + '  F.FOR_PEDDOL, ';
                          strSQL := strSQL + '  F.FOR_PEDIMP, ';
                          strSQL := strSQL + '  F.AUTOINCREM  ';
                          strSQL := strSQL + 'FROM            ';
                          strSQL := strSQL + '  CADFOR F      ';
                          strSQL := strSQL + '  LEFT JOIN CADCID C ON F.FOR_CODCID = C.CID_CODCID ';
                          strSQL := strSQL + '  LEFT JOIN CADATI A ON F.FOR_CODATI = A.ATI_CODATI ';

                          SetLength(arrTitCol, 14);
                          arrTitCol[00] := 'Código';
                          arrTitCol[01] := 'Razão Social';
                          arrTitCol[02] := 'Nome Fantasia';
                          arrTitCol[03] := 'Endereço';
                          arrTitCol[04] := 'Bairro';
                          arrTitCol[05] := 'Cidade';
                          arrTitCol[06] := 'UF';
                          arrTitCol[07] := 'Contato';
                          arrTitCol[08] := 'CNPJ';
                          arrTitCol[09] := 'Insc. Est.';
                          arrTitCol[10] := 'CEP';
                          arrTitCol[11] := 'Telefone 1';
                          arrTitCol[12] := 'Atividade';
                          arrTitCol[13] := 'Status';
                        End;
        conForSimples:  Begin
                          strSQL := '';
                          strSQL := strSQL + 'SELECT FOR_CODFOR,  ';
                          strSQL := strSQL + '  F.FOR_NOMFOR,     ';
                          strSQL := strSQL + '  F.FOR_NOMFAN,     ';
                          strSQL := strSQL + '  F.FOR_C_G_C_,     ';
                          strSQL := strSQL + '  F.FOR_I_E_S_,     ';
                          strSQL := strSQL + '  F.FOR_FONE01,     ';
                          strSQL := strSQL + '  A.ATI_DESATI,     ';
                          strSQL := strSQL + '  F.FOR_STATUS,     ';
                          strSQL := strSQL + '  F.FOR_COMPRA,     ';
                          strSQL := strSQL + '  F.FOR_CGCCPF,     ';
                          strSQL := strSQL + '  F.AUTOINCREM      ';
                          strSQL := strSQL + 'FROM                ';
                          strSQL := strSQL + '  CADFOR F          ';
                          strSQL := strSQL + '  LEFT JOIN CADATI A ON F.FOR_CODATI = A.ATI_CODATI ';
                          {***************************************}
                          {* TÍTULO DA COLUNA E MÁSCARA DO CAMPO *}
                          {************************************RV*}
                          SetLength(arrTitCol, 09);
                          arrTitCol[00] := 'Código';
                          arrTitCol[01] := 'Razão Social';
                          arrTitCol[02] := 'Nome Fantasia';
                          arrTitCol[03] := 'CNPJ';
                          arrTitCol[04] := 'Insc. Est.';
                          arrTitCol[05] := 'Telefone 1';
                          arrTitCol[06] := 'Atividade';
                          arrTitCol[07] := 'Status';
                          arrTitCol[08] := 'Operador';
                        End;
        conForUltimaCompra: begin
                              strSQL := '';
                              strSQL := strSQL + 'SELECT FOR_CODFOR,  ';
                              strSQL := strSQL + '  F.FOR_NOMFOR,     ';
                              strSQL := strSQL + '  F.FOR_NOMFAN,     ';
                              strSQL := strSQL + '  F.FOR_C_G_C_,     ';
                              strSQL := strSQL + '  F.FOR_I_E_S_,     ';
                              strSQL := strSQL + '  F.FOR_FONE01,     ';
                              strSQL := strSQL + '  A.ATI_DESATI,     ';
                              strSQL := strSQL + '  F.FOR_STATUS,     ';
                              strSQL := strSQL + '  P.DTAENT,     ';
                              strSQL := strSQL + '  IFNULL(CONCAT(P.DET_CODEMP,"-",E.EMP_NOMFAN),"") AS EMPUC_, ';
                              strSQL := strSQL + '  P2.DTAENT AS PEDEMP,     ';
                              strSQL := strSQL + '  F.AUTOINCREM,     ';
                              strSQL := strSQL + '  F.FOR_CGCCPF      ';
                              strSQL := strSQL + 'FROM                ';
                              strSQL := strSQL + '  CADFOR F          ';
                              strSQL := strSQL + '  LEFT JOIN CADATI A ON F.FOR_CODATI = A.ATI_CODATI ';
                              strSql := strSQL + '  LEFT JOIN ('+fSubQueryUltimaCompra+') P ON P.DET_CODFOR = F.FOR_CODFOR ';
                              strSql := strSQL + '  LEFT JOIN CADEMP E ON EMP_CODEMP = P.DET_CODEMP ';
                              strSql := strSQL + '  LEFT JOIN ('+fSubQueryUltimaCompra(True)+') P2 ON P2.DET_CODFOR =  F.FOR_CODFOR ';
                              {***************************************}
                              {* TÍTULO DA COLUNA E MÁSCARA DO CAMPO *}
                              {************************************RV*}
                              SetLength(arrTitCol, 11);
                              arrTitCol[00] := 'Código';
                              arrTitCol[01] := 'Razão Social';
                              arrTitCol[02] := 'Nome Fantasia';
                              arrTitCol[03] := 'CNPJ';
                              arrTitCol[04] := 'Insc. Est.';
                              arrTitCol[05] := 'Telefone 1';
                              arrTitCol[06] := 'Atividade';
                              arrTitCol[07] := 'Status';
                              arrTitCol[08] := 'Data Últ. Compra';
                              arrTitCol[09] := 'Loja Últ. Compra';
                              arrTitCol[10] := 'Data Últ. Compra Loja Atual';

                              strSQL := Format(strSQL,[strCodIte,
                                                       (VS_strClaCom +  fRetornarClassificacoesBonificacaoEntrada),
                                                       VS_strCodEmp]);
                            end;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefMascaraFornecedor.Create;
      objConsulta.stlCamposComplementares.Add('FOR_STATUS');

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrTitCol,
                   ['FOR_NOMFOR','FOR_NOMFAN','FOR_CODFOR'],
                   '',
                   'CADFOR',
                   Self.Name,
                   'Consulta de Fornecedores',
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'FOR_CODFOR',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta,
                   False,
                   False,
                   '',
                   Nil,
                   True,
                   True,
                   True,
                   fCadFor,
                   Nil,
                   Nil
                   {VS_Application}) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('FOR_CODFOR').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('FOR_CODFOR').AsString;
        End;

        If Assigned(edtNomEmp) Then
          edtNomEmp.Text := qryConsulta.FieldByName('FOR_NOMFOR').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
            Else
              edtCodigo.Text := fStrZero('0', 8);
          End;

          If Assigned(edtNomEmp) Then
            edtNomEmp.Text := '+1';

        End;

        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqManifestosEncerrados(Self     : TForm;                        {* Formulário                                  *}
                                   edtCodigo: TCustomEdit;                  {* Edit do Código                              *}
                                   qryTabela: TUniQuery;                    {* Query                                       *}
                                   Var chrKey: Char;                        {* Key                                         *}
                                   Var arrSel: TConsultasArray;             {* Array de Seleção                            *}
                                   blnConSim: Boolean = True;               {* Consulta Simples ou Múltipla (multi select) *}
                                   objFrmPnl: TPanelCx = Nil):Boolean;
  Var
    qryConsulta: TUniQuery;
    strSQL: String;
    strGroup: string;
    arrTitCol: TColunasArray;
    arrPesq: Array of String;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + '  AND FIS_ENCERR = 1 ';
    strWhere := strWhere + '  AND IFNULL(FIS_ACEMAN, "") <> "" ';
    strWhere := strWhere + '  AND FIS_ESPDOC IN ("NF", "EL") ';
    strWhere := strWhere + '  AND FIS_CLFSC1 > "5000" ';
    strWhere := strWhere + '  AND FIS_ORIDOC = "V" ';
    strWhere := strWhere + '  AND FIS_NUMMAN IS NOT NULL ';
    strWhere := strWhere + '  AND FIS_EMPMAN = ' + QuotedStr(VS_strCodEmp);
    strWhere := strWhere + '  AND (MG.AUTOINCREM IS NOT NULL OR NG.AUTOINCREM IS NOT NULL) ';

    Result := strWhere;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  FIS_NUMMAN, ';
      strSQL := strSQL + '  FIS_DTAMAN, ';
      strSQL := strSQL + '  FIS_ESTADO, ';
      strSQL := strSQL + '  IF(FIS_MOTMAN IS NULL, ';
      strSQL := strSQL + '    CAST((SELECT GROUP_CONCAT(MOT_NOMMOT SEPARATOR ", ") ';
      strSQL := strSQL + '      FROM FISMOT ';
      strSQL := strSQL + '      JOIN CADMOT ON FMO_CODMOT = MOT_CODMOT ';
      strSQL := strSQL + '      WHERE FMO_SEQGER = CADFIS.AUTOINCREM) AS CHAR(200)), ';
      strSQL := strSQL + '    MOT_NOMMOT) AS MOT_NOMMOT, ';
      strSQL := strSQL + '  FIS_PLAMAN, ';
      strSQL := strSQL + '  CADFIS.AUTOINCREM ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADFIS ';
      strSQL := strSQL + '  LEFT JOIN CADMOT ON MOT_CODMOT = FIS_MOTMAN ';
      strSQL := strSQL + '  LEFT JOIN CADFOR ON FOR_CODFOR = FIS_FORCLI AND FIS_TIP_FC = "F" ';
      strSQL := strSQL + '  LEFT JOIN MOVGER MG ON MG.GER_NUMDOC = FIS_NUMDOC AND ';
      strSQL := strSQL + '                         MG.GER_ESPDOC = FIS_ESPDOC AND ';
      strSQL := strSQL + '                         MG.GER_CODEMP = FIS_CODEMP AND ';
      strSQL := strSQL + '                         MG.GER_TIP_FC = FIS_TIP_FC AND ';
      strSQL := strSQL + '                         IFNULL(MG.GER_CODCLI, FOR_CODFOR) = FIS_FORCLI AND ';
      strSQL := strSQL + '                         IFNULL(MG.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';
      strSQL := strSQL + '  LEFT JOIN NOTGER NG ON NG.GER_NUMDOC = FIS_NUMDOC AND ';
      strSQL := strSQL + '                         NG.GER_ESPDOC = FIS_ESPDOC AND ';
      strSQL := strSQL + '                         NG.GER_CODEMP = FIS_CODEMP AND ';
      strSQL := strSQL + '                         NG.GER_TIP_FC = FIS_TIP_FC AND ';
      strSQL := strSQL + '                         IFNULL(NG.GER_CODCLI, FOR_CODFOR) = FIS_FORCLI AND ';
      strSQL := strSQL + '                         IFNULL(NG.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';

      strGroup := '';
      strGroup := strGroup + 'GROUP BY ';
      strGroup := strGroup + '  FIS_NUMMAN, FIS_ESTADO, FIS_PLAMAN ';

      {***************************************}
      {* TÍTULO DA COLUNA E MÁSCARA DO CAMPO *}
      {************************************RV*}
      SetLength(arrTitCol, 05);
      arrTitCol[00] := 'Manifesto';
      arrTitCol[01] := 'Data';
      arrTitCol[02] := 'UF';
      arrTitCol[03] := 'Motorista';
      arrTitCol[04] := 'Placa Veículo';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      SetLength(arrPesq, 5);
      arrPesq[0] := 'FIS_NUMMAN';
      arrPesq[1] := 'FIS_DTAMAN';
      arrPesq[2] := 'FIS_ESTADO';
      arrPesq[3] := 'MOT_NOMMOT';
      arrPesq[4] := 'FIS_PLAMAN';

      If fConsultaConfig([strSQL, fSQLWhere(True), strGroup],
                   arrTitCol,
                   ['FIS_NUMMAN','FIS_DTAMAN','FIS_ESTADO','MOT_NOMMOT','FIS_PLAMAN'],
                   '',
                   'CADFIS',
                   Self.Name,
                   'Consulta de Manifestos Encerrados.',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'FIS_NUMMAN',
                   fSQLWhere(False)) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('FIS_NUMMAN').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('FIS_NUMMAN').AsString;
        End;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 6)
            Else
              edtCodigo.Text := fStrZero('0', 6);
          End;
        End;

        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqTransportadora(opcConTra    : TTipoConsultaTransportad;
                             Self         : TForm;                        {* Formulário                                  *}
                             edtCodigo    : TCustomEdit;                  {* Edit do Código                              *}
                             edtNomTra    : TEditFocus;                   {* Edit do Nome da Transportadora              *}
                             qryTabela    : TUniQuery;                    {* Query                                       *}
                             Var chrKey   : Char;                         {* Key                                         *}
                             Var arrSel   : TConsultasArray;              {* Array de Seleção                            *}
                             blnConSim    : Boolean = True;               {* Consulta Simples ou Múltipla (multi select) *}
                             strCidRegCli : String = '';                  {* Cidade/Região do Cliente                    *}
                             strAtiva     : String = '';                  {* Transportadora ativa?                       *}
                             fltTotGer    : Double = 0): Boolean;         {* Valor da Venda *}
  Var
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    strSQL     : String;
    strTitulo: String;
    arrTitCol,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    {Região}
    If Not fEmptyStr(strCidRegCli) And (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_REGIAO) Then
    Begin
      strWhere := strWhere + ' AND R.TRE_CODREG = "' + strCidRegCli + '" ';
    End
    Else
    {Cidade}
    If Not fEmptyStr(strCidRegCli) And (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_CIDADE) Then
    Begin
      strWhere := strWhere + ' AND F.FRE_CODCID = "' + strCidRegCli + '" ';
    End;

    { Ativa }
    if not fEmptyStr(strAtiva) then
    begin

      if fEmptyStr(strWhere) then
      begin
        strWhere := strWhere + 'WHERE ';
        strWhere := strWhere + '  T.TRA_ATIVA_ = "' + strAtiva + '" ';
      end
      else
        strWhere := strWhere + '  AND T.TRA_ATIVA_ = "' + strAtiva + '" ';

    end;

    {Faixa de Faturamento}
    If (fCfgSis('PERATF', varBoolean)) And (fCfgSis('FRETRA', varString) = FRETRA_POR_FAIXA_FATURAMENTO) And (fltTotGer > 0) Then
    Begin
     if fEmptyStr(strWhere) then
      begin
        strWhere := strWhere + 'WHERE ';
        strWhere := strWhere + '  '+AnsiReplaceStr(FormatFloat('0.00', fltTotGer),',','.')+' >= FRD_VALINI AND '+
                               '  '+AnsiReplaceStr(FormatFloat('0.00', fltTotGer),',','.')+' <= FRD_VALFIN ';
      end
      else
        strWhere := strWhere + '  AND '+AnsiReplaceStr(FormatFloat('0.00', fltTotGer),',','.')+' >= FRD_VALINI '+
                               '  AND '+AnsiReplaceStr(FormatFloat('0.00', fltTotGer),',','.')+' <= FRD_VALFIN ';
    End;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    Case opcConTra Of
      conTraCompleta: Begin
                        objLoadSql.stlJoins.Add(' LEFT JOIN CADCID C ON T.TRA_CODCID = C.CID_CODCID ');
                        objLoadSql.fIncluiSubConsulta('CID_NOMCID', 'C.CID_NOMCID', 'Cidade');
                        objLoadSql.fIncluiSubConsulta('CID_ESTADO', 'C.CID_ESTADO', 'UF');
                      End;
      conTraSimples:  Begin

                      End;
      conTraCidFrete: Begin
                        objLoadSql.stlJoins.Add('  LEFT JOIN CADCID C ON T.TRA_CODCID = C.CID_CODCID ');
                        objLoadSql.stlJoins.Add(' INNER JOIN FRETRA F ON F.FRE_CODTRA = T.TRA_CODTRA ');
                        objLoadSql.fIncluiSubConsulta('CID_NOMCID', 'C.CID_NOMCID', 'Cidade');
                        objLoadSql.fIncluiSubConsulta('CID_ESTADO', 'C.CID_ESTADO', 'UF');
                      End;
      conTraRegFrete: Begin
                        objLoadSql.stlJoins.Add(' INNER JOIN TRAREG R ON R.TRE_CODTRA = T.TRA_CODTRA ');
                        objLoadSql.stlJoins.Add(' INNER JOIN CADREG G ON G.REG_CODREG = R.TRE_CODREG ');
                        objLoadSql.fIncluiSubConsulta('REG_DESREG', 'G.REG_DESREG', 'Região');
                      End;
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
