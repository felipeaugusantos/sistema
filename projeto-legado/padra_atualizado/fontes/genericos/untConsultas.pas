function fPesqEstConcil(Self: TForm;                            {* Formulario                                  *}
                        edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                        edtDescri: TEditFocus;                  {* Edit da Descrição                           *}
                        qryTabela: TUniQuery;                   {* Query                                       *}
                        Var chrKey: Char;                       {* Key                                         *}
                        Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                        objConcil: TCamposConcil;               {* Campos da Conciliação                       *}
                        blnConSim: Boolean = True): Boolean;    {* Consulta Simples ou Múltipla (multi select) *}
Var
    strSQL : String;
    qryConsulta: TUniQuery;
    objConsulta : TDefConsulta;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If objConcil.strConfEs <> 'CFG_EQUEST' Then
    Begin

        If objConcil.strConfEs = 'CFG_CIEEST' Then
          strSQL := strSQL + '  AND SIS_CODCFG IN ("CFG_CIEEST", "CFG_CIELNK")    '
        Else If objConcil.strConfEs = 'CFG_REDEST' Then
          strSQL := strSQL + '  AND SIS_CODCFG IN ("CFG_REDEST", "CFG_REDECO")    '
        Else If objConcil.strConfEs = 'CFG_STOEST' Then
          strSQL := strSQL + '  AND SIS_CODCFG IN ("CFG_STOEST", "CFG_STOLNK")     '
        Else If objConcil.strConfEs = 'CFG_GETEST' Then
          strSQL := strSQL + '  AND SIS_CODCFG IN ("CFG_GETEST", "CFG_GETECO")    '
        Else If objConcil.strConfEs = 'CFG_PAGEST' Then
          strSQL := strSQL + '  AND SIS_CODCFG IN ("CFG_PAGEST", "CFG_PAGLNK")    '
        Else
          strSQL := strSQL + '  AND SIS_CODCFG="' + objConcil.strConfEs + '"      ';

      strWhere := strWhere + ' AND CAR_NOMOPE="' + objConcil.strNomCon + '" ';
    End;

    Result := strWhere;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL     := '';
      objConsulta := TDefConsulta.Create;

      strSQL := strSQL + 'SELECT CAR_CODEST, SIS_CODEMP, CAR_CODEST AS AUTOINCREM ';
      strSQL := strSQL + 'FROM ESTCAR                                             ';
      strSQL := strSQL + '  LEFT JOIN CFGSIS E ON LOCATE(TRIM(LEADING 0 FROM CAR_CODEST), TRIM(LEADING 0 FROM SIS_VALCFG)) > 0 ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                  ['Ponto de Venda',
                   'Empresa',
                   'AUTOINCREM'],
                   ['CAR_CODEST',
                    'SIS_CODEMP'],
                   'CAR_CODEST',
                   'ESTCAR',
                   Self.Name,
//                   'Consulta dos Códigos de Estabelecimento (' + objConcil.strNomCon + ')',
                   'Consulta dos Códigos de Estabelecimento',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'CAR_CODEST',
                   fSQLWhere(False)) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          edtCodigo.Text := qryConsulta.FieldByName('CAR_CODEST').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := AnsiReplaceStr(qryConsulta.FieldByName('CAR_CODEST').AsString, '<<csq>>', ' ');

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
            edtCodigo.Text := fStrZero('0', 7);

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
        FreeAndNil(objConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

End;

function fPesqEstAntecipacaoRedeCard(Self: TForm;                            {* Formulario                                  *}
                                     edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                                     edtDescri: TEditFocus;                  {* Edit da Descrição                           *}
                                     qryTabela: TUniQuery;                   {* Query                                       *}
                                     Var chrKey: Char;                       {* Key                                         *}
                                     Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                                     blnConSim: Boolean = True): Boolean;    {* Consulta Simples ou Múltipla (multi select) *}
Var
    strSQL,
    strWhere   : String;
    qryConsulta: TUniQuery;
    objConsulta : TDefConsulta;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL     := '';
      objConsulta := TDefConsulta.Create;


      strSQL :=  ' SELECT                                                 '+
                 '   SIS_CODEMP,                                          '+
                 '   EMP_NOMEMP,                                          '+
                 '   SIS_VALCFG,                                          '+
                 '   IF(                                                  '+
                 '     SIS_CODCFG = "CFG_REDEST",                         '+
                 '     "Número do Ponto de Venda (PV)",                   '+
                 '     "Número do Ponto de Venda (PV) para E-COMMERCE"    '+
                 '   ) AS CONFIGURACAO,                                   '+
                 '   SIS_VALCFG AS AUTOINCREM                             '+
                 ' FROM                                                   '+
                 '   CFGSIS                                               '+
                 '   JOIN CADEMP                                          '+
                 '     ON EMP_CODEMP = SIS_CODEMP                         ';

      strWhere := 'WHERE SIS_CODCFG IN ("CFG_REDEST", "CFG_REDECO")       '+
                  '     AND IFNULL(SIS_VALCFG, "") <> ""                  ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta([strSQL, strWhere],
                  ['Cod. Empresa',
                   'Empresa',
                   'Ponto(s) de Venda',
                   'Configuração',
                   'AUTOINCREM'],
                   ['SIS_CODEMP',
                    'EMP_NOMEMP',
                    'SIS_VALCFG',
                    'CONFIGURACAO'],
                   'SIS_VALCFG',
                   'CFGSIS',
                   Self.Name,
                   'Consulta dos Códigos de Estabelecimento (Antecipação RedeCard)',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'SIS_VALCFG') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          edtCodigo.Text := qryConsulta.FieldByName('SIS_VALCFG').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := AnsiReplaceStr(Concat(qryConsulta.FieldByName('SIS_CODEMP').AsString,'-',
                                                  fRetNomeEmpresa(qryConsulta.FieldByName('SIS_CODEMP').AsString)), '<<csq>>', ' ');

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
            edtCodigo.Text := fStrZero('0', 7);

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
        FreeAndNil(objConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
