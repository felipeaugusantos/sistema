  {* PEDIDO DE RESERVA DE ESTOQUE ENTRADA DE MERCADORIAS NAO DEVE SER EXIBIDO *}
  {*************************************************************************JC*}
  strWhere := strWhere + '  AND FGO_DOCEND IS NULL ';

  {********************************************}
  {* ORÇAMENTO ESPECIAL NÃO DEVE SER EXIBIDOS *}
  {*****************************************RN*}
  If (strEspDoc = 'OR') Then
    strWhere := strWhere + ' AND (FGO_ORCESP = "N") ';

  {*************************************************************************************}
  {* PEDIDOS DE CLIENTE FILIAL COM VLRCON = 0 SÃO GERADOS ATRAVÉS DA ORDEM DE PRODUÇÃO *}
  {* MÓDULO INDUSTRIAL CFG_UTIIND, E NÃO DEVEM APARECER NA CONSULTA                    *}
  {**********************************************************************************RN*}
  If (strEspDoc = 'PD') Then
    strWhere := strWhere + '  AND (FGO_TEMBRI = "S" OR FGO_VLRCON <> 0) ';

  If (strEspDoc = 'OR') And (Not fVerificaAcessoSistema('VERORC')) Then
    strWhere := strWhere + '  AND FGO_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ';

  If (strEspDoc = 'PD') And (Not fVerificaAcessoSistema('VERPED')) Then
    strWhere := strWhere + '  AND FGO_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ';

  If Not blnFiltrarTodasAsLojas Then
  Begin
    If (strOpcDoc = 'OR') And (fCfgSis('ALTLOJ') <> 'S') And ((fCfgSis('ALTORC') <> 'S') Or (Not fVerificaAcessoSistema('ALTORC'))) Then
      strWhere := strWhere + '  AND FGO_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' '

    Else If (strOpcDoc = 'OR') And (fCfgSis('ALTLOJ') = 'S') And ((fCfgSis('ALTORC') <> 'S') Or (Not fVerificaAcessoSistema('ALTORC'))) Then
    Begin
      If Not fEmptyStr(strCodEmp) Then
        strWhere := strWhere + '  AND FGO_CODEMP = ' + QuotedStr(strCodEmp) + ' '
    End

    Else If (strOpcDoc = 'PD') And (fCfgSis('ALTLOJ') = 'S') And (strOriF11 = 'S') Then
    Begin
      If Not fEmptyStr(strCodEmp) Then
        strWhere := strWhere + '  AND FGO_CODEMP = ' + QuotedStr(strCodEmp) + ' '
    End

    Else if (strOpcDoc = 'PD') And (fCfgSis('ALTLOJ') = 'N') And (fCfgSis('ENT_CD') = 'S') And (fCfgSis('EMPFAT') = 'S') And (strOriF11 = 'S') then
      strWhere := strWhere + '  AND ( (FGO_CODEMP = ' + QuotedStr(strCodEmp) + ') OR (EXTGOR.FGO_EMP_CD = ' + QuotedStr(strCodEmp) + ' AND FATGOR.FGO_ENT_CD = ' + QuotedStr('S') + ') ) ' + ' '

    Else If (strOpcDoc <> 'TE') And (strOpcDoc <> 'OU') And (strOpcDoc <> 'OR') Then
    Begin
      If Not ((strOpcDoc = 'VN') And (fCfgSis('ALTORC') = 'S') And (strEspDoc = 'OR') And (fVerificaAcessoSistema('ALTORC'))) Then
      Begin

        If fCfgSis('CEATMN') = '1' Then
          strWhere := strWhere + '  AND FGO_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' '
        Else
          strWhere := strWhere + '  AND (FGO_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' OR IFNULL(FGO_EMPFOR, "") = ' + QuotedStr(VS_strCodEmp) + ') ';
      End;
    End;
  End
  Else
    strWhere := strWhere + '  AND ' + fGetSQLInEmpresasAcesso('FGO_CODEMP') + ' ';

  strWhere := strWhere + strWhereAux;

  If (strEspDoc = 'OR') Or (Not fCfgSis('MOPDFA', varBoolean)) Then
    strWhere := strWhere + '  AND FGO_JAFATU = FALSE ';

  If (fCfgSis('ULTORC', varInteger) > 0) And ((strEspDoc = 'OR') Or (strOpcDoc = 'OR')) Then
    strWhere := strWhere + ' AND ' + TAG_ULTORC_INI + ' FGO_DTAENT >= SUBDATE(' + fCurrentDate + ', INTERVAL ' + IntToStr(fCfgSis('ULTORC', varInteger)) + ' DAY) ' + TAG_ULTORC_FIN + ' ';

  If (fCfgSis('EXIPDT') = 'N') And (strOriF11 = 'S') Then
    strWhere := strWhere + ' AND FGO_CODCLI NOT IN ('  + fRetClientesFilial + ') ';

  if (strOpcDoc = 'ER') then
    strWhere := strWhere + ' AND CLI_REMOUT = "S" ';

  if (strOpcDoc = 'EM') then
    strWhere := strWhere + ' AND CLI_REMOUT = "N" ';

  if fCfgSis('FPOSCP', varBoolean) and ((Pos(strOpcDoc, 'CP_PD') = 0) or (strOriF11 = 'S')) then
    strWhere := strWhere + ' AND EQ.EQU_NUMPED IS NULL AND EQ2.EQU_NUMPED IS NULL '
  else if (fCfgSis('OSGLCP', varBoolean)) And (strOriF11 = 'S') then
    strWhere := strWhere + ' AND IFNULL(EQ.EQU_GARANT, IFNULL(EQ2.EQU_GARANT, "N")) <> "L" ';

  If blnUltPed Then
  Begin
    strConsulta := strSQL + strWhere;

    strWhere := '';

    strSQL := strSQL + IfThen(Pos('WHERE', strSQL) > 0, ' AND ', ' WHERE ') + ' FGO_DTAENT >= SUBDATE(' + fCurrentDate + ', INTERVAL ' + IntToStr(fCfgSis('ULTPED', varInteger)) + ' DAY) ';

    strSQL := strSQL + ' UNION ' + strConsulta + ' AND FGO_JAFATU = FALSE ';

    strConsulta := strSQL;

    strSQL := '';
    strSQL := strSQL + ' SELECT ';

    strSQL := strSQL + fRetCamposGrid;

    strSQL := strSQL + '  FATGOR.AUTOINCREM  ';

    strSQL := strSQL + ' FROM (' + strConsulta + ') AS FATGOR';

    strSQL := strSQL + '  INNER JOIN CADCLI ON FGO_CODCLI = CLI_CODCLI ';
    strSQL := strSQL + '  LEFT JOIN CADTRA ON TRA_CODTRA = FGO_CODTRA  ';
    strSQL := strSQL + '  LEFT JOIN CADCID ON CID_CODCID = CLI_CODCID  ';
  End;

End;

function fPesqPedOrc(opcTipCon: TTipoConsultaPedidoVenda;
                     Self     : TForm;                            {* Formulário                                  *}
                     strEspDoc: String;                           {* Tipo de Documento                           *}
                     strOpcDoc: String;                           {* Opção de Documento                          *}
                     strCodEmp: String;                           {* Código da Empresa                           *}
                     edtNumDoc: TCustomEdit;                      {* Edit do Número do Documento                 *}
                     edtEspDoc: TEditFocus;                       {* Edit do Tipo do Documento                   *}
                     edtCodEmp: TEditFocus;                       {* Edit do Código da Empresa                   *}
                     Var qryTabela: TUniQuery;                    {* Query                                       *}
                     Var chrKey: Char;                            {* Key                                         *}
                     Var arrSel: TConsultasArray;                 {* Array de Seleção                            *}
                     blnConSim: Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                     objFrmPnl: TPanelCx = Nil;                   {* Painel                                      *}
                     strCliCrm: String = '';                      {* Código do cliente CRM                       *}
                     strOriF11: String = 'N';                     {* F11 Resumo de Caixa                         *}
                     strCodIte: String = '';
                     blnFiltrarTodasAsLojas: Boolean = False;
                     blnRetNumDoc: Boolean = False;               {* Retorna documento acima de qualquer coisa   *}
                     strDtaIni   : string = '';
                     strDtaFin   : string = '';
                     blnApenaspedidoVendaAberto: Boolean = False;
                     blnVisualizaPedidosAdiantamentoContrato: Boolean = False): Boolean;
  Var
    ProcSituacaoPedido: TGenericProcedureWithClientParam;
    ProcAlteraSentencaUltOrcUltPedConformeFiltro: TGenericProcedureWithClientParamAndVar;
    qryConsulta: TUniQuery;
    objConsulta : TDefConsulta;
    arrTitCol: TColunasArray;                    {* Títulos das Colunas                         *}
    strSQL,
    strWhere,
    strGroup : String;
    strSigCam: String;
    strTabela: String;
    strTitulo: String;
    strCodBusca: String;
    arrOrdenacao: TColunasArray;
    Function fRetFinLib: String;
      Var
        strSQL: String;

        Function fRetSQLNeg: String;
        Begin
          Result := '';
          Result := Result + ' SELECT COUNT(AUTOINCREM) AS QTD ';
          Result := Result + ' FROM NEGPED ';
          Result := Result + ' WHERE NPD_NUMDOC = FGO_NUMDOC ';
          Result := Result + ' AND   NPD_CODCLI = FGO_CODCLI ';
          Result := Result + ' AND   NPD_CODEMP = FGO_CODEMP ';
          Result := Result + ' LIMIT 1 ';
        End;

    Begin
      strSQL := '';
      strSQL := strSQL + '  IF(FGO_LIBERA > 0,                       "PEDIDO LIBERADO", ';
      strSQL := strSQL + '  IF(FGO_ENVLIB = "S",                     "PEDIDO EM ANALISE", ';
      strSQL := strSQL + '  IF(IFNULL((' + fRetSQLNeg + '), 0) <> 0, "LIBERACAO NEGADA", ';
      strSQL := strSQL + '                                           "PEDIDO NAO ENVIADO PARA LIBERACAO")))';

      Result := strSQL;
    End;

    Function fRetComLib: String;
      Var
        strSQL: String;
    Begin
      strSQL := '';
      strSQL := strSQL + ' (CASE FGO_LIBCOM                               ';
      strSQL := strSQL + '   WHEN 0 THEN "BLOQUEADO PELO DEP. COMERCIAL" ';
      strSQL := strSQL + '   WHEN 1 THEN "LIBERADO PELO DEP. COMERCIAL"  ';
      strSQL := strSQL + ' END)';

      Result := strSQL;
    End;
  Function fSQLWhere(blnCompleto: Boolean; strDtaIni, strDtaFin: string): String;
    Var
      strSQLWhere: String;
  Begin
    If blnCompleto Then
      strSQLWhere := ' WHERE TRUE '
    Else
      strSQLWhere := '';

    strSQLWhere := strSQLWhere + AnsiReplaceStr(strWhere,'WHERE',' AND ');

    If (strOriF11 <> 'S') And (strTabela = 'FATGOR') Then
      strSQLWhere := strSQLWhere + ' AND FGO_ORIGEM <> "AGRUPAMENTO" ';

    If (strOriF11 = 'S') And (strTabela = 'FATGOR') Then
      strSQLWhere := strSQLWhere + ' AND FGO_TIPOPE <> "R" ';

    strSQLWhere := strSQLWhere + IIF((not fEmptyStr(strDtaIni)) and (not fEmptyStr(strDtaFin)), '  AND FGO_DTAENT BETWEEN ' + QuotedStr(strDtaIni) + ' AND ' + QuotedStr(strDtaFin) + ' ', '');

    If blnApenaspedidoVendaAberto Then
      strSQLWhere := strSQLWhere + ' AND FGO_ESPDOC = "PD" AND FGO_JAFATU = 0 AND FGO_VLRCON > 0 AND IFNULL(FGO_DOCEND, "") = "" ';

    Case opcTipCon Of
      conPedSimples,
      conPedCompleta: Begin
                        If Not blnVisualizaPedidosAdiantamentoContrato Then
                        Begin
                          strSQLWhere := strSQLWhere + ' AND IFNULL(FGO_LOC_PD, "N") <> "S" ';
                        End
                        Else
                          strSQLWhere := strSQLWhere + ' AND (((IFNULL(FGO_LOC_PD, "N") = "S") AND ((SELECT COUNT(EQLFAT.AUTOINCREM)  ' +
                                                       '                                            FROM EQLFAT                      ' +
                                                       '                                            INNER JOIN CONEQL ON CONEQL.AUTOINCREM = EQF_SEQCON ' +
                                                       '                                            WHERE EQL_AUT_PD = FATGOR.AUTOINCREM) <= 0)) ' +
                                                       ' OR   (IFNULL(FGO_LOC_PD, "N") = "N")) ';
                      End;
    End;

    Result := strSQLWhere;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    pCriarModuloLegenda;
    Try

      chrKey := #0;

      strGroup := '';
      strTitulo:= 'Consulta de Pedidos / Orçamentos';
      objConsulta := TDefConsultaPed.Create;

      If opcTipCon <> conPedOrdPro Then
      Begin
        objConsulta.pIncluiSubConsulta('CLI_NOMCLI', 'IF(FGO_NOMCON = "" OR FGO_NOMCON IS NULL, CLI_NOMCLI, FGO_NOMCON)');
        objConsulta.pIncluiSubConsulta('CLI_EMAIL_', 'IF(FGO_NOMCON = "" OR FGO_NOMCON IS NULL, CLI_EMAIL_, FGO_EMLCON)');


        objConsulta.pIncluiSubConsulta('FGO_FINLIB', fRetFinLib);
        objConsulta.pIncluiSubConsulta('FGO_COMLIB', fRetComLib);

        objConsulta.pIncluiSubConsulta('FGO_SEPIMP', 'IF(FGO_SEPIMP = "0" OR FGO_SEPIMP IS NULL, "NAO", "SIM")');
      End;
      strSigCam := 'FGO_';
      strTabela := 'FATGOR';

      strWhere := 'WHERE TRUE ';
      strWhere := strWhere + IIF((not fEmptyStr(strDtaIni)) and (not fEmptyStr(strDtaFin)), '  AND FGO_DTAENT BETWEEN ' + QuotedStr(strDtaIni) + ' AND ' + QuotedStr(strDtaFin) + ' ', '');

      case opcTipCon Of
        conPedSimples     : Begin
                              pPesqPedOrcSqlSimples(VS_strCodEmp, strSQL, strWhere, arrTitCol);
                              strTitulo := strTitulo + ' (Simples)';
                            End;
        conPedSimpMultEmp : Begin
                              pPesqPedOrcSqlSimples(strCodEmp, strSQL, strWhere, arrTitCol);
                              strTitulo := strTitulo + ' (Simples - Multiempresa)';
                            End;
        conPedOrdPro      : Begin
                              If Not fEmptyStr(strCodIte) Then
                              Begin
                                strTitulo := strTitulo + ' (Ordem Produção por Item)';
                                pPesqPedOrcPorItem(strSQL, strWhere, strGroup, arrTitCol,strCodIte);
                                strSigCam := 'FDO_';
                                strTabela := 'FATDOR';
                              End Else
                              Begin
                                strTitulo := strTitulo + ' (Ordem Produção)';
                                pPesqPedOrcSqlOrdPro(strSQL, strWhere, strGroup, arrTitCol, edtEspDoc.Text, (Self.Name = 'frmManutencaoOrdProVidro') );
                                strSigCam := 'PRO_';
                                strTabela := 'MOVPRO';
                              End;

                            End;
        conPedDigDoc      : Begin
                              pPesqPedOrcSqlDigDocumento(strSQL, strWhere, arrTitCol, strEspDoc);
                              strTitulo := strTitulo + ' (Documento)';
                            End;
        conPedCompleta    : Begin
                              pPesqPedOrcSqlCompleto(strSQL, strWhere, arrTitCol,
                                                   strEspDoc, strOpcDoc, strCodEmp,
                                                   objConsulta, strCliCrm, strOriF11,
                                                   blnFiltrarTodasAsLojas);
                              strTitulo := strTitulo + ' (Completo)';
                            End;
      end;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fCfgSis('EXISTA', VarBoolean) Or fCfgSis('EXIADT', VarBoolean) Then
        ProcSituacaoPedido := pAtualizaSituacaoPedidoVenda
      Else
        ProcSituacaoPedido := nil;

      ProcAlteraSentencaUltOrcUltPedConformeFiltro := pAlteraSentencaUltOrcUltPedConformeFiltro;

      If (opcTipCon <> conPedOrdPro) Then
      Begin
        arrOrdenacao :=  [strSigCam + 'NUMDOC', strSigCam + 'CODCLI','CLI_NOMCLI','CLI_FANSOB', strSigCam + 'DTAENT'];
        strCodBusca  :=  IIF(not blnRetNumDoc, IIF(not blnConSim, 'AUTOINCREM', strSigCam + 'NUMDOC'), strSigCam + 'NUMDOC');
      End
      Else
      Begin
        arrOrdenacao := ['PRO_DTACAD','PRO_NUMPED'];
        strCodBusca  := 'AUTOINCREM';
        strTitulo    := 'Consulta de Pedidos - Ordem de Produção';
      End;

      If fConsultaConfig([strSQL, fSQLWhere(True, strDtaIni, strDtaFin), strGroup],
                   arrTitCol,
                   arrOrdenacao,
                   '',
                   strTabela,
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   strCodBusca,
                   fSQLWhere(False, strDtaIni, strDtaFin),
                   '',
                   False,
                   objConsulta,
                   False,
                   False,
                   '',
                   ProcSituacaoPedido,
                   True,
                   True,
                   True,
                   Nil,
                   Nil,
                   Nil,
                   Nil,{VS_Application}
                   ProcAlteraSentencaUltOrcUltPedConformeFiltro) Then
      Begin
        If (opcTipCon <> conPedOrdPro) Then
        Begin
          If Assigned(edtNumDoc) then
          Begin
            If (edtNumDoc Is TMaskEditFocus) Then
              (edtNumDoc As TMaskEditFocus).Text := qryConsulta.FieldByName(strSigCam + 'NUMDOC').AsString
            Else
              edtNumDoc.Text := qryConsulta.FieldByName(strSigCam + 'NUMDOC').AsString;
          End;

          If Assigned(edtEspDoc) Then
            edtEspDoc.Text := qryConsulta.FieldByName(strSigCam + 'ESPDOC').AsString;

          If Assigned(edtCodEmp) Then
            edtCodEmp.Text := qryConsulta.FieldByName(strSigCam + 'CODEMP').AsString;
        End
        Else
          edtNumDoc.Text := qryConsulta.FieldByName(strSigCam + 'NUMPED').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtNumDoc) then
          Begin
            If (edtNumDoc Is TMaskEditFocus) Then
              (edtNumDoc As TMaskEditFocus).Text := fStrZero('0', fTamDocCadRec)
            Else
              edtNumDoc.Text := fStrZero('0', fTamDocCadRec);
          End;

        End;

        Result := True;

      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

{*****************************}
{* CONSULTA DE CFOP          *}
{**************************RV*}
function fPesqCFOP(Self     : TForm;                              {* Formulário                                  *}
                   edtCodigo: TCustomEdit;                        {* Edit do Código                              *}
                   edtDescri: TEditFocus;                         {* Edit da Descrição                           *}
                   qryTabela: TUniQuery;                          {* Query                                       *}
                   Var chrKey: Char;                              {* Key                                         *}
                   Var arrSel: TConsultasArray;                   {* Array de Seleção                            *}
                   blnConSim: Boolean = True;                     {* Consulta Simples ou Múltipla (multi select) *}
                   strFiltro: String = ''): Boolean;              {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If Not fEmptyStr(strFiltro) Then
    Begin
      strWhere := strWhere + ' AND ';
      strWhere := strWhere + strFiltro;
    End;

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  CFO_CODCFO,       ';
      strSQL := strSQL + '  CFO_NATOPE,       ';
      strSQL := strSQL + '  CFO_DESCR1,       ';
      strSQL := strSQL + '  CFO_DESCR2,       ';
      strSQL := strSQL + '  CFO_DESCR3,       ';
      strSQL := strSQL + '  CFO_DESCR4,       ';
      strSQL := strSQL + '  CFO_DESCR5,       ';
      strSQL := strSQL + '  CFO_PRESTA,       ';
      strSQL := strSQL + '  CFO_MNAT01,       ';
      strSQL := strSQL + '  CFO_MNAT02,       ';
      strSQL := strSQL + '  CFO_MNAT03,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADCFO            ';


      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('CFO_NATOPE', '(SELECT NAT_DESCRI FROM NATCFO WHERE NAT_CODCFO = CFO_CODCFO LIMIT 1 )');

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                  ['Código',
                   'Nat. Operação',
                   'Descrição 1',
                   'Descrição 2',
                   'Descrição 3',
                   'Descrição 4',
                   'Descrição 5',
                   'Prest. Serv.'],
                   ['CFO_NATOPE','CFO_DESCR1','CFO_DESCR2','CFO_CODCFO'],
                   '',
                   'CADCFO',
                   Self.Name,
                   'Consulta de CFOP',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'CFO_CODCFO',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('CFO_CODCFO').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('CFO_CODCFO').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('CFO_NATOPE').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 4)
            Else
              edtCodigo.Text := fStrZero('0', 4);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

{*****************************}
{* CONSULTA DE COMISSÕES     *}
{**************************RV*}
function fPesqFaixaComissao(Self     : TForm;                          {* Formulário                                  *}
                            edtCodigo: TCustomEdit;                    {* Edit do Código                              *}
                            edtDescri: TEditFocus;                     {* Edit da Descrição                           *}
                            qryTabela: TUniQuery;                      {* Query                                       *}
                            Var chrKey: Char;                          {* Key                                         *}
                            Var arrSel: TConsultasArray;               {* Array de Seleção                            *}
                            blnConSim: Boolean = True): Boolean;       {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL,
    strSubSQL  : String;
    qryConsulta: TUniQuery;
    arrCampos: TColunasArray;
    objConsulta: TDefConsulta;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  COM_CODCOM,       ';
      strSQL := strSQL + '  COM_DESCOM,       ';
      strSQL := strSQL + '  COM_PERINI,       ';
      strSQL := strSQL + '  COM_PERFIN,       ';
      strSQL := strSQL + '  COM_PERCOM,       ';
      strSQL := strSQL + '  COM_PERCOP,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      If fCfgSis('OPCCOM') = 'PD' Then
        strSQL := strSQL + '  ,TIPVEN         ';

      If fCfgSis('OPCCOM') = 'PD' Then
      Begin
        strSubSQL := '';
        strSubSQL := strSubSQL + ' CASE ';
        strSubSQL := strSubSQL + '    WHEN COM_TIPVEN = "I" THEN "VENDEDOR INTERNO" ';
        strSubSQL := strSubSQL + '    WHEN COM_TIPVEN = "E" THEN "REPRES. EXT. LOJA" ';
        strSubSQL := strSubSQL + '    WHEN COM_TIPVEN = "D" THEN "REPRES. EXT. DISTRIBUIDOR" ';
        strSubSQL := strSubSQL + '    ELSE "" ';
        strSubSQL := strSubSQL + '  END ';
      End;

      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADCOM            ';

      If Not Assigned(qryTabela) Then
