{*******************************}
{* CONSULTA DE CARTOES         *}
{****************************DP*}
function fPesqCartao(Self     : TForm;                     {* Formulário                                  *}
                     edtCodigo: TCustomEdit;               {* Edit do Código                              *}
                     edtDescri: TEditFocus;                {* Edit da Descrição                           *}
                     qryTabela: TUniQuery;                 {* Query                                       *}
                     Var chrKey: Char;                     {* Key                                         *}
                     Var arrSel: TConsultasArray;          {* Array de Seleção                            *}
                     blnConSim: Boolean = True;            {* Consulta Simples ou Múltipla (multi select) *}
                     blnSoAtiv: Boolean = False;           {* Filtra os cartões ativos ou todos           *}
                     blnMostraDesconto: Boolean = False;   {* Mostra a coluna desconto                    *}
                     blnCadCar: Boolean = False;           {* É cadastro                                  *}
                     blnEmpGer: Boolean = False;           {* É empresa gerencial                         *}
                     blnVerAce: Boolean = False;           {* Verifica direito de Acesso as Empresas?     *}
                     strCodEmp: String = ''): Boolean;     {* Seleciona os cartões da empresa Digitada    *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    blnConsulta: Boolean;
    objDefConsultaPlanoContabil : TDefConsultaPlanoContabil;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If blnSoAtiv Then
       strWhere := strWhere + ' AND CAR_STATUS = "S"  ';

    If blnVerAce Then
    Begin
      strWhere := strWhere + '  AND ((COALESCE(CAR_CODEMP, "") = "") OR ';
      strWhere := strWhere + '  (LOCATE(CAR_CODEMP, "' + strEmpAcessoUsuarioLogado + '") > 0)) ';
    End
    Else If Not (blnEmpGer) Or
            Not (blnCadCar) Then
    Begin
      strWhere := strWhere + '  AND (CAR_CODEMP = "" OR ';
      strWhere := strWhere + '       CAR_CODEMP IS NULL OR ';
      If fEmptyStr(strCodEmp) Then
        strWhere := strWhere + '       CAR_CODEMP = ' + QuotedStr(VS_strCodEmp) + ') '
      Else
        strWhere := strWhere + '       CAR_CODEMP = ' + QuotedStr(strCodEmp) + ') ';
    End;

    If fCfgSis('DACPOR', varBoolean) Then
    Begin
      strWhere := strWhere + '  AND (IFNULL(CAR_PORBAI, "") = "" ';
      strWhere := strWhere + '  OR LOCATE(CAR_PORBAI, ' + QuotedStr(strPortadoresOperador) + ') > 0) ';

      strWhere := strWhere + '  AND (IFNULL(CAR_PORTAX, "") = "" ';
      strWhere := strWhere + '  OR LOCATE(CAR_PORTAX, ' + QuotedStr(strPortadoresOperador) + ') > 0) ';

      strWhere := strWhere + '  AND (IFNULL(CAR_PORBAD, "") = "" ';
      strWhere := strWhere + '  OR LOCATE(CAR_PORBAD, ' + QuotedStr(strPortadoresOperador) + ') > 0) ';
    End;

    Result := strWhere;
  End;

begin
