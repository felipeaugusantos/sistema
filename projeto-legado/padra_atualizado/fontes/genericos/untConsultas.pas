{************************************}
{* CONSULTA DE REQUISIÇÃO DE COMPRA *}
{************************************}
function fPesqRequisicaoCompra(Self      : TForm;                                    {* Formulário                                  *}
                               edtCodigo : TCustomEdit;                              {* Edit do Código                              *}
                               Var chrKey: Char;                                     {* Key                                         *}
                               strTitulo : String  = 'Consulta de Requisição de Compras'): Boolean;
  Var
    arrTitCol  : TColunasArray;
    arrSel     : TConsultasArray;
    strSQL     : String;
    strGroupBy : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND RCG_CODEMP = ' + QuotedStr(VS_strCodEmp);

    Result := strWhere;
  End;

  function fSQLSelect: String;
  begin
    Result := '';
    Result := Result + 'SELECT ';
    Result := Result + '  RCG_CODIGO, ';
    Result := Result + '  RCG_CODEMP, ';
    Result := Result + '  RCG_DTACAD, ';
    Result := Result + '  RCG_CODCLI, ';
    Result := Result + '  CLI_NOMCLI, ';
    Result := Result + '  RCG_CODVEN, ';
    Result := Result + '  OPE_NOMOPE, ';
    Result := Result + '  RCG_DTAALT, ';

    Result := Result + '  IFNULL(EQUGER.EQU_NUMOSE, EQ.EQU_NUMOSE) AS EQU_NUMOSE, ';
    Result := Result + '  IFNULL(EQUGER.EQU_CODEMP, EQ.EQU_CODEMP) AS EQU_CODEMP, ';

    Result := Result + '  CASE IFNULL(EQUGER.EQU_GARANT, EQ.EQU_GARANT ) ';
    Result := Result + '      WHEN "L" THEN "Garantia Loja" ';
    Result := Result + '      WHEN "F" THEN "Garantia Fábrica" ';
    Result := Result + '      WHEN "R" THEN "Retorno de Garantia" ';
    Result := Result + '      ELSE "Não" ';
    Result := Result + '  END AS EQU_GARANT, ';

    Result := Result + '  M.AUTOINCREM  ';
    Result := Result + 'FROM ';
    Result := Result + '  MOVRCG M ';
    Result := Result + 'INNER JOIN CADOPE ON OPE_CODOPE = RCG_CODVEN ';
    Result := Result + 'INNER JOIN CADCLI ON CLI_CODCLI = RCG_CODCLI ';
    Result := Result + 'LEFT JOIN MOVRCD ON RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP ';
  end;
Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin
    chrKey := #0;

    Try
      objConsulta := TDefConsulta.Create;

      objConsulta.pIncluiListaForcaContida('PRODUTOS1');
      objConsulta.pIncluiSubConsulta('PRODUTOS1',  'CAST((SELECT GROUP_CONCAT(DISTINCT CONCAT(RCD_CODITE, IF(RCD_REQNEG = "S", " (NEGADA)", ""))) FROM MOVRCD WHERE RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP) AS CHAR(255))');

      objConsulta.pIncluiListaForcaContida('PRODUTOS2');
      objConsulta.pIncluiSubConsulta('PRODUTOS2',  'CAST((SELECT GROUP_CONCAT(DISTINCT RCD_DESITE) FROM MOVRCD WHERE RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP) AS CHAR(255))');

      objConsulta.pIncluiSubConsulta('EM_PEDCOM', 'IF((SELECT COUNT(*) FROM MOVRCD WHERE RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP AND RCD_SEQPCD IS NOT NULL) > 0, "SIM", "NÃO")');
      objConsulta.pIncluiCampoSimNao('EM_PEDCOM');

      objConsulta.pIncluiSubConsulta('PEDCOMPRA', 'CAST((SELECT GROUP_CONCAT(DISTINCT CONCAT(PCD_NUMPED, "-", PCD_ESPDOC, "-", PCD_CODEMP)) FROM MOVRCD ' +
                                                        'INNER JOIN PCMDET D ON  D.AUTOINCREM = RCD_SEQPCD ' +
                                                        'WHERE RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP AND RCD_SEQPCD IS NOT NULL) AS CHAR(255))');

      objConsulta.pIncluiSubConsulta('EM_PEDVEN', 'IF((SELECT COUNT(*) FROM MOVRCD WHERE RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP AND IFNULL(RCD_DOCPDV, "") <> "") > 0, "SIM", "NÃO")');
      objConsulta.pIncluiCampoSimNao('EM_PEDVEN');

      objConsulta.pIncluiSubConsulta('PEDVENDA',  'CAST((SELECT GROUP_CONCAT(DISTINCT CONCAT(RCD_DOCPDV, "-", RCD_ESPPDV, "-", RCD_EMPPDV)) FROM MOVRCD WHERE RCD_CODIGO = RCG_CODIGO AND RCD_CODEMP = RCG_CODEMP AND IFNULL(RCD_DOCPDV, "") <> "") AS CHAR(255))');

      strSQL := '';
      strSQL := strSQL + 'SELECT  ';
      strSQL := strSQL + '  RCG_CODIGO, '; pAddNomeColuna('Sequencial');
      strSQL := strSQL + '  RCG_CODEMP, '; pAddNomeColuna('Empresa');
      strSQL := strSQL + '  RCG_DTACAD, '; pAddNomeColuna('Cadastro');
      strSQL := strSQL + '  RCG_CODCLI, '; pAddNomeColuna('Cód.Cliente');
      strSQL := strSQL + '  CLI_NOMCLI, '; pAddNomeColuna('Cliente');
      strSQL := strSQL + '  RCG_CODVEN, '; pAddNomeColuna('Cód.Vendedor');
      strSQL := strSQL + '  OPE_NOMOPE, '; pAddNomeColuna('Vendedor');
      strSQL := strSQL + '  RCG_DTAALT, '; pAddNomeColuna('Alteração');

      strSQL := strSQL + '  PRODUTOS1,   '; pAddNomeColuna('Produtos');
      strSQL := strSQL + '  PRODUTOS2,   '; pAddNomeColuna('Descrições');

      strSQL := strSQL + '  EM_PEDCOM,  '; pAddNomeColuna('Emp Ped. Compra');
      strSQL := strSQL + '  PEDCOMPRA,  '; pAddNomeColuna('Ped. Compra');

      strSQL := strSQL + '  EM_PEDVEN,  '; pAddNomeColuna('Emp Ped. Venda');
      strSQL := strSQL + '  PEDVENDA,   '; pAddNomeColuna('Ped. Venda');

      strSQL := strSQL + '  EQU_NUMOSE, '; pAddNomeColuna('Número O.S');
      strSQL := strSQL + '  EQU_CODEMP, '; pAddNomeColuna('Emp. O.S');

      strSQL := strSQL + '  EQU_GARANT, '; pAddNomeColuna('Garantia');

      strSQL := strSQL + '  AUTOINCREM  ';
      strSQL := strSQL + 'FROM ( ';

      strSQL := strSQL + fSQLSelect;
      strSQL := strSQL + 'LEFT JOIN PREPRQ  ';
      strSQL := strSQL + '  ON PRQ_SEQRCD = MOVRCD.AUTOINCREM ';
      strSQL := strSQL + 'LEFT JOIN FDOABS ';
      strSQL := strSQL + '  ON ABS_SEQPRQ = PREPRQ.AUTOINCREM ';
      strSQL := strSQL + 'LEFT JOIN FATDOR FD1 ';
      strSQL := strSQL + '  ON FD1.AUTOINCREM = ABS_SEQFDO ';
      strSQL := strSQL + 'LEFT JOIN FATDOR FD2 ';
      strSQL := strSQL + '  ON ( ';
      strSQL := strSQL + '    FD2.FDO_NUMDOC = RCD_DOCPDV ';
      strSQL := strSQL + '    AND FD2.FDO_CODEMP = RCD_EMPPDV ';
      strSQL := strSQL + '    AND FD2.FDO_ESPDOC = RCD_ESPPDV ';
      strSQL := strSQL + '    AND FD2.FDO_CODITE = RCD_CODITE ';
      strSQL := strSQL + '  ) ';
      strSQL := strSQL + 'LEFT JOIN EXTGOR ';
      strSQL := strSQL + '  ON EXTGOR.FGO_SEQFGO = IFNULL(FD1.FDO_SEQGER, FD2.FDO_SEQGER) ';
      strSQL := strSQL + 'LEFT JOIN EQUGER ';
      strSQL := strSQL + '  ON ( ';
      strSQL := strSQL + '    EQU_EMPPED = RCD_EMPPDV ';
      strSQL := strSQL + '    AND EQU_TIPPED = RCD_ESPPDV ';
      strSQL := strSQL + '    AND EQU_NUMPED = RCD_DOCPDV ';
      strSQL := strSQL + '  ) ';
      strSQL := strSQL + 'LEFT JOIN EQUGOR ';
      strSQL := strSQL + '  ON EXTGOR.FGO_SEQFGO = EQUGOR.FGO_SEQFGO ';
      strSQL := strSQL + 'LEFT JOIN EQUGER EQ ';
      strSQL := strSQL + '  ON EQ.AUTOINCREM = EQUGOR.FGO_SEQEQU ) AS REQ ';

      strGroupBy := 'GROUP BY RCG_CODIGO, RCG_CODEMP, EQU_NUMOSE, EQU_CODEMP';

      qryConsulta := fCriaQuery(Nil);
      Try
        If fConsultaConfig([strSQL, fSQLWhere(True), strGroupBy],
                     arrTitCol,
                     ['CLI_NOMCLI','RCG_CODCLI','RCG_CODIGO'],
                     'AUTOINCREM',
                     'MOVRCG',
                     Self.Name,
                     strTitulo,
                     qryConsulta,
                     nil,
                     True,
                     arrSel,
                     'AUTOINCREM',
                     fSQLWhere(False),
                     '',
                     False,
                     objConsulta) Then
        Begin
          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('RCG_CODIGO').AsString
            Else
              edtCodigo.Text := qryConsulta.FieldByName('RCG_CODIGO').AsString;
          End;

          If (Length(arrSel) > 1) Then
          Begin

            If Assigned(edtCodigo) then
            Begin
              If (edtCodigo Is TMaskEditFocus) Then
                (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
              Else
                edtCodigo.Text := fStrZero('0', 8);
            End;

          End;

          Result := True;
        End;
      Finally
        FreeAndNil(qryConsulta);
      End;

      edtCodigo.Text := fTiraCaracEspeciais(edtCodigo.Text);

      FreeAndNil(objConsulta);

    Except

      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;

    End;

  End;

End;

