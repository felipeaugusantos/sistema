                          Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                          blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                          strCodNcm: String = '';
                          strCodExc: String = ''): Boolean;


  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT              ';
      strSQL := strSQL + '  ABF_CODABF,       ';
      strSQL := strSQL + '  ABF_DESABF,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM (              ';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  ABF_CODABF,       ';
      strSQL := strSQL + '  ABF_DESABF,       ';
      strSQL := strSQL + '  ABFICM.AUTOINCREM ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  ABFICM            ';

      If (Not fEmptyStr(strCodNcm)) And fTemAbreviacaoIcmsVinculadaAoNCM(strCodNcm, strCodExc) Then
        strSQL := strSQL + '  INNER JOIN NCMICM ON NCM_CODABF = ABF_CODABF AND NCM_CODNCM = "' + strCodNcm + '" AND NCM_CODEXC = "' + strCodExc + '" ';

      strSQL := strSQL + 'GROUP BY            ';
      strSQL := strSQL + '  ABF_CODABF )      ';
      strSQL := strSQL + 'AS ABFICM           ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL],
                  ['Código',
                   'Descrição',
                   'AUTOINCREM'],
                   ['ABF_DESABF','ABF_CODABF'],
                   '',
                   'ABFICM',
                   Self.Name,
                   'Consulta de Abreviações Fiscais',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'ABF_CODABF') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('ABF_CODABF').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('ABF_CODABF').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('ABF_DESABF').AsString;

        If (Length(arrSel) > 1) Then
        Begin

