      objConsulta.pIncluiCampoSimNao('SEPIMP');

      strSQL := '';
      strSQL := strSQL + 'SELECT DISTINCT                                       ';
      strSQL := strSQL + '   NUMLOT,                                            '; pAddNomeColuna('Nro.Lote');
      strSQL := strSQL + '   DESLOT,                                            '; pAddNomeColuna('Descr.Lote');
      strSQL := strSQL + '   DTAENT,                                            '; pAddNomeColuna('Data');
      strSQL := strSQL + '   NUMDOC,                                            '; pAddNomeColuna('Documento');
      strSQL := strSQL + '   ESPDOC,                                            '; pAddNomeColuna('Espécie');
      strSQL := strSQL + '   CODEMP,                                            '; pAddNomeColuna('Empresa');
      strSQL := strSQL + '   CLIENTE,                                           '; pAddNomeColuna('Cliente');
