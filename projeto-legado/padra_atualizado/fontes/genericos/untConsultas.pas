{*****************************}
{* CONSULTA DE BOCA DE CAIXA *}
{**************************JU*}
function fPesqBocaCx(Self       : TForm;                                    {* Formulário                                  *}
                     qryConBcaCx: TUniQuery;                                {* Query                                       *}
                     Var chrKey : Char;                                     {* Key                                         *}
                     Var arrSel : TConsultasArray;                          {* Array de Consulta                           *}
                     blnConSim  : Boolean = True;                           {* Consulta Simples ou Múltipla (multi select) *}
                     strTitulo  : String  = 'Consulta de Boca de Caixa'): Boolean;
  Var
    arrTitCol  : TColunasArray;                                             {* Títulos das Colunas                         *}
    strSQL     : String;
    qryConsulta: TUniQuery;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND C.ITE_ITEATI = "S"';

    Result := strWhere;
  End;
Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin

    chrKey := #0;

    Try

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  B.BCA_CODEMP, '; pAddNomeColuna('Empresa');
      strSQL := strSQL + '  C.ITE_CODGRU, '; pAddNomeColuna('Grupo');
      strSQL := strSQL + '  B.BCA_CODITE, '; pAddNomeColuna('Código');
      strSQL := strSQL + '  C.ITE_DESITE, '; pAddNomeColuna('Descrição');
      strSQL := strSQL + '  U.UNI_SIGUNI, '; pAddNomeColuna('Unid.');
      strSQL := strSQL + '  I.ITE_PRECUS, '; pAddNomeColuna('Pr. Custo');
      strSQL := strSQL + '  I.ITE_PREVE1, '; pAddNomeColuna('Pr. Venda');
      strSQL := strSQL + '  B.BCA_PREMIN, '; pAddNomeColuna('Pr. Mínimo');
