function fPesqLocFisica(Self     : TForm;                    {* Formulário                                  *}
                        edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                        edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                        qryTabela: TUniQuery;                {* Query                                       *}
                        Var chrKey: Char;                    {* Key                                         *}
                        Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                        blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                        blnSoPickin : Boolean = False;
                        blnSoPulmao : Boolean = False;
                        blnLocTransi: Boolean = False;
                        blnMovimentacaoProgramada: Boolean = False;
                        strCodIte: String = '';
                        blnApenasSemEnderecamento: Boolean = False;
                        AstrCodEmp: String = '';
                        blnFiltraLocAtivo: Boolean = False;
                        blnSemLocCritico: Boolean = False): Boolean;
  Const
    SQL_JOIN_ARMAZEM = ' LEFT JOIN CADAMZ A ON A.AMZ_CODAMZ = L.LOC_CODAMZ AND A.AMZ_CODEMP = L.LOC_CODEMP ';

  Var
    strTitulo,
    strSQL,
    strGroupBy,
    strWhere: String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrTitCol  : TColunasArray; {* Títulos das Colunas  *}
    blnArmazem : Boolean;
    arrPesq: Array of String;

    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;

    objLoadSql: TLoadConsultaSQL;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean = True): String;
    Var
      strWhere: String;
  Begin
       strWhere := '';

    If blnCompleto Then
      strWhere := strWhere + ' WHERE TRUE ';

    strWhere := strWhere + ' AND L.LOC_CODEMP = ' + QuotedStr(ifThen(fEmptyStr(AstrCodEmp), VS_strCodEmp, AstrCodEmp));

    If blnSoPickin Then
      strWhere := strWhere + '  AND L.LOC_PICKIN = "S" ';

    If blnSoPulmao Then
      strWhere := strWhere + '  AND L.LOC_PICKIN = "N" ';

    If blnLocTransi Then
      strWhere := strWhere + '  AND LOC_TRANSI = "S" ';

    If blnSemLocCritico then
      strWhere := strWhere + '  AND  IFNULL(LOC_CRITIC, "N") = "N" ';

    If blnApenasSemEnderecamento Then
    Begin
      strWhere := strWhere + '  AND LOC_CODLOC NOT IN  ';
      strWhere := strWhere + '    (SELECT AIL_LOCFIS FROM AGEILO WHERE AIL_ENDERE = "S") ';
      If fCfgSis('MODCUB') = '2' Then
      Begin
        strWhere := strWhere + ' AND (SELECT COUNT(1) FROM ETIREC ';
        strWhere := strWhere + '       WHERE ETI_CODEMP = ' + QuotedStr(VS_strCodEmp);
        strWhere := strWhere + '         AND ETI_LOCFIS = LOC_CODLOC ) = 0 ';
      End;
      strWhere := strWhere + '  AND IFNULL(LOT_SALDOS, 0) = 0 ';
      strWhere := strWhere + '  AND (SELECT COUNT(1) FROM CADLOT ';
      strWhere := strWhere + '        WHERE LOT_LOCFIS = L.LOC_CODLOC ';
      strWhere := strWhere + '        AND LOT_SALDOS > 0          ';
      strWhere := strWhere + '        AND LOT_CODEMP = ' + QuotedStr(VS_strCodEmp) + ') = 0 ';
    End;

    If blnMovimentacaoProgramada Or blnFiltraLocAtivo  then
      strWhere := strWhere + '  AND LOC_ATIVO_ = "S" ';
{    If blnMovimentacaoProgramada then
    begin
      if fCfgSis('LOTPIC', varBoolean) then
        strWhere := strWhere + '        AND LOC_PICKIN = "S" AND LOT_CODITE = "' + strCodIte + '" '
      else
        strWhere := strWhere + '        AND IF(LOC_PICKIN = "S", LOT_CODITE = "' + strCodIte + '", TRUE)';
    End;}

    Result := strWhere;
  End;

  Procedure pConsultaAntiga;
  Begin
    SetLength(arrTitCol, 0);

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  L.LOC_CODLOC,       '; pAddNomeColuna('Código');
    strSQL := strSQL + '  L.LOC_DESCRI,       '; pAddNomeColuna('Descrição');

    strSQL := strSQL + '  CLADEFINIDA,        '; pAddNomeColuna('Já associada a classe');

    objConsulta.pIncluiSubConsulta('CLADEFINIDA', 'CASE ' +
                                             '   WHEN  (SELECT COUNT(1)  FROM CLALOC WHERE CLL_CODLOC = LOC_CODLOC  AND CLL_CODEMP = LOC_CODEMP ) > 0 THEN "SIM"' +
                                             '   WHEN  (SELECT COUNT(1)  FROM CLALOC WHERE CLL_CODLOC = LOC_CODLOC  AND CLL_CODEMP = LOC_CODEMP ) = 0 THEN "NÃO"' +
                                             'END');
    objConsulta.pIncluiCampoSimNao('CLADEFINIDA');
    If fUsaRotinaWMS then
    Begin
      strSQL := strSQL + '  L.LOC_R_U_A_,       '; pAddNomeColuna('Rua');
      strSQL := strSQL + '  L.LOC_PREDIO,       '; pAddNomeColuna('Prédio');
      strSQL := strSQL + '  L.LOC_ANDAR_,       '; pAddNomeColuna('Andar');
      strSQL := strSQL + '  L.LOC_APARTA,       '; pAddNomeColuna('Apartamento');
      strSQL := strSQL + '  L.LOC_LARGUR,       '; pAddNomeColuna('Largura');
      strSQL := strSQL + '  L.LOC_ALTURA,       '; pAddNomeColuna('Altura');
      strSQL := strSQL + '  L.LOC_PROFUN,       '; pAddNomeColuna('Prof');
      strSQL := strSQL + '  L.LOC_PESMAX,       '; pAddNomeColuna('Peso Máx.');

      strSQL := strSQL + '  PICKINSN,             '; pAddNomeColuna('Picking');
      objConsulta.pIncluiSubConsulta('PICKINSN', 'CASE WHEN L.LOC_PICKIN = "S" THEN "SIM" ELSE "NÃO" END');
      objConsulta.pIncluiCampoSimNao('PICKINSN');

      strSQL := strSQL + '  BUFFERSN,             '; pAddNomeColuna('Buffer');
      objConsulta.pIncluiSubConsulta('BUFFERSN', 'CASE WHEN L.LOC_PICKIN = "N" THEN "SIM" ELSE "NÃO" END');
      objConsulta.pIncluiCampoSimNao('BUFFERSN');
    End;

    If fUsaPickingLaboratorioWms Then
    Begin
      strSQL := strSQL + '  PICLABSN,             '; pAddNomeColuna('Picking Laboratório');
      objConsulta.pIncluiSubConsulta('PICLABSN', 'IF(L.LOC_PICKIN = "S" AND L.LOC_PRILAB = "S", "SIM", "NÃO")');
      objConsulta.pIncluiCampoSimNao('PICLABSN');
    End;

    If blnArmazem Then
    Begin
      strSQL := strSQL + '  ARMAZEM,        '; pAddNomeColuna('Armazém');
    End;

    strSQL := strSQL + '  L.AUTOINCREM ';

      strSQL := strSQL + 'FROM                ';
    strSQL := strSQL + '  CADLOC L          ';
    If blnMovimentacaoProgramada Or blnApenasSemEnderecamento Then
      strSQL := strSQL + '  LEFT JOIN CADLOT ON LOT_LOCFIS = L.LOC_CODLOC AND LOT_CODEMP = L.LOC_CODEMP ';

    If blnArmazem Then
      strSQL := strSQL + SQL_JOIN_ARMAZEM;

    strWhere := fSQLWhere;

      If blnArmazem Then
      begin
      objConsulta.pIncluiSubConsulta('ARMAZEM', 'CONCAT(L.LOC_CODAMZ, "-", A.AMZ_DESCRI)');

        SetLength(arrPesq, 4);
        arrPesq[0] := 'LOC_DESCRI';
        arrPesq[1] := 'ARMAZEM';
        arrPesq[2] := 'LOC_CODLOC';
      end
      else
      begin
        SetLength(arrPesq, 3);
        arrPesq[0] := 'LOC_DESCRI';
        arrPesq[1] := 'LOC_CODLOC';
      end;
    If blnMovimentacaoProgramada Or blnApenasSemEnderecamento Then
      strGroupBy := ' GROUP BY LOC_CODLOC ';
    arrSQLConsulta    := [strSQL, strWhere, strGroupBy];
    arrCamposConsulta := arrTitCol;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin
    If blnArmazem Then
    Begin
      objLoadSql.stlJoins.Add(SQL_JOIN_ARMAZEM);
      objConsulta.pAdicionaTabela('CADAMZ', 'A');
      objLoadSql.fIncluiSubConsulta('ARMAZEM', 'CONCAT(L.LOC_CODAMZ, "-", A.AMZ_DESCRI)', 'Armazém');
    End;

    If fUsaRotinaWMS Then
    Begin
      objConsulta.pIncluiCampoSimNao('PICKINSN');
      objConsulta.pIncluiCampoSimNao('BUFFERSN');
    End;

    If fUsaPickingLaboratorioWms Then
      objConsulta.pIncluiCampoSimNao('PICLABSN');

    objConsulta.pAdicionaTabela('CADLOC', 'L');

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));

    objLoadSQL.pCarregaDadosConsulta;

    arrSQLConsulta    := objLoadSQL.arrSQL;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      blnArmazem := (fCfgSis('CTLEST') = '2');

      objConsulta := TDefConsulta.Create;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      strTitulo := 'Consulta de Localizações Físicas';

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin

        pTrataConsultaConfigurada;
        objConsulta.pIncluiCampoSimNao('FILTROSAL', ['Maior que zero', 'Menor ou igual a zero', 'TODOS']);

      End Else
      Begin

        pConsultaAntiga;

      End;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   arrPesq,
                   '',
                   'CADLOC',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'LOC_CODLOC',
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('LOC_CODLOC').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('LOC_CODLOC').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('LOC_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 10)
            Else
              edtCodigo.Text := fStrZero('0', 10);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

      FreeAndNil(objLoadSQL);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqLocFisicaMapeamento(Self     : TForm;          {* Formulário                                  *}
                        edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                        edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                        qryTabela: TUniQuery;                {* Query                                       *}
                        Var chrKey: Char;                    {* Key                                         *}
                        Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                        strCodite: String;                   {* Código do item                              *}
                        blnConSim: Boolean = True):Boolean;  {* Consulta Simples ou Múltipla (multi select) *}
  Const
    SQL_JOIN_ARMAZEM = ' LEFT JOIN CADAMZ A ON A.AMZ_CODAMZ = L.LOC_CODAMZ AND A.AMZ_CODEMP = L.LOC_CODEMP ';

  Var
    strTitulo,
    strSQL,
    strGroupBy,
    strWhere: String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrTitCol  : TColunasArray; {* Títulos das Colunas  *}
    //blnArmazem : Boolean;
    arrPesq: Array of String;

    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;

    objLoadSql: TLoadConsultaSQL;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Procedure pConsultaAntiga;
  Begin
    SetLength(arrTitCol, 0);

    strSQL := '';
    strSQL := strSQL + '   SELECT                                                          ';
    strSQL := strSQL + '     SQL_NO_CACHE                                                  ';
    strSQL := strSQL + '     LOC_CODLOC,                                                   ';   pAddNomeColuna('Código');
    strSQL := strSQL + '     LOC_DESCRI,                                                   ';   pAddNomeColuna('Descrição');
    strSQL := strSQL + '     LOC_R_U_A_,                                                   ';   pAddNomeColuna('Rua');
    strSQL := strSQL + '     LOC_PREDIO,                                                   ';   pAddNomeColuna('Prédio');
    strSQL := strSQL + '     LOC_ANDAR_,                                                   ';   pAddNomeColuna('Andar');
    strSQL := strSQL + '     LOC_APARTA,                                                   ';   pAddNomeColuna('Apartamento');
    strSQL := strSQL + '     LOC_LARGUR,                                                   ';   pAddNomeColuna('Largura');
    strSQL := strSQL + '     LOC_ALTURA,                                                   ';   pAddNomeColuna('Altura');
    strSQL := strSQL + '     LOC_PROFUN,                                                   ';   pAddNomeColuna('Profundidade');
    strSQL := strSQL + '     LOC_PESMAX,                                                   ';   pAddNomeColuna('Peso Máx.');
    strSQL := strSQL + '     COM_PRODUTO,                                                  ';   pAddNomeColuna('Mapeada?');  objConsulta.pIncluiCampoSimNao('COM_PRODUTO');
    strSQL := strSQL + '     LOC_PDERDP,                                                   ';   pAddNomeColuna('Permite mapear produtos diferentes?');  objConsulta.pIncluiCampoSimNao('LOC_PDERDP');
    //strSQL := strSQL + '   CHAVE,                                                       ';
    strSQL := strSQL + '     LOC_ITEPIC,                                                   ';   pAddNomeColuna('Item picking da localização');
    strSQL := strSQL + '     LCI_CODITE,                                                   ';   pAddNomeColuna('Item mapeado');
    strSQL := strSQL + '     AUTOINCREM                                                    ';
    strSQL := strSQL + '   FROM ';
    strSQL := strSQL + '     (  ';
    strSQL := strSQL + '   /*LOC. FISICAS QUE NÃO PERMITEM PROD. DIFERENTES E ESTÃO VAZIAS ( SEM MAPEAMENTO )*/';
    strSQL := strSQL + '     SELECT';
    strSQL := strSQL + '       LOC_CODLOC,';
    strSQL := strSQL + '       LOC_DESCRI,';
    strSQL := strSQL + '       LOC_R_U_A_,';
    strSQL := strSQL + '       LOC_PREDIO,';
    strSQL := strSQL + '       LOC_ANDAR_,';
    strSQL := strSQL + '       LOC_APARTA,';
    strSQL := strSQL + '       LOC_LARGUR,';
    strSQL := strSQL + '       LOC_ALTURA,';
    strSQL := strSQL + '       LOC_PROFUN,';
    strSQL := strSQL + '       IFNULL(LOC_ITEPIC, "") AS LOC_ITEPIC,';
    strSQL := strSQL + '       IFNULL(LOC_PESMAX, 0) AS LOC_PESMAX,';
    strSQL := strSQL + '       CAST("NÃO" AS CHAR (3)) AS COM_PRODUTO,';
    strSQL := strSQL + '       IF(LOC_PDERPD = "S", "SIM", "NÃO") AS LOC_PDERDP,';
    //strSQL := strSQL + '       CAST("LOC. FISICAS QUE NÃO PERMITEM PROD. DIFERENTES E ESTÃO VAZIAS ( SEM MAPEAMENTO )" AS CHAR(100)) AS CHAVE,';
    strSQL := strSQL + '       IFNULL(LOC_ITEPIC,"") AS LOT_ITEPIC,';
    strSQL := strSQL + '       CAST("" AS CHAR(1)) AS LCI_CODITE, ';
    strSQL := strSQL + '       CADLOC.AUTOINCREM';
    strSQL := strSQL + '     FROM';
    strSQL := strSQL + '       CADLOC';
    strSQL := strSQL + '     WHERE LOC_PICKIN = "S"';
    strSQL := strSQL + '       AND LOC_PDERPD = "N"';
    strSQL := strSQL + '       AND CADLOC.AUTOINCREM NOT IN';
    strSQL := strSQL + '       (SELECT LCI_LOCFIS FROM LOCITE WHERE LCI_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' AND LCI_CODITE = CADLOC.LOC_ITEPIC)';
    strSQL := strSQL + '   /*LOC. FISICAS QUE NÃO PERMITEM PROD. DIFERENTES E SEU ITEM PICKING ESTÁ MAPEADO*/';
    strSQL := strSQL + '         UNION';
    strSQL := strSQL + '         ALL';
    strSQL := strSQL + '         SELECT';
    strSQL := strSQL + '           LOC_CODLOC,';
    strSQL := strSQL + '           LOC_DESCRI,';
    strSQL := strSQL + '           LOC_R_U_A_,';
    strSQL := strSQL + '           LOC_PREDIO,';
    strSQL := strSQL + '           LOC_ANDAR_,';
    strSQL := strSQL + '           LOC_APARTA,';
    strSQL := strSQL + '           LOC_LARGUR,';
    strSQL := strSQL + '           LOC_ALTURA,';
    strSQL := strSQL + '           LOC_PROFUN,';
    strSQL := strSQL + '           IFNULL(LOC_ITEPIC, "") AS LOC_ITEPIC,';
    strSQL := strSQL + '           IFNULL(LOC_PESMAX, 0) AS LOC_PESMAX,';
    strSQL := strSQL + '           CAST("SIM" AS CHAR (3)) AS COM_PRODUTO,';
    strSQL := strSQL + '           IF(LOC_PDERPD = "S", "SIM", "NÃO") AS LOC_PDERDP,';
    //strSQL := strSQL + '           CAST("LOC. FISICAS QUE NÃO PERMITEM PROD. DIFERENTES E SEU ITEM PICKING ESTÁ MAPEADO" AS CHAR(100)) AS CHAVE,';
    strSQL := strSQL + '           IFNULL(LOC_ITEPIC,"") AS LOT_ITEPIC,';
    strSQL := strSQL + '           (SELECT LCI_CODITE FROM LOCITE WHERE LCI_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' AND LCI_LOCFIS = CADLOC.AUTOINCREM LIMIT 1) AS LCI_CODITE, ';
    strSQL := strSQL + '           CADLOC.AUTOINCREM';
    strSQL := strSQL + '       FROM';
    strSQL := strSQL + '         CADLOC';
    strSQL := strSQL + '       WHERE LOC_PICKIN = "S"';
    strSQL := strSQL + '         AND LOC_PDERPD = "N"';
    strSQL := strSQL + '         AND CADLOC.AUTOINCREM IN ';
    strSQL := strSQL + '         (SELECT LCI_LOCFIS FROM LOCITE WHERE LCI_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' AND LCI_CODITE = CADLOC.LOC_ITEPIC AND CADLOC.LOC_ITEPIC = ' + QuotedStr(strCodIte) + ') ';
    strSQL := strSQL + '    /*LOC. FISICAS QUE PERMITEM PROD. DIFERENTES*/';
    strSQL := strSQL + '        UNION';
    strSQL := strSQL + '        ALL';
    strSQL := strSQL + '        SELECT';
    strSQL := strSQL + '         LOC_CODLOC,';
    strSQL := strSQL + '         LOC_DESCRI,';
    strSQL := strSQL + '         LOC_R_U_A_,';
    strSQL := strSQL + '         LOC_PREDIO,';
    strSQL := strSQL + '         LOC_ANDAR_,';
    strSQL := strSQL + '         LOC_APARTA,';
    strSQL := strSQL + '         LOC_LARGUR,';
    strSQL := strSQL + '         LOC_ALTURA,';
    strSQL := strSQL + '         LOC_PROFUN,';
    strSQL := strSQL + '         IFNULL(LOC_ITEPIC, "") AS LOC_ITEPIC, ';
    strSQL := strSQL + '         IFNULL(LOC_PESMAX, 0) AS LOC_PESMAX,  ';
    strSQL := strSQL + '         IF((SELECT COUNT(1) FROM LOCITE WHERE LCI_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' AND LCI_LOCFIS = CADLOC.AUTOINCREM) > 0, "SIM", "NÃO") AS COM_PRODUTO, ';
    strSQL := strSQL + '         IF(LOC_PDERPD = "S", "SIM", "NÃO") AS LOC_PDERDP, ';
    //strSQL := strSQL + '         CAST("LOC. FISICAS QUE PERMITEM PROD. DIFERENTES" AS CHAR(100)) AS CHAVE, ';
    strSQL := strSQL + '         IFNULL(LOC_ITEPIC,"") AS LOC_ITEPIC,';
    strSQL := strSQL + '         (SELECT LCI_CODITE FROM LOCITE WHERE LCI_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' AND LCI_LOCFIS = CADLOC.AUTOINCREM LIMIT 1) AS LCI_CODITE, ';
    strSQL := strSQL + '         CADLOC.AUTOINCREM ';
    strSQL := strSQL + '        FROM';
    strSQL := strSQL + '          CADLOC';
    strSQL := strSQL + '        WHERE LOC_PICKIN = "S"';
    strSQL := strSQL + '          AND LOC_PDERPD = "S"';
    strSQL := strSQL + '        ) LOC  ';
    //If blnArmazem Then
    //  strSQL := strSQL + SQL_JOIN_ARMAZEM;

    strWhere := 'WHERE TRUE AND ((LOC_PDERDP = "SIM" OR ( LOC_PDERDP = "NÃO" AND LOC_ITEPIC = ' + QuotedStr(strCodIte) + ')) OR (COM_PRODUTO = "NÃO" AND LOC_ITEPIC = ' + QuotedStr(strCodIte) + ') ' + ' OR (LOC_PDERDP = "NÃO" AND COM_PRODUTO = "NÃO")' +')';
    strWhere := strWhere + fSqlExcecaoLocFisicaMapeamento;
    SetLength(arrPesq, 3);
    arrPesq[0] := 'LOC_DESCRI';
    arrPesq[1] := 'LOC_CODLOC';

    arrSQLConsulta    := [strSQL, strWhere, strGroupBy];
    arrCamposConsulta := arrTitCol;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin
    //objConsulta.pAdicionaTabela('CADLOC', 'L');

    //objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));

