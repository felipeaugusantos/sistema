begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + ' SELECT                                       ';
      strSQL := strSQL + '    PDS_CODCLI,                               ';
