function fPesqRemessaDeSeparacao(Self          : TForm;                    {* Formulário                                  *}
                                 edtCodigo     : TEdit;                    {* Edit do Código                              *}
                                 qryTabela     : TUniQuery;                {* Query                                       *}
                                 Var chrKey    : Char;                     {* Key                                         *}
                                 Var arrSel    : TConsultasArray;          {* Array de Seleção                            *}
                                 blnConSim     : Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                                 blnSomenteNaoFinalizadas: Boolean = False): Boolean; {* Somente remessas não finalizadas *}
Var
  strSQL, strWhere, strGroup: String;
  qryConsulta: TUniQuery;
  objConsulta: TDefConsulta;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + ' SELECT FGO_SEQOND, ';
      strSQL := strSQL + '        FGO_DTAOND, ';
      strSQL := strSQL + '        TMP_TIPPED, ';
      strSQL := strSQL + '        TMP_VENDED, ';
      strSQL := strSQL + '        TMP_QTDITE, ';
      strSQL := strSQL + '        TMP_STATUS  ';
      strSQL := strSQL + ' FROM ( ';
      strSQL := strSQL + '   SELECT FGO_SEQOND, ';
      strSQL := strSQL + '          FGO_CODVEN, ';
      strSQL := strSQL + '          FGO_SEQFGO, ';
      strSQL := strSQL + '          FGO_DTAOND, ';
      strSQL := strSQL + '          IFNULL(FGO_ONDUNI,"N") AS FGO_ONDUNI, ';
      strSQL := strSQL + '          IFNULL(FGO_ONDKIT,"N") AS FGO_ONDKIT, ';
      strSQL := strSQL + '          (SELECT COUNT(1) FROM ONDSEP WHERE OND_SEQOND = FGO_SEQOND) AS QTD_ONDSEP, ';
      strSQL := strSQL + '          (SELECT COUNT(1) FROM ONDSEP WHERE OND_SEQOND = FGO_SEQOND AND OND_STATUS = "F") AS QTD_FINALI, ';
      strSQL := strSQL + '          (SELECT COUNT(1) FROM ONDSEP WHERE OND_SEQOND = FGO_SEQOND AND OND_STATUS = "S") AS QTD_SEPARA  ';
      strSQL := strSQL + '    FROM FATGOR ';
      strSQL := strSQL + '   INNER JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM ';
      strSQL := strSQL + '   WHERE IFNULL(FGO_SEQOND,"") <> "" ';
      strSQL := strSQL + '     AND FGO_ESPDOC = "PD" ';
      strSQL := strSQL + '     AND FGO_JAFATU = 0 ';
      strSQL := strSQL + '     AND FGO_EMPEXP = '+ QuotedStr(VS_strCodEmp);
      strSQL := strSQL + '   UNION ALL ';
      strSQL := strSQL + '   SELECT FGO_SEQOND, ';
      strSQL := strSQL + '          FGO_CODVEN, ';
      strSQL := strSQL + '          FGO_SEQFGO, ';
      strSQL := strSQL + '          FGO_DTAOND, ';
      strSQL := strSQL + '          IFNULL(FGO_ONDUNI,"N") AS FGO_ONDUNI, ';
      strSQL := strSQL + '          IFNULL(FGO_ONDKIT,"N") AS FGO_ONDKIT, ';
      strSQL := strSQL + '          (SELECT COUNT(1) FROM ONDSEP WHERE OND_SEQOND = FGO_SEQOND) AS QTD_ONDSEP, ';
      strSQL := strSQL + '          (SELECT COUNT(1) FROM ONDSEP WHERE OND_SEQOND = FGO_SEQOND AND OND_STATUS = "F") AS QTD_FINALI, ';
      strSQL := strSQL + '          (SELECT COUNT(1) FROM ONDSEP WHERE OND_SEQOND = FGO_SEQOND AND OND_STATUS = "S") AS QTD_SEPARA  ';
      strSQL := strSQL + '    FROM FATGOR ';
      strSQL := strSQL + '   INNER JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM ';
      strSQL := strSQL + '   INNER JOIN FATAUT ON FAT_NUMDOC = FGO_NUMDOC AND FAT_ESPDOC = FGO_ESPDOC AND FAT_EMPDOC = FGO_CODEMP ';
      strSQL := strSQL + '   WHERE IFNULL(FGO_SEQOND,"") <> "" ';
      strSQL := strSQL + '     AND FGO_EMPEXP = '+ QuotedStr(VS_strCodEmp);
      strSQL := strSQL + '     AND FAT_ESPDOC = "PD" ';
      strSQL := strSQL + '     AND FAT_NUMFAT IS NOT NULL ';
      strSQL := strSQL + '     AND FAT_DTLBEX IS NULL ';
      strSQL := strSQL + ' ) AS TMP';

      strWhere := 'WHERE TRUE';

      If blnSomenteNaoFinalizadas Then
        strWhere := strWhere + ' AND QTD_FINALI < QTD_ONDSEP';

      strGroup := 'GROUP BY FGO_SEQOND';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('TMP_TIPPED',
                                     'CASE WHEN FGO_ONDUNI = "S" THEN "Unitários" '+
                                     '     WHEN FGO_ONDKIT = "S" THEN "Kits" '+
                                     '     ELSE "Carrinhos" END');
      objConsulta.pIncluiCampoSimNao('TMP_TIPPED', ['Unitários', 'Kits', 'Carrinhos']);

      objConsulta.pIncluiSubConsulta('TMP_STATUS',
                                     'CASE WHEN QTD_ONDSEP = QTD_FINALI THEN "Finalizado" '+
                                     '     WHEN QTD_SEPARA > 0 THEN "Separando" '+
                                     '     ELSE "Aguardando Separação" END');
      If blnSomenteNaoFinalizadas Then
        objConsulta.pIncluiCampoSimNao('TMP_STATUS', ['Aguardando Separação', 'Separando'])
      Else
        objConsulta.pIncluiCampoSimNao('TMP_STATUS', ['Aguardando Separação', 'Separando', 'Finalizado']);

      objConsulta.pIncluiSubConsulta('TMP_VENDED', '(SELECT GROUP_CONCAT(DISTINCT OPE_NOMOPE SEPARATOR ", ") FROM CADOPE WHERE OPE_CODOPE = FGO_CODVEN)');
      objConsulta.pIncluiSubConsulta('TMP_QTDITE', '(SELECT SUM(FDO_QTDITE) FROM FATDOR WHERE FDO_SEQGER = FGO_SEQFGO)');

      Result :=
        fConsultaConfig(
           [strSQL, strWhere, strGroup],
           ['N° Remessa de Separação',
            'Data de Geração',
            'Tipo de Pedido',
            'Vendedor',
            'Qtde. Itens',
            'Status'],
           ['FGO_SEQOND'],
            'FGO_SEQOND',
            'EXTGOR',
            Self.Name,
            'Consulta de Remessa de Separação',
            qryConsulta,
            Nil,
            blnConSim,
            arrSel,
            'FGO_SEQOND',
            '',
            '',
            False,
            objConsulta);

      If Result Then
      Begin
        If Assigned(edtCodigo) then
          If Length(arrSel) > 1 Then
            edtCodigo.Text := fStrZero('0', edtCodigo.MaxLength)
          Else
            edtCodigo.Text := qryConsulta.FieldByName('FGO_SEQOND').AsString;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '');
    End;
  end;
end;

function fPesqLocFisConsertoEquip(Self      : TForm;                         {* Formulário                                  *}
                                  edtCodigo : TCustomEdit;                   {* Edit do Código                              *}
                                  edtDescri : TEditFocus;                    {* Edit da Descrição                           *}
                                  qryTabela : TUniQuery;                     {* Query                                       *}
                                  Var chrKey: Char;                          {* Key                                         *}
                                  Var arrSel: TConsultasArray;               {* Array de Seleção                            *}
                                  blnConSim : Boolean = True;                {* Consulta Simples ou Múltipla (multi select) *}
                                  objFrmPnl : TPanelCx = Nil): Boolean;      {* Painel}
var
  strSQL     : String;
  strWhere   : String;
  qryConsulta: TUniQuery;
begin
  Result := False;

  if fEntraCons(chrKey) then
  begin
    try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  LEQ_CODLOC,       ';
      strSQL := strSQL + '  LEQ_DESCRI,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADLEQ            ';

      strWhere := ' WHERE LEQ_CODEMP = ' + QuotedStr(VS_strCodEmp);

      if (not Assigned(qryTabela)) then
        qryConsulta := fCriaQuery(Nil)
      else
        qryConsulta := qryTabela;

      if fConsultaConfig([strSQL, strWhere],
                   ['Código',
                    'Descrição'],
                   ['LEQ_CODLOC', 'LEQ_DESCRI'],
                   '',
                   'CADLEQ',
                   Self.Name,
                   'Consulta de Localizações Físicas - Conserto de Equipamentos',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel) then
      begin
        if Assigned(edtCodigo) then
        begin
          if (edtCodigo is TMaskEditFocus) then
            (edtCodigo as TMaskEditFocus).Text := qryConsulta.FieldByName('LEQ_CODLOC').AsString
          else
            edtCodigo.Text := qryConsulta.FieldByName('LEQ_CODLOC').AsString;
        end;

        if Assigned(edtDescri) then
          edtDescri.Text := qryConsulta.FieldByName('LEQ_DESCRI').AsString;

        if (Length(arrSel) > 1) then
        begin
          if Assigned(edtDescri) then
            edtDescri.Text := '+1';
        end;

        Result := True;

        if (not Assigned(qryTabela)) then
          FreeAndNil(qryConsulta);
      end;
    except
      on E: Exception do
      begin
        pMensagensErro(E.Message, '');
      end;
    End;
  end;
end;

