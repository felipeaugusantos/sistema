function fPesqRemessaDevolucao(Self     : TForm;                    {* Formulário                                  *}
                               edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                               qryTabela: TUniQuery;                {* Query                                       *}
                               Var chrKey: Char;                    {* Key                                         *}
                               Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                               tipTipOpe:  TTipoOperacaoRemessa = toTodos; {* Operações da Remessa                        *}
                               blnConSim: Boolean = True): Boolean; {* Consulta Simples ou Múltipla (multi select) *}
Var
  strSQL, strWhere : String;
  qryConsulta: TUniQuery;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT R.RMV_DTACAD, R.RMV_HORCAD, R.RMV_NUMREM, R.RMV_EMPREM, R.RMV_NUMDOC, ';
      strSQL := strSQL + '       R.RMV_ESPDOC, R.RMV_CODITE, C.ITE_DESITE, R.RMV_QTDITE, R.RMV_TIPOPE, ';
      strSQL := strSQL + '       R.RMV_CODDIG, R.RMV_CODEMP, R.RMV_LIBCOL, R.AUTOINCREM ';
      strSQL := strSQL + 'FROM REMDEV R ';
      strSQL := strSQL + 'INNER JOIN CADITE C ';
      strSQL := strSQL + 'ON(R.RMV_CODITE = C.ITE_CODITE) ';

      strWhere := 'WHERE R.RMV_EMPREM = '+QuotedStr(VS_strCodEmp)+' ';

      case tipTipOpe of
        toTransferencia: strWhere := strWhere + ' AND R.RMV_TIPOPE = "REM_TRA" AND R.RMV_AUTTRA IS NULL ';
        toOutrasSaidas: strWhere := strWhere + ' AND R.RMV_TIPOPE = "REM_OUF" AND R.RMV_AUTOUF IS NULL ';
      end;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, strWhere],
                  ['Data',
                   'Hora',
                   'Número da Remessa',
                   'Empresa',
                   'Número da Devolução',
                   'Espécie da Devolução',
                   'Cód. Item',
                   'Descrição Item',
                   'Quantidade',
                   'Tipo de Operação',
                   'Operador',
                   'Empresa da Devolução',
                   'Liberação para Coletor'],
                   ['RMV_DTACAD',
                    'RMV_HORCAD',
                    'RMV_NUMREM',
                    'RMV_EMPREM',
                    'RMV_NUMDOC',
                    'RMV_ESPDOC',
                    'RMV_CODITE',
                    'ITE_DESITE',
                    'RMV_QTDITE',
                    'RMV_TIPOPE'],
                   '',
                   'REMDEV',
                   Self.Name,
                   'Consulta Remessa de Devolução',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('RMV_NUMREM').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('RMV_NUMREM').AsString;
        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

