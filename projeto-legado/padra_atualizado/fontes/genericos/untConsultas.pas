      strSQL := strSQL + '    WHEN "99" THEN "Demais hipóteses de dispensa de escrituração, relacionadas no art. 5º, da IN RFB nº 1.252, de 2012" ';
      strSQL := strSQL + '  END CODINF, ';
      strSQL := strSQL + '  SDE_CODEMP, ';
      strSQL := strSQL + '  AUTOINCREM ';
      strSQL := strSQL + 'FROM ';
