function fPesqNFeCTe(Self : TForm;
                          qryTabela: TUniQuery;
                          Var chrKey: Char;
                          Var arrSel: TConsultasArray;
                          blnConSim: Boolean = True;
                          strWhere: String = ''): Boolean;
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
begin
  Result := False;
  If Not fEntraCons(chrKey) Then
    Exit;
  Try
    chrKey := #0;
    strSQL := ' SELECT ';
    strSQL := strSQL + '    CODEMP';
    strSQL := strSQL + '   ,DTADOC';
    strSQL := strSQL + '   ,NUMDOC';
    strSQL := strSQL + '   ,ESPDOC';
    strSQL := strSQL + '   ,SERIE_';
    strSQL := strSQL + '   ,ENTSAI';
    strSQL := strSQL + '   ,FORCLI';
    strSQL := strSQL + '   ,TIP_FC';
    strSQL := strSQL + '   ,NOME';
    strSQL := strSQL + '   ,NOME_FAN';
    strSQL := strSQL + '   ,TABELA';
    strSQL := strSQL + '   ,AUTOINCREM';
    strSQL := strSQL + ' FROM ( ';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '    GER_CODEMP CODEMP  ';
    strSQL := strSQL + '   ,GER_DTADOC DTADOC ';
    strSQL := strSQL + '   ,GER_NUMDOC NUMDOC ';
    strSQL := strSQL + '   ,GER_ESPDOC ESPDOC ';
    strSQL := strSQL + '   ,GER_SERIE_ SERIE_ ';
    strSQL := strSQL + '   ,IF(GER_CLAFIS < "5000","ENTRADA","SAÍDA") ENTSAI ';
    strSQL := strSQL + '   ,IF(GER_TIP_FC = ''C'', GER_CODCLI, GER_CODFOR) FORCLI';
    strSQL := strSQL + '   ,GER_TIP_FC TIP_FC';
    strSQL := strSQL + '   ,IF(GER_TIP_FC = "C", CLI_NOMCLI, FOR_NOMFOR) AS NOME';
    strSQL := strSQL + '   ,IF(GER_TIP_FC = "C", CLI_FANSOB, FOR_NOMFAN) AS NOME_FAN';
    strSQL := strSQL + '   ,"MOVGER" TABELA ';
    strSQL := strSQL + '   ,MOVGER.AUTOINCREM';
    strSQL := strSQL + ' FROM MOVGER ';
    strSQL := strSQL + ' LEFT JOIN RECTNF ON REC_MOVSEQ = MOVGER.AUTOINCREM ';
    strSQL := strSQL + ' LEFT JOIN CADFOR ON GER_TIP_FC = "F" AND CADFOR.FOR_CODFOR = GER_CODFOR ';
    strSQL := strSQL + ' LEFT JOIN CADCLI ON GER_TIP_FC = "C" AND CADCLI.CLI_CODCLI = GER_CODCLI ';
    strSQL := strSQL + ' WHERE REC_CTESEQ IS NULL ';
    strSQL := strSQL + ' UNION ALL ';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '     GER_CODEMP CODEMP  ';
    strSQL := strSQL + '    ,GER_DTAENT AS GER_DTADOC ';
    strSQL := strSQL + '    ,GER_NUMDOC ';
    strSQL := strSQL + '    ,GER_ESPDOC ';
    strSQL := strSQL + '    ,GER_SERIE_ ';
    strSQL := strSQL + '    ,IF(GER_CLAFIS < "5000","ENTRADA","SAÍDA") ENTSAI ';
    strSQL := strSQL + '    ,IF(GER_TIP_FC = ''C'', GER_CODCLI, GER_CODFOR) FORCLI';
    strSQL := strSQL + '    ,GER_TIP_FC TIP_FC';
    strSQL := strSQL + '    ,IF(GER_TIP_FC = "C", CLI_NOMCLI, FOR_NOMFOR) AS NOME';
    strSQL := strSQL + '    ,IF(GER_TIP_FC = "C", CLI_FANSOB, FOR_NOMFAN) AS NOME_FAN';
    strSQL := strSQL + '    ,"NOTGER" TABELA ';
    strSQL := strSQL + '    ,NOTGER.AUTOINCREM ';
    strSQL := strSQL + ' FROM NOTGER ';
    strSQL := strSQL + ' INNER JOIN RECTNF ON REC_NOTSEQ = NOTGER.AUTOINCREM ';
    strSQL := strSQL + ' LEFT JOIN CADFOR ON GER_TIP_FC = "F" AND CADFOR.FOR_CODFOR = GER_CODFOR ';
    strSQL := strSQL + ' LEFT JOIN CADCLI ON GER_TIP_FC = "C" AND CADCLI.CLI_CODCLI = GER_CODCLI ';
    strSQL := strSQL + ' WHERE REC_CTESEQ IS NULL ';
    strSQL := strSQL + ' UNION ALL ';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '     GER_CODEMP CODEMP  ';
    strSQL := strSQL + '     ,GER_DTADOC ';
    strSQL := strSQL + '     ,GER_NUMDOC ';
    strSQL := strSQL + '     ,GER_ESPDOC ';
    strSQL := strSQL + '     ,GER_SERIE_ ';
    strSQL := strSQL + '     ,IF(GER_CLAFIS < "5000","ENTRADA","SAÍDA") GER_ENTSAI';
    strSQL := strSQL + '     ,IF(GER_TIP_FC = ''C'', GER_CODCLI, GER_CODFOR) FORCLI';
    strSQL := strSQL + '     ,GER_TIP_FC TIP_FC';
    strSQL := strSQL + '     ,IF(GER_TIP_FC = "C", CLI_NOMCLI, FOR_NOMFOR) AS NOME';
    strSQL := strSQL + '     ,IF(GER_TIP_FC = "C", CLI_FANSOB, FOR_NOMFAN) AS NOME_FAN';
    strSQL := strSQL + '     ,"MOVGER" TABELA';
    strSQL := strSQL + '     ,MOVGER.AUTOINCREM ';
    strSQL := strSQL + ' FROM CONFRE ';
    strSQL := strSQL + ' INNER JOIN MOVGER ON MOVGER.AUTOINCREM = CON_SEQGER ';
    strSQL := strSQL + ' LEFT JOIN CADFOR ON GER_TIP_FC = "F" AND CADFOR.FOR_CODFOR = GER_CODFOR ';
    strSQL := strSQL + ' LEFT JOIN CADCLI ON GER_TIP_FC = "C" AND CADCLI.CLI_CODCLI = GER_CODCLI ';
    strSQL := strSQL + ' WHERE CON_SEQFIS IS NULL ';
    strSQL := strSQL + ' ) TMP ';

    If Not Assigned(qryTabela) Then
      qryConsulta := fCriaQuery(Nil)
    Else
      qryConsulta := qryTabela;

    objConsulta := TDefConsulta.Create;
    try
      objConsulta.strSQLRetorno := strSQL;
      If fConsultaConfig([strSQL],
                  ['Empresa',
                   'Data do Documento',
                   'Número',
                   'Espécie',
                   'Série',
                   'Ent/Sai',
                   'For/Cli',
                   'Forn./Cli.',
                   'Nome',
                   'Nome Fan.'],
                   ['GER_DTADOC','GER_NUMDOC','FORCLI','TIP_FC','NOME','NOME_FAN'],
                   '',
                   'TMP',
                   Self.Name,
                   'Consulta Notas Fiscas não associadas com CT-e',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   '',
                   '',
                   False,
                   objConsulta) Then
      Begin
        Result := True;
      End;
    Finally
      FreeAndNil(objConsulta);
    End;

    If Not Assigned(qryTabela) Then
      FreeAndNil(qryConsulta);
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;
end;

