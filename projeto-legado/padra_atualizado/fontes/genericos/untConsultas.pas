                '       CADFOR.FOR_NOMFOR , '+
                '       CADFIS.AUTOINCREM '+
                '  FROM CADFIS '+
                '  INNER JOIN CADFOR ON FOR_CODFOR = FIS_FORCLI ';

      strWhere :=  strWhere + ' WHERE FIS_CODEMP = ' + QuotedStr(VS_strCodEmp);
      strWhere :=  strWhere + '   AND FIS_TIP_FC = "F" ';

//      If strNumDoc <> '' Then
//        strWhere :=  strWhere + ' AND FIS_NUMDOC = ' + QuotedStr(strNumDoc);

      If strEspDoc <> '' Then
        strWhere :=  strWhere + ' AND FIS_ESPDOC = ' + QuotedStr(strEspDoc);

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;


      If fConsulta([strSQL, strWhere],
                  ['Data da Entrada',
                   'Data do Documento',
                   'Número do Documento',
                   'Espécie do Documento',
                   'Série',
                   'Chave de Acesso',
                   'Modelo',
                   'Cód.Fornecedor',
                   'Nome do Fornecedor'],
                  ['FIS_DTAENT',
                   'FIS_DTADOC',
                   'FIS_NUMDOC',
                   'FIS_ESPDOC',
                   'FIS_SERIE_',
                   'FIS_ACESSO',
                   'FIS_CODMOD',
                   'FIS_FORCLI',
                   'FOR_NOMFOR'],
                   'AUTOINCREM',
                   'CADFIS',
                   FormName,
                   '',
                   qryConsulta,
                   Nil,
                   True,
                   arrSel,
                   'AUTOINCREM',
                   objConsulta) Then
      Begin
        Result := True;

        edtNumDoc.Text    := qryConsulta.FieldByName('FIS_NUMDOC').AsString;
        edtSerie.Text     := qryConsulta.FieldByName('FIS_SERIE_').AsString;
        edtCodFor.Text    := qryConsulta.FieldByName('FIS_FORCLI').AsString;
        edtNomCliFor.Text := fRetNomFornecedor(qryConsulta.FieldByName('FIS_FORCLI').AsString);
      End;

      FreeAndNil(objConsulta);

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

    Except
      On E: Exception Do
