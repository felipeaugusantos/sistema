function fPesqOrdemServicoProdVenda(Self     : TForm;
                                    edtCodigo: TCustomEdit;
                                    edtDescri: TEditFocus;
                                    qryTabela: TUniQuery;
                                    Var chrKey: Char;
                                    Var arrSel: TConsultasArray;
                                    odTipoFiltro: TFiltroOrdServProd;
                                    blnConSim: Boolean = True): Boolean;
  Var
    strSQL      : String;
    qryConsulta : TUniQuery;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND ORD_CODEMP = ' + QuotedStr(VS_strCodEmp);

    If (odTipoFiltro = odBaixados) Then
      strWhere := strWhere + ' AND ORD_BAIXAD = "S" '
    Else If (odTipoFiltro = odNaoBaixados) Then
      strWhere := strWhere + ' AND ORD_BAIXAD = "N" ';

    Result := strWhere;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  ORD_NUMORD, ';
      strSQL := strSQL + '  ORD_DTACAD, ';
      strSQL := strSQL + '  ORD_NUMDOC, ';
      strSQL := strSQL + '  ORD_ESPDOC, ';
      strSQL := strSQL + '  ORD_QTDSER, ';
      strSQL := strSQL + '  FORMAT(ORD_ALTURA,2) AS ORD_ALTURA, ';
      strSQL := strSQL + '  FORMAT(ORD_LARGUR,2) AS ORD_LARGUR, ';
      strSQL := strSQL + '  FORMAT(ORD_TOT_M2,2) AS ORD_TOT_M2, ';
      strSQL := strSQL + '  ORD_TARJA_, ';
      strSQL := strSQL + '  ORD_RECLOC, ';
      strSQL := strSQL + '  ORD_OBSERV, ';
      strSQL := strSQL + '  ORD_CODITE, ';
      strSQL := strSQL + '  ITE_DESITE, ';
      strSQL := strSQL + '  ORD_CODCLI, ';
      strSQL := strSQL + '  CLI_NOMCLI, ';
      strSQL := strSQL + '  ORDSER.AUTOINCREM ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  ORDSER ';
      strSQL := strSQL + '  LEFT JOIN CADITE ON ITE_CODITE = ORD_CODITE ';
      strSQL := strSQL + '  LEFT JOIN CADCLI ON CLI_CODCLI = ORD_CODCLI ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   ['Num.Ord.',
                    'Dta Cad.',
                    'Documento',
                    'Especie',
                    'Quantid.',
                    'Altura',
                    'Largura',
                    'Tot M2',
                    'Tarja',
                    'Rec.Loc.',
                    'Observação',
                    'Cód. Produto',
                    'Descrição Produto',
                    'Cód. Cliente',
                    'Nome Cliente',
                    'AUTOINCREM'],
                   ['ORD_NUMORD', 'ORD_DTACAD', 'ORD_NUMDOC', 'ORD_ESPDOC', 'ORD_QTDSER', 'ORD_ALTURA',
                   'ORD_LARGUR', 'ORD_TOT_M2', 'ORD_TARJA_', 'ORD_RECLOC', 'ORD_OBSERV', 'ORD_CODITE',
                   'ITE_DESITE', 'ORD_CODCLI', 'CLI_NOMCLI'],
                   '',
                   'ORDSER',
                   Self.Name,
                   'Consulta de Ordem de Serviço de Produto de Venda',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'ORD_NUMORD',
