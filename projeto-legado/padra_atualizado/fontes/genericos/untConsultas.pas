        blnIncluiJoinEnderecos := True;

      If objLoadSQL.fIncluiSubConsulta('CID_ESTENT', 'IF(ET.ETC_ENDENT = "" OR ET.ETC_ENDENT IS NULL, D1.CID_ESTADO, D3.CID_ESTADO)', 'Estado de Entrega') Then
        blnIncluiJoinEnderecos := True;

      If objLoadSQL.fIncluiSubConsulta('CLI_CEPENT', 'IF(ET.ETC_ENDENT = "" OR ET.ETC_ENDENT IS NULL, C.CLI_C_E_P_,  ET.ETC_CEPENT)', 'CEP de Entrega') Then
        blnIncluiJoinEnderecos := True;

      If blnIncluiJoinEnderecos Then
      Begin
        objLoadSQL.stlJoins.Add('LEFT JOIN ENTCLI ET ON ET.ETC_CODCLI = C.CLI_CODCLI AND ' +
                                ' ET.ETC_SEQVIS = (SELECT MIN(EN.ETC_SEQVIS) FROM ENTCLI EN WHERE EN.ETC_CODCLI = C.CLI_CODCLI) ');

        objLoadSQL.stlJoins.Add('LEFT JOIN CADCID D1 ON C.CLI_CODCID = D1.CID_CODCID');
        objLoadSQL.stlJoins.Add('LEFT JOIN CADCID D2 ON C.CLI_CIDCOB = D2.CID_CODCID');
        objLoadSQL.stlJoins.Add('LEFT JOIN CADCID D3 ON E.ETC_CIDENT = D3.CID_CODCID');
      End;

      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_ENDENT', 'Endereço de Entrega');
