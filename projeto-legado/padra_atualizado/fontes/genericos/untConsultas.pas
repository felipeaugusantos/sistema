  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  function fRetornaSomaFdoPesBru(aStrSeqFgo: String; aStrCndCon: String='<>'): String;
  begin
    Result := '  SELECT IFNULL(SUM(EXTDOR.FDO_PESBRU), 0) ' +
              '    FROM FATGOR '+
              '  INNER JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ' +
              '  INNER JOIN FATDOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ' +
              '  INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ' +
              '  WHERE EXTGOR.FGO_CODROT = ENT_CODIGO '+
              '    AND ((IFNULL(FGO_MOTBAI, "") = "") OR ((IFNULL(FGO_MOTBAI, "") <> "") AND (IFNULL(FDO_NUMFAT, "") <> ""))) ';

    If (Not fEmptyStr(aStrSeqFgo)) Then
      Result := Result + ' AND FATGOR.AUTOINCREM '+aStrCndCon+' '+QuotedStr(aStrSeqFgo);

    If (fEmptyStr(aStrSeqFgo)) And (Pos('=', aStrCndCon) > 0) Then
      Result := Result + ' AND FALSE ';

    Result := ' ( ' + Result + ' ) ';
  end;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';

      If Not fEmptyStr(strCodCid) Then
        strSQL := strSQL + '       DISTINCT     ';

      strSQL := strSQL + '       ENT_CODIGO,  '; pAddNomeColuna('Seq. Rota');
      strSQL := strSQL + '       ENT_CODREG,  '; pAddNomeColuna('Cód. Região');
