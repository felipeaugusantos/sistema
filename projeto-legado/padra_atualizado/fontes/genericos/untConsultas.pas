                   Nil,
                   True,
                   arrSel,
                   'AUTOINCREM',
                   Nil) Then
      Begin
        Result := True;
      End;
    Finally
      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);
    End;
  End;
end;

