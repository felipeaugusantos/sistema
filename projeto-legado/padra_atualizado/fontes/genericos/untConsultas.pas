      arrTitCol[07] := 'Telefone 2';
      arrTitCol[08] := 'Celular';
      arrTitCol[09] := 'CNPJ/CPF';
      arrTitCol[10] := 'Dt.Cadastro';
      arrTitCol[11] := 'Observações';
      arrTitCol[12] := 'Atividade';
      arrTitCol[13] := '% Itens sem promoção';
      arrTitCol[14] := '% Itens com promoção';
      arrTitCol[15] := 'AUTOINCREM';

      If (fCfgSis('EMPDIV', varBoolean)) Then
      Begin
        SetLength(arrTitCol, 17);
        arrTitCol[16] := 'Empresa Identificadora';
      End;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrTitCol,
                   ['DIV_NOMDIV','DIV_CODDIV'],
                   '',
                   'CADDIV',
                   Self.Name,
                   'Consulta de Diversos',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'DIV_CODDIV',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('DIV_CODDIV').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('DIV_CODDIV').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('DIV_NOMDIV').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
            Else
              edtCodigo.Text := fStrZero('0', 8);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

