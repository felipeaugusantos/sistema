function fPesqModeloVeiculo(Self     : TForm;                             {* Formulário                                  *}
                            edtCodigo: TCustomEdit;                       {* Edit do Código                              *}
                            edtDescri: TEditFocus;                        {* Edit da Descrição                           *}
                            qryTabela: TUniQuery;                         {* Query                                       *}
                            Var chrKey: Char;                             {* Key                                         *}
                            Var arrSel: TConsultasArray;                  {* Array de Seleção                            *}
                            blnConSim: Boolean = True;                    {* Consulta Simples ou Múltipla (multi select) *}
                            strCodMar: String = '';
                            blnExibirMarca: Boolean = False): Boolean;             {* Marca do modelo de veículo                  *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    strTitulo: String;
    objConsulta: TDefConsulta;
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrCamposConsulta, Succ(Length(arrCamposConsulta)));
    arrCamposConsulta[High(arrCamposConsulta)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If Not fEmptyStr(strCodMar) Then
    Begin
      If (Not fHasQuotedChar(strCodMar)) Then
        strCodMar := QuotedStr(strCodMar);
      strWhere := strWhere + ' AND MO.MOD_CODMAR IN('+strCodMar+')';
    End;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    If blnExibirMarca Then
    Begin
      objLoadSql.stlJoins.Add('  LEFT JOIN MARVEI MA ON MA.MAR_CODMAR = MO.MOD_CODMAR ');
      objLoadSql.fIncluiSubConsulta('MAR_CODMAR', 'MA.MAR_CODMAR', 'Marca');
      objLoadSql.fIncluiSubConsulta('MAR_DESMAR', 'MA.MAR_DESMAR', 'Descrição');
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSQL;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  MO.MOD_CODMOD,    ';
    strSQL := strSQL + '  MO.MOD_DESMOD,    ';
    If blnExibirMarca Then
    Begin
      strSQL := strSQL + '  MA.MAR_CODMAR,  ';
      strSQL := strSQL + '  MA.MAR_DESMAR,  ';
    End;
    strSQL := strSQL + '  MO.AUTOINCREM     ';
    strSQL := strSQL + 'FROM                ';
    strSQL := strSQL + '  MODVEI MO         ';
    If blnExibirMarca Then
      strSQL := strSQL + '  LEFT JOIN MARVEI MA ON MA.MAR_CODMAR = MO.MOD_CODMAR ';
    pAddNomeColuna('Código');
    pAddNomeColuna('Descrição');
    If blnExibirMarca Then
    Begin
      pAddNomeColuna('Marca');
      pAddNomeColuna('Descrição Marca');
    end;
    pAddNomeColuna('AUTOINCREM');
    arrSQLConsulta    := [strSQL, fSQLWhere(True)];
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      objConsulta := TDefConsulta.Create;
      strTitulo := 'Consulta de Modelos de Veículos';
      objConsulta.pAdicionaTabela('MODVEI', 'MO');

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta, arrCamposConsulta,
                   ['MOD_DESMOD','MOD_CODMOD'],
                   '',
                   'MODVEI',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'MOD_CODMOD',
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('MOD_CODMOD').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('MOD_CODMOD').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('MOD_DESMOD').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 4)
            Else
              edtCodigo.Text := fStrZero('0', 4);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

        FreeAndNil(objLoadSQL);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

