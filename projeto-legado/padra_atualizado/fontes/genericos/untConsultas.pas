      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrTitCol,
                   ['FPG_DESCRI','FPG_CODIGO'],
                   '',
                   'CADFPG',
                   Self.Name,
                   'Consulta de Formas de Pagamento',
