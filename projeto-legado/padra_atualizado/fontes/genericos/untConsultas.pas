function fPesqMarcas(Self     : TForm;                    {* Formulário                                  *}
                     edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                     edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                     qryTabela: TUniQuery;                {* Query                                       *}
                     Var chrKey: Char;                    {* Key                                         *}
                     Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                     blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                     blnAtivas: Boolean = True): Boolean; {* Filtrar as marcas ativas                    *}
  Var
    strSQL     : String;
    strTitulo: String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrCampos,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
    Function fSQLWhere(blnCompleto: Boolean): String;
      Var
        strWhere: String;
    Begin
      If blnCompleto Then
        strWhere := ' WHERE TRUE '
      Else
        strWhere := '';

      If blnAtivas Then
        strWhere := strWhere + ' AND C.MAR_ATIVA_ = "S" ';

      Result := strWhere;
    End;

    Procedure pTrataConsultaConfigurada;
    Begin
      If fCfgSis('ELCUCO', varBoolean) Then
      Begin
        objLoadSql.fIncluiSubConsulta('FATCUS', 'C.MAR_FATCUS', 'Fator Elevação de Custo');
      End;
      objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
      objLoadSQL.pCarregaDadosConsulta;
      arrSQLConsulta    := objLoadSQL.arrSql;
      arrCamposConsulta := objLoadSQL.arrNomeColunas;
    End;

    Procedure pConsultaAntiga;
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE   ';
      strSQL := strSQL + '  C.MAR_CODMAR,  ';
      strSQL := strSQL + '  C.MAR_DESMAR,  ';

      If fCfgSis('ELCUCO', varBoolean) Then
        strSQL := strSQL + '  C.MAR_FATCUS,     ';

      strSQL := strSQL + '  STATUS,             ';
      strSQL := strSQL + '  C.AUTOINCREM   ';
      strSQL := strSQL + 'FROM                  ';
      strSQL := strSQL + '  CADMAR C            ';

      If fCfgSis('ELCUCO', varBoolean) Then
      Begin
        objConsulta.pFormataDecimal('MAR_FATCUS', 6);
        SetLength(arrCampos, 5);
        arrCampos[0] := 'Código';
        arrCampos[1] := 'Descrição';
        arrCampos[2] := 'Fator Elevação de Custo';
        arrCampos[3] := 'Status';
        arrCampos[4] := 'AUTOINCREM';
      End
      Else
      Begin
        SetLength(arrCampos, 4);
        arrCampos[0] := 'Código';
        arrCampos[1] := 'Descrição';
        arrCampos[2] := 'Status';
        arrCampos[3] := 'AUTOINCREM';
      End;
      arrSQLConsulta    := [strSQL, fSQLWhere(True)];
      arrCamposConsulta := arrCampos;
    End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('STATUS', 'IF(C.MAR_ATIVA_ = "S", "ATIVO", "INATIVO")');
      objConsulta.pAdicionaTabela('CADMAR', 'C');
      strTitulo := 'Consulta de Marcas';

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['MAR_DESMAR','MAR_CODMAR'],
                   '',
                   'CADMAR',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'MAR_CODMAR',
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('MAR_CODMAR').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('MAR_CODMAR').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('MAR_DESMAR').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', Length(qryConsulta.FieldByName('MAR_CODMAR').AsString))
            Else
              edtCodigo.Text := fStrZero('0', Length(qryConsulta.FieldByName('MAR_CODMAR').AsString));
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

        If Assigned(objConsulta) Then
          FreeAndNil(objConsulta);

        FreeAndNil(objLoadSQL);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

