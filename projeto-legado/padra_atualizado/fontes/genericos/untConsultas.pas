{*****************************}
{* CONSULTA DE EVENTOS       *}
{**************************RV*}
function fPesqEventos(Self     : TForm;                           {* Formulário                                  *}
                      edtCodigo: TCustomEdit;                     {* Edit do Código                              *}
                      edtDescri: TEditFocus;                      {* Edit da Descrição                           *}
                      qryTabela: TUniQuery;                       {* Query                                       *}
                      Var chrKey: Char;                           {* Key                                         *}
                      Var arrSel: TConsultasArray;                {* Array de Seleção                            *}
                      blnConSim: Boolean = True;                  {* Consulta Simples ou Múltipla (multi select) *}
                      blnFiltroExiFat: Boolean = False;           {* Consulta pesquisará somente eventos que serão exibidos no faturamento *}
                      strTipo: string = 'T'): Boolean;            {* Consulta pelo tipo = T-odos / P-agar / R-eceber *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    arrDescCampos: TColunasArray;
    objConsulta: TDefConsultaCentroDeCusto;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If (fCfgSis('EVEFAT', varBoolean)) And (blnFiltroExiFat) Then
      strWhere := strWhere + ' AND IFNULL(EVE_EXIFAT, "N") = "S" '
    Else If strTipo = 'R' then
      strWhere := strWhere + ' AND EVE_TIPEVE IN("R","G") '
    Else If strTipo = 'P' then
      strWhere := strWhere + ' AND EVE_TIPEVE IN("P","G") ';

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  EVE_CODEVE,       ';
      strSQL := strSQL + '  EVE_DESEVE,       ';
      strSQL := strSQL + '  EVE_CONCON,       ';
      strSQL := strSQL + '  EVE_TIPEVE,       ';
      strSQL := strSQL + '  EVE_CODCOM,       ';

      objConsulta := TDefConsultaCentroDeCusto.Create(['EVE_CODCOM']);

      If (fCfgSis('EVEFAT', varBoolean)) Then Begin
        strSQL := strSQL + '  EXIBEFAT,       ';

        arrDescCampos := ['Cód. Resumido', 'Descrição', 'Conta Contábil', 'Tipo do Ctr. Custos', 'Código Completo', 'Visualizar no Faturamento', 'AUTOINCREM'];

        objConsulta.pIncluiSubConsulta('EXIBEFAT', 'IF(EVE_EXIFAT = "S", "SIM", "NÃO")');
        objConsulta.pIncluiCampoSimNao('EXIBEFAT');
      End
      Else If fCfgSis('EVEDTQ', varBoolean) Then
      Begin
        strSQL := strSQL + '  EVE_DTAEVE, EVE_QTDPES, ';

        arrDescCampos := ['Código', 'Descrição', 'Conta Contábil', 'Tipo do Ctr. Custos', 'Código Completo', 'Data Evento', 'Qtde. Pessoas', 'AUTOINCREM'];
      End
      Else Begin
        arrDescCampos := ['Cód. Resumido', 'Descrição', 'Conta Contábil', 'Tipo do Ctr. Custos', 'Código Completo', 'AUTOINCREM'];
      End;

      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADEVE            ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrDescCampos,
                   ['EVE_DESEVE','EVE_CODEVE'],
                   '',
                   'CADEVE',
                   Self.Name,
                   'Consulta de Centro de Custos',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'EVE_CODEVE',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('EVE_CODEVE').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('EVE_CODEVE').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('EVE_DESEVE').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 5)
            Else
              edtCodigo.Text := fStrZero('0', 5);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

        If Assigned(objConsulta) Then
          FreeAndNil(objConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

{*****************************}
{* CONSULTA DE LIVRO FISCAL  *}
{**************************RV*}
function fPesqLivroFiscal(Self     : TForm;                       {* Formulário                                  *}
                          qryTabela: TUniQuery;                   {* Query                                       *}
                          Var chrKey: Char;                       {* Key                                         *}
                          Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                          blnConSim: Boolean = True;              {* Consulta Simples ou Múltipla (multi select) *}
                          tplConsulta: TTipoConsultaLivro = conGeral;
                          strTip_FC: String = '';                 {* Se é documento para fornecedor ou cliente   *}
                          strCodCli: String = '';                 {* Código do Cliente                           *}
                          strCodFaz: String = '';                 {* Código da Fazenda                           *}
                          strNumDocComplementar: string = '';
                          blnSoEntrada : Boolean = False;         {* Só exibe documentos de Entrada             *}
                          dtaDtaIni: TDate = 0;
                          dtaDtaFin: TDate = 0;
                          blnSoEmiPropria: Boolean = True;        {* Só exibe documentos de emissão própria *}
                          strCodEmp : String = '';
                          blnApenasMovimentosNaoConfirmados : Boolean = False; // Apenas notas fiscais que estão com data de entrada = null ( Conferencia de Pre nota Apos a entrada de Mercadorias + WMS)
                          blnIncluiNotaImportacao: Boolean = False {* Incluir  nota de importação nas buscas- feito para carta de correção*}
                          ): Boolean;
  Var
    strTitulo  : String;
    blnCadFaz,
    blnTemCampoCalculadoFIS_VALOR_: Boolean;
    qryConsulta: TUniQuery;
    objConsulta: TDefMascaraCadFisCGC;
    objLoadSql: TLoadConsultaSQL;
    arrTitCol,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    {************************************************************}
    {* ADICIONADA CONDIÇÃO UTIIZADA NO FORM FRMFATDADOSNOTACOMP *}
    {*********************************************************JU*}
    If tplConsulta In [conNotaComplemento, conCartaCorrecao, conNFCeComplementar] Then
    Begin

      If (tplConsulta = conNFCeComplementar) Then
        strWhere := strWhere + '  AND (FIS_ESPDOC = "IF") '
      Else
        strWhere := strWhere + '  AND (FIS_ESPDOC = "NF" OR FIS_ESPDOC = "NV" OR FIS_ESPDOC = "EL" OR FIS_ESPDOC = "IF") ';

      If blnSoEmiPropria Then
      Begin
        If blnIncluiNotaImportacao Then
          strWhere := strWhere + '     AND ((FIS_ORIDOC = "V") OR ((IFNULL(FIS_ORIDOC,"") = "") AND (LEFT(FIS_CLFSC1,1) = 3))) '
        Else
          strWhere := strWhere + '     AND FIS_ORIDOC = "V" ';
      End
      Else
        strWhere := strWhere + '     AND IFNULL(FIS_ORIDOC,"") = "" ';

      If tplConsulta In [conNotaComplemento, conNFCeComplementar] Then
      Begin
        If Not fEmptyStr(strTip_FC) Then
          strWhere := strWhere + '     AND FIS_TIP_FC = ' + QuotedStr(strTip_FC);

        If Not fEmptyStr(strCodCli) Then
          strWhere := strWhere + '     AND FIS_FORCLI = ' + QuotedStr(strCodCli);
      End;

      strWhere := strWhere + '     AND FIS_CODEMP = ' + QuotedStr(VS_strCodEmp);

      If blnCadFaz Then
        strWhere := strWhere + '     AND FAZ_CODFAZ = ' + QuotedStr(strCodFaz);
    End
    Else
    Begin
        If Not fEmptyStr(strTip_FC) Then
          strWhere := strWhere + '     AND FIS_TIP_FC = ' + QuotedStr(strTip_FC);

        if (tplConsulta In [conNotaComplementar, conNotaEstorno]) and (Not (fEmptyStr(strCodCli))) then
          strWhere := strWhere + '     AND FIS_FORCLI = ' + QuotedStr(strCodCli);

        if tplConsulta = conNotaComplementar then
        strWhere := strWhere + '  AND FIS_NUMDOC <> ' + QuotedStr(strNumDocComplementar);
    End;

      If Not fEmptyStr(strCodEmp) Then
          strWhere := strWhere + '     AND FIS_CODEMP = ' + QuotedStr(strCodEmp);

      If tplConsulta In [conCartaCorrecao, conNotaEstorno] Then
      Begin
        strWhere := strWhere + '     AND IFNULL(FIS_ACESSO, "") <> "" ';
        strWhere := strWhere + '     AND IFNULL(NFE_STATUS, "") = "AT" ';
    End;

    If dtaDtaIni <> 0 Then
      strWhere := strWhere + '  AND FIS_DTAENT BETWEEN ' + QuotedStr(FormatDateTime('yyyy-mm-dd', dtaDtaIni)) + ' AND ' +
                                                           QuotedStr(FormatDateTime('yyyy-mm-dd', dtaDtaFin)) + ' ';
    If blnSoEntrada Then
    Begin
      strWhere := strWhere + '     AND LEFT(FIS_CLFSC1,1) < 5 ';
    End;

      If blnApenasMovimentosNaoConfirmados Then
        strWhere := strWhere + ' AND FIS_DTAENT IS NULL ';

      If tplConsulta = conNotaEstorno Then
        strWhere := strWhere + ' AND IFNULL(FIS_ESTNFE, "") <> "S" ';

      if tplConsulta = conAgendamentoEntrega then
      begin
        strWhere := strWhere + ' AND (SELECT                      ';
      strWhere := strWhere + '      COUNT(*)                    ';
      strWhere := strWhere + '    FROM                          ';
      strWhere := strWhere + '      AGEDOC                      ';
      strWhere := strWhere + '    WHERE                         ';
      strWhere := strWhere + '          FIS_NUMDOC = ADC_NUMDOC ';
      strWhere := strWhere + ' 		 AND FIS_ESPDOC = ADC_ESPDOC  ';
      strWhere := strWhere + ' 		 AND FIS_SERIE_ = ADC_SERIE_  ';
      strWhere := strWhere + ' 		 AND FIS_FORCLI = ADC_CODFOR  ';
      strWhere := strWhere + ' 		 AND FIS_TIP_FC = "F") = 0    ';
    end;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    If blnCadFaz Then
    Begin
      objLoadSql.stlJoins.Add(' LEFT JOIN NOTCOM NT ON NT.GER_SEQGER = F.AUTOINCREM   ' +
                              ' LEFT JOIN MOVGER MV ON MV.GER_NUMDOC = FIS_NUMDOC AND ' +
                              '                        MV.GER_ESPDOC = FIS_ESPDOC AND ' +
                              '                        MV.GER_CODEMP = FIS_CODEMP AND ' +
                              '                        MV.GER_TIP_FC = FIS_TIP_FC AND ' +
                              '                     IF(FIS_TIP_FC="C", MV.GER_CODCLI, MV.GER_CODFOR) = FIS_FORCLI AND ' +
                              '                     IFNULL(MV.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ' +
                              ' LEFT JOIN AUXMOV AX ON AX.AUX_SEQGER = MV.AUTOINCREM ' +
                              ' LEFT JOIN NOTGER NG ON NG.GER_NUMDOC = FIS_NUMDOC AND ' +
                              '                     NG.GER_ESPDOC = FIS_ESPDOC AND ' +
                              '                     NG.GER_CODEMP = FIS_CODEMP AND ' +
                              '                     NG.GER_TIP_FC = FIS_TIP_FC AND ' +
                              '                     IF(FIS_TIP_FC="C", NG.GER_CODCLI, NG.GER_CODFOR) = FIS_FORCLI AND ' +
                              '                     IFNULL(NG.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ' +
                              ' LEFT JOIN AUXNOT AN ON AN.AUX_SEQGER = NG.AUTOINCREM ' +
                              'INNER JOIN CADFAZ CF ON CF.FAZ_CODFAZ = IFNULL(NT.GER_CODFAZ, IFNULL(AX.AUX_CODFAZ, AN.AUX_CODFAZ)) ');
    End;

    If tplConsulta = conCartaCorrecao Then
    Begin
      objLoadSql.stlJoins.Add(' INNER JOIN LOGNFE LN ON NFE_ESPDOC = FIS_ESPDOC ' +
                              '    AND NFE_NUMDOC = FIS_NUMDOC ' +
                              '    AND IFNULL(NFE_SERIE_, "") = IFNULL(FIS_SERIE_, "") ' +
                              '    AND NFE_CODCLI = FIS_FORCLI ' +
                              '    AND NFE_CODEMP = FIS_CODEMP ');
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

  Function fSQLCadFis(blnFornecedor: Boolean): String;
    Var
      strSQL:String;
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  F.FIS_NUMDOC, ';     If blnFornecedor Then pAddNomeColuna('Documento 1');
    strSQL := strSQL + '  F.FIS_NUMDO2, ';     If blnFornecedor Then pAddNomeColuna('Documento 2');
    strSQL := strSQL + '  F.FIS_CLFSC1, ';     If blnFornecedor Then pAddNomeColuna('CFOP');
    strSQL := strSQL + '  F.FIS_ESPDOC, ';     If blnFornecedor Then pAddNomeColuna('Espécie');
    strSQL := strSQL + '  F.FIS_CODEMP, ';     If blnFornecedor Then pAddNomeColuna('Emp.');
    strSQL := strSQL + '  F.FIS_SERIE_, ';     If blnFornecedor Then pAddNomeColuna('Série');
    strSQL := strSQL + ' '+IIF(blnTemCampoCalculadoFIS_VALOR_,'F.','')+'FIS_VALOR_, '; If blnFornecedor Then pAddNomeColuna('Valor');
    strSQL := strSQL + '  F.FIS_ACESSO, ';     If blnFornecedor Then pAddNomeColuna('Chave de Acesso');
    strSQL := strSQL + '  F.FIS_ENTSAI, ';     If blnFornecedor Then pAddNomeColuna('E/S');
    strSQL := strSQL + '  F.FIS_TIP_FC, ';     If blnFornecedor Then pAddNomeColuna('C/F');

    If blnFornecedor Then
      strSQL := strSQL + ' FIS_C_G_C_, '
    Else
      strSQL := strSQL + ' FIS_C_G_C2, ';

    If blnFornecedor Then pAddNomeColuna('CNPJ/CPF');

    strSQL := strSQL + '  F.FIS_FORCLI, ';     If blnFornecedor Then pAddNomeColuna('Cliente/Forn.');

    If blnFornecedor Then
      strSQL := strSQL + '  FIS_NOMDES, '
    Else
      strSQL := strSQL + '  FIS_NOMDE2, ';     If blnFornecedor Then pAddNomeColuna('Nome');

    strSQL := strSQL + '  F.FIS_DTAENT, ';     If blnFornecedor Then pAddNomeColuna('Dt. Entrada');
    strSQL := strSQL + '  F.FIS_DTADOC, ';     If blnFornecedor Then pAddNomeColuna('Dt. Documento');
    strSQL := strSQL + '  F.FIS_HISTOR, ';     If blnFornecedor Then pAddNomeColuna('Histórico');
    strSQL := strSQL + '  F.FIS_NUMCOO, ';     If blnFornecedor Then pAddNomeColuna('Número CCO');
    strSQL := strSQL + '  F.FIS_CODMOD, ';     If blnFornecedor Then pAddNomeColuna('Modelo do Documento');
    strSQL := strSQL + '  F.FIS_DOCOFF, ';     If blnFornecedor Then pAddNomeColuna('NFCe Offline');
    strSQL := strSQL + '  F.AUTOINCREM  ';     If blnFornecedor Then pAddNomeColuna('AUTOINCREM');

    strSQL := strSQL + 'FROM            ';
    strSQL := strSQL + '  CADFIS F      ';

    If blnFornecedor Then
    Begin
      strSQL := strSQL + '  INNER JOIN CADFOR FR  ON FR.FOR_CODFOR  = F.FIS_FORCLI ';
      strSQL := strSQL + '                      AND F.FIS_TIP_FC   = "F"          ';
    End Else
    Begin
      strSQL := strSQL + '  INNER JOIN CADCLI CLI ON CLI.CLI_CODCLI = F.FIS_FORCLI ';
      strSQL := strSQL + '                      AND F.FIS_TIP_FC   = "C"          ';
    End;

    If blnCadFaz Then
    Begin
      strSQL := strSQL + 'LEFT JOIN NOTCOM ON NOTCOM.GER_SEQGER = F.AUTOINCREM ';

      strSQL := strSQL + 'LEFT JOIN MOVGER ON MOVGER.GER_NUMDOC = FIS_NUMDOC AND ';
      strSQL := strSQL + '                    MOVGER.GER_ESPDOC = FIS_ESPDOC AND ';
      strSQL := strSQL + '                    MOVGER.GER_CODEMP = FIS_CODEMP AND ';
      strSQL := strSQL + '                    MOVGER.GER_TIP_FC = FIS_TIP_FC AND ';
      strSQL := strSQL + '                    IF(FIS_TIP_FC="C", MOVGER.GER_CODCLI, MOVGER.GER_CODFOR) = FIS_FORCLI AND ';
      strSQL := strSQL + '                    IFNULL(MOVGER.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';

      strSQL := strSQL + 'LEFT JOIN AUXMOV ON AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM ';

      strSQL := strSQL + 'LEFT JOIN NOTGER ON NOTGER.GER_NUMDOC = FIS_NUMDOC AND ';
      strSQL := strSQL + '                    NOTGER.GER_ESPDOC = FIS_ESPDOC AND ';
      strSQL := strSQL + '                    NOTGER.GER_CODEMP = FIS_CODEMP AND ';
      strSQL := strSQL + '                    NOTGER.GER_TIP_FC = FIS_TIP_FC AND ';
      strSQL := strSQL + '                    IF(FIS_TIP_FC="C", NOTGER.GER_CODCLI, NOTGER.GER_CODFOR) = FIS_FORCLI AND ';
      strSQL := strSQL + '                    IFNULL(NOTGER.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';

      strSQL := strSQL + 'LEFT JOIN AUXNOT ON AUXNOT.AUX_SEQGER = NOTGER.AUTOINCREM ';

        strSQL := strSQL + 'INNER JOIN CADFAZ ON CADFAZ.FAZ_CODFAZ = IFNULL(NOTCOM.GER_CODFAZ, IFNULL(AUXMOV.AUX_CODFAZ, AUXNOT.AUX_CODFAZ)) ';
    End;

    If tplConsulta In [conCartaCorrecao, conNotaEstorno] Then
    Begin
      strSQL := strSQL + '  INNER JOIN LOGNFE ';
      strSQL := strSQL + '    ON NFE_ESPDOC  = FIS_ESPDOC ';
      strSQL := strSQL + '    AND NFE_NUMDOC = FIS_NUMDOC ';
      strSQL := strSQL + '    AND IFNULL(NFE_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';
      strSQL := strSQL + '    AND NFE_CODCLI = FIS_FORCLI ';
      strSQL := strSQL + '    AND NFE_CODEMP = FIS_CODEMP ';
    End;

    Result := strSQL;
  End;

  Procedure pConsultaAntiga;
  Begin
    objConsulta.pIncluiSubConsulta('FIS_C_G_C_',  'FR.FOR_C_G_C_');
    objConsulta.pIncluiSubConsulta('FIS_C_G_C2',  'CLI.CLI_C_G_C_');
    objConsulta.pIncluiTrocaWhere(2, 'FR.FOR_C_G_C_', 'CLI.CLI_C_G_C_');

    objConsulta.pIncluiSubConsulta('FIS_NOMDES', 'FR.FOR_NOMFOR');
    objConsulta.pIncluiSubConsulta('FIS_NOMDE2', 'CLI.CLI_NOMCLI');
    objConsulta.pIncluiTrocaWhere(2, 'FR.FOR_NOMFOR', 'CLI.CLI_NOMCLI');

    If Not blnTemCampoCalculadoFIS_VALOR_ Then
    Begin
      objConsulta.pIncluiSubConsulta('FIS_VALOR_', '(IFNULL(F.FIS_VLCON1, 0) + IFNULL(F.FIS_VLCON2, 0) + ' +
                                                   ' IFNULL(F.FIS_VLCON3, 0) + IFNULL(F.FIS_VLCON4, 0) + ' +
                                                   ' IFNULL(F.FIS_VLCON5, 0))');
    End;

    arrSQLConsulta    := [fSQLCadFis(True{blnFornecedor}),  fSQLWhere(True), 'UNION ALL',
                          fSQLCadFis(False{blnFornecedor}), fSQLWhere(True)];

    arrCamposConsulta := arrTitCol;
  End;

  function fTemCampoCalculadoFIS_VALOR_: Boolean;
   var
     qryAux: TUniQuery;
  Begin
    Result := True;
    qryAux := fCriaQuery;
    Try
      qryAux.Close;
      qryAux.Sql.Clear;
      qryAux.Sql.Add('SELECT FIS_VALOR_ FROM CADFIS WHERE FALSE; ');
      Try
        qryAux.Open;
      except
        Result := False;
      End;
    Finally
      FreeAndNil(qryConsulta);
    End;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      blnCadFaz := (tplConsulta In [conNotaComplemento, conCartaCorrecao, conNFCeComplementar]) And Not fEmptyStr(strCodFaz) And fCfgSis('CADFAZ', varBoolean);

      objConsulta := TDefMascaraCadFisCGC.Create;
      objConsulta.pAdicionaTabela('CADFIS', 'F');
      strTitulo := 'Consulta de Livros Fiscais';

      blnTemCampoCalculadoFIS_VALOR_ := fTemCampoCalculadoFIS_VALOR_;

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['FIS_NUMDOC','FIS_NUMDO2','FIS_CLFSC1','FIS_ESPDOC','FIS_FORCLI'],
                   '',
                   'CADFIS',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'FIS_NUMDOC',
                   objConsulta) Then
      Begin
        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);
      FreeAndNil(objLoadSql);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

Procedure pPesqPedOrcSqlSimples(strCodEmp : String; Var strSQL, strWhere: String;
                                Var arrTitCol: TColunasArray);
Begin
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  FGO_NUMDOC, ';
  strSQL := strSQL + '  FGO_ESPDOC, ';
  strSQL := strSQL + '  FGO_CODEMP, ';
  strSQL := strSQL + '  FGO_CODCLI, ';
  strSQL := strSQL + '  CLI_NOMCLI, ';
  strSQL := strSQL + '  CLI_FANSOB, ';
  strSQL := strSQL + '  CLI_EMAIL_, ';
  strSQL := strSQL + '  FGO_CODVEN, ';
  strSQL := strSQL + '  FGO_DTAENT, ';
  strSQL := strSQL + '  FGO_CONPAG, ';
  strSQL := strSQL + '  FGO_VLRCON, ';
  strSQL := strSQL + '  FATGOR.AUTOINCREM ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  FATGOR, ';
  strSQL := strSQL + '  CADCLI, ';
  strSQL := strSQL + '  EXTGOR ';

  strWhere := strWhere + IIF(fEmptyStr(Trim(strWhere)), 'WHERE TRUE ', '');

  strWhere := strWhere + '  AND FGO_CODCLI = CLI_CODCLI AND ';
  strWhere := strWhere + '  FGO_CODEMP = "' + VS_strCodEmp + '" AND ';
  strWhere := strWhere + '  FGO_ESPDOC = "PD" ';
  strWhere := strWhere + '  AND FGO_SEQFGO = FATGOR.AUTOINCREM ';

  {***************************************}
  {* TÍTULO DA COLUNA E MÁSCARA DO CAMPO *}
  {************************************RV*}
  SetLength(arrTitCol, 11);
  arrTitCol[00] := 'Documento';
  arrTitCol[01] := 'Esp.';
  arrTitCol[02] := 'Emp.';
  arrTitCol[03] := 'Cód. Cliente';
  arrTitCol[04] := 'Nome Cliente';
  arrTitCol[05] := 'Nome Fantasia';
  arrTitCol[06] := 'E-mail';
  arrTitCol[07] := 'Vendedor';
