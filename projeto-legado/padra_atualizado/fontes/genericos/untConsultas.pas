function fPesqPedidoCompra(Self       : TForm;                           {* Formulário                                 *}
                           edtCodPed  : TCustomEdit;                     {* Edit do Código                             *}
                           qryTabela  : TUniQuery;                       {* Query                                      *}
                           Var chrKey : Char;                            {* Key                                        *}
                           Var arrSel : TConsultasArray;                 {* Array de Seleção                           *}
                           Var strDoc : String;                          {* Espécie de Documento                       *}
                           strCodEmp  : String;                          {* Código da Empresa                          *}
                           intIndice  : Integer;                         {* Pedido ou Orçamento                        *}
                           blnConSim  : Boolean = True;                  {* ConsultaSimples ou Múltipla (multi select) *}
                           objFrmPnl  : TPanelCx = Nil;                  {* Painel                                      *}
                           strLitGal  : String = '3.600';
                           strTitulo  : String = 'Consulta de Pedidos de Compra';
                           blnLotPre  : Boolean = False;
                           blnRetNumPed : Boolean = False;               {* Retorna pedido no lugar do incremento       *}
                           strDtaIni   : string = '';
                           strDtaFin   : string = '';
                           blnAberto   : Boolean = True): Boolean;
  var
    strSQL     : String;
    strCodPes  : String;
    strGroup   : String;
    arrTitCol  : TColunasArray;                                           {* Títulos das Colunas                         *}
    objConsulta: TDefConsultaPedidoCompra;
    qryConsulta: TUniQuery;
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean; strDtaIni, strDtaFin: string): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If intIndice = 0 Then
    Begin
      strWhere := strWhere + '  AND PCG_ESPDOC = "PD" ';
      strDoc := 'PD';

      If fCfgSis('USACON', varBoolean) Then
        strWhere := strWhere + '  AND PCG_DTALIB IS NULL ';
    End
    Else
    Begin
      strWhere := strWhere + '  AND PCG_ESPDOC = "OR" ';
      strDoc := 'OR';
    End;

    strWhere := strWhere + '  AND PCG_NUMCTN = 0 ';

    If blnAberto Then
      strWhere := strWhere + '  AND (PCG_BAIXAD = FALSE OR PCG_BAIXAD IS NULL) ';

    If not blnAberto Then
      strWhere := strWhere + '  AND (PCG_BAIXAD = TRUE AND PCG_BAIXAD IS NOT NULL) ';

    If Not fEmptyStr(strCodEmp) Then
      strWhere := strWhere + '  AND PCG_CODEMP  = ' + QuotedStr(strCodEmp) + ' ';

    If blnLotPre Then
    Begin
      // SE NÃO HÁ ITENS BAIXADOS
      strWhere := strWhere + '  AND (SELECT COUNT(*) FROM PCMDET ';
      strWhere := strWhere + '       WHERE ';
      strWhere := strWhere + '         PCD_NUMPED = PCG_NUMPED AND ';
      strWhere := strWhere + '         PCD_CODEMP = PCG_CODEMP AND ';
      strWhere := strWhere + '         PCD_ESPDOC = PCG_ESPDOC AND ';
      strWhere := strWhere + '         PCD_NUMCTN = 0 AND ';
      strWhere := strWhere + '         PCD_BAIXAD <> 0   ';
      strWhere := strWhere + '       ) = 0 ';

      // SE NÃO HÁ ITENS PARA ATUALIZAR PREÇOS
      strWhere := strWhere + '  AND (SELECT COUNT(*) FROM PCMDET ';
      strWhere := strWhere + '       WHERE ';
      strWhere := strWhere + '         PCD_NUMPED = PCG_NUMPED AND ';
      strWhere := strWhere + '         PCD_CODEMP = PCG_CODEMP AND ';
      strWhere := strWhere + '         PCD_ESPDOC = PCG_ESPDOC AND ';
      strWhere := strWhere + '         PCD_NUMCTN = 0 AND ';
      strWhere := strWhere + '         PCD_BAIXAD = 0 AND ';
      strWhere := strWhere + '         IFNULL(PCD_PREATU, "N") = "N" ';
      strWhere := strWhere + '       ) > 0 ';
    End;

    strWhere := strWhere + IIF((not fEmptyStr(strDtaIni)) and (not fEmptyStr(strDtaFin)), '  AND PCG_DTAENT BETWEEN ' + QuotedStr(strDtaIni) + ' AND ' + QuotedStr(strDtaFin) + ' ', '');

    Result := strWhere;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin
    If fCfgSis('COTDOR', varBoolean) Then
    Begin
      objLoadSql.fIncluiSubConsulta('EM_DOLAR', ' IF(PCG_MOEDA_ = 1, "Sim", "Não") ','Em Dólar');
    End;

    If SameText(fCfgSis('LITGAL'), 'L') Then
    Begin
      objLoadSql.fIncluiSubConsulta('PCG_LITRAG','  SUM((IF(PCD_QTDITE - PCD_QTDBAI > 0, PCD_QTDITE - PCD_QTDBAI, 0) * ' +
                                    '      (SELECT UNI_PESLIT ' +
                                    '       FROM CADUNI '       +
                                    '       WHERE UNI_CODUNI = PCD_CODUNI LIMIT 1))) ','Litros/Kilos');
    End Else
    Begin
      objLoadSql.fIncluiSubConsulta('PCG_LITRAG','  SUM((IF(PCD_QTDITE - PCD_QTDBAI > 0, PCD_QTDITE - PCD_QTDBAI, 0) * ' +
                                    '      (SELECT UNI_PESLIT /' + strLitGal +
                                    '       FROM CADUNI ' +
                                    '       WHERE UNI_CODUNI = PCD_CODUNI LIMIT 1))) ','Galonagem');
    End;

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False, strDtaIni, strDtaFin));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

  Procedure pConsultaAntiga;
  Begin
    strSQL := '';

    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  PCG_NUMPED, ';      pAddNomeColuna('Pedido');
    strSQL := strSQL + '  PCG_CODEMP, ';      pAddNomeColuna('Emp.Ori.');

    strSQL := strSQL + '  PCGEMPDES, ';       pAddNomeColuna('Emp.Dest.');
    objConsulta.pIncluiSubConsulta('PCGEMPDES', '(IF(PCG_EMPDES IS NULL, "   ", PCG_EMPDES))');

    strSQL := strSQL + '  PCG_ESPDOC, ';      pAddNomeColuna('Espécie');
    strSQL := strSQL + '  PCG_CODFOR, ';      pAddNomeColuna('Cód. Forn.');
    strSQL := strSQL + '  FOR_NOMFOR, ';      pAddNomeColuna('Fornecedor');
    strSQL := strSQL + '  PCG_DTAPED, ';      pAddNomeColuna('Dta. Ped.');
    strSQL := strSQL + '  PCG_DTAENT, ';      pAddNomeColuna('Dta. Entrega');
    strSQL := strSQL + '  PCG_DTAFAT, ';      pAddNomeColuna('Dta. Faturamento');
    strSQL := strSQL + '  PCG_CONPAG, ';      pAddNomeColuna('Cond. Pagto.');

    strSQL := strSQL + '  PCG_STATUS, ';
    objConsulta.pIncluiSubConsulta('PCG_STATUS', '(IF((SELECT SUM(PCD_QTDBAI) FROM PCMDET D WHERE D.PCD_NUMPED = PCG_NUMPED '+
                                                                                               ' AND D.PCD_CODEMP = PCG_CODEMP '+
                                                                                               ' AND D.PCD_CODFOR = PCG_CODFOR '+
                                                                                               ' AND D.PCD_ESPDOC = PCG_ESPDOC '+
                                                                'GROUP BY  D.PCD_NUMPED,D.PCD_CODEMP, D.PCD_ESPDOC, D.PCD_CODFOR ) '+
                                                                                              '<= 0, "NÃO RECEB.", ' + ifThen(blnAberto, '"RECEB. PARC."', '"BAIXADO"') + '))');
    pAddNomeColuna('Status');
    objConsulta.pIncluiCampoSimNao('PCG_STATUS', ['Não Receb.', ifThen(blnAberto, 'Receb. Parc.', 'Baixado')]);

    If fCfgSis('CONCOL', varBoolean) Then
    Begin
      strSQL := strSQL + '  PCG_ORDCON, ';
      pAddNomeColuna('Ordem de Compra no Fornecedor');
    End;

    strSQL := strSQL + '  PCG_TOTITE, ';      pAddNomeColuna('Total Itens');
    strSQL := strSQL + '  PCG_TOTIPI, ';      pAddNomeColuna('Total IPI');
    strSQL := strSQL + '  PCG_TOTSUB, ';      pAddNomeColuna('Total SUB');
    strSQL := strSQL + '  PCG_SUBFCP, ';      pAddNomeColuna('Total SUB FCP');

    strSQL := strSQL + '  PCG_TOTFRE, ';      pAddNomeColuna('Total Frete');
    objConsulta.pIncluiSubConsulta('PCG_TOTFRE', '(IF(PCG_VALFRE IS NULL OR PCG_VALFRE = "", 0.00, PCG_VALFRE))');


    strSQL := strSQL + '  PCG_TOTGER, ';      pAddNomeColuna('Total Pedido');

    If fCfgSis('COTDOR', varBoolean) Then
    Begin
      strSQL := strSQL + ' (IF(PCG_MOEDA_ = 1, "Sim", "Não")) AS EM_DOLAR, ';        pAddNomeColuna('Em Dólar');
      objConsulta.pIncluiCampoSimNao('EM_DOLAR');
    End;

    strSQL := strSQL + '  PCG_NUMCOT, ';      pAddNomeColuna('Cotação de Origem');
    objConsulta.pIncluiSubConsulta('PCG_NUMCOT', 'CONCAT(PCG_NUMCOT, "-", PCG_EMPCOT)');

    If SameText(fCfgSis('LITGAL'), 'L') Then
    Begin
      strSQL := strSQL + '  PCG_LITRAG, ';      pAddNomeColuna('Litros/Kilos');
      objConsulta.pIncluiSubConsulta('PCG_LITRAG', '  (SUM((IF(PCD_QTDITE - PCD_QTDBAI > 0, PCD_QTDITE - PCD_QTDBAI, 0) * ' +
                                                  '      (SELECT UNI_PESLIT ' +
                                                  '       FROM CADUNI '       +
                                                  '       WHERE UNI_CODUNI = PCD_CODUNI LIMIT 1))))');
    End Else
    Begin
      strSQL := strSQL + '  PCG_LITRAG, ';      pAddNomeColuna('Galonagem');
      objConsulta.pIncluiSubConsulta('PCG_LITRAG',  '  (SUM((IF(PCD_QTDITE - PCD_QTDBAI > 0, PCD_QTDITE - PCD_QTDBAI, 0) * ' +
                                                   '      (SELECT UNI_PESLIT /' + strLitGal +
                                                   '       FROM CADUNI ' +
                                                   '       WHERE UNI_CODUNI = PCD_CODUNI LIMIT 1))))');
    End;

    strSQL := strSQL + '  PESBRU, ';      pAddNomeColuna('Peso Bruto');
    objConsulta.pIncluiSubConsulta('PESBRU', '(SUM(IF(PCD_QTDITE - PCD_QTDBAI > 0, PCD_QTDITE - PCD_QTDBAI, 0) * IFNULL(ITE_PESOIT, 0)))');

    If (fCfgSis('LIBPCM', varBoolean)) Then
    Begin
      strSQL := strSQL + 'PEDLIB, ';
      objConsulta.pIncluiSubConsulta('PEDLIB', '(IF(IFNULL(PCG_PEDLIB, "") = "", "Pendente", "Liberado"))');
      pAddNomeColuna('Liberação');
      objConsulta.pIncluiCampoSimNao('PEDLIB', ['Pendente', 'Liberado']);
    End;

    strSQL := strSQL + '  PCG_DOCORI, ';      pAddNomeColuna('Doc. Orig.');

    If fCfgSis('CPDORI', varBoolean) Then
    Begin
      objConsulta.pIncluiSubConsulta('PCG_ORIGAR', '(IF((COALESCE((SELECT COUNT(1) ' +
                                                   '            FROM MOVGAE D ' +
                                                   '           WHERE D.GAE_NUMENV = PCG_ORIGND' +
                                                   '             AND D.GAE_ESPENV = PCG_ORIGES ' +
                                                   '             AND D.GAE_EMPENV = PCG_ORIGEP) , 0) > 0) OR '+
                                                   ' (COALESCE((SELECT COUNT(1)                               ' +
                                                   '  FROM PCMDET                                             ' +
                                                   '    INNER JOIN SEQGAR ON SEQ_PCMDET = PCMDET.AUTOINCREM   ' +
                                                   '  WHERE PCD_NUMPED = PCG_NUMPED                           ' +
                                                   '    AND PCD_CODEMP = PCG_CODEMP                           ' +
                                                   '    AND PCD_NUMCTN = PCG_NUMCTN                           ' +
                                                   '    AND PCD_ESPDOC = PCG_ESPDOC),0) > 0 ), "SIM", "NÃO" )) ');

    End
    Else
    begin
      objConsulta.pIncluiSubConsulta('PCG_ORIGAR', '(IF((COALESCE((SELECT COUNT(1) ' +
                                                   '            FROM MOVGAE D ' +
                                                   '           WHERE D.GAE_NUMENV = SUBSTRING(PCG_DOCORI,1,' + IntToStr(fTamDocCadRec) + ')' +
                                                   '             AND D.GAE_ESPENV = SUBSTRING(PCG_DOCORI,' + IntToStr(IIf(fTamDocCadRec = 6, 7, 13)) + ',2) ' +
                                                   '             AND D.GAE_EMPENV = SUBSTRING(PCG_DOCORI, LENGTH(PCG_DOCORI) - 2, LENGTH(PCG_DOCORI))) , 0) > 0) OR '+
                                                   ' (COALESCE((SELECT COUNT(1)                               ' +
                                                   '  FROM PCMDET                                             ' +
                                                   '    INNER JOIN SEQGAR ON SEQ_PCMDET = PCMDET.AUTOINCREM   ' +
                                                   '  WHERE PCD_NUMPED = PCG_NUMPED                           ' +
                                                   '    AND PCD_CODEMP = PCG_CODEMP                           ' +
                                                   '    AND PCD_NUMCTN = PCG_NUMCTN                           ' +
                                                   '    AND PCD_ESPDOC = PCG_ESPDOC),0) > 0 ), "SIM", "NÃO" )) ');
    End;


    strSQL := strSQL + '  PCG_ORIGAR, ';  pAddNomeColuna('Garantia');

    strSQL := strSQL + '  FOR_NOMFAN, ';      pAddNomeColuna('Fornecedor (Fantasia)');

    strSQL := strSQL + ' PCG_NOMCOM, ';      pAddNomeColuna('Nome do Comprador');
    objConsulta.pIncluiSubConsulta('PCG_NOMCOM', '(CONCAT(PCG_CODCMP, "-", B.OPE_NOMOPE))');


    strSQL := strSQL + ' TRANFERE, ';      pAddNomeColuna('Transferência');
    objConsulta.pIncluiSubConsulta('TRANFERE', '(IF((IFNULL(EF.EMP_FORFIL, "") <> "") AND (IFNULL(PCG_DOCORI, "") <> ""), "SIM", "NÃO")) ');
    objConsulta.pIncluiCampoSimNao('TRANFERE');



    strSQL := strSQL + '  PCG_DTAMAI, ';      pAddNomeColuna('Data Envio Email');
    strSQL := strSQL + '  PCG_HORMAI, ';      pAddNomeColuna('Hora Envio Email');

    strSQL := strSQL + '  PCG_NOPEMA, ';      pAddNomeColuna('Operador que enviou Email');
    objConsulta.pIncluiSubConsulta('PCG_NOPEMA', '(CONCAT(PCG_OPEMAI, "-", A.OPE_NOMOPE))');

    strSQL := strSQL + '  PCG_NOMMAI, ';      pAddNomeColuna('Nome Destinatário Email');
    strSQL := strSQL + '  PCG_DESMAI, ';      pAddNomeColuna('Endereço Destinatário Email');
    strSQL := strSQL + '  PCG_NUMPOK, ';      pAddNomeColuna('Pedido Site');

    strSQL := strSQL + '  PRENOTA, ';      pAddNomeColuna('Pré-Nota');
    objConsulta.pIncluiSubConsulta('PRENOTA', '  (IF((SELECT  COUNT(1) ' +
                                              '        FROM PEDELE P  ' +
                                              '   LEFT JOIN GERELE ON PEL_SEQELE = GERELE.AUTOINCREM '+
                                              '       WHERE P.PEL_NUMDOC = PCG_NUMPED ' +
                                              '         AND P.PEL_ESPDOC = PCG_ESPDOC ' +
                                              '         AND P.PEL_CODEMP = PCG_CODEMP ' +
                                              '         AND P.PEL_CODFOR = PCG_CODFOR ' +
                                              '         AND GERELE.GER_DOCENT IS NULL ' +
                                              '                   ) > 0, "Sim", "Não"))' );
    strSQL := strSQL + '  C.CID_NOMCID, '; pAddNomeColuna('Cidade');

    strSQL := strSQL + '  PCG_DTAALT, ';
    objConsulta.pIncluiSubConsulta('PCG_DTAALT', '(IF((SELECT COUNT(1) FROM LOGDPD WHERE LOGDPD.LOG_PCGSEQ = PCMGER.AUTOINCREM) > 0, "Sim", "Não"))' );
    pAddNomeColuna('Pedido com nova data de entrega');
    objConsulta.pIncluiCampoSimNao('PCG_DTAALT', ['Sim', 'Não']);

    strSQL := strSQL + '  ITENS_PEDIDO, ';
    objConsulta.pIncluiListaForcaContida('ITENS_PEDIDO');
    objConsulta.pIncluiSubConsulta('ITENS_PEDIDO', '(SELECT GROUP_CONCAT(PCD_CODITE )FROM PCMDET ' +
                                                   '  WHERE PCMDET.PCD_NUMPED = PCG_NUMPED ' +
                                                   '    AND PCMDET.PCD_CODEMP = PCG_CODEMP ' +
                                                   '    AND PCMDET.PCD_ESPDOC = PCG_ESPDOC ' +
                                                   '    AND PCMDET.PCD_CODFOR = PCG_CODFOR) ');
    pAddNomeColuna('Código Item');

    strSQL := strSQL + '  PCGOBSPD, ';
    objConsulta.pIncluiSubConsulta('PCGOBSPD', '(REPLACE(REPLACE(CONCAT(COALESCE(PCG_OBSPD1, ""), " ", COALESCE(PCG_OBSPD2, ""), " ", COALESCE(PCG_OBSPD3, ""), " ", COALESCE(PCG_OBSPD4, ""), " ", COALESCE(PCG_OBSPD5, ""), " ", COALESCE(PCG_OBSPD6, "")), "\n", " "), "<<csq>>", " "))' );
    pAddNomeColuna('Observações');

    (**************************************************************)
    (* COLUNAS QUE NAO VAO APARECER DEVEM FICAR DAQUI PARA BAIXO  *)
    (**************************************************************)
    strSQL := strSQL + '  PCMGER.AUTOINCREM, ';
    strSQL := strSQL + '  PCG_NUMCTN, ';
    strSQL := strSQL + '  PCG_DIACOM, ';
    strSQL := strSQL + '  PCG_DIANVA, ';
    strSQL := strSQL + '  PCG_DIANVB, ';
    strSQL := strSQL + '  PCG_DIANVC, ';

    strSQL := strSQL + '  CASE PCG_ESPDOC ';
    strSQL := strSQL + '      WHEN "OR" THEN ';
    strSQL := strSQL + '          (CONCAT(COALESCE(PCG_OBS001, ""), COALESCE(PCG_OBS002, ""), COALESCE(PCG_OBS003, ""), COALESCE(PCG_OBS004, ""), COALESCE(PCG_OBS005, ""), COALESCE(PCG_OBS006, ""))) ';
    strSQL := strSQL + '      ELSE ';
    strSQL := strSQL + '          (CONCAT(COALESCE(PCG_OBSPD1, ""), COALESCE(PCG_OBSPD2, ""), COALESCE(PCG_OBSPD3, ""), COALESCE(PCG_OBSPD4, ""), COALESCE(PCG_OBSPD5, ""), COALESCE(PCG_OBSPD6, ""))) ';
    strSQL := strSQL + '  END AS OBSMEMO ';

    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  PCMGER ';
    strSQL := strSQL + '  JOIN CADFOR ON FOR_CODFOR = PCG_CODFOR ';
    strSQL := strSQL + '  JOIN PCMDET ON PCG_NUMPED = PCD_NUMPED AND PCG_CODFOR = PCD_CODFOR AND PCG_ESPDOC = PCD_ESPDOC AND PCG_NUMCTN = PCD_NUMCTN ';
    strSQL := strSQL + '  LEFT JOIN CADEMP EF ON EF.EMP_FORFIL =  PCG_CODFOR ';
    strSQL := strSQL + '  AND PCG_ESPDOC = PCD_ESPDOC ';
    strSQL := strSQL + '  AND PCG_CODEMP = PCD_CODEMP ';

    strSQL := strSQL + '  JOIN CADITE ON ITE_CODITE = PCD_CODITE ';

    strSQL := strSQL + '  INNER JOIN CADEMP EP ON EP.EMP_CODEMP = PCG_CODEMP ';
    strSQL := strSQL + '    AND EP.EMP_EMPATI = "S" ';

    strSQL := strSQL + '  INNER JOIN CADEMP ED ON ED.EMP_CODEMP = IFNULL(PCG_EMPDES, PCG_CODEMP) ';
    strSQL := strSQL + '    AND ED.EMP_EMPATI = "S" ';

    strSQL := strSQL + '  LEFT JOIN CADOPE A ON A.OPE_CODOPE = PCG_OPEMAI ';
    strSQL := strSQL + '  LEFT JOIN CADOPE B ON B.OPE_CODOPE = PCG_CODCMP ';
    strSQL := strSQL + '  LEFT JOIN CADCID C ON C.CID_CODCID  = CADFOR.FOR_CODCID ';

    strGroup := strGroup + '  GROUP BY PCG_NUMPED, PCG_ESPDOC, PCG_CODEMP ';

    arrSQLConsulta    := [strSQL, fSQLWhere(True, strDtaIni, strDtaFin), strGroup];

    arrCamposConsulta := arrTitCol;
  End;
Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin
    chrKey := #0;

    objConsulta := TDefConsultaPedidoCompra.Create;
    objConsulta.pIncluiCampoSimNao('PCG_ORIGAR');
    objConsulta.pIncluiCampoSimNao('PRENOTA');
    objConsulta.pAdicionaTabela('PCMGER', '');

    If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
    Begin
      pTrataConsultaConfigurada;
    End Else
    Begin
      pConsultaAntiga;
    End;

    strCodPes := IIF(not blnRetNumPed, 'AUTOINCREM', 'PCG_NUMPED');

    If Not Assigned(qryTabela) Then
      qryConsulta := fCriaQuery(Nil)
    Else
      qryConsulta := qryTabela;

    If fConsulta(arrSQLConsulta,
                 arrCamposConsulta,
                 ['PCG_NUMPED','FOR_NOMFOR','PCG_CODFOR'],
                 'AUTOINCREM',
                 'PCMGER',
                 Self.Name,
                 strTitulo,
                 qryConsulta,
                 objFrmPnl,
                 blnConSim,
                 arrSel,
                 strCodPes,
                 objConsulta,
                 False,
                 False,
                 '',
                 Nil,
                 True,
                 True,
                 True,
                 Nil,
                 Nil,
                 Nil
                 {VS_Application}) Then
    Begin
      If Assigned(edtCodPed) then
      Begin
        If (edtCodPed Is TMaskEditFocus) Then
          (edtCodPed As TMaskEditFocus).Text := qryConsulta.FieldByName('PCG_NUMPED').AsString {qryConsulta.FieldByName(strCodPes).AsString}
        Else
          edtCodPed.Text := qryConsulta.FieldByName('PCG_NUMPED').AsString{qryConsulta.FieldByName(strCodPes).AsString};
      End;

      If (Length(arrSel) > 1) Then
      Begin

        If Assigned(edtCodPed) then
        Begin
          If (edtCodPed Is TMaskEditFocus) Then
            (edtCodPed As TMaskEditFocus).Text := fStrZero('0', 12)
          Else
            edtCodPed.Text := fStrZero('0', 12);
        End;

      End;

      Result := True;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

    End;

    FreeAndNil(objConsulta);

  End;

End;

{*************************}
{* CONSULTA DE CAMPANHAS *}
{**********************JU*}
function fPesqCampanha(Self       : TForm;                                {* Formulário                                  *}
                       edtCodCam  : TCustomEdit;                          {* Edit do Codigo                              *}
                       edtDesCam  : TEditFocus;                           {* Edit da Descrição                           *}
                       qryConCam  : TUniQuery;                            {* Query                                       *}
                       Var chrKey : Char;                                 {* Key                                         *}
                       Var arrSel : TConsultasArray;                      {* Array de Seleção                            *}
                       blnConSim  : Boolean = True;                       {* Consulta Simples ou Múltipla (multi select) *}
                       strTitulo  : String = 'Consulta de Campanhas';
                       blnRetCod  : Boolean = False): Boolean;
  Var
    arrTitCol  : TColunasArray;                                           {* Títulos das Colunas                         *}
    strSQL     : String;
    qryConsulta: TUniQuery;

    Procedure pAddNomeColuna(strNomCol: String);
    Begin
      SetLength(arrTitCol, Succ(Length(arrTitCol)));
      arrTitCol[High(arrTitCol)] := strNomCol;
    End;

Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin

    chrKey := #0;

    Try

      strSQL := '';
      strSQL := strSQL + ' SELECT ';
      strSQL := strSQL + '   CMG_CODCMG, '; pAddNomeColuna('Código');
      strSQL := strSQL + '   CMG_DESCMG, '; pAddNomeColuna('Descrição');
      strSQL := strSQL + '   CMG_DTAINI, '; pAddNomeColuna('Data Inicial');
      strSQL := strSQL + '   CMG_DTAFIN, '; pAddNomeColuna('Data Final');
      strSQL := strSQL + '   CMG_ATIVA_, '; pAddNomeColuna('Ativa');
      strSQL := strSQL + '   CMG_CODEMP, '; pAddNomeColuna('Empresa');
      strSQL := strSQL + '   AUTOINCREM  ';
      strSQL := strSQL + ' FROM ';
      strSQL := strSQL + '   CAMGER ';

      If Not Assigned(qryConCam) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryConCam;

      If fConsultaConfig([strSQL],
                   arrTitCol,
                   ['CMG_DESCMG','CMG_CODCMG'],
                   'AUTOINCREM',
                   'CAMGER',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   nil,
                   blnConSim,
                   arrSel,
                   IIF(blnRetCod,'CMG_CODCMG','AUTOINCREM')) Then
      Begin
        If Assigned(edtCodCam) then
        Begin
          If (edtCodCam Is TMaskEditFocus) Then
            (edtCodCam As TMaskEditFocus).Text := qryConsulta.FieldByName('CMG_CODCMG').AsString
          Else
            edtCodCam.Text := qryConsulta.FieldByName('CMG_CODCMG').AsString;
        End;

        If Assigned(edtDesCam) Then
          edtDesCam.Text := qryConsulta.FieldByName('CMG_DESCMG').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodCam) then
          Begin
            If (edtCodCam Is TMaskEditFocus) Then
              (edtCodCam As TMaskEditFocus).Text := fStrZero('0', 8)
            Else
              edtCodCam.Text := fStrZero('0', 8);
          End;

          If Assigned(edtDesCam) Then
            edtDesCam.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryConCam) Then
          FreeAndNil(qryConsulta);
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;

  End;

End;

