function fPesqChavesPixContas(Self     : TForm;                      {* Formulário                                  *}
                                edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                                edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                                qryTabela: TUniQuery;                {* Query                                       *}
                                Var chrKey: Char;                    {* Key                                         *}
                                Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                                blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                                ACodigoEmpresa: String = ''): Boolean; {* Código da empresa com direito de acesso   *}
  var
    strSQL,
    strWhere,
    LCodigoEmpresa: String;

    qryConsulta: TUniQuery;

    objConsulta: TDefConsulta;
begin
  Result := False;

  If Not fEntraCons(chrKey) Then
    Exit;

  LCodigoEmpresa := VS_strCodEmp;
  If Not ACodigoEmpresa.IsEmpty Then
    LCodigoEmpresa := ACodigoEmpresa;

  Try
    chrKey := #0;

    strSQL := '';
    strSQL := strSQL + ' SELECT                                       ';
    strSQL := strSQL + '     CCAPIX.PIX_TIPCHV,                       ';
    strSQL := strSQL + '     CCAPIX.PIX_CHAVE_,                       ';
    strSQL := strSQL + '     CONCAT(CADPOR.POR_CODPOR, "-", CADPOR.POR_NOMPOR) AS PORTADOR, ';
    strSQL := strSQL + '     CADCCA.CCA_CODBCO,                       ';
    strSQL := strSQL + '     CADCCA.CCA_CODEMP,                       ';
    strSQL := strSQL + '     CADCCA.CCA_TIPCON,                       ';
    strSQL := strSQL + '     CONCAT(CADCCA.CCA_AGENCI, "-", CCA_CODCTA) AS CONTA, ';
    strSQL := strSQL + '     CCAPIX.AUTOINCREM,                       ';
    strSQL := strSQL + '     CADCCA.CCA_CODBCO AS BANCO               ';
    strSQL := strSQL + ' FROM CCAPIX                                  ';
    strSQL := strSQL + ' INNER JOIN CADCCA ON CADCCA.AUTOINCREM = CCAPIX.PIX_SEQCCA ';
    strSQL := strSQL + ' INNER JOIN CADPOR ON CADPOR.POR_CCAAUT = CADCCA.AUTOINCREM ';

    strWhere := ' WHERE (CADCCA.CCA_CODBCO IN (' + fRetStrToSQLIn(VS_BancosPix) + ') OR (CADCCA.CCA_USASHP="S")) AND ' +
                '  CCAPIX.PIX_ATIVA_="S" AND ' +
                ' ((CADPOR.POR_EMPACE IS NULL OR CADPOR.POR_EMPACE="") OR ' +
                '  LOCATE("' + LCodigoEmpresa + '", CADPOR.POR_EMPACE)) > 0 ';

    If Not Assigned(qryTabela) Then
      qryConsulta := fCriaQuery(Nil)
    Else
      qryConsulta := qryTabela;

    objConsulta := TDefConsulta.Create;

    If fConsulta([strSQL, strWhere],
                ['Tipo de Chave',
                 'Chave',
                 'Portador',
                 'Banco',
                 'Empresa',
                 'Tipo da Conta',
                 'Agência - Conta',
                 'AUTOINCREM'],
                ['PIX_TIPCHV',
                 'PIX_CHAVE_',
                 'PORTADOR',
                 'CCA_CODBCO',
                 'CCA_CODEMP',
                 'CCA_TIPCON',
                 'CONTA'],
                 '',
                 'CCAPIX',
                 Self.Name,
                 'Consulta de chaves Pix das contas',
                 qryConsulta,
                 Nil,
                 blnConSim,
                 arrSel,
                 'AUTOINCREM',
                 objConsulta) Then
    Begin

      If Assigned(edtCodigo) then
      Begin
        If (edtCodigo Is TMaskEditFocus) Then
          (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('AUTOINCREM').AsString
        Else
          edtCodigo.Text := qryConsulta.FieldByName('AUTOINCREM').AsString;

        If Not qryConsulta.FieldByName('PIX_CHAVE_').AsString.IsEmpty Then
          edtDescri.Text := Concat(qryConsulta.FieldByName('PIX_TIPCHV').AsString, '-',
                                   qryConsulta.FieldByName('PIX_CHAVE_').AsString);
      End;

      If (Length(arrSel) > 1) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
          Else
            edtCodigo.Text := fStrZero('0', 8);
        End;
      End;

      Result := True;
    End;

    If Not Assigned(qryTabela) Then
      FreeAndNil(qryConsulta);

    FreeAndNil(objConsulta);
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '');
    End;
  End;
End;

function fPesqOcoRom(Self     : TForm;
                     edtCodigo: TCustomEdit;
                     edtDescri: TEditFocus;
                     qryTabela: TUniQuery;
                     Var chrKey: Char;
                     Var arrSel: TConsultasArray;
                     blnConSim: Boolean = True): Boolean;
  Var
    strSQL,
    strWhere    : String;
    qryConsulta : TUniQuery;
    objConsulta: TDefConsulta;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  AUTOINCREM,       ';
      strSQL := strSQL + '  OCR_CODIGO,       ';
      strSQL := strSQL + '  OCR_DESCRI,       ';
      strSQL := strSQL + '  OCR_CODEMP,       ';
      strSQL := strSQL + 'CASE OCR_TIPOCR ';
      strSQL := strSQL +'   WHEN "" THEN "OCORRÊNCIA PARA ROMANEIOS" ';
      strSQL := strSQL +'   WHEN "N" THEN "OCORRÊNCIA PARA ENTREGAS NÃO REALIZADAS" ';
      strSQL := strSQL +'   WHEN "S" THEN "OCORRÊNCIA PARA ENTREGAS REALIZADAS" ';
      strSQL := strSQL +' END AS OCR_TIPOCR, ';
      strSQL := strSQL + '  OCR_NIVPRI,      ';
      strSQL := strSQL + '  NOTFICACLI      ';
      strSQL := strSQL + 'FROM         ';
      strSQL := strSQL + '  OCOROM     ';

      if Assigned(edtCodigo) Then
        strWhere := ' WHERE OCR_CODIGO = ' + QuotedStr(edtCodigo.Text);

