{* FUNÇÃO CRIDA PARA CHAMADA DA NOVA CONSULTA DE COMISSÃO DE VENDEDORES *}
{*********************************************************************JU*}
function fPesqRecComissaoVen(opcTipCom: TTipoConsultaSimples;
                             Self     : TForm;                       {* Formulário                                  *}
                             edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                             edtDesRec: TEditFocus;                  {* Edit da Descrição do item                   *}
                             qryTabela: TUniQuery;                   {* Query                                       *}
                             Var chrKey: Char;                       {* Key                                         *}
                             Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                             blnConSim: Boolean = True;              {* Consulta Simples ou Múltipla (multi select) *}
                             strTitulo: String = 'Consulta Faixas de Recebimento para Comissão (Vendedor)'): Boolean;
  var
    strSQL     : String;
    strGroup   : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrTitCol: TColunasArray;                                 {* Títulos das Colunas                         *}
    blnRecEmp  : Boolean;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If blnRecEmp Then
      strWhere := strWhere + ' AND (LOCATE(COM_CODEMP, ' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0) ';

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      objConsulta := TDefConsulta.Create;

      SetLength(arrTitCol, 0);
      blnRecEmp := fCfgSis('RECEMP', VarBoolean);
      chrKey := #0;

      If blnRecEmp Then
        strTitulo := 'Consulta Faixas de Recebimento para Comissão (Vendedor por Empresa)';
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + ' COM_CODTAB, '; pAddNomeColuna('Código');

      If blnRecEmp Then
      Begin
        strSQL := strSQL + ' COM_CODEMP, '; pAddNomeColuna('Empresa');
      End;

      strSQL := strSQL + ' COM_DESCRI, '; pAddNomeColuna('Descrição');
      strSQL := strSQL + ' TIPOPE, ';     pAddNomeColuna('Tipo Operador');
      strSQL := strSQL + ' DEP_DESCRI, '; pAddNomeColuna('Departamento');
      strSQL := strSQL + IfThen(blnRecEmp, 'RECCOM', 'COMREC') + '.AUTOINCREM ';
      strSQL := strSQL + 'FROM ';

      If blnRecEmp Then
        strSQL := strSQL + '  RECCOM '
      Else
        strSQL := strSQL + '  COMREC ';

      strSQL := strSQL + 'LEFT JOIN CADDEP ON (DEP_CODIGO = COM_CODDEP) ';

      objConsulta.pIncluiSubConsulta('TIPOPE', 'CASE WHEN (COM_TIPOPE = "T") THEN "DIGITADOR" ' +
                                               '     WHEN (COM_TIPOPE = "A") THEN "ADMINISTRATIVO" ' +
                                               '     WHEN (COM_TIPOPE = "C") THEN "COMPRAS" ' +
                                               '     WHEN (COM_TIPOPE = "m") THEN "MECÂNICO" ' +
                                               '     WHEN (COM_TIPOPE = "I") THEN "VENDEDOR INTERNO" ' +
                                               '     WHEN (COM_TIPOPE = "E") THEN "REPRESENTANTE EXTERNO LOJA" ' +
                                               '     WHEN (COM_TIPOPE = "D") THEN "REPRESENTANTE EXTERNO DISTRIBUIDOR" ' +
                                               '     WHEN (COM_TIPOPE = "S") THEN "SUB-GERENTE" ' +
                                               '     WHEN (COM_TIPOPE = "G") THEN "GERENTE" ' +
                                               '     ELSE "" END ');

      strGroup := '';
      strGroup := strGroup + ' GROUP BY COM_CODTAB ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL,fSQLWhere(True),strGroup],
                   arrTitCol,
                   ['COM_DESCRI','COM_CODTAB'],
                   '',
                   IIF(blnRecEmp, 'RECCOM', 'COMREC'),
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   nil,
                   blnConSim,
                   arrSel,
                   'COM_CODTAB',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('COM_CODTAB').AsString
            Else
              edtCodigo.Text := qryConsulta.FieldByName('COM_CODTAB').AsString;
          End;

          If Assigned(edtDesRec) Then
            edtDesRec.Text := qryConsulta.FieldByName('COM_DESCRI').AsString;

          If (Length(arrSel) > 1) Then
          Begin

            If Assigned(edtCodigo) then
            Begin
              If (edtCodigo Is TMaskEditFocus) Then
                (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
              Else
                edtCodigo.Text := fStrZero('0', 8);
            End;

            If Assigned(edtDesRec) Then
              edtDesRec.Text := '+1';

          End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

      FreeAndNil(objConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

{**************************************************************************}
{* FUNÇÃO CRIDA PARA CHAMADA DA NOVA CONSULTA DE COMISSÃO DE PROFISSONAIS *}
{***********************************************************************JU*}
function fPesqComissaoProf(opcTipCom: TTipoConsultaSimples;
                           Self     : TForm;                       {* Formulário                                  *}
                           edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                           edtDesPro: TEditFocus;                  {* Edit da Descrição do item                   *}
                           qryTabela: TUniQuery;                   {* Query                                       *}
                           Var chrKey: Char;                       {* Key                                         *}
                           Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                           blnOpcInc: Boolean;                     {* Condição para o Where                       *}
                           strTCoPro: String;                      {* Tipo de Comissão Profissional               *}
                           blnConSim: Boolean = True;              {* Consulta Simples ou Múltipla (multi select) *}
                           strTitulo: String = 'Consulta Faixas de Recebimento para Comissão (Profissional)'): Boolean;
  var
    strSQL     : String;
    qryConsulta: TUniQuery;
    intOpcao: Integer;
    arrTitCol: TColunasArray;                                 {* Títulos das Colunas                         *}
  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If blnOpcInc Then
      strWhere := strWhere + ' AND COM_NUMDOC IS NOT NULL ';

    strWhere := strWhere  + ' AND IF(IFNULL(COM_TCOPRO, "") = "", ' + QuotedStr(strTCoPro) +
                                                 ', COM_TCOPRO) = ' + QuotedStr(strTCoPro);
    If intOpcao = 0 then
      Exit
    Else
    if intOpcao = 2 then
    begin
      strWhere := strWhere + ' AND COM_DTABAI IS NOT NULL ';
    end
    else
    if intOpcao = 3 then
    begin
      strWhere := strWhere + ' AND COM_DTABAI IS NULL ';
    end;

    Result := strWhere;
  End;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      SetLength(arrTitCol, 0);
      intOpcao := fMensagem('','OPÇÃO',['TODOS','BAIXADOS','ABERTOS'],1, True);

      chrKey := #0;

      If fEmptyStr(strTCoPro) Then
        strTCoPro := fCfgSis('TCOPRO');

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  COM_CODCOM, '; pAddNomeColuna('Código');
      strSQL := strSQL + '  COM_DTACAD, '; pAddNomeColuna('Dta. Cadastro');
      strSQL := strSQL + '  COM_CREDEB, '; pAddNomeColuna('C/D');
      strSQL := strSQL + '  COM_NUMDOC, '; pAddNomeColuna('Documento');
      strSQL := strSQL + '  COM_ESPDOC, '; pAddNomeColuna('Espécie');
      strSQL := strSQL + '  COM_CODEMP, '; pAddNomeColuna('Empresa');
      strSQL := strSQL + '  COM_VRVEND, '; pAddNomeColuna('Vr. Venda');

      If strTCoPro = '3' Then
      begin
        strSQL := strSQL + ' COM_VRCOMI, '; pAddNomeColuna('Qtd. Pontos');
      end
      Else
      begin
        strSQL := strSQL + ' COM_VRCOMI, '; pAddNomeColuna('Vr. Comissão');
      end;

      strSQL := strSQL + ' CLI_NOMCLI, '; pAddNomeColuna('Nome Cliente');
      strSQL := strSQL + ' DIV_NOMDIV, '; pAddNomeColuna('Nome Profissional');
      strSQL := strSQL + ' GER_CODVEN, '; pAddNomeColuna('Código do Vendedor');
      strSQL := strSQL + ' OPE_NOMOPE, '; pAddNomeColuna('Nome Vendedor');
      strSQL := strSQL + ' COM_DTABAI, '; pAddNomeColuna('Data Baixa');
      strSQL := strSQL + ' COMPRO.AUTOINCREM ';
      strSQL := strSQL + ' FROM      ';
      strSQL := strSQL + ' COMPRO  ';
      strSQL := strSQL + ' LEFT JOIN CADCLI ON (CLI_CODCLI = COM_CODCLI) ';
      strSQL := strSQL + ' LEFT JOIN CADDIV ON (DIV_CODDIV = COM_CODPRO) ';
      strSQL := strSQL + ' LEFT JOIN MOVGER ON (GER_NUMDOC = COM_NUMDOC AND GER_ESPDOC = COM_ESPDOC AND GER_CODEMP = COM_CODEMP AND GER_CODCLI = COM_CODCLI) ';
      strSQL := strSQL + ' LEFT JOIN CADOPE ON (OPE_CODOPE =  GER_CODVEN ) ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrTitCol,
                   ['COM_NUMDOC','DIV_NOMDIV','CLI_NOMCLI','COM_CODCOM'],
                   '',
                   'COMPRO',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   nil,
                   blnConSim,
                   arrSel,
                   'COM_CODCOM',
                   fSQLWhere(False)) Then
      Begin
          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('COM_CODCOM').AsString
            Else
              edtCodigo.Text := qryConsulta.FieldByName('COM_CODCOM').AsString;
          End;

          If Assigned(edtDesPro) Then
            edtDesPro.Text := qryConsulta.FieldByName('COM_CODCOM').AsString;

          If (Length(arrSel) > 1) Then
          Begin

            If Assigned(edtCodigo) then
            Begin
              If (edtCodigo Is TMaskEditFocus) Then
                (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
              Else
                edtCodigo.Text := fStrZero('0', 8);
            End;

            If Assigned(edtDesPro) Then
              edtDesPro.Text := '+1';

          End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqGerelePreNotaEntrada(Self      : TForm;                            {* Formulário                                  *}
                                   qryTabela : TUniQuery;                        {* Query                                       *}
                                   Var strAutoincrem : String;                   {* Autoincrem GERELE                           *}
                                   Var chrKey: Char;                             {* Key                                         *}
                                   Var arrSel: TConsultasArray;                  {* Array de Seleção                            *}
                                   blnConSim : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                                   blnJaAssocidas: Boolean = False;
                                   objFrmPnl: TPanelCx = Nil;
                                   blnRetornoGarantia: Boolean = False): Boolean;          {* Painel                                      *}

  Var
    strSQL     : String;
    strTitulo  : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
    arrTitCol,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';


    If blnRetornoGarantia Then
    begin
      strWhere := strWhere + ' AND GERELE.GER_TIPXML = 10   ';   //xmlCFG_IMPXGRGarantiaRetFornecedor
      strWhere := strWhere + ' AND GER_DOCENT IS NULL ';
    End
    Else
    begin
      if (fCfgSis('FLUPDC', VarBoolean))  then
        strWhere := strWhere + ' AND IF(FOR_MATREV = "M", GER_DTALIB IS NULL AND GER_DTACON IS NOT NULL, GER_DTALIB IS NULL AND GER_DTACON IS NULL) '
      Else
        strWhere := strWhere + ' AND  GER_DTACON IS NULL            ';

      strWhere := strWhere + ' AND IFNULL(GER_CONDIR, "N") <> "S" ';
      strWhere := strWhere + ' AND IFNULL(GER_ENTDIR, "N") <> "S" ';
      strWhere := strWhere + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' ';
        // onde não seja xmlRetornoSimbolico
        strWhere := strWhere + ' AND GERELE.GER_TIPXML <> 6   ';

      IF Not fCfgSis('REFENT', varBoolean) then
       strWhere := strWhere + ' AND GERELE.GER_TIPXML <> 10   ';

      If blnJaAssocidas Then
      Begin
        if Not(fCfgSis('FLUPDC', VarBoolean))  then
          strWhere := strWhere + '   AND GER_DTALIB IS NOT NULL ';

        If fConferenciaDepoisDaEntrada Then
          strWhere := strWhere + ' AND GER_DOCENT IS NOT NULL '
        Else
          strWhere := strWhere + ' AND GER_DOCENT IS NULL ';

      End Else
      Begin
        if Not(fCfgSis('FLUPDC', VarBoolean))  then
          strWhere := strWhere + '  AND GER_DTALIB IS NULL    ';
        strWhere := strWhere + '  AND GER_DOCENT IS NULL    ';
      End;
    End;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    If fConsideraICMSDesoneradoComDesconto(fCadEmp('ESTADO')) Then
      objLoadSQL.fIncluiSubConsulta('VPRODLIQ', 'W07_VPROD + IFNULL(W18_VSERV, 0) - ' + fSQLDescontoNotaXML,'Total Prod.')
    Else
      objLoadSQL.fIncluiSubConsulta('VPRODLIQ', 'W07_VPROD + IFNULL(W18_VSERV, 0) - W10_VDESC', 'Total Prod.');
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    If fConsideraICMSDesoneradoComDesconto(fCadEmp('ESTADO')) Then
      objConsulta.pIncluiSubConsulta('VPRODLIQ', 'W07_VPROD + IFNULL(W18_VSERV, 0) - ' + fSQLDescontoNotaXML)
    Else
      objConsulta.pIncluiSubConsulta('VPRODLIQ', 'W07_VPROD + IFNULL(W18_VSERV, 0) - W10_VDESC');

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE  ';
    strSQL := strSQL + '  B08_NNF    ,       '; pAddNomeColuna('Núm. Nota');
    strSQL := strSQL + '  B07_SERIE  ,       '; pAddNomeColuna('Série');
    strSQL := strSQL + '  B09_DEMI   ,       '; pAddNomeColuna('Emissão');
    strSQL := strSQL + '  VPRODLIQ,          '; pAddNomeColuna('Total Prod.');
    strSQL := strSQL + '  GER_CODFOR ,       '; pAddNomeColuna('Cod. Fornec.');
    strSQL := strSQL + '  FOR_NOMFOR ,       '; pAddNomeColuna('Fornecedor');
    strSQL := strSQL + '  B04_NATOP ,        '; pAddNomeColuna('Natureza da Operação');

    strSQL := strSQL + '  GERELE.AUTOINCREM, ';
    strSQL := strSQL + '  W10_VDESC,         ';
    strSQL := strSQL + '  W04A_VICMSDESON,   ';
    strSQL := strSQL + '  W08_VFRETE,        ';
    strSQL := strSQL + '  W15_VOUTRO,        ';
    strSQL := strSQL + '  W09_VSEG,          ';
    strSQL := strSQL + '  B09_DEMI,          ';
    strSQL := strSQL + '  PR07_CHNFE,        ';
    strSQL := strSQL + '  X31_PESOL,         ';
    strSQL := strSQL + '  X32_PESOB,         ';
    strSQL := strSQL + '  GER_CODEMP,        ';
    strSQL := strSQL + '  GER_TIPXML,        ';
    strSQL := strSQL + '  X33_MODFRETE,      ';
    strSQL := strSQL + '  X34_CNPJ,          ';
    strSQL := strSQL + '  GER_CONPAG         ';

    strSQL := strSQL + 'FROM                           ';
    strSQL := strSQL + '  GERELE                       ';
    strSQL := strSQL + 'INNER JOIN CADFOR ON           ';
    strSQL := strSQL + '  FOR_CODFOR = GER_CODFOR      ';
    arrSQLConsulta    := [strSQL, fSQLWhere(True)];
    arrCamposConsulta := arrTitCol;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      objConsulta := TDefConsulta.Create;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta.pAdicionaTabela('GERELE', '');
      objConsulta.pAdicionaTabela('CADFOR', '');
      strTitulo := 'Consulta Nota Fiscal Eletrônica';

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      if fConsulta(arrSQLConsulta,arrCamposConsulta,
                          ['B08_NNF','B09_DEMI','FOR_NOMFOR','GER_CODFOR'],
                          '',
                          'GERELE',
                          Self.Name,
                          strTitulo,
                          qryConsulta,
                          objFrmPnl,
                          blnConSim,
                          arrSel,
                          'B08_NNF',
                          objConsulta) then
      begin
        Result := True;
        strAutoincrem := qryConsulta.FieldByName('AUTOINCREM').AsString;
      end;



      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqEnderecamentoProduto(Self      : String;                            {* Formulário                                  *}
                                   edtNotEle : TEditFocus;                       {* Edit do Código                              *}
                                   qryTabela : TUniQuery;                        {* Query                                       *}
                                   Var chrKey: Char;                             {* Key                                         *}
                                   Var arrSel: TConsultasArray;                  {* Array de Seleção                            *}
                                   blnConSim : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                                   blnEnderecamentoMarmore: Boolean = False): Boolean;
Var
  strSQL : String;
  strTitulo,
  strWMSPLA: String;
  objConsulta: TDefConsulta;
  qryConsulta: TUniQuery;
  arrTitCol,
  arrSQLConsulta,
  arrCamposConsulta: TColunasArray;
  objLoadSql: TLoadConsultaSQL;
  blnRefEnt: Boolean;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function SQL_ENDEREC_NUMDOC(blnCast: Boolean): String;
  Begin
    IF blnCast then
    begin
      Result := ' IFNULL(GER_ORDPRO, TRIM(MID(FGO_DOCEND, 01, ' + IntToStr(fTamNumDoc) + ')))';
      Result := ' CAST(' + Result + ' AS CHAR(12)) ';
    end
    else
      Result := ' TRIM(MID(FGO_DOCEND, 01, ' + IntToStr(fTamNumDoc) + '))';
  End;

  Function SQL_ENDEREC_ESPDOC(blnCast: Boolean): String;
  Begin
    Result := 'MID(FGO_DOCEND, ' + IntToStr(fTamNumDoc + 1) + ', 2)';

    If blnCast Then
      Result := ' CAST(' + Result + ' AS CHAR(12)) ';
  End;

  Function SQL_ENDEREC_SERIE_(blnCast: Boolean): String;
  Begin
    Result := ' MID(FGO_DOCEND, ' + IntToStr(fTamNumDoc + 3) + ', 3)';

    If blnCast Then
      Result := ' CAST(' + Result + ' AS CHAR(12)) ';
  End;

  Function SQL_ENDEREC_CODEMP(blnCast: Boolean): String;
  Begin
    Result := 'MID(FGO_DOCEND, ' + IntToStr(fTamNumDoc + 6) + ', 3)';

    If blnCast Then
      Result := ' CAST(' + Result + ' AS CHAR(12)) ';
  End;

  Function SQL_ENDEREC_COD_FC(blnCast: Boolean): String;
  Begin
    Result := 'MID(FGO_DOCEND, ' + IntToStr(fTamNumDoc + 9) + ', 8)';

    If blnCast Then
      Result := ' CAST(' + Result + ' AS CHAR(12)) ';
  End;

  Function SQL_ENDEREC_TIP_FC(blnCast: Boolean): String;
  Begin
    Result := 'MID(FGO_DOCEND, ' + IntToStr(fTamNumDoc + 17) + ', 1)';

    If blnCast Then
      Result := ' CAST(' + Result + ' AS CHAR(12)) ';
  End;

  Function SQL_ENDEREC_DTADOC: String;
  Begin
      Result := Result + ' IFNULL(GER_DTADOC,      ';
      Result := Result + ' (SELECT GER_DTADOC FROM ';
      Result := Result + '			  DEL_MOVGER       ';
      Result := Result + '		  WHERE GER_NUMDOC = ' + SQL_ENDEREC_NUMDOC(False);
      Result := Result + '		  AND   GER_ESPDOC = ' + SQL_ENDEREC_ESPDOC(False);
      Result := Result + '		  AND   GER_CODEMP = ' + SQL_ENDEREC_CODEMP(False);
      Result := Result + '      AND ((GER_CODFOR = ' + SQL_ENDEREC_COD_FC(False) +' AND GER_TIP_FC = ' + SQL_ENDEREC_TIP_FC(False) + ')';
      Result := Result + '       OR  (GER_CODCLI = ' + SQL_ENDEREC_COD_FC(False) +' AND GER_TIP_FC = ' + SQL_ENDEREC_TIP_FC(False) + '))';
      Result := Result + '      AND GER_SERIE_   = ' + SQL_ENDEREC_SERIE_(False);
      Result := Result + '		  ))                 ';
      Result := ' CAST(' + Result + ' AS DATE) ';
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND FGO_DOCEND IS NOT NULL AND IFNULL(FGO_BKPEND,"") = "" ';
    strWhere := strWhere + ' AND ' + SQL_ENDEREC_CODEMP(False) + ' = ' + QuotedStr(VS_strCodEmp);
    If fUsaRotinaWMS And fConferenciaDepoisDaEntrada And (fCfgSis('TPLREC', varString) <> 'N') Then
    Begin
      strWhere := strWhere + ' AND (  ';

      If fCfgSis('ENDBAI', varBoolean) And fUsaEnderecamento Then
        strWhere := strWhere + '  ((GER_DTAENT IS NOT NULL OR FGO_MEN001 LIKE "%CANCELAM%" OR MID(FGO_DOCEND, 13, 2) = "OI") AND ADC_SEQGER IS NULL) '
      Else
        strWhere := strWhere + '  ((GER_DTAENT IS NOT NULL OR FGO_MEN001 LIKE "%CANCELAM%") AND ADC_SEQGER IS NULL) ';

      If blnRefEnt Then
      Begin
        strWhere := strWhere + ' OR ';
        strWhere := strWhere + ' ( ';
        strWhere := strWhere + '   (SELECT IF(GROUP_CONCAT( DISTINCT PCD_DOCORI) IS NULL, "N", "S") AS PEDGAR ';
        strWhere := strWhere + '      FROM MOVDET                                                             ';
        strWhere := strWhere + ' 	    	INNER JOIN BAIPED ON BAI_AUTDET = MOVDET.AUTOINCREM                   ';
        strWhere := strWhere + '        INNER JOIN PCMDET ON BAI_AUTPED = PCMDET.AUTOINCREM                   ';
        strWhere := strWhere + '        INNER JOIN MOVGAE ON SUBSTRING(PCD_DOCORI,1,12) = GAE_NUMENV AND SUBSTRING(PCD_DOCORI,13,2) = GAE_ESPENV AND PCD_CODEMP = GAE_EMPENV ';
        strWhere := strWhere + '      WHERE TRUE                                                              ';

        If (strWMSPLA = 'R') Then
          strWhere := strWhere + '      AND MOVDET.DET_DTAENT IS NOT NULL                                     ';

        strWhere := strWhere + '        AND MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ) = "S"                     ';
        strWhere := strWhere + ' )  ';
      End;

      strWhere := strWhere + ' ) ';
    End;
    If blnEnderecamentoMarmore Then
    begin
      strWhere := strWhere + ' AND (SELECT COUNT(1) FROM FATDOR ';
      strWhere := strWhere + '       INNER JOIN CADITE ON ITE_CODITE = FDO_CODITE ';
      strWhere := strWhere + '       WHERE FDO_SEQGER = FATGOR.AUTOINCREM ';
      strWhere := strWhere + '         AND ITE_GRAMAR = "S") > 0 ';
    end;

    {Quando utiliza WMS: Não deve carregar documentos que foram inciados/que foram baixados parcialmente pelo coletor}
    If (fUsaRotinaWMS) And (fCfgSis('TPLREC', varString) <> 'N') Then
      strWhere := strWhere + ' AND (SELECT COUNT(1) FROM FATDOR WHERE FATDOR.FDO_SEQGER = FATGOR.AUTOINCREM AND FDO_QTDBAI > 0 ) = 0  ';

    strWhere := strWhere + ' AND ' + SQL_ENDEREC_ESPDOC(False) + ' <> "TA"';

    Result := strWhere;
  End;

  Procedure pTrataConsultaConfigurada;
  Begin
    If fUsaRotinaWMS And fConferenciaDepoisDaEntrada And (fCfgSis('TPLREC', varString) <> 'N') Then
    Begin
      objLoadSql.stlJoins.Add(' LEFT JOIN AGEDOC ON ADC_CODEMP = ' + SQL_ENDEREC_CODEMP(False) +
                              '                 AND ADC_CODFOR = ' + SQL_ENDEREC_COD_FC(False) +
                              '                 AND ADC_ESPDOC = ' + SQL_ENDEREC_ESPDOC(False) +
                              '                 AND ADC_NUMDOC = ' + SQL_ENDEREC_NUMDOC(False));
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;

  Procedure pConsultaAntiga;
  Begin
    strSQL := '';
    strSQL := strSQL + ' SELECT       ';
    strSQL := strSQL + '   DOCNUM,    ';        pAddNomeColuna('Documento');
    strSQL := strSQL + '   DOCESP,    ';        pAddNomeColuna('Espécie');
    strSQL := strSQL + '   SERIEX,    ';        pAddNomeColuna('Série');
    strSQL := strSQL + '   EMPCOD,    ';        pAddNomeColuna('Emp.');
    strSQL := strSQL + '   FC_COD,    ';        pAddNomeColuna('Código');
    strSQL := strSQL + '   FC_TIP,    ';        pAddNomeColuna('C/F');
    strSQL := strSQL + '   NOM_FC,           '; pAddNomeColuna('Cliente/Fornecedor');
    strSQL := strSQL + '   FATGOR.AUTOINCREM,'; pAddNomeColuna('AUTOINCREM');
    strSQL := strSQL + '   GER_DTAENT,';        pAddNomeColuna('Data Entrada');
    strSQL := strSQL + '   DTADOC, ';           pAddNomeColuna('Data Documento');

    strSQL := strSQL + '   CAST((SELECT IFNULL(MOVDET.DET_DOCDEV,"N/A") AS NUMDOC ' +
                                 'FROM MOVDET ' +
                                 'WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM LIMIT 1) AS CHAR(20)) AS NUMDOC, ';
    pAddNomeColuna('Num Doc Venda') ;

    strSQL := strSQL + '   CAST((SELECT IFNULL(CADOPE.OPE_NOMOPE,"N/A") ' +
                                             'FROM MOVDET ' +
                                             'INNER JOIN CADOPE ON CADOPE.OPE_CODOPE = MOVDET.DET_CODVEN ' +
                                             'WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM LIMIT 1) AS CHAR(50)) AS NOMOPE, ';
    pAddNomeColuna('Operador Venda');

    strSQL := strSQL + '   CAST((SELECT IFNULL(CADOPE.OPE_NOMOPE,"N/A") ' +
                                             'FROM CADOPE WHERE CADOPE.OPE_CODOPE = MOVGER.GER_CODVEN LIMIT 1) AS CHAR(50)) AS OPEDEV, ';
    pAddNomeColuna('Operador Devolução');

    strSQL := strSQL + '  CAST((SELECT IFNULL(CADEMP.EMP_NOMEMP,"N/A") ' +
                                             'FROM MOVDET ' +
                                             'INNER JOIN CADEMP ON CADEMP.EMP_CODEMP = MOVDET.DET_CODEMP ' +
                                             'WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM LIMIT 1) AS CHAR(50)) AS NOMEMP ';
    pAddNomeColuna('Empresa Venda');

    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   EXTGOR ';
    strSQL := strSQL + '   INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FGO_SEQFGO ';
    strSQL := strSQL + '    LEFT JOIN CADCLI ON CLI_CODCLI = ' + SQL_ENDEREC_COD_FC(False);
    strSQL := strSQL + '    LEFT JOIN CADFOR ON FOR_CODFOR = ' + SQL_ENDEREC_COD_FC(False);

    strSQL := strSQL + '    LEFT JOIN MOVGER ON GER_NUMDOC =   ' + SQL_ENDEREC_NUMDOC(False);
    strSQL := strSQL + '                    AND GER_ESPDOC =   ' + SQL_ENDEREC_ESPDOC(False);
    strSQL := strSQL + '                    AND GER_CODEMP =   ' + SQL_ENDEREC_CODEMP(False);
    strSQL := strSQL + '                    AND ((GER_CODFOR = ' + SQL_ENDEREC_COD_FC(False) +' AND GER_TIP_FC = ' + SQL_ENDEREC_TIP_FC(False) + ')';
    strSQL := strSQL + '                     OR (GER_CODCLI =  ' + SQL_ENDEREC_COD_FC(False) +' AND GER_TIP_FC = ' + SQL_ENDEREC_TIP_FC(False) + '))';
    strSQL := strSQL + '                    AND GER_SERIE_  =  ' + SQL_ENDEREC_SERIE_(False);


    (* Quando esta configurado para utilizar o coletor de dados, so é permitido endereçar pedidos pelo autcom,
       quando o Movimento Fiscal esta efetivado (DET_DTAENT <> NULL) e Documentos não Planejados para Entrada e Conferencia
       via coletor (Documento não esta presente na Tabela AGEDOC.
       ----
       Sendo assim só será permitido o endereçamento de Devoluçoes, e esse endereçamento também poderá ser feito via coletor
    *)
    If fUsaRotinaWMS And fConferenciaDepoisDaEntrada And (fCfgSis('TPLREC', varString) <> 'N') Then
    Begin
      strSQL := strSQL + ' LEFT JOIN AGEDOC ON ADC_CODEMP = ' + SQL_ENDEREC_CODEMP(False);
      strSQL := strSQL + '                 AND ADC_CODFOR = ' + SQL_ENDEREC_COD_FC(False);
      strSQL := strSQL + '                 AND ADC_ESPDOC = ' + SQL_ENDEREC_ESPDOC(False);
      strSQL := strSQL + '                 AND ADC_NUMDOC = ' + SQL_ENDEREC_NUMDOC(False);
    End;

    objConsulta.pIncluiSubConsulta('DOCNUM', SQL_ENDEREC_NUMDOC(True));
    objConsulta.pIncluiSubConsulta('DOCESP', SQL_ENDEREC_ESPDOC(True));
    objConsulta.pIncluiSubConsulta('SERIEX', SQL_ENDEREC_SERIE_(True));
    objConsulta.pIncluiSubConsulta('EMPCOD', SQL_ENDEREC_CODEMP(True));
    objConsulta.pIncluiSubConsulta('FC_COD', SQL_ENDEREC_COD_FC(True));
    objConsulta.pIncluiSubConsulta('FC_TIP', SQL_ENDEREC_TIP_FC(True));
    objConsulta.pIncluiSubConsulta('NOM_FC', 'CAST(IF(' + SQL_ENDEREC_TIP_FC(True) + ' = "C", CLI_NOMCLI, FOR_NOMFOR) AS CHAR(255))');
    objConsulta.pIncluiSubConsulta('DTADOC', SQL_ENDEREC_DTADOC);

    arrSQLConsulta    := [strSQL, fSQLWhere(True)];
    arrCamposConsulta := arrTitCol;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strTitulo := 'Consulta de documentos para Endereçamento';
      objConsulta := TDefConsulta.Create;
      objConsulta.pAdicionaTabela('EXTGOR', '');

      blnRefEnt := fCfgSis('REFENT', varBoolean);
      strWMSPLA := fCfgSis('WMSPLA', varString);

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['DOCNUM','DOCESP','EMPCOD'],
                   '',
                   'FATGOR',
                   Self,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   objConsulta) Then
      Begin
        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

end;

Function fSQLNotasEntrada(finalidadeXML: tpeFinalidadeXML; Var strWhere: String; blnOpcSQL: Boolean = False; blnRelCriticas: Boolean = False; strCodCli: String = ''; blnEntAut: Boolean = False): String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + 'SELECT         ';
  strSQL := strSQL + '  B08_NNF    , ';
  strSQL := strSQL + '  B07_SERIE  , ';
  strSQL := strSQL + '  B09_DEMI   , ';

  If blnOpcSQL Then
  Begin

   If fConsideraICMSDesoneradoComDesconto(fCadEmp('ESTADO')) Then
     strSQL := strSQL + ' W07_VPROD + IFNULL(W18_VSERV, 0) - ' + fSQLDescontoNotaXML
   Else
     strSQL := strSQL + ' W07_VPROD + IFNULL(W18_VSERV, 0) - W10_VDESC ';

    strSQL := strSQL + ' AS TOTNOT, ';
  End Else
  Begin
    strSQL := strSQL + '  VPRODLIQ, ';
  End;

  If (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao]) Then
  Begin
    strSQL := strSQL + '  GER_CODCLI , ';
    strSQL := strSQL + '  CLI_NOMCLI , ';
  End Else Begin
    strSQL := strSQL + '  GER_CODFOR , ';
    strSQL := strSQL + '  FOR_NOMFOR , ';
  End;

  strSQL := strSQL + '  GERELE.AUTOINCREM, ';
  strSQL := strSQL + '  W08_VFRETE,        ';
  strSQL := strSQL + '  W15_VOUTRO,        ';
  strSQL := strSQL + '  W09_VSEG,          ';
  strSQL := strSQL + '  B09_DEMI,          ';
  strSQL := strSQL + '  PR07_CHNFE,        ';
  strSQL := strSQL + '  W09_VSEG,          ';
  strSQL := strSQL + '  W10_VDESC,         ';
  strSQL := strSQL + '  X27_QVOL,          ';
  strSQL := strSQL + '  W06A_VFCPST,          ';
  strSQL := strSQL + '  X28_ESP,           ';
  strSQL := strSQL + '  W04A_VICMSDESON,   ';

  strSQL := strSQL + fSQLDescontoNotaXML + ' AS DESCONTO, ';

  strSQL := strSQL + '  GER_ESPNOT,        ';

  strSQL := strSQL + '  GER_CODCLI,        ';
  strSQL := strSQL + '  GER_TIP_FC,        ';
  strSQL := strSQL + '  GER_TIPXML,        ';
  strSQL := strSQL + '  GER_CONDIR,        ';
  strSQL := strSQL + '  GER_ENTDIR         ';

  strSQL := strSQL + 'FROM GERELE          ';

  If (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao]) Then
  Begin
    strSQL := strSQL + 'INNER JOIN CADCLI ON           ';
    strSQL := strSQL + '  CLI_CODCLI = GER_CODCLI      ';
  End
  Else
  Begin
     strSQL := strSQL + 'INNER JOIN CADFOR ON           ';
     strSQL := strSQL + '  FOR_CODFOR = GER_CODFOR      ';
  End;

  strWhere := '';
  strWhere := strWhere + 'WHERE                          ';
  strWhere := strWhere + '  GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
  if not fEmptyStr(strCodCli) then
    strWhere := strWhere + '  AND GER_CODCLI = ' + QuotedStr(strCodCli);

  if not blnRelCriticas then
  begin
    strWhere := strWhere + '  AND GER_DOCENT IS NULL ';

    If fCfgSis('USACON', varBoolean) And (Pos(fCfgSis('CONFME'), '1_3_') > 0) And
      (Not (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao])) Then
    Begin
        if (fCfgSis('FLUPDC', VarBoolean)) and (blnEntAut) then
          strWhere := strWhere + '  AND GER_DTALIB IS NOT NULL AND GER_DTACON IS NOT NULL '
        else
        Begin
          If not fConferenciaDepoisDaEntrada Then
            strWhere := strWhere + '  AND ((GER_DTALIB IS NOT NULL AND (GER_DTACON IS NOT NULL  OR (' + fSQLRetTemCFO_922('GERELE.AUTOINCREM', 'DETELE') + ') > 0)) OR (GER_ENTDIR = "S")) '
          Else
            strWhere := strWhere + '  AND ((GER_DTALIB IS NOT NULL AND GER_DTACON IS NULL) OR (GER_ENTDIR = "S")) ';
        End;
    End;
  end;

  if finalidadeXML  in [xmlCFG_IMPXGRGarantiaRetFornecedor] then
  begin
    strWhere := strWhere + ' AND GER_TIPXML = '+ QuotedStr(IntToStr(Ord(finalidadeXML)));
    strWhere := strWhere + ' AND GER_DTALIB IS NOT NULL ';
    strWhere := strWhere + ' AND GER_ENTDIR = "S" ';
  end
  else
    strWhere := strWhere + ' AND NOT GER_TIPXML IN ('+ QuotedStr(IntToStr(Ord(xmlCFG_IMPXGRGarantiaRetFornecedor)))+') ';

  If finalidadeXML = xmlConsignacaoDevolucaoCliente  Then
    strWhere := strWhere + ' AND GER_TIPXML = 5 ';

  If finalidadeXML = xmlRetornoLocacao  Then
    strWhere := strWhere + ' AND GER_TIPXML = 7 ';


  Result := strSQL;
End;

Procedure pCarregaCabecalhoNota(qryConsulta: TUniQuery; Var recNotEle: TRecInfoNotaEletronica);
  Var
    fltAlq,
    fltPisCofins,
    fltPisCofinsRound, fltPisCofinsTrunc, fltPisCofinsUsado : Double;
    stlAliquotas: TStringList;
    intContador: Integer;
Begin
  With recNotEle, qryConsulta Do
  Begin
    strEntDir := FieldByName('GER_ENTDIR').AsString;
    strConDir := FieldByName('GER_CONDIR').AsString;
    strAutInc := FieldByName('AUTOINCREM').AsString;
    strCodFor := FieldByName('GER_CODFOR').AsString;
    strCodCli := FieldByName('GER_CODCLI').AsString;
    strTip_FC := FieldByName('GER_TIP_FC').AsString;
    finalidadeXML := tpeFinalidadeXML(FieldByName('GER_TIPXML').AsInteger);
    strNumDoc := FieldByName('B08_NNF').AsString;
    strSerDoc := FieldByName('B07_SERIE').AsString;

    strEspNot := FieldByName('GER_ESPNOT').AsString;

    fltValFre := FieldByName('W08_VFRETE').AsFloat;

    fltValDes := FieldByName('DESCONTO').AsFloat;

    fltDesPis := 0;

    If (fltValDes > 0) And fSeparaICMDesoneradoDoDesconto Then
    Begin
      stlAliquotas := TStringList.Create;
      stlAliquotas.Text := AnsiReplaceStr(fCfgSis('PISCOF'), '-', #13#10);
      fltAlq := 0;

      For intContador := 0 To stlAliquotas.Count - 1 Do
        fltAlq := fltAlq + StrToFloatDef(stlAliquotas[intContador], 0);

      //Validação para saber se o desconto está com arredondamento no xml
      fltPisCofins := fltAlq * qryConsulta.FieldByName('W07_VPROD').AsFloat / 100;
      fltPisCofinsTrunc := trunc(fltPisCofins * 100) /100;
      fltPisCofinsRound := RoundTo(fltPisCofins, -2);

      If (RoundTo(recNotEle.fltValDes, -2) = RoundTo(fltPisCofinsTrunc,-2)) Then
        fltPisCofinsUsado := fltPisCofinsTrunc
      Else
        fltPisCofinsUsado := fltPisCofinsRound;

      If (RoundTo(fltValDes, -2) >= RoundTo(fltPisCofinsUsado,-2)) Then
        fltDesPis := fltPisCofinsUsado;

      fltValDes := fltValDes - fltDesPis;

      If fltValDes < 0 Then
        fltValDes := 0;

      FreeAndNil(stlAliquotas);
    End;

    If Assigned(FindField('ICMSDesoneradoEstaNoDescontoComercial')) Then
      blnICMSDesoneradoEstaNoDescontoComercial := FieldByName('ICMSDesoneradoEstaNoDescontoComercial').AsInteger = 1
    Else
      blnICMSDesoneradoEstaNoDescontoComercial := False;

    fltICMDes := FieldByName('W04A_VICMSDESON').AsFloat;
    fltOutras := FieldByName('W15_VOUTRO').AsFloat;
    fltValSeg := FieldByName('W09_VSEG').AsFloat;

    fltQtdVol := FieldByName('X27_QVOL').AsFloat;
    strEspVol := FieldByName('X28_ESP').AsString;
    strModFre := FieldByName('X33_MODFRETE').AsString;
    dtaDtaDoc := FieldByName('B09_DEMI').AsDateTime;
    str_Chave := FieldByName('PR07_CHNFE').AsString;

    fltPesBru := FieldByName('X32_PESOB').AsFloat;
    fltPesLiq := FieldByName('X31_PESOL').AsFloat;

    fltCotDol := FieldByName('GER_COTMOE').AsFloat;

    strCnpjTr := qryConsulta.FieldByName('X34_CNPJ').AsString;

    strMatRev := qryConsulta.FieldByName('GER_MATREV').AsString;
    If fEmptyStr(strMatRev) Then
      strMatRev := fCampoTabela('FOR_MATREV', 'CADFOR', ['FOR_CODFOR'], [strCodFor]);

    fCarregaTransportadoraPeloCnpj(recNotEle.strCnpjTr, recNotEle.strCodTra, recNotEle.strNomTra);

    strNotas  := qryConsulta.FieldByName('B08_NNF').AsString + ' - ' +
                 qryConsulta.FieldByName('GER_CODFOR').AsString + '-' +
                 fRetNomFornecedor(qryConsulta.FieldByName('GER_CODFOR').AsString);

    blnEhNotaImportacao := fVerificarSeEhNotaImportacao(strAutInc);
    blnEhNotaImportacaoAcompanhamento := fVerificarSeEhNotaImportacao(strAutInc, True);
  End;
End;

Function fSQLConsultaXMLParaEntrada: String;
Begin
  Result := 'SELECT GERELE.*, ' +
                   IIF(fSeparaICMDesoneradoDoDesconto, fSQLDescontoNotaXMLSemDesonerado, fSQLDescontoNotaXML) + ' AS DESCONTO, ' +
                 fSQLICMSDesoneradoEstaNoDescontoComercial + ' AS ICMSDesoneradoEstaNoDescontoComercial ' +
                  ' FROM GERELE ';
End;

function fPesqGereleDigPedido(Self      : TForm;                            {* Formulário                                  *}
                              edtNotEle : TEditFocus;                       {* Edit do Código                              *}
                              qryTabela : TUniQuery;                        {* Query                                       *}
                              Var recNotEle : TRecInfoNotaEletronica;       {* Usado para nota fiscal eletronica           *}
                              Var chrKey: Char;                             {* Key                                         *}
                              Var arrSel: TConsultasArray;                  {* Array de Seleção                            *}
                              blnConSim : Boolean       ;                   {* Consulta Simples ou Múltipla (multi select) *}
                              finalidadeXML : tpeFinalidadeXML;             {* Finalidade para qual o XML foi importado    *}
                              blnRelCriticas: Boolean;                      {* Editor consulta, filtro apenas por empresa  *}
                              strCodCli: String): Boolean;
Var
  strSQL, strWhere, strTitulo : String;
  qryConsulta: TUniQuery;
  objConsulta: TDefConsulta;
  arrTitCol,
  arrSQLConsulta,
  arrCamposConsulta: TColunasArray;
  objLoadSql: TLoadConsultaSQL;
  strNotas: String;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strSQLWhere: String;
  Begin
    If blnCompleto Then
      strSQLWhere := ' WHERE TRUE '
    Else
    Begin
      strSQLWhere := '';
      strSQLWhere := strSQLWhere + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
      strSQLWhere := strSQLWhere + ' AND GER_DOCENT IS NULL ';

      if finalidadeXML  in [xmlCFG_IMPXGRGarantiaRetFornecedor] then
      begin
        strSQLWhere := strSQLWhere + ' AND GER_TIPXML = '+ QuotedStr(IntToStr(Ord(finalidadeXML)));
        strSQLWhere := strSQLWhere + ' AND GER_DTALIB IS NOT NULL ';
        strSQLWhere := strSQLWhere + ' AND GER_ENTDIR = "S" ';
      end
      else
        strSQLWhere := strSQLWhere + ' AND NOT GER_TIPXML IN ('+ QuotedStr(IntToStr(Ord(xmlCFG_IMPXGRGarantiaRetFornecedor)))+') ';

      If fCfgSis('USACON', varBoolean) And (Pos(fCfgSis('CONFME'), '1_3_') > 0) And (Not (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao])) Then
      Begin
        If not fConferenciaDepoisDaEntrada Then
          strSQLWhere := strSQLWhere + '  AND ((GER_DTALIB IS NOT NULL AND GER_DTACON IS NOT NULL) OR (GER_ENTDIR = "S")) '
        Else
          strSQLWhere := strSQLWhere + '  AND ((GER_DTALIB IS NOT NULL AND GER_DTACON IS NULL) OR (GER_ENTDIR = "S")) ';
      End;
    End;

    strSQLWhere := strSQLWhere + AnsiReplaceStr(strWhere,'WHERE',' AND ');

    Result := strSQLWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin
    If fConsideraICMSDesoneradoComDesconto(fCadEmp('ESTADO')) Then
    Begin
      objLoadSQL.fIncluiSubConsulta('VPRODLIQ', ' W07_VPROD + IFNULL(W18_VSERV, 0) - ' + fSQLDescontoNotaXML,'Total Prod.');
      {objLoadSQL.fIncluiSubConsulta('DESCONTO',' (IFNULL(W10_VDESC, 0) + IF((W07_VPROD + IFNULL(W18_VSERV, 0) + W06_VST + W08_VFRETE + W09_VSEG + W12_VIPI + W15_VOUTRO + IFNULL(W06A_VFCPST, 0) - W10_VDESC) - W16_VNF > 0.5, IFNULL(W04A_VICMSDESON, 0), 0) + IFNULL(W06A_VFCPST, 0)) ','Desconto'); //req 303332 }
      objLoadSQL.fIncluiSubConsulta('DESCONTO',' (IFNULL(W10_VDESC, 0) + IF((W07_VPROD + IFNULL(W18_VSERV, 0) + W06_VST + W08_VFRETE + W09_VSEG + W12_VIPI + W15_VOUTRO + IFNULL(W06A_VFCPST, 0) - W10_VDESC) - W16_VNF > 0.5, IFNULL(W04A_VICMSDESON, 0), 0) ) ','Desconto');
    End
    Else
    Begin
      objLoadSQL.fIncluiSubConsulta('VPRODLIQ', ' W07_VPROD + IFNULL(W18_VSERV, 0) - W10_VDESC', 'Total Prod.');
      objLoadSQL.fIncluiSubConsulta('DESCONTO', ' IFNULL(W10_VDESC, 0) ', 'Desconto');
    end;

    If (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao]) Then
    Begin
      objLoadSql.fIncluiSubConsulta('GERCODCLI', 'GER_CODCLI', 'Cód.Cliente');
      objLoadSql.fIncluiSubConsulta('CLINOMCLI', 'CLI_NOMCLI', 'Cliente');
    End Else Begin
      objLoadSql.fIncluiSubConsulta('GERCODFOR' , 'GER_CODFOR','Cód.Fornec.');
      objLoadSql.fIncluiSubConsulta('FORNOMFOR' , 'FOR_NOMFOR','Fornecedor');
    End;

    If (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao]) Then
    Begin
      objLoadSql.stlJoins.Add(' INNER JOIN CADCLI ON CLI_CODCLI = GER_CODCLI ');
    End
    Else
    Begin
      objLoadSql.stlJoins.Add(' INNER JOIN CADFOR ON  FOR_CODFOR = GER_CODFOR ');
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    If fConsideraICMSDesoneradoComDesconto(fCadEmp('ESTADO')) Then
      objConsulta.pIncluiSubConsulta('VPRODLIQ', 'W07_VPROD + IFNULL(W18_VSERV, 0) - ' + fSQLDescontoNotaXML)
    Else
      objConsulta.pIncluiSubConsulta('VPRODLIQ', 'W07_VPROD + IFNULL(W18_VSERV, 0) - W10_VDESC');

    strSQL := fSQLNotasEntrada(finalidadeXML, strWhere, False, blnRelCriticas, strCodCli);
    SetLength(arrTitCol, 6);
    arrTitCol[00] := 'Núm.Nota';
    arrTitCol[01] := 'Série';
    arrTitCol[02] := 'Emissão';
    arrTitCol[03] := 'Total Prod.';
    arrTitCol[04] := IIF(Not (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao]), 'Cód.Fornec.', 'Cód.Cliente');
    arrTitCol[05] := IIF(Not (finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao]), 'Fornecedor', 'Cliente');
    arrSQLConsulta    := [strSQL, strWhere];
    arrCamposConsulta := arrTitCol;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strTitulo := 'Consulta Nota Fiscal Eletrônica.';

      objConsulta := TDefConsulta.Create;
      objConsulta.pAdicionaTabela('GERELE', '');

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta.strSQLRetorno := fSQLConsultaXMLParaEntrada;

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['B08_NNF','B09_DEMI','FOR_NOMFOR','GER_CODFOR'],
                   '',
                   'GERELE',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'B08_NNF',
                   objConsulta) Then
      Begin
        If Assigned(edtNotEle) then
        Begin
          strNotas := '';
          If (edtNotEle Is TEditFocus) Then
          Begin
            strNotas := qryConsulta.FieldByName('B08_NNF').AsString;
            If finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao] Then
              strNotas := strNotas + '-' + qryConsulta.FieldByName('GER_CODCLI').AsString + '-' + fRetNomCliente(qryConsulta.FieldByName('GER_CODCLI').AsString)
            Else
              strNotas := strNotas + '-' + qryConsulta.FieldByName('GER_CODFOR').AsString + '-' + fRetNomFornecedor(qryConsulta.FieldByName('GER_CODFOR').AsString);

            (edtNotEle As TEditFocus).Text := strNotas;
          End
          Else
          Begin
            strNotas := qryConsulta.FieldByName('B08_NNF').AsString;
            If finalidadeXML  in [xmlConsertoEquipamento, xmlGarantiaRecCliente, xmlConsignacaoDevolucaoCliente, xmlRetornoLocacao] Then
              strNotas := strNotas + '-' + qryConsulta.FieldByName('GER_CODCLI').AsString + '-' + fRetNomCliente(qryConsulta.FieldByName('GER_CODCLI').AsString)
            Else
              strNotas := strNotas + '-' + qryConsulta.FieldByName('GER_CODFOR').AsString + '-' + fRetNomFornecedor(qryConsulta.FieldByName('GER_CODFOR').AsString);

            edtNotEle.Text := strNotas;
          End;
        End;

        pCarregaCabecalhoNota(qryConsulta, recNotEle);

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtNotEle) then
          Begin
            If (edtNotEle Is TEditFocus) Then
              (edtNotEle As TEditFocus).Text := fStrZero('0', 5)
            Else
              edtNotEle.Text := fStrZero('0', 5);
          End;

          If Assigned(edtNotEle) Then
            edtNotEle.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

        FreeAndNil(objConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

end;

