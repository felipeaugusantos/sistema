function fPesqFinalidadeAjuste(Self      : TForm;                    {* Formulário                                  *}
                               edtCodigo : TCustomEdit;              {* Edit do Código                              *}
                               edtDescri : TEditFocus;               {* Edit da Descricao                           *}
                               qryTabela : TUniQuery;                {* Query                                       *}
                               Var chrKey: Char;                     {* Key                                         *}
                               Var arrSel: TConsultasArray;          {* Array de Seleção                            *}
                               blnConSim : Boolean = True;
                               blnSomenteComDirAcesso: Boolean = False;
                               blnContraPartida: Boolean = False): Boolean; {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL,
    strWhere,
    strGroupBy: String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;
begin
  Result := False;
  Try
    If fEntraCons(chrKey) Then
    Begin
      Try
        chrKey := #0;

        strSQL := strSQL + '   SELECT SQL_NO_CACHE                                      ';
        strSQL := strSQL + '    FAJ_CODIGO,                                             ';
        strSQL := strSQL + '    FAJ_DESCRI,                                             ';
        strSQL := strSQL + '    FAJ_OPERAC,                                             ';
        strSQL := strSQL + '    C.OPE_CODOPE AS COPE,                                   ';
        strSQL := strSQL + '    P.OPE_CODOPE AS GOPE,                                   ';
        strSQL := strSQL + '    FINAJU.AUTOINCREM                                       ';
        strSQL := strSQL + '  FROM FINAJU                                               ';
        strSQL := strSQL + '  LEFT JOIN DFJOPE D ON D.DFJ_SEQFAJ = FINAJU.AUTOINCREM    ';
        strSQL := strSQL + '  LEFT JOIN DFJGPO G ON G.DFJ_SEQFAJ = FINAJU.AUTOINCREM    ';
        strSQL := strSQL + '  LEFT JOIN OPEGPO P ON P.GPO_CODGPO = G.DFJ_CODGPO         ';
        strSQL := strSQL + '  LEFT JOIN CADOPE C ON C.OPE_CODOPE = P.OPE_CODOPE         ';

        strWhere := 'WHERE TRUE ';
        If blnSomenteComDirAcesso Then
        Begin
          strWhere := strWhere +  ' AND  (C.OPE_CODOPE = ' + QuotedStr(strLoginUsuarioLogado);
          strWhere := strWhere +  '     OR D.DFJ_CODOPE = ' + QuotedStr(strLoginUsuarioLogado) + ')';
        End;
        If blnContraPartida Then
          strWhere := strWhere +  '  AND FAJ_ENTSAI = "A"';

        strGroupBy := 'GROUP BY FINAJU.AUTOINCREM ';

        If Not Assigned(qryTabela) Then
          qryConsulta := fCriaQuery(Nil)
        Else
          qryConsulta := qryTabela;

        objConsulta := TDefConsulta.Create;
        objConsulta.pIncluiSubConsulta('FAJ_OPERAC', 'CASE FAJ_ENTSAI ' +
                                                    '  WHEN "E" THEN "ENTRADA" ' +
                                                    '  WHEN "S" THEN "SAÍDA" ' +
                                                    '  WHEN "A" THEN "AMBAS" ' +
                                                    'END');
        objConsulta.pIncluiCampoSimNao('FAJ_OPERAC', ['ENTRADA', 'SAÍDA', 'AMBAS','TODOS']);

        If fConsulta([strSQL, strWhere, strGroupBy],
                    ['Código',
                     'Descrição',
                     'Operação'],
                     ['FAJ_CODIGO','FAJ_DESCRI', 'FAJ_OPERAC'],
                     '',
                     'FINAJU',
                     Self.Name,
                     'Consulta de Finalidade do Ajuste de Estoque',
                     qryConsulta,
                     Nil,
                     blnConSim,
                     arrSel,
                     'FAJ_CODIGO',
                     objConsulta) Then
        Begin
          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('FAJ_CODIGO').AsString
            Else
              edtCodigo.Text := qryConsulta.FieldByName('FAJ_CODIGO').AsString;
          End;

          If Assigned(edtCodigo) Then
            edtDescri.Text := qryConsulta.FieldByName('FAJ_DESCRI').AsString;

          If (Length(arrSel) > 1) Then
          Begin

            If Assigned(edtCodigo) then
            Begin
              If (edtCodigo Is TMaskEditFocus) Then
                (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 4)
              Else
                edtCodigo.Text := fStrZero('0', 4);
            End;

            If Assigned(edtDescri) Then
              edtDescri.Text := '+1'
            Else
              edtDescri.Text := '+1';

          End;

          Result := True;

          If Not Assigned(qryTabela) Then
            FreeAndNil(qryConsulta);
        End;

      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '');
        End;
      End;
    End;
  Finally
    FreeAndNil(objConsulta);
  End;
end;

