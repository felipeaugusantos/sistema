function fPesqCtaReceber(    Self      : TForm;                            {* Formulário                                  *}
                             qryTabela : TUniQuery;                        {* Query                                       *}
                         Var chrKey    : Char;                             {* Key                                         *}
                         Var arrSel    : TConsultasArray;                  {* Array de Seleção                            *}
                             objFrmPnl : TPanelCx = Nil;                   {* Painel                                      *}
                             blnConSim : Boolean = True): Boolean;         {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL,
    strTitulo: String;
    intOpcao: Integer;
    qryConsulta : TUniQuery;
    objConsulta: TDefMascaraContasReceber;
    arrTitCol,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
    strCodCli: String;
    dtaDtaIni: TDateTime;
    dtaDtaFin: TDateTime;
    strNumDup: String;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If intOpcao = 0 then
      Exit
    Else
    If intOpcao = 2 Then
    Begin
      strWhere := strWhere + ' AND R.CTR_DTAREC IS NOT NULL ';
    End
    Else
    If intOpcao = 3 Then
    Begin
      strWhere := strWhere + ' AND R.CTR_DTAREC IS NULL ';
    End;

    {**********************************************************************}
    {* VISUALIZA APENAS DUPLICATAS DE EMPRESAS QUE O USUÁRIO TENHA ACESSO *}
    {*******************************************************************JU*}
    strWhere := strWhere + ' AND R.CTR_CODEMP IN (' + fRetStrToSQLIn(strEmpAcessoUsuarioLogado) + ') ';

    {************************************************************************}
    {* MESMA LÓGICA DA EMPRESA PARA O PORTADOR QUANDO UTILIZAR A CONFIRAÇÃO *}
    {*********************************************************************JU*}
    If fCfgSis('DACPOR', varBoolean) Then
    Begin
      strWhere := strWhere + ' AND ((R.CTR_CODPOR IS NULL OR R.CTR_CODPOR = "") ';
      strWhere := strWhere + ' OR CTR_CODPOR IN (' + IIF(strPortadoresOperador.IsEmpty, '""',  fStringSQLLocateToStringSQLIN(strPortadoresOperador)) + ')) ';
      strWhere := strWhere + ' AND ((R.CTR_PORBAI IS NULL OR R.CTR_PORBAI = "") ';
      strWhere := strWhere + ' OR CTR_PORBAI IN (' + IIF(strPortadoresOperador.IsEmpty, '""',  fStringSQLLocateToStringSQLIN(strPortadoresOperador)) + ')) ';
    End;

    If Not fEmptyStr(strCodCli) Then
    Begin
      strWhere := strWhere + ' AND R.CTR_CODCLI = ' + QuotedStr(strCodCli) + ' ';
    End;

    If dtaDtaIni > 0 Then
    Begin
      strWhere := strWhere + ' AND R.CTR_DTACAD BETWEEN ' + QuotedStr(FormatDateTime('yyyy-mm-dd', dtaDtaIni)) + ' AND ' + QuotedStr(FormatDateTime('yyyy-mm-dd', dtaDtaFin)) + ' ';
    End;

    If Not fEmptyStr(strNumDup) Then
    Begin
      strWhere := strWhere + ' AND R.CTR_NUMDUP = ' + QuotedStr(strNumDup) + ' ' ;
    End;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  Begin

    If intOpcao <> 3 Then
    Begin
      objLoadSql.fIncluiSubConsulta('CTRCTABAI', 'R.CTR_CTABAI', 'Cód. Plano de Contas da Baixa');
      objLoadSql.fIncluiSubConsulta('CTRPORBAI', 'R.CTR_PORBAI', 'Cód. Portador da Baixa');
      objLoadSql.fIncluiSubConsulta('CTADESCTA', 'T.CTA_DESCTA', 'Plano de Contas da Baixa');
      objLoadSql.fIncluiSubConsulta('PORTBAIXA', 'B.POR_NOMPOR', 'Portador da Baixa');
      objLoadSql.fIncluiSubConsulta('CTRDTABAI', 'R.CTR_DTABAI', 'Data da Baixa');
      objLoadSql.stlJoins.Add(' LEFT JOIN CADPOR B ON B.POR_CODPOR = R.CTR_PORBAI ');
      objLoadSql.stlJoins.Add(' LEFT JOIN CADCTA T ON T.CTA_CODCTA = R.CTR_CTABAI ');
    End;

    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;

    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    objConsulta.pIncluiSubConsulta('CTRJURSUJ', 'IFNULL(R.CTR_VALJUR,0)+IFNULL(R.CTR_JURSUJ,0)');
    objConsulta.pIncluiSubConsulta('CTRDESSUJ', 'IFNULL(R.CTR_VALDES,0)+IFNULL(R.CTR_DESSUJ,0)');
    objConsulta.pIncluiSubConsulta('CTRHIST01', 'CAST(IFNULL(REPLACE(R.CTR_HIST01, "<<csq>>" , " "), " ") AS CHAR(9999))');
    objConsulta.pIncluiSubConsulta('POR_ABERT', 'A.POR_NOMPOR');
    objConsulta.pIncluiSubConsulta('CTR_ENVADO', 'CASE WHEN R.CTR_DTAENV IS NULL THEN "NÃO" ELSE "SIM" END');
    objConsulta.pIncluiSubConsulta('OPE_NOMOPE', 'O.OPE_NOMOPE');
    objConsulta.pIncluiSubConsulta('PROJETO'  , ' IFNULL(R.CTR_CODPRJ,                    ' +
                                                ' IF(R.CTR_ESPDOC = "AG",(                ' +
                                                '  IFNULL(                                ' +
                                                '    (SELECT                              ' +
                                                '      A.AUX_CODPRJ AS CODPRJ             ' +
                                                '    FROM                                 ' +
                                                '      AUXMOV A                           ' +
                                                '      INNER JOIN MOVGER G                ' +
                                                '        ON G.AUTOINCREM = A.AUX_SEQGER   ' +
                                                '      INNER JOIN DUPAGR D                ' +
                                                '        ON D.CTR_NUMDUP = G.GER_NUMDOC   ' +
                                                '        AND D.CTR_ESPDOC = G.GER_ESPDOC  ' +
                                                '        AND D.CTR_CODEMP = G.GER_CODEMP  ' +
                                                '        AND D.CTR_CODCLI = G.GER_CODCLI  ' +
                                                '    WHERE D.CTR_NUMAGR = R.CTR_NUMDUP    ' +
                                                '      AND D.CTR_EMPAGR = R.CTR_CODEMP    ' +
                                                '      AND D.CTR_CODCLI = R.CTR_CODCLI    ' +
                                                '      AND A.AUX_CODPRJ IS NOT NULL       ' +
                                                '    GROUP BY CODPRJ                      ' +
                                                '    ORDER BY G.GER_DTAENT,               ' +
                                                '      G.GER_NUMDOC                       ' +
                                                '    LIMIT 1),                            ' +
                                                '    (SELECT                              ' +
                                                '      A.AUX_CODPRJ AS CODPRJ             ' +
                                                '    FROM                                 ' +
                                                '      AUXNOT A                           ' +
