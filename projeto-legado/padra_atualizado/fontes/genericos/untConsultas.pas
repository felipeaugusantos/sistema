function fPesqCliente(opcTipCli: TTipoConsultaCliente;
                      Self     : TForm;                         {* Formulário                                  *}
                      edtCodigo: TCustomEdit;                   {* Edit do Código                              *}
                      edtNomCli: TEditFocus;                    {* Edit do Nome do Cliente                     *}
                      qryTabela: TUniQuery;                     {* Query                                       *}
                      Var chrKey: Char;                         {* Key                                         *}
                      Var arrSel: TConsultasArray;              {* Array de Seleção                            *}
                      blnConSim: Boolean = True;                {* Consulta Simples ou Múltipla (multi select) *}
                      objFrmPnl: TPanelCx = Nil;                {* Painel                                      *}
                      blnTablet: Boolean = False;
                      strCodRep: String = '';
                      strOpcDoc: String = '';
                      blnEmpIde: Boolean = True;
                      strCodOpe: String = '';
                      strCodPrj: String = '';
                      opcFiltraVendedor: TTipoFiltraVendedorConsCli = tfvNenhum; {* Filtra clientes do vendedor logado *}
                      strCliCgc: String = '';
                      blnSomentePessoaFisica: Boolean = False): Boolean;
  Var
    qryConsulta: TUniQuery;
    objConsulta: TDefMascaraCliente;
    arrTitCol: TColunasArray;                                   {* Títulos das Colunas                         *}
    strTitulo: String;
    btnCancela : TBitBtnLocked;  // variável para tratamento do conflito de teclas originado pelo ALT + C

    objLoadSql: TLoadConsultaSQL;
    stlJoins: TStringList;

    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    opcCRMCVI: TTipoConsCli;

    Function fSQLWhere(blnCompleto: Boolean = True): String;
      Var
        strWhere: String;
    Begin
      strWhere := '';

      If blnCompleto Then
        strWhere := ' WHERE TRUE ';

      {*****************************************************}
      {* FILTRA OS CLIENTES QUE TEM EMPRESA IDENTIFICADORA *}
      {* (CLI_EMPIDE) IGUAL A EMPRESA ATUAL E TAMBÉM OS Q  *}
      {*     NÃO TEM EMPRESA IDENTIFICADORA CADASTRADA     *}
      {**************************************************ER*}
      If blnEmpIde Then
      Begin
        if strCodOpe = '' Then
          strCodOpe := strLoginUsuarioLogado;

        strWhere := strWhere + fGetFiltroClienteEmpresaIdentificadora(strCodOpe);
      End;

      {*****************************************************}
      {* FILTRA SOMENTE OS CLIENTES FILIAIS SE FOR "TE"    *}
      {**************************************************RV*}
      If strOpcDoc = 'TE' then
      Begin
        strWhere := strWhere + ' AND C.CLI_CODCLI IN (' + fRetClientesFilial + ') ';
      End;

      If (Pos(strOpcDoc, 'PD_OR_VN_DV') > 0) And (Not fVerificaAcessoSistema('VERCLI')) Then
      Begin
        strWhere := strWhere + '  AND (C.CLI_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ';

        If (fCfgSis('VEESFT', varBoolean)) And (Not fEmptyStr(fCfgSis('VENESP'))) Then
          strWhere := strWhere + '    OR C.CLI_CODVEN = ' + QuotedStr(fCfgSis('VENESP'));

        strWhere := strWhere + '    OR C.CLI_CODREP IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '")) ';
      End;

      Case opcFiltraVendedor Of
        tfvCRM:
          Begin
            opcCRMCVI := fStrToTipoConsCli( fCfgSis('CRMCVI') );

            Case opcCRMCVI Of
              tpCliVenLog,
              tpLibCliVenLog:
                strWhere := strWhere + ' AND ((CLI_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ' + ') OR (LOCATE("CONSUMIDOR", C.CLI_NOMCLI) > 0)) ';

              tpCliVenLogVenEsp:
                strWhere := strWhere + ' AND ((CLI_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ' + ') OR (CLI_CODVEN = ' + QuotedStr(fCfgSis('VENESP')) + ') OR (LOCATE("CONSUMIDOR", C.CLI_NOMCLI) > 0)) ';
            End;
          End;

        tfvCadCliente:
          Begin
            If (fCfgSis('CNSCCA') = 'L') And (Not fVerificaAcessoSistema('PERMVISULCADCLITODOSVENDEDORES')) Then
              strWhere := strWhere + ' AND ((CLI_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ' + ') OR (LOCATE("CONSUMIDOR", C.CLI_NOMCLI) > 0)) ';
          End;

        tfvReimprDocs:
          Begin
            If (Pos(fCfgSis('CNSCRE'), 'L_V_') > 0) Then
              strWhere := strWhere + ' AND ((CLI_CODVEN IN (' + fGetVendedoresGerentesOrSUBGerentes + '"' + strLoginUsuarioLogado + '") ' + ') OR (LOCATE("CONSUMIDOR", C.CLI_NOMCLI) > 0)) ';
          End;
      End;

      if (fCfgSis('VENOUT', varBoolean)) and (Pos(strOpcDoc, 'ER_ET_EM_') > 0) then
      begin
        strWhere := strWhere + ' AND C.CLI_REMOUT = "S" ';
      end;

      If Not fEmptyStr(strCodRep) Then
      Begin
        strWhere := strWhere + ' AND C.CLI_CODREP = ' + QuotedStr(strCodRep);
      End;

      If Not fEmptyStr(strCodPrj) Then
      Begin
        strWhere := strWhere + ' AND C.CLI_CODCLI IN (SELECT PRJ.CLI_CODCLI FROM CLIPRJ PRJ WHERE PRJ.CLI_CODPRJ = ' + QuotedStr(strCodPrj) + ')';
      End;

      If Not fEmptyStr(strCliCgc) Then
      Begin
        strWhere := strWhere + ' AND C.CLI_C_G_C_ = ' + QuotedStr(strCliCgc);
      End;

      If (blnSomentePessoaFisica) Then
      Begin
        strWhere := strWhere + ' AND C.CLI_CGCCPF = 2 ';
      End;

      Result := strWhere;
    End;

    Function fSQLJoinFatgor: String;
      Var
        strSQL: String;
    Begin
      strSQL := '';
      strSQL := strSQL + 'INNER JOIN FATGOR G ON C.CLI_CODCLI = G.FGO_CODCLI ';
      strSQL := strSQL + '         AND G.FGO_CODEMP = "' + VS_strCodEmp + '" ';
      strSQL := strSQL + '         AND G.FGO_JAFATU = 0    ';
      strSQL := strSQL + '         AND G.FGO_LIBERA > 0    ';
      strSQL := strSQL + '         AND G.FGO_ESPDOC = "PD" ';

      Result := strSQL;
    End;

    Procedure pConsultaAntiga;
      Var
        strSQL: String;
        blnUsaTpc: Boolean;
    Begin
      blnUsaTpc := fCfgSis('USATPC', varBoolean);

      If (opcTipCli <> conCliAgrupDup) Then
        blnUsaTpc := False;

      objConsulta.pIncluiSubConsulta('CLI_NOMVEN', 'VD.OPE_NOMOPE');
      objConsulta.pIncluiSubConsulta('CLI_STATUS', 'IF(CLI_STATUS = "A", "ATIVO", "INATIVO")');

      objConsulta.pIncluiSubConsulta('CLI_ENDCOB', 'IF(CLI_ENDCOB = "" OR CLI_ENDCOB IS NULL, CONCAT(CLI_ENDERE," ", IFNULL(CLI_ENDNUM,"")), CLI_ENDCOB)');
      objConsulta.pIncluiSubConsulta('CLI_BAICOB', 'IF(CLI_ENDCOB = "" OR CLI_ENDCOB IS NULL, CLI_BAIRRO, CLI_BAICOB)');
      objConsulta.pIncluiSubConsulta('CID_CIDCOB', 'IF(CLI_ENDCOB = "" OR CLI_ENDCOB IS NULL, D1.CID_NOMCID, D2.CID_NOMCID)');
      objConsulta.pIncluiSubConsulta('CID_ESTCOB', 'IF(CLI_ENDCOB = "" OR CLI_ENDCOB IS NULL, D1.CID_ESTADO, D2.CID_ESTADO)');
      objConsulta.pIncluiSubConsulta('CLI_CEPCOB', 'IF(CLI_ENDCOB = "" OR CLI_ENDCOB IS NULL, CLI_C_E_P_, CLI_CEPCOB)');

      objConsulta.pIncluiSubConsulta('CLI_ENDENT', 'IF(ETC_ENDENT = "" OR ETC_ENDENT IS NULL, CONCAT(CLI_ENDERE," ", IFNULL(CLI_ENDNUM,"")), ETC_ENDENT)');
      objConsulta.pIncluiSubConsulta('CLI_BAIENT', 'IF(ETC_ENDENT = "" OR ETC_ENDENT IS NULL, CLI_BAIRRO, ETC_BAIENT)');
      objConsulta.pIncluiSubConsulta('CID_CIDENT', 'IF(ETC_ENDENT = "" OR ETC_ENDENT IS NULL, D1.CID_NOMCID, D3.CID_NOMCID)');
      objConsulta.pIncluiSubConsulta('CID_ESTENT', 'IF(ETC_ENDENT = "" OR ETC_ENDENT IS NULL, D1.CID_ESTADO, D3.CID_ESTADO)');
      objConsulta.pIncluiSubConsulta('CLI_CEPENT', 'IF(ETC_ENDENT = "" OR ETC_ENDENT IS NULL, CLI_C_E_P_, ETC_CEPENT)');

      objConsulta.pIncluiSubConsulta('CLI_PERAGU', 'IF(CLI_PERAGU = "S" , "SIM", "NÃO")');
      objConsulta.pIncluiSubConsulta('CLI_PERPRE', 'IF(CLI_PERPRE = "S" , "SIM", "NÃO")');
      objConsulta.pIncluiSubConsulta('CLI_PERFAL', 'IF(CLI_PERFAL = "S" , "SIM", "NÃO")');

      objConsulta.pIncluiSubConsulta('CLI_NOMCID', 'D1.CID_NOMCID');
      objConsulta.pIncluiSubConsulta('CLI_ESTADO', 'D1.CID_ESTADO');

      {E-mails do cliente concatenados, tratamento para não duplica-los!}
      objConsulta.pIncluiSubConsulta('E_MAIL', 'CONCAT(COALESCE(CLI_EMAIL_,""), IF(COALESCE(CLI_EMAIL2,"") <> COALESCE(CLI_EMAIL_,""), COALESCE(CLI_EMAIL2,""), ""), IF((COALESCE(CLI_EMAIL3,"") <> COALESCE(CLI_EMAIL_,"")) AND (COALESCE(CLI_EMAIL3,"") <> COALESCE(CLI_EMAIL2,"")), CLI_EMAIL3, ""))');

      objConsulta.pIncluiSubConsulta('REDLOJ', 'CONCAT(RED_CODRED, "-", RED_DESRED)');
      objConsulta.pIncluiSubConsulta('CANACE', 'CONCAT(CAC_CODCAC, "-", CAC_NOMCAC)');
      objConsulta.pIncluiSubConsulta('REGIAO', 'CONCAT(REG_CODREG, "-", REG_DESREG)');

      objConsulta.pIncluiSubConsulta('CLI_NOMREP', 'RP.OPE_NOMOPE');

      If (blnUsaTpc) Then
        objConsulta.pIncluiSubConsulta('CLI_DESTIP', 'TP.TIP_DESTIP');

      case opcTipCli Of
        conCliSimples,
        conCliCompleta,
        conCliEmpresaIdent,
        conCliFiliais,
        conCliAgrupDup:
                        Begin
                          If (blnUsaTpc) Then
                            SetLength(arrTitCol, 34)
                          Else
                            SetLength(arrTitCol, 32);

                          arrTitCol[00] := 'Código';
                          arrTitCol[01] := 'Nome';
                          arrTitCol[02] := 'Fantasia';
                          arrTitCol[03] := 'CNPJ/CPF';
                          arrTitCol[04] := 'Insc. Est.';
                          arrTitCol[05] := 'Atividade';
                          arrTitCol[06] := 'Cód. Vend.';
                          arrTitCol[07] := 'Vendedor';
                          arrTitCol[08] := 'Endereço';
                          arrTitCol[09] := 'Número';
                          arrTitCol[10] := 'Bairro';
                          arrTitCol[11] := 'Cidade';
                          arrTitCol[12] := 'UF';
                          arrTitCol[13] := 'CEP';
                          arrTitCol[14] := 'Telefone';
                          arrTitCol[15] := 'Celular';
                          arrTitCol[16] := 'Protestos';
                          arrTitCol[17] := 'Status';
                          arrTitCol[18] := 'Data Cadastro';
                          arrTitCol[19] := 'E-mail';
                          arrTitCol[20] := 'Rede Lojas';
                          arrTitCol[21] := 'Canal Acesso';
                          arrTitCol[22] := 'Região';

                          arrTitCol[23] := 'Permitir Entrega Futura com Status "Aguardando o Cliente"';
                          arrTitCol[24] := 'Permitir Entrega Futura com Status "Previsão de Entrega"';
                          arrTitCol[25] := 'Permitir Entrega Futura com Status "Falta de Produto"';

                          arrTitCol[26] := 'Cód. Rep.';
                          arrTitCol[27] := 'Representante';
                          arrTitCol[28] := 'Insc. Munic. Prod.';
                          arrTitCol[29] := '1 - CNPJ / 2 - CPF';
                          arrTitCol[30] := 'Última Compra';
                          arrTitCol[31] := 'Limite de Crédito';

                          If (blnUsaTpc) Then
                          Begin
                            arrTitCol[32] := 'Cód. Tipo Cli.';
                            arrTitCol[33] := 'Tipo de Cliente';
                          End;

                          strSQL := '';
                          strSQL := strSQL + 'SELECT SQL_NO_CACHE ';

                          If strOpcDoc = 'CP' Then
                            strSQL := strSQL + ' DISTINCT ';

                          strSQL := strSQL + '  CLI_CODCLI,       ';
                          strSQL := strSQL + '  CLI_NOMCLI,       ';
                          strSQL := strSQL + '  CLI_FANSOB,       ';
                          strSQL := strSQL + '  CLI_C_G_C_,       ';
                          strSQL := strSQL + '  CLI_I_E_S_,       ';
                          strSQL := strSQL + '  ATI_DESATI,       ';
                          strSQL := strSQL + '  CLI_CODVEN,       ';
                          strSQL := strSQL + '  CLI_NOMVEN,       ';
                          strSQL := strSQL + '  CLI_ENDERE,       ';
                          strSQL := strSQL + '  CLI_ENDNUM,       ';
                          strSQL := strSQL + '  CLI_BAIRRO,       ';
                          strSQL := strSQL + '  CLI_NOMCID,       ';
                          strSQL := strSQL + '  CLI_ESTADO,       ';
                          strSQL := strSQL + '  CLI_C_E_P_,       ';
                          strSQL := strSQL + '  CLI_FONE01,       ';
                          strSQL := strSQL + '  CLI_CELULA,       ';
                          strSQL := strSQL + '  CLI_QTDPRO,       ';
                          strSQL := strSQL + '  CLI_STATUS,       ';
                          strSQL := strSQL + '  CLI_DTACAD,       ';
                          strSQL := strSQL + '  E_MAIL,           ';
                          strSQL := strSQL + '  REDLOJ,           ';
                          strSQL := strSQL + '  CANACE,           ';
                          strSQL := strSQL + '  REGIAO,           ';
                          strSQL := strSQL + '  CLI_PERAGU,       ';
                          strSQL := strSQL + '  CLI_PERPRE,       ';
                          strSQL := strSQL + '  CLI_PERFAL,       ';
                          strSQL := strSQL + '  CLI_CODREP,       ';
                          strSQL := strSQL + '  CLI_NOMREP,       ';
                          strSQL := strSQL + '  CLI_I_M_P_,       ';
                          strSQL := strSQL + '  CLI_CGCCPF,       ';
                          strSQL := strSQL + '  CLI_ULTCOM,       ';
                          strSQL := strSQL + '  CLI_LIMCRE,       ';

                          If (blnUsaTpc) Then
                          Begin
                            strSQL := strSQL + '  CLI_TIPCLI,       ';
                            strSQL := strSQL + '  CLI_DESTIP,       ';
                          End;

                         // Os campos de pesquisa devem ser colocados acima desse ponto

                          strSQL := strSQL + '  C.AUTOINCREM,';
                          strSQL := strSQL + '  CLI_CELULA, ';
                          strSQL := strSQL + '  CLI_DTMCOM, ';
                          strSQL := strSQL + '  CLI_CONTAT, ';
                          strSQL := strSQL + '  CLI_FONE02, ';
                          strSQL := strSQL + '  CLI_F_A_X_, ';
                          strSQL := strSQL + '  CLI_ENDCOB, ';
                          strSQL := strSQL + '  CLI_BAICOB, ';
                          strSQL := strSQL + '  CID_CIDCOB, ';
                          strSQL := strSQL + '  CID_ESTCOB, ';
                          strSQL := strSQL + '  CLI_CEPCOB, ';
                          strSQL := strSQL + '  CLI_ENDENT, ';
                          strSQL := strSQL + '  CLI_BAIENT, ';
                          strSQL := strSQL + '  CID_CIDENT, ';
                          strSQL := strSQL + '  CID_ESTENT, ';
                          strSQL := strSQL + '  CLI_CEPENT, ';
                          strSQL := strSQL + '  CLI_EMAIL_, ';
                          strSQL := strSQL + '  CLI_EMAIL2, ';
                          strSQL := strSQL + '  CLI_OBSERV  ';

                          strSQL := strSQL + 'FROM             ';
                          strSQL := strSQL + '  CADCLI C       ';

                          strSQL := strSQL + '  LEFT JOIN ENTCLI ON ETC_CODCLI = CLI_CODCLI AND ';
                          strSQL := strSQL + '                      ETC_SEQVIS = (SELECT MIN(ETC_SEQVIS) FROM ENTCLI WHERE ETC_CODCLI = CLI_CODCLI) ';

                          strSQL := strSQL + 'LEFT JOIN CADOPE VD ON CLI_CODVEN = VD.OPE_CODOPE ';
                          strSQL := strSQL + 'LEFT JOIN CADATI AA ON CLI_CODATI = AA.ATI_CODATI ';
                          strSQL := strSQL + 'LEFT JOIN CADCID D1 ON CLI_CODCID = D1.CID_CODCID ';
                          strSQL := strSQL + 'LEFT JOIN CADCID D2 ON CLI_CIDCOB = D2.CID_CODCID ';
                          strSQL := strSQL + 'LEFT JOIN CADCID D3 ON ETC_CIDENT = D3.CID_CODCID ';
                          strSQL := strSQL + 'LEFT JOIN CADRED D4 ON CLI_CODRED = D4.RED_CODRED ';
                          strSQL := strSQL + 'LEFT JOIN CADCAC D5 ON CLI_CODCAC = D5.CAC_CODCAC ';
                          strSQL := strSQL + 'LEFT JOIN CADREG D6 ON CLI_CODREG = D6.REG_CODREG ';
                          strSQL := strSQL + 'LEFT JOIN CADOPE RP ON CLI_CODREP = RP.OPE_CODOPE ';

                          If strOpcDoc = 'CP' Then
                            strSQL := strSQL + fSQLJoinFatgor;

                          If (blnUsaTpc) Then
                             strSQL := strSQL + 'LEFT JOIN TIPCLG TP ON CLI_TIPCLI = TP.TIP_CODTIP ';

                        End;
      End;

      arrSQLConsulta := [strSQL, fSQLWhere];
      arrCamposConsulta := arrTitCol;
    End;

