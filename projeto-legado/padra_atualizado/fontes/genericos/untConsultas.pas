function fPesqDocumentosSaida(Self        : TForm;                            {* Formulário                                  *}
                              edtNumDoc   : TCustomEdit;                      {* Edit do Código                              *}
                              qryTabela   : TUniQuery;                        {* Query                                       *}
                              Var chrKey  : Char;                             {* Key                                         *}
                              Var arrSel  : TConsultasArray;                  {* Array de Seleção                            *}
                              objFrmPnl   : TPanelCx = Nil;                   {* Painel                                      *}
                              blnConSim   : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                              blnRegraFat : Boolean = True;                   {* Utiliza regra de faturamento                *}
                              strDtaIni   : string = '';
                              strDtaFin   : string = '';
                              strEspDoc   : string = ''): Boolean;
var
  strSQL1,
  strSQL2,
  strSQLCond1,
  strSQLCond2,
  strSQLCondSemRegraFat,
  strSQLWhere : String;

  arrSQLConsulta,
  arrCamposConsulta: TColunasArray;

  qryConsulta : TUniQuery;
  blnFATCLF, blnENTBRF: Boolean;
  intCOM_FF, intCOM_FV, intCOM_TR, intCOM_DV: Integer;

begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      blnFATCLF := fCfgSis('FATCLF', varBoolean);
      blnENTBRF := fCfgSis('ENTBRF', varBoolean);
      intCOM_FF := fCfgSis('COM_FF', varInteger);
      intCOM_FV := StrToIntDef(IIF(fEmptyStr(fCfgSis('COM_FV', varString)), fCfgSis('COM_FF', varString), fCfgSis('COM_FV', varString)), 0);
      intCOM_TR := StrToIntDef(fCfgSis('COM_TR', varString), 0);
      intCOM_DV := StrToIntDef(fCfgSis('COM_DV', varString), 0);

      strSQL1 := '';
      strSQL1 := strSQL1 + 'SELECT DISTINCT ';
      strSQL1 := strSQL1 + '  MOVGER.GER_NUMDOC, ';
      strSQL1 := strSQL1 + '  MOVGER.GER_ESPDOC, ';
      strSQL1 := strSQL1 + '  MOVGER.GER_CODEMP, ';
      strSQL1 := strSQL1 + '  MOVGER.GER_CODCLI, ';
      strSQL1 := strSQL1 + '  MOVGER.GER_DTAENT, ';
      strSQL1 := strSQL1 + '  MOVGER.AUTOINCREM ';
      strSQL1 := strSQL1 + 'FROM MOVDET ';
      strSQL1 := strSQL1 + '  JOIN MOVGER ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
      strSQL1 := strSQL1 + '  INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
      strSQL1 := strSQL1 + '  LEFT JOIN MOVICD ON MOVICD.ICD_SEQGER = MOVDET.AUTOINCREM AND MOVDET.DET_VALRET = 0 ';

      strSQLCond1 := '';
      strSQLCond1 := strSQLCond1 + IIF(not blnFATCLF, '  AND LOCATE(MOVDET.DET_CODCLI, ' + QuotedStr(VS_strCliFil) + ') <= 0 ', '');
      strSQLCond1 := strSQLCond1 + '  AND ((LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(VS_strClaVen) + ') > 0) ';
      strSQLCond1 := strSQLCond1 + '    OR (LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(VS_strClaDev) + ') > 0) ';
      strSQLCond1 := strSQLCond1 + '    OR ' + IIF(blnENTBRF, '(MOVDET.DET_ESPDOC = "BR") OR LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(CLAFIS_BR) + ')', 'FALSE') + ') ';
      strSQLCond1 := strSQLCond1 + '  AND IF(((' + IntToStr(intCOM_FF) + ' = 2 AND IFNULL(MOVDET.DET_CONPAG, ''01000'') <> ''01000'') OR (' + IntToStr(intCOM_FV) + ' = 2 AND IFNULL(MOVDET.DET_CONPAG,''01000'')  = ''01000'')),MOVDET.DET_ESPDOC NOT IN ("FF"), TRUE) ';
      strSQLCond1 := strSQLCond1 + '  AND ' + IIF(intCOM_TR = 2, 'MOVDET.DET_ESPDOC NOT IN ("TR")', 'TRUE') + ' ';
      strSQLCond1 := strSQLCond1 + '  AND ' + IIF(intCOM_DV = 2, 'MOVDET.DET_ESPDOC NOT IN ("DV")', 'TRUE') + ' ';
      strSQLCond1 := strSQLCond1 + IIF((not fEmptyStr(strDtaIni)) and (not fEmptyStr(strDtaFin)), '  AND MOVDET.DET_DTAENT BETWEEN ' + QuotedStr(strDtaIni) + ' AND ' + QuotedStr(strDtaFin) + ' ', '');
      strSQLCond1 := strSQLCond1 + IIF(not fEmptyStr(strEspDoc), '  AND LOCATE(MOVDET.DET_ESPDOC, ' + QuotedStr(strEspDoc) + ') ', '');

      strSQLCondSemRegraFat := '';
      strSQLCondSemRegraFat := strSQLCondSemRegraFat + IIF((not fEmptyStr(strDtaIni)) and (not fEmptyStr(strDtaFin)), '  AND MOVDET.DET_DTAENT BETWEEN ' + QuotedStr(strDtaIni) + ' AND ' + QuotedStr(strDtaFin) + ' ', '');
      strSQLCondSemRegraFat := strSQLCondSemRegraFat + IIF(not fEmptyStr(strEspDoc), '  AND LOCATE(MOVDET.DET_ESPDOC, ' + QuotedStr(strEspDoc) + ') ', '');

      strSQL2 := '';
      strSQL2 := strSQL2 + 'SELECT DISTINCT ';
      strSQL2 := strSQL2 + '  MOVGER.GER_NUMDOC, ';
      strSQL2 := strSQL2 + '  MOVGER.GER_ESPDOC, ';
      strSQL2 := strSQL2 + '  MOVGER.GER_CODEMP, ';
      strSQL2 := strSQL2 + '  MOVGER.GER_CODCLI, ';
      strSQL2 := strSQL2 + '  MOVGER.GER_DTAFAT AS GER_DTAENT, ';
      strSQL2 := strSQL2 + '  MOVGER.AUTOINCREM ';
      strSQL2 := strSQL2 + 'FROM MOVDET ';
      strSQL2 := strSQL2 + '  JOIN MOVGER ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
      strSQL2 := strSQL2 + '  INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
      strSQL2 := strSQL2 + '  LEFT JOIN MOVICD ON MOVICD.ICD_SEQGER = MOVDET.AUTOINCREM AND MOVDET.DET_VALRET = 0 ';

      strSQLCond2 := '';
      strSQLCond2 := strSQLCond2 + IIF(not blnFATCLF, '  AND LOCATE(MOVDET.DET_CODCLI, ' + QuotedStr(VS_strCliFil) + ') <= 0 ', '');
      strSQLCond2 := strSQLCond2 + '  AND ((LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(VS_strClaVen) + ') > 0) ';
      strSQLCond2 := strSQLCond2 + '    OR (LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(VS_strClaDev) + ') > 0) ';
      strSQLCond2 := strSQLCond2 + '    OR ' + IIF(blnENTBRF, '(MOVDET.DET_ESPDOC = "BR") OR LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(CLAFIS_BR) + ')', 'FALSE') + ') ';
      strSQLCond2 := strSQLCond2 + '  AND MOVDET.DET_ESPDOC IN((IF(((' + IntToStr(intCOM_FF) + ' = 2 AND IFNULL(MOVDET.DET_CONPAG, ''01000'') <> ''01000'') OR (' + IntToStr(intCOM_FV) + ' = 2 AND IFNULL(MOVDET.DET_CONPAG, ''01000'') = ''01000'')), "FF", "" )), ';
      strSQLCond2 := strSQLCond2 + '                         ' + IIF(intCOM_TR = 2, '"TR"', '""') + ', ' + IIF(intCOM_DV = 2, '"DV"', '""') + ') ';
      strSQLCond2 := strSQLCond2 + IIF((not fEmptyStr(strDtaIni)) and (not fEmptyStr(strDtaFin)), '  AND MOVDET.DET_DTAFAT BETWEEN ' + QuotedStr(strDtaIni) + ' AND ' + QuotedStr(strDtaFin) + ' ', '');
      strSQLCond2 := strSQLCond2 + IIF(not fEmptyStr(strEspDoc), '  AND LOCATE(MOVDET.DET_ESPDOC, ' + QuotedStr(strEspDoc) + ') ', '');

      strSQLWhere := 'WHERE TRUE AND MOVDET.DET_PROEMB <> "S" AND MOVDET.DET_TIP_FC = "C" ' + IIF(not blnRegraFat, 'AND MOVDET.DET_ESPDOC IN ("FF","NF","IF","FV","NV","IV","EL","EV") ', '');

      if blnRegraFat then
        arrSQLConsulta := ['SELECT GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI, CLI_NOMCLI, GER_DTAENT, MOVGER.AUTOINCREM FROM (',
                           strSQL1, strSQLWhere, strSQLCond1,
                           'UNION ALL',
                           strSQL2, strSQLWhere, strSQLCond2,
                           ') AS MOVGER JOIN CADCLI ON MOVGER.GER_CODCLI = CADCLI.CLI_CODCLI']
      else
        arrSQLConsulta := ['SELECT GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI, CLI_NOMCLI, GER_DTAENT, MOVGER.AUTOINCREM FROM (',
                           strSQL1, strSQLWhere, strSQLCondSemRegraFat,
                           ') AS MOVGER JOIN CADCLI ON MOVGER.GER_CODCLI = CADCLI.CLI_CODCLI'];

      arrCamposConsulta := ['GER_NUMDOC','GER_ESPDOC','GER_CODEMP','GER_CODCLI'];

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig(arrSQLConsulta,
                  ['Documento',
                   'Espécie',
                   'Empresa',
                   'Cód. Cliente',
                   'Nome Cliente',
                   'Data Entrada',
                   'AUTOINCREM'],
                   arrCamposConsulta,
                   '',
                   'MOVGER',
                   Self.Name,
                   'Consulta Documentos de Saída ' + IIF(blnRegraFat, 'com Regra de Faturamento', 'sem Regra de Faturamento') + IIF(not fEmptyStr(strEspDoc), ' (' + strEspDoc + ')', ''),
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'GER_NUMDOC',
                   strSQLWhere,
                   '',
                   False,
                   Nil,
                   False,
                   False,
                   '',
                   Nil,
                   True,
                   True,
                   True,
                   Nil,
                   Nil,
                   Nil
                   {VS_Application}) Then
      Begin
        If Assigned(edtNumDoc) then
        Begin
          If (edtNumDoc Is TMaskEditFocus) Then
            (edtNumDoc As TMaskEditFocus).Text := qryConsulta.FieldByName('GER_NUMDOC').AsString
          Else
            edtNumDoc.Text := qryConsulta.FieldByName('GER_NUMDOC').AsString;
        End;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtNumDoc) then
          Begin
            If (edtNumDoc Is TMaskEditFocus) Then
              (edtNumDoc As TMaskEditFocus).Text := fStrZero('0', 12)
            Else
              edtNumDoc.Text := fStrZero('0', 12);
          End;

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  end;
end;

