          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
End;

function fPesqNotasx922(Self : TForm;
                        Var strNumDoc: String;
                        Var strSerDoc: String;
                        Var strEspDoc: String;
                        strCodIte: String;
                        strCodFor: string): Boolean;
  Var
    strSQL   : String;
    strGroup : String;
    qryConsulta: TUniQuery;
    arrSel: TConsultasArray;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND DET_CODEMP = ' + fQuotedStr(VS_StrCodEmp);
    strWhere := strWhere + ' AND DET_CODFOR = ' + fQuotedStr(strCodFor);
    strWhere := strWhere + '   AND RIGHT(DET_CLAFIS, 3) = "922"';
    strWhere := strWhere + '   AND (DET_QTDITE > IFNULL(DET_QTDEFT, 0) + IFNULL((SELECT  SUM(NFU_QTDATD) FROM PNENFU ';
    strWhere := strWhere + '                                                         INNER JOIN DETELE ON DETELE.AUTOINCREM = NFU_NFX117 ';
    strWhere := strWhere + '                                                         INNER JOIN GERELE ON GERELE.AUTOINCREM = DETELE.DET_SEQGER ';
    strWhere := strWhere + '                                                         WHERE NFU_NFX922 = MOVDET.AUTOINCREM ';
    strWhere := strWhere + '                                                         AND GERELE.GER_DOCENT IS NULL), 0)) ';




    strWhere := strWhere + '   AND DET_CODITE IN (' + strCodIte + ')';

    Result := strWhere;
  End;
begin
  Result := False;
  Try

    strSQL :=          'SELECT ';
    strSQL := strSQL + '  DET_NUMDOC, ';
    strSQL := strSQL + '  DET_ESPDOC, ';
    strSQL := strSQL + '  DET_SERIE_, ';
    strSQL := strSQL + '  DET_DTAENT, ';
    strSQL := strSQL + '  DET_DTADOC, ';
    strSQL := strSQL + '  DET_CODFOR, ';
    strSQL := strSQL + '  FOR_NOMFOR, ';
    strSQL := strSQL + '  MOVDET.AUTOINCREM ';
    strSQL := strSQL + ' FROM MOVDET  ';
    strSQL := strSQL + 'INNER JOIN CADFOR ON FOR_CODFOR = DET_CODFOR ';

    strGroup := strGroup + ' GROUP BY DET_SEQGER ';

    qryConsulta := fCriaQuery(Nil);
    Try
      If fConsultaConfig([strSQL, fSQLWhere(True), strGroup],
                   ['Documento', 'Espécie', 'Serie', 'Data Cadastro', 'Data Emissão', 'Cód. Fornec.', 'Fornec.', 'AUTOINCREM'],
                   ['DET_NUMDOC', 'DET_ESPDOC', 'DET_SERIE_'],
                   'AUTOINCREM',
                   'MOVDET',
                    Self.Name,
                    'Consulta dos Documentos com Classificação Fiscal x922',
                    qryConsulta,
                    Nil,
                    True,
                    arrSel,
                    'AUTOINCREM',
                    fSQLWhere(False)) Then

      Begin
        Result := True;

        strNumDoc := qryConsulta.FieldByName('DET_NUMDOC').AsString;
        strSerDoc := qryConsulta.FieldByName('DET_ESPDOC').AsString;
        strEspDoc := qryConsulta.FieldByName('DET_SERIE_').AsString;

      End;
    Finally
      FreeAndNil(qryConsulta);
    End
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;
End;

