      strSQL := strSQL + '  LEFT JOIN AUTABA ON ABA_SEQABA = KMT_SEQABA ';
      strSQL := strSQL + '                  AND ABA_CODEMP = KMT_CODEMP ';
      strSQL := strSQL + '  LEFT JOIN CADFOR ON FOR_CODFOR = ABA_CODFOR ';

      If Not Assigned(qryTabela) Then
