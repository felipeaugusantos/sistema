function fPesqArmazem(Self     : TForm;                    {* Formulário                                  *}
                      edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                      edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                      qryTabela: TUniQuery;                {* Query                                       *}
                      Var chrKey: Char;                    {* Key                                         *}
                      Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                      blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                      strArmazens: String = '';
                      strCodEmp: String = '';
                      blnSemOpeAmz: Boolean = False;
                      blnApenasComDirAce: Boolean = False): Boolean;
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND AMZ_CODEMP = ' + QuotedStr(IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp));

    If Not fEmptyStr(strArmazens) Then
      strWhere := strWhere + ' AND AMZ_CODAMZ IN (' + strArmazens + ') ';

    If blnSemOpeAmz Then
      strWhere := strWhere + ' AND AM.AUTOINCREM NOT IN (SELECT OPE_CODAMZ FROM OPEAMZ) ';

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE      ';
      strSQL := strSQL + '       AM.AMZ_CODAMZ,    ';
      strSQL := strSQL + '       AM.AMZ_DESCRI,    ';
      strSQL := strSQL + '       CONCAT(OPE_CODEMP," - ",OPE_NOMOPE)';
      strSQL := strSQL + '       AS AMZ_OPERES, ';
      strSQL := strSQL + '       AM.AUTOINCREM     ';
      strSQL := strSQL + 'FROM                     ';
      strSQL := strSQL + '       CADAMZ AM         ';
      strSQL := strSQL + 'LEFT OUTER JOIN CADOPE ON ';
      strSQL := strSQL + '(CADOPE.OPE_CODOPE = AM.AMZ_OPERES)';

      If blnApenasComDirAce Then
      Begin
        strSQL := strSQL + ' INNER JOIN OPEAMZ Z                 ';
        strSQL := strSQL + '    ON AM.AUTOINCREM = Z.OPE_CODAMZ  ';
        strSQL := strSQL + '   AND Z.OPE_CODOPE = ' + QuotedStr(strLoginUsuarioLogado);
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                  ['Código',
                   'Descrição',
                   'Responsável',
                   'AUTOINCREM'],
                   ['AMZ_DESCRI','AMZ_CODAMZ','AMZ_OPERES'],
                   '',
                   'CADAMZ',
                   Self.Name,
                   'Consulta de Armazéns',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AMZ_CODAMZ',
                   fSQLWhere(False)) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('AMZ_CODAMZ').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('AMZ_CODAMZ').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('AMZ_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 3)
            Else
              edtCodigo.Text := fStrZero('0', 3);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;


