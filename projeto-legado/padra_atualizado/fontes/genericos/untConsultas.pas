                             const strCodCliFiltro: String=''): Boolean;
Var
  strGroup,
  strHaving,
  strSQL: string;
  qryConsulta : TUniQuery;
  strClaEnv : String;
  objConsulta: TDefConsulta;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND ((D.DET_ESPDOC = "NF" ';
    strWhere := strWhere + '      AND LOCATE(D.DET_CLAFIS, ' + QuotedStr(strClaEnv)+') > 0) ';
    strWhere := strWhere + '       OR (D.DET_ESPDOC = "ER")) ';
    strWhere := strWhere + ' AND D.DET_CODEMP = ' + QuotedStr(VS_strCodEmp)+' ';
    strWhere := strWhere + ' AND P.ITE_CODEMP = ' + QuotedStr(VS_strCodEmp)+' ';
    strWhere := strWhere + ' AND C.CLI_REMOUT = "S" ';

    If Not fEmptyStr(strCodCliFiltro) Then
      strWhere := strWhere + ' AND C.CLI_CODCLI = ' + QuotedStr(strCodCliFiltro);

    Result := strWhere;
  End;
Begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strClaEnv := '5' + fCfgSis('CFRSAI') + '_' + '6' + fCfgSis('CFRSAI') + '_' + '5' + fCfgSis('CFRSAS') + '_' + '6' + fCfgSis('CFRSAS') + '_';

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  D.DET_DTAENT, ';
      strSQL := strSQL + '  DOCUMENTO,    ';
      strSQL := strSQL + '  D.DET_CLAFIS, ';
      strSQL := strSQL + '  CLIENTE,      ';
      strSQL := strSQL + '  D.DET_CODVEN, ';
      strSQL := strSQL + '  G.GER_VLRCON, ';
      strSQL := strSQL + '  D.AUTOINCREM  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  MOVDET D ';
      strSQL := strSQL + '  INNER JOIN CADITE I ';
      strSQL := strSQL + '    ON D.DET_CODITE = I.ITE_CODITE ';
      strSQL := strSQL + '  INNER JOIN ITEGER P ';
      strSQL := strSQL + '    ON P.ITE_CODITE = D.DET_CODITE ';
      strSQL := strSQL + '  INNER JOIN CADCLI C ';
      strSQL := strSQL + '    ON D.DET_CODCLI = C.CLI_CODCLI ';
      strSQL := strSQL + '  INNER JOIN MOVGER G ';
      strSQL := strSQL + '    ON D.DET_SEQGER = G.AUTOINCREM ';
      strSQL := strSQL + '  LEFT JOIN CADUNI U ';
      strSQL := strSQL + '    ON I.ITE_CODUNI = U.UNI_CODUNI ';
      strSQL := strSQL + '  LEFT JOIN ';
      strSQL := strSQL + '    (SELECT ';
      strSQL := strSQL + '      CON_NUMDOC, ';
      strSQL := strSQL + '      CON_ESPDOC, ';
      strSQL := strSQL + '      CON_CODEMP, ';
      strSQL := strSQL + '      CON_CODITE, ';
      strSQL := strSQL + '      SUM(CON_QTDITE) AS CON_QTDITE, ';
      strSQL := strSQL + '      SUM(CON_DESESP) AS CON_DESESP ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + ' , DET_CODCLI ';

      strSQL := strSQL + '    FROM ';
      strSQL := strSQL + '      (SELECT ';
      strSQL := strSQL + '        CON_NUMDOC, ';
      strSQL := strSQL + '        CON_ESPDOC, ';
      strSQL := strSQL + '        CON_CODEMP, ';
      strSQL := strSQL + '        CON_CODITE, ';
      strSQL := strSQL + '        CON_QTDITE, ';
      strSQL := strSQL + '        CON_DESESP ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + ' , DET_CODCLI ';

      strSQL := strSQL + '      FROM ';
      strSQL := strSQL + '        MOVCON ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + ' INNER JOIN MOVDET ON MOVDET.AUTOINCREM = MOVCON.CON_SEQGER ';

      strSQL := strSQL + '      UNION ';
      strSQL := strSQL + '      ALL ';
      strSQL := strSQL + '      SELECT ';
      strSQL := strSQL + '        CON_NUMDOC, ';
      strSQL := strSQL + '        CON_ESPDOC, ';
      strSQL := strSQL + '        CON_CODEMP, ';
      strSQL := strSQL + '        CON_CODITE, ';
      strSQL := strSQL + '        CON_QTDITE, ';
      strSQL := strSQL + '        CON_DESESP ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + ' , DET_CODCLI ';

      strSQL := strSQL + '      FROM ';
      strSQL := strSQL + '        NOTCON ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + ' INNER JOIN NOTDET ON NOTDET.AUTOINCREM = NOTCON.CON_SEQGER ';

      strSQL := strSQL + ') AS A ';
      strSQL := strSQL + '    GROUP BY CON_NUMDOC, ';
      strSQL := strSQL + '      CON_ESPDOC, ';
      strSQL := strSQL + '      CON_CODEMP, ';
      strSQL := strSQL + '      CON_CODITE ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + ', DET_CODCLI ';

      strSQL := strSQL + ') AS R ';

      strSQL := strSQL + '    ON R.CON_NUMDOC = D.DET_NUMDOC  ';
      strSQL := strSQL + '    AND R.CON_ESPDOC = D.DET_ESPDOC ';
      strSQL := strSQL + '    AND R.CON_CODEMP = D.DET_CODEMP ';
      strSQL := strSQL + '    AND R.CON_CODITE = D.DET_CODITE ';

      If (fCfgSis('MDLVFE', varString) = '2') Then
        strSQL := strSQL + '   AND R.DET_CODCLI = D.DET_CODCLI ';

      strSQL := strSQL + '  LEFT JOIN MOVTRI T ';
      strSQL := strSQL + '    ON T.DET_SEQGER = D.AUTOINCREM ';

      strGroup := '';
      strGroup := strGroup + ' GROUP BY D.DET_CODCLI, D.DET_NUMDOC ';

      strHaving := '';
      strHaving := strHaving + ' HAVING ';
      strHaving := strHaving + '  SUM(IFNULL(D.DET_UNITAR, 0.0) * ( ';
      strHaving := strHaving + '    IFNULL(D.DET_QTDITE, 0.0) - IFNULL(R.CON_QTDITE, 0.0) ';
      strHaving := strHaving + '  )) > 0 ';

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('DOCUMENTO','CONCAT(D.DET_NUMDOC,"-",D.DET_ESPDOC,"-",D.DET_CODEMP)');
      objConsulta.pIncluiSubConsulta('CLIENTE', 'CONCAT(D.DET_CODCLI,"-",C.CLI_NOMCLI)');

      qryConsulta := fCriaQuery(Nil);

      If fConsultaConfig([strSQL, fSQLWhere(True), strGroup, strHaving],
                  ['Dt.Emissao',
                   'Documento',
                   'CFOP',
                   'Cliente',
                   'Ven',
                   'Vr. Contabil'],
                   ['DET_DTAENT', 'DOCUMENTO', 'D.DET_CLAFIS', 'CLIENTE', 'D.DET_CODVEN', 'G.GER_VLRCON'],
                   '',
                   'MOVDET',
                   Self.Name,
                   'Consulta de Remessas',
                   qryConsulta,
                   Nil,
                   TRUE,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtNumDoc) Then
          edtNumDoc.Text := qryConsulta.FieldByName('DET_NUMDOC').AsString;

        strCodCli := qryConsulta.FieldByName('DET_CODCLI').AsString;

        Result := True;
      End;
      FreeAndNil(qryConsulta);
      FreeAndNil(objConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
End;

function fPesqRomaneioLoteSeparacao(Self      : TForm;                            {* Formulário                                  *}
