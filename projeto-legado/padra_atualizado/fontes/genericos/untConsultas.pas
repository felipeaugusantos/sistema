        blnIncluiJoinEnderecos := True;

      If objLoadSQL.fIncluiSubConsulta('CLI_CEPCOB', 'IF(C.CLI_ENDCOB = "" OR C.CLI_ENDCOB IS NULL, C.CLI_C_E_P_, C.CLI_CEPCOB)', 'CEP de Cobrança') Then
        blnIncluiJoinEnderecos := True;

      If objLoadSQL.fIncluiSubConsulta('CLI_ENDENT', 'IF(ET.ETC_ENDENT = "" OR ET.ETC_ENDENT IS NULL, CONCAT(C.CLI_ENDERE," ", IFNULL(C.CLI_ENDNUM,"")), ET.ETC_ENDENT)', 'Endereço de Entrega') Then
        blnIncluiJoinEnderecos := True;

      If objLoadSQL.fIncluiSubConsulta('CLI_BAIENT', 'IF(ET.ETC_ENDENT = "" OR ET.ETC_ENDENT IS NULL, C.CLI_BAIRRO,  ET.ETC_BAIENT)', 'Bairro de Entrega') Then
        blnIncluiJoinEnderecos := True;

