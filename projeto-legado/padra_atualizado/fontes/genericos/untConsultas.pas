function fPesqLeads(Self     : TForm;            {* Formulário                                  *}
                    edtCodigo: TCustomEdit;      {* Edit do Código                              *}
                    edtDescri: TEditFocus;       {* Edit da Descrição                           *}
                    qryTabela: TUniQuery;        {* Query                                       *}
                    Var chrKey: Char;            {* Key                                         *}
                    Var arrSel: TConsultasArray; {* Array de Seleção                            *}
                    blnConSim: Boolean;          {* Consulta Simples ou Múltipla (multi select) *}
                    strCodCli: String):Boolean;
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    objConsulta : TDefConsulta;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If not fEmptyStr(strCodCli) Then
      strWhere := strWhere + ' AND LDG_CODCLI = ' + QuotedStr(strCodCli);

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + ' SELECT NUM_DOC,                                       ';
      strSQL := strSQL + '        COD_CLI,                                       ';
      strSQL := strSQL + '        NOM_CLI,                                       ';
      strSQL := strSQL + '        FAS_OBR,                                       ';
      strSQL := strSQL + '        NOM_VEN,                                       ';
      strSQL := strSQL + '        NOM_EXT,                                       ';
      strSQL := strSQL + '        NOM_INS,                                       ';
      strSQL := strSQL + '        CAT_DESCRI,                                    ';
      strSQL := strSQL + '        LDG_INIOBR,                                    ';
      strSQL := strSQL + '        LDG_PREORC,                                    ';
      strSQL := strSQL + '        LDG_NOMPRO,                                    ';
      strSQL := strSQL + '        LDG_TOTVPR,                                    ';
      strSQL := strSQL + '        STA_TUS,                                       ';
      strSQL := strSQL + '        LDG_DTAFIN,                                    ';
      strSQL := strSQL + '        OPE_FIN,                                       ';
      strSQL := strSQL + '        G.AUTOINCREM                                   ';
      strSQL := strSQL + ' FROM LADGER G                                         ';
      strSQL := strSQL + '   LEFT JOIN CADOPE EXT ON EXT.OPE_CODOPE = LDG_VENEXT ';
      strSQL := strSQL + '   LEFT JOIN CADCLI INS ON INS.CLI_CODCLI = LDG_CODINS ';
      strSQL := strSQL + '   LEFT JOIN CADCLI CLI ON CLI.CLI_CODCLI = LDG_CODCLI ';
      strSQL := strSQL + '   LEFT JOIN CADOPE VEN ON VEN.OPE_CODOPE = LDG_CODVEN ';
      strSQL := strSQL + '   LEFT JOIN FASOBR OBR ON OBR.FAS_CODFAS = LDG_CODFAS ';
      strSQL := strSQL + '   LEFT JOIN CATEGO CTE ON CTE.CAT_CODIGO = LDG_CODCAT ';
      strSQL := strSQL + '   LEFT JOIN CADOPE OPEFIN ON OPEFIN.OPE_CODOPE = LDG_OPEFIN ';


      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('NUM_DOC', 'LDG_NUMDOC');
      objConsulta.pIncluiSubConsulta('COD_CLI', 'LDG_CODCLI');
      objConsulta.pIncluiSubConsulta('NOM_CLI', 'CLI.CLI_NOMCLI');
      objConsulta.pIncluiSubConsulta('FAS_OBR', 'FAS_DESCRI');
      objConsulta.pIncluiSubConsulta('NOM_VEN', 'VEN.OPE_NOMOPE');
      objConsulta.pIncluiSubConsulta('NOM_EXT', 'EXT.OPE_NOMOPE');
      objConsulta.pIncluiSubConsulta('NOM_INS', 'INS.CLI_NOMCLI');
      objConsulta.pIncluiSubConsulta('STA_TUS', 'CASE LDG_STATUS ' +
                                                '  WHEN "A" THEN "ANDAMENTO" ' +
                                                '  WHEN "F" THEN "FINALIZADO" ' +
                                                '  WHEN "B" THEN "ABERTO" ' +
                                                '  WHEN "P" THEN "FATURAMENTO PARCIAL" ' +
                                                '  ELSE "" ' +
                                                'END');
      objConsulta.pIncluiCampoSimNao('STA_TUS', ['ANDAMENTO', 'FINALIZADO', 'ABERTO', 'FATURAMENTO PARCIAL','TODOS']);
      objConsulta.pIncluiSubConsulta('OPE_FIN', 'OPEFIN.OPE_NOMOPE');

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                  ['Documento',
                   'Cód. Cliente',
                   'Cliente',
                   'Fase da Obra',
                   'Vendedor',
                   'Vendedor Externo',
                   'Instalador',
                   'Categoria',
                   'Data de início da obra',
                   'Data de previsão do orçamento',
                   'Nome do Projeto',
                   'Valor Total da Previsão do Orçamento',
                   'Status',
                   'Data da Finalização',
                   'Operador da Finalização',
                   'AUTOINCREM'],
                   ['LDG_NUMDOC'],
                   'AUTOINCREM',
                   'LADGER',
                   Self.Name,
                   'Consulta de Leads',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False),
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('LDG_NUMDOC').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('LDG_NUMDOC').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('LDG_NUMDOC').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 12)
            Else
              edtCodigo.Text := fStrZero('0', 12);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

      End;

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

