function fPesqLayout(Self     : TForm;                 {* Formulário                                  *}
                     edtCodigo: TCustomEdit;           {* Edit do Código                              *}
                     edtDescri: TEditFocus;            {* Edit da Descrição                           *}
                     qryTabela: TUniQuery;             {* Query                                       *}
                     strTipImp: String;                {* JATO / MATRICIAL                            *}
                     Var chrKey: Char;                 {* Key                                         *}
                     Var arrSel: TConsultasArray;      {* Array de Seleção                            *}
                     blnConSim: Boolean = True;        {* Consulta Simples ou Múltipla (multi select) *}
                     strTipLay: String = '';
                     tplTipLay: TTipoLayout = tplDocumentos; {* Documento / Etiqueta        *}
                     blnEmpres: Boolean = True): Boolean;    {* Variavel para buscar somente empresa logada *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If blnEmpres then
      strWhere := ' WHERE LAY_CODEMP = ' + QuotedStr(VS_strCodEmp)
    Else
      strWhere := ' WHERE TRUE ';

    if not fEmptyStr(strTipImp) Then
      strWhere := strWhere + ' AND LAY_TIPIMP = ' + QuotedStr(strTipImp);

    case tplTipLay of
      tplDocumentos:  strWhere := strWhere + ' AND LAY_TIPREG = 1 ';
      tplEtiquetas :  strWhere := strWhere + ' AND LAY_TIPREG = 0 ';
    end;

    If Not fEmptyStr(strTipLay) Then
    Begin
      strWhere := strWhere + ' AND LAY_TIPLAY = ' + QuotedStr(strTipLay);
    End;

    Result := strWhere;
  End;
begin
