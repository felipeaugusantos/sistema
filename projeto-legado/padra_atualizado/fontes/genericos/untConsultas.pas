      strWhere := strWhere + 'WHERE            ';
      strWhere := strWhere + '  (SELECT FGO_JAFATU FROM FATGOR WHERE FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO) = 0 ';

      strGroup := '';
      strGroup := strGroup + 'GROUP BY         ';
      strGroup := strGroup + '  FGO_SEQSEP     ';

      strHaving := '';
      strHaving := strHaving + 'HAVING         ';
      strHaving := strHaving + '  (FGO_SEQSEP IS NOT NULL) AND (FGO_SEQSEP <> '''')';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
