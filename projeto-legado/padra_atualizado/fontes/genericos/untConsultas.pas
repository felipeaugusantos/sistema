                                    blnConSim : Boolean = True;                   {* Consulta Simples ou Múltipla (multi select) *}
                                    strCodEmp : String = '';
                                    blnApenasPedidosEmAberto : Boolean = False): Boolean;
var
  arrTitCol  : TColunasArray;
  strSQL     : String;
  qryConsulta: TUniQuery;
  objConsulta: TDefConsulta;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND ROMEMP = ' + QuotedStr(IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp));

    if blnApenasPedidosEmAberto then
      strWhere := strWhere + ' AND CODEMP = ' + QuotedStr(IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp));

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('CLIENTE',        '(SELECT CLI_NOMCLI FROM CADCLI WHERE CODCLI = CLI_CODCLI) ');
