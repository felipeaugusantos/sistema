  arrTitCol[01] := 'Esp.';
  arrTitCol[02] := 'Emp.';
  arrTitCol[03] := 'Cód. Cliente';
  arrTitCol[04] := 'Nome Cliente';
  arrTitCol[05] := 'Nome Fantasia';
  arrTitCol[06] := 'E-mail';
  arrTitCol[07] := 'Vendedor';
  arrTitCol[08] := 'Dt. Documento';
  arrTitCol[09] := 'Cond. Pgto.';
  arrTitCol[10] := 'R$ Valor';
  arrTitCol[11] := 'Cód. Transp.';
  arrTitCol[12] := 'Transportadora';
End;

Procedure pPesqPedOrcSqlCompleto(Var strSQL, strWhere: String;
                                 Var arrTitCol: TColunasArray;
                                     strEspDoc,
                                     strOpcDoc,
                                     strCodEmp: String;
                                     objConsulta: TDefConsulta;
                                     strCliCrm: String;
                                     strOriF11: String = 'N';
                                     blnFiltrarTodasAsLojas: Boolean = False);
  Var
    blnUltPed  : Boolean;
    strConsulta: String;
    strWhereAux: String;
    qryCat: TUniQuery;
    blnGarInd: Boolean;

    function fRetTipoAtendimento: String;
    begin
      Result := '(SELECT TPA_DESCRI FROM EXTGOR EXT ' +
                ' INNER JOIN CADTPA TPA ON TPA.TPA_CODIGO = EXT.FGO_CODTPA ' +
                ' WHERE EXT.FGO_SEQFGO = FATGOR.AUTOINCREM)';
    end;

    function fRetPedidoCompraVinculado: String;
    begin
      Result := '(SELECT GROUP_CONCAT(IF(IFNULL(PCD_NUMPED, "") = "", "",     '+
                '                        CONCAT(PCD_NUMPED,"-",PCD_ESPDOC,"-",'+
                '                               PCD_CODEMP))) AS NUMPED       '+
                '   FROM PCMDET PC                                            '+
                '   JOIN MOVRCD RD ON RD.RCD_SEQPCD = PC.AUTOINCREM           '+
                '  WHERE RCD_DOCPDV = FGO_NUMDOC                              '+
                '    AND RCD_ESPPDV = FGO_ESPDOC                              '+
                '    AND RCD_EMPPDV = FGO_CODEMP                             )';
    end;

    Procedure pAddNomeColuna(strNomCol: String);
    Begin
      SetLength(arrTitCol, Succ(Length(arrTitCol)));
      arrTitCol[High(arrTitCol)] := strNomCol;
    End;

    Function fRetSqlStaSer: String;
      Var
        intSer : Integer;
        strSelect, strLeft : String;
    begin
      Result    := '';
      strSelect := '';
      strLeft   := '';

      For intSer := 1 To 30 Do
      Begin
        strSelect := strSelect + ' IF(S'+ fStrZero(intSer.ToString, 2) +'.STS_DESCRI IS NULL, "", CONCAT("'+ fStrZero(intSer.ToString, 2) +'-",S'+ fStrZero(intSer.ToString, 2) +'.STS_DESCRI, " / ")) ' + IFThen(intSer < 30, ',', '');
        strLeft   := strLeft + ' LEFT JOIN STASER S'+ fStrZero(intSer.ToString, 2) +' ON S'+ fStrZero(intSer.ToString, 2) +'.STS_CODIGO = SERGOR.FGO_STAS'+ fStrZero(intSer.ToString, 2);
      End;

      Result := ' SELECT IFNULL((SELECT CONCAT( ';
      Result := Result + strSelect;
      Result := Result + ' ) FROM SERGOR ';
      Result := Result + strLeft;
      Result := Result + ' WHERE SERGOR.FGO_SEQFGO = FATGOR.AUTOINCREM), "") ';
      Result := '(' + Result + ')';

    end;

    Function fRetSqlFat: String;
      Var
        strSQL: String;
    Begin
      strSQL := '';
      strSQL := strSQL + '  IF(';
      strSQL := strSQL + ' (SELECT COUNT(*) FROM FATDOR           ';
      strSQL := strSQL + ' WHERE                                  ';
      strSQL := strSQL + '   FGO_NUMDOC = FDO_NUMDOC AND          ';
      strSQL := strSQL + '   FGO_ESPDOC = FDO_ESPDOC AND          ';
      strSQL := strSQL + '   FGO_CODEMP = FDO_CODEMP AND          ';
      strSQL := strSQL + '   FGO_CODCLI = FDO_CODCLI AND          ';
      strSQL := strSQL + '   (FDO_QTDBAI < FDO_QTDITE) AND (FDO_QTDBAI > 0)) > 0, "PAR  ", ';
      strSQL := strSQL + '  IF(FGO_JAFATU = 0, "NÃO  ", "SIM  "))';

      Result := strSQL;
    End;

    function fRetEmpDestinoTE: String;
    Begin
      Result := '';
      Result := Result + ' (SELECT EMP_CODEMP FROM CADEMP WHERE EMP_CLIFIL = FGO_CODCLI LIMIT 1) ';
    End;

    function fRetEmpresaItens: String;
    begin
      Result := '';
      Result := Result + '   IF( ';
      Result := Result + '     IFNULL(FGO_ENT_CD, "N") = "S", ';
      Result := Result + '     FGO_EMP_CD, ';
      Result := Result + '     (SELECT DISTINCT ';
      Result := Result + '       GROUP_CONCAT( ';
      Result := Result + '         DISTINCT FDO_EMPITE ';
      Result := Result + '         ORDER BY FDO_EMPITE SEPARATOR " | " ';
      Result := Result + '       ) AS EMPITE ';
      Result := Result + '     FROM ';
      Result := Result + '       FATDOR FD ';
      Result := Result + '       INNER JOIN EXTDOR ED ';
      Result := Result + '         ON FD.AUTOINCREM = ED.FDO_SEQFDO ';
      Result := Result + '     WHERE FD.FDO_SEQGER = FATGOR.AUTOINCREM ';
      Result := Result + '     ORDER BY FDO_EMPITE) ';
      Result := Result + '   ) ';
    end;

    function fRetCamposGrid: String;
      Var
        strSQL: String;
        strKey: String;
        arrOpc: TarrCampos;
    begin
      strSQL := '';

      SetLength(arrTitCol, 0);

      If (fCfgSis('MOPDFA', varBoolean)) Then
      Begin
        strSQL := strSQL + '  FGO_FAT___, ';
        strSQL := strSQL + '  FGO_NUMFAT, ';
        strSQL := strSQL + '  FGO_TIPFAT, ';
        strSQL := strSQL + '  FGO_DTAFAT, ';
        strSQL := strSQL + '  FGO_VENFAT, ';

        pAddNomeColuna('Fat.');
        pAddNomeColuna('Num. Fat.');
        pAddNomeColuna('Tip. Fat.');
        pAddNomeColuna('Dta. Fat.');
        pAddNomeColuna('Vct. Fat.');

        objConsulta.pIncluiSubConsulta('FGO_FAT___', fRetSqlFat);
      End;

      strSQL := strSQL + '  FGO_NUMDOC, ';
      strSQL := strSQL + '  FGO_ESPDOC, ';
      strSQL := strSQL + '  FGO_CODEMP, ';
      strSQL := strSQL + '  FGO_PEDSIT, ';
      strSQL := strSQL + '  FGO_CODCLI, ';
      strSQL := strSQL + '  CLI_NOMCLI, ';

      strSQL := strSQL + '  CLI_FANSOB, ';

      If fCfgSis('AUTCEN', varBoolean) Then
      begin

        {Placa do Veículo}
        strSQL := strSQL + '  FGO_PLAVEI, ';

        {Modelo do Veículo}
        strSQL := strSQL + '  MODELO_VEICULO, ';
        objConsulta.pIncluiSubConsulta('MODELO_VEICULO',
                                      '  (                                                             ' +
                                      '  SELECT                                                        ' +
                                      '    MODVEI.MOD_DESMOD                                           ' +
                                      '  FROM                                                          ' +
                                      '    CADVEI                                                      ' +
                                      '    LEFT JOIN MODVEI ON (MODVEI.MOD_CODMOD = CADVEI.VEI_CODMOD) ' +
                                      '  WHERE                                                         ' +
                                      '    CADVEI.VEI_PLAVEI = FGO_PLAVEI                              ' +
                                      '  )                                                             ' );
        {Status do Serviço}
        strSQL := strSQL + '  STATUS_SERVICO, ';
        objConsulta.pIncluiSubConsulta('STATUS_SERVICO', fRetSqlStaSer);

      end;

      strSQL := strSQL + '  CLI_EMAIL_, ';
      strSQL := strSQL + '  FGO_CODVEN, ';

      If fCfgSis('USADIG', varBoolean) Then
        strSQL := strSQL + '  FGO_CODDIG, ';

      strSQL := strSQL + '  FGO_DTAENT, ';
      strSQL := strSQL + '  FGO_HORENT, ';
      strSQL := strSQL + '  FGO_CONPAG, ';

      If fCfgSis('USAFPG', VarBoolean) Then
      Begin
        strSQL := strSQL + '  FGO_FORPAG, ';
        objConsulta.pIncluiSubConsulta('FGO_FORPAG', '(SELECT CONCAT(FPG_CODIGO, "-", FPG_DESCRI) FROM CADFPG WHERE FPG_CODIGO = FGO_CODFPG)');
      End;

      strSQL := strSQL + '  FGO_VLRCON, ';
      strSQL := strSQL + '  FGO_CODTRA, ';
      strSQL := strSQL + '  TRA_NOMTRA, ';
      strSQL := strSQL + '  FGO_NUMCMP, ';
      strSQL := strSQL + '  FGO_NUMPOK, ';

      objConsulta.pIncluiSubConsulta('FGO_NUMCMP', fGetSQLNumCmp());
      strSQL := strSQL + '  FGO_DTAIMP, ';
      strSQL := strSQL + '  FGO_HORIMP, ';

      If (fCfgSis('ENT_CD', varBoolean)) Then
      Begin
        strSQL := strSQL + '  FGO_ENT_CD, ';

        strSQL := strSQL + '  ENTCD_SN, ';
        objConsulta.pIncluiSubConsulta('ENTCD_SN', 'IF(IFNULL(FGO_ENT_CD, "N") = "S", "SIM", "NÃO")');
      End;

      strSQL := strSQL + '  CID_NOMCID, ';
      strSQL := strSQL + '  CID_ESTADO, ';
      strSQL := strSQL + '  FGO_FINLIB, ';

      pAddNomeColuna('Documento');
      pAddNomeColuna('Esp.');
      pAddNomeColuna('Emp.' + IIF(SameText(strOpcDoc, 'TE'), ' Origem', ''));
      pAddNomeColuna('Pedido Site');
      pAddNomeColuna('Cód. Cliente');
      pAddNomeColuna('Nome Cliente');
      pAddNomeColuna('Nome Fantasia');

      If fCfgSis('AUTCEN', varBoolean) Then
      begin
        pAddNomeColuna('Placa Veículo');
        pAddNomeColuna('Modelo Veículo');
        pAddNomeColuna('Status Serviço');
      end;

      pAddNomeColuna('E-mail');
      pAddNomeColuna('Vendedor');

      If fCfgSis('USADIG', varBoolean) Then
        pAddNomeColuna('Digitador');

      pAddNomeColuna('Dta. Doc.');
      pAddNomeColuna('Hora Doc.');
      pAddNomeColuna('Cond. Pgto.');

      If fCfgSis('USAFPG', VarBoolean) Then
        pAddNomeColuna('Forma Pgto.');

      pAddNomeColuna('R$ Valor');
      pAddNomeColuna('Cód. Transp.');
      pAddNomeColuna('Transportadora');
      objConsulta.pIncluiSubConsulta('TRA_NOMTRA', 'TRA.TRA_NOMTRA');
      pAddNomeColuna('Pedido de Compra Cliente');
      pAddNomeColuna('Nº Pocket');

      pAddNomeColuna('Data Import.');
      pAddNomeColuna('Hora Import.');

      If (fCfgSis('ENT_CD', varBoolean)) Then
      begin
        pAddNomeColuna('Campo Entrega pelo CD?');
        pAddNomeColuna('Entrega pelo CD?');
      end;

      pAddNomeColuna('Cidade');
      pAddNomeColuna('UF');
      pAddNomeColuna('Status Dep. Financeiro');

      If ((fCfgSis('AGDLIB', varBoolean) And fCfgSis('LPPDBL', varBoolean))) Or fCfgSis('AGDLBT', VarBoolean) Then
      Begin
        strSQL := strSQL + ' FGO_COMLIB,           ';
        pAddNomeColuna('Status Dep. Comercial');
      End;

      If fCfgSis('UTTRDP', varBoolean) Then
      Begin
        strSQL := strSQL + '  FGO_TRARDP, ';
        pAddNomeColuna('Cód. Transp. de Redespacho');

        strSQL := strSQL + ' TRA_NOMTRD, ';
        pAddNomeColuna('Transportadora de Redespacho');
        objConsulta.pIncluiSubConsulta('TRA_NOMTRD', 'IFNULL(TRD.TRA_NOMTRA, "")');
        objConsulta.pIncluiCampoProcessado('TRA_NOMTRD');
      End;

      If (strEspDoc = 'PD') Then
      Begin
        If (fCfgSis('EXISTA', VarBoolean)) Then
        Begin
          strSQL := strSQL + ' IFNULL(S.STA_DESCRI, "") AS FGO_STATUS,         ';
          pAddNomeColuna('Status do Pedido');

          strSQL := strSQL + ' IFNULL(S.STA_DESCRI, "") AS FGO_LEGEND,      ';
          pAddNomeColuna('Status');
          objConsulta.pIncluiCampoProcessado('FGO_LEGEND');

          SetLength(arrOpc, 0);
          For strKey In TSituacaoPedidoVenda.fRetornaLegenda.Keys Do
          Begin
            objConsulta.pIncluiIcone('FGO_LEGEND', strKey, TSituacaoPedidoVenda.fRetornaLegenda.Items[strKey], False, frmModuloLegenda.imglLegenda);

            SetLength(arrOpc, Succ(Length(arrOpc)));
