Procedure pCopiaArray(Var arrDestino: TColunasArray; arrOrigem: TColunasArray);
  Var
    intContador: Integer;
Begin
  SetLength(arrDestino, Length(arrOrigem));

  For intContador := Low(arrOrigem) To High(arrOrigem) Do
    arrDestino[intContador] := arrOrigem[intContador];
End;

function fConsultaConfig(arrSql,
                         arrCampos,
                         arrOrdenacao: TColunasArray;
                         strCampoChave,
                         strTabela,
                         strNomForm,
                         strTitulo: String;
                         qryAux: TUniQuery;
                         objFrmPnl: TPanelCx;
                         blnSimples: Boolean;
                         Var arrSelec: TConsultasArray;
                         strCodBusca: String = 'AUTOINCREM';
                         strWhereAdicionalConfig: String = '';
                         strGroupByAdicionalConfig: String = '';
                         blnUsarObjConsultaProgramador: Boolean = False;
                         objConsulta: TDefConsulta = Nil;
                         blnTablet: Boolean = False;
                         blnConIte: Boolean = False;
                         strCampoChave2 : String = '';
                         pAfterAtualiza: TGenericProcedureWithClientParam = Nil;
                         blnRefresh: Boolean = True;
                         blnConfirma: boolean = True;
                         blnConCon: Boolean = True;
                         fChamaCadastro : TBooleanFunctionWithBooleanParam = Nil;
                         objPnlBanner: TPanelCx = Nil;
                         objPnlPreFiltro: TPanelCx = Nil;
                         _Application : TApplication = Nil;
                         pBeforeAtualiza: TGenericProcedureWithClientParamAndVar = Nil): Boolean;
Var
    objLoadSql: TLoadConsultaSQL;
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    blnLiberarConsulta: Boolean;

    objConsultaConfig,
    objConsultaUsada: TDefConsulta;

    Procedure pSetaConsultaProgramador;
    Begin
      If Assigned(objConsulta) Then
      Begin
        objConsulta.funcConfiguraConsulta := TfrmConfiguraSQLConsultaEdicao.fConfiguraConsulta;
        objConsulta.strChaveConsulta      := TLoadConsultaSQL.fGetChaveConsulta(strTitulo);
        objConsultaUsada                  := objConsulta;
      End;
    End;

    procedure pSetaBetweenProgramador;
    Begin
      If Assigned(objConsulta) Then
      Begin
        if Assigned(objConsulta.arrCamBetween) then
        begin
          if Length(objConsulta.arrCamBetween) > 0 then
          begin
            objConsultaUsada.pIncluiCampoBetween(objConsulta.arrCamBetween);
          end;
        end;
        if Assigned(objConsulta.arrRecIco) then
        begin
          if Length(objConsulta.arrRecIco) > 0 then
          begin
            objConsultaUsada.pIncluiCampoBetweenIcon(objConsulta.arrRecIco);
          end;
        end;
      End;
    End;

Begin
  If (Not Assigned(objConsulta)) Or (Not blnUsarObjConsultaProgramador) Then
  Begin
    objConsultaConfig := TDefConsulta.Create;
    objConsultaUsada  := objConsultaConfig;

    blnLiberarConsulta := True;
  End Else
  Begin
    blnLiberarConsulta := False;

    pSetaConsultaProgramador;
  End;

  If Length(objConsultaUsada.arrTabelas) = 0 Then
    objConsultaUsada.pAdicionaTabela(strTabela, '');

  If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsultaUsada, strWhereAdicionalConfig.IsEmpty And
                                                                                       strGroupByAdicionalConfig.IsEmpty) Then
  Begin
    If Not strWhereAdicionalConfig.IsEmpty Then
      objLoadSQL.pSetaWhereAdicional(strWhereAdicionalConfig);

    If Not strGroupByAdicionalConfig.IsEmpty Then
      objLoadSQL.pSetaGroupByAdicional(strGroupByAdicionalConfig);

    If (Not strWhereAdicionalConfig.IsEmpty) Or
       (Not strGroupByAdicionalConfig.IsEmpty) Then
      objLoadSQL.pCarregaDadosConsulta;

    arrSQLConsulta       := objLoadSQL.arrSQL;
    arrCamposConsulta    := objLoadSQL.arrNomeColunas;
    pSetaBetweenProgramador ;
  End Else
  Begin
    arrSQLConsulta       := arrSql;
    arrCamposConsulta    := arrCampos;

    pSetaConsultaProgramador;
  End;

  If Assigned(objConsultaUsada) And Assigned(fMskCon) Then
    objConsultaUsada.strMascPlanContabil := fMskCon;

  Result := untFuncoesSimples.fConsulta(arrSqlConsulta,
                   arrCamposConsulta,
                   arrOrdenacao,
                   strCampoChave,
                   strTabela,
                   strNomForm,
                   strTitulo,
                   qryAux,
                   objFrmPnl,
                   blnSimples,
                   arrSelec,
                   strCodBusca,
                   objConsultaUsada,
                   blnTablet,
                   blnConIte,
                   strCampoChave2,
                   pAfterAtualiza,
                   blnRefresh,
                   blnConfirma,
                   blnConCon,
                   fChamaCadastro,
                   objPnlBanner,
                   objPnlPreFiltro,
                   _Application,
                   pBeforeAtualiza);

  FreeAndNil(objLoadSQL);

  If blnLiberarConsulta Then
    FreeAndNil(objConsultaConfig);
End;

{*****************************}
{* CONSULTA TIPO PLANO CONT. *}
{**************************DO*}
function fPesqTipoPlanoContabil(Self     : TForm;                    {* Formulário                                  *}
                                edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                                edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                                qryTabela: TUniQuery;                {* Query                                       *}
                                Var chrKey: Char;                    {* Key                                         *}
                                Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                                blnConSim: Boolean = True): Boolean; {* Consulta Simples ou Múltipla (multi select) *}
Var
    strSQL     : String;
    qryConsulta: TUniQuery;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT              ';
      strSQL := strSQL + '  ACO_CODIGO,       ';
      strSQL := strSQL + '  ACO_DESCRI,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  TPLACO            ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL],
                  ['Código',
                   'Descrição',
                   'AUTOINCREM'],
                   ['ACO_DESCRI','ACO_CODIGO'],
                   '',
                   'TPLACO',
                   Self.Name,
                   'Consulta de Tipo de Plano Contábil',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'ACO_CODIGO') Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('ACO_CODIGO').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('ACO_CODIGO').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('ACO_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 6)
            Else
              edtCodigo.Text := fStrZero('0', 6);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

