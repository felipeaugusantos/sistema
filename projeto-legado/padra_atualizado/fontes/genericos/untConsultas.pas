{************************************}
{* CONSULTA DE CENTRO DE CUSTOS     *}
{*********************************DP*}
function fPesqCentroCusto(Self     : TForm;                     {* Formulário                                         *}
                          edtCodigo: TCustomEdit;               {* Edit do Código                                     *}
                          edtDescri: TEditFocus;                {* Edit da Descrição                                  *}
                          qryTabela: TUniQuery;                 {* Query                                              *}
                          Var chrKey: Char;                     {* Key                                                *}
                          Var arrSel: TConsultasArray;          {* Array de Seleção                                   *}
                          blnConSim: Boolean = True;            {* Consulta Simples ou Múltipla (multi select)        *}
                          blnUsaCtf: Boolean = False;           {* Só mostra os Plano de Contas vinculados do CADFOR *}
                          strCodFor: String  = '';              {* Código da empresa se blnUsaCtf = True              *}
                          blnVemBxCtc : Boolean = False;        {* Baixa de cartões}
                          blnVemBxCh : Boolean = False;           {Baixa de cheques}
                          blnVemBxCtr : Boolean = False;          {* Baixa de contas a receber}
                          blnVemBxCta : Boolean = False): Boolean;{* Baixa de contas a pagar}

  Var
    strSQL : String;
    qryConsulta: TUniQuery;
    dfmCentroCusto: TDefMascaraCentroCusto;
    strTitulo: String;
    arrTitCol,                                                  {* Títulos das Colunas  *}
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
  Var
    strWhere: String;
  Begin
    If (blnCompleto) Then
      strWhere := ' WHERE TRUE '
    else
      strWhere := '';

    if (blnVemBxCtc) then
      strWhere := strWhere+ ' AND CTA_PERBCA = ''S'' '
    else if (blnVemBxCh) then
      strWhere := strWhere+ ' AND CTA_PERBCH = ''S'' '
    else if (blnVemBxCtr) then
      strWhere := strWhere+ ' AND CTA_PERREC = ''S'' '
    else if (blnVemBxCta) then
      strWhere := strWhere+ ' AND CTA_PERPAG = ''S'' ';

    If blnUsaCtf Then
    Begin
      strWhere := strWhere + ' AND (G.CTA_CODCTA IN (SELECT CTF_CODCTA ';
      strWhere := strWhere + ' FROM CTAFOR ';
      strWhere := strWhere + ' WHERE CTF_CODFOR = ' + QuotedStr(strCodFor);
      strWhere := strWhere + ') ';
      strWhere := strWhere + ' OR CRE_CODCTA IN (SELECT CTF_CODCTA ';
      strWhere := strWhere + ' FROM CTAFOR ';
      strWhere := strWhere + ' WHERE CTF_CODFOR = ' + QuotedStr(strCodFor);
      strWhere := strWhere + '))';
    End;

    Result := strWhere;
  End;
  Procedure pTrataConsultaConfigurada;
  var
    strLinha, strGrupo : String;
  Begin
    If blnUsaCtf Then
    Begin
      strLinha := '';
      strLinha := strLinha + '  (SELECT SQL_NO_CACHE ';
      strLinha := strLinha + '    CONCAT(LINHAS.CTA_CODCTA, " - ", LINHAS.CTA_DESCTA) ';
      strLinha := strLinha + '  FROM ';
      strLinha := strLinha + '    CADCTA LINHAS ';
      strLinha := strLinha + '  WHERE ';
      strLinha := strLinha + '    LEFT(LINHAS.CTA_CODCTA, 2) = LEFT(C.CTA_CODCTA, 2) AND ';
      strLinha := strLinha + '    RIGHT(LINHAS.CTA_CODCTA, 5) = "00000")';

      strGrupo := '';
      strGrupo := strGrupo + '  (SELECT SQL_NO_CACHE ';
      strGrupo := strGrupo + '    CONCAT(GRUPOS.CTA_CODCTA, " - ", GRUPOS.CTA_DESCTA) ';
      strGrupo := strGrupo + '  FROM ';
      strGrupo := strGrupo + '    CADCTA GRUPOS ';
      strGrupo := strGrupo + '  WHERE ';
      strGrupo := strGrupo + '    LEFT(GRUPOS.CTA_CODCTA, 4) = LEFT(C.CTA_CODCTA, 4) AND ';
      strGrupo := strGrupo + '    RIGHT(GRUPOS.CTA_CODCTA, 3) = "000")';

      objLoadSql.fIncluiSubConsulta('CTA_LINHA_', strLinha, 'Linha');
      objLoadSql.fIncluiSubConsulta('CTA_GRUPO_', strGrupo, 'Grupo');
    End;
    objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  var
    strTplaco  : String;
  Begin
    strTplaco := fRetTplacoEmpresaLogada ;
    strSQL := 'SELECT G.* FROM( ';
    strSQL := strSQL + 'SELECT  ';
    strSQL := strSQL + '  C.CTA_CODCTA, '; pAddNomeColuna('Código Completo');
    strSQL := strSQL + '  C.CTA_CODRES, '; pAddNomeColuna('Código Resumido');
    strSQL := strSQL + '  C.CTA_DESCTA, '; pAddNomeColuna('Descrição');
    strSQL := strSQL + '  C.CTA_STATUS, '; pAddNomeColuna('Status');
    strSQL := strSQL +
      ' CASE C.CTA_ENTREL '+
      ' WHEN ''N'' THEN ''Não'' '+
      ' WHEN ''S'' THEN ''Sim'' END CTA_ENTREL, '; pAddNomeColuna('Entra no Relatório de Receitas e Despesas');
    strSQL := strSQL +
      ' CASE C.CTA_PROCON '+
      ' WHEN 0 THEN ''Não'' '+
      ' WHEN 1 THEN ''Sim'' END CTA_PROCON, '; pAddNomeColuna('Gerar provisão contábil?');
    strSQL := strSQL +
      ' CASE C.CTA_EXPAUT '+
      ' WHEN ''N'' THEN ''Não'' '+
      ' WHEN ''S'' THEN ''Sim'' END CTA_EXPAUT, '; pAddNomeColuna('Exportar pelo Autsi');
    strSQL := strSQL +
      ' CASE C.CTA_FLXIMP '+
      ' WHEN ''I'' THEN ''Imposto'' '+
      ' WHEN ''D'' THEN ''Despesa'' '+
      ' WHEN ''F'' THEN ''Fornecedores'' END CTA_FLXIMP, '; pAddNomeColuna('Entra no relatório de fluxo de caixa como');
    strSQL := strSQL +
      ' CASE C.CTA_TIPCTA '+
      ' WHEN 1 THEN ''Venda Bruta\Receitas'' '+
      ' WHEN 2 THEN ''Custo do Produto'' '+
      ' WHEN 3 THEN ''Despesas'' '+
      ' WHEN 4 THEN ''Despesas Financeiras'' '+
      ' WHEN 5 THEN ''Compras'' ' +
      ' WHEN 6 THEN ''Despesas Variáveis'' END CTA_TIPCTA, '; pAddNomeColuna('Tipo');
    strSQL := strSQL + '    CTA_CTARES, '; pAddNomeColuna('Cta.Resultado');

    If (fCfgSis('UTICON') = 'N') Then
      strSQL := strSQL + '    CTA_CONCON as CTA_PLANCO, '
    Else
      strSQL := strSQL + '    CTA_PLANCO, ';

    pAddNomeColuna('Plano Contábil');

    strSQL := strSQL +
      '  CASE C.CTA_CLACTA '+
      '  WHEN 1 THEN ''Investimento'' '+
      '  WHEN 2 THEN ''Despesas Fixas'' '+
      '  WHEN 3 THEN ''Despesas Variáveis'' '+
      '  WHEN 4 THEN ''Despesas Extras'' END CTA_CLACTA, '; pAddNomeColuna('Classif. Plano de Conta');

    If blnUsaCtf Then
    Begin
      strSQL := strSQL + '    CTA_LINHA_, '; pAddNomeColuna('Linha');
      strSQL := strSQL + '    CTA_GRUPO_, '; pAddNomeColuna('Grupo');
    End;

    strSQL := strSQL + '  C.AUTOINCREM, R.CRE_CODCTA, G.CRE_CODCRE, G.CRE_DESCRE, ';
    strSQL := strSQL + '  C.CTA_PERBCA, C.CTA_PERBCH, C.CTA_PERREC, C.CTA_PERPAG   ';
    strSQL := strSQL + 'FROM            ';
    strSQL := strSQL + '  CADCTA C ';
    strSQL := strSQL + '  LEFT JOIN CTARES R ON R.CRE_CODCTA = C.CTA_CODCTA ';
    strSQL := strSQL + '  LEFT JOIN CTAGER G ON R.CRE_CODCRE = G.CRE_CODCRE ';
    strSQL := strSQL + '  LEFT JOIN PLANCO P ON P.NCO_CODCON = C.CTA_PLANCO AND P.NCO_TPLACO = ' + strTplaco.QuotedString + ' ) G';

    arrSQLConsulta    := [strSQL, fSQLWhere(True)];
    arrCamposConsulta := arrTitCol;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';

      SetLength(arrTitCol, 0);

      strTitulo := 'Consulta de Plano de Contas';

      dfmCentroCusto := TDefMascaraCentroCusto.Create;
      dfmCentroCusto.pAdicionaTabela('CADCTA', 'C');

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, dfmCentroCusto, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      dfmCentroCusto.pIncluiSubConsulta('CTA_CTARES', 'CONCAT(G.CRE_CODCRE, " - ", CRE_DESCRE)');
      dfmCentroCusto.pIncluiCampoSimNao('CTA_PROCON');
      dfmCentroCusto.pIncluiCampoSimNao('CTA_ENTREL');
      dfmCentroCusto.pIncluiCampoSimNao('CTA_EXPAUT');

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['CTA_DESCTA','CTA_TIPCTA','CTA_CODCTA'],
                   '',
                   'CADCTA',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'CTA_CODCTA',
                   dfmCentroCusto) Then

      Begin
        If Assigned(edtCodigo) then
        Begin
          If edtCodigo.ClassNameIs('TMaskEditFocus') Or
             (edtCodigo.ClassNameIs('TDBEditFocus') And (Not fEmptyStr(TDBEditFocus(edtCodigo).Field.EditMask))) Then
            TMaskEditFocus(edtCodigo).Text := qryConsulta.FieldByName('CTA_CODCTA').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('CTA_CODCTA').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('CTA_DESCTA').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If edtCodigo.ClassNameIs('TMaskEditFocus') Then
              TMaskEditFocus(edtCodigo).Text := '0'
            Else
              edtCodigo.Text := fStrZero('0', 7);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        If Length(arrSel) = 1 Then
          arrSel[0].strDescri := qryConsulta.FieldByName('CTA_DESCTA').AsString;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

      End;
      FreeAndNil(dfmCentroCusto);

      FreeAndNil(objLoadSQL);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

end;

