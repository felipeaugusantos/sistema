      strSQL := strSQL + '   CIDCON,                                            ';
      strSQL := strSQL + '   CODMOT,                                            ';
      strSQL := strSQL + '   CODTRA,                                            ';
      strSQL := strSQL + '   ROMEMP,                                            ';
      strSQL := strSQL + '   TMP.AUTOINCREM,                                    ';
      strSQL := strSQL + '   NUMLOT AS RLG_NUMLOT                               '; { FEITO DESSA FORMA PARA NÃO QUEBRAR AS CONSULTAS DOS CLIENTES }
      strSQL := strSQL + 'FROM (                                                '; { POIS MUDANDO O NOME, A COLUNA ATUAL IRIA SUMIR DAS CONSULTAS }
      strSQL := strSQL + 'SELECT                                                ';
      strSQL := strSQL + '  RLG_NUMLOT AS NUMLOT,                               ';
      strSQL := strSQL + '  RLG_DESLOT AS DESLOT,                               ';
