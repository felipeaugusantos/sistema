function fPesqCategoriaOrPd(Self       : TForm;                    {* Formulário                                  *}
                            edtCodigo  : TCustomEdit;              {* Edit do Código                              *}
                            edtDescri  : TEditFocus;               {* Edit da Descrição                           *}
                            qryTabela  : TUniQuery;                {* Query                                       *}
                            Var chrKey : Char;                     {* Key                                         *}
                            Var arrSel : TConsultasArray;          {* Array de Seleção                            *}
                            blnConSim  : Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                            strEspDoc  : String  = '';             {* Espécie "PD" ou "OR"                        *}
                            blnFiltraApenasLead: Boolean = False ): Boolean;
Var
  strSQL, strWhere : String;
  qryConsulta      : TUniQuery;
  objDefConsultaCategoriaOrcamentoPedido : TDefConsulta;
  objCategoriaCadLead: TCategoriaCadLead;
begin

  Result := False;

  If fEntraCons(chrKey) Then
  Begin

    Try

      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  CAT_CODIGO,       ';
      strSQL := strSQL + '  CAT_DESCRI,       ';
      strSQL := strSQL + '  CAT_CORCAT,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CATEGO            ';

      strWhere := 'WHERE TRUE ';

      If Not fEmptyStr(strEspDoc) Then
      Begin

        If (strEspDoc = 'PD') Then
          strWhere := strWhere + ' AND CAT_ESPPED = ''S'' '
        ELse If (strEspDoc = 'OR') Then
          strWhere := strWhere + ' AND CAT_ESPORC = ''S'' ';

      End;

      objCategoriaCadLead:=  TCategoriaCadLead.Create;
      Try
        objCategoriaCadLead.blnUtiCat:= False;

        If ((fCfgSis('UTICAO', varBoolean)) And (strEspDoc = 'OR')) Or
           ((fCfgSis('UTICAP', varBoolean)) And (strEspDoc = 'PD')) Then
        Begin
          objCategoriaCadLead.blnUtiCat:= True;
        End;

        objCategoriaCadLead.blnFiltraApenasLead:= blnFiltraApenasLead;
        strWhere := strWhere + objCategoriaCadLead.fRetornaSQLFiltroCategoriaLead;
      Finally
        FreeAndNil(objCategoriaCadLead);
      End;


      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      {Essa definição foi criada apenas para uso do "ColorEdit".}
      objDefConsultaCategoriaOrcamentoPedido := TDefConsulta.Create;

      If fConsulta([strSQL, strWhere],
                   ['Código','Nome','Cor','AUTOINCREM'],
                   ['CAT_CODIGO','CAT_DESCRI','CAT_CORCAT'],
                   '',
                   'CATEGO',
                   Self.Name,
                   'Consulta Categoria para Orçamento/Pedido',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'CAT_CODIGO',
                   objDefConsultaCategoriaOrcamentoPedido) Then
      Begin

        If Assigned(edtCodigo) then
          edtCodigo.Text := qryConsulta.FieldByName('CAT_CODIGO').AsString;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('CAT_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
              edtCodigo.Text := fStrZero('0', 6);

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

      End;

    Except

      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;

    End;

  End;

end;

