                                      strCodCid : String = '';                      {* Cidade do endereco de entrega               *}
                                      strCliCep : String = '';                      {* Cep do endereco de entrega                  *}
                                      blnFiltroPorData : Boolean = True;
                                      fltPesBru : Double = 0;
                                      strSeqFgo : String = ''): Boolean;
  Var
    strSQL      : String;
    strWhere    : String;
    qryConsulta : TUniQuery;
    arrTitCol   : TColunasArray;
