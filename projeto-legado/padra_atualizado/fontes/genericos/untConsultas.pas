function fPesqClasseLocFis(Self     : TForm;                      {* Formulário                                  *}
                           edtSigla: TCustomEdit;                 {* Edit da Sigla                               *}
                           qryTabela: TUniQuery;                  {* Query                                       *}
                           Var chrKey: Char;                      {* Key                                         *}
                           Var arrSel: TConsultasArray;           {* Array de Seleção                            *}
                           blnConSim: Boolean = True;             {* Consulta Simples                            *}
                           strCodIte: String  = '';               {* Código do Item                              *}
                           objFrmPnl: TPanelCx = nil ): Boolean;  {* Panel para legendas                         *}
  Var
    qryConsulta: TUniQuery;
    objConsulta : TDefConsultaClasseLocal;
    strSQL: String;
    strTitulo: String;
    arrTitCol,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND CLA_CODEMP = ' + QuotedStr(VS_strCodEmp);

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      objConsulta := TDefConsultaClasseLocal.Create;
      objConsulta.pAdicionaTabela('CLASSE', '');
      strTitulo := 'Consulta de Classe de Localização Física';
      try
        If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
        Begin
          objLoadSQL.fIncluiSubConsulta('CLAPROD', 'IF((SELECT COUNT(*) FROM CLAITE WHERE CIT_CODITE = '+QuotedStr(strCodIte)+ ' AND CIT_SIGLA_ = CLA_SIGLA_) > 0, "S", "N")','CLAPROD');
          objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
          objLoadSQL.pCarregaDadosConsulta;
          arrSQLConsulta    := objLoadSQL.arrSql;
          arrCamposConsulta := objLoadSQL.arrNomeColunas;
        End Else
        Begin
          SetLength(arrTitCol, 1);
          strSQL := '';
          strSQL := strSQL + ' SELECT CLA_SIGLA_,                                   ';
          strSQL := strSQL + '        AUTOINCREM,                                   ';
          strSQL := strSQL + '        IF((SELECT                                    ';
          strSQL := strSQL + '              COUNT(*)                                ';
          strSQL := strSQL + '            FROM                                      ';
          strSQL := strSQL + '              CLAITE                                  ';
          strSQL := strSQL + '            WHERE                                     ';
          strSQL := strSQL + '                  CIT_CODITE = '+QuotedStr(strCodIte)  ;
          strSQL := strSQL + '              AND CIT_SIGLA_ = CLA_SIGLA_) > 0        ';
          strSQL := strSQL + '           , "S"                                      ';
          strSQL := strSQL + '           , "N"                                      ';
          strSQL := strSQL + '          ) AS CLAPROD                                ';// campo utilizado para marcar as classes mapeadas para o produto
          strSQL := strSQL + ' FROM CLASSE                                          ';

          arrTitCol[00] := 'Sigla';
          arrSQLConsulta    := [strSQL, fSQLWhere(True)];
          arrCamposConsulta := arrTitCol;
        End;

        If Not Assigned(qryTabela) Then
          qryConsulta := fCriaQuery(Nil)
        Else
          qryConsulta := qryTabela;

        If fConsulta(arrSQLConsulta,
                     arrCamposConsulta,
                     ['CLA_SIGLA_'],
                     'AUTOINCREM',
                     'CLASSE',
                     Self.Name,
                     strTitulo,
                     qryConsulta,
                     objFrmPnl,
