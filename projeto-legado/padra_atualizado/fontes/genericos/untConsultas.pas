      Begin
        If Assigned(edtCodCes) then
        Begin
          If (edtCodCes Is TEditFocus) Then
            (edtCodCes As TEditFocus).Text := qryConsulta.FieldByName('CES_CODIGO').AsString
          Else
            edtCodCes.Text := qryConsulta.FieldByName('CES_CODIGO').AsString;
        End;

        If Assigned(edtDesCes) Then
          edtDesCes.Text := qryConsulta.FieldByName('CES_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodCes) then
          Begin
            If (edtCodCes Is TEditFocus) Then
              (edtCodCes As TEditFocus).Text := fStrZero('0', Length(qryConsulta.FieldByName('CES_CODIGO').AsString))
            Else
              edtCodCes.Text := fStrZero('0', Length(qryConsulta.FieldByName('CES_CODIGO').AsString));
          End;

          If Assigned(edtDesCes) Then
            edtDesCes.Text := '+1';

        End;

        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

