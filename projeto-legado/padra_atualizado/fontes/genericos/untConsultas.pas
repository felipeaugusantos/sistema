          Else
            edtCodigo.Text := qryConsulta.FieldByName('MCO_CODMCO').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('MCO_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
