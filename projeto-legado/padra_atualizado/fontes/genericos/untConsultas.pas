                                       strCodEmp : String;                           {* Código da empresa para busca                *}
                                       Var chrKey: Char;                             {* Key                                         *}
                                       Var arrSel: TConsultasArray;                  {* Array de Seleção                            *}
                                       blnConSim : Boolean = True                    {* Consulta Simples ou Múltipla (multi select) *}
                                       ): Boolean;
Var
  strSQL      : String;
  qryConsulta : TUniQuery;

  Function fSQLWhere(strCodEmp: String): String;
  Var
    strWhere: String;
  Begin
    strWhere := ' WHERE RLG_CODEMP = ' + QuotedStr(strCodEmp);

    Result := strWhere;
  End;

  Begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  RLG_NUMLOT, ';
      strSQL := strSQL + '  RLG_DESLOT, ';
      strSQL := strSQL + '  AUTOINCREM  ';
      strSQL := strSQL + 'FROM ROMLGE ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(strCodEmp)],
                  ['Número Lote',
                   'Descrição',
                   'AUTOINCREM'],
                   ['RLG_NUMLOT','RLG_DESLOT'],
                   '',
                   'ROMLGE',
                   Self.Name,
                   'Consulta de Romaneio Lote Separação',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'RLG_NUMLOT',
                    fSQLWhere(strCodEmp)) Then
      Begin
