                                  strCodCor : String = ''): Boolean;
  Var
    arrTitCol  : TColunasArray;                                                       {* Títulos das Colunas                         *}
    strSQL     : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsultaEst;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    //strWhere := strWhere + '  ITEGER.ITE_CODITE = CADITE.ITE_CODITE AND ';
    strWhere := strWhere + ' AND ITEGER.ITE_CODEMP = ' + QuotedStr(VS_strCodEmp);
    //strWhere := strWhere + '  GEIMAT.GMT_CODITE = CADITE.ITE_CODITE AND ';
    //strWhere := strWhere + '  CADITE.ITE_CODUNI = CADUNI.UNI_CODUNI AND ';
    //strWhere := strWhere + '  CADITE.ITE_CODMAR = CADMAR.MAR_CODMAR AND ';
    //strWhere := strWhere + '  GEIMAT.GMT_CODCOR = CADCOR.COR_CODCOR ';
    if (not fEmptyStr(strCodPag)) And (not fEmptyStr(strCodCor)) Then
    Begin
      strWhere := strWhere + ' AND GEIMAT.GMT_CODITE = ' + QuotedStr(strCodPag);
      strWhere := strWhere + ' AND GEIMAT.GMT_CODCOR = ' + QuotedStr(strCodCor);
    End;

    Result := strWhere;
  End;

Begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin

    chrKey := #0;

    Try
      objConsulta := TDefConsultaEst.Create;
      objConsulta.pIncluiSubConsulta('STATUS', 'IF(GEIMAT.GMT_STATUS = "A", "ATIVA", "INATIVA")');
      objConsulta.pIncluiSubConsulta('PESESP', '( SELECT FORMAT(SUM(DMT_QTDITE) / SUM(IF(ITE_DENSID>0, DMT_QTDITE / ITE_DENSID, 0)),4) AS DESIND FROM DEIMAT INNER JOIN CADITE ON ITE_CODITE = DMT_ITESUB WHERE DMT_SEQGER = GEIMAT.AUTOINCREM )');

      objConsulta.pIncluiSubConsulta('DTACAD', 'CONCAT( DATE_FORMAT(GMT_DTACAD,"%d/%m/%y")," " , TIME_FORMAT(GMT_HRACAD,"%h:%m:%s"))');
      objConsulta.pIncluiSubConsulta('DTAALT', 'CONCAT( DATE_FORMAT(GMT_DTAALT,"%d/%m/%y")," " , TIME_FORMAT(GMT_HRAALT,"%h:%m:%s"))');

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  CADGRU.GRU_CODGRU, '; pAddNomeColuna('Grupo');
      strSQL := strSQL + '  GEIMAT.GMT_CODITE, '; pAddNomeColuna('Codigo');
      strSQL := strSQL + '  CADITE.ITE_DESITE, '; pAddNomeColuna('Descrição');
      strSQL := strSQL + '  GEIMAT.GMT_REFERE, '; pAddNomeColuna('Referencia');
      strSQL := strSQL + '  CADITE.ITE_CODUNI, '; pAddNomeColuna('Cód. Unidade');
      strSQL := strSQL + '  CADUNI.UNI_DESUNI, '; pAddNomeColuna('Unidade');
      strSQL := strSQL + '  CADCOR.COR_CODCOR, '; pAddNomeColuna('Cod. Cor');
      strSQL := strSQL + '  CADCOR.COR_DESCOR, '; pAddNomeColuna('Cor');
      strSQL := strSQL + '  GEIMAT.GMT_FORMUL, '; pAddNomeColuna('Cod. Fórmula');
      strSQL := strSQL + '  STATUS,            '; pAddNomeColuna('Status');
      strSQL := strSQL + '  CADMAR.MAR_DESMAR, '; pAddNomeColuna('Marca');
      strSQL := strSQL + '  CADITE.ITE_CODFAB, '; pAddNomeColuna('Cód. Fábrica');
      strSQL := strSQL + '  CADITE.ITE_CODBAR, '; pAddNomeColuna('Cód. Barras');
      strSQL := strSQL + '  GEIMAT.GMT_PESREA, '; pAddNomeColuna('PE. Real');
      strSQL := strSQL + '  PESESP,            '; pAddNomeColuna('PE. Específico');
      strSQL := strSQL + '  DTACAD,            '; pAddNomeColuna('Data Cadastro');
      strSQL := strSQL + '  DTAALT,            '; pAddNomeColuna('Data Alteração');
      strSQL := strSQL + '  GEIMAT.GMT_DTAFOR, '; pAddNomeColuna('Data Desenv.');
      strSQL := strSQL + '  GEIMAT.GMT_CODOPE, '; pAddNomeColuna('Cód. Operador.');
      strSQL := strSQL + '  CADOPE.OPE_NOMOPE, '; pAddNomeColuna('Nome do Operador.');
      strSQL := strSQL + '  GEIMAT.GMT_OBS001, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS002, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS003, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS004, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS005, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS006, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS007, ';
      strSQL := strSQL + '  GEIMAT.GMT_OBS008, ';
      strSQL := strSQL + '  GEIMAT.AUTOINCREM  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADITE ';
      strSQL := strSQL + '  JOIN ITEGER ON ITEGER.ITE_CODITE = CADITE.ITE_CODITE ';
      strSQL := strSQL + '  JOIN GEIMAT ON GEIMAT.GMT_CODITE = CADITE.ITE_CODITE ';
      strSQL := strSQL + '  JOIN CADUNI ON CADITE.ITE_CODUNI = CADUNI.UNI_CODUNI ';
      strSQL := strSQL + '  JOIN CADMAR ON CADITE.ITE_CODMAR = CADMAR.MAR_CODMAR ';
      strSQL := strSQL + '  JOIN CADCOR ON GEIMAT.GMT_CODCOR = CADCOR.COR_CODCOR ';
      strSQL := strSQL + '  JOIN CADGRU ON GRU_CODGRU = CADITE.ITE_CODGRU ';
      strSQL := strSQL + '  LEFT JOIN CADOPE ON GMT_CODOPE = OPE_CODOPE ';

      If Not Assigned(qryConEst) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryConEst;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   arrTitCol,
                   ['ITE_DESITE','GRU_CODGRU','GMT_CODITE'],
                   'AUTOINCREM',
                   'GEIMAT',
                   Self.Name,
                   'Consulta de Estruturas - Industrial',
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False),
                   '',
                   True,
                   objConsulta,
                   False,
                   ((not fEmptyStr(strCodPag)) And (not fEmptyStr(strCodCor))),//se tiver preenchido traz a consulta aberta,
                   '',
                   Nil,
                   True,
                   True,
                   True,
                   Nil,
                   Nil,
                   Nil
                   {VS_Application}) Then
      Begin
        If Assigned(edtCodPro) then
        Begin
          If (edtCodPro Is TMaskEditFocus) Then
            (edtCodPro As TMaskEditFocus).Text := qryConsulta.FieldByName('GMT_CODITE').AsString
          Else
            edtCodPro.Text := qryConsulta.FieldByName('GMT_CODITE').AsString;
        End;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodPro) then
          Begin
            If (edtCodPro Is TMaskEditFocus) Then
              (edtCodPro As TMaskEditFocus).Text := fStrZero('0', 8)
            Else
              edtCodPro.Text := fStrZero('0', 8);
          End;

        End;

        Result := True;

      End;

      If Not Assigned(qryConEst) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);
    Except

      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;

    End;


  End;

End;

