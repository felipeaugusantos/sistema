      If fConsultaConfig([strSQL, fSQLWhere(True)],
                   ['AUTOINCREM', 'Núm. Lote', 'Empresa', 'Cód. Representante', 'Representante', 'Cód. Cliente', 'Cliente', 'Cidade', 'Data da visita'],
