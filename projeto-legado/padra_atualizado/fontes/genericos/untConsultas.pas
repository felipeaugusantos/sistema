                         strSQL := strSQL + '  AUTOINCREM        ';
                         strSQL := strSQL + 'FROM                ';
                         strSQL := strSQL + '  CADFPG            ';
                         {***************************************}
                         {* TÍTULO DA COLUNA E MÁSCARA DO CAMPO *}
                         {************************************RV*}
                         SetLength(arrTitCol, 2);
