      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_EMAIL_', 'E-mail 1');
      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_EMAIL2', 'E-mail 2');
      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_OBSERV', 'Obeservações');

      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_I_E_S_', 'Inscr. Estadual');
      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_C_G_C_', 'CNPJ/CPF');
      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_CGCCPF', 'Tipo de CNPJ/CPF');

      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_ULTCOM', 'Última Compra');
     *)

      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_CODCLI', 'Código');
      objLoadSQL.fIncluiCampoObrigatorio('C.CLI_NOMCLI', 'Nome');
      objLoadSQL.fIncluiCampoObrigatorio('C.AUTOINCREM');

      objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));

      objLoadSQL.pCarregaDadosConsulta;

      arrSQLConsulta := objLoadSQL.arrSql;
      arrCamposConsulta := objLoadSQL.arrNomeColunas;

      FreeAndNil(stlJoins);
    End;

begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      btnCancela := TBitBtnLocked(Self.FindComponent('btnCancela'));    // instanciando por TYPECAST o btnCancela
      if Assigned(btnCancela) then
        btnCancela.enabled := False;                                      // para desabilitar ele e seu HOTKEY

      strTitulo := 'Consulta de Clientes';

      objConsulta := TDefMascaraCliente.Create;

      objConsulta.stlCamposComplementares.Add('CLI_CGCCPF');
      objConsulta.stlCamposComplementares.Add('CLI_STATUS');
      objConsulta.stlCamposComplementares.Add('CLI_QTDPRO');

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin

        pTrataConsultaConfigurada;

      End Else
      Begin

        pConsultaAntiga;

      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,
                   arrCamposConsulta,
                   ['CLI_NOMCLI', 'CLI_FANSOB', 'CLI_CODCLI', 'CLI_C_G_C_'],
                   '',
                   'CADCLI',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'CLI_CODCLI',
                   objConsulta,
                   blnTablet,
                   False,
                   '',
                   Nil,
                   True,
                   True,
                   True,
                   fCadCli,
                   Nil,
                   Nil
                   {VS_Application}) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('CLI_CODCLI').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('CLI_CODCLI').AsString;
        End;

        If Assigned(edtNomCli) Then
          edtNomCli.Text := qryConsulta.FieldByName('CLI_NOMCLI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
            Else
              edtCodigo.Text := fStrZero('0', 8);
          End;

          If Assigned(edtNomCli) Then
            edtNomCli.Text := '+1';

        End;

        if (Assigned(edtCodigo)) and (fEmptyStr(edtCodigo.Text)) then
          Result := False
        else
          Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

      End;

      FreeAndNil(objConsulta);

      FreeAndNil(objLoadSQL);

      if Assigned(btnCancela) then
        btnCancela.Enabled := True;  // Retorna o Objeto btnCancela ao estado normal podendo receber o ALT + C
                                     // para não conflitar com o CONFIRMA da tela de consulta.

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fCadProspecto(blnCheck :Boolean = False):Boolean;
Begin
  Result := False;
  If fVerificaAcessoSistema('frmCadProspectos') And Assigned(objCadastros) Then
  Begin
    If blnCheck Then
      Result := True
    Else
      objCadastros.pChamaCadastroProspecto;
  End;
End;

function fPesqProspecto(Self     : TForm;                         {* Formulário                                  *}
                        edtCodigo: TCustomEdit;                   {* Edit do Código                              *}
                        edtNomCli: TCustomEdit;                   {* Edit do Nome do Cliente                     *}
                        qryTabela: TUniQuery;                     {* Query                                       *}
                        Var chrKey: Char;                         {* Key                                         *}
                        Var arrSel: TConsultasArray;              {* Array de Seleção                            *}
                        blnConSim: Boolean = True;                {* Consulta Simples                            *}
                        blnCRM : Boolean = False;                 {* Carrega Apenas não Ativados no CadCli e status Ativo*}
                        blnRetCodPro : Boolean = False): Boolean; {* Retorna codpro utilizado na consulta de relatórios *}
  Var
    qryConsulta: TUniQuery;
    objConsulta: TDefMascaraCliente;
    strSQL: String;
    arrTitCol: TColunasArray;                                     {* Títulos das Colunas                         *}
    strTitulo: String;
    strCRMPVI: String;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If blnCRM Then
    Begin
      strWhere := strWhere + IIF(Not fEmptyStr(strWhere), ' AND ', '');
      strWhere := strWhere + ' PRO_CODCLI IS NULL AND PRO_STATUS = "A" ';
    End;

    strCRMPVI := fCfgSis('CRMPVI', varString);
    If ((Pos(strCRMPVI, 'V_L_') > 0) And (blnCRM)) Then
    Begin
      strWhere := strWhere + IIF(Not fEmptyStr(strWhere), ' AND ', ' WHERE ');
