function fPesqProjetos(Self     : TForm;                      {* Formulário                                  *}
                         edtCodigo: TCustomEdit;              {* Edit do Código                              *}
                         edtDescri: TEditFocus;               {* Edit da Descrição                           *}
                         qryTabela: TUniQuery;                {* Query                                       *}
                         Var chrKey: Char;                    {* Key                                         *}
                         Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                         blnConSim: Boolean = True;           {* Consulta Simples ou Múltipla (multi select) *}
                         strCodCli: String = ''): Boolean;    {* Código do Cliente                           *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    strTitulo: String;
    objConsulta: TDefConsulta;
    arrCampos,
    arrSQLConsulta,
    arrCamposConsulta: TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Procedure pTrataConsultaConfigurada;
  Begin
    If (Not fEmptyStr(strCodCli)) Then
    Begin
      objLoadSql.stlJoins.Add(' INNER JOIN CLIPRJ C ON C.CLI_CODPRJ = P.PRJ_CODPRJ '+
                              '   AND C.CLI_CODCLI = ' + QuotedStr(strCodCli));
    End;
    objLoadSQL.pCarregaDadosConsulta;
    arrSQLConsulta    := objLoadSQL.arrSql;
    arrCamposConsulta := objLoadSQL.arrNomeColunas;
  End;
  Procedure pConsultaAntiga;
  Begin
    objConsulta.pIncluiSubConsulta('CLIENTES_PROJETO','(SELECT                                                    '+
                                                      '  GROUP_CONCAT(CONCAT(CLIPRJ.CLI_CODCLI,"-",CLI_NOMCLI))  '+
                                                      'FROM                                                      '+
                                                      '  CLIPRJ                                                  '+
                                                      '  JOIN CADCLI                                             '+
                                                      '    ON CADCLI.CLI_CODCLI = CLIPRJ.CLI_CODCLI              '+
                                                      'WHERE CLI_CODPRJ = P.PRJ_CODPRJ GROUP BY CLI_CODPRJ)       ' );

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE        ';
    strSQL := strSQL + '  P.PRJ_CODPRJ,            ';
    strSQL := strSQL + '  P.PRJ_DESPRJ,            ';
    strSQL := strSQL + '  P.PRJ_VALPRJ,            ';
    strSQL := strSQL + '  P.PRJ_DTAINI,            ';
    strSQL := strSQL + '  P.PRJ_DTAPRE,            ';
    strSQL := strSQL + '  CASE P.PRJ_SITUAC        ';
    strSQL := strSQL + '   WHEN "I" THEN "Inativo" ';
    strSQL := strSQL + '   WHEN "A" THEN "Ativo"   ';
    strSQL := strSQL + '  END AS PRJ_SITUAC,       ';
    strSQL := strSQL + '  P.PRJ_DTAFIN,            ';
    strSQL := strSQL + '  P.PRJ_CODTIP,            ';
    strSQL := strSQL + '  P.PRJ_CODOCO,            ';
    strSQL := strSQL + '  D.OCO_DESOCO,            ';
    strSQL := strSQL + '  CLIENTES_PROJETO,        ';
    strSQL := strSQL + '  P.AUTOINCREM             ';
    strSQL := strSQL + 'FROM                       ';
    strSQL := strSQL + '  CADPRJ P                 ';
    strSQL := strSQL + '  LEFT JOIN CADOCO D ON D.OCO_CODOCO = P.PRJ_CODOCO ';

    If Not fEmptyStr(strCodCli) Then
    Begin
      strSQL := strSQL + ' INNER JOIN CLIPRJ C ON C.CLI_CODPRJ = P.PRJ_CODPRJ ';
      strSQL := strSQL + '   AND C.CLI_CODCLI = ' + QuotedStr(strCodCli);
    End;

    SetLength(arrCampos, 12);
    arrCampos[0] := 'Código';
    arrCampos[1] := 'Descrição';
    arrCampos[2] := 'Valor Projeto';
    arrCampos[3] := 'Data Início';
    arrCampos[4] := 'Data Prevista';
    arrCampos[5] := 'Situação';
    arrCampos[6] := 'Data Finalizado';
    arrCampos[7] := 'Cod. Tipo';
    arrCampos[8] := 'Cod. Ocorr.';
    arrCampos[9] := 'Desc. Ocorrência';
    arrCampos[10] := 'Clientes';
    arrCampos[11] := 'AUTOINCREM';
    arrSQLConsulta    := [strSQL];
    arrCamposConsulta := arrCampos;

  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strTitulo := 'Consulta de Projetos';
      objConsulta := TDefConsulta.Create;
      objConsulta.pAdicionaTabela('CADPRJ', 'P');

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        pTrataConsultaConfigurada;
      End Else
      Begin
        pConsultaAntiga;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta,arrCamposConsulta,
                   ['PRJ_DESPRJ','PRJ_CODPRJ'],
                   '',
                   'CADPRJ',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'PRJ_CODPRJ',
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('PRJ_CODPRJ').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('PRJ_CODPRJ').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('PRJ_DESPRJ').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', Length(qryConsulta.FieldByName('PRJ_CODPRJ').AsString))
            Else
              edtCodigo.Text := fStrZero('0', Length(qryConsulta.FieldByName('PRJ_CODPRJ').AsString));
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objLoadSQL);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

