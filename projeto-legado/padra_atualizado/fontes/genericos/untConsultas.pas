{********************************************************************}
{* FUNÇÃO CRIDA PARA CHAMADA DA NOVA CONSULTA DE ORDENS DE PRODUÇÃO *}
{*****************************************************************JU*}
function fPesqOrdemProd(opcTipCom: TTipoConsultaSimples;
                        Self     : TForm;                       {* Formulário                                  *}
                        edtCodigo: TCustomEdit;                 {* Edit do Código                              *}
                        edtDescri: TEditFocus;                  {* Edit da Descrição do item                   *}
                        qryTabela: TUniQuery;                   {* Query                                       *}
                        Var chrKey: Char;                       {* Key                                         *}
                        Var arrSel: TConsultasArray;            {* Array de Seleção                            *}
                        strWhere : String = '';
                        blnConSim: Boolean = True;              {* Consulta Simples ou Múltipla (multi select) *}
                        strTitulo: String = 'Consulta Ordens de Produção';
                        intOpcStatus : integer = 3): Boolean;
  var
    strSQL : String;
    qryConsulta: TUniQuery;
    arrTitCol: TColunasArray;                                 {* Títulos das Colunas                         *}

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strSQLWhere: String;
  Begin
    If blnCompleto Then
      strSQLWhere := ' WHERE TRUE '
    Else
      strSQLWhere := '';

    strWhere := AnsiReplaceStr(strWhere,'WHERE','');

    If (Not fEmptyStr(strWhere)) Then
      strSQLWhere := strSQLWhere + ' AND ' + strWhere;

    strSQLWhere := strSQLWhere + ' AND PRO_CODEMP = ' + QuotedStr(vs_StrCodEmp) + ' ';

    Case intOpcStatus Of
      1 : strSQLWhere := strSQLWhere + ' AND PRO_DTABAI IS NULL ';
      2 : strSQLWhere := strSQLWhere + ' AND PRO_DTABAI IS NOT NULL ';
    End;

    Result := strSQLWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try

      SetLength(arrTitCol, 0);

      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  PRO_CODPRO, '; pAddNomeColuna('Ord Pro');
      strSQL := strSQL + '  PRO_DTACAD, '; pAddNomeColuna('Data de Cadastro');
      if fCfgSis('SEQORD', varBoolean) then
      begin
        strSQL := strSQL + '  PRO_SEQUEN, ';
        pAddNomeColuna('Seq.');
      end;
      strSQL := strSQL + '  PRO_CODITE, '; pAddNomeColuna('Cód.Produto');
      strSQL := strSQL + '  ITE_DESITE, '; pAddNomeColuna('Produto');
      strSQL := strSQL + '  PRO_QTDAPR, '; pAddNomeColuna('Quantidade');
      strSQL := strSQL + '  PRO_DTAPRO, '; pAddNomeColuna('Data da Produção');
      strSQL := strSQL + '  PRO_DTABAI, '; pAddNomeColuna('Data da Baixa');
      strSQL := strSQL + '  PRO_HORBAI, '; pAddNomeColuna('Hora da Baixa');
      strSQL := strSQL + '  PRO_QTDPRO, '; pAddNomeColuna('Qtd. Produzido');
      strSQL := strSQL + '  FGO_NUMDOC, '; pAddNomeColuna('Num. Pedido');
      strSQL := strSQL + '  FGO_ESPDOC, '; pAddNomeColuna('Esp.');
      strSQL := strSQL + '  FGO_CODEMP, '; pAddNomeColuna('Emp.');
      strSQL := strSQL + '  CLI_CODCLI, '; pAddNomeColuna('Cod. Cliente');
      strSQL := strSQL + '  CLI_NOMCLI, '; pAddNomeColuna('Nome Cliente');
      strSQL := strSQL + '  PRO_OBS001, '; pAddNomeColuna('Observação 1');
      strSQL := strSQL + '  PRO_OBS002, '; pAddNomeColuna('Observação 2');
      strSQL := strSQL + '  MOVPRO.AUTOINCREM ';
      strSQL := strSQL + 'FROM      ';
      strSQL := strSQL + '  MOVPRO                 ';
      strSQL := strSQL + '  JOIN CADITE ON ITE_CODITE = PRO_CODITE ';
      strSQL := strSQL + '  LEFT JOIN FATGOR ON FATGOR.FGO_NUMDOC = IFNULL(PRO_NUMPED, PRO_NUMDOC) ';
      strSQL := strSQL + '                  AND FATGOR.FGO_ESPDOC = IFNULL(PRO_ESPPED, PRO_ESPDOC) ';
      strSQL := strSQL + '                  AND FATGOR.FGO_CODEMP = IFNULL(PRO_EMPPED, PRO_CODEMP) ';
      strSQL := strSQL + '  LEFT JOIN CADCLI ON CLI_CODCLI = FGO_CODCLI ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL,fSQLWhere(True)],
                   arrTitCol,
                   ['PRO_CODPRO','ITE_DESITE','PRO_CODITE'],
                   'AUTOINCREM',
                   'MOVPRO',
                   Self.Name,
                   strTitulo,
                   qryConsulta,
                   nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False)) Then
      Begin
          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('PRO_CODPRO').AsString
            Else
              edtCodigo.Text := qryConsulta.FieldByName('PRO_CODPRO').AsString;
          End;

          If (Length(arrSel) > 1) Then
          Begin

            If Assigned(edtCodigo) then
            Begin
              If (edtCodigo Is TMaskEditFocus) Then
                (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 8)
              Else
                edtCodigo.Text := fStrZero('0', 8);
            End;
          End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

function fPesqPromocoes(Self      : TForm;                            {* Formulário                                  *}
                        edtCodPro : TEditFocus;                       {* Edit do Código                              *}
                        edtDesPro : TEditFocus;                       {* Edit da Descricao                           *}
                        qryTabela : TUniQuery;                        {* Query                                       *}
                        Var chrKey: Char;                             {* Key                                         *}
                        Var arrSel: TConsultasArray;                  {* Array de Seleção                            *}
                        blnConSim : Boolean = True): Boolean;         {* Consulta Simples ou Múltipla (multi select) *}
var
  strSQL     : String;
  qryConsulta: TUniQuery;
  objConsulta: TDefConsulta;
  arrCamposUtilizados: TColunasArray;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  EMPRESA, ';
      strSQL := strSQL + '  PRO_CODPRO , ';
      strSQL := strSQL + '  PRO_DESPRO , ';
      strSQL := strSQL + '  PRO_DTAINI , ';
      strSQL := strSQL + '  PRO_DTAFIN , ';
      strSQL := strSQL + '  PROVIG, ';
      strSQL := strSQL + '  ENTFUT , ';
      strSQL := strSQL + '  TIPO_DESCONTO_PROMOCAO, ';
      strSQL := strSQL + '  RESNCO , ';
      if fCfgSis('PROECO', varBoolean) then
        strSQL := strSQL + '  ECOMME, ';
      if fCfgSis('TABLOI', varBoolean) then
        strSQL := strSQL + '  TABLOI, ';

      strSQL := strSQL + '  ENTIME, ';

      if fCfgSis('PROSUG', varBoolean) then
        strSQL := strSQL + '  TRAZER_PRECO_SUGESTAO_FATURAMENTO, ';
      strSQL := strSQL + '  AUTOINCREM ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADPRO ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('EMPRESA', '(SELECT GROUP_CONCAT(PE.PRO_CODEMP) FROM PROEMP PE WHERE PE.PRO_SEQGER = CADPRO.AUTOINCREM)');

      objConsulta.pIncluiSubConsulta('PROVIG',  'CASE ' +
                                               'WHEN PRO_DTAFIN >= CURDATE() THEN "SIM" ' +
                                                'WHEN PRO_DTAFIN <  CURDATE() THEN "NÃO" END ');

      objConsulta.pIncluiSubConsulta('ENTFUT', 'IF(PRO_ENTFUT = "S", "SIM", "NÃO")');
      objConsulta.pIncluiSubConsulta('TIPO_DESCONTO_PROMOCAO', 'CASE PRO_IDXPRO ' +
                                                               '  WHEN 0 THEN "PREÇO" ' +
                                                               '  WHEN 1 THEN "% DESCONTO" ' +
                                                               '  WHEN 2 THEN "PREÇO COM DESCONTO ADICIONAL SOBRE PREÇO DE COMPRA" ' +
                                                               '  WHEN 3 THEN "PREÇO POR QUANTIDADE COLETIVA" ' +
                                                               '  WHEN 4 THEN "% DESCONTO COM DESC. ADICIONAL SOBRE PREÇO DE COMPRA" ' +
                                                               '  WHEN 5 THEN "% DESCONTO POR QUANTIDADE COLETIVA" ' +
                                                               '  WHEN 6 THEN "ESTOQUE REMANESCENTE DOS PRODUTOS COM ATUALIZAÇÃO DE PREÇOS" ' +
                                                               '  WHEN 7 THEN "NEGOCIAÇÃO ESPECIAL COM FORNECEDOR ATRAVÉS DE PED. DE COMP." ' +
                                                               '  WHEN 8 THEN "PROMOÇÃO COMPOSTA POR KIT" ' +
                                                               'END ');
      objConsulta.pIncluiSubConsulta('RESNCO', 'IF(PRO_RESNCO = "S", "SIM", "NÃO")');
      objConsulta.pIncluiCampoSimNao('ENTFUT');
      objConsulta.pIncluiCampoSimNao('RESNCO');
      objConsulta.pIncluiCampoSimNao('PROVIG');
      if fCfgSis('PROECO', varBoolean) then
      begin
        objConsulta.pIncluiSubConsulta('ECOMME', 'IF(PRO_ECOMME = "S", "SIM", "NÃO")');
        objConsulta.pIncluiCampoSimNao('ECOMME');
      end;

      objConsulta.pIncluiSubConsulta('ENTIME', 'IF(PRO_ENTIME = "S", "SIM", "NÃO")');
      objConsulta.pIncluiCampoSimNao('ENTIME');

      if fCfgSis('TABLOI', varBoolean) then
      begin
        objConsulta.pIncluiSubConsulta('TABLOI', 'IF(PRO_TABLOI = "S", "SIM", "NÃO")');
        objConsulta.pIncluiCampoSimNao('TABLOI');
      end;
      if fCfgSis('PROSUG', varBoolean) then
      begin
        objConsulta.pIncluiSubConsulta('TRAZER_PRECO_SUGESTAO_FATURAMENTO', 'CASE PRO_PROPRE ' +
                                        TRegraPrecoSugestao.getTrazerValoresSubconsulta +
                                                 ' END ');
      end;

      SetLength(arrCamposUtilizados, 9);
      arrCamposUtilizados := ['Empresa',
                              'Código',
                              'Descrição',
                              'Data Início',
                              'Data Fim',
                              'Promoção Vigente?',
                              'Permite Entrega Futura?',
                              'Promoção por',
                              'Restrita a clientes não consumidor?'];

      if fCfgSis('PROECO', varBoolean) then
      begin
        SetLength(arrCamposUtilizados, Length(arrCamposUtilizados) + 1);
        arrCamposUtilizados[Length(arrCamposUtilizados) - 1] := 'Promoção para e-commerce';
      end;
      if fCfgSis('TABLOI', varBoolean) then
      begin
        SetLength(arrCamposUtilizados, Length(arrCamposUtilizados) + 1);
        arrCamposUtilizados[Length(arrCamposUtilizados) - 1] := 'Promoção em Tabloid?';
      end;

      SetLength(arrCamposUtilizados, Length(arrCamposUtilizados) + 1);
      arrCamposUtilizados[Length(arrCamposUtilizados) - 1] := 'Permite entrega imediata?';

      if fCfgSis('PROSUG', varBoolean) then
      begin
        SetLength(arrCamposUtilizados, Length(arrCamposUtilizados) + 1);
        arrCamposUtilizados[Length(arrCamposUtilizados) - 1] := 'Trazer preço de sugestão no faturamento';
      end;

      SetLength(arrCamposUtilizados, Length(arrCamposUtilizados) + 1);
      arrCamposUtilizados[Length(arrCamposUtilizados) - 1] := 'AUTOINCREM';

      If fConsultaConfig([strSQL],
                   arrCamposUtilizados,
                   ['PRO_DESPRO','PRO_CODPRO','PRO_DTAINI'],
                   '',
                   'CADPRO',
                   Self.Name,
                   'Consulta de Promoções',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'PRO_CODPRO',
                   '',
                   '',
                   False,
                   objConsulta) Then
      Begin
        If Assigned(edtCodPro) then
        Begin
          If (edtCodPro Is TEditFocus) Then
            (edtCodPro As TEditFocus).Text := qryConsulta.FieldByName('PRO_CODPRO').AsString
          Else
            edtCodPro.Text := qryConsulta.FieldByName('PRO_CODPRO').AsString;
        End;

        If Assigned(edtDesPro) Then
          edtDesPro.Text := qryConsulta.FieldByName('PRO_DESPRO').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodPro) then
          Begin
            If (edtCodPro Is TEditFocus) Then
              (edtCodPro As TEditFocus).Text := fStrZero('0', Length(qryConsulta.FieldByName('PRO_CODPRO').AsString))
            Else
              edtCodPro.Text := fStrZero('0', Length(qryConsulta.FieldByName('PRO_CODPRO').AsString));
          End;

          If Assigned(edtDesPro) Then
            edtDesPro.Text := '+1';

        End;

        Result := True;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

end;

