  {**************************************************************}
  {* CONSULTA DE ASSOCIACAO DE CONDIÇÕES DE PAGAMENTO ESPECIAIS *}
  {***********************************************************KM*}
var
  strSQL     : String;
  qryConsulta: TUniQuery;
  objConsulta: TDefConsulta;
  arrCamposUtilizados: TColunasArray;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  CES_CODIGO , ';
      strSQL := strSQL + '  CES_DESCRI , ';
      strSQL := strSQL + '  CES_DTAINI , ';
      strSQL := strSQL + '  CES_DTAFIM , ';
      strSQL := strSQL + '  EMPRESA, ';
      strSQL := strSQL + '  AUTOINCREM ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADCES ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('EMPRESA', '(SELECT GROUP_CONCAT(CE.CES_CODEMP) FROM CESEMP CE WHERE CE.CES_SEQGER = CADCES.AUTOINCREM)');

      SetLength(arrCamposUtilizados, 5);
      arrCamposUtilizados := ['Código',
                              'Descrição',
                              'Data Inicial',
                              'Data Final',
                              'Empresa'];

      SetLength(arrCamposUtilizados, Length(arrCamposUtilizados) + 1);
      arrCamposUtilizados[Length(arrCamposUtilizados) - 1] := 'AUTOINCREM';

      If fConsultaConfig([strSQL],
                   arrCamposUtilizados,
                   ['CES_DESCRI','CES_CODIGO','CES_DTAINI'],
