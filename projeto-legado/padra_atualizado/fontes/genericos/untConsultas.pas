function fPesqEstado(Self     : TForm;                    {* Formulário                                  *}
                     edtUf    : TCustomEdit;              {* Edit do Código                              *}
                     edtDescri: TEditFocus;               {* Edit do Estado                              *}
                     qryTabela: TUniQuery;                {* Query                                       *}
                     Var chrKey: Char;                    {* Key                                         *}
                     Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                     blnConSim: Boolean = True): Boolean; {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
    I: Integer;
    objConsulta: TDefConsulta;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT * FROM ( ';
      for I := 0 to Pred(Length(ESTADOS)) do
      begin
        if I <> 0 then
          strSQL := strSQL + 'UNION ALL ';
        strSQL := strSQL + 'SELECT "' + ESTADOS[I] + '" AS UF, "' + DES_ESTADOS[I] + '" AS DESCRICAO '
      end;
      strSQL := strSQL + ') AS TMP';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;
      try
        objConsulta.strSQLRetorno := strSQL;

        If fConsultaConfig([strSQL],
                    ['UF',
                     'Descrição'],
                     ['UF','DESCRICAO'],
                     '',
                     'TMP',
                     Self.Name,
                     'Consulta de Estados',
                     qryConsulta,
                     Nil,
                     blnConSim,
                     arrSel,
                     'UF',
                     '',
                     '',
                     False,
                     objConsulta) Then
        Begin
          If Assigned(edtUf) then
            edtUf.Text := qryConsulta.FieldByName('UF').AsString;

          If Assigned(edtDescri) Then
            edtDescri.Text := qryConsulta.FieldByName('DESCRICAO').AsString;

          If (Length(arrSel) > 1) Then
          Begin

            If Assigned(edtUf) then
              edtUf.Text := fStrZero('0', 2);

            If Assigned(edtDescri) Then
              edtDescri.Text := '+1';

          End;

          Result := True;
        End;
      finally
        FreeAndNil(objConsulta);
      end;
      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

