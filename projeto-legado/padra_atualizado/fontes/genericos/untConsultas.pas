End;


Procedure pPesqPedOrcSqlOrdPro(Var strSQL, strWhere, strGroup: String; Var arrTitCol: TColunasArray; strEspDoc: String; blnManutOrdProd: Boolean = False);
Begin
  If Not blnManutOrdProd Then
  Begin
    strSQL := '';
    strSQL := strSQL + '   SELECT         ';
    strSQL := strSQL + '     FDO_DTAENT,  ';
    strSQL := strSQL + '     FDO_NUMDOC,  ';
    strSQL := strSQL + '     FDO_CODEMP,  ';
    strSQL := strSQL + '     FDO_CODCLI,  ';
    strSQL := strSQL + '     CLI_NOMCLI,  ';
    strSQL := strSQL + '     CLI_FANSOB,  ';
    strSQL := strSQL + '     F.AUTOINCREM ';
    strSQL := strSQL + '   FROM FATDOR F,                  ';
    strSQL := strSQL + '  	  MOVPRO,                      ';
    strSQL := strSQL + '      CADCLI                       ';

    strWhere := strWhere + IIF(fEmptyStr(Trim(strWhere)), 'WHERE TRUE ', '');

    strWhere := strWhere + '      AND FDO_NUMDOC = PRO_NUMDOC     ';
    strWhere := strWhere + '      AND CLI_CODCLI = FDO_CODCLI ';
    strWhere := strWhere + '      AND FDO_JAFATU = 0          ';
    strWhere := strWhere + '      AND FDO_ESPDOC = "PD"       ';
    strWhere := strWhere + '      AND FDO_ORDPRO = PRO_CODPRO ';

    strGroup := '';
    strGroup := strGroup + '   GROUP BY                        ';
    strGroup := strGroup + '     FDO_NUMDOC                    ';

    {***************************************}
    {* TÍTULO DA COLUNA E MÁSCARA DO CAMPO *}
    {************************************RV*}
    SetLength(arrTitCol, 07);
    arrTitCol[00] := 'Dt. Emissão';
    arrTitCol[01] := 'Nº Pedido';
    arrTitCol[02] := 'Emp.';
    arrTitCol[03] := 'Cód. Cliente';
    arrTitCol[04] := 'Nome Cliente';
    arrTitCol[05] := 'Nome Fantasia';
    arrTitCol[06] := 'AUTOINCREM';
  End
  Else
  Begin
    If strEspDoc = 'NF' Then
    Begin
      strSQL := '';
      strSQL := strSQL + '     SELECT                                  ';
      strSQL := strSQL + 'REPLACE(PRO_PROJEC, "Projeto: ", "") AS PRO_PROJEC, ';
      strSQL := strSQL + '       PRO_DTACAD,                           ';
      strSQL := strSQL + '       PRO_NUMPED,                           ';
      strSQL := strSQL + '       PRO_ESPPED,                           ';
      strSQL := strSQL + '       PRO_EMPPED,                           ';
      strSQL := strSQL + '       FDO_CODCLI,                           ';
      strSQL := strSQL + '       CLI_NOMCLI,                           ';
      strSQL := strSQL + '       CLI_FANSOB,                           ';
      strSQL := strSQL + '       MOVPRO.AUTOINCREM                     ';
      strSQL := strSQL + '     FROM                                    ';
      strSQL := strSQL + '       FATGOR                                ';
      strSQL := strSQL + '       INNER JOIN MOVPRO                     ';
      strSQL := strSQL + '         ON PRO_NUMPED = FGO_NUMDOC          ';
      strSQL := strSQL + '         AND PRO_ESPPED = FGO_ESPDOC         ';
      strSQL := strSQL + '         AND PRO_EMPPED = FGO_CODEMP         ';
      strSQL := strSQL + '       INNER JOIN DETPRO D                   ';
      strSQL := strSQL + '         ON DOP_SEQGER = MOVPRO.AUTOINCREM   ';
      strSQL := strSQL + '       INNER JOIN CADITE C                   ';
      strSQL := strSQL + '         ON C.ITE_CODITE = DOP_ITESUB        ';
      strSQL := strSQL + '       INNER JOIN ITEGER G                   ';
      strSQL := strSQL + '         ON G.ITE_CODITE = DOP_ITESUB        ';
      strSQL := strSQL + '         AND G.ITE_CODEMP = PRO_EMPPED       ';
      strSQL := strSQL + '       LEFT JOIN CADUNI                      ';
      strSQL := strSQL + '         ON CADUNI.UNI_CODUNI = ITE_CODUNI   ';
      strSQL := strSQL + '       INNER JOIN CADCLI                     ';
      strSQL := strSQL + '         ON CLI_CODCLI = FGO_CODCLI          ';
      strWhere := strWhere + IIF(fEmptyStr(Trim(strWhere)), 'WHERE TRUE ', '');
      strWhere := strWhere + '       AND FGO_TIPFAT = "NF"             ';
      strWhere := strWhere + '       AND FGO_EMPFAT = ' + QuotedStr(VS_strCodEmp) + ' ';
      strWhere := strWhere + '       AND PRO_PRINCI = "S"              ';
      strWhere := strWhere + '       AND FGO_JAFATU = 0                ';

      strGroup := '';
      strGroup := strGroup + '   GROUP BY                              ';
      strGroup := strGroup + '     PRO_NUMPED                          ';
    End
    Else
    Begin
      strSQL := '';
      strSQL := strSQL + '      SELECT                                 ';
      strSQL := strSQL + 'REPLACE(PRO_PROJEC, "Projeto: ", "") AS PRO_PROJEC, ';
      strSQL := strSQL + '       PRO_DTACAD,                           ';
      strSQL := strSQL + '       PRO_NUMPED,                           ';
      strSQL := strSQL + '       PRO_EMPPED,                           ';
      strSQL := strSQL + '       PRO_ESPPED,                           ';
      strSQL := strSQL + '       PRO_CODCLI,                           ';
      strSQL := strSQL + '       CLI_NOMCLI,                           ';
      strSQL := strSQL + '       CLI_FANSOB,                           ';
      strSQL := strSQL + '       MOVPRO.AUTOINCREM                     ';
      strSQL := strSQL + '     FROM                                    ';
      strSQL := strSQL + '       DETPRO D                              ';
      strSQL := strSQL + '       INNER JOIN MOVPRO                     ';
      strSQL := strSQL + '         ON MOVPRO.AUTOINCREM = DOP_SEQGER   ';
      strSQL := strSQL + '       INNER JOIN CADITE C                   ';
      strSQL := strSQL + '         ON C.ITE_CODITE = DOP_ITESUB        ';
      strSQL := strSQL + '       INNER JOIN ITEGER G                   ';
      strSQL := strSQL + '         ON G.ITE_CODITE = DOP_ITESUB        ';
      strSQL := strSQL + '         AND G.ITE_CODEMP = PRO_EMPPED       ';
      strSQL := strSQL + '       LEFT JOIN CADUNI                      ';
      strSQL := strSQL + '         ON CADUNI.UNI_CODUNI = ITE_CODUNI   ';
      strSQL := strSQL + '       INNER JOIN CADCLI                     ';
      strSQL := strSQL + '         ON CLI_CODCLI = PRO_CODCLI          ';

      strWhere := strWhere + IIF(fEmptyStr(Trim(strWhere)), 'WHERE TRUE ', '');
      strWhere := strWhere + '       AND PRO_ESPPED = "PD"                 ';
      strWhere := strWhere + '       AND PRO_EMPPED = ' + QuotedStr(VS_strCodEmp) + ' ';
      strWhere := strWhere + '       AND PRO_PRINCI = "S"                  ';

      strGroup := '';
      strGroup := strGroup + '   GROUP BY                              ';
      strGroup := strGroup + '     PRO_NUMPED                          ';
    end;

    SetLength(arrTitCol, 08);
    arrTitCol[00] := 'Arquivo';
    arrTitCol[01] := 'Data';
    arrTitCol[02] := 'Pedido';
    arrTitCol[03] := 'Empresa';
    arrTitCol[04] := 'Espécie';
  	arrTitCol[05] := 'Cód. Cliente';
  	arrTitCol[06] := 'Nome Cliente';
    arrTitCol[07] := 'Nome Fantasia';

  End;
End;

Procedure pPesqPedOrcSqlDigDocumento(Var strSQL, strWhere: String;
                                     Var arrTitCol: TColunasArray;
                                         strEspDoc: String);
Begin
  strSQL := '';
  strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
  strSQL := strSQL + '  FGO_NUMDOC,       ';
  strSQL := strSQL + '  FGO_ESPDOC,       ';
  strSQL := strSQL + '  FGO_CODEMP,       ';
  strSQL := strSQL + '  FGO_CODCLI,       ';
  strSQL := strSQL + '  CLI_NOMCLI,       ';
  strSQL := strSQL + '  CLI_FANSOB,       ';
  strSQL := strSQL + '  CLI_EMAIL_,       ';
  strSQL := strSQL + '  FGO_CODVEN,       ';
  strSQL := strSQL + '  FGO_DTAENT,       ';
  strSQL := strSQL + '  FGO_CONPAG,       ';
  strSQL := strSQL + '  FGO_VLRCON,       ';
  strSQL := strSQL + '  FGO_CODTRA,       ';
  strSQL := strSQL + '  TRA_NOMTRA,       ';
  strSQL := strSQL + '  FATGOR.AUTOINCREM ';
  strSQL := strSQL + 'FROM      ';
  strSQL := strSQL + '  FATGOR ';
  strSQL := strSQL + '  JOIN CADCLI ON FGO_CODCLI = CLI_CODCLI ';
  strSQL := strSQL + '  LEFT JOIN CADTRA ON TRA_CODTRA = FGO_CODTRA ';

  strWhere := strWhere + IIF(fEmptyStr(Trim(strWhere)), 'WHERE TRUE ', '');

  //strWhere := strWhere + '  AND FGO_CODCLI = CLI_CODCLI AND ';
  strWhere := strWhere + '  AND FGO_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' ';
  strWhere := strWhere + '  AND FGO_ESPDOC = ' + QuotedStr(strEspDoc) + ' ';
  strWhere := strWhere + '  AND FGO_CODCLI IN (' + VS_strCliFil + ')';
  strWhere := strWhere + '  AND FGO_JAFATU = FALSE ';

  If (fCfgSis('ULTORC', varInteger) > 0) Then
    strWhere := strWhere + '  AND ' + TAG_ULTORC_INI + 'FGO_DTAENT >= SUBDATE(' + fCurrentDate + ', INTERVAL ' + IntToStr(fCfgSis('ULTORC', varInteger)) + ' DAY)' + TAG_ULTORC_FIN + ' ';

  {***************************************}
