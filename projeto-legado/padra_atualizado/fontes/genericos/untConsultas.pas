                               edtDescri: TCustomEdit;                   {* Edit do Nome do Cliente                     *}
                               qryTabela: TUniQuery;                     {* Query                                       *}
                               Var chrKey: Char;                         {* Key                                         *}
                               Var arrSel: TConsultasArray;              {* Array de Seleção                            *}
                               blnConSim: Boolean = True): Boolean;
var
  strSQL     : String;
  qryConsulta: TUniQuery;
begin
  Result := False;

  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL +  'SELECT SQL_NO_CACHE ' +
                          '       ACL_CODIGO, ' +
                          '       ACL_DESCRI, ' +
                          '       ACL_DTAAQU, ' +
                          '       ACL_VALAQU, ' +
                          '       ACL_GARANT, ' +
                          '       ACL_DTULMN, ' +
                          '       ACL_RPULMN, ' +
                          '       ACL_MODELO, ' +
                          '       ACL_ANOFAB, ' +
                          '       ACL_LOCFIS, ' +
                          '       ACL_CODITE, ' +
                          '       ACL_DTAVEN, ' +
                          '       (CASE WHEN ACL_STATUS = "A" THEN "A - Ativo"     ' +
                          '             WHEN ACL_STATUS = "I" THEN "I - Inativo"   ' +
                          '             WHEN ACL_STATUS = "B" THEN "B - Bloqueado" ' +
                          '        END) AS ACL_STATUS, ' +
                          '       AUTOINCREM  ' +
                          '  FROM CADACL      ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL],
                  ['Código',
                   'Descrição',
                   'Data Aquisição',
                   'Valor Aquisição',
                   'Garantia(meses)',
                   'Dt.Ult.Manuten.',
                   'Resp.Ult.Manuten.',
                   'Modelo',
                   'Ano Fab.',
                   'Local. Física',
                   'Cód.Item',
                   'Dt. Venda',
                   'Situação'],
                   ['ACL_CODIGO', 'ACL_DESCRI', 'ACL_DTAAQU', 'ACL_VALAQU',
                    'ACL_GARANT', 'ACL_DTULMN', 'ACL_RPULMN',
                    'ACL_MODELO', 'ACL_ANOFAB', 'ACL_LOCFIS',
                    'ACL_CODITE', 'ACL_DTAVEN', 'STATUS'],
                   '',
                   'CADACL',
                   Self.Name,
                   'Consulta de Acessórios para Locação',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('ACL_CODIGO').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('ACL_CODIGO').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('ACL_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin
          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';
        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

