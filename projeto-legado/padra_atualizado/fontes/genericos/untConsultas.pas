    qryConsulta: TUniQuery;
    arrOrd     : Array of String;
    strTitulo  : String;
    blnUsaDesc : Boolean;
    objConsulta: TDefConsultaServico;
    arrSQLConsulta, arrCamposConsulta  :  TColunasArray;
    objLoadSql: TLoadConsultaSQL;
  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If fCfgSis('SEREMP', varBoolean) And (Not blnCadSer) Then
      strWhere := strWhere + ' AND ((SER_CODEMP = ' + QuotedStr(VS_strCodEmp) + ') OR (SER_CODEMP IS NULL) OR (SER_CODEMP = "")) ';

    {Somente Ativos}
    If Not blnCadSer Then
    Begin
      strWhere := strWhere + ' AND (SER_ATIVO_ = "S") ';
    End;

    Result := strWhere;
  End;
begin
  Result := False;

  blnUsaDesc := Not (fCfgSis('QTDSER', VarBoolean) Or fCfgSis('ALVLSE', VarBoolean));

  If fEntraCons(chrKey) Then
  Begin
    objConsulta := TDefConsultaServico.Create;
    Try
      chrKey := #0;
      {Req: 111535 - Foi retirado o "CAST(SER_APLICA AS CHAR(255))" para utilizar o campo SER_APLICA diretamente,
       devido a falhas na consulta por "Aplicação".}
      //objConsulta.pIncluiSubConsulta('SERAPLICA', 'CAST(SER_APLICA AS CHAR(255))');
      strTitulo := 'Consulta de Serviços';
      objConsulta.pAdicionaTabela('CADSER', 'S');
      objConsulta.pAdicionaTabela('GRUSER', 'G');

      If TLoadConsultaSQL.fUsaConsultaConfigurada(strTitulo, objLoadSQL, objConsulta, False) Then
      Begin
        If Assigned(objFrmPnl) And Assigned(objFrmPnl.sltLista) And Assigned(objFrmPnl.fncTeclaTab) Then Begin
          objLoadSQL.fIncluiSubConsulta('VENDIDO', 'CAST(IF(LOCATE(SER_CODSER, :LISTA) > 0, 1, NULL) AS UNSIGNED)', 'TAB');
          objConsulta.pIncluiIcone('VENDIDO', 0, 0);
          objConsulta.pIncluiIcone('VENDIDO', 1, 1);
          If Assigned(objFrmPnl) Then
            TDefConsultaDefeito(objConsulta).sltDefeitos := objFrmPnl.sltLista;
        End;
        If Not fCfgSis('TRSECI', varBoolean) then
        Begin
          objLoadSQL.fIncluiSubConsulta('SER_TRIMUN', 'S.SER_TRIMUN', 'Cód. Trib. Mun.');
          objLoadSQL.fIncluiSubConsulta('SER_CDLSSE', 'S.SER_CDLSSE', 'Código Lista LC 116/03');
        End;
        If blnUsaDesc Then
        Begin
          objLoadSQL.fIncluiSubConsulta('SER_DESMAX','CONCAT(S.SER_DESMAX, " %")','Desconto Máximo');
        End;
        If blnAutCen Then
        begin
          objLoadSQL.fIncluiSubConsulta('SER_TERCER', 'S.SER_TERCER', 'Serv. Terceirizado');
          objLoadSQL.fIncluiSubConsulta('SER_VALCUS', 'S.SER_VALCUS', 'Custo $');
          objLoadSQL.fIncluiSubConsulta('FOR_NOMFOR', 'F.FOR_NOMFOR', 'Fornecedor');
          objLoadSQL.fIncluiSubConsulta('CTA_DESCTA', 'C.CTA_DESCTA', 'Plano de Contas');
          objLoadSQL.fIncluiSubConsulta('CND_DESCRI', 'N.CND_DESCRI', 'Cond. Pagto');
          objLoadSql.stlJoins.Add(' LEFT JOIN CADFOR F ON S.SER_CODFOR = F.FOR_CODFOR ');
          objLoadSql.stlJoins.Add(' LEFT JOIN CADCTA C ON S.SER_CODCTA = C.CTA_CODCTA ');
          objLoadSql.stlJoins.Add(' LEFT JOIN CADCND N ON S.SER_CODCND = N.CND_CODIGO ');
        end;
        If blnCadSer Then
        Begin
          objLoadSQL.fIncluiSubConsulta('SERATIVO_', 'IF(IFNULL(S.SER_ATIVO_, "N") = "S", "Sim", "Não")','Ativo?');
        End;
        objLoadSQL.pSetaWhereAdicional(fSQLWhere(False));
        objLoadSQL.pCarregaDadosConsulta;
        arrSQLConsulta    := objLoadSQL.arrSql;
        arrCamposConsulta := objLoadSQL.arrNomeColunas;
      End Else
      Begin
        strSQL := '';
        strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
        If Assigned(objFrmPnl) And Assigned(objFrmPnl.sltLista) And Assigned(objFrmPnl.fncTeclaTab) Then
        Begin
          strSQL := strSQL + ' VENDIDO, ';    pAddNomeColuna('TAB');

          objConsulta.pIncluiSubConsulta('VENDIDO', 'CAST(IF(LOCATE(SER_CODSER, :LISTA) > 0, 1, NULL) AS UNSIGNED)');
          objConsulta.pIncluiIcone('VENDIDO', 0, 0);
          objConsulta.pIncluiIcone('VENDIDO', 1, 1);

          If Assigned(objFrmPnl) Then
            TDefConsultaDefeito(objConsulta).sltDefeitos := objFrmPnl.sltLista;
        End;
        strSQL := strSQL + '  S.SER_CODEMP,  '; pAddNomeColuna('Cód. Empresa');
        strSQL := strSQL + '  S.SER_CODSER,  '; pAddNomeColuna('Código');
        strSQL := strSQL + '  S.SER_DESSER,  '; pAddNomeColuna('Descrição');
        strSQL := strSQL + '  G.GRU_DESGRU , '; pAddNomeColuna('Grupo de Serviço');
        if not fCfgSis('TRSECI', varBoolean) then
        Begin
          strSQL := strSQL + '  S.SER_TRIMUN,  '; pAddNomeColuna('Cód. Trib. Mun.');
          strSQL := strSQL + '  S.SER_CDLSSE,  '; pAddNomeColuna('Código Lista LC 116/03');
        End;
        strSQL := strSQL + '  S.SER_VALSER,  '; pAddNomeColuna('Valor Serviço');
        If blnUsaDesc Then
        Begin
          strSQL := strSQL + '  CONCAT(S.SER_DESMAX, " %") AS SER_DESMAX, ';
          pAddNomeColuna('Desconto Máximo');
        End;
        If blnAutCen Then
        begin
          strSQL := strSQL + '  S.SER_TERCER,  '; pAddNomeColuna('Serv. Terceirizado');
          strSQL := strSQL + '  S.SER_VALCUS,  '; pAddNomeColuna('Custo $');
          strSQL := strSQL + '  F.FOR_NOMFOR,  '; pAddNomeColuna('Fornecedor');
          strSQL := strSQL + '  C.CTA_DESCTA,  '; pAddNomeColuna('Plano de Contas');
          strSQL := strSQL + '  N.CND_DESCRI,  '; pAddNomeColuna('Cond. Pagto');
          SetLength(arrOrd, 5);
          arrOrd[0] := 'SER_DESSER';
          arrOrd[1] := 'FOR_NOMFOR';
          arrOrd[2] := 'CTA_DESCTA';
          arrOrd[3] := 'CND_DESCRI';
          arrOrd[4] := 'SER_CODSER';
        end
        else
        begin
          SetLength(arrOrd, 2);
          arrOrd[0] := 'SER_DESSER';
          arrOrd[1] := 'SER_CODSER';
        end;
        strSQL := strSQL + '  S.SER_APLICA, '; pAddNomeColuna('Aplicação');
        If blnCadSer Then
        Begin
          strSQL := strSQL + '  SERATIVO_, '; pAddNomeColuna('Ativo?');
          objConsulta.pIncluiSubConsulta('SERATIVO_', 'IF(IFNULL(S.SER_ATIVO_, "N") = "S", "Sim", "Não")');
        End;
        strSQL := strSQL + '  S.SER_ALQISS, '; pAddNomeColuna('Aliq. ISS');
        strSQL := strSQL + '  S.SER_REDISS, '; pAddNomeColuna('Red. ISS');
        strSQL := strSQL + '  S.AUTOINCREM ';
        strSQL := strSQL + 'FROM ';
        If Not blnAutCen Then
          strSQL := strSQL + '  CADSER S'
        Else
        Begin
          strSQL := strSQL + '  CADSER S LEFT JOIN CADFOR F ON S.SER_CODFOR = F.FOR_CODFOR ';
          strSQL := strSQL + '           LEFT JOIN CADCTA C ON S.SER_CODCTA = C.CTA_CODCTA ';
          strSQL := strSQL + '           LEFT JOIN CADCND N ON S.SER_CODCND = N.CND_CODIGO ';
        End;
        strSQL := strSQL + ' LEFT JOIN GRUSER G ON S.SER_CODGRU = G.GRU_CODGRU ';
        arrSQLConsulta    := [strSQL, fSQLWhere(True)];
        arrCamposConsulta := arrTitCol;
      End;

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsulta(arrSQLConsulta, arrCamposConsulta,
                   arrOrd,
                   '',
                   'CADSER',
                   Self.Name,
                   'Consulta de Serviços',
                   qryConsulta,
                   objFrmPnl,
                   blnConSim,
                   arrSel,
                   'SER_CODSER',
                   objConsulta,
                   False,
                   False,
                   '',
                   Nil,
                   True,
                   True,
                   True,
                   Nil,
                   Nil,
                   Nil
                   {VS_Application}) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('SER_CODSER').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('SER_CODSER').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('SER_DESSER').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 5)
            Else
              edtCodigo.Text := fStrZero('0', 5);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

      End;
      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
    FreeAndNil(objLoadSQL);
    FreeAndNil(objConsulta);
  End;
end;

{**********************************}
{* NOVA CONSULTA DE FAIXA DE PESO *}
{*******************************RV*}
function fPesqFaixaPeso(Self     : TForm;                         {* Formulário                                  *}
                         edtCodigo: TCustomEdit;                  {* Edit do Código                              *}
                         edtDescri: TEditFocus;                   {* Edit da Descrição                           *}
                         qryTabela: TUniQuery;                    {* Query                                       *}
                         Var chrKey: Char;                        {* Key                                         *}
                         Var arrSel: TConsultasArray;             {* Array de Seleção                            *}
                         blnConSim: Boolean = True): Boolean;     {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL,
    strGroup   : String;
    qryConsulta: TUniQuery;
    Function fSQLWhere(blnCompleto: Boolean): String;
      Var
        strWhere: String;
    Begin
      If blnCompleto Then
        strWhere := ' WHERE TRUE '
      Else
        strWhere := '';

      Result := strWhere;
    End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  COM_CODTAB,       ';
      strSQL := strSQL + '  COM_DESCRI,       ';
      strSQL := strSQL + '  COM_VALINI,       ';
      strSQL := strSQL + '  COM_VALFIN,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  COMPES            ';
      strGroup := '';
      strGroup := strGroup + ' GROUP BY COM_CODTAB ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True), strGroup],
                  ['Código',
                   'Descrição',
                   'Valor Inicial',
                   'Valor Final',
                   'AUTOINCREM'],
                   ['COM_DESCRI','COM_CODTAB'],
                   '',
                   'COMPES',
                   Self.Name,
                   'Consulta de Faixa de Peso',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'COM_CODTAB',
                   fSQLWhere(False)) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('COM_CODTAB').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('COM_CODTAB').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('COM_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 6)
            Else
              edtCodigo.Text := fStrZero('0', 6);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

{*****************************}
{* CONSULTA DE FUNCIONÁRIOS  *}
{**************************RV*}
function fPesqFuncionarios(Self     : TForm;                      {* Formulário                                  *}
                           edtCodigo: TCustomEdit;                {* Edit do Código                              *}
                           edtDescri: TEditFocus;                 {* Edit do Nome do Funcionário                 *}
                           qryTabela: TUniQuery;                  {* Query                                       *}
                           Var chrKey: Char;                      {* Key                                         *}
                           Var arrSel: TConsultasArray;           {* Array de Seleção                            *}
                           blnConSim: Boolean = True;             {* Consulta Simples ou Múltipla (multi select) *}
                           arrEmpresa: TConsultasArray = nil;     {* Array da(s) empresa(s) selecionada(s)       *}
                           autIncrem: string = '';
                           blnRetCodFun: Boolean = False
                           ): Boolean;
  Var
    strSQL,strGroupBy,
    strEmpresa : String;
    qryConsulta: TUniQuery;
    objConsulta: TDefConsulta;

    LSQLDiasGozo,
    LSQLSaldoGozo,
    LDiasComprado: String;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
      intIndice: Integer;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE  '
    Else
      strWhere := '';

    If Assigned(arrEmpresa) then
    Begin
      strWhere := strWhere + ' AND FUN_CODEMP IN (';
      For intIndice := Low(arrEmpresa) To High(arrEmpresa) Do
      Begin
        If strEmpresa <> '' then
          strEmpresa := strEmpresa + ',';
        strEmpresa := strEmpresa + arrEmpresa[intIndice].strCodigo;
      End;
      strWhere := strWhere +strEmpresa+') ';
    End;

    Result := strWhere +' ';
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      LSQLDiasGozo :=  'CONCAT(                                                          '+
                       '     (                                                           '+
                       '       (                                                         '+
                       '         DATEDIFF(                                               '+
                       '           (SELECT                                               '+
                       '             MIN(TMP.FER_GOZINI)                                 '+
                       '           FROM                                                  '+
                       '             FUNFER TMP                                          '+
                       '           WHERE EXTRACT(YEAR FROM TMP.FER_AQUINI) = EXTRACT(    '+
                       '               YEAR FROM                                         '+
                       '               (SELECT                                           '+
                       '                 MAX(FER_AQUINI)                                 '+
                       '               FROM                                              '+
                       '                 FUNFER                                          '+
                       '               WHERE FER_AUTFUN = CADFUN.AUTOINCREM)             '+
                       '             )                                                   '+
                       '             AND TMP.FER_AUTFUN = CADFUN.AUTOINCREM),            '+
                       '           (SELECT                                               '+
                       '             MAX(TMP.FER_GOZFIN)                                 '+
                       '           FROM                                                  '+
                       '            FUNFER TMP                                           '+
                       '           WHERE EXTRACT(YEAR FROM TMP.FER_AQUINI) = EXTRACT(    '+
                       '               YEAR FROM                                         '+
                       '               (SELECT                                           '+
                       '                 MAX(FER_AQUINI)                                 '+
                       '               FROM                                              '+
                       '                 FUNFER                                          '+
                       '               WHERE FER_AUTFUN = CADFUN.AUTOINCREM)             '+
                       '             )                                                   '+
                       '             AND TMP.FER_AUTFUN = CADFUN.AUTOINCREM)             '+
                       '         )                                                       '+
                       '       ) * (- 1) + 1                                             '+
                       '     ),                                                          '+
                       '     ""                                                          '+
                       '   )                                                             ';


      LSQLSaldoGozo :=' CONCAT(                                                          '+
                      '    30 - (                                                        '+
                      '      (                                                           '+
                      '        IFNULL(                                                   '+
                      '          DATEDIFF(                                               '+
                      '            (SELECT                                               '+
                      '              MIN(TMP.FER_GOZINI)                                 '+
                      '            FROM                                                  '+
                      '              FUNFER TMP                                          '+
                      '            WHERE EXTRACT(YEAR FROM TMP.FER_AQUINI) = EXTRACT(    '+
                      '                YEAR FROM                                         '+
                      '                (SELECT                                           '+
                      '                  MAX(FER_AQUINI)                                 '+
                      '                FROM                                              '+
                      '                  FUNFER                                          '+
                      '                WHERE FER_AUTFUN  = CADFUN.AUTOINCREM)            '+
                      '              )                                                   '+
                      '              AND TMP.FER_AUTFUN = CADFUN.AUTOINCREM),            '+
                      '            (SELECT                                               '+
                      '              MAX(TMP.FER_GOZFIN)                                 '+
                      '            FROM                                                  '+
                      '              FUNFER TMP                                          '+
                      '            WHERE EXTRACT(YEAR FROM TMP.FER_AQUINI) = EXTRACT(    '+
                      '                YEAR FROM                                         '+
                      '                (SELECT                                           '+
                      '                  MAX(FER_AQUINI)                                 '+
                      '                FROM                                              '+
                      '                  FUNFER                                          '+
                      '                WHERE FER_AUTFUN = CADFUN.AUTOINCREM)             '+
                      '              )                                                   '+
                      '              AND TMP.FER_AUTFUN = CADFUN.AUTOINCREM)             '+
                      '          )                                                       '+
                      '        ,1) * (- 1) + 1                                             '+
                      '      ) +                                                         '+
                      '      (SELECT                                                     '+
                      '        SUM(TMP.FER_DIACOM)                                       '+
                      '      FROM                                                        '+
                      '        FUNFER TMP                                                '+
                      '      WHERE EXTRACT(YEAR FROM TMP.FER_AQUINI) = EXTRACT(          '+
                      '          YEAR FROM                                               '+
                      '          (SELECT                                                 '+
                      '            MAX(FER_AQUINI)                                       '+
                      '          FROM                                                    '+
                      '            FUNFER                                                '+
                      '          WHERE FER_AUTFUN = CADFUN.AUTOINCREM)                   '+
                      '        )                                                         '+
                      '        AND TMP.FER_AUTFUN = CADFUN.AUTOINCREM)                   '+
                      '    ),                                                            '+
                      '    ""                                                            '+
                      '  )                                                               ';



      LDiasComprado := 'CONCAT(                                                 '+
                       '   (SELECT                                              '+
                       '     SUM(TMP.FER_DIACOM)                                '+
                       '   FROM                                                 '+
                       '     FUNFER TMP                                         '+
                       '   WHERE EXTRACT(YEAR FROM TMP.FER_AQUINI) = EXTRACT(   '+
                       '       YEAR FROM                                        '+
                       '       (SELECT                                          '+
                       '         MAX(FER_AQUINI)                                '+
                       '       FROM                                             '+
                       '         FUNFER                                         '+
                       '       WHERE FER_AUTFUN = CADFUN.AUTOINCREM)           '+
                       '      )                                                 '+
                       '     AND TMP.FER_AUTFUN = CADFUN.AUTOINCREM),           '+
                       '   ""                                                   '+
                       ' )                                                      ';

      strSQL := strSQL + 'SELECT SQL_NO_CACHE *';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '(SELECT             ';
      strSQL := strSQL + '  FUN_CODEMP,       ';
      strSQL := strSQL + '  FUN_CODFUN,       ';
      strSQL := strSQL + '  FUN_NOMFUN,       ';
      strSQL := strSQL + '  FNC_NOMFNC,       ';
      strSQL := strSQL + '  FUN_DTAADM,       ';
      strSQL := strSQL + '  FUN_SALBAS,       ';
      strSQL := strSQL + '  FUN_PISPAS,       ';
      strSQL := strSQL + '  FUN_DTADEM,       ';
      strSQL := strSQL + '  FUN_BANCO_,       ';
      strSQL := strSQL + '  FUN_AGENCI,       ';
      strSQL := strSQL + '  FUN_CONTA_,       ';
      strSQL := strSQL + '  PONTO,           ';
      strSQL := strSQL + '  REGISTRO,           ';
      strSQL := strSQL + '  DEMITIDO,         ';
      strSQL := strSQL + '  FUN_EMAIL_,       ';
      strSQL := strSQL + '  FUN_DTANAS,       ';
      strSQL := strSQL + '  COUNT(DISTINCT EXTRACT(YEAR FROM FER_AQUINI)) AS PERIODOS, ';
      strSQL := strSQL + LSQLDiasGozo + ' AS DIAGOZ, ';
      strSQL := strSQL + LSQLSaldoGozo + ' AS SALGOZ, ';
      strSQL := strSQL + '(SELECT MAX(FER_AQUFIN)   ';
      strSQL := strSQL + 'FROM    ';
      strSQL := strSQL + '  FUNFER  ';
      strSQL := strSQL + 'WHERE FER_CODFUN = CADFUN.FUN_CODFUN  ) AS FER_AQUFIN,   ';
      strSQL := strSQL + LDiasComprado + '  AS DIAS_COMPRADO,  ';
      strSQL := strSQL + '  CADFUN.AUTOINCREM, ';
      strSQL := strSQL + '  FUN_REGIST,       ';
      strSQL := strSQL + '  FUN_CARPON        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADFUN            ';
      strSQL := strSQL + 'LEFT JOIN CADFNC ON CADFNC.AUTOINCREM = FUN_AUTFNC ';
      strSQL := strSQL + 'LEFT JOIN FUNFER ON CADFUN.AUTOINCREM = FER_AUTFUN ';

      strGroupBy :='';
      strGroupBy :=' GROUP BY CADFUN.AUTOINCREM) FERIAS ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      objConsulta := TDefConsulta.Create;
      objConsulta.pIncluiSubConsulta('PONTO',   'IF (FUN_CARPON = "S","SIM","NÃO")');
      objConsulta.pIncluiSubConsulta('REGISTRO',   'IF (FUN_REGIST = "S","SIM","NÃO")');
      objConsulta.pIncluiSubConsulta('DEMITIDO', 'IF (FUN_DTADEM IS NOT NULL,"SIM","NÃO")');
      objConsulta.pIncluiCampoSimNao('PONTO');
      objConsulta.pIncluiCampoSimNao('REGISTRO');
      objConsulta.pIncluiCampoSimNao('DEMITIDO');

      If fConsultaConfig([strSQL, strGroupBy, fSQLWhere(True)],
                  ['Empresa',
                   'Código',
                   'Nome',
                   'Função',
                   'Dt. Admissão',
                   'Sal. Base',
                   'Pis Pasep',
                   'Dt. Demissão',
                   'Banco',
                   'Agência',
                   'Conta',
                   'Ponto OK?',
                   'Registro OK?',
                   'Demitido?',
                   'Email',
                   'Data de Nascimento',
                   'Períodos Férias',
                   'Férias Dias de Gozo',
                   'Férias Dias Restantes',
                   'Férias Data Limite',
                   'Dias Férias Comprados',
                   'AUTOINCREM'],
                   ['FUN_NOMFUN','FNC_NOMFNC','FUN_CODFUN'],
                   '',
                   'CADFUN',
                   Self.Name,
                   'Consulta de Funcionários',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   IfThen(blnRetCodFun,'FUN_CODFUN','AUTOINCREM'),
                   fSQLWhere(True),
                   '',
                   True,
                   objConsulta) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('FUN_CODFUN').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('FUN_CODFUN').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('FUN_NOMFUN').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 6)
            Else
              edtCodigo.Text := fStrZero('0', 6);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End
        else If length(arrSel) = 1 then
          autIncrem := arrSel[0].strCodigo;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);

        FreeAndNil(objConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

