                                             blnConSim : Boolean = True): Boolean;  {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';

      strSQL := strSQL + ' SELECT CVG_CODIGO, CVG_DESCRI, ';
      strSQL := strSQL + '        IF(CVG_TIPOVG = "T","TROCA","GARANTIA") AS "CVG_TIPOVG", ';

      strSQL := strSQL + '        CASE CVG_TIPORE ';
      strSQL := strSQL + '        WHEN "L" THEN "Linha Única" ';
      strSQL := strSQL + '        WHEN "M" THEN "Múltiplas Linhas" ';
      strSQL := strSQL + '        WHEN "N" THEN "N/A" ';
      strSQL := strSQL + '        Else "" ';
      strSQL := strSQL + '        end as "CVG_TIPORE", ';

      strSQL := strSQL + '        CVG_CODEMP, AUTOINCREM ';
      strSQL := strSQL + ' FROM CADCVG ';


      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL],
                         ['Código', 'Descrição','Grupo Checklist','Tipo Resultado', 'Empresa'],
                         ['CVG_DESCRI','CVG_CODIGO'],
                         '',
                         'CADCVG',
                         Self.Name,
                         'Consulta Checklist Avaliação Garantia',
                         qryConsulta,
                         Nil,
                         blnConSim,
                         arrSel,
                         'CVG_CODIGO') Then
      Begin
        strCodigo := qryConsulta.FieldByName('CVG_CODIGO').AsString;
        strDescri := qryConsulta.FieldByName('CVG_DESCRI').AsString;

        If (Length(arrSel) > 1) Then
        Begin
          strCodigo := fStrZero('0', 3);
        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

end;


