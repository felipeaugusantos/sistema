function fPesqProdutoNota(Self: TForm;
                          strNumDoc,
                          strSerie_,
                          strEspDoc,
                          strCliFor,
                          strCodemp: String;
                          edtCodIte   : TCustomEdit;
                          blnEntrada  : Boolean;
                          qryTabela   : TUniQuery;
                          Var arrSel: TConsultasArray;              {* Array de Seleção                            *}
                          Var chrKey  : Char        ) : Boolean;
  var
    arrTitCol  : TColunasArray; {* Títulos das Colunas  *}
    strSQL, strWhere: String;
    qryConsulta: TUniQuery;

  Procedure pAddNomeColuna(strNomCol: String);
  Begin
    SetLength(arrTitCol, Succ(Length(arrTitCol)));
    arrTitCol[High(arrTitCol)] := strNomCol;
  End;

Begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      SetLength(arrTitCol, 0);

      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + 'DET_DTAENT,       ';  pAddNomeColuna('Dta. Entrada');
      strSQL := strSQL + 'DET_NUMDOC,       ';  pAddNomeColuna('Num. Documento');
      strSQL := strSQL + 'DET_ESPDOC,       ';  pAddNomeColuna('Especie');
      strSQL := strSQL + 'DET_SERIE_,       ';  pAddNomeColuna('Série');
      If blnEntrada Then
      Begin
        strSQL := strSQL + 'DET_CODFOR,       ';  pAddNomeColuna('Cód. Fornecedor');
        strSQL := strSQL + 'FOR_NOMFOR,       ';  pAddNomeColuna('Fornecedor');
      End
      Else
      Begin
        strSQL := strSQL + 'DET_CODCLI,       ';  pAddNomeColuna('Cód. Cliente');
        strSQL := strSQL + 'CLI_NOMCLI,       ';  pAddNomeColuna('Cliente');
      End;

      strSQL := strSQL + 'DET_CODITE,       ';  pAddNomeColuna('Código Item');
      strSQL := strSQL + 'DET_DESCRI,       ';  pAddNomeColuna('Desc. Item');
      strSQL := strSQL + 'DET_QTDITE,       ';  pAddNomeColuna('Quantidade');
      strSQL := strSQL + 'MOVDET.AUTOINCREM        ';

      strSQL := strSQL + 'FROM MOVDET ';
      If blnEntrada Then
        strSQL := strSQL + ' INNER JOIN CADFOR ON FOR_CODFOR = DET_CODFOR '
      Else
        strSQL := strSQL + ' INNER JOIN CADCLI ON CLI_CODCLI = DET_CODCLI ';

      strWhere := '';

      strWhere := strWhere + ' WHERE DET_NUMDOC = "' + strNumDoc + '"';
      strWhere := strWhere + '   AND DET_ESPDOC = "' + strEspDoc + '"';
      strWhere := strWhere + '   AND IFNULL(DET_SERIE_, "") = "' + strSerie_ + '"';
      strWhere := strWhere + '   AND DET_CODEMP = "' + strCodemp + '"';

      If blnEntrada Then
      Begin
        strWhere := strWhere + '   AND DET_CODFOR = "' + strCliFor + '"';
        strWhere := strWhere + '   AND IFNULL(DET_ORIDOC, "") = ""';
        strWhere := strWhere + '   AND DET_CLAFIS < "5000"';
      End
      Else
      Begin
        strWhere := strWhere + '   AND DET_CODCLI = "' + strCliFor + '"';
        strWhere := strWhere + '   AND IFNULL(DET_ORIDOC, "") = "V"';
