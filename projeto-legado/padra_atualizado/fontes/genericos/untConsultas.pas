      strSQL := strSQL + '                     FGO_ESPDOC = RLD_ESPDOC AND      ';
      strSQL := strSQL + '                     FGO_CODEMP = RLD_CODEMP          ';

      if blnApenasPedidosEmAberto then
        strSQL := strSQL + 'WHERE FGO_JAFATU = "0" '
      else
      begin
        strSQL := strSQL + 'UNION ALL                                             ';
        strSQL := strSQL + 'SELECT                                                ';
        strSQL := strSQL + '  RLG_NUMLOT AS NUMLOT,                               ';
        strSQL := strSQL + '  RLG_DESLOT AS DESLOT,                               ';
        strSQL := strSQL + '  GER_DTAENT AS DTAENT,                               ';
        strSQL := strSQL + '  GER_NUMDOC AS NUMDOC,                               ';
        strSQL := strSQL + '  GER_ESPDOC AS ESPDOC,                               ';
        strSQL := strSQL + '  GER_CODEMP AS CODEMP,                               ';
        strSQL := strSQL + '  GER_CODCLI AS CODCLI,                               ';
        strSQL := strSQL + '  GER_CIDCON AS CIDCON,                               ';
        strSQL := strSQL + '  " "        AS SEPIMP,                               ';
