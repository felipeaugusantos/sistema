function fPesqAgendamentoEntregaWMS(Self      : TForm;                         {* Formulário                                  *}
                                    edtCodigo : TCustomEdit;                   {* Edit do Codigo                              *}
                                    qryTabela : TUniQuery;                     {* Query                                       *}
                                    Var chrKey: Char;                          {* Key                                         *}
                                    Var arrSel: TConsultasArray;               {* Array de Seleção                            *}
                                    blnConSim : Boolean = True;                {* Consulta Simples ou Múltipla (multi select) *}
                                    strStatus : String = '';
                                    strPlaca  : String = '';
                                    blnIgnorarEnderecados: Boolean = False):Boolean;
  Var
    strSQL,
    strSQLEnder,
    strGroup   : String;
    objConsulta: TDefConsulta;
    qryConsulta: TUniQuery;

  Function fGetSQLStatusEnderecamento: String;
  Const
    SQL_CAMPOS_END = ' (SUM(AIT_QTDEND) + SUM(AIT_QTDDEV) + SUM(AIT_DIVEND)) ';
  Begin
    Result := '(SELECT CASE    ' +
                       '   WHEN (IF(IFNULL(GI.ARC_MOVEFE,"N")="S", SUM(AIT_QTDTOT), SUM(DIG_QTDITE)) = ' + SQL_CAMPOS_END + ')                                THEN "ENDEREÇADO" '+
                       '   WHEN (IF(IFNULL(GI.ARC_MOVEFE,"N")="S", SUM(AIT_QTDTOT), SUM(DIG_QTDITE)) = 0 AND ' + SQL_CAMPOS_END + ' > 0)                      THEN "ENDEREÇADO"  '+
                       '   WHEN (IF(IFNULL(GI.ARC_MOVEFE,"N")="S", SUM(AIT_QTDTOT), SUM(DIG_QTDITE)) > ' + SQL_CAMPOS_END + ' AND ' + SQL_CAMPOS_END + ' > 0) THEN "ENDEREÇADO PARCIALMENTE" '+
                       '   ELSE "AGUARDANDO ENDEREÇAMENTO" '+
                       'END STATUS_ENDERECAMENTO '+
                       ' FROM AGEREC GI '+
                       ' INNER JOIN AGEDOC D ON GI.AUTOINCREM = ADC_SEQGER '+
                       ' INNER JOIN MOVDET T ON T.DET_NUMDOC = ADC_NUMDOC '+
                       '                    AND T.DET_ESPDOC = ADC_ESPDOC '+
                       '                    AND T.DET_SERIE_ = ADC_SERIE_ '+
                       '                    AND T.DET_CODFOR = ADC_CODFOR '+
                       '                    AND T.DET_CODEMP = ADC_CODEMP '+
                       ' LEFT JOIN AGEITE E ON E.AIT_SEQGER = GI.AUTOINCREM '+
                       '                   AND E.AIT_CODITE = T.DET_CODITE '+
                       ' LEFT JOIN DIGELE DIG ON DIG.DIG_IDEDIG = GI.ARC_IDEDIG '+
                       '                     AND DIG.DIG_CODITE = T.DET_CODITE  '+
                       '                     AND DIG.DIG_CODEMP = T.DET_CODEMP '+
                       ' WHERE GI.AUTOINCREM = G.AUTOINCREM                '+
                       ' GROUP BY G.AUTOINCREM) ';
  End;

  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND ARC_CODEMP = ' + QuotedStr(VS_strCodEmp);

    If not fEmptyStr(strStatus) Then
      strWhere := strWhere + ' AND ARC_STATUS IN (' + strStatus+ ')';

    If not fEmptyStr(strPlaca) Then
      strWhere := strWhere + ' AND ARC_PLACA_ = ' + QuotedStr(strPlaca);

    If blnIgnorarEnderecados Then
      strWhere := strWhere + ' AND ' + fGetSQLStatusEnderecamento+ ' <> "ENDEREÇADO" ';

    Result := strWhere;
  End;
Begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try

      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + ' SELECT ARC_CODIGO,    ';
      strSQL := strSQL + '        ARC_IDEDIG,    ';
      strSQL := strSQL + '        ARC_CODTRA,    ';
      strSQL := strSQL + '        TRA_NOMTRA,    ';
      strSQL := strSQL + '        ARC_PLACA_,    ';
      strSQL := strSQL + '        ARC_DTAENT,    ';
      strSQL := strSQL + '        ARC_HRAENT,    ';
      strSQL := strSQL + '        ARC_IDENTI,    ';
      strSQL := strSQL + '        BAIVIR,        ';
      strSQL := strSQL + '        DOCUMENTOS,    ';
      strSQL := strSQL + '        STA_ENDERC,    ';
      strSQL := strSQL + '        ARC_FORREC,    ';
      strSQL := strSQL + '        FOR_DOCUMENT, ';
      strSQL := strSQL + '        ARC_DTACAD,    ';
      strSQL := strSQL + '        G.AUTOINCREM   ';
      strSQL := strSQL + ' FROM AGEREC G         ';
      strSQL := strSQL + '   LEFT JOIN CADTRA ON TRA_CODTRA = ARC_CODTRA         ';

      strGroup:= '';
      strGroup:= ' GROUP BY G.AUTOINCREM ';

      objConsulta := TDefConsulta.Create;

      objConsulta.pIncluiSubConsulta('BAIVIR', ' IF(ARC_STATUS = "AG" ,"RECEBIMENTO AGENDADO",   ' +
                                               ' IF(ARC_STATUS = "EC" ,"ENTRADA DE CAMINHAO",     ' +
                                               ' IF(ARC_STATUS = "EP" ,"ENDEREÇAMENTO PLANEJADO", ' +
                                               ' IF(ARC_STATUS = "CE" ,"CAMINHAO ESTACIONADO",    ' +
                                               ' IF(ARC_STATUS = "CN" ,"CONFERIDO", "")))))       ');

      objConsulta.pIncluiSubConsulta('DOCUMENTOS','(SELECT GROUP_CONCAT(CONCAT(ADC_NUMDOC,"-",ADC_ESPDOC,"-",ADC_CODEMP) SEPARATOR " ") FROM AGEDOC WHERE ADC_SEQGER = G.AUTOINCREM)');

      objConsulta.pIncluiSubConsulta('FOR_DOCUMENT','(SELECT GROUP_CONCAT(ADC_CODFOR," - ",F.FOR_NOMFOR) FROM AGEDOC LEFT JOIN CADFOR F ON F.FOR_CODFOR = ADC_CODFOR WHERE ADC_SEQGER = G.AUTOINCREM)');

      strSQLEnder := fGetSQLStatusEnderecamento;

      objConsulta.pIncluiSubConsulta('STA_ENDERC', strSQLEnder);

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True), strGroup],
                  ['Código',
                   'Seq. de Recebimento',
                   'Cód. Transportadora',
                   'Transportadora',
                   'Placa',
                   'Data de Entrega',
                   'Hora de Entrega',
                   'Identificação',
                   'Status',
                   'Documentos',
                   'Status do Endereçamento',
                   'Fornecedores no plano',
                   'Fornecedor do Documento',
                   'Data Cadastro'],
                   ['TRA_NOMTRA', 'ARC_CODIGO'],
                   '',
                   'AGEREC',
                   Self.Name,
                   'Consulta de Agendamento de Entrega',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False),
                   strGroup,
                   False,
                   objConsulta) Then
      Begin
        Result := True;
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('ARC_CODIGO').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('ARC_CODIGO').AsString;
        End;
      End;

      If Not Assigned(qryTabela) Then
        FreeAndNil(qryConsulta);

      FreeAndNil(objConsulta);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;

End;

