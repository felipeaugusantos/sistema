{**************************RV*}
function fPesqMotorista(Self     : TForm;                         {* Formulário                                  *}
                        edtCodigo: TCustomEdit;                   {* Edit do Código                              *}
                        edtDescri: TEditFocus;                    {* Edit da Descrição                           *}
                        qryTabela: TUniQuery;                     {* Query                                       *}
                        Var chrKey: Char;                         {* Key                                         *}
                        Var arrSel: TConsultasArray;              {* Array de Seleção                            *}
                        blnConSim: Boolean = True;                {* Consulta Simples ou Múltipla (multi select) *}
                        blnAtivos: Boolean = False): Boolean;     {* Apenas com status ativo                     *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    If blnAtivos Then
    Begin
      strWhere := strWhere + ' AND MOT_STATUS = "A" ';
    End;

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  AUTOINCREM,       ';
      strSQL := strSQL + '  MOT_CODMOT,       ';
      strSQL := strSQL + '  MOT_NOMMOT,       ';
      strSQL := strSQL + '  CASE MOT_TIPMOT   ';
      strSQL := strSQL + '    WHEN "P" THEN "MOTORISTA PRÓPRIO" ';
      strSQL := strSQL + '    WHEN "T" THEN "MOTORISTA TERCEIRIZADO" ';
      strSQL := strSQL + '  END AS MOT_TIPMOT,';

      strSQL := strSQL + IIF(fCfgSis('MATDIS', varBoolean),
                             '  CASE MOT_MONMOT   '+
                             '    WHEN "S" THEN "SIM" '+
                             '    WHEN "N" THEN "NÃO" '+
                             '  END '
                             ,
                             '    "NÃO" ');
      strSQL := strSQL + '  AS MOT_MONMOT, ';

      strSQL := strSQL + IIF(fCfgSis('MATDIS', varBoolean),
                             '  CASE MOT_GERROM   '+
                             '    WHEN "S" THEN "SIM" '+
                             '    WHEN "N" THEN "NÃO" '+
                             '  END '
                             ,
                             '    "NÃO" ');
      strSQL := strSQL + '  AS MOT_GERROM, ';
      strSQL := strSQL + '  MOT_STATUS       ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADMOT            ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                  ['AUTOINCREM',
                   'Código',
                   'Nome',
                   'Tipo Motorista',
                   'Monitorado',
                   'Gera Romaneio',
                   'Situação'],
                   ['MOT_NOMMOT','MOT_CODMOT', 'MOT_TIPMOT', 'MOT_MONMOT', 'MOT_GERROM', 'MOT_STATUS'],
                   '',
                   'CADMOT',
                   Self.Name,
                   'Consulta de Motoristas',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'MOT_CODMOT',
                   fSQLWhere(False)) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('MOT_CODMOT').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('MOT_CODMOT').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := qryConsulta.FieldByName('MOT_NOMMOT').AsString;

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtCodigo) then
          Begin
            If (edtCodigo Is TMaskEditFocus) Then
              (edtCodigo As TMaskEditFocus).Text := fStrZero('0', 5)
            Else
              edtCodigo.Text := fStrZero('0', 5);
          End;

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

