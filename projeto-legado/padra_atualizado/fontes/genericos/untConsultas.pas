                      Var arrSel: TConsultasArray;         {* Array de Seleção                            *}
                      blnConSim: Boolean = True): Boolean; {* Consulta Simples ou Múltipla (multi select) *}
  Var
    strSQL     : String;
    qryConsulta: TUniQuery;
  Function fSQLWhere(blnCompleto: Boolean): String;
    Var
      strWhere: String;
  Begin
    If blnCompleto Then
      strWhere := ' WHERE TRUE '
    Else
      strWhere := '';

    strWhere := strWhere + ' AND IBP_ESTADO = "' + fCadEmp('ESTADO') + '"';

    Result := strWhere;
  End;
begin
  Result := False;
  If fEntraCons(chrKey) Then
  Begin
    Try
      chrKey := #0;

      strSQL := '';
      strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
      strSQL := strSQL + '  IBP_ESTADO,       ';
      strSQL := strSQL + '  IBP_N_C_M_,       ';
      strSQL := strSQL + '  IBP_E_X___,       ';
      strSQL := strSQL + '  IBP_ALQNAC,       ';
      strSQL := strSQL + '  IBP_ALQIMP,       ';
      strSQL := strSQL + '  IBP_ALQEST,       ';
      strSQL := strSQL + '  IBP_ALQMUN,       ';
      strSQL := strSQL + '  AUTOINCREM        ';
      strSQL := strSQL + 'FROM                ';
      strSQL := strSQL + '  CADIBP            ';

      If Not Assigned(qryTabela) Then
        qryConsulta := fCriaQuery(Nil)
      Else
        qryConsulta := qryTabela;

      If fConsultaConfig([strSQL, fSQLWhere(True)],
                  ['UF',
                   'NCM',
                   'EX',
                   'Tributação Federal para Nacionais',
                   'Tributação Federal para Importados',
                   'Tributação Estadual',
                   'Tributação Municipal',
                   'AUTOINCREM'],
                   ['IBP_N_C_M_', 'IBP_E_X___'],
                   '',
                   'CADIBP',
                   Self.Name,
                   'Consulta de Alíquotas IBPT',
                   qryConsulta,
                   Nil,
                   blnConSim,
                   arrSel,
                   'AUTOINCREM',
                   fSQLWhere(False)) Then
      Begin
        If Assigned(edtCodigo) then
        Begin
          If (edtCodigo Is TMaskEditFocus) Then
            (edtCodigo As TMaskEditFocus).Text := qryConsulta.FieldByName('IBP_N_C_M_').AsString
          Else
            edtCodigo.Text := qryConsulta.FieldByName('IBP_N_C_M_').AsString;
        End;

        If Assigned(edtDescri) Then
          edtDescri.Text := FloatToStr(qryConsulta.FieldByName('IBP_ALQNAC').AsFloat);

        If (Length(arrSel) > 1) Then
        Begin

          If Assigned(edtDescri) Then
            edtDescri.Text := '+1';

        End;

        Result := True;

        If Not Assigned(qryTabela) Then
          FreeAndNil(qryConsulta);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  End;
end;

