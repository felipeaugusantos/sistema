    If (intCorre - 1 ) >= 0 Then
      Result := Result + ' + ';
  End;

  strCampo := IIF(fEmptyStr(strAliDet), 'IFNULL(DET_TOTCUS, 0)', 'IFNULL(' + strAliDet + '.DET_TOTCUS, 0)');

  Result := 'ROUND(( ' + Result + ' ), 2) ';
