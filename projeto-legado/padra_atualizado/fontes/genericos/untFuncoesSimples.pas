{******************************************}
{* ADAPTAÇÃO DA FUNÇÃO GET_EXTENSO        *}
{***************************************LU*}
function FAdpt_Exten(strValor, strMoeda: String): String;
Begin
  Result := FGet_Extens(strValor, 'E');

  {***********************}
  {* DOLARES AMERICANOS  *}
  {********************LU*}
  If strMoeda = '1' Then
  Begin
    Result := AnsiReplaceStr(Result, 'GUARANIES', '');
    Result := AnsiReplaceStr(Result, 'GUARANIE', '');
    Result := Result + ' DOLARES AMERICANOS (TC:' + FormatFloat('#,##0.00',fP_CotGua('D')) + ')'
  End;

End;

{***************************************}
{* RETORNA A ESCRITA POR EXTENSO DE UM *}
{* VALOR MONETARIO NO IDIOMA DESEJADO  *}
{* P = PORTUGUES                       *}
{* E = ESPANHOL                        *}
{* I = INGLES                          *}
{************************************LU*}
function FGet_Extens(Value: String; strIdioma: String = 'P'; blnDolExt: Boolean = False):String;
  Var
    strInteiro,
    strCentavo : string;
    Len,
    n : Integer;  {Nº de Digitos }
begin

  Value := FloatToStrF(Abs(fStrToFloat(Value)), ffFixed, 12, 2);

	Value := AnsiReplaceStr(Value, '.','');
  Len := Length(Value);
  n := Pos(',', Value);

  {Formatando a Vírgula e os Centavos}
  If n = 0 Then
		Value := Value + ',00'
	Else
  Begin
		If Len > n + 2 Then
			Delete(Value, n+3, Len-n+2)
		Else
		If Len < n + 2 Then
			Insert(Copy('00', 1, n + 2 - Len) , Value, n + 1);
		If Value = '0,00' Then
		Begin
      Result := '';
      Exit;
    End;

		n := Pos(',', Value);
		strInteiro := Copy(Value, 1, n - 1);
		strCentavo := Copy(Value, n + 1, 2);
		Len := Length(strInteiro);

		Case Len Of
			7 : Begin
            Result := fExt3(strInteiro, strIdioma);
            Len := 6;
            strInteiro := copy(strInteiro,2,6);
          End;
			8 : Begin
            Result := fExt3(strInteiro, strIdioma);
            Len := 6;
            strInteiro := copy(strInteiro,3,6);
          End;
			9 : Begin
            Result := fExt3(strInteiro, strIdioma);
            Len := 6;
            strInteiro := copy(strInteiro,4,6);
          End;
		End;

		Case Len Of
			1 : Result := Result + fExt1(strInteiro, strIdioma);
			2 : Result := Result + fExt1(strInteiro, strIdioma);
			3 : Result := Result + fExt1(strInteiro, strIdioma);
			4 : Result := Result + fExt2(strInteiro, strIdioma);
			5 : Result := Result + fExt2(strInteiro, strIdioma);
			6 : Result := Result + fExt2(strInteiro, strIdioma);
		Else
			Result := Value;
		End;

		If (StrToInt(strInteiro) <> 1) And (StrToInt(strInteiro) <> 0) Then
    Begin
      If strIdioma = 'P' Then
      	Result := Result + 'REAIS' + ' ';

      {*****************************************}
      {* "blnDolExt" CONTROLA SE SERÁ EM DOLAR *}
      {**************************************PZ*}
      If ((strIdioma) = 'E') And (Not blnDolExt) Then
      	Result := Result + 'GUARANIES' + ' '
      Else If ((strIdioma) = 'E') And (blnDolExt) Then
      	Result := Result + 'DOLARES' + ' ';

      If strIdioma = 'I' Then
      	Result := Result + 'DOLARS' + ' ';
    End
		Else
    Begin
      If strIdioma = 'P' Then
      	Result := Result + 'REAL' + ' ';

      {*****************************************}
      {* "blnDolExt" CONTROLA SE SERÁ EM DOLAR *}
      {**************************************PZ*}
      If (strIdioma = 'E') And (Not blnDolExt) Then
      	Result := Result + 'GUARANIE' + ' '
      Else If (strIdioma = 'E') And (Not blnDolExt) Then
      	Result := Result + 'DOLAR' + ' ';

      If strIdioma = 'I' Then
      	Result := Result + 'DOLAR' + ' ';
    End;

		If strCentavo <> '00' Then
    Begin
			If StrToInt(strInteiro) <> 0 Then
			Begin
				If strCentavo <> '01' Then
        Begin
          If strIdioma = 'P' Then
          	Result := Result + 'E ' + fExt1(strCentavo, strIdioma) + 'CENTAVOS';
          If strIdioma = 'E' Then
          	Result := Result + 'Y ' + fExt1(strCentavo, strIdioma) + 'CENTAVOS';
          If strIdioma = 'I' Then
          	Result := Result + ' ' + fExt1(strCentavo, strIdioma) + 'CENTS';
        End
				Else
        Begin
          If strIdioma = 'P' Then
          	Result := Result + 'E UM ' + 'CENTAVO';
          If strIdioma = 'E' Then
          	Result := Result + 'E UN ' + 'CENTAVO';
          If strIdioma = 'I' Then
          	Result := Result + 'AND ONE ' + 'CENT';
        End;
			End
			Else
			Begin
				If strCentavo <> '01' Then
        Begin
          If strIdioma = 'P' Then
          	Result := fExt1(strCentavo, strIdioma) + 'CENTAVOS';
          If strIdioma = 'E' Then
          	Result := fExt1(strCentavo, strIdioma) + 'CENTAVOS';
          If strIdioma = 'I' Then
          	Result := fExt1(strCentavo, strIdioma) + 'CENTS';
        End
				Else
        Begin
          If strIdioma = 'P' Then
          	Result := 'UM ' + 'CENTAVO';
          If strIdioma = 'E' Then
          	Result := 'UN ' + 'CENTAVO';
          If strIdioma = 'I' Then
          	Result := 'ONE ' + 'CENT';
        End;
			End;
    End;
  End;

end;

{*************************************}
{* PEGA A TAXA DE CAMBIO P/ GUARANIE *}
{**********************************LU*}
function fP_CotGua(strMoeda: String): Double;
Var
  qryGen : TUniQuery;
Begin
  Result := 0;

  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT * FROM CADMOE ORDER BY MOE_DTAMOE DESC LIMIT 1');
      Open;

      {****************}
      {* DOLAR        *}
      {*************LU*}
      If strMoeda = 'D' Then
        Result := fieldbyname('MOE_DOLVEN').AsFloat;

      {****************}
      {* REAL         *}
      {*************LU*}
      If strMoeda = 'R' Then
        Result := fieldbyname('MOE_REAVEN').AsFloat;

      {****************}
      {* GUARANIES    *}
      {*************LU*}
      If strMoeda = 'G' Then
        Result := fieldbyname('MOE_GUAVEN').AsFloat;

      {****************}
      {* PESO         *}
      {*************LU*}
      If strMoeda = 'P' Then
        Result := fieldbyname('MOE_PARVEN').AsFloat;

      {****************}
      {* EURO         *}
      {*************LU*}
      If strMoeda = 'E' Then
        Result := fieldbyname('MOE_EURVEN').AsFloat;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

End;

function fExt3(strS : string; strIdioma: String = 'P') : string;
begin

  If (strIdioma = 'P') Then
  Begin
    Case Length(strS) of
      7 : If Copy(strS,1,1) <> '0' Then
            Result := fExt1(Copy(strS,1,1), strIdioma) + 'MILHÃO '
          Else
            Result := fExt1(Copy(strS,2,3), strIdioma);
      8 : If Copy(strS,1,2) <> '00' Then
            Result := fExt1(Copy(strS,1,2), strIdioma) + 'MILHÕES '
          Else
            Result := fExt1(Copy(strS,3,3), strIdioma);
      9 : If Copy(strS,1,3) <> '000' Then
            Result := fExt1(Copy(strS,1,3), strIdioma) + 'MILHÕES '
          Else
            Result := fExt1(Copy(strS,4,3), strIdioma);
    End;
  End;

  If (strIdioma = 'E') Then
  Begin
    Case Length(strS) of
      7 : If Copy(strS,1,1) <> '0' Then
            Result := fExt1(Copy(strS,1,1), strIdioma) + 'MILLON '
          Else
            Result := fExt1(Copy(strS,2,3), strIdioma);
      8 : If Copy(strS,1,2) <> '00' Then
            Result := fExt1(Copy(strS,1,2), strIdioma) + 'MILLONES '
          Else
            Result := fExt1(Copy(strS,3,3), strIdioma);
      9 : If Copy(strS,1,3) <> '000' Then
            Result := fExt1(Copy(strS,1,3), strIdioma) + 'MILLONES '
          Else
            Result := fExt1(Copy(strS,4,3), strIdioma);
    End;
  End;

  If strIdioma = 'I' Then
  Begin
    Case Length(strS) of
      7 : If Copy(strS,1,1) <> '0' Then
            Result := fExt1(Copy(strS,1,1), strIdioma) + 'MILLION '
          Else
            Result := fExt2(Copy(strS,2,3), strIdioma);
      8 : If Copy(strS,1,2) <> '00' Then
            Result := fExt1(Copy(strS,1,2), strIdioma) + 'MILLIONS '
          Else
            Result := fExt1(Copy(strS,3,3), strIdioma);
      9 : If Copy(strS,1,3) <> '000' Then
            Result := fExt1(Copy(strS,1,3), strIdioma) + 'MILLIONS '
          Else
            Result := fExt1(Copy(strS,4,3), strIdioma);
    End;
  End;

end;

function fExt1(strS : String; strIdioma: String = 'P') : String;
Begin

  Case Length(strS) Of
    1 : Result := fExtUnidade(strS[1], strIdioma);
    2 : Result := fExtDezena(strS[1] + strS[2], strIdioma);
    3 : If strS[2] + strS[3] = '00'  Then
        Begin
          If strIdioma = 'P' Then
      			Result := String(CentenaPor[StrToInt(strS[1])]);
          If strIdioma = 'E' Then
      			Result := String(CentenaEsp[StrToInt(strS[1])]);
          If strIdioma = 'I' Then
      			Result := String(CentenaIng[StrToInt(strS[1])]);
        End
  			Else
        Begin
          If strIdioma = 'P' Then
          Begin
            If strS[1] = '1' Then
              Result := 'CENTO E ' + fExtDezena(strS[2] + strS[3], strIdioma)
            Else
              Result := String(CentenaPor[StrToInt(strS[1])]) + 'E ' + fExtDezena(strS[2] + strS[3], strIdioma);
          End;
          If strIdioma = 'E' Then
          Begin
            If strS[1] = '1' Then
              Result := 'CIENTO Y ' + fExtDezena(strS[2] + strS[3], strIdioma)
            Else
              Result := String(CentenaEsp[StrToInt(strS[1])]) + 'Y ' + fExtDezena(strS[2] + strS[3], strIdioma);
          End;
          If strIdioma = 'I' Then
          Begin
            If strS[1] = '1' Then
              Result := 'ONE HUNDRED AND ' + fExtDezena(strS[2] + strS[3], strIdioma)
            Else
              Result := String(CentenaIng[StrToInt(strS[1])]) + 'AND ' + fExtDezena(strS[2] + strS[3], strIdioma);
          End;
        End;
  End;

End;

function fExt2(strS : string; strIdioma: String = 'P') : string;
begin

  If (strIdioma = 'P') Or ((strIdioma = 'E')) Then
  Begin
    Case Length(strS) of
      4 : If Copy(strS,1,1) <> '0' Then
            Result := fExt1(Copy(strS,1,1), strIdioma) + 'MIL ' + fExt1(Copy(strS,2,3), strIdioma)
          Else
            Result := fExt1(Copy(strS,2,3), strIdioma);
      5 : If Copy(strS,1,2) <> '00' Then
            Result := fExt1(Copy(strS,1,2), strIdioma) + 'MIL ' + fExt1(Copy(strS,3,3), strIdioma)
          Else
            Result := fExt1(Copy(strS,3,3), strIdioma);
      6 : If Copy(strS,1,3) <> '000' Then
            Result := fExt1(Copy(strS,1,3), strIdioma) + 'MIL ' + fExt1(Copy(strS,4,3), strIdioma)
          Else
            Result := fExt1(Copy(strS,4,3), strIdioma);
    End;
  End;

  If strIdioma = 'I' Then
  Begin
    Case Length(strS) of
      4 : If Copy(strS,1,1) <> '0' Then
            Result := fExt1(Copy(strS,1,1), strIdioma) + 'THOUSAND ' + fExt1(Copy(strS,2,3), strIdioma)
          Else
            Result := fExt1(Copy(strS,2,3), strIdioma);
      5 : If Copy(strS,1,2) <> '00' Then
            Result := fExt1(Copy(strS,1,2), strIdioma) + 'THOUSAND ' + fExt1(Copy(strS,3,3), strIdioma)
          Else
            Result := fExt1(Copy(strS,3,3), strIdioma);
      6 : If Copy(strS,1,3) <> '000' Then
            Result := fExt1(Copy(strS,1,3), strIdioma) + 'THOUSAND ' + fExt1(Copy(strS,4,3), strIdioma)
          Else
            Result := fExt1(Copy(strS,4,3), strIdioma);
    End;
  End;

end;

function fExtUnidade(strS : String; strIdioma: String = 'P') : String;
begin
  If strIdioma = 'P' Then
  	Result := String(UnidadePor[StrToInt(strS[1])]);
  If strIdioma = 'E' Then
  	Result := String(UnidadeEsp[StrToInt(strS[1])]);
  If strIdioma = 'I' Then
  	Result := String(UnidadeIng[StrToInt(strS[1])]);
end;

function fExtDezena(strS : String; strIdioma: String = 'P') : String;
begin
  If strS[1] <> '1' Then
  	If strS[2] <> '0' Then
			If strS[1] <> '0' Then
      Begin
        If strIdioma = 'P' Then
       		Result := String(DezenaPor[StrToInt(strS[1])] + 'E ' + UnidadePor[StrToInt(strS[2])]);
        If strIdioma = 'E' Then
       		Result := String(DezenaEsp[StrToInt(strS[1])] + 'Y ' + UnidadeEsp[StrToInt(strS[2])]);
        If strIdioma = 'I' Then
       		Result := String(DezenaIng[StrToInt(strS[1])] + 'AND ' + UnidadeIng[StrToInt(strS[2])]);
      End
     	Else
      Begin
        If strIdioma = 'P' Then
        	Result := String(UnidadePor[StrToInt(strS[2])]);
        If strIdioma = 'E' Then
        	Result := String(UnidadeEsp[StrToInt(strS[2])]);
        If strIdioma = 'I' Then
        	Result := String(UnidadeIng[StrToInt(strS[2])]);
      End
  	Else
    Begin
      If strIdioma = 'P' Then
        Result := String(DezenaPor[StrToInt(strS[1])]);
      If strIdioma = 'E' Then
        Result := String(DezenaEsp[StrToInt(strS[1])]);
      If strIdioma = 'I' Then
        Result := String(DezenaIng[StrToInt(strS[1])]);
    End
  Else
  {Dezena = 1}
  Begin
    If strIdioma = 'P' Then
    Begin
      Case strS[2] Of
        '0' : Result := 'DEZ ';
        '1' : Result := 'ONZE ';
        '2' : Result := 'DOZE ';
        '3' : Result := 'TREZE ';
        '4' : Result := 'QUATORZE ';
        '5' : Result := 'QUINZE ';
        '6' : Result := 'DEZESSEIS ';
        '7' : Result := 'DEZESSETE ';
        '8' : Result := 'DEZOITO ';
        '9' : Result := 'DEZENOVE ';
      End;
    End;
    If strIdioma = 'E' Then
    Begin
      Case strS[2] Of
        '0' : Result := 'DEIZ ';
        '1' : Result := 'ONCE ';
        '2' : Result := 'DOCE ';
        '3' : Result := 'TRECE ';
        '4' : Result := 'CATORCE ';
        '5' : Result := 'QUINCE ';
        '6' : Result := 'DIECISEIS ';
        '7' : Result := 'DIECISIETE ';
        '8' : Result := 'DIECIOCHO ';
        '9' : Result := 'DIECINUEVE ';
      End;
    End;
    If strIdioma = 'I' Then
    Begin
      Case strS[2] Of
        '0' : Result := 'TEN ';
        '1' : Result := 'ELEVEN ';
        '2' : Result := 'TWELVE ';
        '3' : Result := 'THIRTEEN ';
        '4' : Result := 'FOURTEEN ';
        '5' : Result := 'FIFTEEN ';
        '6' : Result := 'SIXTEEN ';
        '7' : Result := 'SEVENTEEN ';
        '8' : Result := 'EIGHTEEN ';
        '9' : Result := 'NINETEEN ';
      End;
    End;
  End;
end;

