procedure PostKeyEx32(key: Word; const shift: TShiftState; specialkey: Boolean);
{
Parameters :
* key : virtual keycode of the key to send. For printable keys this is simply the ANSI code (Ord(character)) .
* shift : state of the modifier keys. This is a set, so you can set several of these keys (shift, control, alt, mouse buttons) in tandem. The TShiftState type is declared in the Classes Unit.
* specialkey: normally this should be False. Set it to True to specify a key on the numeric keypad, for example.
Description:
Uses keybd_event to manufacture a series of key events matching the passed parameters. The events go to the control with focus.
Note that for characters key is always the upper-case version of the character. Sending without any modifier keys will result in a lower-case character, sending it with [ ssShift ] will result in an upper-case character!
}
type
   TShiftKeyInfo = record
     shift: Byte ;
     vkey: Byte ;
   end;
   ByteSet = set of 0..7 ;
const
   shiftkeys: array [1..3] of TShiftKeyInfo =
     ((shift: Ord(ssCtrl) ; vkey: VK_CONTROL),
     (shift: Ord(ssShift) ; vkey: VK_SHIFT),
     (shift: Ord(ssAlt) ; vkey: VK_MENU)) ;
var
   flag: DWORD;
   bShift: ByteSet absolute shift;
   j: Integer;
begin
   for j := 1 to 3 do
   begin
     if shiftkeys[j].shift in bShift then
       keybd_event(shiftkeys[j].vkey, MapVirtualKey(shiftkeys[j].vkey, 0), 0, 0) ;
   end;
   if specialkey then
     flag := KEYEVENTF_EXTENDEDKEY
   else
     flag := 0;

   keybd_event(key, MapvirtualKey(key, 0), flag, 0) ;
   flag := flag or KEYEVENTF_KEYUP;
   keybd_event(key, MapvirtualKey(key, 0), flag, 0) ;

   for j := 3 downto 1 do
   begin
     if shiftkeys[j].shift in bShift then
       keybd_event(shiftkeys[j].vkey, MapVirtualKey(shiftkeys[j].vkey, 0), KEYEVENTF_KEYUP, 0) ;
   end;
end;

function fSubstituirSequenciaDeEspacos_PorUmUnicoEspaco(strTexto : String) : String;
Const
  ESPACO = ' ';
Var
  intQtd : Integer;
  strFin : String;
  strEsp : String;
begin

  intQtd := Length(strTexto);

  If (intQtd <= 0) Then
    Exit('');

  strFin := strTexto;
  While (intQtd > 1) Do
  Begin
    strEsp := '';
    strEsp := fstrEspaco(strEsp, intQtd);
    strFin := StringReplace(strFin, strEsp, ESPACO, [rfReplaceAll]);
    intQtd := intQtd -1;
  End;

  Result := strFin;

end;

function fFindColumnByName(dbgData: TDBGridCitel; strField: String): TColumn;
  var
    intIndex: Integer;
begin
  Result := Nil;
  For intIndex := 0 To dbgData.Columns.Count -1 Do
    If dbgData.Columns[intIndex].FieldName = strField Then
    Begin
      Result := dbgData.Columns[intIndex];
      Break;
    End;
end;

function fGetParentLeft(AControl: TWinControl): Integer;
begin
  If AControl = nil Then Exit(0);
  Result := AControl.Left + fGetParentLeft(AControl.Parent);
end;

function fGetParentTop(AControl: TWinControl): Integer;
begin
  If AControl = nil Then Exit(0);
  Result := AControl.Top + fGetParentTop(AControl.Parent);
end;

function fGetGridRowScreenPosition(Grid: TDBGridCitel; ColumnIndex: Integer): TRect; overload;
begin
  Result        := THackDBGrid(Grid).CellRect(ColumnIndex, THackDBGrid(Grid).Row);
  Result.Top    := fGetParentTop(Grid)  + Result.Top;
  Result.Left   := fGetParentLeft(Grid) + Result.Left;
  Result.Bottom := fGetParentTop(Grid)  + Result.Bottom;
end;

