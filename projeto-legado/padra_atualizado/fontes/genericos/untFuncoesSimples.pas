function fRetornaSubQueryFaixasForaCondicao(fltMarDoc, fltValDoc: Double; blnIgnMar: Boolean): String;
  Var
    strCndMar: String;
    strCndFat: String;
begin
  strCndMar := '(@MAR NOT BETWEEN CND_MARMIN AND CND_MARMAX)';
  strCndFat := '(@VAL NOT BETWEEN CND_FATMIN AND CND_FATMAX)';
  If blnIgnMar Then
    strCndMar := '(FALSE)';

  Result :=
   ' IF('+strCndMar+' OR '+strCndFat+', IF('+strCndMar+' AND '+strCndFat+', 1, IF('+strCndMar+', 2, 3)), 0) ';

  Result := AnsiReplaceStr(Result, '@MAR', AnsiReplaceStr(FloatToStr(fltMarDoc), ',', '.'));
  Result := AnsiReplaceStr(Result, '@VAL', AnsiReplaceStr(FloatToStr(fltValDoc), ',', '.'));

  //0 CONDIÇÃO DENTRO DO NORMAL
  //1 MARGEM E VALOR FORA DO INTERVALO
  //2 MARGEM FORA DO INTERVALO
  //3 VALOR FORA DO INTERVALO
end;

