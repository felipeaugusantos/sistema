function fListarCamposTabela(strTabela: String): String;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery;
  qryAux.SQL.Add('DESC ' + strTabela);
  qryAux.Open;

  Result := '';
  While (Not qryAux.Eof) Do
  Begin
    If Result <> '' Then
      Result := Result + ', ';
    Result := Result + qryAux.FieldByName('Field').AsString;
    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

function fListarCamposTabela(strTabela, strAlias: String; ignorarCampos: Array Of String): String;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery;
  qryAux.SQL.Add('DESC ' + strTabela);
  qryAux.Open;

  Result := '';
  While (Not qryAux.Eof) Do
  Begin
    If Not MatchStr(qryAux.FieldByName('Field').AsString, ignorarCampos) Then
      Result := Concat(Result, strAlias, qryAux.FieldByName('Field').AsString, ', ');
    qryAux.Next;
  End;

  Result := Copy(Result, 1, Length(Result) -2);

  FreeAndNil(qryAux);
end;

