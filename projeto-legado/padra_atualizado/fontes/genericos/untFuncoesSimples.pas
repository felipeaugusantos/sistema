function fRetProxNumAutBan(strCartPrinc: String): String;
Begin
  //Utilizado para retornar o Próximo Número de Remessa da Carteira Principal
  Result := fGetBancoConfig(0, strCartPrinc, 'PROXNUM', '');
End;

procedure pAtualizaProxNumCartsAutBan(strCartPrinc: String);
Var intCont   : Integer;
    strCartSeq: String;
    strCartei : String;
begin
  //Utilizado para atualizar o  Próximo Número de Remessa das carteiras "filhas"
  strCartSeq := fRetProxNumAutBan(strCartPrinc);
  strCartei  := Copy(strCartPrinc, Length(strCartPrinc));
  For intCont := 1 to 5 Do
  Begin
    If (intCont <> StrToInt(strCartei)) And
       (fGetBancoConfig(0, Copy(strCartPrinc, 1, Length(strCartPrinc) - 1) + IntToStr(intCont), 'SEQCART', '') = strCartei) Then
    Begin
      fGetBancoConfig(1, Copy(strCartPrinc, 1, Length(strCartPrinc) - 1) + IntToStr(intCont), 'PROXNUM', strCartSeq);
    End;
  End;
End;

function fVerificaCartPrimariaAutBan(strConfig: String; intCartSel: Integer): Boolean;
Var intCont   : Integer;
    strCartSeq: String;
begin
  Result := False;

  For intCont := 1 to 5 Do
  Begin
    If intCont <> intCartSel Then
    Begin
      strCartSeq := fGetBancoConfig(0, strConfig + IntToStr(intCont), 'SEQCART', '');
      Result := (strCartSeq = InttoStr(intCartSel));

      If Result Then Break;
    End;
  End;
end;

function fVerificaCartFilhaAutBan(strConfig: String): Boolean;
Var strCartSeq: String;
begin
  strCartSeq := fGetBancoConfig(0, strConfig, 'SEQCART', '');
  Result := (Not fEmptyStr(strCartSeq));
end;

{*****************************************}
{* IMPLEMENTAÇÃO DA FUNCAO GETMENU       *}
{**************************************MV*}
function fGetMenu(strTitulo: String; arrOpcoes: Array Of String; intOpcao: Integer;
  blnSaiComEsc: Boolean = False; blnLibQtd: Boolean = False; intWidth: Integer = 0): Integer;
  Var
    intContador: Integer;
begin

  Result := -1;
  If (Not blnLibQtd) And (Length(arrOpcoes) <= 1) Then
  Begin
    fMensagem('', 'É Necessário escolher ao menos 2 opções', ['&Ok']);
    Exit;
  End;

  Try
    pCriarFormularios(TfrmGetMenu, frmGetMenu);
    SetLength(frmGetMenu.arrOpcoes, Length(arrOpcoes));

    For intContador := 0 To Length(arrOpcoes)-1 Do
    Begin
      frmGetMenu.arrOpcoes[intContador] := arrOpcoes[intContador];
    End;

    If intOpcao <= 0 Then
      intOpcao := 1;

    Dec(intOpcao);

    frmGetMenu.intLinha     := intOpcao;
    frmGetMenu.blnSaiComEsc := blnSaiComEsc;
    frmGetMenu.Caption      := strTitulo;

    If intWidth > 0 Then
    Begin
      frmGetMenu.Width         := frmGetMenu.Width + intWidth;
      frmGetMenu.stgMenu.Width := frmGetMenu.Width;
      frmGetMenu.stgMenu.DefaultColWidth := frmGetMenu.Width;
    End;

    frmGetMenu.showModal;

    If frmGetMenu.blnConfirma Then
    Begin
      Result := frmGetMenu.intLinha+1;
    End;

  Except
    On E: Exception Do
    Begin
      Result := -1;
      pMensagensErro(E.Message, '[untFuncoes.fGetMenu]');
    End;
  End;

  pFreeAndNil(frmGetMenu);

end;

procedure pCarregaArrayBancoCarteira(strCodBan: String;
                                     Var arrBancos: TArrBancos;
                                     Var arrBanCar: TStringArray;
                                     blnVeioImpBol: Boolean = True;
                                     strCodCar: String = '';
                                     strEmpresaImpressao: String = '';
                                     strNomeConfig: String = 'CONFIG');
  Var
    intContador: Integer;
    stlBancos  : TStringList;

    function fEmpresaImpBol(strKeyAtb: String): Boolean;
    begin
      Result := (fGetBancoConfig(0, strKeyAtb, 'RESPONS', 'E', strEmpresaImpressao) = 'E') And
                (fGetBancoConfig(0, strKeyAtb, 'PERIMPBOL', 'S', strEmpresaImpressao) <> 'N');

      If Not blnVeioImpBol Then
        Result := True;
    end;

    function fJaTemNoArray(strBanRet, strCarRet, strCartei, strInfAdi: String):Boolean;
      Var
        intContador: Integer;
    Begin

      Result := False;

      For intContador := 0 To Length(arrBanCar) - 1Do
      Begin
        If arrBanCar[intContador] = 'Banco: ' + strBanRet + '-' + strCarRet + ' - CART.: ' + strCartei + strInfAdi Then
        Begin
          Result := True;
          Break;
        End;
      End;

    End;

    procedure pSetArrBan(strKeyAtb: String);
      Var
        strInfAdi: String;
        strCartei: String;
        strBanRet: String;
        intCarRet: Integer;
    begin

    	If fEmpresaImpBol(LeftStr(strKeyAtb, Length(strKeyAtb)-4)) Then
      Begin
        If Copy(strKeyAtb, 11, 6) = 'CONRET' Then
          Exit;

        strBanRet := Copy(strKeyAtb, 7 , Pos('-', RightStr(strKeyAtb, Length(strKeyAtb) - 6))-1 );
        intCarRet := StrToIntDef(Copy(strKeyAtb, 8 + Length(strBanRet) , Pos('-', RightStr(strKeyAtb, Length(strKeyAtb) - 7 - Length(strBanRet)))-1 ),0);

        strKeyAtb := LeftStr(strKeyAtb, Length(strKeyAtb)-4);

        strInfAdi := fGetBancoConfig(0, strKeyAtb, 'INFADIC', '', strEmpresaImpressao);
        If Not fEmptyStr(strInfAdi) Then  strInfAdi := ' - ' + strInfAdi;

        strCartei := fGetBancoConfig(0, strKeyAtb, 'CODCART', '', strEmpresaImpressao);
        If fEmptyStr(strCartei) Then strCartei := fGetBancoConfig(0, strKeyAtb, 'NUMCART', '', strEmpresaImpressao);

        If (fEmptyStr(strCodCar) Or (intCarRet.ToString = strCodCar))                And
           (Not fJaTemNoArray(strBanRet, IntToStr(intCarRet), strCartei, strInfAdi)) Then
        Begin
      		SetLength(arrBanCar, Length(arrBanCar) + 1);

          if not fEmptyStr(Trim(strCartei + strInfAdi)) then
      	   	arrBanCar[Length(arrBanCar)-1] := 'Banco: ' + strBanRet + '-' + IntToStr(intCarRet) + ' - CART.: ' + strCartei + strInfAdi
          else
            arrBanCar[Length(arrBanCar)-1] := 'Banco: ' + strBanRet + '-' + IntToStr(intCarRet);

      		SetLength(arrBancos, Length(arrBancos) + 1);
    	  	arrBancos[Length(arrBancos)-1].strCodBan := strBanRet;
    		  arrBancos[Length(arrBancos)-1].intCodCar := intCarRet;
        End;
    	End;

    end;

    function fChaveValida(strSection: String): Boolean;
      Var
        intCont: Integer;
        intAux : Integer;
    begin
      intAux := 0;

      For intCont := 1 To Length(strSection) Do
      Begin

        If Copy(strSection, intCont, 1) = '-' Then
          Inc(intAux);

      End;

      {*******************************}
      {* CASO NÃO SEJA DA MESMA LOJA *}
      {*******************************}
      If (intAux > 1) And (RightStr(strSection,3) <> strEmpresaImpressao) Then
        intAux := 0;

      If (((strCodBan = '001')              And
          (Pos('D7', strSection) > 0))      Or
          ((strCodBan = '237')              And
          (Pos('_VENDOR', strSection) > 0)) Or
          ((strCodBan = '104')              And
          (Pos('p400', strSection) > 0))    Or
          ((strCodBan = '033')              And
          (Pos('240p', strSection) > 0))    Or
          ((strCodBan = '104')              And
          (Pos('7D', strSection) > 0))      And
          ((MatchStr(strCodBan,['001','341']))And
          (Pos('API', strSection) > 0)))    And
          (Not blnVeioImpBol)               Then
        intAux := 0;

      Result := intAux > 1;
    end;

Begin
  SetLength(arrBanCar, 0);
  SetLength(arrBancos, 0);

  stlBancos := TStringList.Create;

  fArqIniAutban(stlBancos);

  If strEmpresaImpressao.IsEmpty Then
    strEmpresaImpressao := VS_strCodEmp;

  For intContador := 0 To stlBancos.Count -1 Do
  Begin
    If StartsStr(strNomeConfig + strCodBan, stlBancos[intContador]) And
       fChaveValida(stlBancos[intContador])                    Then
    Begin
      pSetArrBan(stlBancos[intContador]);
    End;
  End;

  FreeAndNil(stlBancos);
End;

procedure pVerificaImpCNFBCO(strCodBco: String;
                             strEmpresaImpressao: String);
var
  qryConf: TUniQuery;

  LEmpresa: String;
begin
  if strCodBco = '' then
     Exit;

  strCodBco := Copy(strCodBco,1,3);

  LEmpresa := VS_strCodEmp;
  If Not strEmpresaImpressao.IsEmpty Then
    LEmpresa := strEmpresaImpressao;

  If LEmpresa.Trim.Length <> 3 Then
    LEmpresa := fPadR(LEmpresa.Trim, 3, '0');

  If Assigned(VS_ListaDeCarteiras) Then
  Begin
    If VS_ListaDeCarteiras.IndexOf(Concat('BCO', strCodBco, '_EMP', LEmpresa)) >= 0 Then
      Exit;
  End;

  qryConf := fCriaQuery();

  with qryConf do
  begin
    Sql.Text  := ' SELECT ' +
                 ' *  '     +
                 ' FROM CFGBAN ' +
                 ' WHERE SIS_CODBAN = :CODBAN AND SIS_CODEMP = :CODEMP ' +
                 iif(Pos('PEFIN', strCodBco) > 0, ' AND SIS_NUMPOS = "PEFIN"', '');

    ParamByName('CODBAN').AsString := iif(Pos('PEFIN', strCodBco) > 0, Copy(strCodBco, 1, 3), strCodBco);
    ParamByName('CODEMP').AsString := LEmpresa;

    Open;

    if isEmpty then
      pImportaCNFBCO(strCodBco, LEmpresa)
    Else
    Begin
      If Assigned(VS_ListaDeCarteiras) Then
        VS_ListaDeCarteiras.Add(Concat('BCO', strCodBco, '_EMP', LEmpresa));
    end;
  end;

  FreeAndNil(qryConf);

end;

{*************************************}
{* UTILIZADO PARA SELECIONAR O BANCO *}
{* E A CARTEIRA DE IMPRESSÃO         *}
{**********************************AF*}
function fVer_Banco_Carteira(strCodBan, strCarteira: String;
                             Var strBanRet: String;
                             Var intCarRet: Integer;
                             blnVeioImpBol: Boolean = True;
                             strEmpresaImpressao: String = '';
                             strNomeConfig: String = 'CONFIG'): Boolean;
  Var
    intContador: Integer;
    arrBancos  : TArrBancos;
    arrBanCar  : TStringArray;
Begin
 	Result := True;

  pVerificaImpCNFBCO(strCodBan, strEmpresaImpressao);

  If Not fEmptyStr(strCarteira) And (Length(strCarteira) > 1) Then
  Begin
    strBanRet := Copy(strCarteira, 7 , Pos('-', RightStr(strCarteira, Length(strCarteira) - 6))-1 );
    intCarRet := StrToIntDef(Copy(strCarteira, 8 + Length(strBanRet) , Pos('-', RightStr(strCarteira, Length(strCarteira) - 7 - Length(strBanRet)))-1 ),0);
    Exit;
  End;

  pCarregaArrayBancoCarteira(strCodBan, arrBancos, arrBanCar, blnVeioImpBol, strCarteira, strEmpresaImpressao, strNomeConfig);

  If (strCodBan <> '778') Then
  Begin

    {*******************************************}
    {* CASO NÃO TENHA NENHUMA CARTEIRA CONFI-  *}
    {* GURADA, SETA A PRIMEIRA CARTEIRA COMO   *}
    {* DEFAULT                                 *}
    {****************************************MV*}
    If (Length(arrBanCar) <= 0) Then
    Begin
      Result := False;
      fMensagem('ATENÇÃO!', 'Para efetuar impressão de boletos é necessário configurar' + #13#10 +
                            'a carteira correspondente ao banco desejado!', ['&Ok']);
      Exit;
    End;

    {********************************************}
    {* SE VIER DO FATURAMENTO É FIXO 1          *}
    {* PS: PEDI ALTERAÇÃO PARA SER CONFIGURAVEL *}
    {*2015-04-17******************************AF*}
    intContador := 1;
    If (Length(arrBanCar) > 1) {And (blnVeioImpBol)} Then
    Begin
      intContador := fGetMenu('Selecione o Banco e Carteira', arrBanCar, 0, True);

      If intContador = -1 Then
      Begin
        intCarRet := 0;
        strBanRet := '';
        Result := False;
        Exit;
      End;

    End;

    intCarRet := arrBancos[intContador-1].intCodCar;
    strBanRet := arrBancos[intContador-1].strCodBan;
  End
  Else
  Begin
    If Length(arrBancos) > 0 Then
    Begin
      intCarRet := arrBancos[High(arrBancos)].intCodCar;
      strBanRet := arrBancos[High(arrBancos)].strCodBan;
    End;
  End;

End;

{*********************************}
{* FORMATA CONDICAO DE PAGAMENTO *}
{******************************AF*}
function fFormataCondPag(strCond: String): String;
  Var
    strValor   : String;
    intContador: Integer;
Begin
  intContador := 3;
  strValor := '(';
  strValor := strValor + LeftStr(strCond,2);
  strValor := strValor + ')';

  While intContador < Length(strCond) Do
  Begin
    If intContador > 3 Then
      strValor := strValor + '.';

    strValor := strValor + Copy(strCond,intContador,3);
    inc(intContador,3)
  End;

  {*******************************************}
  {* CASO RETORNE CONDIÇÃO VAZIA, RETORNA    *}
  {* STRING VAZIA                            *}
  {****************************************AF*}
  If (strValor = '()') Then
    strValor := '';

  Result := strValor;
End;

function fFormataCondPagBarra(strCond: String): String;
  Var
    strValor   : String;
    intContador: Integer;
Begin
  intContador := 3;
  strValor := '';
  strValor := strValor + LeftStr(strCond,2);
  strValor := strValor + '/';

  While intContador < Length(strCond) Do
  Begin
    If intContador > 3 Then
      strValor := strValor + '/';

    strValor := strValor + Copy(strCond,intContador,3);
    inc(intContador,3)
  End;

  {*******************************************}
  {* CASO RETORNE CONDIÇÃO VAZIA, RETORNA    *}
  {* STRING VAZIA                            *}
  {****************************************AF*}
  If (strValor = '/') Then
    strValor := '';

  Result := strValor;
End;

function fFormataCondPagEsp(strCond: String; strSeparador: String): String;
  Var
    strValor   : String;
    intContador: Integer;
Begin
  intContador := 3;
  strValor := '';

  If Pos(Copy(strCond, 3, 1), '0123456789') > 0 Then
  Begin

    While intContador < Length(strCond) Do
    Begin
      If intContador > 3 Then
        strValor := strValor + strSeparador;

      strValor := strValor + Copy(strCond,intContador,3);
      inc(intContador,3)
    End;

    If (strValor = strSeparador) Then
      strValor := '';

  End
  Else strValor := UpperCase(Copy(strCond, 3, Length(strCond)-2));

  Result := strValor;
End;

