begin
  Result := EmptyStr;

  If Not Assigned(Screen) Then
    Exit;

  For intCnt := 0 To Screen.FormCount-1 Do
  Begin
    strForm := TForm(Screen.Forms[intCnt]).Name;
    If (Not fEmptyStr(strForm)) And
       (Not strForm.Contains('Gravando')) Then
