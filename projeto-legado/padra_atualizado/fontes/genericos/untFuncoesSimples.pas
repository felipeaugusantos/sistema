    case AnsiIndexStr(UpperCase(ASigla), ['A', 'T', 'O', 'M', 'R', 'F']) of
      0: Result := 'OS ABERTA';
      1: Result := 'ANÁLISE TÉCNICA';
      2: Result := 'ORÇAMENTO';
      3: Result := 'MANUTENÇÃO';
      4: Result := 'OS FINALIZADA';
      5: Result := 'FATURAMENTO';
    end;
  end else if SameText(ATipSta, 'S') then
  begin
    case AnsiIndexStr(UpperCase(ASigla), ['OI', 'TC', 'TA', 'OR', 'OA', 'ON', 'EM', 'AP', 'MF', 'AR', 'FA', 'AF', 'AS']) of
      0: Result := 'OS INCLUÍDA';
      1: Result := 'ANÁLISE TÉCNICA CONCLUÍDA';
      2: Result := 'ANÁLISE TÉCNICA EM ANDAMENTO';
      3: Result := 'ORÇAMENTO REALIZADO';
      4: Result := 'ORÇAMENTO APROVADO';
      5: Result := 'ORÇAMENTO REPROVADO';
      6: Result := 'EM MANUTENÇÃO';
      7: Result := 'AG. PEÇAS';
      8: Result := 'MANUTENÇÃO FINALIZADA';
      9: Result := 'ARMAZENADA';
      10: Result := 'FATURADO';
      11: Result := 'AG. FATURAMENTO';
      12: Result := 'AG. SEPARAÇÃO';
    end;
  end else if SameText(ATipSta, 'C') then
  begin
    case AnsiIndexStr(UpperCase(ASigla), ['AT', 'AO', 'AE', 'PF', 'AC', 'OI', 'AA', 'RC', 'ER', 'AM', 'MI', 'AF', 'AR', 'OB', 'NF']) of
      0: Result := 'AG. ANÁLISE TÉCNICA';
      1: Result := 'AG. ORÇAMENTO';
      2: Result := 'AG. ENVIO';
      3: Result := 'AG. ENVIO - PEÇAS FALTANTES';
      4: Result := 'ENVIADO - AG. CLIENTE';
      5: Result := 'ORÇAMENTO INTERROMPIDO';
      6: Result := 'AG. ARMAZENAMENTO';
      7: Result := 'REPROVAÇÃO CANCELADA';
      8: Result := 'EQUIPAMENTO RETIRADO';
      9: Result := 'AG. MANUTENÇÃO';
      10:Result := 'MANUTENÇÃO INTERROMPIDA';
      11:Result := 'AG. FATURAMENTO';
      12:Result := 'AG. RETIRADA DO EQUIPAMENTO';
      13:Result := 'OS BAIXADA - DESISTÊNCIA';
      14:Result := 'OS NÃO FATURADA';
    end;
  end;
end;

function fRetornaSiglaSituacaoOS(ADescricao: String; var ATipSit: String): String;
const
  LFase: Array[0..5] Of String = ('OS ABERTA', 'ANÁLISE TÉCNICA', 'ORÇAMENTO', 'MANUTENÇÃO', 'OS FINALIZADA', 'FATURAMENTO');
  LSituacao: Array[0..12] Of String = ('OS INCLUÍDA', 'ANÁLISE TÉCNICA CONCLUÍDA', 'ANÁLISE TÉCNICA EM ANDAMENTO',
    'ORÇAMENTO REALIZADO', 'ORÇAMENTO APROVADO', 'ORÇAMENTO REPROVADO', 'EM MANUTENÇÃO', 'AG. PEÇAS', 'MANUTENÇÃO FINALIZADA',
    'ARMAZENADA', 'FATURADO', 'AG. FATURAMENTO', 'AG. SEPARAÇÃO');
  LComplemento: Array[0..14] Of String = ('AG. ANÁLISE TÉCNICA', 'AG. ORÇAMENTO', 'AG. ENVIO', 'AG. ENVIO - PEÇAS FALTANTES',
    'ENVIADO - AG. CLIENTE', 'ORÇAMENTO INTERROMPIDO', 'AG. ARMAZENAMENTO', 'REPROVAÇÃO CANCELADA', 'EQUIPAMENTO RETIRADO',
    'AG. MANUTENÇÃO', 'MANUTENÇÃO INTERROMPIDA', 'AG. FATURAMENTO', 'AG. RETIRADA DO EQUIPAMENTO', 'OS BAIXADA - DESISTÊNCIA',
    'OS NÃO FATURADA');
begin
  Result := '';

  case AnsiIndexStr(AnsiUpperCase(ADescricao), LFase) of
    0: Result := 'A';
    1: Result := 'T';
    2: Result := 'O';
    3: Result := 'M';
    4: Result := 'R';
    5: Result := 'F';
  else
    case AnsiIndexStr(AnsiUpperCase(ADescricao), LSituacao) of
      0: Result := 'OI';
      1: Result := 'TC';
      2: Result := 'TA';
      3: Result := 'OR';
      4: Result := 'OA';
      5: Result := 'ON';
      6: Result := 'EM';
      7: Result := 'AP';
      8: Result := 'MF';
      9: Result := 'AR';
      10: Result := 'FA';
      11: Result := 'AF';
      12: Result := 'AS';
    else
      case AnsiIndexStr(AnsiUpperCase(ADescricao), LComplemento) of
        0: Result := 'AT';
        1: Result := 'AO';
        2: Result := 'AE';
        3: Result := 'PF';
        4: Result := 'AC';
        5: Result := 'OI';
        6: Result := 'AA';
        7: Result := 'RC';
        8: Result := 'ER';
        9: Result := 'AM';
        10:Result := 'MI';
        11:Result := 'AF';
        12:Result := 'AR';
        13:Result := 'OB';
        14:Result := 'NF';
      end;
    end;
  end;

  if (MatchStr(AnsiUpperCase(ADescricao), LFase)) then
    ATipSit := 'F'
  else if (MatchStr(AnsiUpperCase(ADescricao), LSituacao)) then
    ATipSit := 'S'
  else if (MatchStr(AnsiUpperCase(ADescricao), LComplemento)) then
    ATipSit := 'C';
end;

