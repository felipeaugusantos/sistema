function fVerificaLiberacao(strNumLib: String; var strOpeLib: String) : Boolean;
  Var
    strSQL   : String;
    qryLogVar: TUniQuery;
begin
  Result := False;
  strSQL := '';
  strSQL := strSQL + ' SELECT                         ';
  strSQL := strSQL + '   LOG_OPELIB                   ';
  strSQL := strSQL + ' FROM                           ';
  strSQL := strSQL + '   LOGVAR                       ';
  strSQL := strSQL + ' WHERE                          ';
  strSQL := strSQL + '   LOG_NROLIB = :NROLIB AND     ';
  strSQL := strSQL + '   LOG_OPELIB IS NOT NULL AND   ';
  strSQL := strSQL + '   LOG_OPELIB <> ""             ';
  qryLogVar := fCriaQuery;
  With qryLogVar Do
  Begin
    Close;
    SQL.Text := strSQL;
    ParamByName('NROLIB').AsString := strNumLib;
    Open;
    If Not IsEmpty Then
    Begin
      Result := True;
      strOpeLib := FieldByName('LOG_OPELIB').AsString;
    End;
  End;
  FreeAndNil(qryLogVar);
end;

