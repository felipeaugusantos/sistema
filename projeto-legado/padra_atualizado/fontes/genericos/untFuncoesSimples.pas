function fProcessIDExiste(const AProcessID: DWORD): Boolean;
  var
    hSnapShot: THandle;
    ProcessEntry: TProcessEntry32;
begin
  Result := False;
  hSnapShot := CreateToolhelp32Snapshot((TH32CS_SNAPALL), 0);
  ProcessEntry.dwSize := SizeOf(TProcessEntry32);
  Process32First(hSnapShot, ProcessEntry);
  repeat
    if ProcessEntry.th32ProcessID = AProcessID then
    begin
      Result := True;
      Break;
    end;
  until Process32Next(hSnapShot, ProcessEntry) = false;

  CloseHandle(hSnapShot);
end;

function fLimparLockTEFInativo : Boolean;
  var
    qryLogAce : TUniQuery;
    qryConId : TUniQuery;
    strIdTrava : String;
    strChaveLock : String;
begin
  Result := False;

  strChaveLock := fGetMD5TefModular;

  strIdTrava := fGetIdUsedLock(strChaveLock);

  if fEmptyStr(strIdTrava) then
	  exit;

  if not fCampoExiste('LOGACE', 'LOG_PROCID', True) then
    exit;

  qryLogAce := fCriaQuery;
  qryConId := fCriaQuery;
  try
    qryLogAce.Close;
    qryLogAce.SQL.Clear;
    qryLogAce.SQL.Add(' SELECT  ');
    qryLogAce.SQL.Add('   LOG_PROCID, ');
    qryLogAce.SQL.Add('   LOG_CON_ID ');
    qryLogAce.SQL.Add(' FROM  ');
    qryLogAce.SQL.Add('   LOGACE  ');
    qryLogAce.SQL.Add( ' WHERE LOG_DTAENT BETWEEN DATE_SUB(CURRENT_DATE, INTERVAL 7 DAY) AND CURRENT_DATE ');
    qryLogAce.SQL.Add('    AND LOG_NOMUSU = :NOMUSU ');
    qryLogAce.SQL.Add('    AND LOG_MACADD = :MACADD ');
    qryLogAce.SQL.Add('    AND LOG_NOMMAQ = :NOMMAQ ');
    qryLogAce.SQL.Add('    AND LOG_NUM_IP = :NUM_IP ');
    qryLogAce.ParamByName('NOMUSU').AsString := VS_UserFromWindows;
    qryLogAce.ParamByName('MACADD').AsString := VS_MacAddress;
    qryLogAce.ParamByName('NOMMAQ').AsString := VS_ComputerNetName;
    qryLogAce.ParamByName('NUM_IP').AsString := VS_IPAddressAsString;
    qryLogAce.Open;

    if qryLogAce.IsEmpty then
      exit;

    qryConId.Close;
    qryConId.SQL.Text := 'SELECT ID FROM information_schema.PROCESSLIST ORDER BY ID';
    qryConId.Open;

    qryLogAce.First;
    while not qryLogAce.Eof do
    begin
      If (Not qryConId.Locate('ID', qryLogAce.FieldByName('LOG_CON_ID').AsString, [])) Then
      Begin
        qryLogAce.Next;
        Continue;
      End;
      if ( (not fEmptyStr(qryLogAce.FieldByName('LOG_CON_ID').AsString)) and
           (strIdTrava = qryLogAce.FieldByName('LOG_CON_ID').AsString) ) then
      begin
        if not fProcessIDExiste(qryLogAce.FieldByName('LOG_PROCID').AsInteger) then
        begin
          fLiberaTravaBanco(qryLogAce.FieldByName('LOG_CON_ID').AsString) ;
          pKill(StrToInt(qryLogAce.FieldByName('LOG_CON_ID').AsString));
          Result := True;
        end;
      end;
      qryLogAce.Next;
    end;
  finally
    FreeAndNil(qryLogAce);
    FreeAndNil(qryConId);
  end;
end;

