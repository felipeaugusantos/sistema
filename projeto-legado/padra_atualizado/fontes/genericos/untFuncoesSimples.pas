{*************************************************************}
{* FUNÇÃO QUE CALCULA O PRAZO MÉDIO DA CONDIÇÃO DE PAGAMENTO *}
{* LEVANDO EM CONTA A CONFIGURAÇÃO 'CFG_PRZCND' **************}
{*************************************************************}
function CalculaPrazoMedioCondicaoPagamento(ACondicaoPagamento: String = ''; ASomaCondicoes: Integer = 0; AQuantidadeParcela: Integer = 0; ATelaAgrupamento: Boolean = False):Boolean;
var
  APrazoMedio       : Integer;
  ATotalPrazoMedio  : Integer;
begin
  APrazoMedio := fCfgSis('PRZCND', varInteger);

  if (ASomaCondicoes = 0) and (Not fEmptyStr(ACondicaoPagamento)) Then
  begin
    AQuantidadeParcela := StrToInt(Copy(ACondicaoPagamento, 1, 2));
    Delete(ACondicaoPagamento, 1, 2);

    while Length(ACondicaoPagamento) > 0 do
    begin
      ASomaCondicoes := ASomaCondicoes + StrToInt(Copy(ACondicaoPagamento, 1, 3));
      Delete(ACondicaoPagamento, 1, 3);
    end;
  end;

  //ARREDONDAMENTO SEMPRE PRA CIMA
  //EXEMPLO: 101/2 = 50,5
  //COMO A CONFIGURAÇÃO É DE CAMPO INTEIRO, NESSE CASO TEM QUE SER 51
  ATotalPrazoMedio := Ceil(ASomaCondicoes / AQuantidadeParcela);

  if ATotalPrazoMedio > APrazoMedio Then
  begin
    If Not ATelaAgrupamento Then
      fMensagem('ATENÇÃO!','A condição de pagamento não pode ser selecionada, pois o total de dias é maior que o prazo médio configurado!' + #13#10 +
                           'Prazo Médio configurado: '+ IntToStr(APrazoMedio) ,['&OK']);
    VS_blnCalculaPrazoMedioCND := False;
    Result := False;
  end
  else
  Begin
    VS_blnCalculaPrazoMedioCND := True;
    Result := True;
  End;
end;

