function fRetiraEntradaCndPagamento(strCndPag: String): String;
Var
  intQtdPar: Integer;
  strQtdPar: String;
  strPrazos: String;
  blnEntrada: Boolean;
begin
  Result := strCndPag;

  strQtdPar := LeftStr(strCndPag, 2);
  intQtdPar := StrToIntDef(strQtdPar, 0);
  strPrazos := Copy(strCndPag, 3, Length(strCndPag));

  blnEntrada := ( (intQtdPar > 1) And (Copy(strCndPag, 3, 3) = '000') );

  If blnEntrada Then
  Begin
    Delete(strPrazos, 1, 3);
    Result := Trim(fStrZero(intQtdPar-1, 2) + strPrazos);
  End;
end;

