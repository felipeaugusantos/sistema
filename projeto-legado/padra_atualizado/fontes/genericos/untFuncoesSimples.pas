                                  Out fltMedL_L: Double;
                                  Out fltMedL_A: Double;
                                  Out fltEspess: Double):Boolean;
Var
  qryCadLot: TUniQuery;
begin
  Result := False;

  If fItemLoteChapa(strCodIte, strOpcDoc) And
     fLoteChapa(strCodIte, strCodEmp, strNumLot) Then
  Begin
    qryCadLot := fCriaQuery();
    Try
      qryCadLot.SQL.Add('  SELECT                     ');
      qryCadLot.SQL.Add('    LOT_MEDB_L,              ');
      qryCadLot.SQL.Add('    LOT_MEDB_A,              ');
      qryCadLot.SQL.Add('    LOT_MEDL_L,              ');
      qryCadLot.SQL.Add('    LOT_MEDL_A,              ');
      qryCadLot.SQL.Add('    LOT_ESPESS               ');
      qryCadLot.SQL.Add('  FROM                       ');
      qryCadLot.SQL.Add('    CADLOT                   ');
      qryCadLot.SQL.Add('  WHERE                      ');
      qryCadLot.SQL.Add('        LOT_NUMLOT =:NUMLOT  ');
      qryCadLot.SQL.Add('    AND LOT_CODEMP =:CODEMP  ');
      qryCadLot.SQL.Add('    AND LOT_CODITE =:CODITE  ');
      qryCadLot.SQL.Add('    AND LOT_CHAPA_ = "S"     ');

      qryCadLot.ParamByName('NUMLOT').AsString := strNumLot;
      qryCadLot.ParamByName('CODEMP').AsString := strCodEmp;
      qryCadLot.ParamByName('CODITE').AsString := strCodIte;

      qryCadLot.Open;

      If (Not qryCadLot.IsEmpty) Then
      Begin
        fltMedB_L := qryCadLot.FieldByName('LOT_MEDB_L').AsFloat;
        fltMedB_A := qryCadLot.FieldByName('LOT_MEDB_A').AsFloat;
        fltMedL_L := qryCadLot.FieldByName('LOT_MEDL_L').AsFloat;
        fltMedL_A := qryCadLot.FieldByName('LOT_MEDL_A').AsFloat;
        fltEspess := qryCadLot.FieldByName('LOT_ESPESS').AsFloat;

        If (fltMedL_L = 0) Or (fltMedL_A = 0) Then
          fltQtdCha := 0
        Else
          fltQtdCha := fltQtdIte / (fltMedL_L * fltMedL_A);

        Result := True;
      End;
    Finally
      FreeAndNil(qryCadLot);
    End;
  End;
end;

