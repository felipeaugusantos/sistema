procedure pAuditaTagMenu(Menu: TMainMenu);
 Var
   intIdxAux,
   intIdxGer: Integer;  
   SLGerDup,
   SLRepDup,
   SLResDup: TStringList;
   strArqDup: String;

   SLResTag: TStringList;
   strArqTag: String;

   function fRetMenuPelaTag(Item: TMenuItem; intTag: Integer; Var SL: TStringList): String;
     Var
       intIdx: Integer;
   Begin
     Result := '';
     For intIdx := 0 To Item.Count-1 Do
     Begin
       If Item[intIdx].Tag = intTag Then
         SL.Add(Item[intIdx].Caption + ' ' + Item[intIdx].Hint + ' ' + IntToStr(Item[intIdx].Tag));

       If Item[intIdx].Count > 0 Then
         fRetMenuPelaTag(Item[intIdx], intTag, SL);
     End;
   End;

   function pProcessaMenu(Item: TMenuItem): String;
     Var
       intIdx: Integer;
   Begin
     For intIdx := 0 To Item.Count-1 Do
     Begin
       If LeftStr(Item[intIdx].Hint, 2) <> 'vv' Then
       Begin
         If (Item[intIdx].Tag > 99) Then
         Begin
           If (SLGerDup.IndexOf(IntToStr(Item[intIdx].Tag)) <> -1) Then
           Begin
             If (SLRepDup.IndexOf(IntToStr(Item[intIdx].Tag)) = -1) Then
             Begin
               SLRepDup.Add(IntToStr(Item[intIdx].Tag));
             End;
           End;

           SLGerDup.Add(IntToStr(Item[intIdx].Tag));

           If Item[intIdx].Count > 0 Then
             pProcessaMenu(Item[intIdx]);
         End
         Else If (Item[intIdx].Tag = 0) And (Item[intIdx].Count = 0) Then
         Begin
           If (Not Item[intIdx].Hint.IsEmpty) And (Not Assigned(Item[intIdx].OnClick)) Then
             SLResTag.Add(Item[intIdx].Caption + ' ' + Item[intIdx].Hint + ' ' + IntToStr(Item[intIdx].Tag));
         End;
       End;
     End;
   End;    

begin
  SLGerDup := TStringList.Create;
  SLRepDup := TStringList.Create;
  SLResDup := TStringList.Create;
  strArqDup := ExtractFilePath(Application.ExeName) + 'TAGS_DUPL.TXT';
  
  SLResTag := TStringList.Create;
  strArqTag := ExtractFilePath(Application.ExeName) + 'TAGS_TAG0.TXT';

  If FileExists(PChar(strArqDup)) Then
    DeleteFile(PChar(strArqDup));

  If FileExists(PChar(strArqTag)) Then
    DeleteFile(PChar(strArqTag));

  Try
    For intIdxGer := 0 To Menu.Items.Count - 1 Do
    Begin
      pProcessaMenu(Menu.Items[intIdxGer]);
    End;

    For intIdxAux := 0 To SLRepDup.Count - 1 Do
    Begin
      For intIdxGer := 0 To Menu.Items.Count - 1 Do
      Begin
        fRetMenuPelaTag(Menu.Items[intIdxGer], StrToInt(SLRepDup[intIdxAux]), SLResDup);
      End;
    End;
  Finally
    If (SLResDup.Count > 0) Or (SLResTag.Count > 0) Then
    Begin
      TThreadFinalizarAutcomMonitor.Monitorar;

      If (SLResDup.Count > 0) Then
      Begin
        SLResDup.SaveToFile(PChar(strArqDup));
        SLGerDup.Free;
        SLRepDup.Free;
        SLResDup.Free;
        Application.MessageBox('Atenção programador. Há propriedades "Tag" de "Direitos de Acesso" com numeração DUPLICADA!'+#10#13+
                               'Uma lista chamada TAGS_DUPL.TXT foi criada no diretório do excutável com essas Tags. Ajuste, '+
                               'identificado-as com números exclusivos, antes de comitar.','',MB_OK+MB_ICONWARNING);
      End;

      If (SLResTag.Count > 0) Then
      Begin
        SLResTag.SaveToFile(PChar(strArqTag));
        SLResTag.Free;
        Application.MessageBox('Atenção programador. Há propriedades "Tag" de "Direitos de Acesso" com numeração ZERADA!'+#10#13+
                               'Uma lista chamada TAGS_TAG0.TXT foi criada no diretório do excutável com essas Tags. Ajuste, '+
                               'identificado-as com números exclusivos, antes de comitar.','',MB_OK+MB_ICONWARNING);
      End;

      Application.Terminate;
    End
    Else
    Begin
      SLGerDup.Free;
      SLRepDup.Free;
      SLResDup.Free;
      SLResTag.Free;
    End;
  End;
end;

procedure pAuditaHintMenu(Menu: TMainMenu);
 Var
   intIdxAux,
   intIdxGer: Integer;
   SLGerDup,
   SLRepDup,
   SLResDup: TStringList;
   strArqDup: String;

   SLResHint: TStringList;
   strArqHint: String;

   function fRetMenuPeloHint(Item: TMenuItem; AHint: String; Var SL: TStringList): String;
     Var
       intIdx: Integer;
   Begin
     Result := '';
     For intIdx := 0 To Item.Count-1 Do
     Begin
       If Item[intIdx].Hint = AHint Then
         SL.Add(Item[intIdx].Name + ' ' + Item[intIdx].Caption + ' ' + Item[intIdx].Hint);

       If Item[intIdx].Count > 0 Then
         fRetMenuPeloHint(Item[intIdx], AHint, SL);
     End;
   End;

   function pProcessaMenu(Item: TMenuItem): String;
     Var
       intIdx: Integer;
   Begin
     For intIdx := 0 To Item.Count-1 Do
     Begin
       If Item[intIdx].Caption <> '-' Then
       Begin
         If (Item[intIdx].Hint = '') Then
         Begin
           SLResHint.Add(Item[intIdx].Name + ' ' + Item[intIdx].Caption + ' ' + Item[intIdx].Hint);
         End
         Else If (Item[intIdx].Hint <> '-') Then
         Begin
           If SLGerDup.IndexOf(Item[intIdx].Hint) <> -1 Then
             If TMenuItem(SLGerDup.Objects[SLGerDup.IndexOf(Item[intIdx].Hint)]).Name <> Item[intIdx].Name Then
               If SLRepDup.IndexOf(Item[intIdx].Hint) = -1 Then
               SLRepDup.Add(Item[intIdx].Hint);

           SLGerDup.AddObject(Item[intIdx].Hint, Item[intIdx]);

           If Item[intIdx].Count > 0 Then
             pProcessaMenu(Item[intIdx]);
         End;
       End;
     End;
   End;

begin
  SLGerDup := TStringList.Create;
  SLRepDup := TStringList.Create;
  SLResDup := TStringList.Create;
  strArqDup := ExtractFilePath(Application.ExeName) + 'HINTS_DUPL.TXT';

  SLResHint := TStringList.Create;
  strArqHint := ExtractFilePath(Application.ExeName) + 'HINTS_EM_BRANCO.TXT';

  If FileExists(PChar(strArqDup)) Then
    DeleteFile(PChar(strArqDup));

  If FileExists(PChar(strArqHint)) Then
    DeleteFile(PChar(strArqHint));

  Try
    For intIdxGer := 0 To Menu.Items.Count - 1 Do
    Begin
      pProcessaMenu(Menu.Items[intIdxGer]);
    End;

    For intIdxAux := 0 To SLRepDup.Count - 1 Do
    Begin
      For intIdxGer := 0 To Menu.Items.Count - 1 Do
      Begin
        fRetMenuPeloHint(Menu.Items[intIdxGer], SLRepDup[intIdxAux], SLResDup);
      End;
    End;
  Finally
    If (SLResDup.Count > 0) Or (SLResHint.Count > 0) Then
    Begin
      TThreadFinalizarAutcomMonitor.Monitorar;

      If (SLResDup.Count > 0) Then
      Begin
        SLResDup.SaveToFile(PChar(strArqDup));
        SLGerDup.Free;
        SLRepDup.Free;
        SLResDup.Free;
        Application.MessageBox('Atenção programador. Há propriedades "Hint" de "Direitos de Acesso" DUPLICADA!'+#10#13+
                               'Uma lista chamada HINTS_DUPL.TXT foi criada no diretório do excutável com essas Hints. Ajuste, '+
                               'identificado-as com Hints exclusivos, antes de comitar.','',MB_OK+MB_ICONWARNING);
      End;

      If (SLResHint.Count > 0) Then
      Begin
        SLResHint.SaveToFile(PChar(strArqHint));
        SLResHint.Free;
        Application.MessageBox('Atenção programador. Há propriedades "Hint" de "Direitos de Acesso" em branco!'+#10#13+
                               'Uma lista chamada HINTS_EM_BRANCO.TXT foi criada no diretório do excutável com essas Hints. Ajuste, '+
                               'identificado-as com Hints exclusivos, antes de comitar.','',MB_OK+MB_ICONWARNING);
      End;

      Application.Terminate;
    End
    Else
    Begin
      SLGerDup.Free;
      SLRepDup.Free;
      SLResDup.Free;
      SLResHint.Free;
    End;
  End;
end;

Function fStringArrayToStr(arrMsg: TStringArray): String;
  Var
    sltLista: TStringList;
    intContador: Integer;
Begin
  sltLista := TStringList.Create;
  for intContador := Low(arrMsg) to High(arrMsg) do
    sltLista.add(arrMsg[intContador]);
  Result := sltLista.Text;
  FreeAndNil(sltLista);
End;

function fTListStringToStr(const AList : TList<String>; const ASeparator : String) : String;
  Var
    intContador : Integer;
begin
  Result := '';
  For intContador := 0 To Pred(AList.Count) Do
  Begin
    If Result.IsEmpty Then
      Result := AList[intContador]
    Else
      Result := Result + ASeparator + AList[intContador];
  End;
end;

function fArrayToString(arrDados: TStringArray; strSeparador: String = ', '; blnAspas: Boolean = False): String;
  Var
    intContador: Integer;
begin
  Result := '';
  For intContador := 0 To Pred(Length(arrDados)) Do
  Begin
    If Not blnAspas Then
      Result := Result + arrDados[intContador]
    Else
      Result := Result + '"'+arrDados[intContador]+'"';

    If (intContador+1 < Length(arrDados)) Then
      Result := Result + strSeparador;
  End;
end;

