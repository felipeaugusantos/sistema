        qryItens.SQL.Add(' WHERE FGO_NUMDOC = :NUMDOC AND FGO_ESPDOC = :ESPDOC ');
        qryItens.SQL.Add('   AND FGO_CODCLI = :CODCLI AND FGO_CODEMP = :CODEMP ');
        qryItens.ParamByName('NUMDOC').AsString := strNumDoc;
        qryItens.ParamByName('ESPDOC').AsString := strEspDoc;
        qryItens.ParamByName('CODCLI').AsString := strCodCli;
        qryItens.ParamByName('CODEMP').AsString := strCodEmp;
        qryItens.Open();
        strAutoInc := qryItens.FieldByName('AUTOINCREM').AsString;
      End
      Else
        Exit;

      if (fEmptyStr(strAutoInc)) then
        Exit;

      If (Pos('FATGOR', strTabela) > 0) Then
      Begin
        qryMecanicos.Close();
        qryMecanicos.SQL.Clear();
        qryMecanicos.SQL.Add('SELECT REPLACE(IFNULL(GROUP_CONCAT(DISTINCT FGO_CODMEC), ""), ",", " / ") AS CODMEC ');
        qryMecanicos.SQL.Add('FROM MECGOR');
        qryMecanicos.SQL.Add('WHERE FGO_SEQFGO = :AUTOINCREM');
        qryMecanicos.ParamByName('AUTOINCREM').AsString := strAutoInc;
        qryMecanicos.Open;
      end;

      if (not qryMecanicos.Active) or (qryMecanicos.IsEmpty) then
        Exit;

      Result := ' SELECT "'+qryMecanicos.FieldByName('CODMEC').AsString+'" as MESEGO, CAST("'+strAutoInc+'" AS CHAR(20)) as SEQFGO ';

    Except
      on E: Exception do begin
        pMensagensErro(E.Message, '[untFuncoesSimples.fRetornarTodosMecanicosServicos]');
      end;
    end;
  finally
    qryItens.Close;
    FreeAndNil(qryItens);
    FreeAndNil(qryMecanicos);
  end;
end;

