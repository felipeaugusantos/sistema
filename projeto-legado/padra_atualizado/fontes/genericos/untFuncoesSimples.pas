    qryRemessa.ParamByName('ESPDOC').AsString := AEspDoc;
    qryRemessa.ParamByName('EMPDOC').AsString := ACodEmp;
    qryRemessa.Open;

    Result := (Not qryRemessa.IsEmpty) And (qryRemessa.FieldByName('TOT').AsInteger > 0);

