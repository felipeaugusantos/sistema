    strSQL := strSQL + '   AUTOINCREM, ';
    strSQL := strSQL + '   LOG_OPELOG, ';
    strSQL := strSQL + '   LOG_CODEMP, ';
    strSQL := strSQL + '   LOG_CODBCO, ';
    strSQL := strSQL + '   LOG_DESBCO, ';
