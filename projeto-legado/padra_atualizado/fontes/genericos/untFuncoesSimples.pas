function fIDFilaEApiKeyWhatsappValidos(const AstrIDFila: String): Boolean;
var
  qryCadFil: TUniQuery;
begin
  qryCadFil := fCriaQuery;
  try
    qryCadFil.Close;
    qryCadFil.SQL.Text :=
