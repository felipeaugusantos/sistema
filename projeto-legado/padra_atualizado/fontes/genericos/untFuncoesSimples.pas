  Result := True;
end;

function fExistemItensSeparadosLocTransitoriaVAGAO(const ASeqGer: String): Boolean;
var
  LQry: TUniQuery;
begin
  Result := False;

  if not fGuardarItensSeparadosQuandoUtilizarLocTransitoriaVAGAO then
    Exit;

  LQry := fCriaQuery;

  try
    LQry.SQL.Add('SELECT LOTDOR.AUTOINCREM ');
    LQry.SQL.Add('FROM LOTDOR ');
    LQry.SQL.Add('INNER JOIN FATDOR ON LDO_SEQFDO = FATDOR.AUTOINCREM ');
    LQry.SQL.Add('INNER JOIN EXTGOR ON FDO_SEQGER = FGO_SEQFGO ');
    LQry.SQL.Add('WHERE FDO_SEQGER = :SEQGER ');
    LQry.SQL.Add('  AND LEFT(LDO_NUMLOT, 1) IN ("' + fCfgSis('LTTASE', varString) + '") ');
    LQry.SQL.Add('  AND EXISTS (SELECT LOT_NUMLOT ');
    LQry.SQL.Add('              FROM CADLOT ');
    LQry.SQL.Add('              WHERE LDO_NUMLOT = LOT_NUMLOT ');
    LQry.SQL.Add('                AND FDO_CODITE = LOT_CODITE ');
    LQry.SQL.Add('                AND LOT_CODEMP = IFNULL(FGO_EMP_CD, IFNULL(FDO_EMPITE, FDO_CODEMP)) ');
    LQry.SQL.Add('                AND LOT_TRANSI = "S") ');
    LQry.ParamByName('SEQGER').AsString := ASeqGer;
    LQry.Open;

    Result := (not LQry.IsEmpty);
  finally
    FreeAndNil(LQry);
  end;
end;

function fPedOrigemPossuiNumpokPreenchido(Const strIncDet: String): Boolean;
var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery;
  Try
    qryAux.SQL.Add('SELECT FGO_NUMPOK');
    qryAux.SQL.Add('FROM MOVDET M');
    qryAux.SQL.Add('JOIN FATGOR ON FGO_NUMDOC = DET_NUM_PD');
    qryAux.SQL.Add('           AND FGO_ESPDOC = DET_ESP_PD');
    qryAux.SQL.Add('           AND FGO_CODEMP = DET_EMP_PD');
    qryAux.SQL.Add('WHERE M.AUTOINCREM = :AUTINC');

    qryAux.ParamByName('AUTINC').AsString := strIncDet;
    qryAux.Open;

    If qryAux.IsEmpty Then
    Begin
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT FGO_NUMPOK');
      qryAux.SQL.Add('FROM NOTDET N');
      qryAux.SQL.Add('JOIN MOVDET M ON M.DET_NUMFAT = N.DET_NUMDOC');
      qryAux.SQL.Add('             AND M.DET_TIPFAT = N.DET_ESPDOC');
      qryAux.SQL.Add('             AND M.DET_EMPFAT = N.DET_CODEMP');
      qryAux.SQL.Add('             AND M.DET_CLIFAT = N.DET_CODCLI');
      qryAux.SQL.Add('             AND M.DET_TIP_FC = N.DET_TIP_FC');
      qryAux.SQL.Add('             AND M.DET_CODITE = N.DET_CODITE');
      qryAux.SQL.Add('JOIN FATGOR F ON F.FGO_NUMDOC = M.DET_NUM_PD');
      qryAux.SQL.Add('             AND F.FGO_ESPDOC = M.DET_ESP_PD');
      qryAux.SQL.Add('             AND F.FGO_CODEMP = M.DET_EMP_PD');
      qryAux.SQL.Add('WHERE N.AUTOINCREM = :AUTINC');

      qryAux.ParamByName('AUTINC').AsString := strIncDet;
      qryAux.Open;
    End;

    Result := Not fEmptyStr(qryAux.FieldByName('FGO_NUMPOK').AsString);
  Finally
    FreeAndNil(qryAux);
  End;
end;

function fDocumentoFiscalExiste(const strNumDoc, strEspDoc, strCodEmp, strForCli, strTip_FC, strSerie, strOriDoc : String) : Boolean;
  Var
    qryDoc : TUniQuery;
begin
  qryDoc := fCriaQuery;
  Try
    qryDoc.Close;
    qryDoc.SQL.Add(' SELECT FIS_NUMDOC ');
    qryDoc.SQL.Add('   FROM CADFIS ');
    qryDoc.SQL.Add('  WHERE FIS_NUMDOC = :NUMDOC ');
    qryDoc.SQL.Add('    AND FIS_ESPDOC = :ESPDOC ');
    qryDoc.SQL.Add('    AND FIS_CODEMP = :CODEMP ');
    qryDoc.SQL.Add('    AND FIS_FORCLI = :FORCLI ');
    qryDoc.SQL.Add('    AND FIS_TIP_FC = :TIP_FC ');
    qryDoc.SQL.Add('    AND IFNULL(FIS_SERIE_,"") = :SERIE_ ');
    qryDoc.SQL.Add('    AND IFNULL(FIS_ORIDOC,"") = :ORIDOC ');
    qryDoc.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDoc.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDoc.ParamByName('CODEMP').AsString := strCodEmp;
