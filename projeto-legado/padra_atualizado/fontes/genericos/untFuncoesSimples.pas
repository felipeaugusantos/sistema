  qryLock := fCriaQuery(Nil);
  With qryLock Do
  Begin
    SQL.Add('SELECT SQL_NO_CACHE COUNT(0) FROM LCKATC WHERE LCK_NUM_IP = :NUM_IP AND '+
            'LCK_MACADD = :MACADD AND LCK_NOMMAQ = :NOMMAQ AND '+
            'LCK_NOMUSU = :NOMUSU AND LCK_CHAACE LIKE "%.MONITOR_%" ');

    ParamByName('NUM_IP').AsString := VS_IPAddressAsString;
    ParamByName('MACADD').AsString := VS_MacAddress;
    ParamByName('NOMMAQ').AsString := VS_ComputerNetName;
    ParamByName('NOMUSU').AsString := VS_UserFromWindows;

    Open;

    Result := Fields[0].AsInteger;
  End;
  FreeAndNil(qryLock);
End;

function fLock_Unlock(strNomeTabela: String;
                      blnTrava: Boolean;
                      blnLoopTravamento: Boolean = True;
                      blnHourGlass: Boolean = FALSE;
                      strCon_Id: String = '';
                      blnMostraMsgTravamento: Boolean = True;
                      strOrigem: String = '';
                      blnManual: Boolean = False;
                      blnSeForMesmaConexaoNaoTravar: Boolean = False;
                      blnStartTransaction : Boolean = True;
                      blnStartCommit : Boolean = True;
                      blnIgnoraConId: Boolean = False;
                      blnGravarLog: Boolean = True;
                      AUtilizaHoraServidor: Boolean = False): Boolean;
  Var
    blnTravadoPelaMesmaConexao: Boolean;
Begin
  Result := fLock_Unlock(strNomeTabela,
                         blnTrava,
                         blnTravadoPelaMesmaConexao,
                         blnLoopTravamento,
                         blnHourGlass,
                         strCon_Id,
                         blnMostraMsgTravamento,
                         strOrigem,
                         blnManual,
                         blnSeForMesmaConexaoNaoTravar,
                         blnStartTransaction,
                         blnStartCommit,
                         blnIgnoraConId,
                         blnGravarLog,
                         AUtilizaHoraServidor);
End;

function fLock_Unlock(strNomeTabela: String;
                      blnTrava: Boolean;
                      Var blnTravadoPelaMesmaConexao: Boolean;
                      blnLoopTravamento: Boolean = True;
                      blnHourGlass: Boolean = FALSE;
                      strCon_Id: String = '';
                      blnMostraMsgTravamento: Boolean = True;
                      strOrigem: String = '';
                      blnManual: Boolean = False;
                      blnSeForMesmaConexaoNaoTravar: Boolean = False;
                      blnStartTransaction : Boolean = True;
                      blnStartCommit : Boolean = True;
                      blnIgnoraConId: Boolean = False;
                      blnGravarLog: Boolean = True;
                      AUtilizaHoraServidor: Boolean = False): Boolean;
  Var
    strSoNomeTabela,
    strLock: String;
    qryLock_Unlock: TUniQuery;
    blnComitar: Boolean;
    blnGravaLogTransacao: Boolean;

  Const
    TEMPO_ESPERA = 3000;

    procedure pAtualizaContador;
    begin
      qryLock_Unlock.Close;
      qryLock_Unlock.SQL.Clear;
      qryLock_Unlock.SQL.Add('UPDATE LCKATC SET LCK_TENTAT = LCK_TENTAT + 1 WHERE LCK_CHAACE = :CHAACE');
      qryLock_Unlock.ParamByName('CHAACE').AsString := strNomeTabela;
      qryLock_Unlock.ExecSQL;
    end;

    procedure pIncrementaTrava(blnIncrementa: Boolean);
    begin
      qryLock_Unlock.Close;
      qryLock_Unlock.SQL.Clear;
      If blnIncrementa Then
        qryLock_Unlock.SQL.Add('UPDATE LCKATC SET LCK_QTDTRA = LCK_QTDTRA + 1 WHERE LCK_CHAACE = :CHAACE')
      Else
        qryLock_Unlock.SQL.Add('UPDATE LCKATC SET LCK_QTDTRA = LCK_QTDTRA - 1 WHERE LCK_CHAACE = :CHAACE');

      qryLock_Unlock.ParamByName('CHAACE').AsString := strNomeTabela;
      qryLock_Unlock.ExecSQL;
    end;

    function fExecutaLock: Boolean;
    begin

      Result := False;
      If (blnComitar) and blnStartTransaction Then
        fStartTransaction;

      qryLock_Unlock.Close;
      qryLock_Unlock.SQL.Clear;
      qryLock_Unlock.SQL.Add(strLock);
      qryLock_Unlock.ParamByName('CHAACE').AsString := strNomeTabela;

      qryLock_Unlock.ParamByName('DTALCK').AsDate   := VS_Date;

      qryLock_Unlock.ParamByName('HRALCK').AsTime   := fTime();
      If AUtilizaHoraServidor Then
        qryLock_Unlock.ParamByName('HRALCK').AsTime := fRetHoraServidor;

      qryLock_Unlock.ParamByName('CON_ID').AsString := IIF(fEmptyStr(strCon_Id), fGetConnectionID, strCon_Id);
      qryLock_Unlock.ParamByName('NUM_IP').AsString := VS_IPAddressAsString;
      qryLock_Unlock.ParamByName('MACADD').AsString := VS_MacAddress;
      qryLock_Unlock.ParamByName('NOMMAQ').AsString := VS_ComputerNetName;
      qryLock_Unlock.ParamByName('NOMUSU').AsString := VS_UserFromWindows;
      qryLock_Unlock.ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
      qryLock_Unlock.ParamByName('ORIGEM').AsString := strOrigem;
      qryLock_Unlock.ParamByName('QTDTRA').AsInteger:= 1;
      qryLock_Unlock.ParamByName('PROCID').AsString := IntToStr(GetCurrentProcessId);

      Try
        qryLock_Unlock.ExecSQL;
        Result := True;
      Except
        On E: Exception Do
        Begin
          If (Pos('DUPLICADA', UpperCase(E.Message)) > 0) Or
             (Pos('DUPLICATE', UpperCase(E.Message)) > 0) Then
          Begin
            pAtualizaContador;

            If (Not fEmptyStr(strOrigem)) And
               SameText(fRetOrigemLock(strNomeTabela), strOrigem) Then
            Begin
              pIncrementaTrava(True);
              Result := True;
            End;

          End
          Else
            pMensagensErro(E.Message, '[fLock_Unlock]');
        End;
      End;

      If (blnComitar) And blnStartCommit Then
        fCommit;
    end;

    procedure pGravaLogLock;
    begin
      With qryLock_Unlock Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('INSERT INTO LCKATC_LOG (LCK_NUM_IP, LCK_CON_ID, LCK_CHAACE, LCK_CODOPE, LCK_TENTAT, ');
        SQL.Add('  LCK_ORIGEM, LCK_DTALOG, LCK_HRALOG, LCK_TIPLCK, LCK_MACADD, LCK_NOMMAQ, LCK_NOMUSU, LCK_PROCID) ');
        SQL.Add('VALUES (:NUM_IP, :CON_ID, :CHAACE, :CODOPE, :QTDTRA, :ORIGEM, ');
        SQL.Add('        :DTALOG, :HRALOG, :SIGLA, :MACADD, :NOMMAQ, :NOMUSU, :PROCID) ');
        ParamByName('CHAACE').AsString := strNomeTabela;
        ParamByName('DTALOG').AsDate   := VS_Date;
        ParamByName('HRALOG').AsTime   := fRetHoraServidor;
        ParamByName('CON_ID').AsString := IIF(fEmptyStr(strCon_Id), fGetConnectionID, strCon_Id);
        ParamByName('NUM_IP').AsString := GetIPAddressAsString;
        ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
        ParamByName('ORIGEM').AsString := strOrigem;
        ParamByName('SIGLA').AsString  := IIF(blnTrava, 'LCK', IIF(blnManual,'LBM','LBA'));
        ParamByName('MACADD').AsString := VS_MacAddress;
        ParamByName('NOMMAQ').AsString := VS_ComputerNetName;
        ParamByName('NOMUSU').AsString := VS_UserFromWindows;
        ParamByName('QTDTRA').AsInteger:= 1;
        ParamByName('PROCID').AsString := IntToStr(GetCurrentProcessId);
        ExecSQL;
      End;

    end;

    function fGravaLog: Boolean;
    begin
      Result := (Pos('EXECUTE_', strNomeTabela) <= 0) And
                (Pos('PEDIDOS_PREPARACAO_TE-', strNomeTabela) <= 0) And
                (Pos('PEDIDOS_PREPARACAO_TE_', strNomeTabela) <= 0) And
                (Pos('IMPORTACAO-', strNomeTabela) <= 0) And
                (Pos('IMPORTA-FULFILLMENT', strNomeTabela) <= 0) And
                (Pos('FATAUT_', strNomeTabela) <= 0) And
                (Pos('TEST_', strNomeTabela) <= 0) And
                ((Pos('MONITOR_', strNomeTabela) <= 0) Or (strNomeTabela.Contains('MONITOR_RECEBIMENTOS_PIX'))) And
                (Pos('UPDATE_', strNomeTabela) <= 0) And
                (Pos('UPDATE_', strNomeTabela) <= 0) And
                blnGravarLog;
    end;

    procedure DestravaRegistroManualmente;
Begin
      If blnManual Then
      Begin
        qryLock_Unlock.Close;
        qryLock_Unlock.Sql.Clear;
        qryLock_Unlock.Sql.Add('DELETE FROM LCKATC WHERE LCK_CHAACE = :CHAACE');
        qryLock_Unlock.ParamByName('CHAACE').AsString := strNomeTabela;
        qryLock_Unlock.ExecSQL;
      End;
    End;

Begin
  blnTravadoPelaMesmaConexao := False;

  blnGravaLogTransacao := VS_blnGravaLogTransacao;

  Result := True;

  Try
    VS_blnGravaLogTransacao := False;

    If blnHourGlass Then
      Screen.Cursor := crHourGlass;

    strSoNomeTabela := strNomeTabela;

    strNomeTabela := frmModulo.GetCurrentConnection.Database + '.' + strNomeTabela;
    qryLock_Unlock := fCriaQuery(Nil);

    blnComitar := False;
    If (Not frmModulo.GetCurrentConnection.InTransaction) Or
       (frmModulo.GetCurrentConnection.InTransaction And blnStartCommit) And (Not blnStartTransaction) Then
    Begin
      blnComitar := True;
    End;

    If blnTrava Then
    Begin

      strLock := 'INSERT INTO LCKATC (LCK_DTALCK, LCK_HRALCK, LCK_NUM_IP, LCK_CON_ID, LCK_CHAACE, LCK_CODOPE, LCK_ORIGEM, LCK_QTDTRA,LCK_MACADD,LCK_NOMMAQ,LCK_NOMUSU, LCK_PROCID) ' +
                 'VALUES (:DTALCK, :HRALCK, :NUM_IP, :CON_ID, :CHAACE, :CODOPE, :ORIGEM, :QTDTRA,:MACADD,:NOMMAQ,:NOMUSU, :PROCID)';

      While Not fExecutaLock Do
      Begin

        If (Pos('CADREC',strNomeTabela) > 0) Then
          RealizarRemocaoAutomaticaDaLckatc;

        If (Not blnLoopTravamento) Then
        Begin
          Result := False;
          Break;
        End;

        If blnMostraMsgTravamento Then
        Begin
          pWaitWindow( Application.MainForm,
                       'O arquivo ' + strNomeTabela + ' está sendo ' +
                       'utilizado no momento.' + #13#10 +
                       'Aguarde Liberação!' );
        End;

        Sleep(TEMPO_ESPERA);
        pProcessMessages;
      End;

      If Result And fGravaLog Then
        pGravaLogLock;

      qryLock_Unlock.Close;

    End
    Else
    Begin

      If fEmptyStr(strOrigem) Then
      Begin
        If blnIgnoraConId Then
          strLock := 'DELETE FROM LCKATC WHERE LCK_CHAACE = :CHAACE'
        Else
          strLock := 'DELETE FROM LCKATC WHERE LCK_CHAACE = :CHAACE AND LCK_CON_ID = :CON_ID';
      End
      Else
      Begin
        pIncrementaTrava(False);
        strLock := 'DELETE FROM LCKATC WHERE LCK_CHAACE = :CHAACE AND LCK_QTDTRA <= 0';
      End;


      If fGravaLog Then
        pGravaLogLock;

      qryLock_Unlock.Close;
      qryLock_Unlock.SQL.Clear;
      qryLock_Unlock.SQL.Add(strLock);
      qryLock_Unlock.ParamByName('CHAACE').AsString := strNomeTabela;

      If fEmptyStr(strOrigem) And (Not blnIgnoraConId) Then
        qryLock_Unlock.ParamByName('CON_ID').AsString := IIF(fEmptyStr(strCon_Id), fGetConnectionID, strCon_Id);

      qryLock_Unlock.ExecSQL;

      If qryLock_Unlock.RowsAffected = 0 Then
        DestravaRegistroManualmente;

      qryLock_Unlock.Close;

    End;

    FreeAndNil(qryLock_Unlock);

    If blnHourGlass Then
      Screen.Cursor := crDefault;

  Finally
    VS_blnGravaLogTransacao := blnGravaLogTransacao;

    If blnSeForMesmaConexaoNaoTravar And (Not Result) And
       (fGetHostLock(strSoNomeTabela, False {blnSohIP}, True {blnLike}, True {blnCon_ID}) = fGetConnectionID) Then
    Begin
      blnTravadoPelaMesmaConexao := True;

      Result := True;
    End;

  End;

End;

function fGetHostLock(strNomeTabela: String; blnSohIP: Boolean = False;
  blnLike: Boolean = True; blnCon_ID: Boolean = False): String;
Var
  qryGen: TUniQuery;
  strSQL: String;
  strOperador: string;
Begin
  Result := '';
  strNomeTabela := frmModulo.GetCurrentConnection.Database + '.' + strNomeTabela;

  If (Pos('CADREC',strNomeTabela) > 0) Then
    RealizarRemocaoAutomaticaDaLckatc;

  qryGen := fCriaQuery;
  try
    strOperador := IIF(blnLike And strNomeTabela.Contains('%'), 'LIKE', '=');
  strSQL := strSQL + '';
  strSQL := strSQL + 'SELECT ';

  If blnCon_ID Then
    strSQL := strSQL + '  LCK_CON_ID, ';

  If blnSohIP Then
    strSQL := strSQL + '  LCK_NUM_IP '
  Else
      strSQL := strSQL + '  CONCAT(LCK_NUM_IP, " - ", " Operador: ", ' +
        'LCK_CODOPE, "-", OPE_NOMOPE) AS LCK_NUM_IP ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  LCKATC';
  strSQL := strSQL + '  LEFT JOIN CADOPE ON OPE_CODOPE = LCK_CODOPE ';
  strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  LCK_CHAACE ' + strOperador + ' :CHAACE ';
  qryGen.SQL.Text := strSQL;
  qryGen.ParamByName('CHAACE').AsString := strNomeTabela;
  qryGen.Open;

  If blnCon_ID Then
    Result := qryGen.FieldByName('LCK_CON_ID').AsString
  Else
    Result := qryGen.FieldByName('LCK_NUM_IP').AsString;

  qryGen.Close;
  finally
  FreeAndNil(qryGen);
  end;
End;

function fGetPID(strNomeTabela: String): String;
Var
  qryGen: TUniQuery;
Begin
  Result := '';

 {$IFDEF LINUX}
  strNomeTabela := objConnectionsManager.CurrentConnection.Database + '.' + strNomeTabela;
 {$ELSE}
  strNomeTabela := frmModulo.GetCurrentConnection.Database + '.' + strNomeTabela;
 {$ENDIF}

  qryGen := fCriaQuery;
  try
    qryGen.SQL.Text := ' SELECT '+
                       '   LCK_PROCID '+
                       ' FROM '+
                       '   LCKATC '+
                       ' WHERE '+
                       '   LCK_CHAACE = :CHAACE ';
    qryGen.ParamByName('CHAACE').AsString := strNomeTabela;
    qryGen.Open;

    Result := qryGen.FieldByName('LCK_PROCID').AsString;
  finally
    FreeAndNil(qryGen);
  end;
end;

function fLckAtcEhDoMesmoPID(strNomeTabela: String): Boolean;
begin
  Result := (fGetPID(strNomeTabela) = IntToStr(GetCurrentProcessId));
end;

procedure pGravaLogLck(strNum_IP, strCon_ID, strChaAce, strCodOpe: String; intTentat: Integer; dtaDtaLck, dtaHraLck: TDateTime);
  Var
    qryLogLck : TUniQuery;
    strSQL    : String;
begin
  qryLogLck := fCriaQuery(Nil);
  Try
    Try
      strSQL := '';
      strSQL := strSQL + ' REPLACE ';
      strSQL := strSQL + '   INTO LOGLCK ( ';
      strSQL := strSQL + '     LCK_NUM_IP, ';
      strSQL := strSQL + '     LCK_CON_ID, ';
      strSQL := strSQL + '     LCK_CHAACE, ';
      strSQL := strSQL + '     LCK_CODOPE, ';
      strSQL := strSQL + '     LCK_TENTAT, ';
      strSQL := strSQL + '     LCK_DTALCK, ';
      strSQL := strSQL + '     LCK_HRALCK, ';
      strSQL := strSQL + '     LCK_DTALIB, ';
      strSQL := strSQL + '     LCK_HORLIB, ';
      strSQL := strSQL + '     LCK_OPELIB) ';
      strSQL := strSQL + ' VALUES ( ';
      strSQL := strSQL + '     :NUM_IP, ';
      strSQL := strSQL + '     :CON_ID, ';
      strSQL := strSQL + '     :CHAACE, ';
      strSQL := strSQL + '     :CODOPE, ';
      strSQL := strSQL + '     :TENTAT, ';
      strSQL := strSQL + '     :DTALCK, ';
      strSQL := strSQL + '     :HRALCK, ';
      strSQL := strSQL + '     :DTALIB, ';
      strSQL := strSQL + '     :HORLIB, ';
      strSQL := strSQL + '     :OPELIB) ';

      With qryLogLck Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUM_IP').AsString  := strNum_IP;
        ParamByName('CON_ID').AsString  := strCon_ID;
        ParamByName('CHAACE').AsString  := strChaAce;
        ParamByName('CODOPE').AsString  := strCodOpe;
        ParamByName('TENTAT').AsInteger := intTentat;
        ParamByName('DTALCK').AsDateTime:= dtaDtaLck;
        ParamByName('HRALCK').AsDateTime:= dtaHraLck;
        ParamByName('DTALIB').AsDateTime:= VS_Date;
        ParamByName('HORLIB').AsDateTime:= fTime();
        ParamByName('OPELIB').AsString  := strLoginUsuarioLogado;
        ExecSQL;
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro('Erro ao gravar LOGLCK', 'pGravaLogLck', E.Message);
      End;
    End;
  Finally
    FreeAndNil(qryLogLck);
  End;
end;

function fTempoExecucaoExcedido: Boolean;
begin
  Result := False;
  If Not fEmptyStr(ParamStr(1)) Then
  Begin
    If Pos(ParamStr(1), PARAM_EXEC_SFAMOB) > 0 Then
      Result := (MinutesBetween(Date + fTime(True), VS_dtaHraInicializacao) >= LIMIT_TEMP_SFAMOB)
    Else If Pos(ParamStr(1), PARAM_EXEC_MOVMER) > 0 Then
      Result := (MinutesBetween(Date + fTime(True), VS_dtaHraInicializacao) >= LIMIT_TEMP_MOVMER)
  End;
end;

function fImportadorExcutando(strCHAVE: String): Boolean;
begin
  Result := (Not fEmptyStr(fGetHostLock(strCHAVE)));
end;

function fWinExec(ACommandLine: string; AWorkingDirectory: string): string;
var
  SecurityAttributes: TSecurityAttributes;
  StartupInfo: TStartupInfo;
  ProcessInformation: TProcessInformation;
  StdOutPipeRead, StdOutPipeWrite: THandle;
  WasOK: Boolean;
  Buffer: array [0 .. 255] of AnsiChar;
  BytesRead: Cardinal;
  Handle: Boolean;
begin
  Result := EmptyStr;
  SecurityAttributes.nLength := SizeOf(TSecurityAttributes);
  SecurityAttributes.bInheritHandle := True;
  SecurityAttributes.lpSecurityDescriptor := nil;
  CreatePipe(StdOutPipeRead, StdOutPipeWrite, @SecurityAttributes, 0);
  try
    FillChar(StartupInfo, SizeOf(TStartupInfo), 0);
    StartupInfo.cb := SizeOf(TStartupInfo);
    StartupInfo.dwFlags := STARTF_USESHOWWINDOW or STARTF_USESTDHANDLES;
    StartupInfo.wShowWindow := SW_HIDE;
    StartupInfo.hStdInput := StdOutPipeRead;
    StartupInfo.hStdOutput := StdOutPipeWrite;
    StartupInfo.hStdError := StdOutPipeWrite;
    FillChar(ProcessInformation, SizeOf(ProcessInformation), 0);
    Handle := CreateProcess(nil, PChar(ACommandLine), nil, nil, True, 0, nil,
      PChar(AWorkingDirectory), StartupInfo, ProcessInformation);
    CloseHandle(StdOutPipeWrite);
    if Handle then
      try
        repeat
          WasOK := ReadFile(StdOutPipeRead, Buffer, 255, BytesRead, nil);
          if BytesRead > 0 then
          begin
            Buffer[BytesRead] := #0;
            Result := Result + String(Buffer);
          end;
        until not WasOK or (BytesRead = 0);
        WaitForSingleObject(ProcessInformation.hProcess, INFINITE);
      finally
        CloseHandle(ProcessInformation.hThread);
        CloseHandle(ProcessInformation.hProcess);
      end;
  finally
    CloseHandle(StdOutPipeRead);
  end;
end;

procedure ForceKill(AProcess: Integer); overload;
begin
  WinExec(PAnsiChar(AnsiString('taskkill /F /PID ' + AProcess.ToString)), SW_HIDE);
end;

function KillProcess(pid: cardinal; AForceKill: Boolean = True): Boolean;
var
  killer: THandle;
begin
  pLog('KillProcess ' + pid.ToString);
  killer := OpenProcess(PROCESS_TERMINATE, False, pid);
  Result := TerminateProcess(killer, 0);
  if not Result and AForceKill Then
    ForceKill(pid);
end;

function KillProcess(AImage: String): Boolean;
var
  LImage: string;
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  Result := False;
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  try
    FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
    ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);
    while Integer(ContinueLoop) <> 0 do
    begin
      LImage := FProcessEntry32.szExeFile;
      try
        if not String(LImage).ToLower.Equals(AImage.ToLower) then
          if not ExtractFileName(LImage).ToLower.Equals(AImage.ToLower) then
            Continue;
        KillProcess(FProcessEntry32.th32ProcessID);
        Result := True;
      finally
        ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
      end;
    end;
  finally
    CloseHandle(FSnapshotHandle);
  end;
end;

function KillProcessStartsWith(AImage: String): Boolean;
var
  LImage: string;
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  Result := False;
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  try
    FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
    ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);
    while Integer(ContinueLoop) <> 0 do
    begin
      LImage := FProcessEntry32.szExeFile;
      try
        if not String(LImage).ToLower.StartsWith(AImage.ToLower) then
          if not ExtractFileName(LImage).ToLower.StartsWith(AImage.ToLower) then
            Continue;
        KillProcess(FProcessEntry32.th32ProcessID);
        Result := True;
      finally
        ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
      end;
    end;
  finally
    CloseHandle(FSnapshotHandle);
  end;
end;

function StartProcess(Exename: String; CmdLineArgs: String = ''; ShowWindow: Boolean = False;
    WaitForFinish: Boolean = False): integer;
var
    StartInfo: TStartupInfo;
    ProcInfo: TProcessInformation;
    CreateOK: boolean;
begin
    // Simple wrapper for the CreateProcess command
    // returns the process id of the started process.
    FillChar(StartInfo, SizeOf(TStartupInfo), #0);
    FillChar(ProcInfo, SizeOf(TProcessInformation), #0);
    StartInfo.cb := SizeOf(TStartupInfo);

    If Not ShowWindow Then
    begin
      StartInfo.dwFlags := STARTF_USESHOWWINDOW;
      StartInfo.wShowWindow := SW_HIDE;
    end;
    pLog('StartProcess->'+Exename + ' ' + CmdLineArgs);
    CreateOK := CreateProcess(nil, PChar(Exename + ' ' + CmdLineArgs), nil, nil, False,
      CREATE_NEW_PROCESS_GROUP + NORMAL_PRIORITY_CLASS, nil, nil, StartInfo, ProcInfo);

    Result := ProcInfo.dwProcessId;

    if CreateOK then
    begin
      // may or may not be needed. Usually wait for child processes
      if WaitForFinish then
        WaitForSingleObject(ProcInfo.hProcess, Infinite);
    end
    else
    begin
      // ShowMessage('Unable to run '+ProgramName);
      SysErrorMessage(GetLastError());
    end;

    // close process & thread handles
    CloseHandle(ProcInfo.hProcess);
    CloseHandle(ProcInfo.hThread);
end;


procedure pChamaAutComModoImportacao(strCHAVE, strPARAM: String; intTEMPO_LIMITE: Integer);
  Var
    recUltimoLock: TInfLckAtc;
begin
  If (strCHAVE.IsEmpty) Then
  Begin
    StartProcess(Application.ExeName, strPARAM);
  End
  Else
  Begin
    If (intTEMPO_LIMITE > -1) Then
    Begin
      recUltimoLock := fRetUltimoLock(strCHAVE);

      If (recUltimoLock.dtaDtaHraLck > 0) And (MinutesBetween(fNow(), recUltimoLock.dtaDtaHraLck) >= intTEMPO_LIMITE) Then
      Begin
        pDestravaLockForcado(strCHAVE, 0);
        With recUltimoLock Do
          pGravaLogLck(strNum_IP, strCon_ID, '(*)'+strChaAce, strCodOpe, intTentat, dtaDtaLck, dtaHraLck);
      End;
    End;

    If (Not fImportadorExcutando(strCHAVE)) Then
      StartProcess(Application.ExeName, strPARAM);
  End;
end;

