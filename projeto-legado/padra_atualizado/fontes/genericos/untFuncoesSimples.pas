function fRetornaCdsPortadorAut(intTip : Integer; ACodGru, ACodCfg, ACodEmp : String ): TUniClientDataSet;
Var
    LQryPor  : TUniQuery;
    strSqlEmail,
    strSqlSMS : String;
Begin

  Try

    LQryPor   := fCriaQuery;

    If intTip = 0 Then //email
    Begin
       strSqlEmail := '';
       strSqlEmail := strSqlEmail + ' SELECT PORAEN.AEN_CODPOR FROM EMASAI ';
       strSqlEmail := strSqlEmail + '  INNER JOIN PORAEN  ON EMASAI.EMA_CODGRU = PORAEN.AEN_CODGRU ';
       strSqlEmail := strSqlEmail + '                    AND EMASAI.EMA_CODIGO = PORAEN.AEN_CODCFG ';
       strSqlEmail := strSqlEmail + '                    AND EMASAI.EMA_CODEMP = PORAEN.AEN_CODEMP ';
       strSqlEmail := strSqlEmail + '  WHERE PORAEN.AEN_CODGRU = :CODGRU ';
       strSqlEmail := strSqlEmail + '    AND PORAEN.AEN_CODCFG = :CODCFG ';
       strSqlEmail := strSqlEmail + '    AND PORAEN.AEN_CODEMP = :CODEMP ';
       strSqlEmail := strSqlEmail + '    AND PORAEN.AEN_CODTIP = 0       ';
       strSqlEmail := strSqlEmail + '    AND EMASAI.EMA_STATUS = ''A''   ';

       LQryPor.SQL.Text := strSqlEmail
    End
    Else
    If intTip = 1 Then //sms
    Begin
       strSqlSMS := '';
       strSqlSMS := strSqlSMS + ' SELECT PORAEN.AEN_CODPOR FROM SMSSAI ';
       strSqlSMS := strSqlSMS + '  INNER JOIN PORAEN  ON SMSSAI.SMS_CODGRU = PORAEN.AEN_CODGRU ';
       strSqlSMS := strSqlSMS + '                    AND SMSSAI.SMS_CODIGO = PORAEN.AEN_CODCFG ';
       strSqlSMS := strSqlSMS + '                    AND SMSSAI.SMS_CODEMP = PORAEN.AEN_CODEMP ';
       strSqlSMS := strSqlSMS + ' WHERE PORAEN.AEN_CODGRU    = :CODGRU ';
       strSqlSMS := strSqlSMS + '    AND   PORAEN.AEN_CODCFG = :CODCFG ';
       strSqlSMS := strSqlSMS + '    AND   PORAEN.AEN_CODEMP = :CODEMP ';
       strSqlSMS := strSqlSMS + '    AND   PORAEN.AEN_CODTIP = 1       ';
       strSqlSMS := strSqlSMS + '    AND   SMSSAI.SMS_STATUS = ''A''   ';

       LQryPor.SQL.Text := strSqlSMS;
    End
    Else
    If intTip = 2 Then //whatsapp
    Begin
      strSqlSMS := '';
      strSqlSMS := strSqlSMS + ' SELECT PORAEN.AEN_CODPOR FROM WPPSAI ';
      strSqlSMS := strSqlSMS + '  INNER JOIN PORAEN  ON WPPSAI.WPP_CODGRU = PORAEN.AEN_CODGRU ';
      strSqlSMS := strSqlSMS + '                    AND WPPSAI.WPP_CODIGO = PORAEN.AEN_CODCFG ';
      strSqlSMS := strSqlSMS + '                    AND WPPSAI.WPP_CODEMP = PORAEN.AEN_CODEMP ';
      strSqlSMS := strSqlSMS + ' WHERE PORAEN.AEN_CODGRU    = :CODGRU ';
      strSqlSMS := strSqlSMS + '    AND   PORAEN.AEN_CODCFG = :CODCFG ';
      strSqlSMS := strSqlSMS + '    AND   PORAEN.AEN_CODEMP = :CODEMP ';
      strSqlSMS := strSqlSMS + '    AND   PORAEN.AEN_CODTIP = 2       ';
      strSqlSMS := strSqlSMS + '    AND   WPPSAI.WPP_STATUS = ''A''   ';

      LQryPor.SQL.Text := strSqlSMS;
    End;

    LQryPor.Parambyname('CODGRU').value := ACodGru;
    LQryPor.Parambyname('CODCFG').value := ACodCfg;
    LQryPor.Parambyname('CODEMP').value := ACodEmp;
    LQryPor.Open;

    Result := fCriaClientDatSet(LQryPor);

  Finally
    FreeAndNil(LQryPor);
  End;

End;

function fVerificaTemPortadorAut( intTip : Integer; blnFat : Boolean; strPortador, strCodEmp : String ): Boolean; //0 -Email //1-SMS
  Var
      strCodGru,
      strCodCfg : String;
      cdsPortAutEmail,
      cdsPortAutSms : TUniClientDataSet;
Begin
   Result := True;

   if (intTip = 0) then //Email
   Begin

       strCodGru := '008';
       strCodCfg := '002';

       If blnFat Then
       Begin
          strCodGru := '008';
          strCodCfg := '001';
       End;

       cdsPortAutEmail := fRetornaCdsPortadorAut(0, strCodGru, strCodCfg, strCodEmp);
       cdsPortAutEmail.Open;

       If Not cdsPortAutEmail.IsEmpty Then
       Begin

          If Not cdsPortAutEmail.Locate('AEN_CODPOR', strPortador, []) Then
             Result := False;

       End;

   End
   Else
   if (intTip = 1) then //SMS
   Begin
      // Verifica portadores autorizados para envio de SMS;

      if Not BlnFat then
      Begin

        strCodGru := '008';
        strCodCfg := '001';

        cdsPortAutSms := fRetornaCdsPortadorAut(1, strCodGru, strCodCfg, strCodEmp);
        cdsPortAutSms.Open;

        If Not cdsPortAutSms.IsEmpty Then
        Begin

           If Not cdsPortAutSms.Locate('AEN_CODPOR', strPortador, []) Then
              Result := False;

        End;

      End;

   End
   Else
   If (intTip = 2) then //WHATSAPP
   Begin
     strCodGru := '008';
     strCodCfg := '002';

     If blnFat Then
     Begin
        strCodGru := '008';
        strCodCfg := '001';
     End;

     cdsPortAutEmail := fRetornaCdsPortadorAut(2, strCodGru, strCodCfg, strCodEmp);
     cdsPortAutEmail.Open;

     If Not cdsPortAutEmail.IsEmpty Then
     Begin

        If Not cdsPortAutEmail.Locate('AEN_CODPOR', strPortador, []) Then
           Result := False;

     End;
   End;

End;

function fOSItensNaoReservados(strNumDoc, strEspDoc, strCodEmp, strCodIte: String; Var strNumOs: String; Var stlItens: TStringList): Boolean;
var
  strSQL: String;
  qryAux: TUniQuery;
begin
  Result := False;

  qryAux   := fCriaQuery(Nil);
  strNumOs := '';

  strSQL := '';
  strSQL := strSQL + ' SELECT CONCAT(EQU_NUMOSE, "-", EQU_CODEMP) NUMOSE, CONCAT(FDO_CODITE, " |", FDO_DESCRI) DESITE ';
  strSQL := strSQL + ' FROM EQUGER ';
  strSQL := strSQL + ' INNER JOIN FATDOR ON EQU_NUMPED = FDO_NUMDOC AND EQU_EMPPED = FDO_CODEMP AND EQU_TIPPED = FDO_ESPDOC ';
  strSQL := strSQL + ' INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO ';
  strSQL := strSQL + ' WHERE FDO_RESERV = "N" ';
  strSQL := strSQL + '    AND EQU_NUMPED = :NUMPED ';
  strSQL := strSQL + '    AND EQU_TIPPED = :ESPDOC ';
  strSQL := strSQL + '    AND EQU_EMPPED = :CODEMP ';

  if (not fEmptyStr(strCodIte)) then
    strSQL := strSQL + '    AND FDO_CODITE = :CODITE ';

  try
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('NUMPED').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;

    if (not fEmptyStr(strCodIte)) then
      qryAux.ParamByName('CODITE').AsString := strCodIte;

    qryAux.Open;

    if qryAux.IsEmpty then
      Exit;

    Result := True;
    strNumOs := qryAux.FieldByName('NUMOSE').AsString;

    if Assigned(stlItens) then
    begin
      while not qryAux.Eof do
      begin
        stlItens.Add(qryAux.FieldByName('DESITE').AsString);
        qryAux.Next;
      end;
    end;
  finally
    FreeAndNil(qryAux);
  end;
end;

