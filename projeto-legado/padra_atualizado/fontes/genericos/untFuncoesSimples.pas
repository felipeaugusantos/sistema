function fRetTopoEtiqueta( strTipEti: String ): Integer;
  Var
    strSQL: String;
    qryGenEti : TUniQuery;
begin

  Try

    qryGenEti := fCriaQuery(Nil);

    Result := 0;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CNF_LINTOP ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '  CNFETI ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CNF_TIPETI = :TIPETI AND ';
    strSQL := strSQL + '  CNF_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' ';
    strSQL := strSQL + 'ORDER BY ';
    strSQL := strSQL + '  CNF_IDENTI, CNF_LINIMP ';
    strSQL := strSQL + '  LIMIT 1   ';

    With qryGenEti Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName( 'TIPETI' ).AsString := strTipEti;
      Open;

      If Not IsEmpty Then
        Result := FieldByName( 'CNF_LINTOP' ).AsInteger;

      Close;
    End;

  Finally
    FreeAndNil(qryGenEti);
  End;

End;

