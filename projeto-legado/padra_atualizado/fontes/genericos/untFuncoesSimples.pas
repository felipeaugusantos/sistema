Function fRetClienteConsumidor(strEstado:String = ''): String;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);
  With qryAux, SQL Do
  Begin
    Add('SELECT ');
    Add('  CLI_CODCLI ');
    Add('FROM ');
    Add('  CADCLI INNER JOIN CADCID ON CLI_CODCID = CID_CODCID');
    Add('WHERE ');
    Add('  CLI_NOMCLI LIKE "%CONSUMIDOR%" ');

    If Not fEmptyStr(strEstado) Then
      Add('AND CID_ESTADO = :ESTADO ');

    Add('LIMIT 1 ');

    If Not fEmptyStr(strEstado) Then
      ParamByName('ESTADO').AsString := strEstado;

    Open;

    If IsEmpty Then
      Result := ''
    Else
      Result := FieldByName('CLI_CODCLI').AsString;

    Close;
  End;

  FreeAndNil(qryAux);
End;

function fRetNomRotasRegiao(Const strCodReg: String; blnIntervalo: Boolean = False): String;
  Var
    strSQL   : String;
    qryGenReg: TUniQuery;
begin
  Try

    qryGenReg := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '       REG_DESREG ';
    strSQL := strSQL + '  FROM ROTREG ';
    strSQL := strSQL + ' INNER JOIN CADREG ON REG_CODREG = ROT_CODREG ';
    strSQL := strSQL + ' WHERE ROT_CODREG = :CODREG';

    If blnIntervalo Then
      strSQL := strSQL + ' AND ROT_INTERV > 0 ';

    With qryGenReg Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODREG').AsString := strCodReg;
      Open;

      If Not IsEmpty Then
        Result := FieldByName('REG_DESREG').AsString
      Else
        Result := '';

      Close;
    End;

  Finally
    FreeAndNil(qryGenReg);
  End;
end;

