procedure pCentralizarForm(AForm: TForm);
var
  LMonitor: TMonitor;
  LHandle: HWND;
begin
  if Assigned(Application.MainForm) and IsWindow(Application.MainForm.Handle) then
    LHandle := Application.MainForm.Handle
  else
    LHandle := Application.Handle;

  LMonitor   := TMonitor(Screen.MonitorFromWindow(LHandle));
  AForm.Left := LMonitor.Left + Round(LMonitor.WorkareaRect.Width / 2) - Round(AForm.Width / 2);
  AForm.Top  := Round(LMonitor.WorkareaRect.Height / 2) - Round(AForm.Height / 2);
End;

function fTravaMovDetMenor(strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
var
  qryAux : TUniQuery;
  strSQL : String;
  fltTotGER,
  fltTotDET,
  fltTotDif : Double;
begin
  qryAux := fCriaQuery;
  Try
    Try
      With qryAux Do
      Begin
        strSQL := '';
        strSQL := strSQL + 'SELECT   ';
        strSQL := strSQL + '  (IFNULL(GER_TOTPRO, 0) + IFNULL(GER_TOTSER, 0)) AS TOTAL, ';
        strSQL := strSQL + '  SUM(IF(LEFT(DET_CLAFIS,1) < 5, - DET_TOTITE, DET_TOTITE)) AS DET_TOTITE ';
        strSQL := strSQL + 'FROM MOVGER ';
        strSQL := strSQL + 'INNER JOIN MOVDET ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
        strSQL := strSQL + 'INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
        strSQL := strSQL + 'INNER JOIN CADITE ON CADITE.ITE_CODITE = MOVDET.DET_CODITE ';
        strSQL := strSQL + 'INNER JOIN ITEGER ON ITEGER.ITE_CODITE = CADITE.ITE_CODITE AND ITEGER.ITE_CODEMP = MOVDET.DET_CODEMP ';
        strSQL := strSQL + 'INNER JOIN CADMAR ON CADMAR.MAR_CODMAR = CADITE.ITE_CODMAR ';
        strSQL := strSQL + 'WHERE DET_NUMDOC  = :NUMDOC ';
        strSQL := strSQL + '  AND DET_ESPDOC  = :ESPDOC ';
        strSQL := strSQL + '  AND DET_CODEMP  = :CODEMP ';
        strSQL := strSQL + '  AND DET_CODCLI  = :CODCLI ';
        strSQL := strSQL + '  AND DET_CODITE <> :ITESER ';
        strSQL := strSQL + '  AND DET_CODITE <> :SERTER ';

        if fCfgSis('EFTEST') = '2' then
        begin
          strSQL := strSQL + ' AND IF(DET_ENTFUT = "S", IFNULL(DET_PROEMB,"N") <> "S", TRUE)  ';
        end ;

        strSQL := strSQL + 'GROUP BY MOVGER.AUTOINCREM ';

        strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(strSQL,'MOVGER','NOTGER'),'MOVDET','NOTDET'),'MOVTRI','NOTTRI');

        Sql.Text := strSQL ;

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('ITESER').AsString := fCfgSis('ITESER', varString);
        ParamByName('SERTER').AsString := fCfgSis('SERTER', varString);

        Open;

        fltTotGER := Abs(fFormataFloat(FieldByName('TOTAL').AsFloat, 2));
        fltTotDET := Abs(fFormataFloat(FieldByName('DET_TOTITE').AsFloat, 2));

        fltTotDif := Abs(fltTotGER - fltTotDET);

        If (fStrToFloat(FormatFloat('#,##0.00', fltTotDif)) > fStrToFloat('0,05')) Then
          Result := True
        Else
          Result := False;

      End;

    Except
      On E: Exception Do
      Begin
        Result := True;
        pMensagensErro(E.Message, '[fTravaMovDetMenor]');
      End;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

