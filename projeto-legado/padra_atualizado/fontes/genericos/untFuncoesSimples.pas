function fTrataAnoDataMesAno(strData: String): String;
{*********************************************************************}
{* Função que trata o ano de campos de data,                       ***}
{* acrescentando os dígitos que faltam até completar 4 dígitos     ***}
{* Válido para campos no formato MM/AAAA                           ***}
{*******************************************************************KM}
Var
  LstrAno: String;
  LstrMes: String;
begin
  If (RightStr(strData, 4) <> '') Then
  Begin
    LstrMes := Trim(LeftStr(strData, 2));
    LstrAno := Trim(RightStr(strData, 4));

    If Length(LstrAno) = 1 Then
      Result := LstrMes + '/200' + LstrAno
    Else If Length(LstrAno) = 2 Then
      Result := LstrMes + '/20' + LstrAno
    Else If Length(LstrAno) = 3 Then
      Result := LstrMes + '/2' + LstrAno
    Else
      Result := strData;
  End;
end;

