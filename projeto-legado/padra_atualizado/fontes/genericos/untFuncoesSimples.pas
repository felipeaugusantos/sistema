    strSQL := strSQL + '   LOG_HORLOG  ';
    strSQL := strSQL + ' FROM          ';
    strSQL := strSQL + '   LOGATB      ';
    strSQL := strSQL + ' WHERE FALSE   ';

    With qryLogAtb Do
    Begin
      Close;
      SQL.Clear;
