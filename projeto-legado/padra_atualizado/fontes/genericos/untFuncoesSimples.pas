procedure ApagaArquivosDiretorio(strPath: String);
Var
  S : TSearchRec;
begin
  try
    FindFirst(strPath +'\*.*', faAnyFile, S);
  repeat
    DeleteFile(Pchar(strPath +'\' + S.name));
  until FindNext(S) <> 0;
  finally
    //FindClose(S);
  end;
end;

function fFormataFoneSQL(strCampo: String; strApelido: String = ''; blnAddApelido: Boolean = True): String;
begin
  Result := '';
  Result := Result + ' IF(' + strCampo + '='''', '''', CONCAT("(",';
  Result := Result + ' SUBSTRING(' + strCampo + ', 1, 2), ") ",';
  Result := Result + ' SUBSTRING(' + strCampo + ', 3, 5), "-",';
  Result := Result + ' SUBSTRING(' + strCampo + ', 8, 4)))';
  If blnAddApelido Then
    Result := Result + ' AS ' + IIF(fEmptyStr(strApelido), strCampo, strApelido);
end;

function fFormataCondPagSQL(strCampo: String; strApelido: String = ''; blnAddApelido: Boolean = True): String;
Begin
  Result := '';
  Result := Result + ' (IF(' + strCampo + ' = "", "",CONCAT( "(", SUBSTRING(' + strCampo + ',  1, 2), ")", SUBSTRING(' + strCampo + ',  3, 3), ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ',  6, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',   6, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ',  9, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',   9, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 12, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  12, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 15, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  15, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 18, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  18, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 21, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  21, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 24, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  24, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 27, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  27, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 30, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  30, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 33, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  33, 3))),  ';
  Result := Result + ' IF(SUBSTRING(' + strCampo + ', 36, 3) = "", "", CONCAT("." ,SUBSTRING(' + strCampo + ',  36, 3))))))';
  If blnAddApelido Then
    Result := Result + ' AS ' + IIF(fEmptyStr(strApelido), strCampo, strApelido);
End;

