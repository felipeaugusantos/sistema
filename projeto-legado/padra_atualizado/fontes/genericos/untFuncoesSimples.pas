function fPesquisaCliVendedores(const strCodCli: String): String; overload;
var
  strCliMarcas: string;
begin
  result := fPesquisaCliVendedores(strCodCli, strCliMarcas);
end;

function fPesquisaCliVendedores(const strCodCli: String; out strCliMarcas: string): String;
  Var
    strSQL: String;
    qryGen: TUniQuery;
    LrecInfo: TrecInfoMarcaFornecedor ;
Begin
  pInfoMarcaFornecedor(LrecInfo) ;
  qryGen := fCriaQuery;
  Try
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  CVE_CODVEN,  ';
    strSQL := strSQL + '  OPE_NOMOPE,  ';
    strSQL := strSQL + '  ' + LrecInfo.strFieldCodigoDestino + ',  ';
    strSQL := strSQL + '  CVE_DTVGIN,  ';
    strSQL := strSQL + '  CVE_DTVGFN,  ';
    strSQL := strSQL + '  ' + LrecInfo.strFieldNome + ',  ';
    strSQL := strSQL + '  V.AUTOINCREM ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CLIVEN V ';
    strSQL := strSQL + '  INNER JOIN CADOPE ON OPE_CODOPE = CVE_CODVEN ';
    strSQL := strSQL + '   LEFT JOIN ' + LrecInfo.strTabela + ' ON ' + LrecInfo.strFieldCodigoOrigem + ' = ' + LrecInfo.strFieldCodigoDestino + ' ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CVE_CODCLI = :CODCLI ';

    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strSQL);
    qryGen.ParamByName('CODCLI').AsString := strCodCli;
    qryGen.Open;

    If Not qryGen.IsEmpty Then
    Begin
      pCriarFormularios(TfrmPesqCliVend, frmPesqCliVend);
      try
        frmPesqCliVend.dtsConsCliVen.DataSet := qryGen;
        frmPesqCliVend.ShowModal;

        If frmPesqCliVend.blnOk Then
          Result := qryGen.FieldByName('CVE_CODVEN').AsString
        Else
          Result := '';

        If fEmptyStr(Result) Then
          exit;

        qryGen.Filter   := 'CVE_CODVEN = ' + QuotedStr(qryGen.FieldByName('CVE_CODVEN').AsString);
        qryGen.Filtered := True;

        qryGen.First;
        While Not qryGen.Eof Do
        Begin
          If Not fEmptyStr(qryGen.FieldByName(LrecInfo.strFieldCodigoDestino).AsString) Then
            strCliMarcas := strCliMarcas + qryGen.FieldByName(LrecInfo.strFieldCodigoDestino).AsString + '_';
          qryGen.Next;
        End;

        qryGen.Filtered := False;
        qryGen.Filter   := '';
        qryGen.Close;

      finally
        frmPesqCliVend.Release;
        frmPesqCliVend := nil;
      end;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

