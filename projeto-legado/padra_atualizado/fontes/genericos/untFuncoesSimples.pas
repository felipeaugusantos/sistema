procedure pRetornaDadosBaixaTindor(Const strFormulacao: String;
                                   Out strOpeBai: String;
                                   Out dtaDtaBai: TDate;
                                   Out strHorBai: String);
var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery();

  strOpeBai := strLoginUsuarioLogado;
  dtaDtaBai := VS_Date;
  strHorBai := FormatDateTime('hh:mm:ss', fNow());

  Try
    qryAux.SQL.Add('  SELECT                                          ');
    qryAux.SQL.Add('    FDO_OPEBAI,                                   ');
    qryAux.SQL.Add('    FDO_DTABAI,                                   ');
    qryAux.SQL.Add('    FDO_HORBAI                                    ');
    qryAux.SQL.Add('  FROM                                            ');
    qryAux.SQL.Add('    TINDOR                                        ');
    qryAux.SQL.Add('  WHERE CONCAT(FDO_CODACA, FDO_EMPACA) =:FORMUL   ');
    qryAux.SQL.Add('    AND FDO_DTABAI IS NOT NULL                    ');
    qryAux.SQL.Add('    AND FDO_HORBAI IS NOT NULL                    ');
    qryAux.SQL.Add('    AND FDO_OPEBAI IS NOT NULL                    ');
    qryAux.SQL.Add('    LIMIT 1                                       ');

    qryAux.ParamByName('FORMUL').AsString := strFormulacao;

