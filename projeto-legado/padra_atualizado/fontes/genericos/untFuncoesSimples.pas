function fRetTotalEmprestimosAberto(strCodCli: String): Double;
var
  qryGen : TUniQuery;
begin

  qryGen := fCriaQuery;
  try
    qryGen.SQL.Clear;
    qryGen.SQL.Text :=

    ' SELECT '+

    '    IFNULL( '+
    '            SUM( '+
    '              (IFNULL(DET_QTDITE,0) - IFNULL(DET_BAIEMP,0)) * ( '+
    '                ( '+
    '                  DET_TOTITE + IFNULL(DET_VALIPI, 0) + IFNULL(DET_VALRET, 0) + IFNULL(ICD_VALFCP, 0) + IFNULL(DET_TOTFRE, 0) + IFNULL(DET_DESACE, 0)' + fSqlValorReformaRef('MOVREF', 'MOVDET.AUTOINCREM') + ' - IFNULL(DET_DESESP, 0) '+
    '                ) / DET_QTDITE '+
    '              ) '+
    '            ) '+
    '          ,0 ) AS TOTABE '+

    ' FROM '+
    '   MOVDET '+

    ' INNER JOIN MOVTRI '+
    '   ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER '+
    ' LEFT JOIN  MOVICD ON ICD_SEQGER = MOVDET.AUTOINCREM  '+
    ' INNER JOIN CADCLI '+
    '   ON CLI_CODCLI = DET_CODCLI '+

    ' WHERE '+
    '   (CLI_CODCLI = :CODCLI ';

    if fCfgSis('TRFTCR', varString) = '2' then
    begin
      qryGen.SQL.Text := qryGen.SQL.Text +
      ' OR CLI_CODRED =                 '+
      '    (SELECT                      '+
      '       CLI_CODRED                '+
      '     FROM                        '+
      '       CADCLI                    '+
      '     WHERE CLI_CODCLI = :CODCLI) ';
    end;

    qryGen.SQL.Text := qryGen.SQL.Text+
    '  ) AND DET_JAFATU = 0  '+
    '  AND DET_ESPDOC = "EP" '+
    '  AND DET_CLAFIS > 5000 ';

    qryGen.ParamByName('CODCLI').AsString := strCodCli;

    qryGen.Open;

    Result := qryGen.FieldByName('TOTABE').AsFloat;

    qryGen.Close;
  finally
    FreeAndNil(qryGen);
  end;

end;

