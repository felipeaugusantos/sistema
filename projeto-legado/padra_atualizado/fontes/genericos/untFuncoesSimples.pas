    qryDepartamento.SQL.Add('     WHEN DEP_PROACA = "S" AND DEP_PROMAP = "S" THEN "Intermediário" ');
    qryDepartamento.SQL.Add(' 		WHEN DEP_PROACA = "S" THEN "Produto Acabado"                    ');
