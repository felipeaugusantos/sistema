function fPermiteTransfEntreEmps(strCodEmpOri, strCodEmpDes: String): Boolean;
  Var
    qryEmp : TUniQuery;
    strSQL : String;
begin
  If (strCodEmpOri=strCodEmpDes) Then
  Begin
    Result:=True
  End
  Else
  Begin
    qryEmp := fCriaQuery(Nil);
    Try
      With qryEmp Do
      Begin
        strSQL:='';
        strSQL:=strSQL+' SELECT ';
        strSQL:=strSQL+'   CON_TIPOPE, ';
        strSQL:=strSQL+'   CON_PERTRA ';
        strSQL:=strSQL+' FROM ';
        strSQL:=strSQL+'   CONEMP ';
        strSQL:=strSQL+' WHERE ';
        strSQL:=strSQL+'   CON_EMPORI = :EMPORI AND CON_EMPDES = :EMPDES ';

        SQL.Text:=strSQL;

        ParamByName('EMPORI').AsString := strCodEmpOri;
        ParamByName('EMPDES').AsString := strCodEmpDes;

        Open;

        If IsEmpty Then
          Result := False
        Else
          Result := FieldByName('CON_PERTRA').AsString='S';

        Close;
      End;
