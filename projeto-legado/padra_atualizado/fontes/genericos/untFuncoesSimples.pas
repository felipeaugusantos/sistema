{*****************************************}
{* RETORNA SE É CLIENTE CONSUMIDOR OU    *}
{* CLIENTE BALCAO                        *}
{***********************************MV*AF*}
function fClienteConsumidor(strNomCli: String; blnCliBal: Boolean = False; blnSeguradora: Boolean = False; blnAutoAtendimento: Boolean = False): Boolean;
begin

  Result := False;

  If Pos('CONSUMIDOR', strNomCli) > 0 Then
    Result := True;

  If blnCliBal Then
  Begin

    If Pos('BALCAO', strNomCli) > 0 Then
      Result := True

    Else If Pos('BALCÃO', strNomCli) > 0 Then
      Result := True;

  End;

  If blnSeguradora And (Pos('SEGURADORA', strNomCli) > 0) Then
    Result := True;

  If blnAutoAtendimento Then
  Begin
    If Pos('AUTO ATENDIMENTO', strNomCli) > 0 Then
      Result := True;
  End;

end;

