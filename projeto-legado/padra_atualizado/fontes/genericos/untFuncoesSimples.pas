procedure pArredondaParcelaRedonda(fltValTot: Double; intQtdPar: Integer; var arrDigDuplicArray: TArrDigDuplicArray);
  Var
    intIndice : Integer;
begin
  arrDigDuplicArray[0].curValor := Int(fltValTot / intQtdPar);
  arrDigDuplicArray[0].curValor := (arrDigDuplicArray[0].curValor + ( fltValTot - arrDigDuplicArray[0].curValor * intQtdPar ));

  For intIndice := 1 To intQtdPar - 1 Do
    arrDigDuplicArray[intIndice].curValor := Int(fltValTot / intQtdPar);
end;

procedure pArredondaParcelaComEntrada(fltValTot: Double; intQtdPar: Integer; var arrDigDuplicArray: TArrDigDuplicArray; strCndPag, strCodCnd: string);
var
  intIndice: integer;
  fltValPar,
  fltRestante,
  fltPerEntrada: Double;
  intParcelaRestante: integer;
begin
  if fEmptyStr(strCodCnd) then
  begin
    fltPerEntrada := fRetPerEntrada(fRetCodCnd(strCndPag));
  end
  else
  begin
    fltPerEntrada := fRetPerEntrada(strCodCnd);
  end;

  if fltPerEntrada = 0 then
    Exit;

  if intQtdPar = 1 then
  begin
    arrDigDuplicArray[0].curValor := fltValTot;
  end
  else if intQtdPar = 2 then
  begin
    arrDigDuplicArray[0].curValor := fFormataFloat(((fltValTot * fltPerEntrada) / 100),2);
    arrDigDuplicArray[1].curValor := fltValTot - arrDigDuplicArray[0].curValor;
  end
  else
  begin
    intParcelaRestante := intQtdPar - 1;
    arrDigDuplicArray[0].curValor := fFormataFloat(((fltValTot * fltPerEntrada) / 100),2);
    fltRestante := fltValTot - arrDigDuplicArray[0].curValor;

    fltValPar := fFormataFloat(fltRestante / intParcelaRestante, 2);
    arrDigDuplicArray[1].curValor := fltValPar;

    If (fltValPar * intParcelaRestante < fltRestante) Then
      arrDigDuplicArray[1].curValor := fltValPar + (fltRestante - (fltValPar * intParcelaRestante));

    For intIndice := 2 To intQtdPar -1 Do
    Begin
      arrDigDuplicArray[intIndice].curValor := fltValPar;

      If (intIndice = intQtdPar -1) Then
      Begin
        If (fltValPar * intParcelaRestante > fltRestante) Then
          arrDigDuplicArray[intIndice].curValor := fltValPar + (fltRestante - (fltValPar * intParcelaRestante));
      End;
    End;
  end;
end;

procedure pArredondaParcelaDefault(fltValTot: Double; intQtdPar: Integer; var arrDigDuplicArray: TArrDigDuplicArray);
  Var
    fltValPar : Double;
    intIndice : Integer;
begin
  fltValPar := fFormataFloat(fltValTot / intQtdPar, 2);

  arrDigDuplicArray[0].curValor := fltValPar;

  If (fltValPar * intQtdPar < fltValTot) Then
    arrDigDuplicArray[0].curValor := fltValPar + (fltValTot - (fltValPar * intQtdPar));

  For intIndice := 1 To intQtdPar -1 Do
  Begin
    arrDigDuplicArray[intIndice].curValor := fltValPar;

    If (intIndice = intQtdPar -1) Then
    Begin
      If (fltValPar * intQtdPar > fltValTot) Then
        arrDigDuplicArray[intIndice].curValor := fltValPar + (fltValTot - (fltValPar * intQtdPar));
    End;
  End;
end;

procedure pOrdenaDataSet(var cdsAux : TUniClientDataSet; strCampo, strTipo : String);
var
  blnExiste : Boolean;
  strChave  : String;
begin
  if fEmptyStr(strCampo) then
    Exit;

  If strTipo='DESC' Then
  Begin

    Try
      strChave := StringReplace(strCampo,';','',[rfReplaceAll]);
      cdsAux.IndexDefs.Find(strChave);
      blnExiste := true;
    Except
      blnExiste := false;
    End;

    If not blnExiste Then
    Begin
      with cdsAux.IndexDefs.AddIndexDef do begin
        Name   := strChave;
        Fields := strCampo;
        Options := [ixDescending];
      end;
    End;
    cdsAux.IndexName := strChave;
  End
  Else
    cdsAux.IndexFieldNames := strCampo;
end;

