procedure pAjustaNumeroPaginas(pgcDados: TPageControl; Var intPaginasAtivas: Integer);
  Var
    intIndice,
    intContador: Integer;
    strNomPag  : String;
    stlAlfabeto: TStringList;

    Function fRetNomPaginaComAtalho(strNome : String) : String;
      Var
        intCorre : Integer;
        chrAlfa : Char;
        blnResult : Boolean;
    Begin
      blnResult := False;
      For intCorre := 1 to Length(strNome) do
      Begin
        chrAlfa := strNome[intCorre];
        if pos(chrAlfa,' _-*/\|!@#$%¨&*()=§ª{}[]^~"-+.;.,<>?') = 0 then
        Begin
          if pos(chrAlfa, stlAlfabeto.CommaText) <= 0 then
          Begin
            stlAlfabeto.Add(chrAlfa);
            Result := Copy(strNome, 1, intCorre-1) + '&' + Copy(strNome, intCorre, Length(strNome));
            blnResult := True;
            Break;
          end;
        End;
      end;

      if not blnResult then
        Result := strNome;

    end;

    function fstrRetPos(const value:String):Integer;
      var
        intPos: integer;
    begin
      Result := 0;

      for intPos := 1 to Length(PChar(value)) do
      begin
        if (value[intPos] = '-') then
        begin
          Result := intPos;
          Break;
        end;
      end;
    end;
Begin
  intContador := 0;
  try
    stlAlfabeto:= TStringList.Create;

    For intIndice := 0 To pgcDados.PageCount - 1 Do
    Begin

      If pgcDados.Pages[intIndice].TabVisible Then
      Begin
        Inc(intContador);

        strNomPag := pgcDados.Pages[intIndice].Caption;

        if intContador < 10 then
          strNomPag := '&' + IntToStr(intContador) + Copy(strNomPag, fstrRetPos(strNomPag), Length(strNomPag))
        Else if intContador = 10 Then
        begin
          strNomPag := Copy(strNomPag, fstrRetPos(strNomPag), Length(strNomPag));
          strNomPag := '1&0' + ' ' + strNomPag
        end
        Else
          strNomPag := IntToStr(intContador) + fRetNomPaginaComAtalho(Copy(strNomPag, fstrRetPos(strNomPag), Length(strNomPag)));

        pgcDados.Pages[intIndice].Caption := strNomPag;
      End
      Else
      Begin
        pgcDados.Pages[intIndice].Caption := '';

      End;

    End;

    For intIndice := pgcDados.PageCount -1 Downto 0 Do
    Begin
      If Not pgcDados.Pages[intIndice].TabVisible Then
      begin
        pgcDados.Pages[intIndice].PageIndex := pgcDados.PageCount -1;
        pgcDados.Pages[pgcDados.PageCount -1].TabVisible := False;
      End
    End;

  finally
    FreeAndNil(stlAlfabeto);
  end;

  intPaginasAtivas := intContador;
End;

function fValidaChaveAcessoNFE(strChaveAcesso : String):Boolean;
 Var intSoma    : Integer;
      intPeso    : Integer;
      intCorre   : Integer;
      strDig     : String;
      intDigCalc : Integer;
//      fltAuxiliar: Double;

  const
    ALFABET_MAI = 'ABCDEFGHIJKLMNOPQRSTUVWYXZ';

  function ContemCaracter(ACaracter : String; ALista : String) : Boolean;
  begin
    Result := Pos(ACaracter, ALista) > 0;
  end;

  function CharToIntValue(C: Char): Integer;
  begin
    C := UpCase(C);

    If ContemCaracter(C, ALFABET_MAI) Then
      Result := Ord(C) - Ord('A') + 10
    Else
      Result := Ord(C) - Ord('0');
  end;

Begin
  intPeso  := 2;
  intSoma  := 0;
  Result := True;
  If ( Length(strChaveAcesso) <> 44 ) Then
    Result := False;

  If Not Result Then
    Exit;

  strDig := strChaveAcesso[44];
  strChaveAcesso := Copy(strChaveAcesso,1,43);

  For intCorre := Length(strChaveAcesso) Downto 1 do
  begin
    intSoma := intSoma + ( CharToIntValue(strChaveAcesso[intCorre]) * intPeso);

    Inc(intPeso);
    if (intPeso > 9) Then
      intPeso := 2;
  End;

  intDigCalc := intSoma mod 11 ;

  if (intDigCalc = 0) or (intDigCalc = 1) Then
    intDigCalc := 0
  Else
    intDigCalc := 11 - intDigCalc;

  Result  := (strDig = IntToStr(intDigCalc));

End;

function fValidaChaveAcessoNFE(strChaveAcesso, strCodFor, strNumDoc, strSerie : String; blnEhCliente: Boolean = False; strEmtCGC: String = ''; blnEhCPF: Boolean = False):Boolean; overload;
 {dígitos 7 à 20 *** CNPJ do emitente da NF-e
  dígitos 23 à 25 *** Série da NF-e
  dígitos 26 à 34 *** Número da NF-e }
Var
 strChvCGC,
 strChvSer,
 strChave,
 strDstCGC: String;
 Begin
   If (strSerie >= '890') And (strSerie <= '899') Then
     Exit(True);

  strChvCGC := Copy(strChaveAcesso,  7, 14);

  {Pode ocorrer do CPF validar como CNPJ exemplo: '0007033112980' req.: 301436}
  If blnEhCPF Then
    strChvCGC := Copy(strChvCGC, 4,  (Length(strChvCGC)-1));

  strChvSer := Copy(strChaveAcesso, 23,  3);
  strChave  := Copy(strChaveAcesso, 26,  9);
  strDstCGC := fTiraCaracEspeciaisPonto(IIf(blnEhCliente, fRetCgcCpf(strCodFor),fRetFornecedorCGC(strCodFor)));
  Result := ((strChvCGC = strEmtCGC) Or (strChvCGC = strDstCGC)) And
     (strChvSer =  fPadL(strSerie,3,'0')) And
     (strChave =  RightStr(strNumDoc,9));
 end;

