Function fCarregaTabelaPrecoAtiva(strCodFor, strCodIte: String; qryIteFor: TUniQuery; strCondicao: String = 'TAB_ATICMP = "S"'): Boolean;
Begin
  With qryIteFor, SQL Do
  Begin
    Close;
    Clear;
    Add('SELECT ');
    Add('  IF(IFNULL(FX.ITE_CNVCUS, 0) = 0, 1, FX.ITE_CNVCUS) AS ITE_CNVCUS, ');
    Add('  IFNULL(FX.ITE_UNICOM, "") AS ITE_UNICOM,                          ');
    Add('  IFNULL(FX.ITE_DESFAB, "") AS ITE_DESITE                           ');
    Add('FROM ITEFOR FX');

    Add('INNER JOIN TABPRE ON TAB_CODTAB = FX.ITE_CODTAB AND ' + strCondicao);

    Add('WHERE');
    Add('  FX.ITE_CODFOR = :CODFOR AND     ');
    Add('  FX.ITE_CODITE = :CODITE AND     ');
    Add('  (IFNULL(FX.ITE_CNVCUS, 0) <> 0) AND IFNULL(FX.ITE_UNICOM, "") <> ""');

    ParamByName('CODITE').AsString := strCodIte;
    ParamByName('CODFOR').AsString := strCodFor;

    Open;

    Result := (Not IsEmpty);
  End;
End;

function fRetornaComposicaoCustoCampos(intValCfg : Integer;
                                        strAliDet : String = '';
                                        strAliTri : String = ''): String;
  Var
