{*************************************************VA*}
Function fValidaCnpjCpf(strCPFCNPJ: String; blnMostraMSG: Boolean=False):Boolean;
  Var
    strOpcao : String;
begin
  Result := False;

  If Not fEmptyStr(strCPFCNPJ) Then
  Begin
    strOpcao := IfThen(Length(strCPFCNPJ) > 11, '1','2');

    Result := fValidaCnpjCpfDigIgual(strOpcao, strCPFCNPJ, False);

    If Result Then
    Begin
      If strOpcao = '1' Then
        Result := fTestaCgc(strCPFCNPJ)
      Else If strOpcao = '2' Then
        Result := fValidaCPF(strCPFCNPJ);
    End;

    If (blnMostraMSG) And (Not Result) Then
     fMensagem('ATENÇÃO', strCPFCNPJ + ' não é um número de '+IfThen(strOpcao='1','CNPJ','CPF')+' válido!', ['&Ok']);
  End
  Else
  Begin
    If (blnMostraMSG) Then
      fMensagem('ATENÇÃO', 'CPF/CNPJ não informado!', ['&Ok']);
  End;
end;

