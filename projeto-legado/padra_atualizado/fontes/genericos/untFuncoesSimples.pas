End;

function fCriarProcessoSimples(strArquivo: string; blnTrava: Boolean; TipoChamado: TTipoChamadaProcesso = tcpMaximizado): boolean;
  Var
    StartInfo: TStartupInfo;
    ProceInfo: TProcessInformation;
begin
  pLog('fCriarProcessoSimples->'+strArquivo);
  FillChar(StartInfo, SizeOf(StartInfo), #0);
  StartInfo.cb          := SizeOf(StartInfo);
  StartInfo.dwFlags     := STARTF_USESHOWWINDOW;

  If (TipoChamado = tcpMaximizado) Then
    StartInfo.wShowWindow := SW_SHOWMAXIMIZED
  Else if (TipoChamado = tcpNormal) then
    StartInfo.wShowWindow := SW_SHOWNORMAL
  else if (TipoChamado = tcpOculto) then
    StartInfo.wShowWindow := SW_HIDE;

  Result := CreateProcess(Nil,
                          PChar(strArquivo),
                          Nil,
                          Nil,
                          False,
                          CREATE_NEW_CONSOLE Or
                          NORMAL_PRIORITY_CLASS,
                          Nil,
                          PChar(ExtractFilePath(strArquivo)),
                          StartInfo,
                          ProceInfo);

  If (Result) and (TipoChamado <> tcpOculto) Then
    SetForegroundWindow(ProceInfo.hProcess);

  If (Result) And (blnTrava) Then
  Begin
    WaitForSingleObject(ProceInfo.hProcess, INFINITE);

    CloseHandle(ProceInfo.hProcess);
    CloseHandle(ProceInfo.hThread);
  End;
end;

function fCriarProcessoSimplesExitCode(strArquivo: string; blnTrava: Boolean; TipoChamado: TTipoChamadaProcesso = tcpMaximizado): Cardinal;
Var
  StartInfo: TStartupInfo;
  ProceInfo: TProcessInformation;
  Return: Boolean;
begin
  pLog('fCriarProcessoSimplesExitCode->'+strArquivo);
  FillChar(StartInfo, SizeOf(StartInfo), #0);
  StartInfo.cb          := SizeOf(StartInfo);
  StartInfo.dwFlags     := STARTF_USESHOWWINDOW;

  If (TipoChamado = tcpMaximizado) Then
    StartInfo.wShowWindow := SW_SHOWMAXIMIZED
  Else if (TipoChamado = tcpNormal) then
    StartInfo.wShowWindow := SW_SHOWNORMAL
  else if (TipoChamado = tcpOculto) then
    StartInfo.wShowWindow := SW_HIDE;

  Return := CreateProcess(Nil,
                          PChar(strArquivo),
                          Nil,
                          Nil,
                          False,
                          CREATE_NEW_CONSOLE Or
                          NORMAL_PRIORITY_CLASS,
                          Nil,
                          PChar(ExtractFilePath(strArquivo)),
                          StartInfo,
                          ProceInfo);

  If (Return) and (TipoChamado <> tcpOculto) Then
    SetForegroundWindow(ProceInfo.hProcess);

  If (Return) And (blnTrava) Then
  Begin
    WaitForSingleObject(ProceInfo.hProcess, INFINITE);
    GetExitCodeProcess(ProceInfo.hProcess, Result);
    CloseHandle(ProceInfo.hProcess);
    CloseHandle(ProceInfo.hThread);
  End;
end;


procedure pKill(intId: Integer);
  Var
    qryAux: TUniQuery;
begin
  If intId < 0 Then
    Exit;

  try
  qryAux := fCriaQuery(Nil);
    try
  qryAux.SQL.Add('KILL :ID');
  qryAux.ParamByName('ID').AsInteger := intId;
  qryAux.ExecSQL;
    finally
  FreeAndNil(qryAux);
end;
  except
    // oculta o erro, caso tenha
  end ;

end;

