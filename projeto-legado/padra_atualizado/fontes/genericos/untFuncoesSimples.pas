function fTrataNumRom(const Edit: TEdit): String;
var
  strNumRom: String;
begin
  if fEmptyStr(Edit.Text) then
    Exit;

  strNumRom := '0000000000000' + Trim(Edit.Text);
  if Length(Edit.Text) <= 6 then
    strNumRom := RightStr(strNumRom, 6)
  else
    strNumRom := RightStr(strNumRom, 13);

  Edit.Text := strNumRom;

  Result := strNumRom;
end;

