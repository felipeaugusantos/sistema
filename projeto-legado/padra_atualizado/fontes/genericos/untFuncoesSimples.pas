function fAtualizaBarFabIte(strCodIte: String): Boolean;

  procedure pAdd(strValue: String; stlList: TStringList);
  begin
    If Not fEmptyStr(strValue) Then
    Begin
      If stlList.IndexOf(Trim(strValue)) = -1 Then
        stlList.Add(Trim(strValue));
    End;
  end;

  function fRetCod(stlList: TStringList): String;
    Var
      intCnt : Integer;
  begin
    {******************************************************************}
    {* NÃO REMOVER O PIPE POIS A PESQUISA "fConsultaItemDev" UTILIZA  *}
    {* DESSA FORMA: "ITE_BARRAS LIKE '%| ' + edtCodIte.Text + ' |%'   *}
    {***************************************************************RN*}
    Result := '';
    For intCnt := 0 To stlList.Count-1 Do
    Begin
      If fEmptyStr(Result) Then
        Result := '| ' + stlList.Strings[intCnt]
      Else
      Begin
        If (Length(Result + ' | ' + stlList.Strings[intCnt] + ' |') <= 255) Then
          Result := Result + ' | ' + stlList.Strings[intCnt]
        Else
          Break;
      End;
    End;

    If Not fEmptyStr(Result) Then
      Result := Result + ' |';
  end;

  Var
    qryCadIte : TUniQuery;
    qryCodigo : TUniQuery;
    stlCodBar : TStringList;
    stlCodFab : TStringList;
    strCodBar : String;
    strCodFab : String;
    strUpDate : String;
begin
  qryCadIte := fCriaQuery;
  qryCodigo := fCriaQuery;
  stlCodBar := TStringList.Create;
  stlCodFab := TStringList.Create;
  Try
    With qryCadIte Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT ITE_CODBAR, ITE_CODFAB, ITE_BARRAS, ITE_FABRIC ');
      SQL.Add('   FROM CADITE ');
      SQL.Add('  WHERE ITE_CODITE = :CODITE ');
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      pAdd(FieldByName('ITE_CODBAR').AsString, stlCodBar);
      pAdd(FieldByName('ITE_CODFAB').AsString, stlCodFab);
    End;

    With qryCodigo Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT SEM_CODBAR, SEM_CODSEM ');
      SQL.Add('   FROM CADSEM ');
      SQL.Add('  WHERE SEM_CODITE = :CODITE ');
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      First;
      While Not Eof Do
      Begin
        pAdd(FieldByName('SEM_CODBAR').AsString, stlCodBar);
        pAdd(FieldByName('SEM_CODSEM').AsString, stlCodFab);
        Next;
      End;

      Close;
    End;

    With qryCodigo Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT BAR_CODBAR ');
      SQL.Add('   FROM ITEBAR ');
      SQL.Add('  WHERE BAR_CODITE = :CODITE ');
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      First;
      While Not Eof Do
      Begin
        pAdd(FieldByName('BAR_CODBAR').AsString, stlCodBar);
        Next;
      End;

      Close;
    End;

    With qryCodigo Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT ');

      If fCfgSis('TABPRF', varBoolean) Then
        SQL.Add(' ITE_CODFAB AS CODFAB ')
      Else
        SQL.Add(' ITE_CODITF AS CODFAB ');

      SQL.Add(' FROM ITEFOR ');
      SQL.Add(' WHERE ITE_CODITE = :CODITE ');
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      First;
      While Not Eof Do
      Begin
        pAdd(FieldByName('CODFAB').AsString, stlCodFab);
        Next;
      End;

      Close;
    End;

    strCodBar := fRetCod(stlCodBar);
    strCodFab := fRetCod(stlCodFab);

    strUpDate := '';

    If (Not SameText(strCodBar, qryCadIte.FieldByName('ITE_BARRAS').AsString)) Then
    Begin
      If fEmptyStr(strUpDate) Then
        strUpDate := ' ITE_BARRAS = :CODBAR '
      Else
        strUpDate := strUpDate + ', ITE_BARRAS = :CODBAR ';
    End;

    If (Not SameText(strCodFab, qryCadIte.FieldByName('ITE_FABRIC').AsString)) Then
    Begin
      If fEmptyStr(strUpDate) Then
        strUpDate := ' ITE_FABRIC = :CODFAB '
      Else
        strUpDate := strUpDate + ', ITE_FABRIC = :CODFAB ';
    End;

    If Not fEmptyStr(strUpDate) Then
    Begin
      With qryCodigo Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' UPDATE CADITE ');
        SQL.Add('    SET ' + strUpDate );
        SQL.Add('  WHERE ITE_CODITE = :CODITE ');
        ParamByName('CODITE').AsString := strCodIte;

        If FindParam('CODBAR') <> Nil Then
          ParamByName('CODBAR').AsString := strCodBar;

        If FindParam('CODFAB') <> Nil Then
          ParamByName('CODFAB').AsString := strCodFab;

        ExecSQL;
      End;
    End;

    Result := True;
  Finally
    FreeAndNil(qryCadIte);
    FreeAndNil(qryCodigo);
    FreeAndNil(stlCodBar);
    FreeAndNil(stlCodFab);
  End;
end;

