function fExecutaScript(script: string; var qrySQL: TUniQuery; blnCriaQuery: Boolean): boolean;
begin
  Result := False;

  If blnCriaQuery Then
    qrySQL := fCriaQuery;

  Try
    Try
      qrySQL.SQL.Clear;
      qrySQL.SQL.Add(script);
      qrySQL.ExecSQL();
      Result := True;
    Except
      on e: exception do
        raise ;
    End;

  Finally

    If blnCriaQuery Then
      FreeAndNil(qrySQL);
  End;
End;

