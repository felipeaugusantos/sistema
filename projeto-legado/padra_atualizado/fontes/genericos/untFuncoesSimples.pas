procedure pRemoveLogLiberacao(const strCodigoLiberacao: String);
var
  LSql      : String;
  qryDelete : TUniQuery;
begin
  If fEmptyStr(strCodigoLiberacao) Then
    Exit;

  qryDelete   := fCriaQuery();
  Try
    LSql := 'DELETE FROM LOGLIB '
          + ' WHERE LOG_CODLIB = :CODLIB ';

    qryDelete.Close;
    qryDelete.SQL.Text := LSql;
    qryDelete.ParamByName('CODLIB').AsString := strCodigoLiberacao;
    qryDelete.ExecSQL;
  Finally
    FreeAndNil(qryDelete);
  End;
end;

procedure pRemoveLogLiberacaoSemDocumento(const ACodigoLiberacao: String);
  Var
    LLiberacao : TUniQuery;
    LDeletar : Boolean;
begin
  If fEmptyStr(ACodigoLiberacao) Then
    Exit;
  LLiberacao := fCriaQuery();
  Try
    LLiberacao.Close;
    LLiberacao.SQL.Clear;
    LLiberacao.SQL.Add(' SELECT L.LOG_NUMDOC, L.LOG_ESPDOC ');
    LLiberacao.SQL.Add('   FROM LOGLIB L ');
    LLiberacao.SQL.Add('  WHERE L.LOG_CODLIB = :CODLIB ');
    LLiberacao.ParamByName('CODLIB').AsString := ACodigoLiberacao;
    LLiberacao.Open;

    If LLiberacao.IsEmpty Then
      Exit;

    If (LLiberacao.RecordCount <= 1) Then
      Exit;

    LDeletar := False;

    LLiberacao.First;
    While Not LLiberacao.Eof Do
    Begin
      If (Not fEmptyStr(LLiberacao.FieldByName('LOG_NUMDOC').AsString)) And
         (Not fEmptyStr(LLiberacao.FieldByName('LOG_ESPDOC').AsString)) Then
      Begin
        LDeletar := True;
        Break;
      End;
      LLiberacao.Next;
    End;

    If (Not LDeletar) Then
      Exit;

    LLiberacao.Close;
    LLiberacao.SQL.Clear;
    LLiberacao.SQL.Add(' DELETE ');
    LLiberacao.SQL.Add('   FROM LOGLIB ');
    LLiberacao.SQL.Add('  WHERE LOG_CODLIB = :CODLIB ');
    LLiberacao.SQL.Add('    AND IFNULL(LOG_NUMDOC,"") = "" ');
    LLiberacao.SQL.Add('    AND IFNULL(LOG_ESPDOC,"") = "" ');
    LLiberacao.ParamByName('CODLIB').AsString := ACodigoLiberacao;
    LLiberacao.ExecSQL;
  Finally
    FreeAndNil(LLiberacao);
  End;
end;

function GetValidComponentName(const strNome: string): string;
var
  intCont: Integer;
  strResult: string;

  function IsValidIdent(const Ident: string; AllowDots: Boolean): Boolean;
  const
    Alpha = ['A'..'Z', 'a'..'z', '_'];
    AlphaNumeric = Alpha + ['0'..'9'];
    AlphaNumericDot = AlphaNumeric + ['.'];
  var
    I: Integer;
  begin
    Result := False;
    if (Length(Ident) = 0) or not CharInSet(Ident[1], Alpha) then Exit; //(Ident[1] in Alpha) then Exit;
    if AllowDots then
      for I := 2 to Length(Ident) do
        begin
          if not CharInSet(Ident[I], AlphaNumericDot) then Exit //(Ident[I] in AlphaNumericDot) then Exit
        end
    else
      for I := 2 to Length(Ident) do if not CharInSet(Ident[I],AlphaNumeric) then Exit; //(Ident[I] in AlphaNumeric) then Exit;
    Result := True;
  end;
begin
  Result := '';
  strResult := '';
  for intCont := 1 to Length(strNome) do
  begin
    strResult := strResult + strNome[intCont];
    if IsValidIdent(strResult, False) then
      Result := Result + strNome[intCont]
    else
      strResult := Result;
  end;
end;

function fExtractBetweenTags(const Value, TagI, TagF: String): String;
var
  regEx: TRegEx;
begin
  regEx := TRegEx.Create(Format('%s.+?%s', [TagI.Replace('/', '\/'),
    TagF.Replace('/', '\/')]));

  Result := regEx.Match(Value).Value.Replace(TagI, '').Replace(TagF, '');
end;

function fExtractBetweenTagsList(const Value, TagI, TagF: String): TStringList;
var
  regEx: TRegEx;
  Match: TMatch;
begin
  try
    regEx := TRegEx.Create(Format('%s.+?%s', [TagI.Replace('/', '\/'),
      TagF.Replace('/', '\/')]));

    Result := TStringList.Create;
    Match := regEx.Match(Value);

    while Match.Success do
    begin
      Result.Add(Match.Value);
      Match := Match.NextMatch;
    end;

  except
    Result := nil;
  end;
end;

function fValidarLatitudeLongitude(const ALatLng: string): Boolean;
const
  LATLNG_REGEX = '^\s*-?([1-8]?\d(\.\d+)?|90(\.0+)?),\s*-?((1[0-7]\d|\d{1,2})(\.\d+)?|180(\.0+)?)\s*$';
Begin
  Result := TRegEx.IsMatch(ALatLng.Trim, LATLNG_REGEX);
End;

