Function fAtualizaFornecedorPedido(strNumPed, strCodEmp, strCodFor: String): Boolean;
  Var
    qryUpdate: TUniQuery;
    blnComTransacao: Boolean;
Begin
  Try
    qryUpdate := fCriaQuery;

    blnComTransacao := Not frmModulo.GetCurrentConnection.InTransaction;

    If blnComTransacao Then
      fStartTransaction;

    With qryUpdate, SQL Do
    Begin
      Close;
      Clear;
      Add('UPDATE PCMDET SET ');
      Add('PCD_CODFOR = :CODFOR');
      Add('WHERE ');
      Add('  PCD_NUMPED = :NUMPED AND');
      Add('  PCD_CODEMP = :CODEMP AND');
      Add('  PCD_ESPDOC = "PD"');

      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODFOR').AsString := strCodFor;

      ExecSQL;

      Clear;
      Add('UPDATE PCMGER SET ');
      Add('PCG_CODFOR = :CODFOR');
      Add('WHERE ');
      Add('  PCG_NUMPED = :NUMPED AND');
      Add('  PCG_CODEMP = :CODEMP AND');
      Add('  PCG_ESPDOC = "PD"');

      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODFOR').AsString := strCodFor;

      ExecSQL;

      If blnComTransacao Then
        fCommit;

      Result := True;
    End;

    FreeAndNil(qryUpdate);

  Except
    On E: Exception Do
    Begin
      fRollBack;
      Result := False;
      pMensagensErro(E.Message, '[fAtualizaFornecedorPedido]');
    End;
  End;
End;

function fAtualizaFornecedorPedido(strAutIncPedidoCompra, strCodFor: String): Boolean; overload;
Var
  qryUpdate: TUniQuery;
  blnComTransacao: Boolean;
begin
  qryUpdate := fCriaQuery;  // Criação da query
  blnComTransacao := Not frmModulo.GetCurrentConnection.InTransaction;  // Verifica se há transação aberta
  try
    // Inicia transação, se necessário
    if blnComTransacao then
      fStartTransaction;

    try
      // Primeiro UPDATE (para PCMDET)
      qryUpdate.Close;
      qryUpdate.SQL.Clear;
      qryUpdate.SQL.Add('UPDATE PCMDET ');
      qryUpdate.SQL.Add('INNER JOIN PCMGER ON PCD_NUMPED = PCG_NUMPED AND ');
      qryUpdate.SQL.Add('                  PCD_CODEMP = PCG_CODEMP AND ');
      qryUpdate.SQL.Add('                  PCD_ESPDOC = PCG_ESPDOC AND ');
      qryUpdate.SQL.Add('                  PCD_NUMCTN = PCG_NUMCTN AND ');
      qryUpdate.SQL.Add('                  PCD_DTAPED = PCG_DTAPED ');
      qryUpdate.SQL.Add('SET PCD_CODFOR = :CODFOR ');
      qryUpdate.SQL.Add('WHERE PCMGER.AUTOINCREM = :AUTINC AND ');
      qryUpdate.SQL.Add('      PCD_ESPDOC = "PD"');

      qryUpdate.ParamByName('AUTINC').AsString := strAutIncPedidoCompra;  // Parâmetro AUTOINCREM
      qryUpdate.ParamByName('CODFOR').AsString := strCodFor;  // Parâmetro CODFOR
      qryUpdate.ExecSQL;

      // Segundo UPDATE (para PCMGER)
      qryUpdate.SQL.Clear;
      qryUpdate.SQL.Add('UPDATE PCMGER ');
      qryUpdate.SQL.Add('SET PCG_CODFOR = :CODFOR ');
      qryUpdate.SQL.Add('WHERE AUTOINCREM = :AUTINC AND ');
      qryUpdate.SQL.Add('      PCG_ESPDOC = "PD"');

      qryUpdate.ParamByName('AUTINC').AsString := strAutIncPedidoCompra;  // Parâmetro AUTOINCREM
      qryUpdate.ParamByName('CODFOR').AsString := strCodFor;  // Parâmetro CODFOR
      qryUpdate.ExecSQL;

      // Se foi iniciada uma transação, comita
      if blnComTransacao then
        fCommit;

      Result := True;  // Retorna True indicando sucesso

    except
      On E: Exception do
      begin
        // Se ocorrer um erro, realiza rollback se necessário
        if blnComTransacao then
          fRollBack;

        Result := False;  // Indica que houve erro
        pMensagensErro(E.Message, '[fAtualizaFornecedorPedido]');  // Exibe a mensagem de erro
      end;
    end;

  finally
    FreeAndNil(qryUpdate);  // Libera o recurso da query, executado independentemente de erro
  end;
end;

Function fVeSeAtualizaPedidoCompra(strNumPed, strCodEmp, strForEle, strForPed: String; blnSalvaFornecedor: Boolean): Boolean;
Begin
  { Se o fonecedor do pedido pertencer ao mesmo grupo da nota e não for filial então libera atualizar o pedido}
  Result := fFornecedoresMesmoGrupo(strForEle, strForPed) And Not(fFornecedorFilial(strForPed)) And
            fPergunta('Os fornecedores do XML e do Pedido de Compra são diferentes, porém seus CNPJ''s são do mesmo grupo de empresas. ' +
                      'Será possivel trocar o fornecedor do pedido automaticamente. Deseja prosseguir?');

  { Se o Fornecedor do pedido pertence ao mesmo grupo econômico e não for filial então libera atualizar o pedido}
  If Not Result Then
  Begin
    Result := fFornecedoresMesmoGrupoEconomico(strForEle, strForPed) And Not(fFornecedorFilial(strForPed)) And
              fPergunta('Os fornecedores do XML e do Pedido de Compra são diferentes, porém são do mesmo grupo Econômico de empresas. ' +
                        'Será possivel trocar o fornecedor do pedido automaticamente. Deseja prosseguir?');
  End;

  If Result And blnSalvaFornecedor Then
    Result := fAtualizaFornecedorPedido(strNumPed, strCodEmp, strForEle);
End;

function fCommaText(stlListSelecao: TStringList; blnQuoted: Boolean = False; strSeparator : String = ', '): String;
  Var
    intContador: Integer;
    strDado: String;
Begin
  Result := '';

  For intContador := 0 To stlListSelecao.Count - 1 Do
  Begin
    If blnQuoted Then
      strDado := QuotedStr(stlListSelecao[intContador])
    Else
      strDado := stlListSelecao[intContador];

    If intContador = 0 Then
      Result := strDado
    Else
      Result := Result + strSeparator +  strDado;
  End;
end;

function fOrganizaArrayComVirgula(arrLista: Array Of String; blnAspas: Boolean = False; strSeparator : String = ', '): String;
  Var
    intContador : Integer;
    strValor : String;
Begin
  Result := '';

  For intContador := 0 To Pred(Length(arrLista)) Do
  Begin
    If blnAspas Then
      strValor := QuotedStr(arrLista[intContador])
    Else
      strValor := arrLista[intContador];

    If intContador = 0 Then
      Result := strValor
    Else
      Result := Result + strSeparator +  strValor;
  End;
end;

function fValidaUFsPercurso(strPercurso: String): Boolean;
  Var
    stlUFs: TStringList;
    strUF: String;
    strMsg: String;
    intContador: Integer;
begin
  Result := True;
  strMsg := '';
  stlUFs := TStringList.Create;
  ExtractStrings([','], [], PChar(strPercurso), stlUFs);

  For intContador := 0 To stlUFs.Count-1 Do
  Begin
    strUF := Trim(stlUFs[intContador]);
    If Not fValidaEstado(strUF) Then
    Begin
      strMsg := strMsg + strUf + ',';
    End;
  End;

  If Not fEmptyStr(strMsg) Then
  Begin
    strMsg := LeftStr(strMsg, Length(strMsg)-1);
    Result := False;

    pMensagemOk('Há UFs inválidas no percurso: ' + strMsg);
  End;

  FreeAndNil(stlUFs);
end;

