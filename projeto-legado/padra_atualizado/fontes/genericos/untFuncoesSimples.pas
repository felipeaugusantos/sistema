function fGetSQLSomaExpedidos(strRelacaoCodIte: String; strRelacaoCodEmp: String; blnSubSel: Boolean = True): String;
begin
  Result := '';

  If (blnSubSel) Then
    Result := Result + ' IFNULL((                                                     ';

  Result := Result + '         SELECT SUM(FDO_QTDEXP)                                 ';
  Result := Result + '           FROM EXTDOR                                          ';
  Result := Result + '           JOIN FATDOR ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
  Result := Result + '           JOIN FATGOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ';
  Result := Result + '          WHERE FATDOR.FDO_ESPDOC = "PD"                        ';
  Result := Result + '            AND FDO_JAFATU = 0                                  ';
  Result := Result + '            AND FDO_QTDEXP > 0                                  ';
  Result := Result + '            AND FGO_JAFATU = 0                                  ';

  If (blnSubSel) Then
  Begin
    Result := Result + '          AND FDO_CODITE = ' + strRelacaoCodIte + '           ';
    Result := Result + '          AND FDO_CODEMP = ' + strRelacaoCodEmp + '), 0)      ';
  End
  Else
  Begin
    Result := Result + '          AND FDO_CODITE = ' + QuotedStr(strRelacaoCodIte);
    Result := Result + '          AND FDO_CODEMP = ' + QuotedStr(strRelacaoCodEmp);
  End;
end;

