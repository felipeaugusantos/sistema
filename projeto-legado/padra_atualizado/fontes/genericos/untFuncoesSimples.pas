function fEhPedidoDeConcreto(strNumPed, strEspPed, strEmpPed : String) : Boolean;
var
  qryAux : TUniQuery;
const
  SQL_PEDIDO = 'SELECT                     ' +
               '  FDO_CODITE               ' +
               'FROM                       ' +
               '  FATDOR                   ' +
               'WHERE                      ' +
               '  FDO_NUMDOC = :NUMDOC AND ' +
               '  FDO_ESPDOC = :ESPDOC AND ' +
               '  FDO_CODEMP = :CODEMP     ';
Begin

  Result := False;

  If Not fCfgSis('USACCR', varBoolean) Then
    Exit;

  If Not fCfgSis('ITECCR', varBoolean) Then
    Exit;

  If strNumPed.IsEmpty Then
    Exit;

  If strEspPed.IsEmpty Then
    Exit;

  If strEmpPed.IsEmpty Then
    Exit;

  qryAux := fCriaQuery();

  Try

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(SQL_PEDIDO);
    qryAux.ParamByName('NUMDOC').AsString := strNumPed;
    qryAux.ParamByName('ESPDOC').AsString := strEspPed;
    qryAux.ParamByName('CODEMP').AsString := strEmpPed;
    qryAux.Open;

    qryAux.First;
    While Not qryAux.Eof Do
    Begin

      If fItemConcreto(qryAux.FieldByName('FDO_CODITE').AsString) Then
        Exit(True);

      qryAux.Next;

    End;

  Finally
    FreeAndNil(qryAux);
  End;

end;

