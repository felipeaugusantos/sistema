Function fSQLLocalFisica(strAliasIteger: String = 'ITEGER'; blnApenasComSaldo: Boolean = False): String;
  Var
    strSQL: String;
Begin
  strSQL := '';

  If fCfgSis('CTLEST', varInteger) = 2 Then // POR ARMAZEM
  Begin
    strSQL := strSQL +   ' IF((SELECT COUNT(*) FROM CADLOT WHERE LOT_CODITE = ITEGER.ITE_CODITE AND LOT_CODEMP = ITEGER.ITE_CODEMP ';
    If blnApenasComSaldo Then
      strSQL := strSQL +   '      AND LOT_SALDOS > 0 ';
    strSQL := strSQL +   ') > 0, ';
    strSQL := strSQL +   '    CAST((SELECT GROUP_CONCAT(LOT_LOCFIS) FROM CADLOT WHERE ';
    strSQL := strSQL +   '      LOT_CODITE = ITEGER.ITE_CODITE AND LOT_CODEMP = ITEGER.ITE_CODEMP AND IFNULL(LOT_LOCFIS, "") <> "" ';
    If blnApenasComSaldo Then
      strSQL := strSQL +   '      AND LOT_SALDOS > 0 ';
    strSQL := strSQL +   ') AS CHAR(255)), ';
    strSQL := strSQL + '      ITEGER.ITE_LOCFIS) ';
  End Else
  Begin
    strSQL := strSQL + '  ITEGER.ITE_LOCFIS ';
  End;

  Result := AnsiReplaceStr(strSQL, 'ITEGER', strAliasIteger);
End;

function fRetornaComposicaoCustoIndices(intValCfg : Integer): TIntArray;
  Var
    intCorre : Integer;
    intValor : Integer;
begin
  SetLength(Result,0);

  intValor := ARR_CFG_COMP_CUSTO_VALCAM[Length(ARR_CFG_COMP_CUSTO_VALCAM)-1]; // 128; // Valor do Maior Byte.
  For intCorre := Length(ARR_CFG_COMP_CUSTO_VALCAM)-1 Downto 0 Do
  Begin
    if (intValCfg >= intValor) Then
    Begin
      SetLength(Result, Succ(Length(Result)));
      Result[Length(Result)-1] := intCorre;
      intValCfg := intValCfg - intValor;
    End;

    intValor  := intValor Div 2;
  End;

End;

function fRetornaComposicaoCustoDisplay(intValCfg : Integer): TStringArray;
