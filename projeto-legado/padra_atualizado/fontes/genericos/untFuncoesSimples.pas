function fPrepareReport(const AReport: TfrxReport; blnOcultarErro: Boolean = False; blnExecEditor: Boolean = False): Boolean;
var
  strErro: String;
begin
  strErro := '';
  Result := False;

  if Assigned(AReport) Then
  Begin
    if (blnOcultarErro and (fCfgSis('PRETRA', varBoolean))) or (blnExecEditor) Then
    Begin
      AReport.EngineOptions.SilentMode := True;
      AReport.EngineOptions.ConvertNulls := False;

      if (not AReport.PrepareReport) Then
      begin
        strErro := '';
        strErro := strErro + 'Nome do Arquivo: ' + AReport.Name + #13#10 + #13#10;
        strErro := strErro + AReport.Errors.Text;

        pGravarErro(True, 'Erro [pPrepareReport]', strErro);

        if (blnExecEditor) Then
          pPrepareReportExibeErro(AReport.Errors);
      End;

      Result := True;
    End
    Else
      Result := AReport.PrepareReport;

  End;
end;

procedure pPrepareReportExibeErro(LErros: TStrings);
var
  LFields: TStringList;
  Regex: TRegEx;
  Match: TMatch;
  I: Integer;
  strMensagem: String;
Begin
  LFields := TStringList.Create;

  Regex := TRegEx.Create('Field not found: (\w+\."[\w\s]+")');

  for I := 0 to LErros.Count - 1 do
  Begin
    Match := Regex.Match(LErros[I]);

    while Match.Success do
    begin
      If LFields.IndexOf(Match.Groups[1].Value) < 0 Then
        LFields.Add(Match.Groups[1].Value);

      Match := Match.NextMatch;
    end;

  End;

  If (LFields.Count > 0) Then
  Begin
    strMensagem := '';

    strMensagem := strMensagem + 'Existem campos utilizados no layout atual ' + #10#13;
    strMensagem := strMensagem + 'que não estão disponiveis para a atual versão do cliente' + #10#13 + #10#13;
    strMensagem := strMensagem +  LFields.Text;
    strMensagem := strMensagem + #10#13;
    strMensagem := strMensagem + 'Caso queira continuar, habilite a configuração: CFG_PRETRA' + #10#13;
    strMensagem := strMensagem + 'Os campos não encontrados serão impressos em branco';

    fMensagem('', strMensagem, ['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 0, 0, 8);
  End;

  FreeAndNil(LFields);
End;

{*******************************************}
{* PEGA O NOME DA MÁQUINA NA REDE          *}
{****************************************MV*}
function fRetNomeRede: String;
  Var
    strNome: PAnsiChar;
    strComp: String;
    intContador: Integer;
    wsa: TWSAData;
begin
  strNome := PAnsiChar(AnsiString(String(fstrEspaco('', 100))));

  //SetLength(strNome, 100);

  WSAStartup(2, wsa);
  gethostname(strNome, 100);
  intContador := 0;
  while (strNome[intContador] <> ' ') And
        (strNome[intContador] <> #0)  Do
  Begin
    strComp := strComp + String(strNome[intContador]);
    Inc(intContador);
  end;
  Result := strComp;
  WSACleanup;
end;

function GetIPAddress: Integer;
var
  Buffer: array[0..255] of AnsiChar;
  RemoteHost: PHostEnt;
begin
  Winsock.GetHostName(@Buffer, 255);
  RemoteHost := Winsock.GetHostByName(Buffer);
  if RemoteHost = nil then
    Result := winsock.htonl($07000001) { 127.0.0.1 }
  else
    Result := longint(pointer(RemoteHost^.h_addr_list^)^);
  Result := Winsock.ntohl(Result);
end;

function GetIPAddressAsString: String;
var
  tempAddress: Integer;
  Buffer: array[0..3] of Byte absolute tempAddress;
  data: WSAData;
begin
  WSAStartup(2, data);
  tempAddress := GetIPAddress;
  Result := Format('%d.%d.%d.%d', [Buffer[3], Buffer[2], Buffer[1], Buffer[0]]);
  WSACleanup;
end;

