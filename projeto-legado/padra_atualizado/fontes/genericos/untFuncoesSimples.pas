function fRetornaTotAliEcfAlq(const fltAliquota: Double): string;
  Var
    fltPerAlq: Double;
    strCodEcf: string;
begin
  Result := '';
  if (not fCampoExiste('ECFALQ', 'ECF_TOTALI', True)) then
    Exit;

  if (fCfgSis('SIMPAU') = 'S') then
    fltPerAlq := fRetornaAliquotaIcmsInternaDoEstado(fCadEmp('ESTADO'))
  else
    fltPerAlq := fltAliquota;

  strCodEcf := fArqIniLocal(0, 'IMPRESSORA_FISCAL', 'IMPRESSORA'   , '', fCfgSis('DIRINI') + '/opcoes_fiscal.ini' );

  Result := fCampoTabela('ECF_TOTALI', 'ECFALQ', ['ECF_CODECF', 'ECF_PERALQ'], [strCodEcf, fltPerAlq]);
end;

procedure pAlteraTotAliEcfAlq(strCodAlq: string);
  Var
    qryAux: TUniQuery;
    fltPerAlq: Double;
    strCodEcf: string;
begin
  if (not fCampoExiste('ECFALQ', 'ECF_TOTALI', True)) then
    Exit;

  fltPerAlq := 0;
  if (Length(strCodAlq) = 7) then
    fltPerAlq := StrToFloatDef(RightStr(strCodAlq, 4), 100) / 100;

  strCodEcf := fArqIniLocal(0, 'IMPRESSORA_FISCAL', 'IMPRESSORA'   , '', fCfgSis('DIRINI') + '/opcoes_fiscal.ini' );

  if (fltPerAlq <= 1) or (fltPerAlq >= 100) or
     (not fEmptyStr(fCampoTabela('ECF_TOTALI', 'ECFALQ', ['ECF_CODECF', 'ECF_PERALQ'], [strCodEcf, fltPerAlq]))) then
    exit;

  qryAux := fCriaQuery();
  try
    qryAux.SQL.Add('UPDATE ECFALQ SET ECF_TOTALI = :TOTALI WHERE ECF_CODECF = :CODECF AND ECF_PERALQ = :PERALQ');
    qryAux.ParamByName('TOTALI').AsString := strCodAlq;
    qryAux.ParamByName('CODECF').AsString := strCodEcf;
    qryAux.ParamByName('PERALQ').AsFloat  := fltPerAlq;
    qryAux.ExecSQL;
  finally
    FreeAndNil(qryAux);
  end;
end;

