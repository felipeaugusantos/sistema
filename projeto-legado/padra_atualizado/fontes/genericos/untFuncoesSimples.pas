function fTeveConsultaSefaz(strTabela, strCampo, strChave: string; var strDtaSef: string): Boolean;
var
  qrySefaz: TUniQuery;
begin
  qrySefaz := fCriaQuery;

  try
    Result := False;
    strDtaSef := EmptyStr;

    qrySefaz.Close;
    qrySefaz.SQL.Clear;
    qrySefaz.SQL.Add('SELECT '+strCampo+' FROM '+strTabela+' WHERE AUTOINCREM = :AUTINC ORDER BY '+strCampo+' DESC');
    qrySefaz.ParamByName('AUTINC').AsString := strChave;
    qrySefaz.Open;

    if (qrySefaz.IsEmpty) or (qrySefaz.FieldByName(strCampo).IsNull) then
      Exit;

    strDtaSef := DateToStr(qrySefaz.FieldByName(strCampo).AsDateTime);
    Result := True;
  finally
    FreeAndNil(qrySefaz);
  end;
end;

