function fRetornarMecanicosServicos(strTabela, strIdeSer, strAutoincrem: String): String;
  var
    qryMecanicos: TUniQuery;
begin
  Result := '';

  Try
    qryMecanicos := fCriaQuery();

    Try
      qryMecanicos.Close();
      qryMecanicos.SQL.Clear();

      If (SameText(strTabela, 'MECGER')) Then
        qryMecanicos.SQL.Add('SELECT REPLACE(IFNULL(GROUP_CONCAT(GER_CODMEC), ""), ",", " / ") AS CODMEC')
      Else If (SameText(strTabela, 'MECGOR')) Then
        qryMecanicos.SQL.Add('SELECT REPLACE(IFNULL(GROUP_CONCAT(FGO_CODMEC), ""), ",", " / ") AS CODMEC');

      qryMecanicos.SQL.Add('FROM ' + strTabela);

      If (SameText(strTabela, 'MECGER')) Then Begin
        qryMecanicos.SQL.Add('WHERE GER_IDESER = :IDESER');
        qryMecanicos.SQL.Add('  AND GER_SEQGER = :AUTOINCREM');
        qryMecanicos.SQL.Add('GROUP BY GER_IDESER ORDER BY GER_IDESER, GER_CODMEC');
      End Else If (SameText(strTabela, 'MECGOR')) Then Begin
        qryMecanicos.SQL.Add('WHERE FGO_IDESER = :IDESER');
        qryMecanicos.SQL.Add('  AND FGO_SEQFGO = :AUTOINCREM');
        qryMecanicos.SQL.Add('GROUP BY FGO_IDESER ORDER BY FGO_IDESER, FGO_CODMEC');
      End;

      qryMecanicos.ParamByName('IDESER').AsString     := strIdeSer;
      qryMecanicos.ParamByName('AUTOINCREM').AsString := strAutoincrem;
      qryMecanicos.Open();

      Result := qryMecanicos.FieldByName('CODMEC').AsString;

    Except
      on E: Exception do begin
        pMensagensErro(E.Message, '[untFuncoesSimples.fRetornarMecanicosServicos]');
      end;
    End;
  Finally
    FreeAndNil(qryMecanicos);
  End;
end;

function fRetornarMecanicos(strTabela, strNumDoc, strEspDoc, strCodCli, strCodEmp: String): String;
  Var
    strNomes, strMecItens: String;
    qryItens, qryMecanicos: TUniQuery;
begin
  Result       := '';
  strMecItens  := '';
  qryItens     := fCriaQuery();
  qryMecanicos := fCriaQuery();

  Try
    If (Not fEmptyStr(strNumDoc)) And (Not fEmptyStr(strEspDoc))
      And (Not fEmptyStr(strCodCli)) And (Not fEmptyStr(strCodEmp)) Then Begin

      qryItens.Close();
      qryItens.SQL.Clear();

      If (Pos('FATDOR', strTabela) > 0) Then Begin
        qryItens.SQL.Add('SELECT AUTOINCREM FROM ' + strTabela);
        qryItens.SQL.Add(' WHERE FDO_NUMDOC = :NUMDOC AND FDO_ESPDOC = :ESPDOC ');
        qryItens.SQL.Add('   AND FDO_CODCLI = :CODCLI AND FDO_CODEMP = :CODEMP ');
      End Else If (Pos('MOVDET', strTabela) > 0) Then Begin
        qryItens.SQL.Add('SELECT AUTOINCREM FROM ' + strTabela);
        qryItens.SQL.Add(' WHERE DET_NUMDOC = :NUMDOC AND DET_ESPDOC = :ESPDOC ');
        qryItens.SQL.Add('   AND DET_CODCLI = :CODCLI AND DET_CODEMP = :CODEMP ');
      END;

      qryItens.ParamByName('NUMDOC').AsString := strNumDoc;
      qryItens.ParamByName('ESPDOC').AsString := strEspDoc;
      qryItens.ParamByName('CODCLI').AsString := strCodCli;
      qryItens.ParamByName('CODEMP').AsString := strCodEmp;

      qryItens.Open();

      If (Not qryItens.IsEmpty) Then Begin
        qryItens.First();

        While (Not qryItens.Eof) Do Begin

          qryMecanicos.Close();
          qryMecanicos.SQL.Clear();

          If (Pos('FATDOR', strTabela) > 0) Then Begin
            qryMecanicos.SQL.Add('SELECT O.OPE_CODOPE AS CODMEC FROM MECDOR MEC ');
            qryMecanicos.SQL.Add(' INNER JOIN ' + strTabela + ' F ON MEC.FDO_SEQFDO = F.AUTOINCREM INNER JOIN CADOPE O ');
            qryMecanicos.SQL.Add(' ON O.OPE_CODOPE = MEC.FDO_CODMEC WHERE MEC.FDO_SEQFDO = :SEQ ORDER BY O.OPE_CODOPE ');
          End Else If (Pos('MOVDET', strTabela) > 0) Then Begin
            qryMecanicos.SQL.Add('SELECT O.OPE_CODOPE AS CODMEC FROM MECDET MEC ');
            qryMecanicos.SQL.Add(' INNER JOIN ' + strTabela + ' D ON MEC.DET_SEQDET = D.AUTOINCREM INNER JOIN CADOPE O ');
            qryMecanicos.SQL.Add(' ON O.OPE_CODOPE = MEC.DET_CODMEC WHERE MEC.DET_SEQDET = :SEQ ORDER BY O.OPE_CODOPE ');
          End;

          qryMecanicos.ParamByName('SEQ').AsString := qryItens.FieldByName('AUTOINCREM').AsString;

          qryMecanicos.Open();

          If (Not qryMecanicos.IsEmpty) Then Begin
            qryMecanicos.First();
            strNomes := '';

            While (Not qryMecanicos.Eof) Do Begin
              strNomes := strNomes + qryMecanicos.FieldByName('CODMEC').AsString + ' / ';
              qryMecanicos.Next();
            End;

            strNomes := Copy(strNomes, 1, Length(strNomes) - 3);

            strMecItens := strMecItens + ' SELECT "' + strNomes + '" AS CODMEC, CAST("' +
              qryItens.FieldByName('AUTOINCREM').AsString + '" AS CHAR(20)) ';

            If (Pos('FATDOR', strTabela) > 0) Then
              strMecItens := strMecItens + ' AS SEQFDO UNION '
            Else If (Pos('MOVDET', strTabela) > 0) Then
              strMecItens := strMecItens + ' AS SEQDET UNION ';
          End;

          qryItens.Next();
        End;

        If (Not fEmptyStr(strMecItens)) Then
          strMecItens := Copy(strMecItens, 1, Length(strMecItens) - 6);

        Result := strMecItens;
      End;
    End;
  Finally
    FreeAndNil(qryItens);
    FreeAndNil(qryMecanicos);
  End;
End;

function fRetDesCDCEST(strCDCEST: String; strCodNCM: string = ''): String;
  Var
    qryCest: TUniQuery;
begin
  qryCest := fCriaQuery();
  Result := '';
  If Not fEmptyStr(strCodNCM) Then
  Begin
    qryCest.SQL.Add('SELECT CAST(C.CES_DESCRI AS CHAR(255)) AS CES_DESCRI FROM CDCEST C ');
    qryCest.SQL.Add(' WHERE C.CES_CDCEST = :CDCEST ');
    qryCest.SQL.Add('   AND CES_CODNCM = LEFT(:CODNCM, LENGTH(CES_CODNCM)) ');

    qryCest.ParamByName('CDCEST').AsString := strCDCEST;
    qryCest.ParamByName('CODNCM').AsString := strCodNCM;
    qryCest.Open;
    Result := AnsiReplaceStr(qryCest.FieldByName('CES_DESCRI').AsString,  '<<csq>>', ' ');
  End;
  If (qryCest.IsEmpty) And (fEmptyStr(strCodNCM)) Then
  Begin
    qryCest.SQL.Clear;
    qryCest.SQL.Add('SELECT CAST(C.CES_DESCRI AS CHAR(255)) AS CES_DESCRI FROM CDCEST C WHERE C.CES_CDCEST = :CDCEST');
    qryCest.ParamByName('CDCEST').AsString := strCDCEST;
    qryCest.Open;
    Result := AnsiReplaceStr(qryCest.FieldByName('CES_DESCRI').AsString,  '<<csq>>', ' ');
  End;
  FreeAndNil(qryCest);
end;

