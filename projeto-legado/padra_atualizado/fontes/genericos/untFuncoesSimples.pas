function fPermiteMesmoDocumentoComFornecedorDiferente(const strOriDoc, strTip_Fc, strCodFor: String): Boolean;
begin
  Result := False;

  If (fEmptyStr(strCodFor)) Then
    Exit;

  If (Not fEmptyStr(strOriDoc)) Then
    Exit;

  If (strTip_Fc <> 'F') Then
    Exit;

  Result := True;
end;

function fDocumentoFiscalJaExiste(const strNumDoc, strEspDoc, strCodEmp, strTip_Fc, strSerie_, strOriDoc: String; const strCliFor: String = ''): Boolean;
  Var
    qryGer : TUniQuery;
    strSQL : String;
begin
  Result := False;

  If (Not fCfgSis('CHKGRV', varBoolean)) Then
    Exit;

    qryGer := fCriaQuery(Nil);
    Try
    strSQL := '';
    strSQL := strSQL + ' SELECT COUNT(*) ';
    strSQL := strSQL + '   FROM ( ';
    strSQL := strSQL + '          SELECT AUTOINCREM ';
    strSQL := strSQL + '            FROM MOVGER ';
    strSQL := strSQL + '           WHERE GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '             AND GER_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '             AND GER_CODEMP = :CODEMP ';
    strSQL := strSQL + '             AND IFNULL(GER_SERIE_, "") = :SERIE_ ';
    strSQL := strSQL + '             AND GER_TIP_FC = :TIP_FC ';
    strSQL := strSQL + '             AND GER_ORIDOC = :ORIDOC ';

    If (fPermiteMesmoDocumentoComFornecedorDiferente(strOriDoc, strTip_Fc, strCliFor)) Then
      strSQL := strSQL + '           AND GER_CODFOR = :CODFOR ';

    strSQL := strSQL + '           UNION ALL ';
    strSQL := strSQL + '          SELECT AUTOINCREM ';
    strSQL := strSQL + '            FROM NOTGER ';
    strSQL := strSQL + '           WHERE GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '             AND GER_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '             AND GER_CODEMP = :CODEMP ';
    strSQL := strSQL + '             AND IFNULL(GER_SERIE_, "") = :SERIE_ ';
    strSQL := strSQL + '             AND GER_TIP_FC = :TIP_FC ';
    strSQL := strSQL + '             AND GER_ORIDOC = :ORIDOC ';

    If (fPermiteMesmoDocumentoComFornecedorDiferente(strOriDoc, strTip_Fc, strCliFor)) Then
      strSQL := strSQL + '           AND GER_CODFOR = :CODFOR ';

    strSQL := strSQL + '        ) AS VW ';

    qryGer.Close;
    qryGer.SQL.Text := strSQL;

    qryGer.ParamByName('NUMDOC').AsString := strNumDoc;
    qryGer.ParamByName('TIP_FC').AsString := strTip_Fc;
    qryGer.ParamByName('ESPDOC').AsString := strEspDoc;
    qryGer.ParamByName('SERIE_').AsString := strSerie_;
    qryGer.ParamByName('CODEMP').AsString := strCodEmp;
    qryGer.ParamByName('ORIDOC').AsString := strOriDoc;

    If (fPermiteMesmoDocumentoComFornecedorDiferente(strOriDoc, strTip_Fc, strCliFor)) Then
      qryGer.ParamByName('CODFOR').AsString := strCliFor;

    qryGer.Open;

    If Not qryGer.IsEmpty Then
      Result := qryGer.Fields[0].AsInteger > 0;

    qryGer.Close;
    Finally
      FreeAndNil(qryGer);
    End;
end;

function fValidaDadosClienteNFe(objDadosNfe: TValidacaoDadosNFe): Boolean;
  Var
    intTamCmpEndere,
    intTamCmpBairro,
    intTamCmpEndEnt,
    intTamCmpBaiEnt,
    intTamCmpRefere,
    intTamCmpEmaNfe: Integer;
    strMsg: String;
    strTmp: String;

    function fCampoInvalido(intTamCampo: Integer; blnCmpEmailOrRefere: Boolean): Boolean;
      Var
        blnTamCmp: Boolean;
    Begin
      If blnCmpEmailOrRefere Then
        blnTamCmp := (intTamCampo > 60)
      Else
        blnTamCmp := ((intTamCampo < 2) Or
                      (intTamCampo > 60));

      Result := (blnTamCmp) And fEhNFE310(objDadosNfe.strEspDoc);
    End;

    function fRetMensagem(intTamCampo: Integer; blnCmpEmailOrRefere: Boolean = False): String;
    Begin
      Result := '';

      If (objDadosNfe.ovOrigem <> ovFaturamento) Or
         (objDadosNfe.blnCliCons) Then
      Begin
        If fCampoInvalido(intTamCampo, blnCmpEmailOrRefere) Then
        Begin
          Result := strMsg + 'informado deve conter ' + IIF(blnCmpEmailOrRefere, 'até', 'entre 2 à') + ' 60 caracteres no qual é permitido pela nota fiscal eletrônica.' +
                    IIF(intTamCampo > 60, IIF(Not blnCmpEmailOrRefere, #13#10, ' ') + 'Favor abreviar o mesmo, para que a nota eletrônica seja autorizada.', '');
        End;
      End
      Else
      Begin
        If fCampoInvalido(intTamCampo, blnCmpEmailOrRefere) Then
          Result := strMsg + 'informado deve conter ' + IIF(blnCmpEmailOrRefere, 'até', 'entre 2 à') + ' 60 caracteres no qual é permitido pela nota fiscal eletrônica.';
      End;
    End;
Begin
  Result := True;

  With objDadosNfe Do
  Begin
    stlMensagens.Clear;

    intTamCmpEndere := Length(Trim(strEndere));
    intTamCmpBairro := Length(Trim(strBairro));
    intTamCmpEndEnt := Length(Trim(strEndEnt));
    intTamCmpBaiEnt := Length(Trim(strBaiEnt));
    intTamCmpEmaNfe := Length(Trim(strEmaNfe));
    intTamCmpRefere := Length(Trim(strRefere));

    If (ovOrigem = ovFaturamento) Then
    Begin
      If (Not blnSomenteItensRetira) Then
      Begin
        strMsg := 'O Endereço de Entrega ';
        strTmp := fRetMensagem(intTamCmpEndEnt);

        If Not fEmptyStr(strTmp) Then
          stlMensagens.Add(strTmp);
      End;

      If (Not blnSomenteItensRetira) Then
      Begin
        strMsg := 'O Bairro de Entrega ';
        strTmp := fRetMensagem(intTamCmpBaiEnt);

        If Not fEmptyStr(strTmp) Then
          stlMensagens.Add(strTmp);
      End;

      If (Not blnSomenteItensRetira) And (intTamCmpRefere <> 0) Then
      Begin
        strMsg := 'A Referência do Endereço de Entrega ';
        strTmp := fRetMensagem(intTamCmpRefere, True);

        If Not fEmptyStr(strTmp) Then
          stlMensagens.Add(strTmp);
      End;

      strMsg := 'O Endereço ';
      strTmp := fRetMensagem(intTamCmpEndere);

      If Not fEmptyStr(strTmp) Then
        stlMensagens.Add(strTmp);

      strMsg := 'O Bairro ';
      strTmp := fRetMensagem(intTamCmpBairro);

      If Not fEmptyStr(strTmp) Then
        stlMensagens.Add(strTmp);

      strMsg := 'O Email Nfe ';
      strTmp := fRetMensagem(intTamCmpEmaNfe, True);

      If Not fEmptyStr(strTmp) Then
        stlMensagens.Add(strTmp);

      If (stlMensagens.Count > 0) Then
      Begin
        stlMensagens.Add('');
        stlMensagens.Add('Se continuar a nota fiscal eletrônica será rejeitada pela Receita. ' +
                         'Será necessário corrigir o(s) dado(s) e reenviar a nota novamente pelo PainelNFe. ' +
                         'Deseja continuar?');
        Result := False;
      End;
    End
    Else
    Begin
      If (ovOrigem = ovCadEndEnt) Then
      Begin
        If intTamCmpEndEnt <> 0 Then
        Begin
          strMsg := 'O Endereço de Entrega ';
          strTmp := fRetMensagem(intTamCmpEndEnt);

          If Not fEmptyStr(strTmp) Then
          Begin
            pMensagemOK(strTmp);
            Result := False;
          End;
        End
        Else If intTamCmpBaiEnt <> 0 Then
        Begin
          strMsg := 'O Bairro de Entrega ';
          strTmp := fRetMensagem(intTamCmpBaiEnt);

          If Not fEmptyStr(strTmp) Then
          Begin
            pMensagemOK(strTmp);
            Result := False;
          End;
        End
        Else If intTamCmpRefere <> 0 Then
        Begin
          strMsg := 'A Referência do Endereço de Entrega ';
          strTmp := fRetMensagem(intTamCmpRefere, True);

          If Not fEmptyStr(strTmp) Then
          Begin
            pMensagemOK(strTmp);
            Result := False;
          End;
        End;
      End
      Else
      Begin
        If intTamCmpEndere <> 0 Then
        Begin
          strMsg := 'O Endereço ';
          strTmp := fRetMensagem(intTamCmpEndere);

          If Not fEmptyStr(strTmp) Then
          Begin
            pMensagemOK(strTmp);
            Result := False;
          End;
        End
        Else If intTamCmpBairro <> 0 Then
        Begin
          strMsg := 'O Bairro ';
          strTmp := fRetMensagem(intTamCmpBairro);

          If Not fEmptyStr(strTmp) Then
          Begin
            pMensagemOK(strTmp);
            Result := False;
          End;
        End
        Else If intTamCmpEmaNfe <> 0 Then
        Begin
          strMsg := 'O Email Nfe ' + IIF(tcTipoCampo = tcEmail2, '2 ', '');
          strTmp := fRetMensagem(intTamCmpEmaNfe, True);

          If Not fEmptyStr(strTmp) Then
          Begin
            pMensagemOK(strTmp);
            Result := False;
          End;
        End;
      End;
    End;
  End;
End;

