function fRetNumeroPreNota(strAutInc: String; blnLista: Boolean): String;
  Var
    qryGerEle: TUniQuery;
Begin
  Result := strAutInc;

  qryGerEle := fCriaQuery(Nil);
  With qryGerEle, SQL Do
  Begin
    Add('SELECT SQL_NO_CACHE');
    Add('  GROUP_CONCAT(CONCAT(B08_NNF, "-", GER_CODEMP)) AS NOTAS');
    Add('FROM');
    Add('  GERELE');
    Add('WHERE ');

    If blnLista Then
    Begin
      Add('  AUTOINCREM IN (' + strAutInc + ')');
    End Else
    Begin
      Add('  AUTOINCREM = :AUTINC ');

      ParamByName('AUTINC').AsString := strAutInc;
    End;

    Open;

    If Not IsEmpty Then
      Result := FieldByName('NOTAS').AsString;

  End;

  FreeAndNil(qryGerEle);
End;

function fRetNumerosPreNotas(strNumPed, strEspDoc, strCodEmp: String): String;
  Var
    qryGerEle: TUniQuery;
Begin
  Result := '';

  qryGerEle := fCriaQuery(Nil);
  With qryGerEle, SQL Do
  Begin
    Add('SELECT CONCAT(B08_NNF, "-", GER_CODEMP, ";") AS NOTA FROM GERELE');
    Add(' WHERE AUTOINCREM IN (SELECT PEL_SEQELE ');
    Add('                        FROM PEDELE ');
    Add('                       WHERE PEL_NUMDOC = :NUMDOC ');
    Add('                         AND PEL_CODEMP = :CODEMP ');
    Add('                         AND PEL_ESPDOC = :ESPDOC )');

    qryGerEle.ParamByName('NUMDOC').AsString := strNumPed;
    qryGerEle.ParamByName('CODEMP').AsString := strCodEmp;
    qryGerEle.ParamByName('ESPDOC').AsString := strEspDoc;

    qryGerEle.Open;

    While not qryGerEle.Eof Do
    Begin
      Result := Result + FieldByName('NOTA').AsString;
      qryGErEle.Next;
    End;
  End;

  FreeAndNil(qryGerEle);
End;

