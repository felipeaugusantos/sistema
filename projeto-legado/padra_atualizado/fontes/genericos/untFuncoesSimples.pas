function fDocumentoFaturado(const strNumDoc, strEspDoc, strCodEmp, strCodCli: string; const strTabela: string = 'MOVGER'): boolean;
  var
    qryDocumento : TUniQuery;
begin
  if fEmptyStr(strNumDoc) then
    Exit(False);

  if fEmptyStr(strTabela) then
    Exit(False);

  if (not MatchStr(strTabela, ['MOVGER', 'NOTGER'])) then
    Exit(False);

  qryDocumento := fCriaQuery;
  Try
    qryDocumento.SQL.Add(' SELECT GER_JAFATU ');
    qryDocumento.SQL.Add('   FROM ' + strTabela );
    qryDocumento.SQL.Add('  WHERE GER_NUMDOC = :NUMDOC ');
    qryDocumento.SQL.Add('    AND GER_ESPDOC = :ESPDOC ');
    qryDocumento.SQL.Add('    AND GER_CODEMP = :CODEMP ');
    qryDocumento.SQL.Add('    AND GER_CODCLI = :CODCLI ');
    qryDocumento.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDocumento.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDocumento.ParamByName('CODEMP').AsString := strCodEmp;
    qryDocumento.ParamByName('CODCLI').AsString := strCodCli;
    qryDocumento.Open;
    if (not qryDocumento.IsEmpty) then
    begin
      If (qryDocumento.FieldByName('GER_JAFATU').DataType = ftInteger) Then
        Result := (qryDocumento.FieldByName('GER_JAFATU').AsInteger = 1)
      else
        Result := (qryDocumento.FieldByName('GER_JAFATU').AsBoolean);
    end
    else
      Result := False;
    qryDocumento.Close;
  Finally
    FreeAndNil(qryDocumento);
  End;
end;

