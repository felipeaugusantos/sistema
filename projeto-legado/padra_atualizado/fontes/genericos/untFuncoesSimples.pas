function fRetFornecedorDTO(strCodFor: String): TFornecedorDTO;
var
  qryGenFor: TUniQuery;
Begin
  try
    Result.Codigo := '0';
    qryGenFor := fCriaQuery;

    qryGenFor.SQL.Add('SELECT SQL_NO_CACHE * ');
    qryGenFor.SQL.Add('FROM CADFOR ');
    qryGenFor.SQL.Add('WHERE FOR_CODFOR = :CODFOR ');
    qryGenFor.ParamByName('CODFOR').AsString := strCodFor;
    qryGenFor.Open;

    If not qryGenFor.IsEmpty Then
    begin
      Result.Codigo:= qryGenFor.FieldByName('FOR_CODFOR').AsString;
      Result.Nome:= qryGenFor.FieldByName('FOR_NOMFOR').AsString;
      Result.CondPagamento:= qryGenFor.FieldByName('FOR_CNDPAG').AsString;
      Result.Portador:= qryGenFor.FieldByName('FOR_CODPOR').AsString;
      Result.PlanoContas:= qryGenFor.FieldByName('FOR_CODCTA').AsString;
    end;
    qryGenFor.Close;

  Finally
    FreeAndNil(qryGenFor);
  End;


end;

