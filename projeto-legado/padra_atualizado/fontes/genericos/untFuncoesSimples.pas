function fRetornaInformacaoVenda(strNumDoc, strEspDoc, strCodEmp, strCampo: String): String;
begin
  Result := fRetornaInformacaoVenda(strNumDoc, strEspDoc, strCodEmp, '', strCampo);
end;

function fRetornaInformacaoVenda(strNumDoc, strEspDoc, strCodEmp, strCodCli, strCampo: String): String; overload;
  Const
    ARRTABELAS: Array[1..6] Of String = ('FATGOR', 'MOVGER', 'NOTGER', 'DEL_FATGOR', 'DEL_MOVGER', 'DEL_NOTGER');
  Var
    qryGen: TUniQuery;
    intTab: Integer;
    strAbvTab: String;
    strCampoAux: String;

  function fGetSQL(strTabela: String): String;
  begin

    Result := '';
    Result := Result + 'SELECT ' + strCampoAux + ' AS CAMPO ';
    Result := Result + 'FROM   ' + strTabela + '       ';
    Result := Result + 'WHERE  ' + strAbvTab + 'NUMDOC = "' + strNumDoc + '" AND ';
    Result := Result + '       ' + strAbvTab + 'ESPDOC = "' + strEspDoc + '" AND ';
    Result := Result + '       ' + strAbvTab + 'CODEMP = "' + strCodEmp + '"     ';

    If Not strCodCli.IsEmpty Then
      Result := Result + ' AND ' + strAbvTab + 'CODCLI = "' + strCodCli + '"     ';

    If Pos('FATGOR', strTabela) <= 0 Then
      Result := Result + ' AND ' + strAbvTab + 'TIP_FC = "C" ';
  end;

begin
  Result := '';

  qryGen := fCriaQuery;

  With qryGen, SQL Do
  Begin
    For intTab := Low(ARRTABELAS) To High(ARRTABELAS) Do
    Begin
      If (Pos('FATGOR', ARRTABELAS[intTab]) > 0) And (Pos(strEspDoc, 'PD_OR_') <= 0) Then
        Continue;

      If Pos('FATGOR', ARRTABELAS[intTab]) > 0 Then strAbvTab := 'FGO_' Else strAbvTab := 'GER_';

      strCampoAux := AnsiReplaceStr(strCampo, strAbvTab, '');

      If strCampoAux <> 'AUTOINCREM' Then
        strCampoAux := strAbvTab + strCampoAux;

      If Not fCampoExiste(ARRTABELAS[intTab], strCampoAux) Then
        Continue;

      Clear;
      Add(fGetSQL(ARRTABELAS[intTab]));
      Open;

      Result := FieldByName('CAMPO').AsString;

      If Not fEmptyStr(Result) Then
        Break;
    End;
  End;

  FreeAndNil(qryGen);
end;

function fSQLWhereUltimasVendas(blnFiltraEmpresa, blnENTBRF, blnLimitaMeses, blnDtaCorte, blnEmpresaAcesso: Boolean): String;
  Var
    strSQL: String;
Begin
  If blnLimitaMeses And (fCfgSis('ULTVEN', VarInteger) > 0) Then
  Begin
    strSQL := strSQL + '  D.DET_DTAENT >= :DTAINI AND ';
  End;

  strSQL := strSQL + '  D.DET_CODCLI NOT IN (' + VS_strCliFil + ') AND ';
  strSQL := strSQL + '  D.DET_TIP_FC = "C"          AND ';
  strSQL := strSQL + '  IFNULL(D.DET_PROEMB, "N") <> "S" AND ';
  strSQL := strSQL + '  D.DET_CODITE = :CODITE      AND ';

  If (Not blnFiltraEmpresa) And blnEmpresaAcesso Then
    strSQL := strSQL + '  D.DET_CODEMP IN (:CODEMP) AND '
  Else
    strSQL := strSQL + '  D.DET_CODEMP = :CODEMP AND ';

  strSQL := strSQL + '  ((LOCATE(DET_CLAFIS, :CLAFIS) > 0) OR (LOCATE(DET_CLAFIS, :CLADEV) > 0) OR (DET_ESPDOC = "ML" AND DET_ORIDOC="V") ';

  If blnENTBRF Then
    strSQL := strSQL + ' OR (DET_ESPDOC = "BR") OR LOCATE(D.DET_CLAFIS,' + CLAFIS_BR + ')) '
  Else
    strSQL := strSQL + ') ';

  If blnDtaCorte Then
    strSQL := strSQL + ' AND D.DET_DTAENT >= :DTACOR ';

  Result := strSQL;
End;

function fSQLUltimasVendas(intLimite: Integer; blnFiltraEmpresa, blnENTBRF, blnLimitaMeses: Boolean; blnDtaCorte: Boolean = False): String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + 'SELECT  ';
  strSQL := strSQL + '  SUM(IF(D.DET_ESPDOC="ML", 1, IF(IFNULL(I.ITE_CNV_ML,0) = 0, 1, I.ITE_CNV_ML)) * IF(LEFT(D.DET_CLAFIS,1) < 5, -1, 1 ) * D.DET_QTDITE) AS QTDITE, ';
  strSQL := strSQL + '  SUM(IF((DET_ESPDOC = "BR") OR LOCATE(D.DET_CLAFIS,' + CLAFIS_BR + '), 0, IF(LEFT(D.DET_CLAFIS,1) < 5, -(D.DET_TOTITE - D.DET_DESESP - D.DET_DESCFF), D.DET_TOTITE - D.DET_DESESP - D.DET_DESCFF))) AS PR_TOTAL, ';
  strSQL := strSQL + '  D.DET_DTAENT AS "DTA_MOV",  ';
  strSQL := strSQL + '  D.DET_HORENT AS "HOR_MOV",  ';
  strSQL := strSQL + '  F.FPG_DESCRI AS "FOR_PAG",  ';
  strSQL := strSQL + '  IF(D.DET_ESPDOC="ML", D.DET_NUMFAT, D.DET_NUMDOC) AS NUMDOC, ';
  strSQL := strSQL + '  IF(D.DET_ESPDOC="ML", D.DET_TIPFAT, D.DET_ESPDOC) AS ESPDOC, ';
  strSQL := strSQL + '  IF(D.DET_ESPDOC="ML", D.DET_EMPFAT, D.DET_CODEMP) AS CODEMP, ';
  strSQL := strSQL + '  CLI_NOMCLI AS "CLIENTE", ';
  strSQL := strSQL + '  CLI_CODCLI   AS CODCLI, ';
  strSQL := strSQL + '  I.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '  I.ITE_CODGRU AS CODGRU, ';
  strSQL := strSQL + '  D.DET_CLAFIS AS CLAFIS, ';
  strSQL := strSQL + '  IF((DET_ESPDOC = "BR") OR LOCATE(D.DET_CLAFIS,' + CLAFIS_BR + '), 0, (D.DET_TOTITE - D.DET_DESESP) / D.DET_QTDITE) AS "PR_UNITARIO",  ';
  strSQL := strSQL + '  CONCAT(D.DET_CODVEN, " - ", V.OPE_NOMOPE) AS VENDEDOR,  ';
  strSQL := strSQL + '  IF(D.DET_CODCND IS NULL, D.DET_CONPAG, CONCAT(D.DET_CODCND, " - ", D.DET_CONPAG)) AS CONPAG  ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADITE I ';
  strSQL := strSQL + '  INNER JOIN CADUNI U ON U.UNI_CODUNI = I.ITE_CODUNI ';
  strSQL := strSQL + '  JOIN MOVDET       D ON D.DET_CODITE = I.ITE_CODITE ';
  strSQL := strSQL + '  JOIN CADCLI         ON D.DET_CODCLI = CLI_CODCLI   ';
  strSQL := strSQL + '  LEFT JOIN CADOPE  V ON D.DET_CODVEN = V.OPE_CODOPE ';
  strSQL := strSQL + '  INNER JOIN MOVGER G ON (G.AUTOINCREM = D.DET_SEQGER) ';
  strSQL := strSQL + '  LEFT JOIN CADFPG F ON (F.FPG_CODIGO = G.GER_CODFPG) ';
  strSQL := strSQL + 'WHERE ';

  strSQL := strSQL + fSQLWhereUltimasVendas(blnFiltraEmpresa, blnENTBRF, blnLimitaMeses, blnDtaCorte, Not(blnFiltraEmpresa));

  strSQL := strSQL + 'GROUP BY ';
  strSQL := strSQL + '  D.DET_NUMDOC, D.DET_ESPDOC, D.DET_CODEMP, D.DET_CODCLI, D.DET_UNITAR ';

  strSQL := strSQL + 'ORDER BY        ';
  strSQL := strSQL + '  DTA_MOV DESC, HOR_MOV DESC  ';
  strSQL := strSQL + 'LIMIT ' + IntToStr(intLimite);

  Result := strSQL;
End;

