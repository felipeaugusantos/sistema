end;

procedure pGravaLogCadCar(AqryDados: TUniQuery);
var
  LqryLog: TUniQuery ;
  LstrCmd: string ;
  LstrNomeParam: string ;
  LstrValorParam: string ;
  LstrDados: string ;
  LintCnt: integer ;
  LmrkPosicao : TBookmark;
begin
  LqryLog := fCriaQuery() ;
  try
    LqryLog.close ;
    LqryLog.sql.Clear ;
    LqryLog.sql.Add('SELECT * FROM LOGCAR WHERE FALSE ') ;
    LqryLog.open ;

    // loga os comando
    LstrCmd := AqryDados.SQL.Text ;

    // loga o nome dos parametros
    LstrNomeParam := '';
    for LintCnt := 0 to AqryDados.ParamCount-1 do
    begin
      LstrNomeParam := LstrNomeParam + AqryDados.Params.Items[LintCnt].Name + ';' ;
    end ;

    // loga o valor dos parametros
    LstrValorParam := '';
    for LintCnt := 0 to AqryDados.ParamCount-1 do
    begin
      LstrValorParam := LstrValorParam + AqryDados.Params.Items[LintCnt].AsString + ';' ;
    end ;

    // loga os dados de retorno
    if (AqryDados.Active) and (not AqryDados.IsEmpty) then
    begin
      LstrDados := '';
      LmrkPosicao := AqryDados.GetBookmark;
      try
        AqryDados.First ;
        while not AqryDados.Eof do
        begin
          for LintCnt := 0 to AqryDados.FieldCount-1 do
          begin
            LstrDados := LstrDados + AqryDados.Fields.Fields[LintCnt].AsString + ';' ;
          end ;
          LstrDados := LstrDados + #13 ;
          AqryDados.Next ;
        end ;
      finally
        AqryDados.GotoBookmark(LmrkPosicao);
      end ;
    end
    else
    begin
      LstrDados := 'Sem Retorno';
    end ;
    //

    LqryLog.Append ;
    LqryLog.FieldByName('LOG_DTACAD').AsDateTime := VS_DATE ;
    LqryLog.FieldByName('LOG_HRACAD').AsDateTime := fTime();
    LqryLog.FieldByName('LOG_CODEMP').AsString := VS_strCodEmp ;
    LqryLog.FieldByName('LOG_CODOPE').AsString := strLoginUsuarioLogado ;
    LqryLog.FieldByName('LOG_COMAND').AsString := 'SQL:' + LstrCmd + #13 +
                                                  'Parametros: ' + LstrNomeParam + #13 +
                                                  'Parametros Val: ' + LstrValorParam + #13 +
                                                  'Dados: ' + LstrDados ;
    LqryLog.Post ;

  finally
    FreeAndNil(LqryLog) ;
  end ;
end ;

