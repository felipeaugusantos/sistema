function fMontaReciboPer(strTexto: string): String;
var
  intContador, intContT : Integer;
  strReciboP : String;
  blnTransf : Boolean;

begin
  Result := '';
  intContT := 0;
  strReciboP := '';
  blnTransf := True;


 For intContador := 1 To Length(strTexto) Do
 begin
    if (intContT <> 3 ) then
    Begin
       if (strTexto[intContador] <> '-' ) then
      Begin
        If (intContT = 1) Then
         strReciboP := strReciboP + '-';

	      strReciboP := strReciboP + strTexto[intContador];
        intContT := 0;
      End
      else if (strTexto[intContador] = '-' ) Then
      Begin
        intContT := intContT + 1;
        blnTransf := True;
      End
    End
    else
    Begin
      If (blnTransf) Then
      Begin
        If (strTexto[intContador] = 'T' ) and (strTexto[intContador + 1] = 'R' )  Then
        Begin
          blnTransf := False;
          intContT := 0;
          strReciboP := strReciboP + 'T' ;
        End
      End
    End
 end;

  Result := strReciboP;
end;
