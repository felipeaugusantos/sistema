function fTemADPendenteDocto(strCodEmp, strCodCli, strNumDoc, strEspDoc, strSerie: String; blnShowMsg: Boolean = False):Boolean;
var
  qryAD          : TUniQuery;
  strOcorrVenDev : String;
begin
  Result := False;

  If (Not fCfgSis('UTI_AD', VarBoolean)) Or (Not fCfgSis('UTICRM', VarBoolean)) Then
    Exit;

  qryAD := fCriaQuery();

  Try
    strOcorrVenDev := fCfgSis('VENDEV', VarString);

    If (Not fEmptyStr(strOcorrVenDev)) Then
    Begin
      qryAD.SQL.Add('SELECT                                   ');
      qryAD.SQL.Add('  AG.GER_CODADE                          ');
      qryAD.SQL.Add('FROM                                     ');
      qryAD.SQL.Add('  ADEGER AG                              ');
      qryAD.SQL.Add('  INNER JOIN ADEDET AD                   ');
      qryAD.SQL.Add('    ON (AG.GER_CODADE = AD.DET_CODADE)   ');
      qryAD.SQL.Add('  LEFT JOIN MOVOCO MO                    ');
      qryAD.SQL.Add('    ON (MO.OCO_CODOCO = AG.GER_CODOCO)   ');
      qryAD.SQL.Add('WHERE AD.DET_CODEMP=:CODEMP              ');
      qryAD.SQL.Add('  AND AD.DET_NUMDOC=:NUMDOC              ');
      qryAD.SQL.Add('  AND AD.DET_ESPDOC=:ESPDOC              ');
      qryAD.SQL.Add('  AND AD.DET_SERIE_=:SERIE_              ');
      qryAD.SQL.Add('  AND MO.OCO_CODCLI=:CODCLI              ');
      qryAD.SQL.Add('  AND MO.OCO_CODTOC=:CODTOC              ');
      qryAD.SQL.Add('  AND AG.GER_DOCDEV IS NULL              ');
      qryAD.SQL.Add('  AND AD.DET_FORCLI IS NOT NULL          ');
      qryAD.SQL.Add('  AND AD.DET_TIP_FC = "C"                ');
      qryAD.SQL.Add('LIMIT 1                                  ');

      qryAD.ParamByName('CODEMP').AsString := strCodEmp;
      qryAD.ParamByName('CODCLI').AsString := strCodCli;
      qryAD.ParamByName('CODTOC').AsString := strOcorrVenDev;
      qryAD.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAD.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAD.ParamByName('SERIE_').AsString := strSerie;

      qryAD.Open;

      If (Not qryAD.IsEmpty) Then
      Begin
        If (blnShowMsg) Then
        Begin
          fMensagem('ATENÇÃO!',
                    'Existe AD em aberto para este cliente no documento selecionado.'+ #10+#13 +
                    'Nº AD: ' + qryAD.FieldByName('GER_CODADE').AsString + #10+#13 +
                    'Não será permitido realizar esta operação com digitação de senha.' + #10+#13 +
                    'Utilize a AD existente para continuar a emissão da Devolução.',
                    ['&O k']);
        End;

        Result := True;
      End;
    End;
  Finally
    FreeAndNil(qryAD);
  End;
end;


