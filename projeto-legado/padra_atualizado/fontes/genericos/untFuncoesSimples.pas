function fRetornaCodEquOSPedido(strNumPed, strEspDoc, strEmpPed: String): String;
var
  qryEquGer: TUniQuery;
begin
  Result := '';

  if fEmptyStr(strNumPed) then
    Exit;

  qryEquGer :=  fCriaQuery;

  try
    qryEquGer.Close;
    qryEquGer.SQL.Clear;
    qryEquGer.SQL.Add('SELECT        ');
    qryEquGer.SQL.Add('  EQU_CODEQU  ');
    qryEquGer.SQL.Add('FROM EQUGER      ');
    qryEquGer.SQL.Add('WHERE (EQU_NUMPED = :NUMDOC AND ');
    qryEquGer.SQL.Add('  EQU_TIPPED = :ESPDOC AND ');
    qryEquGer.SQL.Add('  EQU_EMPPED = :CODEMP     ');
    qryEquGer.SQL.Add('   ) OR (EXISTS (SELECT FGO_SEQEQU FROM EQUGOR ');
    qryEquGer.SQL.Add('                 LEFT JOIN FATGOR ON EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ');
    qryEquGer.SQL.Add('                 WHERE EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU AND ');
    qryEquGer.SQL.Add('                     FGO_NUMDOC = :NUMDOC AND ');
    qryEquGer.SQL.Add('                     FGO_ESPDOC = :ESPDOC AND ');
    qryEquGer.SQL.Add('                     FGO_CODEMP = :CODEMP))   ');

    qryEquGer.ParamByName('NUMDOC').AsString := strNumPed;
    qryEquGer.ParamByName('ESPDOC').AsString := strEspDoc;
    qryEquGer.ParamByName('CODEMP').AsString := strEmpPed;

    qryEquGer.Open;

    if (not qryEquGer.IsEmpty) then
      Result := qryEquGer.FieldByName('EQU_CODEQU').AsString;
  finally
    FreeAndNil(qryEquGer);
  end;
end;

function fVerificaPermanenciaOrcPorVend(strCodCli, strCodVen, strNumOrc: String): Boolean;
Var
  qryTemp: TUniQuery;
  qtDiasUltimoOr: Integer;
  strNumDoc,
  strEmpDoc,
  strEspDoc: String;

  function fClienteFilial(strCodCli: String): Boolean;
  begin
    Result := (fCampoTabela('COUNT(*)', 'CADEMP', ['EMP_CLIFIL'], [strCodCli], False) > 0);
  end;

begin
  Result := True;

  If (fEmptyStr(strCodCli) or fEmptyStr(strCodVen)) Then
  Begin
    Exit;
  End;

  If fClienteConsumidor(fRetNomCliente(strCodCli), True, True) Or fClienteFilial(strCodCli) Then
  Begin
    Exit;
  End;

  qryTemp := fCriaQuery(nil);
  Try
    qryTemp.Close;
    qryTemp.SQL.Clear;
    qryTemp.SQL.Add('SELECT SQL_NO_CACHE       ');
    qryTemp.SQL.Add('  FGO_CODEMP,             ');
    qryTemp.SQL.Add('  FGO_NUMDOC,             ');
    qryTemp.SQL.Add('  FGO_ESPDOC,             ');
    qryTemp.SQL.Add('  FGO_DTAENT              ');
    qryTemp.SQL.Add('FROM                      ');
    qryTemp.SQL.Add('  FATGOR                  ');
    qryTemp.SQL.Add('WHERE                     ');
    qryTemp.SQL.Add('  FGO_CODEMP = :CODEMP AND');
    qryTemp.SQL.Add('  FGO_CODCLI = :CODCLI AND');
    qryTemp.SQL.Add('  FGO_CODVEN = :CODVEN AND');
    qryTemp.SQL.Add('  FGO_JAFATU = 0       AND');
    qryTemp.SQL.Add('  FGO_ESPDOC =  "OR"      ');
    If Not fEmptyStr(strNumOrc) Then
      qryTemp.SQL.Add(' AND FGO_NUMDOC <> :NUMDOC ');
    qryTemp.SQL.Add('ORDER BY');
    qryTemp.SQL.Add('  AUTOINCREM DESC');
    qryTemp.SQL.Add('LIMIT 1');

    qryTemp.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryTemp.ParamByName('CODCLI').AsString := strCodCli;
    qryTemp.ParamByName('CODVEN').AsString := strCodVen;
    If Not fEmptyStr(strNumOrc) Then
      qryTemp.ParamByName('NUMDOC').AsString := strNumOrc;

    qryTemp.Open;
    If Not qryTemp.IsEmpty Then
    Begin
      qtDiasUltimoOr := DaysBetween(VS_Date, qryTemp.FieldByName('FGO_DTAENT').AsDateTime);

      If (qtDiasUltimoOr <= fCfgSis('QTDPOR', varInteger)) And (qtDiasUltimoOr > 0) Then
        Result := True
      Else
      Begin
        Result := False;
        strNumDoc := qryTemp.FieldByName('FGO_NUMDOC').AsString;
        strEspDoc := qryTemp.FieldByName('FGO_ESPDOC').AsString;
        strEmpDoc := qryTemp.FieldByName('FGO_CODEMP').AsString;

        fMensagem('ATENÇÃO!', 'Já existe o Orçamento '+ strNumDoc + '-OR-' + strEmpDoc +  ' ' +
                              'em aberto há ' + IntToStr(qtDiasUltimoOr) + ' dias. ' +
                              'Não será permitido criar um novo Orçamento para este Cliente/Vendedor. ' +
                              'É necessário transformá-lo em Pedido de Venda ou baixá-lo para liberar esta trava.'  , ['&O k']);
      End;
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

function fQtdeItemReqAberta(strCodIte, strEmpIte: String): Double;
var
  strSQL: String;
  qryAux: TUniQuery;
begin
  Result := 0;
  qryAux := fCriaQuery;

  try
    strSQL := '';
    strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '     SUM(M.RCD_QTDITE) AS QTDREQ, ';
    strSQL := strSQL + '     IFNULL(SUM(B.BAI_QTDREQ), 0) AS QTDBAI ';
    strSQL := strSQL + ' FROM FATDOR F ';
    strSQL := strSQL + ' JOIN MOVRCD M ON F.FDO_NUMDOC = M.RCD_DOCPDV AND ';
    strSQL := strSQL + '                  F.FDO_ESPDOC = M.RCD_ESPPDV AND ';
    strSQL := strSQL + '                  F.FDO_CODEMP = M.RCD_EMPPDV AND ';
    strSQL := strSQL + '                  F.FDO_CODITE = M.RCD_CODITE ';
    strSQL := strSQL + ' LEFT JOIN BAIREQ B ON M.AUTOINCREM = BAI_AUTREQ ';
    strSQL := strSQL + ' WHERE RCD_REQNEG <> "S" ';
    strSQL := strSQL + '     AND RCD_CODITE = :CODITE ';
    strSQL := strSQL + '     AND RCD_EMPPDV = :CODEMP ';

    qryAux.SQL.Text := strSQL;                                                                            qryAux.ParamByName('CODITE').AsString := strCodIte;
    qryAux.ParamByName('CODEMP').AsString := strEmpIte;
    qryAux.Open;

    if (not qryAux.IsEmpty) then
      Result := qryAux.FieldByName('QTDREQ').AsFloat - qryAux.FieldByName('QTDBAI').AsFloat;
  finally
    FreeAndNil(qryAux);
  end;
end;

