{***************************************************************}
{* VERIFICA SE A EMPRESA ESTÁ MARCADA NO CADASTRO DO PORTADOR. *}
{* (TAMBÉM É ACEITO CASO NENHUMA ESTEJA MARCADA NO CADASTRO).  *}
{* SE A EMPRESA NÃO FOR INFORMADA, CONSIDERA A LOGADA.         *}
{*REQ*145940*************************************************RP*}
function fEmpresaTemAcessoPortador(strCodPor: String; strCodEmp: String = ''): Boolean;
  Var
    strSql: String;
    qryTmp: TUniQuery;
begin
  qryTmp := fCriaQuery(Nil);
  Try
    strSql := '';
    strSql := strSql + ' SELECT POR_EMPACE ';
    strSql := strSql + ' FROM ';
    strSql := strSql + '   CADPOR ';
    strSql := strSql + ' WHERE ';
    strSql := strSql + '   POR_CODPOR = :CODIGO ';

    With qryTmp Do
    Begin
      SQL.Add(strSql);
      ParamByName('CODIGO').AsString := strCodPor;
      Open;

      If Not fEmptyStr(FieldByName('POR_EMPACE').AsString) Then
      Begin
        If fEmptyStr(strCodEmp) Then
          strCodEmp := VS_strCodEmp;

        Result := Pos(strCodEmp, FieldByName('POR_EMPACE').AsString) > 0;
      End
      Else
        Result := True; //OK caso nenhuma esteja marcada

      Close;
    End;
  Finally
    FreeAndNil(qryTmp);
  End;
end;

function fEmpresaTemAcessoPortador(ACodPor: String; AConsultasArray: TConsultasArray) : Boolean; Overload;
  Var
    LSql: String;
    LCadPor: TUniQuery;
    LCnt: Integer;
    LEmpresaSemAcesso: String;
begin
  LCadPor := fCriaQuery(Nil);
  Result := True;
  Try
    LSql := '';
    LSql := LSql + ' SELECT POR_EMPACE ';
    LSql := LSql + ' FROM ';
    LSql := LSql + '   CADPOR ';
    LSql := LSql + ' WHERE ';
    LSql := LSql + '   POR_CODPOR = :CODIGO ';

    LCadPor.SQL.Add(LSql);
    LCadPor.ParamByName('CODIGO').AsString := ACodPor;
    LCadPor.Open;

    If Not fEmptyStr(LCadPor.FieldByName('POR_EMPACE').AsString) Then
    Begin
      For LCnt := Low(AConsultasArray) To High(AConsultasArray) Do
      Begin
        If Not (Pos(AConsultasArray[LCnt].strCodigo, LCadPor.FieldByName('POR_EMPACE').AsString) > 0) Then
          LEmpresaSemAcesso := LEmpresaSemAcesso + AConsultasArray[LCnt].strCodigo + ',';
      End;
    End;

    If Not fEmptyStr(LEmpresaSemAcesso) Then
    Begin
      fMensagem('ATENÇÃO!', 'A(s) Empresa(s) '+ Copy(LEmpresaSemAcesso,1,(LEmpresaSemAcesso.Length - 1)) +
                            ' não tem acesso para utilizar este portador. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
      Result := False;
    End;

    LCadPor.Close;

  Finally
    FreeAndNil(LCadPor);
  End;
end;

