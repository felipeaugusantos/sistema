function fTextoAlinha(Alinha: TAlinha;
  intTamTexto: integer; strTexto, strTextoPrePos: string;
  chrCaracter: Char): String;
var
  intTamanho : integer;
  function Espaco(intQtde: integer; chrCaracter : Char = ' ') : String;
  var
    intConta : integer;
  begin
    Result := '';
    For intConta := 1 To intQtde Do
      Result := Result + chrCaracter;
  end;

begin
  try
    intTamanho := intTamTexto;
    case Alinha of
      aliDIREITA :
      begin
        if (Length(strTextoPrePos) + Length(strTexto)) >= intTamTexto then
          strtexto := copy(strTexto,1,intTamTexto);

          intTamTexto := (intTamTexto - Length(strTextoPrePos) - Length(strTexto));

          Result   := strTextoPrePos + Espaco(intTamTexto, chrCaracter) + strTexto;
      end;
      aliCENTRALIZA :
      begin
        if Length(strTexto) >= intTamTexto then
          strTexto := copy(strTexto,1,intTamTexto);

        intTamTexto := Trunc((intTamTexto - Length(strTexto)) /2);

        Result   := Espaco(intTamTexto, chrCaracter) + strTexto + Espaco(intTamTexto, chrCaracter);
      end;
      aliESQUERDA :
      begin
        if Length(strTexto) >= intTamTexto then
          strtexto := copy(strTexto,1,intTamTexto);

        intTamTexto := (intTamTexto - Length(strTexto) - Length(strTextoPrePos));

        Result   := strTexto + Espaco(intTamTexto, chrCaracter) + strTextoPrePos;
      end;
    end;

    if (intTamanho - Length(Result)) >= 0 then
      Result := Result + Espaco(intTamanho - Length(Result));

  except
    case Alinha of
      aliDIREITA    : raise Exception.Create('Não foi possivel alinhar a direita o texto para impressão.');
      aliCENTRALIZA : raise Exception.Create('Não foi possivel centralizar o texto para impressão.');
      aliESQUERDA   : raise Exception.Create('Não foi possivel alinhar a esquerda o texto para impressão.');
    end;
  end;

end;

procedure pMenuOrdemAlfabetica(oMenu : TMenuItem; blnOrdenaSubMenus:Boolean = False; blnRemoveRiscos:Boolean = False);
var index: Integer;
var item: TMenuItem;
var objOrdem: TStringList;
begin
  objOrdem := TStringList.Create;
  try
    objOrdem.Sorted := True;
    if (blnRemoveRiscos) then
    begin
      for item in oMenu do
      begin
        if (SameText(item.Caption, '-')) then
        begin
          oMenu.Delete(oMenu.IndexOf(item));
          Continue;
        end;
      end;
    end;

    for item in oMenu do
    begin
      objOrdem.AddObject(item.Caption, item);

      if (blnOrdenaSubMenus) then
        if (item.Count > 0) then
          pMenuOrdemAlfabetica(item, blnOrdenaSubMenus, blnRemoveRiscos);
    end;

    for index := 0 to objOrdem.Count-1 do
      oMenu.Items[oMenu.IndexOf(TMenuItem(objOrdem.Objects[index]))].MenuIndex := index;
  finally
    FreeAndNil(objOrdem);
  end;
end;

