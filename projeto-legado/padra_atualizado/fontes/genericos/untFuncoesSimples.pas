procedure pGravaXMLCNF(const strSeqFis, strNumDoc, strEspDoc, strCodEmp, strForCli, strTipFc, strSerie : String; dtaDtaEmi : TDate);
  Var
    qryXMLCnf : TUniQuery;
begin
  qryXMLCnf := fCriaQuery();
  Try
    qryXMLCnf.Close;
    qryXMLCnf.SQL.Clear;
    qryXMLCnf.SQL.Add(' INSERT INTO XMLCNF ( ');
    qryXMLCnf.SQL.Add('                      CNF_SEQFIS, ');
    qryXMLCnf.SQL.Add('                      CNF_NUMDOC, ');
    qryXMLCnf.SQL.Add('                      CNF_ESPDOC, ');
    qryXMLCnf.SQL.Add('                      CNF_CODEMP, ');
    qryXMLCnf.SQL.Add('                      CNF_FORCLI, ');
    qryXMLCnf.SQL.Add('                      CNF_TIP_FC, ');
    qryXMLCnf.SQL.Add('                      CNF_SERIE_, ');
    qryXMLCnf.SQL.Add('                      CNF_DTAEMI ');
    qryXMLCnf.SQL.Add('                    )');
    qryXMLCnf.SQL.Add('               VALUES (');
    qryXMLCnf.SQL.Add('                      :SEQFIS, ');
    qryXMLCnf.SQL.Add('                      :NUMDOC, ');
    qryXMLCnf.SQL.Add('                      :ESPDOC, ');
    qryXMLCnf.SQL.Add('                      :CODEMP, ');
    qryXMLCnf.SQL.Add('                      :FORCLI, ');
    qryXMLCnf.SQL.Add('                      :TIP_FC, ');
    qryXMLCnf.SQL.Add('                      :SERIE_, ');
    qryXMLCnf.SQL.Add('                      :DTAEMI ');
    qryXMLCnf.SQL.Add('                    )');
    qryXMLCnf.ParamByName('SEQFIS').AsString := strSeqFis;
