      strSQL := strSQL + ' AND CTA_CODCTA IN ( ';
      strSQL := strSQL + ' SELECT CTF_CODCTA ';
      strSQL := strSQL + ' FROM CTAFOR ';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '   CTF_CODFOR = :CODFOR ';
      strSQL := strSQL + ' )';
    End;
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODCTA').AsString := strCodCta;
      If Not fEmptyStr(strCodFor) Then
        ParamByName('CODFOR').AsString := strCodFor;

      Open;
      Result := FieldByName('CTA_DESCTA').AsString;
      Close;
    End;

  Finally
    FreeAndNil(qryGen);
  End;
end;

