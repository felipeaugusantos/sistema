  End;
end;

//Verifica se o valor da configuracao foi passado por parametro pela linha de comando
//Por exemplo: C:/AUTCOM/AUTCOM.exe TIPEXP=4
{****************************************************************************************}
{ * ATENÇÃO! CASO O PARÂMETRO SEJA PASSADO NA LINHA DE COMANDO É NECESSÁRIO VERIFICAR SE }
{ O MESMO ESTÁ EM MODO DE IMPORTAÇÃO OU NÃO, FUNÇÃO ( fAutComEmModoImportacao )          }
{*************************************************************************************RN*}
function fBuscaValorConfiguracaoDefinidoLinhaComando(strConfiguracao: String; Var strValor: String): Boolean;
  Var
    intParam: Integer;
begin
  Result := False;
  For intParam := 1 To ParamCount Do
  Begin
    If AnsiStartsText(UpperCase(strConfiguracao + '='), UpperCase(ParamStr(intParam))) Then
    Begin
      Result   := True;
      strValor := MidStr(ParamStr(intParam), Pos('=', ParamStr(intParam)) + 1, Length(ParamStr(intParam)));
    End;
  End;
end;

procedure pInicializaVariaveisContadoresObjetos;
 Var
   Reg: TRegistry;
begin
  If (VS_GDIObjects = -1) Or (VS_USEObjects = -1) Then
  Begin
    VS_GDIObjects := 10000;
    VS_USEObjects := 10000;

    Reg := TRegistry.Create;
    Try
      Reg.RootKey := HKEY_LOCAL_MACHINE;
      Try
        If Reg.OpenKey('SOFTWARE\Microsoft\Windows NT\CurrentVersion\Windows\', False) then
        Begin
          VS_GDIObjects := Reg.ReadInteger('GDIProcessHandleQuota');
          VS_USEObjects := Reg.ReadInteger('USERProcessHandleQuota');
        End;
      Except
        //
      End;
    Finally
      Reg.Free;
    End;
  End;
end;

