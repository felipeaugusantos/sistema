{* VERIFICA SE A COTAÇÃO EXISTE PARA UMA DATA *}
{*******************************************PZ*}
function fVerifCotacao(dtaData: TDateTime): Boolean;
Var
  qryGen : TUniQuery;
Begin
  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT * FROM CADMOE WHERE MOE_DTAMOE = :DTAMOE');
      ParamByName('DTAMOE').AsDateTime := dtaData;
      Open;

      If IsEmpty Then
        Result := False
      Else
        Result := True;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

End;

Function fInsereCotacaoDoDia: Boolean;
  Var
    strSQL: String;
    qryGen   : TUniQuery;
Begin

  strSQL := '';
  strSQL := strSQL + ' INSERT INTO CADMOE ';
  strSQL := strSQL + '   (SELECT          ';
  strSQL := strSQL + '     :DTAMOE,       ';
  strSQL := strSQL + '     MOE_DOLCOM,    ';
  strSQL := strSQL + '     MOE_DOLVEN,    ';
  strSQL := strSQL + '     MOE_REACOM,    ';
  strSQL := strSQL + '     MOE_REAVEN,    ';
  strSQL := strSQL + '     MOE_PARCOM,    ';
  strSQL := strSQL + '     MOE_PARVEN,    ';
  strSQL := strSQL + '     MOE_EURCOM,    ';
  strSQL := strSQL + '     MOE_EURVEN,    ';
  strSQL := strSQL + '     MOE_GUACOM,    ';
  strSQL := strSQL + '     MOE_GUAVEN,    ';
  strSQL := strSQL + '     MOE_CODEMP,    ';
  strSQL := strSQL + '     :AUTOIN        ';
  strSQL := strSQL + '   FROM             ';
  strSQL := strSQL + '     CADMOE         ';
  strSQL := strSQL + '   ORDER BY         ';
  strSQL := strSQL + '     MOE_DTAMOE DESC LIMIT 1) ';

  Try
    fStartTransaction;

    qryGen := fCriaQuery;
    With qryGen Do
    Begin
      Close;
      SQL.Text := strSQL;

      ParamByName('DTAMOE').AsDate   := VS_Date;
      ParamByName('AUTOIN').AsString := fRetAutoIncrem('CADMOE',VS_strCodEmp);

      ExecSQL;
    End;

    fCommit;

    Result := TRUE;

  Except
	  On E : Exception do
	  Begin
      fRollBack;
		  Result := False;
		  pMensagensErro(E.Message, '[fInsereCotacaoDoDia]');
	  End;

  End;

  FreeAndNil(qryGen);
End;

