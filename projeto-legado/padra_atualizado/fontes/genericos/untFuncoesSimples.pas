function fCalculoMod11(strN : string) : Integer;
Var
  intSoma, intX , intPn : Integer;
begin
  intX := 2;
  intSoma := 0;
  For intPn := Length(strN) downto 1 do
  begin
    intSoma := intSoma + (StrToInt(strN[intPn]) * intX);
    inc(intX);
    IF intX = 10 Then intX := 2;
  end;

  Result := 11 - (intSoma mod 11);
  if Result > 9 Then
    if Length(strN)=43 Then
      Result := 1
    else
      Result := 0;
end;

function fCalculoMod10(strN : string) : Integer;
VAR
  intSomar, intSoma, intX , intPn : Integer;
  strProduto : String;
begin
  intX := 2;
  intSoma := 0;
  For intPn := Length(strN) downto 1 do
  begin
    strProduto := IntToStr(StrToInt(strN[intPn]) * intX);
    if StrToInt(strProduto) > 9 Then
      intSomar:=  StrToInt(strProduto[1]) + StrToInt(strProduto[2])
    else
      intSomar:= StrToInt(strProduto);

    intSoma := intSoma + intSomar;
    if intX = 2 Then intX := 1 else intX := 2;
  end;

  Result := 10 - (intSoma mod 10);
  IF Result > 9 then Result := 0;
end;

function fValidaRepresentacaoNumericaCobranca(const strReprNumerica: String): Boolean;
var
  intDv1,
  intDv2,
  intDv3,
  intDv4,
  intDvCalc1,
  intDvCalc2,
  intDvCalc3,
  intDvCalc4: Integer;
begin
  intDv1 := StrToInt(Copy(strReprNumerica, 12, 1));
  intDv2 := StrToInt(Copy(strReprNumerica, 24, 1));
  intDv3 := StrToInt(Copy(strReprNumerica, 36, 1));
  intDv4 := StrToInt(Copy(strReprNumerica, 48, 1));

  intDvCalc1 := fCalculoMod10(Copy(strReprNumerica, 01, 11));
  intDvCalc2 := fCalculoMod10(Copy(strReprNumerica, 13, 11));
  intDvCalc3 := fCalculoMod10(Copy(strReprNumerica, 25, 11));
  intDvCalc4 := fCalculoMod10(Copy(strReprNumerica, 37, 11));

   Result := ((intDv1 = intDvCalc1) and (intDv2 = intDvCalc2) and
              (intDv3 = intDvCalc3) and (intDv4 = intDvCalc4));
end;

function fValidaCodigoBarrasCobranca(const strCodigoBarras: String): Boolean;
var
  strBarras: String;
  intRefer, intDV, intDVCalc: Integer;
begin
  intDV     := StrToInt(Copy(strCodigoBarras, 4, 1));
  strBarras := Copy(strCodigoBarras, 1, 3) + Copy(strCodigoBarras, 5, Length(strCodigoBarras));
  intRefer  := StrToInt(Copy(strBarras, 3, 1));
  intDVCalc := 0;

  case intRefer of
     6: intDVCalc := fCalculoMod10(strBarras);
     7: intDVCalc := fCalculoMod10(strBarras);
     8: intDVCalc := fCalculoMod11(strBarras);
     9: intDVCalc := fCalculoMod11(strBarras);
  end;

  Result := (intDvCalc = intDv);
end;

function fRetornaCodigoBarrasCobranca(const strReprNumerica: String): String;
begin
  Result := Copy(strReprNumerica, 01, 11) + Copy(strReprNumerica, 13, 11) +
            Copy(strReprNumerica, 25, 11) + Copy(strReprNumerica, 37, 11);
end;

function fRetornaReprNumericaCobranca(const strCodigoBarras: String): String;
begin
  Result := Copy(strCodigoBarras, 01, 11) +
            intToStr(fCalculoMod10(Copy(strCodigoBarras, 01, 11))) +
            Copy(strCodigoBarras, 12, 11) +
            intToStr(fCalculoMod10(Copy(strCodigoBarras, 12, 11))) +
            Copy(strCodigoBarras, 23, 11) +
            intToStr(fCalculoMod10(Copy(strCodigoBarras, 23, 11))) +
            Copy(strCodigoBarras, 34, 11) +
