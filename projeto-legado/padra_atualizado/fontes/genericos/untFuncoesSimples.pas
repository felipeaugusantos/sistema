function fCamelCase(const s: string): string;
var t1: integer;
   first: boolean;
begin
   result := LowerCase(s);
   first := true;
   for t1 := 1 to length(result) do
     if result[t1] = ' ' then begin
       first := true;
     end else
       if first then begin
         result[t1] := UpCase(result[t1]);
         first := false;
       end;
end;

