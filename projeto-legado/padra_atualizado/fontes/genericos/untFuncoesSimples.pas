function fRetQtdRecPDOPRC(Const strNumDoc: String;
                          Const strEspDoc: String;
                          Const strCodEmp: String;
                          Const strCodIte: String;
                          Var fltQtdIteMovRcd: Double;
                          Var fltQtdIteBaiReq: Double):Double;
Var
  qryAux: TUniQuery;
  strSQL: String;
begin
  fltQtdIteMovRcd := 0;
  fltQtdIteBaiReq := 0;

  strSQL := '';
  strSQL := strSQL + '  SELECT                                                       ';
  strSQL := strSQL + '    SUM(RCD_QTDITE) QTDREQ,                                    ';
  strSQL := strSQL + '    SUM(BAI_QTDREQ) QTDBAI                                     ';
  strSQL := strSQL + '  FROM                                                         ';
  strSQL := strSQL + '    (SELECT                                                    ';
  strSQL := strSQL + '      COALESCE(RCD_QTDITE, 0) RCD_QTDITE,                      ';
  strSQL := strSQL + '      (SELECT                                                  ';
  strSQL := strSQL + '        COALESCE(SUM(BAI_QTDREQ), 0)                           ';
  strSQL := strSQL + '      FROM                                                     ';
  strSQL := strSQL + '        BAIREQ                                                 ';
  strSQL := strSQL + '      WHERE MOVRCD.AUTOINCREM = BAIREQ.BAI_AUTREQ) BAI_QTDREQ  ';
  strSQL := strSQL + '    FROM                                                       ';
  strSQL := strSQL + '      MOVRCD                                                   ';
  strSQL := strSQL + '      INNER JOIN                                               ';
  strSQL := strSQL + '        (SELECT DISTINCT                                       ';
  strSQL := strSQL + '          FGO_NUMDOC,                                          ';
  strSQL := strSQL + '          FGO_ESPDOC,                                          ';
  strSQL := strSQL + '          FGO_CODEMP,                                          ';
  strSQL := strSQL + '          FDO_CODITE                                           ';
  strSQL := strSQL + '        FROM                                                   ';
  strSQL := strSQL + '          FATGOR                                               ';
  strSQL := strSQL + '          LEFT JOIN EXTGOR                                     ';
  strSQL := strSQL + '            ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO           ';
  strSQL := strSQL + '          INNER JOIN FATDOR                                    ';
  strSQL := strSQL + '            ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER           ';
  strSQL := strSQL + '        WHERE (                                                ';
  strSQL := strSQL + '            FGO_NUMORI =:NUMDOC                                ';
  strSQL := strSQL + '            AND FGO_ESPORI =:ESPDOC                            ';
  strSQL := strSQL + '            AND FGO_EMPORI =:CODEMP                            ';
  strSQL := strSQL + '            AND FDO_CODITE =:CODITE                            ';
  strSQL := strSQL + '          )                                                    ';
  strSQL := strSQL + '          OR (                                                 ';
  strSQL := strSQL + '            FGO_NUMDOC =:NUMDOC                                ';
  strSQL := strSQL + '            AND FGO_ESPDOC =:ESPDOC                            ';
  strSQL := strSQL + '            AND FGO_CODEMP =:CODEMP                            ';
  strSQL := strSQL + '            AND FDO_CODITE =:CODITE                            ';
  strSQL := strSQL + '          )) PEDIDOS                                           ';
  strSQL := strSQL + '        ON MOVRCD.RCD_DOCPDV = PEDIDOS.FGO_NUMDOC              ';
  strSQL := strSQL + '        AND MOVRCD.RCD_ESPPDV = PEDIDOS.FGO_ESPDOC             ';
  strSQL := strSQL + '        AND MOVRCD.RCD_EMPPDV = PEDIDOS.FGO_CODEMP             ';
  strSQL := strSQL + '        AND MOVRCD.RCD_CODITE = PEDIDOS.FDO_CODITE             ';
  strSQL := strSQL + '        WHERE MOVRCD.RCD_REQNEG <> "S") DADOS                  ';
  qryAux := fCriaQuery();

  Try
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CODITE').AsString := strCodIte;
    qryAux.Open;

    If (Not qryAux.IsEmpty) Then
    Begin
      fltQtdIteMovRcd := qryAux.FieldByName('QTDREQ').AsFloat;
      fltQtdIteBaiReq := qryAux.FieldByName('QTDBAI').AsFloat;
    End;

    Result := fFormataFloat((fltQtdIteMovRcd - fltQtdIteBaiReq), fCfgSis('DECQTD', VarInteger));
  Finally
    FreeAndNil(qryAux);
  End;
end;

