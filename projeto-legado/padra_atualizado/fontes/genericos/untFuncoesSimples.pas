function fSqlExcecaoLocFisicaMapeamento: String;
  Var
    strExcecaoCadLoc : String;
    arrExcecaoCadLoc : TArray<string>;
    intContador : Integer;
    strNotLike  : String;
    strNotIn    : String;
    strCodigo   : String;
begin
  Result := '';

  If (fEmptyStr(fCfgSis('LFNPIM'))) Then
    Exit;

  strExcecaoCadLoc := fCfgSis('LFNPIM');
  arrExcecaoCadLoc := strExcecaoCadLoc.Split([',']);

  strNotLike := '';
  strNotIn   := '';

  For intContador := Low(arrExcecaoCadLoc) To High(arrExcecaoCadLoc) Do
  Begin
    strCodigo := arrExcecaoCadLoc[intContador];
    If strCodigo.EndsWith('*') Then
    Begin
      If (Not fEmptyStr(strNotLike)) Then
        strNotLike := strNotLike + ' AND ';

      strNotLike := strNotLike + Format('LOC_CODLOC NOT LIKE ''%s%%''', [Copy(strCodigo, 1, Length(strCodigo) - 1)]);
    End
    Else
    Begin
      If (Not fEmptyStr(strNotIn)) Then
        strNotIn := strNotIn + ', ';

      strNotIn := strNotIn + QuotedStr(strCodigo);
    End;
  End;

  If (Not fEmptyStr(strNotIn)) Then
    Result := Result + Format(' AND LOC_CODLOC NOT IN (%s)', [strNotIn]);

  If (Not fEmptyStr(strNotLike)) Then
    Result := Result + Format(' AND %s', [strNotLike]);
end;

procedure pGerandoTemporariaAtravesDataSet(var strTabela: string;
                                           dsDados: TDataSet;
                                           blnPularPrimeiraLinha : boolean = false;
                                           blnGerarAutoIncrem: boolean = true);
var
  qryDados: TUniQuery;
  contI: Integer;
  strCreate, strInsert, strColunas, strValores, strTemp: string;
begin
  qryDados := fCriaQuery();
  strTemp := '';

  if not strTabela.StartsWith('TMP_') then
  begin
    strTabela := 'TMP_' + strTabela;
  end;

  try
    qryDados.SQL.Text := 'DROP TEMPORARY TABLE IF EXISTS ' + strTabela;
    qryDados.ExecSQL;

    strCreate := 'CREATE TEMPORARY TABLE ' + strTabela + ' (';
    strColunas := '';

    if blnGerarAutoIncrem then
      strColunas := strColunas + ' REL_AUTINC INT AUTO_INCREMENT, ';

    for contI := 0 to dsDados.FieldCount - 1 do
    begin
      case dsDados.Fields[contI].DataType of
        ftString, ftWideString: strColunas := strColunas + dsDados.Fields[contI].FieldName + ' VARCHAR(255), ';
        ftInteger, ftSmallint, ftWord: strColunas := strColunas + dsDados.Fields[contI].FieldName + ' INT, ';
        ftFloat, ftCurrency, ftBCD: strColunas := strColunas + dsDados.Fields[contI].FieldName + ' DECIMAL(20,8), ';
        ftDate, ftTime, ftDateTime: strColunas := strColunas + dsDados.Fields[contI].FieldName + ' DATETIME, ';
        else
          strColunas := strColunas + dsDados.Fields[contI].FieldName + ' TEXT, ';  // Caso genérico
      end;
    end;

    if blnGerarAutoIncrem then
      strColunas := strColunas + ' PRIMARY KEY(REL_AUTINC), ';

    SetLength(strColunas, Length(strColunas) - 2);
    strCreate := strCreate + strColunas + ')';

    qryDados.SQL.Text := strCreate;
    qryDados.ExecSQL;

    if (dsDados.Active) Then
    Begin

      dsDados.First;

      if (blnPularPrimeiraLinha) then
        dsDados.Next;

      while not dsDados.Eof do
      begin
        strInsert := 'INSERT INTO ' + strTabela + ' (';
        strColunas := '';
        strValores := '';

        for contI := 0 to dsDados.FieldCount - 1 do
        begin
          strColunas := strColunas + dsDados.Fields[contI].FieldName + ', ';
          strValores := strValores + ':' + dsDados.Fields[contI].FieldName + ', ';
        end;

        SetLength(strColunas, Length(strColunas) - 2);
        SetLength(strValores, Length(strValores) - 2);

        strInsert := strInsert + strColunas + ') VALUES (' + strValores + ')';

        qryDados.SQL.Text := strInsert;
        qryDados.Prepare;

        for contI := 0 to dsDados.FieldCount - 1 do
        begin
          qryDados.ParamByName(dsDados.Fields[contI].FieldName).Value := dsDados.Fields[contI].Value;
        end;

        qryDados.ExecSQL;
        dsDados.Next;
      end;

    end;
  finally
    FreeAndNil(qryDados);
  end;
end;

