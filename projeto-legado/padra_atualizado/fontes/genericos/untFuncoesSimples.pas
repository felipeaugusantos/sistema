  End;

end;

function fRetornaSeqCadRecPedidoDeVendaABaseDeTroca(strNumPD, strCodEmp, strCodCli: String): String;
  Var
    qryDados: TUniQuery;
begin
  Result := '';
  qryDados := fCriaQuery;

  Try
    qryDados.Close;
    qryDados.SQL.Clear;
    qryDados.SQL.Text := ' SELECT                                       '+
                         '   FGO_SEQDVB                                 '+
                         ' FROM                                         '+
                         '   EXTGOR                                     '+
                         '   INNER JOIN FATGOR                          '+
                         '     ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO '+
                         '   INNER JOIN PENREC                          '+
                         '     ON PEN_NUMDOC = FGO_NUMDOC               '+
                         '     AND PEN_ESPDOC = FGO_ESPDOC              '+
                         '     AND PEN_CODEMP = FGO_CODEMP              '+
                         ' WHERE FGO_NUMDOC = :NUMDOC                   '+
                         '   AND FGO_ESPDOC = "PD"                      '+
                         '   AND FGO_CODEMP = :CODEMP                   '+
                         '   AND FGO_CODCLI = :CODCLI                   '+
                         '   AND PEN_STATUS = "P"                       ';

    qryDados.ParamByName('NUMDOC').AsString := strNumPD;
    qryDados.ParamByName('CODEMP').AsString := strCodEmp;
    qryDados.ParamByName('CODCLI').AsString := strCodCli;
    qryDados.Open;

    If (qryDados.IsEmpty) Or (fEmptyStr(qryDados.FieldByName('FGO_SEQDVB').AsString)) Then
      Exit;

    Result := qryDados.FieldByName('FGO_SEQDVB').AsString;
  Finally
    FreeAndNil(qryDados);
  End;
end;

