var
  strExtArquivo: String;
Begin
  strExtArquivo := ExtractFileExt(strValor);

  If Not fEmptyStr(strExtArquivo) Then
    Result := FileExists(strValor)
  Else
    Result := False;
End;

Function fDiaAtualEstaEmDiasCadastrados(strDiaMes, strDiaAtu: String): Boolean;
  Var
    intCnt : Integer;
    stlDiaMes : TStringList;
Begin
  Result := False;
  stlDiaMes := TStringList.Create;

  ExtractStrings(['_'], [' '], PWideChar(strDiaMes), stlDiaMes);

  For intCnt := 0 To (stlDiaMes.Count -1) Do
  Begin
    Result := (fStrZero(Trim(stlDiaMes.Strings[intCnt]), 2) = fStrZero(strDiaAtu, 2));
    If (Result) Then
      Break;
  End;

  FreeAndNil(stlDiaMes);
End;

function fValidarConfiguracaoPath(strCodCfg, strEmpCfg, strValor: String): Boolean;
Var
  strMsg: String;
  horInicio: TDateTime;
  blnTimeOut :Boolean;
  blnPathExiste :Boolean;
  blnArquExiste: Boolean;
begin
  If fEmptyStr(strEmpCfg) Then
    strEmpCfg := VS_strCodEmp;

  If VS_strConfiguracoesValidouPath.Contains(strCodCfg + strEmpCfg) Then
    Exit(True);

  Result := False;
  horInicio := fTime();
  Try
    blnPathExiste := False;
    blnArquExiste := False;

    If (Not fEmptyStr(strValor))  Then
      blnPathExiste := TryDirectoryExists(strValor);

    blnTimeOut := SecondsBetween(fTime(), horInicio) >= 3;

    If (Not blnTimeOut) Then
      blnArquExiste := fValidaPathArquivo(strValor);

    blnTimeOut := SecondsBetween(fTime(), horInicio) >= 3;

    Result := (blnPathExiste or blnArquExiste) And (Not blnTimeOut);

    If Not Result Then
    Begin
      strMsg := 'Path da configuração [ CFG_'+ strCodCfg + ' - ' + fRetNomCfg(strCodCfg) +
        ' = ' + strValor + ' ]' +
        ' não foi localizado. Favor verificar se o caminho foi alterado' +
        ' no servidor e ajustar a configuração. ' + #13#10 +
        'Tempo total: ' + SecondsBetween(fTime(), horInicio).ToString() + 's.';

      If (Not fInTransaction()) And (Not fAutComEmModoImportacao) Then
      Begin
        pMensagemOk(strMsg);
      End
      Else
        pGravarErro(True,'[fValidarConfiguracaoPath] - ' + strMsg);
    End;

  Finally
    If Result Then
      VS_strConfiguracoesValidouPath := VS_strConfiguracoesValidouPath + '_' + strCodCfg + strEmpCfg;
  End;

end;

function fAtuCfgSis(strCamCfg: String; strValCfg: String; strCodEmp: String = ''; segConex: TUniConnection = Nil) : Boolean;
  Var
    qryGenCfg: TUniQuery;

begin
  Try
    Result := True;

    If fEmptyStr(strCodEmp) Then
      strCodEmp := VS_strCodEmp;

    If Not fEmptyStr(strCamCfg) Then
    Begin
      qryGenCfg := fCriaQuery(Nil, segConex);

      With qryGenCfg Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('UPDATE                     ');
        SQL.Add('  CFGSIS                   ');
        SQL.Add('SET                        ');
        SQL.Add('  SIS_VALCFG = :VALCFG     ');
        SQL.Add('WHERE                      ');
        SQL.Add('  SIS_CODEMP = :CODEMP AND ');
        SQL.Add('  SIS_CODCFG = :CODCFG     ');

        Try
          ParamByName('CODEMP').Value := strCodEmp;
          ParamByName('CODCFG').Value := 'CFG_' + strCamCfg;
          ParamByName('VALCFG').Value := strValCfg;

          ExecSQL;
        Except
          On E: Exception Do
            Raise ExceptClass(E.ClassType).Create(E.Message + ' raised in ' +
              'fAtuCfgSis('+strCamCfg+', '+strValCfg+', '+strCodEmp+')');
        End;

      End;

    End;

  Finally
    FreeAndNil(qryGenCfg);
  End;

end;

{**************************************************}
{* RETORNA AS EMPRESAS QUE POSSUEM A CONFIGURAÇÃO *}
{* COM UM DETERMINADO VALOR                       *}
{***********************************************AJ*}
function fCfgSisEmp(strCodCfg, strValCfg: String; ALocateValor: Boolean = False): String;
  Var
    strSQL   : String;
    qryGenCfg: TUniQuery;
Begin
  Result := '';
  qryGenCfg := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + ' SELECT  SQL_NO_CACHE       ';
  strSQL := strSQL + '   SIS_CODEMP               ';
  strSQL := strSQL + ' FROM                       ';
  strSQL := strSQL + '   CFGSIS                   ';
  strSQL := strSQL + ' WHERE                      ';
  strSQL := strSQL + '   SIS_CODCFG = :CODCFG AND ';

  If Not ALocateValor Then
    strSQL := strSQL + '   SIS_VALCFG = :VALCFG   '
  Else
    strSQL := strSQL + '   LOCATE(:VALCFG, SIS_VALCFG) > 0 ';

  With qryGenCfg Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);

    ParamByName('VALCFG').Value := strValCfg;
    ParamByName('CODCFG').Value := 'CFG_' + strCodCfg;
    Open;

    If Not IsEmpty Then
    Begin
      While Not Eof Do
      Begin
        Result := Result + FieldByName('SIS_CODEMP').AsString + '_';

        Next;
      End;
    End;
  End;

  FreeAndNil(qryGenCfg);
End;

{*********************************************}
{* RETORNA O CODIGO DA COND DE PAGTO A VISTA *}
{******************************************LU*}
function fRetCodCndAVista: String;
  Var
    strSQL   : String;
    qryGenCnd: TUniQuery;
Begin
  Try

    qryGenCnd := fCriaQuery;

    strSQL := '';
