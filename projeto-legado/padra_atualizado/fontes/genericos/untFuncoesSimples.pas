function fPedidoDaOndaJahImpresso(strIncPD : String) : Boolean;
var
  qryImpressao : TUniQuery;
const
  STR_IMPRESSAO = 'SELECT            ' +
                  '  COUNT(*) AS QTD ' +
                  'FROM       ' +
                  '  FATGOR   ' +
                  '  INNER JOIN EXTGOR ON (EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM) ' +
                  'WHERE (AUTOINCREM = :AUTINC) AND (FGO_SEQSEP IS NOT NULL) AND (FGO_SEPIMP = "1")';

begin

  If fEmptyStr(strIncPD) Then
    Exit(False);

  qryImpressao := fCriaQuery();

  Try

    qryImpressao.Close;
    qryImpressao.SQL.Clear;
    qryImpressao.SQL.Add(STR_IMPRESSAO);
    qryImpressao.ParamByName('AUTINC').AsString := strIncPD;
    qryImpressao.Open;

    Result := (Not qryImpressao.IsEmpty) And (qryImpressao.FieldByname('QTD').AsInteger > 0);

  Finally
