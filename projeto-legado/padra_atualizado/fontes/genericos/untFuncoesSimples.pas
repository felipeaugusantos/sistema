procedure pGravaLogTot(const AstrDocume, AstrMensagemErro: string) ;
  Var
    qryLogErr: TUniQuery;
begin
  qryLogErr := fCriaQuery(Nil);
  qryLogErr.SQL.Add('SELECT * FROM LOGTOT WHERE FALSE');
  Try
    qryLogErr.Open;
    qryLogErr.Insert;
    qryLogErr.FieldByName('LOG_CODEMP').AsString   := VS_strCodEmp;
    qryLogErr.FieldByName('LOG_LOGOPE').AsString   := strLoginUsuarioLogado;
    qryLogErr.FieldByName('LOG_DTAERR').AsDateTime := VS_Date;
    qryLogErr.FieldByName('LOG_HORERR').AsDateTime := fTime();
    qryLogErr.FieldByName('LOG_DESCRI').AsString   := AstrMensagemErro;
    qryLogErr.FieldByName('LOG_DOCUME').AsString   := AstrDocume;
    qryLogErr.Post;
    qryLogErr.Close;
  Finally
    FreeAndNil(qryLogErr);
  End;
end ;

{*************************************************}
{*   Grava Mensagens de Erro no Arquivo de LOG   *}
{**********************************************DV*}
procedure pGravarErro(GravarErro:Boolean; MensagemErro:String; strRelatorio: String= ''; strUltSQL: String=''; conexao: TUniConnection = nil);
  Var
    qryLogErr: TUniQuery;
begin
  If Not GravarErro Then
    Exit;
  qryLogErr := fCriaQuery(Nil, conexao);
  Try
    qryLogErr.SQL.Add('SELECT * FROM LOGERR WHERE FALSE');
    With qryLogErr Do
    Begin
      Open;
      Insert;
      FieldByName('LOG_CODEMP').AsString   := VS_strCodEmp;
      FieldByName('LOG_LOGOPE').AsString   := strLoginUsuarioLogado;
      FieldByName('LOG_DTAERR').AsDateTime := VS_Date;
      FieldByName('LOG_HORERR').AsDateTime := fTime();
      FieldByName('LOG_DESCRI').AsString   := MensagemErro;
      If Not fEmptyStr(strRelatorio) Then
        FieldByName('LOG_RELERR').AsString   := strRelatorio;
      if FindField('LOG_ULTSQL') <> nil then
        FindField('LOG_ULTSQL').AsString := strUltSQL;
      Post;
      Close;
    End;
  Finally
    FreeAndNil(qryLogErr);
  End;
end;

procedure pGravaErroCNF(E: Exception);
begin
  pGravarErro(True, 'ERRO CNF: ' + E.Message, E.StackTrace);
end;

function fTipoErroGravaEmailErrosLog(AMensagemErro: String; conexao: TUniConnection = nil): Boolean;
Var
  LQuery: TUniQuery;
  LErro: String;
begin
  Result := False;

  If Not Assigned(VS_EmailTiposErro) Then
  Begin
    VS_EmailTiposErro := TStringList.Create;
    LQuery := fCriaQuery(Nil, conexao);
    Try
      LQuery.SQL.Text := 'SELECT * FROM EMAERR_LIK';
      LQuery.Open;
      While Not LQuery.Eof Do
      Begin
        VS_EmailTiposErro.Add(LQuery.FieldByName('ERR_DESCRI').AsString);
        LQuery.Next;
      End;
    Finally
      FreeAndNil(LQuery);
    End;
  End;

  For LErro In VS_EmailTiposErro Do
    If AMensagemErro.ToUpper.Contains(LErro.ToUpper) Then
      Exit(True);
end;

procedure pGravarEmailErros(strTip_FC, strForCli, strAssunt, strDestin, strMsgErr: String; AConnection: TUniConnection = Nil);
  Var
    qryEmaErrLog: TUniQuery;
begin
  qryEmaErrLog := fCriaQuery(Nil, AConnection);
  Try
    qryEmaErrLog.SQL.Text := STR_SQL_NAO_REPLICAR +
    ' INSERT INTO EMAERR_LOG '+
    '   (LOG_DTAERR, '+
    '    LOG_HORERR, '+
    '    LOG_CODOPE, '+
    '    LOG_CODEMP, '+
    '    LOG_TIP_FC, '+
    '    LOG_FORCLI, '+
    '    LOG_ASSUNT, '+
    '    LOG_DESTIN, '+
    '    LOG_MSGERR) '+
    ' VALUES '+
    '   (:DTAERR, '+
    '    :HORERR, '+
    '    :CODOPE, '+
    '    :CODEMP, '+
    '    :TIP_FC, '+
    '    :FORCLI, '+
    '    :ASSUNT, '+
    '    :DESTIN, '+
    '    :MSGERR) ';

    qryEmaErrLog.ParamByName('DTAERR').AsDateTime := VS_Date;
    qryEmaErrLog.ParamByName('HORERR').AsDateTime := fTime();
    qryEmaErrLog.ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
    qryEmaErrLog.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryEmaErrLog.ParamByName('TIP_FC').AsString := strTip_FC;
    qryEmaErrLog.ParamByName('FORCLI').AsString := strForCli;
    qryEmaErrLog.ParamByName('ASSUNT').AsString := strAssunt;
    qryEmaErrLog.ParamByName('DESTIN').AsString := strDestin;
    qryEmaErrLog.ParamByName('MSGERR').AsString := strMsgErr;
    qryEmaErrLog.ExecSQL;
  Finally
    FreeAndNil(qryEmaErrLog);
  End;
end;

