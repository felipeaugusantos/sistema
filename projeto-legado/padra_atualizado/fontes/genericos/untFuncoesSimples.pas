Function fGetVendedoresGerentesOrSUBGerentes: String;
  Var
    strSQL: String;
    qryGen: TUniQuery;
    strTmp: String;
Begin
  Result := '';

  strTmp := fRetTipoOperador(strLoginUsuarioLogado);

  If (Not SameText(strTmp, 'G')) And (Not SameText(strTmp, 'S')) Then
    Exit;

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   OPE_CODOPE ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   CADOPE ';
  strSQL := strSQL + ' WHERE ';

  If SameText(strTmp, 'G') Then
    strSQL := strSQL + ' OPE_CODGER = :CODOPE '
  Else
    strSQL := strSQL + ' OPE_CODSUB = :CODOPE ';

  strSQL := strSQL + ' ORDER BY OPE_CODOPE ';

  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
      Open;

      If Not IsEmpty Then
      Begin
        First;

        While Not Eof Do
        Begin
          Result := Result + '"' + FieldByName('OPE_CODOPE').AsString + '",';

          Next;
        End;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
End;

