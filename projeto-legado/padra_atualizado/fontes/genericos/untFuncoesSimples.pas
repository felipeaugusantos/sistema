        pMensagensErro(E.Message, '[pDefinirCharsetConexao]');
        fMensagem('Aviso', 'Sua aplicação será fechada agora', ['&O k']);
        Application.Terminate;
      End;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

end;

{***************************************************************}
{*   Trilha de mensagens modais suprimidas (totem / servico)   *}
{***************************************************************}
procedure pCapturarMensagemTotem(const AstrTitulo, AstrTexto: String);
  Const
    intTAMANHO_MAXIMO_TRILHA = 8000;
  Var
    strLinha: String;
begin
  If VS_ExibirMensagemAoUsuario And VS_ExibirMensagemDeErro Then
    Exit;

  If fEmptyStr(AstrTitulo) And fEmptyStr(AstrTexto) Then
    Exit;

  {Monta a linha fora da secao critica; fTime(True) nao acessa o banco}
  Try
    strLinha := FormatDateTime('hh:nn:ss', fTime(True));

    If Not fEmptyStr(AstrTitulo) Then
      strLinha := strLinha + ' [' + Trim(AstrTitulo) + ']';

    strLinha := strLinha + ' ' + Trim(AstrTexto);
  Except
    Exit;
  End;

  VS_csTrilhaMensagensTotem.Enter;
  Try
    Try
      If VS_strTrilhaMensagensTotem.IsEmpty Then
        VS_strTrilhaMensagensTotem := strLinha
      Else
        VS_strTrilhaMensagensTotem := VS_strTrilhaMensagensTotem + sLineBreak + strLinha;

      If Length(VS_strTrilhaMensagensTotem) > intTAMANHO_MAXIMO_TRILHA Then
        VS_strTrilhaMensagensTotem := '(...)' + sLineBreak + Copy(VS_strTrilhaMensagensTotem,
                                                                  Length(VS_strTrilhaMensagensTotem) - intTAMANHO_MAXIMO_TRILHA + 1,
                                                                  intTAMANHO_MAXIMO_TRILHA);
    Except
      {Captura de diagnostico nunca pode derrubar a rotina que esta sendo
       diagnosticada.}
    End;
  Finally
    VS_csTrilhaMensagensTotem.Leave;
  End;
end;

function fRetornaTrilhaMensagensTotem: String;
begin
  VS_csTrilhaMensagensTotem.Enter;
  Try
    Result := VS_strTrilhaMensagensTotem;
  Finally
    VS_csTrilhaMensagensTotem.Leave;
  End;
end;

procedure pLimparTrilhaMensagensTotem;
begin
  VS_csTrilhaMensagensTotem.Enter;
  Try
    VS_strTrilhaMensagensTotem := '';
  Finally
    VS_csTrilhaMensagensTotem.Leave;
  End;
end;

{*******************************************}
{*   Verifica Mensagens de Erro do Banco   *}
{****************************************DV*}
procedure pMensagensErro(MensErro, LocalErro: String; strMensagem: String = ''; conexao: TUniConnection = nil);
  Var
    NrErro: Integer;
    strInfo: String;
    strMsgErroComLocal : String;
begin
  VS_strError := MensErro;
  VS_strLocalErro := LocalErro;
  VS_strMensagemErro := strMensagem;

  pCapturarMensagemTotem('pMensagemErro',
    MensErro + IIF(LocalErro.IsEmpty, '', ' - Local: ' + LocalErro) +
               IIF(strMensagem.IsEmpty, '', ' ' + strMensagem));

  Try
    fRollBack(conexao);

    If VS_TentativaFaturamentoAutomatico Then
    Begin
      VS_CallStackTentativaFaturamentoAutomatico := fRetornaStack;
      Raise Exception.Create(Trim(MensErro + ' - Local: ' + LocalErro + ' ' + strMensagem));
    End;

    NrErro := fParseError(MensErro, strInfo);

    Case NrErro Of
    ERR_UNKNOW_ERROR         :pErro(MensErro + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
    ERR_UNKNOW_DATABASE      :pErro(strInfo + ': Banco de dados inexistente' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
    ERR_ACCESS_DENIED        :pErro('Accesso negado ao usuário ' + strInfo + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_TABLE_NOT_EXIST      :pErro('Tabela ' + strInfo + ' não Existe!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_FIELD_NOT_FOUND      :pErro('Campo ' + strInfo + ' não Existe!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_TABLE_READONLY       :pErro('Operação não suportada no modo Somente Leitura!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_NOT_VALID_INT        :pErro(strInfo + ' não é um número inteiro válido!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_NOT_VALID_DATE       :fMensagem('ATENÇÃO!',strInfo + ' não é uma data válida!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem, ['&OK']);
      ERR_NOT_VALID_FLOAT      :pErro(strInfo + ' não é um número válido!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_NOT_IN_EDIT          :pErro('Tabela não está em modo de Edição!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_SQL_SYNTAX           :pErro('Há um erro de Sintaxe no SQL: ' + strInfo + #10 + 'Local: ' + #10 + LocalErro + #10 + strMensagem);
      ERR_BD_NOT_ACTIVE        :pErro('O Servidor de banco de dados não está ativo!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_FIELD_NOT_NULL       :pErro('O campo ' + strInfo + ' é de preenchimento obrigatório!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_PRIMARY_KEY          :pErro(strInfo + ': valor duplicado não permitido!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERR_ORDER_BY             :pErro('Coluna ' + strInfo + ' desconhecida no processo de ordenação!' + #10 + 'Local: ' + LocalErro + #10 + strMensagem);
      ERROR_FOREIGN_KEY_DELETE :begin
                                  pGravarErro(True, '[ERROR_FOREIGN_KEY_DELETE] - Não é possível excluir esse registro', MensErro + sLineBreak + fRetornaInformacaoUltimoErroForeignKey(), TfrmModulo.GetMySqlStatementsHistory, conexao);
                                  if LocalErro = PME_MAN_ORD_PRO_INDUSTRIAL then
                                    fMensagem('ATENÇÃO!', 'Não é possível excluir esse registro, pois a conferência da matéria prima/envase já foi realizada.', ['&O k'])
                                  else
                                    fMensagem('ATENÇÃO!', 'Não é possível excluir esse registro, pois existe movimentação para o mesmo.', ['&O k']);
                                end;
      ERR_DEFAULT_PRINTER      :fMensagem('ATENÇÃO!', 'Não há impressora padrão selecionada!', ['&O k']);
      ERR_GATILHO_PERIODO      :begin
                                  pGravarErro(True, 'Não existem Períodos de envio de gatilho cadastrados.');
                                  fMensagem('ATENÇÃO!', 'Não existem Períodos de envio de gatilho cadastrados.', ['&O k']);
                                end;
    End;

    strMsgErroComLocal := MensErro + IIF(LocalErro.IsEmpty, '', ' - Local: ' + LocalErro);
    If (VS_strAllErrorsMessages.IsEmpty) Then
      VS_strAllErrorsMessages := strMsgErroComLocal
    Else
      VS_strAllErrorsMessages := VS_strAllErrorsMessages + sLineBreak + strMsgErroComLocal;

    If (VS_blnTraceErrorMessage) Then
      pGravarErro(True, strMsgErroComLocal, fRetornaStack, EmptyStr, conexao);
  Finally
    VS_strError := '';
    VS_strLocalErro := '';
    VS_strMensagemErro := '';
  End;
end;

