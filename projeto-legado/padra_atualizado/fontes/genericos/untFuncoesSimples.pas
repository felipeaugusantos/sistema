function fAcertaDataParaDiaUtil(Const dtaOrigem: TDateTime; strCodCid: String = ''): TDateTime;
begin
  Result := dtaOrigem;
  While (fDiaDeFolga(Result, True, IIF(fCfgSis('FEMUCP', varBoolean), strCodCid, ''))) Do
  Begin
    Result := Result + 1;
  End;
end;

function fAcertaDataParaDiaUteis(Const dtaOrigem: TDateTime; qtdDias: Integer; blnConsiderarFDSComoDiaUtil : Boolean; strCodCid : String): TDateTime;
  Var
    intCont: Integer;
    blnVeioPrimeiroDiaFolga: Boolean;
    blnSabDomComoDiaUtil : Boolean;
begin
  Result := dtaOrigem;
  blnVeioPrimeiroDiaFolga := False;
  blnSabDomComoDiaUtil := IIF(blnConsiderarFDSComoDiaUtil, fCfgSis('FSDUDP', varBoolean), blnConsiderarFDSComoDiaUtil);

  If (qtdDias > 0) And (Not fDiaDeFolga(Result, True, strCodCid, blnSabDomComoDiaUtil)) Then
    intCont := 1
  Else If (qtdDias = 1) And (fDiaDeFolga(Result, True, strCodCid, blnSabDomComoDiaUtil)) Then
  Begin
    intCont := 1;
    blnVeioPrimeiroDiaFolga := True;
  End
  Else If (qtdDias > 1) And (fDiaDeFolga(Result, True, strCodCid, blnSabDomComoDiaUtil)) Then
    intCont := 2
  Else
    intCont := 0;

  While (intCont <= qtdDias) Or (fDiaDeFolga(Result, True, strCodCid, blnSabDomComoDiaUtil)) Do
  Begin
    If Not (fDiaDeFolga(Result, True, strCodCid, blnSabDomComoDiaUtil)) Then
    Begin
      If (qtdDias = 1) And (blnVeioPrimeiroDiaFolga) Then
        Result := Result
      Else If (qtdDias > 0) Then
        Result := Result + 1;

      intCont := intCont + 1;
    End
    Else
      Result := Result + 1;
  End;


  if (not blnConsiderarFDSComoDiaUtil) and (fDiaDeFolga(Result, True, strCodCid, blnSabDomComoDiaUtil)) then
    Result := Result + 1;

End;


function fDiaDeFolga(dtaDta: TDateTime; blnConsideraSabado : Boolean = True;
                     strCodCid: String = ''; blnConsideraSabadoAndDomingoComoDiaUtil: Boolean = False;
                     blnConsideraDomingo: Boolean = False): Boolean;
  Const
    SABADO = 7;
    DOMINGO = 1;
begin
  If blnConsideraSabadoAndDomingoComoDiaUtil Then
    Result := fEhFeriado(dtaDta, strCodCid)
  Else
  Begin
    If blnConsideraSabado Then
      Result := (DayOfWeek(dtaDta) In [DOMINGO, SABADO]) Or (fEhFeriado(dtaDta, strCodCid))
    Else If (blnConsideraDomingo) And (DayOfWeek(dtaDta) = DOMINGO) then
      Result := fEhFeriado(dtaDta, strCodCid)
    Else
      Result := (DayOfWeek(dtaDta) = DOMINGO) Or (fEhFeriado(dtaDta, strCodCid));
  End;
end;

function fEhFeriado(dtaDta: TDateTime; strCodCid: String = ''): Boolean;
  Var
    intCont: Integer;
    strDTa: String;
begin
  intCont := 0;
  strDta := FormatDateTime('yyyy-mm-dd', dtaDta);

  intCont := intCont + fCampoTabela('COUNT(*) AS QTD', 'CADFER', ['FER_DTAFER'], [strDta], False);

  If Not fEmptyStr(strCodCid) Then
  Begin
    intCont := intCont + fCampoTabela('COUNT(*) AS QTD', 'FERCID', ['FCI_DTAFER', 'FCI_CODCID'], [strDta, strCodCid], False);
  End;

  Result := intCont > 0;
end;

function fExisteFeriado(strCodCid: String): Boolean;
  Var
    qryDados: TUniQuery;
begin
  qryDados := fCriaQuery;

  Try
    qryDados.Close;
    qryDados.SQL.Clear;
    qryDados.SQL.Text := ' SELECT COUNT(*) AS QTD FROM FERCID      '+
                         ' WHERE                                   '+
                         '   FCI_CODCID = :CODCID AND              '+
                         '   FCI_DTAFER BETWEEN CURDATE() AND      '+
                         '     DATE_ADD(CURDATE(), INTERVAL 15 DAY)'+
                         ' ORDER BY FCI_DTAFER                     ';

    qryDados.ParamByName('CODCID').AsString := strCodCid;
    qryDados.Open;

    Result := (Not qryDados.IsEmpty) And (qryDados.FieldByName('QTD').AsInteger > 0);
  Finally
    FreeAndNil(qryDados);
  End;
end;

function fExisteAlgumFeriadoCadastrado: Boolean;
begin
  Result := fCampoTabela('COUNT(1)', 'FERCID', ['1'], ['1'], False) > 0;
end;

