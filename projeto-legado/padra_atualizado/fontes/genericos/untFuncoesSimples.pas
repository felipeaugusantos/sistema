function fRetPorDesPeloAutIncFdo(strAutInc: String): Double;
  Var
    qryGen: TUniQuery;
begin
  Result := 0;

  qryGen := fCriaQuery;
  Try
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Text :=
        'SELECT IFNULL(MG.GER_PORDES,0) AS GER_PORDES ' +
        '      FROM FATDOR FD        ' +
        '      INNER JOIN EXTDOR ED ON ED.FDO_SEQFDO = FD.AUTOINCREM ' +
        '      INNER JOIN MOVDET MD ON ED.FDO_INCFUT = MD.AUTOINCREM ' +
        '      INNER JOIN MOVGER MG ON MD.DET_SEQGER = MG.AUTOINCREM ' +
        'WHERE FD.AUTOINCREM = :AUTINC';
      ParamByName('AUTINC').AsString := strAutInc;
      Open;
      If (Not IsEmpty) Then
        Result := FieldByName('GER_PORDES').Value;
      Close;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
End;

