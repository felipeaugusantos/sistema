function fEhAdministrador(strCodOpe: String): Boolean;
Begin
  Result := SameText('999', strCodOpe) Or
            SameText('998', strCodOpe) Or
            SameText('997', strCodOpe);
End;

{********************************************************}
{* VERIFICAD SE O OPERADOR TEM DIREITO AO FORM A SER    *}
{* ACESSADO RETORNANDO TRUE SE TEM ACESSO E FALSE SE    *}
{* NAO TEM ACESSO                                       *}
{*****************************************************AF*}
function fVerPermissaoOperador(strNomForm: String; strCodOpe: String = ''): Boolean;
  Var
    strOperador: String;
    strSQL     : String;
    qryGenOpe  : TUniQuery;

begin
  Try

    qryGenOpe := fCriaQuery;

    If (Not fEmptyStr(strCodOpe)) Then
      strOperador := strCodOpe
    Else
      strOperador := strLoginUsuarioLogado;

    If (strNomForm = 'frmLogoff') Or (strNomForm = 'frmSobre') Or (strNomForm = 'frmUtilMenuPAFNFCe') Then
    Begin
      Result := True;
      exit;
    End;

    If Not fEhAdministrador(strOperador) Then
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  * ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '   DIROPE ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '   OPE_CODOPE = :CODOPE AND ';
      strSQL := strSQL + '   DIR_NOMFRM = :NOMFRM ';
      Result := False;
      With qryGenOpe Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODOPE').AsString := strOperador;
        ParamByName('NOMFRM').AsString := strNomForm;
        Open;
        If Not IsEmpty Then
          Result := True;
      End;
      qryGenOpe.Close;
    End
    Else
      Result := True;

  Finally
    FreeAndNil(qryGenOpe);
  End;

end;

function fExisteCorrecao(strAutInc: String): Boolean;
CONST
  SQL_CORRECAO = ' SELECT *,                             '+
                 '        0.0000 AS QTD_OP ,             '+
                 '        0.0000 AS QTD_UTILIZADA,       '+
                 '        "" AS REFERENCIA FROM DEICOR D ';

  SQL_CORRECAO_WHERE = ' WHERE DMT_SEQORD = :SEQORD ';
var
  qryConsulta: TUniQuery;
begin
  qryConsulta:= fCriaQuery(Nil);
  Try
    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add(SQL_CORRECAO);
    qryConsulta.SQL.Add(SQL_CORRECAO_WHERE);
    qryConsulta.ParamByName('SEQORD').AsString:= strAutInc;
    qryConsulta.Open;
    result:= Not(qryConsulta.IsEmpty);
  Finally
    FreeAndNil(qryConsulta);
  End;
end;


{**********************************}
{* VERIFICA SE TEM PERMISSÃO NO   *}
{* CADOPE E NO CADGPO             *}
{*******************************AF*}
function fVerificaAcessoSistema(strNomeForm: String; strCodOpe: String = ''): Boolean;
  Var
    strOperador: String;
Begin
  If (Not fEmptyStr(strCodOpe)) Then
    strOperador := strCodOpe
  Else
    strOperador := strLoginUsuarioLogado;

  If (strNomeForm = 'frmLogoff') Or (strNomeForm = 'frmSobre') Or (strNomeForm = 'frmUtilMenuPAFNFCe') Then
    Exit(True);

  If fEhAdministrador(strOperador) Then
    Exit(True);

  Result := TPermissoesAcesso.GetInstance.fVerificaAcesso(strNomeForm, strOperador);

  Result := Result Or fEmptyStr(strNomeForm);
End;

function fVerificaAcessoMaster(strNomeForm: String; strCodOpe: String): Boolean;
Const
  SQL_DIROPE = ' SELECT DIR_OSNLIB FROM DIROPE WHERE OPE_CODOPE =:CODOPE AND DIR_NOMFRM =:NOMFRM '
             + ' UNION ALL '
             + ' SELECT DIR_OSNLIB FROM DIRGPO DG INNER JOIN OPEGPO OG ON (DG.GPO_CODGPO = OG.GPO_CODGPO) WHERE OG.OPE_CODOPE =:CODOPE AND DG.DIR_NOMFRM =:NOMFRM ';
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery;

  Try
    qryAux.SQL.Add(SQL_DIROPE);
    qryAux.ParamByName('CODOPE').AsString := strCodOpe;
    qryAux.ParamByName('NOMFRM').AsString := strNomeForm;
    qryAux.Open;

    Result := qryAux.FieldByName('DIR_OSNLIB').AsString.Equals('N');
  Finally
    FreeAndNil(qryAux);
  End;
end;

