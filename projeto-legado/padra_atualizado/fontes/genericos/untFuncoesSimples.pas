procedure pLiberaExecucaoRobos;
const
  KeyAssociations =
    'Software\Microsoft\Windows\CurrentVersion\Policies\Associations';

  ExeNames: Array [0 .. 5] of string = ('autcom.exe', 'ReservaItemPedidoMonitor.exe',
    'StatusPedidoMonitor.exe', 'RecalculoSaldoReservadoMonitor.exe',
    'RecalculoEntregaFuturaMonitor.exe', 'EnviaEmailBoletoMonitor.exe');
var
  I: Integer;
  ExeName: String;
  Registry: TRegistry;
  LowRiskFileTypes: String;
begin
  Registry := TRegistry.Create;
  try
    Registry.RootKey := HKEY_CURRENT_USER;

    try
      if not Registry.KeyExists(KeyAssociations) then
        Registry.CreateKey(KeyAssociations);

      Registry.OpenKey(KeyAssociations, True);

      LowRiskFileTypes := Registry.ReadString('LowRiskFileTypes');

      for I := Low(ExeNames) to High(ExeNames) do
      begin
        ExeName := ExeNames[I];

        if ExeName = 'autcom.exe' then
          ExeName := ExtractFileName(Application.ExeName);

        if not LowRiskFileTypes.Contains(ExeName) then
        begin
          if not LowRiskFileTypes.Trim.EndsWith(';') then
            if not LowRiskFileTypes.IsEmpty then
              LowRiskFileTypes := LowRiskFileTypes + ';';

          LowRiskFileTypes := LowRiskFileTypes + ExeName + ';';

          Registry.WriteString('LowRiskFileTypes', LowRiskFileTypes);
        end;
      end;

      Registry.CloseKey;
    except
      // do nothing
    end;
  finally
    Registry.Free;
  end;
end;

