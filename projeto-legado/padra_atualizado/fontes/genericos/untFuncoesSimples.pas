      End;
    End;
  Finally
    FreeAndNil(qryConsulta);
  End;
End;

function fPermiteModalidadeParaPortador(fltDinRec, fltCarRec, fltChqRec, fltChqPre, fltOrdRec, fltFinRec: Double; strPorBai: String): Boolean;
var
  qryPorBai: TUniQuery;
begin
  Result := True;

  Try
    qryPorBai := fCriaQuery;

    qryPorBai.SQL.Add('SELECT POR_MODDIN, POR_MODCHV, POR_MODCHP, ');
    qryPorBai.SQL.Add('POR_MODCAR, POR_MODORD, POR_MODFIN FROM CADPOR ');
    qryPorBai.SQL.Add('WHERE POR_CODPOR = :CODPOR ');
    qryPorBai.ParamByName('CODPOR').AsString := strPorBai;
    qryPorBai.Open;

    If (fltDinRec > 0) And (qryPorBai.FieldByName('POR_MODDIN').AsString = 'N') Then
      Result := False
    Else
    If (fltCarRec > 0) And (qryPorBai.FieldByName('POR_MODCAR').AsString = 'N') Then
      Result := False
    Else
    If (fltChqRec > 0) And (qryPorBai.FieldByName('POR_MODCHV').AsString = 'N') Then
      Result := False
    Else
    If (fltChqPre > 0) And (qryPorBai.FieldByName('POR_MODCHP').AsString = 'N') Then
      Result := False
    Else
    If (fltOrdRec > 0) And (qryPorBai.FieldByName('POR_MODORD').AsString = 'N') Then
      Result := False
    Else
    If (fltFinRec > 0) And (qryPorBai.FieldByName('POR_MODFIN').AsString = 'N') Then
      Result := False;

  Finally
    FreeAndNil(qryPorBai);
  End;

end;

