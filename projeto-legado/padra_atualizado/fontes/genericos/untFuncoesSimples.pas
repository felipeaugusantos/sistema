function fEhMesmaBaseCNPJ(const strCodEmp1, strCodEmp2: String;
  const blnExibirMensagem: Boolean): Boolean;
var
  qryDados : TUniQuery;
begin
  If (fEmptyStr(strCodEmp1)) Or
     (fEmptyStr(strCodEmp2)) Then
  Begin
    If blnExibirMensagem Then
      pMensagemOk('Não foi possível verificar se os CNPJs estão na mesma base '+
                  'pois as empresas não foram informadas corretamente para '+
                  'checagem.');

    Exit(False);
  End;

  If strCodEmp1.Equals(strCodEmp2) Then
    Exit(True);

  qryDados := fCriaQuery();
  Try
    qryDados.SQL.Text := 'SELECT '
                       + '        (SELECT EMP_C_G_C_ FROM CADEMP '
                       + '          WHERE EMP_CODEMP = :CODEM1)    AS EMP_CNPJ01 '
                       + '      , (SELECT EMP_C_G_C_ FROM CADEMP '
                       + '          WHERE EMP_CODEMP = :CODEM2)    AS EMP_CNPJ02 ';
    qryDados.ParamByName('CODEM1').AsString := strCodEmp1;
    qryDados.ParamByName('CODEM2').AsString := strCodEmp2;
    qryDados.Open;

    If (fEmptyStr(qryDados.FieldByName('EMP_CNPJ01').AsString)) Or
       (fEmptyStr(qryDados.FieldByName('EMP_CNPJ02').AsString)) Then
    Begin
      If blnExibirMensagem Then
        pMensagemOk('Não foi possível verificar se os CNPJs estão na mesma base '+
                    'pois as empresas não foram informadas corretamente para '+
                    'checagem.');

      Exit(False);
    End;

    Result := (Copy(qryDados.FieldByName('EMP_CNPJ01').AsString,1,8)
                 .Equals(Copy(qryDados.FieldByName('EMP_CNPJ02').AsString,1,8)));

    If (Not Result) And
       (blnExibirMensagem) Then
      pMensagemOk('Empresa informada não pertence ao CNPJ base da Empresa '+
                  'logada, portanto não é permitido realizar a operação.');
  Finally
    FreeAndNil(qryDados);
  End;
end;

