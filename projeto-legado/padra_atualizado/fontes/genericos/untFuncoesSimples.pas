Function fPedidoEhRetiraExpedicaoOriginadoDeOutroPedido(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryFatDor: TUniQuery;
Begin
  Result := False;

  qryFatDor := fCriaQuery;
  Try
    qryFatDor.SQL.Text := 
         ' SELECT COUNT(*) FROM FATDOR F_FAT ' +
         '                 INNER JOIN EXTDOR E_FAT ON E_FAT.FDO_SEQFDO = F_FAT.AUTOINCREM ' + 
         ' WHERE F_FAT.FDO_NUMDOC = :NUMDOC ' + 
         '   AND F_FAT.FDO_ESPDOC = :ESPDOC ' + 
         '   AND F_FAT.FDO_CODEMP = :CODEMP ' + 
         '   AND E_FAT.FDO_ENTRET = "R" ' + 
         '   AND E_FAT.FDO_LOCRET = "E" ' + 
         '   AND ((SELECT COUNT(*) FROM FATDOR F_ORI ' + 
         '                         INNER JOIN EXTDOR E_ORI ON E_ORI.FDO_SEQFDO = F_ORI.AUTOINCREM ' + 
         '         WHERE F_ORI.FDO_NUMFAT=F_FAT.FDO_NUMDOC ' + 
         '           AND F_ORI.FDO_TIPFAT=F_FAT.FDO_ESPDOC ' +
         '           AND F_ORI.FDO_EMPFAT=F_FAT.FDO_CODEMP ' +
         '           AND F_ORI.FDO_CODCLI=F_FAT.FDO_CODCLI ' +
         '           AND F_ORI.FDO_ESPDOC = "PD" ' +
         '           AND E_ORI.FDO_ENTRET = "R" ' + 
         '           AND E_ORI.FDO_LOCRET = "E") > 0) '; 

    qryFatDor.ParamByName('NUMDOC').AsString := strNumDoc;
    qryFatDor.ParamByName('ESPDOC').AsString := strEspDoc;
    qryFatDor.ParamByName('CODEMP').AsString := strCodEmp;

    qryFatDor.Open;

    If (Not qryFatDor.IsEmpty) Then
      Result := (qryFatDor.Fields[0].AsInteger > 0);

    qryFatDor.Close;
  Finally
    FreeAndNil(qryFatDor);
  End;
  
end;

