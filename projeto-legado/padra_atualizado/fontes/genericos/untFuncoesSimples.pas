Function fretCFOPBonificacaoNotaElet(strAutInc: String): String;
  Var
    qryDetEle: TUniQuery;
Begin
  qryDetEle := fCriaQuery;
  Try
    qryDetEle.SQL.Clear;
    qryDetEle.SQL.Add('SELECT ');
    qryDetEle.SQL.Add(' IF(I08_CFOP > "5000", ');
    qryDetEle.SQL.Add('                  (IF( (LEFT(I08_CFOP,1) = 5 OR B25B_INDPRES IN(1, 5)), ');
    qryDetEle.SQL.Add('                                             CONCAT(1, RIGHT(I08_CFOP,3)), ');
    qryDetEle.SQL.Add('                                             CONCAT(2, RIGHT(I08_CFOP,3)))), ');
    qryDetEle.SQL.Add('                  I08_CFOP ');
    qryDetEle.SQL.Add('                    ) AS I08_CFOP  ');
    qryDetEle.SQL.Add(' FROM DETELE');
    qryDetEle.SQL.Add('  INNER JOIN GERELE ON GERELE.AUTOINCREM = DETELE.DET_SEQGER ');
    qryDetEle.SQL.Add(' WHERE ');
    qryDetEle.SQL.Add('  LOCATE("910", I08_CFOP) > 0 AND ');
    qryDetEle.SQL.Add('  DET_SEQGER = :AUTINC' );
    qryDetEle.SQL.Add(' LIMIT 1' );

    qryDetEle.ParamByName('AUTINC').AsString := strAutInc;
    qryDetEle.Open;

    If qryDetEle.IsEmpty Then
      Result := ''
    Else
      Result := qryDetEle.FieldByName('I08_CFOP').AsString;
  Finally
    FreeAndNil(qryDetEle);
  End;
End;

function fTemDocumentoWMSSemEnderecamento(strCodEmp, strCodFor, strNumDoc, strEspDoc, strSerie, strCodIte, strOpcDoc : String;
  blnShowMsg: Boolean = False):Boolean;
var
  qryEnder          : TUniQuery;
begin
  Result := False;

  If (strOpcDoc = 'OF') And
     (fUsaRotinaWMS) And
     (fConferenciaDepoisDaEntrada) And
     (fCfgSis('TPLREC', varString) <> 'N') Then
  Begin

    qryEnder := fCriaQuery();

    Try

      qryEnder.SQL.Add('SELECT                                            ');
      qryEnder.SQL.Add('  FGO_DOCEND                                      ');
      qryEnder.SQL.Add('FROM                                              ');
      qryEnder.SQL.Add('  FATGOR A                                        ');
      qryEnder.SQL.Add('  INNER JOIN EXTGOR B                             ');
      qryEnder.SQL.Add('    ON A.AUTOINCREM = B.FGO_SEQFGO                ');
      qryEnder.SQL.Add('  INNER JOIN FATDOR C                             ');
      qryEnder.SQL.Add('    ON A.AUTOINCREM = C.FDO_SEQGER                ');
      qryEnder.SQL.Add('  INNER JOIN MOVDET M                             ');
      qryEnder.SQL.Add('    ON DET_NUMDOC = SUBSTRING(FGO_DOCEND, 1, 12)  ');
      qryEnder.SQL.Add('    AND DET_ESPDOC = SUBSTRING(FGO_DOCEND, 13, 2) ');
      qryEnder.SQL.Add('    AND DET_SERIE_ = SUBSTRING(FGO_DOCEND, 15, 3) ');
      qryEnder.SQL.Add('    AND DET_CODEMP = SUBSTRING(FGO_DOCEND, 18, 3) ');
      qryEnder.SQL.Add('    AND DET_CODITE = FDO_CODITE                   ');
      qryEnder.SQL.Add('    AND FDO_JAFATU = "0"                          ');
      qryEnder.SQL.Add('WHERE FGO_JAFATU = "0"                            ');
      qryEnder.SQL.Add('  AND IFNULL(FGO_DOCEND,"") <> ""                 ');
      qryEnder.SQL.Add('  AND DET_CODEMP = :CODEMP                        ');
      qryEnder.SQL.Add('  AND DET_CODFOR = :CODFOR                        ');
      qryEnder.SQL.Add('  AND DET_NUMDOC = :NUMDOC                        ');
      qryEnder.SQL.Add('  AND DET_ESPDOC = :ESPDOC                        ');
      qryEnder.SQL.Add('  AND DET_SERIE_ = :SERIE_                        ');
      qryEnder.SQL.Add('  AND DET_CODITE = :CODITE                        ');
      qryEnder.SQL.Add('  AND FDO_JAFATU = "0"                            ');

      qryEnder.ParamByName('CODEMP').AsString := strCodEmp;
      qryEnder.ParamByName('CODFOR').AsString := strCodFor;
      qryEnder.ParamByName('NUMDOC').AsString := strNumDoc;
      qryEnder.ParamByName('ESPDOC').AsString := strEspDoc;
      qryEnder.ParamByName('SERIE_').AsString := strSerie;
      qryEnder.ParamByName('CODITE').AsString := strCodIte;

      qryEnder.Open;

      If (Not qryEnder.IsEmpty) Then
      Begin
        If (blnShowMsg) Then
        Begin
          fMensagem('ATENÇÃO!',
                    'O documento e item selecionado possui pedido de endereçamento'+ #10+#13 +
                    'pendente e por isso, não é permitido fazer operações de outras'+ #10+#13 +
                    'saídas para fornecedor. Se você deseja fazer a devolução do produto'+ #10+#13 +
                    'ao fornecedor, acesse a rotina "Principal > Movimentação de itens >' + #10+#13 +
                    'Devolução de Mercadorias - Pré-Nota" e faça a operação de devolução' + #10+#13 +
                    'por lá. Se não, entre em contato com o setor responsável pelo' + #10+#13 +
                    'endereçamento e veja porque a entrada ainda não foi finalizada.' + #10+#13 +
                    'Pedido de endereçamento localizado: ' + qryEnder.FieldByName('FGO_DOCEND').AsString,
                    ['&O k'],
                    1,
                    False,
                    1,
                    0,
                    False,
                    0,
                    False,
                    False,
                    False,
                    0,
                    0,
                    8
                    );
        End;

        Result := True;
      End;
    Finally
      FreeAndNil(qryEnder);
    End;
  End;
end;

