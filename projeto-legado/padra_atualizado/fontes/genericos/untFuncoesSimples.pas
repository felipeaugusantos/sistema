function fDocumentoComEntregaUrgente(strNumDoc, strEspDoc, strEmpDoc, strCliDoc: String): Boolean;
  Var
    qryGen: TUniQuery;
begin
  qryGen := fCriaQuery;

  With qryGen, SQL Do
  Begin
    Close;
    Clear;

    If Pos(strEspDoc, 'PD_OR_') > 0 Then
    Begin
      Add('SELECT SQL_NO_CACHE');
      Add('  FGO_ENTURG AS ENTURG');
      Add('FROM');
      Add('  FATGOR');
