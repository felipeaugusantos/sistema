{**************************}
{* CALCULA VRCOMPRA       *}
{***********************AF*}
function fCalculaValorCompra( curPreCom, curDesF01, curDesF02, curDesF03,
  curDesF04, curDesF05, curDesF06, curAcrFin: Double ): Double;
Begin

  Result := curPrecom;
  Result := Result * ( 1 - ( curDesF01 / 100 ) );
  Result := Result * ( 1 - ( curDesF02 / 100 ) );
  Result := Result * ( 1 - ( curDesF03 / 100 ) );
  Result := Result * ( 1 - ( curDesF04 / 100 ) );
  Result := Result * ( 1 - ( curDesF05 / 100 ) );
  Result := Result * ( 1 - ( curDesF06 / 100 ) );
  Result := Result * ( 1 + ( curAcrFin / 100 ) );


End;

