function fRetCliConPeloAutInc(strTabela, strIncDev: String): String;
  Var
    strSQL   : String;
    qryGen: TUniQuery;
begin
  Result := '';
  If Pos(strTabela, 'MOVDET_NOTDET_FATGOR_') > 0 Then
  Begin
    qryGen := fCriaQuery;
    Try
      strSQL := '';
      If (strTabela = 'FATGOR') Then
      Begin
        strSQL := strSQL + ' SELECT E.FGO_CONSUM ';
        strSQL := strSQL + '   FROM FATGOR G INNER JOIN EXTGOR E ON E.FGO_SEQFGO=G.AUTOINCREM ';
        strSQL := strSQL + '  WHERE G.AUTOINCREM = :AUTOINCREM ';
      End
      Else
      Begin
        strSQL := strSQL + ' SELECT G.GER_CONSUM ';
        strSQL := strSQL + '   FROM MOVDET D INNER JOIN MOVGER G ON D.DET_SEQGER = G.AUTOINCREM ';
        strSQL := strSQL + '  WHERE D.AUTOINCREM = :AUTOINCREM ';
      End;

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        If (strTabela = 'NOTDET') Then
          strSQL := AnsiReplaceStr(AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER'), 'MOVDET', 'NOTDET');
        SQL.Add(strSQL);
        ParamByName('AUTOINCREM').AsString := strIncDev;
        Open;
        Result := Fields[0].AsString;
        Close;
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

