function fPermiteReplicarCfgSis(ASQL: String): Boolean;
begin
  If Not fRetornaNomeTabela(ASQL).Equals('CFGSIS') Then
    Exit(False);
  If fTabelaReplica('CFGSIS') Then
    Exit(True);
  If fConfiguracaoPermiteReplicar(fExtrairCodigoConfiguracao(ASQL)) Then
    Exit(True);
  Result := False;
end;

function fExtrairCodigoConfiguracao(ASQL: String): String;
Var
  LVal: String;
begin
  Result := EmptyStr;
  ASQL := UpperCase(ASQL);
  If Not ASQL.Contains('''CFG_') Then
    Exit;
  Repeat
    LVal := fExtractBetweenTags(ASQL, '''', '''');
    If LVal.StartsWith('CFG_') Then
      Exit(LVal);
    ASQL := Trim(Copy(ASQL, Pos(LVal, ASQL) + Length(LVal) + 1, Length(ASQL)));
    If ASQL = EmptyStr Then
      Break;
    If (LVal.IsEmpty) And (ASQL.StartsWith('CFG_')) And (Length(ASQL) = Succ(CFG_LENGTH)) Then
      Exit(LeftStr(ASQL, CFG_LENGTH));
  Until False;
end;

function fInsertCFGAUX(pgbProgresso: TcxProgressBar): Boolean;
  Var
    I: Integer;
    qryGen: TUniQuery;
    strCodCfg,
    strPerRep,
    strUsoCit: String;

    function fAspas(const strVal: string): string;
    begin
      Result := '"'+strVal+'"';
    end;

begin
  qryGen := fCriaQuery(Nil);
  Try
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add('REPLACE INTO CFGAUX (CFG_CODCFG, CFG_PERREP, CFG_USOCIT) VALUES ');

    If (not Assigned(arrCamposCfg)) Then
      TfrmCfgRepositorio.pMontaArrConfiguracoes();

    If Assigned(pgbProgresso) Then
    Begin
      pgbProgresso.Properties.Max := Length(arrCamposCfg);
      pgbProgresso.Position := 0;
    End;

    For I := 0 To Length(arrCamposCfg) - 1 Do
    Begin
      If (I mod 50 = 0) Then
        If Assigned(pgbProgresso) Then
          pStepStatusGravacao(pgbProgresso);

      strCodCfg := fAspas(arrCamposCfg[I].strCodCfg);
      strPerRep := fAspas(arrCamposCfg[I].strPerRep);
      strUsoCit := fAspas(arrCamposCfg[I].strUsoCit);

      //Configuracoes de PATH nao serao replicadas, duvidas falar com RO ou JC
      If fEhConfiguracaoPath(arrCamposCfg[I].strCodCfg) Then
        strPerRep := fAspas('N');

      qryGen.SQL.Add(IIF(I>0,',',' ') + '('+strCodCfg + ',' + strPerRep +',' + strUsoCit+')');
    End;

    qryGen.ExecSQL;

    Result := True;
  Finally
    FreeAndNil(qryGen);
  End;
end;

