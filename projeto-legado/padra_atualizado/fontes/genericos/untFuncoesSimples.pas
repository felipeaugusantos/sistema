function fMarcarPedidoComoImpresso(strNumDoc, strEspDoc, strCodEmp: String; blnDocSep, blnImpExpedicao: Boolean; strCodSep: String = ''): Boolean;
  Var
    qryUpdate: TUniQuery;
Begin
  qryUpdate := fCriaQuery;
  try
    Result := False;
  With qryUpdate, SQL Do
  Begin
    Add('UPDATE    ');
    Add('  FATGOR, ');
    Add('  EXTGOR  ');
    Add('SET       ');
    Add('  FGO_PEDIMP = "S" ');

    If blnDocSep Or blnImpExpedicao Then
    Begin
      Add('  ,FGO_SEPIMP = IF(IFNULL(FGO_SEPIMP,"0") = "0" OR FGO_SEPIMP = "N", "1", ');
      Add('                IF(FGO_SEPIMP = "2", "3", FGO_SEPIMP)) ');
      Add('  ,FGO_DTIMSE = :DTIMSE ');
      Add('  ,FGO_HRIMSE = :HRIMSE ');
      Add('  ,FGO_CANFAT = 0 ');
    End;

    If Not fEmptyStr(strCodSep) Then
    Begin
      Add(' ,EXTGOR.FGO_SEPEXP = :CODSEP');
    End;

    Add('WHERE    ');
    Add('  FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO AND ');
    Add('  FGO_CODEMP = :CODEMP AND ');
    Add('  FGO_ESPDOC = :ESPDOC AND ');
    Add('  FGO_NUMDOC = :NUMDOC     ');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;

    If blnDocSep Or blnImpExpedicao Then
    Begin
      ParamByName('DTIMSE').AsDateTime := VS_Date;
      ParamByName('HRIMSE').AsDateTime := fTime();
    End;

    If Not fEmptyStr(strCodSep) Then
    Begin
      ParamByName('CODSEP').AsString := strCodSep;
    End;

    ExecSQL;

    Result := True;
  End;
  finally
  FreeAndNil(qryUpdate);
end;
end;

