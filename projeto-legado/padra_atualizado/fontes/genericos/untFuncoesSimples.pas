function fRetNomeFormatado(strNome: String; blnSohPrimeiroNome: Boolean = False): string;
const
  arrExcecao: array[0..5] of string = (' da ', ' de ', ' do ', ' das ', ' dos ', ' e ');
var
  intTamanho, intCount, intContador: integer;
begin
  Result := AnsiLowerCase(Trim(strNome));
  if (blnSohPrimeiroNome) and (Pos(' ', Result) > 0) then
    Result := Copy(Result, 1, Pos(' ', Result)-1);

  intTamanho := Length(Result);

  for intCount := 1 to intTamanho do
  begin
    if (intCount = 1) or ((intCount>1) and (Result[intCount-1]=Chr(32))) then
      Result[intCount] := AnsiUpperCase(Result[intCount])[1];
  end;

  for intContador := 0 to Length(arrExcecao)-1 do
    Result:= StringReplace(Result, arrExcecao[intContador], arrExcecao[intContador], [rfReplaceAll, rfIgnoreCase]);
end;

function fDebChequesRepassadoNaoVencidos(strCodCli: String): Double;
var
  strSQL: String;
  qryCadChq: TUniQuery;
begin
  qryCadChq := fCriaQuery;

  try
    strSQL := '';
    strSQL := strSQL + 'SELECT                               ';
    strSQL := strSQL + '  IFNULL(SUM(CHQ_VALCHQ), 0) VALCHQ  ';
    strSQL := strSQL + 'FROM CADCHQ                          ';
    strSQL := strSQL + '  INNER JOIN CADCLI ON CLI_CODCLI = CHQ_CODCLI ';
    strSQL := strSQL + 'WHERE (CLI_CODCLI = :CODCLI          ';

    If fCfgSis('TRFTCR', varString) = '2' Then
    Begin
      strSQL := strSQL + '    OR CLI_CODRED =                ';
      strSQL := strSQL + '    (SELECT                        ';
      strSQL := strSQL + '       CLI_CODRED                  ';
      strSQL := strSQL + '     FROM                          ';
      strSQL := strSQL + '       CADCLI                      ';
      strSQL := strSQL + '     WHERE CLI_CODCLI = :CODCLI)   ';
    End;

    strSQL := strSQL + '  )                                  ';
    strSQL := strSQL + '  AND CHQ_CTADEP = "REPASSE"         ';
    strSQL := strSQL + '  AND CHQ_DTAVEN >= CURDATE()        ';
    strSQL := strSQL + '  AND CHQ_INCCTR = "N"               ';
    strSQL := strSQL + '  AND IFNULL(CHQ_TELCHE, "N") <> "S" ';

    qryCadChq.Close;
    qryCadChq.SQL.Clear;
    qryCadChq.SQL.Add(strSQL);
    qryCadChq.ParamByName('CODCLI').AsString := strCodCli;
    qryCadChq.Open;

    Result := qryCadChq.FieldByName('VALCHQ').AsFloat;
  finally
    FreeAndNil(qryCadChq);
  end;
end;

