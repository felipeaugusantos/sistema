function fFrac(const fltValor: Double): Double;
begin
  Result := fFormataFloat(fltvalor, 6) - Trunc(fFormataFloat(fltvalor, 6));
end;

function fModDouble(fltDividendo, fltDivisor: Double): Double;
begin
  try
    Result := Frac(fltDividendo/fltDivisor)*fltDivisor;
  except
    On E: EDivByZero Do
    begin
      Result := 0;
    end;
  end;
end;

function fMenorMultiploValido(fltQtd, fltMlt: Double;  blnOlhaCFG: Boolean; Out blnCorteMulti: Boolean): Double;
 Var
   fltPassoSubtr: Double;
   strCfgMltVen: String;
begin
  Result := fltQtd;
  blnCorteMulti := False;
  strCfgMltVen := fCfgSis('MLTVEN', varString);

  If (((fltMlt = 1) Or (fltMlt = 0)) And (Frac(fFormataFloat(fltQtd, 6)) = 0)) Or
     (blnOlhaCFG And (strCfgMltVen = '2')) Then
  Begin
    Exit;
  End;

  If (blnOlhaCFG And (strCfgMltVen = '3')) Then
  Begin
    blnCorteMulti := (fModDouble(fFormataFloat(fltQtd, 6), fltMlt) <> 0);
  End
  Else
  Begin
    If (Not blnOlhaCFG) Or
       (blnOlhaCFG And (Pos(strCfgMltVen, '1_4_') > 0)) Then
    Begin
      Result := fFormataFloat(fltQtd, 6);

      If (Frac(fltMlt) = 0) And (Frac(Result) = 0) Then
        fltPassoSubtr := 1
      Else
        fltPassoSubtr := 0.00001;

      While (Result > 0) And (fModDouble(Result, fltMlt) <> 0) Do
      Begin
        blnCorteMulti := True;
        Result := fFormataFloat(Result - fltPassoSubtr, 6);
      End;

      If Result < 0 Then
        Result := 0;
    End;
  End
end;

Procedure pUltimaCompra(strCodIte, strCodEmp, strAnoMes: String;
   chrOpcInv: Char; Var dtaUltComp: TDate; Var strNumDoc: String);
  Var
    qryUltComp: TUniQuery;
    strSQL     : String;
Begin
  qryUltComp := fCriaQuery;

  With qryUltComp Do
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT  ';
    strSQL := strSQL + '  D.DET_DTAENT AS "DTA_MOV",  ';
    strSQL := strSQL + '  D.DET_HORENT AS "HOR_MOV",  ';
    strSQL := strSQL + '  CONCAT(D.DET_NUMDOC, "-", D.DET_ESPDOC, "-", D.DET_CODEMP) AS NUMDOC ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVDET D  ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  D.DET_TIP_FC = "F"           AND ';
    strSQL := strSQL + '  D.DET_ESPDOC IN ("NF", "EL", "IF", "IV", "D1") AND ';

    If Not fEmptyStr(strCodEmp) Then
    Begin
      If Length(strCodEmp) > 3 Then
        strSQL := strSQL + '  D.DET_CODEMP IN (' + strCodEmp + ') AND '
      Else
        strSQL := strSQL + '  D.DET_CODEMP = :CODEMP      AND ';
    End;

    strSQL := strSQL + '  D.DET_CODITE = :CODITE      AND ';
    strSQL := strSQL + '  LOCATE(DET_CLAFIS, :CLACOM) > 0 ';

    Case chrOpcInv Of
      'F',
      'I': strSQL := strSQL + '  AND D.DET_DTAENT <= :DTAENT ';
    End;

    strSQL := strSQL + ' LIMIT 1 ';

    strSQL := 'SELECT * FROM ( SELECT * FROM ( ' + strSQL;
    strSQL := strSQL + ' ) AS TMP ';

    strSQL := strSQL + 'ORDER BY  ';

    strSQL := strSQL + '  DTA_MOV DESC, HOR_MOV DESC';

    strSQL := strSQL + ' ) AS TMP2 LIMIT 1 ';

    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODITE').Value    := strCodIte;
    ParamByName('CLACOM').AsString := VS_strClaCom;

    If (Not fEmptyStr(strCodEmp)) And (Params.FindParam('CODEMP') <> Nil) Then
      ParamByName('CODEMP').AsString    := strCodEmp;

    Case chrOpcInv Of
      'F',
      'I': ParamByName('DTAENT').AsDate := EndOfAMonth(StrToIntDef(copy(strAnoMes,1,4), 0), StrToIntDef(copy(strAnoMes,5,2), 0));
    End;

    Open;

    If IsEmpty Then
    Begin
      dtaUltComp := 0;
      strNumDoc  := '';
    End
    Else Begin
      dtaUltComp := FieldByName('DTA_MOV').AsDateTime;
      strNumDoc  := FieldByName('NUMDOC').AsString;
    End;

    Close;
  End;

  FreeAndNil(qryUltComp);

End;

