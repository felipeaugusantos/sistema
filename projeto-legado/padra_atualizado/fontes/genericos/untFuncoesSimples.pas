function fValidaCnpjCpf(strOpcao, strValor: String; blnPassaVazio: Boolean = True; blnPermiteDigitosIguais: Boolean = False; blnMostraMensagem : boolean = true): Boolean;
begin
  Result := True;
  If (blnPassaVazio) And (strOpcao = '0') Then
