function fRetSeOrigemEhPedidoEntregaPeloCDPeloAutInc(strTabela, strIncDev: String): Boolean;
  Var
    strSQL   : String;
    qryGen: TUniQuery;
begin
  Result := False;
  
  If Pos(strTabela, 'MOVDET_NOTDET_') > 0 Then
  Begin
    qryGen := fCriaQuery;
    Try
      strSQL := '';
      strSQL := strSQL + ' SELECT IFNULL(FGO_ENT_CD, "N") AS FGO_ENT_CD        ';
      strSQL := strSQL + '   FROM MOVDET D                                     ';
      strSQL := strSQL + '  INNER JOIN MOVAUX A ON D.AUTOINCREM = A.DET_SEQGER ';
      strSQL := strSQL + '  INNER JOIN FATDOR F ON F.AUTOINCREM = A.DET_INC_PD ';
      strSQL := strSQL + '  INNER JOIN FATGOR G ON G.AUTOINCREM = F.FDO_SEQGER ';

      If Pos(strTabela, 'NOTDET_') > 0 then
      Begin
        strSQL := strSQL + ' INNER JOIN NOTTRI ON D.AUTOINCREM      = NOTTRI.DET_SEQDET '+
                           ' INNER JOIN NOTDET ON NOTDET.AUTOINCREM = NOTTRI.DET_SEQGER '+
                           ' WHERE NOTDET.AUTOINCREM = :AUTOINCREM ';
      End
      Else
        strSQL := strSQL + '  WHERE D.AUTOINCREM = :AUTOINCREM ';

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('AUTOINCREM').AsString := strIncDev;
        Open;
        If (Not IsEmpty) Then
          Result := Fields[0].AsString = 'S';
        Close;
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

