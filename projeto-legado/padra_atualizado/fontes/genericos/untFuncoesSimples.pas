function fRetornaSeqFdoItemDocumento(const strNumDoc, strEspDoc, strCodEmp,
  strCodIte, strNumLot: String): String;
var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery;

  Try
    qryAux.SQL.Text := 'SELECT '
                     + '       AUTOINCREM '
                     + '  FROM FATDOR '
                     + ' WHERE FDO_NUMDOC = :NUMDOC '
                     + '   AND FDO_ESPDOC = :ESPDOC '
                     + '   AND FDO_CODEMP = :CODEMP '
                     + '   AND FDO_CODITE = :CODITE '
                     + '   AND IFNULL(FDO_NUMLOT,"") = :NUMLOT ';

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CODITE').AsString := strCodIte;
    qryAux.ParamByName('NUMLOT').AsString := strNumLot;

    qryAux.Open;

    Result := qryAux.FieldByName('AUTOINCREM').AsString;
  Finally
    FreeAndNil(qryAux);
  End;
end;

function fRetCodVenDef(strCodVen: String): String;
  Var
    qryGen: TUniQuery;
begin
  If fEmptyStr(strCodVen) Then
  Begin
    Result := strLoginUsuarioLogado;
    Exit;
  End;

  Try
    If (Not fCfgSis('USADIG', varBoolean)) Then
    Begin
      //NÃO USA DIGITADOR, ENTÃO BUSCA POR SENHA DO VENDEDOR
      qryGen := fCriaQuery;
      pPesquisaCadOpe(qryGen, qryGen, strCodVen, True);
      If Not qryGen.IsEmpty Then
        Result := qryGen.FieldByName('OPE_CODOPE').AsString;
      FreeAndNil(qryGen);
    End
    Else
    Begin
      //USA DIGITADOR, ENTÃO O PARAMENTRO DE ENTRADA JÁ É O CÓDIGO DO VENDEDOR
      Result := strCodVen;
    End;
  Finally
    If fEmptyStr(Result) Then
      Result := strLoginUsuarioLogado;
  End;
end;

