function ExtractFileNameCrossPlatform(const APath: string): string;
var
  LPos: Integer;
begin
  LPos := LastDelimiter('/\', APath);

  if LPos > 0 then
    Result := Copy(APath, LPos + 1, MaxInt)
  else
    Result := APath;
end;

function fCadFor(strNomCampo: String; strCodFor: String): String;
  Var
    strSQL   : String;
    qryGenFor: TUniQuery;

begin
  Try

    qryGenFor := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   CADFOR.*, ';
    strSQL := strSQL + '   CID_NOMCID AS "FOR_NOMCID", ';
    strSQL := strSQL + '   CID_ESTADO AS "FOR_ESTADO" ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   CADFOR ';
    strSQL := strSQL + '   JOIN CADCID ON FOR_CODCID = CID_CODCID ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '   FOR_CODFOR = :CODFOR ';

    With qryGenFor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODFOR').AsString := strCodFor;
      Open;

      If FieldByName('FOR_' + strNomCampo).IsNull Then
      Begin
        Result := '';
      End
      Else
      Begin
        Result := FieldByName('FOR_' + strNomCampo).AsVariant;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryGenFor);
  End;

end;

procedure RealizarRemocaoAutomaticaDaLckatc;
  Var
    LLckatc: TUniQuery;
    LChave: String;
Begin
  Try
    LLckatc := fCriaQuery(Nil);
    Try
      LLckatc.Close;
      LLckatc.SQL.Clear;
      LLckatc.SQL.Text := 'SELECT                                                   '+
                          '  LCK_CON_ID, LCK_CHAACE,                                '+
                          '  TIMEDIFF(CURRENT_TIME, LCK_HRALCK) AS TEMPO_TRAVADO    '+
                          'FROM                                                     '+
                          '  LCKATC                                                 '+
                          '  JOIN LOGACE                                            '+
                          '    ON LOG_CON_ID = LCK_CON_ID                           '+
                          'WHERE LOG_NOMEXE IN ("EnviaEmailBoletoMonitor.exe")      '+
                          '  AND LOG_DTAENT = CURRENT_DATE                          '+
                          'HAVING TEMPO_TRAVADO > "00:05:00"                        ';
      LLckatc.Open;

      If Not LLckatc.IsEmpty Then
      Begin
        LLckatc.First;
        While Not LLckatc.Eof Do
        Begin
          LChave := LLckatc.FieldByName('LCK_CHAACE').AsString.Replace(frmModulo.GetCurrentConnection.Database + '.','');

          fLock_Unlock(LChave,
                       False,
                       False,
                       False,
                       LLckatc.FieldByName('LCK_CON_ID').AsString);

          LLckatc.Next;
        End;
      End;

    Except
      On E: Exception Do
      Begin
        Raise Exception.Create(E.Message);
      End;
    End

  Finally
    FreeAndNil(LLckatc);
  End;

End;

function fRetOrigemLock(strNomeTabela: String): String;
  Var
    qryLock: TUniQuery;
Begin
  qryLock := fCriaQuery(Nil);
  With qryLock, SQL Do
  Begin
    Add('SELECT LCK_ORIGEM FROM LCKATC WHERE LCK_CHAACE = :CHAACE');
    ParamByName('CHAACE').AsString := strNomeTabela;
    Open;
    If IsEmpty Then
      Result := ''
    Else
      Result := FieldByName('LCK_ORIGEM').AsString;
  End;
  FreeAndNil(qryLock);
End;

function fGetTempoDuracaoLock(strNomeTabela: String; AUtilizaHoraServidor: Boolean = False): Double;
  Var
    qryLock: TUniQuery;
Begin
  qryLock := fCriaQuery(Nil);
  Result := 0;

  Try
    qryLock.SQL.Add('SELECT LCK_DTALCK, LCK_HRALCK FROM LCKATC WHERE LCK_CHAACE = :CHAACE');
    qryLock.ParamByName('CHAACE').AsString := frmModulo.GetCurrentConnection.Database + '.' + strNomeTabela;
    qryLock.Open;

    If Not qryLock.IsEmpty Then
    Begin
      Result := fNow - (qryLock.FieldByName('LCK_DTALCK').AsDateTime + qryLock.FieldByName('LCK_HRALCK').AsDateTime);
      If AUtilizaHoraServidor Then
        Result := fRetDtaHraServidor - (qryLock.FieldByName('LCK_DTALCK').AsDateTime + qryLock.FieldByName('LCK_HRALCK').AsDateTime);
    End;
  Finally
    qryLock.Close;

    FreeAndNil(qryLock);
  End;
End;

function fQuantidadeRobosDeMonitaramentoExecutando(ALike: String = '.MONITOR_'): Integer;
  Var
    qryLock: TUniQuery;
Begin
  qryLock := fCriaQuery(Nil);
  With qryLock Do
  Begin
    SQL.Add('SELECT SQL_NO_CACHE COUNT(0) FROM LCKATC WHERE LCK_CHAACE LIKE "%' + ALike +'%" ');
    Open;
    Result := Fields[0].AsInteger;
  End;
  FreeAndNil(qryLock);
end;

