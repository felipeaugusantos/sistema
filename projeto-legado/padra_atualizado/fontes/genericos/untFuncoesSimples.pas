{*****************************************}
{* VERIFICA SE EXISTE O CHEQUE NO CADCHQ *}
{**************************************LB*}
function fExisteCheque(strDocume, strCodEmp: String; intSeqCon: Integer;
  qryCheques: TUniQuery; dtaDtaCad: TDate = 0): Boolean;
  Var
    strSQL: String;
Begin
  Result := False;

  If fEmptyStr(strDocume) And (intSeqCon <= 0) Then
    Exit;

  If SameText(Trim(strDocume), 'DIVERSOS') Then
    Exit;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  CHQ_DOCUME, ';
  strSQL := strSQL + '  CHQ_NUMCHQ, ';
  strSQL := strSQL + '  CHQ_NOMEMI, ';
  strSQL := strSQL + '  CHQ_DTAVEN, ';
  strSQL := strSQL + '  CHQ_CODEMP, ';
  strSQL := strSQL + '  CHQ_VALCHQ, ';
  strSQL := strSQL + '  DATEDIFF(CHQ_DTAVEN, CHQ_DTACAD) AS CHQ_DIACHQ ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADCHQ ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CHQ_CODEMP = :CODEMP AND ';
  If intSeqCon > 0 Then
    strSQL := strSQL + '  CHQ_SEQCON = :SEQCON '
  Else
    strSQL := strSQL + '  CHQ_DOCUME LIKE :DOCUME ';
  If dtaDtaCad <> 0 Then
    strSQL := strSQL + ' AND CHQ_DTACAD = :DTACAD ';

  With qryCheques Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODEMP').AsString := strCodEmp;
    If intSeqCon > 0 Then
      ParamByName('SEQCON').AsInteger := intSeqCon
    Else
      ParamByName('DOCUME').AsString := strDocume + '%';
    If dtaDtaCad <> 0 Then
      ParamByName('DTACAD').AsDate := dtaDtaCad;
    Open;

    If Not IsEmpty Then
      Result := True;

  End;
End;

