function fRetornaQuantidadeJaDevolvida(strIncDev, strDocDev, strEspDev: String):Double;
Var
  qryAux : TUniQuery;
begin
  qryAux := fCriaQuery();

  Try
    qryAux.SQL.Add('  SELECT                                          ');
    qryAux.SQL.Add('    SUM(IF(DET_CLAFIS > "5000", DET_QTDITE * - 1, DET_QTDITE)) QTDITE ');
    qryAux.SQL.Add('  FROM                                            ');
    qryAux.SQL.Add('    MOVDET MD INNER JOIN                          ');
    qryAux.SQL.Add('    MOVTRI MT ON (MD.AUTOINCREM = MT.DET_SEQGER)  ');
    qryAux.SQL.Add('  WHERE                                           ');
    qryAux.SQL.Add('    MD.DET_DOCDEV =:DOCDEV AND                    ');
    qryAux.SQL.Add('    MD.DET_ESPDEV =:ESPDEV AND                    ');
    qryAux.SQL.Add('    MT.DET_INCDEV =:INCDEV AND                    ');
    qryAux.SQL.Add('    MD.DET_PROEMB <> "S"                          ');

    qryAux.ParamByName('DOCDEV').AsString := strDocDev;
    qryAux.ParamByName('ESPDEV').AsString := strEspDev;
    qryAux.ParamByName('INCDEV').AsString := strIncDev;

    qryAux.Open;

    Result := qryAux.FieldByName('QTDITE').AsFloat;
  Finally
    FreeAndNil(qryAux);
  End;
end;

