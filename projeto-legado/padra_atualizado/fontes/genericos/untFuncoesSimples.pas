function fPreInv(strAlias : String = ''; strAliasImpFed : String = ''; strPreInv: String = ''; blnIfNull: Boolean = True; blnRound: Boolean = True) : String;
  Var
    strValCfg : String;
    strAliasInt: string;
Begin
  If fEmptyStr(strPreInv) Then
    strValCfg := Trim(fCfgSis('PREINV'))
  Else
    strValCfg := strPreInv;

  If fEmptyStr(strAliasImpFed) Then
    strAliasImpFed := strAlias;

  If Pos(strValCfg , CAMPOS_INV) <= 0 Then
  Begin
    result := '';
    fMensagem('', 'Configure o campo que será utilizado para o cálculo do inventário.', ['&Ok']);
    Exit;

  End;

  strAliasInt := IIF(fEmptyStr(strAlias),'',strAlias + '.' );
  If strValCfg = 'PRELIQ' Then
  Begin
    If blnRound Then
      Result := 'ROUND(' + strAliasInt + 'ITE_PRECOM * (1 - ' + strAliasInt + 'ITE_DESF01 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF02 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF03 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF04 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF05 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF06 / 100), 2)'
    Else
      Result := '(' + strAliasInt + 'ITE_PRECOM * (1 - ' + strAliasInt + 'ITE_DESF01 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF02 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF03 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF04 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF05 / 100) * ' +
                     '(1 - ' + strAliasInt + 'ITE_DESF06 / 100))';
  End
  Else If strValCfg = 'IMPULT' Then
  Begin
    If blnIfNull Then
      Result := 'IFNULL(' + strAliasInt + 'ITE_' + strValCfg + ',0)'
    Else
      Result :=  strAliasInt + 'ITE_' + strValCfg;
  End
  Else if Length(strValCfg) = 3 Then
  Begin
    If blnIfNull Then
      Result := 'IFNULL(' + strAliasInt + 'ITE_PRE' + strValCfg + ',0)'
    Else
      Result :=  strAliasInt + 'ITE_PRE' + strValCfg ;
  End
  Else
  Begin
    if blnRound then
      Result := 'ROUND( IFNULL(' + strAliasInt + 'ITE_PREULT,0) - (IFNULL(' + strAliasInt + 'ITE_PREULT,0) * IFNULL(' + IIF(fEmptyStr(strAliasImpFed),'',strAliasImpFed + '.' ) + 'ITE_IMPFED,0) / 100), 2)'
    Else
      Result := '( IFNULL(' + strAliasInt + 'ITE_PREULT,0) - (IFNULL(' + strAliasInt + 'ITE_PREULT,0) * IFNULL(' + IIF(fEmptyStr(strAliasImpFed),'',strAliasImpFed + '.' ) + 'ITE_IMPFED,0) / 100))';
  End;
End;

function fGetValorInventario(strNomTab: String): Double;
  Var
    qryGen: TUniQuery;
Begin
  qryGen := fCriaQuery;
  With qryGen, SQL Do
  Begin
    Clear;
    Add('SELECT ');

    Add('  SUM( IF(UNI_ITEFRA = "S", ROUND(A.ITE_SALDOS, ' + fCfgSis('DECQTD') + ') , TRUNCATE(A.ITE_SALDOS, 0)) ');
    Add('       * ROUND(' + fPreInv('A', 'B') + ' / IF((ITE_FATCNV = 0) OR (ITE_FATCNV IS NULL), 1, ITE_FATCNV),  '+  fCfgSis('DECUNI') + ')) AS TOTAL');

//    Add('  SUM(' + fPreInv('A', 'B') + '*A.ITE_SALDOS) AS TOTAL');

    Add('FROM ');
    Add(strNomTab + ' AS A ' );

    Add('INNER JOIN CADUNI   ON A.ITE_CODUNI =   UNI_CODUNI ');
    Add('INNER JOIN ITEGER B ON B.ITE_CODITE = A.ITE_CODITE AND B.ITE_CODEMP = A.ITE_CODEMP ');
    Add('INNER JOIN CADITE G ON G.ITE_CODITE = A.ITE_CODITE ');

    Add('WHERE ');
    Add('  A.ITE_CODEMP = :CODEMP');

    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;
    Result := FieldByName('TOTAL').AsFloat;
  End;
  FreeAndNil(qryGen);
End;

{****************************************************************}
{* VERIFICA SE EXISTE ALGUM ITEM COM O CODIGO DE BARRA          *}
{* PASSADO ESTA CADASTRADO NA TABELA CADSEM (ITENS SEMELHANTES) *}
{*************************************************************LU*}
function fCodBarraJaInclusoTabSem(strCodBar: String; Var strItem: String): Boolean;
Var
  strSQL: String;
  qryGen: TUniQuery;
begin

  Try

    qryGen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '   * ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   CADSEM ';
