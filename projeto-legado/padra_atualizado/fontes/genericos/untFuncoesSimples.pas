Function fCarregaEstruturaIndustrial(qryConsulta: TUniQuery;
                                     cdsConsulta: TUniClientDataSet;
                                     strCodIte,
                                     strCodCor,
                                     strCodFor: String): Boolean;
  Var
    strSQL: String;
Begin
  Try
    strSQL := '';
    strSQL := strSQL + '  SELECT ';
    strSQL := strSQL + '    DEIMAT.AUTOINCREM, ';
    strSQL := strSQL + '    DMT_SEQUEN, ';
    strSQL := strSQL + '    DMT_SEQITE, ';
    strSQL := strSQL + '    DMT_CODEMP, ';
    strSQL := strSQL + '    DMT_ITESUB, ';
    strSQL := strSQL + '    IF(DMT_ITESUB IS NULL, DMT_DESCRI, ITE_DESITE) AS DMT_DESCRI, ';
    strSQL := strSQL + '    ITE_REFERE AS DMT_REFERE, ';
    strSQL := strSQL + '    DMT_QTDITE, ';
    strSQL := strSQL + '    DMT_DESPCA, ';
    strSQL := strSQL + '    DMT_CODFAS, ';
    strSQL := strSQL + '    DMT_PERTOL, ';
    strSQL := strSQL + '    IFNULL(ITE_PRECUS, 0) AS DMT_CUSITE, ';
    strSQL := strSQL + '    (IFNULL(ITE_PRECUS, 0) * DMT_QTDITE) / 100 AS DMT_CUSCAL, ';
    strSQL := strSQL + '    (((IFNULL(ITE_PRECUS, 0) * DMT_QTDITE) / 100) * GMT_PESREA) AS DMT_CUS_LT, ';
    strSQL := strSQL + '    ITE_DENSID AS DMT_DENSID, ';

    strSQL := strSQL + '    ITE_ECARGA, ';
    strSQL := strSQL + '    ITE_PERSOL, ';
    strSQL := strSQL + '    ITE_ABSOLE, ';

    strSQL := strSQL + '    ITE_PREVE1, ';
    strSQL := strSQL + '    ITE_PREVE2, ';
    strSQL := strSQL + '    ITE_PREVE3, ';
    strSQL := strSQL + '    ITE_PREVE4, ';
    strSQL := strSQL + '    ITE_PREVE5, ';
    strSQL := strSQL + '    ITE_PREVE6, ';
    strSQL := strSQL + '    ITE_PREVE7, ';

    strSQL := strSQL + '    G.GMT_OBS001, ';
    strSQL := strSQL + '    G.GMT_OBS002, ';
    strSQL := strSQL + '    G.GMT_OBS003, ';
    strSQL := strSQL + '    G.GMT_OBS004, ';
    strSQL := strSQL + '    G.GMT_OBS005, ';
    strSQL := strSQL + '    G.GMT_OBS006, ';
    strSQL := strSQL + '    G.GMT_OBS007, ';

    strSQL := strSQL + '    G.GMT_DTAFOR, ';

    strSQL := strSQL + '    IFNULL(ITE_PRECUS, 0) AS ITE_PRECUS, ';
    strSQL := strSQL + '    IFNULL(ITE_DENSID, 0) AS ITE_DENSID, ';
    strSQL := strSQL + '    ITE_PREMED, ';
    strSQL := strSQL + '    ITE_DTAULT, ';

    strSQL := strSQL + '    FAS_DESFAS, ';

    strSQL := strSQL + '    DMT_SEQGER,  ';
    strSQL := strSQL + '    DMT_QTDITE AS DMT_REPCUS,  '; //campo calculado. o campo dmt_qtdite é somente para retornar um float.
    strSQL := strSQL + '    GMT_DTACAD,  ';
    strSQL := strSQL + '    GMT_HRACAD,  ';
    strSQL := strSQL + '    GMT_DTAALT,  ';
    strSQL := strSQL + '    GMT_HRAALT,  ';
    strSQL := strSQL + '    GMT_OPEEXT,  ';
    strSQL := strSQL + '    GMT_OBSEXT,  ';
    strSQL := strSQL + '    GMT_HREXIN,  ';
    strSQL := strSQL + '    GMT_HREXFN,  ';
    strSQL := strSQL + '    GMT_ROSCA_,  ';
    strSQL := strSQL + '    GMT_VELPIC,  ';
    strSQL := strSQL + '    G.AUTOINCREM  ';

    strSQL := strSQL + '  FROM ';
    strSQL := strSQL + '    DEIMAT ';
    strSQL := strSQL + '    JOIN GEIMAT G ON DMT_SEQGER = G.AUTOINCREM ';
    strSQL := strSQL + '    LEFT JOIN CADITE ON DMT_ITESUB = CADITE.ITE_CODITE ';
    strSQL := strSQL + '    LEFT JOIN ITEGER I ON DMT_ITESUB = I.ITE_CODITE AND I.ITE_CODEMP = ' + QuotedStr(VS_strCodEmp);
    strSQL := strSQL + '    LEFT JOIN CADFAS   ON FAS_CODFAS =   DMT_CODFAS ';
    strSQL := strSQL + '  WHERE ';
    strSQL := strSQL + '    G.GMT_CODITE = :CODITE AND ';
    strSQL := strSQL + '    G.GMT_CODCOR = :CODCOR AND ';
    strSQL := strSQL + '    G.GMT_FORMUL = :CODFOR ';

    With qryConsulta Do
    Begin
      cdsConsulta.Close;
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODCOR').AsString := strCodCor;
      ParamByName('CODFOR').AsString := strCodFor;

      Open;

      pSetaClient(qryConsulta);

      cdsConsulta.Open;
      pSetaClient(cdsConsulta);

      cdsConsulta.IndexFieldNames := 'DMT_SEQUEN';
    End;

    Result := True;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fCarregaEstrutura]');
    End;
  End;
End;

function fStringSQLLocateToStringSQLIN(strLocate : String; strChrSepara : Char = '_'): String;
  Var
    stlSqlIn : TStringList;
Begin
  if fEmptyStr(strLocate) Then
    Exit;

  if strLocate[length(strLocate)] <> strChrSepara then
    strLocate := strLocate + strChrSepara;

  Try
    stlSqlIn := TStringList.Create;

    While not fEmptyStr(strLocate) Do
    Begin
      stlSqlIn.Add( QuotedStr(Copy( strLocate, 1, Pos(strChrSepara, strLocate)-1)) );

      strLocate := Copy( strLocate, Pos(strChrSepara, strLocate)+1, length(strLocate));

    End;

    Result := fCommaText(stlSqlIn);
  Finally
    FreeAndNil(stlSqlIn);
  End;

End;

function fGetPesLiqOrBruSep(blnGetLiquido,
                            blnQtdOri: Boolean;
                            strNumDoc,
                            strEspDoc,
                            strCodEmp: String;
                            var cdsPesLiqBru : TUniClientDataSet;
                            blnAnalitico     : Boolean = False;
                            blnDocSep        : Boolean = False): Double;

  function fViaLotDor : Boolean;
  begin
    Result := fUsaRotinaWMS And blnDocSep;
  end;

Var
  strSQL    : String;
  fltFatPli : Double;
  qryGen    : TUniQuery;
begin

  Result := 0;

  If (blnAnalitico) And Assigned(cdsPesLiqBru) Then
  Begin

    strSQL := '';
    strSQL := strSQL + ' SELECT D.AUTOINCREM AS AUTINC, ';

    If (fViaLotDor) Then
    Begin

      If (fCfgSis('PESLIQ', varString) = 'FATOR') Then
      Begin
        fltFatPli := fCfgSis('FATPLI', varDouble);
        strSQL    := strSQL + '(((D.FDO_TOTPES / D.FDO_QTDITE) * ' + AnsiReplaceStr(FloatToStr(fltFatPli),',','.') + ') * (L.LDO_QTDITE)) AS PESLIQ, ';
      End Else
        strSQL := strSQL + 'I.ITE_PESLIQ * L.LDO_QTDITE AS PESLIQ, ';

      strSQL := strSQL + '((D.FDO_TOTPES / D.FDO_QTDITE) * (L.LDO_QTDITE)) AS PESBRU ';

    End
    Else
    Begin

      If (fCfgSis('PESLIQ', varString) = 'FATOR') Then
      Begin
        fltFatPli := fCfgSis('FATPLI', varDouble);
        strSQL    := strSQL + IIF(blnQtdOri,
                                  '((D.FDO_TOTPES / D.FDO_QTDITE)  * ' + AnsiReplaceStr(FloatToStr(fltFatPli),',','.') + ')',
                                  '(((D.FDO_TOTPES / D.FDO_QTDITE) * ' + AnsiReplaceStr(FloatToStr(fltFatPli),',','.') + ') * (D.FDO_QTDITE - D.FDO_QTDBAI))') + ' AS PESLIQ, ';
      End Else
        strSQL := strSQL + IIF(blnQtdOri, 'I.ITE_PESLIQ * D.FDO_QTDITE', '(I.ITE_PESLIQ * (D.FDO_QTDITE - D.FDO_QTDBAI))') + ' AS PESLIQ, ';

      strSQL := strSQL + IIF(blnQtdOri, 'D.FDO_TOTPES', '((D.FDO_TOTPES / D.FDO_QTDITE) * (D.FDO_QTDITE - D.FDO_QTDBAI))') + ' AS PESBRU ';

    End;

    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   FATDOR D JOIN EXTDOR E ON (E.FDO_SEQFDO = D.AUTOINCREM) ';
    strSQL := strSQL + '            JOIN CADITE I ON (D.FDO_CODITE = I.ITE_CODITE) ';

    If (fViaLotDor) Then
      strSQL := strSQL + ' INNER JOIN LOTDOR L ON L.LDO_SEQFDO = D.AUTOINCREM ';

    strSQL := strSQL + ' WHERE D.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '       D.FDO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '       D.FDO_CODEMP = :CODEMP ';

  End
  Else
  Begin

    strSQL := '';
    strSQL := strSQL + ' SELECT ';

    If (fViaLotDor) Then
    Begin

      If blnGetLiquido Then
      Begin

        If (fCfgSis('PESLIQ',varString) = 'FATOR') Then
        Begin
          fltFatPli := fCfgSis('FATPLI',varDouble);
          strSQL    := strSQL + ' SUM((((D.FDO_TOTPES / D.FDO_QTDITE) * ' + AnsiReplaceStr(FloatToStr(fltFatPli),',','.') + ') * (L.LDO_QTDITE))) AS PESO ';
        End Else
          strSQL := strSQL + ' SUM((I.ITE_PESLIQ * (L.LDO_QTDITE))) AS PESO ';

      End
      Else
        strSQL := strSQL + ' SUM(((D.FDO_TOTPES / D.FDO_QTDITE) * (L.LDO_QTDITE))) AS PESO ';

    End
    Else
    Begin

      If blnGetLiquido Then
      Begin

        If (fCfgSis('PESLIQ',varString) = 'FATOR') Then
        Begin
          fltFatPli := fCfgSis('FATPLI',varDouble);
          strSQL    := strSQL + ' SUM(' + IIF(blnQtdOri,
                                              '((D.FDO_TOTPES / D.FDO_QTDITE) * ' + AnsiReplaceStr(FloatToStr(fltFatPli),',','.') + ')',
                                              '(((D.FDO_TOTPES / D.FDO_QTDITE) * ' + AnsiReplaceStr(FloatToStr(fltFatPli),',','.') + ') * (D.FDO_QTDITE - D.FDO_QTDBAI))') + ') AS PESO ';
        End
        Else
        Begin
          strSQL := strSQL + ' SUM(' + IIF(blnQtdOri,
                                           'I.ITE_PESLIQ * D.FDO_QTDITE',
                                           '(I.ITE_PESLIQ * (D.FDO_QTDITE - D.FDO_QTDBAI))') + ') AS PESO ';
        End;

      End
      Else
        strSQL := strSQL + ' SUM(' + IIF(blnQtdOri,
                                        'D.FDO_TOTPES',
                                        '((D.FDO_TOTPES / D.FDO_QTDITE) * (D.FDO_QTDITE - D.FDO_QTDBAI))') + ') AS PESO ';

    End;

    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   FATDOR D JOIN EXTDOR E ON (E.FDO_SEQFDO = D.AUTOINCREM) ';
    strSQL := strSQL + '            JOIN CADITE I ON (D.FDO_CODITE = I.ITE_CODITE) ';

    If (fViaLotDor) Then
      strSQL := strSQL + ' INNER JOIN LOTDOR L ON L.LDO_SEQFDO = D.AUTOINCREM ';

    strSQL := strSQL + ' WHERE D.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '       D.FDO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '       D.FDO_CODEMP = :CODEMP ';

  End;

  Try

    qryGen := fCriaQuery;

    With qryGen Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      If (blnAnalitico) And Assigned(cdsPesLiqBru) Then
      Begin

        If Not IsEmpty Then
        Begin

          First;
          While Not Eof Do
          Begin

            cdsPesLiqBru.Append;
            cdsPesLiqBru.FieldByName('AUTDET').AsString := qryGen.FieldByName('AUTINC').AsString;
            cdsPesLiqBru.FieldByName('PESBRU').AsFloat  := qryGen.FieldByName('PESBRU').AsFloat;
            cdsPesLiqBru.FieldByName('PESLIQ').AsFloat  := qryGen.FieldByName('PESLIQ').AsFloat;
            cdsPesLiqBru.Post;

            Next;

          End;

        End;

      End
      Else
      Begin
        If Not IsEmpty Then
          Result := FieldByName('PESO').AsFloat;
      End;

    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[fGetPesLiqOrBruSep]');
  End;

  FreeAndNil(qryGen);

end;

