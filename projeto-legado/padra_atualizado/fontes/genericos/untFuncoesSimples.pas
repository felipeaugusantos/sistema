function fRetornaClaFisDocumentoDevolucao(strNumDoc, strEspDoc, strCodEmp, strAutInc: String):String;
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery();

  Try
    qryAux.SQL.Add('  SELECT                              ');
    qryAux.SQL.Add('    G.GER_CLAFIS                      ');
    qryAux.SQL.Add('  FROM                                ');
    qryAux.SQL.Add('    MOVDET D                          ');
    qryAux.SQL.Add('    LEFT JOIN MOVGER G                ');
    qryAux.SQL.Add('      ON D.DET_SEQGER = G.AUTOINCREM  ');
    qryAux.SQL.Add('  WHERE D.DET_NUMDOC = :NUMDOC        ');
    qryAux.SQL.Add('    AND D.DET_ESPDOC = :ESPDOC        ');
    qryAux.SQL.Add('    AND D.DET_CODEMP = :CODEMP        ');
    qryAux.SQL.Add('    AND D.AUTOINCREM = :AUTINC        ');
    qryAux.SQL.Add('  UNION ALL                           ');
    qryAux.SQL.Add('  SELECT                              ');
    qryAux.SQL.Add('    G.GER_CLAFIS                      ');
    qryAux.SQL.Add('  FROM                                ');
    qryAux.SQL.Add('    NOTDET D                          ');
    qryAux.SQL.Add('    LEFT JOIN NOTGER G                ');
    qryAux.SQL.Add('      ON D.DET_SEQGER = G.AUTOINCREM  ');
    qryAux.SQL.Add('  WHERE D.DET_NUMDOC = :NUMDOC        ');
    qryAux.SQL.Add('    AND D.DET_ESPDOC = :ESPDOC        ');
    qryAux.SQL.Add('    AND D.DET_CODEMP = :CODEMP        ');
    qryAux.SQL.Add('    AND D.AUTOINCREM = :AUTINC        ');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('AUTINC').AsString := strAutInc;

    qryAux.Open;

    Result := qryAux.FieldByName('GER_CLAFIS').AsString;
  Finally
    FreeAndNil(qryAux);
  End;
end;

