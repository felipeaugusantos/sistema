function fTrimAll(strTexto: String): String;
  Var
    c: Char;
    l: Char;
begin
  l := #0;
  Result := '';

  for c in strTexto do
  begin
    if (c = ' ') and (l = ' ') then
      continue;
    l := c;
    Result := Result + c;
  end;

  Result := Trim(Result);
end;

function fMsgLiberaToMsgOculta(Const strTexto: String; Const blnMarcar: Boolean; opcOculta: TOcultarMensagemLiberacao = omlMsgParaQuemEnvia): String;
  Var
    strTagIni,
    strTagFin: String;
Begin
  Result := strTexto;

  If opcOculta = omlMsgParaQuemEnvia Then
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_ENV;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_ENV;
  End
  Else
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_REC;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_REC;
  End;

  If blnMarcar Then
    Result := strTagIni + Result + strTagFin;
end;

function fTemTagMsgOculta(Const strTexto: String; opcOculta: TOcultarMensagemLiberacao = omlMsgParaQuemEnvia): Boolean;
  Var
    strTagIni,
    strTagFin: String;
Begin
  If opcOculta = omlMsgParaQuemEnvia Then
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_ENV;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_ENV;
  End
  Else
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_REC;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_REC;
  End;

  Result := (Pos(strTagIni, strTexto) > 0) And
            (Pos(strTagFin, strTexto) > 0);
end;

function fTagMsgOcultaToMsgCoringa(Const strTexto: String; opcOculta: TOcultarMensagemLiberacao = omlMsgParaQuemEnvia): String;
  Var
    strTroca_,
    strTagIni,
    strTagFin: String;
Begin
  Result := strTexto;

  If opcOculta = omlMsgParaQuemEnvia Then
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_ENV;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_ENV;
  End
  Else
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_REC;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_REC;
  End;

  If fTemTagMsgOculta(Result, opcOculta) Then
  Begin
    While Pos(strTagIni, Result) > 1 Do
    Begin
      strTroca_ := Copy(Result, Pos(strTagIni, Result), Pos(strTagFin, Result) - Pos(strTagIni, Result) + Length(strTagIni));
      Result := AnsiReplaceStr(Result, strTroca_, '  ' + StringOfChar('*', Length(strTroca_)-(fTamanhoTagOculta(opcOculta))) + '  ');
    End;
  End;
end;

function fLimpaTagMsgOculta(Const strTexto: String; opcOculta: TOcultarMensagemLiberacao = omlMsgParaQuemEnvia): String;
  Var
    strTagIni,
    strTagFin: String;
Begin
  Result := strTexto;

  If opcOculta = omlMsgParaQuemEnvia Then
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_ENV;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_ENV;
  End
  Else
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_REC;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_REC;
  End;

  If fTemTagMsgOculta(strTexto, opcOculta) Then
  Begin
    Result := AnsiReplaceStr(Result, strTagIni, '  ');
    Result := AnsiReplaceStr(Result, strTagFin, '  ');
  End;
end;

function fTamanhoMaisTamanhoTagOculta(intTamAtu: Integer; blnMarcar: Boolean; opcOculta: TOcultarMensagemLiberacao = omlMsgParaQuemEnvia): Integer;
begin
  Result := intTamAtu + IIF(blnMarcar, fTamanhoTagOculta(opcOculta), 0);
