function fCaixaOperadorPertenceEmpresaLogada(Const strCodOpe: String; blnMostraMsg:Boolean = True):Boolean;
var
  qryAux: TUniQuery;
  strMsg: String;
begin
  Result := False;
  qryAux := fCriaQuery();

  Try
    qryAux.SQL.Add('  SELECT                                ');
    qryAux.SQL.Add('    CC.CAX_CODEMP,                      ');
    qryAux.SQL.Add('    CO.OPE_CODCAX                       ');
    qryAux.SQL.Add('  FROM                                  ');
    qryAux.SQL.Add('    CADOPE CO                           ');
    qryAux.SQL.Add('    LEFT JOIN CADCAX CC                 ');
    qryAux.SQL.Add('      ON CC.CAX_CODCAX = CO.OPE_CODCAX  ');
    qryAux.SQL.Add('  WHERE CO.OPE_CODOPE =:CODOPE          ');

    qryAux.ParamByName('CODOPE').AsString := strCodOpe;
    qryAux.Open;

    If (Not qryAux.IsEmpty) Then
      Result := (qryAux.FieldByName('CAX_CODEMP').AsString = VS_strCodEmp);

    If (blnMostraMsg) And (Not Result) then
    Begin
      If (fEmptyStr(qryAux.FieldByName('OPE_CODCAX').AsString)) Then
      Begin
        strMsg := 'Não existe código de caixa cadastrado para o operador (' + strCodOpe + ').' + #10+#13+
                  'Por favor, verifique o cadastro do operador antes de faturar o pedido.';
      End
      Else
      Begin
        strMsg := 'Codigo do caixa (' + qryAux.FieldByName('OPE_CODCAX').AsString + ') do operador (' + strCodOpe + ') ' +
                  'não pertence a empresa logada (' + VS_strCodEmp + ').' + #10+#13+
                  'Por favor, verifique o cadastro do operador antes de faturar o pedido.';
      End;

      fMensagem('Aviso!', strMsg, ['&Ok']);
    End;

  Finally
    FreeAndNil(qryAux);
  End;
end;

