  Finally
    FreeAndNil(qryCadFis);
  End;
End;

procedure pValidarProximoCodigo(Var intCodigoAtual : Int64; const intTamCodigo : Integer; const blnCodPorEmpresa : Boolean; const intQtdCod : Integer; const strCampoBusca, strTabelaBusca : String; const objConnection : TUniConnection; const objFncFmt : TFcnFormataProCod);
  Var
    dtaHraExc : TDateTime;
begin
  If fEmptyStr(strCampoBusca) Then
    Exit;
  If fEmptyStr(strTabelaBusca) Then
    Exit;
  If fCfgSis('VLPRXC', varString) = 'N' Then
    Exit;
  If Not fExisteRegistroProcod(objConnection, strCampoBusca, strTabelaBusca, intCodigoAtual, blnCodPorEmpresa, intTamCodigo, intQtdCod, objFncFmt) Then
    Exit;
  dtaHraExc := Now();
  While True Do
  Begin
    If (SecondsBetween(Now(), dtaHraExc) >= 20) Then
      Exit
    Else
      pNotificaFormGravandoAtivo('O próximo código disponível está demorando mais do que o esperado. Aguarde mais um instante.');
    If (intQtdCod = 1) Then
      intCodigoAtual := intCodigoAtual + 1
    Else
      intCodigoAtual := (intCodigoAtual + intQtdCod) + 1;
    If Not fExisteRegistroProcod(objConnection, strCampoBusca, strTabelaBusca, intCodigoAtual, blnCodPorEmpresa, intTamCodigo, intQtdCod, objFncFmt) Then
      Exit;
    Sleep(100);
  End;
end;

function fImagemParaBase64(const ACaminhoImagem: string): string;
var
  LStreamArquivo: TFileStream;
  LStreamString: TStringStream;
begin
  Result := '';

  if not FileExists(ACaminhoImagem) then
    Exit;

  LStreamArquivo := nil;
  LStreamString := nil;
  try
    LStreamArquivo := TFileStream.Create(ACaminhoImagem, fmOpenRead or fmShareDenyWrite);
    LStreamString := TStringStream.Create;

    TNetEncoding.Base64.Encode(LStreamArquivo, LStreamString);
    Result := LStreamString.DataString;
    Result := Result.Replace(#13, '').Replace(#10, '');
  finally
    if Assigned(LStreamString) then
      FreeAndNil(LStreamString);
    if Assigned(LStreamArquivo) then
      FreeAndNil(LStreamArquivo);
  end;
end;

function fGerarHashEntrega(const AChaveNFe: string; const ACaminhoImagem: string): string;
var
  LChaveLimpa: string;
  LImagemBase64: string;
  LTextoConcatenado: string;
  LBytesSha1: TBytes;
begin
  Result := '';

  LChaveLimpa := StringReplace(aChaveNFe, ' ', '', [rfReplaceAll]);

  if LChaveLimpa.Length <> 44 then
    Exit;

  LImagemBase64 := fImagemParaBase64(aCaminhoImagem);

  LTextoConcatenado := LChaveLimpa + LImagemBase64;

  LBytesSha1 := THashSHA1.GetHashBytes(LTextoConcatenado);

  Result := TNetEncoding.Base64.EncodeBytesToString(LBytesSha1);

  Result := Result.Replace(#13, '').Replace(#10, '');
end;

