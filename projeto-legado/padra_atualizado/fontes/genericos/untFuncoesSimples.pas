  strSQL := strSQL + '   JOIN CADOPE      ON CADOPE.OPE_CODOPE = G.GAG_CODVEN ';
  If fCfgSis('GARMAT', varBoolean) Then
    strSQL := strSQL + '               LEFT  JOIN SEQGAR S2 ON S2.SEQ_MOVGAD = D.AUTOINCREM ';

  If blnMostrarCidadeCliente Then
  Begin
    strSQL := strSQL + '   LEFT JOIN CADCID ON CID_CODCID = C.CLI_CODCID     ';
  End;

  strSQL := strSQL + 'WHERE ';

  If fCfgSis('GARMAT', varBoolean) Then
  Begin
    strSQL := strSQL + '  (((IFNULL(S2.SEQ_PCMDET,"") = "") AND (GAG_CODEMP = :CODEMP)) ';
    strSQL := strSQL + '   OR ';
    strSQL := strSQL + '   ((SELECT FDO_CODEMP FROM FATDOR WHERE AUTOINCREM = S2.SEQ_FATDOR) = :CODEMP)) AND ';
  End
  Else
    strSQL := strSQL + '  GAG_CODEMP = :CODEMP       AND ';

  If fCfgSis('REFENT', varBoolean) Then
    strSQL := strSQL + ' IFNULL(GAD_MOTBAI, "") <> "Emissão de Perda/Transferência de Produtos Refugados" AND ';

  strSQL := strSQL + '  GAD_CODITE = :CODITE           ';
  strSQL := strSQL + 'GROUP BY                         ';
  strSQL := strSQL + '  GAG_NUMENT,                    ';
  strSQL := strSQL + '  GAG_CODEMP                     ';

  If fCfgSis('OPREST', varBoolean) Then
  Begin
    strSQL := strSQL + ' UNION ALL ';

    strSQL := strSQL + ' SELECT PRO_CODPRO,                                    ';
    strSQL := strSQL + '        PRO_CODEMP,                                    ';
    strSQL := strSQL + '        NULL,                                          ';
    strSQL := strSQL + '        NULL,                                          ';
    strSQL := strSQL + '        PRO_DTACAD,                                    ';
    strSQL := strSQL + '        NULL AS FGO_PREVIS,                            ';
    strSQL := strSQL + '        NULL,                                          ';
    strSQL := strSQL + '        NULL,                                          ';
    strSQL := strSQL + '        NULL,                                          ';
    strSQL := strSQL + '        NULL,                                          ';
    strSQL := strSQL + '        PRO_CODCLI,                                    ';
    strSQL := strSQL + '        CLI_NOMCLI,                                    ';
    strSQL := strSQL + '        0 AS FDO_QTDPED,                               ';
    strSQL := strSQL + '        0 AS FDO_QTDGAR,                               ';
    strSQL := strSQL + '        0 AS FDO_QTPD_F, ';
    strSQL := strSQL + '        0 AS FDO_QTDEND, ';
    strSQL := strSQL + '        ((IFNULL(PRO_QTDAPR, 0) - IFNULL(PRO_QTDPRO, 0)) * IFNULL(DOP_QTDITE - IFNULL(DOP_QTDBAI, 0), 0)) AS FDO_QTDORP,      ';
    strSQL := strSQL + '        "N",                                           ';
    strSQL := strSQL + '        "OP",                                          ';
    strSQL := strSQL + '        "DETPRO",                                      ';
    strSQL := strSQL + '        NULL AS OPRFLJ,                                ';
    strSQL := strSQL + '        NULL AS EMPPRD,                                ';
    strSQL := strSQL + '        CAST("" AS CHAR(50)) AS FGO_DOCEND, ';
    strSQL := strSQL + '        0    AS FDO_UNITAR,                            ';

    If blnMostrarRequisicao Then
    Begin
     strSQL := strSQL + '       NULL AS CODREQ, ';
    End;

    strSQL := strSQL + '        "" AS FGO_ORDIND,                              ';
    strSQL := strSQL + '        "" AS SEPIMP,                                  ';
	  strSQL := strSQL + '        "" AS NUMLOT                                   ';

    If blnMostrarCidadeCliente Then
    Begin
      strSQL := strSQL + ',   CID_NOMCID,                                      ';
      strSQL := strSQL + '    CID_ESTADO                                       ';
    End;
    strSQL := strSQL + '  ,0.00 AS DEVPEN ';
    strSQL := strSQL + ' FROM DETPRO                                           ';
    strSQL := strSQL + '   INNER JOIN MOVPRO ON MOVPRO.AUTOINCREM = DOP_SEQGER ';
    strSQL := strSQL + '   INNER JOIN CADCLI ON CLI_CODCLI = PRO_CODCLI        ';

    If blnMostrarCidadeCliente Then
    Begin
      strSQL := strSQL + '  LEFT JOIN CADCID ON CID_CODCID = CLI_CODCID        ';
    End;

    strSQL := strSQL + ' WHERE PRO_DTABAI IS NULL                              ';
    strSQL := strSQL + '   AND DOP_ITESUB = :CODITE                            ';
    strSQL := strSQL + '   AND PRO_CODEMP = :CODEMP                            ';
    strSQL := strSQL + ' GROUP BY PRO_CODPRO, PRO_CODEMP                       ';

  End;

  Result := strSQL;
end; {fGetSQLSaldoRes}

