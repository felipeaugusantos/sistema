    strTagFin := STRING_MENSAGEM_OCULTA_FIM_ENV;
  End
  Else
  Begin
    strTagIni := STRING_MENSAGEM_OCULTA_INI_REC;
    strTagFin := STRING_MENSAGEM_OCULTA_FIM_REC;
