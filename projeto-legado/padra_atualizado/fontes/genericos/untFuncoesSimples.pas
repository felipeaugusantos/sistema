procedure pVerificaQtdEmbalagemFechadaItem(strCodIte: String);
var
  strSQL     : String;
  qryIteEmb  : TUniQuery;
  arrMensagem: TStringArray;
  strTABPRC: String;
  intIndex: Integer;
  stlTexto: TStringList;
begin
  strSQL := '';
  strSQL := strSQL + '  SELECT SQL_NO_CACHE         ';
  strSQL := strSQL + '    ITB_CODITE,               ';
  strSQL := strSQL + '    ITB_CODEMP,               ';
  strSQL := strSQL + '    ITB_QTDEMB,               ';
  strSQL := strSQL + '    ITB_DESCON,               ';
  strSQL := strSQL + '    IFNULL(ITB_TABPRE, "TODAS") AS ITB_TABPRE, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN1, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN2, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN3, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN4, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN5, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN6, ';
  strSQL := strSQL + '    CAST("0" AS DECIMAL(12,4)) AS ITB_PRCUN7, ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE1, 0) AS ITE_PREVE1,  ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE2, 0) AS ITE_PREVE2,  ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE3, 0) AS ITE_PREVE3,  ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE4, 0) AS ITE_PREVE4,  ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE5, 0) AS ITE_PREVE5,  ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE6, 0) AS ITE_PREVE6,  ';
  strSQL := strSQL + '    COALESCE(G.ITE_PREVE7, 0) AS ITE_PREVE7   ';
  strSQL := strSQL + '  FROM                        ';
  strSQL := strSQL + '    ITEEMB                    ';
  strSQL := strSQL + '    INNER JOIN ITEGER G ON G.ITE_CODEMP = ITB_CODEMP AND G.ITE_CODITE = ITB_CODITE  ';
  strSQL := strSQL + '  WHERE ITB_CODITE = :CODITE  ';
  strSQL := strSQL + '    AND ITB_CODEMP = :CODEMP  ';
  strSQL := strSQL + '  ORDER BY ITB_QTDEMB DESC    ';

  SetLength(arrMensagem, 0);

  stlTexto := TStringList.Create;

  Try
    qryIteEmb := fCriaQuery;
    qryIteEmb.UniDirectional := False;
    qryIteEmb.CLose;
    qryIteEmb.SQL.Clear;
    qryIteEmb.SQL.Add(strSQL);
    qryIteEmb.ParamByName('CODITE').AsString := strCodIte;
    qryIteEmb.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryIteEmb.Open;
    pCalculaValorUnitarioGridDescontoEmbalagem(qryIteEmb);

    strTABPRC := fCfgSis('TABPRC', VarString);

    stlTexto.Add('---------------------------------');
    stlTexto.Add(' Quantidade    Desconto    Tabela');
    stlTexto.Add('                                 ');
    stlTexto.Add('---------------------------------');

    For intIndex := 1 To 7 Do
    Begin
      If (strTABPRC[intIndex] = 'S') Then
      Begin
        stlTexto[0] := stlTexto[0] + '-------------';
        stlTexto[1] := stlTexto[1] + '    Vlr.Unit.';
        stlTexto[2] := stlTexto[2] + '      Tab.' + IntToStr(intIndex) + '  ';
        stlTexto[3] := stlTexto[3] + '-------------';
      End;
    End;

    pAddDados(arrMensagem, stlTexto[0]);
    pAddDados(arrMensagem, stlTexto[1]);
    pAddDados(arrMensagem, stlTexto[2]);
    pAddDados(arrMensagem, stlTexto[3]);

    qryIteEmb.First;
    While Not qryIteEmb.Eof Do
    Begin
      pAddDados(arrMensagem,
                fPadL(FormatFloat( '#,####0.0000', qryIteEmb.FieldByName('ITB_QTDEMB').AsFloat)     , 10, ' ') + '    ' +
                fPadL(FormatFloat( '#,####0.0000', qryIteEmb.FieldByName('ITB_DESCON').AsFloat)+ '%', 8, ' ')  + '    ' +
                fPadL(qryIteEmb.FieldByName('ITB_TABPRE').AsString,                                   6, ' ')  +
                IIF((strTABPRC[1] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN1').AsFloat), 9, ' '), '') +
                IIF((strTABPRC[2] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN2').AsFloat), 9, ' '), '') +
                IIF((strTABPRC[3] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN3').AsFloat), 9, ' '), '') +
                IIF((strTABPRC[4] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN4').AsFloat), 9, ' '), '') +
                IIF((strTABPRC[5] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN5').AsFloat), 9, ' '), '') +
                IIF((strTABPRC[6] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN6').AsFloat), 9, ' '), '') +
                IIF((strTABPRC[7] = 'S'), '    ' + fPadL(FormatFloat('#,####0.0000', qryIteEmb.FieldByName('ITB_PRCUN7').AsFloat), 9, ' '), ''));

      qryIteEmb.Next;
    End;

    qryIteEmb.Close;

    If Length(arrMensagem) > 4 Then
      fMensagemTabela('AVISO',
                      'Produto possui desconto para embalagem fechada.',
                      arrMensagem,
                      '',
                      ['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 400, 700, True);
  Finally
    FreeAndNil(qryIteEmb);
    FreeAndNil(stlTexto);
  End;
end;

