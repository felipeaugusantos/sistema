function fRetNomFunc(strCodFun: String; arrCodEmp: TConsultasArray = nil; strAutIncrem: String = ''): String;
  Var
    strSQL    : String;
    qryGenFun : TUniQuery;
    intIndice : Integer;
begin
  Try

    qryGenFun := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  FUN_NOMFUN NOMFUN ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADFUN ';
    strSQL := strSQL + 'WHERE ';
    if strAutIncrem <> '' then
      strSQL := strSQL + '  AUTINCREM  = :CODFUN '
    else
      strSQL := strSQL + '  FUN_CODFUN = :CODFUN ';

    if assigned(arrCodEmp) and (strAutIncrem = '') then
    begin
      strSQL := strSQL + ' AND FUN_CODEMP IN (';
      for intIndice := low(arrCodEmp) to high(arrCodEmp) do
      begin
         strSQL := strSQL + iif(intindice = low(arrCodEmp),'',',') + arrCodEmp[intIndice].strCodigo;
      end;
      strSQL := strSQL + '  )';
    end;

    qryGenFun.Close;
    qryGenFun.SQL.Clear;
    qryGenFun.SQL.Add(strSQL);
    qryGenFun.ParamByName('CODFUN').AsString := iif(strAutIncrem='',strCodFun,strAutIncrem);
    qryGenFun.Open;
    if qryGenFun.recordcount > 1 then
      Result := '+1'
    else
      Result := qryGenFun.FieldByName('NOMFUN').AsString;
    qryGenFun.Close;

  Finally
    FreeAndNil(qryGenFun);
  End;

end;

