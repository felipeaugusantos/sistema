function fHaDevolucaoDesteDocumento(strNumDoc, strEspDoc, strCodEmp, strCliFor: String; strCodIte: String = '';
                                    strAcao: String = 'CANCELADO'; strTip_FC: String = 'C';
                                    strCmp_FC: String = 'CODCLI'; strTabela: String = 'MOVDET';
                                    blnMostraMsg: Boolean = True): Boolean;
  Var
    strDoc: String;
    qryAux: TUniQuery;
begin
  Result := False;
  
  qryAux := fCriaQuery;
  strDoc := '';
  Try
    With qryAux Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT                     ');
      SQL.Add('  DET_NUMDOC,              ');
      SQL.Add('  DET_ESPDOC,              ');
      SQL.Add('  DET_CODEMP               ');
      SQL.Add('FROM                       ');
      SQL.Add(    strTabela    );
      SQL.Add('WHERE                      ');
      SQL.Add('  DET_DOCDEV = :NUMDOC AND ');
      SQL.Add('  DET_ESPDEV = :ESPDOC AND ');
      SQL.Add('  DET_EMPDEV = :CODEMP AND ');
      SQL.Add('  DET_' + strCmp_FC + ' = :CLIFOR AND ');
      SQL.Add('  DET_TIP_FC = :TIP_FC     ');

      If Not fEmptyStr(strCodIte) Then
      Begin
        SQL.Add(' AND DET_CODITE = :CODITE ');
        ParamByName('CODITE').AsString := strCodIte;
      End;

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CLIFOR').AsString := strCliFor;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('TIP_FC').AsString := strTip_FC;
      Open;
      First; 

      If Not IsEmpty Then
      Begin
        while Not Eof Do
        Begin
          pIncrementaListaStr(FieldByName('DET_NUMDOC').AsString + '-' +
                              FieldByName('DET_ESPDOC').AsString + '-' +
                              FieldByName('DET_CODEMP').AsString, strDoc);
          Next;
        end;
      End;

      Close;
    End;
  Finally
    If Not strDoc.IsEmpty Then
    Begin
      Result := True;
      If blnMostraMsg Then
        fMensagem('Atenção!', 'Este documento não pode ser '+strAcao+' pois existem as seguintes devoluções:'+#10#13+strDoc,['&OK']);
    End;
    FreeAndNil(qryAux);
  End;
End;

