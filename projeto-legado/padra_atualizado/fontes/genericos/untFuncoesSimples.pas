procedure pIncluirNaMatrizDePedidos(Var arrPedidos: TarrPedVenda; strNumPed, strEspPed, strEmpPed: String; blnEntpCD: Boolean; strLisSeqIndDup: String=''); Overload;
  Var
   intIndice: Integer;
   blnInclui: Boolean;
Begin
  blnInclui := True;

  For intIndice := Low(arrPedidos) To High(arrPedidos) Do
  Begin
    If (arrPedidos[intIndice].strNumPed = strNumPed) And
       (arrPedidos[intIndice].strEspPed = strEspPed) And
       (arrPedidos[intIndice].strEmpPed = strEmpPed) And
       (arrPedidos[intIndice].blnEntpCD = blnEntpCD) Then
    Begin
      blnInclui := False;
      Break
    End;
  End;

  If (blnInclui) Then
  Begin
    SetLength(arrPedidos, Length(arrPedidos)+1);
    arrPedidos[Length(arrPedidos)-1].strNumPed := strNumPed;
    arrPedidos[Length(arrPedidos)-1].strEspPed := strEspPed;
    arrPedidos[Length(arrPedidos)-1].strEmpPed := strEmpPed;
    arrPedidos[Length(arrPedidos)-1].blnEntpCD := blnEntpCD;
    arrPedidos[Length(arrPedidos)-1].strLisSeqIndDup := strLisSeqIndDup;
  End
end;

