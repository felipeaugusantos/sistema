{***********************************************************************}
{* Req. 455181                                                         *}
{* Trata SOMENTE o erro de nome duplicado (EComponentError com          *}
{* "A component named X already exists"). Qualquer outra falha de       *}
{* criacao segue o comportamento historico de pCriarFormularios.        *}
{*                                                                     *}
{* O nome bloqueado vem da propria mensagem de erro, e o componente e   *}
{* localizado por Application.FindComponent - sem heuristica.           *}
{*                                                                     *}
{* So libera o Name quando e comprovadamente seguro:                    *}
{*   - csDestroying no ComponentState: cadaver de um destrutor que      *}
{*     abortou. Se tivesse concluido, o componente nao estaria mais na  *}
{*     lista da Application; e nada nunca remove essa flag.            *}
{*   - ComponentIndex >= o contador capturado antes desta tentativa:    *}
{*     orfao criado nesta propria chamada.                             *}
{* Uma tela legitimamente aberta da mesma classe (entrada e pre-nota    *}
{* simultaneas) nao satisfaz nenhum dos dois e NAO e tocada - o Name    *}
{* dela e gravado em GNRE, frete de conhecimento e log.                 *}
{*                                                                     *}
{* Nunca chama Free: o objeto esta meio-construido ou meio-destruido,   *}
{* e redestrui-lo geraria Access Violation.                             *}
{***********************************************************************}
function fLiberaNomeComponenteDuplicado(const AstrMensagemErro: String; AintCntAnterior: Integer;
  var AstrNomeLiberado: String): Boolean;
  Var
    intIni: Integer;
    intFim: Integer;
    strNome: String;
    objDuplicado: TComponent;
Begin
  Result           := False;
  AstrNomeLiberado := '';

  Try
    If Pos('already exists', AstrMensagemErro) = 0 Then
      Exit;

    If Pos('FRMENTDADOSFISCAISRESUMO', UpperCase(AstrMensagemErro)) = 0 Then
      Exit;

    intIni := Pos('named ', AstrMensagemErro);
    intFim := Pos(' already exists', AstrMensagemErro);

    If (intIni = 0) Or (intFim = 0) Or (intFim <= intIni + 6) Then
      Exit;

    strNome := Trim(Copy(AstrMensagemErro, intIni + 6, intFim - (intIni + 6)));

    If fEmptyStr(strNome) Then
      Exit;

    objDuplicado := Application.FindComponent(strNome);

    If Not Assigned(objDuplicado) Then
      Exit;

    If (Not (csDestroying in objDuplicado.ComponentState)) And
       (objDuplicado.ComponentIndex < AintCntAnterior) Then
      Exit;

    objDuplicado.Name := '';
    AstrNomeLiberado  := strNome;
    Result            := True;
  Except
    On E: Exception Do
    Begin
      Result := False;
    End;
  End;
End;

procedure pCriarFormularios(Classe: TComponentClass; Var frmForm; appHandle: THandle = 0);
  Var
    intCont: Integer;
    intCntAnterior: Integer;
    strMsg: String;
    strNomeLiberado: String;
Begin
  strMsg := '';

  For intCont := 0 To 4 Do
  Begin
    intCntAnterior := Application.ComponentCount;

    Try
      If appHandle > 0 Then
        Application.Handle := appHandle;

      Application.CreateForm(Classe, frmForm);
      strMsg := '';
    Except
      On E: EAccessViolation Do
        Raise;

      On E: Exception Do
      begin
        strMsg := E.Message + ' ' + E.ClassName;
      end;
    End;

    If fEmptyStr(strMsg) Then
      Break;

    {* Req. 455181 *}
    If fLiberaNomeComponenteDuplicado(strMsg, intCntAnterior, strNomeLiberado) Then
    Begin
      Try
        pGravarErro(True,
                    '[pCriarFormularios] Req. 455181 - nome ' + strNomeLiberado +
                    ' liberado de componente morto ao criar ' + Classe.ClassName + '.',
                    'Liberacao de nome duplicado para nao inutilizar a sessao.');
      Except
        On E: Exception Do
        Begin
        End;
      End;
    End;

    pProcessMessages(True);
    Sleep(1500);

  End;

  If Not fEmptyStr(strMsg) Then
    Raise Exception.Create('Erro ao criar o formulário.' + #13 + strMsg);

End;

{*********************************************}
