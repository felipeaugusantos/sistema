{*****************************************}
{* VERIFICA DEBITOS DO CLIENTE           *}
{* - CADREC / CADCHQ                     *}
{**************************************MV*}
function fRetDebitoCliente(strCodCli: String): Double;
  Var
    strSQL   : String;
    qryGenTmp: TUniQuery;
    fltTotDeb: Double;
begin
  fltTotDeb := 0.0;

  Try
    {*****************************************}
    {* SE O CLIENTE FOR CONSUMIDOR           *}
    {**************************************WI*}

    If fClienteConsumidor(strCodCli,True, True) Then
    Begin
      Result := 0;
      Exit;
    End;

    qryGenTmp := fCriaQuery;

    {*****************************************}
    {* SE ENTRA PEDIDOS EM ABERTO NO LIMITE  *}
    {***************************************LA}
    If fCfgSis('PDVLIM', varBoolean) Then
      fltTotDeb := fltTotDeb + fRetTotalPedidoVendaAberto(strCodCli, '');

    {*********************************************}
    {* SE ENTRA EMPRÉSTIMOS EM ABERTO NO LIMITE  *}
    {*******************************************BL}
    If fCfgSis('LMCEMP', varBoolean) Then
      fltTotDeb := fltTotDeb + fRetTotalEmprestimosAberto(strCodCli);

    {*****************************************}
    {* DEBITOS (CHEQUE PRE) -> CADCHQ(X)     *}
    {**************************************WI*}
    If fCfgSis('CHQCCO', varBoolean) Then
    Begin

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  * ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADCHQ ';
      strSQL := strSQL + 'INNER JOIN CADCLI ';
      strSQL := strSQL + '  ON CLI_CODCLI = CHQ_CODCLI ';
      strSQL := strSQL + 'WHERE (';
      strSQL := strSQL + '  CLI_CODCLI = :CODCLI ';
      If fCfgSis('TRFTCR', varString) = '2' Then
      Begin
        strSQL := strSQL + '    OR CLI_CODRED =                  ';
        strSQL := strSQL + '    (SELECT                          ';
        strSQL := strSQL + '       CLI_CODRED                    ';
        strSQL := strSQL + '     FROM                            ';
        strSQL := strSQL + '       CADCLI                        ';
        strSQL := strSQL + '     WHERE CLI_CODCLI = :CODCLI)     ';
      End;
      strSQL := strSQL + ' ) AND ((CHQ_DTADEP IS NULL) OR ((CHQ_DTADP2 IS NULL) AND (CHQ_DTADEV IS NOT NULL))) ';
      strSQL := strSQL + ' AND CHQ_INCCTR = "N" ';
      strSQL := strSQL + ' AND IFNULL(CHQ_TELCHE, "N") <> "S" ';

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODCLI').AsString := strCodCli;
        Open;

        While Not Eof Do
        Begin
          fltTotDeb := fltTotDeb + FieldByName('CHQ_VALCHQ').AsFloat;
          Next;
        End;

        Close;
      End;

    End;

    {*****************************************}
    {* DEBITOS (CONTAS A REC.) -> CADREC(X)  *}
    {**************************************WI*}
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADREC ';
    strSQL := strSQL + 'INNER JOIN CADCLI ';
    strSQL := strSQL + '  ON CLI_CODCLI = CTR_CODCLI ';
    strSQL := strSQL + 'WHERE (';
    strSQL := strSQL + '  CLI_CODCLI = :CODCLI ';
    If fCfgSis('TRFTCR', varString) = '2' Then
    Begin
      strSQL := strSQL + '    OR CLI_CODRED =                  ';
      strSQL := strSQL + '    (SELECT                          ';
      strSQL := strSQL + '       CLI_CODRED                    ';
      strSQL := strSQL + '     FROM                            ';
      strSQL := strSQL + '       CADCLI                        ';
      strSQL := strSQL + '     WHERE CLI_CODCLI = :CODCLI)     ';
    End;
    strSQL := strSQL + ' ) AND CTR_DTAREC IS NULL ';

    With qryGenTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      While Not Eof Do
      Begin
        fltTotDeb := fltTotDeb + (FieldByName('CTR_VALDUP').AsFloat + FieldByName('CTR_JURSUJ').AsFloat + FieldByName('CTR_DESCOB').AsFloat - FieldByName('CTR_DESSUJ').AsFloat);
        Next;
      End;

      Close;
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message,'');
  End;

  Result := fltTotDeb;
  FreeAndNil(qryGenTmp);
end;

Function fRetTotalPedidoVendaAberto(strCodCli: String; strPedAlt: String = ''; blnConsultandoDebitoAlpeBoleto: Boolean = False): Double;
Var
  qryGen : TUniQuery;
Begin

  qryGen := fCriaQuery;

  With qryGen, SQL Do
  Begin

    Clear;

    {Total em aberto ((-) Adiantamentos)}
    Add('SELECT (SUM(IFNULL(TOTABE, 0)) - SUM(IFNULL(VALADT, 0))) AS TOTABE FROM ( ');
    Add('SELECT ');
    Add('    SUM( ');
    Add('      (FDO_QTDITE - IFNULL(FDO_QTDBAI, 0)) * ( ');
    Add('        ( ');
    Add('          FDO_TOTITE + IFNULL(FDO_VALIPI, 0) + IFNULL(FDO_VALRET, 0) + IFNULL(FDO_VALFCP, 0) + IFNULL(FDO_TOTFRE, 0) + IFNULL(FDO_DESACE, 0)' + fSqlValorReformaFdoRef('FATDOR.AUTOINCREM') + ' - IFNULL(FDO_DESESP, 0) ');
    Add('        ) / FDO_QTDITE ');
    Add('      ) ');
    Add('    ) AS TOTABE, ');
    Add('    (SELECT ');
    Add('      SUM( ');
    Add('        IF( ');
    Add('          ADT_TIPLAN = "C", ');
    Add('          ADT_VALLAN, ');
    Add('          - ADT_VALLAN ');
    Add('        ) ');
    Add('      ) ');
    Add('    FROM ');
    Add('      ADTCLI ');
    Add('    WHERE ADT_NUMDOC = FDO_NUMDOC ');
    Add('      AND ADT_ESPDOC = FDO_ESPDOC ');
    Add('      AND ADT_CODEMP = FDO_CODEMP) AS VALADT ');
    Add('FROM ');
    Add('  FATDOR ');
    Add('  INNER JOIN EXTDOR ');
    Add('    ON EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM ');
    Add('  INNER JOIN CADCLI ');
    Add('    ON CLI_CODCLI = FDO_CODCLI ');
    Add('WHERE (CLI_CODCLI = :CODCLI ');

    If fCfgSis('TRFTCR', varString) = '2' Then
    Begin
      Add('    OR CLI_CODRED =              ');
      Add('    (SELECT                      ');
      Add('       CLI_CODRED                ');
      Add('     FROM                        ');
      Add('       CADCLI                    ');
      Add('     WHERE CLI_CODCLI = :CODCLI) ');
    End;

    Add('  ) AND FDO_JAFATU = 0 ');
    Add('  AND FDO_ESPDOC = "PD" ');
    Add('  AND IFNULL(FDO_INCFUT, "") = "" '); //NAO DEVE CONSIDERAR PEDIDOS DE BAIXA DE ENTREGA FUTURA

    if fCfgSis('ALPKNK', varBoolean) then
      Add(' AND LOCATE(FDO_CODCND, :CNDBOL) '+IIF(blnConsultandoDebitoAlpeBoleto, '>', '=')+' 0 ');

    If Not fEmptyStr(strPedAlt) Then
      Add(' AND LOCATE(IFNULL(FDO_NUMDOC,""), :NUMDOC) <= 0 ');

    Add('GROUP BY ');
    Add('  FATDOR.FDO_SEQGER) AS TOTAIS ');

    ParamByName('CODCLI').AsString := strCodCli;

    If Not fEmptyStr(strPedAlt) Then
      ParamByName('NUMDOC').AsString := QuotedStr(strPedAlt);

    if fCfgSis('ALPKNK', varBoolean) then
      ParamByName('CNDBOL').AsString := fCfgSis('CNDBOL', varString);

    Open;

    Result := FieldByName('TOTABE').AsFloat;

    Close;

  End;

  FreeAndNil(qryGen);

End;

