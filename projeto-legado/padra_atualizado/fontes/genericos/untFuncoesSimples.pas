function fAdicionarListaEmailInvalido(
  const aRec: TRecEmailInvalidos; stlMensagem: TStringList): Boolean;
var
  strMensagem: String;
begin

  If Not Assigned(stlMensagem) Then
  Begin
    Result := False;
    Exit;
  End;

  Result := fEmailInvalido(aRec.strEmail);

  If Result And (Not fEmptyStr(aRec.strEmail)) Then
  Begin
    strMensagem := strMensagem +  '| ' + fPadC(aRec.strCodCli, 8 + 1) +
                                 ' | ' + fPadC(aRec.strNomCli, 30 + 1) +
                                 ' | ' + fPadC(aRec.strNomCid, 20 + 1) +
                                 ' | ' + fPadC(aRec.strNom_UF, 02 + 1) +
                                 ' | ' + fPadC(aRec.strFone01, 10 + 1) +
                                 ' | ' + fPadC(aRec.strFone02, 10 + 1) +
                                 ' | ' + fPadC(aRec.strEmail , 20 + 1) + ' | ';
    stlMensagem.Add(strMensagem);
  End;
end;

function fEmailInvalido(const strEmail: String): Boolean;
  Var
    strEmailValidacao : String;
    arrEmails : TArray<String>;
    intContador : Integer;
begin
  Result := False;

  strEmailValidacao := StringReplace(strEmail, ',', ';', [rfReplaceAll]);
  If (Pos(';', strEmailValidacao) > 0) Then
  Begin
    If (Pos(';', strEmail) = Length(strEmail)) Then
      Exit(True);

    arrEmails := strEmailValidacao.Split([';']);
    For intContador := 0 To Pred(Length(arrEmails)) Do
      If (Not fEnderecoEmailValido(arrEmails[intContador])) Then
        Exit(True);
  End
  Else
    Result := (Not fEnderecoEmailValido(strEmailValidacao));
end;

