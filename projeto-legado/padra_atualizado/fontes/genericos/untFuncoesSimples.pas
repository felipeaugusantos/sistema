procedure pSalvarXMLNFeBD(AChaveAcesso, AXML: string);
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);

  try
    If Not fTabelaExiste('XMLNFE', True) Then
      Exit;

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT COUNT(*) AS QTDE FROM XMLNFE ');
    qryAux.SQL.Add('WHERE NFE_ACESSO = :ACESSO ');
    qryAux.ParamByName('ACESSO').AsString := AChaveAcesso;
    qryAux.Open();

    if (qryAux.FieldByName('QTDE').AsInteger = 0) then
    begin
      try
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add('INSERT INTO XMLNFE SET NFE_ARQXML = :ARQXML, NFE_ACESSO = :ACESSO ');
        qryAux.ParamByName('ARQXML').AsString := AnsiReplaceStr(AnsiReplaceStr(AXML, #13#10, ' '), #10, ' ');
        qryAux.ParamByName('ACESSO').AsString := AChaveAcesso;
        qryAux.ExecSQL;

      except
        on E: Exception do
        begin
          Raise Exception.Create('Erro ao gravar XML na tabela XMLNFE: ' + E.Message);
        end;
      end;
    end;
  finally
    FreeAndNil(qryAux);
  end;
end;

procedure pSalvarXmlDfeBD(ATipDfe, AChaveAcesso, AProtocolo, AXml: string);
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);

  try
    If Not fTabelaExiste('XMLDFE', True) Then
      Exit;

    If fEmptyStr(AProtocolo) Then
    Begin
      AProtocolo := 'N/D';
    End;

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT COUNT(*) AS QTD FROM XMLDFE ');
    qryAux.SQL.Add('WHERE NFE_TIPDFE = :TIPDFE ');
    qryAux.SQL.Add('  AND NFE_PROTOC = :PROTOC ');
    qryAux.SQL.Add('  AND NFE_ACESSO = :ACESSO ');
    qryAux.ParamByName('TIPDFE').AsString := ATipDfe;
    qryAux.ParamByName('PROTOC').AsString := AProtocolo;
    qryAux.ParamByName('ACESSO').AsString := AChaveAcesso;
    qryAux.Open;

    if qryAux.FieldByName('QTD').AsInteger = 0 then
    begin
      try
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add('INSERT INTO XMLDFE' );
        qryAux.SQL.Add(' SET NFE_TIPDFE = :TIPDFE, ');
        qryAux.SQL.Add('     NFE_PROTOC = :PROTOC, ');
        qryAux.SQL.Add('     NFE_ACESSO = :ACESSO, ');
        qryAux.SQL.Add('     NFE_ARQXML = :ARQXML ');
        qryAux.ParamByName('TIPDFE').AsString := ATipDfe;
        qryAux.ParamByName('PROTOC').AsString := AProtocolo;
        qryAux.ParamByName('ACESSO').AsString := AChaveAcesso;
        qryAux.ParamByName('ARQXML').AsString := AnsiReplaceStr(AnsiReplaceStr(AXML, #13#10, ' '), #10, ' ');
        qryAux.ExecSQL;

      except
        on E: Exception do
        begin
          Raise Exception.Create('Erro ao gravar XML na tabela XMLDFE: ' + E.Message);
        end;
      end;
    end;
  finally
    FreeAndNil(qryAux);
