      Add('  FGO_NUMDOC = :NUMDOC AND');
      Add('  FGO_ESPDOC = :ESPDOC AND');
      Add('  FGO_CODEMP = :EMPDOC AND');
      Add('  FGO_CODCLI = :CLIDOC');
    End
    Else
    Begin
      Add('SELECT SQL_NO_CACHE');
      Add('  AUX_ENTURG AS ENTURG ');
      Add('FROM');
      Add('  MOVGER ');
      Add('  INNER JOIN AUXMOV ON AUX_SEQGER = AUTOINCREM');
      Add('WHERE');
      Add('  GER_NUMDOC = :NUMDOC AND');
      Add('  GER_ESPDOC = :ESPDOC AND');
      Add('  GER_CODEMP = :EMPDOC AND');
      Add('  GER_CODCLI = :CLIDOC');

      Add('UNION ALL ' + AnsiReplaceStr(Text, 'MOV', 'NOT'));
    End;

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('EMPDOC').AsString := strEmpDoc;
    ParamByName('CLIDOC').AsString := strCliDoc;

