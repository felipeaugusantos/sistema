function fBuscaProxDiaUtil(data:TDateTime; strCodEmp: String):TFeriadoFimDeSemana;
Var
  FeriadoOuFDS : TFeriadoFimDeSemana;
  strCodCid : String;

begin
  strCodCid := fCampoTabela('EMP_CODCID', 'CADEMP', ['EMP_CODEMP'], [strCodEmp]);
  FeriadoOuFDS.dtaProximoDiaUtil := data;
  FeriadoOuFDS.blnDAtaEDiaUtil := True;

  if DayOfWeek(FeriadoOuFDS.dtaProximoDiaUtil) = 1 then
  begin
    FeriadoOuFDS.dtaProximoDiaUtil := FeriadoOuFDS.dtaProximoDiaUtil + 1;
    FeriadoOuFDS.blnDAtaEDiaUtil   := False
  end;

  if DayOfWeek(FeriadoOuFDS.dtaProximoDiaUtil) = 7 then
  begin
    FeriadoOuFDS.dtaProximoDiaUtil := FeriadoOuFDS.dtaProximoDiaUtil + 2;
    FeriadoOuFDS.blnDAtaEDiaUtil   := False
  end;

  if fEhFeriado(FeriadoOuFDS.dtaProximoDiaUtil) then
  begin
    FeriadoOuFDS.dtaProximoDiaUtil := FeriadoOuFDS.dtaProximoDiaUtil + 1;
    FeriadoOuFDS.blnDAtaEDiaUtil := False
  end;

  if fEhFeriado(FeriadoOuFDS.dtaProximoDiaUtil, strCodCid) then
  begin
    FeriadoOuFDS.dtaProximoDiaUtil := FeriadoOuFDS.dtaProximoDiaUtil + 1;
    FeriadoOuFDS.blnDAtaEDiaUtil := False
  end;

   result := FeriadoOuFDS;
end;

