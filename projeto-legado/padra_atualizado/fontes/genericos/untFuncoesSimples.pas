{*************************************************************************}
{* REPLICA UMA LISTA DE PROPRIEDADES DE UM CONTROLE ORIGEM PARA UM       *}
{* CONTROLE DESTINO ONDE O NOME DO CONTROLE E SEU TIPO SEJAM IGUAIS AFIM *}
{* DE EVITAR DUPLICAÇÃO DE REGRAS POR EXEMPLO VISIVEL, HABILITADO, ETC   *}
{**********************************************************************VA*}
procedure pReplicaPropriedades(Orig, Dest: TWinControl; strListProp: String='');

    Procedure CopyProp(Sour, Dest: TComponent; strListProp: String='');
    Var
      Count, Size, I: Integer;
      List: PPropList;
      PropInfo: PPropInfo;
      PropValue: Variant;
    Begin
      If fEmptyStr(strListProp) Then
        strListProp := 'Visible_ReadOnly_Enabled_Text_ItemIndex_';

      Count := GetPropList(Sour.ClassInfo, tkAny, Nil);
      Size  := Count * SizeOf(Pointer);
      GetMem(List, Size);
      Try
        Count := GetPropList(Sour.ClassInfo, tkAny, List);
        For I := 0 to Count - 1 do
        Begin
          PropInfo := List^[I];

          If Pos(String(PropInfo^.Name), strListProp) > 0 Then
          Begin
            PropValue := (GetPropValue(Sour, String(PropInfo^.Name)));
            SetPropValue(Dest, String(List^[I].Name), PropValue);
          End;
        End;
      Finally
        FreeMem(List);
      End;
    End;

 Var
   idxCtrlOrig,
   idxCtrlDest: Integer;
begin
  For idxCtrlOrig := 0 To Orig.ControlCount -1 Do
  Begin
    For idxCtrlDest := 0 To Dest.ControlCount -1 Do
    Begin
       If (Orig.Controls[idxCtrlOrig].Name = Dest.Controls[idxCtrlDest].Name) And
          (Orig.Controls[idxCtrlOrig].ClassType = Dest.Controls[idxCtrlDest].ClassType) Then
       Begin
         CopyProp(Orig.Controls[idxCtrlOrig], Dest.Controls[idxCtrlDest], strListProp);
         Break;
       End
    End;
  End;
end;

