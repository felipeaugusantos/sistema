procedure pGeraMatrizLiberacao(strOperador,
                               strCodVen,
                               strMenObs: String;
                               strDirAce: String;
                               strCodLib: String;
                               strCodIte: String = '';
                               intAutInc: Integer = 0;
                               strNumLib: String = '';
                               strInfBlo: String = '';
                               blnIgnInc: Boolean = False;
                               strInfoF4: String = '';
                               horaLib  : TTime = 0;
                               horaCad  : TTime = 0;
                               horaEnv  : TTime = 0 ;
                               strMsgSen : String = '';
                               strTitulo: String = '';
                               strDirAceAuxiliar: String = '');
  Var
    intPosLog,
    intIndex: Integer;
    blnAchouLog: Boolean;
Begin
  blnAchouLog := FALSE;
  intPosLog   := 0;

  (**********************************************************)
  (* PROCURA UM LOG DO MESMO TIPO PARA NAO DUPLICAR OS LOGS *)
  (*******************************************************LA*)
  For intIndex := Low(arrLogLib) To High(arrLogLib) Do
    If SameText(strDirAce,arrLogLib[intIndex].strDirAce) And
       SameText(strCodIte,arrLogLib[intIndex].strCodIte) And
     ((intAutInc = arrLogLib[intIndex].intAutInc) Or blnIgnInc) Then
    Begin
      blnAchouLog := TRUE;
      intPosLog := intIndex;
      break;
    End;

  If Not blnAchouLog Then
  Begin
    SetLength(arrLogLib,Succ(Length(arrLogLib)));
    intPosLog := High(arrLogLib);
  End;

  arrLogLib[intPosLog].strOpeLib := strOperador;
  arrLogLib[intPosLog].strCodVen := strCodVen;
  arrLogLib[intPosLog].dtaDtaCad := VS_Date;
  arrLogLib[intPosLog].dtaHraCad := iif(horaCad = 0, fTime(), horaCad);
  arrLogLib[intPosLog].dtaDtaLib := VS_Date;
  arrLogLib[intPosLog].dtaHraLib := iif(horaLib = 0, fTime(), horaLib);
  arrLogLib[intPosLog].dtaDtaEnv := VS_Date;
  arrLogLib[intPosLog].dtaHraEnv := iif(horaEnv = 0, fTime(), horaEnv);
  arrLogLib[intPosLog].strObserv := fLimpaTagMsgOculta(strMenObs);
  arrLogLib[intPosLog].strDirAce := strDirAce;
  arrLogLib[intPosLog].strDirAceAuxiliar := strDirAceAuxiliar;
  arrLogLib[intPosLog].strCodIte := strCodIte;
  arrLogLib[intPosLog].intAutInc := intAutInc;
  arrLogLib[intPosLog].strNumLib := strNumLib;
  arrLogLib[intPosLog].blnInsLog := False;
  arrLogLib[intPosLog].strInfBlo := fLimpaTagMsgOculta(strInfBlo); // quando crediário armazena a mensagem "real" aqui.
  arrLogLib[intPosLog].blnIgnInc := blnIgnInc;
  arrLogLib[intPosLog].strInfoF4 := strInfoF4;
  arrLogLib[intPosLog].strMsgSen := strMsgSen;
  arrLogLib[intPosLog].strTitulo := strTitulo;
  arrLogLib[intPosLog].strCodLib := strCodLib;
End;

