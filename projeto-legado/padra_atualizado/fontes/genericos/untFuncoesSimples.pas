{ TTourMenuThread }

constructor TTourMenuThread.Create(const ATeclas: TArray<Word>; AIntervalo: Cardinal);
begin
  FPidAlvo     := GetCurrentProcessId;// PID do autcom
  FTeclas      := ATeclas;
  FIntervalo   := AIntervalo;
  FreeOnTerminate := True;
  inherited Create(False);
end;

function TTourMenuThread.fForegroundEhDoAutcom: Boolean;
var
  hwndFg: HWND;
  pidFg: DWORD;
begin
  Result := False;
  hwndFg := GetForegroundWindow;
  if hwndFg = 0 then
    Exit;
  pidFg := 0;
  GetWindowThreadProcessId(hwndFg, @pidFg);
  Result := (pidFg = FPidAlvo);
end;

procedure TTourMenuThread.Execute;
const
  cnsTimeOut = 3000;
  cnsPollChk = 15;
var
  intTempo: Cardinal;
  guiInfo: TGUIThreadInfo;
  blnAbriu: Boolean;
  I: Integer;
begin
  intTempo := 0;
  blnAbriu := False;
  ZeroMemory(@guiInfo, SizeOf(guiInfo));
  guiInfo.cbSize := SizeOf(guiInfo);

  // 1. Poll ate detectar menu aberto
  while intTempo < cnsTimeOut do
  begin
    if Terminated then
      Exit;

    if GetGUIThreadInfo(0, guiInfo) and
       (guiInfo.hwndMenuOwner <> 0) and
       ((guiInfo.flags and GUI_INMENUMODE) <> 0) and
       fForegroundEhDoAutcom then
    begin
      blnAbriu := True;
      Break;
    end;

    Sleep(cnsPollChk);
    Inc(intTempo, cnsPollChk);
  end;

  if not blnAbriu then
    Exit;

  Sleep(30);

  // 2. Loop de teclas
  for I := 0 to High(FTeclas) do
  begin
    if Terminated then
      Exit;

    if not fForegroundEhDoAutcom then
      Exit;

    pKeybd_Event(FTeclas[I]);

    Sleep(FIntervalo);
  end;
end;

