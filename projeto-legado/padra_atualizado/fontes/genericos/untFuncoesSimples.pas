    LQuery.SQL.Add('  GROUP BY LOG_NOMEXE, ');
    LQuery.SQL.Add('    LOG_VERPRO ');
    LQuery.SQL.Add('  ORDER BY QTD DESC ');
    LQuery.SQL.Add('  LIMIT 1) AS T ');
