function fVerificaContRecNFAutorizadaSefaz(strNumDoc, strCodCli, strCodEmp: String): Boolean;
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery();

  Try
    qryAux.SQL.Add('  SELECT FIS_ACESSO ');
    qryAux.SQL.Add('  FROM CADREC R  ');
    qryAux.SQL.Add('  INNER JOIN CADFIS F ON   ');
    qryAux.SQL.Add('  	R.CTR_NUMDUP = F.FIS_NUMDOC AND  ');
    qryAux.SQL.Add('          R.CTR_ESPDOC = F.FIS_ESPDOC AND ');
    qryAux.SQL.Add('          R.CTR_CODEMP = F.FIS_CODEMP AND ');
    qryAux.SQL.Add('          R.CTR_CODCLI = F.FIS_FORCLI AND ');
    qryAux.SQL.Add('          F.FIS_TIP_FC = "C"        AND ');
    qryAux.SQL.Add('          F.FIS_ORIDOC = "V" ');
    qryAux.SQL.Add('  WHERE F.FIS_NUMDOC = :NUMDOC ');
    qryAux.SQL.Add('  AND   R.CTR_CODCLI = :CODCLI ');
    qryAux.SQL.Add('  AND   R.CTR_CODEMP = :CODEMP ');
    qryAux.SQL.Add('  AND   R.CTR_ESPDOC = "NF" ');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;

    qryAux.Open;

    Result := Not fEmptyStr(qryAux.FieldByName('FIS_ACESSO').AsString);

  Finally
    FreeAndNil(qryAux);
  End;
end;

