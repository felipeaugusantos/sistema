{ TNewTimer }

class procedure TNewTimer.Clear;
Var
  LObj: TNewTimer;
begin
  For LObj In FTimersList.Values Do
    LObj.Destroy;
  FTimersList.Clear;
end;

constructor TNewTimer.Create(AId: String);
begin
  FId := AId;
  FInterval := 1000;
  FTimeout := TimeoutNever;
  FTimeoutBegin := fTime(True);
  FEnabled := False;
  FEnabling := False;
  FCheckInTransaction := True;
  FOnTimer := nil;
  FTimer := TTimer.Create(nil);
  FTimer.OnTimer := Self.OnTimerEvent;
  FTimer.Enabled := True;
end;

destructor TNewTimer.Destroy;
begin
  FTimer.Enabled := False;
  FreeAndNil(FTimer);
  inherited;
end;

class function TNewTimer.Get(AId: String): TNewTimer;
begin
  If Not FTimersList.ContainsKey(AId) Then
    FTimersList.Add(AId, TNewTimer.Create(AId));
  Result := FTimersList.Items[AId];
end;

class function TNewTimer.Has(AId: String): Boolean;
begin
  Result := FTimersList.ContainsKey(AId);
end;

function TNewTimer.IsSuspended: Boolean;
Var
  LSuspended: String;
begin
  For LSuspended In TNewTimer.FSuspendedList Do
    If String(Self.FId).ToLower.Contains(LSuspended.ToLower) Then
      Exit(True);
  Result := False;
end;

procedure TNewTimer.SetEnabled(Value: Boolean);
begin
  FEnabled := Value;
  FEnabling := Value;
  FTimeoutBegin := fTime(True);
end;

procedure TNewTimer.SetInterval(Value: Cardinal);
begin
  FInterval := Value;
  If FInterval <> FTimer.Interval Then
    FTimer.Interval := FInterval;
  FTimeoutBegin := fTime(True);
end;

procedure TNewTimer.SetTimeout(Value: Cardinal);
begin
  FTimeout := Value;
  FTimeoutBegin := fTime(True);
end;

procedure TNewTimer.OnTimerEvent(ASender: TObject);
begin
{$IFDEF TIMERLOG}
  try
    if FileExists(VS_ProcessId + '.tmr') then
      TFile.AppendAllText(VS_ProcessId + '.tmr', DateTimeToStr(fNow()) + ' - ' + Self.FId + sLineBreak);
  except
  end;
{$ENDIF}

  If FTimeout <> TimeoutNever Then
    If MilliSecondsBetween(fTime(True), FTimeoutBegin) > FTimeout Then
    Begin
      TNewTimer.Del(FId);
      Exit;
    End;

  If Self.IsSuspended Then
    Exit;

  If Not Self.Enabled Then
    Exit;

  If Not Assigned(Self.OnTimer) Then
    Exit;

  If FCheckInTransaction Then
    If Assigned(frmModulo) Then
      If frmModulo.Database.InTransaction Then
        Exit;

  If Self.FEnabling Then
  Begin
    Self.FEnabling := False;
    Exit;
  End;

  Try
    Self.OnTimer(nil);
  Except
    On E: Exception Do
    Begin
      Self.Enabled := False;
      Raise;
    End;
  End;
end;

class function TNewTimer.Del(AId: string): Boolean;
begin
  If Not FTimersList.ContainsKey(AId) Then
    Exit(False);
  FTimersList[AId].Free;
  FTimersList.Remove(AId);
  Result := True;
end;

{ TTimerTransacao }
constructor TTimerTransacao.Create(AName: String);
begin
  inherited Create(AName);
  Self.FCheckInTransaction := False;
  Self.Interval := VS_TRANSACAO_LIMITE_SEGUNDOS * 1000;
  Self.OnTimer := pOnTimerTransacao;
end;

procedure TTimerTransacao.pOnTimerTransacao(Sender: TObject);
begin
  if TTransactionLog.Instance.GetCount(VS_MainThreadId) > 0 then
    TTransactionLog.Instance.UpdateStack(VS_MainThreadId, fGetNomeFormularios + #13#10 + fRetornaStack);
end;

