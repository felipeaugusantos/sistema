function fObservacaoPedido(stlPedidos: TStrings): String;
Var
   qryPcmGer: TUniQuery;
Begin
  Result := '';
  qryPcmGer := fCriaQuery();
  Try
    qryPcmGer.SQL.Add('SELECT ');
    qryPcmGer.SQL.Add('@OBS1 := IFNULL(PCG_OBSPD1, "") AS OBS1,');
    qryPcmGer.SQL.Add('@OBS2 := IFNULL(PCG_OBSPD2, "") AS OBS2,');
    qryPcmGer.SQL.Add('@OBS3 := IFNULL(PCG_OBSPD3, "") AS OBS3,');
    qryPcmGer.SQL.Add('@OBS4 := IFNULL(PCG_OBSPD4, "") AS OBS4,');
    qryPcmGer.SQL.Add('@OBS5 := IFNULL(PCG_OBSPD5, "") AS OBS5,');
    qryPcmGer.SQL.Add('@OBS6 := IFNULL(PCG_OBSPD6, "") AS OBS6,');
    qryPcmGer.SQL.Add('CONCAT(');
    qryPcmGer.SQL.Add('  @OBS1,');
    qryPcmGer.SQL.Add('  @OBS2,');
    qryPcmGer.SQL.Add('  @OBS3,');
    qryPcmGer.SQL.Add('  @OBS4,');
    qryPcmGer.SQL.Add('  @OBS5,');
    qryPcmGer.SQL.Add('  @OBS6');
    qryPcmGer.SQL.Add(') OBS');
    qryPcmGer.SQL.Add('FROM');
    qryPcmGer.SQL.Add('PCMGER');


    If fEmptyStr(stlPedidos.DelimitedText) Then
    Begin
      If fTabelaExiste('TMP_ENTMER') Then
      Begin
        qryPcmGer.SQL.Add('JOIN TMP_ENTMER ON ENT_CODEMP = PCG_CODEMP');
        qryPcmGer.SQL.Add('AND ENT_NUMPED = PCG_NUMPED');
      End
      ELse
        qryPcmGer.SQL.Add('WHERE FALSE');
    End
    Else
      qryPcmGer.SQL.Add('WHERE CONCAT(PCG_NUMPED,PCG_CODEMP) IN ("' + stlPedidos.DelimitedText.Replace(',','","') + '")');
    qryPcmGer.SQL.Add('GROUP BY PCG_CODEMP, PCG_NUMPED');
    qryPcmGer.Open;
    While Not qryPcmGer.Eof Do
    Begin
      Result := Result + qryPcmGer.FieldByName('OBS').AsString;
      qryPcmGer.Next;
    End;
  Finally
    pFreeAndNil(qryPcmGer);
  End;
End;

procedure pEntRetDocumento(strNumDoc: String;
                           strEspDoc: String;
                           strCodEmp: String;
                           Var blnRetira: Boolean;
                           Var blnEntFut: Boolean;
                           Var blnEntIme: Boolean);
Var
  qryEntRet: TUniQuery;
begin
  blnRetira := False;
  blnEntFut := False;
  blnEntIme := False;

  qryEntRet := fCriaQuery();

  Try
    qryEntRet.SQL.Add('  SELECT                                ');
    qryEntRet.SQL.Add('    ED.FDO_ENTRET,                      ');
    qryEntRet.SQL.Add('    FD.FDO_ENTFUT                       ');
    qryEntRet.SQL.Add('  FROM                                  ');
    qryEntRet.SQL.Add('    FATDOR FD                           ');
    qryEntRet.SQL.Add('    INNER JOIN EXTDOR ED                ');
    qryEntRet.SQL.Add('      ON FD.AUTOINCREM = ED.FDO_SEQFDO  ');
    qryEntRet.SQL.Add('  WHERE FD.FDO_NUMDOC = :NUMDOC         ');
    qryEntRet.SQL.Add('    AND FD.FDO_ESPDOC = :ESPDOC         ');
    qryEntRet.SQL.Add('    AND FD.FDO_CODEMP = :CODEMP         ');
    qryEntRet.SQL.Add('  GROUP BY                              ');
    qryEntRet.SQL.Add('    ED.FDO_ENTRET,                      ');
    qryEntRet.SQL.Add('    FD.FDO_ENTFUT                       ');

    qryEntRet.ParamByName('NUMDOC').AsString := strNumDoc;
    qryEntRet.ParamByName('ESPDOC').AsString := strEspDoc;
    qryEntRet.ParamByName('CODEMP').AsString := strCodEmp;

    qryEntRet.Open;

    qryEntRet.First;
    While Not qryEntRet.Eof Do
    Begin
      If (qryEntRet.FieldByName('FDO_ENTRET').AsString = 'R') Then
      Begin
        blnRetira := True;
      End
      Else If (qryEntRet.FieldByName('FDO_ENTRET').AsString = 'E') Then
      Begin
        If (qryEntRet.FieldByName('FDO_ENTFUT').AsString = 'S') Then
          blnEntFut := True
        Else
          blnEntIme := True;
      End;

      If (blnRetira) And (blnEntFut) And (blnEntIme) Then
        Break;

      qryEntRet.Next;
    End;
  Finally
    FreeAndNil(qryEntRet);
  End;
end;

function fRetornaDescricaoEntRetDocumento(strNumDoc, strEspDoc, strCodEmp: String):String;
Var
  blnRetira: Boolean;
  blnEntFut: Boolean;
  blnEntIme: Boolean;
begin
  pEntRetDocumento(strNumDoc, strEspDoc, strCodEmp, blnRetira, blnEntFut, blnEntIme);

  Result := '';

  If (blnRetira) Then
    Result := Result + 'RETIRA';

  If (blnEntFut) Then
  Begin
    If (Not fEmptyStr(Result)) Then
      Result := Result + '/';

    Result := Result + 'ENT.FUTURA';
  End;

  If (blnEntIme) Then
  Begin
    If (Not fEmptyStr(Result)) Then
      Result := Result + '/';

    Result := Result + 'ENT.IMEDIATA';
  End;

  If (Not blnRetira) And (Not blnEntFut) And (Not blnEntIme) Then
    Result := 'RETIRA';
end;

