function fPermitirFaturarComLoteADefinir(
  const stlPedidos: TStrings): Boolean; overload;
var
  qryDados    : TUniQuery;
  intContador : Integer;
begin
  Result := True;

  If fUsaRotinaWMS Then
    Exit;

  If (Pos(VS_strTipExp, '3_4_5_') <= 0) Then
    Exit;

  qryDados := fCriaQuery();
  Try
    qryDados.SQL.Text := 'SELECT G.FGO_NUMDOC, G.FGO_ESPDOC, G.FGO_CODEMP '
                       + '  FROM FATGOR G '
                       + ' WHERE G.AUTOINCREM = :AUTINC ';

    For intContador := 0 To Pred(stlPedidos.Count) Do
    Begin
      qryDados.ParamByName('AUTINC').AsString := stlPedidos.Strings[intContador];
      qryDados.Open;

      Result := fPermitirFaturarComLoteADefinir(
                  qryDados.FieldByName('FGO_NUMDOC').AsString,
                  qryDados.FieldByName('FGO_ESPDOC').AsString,
                  qryDados.FieldByName('FGO_CODEMP').AsString);

      If Not Result Then
        Break;
    End;
  Finally
    FreeAndNil(qryDados);
  End;
end;

function fPermitirFaturarComLoteADefinir(
  const strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  qryDados : TUniQuery;
begin
  Result := True;

  If fUsaRotinaWMS Then
    Exit;

  If (strEspDoc <> 'PD') Then
    Exit;

  If (Pos(VS_strTipExp, '3_4_5_') <= 0) Then
    Exit;

  qryDados := fCriaQuery();
  Try
    qryDados.SQL.Text := 'SELECT D.FDO_NUMLOT, X.FDO_ENTRET, D.FDO_ENTFUT '
                       + '  FROM FATGOR G '
                       + ' INNER JOIN FATDOR D ON D.FDO_SEQGER = G.AUTOINCREM '
                       + ' INNER JOIN EXTDOR X ON X.FDO_SEQFDO = D.AUTOINCREM '
                       + ' WHERE G.FGO_CODEMP = :CODEMP '
                       + '   AND G.FGO_NUMDOC = :NUMDOC '
                       + '   AND G.FGO_ESPDOC = "PD" '
                       + '   AND D.FDO_NUMLOT = "A DEFINIR" '
                       + '   AND ((X.FDO_ENTRET = "E" '
                       + '   AND   D.FDO_ENTFUT <> "S") '
                       + '    OR  (X.FDO_ENTRET <> "E")) ';

    qryDados.ParamByName('CODEMP').AsString := strCodEmp;
    qryDados.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDados.Open;

    If qryDados.RecordCount > 0 Then
    Begin
      fMensagem('ATENÇÃO!', 'O Pedido de Venda '+ strNumDoc+'-'+strEspDoc+'-'+strCodEmp+
                            ' possui lote "A DEFINIR" e não pode ser faturado.', ['&OK']);

