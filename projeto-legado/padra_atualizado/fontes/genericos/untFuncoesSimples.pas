Function fRetornaCSTIPI(strCODITE, strCLAFIS: String; var strCSTIPI: String; var strENQIPI: String) : Boolean;
Var
  qryAux: TUniQuery;
  strTabelaAux, strTabela, strCfopEntSai: String;
  blnTPABPC : Boolean;
Begin
  If Not (fCfgSis('UTIABI', varBoolean)) Then
    Exit(True);

  qryAux := fCriaQuery();

  Try
    strTabelaAux := '';
    strTabela := '';
    strCfopEntSai := '';

    If (fCfgSis('TPABPC', varInteger) = 1) Then
    Begin
      strTabelaAux := 'CADITE';
      blnTPABPC := False;
    End
    Else
    Begin
      strTabelaAux := 'ITEGER';
      blnTPABPC := True;
    End;

    If (strCLAFIS > '5000') Then
    Begin
      strTabela := 'IPISAI';
      strCfopEntSai := 'APC_CFOSAI';
    End
    Else
    Begin
      strTabela := 'IPIENT';
      strCfopEntSai := 'APC_CFOENT';
    End;

    qryAux.Sql.Clear;
    qryAux.Sql.Add(' SELECT *                                          ');
    qryAux.Sql.Add('       FROM ' + strTabela    + '                   ');
    qryAux.Sql.Add(' INNER JOIN ' + strTabelaAux + '                   ');
    qryAux.Sql.Add('         ON ITE_ABFIPI = APC_CODAPC                ');

    If blnTPABPC Then
      qryAux.Sql.Add('      AND ITE_CODEMP = :CODEMP                   ');

    qryAux.Sql.Add('      WHERE (LOCATE( :CLAFIS, '+ strCfopEntSai +' ) > 0) ');
    qryAux.Sql.Add('        AND ITE_CODITE = :CODITE                   ');
    qryAux.Sql.Add(' LIMIT 1                                           ');

    qryAux.Close;

    If blnTPABPC Then
      qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;

    qryAux.ParamByName('CLAFIS').AsString := strCLAFIS;
    qryAux.ParamByName('CODITE').AsString := strCODITE;

    qryAux.Open;

    If qryAux.isEmpty Then
    Begin
      strCSTIPI := '';
      strENQIPI := '';
      Result := False;
    End
    Else
    Begin
      If (strCLAFIS > '5000') Then
        strCSTIPI := qryAux.FieldByName('APC_CSTSAI').AsString
      Else
        strCSTIPI := qryAux.FieldByName('APC_CSTENT').AsString;

      strENQIPI := qryAux.FieldByName('APC_ENQIPI').AsString;
      Result := True;
    End;

  Finally
    FreeAndNil(qryAux);
  End;
End;

