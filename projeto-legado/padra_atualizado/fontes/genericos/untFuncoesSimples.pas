procedure pAtualizaSaldoLote(cdsConsulta: TUniClientDataSet = Nil);
  Var
    fltSalRes,
    fltSalDis: Double;
    prcScroll: TprcScroll;
    intRecNo: Integer;
    blnSalRes: Boolean;
Begin
  If cdsConsulta = Nil Then
    Exit;

  If cdsConsulta.IsEmpty Then
    Exit;

  blnSalRes := (fCfgSis('USAPDV', varBoolean, VS_strCodEmp)) Or
               (fCfgSis('GARANT', varBoolean, VS_strCodEmp));

  Try
    pSetaClient(cdsConsulta);
    pDisableControls(cdsConsulta, prcScroll);
    intRecNo := cdsConsulta.RecNo;

    With cdsConsulta Do
    Begin
      If Not IsEmpty Then
      Begin
        pAtualizaFabricacaoMaisAntiga(cdsConsulta);

        First;

        While Not Eof Do
        Begin
          If blnSalRes Then
            fltSalDis := FieldByName('SALATU').AsFloat
          Else
            fltSalDis := FieldByName('LOT_SALDOS').AsFloat;

          If fUsaQtdPendenteEntregaFutura Then
            fltSalDis := fltSalDis + TEntregaFutura.New(
                                       TParamEF.New()
                                         .CodIte(FieldByName('LOT_CODITE').AsString)
                                         .CodEmp(FieldByName('LOT_CODEMP').AsString)
                                         .Lote(FieldByName('LOT_NUMLOT').AsString)
                                         .Faturamento(True)
                                       ).Total();

          fltSalRes := TSaldoReservado.New(
                         TReservaParametros.New()
                           .EmpresaItem(FieldByName('LOT_CODEMP').AsString)
                           .CodEmpresa(FieldByName('LOT_CODEMP').AsString)
                           .CodigoItem(FieldByName('LOT_CODITE').AsString)
                           .NumeroLote(FieldByName('LOT_NUMLOT').AsString)
                       ).fGetQuantidade();

          Edit;
          FieldByName('LOT_SALDOS').AsFloat := fltSalDis;
          FieldByName('SALRES').AsFloat := fltSalRes;
          FieldByName('SALDIS').AsFloat := fltSalDis - fltSalRes;
          Post;

          Next;
        End;
      End;
    End;

    cdsConsulta.RecNo := intRecNo;
  Finally
    pEnableControls(cdsConsulta, prcScroll);
  End;
End;

procedure pAtualizaFabricacaoMaisAntiga(cdsConsulta: TUniClientDataSet);
  Var
    strOldIndex : String;
begin
  If (cdsConsulta.FindField('LOT_DTAFAB') <> Nil) And
     (cdsConsulta.FindField('LOT_NUMLOT') <> Nil) And
     (cdsConsulta.FindField('FABANT') <> Nil) Then
  Begin
    strOldIndex := cdsConsulta.IndexFieldNames;
    cdsConsulta.IndexFieldNames := 'LOT_DTAFAB';

    cdsConsulta.First;
    While Not cdsConsulta.Eof Do
    Begin
      If (Not cdsConsulta.FieldByName('LOT_DTAFAB').IsNull) And
         (cdsConsulta.FieldByName('LOT_NUMLOT').AsString <> 'A DEFINIR') Then
      Begin
        cdsConsulta.Edit;
        cdsConsulta.FieldByName('FABANT').AsString := 'S';
        cdsConsulta.Post;
        Break;
      End;
      cdsConsulta.Next;
    End;

    cdsConsulta.IndexFieldNames := strOldIndex;
  End;
end;

procedure pAtualizaPrecoPromocaoNegociado(cdsConsulta: TUniClientDataSet = Nil);
  Var
    fltPreVen: Double;
    prcScroll: TprcScroll;
    intRecNo: Integer;
    blnTemNegocAtiva: Boolean;

  Function fValidaCampos(arrCampo: Array Of String): Boolean;
    Var
      intContador: Integer;
  Begin
    Result := True;

    For intContador := Low(arrCampo) To High(arrCampo) Do
      If Not Assigned(cdsConsulta.FindField(arrCampo[intContador])) Then
      Begin
        Result := False;
        Exit;
      End;
  End;

Begin
  If cdsConsulta = Nil Then
    Exit;

  If cdsConsulta.IsEmpty Then
    Exit;

  If Not fValidaCampos(['ITE_CODITE', 'IPR_JA_ATU', 'IPR_CODCLI', 'IPR_TABPRE', 'IPR_EMPCOD',
                        'IPR_EMPCOD', 'IPR_PREPRO', 'IPR_PROMOC']) Then
    Exit;

  If Not fValidaCampos(['ITE_PREVE' + cdsConsulta.FieldByName('IPR_TABPRE').AsString]) Then
    Exit;


  If fEhUmRegistroFalso(cdsConsulta, 'ITE_CODITE') Then
    Exit;

  Try
    pSetaClient(cdsConsulta);
    pDisableControls(cdsConsulta, prcScroll);
    intRecNo := cdsConsulta.RecNo;

    blnTemNegocAtiva := fCampoTabela('NEG_STATUS', 'CADNEG', ['NEG_STATUS'], ['A'], False) = 'A';

    With cdsConsulta Do
    Begin
      If Not IsEmpty Then
      Begin
        First;

        While Not Eof Do
        Begin
          If FieldByName('IPR_JA_ATU').AsString <> 'S' Then
          Begin
            Edit;

            If (blnTemNegocAtiva) Then
            Begin

              If TCadNegBussiness.fClienteTemNegociacaoVinculada(FieldByName('IPR_CODCLI').AsString) Then
              Begin
                fltPreVen := FieldByName('ITE_PREVE' + FieldByName('IPR_TABPRE').AsString).AsFloat;

                TCadNegBussiness.fRetornaPrecoNegociacao(FieldByName('IPR_CODCLI').AsString,
                                                         FieldByName('ITE_CODITE').AsString,
                                                         FieldByName('IPR_TABPRE').AsString,
                                                         FieldByName('IPR_EMPCOD').AsString,
                                                         fltPreVen);

                If fltPreVen = FieldByName('ITE_PREVE' + FieldByName('IPR_TABPRE').AsString).AsFloat Then
                Begin
                  If FieldByName('IPR_PREPRO').AsFloat > 0 Then
                    FieldByName('IPR_PROMOC').AsFloat := FieldByName('IPR_PREPRO').AsFloat
                  Else
                    FieldByName('IPR_PROMOC').Value := Null
                End
                Else
                  FieldByName('IPR_PROMOC').AsFloat := fltPreVen;
              End
              Else
                FieldByName('IPR_PROMOC').Value := FieldByName('IPR_PREPRO').Value;

            End
            Else
              FieldByName('IPR_PROMOC').Value := FieldByName('IPR_PREPRO').Value;

            FieldByName('IPR_JA_ATU').AsString := 'S';
            Post;
          End;

          Next;
        End;
      End;
    End;

    cdsConsulta.RecNo := intRecNo;
  Finally
    pEnableControls(cdsConsulta, prcScroll);
  End;
End;

procedure pAtualizaSituacaoPedidoVenda(cdsConsulta: TUniClientDataSet = Nil);
  Var
    prcScroll: TprcScroll;
    intRecNo: Integer;
    strIndexFields: String;
Begin
  If cdsConsulta = Nil Then
    Exit;

  If cdsConsulta.IsEmpty Then
    Exit;

  If (cdsConsulta.FieldByName('FGO_ESPDOC').AsString  <> 'PD') Then
    Exit;

  If (Not (fCfgSis('EXISTA', VarBoolean))) And
     (Not (fCfgSis('EXIADT', VarBoolean))) Then
    Exit;

  If (Not Assigned(cdsConsulta.FindField('FGO_STATUS'))) And
     (Not (fCfgSis('EXIADT', VarBoolean))) Then
    Exit;

  Try
    pSetaClient(cdsConsulta);
    pDisableControls(cdsConsulta, prcScroll);
    intRecNo := cdsConsulta.RecNo;
    strIndexFields := cdsConsulta.IndexFieldNames;

    cdsConsulta.IndexFieldNames := 'AUTOINCREM';

    With cdsConsulta Do
    Begin
      If Not IsEmpty Then
      Begin
        First;

        If Assigned(cdsConsulta.FindField('FGO_SITFIN')) Then
        Begin
        While Not Eof Do
          Begin
            Edit;

              cdsConsulta.FieldByName('FGO_SITFIN').AsString :=
                TSituacaoPedidoVenda.fRetornaSituacaoFinanceira(cdsConsulta.FieldByName('FGO_CODEMP').AsString,
                                                                cdsConsulta.FieldByName('FGO_NUMDOC').AsString,
                                                                cdsConsulta.FieldByName('FGO_ESPDOC').AsString);
            Post;
            Next;
          End;
        End;

        First;
        If Assigned(cdsConsulta.FindField('FGO_SITADT')) Then
        Begin
        While Not Eof Do
          Begin
            Edit;

              cdsConsulta.FieldByName('FGO_SITADT').AsString :=
                TSituacaoPedidoVenda.fRetornaSituacaoAdiantamento(cdsConsulta.FieldByName('FGO_CODEMP').AsString,
                                                                  cdsConsulta.FieldByName('FGO_NUMDOC').AsString,
                                                                  cdsConsulta.FieldByName('FGO_ESPDOC').AsString);
            Post;
            Next;
          End;
        End;

        First;
        If Assigned(cdsConsulta.FindField('SITUACAO_ADIANTAMENTO')) And (fCfgSis('ADTLIB', varBoolean)) Then
        Begin
        While Not Eof Do
          Begin
            Edit;

              cdsConsulta.FieldByName('SITUACAO_ADIANTAMENTO').AsString :=
                TSituacaoPedidoVenda.fRetornaSituacaoAdiantamento(cdsConsulta.FieldByName('FGO_CODEMP').AsString,
                                                                  cdsConsulta.FieldByName('FGO_NUMDOC').AsString,
                                                                  cdsConsulta.FieldByName('FGO_ESPDOC').AsString);
            Post;
            Next;
      End;
    End;
      End;
    End;

    cdsConsulta.RecNo := intRecNo;
    cdsConsulta.IndexFieldNames := strIndexFields;
  Finally
    pEnableControls(cdsConsulta, prcScroll);
  End;
End;

procedure pAlteraSentencaUltOrcUltPedConformeFiltro(Var strSQLAux: String; strFilter: String; cdsConsulta: TUniClientDataSet);
  Var
    strSQLUltOrcUltPed: String;
begin
  strSQLUltOrcUltPed := '';
  If ((Pos(TAG_ULTORC_INI, strSQLAux) > 0) And (Pos(TAG_ULTORC_FIN, strSQLAux) > 0)) Then
  Begin
    strSQLUltOrcUltPed := Copy(strSQLAux, Pos(TAG_ULTORC_INI, strSQLAux)+Length(TAG_ULTORC_INI), (Pos(TAG_ULTORC_FIN, strSQLAux)-Pos(TAG_ULTORC_INI, strSQLAux))-Length(TAG_ULTORC_FIN));

    If (Not fEmptyStr(strSQLUltOrcUltPed)) Then
      If (Not fEmptyStr(strFilter)) Then
        strSQLAux := AnsiReplaceStr(strSQLAux,
                                    TAG_ULTORC_INI + strSQLUltOrcUltPed + TAG_ULTORC_FIN,
                                    TAG_ULTORC_INI + 'TRUE' + TAG_ULTORC_FIN);
  End;

  //PARA FAZER A PARTE REFERENTE A TAG_ULTPED_INI, TAG_ULTPED_FIN COPIAR O CÓDIGO ACIMA E SÓ TROCAR O NOME DAS TAG'S
end;

function fEhUmRegistroFalso(cdsConsulta: TUniClientDataSet; strCampo: String): Boolean;
begin
  Result := False;
  If (cdsConsulta.Active) Then
    If (cdsConsulta.FindField(strCampo) <> Nil) Then
      Result := (cdsConsulta.RecordCount = 1) And (cdsConsulta.FieldByName(strCampo).AsString.IsEmpty);
end;

function fComplementoWhereSQLPosContabilReceber(strCodEmp: String; blnEmpOri: Boolean = False): String;
Begin
  Result := '';
  Result := Result + '  IFNULL(POR_ENTPCO,"S") = "S" AND ';
  Result := Result + '  ((CTR_DTACAD <= :DTAFIN AND ';
  Result := Result + '    CTR_DTAREC >  :DTAFIN) OR ';
  Result := Result + '   (CTR_DTACAD <= :DTAFIN AND ';
  Result := Result + '    CTR_DTAREC IS NULL)) ';

  If (Not blnEmpOri) Then
  Begin
    If Not fEmptyStr(strCodEmp) Then
      Result := Result + '  AND LOCATE(CTR_CODEMP, :CODEMP) > 0 '
    Else
      Result := Result + '  AND LOCATE(CTR_CODEMP, ' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';
  End
  Else
  Begin
    If Not fEmptyStr(strCodEmp) Then
      Result := Result + '  AND LOCATE(IF(IFNULL(CTR_EMP_PD, "") <> "", IFNULL(CTR_EMP_PD, ""), CTR_CODEMP), :CODEMP) > 0 '
    Else
      Result := Result + '  AND LOCATE(IF(IFNULL(CTR_EMP_PD, "") <> "", IFNULL(CTR_EMP_PD, ""), CTR_CODEMP), ' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';
  End;
End;

function fComplementoWhereSQLPosContabilPagar(edtCodEmpresa: TEditFocus;
  arrEmp: TConsultasArray; blnFiltrouPortador: Boolean; edtCodPortador: TEditFocus;
  arrPor: TConsultasArray; strCodEmp: String = ''; blnSomenteJurosEDescontos: Boolean = False ): String;
Begin
  Result := '';
  If blnSomenteJurosEDescontos Then
  Begin
    Result := Result + ' ( 1 = 1 ) '; //Sem Filtro. Fica por conta do FILTER no CDS.
  End
  Else
  Begin
    Result := Result + '  ((CTP_DTACAD <= :DTAFIN AND ';
    Result := Result + '    CTP_DTAPAG > :DTAFIN) OR ';
    Result := Result + '   (CTP_DTACAD <= :DTAFIN AND ';
    Result := Result + '    CTP_DTAPAG IS NULL)) ';
  End;

  If edtCodEmpresa <> Nil Then
  Begin
    If Not fEmptyStr(edtCodEmpresa.Text) Then
      Result := Result + fStrLocate(edtCodEmpresa, arrEmp, 'CTP_CODEMP','CODEMP')
    Else
      Result := Result + '  AND LOCATE(CTP_CODEMP,' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';
  End
  Else
  Begin
    If Not fEmptyStr(strCodEmp) Then
      Result := Result + '  AND LOCATE(CTP_CODEMP, :CODEMP) > 0 '
    Else
      Result := Result + '  AND LOCATE(CTP_CODEMP,' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';
  End;

  If (blnFiltrouPortador)    And
     (edtCodPortador <> Nil) Then
    Result := Result + fStrLocate(edtCodPortador, arrPor, 'CTP_CODPOR', 'CODPOR')
  Else If fCfgSis('DACPOR', varBoolean) Then
  Begin
    Result := Result + ' AND (IFNULL(P.CTP_CODPOR, "") = "" ';
    Result := Result + ' OR LOCATE(P.CTP_CODPOR, ' + QuotedStr(strPortadoresOperador) + ') > 0) ';
    Result := Result + ' AND (IFNULL(P.CTP_PORBAI, "") = "" ';
    Result := Result + ' OR LOCATE(P.CTP_PORBAI, ' + QuotedStr(strPortadoresOperador) + ') > 0) ';
  End;
End;

