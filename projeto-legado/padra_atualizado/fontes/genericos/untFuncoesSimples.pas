function fFaturadorAutomaticoJaBaixouEtiquetaMarketplace(ANumDoc, AEspDoc, ACodEmp, ACodCli, APrefix: string; var APathEtiqueta: string): Boolean;
var
  LEtiB64: string;
  LEtiTxt: string;
  LNumPok: string;
  LFatAut: IMyCampoTabela;
begin
  if not fCfgSis('FATAUT', VarBoolean) then
    Exit(False);

  if ACodCli.IsEmpty then
    ACodCli := fRetornaInformacaoVenda(ANumDoc, AEspDoc, ACodEmp, 'CODCLI');

  LFatAut := fCampoTabela(['AUTOINCREM', 'FAT_ETIPAT', 'FAT_ETIDTA', 'FAT_ETIINC', 'FAT_NUMDOC', 'FAT_ESPDOC', 'FAT_EMPDOC'],
                           'FATAUT',
                          ['FAT_NUMFAT', 'FAT_TIPFAT', 'FAT_EMPFAT', 'FAT_CLIFAT'],
                          [ANumDoc, AEspDoc, ACodEmp, ACodCli]);

  APathEtiqueta := LFatAut.FieldByName('FAT_ETIPAT').AsString;

  if APathEtiqueta.IsEmpty then
  begin
    if fEmptyStr(LFatAut.FieldByName('FAT_ETIDTA').AsString) then
      Exit(False);

    if fEmptyStr(LFatAut.FieldByName('FAT_ETIINC').AsString) then
      Exit(False);

    LEtiB64 := fCampoTabela('ETI_BASE64', 'FATAUT_ETIQ', ['AUTOINCREM'], [LFatAut.FieldByName('FAT_ETIINC').AsString]);

    if LEtiB64.IsEmpty then
      Exit(False);

    LEtiTxt := fBase64Decodifica(LEtiB64);

    LNumPok := fRetornaInformacaoVenda(LFatAut.FieldByName('FAT_NUMDOC').AsString,
                                       LFatAut.FieldByName('FAT_ESPDOC').AsString,
                                       LFatAut.FieldByName('FAT_EMPDOC').AsString,
                                       'NUMPOK');

    LNumPok := LNumPok.Replace(APrefix, '');

    if LNumPok.IsEmpty then
      Exit(False);

    APathEtiqueta := ExtractFilePath(Application.ExeName) + 'MarketPlace\' + LNumPok + '\Etiqueta de envio.txt';

    ForceDirectories(ExtractFilePath(APathEtiqueta));

    TFile.WriteAllText(APathEtiqueta, LEtiTxt, TEncoding.ANSI);

    fExecutaSQL('UPDATE FATAUT SET FAT_ETIPAT = "' + APathEtiqueta.Replace('\', '\\') + '" WHERE AUTOINCREM = "' + LFatAut.FieldByName('AUTOINCREM').AsString + '"');
  end;

  Result := TryFileExists(APathEtiqueta);
end;

