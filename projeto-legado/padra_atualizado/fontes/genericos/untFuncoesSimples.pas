function fRetornaCndPagFormatado(strCndPag: string; blnNumParParenteses: Boolean = False): string;
var
  intIndice,
  intNumPar: integer;
Begin
  Result := EmptyStr;

  if fEmptyStr(strCndPag) then
    Exit;

  intNumPar := StrToIntDef(Copy(strCndPag, 1, 2), 0);

  if intNumPar = 0 then
    Exit;

  if blnNumParParenteses then
  begin
    Result := Result + '('+Copy(strCndPag, 1, 2)+')';
  end
  else
  begin
    Result := Result + Copy(strCndPag, 1, 2) + ' - ';
  end;

  Delete(strCndPag, 1, 2);

  for intIndice := 1 to intNumPar do
  begin
    Result := Result + Copy(strCndPag, 1, 3);

    if intIndice < intNumPar then
      Result := Result + '.';

    Delete(strCndPag, 1, 3);

    if fEmptyStr(strCndPag) then
      Exit;
  end;
End;

{*************************************************************}
{* FUNÇÃO QUE VERIFICA SE O PRAZO MÉDIO DOS CHEQUES-PRÉ      *}
{* EXCEDE O PRAZO MEDIO CONFIGURANDO NA 'CFG_PRZREC'         *}
{*************************************************************}
function fVerificaPrazoMedio_RecebimentoChequePre(cdsChqPre: TUniClientDataSet):Boolean;
var
  APrazoCfg       : Integer;
  APrazoFinal     : Integer;
  APrazoCalculado : Integer;
  vDtCad,vDtVct   : TDateTime;
begin
  APrazoCfg       := fCfgSis('PRZREC', varInteger);
  APrazoCalculado := 0;

  cdsChqPre.First;
  While Not (cdsChqPre.Eof) do
  Begin
    vDtCad          := cdsChqPre.FieldByName('CHQ_DTACAD').AsDatetime;
    vDtVct          := cdsChqPre.FieldByName('CHQ_DTAVEN').AsDatetime;
    APrazoCalculado := APrazoCalculado + DaysBetween(vDtCad, vDtVct);

    cdsChqPre.Next;
  End;

  //ARREDONDAMENTO SEMPRE PRA CIMA
  //EXEMPLO: 101/2 = 50,5
  //COMO A CONFIGURAÇÃO É DE CAMPO INTEIRO, NESSE CASO TEM QUE SER 51
  APrazoFinal := Ceil(APrazoCalculado / cdsChqPre.recordcount);

  if APrazoFinal > APrazoCfg Then
  begin
    fMensagem('ATENÇÃO!','O Recebimento não pode ser efetuado pois o total de dias informado no(s) cheque(s)-pré é maior que o prazo médio configurado!' + #13#10 +
                         'Prazo médio de recebimento configurado: '+ IntToStr(APrazoCfg) ,['&OK']);
    Result := False;
  end
  else
    Result := True;
end;

Function fVerificaPrazoRecebimentoChequePre(cdsChqPre: TUniClientDataSet):Boolean;
Begin

  Result := True;

  // Verifica prazo medio para recebimento de cheque pré.
  If (cdsChqPre.recordCount > 0) then
  Begin
     If (fCfgSis('PRZREC', varInteger) <> 999) Then
         Result := fVerificaPrazoMedio_RecebimentoChequePre( cdsChqPre );
  End;

End;

