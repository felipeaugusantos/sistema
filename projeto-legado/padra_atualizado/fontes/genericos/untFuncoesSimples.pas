{****************************************}
{* EXECUTA A SQL PASSADA POR PARAMETRO  *}
{*************************************AF*}
function fExecutaSQL(strSQL: String; blnRaise: Boolean = False): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Try
    qryGen := fCriaQuery;
    try
      Result := True;

      qryGen.Close;
      qryGen.SQL.Clear;
      qryGen.SQL.Add(strSQL);
      qryGen.ExecSQL;
    finally
      FreeAndNil(qryGen);
    end;
  Except
    On E: Exception do
   	Begin
      If blnRaise Then
        Raise;
     Result := False;
     pMensagensErro(E.Message, '[fExecutaSQL]');
    End;
  End;
End;

procedure pExecutaSQL(const strSQL: String; const arrParametros: array of string; const arrValores: array of Variant);
var
  intParametros: Integer;
  qryGen: TUniQuery;
begin
  qryGen := fCriaQuery();
  Try
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.Params.Clear;
    qryGen.SQL.Text := strSQL;

    For intParametros := Low(arrParametros) To High(arrParametros) Do
    Begin
      qryGen.ParamByName(arrParametros[intParametros]).Value := arrValores[intParametros];
    End;

    qryGen.ExecSQL;
  Finally
    If Assigned(qryGen) Then
      FreeAndNil(qryGen);
  End;
end;

function fDropTable(strNomeTabela: String; Conexao: TUniConnection = Nil): Boolean;
  Var
    strSQL   : String;
    qryGenTmp: TUniQuery;
begin
  Try

    Result := True;

    If Assigned(Conexao) Then
      qryGenTmp := fCriaQuery(Nil, Conexao)
    Else
      qryGenTmp := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'DROP TABLE ' + strNomeTabela;

    Try

      If Not fTabelaExiste(strNomeTabela, False, Conexao) Then
        Exit;

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ExecSQL;
        Close;
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fDropTable]');
        Result := False;
      End;

    End;

  Finally
    FreeAndNil(qryGenTmp);
  End;

end;

