Function fPedidoDeCompraOriundoDeGarantia(strNumPed, strCodEmp : String):Boolean;
  Var
    strSQL : String;
    qryConsul : TUniQuery;
Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT IF(GROUP_CONCAT( DISTINCT PCD_DOCORI) IS NULL, "N", "S") AS PEDGAR ';
  strSQL := strSQL + ' FROM PCMDET                                                  ';
  strSQL := strSQL + ' INNER JOIN MOVGAE ON SUBSTRING(PCD_DOCORI,1,12) = GAE_NUMENV ';
  strSQL := strSQL + '                  AND SUBSTRING(PCD_DOCORI,13,2) = GAE_ESPENV ';
  strSQL := strSQL + '                  AND PCD_CODEMP = GAE_EMPENV                 ';
  strSQL := strSQL + ' WHERE PCD_NUMPED = :NUMPED                                   ';
  strSQL := strSQL + '   AND PCD_CODEMP = :CODEMP                                   ';
  strSQL := strSQL + '   AND PCD_ESPDOC = :ESPDOC                                   ';


  Try
    qryConsul := fCriaQuery(Nil);
    With qryConsul, SQL Do
    Begin
      Close;
      Clear;
      Add(strSQL);

      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('ESPDOC').AsString := 'PD';

      Open;

      If IsEmpty Then
        Result := False
      Else
        Result := FieldByName('PEDGAR').AsString = 'S';

      Close;
    End;
  Finally
    FreeAndNil(qryConsul);
  End;

End;

Function fPedidoDeCompraOriundoDeGarantiaFilial(strNumPed, strCodEmp : String):Boolean;
  Var
    strSQL : String;
    qryConsul : TUniQuery;
Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT IF(GROUP_CONCAT( DISTINCT PCD_DOCORI) IS NULL, "N", "S") AS PEDGAR ';
  strSQL := strSQL + ' FROM PCMDET                                         ';
  strSQL := strSQL + ' INNER JOIN SEQGAR ON SEQ_PCMDET = PCMDET.AUTOINCREM ';
  strSQL := strSQL + ' WHERE PCD_NUMPED = :NUMPED                          ';
  strSQL := strSQL + '   AND PCD_CODEMP = :CODEMP                          ';
  strSQL := strSQL + '   AND PCD_ESPDOC = :ESPDOC                          ';

  Try
    qryConsul := fCriaQuery(Nil);
    With qryConsul, SQL Do
    Begin
      Close;
      Clear;
      Add(strSQL);

      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('ESPDOC').AsString := 'PD';

      Open;

      If IsEmpty Then
        Result := False
      Else
        Result := FieldByName('PEDGAR').AsString = 'S';

