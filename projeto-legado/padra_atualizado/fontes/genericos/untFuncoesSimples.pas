  for LBuffer in strTexto do
    if not(Charinset(LBuffer, ['0'..'9'])) then
      Exit(False);
end;

{***************************************************}
{* RETORNA CRÉDITO DO FORNECEDOR NO CONTAS A PAGAR *}
{*************************************************FC}
function fRetCreditoByFornecedor(strCodFor: String): Double;
  Var
    fltCredito: Double;
    strSQL,
    strSQLTmp: String;
    qryGen: TUniQuery;
begin
  fltCredito := 0.0;

  strSQLTmp := '';
  strSQLTmp := strSQLTmp + ' SELECT SQL_NO_CACHE ';
  strSQLTmp := strSQLTmp + '   SUM(CTP_VALDUP * -1) CTP_VALDUP ';
  strSQLTmp := strSQLTmp + ' FROM ';
  strSQLTmp := strSQLTmp + '   CADPAG ';
  strSQLTmp := strSQLTmp + ' WHERE ';
  strSQLTmp := strSQLTmp + '   CTP_VALDUP < 0 AND ';
  strSQLTmp := strSQLTmp + '   CTP_DTAPAG IS NULL AND ';
  strSQLTmp := strSQLTmp + '   CTP_CODFOR = :CODFOR ';

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   COALESCE(SUM(CTP_VALDUP), 0) AS CTP_VALDUP ';
  strSQL := strSQL + ' FROM (' + strSQLTmp + ') AS TAB ';

  qryGen := fCriaQuery;

  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODFOR').AsString := strCodFor;
    Open;

    If Not IsEmpty Then
      fltCredito := FieldByName('CTP_VALDUP').AsFloat;
  End;

  FreeAndNil(qryGen);

  Result := fltCredito;
end;

