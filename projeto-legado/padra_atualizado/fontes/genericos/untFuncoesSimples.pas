function fTamanhoTagOculta(opcOculta: TOcultarMensagemLiberacao = omlMsgParaQuemEnvia): Integer;
  Var
    strTagIni,
    strTagFin: String;
Begin
  If opcOculta = omlMsgParaQuemEnvia Then
  Begin
