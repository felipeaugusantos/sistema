function fLocFisUtilizadaEmAlgumItem(strLocFis: String): String;
  Var qryIteGer : TUniQuery;
      strSQL : String;
begin
  Result := EmptyStr;
  Try

    qryIteGer := fCriaQuery(nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE';
    strSQL := strSQL + '  CONCAT(I.ITE_CODITE," - ",P.ITE_DESITE) AS DESITE ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ITEGER I INNER JOIN CADITE P ON I.ITE_CODITE = P.ITE_CODITE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  I.ITE_CODEMP  = :CODEMP AND ';
    strSQL := strSQL + '  I.ITE_LOCFIS  = :LOCFIS ';
    strSQL := strSQL + 'LIMIT 1 ';

    With qryIteGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('LOCFIS').AsString := strLocFis;
      Open;

      If Not (IsEmpty) Then
      Begin
        Result := FieldByName('DESITE').AsString;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryIteGer);
  End;

end;

