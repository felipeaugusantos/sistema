function fVerificaTerminalTef(const AstrCodEmp: String = '') : String;
var
  qryTefTer : TUniQuery;
begin
  Result := '';

  qryTefTer := fCriaQuery;

  try
    qryTefTer.Close;
    qryTefTer.SQL.Clear;
    qryTefTer.SQL.Add('SELECT');
    qryTefTer.SQL.Add('  AUTOINCREM,');
    qryTefTer.SQL.Add('  TFC_NUMTER');
    qryTefTer.SQL.Add('FROM');
    qryTefTer.SQL.Add('  TEFCFG');
    if fCfgSis('TIPTER', varString) = '1' then
    begin
      qryTefTer.SQL.Add('WHERE TFC_NOMUSU = :NOMUSU');
      qryTefTer.SQL.Add('  AND TFC_NOMMAQ = :NOMMAQ');
      qryTefTer.SQL.Add('  AND TFC_CODEMP = :CODEMP');

      qryTefTer.ParamByName('NOMUSU').AsString := VS_UserFromWindows;
      qryTefTer.ParamByName('NOMMAQ').AsString := VS_ComputerNetName;
      qryTefTer.ParamByName('CODEMP').AsString := VS_strCodEmp;
    end
    else if fCfgSis('TIPTER', varString) = '2' then
    begin
      qryTefTer.SQL.Add('WHERE TFC_LOC_IP = :LOC_IP');
      qryTefTer.SQL.Add('  AND TFC_NOMMAQ = :NOMMAQ');

      if not fEmptyStr(AstrCodEmp) then
      begin
        qryTefTer.SQL.Add('   AND TFC_EMPTIP = :EMPTIP');
        qryTefTer.ParamByName('EMPTIP').AsString := AstrCodEmp;
      end
      else
      begin
        qryTefTer.SQL.Add('   AND COALESCE(TFC_EMPTIP, "") = ""');
      end ;

      qryTefTer.ParamByName('LOC_IP').AsString := VS_WorkStationIP;
      qryTefTer.ParamByName('NOMMAQ').AsString := VS_WorkstationID;
    end
    else // 3
    begin
      qryTefTer.SQL.Add('WHERE TFC_EMPTIP = :EMPTIP');
      qryTefTer.SQL.Add('  AND TFC_NOMMAQ = :NOMMAQ');
      if fCfgSis('TEFCIT', varString) = OPCAO_NCR then
        qryTefTer.SQL.Add(' AND LENGTH(TRIM(TFC_NUMTER)) = 3 ')
      else if fCfgSis('TEFCIT', varString) = OPCAO_CLISITEF then
        qryTefTer.SQL.Add(' AND LENGTH(TRIM(TFC_NUMTER)) > 3 ') ;

      qryTefTer.ParamByName('EMPTIP').AsString := VS_strCodEmp;
      qryTefTer.ParamByName('NOMMAQ').AsString := VS_WorkstationID;
    end ;
    qryTefTer.Open;

    if not qryTefTer.isEmpty then
    begin
      Result := qryTefTer.FieldByName('TFC_NUMTER').AsString;
    end
    else
    begin
      if (fCfgSis('TIPTER', varString) = '2') and (fEmptyStr(AstrCodEmp)) then
        Result := fVerificaTerminalTef(VS_strCodEmp) ;
    end ;
  finally
    FreeAndNil(qryTefTer);
  end;

end;

