function fRetAutoIncremInterno(strNomeTabela, strCodEmp: String; intIntervalo: Integer = -1): String;
  Var
    intAutIncAtu: Int64;

    strSQL,
    strProEmp: String;
    qryGenCod: TUniQuery;

    LConn: TCriarConexao;

    function fFaixaReservadaEmLista(const intInicio, intQtd: Integer): String;
      Var
        intSeq: Integer;
    begin
      Result := '';
      For intSeq := intInicio To (intInicio + intQtd - 1) Do
      Begin
        If (Not fEmptyStr(Result)) Then
          Result := Result + ', ';
        Result := Result + QuotedStr(fFormataAutInc(intAutIncAtu + intSeq, strCodEmp, strProEmp));
      End;
    end;

    function fAutoIncremCadastrado: Boolean;
      Const
        INT_TAM_BLOCO = 50;
      Var
        qryGenTmp : TUniQuery;
        intIni,
        intQtd: Integer;

    begin
      Result := False;

      Try
        qryGenTmp := fCriaQuery(nil, LConn.objConexao);

        If (intIntervalo <= 1) Then
        Begin
          With qryGenTmp Do
          Begin
            Close;
            SQL.Clear;
            SQL.Add('SELECT SQL_NO_CACHE AUTOINCREM '+
                    '  FROM ' + strNomeTabela +
                    ' WHERE AUTOINCREM = :AUTINC LIMIT 1');
            ParamByName('AUTINC').AsString := fFormataAutInc(intAutIncAtu, strCodEmp, strProEmp);
            Open;
            Result := (Not IsEmpty);
            Close;
          End;

          Exit;
        End;

        intIni := 0;

        While (intIni < intIntervalo) And (Not Result) Do
        Begin
          intQtd := INT_TAM_BLOCO;
          If (intQtd > (intIntervalo - intIni)) Then
            intQtd := intIntervalo - intIni;

          With qryGenTmp Do
          Begin
            Close;
            SQL.Clear;
            SQL.Add('SELECT SQL_NO_CACHE AUTOINCREM '+
                    '  FROM ' + strNomeTabela +
                    ' WHERE AUTOINCREM IN (' + fFaixaReservadaEmLista(intIni, intQtd) + ') LIMIT 1');
            Open;
            Result := (Not IsEmpty);
            Close;
          End;

          intIni := intIni + intQtd;
        End;

      Finally
        FreeAndNil(qryGenTmp);
      End;

    end;

    function fGetUltAutIncPROCOD: Int64;
      Var
        strTmp: String;
        qryTmp: TUniQuery;
    Begin
      Result := 0;

      strTmp := '';
      strTmp := strTmp + ' SELECT ';
      strTmp := strTmp + '   MAX(MID(AUTOINCREM, 4, 14)) AUTINC ';
      strTmp := strTmp + ' FROM ';
      strTmp := strTmp + '   PROCOD ';
      strTmp := strTmp + ' WHERE ';
      strTmp := strTmp + '   PRO_CODEMP = "' + VS_strCodEmp + '" ';

      Try
        qryTmp := fCriaQuery(nil, LConn.objConexao);

        With qryTmp Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strTmp);
          Open;

          If Not IsEmpty Then
            Result := FieldByName('AUTINC').AsLargeInt
          Else
            Result := 1;
        End;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '[fGetUltAutIncPROCOD]');
      End;

      FreeAndNIl(qryTmp);
    End;
begin
  LConn := TCriarConexao.Create('fRetAutoIncrem('+strNomeTabela+', '+strCodEmp+')');
  Try
    qryGenCod := fCriaQuery(Nil, LConn.objConexao);
    Repeat
      fStartTransaction(LConn.objConexao);
      Try
        strSQL := '';
        strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
        strSQL := strSQL + '  PRO_AUTINC AS AUTINC  ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL + '  PROINC ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  PRO_NOMARQ = :NOMARQ ';
        strSQL := strSQL + ' FOR UPDATE ';

        With qryGenCod Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NOMARQ').AsString := strNomeTabela;
          Open;

          If IsEmpty Then
          Begin
            If SameText(strNomeTabela, 'PROCOD') Then
            Begin
              Close;
              SQL.Clear;
              SQL.Add(' SELECT * FROM PROCOD');
              Open;

              Insert;
              FieldByName('PRO_NOMARQ').AsString  := 'PROCOD';
              FieldByName('PRO_CODSEQ').AsString  := '001';
              FieldByName('PRO_TAMCOD').AsInteger := 3;
              FieldByName('AUTOINCREM').AsString  := fRetEmpresaFisica(LConn.objConexao) + fPadL(IntToStr(fGetUltAutIncPROCOD) + VS_strCodEmp, 17, '0');
              FieldByName('PRO_CODEMP').AsString  := fRetEmpresaFisica(LConn.objConexao);
              FieldByName('PRO_CODAUT').AsString  := 'N';
              Post;

              Close;
              SQL.Clear;
              SQL.Add(' SELECT * FROM PROINC');
              Open;

              Insert;
              FieldByName('PRO_NOMARQ').AsString  := 'PROCOD';
              FieldByName('PRO_AUTINC').AsInteger := 1;
              FieldByName('AUTOINCREM').AsString  := fRetEmpresaFisica(LConn.objConexao) + fPadL(IntToStr(fGetUltAutIncPROCOD) + VS_strCodEmp, 17, '0');
              Post;

              Close;
              SQL.Clear;
              SQL.Add(strSQL);
              ParamByName('NOMARQ').AsString := strNomeTabela;
              Open;
            End
            Else
            Begin
              Close;
              FreeAndNil(qryGenCod);
              Raise Exception.Create('A tabela ' + strNomeTabela + ' não está cadastrada ' +
                                   'na tabela de Próximos Incrementos! Verifique.' + #13#10);
            End;
          End;

          strProEmp := fRetEmpresaFisica(LConn.objConexao);

          If FieldByName('AUTINC').Value = Null Then
            intAutIncAtu := 1
          Else
            intAutIncAtu := FieldByName('AUTINC').AsLargeInt;

          Close;
        End;

        strSQL := '';
        strSQL := strSQL + 'UPDATE ';
        strSQL := strSQL + '  PROINC ';
        strSQL := strSQL + 'SET ';

        If intIntervalo > 1 Then
        Begin

          If intAutIncAtu = 1 Then
            strSQL := strSQL + '  PRO_AUTINC = ' + IntToStr(intIntervalo + 1)
          Else
            strSQL := strSQL + '  PRO_AUTINC = PRO_AUTINC + ' + IntToStr(intIntervalo);

        End Else
        Begin

          If intAutIncAtu = 1 Then
            strSQL := strSQL + '  PRO_AUTINC = 2 '
          Else
            strSQL := strSQL + '  PRO_AUTINC = PRO_AUTINC + 1 ';

        End;

        strSQL := strSQL + '  WHERE ';
        strSQL := strSQL + '    PRO_NOMARQ = :NOMARQ ';

        With qryGenCod Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NOMARQ').AsString := strNomeTabela;
          ExecSQL;
          Close;
        End;

        Result :=  strProEmp + fPadL(IntToStr(intAutIncAtu) + strCodEmp, 17, '0');

        fCommit(LConn.objConexao);
      Except
        On E: Exception Do
        Begin
          fRollback(LConn.objConexao);
          FreeAndNil(qryGenCod);
          Raise ExceptClass(E.ClassType).Create('Não consegui pegar o proximo sequencial de ' + strNomeTabela +
            ' em PROINC. Tente novamente! ' + sLineBreak + '[' + E.Message + ']');
        End;
      End;

    Until (Not fAutoIncremCadastrado);

    FreeAndNil(qryGenCod);
  Finally
    FreeAndNil(LConn);
  End;
end;

function fValidaFdGInc(): Boolean ;
begin
  Result := False ;
  if fEmptyStr(VS_strCodEmp) then
    Exit ;

  Result := fCfgSis('FDGINC') = 'S' ;

end ;

function fRetAutoIncrem(strNomeTabela, strCodEmp: String; intIntervalo: Integer = -1; blnForcaValidaExistencia: Boolean = True): String;
begin
  If Pos(strNomeTabela, 'PROCOD_PROINC') <= 0 Then
    pValidaProCod(strNomeTabela);

  if fValidaFdGInc then
    Result := fRetAutoIncremFireDac(strNomeTabela, strCodEmp, intIntervalo, blnForcaValidaExistencia)
  else
    Result := fRetAutoIncremInterno(strNomeTabela, strCodEmp, intIntervalo) ;
end;

function fRetAutoIncremInteger(strNomeTabela, strCodEmp: String): Int64;
begin
  Result := StrToInt64Def(Copy(fRetAutoIncrem(strNomeTabela, strCodEmp), 4, 14), 0);
end;

function fFormataAutInc(intAutInc: Int64; strCodEmp: String; strProEmp: String = ''): String;
begin
  If fEmptyStr(strProEmp) Then
    strProEmp := fRetEmpresaFisica;

  Result := strProEmp + fPadL(IntToStr(intAutInc) + strCodEmp, 17, '0');
end;

function fRetornaEspeciePeloCodigo(strCodigo: String) : String;
begin
  If strCodigo = '01'      Then Result := 'NF'
  Else If strCodigo = '02' Then Result := 'IF'
  Else If strCodigo = '03' Then Result := 'MI'
  Else If strCodigo = '04' Then Result := 'FF'
  Else If strCodigo = '05' Then Result := 'TE'
  Else If strCodigo = '06' Then Result := 'BR'
  Else If strCodigo = '07' Then Result := 'TR'
  Else If strCodigo = '08' Then Result := 'DV'
  Else If strCodigo = '09' Then Result := 'PD'
  Else If strCodigo = '10' Then Result := 'D1';
end;

