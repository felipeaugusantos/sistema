function StrToComSemPreco(const AValue: String): TImpressaoComSemPrecoOrPd;
begin
  If (AValue = 'Com Preço e Com Marca') Then
    Result := impComPrecoComMarca
  Else If (AValue = 'Com Preço e Sem Marca') Then
    Result := impComPrecoSemMarca
  Else If (AValue = 'Sem Preço e Com Marca') Then
    Result := impSemPrecoComMarca
  Else If (AValue = 'Sem Preço e Sem Marca') Then
    Result := impSemPrecoSemMarca
  Else If (AValue = 'Com Preço') Then
    Result := impComPrecoGeral
  Else If (AValue = 'Sem Preço') Then
    Result := impSemPrecoGeral
  Else If (AValue = 'Sem Preço Simplificado') Then
    Result := impSemPrecoSimplificado
  Else
    Result := impComPrecoGeral;
end;

