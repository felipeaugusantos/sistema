function fOrdenaClientDataSet(ClientDataSet: TUniClientDataSet; const FieldName: String): Boolean;
var
  NewIndexName: String;
  IndexOptions: TIndexOptions;
  Field: TField;
begin
  Result := False;
  Field := ClientDataSet.Fields.FindField(FieldName);

  if (Field = nil) or
     (Field is TObjectField) or
     (Field is TBlobField) or
     (Field is TAggregateField) or
     (Field is TVariantField) or
     (Field is TBinaryField) then
    Exit;

  ClientDataSet.IndexDefs.Update;

  if ClientDataSet.IndexName = FieldName + cnsNomeIdxGrid + 'ASC'
  then
  begin
    NewIndexName := FieldName + cnsNomeIdxGrid + 'DSC';
    IndexOptions := [ixDescending];
  end
  else
  begin
    NewIndexName := FieldName + cnsNomeIdxGrid + 'ASC';
    IndexOptions := [];
  end;

  Result := ClientDataSet.IndexDefs.IndexOf(NewIndexName) > -1;

  if not Result then
  begin
    ClientDataSet.AddIndex(NewIndexName, FieldName, IndexOptions);
    Result := True;
  end;

  ClientDataSet.IndexName := NewIndexName;
end;

function fRetSalExterno(strCodIte, strCodEmp, strEmpSalExt: String; strNumLot: String = ''): Double;
