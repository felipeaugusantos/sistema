begin
  Result := fCampoTabela('VEI_ZEROKM', 'CADVEI', ['VEI_PLAVEI'], [strPlaVei]) = 'S';
end;

function fProximoVeiculoZeroKm: String;
begin
  Result := fCampoTabela('CONCAT("Z", LPAD(IFNULL(MAX(RIGHT(VEI_PLAVEI, 6)), 0) + 1, 6, "0"))', 'CADVEI', ['VEI_ZEROKM'], ['S']);
end;

function fRetornaDescricaoVeic(strPlaVei: String; blnSomenteDescricaoVeiculo: Boolean = false): String;
  Var
    strDesc: String;
    strFrom: String;
begin
