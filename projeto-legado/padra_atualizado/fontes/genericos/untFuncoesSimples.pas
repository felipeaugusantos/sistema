end;

function fValidarEstruturaParaDisparoDeWhatsappDosGatilhosDeInformacao(const AstrCodOpe: String; const blnValidarCfgGatOpe, blnValidandoGatilho: Boolean; AIDFilaValidar: String = ''): Boolean;
var
  LstrMsgPadrao: String;
begin
  Result := False;

  if blnValidarCfgGatOpe then
  begin
    if fEmptyStr(AstrCodOpe) then
    begin
      pMensagemOk(IIF(blnValidandoGatilho,
                     'Não é possível gravar este gatilho ativo para envio por Whatsapp. ' + sLineBreak +
                     'Informe o operador responsável pelo envio na configuração CFG_GATOPE (Gatilhos de Informação - Operador para envio de Email / WhatsApp) da empresa configurada no gatilho.',
                     'É obrigatório o preenchimento da CFG_GATOPE quando a CFG_UTIWPP e a CFG_GATINF estiverem ativadas!'));
      Exit;
    end;

    if not fOperadorAtivo(AstrCodOpe) then
    begin
      LstrMsgPadrao := 'O operador informado na configuração CFG_GATOPE (Gatilhos de Informação - Operador para envio de Email / WhatsApp) não existe ou está inativo.';
      pMensagemOk(IIF(blnValidandoGatilho,
                      'Não é possível gravar este gatilho ativo para envio por Whatsapp. ' + sLineBreak + LstrMsgPadrao,
                      LstrMsgPadrao));
      Exit;
    end;

    AIDFilaValidar := fRetFilaEnvioWhatsAppOperador(AstrCodOpe).ToString;
    if AIDFilaValidar = '0' then
    begin
      LstrMsgPadrao := 'O operador informado na configuração CFG_GATOPE (Gatilhos de Informação - Operador para envio de Email / WhatsApp) não possui uma fila configurada.';
      pMensagemOk(IIF(blnValidandoGatilho,
                      'Não é possível gravar este gatilho ativo para envio por Whatsapp. ' + sLineBreak + LstrMsgPadrao,
                      LstrMsgPadrao));
      Exit;
    end;
  end;

  if not fIDFilaEApiKeyWhatsappValidos(AIDFilaValidar) then
  begin
    LstrMsgPadrao := IIF(blnValidarCfgGatOpe,
                        'A fila do operador informado na configuração CFG_GATOPE (Gatilhos de Informação - Operador para envio de Email / WhatsApp) não está configurada corretamente. Verifique o identificador e a chave da API.',
                        'A fila informada no cadastro do relatório não está configurada corretamente. Verifique o identificador e a chave da API.');

    pMensagemOk(IIF(blnValidandoGatilho,
                    'Não é possível gravar este gatilho ativo para envio por Whatsapp. ' + sLineBreak + LstrMsgPadrao,
                    LstrMsgPadrao));
    Exit;
  end;

  Result := True;
end;

