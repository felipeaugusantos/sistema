function fRetCliConsumidor(strCodCli, strNumDoc, strEspDoc,
  strCodEmp: String): String;
  Var
    qryAux : TUniQuery;
    strSQL : String;
begin

  qryAux := fCriaQuery(Nil);

  Try

    strSQL := '';
    strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '   CTR_NUMDUP,       ';
    strSQL := strSQL + '   CTR_ESPDOC,       ';
    strSQL := strSQL + '   CTR_CODEMP,       ';
    strSQL := strSQL + '   CTR_CODCLI,       ';
    strSQL := strSQL + '  (IF(CLI_NOMCLI LIKE "%CONSUMIDOR%" OR ';
    strSQL := strSQL + '      CLI_NOMCLI LIKE "%BALCAO%"     OR ';
    strSQL := strSQL + '      CLI_NOMCLI LIKE "%BALCÃO%",       ';
    strSQL := strSQL + '        IF(CTR_ESPDOC = "PD", ';
    strSQL := strSQL + '           FATGOR.FGO_NOMCON, ';
    strSQL := strSQL + '           IF(IFNULL(MOVGER.GER_NOMCON, "") = "", ';
    strSQL := strSQL + '              NOTGER.GER_NOMCON, MOVGER.GER_NOMCON)), ';
    strSQL := strSQL + '      CLI_NOMCLI)) AS CTR_NOMCLI  ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   CADREC ';
    strSQL := strSQL + '   LEFT JOIN CADCLI ON CTR_CODCLI = CLI_CODCLI ';
    strSQL := strSQL + '   LEFT JOIN MOVGER ON MOVGER.GER_CODCLI = CTR_CODCLI ';
    strSQL := strSQL + '                   AND MOVGER.GER_NUMDOC = CTR_NUMDUP ';
    strSQL := strSQL + '                   AND MOVGER.GER_ESPDOC = CTR_ESPDOC ';
    strSQL := strSQL + '                   AND MOVGER.GER_CODEMP = CTR_CODEMP ';

    strSQL := strSQL + '   LEFT JOIN NOTGER ON NOTGER.GER_CODCLI = CTR_CODCLI ';
    strSQL := strSQL + '                   AND NOTGER.GER_NUMDOC = CTR_NUMDUP ';
    strSQL := strSQL + '                   AND NOTGER.GER_ESPDOC = CTR_ESPDOC ';
    strSQL := strSQL + '                   AND NOTGER.GER_CODEMP = CTR_CODEMP ';

    strSQL := strSQL + '   LEFT JOIN FATGOR ON FATGOR.FGO_CODCLI = CTR_CODCLI ';
    strSQL := strSQL + '                   AND FATGOR.FGO_NUMDOC = CTR_NUMDUP ';
    strSQL := strSQL + '                   AND FATGOR.FGO_ESPDOC = CTR_ESPDOC ';
    strSQL := strSQL + '                   AND FATGOR.FGO_CODEMP = CTR_CODEMP ';

    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '   CTR_NUMDUP = :NUMDUP AND ';
    strSQL := strSQL + '   CTR_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '   CTR_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '   CTR_CODCLI = :CODCLI ';

    With qryAux Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDUP').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;
    End;

    Result := qryAux.FieldByName('CTR_NOMCLI').AsString;

  Finally

    FreeAndNil(qryAux);

  End;
end;

procedure pAuditaCfg ;
var
  strArqDupCfg : string ;
  itemCfg : TRecConfiguracoes ;
  lstControle, lstCfgsDulicadas, lstArquivo : TStringList ;
begin
  strArqDupCfg := ExtractFilePath(Application.ExeName) + 'CFGS_DUPL.TXT';
  If FileExists(PChar(strArqDupCfg)) Then
  begin
    DeleteFile(PChar(strArqDupCfg));
  end;

  lstControle := TStringList.Create ;
  lstCfgsDulicadas := TStringList.Create ;
  lstArquivo := TStringList.Create ;
  try
    lstControle.Sorted := True ;
    lstCfgsDulicadas.Sorted := True ;
    for itemCfg in arrCamposCfg do
    begin
      if lstControle.IndexOf(itemCfg.strCodCfg) = -1 then
      begin
        lstControle.Append(itemCfg.strCodCfg) ;
      end
      else
      begin
        if lstCfgsDulicadas.IndexOf(itemCfg.strCodCfg) = -1 then
        begin
          lstCfgsDulicadas.Append(itemCfg.strCodCfg);
        end;
      end;
    end;

    if lstCfgsDulicadas.Count > 0 then
    begin
      TThreadFinalizarAutcomMonitor.Monitorar;

      for itemCfg in arrCamposCfg do
      begin
        if lstCfgsDulicadas.IndexOf(itemCfg.strCodCfg) <> -1 then
        begin
          lstArquivo.Add(itemCfg.strCodCfg + ';' + itemCfg.strDescri + ';' + itemCfg.strGruCfg) ;
        end;
      end;

