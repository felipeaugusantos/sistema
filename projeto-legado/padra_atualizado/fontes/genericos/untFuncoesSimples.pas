Function fOSFinalizada(strNumDoc, strEspDoc, strCodEmp: String; Var strNumOs: String): Boolean;
  Var
    strSQL: String;
    qryAux: TUniQuery;
Begin
  qryAux   := fCriaQuery(Nil);

  strNumOs := '';

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   EQU_STATUS, ';
  strSQL := strSQL + '   CONCAT(EQU_NUMOSE,"-",EQU_CODEMP) AS NUM_OS ';
  strSQL := strSQL + ' FROM EQUGER ';
  strSQL := strSQL + ' WHERE (EQU_NUMPED = :NUMPED  ';
  strSQL := strSQL + '    AND EQU_TIPPED = :ESPDOC  ';
  strSQL := strSQL + '    AND EQU_EMPPED = :CODEMP) ';
  strSQL := strSQL + ' UNION ';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   EQU_STATUS, ';
  strSQL := strSQL + '   CONCAT(EQU_NUMOSE,"-",EQU_CODEMP) AS NUM_OS ';
  strSQL := strSQL + ' FROM EQUGER ';
  strSQL := strSQL + ' INNER JOIN EQUGOR ON EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU ';
  strSQL := strSQL + ' INNER JOIN FATGOR ON EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';
  strSQL := strSQL + ' WHERE (FGO_NUMDOC = :NUMPED  ';
  strSQL := strSQL + '    AND FGO_ESPDOC = :ESPDOC  ';
  strSQL := strSQL + '    AND FGO_CODEMP = :CODEMP) ';

  With qryAux Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMPED').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;

    If Not IsEmpty Then
    Begin
      Result := (FieldByName('EQU_STATUS').AsString = 'R');

      if Not Result then
        strNumOs := FieldByName('NUM_OS').AsString;
    End
    Else
      Result := True; // Se Não é pedido oriundo de Ordem de Serviço não trava
  End;

  FreeAndNil(qryAux);
End;

function fFormatarSQL(strSQL: String): String;
begin
  Result := Trim(strSQL);

  If Pos('SELECT', Result) = 0 Then
    Exit;

  While Pos('  ', Result) > 0 Do
    Result := ReplaceStr(Result, '  ', ' ');

  Result := ReplaceStr(Result, ', ', ',');

  Result := ReplaceStr(Result, ',', ',' + #13#10 + '  ');

  Result := ReplaceStr(Result, ' AND ', ' AND ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'SELECT ', 'SELECT ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'FROM ', #13#10 + 'FROM ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'INNER JOIN ', #13#10 + '  INNER JOIN ');

  Result := ReplaceStr(Result, 'LEFT JOIN ', #13#10 + '  LEFT JOIN ');

  Result := ReplaceStr(Result, ' ON ', ' ON ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'WHERE ', #13#10 + 'WHERE ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'HAVING ', #13#10 + 'HAVING ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'ORDER BY ', #13#10 + 'ORDER BY ' + #13#10 + '  ');

  Result := ReplaceStr(Result, 'LIMIT ', #13#10 + 'LIMIT ' + #13#10 + '  ');
end;

procedure pBloquearLiberarProdutoParaVendaEmTodasEmpresasQueUsamEssePreco(strCodIte, strFlagNouS: String);
 Var 
   strEmpresas: String;
begin
  If Not fCfgSis('CLPVDI', varBoolean) Then
    Exit;
    
  fExecutaSQL(' UPDATE ITEGER ' +
              '    SET ITE_PEFAVE = "' + strFlagNouS + '" ' +
              '  WHERE ITE_CODITE = "' + strCodIte + '" ' +
              '    AND ITE_CODEMP = "' + VS_strCodEmp + '"');

  If (fCfgSis('TIPABF', varString) = '1') Then
  Begin
    strEmpresas := fRetEmpresasUsamPrecoMatriz;

    If strEmpresas = (VS_strCodEmp + '_') Then
      Exit;
    
    strEmpresas := fStringSQLLocateToStringSQLIN(fRetEmpresasUsamPrecoMatriz);

    fExecutaSQL(' UPDATE ITEGER ' +
                '    SET ITE_PEFAVE = "' + strFlagNouS + '" ' +
                '  WHERE ITE_CODITE = "' + strCodIte + '" ' +
                '    AND ITE_CODEMP IN (' + strEmpresas + ')');
  End;
end;

function fHaProdutosNoPedido(strNumDoc, strCodEmp: String): Boolean;
  Var
    qryPed : TUniQuery;
begin
  qryPed := fCriaQuery(nil);

  Try
    With qryPed Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT COUNT(*) CNT          ');
      SQL.Add('   FROM FATDOR                ');
      SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC  ');
      SQL.Add('    AND FDO_ESPDOC = "PD"     ');
      SQL.Add('    AND FDO_CODEMP = :CODEMP  ');
      SQL.Add('    AND FDO_CODITE <> :ITESER ');
      SQL.Add('    AND FDO_CODITE <> :SERTER ');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('ITESER').AsString := fCfgSis('ITESER', varString);
      ParamByName('SERTER').AsString := fCfgSis('SERTER', varString);
      Open;

      Result := (FieldByName('CNT').AsInteger > 0);
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[untFuncoesSimples.fHaProdutosNoPedido]');
    End;
  End;

  FreeAndNil(qryPed);
end;

function fProdutosExpedidos(strNumDoc, strCodEmp: String): Boolean;
  Var
    qryAux: TUniQuery;
begin

  qryAux := fCriaQuery(Nil);

  With qryAux do
  Begin
    SQL.Clear;
    SQL.Add('SELECT ');
    SQL.Add('  COUNT(1) AS QTD ');
    SQL.Add('FROM ');
    SQL.Add('  FATGOR F ');
    SQL.Add('    INNER JOIN EXTGOR G ON (F.AUTOINCREM = G.FGO_SEQFGO) ');
    SQL.Add('WHERE IFNULL(G.FGO_DTLBEX,0) > 0 ');
    SQL.Add('AND   F.FGO_NUMDOC = :NUMPED ');
    SQL.Add('AND   F.FGO_ESPDOC = "PD"    ');
    SQL.Add('AND   F.FGO_CODEMP = :CODEMP ');
    ParamByName('NUMPED').AsString := strNumDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;

    Result := (FieldByName('QTD').AsInteger > 0);
  End;

  FreeANdNil(qryAux);
end;

function fGetSQLInsertTabelasServico(strTabela: String): String;
  var
    i: Integer;
    strCampos, strParam, strPrefix: String;
begin
  Result := '';

  If (fEmptyStr(strTabela)) Or
    ((strTabela <> 'SERGOR') And (strTabela <> 'SERMOV') And (strTabela <> 'SERNOT')) Then
    Exit;

  If (strTabela = 'SERGOR') Then
    strPrefix := 'FGO_'
  Else If (strTabela = 'SERMOV') Or (strTabela = 'SERNOT') Then
    strPrefix := 'GER_';

  If (strTabela = 'SERGOR') Then Begin
    strCampos := ' FGO_SEQFGO, FGO_NROPRO, FGO_NROCEI, FGO_SERINI, FGO_SERFIN, FGO_SEROBS, FGO_DISSER, '
      + 'FGO_DTAGES, FGO_HRAGES, FGO_DTENTS, FGO_HRENTS, FGO_NATSER, FGO_MUNPRE, ';
    strParam  := ' :SEQFGO, :NROPRO, :NROCEI, :SERINI, :SERFIN, :SEROBS, :DISSER, :DTAGES, :HRAGES, '
      + ':DTENTS, :HRENTS, :NATSER, :MUNPRE, ';
  End;

  For i := 1 To 30 Do Begin
    If (i >= 7) Then Begin
      strCampos := strCampos + strPrefix + 'CODS' + fStrZero(i, 2) + ', ';
      strParam  := strParam + ':CODS' + fStrZero(i, 2) + ', ';

      strCampos := strCampos + strPrefix + 'DESS' + fStrZero(i, 2) + ', ';
      strParam  := strParam + ':DESS' + fStrZero(i, 2) + ', ';

      strCampos := strCampos + strPrefix + 'VALS' + fStrZero(i, 2) + ', ';
      strParam  := strParam + ':VALS' + fStrZero(i, 2) + ', ';
    End;

    strCampos := strCampos + strPrefix + 'QTDS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':QTDS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'UNIS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':UNIS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'CUSS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':CUSS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'DECS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':DECS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'STAS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':STAS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'BRIS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':BRIS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'PARS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':PARS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'TBRS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':TBRS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'PRIS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':PRIS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'IDES' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':IDES' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'VENS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':VENS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'VE2S' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':VE2S' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'CMVS' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':CMVS' + fStrZero(i, 2) + ', ';

    strCampos := strCampos + strPrefix + 'CV2S' + fStrZero(i, 2) + ', ';
    strParam  := strParam + ':CV2S' + fStrZero(i, 2) + ', ';

    If (i = 30) Then Begin
      strCampos := strCampos + '###';
      strParam  := strParam  + '###';
    End;
  End;

  strCampos := StringReplace(strCampos, ', ###', '', [rfReplaceAll]);
  strParam  := StringReplace(strParam, ', ###', '', [rfReplaceAll]);

  Result := 'INSERT INTO ' + strTabela + ' ( ' + strCampos + ' ) VALUES ( ' +
    strParam + ' ) ';
end;

function fSQLSaldoEstoque: String;
  Var
    strSQl : String;
begin
  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   TAB.DTABAL, ';
  strSQL := strSQL + '   TAB.CODBAR, ';
  strSQL := strSQL + '   TAB.CODITE, ';
  strSQL := strSQL + '   SUM(TAB.QTDSAI) AS QTDSAI, ';
  strSQL := strSQL + '   SUM(TAB.QTDENT) AS QTDENT ';
  strSQL := strSQL + ' FROM ( ';
  strSQL := strSQL + '       SELECT SQL_NO_CACHE ';
  strSQL := strSQL + '         G.ITE_DTABAL AS DTABAL, ';
  strSQL := strSQL + '         I.ITE_CODBAR AS CODBAR, ';
  strSQL := strSQL + '         I.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '         IFNULL(D.QTDSAI, 0.00) AS QTDSAI, ';
  strSQL := strSQL + '         IFNULL(D.QTDENT, 0.00) AS QTDENT ';
  strSQL := strSQL + '       FROM CADITE I ';
  strSQL := strSQL + '         INNER JOIN ITEGER G ON G.ITE_CODITE = I.ITE_CODITE ';
  strSQL := strSQL + '                            AND G.ITE_CODEMP = :CODEMP ';
  strSQL := strSQL + '         LEFT  JOIN  (SELECT DISTINCT SQL_NO_CACHE ';
  strSQL := strSQL + '                        DET_NUMDOC, DET_ESPDOC, DET_CODEMP, ';
  strSQL := strSQL + '                        A.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS >= 5000, DET_QTDITE, 0.00) AS QTDSAI, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS  < 5000, DET_QTDITE, 0.00) AS QTDENT ';
  strSQL := strSQL + '                      FROM ';
  strSQL := strSQL + '                        MOVDET ';
  strSQL := strSQL + '                        JOIN CADITE A ON A.ITE_CODITE = DET_CODITE ';
  strSQL := strSQL + '                        JOIN ITEGER B ON B.ITE_CODITE = DET_CODITE AND B.ITE_CODEMP = :CODEMP ';
  strSQL := strSQL + '                      WHERE DET_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '                        DET_ESPDOC IN ("NF","IF") AND ';
  strSQL := strSQL + '                        DET_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '                        A.ITE_CODFOR = :CODFOR ';

  { * "NOTDET" NÃO MOVIMENTA ESTOQUE
  strSQL := strSQL + '                      UNION ALL ';
  strSQL := strSQL + '                      SELECT DISTINCT SQL_NO_CACHE ';
  strSQL := strSQL + '                        DET_NUMDOC, DET_ESPDOC, DET_CODEMP, ';
  strSQL := strSQL + '                        A.ITE_CODITE AS CODITE, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS >= 5000, DET_QTDITE, 0.00) AS QTDSAI, ';
  strSQL := strSQL + '                        IF(DET_CLAFIS  < 5000, DET_QTDITE, 0.00) AS QTDENT ';
  strSQL := strSQL + '                      FROM ';
  strSQL := strSQL + '                        NOTDET ';
  strSQL := strSQL + '                        JOIN CADITE A ON A.ITE_CODITE = DET_CODITE ';
  strSQL := strSQL + '                        JOIN ITEGER B ON B.ITE_CODITE = DET_CODITE AND B.ITE_CODEMP = :CODEMP ';
  strSQL := strSQL + '                      WHERE DET_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '                        DET_ESPDOC IN ("NF","IF") AND ';
  strSQL := strSQL + '                        DET_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '                        A.ITE_CODFOR = :CODFOR ';
  }

  strSQL := strSQL + '       ) D ON D.CODITE = I.ITE_CODITE ';
  strSQL := strSQL + ' WHERE I.ITE_CODFOR = :CODFOR) AS TAB ';
  strSQL := strSQL + ' GROUP BY CODITE ';
  Result := strSQL;
end;


