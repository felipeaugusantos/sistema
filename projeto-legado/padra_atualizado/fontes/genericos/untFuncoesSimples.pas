procedure pSetCxControlsScrollbarModeClassic(AWinControl: TWinControl);
Var
  I: Integer;
begin
  For I := 0 To AWinControl.ControlCount -1 Do
  Begin
    If AWinControl.Controls[I] Is TcxControl Then
      TcxControlHack(AWinControl.Controls[I]).LookAndFeel.ScrollbarMode := sbmClassic;
    If AWinControl.Controls[I] Is TcxContainer Then
      TcxContainerHack(AWinControl.Controls[I]).Style.LookAndFeel.ScrollbarMode := sbmClassic;
    If AWinControl.Controls[I] Is TWinControl Then
      pSetCxControlsScrollbarModeClassic(TWinControl(AWinControl.Controls[I]));
  End;
end;

procedure pSetFocus(SenderUnico: TWinControl; Form: TCustomForm = nil);
begin
  If Not Assigned(SenderUnico) Then
    Exit;

  If ((GetKeyState(VK_SHIFT) And 128) = 128) And
     ((GetKeyState(VK_TAB) And 128) = 128) Then
    Exit;

  Try
    if Form = Nil then
      Form := GetParentForm(SenderUnico);

    If (Form <> nil) And (Form.CanFocus) And SenderUnico.CanFocus Then
    Begin
      Try
        SenderUnico.SetFocus;

        if (SenderUnico is TCustomCheckBox) or (SenderUnico is TCustomCombo) then
          SenderUnico.Perform(WM_UPDATEUISTATE, MakeWParam(UIS_CLEAR, UISF_HIDEFOCUS), 0);

      Except

      End;
    End;
  Except

  End;
end;

