Function fCalculaPrecoMedio(strCodFis,
                            strClaFis: String;
                            fltPreMed,
                            fltSaldos,
                            fltQtdNov,
                            fltUniNov,
                            fltAlqIcm,
                            fltValIpi: Double;
                            fltValRet,
                            fltValAnt,
                            fltValGnre,
                            fltValTCIF,
                            fltValTS: Double;
                            blnContribuinteIpi,
                            blnFornecedorFilial: Boolean;
                            strIncPis: String;
                            fltValFre: Double;
                            fltValorOutrasDespesas: Double;
                            fltValIcm: Double;
                            fltValIcmNaoCreditado: Double;
                            fltFundoCombatePobreza: Double;
                            fltAliquotaFrete: Double;
                            CalculoPrecoMediAgrup:TCalculoPrecoMediAgrup;
                            blnIpiNaoCreditado: Boolean): Double;

var CalculoPreMed: TCalculoPreMedAgrup;
Begin
  If Assigned(CalculoPrecoMediAgrup) Then
  Begin
    CalculoPreMed := CalculoPrecoMediAgrup.CalculoPreMed[CalculoPrecoMediAgrup.strCodIteAtual, CalculoPrecoMediAgrup.strSeqGerAtual];
    If CalculoPreMed.blnEncontrado Then
    Begin
      fltPreMed := CalculoPreMed.PrecoMedioAnterior;
      fltSaldos := CalculoPreMed.SaldoAnterior;
    End
    Else
      CalculoPreMed.SaldoAnterior := fltSaldos;
  End;


  TCalculoPrecoMedio.fGetPreMed(TConfiguracao.fGetConfiguracao).
    CstIcms(strCodFis).
    ClassificaoFiscal(strClaFis).
    PrecoMedio(fltPreMed).
    Saldo(fltSaldos).
    NovaQuantidade(fltQtdNov).
    NovoUnitario(fltUniNov).
    AliquotaIcms(fltAlqIcm).
    ValorIpi(fltValIpi).
    ValorRetido(fltValRet).
    IcmsAntecipado(fltValAnt).
    ContribuinteIPI(blnContribuinteIpi).
    IncidePIS(strIncPis='S').
    FornecedorFilial(blnFornecedorFilial).
    Frete(fltValFre).
    ValorGNRE(fltValGnre).
    ValorICMS(fltValIcm).
    ValorICMSNaoCreditado(fltValIcmNaoCreditado).
    fValorTCIF(fltValTCIF).
    fValorTS(fltValTS).
    ValorFundoCombateAPobreza(fltFundoCombatePobreza).
    AliquotaFrete(fltAliquotaFrete).
    ValorOutrasDespesas(fltValorOutrasDespesas).
    IpiNaoCreditado(blnIpiNaoCreditado);

  Result := TCalculoPrecoMedio.fGetPreMed(TConfiguracao.fGetConfiguracao).fPrecoMedio;
  If Assigned(CalculoPrecoMediAgrup) Then
  Begin
    CalculoPreMed.SaldoAnterior := CalculoPreMed.SaldoAnterior + fltQtdNov;
    CalculoPreMed.PrecoMedioAnterior := Result;
    CalculoPrecoMediAgrup.pAdd(CalculoPreMed);
  End;

End;

procedure pPegaDocumentoEntregaFutura(strNumDoc, strEspDoc, strCodEmp: string;
                                    Var strDocFut, strEspFut, strEmpFut: string;
                                    strCodAca: String = ''; strEmpAca: String = '');

  Var
    qryDocFut : TUniQuery;
    intCnt    : Integer;
begin
  strDocFut := '';
  strEspFut := '';
  strEmpFut := '';
  qryDocFut := fCriaQuery(Nil);

  If fEhDocumentoBaixaEntregaFutura(strNumDoc, strEspDoc, strCodEmp) then
  begin
    For intCnt := 1 To 2 Do
    Begin
      With qryDocFut Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT DET_DOCFUT, DET_ESPFUT, DET_EMPFUT ');
        SQL.Add('   FROM MOVDET ' );
        SQL.Add('  WHERE DET_NUMDOC = :NUMDOC ');
        SQL.Add('    AND DET_ESPDOC = :ESPDOC ');
        SQL.Add('    AND DET_CODEMP = :CODEMP ');

        If (Not fEmptyStr(strCodAca)) And (Not fEmptyStr(strEmpAca)) Then
        Begin
          SQL.Add('    AND DET_CODACA = :CODACA ');
          SQL.Add('    AND DET_EMPACA = :EMPACA ');
        End;

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;

        If (Not fEmptyStr(strCodAca)) And (Not fEmptyStr(strEmpAca)) Then
        Begin
          ParamByName('CODACA').AsString := strCodAca;
          ParamByName('EMPACA').AsString := strEmpAca;
        End;

        Open;

        If Not fEmptyStr(FieldByName('DET_DOCFUT').AsString) Then
        Begin
          strDocFut := FieldByName('DET_DOCFUT').AsString;
          strEspFut := FieldByName('DET_ESPFUT').AsString;
          strEmpFut := FieldByName('DET_EMPFUT').AsString;
          Break;
        End;
      End;
    End;
    qryDocFut.Close;
  End;

  FreeAndNil(qryDocFut);
end;

