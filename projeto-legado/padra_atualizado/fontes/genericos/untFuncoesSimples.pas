procedure pCarregaTotalReformaPedido(const AAutoincrementoFatGor: String; out AValCbs, AValIbs, AVal_Is: Double);
  Var
    LQuery: TUniQuery;
begin
  // Total de CBS, IBS e IS do pedido, somado da FDOREF dos itens (o FATGOR nao guarda)
  AValCbs := 0;
  AValIbs := 0;
  AVal_Is := 0;

  If Not fSomarNovosImpostosDaReformaAoValorContabil Then
    Exit;

  If fEmptyStr(AAutoincrementoFatGor) Then
    Exit;

  LQuery := fCriaQuery;
  Try
    LQuery.SQL.Add('SELECT IFNULL(SUM(R.REF_CBSVAL), 0) AS VALCBS, ');
    LQuery.SQL.Add('       IFNULL(SUM(R.REF_VALIBS), 0) AS VALIBS, ');
    LQuery.SQL.Add('       IFNULL(SUM(R.REF_SELVAL), 0) AS VAL_IS ');
    LQuery.SQL.Add('FROM FATDOR D ');
    LQuery.SQL.Add('  JOIN FDOREF R ON R.REF_SEQFDO = D.AUTOINCREM ');
    LQuery.SQL.Add('WHERE D.FDO_SEQGER = :SEQGER ');
    LQuery.ParamByName('SEQGER').AsString := AAutoincrementoFatGor;
    LQuery.Open;

    AValCbs := LQuery.FieldByName('VALCBS').AsFloat;
    AValIbs := LQuery.FieldByName('VALIBS').AsFloat;
    AVal_Is := LQuery.FieldByName('VAL_IS').AsFloat;
  Finally
    FreeAndNil(LQuery);
  End;
end;

