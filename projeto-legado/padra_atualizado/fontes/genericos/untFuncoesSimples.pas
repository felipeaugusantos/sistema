Function fTestaCNPJNumerico(xCGC: String):Boolean;
Var
  d1,d4,xx,nCount,fator,resto,digito1,digito2 : Integer;
  Check : String;
begin
  d1 := 0;
  d4 := 0;
  xx := 1;
  For nCount := 1 To Length( xCGC )-2 Do
  Begin
    If Pos( Copy( xCGC, nCount, 1 ), '/-.' ) = 0 Then
    Begin
      If xx < 5 Then
      Begin
        fator := 6 - xx;
      End
      Else
      Begin
        fator := 14 - xx;
      End;
      d1 := d1 + StrToIntDef( Copy( xCGC, nCount, 1 ), 0) * fator;
      If xx < 6 Then
      Begin
        fator := 7 - xx;
      End
      Else
      Begin
        fator := 15 - xx;
      End;
      d4 := d4 + StrToIntDef( Copy( xCGC, nCount, 1 ), 0) * fator;
      xx := xx+1;
    End;
  End;

  resto := (d1 mod 11);
  If resto < 2 then
  Begin
    digito1 := 0;
  End
  Else
  Begin
    digito1 := 11 - resto;
  End;

  d4 := d4 + 2 * digito1;
  resto := (d4 mod 11);

  If resto < 2 then
  Begin
    digito2 := 0;
  End
  Else
  Begin
    digito2 := 11 - resto;
  End;

  Check := IntToStr(Digito1) + IntToStr(Digito2);
  If Check <> copy(xCGC,succ(length(xCGC)-2),2) Then
  Begin
    Result := False;
  End
  Else
  Begin
    Result := True;
  End;
end;

Function fTestaCNPJAlfaNumerico(xCGC: String):Boolean;
var
  Limpo, Base12, DVInformado: string;
  DV1, DV2: Integer;
  I: Integer;

  function IsLetterOrDigitChar(C: Char): Boolean;
  begin
    Result := CharInSet(C, ['0'..'9','A'..'Z','a'..'z']);
  end;

  function CharToCNPJValue(C: Char): Integer;
  begin
    C := UpCase(C);

    If CharInSet(C, ['0'..'9']) Then
      Result := Ord(C) - Ord('0')
    Else If CharInSet(C, ['A'..'Z']) Then
      Result := Ord(C) - 48
    Else
      raise Exception.CreateFmt('Caractere inválido no CNPJ: %s', [C]);
  end;

  function CalcularDV(const Base: string): Integer;
  var
    I, Soma, Valor, Peso: Integer;
  begin
    Soma := 0;
    Peso := 2;

    for I := Length(Base) downto 1 do
    begin
      Valor := CharToCNPJValue(Base[I]);
      Soma := Soma + Valor * Peso;
      Inc(Peso);

      if Peso > 9 then
        Peso := 2;
    end;

    Soma := Soma mod 11;

    if (Soma = 0) or (Soma = 1) then
      Result := 0
    else
      Result := 11 - Soma;
  end;

begin
  Limpo := '';
  for I := 1 to Length(xCGC) do
    if IsLetterOrDigitChar(xCGC[I]) then
      Limpo := Limpo + xCGC[I];

  Limpo := UpperCase(Limpo);

  if Length(Limpo) <> 14 then
    Exit(False);

  Base12 := Copy(Limpo, 1, 12);
  DVInformado := Copy(Limpo, 13, 2);

  DV1 := CalcularDV(Base12);
  DV2 := CalcularDV(Base12 + IntToStr(DV1));

  Result := DVInformado = IntToStr(DV1) + IntToStr(DV2);
End;

{*********************************}
{* VALIDA CPF                    *}
{*********************************}
function fValidaCPF(sCPF: string):Boolean;
var
   sDigs, sVal  : string;
   iSTot, iSTot2: integer;
   i: integer;
begin
  Result := False;
  sCPF   := Trim(AnsiReplaceText(sCPF, '.', ''));
  sCPF   := Trim(AnsiReplaceText(sCPF, '-', ''));
  iSTot  := 0;
  iSTot2 := 0;
  If Length(sCPF) = 11 Then
  begin
    For i := 9 Downto 1 Do
    Begin
      iSTot  := iSTot  + StrToIntDef(Copy(sCPF,i,1),0) * (11-i);
      iSTot2 := iSTot2 + StrToIntDef(Copy(sCPF,i,1),0) * (12-i);
    End;
    iSTot  := iSTot Mod 11;
    sDigs  := sDigs + IntToStr(iif(iSTot < 2, 0, 11-iSTot));

    iSTot2 := iSTot2 + 2*StrToIntDef(sDigs,0);
    isTot2 := iSTot2 Mod 11;
    sDigs  := sDigs + IntToStr(iif(iSTot2 < 2, 0, 11-iSTot2));

    sVal   := Copy(sCPF,10,2);
    Result := sDigs = sVal;
  End;
end;

{*****************************************}
{* VERIFICA SE O CNPJ JÁ ESTÁ CADASTRADO *}
{**************************************AF*}
function fExisteCnpjCpf(strTabela, strCamExe, strCodExe, strCampo, strCodigo, strEstado: String; strCodEmp: String = ''; AWhere: String = ''): Boolean;
  Var
    strSQL   : String;
    qryGenTmp: TUniQuery;

Begin
  Try

    Result := False;

    If (strEstado = 'EX') Then
      Exit;

    qryGenTmp := fCriaQuery;

    If Not fEmptyStr(strCodigo) Then
    Begin

      strSQL := '';
      strSQL := strSQL + ' SELECT ';
      strSQL := strSQL + '   T1.* ';

      If Not fEmptyStr(strCodEmp) Then
        strSQL := strSQL + ',  T2.CLI_CODEMP ';

      strSQL := strSQL + ' FROM ';
      strSQL := strSQL + strTabela + ' T1 ';

      If Not fEmptyStr(strCodEmp) Then
        strSQL := strSQL + ',  CADCLI T2 ';

      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + 'T1.' + strCampo  + '  = :CODIGO AND ';
      strSQL := strSQL + 'T1.' + strCamExe + ' <> :CODEXE ';

      If Not fEmptyStr(strCodEmp) Then
      Begin
        strSQL := strSQL + '  AND T1.' + strCamExe + ' = T2.CLI_CODCLI ';
        strSQL := strSQL + '  AND T2.CLI_CODEMP = ' + QuotedStr(strCodEmp);
      End;

      If Not fEmptyStr(AWhere) Then
       strSQL := strSQL +  AWhere;

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODIGO').AsString := strCodigo;
        ParamByName('CODEXE').AsString := strCodExe;
        Open;

        If Not IsEmpty Then
        Begin

          If Pos(fCfgSis('VERCGC'),'A_T_L_') > 0 Then
          Begin
            If fCfgSis('VERCGC') <> 'L' Then
              fMensagem('','Já existe um CNPJ/CPF com esse numero cadastrado!',['&OK']);

            If Pos(fCfgSis('VERCGC'),'T_L_') > 0 Then
              Result := True;
          End;

        End;

        Close;
      End;

    End;

  Finally
    FreeAndNil(qryGenTmp);
  End;

End;

{*****************************************}
{* VALIDA A INSCRIÇÃO ESTADUAL           *}
{**************************************MV*}
function fValidaIES(strIES, strEstado: String): Boolean;
  Var
    intContador : Integer;
    intValG     : Integer;
    intVSom     : Integer;
    intVRes     : Integer;
    intVPro     : Integer;
    intP        : Integer;
    intD        : Integer;
    intN        : Integer;
    intMod      : Integer;
    strVDig1    : String;
    strVDig2    : String;
    strVBase    : String;
    strVBase2   : String;
    strBase     : String;
    strOrigem   : String;
    strMascara  : String;
    strVSom     : String;
    arrVMul     : Array Of Integer;
begin
  strVBase   := '';
  strBase    := '';
  strOrigem  := '';
  strMascara := '99999999999999';

  intP := 0;
  intD := 0;
  Result := False;
  If fEmptyStr(strIES) Then
  Begin
    Result := True;
    Exit;
  End;

  For intContador := 1 To Length(Trim(strIES)) Do
  Begin
    If Pos(strIES[intContador], '0123456789P') > 0 Then
      strOrigem := strOrigem + strIES[intContador];
  End;

  If (strEstado <> 'SP') And (LeftStr(strOrigem, 1) = 'P') Then
  Begin
    Result := TRUE;
    Exit;
  End;

  If strEstado = 'AC' Then
  Begin
    strMascara := '999,99999,999-99';
    strOrigem  := fPadL(strOrigem, 13, '0');
    strBase    := strOrigem;

    intVSom := 0;
    SetLength(arrVMul, 12);
    arrVMul := VarArrayOf([4,3,2,9,8,7,6,5,4,3,2]);
    For intContador := 0 To 10 Do
    Begin
      intValG := StrToIntDef(strBase[intContador+1],0);
      intValG := intValG * arrVMul[intContador];
      intVSom := intVSom + intValG;
    End;

