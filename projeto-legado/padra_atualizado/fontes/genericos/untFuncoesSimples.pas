function fExisteVinculoIntegracoes(AStrCodIte: String; ABlnTransfCod: Boolean = False): Boolean;
var
  blnInTransaction: Boolean;
  strTabela: String;
  qryExcIte : TUniQuery;
begin
  Result := False;
  blnInTransaction := frmModulo.DataBase.InTransaction;

  qryExcIte := fCriaQuery;

  Try
    qryExcIte.Close;
    qryExcIte.SQL.Clear;
    qryExcIte.SQL.Add('SELECT ');
    qryExcIte.SQL.Add('  EXC_DESTAB, ');
    qryExcIte.SQL.Add('  EXC_DESCMP, ');
    qryExcIte.SQL.Add('  EXC_DESEMP ');
    qryExcIte.SQL.Add('FROM EXCITE ');
    qryExcIte.SQL.Add('  ORDER BY EXC_DESTAB ');
    qryExcIte.Open;
    qryExcIte.First;
    While not qryExcIte.Eof Do
    begin
      If fTabelaExiste(qryExcIte.FieldByname('EXC_DESTAB').AsString) Then
      begin
        If Not fEmptyStr(fCampoTabela(qryExcIte.FieldByname('EXC_DESCMP').AsString,
                                      qryExcIte.FieldByname('EXC_DESTAB').AsString,
                                      [qryExcIte.FieldByname('EXC_DESCMP').AsString, qryExcIte.FieldByname('EXC_DESEMP').AsString],
                                      [AStrCodIte, VS_StrCodEmp])) Then
        Begin
          strTabela := qryExcIte.FieldByname('EXC_DESTAB').AsString;
          Result := True;
          Break;
        End;
      end;

      qryExcIte.Next;
    end;
  Finally
    FreeAndNil(qryExcIte);
  End;

  If Result Then
  Begin
    If blnInTransaction Then
      fRollBack;
    pMensagemOk('Este produto está vinculado em anúncio de venda online ( ' + strTabela +' ) e não será possível ' + IIF(Not ABlnTransfCod, ' excluir!','utilizar na transferência!'));
  End;
End;

function fGetVersaoAutcom: String;
var
