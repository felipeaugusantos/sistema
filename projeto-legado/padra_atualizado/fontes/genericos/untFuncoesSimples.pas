{ TTransactionLog }

procedure TTransactionLog.LogCommit(const AConn: IConnection);
var
  LIdenti: string;
  LSL: TStringList;
begin
  if not Self.Enabled then
    Exit;

  FSemaphore.Enter;
  try
    if not FDicThreads.ContainsKey(GetCurrentThreadId) then
      Exit;

    LSL := FDicThreads[GetCurrentThreadId];

    if LSL.Count = 0 then
      Exit;

    LIdenti := LSL[LSL.Count-1];

    LSL.Delete(LSL.Count-1);

    pApagarLogTransacao(LIdenti, opCommit, AConn);
  finally
    FSemaphore.Leave;
  end;
end;

procedure TTransactionLog.LogRollback(const AConn: IConnection);
var
  LIdenti: string;
  LSL: TStringList;
begin
  if not Self.Enabled then
    Exit;

  FSemaphore.Enter;
  try
    if not FDicThreads.ContainsKey(GetCurrentThreadId) then
      Exit;

    LSL := FDicThreads[GetCurrentThreadId];

    if LSL.Count = 0 then
      Exit;

    LIdenti := LSL[LSL.Count-1];

    LSL.Delete(LSL.Count-1);

    pApagarLogTransacao(LIdenti, opRollback, AConn);
  finally
    FSemaphore.Leave;
  end;
end;

{ Compatibilidade com unit Contabilidade.FuncoesFormPai }
procedure TTransactionLog.Add(AIdenti: string);
var
  LSL: TStringList;
begin
  FSemaphore.Enter;
  try
    if not FDicThreads.ContainsKey(GetCurrentThreadId) then
      FDicThreads.Add(GetCurrentThreadId, TStringList.Create);

    LSL := FDicThreads[GetCurrentThreadId];

    LSL.Add(AIdenti);
  finally
    FSemaphore.Leave;
  end;
end;

procedure TTransactionLog.LogStart(const AConn: IConnection);
var
  LIdenti: string;
  LInfo: string;
  LSL: TStringList;
begin
  if not Self.Enabled then
    Exit;

  FSemaphore.Enter;
  try
    if not FDicThreads.ContainsKey(GetCurrentThreadId) then
      FDicThreads.Add(GetCurrentThreadId, TStringList.Create);

    LSL := FDicThreads[GetCurrentThreadId];

    LIdenti := FormatDateTime('dd/mm/yyyy hh:nn:ss', fNow());

    LSL.Add(LIdenti);

    if TSafeThread.Connections.HasThreadConnection(GetCurrentThreadId) then
      LInfo := TSafeThread.Connections.GetThreadConnectionInfo(GetCurrentThreadId)
    else
      LInfo := fGetNomeFormularios;

    pGravarLogTransacao(LIdenti, AConn, LInfo);
  finally
    FSemaphore.Leave;
  end;
end;

procedure TTransactionLog.SetEnabled(const Value: Boolean);
begin
  FSemaphore.Enter;
  try
    FDicEnabled.AddOrSetValue(GetCurrentThreadId, Value);
  finally
    FSemaphore.Leave;
  end;
end;

procedure TTransactionLog.UpdateStack(AThreadID: Cardinal; AStackInfo: string);
var
  LIdenti: string;
  LSL: TStringList;
begin
  FSemaphore.Enter;
  try
    if not FDicThreads.ContainsKey(AThreadID) then
      Exit;

    LSL := FDicThreads[AThreadID];

    for LIdenti in LSL do
      pAtualizarLogTransacao(LIdenti, AStackInfo, 0, 0, TUnidacConnection.Create);
  finally
    FSemaphore.Leave;
  end;
end;

function TTransactionLog.GetCount(AThreadID: Cardinal): Integer;
begin
  FSemaphore.Enter;
  try
    Result := 0;
    if FDicThreads.ContainsKey(AThreadID) then
      Result := FDicThreads[AThreadID].Count;
  finally
    FSemaphore.Leave;
  end;
end;

function TTransactionLog.GetEnabled: Boolean;
begin
  FSemaphore.Enter;
  try
    if not FDicEnabled.ContainsKey(GetCurrentThreadId) then
      FDicEnabled.Add(GetCurrentThreadId, True);
    Result := FDicEnabled[GetCurrentThreadId];
  finally
    FSemaphore.Leave;
  end;
end;

constructor TTransactionLog.Create;
begin
  FDicThreads := TDictionary<Cardinal, TStringList>.Create;
  FDicEnabled := TDictionary<Cardinal, Boolean>.Create;
  FSemaphore  := TCriticalSection.Create;
end;

destructor TTransactionLog.Destroy;
begin
  FreeAndNil(FDicThreads);
  FreeAndNil(FDicEnabled);
  FreeAndNil(FSemaphore);
  inherited;
end;

{ TSafeCommit }

class procedure TSafeCommit.Add(AConn: TUniConnection; ACommitID: Int64);
var
  LInfo: TSafeCommitInfo;
begin
  if not blnCheckRemainsInTransaction then
    if not blnCheckCommitPermission then
      Exit;

  FSemaphore.Enter;
  try
    if not FConnections.ContainsKey(AConn) then
    begin
      LInfo.CommitID := ACommitID;
      LInfo.MySQLConnID := GetMySQLConnID(AConn);
      LInfo.MySQLThreadID := GetMySQLThreadID(AConn);
      LInfo.MySQLMajorVersion := GetMySQLMajorVersion(AConn);
      FConnections.Add(AConn, LInfo);
    end;
  finally
    FSemaphore.Leave;
  end;
end;

class procedure TSafeCommit.CheckRemainsInTransaction(AConn: TUniConnection);
const
  LErrorMsg = 'A [%d] conexão não está mais em transação!' + #13#10 + 'Ligue imediatamente para a Citel.';
var
  LInfo: TSafeCommitInfo;
begin
  if not blnCheckRemainsInTransaction then
    Exit;

  FSemaphore.Enter;
  try
    if FConnections.Count = 0 then Exit;

    if not FConnections.TryGetValue(AConn, LInfo) then
      Exit;

    if Self.GetMYSQLInTransaction(AConn) then
      Exit;

    try
      InsertLogErr(Format(LErrorMsg, [LInfo.MySQLConnID]), fRetornaStack, TfrmModulo.GetMYSQLStatementsHistory(AConn));
    finally
      raise ESafeCommitException.Create(Format(LErrorMsg, [LInfo.MySQLConnID]));
    end;
  finally
    FSemaphore.Leave;
  end;
end;

class function TSafeCommit.GetMySQLConnID(AConn: TUniConnection): Int64;
Var
  LQry: TUniQuery;
begin
  LQry := TUniQuery.Create(nil);
  Try
    LQry.Connection := AConn;
    LQry.SQL.Add('SELECT CONNECTION_ID()');
    LQry.Open;
    Result := LQry.Fields[0].AsLargeInt;
  Finally
    FreeAndNil(LQry);
  End;
end;

class function TSafeCommit.GetMYSQLInTransaction(AConn: TUniConnection): Boolean;
Var
  LQry: TUniQuery;
  LInfo: TSafeCommitInfo;
begin
  if not blnCheckRemainsInTransaction then
    Exit(AConn.InTransaction);

  if not FConnections.TryGetValue(AConn, LInfo) then
    Exit(AConn.InTransaction);

  if LInfo.MySQLMajorVersion < 8 then
    Exit(AConn.InTransaction);

  LQry := TUniQuery.Create(nil);
  try
    try
      LQry.Connection := AConn;
      LQry.SQL.Add('SELECT ');
      LQry.SQL.Add('  NESTING_EVENT_TYPE ');
      LQry.SQL.Add('FROM ');
      LQry.SQL.Add('  performance_schema.events_statements_current h ');
      LQry.SQL.Add('WHERE CURRENT_SCHEMA = DATABASE() ');
      LQry.SQL.Add('  AND THREAD_ID = ' + LInfo.MySQLThreadID.ToString + ' ');
      LQry.SQL.Add('ORDER BY EVENT_ID DESC LIMIT 1; ');
      LQry.Open;
      if LQry.IsEmpty Then
        Result := AConn.InTransaction
      else
        Result := LQry.Fields[0].AsString = 'TRANSACTION';
    except
      Result := AConn.InTransaction;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

class function TSafeCommit.GetMySQLMajorVersion(AConn: TUniConnection): Integer;
Var
  LQry: TUniQuery;
begin
  LQry := TUniQuery.Create(nil);
  Try
    LQry.Connection := AConn;
    LQry.SQL.Add('SELECT SUBSTRING_INDEX(@@VERSION, ".", 1);');
    LQry.Open;
    if LQry.IsEmpty Then
      Result := 0
    else
      Result := LQry.Fields[0].AsInteger;
  Finally
    FreeAndNil(LQry);
  End;
end;

class function TSafeCommit.GetMySQLThreadID(AConn: TUniConnection): Int64;
Var
  LQry: TUniQuery;
begin
  LQry := TUniQuery.Create(nil);
  Try
    LQry.Connection := AConn;
    LQry.SQL.Add('SELECT ');
    LQry.SQL.Add('  THREAD_ID ');
    LQry.SQL.Add('FROM ');
    LQry.SQL.Add('  performance_schema.threads ');
    LQry.SQL.Add('WHERE PROCESSLIST_ID = CONNECTION_ID() ');
    LQry.Open;
    if LQry.IsEmpty Then
      Result := 0
    else
      Result := LQry.Fields[0].AsLargeInt;
  Finally
    FreeAndNil(LQry);
  End;
end;

class procedure TSafeCommit.CheckCommitPermission(AConn: TUniConnection; ACommitID: Int64);
const
  LErrorMsg = 'A conexão [%d] não tem permissão para executar o commit neste momento!' + #13#10 + 'Ligue imediatamente para a Citel.';
var
  LInfo: TSafeCommitInfo;
begin
  if not blnCheckCommitPermission then
    Exit;

  FSemaphore.Enter;
  try
    if FConnections.Count = 0 then Exit;

    if not FConnections.TryGetValue(AConn, LInfo) then
      Exit;

    if not AConn.InTransaction then
      Exit;

    if LInfo.CommitID = ACommitID then
      Exit;

    try
      InsertLogErr(Format(LErrorMsg, [LInfo.MySQLConnID]), fRetornaStack, TfrmModulo.GetMYSQLStatementsHistory(AConn));
    finally
      raise ESafeCommitException.Create(Format(LErrorMsg, [LInfo.MySQLConnID]));
    end;
  finally
    FSemaphore.Leave;
  end;
end;

class procedure TSafeCommit.Remove(AConn: TUniConnection);
begin
  if not blnCheckRemainsInTransaction then
    if not blnCheckCommitPermission then
      Exit;

  FSemaphore.Enter;
  try
    if FConnections.Count = 0 then
      Exit;
    if FConnections.ContainsKey(AConn) then
      FConnections.Remove(AConn);
  finally
    FSemaphore.Leave;
  end;
end;

class procedure TSafeCommit.InsertLogErr(const AMessage, AReport, ALastSQL: string);
var
  LConn: TCriarConexao;
begin
  LConn := TCriarConexao.Create('TSafeCommit.InsertLogErr - ' + AMessage + '-' + AReport);
  Try
    pGravarErro(True, AMessage, AReport, ALastSQL, LConn.objConexao);
  Finally
    FreeAndNil(LConn);
  End;
end;

