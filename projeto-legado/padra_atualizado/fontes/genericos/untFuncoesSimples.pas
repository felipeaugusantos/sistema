Function fAtualizaSaldoReservado(cdsItensGiro, cdsItensSintetico: TUniClientDataSet; pgbProgresso: TcxProgressBar; blnEmbala: Boolean): Boolean;
  Var
    qryCadUni: TUniQuery;
    fltTotIte,
    fltTotIpi,
    fltTotSub,
    fltPesoIt: Double;

    strCodIte: String;
    strIndex,
    strFilter: String;
    blnFiltered: Boolean;
    blnCnvEma: Boolean;

    pAfterScrollSint,
    pAfterPostGiro,
    pAfterPostSint: TDataSetNotifyEvent;

    Procedure pZeraDadosSintetico(strCodIte: String);
    Begin
      With cdsItensSintetico Do
      Begin

        If Locate('ITE_CODITE', strCodIte, []) Then
        Begin
          Edit;
          FieldByName('ITE_QTDITE').AsFloat := 0;
          FieldByName('ITE_TOTITE').AsFloat := 0;
          FieldByName('ITE_TOTIPI').AsFloat := 0;
          FieldByName('ITE_TOTSUB').AsFloat := 0;
          FieldByName('ITE_PESOIT').AsFloat := 0;
          FieldByName('ITE_LITROS').AsFloat := 0;

          FieldByName('ITE_UNITAR').AsFloat  := cdsItensGiro.FieldByName('ITE_UNITAR').AsFloat;
          FieldByName('ITE_UNILIQ').AsFloat  := cdsItensGiro.FieldByName('ITE_UNILIQ').AsFloat;
          FieldByName('ITE_CODUNI').AsString := cdsItensGiro.FieldByName('ITE_CODUNI').AsString;
          FieldByName('ITE_SIGUNI').AsString := cdsItensGiro.FieldByName('ITE_SIGUNI').AsString;

          Post;
        End;

      End;
    End;

Begin
  Try
    fltTotIte := 0;
    fltTotIpi := 0;
    fltTotSub := 0;
    fltPesoIt := 0;

    blnCnvEma := fCfgSis('CNVEMA', varBoolean);

    qryCadUni := fCriaQuery;
    qryCadUni.SQL.Add('SELECT UNI_CODUNI, UNI_SIGUNI, IFNULL(UNI_PESLIT, 0) AS UNI_PESLIT FROM CADITE');
    qryCadUni.SQL.Add('INNER JOIN CADUNI ON UNI_CODUNI = ITE_UNICOM');
    qryCadUni.SQL.Add('WHERE');
    qryCadUni.SQL.Add('  ITE_CODITE = :CODITE AND ITE_CODUNI <> ITE_UNICOM');

    With cdsItensGiro Do
    Begin
      DisableControls;

      pAfterPostGiro := cdsItensGiro.AfterPost;
      cdsItensGiro.AfterPost      := Nil;
      strFilter   := Filter;
      blnFiltered := Filtered;

      Filter      := 'ITE_CODUNI <> ITE_UNICOM';
      Filtered    := True;

      pgbProgresso.Properties.Max := RecordCount;
      pProcessMessages;

      First;

      While Not Eof Do
      Begin
        strCodIte := FieldByName('ITE_CODITE').AsString + FieldByName('ITE_CODEMP').AsString;

        Edit;

        FieldByName('ITE_CONVER').AsString := 'N';

        If blnEmbala And (FieldByName('ITE_EMBALA').AsFloat <> 0) Then
        Begin
          qryCadUni.Close;
          qryCadUni.ParambyName('CODITE').AsString := FieldByName('ITE_CODITE').AsString;
          qryCadUni.Open;

          If (Not qryCadUni.IsEmpty) And (FieldByName('ITE_CODUNI').AsString <> qryCadUni.FieldByName('UNI_CODUNI').AsString) Then
          Begin
            FieldByName('ITE_CONVER').AsString := 'S';

            If FieldByName('ITE_QTDITE').AsFloat > 0 Then
            Begin
              fltTotIte := FieldByName('ITE_TOTITE').AsFloat / FieldByName('ITE_QTDITE').AsFloat;
              fltTotIpi := FieldByName('ITE_TOTIPI').AsFloat / FieldByName('ITE_QTDITE').AsFloat;
              fltTotSub := FieldByName('ITE_TOTSUB').AsFloat / FieldByName('ITE_QTDITE').AsFloat;
              fltPesoIt := FieldByName('ITE_PESOIT').AsFloat / FieldByName('ITE_QTDITE').AsFloat;
            End;

            FieldByName('ITE_QTDEMB').AsFloat  := FieldByName('ITE_EMBALA').AsFloat;

            If blnCnvEma Then
              FieldByName('ITE_QTDITE').AsFloat  := Ceil(FieldByName('ITE_QTDITE').AsFloat / FieldByName('ITE_EMBALA').AsFloat)
            Else
              FieldByName('ITE_QTDITE').AsFloat  := RoundTo(FieldByName('ITE_QTDITE').AsFloat / FieldByName('ITE_EMBALA').AsFloat, -4);

            FieldByName('ITE_UNITAR').AsFloat  := FieldByName('ITE_UNITAR').AsFloat * FieldByName('ITE_EMBALA').AsFloat;
            FieldByName('ITE_UNILIQ').AsFloat  := FieldByName('ITE_UNILIQ').AsFloat * FieldByName('ITE_EMBALA').AsFloat;

            FieldByName('ITE_CODUNI').AsString := qryCadUni.FieldByName('UNI_CODUNI').AsString;
            FieldByName('ITE_SIGUNI').AsString := qryCadUni.FieldByName('UNI_SIGUNI').AsString;

            If FieldByName('ITE_QTDITE').AsFloat > 0 Then
            Begin
              FieldByName('ITE_TOTITE').AsFloat := fltTotIte * FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_EMBALA').AsFloat;
              FieldByName('ITE_TOTIPI').AsFloat := fltTotIpi * FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_EMBALA').AsFloat;
              FieldByName('ITE_TOTSUB').AsFloat := fltTotSub * FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_EMBALA').AsFloat;
              FieldByName('ITE_PESOIT').AsFloat := fltPesoIt * FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_EMBALA').AsFloat;

              FieldByName('ITE_LITROS').AsFloat := FieldByName('ITE_QTDITE').AsFloat * qryCadUni.FieldByName('UNI_PESLIT').AsFloat;
            End;

          End; {If Not qryCadUni.IsEmpty Then}

        End;

        Post;

        If strCodIte = FieldByName('ITE_CODITE').AsString + FieldByName('ITE_CODEMP').AsString Then
          Next;

        pgbProgresso.Position := pgbProgresso.Position + 1;
        pProcessMessages;

      End;

      Filter := strFilter;
      Filtered := blnFiltered;

      If blnEmbala And Assigned(cdsItensSintetico) Then
      Begin
        pAfterPostSint   := cdsItensSintetico.AfterPost;
        pAfterScrollSint := cdsItensSintetico.AfterScroll;

        cdsItensSintetico.AfterPost   := Nil;
        cdsItensSintetico.AfterScroll := Nil;

        strIndex    := IndexFieldNames;
        strFilter   := Filter;
        blnFiltered := Filtered;

        Filter          := 'ITE_CONVER = ' + QuotedStr('S');
        Filtered        := True;
        IndexFieldNames := 'ITE_CODITE';

        strCodIte := '';

        pgbProgresso.Position := 0;
        pgbProgresso.Properties.Max := RecordCount;
        pProcessMessages;

        First;
        While Not Eof Do
        Begin


          If strCodIte <> FieldByName('ITE_CODITE').AsString Then
          Begin
            strCodIte := FieldByName('ITE_CODITE').AsString;
            pZeraDadosSintetico(FieldByName('ITE_CODITE').AsString);
          End;

          If cdsItensSintetico.FieldByName('ITE_CODITE').AsString = FieldByName('ITE_CODITE').AsString Then
          Begin
            cdsItensSintetico.Edit;
            cdsItensSintetico.FieldByName('ITE_QTDITE').AsFloat := cdsItensSintetico.FieldByName('ITE_QTDITE').AsFloat + FieldByName('ITE_QTDITE').AsFloat;
            cdsItensSintetico.FieldByName('ITE_TOTITE').AsFloat := cdsItensSintetico.FieldByName('ITE_TOTITE').AsFloat + FieldByName('ITE_TOTITE').AsFloat;
            cdsItensSintetico.FieldByName('ITE_TOTIPI').AsFloat := cdsItensSintetico.FieldByName('ITE_TOTIPI').AsFloat + FieldByName('ITE_TOTIPI').AsFloat;
            cdsItensSintetico.FieldByName('ITE_TOTSUB').AsFloat := cdsItensSintetico.FieldByName('ITE_TOTSUB').AsFloat + FieldByName('ITE_TOTSUB').AsFloat;
            cdsItensSintetico.FieldByName('ITE_PESOIT').AsFloat := cdsItensSintetico.FieldByName('ITE_PESOIT').AsFloat + FieldByName('ITE_PESOIT').AsFloat;
            cdsItensSintetico.FieldByName('ITE_LITROS').AsFloat := cdsItensSintetico.FieldByName('ITE_LITROS').AsFloat + FieldByName('ITE_LITROS').AsFloat;

            cdsItensSintetico.FieldByName('ITE_QTDEMB').AsFloat := FieldByName('ITE_EMBALA').AsFloat;

            cdsItensSintetico.Post;
          End;

          Next;

          pgbProgresso.Position := pgbProgresso.Position + 1;
          pProcessMessages;
        End;

        Filter          := strFilter;
        Filtered        := blnFiltered;
        IndexFieldNames := strIndex;

        cdsItensSintetico.AfterPost   := pAfterPostSint;
        cdsItensSintetico.AfterScroll := pAfterScrollSint;
      End;

      cdsItensGiro.AfterPost := pAfterPostGiro;

      EnableControls;
    End;

    Result := True;

    FreeAndNil(qryCadUni);
  Except

    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[fAtualizaSaldoReservado]');
      Result := False;
    End;

  End;

End;


function fDllRegistrada(strPatchCompleto: String): Boolean;
Begin
  Result := fPegaListaRegistros(HKEY_CLASSES_ROOT, 'CLSID', strPatchCompleto);
End;

function fPegaListaRegistros(const aRoot: HKEY; const aPath: string; const strBusca: String): Boolean;
  Var
    lList: TStringList;
    liEntry: Integer;
begin

  Result := False;

  with TRegistry.Create do
  begin
    RootKey := aRoot;
    if OpenKey(aPath, False) then
    begin

      If (Pos('InprocServer32',aPath) > 0) Then
      Begin
        If AnsiUpperCase(strBusca) = AnsiUpperCase(ReadString('')) Then
          Result := True;
      End;

      If Not Result Then
      Begin
        lList := TStringList.Create;
        try
          GetKeyNames(lList);
          for liEntry := 0 to lList.Count-1 do
          begin

            If (Pos('InprocServer32',aPath) > 0) Then
            Begin
              If AnsiUpperCase(strBusca) = AnsiUpperCase(ReadString('')) Then
                Result := True;
            End;

            If Result Then Break;
            Result := fPegaListaRegistros(aRoot, aPath + '\' + lList[liEntry], strBusca);
            If Result Then Break;

          end;
        finally
          lList.Free;
        end;
      End;

    end;
    CloseKey;
  end;

End;

