procedure pGravaDelRetDet(strMotivo,
                          strDuplic: String;
                          Var strSeqGer: String);
Var
  strSQL: String;
  blnInseriu: Boolean;
  qryRetDet : TUniQuery;
  qrySelect : TUniQuery;
  qryUpdate : TUniQuery;
begin
  qryRetDet := fCriaQuery();
  qrySelect := fCriaQuery();
  qryUpdate := fCriaQuery();

  strSQL := '';
  strSQL := strSQL + 'SELECT * FROM RETDET ';
  strSQL := strSQL + 'WHERE DET_DUPLIC = :DUPLIC ';

  With qrySelect Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('DUPLIC').AsString   := strDuplic;
    Open;
  end;

  if qrySelect.RecordCount > 0 then
  begin
    strSeqGer := qrySelect.FieldByName('DET_SEQGER').AsString;

    strSQL := '';
    strSQL := strSQL + 'INSERT INTO DEL_RETDET ';
    strSQL := strSQL + '       (           ';
    strSQL := strSQL + '       DET_SEQGER, ';
    strSQL := strSQL + '       DET_DUPLIC, ';
    strSQL := strSQL + '       DET_NOSNUM, ';
    strSQL := strSQL + '       DET_DTACAD, ';
    strSQL := strSQL + '       DET_HORCAD, ';

    if qrySelect.FieldByName('DET_VALPAG').AsFloat > 0 Then
      strSQL := strSQL + '       DET_VALPAG, ';

    If qrySelect.FieldByName('DET_DTAPAG').AsDateTime <> 0 Then
      strSQL := strSQL + '       DET_DTAPAG, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_BCOPAG').AsString) then
      strSQL := strSQL + '       DET_BCOPAG, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_AGEPAG').AsString) Then
      strSQL := strSQL + '       DET_AGEPAG, ';

    If qrySelect.FieldByName('DET_DTARET').AsDateTime <> 0 Then
      strSQL := strSQL + '       DET_DTARET, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_OPERET').AsString) Then
      strSQL := strSQL + '       DET_OPERET, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_STSSER').AsString) Then
      strSQL := strSQL + '       DET_STSSER, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_CODOCO').AsString) Then
      strSQL := strSQL + '       DET_CODOCO, ';

    if qrySelect.FieldByName('DET_VALJUR').AsFloat > 0 Then
      strSQL := strSQL + '       DET_VALJUR, ';

    if qrySelect.FieldByName('DET_VALDES').AsFloat > 0 Then
      strSQL := strSQL + '       DET_VALDES, ';

    if qrySelect.FieldByName('DET_TARIFA').AsFloat > 0 Then
      strSQL := strSQL + '       DET_TARIFA, ';

    strSQL := strSQL + '       AUTOINCREM, ';
    strSQL := strSQL + '       OPEDEL,     ';
    strSQL := strSQL + '       DTADEL,     ';
    strSQL := strSQL + '       HORDEL,     ';
    strSQL := strSQL + '       MOTDEL)     ';
    strSQL := strSQL + '       VALUES (    ';
    strSQL := strSQL + '       :SEQGER,    ';
    strSQL := strSQL + '       :DUPLIC,    ';
    strSQL := strSQL + '       :NOSNUM,    ';
    strSQL := strSQL + '       :DTACAD,    ';
    strSQL := strSQL + '       :HORCAD,    ';

    if qrySelect.FieldByName('DET_VALPAG').AsFloat > 0 Then
      strSQL := strSQL + '       :VALPAG, ';

    If qrySelect.FieldByName('DET_DTAPAG').AsDateTime <> 0 Then
      strSQL := strSQL + '       :DTAPAG, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_BCOPAG').AsString) then
      strSQL := strSQL + '       :BCOPAG, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_AGEPAG').AsString) Then
      strSQL := strSQL + '       :AGEPAG, ';

    If qrySelect.FieldByName('DET_DTARET').AsDateTime <> 0 Then
      strSQL := strSQL + '       :DTARET, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_OPERET').AsString) Then
      strSQL := strSQL + '       :OPERET, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_STSSER').AsString) Then
      strSQL := strSQL + '       :STSSER, ';

    if Not fEmptyStr(qrySelect.FieldByName('DET_CODOCO').AsString) Then
      strSQL := strSQL + '       :CODOCO, ';

    if qrySelect.FieldByName('DET_VALJUR').AsFloat > 0 Then
      strSQL := strSQL + '       :VALJUR, ';

    if qrySelect.FieldByName('DET_VALDES').AsFloat > 0 Then
      strSQL := strSQL + '       :VALDES, ';

    if qrySelect.FieldByName('DET_TARIFA').AsFloat > 0 Then
      strSQL := strSQL + '       :TARIFA, ';

    strSQL := strSQL + '       :AUTOIN,    ';
    strSQL := strSQL + '       :OPEDEL,    ';
    strSQL := strSQL + '       :DATADEL,    ';
    strSQL := strSQL + '       :HORDEL,    ';
    strSQL := strSQL + '       :MOTDEL)    ';

    try
      With qryRetDet Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('AUTOIN').AsString   := qrySelect.FieldByName('AUTOINCREM').AsString;
        ParamByName('SEQGER').AsString   := qrySelect.FieldByName('DET_SEQGER').AsString;
        ParamByName('DUPLIC').AsString   := qrySelect.FieldByName('DET_DUPLIC').AsString;
        ParamByName('NOSNUM').AsString   := qrySelect.FieldByName('DET_NOSNUM').AsString;
        ParamByName('DTACAD').AsDateTime := qrySelect.FieldByName('DET_DTACAD').AsDateTime;
        ParamByName('HORCAD').AsDateTime := qrySelect.FieldByName('DET_HORCAD').AsDateTime;

        if qrySelect.FieldByName('DET_VALPAG').AsFloat > 0 Then
          ParamByName('VALPAG').AsFloat := qrySelect.FieldByName('DET_VALPAG').AsFloat;

        If qrySelect.FieldByName('DET_DTAPAG').AsDateTime <> 0 Then
          ParamByName('DTAPAG').AsDateTime := qrySelect.FieldByName('DET_DTAPAG').AsDateTime;

        if Not fEmptyStr(qrySelect.FieldByName('DET_BCOPAG').AsString) then
          ParamByName('BCOPAG').AsString := qrySelect.FieldByName('DET_BCOPAG').AsString;

        if Not fEmptyStr(qrySelect.FieldByName('DET_AGEPAG').AsString) Then
          ParamByName('AGEPAG').AsString := qrySelect.FieldByName('DET_AGEPAG').AsString;

        If qrySelect.FieldByName('DET_DTARET').AsDateTime <> 0 Then
          ParamByName('DTARET').AsDateTime := qrySelect.FieldByName('DET_DTARET').AsDateTime;

        if Not fEmptyStr(qrySelect.FieldByName('DET_OPERET').AsString) Then
          ParamByName('OPERET').AsString := qrySelect.FieldByName('DET_OPERET').AsString;

        if Not fEmptyStr(qrySelect.FieldByName('DET_STSSER').AsString) Then
          ParamByName('STSSER').AsString := qrySelect.FieldByName('DET_STSSER').AsString;

        if Not fEmptyStr(qrySelect.FieldByName('DET_CODOCO').AsString) Then
          ParamByName('CODOCO').AsString := qrySelect.FieldByName('DET_CODOCO').AsString;

        if qrySelect.FieldByName('DET_VALJUR').AsFloat > 0 Then
          ParamByName('VALJUR').AsFloat := qrySelect.FieldByName('DET_VALJUR').AsFloat;

        if qrySelect.FieldByName('DET_VALDES').AsFloat > 0 Then
          ParamByName('VALDES').AsFloat := qrySelect.FieldByName('DET_VALDES').AsFloat;

        if qrySelect.FieldByName('DET_TARIFA').AsFloat > 0 Then
          ParamByName('TARIFA').AsFloat := qrySelect.FieldByName('DET_TARIFA').AsFloat;

        ParamByName('OPEDEL').AsString     := strLoginUsuarioLogado;
        ParamByName('DATADEL').AsDateTime  := VS_Date;
        ParamByName('HORDEL').AsString     := FormatDateTime('hh:mm:ss', fTime());
        ParamByName('MOTDEL').AsString     := strMotivo;
        ExecSQL;
        Close;
        blnInseriu := True;
      end;

      //SE GRAVOU A DEL_RETDET DELETA A RETDET
      if blnInseriu then
      begin
        strSQL := '';
        strSQL := strSQL + 'DELETE FROM RETDET ';
        strSQL := strSQL + 'WHERE DET_DUPLIC = :DUPLIC ';

        With qryRetDet Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('DUPLIC').AsString := strDuplic;
          ExecSQL;
          Close;
        end;
      end;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[pGravaDelRetDet]');
      End;
    End;
  end;

  FreeAndNil(qryUpdate);
  FreeAndNil(qrySelect);
  FreeAndNil(qryRetDet);
end;

