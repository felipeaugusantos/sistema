      qryConsulta.SQL.Add('SELECT EXT_SALDO_ AS SALDO FROM ESTEXT');
      qryConsulta.SQL.Add('WHERE EXT_CODEEE = "' + strEmpSalExt + '"');
      qryConsulta.SQL.Add('AND EXT_CODEMP = "' + strCodEmp + '"');
      qryConsulta.SQL.Add('AND EXT_CODITE = "' + strCodIte + '"');
