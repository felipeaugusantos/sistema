function fVerificaPDTemCupomGerado(ANumDoc, AEspDoc, ACodEmp: String): Boolean;
var
  LQry: TUniQuery;
begin
  if (not fCfgSis('CPPF11', varBoolean)) then
    Exit(False);

  if fEmptyStr(ANumDoc) or (Trim(ANumDoc) = ',') then
    Exit(False);

  Result := (fCampoTabela('COUNT(1)', 'CPPGER', ['CPG_NUMDOC', 'CPG_ESPDOC', 'CPG_CODEMP'], [ANumDoc, AEspDoc, ACodEmp], False) > 0);

  if (not Result) and (AEspDoc = 'PD') then
  begin
    LQry := fCriaQuery;

    try
      LQry.SQL.Add('SELECT COUNT(1) QTD ');
      LQry.SQL.Add('FROM CPPGER ');
      LQry.SQL.Add('INNER JOIN FATDOR ON CPG_NUMDOC = FDO_NUMDOC ');
      LQry.SQL.Add('                 AND CPG_ESPDOC = FDO_ESPDOC ');
      LQry.SQL.Add('                 AND CPG_CODEMP = FDO_CODEMP ');
      LQry.SQL.Add('WHERE FDO_NUMFAT = :NUMFAT ');
      LQry.SQL.Add('  AND FDO_TIPFAT = :TIPFAT ');
      LQry.SQL.Add('  AND FDO_EMPFAT = :EMPFAT ');
      LQry.ParamByName('NUMFAT').AsString := ANumDoc;
      LQry.ParamByName('TIPFAT').AsString := AEspDoc;
      LQry.ParamByName('EMPFAT').AsString := ACodEmp;
      LQry.Open;

      Result := (LQry.FieldByName('QTD').AsInteger > 0);
    finally
      FreeAndNil(LQry);
    end;
  end;
end;

