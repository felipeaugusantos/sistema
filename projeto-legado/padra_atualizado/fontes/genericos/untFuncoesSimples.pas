{**********************************************************************}
{* CRIA UM CLIENTDATASET COM A MESMA ESTRUTURA E VALORES DE UMA QUERY *}
{*******************************************************************JC*}
function fCriaClientDatset(qryOrigem: TDataset; blnVazio: Boolean = False;
 AOwner: TComponent = Nil; blnRegistroAtual: Boolean = False; arrAddFields: TArray<TField> = Nil; arrSizeFields: TArray<TRecSizeField> = Nil): TUniClientDataSet;
  Var
    intCont  : Integer;
    intIdx_  : Integer;
    intSize  : Integer;
    intRecno : Integer;
begin

  Result := TUniClientDataSet.Create(AOwner);

  For intCont := 0 To qryOrigem.Fields.Count -1 Do
  Begin
    intSize := qryOrigem.Fields[intCont].Size;

    If Assigned(arrSizeFields) Then
    Begin
      For intIdx_ := 0 To Length(arrSizeFields) -1 Do
      Begin
        If (qryOrigem.Fields[intCont].FieldName = arrSizeFields[intIdx_].Name) Then
          intSize := arrSizeFields[intIdx_].Size
      End;
    End;

    With Result.FieldDefs.AddFieldDef Do
    Begin
      Name     := qryOrigem.Fields[intCont].FieldName;
      DataType := qryOrigem.Fields[intCont].DataType;
      Size     := intSize;
      Required := False;
    End;
  End;

  For intCont := 0 To Length(arrAddFields) -1 Do
    Result.FieldDefs.Add(arrAddFields[intCont].FieldName,
                         arrAddFields[intCont].DataType,
                         arrAddFields[intCont].Size,
                         False);

  Result.CreateDataSet;
  Result.Open;

  Result.LogChanges := False;

  If blnVazio Then
    Exit;

  With qryOrigem Do
  Begin
    intRecno := RecNo;
    DisableControls;

    If Not blnRegistroAtual Then
      First;

    While (Not Eof) Or blnRegistroAtual Do
    Begin
      Result.Append;

      For intCont := 0 To Fields.Count -1 Do
        Result.Fields[intCont].Value := Fields[intCont].Value;

      Result.Post;

      If blnRegistroAtual Then
        Break;

      Next;
    End;
    RecNo := intRecno;
    EnableControls;
  End;

end;

procedure pCopiaRegistroDataSet(dtsOrigem  : TDataSet;
                                dtsDestino : TDataSet;
                                blnEdit    : Boolean = False;
                                blnInsert  : Boolean = False;
                                blnForcaReadOnlyFalse : Boolean = False);
  Var
    intCont  : Integer;
begin

  If blnEdit Then
    dtsDestino.Edit
  Else
  If blnInsert Then
    dtsDestino.Insert
  Else
    dtsDestino.Append;

  With dtsOrigem Do
    For intCont := 0 To Fields.Count -1 Do
    Begin
      If blnForcaReadOnlyFalse Then
        dtsDestino.Fields[intCont].ReadOnly := False;

      dtsDestino.Fields[intCont].Value := Fields[intCont].Value;
    End;

  dtsDestino.Post;


end;

{************************************************************************************}
{*** Verifica se o DataSet de Destino contém todos os Fields do DataSet de Origem ***}
{*** Se não contiver, o DataSet de Destino será recriado com os mesmos Fields     ***}
{*** e mais os Fields faltantes.                                                  ***}
{*********************************************************************************BL*}
procedure pVerificaEstruturaDoDataSet(dtsOrigem  : TDataSet;
                                      Var dtsDestino : TUniClientDataSet);
var
  intCont  : Integer;
  dtsDados: TUniClientDataSet;
  arrFields: TArray<TField>;
begin

  for intCont := 0 to dtsOrigem.Fields.Count -1 do
  begin
    if not Assigned(dtsDestino.Fields.FindField(dtsOrigem.Fields[intCont].FieldName)) then
    begin
      SetLength(arrFields, Length(arrFields)+1);
      arrFields[Length(arrFields)-1] := dtsOrigem.Fields[intCont];
    end;
  end;

  dtsDados := nil;
  if Length(arrFields) > 0 then
  Begin
    dtsDados := fCriaClientDatset(dtsDestino);

    FreeAndNil(dtsDestino);
    dtsDestino := fCriaClientDatset(dtsDados, False, nil, False, arrFields);

    FreeAndNil(dtsDados);
  end;

end;

procedure pCopiaRegistroDataSetIfNotNull(dtsOrigem  : TDataSet;
                                         dtsDestino : TDataSet;
                                         blnEdit    : Boolean = False;
                                         blnInsert  : Boolean = False);
  Var
    intCont  : Integer;
begin

  If blnEdit Then
    dtsDestino.Edit
  Else
  If blnInsert Then
    dtsDestino.Insert
  Else
    dtsDestino.Append;

  For intCont := 0 To dtsOrigem.Fields.Count -1 Do
  Begin
    If (Not dtsOrigem.Fields[intCont].IsNull) Then
      dtsDestino.FieldByName(dtsOrigem.Fields[intCont].FieldName).Value := dtsOrigem.Fields[intCont].Value;
  End;

  dtsDestino.Post;

end;

function fMediaTime(strMedia: String): Integer;
  Var
    intCont : Integer;
    intPos  : Integer;
    strHor  : String;
    strMin  : String;
    strSeg  : String;
    IntHorS : Integer;
    IntMinS : Integer;
    intSeg  : Integer;
begin
  IntPos := 0;
  strHor := '';
  strMin := '';
  strSeg := '';
  For IntCont := 1 To Length(StrMedia) Do
  Begin
    If strMedia[IntCont] = ':' Then
      intPos := IntPos + 1
    Else
    Begin
      If IntPos = 0 Then
        strHor := strHor + strMedia[IntCont]
      Else
      If IntPos = 1 Then
        strMin := strMin + strMedia[IntCont]
      Else
      If IntPos = 2 Then
        strSeg := strSeg + strMedia[IntCont]
    End;
  End;
  intHorS := strTointDef(strHor,0) * 3600;
  intMinS := strToIntDef(strMin,0) * 60;
  intSeg  := strToIntDef(strSeg,0);

  Result := (IntHorS + IntMinS + IntSeg);
end;

function fSegToTempoStr(intSegundos: Integer): String;

  function fFormata(StrTexto: String): String;
  begin
    If Length(strTexto) = 1 Then
      Result := '0' + strTexto
    Else
      Result := strTexto;
  end;

  Var
    fltHor : Double;
    fltMin : Double;
    fltSeg : Double;
begin
  fltHor := Int( (IntSegundos / 3600) );
  fltMin := Int( ( IntSegundos - ( fltHor * 3600 ) ) / 60 );
  fltSeg := IntSegundos - ( fltHor * 3600 ) - ( fltMin * 60 );

  Result := fFormata(FloatToStr(fltHor)) + ':' +
            fFormata(FloatToStr(fltMin)) + ':' +
            fFormata(FloatToStr(fltSeg));
end;

function fSegToTimeStr(Segundos: Double): String;

  function fFormata(StrTexto: String): String;
  begin
    If Length(strTexto) = 1 Then
      Result := '0' + strTexto
    Else
      Result := strTexto;
  end;

  Var
    fltHor : Double;
    fltMin : Double;
    fltSeg : Double;
begin
  If (Segundos <= 0) Then
  Begin
    Result := '00:00:00';
    Exit;
  End;

  fltHor := Int( (Segundos / 3600) );
  fltMin := Int( ( Segundos - ( fltHor * 3600 ) ) / 60 );
  fltSeg := Round(Segundos - ( fltHor * 3600 ) - ( fltMin * 60 ));

  If (fltSeg >= 60) Then
  Begin
    fltMin := fltMin + (Floor(fltSeg) div 60);
    fltSeg := Floor(fltSeg) mod 60;
  End;

  If (fltMin >= 60) Then
  Begin
    fltHor := fltHor + (Floor(fltMin) div 60);
    fltMin := Floor(fltMin) mod 60;
  End;

  Result := fFormata(FloatToStr(fltHor)) + ':' +
            fFormata(FloatToStr(fltMin)) + ':' +
            fFormata(FloatToStr(fltSeg));
end;

