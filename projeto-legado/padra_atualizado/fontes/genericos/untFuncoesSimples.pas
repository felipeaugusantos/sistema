function fEhDocumentoBaixaEntregaFutura(const strNumdoc, strEspDoc, strCodEmp: string): Boolean;
var
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Try
    Result := False;
    Try
      qryGen := fCriaQuery();
      qryGen.SQL.Text :=
        ' SELECT                                       ' +
        '   SUM(QTD) AS QTD                            ' +
        ' FROM                                         ' +
        '   (SELECT                                    ' +
        '     1 AS QTD                                 ' +
        '   FROM                                       ' +
        '     MOVDET                                   ' +
        '   WHERE DET_NUMDOC = :NUMDOC                 ' +
        '     AND DET_ESPDOC = :ESPDOC                 ' +
        '     AND DET_CODEMP = :CODEMP                 ' +
        '     AND IFNULL(DET_DOCFUT, "") <> "") AS T ; ';
      qryGen.ParamByName('NUMDOC').AsString := strNumdoc;
      qryGen.ParamByName('ESPDOC').AsString := strEspDoc;
      qryGen.ParamByName('CODEMP').AsString := strCodEmp;
      qryGen.Open;
      Result := qryGen.FieldByName('QTD').AsInteger > 0;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

