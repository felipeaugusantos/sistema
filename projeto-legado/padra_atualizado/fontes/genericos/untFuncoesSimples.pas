function fRetornaComposicao(strDescri:String; blnPadrao : Boolean = False): String;
  Var
    qryGen : TUniQuery;
begin
  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      SQL.Clear;
      SQL.Add('SELECT COM_COMPOS, COM_FORMUL FROM COMCUS ');

      If blnPadrao Then
        SQL.Add('WHERE COM_SUGERI = "S"     ')
      Else
      Begin
        SQL.Add('WHERE COM_DESCRI = :DESCRI ');
        ParamByName('DESCRI').AsString := strDescri;
      End;

      Open;

      If Not IsEmpty Then
      Begin
        if not fEmptyStr(FieldByName('COM_FORMUL').AsString) then
          Result := FieldByName('COM_FORMUL').AsString
      Else
          Result := fRetornaComposicaoCustoCampos(FieldByName('COM_COMPOS').AsInteger);
      End
      Else
        Result := '';
    End;

  Except
    On E : Exception Do
      pMensagensErro(E.Message,'[fRetornaComposicao');
  End;

  FreeAndNil(qryGen);
End;

function fRetornaComposicaoPadrao: String;
begin
  Result := fRetornaComposicao('', True);
End;

procedure pCarregaComposicaoCusto(cbbComCus: TComboBoxFocus);
  Var
    qryGen  : TUniQuery;
    intIndex: Integer;
begin
  Try
    intIndex := 0;
    qryGen := fCriaQuery;

    cbbComCus.Clear;

    With qryGen Do
    Begin
      SQL.Clear;
      SQL.Add('SELECT * FROM COMCUS ');
      SQL.Add('ORDER BY AUTOINCREM, COM_DESCRI, COM_COMPOS ');
      Open;

      If Not IsEmpty Then
      Begin
        First;
        while Not EOF Do
        Begin
          cbbComCus.Items.Add(FieldByName('COM_DESCRI').AsString);

          If (FieldByName('COM_SUGERI').AsString = 'S') Then
            intIndex := cbbComCus.Items.Count-1;

          Next;
        End;
      End;

    End;

    cbbComCus.ItemIndex := intIndex;

  Except
    On E : Exception Do
      pMensagensErro(E.Message,'[pCarregaComposicaoCusto]');
  End;

  FreeAndNil(qryGen);
end;


