Function fAddIteTbp(intTabela : Integer) : String;
  Const
    STR_CAMPO : Array[0..11] Of String = ('ITE_DESMAX', 'ITE_DESMAX_NOV', 'ITE_DESMGE', 'ITE_DESMGE_NOV', 'ITE_DESMSU', 'ITE_DESMSU_NOV',
                                          'ITE_DESVMM', 'ITE_DESVMM_NOV', 'ITE_DESGMM', 'ITE_DESGMM_NOV', 'ITE_DESSMM', 'ITE_DESSMM_NOV');
  Var
    intCampo : Integer;
    strNomCam: String;
Begin
  Result := '';
  For intCampo := 0 To Length(STR_CAMPO)-1 Do
  Begin
    Result := Result + ' IFNULL(( ';
    Result := Result + '  SELECT '+ ReplaceStr(STR_CAMPO[intCampo],'_NOV', '');
    Result := Result + '  FROM ITETBP TBP                                    ';
    Result := Result + '  WHERE TBP.ITE_CODITE = G.ITE_CODITE                ';
    Result := Result + '    AND TBP.ITE_CODEMP = G.ITE_CODEMP                ';
    Result := Result + '    AND TBP.ITE_TABPRE = ' + intToStr(intTabela)      ;
    strNomCam := STR_CAMPO[intCampo];
    Delete(strNomCam, 10, 1);
    Insert(intToStr(intTabela), strNomCam, 10);
    Result := Result + ' ),0) AS ' + strNomCam + ', ';
  End;

End;

