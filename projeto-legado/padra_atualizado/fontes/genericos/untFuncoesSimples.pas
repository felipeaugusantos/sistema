function CriarSentencaIN(const AArray: TArray<string>): string;
var
  Valores: string;
  s: string;
begin
  // Inicializa a string que irá conter os valores
  Valores := '';

  // Itera sobre o array e adiciona os valores na sentença IN
  for  s in AArray do
  begin
    if Valores <> '' then
      Valores := Valores + ', ';  // Adiciona uma vírgula entre os valores
    Valores := Valores + QuotedStr(s);  // Adiciona o valor entre aspas
  end;

  // Retorna a sentença IN com os valores formatados
  Result := 'IN (' + Valores + ')';
end;

function StringParaArray(const AString: string): TArray<string>;
var i: integer;
begin
  // Utiliza o Split para separar os itens com base na vírgula
  Result := AString.Split([',']);

  // Limpa os espaços em branco (se existirem) ao redor dos elementos
  for i := 0 to High(Result) do
  begin
    Result[i] := Trim(Result[i]);
  end;
end;

