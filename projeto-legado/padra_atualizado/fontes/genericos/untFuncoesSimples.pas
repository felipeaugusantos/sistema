{ TJsonUtils }
class function TJsonUtils.Format(AJson: String): String;
var
  LObj: TJSONValue;
begin
  Try
    LObj := TJSONObject.ParseJSONValue(AJson);
{$IFDEF LINUX}
    Result := LObj.Format;
{$ELSE}
    Result := TJson.Format(LObj);
{$ENDIF}
    FreeAndNil(LObj);
  Except
    Result := AJson;
  End;
end;

class function TJsonUtils.GetValue<T>(AJson, APath: String): T;
var
  LObj: TJSONValue;
begin
  LObj := TJSONObject.ParseJSONValue(AJson);
  Try
    Result := LObj.GetValue<T>(APath);
  Except
    FreeAndNil(LObj);
  End;
end;

class function TJsonUtils.IsValid(AJson: String): Boolean;
var
  LObj: TJSONValue;
begin
  LObj := nil;
  Try
    Try
      LObj := TJSONObject.ParseJSONValue(AJson);
      Result := True;
    Except
      Result := False;
    End;
  Finally
    If Assigned(LObj) Then
      FreeAndNil(LObj);
  End;
end;

