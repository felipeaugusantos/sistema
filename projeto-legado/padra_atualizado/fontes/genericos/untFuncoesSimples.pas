Procedure pRetDadosTransportadora(strCodTra: String;
   var strNomTra, strEndTra, strEndTr2: String);
  Var
    qryTra: TUniQuery;
Begin
  qryTra := fCriaQuery;
  With qryTra, SQL Do
  Begin
    Clear;
    Add('SELECT');
    Add('  TRA_NOMTRA,');
    Add('  TRA_ENDERE,');
    Add('  TRA_BAIRRO,');
    Add('  TRA_C_E_P_,');
    Add('  TRA_FONE01,');
    Add('  CID_NOMCID,');
    Add('  CID_ESTADO ');
    Add('FROM');
