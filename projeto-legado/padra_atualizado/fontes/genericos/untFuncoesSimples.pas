Begin
  SetLength(Result,0);
  arrTemp := fRetornaComposicaoCustoIndices(intValCfg);
  For intCorre := Length(arrTemp)-1 DownTo 0 Do
  Begin
    SetLength(Result, Succ(Length(Result)));
