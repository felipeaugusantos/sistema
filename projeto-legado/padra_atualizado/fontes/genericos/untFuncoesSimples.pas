procedure pMostraErrosAuditoria(ACodErros: String);
var
  LQry: TUniQuery;
  LMsgExplicativa: TfrmMensagemExplicativa;
  LListErros, LListCodErros: TStringList;
  LCont: Integer;
begin
  if fEmptyStr(ACodErros) then
    Exit;

  LListErros := TStringList.Create;
  LListCodErros := TStringList.Create;
  LListCodErros.Delimiter := ',';

  LQry := fCriaQuery;
  pCriarFormularios(TfrmMensagemExplicativa, LMsgExplicativa);

  try
    try
      if Pos('_', ACodErros) > 0 then
      begin
        ExtractStrings(['_'],[' '], PChar(ACodErros), LListCodErros);
        ACodErros := LListCodErros.DelimitedText;
      end;

      LMsgExplicativa.Caption := 'Inconsistências no Banco de Dados';
      LMsgExplicativa.Width   := 1000;
      LMsgExplicativa.Height  := 600;
      LMsgExplicativa.mmoInstru.ScrollBars := ssBoth;

      LQry.SQL.Text := 'SELECT LOG_RELERR FROM LOGERR_AUDIT WHERE AUTOINCREM IN ('+ACodErros+')';
      LQry.Open;

      if LQry.IsEmpty then
        LMsgExplicativa.mmoInstru.Lines.Add('ATENÇÃO! ' + Format(AUDITORIA_GRAVACAO_FATURAMENTO_MSG_ERRO, [ACodErros]))
      else
      begin
        LMsgExplicativa.mmoInstru.Lines.Add('Ocorreram inconsistências no banco de dados. Esta operação não será realizada.');
        LMsgExplicativa.mmoInstru.Lines.Add('INCONSISTÊNCIAS ENCONTRADAS:');

        while not LQry.Eof do
        begin
          LListErros.Clear;
          LListErros.Text := LQry.FieldByName('LOG_RELERR').AsString;

          LMsgExplicativa.mmoInstru.Lines.Add('');
          for LCont := 0 To Pred(LListErros.Count) do
            LMsgExplicativa.mmoInstru.Lines.Add(LListErros[LCont]);

          LQry.Next;
        end;
      end;

      LMsgExplicativa.ShowModal;
    except
      pMensagemOk('ATENÇÃO! ' + Format(AUDITORIA_GRAVACAO_FATURAMENTO_MSG_ERRO, [ACodErros]));
    end;
  finally
    pFreeAndNil(LMsgExplicativa);
    FreeAndNil(LQry);
    FreeAndNil(LListErros);
    FreeAndNil(LListCodErros);
  end;
end;

function fRetornaErrosAuditoria(ACodErros: String): String;
var
  LQry: TUniQuery;
  LListErros, 
  LListCodErros: TStringList;
  LCont: Integer;
begin
  Result := '';

  if fEmptyStr(ACodErros) then
    Exit;

  LQry := fCriaQuery;
  LListErros := TStringList.Create;
  LListCodErros := TStringList.Create;
  LListCodErros.Delimiter := ',';

  try
    try
      if Pos('_', ACodErros) > 0 then
      begin
        ExtractStrings(['_'],[' '], PChar(ACodErros), LListCodErros);
        ACodErros := LListCodErros.DelimitedText;
      end;

      LQry.SQL.Text := 'SELECT LOG_RELERR FROM LOGERR_AUDIT WHERE AUTOINCREM IN ('+ACodErros+')';
      LQry.Open;

      if LQry.IsEmpty then
        raise Exception.Create('ATENÇÃO! ' + Format(AUDITORIA_GRAVACAO_FATURAMENTO_MSG_ERRO, [ACodErros]))
      else
      begin
        Result := Result + 'Ocorreram inconsistências no banco de dados. Esta operação não será realizada.' + #10#13;
        Result := Result + 'INCONSISTÊNCIAS ENCONTRADAS:' + #10#13;

        while not LQry.Eof do
        begin
          LListErros.Clear;
          LListErros.Text := LQry.FieldByName('LOG_RELERR').AsString;

          for LCont := 0 To Pred(LListErros.Count) do
            Result := Result + LListErros[LCont] + #10#13;

          LQry.Next;
        end;
      end;
    except
      raise Exception.Create('ATENÇÃO! ' + Format(AUDITORIA_GRAVACAO_FATURAMENTO_MSG_ERRO, [ACodErros]));
    end;
  finally
    FreeAndNil(LQry);
    FreeAndNil(LListErros);
    FreeAndNil(LListCodErros);
  end;
end;

