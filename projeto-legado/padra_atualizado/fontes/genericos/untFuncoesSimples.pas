function fTamCodMar: Integer;
  Var
    qryAux: TUniQuery;
    intDef: Integer;
Begin
  intDef := 3;
  Result := intDef;
  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Text := 'DESC CADMAR';
  qryAux.Open;

  While (Not qryAux.Eof) Do
  Begin
    If qryAux.FieldByName('Field').AsString = 'MAR_CODMAR' Then
    Begin
      If UpperCase(qryAux.FieldByName('Type').AsString) = 'VARCHAR(6)' Then
        Result := 6
      Else If UpperCase(qryAux.FieldByName('Type').AsString) = 'VARCHAR(3)' Then
        Result := 3
      Else
        Result := StrToIntDef(fRetSomenteNumeros(qryAux.FieldByName('Type').AsString), intDef);

      If (Result > 6) Then
        Result := intDef;

      Break;
    End;

    qryAux.Next;
  End;

  FreeAndNil(qryAux);
End;

