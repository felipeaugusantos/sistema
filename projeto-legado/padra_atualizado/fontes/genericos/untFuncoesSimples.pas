function fRetornaDadosModFis(strChave: String = ''): String;
var
  qryGen    :TUniQuery;
  strSQL    :String;
Begin
  qryGen := fCriaQuery;
  strSQL := '';
  strSQL := ' SELECT GROUP_CONCAT(FIS_CODMOD) AS CODMOD FROM MODFIS ';
  If fEmptyStr(Trim(strChave)) Then
    strSQL := strSQL + ' WHERE FIS_NOTELE = ''N'' '
  Else
    strSQL := strSQL + ' WHERE FIS_NOTELE = ''S'' ';
  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    Open;
    Result := (FieldByName('CODMOD').AsString);
  End;
  FreeAndNil(qryGen);
End;

function fRetornaDadosModFis(strChave: String; var objItems: TStrings): Boolean;overload;
var
  qryGen    :TUniQuery;
  strSQL    :String;
  strModelo: String;
Begin
  objItems.clear;
  objItems.NameValueSeparator := '-';
  Try
    qryGen := fCriaQuery;
    strSQL := '';
    strSQL := ' SELECT FIS_CODMOD, FIS_DESMOD FROM MODFIS ';
    If fEmptyStr(Trim(strChave)) Then
      strSQL := strSQL + ' WHERE FIS_NOTELE = ''N'' '
    Else
      strSQL := strSQL + ' WHERE FIS_NOTELE = ''S'' ';

    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strSQL);
    qryGen.Open;
    Result := True;
    if qrygen.isempty then
      Exit;
    qryGen.first;

    while not qryGen.eof do
    begin
      strModelo := Format('%s-%s',[qryGen.FieldByName('FIS_CODMOD').AsString,
                                   qryGen.FieldByName('FIS_DESMOD').AsString]);
      objItems.Add(strModelo);
      qrygen.next;
    end;

  Finally
    FreeAndNil(qryGen);
  End;
end;

