procedure pCalculaValorUnitarioGridDescontoEmbalagem(var qryIteEmb: TUniQuery);
Var
  fltValMultEmb,
  fltValAplicandoDesconto,
  fltResultadoValorUnitario: Double;
  intTabPre: Integer;

Begin

  qryIteEmb.First;

  While Not qryIteEmb.Eof Do
  Begin
    If (qryIteEmb.FieldByName('ITB_TABPRE').AsString <> 'TODAS') Then
    Begin
      fltValMultEmb:= (qryIteEmb.FieldByName('ITE_PREVE' + IntToStr(qryIteEmb.FieldByName('ITB_TABPRE').AsInteger)).AsFloat * qryIteEmb.FieldByName('ITB_QTDEMB').AsFloat);
      fltValAplicandoDesconto:= ((fltValMultEmb * qryIteEmb.FieldByName('ITB_DESCON').AsFloat)/100);
      fltResultadoValorUnitario:= ((fltValMultEmb - fltValAplicandoDesconto) / qryIteEmb.FieldByName('ITB_QTDEMB').AsFloat);
      qryIteEmb.FieldByName('ITB_PRCUN' + qryIteEmb.FieldByName('ITB_TABPRE').AsString).ReadOnly := False;
      qryIteEmb.Edit;
      qryIteEmb.FieldByName('ITB_PRCUN' + qryIteEmb.FieldByName('ITB_TABPRE').AsString).AsString := AnsiReplaceStr(FloatToStr(fltResultadoValorUnitario), '.', '');
      qryIteEmb.Post;
    End
    Else
    Begin
      If (qryIteEmb.FieldByName('ITB_TABPRE').AsString  = 'TODAS') Then
      Begin

        For intTabPre := 1 To Length(VS_strTabPrc) Do
        Begin
          If VS_strTabPrc[intTabPre] = 'S' Then
          Begin
            fltValMultEmb:= (qryIteEmb.FieldByName('ITE_PREVE' + IntToStr(intTabPre)).AsFloat * qryIteEmb.FieldByName('ITB_QTDEMB').AsFloat);
            fltValAplicandoDesconto:= ((fltValMultEmb * qryIteEmb.FieldByName('ITB_DESCON').AsFloat)/100);
            fltResultadoValorUnitario:= ((fltValMultEmb - fltValAplicandoDesconto) / qryIteEmb.FieldByName('ITB_QTDEMB').AsFloat);
            qryIteEmb.FieldByName('ITB_PRCUN' + IntToStr(intTabPre)).ReadOnly := False;
            qryIteEmb.Edit;
            qryIteEmb.FieldByName('ITB_PRCUN' + IntToStr(intTabPre)).AsString := AnsiReplaceStr(FloatToStr(fltResultadoValorUnitario), '.', '');
            qryIteEmb.Post;
          End
        End

      End;
    End;
    qryIteEmb.Next;
  End;

End;

