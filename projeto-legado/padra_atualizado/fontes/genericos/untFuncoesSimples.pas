procedure pEnviaLotDorParaDelLotDor(const ALisIncFatDor: String);
  Var
    qryLotDor: TUniQuery;
    qryDelete: TUniQuery;
    LLisIncFatDor: String;
begin
  If (Trim(ALisIncFatDor) = '') Then
    Exit;

  qryLotDor := fCriaQuery;
  qryDelete := fCriaQuery;
  Try
    qryLotDor.Close;
    qryLotDor.SQL.Clear;
    qryLotDor.SQL.Add('SELECT * FROM LOTDOR WHERE LDO_SEQFDO IN (' + ALisIncFatDor + ')');
    qryLotDor.Open;

    qryLotDor.First;
    If Not qryLotDor.IsEmpty Then
    Begin
      qryLotDor.First;
      While Not qryLotDor.Eof Do
      Begin
        pIncrementaListaStr(qryLotDor.FieldByName('LDO_SEQFDO').AsString, LLisIncFatDor, True, True);
        qryLotDor.Next;
      End;

      qryDelete.Close;
      qryDelete.SQL.Text := 'DELETE FROM DEL_LOTDOR WHERE LDO_SEQFDO IN (' + LLisIncFatDor + ')';
      qryDelete.ExecSQL;

      qryLotDor.First;
      While Not qryLotDor.Eof Do
      Begin
        fVerificaIntegridade('', 'LOTDOR', qryLotDor, True, False, '', '', False, '');

        qryLotDor.Next;
      End;
    End;
  Finally
    FreeAndNil(qryLotDor);
    FreeAndNil(qryDelete);
  End;
end;

