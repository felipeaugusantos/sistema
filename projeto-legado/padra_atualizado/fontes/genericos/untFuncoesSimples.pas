function fGerarPedidoDeCompraNaTransferencia(Const strForCli : String;
                                                   strOpcDoc : String;
                                               Out strEmpDes : String) : Boolean;
  var
    qryCadEmp : TUniQuery;
  const
    FIELD_CODEMP = 'EMP_CODEMP';
    FIELD_FORFIL = 'EMP_FORFIL';
    FIELD_CLIFIL = 'EMP_CLIFIL';
    OUTRAS_SAIDAS_FORNECEDOR = 'OF';
    GARANTIA_ENVIO_FORNECEDOR = 'GF';
    SQL = 'SELECT EMP_CODEMP, EMP_GERORI, EMP_GERCMP FROM CADEMP WHERE [FIELD] = :VALUE';

  function fGetSQL(blnOrigem : Boolean = False) : String;
  var
    strField : String;
  begin
    strField := IIF(blnOrigem, FIELD_CODEMP, IIF((strOpcDoc.Equals(OUTRAS_SAIDAS_FORNECEDOR) Or strOpcDoc.Equals(GARANTIA_ENVIO_FORNECEDOR)) , FIELD_FORFIL, FIELD_CLIFIL));
    Result   := StringReplace(SQL, '[FIELD]', strField, [rfReplaceAll]);
  end;

  function fGerarPedidoDeCompraEmpresaOrigem : Boolean;
  begin
    qryCadEmp.Close;
    qryCadEmp.SQL.Clear;
    qryCadEmp.SQL.Add(fGetSQL(True));
    qryCadEmp.ParamByName('VALUE').AsString := VS_strCodEmp;
    qryCadEmp.Open;
    Result := (Not qryCadEmp.IsEmpty) And (qryCadEmp.FieldByName('EMP_GERORI').AsString.Equals('S'));
  end;

  function fGerarPedidoDeCompraEmpresaDestino : Boolean;
  begin
    qryCadEmp.Close;
    qryCadEmp.SQL.Clear;
    qryCadEmp.SQL.Add(fGetSQL);
    qryCadEmp.ParamByName('VALUE').AsString := strForCli;
    qryCadEmp.Open;

    if strOpcDoc.Equals('GF') then
      Result := (qryCadEmp.IsEmpty) Or (qryCadEmp.FieldByName('EMP_GERCMP').AsString.Equals('S'))
    else
      Result := (Not qryCadEmp.IsEmpty) And (qryCadEmp.FieldByName('EMP_GERCMP').AsString.Equals('S'));

    If (Result) Then
      strEmpDes := qryCadEmp.FieldByName('EMP_CODEMP').AsString;

  end;

begin

  Result := False;

  If strForCli.IsEmpty Then
    Exit;

  qryCadEmp := fCriaQuery;

  Try
    Result := (fGerarPedidoDeCompraEmpresaOrigem) And (fGerarPedidoDeCompraEmpresaDestino);
  Finally
    FreeAndNil(qryCadEmp);
  End;

end;

