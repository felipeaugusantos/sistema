        LSQL := LSQL + '  CADREC ';
        LSQL := LSQL + 'WHERE ';
        LSQL := LSQL + '  CTR_NUMDUP = :NUMDUP';
        LSQL := LSQL + '  AND CTR_CODEMP = :CODEMP';
        LSQL := LSQL + '  AND CTR_ESPDOC = "CC" ';

        LQuery.Close;
        LQuery.SQL.Clear;
        LQuery.SQL.Add(LSQL);
        LQuery.ParamByName('NUMDUP').AsString := Result;
        LQuery.ParamByName('CODEMP').AsString := VS_strCodEmp;
        LQuery.Open;
        LExiste := (LQuery.Fields[0].AsInteger > 0);
