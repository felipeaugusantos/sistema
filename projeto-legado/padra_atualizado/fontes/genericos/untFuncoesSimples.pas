function fEhPedidoRefenciadoHaUmOrcamento(strNumDoc, strCodEmp: String;
  Var strNumOrcRef: String; Var strEmpOrcRef: String): Boolean;
  Var
    strSQL: String;
    qryPed: TUniQuery;
Begin
  Try
    strNumOrcRef := '';
    strEmpOrcRef := '';

    If fEmptyStr(strNumDoc) Or
       fEmptyStr(strCodEmp) Then
    Begin
      Result := False;
      Exit;
    End;

    If Not fCfgSis('VALPED', VarBoolean) Then
    Begin
      Result := False;
      Exit;
    End;

    qryPed := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + ' SELECT                                                 ';
    strSQL := strSQL + '   FGO_NUMDOC,                                          ';
    strSQL := strSQL + '   FGO_CODEMP                                           ';
    strSQL := strSQL + ' FROM                                                   ';
    strSQL := strSQL + '   EXTGOR                                               ';
    strSQL := strSQL + ' JOIN FATGOR ON (FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO) ';
    strSQL := strSQL + ' WHERE                                                  ';
    strSQL := strSQL + '   FGO_NPDROR = :NUMDOC AND                             ';
    strSQL := strSQL + '   FGO_EPDROR = :CODEMP                                 ';

    With qryPed Do
    Begin
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      Result := Not IsEmpty;

      If Result Then
      Begin
        strNumOrcRef := FieldByName('FGO_NUMDOC').AsString;
        strEmpOrcRef := FieldByName('FGO_CODEMP').AsString;
      End;
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fEhPedidoRefenciadoHaUmOrcamento]');
    End;
  End;

  FreeAndNil(qryPed);
End;

