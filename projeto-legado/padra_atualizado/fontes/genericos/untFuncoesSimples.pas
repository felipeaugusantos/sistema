function fArquivoExisteNoDiretorio(strArquivo: String; intMaxTentativas: Integer = 1; cdnSleep: Cardinal = 0): Boolean;
var
  intTentativas: Integer;
begin
  intTentativas := 0;

  repeat
    Inc(intTentativas);

    Result := FileExists(strArquivo);

    if (not Result) and (intTentativas > 1) and (cdnSleep > 0) then
      Sleep(cdnSleep);

  until ((Result) or (intTentativas = intMaxTentativas));
end;

function fGetUltimaChaveAcessoFornecedor(Const strCodFor, strCodEmp: String): String;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery;
  Try
    qryAux.SQL.Add('SELECT FIS_ACESSO');
    qryAux.SQL.Add('FROM MOVDET');
    qryAux.SQL.Add('JOIN CADFIS ON FIS_NUMDOC = DET_NUMDOC');
    qryAux.SQL.Add('           AND FIS_ESPDOC = DET_ESPDOC');
    qryAux.SQL.Add('           AND FIS_CODEMP = DET_CODEMP');
    qryAux.SQL.Add('           AND FIS_FORCLI = DET_CODFOR');
    qryAux.SQL.Add('           AND FIS_TIP_FC = DET_TIP_FC');
    qryAux.SQL.Add('           AND FIS_ENTSAI = "E"');
    qryAux.SQL.Add('WHERE DET_TIP_FC = "F"');
    qryAux.SQL.Add('  AND DET_CODFOR = :CODFOR');
    qryAux.SQL.Add('  AND DET_CODEMP = :CODEMP');
    qryAux.SQL.Add('  AND LOCATE(DET_CLAFIS, :CLACOM) > 0');
    qryAux.SQL.Add('ORDER BY DET_DTAENT DESC, DET_HORENT DESC');
    qryAux.SQL.Add('LIMIT 1');

    qryAux.ParamByName('CODFOR').AsString := strCodFor;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CLACOM').AsString := VS_strClaCom;
    qryAux.Open;

    Result := qryAux.FieldByName('FIS_ACESSO').AsString;
  Finally
    FreeAndNil(qryAux);
  End;
end;

