function fExisteCredComProfissionalDevMerc(strCodDiv: String; Var dtaDtaIni: TDate;
  Var dtaDtaFin: TDate; Var crTela: TChamaRotina): Boolean;
  Var
    strSQL: String;
    qryTmp: TUniQuery;
Begin
  dtaDtaIni := 0;
  dtaDtaFin := 0;
  crTela := crNoneTela;
  Result := False;

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   MIN(CTR_DTACAD) AS DTMIN,  ';
  strSQL := strSQL + '   MAX(CTR_DTACAD) AS DTMAX,  ';
  strSQL := strSQL + '   MAX(CTR_VALDUP) AS VALDUP, ';
  strSQL := strSQL + '   SUM(CTR_VALDUP) AS SOMDUP, ';
  strSQL := strSQL + '   COUNT(*) AS QTD ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   CADREC ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '   CTR_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '   CTR_ESPDOC = "CC"    AND ';
  strSQL := strSQL + '   CTR_DTAREC IS NULL   AND ';
  strSQL := strSQL + '   CTR_DTAENV IS NULL   AND ';
  strSQL := strSQL + '   IF(CTR_BCOBOL = "778", TRUE, (CTR_NOSNUM IS NULL OR CTR_NOSNUM = "")) ';
  If fCfgSis('EMPORI', VarBoolean) Then
    strSQL := strSQL + ' AND CTR_CODEMP = ' + QuotedStr(VS_strCodEmp);

  Try
    qryTmp := fCriaQuery;

    With qryTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODCLI').AsString := strCodDiv;
      Open;

      If Not IsEmpty Then
      Begin
        Result    := (FieldByName('QTD').AsInteger > 0) And (FieldByName('VALDUP').AsFloat > 0);
        dtaDtaIni := FieldByName('DTMIN').AsDateTime;
        dtaDtaFin := FieldByName('DTMAX').AsDateTime;

        If FieldByName('SOMDUP').AsFloat <> 0 Then
          crTela := crAgrupamento
        Else
          crTela := crBaixaReceberCaixa;
      End;
    End;

    FreeAndNil(qryTmp);
  Except
    On E: Exception Do
    Begin
      FreeAndNil(qryTmp);
      pMensagensErro(E.Message, '[fExisteCredComProfissionalDevMerc]');
    End;
  End;
End;

