procedure pCarregaEtiVolPedido(strNumDoc: String;
                               strEspDoc: String;
                               strCodEmp: String;
                               strCodCli: String;
                               Var strCodVol: String);
Var
  qryEtiVol: TUniQuery;
begin
  qryEtiVol := fCriaQuery();

  Try
    qryEtiVol.SQL.Add('  SELECT                      ');
    qryEtiVol.SQL.Add('    VOL_CODIGO                ');
    qryEtiVol.SQL.Add('  FROM                        ');
    qryEtiVol.SQL.Add('    ETIVOL                    ');
    qryEtiVol.SQL.Add('  WHERE                       ');
    qryEtiVol.SQL.Add('    VOL_NUMPED     = :NUMPED  ');
    qryEtiVol.SQL.Add('    AND VOL_ESPPED = :ESPPED  ');
    qryEtiVol.SQL.Add('    AND VOL_EMPPED = :EMPPED  ');
    qryEtiVol.SQL.Add('    AND VOL_CLIPED = :CLIPED  ');

    qryEtiVol.ParamByName('NUMPED').AsString := strNumDoc;
    qryEtiVol.ParamByName('ESPPED').AsString := strEspDoc;
    qryEtiVol.ParamByName('EMPPED').AsString := strCodEmp;
    qryEtiVol.ParamByName('CLIPED').AsString := strCodCli;

    qryEtiVol.Open;

    If (Not qryEtiVol.IsEmpty) Then
    Begin
      qryEtiVol.First;
      While (Not qryEtiVol.Eof) Do
      Begin
        pIncrementaListaStr(qryEtiVol.FieldByName('VOL_CODIGO').AsString, strCodVol, True);
        qryEtiVol.Next;
      End;
    End;
  Finally
    FreeAndNil(qryEtiVol);
  End;
end;

function fCarregaEtiquetaVolumeComposto(strCodVol:String):TUniQuery;
begin
  Result := Nil;

  If fEmptyStr(strCodVol) Then
    Exit;

  Result := fCriaQuery;

  Result.Close;
  Result.SQL.Clear;

  If (Not fEmptyStr(strCodVol)) Then
  Begin
    Result.SQL.Add('  SELECT                              ');
    Result.SQL.Add('    EVC_DESCRI,                       ');
    Result.SQL.Add('    EVC_SIGLA_,                       ');
    Result.SQL.Add('    EVC_VOLUME                        ');
    Result.SQL.Add('  FROM                                ');
    Result.SQL.Add('    ETIEVC                            ');
    Result.SQL.Add('  WHERE                               ');
    Result.SQL.Add('    EVC_CODIGO IN(' + strCodVol + ')  ');
  End;
end;

function fCarregaEtiquetaVolumeCompostoPedido(strNumDoc: String;
                                              strEspDoc: String;
                                              strCodEmp: String;
                                              strCodCli: String;
                                              Var strCodVol: String): TUniQuery;
Begin
  Result := Nil;

  If fEmptyStr(strNumDoc) Then
    Exit;

  strCodVol := EmptyStr;

  pCarregaEtiVolPedido(strNumDoc,
                       strEspDoc,
                       strCodEmp,
                       strCodCli,
                       strCodVol);

  Result := fCarregaEtiquetaVolumeComposto(strCodVol);
End;


procedure pInsereEtiquetaVolumeComposto(strProCod: String;
                                        strDescricao: String;
                                        strSigla: String;
                                        intVolume: Integer);
var
  qryInsereEtiqueta: TUniQuery;
begin
  qryInsereEtiqueta := fCriaQuery;

  try
    qryInsereEtiqueta.Close;
    qryInsereEtiqueta.SQL.Clear;
    qryInsereEtiqueta.SQL.Add('INSERT INTO ETIEVC(AUTOINCREM, EVC_CODIGO, EVC_DESCRI, EVC_SIGLA_, EVC_VOLUME)');
    qryInsereEtiqueta.SQL.Add('VALUES(:AUTINC, :CODIGO, :DESCRI, :SIGLA_, :VOLUME)');

    qryInsereEtiqueta.ParamByName('AUTINC').AsString := fRetAutoIncrem('ETIEVC', VS_strCodEmp);
    qryInsereEtiqueta.ParamByName('CODIGO').AsString := strProCod;
    qryInsereEtiqueta.ParamByName('DESCRI').AsString := strDescricao;
    qryInsereEtiqueta.ParamByName('SIGLA_').AsString := strSigla;
    qryInsereEtiqueta.ParamByName('VOLUME').AsInteger := intVolume;

    qryInsereEtiqueta.ExecSQL;

  finally
    FreeAndNil(qryInsereEtiqueta);
  end;
end;

