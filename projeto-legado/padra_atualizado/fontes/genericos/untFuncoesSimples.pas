      strSQL := strSQL + '  AND IFNULL(C.CHQ_TELCHE, "N") <> "S" ';
      strSQL := strSQL + '  AND C.CHQ_INCCTR = "N" ';
      strSQL := strSQL + '  AND C.CHQ_DTAVEN <> C.CHQ_DTACAD ';

    end

    Else If (typCon = tcChqAVistaLiquidados) Then  // Cheques a vista liquidados
