procedure pEliminaMenu(MenuItem: TMenuItem; blnMantemOrigem: Boolean=True);
 Var
   intIdx: Integer;
begin
  If Assigned(MenuItem) Then
  Begin
    For intIdx := MenuItem.Count - 1 Downto 0 Do
      If Assigned(MenuItem.Items[intIdx]) Then
        pEliminaMenu(MenuItem.Items[intIdx], False);

    If Not blnMantemOrigem Then
    Begin
      If Assigned(MenuItem.Parent) Then
        MenuItem.Parent.Remove(MenuItem);
      MenuItem.Free;
    End;
  End;
end;

function fMenuToXml(Const Menu: TMenuItem): String;
  var
    intIdx: Integer;

  function fParserScape(str: String): String;
  begin
    Result := str;
    Result := AnsiReplaceStr(Result,'&','&amp;');
    Result := AnsiReplaceStr(Result,'<','&lt;');
    Result := AnsiReplaceStr(Result,'>','&gt;');
    Result := AnsiReplaceStr(Result,'''','&apos;');
    Result := AnsiReplaceStr(Result,'"','&quot;');
  end;

begin
  If Assigned(Menu) Then
  Begin
    Result := '<'+menu.Name+' ';
    Result := Result + 'Caption="'+fParserScape(menu.Caption)+'" ';
    Result := Result + 'Hint="'+fParserScape(menu.Hint)+'" ';
    Result := Result + 'Visible="'+BoolToStr(menu.Visible, True)+'">';

    For intIdx := 0 To Menu.Count - 1 Do
      Result := Result + fMenuToXml(Menu[intIdx]);

    Result := Result + '</'+menu.Name+'>';
  End;
end;

procedure pXmlToMenu(Const XmlNode: IXMLNode; Const MenuItem: TMenuItem; Const strProjeto: String; Const onClick: TProcOnClick; Const arrIgnorar: Array Of String);
var
  intIdx: Integer;
  NewMenuItem: TCustomMenuItem;
  NodeText: string;
  AttrNode: IXMLNode;
begin
  if not (XmlNode.NodeType = ntElement) then
    Exit;

  NodeText := XmlNode.NodeName;

  if MatchStr(NodeText, arrIgnorar) then
    Exit;

  if NodeText = MenuItem.Name then
  begin
    NewMenuItem := TCustomMenuItem(MenuItem);
  end
  else
  begin
    NewMenuItem := TCustomMenuItem.Create(MenuItem);
    NewMenuItem.Name    := NodeText;
    NewMenuItem.Projeto := strProjeto;
    if (not XmlNode.HasChildNodes) then
      NewMenuItem.OnClick := onClick;

    for intIdx := 0 to xmlNode.AttributeNodes.Count - 1 do
    begin
      AttrNode := xmlNode.AttributeNodes.Nodes[intIdx];

      if AttrNode.NodeName = 'Caption' then
        NewMenuItem.Caption := AttrNode.Text

      else if AttrNode.NodeName = 'Hint' then
        NewMenuItem.Hint := AttrNode.Text

      else if AttrNode.NodeName = 'Visible' then
        NewMenuItem.Visible := StrToBool(AttrNode.Text);
    end;

    MenuItem.Add(NewMenuItem);
  end;

  if XmlNode.HasChildNodes then
    for intIdx := 0 to xmlNode.ChildNodes.Count - 1 do
      pXmlToMenu(xmlNode.ChildNodes.Nodes [intIdx], NewMenuItem, strProjeto, onClick, arrIgnorar);
end;

function CheckEdgeBrowser: Boolean;
var
  v         : PWideChar;
  h         : THandle;
  edgeFound : boolean;
begin
  Result := IsWindows10OrNewer;
  if Result Then
    exit;

  edgeFound := true;

  h := LoadLibrary(CoreWebView2DLL);

  if (h = 0) then
    edgeFound := false;

  try
    {$IFDEF LCLLIB}Pointer({$ENDIF}GetAvailableCoreWebView2BrowserVersionString{$IFDEF LCLLIB}){$ENDIF} := GetProcAddress(h, 'GetAvailableCoreWebView2BrowserVersionString');

    v := '';
    if Assigned(GetAvailableCoreWebView2BrowserVersionString) then
    begin
      GetAvailableCoreWebView2BrowserVersionString(nil, @v);
      if v = '' then
        edgeFound := false
      else
        edgeFound := true;
    end
    else
      edgeFound := false;

  finally
    FreeLibrary(h);
    Result := edgeFound;
  end;
end;

function IsWindows10OrNewer: Boolean;
const
  WINDOWS_10_MAJOR_VERSION = 10;
var
  OSVersionInfo: RTL_OSVERSIONINFOEXW;
  Status: LONG;
begin
  ZeroMemory(@OSVersionInfo, SizeOf(OSVersionInfo));
  OSVersionInfo.dwOSVersionInfoSize := SizeOf(OSVersionInfo);

  Status := RtlGetVersion(OSVersionInfo);
  if Status = 0 then
    Result := OSVersionInfo.dwMajorVersion >= WINDOWS_10_MAJOR_VERSION
  else
    Result := False;
end;

