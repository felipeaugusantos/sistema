    qryBusca.SQL.Add(' FOR_CODFOR  ');
    qryBusca.SQL.Add(' FROM CADFOR ');
    qryBusca.SQL.Add(' WHERE       ');
    qryBusca.SQL.Add(' FOR_C_G_C_ = :CGC ');
    qryBusca.SQL.Add(' ORDER BY    ');
    qryBusca.SQL.Add('     CASE    ');
    qryBusca.SQL.Add('         WHEN FOR_STATUS = ' +QuotedStr('A')+ ' THEN 1 ');
    qryBusca.SQL.Add('         WHEN FOR_STATUS = ' +QuotedStr('I')+ ' THEN 2 ');
    qryBusca.SQL.Add('         ELSE 3 ');
    qryBusca.SQL.Add('     END      ');

    qryBusca.ParamByName('CGC').AsString := strCnpj;

    qryBusca.Open;

    if not qryBusca.IsEmpty Then
      Result := qryBusca.FieldByName('FOR_CODFOR').AsString;

  Finally
    FreeAndNil(qryBusca);
  End
