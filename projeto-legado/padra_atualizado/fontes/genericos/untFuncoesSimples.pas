function fPedidoPossuiBrindesProdutos(strNumdoc, strEspDoc, strCodEmp: String): Boolean;
  var
    qryGen: TUniQuery;
begin
    qryGen := fCriaQuery(Nil);

    With qryGen, SQL Do
    Begin
      Close;
      Clear;
      Add('SELECT FDO_CODITE FROM FATDOR INNER JOIN BRIDOR ON BRI_SEQDET = AUTOINCREM');
      Add('WHERE FDO_NUMDOC = :NUMDOC AND FDO_ESPDOC = :ESPDOC AND FDO_CODEMP = :CODEMP');

      ParamByName('NUMDOC').AsString := strNumdoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      Result := Not IsEmpty;
    End;

    FreeAndNil(qryGen);
end;

function fPedidoPossuiBrindesServicos(strNumdoc, strEspDoc, strCodEmp: String): Boolean;
  var
    intSer: Integer;
    qryGen: TUniQuery;
begin
  Result := False;
    qryGen := fCriaQuery(Nil);

    With qryGen, SQL Do
    Begin
      Close;
      Clear;

      Add('SELECT ');

    For intSer := 1 To 30 Do
      Begin
        Add('  FGO_CODS' + fStrZero(intSer.ToString, 2) + ', ');
        Add('  FGO_BRIS' + fStrZero(intSer.ToString, 2) + ', ');
      End;

      Add('  FGO_TOTSER ');

      Add('FROM FATGOR INNER JOIN SERGOR ON SERGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ');
      Add('WHERE FGO_NUMDOC = :NUMDOC AND FGO_ESPDOC = :ESPDOC AND FGO_CODEMP = :CODEMP');

      ParamByName('NUMDOC').AsString := strNumdoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

    For intSer := 1 To 30 Do
        If (FieldByName('FGO_BRIS' + fStrZero(intSer.ToString, 2)).AsString = 'S') And
           (FieldByName('FGO_CODS' + fStrZero(intSer.ToString, 2)).AsString <> '') Then
        Begin
          Result := True;
        End;
    End;

    FreeAndNil(qryGen);
end;

