function fTamanhoArquivo(strArquivo: String): Int64;
var
  FS: TFileStream;
begin
  Result := 0;

  if not FileExists(strArquivo) then
    Exit;

  try
    FS := TFileStream.Create(strArquivo, fmOpenRead or fmShareDenyNone);
    try
      Result := FS.Size;
    finally
      FS.Free;
    end;
  except
    Result := 0;
  end;
end;

function fTamanhoArquivo(strArquivo: String; tipoTamanho: TTipoTamanhoArquivo): Int64; overload;
Var
  fltTamanhoReal : Double;
begin
  Result         := fTamanhoArquivo(strArquivo);
  fltTamanhoReal := Result;

  If Result = 0 Then
    Exit;

  If tipoTamanho In [ttTByte, ttGByte, ttMByte, ttKByte] Then
    fltTamanhoReal := fltTamanhoReal / 1024;

  If tipoTamanho In [ttTByte, ttGByte, ttMByte] Then
    fltTamanhoReal := fltTamanhoReal / 1024;

  If tipoTamanho In [ttTByte, ttGByte] Then
    fltTamanhoReal := fltTamanhoReal / 1024;

  If tipoTamanho In [ttTByte] Then
    fltTamanhoReal := fltTamanhoReal / 1024;

  Result := Trunc(fltTamanhoReal);

  If Abs(fltTamanhoReal - Result) > 0 Then
    Result := Result + 1;
end;

function fRetTaxJurosCondicao(const strCodCnd: String): Double;
  Var
