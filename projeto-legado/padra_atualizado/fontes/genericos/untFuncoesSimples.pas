function fRetornaDataTratada(strData : String) : String;
Var strDia, strMes, strAno : String;
    dtaData : TDatetime;
Begin
  Result := strData;
  If (Length(strData) >= 6) And (Pos('/',strData) <= 0) Then
  Begin
    strDia := Copy(strData,1,2);
    strMes := Copy(strData,3,2);
    strAno := Copy(strData,5,4);

    Try
      dtaData := StrToDateDef(strDia + '/' + strMes + '/' + strAno,0);
      Result  := FormatDateTime('dd/mm/yyyy',dtaData);
    Except
      Result := strData;
    End;
  End;
End;


