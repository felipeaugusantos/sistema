Function fSQLCarregaEstoqu(dtaBase : TDateTime) : String;
  Var
    blnTemInv : Boolean;
Begin
  Result := fSQLCarregaEstoqu(dtaBase, blnTemInv);
End;

Function fSQLCarregaEstoqu(dtaBase : TDateTime; Var blnTemInv : Boolean) : String;
  function fSqlSaldos: String;
  Begin
    Result := '(I.ITE_SALDOS + IF(IFNULL(CADITE.ITE_CNV_ML, 0) > 0, IFNULL(I.ITE_SAL_ML, 0) / CADITE.ITE_CNV_ML, 0))';
  End;

  Var
    strAux,
    strSQL,
    strData : String;

Begin

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  I.ITE_CODEMP, ';
  strSQL := strSQL + '  SUM((' + fSqlSaldos + ' * (ITE_PRECUS / IF((ITE_FATCNV = 0 OR ITE_FATCNV IS NULL), 1, ITE_FATCNV)))) AS ITE_SALDOS, ';
  strSQL := strSQL + '  SUM((' + fSqlSaldos + ' * (ITE_PREULT / IF((ITE_FATCNV = 0 OR ITE_FATCNV IS NULL), 1, ITE_FATCNV)))) AS ITE_PREULT, ';
  strSQL := strSQL + '  SUM((' + fSqlSaldos + ' * (ITE_IMPULT / IF((ITE_FATCNV = 0 OR ITE_FATCNV IS NULL), 1, ITE_FATCNV)))) AS ITE_IMPULT  ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  ITEGER I ';
  strSQL := strSQL + '  LEFT JOIN CADITE ON I.ITE_CODITE = CADITE.ITE_CODITE ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  ' + fSqlSaldos + ' > 0 AND ';
  strSQL := strSQL + '  LOCATE(I.ITE_CODEMP, :CODEMP) > 0 ';
  strSQL := strSQL + 'GROUP BY I.ITE_CODEMP ';

  strAux := strSQL;
  If (MonthOf(VS_Date) <> MonthOf(dtaBase)) or (YearOf(VS_Date) <> YearOf(dtaBase)) Then
  Begin
    strData := FormatDateTime('mm/yyyy', dtaBase);
    strData := 'I_' + RightStr(strData, 4) + LeftStr(strData, 2);

    blnTemInv := fTabelaExiste(strData);
    If blnTemInv Then
    Begin
      strAux  := AnsiReplaceStr( strSQL, 'ITEGER', strData );
      strAux  := AnsiReplaceStr( strAux, 'I.ITE_SAL_ML', '0' );
    End
    Else
    Begin
      strAux  := strSQL + ' LIMIT 0 ';
      strAux  := AnsiReplaceStr( strAux, 'I.ITE_SAL_ML', '0' );
    End;

  End;

  Result := strAux;

End;

Function fVerificaCampoPrcCmpImp(dtaBase: TDateTime): Boolean;
  Var
    strData: String;
Begin
  Result := True;

  strData := FormatDateTime('mm/yyyy', dtaBase);
  strData := 'I_' + RightStr(strData, 4) + LeftStr(strData, 2);

  If (fTabelaExiste(strData)) And (Not fCampoExiste(strData, 'ITE_IMPULT')) Then
  Begin
    fMensagem('', 'Não existe o valor de "PREÇO DE ULTIMA COMPRA + IMPOSTOS" (ITE_IMPULT) na tabela de inventário (' + strData +
                  '). Por favor entre em contato com a Citel para solcitar a geração do campo.', ['&O k']);
    Result := False;
  End;
End;


