function fValidaMesAno(mskMesAno: String; strInfErr: String): Boolean;
Begin
  If fEmptyStr(mskMesAno) Then
  Begin
    fMensagem('', strInfErr, ['&O k']);
    Result := False;
  End
  Else
  Begin

    Try
      Result := (StrToDateDef('01/' + mskMesAno, 0) > 0);

    Except
      fMensagem('', 'Mês / Ano inválido !', ['&O k']);
      Result := False;
    End;

  End;

End;

function fValidaMesAno(mskMesAno: TMaskEditFocus; strInfErr: String): Boolean;
  Var
    dtaMesAno: TDate;
Begin

  Result := True;

  If fEmptyStr(fTiraCaracEspeciais(mskMesAno.Text)) Then
  Begin
    fMensagem('', strInfErr, ['&O k']);
    Result := False;
  End
  Else
  Begin

    Try
      dtaMesAno := StrToDate('01/' + mskMesAno.Text);
      mskMesAno.Text := RightStr(DateToStr(dtaMesAno), 7);;

    Except
      fMensagem('', 'Mês / Ano inválido !', ['&O k']);
      Result := False;
    End;

  End;

End;
Function fValidaPercentual(strValor, strTitCam: String): Boolean;
Begin
  If (fStrToFloat(strValor) < 0) Or (fStrToFloat(strValor) >= 100) Then
  Begin
    pMensagemOk(strTitCam + ' deve ser maior ou igual a 0 e menor que 100%!');
    Result := False
  End

  Else Result := True;
End;

Function fValidaConversorCustoFor(strValor, strTitCam: String): Boolean;
Begin
  If (fStrToFloat(strValor) <= 0) Then
  Begin
    pMensagemOk(strTitCam + ' deve ser maior que zero!');
    Result := False
  End
  Else
    Result := True;
End;

Function fValidaValor(strValor, strTitCam: String): Boolean;
Begin
  If (fStrToFloat(strValor) < 0) Then
  Begin
    pMensagemOk(strTitCam + ' deve ser maior ou igual a 0!');
    Result := False
  End

  Else Result := True;
End;

{*************************************}
{* CONVERTE OS VALORES PARA GUARANI  *}
{* 1 -> Retorna Guarani              *}
{* 2 -> Retorna Dolar                *}
{* 3 -> Retorna Real                 *}
{* 4 -> Retorna Peso                 *}
{* 5 -> Retorna Euro                 *}
{**********************************LU*}
function fCon_Precos(fltPreAtu: Double; intTipPre: Integer; blnCalGua: Boolean; dtaDtaMoe: TDate; blnConGua: Boolean = False): Double;
Var
  qryGen   : TUniQuery;
  fltPreGua: Double;
  strSQL   : String;
Begin
  Result := 0;
  Try
    qryGen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT            ';
    strSQL := strSQL + '  *               ';
    strSQL := strSQL + 'FROM              ';
    strSQL := strSQL + '  CADMOE          ';
    strSQL := strSQL + 'WHERE             ';
    strSQL := strSQL + '  MOE_DTAMOE = :DTAMOE  ';
    strSQL := strSQL + 'ORDER BY          ';
    strSQL := strSQL + '  MOE_DTAMOE DESC ';
    strSQL := strSQL + 'LIMIT 1           ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('DTAMOE').AsDate := dtaDtaMoe;

      Open;

      {************************************}
      {* CALCULA PRECO EM "GUARANIES"     *}
      {*********************************LU*}
      fltPreGua := fltPreAtu;
      If blnCalGua Then
        fltPreGua := fFormataFloat(fltPreAtu * fieldbyname('MOE_DOLVEN').AsFloat, 2);

      {************************************}
      {* CASO OPCAO EM "GUARANIES"        *}
      {*********************************LU*}
      If intTipPre = 1 Then
        Result := fltPreGua;

      {************************************}
      {* CASO OPCAO EM "DOLAR"            *}
      {*********************************LU*}
      If intTipPre = 2 Then
      Begin
        If (blnConGua) Then
          Result := fFormataFloat(fltPreGua * fieldbyname('MOE_DOLCOM').AsFloat, 2)
        Else
          Result := fFormataFloat(fltPreGua / fieldbyname('MOE_DOLCOM').AsFloat, 2);
      End;

      {************************************}
      {* CASO OPCAO EM "REAL"             *}
      {*********************************LU*}
      If intTipPre = 3 Then
      Begin
        If (blnConGua) Then
          Result := fFormataFloat(fltPreGua * fieldbyname('MOE_REACOM').AsFloat, 2)
        Else
          Result := fFormataFloat(fltPreGua / fieldbyname('MOE_REACOM').AsFloat, 2);
      End;

      {************************************}
      {* CASO OPCAO EM "PESO"             *}
      {*********************************LU*}
      If intTipPre = 4 Then
      Begin
        If (blnConGua) Then
          Result := fFormataFloat(fltPreGua * fieldbyname('MOE_PARCOM').AsFloat, 2)
        Else
          Result := fFormataFloat(fltPreGua / fieldbyname('MOE_PARCOM').AsFloat, 2);
      End;

      {************************************}
      {* CASO OPCAO EM "EURO"             *}
      {*********************************LU*}
      If intTipPre = 5 Then
      Begin
        If (blnConGua) Then
          Result := fFormataFloat(fltPreGua * fieldbyname('MOE_EURCOM').AsFloat, 2)
        Else
          Result := fFormataFloat(fltPreGua / fieldbyname('MOE_EURCOM').AsFloat, 2);
      end;

    End;

  Finally
    FreeAndNil(qryGen);
  End;

End;

{********************************************************}
{* ADAPTACAO DA FUNCAO MES() P/ ESPANHOL                *}
{* CASO INTTAM = 1 FORMATA O MES COM 3 DIGITOS EX.: JAN *}
