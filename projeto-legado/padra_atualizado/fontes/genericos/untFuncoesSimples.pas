function fGetLetraAlfaAnterior(strLetra: String; intQtd: Integer=1): String;
  Var strAlfa: String;
      intAux: Integer;
Begin
  strAlfa := 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
