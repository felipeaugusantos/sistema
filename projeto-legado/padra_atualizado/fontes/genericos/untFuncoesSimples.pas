function fRetDocsDev(strNumDoc, strEspDoc, strCodEmp: String): String;
  Var
    qryGen: TUniQuery;
    strSQL: String;
Begin

  qryGen := fCriaQuery;
  With qryGen, SQL Do
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  DISTINCT ';
    strSQL := strSQL + '  DET_DOCDEV, ';
    strSQL := strSQL + '  DET_ESPDEV, ';
    strSQL := strSQL + '  DET_EMPDEV, ';
    strSQL := strSQL + '  (SELECT ';
    strSQL := strSQL + '     DATE_FORMAT(DET_DTAENT, "%d/%m/%Y") ';
    strSQL := strSQL + '   FROM ';
    strSQL := strSQL + '     MOVGER D ';
    strSQL := strSQL + '   WHERE ';
    strSQL := strSQL + '     D.GER_NUMDOC = DV.DET_DOCDEV AND ';
    strSQL := strSQL + '     D.GER_ESPDOC = DV.DET_ESPDEV AND ';
    strSQL := strSQL + '     D.GER_CODEMP = DV.DET_EMPDEV AND ';
    strSQL := strSQL + '     D.GER_CODCLI = DV.DET_CODCLI AND ';
    strSQL := strSQL + '     D.GER_TIP_FC = "C") AS DTADEV, ';
    strSQL := strSQL + '  (SELECT ';
    strSQL := strSQL + '     CONCAT(FIS_NUMCOO,"/",FIS_NUMSER) ';
    strSQL := strSQL + '   FROM ';
    strSQL := strSQL + '     CADFIS ';
    strSQL := strSQL + '   WHERE ';
    strSQL := strSQL + '     FIS_NUMDOC = DV.DET_DOCDEV AND ';
    strSQL := strSQL + '     FIS_ESPDOC = DV.DET_ESPDEV AND ';
    strSQL := strSQL + '     FIS_CODEMP = DV.DET_EMPDEV AND ';
    strSQL := strSQL + '     FIS_FORCLI = DV.DET_CODCLI AND ';
    strSQL := strSQL + '     FIS_TIP_FC = "C") AS  COOSER ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVDET DV ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP ';

    Add(strSQL);

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;
    Result := '';
    While Not Eof Do
    Begin
      Result := Result + IIF(Result <> '', ', ', '')
                       + FieldByName('DET_DOCDEV').AsString + '-'
                       + FieldByName('DET_ESPDEV').AsString + '-'
                       + FieldByName('DET_EMPDEV').AsString + '-'
                       + IIF(FieldByName('COOSER').AsString <> '', FieldByName('COOSER').AsString + '-', '')
                       + FieldByName('DTADEV').AsString;
      Next;
    End;
    Close;
  End;
  FreeAndNil(qryGen);
End;

