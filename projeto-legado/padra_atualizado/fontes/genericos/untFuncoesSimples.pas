    qryConsulta.ParamByName('SERIE_').AsString := strSerie;
    qryConsulta.ParamByName('CODEMP').AsString :=strCodEmp;
    Try
      qryConsulta.Open;
      Result := qryConsulta.FieldByName('QTD').AsInteger > 0
