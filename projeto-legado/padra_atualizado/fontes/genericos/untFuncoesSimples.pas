function fRestauraRegitro_DEL(strTabela: string; qryRegistro: TDataSet): Boolean;
var strSQL, strParamns: String;
    qryTabela, qryExc: TUniquery;
    i: Integer;
Begin
  Result := True;
  qryTabela := fCriaQuery;
  qryExc := fCriaQuery;
  Try
    Try
      If qryRegistro.IsEmpty Then
        Exit(True);

      qrytabela.SQL.Text := 'SELECT * FROM ' + strTabela  + ' WHERE FALSE ';
      qryTabela.Open;
      qryRegistro.First;

      While not qryRegistro.Eof do
      Begin
        strSQL := 'INSERT INTO ' + strTabela + '(';
        strParamns := '';
        For i := 0 To qryTabela.Fields.Count -1 do
        Begin
          If qryTabela.Fields.Count -1 <> i Then
          Begin
            strSQL := strSQL + qryTabela.Fields[i].FieldName + ',';
            strParamns := strParamns + ':' + qryTabela.Fields[i].FieldName + ',';
          End
          Else
          Begin
            strSQL := strSQL + qryTabela.Fields[i].FieldName  + ') VALUES (';
            strParamns := strParamns + ':' + qryTabela.Fields[i].FieldName + ');';
          End;
        End;
        strSQL := strSQL + strParamns;
        qryExc.SQL.Text := strSQL;
        For i := 0 To qryTabela.Fields.Count -1 do
        Begin
          qryExc.ParamByName(qryTabela.Fields[i].FieldName).Value := qryRegistro.FieldByName(qryTabela.Fields[i].FieldName).Value
        End;
        qryExc.ExecSQL;
        qryRegistro.Next;
      End;
    Except
      on e:Exception do
      Begin
        Result := False;
        pMensagensErro(e.Message, 'fRestauraRegitro_DEL');
      end;
    End;
  Finally
    freeAndNil(qryTabela);
    freeAndNil(qryExc);
  End;
End;

function GravaTabelaDelecao(AFormulario, ATabela: String; ARegistroDeletado: TDataSet): Boolean;
Const
  LArrayCamposIgnorados: Array of String = ['OPEDEL', 'DTADEL', 'HORDEL', 'MOTDEL'];

  Var
    LCamposTabelaDelecao: String;
    LParametrosTabelaDelecao: String;
    LGravarTabelaDelecao: TUniQuery;
    LCampo: TField;

  procedure GeraListaDeCamposTabelaDelecao;
    Var
      LConsulta: TUniQuery;

      LCampo: TField;
  Begin
    Try
      LConsulta := fCriarQuery('SELECT * FROM DEL_' + ATabela + ' WHERE FALSE');
      LConsulta.Open;

      LCamposTabelaDelecao := '';
      LParametrosTabelaDelecao := '';

      For LCampo In LConsulta.Fields Do
      Begin
        LCamposTabelaDelecao := LCamposTabelaDelecao + LCampo.FieldName + ',';
        LParametrosTabelaDelecao := LParametrosTabelaDelecao + ':' + LCampo.FieldName + ',';
      End;

      LCamposTabelaDelecao := LeftStr(LCamposTabelaDelecao, LCamposTabelaDelecao.Length - 1);
      LParametrosTabelaDelecao := LeftStr(LParametrosTabelaDelecao, LParametrosTabelaDelecao.Length - 1);

    Finally
      FreeAndNil(LConsulta);
    End;
  End;

Begin
  Result := False;

  Try
    GeraListaDeCamposTabelaDelecao;
    LGravarTabelaDelecao := fCriaQuery;

    Try

      If Not ARegistroDeletado.IsEmpty Then
      Begin

        LGravarTabelaDelecao.SQL.Text := 'INSERT INTO DEL_' + ATabela + ' (' + LCamposTabelaDelecao + ') ' +
                               ' VALUES (' + LParametrosTabelaDelecao + ') ';

        For LCampo In ARegistroDeletado.Fields Do
        Begin
          If MatchStr(LCampo.FieldName, LArrayCamposIgnorados) Then
            Continue;

          If Not LGravarTabelaDelecao.SQL.Text.Contains(LCampo.FieldName) Then
            Continue;

          LGravarTabelaDelecao.ParamByName(LCampo.FieldName).Value := LCampo.Value;
        End;

        LGravarTabelaDelecao.ParamByName('OPEDEL').AsString     := strLoginUsuarioLogado;
        LGravarTabelaDelecao.ParamByName('DTADEL').AsDateTime   := VS_Date;
        LGravarTabelaDelecao.ParamByName('HORDEL').AsString     := FormatDateTime('hh:mm:ss', fTime());

        If LGravarTabelaDelecao.SQL.Text.Contains('MOTDEL') Then
          LGravarTabelaDelecao.ParamByName('MOTDEL').AsString     := '';

        LGravarTabelaDelecao.ExecSQL;
        Result:= True;
      End;

    Except
      On E: Exception Do
        Raise Exception.Create(E.Message);
    End;
  Finally
    FreeAndNil(LGravarTabelaDelecao);
  End;

End;

{************************************************}
{* VERIFICA INTEGRIDADE DA TABELA CRIA TABELA   *}
{* DE DELETADOS SE NÃO EXISTIR CRIA, SE EXISTIR *}
{* VERIFICA E DEPOIS GRAVA                      *}
{*********************************************AF*}
function fVerificaIntegridade(strNomFrm,
                              strTabela: String;
                              qryTabOriginal: TDataSet;
                              blnGravar: Boolean = True;
                              blnSoCriaTabela: Boolean = False;
                              strMotDel: String = '';
                              strOpeDel: String = '';
                              blnTabAux: Boolean = False;
                              strOpcDel: String = ''): String;
  Var
    strValStr,
    strSQL: String;
    intAux,
    intContador: Integer;
    qryGenIte: TUniQuery;
    qryGenTmp: TUniQuery;
    qryGenDel: TUniQuery;
    qryGenReq: TUniQuery;
    blnTeveNf: Boolean;
    blnGrvOpcDel: Boolean;

    function fRequeridoNatTabDel(strCampo:String):Boolean;
    begin
      Result:=False;

      If Not Assigned(qryGenReq) Then
      Begin
        qryGenReq := fCriaQuery;

        With qryGenReq Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add('DESCRIBE DEL_' + strTabela);
          Open;
        End;
      End;

      If qryGenReq.Locate('Field', strCampo, [loCaseInSensitive]) Then
      Begin
        Result := (AnsiUpperCase(qryGenReq.FieldByName('Null').Text) <> 'YES') And (AnsiUpperCase(qryGenReq.FieldByName('Null').Text) <> 'Y');
      End;
    end;

    procedure pAdicionaPrimaryKeyDeletada(strTabela: String; qryTabela: TUniQuery);
      Var
        blnCriar  : Boolean;
        qryGenUpd : TUniQuery;
    begin
      Try
        qryGenUpd := fCriaQuery;

        qryTabela.First;
        blnCriar := (Not qryTabela.Locate('Key', 'PRI', []));

        If (blnCriar) Then
        Begin

          If (strTabela = 'NOTCOM') Then
          Begin
            qryGenUpd.Close;
            qryGenUpd.SQL.Clear;
            qryGenUpd.SQL.Add('ALTER TABLE DEL_' + strTabela + ' ADD PRIMARY KEY (GER_SEQGER, GER_CODEMP) ');
            qryGenUpd.ExecSQL;
            qryGenUpd.Close;
          End
          Else
          Begin
            qryGenUpd.Close;
            qryGenUpd.SQL.Clear;
            qryGenUpd.SQL.Add('ALTER TABLE DEL_' + strTabela + ' ADD PRIMARY KEY (AUTOINCREM) ');
            qryGenUpd.ExecSQL;
            qryGenUpd.Close;
          End;

        End;

      Finally
        FreeAndNil(qryGenUpd);
      End;

    end;

begin

  If fEmptyStr(strOpeDel) Then
    strOpeDel := strLoginUsuarioLogado;

  Try
    qryGenIte := fCriaQuery;
    qryGenTmp := fCriaQuery;
    qryGenDel := fCriaQuery;

    Result := '';
    blnTeveNf := False;
    blnGrvOpcDel := False;

    If (Not blnSoCriaTabela) And (qryTabOriginal.IsEmpty) Then
      Exit;

    Try
      {********************************}
      {* DESCRIÇÃO DA TABELA ORIGINAL *}
      {*****************************AF*}
      strSQL := '';
      strSQL := strSQL + 'DESCRIBE ';
      strSQL := strSQL + strTabela;
      With qryGenIte Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        Open;
      End;

      If fTabelaExiste('DEL_' + strTabela) Then
      Begin
        {***********************}
        {* SE A TABELA EXISTIR *}
        {********************AF*}
        With qryGenDel Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add('DESCRIBE DEL_' + strTabela);
          Open;
        End;

        If qryGenDel.Locate('Field', 'AUTOINCREM', []) Then
        Begin
          {*********************************************}
          {* CASO A TABELA DE DELETADOS JA EXISTA, E   *}
          {* NAO TENHA PRIMARY KEY, CRIA A PRIMARY KEY *}
          {******************************************MV*}
          pAdicionaPrimaryKeyDeletada(strTabela, qryGenDel);
        End;

        blnGrvOpcDel := (Not strOpcDel.IsEmpty) And (qryGenDel.Locate('Field', 'OPCDEL', []));

        qryGenIte.First;
        qryGenDel.First;
        {***************************************}
        {* VERIRFICA SE OS CAMPOS ESTÃO IGUAIS *}
        {************************************AF*}
        For intContador := 0 To qryGenIte.RecordCount-1 Do
        Begin
          {********************}
          {* SE CAMPO EXISTIR *}
          {*****************AF*}
          If qryGenDel.Locate('Field', qryGenIte.FieldByName('Field').AsString, [loCaseInSensitive]) Then
          Begin
            {***************************}
            {* SE O TIPO FOR DIFERENTE *}
            {************************AF*}

            (*********************************************************************************************)
            (* RETIRADO POIS NAS TABELAS CRIADAS COMO CHARSET=utf8 O CHAR(X) ESTA FICANDO COM VARCHAR(X) *)
            (* FAZENDO COM QUE O MODIFY SEJA EXECUTADO A TODA HORA DEIXANDO A ROTINA LENTA               *)
            (******************************************************************************************LA*)

            {
            If qryGenIte.FieldByName('Type').AsString <> qryGenDel.FieldByName('Type').AsString Then
            Begin
              strSQL := '';
              strSQL := strSQL + 'ALTER TABLE DEL_';
              strSQL := strSQL + strTabela;
              strSQL := strSQL + ' MODIFY ';
              strSQL := strSQL + qryGenIte.FieldByName('Field').AsString;
              strSQL := strSQL + ' ';
              strSQL := strSQL + qryGenIte.FieldByName('Type').AsString;
              With qryGenTmp Do
              Begin
                Close;
                SQL.Clear;
                SQL.Add(strSQL);
                ExecSQL;
                qryGenIte.Next;
              End;
            End
            Else }
            Begin
              qryGenIte.Next;
            End;
          End
          Else
          {**************************}
          {* SE O CAMPO NÃO EXISTIR *}
          {***********************AF*}
          Begin
            strSQL := '';
            strSQL := strSQL + 'ALTER TABLE DEL_';
            strSQL := strSQL + strTabela;
            strSQL := strSQL + ' ADD ';
            strSQL := strSQL + qryGenIte.FieldByName('Field').AsString;
            strSQL := strSQL + ' ';
            strSQL := strSQL + qryGenIte.FieldByName('Type').AsString;
            With qryGenTmp Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add(strSQL);
              ExecSQL;
            End;
            qryGenIte.Next;
          End;
        End;
      End
      Else
      Begin
        {***************************}
        {* SE A TABELA NÃO EXISTIR *}
        {************************AF*}
        strSQL := '';
        strSQL := strSQL + 'CREATE TABLE ';
        strSQL := strSQL + 'DEL_' + strTabela + ' ( ';
        qryGenIte.First;

        {********************************************************}
        {* PEGA OS CAMPOS DA TABELA ORIGINAL E COLOCA NA STRING *}
        {*****************************************************AF*}
        For intContador := 1 To qryGenIte.RecordCount Do
        Begin
          If intContador <> qryGenIte.RecordCount Then
          Begin
            strSQL := strSQL + qryGenIte.FieldByName('Field').AsString;
            strSQL := strSQL + ' ' + qryGenIte.FieldByName('Type').AsString + ', ';
          End
          Else
          Begin
            strSQL := strSQL + qryGenIte.FieldByName('Field').AsString;
            strSQL := strSQL + ' ' + qryGenIte.FieldByName('Type').AsString;
            strSQL := strSQL + ', OPEDEL VARCHAR(50)';
            strSQL := strSQL + ', DTADEL DATE';
            strSQL := strSQL + ', HORDEL VARCHAR(10) ';

            If Pos(strTabela, 'MOVGER_NOTGER_FATGOR_') > 0 Then
            Begin
              strSQL := strSQL + ', MOTDEL VARCHAR(255) ';
              strSQL := strSQL + ', OPCDEL VARCHAR(10) ';
            End;

            {*******************************************}
            {* CRIA PRIMARY KEY                        *}
            {****************************************MV*}
            If (Pos('AUTOINCREM', strSQL) > 0) Then
            Begin
              strSQL := strSQL + ', PRIMARY KEY (AUTOINCREM) ';
            End;

            strSQL := strSQL + ' ) ENGINE=InnoDB; ';

          End;
          qryGenIte.Next;
        End;

        With qryGenDel Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ExecSQL;
        End;

      End;

      If blnSoCriaTabela Then
      Begin
        FreeAndNil(qryGenTmp);
        FreeAndNil(qryGenDel);
        FreeAndNil(qryGenIte);
        Exit;
      End;

      {**************************************}
      {* GRAVA NA TABELA ORIGINAL OS CAMPOS *}
      {***********************************AF*}
      strSQL := '';
      strSQL := strSQL + 'REPLACE INTO DEL_' + strTabela + ' ( ';
      {******************}
      {* PEGA os CAMPOS *}
      {***************AF*}
      For intContador := 0 To qryTabOriginal.FieldCount-1 Do
      Begin
        If qryTabOriginal.Fields[intContador].FieldKind = fkData Then
        Begin
          strSQL := strSQL + qryTabOriginal.Fields[intContador].FieldName;
          {*****************************************************}
          {* ALTERADO PARA GRAVAR NOMFRM NO CADPAG E NO CTPDET *}
          {*25/04/2012***************************************JU*}
          If Pos('_NOMFRM', qryTabOriginal.Fields[intContador].FieldName) > 0 Then
            blnTeveNf := True;
        End;

        If intContador <> qryTabOriginal.FieldCount-1 Then
          If qryTabOriginal.Fields[intContador+1].FieldKind = fkData Then
            strSQL := strSQL + ', ';
      End;

      If (Not blnTeveNf) And (Pos(strTabela,'CADCHQ') > 0)  Then
        strSQL := strSQL + ', CHQ_NOMFRM';

      If Pos(strTabela, 'MOVGER_NOTGER_FATGOR_') > 0 Then
        strSQL := strSQL + ', OPEDEL, DTADEL, HORDEL, MOTDEL '+IIF(blnGrvOpcDel,' ,OPCDEL ',' ')+' ) VALUES ( '
      Else
        strSQL := strSQL + ', OPEDEL, DTADEL, HORDEL ) VALUES ( ';

      {*******************}
      {* PEGA OS VALORES *}
      {****************AF*}
      For intContador := 0 To qryTabOriginal.FieldCount-1 Do
      Begin
        {*************************************************}
        {* VERIFICA SE É DATA PARA FORMATAR CORRETAMENTE *}
        {**********************************************AF*}
        If qryTabOriginal.Fields[intContador].FieldKind = fkData Then
        Begin
          If (qryTabOriginal.Fields[intContador].DataType = ftDate)    Or
            (qryTabOriginal.Fields[intContador].DataType = ftDateTime) Then
          Begin
            {**********************}
            {* VERIFICA SE É NULO *}
            {*******************AF*}
            If Pos('_NOMFRM', qryTabOriginal.Fields[intContador].FieldName) > 0 Then
              strSQL := strSQL + QuotedStr(strNomfrm)

            Else If qryTabOriginal.Fields[intContador].AsString = '' Then
              strSQL := strSQL + 'NULL'
            Else
              strSQL := strSQL + QuotedStr(FormatDateTime('yyyy-mm-dd', qryTabOriginal.Fields[intContador].AsDateTime));

          End
          Else If (qryTabOriginal.Fields[intContador].DataType = ftTime) Then
            If qryTabOriginal.Fields[intContador].AsString = '' Then
              strSQL := strSQL + 'NULL'
            Else
              strSQL := strSQL + QuotedStr(FormatDateTime('hh:mm:ss', qryTabOriginal.Fields[intContador].AsDateTime))

          Else
            {**********************}
            {* VERIFICA SE É NULO *}
            {*******************AF*}
            If qryTabOriginal.Fields[intContador].AsString = '' Then
            Begin
              If Pos('_NOMFRM', qryTabOriginal.Fields[intContador].FieldName) > 0 Then
                strSQL := strSQL + QuotedStr(strNomfrm)
              Else If qryTabOriginal.Fields[intContador].Required Or
                      fRequeridoNatTabDel(qryTabOriginal.Fields[intContador].FieldName) Then
                strSQL := strSQL + QuotedStr('')
              Else
                strSQL := strSQL + 'NULL';
            End
            Else
              If (qryTabOriginal.Fields[intContador].DataType = ftString) Or
                 (qryTabOriginal.Fields[intContador].DataType = ftMemo) Or
                 ((qryTabOriginal.Fields[intContador].DataType = ftBlob) And
                  ((SameText(strTabela, 'CADMOD') OR SameText(strTabela, 'CADREL') OR SameText(strTabela, 'CADCER')))) Then
              Begin
                If (qryTabOriginal.Fields[intContador].DataType = ftMemo) Then
                  strSQL := strSQL + QuotedStr(fTiraCaracEspeciais(fTiraEnter(qryTabOriginal.Fields[intContador].AsString)))
                Else
                Begin
                  strValStr := qryTabOriginal.Fields[intContador].AsString;

                  If (RightStr(strValStr, 1) = '\') Then
                  Begin
                    intAux := 0;

                    While (RightStr(strValStr, 1) = '\') Do
                    Begin
                      strValStr := Copy(strValStr, 1, Length(strValStr)-1);
                      Inc(intAux);
                    End;

                    If (intAux > 0) Then
                    Begin
                      If ((intAux Mod 2) <> 0) Then
                        intAux := ((intAux+1)*2);

                      strValStr := strValStr + StringOfChar('\', intAux);
                    End;
                  End;

                  strSQL := strSQL + QuotedStr(strValStr);
                End
              End

              Else If (qryTabOriginal.Fields[intContador].DataType = ftFloat)    Or
                      (qryTabOriginal.Fields[intContador].DataType = ftCurrency) Or
                      (qryTabOriginal.Fields[intContador].DataType = ftBCD)      Then
              Begin
                strSQL := strSQL + AnsiReplaceStr(qryTabOriginal.Fields[intContador].AsString, ',', '.');
              End

              Else
                strSQL := strSQL + qryTabOriginal.Fields[intContador].AsString;
        End;

        If intContador <> qryTabOriginal.FieldCount-1 Then
          If qryTabOriginal.Fields[intContador+1].FieldKind = fkData Then
            strSQL := strSQL + ', ';
      End;

      strSQL := strSQL + ', ' + QuotedStr(strOpeDel);
      strSQL := strSQL + ', ' + fCurrentDate + ' ';
      strSQL := strSQL + ', ' + QuotedStr(FormatDateTime('hh:mm:ss', VS_Date + fTime()));

      If Pos(strTabela, 'MOVGER_NOTGER_FATGOR') > 0 Then
        strSQL := strSQL + ', ' + QuotedStr(strMotDel) + IIF(blnGrvOpcDel,' ,'+QuotedStr(strOpcDel),' ') + ' )'
      Else
        strSQL := strSQL + ' )';

      If blnGravar Then
      Begin
        With qryGenDel Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ExecSQL;
        End;

        If Not blnTabAux Then
          pVerificaIntegridadeComplementar(strNomFrm,
                                           strTabela,
                                           qryTabOriginal,
                                           blnGravar,
                                           blnSoCriaTabela,
                                           strMotDel,
                                           strOpeDel);

      End
      Else
        Result := strSQL;

    Except
      On E:Exception Do
      Begin
        Result := '';

        Raise Exception.Create('Ocorreu um erro durante a gravação do arquivo de deletado(s).' + #13 + E.Message + #13 +
                               'Tabela: ' + strTabela + '.');
      End;
    End;

  Finally
    FreeAndNil(qryGenTmp);
    FreeAndNil(qryGenDel);
    FreeAndNil(qryGenIte);
    If Assigned(qryGenReq) Then
      FreeAndNil(qryGenReq);
  End;

End;

{*****************************************}
{* VERIFICA SE A TABELA EXISTE NO BANCO  *}
{* ATUAL.                                *}
{**************************************MV*}
function fTabelaExiste(const strNomeTabela: String; blnUsarCache : Boolean = False; Conexao: TUniConnection = Nil): Boolean;
var
  conConexao: TUniConnection;
Begin
  conConexao := Conexao;

  If not Assigned(conConexao) Then
    conConexao := frmModulo.GetCurrentConnection;

  result := fTabelaExisteFat(strNomeTabela, conConexao, blnUsarCache);
End;

function fCurrentTime: String;
begin
  Result := 'CAST("' + FormatDateTime('hh:mm:ss', fRetHoraServidor) + '" AS TIME)';
end;

function fCurrentDate: String;
begin
  Result := fCurrentDate(VS_Date);
end;

function fCurrentDate(Const Value: TDateTime): String;
begin
  Result := 'CAST("' + FormatDateTime('yyyy-mm-dd', Value) + '" AS DATE)';
end;

function fCurrentDateTime: String;
begin
  Result := fCurrentDateTime(VS_Date + fTime());
end;

function fCurrentDateTime(Const Value: TDateTime): String;
begin
  Result := 'CAST("' + FormatDateTime('yyyy-mm-dd hh:mm:ss', Value) + '" AS DATETIME)';
end;

{***********************************************************}
{* RETORNA A DATA E HORA DO SERVIDOR ***********************}
{***********************************************************}
{ Na função foi mantido a utilização da função nOw() do     }
{  Delphi, caso a variável VS_Date ainda não estiver ini-   }
{  nicializada, pois, na inicialização do sistema a va-     }
{  riável VS_DATE ainda está nula em alguns pontos. Como    }
{  as funções de retorno de nome de tabelas TMP (que se-    }
{  rão removidas futuramente) se baseiam na data e hora     }
{  para nomear as tabelas, esta deve receber corretamente a }
{  data e hora para criação das tabelas no banco de dados.  }
{  Há também uma questão na inicialização de variáveis glo- }
{  bais que também justifica essa utilização temporariamen- }
{  te (Alexandre ciente). Pontos a serem avaliados:         }
{   - untFuncoes.fGetMemoryTableNameBarrasFabrica           }
{   - untFuncoesSimples.fGetMemoryTableNameEntregaFutura    }
{   - untFuncoesSimples.VS_dtaUltimaExecucaoImportadorPDV   }
{     * avaliar no 'inicialization' da unit                 }
{********************************************************DF*}
function fNow: TDateTime;
begin
  Result := IfThen(Trunc(VS_Date) = 0, nOw(), VS_Date + fTime());
end;

{*******************************************}
{* VERIFICA DIREITO DE ACESSO ESPECÍFICO E *}
{* RETORNA O CAMPO DIR_ACAOUS              *}
{****************************************AF*}
function fVerificaDirEspecificos(Var strDireitos: String; strLogin, strNomeForm: String): Boolean;
Begin
  If fEhAdministrador(strLogin) Then
  Begin
    strDireitos := 'IAE';
    Exit(True);
  End;

  If dicDireitosEspecificos.ContainsKey(strLogin + strNomeForm) Then
  Begin
    strDireitos := dicDireitosEspecificos[strLogin + strNomeForm];
    Result := Not fEmptyStr(strDireitos);
    Exit;
  End;

  {*********************************************}
  {* VERIFICA DIREITOS ESPECIFICOS DO OPERADOR *}
  {******************************************AF*}
  strDireitos := fCampoTabela('DIR_ACAOUS', 'DIROPE', ['OPE_CODOPE', 'DIR_NOMFRM'], [strLogin, strNomeForm], False);

  Result := Not fEmptyStr(strDireitos);

  If Not Result Then
  Begin
    {********************************************}
    {* SE ESTIVER VAZIO ENTAO PROCURA NO CADGPO *}
    {*****************************************AF*}
    strDireitos := fCampoTabela('GROUP_CONCAT(DIR_ACAOUS) AS DIR_ACAOUS', 'DIRGPO D JOIN OPEGPO G ON D.GPO_CODGPO = G.GPO_CODGPO',
                                ['G.OPE_CODOPE', 'D.DIR_NOMFRM'], [strLogin, strNomeForm], False);
    Result := Not fEmptyStr(strDireitos);
  End;

  dicDireitosEspecificos.AddOrSetValue(strLogin + strNomeForm, strDireitos);
End;

function fValidarDirEspecificos(Var strDireitos: String; strLogin, strNomeForm: String): Boolean;
begin
  If fVerificaDirEspecificos(strDireitos, strLogin, strNomeForm) Then
    Exit(True);

  If Assigned(fExisteDireitoAcesso) And fExisteDireitoAcesso(strNomeForm) Then
    Exit(True);

  Result := False;
end;

function fRetTamCampo(const strNomeTabela: String): Integer;
begin
  Try
    Result := fCampoTabela('PRO_TAMCOD', 'PROCOD', ['PRO_NOMARQ'], [strNomeTabela], False);
  Except
    Result := 0;
  End;
end;

function fGetSelectProcodDoArquivoForUpdate : String;
begin
  Result := EmptyStr;
  Result := Result + 'SELECT SQL_NO_CACHE ';
  Result := Result + '  PRO_CODSEQ AS CODSEQ, ';
  Result := Result + '  PRO_TAMCOD AS TAMCOD, ';
  Result := Result + '  PRO_SEQEMP AS SEQEMP  ';
  Result := Result + 'FROM ';
  Result := Result + '  PROCOD ';
  Result := Result + 'WHERE ';
  Result := Result + '  PRO_NOMARQ = :NOMARQ ';
  Result := Result + ' FOR UPDATE ';
end;

function fGetUpdateProcodDoArquivo : String;
begin
  Result := EmptyStr;
  Result := Result + ' UPDATE ';
  Result := Result + '   PROCOD ';
  Result := Result + ' SET ';
  Result := Result + '   PRO_CODSEQ = :CODSEQ ';
  Result := Result + ' WHERE ';
  Result := Result + '   PRO_NOMARQ = :NOMARQ ';
end;

{**************************************************}
{* PEGA O PROXIMO CODIGO E ATUALIZA TABELA PROCOD *}
{* ADICIONADO UM PARÂMETRO PARA ATUALIZAR UMA SE- *}
{* QUÊNCIA DE CÓDIGOS                             *}
{********************************************MV*AJ*}
function fAtualizaProCod(const strNomeTabela : String; const strCampoBusca : String; const strTabelaBusca : String = ''; const intQtdCod : Integer = 1; objConnection : TUniConnection = Nil; const objFncFmt : TFcnFormataProCod = Nil): String;//>Compatibilidade
  Var
    strSQL : String;
    intCodigoAtual : Int64;
    intTamCodigo : Integer;
    blnComita : Boolean;
    qryGenCod : TUniQuery;
    blnCodPorEmpresa : Boolean;
begin
  pValidaProCod(strNomeTabela);

  If Not Assigned(objConnection) then
    objConnection := frmModulo.GetCurrentConnection;

  qryGenCod := fCriaQuery(Nil, objConnection);
  Try
    blnComita := False;

    If Not objConnection.InTransaction Then
    Begin
      fStartTransaction(objConnection);
      blnComita := True;
    End;

    Try
      strSQL := fGetSelectProcodDoArquivoForUpdate;
      qryGenCod.Close;
      qryGenCod.SQL.Clear;
      qryGenCod.SQL.Add(strSQL);
      qryGenCod.ParamByName('NOMARQ').AsString := strNomeTabela;
      qryGenCod.Open;

      pCadastrarProcodProinc(qryGenCod, strSQL, strNomeTabela);

      intCodigoAtual := StrToInt64(qryGenCod.FieldByName('CODSEQ').AsString);
      intTamCodigo := qryGenCod.FieldByName('TAMCOD').AsInteger;
      blnCodPorEmpresa := (qryGenCod.FieldByName('SEQEMP').AsString = 'S');

      pValidarProximoCodigo(intCodigoAtual, intTamCodigo, blnCodPorEmpresa, intQtdCod, strCampoBusca, IIF(fEmptyStr(strTabelaBusca), strNomeTabela, strTabelaBusca), objConnection, objFncFmt);

      strSQL := fGetUpdateProcodDoArquivo;
      qryGenCod.Close;
      qryGenCod.SQL.Clear;
      qryGenCod.SQL.Add(strSQL);
      qryGenCod.ParamByName('CODSEQ').AsString := fPadL(IntToStr(intCodigoAtual+intQtdCod), intTamCodigo, '0');
      qryGenCod.ParamByName('NOMARQ').AsString := strNomeTabela;
      qryGenCod.ExecSQL;

      Result := fProximoCodigoFormatado(blnCodPorEmpresa, intCodigoAtual, intQtdCod, intTamCodigo);

      If (Assigned(objFncFmt)) Then
        Result := objFncFmt(Result);

      If blnComita Then
        fCommit(objConnection);
    Except
      On E: Exception Do
      Begin
        If blnComita Then
          fRollBack(objConnection);
        Raise ExceptClass(E.ClassType).Create('Não consegui pegar o proximo sequencial de ' + strNomeTabela +
         ' em PROCOD. Tente novamente! ' + sLineBreak + '[' + E.Message + ']');
      End;
    End;
  Finally
    FreeAndNil(qryGenCod);
  End;
end;

function fProximoCodigoFormatado(const blnCodPorEmpresa : Boolean; const intCodigoAtual : Int64; const intQtdCod, intTamCodigo : Integer) : String;
begin
  If (blnCodPorEmpresa) Then
    Result := fPadL(IntToStr(intCodigoAtual + intQtdCod), intTamCodigo-3, '0') + VS_strCodEmp
  Else
    Result := fPadL(IntToStr(intCodigoAtual), intTamCodigo, '0');
end;

procedure pCadastrarProcodProinc(Var qryProcod : TUniQuery; Const strSQL, strNomeTabela : String);
  Var
    intContador : Integer;
begin
  If (Not qryProcod.IsEmpty) Then
    Exit;

  qryProcod.Close;

  For intContador := 0 To Length(arrProCod) - 1 Do
  Begin
    If (strNomeTabela <> arrProCod[intContador].strNomArq)  Then
      Continue;

    qryProcod.SQL.Clear;
    qryProcod.SQL.Add(' SELECT * FROM PROCOD');
    qryProcod.Open;
    qryProcod.Insert;
    qryProcod.FieldByName('PRO_NOMARQ').AsString  := arrProCod[intcontador].strNomArq;
    qryProcod.FieldByName('PRO_CODSEQ').AsString  := arrProCod[intcontador].strCodSeq;
    qryProcod.FieldByName('PRO_TAMCOD').AsInteger := arrProCod[intcontador].intTamCod;
    qryProcod.FieldByName('AUTOINCREM').AsString  := fRetAutoIncrem('PROCOD',VS_strCodEmp);
    qryProcod.FieldByName('PRO_CODEMP').AsString  := fRetEmpresaFisica;
    qryProcod.FieldByName('PRO_CODAUT').AsString  := 'S';
    qryProcod.Post;

    qryProcod.Close;
    qryProcod.SQL.Clear;
    qryProcod.SQL.Add(' SELECT * FROM PROINC WHERE PRO_NOMARQ = :NOMARQ');
    qryProcod.ParamByName('NOMARQ').AsString := arrProCod[intcontador].strNomArq;
    qryProcod.Open;

    If qryProcod.IsEmpty Then
    Begin
      qryProcod.Insert;
      qryProcod.FieldByName('PRO_NOMARQ').AsString  := arrProCod[intcontador].strNomArq;
      qryProcod.FieldByName('PRO_AUTINC').AsString  := '1';
      qryProcod.FieldByName('AUTOINCREM').AsString  := fRetAutoIncrem('PROCOD',VS_strCodEmp);
      qryProcod.Post;
    End;

    qryProcod.Close;
    Break;
  End;

  qryProcod.SQL.Clear;
  qryProcod.SQL.Add(strSQL);
  qryProcod.ParamByName('NOMARQ').AsString := strNomeTabela;
  qryProcod.Open;
  If qryProcod.IsEmpty Then
  Begin
    qryProcod.Close;
    Raise Exception.Create('A tabela ' + strNomeTabela + ' não está cadastrada ' +
                           'na tabela de Próximos Codigos! Verifique.' + #13#10);
  End;
end;

function fLoteExiste(strCodIte: String; strCodEmp : String = ''): Boolean;
  Var
    qryCadLot: TUniQuery;
Begin

  Result := False;

  strCodEmp := IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);

  qryCadLot := fCriaQuery(Nil);

  Try

    Try

      qryCadLot.SQL.Add('SELECT ');
      qryCadLot.SQL.Add('  LOT_NUMLOT ');
      qryCadLot.SQL.Add('FROM ');
      qryCadLot.SQL.Add('  CADLOT ');
      qryCadLot.SQL.Add('WHERE ');
      qryCadLot.SQL.Add('  LOT_CODITE = :CODITE AND ');
      qryCadLot.SQL.Add('  LOT_CODEMP = :CODEMP LIMIT 1 ');

      qryCadLot.ParamByName('CODITE').AsString := strCodIte;
      qryCadLot.ParamByName('CODEMP').AsString := strCodEmp;
      qryCadLot.Open;

      Result := Not qryCadLot.IsEmpty;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[fExisteLote]');
    End;

  Finally
    FreeAndNil(qryCadLot);
  End;

end;

function fExisteRegistroProcod(const objConnection : TUniConnection; const strCampoBusca, strTabelaBusca : String; const intCodigoAtual : Int64; const blnCodPorEmpresa : Boolean; const intTamCodigo, intQtdCod : Integer; const objFncFmt : TFcnFormataProCod) : Boolean;

  function fProximoCodigoFormatadoFinal(const ACodigoAtual : Int64; const AQtdCodigo : Integer) : String;
  begin
    Result := fProximoCodigoFormatado(blnCodPorEmpresa, ACodigoAtual, AQtdCodigo, intTamCodigo);
    If Not Assigned(objFncFmt) Then
      Exit;
    Result := objFncFmt(Result);
  end;

  function fInProcod : String;
    Var
      strValues : String;
      intCnt : Int64;
      intFaixaInicial : Int64;
      intFaixaFinal : Int64;
  begin
    strValues := '';
    intFaixaInicial := intCodigoAtual;
    intFaixaFinal := intCodigoAtual + intQtdCod;

    For intCnt := intFaixaInicial To intFaixaFinal Do
    Begin
      If fEmptyStr(strValues) Then
        strValues := QuotedStr(fProximoCodigoFormatadoFinal(intCnt, 0))
      Else
        strValues := strValues + ',' + QuotedStr(fProximoCodigoFormatadoFinal(intCnt, 0));
    End;
    If fEmptyStr(strValues) Then
      strValues := '''';
    Result := strValues;
  end;

  Var
    qryBusca : TUniQuery;
begin
  qryBusca := fCriaQuery(Nil, objConnection);
  Try
    qryBusca.Close;
    qryBusca.SQL.Clear;
    If (intQtdCod = 1) Then
    Begin
      qryBusca.SQL.Add(' SELECT ' + strCampoBusca);
      qryBusca.SQL.Add('   FROM ' + strTabelaBusca);
      qryBusca.SQL.Add('  WHERE ' + strCampoBusca + ' = :CODIGO ');
      qryBusca.ParamByName('CODIGO').AsString := fProximoCodigoFormatadoFinal(intCodigoAtual, intQtdCod);
    End
    Else
    Begin
      qryBusca.SQL.Add(' SELECT ' + strCampoBusca);
      qryBusca.SQL.Add('   FROM ' + strTabelaBusca);
      qryBusca.SQL.Add('  WHERE ' + strCampoBusca + ' IN (' + fInProcod + ')' );
    End;
    qryBusca.Open;
    Result := (Not qryBusca.IsEmpty);
  Finally
    FreeAndNil(qryBusca);
  End;
end;

procedure pNotificaFormGravandoAtivo(const strMessage : String);
  Var
    intCnt: Integer;
    lblMensagem : TComponent;
begin
  For intCnt := Screen.FormCount -1 Downto 0 Do
  Begin
    If (Screen.Forms[intCnt].Name = '') Then
      Continue;
    If (Pos('frmGravando', Screen.Forms[intCnt].Name) > 0) Then
    Begin
      lblMensagem := Screen.Forms[intCnt].FindComponent('lblGravando');
      If (lblMensagem <> Nil) And (lblMensagem Is TLabel) Then
      Begin
        TLabel(lblMensagem).Caption := strMessage;
        pProcessMessages(True);
      End;
    End;
  End;
end;


function fFormAtivo(const strFormName : String) : Boolean;
  Var
    intCnt : Integer;
begin
  Result := False;
  For intCnt := Screen.FormCount -1 Downto 0 Do
  Begin
    If (Screen.Forms[intCnt].Name = '') Then
      Continue;
    If (Pos(strFormName, Screen.Forms[intCnt].Name) > 0) Then
    Begin
      Result := True;
      Exit;
    End;
  End;
end;

function fRetornaStack: String;
begin
{$IFDEF LINUX}
  Result := EmptyStr;
{$ELSE}
  Try
    Raise EDumpStackTrace.Create(EDumpStackTrace.ClassName);
  Except
    On E: Exception Do
      Result := E.StackTrace;
  End;
{$ENDIF}
end;

function fGetNomeFormularios: String;
  Var
    intIdx: Integer;
    intRec: Integer;
    LblMensagem : TComponent;
begin
  Result := '';
  intRec := 0;
  For intIdx := Screen.FormCount -1 Downto 0 Do
  Begin
    If (Screen.Forms[intIdx].Name <> '') Then
    Begin
      If Pos('frmFatResolveConflitoPedidos', Screen.Forms[intIdx].Name) > 0 Then
      Begin
        If (Not (fsModal In Screen.Forms[intIdx].FormState)) Then
          Continue;
      End;

      Result := Result + StringOfChar(' ',intRec) + Screen.Forms[intIdx].Name + ' (' + Screen.Forms[intIdx].Caption + ')';

      If Pos('frmGravando', Screen.Forms[intIdx].Name) > 0 Then
      Begin
        LblMensagem := Screen.Forms[intIdx].FindComponent('lblGravando');

        If (LblMensagem <> Nil) And (LblMensagem Is TLabel) Then
          Result := Result + ' (' + (TLabel(LblMensagem).Caption) + ')';
      End;

      Inc(intRec);

      Result := Result + #13#10;
    End;
  End;
end;

procedure pGravarLogTransacao(strIdenti: String; const objConexao: IConnection; strStack: String);
Var
  qryAux: IQuery;
  tmrStart: TDateTime;
  LobjConexao: IConnection;
begin
  LobjConexao := objConexao ;
  if not Assigned(LobjConexao) then
    LobjConexao := TUnidacConnection.Create(frmModulo.GetCurrentConnection) ;

  qryAux := LobjConexao.NewQuery(0);
  Try
    tmrStart := fNow();

    qryAux.SQL.Text := 'SELECT * FROM TRANSACOES WHERE FALSE';
    qryAux.Open;

    qryAux.Insert;
    qryAux.FieldByName('TRA_CODOPE').AsString := strLoginUsuarioLogado;
    qryAux.FieldByName('TRA_IDENTI').AsString := strIdenti;
    qryAux.FieldByName('TRA_STACK_').AsString := strStack;
    qryAux.FieldByName('TRA_ID_CON').AsString := fGetConnectionID(LobjConexao);
    qryAux.FieldByName('TRA_HORSTA').AsDateTime := tmrStart;

    if qryAux.FindField('TRA_MODULE') <> nil then
      qryAux.FieldByName('TRA_MODULE').AsString := ExtractFileName(GetModuleName(HInstance));

    if qryAux.FindField('TRA_NOMMAQ') <> nil then
      qryAux.FieldByName('TRA_NOMMAQ').AsString := VS_ComputerNetName;

    if qryAux.FindField('TRA_NOMUSU') <> nil then
      qryAux.FieldByName('TRA_NOMUSU').AsString := VS_UserFromWindows;

    qryAux.Post;

    VS_TimerTransacao.Enabled := TTransactionLog.Instance.GetCount(VS_MainThreadId) > 0;
  Except
    //
  End;
end;

procedure pAtualizarLogTransacao(strIdenti   : string;
                                 strStack    : String;
                                 tmrCommit   : TDateTime;
                                 tmrRollback : TDateTime;
                                 const objConexao  : IConnection);
  Var
    qryAux: IQuery;
    LobjConexao: IConnection;
begin
  LobjConexao := objConexao ;
  if not Assigned(LobjConexao) then
    LobjConexao := TUnidacConnection.Create(frmModulo.GetCurrentConnection) ;

  qryAux := LobjConexao.NewQuery(0);
  Try
    qryAux.SQL.Add('UPDATE TRANSACOES ');
    qryAux.SQL.Add('SET TRA_IDENTI = :IDENTI ');

    If Not fEmptyStr(strStack) Then
      qryAux.SQL.Add('    ,TRA_STACK_ = IF(TRA_STACK_ IS NULL, :STACK_,  CONCAT_WS("\n", :STACK_, TRA_STACK_)) ');

    If tmrCommit > 0 Then
      qryAux.SQL.Add('    ,TRA_HORCOM = :HORCOM ');

    If tmrRollback > 0 Then
      qryAux.SQL.Add('    ,TRA_HORROL = :HORROL ');

    qryAux.SQL.Add('WHERE TRA_CODOPE = :CODOPE AND TRA_IDENTI = :IDENTI');
    qryAux.ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
    qryAux.ParamByName('IDENTI').AsString := strIdenti;

    If Not fEmptyStr(strStack) Then
      qryAux.ParamByName('STACK_').AsString := strStack;

    If tmrCommit > 0 Then
      qryAux.ParamByName('HORCOM').AsDateTime := tmrCommit;

    If tmrRollback > 0 Then
      qryAux.ParamByName('HORROL').AsDateTime := tmrRollback;

    qryAux.ExecSQL;
  Except
    //
  End;

end;

procedure pApagarLogTransacao(strIdenti: string; opcao: TAcaoTransacao; const objConexao: IConnection);
  Var
    qryAux: IQuery;
    LobjConexao: IConnection;
begin
  Try
    If SecondsBetween(fNow(), StrToDateTimeDef(strIdenti, 0)) > VS_TRANSACAO_LIMITE_SEGUNDOS Then
    Begin

      Case opcao Of
        opCommit  : pAtualizarLogTransacao(strIdenti, '', fNow(),      0, objConexao);
        opRollBack: pAtualizarLogTransacao(strIdenti, '',      0, fNow(), objConexao);
      End;

    End
    Else
    Begin
      LobjConexao := objConexao ;
      if not Assigned(LobjConexao) then
        LobjConexao := TUnidacConnection.Create(frmModulo.GetCurrentConnection) ;

      qryAux := LobjConexao.NewQuery(0);
      qryAux.SQL.Add('DELETE FROM TRANSACOES WHERE TRA_CODOPE = :CODOPE AND TRA_IDENTI = :IDENTI');
      qryAux.ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
      qryAux.ParamByName('IDENTI').AsString := strIdenti;
      qryAux.ExecSQL;
    End;

    VS_TimerTransacao.Enabled := TTransactionLog.Instance.GetCount(VS_MainThreadId) > 0;
  Except
    //
  End;
end;

function fInTransaction(objConexao: TUniConnection = Nil): Boolean;
begin
  if Assigned(objConexao) then
    Result := objConexao.InTransaction
  else if Assigned(frmModulo) then
    Result := frmModulo.GetCurrentConnection.InTransaction
  else
    Result := False;
end;

function fConexaoAtiva(): Boolean;
begin
  Result := Assigned(frmModulo) And frmModulo.GetCurrentConnection.Connected;
end;

function fTransacaoAbertaEmOutroModulo(objConexao: TUniConnection = Nil): Boolean;
var
  LQuery: TUniQuery;
begin
  Result := False;
  if not fCampoExiste('TRANSACOES', 'TRA_MODULE', True) then Exit;
  LQuery := fCriaQuery(nil, objConexao);
  try
    LQuery.SQL.Add(' SELECT SQL_NO_CACHE           ');
    LQuery.SQL.Add('   TRA_HORSTA,                 ');
    LQuery.SQL.Add('   TRA_HORCOM,                 ');
    LQuery.SQL.Add('   TRA_HORROL,                 ');
    LQuery.SQL.Add('   TRA_MODULE                  ');
    LQuery.SQL.Add(' FROM                          ');
    LQuery.SQL.Add('   TRANSACOES                  ');
    LQuery.SQL.Add(' WHERE TRUE                    ');
    LQuery.SQL.Add('   AND TRA_HORCOM IS NULL      ');
    LQuery.SQL.Add('   AND TRA_HORROL IS NULL      ');
    LQuery.SQL.Add('   AND TRA_HORSTA > :HORSTA    ');
    LQuery.SQL.Add('   AND TRA_MODULE <> :MODULE   ');
    LQuery.SQL.Add('   AND TRA_ID_CON = :ID_CON    ');
    LQuery.SQL.Add('   AND TRA_NOMMAQ = :NOMMAQ    ');
    LQuery.SQL.Add('   AND TRA_NOMUSU = :NOMUSU    ');
    LQuery.SQL.Add(' ORDER BY AUTOINCREM DESC      ');
    LQuery.SQL.Add(' LIMIT 1                       ');

    LQuery.ParamByName('HORSTA').AsDateTime := IncMinute(fNow, -60);
    LQuery.ParamByName('ID_CON').AsString := fGetConnectionID(objConexao);
    LQuery.ParamByName('MODULE').AsString := ExtractFileName(GetModuleName(HInstance));
    LQuery.ParamByName('NOMMAQ').AsString := VS_ComputerNetName;
    LQuery.ParamByName('NOMUSU').AsString := VS_UserFromWindows;

    LQuery.Open;

    if not LQuery.IsEmpty then
      Result := True;
  finally
    FreeAndNil(LQuery);
  end;
end;

procedure fRegistraCallStackSeEstiverEmTransacao(objConexao: TUniConnection = Nil; strTextoComplementarAoCallStack: String = '');

  function fMensagemDeveSerRegistrada: Boolean;
  begin
    Result := (Not AnsiUpperCase(strTextoComplementarAoCallStack).Contains('DOCUMENTO EMITIDO EM AMBIENTE DE HOMOLOGAÇÃO'));
  end;

  function fGetVersao: string;
  begin
    Result := #13#10 +
      'Versão Arquivo..: ' + fRetornaVersao(Application.ExeName, False) + #13#10 +
      'Versão Produto..: ' + fRetornaVersao(Application.ExeName, True)  + #13#10 +
      'Path do Arquivo.: ' + ExtractFilePath(Application.ExeName)       + #13#10 ;
  end;

begin
  If (Not strLoginUsuarioLogado.IsEmpty) Then
  Begin
    Try
      If Assigned(objConexao) Then
      Begin
        If fInTransaction(objConexao) Then
          If fMensagemDeveSerRegistrada Then
            pGravarLogTransacao(CNS_TRA_EM_MSG, TUnidacConnection.Create(objConexao), strTextoComplementarAoCallStack +
              fGetVersao + #13#10 + fGetNomeFormularios + #13#10 + fRetornaStack);
      End
      Else
      Begin
        If fConexaoAtiva Then
          If fInTransaction Then
            If fMensagemDeveSerRegistrada Then
              pGravarLogTransacao(CNS_TRA_EM_MSG, Nil, strTextoComplementarAoCallStack +
                fGetVersao + #13#10 + fGetNomeFormularios + #13#10 + fRetornaStack);
      End;
    Except
      //
    End;
  End;
end;

function fRetNumDocTransacaoTef : String;
  Var
    LstrSQL        : String;
    LintCodigoAtual: Int64;
    LqryGenCod     : TUniQuery;
    LstrCodAux     : String;
    LInseriuRegistro : Boolean;
    LconnTefDoc : TCriarConexao;
begin
  LconnTefDoc := TCriarConexao.Create('fRetNumDocTransacaoTef');
  try
    LqryGenCod := fCriaQuery(Nil, LconnTefDoc.objConexao);
    try
      fStartTransaction(LconnTefDoc.objConexao) ;
      Try
        LInseriuRegistro := False;

        LstrSQL := '';
        LstrSQL := LstrSQL + 'SELECT SQL_NO_CACHE     ';
        LstrSQL := LstrSQL + '  TEF_NUMDOC ';
        LstrSQL := LstrSQL + 'FROM ';
        LstrSQL := LstrSQL + '  TEFDOC ';
        LstrSQL := LstrSQL + 'WHERE ';
        LstrSQL := LstrSQL + '  TEF_DTADOC = :DTADOC ';
        LstrSQL := LstrSQL + ' FOR UPDATE ';

        LqryGenCod.Close;
        LqryGenCod.SQL.Clear;
        LqryGenCod.SQL.Add(LstrSQL);
        LqryGenCod.ParamByName('DTADOC').AsDate := Date;
        LqryGenCod.Open;

        If LqryGenCod.IsEmpty Then
        Begin
          LqryGenCod.Close;
          LqryGenCod.SQL.Clear;
          LqryGenCod.SQL.Add(' SELECT * FROM TEFDOC WHERE FALSE ');
          LqryGenCod.Open;

          LqryGenCod.Insert;
          LqryGenCod.FieldByName('TEF_NUMDOC').AsString := fPadL('1', 10, '0');
          LqryGenCod.FieldByName('TEF_DTADOC').AsDateTime := Date;
          LqryGenCod.Post;

          LstrCodAux := LqryGenCod.FieldByName('TEF_NUMDOC').AsString;
          LInseriuRegistro := True;
        End;

        LintCodigoAtual   := StrToInt64(LqryGenCod.FieldByName('TEF_NUMDOC').AsString);
        LqryGenCod.Close;

      Except
        On E: Exception Do
        Begin
          fRollBack(LconnTefDoc.objConexao) ;
          Raise Exception.Create(E.Message + 'Não consegui pegar o próximo número documento TEFDOC. '+
            'Tente novamente! ' + sLineBreak + '[' + E.Message + ']');
        End;
      End;

      If (Not LInseriuRegistro) Then
      Begin
        LstrSQL := '';
        LstrSQL := LstrSQL + ' UPDATE ';
        LstrSQL := LstrSQL + '   TEFDOC ';
        LstrSQL := LstrSQL + ' SET ';
        LstrSQL := LstrSQL + '   TEF_NUMDOC = :NUMDOC ';
        LstrSQL := LstrSQL + ' WHERE ';
        LstrSQL := LstrSQL + '   TEF_DTADOC = :DTADOC ';

        LqryGenCod.Close;
        LqryGenCod.SQL.Clear;
        LqryGenCod.SQL.Add(LstrSQL);

        LstrCodAux := fPadL(IntToStr(LintCodigoAtual+1), 10, '0');
        LqryGenCod.ParamByName('NUMDOC').AsString := LstrCodAux ;
        LqryGenCod.ParamByName('DTADOC').AsDate := Date ;
        LqryGenCod.ExecSQL;
        LqryGenCod.Close;
      End;

      Result := LstrCodAux;

      fCommit(LconnTefDoc.objConexao) ;

    finally
