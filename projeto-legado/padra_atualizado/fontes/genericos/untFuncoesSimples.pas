    Exit;

  Result := False;
end;

function fRetornaCaminhoMapeamento: String;
var
  LPath: String;
  LCaminho: String;
begin
  LPath := ExtractFilePath(Application.ExeName);

  Delete(LPath, 1, 2);
  LCaminho := copy(LPath, 1, pos('\', LPath));

  Delete(LPath, 1, pos('\', LPath));
  LCaminho := LCaminho + copy(LPath, 1, pos('\', LPath) -1);

  Result := '\\' + LCaminho;
end;

