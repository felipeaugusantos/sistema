function fComponentByName(Owner: TWinControl; strNome: String): TComponent;
  Var
    intContador: Integer;
    objControl: TControl;
begin
  Result := Nil;

  For intContador := 0 To Owner.ControlCount -1 Do
  Begin
    objControl := Owner.Controls[intContador];
    If AnsiUpperCase(objControl.Name) = AnsiUpperCase(strNome) Then
    Begin
      Result := objControl;
      Break;
    End;
    If objControl Is TWinControl Then
    Begin
      Result := fComponentByName(TWinControl(objControl), strNome);
      If Assigned(Result) Then
        Break;
    End;
  End;

end;

