  LCaminhoMapeamento := fRetornaCaminhoMapeamento;

  Result := AUnidadeMapeada + AnsiReplaceStr(LCaminhoAplicativo, LCaminhoMapeamento, '');
end;

function fExisteUnidadeMapeada(AUnidade: String): Boolean;
var
  LsNetPath : string;
  LdwMaxNetPathLen : DWord;
begin
  LdwMaxNetPathLen := MAX_PATH;
  SetLength(LsNetPath, LdwMaxNetPathLen);

  Result := (NO_ERROR = WNetGetConnection(PChar(AUnidade), PChar(LsNetPath), LdwMaxNetPathLen));
end;

function fRetornaUnidadeDeRedeDisponivel: String;
var
  LContador : integer;
  LsNetPath : string;
  LdwMaxNetPathLen : DWord;
begin
  Result := '';

  LdwMaxNetPathLen := MAX_PATH;
  SetLength(LsNetPath, LdwMaxNetPathLen);

  For LContador := 10 to 25 do
  Begin
    If Not (NO_ERROR = WNetGetConnection(PChar('' + Chr(65 + LContador) + ':'), PChar(LsNetPath), LdwMaxNetPathLen)) then
    Begin
      Result := Chr(65 + LContador) + ':';
      Exit;
    End;
  End;
end;

function fMapearUnidadeDeRede(ACaminho, AUnidade: String): Boolean;
var
  NRW: _NETRESOURCEW;
  dwResult: DWORD;
  LMensagem: string;
begin
  Result := False;

  NRW.dwType       := RESOURCETYPE_DISK;
  NRW.lpLocalName  := Pchar(AUnidade);
  NRW.lpRemoteName := Pchar(ACaminho);
  NRW.lpProvider   := nil;
  LMensagem        := EmptyStr;

  dwResult := WNetAddConnection2(NRW, nil, nil, 0);

  case dwResult of
    ERROR_ACCESS_DENIED               :LMensagem := 'O acesso ao recurso de rede foi negado.';
    ERROR_ALREADY_ASSIGNED            :LMensagem := 'O dispositivo local especificado por lpLocalName já está conectado a um recurso de rede.';
    ERROR_BAD_DEV_TYPE                :LMensagem := 'O tipo de dispositivo local e o tipo de recurso de rede não correspondem.';
    ERROR_BAD_DEVICE                  :LMensagem := 'O valor especificado por lpLocalName é inválido.';
    ERROR_BAD_NET_NAME                :LMensagem := 'O valor especificado por lpRemoteName não é aceitável para nenhum provedor de recursos de rede. O nome do recurso é inválido ou o recurso nomeado não pode ser localizado.';
    ERROR_BAD_PROFILE                 :LMensagem := 'O perfil do usuário está em um formato incorreto.';
    ERROR_BAD_PROVIDER                :LMensagem := 'O valor especificado por lpProvider não corresponde a nenhum provedor.';
    ERROR_BUSY                        :LMensagem := 'O roteador ou provedor está ocupado, possivelmente inicializando. O chamador deve tentar novamente.';
    ERROR_CANCELLED                   :LMensagem := 'A tentativa de fazer a conexão foi cancelada pelo usuário por meio de uma caixa de diálogo de um dos provedores de recursos de rede ou por um recurso chamado.';
    ERROR_CANNOT_OPEN_PROFILE         :LMensagem := 'O sistema não pode abrir o perfil do usuário para processar conexões persistentes.';
    ERROR_DEVICE_ALREADY_REMEMBERED   :LMensagem := 'Uma entrada para o dispositivo especificado em lpLocalName já está no perfil do usuário.';
    ERROR_EXTENDED_ERROR              :LMensagem := 'Ocorreu um erro específico da rede. Chame a função WNetGetLastError para obter uma descrição do erro.';
    ERROR_INVALID_PASSWORD            :LMensagem := 'A senha especificada é inválida.';
    ERROR_NO_NET_OR_BAD_PATH          :LMensagem := 'Um componente de rede não foi iniciado ou o nome especificado não pôde ser tratado.';
    ERROR_NO_NETWORK                  :LMensagem := 'Não há rede presente.';
    ERROR_SESSION_CREDENTIAL_CONFLICT :LMensagem := 'Conflito de credencial na sessão.';
    NO_ERROR                          :Result := True;
  else
      LMensagem := Concat('Erro desconhecido: ', dwResult.ToString());
  end;

  If not fEmptyStr(LMensagem) Then
  Begin
    fMensagem('ATENÇÃO!', LMensagem, ['&Ok']);
  End;
end;

function fDesconectaUnidadeDeRede(AUnidade: Pchar; AForcaCancel: Boolean; AMensagem: Boolean = False): Boolean;
var
  LMensagem: String;
begin
  Result := False;

  WNetCancelConnection2(AUnidade, CONNECT_UPDATE_PROFILE, AForcaCancel);

  Case GetLastError() of
      1205: LMensagem := 'Não foi possível abrir o perfil';
      1206: LMensagem := 'Perfil do usuário não encontrado ou inválido';
      1208: LMensagem := 'Ocorreu um Erro específico na rede';
      2138: LMensagem := 'Rede não encontrada ou fora do ar';
      2250: LMensagem := 'Mapeamento inválido ou não encontrado';
      2401: LMensagem := 'Existem muitos arquivos abertos';
    Else
    Begin
      LMensagem := 'Unidade desconectada com sucesso';
      Result := True;
    End;
  End;

  If AMensagem Then
  Begin
    fMensagem('ATENÇÃO!', LMensagem, ['&Ok']);
  End;
end;

