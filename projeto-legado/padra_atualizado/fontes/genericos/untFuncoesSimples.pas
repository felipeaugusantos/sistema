function fMsgFaixasHorariosEntregaCliente(strCodCli: String): String;
Const
  ArrDiaSemana: Array[1..7] Of String = ('DOM','SEG','TER','QUA','QUI','SEX','SAB');
Var
  qryGen: TUniQuery;

  function fHora(strIni, strFin: String): String;
  begin
    If qryGen.FieldByName(strIni).IsNull Then
      Result := '       -       '
    Else
      Result := ' ' + FormatDateTime('hh:mm', qryGen.FieldByName(strIni).AsDateTime) + ' - '
                    + FormatDateTime('hh:mm', qryGen.FieldByName(strFin).AsDateTime) + ' ';
  end;

begin
  Result := '';
  qryGen := fCriaQuery;
  Try
    qryGen.SQL.Text := 'SELECT * FROM CLIHSE WHERE HSE_CODCLI = :CODCLI ORDER BY HSE_DAYOFW';
    qryGen.ParamByName('CODCLI').AsString := strCodCli;
    qryGen.Open;

    If qryGen.IsEmpty Then
      Exit;

    Result := Result + '-----------------------------------------------------' + #13#10;
    Result := Result + '| DIAS E HORÁRIOS DA SEMANA PERMITIDOS PARA ENTREGA |' + #13#10;
    Result := Result + '-----------------------------------------------------' + #13#10;
    Result := Result + '|DIA|   HORÁRIO 1   |   HORÁRIO 2   |   HORÁRIO 3   |' + #13#10;
    Result := Result + '-----------------------------------------------------' + #13#10;

    While Not qryGen.Eof Do
    Begin
      Result := Result +
        '|' + ArrDiaSemana[qryGen.FieldByName('HSE_DAYOFW').AsInteger] +
        '|' + fHora('HSE_HRAINI', 'HSE_HRAFIN') +
        '|' + fHora('HSE_HRAIN2', 'HSE_HRAFI2') +
        '|' + fHora('HSE_HRAIN3', 'HSE_HRAFI3') +
        '|' + #13#10;
      qryGen.Next;
    End;

    Result := Result + '-----------------------------------------------------' + #13#10;
  Finally
    FreeAndNil(qryGen);
  End;
end;

function fMsgDiaSemanaMesPermitidosFaturamento(strCodCli: String; strCampoDiaMes, strCampoDiaSemana: String): String;
  Var
    strDiaMes : String;
    strDiaSem : String;
    intCnt : Integer;
    strTempSemana: String;
    stlTexto : TStringList;

  const
    ArrSemana : Array[1..7] of String = ('domingo', 'segunda-feira', 'terça-feira', 'quarta-feira',
                                         'quinta-feira', 'sexta-feira', 'sábado');
begin
  strDiaMes := fCampoTabela(strCampoDiaMes, 'CADCLI', ['CLI_CODCLI'], [strCodCli]);
  strDiaSem := fCampoTabela(strCampoDiaSemana, 'CADCLI', ['CLI_CODCLI'], [strCodCli]);

  Result := '';

  If (Not fEmptyStr(strDiaMes)) Then
  Begin
    Result := Result + 'DIAS PERMITIDOS PARA FATURAMENTO: ' + sLineBreak;
    stlTexto := fRetornaWordWrap(fTransform(strDiaMes, 2, ' '), 36);
    Try
      For intCnt := 0 To stlTexto.Count-1 Do
        Result := Result + stlTexto.Strings[intCnt] + sLineBreak;
    Finally
      FreeAndNil(stlTexto);
    End;
  End;

  strTempSemana := '';
  For intCnt := 1 To 7 Do
  Begin
    If (strDiaSem[intCnt] = 'S') Then
    Begin
      If (fEmptyStr(strTempSemana)) Then
        strTempSemana := ArrSemana[intCnt]
      Else
        strTempSemana := strTempSemana + ', ' + ArrSemana[intCnt];
    End;
  End;

  If (Not fEmptyStr(strTempSemana)) Then
  Begin
    If (Not fEmptyStr(Result)) Then
      Result := Result + sLineBreak;

    Result := Result + 'DIAS DA SEMANA PERMITIDOS PARA FATURAMENTO: ' + sLineBreak;
    stlTexto := fRetornaWordWrap(strTempSemana, 36);
    Try
      For intCnt := 0 To stlTexto.Count-1 Do
        Result := Result + stlTexto.Strings[intCnt] + sLineBreak;
    Finally
      FreeAndNil(stlTexto);
    End;
  End;
end;

procedure pRedimensionaObj(objRedimensiona, objLimite : TControl; enuRedimensiona : TRedimensiona);
begin
  Case enuRedimensiona of
    rdAumenta:
      objRedimensiona.Width := objRedimensiona.Parent.Width - objRedimensiona.Left - (objRedimensiona.Parent.Width - (objLimite.Left + objLimite.Width));
    rdDiminui:
      objRedimensiona.Width := objRedimensiona.Parent.Width - objRedimensiona.Left - (objRedimensiona.Parent.Width - (objLimite.Left - 7));
  end;
end;

