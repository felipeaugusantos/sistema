procedure pFecharBanco(Database: TUniConnection);
begin
  Try
    If Database.InTransaction = True Then
      Database.Rollback;

    Database.Disconnect;
  Except
    On E : Exception do
    Begin
      pMensagensErro(E.Message, '[pFecharBanco]');
	    //pErro(E.Message);
    End;
  End;
end;

