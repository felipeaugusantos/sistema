      FreeAndNil(qryEmp);
    End;
  End;
end;

{******************************************}
{* RETORNA SE EXISTE O CLIENTE CONSUMIDOR *}
{* GRAVADO NO CLICON                      *}
{**************************************PE**}
function fExisteConsumidor(strCpfCgc: String; intCpfCgc: Integer = 0 ): Boolean;
  Var
    strSQL : String;
    qryGenCliCon : TUniQuery;
begin

  Result := False;

  Try
    qryGenCliCon := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CLICON ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CON_C_P_F_ = :C_P_F_  ';

    If  intCpfCgc > 0 Then
      strSQL := strSQL + '  AND CON_CGCCPF = :CGCCPF  ';

    With qryGenCliCon Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('C_P_F_').AsString := strCpfCgc;

      If  intCpfCgc > 0 Then
        ParamByName('CGCCPF').AsInteger := intCpfCgc;

      Open;

      If Not IsEmpty Then
        Result := True;

      Close;
    End;

  Finally
    FreeAndNil(qryGenCliCon);
  End;


end;

