function fIncAlfaNumerico(strValor : String; strMascara : String = '') : String;
const
  ALFAUP   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  ALFADW   = 'abcdefghijklmnopqrstuvwxyz';
  NUMERO = '0123456789';
var
  i            : Integer;
  blnContinua  : Boolean;
  chrCaractere : Char;

  function fProximoCaractere(strCaracteres : String) : Char;
  var
    intPos : Integer;
  begin
    //pega a posição do array para pegar o próximo caractere
    intPos := Pos(chrCaractere, strCaracteres);

    // se for o último, deve voltar para o primeiro caractere, se fizer isso o
    //laço que percorre os caracteres deve continuar para mudar o número anterior
    blnContinua := (intPos = High(strCaracteres));
    if blnContinua  then
      intPos := Low(strCaracteres)
    else
      inc(intPos);

    Result := strCaracteres[intPos];
  end;

begin
  Result := strValor;
  i := High(Result);

  repeat
    chrCaractere := Result[i];
    //a opção da máscara é para otimizar laços muito pesados, para não ter que ficar
    //testando toda hora o tipo de caractere em um array.
    if strMascara <> '' then
    begin
      case strMascara[i] of
       'N': chrCaractere := fProximoCaractere(NUMERO);
       'A': chrCaractere := fProximoCaractere(ALFAUP);
       'a': chrCaractere := fProximoCaractere(ALFADW);
       end;
    end
    else
    begin
      if CharInSet(chrCaractere, ['0'..'9']) then
        chrCaractere := fProximoCaractere(NUMERO)
      else begin
        //letras minúsculas possuem um valor decimal na tabela ASCII maior que 90
        if Ord(chrCaractere) <= 90 then
          chrCaractere := fProximoCaractere(ALFAUP)
        else
          chrCaractere := fProximoCaractere(ALFADW);
      end;
    end;

    Result[i] := chrCaractere;
    Dec(i);
  until (i < 1) or (not blnContinua);

end;

function fRetSQLTabSequencial(intPotencia10 : integer) : String;
  const
    SQL_INICIAL = '       SELECT 1 AS QTDSEQ  '+
                  ' UNION SELECT 2            '+
                  ' UNION SELECT 3            '+
                  ' UNION SELECT 4            '+
                  ' UNION SELECT 5            '+
                  ' UNION SELECT 6            '+
                  ' UNION SELECT 7            '+
                  ' UNION SELECT 8            '+
                  ' UNION SELECT 9            '+
                  ' UNION SELECT 10           ';
  var
    strSomaCampos : String;
    strTabelas    : String;
    strNomTab     : String;
    i             : Integer;

  function fSQLMultiplicador(intQtdZero : integer) : String;
  var
    strZeros : String;
  begin
    strZeros := fReplicatorStr('0',intQtdZero);

    Result := '       SELECT 0 AS QTDSEQ ' +
              ' UNION SELECT 1' + strZeros +
              ' UNION SELECT 2' + strZeros +
              ' UNION SELECT 3' + strZeros +
              ' UNION SELECT 4' + strZeros +
              ' UNION SELECT 5' + strZeros +
              ' UNION SELECT 6' + strZeros +
              ' UNION SELECT 7' + strZeros +
              ' UNION SELECT 8' + strZeros +
              ' UNION SELECT 9' + strZeros ;
  end;

begin
  //1
  strSomaCampos := 'TABSEQ1.QTDSEQ';
  strTabelas    := ' (' + SQL_INICIAL + ') TABSEQ1 ';

  //começa do dois pois a primeira é fixa
  for i := 1 to intPotencia10 -1 do
  begin
    strNomTab     := 'TABSEQ'+ IntToStr(i+1);
    strSomaCampos := strSomaCampos  + ' + ' +  strNomTab + '.QTDSEQ ';
    strTabelas    := strTabelas + ' JOIN (' + fSQLMultiplicador(i) + ') ' + strNomTab;
  end;

  Result := ' SELECT                                 ' +
            '   TABSEQ.SEQUEN                        ' +
            ' FROM                                   ' +
            '   (SELECT                              ' +
            '      (' + strSomaCampos + ') AS SEQUEN ' +
            '    FROM                                ' +
            '      ' + strTabelas + ') TABSEQ        ';
end;

