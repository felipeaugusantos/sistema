function fContaCaracterRepetido(strTexto : String; intQtde : Integer) : Boolean;
Var
  intConta : Integer;
  intCont1 : Integer;
  intRepet : Integer;
Begin
  Result := False;

  For intConta := 0 To Length(strTexto) - 1 Do
  Begin
    intRepet := 0;
    For intCont1 := 0 To Length(strTexto) - 1 Do
    Begin

      If strTexto[intConta] = strTexto[intCont1] Then
         Inc(intRepet);
    End;

    If((intRepet > 1) and (intRepet > intQtde)) Then
    Begin
      Result := True;
      Exit;
    End;
  End;
End;

