  Result :=
    ' UNION ' +
    ' SELECT DISTINCT FDO_NUMDOC AS FGO_NUMDOC, FDO_ESPDOC AS FGO_ESPDOC, FDO_CODEMP AS FGO_CODEMP '+
    ' FROM ROMDETX R ' +
    ' INNER JOIN NOTDET N ON R.DET_NUMDOC = N.DET_NUMDOC ' +
    '                    AND R.DET_ESPDOC = N.DET_ESPDOC ' +
    '                    AND R.DET_CODEMP = N.DET_CODEMP ' +
    ' INNER JOIN CNFMNO C ON N.DET_SEQGER = C.MNO_SEQGER ' +
    ' INNER JOIN MOVDET D ON D.DET_NUMDOC = C.MNO_NUMFAT ' +
    '                    AND D.DET_ESPDOC = C.MNO_ESPFAT ' +
    '                    AND D.DET_CODEMP = C.MNO_EMPFAT ' +
    ' INNER JOIN FATDOR F ON F.FDO_NUMFAT = D.DET_NUMDOC ' +
    '                    AND F.FDO_TIPFAT = D.DET_ESPDOC ' +
    '                    AND F.FDO_EMPFAT = D.DET_CODEMP ' +
    ' WHERE N.DET_NUMDOC = :NUMDOC ' +
