    End;

    Close;

  End;

  FreeAndNil(qryTra);
End;

function fExisteOrcamentoPendente(strCodCli, strNumOrc: String; strCodPro: String = ''; blnFiltraEmpresa: Boolean = True): Boolean;
Begin
  Result := fExisteFatGorPendente(strCodCli, strNumOrc, 'OR', strCodPro, blnFiltraEmpresa);
End;

function fExistePedidoPendente(strCodCli, strNumDoc: String; strCodPro: String = ''): Boolean;
Begin
  Result := fExisteFatGorPendente(strCodCli, strNumDoc, 'PD', strCodPro);
End;

function fExisteFatGorPendente(strCodCli, strNumDoc: String; strEspDoc: String; strCodPro: String = ''; blnFiltraEmpresa: Boolean = True): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  qryGen := fCriaQuery;
  Try
    qryGen.SQL.Clear;

    qryGen.SQL.Add('SELECT   ');
    qryGen.SQL.Add('  SUM(IFNULL(FDO_QTDITE,0) - IFNULL(FDO_QTDBAI,0)) AS QTDPEN ');
    qryGen.SQL.Add('FROM     ');
    qryGen.SQL.Add('  FATDOR ');
    If (Not fEmptyStr(strCodPro)) Then
  Begin
      qryGen.SQL.Add('  INNER JOIN FATGOR ON FDO_SEQGER = FATGOR.AUTOINCREM ');
      qryGen.SQL.Add('  INNER JOIN MOVOCO ON FGO_NUMDOC = OCO_NUMDOC AND    ');
      qryGen.SQL.Add('                       FGO_ESPDOC = OCO_ESPDOC AND    ');
      qryGen.SQL.Add('                       FGO_CODEMP = OCO_CODEMP        ');
    End;
    qryGen.SQL.Add('WHERE FDO_JAFATU = 0       ');
    qryGen.SQL.Add('  AND FDO_ESPDOC = :ESPDOC   ');

    If blnFiltraEmpresa Then
      qryGen.SQL.Add('  AND FDO_CODEMP = :CODEMP ');

    If Not (fEmptyStr(strNumDoc)) Then
      qryGen.SQL.Add('  AND FDO_NUMDOC <> :NUMDOC ');

    If Not (fEmptyStr(strCodPro)) Then
    Begin
      qryGen.SQL.Add('  AND ((FDO_CODCLI = :CODCLI) or (FDO_CODCLI =:CONCRM))');
      qryGen.SQL.Add('  AND OCO_CODCLI  = :CODPRO ');
    End
    Else
    Begin
      qryGen.SQL.Add('  AND FDO_CODCLI = :CODCLI ');
    End;

    qryGen.SQL.Add('HAVING QTDPEN > 0           ');

    qryGen.ParamByName('CODCLI').AsString := strCodCli;
    If blnFiltraEmpresa Then
      qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    If Not (fEmptyStr(strNumDoc)) Then
      qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
    If Not (fEmptyStr(strCodPro)) Then
    Begin
      qryGen.ParamByName('CODPRO').AsString := strCodPro;
      qryGen.ParamByName('CONCRM').AsString := fCfgSis('CONCRM', varString);
    End;
    qryGen.ParamByName('ESPDOC').AsString := strEspDoc;

    qryGen.Open;

    Result := Not qryGen.IsEmpty;

  Finally
    qryGen.Close;
  FreeAndNil(qryGen);
End;
End;

Function fTemEntregaFutura(strCodCli: String): Boolean;

  function fGetSqlTab: String;
  Var
    strSQL,
    strMovDet,
    strMovGer: String;
    blnEfBaixExiste : Boolean;
  Begin

    blnEfBaixExiste := fCampoExiste('MOVDET', 'DET_EFBAIX', True);

    strMovGer := 'MOVGER';
    strMovDet := 'MOVDET';

    strSQL := '';
    strSQL := strSQL + ' SELECT                    ';
    strSQL := strSQL + '   COUNT(*) AS QTDITE      ';
    strSQL := strSQL + ' FROM                      ';
    strSQL := strSQL + strMovDet + ' D ';
    strSQL := strSQL + '  INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ';

    strSQL := strSQL + ' INNER JOIN ' + strMovGer + ' G ON        ';
    strSQL := strSQL + '   G.AUTOINCREM = D.DET_SEQGER              ';

    If (fCfgSis('CONENT', varBoolean)) and (fCfgSis('COENFI', varBoolean)) Then
    Begin

      If ((fCfgSis('EMPGER', varBoolean))) Then
      Begin
        strSQL := strSQL + ' AND (GER_CODEMP = ' + QuotedStr(fCfgSis('EMPMAT')) + ' OR ';
        strSQL := strSQL + '      GER_CONENT = "S") ';
      End
      Else
      Begin
        strSQL := strSQL + ' AND GER_CONENT = "N" ';
        strSQL := strSQL + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
      End;

    End

    Else strSQL := strSQL + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);

    strSQL := strSQL + ' WHERE                                            ';
    strSQL := strSQL + '   DET_ENTFUT = "S" AND                           ';
    strSQL := strSQL + '   DET_CODCLI = :CODCLI AND                       ';

    If blnEfBaixExiste Then
      strSQL := strSQL + ' DET_EFBAIX = "N" AND ';

    strSQL := strSQL + '   (DET_ESPDOC NOT IN ("ML", "PR", "TM", "TR", "BR", "PI", "EP")) AND  ';

    If fCfgSis('EFTEST') = '2' Then
    Begin
      strSQL := strSQL + '   (DET_PROEMB <> "S" OR DET_BXSBIT = "S") AND ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
      strSQL := strSQL + '   (DET_FILKAR = 0) AND ';//Para nao exibir o item principal (que vai estar com filkar = 1)
    End
    Else
      strSQL := strSQL + '   DET_PROEMB <> "S" AND ';

    strSQL := strSQL + '   ROUND(DET_QTDITE - IFNULL(DET_QTDENT,0),4) > 0 ';

    Result := strSQL;
  End;

  Var
    qryGen: TUniQuery;
Begin

  qryGen := fCriaQuery;

  With qryGen, SQL Do
  Begin
    Clear;
    Add(fGetSqlTab);

    ParamByName('CODCLI').AsString := strCodCli;

    Open;

    Result := FieldByName('QTDITE').AsInteger > 0;

    Close;
  End;

  FreeAndNil(qryGen);
End;

function fPreMat(strCodEmp: String = ''; strEmpAvalia: String = ''): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Result := False;
  If fEmptyStr(strEmpAvalia) Then
    strEmpAvalia := VS_strCodEmp;

  Try
    qryGen := fCriaQuery;
    If strCodEmp = '' Then
      strCodEmp := VS_strCodEmp;
    qryGen.Close;
    qryGen.SQL.Add('SELECT EMP_PREMAT FROM CADEMP WHERE EMP_CODEMP = :CODEMP');
    qryGen.ParamByName('CODEMP').AsString := strCodEmp;
    qryGen.Open;

    Result := (qryGen.FieldByName('EMP_PREMAT').AsString = 'S');

    If (strEmpAvalia = fCfgSis('EMPMAT', varString, strCodEmp)) Then
      Result := False;

    qryGen.Close;
  Except
    On E: Exception Do
      pMensagensErro(E.Message,'');
  End;
  FreeAndNil(qryGen);

End;


