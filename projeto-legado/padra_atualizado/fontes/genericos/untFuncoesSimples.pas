Function fFiltroEmpresaExpedicaoPedido(blnComAnd : Boolean) : String;
Var
  strFiltroEmp, strEmp_CD : String;
Begin

  {*****************************************}
  {* QUANDO A CONFIGURAÇÃO EXIBIR SOMENTE  *}
  {* PEDIDOS COM ENTREGA PELO C.D. ESTIVER *}
  {* SIM, MOSTRA SOMENTE COM ENTREGA PELO  *}
  {* C.D. INDEPENDENTE DA EMPRESA.         *}
  {**************************************MV*}
  strEmp_CD := fCfgSis('EMP_CD');

  If (fCfgSis('ENT_CD', varString) = 'S') And (fCfgSis('CDEXAF', varString) = 'S') And (VS_strCodEmp = strEmp_CD) Then
    strFiltroEmp := ' ((((FGO_EMPEXP = :CODEMP) AND (IFNULL(FGO_UPSEML, "") <> "S")) AND (FGO_ENT_CD = "S")) OR (IFNULL(FGO_EMP_TE, "") = :CODEMP)) '
  Else
  If fUtilizaEmpresaPrioridade then
    strFiltroEmp := ' (((FGO_EMPEXP = :CODEMP) AND (IFNULL(FGO_UPSEML, "") <> "S")) OR ((FGO_UPSEML = "S") AND (FGO_EMPEPE = :CODEMP))) '
  Else
  If (fCfgSis('EXOULJ', varString) = 'S') and (not fEmptyStr(fEmpresasNoServidor(VS_strCodEmp))) then
    strFiltroEmp := ' ((FGO_EMPEXP IN (' + fStringSQLLocateToStringSQLIN(fEmpresasNoServidor(VS_strCodEmp)) + ')) AND (IFNULL(FGO_UPSEML, "") <> "S")) '
  Else
    strFiltroEmp := ' ((FGO_EMPEXP = :CODEMP) AND (IFNULL(FGO_UPSEML, "") <> "S")) ';

  Result := strFiltroEmp + IfThen(blnComAnd, ' AND ', '');
End;

function fFiltroProdutosExpedicaoItens(blnReimpressaoVolumes,
                                       blnUsaImpressaoSeparacaoPorLocal,
                                       blnExiPedRetiraExpAntFat,
                                       blnApenasFaturarJaExpedidos : Boolean;
                                       blnApenasConferenciaProdutosRetiraCaixa : Boolean = False;
                                       strCampoQtdBaixada: String = 'FDO_QTDBAI';
                                       strJaFaturado: String = '0';
                                       blnFiltroEntregaERetira: Boolean = False): String;
begin
  Result := Result + '  AND IFNULL(FDO_ENTFUT,"N") = "N"  ';
  Result := Result + '  AND FDO_ESPDOC = "PD"     ';

  If Not blnReimpressaoVolumes Then
  Begin
    Result := Result + ' AND FDO_QTDITE > ' + strCampoQtdBaixada;
    Result := Result + ' AND FDO_JAFATU = ' + strJaFaturado;

    If blnUsaImpressaoSeparacaoPorLocal Then
       Result := Result + ' AND ((FDO_QTDITE - ' + strCampoQtdBaixada + ') - (FDO_QTDITE - FDO_QTDSEP)) > 0 ';
  End;

  Result := Result + ' AND IFNULL(FDO_PROEMB,"N") <> "S" ';

  If Not fEmptyStr(fCfgSis('ITEMAN')) Then
    Result := Result + ' AND FDO_CODITE <> "' + fCfgSis('ITEMAN') + '" ';

  If Not fEmptyStr(fCfgSis('ITELAN')) Then
    Result := Result + ' AND FDO_CODITE <> "' + fCfgSis('ITELAN') + '" ';

  If Not fEmptyStr(fCfgSis('ITEBOM')) Then
    Result := Result + ' AND FDO_CODITE <> "' + fCfgSis('ITEBOM') + '" ';

  If Not fEmptyStr(fCfgSis('ITETAX')) Then
    Result := Result + ' AND FDO_CODITE <> "' + fCfgSis('ITETAX') + '" ';

  Result := Result + ' AND FDO_CODITE <> "' + fCfgSis('ITESER') + '" ';
  Result := Result + ' AND FDO_CODITE <> "' + fCfgSis('SERTER') + '" ';

  If blnApenasConferenciaProdutosRetiraCaixa Then
    Result := Result + ' AND FDO_ENTRET = "R" AND FDO_LOCRET = "C" ';

  If (blnExiPedRetiraExpAntFat) And (Not blnFiltroEntregaERetira) Then
    Result := Result + ' AND FDO_ENTRET = "R"  '

  Else If VS_strExpRetiraEntrega = 'R' Then
    Result := Result + ' AND FDO_ENTRET = "R"  '

  Else If VS_strExpRetiraEntrega = 'E' Then
    Result := Result + ' AND FDO_ENTRET = "E"  ';

  If blnApenasFaturarJaExpedidos Then
    Result := Result + ' AND FDO_QTDEXP > 0.0000 ';
end;

