function fBuscaMensagemPadraoOcorrenciaCRM(strCodOco: string): string;
var
  qryMensagem: TUniQuery;
begin
  Result := EmptyStr;

  if (not fVerificaAcessoSistema('frmCadComplOcorrencias')) or (fEmptyStr(strCodOco)) then
  begin
    Exit;
  end;

  qryMensagem := fCriaQuery();

  try
    qryMensagem.Close;
    qryMensagem.SQL.Clear;
    qryMensagem.SQL.Add('SELECT COC_MSGPAD');
    qryMensagem.SQL.Add('FROM CADCOC');
    qryMensagem.SQL.Add('WHERE COC_CODCOC = :CODCOC');
    qryMensagem.SQL.Add('AND COC_MSGPAD IS NOT NULL');
    qryMensagem.ParamByName('CODCOC').AsString := strCodOco;
    qryMensagem.Open;

    if (not qryMensagem.IsEmpty) and (not fEmptyStr(qryMensagem.FieldByName('COC_MSGPAD').AsString)) then
    begin
      Result := AnsiReplaceStr(qryMensagem.FieldByName('COC_MSGPAD').AsString, '<<csq>>', sLineBreak);
    end;
  finally
    FreeAndNil(qryMensagem);
  end;
end;

