begin
  Result := True;

  If fEmptyStr(strCodPor) Then
    Exit;

  LConsulta := fCriaQuery;

  Try
    LConsulta.SQL.Text := 'SELECT POR_CODPOR, POR_NOMPOR, POR_PERAUT FROM CADPOR ' +
                          'WHERE POR_CODPOR="' + strCodPor + '"';
    LConsulta.Open;

    If Not LConsulta.FieldByName('POR_NOMPOR').AsString.IsEmpty Then
    Begin
      If LConsulta.FieldByName('POR_PERAUT').AsString = 'N' Then
      Begin
        Result := False;
        fMensagem('ATENÇÃO', 'Esse portador não pode ser selecionado na geração de duplicatas no Autban!', ['&Ok']);
      End;
    End;
  Finally
    FreeAndNil(LConsulta);
  End;
end;

function fSQLSaldoDisponivel(const AAlias: String = 'G';
                             AFaturamento: Boolean = False;
                             ALote: Boolean = False;
                             blnCnv_ML: Boolean = False;
                             blnEntFut: Boolean = True;
                             blnOrdPro: Boolean = True): string;
var
  LPrefix: String;
  strSalGar,
  strSalExt,
  strSalPed,
  strSalEnd,
  strSalOrd,
  strFutPre,
  strFutFal,
  strFutAgu,
  strBaiFut,
  strCnv_Ml,
  strSalFis: string;
begin
  Result := '';
  LPrefix:= Concat(AAlias, IIF(fEmptyStr(AAlias), '', '.'), IIF(ALote, 'LOT_', 'ITE_'));

  strSalGar := 'IFNULL(' + LPrefix + 'SALREG, 0)';
  strSalExt := 'IF(IFNULL(' + LPrefix + 'SALEXT, 0) < 0, 0,  IFNULL(' + LPrefix + 'SALEXT, 0))';
  If (fCfgSis('MOVFUL', varString) = '2') Then
    strSalExt := '0';

  strSalPed :='(IFNULL(' + LPrefix + 'QTPD_V, 0) + (IFNULL(' + LPrefix + 'QTPD_F, 0)))';
  strSalEnd := 'IFNULL(' + LPrefix + 'QTPD_E, 0)';

  strFutPre := '0';
  strFutFal := '0';
  strFutAgu := '0';
  strBaiFut := '0';
  strSalOrd := '0';

  If blnEntFut Then
  Begin
    strFutPre := 'IFNULL(' + LPrefix + 'QTEF_P, 0)';
    strFutFal := 'IFNULL(' + LPrefix + 'QTEF_F, 0)';
    strFutAgu := 'IFNULL(' + LPrefix + 'QTEF_A, 0)';
    strBaiFut := '(IFNULL(' + LPrefix + 'QTPDBF, 0) - IFNULL(' + LPrefix + 'SDPDBF, 0))';
  End;

  If blnOrdPro Then
  Begin
    strSalOrd := 'IFNULL(' + LPrefix + 'QTPD_P, 0)';
  End;

  strCnv_Ml := '';
  If blnCnv_ML Then
    strCnv_Ml := 'ROUND(IFNULL(IF(IFNULL(ITE_CNV_ML,0) > 0,(' + LPrefix + 'SAL_ML/ITE_CNV_ML) ,0 ),0) ,4)';

  strSalFis :=  Concat('IFNULL(', LPrefix, 'SALDOS, 0) + ' + IIf(blnCnv_ML, strCnv_Ml + ' + ', ''), strBaiFut, ' + ', strFutPre, ' + ', strFutFal, ' + ', strFutAgu,' + ');
  Case fCfgSis('CALSAL', VarInteger) Of
    1:   Result := strSalFis + ' - ' + strSalGar + ' - ' + strSalPed + ' - ' + strSalEnd + ' - ' + strSalOrd + ' - ' + strSalExt;
    2:   Result := strSalFis + ' - ' + strSalGar + ' - ' + strSalPed + ' - ' + strSalEnd + ' - ' + strSalOrd + ' - ' + strSalExt + ' - ' + strFutPre + ' - ' + strFutFal + ' - ' + strFutAgu;
    3:   Result := strSalFis + ' - ' + strSalGar + ' - ' + strSalPed + ' - ' + strSalEnd + ' - ' + strSalOrd + ' - ' + strSalExt + ' - ' + strFutPre + ' - ' + strFutAgu;
    4:   Result := strSalFis + ' - ' + strSalGar + ' - ' + strSalPed + ' - ' + strSalEnd + ' - ' + strSalOrd + ' - ' + strSalExt + ' - ' + strFutFal;
    5:   Result := strSalFis + ' - ' + strSalGar + ' - ' + strSalPed + ' - ' + strSalEnd + ' - ' + strSalOrd + ' - ' + strSalExt + ' - ' + strFutPre;
    Else Result := '0';
  End;
End;

function fGetSQLQtdEntregaFuturaItem(strCodIte, strCodEmp: String; strNumLot: String = ''; strMotFut: String = ''): String;
  Var
    blnEfBaixExiste: Boolean;
begin
  blnEfBaixExiste := fCampoExiste('MOVDET', 'DET_EFBAIX', True);

  Result := '';

  Result := Result + '  IFNULL((SELECT ';
  Result := Result + '    SUM(IFNULL(ROUND(IFNULL(DET_QTDITE,0) - IFNULL(DET_QTDENT,0),4), 0)) AS QTDPEN ';
  Result := Result + '  FROM ';
  Result := Result + '    MOVDET D ';
  Result := Result + '    INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ';
  Result := Result + '  WHERE ';

  If blnEfBaixExiste Then
    Result := Result + ' DET_EFBAIX = "N" AND ';

  If (Not fEmptyStr(strMotFut)) Then
  Begin
    Result := Result + '   (';
    If Pos('FP', strMotFut) > 0 then
      Result := Result + ' ( T.DET_TIPFUT = "FP" AND DET_MOTFUT = "P" ) ';
    If ('FP' <> strMotFut) And (Pos('FP', strMotFut) > 0) then
      Result := Result + '  OR ';
    Result := Result + ' ( DET_MOTFUT IN (' + strMotFut + ')  AND (IFNULL(T.DET_TIPFUT,"") = "") ) ';
    Result := Result + '   ) AND ';
  End;

  Result := Result + '    DET_ENTFUT = "S" AND ';

  If fCfgSis('EFTEST') = '2' Then
  Begin
    Result := Result + '   (DET_PROEMB <> "S" OR DET_BXSBIT = "S") AND ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
    Result := Result + '   (DET_FILKAR = 0) ';//Para nao exibir o item principal (que vai estar com filkar = 1)
  End
  Else
    Result := Result + '   DET_PROEMB <> "S" ';

  If Not fCfgSis('BEFTRG', VarBoolean) Then
    Result := Result + '    AND IFNULL(DET_FILKAR,0) = 0 ';

  Result := Result + '    AND IFNULL(ROUND(IFNULL(DET_QTDITE,0) - IFNULL(DET_QTDENT,0),4), 0) > 0 ';

  If Not fEmptyStr(strNumLot) Then
    Result := Result + '  AND DET_NUMLOT = ' + strNumLot + ' ';

  If Not fEmptyStr(strCodEmp) Then
    Result := Result + '  AND DET_CODEMP IN (' + strCodEmp + ') ';

  Result := Result + '  AND DET_CODITE = ' + strCodIte + '), 0) ';


  {***********************************************************************************}
  {* CASO UTILIZE TINTA DE MAQUINA DEVE TAMBEM CONSIDERAR OS COLORANTES COMO ENTREGA *}
  {* FUTURA PARA CALCULO DE QUANTIDADE PENDENTE. SOLICITADO PELA "DARKA" 28/08/2013  *}
  {********************************************************************************JC*}
  If fCfgSis('USATMQ', varBoolean) Then
  Begin
    {********************************}
    {* SOMA OS COLORANTES DO MOVDET *}
    {*****************************JC*}
    Result := Result + ' + ';
    Result := Result + 'IFNULL((SELECT ';
    Result := Result + '  SUM(COL.DET_QTDITE * ( 1 - IFNULL(DET.DET_QTDENT / DET.DET_QTDITE, 0) ) / IF(IFNULL(ITE.ITE_CNV_ML, 0) > 0, ITE.ITE_CNV_ML, 1)) AS QTDPEN ';
    Result := Result + 'FROM ';
    Result := Result + '  MOVDET DET ';
    Result := Result + '  INNER JOIN MOVTRI TRI ON DET.AUTOINCREM = TRI.DET_SEQGER ';
    Result := Result + '  INNER JOIN MOVDET COL ON DET.DET_CODACA = COL.DET_CODACA AND ';
    Result := Result + '                           DET.DET_EMPACA = COL.DET_EMPACA AND ';
    Result := Result + '                           DET.DET_NUMDOC = COL.DET_NUMFAT AND ';
    Result := Result + '                           DET.DET_ESPDOC = COL.DET_TIPFAT AND ';
    Result := Result + '                           DET.DET_CODEMP = COL.DET_EMPFAT AND ';
    Result := Result + '                           DET.DET_CODCLI = COL.DET_CODCLI ';

    Result := Result + '  INNER JOIN CADITE ITE ON ITE.ITE_CODITE = COL.DET_CODITE ';

    Result := Result + 'WHERE   DET.DET_TIP_FC = "C"     ';
    Result := Result + '    AND DET.DET_ENTFUT = "S"     ';
    Result := Result + '    AND DET.DET_ESPDOC NOT IN ("ML", "PR", "TM") ';
    Result := Result + '    AND COL.DET_ESPDOC = "ML"    ';

    If fCfgSis('EFTEST') = '2' Then
    Begin
      Result := Result + '   AND (DET.DET_PROEMB <> "S" OR TRI.DET_BXSBIT = "S") ';//Para exibir os sub-itens (proemb = 's' e bxsbit = 's')
      Result := Result + '   AND (DET.DET_FILKAR = 0) ';//Para nao exibir o item principal (que vai estar com filkar = 1)
    End
    Else
      Result := Result + '   AND DET.DET_PROEMB <> "S" ';

    Result := Result + '    AND DET.DET_IDEPRO <> "NOR"  ';

    If Not fCfgSis('BEFTRG', VarBoolean) Then
      Result := Result + '    AND IFNULL(COL.DET_FILKAR,0) = 0 ';

    Result := Result + '    AND IFNULL(ROUND(IFNULL(DET.DET_QTDITE,0) - IFNULL(DET.DET_QTDENT,0),4), 0) > 0 ';

    If blnEfBaixExiste Then
      Result := Result + ' AND DET.DET_EFBAIX = "N" ';

    If Not fEmptyStr(strCodEmp) Then
      Result := Result + '  AND COL.DET_CODEMP IN (' + strCodEmp + ') ';

    Result := Result + '  AND COL.DET_CODITE = ' + strCodIte + ' ';

    Result := Result + '  ), 0) ';
  end;

  Result := Result;

end;

