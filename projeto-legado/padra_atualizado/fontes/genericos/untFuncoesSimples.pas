      Until (Not LExiste);
    except
      On E: Exception do
        raise Exception.Create('Problemas ao pegar o próximo sequencial de crédito de cliente. ' + E.Message);
    end;
  Finally
    FreeAndNil(LQuery);
  End;
End;

