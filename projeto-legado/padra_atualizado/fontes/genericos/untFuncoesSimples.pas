function fRetDataBaseCalculoCondicaoPagto(mskPreVis: TMaskEdit; blnFatPed: Boolean; dtaDtaPed: TDateTime; const AblnUtilizarDataEmissaoCalcularDiaVencimento: boolean): TDateTime;
Begin
  If (fUtilizarComoDataBaseCtrDataEmissaoPedido(blnFatPed, AblnUtilizarDataEmissaoCalcularDiaVencimento)) Then
  Begin
    If (fUtilizarComoDataBaseCtrDataPrevisaoPedido(blnFatPed)) Then
    Begin
      If (mskPreVis <> Nil) And (mskPreVis.Visible) And (Not fEmptyStr(fTiraCaracEspeciais(mskPreVis.Text))) Then
        Result := StrToDate(mskPreVis.Text)
      Else
        Result := dtaDtaPed;
    End
    Else
      Result := dtaDtaPed;
  End
  Else If (mskPreVis <> Nil) And (mskPreVis.Visible) And (Not fEmptyStr(fTiraCaracEspeciais(mskPreVis.Text))) Then
    Result := StrToDate(mskPreVis.Text)
  Else
    Result := VS_Date;
End;

function fRetDataBaseCalculoCondicaoPagto(dtaPreVis: TDateTime; blnFatPed: Boolean; dtaDtaPed: TDateTime; const AblnUtilizarDataEmissaoCalcularDiaVencimento: boolean): TDateTime;
Begin
  If (fUtilizarComoDataBaseCtrDataEmissaoPedido(blnFatPed, AblnUtilizarDataEmissaoCalcularDiaVencimento)) Then
  Begin
    If (fUtilizarComoDataBaseCtrDataPrevisaoPedido(blnFatPed)) Then
    Begin
      If (dtaPreVis > 0) Then
        Result := dtaPreVis
      Else
        Result := dtaDtaPed;
    End
    Else
      Result := dtaDtaPed;
