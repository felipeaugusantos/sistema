function fRetornaStatusRemessaDeSeparacao(AOndSep: String): String;
const
  SQL = 'SELECT "*" AS STA, COUNT(*) AS CNT FROM ONDSEP WHERE OND_SEQOND = :SEQOND ' +
        'UNION ALL ' +
        'SELECT "F" AS STA, COUNT(*) AS CNT FROM ONDSEP WHERE OND_SEQOND = :SEQOND AND OND_STATUS = "F" ' +
        'UNION ALL ' +
        'SELECT "S" AS STA, COUNT(*) AS CNT FROM ONDSEP WHERE OND_SEQOND = :SEQOND AND OND_STATUS = "S" ';
var
  LTodos : Integer;
  LFinalizado : Integer;
  LSeparando : Integer;
  LQryStatus : TUniQuery;
begin
  Result := 'A';

  LTodos := 0;
  LFinalizado := 0;
  LSeparando := 0;

  LQryStatus := fCriaQuery;
  
  try
    LQryStatus.SQL.Text := SQL;
    LQryStatus.ParamByName('SEQOND').AsString := AOndSep;
    LQryStatus.Open;
    
    If LQryStatus.Locate('STA', '*', []) Then
      LTodos := LQryStatus.FieldByName('CNT').AsInteger;

    If LQryStatus.Locate('STA', 'F', []) Then
      LFinalizado := LQryStatus.FieldByName('CNT').AsInteger;

    If LQryStatus.Locate('STA', 'S', []) Then
      LSeparando := LQryStatus.FieldByName('CNT').AsInteger;

    if (LTodos = 0) then
      Exit;

    If (LTodos = LFinalizado) Then
      Result := 'F'
    Else If (LFinalizado > 0) Then
      Result := 'P'
    Else If (LSeparando > 0) Then
      Result := 'S';
  finally
    FreeAndNil(LQryStatus);
  end;
end;

