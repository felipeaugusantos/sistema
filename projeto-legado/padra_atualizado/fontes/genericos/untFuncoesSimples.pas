function fPermiteExpedicaoParcial(const blnEhParcial: Boolean;
  const strTiposExpedicao, strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  objLiberacao : ILiberacao;
  qryDados     : TUniQuery;
begin
  if (blnEhParcial) And
     (Pos(fCfgSis('TIPEXP', varString), strTiposExpedicao) > 0) And
     (fCfgSis('EXPPAR', varString) = 'P') Then
  Begin
    qryDados := fCriaQuery(Nil);
    Try
      qryDados.SQL.Text := 'SELECT '
                         + '       FGO_CODCLI '
                         + '     , CLI_NOMCLI '
                         + '     , CLI_C_G_C_ '
                         + '     , FGO_NUMDOC '
                         + '     , FGO_ESPDOC '
                         + '     , FGO_CODEMP '
                         + '     , FGO_CONPAG '
                         + '     , FGO_CODCND '
                         + '     , CND_DESCRI '
                         + '     , FGO_CODFPG '
                         + '     , FPG_DESCRI '
                         + '     , FGO_VLRCON '
                         + '  FROM FATGOR '
                         + ' INNER JOIN CADCLI ON CLI_CODCLI = FGO_CODCLI '
                         + '  LEFT JOIN CADCND ON CND_CODIGO = FGO_CODCND '
                         + '  LEFT JOIN CADFPG ON FPG_CODIGO = FGO_CODFPG '
                         + ' WHERE FGO_NUMDOC = :NUMDOC '
                         + '   AND FGO_ESPDOC = :ESPDOC '
                         + '   AND FGO_CODEMP = :CODEMP ';

      qryDados.Close;
      qryDados.ParamByName('NUMDOC').AsString := strNumDoc;
      qryDados.ParamByName('ESPDOC').AsString := strEspDoc;
      qryDados.ParamByName('CODEMP').AsString := strCodEmp;
      qryDados.Open;

      objLiberacao := TLiberacaoFactory.fGetLiberacao;
      objLiberacao.Clear;

      objLiberacao.objMsgLibera.pAddTexto('Permitir Expedição Parcial.');
      objLiberacao.strDirAce := 'DIREXPPAR';
      objLiberacao.strMsgSen := 'Expedição Parcial';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCodDig := strLoginUsuarioLogado;

      If Not qryDados.IsEmpty Then
      Begin
        objLiberacao.objMsgLibera.pAddTexto('CPF/CNPJ: '+qryDados.FieldByName('CLI_C_G_C_').AsString);
        objLiberacao.objMsgLibera.pAddTexto('CLIENTE: '+qryDados.FieldByName('FGO_CODCLI').AsString
                                                       +' - '
                                                       +qryDados.FieldByName('CLI_NOMCLI').AsString);
        objLiberacao.objMsgLibera.pAddTexto('NÚMERO PEDIDO............: '+qryDados.FieldByName('FGO_NUMDOC').AsString
                                                                         +'-'
                                                                         +qryDados.FieldByName('FGO_ESPDOC').AsString
                                                                         +'-'
                                                                         +qryDados.FieldByName('FGO_CODEMP').AsString);
        objLiberacao.objMsgLibera.pAddTexto('CONDIÇÃO PAGTO...........: '+qryDados.FieldByName('FGO_CODCND').AsString
                                                                         +' - '
                                                                         +qryDados.FieldByName('CND_DESCRI').AsString);
        objLiberacao.objMsgLibera.pAddTexto('FORMA DE PAGTO...........: '+qryDados.FieldByName('FGO_CODFPG').AsString
                                                                         +' - '
                                                                         +qryDados.FieldByName('FPG_DESCRI').AsString);
        objLiberacao.objMsgLibera.pAddTexto('VALOR TOTAL..............: '+FormatFloat(',0.00', qryDados.FieldByName('FGO_VLRCON').AsFloat));
      End;

      Result := objLiberacao.fLibera;

      If Not Result Then
        pMensagemOK('Expedição parcial cancelada!');
    Finally
      FreeAndNil(qryDados);
    End;
  End
  Else
    Result := blnEhParcial;
end;

