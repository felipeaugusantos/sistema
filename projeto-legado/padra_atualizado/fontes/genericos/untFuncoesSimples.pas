function fValidaSePedidoOriundoOSPodeSerAlterado(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var 
    strNumOse: String;
begin
  Result := True;

  If fCfgSis('GER_OS', varBoolean) Then
  Begin
    If fEhPedidoOSRealizada(strNumDoc, strEspDoc, strCodEmp) Then
    Begin
      pMensagemOk('Este pedido de venda está vinculado a uma O.S.' + #13 +
                  'que já foi realizada e não pode ser alterado!');
      Result := False;
    End;
  End
  Else
  Begin                      
    strNumOse := fRetornaOrdemServicoPedido(strNumDoc, strCodEmp);
    If Not fEmptyStr(strNumOse) Then
    Begin
      pMensagemOk('Este pedido de venda foi gerado a partir' + #13 +
                  'da O.S. ' + strNumOse + ' e não pode ser alterado.' + #13 + #13 +
                  'As alterações devem ser feitas na própria O.S.!');
      Result := False;
    End;
  End;
end;

function fEhPedidoOSRealizada(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  strSQL: String;
  qryAux: TUniQuery;
begin
  Result := False;

  If Not fEmptyStr(strNumDoc) Then
  Begin
    qryAux := fCriaQuery;

    try
      strSQL := '';
      strSQL := strSQL + ' SELECT EQU_NUMOSE ';
      strSQL := strSQL + ' FROM EQUGER ';
      strSQL := strSQL + ' WHERE EQU_STATUS = "R"     AND ';
      strSQL := strSQL + '     ((EQU_NUMPED = :NUMDOC AND ';
      strSQL := strSQL + '       EQU_TIPPED = :ESPDOC AND ';
      strSQL := strSQL + '       EQU_EMPPED = :CODEMP) OR ';
      strSQL := strSQL + '      (EXISTS (SELECT FGO_SEQEQU FROM EQUGOR ';
      strSQL := strSQL + '               LEFT JOIN FATGOR ON EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';
      strSQL := strSQL + '               WHERE EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU AND ';
      strSQL := strSQL + '                   FGO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '                   FGO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '                   FGO_CODEMP = :CODEMP)))   ';

      qryAux.SQL.Text := strSQL;
      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.Open;

      Result := not qryAux.IsEmpty;
    finally
      FreeAndNil(qryAux);
    end;
  End;
end;

function fRetornaOrdemServicoPedido(strNumPed, strEmpPed: String; strVenPed: String = ''; strEspDoc: String = 'PD'): String;
begin
  If fEmptyStr(strNumPed) Then
    Exit('');

  With fCriaQuery Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('SELECT        ');
    SQL.Add('  EQU_NUMOSE  ');
    SQL.Add('FROM          ');
    SQL.Add('  EQUGER      ');
    SQL.Add('WHERE         ');
    SQL.Add('  (EQU_NUMPED = :NUMDOC AND   ');
    SQL.Add('  EQU_TIPPED = :ESPDOC    AND   ');
    SQL.Add('  EQU_EMPPED = :CODEMP       ');

    If Not FEmptyStr(strVenPed) Then
      SQL.Add('  AND EQU_VENPED = :CODVEN ');

    SQL.Add('   ) OR (EXISTS (SELECT FGO_SEQEQU FROM EQUGOR ');
    SQL.Add('                 LEFT JOIN FATGOR ON EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ');
    SQL.Add('                 WHERE EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU AND ');
    SQL.Add('                     FGO_NUMDOC = :NUMDOC AND   ');
    SQL.Add('                     FGO_ESPDOC = "PD"    AND   ');
    SQL.Add('                     FGO_CODEMP = :CODEMP       ');

    If Not FEmptyStr(strVenPed) Then
      SQL.Add('  AND FGO_CODVEN = :CODVEN ');

    SQL.Add('  )) ');

    ParamByName('NUMDOC').AsString := strNumPed;
    ParamByName('CODEMP').AsString := strEmpPed;
    ParamByName('ESPDOC').AsString := strEspDoc;

    If Not FEmptyStr(strVenPed) Then
      ParamByName('CODVEN').AsString := strVenPed;

    Open;

    Result := FieldByName('EQU_NUMOSE').AsString;

    Close;

    Destroy;
  End;
end;

function fPedidoPossuiItemExpedido(strAutGor: String): Boolean;
var
  qryGen: TUniQuery;
begin
  qryGen := fCriaQuery;

  Try
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add('SELECT ');
    qryGen.SQL.Add('  COUNT(*) ');
    qryGen.SQL.Add('FROM FATDOR ');
    qryGen.SQL.Add('LEFT JOIN EXTDOR ON FDO_SEQFDO = FATDOR.AUTOINCREM ');
    qryGen.SQL.Add('WHERE ');
    qryGen.SQL.Add('  FATDOR.FDO_SEQGER = :AUTINC AND ');
    qryGen.SQL.Add('  FDO_ESPDOC  = :ESPDOC AND ');
    qryGen.SQL.Add('  FDO_CODITE <> :ITESER AND ');
    qryGen.SQL.Add('  FDO_CODITE <> :SERTER AND ');
    qryGen.SQL.Add('  FDO_CODITE <> :ITEBOM AND ');
    qryGen.SQL.Add('  FDO_CODITE <> :ITETAX AND ');
    qryGen.SQL.Add('  FDO_CODITE <> :ITEMAN AND ');
    qryGen.SQL.Add('  FDO_CODITE <> :ITELAN AND ');
    qryGen.SQL.Add('  IFNULL(FDO_QTDEXP, 0) > 0 ');

    qryGen.ParamByName('AUTINC').AsString := strAutGor;
    qryGen.ParamByName('ESPDOC').AsString := 'PD';
    qryGen.ParamByName('ITESER').AsString := fCfgSis('ITESER', varString);
    qryGen.ParamByName('SERTER').AsString := fCfgSis('SERTER', varString);
    qryGen.ParamByName('ITEBOM').AsString := fCfgSis('ITEBOM', varString);
    qryGen.ParamByName('ITETAX').AsString := fCfgSis('ITETAX', varString);
    qryGen.ParamByName('ITEMAN').AsString := fCfgSis('ITEMAN', varString);
    qryGen.ParamByName('ITELAN').AsString := fCfgSis('ITELAN', varString);

    qryGen.Open;
    Result := (qryGen.Fields[0].AsInteger > 0);
    qryGen.Close;
  finally
    FreeAndNil(qryGen);
  end;
end;

function fVerificaTipoComissao(strCodDiv: String): String;
  Var
    strTipCom : String;
begin
  If fCfgSis('TCOPRO') <> '4' Then
  Begin
    strTipCom := fRetTipoComissaoDiversos(strCodDiv);
    //Caso define o tipo de comissao no cadastro do profissional
    If (fCfgSis('TIPCOM') = 'P') And Not fEmptyStr(strTipCom) Then
    Begin
      Case strTipCom[1] Of
        'P': Result := '1'; //Cadastro do profissional (Diversos)
        'I': Result := '2'; //Cadastro do produto
        'F': Result := '3'; //Faixas Faturamento
        'C': Result := '4'; //Cadastro do cliente
        Else Result := fCfgSis('ORIPRO'); //configuracao geral (default)
      End;
    End
    Else
      Result := fCfgSis('ORIPRO');
  End
  Else
    Result := '2'; //Cadastro de Produtos
end;

{************************************}
{* RETORNA A COMISSÃO DE ACORDO COM *}
{* AS MARGENS CADASTRADAS           *}
{*********************************AF*}
function fRetCondicaoPagtoFaixaValor(fltValor: Double; blnCodCnd: Boolean = False; strTabela : String = 'FAICND'): String;
  Var
    strSQL: String;
  qryGen: TUniQuery;
Begin

  Try

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE      ';
    strSQL := strSQL + '  FAI_CONPAG,       ';
    strSQL := strSQL + '  FAI_CODCND, FAI_CODEMP ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + strTabela  ;
    strSQL := strSQL + ' WHERE    ';
    strSQL := strSQL + '   :VALOR >= FAI_VALINI AND ';
    strSQL := strSQL + '   :VALOR <= FAI_VALFIN     ';

    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Clear;
      Add(strSQL);
      ParamByName('VALOR').AsFloat := fltValor;
      Open;

      qryGen.Filtered := False;
      qryGen.Filter   := 'FAI_CODEMP = ' + QuotedStr(VS_strCodEmp);
      qryGen.Filtered := True;
      If RecordCount = 0 Then
         qryGen.Filtered := False;

      If Not blnCodCnd Then
        Result := FieldByName('FAI_CONPAG').AsString
      Else
        Result := FieldByName('FAI_CODCND').AsString;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

  If fEmptyStr(Result) Then
  Begin
    If Not blnCodCnd Then
      Result := '01000'
    Else
      Result := fCfgSis('CNDAVI', varString);
  End;
End;

