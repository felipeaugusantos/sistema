function fGetSQLUltimaVendaProduto(strCodIte: String; strCodCli: String = ''): String;
  Var
    strSQL : String;
begin
  strSQL :=  '';
  strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
  strSQL := strSQL + '        DET_DTAENT, DET_QTDITE, DET_TOTITE, DET_DESESP, DET_UNITAR ';
  strSQL := strSQL + '   FROM MOVDET ';
  strSQL := strSQL + '   WHERE DET_CODCLI NOT IN (' + VS_strCliFil + ') ';
  strSQL := strSQL + '     AND DET_TIP_FC = "C" ';
  strSQL := strSQL + '     AND IFNULL(DET_PROEMB, "N") <> "S" ';
  strSQL := strSQL + '     AND DET_CODITE = ' + QuotedStr(strCodIte) + ' ';
  strSQL := strSQL + '     AND ((LOCATE(DET_CLAFIS, ' + QuotedStr(VS_strClaVen) + ') > 0) OR ';
  strSQL := strSQL + '          (LOCATE(DET_CLAFIS, ' + QuotedStr(VS_strClaDev) + ') > 0) ';

  If (fCfgSis('ENTBRF', varBoolean)) Then
    strSQL := strSQL + ' OR (DET_ESPDOC = "BR") OR LOCATE(DET_CLAFIS,' + CLAFIS_BR + ')) '
  Else
    strSQL := strSQL + ') ';

  If Not fEmptyStr(strCodCli) Then
    strSQL := strSQL + ' AND DET_CODCLI = ' + QuotedStr(strCodCli);

  strSQL := strSQL + ' ORDER BY ';
  strSQL := strSQL + '   DET_DTAENT DESC ';
  strSQL := strSQL + ' LIMIT 1 ';
  Result := strSQL;
end;

