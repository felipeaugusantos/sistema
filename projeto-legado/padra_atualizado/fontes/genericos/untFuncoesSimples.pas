function fTemCadRecFFComBol(strNumDoc, strEspDoc, strCodEmp: String; strCodCli: String = ''): Boolean;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);
  Try
    qryAux.SQL.Text :=
         ' SELECT CTR_NUMDUP FROM CADREC ' +
         '  WHERE CTR_NUMDUP = :NUMDUP   ' +
         '    AND CTR_ESPDOC = :ESPDOC   ' +
         '    AND CTR_CODEMP = :CODEMP   ' +
         '    AND '+fRetSQLCadRecFFComBol;

    If (Not fEmptyStr(strCodCli)) Then
    Begin
      qryAux.SQL.Add(' AND CTR_CODCLI = :CODCLI ');
      qryAux.ParamByName('CODCLI').AsString := strCodCli;
    End;
    
    qryAux.ParamByName('NUMDUP').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.Open;

    Result := Not qryAux.IsEmpty;
  Finally
    FreeAndNil(qryAux);
  End;
end;

