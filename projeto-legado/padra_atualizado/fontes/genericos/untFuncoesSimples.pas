{Req. 456948-B - B6. AintQuantidade reserva um bloco de numeros numa unica
 chamada e devolve o primeiro. Com o default 1 o comportamento e o de hoje,
 byte a byte. Quem reserva bloco assume que os numeros do bloco sao seus e
 os distribui em memoria - e o mesmo contrato de fRetAutoIncrem(..., N).

 Motivo: o balanco chamava esta funcao uma vez por documento, ~990 vezes
 numa rodada grande com CFG_ITEDOC = 20, e cada chamada faz SELECT FOR
 UPDATE em CFGSIS - que mantem a linha travada ate o commit.}
function fRetSequencial(strNomCam: String; strCodEmp: String = ''; intTamanho: Integer = 6; blnApenasObterValorSequencial: Boolean = False; objConexao : TUniConnection = Nil; AintQuantidade: Integer = 1): String;
  Var
    blnComita: Boolean;
    qryCfgSis: TUniQuery;
    blnGravaLog: Boolean;
begin
  blnGravaLog := VS_blnGravaLogTransacao;

  Try
    If (Not Assigned(objConexao)) Then
      objConexao := frmModulo.GetCurrentConnection;

    VS_blnGravaLogTransacao := False;

    If fEmptyStr(strCodEmp) Then
      strCodEmp := VS_strCodEmp;

    fCfgSis(strNomCam, varString, strCodEmp);//Necessario para criar a configuracao quando nao existir

    qryCfgSis := fCriaQuery(nil, objConexao);

    blnComita := False;

    If (Not objConexao.InTransaction) Then
    Begin
      fStartTransaction(objConexao);
      blnComita := True;
    End;

    Try

      With qryCfgSis Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT  SQL_NO_CACHE       ');
        SQL.Add('  SIS_VALCFG               ');
        SQL.Add('FROM                       ');
        SQL.Add('  CFGSIS                   ');
        SQL.Add('WHERE                      ');
        SQL.Add('  SIS_CODEMP = :CODEMP AND ');
        SQL.Add('  SIS_CODCFG = :CODCFG     ');
        SQL.Add('FOR UPDATE                 ');

        ParamByName('CODEMP').Value := strCodEmp;
        ParamByName('CODCFG').Value := 'CFG_' + strNomCam;
        Open;

        pSetNaoReplicarConfig('CFG_' + strNomCam, objConexao);

        If Not fEmptyStr(FieldByName('SIS_VALCFG').AsString) Then
          Result := fStrZero(FieldByName('SIS_VALCFG').AsString, intTamanho)
        Else
          Result := fStrZero('1', intTamanho);

        if not blnApenasObterValorSequencial then
        fAtuCfgSis(strNomCam, IntToStr(StrToInt64Def(Result, 0)+AintQuantidade), strCodEmp, objConexao);   {Req. 456948-B - B6}
      End;

      If blnComita Then
        fCommit(objConexao);

    Except
      On E: Exception Do
      Begin
        If blnComita Then
          fRollBack(objConexao);
        pGravaInformacoesDaTransacaoInnoDB;
        Raise ExceptClass(E.ClassType).Create('Não consegui pegar o proximo sequencial de ' + strNomCam +
          ' em CFGSIS. Tente novamente! ' + sLineBreak + '[' + E.Message + ']');
      End;
    End;

  Finally
    VS_blnGravaLogTransacao := blnGravaLog;
    FreeAndNil(qryCfgSis);
  End;

end;

function fRetSequencialCadPag(intQtdCod: Integer = 1; AstrEmpresa: String = ''): String;
  Var
    strSQL   : String;
    blnExiste: Boolean;
    qryGenCtp: TUniQuery;
    LTransacao: TCriarConexao;
begin
  Try

    qryGenCtp := fCriaQuery;
    LTransacao := TCriarConexao.Create('fRetSequencialCadPag');

    Repeat
      LTransacao.objConexao.StartTransaction;
      Result := 'G' + RightStr(fAtualizaProCod('CADPAG', '', '', intQtdCod, LTransacao.objConexao), 11);
      LTransacao.objConexao.Commit;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  COUNT(*) AS QTD ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADPAG ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  CTP_NUMDUP = :NUMDUP AND ';
      strSQL := strSQL + '  CTP_CODEMP = :CODEMP ';

      With qryGenCtp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDUP').AsString := Result;

        if fEmptyStr(AstrEmpresa) then
          ParamByName('CODEMP').AsString := VS_strCodEmp
        else
          ParamByName('CODEMP').AsString := AstrEmpresa;

        Open;
        blnExiste := (FieldByName('QTD').AsInteger > 0);
        Close;
      End;

    Until (Not blnExiste);

  Finally
    FreeAndNil(qryGenCtp);
    FreeAndNil(LTransacao);
  End;

End;

function RetornaSequencialCreditoCliente: String;
var
  LSQL   : String;
  LExiste: Boolean;
  LQuery: TUniQuery;
begin
