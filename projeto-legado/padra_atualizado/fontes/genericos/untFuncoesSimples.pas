    strSQL := strSQL + '      SELECT * FROM CAMGER CG LEFT JOIN CAMCLI CC ON (CG.AUTOINCREM = CC.CCM_CODGER) WHERE CC.CCM_CODGER IS NULL    ';
    strSQL := strSQL + '      UNION                                                                                                         ';
    strSQL := strSQL + '      SELECT * FROM CAMGER CG INNER JOIN CAMCLI CC ON (CG.AUTOINCREM = CC.CCM_CODGER) WHERE CC.CCM_CODCLI =:CODCLI  ';
    strSQL := strSQL + '    ) CG                                                                                                            ';
    strSQL := strSQL + '  WHERE                                                                                                             ';
    strSQL := strSQL + '    CG.CMG_ATIVA_ = "S" AND                                                                                         ';
    strSQL := strSQL + '    CURRENT_DATE BETWEEN CG.CMG_DTAINI AND CG.CMG_DTAFIN                                                            ';

    qryTmp.Close;
    qryTmp.SQL.Clear;
    qryTmp.SQL.Add(strSQL);

    qryTmp.ParamByName('CODCLI').AsString   := strCodCli;
    qryTmp.Open;

    Result := (Not qryTmp.IsEmpty);
  Finally
    FreeAndNil(qryTmp);
  End;

End;

function fRetTipoDepartamentoVarios(strTipo: String): String;
  Var
    strSQL   : String;
    qryGenDpt: TUniQuery;
    intCont  : Integer;

begin
  Try
    intCont   := 1;
    qryGenDpt := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '      DEP_CODIGO    ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADDEP ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DEP_' + strTipo + ' = "S" ';

    With qryGenDpt Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      Open;

      If Not IsEmpty Then
      Begin
        First;
        While Not Eof Do
        Begin

          If intCont = 1 then
            Result := QuotedStr(FieldByName('DEP_CODIGO').AsString)
          Else
            Result := Result + ',' + QuotedStr(FieldByName('DEP_CODIGO').AsString);

          intCont := intCont + 1;
          Next;
        End;
      End
      Else
        Result := QuotedStr('N');
      Close;
    End;

  Finally
    FreeAndNil(qryGenDpt);
  End;
End;

