function fEnNotaEspecialDocumentoFator(const AEmpDoc, AEspDoc, ANumDoc, ACodCli, ASerie: String; var ADocOrig: TDocumentoFator): Boolean;
var
  LQuery : TUniQuery;
begin
  Result := False;

  LQuery := fCriaQuery;
  Try
    LQuery.SQL.Text := 'SELECT CONCAT(GER_NUMDOC,"-",GER_ESPDOC,"-",GER_CODEMP) AS NUMDOC, ' +
                       '       CONCAT(MNO_NUMFAT,"-",MNO_ESPFAT,"-",MNO_EMPFAT) AS DOCORI, ' +
                       '       MNO_NUMFAT ,MNO_ESPFAT, MNO_EMPFAT                          ' +
                       ' FROM CNFMNO                                                       ' +
                       ' INNER JOIN NOTGER AS NG ON MNO_SEQGER = NG.AUTOINCREM             ' +
                       ' WHERE MNO_SEQGER = (SELECT NOTGER.AUTOINCREM                      ' +
                                            '  FROM NOTGER                                 ' +
                                            '  LEFT JOIN AUXNOT ON AUXNOT.AUX_SEQGER = NOTGER.AUTOINCREM ' +
                                            ' WHERE NOTGER.GER_CODEMP = :GER_CODEMP ' +
                                            '   AND NOTGER.GER_NUMDOC = :GER_NUMDOC ' +
                                            '   AND NOTGER.GER_ESPDOC = :GER_ESPDOC ' +
                                            '   AND NOTGER.GER_CODCLI = :GER_CODCLI ' +
                                            '   AND NOTGER.GER_SERIE_ = :GER_SERIE_ ' +
                                            '   AND IFNULL(AUXNOT.AUX_OPCDOC,"") <> "MF" ' +
                                            ')';


    LQuery.ParamByName('GER_CODEMP').AsString := AEmpDoc;
    LQuery.ParamByName('GER_ESPDOC').AsString := AEspDoc;
    LQuery.ParamByName('GER_NUMDOC').AsString := ANumDoc;
    LQuery.ParamByName('GER_CODCLI').AsString := ACodCli;
    LQuery.ParamByName('GER_SERIE_').AsString := ASerie;
    LQuery.Open;
    If Not LQuery.IsEmpty Then
    Begin
      ADocOrig.strEmpDoc := LQuery.FieldByName('MNO_EMPFAT').AsString;
      ADocOrig.strEspDoc := LQuery.FieldByName('MNO_ESPFAT').AsString;
      ADocOrig.strNumDoc := LQuery.FieldByName('MNO_NUMFAT').AsString;
      ADocOrig.strCliDoc := fCampoTabela('GER_CODCLI', 'MOVGER', ['GER_CODEMP', 'GER_NUMDOC', 'GER_ESPDOC'], [ADocOrig.strEmpDoc,
                                                                                                              ADocOrig.strNumDoc,
                                                                                                              ADocOrig.strEspDoc ], False);
      ADocOrig.strDocOri := LQuery.FieldByName('DOCORI').AsString;

      Result := Not fEmptyStr(LQuery.FieldByName('DOCORI').AsString);
    End;
  Finally
    FreeAndNil(LQuery);
  End;
end;

function fTipoFretePermitidoTransportadora(const ACodTra, ATipFre: String): Boolean;
var
  LQry: TUniQuery;
  LTipoFreteEncontrado: Boolean;
begin

  If Not(fCfgSis('TRPPRM', varBoolean)) Then
    Exit(True);

  If fEmptyStr(ATipFre) Then
    Exit(False);

  LTipoFreteEncontrado := False;
  LQry := fCriaQuery;
  Try
    LQry.SQL.Add('SELECT FRE_TIPFRE AS TIPFRE FROM FREPRM');
    LQry.SQL.Add(' WHERE FRE_CODTRA =  :CODTRA           ');
    LQry.SQL.Add('   AND FRE_TIPFRE <> 0                 ');
    LQry.ParamByName('CODTRA').AsString := ACodTra;
    LQry.Open;
    If Not LQry.IsEmpty Then
    Begin
      While Not LQry.EOF Do
      Begin
        If LQry.FieldByName('TIPFRE').AsInteger = StrToInt(ATipFre) Then
        Begin
          LTipoFreteEncontrado := True;
          Break;
        End;
        LQry.Next;
      End;
    End
    Else
      LTipoFreteEncontrado := True;

  Finally
    FreeAndNil(LQry);
  End;

  Result := LTipoFreteEncontrado;
end;

function fSQLPDRomaneioPeloDocConf: String;
begin
