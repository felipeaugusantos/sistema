  Result := ARR_LOC_RET[intIdx];
end;

function fRetIndexLocalRetira(ALocRet: String; AItems: TStrings): Integer;
var
  LIdxLocRec: Integer;
begin
  LIdxLocRec := IndexText(ALocRet, ARR_LOC_RET);

  if LIdxLocRec = -1 then
    Result := -1
  else
    Result := AItems.IndexOf(fVerificaDescAdicionalLocRet(ARR_LOC_RET_DESC[LIdxLocRec], LIdxLocRec + 1));
end;

function fVerificaDescAdicionalLocRet(strDescri: String; intIndex: Integer): String;
var
  strSQL: String;
  qryDescri: TUniQuery;
begin
  Result := strDescri;

  if (intIndex <= 0) then
    Exit;

  qryDescri := fCriaQuery;

  try
    strSQL := '';
    strSQL := strSQL + 'SELECT DLR_DESCRI DESCRI FROM CADDLR ';
    strSQL := strSQL + 'WHERE DLR_LOCRET = ' + IntToStr(intIndex) + ' AND IFNULL(DLR_DESCRI, "") <> "" ';
    
    qryDescri.SQL.Text := strSQL;
    qryDescri.Open;

    if (not qryDescri.IsEmpty) then
      Result := strDescri + ' ' + qryDescri.FieldByName('DESCRI').AsString;
  finally
    FreeAndNil(qryDescri);
  end;
end;

function fVerificaDescAdicionalLocRet(strDescri: String): String;
var
  strSQL,
  strLocRet: String;
  qryDescri: TUniQuery;
begin
  Result := strDescri;

  qryDescri := fCriaQuery;

  try
    strSQL := '';
    strSQL := strSQL + 'SELECT DLR_LOCRET, DLR_DESCRI FROM CADDLR WHERE IFNULL(DLR_DESCRI, "") <> "" ';

    qryDescri.SQL.Text := strSQL;
    qryDescri.Open;

    if (qryDescri.IsEmpty) then
      Exit;

    while not qryDescri.Eof do
    begin
      strLocRet := ARR_LOC_RET_DESC[qryDescri.FieldByName('DLR_LOCRET').AsInteger - 1];

      if (SameText(strDescri, strLocRet + ' ' + qryDescri.FieldByName('DLR_DESCRI').AsString)) then
      begin
        Result := strLocRet;
        Exit;
      end;

      qryDescri.Next;
    end;
  finally
    FreeAndNil(qryDescri);
  end;
end;

function fPrimeiraLetraMaiuscula(strFrase: String): string;
var
  intCont: integer;
begin
  strFrase := AnsiLowerCase(strFrase);

  for intCont := 1 to Length(strFrase) do
  begin
    if (intCont = 1) then
      strFrase[intCont] := UpCase(strFrase[intCont])
    else
    begin
      if intCont <> Length(strFrase) then
      begin
        if (strFrase[intCont] = ' ') then
          strFrase[intCont + 1] := UpCase(strFrase[intCont + 1]);
      end;
    end;
  end;

  Result := strFrase;
end;

function fSugestaoLocalRetira: Integer;
var
  strOplore : string;
  intContador,
  intQtdOpcoes,
  intLocrsu,
  intTamanho : Integer;
begin
  Result := 0;

  If Not fCfgSis('LOCRET', varBoolean) Then
    Exit;

  strOplore := fCfgSis('OPLORE', varString);
  intLocrsu := fCfgSis('LOCRSU', varInteger);

  intTamanho := Length(strOplore);

  intQtdOpcoes := 0;

  For intContador := 1 To intTamanho Do
  Begin
    If intContador >= intLocrsu Then
      Break;

    If (Copy(strOplore, intContador, 1) = 'N') Then
      inc(intQtdOpcoes);
  End;

  Result := intLocrsu - (1 + intQtdOpcoes);
end;

