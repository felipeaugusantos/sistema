function fExpirarSenhasVencidasOperadores(strCodigoEmpresa: string): Boolean;
begin
  Try
    fExecutaSQL(
      Format(
        'UPDATE CADOPE ' +
        'SET OPE_SENEXP = ''S'' ' +
        'WHERE OPE_SENEXP <> ''S'' ' +
        'AND OPE_ALTSEN < DATE_SUB(CURRENT_DATE, INTERVAL (SELECT CAST(SIS_VALCFG AS SIGNED) ' +
        'FROM CFGSIS WHERE SIS_CODCFG = ''CFG_EXPSEN'' AND SIS_CODEMP = ''%s'') DAY)',
        [strCodigoEmpresa]
      )
    );

    Result := True;
  Except
    On E: Exception Do
      Result := False;
  End;
end;

function fSalvarTextoEmArquivo(strTexto: String; strNomeArquivo: String; blnLimparAntes: Boolean = False): Boolean;
  Var
    LogFile: TextFile;
    blnAbriu : Boolean;
begin
  Result := False;
  blnAbriu := False;

  If (fEmptyStr(strNomeArquivo)) Then
  Begin
    pMensagemOk('Nome do arquivo em branco!');
    Exit;
  End;

  Try
    Try
      AssignFile(LogFile, strNomeArquivo);
      if (FileExists(strNomeArquivo)) And (Not blnLimparAntes) then
        Append(LogFile)
      else
        Rewrite(LogFile);

      blnAbriu := True;
      Writeln(LogFile, strTexto);
      Result := True;
    Except
      Result := False;
    End;
  Finally
    If blnAbriu Then
      CloseFile(LogFile);
  End;
end;

function fValorCashGeradoVenda(const ANumDoc, AEspDoc, ACodEmp: String): Double;
var
  LQry: TUniQuery;
begin
  LQry := fCriaQuery;

  try
    LQry.SQL.Add('SELECT SUM(VCB_VLRCSH) AS VLRCSH ');
    LQry.SQL.Add('FROM VENCSH ');
    LQry.SQL.Add('WHERE VCB_NUMDOC = :NUMDOC ');
    LQry.SQL.Add('  AND VCB_ESPDOC = :ESPDOC ');
    LQry.SQL.Add('  AND VCB_CODEMP = :CODEMP ');
    LQry.ParamByName('NUMDOC').AsString := ANumDoc;
    LQry.ParamByName('ESPDOC').AsString := AEspDoc;
    LQry.ParamByName('CODEMP').AsString := ACodEmp;
    LQry.Open;

    Result := StrToFloatDef(LQry.FieldByName('VLRCSH').AsString, 0);
  finally
    FreeAndNil(LQry);
  end;
end;

function fVencimentoCashGeradoVenda(const ANumDoc, AEspDoc, ACodEmp: String): String;
var
  strDtaVen : String;
begin
  strDtaVen := fCampoTabela('VCB_DTAVAL',
                            'VENCSH',
                            ['VCB_NUMDOC', 'VCB_ESPDOC', 'VCB_CODEMP'],
                            [ANumDoc, AEspDoc, ACodEmp]);
  Result := IIF(strDtaVen = '31/12/9999', '', strDtaVen);
end;

function fSQLFatorDesUni: String;
begin
  Result := '(1 - IF(PCG_ADAFO1 = "S", IFNULL(PCD_DESUNI, 0) + IFNULL(PCG_DESADI, 0), IFNULL(PCD_DESUNI, 0)) / 100)';
end;


function fSQLFatorDesAdi(const pUniPcg: String): String;
begin
  If pUniPcg = '7' Then
    Result := '(1 - IF(PCG_ADAFO1 = "S", 0, IFNULL(PCG_DESADI, 0)) / 100)'
  Else
    Result := '1';
end;

