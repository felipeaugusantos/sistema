function fReqTemCotacaoOuPcmDet(strCodigo, strCodEmp: String): Boolean;
  Var
    qryReqCmp : TUniQuery;
begin
  qryReqCmp := fCriaQuery(Nil);
  Try
    qryReqCmp.Close;
    qryReqCmp.SQL.Clear;
    qryReqCmp.SQL.Add(' SELECT COUNT(*) AS CNT ');
    qryReqCmp.SQL.Add('   FROM MOVRCD ');
    qryReqCmp.SQL.Add('  WHERE RCD_CODIGO = :CODIGO ');
    qryReqCmp.SQL.Add('    AND RCD_CODEMP = :CODEMP ');
    qryReqCmp.SQL.Add('    AND (RCD_SEQCOT IS NOT NULL ');
    qryReqCmp.SQL.Add('         OR RCD_SEQPCD IS NOT NULL) ');
    qryReqCmp.ParamByName('CODIGO').AsString := strCodigo;
    qryReqCmp.ParamByName('CODEMP').AsString := strCodEmp;
    qryReqCmp.Open;
    Result := (qryReqCmp.FieldByName('CNT').AsInteger > 0);
    qryReqCmp.Close;
  Finally
    FreeAndNil(qryReqCmp);
  End;
end;

function fDataUltimoCanhotoPendente(strTipo, strCodigo : String; var stlDocs: TStringList): TDateTime;
Var
  qryCanhoto : TUniQuery;
  limite     : Integer;
  dataLimite : TDateTime;
begin
  Result := 0;

  If (Not fEmptyStr(strTipo)) And (Not fEmptyStr(strCodigo)) Then
  Begin

    qryCanhoto := fCriaQuery();

    Try

      qryCanhoto.Close();
      qryCanhoto.SQL.Clear();
      qryCanhoto.SQL.Add('SELECT FIS_DTAENT FROM CADFIS                                  ');
      qryCanhoto.SQL.Add('WHERE FIS_TIP_FC = :TIP_FC                                     ');
      qryCanhoto.SQL.Add('  AND FIS_FORCLI = :CODIGO                                     ');
      qryCanhoto.SQL.Add('  AND FIS_CNHREC = "N"                                         ');

      {Notas de complemento não valida regra}
      qryCanhoto.SQL.Add('  AND FIS_NFCOMP = "N"                                         ');

      qryCanhoto.SQL.Add('  AND FIS_ESPDOC IN ("NF","NS","NV","EL")                      ');
      qryCanhoto.SQL.Add('  AND LOCATE(FIS_HISTOR, "CANCELADO,DENEGADA,INUTILIZADO") = 0 ');
      qryCanhoto.SQL.Add('  AND (LOCATE(FIS_CLFSC1, :CLAVEN) > 0)                        ');
      qryCanhoto.SQL.Add('  AND (LOCATE(FIS_CLFSC1, :CLADEV) <= 0)                       ');
      qryCanhoto.SQL.Add('ORDER BY FIS_DTAENT ASC LIMIT 1');
      qryCanhoto.ParamByName('TIP_FC').AsString := strTipo;
      qryCanhoto.ParamByName('CODIGO').AsString := strCodigo;
      qryCanhoto.ParamByName('CLAVEN').AsString := VS_strClaVen;
      qryCanhoto.ParamByName('CLADEV').AsString := VS_strClaDev;
      qryCanhoto.Open;

      If (Not qryCanhoto.IsEmpty) Then
      Begin

        Result := qryCanhoto.FieldByName('FIS_DTAENT').AsDateTime;

        {Lista documentos já fora do prazo configurado}
        qryCanhoto.Close();
        qryCanhoto.SQL.Clear();
        qryCanhoto.SQL.Add('SELECT        ');
        qryCanhoto.SQL.Add('  FIS_NUMDOC, ');
        qryCanhoto.SQL.Add('  FIS_ESPDOC, ');
        qryCanhoto.SQL.Add('  FIS_DTAENT, ');
        qryCanhoto.SQL.Add('  FIS_CODEMP  ');
        qryCanhoto.SQL.Add('FROM          ');
        qryCanhoto.SQL.Add('  CADFIS      ');
        qryCanhoto.SQL.Add('WHERE         ');
        qryCanhoto.SQL.Add('  FIS_TIP_FC = :TIP_FC                                         ');
        qryCanhoto.SQL.Add('  AND FIS_FORCLI = :CODIGO                                     ');
        qryCanhoto.SQL.Add('  AND FIS_CNHREC = "N"                                         ');

        {Notas de complemento não valida regra}
        qryCanhoto.SQL.Add('  AND FIS_NFCOMP = "N"                                         ');

        qryCanhoto.SQL.Add('  AND FIS_ESPDOC IN ("NF","NS","NV","EL")                      ');
        qryCanhoto.SQL.Add('  AND LOCATE(FIS_HISTOR, "CANCELADO,DENEGADA,INUTILIZADO") = 0 ');
        qryCanhoto.SQL.Add('  AND (FIS_DTAENT < :DTALIM)                                   ');
        qryCanhoto.SQL.Add('  AND (LOCATE(FIS_CLFSC1, :CLAVEN) > 0)                        ');
        qryCanhoto.SQL.Add('  AND (LOCATE(FIS_CLFSC1, :CLADEV) <= 0)                       ');
        qryCanhoto.SQL.Add('ORDER BY                                                       ');
        qryCanhoto.SQL.Add('  FIS_DTAENT                                                   ');

        qryCanhoto.ParamByName('TIP_FC').AsString   := strTipo;
        qryCanhoto.ParamByName('CODIGO').AsString   := strCodigo;

        limite := fCfgSis('LIMCNH', varInteger);
        dataLimite := (VS_Date - limite);

        qryCanhoto.ParamByName('DTALIM').AsDateTime := dataLimite;
        qryCanhoto.ParamByName('CLAVEN').AsString   := VS_strClaVen;
        qryCanhoto.ParamByName('CLADEV').AsString   := VS_strClaDev;
        qryCanhoto.Open;

        stlDocs := TStringList.Create;
        stlDocs.Clear;

        qryCanhoto.First;
        while not qryCanhoto.Eof do
        begin

          stlDocs.Add(qryCanhoto.FieldByNAme('FIS_NUMDOC').AsString + '-' +
                      qryCanhoto.FieldByNAme('FIS_ESPDOC').AsString + '-' +
                      qryCanhoto.FieldByNAme('FIS_CODEMP').AsString + '-' +
                      qryCanhoto.FieldByNAme('FIS_DTAENT').AsString);

          qryCanhoto.Next

        end;

      End;

    Finally
      FreeAndNil(qryCanhoto);
    End;

  End;

end;

