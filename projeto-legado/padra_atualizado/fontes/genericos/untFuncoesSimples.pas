Function fGetMsgRelCnf: String;
  Var
    blnComDV : Boolean;
    blnComFF : Boolean;
    blnComTR : Boolean;
    strMsgCf : String;
    strEspCf : String;
begin
  strMsgCf := '';
  strEspCf := '';

  blnComDV := (fCfgSis('COM_DV') = '2');
  blnComFF := (fCfgSis('COM_FF') = '2') Or (fCfgSis('COM_FV') = '2');
  blnComTR := (fCfgSis('COM_TR') = '2');

  If (blnComDV) Or (blnComFF) Or (blnComTR) Then
  Begin
    strMsgCf := strMsgCf + '* O sistema esta configurado para considerar o(s) documento(s)';

    If (blnComDV) Then
    Begin
      If Not fEmptyStr(strEspCf) Then strEspCf := strEspCf + ',';
      strEspCf := strEspCf + 'DV';
    End;

    If (blnComFF) Then
    Begin
      If Not fEmptyStr(strEspCf) Then strEspCf := strEspCf + ',';
      strEspCf := strEspCf + 'FF';
    End;

    If (blnComTR) Then
    Begin
      If Not fEmptyStr(strEspCf) Then strEspCf := strEspCf + ',';
      strEspCf := strEspCf + 'TR';
    End;

    strMsgCf := strMsgCf + ' (' + strEspCf + ') por data de confirmação, porém neste relatório sempre é emitido por data de emissão.';
  End;

  Result := strMsgCf;
End;

function HorarioExecutaRobo(AValor: String): Boolean ;
  Var
    HroInicial : TDateTime;
    HroFinal   : TDateTime;
    HoraAtual  : TDateTime;
Begin
  Result := True;

  If Not fEmptyStr(AValor) Then
  Begin
    Result := False;

    HoraAtual  := TimeOf(fTime());
    HroInicial := StrToTime(Copy(AValor,10,5));
    HroFinal   := StrToTime(Copy(AValor,25,5));

    If (HoraAtual > HroInicial) And (HoraAtual < HroFinal) Then
      Result := True
    Else If HroInicial + HroFinal = 0 Then
      Result := True;
  End;

End;

