Procedure pRecalculaItensResponsavelFornecedor(strEmpresas, strCodIte: String; blnResFor: Boolean);
  Var
    qryItens,
    qryUpdate: TUniQuery;
    intContador: Integer;

    intDecUni: integer;
    blnST: Boolean;
    fltIcmsSTParteVenda: Double;

  function fPrecoCompraLiq: Double;
  begin
    Result := untFuncoesSimples.
              fCalculaPrecoCompraLiq(qryItens.FieldByName('ITE_PRECOM').AsFloat,
                                     qryItens.FieldByName('ITE_DESF01').AsFloat,
                                     qryItens.FieldByName('ITE_DESF02').AsFloat,
                                     qryItens.FieldByName('ITE_DESF03').AsFloat,
                                     qryItens.FieldByName('ITE_DESF04').AsFloat,
                                     qryItens.FieldByName('ITE_DESF05').AsFloat,
                                     qryItens.FieldByName('ITE_DESF06').AsFloat,
                                     intDecUni,
                                     (qryItens.FieldByName('ITE_PREDOL').AsString = 'S'));
  end;

Begin
  qryItens := fCriaQuery(Nil);
  qryUpdate:= fCriaQuery(Nil);


  With qryItens, SQL Do
  Begin
    Add('SELECT ');

    Add('  ITEGER.ITE_CODITE,');
    Add('  ITEGER.ITE_CODEMP,');
    Add('  ITE_PREDOL,');
    Add('  ITE_OUTVAL,');
    Add('  ITE_PRECOM,');
    Add('  ITE_DESF01,');
    Add('  ITE_DESF02,');
    Add('  ITE_DESF03,');
    Add('  ITE_DESF04,');
    Add('  ITE_DESF05,');
    Add('  ITE_DESF06,');
    Add('  ITE_PRECUS,');
    Add('  ITE_ICMSAI,');
    Add('  ITE_IPIENT,');
    Add('  ITE_IMPFED,');
    Add('  PCMPRO.SIS_VALCFG  AS PCMPRO, ');

    For intContador := 1 To Length(VS_strTabPrc) Do
    Begin
      Add('  ITE_PREVE'+ IntToStr(intContador) + ', ');
      Add('  ITE_MARBR'+ IntToStr(intContador) + ', ');
      Add('  ITE_COMTB'+ IntToStr(intContador) + ', ');
    End;

    Add('  ITE_DESOPE,');
    Add('  DECUNI.SIS_VALCFG AS DECUNI,');
    Add('  MARMKP.SIS_VALCFG AS MARMKP,');
    Add('  CID_ESTADO, ');
    Add('  IF(TIPABF.SIS_VALCFG = 1, CADITE.ITE_CODABF, ITEGER.ITE_CODABF) AS ITE_CODABF');
    Add('FROM ITEGER');
    Add('  INNER JOIN CFGSIS AS TIPABF ON TIPABF.SIS_CODCFG = "CFG_TIPABF" AND TIPABF.SIS_CODEMP = ITEGER.ITE_CODEMP');
    Add('  INNER JOIN CFGSIS AS DECUNI ON DECUNI.SIS_CODCFG = "CFG_DECUNI" AND DECUNI.SIS_CODEMP = ITEGER.ITE_CODEMP');
    Add('  INNER JOIN CFGSIS AS MARMKP ON MARMKP.SIS_CODCFG = "CFG_MARMKP" AND MARMKP.SIS_CODEMP = ITEGER.ITE_CODEMP');
    Add('  INNER JOIN CFGSIS AS PCMPRO ON PCMPRO.SIS_CODCFG = "CFG_PCMPRO" AND PCMPRO.SIS_CODEMP = ITEGER.ITE_CODEMP ');

    Add('  INNER JOIN CADEMP ON EMP_CODEMP = ITEGER.ITE_CODEMP ');
    Add('  INNER JOIN CADCID ON CID_CODCID = EMP_CODCID ');


    Add('  INNER JOIN CADITE ON CADITE.ITE_CODITE = ITEGER.ITE_CODITE');

    Add('WHERE');
    Add('  ITEGER.ITE_CODITE = :CODITE AND ');

    If blnResFor Then
      Add('  LOCATE(ITEGER.ITE_CODEMP, :CODEMP) = 0 ')
    Else
      Add('  LOCATE(ITEGER.ITE_CODEMP, :CODEMP) > 0 ');

    ParamByName('CODITE').AsString := strCodIte;
    ParamByName('CODEMP').AsString := strEmpresas;

    Open;
    qryUpdate.SQL.Clear;
    qryUpdate.SQL.Add('UPDATE ITEGER SET ITE_MARBR1 = :MARBR1,');
    qryUpdate.SQL.Add('                  ITE_MARBR2 = :MARBR2,');
    qryUpdate.SQL.Add('                  ITE_MARBR3 = :MARBR3,');
    qryUpdate.SQL.Add('                  ITE_MARBR4 = :MARBR4,');
    qryUpdate.SQL.Add('                  ITE_MARBR5 = :MARBR5,');
    qryUpdate.SQL.Add('                  ITE_MARBR6 = :MARBR6,');
    qryUpdate.SQL.Add('                  ITE_MARBR7 = :MARBR7');
    qryUpdate.SQL.Add('  WHERE ITE_CODITE = :CODITE AND ITE_CODEMP = :CODEMP');
    While Not Eof Do
    Begin

      intDecUni := qryItens.FieldByName('DECUNI').AsInteger;

      fltIcmsSTParteVenda := fGetIcmsSTParteVenda(blnST, qryItens.FieldByName('ITE_CODABF').AsString,
                             fPrecoCompraLiq,
                             qryItens.FieldByName('ITE_IPIENT').AsFloat,
                             qryItens.FieldByName('ITE_ICMSAI').AsFloat,
                             qryItens.FieldByName('MARMKP').AsString,
                             qryItens.FieldByName('CID_ESTADO').AsString);




      For intContador := 1 To Length(VS_strTabPrc) Do
      Begin
        qryUpdate.ParamByName('MARBR'+ IntToStr(intContador)).AsFloat := fCalculaPrecoVenda(2,
                                                                                            FieldByName('ITE_PRECUS').AsFloat + FieldByName('ITE_OUTVAL').AsFloat,
                                                                                            FieldByName('ITE_PREVE' + IntToStr(intContador)).AsFloat,
                                                                                            FieldByName('ITE_MARBR' + IntToStr(intContador)).AsFloat,
                                                                                            FieldByName('ITE_ICMSAI').AsFloat,
                                                                                            FieldByName('ITE_IMPFED').AsFloat,
                                                                                            FieldByName('ITE_DESOPE').AsFloat,
                                                                                            FieldByName('ITE_COMTB' + IntToStr(intContador)).AsFloat,
                                                                                            FieldByName('MARMKP').AsString,
                                                                                            FieldByName('PCMPRO').AsString,
                                                                                            FieldByName('DECUNI').AsInteger,
                                                                                            fltIcmsSTParteVenda,
                                                                                            blnST);
      End;
      qryUpdate.ParamByName('CODITE').AsString := qryItens.FieldByName('ITE_CODITE').AsString;
      qryUpdate.ParamByName('CODEMP').AsString := qryItens.FieldByName('ITE_CODEMP').AsString;
      qryUpdate.ExecSQL;

      Next;
    End;

  End;

  FreeAndNil(qryItens);
End;

