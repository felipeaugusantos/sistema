function fRetornaFilaImpressaoNFCe: String;
Var
  strSQL: String;
  qryFil: TUniQuery;
  frmFilasImpressaoNFCe: TfrmFilasImpressaoNFCe;
begin

  Result := '';

  Try

    qryFil := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  *      ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  FILNFC ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  FIL_CODEMP = :CODEMP ';

    If VS_SpoolImpressaoCitel Then
      strSQL := strSQL + '  AND FIL_SPOIMP = "S"  '
    Else
      strSQL := strSQL + '  AND FIL_SPOIMP <> "S" ';

    qryFil.Close;
    qryFil.SQL.Clear;
    qryFil.SQL.Add(strSQL);
    qryFil.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryFil.Open;

    If (qryFil.RecordCount = 1) Then
      Result := qryFil.FieldByName('FIL_NOMIMP').AsString
    Else If qryFil.Locate('FIL_NOMMAQ', VS_ComputerNetName, []) Then
      Result := qryFil.FieldByName('FIL_NOMIMP').AsString
    Else If qryFil.Locate('FIL_NOMMAQ', VS_WorkstationID, []) Then
      Result := qryFil.FieldByName('FIL_NOMIMP').AsString
    Else If (qryFil.RecordCount > 1) And VS_ExibirMensagemAoUsuario Then
    Begin
      pCriarFormularios(TfrmFilasImpressaoNFCe, frmFilasImpressaoNFCe);
      frmFilasImpressaoNFCe.qryFil := qryFil;
      frmFilasImpressaoNFCe.ShowModal;

      If (frmFilasImpressaoNFCe.ModalResult = mrOk) Then
        Result := frmFilasImpressaoNFCe.strFilImp;

      pFreeAndNil(frmFilasImpressaoNFCe);
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message,'[TfrmQckFatImpNFCe.fRetornaFilaImpressao]');
  End;
end;

