    strEmbala := strEmbala + ' IF(' + strAliasIteFor + '.ITE_CODITE IS NULL, ';
    strEmbala := strEmbala + '      IFNULL((SELECT BAR_EMBALA FROM ITEBAR WHERE BAR_CODITE = ' + strAliasCadIte + '.ITE_CODITE AND BAR_CODFOR = ' + strCodFor + ' ORDER BY BAR_COMPRA DESC LIMIT 1), IF(IFNULL(' + strAliasCadIte + '.ITE_EMBALA, 0) <> 0, ' + strAliasCadIte + '.ITE_EMBALA, 1)), ';
    strEmbala := strEmbala + '      IF(IFNULL(' + strAliasIteFor + '.ITE_CNVCUS, 0) <> 0, ' + strAliasIteFor + '.ITE_CNVCUS, 1)) '
  End Else
  Begin
    blnFiltraEna := (fCfgSis('INFPCE') = 'S') And (fCfgSis('CNVEMB') = 'S') And (fCfgSis('TABPRF') = 'N') and FiltraEnaNF;
    If blnFiltraEna Then
      strEmbala := strEmbala + ' IFNULL((SELECT BAR_EMBALA FROM ITEBAR WHERE BAR_CODITE = ' + strAliasCadIte + '.ITE_CODITE AND BAR_CODBAR = I03_CEAN), ';
    strEmbala := strEmbala + ' IFNULL((SELECT BAR_EMBALA FROM ITEBAR WHERE BAR_CODITE = ' + strAliasCadIte + '.ITE_CODITE AND BAR_CODFOR = ' + strCodFor + ' ORDER BY BAR_COMPRA DESC LIMIT 1), IF(IFNULL(' + strAliasCadIte + '.ITE_EMBALA, 0) <> 0, ' + strAliasCadIte + '.ITE_EMBALA, 1)) ';
    If blnFiltraEna Then
      strEmbala := strEmbala + ' ) ';
  End;
  Result := strEmbala;
End;

