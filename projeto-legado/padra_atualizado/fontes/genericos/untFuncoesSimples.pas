function fValidaPlaca(strPlaca: String): Boolean;
  Var
    intAux: Integer;
    strLetrasMercosul,
    strNumerosMercosul : String;
begin
  Result := Length(strPlaca) = 7;

  If Result Then
  Begin

    strLetrasMercosul := Copy(strPlaca,1,3)+Copy(strPlaca,5,1);
    strNumerosMercosul := Copy(strPlaca,4,1)+Copy(strPlaca,6,2);

    If (Pos(Copy(strPlaca,5,1),'0_1_2_3_4_5_6_7_8_9') = 0) Then //Padrão Mercosul
    Begin

      For intAux := 1 To strNumerosMercosul.Length Do
      Begin
        If Not CharInSet(strNumerosMercosul[intAux], ['0'..'9']) Then
        Begin
          Result := False;
          Break;
        End;
      End;

      For intAux := 1 To strLetrasMercosul.Length Do
      Begin
        If Not fEhLetra(strLetrasMercosul[intAux])  Then
        Begin
          Result := False;
          Break;
        End;
      End;

    End
    Else
    Begin
      For intAux := 1 To 7 Do
      Begin
        // Alterada a função de validar a placa pra validar o layout antigo LLL-9999
        // e também o novo layout LLL-9L99

        If ((intAux <= 3) And (Not CharInSet(strPlaca[intAux], ['A'..'Z']))) Or
           ((intAux = 5) and (Not CharInSet(strPlaca[intAux], ['A'..'Z'])) and (Not CharInSet(strPlaca[intAux], ['0'..'9']))) or
           ((intAux in [4,6,7]) And (Not CharInSet(strPlaca[intAux], ['0'..'9']))) Then
        Begin
          Result := False;
          Break;
        End;
      End;
    End;
  End;

  Result := Result Or fVeiculoZeroKm(strPlaca);

end;

{***************************************************************************************}
{* VEICULOS ZERO KM SERAO IDENTIFICADOS PELA LETRA "Z" SEGUIDA DE UM NUMERO SEQUENCIAL *}
{* EXEMPLO: Z00-0001, Z00-0002, Z00-0003 ... Z99-9999                                  *}
{************************************************************************************JC*}
