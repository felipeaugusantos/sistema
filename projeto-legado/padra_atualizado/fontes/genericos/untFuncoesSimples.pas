      stlListaItensInativos.Add(qryConsulta.FieldByName('ITE_CODITE').AsString +  ' - ' +
                                qryConsulta.FieldByName('ITE_DESITE').AsString);
      qryConsulta.Next;
    End;
    Result := True;
  Finally
    FreeAndNil(qryConsulta);
  End;

end;

function fDefiniuPathDllsECF: Boolean;
Var
  strValorCadeia: String;
  strPathECF: String;
begin
  Result := False;
  strPathECF := fCfgSis('DIRINI');
  If fEmptyStr(strPathECF) Then
    Exit;

  strValorCadeia := fLerCadeiaRegistryWindows(HKEY_CURRENT_USER, 'Environment', 'Path', crString);

  If Not fEmptyStr(strValorCadeia) Then
  Begin
    If Pos(strPathECF, strValorCadeia) <= 0 Then
    Begin
      strValorCadeia := strValorCadeia + ';' + strPathECF;
      pGravarCadeiaRegistryWindows(HKEY_CURRENT_USER, 'Environment', 'Path', crString, strValorCadeia);
      Result := True;
    End;
  End;
end;

function fLerCadeiaRegistryWindows(Const RootKey: HKEY; strChave, strCadeia: String; tpCadeia: TTpCadeiaRegistry): Variant;
Var
  reg: TRegistry;
begin
  Result := Null;
  reg := TRegistry.Create;
  Try
    Try
      reg.RootKey := RootKey;
      reg.OpenKey(strChave, False);
      If tpCadeia = crCurrency Then
        Result := reg.ReadCurrency(strCadeia);
      If tpCadeia = crBool Then
        Result := reg.ReadBool(strCadeia);
      If tpCadeia = crDate Then
        Result := reg.ReadDate(strCadeia);
      If tpCadeia = crDateTime Then
        Result := reg.ReadDateTime(strCadeia);
      If tpCadeia = crFloat Then
        Result := reg.ReadFloat(strCadeia);
      If tpCadeia = crInteger Then
        Result := reg.ReadInteger(strCadeia);
      If tpCadeia = crString Then
        Result := reg.ReadString(strCadeia);
      If tpCadeia = crTime Then
        Result := reg.ReadTime(strCadeia);

      reg.CloseKey;
    Except
      On E: Exception Do
      Begin
        fMensagem('ERRO', 'Ocorreu um erro durante a leitura do registro do windows.' + #13 + E.Message, ['&Ok']);
        Result := Null;
      End;
    End;
  Finally
    reg.Free;
  End;
end;

procedure pGravarCadeiaRegistryWindows(Const RootKey: HKEY; strChave, strCadeia: String; tpCadeia: TTpCadeiaRegistry; varValor: Variant);
Var
  reg: TRegistry;
begin
  reg := TRegistry.Create;
  Try
    Try
      reg.RootKey := RootKey;
      reg.OpenKey(strChave, False);
      If tpCadeia = crCurrency Then
        reg.WriteCurrency(strCadeia, varValor);
      If tpCadeia = crBool Then
        reg.WriteBool(strCadeia, varValor);
      If tpCadeia = crDate Then
        reg.WriteDate(strCadeia, varValor);
      If tpCadeia = crDateTime Then
        reg.WriteDate(strCadeia, varValor);
      If tpCadeia = crFloat Then
        reg.WriteFloat(strCadeia, varValor);
      If tpCadeia = crInteger Then
        reg.WriteInteger(strCadeia, varValor);
      If tpCadeia = crString Then
        reg.WriteString(strCadeia, varValor);
      If tpCadeia = crTime Then
        reg.WriteTime(strCadeia, varValor);

      reg.CloseKey;
    Except
      On E: Exception Do
      Begin
        fMensagem('ERRO', 'Ocorreu um erro durante a gravação no registro do windows.' + #13 + E.Message, ['&Ok']);
      End;
    End;
  Finally
    reg.Free;
  End;
end;

function fEmpLogadaPertenceBaseEmpFisica(blnSempreLerBanco: Boolean = False): Boolean;
