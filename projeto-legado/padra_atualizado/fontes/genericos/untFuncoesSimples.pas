procedure pBuscaInfSaldos(Var fltSaldos, fltCnvML, fltSalML: Double; strCodIte, strCodEmp: string);
var
  qrySaldos: TUniQuery;
begin
  qrySaldos := fCriaQuery;
  fltSaldos := 0;
  fltCnvML := 0;
  fltSalML := 0;

  try
    qrySaldos.Close;
    qrySaldos.SQL.Clear;
    qrySaldos.SQL.Add('SELECT ITE_SALDOS, ITE_SAL_ML ');
    qrySaldos.SQL.Add('FROM ITEGER');
    qrySaldos.SQL.Add('WHERE ITE_CODITE = :CODITE');
    qrySaldos.SQL.Add('AND ITE_CODEMP = :CODEMP');

    qrySaldos.ParamByName('CODITE').AsString := strCodIte;
    qrySaldos.ParamByName('CODEMP').AsString := strCodEmp;

    qrySaldos.Open;

    if not qrySaldos.IsEmpty then
    begin
      fltSaldos := qrySaldos.FieldByName('ITE_SALDOS').AsFloat;
      fltSalML := qrySaldos.FieldByName('ITE_SAL_ML').AsFloat;
    end;

    qrySaldos.Close;
    qrySaldos.SQL.Clear;
    qrySaldos.SQL.Add('SELECT ITE_CNV_ML ');
    qrySaldos.SQL.Add('FROM CADITE');
    qrySaldos.SQL.Add('WHERE ITE_CODITE = :CODITE');

    qrySaldos.ParamByName('CODITE').AsString := strCodIte;

    qrySaldos.Open;

    if not qrySaldos.IsEmpty then
    begin
      fltCnvML := qrySaldos.FieldByName('ITE_CNV_ML').AsFloat;
    end;
  finally
    FreeAndNil(qrySaldos);
  end;
end;

