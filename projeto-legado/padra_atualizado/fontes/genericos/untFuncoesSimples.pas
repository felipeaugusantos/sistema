function fRetornaTamanhoCampoTabela(strTabela, strCampo: String): Integer;
var
  qryTabela: TUniQuery;
  strSchema: string;
begin
  qryTabela := fCriaQuery;

  try
    Result := 0;
    strSchema := qryTabela.Connection.Database;

    qryTabela.Close;
    qryTabela.SQL.Clear;
    qryTabela.SQL.Add('SELECT DISTINCT CHARACTER_MAXIMUM_LENGTH AS TAMANHO');
    qryTabela.SQL.Add('FROM INFORMATION_SCHEMA.COLUMNS');
    qryTabela.SQL.Add('WHERE COLUMN_NAME = :CAMPO');
    qryTabela.SQL.Add('AND TABLE_NAME = :TABELA');
    qryTabela.SQL.Add('AND TABLE_SCHEMA = :SCHEMA');
    qryTabela.SQL.Add('AND CHARACTER_MAXIMUM_LENGTH IS NOT NULL');

    qryTabela.ParamByName('CAMPO').AsString := strCampo;
    qryTabela.ParamByName('TABELA').AsString := strTabela;
    qryTabela.ParamByName('SCHEMA').AsString := strSchema;

    qryTabela.Open;

    if qryTabela.IsEmpty then
      Exit;

    Result := qryTabela.FieldByName('TAMANHO').AsInteger;
  finally
    FreeAndNil(qryTabela);
  end;
end;

