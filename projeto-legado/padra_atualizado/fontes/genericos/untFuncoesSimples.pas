procedure pSalvarPDFNFeBD(AChaveAcesso, APDF: string);
const strCampoChave: string = 'NFE_ACESSO';
const strTabela: string = 'PDFNFE';
const strCampo: string = 'NFE_ARQPDF';

Var
  qryAux: TUniQuery;
begin

  qryAux := fCriaQuery;

  try
    If Not fTabelaExiste(strTabela, True) Then
      Exit;

    If (Not fCampoExiste(strTabela, strCampo, True)) Then
      Exit;

    If (Not fCampoExiste(strTabela, strCampoChave, True)) Then
      Exit;

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT COUNT(1) AS QTD FROM ' + strTabela );
    qryAux.SQL.Add('  WHERE ' + strCampoChave + ' = :CHAVE ');
    qryAux.ParamByName('CHAVE').AsString := AChaveAcesso;
    qryAux.Open();

    if qryAux.FieldByName('QTD').AsInteger = 0 then
    begin
      try

        APDF := fBase64Codifica(APDF);

        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add('INSERT INTO ' + strTabela );
        qryAux.SQL.Add(' SET ' + strCampo + ' = :PDF, ');
        qryAux.SQL.Add(strCampoChave + ' = :CHAVE ');
        qryAux.ParamByName('CHAVE').AsString := AChaveAcesso;
        qryAux.ParamByName('PDF').AsString := APDF;
        qryAux.ExecSQL;

      except
        on E: Exception do
        begin
          Exception.Create(E.Message + ' [untConexaoBD.pSalvarPDFNFeBD]');
        end;
      end;
    end;
  finally
    FreeAndNil(qryAux);
  end;
End;

