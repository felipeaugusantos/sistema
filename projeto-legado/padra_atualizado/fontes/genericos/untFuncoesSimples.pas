function fOSFinalizadaArmazenada(strNumDoc, strEspDoc, strCodEmp: String; var strNumOse: String; var strEquip: String): Boolean;
var
  strSQL: String;
  qryAux: TUniQuery;
begin
  Result := True;

  if not fCfgSis('FXFAAR', varBoolean) then
    Exit;

  qryAux   := fCriaQuery(Nil);

  try
    strEquip := '';

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '    EQU_STATUS, ';
    strSQL := strSQL + '    EQU_FLXSIT, ';
    strSQL := strSQL + '    CONCAT(EQUGER.EQU_NUMOSE,"-",EQUGER.EQU_CODEMP) AS NUMOSE, ';
    strSQL := strSQL + '    CONCAT(CADEQU.EQU_CODIGO,"-",CADEQU.EQU_DESCRI) AS EQUDES ';
    strSQL := strSQL + ' FROM EQUGER ';
    strSQL := strSQL + ' LEFT JOIN CADEQU ON EQUGER.EQU_CODEQU = CADEQU.EQU_CODIGO ';
    strSQL := strSQL + ' WHERE (EQU_NUMPED = :NUMPED  ';
    strSQL := strSQL + '     AND EQU_TIPPED = :ESPDOC  ';
    strSQL := strSQL + '     AND EQU_EMPPED = :CODEMP) ';
    strSQL := strSQL + ' UNION ';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '    EQU_STATUS, ';
    strSQL := strSQL + '    EQU_FLXSIT, ';
    strSQL := strSQL + '    CONCAT(EQUGER.EQU_NUMOSE,"-",EQUGER.EQU_CODEMP) AS NUMOSE, ';
    strSQL := strSQL + '    CONCAT(CADEQU.EQU_CODIGO,"-",CADEQU.EQU_DESCRI) AS EQUDES ';
    strSQL := strSQL + ' FROM EQUGER ';
    strSQL := strSQL + ' INNER JOIN EQUGOR ON EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU ';
    strSQL := strSQL + ' INNER JOIN FATGOR ON EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';
    strSQL := strSQL + ' LEFT JOIN CADEQU ON EQUGER.EQU_CODEQU = CADEQU.EQU_CODIGO ';
    strSQL := strSQL + ' WHERE (FGO_NUMDOC = :NUMPED  ';
    strSQL := strSQL + '    AND FGO_ESPDOC = :ESPDOC  ';
    strSQL := strSQL + '    AND FGO_CODEMP = :CODEMP) ';

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('NUMPED').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.Open;

    if not qryAux.IsEmpty then
    begin
      Result := ((qryAux.FieldByName('EQU_STATUS').AsString = 'R') and ((qryAux.FieldByName('EQU_FLXSIT').AsString = 'AR')
        or (qryAux.FieldByName('EQU_FLXSIT').AsString = 'AF'))) or (qryAux.FieldByName('EQU_FLXSIT').AsString = 'FA');

      if not Result then
      begin
        strNumOse := qryAux.FieldByName('NUMOSE').AsString;
        strEquip  := qryAux.FieldByName('EQUDES').AsString;
      end;
    end;
  finally
    FreeAndNil(qryAux);
  end;
end;

