      VS_ImpressoraSat := fArqIniLocal(0, 'SATCFE', 'IMPRESSORA', '', fCfgSis('PATSAT') + '\opcoes_sat.ini');
    End;

    LNomeBancoEmail := fCfgSis('EMABAS', varString);
    If LNomeBancoEmail.IsEmpty Then
      LNomeBancoEmail := 'AUTCOM';

    VS_PermitidoEnviarEmail := fArqIni(0, 'BANCO', 'NOMBAN', '').Equals(LNomeBancoEmail);
    If Not VS_PermitidoEnviarEmail Then
      VS_PermitidoEnviarEmail := fArqIni(0, 'GERAL', 'FORCAR_ENVIO_EMAIL', '').Equals('S');

    VS_PrefixoCliente := fCfgSis('CLIPFX', varString);
    VS_ChaveCliente   := fCfgSis('CLICHP', varString);
    VS_URLBucket      := fCfgSis('URLBKT', varString);

  Except
    On E: Exception Do
      pMensagensErro('Erro ao carregar variaveis globais!' + #13 + E.Message,'[ATUVARGLOBAISSIMPLES]');
