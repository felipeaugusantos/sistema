function fCSTJaCadastrada(cdsCST: TUniClientDataSet; strCodCST, strAutInc: String; dtaVigenc: TDateTime=0; strEnquadramentoIPI: string = ''): Boolean;
  Var
    cdsAux: TUniClientDataSet;
    strVig,
    strEnq,
    strTip: String;
begin
  cdsAux := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsAux, cdsCST);

    If cdsAux.FindField('APC_CSTSAI') <> NIL Then
      strTip:='SAI'
    Else
      strTip:='ENT';

    strVig :='';
    If cdsAux.FindField('APC_VIGENC') <> NIL Then
    Begin
      If dtaVigenc = 0 Then
        strVig := ' - (Sem Vigência)'
      Else
        strVig := ' - Vigência: ' + FormatDateTime('dd/mm/yyyy', dtaVigenc);
    End;

    cdsAux.Filter := 'AUTOINCREM <> '+QuotedStr(strAutInc);
    cdsAux.Filtered := True;

    strEnq := '';
    If cdsAux.FindField('APC_VIGENC') <> NIL Then
    begin
      if fEmptyStr(strEnquadramentoIPI) then
      begin
        Result := cdsAux.Locate('APC_CST'+strTip+';APC_VIGENC', VarArrayOf([strCodCST, dtaVigenc]), []);
      end
      else
      begin
        Result := cdsAux.Locate('APC_CST'+strTip+';APC_VIGENC;APC_ENQIPI', VarArrayOf([strCodCST, dtaVigenc, strEnquadramentoIPI]), []);
        strEnq := ' - com enquadramento de IPI = ' + strEnquadramentoIPI;
      end;
    end
    Else
    begin
      if fEmptyStr(strEnquadramentoIPI) then
      begin
        Result := cdsAux.Locate('APC_CST'+strTip, strCodCST, []);
      end
      else
      begin
        Result := cdsAux.Locate('APC_CST'+strTip+';APC_ENQIPI', VarArrayOf([strCodCST, strEnquadramentoIPI]), []);
        strEnq := ' - com enquadramento de IPI = ' + strEnquadramentoIPI;
      end;
    end;

    If Result Then
     fMensagem('Atenção', 'CST de'+IIF(strTip='SAI',' saída ',' entrada ') +strCodCST + strVig + strEnq +', já esta cadastrada!'+#10#13+
                          'Tecle "Enter" sobre a mesma, para editá-la.', ['&Ok']);

  Finally
    FreeAndNil(cdsAux);
  End;
End;

function fAbreviacaoCfopExiste(cdsGrid: TUniClientDataSet; strCfopAtual, strSufixo, strCst: string): boolean;
  var
    stlCfopsAdicionadas: TStringList;
    cdsAux: TUniClientDataSet;
    strCfopGravado: string;
    intContador: Integer;
begin
  Result := true;

  strCfopGravado := '';

  strCfopAtual := Trim(AnsiReplaceStr(AnsiReplaceStr(strCfopAtual, '-', ''), ' ', ''));

  stlCfopsAdicionadas := TStringList.Create;
  cdsAux := TUniClientDataSet.Create(nil);
  try
    while strCfopAtual <> '' do
    begin
      stlCfopsAdicionadas.Add(Copy(strCfopAtual, 1, 4));
      strCfopAtual := Copy(strCfopAtual, 5, length(strCfopAtual));
    end;

    pCloneDataSet(cdsAux, cdsGrid);

    cdsAux.Filter := 'APC_CST' + strSufixo + ' <> ' + QuotedStr(strCst);
    cdsAux.Filtered := True;

    cdsAux.First;
    while not cdsAux.Eof do
    begin
      strCfopGravado := strCfopGravado + Trim(cdsAux.FieldByName('APC_CFO' + strSufixo).AsString);
      cdsAux.Next;
    end;

    strCfopGravado := fTransform(Trim(AnsiReplaceStr(AnsiReplaceStr(strCfopGravado, '-', ''), ' ', '')), 4);

    for intContador := 0 to stlCfopsAdicionadas.Count - 1 do
    begin
      if Pos(stlCfopsAdicionadas[intContador], strCfopGravado) > 0 then
      begin
        fMensagem('Aviso', 'CFOP: ' + stlCfopsAdicionadas[intContador] + ' já cadastrada!', ['OK']);
        Result := false;
        break;
      end;
    end;
  finally
    stlCfopsAdicionadas.Free;
    cdsAux.Free;
  end;
end;

function fVerificarNovaFormulaMovimentada(const strSql: string; const arrParametros: array of Variant): Boolean;
const
  arrTabelas : array[0..4] of string = ('TINDET', 'TINDOR', 'MOVDET', 'FATDOR', 'NOTDET');
  arrPrefixos: array[0..4] of string = ('DET', 'FDO', 'DET', 'FDO', 'DET');
var
  intCont: Integer;
  intParametros: Integer;
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Try
    Result := False;
    Try
      qryGen := fCriaQuery();
      for intCont := 0 to Length(arrTabelas) - 1 do
      begin
        qryGen.Close;
        qryGen.SQL.Text := Format(strSql, [arrTabelas[intCont], arrPrefixos[intCont]]);
        for intParametros := 0 to Length(arrParametros) - 1 do
        begin
          qryGen.Params[intParametros].Value := arrParametros[intParametros];
        end;
        qryGen.Open;

        Result := qryGen.FieldByName('QTD').AsInteger > 0;
        if Result then
          Exit;
      end;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

procedure pIncluiCfgSisTCOARR;
