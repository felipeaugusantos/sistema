procedure pExcluiEtiquetaVolumeComposto(const strCodVol: String);
var
  qryExclui: TUniQuery;
begin
  qryExclui := fCriaQuery;
  try
    qryExclui.Close;
    qryExclui.SQL.Clear;
    qryExclui.SQL.Add('DELETE FROM ETIEVC WHERE EVC_CODIGO IN('+strCodVol+')');
    qryExclui.ExecSQL;

    qryExclui.Close;
    qryExclui.SQL.Clear;
    qryExclui.SQL.Add('DELETE FROM ETIVOL WHERE VOL_CODIGO IN('+strCodVol+')');
    qryExclui.ExecSQL;
  finally
    FreeAndNil(qryExclui);
  end;
end;

{*************************************************}
{* CONVERTE O CENTRO DE CUSTO DE 5 PARA 7         }
{* USADO PARA CONVERTER OS DADOS DOS AQUIVOS INI *}
{**********************************************LA*}
function fConverteCentroCusto(strCodCta: String): String;
Begin
  If Length(strCodCta) = 5 Then
  Begin
    strCodCta := '0' + strCodCta;
    Insert('0',strCodCta,3);
    Result := strCodCta;
  End Else
    Result := strCodCta;
End;

function fSqlTotalEmprestimosAberto(strCodCli: string = ''): String;
begin
  Result := '';
  Result := Result + ' SELECT SQL_NO_CACHE ';
  Result := Result + '   DET_CODCLI AS CODCLI, ';
  Result := Result + '   0 AS TOTVEN, ';
  Result := Result + '   0 AS TOTAVE, ';
  Result := Result + '   SUM((DET_QTDITE - IFNULL(DET_BAIEMP, 0)) * ((DET_TOTITE-IFNULL(DET_DESESP, 0)) / DET_QTDITE)) AS TOTAL   ';
  Result := Result + ' FROM ';
  Result := Result + '   MOVDET ';
  Result := Result + ' WHERE ';
  Result := Result + '   DET_JAFATU = 0       AND ';
  Result := Result + '   DET_ESPDOC = "EP"    AND ';
  Result := Result + '   DET_CLAFIS > 5000 ';

  If Not fEmptyStr(strCodCli) Then
    Result := Result + '   AND DET_CODCLI = ' + QuotedStr(strCodCli) + ' ';

  Result := Result + ' GROUP BY ';
  Result := Result + '   DET_CODCLI ';
end;

function fCadEmp(strNomCampo: String; qryGenEmp: TUniQuery): String;
  Var
    strSQL   : String;
    strCodEmp: String;
begin
  Try
    strCodEmp := VS_strCodEmp;

    strSQL := '';
    strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '   CADEMP.*, ';
    strSQL := strSQL + '   CID_NOMCID AS "EMP_NOMCID", ';
    strSQL := strSQL + '   CID_ESTADO AS "EMP_ESTADO", ';
    strSQL := strSQL + '   CONCAT(EMP_ENDERE, ", ", EMP_ENDNUM, ", ", EMP_BAIRRO, " - " , CID_NOMCID, "/", CID_ESTADO) AS EMP_ENDERECO ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   CADEMP ';
    strSQL := strSQL + '   JOIN CADCID ON EMP_CODCID = CID_CODCID ';
    strSQL := strSQL + ' WHERE EMP_CODEMP = :CODEMP ';

    With qryGenEmp Do
    Begin

      If (Not Active) Or IsEmpty Or (strCodEmp <> FieldByName('EMP_CODEMP').AsString) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;
      End;

      If FieldByName('EMP_' + strNomCampo).IsNull Then
      Begin
        Result := '';
      End
      Else
      Begin
        Result := FieldByName('EMP_' + strNomCampo).Value;
      End;

    End;

  Finally

  End;


end;

