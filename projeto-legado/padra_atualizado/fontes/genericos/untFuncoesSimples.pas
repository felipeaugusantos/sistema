function fGetBancoConfig(ReadWrite: Integer; Chave, CodCFG, Valor: String; strEmpresaCarteira: String = ''; ADuplicataBoleto: PTDuplicataCtr = Nil):String;
var
  strNomChave,
  strCodEmp,
  strCodBan,
  strNomBan,
  strCartei,
  strNumPos,
  //strArqOriginal,
  //strProxNumArq,
  strTipLay : String;
  CFGBanDao : TCFGBanDao;
  CFGBan    : TCfgBan;
begin
  strNomChave :=  Chave+'-' + IIF(fEmptyStr(strEmpresaCarteira),
                                   VS_strCodEmp,
                                   strEmpresaCarteira);

  strCodEmp  := '';
  strCodBan  := '';
  strCartei  := '';
  strNumPos  := '';

  Result := '';

  strNomChave := DeterminaBancoPosicoesLayout(strNomChave,
                                              strCodban,
                                              strNumPos,
                                              strTipLay);

  if Pos('-', strNomChave) > 0 then
  begin
    strCartei     := Copy(strNomChave, 1, 1);
    strNomChave   := StringReplace(strNomChave, strCartei, '', []);

    if strNomChave[1] = '-' then
       strNomChave := StringReplace(strNomChave, '-', '', []);

    strCodEmp := Copy(strNomChave, 1, 3);
  end
  else
    strCodEmp := Copy(strNomChave, 1, 3);

  If Not fEmptyStr(strCodBan) Then
  Begin
    If MatchStr(StrCartei,['0']) And (ReadWrite = 1) then
    begin
      raise Exception.Create(
        'Foi selecionada uma carteira inexistente.' + #13 +
        'Por favor, entre em contato imediatamente com a Citel.'
      );
    End;
  End;

  pVerificaImpCNFBCO(IIF(strNumPos = 'PEFIN', strCodBan+'PEFIN', strCodBan), strEmpresaCarteira);

  CFGBanDao := Nil;
  CFGBan := Nil;
  Try
    Case ReadWrite of
      0:
      begin
        CFGBanDao   := TCFGBanDao.Create(strCodEmp, strCodBan, StrCartei, strNumPos, strTipLay, ADuplicataBoleto);
        CFGBan      := CFGBanDao.fFindByCFG(CodCFG);

        if Assigned(CFGBan) then
          Result :=  Trim(CFGBan.ValCFG);
      end;
      1:
      begin
        CFGBanDao     := TCFGBanDao.Create(strCodEmp, strCodBan, StrCartei, strNumPos, strTipLay);
        CFGBan        := TCFGBan.Create;
        strNomBan     := fRetNomeBancoSelec(StrCodBan);

        if strNomBan = '' then
          raise Exception.Create(#13+'Banco não cadastrado ou não configurado.');

        CFGBan.CodEmp := strCodEmp;
        CFGBan.CodBan := StrCodBan;
        CFGBan.Descri := '';
        CFGBan.Banco_ := strNomBan;
        CFGBan.Cartei := strCartei;
        CFGBan.NumPos := strNumPos;
        CFGBan.UltAlt := fNow;
        CFGBan.CodOpe := strLoginUsuarioLogado;
        CFGBan.CodCFG := CodCFG;
        CFGBan.ValCFG := Valor;
        CFGBan.Chave_ := Chave+'-'+VS_strCodEmp;
        CFGBan.Tiplay := strTipLay;
        CFGBanDao.fInsert(CFGBan);
      end;
    End;
  Finally
    If Assigned(CFGBan) Then
      FreeAndNil(CFGBan);
    If Assigned(CFGBanDao) Then
      FreeAndNil(CFGBanDao);
  End;
end;

function DeterminaBancoPosicoesLayout(AChave: String; out ACodigoBanco, ANumeroPosicoes, ALayout: String): String;
  Var
    LAuxiliar: String;
Begin
  Result := AChave;
  ANumeroPosicoes := '';
  ALayout := '';

  if Pos('PEFIN', Result) > 0 then
  begin
    Result := StringReplace(Result, 'PEFIN', 'CONFIG001D7', []);
    ANumeroPosicoes := 'PEFIN';
  end;

  Result := StringReplace(Result, '[', '', []);
  Result := StringReplace(Result, ']', '', []);
  if Pos('_240p', Result) > 0 then
  begin
    ANumeroPosicoes := '240p';
    Result := StringReplace(Result, '_240p', '', []);
  end;

  if Pos('_400p', Result) > 0 then
  begin
    ANumeroPosicoes := '400p';
    Result := StringReplace(Result, '_400p', '', []);
  end;

  if Pos('CONFIGCTAAPI', Result) > 0 then
  begin
    Result := StringReplace(Result, 'CONFIGCTAAPI', '', []);
    ALayout := 'P';
    ANumeroPosicoes := 'API';
  end;

  if Pos('CONFIGCTA', Result) > 0 then
  begin
    Result := StringReplace(Result, 'CONFIGCTA', '', []);
    ALayout  := 'P';
  end;

  if Pos('CONFIGPGG', Result) > 0 then
  begin
    Result := StringReplace(Result, 'CONFIGPGG', '', []);
    ALayout := 'P';
    ANumeroPosicoes := 'PGG';
  end;

  if Pos('CONFIGDDA', Result) > 0 then
  begin
    Result := StringReplace(Result, 'CONFIGDDA', '', []);
    ALayout := 'P';
    ANumeroPosicoes := 'DDA';
  end;

  if Pos('CONFIG', Result) > 0 then
  begin
    Result := StringReplace(Result, 'CONFIG', '', []);
    ALayout := 'R';
  end;

  ACodigoBanco := Copy(Result, 1, Pos('-', Result)-1);
  Result := StringReplace(Result, ACodigoBanco, '', []);

  if Length(ACodigoBanco) > 3 then
  begin
    LAuxiliar := ACodigoBanco;
    ACodigoBanco := Copy(LAuxiliar, 1, 3);
    LAuxiliar := StringReplace(LAuxiliar, ACodigoBanco, '', []);
    if ANumeroPosicoes <> 'PEFIN' then
    begin
      ANumeroPosicoes := LAuxiliar;

      if ANumeroPosicoes = 'D7' then
        ANumeroPosicoes := '400_D7';
    end;
  end;

  If Length(Result) > 0 Then
  Begin
    if Result[1] = '-' then
      Result := StringReplace(Result, '-', '', []);
  End;
End;

function fGeraNumeroSessao: Integer;
  Var
    strUltimaSessao: String;
    intRandom: Integer;
    strSessao: String;
begin
  intRandom := RandomRange(0, 999);

  strUltimaSessao := fArqIniLocal(0, 'SATCFE', 'ULTIMA_SESSAO', '', fCfgSis('PATSAT') + '\opcoes_sat.ini');
  strSessao := fStrZero(fArqIniLocal(0, 'SATCFE', 'PDV', '', fCfgSis('PATSAT') + '\opcoes_sat.ini'), 2) +
              fStrZero(IntToStr(intRandom), 3);

  If strSessao = strUltimaSessao Then
  Begin
    strSessao := fStrZero(fArqIniLocal(0, 'SATCFE', 'PDV', '', fCfgSis('PATSAT') + '\opcoes_sat.ini'), 2) +
                 fStrZero(IntToStr(intRandom+1), 3);
  End;

  fArqIniLocal(1, 'SATCFE', 'ULTIMA_SESSAO', strSessao, fCfgSis('PATSAT') + '\opcoes_sat.ini');
  Result := StrToInt(strSessao);
end;

function fDocumentoInutilizado(strNumDoc, strEspDoc, strCodEmp, strCodCli, strSerie_: String): Boolean;
  Var
    qryAux : TUniQuery;
begin
