        intCapcar := qryTemp.FieldByName('VEI_CAPCAR').AsInteger;
      End;
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

function fRetClienteVeiculo(strPlaVei, strCliPos: String): String;
  Var
    arrClientes: Array of String;
    stlClientes: TStringList;
    intClientes: Integer;
    intClienPos: Integer;
begin
  Result := fCampoTabela('GROUP_CONCAT(DISTINCT CLI_CODCLI)',
                         'CLIVEI',
                        ['CLI_PLAVEI'],
                        [strPlaVei]);

  {*********************************}
  {* CASO TENHA MAIS DE UM CLIENTE *}
  {*****************************JC**}
  If Length(Result) > 8 Then
  Begin
    stlClientes := TStringList.Create;
    stlClientes.CommaText := Result;
    stlClientes.Sort;

    SetLength(arrClientes, stlClientes.Count);

    intClienPos := 0;
    For intClientes := 0 To stlClientes.Count -1 Do
    Begin
      arrClientes[intClientes] := stlClientes[intClientes] + '-' + fRetNomCliente(stlClientes[intClientes]);

