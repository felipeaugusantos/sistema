function fVerificaDocumentoComErroNoPainelNFE: String;
Var
  qryDocumentosPainel: TUniQuery;
  strSQL: String;
begin
  strSQL := '';
  strSQL := strSQL + '  SET group_concat_max_len := 65535; ';
  strSQL := strSQL + '	SELECT                                                                                                                                   ';
  strSQL := strSQL + '		CONCAT(MENSAG,"\n\n",DOCNFE) AS DOCUMENTOS                                                                                             ';
  strSQL := strSQL + '	FROM	                                                                                                                                   ';
  strSQL := strSQL + '		(                                                                                                                                      ';
  strSQL := strSQL + '		SELECT                                                                                                                                 ';
  strSQL := strSQL + '			CONVERT("EXISTEM DOCUMENTOS EM ABERTO NO PAINEL NFE.\nREGULARIZE A SITUAÇÃO PARA EMISSÃO DO RELATÓRIO. " USING UTF8) AS MENSAG,      ';
  strSQL := strSQL + '			GROUP_CONCAT(DISTINCT(CONCAT("DOCUMENTO: ",LPAD(NFE_NUMDOC,12," "), " | ESP: ", NFE_ESPDOC," | EMP: ", NFE_CODEMP," | MOTIVO: ",SUBSTRING(REPLACE(REPLACE(REPLACE(NFE_OBSERV,"\n"," "),"\r"," "),"\t",""),1,960),"\n"))	SEPARATOR "") AS DOCNFE ';
  strSQL := strSQL + '		FROM LOGNFE                                                                                                                            ';

  If fCfgSis('TRANFE',varBoolean) Then
    strSQL := strSQL + '		WHERE TRUE  '
  else
    strSQL := strSQL + '		WHERE FALSE                                                                                                                          ';

  strSQL := strSQL + '			AND NFE_STATUS NOT IN ("AT","CN","DN")                                                                                               ';
  strSQL := strSQL + '			AND NFE_HORINI <= DATE_SUB(fRetDataAtual(), INTERVAL 1 DAY)                                                                          ';
  strSQL := strSQL + '		) AS TAB                                                                                                                               ';

  qryDocumentosPainel := fCriaQuery;
  qryDocumentosPainel.SQL.Clear;
  qryDocumentosPainel.Close;
  qryDocumentosPainel.SQL.Add(strSQL);

  qryDocumentosPainel.Open;

  Result  :=  qryDocumentosPainel.FieldByName('DOCUMENTOS').AsString;

  fExecutaSQL('SET SESSION group_concat_max_len = 3072');
end;

