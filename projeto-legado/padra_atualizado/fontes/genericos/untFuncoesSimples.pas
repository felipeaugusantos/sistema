function fVerificaAcessoAutTin(strHint: String; strName: String): Boolean;
Var
  strHintAux,
  strSQL: String;
  qryGen: TUniQuery;

  function fNormaliza(const strTexto: string): string;
  begin
    Result := AnsiUpperCase(fRemoveAcento(strTexto));
  end;

  function fExisteDirAce: Boolean;
  begin
    Result := dicDirAceAutTin.ContainsKey(fNormaliza(Concat('DIRTIN', strHintAux)));
    If Not Result Then
      Result := dicDirAceAutTin.ContainsKey(fNormaliza(Concat('DIRGPT', strHintAux)));

    If Not Result Then
    Begin
      If (Not StartsText('mnu', strHintAux)) And (Not StartsText('frm', strHintAux)) Then
      Begin
        strHintAux := 'mnu'+strHintAux;

        Result := dicDirAceAutTin.ContainsKey(fNormaliza(Concat('DIRTIN', strHintAux)));
        If Not Result Then
          Result := dicDirAceAutTin.ContainsKey(fNormaliza(Concat('DIRGPT', strHintAux)));
      End;
    End;
  end;

Begin
  If VS_strUsaTmq = 'N' Then
    Exit(False);

  If fEhAdministrador(strLoginUsuarioLogado) Then
    Exit(True);

  strHintAux := strHint;

  If (Assigned(dicDirAceAutTin)) Then
  Begin
    Result := fExisteDirAce;
  End
  Else
  Begin
    dicDirAceAutTin := TDictionary<string, Boolean>.Create;

  qryGen := fCriaQuery(Nil);
    Try
  strSQL := '';
      strSQL := strSQL + ' SELECT "DIRTIN"     AS TIP_ACESSO, ';
      strSQL := strSQL + '        TIN_NOMFRM   AS DIR_NOMFRM  ';
      strSQL := strSQL + '   FROM DIRTIN ';
      strSQL := strSQL + '  WHERE TIN_CODOPE = :CODOPE        ';

      strSQL := strSQL + ' UNION ALL ';

      strSQL := strSQL + ' SELECT "DIRGPT"     AS TIP_ACESSO, ';
      strSQL := strSQL + '        D.DIR_NOMFRM AS DIR_NOMFRM  ';
      strSQL := strSQL + '   FROM DIRGPT D ';
      strSQL := strSQL + '        JOIN CADGPO G ON G.GPO_CODGPO = D.GPT_CODGPO ';
      strSQL := strSQL + '        JOIN OPEGPO O ON O.GPO_CODGPO = G.GPO_CODGPO ';
      strSQL := strSQL + ' WHERE O.OPE_CODOPE = :CODOPE; ';

  With qryGen Do
  Begin
        qryGen.Close;
        qryGen.SQL.Text := strSQL;
        qryGen.ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
        qryGen.Open;

        If Not qryGen.IsEmpty Then
    Begin
          qryGen.First;
          While Not qryGen.Eof Do
          Begin
            dicDirAceAutTin.AddOrSetValue(fNormaliza(Concat(qryGen.FieldByName('TIP_ACESSO').AsString,
                                                            qryGen.FieldByName('DIR_NOMFRM').AsString)), True);

            qryGen.Next;
          End;
          qryGen.Close;

          dicDirAceAutTin.TrimExcess;
    End;
  End;
    Finally
      FreeAndNil(qryGen);
    End;

    Result := fExisteDirAce;
  End;
End;

