        Result := strForm + '>' + Result;
    End;
  End;
end;

{***************************************************************}
{* Req. 456948 - arma o cache do @VS_ID_TRANSACAO para a        *}
{* conexao informada. Le o ID uma unica vez e guarda junto com  *}
{* a instancia da conexao.                                      *}
{*                                                              *}
{* Chamado so pela gravacao do Balanco de Estoque, logo apos o  *}
{* fStartTransaction. Enquanto ninguem arma, VS_objConexaoIDTran*}
{* fica Nil e fGetIDTransacao segue o caminho de sempre.        *}
{*                                                              *}
{* Engole excecao de proposito: cache e otimizacao e nao pode   *}
{* derrubar a transacao. Se falhar, fica desarmado.             *}
{***************************************************************}
procedure pLigaCacheIDTransacao(objConnection: TUniConnection);
  Var
    qryIDTrans : TUniQuery;
begin
  VS_objConexaoIDTran    := Nil;
  VS_intIDTransacaoCache := 0;

  Try
    If Not Assigned(objConnection) Then
      Exit;

    If Not objConnection.InTransaction Then
      Exit;

    qryIDTrans := fCriaQuery(Nil, objConnection);
    Try
      qryIDTrans.SQL.Clear;
      qryIDTrans.SQL.Add('SELECT @VS_ID_TRANSACAO;');
      qryIDTrans.Open;

      If qryIDTrans.IsEmpty Then
        Exit;

      If qryIDTrans.Fields[0].IsNull Then
        Exit;

      VS_intIDTransacaoCache := qryIDTrans.Fields[0].AsLargeInt;

      If VS_intIDTransacaoCache > 0 Then
        VS_objConexaoIDTran := objConnection;
    Finally
      FreeAndNil(qryIDTrans);
    End;
  Except
    VS_objConexaoIDTran    := Nil;
    VS_intIDTransacaoCache := 0;
  End;
end;

{***************************************************************}
{* Req. 456948 - descarrega o batch de saldos AGORA, ainda      *}
{* dentro da transacao.                                         *}
{*                                                              *}
{* Existe porque o balanco precisa que os saldos estejam no     *}
{* banco ANTES da auditoria de saldo, e o flush normal so       *}
{* acontece dentro do fCommit - depois dela.                    *}
{*                                                              *}
{* Execute remove a entrada do dicionario, entao a chamada      *}
{* posterior dentro do fCommit vira no-op.                      *}
{***************************************************************}
{***************************************************************}
{* Req. 456948 - M1b. Arma o lote de saldos. A partir daqui os  *}
{* UPDATE de ITEGER e CADLOT feitos por fAtualizaEstoqueCadIte  *}
{* e fAtualizaEstoqueLote sao acumulados em vez de executados.  *}
{*                                                              *}
{* 500 por ExecSQL, mesmo tamanho que pInsertLoteLGCEST usa em  *}
{* producao.                                                    *}
{***************************************************************}
procedure pLigaBatchSaldosBalanco;
begin
  If Assigned(VS_objBatchSaldosBalanco) Then
    FreeAndNil(VS_objBatchSaldosBalanco);

  VS_objBatchSaldosBalanco := TBatchSQL.Create(nil);
  VS_objBatchSaldosBalanco.Query     := fCriaQuery(nil);
  {O query acima nao tem outra referencia guardada - sem isto vazava um
   TUniQuery por rodada.}
  VS_objBatchSaldosBalanco.OwnsQuery := True;
  VS_objBatchSaldosBalanco.BatchSize := 500;
end;

{***************************************************************}
{* Req. 456948 - M1b. Manda o lote ao banco e desarma. Tem que  *}
{* ser chamado antes de qualquer leitura de saldo - a auditoria *}
{* e a notificacao de estoque minimo leem - e em TODAS as       *}
{* saidas da rotina que armou, inclusive no Except.             *}
{***************************************************************}
{***************************************************************}
{* Req. 456948 - M1b. Descarta o lote SEM executar. E o caminho *}
{* de erro: a gravacao vai ser desfeita, entao os comandos nao  *}
{* podem ir ao banco, mas o objeto precisa ser liberado.        *}
{***************************************************************}
procedure pDesligaBatchSaldosBalanco;
begin
  If Assigned(VS_objBatchSaldosBalanco) Then
  Begin
    VS_objBatchSaldosBalanco.Clear;
    FreeAndNil(VS_objBatchSaldosBalanco);
  End;
end;

procedure pDescarregaEDesligaBatchSaldosBalanco;
begin
  If Not Assigned(VS_objBatchSaldosBalanco) Then
    Exit;

  Try
    If VS_objBatchSaldosBalanco.CommandCount > 0 Then
      VS_objBatchSaldosBalanco.Execute;
  Finally
    FreeAndNil(VS_objBatchSaldosBalanco);
  End;
end;

{***************************************************************}
{* Req. 456948 - M1b. Devolve True quando o SQL foi acumulado.  *}
{* Existe para que untCadIte e untCadLote nao precisem conhecer *}
{* o tipo TBatchSQL nem mudar de assinatura.                    *}
{*                                                              *}
{* O ponto-e-virgula final sai: o TBatchSQL junta os comandos   *}
{* com '; ' e dois seguidos sao erro de sintaxe.                *}
{***************************************************************}
function fUsouBatchSaldosBalancoSQL(const AstrSQL: String): Boolean;
  Var
    strSQL: String;
begin
  Result := Assigned(VS_objBatchSaldosBalanco) And (Trim(AstrSQL) <> '');

  If Not Result Then
    Exit;

  strSQL := Trim(AstrSQL);
  While (strSQL <> '') And (strSQL[Length(strSQL)] = ';') Do
    strSQL := Trim(Copy(strSQL, 1, Length(strSQL) - 1));

  VS_objBatchSaldosBalanco.BeginCommand(strSQL).EndCommand;
end;


{***************************************************************}
{* Req. 456948 - desarma o cache. Tem que ser chamado em TODAS  *}
{* as saidas da rotina que armou, inclusive no Except.          *}
{***************************************************************}
procedure pDesligaCacheIDTransacao;
begin
  VS_objConexaoIDTran    := Nil;
  VS_intIDTransacaoCache := 0;
end;

function fGetIDTransacao(objConnection: TUniConnection) : UInt64;
  Var
    qryIDTrans : TUniQuery;
begin
  {Req. 456948 - atalho do cache. So vale com as tres condicoes juntas:
   alguem armou, e a MESMA instancia de conexao, e ha transacao aberta.
   A ultima e o que protege contra endereco de conexao reaproveitado -
   fInTransaction so le a propriedade, nao dispara SQL. Fora disso, cai
   no codigo de sempre, logo abaixo.}
  If Assigned(VS_objConexaoIDTran)        And
     (objConnection = VS_objConexaoIDTran) And
     (VS_intIDTransacaoCache > 0)          And
     fInTransaction(objConnection)         Then
  Begin
    Result := VS_intIDTransacaoCache;
    Exit;
  End;

  Try
    qryIDTrans := fCriaQuery(Nil, objConnection);
    Try
      Result := 0;

      qryIDTrans.SQL.Clear;
      qryIDTrans.SQL.Add('SELECT @VS_ID_TRANSACAO;');
      qryIDTrans.Open;

      If qryIDTrans.IsEmpty Then
        Exit;

      If qryIDTrans.Fields[0].IsNull Then
        Exit;

      Result := qryIDTrans.Fields[0].AsLargeInt;
    Finally
      FreeAndNil(qryIDTrans);
    End;
  Except
    Result := 0;
  End;
end;

procedure pSetarVariaveisDeAmbienteTransacao(objConnection: TUniConnection);
  Var
    qryVariaveis : TUniQuery;
begin
  If VS_strCodEmp.IsEmpty Then
    Exit;

  If strLoginUsuarioLogado.IsEmpty Then
    Exit;

  qryVariaveis := fCriaQuery(Nil, objConnection);
  Try
    Try
      qryVariaveis.SQL.Clear;
      qryVariaveis.SQL.Add('SET @VS_USUARIOLOGADO = :USUARIOLOGADO;');
      qryVariaveis.SQL.Add('SET @VS_EMPRESALOGADA = :EMPRESALOGADA;');
      qryVariaveis.SQL.Add('SET @VS_MENUATIVO = :MENUATIVO;');
      qryVariaveis.SQL.Add('SET @VS_CAPTIONATIVO = :CAPTIONATIVO;');
      qryVariaveis.SQL.Add('SET @VS_ID_TRANSACAO = UUID_SHORT() & :MAXINT64;');
      qryVariaveis.ParamByName('USUARIOLOGADO').AsString := strLoginUsuarioLogado;
      qryVariaveis.ParamByName('EMPRESALOGADA').AsString := VS_strCodEmp;
      qryVariaveis.ParamByName('MENUATIVO').AsString := VS_strLastMenuName;
      qryVariaveis.ParamByName('CAPTIONATIVO').AsString := VS_strLastMenuCaption;
      qryVariaveis.ParamByName('MAXINT64').AsLargeInt := High(Int64);
      qryVariaveis.ExecSQL;
    Except
    End;
  Finally
    FreeAndNil(qryVariaveis);
  End;
end;

procedure pLimparVariaveisDeAmbienteTransacao(objConnection: TUniConnection);
  Var
    qryVariaveis : TUniQuery;
begin
  Try
    qryVariaveis := fCriaQuery(Nil, objConnection);
    Try
      qryVariaveis.SQL.Clear;
      qryVariaveis.SQL.Add('SET @VS_ID_TRANSACAO = :IDTRA;');
      qryVariaveis.ParamByName('IDTRA').AsLargeInt := 0;
      qryVariaveis.ExecSQL;
    Finally
      FreeAndNil(qryVariaveis);
    End;
  Except
  End;
end;

procedure pAfterStartTransaction(objConnection: TUniConnection);
begin
  pSetarVariaveisDeAmbienteTransacao(objConnection);
end;

{*******************************}
{* Inicia a Transação no Banco *}
{****************************MV*}
function fStartTransaction(objConexao: TUniConnection = Nil):Boolean;
begin
  Result := fStartTransaction(objConexao, NO_SAFE_COMMIT_ID);
end;

function fStartTransaction(objConexao: TUniConnection; const ASafeCommitID: Integer): Boolean; overload;
begin
  Try
    If Assigned(objConexao) Then
    Begin
      If (Not objConexao.InTransaction) Then
      Begin
        blnErroLogRep := False;
        strErroLogRep := '';

        objConexao.StartTransaction;

        If ASafeCommitID <> NO_SAFE_COMMIT_ID Then
          TSafeCommit.Add(objConexao, ASafeCommitID);

        pAfterStartTransaction(objConexao);

        TTransactionLog.Instance.LogStart(TUnidacConnection.Create(objConexao));

        Result := True;
      End
      Else
      Begin
        Result := True;
      End;

    End
    Else
    Begin
      If (Not frmModulo.GetCurrentConnection.InTransaction) Then
      Begin
        blnErroLogRep := False;
        strErroLogRep := '';

        frmModulo.GetCurrentConnection.StartTransaction;

        If ASafeCommitID <> NO_SAFE_COMMIT_ID Then
          TSafeCommit.Add(frmModulo.GetCurrentConnection, ASafeCommitID);

        pAfterStartTransaction(frmModulo.GetCurrentConnection);

        TTransactionLog.Instance.LogStart(TUnidacConnection.Create(frmModulo.GetCurrentConnection));

        Result := True;
      End
      Else
      Begin
        Result := True;
      End;

    End;

  Finally
    //
  End;
end;

{***************************}
{* RollBack para Transação *}
{************************MV*}
function fRollBack(objConexao: TUniConnection = Nil):Boolean;
begin
  Try
    Result        := True;
    blnErroLogRep := False;
    strErroLogRep := '';

    Try
      VS_strNomeFormularioFormReplicacao := EmptyStr;

      If Assigned(objConexao) Then
      Begin
        If (objConexao.InTransaction) Then
        Begin
          objConexao.Rollback;
        End;
        TSafeCommit.Remove(objConexao);

        If Assigned(objBatchReprocessarSaldo) Then
          objBatchReprocessarSaldo.Clear(fGetIDTransacao(objConexao));

        pLimparVariaveisDeAmbienteTransacao(objConexao);
      End
      Else
      Begin
        If (frmModulo.GetCurrentConnection.InTransaction) Then
        Begin
          frmModulo.GetCurrentConnection.Rollback;
        End;
        TSafeCommit.Remove(frmModulo.GetCurrentConnection);

        If Assigned(objBatchReprocessarSaldo) Then
          objBatchReprocessarSaldo.Clear(fGetIDTransacao(frmModulo.GetCurrentConnection));

        pLimparVariaveisDeAmbienteTransacao(frmModulo.GetCurrentConnection);
      End;

    Except
      On E : Exception do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fRollBack]');
      End;
    End;

    TTransactionLog.Instance.LogRollback(TUnidacConnection.Create(objConexao));
  Finally

  End;
end;

{***********************}
{* Commita a Transação *}
{********************MV*}
function fCommit(objConexao: TUniConnection = Nil; ASafeCommitID: Integer = NO_SAFE_COMMIT_ID): Boolean;
begin
  If blnErroLogRep Then
    Raise Exception.Create(strErroLogRep);

  Result := True;
  Try
    VS_strNomeFormularioFormReplicacao := EmptyStr;

    If Assigned(objConexao) Then
    Begin
      If Assigned(objBatchReprocessarSaldo) Then
        objBatchReprocessarSaldo.Execute(fGetIDTransacao(objConexao), objConexao);

      TSafeCommit.CheckCommitPermission(objConexao, ASafeCommitID);
      If (objConexao.InTransaction = True) Then
      Begin
        objConexao.Commit;
      End;
      TSafeCommit.Remove(objConexao);
      pLimparVariaveisDeAmbienteTransacao(objConexao);
    End
    Else
    Begin
      If Assigned(objBatchReprocessarSaldo) Then
        objBatchReprocessarSaldo.Execute(fGetIDTransacao(frmModulo.GetCurrentConnection), frmModulo.GetCurrentConnection);

      TSafeCommit.CheckCommitPermission(frmModulo.GetCurrentConnection, ASafeCommitID);
      If (frmModulo.GetCurrentConnection.InTransaction = True) Then
      Begin
        frmModulo.GetCurrentConnection.Commit;
      End;
      TSafeCommit.Remove(frmModulo.GetCurrentConnection);
      pLimparVariaveisDeAmbienteTransacao(frmModulo.GetCurrentConnection);
    End;

  Except
    On E: ESafeCommitException Do
      Raise;

    On E: Exception do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fCommit]');
    End;
  End;

  TTransactionLog.Instance.LogCommit(TUnidacConnection.Create(objConexao));
end;

