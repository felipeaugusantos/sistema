Function fEhPedOrcMultiloja(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryFatDor: TUniQuery;
Begin
  If Not fCfgSis('EMPFAT', varBoolean) Then
  Begin
    Result := False;
    Exit;
  End;

  qryFatDor := fCriaQuery;

  With qryFatDor, SQL Do
  Begin
    Clear;
    Add('SELECT COUNT(*) AS QTD');
    Add('FROM FATDOR ');
    Add('  INNER JOIN FATGOR ON FDO_SEQGER = FATGOR.AUTOINCREM');
    Add('WHERE');
    Add('  FGO_ENT_CD = "N"     AND');
    Add('  FDO_NUMDOC = :NUMDOC AND');
    Add('  FDO_ESPDOC = :ESPDOC AND');
    Add('  FDO_CODEMP = :CODEMP AND');
    Add('  IFNULL(FDO_EMPITE, FDO_CODEMP) <> FDO_CODEMP');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;

    Open;

    Result := FieldByName('QTD').AsInteger > 0;

    Close;
  End;

  FreeAndNil(qryFatDor);
End;

Function fTemEmpresaTefDesligadoMultiLoja(const AstrNumDoc, AstrEspDoc, AstrCodEmp: String): Boolean;
Var
  LqryFatDor: TUniQuery;
  LblnTefLigadoOutraEmpresa: Boolean ;
Begin
  Result := False;
  If Not fCfgSis('EMPFAT', varBoolean) Then
    Exit;

  LqryFatDor := fCriaQuery;
  try
    LqryFatDor.SQL.Clear;
    LqryFatDor.SQL.Add('SELECT DISTINCT FDO_EMPITE ');
    LqryFatDor.SQL.Add('FROM FATDOR ');
    LqryFatDor.SQL.Add('  INNER JOIN FATGOR ON FDO_SEQGER = FATGOR.AUTOINCREM');
    LqryFatDor.SQL.Add('WHERE');
    LqryFatDor.SQL.Add('  FDO_NUMDOC = :NUMDOC AND');
    LqryFatDor.SQL.Add('  FDO_ESPDOC = :ESPDOC AND');
    LqryFatDor.SQL.Add('  FDO_CODEMP = :CODEMP AND');
    LqryFatDor.SQL.Add('  IFNULL(FDO_EMPITE, FDO_CODEMP) <> FDO_CODEMP');

    LqryFatDor.ParamByName('NUMDOC').AsString := AstrNumDoc;
    LqryFatDor.ParamByName('ESPDOC').AsString := AstrEspDoc;
    LqryFatDor.ParamByName('CODEMP').AsString := AstrCodEmp;

    LqryFatDor.Open;
    LqryFatDor.First ;
    while not LqryFatDor.Eof do
    begin
      LblnTefLigadoOutraEmpresa := MatchStr(fCfgSis('TEFCIT', varString, LqryFatDor.FieldByName('FDO_EMPITE').AsString), [OPCAO_CLISITEF, OPCAO_NCR]) ;
      if not LblnTefLigadoOutraEmpresa then
        Exit(True) ;

      LqryFatDor.Next ;
    end ;
  finally
    FreeAndNil(LqryFatDor);
  end ;
end ;

Function fEhPedAdiantamentoContratoLocacao(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryFgo: TUniQuery;
Begin

  qryFgo := fCriaQuery;
  Try
    qryFgo.SQL.Clear;
    qryFgo.SQL.Add('SELECT COUNT(*) AS QTD');
    qryFgo.SQL.Add('FROM FATGOR ');
    qryFgo.SQL.Add('  INNER JOIN EXTGOR ON (EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM)');
    qryFgo.SQL.Add('WHERE');
    qryFgo.SQL.Add('  FATGOR.FGO_NUMDOC = :NUMDOC AND');
    qryFgo.SQL.Add('  FATGOR.FGO_ESPDOC = :ESPDOC AND');
    qryFgo.SQL.Add('  FATGOR.FGO_CODEMP = :CODEMP AND');
    qryFgo.SQL.Add('  EXTGOR.FGO_LOC_PD = "S"');
    qryFgo.ParamByName('NUMDOC').AsString := strNumDoc;
    qryFgo.ParamByName('ESPDOC').AsString := strEspDoc;
    qryFgo.ParamByName('CODEMP').AsString := strCodEmp;

    qryFgo.Open;

    Result := qryFgo.FieldByName('QTD').AsInteger > 0;
  Finally
    qryFgo.Close;
    FreeAndNil(qryFgo);
  End;
End;

Function fEmpresaDoPedidoUtiNps(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryFatDor: TUniQuery;
Begin
  Result := False;

  If Not fCfgSis('EMPFAT', varBoolean) Then
    Exit;

  qryFatDor := fCriaQuery;

  With qryFatDor, SQL Do
  Begin
    Clear;
    Add('SELECT DISTINCT FDO_EMPITE AS EMPITE ');
    Add('  FROM FATDOR ');
    Add(' INNER JOIN FATGOR ON FDO_SEQGER = FATGOR.AUTOINCREM');
    Add(' WHERE FDO_NUMDOC = :NUMDOC ');
    Add('   AND FDO_ESPDOC = :ESPDOC ');
    Add('   AND FDO_CODEMP = :CODEMP ');
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;

    First;
    While Not Eof Do
    Begin
      If fCfgSis('UTINPS', varBoolean, FieldByName('EMPITE').AsString) Then
      Begin
        Result := True;
        Break;
      End;
      Next;
    End;

    Close;
  End;

  FreeAndNil(qryFatDor);
End;

