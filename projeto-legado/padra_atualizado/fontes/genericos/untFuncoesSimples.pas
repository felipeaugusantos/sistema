{*****************************************}
{* VALIDA CONDIÇÃO DE PAGAMENTO          *}
{**************************************MV*}
function fValidaCndPag(strCndPag: String; blnPerRep: Boolean = False): Boolean;
  Var
    strCndTmp: String;
    strPraAnt: String;
    strPraAtu: String;
    intQtdPar: Integer;
    intParcel: Integer;
begin
  Result := True;

  strCndTmp := Trim(fTiraCaracEspeciais(strCndPag));

  If Pos(' ', strCndTmp) > 0 Then
  Begin
    Result := False;
  End
  Else
  Begin

    intQtdPar := 0;
    If Not fEmptyStr(Trim(LeftStr(strCndTmp, 2))) Then
      intQtdPar := StrToIntDef(Trim(LeftStr(strCndTmp, 2)), 0);

    If intQtdPar = 0 Then
      Result := False

    Else If (intQtdPar * 3) <> Length(Copy(strCndTmp, 3, Length(strCndTmp) - 2)) Then
      Result := False;

    If Result Then
    Begin
      For intParcel := 0 To intQtdPar -1 Do
      Begin
        strPraAtu := Copy(strCndTmp, 3 * (1 + intParcel), 3);

        If Not fEmptyStr(strPraAnt) Then
        Begin
          {**************************************************}
          {* VERIFICA SE PERMITE REPETIR O MESMO VENCIMENTO *}
          {***********************************************PZ*}
          If (blnPerRep) Then
            Result := StrToIntDef(strPraAtu, 0) >= StrToIntDef(strPraAnt, 0)
          Else
            Result := StrToIntDef(strPraAtu, 0) > StrToIntDef(strPraAnt, 0);
        End;

        If Not Result Then
          Break;

        strPraAnt := strPraAtu;
      End;
    End;

  End;

end;

function fValidaCndPag(strCndPag: String; Var strCndRet: String;
  dtaDtaBas: TDateTime; blnPerRep: Boolean = False; strCodCli: String = ''): Boolean;
begin

  strCndRet := strCndPag;
  If (Length(Trim(fTiraCaracEspeciais(strCndRet))) = 2) And (Trim(fTiraCaracEspeciais(strCndRet)) <> '00') Then
  Begin

    If Not fDigCndPagamento(strCndRet, dtaDtaBas, strCodCli) Then
    Begin
      strCndRet := '';
      Result    := True;
      Exit;
    End;

  End;

  Result := fValidaCndPag(strCndRet, blnPerRep);

end;

function fRetornaCndPag(arrDatas: TDateArray; dtaDtaBas: TDateTime): String;
  Var
    intContador: Integer;
    fltQtdDias: Double;
    dtaDtaAtu: TDateTime;
begin

  Result := fStrZero(IntToStr(Length(arrDatas)), 2);

  For intContador := 0 To Length(arrDatas)-1 Do
  Begin

    dtaDtaAtu  := arrDatas[intContador];
    fltQtdDias := dtaDtaAtu - dtaDtaBas;
    Result     := Result + fStrZero(IntToStr(fFloatToInt(fltQtdDias)), 3);

  End;

end;

function fRetornaCndPag(const arrDuplicata: TarrDuplicata; dtaDtaBas: TDateTime): String;
  Var
    intContador: Integer;
    arrDatas: TDateArray;
begin

  SetLength(arrDatas, 0);
  intContador := 0;
  While (arrDuplicata[intContador].dtaDtaVen <> '') And
        (intContador < 24)                          Do
  Begin
    SetLength(arrDatas, intContador+1);
    arrDatas[intContador] := StrToDate(arrDuplicata[intContador].dtaDtaVen);
    Inc(intContador);
  End;

  Result := fRetornaCndPag(arrDatas, dtaDtaBas);
end;

{*********************************************}
{* RETORNA A CONDIÇÃO DE PAGAMENTO DE ACORDO *}
{******************************************MV*}
function fRetornaCndPagPeriod(const intQtdPar, intPeriod, intExcDia: Integer; const intPriVenc: Integer = -1): String;
  Var
    intContador: Integer;
    intPeriodTmp: Integer;
begin

  Result := fStrZero(IntToStr(intQtdPar), 2);
  if intPriVenc = -1 then
    intPeriodTmp := intPeriod + intExcDia
  else
    intPeriodTmp := intPriVenc ;

  For intContador := 1 To intQtdPar Do
  Begin
    Result := Result + fStrZero(IntToStr(intPeriodTmp), 3);
    Inc(intPeriodTmp, intPeriod);
  End;

end;

{*****************************************}
{* RETORNA A CONDIÇÃO DE PAGAMENTO DE    *}
{* ACORDO COM AS PARCELAS DIGITADAS      *}
{**************************************MV*}
function fDigCndPagamento(Var strCndPag: String; dtaDtaBas: TDateTime; strCodCli: String): Boolean;
  Var
    strCndTmp: String;
    intQtdPar: Integer;
    frmDigParcelas : TfrmDigParcelas;
begin

  strCndTmp := Trim(fTiraCaracEspeciais(strCndPag));
  intQtdPar := 0;

  If Not fEmptyStr(Trim(LeftStr(strCndTmp, 2))) Then
    intQtdPar := StrToIntDef(Trim(LeftStr(strCndTmp, 2)), 0);

  Try

    pCriarFormularios(TfrmDigParcelas, frmDigParcelas);
    frmDigParcelas.intQtdPar      := intQtdPar;
    frmDigParcelas.mskParc01.Text := DateToStr(dtaDtaBas);
    frmDigParcelas.dtaDtaBas      := dtaDtaBas;
    frmDigParcelas.strCodCli      := strCodCli;
    frmDigParcelas.showModal;

    Result := frmDigParcelas.blnConfirma;

    If Result Then
    Begin
      strCndPag := frmDigParcelas.strCndPag;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fDigCndPagamento]');
    End;
  End;

  pFreeAndNil(frmDigParcelas);

end;

{*******************************************}
{* AUMENTA "intQtdDias" DE CADA PARCELA    *}
{****************************************MV*}
function fAumentaCndPagamento(strCndPag: String; intQtdDias: Integer): String;
  Var
    intQtdPar: Integer;
    intContador: Integer;
begin

  Result := LeftStr(strCndPag, 2);
  intQtdPar := StrToIntDef(Result, 0);

  For intContador := 1 To intQtdPar Do
  Begin
    Result := Result + fStrZero(StrToIntDef(Copy(strCndPag, intContador*3, 3), 0) + intQtdDias, 3);
  End;

end;

