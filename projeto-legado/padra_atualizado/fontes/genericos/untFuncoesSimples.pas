function fCalcularContraste(corFundo, corFonte: TColor): Double;
  Var
    Color : LongInt;
    R, G, B : Byte;
    fltBrilhoFundo, fltBrilhoFonte: Double;
begin
  Color := ColorToRGB(corFundo);
  R := GetRValue(Color);
  G := GetGValue(Color);
  B := GetBValue(Color);
  fltBrilhoFundo := ((R * 299) + (G * 587) + (B * 114)) / 1000;

  Color := ColorToRGB(corFonte);
  R := GetRValue(Color);
  G := GetGValue(Color);
  B := GetBValue(Color);
  fltBrilhoFonte := ((R * 299) + (G * 587) + (B * 114)) / 1000;

  Result := (fltBrilhoFonte - fltBrilhoFundo);
end;

