function fRetNomBairroIBGE(strCodigo: String; strCodCid : String = ''): String;
{FUNCAO QUE BUSCA O BAIRRO PELO CÓDIGO INFORMADO NA TABELA DE BAIRRO RELACIONADA AO IBGE - KD}
  Var
    qryConsulta : TUniQuery;
Begin
  Try
    qryConsulta := fCriaQuery(Nil);
    With qryConsulta, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT SQL_NO_CACHE ');
      Add(' bairro.id_bairro, ');
      Add(' bairro.nome NOME_BAIRRO, ');
      Add(' bairro.id_bairro AS AUTOINCREM ');
      Add(' FROM CADCID ');
      Add(' INNER JOIN cidade ON cidade.ibge = CID_COIBGE ');
      Add(' INNER JOIN bairro ON bairro.id_cidade = cidade.id_cidade ');
      Add(' WHERE id_bairro = :CODBAI      ');
      If Not fEmptyStr(strCodCid) then
        Add('   AND CID_CODCID = :CODCID   ');
      ParamByName('CODBAI').AsString := strCodigo;
      If Not fEmptyStr(strCodCid) then
        ParamByName('CODCID').AsString := strCodCid;
      Open;

      Result := FieldByName('NOME_BAIRRO').AsString;
      Close;
    End;
  Finally
    FreeAndNil(qryConsulta);
  End;
End;

