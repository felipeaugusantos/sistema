procedure pCarregaCdsImpostosItem(strLisCodIte: String;
                                  cdsIteGer: TUniClientDataSet = Nil); Overload;
  var
    qryGen: TUniQuery;
    strSQL: String;
    strTabUti: String;
Begin
  qryGen := fCriaQuery;
  Try
    With qryGen Do
    Begin
      strSQL := fSqlCdsIteger('', strTabUti);

      Close;
      SQL.Clear;
      SQL.Add(Copy(strSQL,1,Pos('ITEGER', strSQL)+6));
      SQL.Add(' WHERE ');
      SQL.Add('  ITE_CODITE IN('+strLisCodIte+') AND');
      SQL.Add('  ITE_CODEMP = '+QuotedStr(VS_strCodEmp));
      Open;

      First;
      If Not qryGen.IsEmpty Then
      Begin
        While Not qryGen.Eof Do
        Begin
          If (Not cdsIteGer.Locate('ITE_CODITE;ITE_CODEMP', VarArrayOf([QryGen.FieldByName('ITE_CODITE').AsString, VS_strCodEmp]), [])) Then      
            pIncluiIteger(cdsIteger, qryGen);

          qryGen.Next;  
        End;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

procedure pCarregaCdsImpostosItem(strCodIte : String;
                                  strCodEmp : String;
                                  strTabPre : String;
                                  cdsIteGer : TUniClientDataSet = Nil); Overload;
Var
  qryGen : TUniQuery;
  strSQL,
  strTabUti: String;
Begin

  If (Not Assigned(cdsIteGer)) then
    Exit;

  strSQL := fSqlCdsIteger(strTabPre, strTabUti);

  If (Not cdsIteGer.Locate('ITE_CODITE;ITE_CODEMP;ITE_TABELA', VarArrayOf([strCodIte, strCodEmp, strTabUti]), [])) Then
  Begin

    qryGen := fCriaQuery;

    Try

      qryGen.Close;
      qryGen.SQL.Clear;
      qryGen.SQL.Add(strSQL);
      qryGen.ParamByName('CODITE').AsString := strCodIte;
      qryGen.ParamByName('CODEMP').AsString := strCodEmp;
      qryGen.Open;

      If Not qryGen.IsEmpty Then
        pIncluiIteger(cdsIteger, qryGen);

    Finally
      FreeAndNil(qryGen);
    End;

  End;

End;

