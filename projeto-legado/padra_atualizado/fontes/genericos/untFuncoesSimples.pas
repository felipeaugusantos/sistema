function fPesquisar(strTexto, strPalavra: String; intPosIni: Integer;
  var intPosIniRet, intPosFin: Integer): Boolean;
begin

  strPalavra := AnsiUpperCase(strPalavra);
  strTexto   := AnsiUpperCase(strTexto);

  intPosIniRet := PosEx(strPalavra, strTexto, intPosIni);
  If intPosIniRet > 0 Then
  Begin
    Result := True;
    Dec(intPosIniRet);
    intPosFin := intPosIniRet + Length(strPalavra);
  End
  Else
  Begin
    Result := False;
  End;

end;

function fPesquisarEdit(edtEdit: TCustomEdit; strPalavra: String;
  blnContinuacao: Boolean): Boolean;
  Var
    intPosIni: Integer;
    intPosFin: Integer;
    intFatSoma: Integer;
begin

  If blnContinuacao Then
    intFatSoma := 2
  Else
    intFatSoma := 0;

  If fPesquisar(edtEdit.Text, strPalavra, edtEdit.SelStart+intFatSoma, intPosIni, intPosFin) Then
  Begin
    Result := True;
    edtEdit.SelStart := intPosIni;
    edtEdit.SelLength := intPosFin - intPosIni;
    pSetFocus(edtEdit);
  End
  Else
  Begin
    Result := False;
  End;
end;

{*******************************************}
{* FUNCAO QUE RETORNA LISTA DE EMPRESAS QUE*}
{* UTILIZAM OS PRECOS DA EMPRESA MATRIZ,   *}
{* NO CASO SE A EMRESA ATUAL FOR A PROPRIA *}
{****************************************JC*}
function fRetEmpresasUsamPrecoMatriz(stlEmpresas: TStringList = Nil; strCodEmp: String = ''; strEmpPar: String = '';
                                     blnSomenteAtivas: Boolean = False): String;
  Var
    qryGenEmp: TUniQuery;
    strSQL   : String;
    blnSomenteMatriz: Boolean;
    strEmpMatLoja: String;
begin
  If fEmptyStr(strEmpPar) Then
    strEmpPar := VS_StrCodEmp;

  strEmpMatLoja:= '';
  blnSomenteMatriz := (fCfgSis('REPPRC', varString, strEmpPar) = '1');
  If (Not blnSomenteMatriz) AND fCfgSis('INFMAT', varBoolean, strEmpPar) Then
    strEmpMatLoja := fCampoTabela('EMP_CODMAT', 'CADEMP', ['EMP_CODEMP'], [strEmpPar]);

  If strCodEmp <> '' Then
    Result := strCodEmp + '_'
  Else
    Result := VS_strCodEmp + '_';

  If Assigned(stlEmpresas) Then
  Begin
    stlEmpresas.Clear;
    stlEmpresas.Add(VS_strCodEmp);
  End;

  {*******************************************}
  {* CASO SEJA EMPRESA GERENCIAL E SOMENTE A *}
  {* MESMA POSSA REPLICAR OS PRECOS, OU      *}
  {* QUALQUER EMPRESA REPLICA OS PRECOS      *}
  {****************************************JC*}
  If (fCfgSis('EMPGER', varBoolean, strEmpPar) And blnSomenteMatriz) Or (Not blnSomenteMatriz) Then
  Begin

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  EMP_CODEMP ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADEMP ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  EMP_CODEMP <> :CODEMP AND ';
    strSQL := strSQL + '  EMP_PREMAT = "S" ';

    (**********************************************************)
    (* SE UTILIZA DEFINIÇÃO DE QUEM É A MATRIZ                *)
    (* PEGA TODAS AS LOJAS QUE A EMPRESA CORRENTE COMO MATRIZ *)
    (*******************************************************LA*)
    If fCfgSis('INFMAT', varBoolean, strEmpPar) Then
    Begin
      If (Not blnSomenteMatriz) And (strEmpMatLoja <> '') Then
        strSQL := strSQL + ' AND EMP_CODMAT = "' + strEmpMatLoja + '"'
      Else
        strSQL := strSQL + ' AND EMP_CODMAT = :CODEMP '
    End;

    If blnSomenteAtivas Then
      strSQL := strSQL + ' AND EMP_EMPATI = "S" ';

    qryGenEmp:= fCriaQuery(Nil);

    With qryGenEmp Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      If strCodEmp <> '' Then
        ParamByName('CODEMP').AsString := strCodEmp
      Else
        ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      While Not Eof Do
      Begin

        Result := Result + FieldByName('EMP_CODEMP').AsString;

        If RecNo < RecordCount Then
          Result := Result + '_';

        If Assigned(stlEmpresas) Then
          stlEmpresas.Add(FieldByName('EMP_CODEMP').AsString);

        Next;
      End;

    End;

    FreeAndNil(qryGenEmp);

  End;

end;

