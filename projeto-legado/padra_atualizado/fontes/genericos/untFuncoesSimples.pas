procedure pRetornaLoteESaldoItem(strCodIte: String; Var strNumLot: String; Var fltSaldo: Double);
CONST
  SQL_CONSULTA_LOTE_PRINCIPAL_PRODUCAO = ' SELECT       '+
                                         '   LOT_NUMLOT,'+
                                         '   LOT_SALDOS '+
                                         ' FROM CADLOT L '+
                                         '   WHERE LOT_CODITE = :CODITE      AND '+
                                         '         LOT_CODEMP = :CODEMP      AND '+
                                         '         LOT_SALDOS > 0            AND '+
                                         '         LOT_NUMLOT <> "GARANTIA"  AND '+
                                         '         LOT_NUMLOT <> "A DEFINIR" AND '+
                                         '         LOT_STATUS = "S" ';
var
  qryConsulta: TUniQuery;
begin
  qryConsulta:= fCriaQuery(Nil);
  Try

    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add(SQL_CONSULTA_LOTE_PRINCIPAL_PRODUCAO);
    qryConsulta.ParamByName('CODITE').AsString:= strCodIte;
    qryConsulta.ParamByName('CODEMP').AsString:= VS_strCodEmp;
    qryConsulta.Open;

    strNumLot:= '';
    fltSaldo := 0;

    If qryConsulta.RecordCount = 1 Then
    Begin
      If qryConsulta.FieldByName('LOT_SALDOS').AsFloat > 0 Then
      Begin
        strNumLot:= qryConsulta.FieldByName('LOT_NUMLOT').AsString;
        fltSaldo := qryConsulta.FieldByName('LOT_SALDOS').AsFloat;
      End;
    End

  Finally
    FreeAndNil(qryConsulta);
  End;

End;

