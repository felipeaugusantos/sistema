//*************************************************//
// FUNCAO QUE ARREDONDA UM NUMERO SEMPRE A MAIS    //
// EX.:                                            //
//                                                 //
//  10,53 = 10,60 / 10,51 = 10,60 / 10,50 = 10,50  //
//                                                 //
//**********************************************ED*//
function fArredondaMais(fltVlrIni: Double; blnArrDez: Boolean = False): Double;
  Var
    strVlrIni : String;
    strAuxili : String;

Begin

  Result := fltVlrIni;

  strVlrIni := FormatFloat('#,##0.00', fltVlrIni);
  strAuxili := RightStr(strVlrIni, 1);

  If strAuxili = '0' Then
    Exit;

  //*************************************************//
  // SE A VARIAVEL blnArrDez FOR VERDADEIRA ENTAO    //
  // ARREDONDA DE DEZ EM DEZ, SENAO DE 5 EM 5        //
  //**********************************************ED*//
  If Not( blnArrDez ) Then
  Begin

    If (strAuxili > '0') And (strAuxili < '5') Then
    Begin
      strAuxili := FormatFloat('0.00',(5 - StrToIntDef(strAuxili, 0))/100);
    End

    Else If strAuxili > '5' Then
    Begin
      strAuxili := FormatFloat('0.00',(10 - StrToIntDef(strAuxili, 0))/100);
    End

    Else If strAuxili = '5' Then
    Begin
      strAuxili := '0';
    End;

  End
  Else
  Begin
    strAuxili := FormatFloat('0.00',(10 - StrToIntDef(strAuxili, 0))/100);
  End;

  strVlrIni := FormatFloat('0.00', fStrToFloat(strVlrIni));
  strVlrIni := FormatFloat('0.00', fStrToFloat(strAuxili) + fStrToFloat(strVlrIni));

  Result := fStrToFloat(strVlrIni);

End;

