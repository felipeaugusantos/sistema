procedure pFindAndActivePage(Sender: TWinControl);
var
  TabSheetAux: TTabSheet;
  PageControlAux: TPageControl;
begin
  PageControlAux := Nil;
  TabSheetAux := TTabSheet(fFindParentByType(Sender, TTabSheet));
  If (TabSheetAux <> Nil) and (TabSheetAux.TabVisible) Then
  Begin
    Repeat
      If (PageControlAux <> Nil) Then
        TabSheetAux := TTabSheet(fFindParentByType(PageControlAux, TTabSheet));
      PageControlAux := TPageControl(fFindParentByType(TabSheetAux, TPageControl));
      PageControlAux.ActivePage := TabSheetAux;
    Until (fFindParentByType(PageControlAux, TTabSheet) = Nil);
  End;
End;

function fFindParentByType(Sender: TWinControl; ParentType: TWinControlClass): TWinControl;
begin
  Result := nil;
  if Assigned(Sender.Parent) then
  begin
    if (Sender.Parent Is ParentType) then
      Result := Sender.Parent
    else
      Result := fFindParentByType(Sender.Parent, ParentType);
  end;
end;

function fCheckParent(Sender, Parent: TWinControl): Boolean;
begin
  If Sender = Nil Then
  Begin
    Result := False;
    Exit;
  End;

  If Sender.Parent = nil Then
    Result := False
  Else If Sender.Parent = Parent Then
    Result := True
  Else
    Result := fCheckParent(Sender.Parent, Parent);
end;

function fFindMenu(strFind: String; item: TMenuItem; AUseHint: Boolean = False; strMenuPath: String = ''): TMenuItem;
  Var
    i: Integer;
begin
  Result := Nil;

  If (String(item.Name).ToLower = strFind.ToLower) Or
     (AUseHint And (item.Hint.ToLower = strFind.ToLower)) Then
  Begin
    If (strMenuPath.IsEmpty) Then
    Begin
      Result := item;
      Exit;
    End;

    If (fGetMenuPath(item) = strMenuPath) Then
    Begin
      Result := item;
      Exit;
    End;
  End;

  For i := 0 To item.Count -1 Do
  Begin
    Result := fFindMenu(strFind, item.Items[i], AUseHint, strMenuPath);

    If Assigned(Result) Then
      Break;
  End;
end;

function fGetMenuLevel(item: TMenuItem): Integer;
begin
  Result := 0;
  If Assigned(item) And Assigned(item.Parent) Then
    Result := fGetMenuLevel(item.Parent) + 1;
end;

function fGetMenuPath(item: TMenuItem): String;
begin
  If Not Assigned(item) Then
    Exit;

  Result := '';

  If Assigned(item.Parent) Then
    Result := fGetMenuPath(item.Parent);

  If fGetMenuLevel(item) > 0 Then
    Result := Result + ' > ';

  Result := Result + item.Caption;

  Result := AnsiReplaceStr(Result, '&', '');
end;

{*****************************************************************************}
{* INJETA UMA TECLA (KEYDOWN + KEYUP) USANDO SendInput. SUBSTITUTO MODERNO   *}
{* PARA keybd_event. wVK = CÓDIGO VIRTUAL (VK_RETURN, VK_RIGHT, ETC).        *}
{*****************************************************************************}
procedure pKeybd_Event(wVK: Word);
  Var
    arrInputs: array[0..1] of TInput;
Begin
  ZeroMemory(@arrInputs, SizeOf(arrInputs));

  arrInputs[0].Itype      := INPUT_KEYBOARD;
  arrInputs[0].ki.wVk     := wVK;
  arrInputs[0].ki.dwFlags := 0;               //comando de aperta a tecla

  arrInputs[1].Itype      := INPUT_KEYBOARD;
  arrInputs[1].ki.wVk     := wVK;
  arrInputs[1].ki.dwFlags := KEYEVENTF_KEYUP; //comando de soltar a tecla

  SendInput(2, arrInputs[0], SizeOf(TInput)); //envia o dos comandos
End;

procedure pGeraPopUp(AOwner: TComponent; Menu: TMenuItem; popMenu: TMenuItem;
  strEsconder: String = ''; blnMenuPath: Boolean = False);
  Var
    intContador: Integer;
    mnuNovo: TMenuItem;
    LTemAcesso: Boolean;
begin
  LTemAcesso := fVerificaAcessoSistema(Menu.Hint);

  if not LTemAcesso then
    LTemAcesso := fVerificaAcessoAutTin(Menu.Hint, Menu.Name);

  if not LTemAcesso then
      Exit;

  If (Not Menu.Visible) Then
    Exit;

  If SameText(Menu.Caption, MOME_MENU_CRIAREL) Then
    Exit;

  If (Menu.Count > 0) Then
  Begin
    mnuNovo := TMenuItem.Create(AOwner);
    If TCustomMenuItem(Menu).Projeto.ToUpperInvariant.Equals('LIBCARTOESAUTCOM.DLL') Then
    Begin
      mnuNovo := TCustomMenuItem.Create(AOwner);
      TCustomMenuItem(mnuNovo).Projeto := TCustomMenuItem(Menu).Projeto;
      TCustomMenuItem(mnuNovo).LibAcesso := TCustomMenuItem(Menu).LibAcesso;
      TCustomMenuItem(mnuNovo).Layout := TCustomMenuItem(Menu).Layout;
    End;

    If blnMenuPath Then
      mnuNovo.Caption := fGetMenuPath(Menu)
    Else
      mnuNovo.Caption := Menu.Caption;

    mnuNovo.Hint    := Menu.Hint;
    mnuNovo.Tag     := Menu.Tag;
    mnuNovo.Name    := Menu.Name + '_PopUp_' + fInc(VS_intPopUpId).ToString;
    mnuNovo.OnClick := Menu.OnClick;
    popMenu.Add(mnuNovo);
    For intContador := 0 To Menu.Count -1 Do
    Begin
      pGeraPopUp(AOwner, Menu.Items[intContador], mnuNovo, strEsconder, blnMenuPath);
    End;
  End
  Else
  Begin

    If (Not fEmptyStr(strEsconder)) Then
    Begin
      If (Pos(Menu.Name, strEsconder) > 0) Then
        Exit;
    End;

    mnuNovo := TMenuItem.Create(AOwner);
    If TCustomMenuItem(Menu).Projeto.ToUpperInvariant.Equals('LIBCARTOESAUTCOM.DLL') Then
    Begin
      mnuNovo := TCustomMenuItem.Create(AOwner);
      TCustomMenuItem(mnuNovo).Projeto := TCustomMenuItem(Menu).Projeto;
      TCustomMenuItem(mnuNovo).LibAcesso := TCustomMenuItem(Menu).LibAcesso;
      TCustomMenuItem(mnuNovo).Layout := TCustomMenuItem(Menu).Layout;
    End;

    If blnMenuPath Then
      mnuNovo.Caption := fGetMenuPath(Menu)
    Else
      mnuNovo.Caption := Menu.Caption;

    mnuNovo.Hint    := Menu.Hint;
    mnuNovo.Tag     := Menu.Tag;
    mnuNovo.Name    := Menu.Name + '_PopUp_' + fInc(VS_intPopUpId).ToString;
    mnuNovo.OnClick := Menu.OnClick;
    popMenu.Add(mnuNovo);
  End;

end;

