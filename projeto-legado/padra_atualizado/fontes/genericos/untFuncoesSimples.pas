function AlterarContaResultado(AContaResultado: String;  ACodCta: String = ''): Boolean;
var
  qryBusca: TUniQuery;
begin
  qryBusca := fCriaQuery;

  qryBusca.Close;
  qryBusca.SQL.Clear;
  qryBusca.SQL.Add('SELECT PME_DESREC, ');
  qryBusca.SQL.Add('       PME_MESANO, ');
  qryBusca.SQL.Add('       PME_VALMES, ');
  qryBusca.SQL.Add('       AUTOINCREM, ');
  qryBusca.SQL.Add('       PME_CODEMP, ');
  qryBusca.SQL.Add('       PME_DESCRI, ');
  qryBusca.SQL.Add('       PME_CODCTA, ');
  qryBusca.SQL.Add('       PME_CODRES  ');
  qryBusca.SQL.Add('FROM CADPME ');
  qryBusca.SQL.Add('WHERE PME_CODRES = :CONTARESULTADO AND ');
  qryBusca.SQL.Add('      PME_VALMES > 0 ');

  If Not fEmptyStr(ACodCta) Then
    qryBusca.SQL.Add('  AND PME_CODCTA = :CODCTA ');

  qryBusca.ParamByName('CONTARESULTADO').AsString := AContaResultado;
  If Not fEmptyStr(ACodCta) Then
    qryBusca.ParamByName('CODCTA').AsString := ACodCta;

  qryBusca.Open;

  if qryBusca.IsEmpty then
    Result := True
  else
    Result := False;

  FreeAndNil(qryBusca);
end;

