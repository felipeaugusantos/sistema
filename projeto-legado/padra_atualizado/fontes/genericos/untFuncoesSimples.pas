function RemoveMilliseconds(ATime: TDateTime): TDateTime;
var
  Hour, Min, Sec, MSec: Word;
begin
  // Decodes the time part into hour, minute, second, and millisecond
  DecodeTime(ATime, Hour, Min, Sec, MSec);

  // Re-encodes the time without milliseconds (set MSec to 0)
  Result := EncodeTime(Hour, Min, Sec, 0);
end;

function fNextParcelaValida(ANumDoc,  ASerie,
  ACodFor, ACodEmp: String): Char;
  var qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.SQL.Add('SELECT MAX(CTP_PARCEL) AS PARCEL  ');
    qryConsulta.SQL.Add('  FROM CADPAG  ');
    qryConsulta.Sql.Add(' WHERE CTP_CODFOR = "' + ACodFor + '"');
    qryConsulta.Sql.Add('   AND CTP_NUMDUP = "' + ANumDoc + '"');
    qryConsulta.Sql.Add('   AND CTP_CODEMP = "' + ACodEmp +'"');
    qryConsulta.Sql.Add('   AND IFNULL(CTP_SERIE_, "") = "' + ASerie + '"');
    qryConsulta.Open;

    If fEmptyStr(qryConsulta.FieldByName('PARCEL').AsString) Then
      Result := 'A'
    Else
      Result := fGetLetraAlfa(fGetPosLetraAlfa(qryConsulta.FieldByName('PARCEL').AsString) + 1).Chars[0];
  Finally
    FreeAndNil(qryConsulta)
  End;
end;

