Function fCalculaSaldoDisponivel(intCalSal: Integer;
              fltSalFis, fltSalGar, fltSalPed, fltSalEnd, fltSalOrd,
              fltFutPre, fltFutFal, fltFutAgu, fltSalExt, fltBaiFut: Double): Double;
Begin
  If (fCfgSis('MOVFUL', varString) = '2') Then
    fltSalExt := 0;

  Case intCalSal Of
    1:   Result := fltSalFis - fltSalGar - fltSalPed - fltSalEnd - fltSalOrd - fltSalExt - fltBaiFut;
    2:   Begin
           If (Not fCfgSis('BEFTRG', VarBoolean)) Or fUsaQtdPendenteEntregaFutura Then
             Result := fltSalFis - fltSalGar - fltSalPed - fltSalEnd - fltSalOrd - fltSalExt - fltFutPre - fltFutFal - fltFutAgu - fltBaiFut
           Else
             Result := fltSalFis - fltSalGar - fltSalPed - fltSalEnd - fltSalOrd - fltSalExt - fltBaiFut;
         End;
    3:   Result := fltSalFis - fltSalGar - fltSalPed - fltSalEnd - fltSalOrd - fltSalExt - fltFutPre - fltFutAgu - fltBaiFut;
    4:   Result := fltSalFis - fltSalGar - fltSalPed - fltSalEnd - fltSalOrd - fltSalExt - fltFutFal - fltBaiFut;
    5:   Result := fltSalFis - fltSalGar - fltSalPed - fltSalEnd - fltSalOrd - fltSalExt - fltFutPre - fltBaiFut;
    Else Result := 0;
  End;
End;

