function fCalculaTaxVpr(strConPag: String; fltTxJCnd: Double): Double;
begin
  Result := 0.0;
  If fltTxJCnd > 0 Then
     Result := fFormataFloat((fltTxJCnd / 30) * fCalcMediaPagto(strConPag), 2)

  Else If fCalcMediaPagto(strConPag) > fCfgSis('DIATAX', varInteger) Then
  Begin
    If fCfgSis('TAXAPL') = 'I' Then
      Result := fFormataFloat((fCfgSis('TAXJUR', varDouble) / 30) * fCalcMediaPagto(strConPag) ,2)
    Else
      Result := fFormataFloat((fCfgSis('TAXJUR', varDouble) / 30) * (fCalcMediaPagto(strConPag) - fCfgSis('DIATAX', varInteger)), 2);
  End;
end;

function fTravarDataForaDiaUtil(var dtaData: TDateTime;
  var intDiaEnt: Extended; const strCodEmp: String): Boolean;
var
  blnConsiderarFDSComoDiaUtil,
  blnDiasUteis,
  blnDiaUtilSabado,
  blnFinalDeSemana : Boolean;
  strCodCid        : String;
  dtaDataInicial   : TDateTime;
begin
  Result := True;

  If (dtaData = 0) Then
  Begin
    fMensagem('ATENÇÃO!', FormatDateTime('dd/mm/yyyy', dtaData) + ' não é uma data válida!', ['&Ok']);
    Exit(False);
  End;

  blnFinalDeSemana := False;
  blnDiaUtilSabado := False;
  blnDiasUteis     := fCfgSis('DIAUTI', varBoolean);
  dtaDataInicial   := dtaData;
  strCodCid        := fCampoTabela('EMP_CODCID', 'CADEMP', ['EMP_CODEMP'], [strCodEmp]);

  If Not blnDiasUteis Then
  Begin
    If DayOfWeek(dtaDataInicial) = 1 Then
    Begin
      dtaDataInicial := dtaDataInicial + 1;
      blnFinalDeSemana := True;
    End;

    If DayOfWeek(dtaDataInicial) = 7 Then
    Begin
      dtaDataInicial := dtaDataInicial + 2;
      blnFinalDeSemana := True;
    End;

    blnConsiderarFDSComoDiaUtil := fEhFeriado(dtaDataInicial, strCodCid);

    If (blnFinalDeSemana) Or (blnConsiderarFDSComoDiaUtil) Then
    Begin
      fMensagem('Atenção',  'Sistema configurado para não considerar finais de ' +
                            'semana e feriado para data de entrega, é necessário informar uma data valida!'+#13+
                            'Data de entrega modificada para o próximo dia útil válido.', ['&O k']);

      If blnConsiderarFDSComoDiaUtil Then
        dtaDatainicial := fAcertaDataParaDiaUteis(dtaDatainicial, 0, blnDiasUteis, strCodCid);

      dtaData := dtaDatainicial;
      Exit(False);
    End;
  End
  Else
  Begin
    If (DayOfWeek(dtaDataInicial) = 1) Or (fEhFeriado(dtaDataInicial, strCodCid)) Then
    Begin
      If fMensagem('AVISO!', 'A data de entrega informada é um domingo ou feriado deseja mudar para o próximo dia útil?', ['&Sim', '&Não'], 2) = 1 Then
      Begin
        While Not blnDiaUtilSabado Do
        Begin
          dtaDataInicial   := dtaDataInicial + 1;
          blnDiaUtilSabado := (DayOfWeek(dtaDataInicial) <> 1) And (Not fEhFeriado(dtaDataInicial, strCodCid));
        End;

        dtaData := dtaDatainicial;
        Exit(False);
      End;
    End;
  End;

  intDiaEnt := dtaData - VS_Date;
end;

