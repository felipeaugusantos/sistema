function fValidarCampoEmail(edtEmail: TComponent; strNomeCampo: String): Boolean;

  function fGetEdtText: String; begin;
    If (edtEmail Is TEditFocus) Then
      Result := TEditFocus(edtEmail).Text
    Else If (edtEmail Is TDBEditFocus) Then
      Result := TDBEditFocus(edtEmail).Text
    Else
      Result := '';
  end;

  procedure pSetEdtText(strTexto: String); begin;
    If (edtEmail Is TEditFocus) Then
      TEditFocus(edtEmail).Text := strTexto
    Else If (edtEmail Is TDBEditFocus) Then
      TDBEditFocus(edtEmail).Text := strTexto;
  end;

begin
  Result := True;

  If (Assigned(edtEmail)) Then Begin
    If (Not (fContarString(';', fGetEdtText()) In [fContarString('@', fGetEdtText()), fContarString('@', fGetEdtText()) - 1])) Then Begin
      fMensagem('ATENÇÃO!', 'Foram informados mais de 1 endereço de e-mail no campo ' +
        QuotedStr(strNomeCampo) + ', separe-os com ' + QuotedStr(';') + ' (ponto e vírgula) e certifique-se' +
        ' de que o caracter ' + QuotedStr('@') + ' foi informado corretamente em cada um deles!', ['&OK']);
      Result := False;
    End Else Begin
      Result := fEmailValido(fGetEdtText(), True, strNomeCampo, True, False);

      If (Result) And (Not fEmptyStr(Trim(fGetEdtText()))) Then Begin
        If (Copy(Trim(fGetEdtText()), Length(Trim(fGetEdtText())), 1) <> ';') Then
          pSetEdtText(fGetEdtText() + ';');
      End;
    End;
  End;
end;

