function fPedidosEmAbertoParaVeiculo(strPlaVei: String; strPedAlt: String = ''): String;
  Var
    qryTemp: TUniQuery;
begin
  qryTemp := fCriaQuery(nil);

  With qryTemp, SQL Do
  Begin
    Close;
    Clear;
    Add('SELECT SQL_NO_CACHE');
    Add('  GROUP_CONCAT(DISTINCT CONCAT(FGO_NUMDOC,"-", FGO_ESPDOC)) AS PEDIDOS');
    Add('FROM');
    Add('  FATGOR');
    Add('  INNER JOIN EXTGOR ON FGO_SEQFGO = AUTOINCREM');
    Add('WHERE');
    Add('  FGO_CODEMP = :CODEMP AND');
    Add('  FGO_PLAVEI = :PLAVEI AND');
    Add('  FGO_ESPDOC = "PD" AND ');
    Add('  FGO_JAFATU = 0 ');

    If Not fEmptyStr(strPedAlt) Then
      Add('  AND FGO_NUMDOC <> :PEDALT ');

    Add('ORDER BY');
    Add('  FGO_NUMDOC');

    ParamByName('CODEMP').AsString := VS_strCodEmp;
    ParamByName('PLAVEI').AsString := strPlaVei;

    If Not fEmptyStr(strPedAlt) Then
      ParamByName('PEDALT').AsString := strPedAlt;

    Open;

    Result := FieldByName('PEDIDOS').AsString;
  End;

  FreeAndNil(qryTemp);
end;

function fPedidoOuOrcamentoEmAbertoParaCliente(strCodCli: String; Var strNumDoc, strEspDoc: String): Boolean;
  Var
    qryTemp: TUniQuery;
begin
  qryTemp := fCriaQuery(nil);

  With qryTemp, SQL Do
  Begin
    Close;
    Clear;
    Add('SELECT SQL_NO_CACHE');
    Add('  FGO_NUMDOC, FGO_ESPDOC ');
    Add('FROM');
    Add('  FATGOR');
    Add('WHERE');
    Add('  FGO_CODEMP = :CODEMP AND');
    Add('  FGO_CODCLI = :CODCLI AND');
    Add('  FGO_JAFATU = 0       AND');
    Add('  FGO_ESPDOC <> "PR"      ');
    Add('ORDER BY');
    Add('  FGO_NUMDOC');

    ParamByName('CODEMP').AsString := VS_strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;

    Open;

    Result := Not IsEmpty;

    strNumDoc := FieldByName('FGO_NUMDOC').AsString;
    strEspDoc := FieldByName('FGO_ESPDOC').AsString;
  End;

  FreeAndNil(qryTemp);
end;

