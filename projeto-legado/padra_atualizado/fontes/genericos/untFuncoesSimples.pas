function fRetParteEndereco(strEndereco: String; intParte:Integer):String;
Const
  intLogradouro = 1;
  intNumero = 2;
  intComplemento = 3;

Var
  intIndex1: Integer;
  intIndex2: Integer;
  strEnderecoOri: String;
  strLogradouro: String;
  strNumero: String;
  strComplemento: String;
begin
  strEnderecoOri := strEndereco;

  strEndereco := Trim(strEndereco);
  intIndex1 := Pos(',', strEndereco);
  intIndex2 := Pos('-', strEndereco);

  If (intIndex2 > 0) Then
  Begin
    strComplemento := Copy(strEndereco, intIndex2, Length(strEndereco)-intIndex2+1);
    strEndereco := ReplaceStr(strEndereco, strComplemento, '');
    strComplemento := Trim(ReplaceStr(strComplemento, '-', ''));
  End;

  If (intIndex1 > 0) Then
  Begin
    strNumero := Copy(strEndereco, intIndex1, Length(strEndereco)-intIndex1+1);
    strEndereco := ReplaceStr(strEndereco, strNumero, '');
    strNumero := Trim(ReplaceStr(strNumero, ',', ''));
  End;

  strLogradouro := Trim(strEndereco);

  Case intParte Of
    intLogradouro: Result := strLogradouro;
    intNumero: Result := strNumero;
    intComplemento: Result := strComplemento;
    Else
      Result := strEnderecoOri;
  End;
end;

