{********************************}
{* CALCULA O SALDO ANTERIOR DOS *}
{* RELATÓRIOS BANCARIOS         *}
{*****************************AF*}
function fRetSaldoAnterior(strCodPor: String; dtaDataIni: TDateTime;
                           strCodEmp: String = '';
                           sitSitLan: TSituacaoLancBancario = sitTodos): Currency;
  Var
    strSQL   : String;
    qryGenPor: TUniQuery;
Begin
  Try
    qryGenPor := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT    ';
    strSQL := strSQL + '  SUM(IF(CTB_CREDEB = "C", CTB_VALLAN, -CTB_VALLAN)) AS TOTLAN ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVBAN ';
    strSQL := strSQL + '  LEFT JOIN CADPOR ON CTB_CODPOR = POR_CODPOR ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CTB_CODPOR = :CODPOR AND ';
    strSQL := strSQL + '  CTB_DTALAN BETWEEN POR_DTAINI AND :DTAINI ';

    Case sitSitLan Of
      sitConciliado   : strSQL := strSQL + ' AND CTB_DTACON IS NOT NULL ';
      sitNaoConciliado: strSQL := strSQL + ' AND CTB_DTACON IS NULL ';
      sitConc_NaoConc : strSQL := strSQL + ' AND CTB_DTACON IS NOT NULL ';
    End;

    If Not fEmptyStr(strCodEmp) Then
      strSQL := strSQL + '  AND LOCATE(CTB_CODEMP, :CODEMP) > 0 ';

    With qryGenPor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODPOR').AsString := strCodPor;
      ParamByName('DTAINI').AsDate   := dtaDataIni;

      If Not fEmptyStr(strCodEmp) Then
        ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      Result := FieldByName('TOTLAN').AsFloat;

      Close;
    End;

  Finally
    FreeAndNil(qryGenPor);
  End;

End;

