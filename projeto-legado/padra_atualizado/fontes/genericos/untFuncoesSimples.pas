    {* VERIFICA SE EXISTE O ARQUIVO OPCOES_LOCAIS.INI                                 *}
    {* CASO EXISTA - ATUALIZA A CONFIGURACAO VS_STRTIPEXP E VS_STRESP40S APARTIR DELE *}
    {* OBS: ESSE ARQUIVO DEVERÁ FICAR SEMPRE NA PASTA WINDOWS DA MAQUINA              *}
    {*******************************************************************************LU*}
    If fEmptyStr(strPatIni) Then
    Begin
      GetWindowsDirectory(Buffer, 255);
      strPatIni := StrPas(Buffer);
    End;

    VS_strIconeAutcomBarraNotificacao := 'S';

    strPatIni := strPatIni + '\OPCOES_LOCAIS.INI';

    If FileExists(strPatIni) Then
    Begin
      VS_strTipExp := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO' , VS_strTipExp, strPatIni);

      VS_strTipExpLocal := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_LOCAL_SEPARACAO' , VS_strTipExpLocal, strPatIni);

      VS_strTipExpTipoDocumento := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_TIPO_DOCUMENTO' , VS_strTipExpTipoDocumento, strPatIni);
      VS_strTipExpTipoMovimento := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_TIPO_MOVIMENTO' , VS_strTipExpTipoMovimento, strPatIni);
      VS_strTipExpSituacaoFinanceira := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_SITUACAO_FINANCEIRA' , VS_strTipExpSituacaoFinanceira, strPatIni);
      VS_strTipExpUrgente            := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_URGENTE', VS_strTipExpUrgente, strPatIni);

      VS_strTipExpImpTipoDocumento := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_IMPRESSAO_BAIXA_SEPARACAO_TIPO_DOCUMENTO' , VS_strTipExpImpTipoDocumento, strPatIni);
      VS_strTipExpImpTipoMovimento := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_IMPRESSAO_BAIXA_SEPARACAO_TIPO_MOVIMENTO' , VS_strTipExpImpTipoMovimento, strPatIni);
      VS_strTipExpImpSituacaoFinanceira := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_IMPRESSAO_BAIXA_SEPARACAO_SITUACAO_FINANCEIRA' , VS_strTipExpImpSituacaoFinanceira, strPatIni);
      VS_strTipExpImpUrgente            := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_IMPRESSAO_URGENTE', VS_strTipExpImpUrgente, strPatIni);


      VS_strExpRetiraEntrega := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'TIPO_PEDIDO' , VS_strExpRetiraEntrega, strPatIni);
      VS_strEsp40s := fArqIniLocal(0, 'IMPRESSAO_40COLS', 'ESPDOC' , VS_strEsp40s, strPatIni);
      VS_strEsp80c := fArqIniLocal(0, 'IMPRESSAO_80COLS', 'ESPDOC' , VS_strEsp80c, strPatIni);
      VS_strTabPreCheckOut := fArqIniLocal(0, 'FATURAMENTO', 'TAB_PRECO_CHECK_OUT' , VS_strTabPreCheckOut, strPatIni);
      VS_strEtiTintaMaq := fArqIniLocal(0, 'ETIQUETA_TINTAMAQ', 'IMP_ETI_TINTAMAQ' , VS_strEtiTintaMaq, strPatIni);

      VS_strIconeAutcomBarraNotificacao := fArqIniLocal(0, 'SISTEMA', 'EXIBIR_ICONE_BARRA_NOTIFICACAO' , VS_strIconeAutcomBarraNotificacao, strPatIni);

      VS_strTipExpImpDeptoVendedor :=  fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_IMPRESSAO_BAIXA_SEPARACAO_DEPTO_VENDEDOR' , VS_strTipExpImpDeptoVendedor, strPatIni);
      VS_strTipExpDeptoVendedor := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_DEPTO_VENDEDOR' , VS_strTipExpDeptoVendedor, strPatIni);
      VS_strTipExpImpArmazem  := fArqIniLocal(0, 'TIPO_FATURAMENTO', 'EXPEDICAO_IMPRESSAO_BAIXA_SEPARACAO_ARMAZEM' , VS_strTipExpImpArmazem, strPatIni);

      VS_strTipExpRetiraExpedicao := fArqIniLocal(0, 'TIPO_RETIRA_EXPEDICAO', 'RETIRA_EXPEDICAO' , VS_strTipExpRetiraExpedicao, strPatIni);
      VS_strTipExpRetiraBalcao := fArqIniLocal(0, 'TIPO_RETIRA_EXPEDICAO', 'RETIRA_BALCAO' , VS_strTipExpRetiraBalcao, strPatIni);
      VS_strTipExpRetiraBalcao2 := fArqIniLocal(0, 'TIPO_RETIRA_EXPEDICAO', 'RETIRA_BALCAO2' , VS_strTipExpRetiraBalcao2, strPatIni);

      If Pos(VS_strExpRetiraEntrega, 'TRE') <= 0 Then
        Raise Exception.Create('Variável para tipo de pedido na expedição com valor inválido. Deve ser T, R ou E.');
    End;

    //Verifica se o valor da configuracao foi passado por parametro pela linha de comando
    //Por exemplo: C:/AUTCOM/AUTCOM.exe TIPEXP=4
    fBuscaValorConfiguracaoDefinidoLinhaComando('TIPEXP', VS_strTipExp);

    VS_strVerPaf := fRetVersaoPAFAutcom;
    VS_strMd5Aut := fRetMD5Autcom;

    {**************************************************}
    {* ATUALIZA OS PORTADORES QUE A EMPRESA TEM ACESSO*}
    {***********************************************LE*}
    If fCfgSis('DACPOR', varBoolean) Then
      strPortadoresOperador := fRetPortadoresOperador(strLoginUsuarioLogado);

    VS_strClaDem :=  fTransform(fCfgSis('CLADEM'), 3);

    VS_strUrlSms := fCfgSis('URLSMS', varString);
