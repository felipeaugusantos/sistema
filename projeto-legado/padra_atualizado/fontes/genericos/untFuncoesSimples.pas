function fRetPreComMenosDescForn(strCodIte, strCodEmp: String; cdsIteGer: TUniClientDataSet = Nil;
                                 strCALSOP: String = ''): Double;
Var
  strSQL   : String;
  strTabUti: String;
  qryGen   : TUniQuery;
  dtsIteger: TDataSet;
  LParametrosCalcularPreComMenosDescForn: IParametrosCalculoPreComMenosDescForn;
Begin
  Try
    qryGen := Nil;

    If fEmptyStr(strCALSOP) Then
      strCALSOP := fCfgSis('CALSOP');

    strSQL := fSqlCdsIteger('', strTabUti);

    If (Not Assigned(cdsIteGer)) Or
       (Not cdsIteGer.Locate('ITE_CODITE;ITE_CODEMP', VarArrayOf([strCodIte, strCodEmp]), [])) Then
    Begin
      qryGen := fCriaQuery;

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODITE').AsString := strCodIte;
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;

        If Assigned(cdsIteger) Then
          pIncluiIteger(cdsIteger, qryGen);

      End;
    End;

    If Assigned(cdsIteger) Then
      dtsIteger := cdsIteger
    Else
      dtsIteger := qryGen;

    With dtsIteGer Do
    Begin
      LParametrosCalcularPreComMenosDescForn :=
        TParametrosCalculoPreComMenosDescForn.New()
          .PrecoDeUltimaCompra(FieldByName('ITE_PREULT').AsFloat)
          .PrecoDeCompra(fieldbyname('ITE_PRECOM').AsFloat)
          .Desconto01(fieldbyname('ITE_DESF01').AsFloat)
          .Desconto02(fieldbyname('ITE_DESF02').AsFloat)
          .Desconto03(fieldbyname('ITE_DESF03').AsFloat)
          .Desconto04(fieldbyname('ITE_DESF04').AsFloat)
          .Desconto05(fieldbyname('ITE_DESF05').AsFloat)
          .Desconto06(fieldbyname('ITE_DESF06').AsFloat)
          .CalculoSubstituicaoOperacoesProprias(strCALSOP);

      Result := TFunctionFuncoesFaturamento.CalcularPreComMenosDescForn(LParametrosCalcularPreComMenosDescForn);
    End;

  Finally
    If Assigned(qryGen) Then
      FreeAndNil(qryGen);
  End;

End;

