function fExisteItemInativoNotaEntrada(strAutInc: string; var stlListaItensInativos: TStringList): boolean;
  var
    qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.SQL.Add('SELECT ITE_CODITE, ITE_DESITE');
    qryConsulta.SQL.Add('  FROM GERELE');
    qryConsulta.SQL.Add(' INNER JOIN DETELE ON DET_SEQGER = GERELE.AUTOINCREM');
    qryConsulta.SQL.Add(' INNER JOIN CADITE ON DET_CODITE = ITE_CODITE');
    qryConsulta.SQL.Add(' WHERE GERELE.AUTOINCREM = :AUTOINCREM');
    qryConsulta.SQL.Add('   AND ITE_ITEATI = "N"');
    qryConsulta.ParamByName('AUTOINCREM').AsString := strAutInc;

