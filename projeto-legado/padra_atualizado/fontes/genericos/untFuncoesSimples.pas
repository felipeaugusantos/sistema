function fRetSQLCadSemelhantes: String;
Begin
  Result := '';
  Result := Result + 'SELECT ';
  Result := Result + '  SEM_CODSEM, ';
  Result := Result + '  SEM_CODBAR, ';
  Result := Result + '  SEM_CODMAR, ';
  Result := Result + '  MAR_DESMAR, ';
  Result := Result + '  S.AUTOINCREM  ';
  Result := Result + 'FROM ';
  Result := Result + '  CADSEM S ';

  Result := Result + ' LEFT JOIN CADMAR ON MAR_CODMAR = SEM_CODMAR ';

  Result := Result + 'WHERE ';
  Result := Result + '  SEM_CODITE = :CODITE ';
  Result := Result + 'ORDER BY ';
  Result := Result + '  SEM_CODSEM ';
End;

Function fProcuraSemelhante(const strCodBar: String; Var strCodSem: String): Boolean;
  Var
    qryCadSem: TUniQuery;
Begin
  qryCadSem := fCriaQuery(nil);
  Try
    qryCadSem.SQL.Clear;
    qryCadSem.SQL.Add('SELECT');
    qryCadSem.SQL.Add('  SEM_CODITE ');
    qryCadSem.SQL.Add('FROM ');
    qryCadSem.SQL.Add('  CADSEM ');
    qryCadSem.SQL.Add('WHERE ');
    qryCadSem.SQL.Add('  SEM_CODBAR = :CODBAR ');
    qryCadSem.ParamByName('CODBAR').AsString := strCodBar;
    qryCadSem.Open;
    If qryCadSem.IsEmpty Then
    Begin
      strCodSem := '';
      Result := False;
    End Else
    Begin
      strCodSem := qryCadSem.FieldByName('SEM_CODITE').AsString;
      Result := True;
    End;
  Finally
    FreeAndNil(qryCadSem);
  End;
End;

function fPermiteInserirSomenteItemRetira(strCodIte,
                                          strCodEmp,
                                          strOpcDoc : String;
  blnRetira: Boolean): Boolean;
  Var
    strSQL: String;
    qryTmp: TUniQuery;
Begin
  Result := True;

  If Pos(strOpcDoc, 'PD_OR_VN_') <= 0 Then
    Exit;

  If Not fCfgSis('APERET', VarBoolean, strCodEmp) Then
    Exit;

  If blnRetira Then
    Exit;

  Try
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   ITE_APERET ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   ITEGER ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '   ITE_CODITE = :CODITE AND ';
    strSQL := strSQL + '   ITE_CODEMP = :CODEMP     ';

    qryTmp := fCriaQuery;

    With qryTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      If Not IsEmpty Then
      Begin
        If FieldByName('ITE_APERET').AsString = 'S' Then
          Result := False
        Else
          Result := True;
      End;
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fPermiteInserirSomenteItemRetira]');
    End;
  End;
End;

