procedure pSetButton(NomeTabela:TDataSet;btnNovo,btnConfirma,btnExclui,btnCancela,btnEditar,btnLocalizar,btnSair:TBitBtnLocked);
var
  LNomeForm: String;

  function retornaNomeForm(button: TBitBtnLocked): String;
  begin
    If Not fEmptyStr(LNomeForm) Then
      Exit(LNomeForm);

    If Assigned(button) Then
    Begin
      If Assigned(GetParentForm(button)) Then
        LNomeForm := GetParentForm(button).Name;
    End;

    Result := LNomeForm;
  end;
begin
  LNomeForm := EmptyStr;
  If Not Assigned(NomeTabela) Then
  Begin
    LNomeForm := retornaNomeForm(btnNovo);
    LNomeForm := retornaNomeForm(btnConfirma);
    LNomeForm := retornaNomeForm(btnExclui);
    LNomeForm := retornaNomeForm(btnCancela);
    LNomeForm := retornaNomeForm(btnEditar);
    LNomeForm := retornaNomeForm(btnLocalizar);
    LNomeForm := retornaNomeForm(btnSair);

    pGravarErro(True, 'pSetButton: NomeTabela nil' , 'Form Principal: '+LNomeForm, EmptyStr);
  End;

  pSetButton(NomeTabela.State,btnNovo,btnConfirma,btnExclui,btnCancela,btnEditar,btnLocalizar,btnSair);
end;

