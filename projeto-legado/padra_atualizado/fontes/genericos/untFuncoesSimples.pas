function fExisteAlgumDestinatarioSemEsseDireitoAcesso(strDirAce: String): Boolean;
  Var
    qryGen: TUniQuery;
begin
  Result := False;

  qryGen := fCriaQuery(Nil);
  Try
    qryGen.SQL.Add('SELECT       ');
    qryGen.SQL.Add('  COUNT(OPE_CODOPE) ');
    qryGen.SQL.Add('FROM         ');
    qryGen.SQL.Add('  CADOPE C   ');
    qryGen.SQL.Add('WHERE C.OPE_CODOPE <> :CODOPE           ');
    qryGen.SQL.Add('  AND C.OPE_MSGLIB = "S"                ');
    qryGen.SQL.Add('  AND C.OPE_STATUS <> "I"               ');
    qryGen.SQL.Add('  AND ((SELECT COUNT(0) FROM DIROPE D   ');
    qryGen.SQL.Add('         WHERE D.DIR_NOMFRM = :DIRACE AND D.OPE_CODOPE = C.OPE_CODOPE) = 0) ');
    qryGen.SQL.Add('  AND ((SELECT COUNT(0) FROM DIRGPO D                                       ');
    qryGen.SQL.Add('                       INNER JOIN CADGPO G ON G.GPO_CODGPO = D.GPO_CODGPO   ');
    qryGen.SQL.Add('                       INNER JOIN OPEGPO O ON O.GPO_CODGPO = G.GPO_CODGPO   ');
    qryGen.SQL.Add('         WHERE D.DIR_NOMFRM = :DIRACE AND O.OPE_CODOPE = C.OPE_CODOPE) = 0) ');

    qryGen.ParamByName('CODOPE').AsString := strLoginUsuarioLogado;
    qryGen.ParamByName('DIRACE').AsString := strDirAce;
    qryGen.Open;

    If (Not qryGen.IsEmpty) Then
      Result := qryGen.Fields[0].AsInteger > 0;
    qryGen.Close;
  Finally
    FreeAndNil(qryGen);
  End;
end;

