{-----------------------------------------------------------------------------
 Faz o mesmo que "SimpleRoundTo", porém divide pelo Fator, ao invés de Multiplicar.
 Isso evita Erro A.V. de estouro de Inteiro.
 Nota: Funcao copiada de SimpleRoundTo do Delphi Seatle
 -----------------------------------------------------------------------------}
function fSimpleRoundToEX(const AValue: Extended; const ADigit: TRoundToRange = -2): Extended;
var
  LFactor: Extended;
begin
  LFactor := IntPower(10.0, ADigit);
  if AValue < 0 then
    Result := Int((AValue / LFactor) - 0.5) * LFactor
  else
    Result := Int((AValue / LFactor) + 0.5) * LFactor;
end;

procedure pRedimensionarTelaSeguindoMenuIniciar(frmForm: TForm);
var
  Tasklist : HWnd;
  Bordered : TRect;
begin
  Tasklist := FindWindow('Shell_TrayWnd', nil);
  GetWindowRect(Tasklist, Bordered);

  If (Bordered.Height <= 0) Or (Bordered.Width <= 0) Then
  begin
    frmForm.Height := Screen.Height;
    frmForm.Width  := Screen.Width;
    Exit;
  end;

  if Bordered.Height < Bordered.Width then
  Begin
    frmForm.Height := Screen.Height-Bordered.Height;
    frmForm.Width  := Screen.Width;
  End
  Else
  Begin
    frmForm.Height := Screen.Height;
    frmForm.Width  := Screen.Width-Bordered.Width;
  End;
End;

function fGetCertificadoSerial(const ASerial: string): ICertificate2;
var
  LStore: IStore3;
  LContCertificado: Integer;
  LSig: ISigner;
  LSigData: ISignedData;
  LRetorno: ICertificate2;
begin
  Result := nil;
  LRetorno := nil;

  try
    CoInitialize(nil);
    Lstore := CoStore.Create;
    Lstore.Open(CAPICOM_CURRENT_USER_STORE, 'My', CAPICOM_STORE_OPEN_READ_ONLY);

    for LContCertificado := 1 to Lstore.Certificates.Count do
    begin
       if (Supports(LStore.Certificates[LContCertificado], ICertificate2, LRetorno)) then
       begin
          if (LRetorno.SerialNumber = ASerial) Then
          Begin
            LSig := CoSigner.Create;
            LSig.Certificate := LRetorno;

            LSigData := CoSignedData.Create;
            LSigData.Content := ' ';

            LSigData.Sign(LSig, False, CAPICOM_ENCODE_BASE64);
            Result := LRetorno;
            Exit;
          End;
       end;
    end;
  finally
    if Assigned(LStore) then
    begin
       LStore.Close;
       LStore := nil;
    end;
    CoUninitialize;
  end;
end;

function fGetCertificado: String;
var
  Store: IStore3;
  CertsLista, CertsSelecionado: ICertificates2;
  CertDados: ICertificate;
  lSigner: TSigner;
  lSignedData: TSignedData;

begin
  Try
  Store := CoStore.Create;
  Store.Open(CAPICOM_CURRENT_USER_STORE, 'My',CAPICOM_STORE_OPEN_MAXIMUM_ALLOWED);

  CertsLista := Store.Certificates as ICertificates2;
  CertsSelecionado := CertsLista.Select('Certificado(s) Digital(is) disponível(is)',
                                        'Selecione o Certificado Digital para uso no aplicativo', False);

  if not(CertsSelecionado.Count = 0) then
    begin
      CertDados := IInterface(CertsSelecionado.Item[1]) as ICertificate2;
      lSigner := TSigner.Create(Nil);
      lSigner.Certificate := CertDados;
      lSignedData := TSignedData.Create(Nil);
      lSignedData.Content := ' ';

      if CertDados.ValidFromDate > fNow() then
        begin
          showmessage('Certificado não liberado. aguardar ' + datetostr(CertDados.ValidFromDate));
          exit;
        end;

      if CertDados.ValidToDate < fNow() then
        begin
          showmessage('Certificado expirado');
          exit;
        end;

      lSignedData.Sign(lSigner.DefaultInterface, False, CAPICOM_ENCODE_BASE64);

      Result := UTF8ToString(UTF8Encode(CertDados.SerialNumber));

      lSignedData.Free;
      lSigner.Free;
    end;

  Except
    On E: Exception Do
    Begin
      If pos('cancelled by the user', E.Message) > 0 Then
        pMensagemOK('A operação solicitada foi cancelada pelo usuário')
      Else
        pMensagensErro(E.Message, '[fGetCertificado]');
    End;
  End;
end;

function fGrupoAtividadeFidelizado(strCodAti: String; strTipo: String): Boolean;
  Var
    qryGpaFid : TUniQuery;
begin
  qryGpaFid := fCriaQuery;
  Try
    qryGpaFid.Close;
    qryGpaFid.SQL.Clear;
    qryGpaFid.SQL.Add(' SELECT COUNT(*) CNT ');
    qryGpaFid.SQL.Add('   FROM GPAFID ');
    qryGpaFid.SQL.Add('   JOIN CADGAT ON GAT_CODGAT = FID_CODGPA ');
    qryGpaFid.SQL.Add('   JOIN CADATI ON ATI_CODGAT = GAT_CODGAT ');
    qryGpaFid.SQL.Add('  WHERE FID_CODEMP = :CODEMP ');
    qryGpaFid.SQL.Add('    AND FID_FISJUR = :FISJUR ');
    qryGpaFid.SQL.Add('    AND ATI_CODATI = :CODATI ');
    qryGpaFid.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGpaFid.ParamByName('FISJUR').AsString := strTipo;
