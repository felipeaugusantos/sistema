function fPermiteItemEspecial(strOpcDoc: String): Boolean;
begin
  Result := False;

  If (strOpcDoc = 'NE') Then
    Result := True;

  If (strOpcDoc = 'OR') Then
    Result := (Copy(fCfgSis('ITEESP', varString), 1, 1) = 'S');

  If (strOpcDoc = 'PD') Then
    Result := (Copy(fCfgSis('ITEESP', varString), 2, 1) = 'S');

  If (strOpcDoc = 'VN') Then
    Result := (Copy(fCfgSis('ITEESP', varString), 3, 1) = 'S');

  If (strOpcDoc = 'OU') Or (strOpcDoc = 'OE') Or (strOpcDoc = 'OF') Or (strOpcDoc = 'EF') Then
    Result := (Copy(fCfgSis('ITEESP', varString), 4, 1) = 'S');

  Result := Result And (Pos(strOpcDoc, LST_OPE_ITEESP) > 0);
end;

