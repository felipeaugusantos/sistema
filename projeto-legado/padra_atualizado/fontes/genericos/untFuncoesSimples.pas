procedure ReprocessarItensLocFisica(strCodLoc: String);
Var
  qryLocFis: TUniQuery;
begin
  qryLocFis := fCriaQuery();

  Try
    qryLocFis.SQL.Add('  SELECT                               ');
    qryLocFis.SQL.Add('    A.LOT_CODEMP,                      ');
    qryLocFis.SQL.Add('    A.LOT_CODITE                       ');
    qryLocFis.SQL.Add('  FROM                                 ');
    qryLocFis.SQL.Add('    CADLOT A                           ');
    qryLocFis.SQL.Add('    LEFT JOIN CADLOC B                 ');
    qryLocFis.SQL.Add('      ON B.LOC_CODLOC = A.LOT_LOCFIS   ');
    qryLocFis.SQL.Add('      AND B.LOC_CODEMP = A.LOT_CODEMP  ');
    qryLocFis.SQL.Add('  WHERE                                ');
    qryLocFis.SQL.Add('    B.LOC_CODLOC =:CODLOC              ');

    qryLocFis.ParamByName('CODLOC').AsString := strCodLoc;
    qryLocFis.Open;

    qryLocFis.First;
    While Not qryLocFis.Eof Do
    Begin
