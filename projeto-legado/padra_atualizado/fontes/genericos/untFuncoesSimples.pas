function fLotePickingBloqueado(const ACodIte: String): Boolean;
var
  LQry: TUniQuery;
begin
  Result := False;

  LQry := fCriaQuery;

  try
    LQry.SQL.Add('SELECT LOT_NUMLOT ');
    LQry.SQL.Add('FROM CADLOT ');
    LQry.SQL.Add('INNER JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS ');
    LQry.SQL.Add('                 AND LOT_CODEMP = LOC_CODEMP ');
    LQry.SQL.Add('WHERE LOT_CODITE = :CODITE ');
    LQry.SQL.Add('  AND LOT_CODEMP = :CODEMP ');
    LQry.SQL.Add('  AND IFNULL(LOC_PICKIN, "N") = "S" ');
    LQry.SQL.Add('  AND IFNULL(LOT_STATUS, "N") = "B" ');
    LQry.ParamByName('CODITE').AsString := ACodIte;
    LQry.ParamByName('CODEMP').AsString := VS_strCodEmp;
    LQry.Open;

    if LQry.IsEmpty then
      Exit;

    while not LQry.Eof do
    begin
      if (fRetornaSaldoDisponivel(ACodIte, False, True, LQry.FieldByName('LOT_NUMLOT').AsString) > 0) then
      begin
        Result := True;
        Exit;
      end;

      LQry.Next;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

function CorrigirQuebrasUnixParaWindows(const Texto: string): string;
begin
  // Primeiro remove os CRs que já estiverem antes dos LFs para evitar duplicar
  Result := StringReplace(Texto, #$D#$A, #$A, [rfReplaceAll]);

  // Agora substitui todos os LFs restantes por CR+LF
  Result := StringReplace(Result, #$A, #$D#$A, [rfReplaceAll]);
end;

function fDownloadArquivo(const url, dest: String): Boolean;
var
  intResult: Integer;
begin
  try
    intResult := URLDownloadToFile(nil, PChar(url), PChar(dest), 0, nil);
    Result := (intResult = S_OK);
    if not Result then
    begin
      case intResult of
        E_OUTOFMEMORY: fMensagem('Aviso', 'O comprimento do buffer é inválido ou não há memória suficiente para concluir a operação.', ['&O k']);
        INET_E_DOWNLOAD_FAILURE: fMensagem('Aviso', 'O recurso ou interface de retorno de chamada especificado era inválido.', ['&O k']);
       else
        fMensagem('Aviso', 'Erro desconhecido.', ['&O k']);
      end;
    end;
  except
    Result := False;
  end;
end;

function fRetNumeroEndereco(strEndereco: String): Integer;
var
  strNumero: String;
  intIndice: Integer;
begin
  Result := 0;
  strNumero := EmptyStr;

  strEndereco := Trim(strEndereco);
  if not fEmptyStr(strEndereco) then
  begin
    for intIndice := Length(strEndereco) downto 1 do
    begin
      if (not fEmptyStr(strNumero)) and (Trim(strEndereco[intIndice]) = EmptyStr) then
        Break;

      if CharInSet(strEndereco[intIndice], ['0'..'9']) then
        strNumero := strEndereco[intIndice] + strNumero;
    end;

    if fIsNumber(strNumero) then
      Result := StrToInt(strNumero);
  end;
end;

function fRemoverAtributoDoJson(const AstrJson, AstrAtributoRemover: String): String;
var
  JsonObject: TJSONObject;
  RemovedPair: TJSONPair;
begin
  Result := EmptyStr;

  JsonObject := TJSONObject.ParseJSONValue(AstrJson) as TJSONObject;
  try
    if Assigned(JsonObject) then
    begin
      RemovedPair := JsonObject.RemovePair(AstrAtributoRemover);
      try
        Result := JsonObject.ToJSON;

        if Assigned(RemovedPair) then
          FreeAndNil(RemovedPair)
      except
        if Assigned(RemovedPair) then
          FreeAndNil(RemovedPair);
      end;
    end;
  finally
    FreeAndNil(JsonObject);
  end;
end;

function fVerificaDocumentoFator(const AEmpDoc, AEspDoc, ANumDoc: String; var ADocOrig: TDocumentoFator): Boolean;
var
  LQuery : TUniQuery;
begin
  Result := False;

  LQuery := fCriaQuery;
  Try
    LQuery.SQL.Text := 'SELECT CONCAT(GER_NUMDOC,"-",GER_ESPDOC,"-",GER_CODEMP) AS NUMDOC    ' +
                       ' FROM CNFMNO                                                         ' +
                       ' INNER JOIN NOTGER AS NG ON MNO_SEQGER = NG.AUTOINCREM               ' +
                       ' WHERE MNO_EMPFAT = :MNO_EMPFAT                                      ' +
                       '   AND MNO_ESPFAT = :MNO_ESPFAT                                      ' +
                       '   AND MNO_NUMFAT = :MNO_NUMFAT                                      ';

    LQuery.ParamByName('MNO_EMPFAT').AsString := AEmpDoc;
    LQuery.ParamByName('MNO_ESPFAT').AsString := AEspDoc;
    LQuery.ParamByName('MNO_NUMFAT').AsString := ANumDoc;
    LQuery.Open;
    If Not LQuery.IsEmpty Then
    Begin
      ADocOrig.strNumDoc := LQuery.FieldByName('NUMDOC').AsString;
      Result := Not fEmptyStr(LQuery.FieldByName('NUMDOC').AsString);
    End;
  Finally
    FreeAndNil(LQuery);
  End;
