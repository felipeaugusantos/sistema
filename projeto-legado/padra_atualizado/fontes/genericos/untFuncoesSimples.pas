function fNumADCadastrado(strCodAde, strCodCli, strCodEmp: String): Boolean;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  COUNT(*) AS QTD ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  ADEDET ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  DET_CODADE = :CODADE ');

  If Not fEmptyStr(strCodCli) Then
    qryAux.SQL.Add('  AND DET_FORCLI = :CODCLI ');

  qryAux.SQL.Add('  AND DET_CODEMP = :CODEMP ');

  qryAux.ParamByName('CODADE').AsString := strCodAde;

  If Not fEmptyStr(strCodCli) Then
    qryAux.ParamByName('CODCLI').AsString := strCodCli;

  qryAux.ParamByName('CODEMP').AsString := strCodEmp;
  qryAux.Open;

  Result := (qryAux.FieldByName('QTD').AsInteger > 0);

  FreeAndNil(qryAux);
end;

