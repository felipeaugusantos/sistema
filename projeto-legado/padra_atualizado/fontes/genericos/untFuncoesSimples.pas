function fGetAuthorizationMaps: String;
Const
  ChaveAutorizacaoCitel = 'uLtr@-F!n&320147';
Var
  qryGen: TUniQuery;
  AUser, APass : String;
begin
  Result := '';

  qryGen := fCriaQuery;

  Try
    qryGen.SQL.Clear;
    qryGen.SQL.Add('SELECT ');
    qryGen.SQL.Add('  UNIX_TIMESTAMP(CURRENT_TIMESTAMP) * 1000 AS USERNAME, ');
    qryGen.SQL.Add('  MD5( ');
    qryGen.SQL.Add('    CONCAT( ');
    qryGen.SQL.Add('      UNIX_TIMESTAMP(CURRENT_TIMESTAMP) * 1000, ' + QuotedStr(ChaveAutorizacaoCitel) + ' ');
    qryGen.SQL.Add('    ) ');
    qryGen.SQL.Add('  ) AS PASSWORD');
