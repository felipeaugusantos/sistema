class function TFalhaCadastralDeMultiplosDescontosNaNota.Validar(
  const Parametros: TParametros): boolean;
begin
  if (not Parametros.CadastroCliente.OrgaoPublico.CalculaDescontoIcms) then
    Exit(True);

  if (not Parametros.CadastroCliente.DadosGerais.ZonaFranca) then
    Exit(True);

  if (not Parametros.CadastroCliente.DadosGerais.BeneficioREIDI) then
    Exit(True);

  pMensagemOk(strMENSAGEM_FALHA_CADASTRAL);
  Result := False;
end;

class function TFalhaCadastralDeMultiplosDescontosNaNota.Validar(
  const strCodCli: string): boolean;

  function fReflectionDatasetToParametro(objDataset: TDataSet): TParametros;
  const
    strSIM = 'S';
  begin
    result := TFalhaCadastralDeMultiplosDescontosNaNota.TParametros.Create; //MEM_OK
    result.CadastroCliente.DadosGerais.ZonaFranca := CompareText(objDataset.FieldByName('CLI_ZONFRA').AsString, strSIM) = 0;
    result.CadastroCliente.DadosGerais.BeneficioREIDI := CompareText(objDataset.FieldByName('CLI_BENREI').AsString, strSIM) = 0;
    result.CadastroCliente.OrgaoPublico.CalculaDescontoIcms := CompareText(objDataset.FieldByName('CLI_CALICM').AsString, strSIM) = 0;
    if objDataset.Active then
      objDataset.close;
  end;

  function fConsultaCadastroCliente: TUniQuery;
  begin
    result := fCriaQuery(); //MEM_OK
    result.SQL.Text :=
      ' SELECT CLI_CALICM,' + sLineBreak +
      '        CLI_ZONFRA,' + sLineBreak +
      '        CLI_BENREI' + sLineBreak +
      '   FROM CADCLI' + sLineBreak +
      '  WHERE CLI_CODCLI = :CODCLI';
    result.ParamByName('CODCLI').AsString := strCodCli;
    result.Open;
  end;

var
  qryConsultaCliente: TUniQuery;
  objParametros: TFalhaCadastralDeMultiplosDescontosNaNota.TParametros;

begin
  if Trim(strCodCli).IsEmpty then
    Exit(True);

  objParametros := nil;
  qryConsultaCliente := nil;
  try
    qryConsultaCliente := fConsultaCadastroCliente;
    objParametros := fReflectionDatasetToParametro(qryConsultaCliente);
    result := Validar(objParametros);
  finally
    if Assigned(qryConsultaCliente) then
      FreeAndNil(qryConsultaCliente);

    if Assigned(objParametros) then
      FreeAndNil(objParametros);
  end;
end;

