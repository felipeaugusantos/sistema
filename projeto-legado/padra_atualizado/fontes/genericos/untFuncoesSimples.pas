function fSQLDescricaoCompletaNCM(strAlias: String): String;
begin
  Result := '';
  Result := Result + ' CONCAT(IFNULL((SELECT CONCAT(N.NCM_DESCRI, " ")';
  Result := Result + '                  FROM CADNCM N ';
  Result := Result + '                 WHERE N.NCM_CODTRA = LEFT(' + strAlias + '.NCM_CODNCM, 4)';
  Result := Result + '                   AND IF(N.NCM_CODTRA = ' + strAlias + '.NCM_CODTRA, ' + strAlias + '.NCM_CODEXC = N.NCM_CODEXC, TRUE) LIMIT 1), ""),';
  Result := Result + ' IF(LENGTH(' + strAlias + '.NCM_CODNCM) >= 5, IFNULL((SELECT CONCAT(N.NCM_DESCRI, " ")';
  Result := Result + '                                         FROM CADNCM N';
  Result := Result + '                                        WHERE N.NCM_CODTRA = LEFT(' + strAlias + '.NCM_CODNCM, 5)';
  Result := Result + '                                          AND IF(N.NCM_CODTRA = ' + strAlias + '.NCM_CODTRA, ' + strAlias + '.NCM_CODEXC = N.NCM_CODEXC, TRUE) LIMIT 1), ""), "") ,';
  Result := Result + ' IF(LENGTH(' + strAlias + '.NCM_CODNCM) >= 6, IFNULL((SELECT CONCAT(N.NCM_DESCRI, " ")';
  Result := Result + '                                         FROM CADNCM N';
  Result := Result + '                                        WHERE N.NCM_CODTRA = LEFT(' + strAlias + '.NCM_CODNCM, 6)';
  Result := Result + '                                          AND IF(N.NCM_CODTRA = ' + strAlias + '.NCM_CODTRA, ' + strAlias + '.NCM_CODEXC = N.NCM_CODEXC, TRUE) LIMIT 1), ""), "") ,';
  Result := Result + ' IF(LENGTH(' + strAlias + '.NCM_CODNCM) >= 7, IFNULL((SELECT CONCAT(N.NCM_DESCRI, " ")';
  Result := Result + '                                         FROM CADNCM N';
  Result := Result + '                                        WHERE N.NCM_CODTRA = LEFT(' + strAlias + '.NCM_CODNCM, 7)';
  Result := Result + '                                          AND IF(N.NCM_CODTRA = ' + strAlias + '.NCM_CODTRA, ' + strAlias + '.NCM_CODEXC = N.NCM_CODEXC, TRUE) LIMIT 1), ""), "") ,';
  Result := Result + ' IF(LENGTH(' + strAlias + '.NCM_CODNCM) >= 8, IFNULL((SELECT CONCAT(N.NCM_DESCRI, " ")';
  Result := Result + '                                         FROM CADNCM N WHERE N.NCM_CODTRA = LEFT(' + strAlias + '.NCM_CODNCM, 8)';
  Result := Result + '                                          AND IF(N.NCM_CODTRA = ' + strAlias + '.NCM_CODTRA, ' + strAlias + '.NCM_CODEXC = N.NCM_CODEXC, TRUE) LIMIT 1), ""), ""))';
end;

