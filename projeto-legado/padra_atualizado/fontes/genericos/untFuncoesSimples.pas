function fFoiSelecionadoPedidoDeRemessaDePedidoComRemessaDeSeparacaoJaGerada(ANumDoc, AEspDoc, ACodEmp : String) : Boolean;
  var
    qryRemessa : TUniQuery;
begin

  Result := False;

  If ANumDoc.IsEmpty Then
    Exit;

  If AEspDoc.IsEmpty Then
    Exit;

  If ACodEmp.IsEmpty Then
    Exit;

  qryRemessa := fCriaQuery;

  Try

    qryRemessa.SQL.Add('SELECT');
    qryRemessa.SQL.Add('  COUNT(*) AS TOT');
    qryRemessa.SQL.Add('FROM');
    qryRemessa.SQL.Add('  FATGOR');
    qryRemessa.SQL.Add('  JOIN EXTGOR ON (EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM)');
