function fRetEstadoCliente(const strCodCli: string): string;
var
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Result := '';
  Try
    Try
      qryGen := fCriaQuery();
      qryGen.SQL.Text :=
        ' SELECT                           ' +
        '   CID_ESTADO                     ' +
        ' FROM                             ' +
        '   CADCLI                         ' +
        '   INNER JOIN CADCID              ' +
        '     ON CLI_CODCID = CID_CODCID   ' +
        ' WHERE CLI_CODCLI = :CODCLI       ';
      qryGen.ParamByName('CODCLI').AsString := strCodCli;
      qryGen.Open;

      if qryGen.IsEmpty then
        Result := ''
      else
        Result := qryGen.FieldByName('CID_ESTADO').AsString;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;


function fRetEstadoFornecedor(strCodFor: String): String;
  Var
    strSQL   : String;
    qryGenFor: TUniQuery;

Begin
  Try

    qryGenFor := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  CID_ESTADO ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADFOR ';
    strSQL := strSQL + '  INNER JOIN CADCID ON CID_CODCID = FOR_CODCID ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FOR_CODFOR = :CODFOR ';

    With qryGenFor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODFOR').AsString := strCodFor;
      Open;
      If IsEmpty Then
        Result := ''
      Else
        Result := FieldByName('CID_ESTADO').AsString;
      Close;
    End;

  Finally
    FreeAndNil(qryGenFor);
  End;

End;

