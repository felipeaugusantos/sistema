procedure HighlightCellText(AGrid: TDBGridCitel; const ARect: TRect;
  AColumn: TColumn; FilterText: string; AState: TGridDrawState; BkColor,
  SelectedBkColor, fnColor: TColor);
  var
    HlRect : TRect;
    Start : Integer;
    Position : Integer;
    HlText, DisplayText: string;
    offset : Integer;

  function FindText(subText, Text: String; Start: Integer = 0): Integer;
  begin
    Result := 0;

    Text    := fRemoveAcento(Text);
    subText := fRemoveAcento(subText);

    Text := Copy(Text, start, Length(Text));

    If Pos(subText, Text) > 0 Then
      Result := Start + Pos(subText, Text);
  end;

begin
  Start := 1;
  while True do
  begin
    DisplayText := Acolumn.Field.AsString;
    Position := FindText(AnsiLowerCase(FilterText), AnsiLowerCase(DisplayText), Start) -1;
    Start := Position + Length(FilterText);

    if Position <= 0 then
      Break;

    // set highlight area
    case AColumn.Alignment of
      TAlignment.taLeftJustify:  HlRect.Left := ARect.Left + AGrid.Canvas.TextWidth(Copy(DisplayText, 1, Position-1)) + 1;
      TAlignment.taRightJustify:
        begin
          Offset := AGrid.Canvas.TextWidth(Copy(DisplayText, 1,1)) - 1;
          HlRect.Left :=  (ARect.Right - AGrid.Canvas.TextWidth(DisplayText)-offset) + AGrid.Canvas.TextWidth(Copy(DisplayText, 1, Position-1));
        end;
      TAlignment.taCenter:
        begin
          Offset := ((ARect.Right - ARect.Left) div 2) - (AGrid.Canvas.TextWidth(DisplayText) div 2) - (AGrid.Canvas.TextWidth(Copy(DisplayText, 1,1)) - 2);
          HlRect.Left := (ARect.Right - AGrid.Canvas.TextWidth(DisplayText)- offset) + AGrid.Canvas.TextWidth(Copy(DisplayText, 1, Position-1));
        end;
    end;

    HlRect.Top := ARect.Top + 1;
    HlRect.Right := HlRect.Left +AGrid.Canvas.TextWidth(Copy(DisplayText, Position, Length(FilterText))) + 1 ;
    HlRect.Bottom := ARect.Bottom - 1;

    //check for  limit of the cell
    if HlRect.Right > ARect.Right then
      HlRect.Right := ARect.Right;

    // setup the color and draw the rectangle in a width of the matching text
    if gdSelected in AState then
      AGrid.Canvas.Brush.Color := SelectedBkColor
    else
      AGrid.Canvas.Brush.Color := BkColor;

    AGrid.Canvas.FillRect(HlRect);

    AGrid.Canvas.Font.Color := fnColor;

    HlText := Copy(DisplayText,Position, Length(FilterText));
    AGrid.Canvas.TextRect(HlRect,HlRect.Left + 1,HlRect.Top + 1, HlText);
  end;
end;

procedure pImportaCNFBCO(strCodBco, strCodEmp: String);
Var
  strPathFile,
  strChave,
  strCodBan,
  strCartei,
  strNumPos,
  strTipLay,
  strNomBan   : String;
  strConfig   : TStringList;
  strSecoes   : TStringList;
  listCFGBan  : TObjectList<TCfgBan>;
  CFGBan      : TCfgBan;
  CFGBanDao   : TCFGBanDao;
  i, j: Integer;
  iniCNFBCO   : TMemIniFile;
  qryRegistros: TUniQuery;
  FGravando : IObserver_;
  FSubject  : ISubject_;
  strParameter: array of String;

  LConfigValidar,
  LEmpresaValidar: String;

  LTotalCampos: Integer;

  function GetValCfg : String;
    Var
      FCodCfg : String;
  Begin
    Try
      Result := '';
      FCodCfg := Copy(strConfig.Strings[i], 1, Pos('=', strConfig.Strings[i])-1);

      If MatchStr(strCodBan, ['077','001','341']) Then
      Begin
        If MatchStr(FCodCfg, ['AUTHCRT','AUTHKEY','KEY_USER','AUTHORIZATION','CLIENT_ID','CLIENT_SECRET']) Then
        Begin
          Result := fCampoTabela('BCO_VALCFG','BCOAPI',
                                ['BCO_CHAVE_','BCO_CODBCO','BCO_CODCFG'],
                                [strSecoes[j],strCodBan,FCodCfg]);
        End;
      End;

    Finally
      Begin
        If fEmptyStr(Result) Then
          Result := Copy(strConfig.Strings[i], Pos('=', strConfig.Strings[i])+1, Length(strConfig.Strings[i]));
      End;
    End;
  End;

begin
  if Length(strCodBco) = 3 then
    strNomBan     := fRetNomeBancoSelec(strCodBco)
  else
    strNomBan     := fRetNomeBancoSelec(Copy(strCodBco,1,3));

  if strNomBan = '' then
  begin
    fMensagem('','Não foi possível importar as configurações do banco selecionado! Banco não cadastrado ou não configurado.', ['O k']);
    System.SysUtils.Abort;
  end;

  strPathFile := ExtractFilePath(Application.ExeName);

  If (Not AnsiEndsText('autban', strPathFile)) And (Not AnsiEndsText('autban\', strPathFile)) Then
    strPathFile := strPathFile + '\autban\';

  strPathFile :=  strPathFile + 'cnfbco.ini';

  strConfig := Nil;
  qryRegistros := Nil;
  strSecoes := Nil;

  CFGBanDao := Nil;
  listCFGBan := Nil;
  iniCNFBCO := Nil;

  Try
    if FileExists(strPathFile) then
    begin
      strSecoes   := TStringList.Create;

      iniCNFBCO   := TMemIniFile.Create(strPathFile);

      iniCNFBCO.ReadSections(strSecoes);

      for j := 0 to strSecoes.Count-1 do
      begin
        if (((Pos('CONFIG'+strCodBco, strSecoes[j]) > 0) and (Pos('-'+strCodEmp, strSecoes[j]) > 0)) or
            (Pos('PEFIN', strSecoes[j]) > 0) or
            ((Pos('CONFIGCTA'+strCodBco, strSecoes[j]) > 0) and (Pos('-'+strCodEmp, strSecoes[j]) > 0)) or
            ((Pos('CONFIGDDA'+strCodBco, strSecoes[j]) > 0) and (Pos('-'+strCodEmp, strSecoes[j]) > 0)) OR
            ((Pos('CONFIGPGG'+strCodBco, strSecoes[j]) > 0) and (Pos('-'+strCodEmp, strSecoes[j]) > 0))) then
        begin
          LTotalCampos := Length(strSecoes[j].Split(['-']));
          If LTotalCampos > 3 Then
            Continue;

          LConfigValidar := strSecoes[j].Split(['-'])[0];
          LEmpresaValidar := strSecoes[j].Split(['-'])[LTotalCampos - 1];


          If (Not LeftStr(LConfigValidar, 6).Equals('CONFIG')) And
             (Not LeftStr(LConfigValidar, 5).Equals('PEFIN')) Then
            Continue;

          If Length(LEmpresaValidar) <> 3 Then
            Continue;

          If LTotalCampos = 3 Then
          Begin
            If Not MatchStr(strSecoes[j].Split(['-'])[1], ['1', '2', '3', '4', '5']) Then
              Continue;
          End;

          If Assigned(strConfig) Then
            FreeAndNil(strConfig);
          strConfig   := TStringList.Create;

          iniCNFBCO.ReadSectionValues(strSecoes[j], strConfig);

          if strConfig.Count = 0 then
            Continue;

          strCodBan     := '';
          strCartei     := '';
          strNumPos     := '';
          strChave      := strSecoes[j];

          strChave := DeterminaBancoPosicoesLayout(strChave,
                                                   strCodban,
                                                   strNumPos,
                                                   strTipLay);

          if Pos('-', strChave) > 0 then
          begin
            strCartei := Copy(strChave, 1, 1);
            strChave   := StringReplace(strChave, strCartei, '', []);
            if strChave[1] = '-' then
              strChave := StringReplace(strChave, '-', '', []);
          end;

          FreeAndNilDatasets(qryRegistros);
          qryRegistros :=  fCriaQuery;

          qryRegistros.SQL.Text := '';
          qryRegistros.SQL.Text := ' SELECT * FROM CFGBAN ' +
                                   ' WHERE ' +
                                   '   SIS_CODEMP = :CODEMP AND ' +
                                   '   SIS_CODBAN = :CODBAN AND ' +
                                   '   SIS_CARTEI = :CARTEI AND ' +
                                   '   SIS_TIPLAY = :TIPLAY AND ' +
                                   '   SIS_CHAVE_ = :CHAVE_ AND ' +
                                   '   SIS_NUMPOS = :NUMPOS LIMIT 1';

          qryRegistros.ParamByName('CODEMP').AsString := strCodEmp;
          qryRegistros.ParamByName('CODBAN').AsString := strCodBan;
          qryRegistros.ParamByName('CARTEI').AsString := strCartei;
          qryRegistros.ParamByName('TIPLAY').AsString := strTipLay;
          qryRegistros.ParamByName('NUMPOS').AsString := strNumPos;
          qryRegistros.ParamByName('CHAVE_').AsString := strSecoes[j];
          qryRegistros.open;

          If Not qryRegistros.IsEmpty Then
            Continue;

          Try
            CFGBanDao   := TCFGBanDao.Create(strCodEmp, strCodBan, StrCartei, strNumPos, strTipLay);
            listCFGBan  := TObjectList<TCfgBan>.Create;

            FGravando := TGravandoObs.Create;
            FSubject  := TSubject.Create;
            FSubject.pAddObserver(FGravando);
           
            //Preparando array de parametros que será responsavel pelas notificações com o objeto observador.
            SetLength(strParameter,4);
            strParameter[0] := 'TcxProgressBar';
            strParameter[1] := IntToStr(strConfig.Count);
            strParameter[2] := 'Aguarde... Lendo Arquivo CNFBCO.INI.';

            //Enviando notificação que vai atualizar os observadores.
            FSubject.pNotify(strParameter);
            try
              for i := 0 to strConfig.Count-1 do
              begin
                //Atualizando os observadores
                strParameter[3] := IntToStr(i);
                FSubject.pNotify(strParameter);
               
                CFGBan        := TCfgBan.Create;
                CFGBan.CodEmp := strCodEmp;
                CFGBan.CodBan := StrCodBan;
                CFGBan.Descri := '';
                CFGBan.Banco_ := fRetNomeBancoSelec(StrCodBan);
                CFGBan.Cartei := strCartei;
                CFGBan.NumPos := strNumPos;
                CFGBan.UltAlt := fNow;
                CFGBan.CodOpe := strLoginUsuarioLogado;
                CFGBan.CodCFG := Copy(strConfig.Strings[i], 1, Pos('=', strConfig.Strings[i])-1);
                CFGBan.ValCFG := GetValCfg;
                CFGBan.Chave_ := strSecoes[j];
                CFGBan.TipLay := strTipLay;
                listCFGBan.Add(CFGBan);
              end;
            except
              on e: Exception do
              begin
                //Enviando a notificação para desalocar os observadores e destruir os objetos criados na memória
                strParameter[0] := 'Fechar';
                FSubject.pNotify(strParameter);
                Finalize(strParameter);

                fMensagem('', 'Ocorreu um erro ao importar o arquivo de configurações CNFBCO.ini' + #13 + 'Erro: ' + e.Message, ['&Ok']);
                Exit;
              end;
            end;

            //Enviando a notificação para desalocar os observadores e destruir os objetos criados na memória
            strParameter[0] := 'Fechar';
            FSubject.pNotify(strParameter);
            Finalize(strParameter);

            CFGBanDao.fInsertAll(listCFGBan);

            If strConfig.Count > 0 Then
            Begin
              If VS_ListaDeCarteiras <> nil Then
                VS_ListaDeCarteiras.Add(Concat('BCO', strCodBan, '_EMP', strCodEmp));
            End;
          Finally
            If Assigned(CFGBanDao) Then
              FreeAndNil(CFGBanDao);
            If Assigned(listCFGBan) Then
              FreeAndNil(listCFGBan);
          End;

          FSubject.pDeleteObserver(FGravando);
          FGravando := Nil;
          FSubject  := Nil;
        end;

      end;

    end;
  Finally
    If Assigned(iniCNFBCO) Then
      FreeAndNil(iniCNFBCO);

    If Assigned(strSecoes) Then
      FreeAndNil(strSecoes);

    If Assigned(strConfig) Then
      FreeAndNil(strConfig);

    FreeAndNilDatasets(qryRegistros);
  End;
end;

function fRetValorCampoBlob(ABlobField: TBlobField): string;
var
  LStream: TMemoryStream;
  LBytes: TBytes;
  LBinLen: Integer;
  LAnsi: AnsiString;
begin
  Result := 'null';

  If Not ABlobField.IsNull Then
  Begin
    LStream := TMemoryStream.Create;
    Try
      ABlobField.SaveToStream(LStream);
      LStream.Position := 0;

      SetLength(LBytes, LStream.Size);
      LStream.Read(LBytes, LStream.Size);

      LBinLen := Length(LBytes);
      SetString(LAnsi, PAnsiChar(LBytes), LBinLen);

      If LBinLen > 0 Then
      begin
        Result := '';
        SetLength(Result, LBinLen * 2);
        BinToHex(PAnsiChar(LAnsi), PChar(Result), LBinLen);
        Result := '_binary 0x' + Result;
      End;
    Finally
      FreeAndNil(LStream);
    End;
  End;
end;

