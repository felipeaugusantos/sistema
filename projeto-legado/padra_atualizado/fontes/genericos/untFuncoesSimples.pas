{**************************************}
{* CRIA UMA QUERYNOVA PARA SER USADA  *}
{* PS. ATE QUE ENFIM ALGUEM FEZ ISSO  *}
{***********************************AF*}
function fCriaQuery(AOwner: TComponent = Nil; Conexao: TUniConnection = nil): TUniQuery;
Var
  LConexao: TUniConnection;
Begin

  If Assigned(Conexao) Then
    LConexao := Conexao
  Else
    LConexao := frmModulo.GetCurrentConnection;

  TSafeCommit.CheckRemainsInTransaction(LConexao);

  Result := fCriaQueryFat(AOwner, LConexao);

  If Assigned(Result.Connection) Then
    Result.Tag := Result.Connection.Tag;

  If Assigned(untFuncoesSimples.VS_objTraceViewer) Then
    untFuncoesSimples.VS_objTraceViewer.SetQueryEvents(Result);

  if Assigned(ProcTracerContabilidadeSetQueryEvent) then
  begin
    ProcTracerContabilidadeSetQueryEvent(Result) ;
  end;

End;

function fCriaScript(AOwner: TComponent = Nil; Conexao: TUniConnection = nil): TUniScript;
Var
  LConexao: TUniConnection;
Begin
  If Assigned(Conexao) Then
    LConexao := Conexao
  Else
    LConexao := frmModulo.GetCurrentConnection;
  Result := TUniScript.Create(AOwner);
  Result.Connection := LConexao;
  Result.Tag := Result.Connection.Tag;
End;

procedure pBrowserNavigate(strURL: String);
const
  WM_UPDATE_URL = WM_USER + 1;  // Mensagem customizada para atualizar a URL
var
  strBrowser: String;
  BrowserHandle: HWND;
begin
  strBrowser := ExtractFilePath(Application.ExeName) + 'browser\CitelBrowser.exe';

  BrowserHandle := FindWindow(nil, 'Citel Browser');

  if BrowserHandle <> 0 then
  begin
    SendMessage(BrowserHandle, WM_UPDATE_URL, 0, LPARAM(PChar(strURL)));
    SetForegroundWindow(BrowserHandle);
  end
  else
  begin
    if FileExists(strBrowser) then
    WinExec(PAnsiChar(AnsiString(strBrowser + ' ' + strURL)), SW_SHOWMAXIMIZED)
    else
    ShellExecute(0, nil, PChar(strURL), nil, nil, SW_SHOWNORMAL);
  end;
End;

