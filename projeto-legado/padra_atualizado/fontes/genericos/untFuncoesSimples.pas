Function fGetChaveAcesso(const strNumDoc, strEspDoc, strCodCli, strCodEmp, strSerie: String; const strTipFC: String='C'; blnVerSitCan: Boolean=False): String;
  Var
    qryCadFis: TUniQuery;
Begin
  qryCadFis := fCriaQuery;
  Try
    With qryCadFis, SQL Do
    Begin
      Clear;
      Add('SELECT');
      Add('  IFNULL(FIS_ACESSO, "") AS FIS_ACESSO ');
      Add('FROM');
      Add('  CADFIS');
      Add('WHERE');
      Add('  FIS_NUMDOC = :NUMDOC AND ');
      Add('  FIS_CODEMP = :CODEMP AND ');
      Add('  FIS_FORCLI = :CODCLI AND ');
      Add('  FIS_ESPDOC = :ESPDOC AND ');
      Add('  FIS_TIP_FC = :TIP_FC     ');

      If Not fEmptyStr(strSerie) Then
        Add('  AND IFNULL(FIS_SERIE_,"") = :SERIE_');

      If blnVerSitCan Then
        Add('  AND IFNULL(FIS_SITCAN, "") NOT IN ("CA","IN","DE")');

      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('TIP_FC').AsString := strTipFC;
