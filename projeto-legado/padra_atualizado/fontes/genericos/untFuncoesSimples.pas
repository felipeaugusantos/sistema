function fApenasClaRet(strNumDoc: String;
                       strEspDoc: String;
                       strSerie: String;
                       strCliFor: String;
                       strCodEmp: String): Boolean;
var
  qryConsulta: TUniQuery;
  strClaRet: String;
begin
  qryConsulta := fCriaQuery;
  Try
     If fCfgSis('CLARET') = '' Then
       Exit(false);

    strClaRet := fTransform(fCfgSis('CLARET'), 4);

    qryConsulta.SQL.Add('SELECT DET_CLARET, DET_CLAFIS  from MOVDET');
    qryConsulta.SQL.Add('INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM');
    qryConsulta.SQL.Add('WHERE DET_NUMDOC = :DET_NUMDOC');
    qryConsulta.SQL.Add('  AND DET_ESPDOC = :DET_ESPDOC');
    qryConsulta.SQL.Add('  AND IFNULL(DET_SERIE_, "") = :DET_SERIE_');
    qryConsulta.SQL.Add('  AND DET_CODFOR = :DET_CODFOR');
    qryConsulta.SQL.Add('  AND DET_CODEMP = :DET_CODEMP');

    qryConsulta.ParamByName('DET_NUMDOC').AsString := strNumDoc;
    qryConsulta.ParamByName('DET_ESPDOC').AsString := strEspDoc;
    qryConsulta.ParamByName('DET_SERIE_').AsString := strSerie ;
    qryConsulta.ParamByName('DET_CODFOR').AsString := strCliFor;
    qryConsulta.ParamByName('DET_CODEMP').AsString := strCodEmp;

    qryConsulta.Open;
    Result := False;
    While not qryConsulta.Eof Do
    Begin
       result := ((qryConsulta.FieldByName('DET_CLARET').AsInteger = 1) and (Pos(qryConsulta.FieldByName('DET_CLAFIS').AsString, strClaRet) > 0));
       If Not result Then
         Break;
      qryConsulta.Next;
    End;
  Finally
    FreeAndNil(qryConsulta);
  End;
End;

function fRetornaSaldoAbertoCliente(strCodCli: String): Double;
  Var
    qryConsulta: TUniQuery;
    strSQL: String;
begin
  qryConsulta:= fCriaQuery(nil);

  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   SQL_NO_CACHE ';
  strSQL := strSQL + '   SUM(( ';
  strSQL := strSQL + '         CTR_VALDUP + IFNULL(CTR_JURSUJ, 0) + IFNULL(CTR_DESCOB, 0) - IFNULL(CTR_DESSUJ, 0) ' ;
  strSQL := strSQL + '      )) AS TOTABE ' ;
  strSQL := strSQL + ' FROM ' ;
  strSQL := strSQL + '   CADREC ' ;
  strSQL := strSQL + ' WHERE ' ;
  strSQL := strSQL + '       CTR_CODCLI = :CODCLI ' ;
  strSQL := strSQL + '   AND CTR_DTAREC IS NULL ' ;
  strSQL := strSQL + ' GROUP BY CTR_CODCLI ';

  Try
    with qryConsulta do
    begin
      SQL.Text := strSQL;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;
    end;
  Finally
    if not qryConsulta.IsEmpty then
      Result := qryConsulta.FieldByName('TOTABE').Value
    else
      Result := 0;

    qryConsulta.Close;
    FreeAndNil(qryConsulta);
  End

end;

