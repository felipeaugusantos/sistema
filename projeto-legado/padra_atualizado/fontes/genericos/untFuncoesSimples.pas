Function fCodCidPorCEP(strCEP : String): String; Overload;
Const
  SQL = 'SELECT         ' +
        '  D.CID_CODCID ' +
        'FROM           ' +
        '  endereco e   ' +
        '  INNER JOIN cidade c ON e.id_cidade = c.id_cidade  ' +
        '  LEFT  JOIN CADCID D ON e.id_cidade = D.CID_CODCOR ' +
        'WHERE ' +
        '  e.cep = :CEP';

Var
  qryCidade: TUniQuery;
Begin

  qryCidade := fCriaQuery(Nil);

  Try

    qryCidade.Close;
    qryCidade.SQL.Add(SQL);
    qryCidade.ParamByName('CEP').AsString := strCEP;
    qryCidade.Open;

    Result := IIF(Not qryCidade.IsEmpty, qryCidade.FieldByName('CID_CODCID').AsString, EmptyStr);

  Finally
    FreeAndNil(qryCidade);
  End;

End;

function fRetornaCodCidIBGE(strCodIbge: String; blnResolverConflitoDistritos: boolean = false): String;
  Var
    qryAux: TUniQuery;
    arrCidades : array of string;
    intCidadeEscolhida : integer;
begin
  Try
    qryAux := fCriaQuery;

    With qryAux Do
    Begin
      SQL.Add(' SELECT CID_CODCID, CID_NOMCID ');
      SQL.Add('  FROM CADCID ');
      SQL.Add(' WHERE CID_COIBGE = :CODIBG ');
      ParamByName('CODIBG').AsString := strCodIbge;
      Open;

      If Not IsEmpty Then
      begin
        Result := FieldByName('CID_CODCID').AsString;

        if (qryAux.RecordCount > 1) and (blnResolverConflitoDistritos) then
        begin
          SetLength(arrCidades, qryAux.RecordCount);

          qryAux.First;
          while not qryAux.Eof do
          begin
            arrCidades[qryAux.RecNo-1] := qryAux.FieldByName('CID_CODCID').AsString + ' - ' + qryAux.FieldByName('CID_NOMCID').AsString;
            qryAux.Next;
          end;

          intCidadeEscolhida := fGetMenu('IBGE com mais de um resultado, selecione:', arrCidades, 0);
          Result := LeftStr(arrCidades[intCidadeEscolhida-1], Length(qryAux.FieldByName('CID_CODCID').AsString));
        end;
      end
      Else
        Result := '';

      Close;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

function fVerificaUFCodIBGE(const strUf, strCodIbge: String): Boolean;
var
  qryIBGE: TUniQuery;
begin
  qryIBGE := fCriaQuery;

  try
    qryIBGE.Close;
    qryIBGE.SQL.Clear;
    qryIBGE.SQL.Add(' SELECT ');
    qryIBGE.SQL.Add('   COUNT(DISTINCT IBG_CODMUN)    QTD ');
    qryIBGE.SQL.Add(' FROM IBG_CADIBG ');
    qryIBGE.SQL.Add(' WHERE IBG_CODMUN = :CODMUN ');
    qryIBGE.SQL.Add('     AND IBG_UF = :UF; ');

    qryIBGE.ParamByName('CODMUN').AsString := strCodIbge;
    qryIBGE.ParamByName('UF').AsString := strUf;
    qryIBGE.Open;

    Result := qryIBGE.FieldByName('QTD').AsInteger > 0;
  finally
    FreeAndNil(qryIBGE);
  end;
end;

function fValidaCodigoIBGE(const strCodCid: String): Boolean;
var
  strCodIBGE: String;
  strUF_IBGE: String;
  strMensagem: String;
begin
  Result := True;

  strCodIBGE := fRetornaCodIBGE(strCodCid);
  strUF_IBGE := fRetNomCidade(strCodCid, 1);

  if (strUF_IBGE = 'EX') then
    exit;

  strMensagem := 'A cidade do Endereço de Entrega selecionado está sem o código ou com um código inválido do IBGE!';
  strMensagem := strMensagem + sLineBreak + 'Ajuste o cadastro da cidade para utilizar este endereço!';

  if Length(strCodIBGE) <> 7 then
    Result := False
  else if not fVerificaUFCodIBGE(strUF_IBGE, strCodIBGE) then
    Result := False
  else if not fVerificaCodIBGE(strCodIBGE) then
    Result := False;

  if not Result then
  begin
    fMensagem('Aviso', strMensagem, ['&Ok']);
  end;
end;

