    strSQL := strSQL + '  CND_CODIGO ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADCND ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CND_CNDPAG = :CNDPAG ';

    With qryGenCnd Do
