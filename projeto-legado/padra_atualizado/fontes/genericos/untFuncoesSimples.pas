function fPedidoCompraCadastrado(strNumPed, strCodEmp, strEspDoc: String;
  Var blnBonificacao, blnLiberado, blnConferido, blnBaixado, blnOriundo, blnImportacao, blnMaisDeUm: Boolean; Var strEmpDes,
  strEmpres, strCodFor, strPreNot, strAutInc: String; Var blnOriundoImportacaoNotaEletronica: Boolean; blnVerEmpDes: Boolean = False): Boolean;
  Var
    qryGen: TUniQuery;
begin
  Result := True;
  blnLiberado  := False;
  blnOriundo   := False;
  blnBaixado   := False;
  blnConferido := False;
  blnMaisDeUm  := False;
  strPreNot    := '';
  strAutInc    := '';

  qryGen := fCriaQuery;
  With qryGen, SQL Do
  Begin
    Add('SELECT ');
    Add('  PCG_CODEMP, ');
    Add('  PCG_PEDBON, ');
    Add('  PCG_ZERAST, ');
    Add('  IF(IFNULL(PCG_EMPDES,"") = "", PCG_CODEMP, PCG_EMPDES) AS PCG_EMPDES, ');
    Add('  PCG_DOCORI, ');
    Add('  PCG_DTALIB, ');
    Add('  PCG_BAIXAD, ');
    Add('  PCG_CODFOR, ');
    Add('  PCG_PEDLIB, ');

    Add('  (SELECT COUNT(1) PEL_SEQELE FROM PEDELE WHERE PEL_NUMDOC = PCG_NUMPED AND ');
    Add('                                                     PEL_CODEMP = PCG_CODEMP AND ');
    Add('                                                     PEL_ESPDOC = PCG_ESPDOC) AS PEL_SEQELE, ');
    {Add('  (SELECT GROUP_CONCAT(QUOTE(PEL_SEQELE)) FROM PEDELE WHERE PEL_NUMDOC = PCG_NUMPED AND ');
    Add('                                                     PEL_CODEMP = PCG_CODEMP AND ');
    Add('                                                     PEL_ESPDOC = PCG_ESPDOC) AS PEL_SEQELE, ');}

    Add('  PCG_OBS001, ');
    Add('  PCG_PEDIMP, ');
    Add('  G.AUTOINCREM  ');
    Add('FROM');
    Add('  PCMGER G');

    Add('WHERE');
    Add('  PCG_NUMCTN = 0 AND ');
    Add('  PCG_NUMPED = :NUMPED AND ');

    If blnVerEmpDes Then
      Add('  IF(IFNULL(PCG_EMPDES, "") = "", PCG_CODEMP = :CODEMP, PCG_EMPDES = :CODEMP) AND ')
    Else
      Add('  PCG_CODEMP = :CODEMP AND ');

    Add('  PCG_ESPDOC = :ESPDOC     ');
    Add(' ORDER BY PCG_BAIXAD       ');


    ParamByName('NUMPED').AsString := strNumPed;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('ESPDOC').AsString := strEspDoc;
    Open;

    strEmpres := '';
    If IsEmpty Then
      Result := False
    Else
    Begin
      blnMaisDeUm  := RecordCount > 1;
      blnLiberado  := Trim(FieldByName('PCG_PEDLIB').AsString) <> '';//REFERENTE A LIBERACAO DE PEDIDOS
      blnConferido := (Not FieldByName('PCG_DTALIB').IsNull);        //REFERENTE A CONFERENCIA DE PEDIDOS
      blnBaixado   := FieldByName('PCG_BAIXAD').AsInteger = 1;
      strCodFor    := FieldByName('PCG_CODFOR').AsString;
      strEmpres    := FieldByName('PCG_CODEMP').AsString;
      strEmpDes    := FieldByName('PCG_EMPDES').AsString;
      blnImportacao:= FieldByName('PCG_PEDIMP').AsString = 'S';
      strAutInc    := FieldByName('AUTOINCREM').AsString;
      blnBonificacao := FieldByName('PCG_PEDBON').AsString = 'S';
      If Not fEmptyStr(qryGen.FieldByName('PCG_OBS001').AsString) Then
      Begin
        If ((Pos('GERADO PELA IMPORTAÇÃO DE NOTA FISCAL ELETRÔNICA', qryGen.FieldByName('PCG_OBS001').AsString) > 0) Or
            (Pos('GERADO PELO FLUXO DE COMPRAS', qryGen.FieldByName('PCG_OBS001').AsString) > 0)) Then
          blnOriundoImportacaoNotaEletronica := True;
      End;

      If Not fEmptyStr(FieldByName('PCG_DOCORI').AsString) Then
      Begin
        If Pos('PD', FieldByName('PCG_DOCORI').AsString) <= 0 Then
          blnOriundo := True;
      End;

      If FieldByName('PEL_SEQELE').AsInteger > 0 Then
      Begin

        strPreNot := fRetNumerosPreNotas(strNumPed, strEspDoc, strCodEmp);

      End;

    End;

    Close;
  End;

  FreeAndNil(qryGen);

end;

