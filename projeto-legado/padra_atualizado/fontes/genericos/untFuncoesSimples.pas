    If Not qryGen.IsEmpty Then
    begin
      AUser  := qryGen.FieldByName('USERNAME').AsString;
      APass  := qryGen.FieldByName('PASSWORD').AsString;

      Result := fRetornaChaveBasic(AUser, APass);
