function fLoteChapa(strCodIte: String; strCodEmp: String; strNumLot: String; blnSoAtivos: Boolean = False): Boolean;
  Var
    qryCadLot: TUniQuery;
Begin
  Result := False;

  If fEmptyStr(strNumLot) Then
    Exit;

  Try
    qryCadLot := fCriaQuery(Nil);

    With qryCadLot, SQL Do
    Begin
      Add('SELECT ');
      Add('  LOT_NUMLOT ');
      Add('FROM ');
      Add('  CADLOT ');
      Add('WHERE ');
      Add('  LOT_NUMLOT = :NUMLOT AND ');
      Add('  LOT_CODITE = :CODITE AND ');
      Add('  LOT_CODEMP = :CODEMP AND');
      Add('  LOT_CHAPA_ = "S" ');


      If blnSoAtivos Then
        Add(' AND LOT_STATUS = "S"');

      Add('LIMIT 1 ');

      ParamByName('NUMLOT').AsString := strNumLot;
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      Result := Not IsEmpty;

      Close;
      FreeAndNil(qryCadLot);
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[fLoteChapa]');
  End;
End;

