function fTravarRegistroDoPix(qryFatGor: TUniQuery; ATravar: Boolean; blnPedidoPreviamenteTravado: Boolean = False): Boolean;
begin
  If Not Assigned(qryFatGor) Then
    Exit(True);

  If qryFatGor.IsEmpty Then
    Exit(True);

  If qryFatGor.FieldByName('FGO_TX_PIX').AsString.IsEmpty Then
    Exit(True);

  Result := fLock_Unlock('CONSULTA_RECEBIMENTO_PIX_' +
                         qryFatGor.FieldByName('FGO_TX_PIX').AsString,
                         ATravar,
                         False,
                         False,
                         '',
                         False,
                         '',
                         False,
                         blnPedidoPreviamenteTravado);
end;

function fBloqueiaPedido(qryFatGor: TUniQuery; blnPedidoPreviamenteTravado: Boolean = False): Boolean;
var
  strDocTra, strEspTra, strEmpTra, strCliTra, strOrdTra: String;
begin
  Result := True;

  strDocTra := qryFatGor.FieldByName('FGO_NUMDOC').AsString;
  strEspTra := qryFatGor.FieldByName('FGO_ESPDOC').AsString;
  strEmpTra := qryFatGor.FieldByName('FGO_CODEMP').AsString;
  strCliTra := qryFatGor.FieldByName('FGO_CODCLI').AsString;

  strOrdTra := fRetNumOrdProAssociado(strDocTra, strEspTra, strEmpTra);

  If Not fLock_Unlock( 'FATGOR' + strDocTra +
                                  strEspTra +
                                  strEmpTra, True, False, False, '', True, '', False, blnPedidoPreviamenteTravado) Then
  Begin
    fMensagem('', 'Esse Documento está sendo utilizado em Outra Estação por ' +
                  fGetHostLock('FATGOR' + strDocTra + strEspTra + strEmpTra)  + '!', ['&Ok']);
    Result := False;
    Exit;
  End;

  If Not fLock_Unlock( 'CADREC' + strDocTra +
                                  strEspTra +
                                  strEmpTra +
                                  strCliTra, True, False, False, '', True, '', False, blnPedidoPreviamenteTravado ) Then
  Begin
    fMensagem('', 'Esse Documento está sendo utilizado em Outra Estação por ' +
                  fGetHostLock('CADREC' + strDocTra + strEspTra + strEmpTra + strCliTra)  + '!', ['&Ok']);
    Result := False;
    Exit;
  End;

  If (Not strOrdTra.IsEmpty) Then
  Begin
    If Not fLock_Unlock('ORDPRO_' + strOrdTra + '_' + VS_strCodEmp, True, False, False, '', True, '', False, blnPedidoPreviamenteTravado) Then
    Begin
      fMensagem('', 'A ordem de produção '+ strOrdTra +', associada a esse documento, está sendo utilizado em outra estação por ' +
                    fGetHostLock('ORDPRO_' + strOrdTra + '_' + VS_strCodEmp) + '!', ['&Ok']);
      Result := False;
      Exit;
    End;
  End;

  If Not fTravarRegistroDoPix(qryFatGor, True, blnPedidoPreviamenteTravado) Then
  Begin
    fMensagem('ATENÇÃO', 'O Pix desse pedido está sendo utilizado em Outra Estação por ' +
                           fGetHostLock('CONSULTA_RECEBIMENTO_PIX_' + qryFatGor.FieldByName('FGO_TX_PIX').AsString) + '!', ['&Ok']);
    Result := False;
  End;
end;

procedure pLiberaBloqueioPedido(qryFatGor: TUniQuery);
var
  strDocTra, strEspTra, strEmpTra, strCliTra, strOrdTra: String;
begin
  If Not Assigned(qryFatGor) Then
    Exit;

  If qryFatGor.IsEmpty Then
    Exit;

  strDocTra := qryFatGor.FieldByName('FGO_NUMDOC').AsString;
  strEspTra := qryFatGor.FieldByName('FGO_ESPDOC').AsString;
  strEmpTra := qryFatGor.FieldByName('FGO_CODEMP').AsString;
  strCliTra := qryFatGor.FieldByName('FGO_CODCLI').AsString;

  strOrdTra := fRetNumOrdProAssociado(strDocTra, strEspTra, strEmpTra);

  fLock_Unlock( 'FATGOR' + strDocTra +
                           strEspTra +
                           strEmpTra, False, False );

  fLock_Unlock( 'CADREC' + strDocTra +
                           strEspTra +
                           strEmpTra +
                           strCliTra, False, False );

  fTravarRegistroDoPix(qryFatGor, False);

  If (Not strOrdTra.IsEmpty) Then
    fLock_Unlock('ORDPRO_' + strOrdTra + '_' + VS_strCodEmp, False, False);
end;

function fPedidoOrcamentoExclusivoOutraLoja(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  qryGen: TUniQuery;
begin
  Result := False;

  If (strCodEmp <> VS_strCodEmp) Then
  Begin
    qryGen := fCriaQuery;
    Try
      With qryGen Do
      Begin
        Close;
        SQL.Add(' SELECT ');
        SQL.Add('   IF(IFNULL(FGO_ENT_CD, "") = "S", FGO_EMP_CD, ');
        SQL.Add('     IF(IFNULL(FGO_EMP_TE, "") <> "", FGO_EMP_TE, FGO_CODEMP)) AS CODEMP ');
        SQL.Add(' FROM FATGOR ');
        SQL.Add('      LEFT JOIN EXTGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO    ');
        SQL.Add(' WHERE FGO_NUMDOC = :NUMDOC ');
        SQL.Add('   AND FGO_ESPDOC = :ESPDOC ');
        SQL.Add('   AND FGO_CODEMP = :CODEMP ');

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;

        Open;

        If Not IsEmpty Then
        Begin
          Result := FieldByName('CODEMP').AsString <> VS_strCodEmp;
        End;
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

Function fPedidoTemSomenteItensParaEmpresasCD(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryFatDor: TUniQuery;
Begin
  qryFatDor := fCriaQuery;

  With qryFatDor, SQL Do
  Begin
    Clear;
    Add('SELECT DISTINCT FDO_EMPITE ');
    Add('FROM FATDOR ');
    Add('WHERE');
    Add('  FDO_NUMDOC = :NUMDOC AND');
    Add('  FDO_ESPDOC = :ESPDOC AND');
    Add('  FDO_CODEMP = :CODEMP    ');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;

    Open;

    Result := Not IsEmpty;

    First;

    While Not EOF Do
    Begin
      If Not fEhEmpresaCD(FieldByName('FDO_EMPITE').AsString) Then
      Begin
        Result := False;
        Break;
      End;
      Next;
    End;

    First;

    Close;
  End;

  FreeAndNil(qryFatDor);
End;

