function fGuardarItensSeparadosQuandoUtilizarLocTransitoriaVAGAO(const ACodEmp: String = ''): Boolean;
var
  LCodEmp: String;
begin
  Result := False;

  LCodEmp := IIF(fEmptyStr(ACodEmp), VS_strCodEmp, ACodEmp);

  if (not fCfgSis('BXSLSE', varBoolean, LCodEmp)) then
    Exit;

  if (not fCfgSis('GDPDCN', varBoolean, LCodEmp)) then
    Exit;

  if (not fCfgSis('BAISEP', varBoolean, LCodEmp)) then
    Exit;

  if fUsaOndaSeparacaoAgrupamento(LCodEmp) then
