function fRetornaTipoDoCampo( strTabela: string = ''; strCampo: string = '' ) : String;
Var
  qryAux: TUniQuery;
Begin
  if (strTabela = '') Then
    Result := '';
  if (strCampo = '') Then
    Result := '';
  if (strTabela <> '') And (strCampo <> '') Then
  Begin
    qryAux := fCriaQuery(Nil);
    qryAux.SQL.Text := 'DESC ' + strTabela;
    qryAux.Open;
    While (Not qryAux.Eof) Do
    Begin
      If ( qryAux.FieldByName('Field').AsString = strCampo ) Then
        Result := UpperCase(qryAux.FieldByName('Type').AsString);
      qryAux.Next;
    End;
    FreeAndNil(qryAux);
  End;
End;

function fRetornaChaveAcesso(strNumDoc, strEspDoc,
  strCodEmp, strCodCli, strSerie, strTip_FC: String; Var strNumSer: String; conexao: TUniConnection = nil): String;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(nil, conexao);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  FIS_ACESSO, ');
  qryAux.SQL.Add('  FIS_NUMSER ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADFIS ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  FIS_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  FIS_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  FIS_CODEMP = :CODEMP AND ');
  qryAux.SQL.Add('  FIS_FORCLI = :FORCLI AND ');
  qryAux.SQL.Add('  IFNULL(FIS_SERIE_, "") = :SERIE_ AND ');
  qryAux.SQL.Add('  FIS_TIP_FC = :TIP_FC ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCodEmp;
  qryAux.ParamByName('FORCLI').AsString := strCodCli;
  qryAux.ParamByName('SERIE_').AsString := strSerie;
  qryAux.ParamByName('TIP_FC').AsString := strTip_FC;
  qryAux.Open;

  Result := qryAux.FieldByName('FIS_ACESSO').AsString;
  strNumSer := qryAux.FieldByName('FIS_NUMSER').AsString;

  FreeAndNil(qryAux);
end;

