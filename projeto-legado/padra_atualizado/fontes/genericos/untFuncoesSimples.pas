function fCfgSis(strCamCfg: String; varTipVar: TVarType = varString; strCodEmp: String = ''): Variant;
Begin

  If SameText('EMPMAT', strCamCfg) Then
  Begin
    Result := '';

    If fCfgSisL('INFMAT', varBoolean, '', dicConfiguracoes) Then
      Result := fRetEmpresaMatrizDoGrupo(VS_strCodEmp);

    If fEmptyStr(Result) Then
      Result := fCfgSisL(strCamCfg, varTipVar, strCodEmp, dicConfiguracoes);

  End

  Else If Pos(strCamCfg, 'CFG_ATPVMB-CFG_ATPVM2-CFG_ATPVM3-CFG_ATPVM4-CFG_ATPVM5-CFG_ATPVM6-CFG_ATPVM7-CFG_VENMAR') > 0 Then
  Begin

    If fCfgSisL('BLOPRE', varBoolean, strCodEmp, dicConfiguracoes) Then
    begin

      If Pos(strCamCfg, 'CFG_ATPVMB-CFG_ATPVM2-CFG_ATPVM3-CFG_ATPVM4-CFG_ATPVM5-CFG_ATPVM6-CFG_ATPVM7') > 0 Then
        Result := 'M'
      Else
        Result := 2;

    End Else
    Begin

      Result := fCfgSisL(strCamCfg, varTipVar, strCodEmp, dicConfiguracoes);

    End;

  End Else
  Begin
    Result := fCfgSisL(strCamCfg, varTipVar, strCodEmp, dicConfiguracoes);

    If SameText('CORZEB', strCamCfg) And fEmptyStr(Result) Then
      Result := clWhite;
  End;
End;

function fCfgSpd(strCamCfg: String; strCodEmp: String = ''): String;
var
  qryCfgSpd: TUniQuery;
begin
  try
    qryCfgSpd := fCriaQuery;
    qryCfgSpd.Close;
    qryCfgSpd.SQL.Clear;
    qryCfgSpd.SQL.Add('SELECT SPD_VALCFG FROM CFGSPD WHERE SPD_CODCFG = :CODCFG AND SPD_CODEMP = :CODEMP');
    qryCfgSpd.ParamByName('CODCFG').AsString := strCamCfg;
    qryCfgSpd.ParamByName('CODEMP').AsString := IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);
    qryCfgSpd.Open;
    if not qryCfgSpd.IsEmpty then
      Result := qryCfgSpd.FieldByName('SPD_VALCFG').AsString
    else
      Result := '';
  finally
    FreeAndNil(qryCfgSpd);
  end;
end;

function fGetTransfEstoque(strNumDoc, strCodCli : String): TTransferencia;
var
  qrTemp: TUniQuery;
  strCodEmp: String;
begin
  Result.NumDoc := '';
  Result.TipDoc := '';
  Result.EmpDoc := '';

  qrTemp := fCriaQuery;
  try
    qrTemp.Close;
    qrTemp.SQL.Clear;
    qrTemp.SQL.Add('SELECT EMP_CODEMP FROM CADEMP WHERE EMP_FORFIL = :CODFOR');
    qrTemp.ParamByName('CODFOR').AsString := strCodCli;
    qrTemp.Open;

    If Not qrTemp.IsEmpty Then
    Begin
      strCodEmp := qrTemp.FieldByName('EMP_CODEMP').AsString;
      qrTemp.Close;
      qrTemp.SQL.Clear;
      qrTemp.SQL.Add('SELECT GER_TIPFAT,GER_NUMFAT,GER_EMPFAT '+
                     'FROM MOVGER '+
                     'WHERE GER_NUMDOC = :NUMDOC '+
                     '  AND GER_CODEMP = :EMPDOC '+
                     '  AND GER_ESPDOC = ''TE'' '+
                     '  AND GER_TIP_FC = ''C''');
      qrTemp.ParamByName('NUMDOC').AsString := strNumDoc;
      qrTemp.ParamByName('EMPDOC').AsString := strCodEmp;
      qrTemp.Open;
      If Not qrTemp.IsEmpty Then
      Begin
        Result.NumDoc := qrTemp.FieldByName('GER_NUMFAT').AsString;
        Result.TipDoc := qrTemp.FieldByName('GER_TIPFAT').AsString;
        Result.EmpDoc := qrTemp.FieldByName('GER_EMPFAT').AsString;
      end;
    End;
  finally
    FreeAndNil(qrTemp);
  end;
end;

