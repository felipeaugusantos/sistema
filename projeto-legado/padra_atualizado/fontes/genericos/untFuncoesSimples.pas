function fRetornarDefeitosOrdemServico(strNumOse, strCodEmp: String): String;
  Var
    qryTemp: TUniQuery;
begin
  Result  := '';
  qryTemp := fCriaQuery();

  Try
    If (Not fEmptyStr(strNumOse)) Then Begin
      qryTemp.Close();
      qryTemp.SQL.Clear();
      qryTemp.SQL.Add('SELECT EQU_DESDFE FROM EQUDFE WHERE EQU_NUMOSE = :NUMOSE AND EQU_CODEMP = :CODEMP');
      qryTemp.ParamByName('NUMOSE').AsString := strNumOse;
      qryTemp.ParamByName('CODEMP').AsString := strCodEmp;
      qryTemp.Open();
      qryTemp.First();

      If (Not qryTemp.IsEmpty) Then Begin
        While (Not qryTemp.Eof) Do Begin
          Result := Result + qryTemp.FieldByName('EQU_DESDFE').AsString + ' / ';
          qryTemp.Next();
        End;

        Result := Copy(Result, 1, Length(Result) - 3);
      End;
    End;

    If (fEmptyStr(Result)) Then
      Result  := 'Defeito(s) não informado(s).';
  Finally
    FreeAndNil(qryTemp);
  End;

end;

function fCpfToEstadoEmissao(strCGCCPF, strCPF : String):String;
  var
    chrDigEst: Char;
Begin
  Result := '';
  If (strCGCCPF = '2') And fValidaCPF(strCPF) Then
  Begin
    chrDigEst := strCPF[9];

    Case chrDigEst Of
      '0': Result := fRetNomeEstado('RS');
      '1': Result := 'DF/GO/MT/MS/TO';
      '2': Result := 'AC/AP/AM/RO/RR/PA';
      '3': Result := 'CE/PI/MA';
      '4': Result := 'AL/PB/PE/RN';
      '5': Result := 'BA/SE';
      '6': Result := fRetNomeEstado('MG');
      '7': Result := 'ES/RJ';
      '8': Result := fRetNomeEstado('SP');
      '9': Result := 'PR/SC';
    End;
  End;
End;

