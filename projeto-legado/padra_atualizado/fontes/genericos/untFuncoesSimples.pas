function fCadRecCIQuitado(strTabCnf: String; Var strMensagem: String): Boolean;
  Var
    qryDocCnf : TUniQuery;
    qryTmpRec : TUniQuery;
Begin

  Result := False;

  Try
    qryDocCnf := fCriaQuery(Nil);
    qryTmpRec := fCriaQuery(Nil);
    strMensagem := '';

    With qryDocCnf Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODCLI ');
      SQL.Add('   FROM ' + strTabCnf );
      SQL.Add('  WHERE TMP_ESPDOC = "IF" ');
      SQL.Add('  GROUP BY TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODCLI ');
      Open;

      qryTmpRec.Close;
      qryTmpRec.SQL.Clear;
      qryTmpRec.SQL.Add(' SELECT AUTOINCREM ');
      qryTmpRec.SQL.Add('   FROM CADREC ');
      qryTmpRec.SQL.Add('  WHERE CTR_NUMDUP = :NUMDOC ');
      qryTmpRec.SQL.Add('    AND CTR_ESPDOC = :ESPDOC ');
      qryTmpRec.SQL.Add('    AND CTR_CODEMP = :CODEMP ');
      qryTmpRec.SQL.Add('    AND CTR_CODCLI = :CODCLI ');
      qryTmpRec.SQL.Add('    AND CTR_SEQBAI = 0 ');
      qryTmpRec.SQL.Add('    AND CTR_VALDUP = 0.00 ');
      qryTmpRec.SQL.Add('    AND IFNULL(CTR_DTAREC,0) <> 0 ');
      // CTR QUITADO

      First;
      While Not Eof Do
      Begin

        qryTmpRec.Close;
        qryTmpRec.ParamByName('NUMDOC').AsString := FieldByName('TMP_NUMDOC').AsString;
        qryTmpRec.ParamByName('ESPDOC').AsString := FieldByName('TMP_ESPDOC').AsString;
        qryTmpRec.ParamByName('CODEMP').AsString := FieldByName('TMP_CODEMP').AsString;
        qryTmpRec.ParamByName('CODCLI').AsString := FieldByName('TMP_CODCLI').AsString;
        qryTmpRec.Open;

        Result := (qryTmpRec.RecordCount > 0);

        If (Not Result) Then
        Begin
          strMensagem := 'DOCUMENTO: ' + FieldByName('TMP_NUMDOC').AsString + '-'
                                       + FieldByName('TMP_ESPDOC').AsString + '-'
                                       + FieldByName('TMP_CODEMP').AsString + ' EM ABERTO. ';
          Break;
        End;

        Next;
      End;
    End;

  Finally
    qryDocCnf.Close;
    qryTmpRec.Close;
    FreeAndNil(qryDocCnf);
    FreeAndNil(qryTmpRec);
  End;
End;

