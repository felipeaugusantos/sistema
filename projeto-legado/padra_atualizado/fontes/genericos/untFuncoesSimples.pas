function fRetornaSaldoFisico(strCodIte: String;
                             blnFaturamento: Boolean = True;
                             strNumLot: String = '';
                             strCodEmp: String = '';
                             blnIgnorarLote: Boolean = False): Double;
  Var
    fltSaldos,
    fltEntPre,
    fltEntFal,
    fltEntAgu: Double;
begin
  If fEmptyStr(strCodEmp) Then
    strCodEmp := VS_strCodEmp;

  fltSaldos := fRetSaldosEmpresa(strCodIte, strCodEmp, strNumLot, blnIgnorarLote);
  fltEntPre := 0.00;
  fltEntFal := 0.00;
  fltEntAgu := 0.00;

  If fCfgSis('ENTFUT', varBoolean, strCodEmp) Then
  Begin
    fltEntPre := TEntregaFutura.New(
                   TParamEF.New()
                     .CodIte(strCodIte)
                     .CodEmp(strCodEmp)
                     .Faturamento(blnFaturamento)
                     .TipoEF(tefPrevisao)
                     .TipoTE(tteNenhuma)
                     .Lote(strNumLot)
                   ).Total();

    fltEntFal := TEntregaFutura.New(
                   TParamEF.New()
                     .CodIte(strCodIte)
                     .CodEmp(strCodEmp)
                     .Faturamento(blnFaturamento)
                     .TipoEF(tefFaltaDeProduto)
                     .TipoTE(tteNenhuma)
                     .Lote(strNumLot)
                   ).Total();

    fltEntAgu := TEntregaFutura.New(
                   TParamEF.New()
                     .CodIte(strCodIte)
                     .CodEmp(strCodEmp)
                     .Faturamento(blnFaturamento)
                     .TipoEF(tefAguardandoCliente)
                     .TipoTE(tteNenhuma)
                     .Lote(strNumLot)
                   ).Total();
  End;

  Result := fltSaldos + fltEntPre + fltEntFal + fltEntAgu;
end;

function fRetornaSaldoLibCom(strCodIte: String; strNumLot: String = ''; strCodEmp: String = ''): Double;
var
  qrySelect: TUniQuery;
  strSql: String;
begin
  If fEmptyStr(strCodEmp) Then
    strCodEmp := VS_strCodEmp;

  strSql := '';  
  strSql := strSql + 'SELECT SUM(FDO_QTDITE) AS QTDITE ';
  strSql := strSql + 'FROM FATDOR ';
  strSql := strSql + 'INNER JOIN FATGOR ON FDO_SEQGER = FATGOR.AUTOINCREM ';
  strSql := strSql + 'INNER JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM ';
  strSql := strSql + 'WHERE FDO_CODITE = :CODITE ';
  strSql := strSql + '  AND FDO_CODEMP = :CODEMP ';
  strSql := strSql + '  AND FDO_ESPDOC = "PD" ';
  strSql := strSql + '  AND FGO_JAFATU = 0 ';
  strSql := strSql + '  AND FGO_LIBCOM = 1 ';
  strSql := strSql + '  AND FDO_JAFATU = 0 ';
  strSql := strSql + '  AND IFNULL(FGO_DOCEND, "") = "" ';
  if not fEmptyStr(strNumLot) then
    strSql := strSql + '  AND FDO_NUMLOT = :NUMLOT ';

  qrySelect   := fCriaQuery;
  try
    qrySelect.SQL.Text := strSql;
    qrySelect.ParamByName('CODITE').AsString := strCodIte;
    qrySelect.ParamByName('CODEMP').AsString := strCodEmp;
    if not fEmptyStr(strNumLot) then
      qrySelect.ParamByName('NUMLOT').AsString := strNumLot;
    
    qrySelect.Open;
    Result := qrySelect.FieldByName('QTDITE').AsFloat;
    
  finally
    FreeAndNil(qrySelect);
  end

end;

