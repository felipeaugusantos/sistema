function fReverterDEL(const AstrTabela: String;
                      const arrCampoChave: Array Of String;
                      const arrValorChave: Array Of Variant): Boolean;
var
  qryRevert: TUniQuery;
  strColunas: String;
  strSqlCampoChave: String;
  intCount: Integer;
  blnIniciaTransacao: Boolean;
begin
  Result := True;
  strSqlCampoChave := EmptyStr;

  blnIniciaTransacao := not fInTransaction;
  if blnIniciaTransacao then
    fStartTransaction;

  qryRevert := fCriaQuery;
  try
    try
      qryRevert.Close;
      qryRevert.SQL.Text :=
      ' SELECT '+
      '   GROUP_CONCAT(DISTINCT COLUMN_NAME SEPARATOR ",") AS COLUNAS '+
      ' FROM '+
      '   INFORMATION_SCHEMA.COLUMNS '+
      ' WHERE '+
      '   TABLE_NAME = :TABELA AND'+
      '   TABLE_SCHEMA = :BANCO ';

      qryRevert.ParamByName('TABELA').AsString := ReplaceStr(AstrTabela, 'DEL_', EmptyStr);
      qryRevert.ParamByName('BANCO').AsString := fArqIni(0, 'BANCO', 'NOMBAN', '');
      qryRevert.Open;

      if qryRevert.IsEmpty then
        Exit(False);

      strColunas := qryRevert.FieldByName('COLUNAS').AsString;

      for intCount := 0 to High(arrCampoChave) do
        strSqlCampoChave := strSqlCampoChave + IIF(not fEmptyStr(strSqlCampoChave), ' AND ', EmptyStr) + arrCampoChave[intCount] + ' = :'+arrCampoChave[intCount];

      qryRevert.Close;
      qryRevert.SQL.Text :=
      ' INSERT INTO '+ReplaceStr(AstrTabela, 'DEL_', EmptyStr)+
      '   ( '+strColunas+')'+
      ' SELECT '+
          strColunas+
      ' FROM '+
          AstrTabela+
      ' WHERE '+
          strSqlCampoChave;

      for intCount := 0 to High(arrValorChave) do
        qryRevert.ParamByName(arrCampoChave[intCount]).Value := arrValorChave[intCount];

      qryRevert.ExecSQL;

      qryRevert.Close;
      qryRevert.SQL.Text :=
      ' DELETE FROM '+
          AstrTabela+
      ' WHERE '+
          strSqlCampoChave;

      for intCount := 0 to High(arrValorChave) do
        qryRevert.ParamByName(arrCampoChave[intCount]).Value := arrValorChave[intCount];

      qryRevert.ExecSQL;
    except
      Result := False;

      if blnIniciaTransacao then
        fRollBack;
    end;
  finally
    if (blnIniciaTransacao) and (fInTransaction) then
      FCommit;

    FreeAndNil(qryRevert);
  end;
end;

function fNomeArquivoValido(const ATexto: string): string;
const
  cnsNomesReser: array[0..21] of string = (
    'CON','PRN','AUX','NUL',
    'COM1','COM2','COM3','COM4','COM5','COM6','COM7','COM8','COM9',
    'LPT1','LPT2','LPT3','LPT4','LPT5','LPT6','LPT7','LPT8','LPT9'
  );
var
  intIdx: Integer;
begin
  Result := Trim(ATexto);

  for intIdx := Length(Result) downto 1 do
  begin
    if (Ord(Result[intIdx]) < 32) or
       CharInSet(Result[intIdx], ['\', '/', ':', '*', '?', '"', '<', '>', '|']) then
      Delete(Result, intIdx, 1);
  end;

  while (Result <> '') and CharInSet(Result[Length(Result)], [' ', '.']) do
    Delete(Result, Length(Result), 1);

  for intIdx := Low(cnsNomesReser) to High(cnsNomesReser) do
  begin
    if SameText(Result, cnsNomesReser[intIdx]) then
    begin
      Result := Result + '_';
      Break;
    end;
  end;

  if Result = '' then
    Result := 'ARQ';
end;

procedure pGravaLogErrArquivoLocal(const strErro, strStack, strLocal: String);
  Var
    LstrPatArq,
    LstrCodOpe,
    LstrCodEmp,
    LstrConId_,
    LstrNomDir,
    LstrNomArq: String;
    LdtaTimLog: TDateTime;
    LstlLog: TStringList;
begin
  Try
    LstrNomDir := ExtractFilePath(Application.ExeName) + 'temp\log\';

    If (Not DirectoryExists(LstrNomDir)) Then
      ForceDirectories(LstrNomDir);

    If (Not DirectoryExists(LstrNomDir)) Then
      Exit;

    LdtaTimLog := Date+Time; //USO DE Date+Time EM DETRIMENTO DE fNow() PARA EVITAR ACESSO AO BANCO
    LstrNomArq := fNomeArquivoValido(strLocal);

    LstrConId_ := IfThen(VS_LastConnID.IsEmpty, VS_ConnectionID, VS_LastConnID);
    LstrCodEmp := VS_strCodEmp;
    LstrCodOpe := strLoginUsuarioLogado;

    LstrPatArq := LstrNomDir + FormatDateTime('yyyymmddhhnnsszzz', LdtaTimLog) + '_' + LstrCodEmp + '_' + LstrCodOpe + '_' + LstrNomArq + '.txt';

    LstlLog := TStringList.Create;
    Try
      LstlLog.Add(strErro);
      LstlLog.Add('');
      LstlLog.Add('Data/Hora....: ' + FormatDateTime('dd/mm/yyyy hh:nn:ss', LdtaTimLog));
      LstlLog.Add('Empresa......: ' + LstrCodEmp);
      LstlLog.Add('Operador.....: ' + LstrCodOpe);
      LstlLog.Add('Connection ID: ' + LstrConId_);
      LstlLog.Add('');
      LstlLog.Add(strStack);
      LstlLog.SaveToFile(LstrPatArq);
    Finally
      FreeAndNil(LstlLog);
    End;
  Except
    //
  End;
end;

function fBuscaMatRevGerele(ANumDoc: String; AEspDoc: String; ASerie: String; ACodEmp: String; ACodFor: String; APosEnt: Boolean = True): String;
var
  qryAux: TUniQuery;
  strSQL: String;
begin

  qryAux := fCriaQuery;
  Try
    strSQL := '';
    strSQL := strSQL + '  SELECT GER_MATREV, FOR_MATREV, IFNULL(GER_MATREV, FOR_MATREV) AS MATREV ';
    strSQL := strSQL + '  FROM  GERELE ';
    strSQL := strSQL + '  INNER JOIN CADFOR ON FOR_CODFOR = GER_CODFOR ';

    If (APosEnt) Then
    Begin
      strSQL := strSQL + '  WHERE GER_DOCENT = :NUMDOC ';
      strSQL := strSQL + '    AND GER_EMPENT = :CODEMP ';
    End
    Else
    Begin
      strSQL := strSQL + '  WHERE B08_NNF = :NUMDOC ';
      strSQL := strSQL + '    AND GER_CODEMP = :CODEMP ';
    End;

    strSQL := strSQL + '    AND IFNULL(GER_ESPENT, "NF") = :ESPDOC ';
    strSQL := strSQL + '    AND B07_SERIE  = :SERIE_ ';
    strSQL := strSQL + '    AND GER_CODFOR = :CODFOR ';

    qryAux.SQL.Add(strSQL);

    qryAux.ParamByName('NUMDOC').AsString := ANumDoc;
    qryAux.ParamByName('ESPDOC').AsString := AEspDoc;
    qryAux.ParamByName('SERIE_').AsString := ASerie;
    qryAux.ParamByName('CODEMP').AsString := ACodEmp;
    qryAux.ParamByName('CODFOR').AsString := ACodFor;

    qryAux.Open;

    If (Not qryAux.IsEmpty) Then
      Result := qryAux.FieldByName('MATREV').AsString
    Else
      Result := fCampoTabela('FOR_MATREV', 'CADFOR', ['FOR_CODFOR'], [ACodFor]);


  Finally
    FreeAndNil(qryAux);
  End;

end;

