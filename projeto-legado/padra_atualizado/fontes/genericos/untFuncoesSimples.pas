{***************************************}
{* VERIFICA SE O NUMERO DA NOTA EXISTE *}
{************************************LB*}
function fValidaNumNota(strNumNota, strEspecie, strEmpresa, strSerie, strCodFor: String): Boolean;
  Var
    strSQL   : String;
    qryGenFis: TUniQuery;
Begin
  Result := True;
  qryGenFis := fCriaQuery;
  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  FIS_NUMDOC, ';
    strSQL := strSQL + '  FIS_ESPDOC, ';
    strSQL := strSQL + '  FIS_CODEMP ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADFIS ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FIS_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  FIS_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  FIS_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  FIS_SERIE_ = :SERIE_ AND ';
    strSQL := strSQL + '  FIS_FORCLI = :CODFOR AND ';
    strSQL := strSQL + '  FIS_TIP_FC = ' + QuotedStr('F') ;

    With qryGenFis Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumNota;
      ParamByName('ESPDOC').AsString := strEspecie;
      ParamByName('CODEMP').AsString := strEmpresa;
      ParamByName('SERIE_').AsString := strSerie;
      ParamByName('CODFOR').AsString := strCodFor;
      Open;
      If IsEmpty Then
        Result := False;
    End;

  Finally
    FreeAndNil(qryGenFis);
  End;

End;

{************************************}
{* RETORNA CNPJ/CPF FORMATADO       *}
{*********************************AF*}
function fFormataCpfCgc(strValor: String; FPais: TPais; strEstado: String = ''): String;
Begin
  If (strEstado = 'EX') Or (FPais = opcParaguai) Then
  Begin

    Result := strValor;

  End
  Else
  Begin


    strValor := AnsiReplaceStr(strValor,'.','');
    strValor := AnsiReplaceStr(strValor,',','');
    strValor := AnsiReplaceStr(strValor,'-','');
    strValor := AnsiReplaceStr(strValor,'/','');

    Result := Trim(strValor);
    {************************************}
    {* SE FOR MAIOR QUE 11 ENTÃO É CNPJ *}
    {*********************************AF*}

    If Not fEmptyStr(Result) Then
    Begin

      If Length(Result) > 11 Then
      Begin
        Insert('.',Result,3);  // XX.XXX.XXX/XXXX-XX
        Insert('.',Result,7);  // XX.XXX.XXX/XXXX-XX
        Insert('/',Result,11); // XX.XXX.XXX/XXXX-XX
        Insert('-',Result,16); // XX.XXX.XXX/XXXX-XX
      End
      Else
      Begin
        Insert('.',Result,4);  // XXX.XXX.XXX-XX
        Insert('.',Result,8);  // XXX.XXX.XXX-XX
        Insert('-',Result,12); // XXX.XXX.XXX-XX
      End;

    End;

  End;

End;

function fFormataCCusto(strValor: String): String;
Begin

  strValor := AnsiReplaceStr(strValor,'.','');
  strValor := AnsiReplaceStr(strValor,',','');
  strValor := AnsiReplaceStr(strValor,'-','');
  strValor := AnsiReplaceStr(strValor,'/','');

  Result := Trim(strValor);

  If Not fEmptyStr(Result) Then
  Begin
    Insert('.',Result,3);  // XX.XX.XXX
    Insert('.',Result,6);  // XX.XX.XXX
  End;

End;

{*********************************}
{* RETORNA PARCELAS REFERENTE AO *}
{* NUMERO DO DOCUMENTO           *}
{******************************AF*}
function fRetParcelas(strNumDoc, strSerie, strFornecedor: String; strCodEmp: String = ''; blnAgruparParcelas: boolean = False): TParcelasArray;
  Var
    arrParcelas: TParcelasArray;
    strSQL     : String;
    intContador: Integer;
    qryGenVen  : TUniQuery;

Begin
  Try

    qryGenVen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  NULL AS CTP_NUMAGR, ';
    strSQL := strSQL + '  CTP_NUMDUP, ';
    strSQL := strSQL + '  CTP_SERIE_, ';
    strSQL := strSQL + '  CTP_PARCEL, ';
    strSQL := strSQL + '  CTP_CODCTA, ';
    strSQL := strSQL + '  CTP_DTAVEN, ';
    strSQL := strSQL + IIf(blnAgruparParcelas, ' SUM(CTP_VALORI) AS CTP_VALORI ', ' CTP_VALORI ');
    strSQL := strSQL + '  , IF(CTP_VEIOBO = "S", "SIM", "NÃO") AS CTP_VEIOBO ';


    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + ' CADPAG ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '  CTP_NUMDUP = :NUMDUP AND ';

    If (fEmptyStr(strSerie)) Then
      strSQL := strSQL + '  ((CTP_SERIE_ IS NULL) OR (CTP_SERIE_ = "")) AND '
    Else
      strSQL := strSQL + '  CTP_SERIE_ = :SERIE  AND ';

    strSQL := strSQL + '  CTP_CODFOR = :CODFOR AND ';

    If Not fEmptyStr(strCodEmp) then
      strSQL := strSQL + '  CTP_CODEMP = :CODEMP '
    Else
      strSQL := strSQL + '  LOCATE(CTP_CODEMP,' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';

    If blnAgruparParcelas Then
      strSQL := strSQL + ' GROUP BY CTP_PARCEL, CTP_NUMDUP  ';

    strSQL := strSQL + ' UNION ALL ';

    // INICIO AGRUPAMENTO

    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  CTP_NUMAGR, ';
    strSQL := strSQL + '  CTP_NUMDUP, ';
    strSQL := strSQL + '  CTP_SERIE_, ';
    strSQL := strSQL + '  CTP_PARCEL, ';
    strSQL := strSQL + '  CTP_CODCTA, ';
    strSQL := strSQL + '  CTP_DTAVEN, ';
    strSQL := strSQL + IIf(blnAgruparParcelas, ' SUM(CTP_VALORI) AS CTP_VALORI ', ' CTP_VALORI ');
    strSQL := strSQL + '  , "NÃO" AS CTP_VEIOBO ';


    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + ' DUPAGP ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '  CTP_NUMDUP = :NUMDUP AND ';

    If (fEmptyStr(strSerie)) Then
      strSQL := strSQL + '  ((CTP_SERIE_ IS NULL) OR (CTP_SERIE_ = "")) AND '
    Else
      strSQL := strSQL + '  CTP_SERIE_ = :SERIE  AND ';

    strSQL := strSQL + '  CTP_CODFOR = :CODFOR AND ';

    If Not fEmptyStr(strCodEmp) then
      strSQL := strSQL + '  CTP_CODEMP = :CODEMP '
    Else
      strSQL := strSQL + '  LOCATE(CTP_CODEMP,' + QuotedStr(strEmpAcessoUsuarioLogado) + ') > 0 ';

    If blnAgruparParcelas Then
      strSQL := strSQL + ' GROUP BY CTP_PARCEL, CTP_NUMDUP  ';

    // FIM AGRUPAMENTO

    strSQL := strSQL + 'ORDER BY ';
    strSQL := strSQL + '  CTP_NUMDUP, ';
    strSQL := strSQL + '  CTP_SERIE_, ';
    strSQL := strSQL + '  CTP_PARCEL  ';

    With qryGenVen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDUP').AsString := fStrZero(strNumDoc, 12);

      If (Not fEmptyStr(strSerie)) Then
        ParamByName('SERIE').AsString := strSerie;

      If Not fEmptyStr(strCodEmp)Then
        ParamByName('CODEMP').AsString := strCodEmp;

      ParamByName('CODFOR').AsString := strFornecedor;
      Open;

      If (IsEmpty) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDUP').AsString := fStrZero(strNumDoc, 12);

        If (Not fEmptyStr(strSerie)) Then
          ParamByName('SERIE').AsString := strSerie;

        If Not fEmptyStr(strCodEmp)Then
          ParamByName('CODEMP').AsString := strCodEmp;

        ParamByName('CODFOR').AsString := strFornecedor;
        Open;
      End;

      If (Not IsEmpty) Then
      Begin
        SetLength(arrParcelas,RecordCount);

        For intContador := 0 To RecordCount -1 Do
        Begin
          arrParcelas[intContador].strData   := FormatDateTime('dd/mm/yy', FieldByName('CTP_DTAVEN').AsDateTime);
          arrParcelas[intContador].strValor  := FloatToStrF(FieldByName('CTP_VALORI').AsCurrency,ffNumber,15,2);
          arrParcelas[intContador].strCodCta := FieldByName('CTP_CODCTA').AsString;
          arrParcelas[intContador].strVeioBo := FieldByName('CTP_VEIOBO').AsString;
          arrParcelas[intContador].strNumAgp := FieldByName('CTP_NUMAGR').AsString;

          Next;
        End;

        Result := arrParcelas;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryGenVen);
  End;

End;

