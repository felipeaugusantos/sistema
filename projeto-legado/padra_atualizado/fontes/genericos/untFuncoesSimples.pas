function fAjustaDataConformeDiaSugestaoRetroagindoParaDiaUtilSeNecessario(const strCompetencia: String;
                                                                          intDiaSugestao: Integer;
                                                                          intQtdMesIncrementar: Integer;
                                                                          strCodCidFeriado: String = ''): TDate;
var
  blnDataAjustada: Boolean;
begin
  repeat
    Result := IncMonth(StrToDate('01/'+strCompetencia), intQtdMesIncrementar);
    Result := StrToDateDef(fStrZero(IntToStr(intDiaSugestao),2)+'/'+Copy(DateToStr(Result),4,7), 0);

    blnDataAjustada := ((Result <> 0) and
                        (not fDiaDeFolga(Result, True, strCodCidFeriado)));

    if not blnDataAjustada then
    begin
      Dec(intDiaSugestao);

      if intDiaSugestao <= 0 then
      begin
        intDiaSugestao := 31;
        Dec(intQtdMesIncrementar);
      end;
    end;

  until blnDataAjustada;
end;

