function fRetornaWordWrap(strTexto: String; intColunas: Integer): TStringList;
  Var
    intColAtu: Integer;
    intIndice: Integer;
    intTamStr: Integer;
    strBuffer: String;
    strLinha: String;
begin

  Result := TStringList.Create;
  intIndice := 1;
  intColAtu := 1;
  strLinha  := '';
  intTamStr := Length(strTexto);

  While (intIndice <= intTamStr) Do
  Begin

    If (intColAtu <= intColunas) Then
    Begin
      If (strTexto[intIndice] = ' ') Or
         (strTexto[intIndice] = #13) Or
         (intIndice = intTamStr)     Then
      Begin
        strLinha := strLinha + strBuffer;
        strBuffer := '';

        If (strTexto[intIndice] = #13) Then
        Begin
          intColAtu := 0;
          Result.Add(strLinha);
          strLinha := '';
        End
        Else
          strLinha := strLinha + strTexto[intIndice];

        If (strTexto[intIndice+1] = #10) Then
        Begin
          Inc(intIndice);
        End;
      End
      Else
        strBuffer := strBuffer + strTexto[intIndice];
    End
    Else
    Begin
      strBuffer := strBuffer + strTexto[intIndice];
      Result.Add(strLinha);
      strLinha := '';
      intColAtu := Length(strBuffer);
    End;

    Inc(intIndice);
    Inc(intColAtu);
  End;

  If (Not fEmptyStr(strLinha)) Then
    Result.Add(strLinha);

end;

procedure pTamanhoCamposLocFis(Var intLocFis, intLocSup, intTamLcf, intLocSep : Integer);
  Var
    qryAux: TUniQuery;
    intCnt: Integer;
Begin
  intLocFis := 50;
  intLocSup := 10;
  intTamLcf := 30;
  intLocSep := 10;
  intCnt    := 0;

  qryAux := fCriaQuery();
  qryAux.SQL.Text := 'DESC ITEGER';
  qryAux.Open;

  While (Not qryAux.Eof) Do
  Begin

    If qryAux.FieldByName('Field').AsString = 'ITE_LOCFIS' Then
    Begin
      Inc(intCnt);
      If Pos('VARCHAR', UpperCase(qryAux.FieldByName('Type').AsString)) > 0 then
        intLocFis := StrToInt(fRetSomenteNumeros(qryAux.FieldByName('Type').AsString));
    End;

    If qryAux.FieldByName('Field').AsString = 'ITE_LOCSUP' Then
    Begin
      Inc(intCnt);
      If Pos('VARCHAR', UpperCase(qryAux.FieldByName('Type').AsString)) > 0 then
        intLocSup := StrToInt(fRetSomenteNumeros(qryAux.FieldByName('Type').AsString));
    End;

    If qryAux.FieldByName('Field').AsString = 'ITE_TAMLCF' Then
    Begin
      Inc(intCnt);
      If Pos('VARCHAR', UpperCase(qryAux.FieldByName('Type').AsString)) > 0 then
        intTamLcf := StrToInt(fRetSomenteNumeros(qryAux.FieldByName('Type').AsString));
    End;

    If qryAux.FieldByName('Field').AsString = 'ITE_LOCSEP' Then
    Begin
      Inc(intCnt);
      If Pos('VARCHAR', UpperCase(qryAux.FieldByName('Type').AsString)) > 0 then
        intLocSep := StrToInt(fRetSomenteNumeros(qryAux.FieldByName('Type').AsString));
    End;

    If (intCnt >= 4) then
      Break;

    qryAux.Next;
  End;
  FreeAndNil(qryAux);

End;

