Procedure pConfiguraPopup(Sender: TObject);
  Var
    iteMenu,
    iteMenuRel: TMenuItem;
    popMenu: TPopupMenu;
Begin

  if Sender is TBitBtnLocked then
  begin
    popMenu         := TPopupMenu.Create(TBitBtnLocked(Sender));
    iteMenu         := TMenuItem.Create(popMenu);
    iteMenu.Caption := 'Configura o relatório chamado pelo botão "' + IIF(SameText('...', TBitBtnLocked(Sender).Caption), TBitBtnLocked(Sender).Hint, TBitBtnLocked(Sender).Caption) + '"';
    iteMenu.OnClick := TBitBtnLocked(Sender).OnClick;

    TBitBtnLocked(Sender).PopupMenu := popMenu;

    iteMenu.Tag := 199;
    popMenu.Items.Add(iteMenu);
  end;

  if Sender is TMenuItem then
  begin
    iteMenuRel         := TMenuItem.Create(TMenuItem(Sender));
    iteMenuRel.Caption := 'Abrir "' + IIF(SameText('...', TMenuItem(Sender).Caption), TMenuItem(Sender).Hint, TMenuItem(Sender).Caption) + '"';
    iteMenuRel.OnClick := TMenuItem(Sender).OnClick;
    iteMenuRel.ShortCut := TMenuItem(Sender).ShortCut;

    iteMenuRel.Tag := TMenuItem(Sender).Tag;
    TMenuItem(Sender).Add(iteMenuRel);

    iteMenu         := TMenuItem.Create(TMenuItem(Sender));
    iteMenu.Caption := 'Configura o relatório chamado pelo botão "' + IIF(SameText('...', TMenuItem(Sender).Caption), TMenuItem(Sender).Hint, TMenuItem(Sender).Caption) + '"';
    iteMenu.OnClick := TMenuItem(Sender).OnClick;

    iteMenu.Tag := 199;
    TMenuItem(Sender).Add(iteMenu);

    TMenuItem(Sender).OnClick := nil;
  end;
End;

