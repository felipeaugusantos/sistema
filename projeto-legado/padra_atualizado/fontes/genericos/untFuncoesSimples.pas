function fRetornaDadosVeic(strPlaVei: String): TDadosVeiculo;
  Var
    qryTemp : TUniQuery;
begin
  With Result Do Begin
    strPlaVei := '';
    strKM_Vei := '';
    strMarVei := '';
    strModVei := '';
    strAnoVei := '';
    strCorVei := '';
    strCondut := '';
    intCapCar := 0;
  End;

  If (fEmptyStr(strPlaVei)) Then Exit;

  qryTemp := fCriaQuery();

  Try
    qryTemp.Close();
    qryTemp.SQL.Clear();
    qryTemp.SQL.Add(' SELECT MAR_DESMAR, MOD_DESMOD, VEI_ANOVEI, ');
    qryTemp.SQL.Add('   COR_DESCOR, VEI_CAPCAR, VEI_CONDUT FROM  ');
    qryTemp.SQL.Add('   CADVEI LEFT JOIN MARVEI ON VEI_CODMAR = MAR_CODMAR LEFT ');
    qryTemp.SQL.Add('   JOIN MODVEI ON VEI_CODMOD = MOD_CODMOD LEFT JOIN CORVEI ');
    qryTemp.SQL.Add('   ON VEI_CODCOR = COR_CODCOR WHERE VEI_PLAVEI = :PLAVEI ');

    qryTemp.ParamByName('PLAVEI').AsString := strPlaVei;
    qryTemp.Open();

    qryTemp.First();

