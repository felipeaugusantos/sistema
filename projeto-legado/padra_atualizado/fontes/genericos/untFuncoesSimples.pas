function fRetCodigoEspecieBarraRomaneio(strCodOuEsp: String): String;

Const
   ARR_COD_ESP : Array[0..9] Of Array[0..1] Of String = (
                   ('01', 'NF'),
                   ('02', 'IF'),
                   ('03', 'MI'),
                   ('04', 'FF'),
                   ('05', 'TE'),
                   ('06', 'BR'),
                   ('07', 'TR'),
                   ('08', 'DV'),
                   ('09', 'PD'),
                   ('10', 'D1')
                 );
Var
  intIdxBus,
  intIdxRet,
  intIdx: Integer;

begin
  //0 TIPOS
  //1 ESPEC
  intIdxBus := IIF(fEhLetra(strCodOuEsp[1]), 1, 0);
  intIdxRet := IIF(intIdxBus = 0, 1, 0);

  For intIdx:=Low(ARR_COD_ESP) To High(ARR_COD_ESP) Do
  Begin
    If ARR_COD_ESP[intIdx][intIdxBus] = strCodOuEsp Then
    Begin
      Result := ARR_COD_ESP[intIdx][intIdxRet];
      Break
    End;
  End;

  If Result = '' Then
    Raise Exception.Create('Espécie/Código ' + strCodOuEsp + ' não previsto para código de barras para romaneio!');
end;

procedure pPlaySound(AFileName: String);

  function fExecutouPlaySoundExe: Boolean;
  begin
    Result := False;

    If FileExists(ExtractFilePath(Application.ExeName) + 'PlaySound.exe') Then
    Begin
      Result := True;
      WinExec(PAnsiChar(AnsiString(ExtractFilePath(Application.ExeName) + 'PlaySound.exe "' + AFileName + '"')), SW_HIDE)
    End;
  end;

begin
  If fEmptyStr(AFileName) Then
    Exit;

  If TCfgRel.VS_TSPlus Then
  Begin
    If (Not fExecutouPlaySoundExe) Then
      TPlaySound.Execute(Trim(AFileName));
  End
  Else
  Begin
    If (Not fExecutouPlaySoundExe) Then
      sndPlaySound(PWideChar(AFileName), SND_ASYNC);
  End;
end;

