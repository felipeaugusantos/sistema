function fConverteCodigoBarrasChaveAcesso(strCodBar: String; blnApenasMovimentosNaoConfirmados: Boolean = False) : untTypesSistema.TDocumento;
Var
  strSQL : String;
  qryFis : TUniQuery;
begin

  Result.strNumDoc := '';
  Result.strEspDoc := '';
  Result.strSerie  := '';
  Result.strCodEmp := '';
  Result.strCliFor := '';

  Try

    qryFis := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT        ';
    strSQL := strSQL + '  FIS_NUMDOC, ';
    strSQL := strSQL + '  FIS_ESPDOC, ';
    strSQL := strSQL + '  FIS_CODEMP, ';
    strSQL := strSQL + '  FIS_FORCLI, ';
    strSQL := strSQL + '  IFNULL(FIS_DTAENT, "") AS FIS_DTAENT, ';
    strSQL := strSQL + '  FIS_SERIE_  ';
    strSQL := strSQL + 'FROM          ';
    strSQL := strSQL + '  CADFIS      ';
    strSQL := strSQL + 'WHERE         ';
    strSQL := strSQL + '  FIS_ACESSO = :ACESSO ';

    With qryFis Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('ACESSO').AsString := strCodBar;
      Open;
      If (Not IsEmpty) Then
      If blnApenasMovimentosNaoConfirmados And (qryFis.FieldByNAme('FIS_DTAENT').AsString <> '')Then
      Begin
        Result.strFalha := 'O Documento já esta com Data de Entrada!';
        Exit;
