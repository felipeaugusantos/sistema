Function fVerificaEventoCfgContabil(strCodEve : String) : Boolean;
  Var
    qryTab : TUniQuery;
begin
  Result := false;

  If Not fCfgSis('UTICON', varBoolean) Then
     Exit;

  qryTab := fCriaQuery();
  Try
    qryTab.Close;
    qryTab.SQL.Clear;
    qryTab.SQL.Add('SELECT ');
    qryTab.SQL.Add('  COUNT(*) CNT ');
    qryTab.SQL.Add('FROM ');
