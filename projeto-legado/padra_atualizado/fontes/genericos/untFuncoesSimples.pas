function fRetornaSQLSalResLotesBloqueadosParaVenda(strCodigoEmpresa: String;
                                          blnSelectDocumentos : Boolean = False;
                                          blnImpDocTransfLocFis : Boolean = False):String;
Begin
  Result := '';
  Result := Result + ' SELECT ';
  If not blnSelectDocumentos Then
    Result := Result + ' SUM(LOT_SALDOS) '
  Else
  Begin
    Result := Result + ' "LOTE NÃO LIB" AS NUMDOC, ';
    Result := Result + ' "" AS ESPDOC, ';
    Result := Result + ' LOT_CODEMP AS CODEMP, ';
    Result := Result + ' "" AS CODCLI, ';
    Result := Result + ' LOT_CODITE AS CODITE, ';
    Result := Result + ' LOT_NUMLOT AS NUMLOT, ';

    If blnImpDocTransfLocFis Then
      Result := Result + ' LOT_SALDOS AS QTDPED, ';

    Result := Result + ' "N" AS SEPEXP  ';
  End;

  Result := Result + ' FROM CADLOT ';
  Result := Result + '   LEFT JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS ';
  Result := Result + '                    AND LOT_CODEMP = LOC_CODEMP ';
  Result := Result + ' WHERE LOT_CODEMP = :CODEMP';
  Result := Result + '   AND LOT_CODITE = :CODITE ';

  Result := Result + '   AND LOT_NUMLOT NOT IN ("GARANTIA","A DEFINIR") ';

  Result := Result + '   AND ( (IFNULL(LOC_CRITIC, "N") = "S") ';
  If fCfgSis('RESLNA') <> '2' Then
    Result := Result + '    OR (IFNULL(LOT_LOTAPR, "S") = "N") ';
  Result := Result + '  ) ';

  If not blnSelectDocumentos Then
    Result := Result + ' GROUP BY LOT_CODITE ';

End;

{*****************************************************************************************}
{* SOMENTE RESERVA ESTOQUE DOS SUB.PRODUTOS ENQUANTO A ORDEM DE PRODUCAO NAO FOR BAIXADA *}
{*************************************************************************************JC**}
function fRetornaSQLSalResLotesDigSeparacao( strEmpresaItem: String;
                                             blnIgnorarDocumento:Boolean;
                                             strCodigoEmpresa: String;
                                             blnFiltrarDocumento: Boolean = False;
                                             blnFiltrarEmpresa: Boolean = True;
                                             blnSelectDocumentos: Boolean = False;
                                             blnImpDocTransfLocFis: Boolean = False ): String;
  Var
    strSQL , strEmp_CD: String;
Begin
  strEmp_CD := fCfgSis('EMP_CD', varString, strCodigoEmpresa);

  strSQL := strSQL + ' SELECT ';
  If not blnSelectDocumentos Then
    strSQL := strSQL + '   SUM(COALESCE(LDO_QTDITE,0)) SALRES '
  Else
  Begin
    strSQL := strSQL + ' FDO_NUMDOC AS NUMDOC, ';
    strSQL := strSQL + ' FDO_ESPDOC AS ESPDOC, ';
    strSQL := strSQL + ' IF(IFNULL(FGO_EMP_TE, "") = "", FDO_CODEMP, FGO_EMP_TE) AS CODEMP, ';
    strSQL := strSQL + ' FDO_CODCLI AS CODCLI, ';
    strSQL := strSQL + ' FDO_CODITE AS CODITE, ';
    strSQL := strSQL + ' LDO_NUMLOT AS NUMLOT, ';

    If blnImpDocTransfLocFis Then
      strSQL := strSQL + ' SUM(COALESCE(FDO_QTDITE,0)) AS QTDPED, ';

    strSQL := strSQL + ' FGO_SEPEXP AS SEPEXP  ';
  End;

  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   FATDOR ';
  strSQL := strSQL + '   INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FDO_SEQGER ';
  strSQL := strSQL + '   LEFT  JOIN EXTGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
  strSQL := strSQL + '   INNER JOIN LOTDOR ON LDO_SEQFDO = FATDOR.AUTOINCREM ';
  strSQL := strSQL + ' WHERE  ';
  If not blnSelectDocumentos Then
    strSQL := strSQL + '   FDO_CODITE = :CODITE AND ';
  strSQL := strSQL + '   FDO_ESPDOC = "PD"    AND ';
  strSQL := strSQL + '   FDO_JAFATU = 0       AND ';

  If (fCfgSis('BAITMQ') = 'S') Then
  Begin
    strSQL := strSQL + '   IFNULL((SELECT TD.FDO_BAIXAD FROM TINDOR TD ';
    strSQL := strSQL + '           WHERE TD.FDO_NUMDOC = FATDOR.FDO_NUMDOC    ';
    strSQL := strSQL + '             AND TD.FDO_ESPDOC = FATDOR.FDO_ESPDOC    ';
    strSQL := strSQL + '             AND TD.FDO_CODEMP = FATDOR.FDO_CODEMP    ';
    strSQL := strSQL + '             AND TD.FDO_CODCLI = FATDOR.FDO_CODCLI    ';
    strSQL := strSQL + '             AND TD.FDO_CODITE = FATDOR.FDO_CODITE    ';
    strSQL := strSQL + '             AND TD.FDO_CODACA = FATDOR.FDO_CODACA    ';
    strSQL := strSQL + '             AND TD.FDO_EMPACA = FATDOR.FDO_EMPACA    ';
    strSQL := strSQL + '             LIMIT 1 ),0) = 0 AND ';
  End
  Else Begin
    strSQL := strSQL + '     IF(FGO_OPRFLJ = "S", IF(FGO_OPRFLJ = "S" AND (IFNULL((SELECT                                  ';
    strSQL := strSQL + '                                                             TD.FDO_BAIXAD                         ';
    strSQL := strSQL + '                                                           FROM                                    ';
    strSQL := strSQL + '                                                             TINDOR TD                             ';
    strSQL := strSQL + '                                                           WHERE                                   ';
    strSQL := strSQL + '                                                             TD.FDO_NUMDOC = FATDOR.FDO_NUMDOC AND ';
    strSQL := strSQL + '                                                             TD.FDO_ESPDOC = FATDOR.FDO_ESPDOC AND ';
    strSQL := strSQL + '                                                             TD.FDO_CODEMP = FATDOR.FDO_CODEMP AND ';
    strSQL := strSQL + '                                                             TD.FDO_CODCLI = FATDOR.FDO_CODCLI AND ';
    strSQL := strSQL + '                                                             TD.FDO_CODITE = FATDOR.FDO_CODITE AND ';
    strSQL := strSQL + '                                                             TD.FDO_CODACA = FATDOR.FDO_CODACA AND ';
    strSQL := strSQL + '                                                             TD.FDO_EMPACA = FATDOR.FDO_EMPACA     ';
    strSQL := strSQL + '                                                           LIMIT 1), 0) = 0), 1, 0), 1) = 1 AND    ';
  End;

  If Not fEmptyStr(strEmpresaItem) Then
  Begin
    strSQL := strSQL + '   ((((IF(IFNULL(FGO_EMP_TE, "") = "", FDO_CODEMP, FGO_EMP_TE) = :CODEMP) AND (IFNULL(FDO_EMPITE, "") = "")) OR ';
    strSQL := strSQL + '     (FDO_EMPITE = :EMPITE)) ';
  End Else
  Begin
    strSQL := strSQL + '   ( ' + IIF(blnFiltrarEmpresa, ' IF(IFNULL(FGO_EMP_TE, "") = "", FDO_CODEMP, FGO_EMP_TE) = :CODEMP ', ' FDO_CODEMP = FDO_CODEMP ');
  End;

  If (fCfgSis('ENT_CD', varBoolean, strCodigoEmpresa)) And (VS_strCodEmp = strEmp_CD) Then
  Begin
    strSQL := strSQL + '   OR ( FGO_ENT_CD = "S" AND ' +
                       '        IFNULL(FGO_EMP_CD, ' + QuotedStr(strEmp_CD) + ') = ' + QuotedStr(strEmp_CD) + ' ) ) ';
  End
  Else
  Begin
    strSQL := strSQL + '   AND IFNULL(FGO_ENT_CD, "N") = "N") ';
  End;

  If not blnSelectDocumentos Then
  Begin
    strSQL := strSQL + '   AND ';

    If blnIgnorarDocumento Then
    Begin
      strSQL := strSQL + '   FDO_NUMDOC <> :NUMDOC AND ';
    End
    Else If blnFiltrarDocumento Then
    Begin
      strSQL := strSQL + '   FDO_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '   FDO_NUMDOC = :NUMDOC AND ';
    End;

    strSQL := strSQL + '   LDO_NUMLOT = :NUMLOT ';

    strSQL := strSQL + ' GROUP BY ';
    strSQL := strSQL + '   FDO_CODITE ';
  End;

  If blnImpDocTransfLocFis Then
  Begin
    strSQL := strSQL + ' GROUP BY ';
    strSQL := strSQL + '   FDO_CODITE, LDO_NUMLOT ';
  End;

  Result := strSQL;

End;

function fGetSaldoResLotDor(strCodIte, strNumLot, strCodEmp: String): Double;
  Var
    strSQL,
    strEmp_CD: String;
    qryTmp: TUniQuery;
Begin
  strEmp_CD := fCfgSis('EMP_CD', varString, VS_strCodEmp);

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   SUM(COALESCE(LDO_QTDITE, 0)) SALRES ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   FATDOR ';
  strSQL := strSQL + '   INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FDO_SEQGER ';
  strSQL := strSQL + '   LEFT  JOIN EXTGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
  strSQL := strSQL + '   INNER JOIN LOTDOR ON LDO_SEQFDO = FATDOR.AUTOINCREM AND FDO_NUMLOT = "A DEFINIR" ';
  strSQL := strSQL + ' WHERE  ';
  strSQL := strSQL + '   FDO_CODITE = :CODITE AND ';
  strSQL := strSQL + '   LDO_NUMLOT = :NUMLOT AND ';
  strSQL := strSQL + '   FDO_ESPDOC = "PD"    AND ';
  strSQL := strSQL + '   FDO_JAFATU = 0       AND ';
  strSQL := strSQL + '   ((((IF(IFNULL(FGO_EMP_TE, "") = "", FDO_CODEMP, FGO_EMP_TE) = :CODEMP) AND (IFNULL(FDO_EMPITE, "") = "")) OR ';
  strSQL := strSQL + '     (FDO_EMPITE = :EMPITE)) ';

  If (fCfgSis('ENT_CD', varBoolean, VS_strCodEmp)) And (VS_strCodEmp = strEmp_CD) Then
    strSQL := strSQL + '   OR ( FGO_ENT_CD = "S" AND ' +
                       '        IFNULL(FGO_EMP_CD, ' + QuotedStr(strEmp_CD) + ') = ' + QuotedStr(strEmp_CD) + ' ) ) '
  Else
    strSQL := strSQL + '   AND IFNULL(FGO_ENT_CD, "N") = "N") ';

  strSQL := strSQL + ' GROUP BY ';
  strSQL := strSQL + '   FDO_CODITE ';

  qryTmp := fCriaQuery;

  With qryTmp Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODITE').AsString := strCodIte;
    ParamByName('NUMLOT').AsString := strNumLot;
    ParamByName('EMPITE').AsString := strCodEmp;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;

    If Not IsEmpty Then
      Result := FieldByName('SALRES').AsFloat
    Else
      Result := 0;
  End;

  FreeAndNil(qryTmp);
End;

function fGetSQLSaldoRes(strEmp_CD: String; blnMostrarRequisicao: Boolean = False; blnMostrarCidadeCliente: Boolean = False;
                        dtaInicial: TDateTime = 0; dtaFinal: TDateTime = 0; tfdTipoFiltroData: TTipoFiltroDataAnaliseProducao = tfdNenhum): String;
  Type
    TTipoInfo = (infVenda, infOrdPro, infEnderecamento, infItemPigmento);

  Var
    strSQL : String;

  function fMontaFiltroWhereData: String;
  begin
    Result := '';
    If ((dtaInicial <> 0) And (dtaFinal <> 0) And (tfdTipoFiltroData <> tfdNenhum)) Then
    Begin
      Case tfdTipoFiltroData Of
        tfdPrevisaoPedido : Result := Result + ' AND FGO_PREVIS BETWEEN :DTAINI AND :DTAFIN ';
        tfdEntregaItem    : Result := Result + ' AND FDO_DTENTR BETWEEN :DTAINI AND :DTAFIN ';
      End;
    End;
  end;

  procedure pSqlPedido_OrdemProducao_ou_Venda(infTipoInfo: TTipoInfo);
  begin
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   FDO_NUMDOC, ';
    strSQL := strSQL + '   FDO_CODEMP, ';
    strSQL := strSQL + '   FDO_CODVEN, ';
    strSQL := strSQL + '   CADOPE.OPE_NOMOPE, ';
    strSQL := strSQL + '   FDO_DTAENT, ';
    strSQL := strSQL + '   FDO_DTENTR, ';
    strSQL := strSQL + '   FGO_PREVIS, ';
    strSQL := strSQL + '   FDO_EMPITE, ';
    strSQL := strSQL + '   EQU_NUMOSE, ';
    strSQL := strSQL + SELECT_STATUS_OS + ' AS EQU_STATUS, ';
    strSQL := strSQL + '   CLI_CODCLI,  ';
    strSQL := strSQL + '   CLI_NOMCLI,  ';
    strSQL := strSQL + '   0 AS FDO_QTDPED, ';
    strSQL := strSQL + '   0 AS FDO_QTDGAR, ';
    strSQL := strSQL + '   0 AS FDO_QTPD_F, ';

    Case infTipoInfo Of
      infEnderecamento: strSQL := strSQL + '   SUM(COALESCE(FDO_QTDITE, 0) - COALESCE(FDO_QTDBAI, 0)) AS FDO_QTDEND, ';
      Else              strSQL := strSQL + '   0 AS FDO_QTDEND, ';
    End;

    Case infTipoInfo Of
      infOrdPro: strSQL := strSQL + '   SUM(COALESCE(FDO_QTDITE, 0) - COALESCE(FDO_QTDBAI, 0)) AS FDO_QTDORP, ';
      Else       strSQL := strSQL + '   0 AS FDO_QTDORP, '
    End;

    strSQL := strSQL + '   FGO_CORTE_, ';
    strSQL := strSQL + '   FDO_ESPDOC, ';
    strSQL := strSQL + '   "FATDOR" AS TABELA, ';
    strSQL := strSQL + '   FGO_OPRFLJ, ';
    strSQL := strSQL + '   FDO_EMPPRD, ';
    strSQL := strSQL + '   FGO_DOCEND, ';
    strSQL := strSQL + '   FDO_UNITAR, ';

    If blnMostrarRequisicao Then
    Begin
     strSQL := strSQL + '  CONCAT(RCD_CODIGO, "-", RCD_CODEMP) AS CODREQ, ';
    End;

    strSQL := strSQL + '   FGO_ORDIND,  ';
    strSQL := strSQL + '   IF(IFNULL(FATGOR.FGO_SEPIMP,"") IN ("","N","0"),"NÃO","SIM") AS SEPIMP, ';

    strSQL := strSQL + '   IF(IFNULL(FATGOR.FGO_SEPIMP,"") IN ("","N","0"), "", ';
    strSQL := strSQL + '   ( SELECT ';
    strSQL := strSQL + '         GROUP_CONCAT(LDO_NUMLOT SEPARATOR " / ") ';
    strSQL := strSQL + '     FROM LOTDOR ';
    strSQL := strSQL + '     WHERE LDO_SEQFDO = FATDOR.AUTOINCREM )) AS NUMLOT ';

    If blnMostrarCidadeCliente Then
    Begin
      strSQL := strSQL + ',   CID_NOMCID,                       ';
      strSQL := strSQL + '    CID_ESTADO                        ';
    End;
    strSQL := strSQL + '  ,(IFNULL(DIGCON.DIC_QTDDEV,0) - IFNULL(DEVVEN.DEV_QTDBAI,0)) AS DEVPEN ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   FATDOR ';
    strSQL := strSQL + '   JOIN FATGOR      ON FATGOR.AUTOINCREM = FDO_SEQGER ';
    strSQL := strSQL + '   JOIN CADOPE      ON CADOPE.OPE_CODOPE = FDO_CODVEN ';
    strSQL := strSQL + '   LEFT JOIN EXTDOR      ON FATDOR.AUTOINCREM = FDO_SEQFDO ';

    If blnMostrarRequisicao Then
    Begin
     strSQL := strSQL + '  LEFT JOIN MOVRCD ON RCD_DOCPDV = FDO_NUMDOC AND RCD_EMPPDV = FDO_CODEMP AND RCD_ESPPDV = FDO_ESPDOC AND RCD_CODITE = FDO_CODITE ';
    End;

    strSQL := strSQL + '   LEFT JOIN CADCLI      ON CLI_CODCLI        = FDO_CODCLI ';
    strSQL := strSQL + '   LEFT JOIN EXTGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
    strSQL := strSQL + '   LEFT JOIN EQUGER ON FATDOR.FDO_NUMDOC = EQUGER.EQU_NUMPED ';
    strSQL := strSQL + '                   AND FATDOR.FDO_CODEMP = EQUGER.EQU_EMPPED ';
    strSQL := strSQL + '                   AND EQUGER.EQU_TIPPED = "PD" ';

    If infTipoInfo = infItemPigmento Then
    Begin
      strSQL := strSQL + '      INNER JOIN DUP_CADDUP  ON DUP_MD5KEY = FDO_ITETIN  ';
      strSQL := strSQL + '      LEFT JOIN DUP_CADBAS B ON  B.BAS_CODITE = :CODITE  ';
    End;

    If (fCfgSis('BXSBIT') = '3') Or ((fCfgSis('BXSBIT') = '2') And (fCfgSis('EMOPPD') = 'S')) Then
      strSQL := strSQL + '  LEFT JOIN MOVPRO ON PRO_CODPRO = FDO_ORDPRO AND PRO_CODEMP = FDO_CODEMP ';

    If blnMostrarCidadeCliente Then
    Begin
      strSQL := strSQL + ' LEFT JOIN AUXGOR ON AUX_SEQGER = FDO_SEQGER                    ';
      strSQL := strSQL + ' LEFT JOIN ENTCLI ON ETC_CODCLI = CLI_CODCLI                    ';
      strSQL := strSQL + '                 AND IF(AUX_ENTGER <> NULL,                     ';
			strSQL := strSQL + '      ENTCLI.AUTOINCREM = AUX_ENTGER,                           ';
			strSQL := strSQL + '      ETC_SEQIND = (SELECT                                      ';
      strSQL := strSQL + '                         MIN(ETC_SEQIND)                        ';
      strSQL := strSQL + '                          FROM                                  ';
      strSQL := strSQL + '                            ENTCLI                              ';
      strSQL := strSQL + '                          WHERE ETC_CODCLI = CLI_CODCLI))       ';
      strSQL := strSQL + ' LEFT JOIN CADCID ON CID_CODCID = ETC_CIDENT                    ';
    End;
    strSQL := strSQL + ' LEFT  JOIN DIGCON  ON FATDOR.AUTOINCREM = DIGCON.DIC_SEQDOR      ';
    strSQL := strSQL + ' LEFT  JOIN DEVVEN  ON DEVVEN.DEV_INCFDO = FATDOR.AUTOINCREM      ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FDO_JAFATU = FALSE AND ';

    If (fCfgSis('BAITMQ') = 'S') Then
    Begin
      strSQL := strSQL + '       IFNULL((SELECT TD.FDO_BAIXAD FROM TINDOR TD ';
      strSQL := strSQL + '               WHERE TD.FDO_NUMDOC = FATDOR.FDO_NUMDOC    ';
      strSQL := strSQL + '                 AND TD.FDO_ESPDOC = FATDOR.FDO_ESPDOC    ';
      strSQL := strSQL + '                 AND TD.FDO_CODEMP = FATDOR.FDO_CODEMP    ';
      strSQL := strSQL + '                 AND TD.FDO_CODCLI = FATDOR.FDO_CODCLI    ';
      strSQL := strSQL + '                 AND TD.FDO_CODITE = FATDOR.FDO_CODITE    ';
      strSQL := strSQL + '                 AND TD.FDO_CODACA = FATDOR.FDO_CODACA    ';
      strSQL := strSQL + '                 AND TD.FDO_EMPACA = FATDOR.FDO_EMPACA    ';
      strSQL := strSQL + '                 LIMIT 1 ),0) = 0 AND ';
    End
    Else Begin
      strSQL := strSQL + '     IF(FGO_OPRFLJ = "S", IF(FGO_OPRFLJ = "S" AND (IFNULL((SELECT                                  ';
      strSQL := strSQL + '                                                             TD.FDO_BAIXAD                         ';
      strSQL := strSQL + '                                                           FROM                                    ';
      strSQL := strSQL + '                                                             TINDOR TD                             ';
      strSQL := strSQL + '                                                           WHERE                                   ';
      strSQL := strSQL + '                                                             TD.FDO_NUMDOC = FATDOR.FDO_NUMDOC AND ';
      strSQL := strSQL + '                                                             TD.FDO_ESPDOC = FATDOR.FDO_ESPDOC AND ';
      strSQL := strSQL + '                                                             TD.FDO_CODEMP = FATDOR.FDO_CODEMP AND ';
      strSQL := strSQL + '                                                             TD.FDO_CODCLI = FATDOR.FDO_CODCLI AND ';
      strSQL := strSQL + '                                                             TD.FDO_CODITE = FATDOR.FDO_CODITE AND ';
      strSQL := strSQL + '                                                             TD.FDO_CODACA = FATDOR.FDO_CODACA AND ';
      strSQL := strSQL + '                                                             TD.FDO_EMPACA = FATDOR.FDO_EMPACA     ';
      strSQL := strSQL + '                                                           LIMIT 1), 0) = 0), 1, 0), 1) = 1 AND    ';
    End;

    strSQL := strSQL + '  FDO_ESPDOC = "PD" AND ';

    strSQL := strSQL + ' ( ';
    strSQL := strSQL + '  IF(IFNULL(FGO_ENT_CD, "") = "S", FGO_EMP_CD, ';
    strSQL := strSQL + '    IF(IFNULL(FGO_EMP_TE, "") <> "", FGO_EMP_TE, ';
    strSQL := strSQL + '      IF(IFNULL(FGO_EMPFOR, "") <> "", FGO_EMPFOR, ';
    strSQL := strSQL + '        IF(IFNULL(FDO_EMPITE, "") <> "", FDO_EMPITE, ';
    strSQL := strSQL + '          IF(IFNULL(FGO_OPRFLJ, "") = "S", FDO_EMPPRD, FGO_CODEMP))))) = :CODEMP ';
    strSQL := strSQL + ' OR ( FGO_OPRFLJ = "S" AND FDO_EMPPRD = :CODEMP ) AND (IFNULL(FGO_ENT_CD, "N") = "N") ) ';

    {***********************************************************************************************}
    {* QUANDO FOR PRODUTO ESTRUTURA SOMENTE RESERVA ESTOQUE QUANDO A ORDEM DE PRODUCAO FOR BAIXADA *}
    {* POIS ENQUANTO NAO BAIXAR ESTARA RESERVANDO O ESTOQUE DOS SUB.PRODUTOS                       *}
    {*******************************************************************************************JC**}
    If (fCfgSis('BXSBIT') = '3') Or ((fCfgSis('BXSBIT') = '2') And (fCfgSis('EMOPPD') = 'S')) Then
        strSQL := strSQL + '  AND IF(IFNULL(FDO_ORDPRO, "") = "", TRUE, PRO_DTABAI IS NOT NULL) ';

    {*******************************************}
    {* A RESERVA DE ESTOQUE SERA DOS SUB-ITENS *}
    {***************************************JC**}
    If (fCfgSis('BXSBIT') = '2') And (fCfgSis('EMOPPD') = 'N') Then
    Begin
      strSQL := strSQL + '  AND IFNULL(FDO_BXSBIT,"N") <> "S" ';
    End;

    If infTipoInfo = infItemPigmento Then
      strSQL := strSQL + '   AND  B.BAS_CODITE = :CODITE '
    Else
    strSQL := strSQL + '   AND  FDO_CODITE = :CODITE ';

    Case infTipoInfo Of
      infVenda        : strSQL := strSQL + ' AND LOCATE("PEDIDO DE RESERVA DE ESTOQUE OP-", FGO_MEN001) = 0 ';
      infOrdPro       : strSQL := strSQL + ' AND LOCATE("PEDIDO DE RESERVA DE ESTOQUE OP-", FGO_MEN001) > 0 ';
    End;

    If infTipoInfo =  infEnderecamento Then
      strSQL := strSQL + '   AND IFNULL(FGO_DOCEND, "") <> "" AND IFNULL(FGO_BKPEND, "") = ""'
    Else
      strSQL := strSQL + '   AND IFNULL(FGO_DOCEND, "") = "" ';

    If infTipoInfo = infItemPigmento Then
    Begin
      strSQL := strSQL + '     AND (DUP_BASE01 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE02 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE03 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE04 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE05 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE06 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE07 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE08 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE09 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE10 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE11 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE12 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE13 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE14 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE15 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE16 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE17 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE18 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE19 = B.BAS_CODBAS OR ';
      strSQL := strSQL + '            DUP_BASE20 = B.BAS_CODBAS ) ';
    End;

    strSQL := strSQL + fMontaFiltroWhereData;

    strSQL := strSQL + 'GROUP BY ';
    strSQL := strSQL + '  FDO_NUMDOC ';
  End;

  function fCampos: string;
  begin
    Result := '';
   Result := Result + ' FDO_NUMDOC,';
   Result := Result + '  FDO_CODEMP,';
   Result := Result + '  FDO_CODVEN,';
   Result := Result + '  OPE_NOMOPE, ';
   Result := Result + '  FDO_DTAENT,';
   Result := Result + '  FDO_DTENTR,';
   Result := Result + '  FGO_PREVIS,';
   Result := Result + '  FDO_EMPITE,';
   Result := Result + '  EQU_NUMOSE,';
   Result := Result + '  EQU_STATUS,';
   Result := Result + '  CLI_CODCLI,';
   Result := Result + '  CLI_NOMCLI,';
   Result := Result + '  SUM(FDO_QTDPED) AS FDO_QTDPED,';
   Result := Result + '  SUM(FDO_QTDGAR) AS FDO_QTDGAR,';
   Result := Result + '  SUM(FDO_QTPD_F) AS FDO_QTPD_F,';
   Result := Result + '  SUM(FDO_QTDEND) AS FDO_QTDEND,';
   Result := Result + '  SUM(FDO_QTDORP) AS FDO_QTDORP,';
   Result := Result + '  FGO_CORTE_,';
   Result := Result + '  FDO_ESPDOC,';
   Result := Result + '  TABELA,';
   Result := Result + '  FGO_OPRFLJ,';
   Result := Result + '  FDO_EMPPRD,';
   Result := Result + '  FGO_DOCEND,';
   Result := Result + '  FDO_UNITAR,';

    If blnMostrarRequisicao Then
    Begin
      Result := Result  + ' CODREQ, ';
    End;

   Result := Result + '  FGO_ORDIND,';
   Result := Result + '  SEPIMP, ';
   Result := Result + '  NUMLOT ';

   If blnMostrarCidadeCliente Then
   Begin
     Result := Result + ',   CID_NOMCID,';
     Result := Result + '    CID_ESTADO ';
   End;
   Result := Result + ',  DEVPEN ';
  End;

begin
   strSQL := '';
   pSqlPedido_OrdemProducao_ou_Venda(infVenda);//Venda
   strSQL := strSQL + 'UNION ALL ';
   pSqlPedido_OrdemProducao_ou_Venda(infOrdPro);//Ordem de Produtocao
   strSQL := strSQL + 'UNION ALL ';
   pSqlPedido_OrdemProducao_ou_Venda(infEnderecamento);//Endereçamento


  if VS_blnUsaItemPigmento And Not fTabelaVazia('DUP_CADBAS', False) Then
  Begin
     strSQL := strSQL + 'UNION ALL ';
     pSqlPedido_OrdemProducao_ou_Venda(infItemPigmento)
  End;


  if VS_blnUsaItemPigmento And Not fTabelaVazia('DUP_CADBAS', False) Then
  Begin
     strSQL := strSQL + 'UNION ALL ';
     pSqlPedido_OrdemProducao_ou_Venda(infItemPigmento)
  End;

  {*******************************************************************************}
  {* CARREGA PEDIDOS EM QUE O PRODUTO "NAO" FOI INSERIDO, MAS É UM SUB.PRODUTO   *}
  {* DE UMA ESTRUTURA INSERIDA NESTE DOCUMENTO. ENQUANTO A ORDEM DE PRODUCAO NAO *}
  {* FOR BAIXADA O SISTEMA IRA RESERVAR O ESTOQUE DOS SUB.PRODUTOS. APOS A BAIXA *}
  {* IRA RESERVAR O ESTOQUE DO PRODUTO PRONTO (ESTRUTURA)                        *}
  {***************************************************************************JC**}

  If (Not fCfgSis('OPREST', varBoolean)) And ((fCfgSis('BXSBIT') = '3') Or ((fCfgSis('BXSBIT') = '2') And (fCfgSis('EMOPPD') = 'S')))  Then
  Begin
    strSQL := strSQL + 'UNION ALL ';

    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   FDO_NUMDOC, ';
    strSQL := strSQL + '   FDO_CODEMP, ';
    strSQL := strSQL + '   FDO_CODVEN, ';
    strSQL := strSQL + '   OPE_NOMOPE, ';
    strSQL := strSQL + '   FDO_DTAENT, ';
    strSQL := strSQL + '   FDO_DTENTR, ';
    strSQL := strSQL + '   FGO_PREVIS, ';
    strSQL := strSQL + '   FDO_EMPITE, ';
    strSQL := strSQL + '   EQU_NUMOSE, ';
    strSQL := strSQL + '   IF(EQU_STATUS = "E", "EM ABERTO", ' +
                       '   IF(EQU_STATUS = "F", "ORCAMENTO REALIZADO", ' +
                       '   IF(EQU_STATUS = "A" AND EQU_SUBSTA = "N", "REPROVADA", ' +
                       '   IF(EQU_STATUS = "A", "APROVADA", ' +
                       '   IF(EQU_STATUS = "R", "REALIZADA", ""))))) AS EQU_STATUS, ';
    strSQL := strSQL + '   CLI_CODCLI,  ';
    strSQL := strSQL + '   CLI_NOMCLI,  ';
    strSQL := strSQL + '   0 AS FDO_QTDPED, ';
    strSQL := strSQL + '   0 AS FDO_QTDGAR, ';
    strSQL := strSQL + '   0 AS FDO_QTPD_F, ';
    strSQL := strSQL + '   0 AS FDO_QTDEND, ';
    strSQL := strSQL + '   SUM(COALESCE((PRO_QTDAPR - IFNULL(FDO_QTDBAI, 0)) * DOP_QTDITE,0)) FDO_QTDORP, ';
    strSQL := strSQL + '   FGO_CORTE_, ';
    strSQL := strSQL + '   FDO_ESPDOC, ';
    strSQL := strSQL + '   "FATDOR" AS TABELA, ';
    strSQL := strSQL + '   FGO_OPRFLJ, ';
    strSQL := strSQL + '   FDO_EMPPRD, ';
    strSQL := strSQL + '   FGO_DOCEND, ';
    strSQL := strSQL + '   FDO_UNITAR, ';

    If blnMostrarRequisicao Then
    Begin
     strSQL := strSQL + '  CONCAT(RCD_CODIGO, "-", RCD_CODEMP) AS CODREQ, ';
    End;

    strSQL := strSQL + '   FGO_ORDIND,  ';
    strSQL := strSQL + '   IF(IFNULL(FATGOR.FGO_SEPIMP,"") IN ("","N","0"),"NÃO","SIM") AS SEPIMP, ';

    strSQL := strSQL + '   IF(IFNULL(FATGOR.FGO_SEPIMP,"") IN ("","N","0"), "", ';
    strSQL := strSQL + '   ( SELECT  ';
    strSQL := strSQL + '         GROUP_CONCAT(LDO_NUMLOT SEPARATOR " / ") ';
    strSQL := strSQL + '     FROM LOTDOR ';
    strSQL := strSQL + '     WHERE LDO_SEQFDO = FATDOR.AUTOINCREM )) AS NUMLOT ';

    If blnMostrarCidadeCliente Then
    Begin
      strSQL := strSQL + ',   CID_NOMCID,                       ';
      strSQL := strSQL + '    CID_ESTADO                        ';
    End;
    strSQL := strSQL + '  ,(IFNULL(DIGCON.DIC_QTDDEV,0) - IFNULL(DEVVEN.DEV_QTDBAI,0)) AS DEVPEN ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   FATDOR ';
    strSQL := strSQL + '   JOIN CADCLI      ON CLI_CODCLI        = FDO_CODCLI ';
    strSQL := strSQL + '   JOIN FATGOR      ON FATGOR.AUTOINCREM = FDO_SEQGER ';
    strSQL := strSQL + '   LEFT JOIN EXTDOR      ON FATDOR.AUTOINCREM = FDO_SEQFDO ';

    If blnMostrarRequisicao Then
    Begin
     strSQL := strSQL + '  LEFT JOIN MOVRCD ON RCD_DOCPDV = FDO_NUMDOC AND RCD_EMPPDV = FDO_CODEMP AND RCD_ESPPDV = FDO_ESPDOC AND RCD_CODITE = FDO_CODITE ';
    End;

    strSQL := strSQL + '   LEFT JOIN EXTGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
    strSQL := strSQL + '   LEFT JOIN EQUGER ON FATDOR.FDO_NUMDOC = EQUGER.EQU_NUMPED ';
    strSQL := strSQL + '                   AND FATDOR.FDO_CODEMP = EQUGER.EQU_EMPPED ';
