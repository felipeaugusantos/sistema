function fDocumentoEstaEmRomaneio(strNumDoc, strEspDoc, strCodEmp: String; strCodCli: String=''; blnMostraMensag: Boolean=True): Boolean;
  Var
    qryGen: TUniQuery;
    strSQL: String;
begin
  Try
    qryGen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CONCAT(GER_NUMROM,"-",GER_EMPROM) AS GER_NUMROM ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ROMGERX ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  GER_CODEMP = :CODEMP ';    
    If Not fEmptyStr(strCodCli) Then
     strSQL := strSQL + '  AND GER_CODCLI = :CODCLI ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      If Not fEmptyStr(strCodCli) Then
        ParamByName('CODCLI').AsString := strCodCli;
      Open;

      Result := Not fEmptyStr(FieldByName('GER_NUMROM').AsString);

      If Result Then
      Begin
        fMensagem('Atenção', 'O documento '+Concat(strNumDoc,'-',strEspDoc,'-',strCodEmp)+' está vinculado ao romaneio '+FieldByName('GER_NUMROM').AsString+
                             ' e o sistema está configurado para liberar documentos para o romaneio somente após a expedição (CFG_ROLBEX). Sendo assim, só '+
                             'será permitido limpar a expedição deste documento após removê-lo do romaneio.', ['&Ok']);
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

