function fValidaPeriodo(strDtaIni, strDtaFin: String): Boolean;
const
  ATALHOS_CXDATEEDIT = 'hoje_amanhã_ontem_segunda-feira_terça-feira'+
                       '_quarta-feira_quinta-feira_sexta-feira_sabado_domingo'+
                       '_primeiro_segundo_terceiro_quarto_quinto_sexto_sétimo_bom_eom';
begin
  Result := True;
  {*****************************************}
  {* CASO A DATA INICIAL SEJA VAZIA, OK    *}
  {**************************************MV*}
  If Not fEmptyStr(fTiraCaracEspeciais(strDtaIni)) Then
  Begin
    Try
      if Pos(strDtaFin.ToUpper, ATALHOS_CXDATEEDIT.ToUpper) > 0  then
        Exit;

      If StrToDate(strDtaFin) < StrToDate(strDtaIni) Then
      Begin
        Result := False;
