function RetornaDataValidadeArquivoPEM(const ACaminhoArquivo: String): TDateTime;
  Var
    LDadosArquivo,
    LStringData: String;

    LFile: TextFile;

    LPos: Integer;

    LMeses: TStringList;
Begin
  Result := 0;

  If Not FileExists(ACaminhoArquivo) Then
    Exit;

  Try
    LMeses := TStringList.Create;
    LMeses.Add('JAN');
    LMeses.Add('FEB');
    LMeses.Add('MAR');
    LMeses.Add('APR');
    LMeses.Add('MAY');
    LMeses.Add('JUN');
    LMeses.Add('JUL');
    LMeses.Add('AUG');
    LMeses.Add('SEP');
    LMeses.Add('OCT');
    LMeses.Add('NOV');
    LMeses.Add('DEC');

    AssignFile(LFile, ACaminhoArquivo);

    Reset(LFile);

    LStringData := '';

    While Not EOF(LFile) do
    Begin
      Readln(LFile, LDadosArquivo);
      LPos := Pos('NOTAFTER=', LDadosArquivo.ToUpper);
      if (LPos <> 0) then
      begin
        LStringData := Trim(Copy(LDadosArquivo, LPos + 9, 25));
        Break;
      end;
    end;

    If Not LStringData.IsEmpty Then
      Result := StrToDate(Copy(LStringData, 5, 2) + '/' +
                          (LMeses.IndexOf(Copy(LStringData.ToUpper, 1, 3)) + 1).ToString + '/' +
                          Copy(LStringData, 17, 4));
  Finally
    CloseFile(LFile);

    FreeAndNil(LMeses);
  End;

End;

