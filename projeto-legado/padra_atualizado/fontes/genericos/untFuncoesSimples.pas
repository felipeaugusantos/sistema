    LQuery.SQL.Add('FROM ');
    LQuery.SQL.Add('  (SELECT ');
    LQuery.SQL.Add('    LOG_VERPRO, ');
    LQuery.SQL.Add('    COUNT(0) AS QTD ');
    LQuery.SQL.Add('  FROM ');
    LQuery.SQL.Add('    LOGACE ');
