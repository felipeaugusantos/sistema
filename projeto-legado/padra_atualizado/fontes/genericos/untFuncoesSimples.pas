function fExisteRegistroPREPTEDocumento(strDocAbs, strEspAbs, strEmpAbs: String; strCodIte: String = ''):Boolean;
var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery();

  Try
    qryAux.SQL.Add('  SELECT                      ');
    qryAux.SQL.Add('    AUTOINCREM                ');
    qryAux.SQL.Add('  FROM                        ');
    qryAux.SQL.Add('    PREPTE                    ');
    qryAux.SQL.Add('  WHERE                       ');
    qryAux.SQL.Add('        PRE_DOCABS = :DOCABS  ');
    qryAux.SQL.Add('    AND PRE_ESPABS = :ESPABS  ');
    qryAux.SQL.Add('    AND PRE_EMPABS = :EMPABS  ');

    If (Not fEmptyStr(strCodIte)) Then
      qryAux.SQL.Add('  AND PRE_CODITE = :CODITE  ');

    qryAux.SQL.Add('  LIMIT 1                     ');

    qryAux.ParamByName('DOCABS').AsString := strDocAbs;
    qryAux.ParamByName('ESPABS').AsString := strEspAbs;
    qryAux.ParamByName('EMPABS').AsString := strEmpAbs;

    If (Not fEmptyStr(strCodIte)) Then
      qryAux.ParamByName('CODITE').AsString := strCodIte;

    qryAux.Open;

    Result := (Not qryAux.IsEmpty);
  Finally
    FreeAndNil(qryAux);
  End;
end;

function fOSGarantiaLoja(strNumDoc, strEspDoc, strCodEmp: String; var strNumOse: String): Boolean;
var
  strSQL: String;
  qryAux: TUniQuery;
begin
  Result := False;

  if (not fCfgSis('CONEQU', varBoolean)) then
    Exit;

  if (not fCfgSis('OSGLCP', varBoolean)) then
    Exit;

  qryAux := fCriaQuery(Nil);

  try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CONCAT(EQUGER.EQU_NUMOSE,"-",EQUGER.EQU_CODEMP) AS NUMOSE ';
    strSQL := strSQL + 'FROM EQUGER ';
    strSQL := strSQL + 'WHERE EQU_GARANT = "L" ';
    strSQL := strSQL + '  AND EQU_NUMPED = :NUMPED ';
    strSQL := strSQL + '  AND EQU_TIPPED = :ESPDOC ';
    strSQL := strSQL + '  AND EQU_EMPPED = :CODEMP ';
    strSQL := strSQL + 'UNION ';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CONCAT(EQUGER.EQU_NUMOSE,"-",EQUGER.EQU_CODEMP) AS NUMOSE ';
    strSQL := strSQL + 'FROM EQUGER ';
    strSQL := strSQL + 'INNER JOIN EQUGOR ON EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU ';
    strSQL := strSQL + 'INNER JOIN FATGOR ON EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';
    strSQL := strSQL + 'WHERE EQU_GARANT = "L" ';
    strSQL := strSQL + '  AND FGO_NUMDOC = :NUMPED  ';
    strSQL := strSQL + '  AND FGO_ESPDOC = :ESPDOC  ';
    strSQL := strSQL + '  AND FGO_CODEMP = :CODEMP ';

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('NUMPED').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.Open;

    Result := (not qryAux.IsEmpty);

    if Result then
      strNumOse := qryAux.FieldByName('NUMOSE').AsString;
  finally
    FreeAndNil(qryAux);
  end;
end;

