Function fFornecedorTemCentroCusto(strCodFor: String): Boolean;
  Var
    strSQL: String;
    qryCadCta: TUniQuery;
Begin
  If Not fCfgSis('USACTF', varBoolean) Then
  Begin
    Result := True;
  End Else
  Begin
    qryCadCta := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT COUNT(*) AS QTD ';
    strSQL := strSQL + 'FROM            ';
    strSQL := strSQL + '  CADCTA C      ';
    strSQL := strSQL + '  LEFT JOIN CTARES R ON CRE_CODCTA   = CTA_CODCTA ';
    strSQL := strSQL + '  LEFT JOIN CTAGER G ON R.CRE_CODCRE = G.CRE_CODCRE ';
    strSQL := strSQL + ' WHERE C.CTA_CODCTA IN (SELECT CTF_CODCTA ';
    strSQL := strSQL + ' FROM CTAFOR ';
    strSQL := strSQL + ' WHERE CTF_CODFOR = ' + QuotedStr(strCodFor);
    strSQL := strSQL + ') ';
    strSQL := strSQL + ' OR R.CRE_CODCTA IN (SELECT CTF_CODCTA ';
    strSQL := strSQL + ' FROM CTAFOR ';
    strSQL := strSQL + ' WHERE CTF_CODFOR = ' + QuotedStr(strCodFor) + ') ';

    With qryCadCta Do
    Begin
      SQL.Text := strSQL;

      Open;

      Result := FieldByName('QTD').AsInteger > 0;
    End;

    FreeAndNil(qryCadCta);
  End;
End;

