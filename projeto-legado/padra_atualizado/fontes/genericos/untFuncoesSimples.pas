function fNFePermiteInsucessoNaEntrega(const AXML: string): Boolean;
var
  LXMLDoc: IXMLDocument;
  LNodeIde, LNodeTransp: IXMLNode;
  LIndPres: String;
  LmodFrete: String;
begin
  Result := False;

  If fEmptyStr(AXML) Then
    Exit;

  LIndPres := '';
  LModFrete := '';

  LXMLDoc := TXMLDocument.Create(nil);

  try
    try
      LXMLDoc.LoadFromXML(AXML);
      LXMLDoc.Active := True;

      LNodeIde := LXMLDoc.DocumentElement.ChildNodes.FindNode('NFe');
      if LNodeIde <> nil then
        LNodeIde := LNodeIde.ChildNodes.FindNode('infNFe');

      if LNodeIde <> nil then
      begin
        LNodeTransp := LNodeIde.ChildNodes.FindNode('transp');

        LNodeIde := LNodeIde.ChildNodes.FindNode('ide');
        if (LNodeIde <> nil) and (LNodeIde.ChildNodes.FindNode('indPres') <> nil) then
          LIndPres := LNodeIde.ChildNodes.FindNode('indPres').Text;
      end;

      if (LNodeTransp <> nil) and (LNodeTransp.ChildNodes.FindNode('modFrete') <> nil) then
        LModFrete := LNodeTransp.ChildNodes.FindNode('modFrete').Text;

      Result := not ((LIndPres = '1') or (LModFrete = '9'));
    except
      On E: Exception Do
      Begin
        pMensagensErro('Falha ao processar XML da NF-e :' + E.Message, '[fNFePermiteInsucessoNaEntrega]');
        Result := False;
      End;
    end;
  finally
    LXMLDoc.Active := False;
    LXMLDoc := nil;
  end;
end;

function fValidaUltimaAlteracaoSenhaOperador(const strOperador: string): Boolean;
var
  dtaDataAlteracaoSenha: TDate;
  varValor : Variant;
  intDiasExpiracao: Integer;
begin
  Try
    varValor :=  fCampoTabela('OPE_ALTSEN', 'CADOPE', ['OPE_CODOPE'], [strOperador]);

    If VarIsNull(varValor) or VarIsEmpty(varValor) or (VarType(varValor) <> varDate) or
      (varValor = EncodeDate(1899, 12, 30)) Then
      Exit(False);

    Try
      dtaDataAlteracaoSenha := varValor;
    Except
      Exit(False);
    End;

    intDiasExpiracao := fCfgSis('EXPSEN', varInteger);

    If intDiasExpiracao <= 0 Then
      Exit(False);

    Result := ((VS_Date - dtaDataAlteracaoSenha) > intDiasExpiracao);
  Except
    On E: Exception Do
    Begin
      Raise Exception.CreateFmt('Erro ao validar a última alteração da senha do Operador: %s ', [E.Message]);
    End;
  End;
end;

function fValidaSenhaExpiradaOperador(const strOperador: string): Boolean;
var
  blnUltimaAlteracaoExpirada: Boolean;
  strSenhaExpirada : string;
begin
  Try
    blnUltimaAlteracaoExpirada := fValidaUltimaAlteracaoSenhaOperador(strOperador);

    strSenhaExpirada := fRetCarregaSituacaoSenha(strOperador);

    If (blnUltimaAlteracaoExpirada) and (strSenhaExpirada = 'N') Then
    Begin
      fExpirarOuLiberarSenha(strOperador, ssExpirada);

      strSenhaExpirada := fRetCarregaSituacaoSenha(strOperador);
    End;

    Result := strSenhaExpirada = 'S';
  Except
    On E: Exception Do
    Begin
      Raise Exception.CreateFmt('Erro ao validar se a senha do Operador expirou: %s ', [E.Message]);
    End;
  End;
end;

function fExpirarOuLiberarSenha(const strOperador: String; const Situacao: TSituacaoSenha): Boolean;
var
  strStatusExpiracao, strDataAlteracao, strCondicaoOperador, strUpdateSQL: String;
  blnAtualizaData, blnAtualizaStatusExpira: Boolean;
begin
  strDataAlteracao := 'NULL';
  blnAtualizaData := False;
  blnAtualizaStatusExpira := Situacao <> ssApenasDataAlteracao;

  Case Situacao Of
    ssNovoCadastro:
      Begin
        strStatusExpiracao := 'N';
        blnAtualizaData := True;
      End;

    ssExpirada:
      Begin
        strStatusExpiracao := 'S';
        blnAtualizaData := False;
      End;

    ssTrocaSenha:
      Begin
        strStatusExpiracao := 'N';
        blnAtualizaData := True;
      End;

    ssApenasDataAlteracao:
      Begin
        blnAtualizaData := True;
      End;
  End;

  if blnAtualizaStatusExpira then
    strUpdateSQL := 'OPE_SENEXP = ' + QuotedStr(strStatusExpiracao);

  if blnAtualizaData then
  begin
    strDataAlteracao := QuotedStr(FormatDateTime('YYYY-MM-DD', VS_Date));

    if strUpdateSQL <> '' then
      strUpdateSQL := strUpdateSQL + ', ';

    strUpdateSQL := strUpdateSQL + 'OPE_ALTSEN = ' + strDataAlteracao;
  end;

  if strOperador <> '' then
    strCondicaoOperador := ' WHERE OPE_CODOPE = ' + QuotedStr(strOperador)
  else
    strCondicaoOperador := '';

  try
    fExecutaSQL('UPDATE CADOPE SET ' + strUpdateSQL + strCondicaoOperador);
    Result := True;
  Except
    On E: Exception Do
    Begin
      Raise Exception.CreateFmt('Erro ao atualizar expiração da senha: %s ', [E.Message]);
    End;
  End;
end;

