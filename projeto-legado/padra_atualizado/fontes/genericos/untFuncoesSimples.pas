    intContador: Integer;
Begin
  strSQL := '';
  strSQL := strSQL + ' (CASE ' + strCamFre + ' ';

  For intContador := Low(TiposFrete) To High(TiposFrete) Do
      strSQL := strSQL + '   WHEN ' + intToStr(TiposFrete[intContador])  + ' THEN "' + DescricoesFrete[intContador] + '" ';

  strSQL := strSQL + ' END) ';

  Result := strSQL;
End;

procedure pRemoveLiberacao(strDirAce: string; strCodIte: string);
var
  intPosicao,
  intIndice: integer;
  blnAchou: Boolean;
begin
  blnAchou := False;
  intPosicao := -1;

  for intIndice := Low(arrLogLib) to High(arrLogLib) do
