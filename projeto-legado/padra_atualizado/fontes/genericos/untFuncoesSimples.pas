function fRetNomeGrupoServico(Const strCodGruSer: String): String;
  Var
    strSQL   : String;
    qryGruSer: TUniQuery;

begin
  Try

    qryGruSer := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  GRU_DESGRU DESGRU ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  GRUSER ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GRU_CODGRU = :CODGRU ';

    With qryGruSer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODGRU').AsString := strCodGruSer;
      Open;
      Result := FieldByName('DESGRU').AsString;
