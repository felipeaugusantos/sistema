function fCarregaCartoesTransferidos(intSeqCon: Integer; strEmpRcx: String; dtaDtaCad: TDateTime;blnNaoTransf :Boolean = false): TUniQuery;
  Var
    strSQL: String;
begin
  Try
    Result := fCriaQuery;
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  MCA_DTATRA, ';
    strSQL := strSQL + '  MCA_VALSTA, ';
    strSQL := strSQL + '  MCA_NUMCCD, ';
    strSQL := strSQL + '  MCA_SEQCON, ';
    strSQL := strSQL + '  MCA_SEQTRF ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVCAR ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  MCA_SEQCON = :SEQCON AND ';
    strSQL := strSQL + '  MCA_EMPRCX = :EMPRCX AND ';
    strSQL := strSQL + '  MCA_DTACAD >= :DTACAD AND ';
    strSQL := strSQL + '  MCA_RESCAI = 1 AND ';
    strSQL := strSQL + '  MCA_CODFIN IS NULL AND ';

    If blnNaoTransf Then
      strSQL := strSQL + ' MCA_DTATRA IS NULL'
    Else
      strSQL := strSQL + '  MCA_DTATRA IS NOT NULL ';

    Result.SQL.Add(strSQL);
    Result.ParamByName('SEQCON').AsInteger  := intSeqCon;
    Result.ParamByName('EMPRCX').AsString   := strEmpRcx;
    Result.ParamByName('DTACAD').AsDateTime := dtaDtaCad;
    Result.Open;
  Except
    On E: Exception Do
      Raise Exception.Create('Ocorreu um erro ao carregar os cartões transferidos.' + #13 +
                             'Erro gerado: ' + E.Message);
  End;
end;

