function PlanoDeContasAtivo(ACodCta : String; AMsgAlerta: Boolean = True): Boolean;
  Var
    LQryAux : TUniQuery;
    LSQL    : String;
begin
  If fEmptyStr(ACodCta) Then
    Exit(True);

  Try
    LQryAux := fCriaQuery;

    Result := False;

    LSQL := '';
    LSQL := LSQL + 'SELECT                       ';
    LSQL := LSQL + '  CTA_STATUS                 ';
    LSQL := LSQL + 'FROM                         ';
    LSQL := LSQL + '  CADCTA                     ';
    LSQL := LSQL + 'WHERE CTA_CODCTA = :CODCTA   ';

    Try
      LQryAux.Close;
      LQryAux.SQL.Clear;
      LQryAux.SQL.Add(LSQL);
      LQryAux.ParamByName('CODCTA').AsString := ACodCta;
      LQryAux.Open;
      Result := LQryAux.FieldByName('CTA_STATUS').AsString.Equals('A');

      If Not Result And AMsgAlerta Then
      Begin
        fMensagem('ATENÇÃO!', 'O Plano de Contas está Inativo!', ['&Ok']);
      End

    Except
      On E : Exception Do
      Begin
        pMensagensErro(E.Message, '[untFuncoesSimples.PlanoDeContasInativo]');
      End;
    End;
  Finally
      FreeAndNil(LQryAux);
    End;
end;

function EhVerbaDebito(ACodVer: String; AMsgAlerta: Boolean = True): Boolean;
Var
  LQryAux : TUniQuery;
  LSQL    : String;
Begin
  If fEmptyStr(ACodVer) Then
    Exit(True);

  Try
    LQryAux := fCriaQuery;

    Result := False;

    LSQL := '';
    LSQL := LSQL + 'SELECT                       ';
    LSQL := LSQL + '  VER_DEBCRE                 ';
    LSQL := LSQL + 'FROM                         ';
    LSQL := LSQL + '  CADVER                     ';
    LSQL := LSQL + 'WHERE VER_CODVER = :CODVER   ';

    Try
      LQryAux.Close;
      LQryAux.SQL.Clear;
      LQryAux.SQL.Add(LSQL);
      LQryAux.ParamByName('CODVER').AsString := ACodVer;
      LQryAux.Open;
      Result := LQryAux.FieldByName('VER_DEBCRE').AsString.Equals('D');

      If Not Result And AMsgAlerta Then
      Begin
        fMensagem('ATENÇÃO!', 'A verba não é do tipo Debito!', ['&Ok']);
      End

    Except
