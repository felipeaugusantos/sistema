function fContarString(sTexto, sString: String): Integer;
  var
    sTemp: String;
begin
  Result := 0;
  sTemp  := sString;

  While (Pos(sTexto, sTemp) > 0) Do Begin
    sTemp := Copy(sTemp, Pos(sTexto, sTemp) + 1, Length(sTemp));
    Inc(Result);
  End;
end;

