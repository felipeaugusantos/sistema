function fTemFdorSemMovGad(Const strNumDoc, strEspDoc, strCodEmp: String): Boolean;
Const
  CPO_MOVGAD: integer = 0;
Var
  Qry: TUniQuery;

  function fScripSqlFdorSemMovGad: String;
  begin
    Result :=          ' SELECT S.SEQ_MOVGAD ';
    Result := Result + ' FROM FATDOR D ';
    Result := Result + ' LEFT JOIN SEQGAR S ON S.SEQ_FDO_TE = D.AUTOINCREM ';
    Result := Result + ' WHERE D.FDO_NUMDOC = :NUMDOC AND D.FDO_ESPDOC = :ESPDOC AND D.FDO_CODEMP = :CODEMP; ';
  end;

begin
  Qry := nil;
  Result := False;
  Try
    Qry := fCriaQuery(Nil);
    Qry.Close;
    Qry.Sql.Clear;
    Qry.Sql.Add(fScripSqlFdorSemMovGad);
    Qry.ParamByName('NUMDOC').AsString := strNumDoc;
    Qry.ParamByName('ESPDOC').AsString := strEspDoc;
    Qry.ParamByName('CODEMP').AsString := strCodEmp;
    Qry.Open;
    if  Qry.Active then
    begin
      if Not Qry.IsEmpty then
      begin
        Qry.First;
        while Not Qry.EOF do
        begin
          Result := fEmptyStr(Qry.Fields[CPO_MOVGAD].AsString);
          if Result then
          begin
            Break;
          end;
          Qry.Next;
        end;
      end;
      Qry.Close;
    end;
  Finally
    if Assigned(Qry) then
      FreeAndNil(Qry);
  End;
end;

function fEhPedidoGarantiaTe(const strNumDoc, strEspDoc, strCodEmp: String): Boolean;
Const
  CPO_FGO_MEN001: Integer = 0;

  function SqlVerificarPedidoTransferencia: String;
  begin
    Result :=          ' SELECT G.FGO_MEN001 ';
    Result := Result + ' FROM FATGOR G ';
    Result := Result + ' WHERE G.FGO_NUMDOC = :NUMDOC ';
    Result := Result + '       AND G.FGO_ESPDOC = :ESPDOC ';
    Result := Result + '       AND G.FGO_CODEMP = :CODEMP ';
  end;

Var
  Qry: TUniQuery;
  blnDocPedido: Boolean;
begin
  Result := False;

  blnDocPedido  := Pos(strEspDoc,'_PD_') > 0;

  if Not blnDocPedido then
    Exit(Result);

  Qry := Nil;

  Try
    Qry := fCriaQuery();
    Qry.close;
    Qry.Sql.Clear;
    Qry.Sql.Add(SqlVerificarPedidoTransferencia);
    Qry.ParamByName('NUMDOC').AsString :=  strNumDoc;
    Qry.ParamByName('ESPDOC').AsString :=  strEspDoc;
    Qry.ParamByName('CODEMP').AsString :=  strCodEmp;
    Qry.Open;
    if Qry.Active then
    begin
      if Not Qry.IsEmpty then
      begin
        Result := (Qry.Fields[CPO_FGO_MEN001].AsString = 'GARANTIA(TE)');
      end;
      Qry.Close;
    end;
  Finally
    if Assigned(Qry) then
      FreeAndNil(Qry);
  End;
end;

