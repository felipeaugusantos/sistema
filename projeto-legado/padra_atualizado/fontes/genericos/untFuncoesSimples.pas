function fExisteLayoutLAYETI(strCodLay: String; intTipLay: Integer = 0; strCodEmp: String = ''): Boolean;
Var
  qryEti: TUniQuery;
  strSQL: String;
Begin

  Try

    qryEti := fCriaQuery(Nil);

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE        ';
    strSQL := strSQL + '  COUNT(*) AS QTDLAY       ';
    strSQL := strSQL + 'FROM                       ';
    strSQL := strSQL + '  LAYETI                   ';
    strSQL := strSQL + 'WHERE                      ';
    strSQL := strSQL + '  LAY_CODLAY = :CODLAY AND ';
    strSQL := strSQL + '  LAY_CODEMP = :CODEMP     ';

