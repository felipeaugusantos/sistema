  object cxMemo1: TcxMemo [2]
    Left = 0
    Top = 0
    Align = alClient
    Lines.Strings = (
      'INSTRU'#199#213'ES'
      ''
      
        'N'#195'O FOI POSS'#205'VEL CAPTURAR AUTOMATICAMENTE A DATA E HORA DA GRAVA' +
        #199#195'O DO SOFTWARE '
      'B'#193'SICO DO ECF, PORTANTO SER'#193' NECESS'#193'RIO INFORM'#193'-LOS MANUALMENTE.'
      ''
      'SIGA AS INSTRU'#199#213'ES ABAIXO'
      ''
      
        '1) CLIQUE NO BOT'#195'O "IMPRIMIR LMF". SER'#193' IMPRESSO NO ECF UM RELAT' +
        #211'RIO DE LEITURA DA '
      'MEM'#211'RIA '
      'FISCAL.'
      'ESTA OPERA'#199#195'O PODE DEMORAR DEPENDENDO DA CONEX'#195'O DO TS.'
      ''
      
        '2) PROCURE NO RODAP'#201' DO RELAT'#211'RIO UMA SE'#199#195'O PARECIDA COM A MOSTR' +
        'ADA ABAIXO:'
      ''
      '             DADOS GERAIS'
      '         SOFTWARE B'#193'SICO'
      '01.00.01                  DD/MM/AAAA HH:MM:SS'
      ''
      
        'A PRIMEIRA COLUNA '#201' A VERS'#195'O DO SOFTWARE B'#193'SICO. A SEGUNDA COLUN' +
        'A '#201' A DATA E HORA DE '
      'GRAVA'#199#195'O DO SOFTWARE B'#193'SICO.'
      ''
      '3) INFORME O VALOR DA SEGUNDA COLUNA NO CAMPO "DATA E HORA DE '
      
        'GRAVA'#199#195'O DO SW B'#193'SICO", EXATAMENTE COMO EST'#193' IMPRESSO NO RELAT'#211'R' +
        'IO.'
      ''
      '4) CLIQUE EM GRAVAR.'
      ''
      
        'ESSAS CONFIGURA'#199#195'O MANUAL DEVE SER FEITA APENAS UMA VEZ PARA ESS' +
        'E ECF.'
      ''
      
        'EM CASO DE D'#218'VIDAS, POR FAVOR ENTRAR EM CONTATO COM SUPORTE DA C' +
        'ITEL SOFTWARE')
    Properties.ReadOnly = True
    TabOrder = 2
    Height = 424
    Width = 522
  end
