      'begin'
      '  If <frxIteFor."QTDPRO"> > 0 Then'
      '    mmoDesIte.Width := 249'
      '  Else'
      '    mmoDesIte.Width := 673;'
      ''
      
        '  grfDispersao.Visible := (<frxIteFor."DISPER"> = '#39'S'#39') And <FORM' +
        'ULACAO>;'
      'end;'
      ''
      'procedure ChildEnvaseOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  rlbTitulo.Visible := False;'
      'end;'
      ''
      'procedure ChildEnvaseOnAfterPrint(Sender: TfrxComponent);'
      'begin'
      '  rlbCabecalho.Visible := False;'
      'end;'
      ''
      'procedure grhDispersaoOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      
        '  grhDispersao.Visible := (<frxIteFor."DISPER"> = '#39'S'#39') And <FORM' +
        'ULACAO>;'
      'end;'
      ''
      'procedure grfDispersaoOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      'end;'
      ''
      ''
      'procedure fooFormulOnAfterPrint(Sender: TfrxComponent);'
      'begin'
      '   rlbTitulo.Visible := False;'
      'end;'
      ''
      'procedure ChildPagDoisOnAfterPrint(Sender: TfrxComponent);'
