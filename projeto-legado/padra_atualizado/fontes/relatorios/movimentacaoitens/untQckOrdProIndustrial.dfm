        '  //grhDispersao.Visible := (<frxIteFor."DISPER"> = '#39'S'#39') And <FO' +
        'RMULACAO>;'
      'end;'
      ''
      'procedure grfDispersaoOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      'end;'
      ''
