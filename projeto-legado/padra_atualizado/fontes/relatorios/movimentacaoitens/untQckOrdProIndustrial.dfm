      ''
      ''
      'begin'
      
        'frxGlobalVariables['#39'CopyName0'#39'] := '#39'Original'#39';             // co' +
        'py viewed in the preview'
      
        'frxGlobalVariables['#39'CopyName1'#39'] := '#39'First copy'#39';   // 1st printe' +
        'd/exported copy'
      
        'frxGlobalVariables['#39'CopyName2'#39'] := '#39'Second copy'#39';  // 2nd printe' +
        'd copy'
      
        'frxGlobalVariables['#39'CopyName3'#39'] := '#39'Third copy'#39';   // 3rd printe' +
        'd copy'
      ''
      'end.')
