<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PreviewOptions.ZoomMode="zmWholePage" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40268,3924298264" ScriptLanguage="PascalScript" ScriptText.Text="procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  CDetalhes.Visible := (&#60;frxRelatorio.&#34;CTP_NUMDOC&#34;&#62; &#60;&#62; '') Or blnHisCom;&#13;&#10;&#13;&#10;  If CDetalhes.Visible Then&#13;&#10;  Begin              &#13;&#10;    rllHistCom.Visible := blnHisCom;&#13;&#10;    rllDocum.Visible   := (Trim(&#60;frxRelatorio.&#34;CTP_NUMDOC&#34;&#62;) &#60;&#62; '');&#13;&#10;    rdbDocum.Visible   := (Trim(&#60;frxRelatorio.&#34;CTP_NUMDOC&#34;&#62;) &#60;&#62; '');&#13;&#10;    rllHisBai.Visible  := (Trim(&#60;frxRelatorio.&#34;CTP_HISBAI&#34;&#62;) &#60;&#62; '');&#13;&#10;    If Not blnHisCom Then&#13;&#10;      rllHisBai.Top := rllHistCom.Top;&#13;&#10;  End;&#13;&#10;&#13;&#10;  If &#60;frxRelatorio.&#34;CTP_VEIOBO&#34;&#62; = 'S' Then&#13;&#10;    rdbBoleto.Text := 'SIM'&#13;&#10;  Else&#13;&#10;    rdbBoleto.Text := 'NAO';&#13;&#10;&#13;&#10;  If &#60;frxRelatorio.&#34;CTP_USACHQ&#34;&#62; = 'S' Then&#13;&#10;    rdbCheque.Text := 'SIM'&#13;&#10;  Else&#13;&#10;    rdbCheque.Text := 'NAO';      &#13;&#10;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbCabecalhoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTitLoja.Visible   := (strModRel &#60;&#62; '2');&#13;&#10;  rllTitBoleto.Visible := (strModRel &#60;&#62; '2');   &#13;&#10;  rllTitCheque.Visible := (strModRel &#60;&#62; '2');      &#13;&#10;  rdbLoja.Visible      := (strModRel &#60;&#62; '2');      &#13;&#10;  rdbBoleto.Visible    := (strModRel &#60;&#62; '2');      &#13;&#10;  rdbCheque.Visible    := (strModRel &#60;&#62; '2');      &#13;&#10;end;&#13;&#10;&#13;&#10;Begin            &#13;&#10;&#13;&#10;end." PropData="">
