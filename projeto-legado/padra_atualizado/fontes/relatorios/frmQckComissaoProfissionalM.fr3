<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="0,77" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39525,6001820833" ReportOptions.Description.Text="" ReportOptions.LastChange="40095,6534181481" ScriptLanguage="PascalScript" ScriptText.Text="//JATO&#13;&#10;&#13;&#10;Var&#13;&#10;  strCreDeb: String;&#13;&#10;  strCreDebSI: String;      &#13;&#10;  fltTotPro: Double;&#13;&#10;  fltTotProComi: Double;      &#13;&#10;  fltTotGer: Double;&#13;&#10;  fltTotGerComi: Double;      &#13;&#10;  fltTotGerSint: Double;&#13;&#10;  fltTotGerComiSint: Double;&#13;&#10;              &#13;&#10;    &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rlbDetalhesOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotPro := fltTotPro + IIF(&#60;frxRelatorio.&#34;COM_CREDEB&#34;&#62; = 'C', &#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62;, -&#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62;);&#13;&#10;  fltTotGer := fltTotGer + IIF(&#60;frxRelatorio.&#34;COM_CREDEB&#34;&#62; = 'C', &#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62;, -&#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62;);&#13;&#10;  fltTotProComi := fltTotProComi + IIF(&#60;frxRelatorio.&#34;COM_CREDEB&#34;&#62; = 'C', &#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62;, -&#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62;);&#13;&#10;  fltTotGerComi := fltTotGerComi + IIF(&#60;frxRelatorio.&#34;COM_CREDEB&#34;&#62; = 'C', &#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62;, -&#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62;);&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbTotCliOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotPro := fltTotPro + fRetSalVen;       &#13;&#10;  &#13;&#10;  If fltTotPro &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := 'D';&#13;&#10;    fltTotPro := fltTotPro * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := 'C';    &#13;&#10;    &#13;&#10;  rllTotPro.Text    := FormatFloat('#,##0.00', fltTotPro);&#13;&#10;  rllCreDebPro.Text := strCreDeb;                                                           &#13;&#10;&#13;&#10;  fltTotPro := 0;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  If fltTotGer &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := 'D';&#13;&#10;    fltTotGer := fltTotGer * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := 'C';    &#13;&#10;    &#13;&#10;  rllTotGer.Text    := FormatFloat('#,##0.00', fltTotGer);&#13;&#10;  rllCreDebGer.Text := strCreDeb;                                                           &#13;&#10;&#13;&#10;  fltTotGer := 0;  &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbQtdPtoSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  fltTotGerSint := fltTotGerSint + &#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62; + fRetSalVen;&#13;&#10;&#13;&#10;  If &#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62; &#60; 0 Then&#13;&#10;    rdbVrVendSint.Text := FormatFloat('#,##0.00', ((&#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62; + fRetSalVen) * (-1))) + ' D'&#13;&#10;  Else&#13;&#10;    rdbVrVendSint.Text := FormatFloat('#,##0.00', &#60;frxRelatorio.&#34;COM_VRVEND&#34;&#62;   + fRetSalVen) + ' C';                                                                                                           &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  If fltTotGerSint &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := ' D';&#13;&#10;    fltTotGerSint := fltTotGerSint * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := ' C';    &#13;&#10;    &#13;&#10;  rllTotGerSint.Text    := FormatFloat('#,##0.00', fltTotGerSint) + strCreDeb;&#13;&#10;&#13;&#10;  fltTotGerSint := 0;  &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbVrComiSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotGerComiSint := fltTotGerComiSint + &#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62; + fRetSalCom;&#13;&#10;&#13;&#10;  If &#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62; &#60; 0 Then&#13;&#10;    rdbVrComiSint.Text := FormatFloat('#,##0.00', ((&#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62; + fRetSalCom) * (-1))) + ' D'&#13;&#10;  Else&#13;&#10;    rdbVrComiSint.Text := FormatFloat('#,##0.00', &#60;frxRelatorio.&#34;COM_VRCOMI&#34;&#62; + fRetSalCom) + ' C';                                                                                                           &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerComSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If fltTotGerComiSint &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := ' D';&#13;&#10;    fltTotGerComiSint := fltTotGerComiSint * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := ' C';    &#13;&#10;    &#13;&#10;  rllTotGerComSint.Text    := FormatFloat('#,##0.00', fltTotGerComiSint) + strCreDeb;&#13;&#10;&#13;&#10;  fltTotGerComiSint := 0;  &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotProComiOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotProComi := fltTotProComi + fRetSalCom;&#13;&#10;    &#13;&#10;  If fltTotProComi &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := 'D';&#13;&#10;    fltTotProComi := fltTotProComi * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := 'C';    &#13;&#10;    &#13;&#10;  rllTotProComi.Text:= FormatFloat('#,##0.00', fltTotProComi);&#13;&#10;  rllCreDebPro.Text := strCreDeb;                                                           &#13;&#10;&#13;&#10;  fltTotProComi := 0;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotComiGerOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If fltTotGerComi &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := 'D';&#13;&#10;    fltTotGerComi := fltTotGerComi * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := 'C';    &#13;&#10;    &#13;&#10;  rllTotComiGer.Text:= FormatFloat('#,##0.00', fltTotGerComi);&#13;&#10;  rllCreDebGer.Text := strCreDeb;                                                           &#13;&#10;&#13;&#10;  fltTotGerComi := 0;  &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbSumarioGrupoOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbSumarioGrupoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotGer    := fltTotGer     + fRetSalVen;&#13;&#10;  fltTotGerComi:= fltTotGerComi + fRetSalCom;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbVrVendSintSalOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  Var&#13;&#10;    fltValor: Double;&#13;&#10;      &#13;&#10;begin&#13;&#10;  fltValor := fRetSalVen;&#13;&#10;&#13;&#10;  If fltValor &#60; 0 Then&#13;&#10;    rdbVrVendSintSal.Text := FormatFloat('#,##0.00', (fltValor * (-1))) + ' D'&#13;&#10;  Else&#13;&#10;    rdbVrVendSintSal.Text := FormatFloat('#,##0.00', fltValor) + ' C';                                                                                                           &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbVrComiSintSalOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  Var&#13;&#10;    fltValor: Double;&#13;&#10;      &#13;&#10;begin&#13;&#10;  fltValor := fRetSalCom;&#13;&#10;&#13;&#10;  If fltValor &#60; 0 Then&#13;&#10;    rdbVrComiSintSal.Text := FormatFloat('#,##0.00', (fltValor * (-1))) + ' D'&#13;&#10;  Else&#13;&#10;    rdbVrComiSintSal.Text := FormatFloat('#,##0.00', fltValor) + ' C';                                                                                                           &#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllSalVenOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  Var&#13;&#10;    fltSalVen: Double;&#13;&#10;begin&#13;&#10;  fltSalVen := fRetSalVen;                                        &#13;&#10;    &#13;&#10;  If fltSalVen &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDebSI := 'D';&#13;&#10;    fltSalVen   := fltSalVen * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDebSI := 'C';    &#13;&#10;    &#13;&#10;  rllSalVen.Text:= FormatFloat('#,##0.00', fltSalVen);&#13;&#10;  rllCreDebSI.Text := strCreDebSI;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllCreDebSIOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllSalComOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  Var&#13;&#10;    fltSalCom: Double;&#13;&#10;begin&#13;&#10;  fltSalCom := fRetSalCom;                                        &#13;&#10;    &#13;&#10;  If fltSalCom &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    fltSalCom := fltSalCom * (-1);&#13;&#10;  End;      &#13;&#10;    &#13;&#10;  rllSalCom.Text:= FormatFloat('#,##0.00', fltSalCom);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbTituloGrupoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pCarregaSaldoInicial(&#60;frxRelatorio.&#34;COM_CODPRO&#34;&#62;);                   &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalheSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pCarregaSaldoInicial(&#60;frxRelatorio.&#34;COM_CODPRO&#34;&#62;);  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  strCreDeb := '';&#13;&#10;  fltTotPro := 0;&#13;&#10;  fltTotProComi := 0;      &#13;&#10;  fltTotGer := 0;    &#13;&#10;  fltTotGerComi := 0;&#13;&#10;  fltTotGerSint:= 0;&#13;&#10;  fltTotGerComiSint:= 0;      &#13;&#10;end.  " PropData="044C65667403C80003546F70025008446174617365747301010C2600000020446174615365743D2266727847656E2220446174615365744E616D653D2266727847656E2200010C3200000020446174615365743D2266727852656C61746F72696F2220446174615365744E616D653D2266727852656C61746F72696F220000095661726961626C65730100055374796C650100">
