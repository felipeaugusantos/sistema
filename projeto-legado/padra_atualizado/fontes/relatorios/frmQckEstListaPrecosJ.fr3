<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40140,4598569444" ScriptLanguage="PascalScript" ScriptText.Text="procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rldbLinhaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rldbLinha.Text := 'LINHA:' + fRetNomeLinhaGrupo(&#60;frxRelatorio.&#34;LINHA&#34;&#62; + '00');  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rldbLinhaVOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    rldbLinhaV.Text := 'LINHA:' + fRetNomeLinhaGrupo(&#60;frxRelatorio.&#34;LINHA&#34;&#62; + '00');  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  If (&#60;frxGen.&#34;blnCodBar&#34;&#62;) And (&#60;frxRelatorio.&#34;CODBAR&#34;&#62; &#60;&#62; '') Then&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBar.Visible := True;&#13;&#10;    rlbCodBar.Height  := 1;          &#13;&#10;      &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '') Then&#13;&#10;      rlbAplica.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplica.Visible := False;          &#13;&#10;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBar.Visible := False;&#13;&#10;    rlbCodBar.Height  := 0;          &#13;&#10;    &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '')Then&#13;&#10;      rlbAplica.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplica.Visible := False;&#13;&#10;                  &#13;&#10;  End;  &#13;&#10;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesVOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  &#13;&#10;  If (&#60;frxGen.&#34;blnCodBar&#34;&#62;) And (&#60;frxRelatorio.&#34;CODBAR&#34;&#62; &#60;&#62; '') Then&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBarV.Visible := True;&#13;&#10;    rlbCodBarV.Height  := 1;          &#13;&#10;      &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '') Then&#13;&#10;      rlbAplicaV.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplicaV.Visible := False;          &#13;&#10;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBarV.Visible := False;&#13;&#10;    rlbCodBarV.Height  := 0;          &#13;&#10;    &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '')Then&#13;&#10;      rlbAplicaV.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplicaV.Visible := False;&#13;&#10;                  &#13;&#10;  End;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbCabecalhoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;imagem&#34;&#62; &#60;&#62; '' Then&#13;&#10;    imgLogotip.LoadFromFile(&#60;frxGen.&#34;imagem&#34;&#62;);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbCabecalhoVOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;imagem&#34;&#62; &#60;&#62; '' Then&#13;&#10;    imgLogotip2.LoadFromFile(&#60;frxGen.&#34;imagem&#34;&#62;);  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="044C656674025803546F70023808446174617365747301010C