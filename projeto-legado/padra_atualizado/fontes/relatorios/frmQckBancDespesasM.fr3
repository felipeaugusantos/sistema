;&#10;    fltDebTot := fltDebTot + &#60;FrxRelatorio.&#34;CTB_VALLAN&#34;&#62;;  &#13;&#10;&#13;&#10;    fltSalCta := fltSalCta - &#60;FrxRelatorio.&#34;CTB_VALLAN&#34;&#62;;&#13;&#10;    fltSalRes := fltSalRes - &#60;FrxRelatorio.&#34;CTB_VALLAN&#34;&#62;;&#13;&#10;    fltSalFin := fltSalFin - &#60;FrxRelatorio.&#34;CTB_VALLAN&#34;&#62;;&#13;&#10;  End;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxRelatorio.&#34;CTB_HIST02&#34;&#62; = '' Then&#13;&#10;    Child2.Visible := False&#13;&#10;  Else&#13;&#10;    Child2.Visible := True;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltCreRes := 0;&#13;&#10;  fltDebRes := 0;&#13;&#10;  fltSalRes := 0;&#13;&#10;    &#13;&#10;  fltCreCta := 0;&#13;&#10;  fltDebCta := 0;&#13;&#10;  fltSalCta := 0;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltCreCta := 0;&#13;&#10;  fltDebCta := 0;&#13;&#10;  fltSalCta := 0;  &#13;&#10;end;&#13;&#10;&#13;&#10;Begin&#13;&#10; {**********************************}&#13;&#10; {* ZERA AS VARIAVEIS DE INICIAIS  *}     &#13;&#10; {*******************************JC*}    &#13;&#10;  &#13;&#10;  &#13;&#10;  fltCreCon := 0;&#13;&#10;  fltCreLin := 0;  &#13;&#10;  fltCreGru := 0;  &#13;&#10;  fltCreGer := 0;  &#13;&#10;  &#13;&#10;  fltDebCon := 0;    &#13;&#10;  fltDebLin := 0;    &#13;&#10;  fltDebGru := 0;  &#13;&#10;  fltDebGer := 0;&#13;&#10;                                &#13;&#10;  fltSaldoF := 0;&#13;&#10;&#13;&#10;  fltSalRes := 0;&#13;&#10;  fltSalCta := 0;&#13;&#10;  fltSalFin := 0;      &#13;&#10;    &#13;&#10;  fltCreRes := 0;&#13;&#10;  fltCreCta := 0;&#13;&#10;  fltCreTot := 0;&#13;&#10;    &#13;&#10;  fltDebRes := 0;&#13;&#10;  fltDebCta := 0;&#13;&#10;  fltDebTot := 0;  &#13;&#10;    &#13;&#10;end." PropData="044C65667403C90003546F70022A0844