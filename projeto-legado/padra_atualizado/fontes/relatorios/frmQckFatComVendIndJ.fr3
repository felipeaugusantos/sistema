<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40031,5714111227" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  vr_margem_tot, vr_custo_tot : double;&#13;&#10;  vr_margem_fin, vr_custo_fin : double;&#13;&#10;&#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rlbDetalhesOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin   &#13;&#10;  //If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then   &#13;&#10;  //Begin    &#13;&#10;    vr_margem_tot := vr_margem_tot + rllTotal.Value;&#13;&#10;    vr_custo_tot := vr_custo_tot + rllVrCusto.value;        &#13;&#10;  //End;     &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  //Begin&#13;&#10;    If (vr_margem_tot &#60;&#62; 0) and (vr_custo_tot &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;        rllMargemTot.Text  := Formatfloat('#,##0.00',( ( vr_margem_tot  / vr_custo_tot ) *100 )-100)&#13;&#10;      Else&#13;&#10;        rllMargemTot.Text := Formatfloat('#,##0.00',( 1-( vr_custo_tot / vr_margem_tot ) )*100);&#13;&#10;    End  &#13;&#10;    Else&#13;&#10;    Begin          &#13;&#10;      If (vr_custo_tot = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;        rllMargemTot.text := '100,00'                                                                         &#13;&#10;      Else                &#13;&#10;        rllMargemTot.text := '0,00';&#13;&#10;    End;                                                                               &#13;&#10;&#13;&#10;    vr_margem_fin := vr_margem_fin + vr_margem_tot;&#13;&#10;    vr_custo_fin := vr_custo_fin + vr_custo_tot;&#13;&#10;      &#13;&#10;    vr_margem_tot := 0;&#13;&#10;    vr_custo_tot := 0;&#13;&#10;  //End;                  &#13;&#10;        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  //Begin&#13;&#10;    If (vr_margem_fin &#60;&#62; 0) and (vr_custo_fin &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;       rllMargemTotGer.Text  := Formatfloat('#,##0.00',( ( vr_margem_fin  / vr_custo_fin ) *100 )-100)  &#13;&#10;      Else&#13;&#10;       rllMargemTotGer.Text := Formatfloat('#,##0.00',( 1-( vr_custo_fin / vr_margem_fin ) )*100);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      If (vr_custo_fin = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;        rllMargemTotGer.text := '100,00'                                                                         &#13;&#10;      Else        &#13;&#10;        rllMargemTotGer.Text := '0,00';&#13;&#10;    End;                                &#13;&#10;  //End;                             &#13;&#10;end;  &#13;&#10;&#13;&#10;&#13;&#10;procedure rllPerComissaoTotOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If rllVrTotal.Value &#60;&#62; 0 Then                                              &#13;&#10;    rllPerComissaoTot.Text := Formatfloat('#,##0.00',((rllVrComissaoTot.Value / rllVrTotal.Value)*100))&#13;&#10;  Else&#13;&#10;    rllPerComissaoTot.Text := '0,00';                   &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllPerComissaoTotGerOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If rllVrTotalGer.Value &#60;&#62; 0 Then                                              &#13;&#10;    rllPerComissaoTotGer.Text := Formatfloat('#,##0.00',((rllVrComissaoGer.Value / rllVrTotalGer.Value)*100))&#13;&#10;  Else&#13;&#10;    rllPerComissaoTotGer.Text := '0,00';                   &#13;&#10;end;  &#13;&#10;&#13;&#10;begin&#13;&#10;  vr_margem_tot := 0;&#13;&#10;  vr_custo_tot := 0;&#13;&#10;  vr_margem_fin := 0;&#13;&#10;  vr_custo_fin := 0;&#13;&#10;end." PropData="044C65667403080103546F70021808446174617365747301010C2600000020446174615365743D2266727847656E2220446174615365744E616D653D2266727847656E2200010C3200000020446174615365743D2266727852656C61746F72696F2220446174615365744E616D653D2266727852656C61746F72696F220000095661726961626C65730100055374796C650100">
