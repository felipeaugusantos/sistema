<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="0,77" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40010,6836349769" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  horTotMed: Integer;&#13;&#10;  intTotEnt: Integer;&#13;&#10;  intQtdEnt: Integer;                                           &#13;&#10;    &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure rllTempTotOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTempTot.Text := fSegToTempoStr(horTotMed);              &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllMedTempOnBeforePrint(Sender: TfrxComponent);&#13;&#10;Var&#13;&#10;  fltTotSeg: Double;&#13;&#10;  fltMin: Double;&#13;&#10;  fltHor: Double;&#13;&#10;  intPos1: Integer;&#13;&#10;  intPos2: Integer;                                       &#13;&#10;begin&#13;&#10;  IntPos1 := Pos(':', rllTempTot.Text);&#13;&#10;  IntPos2 := Pos(':', Copy(rllTempTot.Text,IntPos1 + 1, Length(rllTempTot.Text)));        &#13;&#10;  fltHor  := strtofloat(copy(rllTempTot.Text,1,IntPos1 - 1));&#13;&#10;  fltMin  := strtofloat(copy(rllTempTot.Text,IntPos1 + 1 ,IntPos2 - 1));&#13;&#10;  fltTotSeg := 0;                                    &#13;&#10;  fltTotSeg := ( (fltHor * 60) * 60);&#13;&#10;  fltTotSeg := (fltTotSeg + (fltMin * 60) );&#13;&#10;  If  intTotEnt &#62; 0 Then&#13;&#10;  Begin              &#13;&#10;    fltTotSeg := (fltTotSeg / intTotEnt);    &#13;&#10;    rllMedTemp.Text := fSegToTempoStr(Trunc(fltTotSeg));&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin              &#13;&#10;    rllMedTemp.Text := '00:00:00';                   &#13;&#10;  End;&#13;&#10;  intTotEnt := 0;&#13;&#10;  fltTotSeg := 0;                                    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  horTotMed := 0;&#13;&#10;  intTotEnt := 0;&#13;&#10;  intQtdEnt := 0;      &#13;&#10;    &#13;&#10;  If fFiltraOutEntMot(&#60;frxRelatorio.&#34;CODMOT&#34;&#62;) Then&#13;&#10;    chdOutEnt.Visible := True&#13;&#10;  Else&#13;&#10;    chdOutEnt.Visible := False;                                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxRelatorio.&#34;MEDIA&#34;&#62; &#60;&#62; '' Then&#13;&#10;  Begin              &#13;&#10;//    horTotMed := horTotMed + StrToTime(&#60;frxRelatorio.&#34;MEDIA&#34;&#62;);&#13;&#10;    horTotMed := horTotMed + fMediaTime(&#60;frxRelatorio.&#34;MEDIA&#34;&#62;);  &#13;&#10;    intTotEnt := intTotEnt + 1;&#13;&#10;  End;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    rllTotEntr.Text   := intToStr(IntTotEnt);&#13;&#10;    rllQtdTotEnt.Text := IntToStr(IntTotEnt + IntQtdEnt);          &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  intQtdEnt := intQtdEnt + 1;                                                            &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;  horTotMed := 0;&#13;&#10;  intTotEnt := 0;    &#13;&#10;&#13;&#10;end." PropData="">
