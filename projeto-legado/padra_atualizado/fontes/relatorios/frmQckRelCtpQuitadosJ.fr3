#60;&#62; '2');   &#13;&#10;  rllTitCheque.Visible := (strModRel &#60;&#62; '2');      &#13;&#10;  rdbLoja.Visible      := (strModRel &#60;&#62; '2');      &#13;&#10;  rdbBoleto.Visible    := (strModRel &#60;&#62; '2');      &#13;&#10;  rdbCheque.Visible    := (strModRel &#60;&#62; '2');      &#13;&#10;end;&#13;&#10;&#13;&#10;Begin            &#13;&#10;&#13;&#10;end." PropData="">
