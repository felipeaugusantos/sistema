<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PreviewOptions.ZoomMode="zmPageWidth" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40255,5858505093" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  fltSaldo: Double;&#13;&#10;&#13;&#10;  fltDebD : Double;&#13;&#10;  fltCreD : Double;&#13;&#10;    &#13;&#10;  fltDebG : Double;&#13;&#10;  fltCreG : Double;&#13;&#10;&#13;&#10;procedure StatusOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxRelatorio.&#34;CTB_DTACON&#34;&#62; = '' Then&#13;&#10;   Status.Text := 'NAO CONCILIADO'&#13;&#10;  Else&#13;&#10;   Status.Text := 'CONCILIADO';&#13;&#10;     &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DebitoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxRelatorio.&#34;CTB_CREDEB&#34;&#62; = 'D' Then&#13;&#10;  Begin&#13;&#10;    fltDebD := fltDebD + &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;;  &#13;&#10;    fltDebG := fltDebG + &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;;&#13;&#10;    fltSaldo:= fltSaldo - &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;;&#13;&#10;    Debito.Text := FormatFloat('##,#0.00', &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;);&#13;&#10;    Credito.Text:= '';                          &#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    fltCreD := fltCreD + &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;;  &#13;&#10;    fltCreG := fltCreG + &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;;&#13;&#10;    fltSaldo:= fltSaldo + &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;;  &#13;&#10;    Credito.Text := FormatFloat('##,#0.00', &#60;frxrelatorio.&#34;CTB_VALLAN&#34;&#62;);&#13;&#10;    Debito.Text:= '';&#13;&#10;  End;&#13;&#10;&#13;&#10;  Saldo.Text := FormatFloat('##,#0.00',fltSaldo);&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;PAGE&#62; &#60;&#62; 1 Then&#13;&#10;  Child1.Visible := False;                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure gphDocBaiOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   fltCreD := 0;&#13;&#10;   fltDebD := 0;       &#13;&#10;end;&#13;&#10;&#13;&#10;Begin&#13;&#10;  fltSaldo:= fltSalAnt;&#13;&#10;  fltDebG := 0;&#13;&#10;  fltCreG := 0;&#13;&#10;  fltDebD := 0;&#13;&#10;  fltCreD := 0;&#13;&#10;&#13;&#10;  If intOrdem = 3 Then&#13;&#10;  Begin&#13;&#10;   Docum.DataField := 'CTB_DOCBAI';&#13;&#10;   gphDocBai.Visible:= True;&#13;&#10;   gpfDocBai.Visible:= True;&#13;&#10;  End             &#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;   Docum.DataField := 'CTB_NUMDOC';&#13;&#10;   gphDocBai.Visible:= False;&#13;&#10;   gpfDocBai.Visible:= False;&#13;&#10;  End;&#13;&#10;    &#13;&#10;end." PropData="044C65667403E90003546F70024A08446174617365747301010C2600000020446174615365743D2266727847656E2220446174615365744E616D653D2266727847656E2200010C3200000020446174615365743D2266727852656C61746F72696F2220446174615365744E616D653D2266727852656C61746F72696F220000095661726961626C65730100055374796C650100">
