<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PreviewOptions.ZoomMode="zmWholePage" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40128,6234333333" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  fltTotVarD: Double;&#13;&#10;  fltTotVarF: Double;&#13;&#10;  fltTotVarG: Double;                    &#13;&#10;&#13;&#10;  fltTotFreD: Double;&#13;&#10;  fltTotFreF: Double;&#13;&#10;  fltTotFreG: Double;&#13;&#10;&#13;&#10;  fltTotDesD: Double;&#13;&#10;  fltTotDesF: Double;&#13;&#10;  fltTotDesG: Double;  &#13;&#10;&#13;&#10;  &#13;&#10;procedure rdbCndPagOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   rdbCndPag.Text := fFormataCondPag(&#60;frxRelatorio.&#34;CONPAG&#34;&#62;);    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbTotalOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If strTipCalc = 'C' Then&#13;&#10;  Begin                                      &#13;&#10;    rdbTotal.Text :=  FormatFloat('###,#0.00',fCalculaValorCompra(&#60;frxRelatorio.&#34;PRECOM&#34;&#62;,&#60;frxRelatorio.&#34;DESF01&#34;&#62;,&#60;frxRelatorio.&#34;DESF02&#34;&#62;,&#60;frxRelatorio.&#34;DESF03&#34;&#62;,&#60;frxRelatorio.&#34;DESF04&#34;&#62;,&#60;frxRelatorio.&#34;DESF05&#34;&#62;,&#60;frxRelatorio.&#34;DESF06&#34;&#62;,&#60;frxRelatorio.&#34;ACRFIN&#34;&#62;));&#13;&#10;    rdbTotal.DataField := ''                                          &#13;&#10;  end&#13;&#10;  Else            &#13;&#10;  rdbTotal.DataField := 'UNIPED';&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbValPerOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rdbValPer.Text := fCalculaValPercentual(&#60;frxRelatorio.&#34;PRECOM&#34;&#62;,&#60;frxRelatorio.&#34;DESF01&#34;&#62;,&#60;frxRelatorio.&#34;DESF02&#34;&#62;,&#60;frxRelatorio.&#34;DESF03&#34;&#62;,&#60;frxRelatorio.&#34;DESF04&#34;&#62;,&#60;frxRelatorio.&#34;DESF05&#34;&#62;,&#60;frxRelatorio.&#34;DESF06&#34;&#62;,&#60;frxRelatorio.&#34;ACRFIN&#34;&#62;,&#60;frxRelatorio.&#34;UNITAR&#34;&#62;,&#60;frxRelatorio.&#34;UNIPED&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbValorOnBeforePrint(Sender: TfrxComponent);&#13;&#10;Var      &#13;&#10;  fltVlrUni : Double;&#13;&#10;  fltVlrPed : Double;&#13;&#10;  fltQtdIte : Double;&#13;&#10;begin&#13;&#10;  fltVlrUni := &#60;frxRelatorio.&#34;UNITAR&#34;&#62;;&#13;&#10;  fltVlrPed := fCalculaValorCompra(&#60;frxRelatorio.&#34;PRECOM&#34;&#62;,&#60;frxRelatorio.&#34;DESF01&#34;&#62;,&#60;frxRelatorio.&#34;DESF02&#34;&#62;,&#60;frxRelatorio.&#34;DESF03&#34;&#62;,&#60;frxRelatorio.&#34;DESF04&#34;&#62;,&#60;frxRelatorio.&#34;DESF05&#34;&#62;,&#60;frxRelatorio.&#34;DESF06&#34;&#62;,&#60;frxRelatorio.&#34;ACRFIN&#34;&#62;);   &#13;&#10;  fltQtdIte := &#60;frxRelatorio.&#34;QTDITE&#34;&#62;;&#13;&#10;  If fltVlrPed &#62; 0 Then&#13;&#10;  Begin&#13;&#10;    If strTipCalc = 'C' Then&#13;&#10;    Begin                &#13;&#10;      rdbValor.Text := FormatFloat('###,#0.00',(fltVlrUni - fltVlrPed) * fltQtdIte);&#13;&#10;      fltTotVarD := fltTotVarD + ((fltVlrUni - fltVlrPed) * fltQtdIte);&#13;&#10;      fltTotVarF := fltTotVarF + ((fltVlrUni - fltVlrPed) * fltQtdIte);&#13;&#10;      fltTotVarG := fltTotVarG + ((fltVlrUni - fltVlrPed) * fltQtdIte);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;      rdbValor.Text := '0,00';                       &#13;&#10;  End&#13;&#10;  Else&#13;&#10;    rdbValor.Text := '0,00';&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure rdbTotvarDOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rdbTotVarD.Text := FormatFloat('###,#0.00',fltTotVarD);                                                            &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbTotvarFOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    rdbTotVarF.Text := FormatFloat('###,#0.00',fltTotVarF);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbTotvarGOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    rdbTotVarG.Text := FormatFloat('###,#0.00',fltTotVarG);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotVarF := 0;&#13;&#10;  fltTotFreF := 0;&#13;&#10;  fltTotDesF := 0;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbGrupoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotVarD := 0;&#13;&#10;  fltTotFreD := 0;&#13;&#10;  fltTotDesD := 0;&#13;&#10;  &#13;&#10;  If &#60;frxRelatorio.&#34;PEDCOM&#34;&#62; = '' Then&#13;&#10;  Begin&#13;&#10;    rllPedCom.Visible := False;&#13;&#10;    rdbPedCom.Visible := False;                                                  &#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    rllPedCom.Visible := True;&#13;&#10;    rdbPedCom.Visible := True;                                                  &#13;&#10;  End;&#13;&#10;&#13;&#10;  rllParcelas.Text := fVisualizaParcela( &#60;frxRelatorio.&#34;ESPDOC&#34;&#62;, &#60;frxRelatorio.&#34;NUMDOC&#34;&#62;, &#60;frxRelatorio.&#34;SERIE_&#34;&#62;, &#60;frxRelatorio.&#34;CODFOR&#34;&#62;);    &#13;&#10;&#13;&#10;  //rllDtaEnt.Text := FormatDateTime('dd/mm/yyyy', &#60;frxRelatorio.&#34;DTAENT&#34;&#62;);&#13;&#10;  //rllDtaDoc.Text := FormatDateTime('dd/mm/yyyy', &#60;frxRelatorio.&#34;DTADOC&#34;&#62;);      &#13;&#10;   &#13;&#10;End;  &#13;&#10;               &#13;&#10;procedure rlbResumoGrupoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotFreD:= fltTotFreD + &#60;frxRelatorio.&#34;TOTFRE&#34;&#62; ;&#13;&#10;  fltTotFreF:= fltTotFreF + &#60;frxRelatorio.&#34;TOTFRE&#34;&#62; ;&#13;&#10;  fltTotFreG:= fltTotFreG + &#60;frxRelatorio.&#34;TOTFRE&#34;&#62; ;&#13;&#10;&#13;&#10;  fltTotDesD:= fltTotDesD + &#60;frxRelatorio.&#34;DESACE&#34;&#62; ;&#13;&#10;  fltTotDesF:= fltTotDesF + &#60;frxRelatorio.&#34;DESACE&#34;&#62; ;&#13;&#10;  fltTotDesG:= fltTotDesG + &#60;frxRelatorio.&#34;DESACE&#34;&#62; ;  &#13;&#10;end;&#13;&#10;   &#13;&#10;BEGIN&#13;&#10;END.          " PropData="044C656674023003546F70027808446174617365747301010C2600000020446174615365743D2266727847656E2220446174615365744E616D653D2266727847656E2200010C3200000020446174615365743D2266727852656C61746F72696F2220446174615365744E616D653D2266727852656C61746F72696F220000095661726961626C65730100055374796C650100">
