<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Padr�o" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39525,6001820833" ReportOptions.Description.Text="" ReportOptions.LastChange="39527,3978885417" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  strCreDeb: String;&#13;&#10;  fltTotCli: Double;&#13;&#10;  fltTotGer: Double;                                           &#13;&#10;  &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotCli := fltTotCli + IIF(&#60;frxRelatorio.&#34;FID_CREDEB&#34;&#62; = 'C', &#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62;, -&#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62;);&#13;&#10;  fltTotGer := fltTotGer + IIF(&#60;frxRelatorio.&#34;FID_CREDEB&#34;&#62; = 'C', &#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62;, -&#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62;);                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotCliOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  If fltTotCli &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := 'D';&#13;&#10;    fltTotCli := fltTotCli * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := 'C';    &#13;&#10;    &#13;&#10;  rllTotCli.Text    := FormatFloat('#,##0.00', fltTotCli);&#13;&#10;  rllCreDebCli.Text := strCreDeb;                                                           &#13;&#10;&#13;&#10;  fltTotCli := 0;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  &#13;&#10;  If fltTotGer &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := 'D';&#13;&#10;    fltTotGer := fltTotGer * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := 'C';    &#13;&#10;    &#13;&#10;  rllTotGer.Text    := FormatFloat('#,##0.00', fltTotGer);&#13;&#10;  rllCreDebGer.Text := strCreDeb;                                                           &#13;&#10;&#13;&#10;  fltTotGer := 0;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rdbQtdPtoSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotGer := fltTotGer + &#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62;;&#13;&#10;&#13;&#10;  If &#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62; &#60; 0 Then&#13;&#10;    rdbQtdPtoSint.Text := FormatFloat('#,##0.00', (&#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62; * (-1))) + ' D'&#13;&#10;  Else&#13;&#10;    rdbQtdPtoSint.Text := FormatFloat('#,##0.00', &#60;frxRelatorio.&#34;FID_QTDPTO&#34;&#62;) + ' C';                                                                                                           &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  If fltTotGer &#60; 0 Then&#13;&#10;  Begin              &#13;&#10;    strCreDeb := ' D';&#13;&#10;    fltTotGer := fltTotGer * (-1);                                                                  &#13;&#10;  End                &#13;&#10;  Else&#13;&#10;    strCreDeb := ' C';    &#13;&#10;    &#13;&#10;  rllTotGerSint.Text := FormatFloat('#,##0.00', fltTotGer) + strCreDeb;&#13;&#10;&#13;&#10;  fltTotGer := 0;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  strCreDeb := '';&#13;&#10;  fltTotCli := 0;&#13;&#10;  fltTotGer := 0;            &#13;&#10;end." PropData="044C65667403E00003546F70022808446174617365747301010C2600000020446174615365743D2266727847656E2220446174615365744E616D653D2266727847656E2200010C3200000020446174615365743D2266727852656C61746F72696F2220446174615365744E616D653D2266727852656C61746F72696F220000095661726961626C65730100055374796C650100">
