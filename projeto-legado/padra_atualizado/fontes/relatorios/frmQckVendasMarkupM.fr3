<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="0,77" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40116,5321994329" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  vr_total_gru, vr_custo_gru : double;&#13;&#10;  vr_total_lin, vr_custo_lin : double;&#13;&#10;  vr_total_fin, vr_custo_fin : double;      &#13;&#10;&#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;&#13;&#10;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure GroupFooter2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin&#13;&#10;    If (vr_total_gru &#60;&#62; 0) and (vr_custo_gru &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;        rllVrMargemF2.Text  := Formatfloat('#,##0.00',( ( vr_total_gru  / vr_custo_gru ) *100 )-100)&#13;&#10;      Else&#13;&#10;        rllVrMargemF2.Text := Formatfloat('#,##0.00',( 1-( vr_custo_gru / vr_total_gru ) )*100);&#13;&#10;    End  &#13;&#10;    Else&#13;&#10;    Begin          &#13;&#10;      If (vr_custo_gru = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;        rllVrMargemF2.text := '100,00'                                                                         &#13;&#10;      Else                &#13;&#10;        rllVrMargemF2.text := '0,00';&#13;&#10;    End;                                                                               &#13;&#10;&#13;&#10;    vr_total_lin := vr_total_lin + vr_total_gru;&#13;&#10;    vr_custo_lin := vr_custo_lin + vr_custo_gru;&#13;&#10;&#13;&#10;    vr_total_gru := 0;&#13;&#10;    vr_custo_gru := 0;&#13;&#10;  End;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin    &#13;&#10;    vr_total_gru := vr_total_gru + rllVrTotal.value;                                                              &#13;&#10;    vr_custo_gru := vr_custo_gru + rllVrMedCusDe.value;&#13;&#10;  End;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin    &#13;&#10;    If (vr_total_lin &#60;&#62; 0) and (vr_custo_lin &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;        rllVrMargemF1.Text  := Formatfloat('#,##0.00',( ( vr_total_lin  / vr_custo_lin ) *100 )-100)  &#13;&#10;      Else&#13;&#10;        rllVrMargemF1.Text := Formatfloat('#,##0.00',( 1-( vr_custo_lin / vr_total_lin ) )*100);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      If (vr_custo_lin = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;        rllVrMargemF1.text := '100,00'                                                                         &#13;&#10;      Else                &#13;&#10;        rllVrMargemF1.text := '0,00';&#13;&#10;    End;  &#13;&#10;&#13;&#10;    vr_total_fin := vr_total_fin + vr_total_lin;&#13;&#10;    vr_custo_fin := vr_custo_fin + vr_custo_lin;&#13;&#10;       &#13;&#10;    vr_total_lin := 0;&#13;&#10;    vr_custo_lin := 0;&#13;&#10;  End;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin&#13;&#10;    If (vr_total_fin &#60;&#62; 0) and (vr_custo_fin &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;       rllVrMargemSu.Text  := Formatfloat('#,##0.00',( ( vr_total_fin  / vr_custo_fin ) *100 )-100)  &#13;&#10;      Else&#13;&#10;       rllVrMargemSu.Text := Formatfloat('#,##0.00',( 1-( vr_custo_fin / vr_total_fin ) )*100);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      If (vr_custo_fin = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;        rllVrMargemSu.text := '100,00'                                                                         &#13;&#10;      Else        &#13;&#10;        rllVrMargemSu.Text := '0,00';&#13;&#10;    End;                                &#13;&#10;  End;                         &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  vr_total_gru := 0;&#13;&#10;  vr_custo_gru := 0;&#13;&#10;  vr_total_lin := 0;&#13;&#10;  vr_custo_lin := 0;&#13;&#10;  vr_total_fin := 0;&#13;&#10;  vr_custo_fin := 0;  &#13;&#10;end." PropData="">
