<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39598,6870720949" ReportOptions.Description.Text="" ReportOptions.LastChange="40080,4258969907" ScriptLanguage="PascalScript" ScriptText.Text="procedure RelatorioOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  {CARREGO A IMAGEM}             &#13;&#10;  If (&#60;frxParametros.&#34;IMAGEM&#34;&#62; &#60;&#62; '') Then&#13;&#10;    Picture1.LoadFromFile(&#60;frxParametros.&#34;IMAGEM&#34;&#62;);&#13;&#10;&#13;&#10;  {TOCO O NOME DO LABEL CONFORME ESPECIE DO DOCUMENTO}                                                          &#13;&#10;  If (&#60;frxCabecalho.&#34;ESPDOC&#34;&#62; = 'PD') Then&#13;&#10;  Begin              &#13;&#10;    lblTotalGeral.Text  := 'Total do Pedido : ';&#13;&#10;    lblData.Text        := 'Data do Pedido : ';  &#13;&#10;    lblValidade.Text    := 'Data de Previs�o : ';&#13;&#10;    menValPre.DataField := 'PREVIS';                                                                              &#13;&#10;  End              &#13;&#10;  Else&#13;&#10;  Begin              &#13;&#10;    lblTotalGeral.Text := 'Total do Or�amento : ';&#13;&#10;    lblData.Text       := 'Data do Or�amento : ';  &#13;&#10;    lblValidade.Text   := 'Validade do Or�amento : ';&#13;&#10;    menValPre.DataField := 'DATA';        &#13;&#10;  End;              &#13;&#10;  &#13;&#10;  If (&#60;frxTotais.&#34;TOTAL_DESC&#34;&#62; &#62; 0) Then&#13;&#10;  Begin              &#13;&#10;    CTotalDescontos.Visible := True;&#13;&#10;  End            &#13;&#10;  Else        &#13;&#10;    CTotalDescontos.Visible := False;&#13;&#10;&#13;&#10;  If (&#60;frxTotais.&#34;TOTAL_RET&#34;&#62;) &#60;= 0 Then&#13;&#10;  Begin&#13;&#10;    CTotalRet.Height := 0;&#13;&#10;    lblTotalRet.Visible  := False;&#13;&#10;    dbeTotal_Ret.visible := false;&#13;&#10;  End;        &#13;&#10;&#13;&#10;  If (&#60;frxTotais.&#34;COM_IPI&#34;&#62; = 'N') Then&#13;&#10;  Begin&#13;&#10;    CTotaIPI.Height      := 0;&#13;&#10;    lblTotalIPI.Visible  := False;&#13;&#10;    dbeTOTAL_IPI.Visible := False;&#13;&#10;    lblIPI.Visible       := False;&#13;&#10;    dbeIPI.Visible       := False;&#13;&#10;    LineIPI.Visible      := False;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    dbeTOTAL_IPI.Left    := 633;&#13;&#10;    dbeTOTAL_PROD.Left   := 633;&#13;&#10;    dbeTOTAL_RET.Left    := 633;        &#13;&#10;    dbeTOTAL_DESC.Left   := 633;&#13;&#10;    dbeTOTAL_Frete.Left  := 633;          &#13;&#10;    dbeTOTAL_PEDORC.Left := 633;&#13;&#10;  End;  &#13;&#10;    &#13;&#10;  If (&#60;frxTotais.&#34;TOTAL_FRETE&#34;&#62; &#62; 0) Then&#13;&#10;  Begin&#13;&#10;    CTotalFrete.Visible := True;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    CTotalFrete.Height  := 0;      &#13;&#10;    CTotalFrete.Visible := False;&#13;&#10;  End;                  &#13;&#10;&#13;&#10;  If (&#60;frxTotais.&#34;TOTAL_PEDORC&#34;&#62; &#62; 0) Then&#13;&#10;  Begin&#13;&#10;    CTotalGeral.Visible := True;&#13;&#10;  End            &#13;&#10;  Else        &#13;&#10;    CTotalGeral.Visible := False;&#13;&#10; &#13;&#10; &#13;&#10;            &#13;&#10;                   &#13;&#10;end;&#13;&#10;&#13;&#10;Begin            &#13;&#10;  &#13;&#10;          &#13;&#10;end." PropData="">
