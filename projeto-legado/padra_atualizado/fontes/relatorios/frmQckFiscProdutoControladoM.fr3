<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="0,75" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="39940,6688064236" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  fltSalIni: Double;&#13;&#10;  fltSalFin: Double;&#13;&#10;  fltQtdTot: Double;                                           &#13;&#10;                      &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxRelatorio.&#34;ENTSAI&#34;&#62; = 'SAI' Then&#13;&#10;  Begin              &#13;&#10;    fltSalFin := (fltSalFin + &#60;frxRelatorio.&#34;QTDITE&#34;&#62;);        &#13;&#10;    fltQtdTot := (fltQtdTot + &#60;frxRelatorio.&#34;QTDITE&#34;&#62;);&#13;&#10;  End              &#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    fltSalFin := (fltSalFin - &#60;frxRelatorio.&#34;QTDITE&#34;&#62;);      &#13;&#10;    fltQtdTot := (fltQtdTot - &#60;frxRelatorio.&#34;QTDITE&#34;&#62;);&#13;&#10;  End;&#13;&#10;    &#13;&#10;end;&#13;&#10;              &#13;&#10;procedure rllSalFinOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllSalFin.Text := FormatFloat('#,##0.00', (fltSalIni - fltSalFin));&#13;&#10;  &#13;&#10;  fltSalIni := 0;&#13;&#10;  fltSalFin := 0;    &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure RLLSalIniOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltSalIni := fGetSalIni(&#60;frxRelatorio.&#34;CODITE&#34;&#62;, &#60;frxRelatorio.&#34;CODEMP&#34;&#62;);&#13;&#10;  RLLSalIni.Text := FormatFloat('#,##0.00', fltSalIni);&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  fltSalIni := 0;    &#13;&#10;  fltSalFin := 0;                  &#13;&#10;  fltQtdTot := 0;                &#13;&#10;    &#13;&#10;end." PropData="">
