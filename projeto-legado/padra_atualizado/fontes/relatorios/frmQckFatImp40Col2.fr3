<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" PrintOptions.ShowDialog="False" ReportOptions.Author="CITEL SOFTWARE" ReportOptions.CreateDate="39534,3875909491" ReportOptions.Description.Text="PAGE1 IMPRIME :&#13;&#10;&#13;&#10;GARANTIA&#13;&#10;TROCA&#13;&#10;DEVOLUÇÃO&#13;&#10;AJUSTE&#13;&#10;FATURAMENTO FUTURO&#13;&#10;MOVIMENTAÇÃO DE ITEM&#13;&#10;TRANSFERÊNCIA DE ESTOQUE&#13;&#10;PIGMENTO&#13;&#10;BRINDE" ReportOptions.LastChange="40158,6509385764" ScriptLanguage="PascalScript" ScriptText.Text="procedure MDadosOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;      &#13;&#10;  If (&#60;frxItensGeral.&#34;CODITE&#34;&#62; = '') Then&#13;&#10;  Begin      &#13;&#10;    dbQTDEITEM1.Visible  := False;&#13;&#10;    dbUNITITEM1.Visible  := False;&#13;&#10;    dbTOTALITEM1.Visible := False;          &#13;&#10;  End;&#13;&#10;        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin                                   &#13;&#10;&#13;&#10;  If (&#60;frxCondPagto2.&#34;CONDPGTO2&#34;&#62; = '') Then&#13;&#10;    CPagamentos2.Visible := False;&#13;&#10;&#13;&#10;  If (&#60;frxFormaPgto.&#34;FORMAPGTO&#34;&#62; = '') Then&#13;&#10;    CPagamentos3.Visible := False;            &#13;&#10;         &#13;&#10;  If (&#60;frxFornecedor.&#34;FORNECEDOR&#34;&#62; = '') Then'&#13;&#10;  Begin&#13;&#10;    DMPMemo34.Visible := False;&#13;&#10;    dbNOMFOR.Visible  := False;&#13;&#10;    RTitulo.Height    := RTitulo.Height - 1;&#13;&#10;  End;&#13;&#10;    &#13;&#10;  {SE NÃO HOUVER SERVIÇO ELE ESCONDE OS CAMPOS E A BANDA}        &#13;&#10;  If (&#60;frxServico.&#34;SERVICO&#34;&#62; = 'N') Then&#13;&#10;  Begin&#13;&#10;    lblServico.Visible      := False;&#13;&#10;    dbPERISS.Visible        := False;&#13;&#10;    lblValorISS.Visible     := False;&#13;&#10;    dbVALISS.Visible        := False;&#13;&#10;    lblValorServico.Visible := False;&#13;&#10;    dbTOTSER.Visible        := False;          &#13;&#10;    FTotais.Height          := 0;                                                     &#13;&#10;  End&#13;&#10;  Else            &#13;&#10;  Begin&#13;&#10;    lblServico.Visible      := True;&#13;&#10;    dbPERISS.Visible        := True;&#13;&#10;    lblValorISS.Visible     := True;&#13;&#10;    dbVALISS.Visible        := True;&#13;&#10;    lblValorServico.Visible := True;&#13;&#10;    dbTOTSER.Visible        := True;  &#13;&#10;  End;&#13;&#10;&#13;&#10;  {SENÃO IMPRIMIR PREÇO ELE IMPRIME ENDEREÇO DE ENTREGA}&#13;&#10;  If (&#60;frxTabela.&#34;TABELA&#34;&#62; &#60;&#62; 'NOTA FISCAL') Then&#13;&#10;  Begin              &#13;&#10;    If (&#60;frxImprimePreco.&#34;IMPRIMEPRECO&#34;&#62; = 'S') Then&#13;&#10;    Begin&#13;&#10;      If blnFrete And (Not blnDocSep) And ((strEspDoc = 'MI') Or (strEspDoc = 'FF')) Then&#13;&#10;      Begin                  &#13;&#10;        CEntrega.Visible   := True;&#13;&#10;&#13;&#10;        If &#60;frxMovger.&#34;GER_TIPFRE&#34;&#62; = '1' Then                                                                                       &#13;&#10;          lblEntrega.Text := 'TIPO FRETE: Emitente'&#13;&#10;        Else&#13;&#10;          lblEntrega.Text := 'TIPO FRETE: Destinatario ';&#13;&#10;            &#13;&#10;        dbEndEnt.Visible   := False;&#13;&#10;        dbBairroEnt.Visible:= False;&#13;&#10;        dbCidadeEnt.Visible:= False;                                                                   &#13;&#10;      End&#13;&#10;      Else              &#13;&#10;        CEntrega.Visible := False;&#13;&#10;          &#13;&#10;      If (&#60;frxValorTotalOR.&#34;VALORTOTAL&#34;&#62; = 'N') Then&#13;&#10;      Begin&#13;&#10;        lblDesconto.visible := False;&#13;&#10;        lblDescontoEsp.Visible := False;&#13;&#10;        dbDESCESPECIAL.Visible := False;                                    &#13;&#10;      End;                &#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      CTotais.Visible := False;&#13;&#10;    End;&#13;&#10;      &#13;&#10;    CNotaFiscal.Height  := 0;&#13;&#10;    CNotaFiscal.Visible := False;                                                                    &#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    {informações referentes a nota fiscal}&#13;&#10;    If (&#60;frxImprimeTicket.&#34;IMPTICKET&#34;&#62; = 'N') Then&#13;&#10;    Begin&#13;&#10;      CTotais.Height   := 0;&#13;&#10;      CTotais.Visible  := False;&#13;&#10;&#13;&#10;      CEntrega.Height  := 0;&#13;&#10;      CEntrega.Visible := False;                                                              &#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      CNotaFiscal.Height  := 0;&#13;&#10;      CNotaFiscal.Visible := False;                                                                    &#13;&#10;    End;&#13;&#10;      &#13;&#10;  End;            &#13;&#10;    &#13;&#10;  {MOSTRA OU NÃO OS DÉBITOS DO CLIENTE}              &#13;&#10;  If (&#60;frxDebitoCli.&#34;DEBITO&#34;&#62; &#60;&#62; '') Then&#13;&#10;    CDebitoCliente.Visible := True                                    &#13;&#10;  Else&#13;&#10;    CDebitoCliente.Visible := False;&#13;&#10;      &#13;&#10;  {TRATO TUDO QUE FOR DA ESPECIE AJ, TR e DV}&#13;&#10;  If (&#60;frxEntSai.&#34;ENTSAI&#34;&#62; = 'N') Then&#13;&#10;  Begin&#13;&#10;    lblEntSai.Visible := False;&#13;&#10;    dbENTSAI.Visible  := False;        &#13;&#10;  End  &#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    lblEntSai.Visible := True;&#13;&#10;    dbENTSAI.Visible  := True;&#13;&#10;    &#13;&#10;    If (&#60;frxEntSai.&#34;ENTSAI&#34;&#62; = 'AJ') Then&#13;&#10;    Begin&#13;&#10;      CPagamentos.Height  := 0;&#13;&#10;      CPagamentos.Visible  := False;                            &#13;&#10;      CPagamentos2.Visible := False;&#13;&#10;      CPagamentos3.Visible := False;          &#13;&#10;      {Frases}&#13;&#10;      lblFrase1.Visible      := False;&#13;&#10;      lblFrase2.Visible      := False;&#13;&#10;      lblFrase3.Visible      := False;&#13;&#10;    End;&#13;&#10;&#13;&#10;    {Entregas}                    &#13;&#10;    CEntrega.Visible := False;&#13;&#10;&#13;&#10;    {DESCONTO e DESCONTO ESPECIAL}&#13;&#10;    If (&#60;frxMovGer.&#34;GER_PORDES&#34;&#62; = 0) Then                &#13;&#10;    Begin&#13;&#10;      lblDesconto.Visible    := False;&#13;&#10;    End;&#13;&#10;&#13;&#10;    If (&#60;frxMovGer.&#34;GER_DESESP&#34;&#62; = 0) Then&#13;&#10;    Begin          &#13;&#10;      lblDescontoEsp.Visible := False;&#13;&#10;      dbDESCESPECIAL.Visible := False;&#13;&#10;    End;                &#13;&#10;&#13;&#10;  End;&#13;&#10;&#13;&#10; {TRATO TUDO QUE FOR DA ESPECIE GA}&#13;&#10;  If (&#60;frxParGarantia.&#34;PARGARANTIA&#34;&#62; = 'GA') Then&#13;&#10;  Begin&#13;&#10;    If (&#60;frxImprimePreco.&#34;IMPRIMEPRECO&#34;&#62; = 'N') Then&#13;&#10;    Begin&#13;&#10;      lblEntSai.Visible     := False;&#13;&#10;      dbENTSAI.Visible      := False;&#13;&#10;      lblVlrUnit.Visible    := False;&#13;&#10;      lblValorTotal.Visible := False;&#13;&#10;      dbUNITITEM1.Visible   := False;&#13;&#10;      dbTOTALITEM1.Visible  := False;&#13;&#10;      lblHora.Visible       := False;&#13;&#10;      dbHORENT.Visible      := False;&#13;&#10;      lblMensagem.Visible   := False;&#13;&#10;        &#13;&#10;      CPagamentos.Height   := 0;&#13;&#10;      CPagamentos.Visible  := False;&#13;&#10;      CPagamentos2.Visible := False;&#13;&#10;      CPagamentos3.Visible := False;          &#13;&#10;      CTotais.Height       := 0;&#13;&#10;      CTotais.Visible := False;                                            &#13;&#10;      CEntrega.Visible := False;                                                              &#13;&#10;      CMens001.Height       := 0;&#13;&#10;      CMens001.Visible := False;                                            &#13;&#10;      CMens002.Height       := 0;&#13;&#10;      CMens002.Visible := False;                                            &#13;&#10;      CDuplicata.Height     := 0;&#13;&#10;      CDuplicata.Visible := False;                                                                                 &#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      lblVlrUnit.Visible    := True;&#13;&#10;      lblValorTotal.Visible := True;&#13;&#10;      dbUNITITEM1.Visible   := True;&#13;&#10;      dbTOTALITEM1.Visible  := True;  &#13;&#10;    End;              &#13;&#10;  End;&#13;&#10;&#13;&#10;  If (strEspDoc = 'BR') And (&#60;frxImprimePreco.&#34;IMPRIMEPRECO&#34;&#62; = 'N') Then&#13;&#10;  Begin&#13;&#10;    lblVlrUnit.Visible    := False;&#13;&#10;    lblValorTotal.Visible := False;&#13;&#10;    dbUNITITEM1.Visible   := False;&#13;&#10;    dbTOTALITEM1.Visible  := False;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    lblVlrUnit.Visible    := True;&#13;&#10;    lblValorTotal.Visible := True;&#13;&#10;    dbUNITITEM1.Visible   := True;&#13;&#10;    dbTOTALITEM1.Visible  := True;  &#13;&#10;  End;            &#13;&#10;  &#13;&#10;  {IMPRESSÃO DE COMPROVANTE}&#13;&#10;  If (&#60;frxImprimeComprovante.&#34;IMPCOMPROVANTE&#34;&#62; = 'N') Or&#13;&#10;     &#60;frxSaltoPagina.&#34;blnSepara&#34;&#62; Then&#13;&#10;  Begin&#13;&#10;    CComprovante.Visible := False;&#13;&#10;    CComprovante.Height  := 0;                              &#13;&#10;  End;            &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure CTotaisOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If blnFrete And ((strEspDoc = 'MI') Or (strEspDoc = 'FF')) Then&#13;&#10;  Begin&#13;&#10;    lblValFreteDoc.Visible := True;&#13;&#10;    dblValFreteDoc.Visible := True;        &#13;&#10;  End;            &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
