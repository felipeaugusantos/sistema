<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40094,400029294" ScriptLanguage="PascalScript" ScriptText.Text="procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rldbLinhaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rldbLinha.Text := 'LINHA:' + fRetNomeLinhaGrupo(&#60;frxRelatorio.&#34;LINHA&#34;&#62; + '00');  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rldbLinhaVOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    rldbLinhaV.Text := 'LINHA:' + fRetNomeLinhaGrupo(&#60;frxRelatorio.&#34;LINHA&#34;&#62; + '00');  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  Var&#13;&#10;   strDescricao: String;                                                    &#13;&#10;begin&#13;&#10;&#13;&#10;  If (&#60;frxGen.&#34;blnCodBar&#34;&#62;) And (&#60;frxRelatorio.&#34;CODBAR&#34;&#62; &#60;&#62; '') Then&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBar.Visible := True;&#13;&#10;    rlbCodBar.Height  := 1;          &#13;&#10;      &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '') Then&#13;&#10;      rlbAplica.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplica.Visible := False;          &#13;&#10;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBar.Visible := False;&#13;&#10;    rlbCodBar.Height  := 0;          &#13;&#10;    &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '')Then&#13;&#10;      rlbAplica.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplica.Visible := False;&#13;&#10;                  &#13;&#10;  End;&#13;&#10;&#13;&#10;  strDescricao := &#60;frxRelatorio.&#34;CODIGO&#34;&#62; + '-' + &#60;frxRelatorio.&#34;DESITE&#34;&#62;;                                                                    &#13;&#10;&#13;&#10;  If rllReferencia.Visible Then    &#13;&#10;    rldbDescricao.Text := Copy(strDescricao, 1, 24)                               &#13;&#10;  Else If rllMarca.Visible Then&#13;&#10;    rldbDescricao.Text := Copy(strDescricao, 1, 34)&#13;&#10;  Else&#13;&#10;    rldbDescricao.Text := Copy(strDescricao, 1, 44);          &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesVOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  Var&#13;&#10;   strDescricao: String;           &#13;&#10;begin&#13;&#10;  &#13;&#10;  If (&#60;frxGen.&#34;blnCodBar&#34;&#62;) And (&#60;frxRelatorio.&#34;CODBAR&#34;&#62; &#60;&#62; '') Then&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBarV.Visible := True;&#13;&#10;    rlbCodBarV.Height  := 1;          &#13;&#10;      &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '') Then&#13;&#10;      rlbAplicaV.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplicaV.Visible := False;          &#13;&#10;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;&#13;&#10;    rlbCodBarV.Visible := False;&#13;&#10;    rlbCodBarV.Height  := 0;          &#13;&#10;    &#13;&#10;    If (&#60;frxGen.&#34;blnAplica&#34;&#62;) And (&#60;frxRelatorio.&#34;APLICA&#34;&#62; &#60;&#62; '')Then&#13;&#10;      rlbAplicaV.Visible := True&#13;&#10;    Else&#13;&#10;      rlbAplicaV.Visible := False;&#13;&#10;                  &#13;&#10;  End;&#13;&#10;&#13;&#10;  strDescricao := &#60;frxRelatorio.&#34;CODIGO&#34;&#62; + '-' + &#60;frxRelatorio.&#34;DESITE&#34;&#62;;&#13;&#10;    &#13;&#10;  If rllReferenciaV.Visible Then&#13;&#10;    rldbDescricaoV.Text := Copy(strDescricao, 1, 48)&#13;&#10;  Else If rllMarcaV.Visible Then&#13;&#10;    rldbDescricaoV.Text := Copy(strDescricao, 1, 58)&#13;&#10;  Else&#13;&#10;    rldbDescricaoV.Text := Copy(strDescricao, 1, 68);        &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="044C656674021803546F70023808446174617365747301010C2600000020446174615365743D2266727847656E2220446174615365744E616D653D2266727847656E2200010C3200000020446174615365743D2266727852656C61746F72696F2220446174615365744E616D653D2266727852656C61746F72696F220000095661726961626C65730100055374796C650100">
