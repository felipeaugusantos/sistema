<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PreviewOptions.ZoomMode="zmPageWidth" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40253,3526099537" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  bln: Boolean;                                                             &#13;&#10;  &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin                                                   &#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                              &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rlbDadosOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin                                                                                                                                           &#13;&#10;    &#13;&#10;  If &#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = '***' Then&#13;&#10;  Begin&#13;&#10;    Linha.Visible := True;&#13;&#10;    rlbDados.Height := 5;&#13;&#10;    rllLojTot.Visible := False;&#13;&#10;    rllPerc.Visible := False;&#13;&#10;    rllLoj001.Visible := False;            &#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin              &#13;&#10;    Linha.Visible := False;              &#13;&#10;    rllLoj001.Visible := True;        &#13;&#10;    rllLojTot.Visible := True;&#13;&#10;    rllPerc.Visible := True;                                                            &#13;&#10;  End;              &#13;&#10;                                   &#13;&#10;  If (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'MARCON') Or&#13;&#10;     (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'MARLIQ') Or&#13;&#10;     (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'PERREA') Or&#13;&#10;     (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'VAREST') Then&#13;&#10;  Begin                                                            &#13;&#10;    rllLoj001.DisplayFormat.FormatStr := '#,##0.00%';                      &#13;&#10;    rllLoj002.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLoj003.DisplayFormat.FormatStr := '#,##0.00%';    &#13;&#10;    rllLoj004.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLoj005.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLoj006.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLoj007.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLoj008.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLoj009.DisplayFormat.FormatStr := '#,##0.00%';  &#13;&#10;    rllLojTot.DisplayFormat.FormatStr := '#,##0.00%';&#13;&#10;&#13;&#10;    If (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; &#60;&#62; 'VAREST') Then&#13;&#10;    Begin                &#13;&#10;      rllLojTot.Memo.Clear;&#13;&#10;      rllLojTot.Memo.Add('[frxRelatorio.&#34;REL_MARGEM&#34;]');&#13;&#10;      rllPerc.Memo.Clear;&#13;&#10;      rllPerc.DataField := '';&#13;&#10;    End                           &#13;&#10;  End&#13;&#10;  Else If (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'PRACTR') Or &#13;&#10;          (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'PRACOM') Or&#13;&#10;          (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'PRAVEN') Then&#13;&#10;  Begin&#13;&#10;    rllLojTot.Memo.Clear;&#13;&#10;    rllLojTot.Memo.Add('[frxRelatorio.&#34;REL_MARGEM&#34;]');&#13;&#10;    rllPerc.Memo.Clear;&#13;&#10;    rllPerc.DataField := '';  &#13;&#10;  End&#13;&#10;  Else            &#13;&#10;  Begin&#13;&#10;    rllLoj001.DisplayFormat.FormatStr := '#,##0.00';                      &#13;&#10;    rllLoj002.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLoj003.DisplayFormat.FormatStr := '#,##0.00';    &#13;&#10;    rllLoj004.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLoj005.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLoj006.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLoj007.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLoj008.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLoj009.DisplayFormat.FormatStr := '#,##0.00';  &#13;&#10;    rllLojTot.DisplayFormat.FormatStr := '#,##0.00';&#13;&#10;    rllLojTot.Memo.Clear;&#13;&#10;    rllLojTot.Memo.Add('[(&#60;frxRelatorio.&#34;REL_LOJ001&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ002&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ003&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ004&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ005&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ006&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ007&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ008&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ009&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ010&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ011&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ012&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ013&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ014&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ015&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ016&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ017&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ018&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ019&#34;&#62; + &#60;frxRelatorio.&#34;REL_LOJ020&#34;&#62;)]');&#13;&#10;    rllPerc.Memo.Clear;&#13;&#10;    rllPerc.DataField := 'REL_MARGEM';        &#13;&#10;  End;&#13;&#10;&#13;&#10;  If (bln) And (&#60;frxRelatorio.&#34;REL_CODCAM&#34;&#62; = 'PERREA') Then&#13;&#10;  Begin&#13;&#10;    rlbTitulo.StartNewPage := True;                                                 &#13;&#10;    bln := False;&#13;&#10;  End&#13;&#10;  Else&#13;&#10;    rlbTitulo.StartNewPage := False;  &#13;&#10;         &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDadosOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;                                                                                                       &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbTituloOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbSumarioGrupoOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbSumarioGrupoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;Begin&#13;&#10;  bln := True;    &#13;&#10;end." PropData="">
