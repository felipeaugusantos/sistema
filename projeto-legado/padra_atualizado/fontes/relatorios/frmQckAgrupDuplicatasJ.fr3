<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="39685,4506839468" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  fltTotal : Double;&#13;&#10;  strConPag: String;&#13;&#10;  intQtdGrp: Integer;&#13;&#10;  strAntDup: String;      &#13;&#10;    &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + intToStr(intQtdGrp);&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  fltTotal := fltTotal + &#60;frxRelatorio.&#34;CTR_VALDUP&#34;&#62;;                             &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerSintOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotal.Text := FormatFloat('#,##0.00', fltTotal);&#13;&#10;  fltTotal       := 0;                              &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllConPagOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin               &#13;&#10;  rllConPag.Text := fFormataCondPag(strConPag);&#13;&#10;  strConPag := '';&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure grpHCodCliOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  strConPag := &#60;frxRelatorio.&#34;CTR_CONPAG&#34;&#62;;&#13;&#10;  &#13;&#10;  If (strAntDup = &#60;frxRelatorio.&#34;NUMAGR&#34;&#62;) Or&#13;&#10;     (strAntDup = 'Primeiro')   Then&#13;&#10;    intQtdGrp := intQtdGrp + 1&#13;&#10;  Else&#13;&#10;  Begin              &#13;&#10;    intQtdGrp := 1;&#13;&#10;    strAntDup := &#60;frxRelatorio.&#34;NUMAGR&#34;&#62;;  &#13;&#10;  End;                                   &#13;&#10;      &#13;&#10;  strAntDup := &#60;frxRelatorio.&#34;NUMAGR&#34;&#62;;      &#13;&#10;               &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  fltTotal  := 0;&#13;&#10;  intQtdGrp := 0;&#13;&#10;  strAntDup := 'Primeiro';      &#13;&#10;    &#13;&#10;end." PropData="">
