<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="0,77" PrintOptions.Printer="Padrão" PrintOptions.PrintMode="pmScale" PrintOptions.PrintOnSheet="1" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40113,6499598495" ScriptLanguage="PascalScript" ScriptText.Text="Var&#13;&#10;  fltTotLin: Double;&#13;&#10;  fltTotGer: Double;      &#13;&#10;&#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotGerOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotGer.Text := FormatFloat('#,##0.00', fltTotGer);&#13;&#10;  fltTotGer := 0;&#13;&#10;    &#13;&#10;end;         &#13;&#10;&#13;&#10;procedure rlbDetalhesOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If rllTitEmp_0.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_0&#34;&#62;;&#13;&#10;                    &#13;&#10;  If rllTitEmp_1.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_1&#34;&#62;;&#13;&#10;&#13;&#10;  If rllTitEmp_2.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_2&#34;&#62;;&#13;&#10;&#13;&#10;  If rllTitEmp_3.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_3&#34;&#62;;&#13;&#10;&#13;&#10;  If rllTitEmp_4.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_4&#34;&#62;;&#13;&#10;    &#13;&#10;  If rllTitEmp_5.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_5&#34;&#62;;&#13;&#10;    &#13;&#10;  If rllTitEmp_6.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_6&#34;&#62;;&#13;&#10;&#13;&#10;  If rllTitEmp_7.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_7&#34;&#62;;  &#13;&#10;  &#13;&#10;  If rllTitEmp_8.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_8&#34;&#62;;  &#13;&#10;&#13;&#10;  If rllTitEmp_9.Visible Then&#13;&#10;    fltTotLin := fltTotLin + &#60;frxRelatorio.&#34;EMP_9&#34;&#62;;  &#13;&#10;                                                     &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotLinOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotLin.Text := FormatFloat('#,##0.00', fltTotLin);&#13;&#10;  fltTotGer := fltTotGer + fltTotLin;&#13;&#10;  fltTotLin := 0;                    &#13;&#10;     &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  fltTotLin := 0;&#13;&#10;  fltTotGer := 0;      &#13;&#10;&#13;&#10;end." PropData="">
