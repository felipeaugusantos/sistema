<TfrxReport Version="4.3.61" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PreviewOptions.ZoomMode="zmWholePage" PrintOptions.Printer="Default" PrintOptions.PrintMode="pmScale" PrintOptions.PrintOnSheet="9" ReportOptions.CreateDate="39784,5554441551" ReportOptions.Description.Text="" ReportOptions.LastChange="40151,5583957176" ScriptLanguage="PascalScript" ScriptText.Text="var      &#13;&#10;       vr_total_ven, vr_custo_ven: double;&#13;&#10;       vr_total_fin, vr_custo_fin: double;                                                                                 &#13;&#10;&#13;&#10;procedure rllDescricaoOnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If fOpcaoAnalitico = 'T' Then&#13;&#10;       rllDescricao.Text := fRetornaNomeTinta(rllCodigo.Text);  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rlbDetalhesOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin&#13;&#10;    vr_total_ven := vr_total_ven + rllVrTotal.value;                                                                 &#13;&#10;    vr_custo_ven := vr_custo_ven + rllVrMedCusDe.value;&#13;&#10;  End;                        &#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin&#13;&#10;    vr_total_ven := StrToFloat(Formatfloat('0.00', vr_total_ven));&#13;&#10;    vr_custo_ven := StrToFloat(Formatfloat('0.00', vr_custo_ven));      &#13;&#10;    If (vr_total_ven &#60;&#62; 0) and (vr_custo_ven &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;        rllVrMargemF1.Text  := Formatfloat('#,##0.00',( ( vr_total_ven  / vr_custo_ven ) *100 )-100)&#13;&#10;      Else&#13;&#10;        rllVrMargemF1.Text := Formatfloat('#,##0.00',( 1-( vr_custo_ven / vr_total_ven ) )*100);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      If (vr_custo_ven = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;      Begin                  &#13;&#10;        rllVrMargemF1.text := '100,00';  &#13;&#10;      End&#13;&#10;      Else                &#13;&#10;      Begin                  &#13;&#10;        rllVrMargemF1.text := '0,00';&#13;&#10;      End;&#13;&#10;&#13;&#10;    End;                      &#13;&#10;&#13;&#10;    vr_total_fin := vr_total_fin + vr_total_ven;&#13;&#10;    vr_custo_fin := vr_custo_fin + vr_custo_ven;&#13;&#10;&#13;&#10;    vr_total_ven := 0;&#13;&#10;    vr_custo_ven := 0;&#13;&#10;  end;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin&#13;&#10;    If (vr_total_fin &#60;&#62; 0) and (vr_custo_fin &#60;&#62; 0) Then&#13;&#10;    Begin&#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;       rllVrMargemSu.Text  := Formatfloat('#,##0.00',( ( vr_total_fin  / vr_custo_fin ) *100 )-100)  &#13;&#10;      Else&#13;&#10;       rllVrMargemSu.Text := Formatfloat('#,##0.00',( 1-( vr_custo_fin / vr_total_fin ) )*100);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      If (vr_custo_fin = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;      Begin          &#13;&#10;        rllVrMargemSu.text := '100,00';&#13;&#10;      End&#13;&#10;      Else        &#13;&#10;      Begin                  &#13;&#10;        rllVrMargemSu.text := '0,00';&#13;&#10;      End;&#13;&#10;&#13;&#10;    End;&#13;&#10;  End;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;       vr_total_ven := 0;               &#13;&#10;       vr_custo_ven := 0;&#13;&#10;       vr_total_fin := 0; &#13;&#10;       vr_custo_fin := 0;&#13;&#10;end." PropData="">
