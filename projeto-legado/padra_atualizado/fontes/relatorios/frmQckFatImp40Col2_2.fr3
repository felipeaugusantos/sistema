<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" PrintOptions.ShowDialog="False" ReportOptions.CreateDate="39540,7321322685" ReportOptions.Description.Text="" ReportOptions.LastChange="40150,6139440394" ScriptLanguage="PascalScript" ScriptText.Text="procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;   If (&#60;frxCondPagto2.&#34;CONDPGTO2&#34;&#62; = '') Then&#13;&#10;     CPagamentos3.Visible := False;&#13;&#10;&#13;&#10;   If (&#60;frxFormaPgto.&#34;FORMAPGTO&#34;&#62; = '') Then&#13;&#10;     CPagamentos4.Visible := False;  &#13;&#10;          &#13;&#10;   If (&#60;frxFornecedor.&#34;FORNECEDOR&#34;&#62; = '') Then&#13;&#10;   Begin&#13;&#10;     DMPMemo45.Visible   := False;&#13;&#10;     dbNOMFOR2.Visible   := False;&#13;&#10;     ReportTitle1.Height := ReportTitle1.Height - 1;&#13;&#10;   End;&#13;&#10;&#13;&#10;   {SE FOR VERDADEIRO IMPRIME NORMAL, SENÃO IMPRIME DESCRICAO UNIDADE E QUANTIDADE NA MESMA LINHA}&#13;&#10;   If ((&#60;frxTabela.&#34;TABELA&#34;&#62; = 'PEDIDO') And (&#60;frxImprimePrecoPedido.&#34;PRECOPEDIDO&#34;&#62; = 'S')) Or&#13;&#10;      ((&#60;frxTabela.&#34;TABELA&#34;&#62; = 'ORCAMENTO') And (&#60;frxComPrecoOR.&#34;COMPRECO&#34;&#62; = 'S')) Then&#13;&#10;   Begin&#13;&#10;     lblUN3.Visible     := False;&#13;&#10;     lblQtde3.Visible   := False;&#13;&#10;     dbDESITEM3.Visible := False;&#13;&#10;     dbUNIDAD3.Visible  := False;&#13;&#10;     dbQTDITEM3.Visible := False;&#13;&#10;     MDados2.Stretched  := True;&#13;&#10;&#13;&#10;     If (&#60;frxFatGor.&#34;FGO_TOTRET&#34;&#62; &#60;= 0) Then&#13;&#10;     Begin&#13;&#10;       lblSubTri.Visible := False;&#13;&#10;       dbTOTRET.Visible  := False;         &#13;&#10;     End;               &#13;&#10;       &#13;&#10;   End&#13;&#10;   Else&#13;&#10;   Begin&#13;&#10;     {VALORES CValores2}                      &#13;&#10;     lblUN2.Visible       := False;&#13;&#10;     lblQtde2.Visible     := False;&#13;&#10;     lblVlrUnit2.Visible  := False;&#13;&#10;     lblVlrTotal2.Visible := False;           &#13;&#10;     dbDESITEM2.Visible   := False;         &#13;&#10;     dbUN2.Visible        := False;&#13;&#10;     dbQTDE2.Visible      := False;&#13;&#10;     dbVLRUNIT2.Visible   := False;&#13;&#10;     dbTOTAL2.Visible     := False;&#13;&#10;     CValores2.Height     := 0;&#13;&#10;&#13;&#10;     {VALORES CTotais2}&#13;&#10;     lblDesconto2.Visible    := False;&#13;&#10;     lblDesEspecial2.Visible := False;&#13;&#10;     lblSubTri.Visible       := False;         &#13;&#10;     dbDESESP2.Visible       := False;&#13;&#10;     dbTOTRET.Visible        := False;           &#13;&#10;     If (&#60;frxValorTotalOR.&#34;VALORTOTAL&#34;&#62; = 'N') Then&#13;&#10;     Begin                 &#13;&#10;       dbVLRCON2.Visible       := False;&#13;&#10;       lblTotal2.Visible       := False;&#13;&#10;     End;                        &#13;&#10;   End;    &#13;&#10;&#13;&#10;  If (&#60;frxFatGor.&#34;FGO_PORDES&#34;&#62; = 0) Then&#13;&#10;  Begin&#13;&#10;    lblDesconto2.Visible    := False;&#13;&#10;  End;&#13;&#10;      &#13;&#10;  If (&#60;frxFatGor.&#34;FGO_DESESP&#34;&#62; = 0) Then&#13;&#10;  Begin&#13;&#10;    lblDesEspecial2.Visible := False;&#13;&#10;    dbDESESP2.Visible       := False;&#13;&#10;  End;&#13;&#10;    &#13;&#10;  {SE NÃO HOUVER SERVIÇO ELE ESCONDE OS CAMPOS E A BANDA}        &#13;&#10;  If (&#60;frxServico.&#34;SERVICO&#34;&#62; = 'N') Then&#13;&#10;  Begin&#13;&#10;    FTotais2.Height          := 0;&#13;&#10;    FTotais2.Visible := False;                                          &#13;&#10;  End&#13;&#10;  Else&#13;&#10;  Begin&#13;&#10;    FTotais2.Visible := True;        &#13;&#10;  End;&#13;&#10;&#13;&#10;  {IMPRIME OU NÃO IPI}&#13;&#10;  If (&#60;frxTabela.&#34;TABELA&#34;&#62; &#60;&#62; 'PEDIDO') And (&#60;frxFatGor.&#34;FGO_TOTIPI&#34;&#62; &#60;= 0) Then&#13;&#10;  Begin&#13;&#10;    CIPI.Height         := 0;&#13;&#10;    CIPI.Visible := False;                                          &#13;&#10;  End;            &#13;&#10;&#13;&#10;  {SE FOR PEDIDO NÃO IMPRIME DUPLICATAS}                                       &#13;&#10;  If (&#60;frxTabela.&#34;TABELA&#34;&#62; = 'PEDIDO') Then&#13;&#10;  Begin&#13;&#10;    CDuplicatas2.Height := 0;&#13;&#10;    CDuplicatas2.Visible := False;                                          &#13;&#10;  End;&#13;&#10;&#13;&#10;  {IMPRESSÃO DE COMPROVANTE}&#13;&#10;  If (&#60;frxImprimeComprovante.&#34;IMPCOMPROVANTE&#34;&#62; = 'N') Then&#13;&#10;  Begin&#13;&#10;    CComprovante.Visible := False;&#13;&#10;    CComprovante.Height  := 0;                              &#13;&#10;  End;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MDados2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  childLocFis.Visible := &#60;frxSaltoPagina.&#34;blnImpLoc&#34;&#62; And (&#60;frxPedOrc.&#34;LOCFIS&#34;&#62; &#60;&#62; '');  &#13;&#10;    &#13;&#10;  If (&#60;frxPedOrc.&#34;CODITE&#34;&#62; = '') Then&#13;&#10;  Begin      &#13;&#10;    dbQTDE2.Visible    := False;&#13;&#10;    dbVLRUNIT2.Visible := False;&#13;&#10;    dbTOTAL2.Visible   := False;&#13;&#10;    dbQTDITEM3.Visible := False;          &#13;&#10;  End;  &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure dbTOTRETOnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;                                                                                      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure CMensExpOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If (Not blnDocSep) Then&#13;&#10;  Begin&#13;&#10;    CMensExp.Visible := False;&#13;&#10;    CMensExp.Height  := 0;                                  &#13;&#10;  End;            &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
