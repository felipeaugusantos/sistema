&#60;frxRelatorio.&#34;ITE_GMLCON&#34;&#62;);&#13;&#10;    rllDifGml.Text := FORMATFLOAT('###0.0000',&#60;frxRelatorio.&#34;ITE_DIFGML&#34;&#62;);&#13;&#10;  End;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
