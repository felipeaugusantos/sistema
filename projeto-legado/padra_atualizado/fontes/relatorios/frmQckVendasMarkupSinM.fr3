<TfrxReport Version="4.3.61" DotMatrixReport="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="0,77" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39343,4831909259" ReportOptions.Description.Text="" ReportOptions.LastChange="40151,4355324074" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  vr_total, vr_custo : double;&#13;&#10;  &#13;&#10;procedure rllPaginaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllPagina.Text := 'PAGINA: ' + rllPagina.Text;                                                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllTotalImpressoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  rllTotalImpresso.Text := 'REGISTROS IMPRESSOS: ' + rllTotalImpresso.Text;                                                                    &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure rlbDetalhesOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin    &#13;&#10;    vr_total := vr_total + rllVrTotal.value;                                                              &#13;&#10;    vr_custo := vr_custo + rllVrMedCusDe.value;&#13;&#10;  End;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;frxGen.&#34;MARGEM&#34;&#62; = 'S' Then&#13;&#10;  Begin&#13;&#10;    If (vr_total &#60;&#62; 0) and (vr_custo &#60;&#62; 0) Then&#13;&#10;    Begin      &#13;&#10;      if &#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '2' Then&#13;&#10;       rllVrMargemSu.Text  := Formatfloat('#,##0.00',( ( vr_total  / vr_custo ) *100 )-100)  &#13;&#10;      Else&#13;&#10;       rllVrMargemSu.Text := Formatfloat('#,##0.00',( 1-( vr_custo / vr_total ) )*100);&#13;&#10;    End&#13;&#10;    Else&#13;&#10;    Begin&#13;&#10;      If (vr_custo = 0) And (&#60;frxGen.&#34;VS_STRMARMKP&#34;&#62; = '1') Then&#13;&#10;        rllVrMargemSu.text := '100,00'&#13;&#10;      Else                  &#13;&#10;        rllVrMargemSu.text := '0,00';&#13;&#10;    End;                                                                         &#13;&#10;  End;                         &#13;&#10;end;&#13;&#10;&#13;&#10;procedure rllDescricaoOnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If fOpcaoSintetico = 'T' Then&#13;&#10;       rllDescricao.Text := fRetornaNomeTinta(rllCodigo.Text);  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  vr_total := 0;&#13;&#10;  vr_custo := 0;  &#13;&#10;end." PropData="">
