        object memSicrediTexto02: TfrxMemoView
          Left = 3.779530000000000000
          Top = 684.260050000000000000
          Width = 714.331170000000000000
          Height = 41.574830000000000000
          Memo.UTF8W = (
            
              'O arquivo do certificado PFX deve ser selecionado e gravado no c' +
              'ampo "Certificado PFX" da aba "Dados de Autoriza'#231#227'o Pix". Esse c' +
              'ertificado '#233' obrigat'#243'rio para o Sicredi.')
        end
        object memJornadaSicredi01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 98.708720000000000000
          Width = 714.331170000000000000
          Height = 434.645950000000000000
          Memo.UTF8W = (
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Sicre' +
              'di, depois de realizar o aceite no termo de ades'#227'o do Pix junto ' +
              'ao banco, '#233' necess'#225'rio seguir as seguintes etapas:'
            ''
            'Etapa 1:'
            
              '* Encaminhar um e-mail para a Citel contendo o CNPJ e o e-mail q' +
              'ual foi cadastrado no termo de ades'#227'o do Pix;'
            '* A Citel responder'#225' o e-mail com um certificado CSR;'
            
              '* Acesse o Internet Banking com seus dados de Cooperativa e Cont' +
              'a;'
            
              '* Clique no menu >Outros Servi'#231'os > Acesso API Pix > Gerenciar C' +
              'ertificados;'
            '* Realize o upload do certificado CSR enviado pela Citel;'
            '* Avance as etapas para concluir a solicita'#231#227'o;'
            
              'Obs: O banco ir'#225' validar os dados e o certificado. Esse prazo '#233' ' +
              'de at'#233' tr'#234's dias '#250'teis. '
            ''
            'Etapa 2:'
            
              '* Acesse o Internet Banking com seus dados de Cooperativa e Cont' +
              'a;'
            
              '* Clique no menu >Outros Servi'#231'os > Acesso API Pix > Gerenciar C' +
              'ertificados;'
            
              '* Realize o download dos arquivos disponibilizados - Certificado' +
              ' Digital CER e Cadeia de Certificados Completa Sicredi CER;'
            '* Envie os arquivos para a Citel gerar o certificado PFX.'
            ''
            'Etapa 3:'
            
              '* Acesse o Internet Banking com seus dados de Cooperativa e Cont' +
              'a;'
            
              '* Clique no menu >Outros Servi'#231'os > Acesso API Pix > Gerar Crede' +
              'nciais;'
            '* Selecione o ambiente virtual de PRODU'#199#195'O;'
            
              '* Selecione o campo de '#39'Aceite'#39' do Termo de Uso apresentado em t' +
              'ela e avance;'
            
              '* Digite os n'#250'meros correspondentes a sua assinatura eletr'#244'nica ' +
              'e avance;'
            
              'IMPORTANTE: As credenciais de produ'#231#227'o ser'#227'o geradas em tela. Co' +
              'pie essas credenciais (Client ID e Client Secret) e salve-as.'
            
              'Depois que fechar a tela, n'#227'o ser'#225' mais poss'#237'vel acessar as cred' +
              'enciais geradas nessa etapa.')
        end
        object memSicrediTexto04: TfrxMemoView
          Left = 3.779530000000000000
          Top = 730.685530000000000000
          Width = 714.331170000000000000
          Height = 49.133890000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do da chave Basic deve ser gravado no campo "Autoriza'#231#227'o' +
              ' Basic", da aba "Dados de Autoriza'#231#227'o Pix" no "Cadastro de Conta' +
              's Banc'#225'rias".Deve ser gerada a chave Basic atrav'#233's dos campos Cl' +
              'ient ID e Client Secret. A Autoriza'#231#227'o Basic '#233' obrigat'#243'ria para ' +
              'o Sicredi.')
        end
      end
