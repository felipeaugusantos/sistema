        object memBradescoTexto03: TfrxMemoView
          Left = 0.779530000000000000
          Top = 734.827150000000000000
          Width = 714.331170000000000000
          Height = 41.574830000000000000
          Memo.UTF8W = (
            
              'Os arquivos dos certificados CRT e KEY devem ser selecionados e ' +
              'gravados nos campos "Certificado CRT" e "Certificado KEY" da aba' +
              ' "Dados de Autoriza'#231#227'o Pix" respectivamente. Esses dados s'#227'o obr' +
              'igat'#243'rios para o Bradesco.')
        end
        object memBradescoTexto04: TfrxMemoView
          Left = 0.779530000000000000
          Top = 791.520100000000000000
          Width = 714.331170000000000000
          Height = 18.897650000000000000
          Memo.UTF8W = (
            
              'A Senha do Certificado deve ser preenchida com a mesma senha do ' +
              'arquivo .cer enviado para o Bradesco.')
        end
        object memJornadaBradesco01: TfrxMemoView
          Left = 0.779530000000000000
          Top = 110.165430000000000000
          Width = 714.331170000000000000
          Height = 143.622140000000000000
          Memo.UTF8W = (
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Brade' +
              'sco, '#233' necess'#225'rio seguir os seguintes passos:'
            
              '* O cliente deve enviar um e-mail para o banco Bradesco solicita' +
              'ndo as credencias para uso do Pix em ambiente de Produ'#231#227'o;'
            
              '* Encaminhar um e-mail para a Citel contendo um certificado A1 d' +
              'o CNPJ detentor da conta, juntamente com sua senha;'
            
              '* A Citel enviar'#225' o arquivo contendo a chave p'#250'blica do certific' +
              'ado ao cliente, para que possa ser encaminhado para o atendiment' +
              'o do Bradesco, quando o banco fizer a solicita'#231#227'o;'
            
              '* O Bradesco encaminhar'#225' um e-mail com os dados de autentica'#231#227'o ' +
              '(Client Id e Client Secret);'
            
              '* Com esses dados, a Citel encaminhar'#225' os certificados para real' +
              'izar a configura'#231#227'o para uso do Pix Bradesco.')
        end
        object memVersaoBradesco01: TfrxMemoView
          Top = 86.929190000000000000
          Width = 260.787570000000000000
          Height = 18.897650000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            'Vers'#227'o 1 da API (Modelo antigo):')
          ParentFont = False
        end
        object memJornadaBradesco02: TfrxMemoView
          Left = 0.779530000000000000
          Top = 303.921460000000000000
          Width = 714.331170000000000000
          Height = 162.519790000000000000
          Memo.UTF8W = (
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Brade' +
              'sco, '#233' necess'#225'rio seguir os seguintes passos:'
            
              '* O cliente deve realizar o cadastro no site Developers do Brade' +
              'sco no link: https://developers.bradesco.com.br/;'
            
              'Passo a passo do cadastro pode ser acessado em: https://develope' +
              'rs.bradesco.com.br/documents/8a2e82cd96a2f2fe0196cb3013f65539'
            ''
            
              '* Depois de realizar o login no portal, selecione "Produtos", cl' +
              'ique no item "Pix - gera'#231#227'o de QR Code" e selecione a aba "Docum' +
              'enta'#231#227'o";'
            
              '* Acesse a documenta'#231#227'o "Como Gerar sua Credencial para API PIX ' +
              '- Gera'#231#227'o de QR code".'
            
              'Juntamente com a Citel, siga os passos dessa documenta'#231#227'o para g' +
              'erar credenciais, selecionar certificado, recursos, etc.')
        end
