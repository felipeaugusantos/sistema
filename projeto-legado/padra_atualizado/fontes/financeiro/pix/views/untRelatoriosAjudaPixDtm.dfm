          Memo.UTF8W = (
            
              'O conte'#250'do da chave Basic deve ser gravado no campo "Autoriza'#231#227'o' +
              ' Basic", da aba "Dados de Autoriza'#231#227'o Pix" no "Cadastro de Conta' +
              's Banc'#225'rias".Deve ser gerada a chave Basic atrav'#233's dos campos Cl' +
              'ient ID e Client Secret. A Autoriza'#231#227'o Basic '#233' obrigat'#243'ria para ' +
              'o Bradesco.')
        end
