        object memBancoBrasilTexto02: TfrxMemoView
          Left = 4.000000000000000000
          Top = 207.724490000000000000
          Width = 714.331170000000000000
          Height = 79.370130000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do da chave Basic deve ser gravado no campo "Autoriza'#231#227'o' +
              ' Basic", da aba "Dados de Autoriza'#231#227'o Pix" no "Cadastro de Conta' +
              's Banc'#225'rias".'
            
              'Pode tamb'#233'm gerar a chave Basic atrav'#233's dos campos Client ID e C' +
              'lient Secret. Os campos devem ser gravados em "Client ID" e "Cli' +
              'ent Secret" da aba "Dados de Autoriza'#231#227'o Pix". Se a chave Basic ' +
              'j'#225' estiver cadastrada, esses campos n'#227'o s'#227'o obrigat'#243'rios para o ' +
              'Banco do Brasil.')
        end
