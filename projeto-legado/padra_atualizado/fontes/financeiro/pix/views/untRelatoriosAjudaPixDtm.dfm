        object memSantanderTitulo: TfrxMemoView
          Left = 83.149660000000000000
          Top = 35.000000000000000000
          Width = 136.063080000000000000
          Height = 18.897650000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -16
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            'Santander')
          ParentFont = False
        end
        object memJornadaSantander01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 91.929190000000000000
          Width = 714.331170000000000000
          Height = 143.622140000000000000
          Memo.UTF8W = (
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Santa' +
              'nder, '#233' necess'#225'rio seguir os seguintes passos:'
            
              '* O cliente deve enviar um e-mail para o banco Santander solicit' +
              'ando as credencias para uso do Pix em ambiente de Produ'#231#227'o;'
            
              '* Encaminhar um e-mail para a Citel contendo um certificado A1 d' +
              'o CNPJ detentor da conta, juntamente com sua senha;'
            
              '* A Citel enviar'#225' o arquivo contendo a chave p'#250'blica do certific' +
              'ado ao cliente, para que possa ser encaminhado para o atendiment' +
              'o do Santander, quando o banco fizer a solicita'#231#227'o;'
            
              '* O Santander encaminhar'#225' um e-mail com os dados de autentica'#231#227'o' +
              ' (Client Id e Client Secret);'
            
              '* Com esses dados, a Citel encaminhar'#225' os certificados para real' +
              'izar a configura'#231#227'o para uso do Pix Santander.')
        end
        object memSantanderTexto01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 358.260050000000000000
          Width = 714.331170000000000000
          Height = 37.795300000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do das chaves Client ID e Client Secret devem ser gravad' +
              'os nos campos "Client ID" e "Client Secret" da aba "Dados de Aut' +
              'oriza'#231#227'o Pix" respectivamente. Essas chaves s'#227'o obrigat'#243'rias par' +
              'a autentica'#231#227'o da API no Santander.')
        end
        object memSantanderItens: TfrxMemoView
          Left = 3.779530000000000000
          Top = 249.448980000000000000
          Width = 362.834880000000000000
          Height = 94.488250000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            '1) Client ID'
            '2) Client Secret'
            '3) Basic'
            '4) Certificado de Autentica'#231#227'o PFX'
            '5) Senha do Certificado'
            '6) Chaves Pix (CNPJ, celular, aleat'#243'ria, etc)')
          ParentFont = False
        end
        object memSantanderTexto02: TfrxMemoView
          Left = 3.779530000000000000
          Top = 411.173470000000000000
          Width = 714.331170000000000000
          Height = 49.133890000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do da chave Basic deve ser gravado no campo "Autoriza'#231#227'o' +
              ' Basic", da aba "Dados de Autoriza'#231#227'o Pix" no "Cadastro de Conta' +
              's Banc'#225'rias".Deve ser gerada a chave Basic atrav'#233's dos campos Cl' +
              'ient ID e Client Secret. A Autoriza'#231#227'o Basic '#233' obrigat'#243'ria para ' +
              'o Santander.')
        end
        object memSantanderTexto05: TfrxMemoView
          Left = 3.779530000000000000
          Top = 572.732530000000000000
          Width = 714.331170000000000000
          Height = 49.133890000000000000
          Memo.UTF8W = (
            
              'As Chaves Pix vinculadas a conta devem ser cadastradas na aba "C' +
              'haves Pix da Conta" no "Cadastro de Contas Banc'#225'rias".'
            
              'S'#227'o 4 tipos de chaves que podem ser vinculadas a conta: CNPJ/CPF' +
              ', celular, e-mail e aleat'#243'ria.')
        end
        object memSantanderTexto03: TfrxMemoView
          Left = 3.779530000000000000
          Top = 476.811380000000000000
          Width = 714.331170000000000000
          Height = 41.574830000000000000
          Memo.UTF8W = (
            
              'O arquivo do certificado PFX deve ser selecionado e gravado no c' +
              'ampo "Certificado PFX" da aba "Dados de Autoriza'#231#227'o Pix". Esse c' +
              'ertificado '#233' obrigat'#243'rio para o Santander.')
        end
        object memSantanderTexto04: TfrxMemoView
          Left = 3.779530000000000000
          Top = 533.504330000000000000
          Width = 714.331170000000000000
          Height = 18.897650000000000000
          Memo.UTF8W = (
            
              'A Senha do Certificado deve ser preenchida com a mesma senha do ' +
              'arquivo .cer enviado para o Santander.')
        end
      end
