        object memPixShipay: TfrxMemoView
          Left = 83.149660000000000000
          Top = 30.440940000000000000
          Width = 211.653680000000000000
          Height = 18.897650000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -16
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            'Pix Todos os Bancos')
          ParentFont = False
        end
        object memJornadaShipay01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 79.370130000000000000
          Width = 714.331170000000000000
          Height = 128.504020000000000000
          Memo.UTF8W = (
            
              'O Pix Todos os Bancos ativar'#225' a conta banc'#225'ria do cliente para u' +
              'so de recebimentos por Pix, independente da institui'#231#227'o da conta' +
              '.'
            ''
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Todos' +
              ' os Bancos, '#233' necess'#225'rio seguir os seguintes passos:'
            
              '* O cliente deve entrar em contato com a Citel atrav'#233's do e-mail' +
              ', solicitando o uso do Pix Todos os Bancos'
            
              '* A Citel retornar'#225' um e-mail com algumas instru'#231#245'es, al'#233'm de so' +
              'licitar os dados da empresa e conta Pix'
            
              '* Depois da solicita'#231#227'o, a Citel continuar'#225' com o cadastro junto' +
              ' com o cliente e assim ser'#227'o geradas as chaves para configura'#231#227'o' +
              ' da conta.')
        end
        object memShipayItens: TfrxMemoView
          Left = 3.779530000000000000
          Top = 220.196970000000000000
          Width = 362.834880000000000000
          Height = 56.692950000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            '1) Access Key'
            '2) Client ID'
            '3) Client Secret')
          ParentFont = False
        end
        object memShipayTexto01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 284.448980000000000000
          Width = 714.331170000000000000
          Height = 37.795300000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do da chave Access Key deve ser gravado no campo "Access' +
              ' Key", da aba "Dados de Autoriza'#231#227'o Pix" no "Cadastro de Contas ' +
              'Banc'#225'rias".')
        end
        object memShipayTexto02: TfrxMemoView
          Left = 3.779530000000000000
          Top = 329.803340000000000000
          Width = 714.331170000000000000
          Height = 56.692950000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do das chaves Client ID e Client Secret devem ser gravad' +
              'os nos campos "Client ID" e "Client Secret" da aba "Dados de Aut' +
              'oriza'#231#227'o Pix" respectivamente. Essas chaves s'#227'o obrigat'#243'rias par' +
              'a autentica'#231#227'o da API na utiliza'#231#227'o do Pix Todos os Bancos.')
        end
        object memShipayTexto03: TfrxMemoView
          Left = 3.779530000000000000
          Top = 397.834880000000000000
          Width = 714.331170000000000000
          Height = 49.133890000000000000
          Memo.UTF8W = (
            
              'As Chaves Pix vinculadas a conta devem ser cadastradas na aba "C' +
              'haves Pix da Conta" no "Cadastro de Contas Banc'#225'rias".'
            
              'S'#227'o 4 tipos de chaves que podem ser vinculadas a conta: CNPJ/CPF' +
              ', celular, e-mail e aleat'#243'ria.')
        end
      end
      object rlbSafra: TfrxChild
        FillType = ftBrush
        Height = 495.551330000000000000
        Top = 3632.128330000000000000
        Width = 718.110700000000000000
        Child = frxChavesAutorizacao.rlbShipay
        PrintChildIfInvisible = True
        object Memo83: TfrxMemoView
          Left = 3.779530000000000000
          Top = 355.708720000000000000
          Width = 714.331170000000000000
          Height = 117.165430000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do das chaves Client ID e Client Secret devem ser gravad' +
              'os nos campos "Client ID" e "Client Secret" da aba "Dados de Aut' +
              'oriza'#231#227'o Pix" respectivamente. Essas chaves s'#227'o obrigat'#243'rias par' +
              'a autentica'#231#227'o da API no Safra.'
            
              'O arquivo do certificado PFX deve ser selecionado e gravado no c' +
              'ampo "Certificado PFX" da aba "Dados de Autoriza'#231#227'o Pix". Esse c' +
              'ertificado '#233' obrigat'#243'rio para o Safra.'
            
              'A Senha do Certificado deve ser preenchida com a mesma senha do ' +
              'arquivo PFX enviado para o Safra.'
            
              'As Chaves Pix vinculadas '#224' conta devem ser cadastradas na aba "C' +
              'haves Pix da Conta".'
            
              'S'#227'o 4 tipos de chaves que podem ser vinculadas '#224' conta: CNPJ/CPF' +
              ', celular, e-mail e aleat'#243'ria.')
        end
        object Memo84: TfrxMemoView
          Left = 3.779530000000000000
          Top = 269.574830000000000000
          Width = 718.110700000000000000
          Height = 94.488250000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            '1) Client ID (Recebido por e-mail)'
            '2) Client Secret (Recebido por SMS)'
            
              '3) Certificado PFX  (certificado digital do cliente enviado prev' +
              'iamente ao Safra);'
            '4) Senha do Certificado (Mesma senha do arquivo PFX)'
            '5) Chaves Pix (CNPJ, celular, aleat'#243'ria, etc)')
          ParentFont = False
        end
