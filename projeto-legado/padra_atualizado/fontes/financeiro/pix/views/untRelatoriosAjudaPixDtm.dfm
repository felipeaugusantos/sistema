          Memo.UTF8W = (
            
              'O conte'#250'do das chaves Client ID e Client Secret devem ser gravad' +
              'os nos campos "Client ID" e "Client Secret" da aba "Dados de Aut' +
              'oriza'#231#227'o Pix" respectivamente. Essas chaves s'#227'o obrigat'#243'rias par' +
              'a autentica'#231#227'o da API no Bradesco.')
        end
