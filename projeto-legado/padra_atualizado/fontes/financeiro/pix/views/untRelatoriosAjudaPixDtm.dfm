        object memBancoBrasilTexto03: TfrxMemoView
          Left = 4.000000000000000000
          Top = 613.283550000000000000
          Width = 714.331170000000000000
          Height = 49.133890000000000000
          Memo.UTF8W = (
            
              'As Chaves Pix vinculadas a conta devem ser cadastradas na aba "C' +
              'haves Pix da Conta" no "Cadastro de Contas Banc'#225'rias".'
            
              'S'#227'o 4 tipos de chaves que podem ser vinculadas a conta: CNPJ/CPF' +
              ', celular, e-mail e aleat'#243'ria.')
        end
        object memBancoBrasilTexto04: TfrxMemoView
          Left = 4.000000000000000000
          Top = 300.000000000000000000
          Width = 714.834880000000000000
          Height = 36.692950000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            
              'AVISO: Nas contas Pix com a API ativada ap'#243's dia 26/06/2023, a A' +
              'PI ser'#225' utilizada na vers'#227'o 2. Essa vers'#227'o possui algumas mudan'#231 +
              'as.')
          ParentFont = False
        end
        object memBancoBrasilTexto05: TfrxMemoView
          Left = 4.000000000000000000
          Top = 340.000000000000000000
          Width = 426.834880000000000000
          Height = 24.692950000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            '4) Certificado de Autentica'#231#227'o PFX (apenas vers'#227'o 2 da API)')
          ParentFont = False
        end
        object memBancoBrasilTexto06: TfrxMemoView
          Left = 4.000000000000000000
          Top = 372.000000000000000000
          Width = 714.331170000000000000
          Height = 163.622140000000000000
          Memo.UTF8W = (
            
              'Para a configura'#231#227'o do certificado do Pix Banco do Brasil, '#233' nec' +
              'ess'#225'rio seguir os seguintes passos:'
            
              '* O cliente deve encaminhar um e-mail para a Citel contendo um c' +
              'ertificado A1 do CNPJ detentor da conta, juntamente com sua senh' +
              'a;'
            
              '* A Citel enviar'#225' os arquivos contendo a chave p'#250'blica, certific' +
              'ado intermedi'#225'rio e o certificado raiz ao cliente;'
            
              '* Com os certificados, a Citel ir'#225' auxiliar o cliente na implant' +
              'a'#231#227'o do certificado no portal do Banco do Brasil;'
            ''
            
              '*No portal do Banco do Brasil, deve selecionar a aplica'#231#227'o onde ' +
              'cont'#233'm a API Pix vers'#227'o 2;'
            
              '*No canto direito, selecionar a op'#231#227'o Certificados e clicar em E' +
              'nviar Certificados;'
            
              '*Nesse momento, deve ser copiado os dados de dentro dos arquivso' +
              ' dos certificados enviados pela Citel e colar o conte'#250'do cada um' +
              ' em seu campo, dentro do portal.')
        end
        object memBancoBrasilTexto07: TfrxMemoView
          Left = 4.000000000000000000
          Top = 549.000000000000000000
          Width = 714.331170000000000000
          Height = 41.574830000000000000
          Memo.UTF8W = (
            
              'O arquivo do certificado PFX deve ser selecionado e gravado no c' +
              'ampo "Certificado PFX" da aba "Dados de Autoriza'#231#227'o Pix". Esse c' +
              'ertificado '#233' obrigat'#243'rio para o Banco do Brasil vers'#227'o 2.')
        end
      end
    end
