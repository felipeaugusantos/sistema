        object Memo86: TfrxMemoView
          Left = 3.779530000000000000
          Top = 79.370130000000000000
          Width = 714.331170000000000000
          Height = 192.756030000000000000
          Memo.UTF8W = (
            ''
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Safra' +
              ', '#233' necess'#225'rio seguir os seguintes passos:'
            
              '    '#8226' O cliente deve solicitar ao gerente comercial do Safra o T' +
              'ermo de Ades'#227'o '#224' API de Recebimento Pix;'
            
              '    '#8226' Ap'#243's assinatura do termo, o gerente abrir'#225' um ticket junto' +
              ' '#224' Mesa de Implanta'#231#227'o do Safra;'
            
              '    '#8226' A Mesa de Implanta'#231#227'o enviar'#225' um Formul'#225'rio de Cadastro de' +
              ' Credenciais e Escopos para o cliente preencher;'
            
              '    '#8226' O cliente deve enviar um certificado SSL/TLS (tipo OV ou E' +
              'V) no formato .pfx a Mesa de Implanta'#231#227'o do Safra (mesa.implanta' +
              'cao@safra.com.br);'
            
              '    '#8226' Ap'#243's processamento, o Safra enviar'#225' o Client ID por e-mail' +
              ' e o Client Secret por SMS;'
            
              '    '#8226' Com esses dados, o cliente pode configurar a conta no sist' +
              'ema.'
            ''
            
              'Ap'#243's concluir o processo inicial com o banco e receber suas cred' +
              'enciais, voc'#234' precisar'#225' dos seguintes dados para configurar o Pi' +
              'x no sistema:')
        end
      end
    end
