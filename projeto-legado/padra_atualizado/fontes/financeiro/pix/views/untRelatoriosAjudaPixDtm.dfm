        object memSicoobTexto02: TfrxMemoView
          Left = 3.779530000000000000
          Top = 547.173470000000000000
          Width = 714.331170000000000000
          Height = 41.574830000000000000
          Memo.UTF8W = (
            
              'O arquivo do certificado PFX deve ser selecionado e gravado no c' +
              'ampo "Certificado PFX" da aba "Dados de Autoriza'#231#227'o Pix". Esse c' +
              'ertificado '#233' obrigat'#243'rio para o Sicoob.')
        end
        object memSicoobTexto04: TfrxMemoView
          Left = 3.779530000000000000
          Top = 596.866420000000000000
          Width = 714.331170000000000000
          Height = 18.897650000000000000
          Memo.UTF8W = (
            
              'A Senha do Certificado deve ser preenchida com a mesma senha do ' +
              'arquivo original enviado para o Sicoob.')
        end
        object memJornadaSicoob01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 98.708720000000000000
          Width = 714.331170000000000000
          Height = 302.362400000000000000
          Memo.UTF8W = (
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o do Pix Sicoo' +
              'b, '#233' necess'#225'rio seguir os seguintes passos:'
            
              '* Encaminhar um e-mail para a Citel contendo um certificado A1 d' +
              'o CNPJ detentor da conta, juntamente com sua senha;'
            
              '* Com os dados e o arquivo .PEM que a Citel retornar, o cliente ' +
              '(cooperado) deve realizar o cadastro no portal Developers do Sic' +
              'oob: https://developers.sicoob.com.br'
            
              '*Depois de realizado o cadastro e ativa'#231#227'o do mesmo, o cooperado' +
              ' deve realizar o login'
            '*Entrar em "Meus Aplicativos" e clicar em "Nova Aplica'#231#227'o"'
            
              '*Nesse momento o banco faz a valida'#231#227'o dos dados da conta do coo' +
              'perado. Esse deve digitar os dados solicitados no portal.'
            '*Deve clicar em "Aprovar".'
            
              '*Deve informar o nome do aplicativo como "AUTCOM" e uma descri'#231#227 +
              'o e clicar em "Pr'#243'ximo".'
            '*Deve selecionar a op'#231#227'o Pix e clicar em "Pr'#243'ximo".'
            
              '*Deve selecionar o n'#250'mero da conta em que a aplica'#231#227'o ser'#225' vincu' +
              'lada, Na op'#231#227'o "A integra'#231#227'o ser'#225' realizada por uma empresa parc' +
              'eira", selecionar "N'#227'o".'
            
              'Depois deve selecionar o certificado "Arquivo PEM" enviado pela ' +
              'Citel no campo "Certificado Digital" e clicar em "Pr'#243'ximo".'
            '*Deve clicar em "Concluir".'
            ''
            
              'Deve copiar as cred'#234'nciais que ser'#227'o geradas na pr'#243'xima tela (Cl' +
              'ient ID e/ou Client Secret).')
        end
      end
      object rlbSicredi: TfrxChild
        FillType = ftBrush
        Height = 851.653990000000000000
        Top = 2090.080090000000000000
        Width = 718.110700000000000000
        Child = frxChavesAutorizacao.rlbSantander
