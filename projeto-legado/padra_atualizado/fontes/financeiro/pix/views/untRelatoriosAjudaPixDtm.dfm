        object memItauItens: TfrxMemoView
          Left = 3.779530000000000000
          Top = 308.708720000000000000
          Width = 362.834880000000000000
          Height = 64.252010000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          Memo.UTF8W = (
            '1) Client ID'
            '2) Client Secret'
            '3) Certificados de Autentica'#231#227'o CRT e Key'
            '4) Chaves Pix (CNPJ, celular, aleat'#243'ria, etc)')
          ParentFont = False
        end
        object memItauTexto01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 379.960730000000000000
          Width = 714.331170000000000000
          Height = 34.015770000000000000
          Memo.UTF8W = (
            
              'O conte'#250'do das chaves Client ID, Client Secret, Certificado CRT ' +
              'e Certificado Key devem ser importados no bot'#227'o "Importar Dados ' +
              'Autoriza'#231#227'o", depois do cliente ter realizado a autoriza'#231#227'o no b' +
              'ankline do Ita'#250'.')
        end
        object memItauTexto03: TfrxMemoView
          Left = 3.779530000000000000
          Top = 423.692950000000000000
          Width = 714.331170000000000000
          Height = 49.133890000000000000
          Memo.UTF8W = (
            
              'As Chaves Pix vinculadas a conta devem ser cadastradas na aba "C' +
              'haves Pix da Conta" no "Cadastro de Contas Banc'#225'rias".'
            
              'S'#227'o 4 tipos de chaves que podem ser vinculadas a conta: CNPJ/CPF' +
              ', celular, e-mail e aleat'#243'ria.')
        end
        object memJornadaItau01: TfrxMemoView
          Left = 3.779530000000000000
          Top = 94.267780000000000000
          Width = 714.331170000000000000
          Height = 207.874150000000000000
          Memo.UTF8W = (
            
              'Para o in'#237'cio da jornada de ativa'#231#227'o e configura'#231#227'o no novo mode' +
              'lo do Pix Ita'#250', '#233' necess'#225'rio seguir os seguintes passos:'
            
              '* O cliente deve entrar no bankline da conta corrente vinculada ' +
              'a chave Pix;'
            
              '  -Deve acessar o menu "cobran'#231'as" e o item "ir para p'#225'gina de c' +
              'obran'#231'as";'
            '  -Em "Pagamento Instant'#226'neo Pix", deve acessar "Parceiros Pix";'
            
              '  -Deve acessar "utilize uma chave Pix existente" ou "cadastre u' +
              'ma chave Pix" (no caso do cliente n'#227'o possuir chave Pix para a c' +
              'onta);'
            
              '  -Deve selecionar o item "a'#231#227'o" da chave Pix e acessar o item "' +
              'vincular com parceiro";'
            
              '  -Deve selecionar o parceiro "Citel Software", selecionar o ite' +
              'm "acesso completo" e acessar "adicionar parceiro".'
            
              '* Depois de cinco minutos autorizado no bankline, cadastre a cha' +
              've Pix no Autcom clique no bot'#227'o "Importar Dados Autoriza'#231#227'o" na' +
              ' aba "Dados de Autoriza'#231#227'o Pix".'
            ''
            
              'ATEN'#199#195'O: N'#227'o '#233' poss'#237'vel reutilizar as credenciais que j'#225' est'#227'o e' +
              'm uso em outros sistemas, como o TEF por exemplo.')
        end
      end
