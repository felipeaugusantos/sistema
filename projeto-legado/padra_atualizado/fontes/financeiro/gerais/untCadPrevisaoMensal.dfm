      object Memo10: TfrxMemoView
        Left = 38.133890000000000000
        Top = 399.992580000000000000
        Width = 666.520100000000000000
        Height = 322.692950000000000000
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -16
        Font.Name = 'Arial'
        Font.Style = []
        Memo.UTF8W = (
          
            '1'#186' - Ap'#243's importar o arquivo o mesmo vai renomear a extens'#227'o de ' +
            '".xls ou xlsx" para ".imp".'
          ''
          '2'#186' - Os registros do arquivo ser'#227'o salvos em duas tabelas:'
          
            'IMPPRV - onde ficam armazenados os dados principais do arquivo(n' +
            'ome, operador que importou, data da importa'#231#227'o...);'
          
            'DETPRV - onde ficam armazenados o detalhamento do arquivo linha ' +
            'a linha(receitas e despesas (plano de contas));'
          ''
          
            '3'#186' - Caso exista  despesas (plano de contas) sem referencia para' +
            ' vincular no AUTCOM, ao final da importa'#231#227'o '#233' listado um relat'#243'r' +
            'io de inconsist'#234'ncia;'
          ''
          
            '4'#186' - Caso ao importar o arquivo, j'#225' exista uma movimenta'#231#227'o para' +
            ' a mesma empresa/ano, '#233' feito o seguinte questionamento:'
          
            'J'#225' existem lan'#231'amentos para o movimento. Deseja atualizar os lan' +
            #231'amentos?'#39
          
            'Se o usu'#225'rio escolher sim, os lan'#231'amentos ser'#227'o atualizados, sen' +
            #227'o, a importa'#231#227'o '#233' cancelada.')
        ParentFont = False
      end
