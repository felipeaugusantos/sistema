      'begin'
      '  picNot.Visible := (<frxRelExtBan."EXT_SITUAC"> = '#39'N'#39');'
      '  picYes.Visible := (<frxRelExtBan."EXT_SITUAC"> = '#39'R'#39');'
      '  picSimi.Visible := (<frxRelExtBan."EXT_SITUAC"> = '#39'S'#39');      '
