{*******************************************}
{* VERIFICA SE O DOCUMENTO FOI PROVENIENTE *}
{* DE FATURAMENTO DE PEDIDO OU ORCAMENTO   *}
{****************************************LU*}
procedure TfrmCancelamentoDocumentos.pVerificaDocProvFatORPD(strEspSel, strNumDoc, strCliFor: String);
  Var
    strSQL    : String;
    strSeqPed : String;
    intIdx    : Integer;
    qryFatGor : TUniQuery;
    qryFatDor : TUniQuery;
    qryExtDor : TUniQuery;
    qryDorIcd : TUniQuery;
    qryExtGor : TUniQuery;
    qryExtLar : TUniQuery;

  function fCancelaPedidos(blnCancelaCtrConf: Boolean): Boolean;
  Begin
    Result := True;

    With qryFatGor Do
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT   ';
      strSQL := strSQL + '  *      ';
      strSQL := strSQL + 'FROM     ';
      strSQL := strSQL + '  FATDOR ';
      strSQL := strSQL + 'WHERE    ';
      strSQL := strSQL + '  FDO_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '  FDO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  FDO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  FDO_CODEMP = :CODEMP ';

      qryFatDor.Close;
      qryFatDor.SQL.Clear;
      qryFatDor.SQL.Add(strSQL);
      qryFatDor.ParamByName('NUMDOC').AsString := FieldByName('FGO_NUMDOC').AsString;
      qryFatDor.ParamByName('ESPDOC').AsString := FieldByName('FGO_ESPDOC').AsString;
      qryFatDor.ParamByName('CODEMP').AsString := FieldByName('FGO_CODEMP').AsString;
      qryFatDor.ParamByName('CODCLI').AsString := FieldByName('FGO_CODCLI').AsString;
      qryFatDor.Open;

      While Not qryFatDor.Eof Do
      Begin
        If (qryFatDor.FindField('FDO_ORDPRO') <> Nil) And
           (Not fEmptyStr(qryFatDor.FieldByName('FDO_ORDPRO').AsString)) Then
        Begin
          fCancelaOrdemProducaoPedido(qryFatDor.FieldByName('FDO_ORDPRO').AsString,
                                      qryFatDor.FieldByName('FDO_CODCLI').AsString,
                                      qryFatDor.FieldByName('FDO_CODEMP').AsString);
        End;

        strSQL := '';
        strSQL := strSQL + 'SELECT   ';
        strSQL := strSQL + '  *      ';
        strSQL := strSQL + 'FROM     ';
        strSQL := strSQL + '  EXTDOR ';
        strSQL := strSQL + 'WHERE    ';
        strSQL := strSQL + '  FDO_SEQFDO = :SEQFDO ';

        qryExtDor.Close;
        qryExtDor.SQL.Clear;
        qryExtDor.SQL.Add(strSQL);
        qryExtDor.ParamByName('SEQFDO').AsString := qryFatDor.FieldByName('AUTOINCREM').AsString;
        qryExtDor.Open;
        fVerificaIntegridade(Self.Name, 'EXTDOR', qryExtDor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        strSQL := '';
        strSQL := strSQL + 'SELECT   ';
        strSQL := strSQL + '  *      ';
        strSQL := strSQL + 'FROM     ';
        strSQL := strSQL + '  DORICD ';
        strSQL := strSQL + 'WHERE    ';
        strSQL := strSQL + '  ICD_SEQFDO = :SEQFDO ';

        qryDorIcd.Close;
        qryDorIcd.SQL.Clear;
        qryDorIcd.SQL.Add(strSQL);
        qryDorIcd.ParamByName('SEQFDO').AsString := qryFatDor.FieldByName('AUTOINCREM').AsString;
        qryDorIcd.Open;
        fVerificaIntegridade(Self.Name, 'DORICD', qryDorIcd, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        {******************************************}
        {* SALVA NA TABELA DE REGISTROS DELETADOS *}
        {***************************************LU*}
        fVerificaIntegridade(Self.Name, 'FATDOR', qryFatDor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
        pGravaDeletadosMadeira(qryFatDor.FieldByName('AUTOINCREM').AsString, 'FATDOR');

        ReprocessarItem(qryFatDor.FieldByName('FDO_CODITE').AsString, '', True, True);

        qryFatDor.Next;
      End;

      if (not fDeletaCadRecPDVendaABaseTroca(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                             qryFatGor.FieldByName('FGO_CODEMP').AsString,
                                             qryFatGor.FieldByName('FGO_CODCLI').AsString)) then
        Exit(False);

      strSQL := '';
      strSQL := strSQL + 'SELECT   ';
      strSQL := strSQL + '  *      ';
      strSQL := strSQL + 'FROM     ';
      strSQL := strSQL + '  EXTGOR ';
      strSQL := strSQL + 'WHERE    ';
      strSQL := strSQL + '  FGO_SEQFGO = :SEQFGO ';

      qryExtGor.Close;
      qryExtGor.SQL.Clear;
      qryExtGor.SQL.Add(strSQL);
      qryExtGor.ParamByName('SEQFGO').AsString := qryFatGor.FieldByName('AUTOINCREM').AsString;
      qryExtGor.Open;
      fVerificaIntegridade(Self.Name, 'EXTGOR', qryExtGor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

      strSQL := '';
      strSQL := strSQL + 'SELECT   ';
      strSQL := strSQL + '  *      ';
      strSQL := strSQL + 'FROM     ';
      strSQL := strSQL + '  EXTLAR ';
      strSQL := strSQL + 'WHERE    ';
      strSQL := strSQL + '  COD_FATGOR = :SEQFGO ';

      qryExtLar.Close;
      qryExtLar.SQL.Clear;
      qryExtLar.SQL.Add(strSQL);
      qryExtLar.ParamByName('SEQFGO').AsString := qryFatGor.FieldByName('AUTOINCREM').AsString;
      qryExtLar.Open;
      fVerificaIntegridade(Self.Name, 'EXTLAR', qryExtLar, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

      {******************************************}
      {* SALVA NA TABELA DE REGISTROS DELETADOS *}
      {***************************************LU*}
      fVerificaIntegridade(Self.Name, 'FATGOR', qryFatGor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
      pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_FATGOR', qryFatGor.FieldByName('AUTOINCREM').AsString);

      {*************************************}
      {* APAGA O REGISTRO NA TABELA FATGOR *}
      {**********************************LU*}

      If Assigned(objConEnt) And (blnCancelaCtrConf) Then
      Begin
        If (FieldByName('FGO_ESPDOC').AsString = 'PD') Then
        Begin
          {***************************************************************}
          {* Armazena divergências de data entre o pedido e documento de *}
          {* faturamento para processamento na exclusão final do         *}
          {* documento de faturamento                                    *}
          {************ ***********************************************VA*}
          objConEnt.fSetNumDoc(edtNumDoc.Text,
                               strEspSel,
                               VS_strCodEmp,
                               edtCliFor.Text);

          If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
          Begin
            objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEmpOri, tBusDatasDivergentesDocFat);//Tirar reserva destas datas
            objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEmpEnt, tBusDatasDivergentesPedOrc);//Reservar estas datas
          End
          Else
          Begin
            objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaOri, tBusDatasDivergentesDocFat);//Tirar reserva destas datas
            objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEnt, tBusDatasDivergentesPedOrc);//Reservar estas datas
          End;

          {***************************************************************}
          {* Armazena datas originais do pedido para que sejam tiradas   *}
          {* as respectivas reservas                                     *}
          {************ ***********************************************VA*}
          objConEnt.fSetNumDoc(FieldByName('FGO_NUMDOC').AsString,
                               FieldByName('FGO_ESPDOC').AsString,
                               FieldByName('FGO_CODEMP').AsString,
                               FieldByName('FGO_CODCLI').AsString);

          If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
            objConEnt.pCarregaArrayDatasPeloPedOrc(objConEnt.arrDtaEmpAux)
          Else
            objConEnt.pCarregaArrayDatasPeloPedOrc(objConEnt.arrDtaAux);//Tirar reserva destas datas

        End;
      End;

      strSQL := '';
      strSQL := strSQL + 'DELETE FROM ';
      strSQL := strSQL + '  FATGOR ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  FGO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  FGO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  FGO_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  FGO_CODCLI = :CODCLI ';

      pDeletaMovCarPedidoEcommerce(FieldByName('FGO_NUMDOC').AsString,
                                   FieldByName('FGO_ESPDOC').AsString,
                                   FieldByName('FGO_CODEMP').AsString);

      If fCfgSis('CUPDES') = 'S' Then
        TFatCupomDesconto.DesmarcarCupomUtilizado(FieldByName('FGO_NUMDOC').AsString,
                                                  FieldByName('FGO_ESPDOC').AsString,
                                                  FieldByName('FGO_CODEMP').AsString);

      {Envia Mensagens}
      If (FieldByName('FGO_ESPDOC').AsString = 'PD') Then
        pMensagemCancelamentoPedido(FieldByName('FGO_NUMDOC').AsString,
                                    FieldByName('FGO_ESPDOC').AsString,
                                    FieldByName('FGO_CODEMP').AsString);

      fDesfaturaPedidoVendaOuOrcamento(FieldByName('FGO_ESPDOC').AsString,
                                       FieldByName('FGO_NUMDOC').AsString,
                                       FieldByName('FGO_CODCLI').AsString,
                                       FieldByName('FGO_CODEMP').AsString,
                                       False);

      {*REQ.173491**********RP*}
      TLogGor.pLogDel(FieldByName('FGO_NUMDOC').AsString,
                      FieldByName('FGO_ESPDOC').AsString,
                      FieldByName('FGO_CODEMP').AsString);

      qryFatDor.Close;
      qryFatDor.SQL.Clear;
      qryFatDor.SQL.Add(strSQL);
      qryFatDor.ParamByName('NUMDOC').AsString := FieldByName('FGO_NUMDOC').AsString;
      qryFatDor.ParamByName('ESPDOC').AsString := FieldByName('FGO_ESPDOC').AsString;
      qryFatDor.ParamByName('CODEMP').AsString := FieldByName('FGO_CODEMP').AsString;
      qryFatDor.ParamByName('CODCLI').AsString := FieldByName('FGO_CODCLI').AsString;
      qryFatDor.ExecSQL;

      If (fCfgSis('UTINPS', varBoolean)) Then
        TNetpoints.pCancelarNetpoints(FieldByName('FGO_NUMDOC').AsString,
                                      FieldByName('FGO_ESPDOC').AsString,
                                      FieldByName('FGO_CODEMP').AsString,
                                      FieldByName('FGO_CODCLI').AsString,
                                      FieldByName('FGO_SERIE_').AsString,
                                      Self.Name,
                                      fMotivoDelecao, '');

      If (FieldByName('FGO_ESPDOC').AsString = 'PD') Then
        pCancelaConsertoEquipamentoDoPedido(FieldByName('FGO_NUMDOC').AsString, FieldByName('FGO_CODCLI').AsString);

      If blnCancelaCtrConf Then
        fVoltaCtrConfirmacao(strEspSel, edtNumDoc.Text, edtCliFor.Text);

      fCancelaContasReceber(FieldByName('FGO_ESPDOC').AsString,
                            FieldByName('FGO_NUMDOC').AsString,
                            FieldByName('FGO_CODCLI').AsString,
                            FieldByName('FGO_CODEMP').AsString);

      pDesvincularPedidoDeBrindeDoDocumentoDeVenda(FieldByName('FGO_NUMDOC').AsString,
                                                   FieldByName('FGO_ESPDOC').AsString,
                                                   FieldByName('FGO_CODEMP').AsString);

      blnApagPed := True;

    End;
  End;

begin
  If (Not fEspeciesQuePodemSerProvenientesFataurmentoORPD(strEspSel)) Then
    Exit;

  If (FCancelamentoDeFFPelaNotaEspecial) Then
    Exit;

  qryFatGor := fCriaQuery;
  qryExtGor := fCriaQuery;
  qryFatDor := fCriaQuery;
  qryExtDor := fCriaQuery;
  qryDorIcd := fCriaQuery;
  qryExtLar := fCriaQuery;

  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  FATGOR ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FGO_NUMFAT = :NUMDOC AND ';
    strSQL := strSQL + '  FGO_TIPFAT = :ESPDOC AND ';
    strSQL := strSQL + '  FGO_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  FGO_EMPFAT = :EMPFAT AND ';
    strSQL := strSQL + '  FGO_JAFATU = "1" ';

    With qryFatGor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('EMPFAT').AsString := VS_strCodEmp;
      Open;

      If (Not IsEmpty) Then
      Begin
        If Length(ArrayPedidos) > 0 Then
        Begin
          If blnSolicitouQueDesejaCancelarPedidoOriginal Then
          Begin
            If blnNaoTemPermissaoParaCancelarPedidoOriginal Then
            Begin
              For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
                fDesfaturaPedidoVendaOuOrcamento(ArrayPedidos[intIdx].strEspPed,
                                                 ArrayPedidos[intIdx].strNumPed,
                                                 ArrayPedidos[intIdx].strCodCli,
                                                 ArrayPedidos[intIdx].strEmpPed, True);

              Exit;
            End;

            If Length(ArrayOrcamento) > 0 Then
            Begin
              For intIdx := Low(ArrayOrcamento) To High(ArrayOrcamento) Do
              Begin
                If ArrayOrcamento[intIdx].taDeleta = Deleta Then
                Begin
                  pApagaOrcamentoQueGerouPD(ArrayOrcamento[intIdx].strNumOrc,
                                            ArrayOrcamento[intIdx].strEspOrc,
                                            ArrayOrcamento[intIdx].strEmpOrc,
                                            ArrayOrcamento[intIdx].strCliOrc);

                  If (fCfgSis('UTINPS', varBoolean)) Then
                    TNetpoints.pCancelarNetpoints(ArrayOrcamento[intIdx].strNumOrc,
                                                  ArrayOrcamento[intIdx].strEspOrc,
                                                  ArrayOrcamento[intIdx].strEmpOrc,
                                                  ArrayOrcamento[intIdx].strCliOrc,
                                                  '',
                                                  Self.Name,
                                                  fMotivoDelecao, '');
                End
                Else If ArrayOrcamento[intIdx].taDeleta = Desfatura Then
                Begin
                  fDesfaturaPedidoVendaOuOrcamento(ArrayOrcamento[intIdx].strEspOrc,
                                                   ArrayOrcamento[intIdx].strNumOrc,
                                                   ArrayOrcamento[intIdx].strCliOrc,
                                                   ArrayOrcamento[intIdx].strEmpOrc,
                                                   True,
                                                   ArrayOrcamento[intIdx].strNumFat,
                                                   ArrayOrcamento[intIdx].strTipFat,
                                                   ArrayOrcamento[intIdx].strEmpFat);
                End;
              End;

              SetLength(ArrayOrcamento, 0);
            End;

            For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
            Begin
              If (ArrayPedidos[intIdx].blnMesLoj) Then
              Begin
                If (ArrayPedidos[intIdx].taDeleta = Deleta) Then
                Begin
                  If qryFatGor.Locate('FGO_NUMDOC;FGO_ESPDOC;FGO_CODEMP',
                                      VarArrayOf([ArrayPedidos[intIdx].strNumPed,
                                                  ArrayPedidos[intIdx].strEspPed,
                                                  ArrayPedidos[intIdx].strEmpPed]), []) Then
                  Begin
                    If Not fCancelaPedidos(True) Then
                      Exit;
                  End;
                End;
              End;
            End;
          End
          Else
          Begin
            For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
            Begin
              If SameText(ArrayPedidos[intIdx].strEspPed, 'PR') Then
                fDesfaturaPedidoVendaOuOrcamento(ArrayPedidos[intIdx].strEspPed,
                                                 ArrayPedidos[intIdx].strNumPed,
                                                 ArrayPedidos[intIdx].strCodCli,
                                                 ArrayPedidos[intIdx].strEmpPed, True);

              if fUsaOndaSeparacaoAgrupamento() then
              begin
                strSeqPed := fCampoTabela('AUTOINCREM', 'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'],
                                         [ArrayPedidos[intIdx].strNumPed, ArrayPedidos[intIdx].strEspPed, ArrayPedidos[intIdx].strEmpPed]);

                fLimpaExpedicaoPedido(strSeqPed, True, eeloNaoExcluir, False);
                pDeletaSepDor(strSeqPed);
              end;
            End;
          End;
        End
        Else
        Begin
          {*****************************************}
          {* SINLIZA QUE NÃO PODE DESFATURAR O     *}
          {* >> PEDIDO TODO <<. PORÉM NADA IMPEDE  *}
          {* DE DESFATURAR ALGUNS ITENS DO PEDIDO. *}
          {**************************************MV*}
          blnPodeDesfaturar := False;
        End;

        {********************************************************}
        {* CANCELA O PEDIDO DE ABASTECIMENTO CD SE CASO EXISTIR *}
        {*****************************************************FC*}
        If blnSolicitouQueDesejaCancelarPedidoOriginal Then
        Begin
          If Length(ArrayPedAbas) > 0 Then
          Begin
            With qryFatGor Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add(' SELECT ');
              SQL.Add('   * ');
              SQL.Add(' FROM ');
              SQL.Add('   FATGOR ');
              SQL.Add(' WHERE ');
              SQL.Add('   FGO_NUMDOC = :NUMDOC AND ');
              SQL.Add('   FGO_ESPDOC = :ESPDOC AND ');
              SQL.Add('   FGO_CODEMP = :CODEMP     ');
            End;

            For intIdx := Low(ArrayPedAbas) To High(ArrayPedAbas) Do
            Begin
              If (ArrayPedAbas[intIdx].blnMesLoj) Then
              Begin
                With qryFatGor Do
                Begin
                  Close;
                  ParamByName('NUMDOC').AsString := ArrayPedAbas[intIdx].strNumPed;
                  ParamByName('ESPDOC').AsString := ArrayPedAbas[intIdx].strEspPed;
                  ParamByName('CODEMP').AsString := ArrayPedAbas[intIdx].strEmpPed;
                  Open;
                End;

                If Not fCancelaPedidos(False) Then
                  Exit;
              End;
            End;
          End;
        End;
      End
      Else
      Begin
        {*****************************************}
        {* SINLIZA QUE NÃO PODE DESFATURAR O     *}
        {* >> PEDIDO TODO <<. PORÉM NADA IMPEDE  *}
        {* DE DESFATURAR ALGUNS ITENS DO PEDIDO. *}
        {**************************************MV*}
        blnPodeDesfaturar := False;
      End;

      Close;
    End;

  Finally
    FreeAndNil(qryFatGor);
    FreeAndNil(qryExtGor);
    FreeAndNil(qryFatDor);
    FreeAndNil(qryExtDor);
    FreeAndNil(qryDorIcd);
    FreeAndNil(qryExtLar);
  End;
end;

procedure TfrmCancelamentoDocumentos.pVerificaDocumentoJaFoiAvaliado(const ANumDoc, AEspDoc, AEmpDoc : String);
begin

  If Not Assigned(objTecladoSEAT) Then
    objTecladoSEAT := TTecladoSEAT.Create;

  If (objTecladoSEAT.fDocumentoJaFoiAvaliado(ANumDoc, AEspDoc, AEmpDoc)) Then
  Begin
    objTecladoSEAT.fDeletarAvaliacao(Self.Name, ANumDoc, AEspDoc, AEmpDoc)
  End;

end;

function TfrmCancelamentoDocumentos.fVerificaPedAbastecimento(const strNumDoc,
  strEspDoc, strCodEmp: String): Boolean;
var
  strNmPdAb, strEsPdAb, strEmPdAb: String;
  LMensagem: TStringList;
  frmMensagemExplicativa: TfrmMensagemExplicativa;
begin
  Result := True;

  if fCfgSis('CPDABT', varBoolean) then
  begin
    If fExistePedidoAbastecimento(strNumDoc, strEspDoc, strCodEmp,
                                  strNmPdAb, strEsPdAb, strEmPdAb) Then
    Begin
      fMensagemCancelamento('', 'O pedido de abastecimento '+ strNmPdAb +'-'+ strEsPdAb +'-'+ strEmPdAb +' foi gerado através da emissão deste documento.'+ sLineBreak +
                  'Por favor, cancele o documento de abastecimento na empresa responsável ('+ strEmPdAb +') para depois refazer este cancelamento.');
      Result := False;
    End;
  end
  else
  begin
    LMensagem := TStringList.Create;

    try
      pValidaPDComAbastecimentoTransf(strNumDoc,
                                      strEspDoc,
                                      strCodEmp,
                                      LMensagem);

      if (LMensagem.Count > 0) then
      begin
        Result := False;

        pCriarFormularios(TfrmMensagemExplicativa, frmMensagemExplicativa);
        Try
          frmMensagemExplicativa.Caption := 'Não será possível realizar o cancelamento do pedido';
          frmMensagemExplicativa.Width   := 650;
          frmMensagemExplicativa.Height  := 300;
          frmMensagemExplicativa.mmoInstru.Lines.Add(LMensagem.Text);
          If FExecutandoCanceladorAutomatico Then
            pMensagemOK(frmMensagemExplicativa.Caption)
          Else If CancelandoNFViaFulFillment Then
            objFulFillmentLogBuilder.pSalvarLog(frmMensagemExplicativa.mmoInstru.Lines.Text, True)
          Else
            frmMensagemExplicativa.ShowModal;
        Finally
          pFreeAndNil(frmMensagemExplicativa);
        End;
      end;
    finally
      FreeAndNil(LMensagem);
    end;
  end;
end;

procedure TfrmCancelamentoDocumentos.pProcessaArrayPedidosFatDevolucao(Const strNumDoc, strEspDoc, strCodCli: String);
  Var
    qryGen: TUniQuery;
    strNumPed, strEmpPed: String;
    intOrd: Integer;
begin
  qryGen := fCriaQuery;
  Try
    qryGen.SQL.Add('SELECT DISTINCT DET_DOCDEV, DET_ESPDEV, DET_EMPDEV');
    qryGen.SQL.Add('FROM MOVDET');
    qryGen.SQL.Add('WHERE DET_NUMDOC = :NUMDOC');
    qryGen.SQL.Add('  AND DET_ESPDOC = :ESPDOC');
    qryGen.SQL.Add('  AND DET_CODEMP = :CODEMP');
    qryGen.SQL.Add('  AND DET_CODCLI = :CODCLI');

    qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
    qryGen.ParamByName('ESPDOC').AsString := strEspDoc;
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGen.ParamByName('CODCLI').AsString := strCodCli;
    qryGen.Open;

    qryGen.First;
    While Not qryGen.Eof Do
    Begin
      If Not fEmptyStr(qryGen.FieldByName('DET_DOCDEV').AsString) Then
      Begin
        pRetNumeroPedidoVenda(qryGen.FieldByName('DET_DOCDEV').AsString,
                              qryGen.FieldByName('DET_ESPDEV').AsString,
                              qryGen.FieldByName('DET_EMPDEV').AsString,
                              strCodCli, strNumPed, strEmpPed);

        If Not fEmptyStr(strNumPed) Then
        Begin
          SetLength(ArrayPedDevolucao, Length(ArrayPedDevolucao) +1);
          intOrd := Length(ArrayPedDevolucao) -1;

          ArrayPedDevolucao[intOrd].strNumPed := strNumPed;
          ArrayPedDevolucao[intOrd].strEspPed := 'PD';
          ArrayPedDevolucao[intOrd].strEmpPed := strEmpPed;
          ArrayPedDevolucao[intOrd].strCodCli := strCodCli;
        End;
      End;

      qryGen.Next;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

procedure TfrmCancelamentoDocumentos.pProcessaArrayPedidosOrcamentosOriginaramFaturamento(LstrEspSel, LstrNumDoc, LstrCliFor: String);
  Var
    qryGen : TUniQuery;
    strSQL : String;

begin
  SetLength(ArrayPedidos,  0);
  SetLength(ArrayPedAbas,  0);
  SetLength(ArrayOrcamento,0);
  SetLength(ArrayPedidosMultiFaturados, 0);
  strPedidosOutraLoja := '';
  strPedidosMesmaLoja := '';

  blnSolicitouQueDesejaCancelarPedidoOriginal := False;
  blnNaoTemPermissaoParaCancelarPedidoOriginal := False;

  If fEspeciesQuePodemSerProvenientesFataurmentoORPD(LstrEspSel) Then
  Begin
    qryGen := fCriaQuery;
    Try
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  FGO_NUMDOC, ';
      strSQL := strSQL + '  FGO_ESPDOC, ';
      strSQL := strSQL + '  FGO_CODEMP, ';
      strSQL := strSQL + '  FGO_CODCLI, ';
      strSQL := strSQL + '  FGO_MEN001  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  FATGOR ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  FGO_NUMFAT = :NUMDOC AND ';
      strSQL := strSQL + '  FGO_TIPFAT = :ESPDOC AND ';
      strSQL := strSQL + '  FGO_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '  FGO_EMPFAT = :EMPFAT AND ';
      strSQL := strSQL + '  FGO_JAFATU = "1" ';

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := LstrNumDoc;
        ParamByName('ESPDOC').AsString := LstrEspSel;
        ParamByName('CODCLI').AsString := LstrCliFor;
        ParamByName('EMPFAT').AsString := VS_strCodEmp;
        Open;
        First;

        If (Not IsEmpty) Then
        Begin
          While Not Eof Do
          Begin
            If (fPodeDesfaturarDocumento(qryGen.FieldByName('FGO_NUMDOC').AsString,
                                         qryGen.FieldByName('FGO_ESPDOC').AsString,
                                         qryGen.FieldByName('FGO_CODEMP').AsString)) Then
            Begin
              pCarrregaArrayPedidos(ArrayPedidos,
                                    qryGen.FieldByName('FGO_NUMDOC').AsString,
                                    qryGen.FieldByName('FGO_ESPDOC').AsString,
                                    qryGen.FieldByName('FGO_CODEMP').AsString,
                                    qryGen.FieldByName('FGO_CODCLI').AsString,
                                    qryGen.FieldByName('FGO_MEN001').AsString,
                                    True);
            End;

            Next;
          End;
        End;

        strSQL := '';
        strSQL := strSQL + ' SELECT ';
        strSQL := strSQL + '       FGO_NUMDOC, ';
        strSQL := strSQL + '       FGO_ESPDOC, ';
        strSQL := strSQL + '       FGO_CODEMP, ';
        strSQL := strSQL + '       FGO_CODCLI, ';
        strSQL := strSQL + '       FGO_MEN001 ';
        strSQL := strSQL + '   FROM MOVDET D ';
        strSQL := strSQL + '      INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ';
        strSQL := strSQL + '      INNER JOIN MOVAUX A ON D.AUTOINCREM = A.DET_SEQGER ';
        strSQL := strSQL + '      INNER JOIN FATDOR F ON F.AUTOINCREM = A.DET_INC_PD ';
        strSQL := strSQL + '      INNER JOIN FATGOR G ON F.FDO_SEQGER = G.AUTOINCREM ';
        strSQL := strSQL + ' WHERE ';
        strSQL := strSQL + '    DET_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '    DET_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '    DET_CODCLI = :CODCLI AND ';
        strSQL := strSQL + '    DET_CODEMP = :CODEMP AND ';
        strSQL := strSQL + '    DET_ESPDOC NOT IN ("ML", "PR", "TM", "NV", "IV") ';
        strSQL := strSQL + ' GROUP BY FGO_NUMDOC, FGO_ESPDOC, FGO_CODEMP ';

        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := LstrNumDoc;
        ParamByName('ESPDOC').AsString := LstrEspSel;
        ParamByName('CODCLI').AsString := LstrCliFor;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        Open;
        First;

        If (Not IsEmpty) Then
        Begin
          While Not Eof Do
          Begin
            pCarrregaArrayPedidos(ArrayPedidosMultiFaturados,
                                  qryGen.FieldByName('FGO_NUMDOC').AsString,
                                  qryGen.FieldByName('FGO_ESPDOC').AsString,
                                  qryGen.FieldByName('FGO_CODEMP').AsString,
                                  qryGen.FieldByName('FGO_CODCLI').AsString,
                                  qryGen.FieldByName('FGO_MEN001').AsString,
                                  False);

            Next;
          End;
        End;
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fPermiteCancelarDocFatAposAnalisePedOrcAsssociados(LstrEspSel, LstrNumDoc, LstrCliFor: String): Boolean;
  Var
    qryAux: TUniQuery;
    strAux: String;
    intIdx: Integer;
    intOrd: Integer;
    blnTemGarantia: Boolean;
    blnPedidoOrigemGPE: Boolean;
    strNumDocOR,
    strEspDocOR,
    strCodEmpOR,
    strCodCliOR: String;

  procedure pRetListaPedidosAssociadosRomaneio(arrAux: TArrPedVendaCanc; var strLis: String);
    Var
      intIdx: Integer;
  begin
    qryAux := fCriaQuery;
    Try
      qryAux.SQL.Text := ' SELECT CONCAT("Pedido: ",GER_NUMDOC,"-",GER_ESPDOC,"-",GER_CODEMP," Romaneio: ",CONCAT(GER_NUMROM,"-",GER_EMPROM)) AS DOCUMENTO '+
                         ' FROM ROMGERX '+
                         ' WHERE GER_NUMDOC = :NUMDOC AND '+
                         '       GER_ESPDOC = :ESPDOC AND '+
                         '       GER_CODCLI = :CODCLI AND '+
                         '       GER_CODEMP = :EMPDOC     ';

      If fCfgSis('USPRRO', varBoolean) Then
        qryAux.SQL.Add(' AND GER_STATUS = "A" ');

      For intIdx := Low(arrAux) To High(arrAux) Do
      Begin
        qryAux.Close;
        qryAux.ParamByName('NUMDOC').AsString := arrAux[intIdx].strNumPed;
        qryAux.ParamByName('ESPDOC').AsString := arrAux[intIdx].strEspPed;
        qryAux.ParamByName('CODCLI').AsString := arrAux[intIdx].strCodCli;
        qryAux.ParamByName('EMPDOC').AsString := arrAux[intIdx].strEmpPed;
        qryAux.Open;
        qryAux.First;

        While Not qryAux.Eof Do
        Begin
          pIncrementaListaStr(qryAux.FieldByName('DOCUMENTO').AsString, strLis);

          qryAux.Next;
        End;
      End;
    Finally
      FreeAndNil(qryAux);
    End;
  end;

  function fExistePedidoAbastecimentoCD: Boolean;
    Var
      strNmPdAb,
      strEsPdAb,
      strEmPdAb,
      strMsgAux: String;
      intIdx: Integer;
  Begin
    Result := False;

    If fCfgSis('SLTFRC', varBoolean) Then
      Exit;

    For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
    Begin

      qryAux := fCriaQuery;
      Try
        If fExistePedidoAbastecimento(ArrayPedidos[intIdx].strNumPed,
                                      ArrayPedidos[intIdx].strEspPed,
                                      ArrayPedidos[intIdx].strEmpPed,
                                      strNmPdAb, strEsPdAb, strEmPdAb) Then
        Begin
          If (Not fEmptyStr(strNmPdAb)) And
             (Not fEmptyStr(strEsPdAb)) And
             (Not fEmptyStr(strEmPdAb)) Then
          Begin
            qryAux.SQL.Clear;
            qryAux.SQL.Add(' SELECT ');
            qryAux.SQL.Add('   FGO_JAFATU, ');
            qryAux.SQL.Add('   FDO_JAFATU, ');
            qryAux.SQL.Add('   FDO_QTDBAI, ');
            qryAux.SQL.Add('   FGO_NUMFAT, ');
            qryAux.SQL.Add('   FGO_TIPFAT, ');
            qryAux.SQL.Add('   FGO_EMPFAT, ');
            qryAux.SQL.Add('   FDO_NUMFAT, ');
            qryAux.SQL.Add('   FDO_TIPFAT, ');
            qryAux.SQL.Add('   FDO_EMPFAT  ');
            qryAux.SQL.Add(' FROM ');
            qryAux.SQL.Add('   FATDOR D INNER JOIN FATGOR F ON (D.FDO_SEQGER = F.AUTOINCREM) ');
            qryAux.SQL.Add(' WHERE ');
            qryAux.SQL.Add('   FGO_NUMDOC = :NUMDOC AND ');
            qryAux.SQL.Add('   FGO_ESPDOC = :ESPDOC AND ');
            qryAux.SQL.Add('   FGO_CODEMP = :EMPDAB     ');

            qryAux.ParamByName('NUMDOC').AsString := strNmPdAb;
            qryAux.ParamByName('ESPDOC').AsString := strEsPdAb;
            qryAux.ParamByName('EMPDAB').AsString := strEmPdAb;
            qryAux.Open;
            qryAux.First;

            If Not qryAux.IsEmpty Then
            Begin
              strMsgAux := '';
              While Not qryAux.Eof Do
              Begin
                If (qryAux.FieldByName('FGO_JAFATU').AsInteger = 1) Then
                Begin
                  pIncrementaListaStr(qryAux.FieldByName('FGO_NUMFAT').AsString + '-' +
                                      qryAux.FieldByName('FGO_TIPFAT').AsString + '-' +
                                      qryAux.FieldByName('FGO_EMPFAT').AsString, strMsgAux);
                  Result := True;
                  Break;
                End
                Else If (qryAux.FieldByName('FDO_JAFATU').AsInteger = 1) Then
                Begin
                  Result := True
                End
                Else If (qryAux.FieldByName('FDO_QTDBAI').AsFloat > 0) Then
                Begin
                  Result := True;
                End;

                If Result Then
                Begin
                  pIncrementaListaStr(qryAux.FieldByName('FDO_NUMFAT').AsString + '-' +
                                      qryAux.FieldByName('FGO_TIPFAT').AsString + '-' +
                                      qryAux.FieldByName('FDO_EMPFAT').AsString, strMsgAux);
                End;

                qryAux.Next;
              End;
            End;
          End;
        End;

        If Result Then
        Begin
          objLiberacao.Clear;
          objLiberacao.strDirAce    := 'CANDPA';
          objLiberacao.strCodOpe    := strLoginUsuarioLogado;
          objLiberacao.objMsgLibera.pAddTexto('Liberar o cancelamento documento com pedido de abastecimento que foi gerado através da emissão/faturamento.');
          objLiberacao.pInformaNumDocEspDocCodEmp(LstrNumDoc, LstrEspSel, VS_strCodEmp);

          Result := Not objLiberacao.fLibera;
        End;

        If Result Then
        Begin
          If Not fEmptyStr(strMsgAux) Then
          Begin
            fMensagem('ATENÇÃO', 'Existe um pedido de abastecimento ' + strNmPdAb + '-' + strEsPdAb + '-' + strEmPdAb +
                                 ' que foi gerado através da emissão/faturamento deste documento. Por favor cancele o(s) documento(s) ' +
                                 strMsgAux + ' para depois efetuar o cancelamento do mesmo.', ['&OK']);
            Break;
          End;
        End
        Else
        Begin
          If fEmptyStr(strMsgAux) Then
          Begin
            If (Not fEmptyStr(strNmPdAb)) And
               (Not fEmptyStr(strEsPdAb)) And
               (Not fEmptyStr(strEmPdAb)) Then
            Begin
              SetLength(ArrayPedAbas, Length(ArrayPedAbas) + 1);
              ArrayPedAbas[Length(ArrayPedAbas)-1].strNumPed := strNmPdAb;
              ArrayPedAbas[Length(ArrayPedAbas)-1].strEspPed := strEsPdAb;
              ArrayPedAbas[Length(ArrayPedAbas)-1].strEmpPed := strEmPdAb;
              ArrayPedAbas[Length(ArrayPedAbas)-1].blnMesLoj := SameText(ArrayPedAbas[intOrd].strEmpPed, VS_strCodEmp);
            End;
          End;
        End;
      Finally
        FreeAndNil(qryAux);
      End;
    End;
  End;

  function fPermiteCancelarDocumentoOriginal: Boolean;
  begin
    Result := True;

    If blnPedidoOrigemGPE Then
      Exit(False);

    If blnTemGarantia Then
      Exit(False);

    If blnCancelarSATouCFTefAutomatico Then
      Exit(False);

    If (Not fSuportaInterfaceGrafica) Then
      Exit(False);

    If FblnAbastecimentoPeloDeposito Then
      Exit(False);

    If FblnCancelandoRetornoConsignadoAutomatico Then
      Exit(False);

    If FCancelamentoDeFFPelaNotaEspecial Then
      Exit(False);

    //Req: 116167 - Não cancelar o pedido automaticamente quando foi criado pelo CRM
    If Not fEmptyStr(fRetornaCodigoOcorrencia(LstrNumDoc, LstrEspSel, LstrCliFor, VS_strCodEmp, '')) Then
      Exit(False);

    If (ArrayPedidos[0].strEspPed = 'PD') And fUsaRotinaWMS And fUsaOndaSeparacaoAgrupamento Then
      Exit(False);
  end;

begin
  Result := True;
  blnPedidoOrigemGPE := False;

  strAux := '';
  If (Length(ArrayPedidosMultiFaturados) > 0) Then
    pRetListaPedidosAssociadosRomaneio(ArrayPedidosMultiFaturados, strAux);

  If (Length(ArrayPedidos) > 0) Then
    pRetListaPedidosAssociadosRomaneio(ArrayPedidos, strAux);

  If (Not fEmptyStr(strAux)) Then
  Begin
    If fCfgSis('USPRRO', varBoolean) Then
      pMensagemOk('O documento ' + LstrNumDoc + '-' + LstrEspSel + ' foi originado a partir dos seguintes pedidos com romaneios ativados: '+strAux+'! '+
                  'Inative os respectivos romaneios em "Romaneio Ativação" antes de cancelar este documento.')
    Else
      pMensagemOk('O documento ' + LstrNumDoc + '-' + LstrEspSel + ' foi originado a partir dos seguintes pedidos com romaneios: '+strAux+'! '+
                  'Desvincule os pedidos dos romaneios antes de cancelar este documento.');
    Result := False;
  End;

  If Result And (Length(ArrayPedidos) > 0) Then
  Begin
    If fExistePedidoAbastecimentoCD Then
    Begin
      {********************************************************************}
      {* SE CASO EXISTIR ALGUM PEDIDO QUE GEROU UM OUTRO PEDIDO DE        *}
      {* ABASTECIMENTO PARA O CD (CFG_ENTABA), E SE ESTE PEDIDO DE        *}
      {* ABASTECIMENTO ESTIVER JÁ FATURADO O SISTEMA NÃO PERMITIRÁ,       *}
      {* CANCELAR O DOCUMENTO POIS PRECISA PRIMEIRO CANCELAR A            *}
      {* TRANSFERENCIA QUE ESSE PD GEROU PARA DEPOIS CANCELAR O DOCUMENTO *}
      {*****************************************************************FC*}
      Result := False;
    End;

    If Result Then
    Begin
      blnTemGarantia := False;

      For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
      Begin
        if Not blnPedidoOrigemGPE then
        begin
          blnPedidoOrigemGPE := TGarantiaPropriaEmpresaCancelamento.fEhPedidoReposicaoGarantia(ArrayPedidos[intIdx].strNumPed,
                ArrayPedidos[intIdx].strEspPed, ArrayPedidos[intIdx].strEmpPed);
        end;

        If ArrayPedidos[intIdx].blnGarant Then
          blnTemGarantia := True;
      End;

      If (fPermiteCancelarDocumentoOriginal) And
         ((blnPDV) Or (fMensagem('Atenção', 'O documento ' + LstrNumDoc + '-' + LstrEspSel + ' foi originado a partir do documento: ' + strPedidosMesmaLoja + IIF(Not fEmptyStr(strPedidosOutraLoja), ', ' + strPedidosOutraLoja, '') + '.' + #13#10 +
                                            'Deseja cancelar o documento original? ' +
                                             IIF(Not fEmptyStr(strPedidosOutraLoja), 'Atenção os documentos originados por outra empresa não serão cancelados.', ''), ['&Sim', '&Não']) = 1)) Then
      Begin
        blnSolicitouQueDesejaCancelarPedidoOriginal := True;
        If (Not fVerificaAcessoSistema('CANC' + ArrayPedidos[0].strEspPed)) And (Not blnPDV) Then
        Begin
          fMensagem('ATENÇÃO', 'Usuário sem permissão para cancelar documentos da espécie ' + ArrayPedidos[0].strEspPed + '.', ['&Ok']);

          blnNaoTemPermissaoParaCancelarPedidoOriginal := True;
        End
        Else
        Begin
          For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
          Begin
            If Assigned(lstCtrBaixadas) Then
              FreeAndNil(lstCtrBaixadas);

            lstCtrBaixadas := fVerificarCadRecBaixado(ArrayPedidos[intIdx].strNumPed,
                                                      ArrayPedidos[intIdx].strEspPed,
                                                      ArrayPedidos[intIdx].strCodCli,
                                                      ArrayPedidos[intIdx].strEmpPed);

            If (lstCtrBaixadas.Count > 0) Then
            Begin
              ArrayPedidos[intIdx].taDeleta := Desfatura;
              pGeraResumo;
            End;

            If (ArrayPedidos[intIdx].strEspPed = 'PD') And
               (TAdiantamento.fGetTotaisAdiantamento(ArrayPedidos[intIdx].strNumPed,
                                                     ArrayPedidos[intIdx].strEspPed,
                                                     ArrayPedidos[intIdx].strEmpPed).fltValLan > 0.00) Then
            Begin
              If (TFacadeCobrancaEletronica.fExisteCobrancaEletronica(
                                              ArrayPedidos[intIdx].strNumPed,
                                              ArrayPedidos[intIdx].strEspPed,
                                              ArrayPedidos[intIdx].strEmpPed,
                                              tcPagarMe)) And
                 (TFacadeCobrancaEletronica.fExisteAdiantamentoClienteCobrancaEletronica(
                                              ArrayPedidos[intIdx].strNumPed,
                                              ArrayPedidos[intIdx].strEspPed,
                                              ArrayPedidos[intIdx].strEmpPed,
                                              tcPagarMe)) Then
              Begin
                If Not fLiberaCancelamentoDocumentoComCobrancaEletronica(
                                       ArrayPedidos[intIdx].strNumPed,
                                       ArrayPedidos[intIdx].strEspPed,
                                       ArrayPedidos[intIdx].strEmpPed) Then
                  Exit(False);
              End
              Else
              Begin
                ArrayPedidos[intIdx].taDeleta := Desfatura;
                pMensagemOk('Este '+ArrayPedidos[intIdx].strNumPed+'-'+ArrayPedidos[intIdx].strEspPed+'-'+ArrayPedidos[intIdx].strEmpPed+' possui crédito disponível referente adiantamento de cliente, ' +
                            'portanto será necessário estornar este recebimento antes de cancelar o pedido!');
              End;
            End;

            If fVerificaDocumentoRomaneio(ArrayPedidos[intIdx].strEspPed,
                                          ArrayPedidos[intIdx].strNumPed,
                                          ArrayPedidos[intIdx].strCodCli) Then
            Begin
              ArrayPedidos[intIdx].taDeleta := Desfatura;
            End;

            If fVerificaDocumentoRequisicaoCompra(ArrayPedidos[intIdx].strEspPed,
                                                  ArrayPedidos[intIdx].strNumPed,
                                                  ArrayPedidos[intIdx].strEmpPed) Then
            Begin
              ArrayPedidos[intIdx].taDeleta := Desfatura;
            End;

            If fVerificaDocumentoEntrega(ArrayPedidos[intIdx].strEspPed,
                                         ArrayPedidos[intIdx].strNumPed,
                                         ArrayPedidos[intIdx].strEmpPed) Then
            Begin
              ArrayPedidos[intIdx].taDeleta := Desfatura;
            End;

            If (ArrayPedidos[intIdx].taDeleta = Deleta) Then
            Begin
              If fVerificaSePDProvOR(ArrayPedidos[intIdx].strNumPed,
                                     ArrayPedidos[intIdx].strEspPed,
                                     ArrayPedidos[intIdx].strEmpPed,
                                     strNumDocOR,
                                     strEspDocOR,
                                     strCodEmpOR,
                                     strCodCliOR) Then
              Begin
                SetLength(ArrayOrcamento, Length(ArrayOrcamento) + 1);
                intOrd := (Length(ArrayOrcamento) - 1);

                ArrayOrcamento[intOrd].strNumOrc := strNumDocOR;
                ArrayOrcamento[intOrd].strEspOrc := strEspDocOR;
                ArrayOrcamento[intOrd].strEmpOrc := strCodEmpOR;
                ArrayOrcamento[intOrd].strCliOrc := strCodCliOR;
                ArrayOrcamento[intOrd].strNumFat := ArrayPedidos[IntIdx].strNumPed;
                ArrayOrcamento[intOrd].strTipFat := ArrayPedidos[IntIdx].strEspPed;
                ArrayOrcamento[intOrd].strEmpFat := ArrayPedidos[IntIdx].strEmpPed;

                If SameText(strCodEmpOR, VS_strCodEmp) And (strEspDocOR <> 'PD') And
                   (Not blnCancelarSATouCFTefAutomatico) And (fSuportaInterfaceGrafica) And
                   (Not FblnAbastecimentoPeloDeposito) And
                   (Not FblnCancelandoRetornoConsignadoAutomatico) And
                   (fMensagem('Atenção', 'O documento ' + ArrayPedidos[IntIdx].strNumPed + '-' + ArrayPedidos[IntIdx].strEspPed + ' foi originado a partir do documento: ' + strNumDocOR + '-' + strEspDocOR + '.' + #13#10 +
                                         'Deseja cancelar o documento original? ', ['&Sim', '&Não']) = 1) Then
                Begin
                  If Not fVerificaAcessoSistema('CANCOR') Then
                  Begin
                    If intIdx = Low(ArrayPedidos) Then
                      fMensagem( 'ATENÇÃO', 'Usuário sem permissão para cancelar documentos da espécie OR.', ['&Ok']);

                    ArrayOrcamento[intOrd].taDeleta := Desfatura;
                  End
                  Else
                    ArrayOrcamento[intOrd].taDeleta := Deleta;
                End
                Else
                  ArrayOrcamento[intOrd].taDeleta := Desfatura;
              End;
            End;
          End;
        End;
      End;
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fRetornaEspecieCancelamento(strEspSel: String): string;
begin
  Result := IIF(Pos(strEspSel,'NE_ND_') > 0,IIF(Not blnPedidoEntrada,'NF','PD'),IIF(strEspSel = 'NI','NF',strEspSel));

  If Pos(strEspSel , 'OF_NW_NP_EF_') > 0 Then
    Result := 'NF';

  If strEspSel = 'IC' Then
    Result := 'IF';
end;

{**********************************}
{* VERIFICA SE DOCUMENTO ESTA COM *}
{* DATA MENOR QUE O SALDO         *}
{*******************************AF*}
function TfrmCancelamentoDocumentos.fVerificaSalBal(strEspSel, strNumDoc, strCodCli: String): Boolean;
var
  strSQL    : String;
  qryGenDet : TUniQuery;
begin
  Result := True;
  Try
    qryGenDet := fCriaQuery(Self);

    If (Pos(strEspSel, 'NE_OF_TE_BR_AJ_RQ_TR_DV_NF_EL_NS_IF_IV_D1_MI_FF_PI_UC_TA_TL_CS_CR_GF_GR_GC_GA_NG_NR_EF_RL_') <= 0) Then
    Begin
      Exit;
    End;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVDET ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
    strSQL := strSQL + fRetSQLCodCli(strEspSel);

    With qryGenDet Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := fRetornaEspecieCancelamento(strEspSel);
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      First;
      While Not Eof Do
      Begin

        If (not FieldByName('DET_DTAENT').IsNull) And
           (FieldByName('DET_DTAENT').AsDateTime < fRetDataSalBal(FieldByName('DET_CODITE').AsString,
                                                                 FieldByName('DET_CODEMP').AsString)) Then
        Begin
          fMensagem('','Cancelamento não permitido pois documento possui itens em que a data de venda é menor que o balanço!',['&OK']);
          Result := False;
          Break;
        End;

        Next;
      End;

      Close;
    End;
  Finally
    FreeAndNil(qryGenDet);
  End;
end;

function TfrmCancelamentoDocumentos.fVerificaSeTemPedidoVinculadoComOrcamentoTransf(strEmpSel: String; strDocSel: String): Boolean;
  Var
    strSQL: String;
    qryTmp: TUniQuery;
begin
  Result := True;

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   FGO_NUMDOC, ';
  strSQL := strSQL + '   FGO_ESPDOC, ';
  strSQL := strSQL + '   FGO_CODEMP, ';
  strSQL := strSQL + '   FGO_JAFATU  ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   EXTGOR ';
  strSQL := strSQL + ' JOIN FATGOR ON (FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO)';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '   FGO_NPDROR = :NUMDOC AND ';
  strSQL := strSQL + '   FGO_EPDROR = :CODEMP ';

  Try
    qryTmp := fCriaQuery;

    With qryTmp Do
    Begin
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('NUMDOC').AsString := strDocSel;
      ParamByName('CODEMP').AsString := strEmpSel;

      Open;

      If Not IsEmpty Then
      Begin
        If FieldByName('FGO_JAFATU').AsInteger = 0 Then
        Begin
          fMensagemCancelamento('ATENÇÃO', 'Este Pedido está vinculado com um Orçamento de Transferência, ' +
                               'porém o Orçamento ainda não foi faturado. Não será possível seguir ' +
                               'esta operação. Fature a OR ' +
                               FieldByName('FGO_NUMDOC').AsString + '-' +
                               FieldByName('FGO_CODEMP').AsString + ' para depois cancelar este documento.', ['&Ok']);
          Result := False;
        End;
      End;
    End;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[fVerificaSeTemPedidoVinculadoComOrcamentoTransf]');
    End;

  End;

  pFreeAndNil(qryTmp);
end;

function TfrmCancelamentoDocumentos.fVerificaSePDProvOR(strNumDocPD, strEspDocPD,
  strCodEmpPD: String; Var strNumDocOR, strEspDocOR, strCodEmpOR, strCodCliOR: String): Boolean;
  Var
    strSQL: String;
    qryGen: TUniQuery;
begin
  Try
    Result := False;
    strNumDocOR := '';
    strEspDocOR := '';
    strCodEmpOR := '';
    strCodCliOR := '';

    qryGen := fCriaQuery(Self);

    Try
      strSQL := '';
      strSQL := strSQL + ' SELECT ';
      strSQL := strSQL + '   FGO_NUMDOC, ';
      strSQL := strSQL + '   FGO_ESPDOC, ';
      strSQL := strSQL + '   FGO_CODEMP, ';
      strSQL := strSQL + '   FGO_CODCLI  ';
      strSQL := strSQL + ' FROM ';
      strSQL := strSQL + '   FATGOR ';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '  FGO_NUMFAT = :NUMDOC AND ';
      strSQL := strSQL + '  FGO_TIPFAT = :ESPDOC AND ';
      strSQL := strSQL + '  FGO_EMPFAT = :CODEMP AND ';
      strSQL := strSQL + '  FGO_JAFATU = "1" ';

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);

        ParamByName('NUMDOC').AsString := strNumDocPD;
        ParamByName('ESPDOC').AsString := strEspDocPD;
        ParamByName('CODEMP').AsString := strCodEmpPD;
        Open;

        If Not IsEmpty Then
        Begin
          strNumDocOR := FieldByName('FGO_NUMDOC').AsString;
          strEspDocOR := FieldByName('FGO_ESPDOC').AsString;
          strCodEmpOR := FieldByName('FGO_CODEMP').AsString;
          strCodCliOR := FieldByName('FGO_CODCLI').AsString;
          Result := True;
        End;
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fVerificaSePDProvOR]');
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

procedure TfrmCancelamentoDocumentos.pApagaOrcamentoQueGerouPD(strNumDoc,
  strEspDoc, strCodEmp, strCodCli: String);
  Var
    strSQL,
    strAutInc: String;
    qryFatGor,
    qryFatDor,
    qryExtGor,
    qryExtDor,
    qryDorIcd: TUniQuery;
begin
  Try
    qryFatGor := fCriaQuery;
    qryFatDor := fCriaQuery;
    qryExtGor := fCriaQuery;
    qryExtDor := fCriaQuery;
    qryDorIcd := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  FATGOR ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FGO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  FGO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  FGO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  FGO_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  FGO_JAFATU = "1" ';

    With qryFatGor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      If Not IsEmpty Then
      Begin
        strAutInc := FieldByName('AUTOINCREM').AsString;

        {*****************************************************************}
        {* SALVA NA TABELA DE REGISTROS DELETADOS (FATDOR/EXTDOR/EXTGOR) *}
        {**************************************************************FC*}
        strSQL := '';
        strSQL := strSQL + ' SELECT ';
        strSQL := strSQL + '   * ';
        strSQL := strSQL + ' FROM ';
        strSQL := strSQL + '   FATDOR ';
        strSQL := strSQL + ' WHERE ';
        strSQL := strSQL + '   FDO_SEQGER = :AUTINC ';

        qryFatDor.Close;
        qryFatDor.SQL.Clear;
        qryFatDor.SQL.Add(strSQL);
        qryFatDor.ParamByName('AUTINC').AsString := strAutInc;
        qryFatDor.Open;

        If Not qryFatDor.IsEmpty Then
        Begin
          qryFatDor.First;

          While Not qryFatDor.Eof Do
          Begin
            strSQL := '';
            strSQL := strSQL + 'SELECT   ';
            strSQL := strSQL + '  *      ';
            strSQL := strSQL + 'FROM     ';
            strSQL := strSQL + '  EXTDOR ';
            strSQL := strSQL + 'WHERE    ';
            strSQL := strSQL + '  FDO_SEQFDO = :SEQFDO ';

            qryExtDor.Close;
            qryExtDor.SQL.Clear;
            qryExtDor.SQL.Add(strSQL);
            qryExtDor.ParamByName('SEQFDO').AsString := qryFatDor.FieldByName('AUTOINCREM').AsString;
            qryExtDor.Open;
            fVerificaIntegridade(Self.Name, 'EXTDOR', qryExtDor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

            strSQL := '';
            strSQL := strSQL + 'SELECT   ';
            strSQL := strSQL + '  *      ';
            strSQL := strSQL + 'FROM     ';
            strSQL := strSQL + '  DORICD ';
            strSQL := strSQL + 'WHERE    ';
            strSQL := strSQL + '  ICD_SEQFDO = :SEQFDO ';

            qryDorIcd.Close;
            qryDorIcd.SQL.Clear;
            qryDorIcd.SQL.Add(strSQL);
            qryDorIcd.ParamByName('SEQFDO').AsString := qryFatDor.FieldByName('AUTOINCREM').AsString;
            qryDorIcd.Open;
            fVerificaIntegridade(Self.Name, 'DORICD', qryDorIcd, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

            fVerificaIntegridade(Self.Name, 'FATDOR', qryFatDor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
            pGravaDeletadosMadeira(qryFatDor.FieldByName('AUTOINCREM').AsString, 'FATDOR');

            ReprocessarItem(qryFatDor.FieldByName('FDO_CODITE').AsString, '', True, True);

            qryFatDor.Next;
          End;
        End;

        strSQL := '';
        strSQL := strSQL + 'SELECT   ';
        strSQL := strSQL + '  *      ';
        strSQL := strSQL + 'FROM     ';
        strSQL := strSQL + '  EXTGOR ';
        strSQL := strSQL + 'WHERE    ';
        strSQL := strSQL + '  FGO_SEQFGO = :SEQFGO ';

        qryExtGor.Close;
        qryExtGor.SQL.Clear;
        qryExtGor.SQL.Add(strSQL);
        qryExtGor.ParamByName('SEQFGO').AsString := strAutInc;
        qryExtGor.Open;

        If (qryFatGor.FieldByName('FGO_ESPDOC').AsString = 'OR') And
           (qryExtGor.FieldByName('FGO_USADEP').AsString = 'S') Then
          TValidacoesSistemaDEPS.pGravaLogDeStatusDoSistemaDEPS(qryFatGor.FieldByName('AUTOINCREM').AsString,
                                                                'CANCELAMENTO');

        fVerificaIntegridade(Self.Name, 'EXTGOR', qryExtGor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        {***************************************************}
        {* SALVA NA TABELA DE REGISTROS DELETADOS (FATGOR) *}
        {************************************************FC*}
        fVerificaIntegridade(Self.Name, 'FATGOR', qryFatGor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
        pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_FATGOR', qryFatGor.FieldByName('AUTOINCREM').AsString);

        {********************************************}
        {* APAGA O REGISTRO NA TABELA FATGOR/FATDOR *}
        {*****************************************FC*}
        strSQL := '';
        strSQL := strSQL + 'DELETE FROM ';
        strSQL := strSQL + '  FATGOR ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  FGO_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  FGO_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  FGO_CODEMP = :CODEMP AND ';
        strSQL := strSQL + '  FGO_CODCLI = :CODCLI ';

        pDeletaMovCarPedidoEcommerce(strNumDoc,
                                     strEspDoc,
                                     strCodEmp);

        If fCfgSis('CUPDES') = 'S' Then
          TFatCupomDesconto.DesmarcarCupomUtilizado(strNumDoc,
                                                    strEspDoc,
                                                    strCodEmp);

        {Envia Mensagens}
        If (strEspDoc = 'PD') Then
          pMensagemCancelamentoPedido(strNumDoc,
                                      strEspDoc,
                                      strCodEmp);

        {*REQ.173491**********RP*}
        TLogGor.pLogDel(strNumDoc, strEspDoc, strCodEmp);

        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODCLI').AsString := strCodCli;
        ExecSQL;

        strSQL := '';
        strSQL := strSQL + 'DELETE FROM ';
        strSQL := strSQL + '  FATDOR ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  FDO_SEQGER = :AUTINC ';

        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('AUTINC').AsString := strAutInc;
        ExecSQL;

      End;
    End;
  Finally
    FreeAndNil(qryFatGor);
    FreeAndNil(qryFatDor);
    FreeAndNil(qryExtGor);
    FreeAndNil(qryExtDor);
    FreeAndNil(qryDorIcd);
  End;
end;

procedure TfrmCancelamentoDocumentos.pAtribuiPicture(Picture: TPicture);
begin
  imgCadItens.Picture    := Picture;
  imgItensNota.Picture   := Picture;
  imgDadosNota.Picture   := Picture;
  imgCtaReceber.Picture  := Picture;
  imgCtaPagar.Picture    := Picture;
  imgLivroFiscal.Picture := Picture;
