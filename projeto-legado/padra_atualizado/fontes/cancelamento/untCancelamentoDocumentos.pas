end;

procedure TfrmCancelamentoDocumentos.pCarregaPedidosRequisao(AstrNumDocSel, AstrCliForSel, AstrSerieSel, AstrEspSel: String);
var qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.Sql.Add(' SELECT RCD_DOCPDV, RCD_EMPPDV, RCD_ESPPDV , FGO_CODCLI');
    qryConsulta.Sql.Add('   FROM MOVDET');
    qryConsulta.Sql.Add('  INNER JOIN BAIPED ON BAI_AUTDET = MOVDET.AUTOINCREM');
    qryConsulta.Sql.Add('  INNER JOIN MOVRCD ON RCD_SEQPCD = BAI_AUTPED');
    qryConsulta.Sql.Add('  INNER JOIN FATGOR ON FGO_NUMDOC = RCD_DOCPDV');
    qryConsulta.Sql.Add('                  AND FGO_CODEMP = RCD_EMPPDV');
    qryConsulta.Sql.Add('                  AND FGO_ESPDOC = RCD_ESPPDV');
    qryConsulta.Sql.Add(' WHERE DET_NUMDOC = :DOCENT ');
    qryConsulta.Sql.Add('   AND DET_ESPDOC = :ESPENT ');
    qryConsulta.Sql.Add('   AND DET_CODEMP = :EMPENT ');
    qryConsulta.Sql.Add('   AND IFNULL(DET_SERIE_, "")  = :NUMSER ');
    qryConsulta.SQL.Add('   AND DET_CODFOR = :CODFOR ');
    qryConsulta.SQL.Add(' GROUP BY RCD_DOCPDV, RCD_EMPPDV, RCD_ESPPDV');
    qryConsulta.ParamByName('CODFOR').AsString := AstrCliForSel;
    qryConsulta.ParamByName('EMPENT').AsString := VS_strCodEmp;
    qryConsulta.ParamByName('DOCENT').AsString := AstrNumDocSel;
    qryConsulta.ParamByName('ESPENT').AsString := AstrEspSel;
    qryConsulta.ParamByName('NUMSER').AsString := AstrSerieSel;
    qryConsulta.Open;
    If qryConsulta.IsEmpty Then
      Exit;
    while not qryConsulta.Eof Do
    begin
      SetLength(ArrayPedidos, succ(Length(ArrayPedidos)));
      ArrayPedidos[High(ArrayPedidos)].strNumPed := qryConsulta.FieldByName('RCD_DOCPDV').AsString;
      ArrayPedidos[High(ArrayPedidos)].strEspPed := qryConsulta.FieldByName('RCD_ESPPDV').AsString;
      ArrayPedidos[High(ArrayPedidos)].strEmpPed := qryConsulta.FieldByName('RCD_EMPPDV').AsString;
      ArrayPedidos[High(ArrayPedidos)].strCodCli := qryConsulta.FieldByName('FGO_CODCLI').AsString;
      qryConsulta.Next;
    End;

  Finally
    FreeAndNil(qryConsulta);

  End;

end;

