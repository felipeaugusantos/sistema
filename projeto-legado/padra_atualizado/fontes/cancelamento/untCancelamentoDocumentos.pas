function TfrmCancelamentoDocumentos.fVerificarCadPagCFrBaixado(strNumDoc, strEspDoc, strCliFor, strSerie: String): TStringList;
  Var
    qryCadFis,
    qryAux: TUniQuery;
    strSeqFis, strCadFis,  strNotas: String;
begin
  Result := TStringList.Create;

  fTemConhecimentoVariasNotas(strEspDoc, strNumDoc, strCliFor, strSerie, strSeqFis, strCadFis, strNotas);
  strFreNumDup := '';
  strFreParcel := '';
  strFreCodFor := '';
  strFreCodEmp := '';
  strFreSerie  := '';

  if fEmptyStr(strSeqFis) then
    Exit;

  qryCadFis := fCriaQuery(Self);
  qryAux    := fCriaQuery(Self);

  With qryCadFis, SQL Do
  Begin
    Add('SELECT');
    Add('  FIS_NUMDOC, ');
    Add('  FIS_ESPDOC, ');
    Add('  FIS_FORCLI, ');
    Add('  FIS_SERIE_  ');
    Add('FROM          ');
    Add('  CADFIS      ');
    Add('WHERE         ');
    Add('  AUTOINCREM IN (' + strSeqFis + ')');

    Open;

    While Not Eof Do
    Begin

      qryAux.Close;
      qryAux.SQL.Clear;

      qryAux.SQL.Add('SELECT        ');
      qryAux.SQL.Add('  CTP_NUMDUP, ');
      qryAux.SQL.Add('  CTP_PARCEL, ');
      qryAux.SQL.Add('  CTP_CODEMP, ');
      qryAux.SQL.Add('  CTP_CODFOR, ');
      qryAux.SQL.Add('  CTP_SERIE_  ');
      qryAux.SQL.Add('FROM          ');
      qryAux.SQL.Add('  CADPAG ');
      qryAux.SQL.Add('WHERE ');

      qryAux.SQL.Add('  CTP_DTAPAG IS NOT NULL AND ');
      qryAux.SQL.Add('  CTP_NUMDUP = :NUMDUP AND ');
      qryAux.SQL.Add('  :CODEMP = CTP_CODEMP AND ');
      qryAux.SQL.Add('  :CODFOR = CTP_CODFOR AND ');
      qryAux.SQL.Add('  :SERIE_ = IFNULL(CTP_SERIE_, "") ');

      qryAux.SQL.Add(' UNION ALL    ');

      // ANTECIPACAO DO CONHECIMENTO DE FRETE
      qryAux.SQL.Add('SELECT        ');
      qryAux.SQL.Add('  CTP_NUMDUP, ');
      qryAux.SQL.Add('  CTP_PARCEL, ');
      qryAux.SQL.Add('  CTP_CODEMP, ');
      qryAux.SQL.Add('  CTP_CODFOR, ');
      qryAux.SQL.Add('  CTP_SERIE_  ');
      qryAux.SQL.Add('FROM          ');
      qryAux.SQL.Add('  CADPAG ');
      qryAux.SQL.Add('WHERE ');

      qryAux.SQL.Add('  CTP_DTAPAG IS NOT NULL AND ');

      qryAux.SQL.Add('  CTP_NOTENT = :NOTENT ');
      qryAux.SQL.Add('  ORDER BY CTP_PARCEL ');

      qryAux.ParamByName('NOTENT').AsString := FieldByName('FIS_NUMDOC').AsString +
                                               FieldByName('FIS_ESPDOC').AsString +
                                               VS_strCodEmp +
                                               fstrEspaco(FieldByName('FIS_SERIE_').AsString, 3) +
                                               FieldByName('FIS_FORCLI').AsString;

      qryAux.ParamByName('NUMDUP').AsString := FieldByName('FIS_NUMDOC').AsString;
      qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryAux.ParamByName('CODFOR').AsString := FieldByName('FIS_FORCLI').AsString;
      qryAux.ParamByName('SERIE_').AsString := FieldByName('FIS_SERIE_').AsString;

      qryAux.Open;
      If not qryAux.IsEmpty Then
      Begin
        strFreNumDup := qryAux.FieldByName('CTP_NUMDUP').AsString;
        strFreParcel := qryAux.FieldByName('CTP_PARCEL').AsString;
        strFreCodFor := qryAux.FieldByName('CTP_CODFOR').AsString;
        strFreCodEmp := qryAux.FieldByName('CTP_CODEMP').AsString;
        strFreSerie  := qryAux.FieldByName('CTP_SERIE_').AsString;
      end;


      While (Not qryAux.Eof) Do
      Begin
        Result.Add('Duplicata de Conhecimento de Frete');
        Result.Add(qryAux.FieldByName('CTP_NUMDUP').AsString +
                   qryAux.FieldByName('CTP_PARCEL').AsString + ' Loja: ' +
                   qryAux.FieldByName('CTP_CODEMP').AsString);
        qryAux.Next;
      End;

      Next;
    End; {While Not Eof Do}

  End;

  qryAux.Close;
  FreeAndNil(qryAux);

end;

