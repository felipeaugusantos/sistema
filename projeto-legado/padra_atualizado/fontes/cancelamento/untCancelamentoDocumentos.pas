procedure TfrmCancelamentoDocumentos.pEstornoReceber(blnAutomatico: Boolean = False; blnAlpe: Boolean = False; strParcela: String = '');
  Var
    strEspSel, strEspCan: String;
    blnNotaEletronica: Boolean;
    blnEstornouTudo : Boolean;
    frmEstornoReceber : TfrmEstornoReceber;
  procedure pSetarDadosEstorno;
  begin
    pGetEspecieCancelamento(strEspSel, strEspCan, blnNotaEletronica);

    If (strEspSel = 'GA') Then
    Begin
      frmEstornoReceber.edtNumDup.Text := fRetornaNumCCR(edtNumDoc.Text,edtCliFor.Text);
      frmEstornoReceber.edtEspDoc.Text := 'CC';
    End
    Else
    Begin
      frmEstornoReceber.edtNumDup.Text := edtNumDoc.Text;
      frmEstornoReceber.edtEspDoc.Text := strEspCan;
    End;

    if (strEspSel = 'CT') then
      frmEstornoReceber.edtCodCli.Text := strClienteCTe
    else
      frmEstornoReceber.edtCodCli.Text := edtCliFor.Text;

    If Not fEmptyStr(strParcela) Then
    Begin
      frmEstornoReceber.edtParcel.Text := strParcela;
    End;

  end;

begin
  inherited;
  Try
    Try
      pCriarFormularios(TfrmEstornoReceber, frmEstornoReceber);
      frmEstornoReceber.blnResCai            := False;
      frmEstornoReceber.blnEstornoAutomatico := blnAutomatico;
      frmEstornoReceber.blnAlpe              := blnAlpe;
      frmEstornoReceber.strEstRec            := '(Cancelamento de Documentos)';
      frmEstornoReceber.UtilizaContabilidadeERecebidoPorAdiantamento := FUtilizaContabilidadeERecebidoPorAdiantamento;
      frmEstornoReceber.blnEstornoDocLocEqu  := FblnCancelamentoLocEqu;

      if CancelandoNFViaFulFillment then
        frmEstornoReceber.objFulFillmentLogBuilder := FobjFulFillmentLogBuilder;

      If (pnlDadosDoc.Enabled) Then
      Begin
        blnNotaEletronica := False;
        pSetarDadosEstorno;
      End;

      pGetEspecieCancelamento(strEspSel, strEspCan, blnNotaEletronica);

      if ESPECIES_NOTA_DENEGADA.Contains(strEspSel) then
      begin
        strSerFsc := fSerieFiscal(strEspSel);
        frmEstornoReceber.blnNotaDenegada := (fNotaFiscalDenegada(strEspSel, 'C')) or
                                             (FblnDenegandoViaFulFillment) ;
      end;

      If (Not blnAutomatico) Then
        frmEstornoReceber.ShowModal
      Else
      Begin
        frmEstornoReceber.pFormShow;

        Repeat
          pSetarDadosEstorno;

          frmEstornoReceber.pCriaTemporaria;

          blnEstornouTudo := (frmEstornoReceber.cdsDados.IsEmpty);

          If (Not blnEstornouTudo) Then
          Begin
            frmEstornoReceber.pSelecionaDuplicata;
            frmEstornoReceber.pConfirmaEstorno;
          End;

          if CancelandoNFViaFulFillment then
          begin
            if FobjFulFillmentLogBuilder.blnTemLog then
              Exit;
          end;

        Until blnEstornouTudo;
      End;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.pEstornoReceber]');
    End;
  Finally
    pFreeAndNil(frmEstornoReceber);
  End;
end;

