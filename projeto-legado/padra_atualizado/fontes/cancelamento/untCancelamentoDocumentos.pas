function TfrmCancelamentoDocumentos.fExisteReposicaoDaGarantia(strEspSel, strNumDoc, strCliFor : String;
                                                              Var strDocGar, strTipCan: String): Boolean;
  function fGetSqlReposicao(blnSomenteReposicao : Boolean):String;
  Begin
    Result := '';
    Result := Result + 'SELECT DISTINCT                                           ';
    if blnSomenteReposicao Then
    Begin
      Result := Result + '       G2.GER_NUMDOC AS GER_NUMDOC, ';
      Result := Result + '       G2.GER_ESPDOC AS GER_ESPDOC, ';
      Result := Result + '       R2.GRC_OPCDOC                                      ';
    End
    Else
      Result := Result + '       M.GAG_NUMENT AS GER_NUMDOC ';

    Result := Result + 'FROM MOVGRC R                                             ';

    Result := Result + '  LEFT JOIN MOVDET D ON D.AUTOINCREM = R.GRC_SEQDET     ';
    Result := Result + '  LEFT JOIN MOVGER G ON G.AUTOINCREM = D.DET_SEQGER     ';

    Result := Result + '  INNER JOIN MOVGAD A ON A.AUTOINCREM = R.GRC_SEQGAD      ';
    Result := Result + '  INNER JOIN MOVGAG M ON M.AUTOINCREM = A.GAD_SEQGAG      ';

    Result := Result + '  INNER JOIN MOVGAD A2 ON A2.GAD_SEQGAG = M.AUTOINCREM    ';
    Result := Result + '  INNER JOIN MOVGRC R2 ON R2.GRC_SEQGAD = A2.AUTOINCREM   ';

    If blnSomenteReposicao Then
      Result := Result + '                    AND R2.GRC_OPCDOC IN ("GC","OU")    ';

    Result := Result + IIF(SameText(strEspSel, 'GA'), ' LEFT', '') + ' JOIN MOVDET  D2 ON D2.AUTOINCREM = R2.GRC_SEQDET   ';
    Result := Result + IIF(SameText(strEspSel, 'GA'), ' LEFT', '') + ' JOIN MOVGER  G2 ON G2.AUTOINCREM = D2.DET_SEQGER   ';
  End;

  function fGetWhereReposicao:String;
  Begin
    Result := '';
    if strEspSel = 'NW' Then
    Begin
      Result := Result + 'WHERE G.GER_NUMDOC = :NUMDOC ';
      Result := Result + '  AND G.GER_CODCLI = :CODCLI ';
      Result := Result + '  AND G.GER_ESPDOC = "NF"    ';
      Result := Result + '  AND G.GER_CODEMP = :CODEMP ';
    End
    Else

    If strEspSel = 'GA' Then
    Begin
      Result := Result + 'WHERE M.GAG_NUMENT = :NUMDOC  ';
      Result := Result + '  AND M.GAG_CODCLI = :CODCLI  ';
      Result := Result + '  AND M.GAG_CODEMP = :CODEMP  ';
    End;

    Result := Result + '  AND G2.GER_NUMDOC IS NOT NULL ';

    If SameText(strEspSel, 'GA') Then
      Result := Result + ' AND R.GRC_OPCDOC = "GA" '
    Else
      Result := Result + ' AND R.GRC_OPCDOC IN ("OU", "OE", "NE", "DV") ';
  End;

  Var
    qryConsulta : TUniQuery;
Begin
  qryConsulta := fCriaQuery(Self);
  Try
    With qryConsulta, SQL Do
    Begin

      Add(fGetSqlReposicao(True));
      Add(fGetWhereReposicao);

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      Open;

      Result := (not IsEmpty) And (not fEmptyStr(FieldByName('GER_NUMDOC').AsString));
      if Result And (FieldByName('GRC_OPCDOC').AsString = 'GC') And (FieldByName('GER_ESPDOC').AsString <> 'GC' ) Then
        Result := False;

      If Result Then
      Begin
        strDocGar := FieldByName('GER_NUMDOC').AsString;
        strTipCan := FieldByName('GRC_OPCDOC').AsString;
      End
      Else
      Begin
        Close;
        Clear;
        Add(fGetSqlReposicao(False));
        Add(fGetWhereReposicao);

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('CODCLI').AsString := strCliFor;
        ParamByName('CODEMP').AsString := VS_strCodEmp;

        Open;

        strDocGar := FieldByName('GER_NUMDOC').AsString;
      End;

    End;
  Finally
    FreeAndNil(qryConsulta);
  End;

End;

