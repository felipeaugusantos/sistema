            Add(' SELECT DISTINCT                                         ');
            Add('        D1.DET_NUMDOC,                                   ');
            Add('        D1.DET_ESPDOC,                                   ');
            Add('        D1.DET_CODCLI,                                   ');
            Add('        D1.DET_CODEMP,                                   ');
            Add('        IF(D1.DET_ESPDOC="GC",0,1) AS ORD                ');
            Add(' FROM MOVDET D1                                          ');
            Add('   INNER JOIN MOVGRC G1 ON G1.GRC_SEQDET = D1.AUTOINCREM ');
            Add(' WHERE D1.DET_NUMDOC = :NUMDOC                           ');
            Add('   AND D1.DET_ESPDOC = :ESPDOC                           ');
            Add('   AND D1.DET_CODEMP = :CODEMP                           ');
            Add(' ORDER BY ORD                                            ');

