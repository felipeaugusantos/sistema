{******************************************************************}
{* Quando vender item estrutura, não carregando os sub-produtos,  *}
{* e baixar estoque dos sub.produtos atraves da emissao de uma    *}
{* ordem de producao, esta ordem de producao deve ser cancelada e *}
{* o estoque dos sub.produtos deve ser atualizado                 *}
{***************************************************************JC*}
function TfrmCancelamentoDocumentos.fCancelaOrdemProducaoVenda(strOrdPro, strCliFor,
  strCodEmp: String; strTip_FC: String = 'C'): Boolean;
  Var
    qryAux: TUniQuery;
    qryMovRef: TUniQuery;
    strSql: String;
begin

  Result := True;

  If fEmptyStr(strOrdPro) Then
  Begin
    Exit;
  End;

  Result := TOrdPro.fExcluirOrdemProducao(strOrdPro, strCodEmp, Self.Name, strLoginUsuarioLogado, False);

  If Not Result Then
    Exit;

  { RETORNA OS PRODUTOS GERADOS PELA ORDEM DE PRODUCAO }
  strSql := '';
  strSql := strSql + ' SELECT SQL_NO_CACHE ';
  strSql := strSql + '   *                 ';
  strSql := strSql + ' FROM                ';
  strSql := strSql + '   MOVGER            ';
  strSql := strSql + ' WHERE               ';
  strSql := strSql + '   GER_ORDPRO = "' + strOrdPro + '" AND ';
  If strTip_FC = 'C' Then
    strSql := strSql + '   GER_CODCLI = "' + strCliFor + '" AND '
  Else
    strSql := strSql + '   GER_CODFOR = "' + strCliFor + '" AND ';
  strSql := strSql + '   GER_CODEMP = "' + strCodEmp + '" AND ';
  strSql := strSql + '   GER_TIP_FC = "' + strTip_FC + '" AND ';
  strSql := strSql + '   GER_ESPDOC = "OP"    ';

  qryAux := fCriaQuery(Nil);
  qryMovRef := fCriaQuery(Nil);

  With qryAux, SQL Do
  Begin
    Close;
    Clear;
    Add(strSql);
    Open;

    While Not Eof Do
    Begin
      fVerificaIntegridade(Self.Name, 'MOVGER', qryAux, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
      pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_MOVGER', qryAux.FieldByName('AUTOINCREM').AsString);

      Next;
    End;

    Close;
    Clear;
    Add(AnsiReplaceStr(AnsiReplaceStr(strSql, 'MOVGER', 'MOVDET'), 'GER_', 'DET_'));
    Open;

    First;
    While Not Eof Do
    Begin
      fVerificaIntegridade(Self.Name, 'MOVDET', qryAux, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

      qryMovRef.Close;
      qryMovRef.SQL.Clear;
      qryMovRef.SQL.Add('SELECT * FROM MOVREF');
      qryMovRef.SQL.Add('WHERE REF_SEQGER = :AUTINC');
      qryMovRef.ParamByName('AUTINC').AsString := FieldByName('AUTOINCREM').AsString;
      qryMovRef.Open;

      If Not qryMovRef.IsEmpty Then
      Begin
        qryMovRef.First;
        While Not qryMovRef.Eof Do
        Begin
          fVerificaIntegridade(Self.Name, 'MOVREF', qryMovRef, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
          fApagaRegistro('MOVREF', qryMovRef.FieldByName('REF_SEQGER').AsString);
          qryMovRef.Next;
        End;
      End;

      fAtualizaEstoque(FieldByName('DET_CODITE').AsString,
                       FieldByName('DET_QTDITE').AsFloat,
                       IIF(LeftStr(FieldByName('DET_CLAFIS').AsString, 1) >= '5', 'E', 'S'),
                       FieldByName('DET_NUMLOT').AsString,
                       '');
      Next;
    End;

    strSql := 'DELETE FROM MOVGER ' + Copy(strSql, Pos('WHERE', strSql), (Length(strSql) + 1) - Pos('WHERE', strSql));

    fExecutaSQL(strSql, True);
  End;

  FreeAndNil(qryMovRef);
  FreeAndNil(qryAux);

End;

