function TfrmCancelamentoDocumentos.fVerificarCadPagServBaixado(strNumDoc,
  strEspDoc, strCliFor: String): TStringList;
  Var
    qryAux: TUniQuery;
    strEspaco : String;
begin
  Result := TStringList.Create;

  strEspaco := '                                                               ';

  qryAux := fCriaQuery(Self);

  With qryAux Do
  Begin
    SQL.Add('SELECT ');
    SQL.Add('  CTP_DTACAD, ');
    SQL.Add('  CTP_DTAVEN, ');
    SQL.Add('  CTP_DTAPAG, ');
    SQL.Add('  CTP_NUMDUP, ');
    SQL.Add('  CTP_PARCEL, ');
    SQL.Add('  CTP_SERIE_, ');
    SQL.Add('  CTP_CODEMP, ');
    SQL.Add('  CTP_SEQBAI, ');
    SQL.Add('  CTP_CODFOR, ');
    SQL.Add('  FOR_NOMFOR, ');
    SQL.Add('  CTP_VALPAG  ');
    SQL.Add('FROM ');
    SQL.Add('  CADPAG P ');
    SQL.Add('  INNER JOIN CADFOR F ON P.CTP_CODFOR = F.FOR_CODFOR ');
    SQL.Add('WHERE ');
    SQL.Add('  CTP_DOCTER = :NUMDOC AND ');
    SQL.Add('  CTP_EMPTER = :CODEMP AND ');
    SQL.Add('  CTP_ESPTER = :ESPDOC AND ');
    SQL.Add('  CTP_CLITER = :CODCLI AND ');
    SQL.Add('  CTP_DTAPAG IS NOT NULL   ');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODCLI').AsString := strCliFor;
    Open;
    First;

    While (Not Eof) Do
    Begin
      If (RecNo = 1) Then
      Begin
        Result.Clear;
        Result.Add('Este documento possui contas a pagar quitado para serviço terceirizado.');
        Result.Add('Não será possível cancelar o documento.');
        Result.Add('Caso seja necessário cancelá-lo, será obrigatório estornar o contas a pagar dos ' +
                   'referidos serviços para liberar o cancelamento do documento em questão.');
        Result.Add('-------------------------------------------------------------------------------------------');
        Result.Add('| DT.CAD.  | DT.VENC. | DT.PAG.  | DUPLICATA    |SERIE|EMP|SB| FORNECEDOR     |   VR.PAGO |');
        Result.Add('-------------------------------------------------------------------------------------------');
      End;

      Result.Add(' ' + FieldByName('CTP_DTACAD').AsString +
                 ' ' + FieldByName('CTP_DTAVEN').AsString +
                 ' ' + FieldByName('CTP_DTAPAG').AsString +
                 ' ' + FieldByName('CTP_NUMDUP').AsString + '-' + FieldByName('CTP_PARCEL').AsString +
                 ' ' + Copy(FieldByName('CTP_SERIE_').AsString + strEspaco,1,5) +
                 ' ' + FieldByName('CTP_CODEMP').AsString +
                 ' ' + Copy(FieldByName('CTP_SEQBAI').AsString + strEspaco,1,2) +
                 ' ' + Copy(FieldByName('CTP_CODFOR').AsString + '-' + FieldByName('FOR_NOMFOR').AsString,1,16) +
                 ' ' + fPadL(FormatFloat('#0.00',FieldByName('CTP_VALPAG').AsFloat),11));

      If (RecNo = RecordCount) Then
        Result.Add('-------------------------------------------------------------------------------------------');

      Next;
    End;

    Close;
  End;

  FreeAndNil(qryAux);
end;

