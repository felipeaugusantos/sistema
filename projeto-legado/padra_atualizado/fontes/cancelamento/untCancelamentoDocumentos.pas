function TfrmCancelamentoDocumentos.fVerificarObraFinalizada(strNumDoc, strEspDoc, strCodCli: String): Boolean;
  Var
    strTabGer: String;
    strTabAux: String;
    strTip_FC: String;
    qryAux: TUniQuery;
begin
  Result := False;

  If edtTipPes.Visible Then
    strTip_FC := edtTipPes.Text
  Else
    strTip_FC := 'C';

  If strTip_FC <> 'C' Then
    Exit;

  strTabGer := 'MOVGER';
  strTabAux := 'AUXMOV';
  qryAux    := fCriaQuery(Self);

  With qryAux Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('SELECT                     ');
    SQL.Add('  AUX_OBRFIN               ');
    SQL.Add('FROM                       ');
    SQL.Add('  ' +  strTabGer + '       ');
    SQL.Add('  INNER JOIN ' +  strTabAux + ' ON AUX_SEQGER = AUTOINCREM ');
    SQL.Add('WHERE                      ');
    SQL.Add('  GER_NUMDOC = :NUMFAT AND ');
    SQL.Add('  GER_ESPDOC = :TIPFAT AND ');
    SQL.Add('  GER_CODEMP = :EMPFAT AND ');
    SQL.Add('  GER_CODCLI = :CODCLI AND ');
    SQL.Add('  GER_TIP_FC = :TIP_FC     ');

    ParamByName('NUMFAT').AsString := strNumDoc;
    ParamByName('TIPFAT').AsString := strEspDoc;
    ParamByName('EMPFAT').AsString := VS_strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('TIP_FC').AsString := strTip_FC;

    Open;

    Result := (FieldByName('AUX_OBRFIN').AsString = 'S');

    Close;
  End;

  If Result Then
    fMensagemCancelamento('', 'Este documento não pode ser cancelado pois a obra já foi finalizada!');

  FreeAndNil(qryAux);
end;

{*********************************************************************}
{* DELETA REGISTRO DA COMISSAO DO PROFISSIONAL E REGISTRO FINANCEIRA *}
{******************************************************************LU*}
procedure TfrmCancelamentoDocumentos.pCancelaComissaoProfissional(strEspDoc, strNumDoc, strCliFor, strCodEmp: String);
  Var
    strSQL: String;
Begin

  strSQL := '';
  strSQL := strSQL + 'DELETE FROM ';
  strSQL := strSQL + '  COMPRO    ';
  strSQL := strSQL + 'WHERE       ';
  strSQL := strSQL + '  COM_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  COM_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  COM_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '  COM_CODEMP = :CODEMP     ';

  With qryTemp01 Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODCLI').AsString := strCliFor;
    ParamByName('CODEMP').AsString := strCodEmp;
    ExecSQL;
    Close;
  End;

  strSQL := '';
  strSQL := strSQL + 'SELECT SQL_NO_CACHE * FROM ';
  strSQL := strSQL + '  CADREC   ';
  strSQL := strSQL + 'WHERE       ';
  strSQL := strSQL + '  ((CTR_ESPDOC = "CC") OR (CTR_ESPDOC = "FI")) AND ';
  strSQL := strSQL + '  CTR_DOCDIV = :NUMDOC AND ';
  strSQL := strSQL + '  CTR_ESPDIV = :ESPDOC AND ';
  strSQL := strSQL + '  CTR_CLIDIV = :CODCLI AND ';
  strSQL := strSQL + '  CTR_EMPDIV = :CODEMP     ';

  With qryTemp01 Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODCLI').AsString := strCliFor;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;

    While Not Eof Do
    Begin
      fApagaDuplicataContasReceber(qryTemp01, Self.Name);
      Next;
    End;

    Close;
  End;

End;

