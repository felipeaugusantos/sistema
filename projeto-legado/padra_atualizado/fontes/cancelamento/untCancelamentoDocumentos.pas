    fVerificaIntegridade(Self.Name, 'ITEREC', qryAux, True, False, EmptyStr, fOperadorDoCancelamento);
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Text :=  ' DELETE FROM ITEREC          '+
                        '  WHERE IRC_DOCREC = :NUMDOC '+
                        '    AND IRC_ESPREC = :ESPDOC '+
                        '    AND IRC_EMPREC = :CODEMP ';

    qryAux.ParamByName('NUMDOC').Value := strNumDoc;
    qryAux.ParamByName('CODEMP').Value := VS_strCodEmp;
    qryAux.ParamByName('ESPDOC').Value := strEspDoc;
    qryAux.ExecSQL;

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Text :=  ' UPDATE PENREC               '+
                        '  SET PEN_STATUS = "P",      '+
                        '      PEN_DOCREC = NULL,     '+
                        '      PEN_ESPREC = NULL,     '+
                        '      PEN_EMPREC = NULL      '+
                        '  WHERE PEN_DOCREC = :NUMDOC '+
                        '    AND PEN_ESPREC = :ESPDOC '+
                        '    AND PEN_EMPREC = :CODEMP '+
                        '    AND PEN_CODCLI = :CODCLI ';

    qryAux.ParamByName('NUMDOC').Value := strNumDoc;
    qryAux.ParamByName('CODEMP').Value := VS_strCodEmp;
    qryAux.ParamByName('ESPDOC').Value := strEspDoc;
    qryAux.ParamByName('CODCLI').Value := strCliFor;
    qryAux.ExecSQL;

    Result := True;
  Finally
    If Assigned(qryAux) Then
      FreeAndNil(qryAux);
  End;
end;

