end;

function TfrmCancelamentoDocumentos.DocumentoEmitidoPelaLocacaoEquipamentos(
  const AEspDoc, ANumDoc: String): Boolean;
var
  qrySelect: TUniQuery;
begin
  Result := False;

  If Not (fCfgSis('LOCEQU', varBoolean)) Then
    Exit(False);

  If Pos(AEspDoc, 'RL_NS_NF_FF_') <= 0 Then
    Exit(False);

  qrySelect := fCriaQuery(Self);
  Try
    Try
      If Pos(AEspDoc, 'RL_NS_') > 0 Then
      Begin
        qrySelect.SQL.Add('SELECT COUNT(EQLFAT.AUTOINCREM) AS QTD                  ');
        qrySelect.SQL.Add('  FROM CONEQL                                           ');
        qrySelect.SQL.Add('  INNER JOIN EQLFAT ON  (EQF_SEQCON = CONEQL.AUTOINCREM)');
        qrySelect.SQL.Add('  LEFT  JOIN FATGOR ON FATGOR.AUTOINCREM = EQL_AUT_PD   ');
        qrySelect.SQL.Add('  WHERE EQF_ESPDOC = :EQF_ESPDOC                        ');
        qrySelect.SQL.Add('    AND EQF_NUMDOC = :EQF_NUMDOC                        ');
        qrySelect.SQL.Add('    AND EQF_EMPDOC = :EQF_EMPDOC                        ');

        qrySelect.ParamByName('EQF_ESPDOC').AsString := AEspDoc;
        qrySelect.ParamByName('EQF_NUMDOC').AsString := ANumDoc;
        qrySelect.ParamByName('EQF_EMPDOC').AsString := VS_strCodEmp;
      End
      Else If Pos(AEspDoc, 'NF_FF_') > 0 Then
      Begin
        qrySelect.SQL.Add('SELECT COUNT(EQLDET.AUTOINCREM) AS QTD               ');
        qrySelect.SQL.Add('FROM EQLDET                                          ');
        qrySelect.SQL.Add('INNER JOIN CONEQL ON CONEQL.AUTOINCREM = EQD_SEQCON  ');
        qrySelect.SQL.Add('WHERE ((EQD_ESPENV = :ESPDOC)                        ');
        qrySelect.SQL.Add('  AND (EQD_NUMENV = :NUMDOC)                         ');
        qrySelect.SQL.Add('  AND (EQD_EMPENV = :EMPDOC))                        ');
        qrySelect.SQL.Add('  OR ((EQD_ESPRET = :ESPDOC)                         ');
        qrySelect.SQL.Add('  AND (EQD_NUMRET = :NUMDOC)                         ');
        qrySelect.SQL.Add('  AND (EQD_EMPRET = :EMPDOC))                        ');

        qrySelect.ParamByName('ESPDOC').AsString := AEspDoc;
        qrySelect.ParamByName('NUMDOC').AsString := ANumDoc;
        qrySelect.ParamByName('EMPDOC').AsString := VS_strCodEmp;
      End;

      qrySelect.Open;
      If Not qrySelect.isEmpty Then
      Begin
        Result := qrySelect.FieldByName('QTD').AsInteger > 0
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.DocumentoEmitidoPelaLocacaoEquipamentos]');
      End;
    End;
  Finally
    qrySelect.Close;
    FreeAndNil(qrySelect);
  End;
end;

