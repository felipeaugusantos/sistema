procedure TfrmCancelamentoDocumentos.pCancelaConsertoEquipamentoDoPedido(strNumPed, strCodCli: String);
  Var
    strSQL : String;
    qryGen : TUniQuery;
    qryUpd : TUniQuery;
    objConEqu : TConEqu;
Begin
  Try
    qryGen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + ' SELECT * ';
    strSQL := strSQL + '   FROM EQUGER ';
    strSQL := strSQL + '  WHERE EQU_TIPPED = "PD" ';
    strSQL := strSQL + '    AND EQU_NUMPED = :NUMPED ';
    strSQL := strSQL + '    AND EQU_EMPPED = :CODEMP ';
    strSQL := strSQL + '    AND EQU_CODCLI = :CODCLI ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      If Not IsEmpty Then
      Begin
        If (fCfgSis('CONEQU', VarBoolean)) And
           (fCfgSis('GER_OS', VarBoolean)) Then
        Begin
          objConEqu := TConEqu.Create(Self);
          Try
            objConEqu.strNumero := FieldByName('EQU_NUMOSE').AsString;
            objConEqu.strCodEmp := VS_strCodEmp;
            objConEqu.fCancelaOrdServico(Self.Name);
          Finally
            objConEqu.Free;
          End;
        End
        Else
        Begin
          Try
            qryUpd := fCriaQuery;

            strSQL := '';
            strSQL := strSQL + ' UPDATE ';
            strSQL := strSQL + '   EQUGER ';
            strSQL := strSQL + ' SET ';
            strSQL := strSQL + '   EQU_JAPEDI = :JAPEDI, ';
            strSQL := strSQL + '   EQU_TIPPED = :TIPPED, ';
            strSQL := strSQL + '   EQU_NUMPED = :NUMPED, ';
            strSQL := strSQL + '   EQU_DTAPED = :DTAPED, ';
            strSQL := strSQL + '   EQU_VENPED = :VENPED, ';
            strSQL := strSQL + '   EQU_VALPED = :VALPED, ';
            strSQL := strSQL + '   EQU_STATUS = :STATUS, ';
            strSQL := strSQL + '   EQU_FLXFAS = :FLXFAS, ';
            strSQL := strSQL + '   EQU_FLXSIT = :FLXSIT, ';
            strSQL := strSQL + '   EQU_FLXCOM = :FLXCOM  ';
            strSQL := strSQL + ' WHERE ';
            strSQL := strSQL + '   AUTOINCREM = :AUTINC ';

            qryUpd.Close;
            qryUpd.SQL.Clear;
            qryUpd.SQL.Add(strSQL);
            qryUpd.ParamByName('JAPEDI').AsInteger:= 0;
            qryUpd.ParamByName('TIPPED').Value := Null;
            qryUpd.ParamByName('NUMPED').Value := Null;
            qryUpd.ParamByName('DTAPED').Value := Null;
            qryUpd.ParamByName('VENPED').Value := Null;
            qryUpd.ParamByName('VALPED').Value := Null;
            qryUpd.ParamByName('STATUS').AsString := 'P';
            qryUpd.ParamByName('FLXFAS').AsString := 'O';
            qryUpd.ParamByName('FLXSIT').AsString := 'OR';
            qryUpd.ParamByName('FLXCOM').AsString := 'AC';
            qryUpd.ParamByName('AUTINC').AsString := FieldByName('AUTOINCREM').AsString;
            qryUpd.ExecSQL;

          Finally
            FreeAndNil(qryUpd);
          End;
        End;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
End;

Function TfrmCancelamentoDocumentos.fTemPedidoDeBaixaDeEntregaFutura(strEspSel, strNumDoc, strCodCli: String): Boolean;

  function fGetSQL(strTabela: string): string;
  begin
    Result := '';
    Result := Result + ' SELECT AUTOINCREM ';
    Result := Result + '   FROM ' + strTabela;
    Result := Result + '  WHERE DET_CODCLI = :CODCLI ';
    Result := Result + '    AND DET_NUMDOC = :NUMDOC ';
    Result := Result + '    AND DET_ESPDOC = :ESPDOC ';
    Result := Result + '    AND DET_CODEMP = :CODEMP ';
    Result := Result + '    AND (LOCATE(DET_CLAFIS, "5922_6922_") > 0) ';
  end;

  procedure pSetaParams(qryParam: TUniQuery);
  begin
    qryParam.ParamByName('CODCLI').AsString := strCodCli;
    qryParam.ParamByName('NUMDOC').AsString := strNumDoc;
    qryParam.ParamByName('ESPDOC').AsString := strEspSel;
    qryParam.ParamByName('CODEMP').AsString := VS_strCodEmp;
  end;

  function fTemPedidoBaixa(strIncFut: string): boolean;
    var
      qryPed : TUniQuery;
  begin
    qryPed := fCriaQuery(Self);
    try
      qryPed.Close;
      qryPed.SQL.Clear;
      qryPed.SQL.Add(' SELECT COUNT(*) CNT ');
      qryPed.SQL.Add('   FROM EXTDOR ');
      qryPed.SQL.Add('  WHERE FDO_INCFUT = :INCFUT ');
      qryPed.ParamByName('INCFUT').AsString := strIncFut;
      qryPed.Open;
      Result := (qryPed.FieldByName('CNT').AsInteger > 0);
      qryPed.Close;
    finally
      FreeAndNil(qryPed);
    end;
  end;

  Var
    qryGen: TUniQuery;
Begin
  If (Pos(strEspSel, 'MI_NF_EL_FF_IF_IV_D1_') <= 0) Then
    Exit(False);

  qryGen := fCriaQuery(Self);
  try
    try
      Result := False;

      qryGen.Close;
      qryGen.SQL.Clear;
      qryGen.SQL.Add(fGetSQL('MOVDET'));
      pSetaParams(qryGen);
      qryGen.Open;

      if (qryGen.IsEmpty) then
      begin
        qryGen.Close;
        qryGen.SQL.Clear;
        qryGen.SQL.Add(fGetSQL('NOTDET'));
        pSetaParams(qryGen);
        qryGen.Open;
      end;

      qryGen.First;
      while not qryGen.Eof do
      begin
        if (fTemPedidoBaixa(qryGen.FieldByName('AUTOINCREM').AsString)) then
        begin
          Result := True;
          Break;
        end;
        qryGen.Next;
      end;
    except
      on E: Exception do
      begin
        Result := False;
        pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fTemPedidoDeBaixaDeEntregaFutura]');
      end;
    end;
  finally
    FreeAndNil(qryGen);
  end;
End;

Function TfrmCancelamentoDocumentos.fEmprestimoBaixado(strEspSel, strNumDoc, strCodCli: String): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Try
    qryGen := fCriaQuery;
    With qryGen, SQL Do
    Begin

      Clear;
      Add('SELECT SUM(IFNULL(DET_BAIEMP,0)) AS BAIEMP');
      Add('FROM MOVDET  ');
      Add('WHERE ');
      Add('  DET_CODCLI = :CODCLI AND ');
      Add('  DET_NUMDOC = :NUMDOC AND ');
      Add('  DET_ESPDOC = :ESPDOC AND ');
      Add('  DET_CODEMP = :CODEMP     ');


      ParamByName('CODCLI').AsString  := strCodCli;
      ParamByName('NUMDOC').AsString  := strNumDoc;
      ParamByName('ESPDOC').AsString  := strEspSel;
      ParamByName('CODEMP').AsString  := VS_strCodEmp;

      Open;

      Result := FieldByName('BAIEMP').AsFloat > 0;

      Close;

    End;
    FreeAndNil(qryGen);

  Except
    On E: Exception Do
    Begin
      Result := True;
      pMensagensErro(E.Message, '[frmCancelamentoDocumentos.fEmprestimoBaixado]');
    End;
  End;

End;

