function TfrmCancelamentoDocumentos.fConsultarSaldoDisponivel(strSigDet: String; qryTemp: TUniQuery): Boolean;
Const
  cSep = '| ';
Var
  strNumLot,
  strCodIte: String;
  fltQtdCan: Double;
  fltSaldis: Double;
  fltSalAtu: Double;
  frmMensagemExplicativa: TfrmMensagemExplicativa;
  lstItens: TStringList;
Begin
  lstItens := TStringList.Create;
  Try
    qryTemp.First;
    While Not qryTemp.Eof Do
    Begin
      If (LeftStr(qryTemp.FieldByName(strSigDet + 'CLAFIS').AsString, 1) <= '3') AND (qryTemp.FieldByName('DET_FILKAR').AsString = '0') Then
      Begin
        strNumLot := qryTemp.FieldByName(strSigDet + 'NUMLOT').AsString;
        strCodIte := qryTemp.FieldByName(strSigDet + 'CODITE').AsString;
        fltQtdCan := qryTemp.FieldByName(strSigDet + 'QTDITE').AsFloat;
        fltSalAtu := fRetornaSaldoDisponivel(strCodIte, False, True, strNumLot);

        If fEmptyStr(strNumLot) Then
          fltSaldis := fltSalAtu - fltQtdCan
        Else
        //Verifica se é lote de garantia, se for desconsiderar a quantidade do que esta sendo alterada no saldo disponivel
        Begin
          If fCampoTabela('LOT_GARPRI','CADLOT', ['LOT_NUMLOT', 'LOT_CODEMP'], [strNumLot, VS_strCodEmp]) = 'S' Then
             fltSaldis := fltSalAtu + fltQtdCan
          Else
             fltSaldis := fltSalAtu - fltQtdCan;
        End;

        If (fltSaldis < 0) Then
        Begin
          If (lstItens.Count = 0) Then
          Begin
            lstItens.Add(fPadR('ITEM', fTamCodIte+3) + cSep + fPadL('LOTE', 20) + cSep + fPadL('SALDO DIPONÍVEL', 15) + cSep + fPadL('QTD. A CANCELAR', 15) + cSep);
            lstItens.Add(StringOfChar('-', fTamCodIte+3) + '--' + StringOfChar('-', 20) + '--' + StringOfChar('-', 15) + '--' +  StringOfChar('-', 15) + '-');
          End;
          lstItens.Add(fPadR(strCodIte, fTamCodIte+3) + cSep + fPadL(strNumLot, 20) + cSep +  fPadL(FormatFloat('#,##0.00', fltSalAtu), 15) + cSep +  fPadL(FormatFloat('#,##0.00', fltQtdCan), 15) + cSep);
        End;
      End;

      qryTemp.Next;
    End;

    Result := lstItens.Count > 0;

    If Result Then
    Begin
      fRollback;
      pCriarFormularios(TfrmMensagemExplicativa, frmMensagemExplicativa);
      Try
        frmMensagemExplicativa.Caption := 'Cancelamento de TA';
        frmMensagemExplicativa.mmoInstru.Lines.Add('Esta TA não poderá ser cancelada pois o estoque ficará negativo para os itens listados a seguir. '+
                                                   'Realize o ajuste de estoque nos produtos citados para que, ao cancelar este documento, o saldo não fique negativo.');
        frmMensagemExplicativa.mmoInstru.Lines.Add(' ');
        frmMensagemExplicativa.mmoInstru.Lines.Add(' ');
        frmMensagemExplicativa.mmoInstru.Lines.Add(lstItens.Text);
        If FExecutandoCanceladorAutomatico Then
          pMensagemOK(frmMensagemExplicativa.Caption + sLineBreak + frmMensagemExplicativa.mmoInstru.Lines.Text)
        Else If CancelandoNFViaFulFillment Then
          objFulFillmentLogBuilder.pSalvarLog(frmMensagemExplicativa.mmoInstru.Lines.Text, True)
        Else
          frmMensagemExplicativa.ShowModal;
      Finally
        pFreeAndNil(frmMensagemExplicativa);
      End;
    End;
  Finally
    FreeAndNil(lstItens);
  End;
End;

procedure TfrmCancelamentoDocumentos.pCancelarCTeCarCap;
Var
  strNumDoc,
  strCliFor,
  strSerie: String;
Begin
  FblnDocumentoCancelado := False;
