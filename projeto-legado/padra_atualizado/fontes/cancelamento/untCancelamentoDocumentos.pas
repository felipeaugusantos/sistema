procedure TfrmCancelamentoDocumentos.pNFConfirmacaoCupons(strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
  Var
    strSQL : String;
    qryTmp : TUniQuery;
    lstLista : TStringList;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
  strSQL := strSQL + '  DET_DTAENT AS DTAEMI, ';
  strSQL := strSQL + '  CONCAT(DET_NUMDOC,"-",DET_ESPDOC) AS DOCUME, ';
  strSQL := strSQL + '  DET_CODEMP AS CODEMP, ';
  strSQL := strSQL + '  CONCAT(DET_CODCLI,"-",CLI_NOMCLI) AS NOMCLI, ';
  strSQL := strSQL + '  SUM(DET_TOTITE) AS VALDOC  ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVDET D INNER JOIN CADCLI C ON D.DET_CODCLI = C.CLI_CODCLI ';
  strSQL := strSQL + 'WHERE DET_ESPDOC IN ("IF", "IV") ';
  strSQL := strSQL + '  AND DET_NUMFAT = :NUMDOC ';
  strSQL := strSQL + '  AND DET_TIPFAT = :ESPDOC ';
  strSQL := strSQL + '  AND DET_EMPFAT = :CODEMP ';
  strSQL := strSQL + '  AND DET_CLIFAT = :CODCLI ';
  strSQL := strSQL + '  GROUP BY DTAEMI, DOCUME, CODEMP, NOMCLI ';
  strSQL := strSQL + 'UNION ALL ' + AnsiReplaceStr(strSQL, 'MOVDET', 'NOTDET');

  qryTmp := fCriaQuery(Self);

  With qryTmp Do
  Begin
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;
    Open;

    If Not IsEmpty Then
    Begin
      lstLista := TStringList.Create;

      lstLista.Add('-----------------------------------------------------------------------');
      lstLista.Add(' Abaixo, segue listagem dos cupons fiscais que deram origem a esta NF. ');
      lstLista.Add('                       Confirme com sua gerência                       ');
      lstLista.Add('     se será necessario cancelar ou fazer a devolução dos mesmos.      ');
      lstLista.Add('-----------------------------------------------------------------------');
      lstLista.Add(' DT.EMISSÃO DOCUMENTO       EMP CLIENTE                          VALOR ');
      lstLista.Add('-----------------------------------------------------------------------');

      First;
      while Not Eof Do
      Begin
        lstLista.Add(' ' + fPadR(FieldByName('DTAEMI').AsString,10) +
                     ' ' + fPadR(FieldByName('DOCUME').AsString,15) +
                     ' ' + fPadR(FieldByName('CODEMP').AsString,03) +
                     ' ' + fPadR(FieldByName('NOMCLI').AsString,25) +
                     ' ' + fPadL(FormatFloat('#,##0.00',FieldByName('VALDOC').AsFloat),12)+' ');
        Next;
      end;

      lstLista.Add('-----------------------------------------------------------------------');

      Try
        pCriarFormularios(TfrmMemo, frmMemo);
        frmMemo.cxMemo.Style.Font.Style := [];
        frmMemo.cxMemo.Lines := lstLista;
        If FExecutandoCanceladorAutomatico Then
          pMensagemOK(frmMemo.cxMemo.Text)
        Else If CancelandoNFViaFulFillment Then
          objFulFillmentLogBuilder.pSalvarLog(frmMemo.cxMemo.Text, True)
        Else
          frmMemo.ShowModal;
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[frmRelCtpTitContas.btnImprimirClick]');
        End;
      End;

    End;

    Close;
  End;

  FreeAndNil(qryTmp);

end;

