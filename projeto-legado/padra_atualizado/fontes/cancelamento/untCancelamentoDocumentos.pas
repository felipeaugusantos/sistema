function TfrmCancelamentoDocumentos.fDesvinculaDocumentoPendencia(strEspDoc,
  strNumDoc, strCliFor: String): Boolean;
var
  qryAux: TUniQuery;
begin

  qryAux := fCriaQuery(Self);
  Try
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Text := 'SELECT * FROM ITEREC ' +
                       '  WHERE IRC_DOCREC = :NUMDOC '+
                       '    AND IRC_ESPREC = :ESPDOC '+
                       '    AND IRC_EMPREC = :CODEMP ';
    qryAux.ParamByName('NUMDOC').Value := strNumDoc;
