function TfrmCancelamentoDocumentos.fCarregaInformacoesDoCancelamnento(strNumDoc,
  strEspDoc, strCodEmp, strCodCli: String; var recDadosCancelamento: TrecDadosCancelamento): Boolean;
  Var
    qryPesq: TUniQuery;

  function fGetSelect(strTabela: String): String;
  var
    strSQL: String;
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  GER_CONPAG, ';
    strSQL := strSQL + '  GER_CODCND, ';
    strSQL := strSQL + '  GER_CODFPG, ';
    strSQL := strSQL + '  GER_CODVEN, ';
    strSQL := strSQL + '  GER_VLRCON  ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ' + strTabela + ' ';
    strSQL := strSQL + 'WHERE GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '  AND GER_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '  AND GER_CODEMP = :CODEMP ';
    strSQL := strSQL + '  AND GER_CODCLI = :CODCLI ';

    Result := strSQL;
  End;

  procedure pSetaParametros();
  Begin
    qryPesq.ParamByName('NUMDOC').AsString := strNumDoc;
    qryPesq.ParamByName('ESPDOC').AsString := strEspDoc;
    qryPesq.ParamByName('CODEMP').AsString := strCodEmp;
    qryPesq.ParamByName('CODCLI').AsString := strCodCli;
  End;

  procedure pSetaValores();
  begin
    recDadosCancelamento.strConPag := qryPesq.FieldByName('GER_CONPAG').AsString;
    recDadosCancelamento.strCodCnd := qryPesq.FieldByName('GER_CODCND').AsString;
    recDadosCancelamento.strCodFpg := qryPesq.FieldByName('GER_CODFPG').AsString;
    recDadosCancelamento.strCodVen := qryPesq.FieldByName('GER_CODVEN').AsString;
    recDadosCancelamento.fltTotGer := qryPesq.FieldByName('GER_VLRCON').AsFloat;
  end;

begin
  Result := False;
  FillChar(recDadosCancelamento, SizeOf(recDadosCancelamento), #0);
  qryPesq := fCriaQuery();
  Try
    qryPesq.SQL.Text := fGetSelect('MOVGER');
    pSetaParametros();
    qryPesq.Open;

    If Not qryPesq.IsEmpty Then
    Begin
      pSetaValores();
      Result := True;
    End
    Else
    Begin
      qryPesq.Close;
      qryPesq.SQL.Clear;
      qryPesq.SQL.Text := fGetSelect('NOTGER');
      pSetaParametros();
      qryPesq.Open;

      If Not qryPesq.IsEmpty Then
      Begin
        pSetaValores();
        Result := True;
      End
    End;
  Finally
    FreeAndNil(qryPesq);
  End;
end;

