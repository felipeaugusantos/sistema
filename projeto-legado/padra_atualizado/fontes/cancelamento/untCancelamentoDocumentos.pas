        pStepBy;

        If (blnResult) And (strEspSel = 'GR') Then
          blnResult := fCancelaPedidoDeReserva('GR', strNumDocSel, strCliForSel, fRetSerFsc, fRetTipPes('F'));

        pStepBy;

        If (Pos(strEspSel,'GF_') > 0) and (blnResult) Then
        Begin
          pStepBy;

          If (fCfgSis('GARMAT',varBoolean)) Then
          begin
            blnPodeDesfaturar := True;
            blnResult := fDesfaturaPedidoVenda(strEspSel, strNumDocSel, fCadEmp('CLIFIL'));
          End;

          pStepBy;

          {*******************************************}
          {* CANCELA PEDIDO DE COMPRA                *}
