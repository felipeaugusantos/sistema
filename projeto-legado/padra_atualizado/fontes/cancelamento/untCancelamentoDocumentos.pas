function TfrmCancelamentoDocumentos.fCancelaPedidosAbastecimentoVinculados(strEspDoc, strNumDoc: String): Boolean;
var
  strSQL: String;
  qryAux: TUniQuery;
  qryPrepTe: TUniQuery;
begin
  Result := True;

  if fCfgSis('CPDABT', varBoolean) then
    Exit;

  qryPrepTe := fCriaQuery;
  qryAux := fCriaQuery;

  try
    qryAux.SQL.Add('DELETE FROM PREPTE WHERE AUTOINCREM = :SEQPRE');

    strSQL := '';
    strSQL := strSQL + '';
    strSQL := strSQL + 'SELECT AUTOINCREM, PRE_NUMDOC, PRE_ESPDOC, PRE_EMPDOC, ';
    strSQL := strSQL + '       (SELECT FGO_CODCLI FROM FATGOR ';
    strSQL := strSQL + '        WHERE PRE_NUMDOC = FGO_NUMDOC ';
    strSQL := strSQL + '          AND PRE_ESPDOC = FGO_ESPDOC ';
    strSQL := strSQL + '          AND PRE_EMPDOC = FGO_CODEMP) FGO_CODCLI ';
    strSQL := strSQL + 'FROM PREPTE ';
    strSQL := strSQL + 'WHERE PRE_DOCABS = :DOCABS ';
    strSQL := strSQL + '  AND PRE_ESPABS = :ESPABS ';
    strSQL := strSQL + '  AND PRE_EMPABS = :EMPABS ';

    qryPrepTe.Close;
    qryPrepTe.SQL.Text := strSQL;
    qryPrepTe.ParamByName('DOCABS').AsString := strNumDoc;
    qryPrepTe.ParamByName('ESPABS').AsString := strEspDoc;
    qryPrepTe.ParamByName('EMPABS').AsString := VS_strCodEmp;
    qryPrepTe.Open;

    if qryPrepTe.IsEmpty then
      Exit;

    qryPrepTe.First;

    while not qryPrepTe.Eof do
    begin
      if (not fEmptyStr(qryPrepTe.FieldByName('PRE_NUMDOC').AsString)) then
        Result := fCancelaItensOrcPed(qryPrepTe.FieldByName('PRE_ESPDOC').AsString,
                                      qryPrepTe.FieldByName('PRE_NUMDOC').AsString,
                                      qryPrepTe.FieldByName('FGO_CODCLI').AsString,
                                      qryPrepTe.FieldByName('PRE_EMPDOC').AsString);

      if (not Result) then
        Exit;

      qryAux.Close;
      qryAux.ParamByName('SEQPRE').AsString := qryPrepTe.FieldByName('AUTOINCREM').AsString;
      qryAux.ExecSQL;

      qryPrepTe.Next;
    end;
  finally
    FreeAndNil(qryPrepTe);
    FreeAndNil(qryAux);
  end;
end;

function TfrmCancelamentoDocumentos.fCancelaCashbackGeradoVenda(const strNumDoc,
  strEspDoc, strCodEmp: String): Boolean;
var
  objControle : TControleCashback;
begin
  objControle := TControleCashback.Create;
  Try
    If (Not objControle.fPermiteUtilizarRotinaCashback) Then
      Exit(True);

    If Not fPodeCancelarCashbackGeradoVenda(strNumDoc, strEspDoc, strCodEmp) Then
      Exit(False);

    objControle.strNumDoc := strNumDoc;
    objControle.strEspDoc := strEspDoc;
    objControle.strCodEmp := strCodEmp;

    Result := objControle.fCancelaCashbackGeradoDocumento;
  Finally
    FreeAndNil(objControle);
  End;
end;

function TfrmCancelamentoDocumentos.fPodeCancelarCashbackGeradoVenda(const strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  objControle : TControleCashback;
  strDocUti   : String;
begin
  objControle := TControleCashback.Create;
  Try
    If (Not objControle.fPermiteUtilizarRotinaCashback) Then
      Exit(True);

    If objControle.fExisteCashbackUtilizadoDaVenda(strNumDoc, strEspDoc, strCodEmp, strDocUti) Then
    Begin
      fMensagem('ATENÇÃO!','Este documento gerou cashback, que já foi utilizado '+
                           'pelo(s) documento(s) '+strDocUti+', e não poderá '+
                           'ser cancelado. Verifique!', ['&Ok']);

      Exit(False);
    End;

    Result := True;
  Finally
    FreeAndNil(objControle);
  End;
end;

Function TfrmCancelamentoDocumentos.fCancelaConferenciaNotaEletronica(strIdeDig : String): Boolean;
  Var
    qryGerEle: TUniQuery;
Begin
  Try
    qryGerEle := fCriaQuery;
