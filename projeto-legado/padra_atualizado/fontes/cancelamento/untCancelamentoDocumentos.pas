             End;
          End;

          If (Not fUsaRotinaWMS) Then
          Begin
            If (blnIteBaiEntFutLot) Then
            Begin
              If (Not blnFutLot) Then //MOVIMENTO DE LOTE "NÃO" FOI FEITO POR 5999/1999 COM DET_PROEMB = S (MODO ANTIGO)
              Begin
                Result := Result And
                  fCancelaTLBaixaEntregaFutura(FieldByName(strSigDet + 'NUMDOC').AsString,
                                               FieldByName(strSigDet + 'ESPDOC').AsString,
                                               FieldByName(strSigDet + 'CODEMP').AsString,
                                               FieldByName(strSigDet + 'CODCLI').AsString,
                                               FieldByName('AUTOINCREM').AsString);
              End;
            End;
          End;

          {*******************************************}
          {* CASO SEJA 'NOTDET' NAO ATUALIZA ESTOQUE *}
          {****************************************MV*}
          If (Result) And
             (Not blnAjusteSaldoExterno) And
             (Pos('NOTDET', strArqDet) <= 0)                                                         And
             (Pos('TINDET', strArqDet) <= 0)                                                         And
             (Pos('ITEM ESPECIAL', fRetNomProduto(FieldByName(strSigDet + 'CODITE').AsString)) <= 0) And
