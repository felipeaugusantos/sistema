      qryAux.SQL.Add('  FATGOR ');
      qryAux.SQL.Add('SET ');
      qryAux.SQL.Add('  FGO_FREBAI = 0 ');
      qryAux.SQL.Add('WHERE ');
      qryAux.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
      qryAux.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
      qryAux.SQL.Add('  FGO_CODEMP = :CODEMP ');

      qryAux.ParamByName('NUMDOC').AsString := strNum_Pd;
      qryAux.ParamByName('ESPDOC').AsString := strEsp_Pd;
      qryAux.ParamByName('CODEMP').AsString := strEmp_Pd;

      qryAux.ExecSQL;

      FreeAndNil(qryAux);
    end;

    Procedure pLeDadosItem(strCodIte: String; Var strCodUni, strUniCom: String; Var fltEmbala: Double);
      Var
        qryCadIte: TUniQuery;
    Begin
      qryCadIte := fCriaQuery;

      With qryCadIte, SQL Do
      Begin
        Clear;
        Add('SELECT');
        Add('  ITE_CODUNI, ');
        Add('  ITE_UNICOM, ');
        Add('  IFNULL(ITE_EMBALA, 0) AS ITE_EMBALA ');
        Add('FROM');
        Add('  CADITE');
        Add('WHERE');
        Add('  ITE_CODITE = :CODITE');

        ParamByName('CODITE').AsString := strCodIte;

        Open;

        If IsEmpty then
        Begin
          strCodUni := '';
          strUniCom := '';
          fltEmbala := 1;
        End Else
        Begin
          strCodUni := FieldByName('ITE_CODUNI').AsString;
          strUniCom := FieldByName('ITE_UNICOM').AsString;
          fltEmbala := FieldByName('ITE_EMBALA').AsFloat;
        End;

        FreeAndNil(qryCadIte);
      End;
    End;

    function fRetornaEspecie: String;
    begin
      Result := strEspDoc;

      If (arrEspecies[intIndiceEsp][0] = 'NC') Then
        Exit('NF');

      If (arrEspecies[intIndiceEsp][0] = 'DC') Then
        Exit('NF');

      If (arrEspecies[intIndiceEsp][0] = 'IC') Then
        Exit('IF');
    end;

begin
  blnWmsGerouPedidoDeEnderecamento := False;
  strNumLotMovimentacaoEstoque := '';
  strNum_Pd := '';
  strEsp_Pd := '';
  strEmp_Pd := '';
  strIncRes := '';

  strDocFatRQ := '';
  strTipFatRQ := '';
  strEmpFatRQ := '';

  dtaGerEnt := 0;
  LMantemPDConferido := False;

  Try
    Result := True;

    If (fSuportaInterfaceGrafica) And (Not fVerificarDevolucoes(strNumDoc, strEspDoc, strCliFor)) Then
    Begin
      Result := False;
      Exit;
    End;

    If fFalhaEmTransacao Then
      Exit(False);

    stlPedCom := TStringList.Create;
    stlPedCom.Duplicates := dupIgnore;

    stlPedComAux := TStringList.Create;
    stlPedComAux.Duplicates := dupIgnore;

    blnGerouEnderecamento := False;

    blnVerificaOrigem := False;

    blnCancelouLivro := False;

    If (strEspDoc = 'TA') Then
      strSerieCan := ''
    Else If (edtSerie.Visible) or (Not fSuportaInterfaceGrafica) Then
      strSerieCan := edtSerie.Text
    Else If (strEspDoc = 'NS') Then
      strSerieCan := fCfgSis('SERNFS')
    Else If ((strEspDoc = 'IF') And (fCfgSis('USNFCE', varBoolean) Or fUsaSat)) Then
      strSerieCan := fCfgSis('SERNFC')
    Else
      strSerieCan := fCfgSis('SERFSC');

    If (strEspDoc = 'NS') And FNFSeSubstituicao Then
      strSerieCan := IIF(fEmptyStr(edtSerie.Text), fCfgSis('SERNFS'), edtSerie.Text);

    {Zera a marcacao de nota com FISREF; fCancelaLivroFiscal marca quando existir.
     Verificar Nota 1 - Req. 468332}
    FblnNotaComFisRef := False;

    If (Pos(strEspDoc, 'NF_EL_NS_IF_IV_D1_NC_IC_DC_') > 0) And (arrEspecies[intIndiceEsp][0] <> 'NI') Then
    Begin
      blnCancelouLivro := fCancelaLivroFiscal(fRetornaEspecie, edtNumDoc.Text, edtCliFor.Text, strSerieCan, strIncFis);
      If Not blnCancelouLivro Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    pCancelaSepFdo(strNumDoc, strEspDoc);

    //Verifica se o Documento é proveniente de espelho
    If (fCfgSis('OUSAFO', varString) = '2') And (Pos(arrEspecies[intIndiceEsp][0], 'GA') > 0) And (not fEmptyStr(strIncEspGer)) Then
    Begin
      If (Not TEspelhoCapa.fApagarEspelho(strIncEspGer, Self.Name)) Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    If (fCfgSis('OUSAFO', varString) = '2') And (Pos(arrEspecies[intIndiceEsp][0], 'OF_NG_') > 0) And (not fEmptyStr(strIncEspGer)) Then
    Begin
      Case intRespostaEspelho Of
        1: TEspelhoCapa.fReabrirEspelho(strIncEspGer);
        2: TEspelhoCapa.fApagarEspelho(strIncEspGer, Self.Name);
      End;
      strIncEspGer := '';
    End;

    If (Pos(arrEspecies[intIndiceEsp][0], 'NC_IC_DC_') > 0) Then
    Begin

      Result := blnCancelouLivro;

      Try

        qryNotCom:= fCriaQuery(Self);

        With qryNotCom Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(fRetornaSQLNotCom);
          ParamByName('SEQGER').AsString := strIncFis;
          Open;
        End;

        {*******************************************}
        {* GRAVA NOS ARQUIVOS DELETADOS            *}
        {****************************************PZ*}
        If (Result) Then
        Begin
          fVerificaIntegridade(Self.Name,'NOTCOM', qryNotCom, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
          Result := fApagaNotCom(strIncFis);
        End;

      Finally
        FreeAndNil(qryNotCom);
      End;

      Exit;

    End;

    qryGenDor := fCriaQuery(Self);

    blnDocumentoExiste := False;

    If (arrEspecies[intIndiceEsp][0] = 'NE') Or
       (arrEspecies[intIndiceEsp][0] = 'ND') Or
       ((arrEspecies[intIndiceEsp][0] = 'EL') And (edtTipPes.Text = 'F')) Or
       (arrEspecies[intIndiceEsp][0] = 'OF') Or
       (arrEspecies[intIndiceEsp][0] = 'EF') Or
       (arrEspecies[intIndiceEsp][0] = 'NR') Or
       (arrEspecies[intIndiceEsp][0] = 'NG') Or
       (arrEspecies[intIndiceEsp][0] = 'DL') Then
    Begin

      If (arrEspecies[intIndiceEsp][0] = 'ND') Or
         (arrEspecies[intIndiceEsp][0] = 'EF') Or
         (arrEspecies[intIndiceEsp][0] = 'OF') Or
         (arrEspecies[intIndiceEsp][0] = 'DL') Then
        blnVerificaOrigem := True;

      {*******************************************}
      {* DEFINE ARQUIVOS (DADOS GERAIS)          *}
      {****************************************MV*}
      SetLength(arrArqGer, 1, 2);
      arrArqGer[0][0] := 'MOVGER';
      arrArqGer[0][1] := 'GER_';
      {*******************************************}
      {* DEFINE ARQUIVOS (DADOS ITENS)           *}
      {****************************************MV*}
      SetLength(arrArqDet, 1, 2);
      arrArqDet[0][0] := 'MOVDET';
      arrArqDet[0][1] := 'DET_';

      If arrEspecies[intIndiceEsp][0] = 'NE' Then
      Begin
        SetLength(arrArqGer, 2, 2);
        arrArqGer[1][0] := 'NOTGER';
        arrArqGer[1][1] := 'GER_';

        SetLength(arrArqDet, 2, 2);
        arrArqDet[1][0] := 'NOTDET';
        arrArqDet[1][1] := 'DET_';
      End;
    End

    {*******************************************}
    {* SE FOR NOTA DE IMPORTAÇÃO               *}
    {****************************************MV*}
    Else If (arrEspecies[intIndiceEsp][0] = 'NI') Then
    Begin
      {*******************************************}
      {* DEFINE ARQUIVOS (DADOS GERAIS)          *}
      {****************************************MV*}
      SetLength(arrArqGer, 1, 2);
      arrArqGer[0][0] := 'NOTGER';
      arrArqGer[0][1] := 'GER_';
      {*******************************************}
      {* DEFINE ARQUIVOS (DADOS ITENS)           *}
      {****************************************MV*}
      SetLength(arrArqDet, 1, 2);
      arrArqDet[0][0] := 'NOTDET';
      arrArqDet[0][1] := 'DET_';
    End

    Else
    Begin
      If (Pos(strEspDoc, 'NF_EL_NS_IF_IV_D1_RL') > 0) Then
      Begin
        {*******************************************}
        {* DEFINE ARQUIVOS (DADOS GERAIS)          *}
        {****************************************MV*}
        If VS_strUsaTmq = 'S' Then
          SetLength(arrArqGer, 3, 3)
        Else
          SetLength(arrArqGer, 2, 3);

        arrArqGer[0][0] := 'MOVGER';
        arrArqGer[0][1] := 'GER_';
        arrArqGer[1][0] := 'NOTGER';
        arrArqGer[1][1] := 'GER_';

        If VS_strUsaTmq = 'S' Then
        Begin
          arrArqGer[2][0] := 'TINGER';
          arrArqGer[2][1] := 'GER_';
        End;

        {*******************************************}
        {* DEFINE ARQUIVOS (DADOS ITENS)           *}
        {****************************************MV*}
        If VS_strUsaTmq = 'S' Then
          SetLength(arrArqDet, 3, 3)
        Else
          SetLength(arrArqDet, 2, 3);

        arrArqDet[0][0] := 'MOVDET';
        arrArqDet[0][1] := 'DET_';
        arrArqDet[1][0] := 'NOTDET';
        arrArqDet[1][1] := 'DET_';
        If VS_strUsaTmq = 'S' Then
        Begin
          arrArqDet[2][0] := 'TINDET';
          arrArqDet[2][1] := 'DET_';
        End;

        blnVerificaOrigem := True;

      End

      Else If (Pos(strEspDoc, 'GF_GR_') > 0) Then
      Begin
        SetLength(arrArqGer, 2, 3);

        arrArqGer[0][0] := 'MOVGER';
        arrArqGer[0][1] := 'GER_';
        arrArqGer[1][0] := 'NOTGER';
        arrArqGer[1][1] := 'GER_';

        SetLength(arrArqDet, 2, 3);

        arrArqDet[0][0] := 'MOVDET';
        arrArqDet[0][1] := 'DET_';
        arrArqDet[1][0] := 'NOTDET';
        arrArqDet[1][1] := 'DET_';
      End

      Else If (Pos(strEspDoc, 'MI_FF_TR_DV_TE_BR_AJ_RQ_ML_PI_EP_UC_BE_TA_TL_CS_CR_GC_GA_PA_RB_') > 0) Then
      Begin
        {*******************************************}
        {* DEFINE ARQUIVOS (DADOS GERAIS)          *}
        {****************************************MV*}
        If VS_strUsaTmq = 'S' Then
          SetLength(arrArqGer, 3, 3)
        Else
          SetLength(arrArqGer, 2, 3);

        arrArqGer[0][0] := 'MOVGER';
        arrArqGer[0][1] := 'GER_';
        arrArqGer[1][0] := 'NOTGER';
        arrArqGer[1][1] := 'GER_';

        If VS_strUsaTmq = 'S' Then
        Begin
          arrArqGer[2][0] := 'TINGER';
          arrArqGer[2][1] := 'GER_';
        End;

        {*******************************************}
        {* DEFINE ARQUIVOS (DADOS ITENS)           *}
        {****************************************MV*}
        If VS_strUsaTmq = 'S' Then
          SetLength(arrArqDet, 3, 3)
        Else
          SetLength(arrArqDet, 2, 3);

        arrArqDet[0][0] := 'MOVDET';
        arrArqDet[0][1] := 'DET_';
        arrArqDet[1][0] := 'NOTDET';
        arrArqDet[1][1] := 'DET_';
        If VS_strUsaTmq = 'S' Then
        Begin
          arrArqDet[2][0] := 'TINDET';
          arrArqDet[2][1] := 'DET_';
        End;
      End

      {*******************************************}
      {* PD = REFERENTE À NOTA DE ENTRADA (CX 2) *}
      {****************************************MV*}
      Else If (strEspDoc = 'PD') Then
      Begin
        {*******************************************}
        {* DEFINE ARQUIVOS (DADOS GERAIS)          *}
        {****************************************MV*}
        SetLength(arrArqGer, 1, 2);
        arrArqGer[0][0] := 'MOVGER';
        arrArqGer[0][1] := 'GER_';

        {*******************************************}
        {* DEFINE ARQUIVOS (DADOS ITENS)           *}
        {****************************************MV*}
        SetLength(arrArqDet, 1, 2);
        arrArqDet[0][0] := 'MOVDET';
        arrArqDet[0][1] := 'DET_';
      End;
    End;

    {*******************************************}
    { CASO SEJA AJUSTE DE ESTOQUE REMOVE A      }
    { REFERENCIA DE BALANÇO DOS ITENS ENVOLIDOS }
    { NO DOCUMENTO                              }
    {****************************************WG*}
    blnAjusteSaldoExterno := fAjustaEstoqueSaldoExterno(strNumDoc, strEspDoc, IIF(SameText(strTipFc,'CODFOR'),'F','C'), strCliFor, VS_strCodEmp, strSerie);

    If (Pos(arrEspecies[intIndiceEsp][0], 'AJ_ML') > 0) Then
    begin
      pRemoverReferenciaBalancoItegerECadLot(strNumDoc, strEspDoc, VS_strCodEmp);

      //ajuste de estoque externo fulfillment
      If fRetOpcDocTrue(strNumDoc, strEspDoc, VS_strCodEmp, strCliFor, edtTipPes.Text) = 'AF' Then
        fCancelarBaixaLotesWMS(strNumDoc, strEspDoc, VS_strCodEmp, strCliFor);
    end;

    For intContador := 0 To Length(arrArqDet)-1 Do
    Begin
      If fFalhaEmTransacao Then
        Exit(False);

      strArqGer := arrArqGer[intContador][0];
      strArqDet := arrArqDet[intContador][0];

      strSigGer := arrArqGer[intContador][1];
      strSigDet := arrArqDet[intContador][1];
      strCmpDet := arrArqDet[intContador][1];

      strSQL := '';
      strSQL := strSQL + 'SELECT ';

      If (Pos(strArqDet,'TINDET_') > 0) Then
        strSQL := strSQL + '  T.* '
      Else
        strSQL := strSQL + '  * ';

      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + strArqDet + IIF((Pos(strArqDet,'TINDET_') > 0), ' T ', ' ');

      If (Pos(strArqDet,'TINDET_') > 0) Then
      Begin
        strSQL := strSQL + ' INNER JOIN MOVDET D ON  D.DET_NUMDOC = T.' + strCmpDet + 'NUMDOC AND ';
        strSQL := strSQL + '                         D.DET_ESPDOC = T.' + strCmpDet + 'ESPDOC AND ';
        strSQL := strSQL + '                         D.DET_CODEMP = T.' + strCmpDet + 'CODEMP AND ';
        strSQL := strSQL + '                         D.DET_EMPACA = T.' + strCmpDet + 'EMPACA AND ';
        strSQL := strSQL + '                         D.DET_CODACA = T.' + strCmpDet + 'CODACA ';

        strCmpDet := 'D.' + strCmpDet;
      End;

      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + strCmpDet + strTipFc + ' = :CLIFOR AND ';
      strSQL := strSQL + strCmpDet + 'NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + strCmpDet + 'ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + strCmpDet + 'CODEMP = :CODEMP ';


      If ((Pos(arrEspecies[intIndiceEsp][0],'NE_NR_') > 0) And (Pos(strArqDet,'TINDET_') <= 0)) Or
          (arrEspecies[intIndiceEsp][0] = 'OF') Or
          (arrEspecies[intIndiceEsp][0] = 'EF') Then
      Begin

        If fEmptyStr(strSerie) Then
          strSQL := strSQL + '  AND ((' + strCmpDet + 'SERIE_ IS NULL) OR (' + strCmpDet + 'SERIE_ = "")) '
        Else
          strSQL := strSQL + '  AND (' + strCmpDet + 'SERIE_ = :SERIE_) ';

      End;

      If (blnVerificaOrigem) And (Pos(strArqDet,'TINDET_') <= 0) Then
      Begin

        If (Pos(arrEspecies[intIndiceEsp][0], 'NF_EL_NS_IF_IV_D1_OF_NC_IC_NP_EF_RL_DC_') > 0) Then
        Begin
          strSQL := strSQL + ' AND ' + strCmpDet + 'ORIDOC IN ("V","C") ';
        End
        Else If (arrEspecies[intIndiceEsp][0] = 'ND') Then
        Begin
          If Not blnConEqu Then
            strSQL := strSQL + ' AND ' + strCmpDet + 'ORIDOC = "D" '
          Else
            strSQL := strSQL + ' AND ' + strCmpDet + 'ORIDOC = ""  ';
        End
        Else If (arrEspecies[intIndiceEsp][0] = 'DL') Then
        Begin
          strSQL := strSQL + ' AND ' + strCmpDet + 'ORIDOC = ""  ';
        End
        Else
        Begin
          strSQL := strSQL + ' AND (' + strCmpDet + 'ORIDOC IS NULL OR ' + strCmpDet + 'ORIDOC = "") ';
        End;

      End;

      SetLength(arrProdAcabado, 0);

      With qryTemp01 Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CLIFOR').AsString := strCliFor;
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := VS_strCodEmp;

        If ( Not fEmptyStr(strSerie)               ) And
           ( (arrEspecies[intIndiceEsp][0] = 'NE') Or
             (arrEspecies[intIndiceEsp][0] = 'NR') Or
             (arrEspecies[intIndiceEsp][0] = 'EF') Or
             (arrEspecies[intIndiceEsp][0] = 'OF') ) And
           ( Pos(strArqDet,'TINDET_') <= 0 ) Then
          ParamByName('SERIE_').AsString := strSerie;

        Open;

        strLisSeqIndDup := '';
        If (Pos(strArqDet, 'MOVDET') > 0) Then
        Begin
          stlLisSeqIndDup := TStringList.Create;
          Try
            First;
            While (Not Eof) Do
            Begin
              If (FieldByName(strSigDet + 'IND_PD').AsInteger > 0) Then
              Begin
                strAuxLis := FieldByName(strSigDet + 'NUM_PD').AsString +
                             FieldByName(strSigDet + 'CODITE').AsString +
                             FieldByName(strSigDet + 'IND_PD').AsString;

                If (stlLisSeqIndDup.IndexOf(strAuxLis) <> -1) Then
                  pIncrementaListaStr(strAuxLis, strLisSeqIndDup);

                stlLisSeqIndDup.Add(strAuxLis);
              End;
              Next;
            End;
          Finally
            FreeAndNil(stlLisSeqIndDup);
            First;
          End;
        End;

        If (strEspDoc = 'TA') Then
        Begin
          If (fConsultarSaldoDisponivel(strSigDet, qryTemp01)) Then
          Begin
            Result := False;
            Exit;
          End;
        End;

        First;
        If (Not IsEmpty) Then
          blnDocumentoExiste := True;

        blnUsaConferenciaParcial := (fCfgSis('USACON', varBoolean)) And (fCfgSis('PERCPA', varBoolean));
        stlPedCom.Clear;
        stlPedComAux.Clear;
        strPedCom := '';
        strEmpCom := '';

        If (arrEspecies[intIndiceEsp][0] = 'NE') And (fCfgSis('FXRESS', varBoolean)) Then
          pRestauraFDO_RESERV(FieldByName('DET_SEQGER').AsString);

        While (Not Eof) Do
        Begin
          If fFalhaEmTransacao Then
            Exit(False);

          If (Pos(strArqDet, 'MOVDET_NOTDET_') > 0) Then
          Begin
            If (Pos(strEspDoc, 'NF_EL_NS_IF_IV_D1_NC_IC_DC_') > 0) And (Not fDocumentoFiscalFoiCanceladoNoAutom(qryTemp01, strDocFis)) Then
              Raise Exception.Create(Format('Falha ao cancelar o documento fiscal [%s].' + sLineBreak + 'Feche a tela e tente refazer a operação.', [strDocFis]));

            pGravaDeletadosTributacoes(FieldByName('AUTOINCREM').AsString, strArqDet);
            pGravaDeletadosMadeira(FieldByName('AUTOINCREM').AsString, strArqDet);
            pGravaDeletadosMovAux(FieldByName('AUTOINCREM').AsString, strArqDet);
            pGravaDeletadosMovIcd(FieldByName('AUTOINCREM').AsString, strArqDet);
            pGravaDeletadosDocImp(FieldByName('AUTOINCREM').AsString, strArqDet);
            pProcessaGarantia(FieldByName('AUTOINCREM').AsString, strArqDet);

            if ( strArqDet = 'MOVDET' ) And fUsaRotinaWMS and fConferenciaDepoisDaEntrada Then
            Begin
              If (Not fVerificaSeEhNotaDeDevolucaoPreNotaWMSeVoltaQuantidadesBaixadas(FieldByName('AUTOINCREM').AsString, blnWmsGerouPedidoDeEnderecamento)) Then
              Begin
                fRollback;
                Result := False;
                Exit;
              End;
            End;

          End;

          If (arrEspecies[intIndiceEsp][0] = 'NE') Then
          Begin
            blnDefBai := (strArqDet = 'MOVDET') And
                         TDefineBaixaPedido.fEstornaPedidoPorDefinicaoDeBaixa(FieldByName('AUTOINCREM').AsString, blnUsaConferenciaParcial, stlPedComAux);

            strPedCom := '';
            strEmpCom := '';

            If stlPedCom.Count = 0 Then
            Begin
              qryBuscaPedidosVinculadosANota:= fCriaQuery(Self);
              Try
                qryBuscaPedidosVinculadosANota.Close;
                qryBuscaPedidosVinculadosANota.SQL.CLear;
                qryBuscaPedidosVinculadosANota.SQL.Add('SELECT * FROM PCMGER ');
                If Not fEmptyStr(strCliFor) Then
                  qryBuscaPedidosVinculadosANota.SQL.Add(' INNER JOIN CADFOR ON FOR_CODFOR = PCG_CODFOR ');
                qryBuscaPedidosVinculadosANota.SQL.Add(' WHERE PCG_DOCEMI = "'+strNumDoc+'" AND ');
                qryBuscaPedidosVinculadosANota.SQL.Add('       PCG_ESPEMI = "'+strEspDoc+'" AND ');
                qryBuscaPedidosVinculadosANota.SQL.Add('       PCG_CODEMP = "'+fRetornaPCG_CODEMP+'" AND ');

                If Not fEmptyStr(strCliFor) Then
                Begin
                  qryBuscaPedidosVinculadosANota.SQL.Add('     ((PCG_CODFOR = ' + QuotedStr(strCliFor) + ') OR ' );
                  qryBuscaPedidosVinculadosANota.SQL.Add('     (FOR_C_G_C_ LIKE ' +
                   QuotedStr(LeftStr(fTiraCaracEspeciaisPonto(fCampoTabela('FOR_C_G_C_', 'CADFOR', ['FOR_CODFOR', 'FOR_CGCCPF'], [strCliFor, '1'])), 8) + '%') +  ')   )');
                End;

                qryBuscaPedidosVinculadosANota.Open;

                If qryBuscaPedidosVinculadosANota.RecordCount > 1 Then
                Begin

                  qryBuscaPedidosVinculadosANota.First;

                  while Not(qryBuscaPedidosVinculadosANota.eof) do
                  Begin
                    stlPedCom.Add(qryBuscaPedidosVinculadosANota.FieldByName('PCG_NUMPED').AsString +
                                  '-' + qryBuscaPedidosVinculadosANota.FieldByName('PCG_CODEMP').AsString);
                    qryBuscaPedidosVinculadosANota.Next;
                  End;

                End
                Else
                Begin
                  If FindField(strSigDet + 'PEDCOM') <> Nil Then
                  Begin
                    strPedCom := FieldByName(strSigDet + 'PEDCOM').AsString;
                    strEmpCom := FieldByName(strSigDet + 'EMPCOM').AsString;
                    stlPedCom.Add(strPedCom + '-' + strEmpCom);
                  End;
                End;
              Finally
                FreeAndNil(qryBuscaPedidosVinculadosANota);
              End
            End;

            If (Not blnDefBai) And (Not fEmptyStr(strPedCom)) Then
            Begin

              qryGen := fCriaQuery(Self);

              strSQL := '';
              strSQL := strSQL + 'UPDATE ';
              strSQL := strSQL + '  PCMDET ';
              strSQL := strSQL + 'SET ';

              strSQL := strSQL + '  PCD_VALFRE = PCD_VALFRE + (@FREUNI:=(PCD_FREBAI / PCD_QTDBAI))* 0, ';
              strSQL := strSQL + '  PCD_DESACE = PCD_DESACE + (@ACEUNI:=(PCD_ACEBAI / PCD_QTDBAI))* 0, ';
              strSQL := strSQL + '  PCD_TOTDAR = PCD_TOTDAR + (@DARUNI:=(PCD_TOTDAR / PCD_QTDITE))* 0, ';

              strSQL := strSQL + '  PCD_BAIXAD = 0, ';

              strQTDBAI := ' (:QTDBAI / IF(PCD_EMBALA IS NULL OR PCD_EMBALA = 0, 1, PCD_EMBALA)) ';

              If fCfgSis('CNVEMB') <> 'N' Then
                strSQL := strSQL + '  PCD_QTDBAI = IF(PCD_QTDBAI - ' + strQTDBAI + ' < 0, 0, PCD_QTDBAI - ' + strQTDBAI + '), '
              Else
                strSQL := strSQL + '  PCD_QTDBAI = IF(PCD_QTDBAI - :QTDBAI < 0, 0, PCD_QTDBAI - :QTDBAI), ';

              strSQL := strSQL + '  PCD_TOTBAI = (PCD_QTDBAI * (PCD_UNITAR * (1 - IFNULL(PCD_DESUNI, 0) / 100) ';
              strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN2, 0) / 100) ';
              strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN3, 0) / 100) ';
              strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN4, 0) / 100) ';
              strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN5, 0) / 100) ';
              strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN6, 0) / 100) ';
              strSQL := strSQL + '              )), ';

              strSQL := strSQL + '  PCD_FREBAI = ROUND(@FREUNI * PCD_QTDBAI, 2), ';
              strSQL := strSQL + '  PCD_ACEBAI = ROUND(@ACEUNI * PCD_QTDBAI, 2), ';

              strSQL := strSQL + '  PCD_VALFRE = ROUND(@FREUNI * (PCD_QTDITE - PCD_QTDBAI), 2), ';
              strSQL := strSQL + '  PCD_DESACE = ROUND(@ACEUNI * (PCD_QTDITE - PCD_QTDBAI), 2), ';

              strSQL := strSQL + '  PCD_IPIBAI = PCD_TOTBAI * (PCD_PERIPI / 100), ';
              strSQL := strSQL + '  PCD_SUBBAI = PCD_TOTBAI * (PCD_PERSUB / 100), ';
              strSQL := strSQL + '  PCD_FCPBAI = PCD_SUBBAI * (PCD_PERFCP / 100), ';

              strSQL := strSQL + '  PCD_DARBAI = ROUND(@DARUNI * PCD_QTDBAI, 2) ';

              If blnUsaConferenciaParcial Then
              Begin
                If fCfgSis('CNVEMB') <> 'N' Then
                  strSQL := strSQL + '  , PCD_QTDCON = IF(PCD_QTDCON + ' + strQTDBAI + ' >= PCD_QTDITE, PCD_QTDITE, PCD_QTDCON + ' + strQTDBAI + ') '
                Else
                  strSQL := strSQL + '  , PCD_QTDCON = IF(PCD_QTDCON + :QTDBAI >= PCD_QTDITE, PCD_QTDITE, PCD_QTDCON + :QTDBAI) ';
              End;

              strSQL := strSQL + 'WHERE ';
              strSQL := strSQL + '  PCD_ESPDOC = "PD"    AND ';
              strSQL := strSQL + '  PCD_NUMCTN = 0       AND ';
              strSQL := strSQL + '  PCD_NUMPED = :NUMPED AND ';
