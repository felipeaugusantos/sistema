Function TfrmCancelamentoDocumentos.fVerificaTAPendente(strNumDoc, strCodFor, strSerie, strEspSel: String; strEspBus: String=''; blnExcluir : boolean=False): Boolean;
  Var
    qryMovGer: TUniQuery;
    intIndiceEspBkp : Integer;
    strTipFCBkp: String;
Begin

  qryMovGer := fCriaQuery;
  Begin
    qryMovGer.SQL.Add(fGetSqlTAPendente(strNumDoc, IfThen((Pos(strEspSel, 'NF_CR_') > 0), strSerFsc, strSerie), strCodFor, VS_strCodEmp, strEspSel, strEspBus));
    qryMovGer.Open;

    result := qryMovGer.isEmpty;
    strTipFCBkp := '';

    if (not Result) then
    begin
      if blnExcluir then
      begin
        If Pos(strEspSel,'NE_NR_')> 0 Then
        Begin
          strTipFCBkp := strTipFC;
          strTipFC := 'CODCLI'
        End;

        intIndiceEspBkp := intIndiceEsp;
        try
          qryMovGer.First;
          while not qryMovGer.eof do
          begin
            If qryMovGer.fieldByName('GER_ESPDOC').AsString <> 'AJ' Then
              intIndiceEsp := fGetIndexByEspecie('TA')
            Else
              intIndiceEsp := fGetIndexByEspecie('AJ');

            Result := fCancelaItensDocumento(qryMovGer.fieldByName('GER_ESPDOC').AsString,
                                             qryMovGer.fieldByName('GER_NUMDOC').AsString,
                                             qryMovGer.fieldByName('GER_CODCLI').AsString);
            if not Result then
              break;

            qryMovGer.next;
          end;
        finally
          intIndiceEsp := intIndiceEspBkp;
          If strTipFCBkp <> '' Then
            strTipFC := strTipFCBkp;
        end;
      end
      else
      begin
        if fUsaRotinaWMS Or (strEspSel = 'NE') then
          if (Pos(strEspSel, 'XX_ND_NF_NE') > 0) Then
          Begin
            result := TfrmConfirmaCancelamentoTAsVinculadas.fMensagemDocumentos(qryMovGer.fieldByName('AUTOINCREM').AsString);
            If Result And (fGetIndexByEspecie('TA') = -1) Then
            Begin
              Result := False;
              fMensagemCancelamento('', 'Este documento contém TA para ser cancelada, porém o operador não tem acesso para prosseguir, a operação será cancelada.');
            End;
          End
          else
            fMensagemCancelamento('', 'O Documento já foi endereçado, não é possível cancelar esse documento!')
        else
        begin
          fMensagemCancelamento('', 'O documento de transferência ' + qryMovGer.FieldByName('DOCUME').AsString + #13#10 +
                      'cliente ' + qryMovGer.FieldByName('NOMCLI').AsString + #13#10 +
                  'está vinculado a essa nota e precisa ser cancelado antes!');
        end;
      end;
    end;

  End;
  FreeAndNil(qryMovGer);

End;

function TfrmCancelamentoDocumentos.fVerificaTemCTeVinculada(strDocumento, strEspecieSel, strTipFc, strCliente: string; var strNumCTe, strCodEmpCTE, strAcessoCTE, strSerieCTe: string): Boolean;
var
  qryAux: TUniQuery;
  strSQL: string;
  blnDifChvAcesso : Boolean;
begin
  if (strEspecieSel <> 'NF') or (not fCfgSis('UTICTE', varBoolean)) or (strTipFc <> 'CODCLI') then
    Exit(False);

  qryAux := fCriaQuery();
  try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CTE_NUMCTE, CTE_CODEMP, CTE_ACESSO, CTE_SERIE_ ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVGER ';
    strSQL := strSQL + '  JOIN MOVCTE ON MOVGER.AUTOINCREM = CTE_SEQGER ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '  AND GER_ESPDOC = "NF" ';
    strSQL := strSQL + '  AND GER_CODCLI = :CODCLI ';
    strSQL := strSQL + '  AND GER_CODEMP = :CODEMP ';

    qryAux.SQL.Add(strSQL);
    strSQL := AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');
    strSQL := AnsiReplaceStr(strSQL, 'MOVCTE', 'NOTCTE');
    qryAux.SQL.Add('UNION ALL ');
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('NUMDOC').AsString := strDocumento;
    qryAux.ParamByName('CODCLI').AsString := strCliente;
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.Open;

    Result := not qryAux.IsEmpty;

    if Result then
    begin
      strNumCTe    := qryAux.FieldByName('CTE_NUMCTE').AsString;
      strCodEmpCTE := qryAux.FieldByName('CTE_CODEMP').AsString;
      strAcessoCTE := qryAux.FieldByName('CTE_ACESSO').AsString;
      strSerieCTe  := qryAux.FieldByName('CTE_SERIE_').AsString;

      If fStatusNFe(strEspecieSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), blnDifChvAcesso) = 'DN' Then
      Begin
        Result := False;
        FEhNotaDenegadaComCTe := True;
      End;
    end;
  finally
    FreeAndNil(qryAux);
  end;
end;

function TfrmCancelamentoDocumentos.fBaixaOrdemProducaoAutomaticamente: Boolean;
var
  blnEmitirOrdemProdSubItensNoPedido: boolean;
begin
  blnEmitirOrdemProdSubItensNoPedido := fCfgSis('EMOPPD',varBoolean);

  If fCfgSis('USACCR', varBoolean) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
    blnEmitirOrdemProdSubItensNoPedido := False;

  If (fCfgSis('EFTEST') = '2') Then
    blnEmitirOrdemProdSubItensNoPedido := False;

  Result := (Not blnEmitirOrdemProdSubItensNoPedido) Or
            ((blnEmitirOrdemProdSubItensNoPedido) And (fCfgSis('BXOPAT', varBoolean)) And (fCfgSis('BXSBIT', varString) = '2'));
end;

