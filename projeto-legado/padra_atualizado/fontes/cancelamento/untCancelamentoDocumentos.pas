function TfrmCancelamentoDocumentos.fPermitidoCancelarDocumentoPDV(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
begin
  Result := False;
  If strEspSel <> 'IF' Then
  Begin
    pMensagemOk('Cancelamento em modo PDV. Só é permitido cancelar cupons.');
    Exit;
  End;

  If Not fPendentePDV(strNumDoc, strEspSel, strCodCli) Then
  Begin
    pMensagemOk('Cancelamento em modo PDV. Só é permitido cancelar cupons que estejam pendentes para cancelamento.');
    Exit;
  End;

  Result := True;
end;

function TfrmCancelamentoDocumentos.fPendentePDV(strNumDoc, strEspSel, strCodCli: String): Boolean;
  Var
    qryCancelamentos: TUniQuery;
begin
  qryCancelamentos := fCriaQuery(Self);
  qryCancelamentos.SQL.Clear;
  qryCancelamentos.SQL.Add('SELECT ');
  qryCancelamentos.SQL.Add('  COUNT(*) AS QTD ');
  qryCancelamentos.SQL.Add('FROM ');
  qryCancelamentos.SQL.Add('  PAF_CANCELAMENTOS ');
  qryCancelamentos.SQL.Add('  JOIN CADFIS ON REPLACE(FIS_NUMSER, "\0", "") = REPLACE(CAN_NUMSER, "\0", "") ');
  qryCancelamentos.SQL.Add('             AND LPAD(FIS_NUMCOO, 10, "0") = LPAD(CAN_NUMCOO, 10, "0") ');
  qryCancelamentos.SQL.Add('             AND FIS_CODEMP = CAN_CODEMP ');
  qryCancelamentos.SQL.Add('WHERE ');
  qryCancelamentos.SQL.Add('  CAN_CANCEL = 0 AND ');
  qryCancelamentos.SQL.Add('  FIS_NUMDOC = :NUMDOC AND ');
  qryCancelamentos.SQL.Add('  FIS_ESPDOC = :ESPDOC AND ');
  qryCancelamentos.SQL.Add('  FIS_CODEMP = :CODEMP AND ');
  qryCancelamentos.SQL.Add('  FIS_FORCLI = :FORCLI ');

  qryCancelamentos.ParamByName('NUMDOC').AsString := strNumDoc;
  qryCancelamentos.ParamByName('ESPDOC').AsString := strEspSel;
  qryCancelamentos.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryCancelamentos.ParamByName('FORCLI').AsString := STRcODcLI;
  qryCancelamentos.Open;

  Result := (qryCancelamentos.FieldByName('QTD').AsInteger > 0);

  FreeAndNil(qryCancelamentos);
end;

function TfrmCancelamentoDocumentos.fDocumentoDevolucao(strNumDoc, strEspDoc,
  strCodEmp, strCodCli, strSerie_: String): Boolean;
  Var
    qryAux: TUniQuery;
begin
  Result := False;

  Try
    qryAux := fCriaQuery(Self);

    Try
      qryAux.Close();
      qryAux.SQL.Clear();
      qryAux.SQL.Text := 'SELECT AUTOINCREM FROM MOVGER ' +
                          'WHERE GER_NUMDOC = :NUMDOC ' +
                          '  AND GER_ESPDOC = :ESPDOC ' +
                          '  AND GER_CODCLI = :CODCLI ' +
                          '  AND GER_CODEMP = :CODEMP ' +
                          '  AND GER_ORIDOC = :ORIDOC ' +
                          '  AND LOCATE(GER_CLAFIS, :CLADEV) > 0 ';

      If Not fEmptyStr(strSerie_) Then
        qryAux.SQL.Text := qryAux.SQL.Text + ' AND GER_SERIE_ = :SERIE_ ';

      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODCLI').AsString := strCodCli;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.ParamByName('ORIDOC').AsString := 'D';
      qryAux.ParamByName('CLADEV').AsString := VS_strClaDev;

      If Not fEmptyStr(strSerie_) Then
        qryAux.ParamByName('SERIE_').AsString := strSerie_;

      qryAux.Open;

      Result := (Not qryAux.IsEmpty);
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fDocumentoDevolucao]');
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

function TfrmCancelamentoDocumentos.fDocumentoGarantiaEnvioParaFornecedor(strEspSel, strNumDocSel, strCliForSel, strSerie: String): Boolean;
var qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);

  Try
    qryAux.SQl.Add('SELECT AUXMOV.AUX_OPCDOC');
    qryAux.SQl.Add('  FROM MOVGER');
    qryAux.SQl.Add(' INNER JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM');
    qryAux.SQl.Add(' WHERE GER_NUMDOC = :NUMDOC');
    qryAux.SQl.Add('   AND GER_CODEMP = "' + VS_StrCodEMP + '"');
    qryAux.SQl.Add('   AND GER_CODFOR = :CODFOR');
    qryAux.SQl.Add('   AND GER_ESPDOC = :ESPDOC');
    qryAux.SQl.Add('   AND GER_SERIE_ = :SERIE_');

    qryAux.ParamByName('NUMDOC').AsString := strNumDocSel;
    qryAux.ParamByName('CODFOR').AsString := strCliForSel;
    qryAux.ParamByName('ESPDOC').AsString := strEspSel;
    qryAux.ParamByName('SERIE_').AsString := strSerie;

    qryAux.Open;

    Result := qryAux.FieldByName('AUX_OPCDOC').AsString = 'NG';
  Finally
    FreeAndNil(qryAux);

  End;

end;

function TfrmCancelamentoDocumentos.fDocumentoGarantiaRetornoDoFornecedor(
  strEspSel, strNumDocSel, strCliForSel, strSerie: String; strCodEmp: String = ''): Boolean;
  var
    qryAux: TUniQuery;
    lstrCodEmp: String;

    strSQL: String;
    blnFiltrarSerie, blnEspDoc: Boolean;
begin
  if fEmptyStr(strCodEmp) then
    lstrCodEmp := VS_StrCodEMP
  else
    lstrCodEmp := strCodEmp;

  blnFiltrarSerie := Not fEmptyStr(strSerie);
  blnEspDoc := Not fEmptyStr(strEspSel);


  strSQL := EmptyStr;
  strSQL := strSQL + ' SELECT D.DET_CODEMP, D.DET_ESPDOC, D.DET_SERIE_, D.DET_CODFOR , D.DET_NUMDOC ';
  strSQL := strSQL + ' FROM MOVDET D ';
  strSQL := strSQL + ' JOIN MOVGAU U ON U.GAU_SEQDET = D.AUTOINCREM ';
  strSQL := strSQL + ' WHERE D.DET_CODEMP = :CODEMP ';
  strSQL := strSQL + '       AND D.DET_CODFOR = :CODFOR ';
  strSQL := strSQL + '       AND D.DET_NUMDOC = :NUMDOC ';

  if blnFiltrarSerie then
    strSQL := strSQL + '       AND D.DET_SERIE_ = :SERIE_ ';

  if blnEspDoc then
    strSQL := strSQL + '       AND D.DET_ESPDOC = :ESPDOC '
  else
    strSQL := strSQL + '       AND D.DET_ESPDOC in ("NF","GR") ';

  strSQL := strSQL + ' ORDER BY D.DET_CODEMP, D.DET_ESPDOC, D.DET_SERIE_, D.DET_CODFOR , D.DET_NUMDOC ';

  qryAux := fCriaQuery(Self);

  Try
    qryAux.Close;
    qryAux.Sql.Clear;
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('CODEMP').AsString := lstrCodEmp;
    qryAux.ParamByName('NUMDOC').AsString := strNumDocSel;
    qryAux.ParamByName('CODFOR').AsString := strCliForSel;

    if blnEspDoc then
      qryAux.ParamByName('ESPDOC').AsString := strEspSel;

    if blnFiltrarSerie then
      qryAux.ParamByName('SERIE_').AsString := strSerie;
    qryAux.Open;

    Result := Not QryAux.IsEmpty;
  Finally
    if Assigned(QryAux) Then
      FreeAndNil(qryAux);
  End;
end;

function TfrmCancelamentoDocumentos.fDocumentoOutrasSaidasFornecedor(strEspSel, strNumDocSel, strCliForSel, strSerie: String): Boolean;
var qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);

  Try
    qryAux.SQl.Add('SELECT AUXMOV.AUX_OPCDOC');
    qryAux.SQl.Add('  FROM MOVGER');
    qryAux.SQl.Add(' INNER JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM');
    qryAux.SQl.Add(' WHERE GER_NUMDOC = :NUMDOC');
    qryAux.SQl.Add('   AND GER_CODEMP = "' + VS_StrCodEMP + '"');
    qryAux.SQl.Add('   AND GER_CODFOR = :CODFOR');
    qryAux.SQl.Add('   AND GER_ESPDOC = :ESPDOC');
    qryAux.SQl.Add('   AND GER_SERIE_ = :SERIE_');

    qryAux.ParamByName('NUMDOC').AsString := strNumDocSel;
    qryAux.ParamByName('CODFOR').AsString := strCliForSel;
    qryAux.ParamByName('ESPDOC').AsString := strEspSel;
    qryAux.ParamByName('SERIE_').AsString := strSerie;

    qryAux.Open;

    Result := qryAux.FieldByName('AUX_OPCDOC').AsString = 'OF';
  Finally
    FreeAndNil(qryAux);

  End;

end;


function TfrmCancelamentoDocumentos.fDocumentoPendenteNoPainelNFe(strEspDoc, strTip_Fc: String): Boolean;
  Var
    qryAux: TUniQuery;
    strSerie: String;
begin
  Result := False;

  If (fCfgSis('NFEUSA', varBoolean)) And (fCfgSis('PNLNFE', varBoolean)) Then
  Begin

    If (Pos(strEspDoc, 'NS_NF_EL_OF_NI_NC_IC_NG_EF_DC_') > 0) Then
    Begin

      If (edtSerie.Visible) Then
        strSerie := edtSerie.Text
      Else
        strSerie := strSerFsc;

      qryAux := fCriaQuery(Self);
      qryAux.SQL.Add('SELECT ');
      qryAux.SQL.Add('  NFE_STATUS ');
      qryAux.SQL.Add('FROM ');
      qryAux.SQL.Add('  LOGNFE ');
      qryAux.SQL.Add('WHERE ');
      qryAux.SQL.Add('  NFE_NUMDOC = :NUMDOC AND ');

      If (strEspDoc = 'NS') Then
        qryAux.SQL.Add('  NFE_ESPDOC = "NS" AND ')
      Else
        qryAux.SQL.Add('  (NFE_ESPDOC = "NF" OR NFE_ESPDOC = "IF" OR NFE_ESPDOC = "EL") AND ');

      qryAux.SQL.Add('  NFE_CODEMP = :CODEMP AND ');
      qryAux.SQL.Add('  NFE_CODCLI = :CODCLI AND ');
      qryAux.SQL.Add('  IFNULL(NFE_SERIE_, "") = :SERIE_ AND ');
      qryAux.SQL.Add('  NFE_TIP_FC = :TIP_FC');

      qryAux.ParamByName('NUMDOC').AsString := edtNumDoc.Text;
      qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryAux.ParamByName('CODCLI').AsString := edtCliFor.Text;
      qryAux.ParamByName('SERIE_').AsString := strSerie;
      qryAux.ParamByName('TIP_FC').AsString := strTip_Fc;
      qryAux.Open;

      Result := (Pos(qryAux.FieldByName('NFE_STATUS').AsString, 'GE_GC_') > 0);

      If Result Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'O documento selecionado está pendente no painel. ' +
          'Favor verificar.', ['&Ok']);
      End;

      FreeAndNil(qryAux);

    End;
  End;
end;

function TfrmCancelamentoDocumentos.fDocumentoROExiste(strCodEmp, strNumDoc,
  strCodCli: String): Boolean;
begin
  Try
    objROTinta := TCancelamentoROTintadeMaquina.Create(Self, strCodEmp,
      strNumDoc, strCodCli);

    Result := objROTinta.fDocumentoROExiste;
    If Result Then
      Result := objROTinta.fClientFilialExiste;
    If Result Then
      Result := objROTinta.fDocumentoTEExiste;
    If Result Then
      Result := objROTinta.fDocumentoROProAcaPreenchido;
  Finally
    FreeAndNil(objROTinta);
  End;
end;

function TfrmCancelamentoDocumentos.fSerieFiscal(strEspSel: string): string;
begin
  If (strEspSel = 'NS') Then
    Result := fCfgSis('SERNFS')
  Else If ((strEspSel = 'IF') And (fCfgSis('USNFCE', varBoolean) Or fUsaSat)) Then
    Result := fCfgSis('SERNFC')
  Else
    Result := fCfgSis('SERFSC');
end;

function TfrmCancelamentoDocumentos.fStatusNFe(const strEspDoc, strTip_Fc: String; Var blnDifChvAcesso : Boolean): String;
  Var
    qryAux: TUniQuery;
    strSerie: String;
    strEspecies: String;
begin
  Result := '';
  blnDifChvAcesso := False;
  strEspecies := 'NF_EL_OF_NI_NC_IC_NG_EF_DC_';
  If (fCfgSis('USNFCE', varString) = 'S') Or fUsaSat Then
  Begin
    strEspecies := strEspecies + 'IF_';
  End;

  If (Pos(strEspDoc, strEspecies) > 0) Then
  Begin

    If (edtSerie.Visible) Then
      strSerie := edtSerie.Text
    Else
      strSerie := strSerFsc;

    qryAux := fCriaQuery(Self);
    Try
      qryAux.SQL.Add(' SELECT NFE_STATUS, NFE_OBSERV ');
      qryAux.SQL.Add('   FROM LOGNFE ');
      qryAux.SQL.Add('  WHERE NFE_NUMDOC = :NUMDOC AND ');

      If strEspDoc <> 'IF' Then
      Begin
        qryAux.SQL.Add('  (NFE_ESPDOC = "NF" OR NFE_ESPDOC = "EL") AND ');
      End
      Else
      Begin
        qryAux.SQL.Add('  NFE_ESPDOC = "IF" AND ');
      End;

      qryAux.SQL.Add('  NFE_CODEMP = :CODEMP AND ');
      qryAux.SQL.Add('  NFE_CODCLI = :CODCLI AND ');
      qryAux.SQL.Add('  IFNULL(NFE_SERIE_, "") = :SERIE_ AND ');
      qryAux.SQL.Add('  NFE_TIP_FC = :TIP_FC');

      qryAux.ParamByName('NUMDOC').AsString := edtNumDoc.Text;
      qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryAux.ParamByName('CODCLI').AsString := edtCliFor.Text;
      qryAux.ParamByName('SERIE_').AsString := strSerie;
      qryAux.ParamByName('TIP_FC').AsString := strTip_Fc;
      qryAux.Open;

      Result := qryAux.FieldByName('NFE_STATUS').AsString;

      If (strEspDoc = 'NF') Or ((strEspDoc = 'IF') And ((fCfgSis('USNFCE', varString) = 'S'))) Then
        blnDifChvAcesso := fEhRejeicaoPorDuplicidadeComDiferencaNaChaveDeAcesso(qryAux.FieldByName('NFE_OBSERV').AsString);
    Finally
      FreeAndNil(qryAux);
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fEhRejeicaoPorDuplicidadeComDiferencaNaChaveDeAcesso(const strTextoErro : String) : Boolean;
begin
  Result := True;
  If (AnsiUpperCase(strTextoErro).Contains('STATUS: 539')) Then
    Exit;
  If (AnsiUpperCase(strTextoErro).Contains('DUPLICIDADE DE NF-E COM DIFERENCA NA CHAVE DE ACESSO')) Then
    Exit;
  If (AnsiUpperCase(strTextoErro).Contains('DUPLICIDADE DE NFC-E COM DIFERENCA NA CHAVE DE ACESSO')) Then
    Exit;
  Result := False;
end;

{**********************************************}
{* FUNÇÃO QUE VERIFICA SE A DIFERENÇA DE DIAS *}
{* DA DATA DE EMISSÃO DA NOTA E A DATA ATUAL  *}
{* É MAIOR MAIOR OU IGUAL AO NÚMERO DE DIAS   *}
{* CONFIGURADOS PARA PERMITIR O CANCELAMENTO  *}
{*******************************************RL*}
function TfrmCancelamentoDocumentos.fVerificarDiasCancelamento(strNumDoc, strEspSel,
 strTipFc, strCliFor: String; blnNotaEletronica: Boolean; var dtaDtaNota: TDateTime; var strCfgDesc: String): Boolean;
  Var
    strSQL    : String;
    intMaxHoras: Integer;

    function fRetornaDataHoraNota(strTabela: String): TDateTime;
    Var
      qryTmpAux: TUniQuery;
    Begin
      Try
        qryTmpAux := fCriaQuery;

        Result := -1;

        If (Pos(strEspSel, 'OF_EF_') > 0) Then
          strEspSel := 'NF';
        If  strEspSel = 'AJ' Then
        begin
           strSQL := strSQL + 'SELECT ';
           strSQL := strSQL + '  GER_DTAENT,  ';
           strSQL := strSQL + '  GER_HORENT  ';
           strSQL := strSQL + 'FROM ';
           strSQL := strSQL + '  MOVGER ';
           strSQL := strSQL + 'WHERE ';
           strSQL := strSQL + '  GER_NUMFAT = :NUMFAT AND ';
           strSQL := strSQL + '  GER_TIPFAT = :TIPFAT AND ';
           strSQL := strSQL + '  GER_EMPFAT = :CODEMP AND ';
           strSQL := strSQL + '  GER_ESPDOC IN ("ML") ';
           With qryTmpAux Do
           Begin
             Close;
             SQL.Clear;
             SQL.Add(strSQL);
             ParamByName('NUMFAT').AsString := strNumDoc;
             ParamByName('TIPFAT').AsString := strEspSel;
             ParamByName('CODEMP').AsString := VS_strCodEmp;

             Open;

             If (Not IsEmpty) Then
             begin
               Result := FieldByName('GER_DTAENT').AsDateTime + FieldByName('GER_HORENT').AsDateTime;
               Exit;
             End
           End;
        End;

        strSQL := '';
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  GER_DTAENT, ';
        strSQL := strSQL + '  GER_HORENT ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL +    strTabela + ' ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  GER_' + strTipFc + '  = :CLIFOR AND ';
        strSQL := strSQL + '  GER_CODEMP = :CODEMP';

        With qryTmpAux Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);

          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspSel;
          ParamByName('CLIFOR').AsString := strCliFor;
          ParamByName('CODEMP').AsString := VS_strCodEmp;

          Open;

          If (Not IsEmpty) Then
            Result := FieldByName('GER_DTAENT').AsDateTime + FieldByName('GER_HORENT').AsDateTime;

        End;

      Finally
        FreeAndNil(qryTmpAux);
      End;
    End;

Begin
  dtaDtaNota := fRetornaDataHoraNota('MOVGER');

  If (dtaDtaNota = -1) Then
    dtaDtaNota := fRetornaDataHoraNota('NOTGER');

  If fCfgSis('NFEUSA', varBoolean) And blnNotaEletronica Then
  Begin
    intMaxHoras := fCfgSis('MAXNFE', varInteger) * 24;
    strCfgDesc := IntToStr(intMaxHoras) + ' Hora(s). (CFG_MAXNFE)';
    Result:= (HoursBetween(VS_Date + fTime(), dtaDtaNota) <= intMaxHoras) Or (dtaDtaNota = -1);
  End
  Else
  Begin
    Result := (DaysBetween(VS_Date + fTime(), dtaDtaNota) <= fCfgSis('CANDOC', varInteger)) Or (dtaDtaNota = -1);
    strCfgDesc := IntToStr(fCfgSis('CANDOC', varInteger)) + ' Dia(s). (CFG_CANDOC)';
  End;
End;

function TfrmCancelamentoDocumentos.fVerificarDevolucoes(const strNumDoc, strEspSel, strCliFor : String): Boolean;
  Var
    strTabela: String;
    strDocumentos: String;
    qryAux: TUniQuery;
    strSigForCli : String;
begin
  If (strDocumentoJaConstaComoCanceladoNaSefaz = 'S') Then
    Exit(True);
  qryAux        := fCriaQuery(Self);
  Try
    strTabela     := 'MOVDET';
    strDocumentos := '';

    If edtTipPes.Visible Then
      strSigForCli := edtTipPes.Text
    Else
      strSigForCli := 'C';

    With qryAux Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add('SELECT DISTINCT            ');
      SQL.Add('  DET_NUMDOC,              ');
      SQL.Add('  DET_ESPDOC,              ');
      SQL.Add('  DET_CODEMP               ');
      SQL.Add('FROM                       ');
      SQL.Add(  strTabela                  );
      SQL.Add('WHERE                      ');
      SQL.Add('  DET_DOCDEV = :NUMDOC AND ');
      SQL.Add('  DET_ESPDEV = :ESPDOC AND ');
      SQL.Add('  DET_EMPDEV = :CODEMP AND ');
      SQL.Add('  DET_' + strTipFc + ' = :CODCLI AND ');
      SQL.Add('  DET_TIP_FC = :TIP_FC AND   ');
      SQL.Add('  DET_NUMDOC <> DET_DOCDEV');

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('TIP_FC').AsString := strSigForCli;
      Open;

      While (Not Eof) Do
      Begin

        strDocumentos := strDocumentos + FieldByName('DET_NUMDOC').AsString + '-' +
                                         FieldByName('DET_ESPDOC').AsString + '-' +
                                         FieldByName('DET_CODEMP').AsString + #13#10;

        Next;
      End;

      Close;

    End;
  Finally
    FreeAndNil(qryAux);
  End;

  Result := True;
  If (Not fEmptyStr(strDocumentos)) Then
  Begin
    If (fDocumentoJaConstaComoCanceladoNaSefaz(strNumDoc, strEspSel, VS_strCodEmp, strCliFor, strSigForCli)) Then
      Exit;
    Result := False;
    Try
      pCriarFormularios(TfrmCancelamentoDocResumo, frmCancelamentoDocResumo);
      frmCancelamentoDocResumo.memResumo.Lines.Add('Este documento não pode ser cancelado pois existem');
      frmCancelamentoDocResumo.memResumo.Lines.Add('as seguintes devoluções: ');
      frmCancelamentoDocResumo.memResumo.Lines.Add('');
      frmCancelamentoDocResumo.memResumo.Lines.Add(strDocumentos);
      If (FExecutandoCanceladorAutomatico) Then
        pMensagemOK(frmCancelamentoDocResumo.memResumo.Lines.Text)
      Else If CancelandoNFViaFulFillment Then
        objFulFillmentLogBuilder.pSalvarLog(frmCancelamentoDocResumo.memResumo.Lines.Text, True)
      Else
        frmCancelamentoDocResumo.ShowModal;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[frmCancelamentoDocumentos.fVerificarDevolucoes]');
      End;
    End;

    pFreeAndNil(frmCancelamentoDocResumo);

  End;

end;

