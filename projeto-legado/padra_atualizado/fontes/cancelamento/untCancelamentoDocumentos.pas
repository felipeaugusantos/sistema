procedure TfrmCancelamentoDocumentos.pLimparUltimaCompraDocumento(strNumDoc, strEspDoc, strCodCli: String);
  Var
    qryUltCmp : TUniQuery;
    strDocume : String;
begin
  qryUltCmp := fCriaQuery(Self);
  Try
    strDocume := strNumDoc + '-' + strEspDoc;

    With qryUltCmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT * ');
      SQL.Add('   FROM CADCLI ');
      SQL.Add('  WHERE CLI_CODCLI = :CODCLI ');
      SQL.Add('    AND (CLI_DOUCOM = :NUMDOC OR CLI_DOMCOM = :NUMDOC) ');
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('NUMDOC').AsString := strDocume;
      Open;

      If (Not IsEmpty) Then
      Begin
        Edit;
        If (FieldByName('CLI_DOUCOM').AsString = strDocume) Then
        Begin
          FieldByName('CLI_ULTCOM').Value := Null;
          FieldByName('CLI_DOUCOM').Value := Null;
          FieldByName('CLI_VRUCOM').Value := Null;
        End;
        If (FieldByName('CLI_DOMCOM').AsString = strDocume) Then
        Begin
          FieldByName('CLI_DTMCOM').Value := Null;
          FieldByName('CLI_DOMCOM').Value := Null;
          FieldByName('CLI_VRMCOM').Value := Null;
        End;
        Post;
        blnLimpouUltimaCompra := True;
      End;

      Close;
    End;
  Finally
    FreeAndNil(qryUltCmp);
  End;
end;

procedure TfrmCancelamentoDocumentos.pMensagemCancelamentoPedido(strNumDoc, strEspDoc, strCodEmp : String);
Var
  msgMensagem : TMsgInterna;
  qryCadOpe,
  qryFatGor   : TUniQuery;
  stlMensagem : TStringList;
Begin

  if strEspDoc <> 'PD' then
    Exit;

  try

    qryCadOpe := fCriaQuery;
    qryFatGor := fCriaQuery;

    qryCadOpe.Close;
    qryCadOpe.SQL.Clear;
    qryCadOpe.SQL.Add('SELECT');
    qryCadOpe.SQL.Add('  OPE_CODOPE AS CODOPE');
    qryCadOpe.SQL.Add('FROM');
    qryCadOpe.SQL.Add('  CADOPE');
    qryCadOpe.SQL.Add('WHERE');

    {Somente para operadores que tenham direitos de acesso a empresa}
    qryCadOpe.SQL.Add('  LOCATE(:CODEMP, OPE_EMPACE) > 0 AND ');
    qryCadOpe.SQL.Add('  OPE_MSGPCA = "S"');

    qryCadOpe.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryCadOpe.Open;

    if not qryCadOpe.IsEmpty Then
    begin

      {Busca informações do pedido}
      qryFatGor.Close;
      qryFatGor.SQL.Clear;
      qryFatGor.SQL.Add('SELECT');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODCLI,');
      qryFatGor.SQL.Add('  CADCLI.CLI_NOMCLI,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODVEN,');
      qryFatGor.SQL.Add('  CADOPE.OPE_NOMOPE,');
      qryFatGor.SQL.Add('  FATGOR.FGO_NUMDOC,');
      qryFatGor.SQL.Add('  FATGOR.FGO_DTAENT,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CONPAG,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODCND,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODFPG,');
      qryFatGor.SQL.Add('  FATGOR.FGO_VLRCON');
      qryFatGor.SQL.Add('FROM');
      qryFatGor.SQL.Add('  FATGOR');
      qryFatGor.SQL.Add('  INNER JOIN CADCLI ON (CADCLI.CLI_CODCLI = FATGOR.FGO_CODCLI)');
      qryFatGor.SQL.Add('  INNER JOIN CADOPE ON (CADOPE.OPE_CODOPE = FATGOR.FGO_CODVEN)');
      qryFatGor.SQL.Add('WHERE');
      qryFatGor.SQL.Add('  FATGOR.FGO_NUMDOC = :NUMDOC AND');
      qryFatGor.SQL.Add('  FATGOR.FGO_ESPDOC = :ESPDOC AND');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODEMP = :CODEMP');

      qryFatGor.ParamByName('NUMDOC').AsString := strNumDoc;
      qryFatGor.ParamByName('ESPDOC').AsString := strEspDoc;
      qryFatGor.ParamByName('CODEMP').AsString := strCodEmp;
      qryFatGor.Open;

      if not qryFatGor.IsEmpty then
      begin

        msgMensagem := TMsgInterna.Create(Self);
        stlMensagem := TStringList.Create;
        stlMensagem.Clear;

        stlMensagem.Add('CANCELAMENTO: ' + DateToStr(untFuncoesSimples.VS_Date));
        stlMensagem.Add('DOCUMENTO: ' + strNumDoc + '-' + strEspDoc + '-' + strCodEmp);
        stlMensagem.Add('CLIENTE: ' + qryFatGor.FieldByName('FGO_CODCLI').AsString + '-' + qryFatGor.FieldByName('CLI_NOMCLI').AsString);

        if fCfgSis('USACND', varBoolean) then
        begin
          stlMensagem.Add('CONDIÇÃO DE PAGAMENTO: ' + qryFatGor.FieldByName('FGO_CODCND').AsString + '-' + fRetDesConPag(qryFatGor.FieldByName('FGO_CODCND').AsString));
          stlMensagem.Add('                       (' + qryFatGor.FieldByName('FGO_CODCND').AsString + ')' + fFormataCondPag(qryFatGor.FieldByName('FGO_CONPAG').AsString));
        end
        else
        begin
          stlMensagem.Add('CONDIÇÃO DE PAGAMENTO: (' + qryFatGor.FieldByName('FGO_CODCND').AsString + ')' + fFormataCondPag(qryFatGor.FieldByName('FGO_CONPAG').AsString));
        end;

        stlMensagem.Add('VENDEDOR: ' + qryFatGor.FieldByName('FGO_CODVEN').AsString + '-' + qryFatGor.FieldByName('OPE_NOMOPE').AsString);
        stlMensagem.Add('TOTAL DO DOCUMENTO: ' + FormatFloat('###,#0.00', qryFatGor.FieldByName('FGO_VLRCON').AsFloat));

        qryCadOpe.First;
        While Not qryCadOpe.Eof Do
        Begin
          msgMensagem.fEnviaMensagem('PEDIDO CANCELADO: ' + strNumDoc,
                                     stlMensagem.Text,
                                     qryFatGor.FieldByName('FGO_CODVEN').AsString,
                                     qryCadOpe.FieldByName('CODOPE').AsString,
                                     'N',
                                     '');
          qryCadOpe.Next;
        End;

        FreeAndNil(msgMensagem);
        FreeAndNil(stlMensagem);

      end;

    end;

  finally
    FreeAndNil(qryCadOpe);
    FreeAndNil(qryFatGor);
  end;

End;

function TfrmCancelamentoDocumentos.fAcertaEspecieNfe(
  strEspSel: String): String;
begin
  Result := strEspSel;

  If Pos(strEspSel, 'NC_OF_NW_NG_EF_NI_DC_') > 0 Then
    Result := 'NF';

  If (strEspSel = 'IC') Then
    Result := 'IF';
end;

function TfrmCancelamentoDocumentos.fApagaDocumentoRomaneio(strNumDoc,
  strEspDoc, strCodCli: String): Boolean;
  Var
    strSQL   : String;
    qryGenGer: TUniQuery;

begin
  Try

    qryGenGer := fCriaQuery(Self);

    Try

      strSQL := '';
      strSQL := strSQL + 'DELETE FROM ';
      strSQL := strSQL + '  ROMGERX ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  GER_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '  GER_CODEMP = :CODEMP ';

      With qryGenGer Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        ExecSQL;
        Close;
      End;

      Result := True;
    Except
      On E: Exception Do
      Begin
        fRollBack;
        pMensagensErro(E.Message, '[fApagaDocumentoRomaneio]');
        Result := False;
      End;
    End;

  Finally
    FreeAndNil(qryGenGer);
  End;

end;

function TfrmCancelamentoDocumentos.fDesfaturaDocumentoRomaneio(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    strSQL : String;
    qryGen : TUniQuery;
begin
  qryGen := fCriaQuery(Nil);
  Try
    Try
      strSQL := '';
      strSQL := strSQL + 'UPDATE ';
      strSQL := strSQL + '  ROMGERX ';
      strSQL := strSQL + 'SET ';
      strSQL := strSQL + '  GER_DTAFAT = NULL, ';
      strSQL := strSQL + '  GER_NUMFAT = NULL, ';
      strSQL := strSQL + '  GER_TIPFAT = NULL, ';
      strSQL := strSQL + '  GER_VENFAT = NULL, ';
      strSQL := strSQL + '  GER_CNDFAT = NULL, ';
      strSQL := strSQL + '  GER_EMPFAT = NULL, ';
      strSQL := strSQL + '  GER_JAFATU = 0 ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  GER_NUMFAT = :NUMFAT AND ';
      strSQL := strSQL + '  GER_TIPFAT = :TIPFAT AND ';
      strSQL := strSQL + '  GER_EMPFAT = :EMPFAT     ';

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('EMPFAT').AsString := strCodEmp;
        ExecSQL;
        Close;
      End;

      strSQL := AnsiReplaceStr(strSQL, 'GER_','DET_');
      strSQL := AnsiReplaceStr(strSQL, 'ROMGERX','ROMDETX');

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('EMPFAT').AsString := strCodEmp;
        ExecSQL;
        Close;
      End;

      Result := True;
    Except
      On E: Exception Do
      Begin
        fRollBack;
        pMensagensErro(E.Message, '[fDesfaturaDocumentoRomaneio]');
        Result := False;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End
end;

function TfrmCancelamentoDocumentos.fRetornaNumCCR(strNumDoc, strCodCli : String) : String;
Var
  qryGen : TUniQuery;
Begin
  qryGen := fCriaQuery(Self);

  With qryGen Do
  Begin
    SQL.Clear;
    SQL.Add('SELECT ');
    SQL.Add('  GAG_NUMCCR ');
    SQL.Add('FROM ');
    SQL.Add('  MOVGAG ');
    SQL.Add('WHERE ');
    SQL.Add('  GAG_NUMENT = :NUMDOC AND ');
    SQL.Add('  GAG_CODCLI = :CODCLI AND ');
    SQL.Add('  GAG_CODEMP = :CODEMP  ');
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;

    Result := FieldByName('GAG_NUMCCR').AsString;
  End;

  FreeAndNil(qryGen);
End;

function TfrmCancelamentoDocumentos.fApagaGarantia(strNumDoc,
  strCodCli, strEspSel: String): Boolean;
  Var
    strSQL   : String;
    strNumDup: String;
    qryGenGer: TUniQuery;

    qrySeqGar,
    qryFatGor,
    qryFatDor,
    qryMovGer,
    qryMovDet,
    qryMovTri,
    qryMovRef,
    qryMovGag,
    qryMovGad,
    qryMovGrc,
    qryAuxMov,
    qryMovObs: TUniQuery;
    strAutIncMovGer: String;
    strAutIncCadFis: String;
    blnOriundoDeColeta : Boolean;
begin
  Try

    qryGenGer := fCriaQuery(Self);

    If VS_strHabilitarCRM And fCfgSis('UTI_AD', varBoolean) Then
    Begin
      With qryGenGer, SQL Do
      Begin
        try
          Close;
          Clear;

          Add(' UPDATE ADEGER SET GER_DOCDEV = NULL, ');
          Add('                   GER_ESPDEV = NULL, ');
          Add('                   GER_EMPDEV = NULL  ');
          Add(' WHERE GER_DOCDEV = :DOCDEV           ');
          Add('   AND GER_ESPDEV = :ESPDEV           ');
          Add('   AND GER_EMPDEV = :EMPDEV           ');

          ParamByName('DOCDEV').AsString := edtNumDoc.Text;
          ParamByName('ESPDEV').AsString := IfThen(strEspSel='GA', 'GA', 'NF');
          ParamByName('EMPDEV').AsString := VS_strCodEmp;

          ExecSQL;

        Finally
          Close;
          Clear;
        End;

      End;

    End;

    {**************************************************}
    {* CASO A GARANTIA TENHA GERADO UM CRÉDITO        *}
    {* PARA O CLIENTE, O SISTEMA APAGARÁ ESTE CRÉDITO *}
    {**************************************************}
    strNumDup := fRetornaNumCCR(strNumDoc,strCodCli);

    If Not fEmptyStr(strNumDup) Then
    Begin
      If Not (fCancelaContasReceber('CC',strNumDup,strCodCli,VS_strCodEmp)) Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    Try
      {*************************************************************************************}
      {* AQUI IRÁ APAGAR TODAS AS REFERENCIAS DA NOTA DE GARANTIA (RECEBIMENTO DE CLIENTE) *}
      {***********************************************************************************FC}
      If Pos(strEspSel, 'NW_GA_') > 0 Then
      Begin
        strAutIncMovGer := '';

        qryMovGer := fCriaQuery(Self);
        qryMovDet := fCriaQuery(Self);
        qryMovTri := fCriaQuery(Self);
        qryMovRef := fCriaQuery(Self);
        qryMovGag := fCriaQuery(Self);
        qryMovGad := fCriaQuery(Self);
        qryMovGrc := fCriaQuery(Self);
        qryAuxMov := fCriaQuery(Self);
        qryMovObs := fCriaQuery(Self);
        qrySeqGar := fCriaQuery(Self);
        qryFatGor := fCriaQuery(Self);
        qryFatDor := fCriaQuery(Self);


        {*****************}
        {* TABELA MOVGAG *}
        {***************FC}
        With qryMovGag Do
        Begin
          Close;
          SQL.Clear;

          SQL.Add('SELECT MOVGAG.AUTOINCREM FROM MOVGAG');
          SQL.Add('INNER JOIN MOVGCG ON  GCG_SEQGAG = MOVGAG.AUTOINCREM ');
          SQL.Add('WHERE GAG_NUMENT = :NUMENT AND');
          SQL.Add('      GAG_CODCLI = :CODCLI AND ');
          SQL.Add('      GAG_CODEMP = :CODEMP');

          ParamByName('NUMENT').AsString := strNumDoc;
          ParamByName('CODCLI').AsString := strCodCli;
          ParamByName('CODEMP').AsString := VS_strCodEmp;

          Open;

          blnOriundoDeColeta:= Not qryMovGag.IsEmpty;

          SQL.Clear;
          SQL.Add('SELECT * FROM MOVGAG');
          SQL.Add('WHERE GAG_NUMENT = :NUMENT AND');
          SQL.Add('      GAG_CODCLI = :CODCLI AND ');
          SQL.Add('      GAG_CODEMP = :CODEMP');

          ParamByName('NUMENT').AsString := strNumDoc;
          ParamByName('CODCLI').AsString := strCodCli;
          ParamByName('CODEMP').AsString := VS_strCodEmp;

          Open;

          {CASO NÃO ENCONTRA A GARANTIA, TENTA PESQUISAR PELO CÓDIGO DO FAVORECIDO
           REQ.: 210258}
          If qryMovGag.IsEmpty Then
          Begin
            Close;
            SQL.Clear;
            SQL.Add('SELECT * FROM MOVGAG');
            SQL.Add('WHERE GAG_NUMENT = :NUMENT AND');
            SQL.Add('      GAG_CODFAV = :CODFAV AND ');
            SQL.Add('      GAG_CODEMP = :CODEMP');

            ParamByName('NUMENT').AsString := strNumDoc;
            ParamByName('CODFAV').AsString := strCodCli;
            ParamByName('CODEMP').AsString := VS_strCodEmp;

            Open;
          End;

        End;

        If Not qryMovGag.IsEmpty Then
        Begin
          qryMovGag.First;
          While Not qryMovGag.Eof Do
          Begin
            fVerificaIntegridade(Self.Name, 'MOVGAG', qryMovGag, True, False, EmptyStr, fOperadorDoCancelamento);

            {*****************}
            {* TABELA MOVGAD *}
            {***************FC}
            With qryMovGad Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add('SELECT * FROM MOVGAD');
              SQL.Add('WHERE GAD_SEQGAG = :AUTINC');

              ParamByName('AUTINC').AsString := qryMovGag.FieldByName('AUTOINCREM').AsString;

              Open;
            End;

            If Not qryMovGad.IsEmpty Then
            Begin
              qryMovGad.First;
              While Not qryMovGad.Eof Do
              Begin
                fVerificaIntegridade(Self.Name, 'MOVGAD', qryMovGad, True, False, EmptyStr, fOperadorDoCancelamento);

                {*****************}
                {* TABELA MOVGRC *}
                {***************FC}
                With qryMovGrc Do
                Begin
                  Close;
                  SQL.Clear;
                  SQL.Add('SELECT * FROM MOVGRC');
                  SQL.Add('WHERE GRC_SEQGAD = :AUTINC');

                  ParamByName('AUTINC').AsString := qryMovGad.FieldByName('AUTOINCREM').AsString;
                  Open;
                End;

                If Not qryMovGrc.IsEmpty Then
                Begin
                  qryMovGrc.First;
                  While Not qryMovGrc.Eof Do
                  Begin
                    fVerificaIntegridade(Self.Name, 'MOVGRC', qryMovGrc, True, False, EmptyStr, fOperadorDoCancelamento);
                    fApagaRegistro('MOVGRC', qryMovGrc.FieldByName('AUTOINCREM').AsString);

                    {*****************}
                    {* TABELA MOVDET *}
                    {***************FC}
                    With qryMovDet Do
                    Begin
                      Close;
                      SQL.Clear;
                      // Se for de coleta não deleta pq é devolução
                      SQL.Add('SELECT * FROM MOVDET');
                      if blnOriundoDeColeta then
                        SQL.Add('WHERE FALSE')
                      Else
                      Begin
                        SQL.Add('WHERE AUTOINCREM = :AUTINC');
                        ParamByName('AUTINC').AsString := qryMovGrc.FieldByName('GRC_SEQDET').AsString;
                      End;
                      Open;
                    End;

                    If Not qryMovDet.IsEmpty Then
                    Begin
                      strAutIncMovGer := strAutIncMovGer + '"' + qryMovDet.FieldByName('DET_SEQGER').AsString + '",';
                      qryMovDet.First;
                      While Not qryMovDet.Eof Do
                      Begin
                        fVerificaIntegridade(Self.Name, 'MOVDET', qryMovDet, True, False, EmptyStr, fOperadorDoCancelamento);

                        {*****************}
                        {* TABELA MOVREF *}
                        {***************RT}
                        qryMovRef.Close;
                        qryMovRef.SQL.Clear;
                        qryMovRef.SQL.Add('SELECT * FROM MOVREF');
                        qryMovRef.SQL.Add('WHERE REF_SEQGER = :AUTINC');
                        qryMovRef.ParamByName('AUTINC').AsString := qryMovDet.FieldByName('AUTOINCREM').AsString;
                        qryMovRef.Open;

                        If Not qryMovRef.IsEmpty Then
                        Begin
                          qryMovRef.First;
                          While Not qryMovRef.Eof Do
                          Begin
                            fVerificaIntegridade(Self.Name, 'MOVREF', qryMovRef, True, False, EmptyStr, fOperadorDoCancelamento);
                            fApagaRegistro('MOVREF', qryMovRef.FieldByName('REF_SEQGER').AsString);
                            qryMovRef.Next;
                          End;
                        End;

                        {*****************}
                        {* TABELA MOVTRI *}
                        {***************FC}
                        With qryMovTri Do
                        Begin
                          Close;
                          SQL.Clear;
                          SQL.Add('SELECT * FROM MOVTRI');
                          SQL.Add('WHERE DET_SEQGER = :AUTINC');

                          ParamByName('AUTINC').AsString := qryMovDet.FieldByName('AUTOINCREM').AsString;
                          Open;
                        End;

                        If Not qryMovTri.IsEmpty Then
                        Begin
                          qryMovTri.First;
                          While Not qryMovTri.Eof Do
                          Begin
                            fVerificaIntegridade(Self.Name, 'MOVTRI', qryMovTri, True, False, EmptyStr, fOperadorDoCancelamento);
                            fApagaRegistro('MOVDET', qryMovDet.FieldByName('AUTOINCREM').AsString);
                            fApagaRegistro('MOVTRI', qryMovTri.FieldByName('DET_SEQGER').AsString);

                            qryMovTri.Next;
                          End;
                        End;

                        fAtualizaEstoque(qryMovDet.FieldByName('DET_CODITE').AsString,
                                         qryMovDet.FieldByName('DET_QTDITE').AsFloat,
                                         IIF(StrToInt(LeftStr(qryMovDet.FieldByName('DET_CLAFIS').AsString, 1)) < 5, 'S', 'E'),
                                         qryMovDet.FieldByName('DET_NUMLOT').AsString, '');


                        qryMovDet.Next;
                      End;
                    End;

                    qryMovGrc.Next;
                  End;
                End;


                If fCfgSis('GARMAT', varBoolean) Then
                Begin
                  qrySeqGar.Close;
                  qrySeqGar.SQL.Clear;
                  qrySeqGar.SQL.Add(' SELECT * FROM SEQGAR WHERE SEQ_MOVGAD = :MOVGAD ');
                  qrySeqGar.ParamByName('MOVGAD').AsString := qryMovGad.FieldByName('AUTOINCREM').AsString;
                  qrySeqGar.Open;

                  If (Not qrySeqGar.IsEmpty) And (Not fEmptyStr(qrySeqGar.FieldByName('SEQ_FDO_TE').AsString)) Then
                  Begin
                    qryFatDor.Close;
                    qryFatDor.SQL.Clear;
                    qryFatDor.SQL.Add('SELECT * FROM FATDOR WHERE AUTOINCREM = :AUTINC');
                    qryFatDor.ParamByName('AUTINC').AsString := qrySeqGar.FieldByName('SEQ_FDO_TE').AsString;
                    qryFatDor.Open;

                    If not qryFatDor.IsEmpty Then
                    Begin
                      qryFatGor.Close;
                      qryFatGor.SQL.Clear;
                      qryFatGor.SQL.Add('SELECT * FROM FATGOR WHERE AUTOINCREM = :AUTINC');
                      qryFatGor.ParamByName('AUTINC').AsString := qryFatDor.FieldByName('FDO_SEQGER').AsString;
                      qryFatGor.Open;

                      If Not qryFatGor.IsEmpty Then
                      Begin
                        qryFatDor.Close;
                        qryFatDor.SQL.Clear;
                        qryFatDor.SQL.Add('SELECT * FROM FATDOR WHERE FDO_SEQGER = :AUTINC');
                        qryFatDor.ParamByName('AUTINC').AsString := qryFatGor.FieldByName('AUTOINCREM').AsString;
                        qryFatDor.Open;

                        While Not qryFatDor.IsEmpty Do
                        Begin
                          fVerificaIntegridade(Self.Name, 'FATDOR', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);
                          qryFatDor.Delete;
                        End;

                        fVerificaIntegridade(Self.Name, 'FATGOR', qryFatGor, True, False, EmptyStr, fOperadorDoCancelamento);
                        pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_FATGOR', qryFatGor.FieldByName('AUTOINCREM').AsString);
                        qryFatGor.Delete;

                      End;
                    End;
                  End;
                End;

                If (Not fApagaRegistro('MOVGAD', qryMovGad.FieldByName('AUTOINCREM').AsString)) Then
                  Exit(False);

                ReprocessarItem(qryMovGad.FieldByName('GAD_CODITE').AsString, '', True, True);

                qryMovGad.Next;
              End;
            End;

            {*****************}
            {* TABELA MOVGER *}
            {***************FC}
            With qryMovGer Do
            Begin
              If (Length(strAutIncMovGer) > 0) And (strAutIncMovGer[Length(strAutIncMovGer)] = ',') Then
              Begin
                strAutIncMovGer[Length(strAutIncMovGer)] := ' ';
                strAutIncMovGer := Trim(strAutIncMovGer);
              End;

              Close;
              SQL.Clear;
              SQL.Add('SELECT * FROM MOVGER');
              SQL.Add('WHERE AUTOINCREM IN (' + strAutIncMovGer + ')');

              If not fEmptyStr(strAutIncMovGer) Then
                Open;
            End;

            if Not blnOriundoDeColeta then
            begin
              If Not qryMovGer.IsEmpty Then
              Begin
                qryMovGer.First;
                While Not qryMovGer.Eof Do
                Begin
                  fCancelaLivroFiscal('NF',
                                      qryMovGer.FieldByName('GER_NUMDOC').AsString,
                                      qryMovGer.FieldByName('GER_CODCLI').AsString,
                                      qryMovGer.FieldByName('GER_SERIE_').AsString,
                                      strAutIncCadFis);

                  fVerificaIntegridade(Self.Name, 'MOVGER', qryMovGer, True, False, EmptyStr, fOperadorDoCancelamento);
                  pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_MOVGER', qryMovGer.FieldByName('AUTOINCREM').AsString);

                  {*****************}
                  {* TABELA AUXMOV *}
                  {***************FC}
                  With qryAuxMov Do
                  Begin
                    Close;
                    SQL.Clear;
                    SQL.Add('SELECT * FROM AUXMOV');
                    SQL.Add('WHERE AUX_SEQGER = :AUTINC');

                    ParamByName('AUTINC').AsString := qryMovGer.FieldByName('AUTOINCREM').AsString;
                    Open;

                    If Not IsEmpty Then
                    Begin
                      First;
                      While Not Eof Do
                      Begin
                        fVerificaIntegridade(Self.Name, 'AUXMOV', qryAuxMov, True, False, EmptyStr, fOperadorDoCancelamento);
                        fApagaRegistro('AUXMOV', qryAuxMov.FieldByName('AUX_SEQGER').AsString);

                        Next;
                      End;
                    End;
                  End;

                  {*****************}
                  {* TABELA MOVOBS *}
                  {***************FC}
                  With qryMovObs Do
                  Begin
                    Close;
                    SQL.Clear;
                    SQL.Add('SELECT * FROM MOVOBS ');
                    SQL.Add('WHERE MOV_SEQGER = :AUTINC ');

                    ParamByName('AUTINC').AsString := qryMovGer.FieldByName('AUTOINCREM').AsString;
                    Open;

                    If Not IsEmpty Then
                    Begin
                      First;
                      While Not Eof Do
                      Begin
                        fVerificaIntegridade(Self.Name, 'MOVOBS', qryMovObs, True, False, EmptyStr, fOperadorDoCancelamento);
                        fApagaRegistro('MOVOBS', qryMovObs.FieldByName('MOV_SEQGER').AsString);

                        Next;
                      End;
                    End;
                  End;

                  fApagaRegistro('MOVGER', qryMovGer.FieldByName('AUTOINCREM').AsString);

                  qryMovGer.Next;
                End;
              End;
            End {If Not blnOriundoDeColeta Then};

            If (Not fApagaRegistro('MOVGAG', qryMovGag.FieldByName('AUTOINCREM').AsString)) Then
             Exit(False);

            qryMovGag.Next;
          End;
        End;

        imgItensNota.Picture   := imgAlterado.Picture;
        imgDadosNota.Picture   := imgAlterado.Picture;
        imgLivroFiscal.Picture := imgAlterado.Picture;

        Application.ProcessMessages;

        qryMovGer.Close;
        qryMovDet.Close;
        qryMovTri.Close;
        qryMovGag.Close;
        qryMovGad.Close;
        qryMovGrc.Close;
        qryAuxMov.Close;
        qryMovObs.Close;

        FreeAndNil(qryMovGer);
        FreeAndNil(qryMovDet);
        FreeAndNil(qryMovTri);
        FreeAndNil(qryMovRef);
        FreeAndNil(qryMovGag);
        FreeAndNil(qryMovGad);
        FreeAndNil(qryMovGrc);
        FreeAndNil(qryAuxMov);
        FreeAndNil(qryMovObs);
        FreeAndNil(qrySeqGar);
        FreeAndNil(qryFatGor);
        FreeAndNil(qryFatDor);

      End
      Else
      Begin
        strSQL := '';
        strSQL := strSQL + 'DELETE FROM ';
        strSQL := strSQL + '  MOVGAG ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  GAG_NUMENT = :NUMDOC AND ';
        strSQL := strSQL + '  GAG_CODCLI = :CODCLI AND ';
        strSQL := strSQL + '  GAG_CODEMP = :CODEMP ';

        With qryGenGer Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('CODCLI').AsString := strCodCli;
          ParamByName('CODEMP').AsString := VS_strCodEmp;
          ExecSQL;
          Close;
        End;
      End;

      Result := True;
    Except
      On E: Exception Do
      Begin
        fRollBack;
        pMensagensErro(E.Message, '[fApagaGarantia]');
        Result := False;
      End;
    End;

  Finally
    FreeAndNil(qryGenGer);
  End;

end;

function TfrmCancelamentoDocumentos.fTemPedidoFaturadoNoRomaneio(strNumRom: String): Boolean;
  Var
    qryRomGer : TUniQuery;
begin
  qryRomGer := fCriaQuery(Self);
  Try
    With qryRomGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT COUNT(*) CNT ');
      SQL.Add('   FROM ROMGERX ');
      SQL.Add('   JOIN FATGOR ON FGO_NUMDOC = GER_NUMDOC ');
      SQL.Add('              AND FGO_ESPDOC = GER_ESPDOC ');
      SQL.Add('              AND FGO_CODEMP = GER_CODEMP ');
      SQL.Add('              AND FGO_CODCLI = GER_CODCLI ');
      SQL.Add('              AND FGO_JAFATU = 1 ');
      SQL.Add('  WHERE GER_NUMROM = :NUMROM ');
      SQL.Add('    AND GER_EMPROM = :EMPROM ');
      SQL.Add('    AND GER_ESPDOC = "PD" ');
      ParamByName('NUMROM').AsString := strNumRom;
      ParamByName('EMPROM').AsString := VS_strCodEmp;
      Open;
      Result := (FieldByName('CNT').AsInteger > 0);
      Close;
    End;
  Finally
    FreeAndNil(qryRomGer);
  End;
end;

function TfrmCancelamentoDocumentos.fCancelaRomaneio(strNumRom: String): Boolean;
  Var
    strSQL   : String;
    blnEntDev: Boolean;
begin

  Try

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ROMDETX ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DET_NUMROM = :NUMROM AND ';
    strSQL := strSQL + '  DET_EMPROM = :EMPROM ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMROM').AsString := strNumRom;
      ParamByName('EMPROM').AsString := VS_strCodEmp;
      Open;

      If (RecordCount <= 0) And (fCampoTabela('COUNT(*)', 'ROMOUTX', ['OUT_NUMROM','OUT_ROMEMP'], [strNumRom,VS_strCodEmp]) <= 0) Then
      Begin
        fRollBack;
        fMensagem('', 'Esse romaneio não está cadastrado!', ['&Ok']);
        Result := False;
        Close;
        Exit;
      End;

      If RecordCount > 0 Then
      Begin
        First;
        While (Not Eof) Do
        Begin
          fVerificaIntegridade(Self.Name, 'ROMDETX', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
          Next;
        End;
      End;

      Close;
    End;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ROMGERX ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GER_NUMROM = :NUMROM AND ';
    strSQL := strSQL + '  GER_EMPROM = :EMPROM ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMROM').AsString := strNumRom;
      ParamByName('EMPROM').AsString := VS_strCodEmp;
      Open;

      fVerificaIntegridade(Self.Name, 'ROMGERX', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);

      Close;
    End;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ROMOUTX ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  OUT_NUMROM = :NUMROM AND ';
    strSQL := strSQL + '  OUT_ROMEMP = :EMPROM ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMROM').AsString := strNumRom;
      ParamByName('EMPROM').AsString := VS_strCodEmp;
      Open;

      fVerificaIntegridade(Self.Name, 'ROMOUTX', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);

      Close;
    End;

    blnEntDev := Pos(fCfgSis('DEVROM', varString), '3_4') > 0;

    If fCfgSis('USPRRO', varBoolean) Then
      pLimparInformacoesExpedicao(Nil, strNumRom);

    pDeletaRomaneio(strNumRom, blnEntDev);
    TRomaneioTarefasFusion.pInsereTarFus(strNumRom, VS_strCodEmp, '', '', '', 'C');

    imgItensNota.Picture := imgAlterado.Picture;
    imgDadosNota.Picture := imgAlterado.Picture;

    Result := True;

  Except
    On E: Exception Do
    Begin
      fRollBack;
      Result := False;
      pMensagensErro(E.Message, '[fCancelaRomaneio]');
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fCancelarPedidoColeta(strEspSel, strNumDocSel, strCliForSel, strSerie: String): Boolean;
var
  qryAux    : TUniQuery;
  qryExtGor : TUniQuery;
  qryFatDor : TUniQuery;
  qryExtDor : TUniQuery;

  strNumDoc,
  strEspDoc,
  strCodEmp,
  strCodCli : String;

begin

  qryAux := fCriaQuery(Self);

  Try

    Try

      qryAux.SQl.Add('SELECT * FROM FATGOR ');
      qryAux.SQl.Add(' WHERE FGO_NUMFAT = :NUMFAT');
      qryAux.SQl.Add('   AND FGO_EMPFAT = "' + VS_StrCodEMP + '"');
      qryAux.SQl.Add('   AND FGO_CODCLI = :CODCLI');
      qryAux.SQl.Add('   AND FGO_TIPFAT = :TIPFAT');
      qryAux.SQl.Add('   AND FGO_SERIE_ = :SERIE_');

      qryAux.ParamByName('NUMFAT').AsString := strNumDocSel;
      qryAux.ParamByName('CODCLI').AsString := strCliForSel;
      qryAux.ParamByName('TIPFAT').AsString := strEspSel;
      qryAux.ParamByName('SERIE_').AsString := strSerie;
      qryAux.Open;

      If Not qryAux.IsEmpty Then
      Begin

        strNumDoc := qryAux.FieldByName('FGO_NUMDOC').AsString;
        strEspDoc := qryAux.FieldByName('FGO_ESPDOC').AsString;
        strCodEmp := qryAux.FieldByName('FGO_CODEMP').AsString;
        strCodCli := qryAux.FieldByName('FGO_CODCLI').AsString;

        If (Not strNumDoc.IsEmpty) And
           (Not strEspDoc.IsEmpty) And
           (Not strCodEmp.IsEmpty) And
           (Not strCodCli.IsEmpty) Then
        Begin

          qryExtGor := fCriaQuery(Self);
          qryFatDor := fCriaQuery(Self);
          qryExtDor := fCriaQuery(Self);

          Try

            qryFatDor.Close;
            qryFatDor.SQL.Clear;
            qryFatDor.SQL.Add('SELECT * FROM FATDOR WHERE FDO_SEQGER = ' + QuotedStr(qryAux.FieldByName('AUTOINCREM').AsString));
            qryFatDor.Open;

            qryFatDor.First;
            While Not qryFatDor.Eof Do
            Begin

              qryExtDor.Close;
              qryExtDor.SQL.Clear;
              qryExtDor.SQL.Add('SELECT * FROM EXTDOR WHERE FDO_SEQFDO = :SEQFDO');
              qryExtDor.ParamByName('SEQFDO').AsString := qryFatDor.FieldByName('AUTOINCREM').AsString;
              qryExtDor.Open;

              fVerificaIntegridade(Self.Name, 'EXTDOR', qryExtDor, True, False, EmptyStr, fOperadorDoCancelamento);
              fVerificaIntegridade(Self.Name, 'FATDOR', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);
              qryFatDor.Next;

            End;

            qryExtGor.Close;
            qryExtGor.SQL.Clear;
            qryExtGor.SQL.Add('SELECT * FROM EXTGOR WHERE FGO_SEQFGO = :SEQFGO');
            qryExtGor.ParamByName('SEQFGO').AsString := qryAux.FieldByName('AUTOINCREM').AsString;
            qryExtGor.Open;

            fVerificaIntegridade(Self.Name, 'EXTGOR', qryExtGor, True, False, EmptyStr, fOperadorDoCancelamento);
            fVerificaIntegridade(Self.Name, 'FATGOR', qryAux, True, False, EmptyStr, fOperadorDoCancelamento);
            pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_FATGOR', qryAux.FieldByName('AUTOINCREM').AsString);

          Finally
            FreeAndNil(qryExtGor);
            FreeAndNil(qryFatDor);
            FreeAndNil(qryExtDor);
          End;

          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQL.Add('DELETE FROM ');
          qryAux.SQL.Add('  FATGOR    ');
          qryAux.SQL.Add('WHERE       ');
          qryAux.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
          qryAux.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
          qryAux.SQL.Add('  FGO_CODEMP = :CODEMP AND ');
          qryAux.SQL.Add('  FGO_CODCLI = :CODCLI     ');

          qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
          qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
          qryAux.ParamByName('CODEMP').AsString := strCodEmp;
          qryAux.ParamByName('CODCLI').AsString := strCodCli;

          qryAux.ExecSQL;

        End;

      End;

      Result := True;

    Except
      On E: Exception Do
      Begin
        fRollBack;
        Result := False;
        pMensagensErro(E.Message, '[fCancelarPedidoColeta]');
      End;
    End;

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TfrmCancelamentoDocumentos.fTemMovimentoVinculado117(strEspDoc, strNumDoc, strCliFor, strSerie: String; var strDocuments: String): Boolean;
var qryTmp117 : TUniQuery;
begin
  qryTmp117 := fCriaQuery;
  Try
    qryTmp117.SQL.Add('SELECT CONCAT(X117.DET_NUMDOC, " - ", X117.DET_SERIE_, " - ", X117.DET_CODFOR) AS DOC FROM MOVDET D');
    qryTmp117.SQL.Add('INNER JOIN VENFUT ON FUT_NFX922 =  D.AUTOINCREM');
    qryTmp117.SQL.Add('INNER JOIN MOVDET X117 ON X117.AUTOINCREM = FUT_NFX117');
    qryTmp117.SQL.Add('WHERE D.DET_NUMDOC = :NUMDOC');
    qryTmp117.SQL.Add('  AND D.DET_CODEMP = "'+VS_StrCodEmp+'"');
    qryTmp117.SQL.Add('  AND D.DET_ESPDOC = "NF"');
    qryTmp117.SQL.Add('  AND IFNULL(D.DET_SERIE_, "") = :SERIE_');
    qryTmp117.SQL.Add('  AND D.DET_CODFOR = :CODFOR');
    qryTmp117.SQL.Add('  AND D.DET_QTDEFT > 0');
    qryTmp117.SQL.Add('GROUP BY X117.DET_NUMDOC,');
    qryTmp117.SQL.Add('X117.DET_CODEMP,');
    qryTmp117.SQL.Add('X117.DET_ESPDOC,');
    qryTmp117.SQL.Add('X117.DET_SERIE_,');
    qryTmp117.SQL.Add('X117.DET_CODFOR,');
    qryTmp117.SQL.Add('X117.DET_QTDEFT');

    qryTmp117.ParamByName('NUMDOC').ASString := strNumDoc;
    qryTmp117.ParamByName('CODFOR').ASString := strCliFor;
    qryTmp117.ParamByName('SERIE_').ASString := strSerie;

    qryTmp117.Open;

    Result := Not qryTmp117.IsEmpty;
    If Result  Then
    Begin
      While not(qryTmp117.Eof) Do
      Begin
        strDocuments := strDocuments + qryTmp117.FieldByName('DOC').AsString + #$A#$D;
        qryTmp117.Next
      End;
    End;

  finally
    FreeAndNil(qryTmp117);
  end;
end;

function TfrmCancelamentoDocumentos.fTemMovimento117(strEspDoc, strNumDoc, strCliFor, strSerie: String): Boolean;
var qryTmp117 : TUniQuery;
begin
  qryTmp117 := fCriaQuery;
  Try
    qryTmp117.SQL.Add('SELECT COUNT(1) AS QTD FROM MOVDET D');
    qryTmp117.SQL.Add('WHERE D.DET_NUMDOC = :NUMDOC');
    qryTmp117.SQL.Add('  AND D.DET_CODEMP = "'+VS_StrCodEmp+'"');
    qryTmp117.SQL.Add('  AND D.DET_ESPDOC = "NF"');
    qryTmp117.SQL.Add('  AND IFNULL(D.DET_SERIE_, "") = :SERIE_');
    qryTmp117.SQL.Add('  AND D.DET_CODFOR = :CODFOR');
    qryTmp117.SQL.Add('  AND LOCATE(RIGHT(DET_CLAFIS, 3), "_117_116") > 0' );

    qryTmp117.ParamByName('NUMDOC').ASString := strNumDoc;
    qryTmp117.ParamByName('CODFOR').ASString := strCliFor;
    qryTmp117.ParamByName('SERIE_').ASString := strSerie;

    qryTmp117.Open;
    Result := qryTmp117.FieldByName('QTD').AsInteger > 0;
  finally
    FreeAndNil(qryTmp117);
  end;
end;


function TfrmCancelamentoDocumentos.fCancelaPreNotax117(strEspDoc,
  strNumDoc, strCliFor, strSerie: String; blnLimpaGereEle: Boolean = False): Boolean;
var
  qrySQL: TUniQuery;
  qryDelete: TUniQuery;
  strDigIde: String;
begin
  qrySQL := fCriaQuery;
  qryDelete:= fCriaQuery;
  Try
    qrySQL.SQL.Add('SELECT G.AUTOINCREM AS INC_GERELE, PEDELE.PEL_SEQELE, GER_IDEDIG, GER_DTACON');
    qrySQL.SQL.Add(' FROM MOVDET D');
    qrySQL.SQL.Add('INNER JOIN GERELE G ON GER_DOCENT = D.DET_NUMDOC');
    qrySQL.SQL.Add('                 AND GER_ESPENT = D.DET_ESPDOC');
    qrySQL.SQL.Add('                 AND GER_EMPENT = D.DET_CODEMP');
    qrySQL.SQL.Add('                 AND GER_CODFOR = D.DET_CODFOR');
    qrySQL.SQL.Add('INNER JOIN PEDELE ON PEL_SEQELE = G.AUTOINCREM');
    qrySQL.SQL.Add('WHERE D.DET_NUMDOC = :NUMDOC');
    qrySQL.SQL.Add('  AND D.DET_CODEMP = "'+VS_StrCodEmp+'"');
    qrySQL.SQL.Add('  AND D.DET_ESPDOC = "NF"');
    qrySQL.SQL.Add('  AND LOCATE(RIGHT(DET_CLAFIS, 3), "_117_116") > 0' );
    qrySQL.SQL.Add('  AND IFNULL(D.DET_SERIE_, "") = :SERIE_');
    qrySQL.SQL.Add('  AND D.DET_CODFOR = :CODFOR');
    qrySQL.SQL.Add('GROUP BY   G.AUTOINCREM');

    qrySQL.ParamByName('NUMDOC').ASString := strNumDoc;
    qrySQL.ParamByName('CODFOR').ASString := strCliFor;
    qrySQL.ParamByName('SERIE_').ASString := strSerie;


    qrySQL.Open;

    While not qrySQL.Eof do
    Begin
      strDigIde := qrySQL.FieldByName('GER_IDEDIG').AsString;
      If qrySQL.FieldByName('GER_IDEDIG').AsString <> '' Then
      Begin
        qryDelete.SQL.Clear;
        qryDelete.SQL.Add('DELETE FROM DIGELE WHERE DIG_IDEDIG = "' + qrySQL.FieldByName('GER_IDEDIG').AsString + '"');
        qryDelete.SQL.Add('                     AND DIG_CODEMP = "'+VS_StrCodEmp+'"');
        qryDelete.ExecSQL;
      End;
      qryDelete.SQL.Clear;
      qryDelete.SQL.Add('DELETE FROM PEDELE WHERE PEDELE.PEL_SEQELE = "' + qrySQL.FieldByName('PEL_SEQELE').AsString + '"');
      qryDelete.ExecSQL;
      If blnLimpaGereEle Then
      Begin
        qryDelete.SQL.Clear;
        qryDelete.SQL.Add('UPDATE GERELE');
        qryDelete.SQL.Add('  SET GER_IDEDIG = NULL, ');
        qryDelete.SQL.Add('  GER_DTACON = NULL, ');
        qryDelete.sql.Add('  GER_ENDFIN = "N", ');
        qryDelete.SQL.Add('  GER_HORCON = NULL, ');
        qryDelete.SQL.Add('  GER_OPECON = NULL,  ');
        qryDelete.SQL.Add('  GER_DTALIB = NULL  ');
        qryDelete.SQL.Add('WHERE AUTOINCREM = "'+qrySQL.FieldByName('INC_GERELE').AsString+'"');
        qryDelete.ExecSQL;
      End;

      qryDelete.sql.Clear;
      qryDelete.SQL.Add('DELETE FROM PREBAI WHERE PRE_AUTELE =  "'+qrySQL.FieldByName('INC_GERELE').AsString+'"');
      qryDelete.ExecSQL;

      qryDelete.sql.Clear;
      qryDelete.SQL.Add('DELETE FROM DEFBAI WHERE DEF_GERELE =  "'+qrySQL.FieldByName('INC_GERELE').AsString+'"');
      qryDelete.ExecSQL;


      qrySQL.Next;
    End;
    Result := True;

  Finally
    FreeAndNil(qrySQL);
    FreeAndNil(qryDelete);
  End;
end;

function TfrmCancelamentoDocumentos.fCancelaVinculox922x117(strEspDoc,
  strNumDoc, strCliFor, strSerie: String): Boolean;
  Var
    qryTmp : TUniQuery;
    qryTmp177 : TUniQuery;
begin
  //  Os registros serão deletados por cascade da tabela VENFUT
  //  Esta função serve apenas para ajustar o campo DET_QTDEFT subtraindo a quantidade relacionada
  qryTmp := fCriaQuery;
  qryTmp177 := fCriaQuery;
  Try
    Try
      qryTmp.SQL.Clear;


      qryTmp.SQL.Add('SELECT RIGHT(DET_CLAFIS, 3) AS CLAFIS');
      qryTmp.SQL.Add(' FROM MOVDET');
      qryTmp.SQL.Add('WHERE DET_NUMDOC = :NUMDOC');
      qryTmp.SQL.Add('  AND DET_ESPDOC = :ESPDOC');
      qryTmp.SQL.Add('  AND DET_CODFOR = :CODFOR');
      qryTmp.SQL.Add('  AND IFNULL(DET_SERIE_, "") = :SERIE_');
      qryTmp.SQL.Add('  AND ((IFNULL(DET_CLAFIS,"") <> "") AND (LOCATE(RIGHT(DET_CLAFIS, 3), "_117_116") > 0))');

      qryTmp.ParamByName('NUMDOC').ASString := strNumDoc;
      qryTmp.ParamByName('ESPDOC').ASString := strEspDoc;
      qryTmp.ParamByName('CODFOR').ASString := strCliFor;
      qryTmp.ParamByName('SERIE_').ASString := strSerie;

      qryTmp.Open;

      If qryTmp.IsEmpty Then
        Exit(True);
      //Cancela pre nota
      fCancelaPreNotax117(strEspDoc, strNumDoc, strCliFor, strSerie, True);

      If (qryTmp.FieldByName('CLAFIS').AsString = '117') Or
         (qryTmp.FieldByName('CLAFIS').AsString = '116') Then
      Begin
        qryTmp.SQL.Clear;

        qryTmp.SQL.Add('SELECT FUT_NFX922 , FUT_QTDATD ');
        qryTmp.SQL.Add('  FROM VENFUT');
        qryTmp.SQL.Add(' WHERE FUT_NFX117 IN (SELECT  AUTOINCREM FROM MOVDET');
        qryTmp.SQL.Add('                      WHERE DET_NUMDOC = :NUMDOC');
        qryTmp.SQL.Add('                        AND DET_ESPDOC = :ESPDOC');
        qryTmp.SQL.Add('                        AND DET_CODFOR = :CODFOR');
        qryTmp.SQL.Add('                        AND IFNULL(DET_SERIE_, "") = :SERIE_) ');

      End;
      qryTmp.ParamByName('NUMDOC').ASString := strNumDoc;
      qryTmp.ParamByName('ESPDOC').ASString := strEspDoc;
      qryTmp.ParamByName('CODFOR').ASString := strCliFor;
      qryTmp.ParamByName('SERIE_').ASString := strSerie;

      qryTmp.Open;

      qryTmp177.SQL.Text := 'UPDATE MOVDET SET DET_QTDEFT = DET_QTDEFT - :QTDATD WHERE AUTOINCREM  = :NFX922';
      While Not qryTmp.Eof Do
      Begin
        qryTmp177.Close;
        qryTmp177.ParamByName('QTDATD').AsFloat  := qryTmp.FieldByName('FUT_QTDATD').AsFloat;
        qryTmp177.ParamByName('NFX922').AsString := qryTmp.FieldByName('FUT_NFX922').AsString;
        qryTmp177.ExecSQL;
        qryTmp.Next;
      End;

      Result := True;
    Except
      On e: Exception do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fCancelaVinculox922x117]');
      End;
    End;

  Finally
    FreeAndNil(qryTmp);
    FreeAndNil(qryTmp177);
  End;

end;


function TfrmCancelamentoDocumentos.fCancelouDocumentoIF: Boolean;
  Var
    qryTmp : TUniQuery;
    strSQL : String;

  Function fSelectIF(strTab: String): String;
  Begin
    strSQL := '';
    strSQL := strSQL + ' SELECT GER_NUMDOC           ';
    strSQL := strSQL + '   FROM ' + strTab + '       ';
    strSQL := strSQL + '  WHERE GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '    AND GER_ESPDOC IN ("IF") ';
    strSQL := strSQL + '    AND GER_CODEMP = :CODEMP ';
    strSQL := strSQL + '    AND GER_CODCLI = :CODCLI ';
    Result := strSQL;
  End;

begin
//  Result := False;
  qryTmp := fCriaQuery(Self);

  Try
    With qryTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fSelectIF('MOVGER'));
      ParamByName('NUMDOC').AsString := edtNumDoc.Text;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := edtCliFor.Text;
      Open;
      Result := (RecordCount = 0);

      If (Result) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fSelectIF('NOTGER'));
        ParamByName('NUMDOC').AsString := edtNumDoc.Text;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        ParamByName('CODCLI').AsString := edtCliFor.Text;
        Open;
        Result := (RecordCount = 0);
      End;

      Close;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fCancelouDocumentoIF]');
    End;
  End;

  FreeAndNil(qryTmp);
end;

