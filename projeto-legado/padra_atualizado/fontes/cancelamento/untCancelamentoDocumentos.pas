function TfrmCancelamentoDocumentos.fDeveVerificarLogDeCancelamento: Boolean;
begin
  Result := False;
  If (blnCancelarSATouCFTefAutomatico) Then
    Exit;
  If (blnPegaDados) Then
    Exit;
  If (FblnCancelandoRetornoConsignadoAutomatico) Then
    Exit;
