        If (blnResult) And (strEspSel = 'GF')  Then
          blnResult := fCancelaContasPagar(strEspSel, 'GF', strNumDocSel, strCliForSel, strSerieSel);

        pStepBy;

        If (blnResult) And (strEspSel <> 'NW') Then
          blnResult := fCancelaContasPagarServ(strEspSel, strNumDocSel, strCliForSel);

        pStepBy;

        If (blnResult) And (strEspSel <> 'NW') Then
          blnResult := fVoltaCtrConfirmacao(strEspSel, strNumDocSel, strCliForSel);

        pStepBy;

        If (blnResult) And (strEspSel <> 'NW') Then
