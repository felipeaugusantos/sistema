function TfrmCancelamentoDocumentos.fDocumentoJaConstaComoCanceladoNaSefaz(const strNumDoc, strEspDoc, strCodEmp, strForCli, strTipFC : String) : Boolean;
  Const
    ESPECIES_FISCAIS : String = '_NF_NS_IF_';
  Var
    strChaveAcesso : String;
    strStatus : String;
    strSerieCan : String;
begin
  Result := False;
  If (Not ESPECIES_FISCAIS.Contains(strEspDoc)) Then
    Exit;
  If (edtSerie.Visible) or (Not fSuportaInterfaceGrafica) Then
    strSerieCan := edtSerie.Text
  Else If (strEspDoc = 'NS') Then
    strSerieCan := fCfgSis('SERNFS')
  Else If ((strEspDoc = 'IF') And (fCfgSis('USNFCE', varBoolean) Or fUsaSat)) Then
    strSerieCan := fCfgSis('SERNFC')
  Else
    strSerieCan := fCfgSis('SERFSC');
  If fEmptyStr(strSerieCan) Then
    Exit;
  strChaveAcesso := fCampoTabela('FIS_ACESSO', 'CADFIS', ['FIS_NUMDOC', 'FIS_ESPDOC', 'FIS_CODEMP', 'FIS_TIP_FC', 'FIS_FORCLI', 'FIS_SERIE_'],
                                                         [strNumDoc, strEspDoc, strCodEmp, strTipFC, strForCli, strSerieCan]);
  If fEmptyStr(strChaveAcesso) Then
    Exit;
  Try
    strStatus := fConsultaStatusDFe(strChaveAcesso, strNumDoc, strEspDoc, strCodEmp, strSerieCan, strForCli, strTipFC);
    Result := (strStatus = 'Cancelada');
  Except
    Result := False;
  End;
end;

function TfrmCancelamentoDocumentos.fDocumentoFiscalFoiCanceladoNoAutom(const qryMovDet : TUniQuery; out strDocFis : String) : Boolean;
  Var
    qryCadFis : TUniQuery;
    strCodCliFor : String;
    strEntSai : String;
begin
  qryCadFis := fCriaQuery;
  Try
    strDocFis := '';
    If (StrToInt(LeftStr(qryMovDet.FieldByName('DET_CLAFIS').AsString, 1)) >= 5) Then
      strEntSai := 'S'
    Else
      strEntSai := 'E';
    qryCadFis.Close;
    qryCadFis.SQL.Add(' SELECT FIS_HISTOR, FIS_ACESSO ');
    qryCadFis.SQL.Add('   FROM CADFIS ');
    qryCadFis.SQL.Add('  WHERE FIS_NUMDOC = :NUMDOC ');
    qryCadFis.SQL.Add('    AND FIS_ESPDOC = :ESPDOC ');
    qryCadFis.SQL.Add('    AND FIS_CODEMP = :CODEMP ');
    qryCadFis.SQL.Add('    AND FIS_FORCLI = :FORCLI ');
    qryCadFis.SQL.Add('    AND FIS_TIP_FC = :TIP_FC ');
    qryCadFis.SQL.Add('    AND IFNULL(FIS_SERIE_, "") = :SERIE_ ');
    qryCadFis.SQL.Add('    AND IFNULL(FIS_ORIDOC, "") = :ORIDOC ');
    qryCadFis.SQL.Add('    AND FIS_ENTSAI = :ENTSAI ');
    qryCadFis.ParamByName('NUMDOC').AsString := qryMovDet.FieldByName('DET_NUMDOC').AsString;
    qryCadFis.ParamByName('ESPDOC').AsString := qryMovDet.FieldByName('DET_ESPDOC').AsString;
    qryCadFis.ParamByName('CODEMP').AsString := qryMovDet.FieldByName('DET_CODEMP').AsString;
    strCodCliFor := IfThen(qryMovDet.FieldByName('DET_TIP_FC').AsString = 'F', qryMovDet.FieldByName('DET_CODFOR').AsString, qryMovDet.FieldByName('DET_CODCLI').AsString);
    qryCadFis.ParamByName('FORCLI').AsString := strCodCliFor;
    qryCadFis.ParamByName('TIP_FC').AsString := qryMovDet.FieldByName('DET_TIP_FC').AsString;
    qryCadFis.ParamByName('SERIE_').AsString := qryMovDet.FieldByName('DET_SERIE_').AsString;
    qryCadFis.ParamByName('ORIDOC').AsString := qryMovDet.FieldByName('DET_ORIDOC').AsString;
    qryCadFis.ParamByName('ENTSAI').AsString := strEntSai;
    qryCadFis.Open;
    If (qryCadFis.IsEmpty) Then
    Begin
      Result := True;
      Exit;
    End;
    strDocFis := qryMovDet.FieldByName('DET_NUMDOC').AsString + '-' +
                 qryMovDet.FieldByName('DET_ESPDOC').AsString + '-' +
                 qryMovDet.FieldByName('DET_CODEMP').AsString + '-' +
                 strCodCliFor + '-' +
                 qryMovDet.FieldByName('DET_TIP_FC').AsString + '-' +
                 qryMovDet.FieldByName('DET_SERIE_').AsString + '-' +
                 qryMovDet.FieldByName('DET_ORIDOC').AsString + '-' +
                 strEntSai;
    If (fEmptyStr(qryCadFis.FieldByName('FIS_ACESSO').AsString)) Then
      Result := True
    Else
      Result := fHistoricoSinalizadoCorretamenteQuandoCancelamento(qryCadFis.FieldByName('FIS_HISTOR').AsString);
  Finally
    FreeAndNil(qryCadFis);
  End;
end;

function TfrmCancelamentoDocumentos.fHistoricoSinalizadoCorretamenteQuandoCancelamento(const strHistor : String) : Boolean;
begin
  Result := True;
  If strHistor = 'CANCELADO' Then
    Exit;
  If strHistor = 'INUTILIZADO' Then
    Exit;
  If strHistor = 'DENEGADA' Then
    Exit;
  Result := False;
end;

function TfrmCancelamentoDocumentos.fTransferenciaDeSaidaJaTeveEntradaRealizada(const ANumDoc, AEspDoc, ACodEmp, ACodCli, ATip_FC, ASerie_ : String) : Boolean;
  Var
    LQryTransf : TUniQuery;
    LQryEntrada : TUniQuery;
    LEmpCliFil : String;
begin
  Result := False;
  If (ATip_FC <> 'C') Then
    Exit;
  If (Pos(AEspDoc, 'NF_EL_NV_') <= 0) Then
    Exit;
  LEmpCliFil := fRetCodEmpClienteFilial(ACodCli);
  If fEmptyStr(LEmpCliFil) Then
    Exit;
  LQryTransf := fCriaQuery;
  Try
    LQryTransf.Close;
    LQryTransf.SQL.Clear;
    LQryTransf.SQL.Add(' SELECT FIS_ACESSO ');
    LQryTransf.SQL.Add('   FROM CADFIS ');
    LQryTransf.SQL.Add('  WHERE FIS_NUMDOC = :NUMDOC ');
    LQryTransf.SQL.Add('    AND FIS_ESPDOC = :ESPDOC ');
    LQryTransf.SQL.Add('    AND FIS_CODEMP = :CODEMP ');
    LQryTransf.SQL.Add('    AND FIS_FORCLI = :CODCLI ');
    LQryTransf.SQL.Add('    AND FIS_TIP_FC = :TIP_FC ');
    LQryTransf.SQL.Add('    AND FIS_ORIDOC = :ORIDOC ');
    LQryTransf.SQL.Add('    AND FIS_ENTSAI = :ENTSAI ');
    LQryTransf.SQL.Add('    AND IFNULL(FIS_SERIE_, "") = :SERIE_ ');
    LQryTransf.ParamByName('NUMDOC').AsString := ANumDoc;
    LQryTransf.ParamByName('ESPDOC').AsString := AEspDoc;
    LQryTransf.ParamByName('CODEMP').AsString := ACodEmp;
    LQryTransf.ParamByName('CODCLI').AsString := ACodCli;
    LQryTransf.ParamByName('TIP_FC').AsString := ATip_FC;
    LQryTransf.ParamByName('SERIE_').AsString := ASerie_;
    LQryTransf.ParamByName('ORIDOC').AsString := 'V';
    LQryTransf.ParamByName('ENTSAI').AsString := 'S';
    LQryTransf.Open;
    If (LQryTransf.IsEmpty) Then
      Exit;
    If (fEmptyStr(LQryTransf.FieldByName('FIS_ACESSO').AsString)) Then
      Exit;
    LQryEntrada := fCriaQuery;
    Try
      LQryEntrada.Close;
      LQryEntrada.SQL.Clear;
      LQryEntrada.SQL.Add(' SELECT FIS_ACESSO ');
      LQryEntrada.SQL.Add('   FROM CADFIS ');
      LQryEntrada.SQL.Add('  WHERE FIS_ACESSO = :ACESSO ');
      LQryEntrada.SQL.Add('    AND FIS_ORIDOC = :ORIDOC ');
      LQryEntrada.SQL.Add('    AND FIS_CODEMP = :CODEMP ');
      LQryEntrada.SQL.Add('    AND FIS_FORCLI = :CODFOR ');
      LQryEntrada.SQL.Add('    AND FIS_TIP_FC = :TIP_FC ');
      LQryEntrada.SQL.Add('    AND FIS_ENTSAI = :ENTSAI ');
      LQryEntrada.ParamByName('ACESSO').AsString := LQryTransf.FieldByName('FIS_ACESSO').AsString;
      LQryEntrada.ParamByName('ORIDOC').AsString := '';
      LQryEntrada.ParamByName('TIP_FC').AsString := 'F';
      LQryEntrada.ParamByName('ENTSAI').AsString := 'E';
      LQryEntrada.ParamByName('CODFOR').AsString := fCampoTabela('EMP_FORFIL', 'CADEMP', ['EMP_CODEMP'], [ACodEmp], False);
      LQryEntrada.ParamByName('CODEMP').AsString := LEmpCliFil;
      LQryEntrada.Open;
      Result := (Not LQryEntrada.IsEmpty);
    Finally
      FreeAndNil(LQryEntrada);
    End;
  Finally
    FreeAndNil(LQryTransf);
  End;
end;

function TfrmCancelamentoDocumentos.fGetStatusFiscal(const strNumDoc, strEspDoc, strCodCli, strCodEmp, strSerie, strTip_FC : String) : TStatusFiscal;
  Var
    strChaveAcesso : String;
    strStatusDFe : String;
    strCnpjEmitente : String;
    strModeloFiscal : String;
begin
  Try
    Result := sfDesconhecido;
    If (strEspDoc = 'NF') Then
      strModeloFiscal := '55'
    Else If (strEspDoc = 'IF') Then
      strModeloFiscal := '65'
    Else
      Exit;
    strChaveAcesso := fGetChaveAcesso(strNumDoc, strEspDoc, strCodCli, strCodEmp, strSerie, strTip_FC);
    If (fEmptyStr(strChaveAcesso)) Or (Length(strChaveAcesso) <> 44) Then
    Begin
      strCnpjEmitente := fCampoTabela('EMP_C_G_C_', 'CADEMP', ['EMP_CODEMP'], [strCodEmp]);
      strStatusDFe := fConsultaStatusInutilizado(strCnpjEmitente, strSerie, strNumDoc, strCodEmp, strCodCli, strTip_FC, strModeloFiscal);
      If (strStatusDFe = 'Inutilizado') Then
        Result := sfInutilizada;
    End
    Else
    Begin
      strStatusDFe := fConsultaStatusDFe(strChaveAcesso, strNumDoc, strEspDoc, strCodEmp, strSerie, strCodCli, strTip_FC);
      If (strStatusDFe = 'Autorizada') Then
        Result := sfAutorizada
      Else If (strStatusDFe = 'Cancelada') Then
        Result := sfCancelada;
    End;
  Except
    On E: Exception Do
    Begin
      pGravarErro(True, E.Message, E.StackTrace);
      Result := sfDesconhecido;
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fEspeciesComVinculoFiscal: String;
begin
  Result := 'NF_EL_OF_OU_NI_NC_IC_NG_EF_DC_';
  If blnNW_Nfe Then
    Result := Result + 'NW_';
  If (fCfgSis('USNFCE', varString) = 'S') Or (fUsaSat) Then
    Result := Result + 'IF_IV_';
  If (fCfgSis('CANNFS', varString) = 'S') Then
    Result := Result + 'NS_';
end;

procedure TfrmCancelamentoDocumentos.pValidarStatusDoDocumentoFiscal(const blnNotaEletronica : Boolean; const strEspecieNFe : String; const strEspCan : String;
  const strTipFc : String; out strTextoExibicao : String; const strEspSel : String);
  Var
    strStatusLogNFe : String;
    blnDifChvAcesso : Boolean;
    StatusFiscal : TStatusFiscal;
begin
  strTextoExibicao := '';
  If CancelandoNFViaFulFillment Then
    Exit;
  If (FNFSeSubstituicao) Then
    Exit;
  If (Pos(strEspSel, fEspeciesComVinculoFiscal) = 0) Then
    Exit;
  If (chkInutilizacao.Checked) Or (blnNotaEletronica) Or (fSatComIntegradorCitel(strEspecieNFe)) Then
  Begin
    StatusFiscal := fGetStatusFiscal(edtNumDoc.Text, strEspecieNFe, edtCliFor.Text, VS_strCodEmp, IIF(edtSerie.Visible, edtSerie.Text, strSerFsc), IIF(SameText(strTipFc, 'CODFOR'), 'F','C'));
    If (StatusFiscal = sfDesconhecido) Then
      Exit;
    strStatusLogNFe := fStatusNFe(strEspCan,
                                  IIF(SameText(strTipFc, 'CODFOR'), 'F', 'C'),
                                  blnDifChvAcesso);
    If (blnDifChvAcesso) Then
      Exit;
    Case StatusFiscal Of
      sfAutorizada:
      Begin
        chkInutilizacao.Checked := False;
        If (strStatusLogNFe <> 'AT') Then
          pGravarErro(True, 'CANCELAMENTO STATUS DIVERGENTE - SEFAZ: [ AUTORIZADA ] - LOGNFE: [ ' + strStatusLogNFe + ' ] ', Concat(edtNumDoc.Text, '-', strEspCan, '-', VS_strCodEmp, '-', edtCliFor.Text, '-', IIF(edtSerie.Visible, edtSerie.Text, strSerFsc)));
      End;
      sfCancelada:
      Begin
        chkInutilizacao.Checked := False;
        If (strStatusLogNFe <> 'CN') Then
        Begin
          pGravarErro(True, 'CANCELAMENTO STATUS DIVERGENTE - SEFAZ: [ CANCELADA ] - LOGNFE: [ ' + strStatusLogNFe + ' ] ', Concat(edtNumDoc.Text, '-', strEspCan, '-', VS_strCodEmp, '-', edtCliFor.Text, '-', IIF(edtSerie.Visible, edtSerie.Text, strSerFsc)));
          fMarcarNFeComoCancelada(edtNumDoc.Text, strEspCan, VS_strCodEmp, edtCliFor.Text, IIF(edtSerie.Visible, edtSerie.Text, strSerFsc));
        End;
      End;
      sfInutilizada:
      Begin
        If (strStatusLogNFe <> 'IN') Then
        Begin
          pGravarErro(True, 'CANCELAMENTO STATUS DIVERGENTE - SEFAZ: [ INUTILIZADA ] - LOGNFE: [ ' + strStatusLogNFe + ' ] ', Concat(edtNumDoc.Text, '-', strEspCan, '-', VS_strCodEmp, '-', edtCliFor.Text, '-', IIF(edtSerie.Visible, edtSerie.Text, strSerFsc)));
        End;
        If (Not chkInutilizacao.Checked) Then
          strTextoExibicao := 'Documento identificado como inutilizado na SOVOS. Sincronizando Status com AUTCOM...';
        chkInutilizacao.Checked := True;
      End;
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fSatComIntegradorCitel(const strEspDoc : String) : Boolean;
begin
  Result := (fUsaIntegradorSatCitel) And (strEspDoc = 'IF');
end;

function TfrmCancelamentoDocumentos.fSuportaInterfaceGrafica : Boolean;
begin
  Result := True;
  If CancelandoNFViaFulFillment Then
    Exit(False);
  If FExecutandoCanceladorAutomatico Then
    Exit(False);
end;

class function TfrmCancelamentoDocumentos.fExecutarCancelamentoAutomatico(const AInput : TInputCancAut) : TOutputCancAut;
  Var
    frmCancelamentoDocumentos : TfrmCancelamentoDocumentos;
    intIndiceEsp : Integer;
begin
  pCriarFormularios(TfrmCancelamentoDocumentos, frmCancelamentoDocumentos);
  Try
    Result := Default(TOutputCancAut);
    frmCancelamentoDocumentos.edtNumDoc.Text := AInput.strNumDoc;
    frmCancelamentoDocumentos.edtCliFor.Text := AInput.strCliFor;
    frmCancelamentoDocumentos.edtSerie.Text := AInput.strSerie;
    If (AInput.strTipFC = 'C') Then
      frmCancelamentoDocumentos.edtDesCri.Text := fRetNomCliente(AInput.strCliFor)
    Else
      frmCancelamentoDocumentos.edtDesCri.Text := fRetNomFornecedor(AInput.strCliFor);
    frmCancelamentoDocumentos.edtNumDoc.Enabled := False;
    frmCancelamentoDocumentos.edtCliFor.Enabled := False;
    frmCancelamentoDocumentos.edtSerie.Enabled := False;
    frmCancelamentoDocumentos.btnCancelar.Enabled := False;
    frmCancelamentoDocumentos.lsbEspecies.Enabled := False;
    frmCancelamentoDocumentos.blnExecutandoCanceladorAutomatico := True;
    frmCancelamentoDocumentos.chkInutilizacao.Checked := AInput.blnInutilizacao;
    frmCancelamentoDocumentos.pSetEspecie(AInput.strOpcDel, intIndiceEsp);
    frmCancelamentoDocumentos.lsbEspecies.ItemIndex := intIndiceEsp;
    If (frmCancelamentoDocumentos.lsbEspecies.ItemIndex < 0) Then
      Raise Exception.Create(Format('Falha ao definir a opção de cancelamento no cancelador automatico - opcdel: %s', [AInput.strOpcDel]));
    frmCancelamentoDocumentos.lsbEspeciesDblClick(frmCancelamentoDocumentos.lsbEspecies);
    frmCancelamentoDocumentos.strDesMot := AInput.strDesMot;
    frmCancelamentoDocumentos.strMotDel := AInput.strMotDel;
    frmCancelamentoDocumentos.strHisCom := AInput.strHisCom;
    frmCancelamentoDocumentos.btnAdicionar.OnErro := Nil;// Importante para que o erro seja propagado corretamente.
    frmCancelamentoDocumentos.btnAdicionar.Click;
    Result.blnCancelamentoComitadoComSucesso := frmCancelamentoDocumentos.blnConfirma;
  Finally
    pFreeAndNil(frmCancelamentoDocumentos);
  End;
end;

procedure TfrmCancelamentoDocumentos.pProcessaEstornoAdiantamentoPedidosFaturados;
var
  intCont: Integer;
begin
  For intCont := Low(ArrayPedidos) To High(ArrayPedidos) Do
  Begin
    If ArrayPedidos[intCont].strEspPed = 'PD' Then
    Begin
      If (TFacadeCobrancaEletronica.fExisteAdiantamentoClienteCobrancaEletronica(
                   ArrayPedidos[intCont].strNumPed, ArrayPedidos[intCont].strEspPed,
                   ArrayPedidos[intCont].strEmpPed, tcPagarMe)) Then
      Begin
        TFacadeCobrancaEletronica.pProcessaEstornoAdiantamento(
                                    ArrayPedidos[intCont].strNumPed, ArrayPedidos[intCont].strEspPed,
                                    ArrayPedidos[intCont].strEmpPed, tcPagarMe);
      End;
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fLiberaCancelamentoDocumentoComCobrancaEletronica(
  const ANumDoc, AEspDoc, ACodEmp: String): Boolean;
begin
  objLiberacao.Clear;
  objLiberacao.strDirAce    := 'CANPME';
  objLiberacao.strCodOpe    := strLoginUsuarioLogado;
  objLiberacao.objMsgLibera.pAddTexto('O documento possui cobrança PAGAR.ME com status local ativo. ');
  objLiberacao.objMsgLibera.pAddTexto('Ao cancelar o documento, caso de link já esteja pago pelo cliente '
                                     +'por meio de cartão de crédito, o recebimento será estornado. ');
  objLiberacao.objMsgLibera.pAddTexto('Caso o pagamento do link tenha sido pago de qualquer outra forma, '
                                     +'será necessário proceder com o reembolso de forma manual. ');
  objLiberacao.objMsgLibera.pAddTexto('Se o link ainda está aguardando seu pagamento, o mesmo será '
                                     +'cancelado.');
  objLiberacao.pInformaNumDocEspDocCodEmp(ANumDoc, AEspDoc, ACodEmp);
  Result := objLiberacao.fLibera;
end;

end.

