function TfrmCancelamentoDocumentos.fNotaFiscalDenegada(strEspSel, strTipFc: String): Boolean;
   Var
    strStatus: String;
    lstrEspSel: String;
    lstrEspCan: String;
    lblnNf: Boolean;
    blnDifChvAcesso : Boolean;
begin
  Result := (Pos(strEspSel, ESPECIES_NOTA_DENEGADA) > 0);

  If Result Then
  Begin
    if blnNW_NFe then
    begin
      pGetEspecieCancelamento(lstrEspSel, lstrEspCan, lblnNf);
      strStatus := fStatusNFe(lstrEspCan, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), blnDifChvAcesso);
    end
    else
      strStatus := fStatusNFe(strEspSel, strTipFc, blnDifChvAcesso);
    Result := (strStatus = 'DN') Or (strStatus = 'DC');
  End;


end;

