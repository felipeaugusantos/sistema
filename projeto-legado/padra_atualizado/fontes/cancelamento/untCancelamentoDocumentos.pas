  End;
end;

function TfrmCancelamentoDocumentos.fVoltaCtrConfirmacao(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
  Var
    strCamposCtr: String;
    strValuesCtr: String;

    strSQL   : String;
    qryGenTmp: TUniQuery;

    strTabCadRec: String;
    strTabCtrCnf: String;

    function fTemRegCtrCnf(strNumDoc, strEspDoc, strCodEmp, strCodCli, strTab: String): Boolean;
      Var
        qryAux: TUniQuery;
    begin
      qryAux := fCriaQuery(Self);
      qryAux.SQL.Add('SELECT                     ');
      qryAux.SQL.Add('  COUNT(*) AS QTD          ');
      qryAux.SQL.Add('FROM                       ');
      qryAux.SQL.Add(' ' + strTab + ' ');
      qryAux.SQL.Add('WHERE                      ');
      qryAux.SQL.Add('  CTR_DOCCNF = :DOCCNF AND ');
      qryAux.SQL.Add('  CTR_ESPCNF = :ESPCNF AND ');
      qryAux.SQL.Add('  CTR_EMPCNF = :EMPCNF AND ');
      qryAux.SQL.Add('  CTR_CLICNF = :CLICNF AND ');
      qryAux.SQL.Add('  CTR_DTAREC IS NULL       ');

      qryAux.ParamByName('DOCCNF').AsString := strNumDoc;
      qryAux.ParamByName('ESPCNF').AsString := strEspDoc;
      qryAux.ParamByName('EMPCNF').AsString := strCodEmp;
      qryAux.ParamByName('CLICNF').AsString := strCodCli;
      qryAux.Open;

      Result := (qryAux.FieldByName('QTD').AsInteger > 0);

      qryAux.Close;
      FreeAndNil(qryAux);
    end;

    procedure pLimpaDeletadosCadRec(strNumDup, strParcel, strEspDoc, strCodCli, strCodEmp: String; intSeqBai: Integer);
      Var
        strDel: String;
    begin
      strDel := '';
      strDel := strDel +  ' DELETE ';
      strDel := strDel +  ' FROM DEL_' + strTabCadRec + ' ';
      strDel := strDel +  ' WHERE   CTR_NUMDUP = "' + strNumDup + '" ';
      strDel := strDel +  '     AND CTR_PARCEL = "' + strParcel + '" ';
      strDel := strDel +  '     AND CTR_ESPDOC = "' + strEspDoc + '" ';
      strDel := strDel +  '     AND CTR_CODCLI = "' + strCodCli + '" ';
      strDel := strDel +  '     AND CTR_CODEMP = "' + strCodEmp + '" ';
      strDel := strDel +  '     AND CTR_SEQBAI =  ' + IntToStr(intSeqBai);

      fExecutaSQL(strDel);
    end;

begin

  Try

    qryGenTmp := fCriaQuery(Self);

    strCamposCtr := VS_strCamposCtrCanDoc;
    strValuesCtr := VS_strValuesCtrCanDoc;

    If (fEmptyStr(strCamposCtr)) Or (fEmptyStr(strValuesCtr)) Then
    Begin
      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('DESC CADREC ');
        Open;

        While (Not Eof) Do
        Begin

          If (FieldByName('Field').AsString <> 'CTR_DOCCNF') And
             (FieldByName('Field').AsString <> 'CTR_ESPCNF') And
             (FieldByName('Field').AsString <> 'CTR_EMPCNF') And
             (FieldByName('Field').AsString <> 'CTR_CLICNF') Then
          Begin
            strCamposCtr := strCamposCtr + FieldByName('Field').AsString + ',';

            If (FieldByName('Field').AsString = 'CTR_FATCOM') Then
              strValuesCtr := strValuesCtr + ' CTR_VALCOM/CTR_VALDUP,'

            Else If (FieldByName('Field').AsString = 'CTR_FATREP') Then
              strValuesCtr := strValuesCtr + ' CTR_COMREP/CTR_VALDUP,'

            Else
              strValuesCtr := strValuesCtr + FieldByName('Field').AsString + ',';

          End;

          Next;
        End;

        Close;
      End;

      strCamposCtr := Copy(strCamposCtr, 1, Length(strCamposCtr)-1);
      strValuesCtr := Copy(strValuesCtr, 1, Length(strValuesCtr)-1);

      VS_strCamposCtrCanDoc := strCamposCtr;
      VS_strValuesCtrCanDoc := strValuesCtr;
    End;

    If (fTemRegCtrCnf(strNumDoc, strEspSel, VS_strCodEmp, strCodCli, 'CTRCNF')) Then
    Begin
      strTabCadRec := 'CADREC ';
      strTabCtrCnf := 'CTRCNF ';
    End
    Else
    Begin
      strTabCadRec := '';
      strTabCtrCnf := '';
    End;

    If Not fEmptyStr(strTabCadRec) Then
    Begin

      {*******************************************}
      {* CANCELA DOCUMENTOS CAIXA 1 ou 2         *}
      {****************************************MV*}
      strSQL := '';
      strSQL := strSQL + ' INSERT INTO ';
      strSQL := strSQL +   strTabCadRec + ' ';
      strSQL := strSQL + ' ( ' + strCamposCtr + ') ';
      strSQL := strSQL + '  SELECT ';
      strSQL := strSQL + strValuesCtr + ' ';
      strSQL := strSQL + '  FROM ';
      strSQL := strSQL +   strTabCtrCnf + ' ';
      strSQL := strSQL + '   WHERE ';
      strSQL := strSQL + '     CTR_DOCCNF = :DOCCNF AND ';
      strSQL := strSQL + '     CTR_ESPCNF = :ESPCNF AND ';
      strSQL := strSQL + '     CTR_EMPCNF = :EMPCNF AND ';
      strSQL := strSQL + '     CTR_CLICNF = :CLICNF AND ';
      strSQL := strSQL + '     CTR_DTAREC IS NULL ';

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('DOCCNF').AsString := strNumDoc;
        ParamByName('ESPCNF').AsString := strEspSel;
        ParamByName('EMPCNF').AsString := VS_strCodEmp;
        ParamByName('CLICNF').AsString := strCodCli;
        ExecSQL;
        Close;
      End;

      strSQL := '';
      strSQL := strSQL + ' SELECT * FROM ';
      strSQL := strSQL +     strTabCtrCnf + ' ';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '   CTR_DOCCNF = :DOCCNF AND ';
      strSQL := strSQL + '   CTR_ESPCNF = :ESPCNF AND ';
      strSQL := strSQL + '   CTR_EMPCNF = :EMPCNF AND ';
      strSQL := strSQL + '   CTR_CLICNF = :CLICNF ';

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('DOCCNF').AsString := strNumDoc;
        ParamByName('ESPCNF').AsString := strEspSel;
        ParamByName('EMPCNF').AsString := VS_strCodEmp;
        ParamByName('CLICNF').AsString := strCodCli;
        Open;

        While Not qryGenTmp.IsEmpty Do
        Begin
          {****************}
          {* GRAVA LOGCTR *}
          {*************WS*}
          untLogCtr.GravaLogCtr(qryGenTmp.FieldByName('CTR_NUMDUP').AsString,
                                qryGenTmp.FieldByName('CTR_ESPDOC').AsString,
                                qryGenTmp.FieldByName('CTR_CODCLI').AsString,
                                qryGenTmp.FieldByName('CTR_CODEMP').AsString,
                                qryGenTmp.FieldByName('CTR_PARCEL').AsString,
                                qryGenTmp.FieldByName('CTR_SEQBAI').AsInteger,
                                'INCLUSÃO',
                                Self.Name);

          pLimpaDeletadosCadRec(FieldByName('CTR_NUMDUP').AsString,
                                FieldByName('CTR_PARCEL').AsString,
                                FieldByName('CTR_ESPDOC').AsString,
                                FieldByName('CTR_CODCLI').AsString,
                                FieldByName('CTR_CODEMP').AsString,
                                FieldByName('CTR_SEQBAI').AsInteger);

          fVerificaIntegridade(Self.Name, strTabCtrCnf, qryGenTmp, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
          qryGenTmp.Delete;
        End;

        Close;
      End;

    End;

    Result := True;
  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fVoltaCtrConfirmacao]');
      Result := False;
    End;
  End;

  FreeAndNil(qryGenTmp);

end;

procedure TfrmCancelamentoDocumentos.pGeraResumo;
  Var
    blnGerarResumo: Boolean;
    intContador: Integer;
    blnCtp, blnCtr, blnCtpSer, blnCtpAgrup: Boolean;
    strConta : String;

    LDuplicataComPixGerado: Boolean;
begin
  blnCtpAgrup    := (lstCtpAgrupada.Count > 0) Or (lstCtpGnrAgrup.Count > 0) Or
                    (lstCtpCFrAgrup.Count > 0) Or (lstCtpAntAgrup.Count > 0) Or
                    (lstCtpServAgru.Count > 0);

  blnCtr         := (lstCtrBaixadas.Count > 0) Or (FCtrPixGerado.Count > 0);

  blnCtp         := (lstCtpBaixadas.Count > 0) Or (lstCtpGnrBaixa.Count > 0) Or
                    (lstCtpCFrBaixa.Count > 0) Or (lstCtpAntBaixa.Count > 0) Or
                    (lstCtpReteBaix.Count > 0);

  blnCtpSer      := (lstCtpServBaix.Count > 0);

  LDuplicataComPixGerado := FCtrPixGerado.Count > 0;

  blnGerarResumo := blnCtpAgrup Or blnCtr Or blnCtp Or blnCtpSer;

  If (blnGerarResumo) Then
  Begin

    If (blnCtr and blnCtp) Then
      strConta := 'contas a receber/contas a pagar'
    Else
      strConta := IIF(blnCtr or LDuplicataComPixGerado,'contas a receber', 'contas a pagar' );

    pCriarFormularios(TfrmCancelamentoDocResumo, frmCancelamentoDocResumo);
    Try
      If blnCtpAgrup Then
      Begin

        frmCancelamentoDocResumo.memResumo.Text := 'Há duplicatas agrupadas, não será permitido fazer o cancelamento!' + #13#10 + #13#10 +
                                                   lstCtpAgrupada.Text + lstCtpGnrAgrup.Text + lstCtpCFrAgrup.Text +
                                                   lstCtpAntAgrup.Text + lstCtpServAgru.Text;

        frmCancelamentoDocResumo.memResumo.Lines.Add('');
        frmCancelamentoDocResumo.memResumo.Lines.Add('');
      End

      Else If (Not blnCtpSer) And (Not LDuplicataComPixGerado) Then
      Begin
        frmCancelamentoDocResumo.memResumo.Lines.Add('Duplicatas que já foram baixadas e portanto não será permitido cancelar o documento! '+
                                                     'Será necessário realizar o estorno do ' + strConta + ' para cancelar este documento.');
        frmCancelamentoDocResumo.memResumo.Lines.Add('');

        For intContador := 0 To lstCtrBaixadas.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtrBaixadas[intContador]);

        frmCancelamentoDocResumo.memResumo.Lines.Add('');

        For intContador := 0 To lstCtpBaixadas.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtpBaixadas[intContador]);

        frmCancelamentoDocResumo.memResumo.Lines.Add('');

        For intContador := 0 To lstCtpReteBaix.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtpReteBaix[intContador]);

        frmCancelamentoDocResumo.memResumo.Lines.Add('');

        For intContador := 0 To lstCtpGnrBaixa.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtpGnrBaixa[intContador]);

        frmCancelamentoDocResumo.memResumo.Lines.Add('');

        For intContador := 0 To lstCtpCFrBaixa.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtpCFrBaixa[intContador]);

        For intContador := 0 To lstCtpAntBaixa.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtpAntBaixa[intContador]);
      End

      Else If LDuplicataComPixGerado Then
      Begin
        frmCancelamentoDocResumo.memResumo.Lines.Add('Duplicatas que possuem Pix gerado e em aberto! '+
                                                     'Será necessário remover o registro do Pix vinculado a duplicata.');

        frmCancelamentoDocResumo.memResumo.Lines.Add('');

        For intContador := 0 To FCtrPixGerado.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(FCtrPixGerado[intContador]);
      End

      Else
      Begin
        frmCancelamentoDocResumo.memResumo.Font.Name := 'Courier New';
        frmCancelamentoDocResumo.memResumo.Font.Size := 8;

        For intContador := 0 To lstCtpServBaix.Count -1 Do
          frmCancelamentoDocResumo.memResumo.Lines.Add(lstCtpServBaix[intContador]);
      End;

      If (FExecutandoCanceladorAutomatico) Then
        Raise ExceptionEstornoMalsucedido.Create(frmCancelamentoDocResumo.memResumo.Lines.Text)
      Else If CancelandoNFViaFulFillment Then
        objFulFillmentLogBuilder.pSalvarLog(frmCancelamentoDocResumo.memResumo.Lines.Text, True)
      Else
        frmCancelamentoDocResumo.ShowModal;
    Finally
      pFreeAndNil(frmCancelamentoDocResumo);
    End;

  End;
end;

procedure TfrmCancelamentoDocumentos.pGetEspecieCancelamento(var strEspSel,
                                                                 strEspCan         : String;
                                                             var blnNotaEletronica : Boolean);
  Var
    strEspecies: String;
    strNumDoc : String;
begin
  strNumDoc := edtNumDoc.Text;
  strEspecies := 'NS_NF_EL_OF_NI_NC_IC_ND_NG_NW_NP_EF_RL_DC_';

  If (fCfgSis('USNFCE', varBoolean)) Or fUsaSat Then
    strEspecies := strEspecies + 'IF_IV_';

  strEspSel := arrEspecies[intIndiceEsp][0];
  strEspCan := fRetornaEspecieCancelamento(strEspSel);

  If (Pos(strEspSel, strEspecies) > 0)  Then
    blnNotaEletronica := fVerificaNotaFiscalEletronica(strNumDoc, edtCliFor.Text, strEspCan);
end;

function TfrmCancelamentoDocumentos.fCancelaQuantidadeEmprestimo(fltQtdIte: Double; strKey_EP: String): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Try
    qryGen := fCriaQuery;
    With qryGen, SQL Do
    Begin

      Clear;
      Add('UPDATE MOVDET ');
      Add('SET DET_BAIEMP = IF(DET_BAIEMP - :QTDITE >= 0, DET_BAIEMP - :QTDITE, 0)');
      Add('WHERE ');
      Add('  DET_NUMDOC = :NUMDOC AND ');
      Add('  DET_ESPDOC = :ESPDOC AND ');
      Add('  DET_CODEMP = :CODEMP AND ');
      Add('  DET_IND_PD = :IND_PD     ');

      ParamByName('QTDITE').AsFloat := fltQtdIte;

      ParamByName('NUMDOC').AsString  := LeftStr(strKey_EP,fTamDocCadRec);
      ParamByName('ESPDOC').AsString  := Copy(strKey_EP,IfThen(fTamDocCadRec = 6, 8, 14),2);
      ParamByName('CODEMP').AsString  := Copy(strKey_EP,IfThen(fTamDocCadRec = 6, 11, 17),3);
      ParamByName('IND_PD').AsInteger := StrToInt(Copy(strKey_EP,IfThen(fTamDocCadRec = 6, 15, 21),Length(strKey_EP)-IfThen(fTamDocCadRec = 6, 14, 20)));

      ExecSQL;

    End;
    FreeAndNil(qryGen);

    Result := True;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[frmCancelamentoDocumentos.fCancelaQuantidadeEmprestimo]');
    End;
  End;

End;

function TfrmCancelamentoDocumentos.fCancelaPedidoCompraGarantiaRefugo(strAutIncPcd : String):Boolean;
  Var
    qryPcmDet : TUniQuery;
    strCampoSaldo,
    strNumPed,
    strCodEmp,
    strEspDoc,
    strNumCtn: String;

    strForFil: String;
    blnLibPcm: Boolean;
    intDEQTPC: Integer;
Begin
  Result := True;
  Try
    strForFil := fRetForFilialTodos;
    blnLibPcm := fCfgSis('LIBPCM', varBoolean);
    intDEQTPC := fCfgSis('DEQTPC', varInteger);

    qryPcmDet := fCriaQuery;
    With qryPcmDet, SQL Do
    Begin
      Try
        Close;
        Clear;
        Add('SELECT * FROM PCMDET WHERE AUTOINCREM = :AUTINC ');
        ParamByName('AUTINC').AsString := strAutIncPcd;
        Open;

        strNumPed := FieldByName('PCD_NUMPED').AsString;
        strCodEmp := FieldByName('PCD_CODEMP').AsString;
        strEspDoc := FieldByName('PCD_ESPDOC').AsString;
        strNumCtn := FieldByName('PCD_NUMCTN').AsString;

        fVerificaIntegridade(Self.Name, 'PCMDET', qryPcmDet, True, False, EmptyStr, fOperadorDoCancelamento);

        If qryPcmDet.RecordCount > 0 Then
        Begin
          strCampoSaldo := fRetCampoAtualizaSaldoPedidoCompra('',
                                                              strNumPed,
                                                              strCodEmp,
                                                              blnLibPcm,
                                                              strForFil);

          pEstornaSaldoItemPedidoCompra(strAutIncPcd, strCampoSaldo, intDEQTPC);

          qryPcmDet.Delete;
        End;

        Close;
        Clear;
        Add(' SELECT COUNT(0) AS QTD     ');
        Add(' FROM PCMDET                ');
        Add(' WHERE PCD_NUMPED = :NUMPED ');
        Add('   AND PCD_CODEMP = :CODEMP ');
        Add('   AND PCD_ESPDOC = :ESPDOC ');
        Add('   AND PCD_NUMCTN = :NUMCTN ');

        ParamByName('NUMPED').AsString := strNumPed;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('NUMCTN').AsString := strNumCtn;

        Open;

        If FieldByName('QTD').AsInteger = 0 Then
        Begin
          Close;
          Clear;
          Add(' SELECT *                   ');
          Add(' FROM PCMGER                ');
          Add(' WHERE PCG_NUMPED = :NUMPED ');
          Add('   AND PCG_CODEMP = :CODEMP ');
          Add('   AND PCG_ESPDOC = :ESPDOC ');
          Add('   AND PCG_NUMCTN = :NUMCTN ');

          ParamByName('NUMPED').AsString := strNumPed;
          ParamByName('CODEMP').AsString := strCodEmp;
          ParamByName('ESPDOC').AsString := strEspDoc;
          ParamByName('NUMCTN').AsString := strNumCtn;

          Open;

          fVerificaIntegridade(Self.Name, 'PCMGER', qryPcmDet, True, False, EmptyStr, fOperadorDoCancelamento);

          If qryPcmDet.RecordCount > 0 Then
            qryPcmDet.Delete;

        End;
      Except
        On E : Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message, 'TfrmCancelamentoDocumentos.fCancelaItenPedGarantiaRefugo');
        End;
      End;
    End;

  Finally
    FreeAndNil(qryPcmDet);
  End;

End;

function TfrmCancelamentoDocumentos.fCancelaItenPedGarantiaRefugo(strAutIncFdo : String):Boolean;
  Var
    qryFatDor : TUniQuery;
    strAutInc : String;
Begin
  Result := True;
  Try
    qryFatDor := fCriaQuery;
    With qryFatDor, SQL Do
    Begin
      Try
        Close;
        Clear;
        Add('SELECT * FROM DORICD WHERE ICD_SEQFDO = :AUTINC ');
        ParamByName('AUTINC').AsString := strAutIncFdo;
        Open;

        fVerificaIntegridade(Self.Name, 'DORICD', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);

        If qryFatDor.RecordCount > 0 Then
          qryFatDor.Delete;

        Close;
        Clear;
        Add('SELECT * FROM EXTDOR WHERE FDO_SEQFDO = :AUTINC ');
        ParamByName('AUTINC').AsString := strAutIncFdo;
        Open;

        fVerificaIntegridade(Self.Name, 'EXTDOR', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);

        If qryFatDor.RecordCount > 0 Then
          qryFatDor.Delete;

        Close;
        Clear;
        Add('SELECT * FROM FATDOR WHERE AUTOINCREM = :AUTINC ');
        ParamByName('AUTINC').AsString := strAutIncFdo;
        Open;

        strAutInc := FieldByName('FDO_SEQGER').AsString;

        fVerificaIntegridade(Self.Name, 'FATDOR', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);

        ReprocessarItem(qryFatDor.FieldByName('FDO_CODITE').AsString, '', True, True);

        If qryFatDor.RecordCount > 0 Then
          qryFatDor.Delete;

        Close;
        Clear;
        Add('SELECT COUNT(0) AS QTD FROM FATDOR WHERE FDO_SEQGER = :SEQGER ');
        ParamByName('SEQGER').AsString := strAutInc;
        Open;

        If FieldByName('QTD').AsInteger = 0 Then
        Begin
          Close;
          Clear;
          Add('SELECT * FROM EXTGOR WHERE FGO_SEQFGO = :AUTINC ');
          ParamByName('AUTINC').AsString := strAutInc;
          Open;

          fVerificaIntegridade(Self.Name, 'EXTGOR', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);

          If qryFatDor.RecordCount > 0 Then
            qryFatDor.Delete;

          Close;
          Clear;
          Add('SELECT * FROM FATGOR WHERE AUTOINCREM = :AUTINC ');
          ParamByName('AUTINC').AsString := strAutInc;
          Open;

          fVerificaIntegridade(Self.Name, 'FATGOR', qryFatDor, True, False, EmptyStr, fOperadorDoCancelamento);
          pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_FATGOR', strAutInc);

          If qryFatDor.RecordCount > 0 Then
            qryFatDor.Delete;

        End;
      Except
        On E : Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message, 'TfrmCancelamentoDocumentos.fCancelaItenPedGarantiaRefugo');
        End;
      End;
    End;

  Finally
    FreeAndNil(qryFatDor);
  End;

End;

function TfrmCancelamentoDocumentos.fCancelaItensOrcPed(strEspDoc, strNumDoc, strCliFor: String;
  strEmpDoc: String = ''): Boolean;
  Var
    blnParcial        : Boolean;
    blnDocumentoExiste: Boolean;

    strArqGer: String;
    strArqDet: String;
    strSigGer: String;
    strSigDet: String;
    strSQL   : String;
    strCodEmp: String;
    qryGenFor: TUniQuery;
    qryExtDor : TUniQuery;
    qryExtGor : TUniQuery;
    qryDorIcd : TUniQuery;
    qryLotDor : TUniQuery;
    InvokerUpdPromo: IInvokerUpdatePromo;

begin
  strCodEmp := IIF(fEmptyStr(strEmpDoc), VS_strCodEmp, strEmpDoc);

  If fPedidoGerouOrdProd(strNumDoc, strCodEmp) Then
  Begin
    Result := False;
    Exit;
  End;

  Try
    Result := True;

    qryGenFor := fCriaQuery(Self);

    blnDocumentoExiste := False;

    strArqGer := 'FATGOR';
    strArqDet := 'FATDOR';

    strSigGer := 'FGO_';
    strSigDet := 'FDO_';

    strSQL := '';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  *      ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  EXTDOR ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  FDO_SEQFDO = :SEQFDO ';

    qryExtDor := fCriaQuery(Self);
    qryExtDor.Close;
    qryExtDor.SQL.Clear;
    qryExtDor.SQL.Add(strSQL);

    strSQL := '';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  *      ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  EXTGOR ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  FGO_SEQFGO = :SEQFGO ';

    qryExtGor := fCriaQuery(Self);
    qryExtGor.Close;
    qryExtGor.SQL.Clear;
    qryExtGor.SQL.Add(strSQL);

    strSQL := '';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  *      ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  DORICD ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  ICD_SEQFDO = :SEQFDO ';

    qryDorIcd := fCriaQuery(Self);
    qryDorIcd.Close;
    qryDorIcd.SQL.Clear;
    qryDorIcd.SQL.Add(strSQL);

    strSQL := '';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  *      ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  LOTDOR ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  LDO_SEQFDO = :SEQFDO ';

    qryLotDor := fCriaQuery(Self);
    qryLotDor.Close;
    qryLotDor.SQL.Clear;
    qryLotDor.SQL.Add(strSQL);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + strArqDet + ' ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + strSigDet + strTipFc + ' = :CLIFOR AND ';
    strSQL := strSQL + strSigDet + 'NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + strSigDet + 'ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + strSigDet + 'CODEMP = :CODEMP ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CLIFOR').AsString := strCliFor;
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      If (Not IsEmpty) Then
        blnDocumentoExiste := True;

      If (blnDocumentoExiste) Then
      Begin

        blnParcial := False;
        While (Not Eof) Do
        Begin
          If (FieldByName('FDO_QTDBAI').AsFloat > 0.0) Then
          Begin
            blnParcial := True;
            Break;
          End;
          Next;
        End;

        If (blnParcial) Then
        Begin
          fRollBack;
          fMensagem('ATENÇÃO!', 'Este pedido foi confirmado nos documentos mostrados a seguir.' + #13#10 +
                                'É necessário cancela-los para cancelar o pedido!', ['&Ok']);

          If Assigned(prcExecutaRelatorio) Then
          begin
            prcExecutaRelatorio(150, 6933, [],
                                ['NUMPED','ESPPED','EMPPED'],
                                [strNumDoc, strEspDoc, strCodEmp],
                                nil,
                                nil,
                                True);
          End;

          Result := False;
          pAtribuiPicture(Nil);
          Exit;
        End;
      End;

      If Result And VS_strHabilitarCRM And (strEspDoc <> 'PR') Then
      Begin
        pFinalizarOcorrenciaDocumentoCancelado(FieldByName('FDO_NUMDOC').AsString,
                                               FieldByName('FDO_ESPDOC').AsString,
                                               FieldByName('FDO_CODCLI').AsString,
                                               FieldByName('FDO_CODEMP').AsString,
                                               IIF(SameText(strTipFc,'CODFOR'), 'F','C'));
      End;

      First;
      While (Not Eof) Do
      Begin

        If Not fEmptyStr(FieldByName('FDO_KEY_EP').AsString) Then
        Begin
          If Not fCancelaQuantidadeEmprestimo(FieldByName('FDO_QTDITE').AsFloat, FieldByName('FDO_KEY_EP').AsString) Then
          Begin
            FreeAndNil(qryGenFor);
            Result := False;
            Exit;
          End;
        End;

        {*******************************************}
        {* GRAVA NOS ARQUIVOS DELETADOS            *}
        {****************************************MV*}
        pGravaDeletadoEftGer(qryTemp01.FieldByName(strSigDet + 'NUMDOC').AsString,
          qryTemp01.FieldByName(strSigDet + 'ESPDOC').AsString,
          qryTemp01.FieldByName(strSigDet + 'CODEMP').AsString,
          qryTemp01.FieldByName(strSigDet + 'CODACA').AsString,
          qryTemp01.FieldByName(strSigDet + 'EMPACA').AsString);

        If fUsaFlex(FieldByName(strSigDet + 'CODITE').AsString) Then
        Begin
          TMovFlex.pExcluir(qryTemp01.FieldByName(strSigDet + 'NUMDOC').AsString,
                            qryTemp01.FieldByName(strSigDet + 'ESPDOC').AsString,
                            qryTemp01.FieldByName(strSigDet + 'CODEMP').AsString,
                            qryTemp01.FieldByName(strSigDet + 'CODCLI').AsString,
                            qryTemp01.FieldByName(strSigDet + 'CODITE').AsString,
                            qryTemp01.FieldByName('AUTOINCREM').AsString,
                            True,
                            fMotivoDelecao);
        End;

        qryLotDor.Close;
        qryLotDor.ParamByName('SEQFDO').AsString := FieldByName('AUTOINCREM').AsString;
        qryLotDor.Open;

        fVerificaIntegridade(Self.Name, 'LOTDOR', qryLotDor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        fVerificaIntegridade(Self.Name, strArqDet, qryTemp01, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        qryExtDor.Close;
        qryExtDor.ParamByName('SEQFDO').AsString := FieldByName('AUTOINCREM').AsString;
        qryExtDor.Open;

        fVerificaIntegridade(Self.Name, 'EXTDOR', qryExtDor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        qryDorIcd.Close;
        qryDorIcd.ParamByName('SEQFDO').AsString := FieldByName('AUTOINCREM').AsString;
        qryDorIcd.Open;

        fVerificaIntegridade(Self.Name, 'DORICD', qryDorIcd, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        pGravaDeletadosMadeira(FieldByName('AUTOINCREM').AsString, strArqDet);

        {******************************************}
        {* SE TIVER ITENS DE PROMOÇÃO             *}
        {***************************************FS*}
        If FieldByName(strSigDet + 'PROMOC').AsString = 'S' Then
        Begin
          If (Not Assigned(InvokerUpdPromo)) Then
            InvokerUpdPromo := TInvokerUpdatePromo.New();

          InvokerUpdPromo.pAdd(TUpdatePromo.New(
                                 TParametrosPromocao.New()
                                   .CodIte(FieldByName(strSigDet + 'CODITE').AsString)
                                   .CodEmp(FieldByName(strSigDet + 'CODEMP').AsString)
                                   .CodCli(FieldByName(strSigDet + 'CODCLI').AsString)
                               ));
        End;

        ReprocessarItem(FieldByName(strSigDet + 'CODITE').AsString, '', True, True);

        Next;
      End;
      Close;

    End;

    {*******************************************}
    {* GRAVA NOS ARQUIVOS DELETADOS            *}
    {****************************************MV*}
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + strArqGer + ' ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + strSigGer + strTipFc + ' = :CLIFOR AND ';
    strSQL := strSQL + strSigGer + 'NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + strSigGer + 'ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + strSigGer + 'CODEMP = :CODEMP ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CLIFOR').AsString := strCliFor;
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      If Assigned(objConEnt) And (strEspDoc = 'PD') And (FieldByName('FGO_ENTFAT').AsString = 'S') Then
      Begin
        objConEnt.fSetNumDoc(ParamByName('NUMDOC').AsString,
                             ParamByName('ESPDOC').AsString,
                             ParamByName('CODEMP').AsString,
                             ParamByName('CLIFOR').AsString);

        If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
        Begin
          objConEnt.pCarregaArrayDatasPeloPedOrc(objConEnt.arrDtaEmpOri);
          objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas; //Referente ao Pedido //Tirar reserva destas datas
        End
        Else
        Begin
          objConEnt.pCarregaArrayDatasPeloPedOrc(objConEnt.arrDtaOri);
          objConEnt.fProcessaArrayDatasControleEntregaRomaneio; //Referente ao Pedido //Tirar reserva destas datas
        End;

      End
      Else If (strEspDoc = 'OR') And
              (fCfgSis('USADEP') = 'S') Then
      Begin
        If fCampoTabela('FGO_USADEP', 'EXTGOR', ['FGO_SEQFGO'], [qryTemp01.FieldByName('AUTOINCREM').AsString]) = 'S' Then
          TValidacoesSistemaDEPS.pGravaLogDeStatusDoSistemaDEPS(qryTemp01.FieldByName('AUTOINCREM').AsString,
                                                                'CANCELAMENTO');
      End;

      qryExtGor.Close;
      qryExtGor.ParamByName('SEQFGO').AsString := FieldByName('AUTOINCREM').AsString;
      qryExtGor.Open;

      fVerificaIntegridade(Self.Name, 'EXTGOR', qryExtGor, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

      fVerificaIntegridade(Self.Name, strArqGer, qryTemp01, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
      pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_'+strArqGer, FieldByName('AUTOINCREM').AsString);

      Close;
    End;

    If (strArqGer = 'FATGOR') Then
    Begin
      pDeletaMovCarPedidoEcommerce(strNumDoc, strEspDoc, strCodEmp);

      If fCfgSis('CUPDES') = 'S' Then
        TFatCupomDesconto.DesmarcarCupomUtilizado(strNumDoc, strEspDoc, strCodEmp);
    End;


    {Envia Mensagens}
    If (strArqGer = 'FATGOR') and (strEspDoc = 'PD') Then
      pMensagemCancelamentoPedido(strNumDoc,
                                  strEspDoc,
                                  strCodEmp);

    {*REQ.173491**********RP*}
    TLogGor.pLogDel(strNumDoc, strEspDoc, strCodEmp);

    strSQL := '';
    strSQL := strSQL + 'DELETE FROM ';
    strSQL := strSQL + strArqGer;
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + strSigGer + strTipFc + ' = :CLIFOR AND ';
    strSQL := strSQL + strSigGer + 'NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + strSigGer + 'ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + strSigGer + 'CODEMP = :CODEMP ';

    With qryGenFor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CLIFOR').AsString := strCliFor;
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ExecSQL;
      Close;
    End;

    pLimparDocumentoBrinde(strNumDoc, strEspDoc, strCodEmp);

    imgItensNota.Picture := imgAlterado.Picture;
    imgDadosNota.Picture := imgAlterado.Picture;

    {******************************************}
    {* ATUALIZA OS ITENS DE PROMOÇÃO          *}
    {***************************************FS*}
    If Assigned(InvokerUpdPromo) And ((strEspDoc <> 'OR') Or (fCfgSis('DOCPRO', varString) = '1')) Then
      InvokerUpdPromo.fAtualizaQtdDisponivel();

    If (Not blnDocumentoExiste) Then
    Begin
      fRollBack;
      Result := False;
      pAtribuiPicture(Nil);
      fMensagem('', 'Esse documento não existe!', ['&Ok']);
    End;

    FreeAndNil(qryExtDor);
    FreeAndNil(qryExtGor);
    FreeAndNil(qryDorIcd);
    FreeAndNil(qryLotDor);

  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaItensOrcPed]');
      Result := False;
    End;
  End;

  FreeAndNil(qryGenFor);

end;

{*******************************************}
{* CANCELA LANCAMENTOS REFERENTES À TRANS- *}
{* FERÊNCIA DE ESTOQUE EM ML               *}
{****************************************MV*}
procedure TfrmCancelamentoDocumentos.pCancelaDocumentosTransfEstoqueMl(
  strNumDoc, strEspDoc: String; Var blnDocumentoExiste: Boolean);
  Var
    strSQL   : String;
    qryGenDet: TUniQuery;
    qryGenGer: TUniQuery;
    dtaDtaBal : TDate;

  procedure pGravarDELTabelasAuxiliares(strTabela, strCampo, strValor: String);
    Var
      qryGen: TUniQuery;
  begin
    qryGen := fCriaQuery(Self);
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT * FROM ' + strTabela + ' WHERE ' + strCampo + ' = ' + QuotedStr(strValor));
      Open;
      First;
      While Not Eof Do
      Begin
        fVerificaIntegridade(Self.Name, strTabela, qryGen, True, False, EmptyStr, fOperadorDoCancelamento);
        Next;
      End;
    End;
    FreeAndNil(qryGen);
  end;

  function fDataAnteriorAoBalanco(const AFieldData : TField; const ADtaBal : TDate) : Boolean;
  begin
    Result := False;

    If Not Assigned(AFieldData) Then
      Exit;

    If AFieldData.IsNull Then
      Exit;

    If (AFieldData.AsDateTime >= dtaDtaBal) Then
      Exit;

    Result := True;
  end;

begin
  qryGenDet := fCriaQuery(Self);
  qryGenGer := fCriaQuery(Self);

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  * ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVDET ';
  strSQL := strSQL + 'WHERE ';
  If strEspDoc <> 'AJ' Then
    strSQL := strSQL + '  DET_JAFATU = 1 AND ';
  strSQL := strSQL + '  DET_NUMFAT = :NUMFAT AND ';
  strSQL := strSQL + '  DET_TIPFAT = :TIPFAT AND ';
  strSQL := strSQL + '  DET_EMPFAT = :CODEMP AND ';
  strSQL := strSQL + '  DET_ESPDOC IN ("ML") ';

  With qryGenDet Do
  Begin

    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMFAT').AsString := strNumDoc;
    ParamByName('TIPFAT').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;

    If Not IsEmpty Then
      blnDocumentoExiste := True;

    {*******************************************}
    {* ATUALIZA ESTOQUE                        *}
    {****************************************MV*}
    While (Not Eof) Do
    Begin

      dtaDtaBal := fRetornaDataBalanco(FieldByName('DET_CODITE').AsString, FieldByName('DET_CODEMP').AsString);
      If (dtaDtaBal < VS_Date) Then
      Begin

        If Not fDataAnteriorAoBalanco(FieldByName('DET_DTAENT'), dtaDtaBal) Then
        Begin
          {*******************************************}
          {* CASO SEJA SAIDA, SOMA NO ESTOQUE, SENÃO *}
          {* TIRA DO ESTOQUE                         *}
          {****************************************MV*}
          If LeftStr(FieldByName('DET_CLAFIS').AsString, 1) >= '5' Then
          Begin
            fAtualizaEstoqueML(FieldByName('DET_CODITE').AsString,
                              -FieldByName('DET_QTDITE').AsFloat,
                               FieldByName('DET_NUMLOT').AsString)
          End
          Else
          Begin
            fAtualizaEstoqueML(FieldByName('DET_CODITE').AsString,
                               FieldByName('DET_QTDITE').AsFloat,
                               FieldByName('DET_NUMLOT').AsString)
          End;
        End;

      End;

      {*******************************************}
      {* GRAVA NOS ARQUIVOS DELETADOS            *}
      {****************************************MV*}
      fVerificaIntegridade(Self.Name, 'MOVDET', qryGenDet, True, False, EmptyStr, fOperadorDoCancelamento);
      pGravarDELTabelasAuxiliares('MOVTRI', 'DET_SEQGER', qryGenDet.FieldByName('AUTOINCREM').AsString);
      pGravarDELTabelasAuxiliares('MOVREF', 'REF_SEQGER', qryGenDet.FieldByName('AUTOINCREM').AsString);
      pGravarDELTabelasAuxiliares('MOVITE', 'ITE_SEQGER', qryGenDet.FieldByName('AUTOINCREM').AsString);

      Next;

    End;

    If Not IsEmpty Then
    Begin
      {*******************************************}
      {* GRAVA NOS ARQUIVOS DELETADOS            *}
      {****************************************MV*}
      strSQL := '';
      strSQL := strSQL + ' SELECT * ';
      strSQL := strSQL + '   FROM MOVGER  ';
      strSQL := strSQL + '  WHERE ';
      strSQL := strSQL + '    GER_JAFATU = 1 AND ';
      strSQL := strSQL + '    GER_NUMFAT = :NUMFAT AND ';
      strSQL := strSQL + '    GER_TIPFAT = :TIPFAT AND ';
      strSQL := strSQL + '    GER_EMPFAT = :CODEMP AND ';
      strSQL := strSQL + '    GER_ESPDOC IN ("ML") ';

      With qryGenGer Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        Open;
      End;

      qryGenGer.First;

      While Not qryGenGer.Eof Do
      Begin
        fVerificaIntegridade(Self.Name, 'MOVGER', qryGenGer, True, False, EmptyStr, fOperadorDoCancelamento);
        pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_MOVGER', qryGenGer.FieldByName('AUTOINCREM').AsString);

        pGravarDELTabelasAuxiliares('AUXMOV', 'AUX_SEQGER', qryGenGer.FieldByName('AUTOINCREM').AsString);
        pGravarDELTabelasAuxiliares('MOVOBS', 'MOV_SEQGER', qryGenGer.FieldByName('AUTOINCREM').AsString);
        qryGenGer.Next;
      End;

    End;

    Close;

  End;

  {*******************************************}
  {* APAGA DOCUMENTOS                        *}
  {****************************************MV*}
  {**********************************************}
  {* SEGUNDO A ESPECIE DO DOCUMENTO FATURADO    *}
  {* SELECIONA TABELA "MOVGER"                  *}
  {*******************************************JC*}
  strSQL := '';
  strSQL := strSQL + ' DELETE FROM MOVGER ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '   GER_JAFATU = 1 AND ';
  strSQL := strSQL + '   GER_NUMFAT = :NUMFAT AND ';
  strSQL := strSQL + '   GER_TIPFAT = :TIPFAT AND ';
  strSQL := strSQL + '   GER_EMPFAT = :CODEMP AND ';
  strSQL := strSQL + '   GER_ESPDOC IN ("ML") ';

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMFAT').AsString := strNumDoc;
    ParamByName('TIPFAT').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    ExecSQL;
    Close;
  End;

  strSQL := AnsiReplaceStr(strSQL, 'MOVGER', 'MOVDET');
  strSQL := AnsiReplaceStr(strSQL, 'GER_', 'DET_');

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMFAT').AsString := strNumDoc;
    ParamByName('TIPFAT').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    ExecSQL;
    Close;
  End;

  FreeAndNil(qryGenDet);
  FreeAndNil(qryGenGer);

end;

procedure TfrmCancelamentoDocumentos.pAtualizaCancelamentoFaturamentoPedido(
  strNumDoc, strEspDoc, strCodEmp: String);
var
  qryExtGor: TUniQuery;
begin
  qryExtGor := fCriaQuery;

  try
    qryExtGor.Close;
    qryExtGor.SQL.Clear;
    qryExtGor.SQL.Add('UPDATE FATGOR');
    qryExtGor.SQL.Add('INNER JOIN EXTGOR');
    qryExtGor.SQL.Add('ON(FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO)');
    qryExtGor.SQL.Add('SET EXTGOR.FGO_CANFAT = 1');
    qryExtGor.SQL.Add('WHERE FATGOR.FGO_NUMDOC = :NUMDOC');
    qryExtGor.SQL.Add('AND FATGOR.FGO_ESPDOC = :ESPDOC');
    qryExtGor.SQL.Add('AND FATGOR.FGO_CODEMP = :CODEMP');

    qryExtGor.ParamByName('NUMDOC').AsString := strNumDoc;
    qryExtGor.ParamByName('ESPDOC').AsString := strEspDoc;
    qryExtGor.ParamByName('CODEMP').AsString := strCodEmp;

    qryExtGor.ExecSQL;
  finally
    FreeAndNil(qryExtGor);
  end;
end;

