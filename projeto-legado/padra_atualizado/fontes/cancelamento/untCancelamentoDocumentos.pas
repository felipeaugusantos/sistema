function TfrmCancelamentoDocumentos.fCancelaContasPagarGNRE(strEspDoc, strNumDoc, strCliFor, strSerie: String;  TipoGuia: TTipoGuia = tgGNRE): Boolean;
  Var
    intRecordCount: Integer;
    strArqCtpDet  : String;

    strSQL   : String;
    strDupDel: String;
    strArqCtp: String;
    blnDupPar: Boolean;
    qryGenTmp: TUniQuery;
begin
  qryGenTmp := fCriaQuery(Self);

  Try
    Result := True;
    strDupDel    := '';

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CADPAG.* ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADPAG ';

    strSQL := strSQL + 'INNER JOIN ';
    case TipoGuia of
      tgGNRE: strSQL := strSQL + ' CADGNR ON CONCAT("GNRE00", GNR_NUMGNR) = CTP_NUMDUP AND ';
      tgTCIF: strSQL := strSQL + ' GNRTCI ON CONCAT("TCIF00", GNR_NUMGNR) = CTP_NUMDUP AND ';
      tgTS  : strSQL := strSQL + ' GNR_TS ON CONCAT("TS00", GNR_NUMGNR) = CTP_NUMDUP AND ';
    end;
    strSQL := strSQL + '  GNR_CODEMP = CTP_CODEMP                   AND ';
    strSQL := strSQL + '  GNR_CODFOR = CTP_CODFOR                   AND ';
    strSQL := strSQL + '  IFNULL(CTP_SERIE_, "") = ""                   ';

    strSQL := strSQL + 'WHERE ';

    strSQL := strSQL + '  GNR_NUMDOC = :NUMDUP AND ';
    strSQL := strSQL + '  GNR_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  GNR_FORDOC = :CODFOR AND ';

    If (fEmptyStr(strSerie)) Then
      strSQL := strSQL + '((GNR_SERIE_ IS NULL) OR (GNR_SERIE_ = "")) AND '
    Else
      strSQL := strSQL + 'GNR_SERIE_ = :SERIE_ AND ';

    strSQL := strSQL + '  CTP_CODEMP = :CODEMP ';

    If TipoGuia  = tgGNRE Then
      strSQL := strSQL + ' UNION ALL ' + StringReplace(strSQL, 'GNRE00', 'GARE00', []);

    strSQL := strSQL + ' ORDER BY 1, 2, 5 ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDUP').AsString := strNumDoc;
      ParamByName('CODFOR').AsString := strCliFor;
      If (Not fEmptyStr(strSerie)) Then
        ParamByName('SERIE_').AsString := strSerie;

      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;
      intRecordCount := RecordCount;

      lstCtpGnrBaixa.Clear;

      While (Not Eof) Do
      Begin

        blnDupPar := fCtpBaixadaParcial(qryTemp01);

        If (FieldByName('CTP_VALDUP').AsFloat = 0) Or (blnDupPar) Then
        Begin

          lstCtpGnrBaixa.Add(FieldByName('CTP_NUMDUP').AsString +
                             FieldByName('CTP_PARCEL').AsString + ' Loja: ' +
                             FieldByName('CTP_CODEMP').AsString);
          Next;
          Continue;
        End;

        strArqCtp    := 'CADPAG';
        strArqCtpDet := 'CTPDET';

        {*******************************************}
        {* SELECIONA O REGISTRO NO CTPDET PARA SER *}
        {* GRAVADO NOS DELETADOS                   *}
        {****************************************MV*}
        strSQL := '';
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  * ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL + strArqCtpDet + ' ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  CTP_NUMDUP = :NUMDUP AND ';
        strSQL := strSQL + '  CTP_PARCEL = :PARCEL AND ';

        If (FieldByName('CTP_SERIE_').IsNull) Then
          strSQL := strSQL + '  ((CTP_SERIE_ IS NULL) OR (CTP_SERIE_ = "")) AND '
        Else
          strSQL := strSQL + '  CTP_SERIE_ = :SERIE_ AND ';

        strSQL := strSQL + '  CTP_CODFOR = :CODFOR AND ';
        strSQL := strSQL + '  CTP_CODEMP = :CODEMP ';

        qryTemp02.Close;
        qryTemp02.SQL.Clear;
        qryTemp02.SQL.Add(strSQL);
        qryTemp02.ParamByName('NUMDUP').AsString := FieldByName('CTP_NUMDUP').AsString;
        qryTemp02.ParamByName('PARCEL').AsString := FieldByName('CTP_PARCEL').AsString;

        If (Not FieldByName('CTP_SERIE_').IsNull) Then
