function TfrmCancelamentoDocumentos.fPedidoVendaVinculadoANFdeEntrada(strNumDoc, strCliFor: String): Boolean;
Var
  strSQL: String;
  qryGen: TUniQuery;
begin

  Try

    qryGen := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  D.AUTOINCREM ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  FATDOR D INNER JOIN SEQGAR G ON D.AUTOINCREM = G.SEQ_FATDOR ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  D.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  D.FDO_CODCLI = :FORCLI AND ';
    strSQL := strSQL + '  D.FDO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  D.FDO_ESPDOC = "PD"    AND ';
    strSQL := strSQL + '  IFNULL(G.SEQ_PCMDET,"") <> "" ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('FORCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      Result := (Not IsEmpty);

      If Result then
        fMensagemCancelamento('ATENÇÃO!', 'Este pedido está vinculado a uma ENTRADA DE TRANSFERÊNCIA ' + #13 +
                              'e não pode ser cancelado!', ['&Ok']);

    End;

  Finally
    FreeAndNil(qryGen);
  End;

end;


function TfrmCancelamentoDocumentos.fPedidoReservaEstoqueOrdemProducaoIndustrial(strNumDoc, strCliFor: String): Boolean;
Var
  qryGen: TUniQuery;
begin

  qryGen := fCriaQuery(Self);
  Try
    qryGen.SQL.Add('SELECT                                                 ');
    qryGen.SQL.Add('  CONCAT(ORD_CODORD, "-", ORD_DTACAD) AS OP            ');
    qryGen.SQL.Add('FROM                                                   ');
    qryGen.SQL.Add('  FATGOR                                               ');
    qryGen.SQL.Add('  INNER JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM  ');
    qryGen.SQL.Add('  INNER JOIN ORDGER ON ORDGER.AUTOINCREM = FGO_ORDIND  ');
    qryGen.SQL.Add('WHERE FGO_NUMDOC = :NUMDOC                             ');
    qryGen.SQL.Add('  AND FGO_CODCLI = :FORCLI                             ');
    qryGen.SQL.Add('  AND FGO_CODEMP = :CODEMP                             ');
    qryGen.SQL.Add('  AND FGO_ESPDOC = "PD"                                ');


    qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
    qryGen.ParamByName('FORCLI').AsString := strCliFor;
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGen.Open;

    Result := (Not qryGen.IsEmpty);

    If Result then
      fMensagemCancelamento('ATENÇÃO!', 'Este pedido de reserva de estoque está vinculado à OP: ' + qryGen.FieldByName('OP').AsString + #13 +
                            'e não pode ser cancelado!', ['&Ok']);


  Finally
    FreeAndNil(qryGen);
  End;

end;

function TfrmCancelamentoDocumentos.fPedidoVendaVinculadoAGarantia(strNumDoc,
  strCliFor: String): Boolean;
Var
  strSQL: String;
  qryGen: TUniQuery;
begin

  Try

    qryGen := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  D.AUTOINCREM ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  FATDOR D INNER JOIN SEQGAR G ON D.AUTOINCREM = G.SEQ_FDO_TE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  D.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  D.FDO_CODCLI = :FORCLI AND ';
    strSQL := strSQL + '  D.FDO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  D.FDO_ESPDOC = "PD"    AND ';
    strSQL := strSQL + '  IFNULL(G.SEQ_MOVGAD,"") <> ""; ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('FORCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      Result := (Not IsEmpty);

      If Result then
        fMensagemCancelamento('ATENÇÃO!', 'Este pedido está vinculado a um RECEBIMENTO DE CLIENTE ' + #13 +
                              'e não pode ser cancelado!', ['&Ok']);

    End;

  Finally
    FreeAndNil(qryGen);
  End;

end;

function TfrmCancelamentoDocumentos.fCancelaPedidoVenda(strNumPed, strEspDoc,
strCodFor: String): Boolean;
  Var
    strSQL: String;
    qryGenGer,
    qryGenDel : TUniQuery;
    blnCancelandoRecebimentoCliente: Boolean;
    Msg: String;
    StatusPedido: TStatusPedido;
begin
  Result := True;

  Try

    qryGenGer := fCriaQuery(Self);

    strSQL := '';

    If (Pos(strEspDoc,'NF_PD_') > 0) Then
    Begin
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  F.FDO_NUMDOC AS NUMDOC, ';
      strSQL := strSQL + '  F.FDO_CODCLI AS CODCLI, ';
      strSQL := strSQL + '  F.FDO_SEQGER AS AUTINCGOR, ';
      strSQL := strSQL + '  F.AUTOINCREM AS AUTINCDOR, ';
      strSQL := strSQL + '  F.FDO_ESPDOC AS ESPDOC, ';
      strSQL := strSQL + '  F.FDO_CODEMP AS CODEMP  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  MOVDET D              ';
      strSQL := strSQL + '  INNER JOIN PCMDET P ON P.PCD_NUMPED = D.DET_PEDCOM ';
      strSQL := strSQL + '  INNER JOIN SEQGAR S ON P.AUTOINCREM = S.SEQ_PCMDET ';
      strSQL := strSQL + '  INNER JOIN FATDOR F ON F.AUTOINCREM = S.SEQ_FATDOR ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '      D.DET_NUMDOC = :NUMPED ';
      strSQL := strSQL + '  AND D.DET_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '  AND D.DET_CODEMP = :CODEMP ';
      strSQL := strSQL + '  AND D.DET_CODFOR = :CLIFOR ';
    end
    Else If (Pos(strEspDoc,'GA_')> 0) Then
    Begin
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  F.FDO_NUMDOC AS NUMDOC, ';
      strSQL := strSQL + '  F.FDO_CODCLI AS CODCLI, ';
      strSQL := strSQL + '  F.FDO_SEQGER AS AUTINCGOR, ';
      strSQL := strSQL + '  F.AUTOINCREM AS AUTINCDOR, ';
      strSQL := strSQL + '  F.FDO_ESPDOC AS ESPDOC, ';
      strSQL := strSQL + '  F.FDO_CODEMP AS CODEMP  ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  MOVDET D  ';
      strSQL := strSQL + ' INNER JOIN MOVGRC C     ON C.GRC_SEQDET  = D.AUTOINCREM ';
      strSQL := strSQL + ' INNER JOIN MOVGAD D1    ON D1.AUTOINCREM = C.GRC_SEQGAD ';
      strSQL := strSQL + ' INNER JOIN MOVGAG G     ON G.AUTOINCREM  = D1.GAD_SEQGAG ';
      strSQL := strSQL + ' INNER JOIN SEQGAR S     ON D1.AUTOINCREM = S.SEQ_MOVGAD ';
      strSQL := strSQL + ' INNER JOIN FATDOR F     ON F.AUTOINCREM  = S.SEQ_FDO_TE ';

      strSQL := strSQL + 'WHERE G.GAG_NUMENT = :NUMPED ';
      strSQL := strSQL + '  AND D.DET_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '  AND D.DET_CODEMP = :CODEMP ';
      strSQL := strSQL + '  AND D.DET_CODCLI = :CLIFOR ';
    end
    else if (Pos(strEspDoc,'NW_')> 0)  then
    begin
      strSql := ' SELECT  ';
      strSQL := strSQL + ' FATDOR.FDO_NUMDOC AS NUMDOC, ';
      strSQL := strSQL + ' FATDOR.FDO_CODCLI AS CODCLI, ';
      strSQL := strSQL + ' FATDOR.FDO_SEQGER AS AUTINCGOR, ';
      strSQL := strSQL + ' FATDOR.AUTOINCREM AS AUTINCDOR, ';
      strSQL := strSQL + ' FATDOR.FDO_ESPDOC AS ESPDOC, ';
      strSQL := strSQL + ' FATDOR.FDO_CODEMP AS CODEMP  ';
      strSQL := strSQL + ' FROM MOVGAG ';
      strSQL := strSQL + '   INNER JOIN MOVGAD ON GAD_SEQGAG = MOVGAG.AUTOINCREM  ';
      strSQL := strSQL + '   INNER JOIN MOVGRC ON GRC_SEQGAD = MOVGAD.AUTOINCREM AND GRC_OPCDOC IN (''NE'',''OE'',''DV'') ';
      strSQL := strSQL + '   INNER JOIN MOVDET  ON MOVDET.AUTOINCREM = GRC_SEQDET ';
      strSQL := strSQL + '   INNER JOIN SEQGAR ON SEQ_MOVGAD = MOVGAD.AUTOINCREM ';
      strSQL := strSQL + '   INNER JOIN FATDOR ON SEQ_FDO_TE = FATDOR.AUTOINCREM ';
      strSQL := strSQL + '   INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '       MOVDET.DET_NUMDOC = :NUMPED ';
      strSQL := strSQL + '   AND MOVDET.DET_CODCLI = :CLIFOR ';
      strSQL := strSQL + '   AND MOVDET.DET_CODEMP = :CODEMP ';
      strSQL := strSQL + '   AND MOVDET.DET_ESPDOC = :ESPDOC ';
    end;

    blnCancelandoRecebimentoCliente :=  (Pos(strEspDoc,'NW_GA_')> 0);

    With qryGenGer Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CLIFOR').AsString := strCodFor;

      if (Pos(strEspDoc,'NW_')> 0) then
      begin
        ParamByName('ESPDOC').AsString := 'NF';
      end
      else
      begin
        ParamByName('ESPDOC').AsString := strEspDoc;
      end;

      Open;
    End;


    if blnCancelandoRecebimentoCliente and (Not QryGenGer.IsEmpty) then
    begin
      StatusPedido := fPedidoFaturado(QryGenGer.FieldByName('NUMDOC').AsString,
                                      QryGenGer.FieldByName('ESPDOC').AsString,
                                      QryGenGer.FieldByName('CODEMP').AsString);


      Result := Not (StatusPedido.blnFaturado or StatusPedido.blnParcial);

      if Not Result then
      begin
        Msg := 'O pedido de transferência não pode ser cancelado '+slinebreak;
        Msg := Msg+'porque ele já foi baixado ou faturado.'+slinebreak;
        Msg := Msg+'Pedido número: %s';
        Msg := Format(Msg,[qryGenGer.FieldByName('NUMDOC').AsString]);
        fMensagem('Atenção!',Msg,['&Ok']);
      end;
    end;



    If Not QryGenGer.IsEmpty and Result Then
    Begin

      With QryGenger do
      begin
        If (VS_strCodEmp = fCfgSis('EMPGAR')) Then
          pLiberaSeqGar(qryGenGer.FieldByName('ESPDOC').AsString, qryGenGer.FieldByName('NUMDOC').AsString, qryGenGer.FieldByName('CODCLI').AsString, 'SEQ_FATDOR')
        Else
          pLiberaSeqGar('PD', qryGenGer.FieldByName('NUMDOC').AsString, qryGenGer.FieldByName('CODCLI').AsString, 'SEQ_FDO_TE');

        qryGenDel := fCriaQuery(Self);

        strSQL := '';
        strSQL := strSQL + 'DELETE FROM ';
        strSQL := strSQL + '  FATGOR ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  AUTOINCREM = :AUTINC ';

        pDeletaMovCarPedidoEcommerce(qryGenGer.FieldByName('NUMDOC').AsString,
                                     qryGenGer.FieldByName('ESPDOC').AsString,
                                     qryGenGer.FieldByName('CODEMP').AsString);

        If fCfgSis('CUPDES') = 'S' Then
          TFatCupomDesconto.DesmarcarCupomUtilizado(qryGenGer.FieldByName('NUMDOC').AsString,
                                                    qryGenGer.FieldByName('ESPDOC').AsString,
                                                    qryGenGer.FieldByName('CODEMP').AsString);

        {Envia Mensagens}
        If (qryGenGer.FieldByName('ESPDOC').AsString = 'PD') Then
          pMensagemCancelamentoPedido(qryGenGer.FieldByName('NUMDOC').AsString,
                                      qryGenGer.FieldByName('ESPDOC').AsString,
                                      qryGenGer.FieldByName('CODEMP').AsString);

        {*REQ.173491**********RP*}
        TLogGor.pLogDel(qryGenGer.FieldByName('NUMDOC').AsString,
                        qryGenGer.FieldByName('ESPDOC').AsString,
                        qryGenGer.FieldByName('CODEMP').AsString);

        With qryGenDel Do
        Begin

          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('AUTINC').AsString := qryGenGer.FieldByName('AUTINCGOR').AsString;
          ExecSQL;
          Close;

        End;

        strSQL := AnsiReplaceStr(strSQL,'GOR','DOR');

        With qryGenDel Do
        Begin

          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('AUTINC').AsString := qryGenGer.FieldByName('AUTINCDOR').AsString;
          ExecSQL;
          Close;

        End;
      end;
    End;

    if QryGenGer.Active then
      QryGenGer.Close;
  Except

    On E: Exception Do
    Begin
      fRollBack;
      Result := False;
      pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fCancelaPedidoVenda]');
    End;

  End;

end;

procedure TfrmCancelamentoDocumentos.pLiberaSeqGar(strEspSel, strNumDoc,
  strCodCli, strCampo: string);
Var
  strSQL : String;
  qryGen,
  qryAtu : TUniQuery;
begin

  Try
    qryGen := fCriaQuery;

    strSQL := '';
    If (strCampo = 'SEQ_MOVGAD') then
    begin
      strSQL := strSQL + 'SELECT        ';
      strSQL := strSQL + '  D.AUTOINCREM ';
      strSQL := strSQL + 'FROM      ';
      strSQL := strSQL + '  MOVGAD D INNER JOIN MOVGAG G ON D.GAD_SEQGAG = G.AUTOINCREM ';
      strSQL := strSQL + 'WHERE     ';
      strSQL := strSQL + '  G.GAG_NUMENT = :NUMDOC AND ';
      strSQL := strSQL + '  G.GAG_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  G.GAG_CODCLI = :CODCLI     ';
    End
    else If (strCampo = 'SEQ_PCMDET') then
    begin
      strSQL := strSQL + 'SELECT        ';
      strSQL := strSQL + '  AUTOINCREM ';
      strSQL := strSQL + 'FROM      ';
      strSQL := strSQL + '  PCMDET ';
      strSQL := strSQL + 'WHERE     ';
      strSQL := strSQL + '  PCD_NUMPED = :NUMDOC AND ';
      strSQL := strSQL + '  PCD_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  PCD_CODEMP = :CODEMP     ';
    End
    else If (strCampo = 'SEQ_FDO_TE') Or (strCampo = 'SEQ_FATDOR') then
    begin
      strSQL := strSQL + 'SELECT        ';
      strSQL := strSQL + '  AUTOINCREM ';
      strSQL := strSQL + 'FROM      ';
      strSQL := strSQL + '  FATDOR ';
      strSQL := strSQL + 'WHERE     ';
      strSQL := strSQL + '  FDO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  FDO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  FDO_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  FDO_CODCLI = :CODCLI     ';
    End
    else If (strCampo = 'SEQ_DET_TE') then
    begin
      strSQL := strSQL + 'SELECT        ';
      strSQL := strSQL + '  AUTOINCREM ';
      strSQL := strSQL + 'FROM      ';
      strSQL := strSQL + '  MOVDET  ';
      strSQL := strSQL + 'WHERE     ';
      strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  DET_CODCLI = :CODCLI     ';
    End;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      If (strCampo <> 'SEQ_MOVGAD') then
        ParamByName('ESPDOC').AsString := strEspSel;

      If (strCampo <> 'SEQ_PCMDET') then
        ParamByName('CODCLI').AsString := strCodCli;

      Open;

      First;
      If (Not IsEmpty) Then
      Begin
        qryAtu := fCriaQuery;

        While Not qryGen.Eof Do
        Begin
          With qryAtu Do
          Begin
            Close;
            SQL.Clear;
            If (strCampo <> 'SEQ_MOVGAD') then
            Begin
              SQL.Add(' UPDATE SEQGAR                    ');
              SQL.Add(' SET   ' + strCampo + ' = NULL    ');
              SQL.Add(' WHERE ' + strCampo + ' = :AUTINC ');
            End
            else
            Begin
              SQL.Add(' DELETE FROM SEQGAR               ');
              SQL.Add(' WHERE ' + strCampo + ' = :AUTINC ');
            end;
            ParamByName('AUTINC').AsString := qryGen.FieldByName('AUTOINCREM').AsString;
            ExecSQL;
          end;
          qryGen.Next;
        End;
        FreeAndNil(qryAtu);
      End;

    End;

  Except
    On E:Exception Do
      pMensagensErro(E.Message,'[TfrmCancelamentoDocumentos.fLiberaSeqGar]');
  End;

  FreeAndNil(qryGen);
end;

function TfrmCancelamentoDocumentos.fDesfaturaPedidoVenda(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
  Var
    strSQL   : String;
    qryGenGor: TUniQuery;

begin

  If (blnPodeDesfaturar) Then
  Begin
    Try

      qryGenGor := fCriaQuery(Self);

      Try

        strSQL := '';
        strSQL := strSQL + 'UPDATE ';
        strSQL := strSQL + '  FATGOR ';
        strSQL := strSQL + 'SET ';
        strSQL := strSQL + '  FGO_JAFATU = 0, ';
        strSQL := strSQL + '  FGO_TIPFAT = NULL, ';
        strSQL := strSQL + '  FGO_NUMFAT = NULL, ';
        strSQL := strSQL + '  FGO_EMPFAT = NULL, ';
        strSQL := strSQL + '  FGO_DTAFAT = NULL, ';
        strSQL := strSQL + '  FGO_VENFAT = NULL, ';
        strSQL := strSQL + '  FGO_CNDFAT = NULL, ';
        strSQL := strSQL + '  FGO_VALFAT = NULL  ';
        strSQL := strSQL + 'WHERE ';

        If (Not fEmptyStr(strCodCli)) Then
          strSQL := strSQL + '  FGO_CODCLI = :CLIFOR AND ';

        strSQL := strSQL + '  FGO_NUMFAT = :NUMFAT AND ';
        strSQL := strSQL + '  FGO_TIPFAT = :TIPFAT AND ';
        strSQL := strSQL + '  FGO_EMPFAT = :CODEMP ';

        With qryGenGor Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);

          If (Not fEmptyStr(strCodCli)) Then
            ParamByName('CLIFOR').AsString := strCodCli;

          ParamByName('NUMFAT').AsString := strNumDoc;
          ParamByName('TIPFAT').AsString := strEspSel;
          ParamByName('CODEMP').AsString := VS_strCodEmp;
          ExecSQL;
          Close;
        End;

        pAtualizaCancelamentoFaturamentoPedido(strNumDoc, strEspSel, VS_strCodEmp);

        strSQL := AnsiReplaceStr(strSQL, 'FATGOR', 'FATDOR');
        strSQL := AnsiReplaceStr(strSQL, 'FGO_', 'FDO_');

        With qryGenGor Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);

          If (Not fEmptyStr(strCodCli)) Then
            ParamByName('CLIFOR').AsString := strCodCli;

          ParamByName('NUMFAT').AsString := strNumDoc;
          ParamByName('TIPFAT').AsString := strEspSel;
          ParamByName('CODEMP').AsString := VS_strCodEmp;
          ExecSQL;
          Close;
        End;

        pAtualizaStatusPD(strNumDoc, strEspSel, VS_strCodEmp, True);

        Result := True;

      Except
        On E: Exception Do
        Begin
          fRollBack;
          Result := False;
          pMensagensErro(E.Message, '[fDesfaturaPedidoVenda]');
        End;
      End;

    Finally
      FreeAndNil(qryGenGor);
    End;
  End
  Else
    Result := True;

end;

Function TfrmCancelamentoDocumentos.fPedidoGarantiaTEBaixado(strEspSel : String) : Boolean;
  Var
    qryConsult : TUniQuery;
Begin
  Try
    qryConsult := fCriaQuery(Self);
    With qryConsult, SQL Do
    Begin

      If strEspSel = 'GA' Then
      Begin
        Add(' SELECT DISTINCT CONCAT(FDO_NUMFAT,"-", FDO_TIPFAT, "-", FDO_CODCLI) AS DOC  ');
        Add(' FROM MOVGAG                                                                 ');
        Add('   INNER JOIN MOVGAD ON GAD_SEQGAG = MOVGAG.AUTOINCREM                       ');
        Add('   INNER JOIN SEQGAR ON SEQ_MOVGAD = MOVGAD.AUTOINCREM                       ');
        Add('   INNER JOIN FATDOR ON SEQ_FDO_TE = FATDOR.AUTOINCREM AND FDO_JAFATU = TRUE ');
        Add(' WHERE GAG_NUMENT = :NUMENT                                                  ');
        Add('   AND GAG_CODEMP = :CODEMP                                                  ');
      End
      Else
      Begin
        Add(' SELECT DISTINCT CONCAT(FDO_NUMFAT,"-", FDO_TIPFAT, "-", FDO_CODCLI) AS DOC          ');
        Add(' FROM MOVGAG                                                                         ');
        Add('   INNER JOIN MOVGAD ON GAD_SEQGAG = MOVGAG.AUTOINCREM                               ');
        Add('   INNER JOIN MOVGRC ON GRC_SEQGAD = MOVGAD.AUTOINCREM AND GRC_OPCDOC IN ("NE","OE") ');
        Add('   LEFT JOIN MOVDET  ON MOVDET.AUTOINCREM = GRC_SEQDET                               ');
        Add('   INNER JOIN SEQGAR ON SEQ_MOVGAD = MOVGAD.AUTOINCREM                               ');
        Add('   INNER JOIN FATDOR ON SEQ_FDO_TE = FATDOR.AUTOINCREM AND FDO_JAFATU = TRUE         ');
        Add(' WHERE DET_NUMDOC = :NUMENT                                                          ');
        Add('   AND IFNULL(DET_SERIE_,"") = :SERIE_                                                ');
        Add('   AND DET_CODCLI = :CODCLI                                                          ');
        Add('   AND GAG_CODEMP = :CODEMP                                                          ');
      End;

      ParamByName('NUMENT').AsString := edtNumDoc.Text;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      If strEspSel <> 'GA' Then
      Begin
        IF edtSerie.Visible Then
          ParamByName('SERIE_').AsString := edtSerie.Text
        Else
          ParamByName('SERIE_').AsString := strSerFsc;
        ParamByName('CODCLI').AsString := edtCliFor.Text;
      End;

      Open;

      Result := IsEmpty or FieldByName('DOC').IsNull;

      If Not Result Then
        fMensagemCancelamento('','Este documento já foi enviado para a matriz através do documento: ' +
                     FieldByName('DOC').AsString + ', efetue seu cancelamento para prosseguir', ['&OK']);

    End;

  Finally
    FreeAndNil(qryConsult);
  End;
End;

class procedure TfrmCancelamentoDocumentos.pCancelaSatCFe(strNumDoc, strCodCli, strCodEmp, strSerFsc: String);
  Var
    qrySatCan : TUniQuery;
    frmCancelamentoDocumentos : TfrmCancelamentoDocumentos;
begin
  pCriarFormularios(TfrmCancelamentoDocumentos, frmCancelamentoDocumentos);
  Try
    frmCancelamentoDocumentos.edtNumDoc.Text  := strNumDoc;
    frmCancelamentoDocumentos.edtCliFor.Text  := strCodCli;
    frmCancelamentoDocumentos.edtSerie.Text   := strSerFsc;
    frmCancelamentoDocumentos.strCancelandoIF := 'S';
    frmCancelamentoDocumentos.strNumDocCanc   := strNumDoc;
    frmCancelamentoDocumentos.blnCancelarSATouCFTefAutomatico := True;
    frmCancelamentoDocumentos.ShowModal;

    If (Not fDocumentoCancelado(strNumDoc, 'IF', VS_strCodEmp, strCodCli, strSerFsc)) Then
    Begin
      qrySatCan := fCriarQuery('SELECT * FROM SATCAN WHERE FALSE', nil);
      Try
        qrySatCan.Open;
        qrySatCan.Append;
        qrySatCan.FieldByName('AUTOINCREM').AsString := fRetAutoIncrem('SATCAN', VS_strCodEmp);
        qrySatCan.FieldByName('CAN_NUMDOC').AsString := strNumDoc;
        qrySatCan.FieldByName('CAN_ESPDOC').AsString := 'IF';
        qrySatCan.FieldByName('CAN_CODEMP').AsString := VS_strCodEmp;
        qrySatCan.FieldByName('CAN_CODCLI').AsString := strCodCli;
        qrySatCan.FieldByName('CAN_SERIE_').AsString := strSerFsc;
        qrySatCan.Post;
      Finally
        FreeAndNil(qrySatCan);
      End;
    End;

  Finally
    pFreeAndNil(frmCancelamentoDocumentos);
  End;

end;

