function TfrmCancelamentoDocumentos.fCancelaOrdemProducaoPedido(strOrdPro, strCodCli,
  strCodEmp: String): Boolean;
begin
  Result := True;

  If fEmptyStr(strOrdPro) Then
  Begin
    Exit;
  End;

  If TOrdPro.fOrdemProducaoBaixada(strOrdPro, strCodEmp) Then
    TOrdPro.pLimpaPedidoDaOrdemProducao(strOrdPro, strCodEmp)
  Else
