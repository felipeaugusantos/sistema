    pSetFocus(lsbEspecies);

  If Not fAjustarTelaCRM Then
    PostMessage(Handle, WM_CLOSE, 0, 0);

  pCancelarPendencia(True, False);

  If (blnCancelarSATouCFTefAutomatico) Then
    btnAdicionar.Click;
end;

function TfrmCancelamentoDocumentos.fAjustarTelaCRM: Boolean;
Begin
  Result := True;

  If FNFSeSubstituicao Then
    Exit;

  If FExecutandoCanceladorAutomatico Then
    Exit;

  If (VS_strHabilitarCRM and (not blnPegaDados)) Then
  Begin
    If (blnCancelarSATouCFTefAutomatico) Or (FCancelamentoDePedidoPendenteDeFaturamento) Or (FCancelamentoDeFFPelaNotaEspecial) Then
      blnLiberouProtocoloComSenha := True
    Else
    Begin
      If blnPassouDocumento or (fGetMenu('Escolha o Tipo de Cancelamento:', ['Cancelamento com Protocolo', 'Digitar senha de liberação'], 1) = 2) Then
      Begin
        objLiberacao.Clear;
        objLiberacao.strDirAce    := 'CASPRO';
        objLiberacao.strCodOpe    := strLoginUsuarioLogado;
        objLiberacao.objMsgLibera.pAddTexto('Liberar o cancelamento de documentos sem o uso de protocolo gerado pelo CRM.');

        blnLiberouProtocoloComSenha := objLiberacao.fLibera;
      End;
    End;

    If fUsaProtocolo Then
    Begin
      If Not fPesquisaProtocolo Then
        Result := False
    End;

  End;
End;

procedure TfrmCancelamentoDocumentos.pAlimentaTarefasRomaneioFusion(strNumDoc, strEspDoc: String);
var
  qryAux: TUniQuery;
begin
  if (not fCfgSis('FUSUSA', varBoolean)) then
    Exit;

  qryAux := fCriaQuery;

  try
    qryAux.SQL.Text :=
    IIF(fCfgSis('OPCROM', varInteger) = 2,

        ' SELECT '+
        '   AUX_INTFUS '+
        ' FROM '+
        '   DEL_MOVGER '+
        ' INNER JOIN DEL_AUXMOV '+
        '   ON DEL_MOVGER.AUTOINCREM = AUX_SEQGER '+
        ' WHERE '+
        '   AUX_INTFUS <> "N" AND '+
        '   GER_NUMDOC = :NUMDOC AND '+
        '   GER_ESPDOC = :ESPDOC AND '+
        '   GER_CODEMP = :CODEMP '

      ,

        ' SELECT '+
        '   FGO_INTFUS '+
        ' FROM '+
        '   DEL_EXTGOR '+
        ' INNER JOIN DEL_FATGOR F '+
        '   ON FGO_SEQFGO = F.AUTOINCREM '+
        ' WHERE '+
        '   FGO_INTFUS <> "N" AND '+
        '   FGO_NUMDOC = :NUMDOC AND '+
        '   FGO_ESPDOC = :ESPDOC AND '+
        '   FGO_CODEMP = :CODEMP '

    );

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.Open;

    if qryAux.IsEmpty then
      Exit;

    TRomaneioTarefasFusion.pInsereTarFus('', '', strNumDoc, strEspDoc, VS_strCodEmp, 'C');
  finally
    FreeAndNil(qryAux);
  end;
end;

function TfrmCancelamentoDocumentos.fAtualizaEstoque(strCodIte: String;
  fltQtdIte: Double; strEntSai, strNumLot, strEspecie: String; blnFutLot: Boolean = False): Boolean;
  Var
    strSQL   : String;
    qryGenIte: TUniQuery;

begin
  Result := True;

  If (strCodIte = fCfgSis('ITESER')) Or (strCodIte = fCfgSis('SERTER')) Or (strCodIte = fCfgSis('ITEFRE')) Then
    Exit;

  Try

    qryGenIte := fCriaQuery(Self);

    Try

      If (blnFutLot = False) Then
      Begin
        If (strEspecie <> 'TA') And (strEspecie <> 'TL') Then
        Begin
          strSQL := '';
          strSQL := strSQL + 'UPDATE ';
          strSQL := strSQL + '  ITEGER ';
          strSQL := strSQL + 'SET ';
          If (strEntSai = 'E') Then
            strSQL := strSQL + '  ITE_SALDOS = ITE_SALDOS + :QTDITE '
          Else
            strSQL := strSQL + '  ITE_SALDOS = ITE_SALDOS - :QTDITE ';

          strSQL := strSQL + 'WHERE ';
          strSQL := strSQL + '  ITE_CODITE = :CODITE AND ';
          strSQL := strSQL + '  ITE_CODEMP = :CODEMP ';

          With qryGenIte Do
          Begin
            Close;
            SQL.Clear;
            SQL.Add(strSQL);
            ParamByName('QTDITE').AsFloat := fltQtdIte;
            ParamByName('CODITE').AsString := strCodIte;
            ParamByName('CODEMP').AsString := VS_strCodEmp;
            ExecSQL;
            Close;
          End;
        End;

        imgCadItens.Picture := imgAlterado.Picture;


        Result := True;

        If Result Then
        Begin
          If fEmptyStr(strNumLot) Then
            strNumLot := objCadLot.fRetArmazemPrincipalVenda(strCodIte);

          If (Not fEmptyStr(strNumLot)) Then
            Result := objCadLot.fAtualizaEstoqueLote(strCodIte, strEntSai, strNumLot, fltQtdIte);
        End;
      End
      Else If (blnFutLot = True) Then
      Begin
        imgCadItens.Picture := imgAlterado.Picture;
        Result := True;

        If strEntSai = 'E' Then
        Begin
          If (Result) And (Not fEmptyStr(strNumLot)) Then
            Result := objCadLot.fAtualizaEstoqueLote(strCodIte, 'E', strNumLot, fltQtdIte);
        End
        Else
        Begin
          If (Result) And (Not fEmptyStr(strNumLot)) Then
            Result := objCadLot.fAtualizaEstoqueLote(strCodIte, 'S', 'A DEFINIR', fltQtdIte);
        End;
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fAtualizaEstoque]');
        Result := False;
      End;
    End;

  Finally
    FreeAndNil(qryGenIte);
  End;

end;

function TfrmCancelamentoDocumentos.fEntGer_Se_Entrada_Realizada(strEspSel, strNumDoc: String): Boolean;
var qryConsulta: TUniQuery;
    strNumDocEnt,
    strCodEmpEnt,
    strEspDocEnt: String;

begin
  If Not ((fCfgSis('CONENT', varBoolean)) And (fCfgSis('TIPSAB', varString) = 'M')) Then
     Exit(False);

  qryConsulta := fCriaQuery;
  Try
    qryConsulta.SQL.Add('SELECT GER_DCTEMT AS SAIDA, GER_DOCEFL AS ENTRADA,');
    qryConsulta.SQL.Add('       LEFT(GER_DOCEFL, 12) AS NUMDOC,');
    qryConsulta.SQL.Add('       RIGHT(GER_DOCEFL, 3) AS CODEMP,');
    qryConsulta.SQL.Add('       LEFT(RIGHT(GER_DOCEFL, 6), 2) AS ESPDOC');
    qryConsulta.SQL.Add('  FROM ENTGER WHERE');
    qryConsulta.SQL.Add('  GER_DCTEMT = "' + strNumDoc + '-' + strEspSel + '-' + VS_StrCodEmp + '"');
    qryConsulta.SQL.Add('  AND GER_DOCEFL <> ""');

    qryConsulta.Open;

    If qryConsulta.IsEmpty Then
      Exit(False);

    If qryConsulta.FieldByName('ENTRADA').AsString = '' Then
      Exit(False);

    strNumDocEnt := qryConsulta.FieldByName('NUMDOC').AsString;
    strCodEmpEnt := qryConsulta.FieldByName('CODEMP').AsString;
    strEspDocEnt := qryConsulta.FieldByName('ESPDOC').AsString;

    qryConsulta.Close;

    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add('SELECT COUNT(1) AS QTD FROM MOVGER');
    qryConsulta.SQL.Add('WHERE GER_NUMDOC = :NUMDOC');
    qryConsulta.SQL.Add('  AND GER_ESPDOC = :ESPDOC');
    qryConsulta.SQL.Add('  AND GER_CODEMP = :CODEMP');

    qryConsulta.ParamByName('NUMDOC').AsString := strNumDocEnt;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspDocEnt;
    qryConsulta.ParamByName('CODEMP').AsString := strCodEmpEnt;

    qryConsulta.Open;

    Result := qryConsulta.FieldByName('QTD').AsInteger > 0;

  Finally
    FreeAndNil(qryConsulta);
  End;

end;

function TfrmCancelamentoDocumentos.fEntregaFuturaBaixada(strEspSel, strNumDoc, strCodCli: String): Boolean;

  Function fGetSQL: String;
    Var
      strSQL: String;
  Begin
    strSQL := '';
    strSQL := strSQL + ' IFNULL((SELECT ';
    strSQL := strSQL + '   SUM(IFNULL(DET_QTDENT,0)) AS SOMA ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   MOVDET ';
    strSQL := strSQL + ' INNER JOIN MOVGER G ON ';
    strSQL := strSQL + '   DET_SEQGER =  G.AUTOINCREM ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + '   GER_ENTFUT = "S"     AND  ';
    strSQL := strSQL + '   GER_NUMDOC = :NUMDOC AND  ';
    strSQL := strSQL + '   GER_ESPDOC = :ESPDOC AND  ';
    strSQL := strSQL + '   GER_CODCLI = :CODCLI AND  ';
    strSQL := strSQL + '   GER_CODEMP = :CODEMP), 0)  ';
    Result := strSQL;
  End;

  Var
    qryGenGer: TUniQuery;
begin
  Try

    Result := False;

    qryGenGer := fCriaQuery(Self);

    If (Pos(strEspSel, 'MI_NF_EL_FF_IF_IV_D1_RB_') <= 0) Then
    Begin
      Exit;
    End;

    With qryGenGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT (' + fGetSQL + ') AS SOMA');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      Result := FieldByName('SOMA').AsFloat > 0;

      Close;
    End;

  Finally
    FreeAndNil(qryGenGer);
  End;

end;


function TfrmCancelamentoDocumentos.fExcluiLotesGeradosNoEnderecamento(strAutInc: string): Boolean;
var qryTmp: TUniQuery;
begin
  If fEmptyStr(strAutInc) Then
    Exit(True);

  qryTmp := fCriaQuery;
  Try
    qryTmp.SQL.Add('DELETE FROM CADLOT WHERE LOT_MARORI  = "' + strAutInc + '" AND LOT_SALDOS = 0');
    qryTmp.SQL.Add('AND (SELECT COUNT(1)  FROM MOVDET');
    qryTmp.SQL.Add('      WHERE LOT_NUMLOT = MOVDET.DET_NUMLOT');
    qryTmp.SQL.Add('        AND LOT_CODITE = MOVDET.DET_CODITE');
    qryTmp.SQL.Add('        AND LOT_CODEMP = MOVDET.DET_CODEMP');
    qryTmp.SQL.Add('        AND DET_CLAFIS NOT IN("5999", "1999")');
    qryTmp.SQL.Add('        AND LOCATE(DET_CLAFIS, "'+VS_strClaVen+'")) = 0');
    qryTmp.SQL.Add('AND (SELECT COUNT(1)  FROM FATDOR');
    qryTmp.SQL.Add('      WHERE LOT_NUMLOT = FATDOR.FDO_NUMLOT');
    qryTmp.SQL.Add('        AND LOT_CODITE = FATDOR.FDO_CODITE');
    qryTmp.SQL.Add('        AND LOT_CODEMP = FATDOR.FDO_CODEMP');
    qryTmp.SQL.Add('        AND FATDOR.FDO_CLAFIS NOT IN("5999", "1999")');
    qryTmp.SQL.Add('        AND LOCATE(FATDOR.FDO_CLAFIS,"'+VS_strClaVen+'")) = 0');
    qryTmp.ExecSQL;
    Result := True;
  finally
    FreeAndNil(qryTmp);
  end;

End;


function TfrmCancelamentoDocumentos.fCarregaAutoincrem(strEspDoc, strNumDoc,
  strCliFor, strSerie: String): String;
var qryTmp: TUniQuery;
begin
  qryTmp := fCriaQuery;
  Result := '';
  Try
    qryTmp.SQL.Add('SELECT AUTOINCREM FROM MOVGER G');
    qryTmp.SQL.Add('WHERE G.GER_NUMDOC = :NUMDOC');
    qryTmp.SQL.Add('  AND G.GER_CODEMP = "'+VS_StrCodEmp+'"');
    qryTmp.SQL.Add('  AND G.GER_ESPDOC = "NF"');
    qryTmp.SQL.Add('  AND IFNULL(G.GER_SERIE_, "") = :SERIE_');
    qryTmp.SQL.Add('  AND G.GER_CODFOR = :CODFOR');
    qryTmp.ParamByName('NUMDOC').ASString := strNumDoc;
    qryTmp.ParamByName('CODFOR').ASString := strCliFor;
    qryTmp.ParamByName('SERIE_').ASString := strSerie;
    qryTmp.Open;

    Result := qryTmp.FieldByName('AUTOINCREM').AsString;
  finally
    FreeAndNil(qryTmp);
  end;

end;

Function TfrmCancelamentoDocumentos.fCancelaBaixaFutura(strNumDoc, strEspDoc, strCodCli: String): Boolean;
  Var
    qryMovDet: TUniQuery;
    qryMovOri: TUniQuery;
    fltQtdBai: Double;
    intDecQtd: Integer;

    Procedure pBuscaItensBaixa;
    Begin
      With qryMovDet, SQL Do
      Begin
        Add('SELECT       ');
        Add('  DET_CODITE,');
        Add('  DET_QTDITE,');
        Add('  DET_DOCFUT,');
        Add('  DET_ESPFUT,');
        Add('  DET_EMPFUT,');
        Add('  DET_INCFUT ');
        Add('FROM         ');
        Add('  MOVDET INNER JOIN MOVTRI ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ');
        Add('WHERE        ');
        Add('  DET_CODCLI = :CODCLI AND ');
        Add('  DET_NUMDOC = :NUMDOC AND     ');
        Add('  DET_ESPDOC = :ESPDOC AND     ');
        Add('  DET_CODEMP = :CODEMP AND     ');
        Add('  DET_DOCFUT IS NOT NULL       ');

        If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
          Add('  AND TRUE ')
        Else
          Add('  AND IFNULL(DET_PROEMB, "") <> "S"');

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('CODEMP').AsString := VS_strCodEmp;

        Open;
      End;
    End;

    Procedure pBuscaItensOriginais(strNumDoc, strEspDoc, strCodEmp, strCodCli, strCodIte, strAutInc: String);
    Begin
      With qryMovOri, SQL Do
      Begin
        Clear;
        Close;
        Add('SELECT * ');
        Add('  FROM MOVDET INNER JOIN MOVTRI ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ');
        Add('WHERE');
        Add('  DET_CODITE = :CODITE AND ');
        Add('  DET_CODCLI = :CODCLI AND ');
        Add('  DET_NUMDOC = :NUMDOC AND ');
        Add('  DET_ESPDOC = :ESPDOC AND ');
        Add('  AUTOINCREM = :AUTINC AND ');
        Add('  DET_QTDENT > 0');

        ParamByName('CODITE').AsString := strCodIte;
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('AUTINC').AsString := strAutInc;

        Open;

        If IsEmpty Then
        Begin
          Clear;
          Close;
          Add('SELECT * ');
          Add('  FROM MOVDET INNER JOIN MOVTRI ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ');
          Add('WHERE');
          Add('  DET_CODITE = :CODITE AND ');
          Add('  DET_CODCLI = :CODCLI AND ');
          Add('  DET_NUMDOC = :NUMDOC AND ');
          Add('  DET_ESPDOC = :ESPDOC AND ');
          Add('  DET_CODEMP = :CODEMP AND ');
          Add('  DET_QTDENT > 0 ');

          ParamByName('CODITE').AsString := strCodIte;
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspDoc;
          ParamByName('CODCLI').AsString := strCodCli;
          ParamByName('CODEMP').AsString := strCodEmp;

          Open;
        End;
      End;
    End;

Begin
  intDecQtd := fCfgSis('DECQTD');

  qryMovDet := fCriaQuery(Self);
  qryMovOri := fCriaQuery(Self);

  pBuscaItensBaixa;

  With qryMovDet, SQL Do
  Begin
    While Not Eof Do
    Begin
      fltQtdBai := FieldByName('DET_QTDITE').AsFloat;

      pBuscaItensOriginais(FieldByName('DET_DOCFUT').AsString,
                           FieldByName('DET_ESPFUT').AsString,
                           FieldByName('DET_EMPFUT').AsString,
                           strCodCli,
                           FieldByName('DET_CODITE').AsString,
                           FieldByName('DET_INCFUT').AsString);

       While (Not qryMovOri.Eof) And (fltQtdBai > 0) Do
       Begin

         If RoundTo(qryMovOri.FieldByName('DET_QTDENT').AsFloat, -intDecQtd) > 0 Then
         Begin
           qryMovOri.Edit;

           If RoundTo(fltQtdBai, -intDecQtd) <= RoundTo(qryMovOri.FieldByName('DET_QTDENT').AsFloat, -intDecQtd) Then
           Begin
             qryMovOri.FieldByName('DET_QTDENT').AsFloat :=
               qryMovOri.FieldByName('DET_QTDENT').AsFloat - fltQtdBai;
             fltQtdBai := 0;
           End Else
           Begin
             fltQtdBai := fltQtdBai - qryMovOri.FieldByName('DET_QTDENT').AsFloat;
             qryMovOri.FieldByName('DET_QTDENT').AsFloat := 0;
           End;

           If Assigned(qryMovOri.FindField('DET_EFBAIX')) Then
             qryMovOri.FieldByName('DET_EFBAIX').AsString := 'N';
           qryMovOri.Post;
         End;

         qryMovOri.Next;
       End;

      Next;
    End;

  End;

  FreeAndNil(qryMovDet);
  FreeAndNil(qryMovOri);

  Result := True;
End;

