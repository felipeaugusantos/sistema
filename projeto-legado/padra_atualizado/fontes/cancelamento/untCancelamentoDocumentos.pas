procedure TfrmCancelamentoDocumentos.pRemoverReferenciaBalancoItegerECadLot(strNumDoc, strEspDoc, strCodEmp: string);
  var qryUpdate: TUniQuery;
  const strAutoIncrem =  '(SELECT M.AUTOINCREM FROM MOVGER M WHERE M.GER_ESPDOC = :ESPDOC AND M.GER_CODEMP = :CODEMP AND M.GER_NUMDOC = :NUMDOC)';
  procedure pMontaSqlIteger;
  begin
    with qryUpdate, Sql do
    begin
      Clear;
      Add('UPDATE ITEGER I');
      Add('   SET I.ITE_DTAAJU = NULL,');
      Add('       I.ITE_SEQAJU = NULL,');
      Add('       I.ITE_QTDAJU = NULL');
      Add(' WHERE I.ITE_SEQAJU = ' + strAutoIncrem );
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('NUMDOC').AsString := strNumDoc;
    end;
  end;

  procedure pMontaSqlCadLot;
  Begin
    with qryUpdate, Sql do
    begin
      Clear;
      Add('UPDATE CADLOT L');
      Add('   SET L.LOT_DTAAJU = NULL,');
      Add('       L.LOT_SEQAJU = NULL,');
      Add('       L.LOT_QTDAJU = NULL');
      Add(' WHERE L.LOT_SEQAJU = ' + strAutoIncrem );
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('NUMDOC').AsString := strNumDoc;
    end;
  end;
begin
  qryUpdate := fCriaQuery();
  try
    pMontaSqlIteger;
    qryUpdate.ExecSql;
    qryUpdate.Close;
    pMontaSqlCadLot;
    qryUpdate.ExecSql;
  finally
    FreeAndNil(qryUpdate);
  end;
end;

function TfrmCancelamentoDocumentos.fRetDocOri(var blnAchouRegistro : Boolean; strNumDoc, strTipFc, strSerie,
  strCodEmp, strCliFor: String; blnPedEnt: Boolean = False; strEspDoc: String = ''): String;

  Function fGetSQLDocOri(strTab: String): String;
    Var
      strSQL : String;
  Begin
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   GER_ORIDOC ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '  ' + strTab + '  ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + ' GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + ' GER_TIP_FC = :TIP_FC AND ';
    If Not fEmptyStr(strEspDoc) Then
      strSQL := strSQL + ' GER_ESPDOC = :ESPDOC AND ';
    If Not fEmptyStr(strSerie) Then
      strSQL := strSQL + ' IFNULL(GER_SERIE_, "") = :SERIE AND ';
    strSQL := strSQL + ' GER_CODEMP = :CODEMP ';

    If (Not fEmptyStr(strCliFor)) Then
    Begin
      If (strTipFc = 'F') Then
        strSQL := strSQL + ' AND GER_CODFOR = :CLIFOR '
      Else
        strSQL := strSQL + ' AND GER_CODCLI = :CLIFOR '
    End;

    Result := strSQL;
  End;

  Var
    qryGer : TUniQuery; // SE FOR NI, VAI DIRETO NO NOTGER

begin
  qryGer := fCriaQuery(Self);
  Try
    blnAchouRegistro := False;
    With qryGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fGetSQLDocOri('MOVGER'));
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('TIP_FC').AsString := strTipFc;
      If Not fEmptyStr(strEspDoc) Then
        ParamByName('ESPDOC').AsString := strEspDoc;
      If Not fEmptyStr(strSerie) Then
        ParamByName('SERIE').AsString := strSerie;
      ParamByName('CODEMP').AsString := strCodEmp;

      If (Not fEmptyStr(strCliFor)) Then
        ParamByName('CLIFOR').AsString := strCliFor;

      Open;

      If (RecordCount = 0) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQLDocOri('NOTGER'));
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('TIP_FC').AsString := strTipFc;
        ParamByName('CODEMP').AsString := strCodEmp;

        If Not fEmptyStr(strEspDoc) Then
          ParamByName('ESPDOC').AsString := strEspDoc;

        If Not fEmptyStr(strSerie) Then
          ParamByName('SERIE').AsString := strSerie;

        If (Not fEmptyStr(strCliFor)) Then
          ParamByName('CLIFOR').AsString := strCliFor;

        Open;
      End;

      blnAchouRegistro := (Not qryGer.IsEmpty);

      Result := FieldbyName('GER_ORIDOC').AsString;

      Close;
    End;
  Finally
    FreeAndNil(qryGer);
  End;
end;

Function TfrmCancelamentoDocumentos.fRetOpcDocTrue(strNumDoc, strEspDoc, strCodEmp, strCliFor, strTipFc: String; strSerie: String=''; const blnApenasNotGer : Boolean = False): String;

  Function fGetSQLDocOri(strMov: String): String;
    Var
      strAux,
      strSQL : String;
  Begin
    strAux := IIF(strMov='MOVGER', 'AUXMOV', 'AUXNOT');

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   AUX_OPCDOC ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '  ' + strMov + ' M ';
    strSQL := strSQL + '   INNER JOIN ' + strAux + ' A ON M.AUTOINCREM = A.AUX_SEQGER ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + ' GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + ' GER_TIP_FC = :TIP_FC AND ';
    If Not fEmptyStr(strEspDoc) Then
      strSQL := strSQL + ' GER_ESPDOC = :ESPDOC AND ';
    If Not fEmptyStr(strSerie) Then
      strSQL := strSQL + ' IFNULL(GER_SERIE_, "") = :SERIE AND ';
    strSQL := strSQL + ' GER_CODEMP = :CODEMP ';

    If (Not fEmptyStr(strCliFor)) Then
    Begin
      If (strTipFc = 'F') Then
        strSQL := strSQL + ' AND GER_CODFOR = :CLIFOR '
      Else
        strSQL := strSQL + ' AND GER_CODCLI = :CLIFOR '
    End;

    Result := strSQL;
  End;

  Var
    qryGer : TUniQuery;
    blnAchouRegistro : Boolean;
begin
  qryGer := fCriaQuery(Self);
  Try
    blnAchouRegistro := False;

    With qryGer Do
    Begin
      If (Not blnApenasNotGer) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQLDocOri('MOVGER'));
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('TIP_FC').AsString := strTipFc;
        If Not fEmptyStr(strEspDoc) Then
          ParamByName('ESPDOC').AsString := strEspDoc;
        If Not fEmptyStr(strSerie) Then
          ParamByName('SERIE').AsString := strSerie;
        ParamByName('CODEMP').AsString := strCodEmp;

        If (Not fEmptyStr(strCliFor)) Then
          ParamByName('CLIFOR').AsString := strCliFor;

        Open;
        blnAchouRegistro := (qryGer.RecordCount > 0);
      End;

      If (Not blnAchouRegistro) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQLDocOri('NOTGER'));
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('TIP_FC').AsString := strTipFc;
        ParamByName('CODEMP').AsString := strCodEmp;

        If Not fEmptyStr(strEspDoc) Then
          ParamByName('ESPDOC').AsString := strEspDoc;

        If Not fEmptyStr(strSerie) Then
          ParamByName('SERIE').AsString := strSerie;

        If (Not fEmptyStr(strCliFor)) Then
          ParamByName('CLIFOR').AsString := strCliFor;

        Open;
        blnAchouRegistro := (qryGer.RecordCount > 0);
      End;

      If (blnAchouRegistro) Then
        Result := FieldbyName('AUX_OPCDOC').AsString;

      Close;
    End;
  Finally
    FreeAndNil(qryGer);
  End;
end;

