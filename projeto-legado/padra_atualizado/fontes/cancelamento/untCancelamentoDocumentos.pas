function TfrmCancelamentoDocumentos.fObterClienteFavorecidoCredito(const strNumDoc, strCodCli, strEspDocRet: String;
  out StrFavorecido: String): Boolean;
Const
  CPO_CODCLI: Integer = 0;
Var
  QryMovGer: TUniQuery;
begin
  strFavorecido:= EmptyStr;
  Try
    QryMovGer := fCriaQuery();
    QryMovGer.Sql.Add(fObterSqlFavorecidoCredito);
    QryMovger.ParamByName('CODCLI').Asstring := strCodCli;
    QryMovGer.paramByName('CODEMP').Asstring := VS_strCodEmp;
    QryMovGer.ParamByName('NUMDOC').AsString := strNumDoc;

    QryMovGer.Open;
    if Not QryMovGer.IsEmpty then
    begin
      strFavorecido := QryMovGer.FieldByName('GAG_CODFAV').asString;
    end;
  Finally
    if Assigned(QryMovGer) then
    begin
      if QryMovGer.Active then
        QryMovGer.Close;
      FreeAndNil(QryMovGer);
    end;
    Result := Length(Trim(strFavorecido)) > 0;
  End;
end;

