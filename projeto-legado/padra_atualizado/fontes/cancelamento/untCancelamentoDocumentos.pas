  If (fCfgSis('GARMAT', varBoolean)) And (fCfgSis('EMPGAR', varString) <> VS_strCodEmp) And
     (strMen001 = 'GARANTIA(TE)') Then
    arrAux[intOrd].blnGarant := True;
