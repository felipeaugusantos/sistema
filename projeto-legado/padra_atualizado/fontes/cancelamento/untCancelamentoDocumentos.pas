function TfrmCancelamentoDocumentos.fUsaProtocolo : Boolean;
Begin
  Result := VS_strHabilitarCRM;

  If blnLiberouProtocoloComSenha or blnPassouDocumento or FblnCancelamentoLocEqu or FExecutandoCanceladorAutomatico Then
    Result := False;
End;

function TfrmCancelamentoDocumentos.fPesquisaProtocolo: Boolean;
Var
  qryProtoc : TUniQuery;
  chrKey: Char;
  arrSel: TConsultasArray;
  objfrmPnl: TPanelCxCancelamentoDocumentos;
  blnContinuaLoop: Boolean;
Begin
  Result := True;

  If (Not fUsaProtocolo) Or (blnPegaDados) Or (FblnCancelamentoLocEqu) Then
    Exit;

  objfrmPnl := TPanelCxCancelamentoDocumentos.Create(TfrmPnlDadosCancelamentoDocumentos);
  Try
    qryProtoc := fCriaQuery;
    repeat
      chrKey := '/';
      blnContinuaLoop := False;
      If fPesqProtocoloCancelamento(Self, qryProtoc, chrKey, arrSel, True, '', objfrmPnl ) Then
      Begin
        If qryProtoc.IsEmpty Then
          blnContinuaLoop := True;
      End
      Else
        blnContinuaLoop := True;

      If blnContinuaLoop Then
        If (fMensagem('ATENÇÃO!','Necessário escolher um Nº Protocolo, deseja escolher um?', ['&Sim', '&Não'])= 2) Then
          Exit(False);

    until Not blnContinuaLoop;

    pSelecionarEspecieMenu(qryProtoc.FieldByName('PRO_ESPSEL').AsString);
    intOpcao  := qryProtoc.FieldByName('PRO_OPCCAN').AsInteger;
    lsbEspeciesDblClick(lsbEspecies);

    edtNumDoc.Text          := qryProtoc.FieldByName('PRO_NUMDOC').AsString;
    edtCliFor.Text          := qryProtoc.FieldByName('PRO_CLIFOR').AsString;
    edtDesCri.Text          := IfThen(qryProtoc.FieldByName('PRO_TIP_FC').AsString = 'C',
                                      fRetNomCliente(qryProtoc.FieldByName('PRO_CLIFOR').AsString),
                                      fRetNomFornecedor(qryProtoc.FieldByName('PRO_CLIFOR').AsString));
    edtSerie.Text           := qryProtoc.FieldByName('PRO_SERIE_').AsString;
    edtTipPes.Text          := qryProtoc.FieldByName('PRO_TIP_FC').AsString;

    strMotDel := qryProtoc.FieldByName('PRO_CODMOT').AsString;
    strDesMot := fRetDescOcorrencia(qryProtoc.FieldByName('PRO_CODMOT').AsString);
    strHisCom := qryProtoc.FieldByName('PRO_HISTOR').AsString;


    strAutIncProtocolo := qryProtoc.FieldByName('AUTOINCREM').AsString;

  Finally
    FreeAndNil(qryProtoc);
    FreeAndNil(objfrmPnl);
  End;
End;

procedure  TfrmCancelamentoDocumentos.pSelecionarEspecieMenu(const strEspDoc: String);
var
  intCont: Integer;
Begin
  For intCont := Low(arrEspecies) To High(arrEspecies) Do
  Begin
    If strEspDoc = (arrEspecies[intCont][0]) Then
    Begin
      lsbEspecies.ItemIndex := intCont;
      break;
    End;
  End;
End;

procedure TfrmCancelamentoDocumentos.lsbEspeciesDblClick(Sender: TObject);
begin
  If (fUsaProtocolo) And (blnPegaDados) Then
    intOpcao := -1;

  edtTipPes.Enabled := True;
  intIndiceEsp := lsbEspecies.ItemIndex;

  If (Not fVerificaAcessoSistema('CANC'+arrEspecies[intIndiceEsp][0])) And
     (Not blnCancelarSATouCFTefAutomatico) And
     (Not FblnAbastecimentoPeloDeposito) And
     (Not FblnCancelandoRetornoConsignadoAutomatico) And
     (Not FCancelamentoDeFFPelaNotaEspecial) And
     (Not FCancelamentoDePedidoPendenteDeFaturamento) And
     (Not blnCancelandoDocumentoLogCan) And
     (fSuportaInterfaceGrafica) Then
  Begin
    fMensagem( 'ATENÇÃO', 'Usuário sem permissão para cancelar documentos da espécie ' +
               arrEspecies[intIndiceEsp][0] + '.', ['&Ok']);
    BlnCancelaProcessoAutomaticoLoc := True;
    Exit;
  End;

  If (fCfgSis('PAFECF', varBoolean)) And (arrEspecies[intIndiceEsp][0] = 'IF') And (Not blnPDV) Then
  Begin
    pMensagemOk('Para realizar o cancelamento de cupons, por favor, utilize a rotina no resumo de caixa.');
    Exit;
  End;

  inherited;

  pAtribuiPicture(Nil);

  blnPedidoEntrada := False;
  blnConEqu := False;
  lsbEspecies.Enabled := False;
  pnlDadosDoc.Enabled := True;

  if (fUsaProtocolo and (not blnPegaDados)) or blnPassouDocumento or FExecutandoCanceladorAutomatico Then
  Begin
    edtNumDoc.ReadOnly      := True;
    edtCliFor.ReadOnly      := True;
    edtSerie.ReadOnly       := True;
    edtTipPes.ReadOnly      := True;
    //chkInutilizacao.Enabled := False;
  End
  Else
  Begin
    edtNumDoc.Clear;
    edtNumDoc.ReadOnly      := False;
    edtCliFor.ReadOnly      := False;
    edtSerie.ReadOnly       := False;
    edtTipPes.ReadOnly      := False;
    //chkInutilizacao.Enabled := True;
  End;

  edtNumDoc.TamCampo  := 12;
  edtNumDoc.MaxLength := 12;

  pSetFocus(edtNumDoc);

  {**************************************}
  {* CASO FOR OUTRAS SAIDAS             *}
  {* MOSTRA A OPCAO DO CLI/FOR          *}
  {***********************************JB*}
  If Pos(arrEspecies[intIndiceEsp][0],'NF_D1_PD_OR_TE_IF_IV_EP_BE_PR_FF_MI_TR_DV_BR_AJ_RQ_PI_UC_CS_CR_PA_DL_RB_IC_') > 0 Then
  Begin
    lblCliFor.Caption := 'Cliente:';
    edtTipPes.Text    := 'C';
  End
  Else If Pos(arrEspecies[intIndiceEsp][0],'ND_EL_NC_DC_') > 0 Then
  Begin
    lblCliFor.Caption := 'Cliente:';
    edtTipPes.Text    := 'C';

    edtTipPes.Visible := True;
    lblTitPes.Visible := True;

  End
  Else If Pos(arrEspecies[intIndiceEsp][0],'OF_NG_NR_NE_NP_EF_') > 0 Then
  Begin
    lblCliFor.Caption := 'Fornecedor:';
    edtTipPes.Text    := 'F';

    If Pos(arrEspecies[intIndiceEsp][0], 'OF_NP_') > 0 Then
    Begin
      edtTipPes.Visible     := True;
      lblTitPes.Visible     := True;
    End
    Else
    Begin
      edtTipPes.Visible     := False;
      lblTitPes.Visible     := False;
    End;

  End
  Else
  Begin
    lblCliFor.Caption := 'Cliente / Fornecedor:';
    edtTipPes.Visible := False;
    lblTitPes.Visible := False;
  End;

  lblDocumento.Caption := 'Documento:';
  edtCliFor.Visible    := True;
  edtCliFor.Enabled    := True;
  edtDesCri.Visible    := True;
  lblCliFor.Visible    := True;

  if blnPegaDados Then
    edtCliFor.Enabled  := False;

  If ( Pos(arrEspecies[intIndiceEsp][0], 'NE_GR_NR_') > 0) Then
  Begin
    edtNumDoc.TamCampo  := fTamNumDoc;
    edtNumDoc.MaxLength := fTamNumDoc;
  end
  Else
  Begin
    edtNumDoc.TamCampo  := fTamDocCadRec;
    edtNumDoc.MaxLength := fTamDocCadRec;
  End;

  If Pos(arrEspecies[intIndiceEsp][0],'NE_EL_ND_NC_IC_OF_NR_GR_NP_EF_DL_DC_') > 0 Then
  Begin
    lblSerie.Visible := True;
    edtSerie.Visible := True;
  End
  Else If arrEspecies[intIndiceEsp][0] = 'RM' Then
  Begin
    lblDocumento.Caption := 'Nro. Romaneio:';

    edtNumDoc.TamCampo  := 06;
    edtNumDoc.MaxLength := 06;

    edtCliFor.Visible    := False;
    edtDesCri.Visible    := False;
    lblCliFor.Visible    := False;
  End
  Else If arrEspecies[intIndiceEsp][0] = 'CT' Then
  Begin
    lblDocumento.Caption := 'Nro. CTe:';

    edtNumDoc.TamCampo  := fTamNumDoc;
    edtNumDoc.MaxLength := edtNumDoc.TamCampo;

    lblSerie.Visible     := True;
    edtSerie.Visible     := True;
    edtCliFor.Visible    := False;
    edtDesCri.Visible    := False;
    lblCliFor.Visible    := False;
  End
  Else If (arrEspecies[intIndiceEsp][0] = 'NI') Then
  Begin
    lblCliFor.Caption := 'Fornecedor:';
    edtTipPes.Text := 'F';
  End
  Else If (Not fSuportaInterfaceGrafica) Or blnDenegandoViaFulFillment Then
  Begin
    {***********************************************************************}
    {* Deixamos o edit visível aqui na operação do FulFillment porque o    *}
    {* frmImportaNfeFulfillment passa a série para o edtSerie na operação  *}
    {* de cancelamento ou inutilização, mesmo este form não estando aberto *}
    {*REQ.292510*********************************************************RP*}
    If Not fEmptyStr(edtSerie.Text) Then
      edtSerie.Visible := True;
  End
  Else
  Begin
    lblSerie.Visible := False;
    edtSerie.Visible := False;
  End;

  blnNW_Nfe := False;
  if (arrEspecies[intIndiceEsp][0] = 'NW') Then
  Begin
    If (not fUsaProtocolo) Then
      intOpcao := fGetMenu('Escolha o Tipo do Recebimento', ['Entrada de Mercadorias', 'Outras Entradas'], 1)
    Else
    If fUsaProtocolo And (blnPegaDados) Then
      intOpcao := fGetMenu('Escolha o Tipo do Recebimento', ['Entrada de Mercadorias', 'Outras Entradas'], 1);

    If intOpcao = -1 Then
    Begin
      fMensagem('', 'Opção de documento não carregada! - Contate a Citel Software', ['&OK']);
      Exit;
    End;

    If intOpcao = 1 Then
    Begin
      lblSerie.Visible := True;
      edtSerie.Visible := True;

      edtNumDoc.TamCampo  := fTamNumDoc;
      edtNumDoc.MaxLength := fTamNumDoc;
    End
    Else
    Begin
      blnNW_Nfe := True;
      edtNumDoc.TamCampo  := fTamDocCadRec;
      edtNumDoc.MaxLength := fTamDocCadRec;
    End;
  End;

  If (arrEspecies[intIndiceEsp][0] = 'NE') Then
  Begin
    if blnPassouDocumento or FExecutandoCanceladorAutomatico then
      intOpcao := 1
    else
    begin
      If (not fUsaProtocolo) Then
        intOpcao := fGetMenu('Escolha o Tipo da Nota de Entrada', ['Nota Fiscal', 'Pedido de Entrada'], 1)
      Else
      If fUsaProtocolo And (blnPegaDados) Then
        intOpcao := fGetMenu('Escolha o Tipo da Nota de Entrada', ['Nota Fiscal', 'Pedido de Entrada'], 1);

      If intOpcao = -1 Then
      Begin
        fMensagem('', 'Opção de documento não carregada! - Contate a Citel Software', ['&OK']);
        Exit;
      End;
    end;

    If intOpcao = 1 Then
      blnPedidoEntrada := False
    Else
      blnPedidoEntrada := True;
  End;

  If (arrEspecies[intIndiceEsp][0] = 'ND') Then
  Begin
    If (not fUsaProtocolo) Then
      intOpcao := fGetMenu('Escolha o Tipo da Nota de Entrada', ['Nota de Entrada - Devolução', 'Pedido de Entrada - Devolução', 'Nota de Entrada - Conserto de Equipamento'], 1)
    Else
    If fUsaProtocolo And (blnPegaDados) Then
      intOpcao := fGetMenu('Escolha o Tipo da Nota de Entrada', ['Nota de Entrada - Devolução', 'Pedido de Entrada - Devolução', 'Nota de Entrada - Conserto de Equipamento'], 1);

    If intOpcao = -1 Then
    Begin
      fMensagem('', 'Opção de documento não carregada! - Contate a Citel Software', ['&OK']);
      Exit;
    End;

    blnConEqu := intOpcao = 3;

    blnPedidoEntrada := intOpcao = 2;
  End;

  If Pos(arrEspecies[intIndiceEsp][0],'GR_GF_') > 0 Then
  Begin
    lblCliFor.Caption := 'Fornecedor:';
    edtTipPes.Text    := 'F';
  End
  Else If Pos(arrEspecies[intIndiceEsp][0],'GA_GC_NW_') > 0 Then
  Begin
    lblCliFor.Caption := 'Cliente:';
    edtTipPes.Text    := 'C';
  End
  Else If Pos(arrEspecies[intIndiceEsp][0],'GC_') > 0 Then
  Begin
    lblDocumento.Caption := 'Nº Garantia:';
    lblCliFor.Caption := 'Cliente:';
    edtTipPes.Text    := 'C';
  End;

  {******************************************}
  {* VERIFICA QUAL TIPO DE ESTORNO HABILITA *}
  {* OU SE NÃO HABILITA NENHUM ESTORNO      *}
  {***************************************JU*}
  If Pos(arrEspecies[intIndiceEsp][0],'CT_') > 0 Then
  Begin
    btnEstorno.Enabled    := True;
    btnEstornoCtr.Enabled := True;
    lblDadosNota.Caption := 'Dados Gerais da CTe';
    lblItensNota.Caption := 'CTe Cancelado';
  End
  Else
  If Pos(arrEspecies[intIndiceEsp][0],'NE_NI_OF_UC_EF_') > 0 Then
  Begin
    btnEstorno.Enabled    := True;
    btnEstornoCtr.Enabled := False;
  End
  Else
  If Pos(arrEspecies[intIndiceEsp][0],'NF_EL_D1_NS_NC_IC_FF_MI_TR_DV_IF_IV_TE_PD_RL_RB_DC_') > 0 Then
  Begin
    btnEstorno.Enabled    := False;
    btnEstornoCtr.Enabled := True;
  End
  Else
  If Pos(arrEspecies[intIndiceEsp][0],'BR_AJ_RQ_RM_PI_CS_CR_TA_TL_PR_OR_GF_GR_NG_NR_EP_BE_ND_GA_GC_PA_') > 0 Then
  Begin
    btnEstorno.Enabled    := False;
    btnEstornoCtr.Enabled := False;
  End
  else
  begin
    lblDadosNota.Caption := 'Dados Gerais da Nota';
    lblItensNota.Caption := 'Itens da Nota';
  end;

  If (arrEspecies[intIndiceEsp][0] = 'PA') Then
  Begin
    edtCliFor.Text := fRetornaClienteFilial(VS_strCodEmp);
    edtDesCri.Text := fRetNomCliente(edtCliFor.Text);
    edtCliFor.Enabled := False;
  End;

  imgCadItens.Visible := not (Pos(arrEspecies[intIndiceEsp][0],'CT_') > 0);
  lblCadIte.Visible := imgCadItens.Visible;

  chkInutilizacao.Visible := (Pos(arrEspecies[intIndiceEsp][0],'NF_EL_OF_OU_NC_IC_NI_NW_NG_NP_EF_DC_') > 0);
  If arrEspecies[intIndiceEsp][0] = 'IF' Then
  Begin
    chkInutilizacao.Visible := (fCfgSis('USNFCE', varBoolean)) Or fUsaSat;
  End;

  If blnPegaDados Then
    chkInutilizacao.Visible := False;

  If ( Not fEmptyStr(strNumDocCanc)) Then
    edtNumDoc.Text := strNumDocCanc;

  If blnPegaDados Then
  Begin
    If not edtTipPes.Visible Then
    Begin
      If (strTipPes = 'C') And (Pos('Cli', lblCliFor.Caption) <= 0) Then
      Begin
        fMensagem('', 'Selecione uma especie referente a Clientes!', ['&OK']);
        pnlDadosDoc.Enabled := False;
        lsbEspecies.Enabled := True;
        Exit;
      End

      Else
      If (strTipPes = 'F') And (Pos('For', lblCliFor.Caption) <= 0) Then
      Begin
        fMensagem('', 'Selecione uma especie referente a Fornecedores!', ['&OK']);
        pnlDadosDoc.Enabled := False;
        lsbEspecies.Enabled := True;
        Exit;
      End

    End
    Else
    Begin
      edtTipPes.Text := strTipPes;
      edtTipPes.Enabled := False;
    End;

  End;

end;

