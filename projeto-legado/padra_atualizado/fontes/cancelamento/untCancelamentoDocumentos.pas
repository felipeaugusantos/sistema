            If fCfgSis('MARMOR', varBoolean) Then
              blnResult := fExcluiLotesGeradosNoEnderecamento(strAutIncGer);


          pStepBy(3);

          If (blnResult) Then
            blnResult := fCancelaContasPagar(strEspSel, 'NF', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaContasPagarIcmsAntecipadoVendor('NF', strNumDocSel, strCliForSel, strSerieSel);

  (*        If (blnResult) Then
            blnResult := fCancelaConhecimentoDeFrete('NF', strNumDocSel, strCliForSel, strSerieSel);
  *)

          pStepBy(3);

          If (blnResult) Then
            fCancelaPedidoDeReserva('NF', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaBaixaNotaEletronica('NF', strNumDocSel, strCliForSel, strSerieSel);

          pStepBy(1);

          If (blnResult) And (Pos(strEspSel,'NE_') > 0) and (Not blnCancelandoNotaDeImportacao) Then
            blnResult := fDesmarcaPedidoCompra('NF', strNumDocSel, strCliForSel, IIF((fFornecedorFilial(strCliForSel) And (fCfgSis('GARMAT',varBoolean))), True, False));

          If (blnResult) And (blnCancelarTA) and (not fEmptyStr(strNumDocTA)) Then
          Begin
            strTipFc := 'CODCLI';
            blnResult := fCancelaItensDocumento(strEspDocTA, strNumDocTA, strCodCliTA, strSerieTA);
            strTipFc := 'CODFOR';
          End;

          pStepBy(1);

          If (blnResult) And (Pos(strEspSel,'NE_') > 0) Then
            pDeletarConferenciaSimplificada(VS_strCodEmp, strNumDocSel, strCliForSel);

        End
        Else
        Begin
          TDefineBaixaPedido.pGravaDeletadosRequisicao(strNumDocSel, strSerieSel, VS_strCodEmp, strCliForSel, 'PD', Self.Name);

  //        blnResult := fCancelaContasPagarCFr('NF', strNumDocSel, strCliForSel, strSerieSel, False);

  //        If (blnResult) Then
            blnResult := fCancelaConhecimentoDeFreteVariasNotas('PD', strNumDocSel, strCliForSel, strSerieSel);

          If Pos(strEspSel,'NR_NE_') > 0 Then
            If (blnResult) Then
              blnResult := fAtualizaQtdeGarantia(strNumDocSel,strEspSel,strCliForSel);

          If (Pos(strEspSel,'NE_') > 0) And (fCfgSis('GARMAT',varBoolean)) Then
            If (blnResult) Then
              blnResult := fCancelaPedidoVenda(strNumDocSel,'PD',strCliForSel);

          {*REQ.148688**********RP*}
          If fExisteDocTransfEmpCarregamento(strNumDocSel, 'PD', 'E') Then
            blnResult := fRemoveVinculoTransfEmpCarregamento(strNumDocSel, 'PD', 'E');

          If (blnResult) Then
            blnResult := fCancelaPagamentoAntecipado('NF', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaItensDocumento('PD', strNumDocSel, strCliForSel, strSerieSel);

          pStepBy(3);

          If (blnResult) Then
            blnResult := fCancelaContasPagar(strEspSel, 'PD', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaContasPagarIcmsAntecipadoVendor('PD', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaContasPagarGNRE('PD', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaGNRE('PD', strNumDocSel, strCliForSel, strSerieSel);

          pStepBy(3);

          If (blnResult) Then
            fCancelaPedidoDeReserva('PD', strNumDocSel, strCliForSel, strSerieSel);

          If (blnResult) Then
            blnResult := fCancelaBaixaNotaEletronica('PD', strNumDocSel, strCliForSel, strSerieSel);

          pStepBy(1);

          If (blnResult) And (Pos(strEspSel,'NE_') > 0) and (Not blnCancelandoNotaDeImportacao) Then
            blnResult := fDesmarcaPedidoCompra('PD', strNumDocSel, strCliForSel, IIF((fFornecedorFilial(strCliForSel) And (fCfgSis('GARMAT',varBoolean))), True, False));

          pStepBy(1);

          If (blnResult) And (Pos(strEspSel,'NE_') > 0) Then
            pDeletarConferenciaSimplificada(VS_strCodEmp, strNumDocSel, strCliForSel);
        End;

        If (blnResult) And fCfgSis('GERTRF', varBoolean) Then
        Begin
          blnResult := TTransferenciaDivergenciaExcedente.fCancelarTransferenciasDivergencia(
                         strNumDocSel, strEspSel, VS_strCodEmp, strMensagemDeErro);
        End;

        blnResult := blnResult And fRestauraNOTDET(VS_strCodEmp, strNumDocSel, strCliForSel, strSerieSel);

        If Not blnResult Then
          If strMensagemDeErro = '' Then
            strMensagemDeErro := 'Problema ao cancelar nota de entrada';
      End

      {*******************************************}
      {* CASO SEJA ORÇAMENTO OU PEDIDO           *}
      {****************************************MV*}
      Else If (Pos(strEspSel, 'OR_PD_PR_') > 0) Then
      Begin
        blnResult := True;

        If (Pos(strEspSel, 'PD_') > 0) then
        begin
          blnREsult := TGarantiaPropriaEmpresaCancelamento.fCancelarAvaliacaoGarantiaPropriaEmpresa(strNumDocSel, strEspSel, VS_strCodEmp);
          if Not blnResult then
          begin
            fMensagemCancelamento('ATENÇÃO!','Não foi possível cancelar os pedidos de reposição de garantia.', ['&Ok']);
          end;
        end;

        If (blnResult) And (strEspSel = 'PD') Then
          blnResult := fDeletaCadRecPDVendaABaseTroca(strNumDocSel, VS_strCodEmp, strCliForSel);

        if blnResult then
        begin
          If (Pos(strEspSel, 'PD_') > 0) And (fCfgSis('F11PGR', varBoolean)) Then
          Begin
            If (fCampoTabela('FGO_ORIGEM', 'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'],
                                                     [strNumDocSel, strEspSel, VS_strCodEmp]) = 'AGRUPAMENTO') Then
            Begin
              pCancelaItensPedidoAgrupamento(strNumDocSel, strEspSel, VS_strCodEmp);
            End;
          End;
        end;

        If  blnResult and LblnPedidoProvenienteDeOrcamento Then
        Begin
          If LblnCancelarOrcamentoOriginalPedido Then
          Begin
            If Not fVerificaAcessoSistema('CANCOR') Then
            Begin
              blnResult := fDesfaturaPedidoVendaOuOrcamento(strEspDocOR, strNumDocOR, strCodCliOR, strCodEmpOR, True);
            End
            Else
              pApagaOrcamentoQueGerouPD(strNumDocOR, strEspDocOR, strCodEmpOR, strCodCliOR);
          End
          Else
          Begin
            blnResult := fDesfaturaPedidoVendaOuOrcamento(strEspDocOR, strNumDocOR, strCodCliOR, strCodEmpOR,
                                                          True,
                                                          strNumDocSel, strEspSel, VS_strCodEmp);
          End;
        End;

        If blnResult and (strEspSel = 'PD') Then
        Begin
          objOrdSer := TOrdSer.Create;

          If Not objOrdSer.fExisteOrdemServicoBaixada(strNumDocSel,'PD') Then
            blnResult := objOrdSer.fCancelaOrdSer(strNumDocSel,'PD')
          Else
          Begin
            fMensagemCancelamento('','Existem ordens de serviço baixadas!',['&OK']);
            blnResult := False;
          End;

          FreeAndNil(objOrdSer);
        End;

        If blnResult and (strEspSel = 'PD') Then
          blnResult := blnResult And fGerarPedidoReservaEstoqueParaEnderecamentoProdutosSeparados(strNumDocSel, strEspSel, VS_strCodEmp, False, True);

        blnResult := blnResult And fCancelaPedidosAbastecimentoVinculados(strEspSel, strNumDocSel);

        blnResult := blnResult And fCancelaItensOrcPed(strEspSel, strNumDocSel, strCliForSel);
        pStepBy(2);

        If (blnResult) Then
          blnResult := fApagaDocumentoRomaneio(strNumDocSel, strEspSel, strCliForSel);

        pStepBy(2);

        If (blnResult) And (strEspSel = 'PD') Then
          blnResult := fCancelaContasReceber(strEspSel, strNumDocSel, strCliForSel, VS_strCodEmp);

        pStepBy(2);

        If (blnResult) And (fCfgSis('ALTORC', VarBoolean) And fVerificaAcessoSistema('ALTORC')) Then
          blnResult := fDesfaturaPedidoVendaOuOrcamento(strEspSel, strNumDocSel, strCliForSel, '', False);

        If (blnResult) And (strEspSel = 'PD') Then
          pCancelaConsertoEquipamentoDoPedido(strNumDocSel, strCliForSel);

        pStepBy(2);

        if (blnResult)        and
           (strEspSel = 'PD') and
           (objPedidoAlpe.strTipRec = 'ALPE') then
          pEstornoReceber(True, True);

        pStepBy(2);
      End

      {*******************************************}
      {* CASO SEJA ROMANEIO                      *}
      {****************************************MV*}
      Else If (strEspSel = 'RM') Then
      Begin
        blnResult := fCancelaRomaneio(strNumDocSel);
        pStepBy(7);

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar romaneio';
      End

      {*******************************************}
      {* CASO SEJA NOTA DE ENTRADA - DEVOLUÇÃO   *}
      {****************************************MV*}
      Else If (Pos(strEspSel,'ND_DL_') > 0) Then
      Begin
        strEspNot := IIF(Not blnPedidoEntrada, 'NF', 'PD');
        strNumDoc := AnsiRightStr(strNumDocSel, fTamDocCadRec());

        If SameText(edtTipPes.Text, 'F') Then
          strTipFc  := 'CODFOR'
        Else
          strTipFc := 'CODCLI';

        If fUsaRotinaWMS and (not fVerificaTAPendente(strNumDocSel, strCliForSel, fRetSerFsc, strEspSel, '', True)) Then
          Exit;

        blnResult := fCancelaItensDocumento(strEspNot, strNumDocSel, strCliForSel, strSerieSel);

        pStepBy(2);

        If (blnResult) Then
          blnResult := fCancelaItensFaturado(strEspNot, strNumDocSel, strCliForSel);

        pStepBy(2);

        If (blnResult) Then
          blnResult := fCancelaContasReceber(strEspNot, strNumDoc, strCliForSel, VS_strCodEmp);

        pStepBy(2);

        If (blnResult) Then
          blnResult := fVoltaCtrConfirmacao(strEspNot, strNumDocSel, strCliForSel);

        If (blnResult) Then
          fCancelaPedidoDeReserva(strEspNot, strNumDocSel, strCliForSel, strSerieSel, edtTipPes.Text);

        pStepBy(1);

        If (blnResult) And fTipoDeDocumentoCancelaNotaEletronicaGERELE Then
           blnResult := fCancelaBaixaNotaEletronica('NF', strNumDocSel, strCliForSel, strSerieSel);

        pStepBy(1);

        If ((blnResult) And (strEspSel = 'DL')) Then
        Begin
          blnResult := fDesvinculaContratoLocacao('NF', strNumDocSel, strCliForSel);
          pStepBy(1);
        End;

    //    If (blnResult) Then
    //      blnResult := fCancelaLivroFiscal(strEspNot, strNumDoc, strCliForSel, strSerieSel);

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar nota de entrada devolução';
      End

      Else If (Pos(strEspSel,'OF_NG_EF_') > 0) Then
      Begin
        blnResult := True;
        If (blnResult) And (strEspSel = 'OF') And ((Not fCfgSis('UTIWMS', VarBoolean) And fCfgSis('UDEVME', VarBoolean))) And
           (fCfgSis('COFEND', varBoolean)) And (fCfgSis('TIPPNT', varString) = 'D') Then
          TGestorReservaDevolucao.ExecuteRestauracaoReservaDevolucaoSemWms(fRetAutIncMovGer(strNumDocSel, 'NF', strCliForSel, strSerieSel));
        If (blnResult) And (strEspSel = 'OF') And ((Not fCfgSis('UTIWMS', VarBoolean) And fCfgSis('UDEVME', VarBoolean))) Then
        Begin
          TGestorReservaDevolucao.ExecuteRestauracaoReservaDevolucaoSemWms(fRetAutIncMovGer(strNumDocSel, 'NF', strCliForSel, strSerieSel));
        End;

        If (blnResult) And (strEspSel = 'OF') And (fCfgSis('MONFAS', varBoolean)) Then
          blnResult := fCancelaBaixaOrdemProducao(strEspSel, strNumDocSel, strCliForSel);

        If (strEspSel = 'OF') and (fPedidoCompraBaixado('NF', strNumDocSel, qryAux001)) Then
        Begin
          blnResult := False;
          strMensagemDeErro := 'O Pedido de compra dessa nota de transferência já foi baixado!' + #13#10 +
                               'Não será possível cancelar essa nota de transferência!';

          fMensagemCancelamento('ATENÇÃO!', strMensagemDeErro, ['&Ok']);
        End;

        If fCfgSis('REFENT', varBoolean) Then
          blnCancelamentoDeBaixaDeRefugo := fVerificaDocumentoEhBaixaDeRefugo(strNumDocSel, strCliForSel, strSerFsc);

        If (strEspSel = 'EF') Then
        Begin
          blnResult := fCancelaPedidoDeReserva('NF', strNumDocSel, strCliForSel, strSerieSel);

          if blnResult then
          begin
            blnResult := TCancelamentoBaixaEnvio.fEstornarBaixaEnvioConserto(strNumDocSel, strEspSel, VS_strCodEmp);
          end;

        End
        Else
        Begin
          blnEhNFDevolucao := fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF');

          If (blnResult) And (blnEhNFDevolucao) Then
            blnResult := fCancelaPedidoDeReserva('NF', strNumDocSel, strCliForSel, fRetSerFsc, fRetTipPes('C'));

          If (blnResult) Then
            blnResult := fAtualizaQtdeGarantia(strNumDocSel,strEspSel,strCliForSel, ArrayOfTMovGauCancelado);
        End;

        pStepBy(1);

        If (blnResult) Then
        Begin
          If (Pos(strEspSel, 'OF_' ) > 0) And fUsaRotinaWMS And (Not blnEhNFDevolucao) And (not blnCancelamentoDeBaixaDeRefugo) Then
          Begin
            blnResult := fCancelaItensDocumento('NF', strNumDocSel, strCliForSel, strSerieSel,
                                                fRetornaObjEnderecamentoDoc('NF', strNumDocSel, strCliForSel, strSerFsc, IIF(SameText(strTipFc,'CODFOR'), 'F','C')))
          End
          Else
            blnResult := fCancelaItensDocumento('NF', strNumDocSel, strCliForSel, strSerieSel);
        End;

        pStepBy(4);

        If (blnResult) Then
          blnResult := fCancelaContasPagar(strEspSel, 'NF', strNumDocSel, strCliForSel, strSerieSel);

        If (blnResult) And SameText(strEspSel, 'EF') Then
          blnResult := fCancelaContasPagarFunrural();

        If (blnResult) And SameText(strEspSel, 'OF') And SameText(strTipFc, 'CODCLI') Then
          blnResult := fCancelaContasPagarUC('NF', strNumDocSel, strCliForSel);

        If (blnResult) And SameText(strEspSel, 'OF') Then
            blnResult := fDesfaturarAjustesConfirmados('NF', strNumDocSel, strCliForSel);

        If (Pos(strEspSel,'NG_') > 0) and (blnResult) Then
        Begin
          pStepBy;

          {*******************************************}
          {* CANCELA PEDIDO DE COMPRA                *}
          {****************************************MV*}
          fPedidoCompraBaixado('NF', strNumDocSel, qryAux001);
          blnResult := fCancelaPedidoCompra(qryAux001.FieldByName('PCG_NUMPED').AsString);

          If (blnResult) And (fCfgSis('GARMAT',varBoolean)) Then
            blnResult := fDesfaturaPedidoVenda('NF', strNumDocSel, fCadEmp('CLIFIL'));
        End;

        pStepBy(3);

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar OF, NG ou EF';
      End

      //Cancelamento ordem de producao(producao fora loja) - Tinta de Máquina
      Else If (strEspSel = 'RO') Then
      Begin
        blnResult := fCancelouDocumentoRO(VS_strCodEmp, strNumDocSel, strCliForSel);
        pStepBy(7);

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar ordem de produção';
      End;

      If (blnResult) And (strEspSel = 'IF') Then
      Begin
        blnResult := fCancelouDocumentoIF;
        If (blnResult) Then
          blnResult := fCancelaCupomNoEcf;

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar cupom';
      End;

      If (blnResult) And
         (fCfgSis('UTICPP', varBoolean)) Then
      Begin
        TControleCupomPromocao.New
          .fRemoverCuponsNaoUtilizados(strNumDocSel, strEspSel, VS_strCodEmp)
          .Destroy;
      End;

      blnDocGarantia := (Pos(strEspSel,'GA_NW_') > 0);
      If blnResult And VS_strHabilitarCRM and (not blnPegaDados) and
        (not (blnDocGarantiaPropriaEmpresa or blnDocGarantia)) And (Not FblnCancelamentoAgrupamentoPedido) Then
      Begin
        With qryAux001, SQL Do
        Begin
          Close;
          Clear;
          Add('  UPDATE PROCRM ');
          Add('     SET PRO_OPEBAI = :OPEBAI, ');
          Add('                   PRO_DTABAI = :DTABAI  ');

          If fUsaProtocolo Then
          Begin
            Add(' WHERE AUTOINCREM = :AUTINC              ');
            ParamByName('AUTINC').AsString   := strAutIncProtocolo;
          End
          Else
          Begin
            Add(' WHERE PRO_NUMDOC = :NUMDOC ');
            Add('   AND PRO_ESPSEL = :ESPSEL ');
            Add('   AND PRO_CODEMP = :CODEMP ');
            Add('   AND PRO_CLIFOR = :CLIFOR ');
            Add('   AND PRO_TIP_FC = :TIP_FC ');
            ParamByName('NUMDOC').AsString   := strNumDocSel;
            ParamByName('ESPSEL').AsString   := strEspCan;
            ParamByName('CODEMP').AsString   := VS_strCodEmp;
            ParamByName('CLIFOR').AsString   := strCliForSel;
            ParamByName('TIP_FC').AsString   := IIF(SameText(strTipFc,'CODFOR'), 'F','C');
          End;

          ParamByName('OPEBAI').AsString   := strLoginUsuarioLogado;
          ParamByName('DTABAI').AsDateTime := fNow;

          ExecSQL;
          Close;
        End;

        objOcoCrm := fAtualizaInformacoesCRM(strNumDocSel,
                                             strEspCan,
                                             VS_strCodEmp,
                                             strCliForSel,
                                             strNumDocSel,
                                             strEspCan,
                                             strLoginUsuarioLogado,
                                             afcNenhum);
        If fUsaProtocolo Then
          objOcoCrm.strCodOco := fCampoTabela('PRO_CODOCO', 'PROCRM', ['AUTOINCREM'], [strAutIncProtocolo])
        Else
          objOcoCrm.strCodOco := fRetornaCodigoOcorrencia(objOcoCrm.strNumOrc,objOcoCrm.strEspOrc,'',objOcoCrm.strCodEmp,''); // nao pode pesquisar com cod. de cliente por conta do OR de Prospecto.
        objOcoCrm.strNomFrm := Self.Name;
        If Not fEmptyStr(objOcoCrm.strCodOco) Then
        Begin
          try
            qryConsulta := fCriaQuery;
            with qryConsulta, sql do
            begin
              Close;
              Clear;
              Add('SELECT DISTINCT DET_NUM_PD, DET_ESP_PD, DET_EMP_PD FROM DEL_MOVDET');
              Add('WHERE DET_NUMDOC = :NUMDOC AND DET_CODEMP = :CODEMP AND DET_ESPDOC = :ESPDOC');
              Add('AND COALESCE(DET_NUM_PD, "") <> "" ');
              ParamByName('NUMDOC').AsString := objOcoCrm.strNumOrc;
              ParamByName('CODEMP').AsString := objOcoCrm.strCodEmp;
              ParamByName('ESPDOC').AsString := objOcoCrm.strEspOrc;
              Open;

              If isEmpty Then
              Begin
                Close;
                Clear;
                Add('SELECT DISTINCT DET_NUM_PD, DET_ESP_PD, DET_EMP_PD FROM DEL_NOTDET');
                Add('WHERE DET_NUMDOC = :NUMDOC AND DET_CODEMP = :CODEMP AND DET_ESPDOC = :ESPDOC');
                Add('AND COALESCE(DET_NUM_PD, "") <> "" ');
                ParamByName('NUMDOC').AsString := objOcoCrm.strNumOrc;
                ParamByName('CODEMP').AsString := objOcoCrm.strCodEmp;
                ParamByName('ESPDOC').AsString := objOcoCrm.strEspOrc;
                Open;
              End;

              SetLength(FarrDocParaBaixa, 0);
              If Not qryConsulta.IsEmpty Then
              Begin
                qryConsulta.First;
                While Not qryConsulta.Eof Do
                Begin
                  SetLength(FarrDocParaBaixa, Length(FarrDocParaBaixa)+1);
                  FarrDocParaBaixa[Length(FarrDocParaBaixa)-1].strCodigoEmpresa := qryConsulta.FieldByName('DET_EMP_PD').AsString;
                  FarrDocParaBaixa[Length(FarrDocParaBaixa)-1].strEspecieDocumento := qryConsulta.FieldByName('DET_ESP_PD').AsString;
                  FarrDocParaBaixa[Length(FarrDocParaBaixa)-1].strNumeroDocumento := qryConsulta.FieldByName('DET_NUM_PD').AsString;

                  qryConsulta.Next;
                End;
              End;

              If qryConsulta.recordCount > 0 Then
                objOcoCrm.strCodOco := fRetornaCodigoOcorrencia(qryConsulta.FieldByName('DET_NUM_PD').AsString,
                                                                qryConsulta.FieldByName('DET_ESP_PD').AsString,'',
                                                                qryConsulta.FieldByName('DET_EMP_PD').AsString,''); // nao pode pesquisar com cod. de cliente por conta do OR de Prospecto.

            end;

            blnCancelaCRM := (Not qryConsulta.isEmpty) And
                             (Not fEmptyStr(qryConsulta.FieldByName('DET_NUM_PD').AsString));
            blnCancelaCRM := (blnCancelaCRM) And
                             ( (Not fUsaProtocolo) And (qryConsulta.recordCount > 1) ) Or
                             ( fUsaProtocolo );



            If (blnCancelaCRM And fUsaProtocolo) And (Not fEmptyStr(objOcoCrm.strCodOco)) Then
            Begin
              objOcoCrm.strDtaInc := VS_Date;
              objOcoCrm.strHorInc := fRetHoraServidor();
              objOcoCrm.strDtaAge := objOcoCrm.strDtaInc;
              objOcoCrm.strHorAge := objOcoCrm.strHorInc;
              objOcoCrm.strOpeHis := strLoginUsuarioLogado;
              objOcoCrm.strDtaCon := 0;//VS_Date;
              objOcoCrm.strHorCon := 0;//fNow;
              If Pos(strEspSel, 'PD') > 0 Then
                objOcoCrm.strCodToc := fCfgSis('PEDCAN', varString)
              Else
                objOcoCrm.strCodToc := fCfgSis('VENCAN', varString);

              If fEmptyStr(objOcoCrm.strCodToc) Then
              Begin
                blnResult := False;
                fRollback;
                strMensagemDeErro := 'CRM - Não foi definido o tipo de ocorrência para cancelamento';
                fMensagemCancelamento('ATENÇÃO!', 'Não foi definido o tipo de ocorrência para cancelamento!' + #13#10 +
                                      'Verifique nas configurações do sistema antes de prosseguir!', ['&Ok']);

              End
              Else
              Begin
                objOcoCrm.strDescri := afcDocumentoCancelado.fGetDescricao() + '<<csq>>' +
                                       'FINALIZANDO OCORRÊNCIA.' + '<<csq>><<csq>>'+
                                       'Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) +
                                       '<<csq>>' +
                                        DateToStr(VS_Date) + ' ' + TimeToStr(fNow) + ' - ' + objOcoCrm.strCodOpe + ' - ' + fRetNomeOperador(objOcoCrm.strCodOpe);

                objOcoCrm.pInsereHistoricoOcorrencia;
                objOcoCrm.pAtualizaOcorrencia;

                If objOcoCrm.strTip_Fc = 'P' Then
                Begin
                  TLogCatProspecto.fNew
                                  .strEmpDoc(VS_strCodEmp)
                                  .strEspDoc(strEspCan)
                                  .strNumDoc(strNumDocSel)
                                  .pRemoverLogCatVenda;

                  TCategoriaCrm.fNew
                               .fAtualizarCategoriaProspecto(fCfgSis('CATOPO', varString), objOcoCrm.strCodCli);

                End;
              End;
            End;

            If blnCancelaCRM Then
            Begin
              qryConsulta.First;
              While Not qryConsulta.Eof Do
              Begin
                objOcoCrm.strCodOco := fRetornaCodigoOcorrencia(qryConsulta.FieldByName('DET_NUM_PD').AsString,
                                                                qryConsulta.FieldByName('DET_ESP_PD').AsString,'',
                                                                qryConsulta.FieldByName('DET_EMP_PD').AsString,'');
                If Not fEmptyStr(objOcoCrm.strCodOco) Then
                Begin
                  objOcoCrm.strCodToc := fCfgSis('PEDCAN', varString);
                  objOcoCrm.strCodEmp := qryConsulta.FieldByName('DET_EMP_PD').AsString;
                  objOcoCrm.strEspDoc := qryConsulta.FieldByName('DET_ESP_PD').AsString;
                  objOcoCrm.strNumDoc := qryConsulta.FieldByName('DET_NUM_PD').AsString;
                  objOcoCrm.strDtaInc := VS_Date;
                  objOcoCrm.strHorInc := fRetHoraServidor();
                  objOcoCrm.strDtaAge := objOcoCrm.strDtaInc;
                  objOcoCrm.strHorAge := objOcoCrm.strHorInc;
                  objOcoCrm.strOpeHis := strLoginUsuarioLogado;
                  objOcoCrm.strDtaCon := 0;//VS_Date;
                  objOcoCrm.strHorCon := 0;//fNow;
                  If Pos(strEspSel, 'PD') > 0 Then
                    objOcoCrm.strCodToc := fCfgSis('PEDCAN', varString)
                  Else
                    objOcoCrm.strCodToc := fCfgSis('VENCAN', varString);

                  If fEmptyStr(objOcoCrm.strCodToc) Then
                  Begin
                    blnResult := False;
                    fRollback;
                    strMensagemDeErro := 'CRM - Não foi definido o tipo de ocorrência para cancelamento';
                    fMensagemCancelamento('ATENÇÃO!', 'Não foi definido o tipo de ocorrência para cancelamento!' + #13#10 +
                                          'Verifique nas configurações do sistema antes de prosseguir!', ['&Ok']);

                  End
                  Else
                  Begin
                    objOcoCrm.strDescri := afcDocumentoCancelado.fGetDescricao() + '<<csq>>' +
                                           'FINALIZANDO OCORRÊNCIA.' + '<<csq>><<csq>>'+
                                           'Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) +
                                           '<<csq>>' +
                                            DateToStr(VS_Date) + ' ' + TimeToStr(fNow) + ' - ' + objOcoCrm.strCodOpe + ' - ' + fRetNomeOperador(objOcoCrm.strCodOpe);

                    objOcoCrm.strDocumentosCancelamento := objOcoCrm.strDocumentosCancelamento +
                                                           qryConsulta.FieldByName('DET_NUM_PD').AsString+'-'+
                                                           qryConsulta.FieldByName('DET_ESP_PD').AsString+'-'+
                                                           qryConsulta.FieldByName('DET_EMP_PD').AsString+'.'+#13;

                    objOcoCrm.pInsereHistoricoOcorrencia;
                    objOcoCrm.pAtualizaOcorrencia;

                    If objOcoCrm.strTip_Fc = 'P' Then
                    Begin
                      TLogCatProspecto.fNew
                                      .strEmpDoc(VS_strCodEmp)
                                      .strEspDoc(strEspCan)
                                      .strNumDoc(strNumDocSel)
                                      .pRemoverLogCatVenda;

                      TCategoriaCrm.fNew
                                   .fAtualizarCategoriaProspecto(fCfgSis('CATOPO', varString), objOcoCrm.strCodCli);

                    End;
                  End;
                End;

                qryConsulta.Next;
              End;
            End
            Else If (Not fEmptyStr(objOcoCrm.strCodOco)) Then
            Begin
              objOcoCrm.strDtaInc := VS_Date;
              objOcoCrm.strHorInc := fRetHoraServidor();
              objOcoCrm.strDtaAge := objOcoCrm.strDtaInc;
              objOcoCrm.strHorAge := objOcoCrm.strHorInc;
              objOcoCrm.strOpeHis := strLoginUsuarioLogado;

              If (strEspCan = 'PR') Then
              Begin
                objOcoCrm.strDtaCon := VS_Date;
                objOcoCrm.strHorCon := fNow;
              End
              Else
              Begin
                objOcoCrm.strDtaCon := 0;
                objOcoCrm.strHorCon := 0;
              End;

              If Pos(strEspSel, 'PD') > 0 Then
                objOcoCrm.strCodToc := fCfgSis('PEDCAN', varString)
              Else
                objOcoCrm.strCodToc := fCfgSis('VENCAN', varString);

              If fEmptyStr(objOcoCrm.strCodToc) Then
              Begin
                blnResult := False;
                fRollback;
                strMensagemDeErro := 'CRM - Não foi definido o tipo de ocorrência para cancelamento';
                fMensagemCancelamento('ATENÇÃO!', 'Não foi definido o tipo de ocorrência para cancelamento!' + #13#10 +
                                      'Verifique nas configurações do sistema antes de prosseguir!', ['&Ok']);

              End
              Else
              Begin
                objOcoCrm.strDescri := afcDocumentoCancelado.fGetDescricao() + '<<csq>>' +
                                       'FINALIZANDO OCORRÊNCIA.' + '<<csq>><<csq>>'+
                                       'Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) +
                                       '<<csq>>' +
                                        DateToStr(VS_Date) + ' ' + TimeToStr(fNow) + ' - ' + objOcoCrm.strCodOpe + ' - ' + fRetNomeOperador(objOcoCrm.strCodOpe);

                objOcoCrm.pInsereHistoricoOcorrencia;
                objOcoCrm.pAtualizaOcorrencia;

                If objOcoCrm.strTip_Fc = 'P' Then
                Begin
                  TLogCatProspecto.fNew
                                  .strEmpDoc(VS_strCodEmp)
                                  .strEspDoc(strEspCan)
                                  .strNumDoc(strNumDocSel)
                                  .pRemoverLogCatVenda;

                  TCategoriaCrm.fNew
                               .fAtualizarCategoriaProspecto(fCfgSis('CATOPO', varString), objOcoCrm.strCodCli);

                End;
              End;
            End;

          finally
            FreeAndNil(qryConsulta);
          end;
          strMensagemCancelamento := objOcoCrm.strMensagemCancelamento;
        End;

        If ((fUsaProtocolo) And (fCfgSis('FINOCO', varBoolean))) Then
        Begin
          qryTmpAux := fCriaQuery;
          objOcoCrmProt := TAtuOcoCrm.Create(Self);
          Try
            qryTmpAux.Close;
            qryTmpAux.SQL.Clear;
            qryTmpAux.SQL.Add('SELECT PRO_CODOCO,');
            qryTmpAux.SQL.Add('       PRO_TIP_FC,');
            qryTmpAux.SQL.Add('       PRO_CODEMP ');
            qryTmpAux.SQL.Add('FROM PROCRM ');
            qryTmpAux.SQL.Add('  WHERE ');
            qryTmpAux.SQL.Add('  AUTOINCREM = :AUTINC');
            qryTmpAux.ParamByName('AUTINC').AsString := strAutIncProtocolo;

            qryTmpAux.Open;
            If Not qryTmpAux.isEmpty Then
            Begin
              objOcoCrmProt.pCarregaOcorrencia(qryTmpAux.FieldByName('PRO_TIP_FC').AsString,
                                               qryTmpAux.FieldByName('PRO_CODOCO').AsString,
                                               qryTmpAux.FieldByName('PRO_CODEMP').AsString);
              objOcoCrmProt.pFinalizaOcorrencia(objOcoCrm.strDescri, strLoginUsuarioLogado);
            End;
          Finally
            FreeAndNil(objOcoCrmProt);
            FreeAndNil(qryTmpAux);
          End;
        End;

        FreeAndNil(objOcoCrm);
      End;

    Finally
      If blnResult And SameText(strEspSel, 'NE') And (Not blnNotaImportacao) Then
      Begin
        If (Not fValidadeIntegridadeCancelamentoNE(edtNumDoc.Text, edtSerie.Text, edtCliFor.Text )) And
           (Not fValidadeIntegridadeCancelamentoNE_NOTGER(edtNumDoc.Text, edtSerie.Text, edtCliFor.Text))  Then
        Begin
          fRollback;
          blnResult := False;
          strMensagemDeErro := 'Problema ao cancelar nota especial';
          fMensagemCancelamento('ATENÇÃO!', 'Houve falhas no cancelamento do documento, entre em contato com a Citel!', ['&Ok']);
        End;
      End;
    End;

    If fCfgSis('UTLPRJ', varBoolean) And Not fEmptyStr(strCodPrj) Then
      TProjeto.pRecalculaProjeto(strCodPrj);

    If (blnResult) And (strEspSel = 'PD') Then
      blnResult := fCancelaItensEfetivadosOrcamentoEmPedido(strNumDocSel, strEspSel, strCliForSel);

    If (blnResult) Then
    Begin

      objPromocaoLimitePorClienteOuVenda := TPromocaoLimitePorClienteOuVenda.Create('');

      Try

        objPromocaoLimitePorClienteOuVenda.pSetNumDoc(strNumDocSel);
        objPromocaoLimitePorClienteOuVenda.pSetEspDoc(strEspSel);
        objPromocaoLimitePorClienteOuVenda.pSetEmpDoc(VS_strCodEmp);

        If (objPromocaoLimitePorClienteOuVenda.fExisteLancamentos) Then
        Begin
          Try
            objPromocaoLimitePorClienteOuVenda.pDeletar;
          Except
            fRollback;
            blnResult := False;
            strMensagemDeErro := 'Não foi possível estornar as quantidades referentes a promoção com quantidade limite por cliente!';
            fMensagemCancelamento('ATENÇÃO!', strMensagemDeErro, ['&Ok']);
          End;
        End;

      Finally
        FreeAndNil(objPromocaoLimitePorClienteOuVenda);
      End;

    End;

    If (blnResult) Then
      pVerificaDocumentoJaFoiAvaliado(strNumDocSel, strEspSel, VS_strCodEmp);

    If (blnResult) Then
    Begin
      If MatchStr(strEspSel, ['PD','OR','FF','NF','IF']) Then
      Begin
        If (Not FAuditFaturamento.fValidouTodas(strCodErrosAuditoria)) Then
        Begin
          blnResult := False;
          pMostraErrosAuditoria(strCodErrosAuditoria);
        End;
      End;
    End;

    If (blnResult) Then
    Begin
      fCommit;

      pAtualizaLogDeCancelamento(strAutIncLogCan, False, True, True, False, 'Cancelamento no Autcom concluido com sucesso.');

      pAlimentaTarefasRomaneioFusion(strNumDocSel, strEspSel);

      {*******************************************}
      {* INTEGRAÇÃO IMPLEMENTADA                 *}
      {****************************************NC*}
      If (Pos(strEspSel, 'NF_EL_NS_IF_IV_D1_NI_NC_IC_DC_' ) > 0) and
         (Not FNFSeSubstituicao) And
         (blnCancNFeOK) And
         (Not fCfgSis('CANNFS', VarBoolean)) Then
      begin
        fMensagemCancelamento('', 'Após o cancelamento no AUTCOM é necessário o cancelamento no sistema do órgão emissor, pois ainda' + #13#10 +
                      'não existe integração de cancelamento com estes orgãos.', ['&O K']);
      end;

      blnConfirma := True;

      pAtualizaUltComCliente(strCliForSel);
      pAtualizaUltVendaItens;

      fDisparaWhatsappAutomatico(strNumDocSel,
                                 strEspSel,
                                 strEspSel,
                                 '',
                                 'CN',
                                 '',
                                 strCliForSel,
                                 '',
                                 True,
                                 '',
                                 TGeraArquivoAnexoEmailAutomatico.New(strNumDocSel,
                                                                      strEspSel,
                                                                      VS_strCodEmp,
                                                                      strCliForSel,
                                                                      True),
                                 '',
                                 '',
                                 '',
                                 Self.UnitName);


      If (Pos(strEspSel, 'RL_LE_') <= 0) Then
        fDisparaEmailAutomatico(strNumDocSel,
                                strEspSel,
                                strEspSel,
                                '',
                                'CN',
                                '',
                                strCliForSel,
                                '',
                                '',
                                TGeraArquivoAnexoEmailAutomatico.New(strNumDocSel,
                                                                     strEspSel,
                                                                     VS_strCodEmp,
                                                                     strCliForSel,
                                                                     True));

      fDisparaSMSAutomatico(strNumDocSel, strEspSel,strEspSel,'', 'CN', '', strCliForSel);

      If Not fEmptyStr(strMensagemCancelamento) Then
      Begin
        pProcessarMensagemCancelamentoCRM(strMensagemCancelamento);
      End;

    End
    Else
    Begin
      fRollBack;

      pAtualizaLogDeCancelamento(strAutIncLogCan, False, False, False, True, strMensagemDeErro);

      If blnLimpouUltimaCompra Then
        pAtualizaUltComCliente(strCliForSel);

      pAtribuiPicture(Nil);
    End;

    objFechamentoEstoque.pDestravaFechamentoEstoque(traMovimentacao);
    objFechamentoFiscal.pDestravaFechamentoFiscal(trfMovimentacao);

    If (blnResult) And (blnConfirma) And (strTipFc = 'CODCLI') And
       (fCfgSis('UTINPS', varBoolean)) Then
      TNetpoints.pTransmitirNetpointsCancelados(strNumDocSel, strEspSel, VS_strCodEmp,
        strCliForSel, IIF(Pos(strEspSel, 'OR_PD_') > 0, '', IIF(edtSerie.Visible, strSerieSel, strSerFsc)));

    if (blnResult) and (blnConfirma) and (fCfgSis('PONQUE', varBoolean)) then
    begin
      fEstornaQuestFidelidade(strNumDocSel, strEspSel, VS_strCodEmp);
    end;

    If (blnResult) Then
      pReabrirOcorrenciaAD(strNumOco);

    If (blnResult) Then
    Begin
      If Not fEmptyStr(strPedidosOutraLoja) Then
      Begin
        fMensagemCancelamento('', 'Os documentos ' + strPedidosOutraLoja + ' não foram cancelados pois os mesmos são originados de outra loja.');
        strPedidosOutraLoja := '';
      End;

      If (Not blnFaturamento) Then
        btnCancelar.Click;

      FblnCancelamentoComSucesso := True;
    End
    Else
    Begin

      If (lstCtrBaixadas.Count > 0) Or (lstCtpBaixadas.Count > 0) Or (lstCtpReteBaix.Count > 0) Or
         (lstCtpGnrBaixa.Count > 0) Or (lstCtpCFrBaixa.Count > 0) Or (lstCtpAntBaixa.Count > 0) Or
         (FCtrPixGerado.Count > 0) Then
      Begin
        pGeraResumo;
        Exit;
      End;

    End;

    if blnResult and fCfgSis('ABADEP', varBoolean) then
      pExibirAvisoAbastecimentoDeposito(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel);

    pAtualizaStatusPedidos;
  Finally
    pDestravarRomaneio(strEspSel);
    objFechamentoEstoque.pDestravaFechamentoEstoque(traMovimentacao);
    objFechamentoFiscal.pDestravaFechamentoFiscal(trfMovimentacao);

    blnApagPed := False;
    qryAux001.Close;
    FreeAndNil(qryAux001);

    If FblnCancelamentoComSucesso And blnEhCancelamentoX929 Then
      fMensagemCancelamento('ATENÇÃO!','O cancelamento desta nota fiscal, não cancelará o documento vinculado'+#13+'( NFC-e / CF-e ) !',['&Ok']);

    blnFecharForm := blnFaturamento;

    if blnResult and (blnPassouDocumento ) then
      Self.Close;
  End;

end;

procedure TfrmCancelamentoDocumentos.pProcessarMensagemCancelamentoCRM(strMensagemCancelamento: String);
var
  blnBaixarPedidos: Boolean;
  frmObservacao: TfrmObservacao;
  intCnt: Integer;
Begin
  If (Not fSuportaInterfaceGrafica) Then
    Exit;

  blnBaixarPedidos := False;
  If Length(FarrDocParaBaixa) > 1 Then
  Begin
    Try
      pCriarFormularios(TfrmObservacao, frmObservacao);
      Try
        frmObservacao.lblMensagem.caption := 'Baixar Os Pedidos/Orçamentos através do CRM.';
        frmObservacao.memObs.Texto := strMensagemCancelamento + ' Deseja baixar o(s) Pedido(s) agora? ';
        frmObservacao.blnUtilizarConfirmacao := True;
        frmObservacao.ShowModal;
        If frmObservacao.blnConfirmou Then
        Begin
            blnBaixarPedidos:= True;
          End;
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[frmCancelamentoDocumentos.fVerificaDocumentoAgrupado]');
        End;
      End;
    Finally
      pFreeAndNil(frmObservacao);
    End;
  End
  Else
  Begin
    If fMensagem('Atenção', strMensagemCancelamento +
                            ' Deseja baixar o(s) Pedido(s) agora? ', ['&Sim', '&Não' ],2) = 1 Then
    Begin
      blnBaixarPedidos:= True;
    End;
  End;

  If blnBaixarPedidos Then
    pBaixarPedidosComoNaoEntregueCRM
  Else If (fCfgSis('CFMICO', varBoolean)) Then
  Begin
    If fMensagem('Atenção', 'Deseja manter o Pedido conferido? ', ['&Sim', '&Não' ],2) = 1 Then
    Begin
      Try
        fStartTransaction;
        For intCnt:= 0 To Length(FarrDocParaBaixa)-1 Do
        Begin
          fRetornaLOTDORPedido(FarrDocParaBaixa[intCnt].strNumeroDocumento,
                               FarrDocParaBaixa[intCnt].strEspecieDocumento,
                               FarrDocParaBaixa[intCnt].strCodigoEmpresa,
                               '',
                               (not FAtualizouEstoqueLote));
          fRetornaSEPFDOPedido(FarrDocParaBaixa[intCnt].strNumeroDocumento,
                               FarrDocParaBaixa[intCnt].strEspecieDocumento,
                               FarrDocParaBaixa[intCnt].strCodigoEmpresa);


        End;
        fCancelaEnderecamento(FstrDocumentoSelecionado);
        fCommit;
        Except
        On Erro: Exception Do
        Begin
          pMensagensErro(Erro.Message, '[TfrmCancelamentoDocumentos.MantemPedidoConferido]');
          fRollBack;
        End;
      End;
    End;
  End;

End;

procedure TfrmCancelamentoDocumentos.fRetornaLOTDORPedido(strNumDoc, strEspDoc, strCodEmp: String; ACodIte: String = ''; AAtualizaSaldo: Boolean = True);
  Const
    strLotdor : String = 'SELECT LDO_NUMLOT, LDO_QTDITE, LDO_SEQFDO, LDO_CODSEP, LDO_SEPCOL, LDO_QTDDIV, '+
                         'LDO_SALCAL, LDO_MOVENT, LDO_MOVSAI, LDO_QTDSEP, LDO_EXCLUI, LDO_PEDCAN FROM LOTDOR WHERE FALSE';

  Var
    qryDelLotDor: TUniQuery;
    qryLotDor: TUniQuery;
    intContaCampo : Integer;
    stlCampos : TStringList;
    strSeqDel : String;
    strCodIte: String;
    strEmpIte: String;
begin
  If fEmptyStr(strNumDoc) Then
    Exit;

  qryDelLotDor := fCriaQuery;
  qryLotDor := fCriaQuery;
  strSeqDel := '';

  stlCampos :=  TStringList.Create;
  Try
    qryDelLotDor.Close;
    qryDelLotDor.SQL.Clear;
    qryDelLotDor.SQL.Add('SELECT L.AUTOINCREM, L.LDO_NUMLOT, L.LDO_QTDITE, L.LDO_SEQFDO, L.LDO_CODSEP, L.LDO_SEPCOL, L.LDO_QTDDIV, ');
    qryDelLotDor.SQL.Add('L.LDO_SALCAL, L.LDO_MOVENT, L.LDO_MOVSAI, L.LDO_QTDSEP, L.LDO_EXCLUI, L.LDO_PEDCAN FROM DEL_LOTDOR L ');
    qryDelLotDor.SQL.Add('INNER JOIN FATDOR F ON L.LDO_SEQFDO = F.AUTOINCREM ');
    qryDelLotDor.SQL.Add('WHERE F.FDO_NUMDOC = :NUMDOC');
    qryDelLotDor.SQL.Add('  AND F.FDO_CODEMP = :CODEMP');
    qryDelLotDor.SQL.Add('  AND F.FDO_ESPDOC = :ESPDOC');

    if (not fEmptyStr(ACodIte)) then
    begin
      qryDelLotDor.SQL.Add('  AND F.FDO_CODITE = :CODITE');
      qryDelLotDor.ParamByName('CODITE').AsString := ACodIte;
    end;

    qryDelLotDor.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDelLotDor.ParamByName('CODEMP').AsString := strCodEmp;
    qryDelLotDor.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDelLotDor.Open;

    qryLotDor.Close;
    qryLotDor.SQL.Clear;
    qryLotDor.SQL.Text := strLotdor;
    qryLotDor.Open;
    qryLotDor.GetFieldNames(stlCampos);

    qryLotDor.Close;
    qryLotDor.SQL.Clear;
    qryLotDor.SQL.Text := 'INSERT INTO LOTDOR(AUTOINCREM,LDO_NUMLOT,LDO_QTDITE,LDO_SEQFDO,LDO_CODSEP,LDO_SEPCOL,LDO_QTDDIV,'+
                                             'LDO_SALCAL,LDO_MOVENT,LDO_MOVSAI,LDO_QTDSEP,LDO_EXCLUI,LDO_PEDCAN)'+
                          'VALUES(:AUTOINC,:LDO_NUMLOT,:LDO_QTDITE,:LDO_SEQFDO,:LDO_CODSEP,:LDO_SEPCOL,:LDO_QTDDIV, '+
                                 ':LDO_SALCAL,:LDO_MOVENT,:LDO_MOVSAI,:LDO_QTDSEP,:LDO_EXCLUI,:LDO_PEDCAN)';

    qryDelLotDor.Open;
    qryDelLotDor.First;

    While Not qryDelLotDor.Eof Do
    Begin

      For intContaCampo := 0 to stlCampos.Count - 1 Do
      Begin
         If (stlCampos[intContaCampo] <> 'AUTOINCREM') Then
           qryLotDor.ParamByName(stlCampos[intContaCampo]).Value := qryDelLotDor.FieldByName(stlCampos[intContaCampo]).Value;
      End;

      qryLotDor.ParamByName('AUTOINC').AsString := fRetAutoIncrem('LOTDOR', VS_strCodEmp);

      strCodIte := fCampoTabela('FDO_CODITE', 'FATDOR', ['AUTOINCREM'], [qryDelLotDor.FieldByName('LDO_SEQFDO').AsString]);
      strEmpIte := fCampoTabela('FDO_EMPITE', 'FATDOR', ['AUTOINCREM'], [qryDelLotDor.FieldByName('LDO_SEQFDO').AsString]);

      if AAtualizaSaldo then
      begin
        objCadLot.fAtualizaEstoqueLote(strCodIte, 'E', qryDelLotDor.FieldByName('LDO_NUMLOT').AsString, qryDelLotDor.FieldByName('LDO_QTDITE').AsFloat, strEmpIte);
        objCadLot.fAtualizaEstoqueLote(strCodIte, 'S', 'A DEFINIR', qryDelLotDor.FieldByName('LDO_QTDITE').AsFloat, strEmpIte);
      end;

      ReprocessarItem(strCodIte, strEmpIte, True, True);

      qryLotDor.ExecSQL;

      pIncrementaListaStr(qryDelLotDor.FieldByName('AUTOINCREM').AsString, strSeqDel, True, True);

      qryDelLotDor.Next;
    End;

    If (strSeqDel <> '') Then
    Begin
      qryDelLotDor.Close;
      qryDelLotDor.SQL.Clear;
      qryDelLotDor.SQL.Text := 'DELETE FROM DEL_LOTDOR WHERE AUTOINCREM IN (' + strSeqDel + ')';
      qryDelLotDor.ExecSQL;
    End;

  Finally
    FreeAndNil(qryLotDor);
    FreeAndNil(qryDelLotDor);
    FreeAndNil(stlCampos);
  End;
end;

procedure TfrmCancelamentoDocumentos.fRetornaSEPFDOPedido(strNumDoc, strEspDoc, strCodEmp: String; ACodIte: String = '');
  Const
    strSepFdo : String = 'SELECT FDO_SEQFDO, FDO_QTDITE, FDO_QTDSEP, FDO_CODSEP, FDO_CODCON, FDO_OPELOG, FDO_DTASEP, FDO_HORSEP, FDO_VOLEXP, FDO_IMPSEQ FROM SEPFDO WHERE FALSE';

  Var
    qryDelSepFdo: TUniQuery;
    qrySepFdo: TUniQuery;
    intContaCampo : Integer;
    stlCampos : TStringList;
    strSeqDel : String;
begin
  If fEmptyStr(strNumDoc) Then
    Exit;

  qryDelSepFdo := fCriaQuery;
  qrySepFdo := fCriaQuery;
  strSeqDel := '';

  stlCampos :=  TStringList.Create;
  Try
    qryDelSepFdo.Close;
    qryDelSepFdo.SQL.Clear;
    qryDelSepFdo.SQL.Add('SELECT L.AUTOINCREM, L.FDO_SEQFDO,L.FDO_QTDITE,L.FDO_QTDSEP,L.FDO_CODSEP,L.FDO_CODCON,L.FDO_OPELOG,L.FDO_DTASEP,L.FDO_HORSEP,L.FDO_VOLEXP,L.FDO_IMPSEQ FROM DEL_SEPFDO L ');
    qryDelSepFdo.SQL.Add('INNER JOIN FATDOR F ON L.FDO_SEQFDO = F.AUTOINCREM ');
    qryDelSepFdo.SQL.Add('WHERE F.FDO_NUMDOC = :NUMDOC');
    qryDelSepFdo.SQL.Add('  AND F.FDO_CODEMP = :CODEMP');
    qryDelSepFdo.SQL.Add('  AND F.FDO_ESPDOC = :ESPDOC');

    if (not fEmptyStr(ACodIte)) then
    begin
      qryDelSepFdo.SQL.Add('  AND F.FDO_CODITE = :CODITE');
      qryDelSepFdo.ParamByName('CODITE').AsString := ACodIte;
    end;

    qryDelSepFdo.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDelSepFdo.ParamByName('CODEMP').AsString := strCodEmp;
    qryDelSepFdo.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDelSepFdo.Open;

    qrySepFdo.Close;
    qrySepFdo.SQL.Clear;
    qrySepFdo.SQL.Text := strSepFdo;
    qrySepFdo.Open;
    qrySepFdo.GetFieldNames(stlCampos);

    qrySepFdo.Close;
    qrySepFdo.SQL.Clear;
    qrySepFdo.SQL.Text := 'INSERT INTO SEPFDO (AUTOINCREM,FDO_SEQFDO,FDO_QTDITE,FDO_QTDSEP,FDO_CODSEP,FDO_CODCON,FDO_OPELOG,FDO_DTASEP,FDO_HORSEP,FDO_VOLEXP,FDO_IMPSEQ)'+
                          'VALUES(:AUTOINC,:FDO_SEQFDO,:FDO_QTDITE,:FDO_QTDSEP,:FDO_CODSEP,:FDO_CODCON,:FDO_OPELOG,:FDO_DTASEP,:FDO_HORSEP,:FDO_VOLEXP,:FDO_IMPSEQ)';

    qryDelSepFdo.Open;
    qryDelSepFdo.First;

    While Not qryDelSepFdo.Eof Do
    Begin

      For intContaCampo := 0 to stlCampos.Count - 1 Do
      Begin
        If (stlCampos[intContaCampo] <> 'AUTOINCREM') Then
          qrySepFdo.ParamByName(stlCampos[intContaCampo]).AsString := qryDelSepFdo.FieldByName(stlCampos[intContaCampo]).AsString;
      End;

      qrySepFdo.ParamByName('AUTOINC').AsString := fRetAutoIncrem('SEPFDO', VS_strCodEmp);

      qrySepFdo.ExecSQL;

      pIncrementaListaStr(qryDelSepFdo.FieldByName('AUTOINCREM').AsString, strSeqDel, True, True);

      qryDelSepFdo.Next;
    End;

    If (strSeqDel <> '') Then
    Begin
      qryDelSepFdo.Close;
      qryDelSepFdo.SQL.Clear;
      qryDelSepFdo.SQL.Text := 'DELETE FROM DEL_SEPFDO WHERE AUTOINCREM IN (' + strSeqDel + ')';
      qryDelSepFdo.ExecSQL;
    End;

  Finally
    FreeAndNil(qrySepFdo);
    FreeAndNil(qryDelSepFdo);
    FreeAndNil(stlCampos);
  End;
end;

procedure TfrmCancelamentoDocumentos.fCancelaEnderecamento(strNumDoc: String);
  Var
    qryDelEnder: TUniQuery;
    qryExtGor: TUniQuery;
begin
  If fEmptyStr(strNumDoc) Then
    Exit;

  qryDelEnder := fCriaQuery;
  qryExtGor := fCriaQuery;

  Try
    qryExtGor.Close;
    qryExtGor.SQL.Clear;
    qryExtGor.SQL.Add('SELECT E.FGO_SEQFGO FROM EXTGOR E WHERE LOCATE (:DOCUMEN, E.FGO_DOCEND) > 0');
    qryExtGor.ParamByName('DOCUMEN').AsString := strNumDoc+'NF';

    qryExtGor.Open;


    While Not qryExtGor.Eof Do
    Begin
      qryDelEnder.SQL.Clear;
      qryDelEnder.SQL.Text := 'DELETE FROM FATDOR WHERE FDO_SEQGER = :SEQGER';
      qryDelEnder.ParamByName('SEQGER').AsString := qryExtGor.FieldByName('FGO_SEQFGO').AsString;
      qryDelEnder.ExecSQL;

      qryDelEnder.SQL.Clear;
      qryDelEnder.SQL.Text := 'DELETE FROM EXTGOR WHERE FGO_SEQFGO = :SEQGER';
      qryDelEnder.ParamByName('SEQGER').AsString := qryExtGor.FieldByName('FGO_SEQFGO').AsString;
      qryDelEnder.ExecSQL;

      qryDelEnder.SQL.Clear;
      qryDelEnder.SQL.Text := 'DELETE FROM FATGOR WHERE AUTOINCREM = :SEQGER';
      qryDelEnder.ParamByName('SEQGER').AsString := qryExtGor.FieldByName('FGO_SEQFGO').AsString;
      qryDelEnder.ExecSQL;

      qryExtGor.Next;
    End;

  Finally
    FreeAndNil(qryExtGor);
    FreeAndNil(qryDelEnder);
  End;
end;


function TfrmCancelamentoDocumentos.fCancelarDocumentos(
  pgbProgresso: TcxProgressBar): Boolean;
  var
    LObjRetornoConsignacaoBuilder : TRetornoConsignacaoBuilder;
    LObjRetornoConsignacao        : TRetornoConsignacao;
    LObjInformacaoDocumentoAbastecimentoDeposito: TInformacaoDocumentoAbastecimentoDeposito;
    LCodEmpBkp: String;
    LDocumentos: String;
    LInutilizacaoBkp : Boolean;
    LStatus : String;
    LDifChvAcesso : Boolean;
begin

  If Not fVerificaCampos Then
  Begin
    Result := False;
    Exit;
  End;

  Try
    strDocumentoJaConstaComoCanceladoNaSefaz := '';
    FblnCancelamentoComSucesso := False;

    if Assigned(LObjDocumentosAbastecimentoDeposito) then
      FreeAndNil(LObjDocumentosAbastecimentoDeposito);

    LObjDocumentosAbastecimentoDeposito := TDocumentosAbastecimentoDeposito.Create(edtNumDoc.Text, arrEspecies[intIndiceEsp][0], VS_strCodEmp, edtCliFor.Text);
    LObjDocumentosAbastecimentoDeposito.EhCancelamento := True;
    LObjDocumentosAbastecimentoDeposito.pCarregaDocumentosDeAbastecimentoDeposito;

    pCancelarDocumentos(pgbProgresso);

    if (Pos(FstrEspecieSelecionada,'NF_FF_') > 0) and
       (fCfgSis('RETACS',varBoolean)) and
       (FblnCancelamentoComSucesso) then
    Begin
      LObjRetornoConsignacaoBuilder := TRetornoConsignacaoBuilder.Create;
      Try
        LObjRetornoConsignacaoBuilder.NumeroDoDocumentoDoFaturamento  := FstrDocumentoSelecionado;
        LObjRetornoConsignacaoBuilder.EspecieDoDocumentoDoFaturamento := FstrEspecieSelecionada;
        LObjRetornoConsignacaoBuilder.EmpresaDoDocumentoDoFaturamento := VS_strCodEmp;
        LObjRetornoConsignacaoBuilder.pApagarConsignacaoRetornoDetalhe(Self.Name);

        LObjRetornoConsignacaoBuilder.pCarregarRetornosDaConsignacaoFaturada(FstrDocumentoSelecionado, FstrEspecieSelecionada, VS_strCodEmp, FstrSerieSelecionada);
        if LObjRetornoConsignacaoBuilder.ObjRetornoConsignacaoList.Count <> 0 then
        Begin
          LDocumentos := '';

          for LObjRetornoConsignacao in LObjRetornoConsignacaoBuilder.ObjRetornoConsignacaoList do
            pIncrementaListaStr(LObjRetornoConsignacao.NumeroDoDocumentoDoRetorno  +'-'+
                                LObjRetornoConsignacao.EspecieDoDocumentoDoRetorno +'-'+
                                LObjRetornoConsignacao.EmpresaDoDocumentoDoRetorno, LDocumentos);

          pMensagemOk('Existe(m) retorno(s) de consignação automático(s) vinculado(s) ao documento processado, que também será(ão) cancelado(s): '+ LDocumentos);

          for LObjRetornoConsignacao in LObjRetornoConsignacaoBuilder.ObjRetornoConsignacaoList do
          Begin
            edtNumDoc.Text                            := LObjRetornoConsignacao.NumeroDoDocumentoDoRetorno;
            edtCliFor.Text                            := IIF(Not fEmptyStr(LObjRetornoConsignacao.ClienteDoDocumentoDoRetorno),
                                                             LObjRetornoConsignacao.ClienteDoDocumentoDoRetorno,
                                                             FstrClienteSelecionado);
            edtSerie.Text                             := LObjRetornoConsignacao.SerieDoDocumentoDoRetorno;
            FblnCancelandoRetornoConsignadoAutomatico := True;
            strNumDocCanc                             := LObjRetornoConsignacao.NumeroDoDocumentoDoRetorno;
            blnLiberouProtocoloComSenha               := True;

            if LObjRetornoConsignacao.EspecieDoDocumentoDoRetorno = 'NF' then
              lsbEspecies.ItemIndex := intIndiceNF
            else
              lsbEspecies.ItemIndex := intIndiceCR;

            lsbEspeciesDblClick(Nil);

            pCancelarDocumentos(pgbProgresso);
          End;

          FblnCancelandoRetornoConsignadoAutomatico := False;
          blnLiberouProtocoloComSenha               := False;
        End;

      Finally
        strNumDocCanc := '';
        FreeAndNil(LObjRetornoConsignacaoBuilder);
      End;
    End;

    If (Pos(FstrEspecieSelecionada,'NF_FF_IF_') > 0) And
       (fCfgSis('ABADEP',varBoolean)) And
       (FblnCancelamentoComSucesso) Then
    Begin
      LInutilizacaoBkp := chkInutilizacao.Checked;
      Try
        LCodEmpBkp := VS_strCodEmp;

        If LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList.Count > 0 Then
        Begin
          For LObjInformacaoDocumentoAbastecimentoDeposito In LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList DO
          Begin
            edtNumDoc.Text := LObjInformacaoDocumentoAbastecimentoDeposito.NumDoc;
            edtCliFor.Text := LObjInformacaoDocumentoAbastecimentoDeposito.CodCli;
            edtSerie.Text := LObjInformacaoDocumentoAbastecimentoDeposito.Serie_;
            edtTipPes.Text := LObjInformacaoDocumentoAbastecimentoDeposito.Tip_FC;
            pSetaEmpresaLogada(LObjInformacaoDocumentoAbastecimentoDeposito.CodEmp);
            strNumDocCanc := LObjInformacaoDocumentoAbastecimentoDeposito.NumDoc;
            blnPedidoEntrada := False;
            blnLiberouProtocoloComSenha := True;
            blnPassouDocumento := True;

            If LeftStr(LObjInformacaoDocumentoAbastecimentoDeposito.ClaFis, 1) < '5' Then
            Begin
              FstrEspecieSelecionada := 'NE';
              lsbEspecies.ItemIndex := intIndiceNE;
              FblnAbastecimentoPeloDeposito := True;
            End
            Else
            Begin
              FstrEspecieSelecionada := LObjInformacaoDocumentoAbastecimentoDeposito.EspDoc;
              lsbEspecies.ItemIndex := intIndiceNF;
              FblnAbastecimentoPeloDeposito := False;
            End;

            lsbEspeciesDblClick(Nil);
            chkInutilizacao.Checked := LInutilizacaoBkp;
            If (Pos(FstrEspecieSelecionada,'NF_IF_') > 0) Then
            Begin
              LStatus := fStatusNFe(FstrEspecieSelecionada, LObjInformacaoDocumentoAbastecimentoDeposito.Tip_FC, LDifChvAcesso);
              If (LStatus <> '') And (LStatus <> 'AT') And (LStatus <> 'DN') And (LStatus <> 'CN') Then
                chkInutilizacao.Checked := True;
            End;
            pCancelarDocumentos(pgbProgresso);
          End;

          FblnAbastecimentoPeloDeposito := False;
          blnLiberouProtocoloComSenha := False;
        End;
      Finally
        pSetaEmpresaLogada(LCodEmpBkp);
        chkInutilizacao.Checked := LInutilizacaoBkp;
      End;
    End;

    If (Pos(FstrEspecieSelecionada,'NF_') > 0) And
        FEhNotaEspecialFator And
        FblnCancelamentoComSucesso Then
    Begin
      pCancelarDocumentoFator(pgbProgresso);
    End;

    Result := True;

  Except

    On E: ExceptionAutCom Do
    Begin
      Result := False;

      If (Not fSuportaInterfaceGrafica) Then
        Raise;

      pMensagemOk(E.Message);
    End;

    On E: Exception Do
    Begin
      Result := False;

      If (Not fSuportaInterfaceGrafica) Then
        Raise;

      pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fCancelarDocumentos]');
    End;
  End;

end;

procedure TfrmCancelamentoDocumentos.pCancelarDocumentoFator(pgbProgresso: TcxProgressBar);
begin
  If fEmptyStr(FDocOrigem.strNumDoc) Then
    Exit;

  If Not FEhNotaEspecialFator Then
    Exit;

  edtNumDoc.Text                            := FDocOrigem.strNumDoc;
  edtCliFor.Text                            := FDocOrigem.strCliDoc;
  edtSerie.Text                             := EmptyStr;
  blnLiberouProtocoloComSenha               := True;
  lsbEspecies.ItemIndex                     := intIndiceFF;
  strNumDocCanc                             := FDocOrigem.strNumDoc;
  lsbEspeciesDblClick(Nil);
  pCancelarDocumentos(pgbProgresso);
end;

procedure TfrmCancelamentoDocumentos.pAjustaEstoqueProdAcabado(arrProdAcabado: TArrayProdAcabadoCanc; blnSomar : Boolean = True);
  Var
    qryUpd: TUniQuery;
    intContador: Integer;
begin

  If (Length(arrProdAcabado) <= 0) Then
    Exit;

  qryUpd := fCriaQuery(Nil);

  qryUpd.SQL.Add('UPDATE ');
  qryUpd.SQL.Add('  ACAGER ');
  qryUpd.SQL.Add('SET ');
  qryUpd.SQL.Add('  ACA_SALDOS = ACA_SALDOS ' + IIF(blnSomar, '+', '-') + ' :SALDOS ');
  qryUpd.SQL.Add('WHERE ');
  qryUpd.SQL.Add('  ACA_CODACA = :CODACA AND ');
  qryUpd.SQL.Add('  ACA_CODEMP = :CODEMP AND ');
  qryUpd.SQL.Add('  ACA_EMPEST = :EMPEST ');

  For intContador := Low(arrProdAcabado) To High(arrProdAcabado) Do
  Begin
    qryUpd.Close;
    qryUpd.ParamByName('CODACA').AsString := arrProdAcabado[intContador].strCodAca;
    qryUpd.ParamByName('CODEMP').AsString := arrProdAcabado[intContador].strEmpAca;
    qryUpd.ParamByName('EMPEST').AsString := arrProdAcabado[intContador].strEmpEst;
    qryUpd.ParamByName('SALDOS').AsFloat  := arrProdAcabado[intContador].fltQtdIte;

    qryUpd.ExecSQL;
  End;

  FreeAndNil(qryUpd);

end;

