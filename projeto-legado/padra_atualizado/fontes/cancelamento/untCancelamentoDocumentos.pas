function TfrmCancelamentoDocumentos.fVerificaDocumentoEhBaixaDeRefugo(strNumDocSelRef, strCliForSelRef, strSerFscRef : String): Boolean;
  Var
    qryMovGau : TUniQuery;
Begin
  qryMovGau := fCriaQuery();
  Try
    With qryMovGau, SQL Do
    Begin
      Close;
      Clear;
      Add('    SELECT DISTINCT                                      ');
      Add('           GAU_SEQGAD                                    ');
      Add('  FROM MOVGER                                            ');
      Add('     INNER JOIN MOVGAU ON GAU_AIBXRF = MOVGER.AUTOINCREM ');
      Add('     INNER JOIN MOVDET ON MOVDET.AUTOINCREM = GAU_SEQDET ');
      Add(' WHERE GER_NUMDOC = :NUMDOC                              ');
      Add('   AND GER_ESPDOC = :ESPDOC                              ');
      Add('   AND GER_TIP_FC = :TIP_FC                              ');
      Add('   AND GER_CODCLI = :CODCLI                              ');
      Add('   AND GER_SERIE_ = :SERIE_                              ');
      Add('   AND GER_CODEMP = :CODEMP                              ');

      ParamByName('NUMDOC').AsString := strNumDocSelRef;
      ParamByName('ESPDOC').AsString := 'NF';
      ParamByName('TIP_FC').AsString := 'C';
      ParamByName('CODCLI').AsString := strCliForSelRef;
      ParamByName('SERIE_').AsString := strSerFscRef;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      Open;

      Result := not IsEmpty;
    End;

  Finally
    FreeAndNil(qryMovGau);
  End;

End;

function TfrmCancelamentoDocumentos.fVerificaDocumentoEntrega(strEspSel,
  strNumDoc, strCliFor: String): Boolean;
var
  qryEntrega: TUniQuery;
begin
  Result := False;
  qryEntrega := fCriaQuery;

  try
    qryEntrega.Close;
    qryEntrega.SQL.Clear;
    qryEntrega.SQL.Add('SELECT MOT.MOT_CODMOT, MOT.MOT_NOMMOT');
    qryEntrega.SQL.Add('FROM CADMOT MOT');
    qryEntrega.SQL.Add('INNER JOIN COMENG ENG');
    qryEntrega.SQL.Add('ON(MOT.MOT_CODMOT = ENG.ENG_CODENT)');
    qryEntrega.SQL.Add('INNER JOIN COMEND EN');
    qryEntrega.SQL.Add('ON(EN.END_SEQENG = ENG.AUTOINCREM)');
    qryEntrega.SQL.Add('WHERE END_NUMDOC = :NUMDOC');
    qryEntrega.SQL.Add('AND END_ESPDOC = :ESPDOC');
    qryEntrega.SQL.Add('AND END_EMPDOC = :EMPDOC');
    qryEntrega.SQL.Add('AND END_CODCLI = :CODCLI');
    qryEntrega.SQL.Add('AND END_DTABAI IS NULL');
    qryEntrega.SQL.Add('AND END_HRABAI IS NULL');
    qryEntrega.ParamByName('NUMDOC').AsString := strNumDoc;
    qryEntrega.ParamByName('ESPDOC').AsString := strEspSel;
    qryEntrega.ParamByName('EMPDOC').AsString := VS_strCodEmp;
    qryEntrega.ParamByName('CODCLI').AsString := strCliFor;
    qryEntrega.Open;

    if qryEntrega.IsEmpty then
      Exit;

    Result := True;
    fMensagemCancelamento('', 'O documento: ' + strNumDoc + '-' + strEspSel + ' está pendente de entrega com o motorista: ' +
                  qryEntrega.FieldByName('MOT_CODMOT').AsString + '-' + qryEntrega.FieldByName('MOT_NOMMOT').AsString + ' e não poderá ser cancelado!' + sLineBreak +
                  'Acesse a rotina de controle de entregadores e remova o documento para prosseguir o cancelamento.', ['&Ok']);
  finally
    FreeAndNil(qryEntrega);
  end;
end;

Function TfrmCancelamentoDocumentos.fAdCancelamentoJaExiste:Boolean;
  Var
    qryProCrm : TUniQuery;
Begin
  Try
    qryProCrm := fCriaQuery();
    With qryProCrm, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT PRO_NUMPRO          ');
      Add(' FROM PROCRM                ');
      Add(' WHERE PRO_NUMDOC = :NUMDOC ');
      Add('   AND PRO_SERIE_ = :SERIE_ ');
      Add('   AND PRO_CLIFOR = :CLIFOR ');
      Add('   AND PRO_TIP_FC = :TIP_FC ');
      Add('   AND PRO_CODTOC = :CODTOC ');
      Add('   AND PRO_OPEBAI IS NULL   ');

      ParamByName('NUMDOC').AsString := edtNumDoc.Text;
      ParamByName('SERIE_').AsString := edtSerie.Text;
      ParamByName('CLIFOR').AsString := edtCliFor.Text;
      ParamByName('TIP_FC').AsString := strTipFc[1];
      ParamByName('CODTOC').AsString := fCfgSis('VENCAN', varString);

      Open;

      Result := not IsEmpty;

      If Result Then
        fMensagemCancelamento('', 'O Documento Selecionado já foi autorizado com o Seguinte Número de Protocolo ' + FieldByName('PRO_NUMPRO').AsString + #13 +
                      'Não é possível autorizar o mesmo documento mais de uma vez!', ['&Ok']);

    End;
  Finally
    FreeAndNil(qryProCrm);
  End;

End;

function TfrmCancelamentoDocumentos.fAjustaEstoqueSaldoExterno(strNumDoc, strEspDoc, strTip_FC, strCliFor, strCodEmp, strSerie: string): Boolean;
  var
    MovimentacaoEstoque : TMovimentacaoEstoque;
begin

  MovimentacaoEstoque := TMovimentacaoEstoque.New;

  Try

    MovimentacaoEstoque.EhAjusteDeEstoque(SameText(fGetEspSel, 'AJ'));
    MovimentacaoEstoque.EhCancelamento(True);
    MovimentacaoEstoque.NumeroDoDocumento(strNumDoc);
    MovimentacaoEstoque.EspecieDoDocumento(strEspDoc);
    MovimentacaoEstoque.EmpresaDoDocumento(strCodEmp);
    MovimentacaoEstoque.ClienteDoDocumento(strCliFor);
    MovimentacaoEstoque.SerieDoDocumento(strSerie);
    MovimentacaoEstoque.TipoClienteDocumento(strTip_FC);

    Result := MovimentacaoEstoque.ExecutarMovimentacoes;

  Finally
    FreeAndNil(MovimentacaoEstoque);
  End;

end;

procedure TfrmCancelamentoDocumentos.pAdicionarAuditoriaFaturamento(
  const strEspSel, strTabela, strAutInc: String);
begin
  If Not MatchStr(strEspSel, ['OR','PD','FF','NF','IF']) Then
    Exit;

  If Not MatchStr(strTabela, ['DEL_FATGOR','DEL_MOVGER','DEL_NOTGER']) Then
    Exit;

  If fEmptyStr(strAutInc) Then
    Exit;

  FAuditFaturamento.Adicionar(strAutInc, strTabela);
end;

procedure TfrmCancelamentoDocumentos.pRemoveRegistroContabilidade(AstrNumDoc, AstrCliFor, AstrTip_FC, AstrEspSel,
  AstrSerie, AstrCodEmp, AStrClafis, strAutInc_CadFis: String);
  var
    RegistroContabilidade: TrecRegistroContabilidade;
    qryConsulta: TUniQuery;
    strAutIncUti: string;
Begin
  If Not((fCfgsis('UTICON', varBoolean) and fCfgSis('CONONL', varBoolean))) Then
    Exit;

  If (Pos(copy(AStrClafis, 2, 3), '_933_253_303_602_605')) > 0 Then
  Begin
    RegistroContabilidade.ttpTabela := ttCadFis;
    strAutIncUti := strAutInc_CadFis;
  End
  Else
  Begin
    qryConsulta := fCriaQuery;
    Try
      qryConsulta.SQL.Add('SELECT AUTOINCREM FROM NOTGER');
      qryConsulta.SQL.Add(' WHERE GER_NUMDOC = :NUMDOC');
      qryConsulta.SQL.Add('   AND GER_ESPDOC = :ESPDOC');
      qryConsulta.SQL.Add('   AND IFNULL(GER_SERIE_, "") = :SERIE_');
      qryConsulta.SQL.Add('   AND GER_TIP_FC = :TIP_FC');
      If AstrTip_FC = 'F' Then
        qryConsulta.SQL.Add('   AND GER_CODFOR = :FORCLI')
      Else
        qryConsulta.SQL.Add('   AND GER_CODCLI = :FORCLI');
      qryConsulta.SQL.Add('   AND GER_CODEMP = :CODEMP');

      qryConsulta.ParamByName('NUMDOC').AsString := AstrNumDoc;
      qryConsulta.ParamByName('ESPDOC').AsString := AstrEspSel;
      qryConsulta.ParamByName('SERIE_').AsString := AstrSerie;
      qryConsulta.ParamByName('TIP_FC').AsString := AstrTip_FC;
      qryConsulta.ParamByName('FORCLI').AsString := AstrCliFor;
      qryConsulta.ParamByName('CODEMP').AsString := AstrCodEmp;

      qryConsulta.Open;

      If qryConsulta.IsEmpty Then
      Begin
        qryConsulta.SQL.Text := AnsiReplaceStr(qryConsulta.SQL.Text, 'NOTGER', 'MOVGER');
        qryConsulta.ParamByName('NUMDOC').AsString := AstrNumDoc;
        qryConsulta.ParamByName('ESPDOC').AsString := AstrEspSel;
        qryConsulta.ParamByName('SERIE_').AsString := AstrSerie;
        qryConsulta.ParamByName('TIP_FC').AsString := AstrTip_FC;
        qryConsulta.ParamByName('FORCLI').AsString := AstrCliFor;
        qryConsulta.ParamByName('CODEMP').AsString := AstrCodEmp;
        qryConsulta.Open;
        If qryConsulta.IsEmpty Then
          Exit;
        RegistroContabilidade.ttpTabela := ttMovger;
      End
      Else
        RegistroContabilidade.ttpTabela := ttNotGer;

       strAutIncUti := qryConsulta.FieldByName('AUTOINCREM').AsString;
    Finally
      FreeAndNil(qryConsulta);
    End;
  End;

  RegistroContabilidade.strClafis := AStrClafis;
  RegistroContabilidade.strEspDoc := AstrEspSel;
  RegistroContabilidade.strSeqGer := strAutIncUti;
  RegistroContabilidade.mlModLan :=  mlCancelamento;
  RegistroContabilidade.strEmpLan := AstrCodEmp;
  pGravaRegistroContabilidade(RegistroContabilidade);
end;

procedure TfrmCancelamentoDocumentos.pRestauraFDO_RESERV(strAutInc: String);
var qryRest: TUniQuery;
begin
  qryRest := fCriaQuery;
