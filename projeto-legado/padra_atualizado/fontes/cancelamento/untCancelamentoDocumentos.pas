class procedure TfrmCancelamentoDocumentos.pCancelaNotaEntrada(strAutoincremGERELE : String);
  Var
    frmCancelamentoDocumentos : TfrmCancelamentoDocumentos;
    qryGERELE : TUniquery;
begin
  qryGERELE := fCriaQuery(nil);
  try
    qryGERELE.SQL.Add('SELECT                     ');
    qryGERELE.SQL.Add('  GER_DOCENT,              ');
    qryGERELE.SQL.Add('  GER_ESPENT,              ');
    qryGERELE.SQL.Add('  GER_CODFOR,              ');
    qryGERELE.SQL.Add('  B07_SERIE                ');
    qryGERELE.SQL.Add('FROM                       ');
    qryGERELE.SQL.Add('  GERELE                   ');
    qryGERELE.SQL.Add('WHERE                      ');
    qryGERELE.SQL.Add('  AUTOINCREM = :AUTOINCREM ');

    qryGERELE.ParamByName('AUTOINCREM').AsString := strAutoincremGERELE;

    qryGERELE.Open;

    if qryGERELE.isEmpty then
    begin
      pMensagemOK('Nota não encontrada');
      exit;
    end;

    pCriarFormularios(TfrmCancelamentoDocumentos, frmCancelamentoDocumentos);
    Try
      frmCancelamentoDocumentos.edtNumDoc.Text  := qryGERELE.FieldByName('GER_DOCENT').asString;
      frmCancelamentoDocumentos.edtCliFor.Text  := qryGERELE.FieldByName('GER_CODFOR').asString;
      frmCancelamentoDocumentos.edtSerie.Text   := qryGERELE.FieldByName('B07_SERIE').asString;
      frmCancelamentoDocumentos.strNumDocCanc   := qryGERELE.FieldByName('GER_DOCENT').asString;;
      frmCancelamentoDocumentos.edtDesCri.Text  := fRetNomFornecedor(qryGERELE.FieldByName('GER_CODFOR').asString);

      frmCancelamentoDocumentos.edtNumDoc.Enabled   := False;
      frmCancelamentoDocumentos.edtCliFor.Enabled   := False;

      frmCancelamentoDocumentos.edtSerie.Enabled    := False;
      frmCancelamentoDocumentos.btnCancelar.Enabled := False;
      frmCancelamentoDocumentos.lsbEspecies.Enabled := False;
      frmCancelamentoDocumentos.blnPassouDocumento  := True;

      frmCancelamentoDocumentos.ShowModal;

      qryGERELE.Close;
    Finally
      pFreeAndNil(frmCancelamentoDocumentos);
    End;
  finally
    FreeAndNil(qryGERELE);
  end;
end;

function TfrmCancelamentoDocumentos.fValidaSaldoNegativoAposCancelamento(strNumDoc, strEspDoc, strCliFor, strSerie: string; AstrEspSel: String = ''): Boolean;
  var
    qryConsulta: TUniQuery;
    fltSalDis: Double;
    objTabela   : TRegistroMsgLiberaTabela;
    objLinha    : TLinhaMsgLibera;

  function fFicaSaldoDispoNivelNegativo(): boolean;
  Begin
    fltSalDis :=  fRetornaSaldoDisponivel(qryConsulta.FieldByName('CODITE').AsString,
                                           False, True, qryConsulta.FieldByName('NUMLOT').AsString);
    fFicaSaldoDispoNivelNegativo := (fltSalDis - qryConsulta.FieldByName('QTDITE').AsFloat) < 0;
  End;

begin
  qryConsulta := fCriaQuery(Nil);
  Try
    qryConsulta.SQL.Add('SELECT MOVDET.DET_CODEMP AS CODEMP,');
    qryConsulta.SQL.Add('       MOVDET.DET_TIP_FC AS TIP_FC,');
    qryConsulta.SQL.Add('       MOVDET.DET_CODITE AS CODITE,');
    qryConsulta.SQL.Add('       MOVDET.DET_DESCRI AS DESITE,');
    qryConsulta.SQL.Add('       CADUNI.UNI_SIGUNI AS SIGUNI,');
    qryConsulta.SQL.Add('       MOVDET.DET_CODFOR AS CODFOR,');
    qryConsulta.SQL.Add('       MOVDET.DET_CODCLI AS CODCLI,');
    qryConsulta.SQL.Add('       CADLOT.LOT_NUMLOT AS NUMLOT,');
    qryConsulta.SQL.Add('       MOVDET.DET_QTDITE AS QTDITE,');
    qryConsulta.SQL.Add('       IF(IFNULL(LOT_NUMLOT, "") <> "", LOT_SALDOS, ITE_SALDOS) - MOVDET.DET_QTDITE + IF(IFNULL(TD.DET_NUMLOT, "") = "", 0, SUM(TD.DET_QTDITE)) AS SALDOS');
    qryConsulta.SQL.Add('  FROM MOVDET');
    qryConsulta.SQL.Add(' INNER JOIN ITEGER ON ITEGER.ITE_CODITE = MOVDET.DET_CODITE AND ITEGER.ITE_CODEMP = MOVDET.DET_CODEMP');
    qryConsulta.SQL.Add(' INNER JOIN CADUNI ON CADUNI.UNI_CODUNI = MOVDET.DET_UNIDAD');

    qryConsulta.SQL.Add('  LEFT JOIN AUXMOV ON AUX_SEQDOR = MOVDET.DET_SEQGER');
    qryConsulta.SQL.Add('  LEFT JOIN MOVGER TA ON TA.AUTOINCREM = AUX_SEQGER');
    qryConsulta.SQL.Add('  LEFT JOIN MOVDET TD ON TD.DET_SEQGER = TA.AUTOINCREM AND TD.DET_CODITE = MOVDET.DET_CODITE AND TD.DET_NUMLOT = MOVDET.DET_NUMLOT');

    qryConsulta.SQL.Add('  LEFT JOIN CADLOT ON CADLOT.LOT_NUMLOT = MOVDET.DET_NUMLOT AND CADLOT.LOT_CODITE = MOVDET.DET_CODITE AND CADLOT.LOT_CODEMP = MOVDET.DET_CODEMP');
    qryConsulta.SQL.Add(' WHERE MOVDET.DET_NUMDOC = :NUMDOC');
    qryConsulta.SQL.Add('   AND MOVDET.DET_ESPDOC = :ESPDOC');
    qryConsulta.SQL.Add('   AND IFNULL(MOVDET.DET_SERIE_, "") = :SERIE_');
    If AstrEspSel = 'NE'  Then
    Begin
      qryConsulta.SQL.Add('   AND MOVDET.DET_CODFOR = :CODFOR');
      // conferência depois da entrada, retira o documento que ainda não foi efetivado, pois ainda não movimentou o saldo.
      If fConferenciaDepoisDaEntrada Then
        qryConsulta.SQL.Add('   AND IFNULL(MOVDET.DET_DTAENT,"") <> "" ');
    End
    Else
      qryConsulta.SQL.Add('   AND IF(MOVDET.DET_TIP_FC = "F", MOVDET.DET_CODFOR, MOVDET.DET_CODCLI) = :CODFOR');

    If fCfgSis('BXSBIT') <> '1' Then
      qryConsulta.SQL.Add('   AND IFNULL(MOVDET.DET_ORDPRO,"") = ""');

    qryConsulta.SQL.Add('       HAVING SALDOS < 0 ');

    If fCfgSis('BXSBIT') <> '1' Then
    Begin
      qryConsulta.SQL.Add(' UNION ALL ');

      qryConsulta.SQL.Add('SELECT MOVDET.DET_CODEMP AS CODEMP,');
      qryConsulta.SQL.Add('       MOVDET.DET_TIP_FC AS TIP_FC,');
      qryConsulta.SQL.Add('       SUB.DET_CODITE AS CODITE,');
      qryConsulta.SQL.Add('       SUB.DET_DESCRI AS DESITE,');
      qryConsulta.SQL.Add('       CADUNI.UNI_SIGUNI AS SIGUNI,');
      qryConsulta.SQL.Add('       MOVDET.DET_CODFOR AS CODFOR,');
      qryConsulta.SQL.Add('       MOVDET.DET_CODCLI AS CODCLI,');
      qryConsulta.SQL.Add('       CADLOT.LOT_NUMLOT AS NUMLOT,');
      qryConsulta.SQL.Add('       SUB.DET_QTDITE AS QTDITE,');
      qryConsulta.SQL.Add('       IF(IFNULL(LOT_NUMLOT, "") <> "", LOT_SALDOS, ITE_SALDOS) - SUB.DET_QTDITE + IF(IFNULL(TD.DET_NUMLOT, "") = "", 0, SUM(TD.DET_QTDITE)) AS SALDOS');
      qryConsulta.SQL.Add('  FROM MOVDET');
      qryConsulta.SQL.Add('  LEFT JOIN AUXMOV ON AUX_SEQDOR = MOVDET.DET_SEQGER');
      qryConsulta.SQL.Add('  LEFT JOIN MOVGER TA ON TA.AUTOINCREM = AUX_SEQGER');
      qryConsulta.SQL.Add('  LEFT JOIN MOVDET TD ON TD.DET_SEQGER = TA.AUTOINCREM AND TD.DET_CODITE = MOVDET.DET_CODITE AND TD.DET_NUMLOT = MOVDET.DET_NUMLOT');

      qryConsulta.SQL.Add(' INNER JOIN MOVDET SUB ON SUB.DET_ORDPRO = MOVDET.DET_ORDPRO');
      qryConsulta.SQL.Add('                      AND IF(MOVDET.DET_TIP_FC = "F", SUB.DET_CODFOR = MOVDET.DET_CODFOR, SUB.DET_CODCLI = MOVDET.DET_CODCLI)');
      qryConsulta.SQL.Add('                      AND SUB.DET_TIP_FC = MOVDET.DET_TIP_FC');
      qryConsulta.SQL.Add('                      AND SUB.DET_ESPDOC = "OP"');
      qryConsulta.SQL.Add(' INNER JOIN ITEGER ON ITEGER.ITE_CODITE = SUB.DET_CODITE AND ITEGER.ITE_CODEMP = SUB.DET_CODEMP');
      qryConsulta.SQL.Add('  LEFT JOIN CADUNI ON CADUNI.UNI_CODUNI = SUB.DET_UNIDAD');
      qryConsulta.SQL.Add('  LEFT JOIN CADLOT ON CADLOT.LOT_NUMLOT = SUB.DET_NUMLOT AND CADLOT.LOT_CODITE = SUB.DET_CODITE AND CADLOT.LOT_CODEMP = SUB.DET_CODEMP');

      qryConsulta.SQL.Add(' WHERE MOVDET.DET_NUMDOC = :NUMDOC');
      qryConsulta.SQL.Add('   AND MOVDET.DET_ESPDOC = :ESPDOC');
      qryConsulta.SQL.Add('   AND IFNULL(MOVDET.DET_SERIE_, "") = :SERIE_');
      If AstrEspSel = 'NE'  Then
      Begin
        qryConsulta.SQL.Add('   AND MOVDET.DET_CODFOR = :CODFOR');
        // conferência depois da entrada, retira o documento que ainda não foi efetivado, pois ainda não movimentou o saldo.
        If fConferenciaDepoisDaEntrada Then
          qryConsulta.SQL.Add('   AND IFNULL(MOVDET.DET_DTAENT,"") <> "" ');
      End
      Else
        qryConsulta.SQL.Add('   AND IF(MOVDET.DET_TIP_FC = "F", MOVDET.DET_CODFOR, MOVDET.DET_CODCLI) = :CODFOR');
      qryConsulta.SQL.Add('   AND IFNULL(MOVDET.DET_ORDPRO,"") <> ""');
      qryConsulta.SQL.Add('       HAVING SALDOS < 0 ');
    End;

    qryConsulta.ParamByName('NUMDOC').Value := strNumDoc;
    qryConsulta.ParamByName('ESPDOC').Value := strEspDoc;
    qryConsulta.ParamByName('SERIE_').Value := strSerie;
    qryConsulta.ParamByName('CODFOR').Value := strCliFor;
    qryConsulta.Open;
    Result := QryConsulta.IsEmpty;
    // Se vier vazio é porque não esta negativo então não será necessario pedir senha
    If Result Then
      exit;

    {Monta Titulo Da PedeSenha}
    objLiberacao.Clear;
    objLiberacao.strDirAce    := 'CANSAL';
    objLiberacao.strCodOpe    := strLoginUsuarioLogado;
    objLiberacao.strCodDig    := strLoginUsuarioLogado;
    objLiberacao.pInformaNumDocEspDocCodEmp(strNumDoc, strEspDoc, VS_strCodEmp);

    objLiberacao.objMsgLibera.pAddTexto('Ao cancelar o documento de entrada abaixo, os produtos listados ficarão com saldo de estoque negativo.');
    objLiberacao.objMsgLibera.pAddTexto('Para completar a operação será necessário senha de liberação.');
    objLiberacao.objMsgLibera.pAddQuebra;
    objLiberacao.objMsgLibera.pAddTextoCaption('Documento', strNumDoc + ' Série: ' + strSerie + ' Espécie: ' + strEspDoc, 10);

    If qryConsulta.FieldByName('TIP_FC').AsString = 'F' Then
      objLiberacao.objMsgLibera.pAddTextoCaption('Fornecedor', qryConsulta.FieldByName('CODFOR').AsString + ' - ' + fRetNomFornecedor(qryConsulta.FieldByName('CODFOR').AsString), 10)
    Else
      objLiberacao.objMsgLibera.pAddTextoCaption('Cliente', qryConsulta.FieldByName('CODCLI').AsString + ' - ' + fRetNomCliente(qryConsulta.FieldByName('CODCLI').AsString), 10);

    objLiberacao.objMsgLibera.pAddTextoCaption('Empresa', qryConsulta.FieldByName('CODEMP').AsString + ' - ' +  fRetNomeEmpresa(qryConsulta.FieldByName('CODEMP').AsString), 10);


    objTabela := TRegistroMsgLiberaTabela.Create;

    objLinha  := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlCabecalho;
    objLinha.pAddColuna('', 'COD.'       , fTamCodIte  , alEsquerda, teAutcom);
    objLinha.pAddColuna('', 'DESCRIÇÃO'  , 45 , alEsquerda, teAutcom);
    objLinha.pAddColuna('', 'UN'         , 3  , alEsquerda, teAutcom);
    objLinha.pAddColuna('', 'LOTE'       , 14 , alEsquerda, teAutcom);
    objLinha.pAddColuna('', 'QUANTIDADE' , 15 , alEsquerda, teAutcom);
    objLinha.pAddColuna('', 'SALDO ATUAL', 15 , alEsquerda, teAutcom);
    objTabela.lstLinhas.Add(objLinha);

    While Not qryConsulta.Eof Do
    Begin
      If fFicaSaldoDispoNivelNegativo Then
      Begin

        objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.pAddColuna('COD.'       , qryConsulta.FieldbyName('CODITE').AsString                      , fTamCodIte );
        objLinha.pAddColuna('DESCRIÇÃO'  , qryConsulta.FieldbyName('DESITE').AsString                      , 45);
        objLinha.pAddColuna('UN'         , qryConsulta.FieldbyName('SIGUNI').AsString                      , 3 );
        objLinha.pAddColuna('LOTE'       , qryConsulta.FieldbyName('NUMLOT').AsString                      , 14);
        objLinha.pAddColuna('QUANTIDADE' , FormatFloat('#0.000', qryConsulta.FieldbyName('QTDITE').AsFloat), 15);
        objLinha.pAddColuna('SALDO ATUAL', FormatFloat('#0.000', fltSalDis)                                , 15);
        objTabela.lstLinhas.Add(objLinha);

      end;
      qryConsulta.Next;
    End;

    If not objTabela.isEmpty then
    begin
      objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);
      Result := objLiberacao.fLibera;
    end
    Else
      Result := True;

  Finally
    objLiberacao.Clear;
    FreeAndnil(qryConsulta);
  End;

end;

function TfrmCancelamentoDocumentos.fDeletaAgendaDeRecebimento(const AEspSel: string): Boolean;
  Var
    qryAgeDoc : TUniQuery;
    strSeqGer : String;
    objGerenciaAgendamento: TGerenciaAgendamentoRecebimento;
Begin
  Try
    qryAgeDoc := fCriaQuery;
    Result := True;
    With qryAgeDoc, SQL Do
    Begin
      Close;
      Clear;

      Add(' SELECT *                   ');
      Add(' FROM AGEDOC                ');
      Add(' WHERE ADC_CODEMP = :CODEMP ');
      Add('   AND ADC_CODFOR = :CODFOR ');
      Add('   AND ADC_ESPDOC = :ESPDOC ');
      Add('   AND ADC_NUMDOC = :NUMDOC ');
      Add('   AND ADC_SERIE_ = :SERIE_ ');

      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODFOR').AsString := edtCliFor.Text;
      ParamByName('ESPDOC').AsString := IfThen(blnPedidoEntrada, 'PD', 'NF');
      ParamByName('NUMDOC').AsString := edtNumDoc.Text;
      ParamByName('SERIE_').AsString := edtSerie.Text;

      Open;

      If qryAgeDoc.IsEmpty Then
        Exit;

      strSeqGer := FieldByName('ADC_SEQGER').AsString;
      fVerificaIntegridade(Self.Name, 'AGEDOC', qryAgeDoc, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

      qryAgeDoc.Delete;

      objGerenciaAgendamento := TGerenciaAgendamentoRecebimento.Create(strSeqGer,
                                                                       edtNumDoc.Text,
                                                                       edtCliFor.Text,
                                                                       edtSerie.Text,
                                                                       IfThen(blnPedidoEntrada, 'PD', 'NF'),
                                                                       fOperadorDoCancelamento,
                                                                       Self.Name,
                                                                       fMotivoDelecao,
                                                                       fGetEspSel);
      Result := objGerenciaAgendamento.fProcessar;

      Result := Result And fCancelaBaixaNotaEletronica('NF', edtNumDoc.Text, edtCliFor.Text, edtSerie.Text);

      Result := Result And fCancelaConferenciaNotaEletronica(strIdeDigPlano);

      If (Pos(AEspSel,'NE') > 0) And (Pos(edtCliFor.Text, fRetForFilialTodos) > 0) Then
      Begin
        Close;
        Clear;
        Add('DELETE FROM GERELE ');
        Add(' WHERE B08_NNF = :NUMDOC ');
        Add('   AND GER_CODFOR = :CODFOR ');
        Add('   AND GER_CODEMP = :CODEMP ');
        Add('   AND GER_ENTSIM = "S" ');
        Add('   AND IFNULL(B07_SERIE,"") = :SERIE_  ');

        ParamByName('NUMDOC').AsString := edtNumDoc.Text;
        ParamByName('CODFOR').AsString := edtCliFor.Text;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        ParamByName('SERIE_').AsString := edtSerie.Text;

        qryAgeDoc.ExecSQL;
      End;


    End;
  Finally
    FreeAndNil(qryAgeDoc);
    If Assigned(objGerenciaAgendamento) Then
      FreeAndNil(objGerenciaAgendamento);
  End;

End;

procedure TfrmCancelamentoDocumentos.pCancelaItensPedidoAgrupamento(strNumFat, strTipFat, strEmpFat: String);
Var
  strSQL   : String;
  qryPedOri: TUniQuery;
  qryUpdate: TUniQuery;

  strCodIte,
  strNumDoc,
  strEspDoc,
  strCodEmp: String;

  fltQtdite,
  fltDesBai: Double;
  intSeqInd: Integer;
Begin

  qryPedOri := fCriaQuery(Self);
  qryUpdate := fCriaQuery(Self);
  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT FDO_NUMDOC, ';
    strSQL := strSQL + '       FDO_ESPDOC, ';
    strSQL := strSQL + '       FDO_CODEMP, ';
    strSQL := strSQL + '       FDO_CODITE, ';
    strSQL := strSQL + '       FDO_SEQIND, ';
    strSQL := strSQL + '       FDO_QTDITE, ';
    strSQL := strSQL + '       FDO_DESBAI  ';
    strSQL := strSQL + 'FROM FATDOR ';
    strSQL := strSQL + 'WHERE FDO_NUMFAT = :NUMFAT ';
    strSQL := strSQL + '  AND FDO_TIPFAT = :TIPFAT ';
    strSQL := strSQL + '  AND FDO_EMPFAT = :EMPFAT ';

    With qryPedOri Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMFAT').AsString := strNumFat;
      ParamByName('TIPFAT').AsString := strTipFat;
      ParamByName('EMPFAT').AsString := strEmpFat;
      Open;
    End;

    While Not qryPedOri.Eof Do
    Begin
      fltQtdIte := qryPedOri.FieldByName('FDO_QTDITE').AsFloat;
      fltDesBai := qryPedOri.FieldByName('FDO_DESBAI').AsFloat;

      strNumDoc := qryPedOri.FieldByName('FDO_NUMDOC').AsString;
      strEspDoc := qryPedOri.FieldByName('FDO_ESPDOC').AsString;
      strCodEmp := qryPedOri.FieldByName('FDO_CODEMP').AsString;
      intSeqInd := qryPedOri.FieldByName('FDO_SEQIND').AsInteger;
      strCodIte := qryPedOri.FieldByName('FDO_CODITE').AsString;

        strSQL := '';
        strSQL := strSQL + 'UPDATE ';
        strSQL := strSQL + '  FATDOR ';
        strSQL := strSQL + 'SET ';
        strSQL := strSQL + '  FDO_QTDBAI = IF(FDO_QTDBAI <= 0, 0, FDO_QTDBAI - :QTDITE), ';
        strSQL := strSQL + '  FDO_DESBAI = IF(FDO_QTDBAI <= 0, 0, FDO_DESBAI - :DESESP), ';
        strSQL := strSQL + '  FDO_JAFATU = IF(FDO_QTDBAI < FDO_QTDITE, 0, FDO_JAFATU), ';
        strSQL := strSQL + '  FDO_TIPFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_TIPFAT), ';
        strSQL := strSQL + '  FDO_NUMFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_NUMFAT), ';
        strSQL := strSQL + '  FDO_EMPFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_EMPFAT), ';
        strSQL := strSQL + '  FDO_DTAFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_DTAFAT), ';
        strSQL := strSQL + '  FDO_VENFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_VENFAT), ';
        strSQL := strSQL + '  FDO_CNDFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_CNDFAT), ';
        strSQL := strSQL + '  FDO_VALFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_VALFAT) ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  FDO_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  FDO_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  FDO_CODEMP = :CODEMP AND ';
        strSQL := strSQL + '  FDO_CODITE = :CODITE AND ';
        strSQL := strSQL + '  FDO_SEQIND = :SEQIND ';

      qryUpdate.Close;
      qryUpdate.SQL.Clear;
      qryUpdate.SQL.Add(strSQL);
      qryUpdate.ParamByName('QTDITE').AsFloat   := fltQtdIte;
      qryUpdate.ParamByName('DESESP').AsFloat   := fltDesBai;

      qryUpdate.ParamByName('NUMDOC').AsString  := strNumDoc;
      qryUpdate.ParamByName('ESPDOC').AsString  := strEspDoc;
      qryUpdate.ParamByName('CODEMP').AsString  := strCodEmp;
      qryUpdate.ParamByName('SEQIND').AsInteger := intSeqInd;
      qryUpdate.ParamByName('CODITE').AsString  := strCodIte;
      qryUpdate.ExecSQL;

        strSQL := '';
        strSQL := strSQL + 'UPDATE ';
        strSQL := strSQL + '  FATGOR ';
        strSQL := strSQL + 'SET ';
        strSQL := strSQL + '  FGO_JAFATU = 0, ';
        strSQL := strSQL + '  FGO_TIPFAT = NULL, ';
        strSQL := strSQL + '  FGO_NUMFAT = NULL, ';
        strSQL := strSQL + '  FGO_EMPFAT = NULL, ';
        strSQL := strSQL + '  FGO_DTAFAT = NULL, ';
        strSQL := strSQL + '  FGO_VENFAT = NULL, ';
        strSQL := strSQL + '  FGO_CNDFAT = NULL, ';
        strSQL := strSQL + '  FGO_VALFAT = NULL  ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  FGO_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  FGO_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  FGO_CODEMP = :CODEMP ';

      qryUpdate.Close;
      qryUpdate.SQL.Clear;
      qryUpdate.SQL.Add(strSQL);
      qryUpdate.ParamByName('NUMDOC').AsString  := strNumDoc;
      qryUpdate.ParamByName('ESPDOC').AsString  := strEspDoc;
      qryUpdate.ParamByName('CODEMP').AsString  := strCodEmp;
      qryUpdate.ExecSQL;
      qryUpdate.Close;

      pAtualizaStatusPD(strNumDoc, strEspDoc, strCodEmp);
      pAtualizaCancelamentoFaturamentoPedido(strNumDoc, strEspDoc, strCodEmp);

      If VS_strHabilitarCRM Then
      Begin
        pReabrirOcorrenciaPorDocumento(strNumDoc,
                                       strEspDoc,
                                       '',
                                       strCodEmp,
                                       'C');
      End;

      qryPedOri.Next;
      End;
  Finally
    FreeAndNil(qryPedOri);
    FreeAndNil(qryUpdate);
  End;

End;

function TfrmCancelamentoDocumentos.fVerificaSeEhNotaDeDevolucaoPreNotaWMSeVoltaQuantidadesBaixadas(const strIncMovDet: String; var blnWmsGerouPedidoDeEnderecamento: Boolean): Boolean;
  Var
    qryAgeIte : TUniQuery;
    qryExeSQL : TUniQuery;
    objEndere : TEnderecamentoProduto;
    strIncFatGorEnderecamento : String;
    strAutFdo : String;
    strNumDoc : String;
    strCodCli : String;
Begin
  qryAgeIte := fCriaQuery;
  qryExeSQL := fCriaQuery;
  Try
    Try
      Result := True;

      With qryAgeIte, SQL Do
      Begin
        Add(' SELECT DET_CODITE,                             ');
        Add('        DET_QTDITE,                             ');
        Add('        ADC_NUMDOC,                             ');
        Add('        ADC_ESPDOC,                             ');
        Add('        ADC_CODEMP,                             ');
        Add('        ADC_CODFOR,                             ');
        Add('        ADC_SERIE_,                             ');
        Add('        AGEITE.AUTOINCREM AS INC_AGEITE         ');
        Add(' FROM MOVDET                                    ');
        Add('   INNER JOIN AGEDOC ON ADC_NUMDOC = DET_DOCDEV ');
        Add('                    AND ADC_ESPDOC = DET_ESPDEV ');
        Add('                    AND ADC_CODEMP = DET_EMPDEV ');
        Add('                    AND ADC_CODFOR = DET_CODFOR ');
        Add('   INNER JOIN AGEITE ON AIT_SEQGER = ADC_SEQGER ');
        Add('                    AND AIT_CODITE = DET_CODITE ');
        Add('   INNER JOIN AUXMOV ON AUX_SEQGER = DET_SEQGER ');
        Add(' WHERE MOVDET.AUTOINCREM = :AUTINC              ');
        Add('   AND IFNULL(DET_DOCDEV,"") <> ""              ');
        Add('   AND AUX_DEVWMS = "S"                         ');
        Add('   AND IFNULL(AIT_QTDDEV,0) > 0                 ');

        ParamByName('AUTINC').AsString := strIncMovDet;

        Open;

        blnWmsGerouPedidoDeEnderecamento := not IsEmpty;

        If blnWmsGerouPedidoDeEnderecamento Then
        Begin
          qryExeSQL.Close;
          qryExeSQL.SQL.Clear;
          qryExeSQL.SQL.Add(' UPDATE AGEITE SET AIT_QTDDEV = IFNULL(AIT_QTDDEV,0) - :QTDDEV WHERE AUTOINCREM = :AUTINC');
          qryExeSQL.ParamByName('AUTINC').AsString := FieldByName('INC_AGEITE').AsString;
          qryExeSQL.ParamByName('QTDDEV').AsFloat  := FieldByName('DET_QTDITE').AsFloat;
          qryExeSQL.ExecSQL;

          //Verifica Se o Documento de Referencia da Devolução ainda tem Pedido de Endereçamento, se tiver tem que criar ou Editar o que ja existe
          qryExeSQL.Close;
          qryExeSQL.SQL.Clear;
          qryExeSQL.SQL.Add(' SELECT FGO_SEQFGO, FGO_NUMDOC, FGO_CODCLI FROM EXTGOR INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FGO_SEQFGO  ');
          qryExeSQL.SQL.Add(' WHERE FGO_DOCEND = CONCAT(:NUMDOC, :ESPDOC, LEFT(CONCAT(:SERIE_,"   "),3), :CODEMP, :CODFOR, "F") ');

          qryExeSQL.ParamByName('NUMDOC').AsString := FieldByName('ADC_NUMDOC').AsString;
          qryExeSQL.ParamByName('ESPDOC').AsString := FieldByName('ADC_ESPDOC').AsString;
          qryExeSQL.ParamByName('SERIE_').AsString := FieldByName('ADC_SERIE_').AsString;
          qryExeSQL.ParamByName('CODEMP').AsString := FieldByName('ADC_CODEMP').AsString;
          qryExeSQL.ParamByName('CODFOR').AsString := FieldByName('ADC_CODFOR').AsString;
          qryExeSQL.Open;

          if qryExeSQL.IsEmpty Then
          Begin
            objEndere := fRetornaObjEnderecamentoDoc(FieldByName('ADC_ESPDOC').AsString, FieldByName('ADC_NUMDOC').AsString, FieldByName('ADC_CODFOR').AsString, FieldByName('ADC_SERIE_').AsString, 'F');
            objEndere.blnDevWms := True;
            objEndere.pAddItem(FieldByName('DET_CODITE').AsString, 'A DEFINIR', FieldByName('DET_QTDITE').AsFloat);
            objEndere.fGerarPedidoParaReservarEstoque;
          End
          Else
          Begin
            strIncFatGorEnderecamento := qryExeSQL.FieldByName('FGO_SEQFGO').AsString;
            strNumDoc := qryExeSQL.FieldByName('FGO_NUMDOC').AsString;
            strCodCli := qryExeSQL.FieldByName('FGO_CODCLI').AsString;

            qryExeSQL.Close;
            qryExeSQL.SQL.Clear;
            qryExeSQL.SQL.Add(' SELECT * FROM FATDOR       ');
            qryExeSQL.SQL.Add(' WHERE FDO_SEQGER = :SEQGER ');
            qryExeSQL.SQL.Add('   AND FDO_CODITE = :CODITE ');

            qryExeSQL.ParamByName('SEQGER').AsString := strIncFatGorEnderecamento;
            qryExeSQL.ParamByName('CODITE').AsString := FieldByName('DET_CODITE').AsString;

            qryExeSQL.Open;

            //Caso já tenha o item no endereçamento somente soma a quantidade
            If not qryExeSQL.IsEmpty Then
            Begin
              qryExeSQL.Edit;
              qryExeSQL.FieldByName('FDO_QTDITE').AsFloat := qryExeSQL.FieldByName('FDO_QTDITE').AsFloat + FieldByName('DET_QTDITE').AsFloat;
              qryExeSQL.Post;
            End
            //Se nao cria uma fatdor para o item que vai voltar para o estoque do a definir.
            Else
            Begin
              qryExeSQL.Close;
              qryExeSQL.SQL.Clear;
              qryExeSQL.SQL.Add(' SELECT ITE_CODMAR,         ');
              qryExeSQL.SQL.Add('        ITE_DESITE,         ');
              qryExeSQL.SQL.Add('        ITE_REFERE,         ');
              qryExeSQL.SQL.Add('        ITE_CODUNI,         ');
              qryExeSQL.SQL.Add('        ITE_CODFOR          ');
              qryExeSQL.SQL.Add(' FROM CADITE                ');
