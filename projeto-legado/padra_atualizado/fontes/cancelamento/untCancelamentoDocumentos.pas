        pStepBy;

        If (blnResult) And (strEspSel <> 'NW') Then
          blnResult := fCancelaItensFaturado(strEspSel, strNumDocSel,
            IIF(fEmptyStr(strCliFat), strCliForSel, strCliFat));

        pStepBy;

        If (blnResult) And (strEspSel = 'GR')  Then
