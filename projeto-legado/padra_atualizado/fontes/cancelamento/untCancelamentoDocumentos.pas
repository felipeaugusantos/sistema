    If Assigned(objCancTransfPedComMltLj) Then
      FreeAndNil(objCancTransfPedComMltLj);

    objLock.pDestravarTodos;

    If (blnCancelarSATouCFTefAutomatico) or (Not fSuportaInterfaceGrafica) or FblnCancelamentoLocEqu Then
      blnFecharForm := True;

  End;

end;

function TfrmCancelamentoDocumentos.fNEDevolvida(strNumDoc, strSerie_,
  strCodFor: String): Boolean;

  Var
    qryNotEnt : TUniQuery;

  Function fSQLNeDev(strEsp: String): String;
    Var
      strSQL : String;
  Begin
    strSQL :=          ' SELECT DET_NUMDOC,  DET_ESPDOC,  DET_CODEMP,  DET_SERIE_,  DET_CODFOR ';
    strSQL := strSQL + '   FROM MOVDET ';
    strSQL := strSQL + '  WHERE DET_DOCDEV = :DOCDEV               ';
    strSQL := strSQL + '    AND DET_ESPDEV = '+QuotedStr(strEsp)+' ';
    strSQL := strSQL + '    AND DET_EMPDEV = :EMPDEV               ';
    strSQL := strSQL + '    AND DET_CODFOR = :CODFOR               ';
    strSQL := strSQL + '    AND IFNULL(DET_SERIE_, "") = :DEV_SERIE_   ';
    Result := strSQL;
  End;

begin
  qryNotEnt := fCriaQuery(Self);

  With qryNotEnt Do
  Begin
    Close;
    SQL.Clear;

    SQL.Add('SELECT COUNT(1) QTD FROM ( ');
    SQL.Add(fSQLNeDev('NF'));
    SQL.Add(' UNION ALL ');
    SQL.Add(fSQLNeDev('EL'));
    SQL.Add(' UNION ALL ');
    SQL.Add(fSQLNeDev('PD'));
    SQL.Add(' ) AS TABAUX ');
    SQL.Add(' WHERE TRUE ');
    SQL.Add(' AND TABAUX.DET_NUMDOC = :NUMDOC ');
    SQL.Add(' AND TABAUX.DET_CODFOR = :CODFOR ');
    SQL.Add(' AND TABAUX.DET_SERIE_ = :SERIE_ ');
    SQL.Add(' AND TABAUX.DET_ESPDOC = :ESPDOC ');

    ParamByName('DOCDEV').AsString := strNumDoc;
    ParamByName('DEV_SERIE_').AsString := fCfgSis('SERFSC');
    ParamByName('CODFOR').AsString := strCodFor;
    ParamByName('EMPDEV').AsString := VS_strCodEmp;
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('SERIE_').AsString := strSerie_;
    ParamByName('ESPDOC').AsString := IIF(blnPedidoEntrada, 'PD','NF' );
    Open;

    Result := (FieldByName('QTD').AsInteger > 0);
  End;

  Close;
  FreeAndNil(qryNotEnt);
end;

