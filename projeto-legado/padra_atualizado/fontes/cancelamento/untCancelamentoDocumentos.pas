  End;
end;

function TfrmCancelamentoDocumentos.fExisteX929(strNumDoc, strCodCli: String): Boolean;
var
  qryTmp : TUniQuery;
  strSQL : String;
begin
  qryTmp := fCriaQuery;

  Try
    strSQL := 'SELECT COUNT(*) AS QTD FROM MOVDET '+
              'WHERE DET_NUMDOC = :NUMDOC '+
              '  AND DET_ESPDOC = "NF" '+
              '  AND DET_CODEMP = :CODEMP '+
              '  AND DET_CODCLI = :CODCLI '+
              '  AND RIGHT(DET_CLAFIS, 3) = "929" ';

    strSQL := strSQL + 'UNION ALL ' + AnsiReplaceStr(strSQL, 'MOVDET', 'NOTDET');

    qryTmp.SQL.Clear;
    qryTmp.SQL.Add('SELECT ');
    qryTmp.SQL.Add('  SUM(QTD) AS QTD ');
    qryTmp.SQL.Add('FROM ('+strSQL+') AS TMP ');

    qryTmp.ParamByName('NUMDOC').ASString := strNumDoc;
    qryTmp.ParamByName('CODEMP').ASString := VS_StrCodEmp;
    qryTmp.ParamByName('CODCLI').ASString := strCodCli;
    qryTmp.Open;

    Result := (qryTmp.FieldByName('QTD').AsInteger > 0);

  finally
    FreeAndNil(qryTmp);
  end;
end;

function TfrmCancelamentoDocumentos.fEhCancelamentoX929(strNumDoc, strCodCli: String): Boolean;
begin
  Result := False;

  If not fExisteX929(strNumDoc, strCodCli) Then
    Exit;

  Result := True;
end;

