    If (Not DirectoryExists(strPatNfe + '\DataIn\')) Then
      strMsg := strMsg + 'Path de envio de dados não existe (-' + strPatNfe + '\DataIn\' + '-).' + #13#10;

    If (Not DirectoryExists(strPatNfe + '\DataOut\')) Then
      strMsg := strMsg + 'Path de retorno de dados não existe (-' + strPatNfe + '\DataOut\' + '-).' + #13#10;

    If (Not DirectoryExists(strPatNfe + '\BackupCitel\')) Then
      strMsg := strMsg + 'Path de backup de dados não existe (-' + strPatNfe + '\BackupCitel\' + '-).';

    Result := fEmptyStr(strMsg);

