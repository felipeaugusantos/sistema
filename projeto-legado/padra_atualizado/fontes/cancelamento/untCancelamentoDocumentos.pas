procedure TfrmCancelamentoDocumentos.pGravaDeletadoEftGer(const strNumDoc, strEspDoc, strEmpDoc, strCodAca, strEmpAca: string);
var
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Try
    Try
      qryGen := fCriaQuery();
      qryGen.SQL.Text :=
        ' SELECT                       ' +
        '   *                          ' +
        ' FROM                         ' +
        '   EFTGOR                     ' +
        ' WHERE FGO_NUMDOC = :NUMDOC   ' +
        '   AND FGO_ESPDOC = :ESPDOC   ' +
        '   AND FGO_EMPDOC = :EMPDOC   ' +
        '   AND FGO_CODACA = :CODACA   ' +
        '   AND FGO_EMPACA = :EMPACA   ';

      qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
      qryGen.ParamByName('ESPDOC').AsString := strEspDoc;
      qryGen.ParamByName('EMPDOC').AsString := strEmpDoc;
      qryGen.ParamByName('CODACA').AsString := strCodAca;
      qryGen.ParamByName('EMPACA').AsString := strEmpAca;
      qryGen.Open;

      if not qryGen.IsEmpty then
      begin
        fVerificaIntegridade(Self.Name, 'EFTGOR', qryGen, True, False, EmptyStr, fOperadorDoCancelamento);
      end;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

procedure TfrmCancelamentoDocumentos.pGravaDeletadosMadeira(
  strAutoincrem, strTabela: String);
  Var
    qryAux: TUniQuery;
    strIdeCampo : String;
    strTabelaMad: String;
begin
  strTabelaMad := '';
  strIdeCampo  := 'DET';

  If Pos('FATDOR', strTabela) > 0 Then
  Begin
    strTabelaMad := 'ORCMAD';
    strIdeCampo  := 'FDO';
  End

  Else If Pos('MOVDET', strTabela) > 0 Then
    strTabelaMad := AnsiReplaceStr(strTabela, 'MOVDET', 'MOVMAD')

  Else If Pos('NOTDET', strTabela) > 0 Then
    strTabelaMad := AnsiReplaceStr(strTabela, 'NOTDET', 'NOTMAD');

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT * FROM ' + strTabelaMad + ' WHERE ' + strIdeCampo + '_SEQGER = :SEQGER ');
  qryAux.ParamByName('SEQGER').AsString := strAutoincrem;
  qryAux.Open;

  While (Not qryAux.Eof) Do
  Begin
    fVerificaIntegridade(Self.Name, strTabelaMad, qryAux, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

function TfrmCancelamentoDocumentos.fPodeCancelarCupomFiscal(strNumDoc, strSerie,
  strCodCli: String): Boolean;
  Var
    strNumSer: String;
    strNumCoo: String;

    strNumSerEcf: String;
    strNumCooEcf: String;

    qryAux: TUniQuery;
begin
  If blnPDV Then
  Begin
    Result := True;
    Exit;
  End;

  If (fCfgSis('USNFCE', varBoolean)) Or fUsaSat Then
  Begin
    qryAux := fCriaQuery(Nil);
    Try
      With qryAux Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT '+
                '  NFE_NUMDOC '+
                'FROM '+
                '  LOGNFE '+
                'WHERE NFE_NUMDOC = :NUMDOC '+
                '  AND NFE_CODCLI = :CODCLI '+
                '  AND IFNULL(NFE_SERIE_, "") = :SERIE_ '+
                '  AND NFE_ESPDOC = :ESPDOC '+
                '  AND NFE_CODEMP = :CODEMP ');
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('SERIE_').AsString := strSerie;
        ParamByName('ESPDOC').AsString := 'IF';
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        Open;
      End;
      If qryAux.IsEmpty Then
      Begin
        Result := False;
        If fUsaSat Then
          fMensagem('ATENÇÃO!', 'Não é possível cancelar. Documento não é um SAT-CFe.', ['&Ok'])
        Else
          fMensagem('ATENÇÃO!', 'Não é possível cancelar. Documento não é uma NFC-e.', ['&Ok']);
        Exit;
      End
      Else
      Begin
        Result := True;
        Exit;
      End;
    Finally
      FreeAndNil(qryAux);
    End;
  End;

  pRetornaDadosDoCupom(strNumDoc, strSerie, strCodCli, strNumSer, strNumCoo);

  If fEmptyStr(strNumCoo) Then
    Result := True
  Else
  Begin
    Result := True;
    If fEstaConectadoAoEcf Then
    Begin
      strNumSerEcf := fRetornaNumSerEcf;
      strNumCooEcf := fRetornaNumCooEcf;

      If Trim(strNumSer) <> strNumSerEcf Then
      Begin
        Result := False;
        fMensagem('ATENÇÃO!', 'Para cancelar este cupom é necessário estar logado no computador onde está ligado o ECF ' +
          'deste cupom e o ECF estar ligado.', ['&Ok']);
      End
      Else If strNumCoo <> strNumCooEcf Then
      Begin
        Result := False;
        fMensagem('ATENÇÃO!', 'O último documento emitido pelo ECF não corresponde ao documento sendo cancelado!' + #13#10 +
                              'Possíveis motivos: outros documentos já emitidos, emissão de comprovante de TEF, ' +
                              'emissão de Leitura X ou outro relatório gerencial.', ['&Ok']);
      End;

      blnCancelarCupomNoEcf := Result;

    End
    Else
    Begin
      Result := False;
      fMensagem('ATENÇÃO!', 'Para cancelar este cupom é necessário estar logado no computador onde está ligado o ECF ' +
        'deste cupom e o ECF estar ligado.', ['&Ok']);
    End;

  End;

end;

function TfrmCancelamentoDocumentos.fPodeCancelarLinkPagamentoCitel(
  const AblnPergunta: Boolean; const AstrNumDoc, AstrEspDoc,
  AstrCodEmp: string): Boolean;
begin
  Result := False ;

  if not AblnPergunta then
    Exit ;

  if AstrEspDoc <> 'PD' then
    Exit ;

  if not TLinkPagamentoCitelClass.fDocumentoLinkPagamentoCitel(AstrNumDoc, AstrEspDoc, AstrCodEmp, '', 'PD') then
    Exit ;

  if TLinkPagamentoCitelClass.fTemAdcliTransformadoEmCC(AstrNumDoc, AstrEspDoc, AstrCodEmp) then
    Exit ;

  Result := True ;
end;

procedure TfrmCancelamentoDocumentos.pRetornaDadosDoCupom(strNumDoc, strSerie,
  strCodCli: String; Var strNumSer, strNumCoo: String);
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);

  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  FIS_NUMSER, ');
  qryAux.SQL.Add('  FIS_NUMCOO ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADFIS ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  FIS_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  FIS_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  FIS_CODEMP = :CODEMP AND ');
  qryAux.SQL.Add('  FIS_FORCLI = :CODCLI AND ');
  qryAux.SQL.Add('  IFNULL(FIS_SERIE_, "") = :SERIE_ ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := 'IF';
  qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryAux.ParamByName('CODCLI').AsString := strCodCli;
  qryAux.ParamByName('SERIE_').AsString := strSerie;
  qryAux.Open;

  strNumSer := qryAux.FieldByName('FIS_NUMSER').AsString;
  strNumCoo := qryAux.FieldByName('FIS_NUMCOO').AsString;

  FreeAndNil(qryAux);
end;

