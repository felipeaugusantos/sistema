function TfrmCancelamentoDocumentos.fCupomFiscalImpresso(strNumDoc,
  strCliFor: String): Boolean;
  Var
    qryAux: TUniQuery;
begin

  Result := True;

  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  GER_IMPRES ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  MOVGER ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  GER_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  GER_ESPDOC IN ("IF", "IV") AND ');
  qryAux.SQL.Add('  GER_CODCLI = :CODCLI AND ');
  qryAux.SQL.Add('  GER_CODEMP = :CODEMP ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('CODCLI').AsString := strCliFor;
  qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryAux.Open;


  If (Not qryAux.IsEmpty) Then
  begin
    if qryAux.FieldByName('GER_IMPRES').DataType = ftInteger then
      Result := (qryAux.FieldByName('GER_IMPRES').AsInteger = 1)
    else
      Result := qryAux.FieldByName('GER_IMPRES').AsBoolean
  end;

  qryAux.Close;
  FreeAndNil(qryAux);

end;

function TfrmCancelamentoDocumentos.fCupomTemItensDevolvidos(strNumDoc, strEspDoc, strEmpDoc: String): Boolean;
Var
  qryAux: TUniQuery;
  stlMsg: TStringList;
begin
  Result := False;

  If (Not (strEspDoc = 'IF')) Then
    Exit;

  qryAux := fCriaQuery();
  stlMsg := TStringList.Create;

  Try
    qryAux.SQL.Add('  SELECT                                  ');
    qryAux.SQL.Add('    CONCAT(                               ');
    qryAux.SQL.Add('  	  "ITEM: ",                           ');
    qryAux.SQL.Add('  	  MD.DET_CODITE,                      ');
    qryAux.SQL.Add('  	  "-",                                ');
    qryAux.SQL.Add('  	  MD.DET_DESCRI,                      ');
    qryAux.SQL.Add('  	  " DOCUMENTO: ",                     ');
    qryAux.SQL.Add('  	  MD.DET_NUMDOC,                      ');
    qryAux.SQL.Add('  	  "-",                                ');
    qryAux.SQL.Add('  	  MD.DET_ESPDOC,                      ');
    qryAux.SQL.Add('  	  "-",                                ');
    qryAux.SQL.Add('  	  MD.DET_CODEMP                       ');
    qryAux.SQL.Add('    ) DESCRI,                             ');
    qryAux.SQL.Add('    MD.DET_NUMDOC,                        ');
    qryAux.SQL.Add('    MD.DET_ESPDOC,                        ');
    qryAux.SQL.Add('    MD.DET_CODEMP,                        ');
    qryAux.SQL.Add('    MD.DET_CODITE,                        ');
    qryAux.SQL.Add('    MD.DET_DESCRI                         ');
    qryAux.SQL.Add('  FROM                                    ');
    qryAux.SQL.Add('    MOVDET MD                             ');
    qryAux.SQL.Add('    INNER JOIN MOVTRI MT                  ');
    qryAux.SQL.Add('      ON (MD.AUTOINCREM = MT.DET_SEQGER)  ');
    qryAux.SQL.Add('  WHERE MD.DET_DOCDEV = :DOCDEV           ');
    qryAux.SQL.Add('    AND MD.DET_ESPDEV = :ESPDEV           ');
    qryAux.SQL.Add('    AND MD.DET_EMPDEV = :EMPDEV           ');
    qryAux.SQL.Add('    AND MD.DET_PROEMB <> "S"              ');

    qryAux.ParamByName('DOCDEV').AsString := strNumDoc;
    qryAux.ParamByName('ESPDEV').AsString := strEspDoc;
    qryAux.ParamByName('EMPDEV').AsString := strEmpDoc;

    qryAux.Open;

    qryAux.First;
    While (Not qryAux.Eof) Do
    Begin
      stlMsg.Add(qryAux.FieldByName('DESCRI').AsString);
      qryAux.Next;
    End;

    Result := (stlMsg.Count > 0);

    If Result Then
      fMensagemCancelamento('', 'O documento possui itens devolvidos, não é possível efetuar o cancelamento de itens já devolvidos.' + #10+#13 + stlMsg.Text, ['&Ok'], 0, 650 , stlMsg.Count );
  Finally
    FreeAndNil(qryAux);
    FreeAndNil(stlMsg);
  End;
end;

{********************************************}
{* VERIFICA SE O DOC ESTÁ EM ALGUM ROMANEIO *}
{*****************************************LU*}
function TfrmCancelamentoDocumentos.fVerificaDocumentoRomaneio(strEspSel,
  strNumDoc, strCliFor: String): Boolean;
  Var
    strNumRom,
    strSQL   : String;
    qryGenGer: TUniQuery;
begin
  Try

    Result := False;

    qryGenGer := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  CONCAT(GER_NUMROM,"-",GER_EMPROM) AS GER_NUMROM ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ROMGERX ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  GER_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  GER_CODEMP = :CODEMP ';

    With qryGenGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      If (Not IsEmpty) Then
      Begin
        Result := True;
        fMensagemCancelamento('', 'O documento: ' + strNumDoc + '-' + strEspSel + ' está no romaneio: ' +
                      FieldByName('GER_NUMROM').AsString + ' e não poderá ser cancelado!', ['&Ok']);
      End
      Else If fCfgSis('DEVROM', VarString) = '5' Then
      Begin
        strSQL := '';

        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  GROUP_CONCAT(DISTINCT CONCAT("DOC.: ", GER_NUMDOC,"-",GER_ESPDOC,"-",GER_CODEMP," ROM.: ", GER_NUMROM,"-",GER_EMPROM)) GER_NUMROM ';
        strSQL := strSQL + 'FROM                                                          ';
        strSQL := strSQL + '  ROMGERX INNER JOIN MOVDET ON GER_NUMDOC = DET_DOCDEV AND    ';
        strSQL := strSQL + '                               GER_ESPDOC = DET_ESPDEV AND    ';
        strSQL := strSQL + '                               GER_CODEMP = DET_EMPDEV AND    ';
        strSQL := strSQL + '                               GER_CODCLI = DET_CODCLI        ';
        strSQL := strSQL + '   WHERE DET_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '         DET_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '         DET_CODCLI = :CODCLI AND ';
        strSQL := strSQL + '         DET_CODEMP = :CODEMP     ';

        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspSel;
        ParamByName('CODCLI').AsString := strCliFor;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        Open;

        strNumRom := FieldByName('GER_NUMROM').AsString;

        If fEmptyStr(strNumRom) Then
        Begin
          strSQL := '';
          strSQL := strSQL + 'SELECT GROUP_CONCAT(DISTINCT CONCAT("DOC.ORI.: ",GER_NUMDOC,"-",GER_ESPDOC,"-",GER_CODEMP," DOC.CNF.: ",DETCNF.DET_NUMDOC,"-",DETCNF.DET_ESPDOC,"-",DETCNF.DET_CODEMP," ROM.: ",GER_NUMROM,"-",GER_EMPROM)) GER_NUMROM ';
          strSQL := strSQL + '  FROM MOVDET DETDEV INNER JOIN MOVTRI  TRIDEV ON TRIDEV.DET_SEQGER = DETDEV.AUTOINCREM '; //#DOC.DEV. >
          strSQL := strSQL + '                     INNER JOIN NOTDET  DETCNF ON DETCNF.AUTOINCREM = TRIDEV.DET_INCDEV '; //#DOC.DEV. > DOC.CNF.
          strSQL := strSQL + '                                              AND DETCNF.DET_NUMDOC = DETDEV.DET_DOCDEV ';
          strSQL := strSQL + '                                              AND DETCNF.DET_ESPDOC = DETDEV.DET_ESPDEV ';
          strSQL := strSQL + '                     INNER JOIN NOTTRI  TRICNF ON DETCNF.AUTOINCREM = TRICNF.DET_SEQGER '; //#DOC.CNF.
          strSQL := strSQL + '                     INNER JOIN MOVDET  DETVEN ON DETVEN.AUTOINCREM = TRICNF.DET_SEQDET '; //#DOC.CNF. > DOC.VEN;
          strSQL := strSQL + '                     INNER JOIN ROMGERX        ON GER_NUMDOC = DETVEN.DET_NUMDOC AND ';
          strSQL := strSQL + '                                                  GER_ESPDOC = DETVEN.DET_ESPDOC AND ';
          strSQL := strSQL + '                                                  GER_CODEMP = DETVEN.DET_CODEMP AND ';
          strSQL := strSQL + '                                                  GER_CODCLI = DETVEN.DET_CODCLI     ';
          strSQL := strSQL + '  WHERE DETDEV.DET_NUMDOC = :NUMDOC AND ';
          strSQL := strSQL + '        DETDEV.DET_ESPDOC = :ESPDOC AND ';
          strSQL := strSQL + '        DETDEV.DET_CODCLI = :CODCLI AND ';
          strSQL := strSQL + '        DETDEV.DET_CODEMP = :CODEMP     ';

          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspSel;
          ParamByName('CODCLI').AsString := strCliFor;
          ParamByName('CODEMP').AsString := VS_strCodEmp;
          Open;

          strNumRom := FieldByName('GER_NUMROM').AsString;
        End;

        If Not fEmptyStr(strNumRom) Then
        Begin
          Result := True;
          fMensagemCancelamento('', 'Essa devolução está debitando quantidade a serem entregues dos seguintes documentos/romaneios: '+
                        FieldByName('GER_NUMROM').AsString +' e só poderá ser cancelada se esses romaneios forem cancelados antes!', ['&Ok']);
        End;

      End;

      Close;
    End;

  Finally
    FreeAndNil(qryGenGer);
  End;

end;

function TfrmCancelamentoDocumentos.fCancelaDocumentoProducao(strNum_Pr, strCodEmp: String): Boolean;
  Var
    qryAux: TUniQuery;
begin

  Result := True;

  If fEmptyStr(strNum_Pr) Then
