function TfrmCancelamentoDocumentos.fVerificaDocConcertoEquipamento(strNumDoc, strTipFc, strSerie,
  strCodEmp, strCliFor: String; blnPedEnt: Boolean = False; strEspDoc: String = ''): Boolean;

  Function fGetSQLDocOri(strTab: String): String;
    Var
      strSQL : String;
  Begin
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   AUX_CONEQU ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '  ' + strTab + '  ';
    If strTab = 'MOVGER' Then
      strSQL := strSQL + '    INNER JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM ';
    strSQL := strSQL + ' WHERE ';
    strSQL := strSQL + ' GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + ' GER_TIP_FC = :TIP_FC AND ';
    If Not fEmptyStr(strEspDoc) Then
      strSQL := strSQL + ' GER_ESPDOC = :ESPDOC AND ';
    If Not fEmptyStr(strSerie) Then
      strSQL := strSQL + ' IFNULL(GER_SERIE_, "") = :SERIE AND ';
    strSQL := strSQL + ' GER_CODEMP = :CODEMP ';

    If (Not fEmptyStr(strCliFor)) Then
    Begin
      If (strTipFc = 'F') Then
        strSQL := strSQL + ' AND GER_CODFOR = :CLIFOR '
      Else
        strSQL := strSQL + ' AND GER_CODCLI = :CLIFOR '
    End;

    Result := strSQL;
  End;

  Var
    qryGer : TUniQuery; // SE FOR NI, VAI DIRETO NO NOTGER

begin
  qryGer := fCriaQuery(Self);
  Result := False;
  With qryGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(fGetSQLDocOri('MOVGER'));
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('TIP_FC').AsString := strTipFc;
    If Not fEmptyStr(strEspDoc) Then
      ParamByName('ESPDOC').AsString := strEspDoc;
    If Not fEmptyStr(strSerie) Then
      ParamByName('SERIE').AsString := strSerie;
    ParamByName('CODEMP').AsString := strCodEmp;

    If (Not fEmptyStr(strCliFor)) Then
      ParamByName('CLIFOR').AsString := strCliFor;

    Open;

    If qryGer.IsEmpty then
      Exit;

    Result :=  FieldByName('AUX_CONEQU').AsString = 'S';

  End;


  FreeAndNil(qryGer);
end;

function TfrmCancelamentoDocumentos.fSQLCarregaCtpOriginalDocEntrada: String;
begin
  Result :=
    'SELECT * '                                   + sLineBreak +
    'FROM CADPAG '                                + sLineBreak +
    'WHERE AUTOINCREM = :AUTINC '                 + sLineBreak +
    '  AND CTP_PAGANT = ' + QuotedStr('S');
end;

function TfrmCancelamentoDocumentos.fSQLExcluiCtpDocEntrada: String;
begin
  Result :=
    'DELETE FROM ' + sLineBreak +
    ' CADPAG ' + sLineBreak +
    'WHERE AUTOINCREM = :AUTINC ' ;
end;

function TfrmCancelamentoDocumentos.fSQLUpdatePagtoOriginalDocEntrada: String;
begin
  Result :=
    'UPDATE CADPAG SET ' + sLineBreak +
    '  CTP_VALORI = CTP_VALORI + :VALORI, ' + sLineBreak +
    '  CTP_VALPAG = CTP_VALPAG + :VALPAG ' + sLineBreak +
    'WHERE AUTOINCREM = :AUTINC';
end;

function TfrmCancelamentoDocumentos.fSQLCarregaPagtoAntecipado: String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT                     ';
  strSQL := strSQL + '   PGO_SEQPAG,              ';
  strSQL := strSQL + '   PGO_DUPORI,              ';
  strSQL := strSQL + '   PGO_SERORI,              ';
  strSQL := strSQL + '   PGO_FORORI,              ';
  strSQL := strSQL + '   PGO_PARORI,              ';
  strSQL := strSQL + '   PGO_SEQORI,              ';  
  strSQL := strSQL + '   PGO_EMPORI               ';
  strSQL := strSQL + ' FROM PGOGER P              ';
  strSQL := strSQL + ' INNER JOIN MOVGER G ON G.AUTOINCREM = PGO_SEQGER ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '       GER_NUMDOC = :NUMDOC ';
  strSQL := strSQL + '   AND GER_ESPDOC = :ESPDOC ';
  strSQL := strSQL + '   AND IFNULL(GER_SERIE_, "") = :SERIE_ ';
  strSQL := strSQL + '   AND GER_CODFOR = :CODFOR ';
  strSQL := strSQL + '   AND GER_CODEMP = :CODEMP ';

  Result := strSQL;
End;

function TfrmCancelamentoDocumentos.fSQLCarregaPagtoAntecipadoCTPDET: String;
Var
    strSQL: String;
begin
    strSQL := '';
    strSQL := strSQL + ' SELECT D.AUTOINCREM  AS AUTINCCTPDET ';
    strSQL := strSQL + ' FROM CADPAG G                        ';
    strSQL := strSQL + ' INNER JOIN CTPDET D                  ';
    strSQL := strSQL + '    ON G.CTP_CODFOR = D.CTP_CODFOR    ';
    strSQL := strSQL + '   AND G.CTP_NUMDUP = D.CTP_NUMDUP    ';
    strSQL := strSQL + '   AND G.CTP_PARCEL = D.CTP_PARCEL    ';
    strSQL := strSQL + '   AND G.CTP_CODEMP = D.CTP_CODEMP    ';
    strSQL := strSQL + '   AND G.CTP_SERIE_ = D.CTP_SERIE_    ';
    strSQL := strSQL + ' WHERE G.AUTOINCREM = :AUTINCCADPAG ';

    Result := strSQL;
end;

function TfrmCancelamentoDocumentos.fSQLUpdatePagtoAntecipado: String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + ' UPDATE CADPAG SET       ';
  strSQL := strSQL + '   CTP_NUMDUP = :DUPORI, ';
  strSQL := strSQL + '   CTP_SERIE_ = :SERORI, ';
  strSQL := strSQL + '   CTP_PARCEL = :PARCEL, ';
  strSQL := strSQL + '   CTP_SEQBAI = IFNULL(:SEQORI, CTP_SEQBAI), ';
  strSQL := strSQL + '   CTP_CODFOR = :FORORI,  ';
  strSQL := strSQL + '   CTP_CODEMP = IFNULL(:EMPORI, CTP_CODEMP) ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '   AUTOINCREM = :AUTINC  ';
  Result := strSQL;
End;

function TfrmCancelamentoDocumentos.fSQLUpdatePagtoAntecipadoCTPDET: String;
Var
    strSQL: String;
begin
  strSQL := '';
  strSQL := strSQL + ' UPDATE CTPDET                    ';
  strSQL := strSQL + '   SET CTP_NUMDUP = :DUPORI,      ';
  strSQL := strSQL + '       CTP_PARCEL = :PARCEL,      ';
  strSQL := strSQL + '       CTP_SERIE_ = :SERORI       ';
  strSQL := strSQL + ' WHERE AUTOINCREM = :AUTINCCTPDET ';

  Result := strSQL;
end;

function TfrmCancelamentoDocumentos.fSQLMaxParcelaPagtoAntecipado: String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT AUTOINCREM, MAX(CTP_PARCEL) AS PARCEL FROM CADPAG ';
  strSQL := strSQL + ' WHERE CTP_NUMDUP = :DUPORI  ';
  strSQL := strSQL + '   AND IFNULL(CTP_SERIE_, "") = :SERORI   ';
  strSQL := strSQL + '   AND CTP_CODEMP = IFNULL(:EMPORI, :CODEMP)   ';
  strSQL := strSQL + '   AND CTP_PARCEL = IFNULL(:PARCEL, CTP_PARCEL)   ';
  strSQL := strSQL + '   AND CTP_SEQBAI = IFNULL(:SEQORI, CTP_SEQBAI)   ';
  strSQL := strSQL + '   AND CTP_CODFOR = :CODFOR';
  Result := strSQL;
End;

function TfrmCancelamentoDocumentos.fSQLCancelaPagamentoAntecipado: String;
  Var
    strSQL: String;
Begin
  strSQL := '';
  strSQL := strSQL + ' DELETE FROM PGOGER     ';
  strSQL := strSQL + ' WHERE                  ';
  strSQL := strSQL + '   PGO_SEQPAG = :SEQPAG ';
  Result := strSQL;
End;

function TfrmCancelamentoDocumentos.fCancelaPagamentoAntecipado(strEspDoc, strNumDoc, strCliFor, strSerie: String): Boolean;
  Var
    qryPgoGer,
    qryUpdate,
    qryParcel,
    qryCTPDET,
    qryUpdateCTPDET,
    qryDelete,
    qryCtpOriginal: TUniQuery;
Begin

  qryCTPDET := fCriaQuery;
  qryUpdateCTPDET := fCriaQuery;
  qryParcel := fCriaQuery;
  qryUpdate := fCriaQuery;
  qryDelete := fCriaQuery;
  qryPgoGer := fCriaQuery;
  qryCtpOriginal := fCriaQuery;

  Try
    qryCTPDET.SQL.Text := fSQLCarregaPagtoAntecipadoCTPDET;
    qryUpdateCTPDET.SQL.Text := fSQLUpdatePagtoAntecipadoCTPDET;
    qryParcel.SQL.Text := fSQLMaxParcelaPagtoAntecipado;
    qryPgoGer.SQL.Text := fSQLCarregaPagtoAntecipado;

    qryPgoGer.ParamByName('NUMDOC').AsString := strNumDoc;
    qryPgoGer.ParamByName('ESPDOC').AsString := strEspDoc;
    qryPgoGer.ParamByName('SERIE_').AsString := strSerie;
    qryPgoGer.ParamByName('CODFOR').AsString := strCliFor;
    qryPgoGer.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryPgoGer.Open;

    While Not qryPgoGer.Eof do
    Begin
      qryParcel.Close;
      qryParcel.ParamByName('DUPORI').AsString := qryPgoGer.FieldByName('PGO_DUPORI').AsString;
      qryParcel.ParamByName('SERORI').AsString := qryPgoGer.FieldByName('PGO_SERORI').AsString;
      If fEmptyStr(qryPgoGer.FieldByName('PGO_FORORI').AsString) then
        qryParcel.ParamByName('CODFOR').AsString := strCliFor
      Else
       qryParcel.ParamByName('CODFOR').AsString := qryPgoGer.FieldByName('PGO_FORORI').AsString;

      qryParcel.ParamByName('EMPORI').Clear;
      If not fEmptyStr(qryPgoGer.FieldByName('PGO_EMPORI').AsString) then
        qryParcel.ParamByName('EMPORI').AsString := qryPgoGer.FieldByName('PGO_EMPORI').AsString;

      qryParcel.ParamByName('PARCEL').Clear;
      If not fEmptyStr(qryPgoGer.FieldByName('PGO_PARORI').AsString) then
        qryParcel.ParamByName('PARCEL').AsString := qryPgoGer.FieldByName('PGO_PARORI').AsString;

      qryParcel.ParamByName('SEQORI').Clear;
      If not fEmptyStr(qryPgoGer.FieldByName('PGO_SEQORI').AsString) then
        qryParcel.ParamByName('SEQORI').AsString := qryPgoGer.FieldByName('PGO_SEQORI').AsString;

      qryParcel.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryParcel.Open;

      {Volta o CTPDET com as informações originais}
      qryCTPDET.Close;
      qryCTPDET.ParamByName('AUTINCCADPAG').AsString := qryPgoGer.FieldByName('PGO_SEQPAG').AsString;
      qryCTPDET.Open;

      qryCTPDET.First;
      If (Not qryCTPDET.isEmpty) Then
      Begin
        While not qryCTPDET.eof Do
        Begin
          qryUpdateCTPDET.Close;
          qryUpdateCTPDET.ParamByName('DUPORI').AsString := qryPgoGer.FieldByName('PGO_DUPORI').AsString;
          qryUpdateCTPDET.ParamByName('SERORI').AsString := qryPgoGer.FieldByName('PGO_SERORI').AsString;
          If not fEmptyStr(qryPgoGer.FieldByName('PGO_PARORI').AsString) then
            qryUpdateCTPDET.ParamByName('PARCEL').AsString := qryPgoGer.FieldByName('PGO_PARORI').AsString
          Else
          begin
              If qryParcel.IsEmpty Or fEmptyStr(qryParcel.FieldByName('PARCEL').AsString) Then
                qryUpdateCTPDET.ParamByName('PARCEL').AsString := 'A'
              Else
                qryUpdateCTPDET.ParamByName('PARCEL').AsString := Char(Succ(Byte(qryParcel.FieldByName('PARCEL').AsString[1])));
          end;

          qryUpdateCTPDET.ParamByName('AUTINCCTPDET').AsString := qryCTPDET.FieldByName('AUTINCCTPDET').AsString;

          qryUpdateCTPDET.ExecSQL;

          qryCTPDET.next;
        End
      End;

      If (not qryParcel.FieldByName('PARCEL').IsNull) Then
      Begin
        qryCtpOriginal.Close;
        qryCtpOriginal.SQL.Text := fSQLCarregaCtpOriginalDocEntrada;
        qryCtpOriginal.ParamByName('AUTINC').AsString := qryPgoGer.FieldByName('PGO_SEQPAG').AsString;
        qryCtpOriginal.Open;

        If not qryCtpOriginal.isEmpty Then
        Begin
          {Baixa parcial do pagamento antecipado: retorna o valor do documento que está sendo cancelado.}
          qryUpdate.Close;
          qryUpdate.SQL.Text := fSQLUpdatePagtoOriginalDocEntrada;
          qryUpdate.ParamByName('VALORI').AsFloat := qryCtpOriginal.FieldByName('CTP_VALORI').AsFloat;
          qryUpdate.ParamByName('VALPAG').AsFloat := qryCtpOriginal.FieldByName('CTP_VALPAG').AsFloat;
          qryUpdate.ParamByName('AUTINC').AsString := qryParcel.FieldByName('AUTOINCREM').AsString;
          qryUpdate.ExecSQL;

          {Exclui o contas a pagar do documento de entrada.}
           fVerificaIntegridade(Self.Name, 'CADPAG', qryCtpOriginal, True, False, EmptyStr, fOperadorDoCancelamento);
           untLogCtp.GravaLogCtp(qryCtpOriginal.FieldByName('AUTOINCREM').AsString,
                                 'EXCLUSAO',
                                 Self.Name);

          qryDelete.Close;
          qryDelete.SQL.Text := fSQLExcluiCtpDocEntrada;
          qryDelete.ParamByName('AUTINC').AsString := qryCtpOriginal.FieldByName('AUTOINCREM').AsString;
          qryDelete.ExecSQL;
        End;

        {Exclui o registro da PGOGER do documento de entrada.}
        qryDelete.Close;
        qryDelete.SQL.Text := fSQLCancelaPagamentoAntecipado;
        qryDelete.ParamByName('SEQPAG').AsString := qryPgoGer.FieldByName('PGO_SEQPAG').AsString;
        qryDelete.ExecSQL;
      End
      Else
      begin
        {Volta o Cadpag com as informações originais}
        qryUpdate.Close;
        qryUpdate.SQL.Text := fSQLUpdatePagtoAntecipado;
        qryUpdate.ParamByName('AUTINC').AsString := qryPgoGer.FieldByName('PGO_SEQPAG').AsString;
        qryUpdate.ParamByName('DUPORI').AsString := qryPgoGer.FieldByName('PGO_DUPORI').AsString;
        qryUpdate.ParamByName('SERORI').AsString := qryPgoGer.FieldByName('PGO_SERORI').AsString;
        qryUpdate.ParamByName('FORORI').AsString := qryPgoGer.FieldByName('PGO_FORORI').AsString;
        qryUpdate.ParamByName('EMPORI').Clear;
        If not fEmptyStr(qryPgoGer.FieldByName('PGO_EMPORI').AsString) then
          qryUpdate.ParamByName('EMPORI').AsString := qryPgoGer.FieldByName('PGO_EMPORI').AsString;

        qryUpdate.ParamByName('PARCEL').Clear;
        If not fEmptyStr(qryPgoGer.FieldByName('PGO_PARORI').AsString) then
          qryUpdate.ParamByName('PARCEL').AsString := qryPgoGer.FieldByName('PGO_PARORI').AsString
        Else
        begin
          If qryParcel.IsEmpty Or fEmptyStr(qryParcel.FieldByName('PARCEL').AsString) Then
            qryUpdate.ParamByName('PARCEL').AsString := 'A'
          Else
            qryUpdate.ParamByName('PARCEL').AsString := Char(Succ(Byte(qryParcel.FieldByName('PARCEL').AsString[1])));
        end;

        qryUpdate.ParamByName('SEQORI').Clear;
        If not fEmptyStr(qryPgoGer.FieldByName('PGO_SEQORI').AsString) then
          qryUpdate.ParamByName('SEQORI').AsString := qryPgoGer.FieldByName('PGO_SEQORI').AsString;

        qryUpdate.ExecSQL;

        qryDelete.Close;
        qryDelete.SQL.Text := fSQLCancelaPagamentoAntecipado;
        qryDelete.ParamByName('SEQPAG').AsString := qryPgoGer.FieldByName('PGO_SEQPAG').AsString;
        qryDelete.ExecSQL;
      end;

      qryPgoGer.Next;
    End;
    Result := True;
  Finally
    FreeAndNil(qryUpdateCTPDET);
    FreeAndNil(qryPgoGer);
    FreeAndNil(qryCTPDET);
    FreeAndNil(qryParcel);
    FreeAndNil(qryUpdate);
    FreeAndNil(qryDelete);
    FreeAndNil(qryCtpOriginal);
  End;

End;

procedure TfrmCancelamentoDocumentos.pCancelarDocumentoLocacaoEquipamento(
  const strEspDoc: String; strNumDocAdt, strEmpDocAdt, strNumDoc: String);
var
  intIndice: Integer;
begin
  FNumDocAdt := strNumDocAdt;
