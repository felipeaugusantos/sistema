function TfrmCancelamentoDocumentos.fPemiteCancelarDocumentoComEntregaLalaMove(const strNumDoc, strEspDoc, strCodEmp, strCliFor, strTipFc : String) : Boolean;

  procedure pErrorMessage(const AMessage: string; const AErrors: TLalamoveErrorResponse; const AStatusCode : Integer);
    Var
      LCount : Integer;
      LMessage : String;
  begin
    If (AStatusCode = 422) Then
      pMensagemOK('Lalamove: Não é possível cancelar o pedido!')
    Else If (AStatusCode = 409) Then
      pMensagemOK('Lalamove: Cancelamento proibido!')
    Else If (Length(AErrors.errors) = 0) Then
      pMensagemOK(AMessage)
    Else
    Begin
      LMessage := '';
      For LCount := 0 To Length(AErrors.errors) -1 Do
      Begin
        If (Not fEmptyStr(AErrors.errors[LCount].message)) Then
          LMessage := LMessage + 'Id: ' + AErrors.errors[LCount].id + sLineBreak + 'Message: ' + AErrors.errors[LCount].message + sLineBreak;
      End;
      If fEmptyStr(LMessage) Then
        pMensagemOK(AMessage)
      Else
        pMensagemOK(LMessage);
    End;
  end;

  Var
    strIdPed : String;
    objLalaMoveApiClient : TLalaMoveApiClient;
begin
  Result := True;
  If (fCfgSis('USALAL', varString) = 'N') Then
    Exit;
  If (Not fDocumentoTemVinculoComLalaMove(strNumDoc, strEspDoc, strCodEmp, strCliFor, strTipFc, strIdPed)) Then
    Exit;
  If fMensagem('', 'O documento possui vínculo com entrega LalaMove, é necessário enviar o cancelamento na plataforma LalaMove, deseja prosseguir?', ['&Sim', '&Não'], 2) = 2 Then
    Exit(False);
  objLalaMoveApiClient := TLalaMoveApiClient.Create;
  Try
    Try
      If objLalaMoveApiClient.deleteOrder(strIdPed) Then
        pCancelarMovLal(strNumDoc, strEspDoc, strCodEmp, strCliFor, strTipFc);
    Except
      On E: ExceptionLalaMovApiClientError Do
      Begin
        Result := False;
        pErrorMessage(E.Message, E.Errors, E.StatusCode);
      End;
    End;
  Finally
    FreeAndNil(objLalaMoveApiClient);
  End;
end;



procedure TfrmCancelamentoDocumentos.pBaixarPedidosComoNaoEntregueCRM;
  Var
    lstBaixarPedOrcNaoEntregue : TObjectList<TBaixarPedOrcNaoEntregue>;
    objBaixarPedOrcNaoEntregue : TBaixarPedOrcNaoEntregue;
    intCnt : Integer;
    recOcorrenciaBaixa : TOcorrenciaBaixa;
begin
  lstBaixarPedOrcNaoEntregue := TObjectList<TBaixarPedOrcNaoEntregue>.Create;
  Try
    For intCnt := 0 To Length(FarrDocParaBaixa)-1 Do
    Begin
      objBaixarPedOrcNaoEntregue := TBaixarPedOrcNaoEntregue.Create;
      objBaixarPedOrcNaoEntregue.ExecutandoPeloCRM := True;
      objBaixarPedOrcNaoEntregue.strNomeForm := Self.Name;
      objBaixarPedOrcNaoEntregue.AddDocumento(FarrDocParaBaixa[intCnt].strNumeroDocumento, FarrDocParaBaixa[intCnt].strEspecieDocumento, FarrDocParaBaixa[intCnt].strCodigoEmpresa);
      Try
        If Not objBaixarPedOrcNaoEntregue.PermiteExecutar Then
          Exit;
        objBaixarPedOrcNaoEntregue.ValidaDocumento;
        lstBaixarPedOrcNaoEntregue.Add(objBaixarPedOrcNaoEntregue);
      Except
        On E: EValidaException Do
        Begin
          fMensagem('ATENÇÃO!', E.Message, ['&Ok']);
          Exit;
        End;
        On E: EValidaPedidoPossuiItensEmSeparacao Do
        Begin
          If not fEmptyStr(E.Message) Then
            fMensagem('ATENÇÃO!', E.Message, ['&Ok']);
          Exit;
        End;
      End;
    End;

    If (lstBaixarPedOrcNaoEntregue.Count > 0) And (Length(FarrDocParaBaixa) = lstBaixarPedOrcNaoEntregue.Count) Then
    Begin
      FillChar(recOcorrenciaBaixa, SizeOf(recOcorrenciaBaixa), #0);
      recOcorrenciaBaixa.strCodOco := lstBaixarPedOrcNaoEntregue[0].fGetOcorrencia(recOcorrenciaBaixa.strHisBai, recOcorrenciaBaixa.strHistcomplementar, recOcorrenciaBaixa.blnMostrarOpVendaPerdida);
      If (Not fEmptyStr(recOcorrenciaBaixa.strCodOco)) Then
      Begin
        Try
          fStartTransaction;
          For intCnt := 0 To lstBaixarPedOrcNaoEntregue.Count - 1 Do
          Begin
            lstBaixarPedOrcNaoEntregue[intCnt].RealizouValidacao := True;
            lstBaixarPedOrcNaoEntregue[intCnt].OcorrenciaBaixa := recOcorrenciaBaixa;
            lstBaixarPedOrcNaoEntregue[intCnt].ExibirMensagemFinalizacao := False;
            lstBaixarPedOrcNaoEntregue[intCnt].Executar;
          End;
          fCommit;
          fMensagem('ATENÇÃO!', 'Documento(s) baixado(s) com sucesso!', ['&OK']);
        Except
          On E: Exception Do
          Begin
            fRollBack;
            Raise;
          End;
        End;
      End;
    End;
  Finally
    FreeAndNil(lstBaixarPedOrcNaoEntregue);
  End;
end;

function TfrmCancelamentoDocumentos.fFalhaEmTransacao : Boolean;
begin
  Result := False;
  If (fInTransaction) Then
    Exit;
  pGravarErro(True, 'Cancelando itens do documento sem transação', fRetornaStack);
  fMensagem('ATENÇÃO!', 'Falha na gravação do cancelamento dos itens do documento ( A operação NÃO está em transação! )', ['&OK']);
  Result := True;
end;

