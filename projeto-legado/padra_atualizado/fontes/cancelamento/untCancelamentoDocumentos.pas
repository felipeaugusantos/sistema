function TfrmCancelamentoDocumentos.fPodeCancelarNFCeCAT83Art14(strEspSel, strEspCan, strTipFc, strNumDoc, strCliFor: String): Boolean;
  Var
    qryTmpAux : TUniQuery;
    strSQL    : String;
    dtaHraProt: TDateTime;
begin
  Result := True;
  qryTmpAux := fCriaQuery;
  strSQL := '';
  dtaHraProt := fNow;

  If (strEspSel = 'IC') Then
  Begin
    strSQL := strSQL + 'SELECT NFE_DTAAUT FROM LOGNFE ';
    strSQL := strSQL + 'WHERE NFE_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '  AND NFE_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '  AND NFE_CODEMP = :CODEMP ';
    strSQL := strSQL + '  AND NFE_CODCLI = :CODCLI ';

    qryTmpAux.Close;
    qryTmpAux.SQL.Clear;
    qryTmpAux.SQL.Add(strSQL);
    qryTmpAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTmpAux.ParamByName('ESPDOC').AsString := strEspCan;
    qryTmpAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryTmpAux.ParamByName('CODCLI').AsString := strCliFor;
    qryTmpAux.Open;

    If Not qryTmpAux.IsEmpty Then
    Begin
      dtaHraProt := qryTmpAux.FieldByName('NFE_DTAAUT').AsDateTime;
    End;
  End
  Else
  Begin
    strSQL := strSQL + 'SELECT MOV_DPROTO ';
    strSQL := strSQL + '  FROM MOVGER ';
    strSQL := strSQL + '  JOIN MOVOBS ON MOV_SEQGER = AUTOINCREM ';
    strSQL := strSQL + ' WHERE GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '   AND GER_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '   AND GER_' + strTipFc + '  = :CLIFOR ';
    strSQL := strSQL + '   AND GER_CODEMP = :CODEMP';

    With qryTmpAux Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspCan;
      ParamByName('CLIFOR').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      If Not IsEmpty Then
      Begin
        dtaHraProt := FieldByName('MOV_DPROTO').AsDateTime;
      End
      Else
      Begin

        Close;
        SQL.Clear;
        strSQL := AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');
        strSQL := AnsiReplaceStr(strSQL, 'MOVOBS', 'NOTOBS');
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspCan;
        ParamByName('CLIFOR').AsString := strCliFor;
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        Open;
        If Not IsEmpty Then
        Begin
          dtaHraProt := FieldByName('MOV_DPROTO').AsDateTime;
        End;

      End;
      Close;
      FreeAndNil(qryTmpAux);

    End;
  End;

  If ( IncMinute(dtaHraProt, 30) < fNow ) Then
    Result := False;

End;

function TfrmCancelamentoDocumentos.fValidaCampos(Sender: TWinControl;
  blnBuscaPorChave: Boolean): Boolean;
  Var
    strCliFor,
    strDocGarTmp: String;
    blnNaoRecClienteGar: Boolean;
begin

  blnNaoRecClienteGar := True;
  Result := True;

  If (inherited fValidaCampos(Sender, blnBuscaPorChave)) Then
  Begin

    If (Sender = edtNumDoc) Then
    Begin
      If (fEmptyStr(edtNumDoc.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'O documento deve ser preenchido!', ['&Ok']);
        Result := False;
      End;
    End

    Else If (Sender = edtCliFor) Then
    Begin
      If edtTipPes.Visible Then
      Begin
        If (SameText(edtTipPes.Text, 'C')) Then
          strCliFor := 'Cliente'
        Else
          strCliFor := 'Fornecedor';
      End
      Else
      Begin
        If Not fEmptyStr(edtNumDoc.Text)  And (arrEspecies[intIndiceEsp][0] <> 'EF') Then
          blnNaoRecClienteGar := fPermiteCanRecClienteGar(arrEspecies[intIndiceEsp][0],
                                                          edtNumDoc.Text,
                                                          edtCliFor.Text,
                                                          strDocGarTmp);

        If (Pos(arrEspecies[intIndiceEsp][0], 'NE_NI_OF_NG_NR_GF_GR_EF_') > 0) And
           (blnNaoRecClienteGar) Then
        Begin
          strCliFor := 'Fornecedor';
        End
        Else
        Begin
          strCliFor := 'Cliente';
        End;

      End;

      If (edtCliFor.Visible) Then
      Begin
        If (fEmptyStr(edtCliFor.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'O ' + strCliFor + ' deve ser preenchido!', ['&Ok']);
          Result := False;
        End
        Else
        Begin
          //If (Pos(arrEspecies[intIndiceEsp][0], 'NE_NI_') > 0) Then
          //If SameText(strCliFor, 'Fornecedor') Then
          If (edtTipPes.Visible And SameText(edtTipPes.Text, 'F')) Or
             ((Pos(arrEspecies[intIndiceEsp][0], 'NE_NI_NG_NR_GF_GR_EF_') > 0) And
             (blnNaoRecClienteGar)) Then
          Begin
            pCarregaFornecedor
          End
          Else
            pCarregaCliente;

          If fEmptyStr(edtDesCri.Text) Then
          Begin
            fMensagem('ATENÇÃO!', 'Esse ' + strCliFor + ' não está cadastrado!', ['&Ok']);
            Result := False;
          End;
        End;
      End;
    End

    {*******************************************}
    {* VALIDA TIPO CLI\FOR                     *}
    {****************************************JB*}
    Else If (Sender = edtTipPes) Then
    Begin
      If Pos(edtTipPes.Text, 'C_F_') <= 0 Then
      Begin
        fMensagem('ATENÇÃO!','O campo tipo de pessoa deve ser C ou F.',['&O K']);
        Result := False;
      End;
    End;

  End;

  If Not Result Then
    pSetFocus(Sender);

end;

