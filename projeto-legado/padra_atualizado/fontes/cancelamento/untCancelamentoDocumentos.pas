      pIncrementaListaStr(arrAux[intOrd].strNumPed + '-' +
                          arrAux[intOrd].strEspPed + '-' +
                          arrAux[intOrd].strEmpPed, strPedidosMesmaLoja);
    End
    Else
    Begin
      pIncrementaListaStr(arrAux[intOrd].strNumPed + '-' +
                          arrAux[intOrd].strEspPed + '-' +
                          arrAux[intOrd].strEmpPed, strPedidosOutraLoja);
