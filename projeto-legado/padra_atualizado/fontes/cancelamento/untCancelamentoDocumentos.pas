procedure TfrmCancelamentoDocumentos.pCarrregaArrayPedidos(
  var arrAux: TArrPedVendaCanc; strNumPed, strEspPed, strEmpPed, strCodCli,
  strMen001: String; blnIncrementaLista: Boolean);
var
  intOrd : Integer;
begin
  SetLength(arrAux, Length(arrAux) + 1);
  intOrd := (Length(arrAux) - 1);

  arrAux[intOrd].blnGarant := False;
  arrAux[intOrd].strNumPed := strNumPed;
  arrAux[intOrd].strEspPed := strEspPed;
  arrAux[intOrd].strEmpPed := strEmpPed;
  arrAux[intOrd].strCodCli := strCodCli;
  arrAux[intOrd].blnMesLoj := SameText(arrAux[intOrd].strEmpPed, VS_strCodEmp);
  arrAux[intOrd].taDeleta  := Deleta;

