procedure TfrmCancelamentoDocumentos.pCancelaNotaEspecialComplementarDeIPI(const strNumDoc, strEspDoc, strCodCli: String);
Var
  qryAux: TUniQuery;
  qryUpd: TUniQuery;
begin

  qryAux := fCriaQuery;
  qryUpd := fCriaQuery;

  Try
    qryAux.SQL.Text := ' SELECT DET_DOCIPI, DET_ESPIPI, DET_EMPIPI, DET_CODITE FROM NOTDET '+
                       ' INNER JOIN NOTTRI ON NOTTRI.DET_SEQGER = NOTDET.AUTOINCREM '+
                       ' WHERE DET_NUMDOC = :NUMDOC '+
                       '   AND DET_ESPDOC = :ESPDOC '+
                       '   AND DET_CODEMP = :CODEMP '+
                       '   AND DET_CODCLI = :CODCLI '+
                       '   AND TRIM(IFNULL(DET_DOCIPI, "")) <> "" ';

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.Open;

    While not qryAux.Eof Do
    Begin
      qryUpd.Close;
      qryUpd.SQL.Text := 'UPDATE '+
                         '  MOVTRI '+
                         '  INNER JOIN MOVDET ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER '+
                         'SET DET_CIPIOK = "N" '+
                         'WHERE DET_NUMDOC = :NUMDOC '+
                         '  AND DET_ESPDOC = :ESPDOC '+
                         '  AND DET_CODEMP = :CODEMP '+
                         '  AND DET_CODITE = :CODITE ';

      qryUpd.ParamByName('NUMDOC').AsString := qryAux.FieldByName('DET_DOCIPI').AsString;
      qryUpd.ParamByName('ESPDOC').AsString := qryAux.FieldByName('DET_ESPIPI').AsString;
      qryUpd.ParamByName('CODEMP').AsString := qryAux.FieldByName('DET_EMPIPI').AsString;
      qryUpd.ParamByName('CODITE').AsString := qryAux.FieldByName('DET_CODITE').AsString;
      qryUpd.ExecSQL;

      qryAux.Next;
    End;

  Finally
    FreeAndNil(qryAux);
    FreeAndNil(qryUpd);
  End;
end;

function TfrmCancelamentoDocumentos.fVerificaSituacaoDoDocumentoFiscal(strNumDoc, strEspDoc, strCodEmp, strCodCli, strTip_FC, strSerie: String): Boolean;
  var
    LChaveAcesso: String;
    LStatusDFe: String;
begin
  Result := True;

  If not fCfgSis('NFSENO', varBoolean) Then
    Exit;

  If not fCfgSis('CHKNFS', varBoolean) Then
    Exit;

  LChaveAcesso := fRetChaveAcesso(strNumDoc, strEspDoc, strCodCli, strCodEmp);

  If fEmptyStr(LChaveAcesso) Then
    Exit(False);

  LStatusDFe   := fConsultaStatusDFe(LChaveAcesso, strNumDoc, strEspDoc, strCodEmp, strSerie, strCodCli, strTip_FC);

  Result := (LStatusDFe = 'Autorizada');
end;

function TfrmCancelamentoDocumentos.fConfirmaCancelamentoLibNfe(strEspecieNFe, strErros: String): Boolean;
begin
  Result := False;

  If not (strEspecieNFe = 'NS') Then
    Exit;

  If not fCfgSis('NFESER', varBoolean) Then
    Exit;

  If not fCfgSis('NFSENO', varBoolean) Then
    Exit;

  If fSuportaCancelamentoNFSe(strErros) Then
    Exit;

  objLiberacao.Clear;
  objLiberacao.strDirAce    := 'CANWEB';
  objLiberacao.strCodOpe    := strLoginUsuarioLogado;
  objLiberacao.strCodDig    := strLoginUsuarioLogado;
  objLiberacao.objMsgLibera.pAddTexto('A prefeitura responsável por essa nota não suporta cancelamento de forma automática (via integração/WebService).');
  objLiberacao.objMsgLibera.pAddTexto('Ao liberar essa trava, o autcom vai processar o cancelamento da nota apenas no banco de dados do sistema e sendo assim,');
  objLiberacao.objMsgLibera.pAddTexto('não vai haver nenhum tipo de envio de cancelamento para a prefeitura.');
  objLiberacao.objMsgLibera.pAddTexto('Para cancelar a nota na prefeitura é preciso acessar e fazer o processo pelo portal da mesma.');

  Result := objLiberacao.fLibera;
end;

function TfrmCancelamentoDocumentos.fCancelarCTeDaNotaDenegada(strNumDoc, strEspDoc, strCodEmp, strSerie: String): Boolean;
begin
  Try
    Result := fExisteCTe(strNumDoc, strSerie, strCodEmp, strEmpCliCTe, strClienteCTe, strFornecedorCTe, strChaveDeAcessoCTe, strImportouCTe);

    If Result Then
      Result := fCancelaCTeLivroFiscal(strNumDoc, strSerie);

    if Result then
      Result := fCancelaContasReceber(strEspDoc, strNumDoc, strClienteCTe, strCodEmp);

    if Result then
      Result := fCancelaContasPagar(strEspDoc, strEspDoc, strNumDoc, strFornecedorCTe, strSerie);

    if Result then
      Result := fCancelaCTE(RightStr(strNumDoc, 9), strSerie, strCodEmp);

    if Result then
      Result := fAtualizaStatusCTe('CC', strNumDoc, strCodEmp);

  Finally
    strEmpCliCTe        := '';
    strClienteCTe       := '';
    strFornecedorCTe    := '';
    strImportouCTe      := '';
    strChaveDeAcessoCTe := '';
  End;
end;

function TfrmCancelamentoDocumentos.fCancelaEstornoNotaFiscal(strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
Var
  strDocDev: String;
  strEspDev: String;
  strEmpDev: String;
  qryAux: TUniQuery;
  qryUpd: TUniQuery;

begin
  Result := True;

  Try
    qryAux := fCriaQuery(Self);

    Try
      qryAux.SQL.Add('SELECT AUX_DOCDEV, AUX_ESPDEV, AUX_EMPDEV FROM MOVGER ');
      qryAux.SQL.Add('INNER JOIN AUXMOV ON AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM ');
      qryAux.SQL.Add('WHERE GER_NUMDOC = :NUMDOC ');
      qryAux.SQL.Add('  AND GER_ESPDOC = :ESPDOC ');
      qryAux.SQL.Add('  AND GER_CODEMP = :CODEMP ');
      qryAux.SQL.Add('  AND GER_CODCLI = :CODCLI ');
      qryAux.SQL.Add('  AND AUX_ESTNFE = "S" ');

      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.ParamByName('CODCLI').AsString := strCodCli;

      qryAux.Open;

      If not qryAux.IsEmpty Then
      Begin
        strDocDev := qryAux.FieldByName('AUX_DOCDEV').AsString;
        strEspDev := qryAux.FieldByName('AUX_ESPDEV').AsString;
        strEmpDev := qryAux.FieldByName('AUX_EMPDEV').AsString;

        qryUpd := fCriaQuery(Self);

        Try
          qryUpd.Close;
          qryUpd.SQL.Clear;
          qryUpd.SQL.Add('UPDATE CADFIS SET FIS_ESTNFE = "N" ');
          qryUpd.SQL.Add('WHERE FIS_NUMDOC = :NUMDOC ');
          qryUpd.SQL.Add('  AND FIS_ESPDOC = :ESPDOC ');
          qryUpd.SQL.Add('  AND FIS_CODEMP = :CODEMP ');
          qryUpd.SQL.Add('  AND FIS_FORCLI = :FORCLI ');
          qryUpd.ParamByName('NUMDOC').AsString := strDocDev;
          qryUpd.ParamByName('ESPDOC').AsString := strEspDev;
          qryUpd.ParamByName('CODEMP').AsString := strEmpDev;
          qryUpd.ParamByName('FORCLI').AsString := strCodCli;
          qryUpd.ExecSQL;

        Finally
          FreeAndNil(qryUpd);
        End;
      End;

    Finally
      FreeAndNil(qryAux);
    End;
  Except
    Result := False;
  End;

end;

function TfrmCancelamentoDocumentos.fExisteEstornoNotaFiscal(strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
Var
  strNumEst: String;
  strEspEst: String;
  strEmpEst: String;
  qryAux: TUniQuery;

begin
  qryAux := fCriaQuery(Self);

  Try
    qryAux.SQL.Add('SELECT DET_NUMDOC, DET_ESPDOC, DET_CODEMP FROM MOVDET ');
    qryAux.SQL.Add('INNER JOIN AUXMOV ON AUXMOV.AUX_SEQGER = MOVDET.DET_SEQGER ');
    qryAux.SQL.Add('WHERE AUX_DOCDEV = :NUMDOC ');
    qryAux.SQL.Add('  AND AUX_ESPDEV = :ESPDOC ');
    qryAux.SQL.Add('  AND AUX_EMPDEV = :CODEMP ');
    qryAux.SQL.Add('  AND DET_CODCLI = :CODCLI ');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;

    qryAux.Open;

    Result := (qryAux.RecordCount > 0);

    If Result Then
    Begin
      strNumEst := qryAux.FieldByName('DET_NUMDOC').AsString;
      strEspEst := qryAux.FieldByName('DET_ESPDOC').AsString;
      strEmpEst := qryAux.FieldByName('DET_CODEMP').AsString;

      fMensagemCancelamento( 'ATENÇÃO', 'Cancele a nota de estorno antes de cancelar esse documento.'+#13+
                                        'Nota de Estorno ['+strNumEst+'-'+strEspEst+'-'+strEmpEst+']', ['&Ok']);
    End;

  Finally
    FreeAndNil(qryAux);
  End;
end;

function TfrmCancelamentoDocumentos.fSuportaCancelamentoNFSe(strErros: String): Boolean;
begin
  Result := True;

  If (Pos('prefeitura nao suporta cancelamento de forma automatica', fRemoveAcento(LowerCase(strErros))) > 0) Then
    Exit(False);

  If (Pos('cancelamentonegado', fRemoveAcento(LowerCase(strErros))) > 0) Then
    Exit(False);

end;

