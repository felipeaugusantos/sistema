function TfrmCancelamentoDocumentos.fDesagruparFinaneiroDeConfirmacaoDeCupomFiscal(
  const strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  qryConsulta: TUniQuery;
  frmDesagrupDuplicatas : TfrmDesagrupDuplicatas;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.Close;
    qryConsulta.SQL.Text := 'SELECT '
                          + '       U.CTR_NUMAGR '
                          + '     , U.CTR_CODCLI '
                          + '     , U.CTR_EMPAGR '
                          + '  FROM DUPAGR U '
                          + ' WHERE EXISTS(SELECT D.AUTOINCREM FROM MOVDET D '
                          + '               WHERE U.CTR_NUMDUP = D.DET_NUMDOC '
                          + '                 AND U.CTR_ESPDOC = D.DET_ESPDOC '
                          + '                 AND U.CTR_CODEMP = D.DET_CODEMP '
                          + '                 AND U.CTR_CODCLI = D.DET_CODCLI '
                          + '                 AND D.DET_NUMFAT = :NUMDOC '
                          + '                 AND D.DET_TIPFAT = :ESPDOC '
                          + '                 AND D.DET_CODEMP = :CODEMP) '
                          + ' LIMIT 1 ';

    qryConsulta.ParamByName('NUMDOC').AsString := strNumDoc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspDoc;
    qryConsulta.ParamByName('CODEMP').AsString := strCodEmp;
    qryConsulta.Open;

    If qryConsulta.IsEmpty Then
      Exit(True);

    frmDesagrupDuplicatas := TfrmDesagrupDuplicatas.Create(Nil);
    Try
      Result := frmDesagrupDuplicatas.fDesagrupaDuplicatas(
                  qryConsulta.FieldByName('CTR_NUMAGR').AsString,
                  qryConsulta.FieldByName('CTR_CODCLI').AsString,
                  qryConsulta.FieldByName('CTR_EMPAGR').AsString,
                  False);
    Finally
      pFreeAndNil(frmDesagrupDuplicatas);
    End;
  Finally
    FreeAndNil(qryConsulta);
  End;
end;

procedure TfrmCancelamentoDocumentos.pDesfaturaItemPedidoOriginal(strNum_PD: String;
                                                                  strEsp_PD: String;
                                                                  strEmp_PD: String;
                                                                  strCodIte: String;
                                                                  fltQtdIte: Double;
                                                                  fltDesEsp: Double;
                                                                  intInd_PD: Integer;
                                                                  blnUtiPen: Boolean;
                                                                  strAutInc: String = '';
                                                                  blnAtualizaDadosFat: Boolean = True);
  Var
    strSQL: String;
    qryGenDor: TUniQuery;
begin
  qryGenDor := fCriaQuery;
  Try
    strSQL := '';
    strSQL := strSQL + 'UPDATE FATDOR ';
    strSQL := strSQL + 'SET FDO_QTDBAI = IF(FDO_QTDBAI <= 0, 0, FDO_QTDBAI - :QTDITE) ';
    strSQL := strSQL + '   ,FDO_DESBAI = IF(FDO_QTDBAI <= 0, 0, FDO_DESBAI - :DESESP) ';
    {* Só desfatura o item caso tenha sido totalmente cancelado *MV*}
    strSQL := strSQL + '   ,FDO_JAFATU = IF(FDO_QTDBAI < FDO_QTDITE, 0, FDO_JAFATU)   ';

    If blnAtualizaDadosFat Then
    Begin
      strSQL := strSQL + ' ,FDO_TIPFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_TIPFAT) ';
      strSQL := strSQL + ' ,FDO_NUMFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_NUMFAT) ';
      strSQL := strSQL + ' ,FDO_EMPFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_EMPFAT) ';
      strSQL := strSQL + ' ,FDO_DTAFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_DTAFAT) ';
      strSQL := strSQL + ' ,FDO_VENFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_VENFAT) ';
      strSQL := strSQL + ' ,FDO_CNDFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_CNDFAT) ';
      strSQL := strSQL + ' ,FDO_VALFAT = IF(FDO_QTDBAI < FDO_QTDITE, NULL, FDO_VALFAT) ';
    End;

    strSQL := strSQL + 'WHERE FDO_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '  AND FDO_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '  AND FDO_CODEMP = :CODEMP ';

    If Not blnUtiPen Then
    Begin
      strSQL := strSQL + ' AND FDO_SEQIND = :SEQIND ';
      strSQL := strSQL + ' AND FDO_CODITE = :CODITE ';

      If Not fEmptyStr(strAutInc) Then
        strSQL := strSQL + ' AND AUTOINCREM = :AUTINC ';
    End;

    qryGenDor.SQL.Add(strSQL);
    qryGenDor.ParamByName('QTDITE').AsFloat  := fltQtdIte;
    qryGenDor.ParamByName('DESESP').AsFloat  := fltDesEsp;
    qryGenDor.ParamByName('NUMDOC').AsString := strNum_PD;
    qryGenDor.ParamByName('ESPDOC').AsString := strEsp_PD;
    qryGenDor.ParamByName('CODEMP').AsString := strEmp_PD;

    If Not blnUtiPen Then
    Begin
      qryGenDor.ParamByName('SEQIND').AsInteger := intInd_PD;
      qryGenDor.ParamByName('CODITE').AsString  := strCodIte;

      If Not fEmptyStr(strAutInc) Then
        qryGenDor.ParamByName('AUTINC').AsString := strAutInc;
    End;

    qryGenDor.ExecSQL;
  Finally
    FreeAndNil(qryGenDor)
  End;
end;

procedure TfrmCancelamentoDocumentos.pDesmarcarBaixaPedidoOrigem(strNumDoc,strEspDoc, strCodCli: String);
Var
  qryAux : TUniQuery;
begin
  If FblnCancelamentoAgrupamentoPedido Then
  Begin
    //PARA NÃO MATAR AS BAIXAS DO DOCUMENTO ORIGINAL
    If (fCampoTabela('FGO_ORIGEM', 'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'],
                                             [strNumDoc, strEspDoc, VS_strCodEmp]) <> 'AGRUPAMENTO') Then
    Begin
      Exit;
    End;
  End;

  qryAux := fCriaQuery(Self);
  Try
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Text :=  ' UPDATE TINDOR               '+
                        '    SET FDO_OPEBAI = NULL    '+
                        '      , FDO_DTABAI = NULL    '+
                        '      , FDO_HORBAI = NULL    '+
                        '      , FDO_BAIXAD = "N"     '+
                        '  WHERE FDO_NUMDOC = :NUMDOC '+
                        '    AND FDO_CODEMP = :CODEMP '+
                        '    AND FDO_ESPDOC = :ESPDOC '+
                        '    AND FDO_CODCLI = :CODCLI '+
                        '    AND FDO_IDEPRO <> "NOR"  ';

    qryAux.ParamByName('NUMDOC').Value := strNumDoc;
    qryAux.ParamByName('CODEMP').Value := VS_strCodEmp;
    qryAux.ParamByName('ESPDOC').Value := strEspDoc;
    qryAux.ParamByName('CODCLI').Value := strCodCli;
    qryAux.ExecSQL;
  Finally
    If Assigned(qryAux) Then
      FreeAndNil(qryAux);
  End;
end;

procedure TfrmCancelamentoDocumentos.edtCliForKeyPress(Sender: TObject;
  var Key: Char);
  Var
    blnNaoRecClienteGar: Boolean;
    strDocGarTmp: String;
begin
  inherited;
  If fEntraCons(Key) Then
  Begin
    If Pos(arrEspecies[intIndiceEsp][0],'ND_EL_NC_IC_OF_NP_EF_DC_') > 0 Then
    Begin
      If SameText(edtTipPes.Text, 'F') Then
        pBuscaFornecedor
      Else
        pBuscaCliente;
    End
    Else
    Begin
      blnNaoRecClienteGar := True;

      If Not fEmptyStr(edtNumDoc.Text) And (arrEspecies[intIndiceEsp][0] <> 'NE') Then
        blnNaoRecClienteGar := fPermiteCanRecClienteGar(arrEspecies[intIndiceEsp][0],
                                                        edtNumDoc.Text,
                                                        edtCliFor.Text,
                                                        strDocGarTmp);

      If (Pos(arrEspecies[intIndiceEsp][0], 'NE_NI_NG_NR_GR_GF_') > 0) And
         (blnNaoRecClienteGar) Then
        pBuscaFornecedor
      Else
        pBuscaCliente;
    End;

  End;

end;

