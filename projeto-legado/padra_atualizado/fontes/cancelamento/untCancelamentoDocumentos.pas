function TfrmCancelamentoDocumentos.fVerificarCadRecBaixado(strNumDoc,
  strEspDoc, strCliFor, strCodEmp: String): TStringList;
  Var
    qryAux: TUniQuery;
    strAutincMovGerFC: string;
begin
  Result := TStringList.Create;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  CTR_NUMDUP, ');
  qryAux.SQL.Add('  CTR_PARCEL, ');
  qryAux.SQL.Add('  CTR_ESPDOC, ');
  qryAux.SQL.Add('  CTR_CODEMP, ');
  qryAux.SQL.Add('  CTR_CODCLI  ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');
  if not fEmptyStr(strCliFor) then
    qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');
  qryAux.SQL.Add('  CTR_DTAREC IS NOT NULL   ');

  qryAux.ParamByName('NUMDUP').AsString := AnsiRightStr(strNumDoc, fTamDocCadRec());
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCodEmp;

  if not fEmptyStr(strCliFor) then
    qryAux.ParamByName('CODCLI').AsString := strCliFor;
  qryAux.Open;

  if qryAux.IsEmpty then
  begin
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT AUTOINCREM FROM MOVGER ');
    qryAux.SQL.Add('WHERE GER_NUMDOC = :NUMDOC');
    qryAux.SQL.Add('AND GER_ESPDOC = :ESPDOC');
    qryAux.SQL.Add('AND GER_CODEMP = :CODEMP');
    if not fEmptyStr(strCliFor) then
      qryAux.SQL.Add('AND GER_CODCLI = :CODCLI');

      qryAux.ParamByName('NUMDOC').AsString := AnsiRightStr(strNumDoc, fTamDocCadRec());
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    if not fEmptyStr(strCliFor) then
      qryAux.ParamByName('CODCLI').AsString := strCliFor;
    qryAux.Open;

    if not qryAux.IsEmpty then
    begin
      strAutincMovGerFC := qryAux.FieldByName('AUTOINCREM').AsString;
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT * FROM CADREC ');
      qryAux.SQL.Add('WHERE CTR_SEQFCO = :SEQFCO');

      qryAux.ParamByName('SEQFCO').AsString := strAutincMovGerFC;
      qryAux.Open;

      if not qryAux.IsEmpty then
      begin
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add('SELECT ');
        qryAux.SQL.Add('  CTR_NUMDUP, ');
        qryAux.SQL.Add('  CTR_PARCEL, ');
        qryAux.SQL.Add('  CTR_ESPDOC, ');
        qryAux.SQL.Add('  CTR_CODEMP, ');
        qryAux.SQL.Add('  CTR_CODCLI  ');
        qryAux.SQL.Add('FROM ');
        qryAux.SQL.Add('  CADREC ');
        qryAux.SQL.Add('WHERE ');
        qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
        qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
        qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');
        if not fEmptyStr(strCliFor) then
          qryAux.SQL.Add('  CTR_CODCLI = :CODCLI ');

        qryAux.ParamByName('NUMDUP').AsString := AnsiRightStr(strNumDoc, fTamDocCadRec());
        qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
        qryAux.ParamByName('CODEMP').AsString := strCodEmp;
        if not fEmptyStr(strCliFor) then
          qryAux.ParamByName('CODCLI').AsString := strCliFor;
        qryAux.Open;
      end;
    end;
  end;

  While (Not qryAux.Eof) Do
  Begin
    Result.Add(qryAux.FieldByName('CTR_NUMDUP').AsString +
               qryAux.FieldByName('CTR_PARCEL').AsString + ' - ' +
               qryAux.FieldByName('CTR_ESPDOC').AsString + ' Loja: ' +
               qryAux.FieldByName('CTR_CODEMP').AsString);
    qryAux.Next;
  End;

  qryAux.Close;
  FreeAndNil(qryAux);

end;

function TfrmCancelamentoDocumentos.fVerificarCadPagBaixado(strEspSel, strNumDoc,
  strEspDoc, strCliFor, strSerie: String): TStringList;
  Var
    qryAux: TUniQuery;
begin
  Result := TStringList.Create;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  CTP_NUMDUP, ');
  qryAux.SQL.Add('  CTP_PARCEL, ');
  qryAux.SQL.Add('  CTP_CODEMP, ');
  qryAux.SQL.Add('  CTP_CODFOR  ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADPAG ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTP_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTP_CODEMP = :CODEMP AND ');
  if (not fEmptyStr(strCliFor)) then
    qryAux.SQL.Add('  CTP_CODFOR = :CODFOR AND ');

  If (fEmptyStr(strSerie)) Then
    qryAux.SQL.Add('  ((CTP_SERIE_ IS NULL) OR (CTP_SERIE_ = "")) AND ')
  Else
    qryAux.SQL.Add('  CTP_SERIE_ = :SERIE AND ');

  qryAux.SQL.Add('  CTP_DTAPAG IS NOT NULL   ');

  If Pos(strEspSel, 'NE_') > 0 Then
    qryAux.SQL.Add('  AND CTP_PAGANT <> "S"  ');

  qryAux.ParamByName('NUMDUP').AsString := strNumDoc;
  qryAux.ParamByName('CODEMP').AsString := IIF(strEspDoc <> 'CT', VS_strCodEmp, strEmpCliCTe);

  If (Not fEmptyStr(strSerie)) Then
    qryAux.ParamByName('SERIE').AsString := strSerie;

  if (not fEmptyStr(strCliFor)) then
    qryAux.ParamByName('CODFOR').AsString := strCliFor;
  qryAux.Open;

  While (Not qryAux.Eof) Do
  Begin
    Result.Add(qryAux.FieldByName('CTP_NUMDUP').AsString +
               qryAux.FieldByName('CTP_PARCEL').AsString + ' Loja: ' +
               qryAux.FieldByName('CTP_CODEMP').AsString);
    qryAux.Next;
  End;

  qryAux.Close;
  FreeAndNil(qryAux);

end;

