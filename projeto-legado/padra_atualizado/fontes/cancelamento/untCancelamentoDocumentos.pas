          {** 07/08/2008 - 14:20 **************************MV*}
          blnTintaBaixaProduto := True;
          If (Assigned(fTintaBaixaProduto)) Then
          Begin
            If (Pos('TINDET', strArqDet) <= 0)                       And
               (FieldByName(strSigDet + 'IDEPRO').AsString <> 'NOR') And
