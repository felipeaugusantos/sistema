function TfrmCancelamentoDocumentos.fVerificaBaixaEmprestimoFF(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
Var
  qryBaiEmp: TUniQuery;
  strSQL   : String;
  blnGravou: Boolean;
begin

  blnGravou := True;
  Result    := False;

  Try
    qryBaiEmp := fCriaQuery;

    {*******************************************************}
    {* VERIFICA SE EXISTE BAIXA DE EMPRÉSTIMO PARA ESSA FF *}
    {****************************************************PZ*}
    strSQL := '';
    strSQL := strSQL + 'SELECT        ';
    strSQL := strSQL + '  DET_QTDITE, ';
    strSQL := strSQL + '  DET_KEY_EP, ';
    strSQL := strSQL + '  DET_NUMDOC  ';
    strSQL := strSQL + 'FROM          ';
    strSQL := strSQL + '  MOVDET      ';
    strSQL := strSQL + 'WHERE         ';
    strSQL := strSQL + '  DET_DOCFUT = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPFUT = :ESPDOC AND ';
    strSQL := strSQL + '  DET_EMPFUT = :CODEMP AND ';
    strSQL := strSQL + '  DET_CODCLI = :CODCLI     ';

    With qryBaiEmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      {**************}
      {* SE EXISTIR *}
      {***********PZ*}
      If (Not IsEmpty) Then
      Begin
        First;
        While Not Eof Do
        Begin
          {*********************************}
          {* ATUALIZA A QUANTIDADE BAIXADA *}
          {******************************PZ*}
          If (Not fCancelaQuantidadeEmprestimo(FieldByName('DET_QTDITE').AsFloat, FieldByName('DET_KEY_EP').AsString)) Then
          begin
            blnGravou := False;
            Break;
          end;

          Next;
        End;

        If (blnGravou) Then
        Begin
          {*********************************}
          {* CANCELA A BAIXA DE EMPRÉSTIMO *}
          {******************************PZ*}
          blnGravou := fCancelaItensDocumento('BE', FieldByName('DET_NUMDOC').AsString, strCodCli);
        End;
      End;
    End;

  Result := blnGravou;

  Except
    On E:Exception Do
      pMensagensErro(E.Message,'[TfrmCancelamentoDocumentos.fVerificaBaixaEmprestimoFF]');
  End;

  FreeAndNil(qryBaiEmp);
end;

function TfrmCancelamentoDocumentos.fVerificaContratoLocacaoEquipamentos(
  strNumDoc, strEspDoc, strCodCli: String): Boolean;
Var
  qryAux: TUniQuery;
  strMensagem: String;
begin
  Result := False;
  qryAux := fCriaQuery();
  Try
    With qryAux Do
    Begin
      SQL.Clear;
      SQL.Add('SELECT                           ');
      SQL.Add('  EQL_STATUS,                    ');
      SQL.Add('  EQL_NROCON,                    ');
      SQL.Add('  EQD_NUMRET,                    ');
      SQL.Add('  EQD_ESPRET,                    ');
      SQL.Add('  EQD_EMPRET,                    ');
      SQL.Add('  COUNT(F.AUTOINCREM) AS CNTFAT  ');
      SQL.Add('FROM                             ');
      SQL.Add('  CONEQL C                       ');
      SQL.Add('INNER JOIN EQLDET D              ');
      SQL.Add('  ON D.EQD_SEQCON = C.AUTOINCREM ');
      SQL.Add('LEFT JOIN EQLFAT F               ');
      SQL.Add('  ON F.EQF_SEQCON = C.AUTOINCREM ');
      SQL.Add('WHERE EQD_NUMENV = :NUMDOC       ');
      SQL.Add('  AND EQD_ESPENV = :ESPDOC       ');
      SQL.Add('  AND EQD_EMPENV = :EMPDOC       ');
      SQL.Add('  AND EQL_CODCLI = :CODCLI       ');
      SQL.Add('GROUP BY C.AUTOINCREM            ');

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('EMPDOC').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;

      Open;

      If Not IsEmpty Then
      Begin
        If FieldByName('CNTFAT').AsInteger > 0 Then
        Begin
          Result := True;
          strMensagem := 'Este documento é nota fiscal de envio de equipamento do contrato de locação número ' +
                         FieldByName('EQL_NROCON').AsString +
                         ' e este contrato já foi ' + IIF(FieldByName('EQL_STATUS').AsString = 'F', 'totalmente', 'parcialmente') + ' faturado' +
                         ', portanto este documento não pode ser cancelado.';
        End
        Else If FieldByName('EQD_NUMRET').AsString <> '' Then
        Begin
          Result := True;
          strMensagem := 'Este documento é nota fiscal de envio de equipamento do contrato de locação número ' +
                         FieldByName('EQL_NROCON').AsString +
                         ' e para este mesmo equipamento já foi informado o documento de retorno ' +
                         FieldByName('EQD_NUMRET').AsString + '-' + FieldByName('EQD_ESPRET').AsString + '-' + FieldByName('EQD_EMPRET').AsString +
                         ', portanto este documento não pode ser cancelado.';
        End;
      End
      Else
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT                           ');
        SQL.Add('  EQL_STATUS,                    ');
        SQL.Add('  EQL_NROCON                     ');
        SQL.Add('FROM                             ');
        SQL.Add('  CONEQL C                       ');
        SQL.Add('INNER JOIN EQLDET D              ');
        SQL.Add('  ON D.EQD_SEQCON = C.AUTOINCREM ');
        SQL.Add('WHERE EQD_NUMRET = :NUMDOC       ');
        SQL.Add('  AND EQD_ESPRET = :ESPDOC       ');
        SQL.Add('  AND EQD_EMPRET = :EMPDOC       ');
        SQL.Add('  AND EQL_CODCLI = :CODCLI       ');

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('EMPDOC').AsString := VS_strCodEmp;
        ParamByName('CODCLI').AsString := strCodCli;

        Open;

        If Not IsEmpty Then
        Begin
          If FieldByName('EQL_STATUS').AsString = 'F' Then
          Begin
            Result := True;
            strMensagem := 'Este documento é nota fiscal de retorno de equipamento do contrato de locação número ' +
                           FieldByName('EQL_NROCON').AsString +
                           ' e este contrato já foi totalmente faturado' +
                           ', portanto este documento não pode ser cancelado.';
          End;
        End
        Else
        Begin
          Close;
          SQL.Clear;
          SQL.Add('SELECT                                                                              ');
          SQL.Add('  O.EQL_NROCON,                                                                     ');
          SQL.Add('  F.EQF_NUMDOC,                                                                     ');
          SQL.Add('  F.EQF_ESPDOC,                                                                     ');
          SQL.Add('  F.EQF_EMPDOC,                                                                     ');
          SQL.Add('  F.EQF_SERDOC                                                                      ');
          SQL.Add('FROM                                                                                ');
          SQL.Add('  EQLFAT C                                                                          ');
          SQL.Add('INNER JOIN CONEQL O                                                                 ');
          SQL.Add('  ON O.AUTOINCREM = C.EQF_SEQCON                                                    ');
          SQL.Add('INNER JOIN EQLFAT F                                                                 ');
          SQL.Add('  ON F.EQF_SEQCON = C.EQF_SEQCON                                                    ');
          SQL.Add('  AND (                                                                             ');
          SQL.Add('    (                                                                               ');
          SQL.Add('      TIMESTAMP(F.EQF_DTAREF, F.EQF_HORREF) > TIMESTAMP(C.EQF_DTAREF, C.EQF_HORREF) ');
          SQL.Add('      AND F.EQF_NUMDOC <> :NUMDOC                                                   ');
          SQL.Add('      AND F.EQF_SEQEQL = C.EQF_SEQEQL                                               ');
          SQL.Add('    )                                                                               ');
          SQL.Add('    OR (                                                                            ');
          SQL.Add('      TIMESTAMP(F.EQF_DTAREF, F.EQF_HORREF) = TIMESTAMP(C.EQF_DTAREF, C.EQF_HORREF) ');
          SQL.Add('      AND F.AUTOINCREM > C.AUTOINCREM                                               ');
          SQL.Add('      AND F.EQF_NUMDOC <> :NUMDOC                                                   ');
          SQL.Add('      AND F.EQF_SEQEQL = C.EQF_SEQEQL                                               ');
          SQL.Add('      AND EQL_STATUS = "F"                                                          ');
          SQL.Add('    )                                                                               ');
          SQL.Add('  )                                                                                 ');
          SQL.Add('WHERE C.EQF_NUMDOC = :NUMDOC                                                        ');
          SQL.Add('  AND C.EQF_ESPDOC = :ESPDOC                                                        ');
          SQL.Add('  AND C.EQF_EMPDOC = :EMPDOC                                                        ');
          SQL.Add('  AND O.EQL_CODCLI = :CODCLI                                                        ');

          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspDoc;
          ParamByName('EMPDOC').AsString := VS_strCodEmp;
          ParamByName('CODCLI').AsString := strCodCli;

          Open;

          If Not IsEmpty Then
          Begin
            Result := True;
            strMensagem := 'Este documento é nota fiscal de faturamento do contrato de locação número ' +
                           FieldByName('EQL_NROCON').AsString +
                           ' e para este mesmo contrato já foi informado um outro faturamento posterior a este com número ' +
                           FieldByName('EQF_NUMDOC').AsString + '-' + FieldByName('EQF_ESPDOC').AsString + '-' + FieldByName('EQF_EMPDOC').AsString +
                           ', portanto este documento não pode ser cancelado.';
          End;
        End;
      End;
    End;

    If Result Then
      fMensagemCancelamento('', strMensagem);

  Finally
    FreeAndNil(qryAux);
  End;
end;

procedure TfrmCancelamentoDocumentos.pGravaDeletadosTributacoes(
  strAutoincrem, strTabela: String);
  Var
    qryAux: TUniQuery;
    strTabelaTri: String;
begin

  strTabelaTri := '';
  If Pos('MOVDET', strTabela) > 0 Then
    strTabelaTri := AnsiReplaceStr(strTabela, 'MOVDET', 'MOVTRI')
  Else If Pos('NOTDET', strTabela) > 0 Then
    strTabelaTri := AnsiReplaceStr(strTabela, 'NOTDET', 'NOTTRI');

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT * FROM ' + strTabelaTri + ' WHERE DET_SEQGER = :SEQGER ');
  qryAux.ParamByName('SEQGER').AsString := strAutoincrem;
  qryAux.Open;

  While (Not qryAux.Eof) Do
  Begin
    fVerificaIntegridade(Self.Name, strTabelaTri, qryAux, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

procedure TfrmCancelamentoDocumentos.pInsereLogFlxOS(strNumOSe, strCodEmp,
  strFlxFasAnt, strFlxSitAnt, strFlxComAnt, strFlxFas, strFlxSit,
  strFlxCom: String);
var
  qryLogFlx: TUniQuery;
begin
  qryLogFlx := fCriaQuery();

  try
    qryLogFlx.SQL.Add(' INSERT INTO LOGFLX ( ' +
                      '     AUTOINCREM, LOG_DTALOG, LOG_HORLOG, LOG_NUMOSE, ' +
                      '     LOG_CODEMP, LOG_CODOPE, LOG_CODDIG, LOG_FASANT, ' +
                      '     LOG_SITANT, LOG_COMANT, LOG_FASATU, LOG_SITATU, ' +
                      '     LOG_COMATU, LOG_EMPLOG, LOG_FLXLOG) ' +
                      ' VALUES ( ' +
                      '     :AUTOINCREM, :LOG_DTALOG, :LOG_HORLOG, :LOG_NUMOSE, ' +
                      '     :LOG_CODEMP, :LOG_CODOPE, :LOG_CODDIG, :LOG_FASANT, ' +
                      '     :LOG_SITANT, :LOG_COMANT, :LOG_FASATU, :LOG_SITATU, ' +
                      '     :LOG_COMATU, :LOG_EMPLOG, :LOG_FLXLOG)');
    qryLogFlx.ParamByName('AUTOINCREM').AsString   := fRetAutoIncrem('LOGFLX', strCodEmp);
    qryLogFlx.ParamByName('LOG_DTALOG').AsDate     := VS_Date;
    qryLogFlx.ParamByName('LOG_HORLOG').AsDateTime := fTime();
    qryLogFlx.ParamByName('LOG_NUMOSE').AsString   := strNumOSe;
    qryLogFlx.ParamByName('LOG_CODEMP').AsString   := strCodEmp;
    qryLogFlx.ParamByName('LOG_CODOPE').AsString   := strLoginUsuarioLogado;
    qryLogFlx.ParamByName('LOG_CODDIG').AsString   := strLoginUsuarioLogado;
    qryLogFlx.ParamByName('LOG_FASANT').AsString   := strFlxFasAnt;
    qryLogFlx.ParamByName('LOG_SITANT').AsString   := strFlxSitAnt;
    qryLogFlx.ParamByName('LOG_COMANT').AsString   := strFlxComAnt;
    qryLogFlx.ParamByName('LOG_FASATU').AsString   := strFlxFas;
    qryLogFlx.ParamByName('LOG_SITATU').AsString   := strFlxSit;
    qryLogFlx.ParamByName('LOG_COMATU').AsString   := strFlxCom;
    qryLogFlx.ParamByName('LOG_EMPLOG').AsString   := VS_strCodEmp;
    qryLogFlx.ParamByName('LOG_FLXLOG').AsString   := 'C';
    qryLogFlx.ExecSQL();
  finally
    FreeAndNil(qryLogFlx);
  end;
end;

function TfrmCancelamentoDocumentos.fPedidoFaturado(strNumDoc, strEspDoc, strCodEmp: String;
  strCodCli: String=''): TStatusPedido;
  Var
    qryAux: TUniQuery;

  function fSqlQtdAbe: String;
  Begin
    Result := '';
    Result := Result + ' (SELECT IF(SUM(FDO_QTDITE)-SUM(FDO_QTDBAI) < SUM(FDO_QTDITE), 1, 0) FROM FATDOR ';
    Result := Result + '   WHERE FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ';
    Result := Result + '     AND FDO_JAFATU = 0) ';
  End;

begin

  Result.blnFaturado := False;
  Result.blnParcial  := False;

  If Pos(strEspDoc, 'OR_PD_PR_') <= 0 Then
    Exit;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  FGO_JAFATU, '+fSqlQtdAbe+' AS FGO_ABERTO ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  FATGOR ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  FGO_CODEMP = :CODEMP     ');
  If Not fEmptyStr(strCodCli) Then
    qryAux.SQL.Add('AND FGO_CODCLI = :CODCLI ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCodEmp;
  If Not fEmptyStr(strCodCli) Then
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
  qryAux.Open;

  If Not qryAux.IsEmpty Then
  Begin
    Result.blnFaturado := (qryAux.FieldByName('FGO_JAFATU').AsInteger = 1);
    Result.blnParcial  := (qryAux.FieldByName('FGO_ABERTO').AsInteger > 0);
  End;

  FreeAndNil(qryAux);
end;

function TfrmCancelamentoDocumentos.fPedidoOrcamentoBaixado(strNumDoc, strEspDoc,
    strCodEmp, strCodCli: String): Boolean;
var
  qryAux : TUniQuery;
begin
  qryAux := fCriaQuery;

  try
    qryAux.SQL.Clear;
    qryAux.Close;
    qryAux.SQL.text := ' SELECT 1 FIRST ' +
                       '   FROM TINDOR ' +
                       '  WHERE FDO_NUMDOC = :NUMDOC'+
                       '    AND FDO_CODEMP = :CODEMP'+
                       '    AND FDO_CODCLI = :CODCLI'+
                       '    AND FDO_ESPDOC = :ESPDOC'+
                       '    AND FDO_BAIXAD = ''1''  ';

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;

    qryAux.Open;

    Result := not(qryAux.IsEmpty);
  finally
    FreeAndNil(qryAux);
  end;

end;

function TfrmCancelamentoDocumentos.fExisteNotaComplemento(strNumDoc,
  strSerie_, strCodCli: String): Boolean;
Var
  strSQL: String;
  qryGen: TUniQuery;
begin

  Try
    Result := False;

    qryGen := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADFIS ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FIS_NUMDOC =  :NUMDOC      AND ';
    strSQL := strSQL + '  FIS_ESPDOC IN ("NF","IF","EL") AND ';
    strSQL := strSQL + '  FIS_FORCLI =  :FORCLI      AND ';
    strSQL := strSQL + '  FIS_TIP_FC =  :TIP_FC      AND ';
    strSQL := strSQL + '  FIS_NFCOMP =  "S"          AND ';
    strSQL := strSQL + '  FIS_HISTOR <> "CANCELADO"  AND ';

    If fEmptyStr(strSerie_) Then
      strSQL := strSQL + '  ((FIS_SERIE_ IS NULL) OR (FIS_SERIE_ = "")) AND '
    Else
      strSQL := strSQL + '  FIS_SERIE_ = :SERIE_ AND ';

    strSQL := strSQL + '  FIS_CODEMP = :CODEMP ';

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('FORCLI').AsString := strCodCli;
      ParamByName('TIP_FC').AsString := edtTipPes.Text;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      If (Not fEmptyStr(strSerie_)) Then
        ParamByName('SERIE_').AsString := strSerie_;

      Open;

      Result := (Not IsEmpty);

    End;

  Finally
    FreeAndNil(qryGen);
  End;

end;

function TfrmCancelamentoDocumentos.fExisteParcelaBaixadaAgrupamentoFinanceiroDeConfirmacaoDeCupomFiscal(
  const strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.Close;
    qryConsulta.SQL.Text := 'SELECT U.AUTOINCREM FROM DUPAGR U '
                          + ' WHERE EXISTS(SELECT D.AUTOINCREM FROM MOVDET D '
                          + '               WHERE U.CTR_NUMDUP = D.DET_NUMDOC '
                          + '                 AND U.CTR_ESPDOC = D.DET_ESPDOC '
                          + '                 AND U.CTR_CODEMP = D.DET_CODEMP '
                          + '                 AND U.CTR_CODCLI = D.DET_CODCLI '
                          + '                 AND D.DET_NUMFAT = :NUMDOC '
                          + '                 AND D.DET_TIPFAT = :ESPDOC '
                          + '                 AND D.DET_CODEMP = :CODEMP) '
                          + '   AND EXISTS(SELECT C.AUTOINCREM FROM CADREC C '
                          + '               WHERE C.CTR_NUMDUP = U.CTR_NUMAGR '
                          + '                 AND C.CTR_ESPDOC = "AG" '
                          + '                 AND C.CTR_CODEMP = U.CTR_CODEMP '
                          + '                 AND C.CTR_CODCLI = U.CTR_CODCLI '
                          + '                 AND IFNULL(C.CTR_VALREC,0) > 0) ';

    qryConsulta.ParamByName('NUMDOC').AsString := strNumDoc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspDoc;
    qryConsulta.ParamByName('CODEMP').AsString := strCodEmp;
    qryConsulta.Open;

    Result := Not qryConsulta.IsEmpty;
  Finally
    FreeAndNil(qryConsulta);
  End;
end;

function TfrmCancelamentoDocumentos.fExistePedidoRetira(strNumDoc, strEspDoc, strCodEmp, strSerie_, strCliFor : String): Boolean;
  Var
    strSQL : String;
    qryTmp : TUniQuery;
begin

  strSQL := '';
  strSQL := strSQL + ' SELECT * ';
  strSQL := strSQL + '   FROM FATDOR ';
  strSQL := strSQL + '   INNER JOIN EXTDOR ON (EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM) ';
  strSQL := strSQL + '  WHERE FDO_ESPDOC = "PR" ';
  strSQL := strSQL + '    AND FDO_DOCDEV = :NUMDOC ';
  strSQL := strSQL + '    AND FDO_ESPDEV = :ESPDOC ';
  strSQL := strSQL + '    AND FDO_EMPDEV = :CODEMP ';

  strSQL := strSQL + '    AND FDO_INCDEV IN (SELECT AUTOINCREM ';
  strSQL := strSQL + '                        FROM MOVDET ';
  strSQL := strSQL + '                       WHERE DET_NUMDOC = :NUMDOC ';
  strSQL := strSQL + '                         AND DET_ESPDOC = :ESPDOC ';

  If Not strSerie_.IsEmpty Then
    strSQL := strSQL + '                       AND DET_SERIE_ = :SERIE_ ';

  strSQL := strSQL + '                         AND DET_'+IIF(edtTipPes.Text = 'C', 'CODCLI', 'CODFOR')+' = :CLIFOR ';
  strSQL := strSQL + '                         AND DET_CODEMP = :CODEMP ';

  strSQL := strSQL + '                         UNION ';

  strSQL := strSQL + '                       SELECT AUTOINCREM ';
  strSQL := strSQL + '                        FROM NOTDET ';
  strSQL := strSQL + '                       WHERE DET_NUMDOC = :NUMDOC  ';
  strSQL := strSQL + '                         AND DET_ESPDOC = :ESPDOC  ';

  If Not strSerie_.IsEmpty Then
    strSQL := strSQL + '                       AND DET_SERIE_ = :SERIE_  ';

  strSQL := strSQL + '                         AND DET_'+IIF(edtTipPes.Text = 'C', 'CODCLI', 'CODFOR')+' = :CLIFOR  ';
  strSQL := strSQL + '                         AND DET_CODEMP = :CODEMP) ';

  qryTmp := fCriaQuery(Self);

  Try

    qryTmp.SQL.Clear;
    qryTmp.SQL.Add(strSQL);
    qryTmp.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTmp.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTmp.ParamByName('CODEMP').AsString := strCodEmp;

    If Not strSerie_.IsEmpty Then
      qryTmp.ParamByName('SERIE_').AsString := strSerie_;

    qryTmp.ParamByName('CLIFOR').AsString := strCliFor;
    qryTmp.Open;

    Result := (qryTmp.RecordCount > 0);

  Finally
    FreeAndNil(qryTmp);
  End;

end;

procedure TfrmCancelamentoDocumentos.pDesfaturaItensPedidoOriginalParaGerarPedidoReserva(
  const strNumDoc, strEspDoc, strCodCli: String);
  Var
    qryMovDet: TUniQuery;
    blnUtiPen: Boolean;
    strInc_Pd: String;
begin
  qryMovDet := fCriaQuery;
  Try
    qryMovDet.SQL.Add('SELECT DET_NUM_PD, DET_ESP_PD, DET_EMP_PD, DET_IND_PD,');
    qryMovDet.SQL.Add('       DET_CODITE, DET_QTDITE, DET_DESESP, DET_INC_PD');
    qryMovDet.SQL.Add('FROM MOVDET');
    qryMovDet.SQL.Add('LEFT JOIN MOVAUX ON MOVAUX.DET_SEQGER = MOVDET.AUTOINCREM');
    qryMovDet.SQL.Add('WHERE DET_NUMDOC = :NUMDOC');
    qryMovDet.SQL.Add('  AND DET_ESPDOC = :ESPDOC');
    qryMovDet.SQL.Add('  AND DET_CODEMP = :CODEMP');
    qryMovDet.SQL.Add('  AND DET_CODCLI = :CODCLI');

    qryMovDet.ParamByName('NUMDOC').AsString := strNumDoc;
    qryMovDet.ParamByName('ESPDOC').AsString := strEspDoc;
    qryMovDet.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryMovDet.ParamByName('CODCLI').AsString := strCodCli;
    qryMovDet.Open;

    qryMovDet.First;
    While Not qryMovDet.Eof Do
    Begin
      If qryMovDet.FieldByName('DET_ESP_PD').AsString = 'PD' Then
      Begin
        blnUtiPen := fPedidoUtiPen(qryMovDet.FieldByName('DET_NUM_PD').AsString,
                                   qryMovDet.FieldByName('DET_ESP_PD').AsString,
                                   qryMovDet.FieldByName('DET_EMP_PD').AsString);

        strInc_Pd := qryMovDet.FieldByName('DET_INC_PD').AsString;
        If Length(strInc_Pd) <> 20 Then
          strInc_Pd := '';

        pDesfaturaItemPedidoOriginal(
          qryMovDet.FieldByName('DET_NUM_PD').AsString,
          qryMovDet.FieldByName('DET_ESP_PD').AsString,
          qryMovDet.FieldByName('DET_EMP_PD').AsString,
          qryMovDet.FieldByName('DET_CODITE').AsString,
          qryMovDet.FieldByName('DET_QTDITE').AsFloat,
          qryMovDet.FieldByName('DET_DESESP').AsFloat,
          qryMovDet.FieldByName('DET_IND_PD').AsInteger,
          blnUtiPen,
          strInc_Pd,
          False);
      End;

      qryMovDet.Next;
    End;
  Finally
    FreeAndNil(qryMovDet);
  End;
end;

function TfrmCancelamentoDocumentos.fGeraPedidoReservaEstoqueEnderecamentoPedidoOriginal(const ANumDocSel, AEspDocSel: String): Boolean;
  Var
    intIdx: Integer;
begin
  Result := True;

  For intIdx := Low(ArrayPedidos) To High(ArrayPedidos) Do
  Begin
    If ArrayPedidos[intIdx].strEspPed <> 'PD' Then
      Continue;

    Result := Result And
      fGerarPedidoReservaEstoqueParaEnderecamentoProdutosSeparados(
        ArrayPedidos[intIdx].strNumPed,
        ArrayPedidos[intIdx].strEspPed,
        ArrayPedidos[intIdx].strEmpPed,
        False,
        True,
        ANumDocSel,
        AEspDocSel);
  End;
end;

function TfrmCancelamentoDocumentos.fGetEspSel: String;
begin
  Result := arrEspecies[intIndiceEsp][0];
end;

function TfrmCancelamentoDocumentos.fGetIndexByEspecie(
