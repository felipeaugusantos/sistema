function TfrmCancelamentoDocumentos.fCancelaGNRE(strEspDoc, strNumDoc, strCliFor, strSerie: String; TipoGuia: TTipoGuia = tgGNRE): Boolean;
  Var
    qryGenTmp: TUniQuery;
    strSQL: String;
begin
  qryGenTmp := fCriaQuery(Self);

  Try
    Result := True;

    strSQL := '';
    strSQL := strSQL + 'DELETE FROM  ';
    case TipoGuia of
      tgGNRE: strSQL := strSQL + ' CADGNR ';
      tgTCIF: strSQL := strSQL + ' GNRTCI ';
      tgTS  : strSQL := strSQL + ' GNR_TS ';
    end;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GNR_NUMDOC = :NUMDUP AND ';
    strSQL := strSQL + '  GNR_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  GNR_FORDOC = :CODFOR AND ';

    If (fEmptyStr(strSerie)) Then
      strSQL := strSQL + '((GNR_SERIE_ IS NULL) OR (GNR_SERIE_ = "")) '
    Else
      strSQL := strSQL + 'GNR_SERIE_ = :SERIE_ ';

    With qryGenTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDUP').AsString := strNumDoc;
      ParamByName('CODFOR').AsString := strCliFor;
      If (Not fEmptyStr(strSerie)) Then
        ParamByName('SERIE_').AsString := strSerie;

      ParamByName('CODEMP').AsString := VS_strCodEmp;

      ExecSQL;
    End;

  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaGNRE]');
      Result := False;
    End;
  End;

  FreeAndNil(qryGenTmp);

end;


function TfrmCancelamentoDocumentos.fCtpBaixadaParcial(
  qryCadPag: TUniQuery): Boolean;
  Var
    strNumDup: String;
    strParcel: String;
    intQtdDup: Integer;
begin

  Result := False;

  intQtdDup := 0;
  strNumDup := qryCadPag.FieldByName('CTP_NUMDUP').AsString;
  strParcel := qryCadPag.FieldByName('CTP_PARCEL').AsString;

  While (Not qryCadPag.Eof)                                        And
        (qryCadPag.FieldByName('CTP_NUMDUP').AsString = strNumDup) And
        (qryCadPag.FieldByName('CTP_PARCEL').AsString = strParcel) Do
  Begin
    If Not fEmptyStr(qryCadPag.FieldByName('CTP_DTAPAG').AsString) Then
      Inc(intQtdDup);

    qryCadPag.Next;
  End;

  {*******************************************}
  {* CASO SEJA FIM DE ARQUIVO, NÃO RETROCEDE *}
  {* O REGISTRO                              *}
  {****************************************MV*}
  If (Not qryCadPag.Eof) Then
    qryCadPag.Prior;

  If (intQtdDup > 1) Then
    Result := True;

end;

function TfrmCancelamentoDocumentos.fTemConhecimentoVariasNotas(    strEspSel, strNumDoc, strCliFor, strSerie: String;
                                                                Var strSeqFis, strCadFis, strNotas: String): Boolean;
  Var
    qryGenFis: TUniQuery;
    stlNotas,
    stlCadFis: TStringList;
    intIndice: Integer;
Begin
  Try
    strNotas  := '';
    strCadFis := '';
    strSeqFis := '';
    Result    := False;

    stlNotas  := TStringList.Create;
    stlNotas.Sorted := True;

    stlCadFis := TStringList.Create;

    qryGenFis := fCriaQuery;
    With qryGenFis Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT GROUP_CONCAT(CON_SEQFIS) AS SEQFIS FROM MOVGER G');
      SQL.Add('INNER JOIN CONFRE ON CON_SEQGER = G.AUTOINCREM ');
      SQL.Add('WHERE');
      SQL.Add('  GER_NUMDOC = :NUMDOC AND ');
      SQL.Add('  GER_ESPDOC = :ESPDOC AND ');
      SQL.Add('  GER_CODEMP = :CODEMP AND ');
      SQL.Add('  GER_CODFOR = :CODFOR AND ');
      SQL.Add('  IFNULL(GER_SERIE_, "") = :SERIE_ ');
      SQL.Add('  HAVING SEQFIS IS NOT NULL ');
      SQL.Add('  UNION ALL ');
      SQL.Add('SELECT GROUP_CONCAT(REC_CTESEQ) AS SEQFIS FROM MOVGER G');
      SQL.Add('INNER JOIN RECTNF ON REC_MOVSEQ = G.AUTOINCREM ');
      SQL.Add('WHERE');
      SQL.Add('  GER_NUMDOC = :NUMDOC AND ');
      SQL.Add('  GER_ESPDOC = :ESPDOC AND ');
      SQL.Add('  GER_CODEMP = :CODEMP AND ');
      SQL.Add('  GER_CODFOR = :CODFOR AND ');
      SQL.Add('  IFNULL(GER_SERIE_, "") = :SERIE_ ');
      SQL.Add('  HAVING SEQFIS IS NOT NULL ');


      ParamByName('NUMDOC').AsString :=  strNumDoc;
      ParamByName('ESPDOC').AsString :=  strEspSel;
      ParamByName('SERIE_').AsString :=  strSerie;
      ParamByName('CODEMP').AsString :=  VS_strCodEmp;
      ParamByName('CODFOR').AsString :=  strCliFor;

      Open;

      If (Not IsEmpty) And (Not FieldByName('SEQFIS').IsNull) Then
      Begin
        stlCadFis.CommaText := FieldByName('SEQFIS').AsString;

        For intIndice := 0 To stlCadFis.Count - 1 Do
          stlCadFis[intIndice] := QuotedStr(stlCadFis[intIndice]);

        strSeqFis := stlCadFis.CommaText;

        stlCadFis.Sorted := True;

        Close;
        SQL.Clear;
        SQL.Add('SELECT ');
        SQL.Add('  CONCAT(GER_ESPDOC, "-", GER_NUMDOC, "-", GER_CODEMP, "-", IFNULL(GER_SERIE_, "")) AS NUMDOC, ');
        SQL.Add('  CONCAT(FIS_ESPDOC, "-", FIS_NUMDOC, "-", FIS_CODEMP, "-", IFNULL(FIS_SERIE_, "")) AS NUMFIS  ');
        SQL.Add('FROM CONFRE ');
        SQL.Add('INNER JOIN MOVGER G ON G.AUTOINCREM = CON_SEQGER ');
        SQL.Add('INNER JOIN CADFIS F ON F.AUTOINCREM = CON_SEQFIS ');
        SQL.Add('WHERE');
        SQL.Add('  CON_SEQFIS IN (' + strSeqFis + ')');
        SQL.Add('  UNION ALL ');
        SQL.Add('SELECT ');
        SQL.Add('  CONCAT(GER_ESPDOC, "-", GER_NUMDOC, "-", GER_CODEMP, "-", IFNULL(GER_SERIE_, "")) AS NUMDOC, ');
        SQL.Add('  CONCAT(FIS_ESPDOC, "-", FIS_NUMDOC, "-", FIS_CODEMP, "-", IFNULL(FIS_SERIE_, "")) AS NUMFIS  ');
        SQL.Add('FROM RECTNF ');
        SQL.Add('INNER JOIN MOVGER G ON G.AUTOINCREM = REC_MOVSEQ ');
        SQL.Add('INNER JOIN CADFIS F ON F.AUTOINCREM = REC_CTESEQ ');
        SQL.Add('WHERE');
        SQL.Add('  REC_CTESEQ IN (' + strSeqFis + ')');

        Open;

        If (Not IsEmpty) Then
        Begin

          stlNotas.Clear;
          stlCadFis.Clear;

          While Not Eof Do
          Begin

            If Not stlNotas.Find(FieldByName('NUMDOC').AsString, intIndice) Then
              stlNotas.Add(FieldByName('NUMDOC').AsString);

            If Not stlCadFis.Find(FieldByName('NUMDOC').AsString, intIndice) Then
              stlCadFis.Add(FieldByName('NUMFIS').AsString);

            Next;

          End;

          strNotas  := stlNotas.CommaText;
          strCadFis := stlCadFis.CommaText;

          Result := stlNotas.Count > 1;

        End;

      End Else
      Begin

        Result := False;

      End;

      Close;
    End;

    FreeAndNil(qryGenFis);
    FreeAndNil(stlNotas);
    FreeAndNil(stlCadFis);

  Except
    On E: Exception Do
    Begin
      Raise Exception.Create(E.Message);
    End;
  End;
End;

function TfrmCancelamentoDocumentos.fTemItemServicoNaNotaDeEntrada(ANumDoc, ACodEmp, AFornec, ASerie, AEspDoc: String): Boolean;
var qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.SQL.Add('SELECT COUNT(1) QTD FROM DEL_MOVDET');
    qryConsulta.SQL.Add(' WHERE DET_NUMDOC = "' + ANumDoc + '"');
    qryConsulta.SQL.Add('   AND DET_CODEMP = "' + ACodEmp + '"');
    qryConsulta.SQL.Add('   AND DET_CODFOR = "' + AFornec + '"');
    qryConsulta.SQL.Add('   AND IFNULL(DET_SERIE_, "") = "' + ASerie + '"');
    qryConsulta.SQL.Add('   AND DET_ESPDOC = "' + AEspDoc + '"');
    qryConsulta.SQL.Add('   AND RIGHT(DET_CLAFIS, 3)= "933"');
    qryConsulta.Open;
    Result := (qryConsulta.FieldByName('QTD').AsInteger > 0);
  Finally
    FreeAndNil(qryConsulta);
  End;
end;


function TfrmCancelamentoDocumentos.fCancelaConhecimentoDeFreteVariasNotas(strEspSel, strNumDoc, strCliFor, strSerie: String): Boolean;
  Var
    strNotas,
    strCadFis,
    strSeqFis,
    strAutInc: String;

    qryCadFis: TUniQuery;
Begin
  Try
    Result := True;

    If Not fTemConhecimentoVariasNotas(strEspSel, strNumDoc, strCliFor, strSerie, strSeqFis, strCadFis, strNotas) Then
    Begin
      if fEmptyStr(strSeqFis) then
        Exit;

      qryCadFis := fCriaQuery(Self);

      With qryCadFis, SQL Do
      Begin
        Add('SELECT');
        Add('  FIS_NUMDOC, ');
        Add('  FIS_ESPDOC, ');
        Add('  FIS_FORCLI, ');
        Add('  FIS_SERIE_  ');
        Add('FROM          ');
        Add('  CADFIS      ');
        Add('WHERE         ');
        Add('  AUTOINCREM IN (' + strSeqFis + ')');

        Open;

        While Not Eof Do
        Begin
          Result := fCancelaLivroFiscal(FieldByName('FIS_ESPDOC').AsString,
                                        FieldByName('FIS_NUMDOC').AsString,
                                        FieldByName('FIS_FORCLI').AsString,
                                        FieldByName('FIS_SERIE_').AsString,
                                        strAutInc);

          Result := Result And
                    fCancelaContasPagarCFr(FieldByName('FIS_ESPDOC').AsString,
                                           FieldByName('FIS_NUMDOC').AsString,
                                           FieldByName('FIS_FORCLI').AsString,
                                           FieldByName('FIS_SERIE_').AsString);

          Result := Result And
                    fCancelaContasPagarIcmsAntecipadoVendor(FieldByName('FIS_ESPDOC').AsString,
                                                            FieldByName('FIS_NUMDOC').AsString,
                                                            FieldByName('FIS_FORCLI').AsString,
                                                            FieldByName('FIS_SERIE_').AsString);


          If Not Result Then
            Break;

          Next;
        End;

      End;

      FreeAndNil(qryCadFis);
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fCancelaConhecimentoDeFreteVariasNotas]');
    End;
  End;
End;

function TfrmCancelamentoDocumentos.fEhNotaEspecialDeFornecedor: Boolean;
begin
  Result := False;

  If not (arrEspecies[intIndiceEsp][0] = 'NP') Then
    Exit;

  If not (edtTipPes.Text = 'F') Then
    Exit;

  Result := True;
end;

function TfrmCancelamentoDocumentos.fCancelaLivroFiscal(strEspSel,
  strNumDoc, strCliFor, strSerie: String; Var strAutInc: String): Boolean;
  Var
    arrEntSai     : Array Of String;
    intContador1  : Integer;
    intContador2  : Integer;
    strSigForCli  : String;
    intRecordCount: Integer;

    strSQL   : String;
    strDocDel: String;
    qryGenFis: TUniQuery;
    strOriDoc: String;
    blnDifChvAcesso : Boolean;
    blnAchouRegistro : Boolean;
    qryFisRef: TUniQuery;
begin
  qryGenFis := fCriaQuery(Self);

  strDocDel := '';
//  If (strEspSel = 'NE') Then
  If (Pos(arrEspecies[intIndiceEsp][0], 'NE_NI_OF_NG_NR_EF_') > 0) Then
  Begin
    SetLength(arrEntSai, 2);
    arrEntSai[0] := 'S';
    arrEntSai[1] := 'E';
    strSigForCli := 'F';
  End
  Else If fEhNotaEspecialDeFornecedor Then
  Begin
    If fEmptyStr(strSerie) And (Not edtSerie.Visible) Then
      strSerie := strSerFsc;

    SetLength(arrEntSai, 2);
    arrEntSai[0] := 'S';
    arrEntSai[1] := 'E';
    strSigForCli := 'F';
  End
  Else
  Begin
    If fEmptyStr(strSerie) And (Not edtSerie.Visible) Then
      strSerie := strSerFsc;

    SetLength(arrEntSai, 2);
    arrEntSai[0] := 'S';
    arrEntSai[1] := 'E';
    strSigForCli := 'C';
  End;

  If edtTipPes.Visible Then
    strSigForCli := edtTipPes.Text;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  * ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADFIS ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  FIS_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  FIS_ENTSAI = :ENTSAI AND ';
  strSQL := strSQL + '  FIS_FORCLI = :FORCLI AND ';
  strSQL := strSQL + '  FIS_TIP_FC = :TIP_FC AND ';
  strSQL := strSQL + '  FIS_ESPDOC = :ESPDOC AND ';

  If fEmptyStr(strSerie) Then
    strSQL := strSQL + '  ((FIS_SERIE_ IS NULL) OR (FIS_SERIE_ = "")) AND '
  Else
    strSQL := strSQL + '  FIS_SERIE_ = :SERIE AND ';

  strSQL := strSQL + '  FIS_CODEMP = :CODEMP ';

  Try

    Result := True;

    For intContador1 := 0 To Length(arrEntSai) -1 Do
    Begin

      With qryTemp01 Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ENTSAI').AsString := arrEntSai[intContador1];
        ParamByName('FORCLI').AsString := strCliFor;
        ParamByName('TIP_FC').AsString := strSigForCli;
        ParamByName('ESPDOC').AsString := strEspSel;

        If Not fEmptyStr(strSerie) Then
          ParamByName('SERIE').AsString := strSerie;

        ParamByName('CODEMP').AsString := VS_strCodEmp;
        Open;

        If (Not IsEmpty) Then
        Begin
          pRemoveRegistroContabilidade(strNumDoc, strCliFor, strSigForCli, strEspSel,
                                       strSerie, VS_strCodEmp, qryTemp01.FieldByName('FIS_CLFSC1').AsString,
                                       qryTemp01.FieldByName('AUTOINCREM').AsString);

          intRecordCount := RecordCount;

          strAutInc := FieldByName('AUTOINCREM').AsString;

          While (Not Eof)                                                      And
                (FieldByName('FIS_NUMDOC').AsString = strNumDoc)               And
                (FieldByName('FIS_ENTSAI').AsString = arrEntSai[intContador1]) And
                (FieldByName('FIS_FORCLI').AsString = strCliFor)               And
                (FieldByName('FIS_TIP_FC').AsString = strSigForCli)            And
                (FieldByName('FIS_SERIE_').AsString = strSerie)                And
                (FieldByName('FIS_CODEMP').AsString = VS_strCodEmp)            Do
          Begin

            strOriDoc := fRetDocOri(blnAchouRegistro, strNumDoc, strSigForCli, strSerie, VS_strCodEmp, strCliFor, False, strEspSel);

            {*******************************************}
            {* GRAVA NOS ARQUIVOS DELETADOS            *}
            {****************************************MV*}
            fVerificaIntegridade(Self.Name, 'CADFIS', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);

            {Nota com FISREF nao restaura preco medio/ultima compra. A FISREF e apagada
             por cascade junto com a CADFIS, entao a verificacao e feita antes do DELETE.
             Verificar Nota 1 - Req. 468332}
            qryFisRef := fCriaQuery(Self);
            Try
              qryFisRef.SQL.Text := 'SELECT 1 FROM FISREF WHERE FIS_SEQFIS = :SEQFIS LIMIT 1';
              qryFisRef.ParamByName('SEQFIS').AsString := FieldByName('AUTOINCREM').AsString;
              qryFisRef.Open;
              If Not qryFisRef.IsEmpty Then
                FblnNotaComFisRef := True;
            Finally
              FreeAndNil(qryFisRef);
            End;

            {*******************************************}
            {* SE FOR FORNECEDOR, DELETA               *}
            {****************************************MV*}
            {* SE FOR CLIENTE TBM DELETA  - DEVOLUÇÃO  *}
            {****************************************GB*}
//            If (strSigForCli = 'F') And (strOriDoc <> 'V') And (arrEspecies[intIndiceEsp][0] <> 'NC') Then
            If (blnAchouRegistro) And (strOriDoc <> 'V') And (pos(arrEspecies[intIndiceEsp][0], 'NC_IC_DC_') = 0) Then
            Begin

              If (chkInutilizacao.Checked) Then
              Begin
                pAtualizaStatusNfe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), 'IN');
              End;

              If fEmptyStr(strSerie) Then
              Begin
                strDocDel := strDocDel + ' ( FIS_NUMDOC = ' + QuotedStr(FieldByName('FIS_NUMDOC').AsString) + ' AND ' +
                                         '   FIS_ENTSAI = ' + QuotedStr(FieldByName('FIS_ENTSAI').AsString) + ' AND ' +
                                         '   FIS_FORCLI = ' + QuotedStr(FieldByName('FIS_FORCLI').AsString) + ' AND ' +
                                         '   FIS_TIP_FC = ' + QuotedStr(FieldByName('FIS_TIP_FC').AsString) + ' AND ' +
                                         '   FIS_CODEMP = ' + QuotedStr(FieldByName('FIS_CODEMP').AsString) + ' ) ';
              End
              Else
              Begin
                strDocDel := strDocDel + ' ( FIS_NUMDOC = ' + QuotedStr(FieldByName('FIS_NUMDOC').AsString) + ' AND ' +
                                         '   FIS_ENTSAI = ' + QuotedStr(FieldByName('FIS_ENTSAI').AsString) + ' AND ' +
                                         '   FIS_FORCLI = ' + QuotedStr(FieldByName('FIS_FORCLI').AsString) + ' AND ' +
                                         '   FIS_TIP_FC = ' + QuotedStr(FieldByName('FIS_TIP_FC').AsString) + ' AND ' +
                                         '   FIS_SERIE_ = ' + QuotedStr(FieldByName('FIS_SERIE_').AsString) + ' AND ' +
                                         '   FIS_CODEMP = ' + QuotedStr(FieldByName('FIS_CODEMP').AsString) + ' ) ';
              End;

              If (RecNo < intRecordCount) Then
                strDocDel := strDocDel + ' OR ';

            End
            Else
            Begin

              {*******************************************}
              {* SE FOR CLIENTE, LIMPA OS VALORES        *}
              {****************************************MV*}

              If (FieldByName('FIS_HISTOR').AsString <> 'CANCELADO') Then
              Begin
                Edit;
                FieldByName('FIS_HISTOR').AsString := 'CANCELADO';
                FieldByName('FIS_SITCAN').AsString := 'CA';

                If (chkInutilizacao.Checked) Then
                Begin
                  FieldByName('FIS_HISTOR').AsString := 'INUTILIZADO';
                  FieldByName('FIS_SITCAN').AsString := 'IN';
                  pAtualizaStatusNfe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), 'IN');
                End
                Else If (fNotaFiscalDenegada(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'))) or
                        (FblnDenegandoViaFulFillment) Then
                Begin
                  FieldByName('FIS_HISTOR').AsString := 'DENEGADA';
                  FieldByName('FIS_SITCAN').AsString := 'DE';
                  pAtualizaStatusNfe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), 'DC'); //Denegada cancelada
                End
                Else If fStatusNFe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), blnDifChvAcesso) = 'EE' Then
                Begin
                  pAtualizaStatusNfe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), 'CN');
                End;

                FieldByName('FIS_BASPIS').Value := Null;
                FieldByName('FIS_ALQPIS').Value := Null;
                FieldByName('FIS_TOTPIS').Value := Null;

                FieldByName('FIS_BASCOF').Value := Null;
                FieldByName('FIS_ALQCOF').Value := Null;
                FieldByName('FIS_TOTCOF').Value := Null;

                FieldByName('FIS_BASISS').Value := Null;
                FieldByName('FIS_ALQISS').Value := Null;
                FieldByName('FIS_VALISS').Value := Null;

                FieldByName('FIS_ALQFCP').Value := Null;

                For intContador2 := 1 To 5 Do
                Begin
                  FieldByName('FIS_VLCON' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_BASIC' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_ALQIC' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_VLRIC' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_OUTRA' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_ISENT' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_RETID' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_BASIP' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_VLRIP' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_BCRET' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_DACES' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_VALIS' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_VFCPS' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_BFCPS' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_BAFCP' + IntToStr(intContador2)).Value := Null;
                  FieldByName('FIS_VLFCP' + IntToStr(intContador2)).Value := Null;
                End;
                Post;
                Result := True;
              End
              Else If (FieldByName('FIS_HISTOR').AsString = 'CANCELADO') Then
              Begin
                Result := True;
              End
              Else
                Result := False;

            End;

            Next;

          End;

          {*******************************************}
          {* DELETA REGISTROS DO DOMACU              *}
          {****************************************NC*}
          If fCfgSis('UTIACU', varBoolean) Then
          Begin
            If (Not fEmptyStr(strAutInc)) Then
            Begin

              With qryGenFis Do
              Begin
                Close;
                SQL.Clear;
                SQL.Add('DELETE FROM DOMACU WHERE ACU_SEQFIS = ' + strAutInc);
                ExecSQL;
                Close;
              End;

            End;
          End;
        End;

        Close;

      End;

    End;

    {*******************************************}
    {* DELETA REGISTROS DO LIVRO               *}
    {****************************************MV*}
    If (Not fEmptyStr(strDocDel)) Then
    Begin

      With qryGenFis Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('DELETE FROM CADFIS WHERE ' + strDocDel);
        ExecSQL;
        Result := (RowsAffected > 0);
        Close;
      End;

    End;
    imgLivroFiscal.Picture := imgAlterado.Picture;

  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaLivroFiscal]');
      Result := False;
    End;
  End;

  FreeAndNil(qryGenFis);

end;

function TfrmCancelamentoDocumentos.fMarcarNFeComoCancelada(const strNumDoc, strEspDoc, strCodEmp, strCodCli: String; const strSerie : String = ''): Boolean;
  Var
    strSQL: String;
    qryGen: TUniQuery;
begin
  Result := True;

  strSQL := '';
  strSQL := strSQL + ' UPDATE ';
  strSQL := strSQL + '   LOGNFE';
  strSQL := strSQL + ' SET ';
  strSQL := strSQL + '   NFE_STATUS = "CN" ';
  strSQL := strSQL + ' WHERE NFE_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '       NFE_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '       NFE_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '       NFE_CODEMP = :CODEMP ';

  If (Not fEmptyStr(strSerie)) Then
    strSQL := strSQL + ' AND IFNULL(NFE_SERIE_, "") = :SERIE_ ';

  qryGen := fCriaQuery(Nil);
  Try
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strSQL);
    qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
    qryGen.ParamByName('ESPDOC').AsString := strEspDoc;
    qryGen.ParamByName('CODCLI').AsString := strCodCli;
    qryGen.ParamByName('CODEMP').AsString := strCodEmp;
    If (Not fEmptyStr(strSerie)) Then
      qryGen.ParamByName('SERIE_').AsString := strSerie;
    qryGen.ExecSQL;
  Finally
    FreeAndNil(qryGen);
  End;
end;

function TfrmCancelamentoDocumentos.fVerificaDocumentoConfirmado(strEspSel,
  strNumDoc, strCliFor: String): Boolean;
  Var
    strSQL   : String;
    qryGenGer: TUniQuery;

begin
  Try

    Result := False;

    qryGenGer := fCriaQuery(Self);

    If (Pos(strEspSel, 'TR_DV_MI_FF_PI_TE_IF_IV_D1_' + IIF(MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL,J_A_MASSA_CONCRETO]), 'NF_', '')) <= 0) Then
    Begin
      Exit;
    End;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVGER ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  GER_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  GER_CODEMP = :CODEMP ';

    With qryGenGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      If (Not IsEmpty) Then
      Begin
        If FieldByName('GER_JAFATU').DataType = ftInteger Then
        begin
          If FieldByName('GER_JAFATU').AsInteger = 1 Then
            Result := True;
        end
        else
        begin
          If FieldByName('GER_JAFATU').AsBoolean Then
            Result := True;
        end;
      End;

      If (Result) Then
      Begin
        fMensagemCancelamento('', 'A ' + strEspSel + ' informada foi confirmada em outro documento: ' +
                      FieldByName('GER_NUMFAT').AsString + '-' + FieldByName('GER_TIPFAT').AsString + '.' + #13#10 +
                      'Cancele primeiro o documento no qual ela foi confirmada!', ['&Ok']);
      End Else
      Begin
        strSQL := '';
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  * ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL + '  NOTGER ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  GER_CODCLI = :CODCLI AND ';
        strSQL := strSQL + '  GER_CODEMP = :CODEMP ';

        With qryGenGer Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspSel;
          ParamByName('CODCLI').AsString := strCliFor;
          ParamByName('CODEMP').AsString := VS_strCodEmp;
          Open;

          If (Not IsEmpty) Then
          Begin
            If FieldByName('GER_JAFATU').DataType = ftInteger Then
            begin
              If FieldByName('GER_JAFATU').AsInteger = 1 Then
                Result := True;
            end
            else
            begin
              If FieldByName('GER_JAFATU').AsBoolean Then
                Result := True;
            end;
          End;

          If (Result) Then
          Begin
            fMensagemCancelamento('', 'A ' + strEspSel + ' informada foi confirmada em outro documento: ' +
                          FieldByName('GER_NUMFAT').AsString + '-' + FieldByName('GER_TIPFAT').AsString + '.' + #13#10 +
                          'Cancele primeiro o documento no qual ela foi confirmada!', ['&Ok']);
          End;

          Close;
        End;

      End;

      Close;
    End;

  Finally
    FreeAndNil(qryGenGer);
  End;

end;

function TfrmCancelamentoDocumentos.fValidadeIntegridadeCancelamentoNE(strNumDoc, strSerie_, strCodFor: String): Boolean;
  Var
    qryGenMov: TUniQuery;
Begin
  qryGenMov := fCriaQuery;
  With qryGenMov Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('SELECT                     ');
