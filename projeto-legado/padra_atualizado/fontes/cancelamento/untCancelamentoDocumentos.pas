    Begin
      Clear;
      Add('UPDATE GERELE SET    ');
      Add('  GER_DTACON = NULL, ');
      Add('  GER_HORCON = NULL, ');
      Add('  GER_OPECON = NULL, ');
      Add('  GER_ENDFIN = "N", ');
      Add('  GER_IDEDIG = NULL  ');
      Add('WHERE GER_EMPENT = :EMPENT ');
      Add('  AND GER_IDEDIG = :IDEDIG ');

      ParamByName('EMPENT').AsString := VS_strCodEmp;
      ParamByName('IDEDIG').AsString := strIdeDig;

      ExecSQL;

      Result := True;
    End;

    FreeAndNil(qryGerEle);

  Except
    On E: Exception Do
    Begin
      fRollBack;
      FreeAndNil(qryGerEle);
      Result := False;
      pMensagensErro(E.Message, '[fCancelaConferenciaNotaEletronica]');
    End;
  End;
End;

Function TfrmCancelamentoDocumentos.fCancelaBaixaNotaEletronica(strEspDoc, strNumDoc, strCodFor, strSerie: String): Boolean;
  Var
    qryGerEle: TUniQuery;
    strIncGerEle: String;
    intTipXml: integer;
Begin
  Try
    strIncGerEle := fRetAutoIncremGerEle(strEspDoc, strNumDoc, strCodFor, strSerie, intTipXml);
    qryGerEle := fCriaQuery;
    If (intTipXml = ord(tpeFinalidadeXML.xmlNfeAjuste)) and (strIncGerEle <> '') then
    begin
      qryGerEle.SQL.Text := 'DELETE FROM GERELE WHERE AUTOINCREM = "'+strIncGerEle+'"';
      qryGerEle.ExecSQL;
      FreeAndNil(qryGerEle);
      Exit(True);

    End;

    With qryGerEle, SQL Do
    Begin
      Clear;
      Add('UPDATE GERELE');
      Add('SET');
      If blnTemMovimento117 Then
        Add('  GER_DTALIB = NULL,');
      Add('  GER_EMPENT = NULL,');
      Add('  GER_DOCENT = NULL,');
      Add('  GER_ESPENT = NULL ');

      if fConferenciaDepoisDaEntrada Then
      Begin

        If (Not(fEntradaParaConsumo(strCodFor))) Then
          Add('  , GER_DTACON = NULL ');
        Add('  , GER_ENDFIN = "N" ');
        Add('  , GER_HORCON = NULL ');
        Add('  , GER_OPECON = NULL ');
        Add('  , GER_IDEDIG = NULL ');

      End;

      Add('WHERE');

      Add('  GER_ESPENT = :ESPENT AND');
      Add('  GER_DOCENT = :DOCENT AND');
      Add('  GER_EMPENT = :EMPENT AND');
      Add('  IFNULL(B07_SERIE, "")  = :NUMSER AND ');

      If (((arrEspecies[intIndiceEsp][0] = 'ND') And (blnConEqu))
         Or ((arrEspecies[intIndiceEsp][0] = 'NW') And (Not blnNW_Nfe))
         Or (arrEspecies[intIndiceEsp][0] = 'DL')) Then
      Begin
        Add('  GER_CODCLI = :CODCLI ');
        ParamByName('CODCLI').AsString := strCodFor;
      End Else Begin
        Add('  GER_CODFOR = :CODFOR ');
        ParamByName('CODFOR').AsString := strCodFor;
      End;

      ParamByName('EMPENT').AsString := VS_strCodEmp;
      ParamByName('DOCENT').AsString := strNumDoc;
      ParamByName('ESPENT').AsString := strEspDoc;
      ParamByName('NUMSER').AsString := strSerie;

      ExecSQL;

      Result := TRUE;

      If Result Then
      Begin
        If Not fEmptyStr(strIncGerEle) Then
         pRestauraPREPGA(strIncGerEle);

      End;

    End;
    FreeAndNil(qryGerEle);

  Except
    On E: Exception Do
    Begin
      fRollBack;
      FreeAndNil(qryGerEle);
      Result := False;
      pMensagensErro(E.Message, '[fCancelaBaixaNotaEletronica]');
    End;
  End;
End;

Function TfrmCancelamentoDocumentos.fRetAutoIncremGerEle(strEspDoc, strNumDoc, strCodFor, strSerie: String; var ATipXml:integer): string;
  Var
    qryGerEle: TUniQuery;
Begin
  Try
    qryGerEle := fCriaQuery;
    With qryGerEle, SQL Do
    Begin
      Clear;
      Add('SELECT AUTOINCREM, GER_TIPXML FROM GERELE');
      Add('WHERE');

      Add('  GER_ESPENT = :ESPENT AND');
      Add('  GER_DOCENT = :DOCENT AND');
      Add('  GER_EMPENT = :EMPENT AND');
      Add('  IFNULL(B07_SERIE, "")  = :NUMSER AND ');

      If (((arrEspecies[intIndiceEsp][0] = 'ND') And (blnConEqu))
         Or ((arrEspecies[intIndiceEsp][0] = 'NW') And (Not blnNW_Nfe))
         Or (arrEspecies[intIndiceEsp][0] = 'DL')) Then
      Begin
        Add('  GER_CODCLI = :CODCLI ');
        ParamByName('CODCLI').AsString := strCodFor;
      End Else Begin
        Add('  GER_CODFOR = :CODFOR ');
        ParamByName('CODFOR').AsString := strCodFor;
      End;

      ParamByName('EMPENT').AsString := VS_strCodEmp;
      ParamByName('DOCENT').AsString := strNumDoc;
      ParamByName('ESPENT').AsString := strEspDoc;
      ParamByName('NUMSER').AsString := strSerie;

      qryGerEle.Open;


      Result := qryGerEle.FieldByName('AUTOINCREM').AsString;
      ATipXml := qryGerEle.FieldByName('GER_TIPXML').AsInteger;
    End;
    FreeAndNil(qryGerEle);

  Except
    On E: Exception Do
    Begin
      fRollBack;
      FreeAndNil(qryGerEle);
      Result := '';
      pMensagensErro(E.Message, '[fRetAutoIncremGerEle]');
    End;
  End;
End;


procedure TfrmCancelamentoDocumentos.btnAdicionarClick(Sender: TObject);
begin
  inherited;

  dtaDtaEntEstoque := 0;

  lstCtrBaixadas.Clear;
  lstCtpBaixadas.Clear;
  lstCtpReteBaix.Clear;
  lstCtpGnrBaixa.Clear;
  lstCtpCFrBaixa.Clear;
  lstCtpAntBaixa.Clear;
  lstCtpServBaix.Clear;
  lstCtpAgrupada.Clear;
  lstCtpGnrAgrup.Clear;
  lstCtpCFrAgrup.Clear;
  lstCtpAntAgrup.Clear;
  lstCtpServAgru.Clear;
  FCtrPixGerado.Clear;

  blnBECTP   := False;
  strNumCTP  := '';
  strForCTP  := '';
  strPDAtuOS := '';

  If blnPDV Then
  Begin
    If Not fPermitidoCancelarDocumentoPDV(arrEspecies[intIndiceEsp][0], edtNumDoc.Text, edtCliFor.Text) Then
    Begin
      Exit;
    End;
  End;

  Try

    Try

      blnPodeDesfaturar := True;

      If (Not fSuportaInterfaceGrafica) Then
      Begin
        fCancelarDocumentos(nil);
      End Else
      Begin
        pCriarFormularios(TfrmGravando, frmGravando);
        frmGravando.strChave      := 'CANCELAMENTO';
        frmGravando.fExecutarAcao := fCancelarDocumentos;
        frmGravando.ShowModal;
      End;

    Except

      On E: ExceptionAutCom Do
      Begin

        If (Not fSuportaInterfaceGrafica) Then
          Raise;

        pMensagemOk(E.Message);

      End;

      On E: Exception Do
      Begin

        If (Not fSuportaInterfaceGrafica) Then
          Raise;

        pMensagensErro(E.Message, '[fConfirmaVenda - frmGravando]');

      End;

    End;

  Finally

