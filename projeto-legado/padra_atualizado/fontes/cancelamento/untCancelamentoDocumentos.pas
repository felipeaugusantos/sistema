procedure TfrmCancelamentoDocumentos.pDeletarConferenciaSimplificada(strCodEmp, strNumDoc, strCodFor: String);
Var
  qryBusca : TUniQuery;
  qryDelete : TUniQuery;
  strSeqCon: string;
begin
  qryBusca := fCriaQuery(Self);
  qryDelete := fCriaQuery(Self);

  Try
    qryBusca.Close;
    qryBusca.SQL.Clear;
    qryBusca.SQL.Add('SELECT DOC_SEQCON FROM MOVGER G');
    qryBusca.SQL.Add('INNER JOIN PCMGER ON PCG_ORIGND = GER_NUMDOC AND PCG_ORIGES = GER_ESPDOC AND PCG_ORIGEP = G.GER_CODEMP AND PCG_DTAPED = G.GER_DTAENT');
    qryBusca.SQL.Add('INNER JOIN CONDOC ON DOC_SEQGER = G.AUTOINCREM');
    qryBusca.SQL.Add('WHERE GER_NUMDOC = :NUMDOC AND PCG_CODFOR = :CODFOR  AND PCG_EMPDES = :EMPDES');
    qryBusca.ParamByName('NUMDOC').AsString  := strNumDoc;
    qryBusca.ParamByName('CODFOR').AsString  := strCodFor;
    qryBusca.ParamByName('EMPDES').AsString  := strCodEmp;
    qryBusca.Open;

    if qryBusca.IsEmpty then
      Exit;

    strSeqCon := qryBusca.FieldByName('DOC_SEQCON').AsString;

    qryBusca.Close;
    qryBusca.SQL.Clear;
    qryBusca.SQL.Add('SELECT * FROM CONDOC WHERE DOC_SEQCON = :SEQCON');
    qryBusca.ParamByName('SEQCON').AsString  := strSeqCon;
    qryBusca.Open;

    fVerificaIntegridade(Self.Name, 'CONDOC', qryBusca, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

    qryDelete.Close;
    qryDelete.SQL.Clear;
    qryDelete.SQL.Add('DELETE FROM CONDOC WHERE DOC_SEQCON = :SEQCON');
    qryDelete.ParamByName('SEQCON').AsString  := strSeqCon;
    qryDelete.ExecSQL;

    qryBusca.Close;
    qryBusca.SQL.Clear;
    qryBusca.SQL.Add('SELECT * FROM CONGER WHERE AUTOINCREM = :INCREM');
    qryBusca.ParamByName('INCREM').AsString  := strSeqCon;
    qryBusca.Open;

    fVerificaIntegridade(Self.Name, 'CONGER', qryBusca, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

    qryDelete.Close;
    qryDelete.SQL.Clear;
    qryDelete.SQL.Add('DELETE FROM CONGER WHERE AUTOINCREM = :INCREM');
    qryDelete.ParamByName('INCREM').AsString  := strSeqCon;
    qryDelete.ExecSQL;

    qryBusca.Close;
    qryBusca.SQL.Clear;
    qryBusca.SQL.Add('SELECT * FROM CONDIG WHERE DIG_SEQCON = :SEQCON');
    qryBusca.ParamByName('SEQCON').AsString  := strSeqCon;
    qryBusca.Open;

    fVerificaIntegridade(Self.Name, 'CONDIG', qryBusca, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

    qryDelete.Close;
    qryDelete.SQL.Clear;
    qryDelete.SQL.Add('DELETE FROM CONDIG WHERE DIG_SEQCON = :SEQCON');
    qryDelete.ParamByName('SEQCON').AsString  := strSeqCon;
    qryDelete.ExecSQL;

  Finally
    FreeAndNil(qryBusca);
    FreeAndNil(qryDelete);
  End;
end;

function TfrmCancelamentoDocumentos.fAtualizaQtdeGarantia(strNumDoc,
                                                          strEspDoc,
                                                          strCliFor: String;
                                                          ArrayOfTMovGauCancelado: TArrayOfTMovGauCancelado): Boolean;
  Var
    qryItens, qryAtu: TUniquery;
    strSQL: String;
    strDocRef : String;
    ErroAtualizarGad : Integer;

    fltQtdIte: Double;

    blnReposicaoCliente: Boolean;

  Function fSQLUpdatePedido: String;
    Const
      STR_QTDBAI = ' (:QTDBAI / IF(PCD_EMBALA IS NULL OR PCD_EMBALA = 0, 1, PCD_EMBALA)) ';

      var
        strSQL: String;
        blnUsaConferenciaParcial: Boolean;
  Begin

    blnUsaConferenciaParcial:= (fCfgSis('USACON', varBoolean)) And (fCfgSis('PERCPA', varBoolean));
    strSQL := '';

    strSQL := strSQL + 'UPDATE ';
    strSQL := strSQL + '  PCMDET P ';
    strSQL := strSQL + 'SET ';
    strSQL := strSQL + '  PCD_BAIXAD = 0, ';

    strSQL := strSQL + '  PCD_VALFRE = PCD_VALFRE + (@FREUNI:=(PCD_FREBAI / PCD_QTDBAI))* 0, ';
    strSQL := strSQL + '  PCD_DESACE = PCD_DESACE + (@ACEUNI:=(PCD_ACEBAI / PCD_QTDBAI))* 0, ';
    strSQL := strSQL + '  PCD_TOTDAR = PCD_TOTDAR + (@DARUNI:=(PCD_TOTDAR / PCD_QTDBAI))* 0, ';

    If fCfgSis('CNVEMB') <> 'N' Then
      strSQL := strSQL + '  PCD_QTDBAI = IF(PCD_QTDBAI - ' + STR_QTDBAI + ' < 0, 0, PCD_QTDBAI - ' + STR_QTDBAI + '), '
    Else
      strSQL := strSQL + '  PCD_QTDBAI = IF(PCD_QTDBAI - :QTDBAI < 0, 0, PCD_QTDBAI - :QTDBAI), ';

    strSQL := strSQL + '  PCD_QTDENT = PCD_QTDENT - IFNULL(:QTD117, 0), ';
    strSQL := strSQL + '  PCD_QTDFUT = PCD_QTDFUT - IFNULL(:QTD922, 0), ';


    strSQL := strSQL + '  PCD_TOTBAI = (PCD_QTDBAI * (PCD_UNITAR * (1 - IFNULL(PCD_DESUNI, 0)/100) ';
    strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN2, 0)/100) ';
    strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN3, 0)/100) ';
    strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN4, 0)/100) ';
    strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN5, 0)/100) ';
    strSQL := strSQL + '                                         * (1 - IFNULL(PCD_DESUN6, 0)/100) ';
    strSQL := strSQL + '                                         )), ';

    strSQL := strSQL + '  PCD_FREBAI = ROUND(@FREUNI * PCD_QTDBAI, 2), ';
    strSQL := strSQL + '  PCD_ACEBAI = ROUND(@ACEUNI * PCD_QTDBAI, 2), ';

    strSQL := strSQL + '  PCD_VALFRE = ROUND(@FREUNI * (PCD_QTDITE - PCD_QTDBAI), 2), ';
    strSQL := strSQL + '  PCD_DESACE = ROUND(@ACEUNI * (PCD_QTDITE - PCD_QTDBAI), 2), ';

    strSQL := strSQL + '  PCD_IPIBAI = PCD_TOTBAI * (PCD_PERIPI / 100), ';
    strSQL := strSQL + '  PCD_SUBBAI = PCD_TOTBAI * (PCD_PERSUB / 100), ';

    strSQL := strSQL + '  PCD_DARBAI = ROUND(@DARUNI * PCD_QTDBAI) ';

    If blnUsaConferenciaParcial Then
    Begin
      If fCfgSis('CNVEMB') <> 'N' Then
        strSQL := strSQL + '  , PCD_QTDCON = IF(PCD_QTDCON + ' + STR_QTDBAI + ' >= PCD_QTDITE, PCD_QTDITE, PCD_QTDCON + ' + STR_QTDBAI + ') '
      Else
        strSQL := strSQL + '  , PCD_QTDCON = IF(PCD_QTDCON + :QTDBAI >= PCD_QTDITE, PCD_QTDITE, PCD_QTDCON + :QTDBAI) ';
    End;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  PCD_NUMCTN = 0 AND ';
    strSQL := strSQL + '  PCD_NUMPED = :NUMPED AND ';
    strSQL := strSQL + '  PCD_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  PCD_CODITE = :CODITE ';

    Result := strSQL;
  End;


  procedure pAtualizaQtdePedCom(strNumPed, strEmpPed, strCodIte:String; fltQtdIte : Double);
    Var
      qryGen : TUniQuery;
      stlPedComGarantia: TStringList;
  begin
    If Not fEmptyStr(strNumPed) Then
    Begin
      stlPedComGarantia := TStringList.Create;
      stlPedComGarantia.Duplicates := dupIgnore;
      stlPedComGarantia.Clear;
      qryGen := fCriaQuery(Self);

      Try
        Try
          qryGen.Close;
          qryGen.SQL.Clear;
          qryGen.SQL.Text := fSQLUpdatePedido;
          qryGen.ParamByName('CODITE').AsString  := strCodIte;
          qryGen.ParamByName('QTDBAI').AsFloat   := fltQtdIte;
          qryGen.ParamByName('NUMPED').AsString  := strNumPed;
          qryGen.ParamByName('CODEMP').AsString  := strEmpPed;

          pEstornaSaldoPedidoCompra(strNumPed, 'PD', strEmpPed, strCodIte);

          qryGen.ExecSQL;

          pAtualizaSaldoPedidoCompra(strNumPed, 'PD', strEmpPed, strCodIte);

          stlPedComGarantia.Add(strNumPed +'-'+ strEmpPed);
          fDesfaturaPedidoCompra(stlPedComGarantia);
        Except

          On E: Exception Do
          Begin
            Raise Exception.Create(E.Message);
          End;

        End;
      Finally
        FreeAndNil(qryGen);
      End;
    End;
  end;

  function fEhOutrasSaidasReposicaoCliente: Boolean;
    Var
      lQry: TUniQuery;
      lSql: String;
  begin
    Result := False;

    lQry := fCriaQuery(Self);

    lSql :=        ' SELECT  COUNT(1) AS CONTAGEM ';
    lSql := lSql + ' FROM  MOVGER G ';
    lSql := lSql + ' INNER JOIN MOVDET D  ON D.DET_SEQGER = G.AUTOINCREM ';
    lSql := lSql + ' INNER JOIN MOVGRC C  ON C.GRC_SEQDET = D.AUTOINCREM AND C.GRC_OPCDOC = "OU" ';
    lSql := lSql + ' INNER JOIN MOVGAD D2 ON D2.AUTOINCREM = C.GRC_SEQGAD ';

    lSql := lSql + ' WHERE G.GER_ESPDOC = "NF" ';
    lSql := lSql + '        AND   G.GER_NUMDOC = :NUMDOC ';
    lSql := lSql + '        AND   G.GER_CODEMP = :CODEMP ';
    lSql := lSql + '        AND   G.GER_CODCLI = :CLIFOR ';


    Try
      lQry.SQL.Clear;
      lQry.Sql.Add(lSql);

      lQry.ParamByName('NUMDOC').AsString := strNumDoc;
      lQry.ParamByName('CODEMP').AsString := VS_strCodEmp;
      lQry.ParamByName('CLIFOR').AsString := strCliFor;
      lQry.Open;

      if lQry.IsEmpty then
        Exit
      else
        Result := lQry.FieldByName('CONTAGEM').AsInteger > 0;

    Finally
      if Assigned(lQry) Then
        FreeAndNil(lQry);
    End;
  end;

Begin
  fltQtdIte := 0;
  ErroAtualizarGad := 0;
  Result := False;

  If (strEspDoc = 'OF') then
    blnReposicaoCliente := fEhOutrasSaidasReposicaoCliente
  else
    blnReposicaoCliente := False;

  Try
    qryItens := fCriaQuery;

    strSQL := '';
    {$Region 'Motando SQL'}
    If (Pos(strEspDoc,'GC_') > 0) Then     //ENVIO PARA CLIENTE
    Begin
      strSQL := strSQL + ' SELECT          ';
      strSQL := strSQL + '   A.AUTOINCREM, ';
      strSQL := strSQL + '   D.DET_CODITE AS CODITE, ';
      strSQL := strSQL + '   D.DET_QTDITE AS QTDITE, ';
      strSQL := strSQL + '   0.00         AS QTDREF  ';
      strSQL := strSQL + ' FROM            ';
      strSQL := strSQL + '   MOVGER G INNER JOIN MOVDET D ON G.AUTOINCREM = D.DET_SEQGER ';
      strSQL := strSQL + '            INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ';
      strSQL := strSQL + '            INNER JOIN MOVGAD A ON A.AUTOINCREM = T.DET_SEQGAD ';
      strSQL := strSQL + '            INNER JOIN MOVGAG M ON M.AUTOINCREM = A.GAD_SEQGAG ';
      strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + ' AND   G.GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + ' AND   G.GER_CODEMP = :CODEMP ';
      strSQL := strSQL + ' AND   G.GER_CODCLI = :CLIFOR '
    End

    Else If (Pos(strEspDoc,'GF_NG_') > 0) Then
    Begin
      strSQL := strSQL + ' SELECT DISTINCT  ';
      strSQL := strSQL + '   E.AUTOINCREM,                                     ';
      strSQL := strSQL + '   E.GAE_SEQGAD,     ';
      strSQL := strSQL + '   A.GAD_CODITE AS CODITE,  ';
      strSQL := strSQL + '   A.GAD_QTDREQ AS QTDITE,  ';
      strSQL := strSQL + '   GAU_AIBXRF     ';
      strSQL := strSQL + ' FROM MOVGER G                                       ';
      strSQL := strSQL + '   INNER JOIN MOVDET D ON G.AUTOINCREM = D.DET_SEQGER ';

      strSQL := strSQL + '   INNER JOIN MOVGAE E ON GAE_NUMENV = D.DET_NUMDOC ';
      strSQL := strSQL + '                      AND GAE_ESPENV = D.DET_ESPDOC ';
      strSQL := strSQL + '                      AND GAE_EMPENV = D.DET_CODEMP ';
      strSQL := strSQL + '                      AND GAE_SERENV = D.DET_SERIE_ ';

      strSQL := strSQL + '   INNER JOIN MOVGAD A ON A.AUTOINCREM = GAE_SEQGAD ';

      strSQL := strSQL + '            INNER JOIN MOVGAG M ON M.AUTOINCREM = A.GAD_SEQGAG ';
      strSQL := strSQL + '            LEFT  JOIN MOVGAU S ON S.GAU_SEQDET = D.AUTOINCREM ';

      strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + ' AND   G.GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + ' AND   G.GER_CODEMP = :CODEMP ';
      strSQL := strSQL + ' AND   G.GER_CODFOR = :CLIFOR ';
    End

    Else If (strEspDoc = 'OF') and blnReposicaoCliente Then
    Begin
      strSQL := strSQL + ' SELECT  C.GRC_SEQGAD as "AUTOINCREM", ';
      strSQL := strSQL + '         D.DET_CODITE AS CODITE, ';
      strSQL := strSQL + '         D.DET_QTDITE AS QTDITE, ';
      strSQL := strSQL + '         0 AS QTDREF, ';
      strSQL := strSQL + '         D2.GAD_QTDDEV AS QTDDEV, ';
      strSQL := strSQL + '         D2.GAD_QTDPRE AS QTDPRE ';
      strSQL := strSQL + ' FROM  MOVGER G ';
      strSQL := strSQL + ' INNER JOIN MOVDET D  ON D.DET_SEQGER = G.AUTOINCREM ';
      strSQL := strSQL + ' INNER JOIN MOVGRC C  ON C.GRC_SEQDET = D.AUTOINCREM AND C.GRC_OPCDOC = "OU" ';
      strSQL := strSQL + ' INNER JOIN MOVGAD D2 ON D2.AUTOINCREM = C.GRC_SEQGAD ';

      strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '        AND   G.GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '        AND   G.GER_CODEMP = :CODEMP ';
      strSQL := strSQL + '        AND   G.GER_CODCLI = :CLIFOR ';
    End

    Else If (Pos(strEspDoc,'OF_FF_') > 0) and (Not blnReposicaoCliente) Then    //ENVIO PARA CLIENTE OU FATURAMENTO FUTURO
    Begin
      strSQL := strSQL + ' SELECT U.AUTOINCREM,       ';
      strSQL := strSQL + '        U.GAU_SEQGAD,       ';
      strSQL := strSQL + '        U.GAU_CODITE,       ';
      strSQL := strSQL + '        S.SEQ_FDOREF,       ';
      strSQL := strSQL + '        S.SEQ_PCDREF,       ';
      strSQL := strSQL + '        NULL AS FDO_NUMFAT, ';
      strSQL := strSQL + '        NULL AS FDO_TIPFAT, ';
      strSQL := strSQL + '        NULL AS FDO_EMPFAT  ';
      strSQL := strSQL + ' FROM MOVGER G ';
      strSQL := strSQL + '   INNER JOIN MOVGAU U ON U.GAU_AIBXRF = G.AUTOINCREM ';
      strSQL := strSQL + '   LEFT  JOIN SEQGAR S ON S.SEQ_MOVGAD = GAU_SEQGAD   ';
      strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + ' AND   G.GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + ' AND   G.GER_CODEMP = :CODEMP ';
      strSQL := strSQL + ' AND   G.GER_CODCLI = :CLIFOR ';

      If (fCfgSis('REFENT', varBoolean)) Or
         (fCfgSis('GARMAT', varBoolean) And fCfgSis('REFENT', varBoolean, fCfgSis('EMPGAR', varString)) ) Then
      Begin
        strSQL := strSQL + ' UNION ALL                                           ';
        strSQL := strSQL + ' SELECT NULL,                                        ';
        strSQL := strSQL + '        NULL,                                        ';
        strSQL := strSQL + '        NULL,                                        ';
        strSQL := strSQL + '        NULL,                                        ';
        strSQL := strSQL + '        NULL,                                        ';
        strSQL := strSQL + '        FDO_NUMFAT,                                  ';
        strSQL := strSQL + '        FDO_TIPFAT,                                  ';
        strSQL := strSQL + '        FDO_EMPFAT                                   ';
        strSQL := strSQL + ' FROM MOVGER G                                       ';
        strSQL := strSQL + '   INNER JOIN FATDOR D ON FDO_NUMFAT = GER_NUMDOC    ';
        strSQL := strSQL + '                      AND FDO_TIPFAT = GER_ESPDOC    ';
        strSQL := strSQL + '                      AND FDO_CODEMP = GER_CODEMP    ';
        strSQL := strSQL + '   INNER JOIN SEQGAR S ON SEQ_FDOREF = D.AUTOINCREM  ';
        strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC                        ';
        strSQL := strSQL + ' AND   G.GER_NUMDOC = :NUMDOC                        ';
        strSQL := strSQL + ' AND   G.GER_CODEMP = :CODEMP                        ';
        strSQL := strSQL + ' AND   G.GER_CODCLI = :CLIFOR                        ';
      End;

    End

    Else If (Pos(strEspDoc,'GR_NR_NE_') > 0) Then
    Begin
      strSQL := strSQL + ' SELECT DISTINCT ';
      strSQL := strSQL + '   U.GAU_SEQDET, ';
      strSQL := strSQL + '   A.AUTOINCREM, ';
      strSQL := strSQL + '   P.PCD_NUMPED AS NUMPED, ';
      strSQL := strSQL + '   P.PCD_CODEMP AS CODEMP, ';
      strSQL := strSQL + '   U.GAU_CODITE AS CODITE, ';
      strSQL := strSQL + '   U.GAU_QTDRET AS QTDITE, ';
      strSQL := strSQL + '   U.AUTOINCREM AS INCGAU, ';
      strSQL := strSQL + '   IFNULL(U.GAU_QTDREF,0) AS QTDREF, ';
      strSQL := strSQL + '   U.GAU_AIBXRF,       ';
      strSQL := strSQL + '   SEQ_FDOREF,         ';
      strSQL := strSQL + '   SEQ_PCDREF,         ';
      strSQL := strSQL + '   NULL AS FDO_JAFATU, ';
      strSQL := strSQL + '   NULL AS FDO_TIPFAT, ';
      strSQL := strSQL + '   NULL AS FDO_NUMFAT  ';
      If fUsaEnderecamento Then
        strSQL := strSQL + ' , FGO_DOCEND        ';

      strSQL := strSQL + ' FROM                  ';
      strSQL := strSQL + '   MOVGER G INNER JOIN MOVDET D ON G.AUTOINCREM = D.DET_SEQGER ';
      strSQL := strSQL + '            INNER JOIN MOVGAU U ON D.AUTOINCREM = U.GAU_SEQDET ';
      strSQL := strSQL + '            INNER JOIN MOVGAE E ON E.AUTOINCREM = U.GAU_SEQGAE ';
      strSQL := strSQL + '            INNER JOIN MOVGAD A ON A.AUTOINCREM = U.GAU_SEQGAD ';
      strSQL := strSQL + '            LEFT  JOIN SEQGAR S ON S.SEQ_MOVGAD = A.AUTOINCREM ';
      strSQL := strSQL + '            LEFT JOIN PCMDET P  ON P.PCD_DOCORI = CONCAT(GAE_NUMENV,GAE_ESPENV,GAE_EMPENV) ';
      If not fCfgSis('GARMAT', varBoolean) Then
        strSQL := strSQL + '                             AND P.PCD_CODEMP = G.GER_CODEMP ';

      If fUsaEnderecamento Then
      Begin
        strSQL := strSQL + '          LEFT JOIN EXTGOR X  ON FGO_DOCEND = CONCAT(G.GER_NUMDOC,G.GER_ESPDOC,RPAD(G.GER_SERIE_,3," "),G.GER_CODEMP, G.GER_CODFOR, G.GER_TIP_FC) ';
      End;

      strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + ' AND   G.GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + ' AND   G.GER_CODEMP = :CODEMP ';
      strSQL := strSQL + ' AND   G.GER_CODFOR = :CLIFOR ';

      If (fCfgSis('REFENT', varBoolean)) Or
         (fCfgSis('GARMAT', varBoolean) And fCfgSis('REFENT', varBoolean, fCfgSis('EMPGAR', varString)) ) Then
      Begin
        strSQL := strSQL + ' UNION ALL                                            ';
        strSQL := strSQL + ' SELECT DISTINCT                                      ';
        strSQL := strSQL + '        U.GAU_SEQDET,                                 ';
        strSQL := strSQL + '        A.AUTOINCREM,                                 ';
        strSQL := strSQL + '        P.PCD_NUMPED AS NUMPED,                       ';
        strSQL := strSQL + '        P.PCD_CODEMP AS CODEMP,                       ';
        strSQL := strSQL + '        U.GAU_CODITE AS CODITE,                       ';
        strSQL := strSQL + '        U.GAU_QTDRET AS QTDITE,                       ';
        strSQL := strSQL + '        U.AUTOINCREM AS INCGAU,                       ';
        strSQL := strSQL + '        IFNULL(U.GAU_QTDREF, 0) AS QTDREF,            ';
        strSQL := strSQL + '        U.GAU_AIBXRF,                                 ';
        strSQL := strSQL + '        SEQ_FDOREF,                                   ';
        strSQL := strSQL + '        SEQ_PCDREF,                                   ';
        strSQL := strSQL + '        T.FDO_JAFATU,                                 ';
        strSQL := strSQL + '        FDO_TIPFAT,                                   ';
        strSQL := strSQL + '        FDO_NUMFAT                                    ';
        If fUsaEnderecamento Then
          strSQL := strSQL + ' , FGO_DOCEND                                       ';
        strSQL := strSQL + ' FROM MOVGER G                                        ';
        strSQL := strSQL + '   INNER JOIN MOVDET D ON G.AUTOINCREM = D.DET_SEQGER ';
        strSQL := strSQL + '   INNER JOIN PCMDET P ON P.PCD_DOCEMI = G.GER_NUMDOC ';
        strSQL := strSQL + '                      AND P.PCD_ESPEMI = G.GER_ESPDOC ';
        strSQL := strSQL + '   INNER JOIN SEQGAR S ON S.SEQ_PCDREF = P.AUTOINCREM ';
        strSQL := strSQL + '   INNER JOIN FATDOR T ON T.AUTOINCREM = SEQ_FDOREF   ';
        strSQL := strSQL + '   INNER JOIN EXTDOR E ON FDO_SEQFDO = T.AUTOINCREM   ';
        strSQL := strSQL + '   INNER JOIN MOVGAU U ON U.GAU_SEQGAD = SEQ_MOVGAD   ';
        strSQL := strSQL + '   INNER JOIN MOVGAD A ON A.AUTOINCREM = SEQ_MOVGAD   ';

        If fUsaEnderecamento Then
        Begin
          strSQL := strSQL + '  LEFT JOIN EXTGOR X  ON FGO_DOCEND = CONCAT(G.GER_NUMDOC,G.GER_ESPDOC,RPAD(G.GER_SERIE_,3," "),G.GER_CODEMP, G.GER_CODFOR, G.GER_TIP_FC) ';
        End;

        strSQL := strSQL + ' WHERE G.GER_ESPDOC = :ESPDOC                         ';
        strSQL := strSQL + ' AND   G.GER_NUMDOC = :NUMDOC                         ';
        strSQL := strSQL + ' AND   G.GER_CODEMP = :CODEMP                         ';
        strSQL := strSQL + ' AND   G.GER_CODFOR = :CLIFOR                         ';
      End;

    End;
    {$EndRegion 'Motando SQL'}

    With qryItens Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      If blnPedidoEntrada And ( strEspDoc = 'NE' ) Then
        ParamByName('ESPDOC').AsString := 'PD'
      Else
        ParamByName('ESPDOC').AsString := IIF(Pos(strEspDoc,'OF_NE_NR_NG_') > 0,'NF',strEspDoc);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CLIFOR').AsString := strCliFor;

      Open;

      If IsEmpty Then
      Begin
        //Se nao tiver retorno para cancelar, e a empresa usa o retorno do Fornecedor pela entrada (REFENT)
        //e a conferencia é depois da entrada, entao pode cancelar pois a baixa do retorno nesse caso é na conferencia,
        //se esta sem baixa eh porque nao foi conferido ainda.
        If ((fCfgSis('REFENT', varBoolean)) Or
           (fCfgSis('GARMAT', varBoolean) And fCfgSis('REFENT', varBoolean, fCfgSis('EMPMAT', varString)))) And
           (Pos(strEspDoc,'GR_NR_NE_') > 0) And fConferenciaDepoisDaEntrada Then
        Begin
          Exit(True);
        End;
      End;

      //So Atualiza MOVGAD no Cancelamento de NE caso for a NE de retorno do fornecedor
      //Entrada de refugo apenas tem que cancelar a entrada e o pedido q foi baixado. o cancelamento de entrada já faz isso
      If (strEspDoc = 'NE') And
         (qryItens.FindField('FDO_JAFATU') <> Nil) And
         (Not qryItens.FieldByName('FDO_JAFATU').IsNull) And
         (qryItens.FieldByName('FDO_JAFATU').AsInteger = 0) Then
      Begin
        Result := True;
        Exit;
      End;

      If (Not IsEmpty) Then
      Begin
        If (Pos(strEspDoc,'GF_NG_GR_NR_NE_') > 0) Then
        Begin
          While Not Eof Do
          Begin
            If (Pos(strEspDoc,'GF_NG_') > 0) Then
            Begin
              If Not FieldByName('GAU_AIBXRF').IsNull Then
              Begin
                strDocRef := fCampoTabela('CONCAT(GER_NUMDOC, "-", GER_ESPDOC, "-", IFNULL(GER_SERIE_,""), "-", GER_CODCLI)',
                                          'MOVGER',
                                          ['AUTOINCREM'],
                                          [FieldByName('GAU_AIBXRF').AsString]);

                fMensagem('', 'Documento vinculado com o retorno de fornecedor, com refugo já baixado, cancele a baixa do refugo para cancelar este documento!' + #13 +
                              'Documento de Baixa: ' + strDocRef + ' - OF - Nota de Outras Saídas Cliente', ['&Ok']);
                Result := False;
                Exit;
              End;
            End;

            If (Pos(strEspDoc,'GR_NR_NE_') > 0) Then
            Begin
              If (Not FieldByName('FDO_JAFATU').IsNull) And (FieldByName('FDO_JAFATU').AsInteger > 0) Then
              Begin
                strDocRef := FieldByName('FDO_NUMFAT').AsString + ' - ' + FieldByName('FDO_TIPFAT').AsString;

                If not fEmptyStr(strDocRef) Then
                Begin
                  fMensagem('', 'Documento vinculado com o retorno de refugo já baixado, cancele a baixa do refugo para cancelar este documento!' + #13 +
                                'Documento de Baixa: ' + strDocRef + ' - OF - Nota de Outras Saídas Cliente', ['&Ok']);
                  Result := False;
                  Exit;
                End;
              End;
            End;

            Next;
          End;
        End;

        First;
        While Not Eof Do
        Begin
          If (strEspDoc = 'OF') and blnReposicaoCliente Then
          begin
            if QryItens.FieldByName('QTDDEV').AsFloat >= QryItens.FieldByName('QTDITE').AsFloat Then
              fltQtdIte := QryItens.FieldByName('QTDITE').AsFloat
            else
              //zerando o salvo devolvido para não deixar negativo.
              fltQtdIte := QryItens.FieldByName('QTDDEV').AsFloat;
          end;

          Try
            qryAtu := fCriaQuery;

            With qryAtu, SQL Do
            Begin
              Clear;

              If (Pos(strEspDoc,'OF_FF_') > 0) and (Not blnReposicaoCliente) Then
              Begin
                If (not fEmptyStr(qryItens.FieldByName('AUTOINCREM').AsString)) Then
                Begin
                  Clear;
                  Add('UPDATE MOVGAU SET GAU_AIBXRF = NULL ');
                  Add('WHERE  AUTOINCREM = :AUTINC ');
                  ParamByName('AUTINC').AsString := qryItens.FieldByName('AUTOINCREM').AsString;
                  ExecSQL;
                End;
              End
              Else

              If (Pos(strEspDoc,'GF_NG_') <= 0) AND (Not blnReposicaoCliente) Then
              Begin
                Add(' UPDATE MOVGAD ');
                Add(' SET ');

                If (strEspDoc = 'GC') Then
                  Add('   GAD_QTDDEV = GAD_QTDDEV - :QTDITE ')
                Else If (Pos(strEspDoc,'GR_NR_NE_') > 0) Then
                Begin
                  Add('   GAD_QTDRET = GAD_QTDRET - :QTDITE  ');
                  If (fCfgSis('REFENT', varBoolean)) Then
                    Add('  , GAD_QTDREF = GAD_QTDREF - :QTDREF  ');
                End;

                Add('WHERE');
                Add('  AUTOINCREM = :AUTINC AND ');
                Add('  GAD_CODITE = :CODITE     ');

                If (Pos(strEspDoc,'GR_NR_NE_') > 0) And (fCfgSis('REFENT', varBoolean)) Then
                Begin
                  If fUsaEnderecamento And (not fEmptyStr(qryItens.FieldByName('FGO_DOCEND').AsString)) Then
                    ParamByName('QTDREF').AsFloat  := 0
                  Else
                    ParamByName('QTDREF').AsFloat  := qryItens.FieldByName('QTDREF').AsFloat;
                End;

                ParamByName('QTDITE').AsFloat  := qryItens.FieldByName('QTDITE').AsFloat - qryItens.FieldByName('QTDREF').AsFloat;
                ParamByName('AUTINC').AsString := qryItens.FieldByName('AUTOINCREM').AsString;
                ParamByName('CODITE').AsString := qryItens.FieldByName('CODITE').AsString;

                ExecSQL;

                {*****************}
                {* DELETE MOVGAU *}
                {**************MM*}
                If (Pos(strEspDoc,'GR_NR_NE_') > 0) Then
                Begin
                  pAtualizaQtdePedCom(qryItens.FieldByName('NUMPED').AsString,
                                      qryItens.FieldByName('CODEMP').AsString,
                                      qryItens.FieldByName('CODITE').AsString,
                                      qryItens.FieldByName('QTDITE').AsFloat);

                  Clear;
                  Add('UPDATE MOVGAE                                        ');
                  Add(' INNER JOIN MOVGAU ON GAU_SEQGAE = MOVGAE.AUTOINCREM ');
                  Add('   SET GAE_QTDRET = GAE_QTDRET - GAU_QTDRET          ');

                  If (fCfgSis('REFENT', varBoolean)) Then
                    Add('  , GAE_QTDREF = GAE_QTDREF - GAU_QTDREF          ');

                  If fUsaEnderecamento And fEmptyStr(qryItens.FieldByName('FGO_DOCEND').AsString) And
                     (Not fConferenciaDepoisDaEntrada) Then
                  Begin
                    Add('       , GAE_RETCON = GAE_RETCON + GAU_QTDRET,       ');
                    Add('       GAE_REFCON = GAE_REFCON + GAU_QTDREF          ');
                  End;

                  Add('WHERE  GAU_SEQGAD = :AUTINC ');
                  Add('AND    GAU_SEQDET = :SEQDET ');
                  Add('AND    GAU_CODITE = :CODITE ');
                  Add('   AND MOVGAU.AUTOINCREM = :INCGAU ');

                  ParamByName('AUTINC').AsString := qryItens.FieldByName('AUTOINCREM').AsString;
                  ParamByName('SEQDET').AsString := qryItens.FieldByName('GAU_SEQDET').AsString;
                  ParamByName('CODITE').AsString := qryItens.FieldByName('CODITE').AsString;
                  ParamByName('INCGAU').AsString := qryItens.FieldByName('INCGAU').AsString;

                  ExecSQL;

                  Clear;

                  Add('DELETE FROM MOVGAU          ');
                  Add('WHERE  AUTOINCREM = :AUTINC ');

                  ParamByName('AUTINC').AsString := qryItens.FieldByName('INCGAU').AsString;

                  ExecSQL;
                End;
              End;

              Clear;
              Add(' UPDATE MOVGAD ');
              Add(' SET ');

              If (strEspDoc = 'GC') Then
              Begin
                Add('   GAD_DTADEV = IF(IFNULL(GAD_QTDDEV,0) = 0, NULL, GAD_DTADEV), ');
                Add('   GAD_NUMDEV = IF(IFNULL(GAD_QTDDEV,0) = 0, NULL, GAD_NUMDEV)  ');
              End
              Else If (strEspDoc = 'OF') and blnReposicaoCliente Then
              Begin
                Add(' GAD_QTDDEV = GAD_QTDDEV - :QTDITE ');
              End
              Else If (Pos(strEspDoc,'GR_NR_NE_') > 0) Then
              Begin
                Add('   GAD_QTDREF = (SELECT SUM(IFNULL(GAE_QTDREF,0)) FROM MOVGAE WHERE GAE_SEQGAD = MOVGAD.AUTOINCREM), ');
                Add('   GAD_QTDRET = (SELECT SUM(IFNULL(GAE_QTDRET,0)) FROM MOVGAE WHERE GAE_SEQGAD = MOVGAD.AUTOINCREM), ');
                Add('   GAD_DTARET = IF(IFNULL(GAD_QTDRET,0) = 0, NULL, GAD_DTARET), ');
                Add('   GAD_NUMRET = IF(IFNULL(GAD_QTDRET,0) = 0, NULL, GAD_NUMRET)  ');
              End
              Else If (Pos(strEspDoc,'GF_NG_') > 0) Then
              Begin
                Clear;
                if Not fAtualizaMovGadQuandoCancelamentoGau(qryItens.FieldByName('GAE_SEQGAD').AsString,
                                                            qryItens.FieldByName('AUTOINCREM').AsString,
                                                            ArrayOfTMovGauCancelado) then
                begin
                  Inc(ErroAtualizarGad);
                end;

                Add('   DELETE FROM MOVGAE ');
              End
              Else If (Pos(strEspDoc,'OF_FF_') > 0) Then
              Begin
                Add('   GAD_REFBAI = 0  ');
              End;

              Add('WHERE');
              Add('  AUTOINCREM = :AUTINC ');
              If (Pos(strEspDoc,'GF_NG_') <= 0) AND (Not ((strEspDoc = 'OF') AND blnReposicaoCliente)) Then
                Add('  AND GAD_CODITE = :CODITE     ');

              // qndo cancelamento do refugo tem que reabrir o pedido de venda seq_fdoref !!!!
              // cancelamento do envio de refugo p/filial tem que cancelar o pedido(acho q ja vai) e apagar o pedido de venda
              If  (strEspDoc = 'OF') and blnReposicaoCliente Then
              Begin
                ParamByName('AUTINC').AsString := qryItens.FieldByName('AUTOINCREM').AsString;
                ParamByName('QTDITE').AsFloat := fltQtdIte;
              End

              Else If (Pos(strEspDoc,'OF_FF_') > 0) AND (Not blnReposicaoCliente) Then
              Begin
                If (not fEmptyStr(qryItens.FieldByName('AUTOINCREM').AsString)) Then
                Begin
                  ParamByName('AUTINC').AsString := qryItens.FieldByName('GAU_SEQGAD').AsString;
                  ParamByName('CODITE').AsString := qryItens.FieldByName('GAU_CODITE').AsString;

                  If not fEmptyStr(qryItens.FieldByName('SEQ_FDOREF').AsString) Then
                    fCancelaItenPedGarantiaRefugo(qryItens.FieldByName('SEQ_FDOREF').AsString);

                  If not fEmptyStr(qryItens.FieldByName('SEQ_PCDREF').AsString) Then
                    fCancelaPedidoCompraGarantiaRefugo(qryItens.FieldByName('SEQ_PCDREF').AsString);

                End
                Else
                Begin
                  blnPodeDesfaturar := True;
                  fDesfaturaPedidoVenda(qryItens.FieldByName('FDO_TIPFAT').AsString,
                                        qryItens.FieldByName('FDO_NUMFAT').AsString, '');
                End;
              End
              Else
              Begin
                ParamByName('AUTINC').AsString := qryItens.FieldByName('AUTOINCREM').AsString;
                If FindParam('CODITE') <> Nil Then
                ParamByName('CODITE').AsString := qryItens.FieldByName('CODITE').AsString;
              End;

              If (Pos(strEspDoc,'OF_FF_') > 0) and (Not blnReposicaoCliente) Then
              Begin
                If (not fEmptyStr(qryItens.FieldByName('AUTOINCREM').AsString)) Then
                  ExecSQL;
              End
              Else
                ExecSQL;

              Result := TRUE;
              if Result then
              begin
                Result := ErroAtualizarGad = 0;
              end;
            End;

            FreeAndNil(qryAtu);

          Except

            On E: Exception Do
            Begin
              fRollBack;
              FreeAndNil(qryAtu);
              Result := False;
              pMensagensErro(E.Message, '[fCancelaBaixaNotaEletronica]');
            End;

          End;

          Next;

        End;

      End
      // Se For documentos normais sem ser garantia e nao tiver
      // registro, result = true, pois indica que nao envolveu garantia
      Else If (Pos(strEspDoc,'NE_OF_FF_') > 0) Then
        Result := True;

    End;

  Except

    On E:Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[TfrmCancelamentoDocumentos.fAtualizaQtdeGarantia]');
    End;

  End;

  FreeAndNil(qryItens);
end;

function TfrmCancelamentoDocumentos.fAtualizaStatusCTe(strStatus: String; strNumDoc: String = ''; strCodEmp: String = ''): Boolean;
var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);
  try
    Result := False;
    qryAux.SQL.Add('UPDATE LOGNFE ');
    qryAux.SQL.Add('  SET NFE_STATUS = :STATUS ');
    qryAux.SQL.Add('WHERE ');
    qryAux.SQL.Add('  NFE_NUMDOC = :NUMDOC ');
    qryAux.SQL.Add('  AND NFE_ESPDOC = "CT" ');
    qryAux.SQL.Add('  AND NFE_CODEMP = :CODEMP ');
    qryAux.ParamByName('NUMDOC').AsString := IIF( fEmptyStr(strNumDoc), RightStr(edtNumDoc.Text, 9), strNumDoc);
    qryAux.ParamByName('CODEMP').AsString := IIF( fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);
    qryAux.ParamByName('STATUS').AsString := strStatus;
    qryAux.ExecSQL;
    Result := True;
  finally
    FreeAndNil(qryAux);
  end;
end;

procedure TfrmCancelamentoDocumentos.pAtualizaStatusNfe(strEspDoc, strTip_Fc,
  strStatus: String);
  Var
    qryAux: TUniQuery;
    strSerie: String;
begin
  If (edtSerie.Visible) Then
    strSerie := edtSerie.Text
  Else
    strSerie := strSerFsc;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('UPDATE LOGNFE ');
  qryAux.SQL.Add('  SET NFE_STATUS = :STATUS ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  NFE_NUMDOC = :NUMDOC AND ');
  If strEspDoc = 'IF' Then
  Begin
    qryAux.SQL.Add('  NFE_ESPDOC = "IF" AND ');
  End
  Else
  Begin
    qryAux.SQL.Add('  (NFE_ESPDOC = "NF" OR NFE_ESPDOC = "EL") AND ');
  End;
  qryAux.SQL.Add('  NFE_CODEMP = :CODEMP AND ');
  qryAux.SQL.Add('  NFE_CODCLI = :CODCLI AND ');
  qryAux.SQL.Add('  IFNULL(NFE_SERIE_, "") = :SERIE_ AND ');
  qryAux.SQL.Add('  NFE_TIP_FC = :TIP_FC');

  qryAux.ParamByName('NUMDOC').AsString := edtNumDoc.Text;
  qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryAux.ParamByName('CODCLI').AsString := edtCliFor.Text;
  qryAux.ParamByName('SERIE_').AsString := strSerie;
  qryAux.ParamByName('TIP_FC').AsString := strTip_Fc;
  qryAux.ParamByName('STATUS').AsString := strStatus;
  qryAux.ExecSQL;

  FreeAndNil(qryAux);
end;


procedure TfrmCancelamentoDocumentos.pAtualizaStatusPD(strNumDoc, strEspDoc,
  strCodEmp: String; blnFat: Boolean);
var
  strSQL,
  strFlxFas,
  strFlxSit,
  strFlxCom: String;
  qryEquger,
  qryAux   : TUniQuery;
begin
  if (strPDAtuOS = strNumDoc + '-' + strEspDoc + '-' + strCodEmp) then
    Exit;

  strPDAtuOS := strNumDoc + '-' + strEspDoc + '-' + strCodEmp;

  qryEquger := fCriaQuery;
  qryAux    := fCriaQuery;

  try
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '     EQUGER.AUTOINCREM, ';
    strSQL := strSQL + '     EQU_NUMOSE, ';
    strSQL := strSQL + '     EQU_CODEMP, ';
    strSQL := strSQL + '     EQU_FLXFAS, ';
    strSQL := strSQL + '     EQU_FLXSIT, ';
    strSQL := strSQL + '     EQU_FLXCOM  ';
    strSQL := strSQL + ' FROM EQUGER ';
    strSQL := strSQL + ' INNER JOIN FATGOR ON (FGO_NUMDOC = EQU_NUMPED ';
    strSQL := strSQL + '     AND FGO_ESPDOC = EQU_TIPPED ';
    strSQL := strSQL + '     AND FGO_CODEMP = EQU_EMPPED) ';

    if not blnFat then
    begin
      strSQL := strSQL + ' WHERE (FGO_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '     AND FGO_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '     AND FGO_CODEMP = :CODEMP) ';
    end
    else
    begin
      strSQL := strSQL + ' WHERE (FGO_NUMFAT = :NUMDOC ';
      strSQL := strSQL + '     AND FGO_TIPFAT = :ESPDOC ';
      strSQL := strSQL + '     AND FGO_EMPFAT = :CODEMP) ';
    end;

    strSQL := strSQL + ' UNION ';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '     EQUGER.AUTOINCREM, ';
    strSQL := strSQL + '     EQU_NUMOSE, ';
    strSQL := strSQL + '     EQU_CODEMP, ';
    strSQL := strSQL + '     EQU_FLXFAS, ';
    strSQL := strSQL + '     EQU_FLXSIT, ';
    strSQL := strSQL + '     EQU_FLXCOM  ';
    strSQL := strSQL + ' FROM EQUGER ';
    strSQL := strSQL + ' INNER JOIN EQUGOR ON (EQUGER.AUTOINCREM = EQUGOR.FGO_SEQEQU) ';
    strSQL := strSQL + ' INNER JOIN FATGOR ON (EQUGOR.FGO_SEQFGO = FATGOR.AUTOINCREM) ';

    if not blnFat then
    begin
      strSQL := strSQL + ' WHERE (FGO_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '     AND FGO_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '     AND FGO_CODEMP = :CODEMP) ';
    end
    else
    begin
      strSQL := strSQL + ' WHERE (FGO_NUMFAT = :NUMDOC ';
      strSQL := strSQL + '     AND FGO_TIPFAT = :ESPDOC ';
      strSQL := strSQL + '     AND FGO_EMPFAT = :CODEMP) ';
    end;

    qryEquger.SQL.Text := strSQL;

    strSQL := '';
    strSQL := strSQL + ' UPDATE EQUGER ';
    strSQL := strSQL + ' SET EQU_FLXFAS = :FLXFAS, ';
    strSQL := strSQL + '     EQU_FLXSIT = :FLXSIT, ';
    strSQL := strSQL + '     EQU_FLXCOM = :FLXCOM  ';
    strSQL := strSQL + ' WHERE AUTOINCREM = :AUTINC ';
    qryAux.SQL.Text := strSQL;

    qryEquger.Close;
    qryEquger.ParamByName('NUMDOC').AsString := strNumDoc;
    qryEquger.ParamByName('ESPDOC').AsString := strEspDoc;
    qryEquger.ParamByName('CODEMP').AsString := strCodEmp;
    qryEquger.Open;

    if (qryEquger.FieldByName('EQU_FLXSIT').AsString = 'FA') then
    begin
      qryAux.Close;
      qryAux.ParamByName('AUTINC').AsString := qryEquger.FieldByName('AUTOINCREM').AsString;

      if (qryEquger.FieldByName('EQU_FLXCOM').AsString = 'ER') then
      begin
        strFlxFas := 'R';
        strFlxSit := 'AF';
        strFlxCom := 'ER';
      end
      else if (qryEquger.FieldByName('EQU_FLXCOM').AsString = 'AR') then
      begin
        strFlxFas := 'M';
        strFlxSit := 'AR';
        strFlxCom := 'AF';
      end
      else
      begin
        strFlxFas := 'M';
        strFlxSit := 'MF';
        strFlxCom := 'AA';
      end;

      qryAux.ParamByName('FLXFAS').AsString := strFlxFas;
      qryAux.ParamByName('FLXSIT').AsString := strFlxSit;
      qryAux.ParamByName('FLXCOM').AsString := strFlxCom;

      qryAux.ExecSQL;

      if (strFlxFas <> qryEquger.FieldByName('EQU_FLXFAS').AsString) or
        (strFlxSit <> qryEquger.FieldByName('EQU_FLXSIT').AsString) or
        (strFlxCom <> qryEquger.FieldByName('EQU_FLXCOM').AsString) then
        pInsereLogFlxOS(qryEquger.FieldByName('EQU_NUMOSE').AsString, qryEquger.FieldByName('EQU_CODEMP').AsString,
          qryEquger.FieldByName('EQU_FLXFAS').AsString, qryEquger.FieldByName('EQU_FLXSIT').AsString, qryEquger.FieldByName('EQU_FLXCOM').AsString,
          strFlxFas, strFlxSit, strFlxCom);
    end;
  finally
    FreeAndNil(qryEquger);
    FreeAndNil(qryAux);
  end;
end;

procedure TfrmCancelamentoDocumentos.pAtualizaStatusPedidos;
var
  intCont: Integer;
begin
  if Length(ArrayPedidos) > 0 then
  begin
    for intCont := Low(ArrayPedidos) to High(ArrayPedidos) do
    begin
      TUpdateStatus.New(TParamStatus.New()
                        .NumDoc(ArrayPedidos[intCont].strNumPed)
                        .EspDoc(ArrayPedidos[intCont].strEspPed)
                        .CodEmp(ArrayPedidos[intCont].strEmpPed)
                        .CodCli(ArrayPedidos[intCont].strCodCli)).pExecute();
    end;
  end;

  if Length(ArrayPedDevolucao) > 0 then
  begin
    for intCont := Low(ArrayPedDevolucao) to High(ArrayPedDevolucao) do
    begin
      TUpdateStatus.New(TParamStatus.New()
                        .NumDoc(ArrayPedDevolucao[intCont].strNumPed)
                        .EspDoc(ArrayPedDevolucao[intCont].strEspPed)
                        .CodEmp(ArrayPedDevolucao[intCont].strEmpPed)
                        .CodCli(ArrayPedDevolucao[intCont].strCodCli)).pExecute();
    end;
  end;
end;

