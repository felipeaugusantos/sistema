function TfrmCancelamentoDocumentos.fPedidoCompraBaixado(strEspSel,
  strNumDoc: String; qryAux001: TUniQuery): Boolean;
  Var
    strSQL: String;
begin

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  PCD_QTDBAI, ';
  strSQL := strSQL + '  PCD_BAIXAD, ';
  strSQL := strSQL + '  PCG_NUMPED, ';
  strSQL := strSQL + '  PCG_CODFOR ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  PCMGER, ';
  strSQL := strSQL + '  PCMDET ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  PCD_NUMPED = PCG_NUMPED AND ';
  strSQL := strSQL + '  PCD_ESPDOC = PCG_ESPDOC AND ';
  strSQL := strSQL + '  PCD_CODEMP = PCG_CODEMP AND ';
  strSQL := strSQL + '  PCD_NUMCTN = 0 AND ';
  strSQL := strSQL + '  PCD_DOCORI = :DOCORI ';

  If (Not fSuportaInterfaceGrafica) Then
    strSQL := strSQL + '  AND FALSE ';

  With qryAux001 Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('DOCORI').AsString := strNumDoc + strEspSel + VS_strCodEmp;
    Open;

    If (IsEmpty) Then
    Begin
      Result := False;
      Exit;
    End;

    Result := False;
    While (Not Eof) Do
    Begin
      If (FieldByName('PCD_QTDBAI').AsInteger > 0) Or (FieldByName('PCD_BAIXAD').AsInteger > 0) Then
      Begin
        Result := True;
        Break;
      End;
      Next;
    End;

  End;

end;

function TfrmCancelamentoDocumentos.fPedidoEntradaMercadoria(strNumPed: String): Boolean;
var qryPedido: TUniQuery;
    strSQL: String;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT  EXTGOR.FGO_DOCEND,EXTGOR.* ';
  strSQL := strSQL + 'FROM FATGOR ';
  strSQL := strSQL + 'INNER JOIN EXTGOR ON FGO_SEQFGO = AUTOINCREM  ';
  strSQL := strSQL + 'WHERE FGO_NUMDOC = :NUMDOC ';
  strSQL := strSQL + 'AND   FATGOR.FGO_CODEMP = :CODEMP ';
  strSQL := strSQL + 'AND   COALESCE(FGO_DOCEND, "") <> "" AND IFNULL(FGO_BKPEND, "") = "";';
