function TfrmCancelamentoDocumentos.fEhUltimaNotaDoItem(strEspDoc,
  strNumDoc, strCliFor, strSerie, strCodIte: String; Var fltPreMed, fltPreUlt, fltImpUlt, fltCotMoe: Double; Var strSeqUlt: String; var blnAtuPreMed: Boolean): Boolean;
  Var
    qryMovDet: TUniQuery;
    strClaFisBonificacao: String;

  Function fSQLUltCompra: String;
    Var
      strSQL: String;
  Begin
    strSQL := '';

    strSQL := strSQL + ' (SELECT ';
    strSQL := strSQL + '    DET_DTAENT, ';
    strSQL := strSQL + '    DET_HORENT, ';
    strSQL := strSQL + '    DET_NUMDOC, ';
    strSQL := strSQL + '    DET_ESPDOC, ';
    strSQL := strSQL + '    DET_CODEMP, ';
    strSQL := strSQL + '    IFNULL(DET_SERIE_, "") AS DET_SERIE_, ';
    strSQL := strSQL + '    DET_CODFOR, ';
    strSQL := strSQL + '    IFNULL(DET_MEDANT, 0) AS DET_MEDANT, ';
    strSQL := strSQL + '    IFNULL(DET_PREANT, 0) AS DET_PREANT, ';
    strSQL := strSQL + '    IFNULL(DET_IMPANT, 0) AS DET_IMPANT, ';
    strSQL := strSQL + '    IFNULL(DET_SEQANT, "") AS DET_SEQANT,  ';
    strSQL := strSQL + '    IFNULL(AUX_COTMOE, 0) AS AUX_COTMOE  ';

    strSQL := strSQL + '  FROM MOVDET D     ';
    strSQL := strSQL +  ' INNER JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM ';

    strSQL := strSQL +  ' LEFT JOIN AUXMOV A ON A.AUX_SEQGER = D.DET_SEQGER ';

    strSQL := strSQL + '  WHERE ';
    strSQL := strSQL + '    DET_CODITE = :CODITE AND ';
    strSQL := strSQL + '    DET_TIP_FC = "F" AND ';

    strSQL := strSQL + '  ( ';
    strSQL := strSQL + '   (DET_CODFOR NOT IN (' + fRetForFilialTodos(True) + ') AND ';
    strSQL := strSQL + '    LOCATE(DET_CLAFIS, :CLACOM) > 0) OR ';

    If fCfgSis('ATUMED', varBoolean) Then
      strSQL := strSQL + ' (DET_CODFOR IN (' + fRetForFilialTodos(True) + ')) '
    Else
      strSQL := strSQL + ' FALSE ';

    strSQL := strSQL + '  ) ';
//    strSQL := strSQL + ' AND (( DET_ESPDOC = "NF") OR  (' + IIf(fCfgSis('MEDSE2', varBoolean ), 'TRUE', 'FALSE')+ '))';

    strSQL := strSQL +  ' AND DET_CODEMP = :CODEMP ';

    strSQL := strSQL + '  AND (LOCATE(DET_CLAFIS, "1922_2922_") <= 0) ';

    strSQL := strSQL + '  ORDER BY  ';
    strSQL := strSQL + '    DET_DTAENT DESC, DET_HORENT DESC ';
    strSQL := strSQL + '  LIMIT 1 )';

    Result := strSQL;
  End;

  Function fSQLUltimaCompra: String;
    Var
      strSQL: String;
  Begin
    strSQL := '';

    strSQL := strSQL + ' (SELECT DET_NUMDOC, DET_ESPDOC, DET_CODEMP, DET_SERIE_, DET_CODFOR, ';
    strSQL := strSQL + '    IFNULL(DET_MEDANT, 0) AS DET_MEDANT, ';
    strSQL := strSQL + '    IFNULL(DET_PREANT, 0) AS DET_PREANT, ';
    strSQL := strSQL + '    IFNULL(DET_IMPANT, 0) AS DET_IMPANT, ';
    strSQL := strSQL + '    IFNULL(DET_SEQANT, "") AS DET_SEQANT, ';
    strSQL := strSQL + '    IFNULL(AUX_COTMOE, 0) AS AUX_COTMOE ';
    strSQL := strSQL + '  FROM (';

    strSQL := strSQL + fSQLUltCompra;

    strSQL := strSQL + ' ) AS TAB ORDER BY  ';
    strSQL := strSQL + '     DET_DTAENT DESC , DET_HORENT DESC ';
    strSQL := strSQL + '  LIMIT 1 )';

    Result := strSQL;
  End;

Begin
  fltPreMed := 0;
  fltPreUlt := 0;
  fltImpUlt := 0;
  fltCotMoe := 0;
  strSeqUlt := '';
  Result    := False;

  strClaFisBonificacao := fRetornarClassificacoesBonificacaoEntrada;

  qryMovDet := fCriaQuery(Self);

  With qryMovDet, SQL Do
  Begin
    Text := fSQLUltimaCompra;

    ParamByName('CODEMP').AsString := VS_strCodEmp;
    ParamByName('CODITE').AsString := strCodIte;
    ParamByName('CLACOM').AsString := VS_strClaCom + '_1117_2117_1116_2116' + strClaFisBonificacao;

    Open;

    If (Not IsEmpty) And
       (FieldByName('DET_ESPDOC').AsString = strEspDoc) And
       (FieldByName('DET_NUMDOC').AsString = strNumDoc) And
       (FieldByName('DET_CODFOR').AsString = strCliFor) And
       (FieldByName('DET_SERIE_').AsString = strSerie)  And
       (FieldByName('DET_MEDANT').AsFloat >= 0) And
       (FieldByName('DET_PREANT').AsFloat >= 0) And
       (FieldByName('DET_IMPANT').AsFloat >= 0) Then
    Begin
      blnAtuPreMed := (FieldByName('DET_ESPDOC').AsString = 'NF') Or
                      (fCfgSis('MEDSE2', varBoolean ) And (FieldByName('DET_ESPDOC').AsString = 'PD'));

      fltPreMed := FieldByName('DET_MEDANT').AsFloat;
      fltPreUlt := FieldByName('DET_PREANT').AsFloat;
      fltImpUlt := FieldByName('DET_IMPANT').AsFloat;
      strSeqUlt := FieldByName('DET_SEQANT').AsString;
      fltCotMoe := FieldByName('AUX_COTMOE').AsFloat;

      Result    := True;
    End;

  End;
  FreeAndNil(qryMovDet);

End;

function TfrmCancelamentoDocumentos.fRestauraNOTDET(strCodEmp, strNumDoc, strCodFor, strSerie: string): Boolean;
var qryRes, qryCadFis, qryDel: TUniQuery;
  procedure pSetParamns(qry: TUniQuery);
  Begin
    qry.ParamByName('NUMDOC').AsString := strNumDoc;
    qry.ParamByName('SERIE_').AsString := strSerie;
    qry.ParamByName('CODFOR').AsString := strCodFor;
    qry.ParamByName('CODEMP').AsString := strCodEmp;
  End;
begin
  Result := True;
  qryRes := fCriaQuery;
  qryDel := fCriaQuery;
  qryCadFis := fCriaQuery;
  Try
    Try

      qryDel.SQL.Clear;
      qryDel.SQL.Add('SELECT * FROM DEL_NOTGER ');
      qryDel.SQL.Add(' WHERE GER_NUMDOC = :NUMDOC');
      qryDel.SQL.Add('   AND GER_ESPDOC = "NF"');
      qryDel.SQL.Add('   AND GER_SERIE_ = :SERIE_');
      qryDel.SQL.Add('   AND GER_CODFOR = :CODFOR');
      qryDel.SQL.Add('   AND GER_CODEMP = :CODEMP');
      qryDel.SQL.Add('   AND GER_ESTADO = "EX"');

      pSetParamns(qryDel);
      qryDel.Open;

      If qryDel.IsEmpty Then
        Exit;
      result := fRestauraRegitro_DEL('NOTGER', qryDel);

      If Not Result Then
        Exit;

      qryDel.SQL.Clear;

      qryDel.SQL.Add('DELETE FROM DEL_NOTGER ');
      qryDel.SQL.Add(' WHERE GER_NUMDOC = :NUMDOC');
      qryDel.SQL.Add('   AND GER_ESPDOC = "NF"');
      qryDel.SQL.Add('   AND GER_SERIE_ = :SERIE_');
      qryDel.SQL.Add('   AND GER_CODFOR = :CODFOR');
      qryDel.SQL.Add('   AND GER_CODEMP = :CODEMP');
      pSetParamns(qryDel);
      qryDel.ExecSQL;

      qryDel.SQL.Clear;
      qryDel.SQL.Add('SELECT * FROM DEL_NOTDET ');
      qryDel.SQL.Add(' WHERE DET_NUMDOC = :NUMDOC');
      qryDel.SQL.Add('   AND DET_ESPDOC = "NF"');
      qryDel.SQL.Add('   AND DET_SERIE_ = :SERIE_');
      qryDel.SQL.Add('   AND DET_CODFOR = :CODFOR');
      qryDel.SQL.Add('   AND DET_CODEMP = :CODEMP');
      pSetParamns(qryDel);
      qryDel.Open;

      result :=fRestauraRegitro_DEL('NOTDET', qryDel);

      If Not Result Then
        Exit;

      qryDel.SQL.Clear;
      qryDel.SQL.Add('DELETE FROM DEL_NOTDET ');
      qryDel.SQL.Add(' WHERE DET_NUMDOC = :NUMDOC');
      qryDel.SQL.Add('   AND DET_ESPDOC = "NF"');
      qryDel.SQL.Add('   AND DET_SERIE_ = :SERIE_');
      qryDel.SQL.Add('   AND DET_CODFOR = :CODFOR');
      qryDel.SQL.Add('   AND DET_CODEMP = :CODEMP');
      pSetParamns(qryDel);
      qryDel.ExecSQL;

      qryDel.SQL.Clear;
      qryDel.SQL.Add('SELECT * FROM DEL_CADFIS');
      qryDel.SQL.Add('WHERE');
      qryDel.SQL.Add('  FIS_TIP_FC = "F" AND');
      qryDel.SQL.Add('  FIS_NUMDOC = :NUMDOC AND');
      qryDel.SQL.Add('  FIS_ESPDOC = "NF" AND');
      qryDel.SQL.Add('  FIS_CODEMP = :CODEMP AND');
      qryDel.SQL.Add('  FIS_FORCLI = :CODFOR AND');
      qryDel.SQL.Add('  FIS_ORIDOC = "V" AND ');
      qryDel.SQL.Add('  IFNULL(FIS_SERIE_, "") = :SERIE_ ');
      pSetParamns(qryDel);
      qryDel.Open;
      If qryDel.RecordCount > 0 Then
      Begin
        qryCadFis.SQL.Clear;
        qryCadFis.SQL.Add('SELECT FIS_NUMDOC FROM CADFIS');
        qryCadFis.SQL.Add('WHERE');
        qryCadFis.SQL.Add('  FIS_TIP_FC = "F" AND');
        qryCadFis.SQL.Add('  FIS_NUMDOC = :NUMDOC AND');
        qryCadFis.SQL.Add('  FIS_ESPDOC = "NF" AND');
        qryCadFis.SQL.Add('  FIS_CODEMP = :CODEMP AND');
        qryCadFis.SQL.Add('  FIS_FORCLI = :CODFOR AND');
        qryCadFis.SQL.Add('  FIS_ORIDOC <> "V" AND ');
        qryCadFis.SQL.Add('  IFNULL(FIS_SERIE_, "") = :SERIE_ ');
        pSetParamns(qryCadFis);
        qryCadFis.Open;
        If qryCadFis.RecordCount > 0 Then
        Begin
          qryCadFis.SQL.Clear;

          qryCadFis.SQL.Add('DELETE FROM CADFIS');
          qryCadFis.SQL.Add('WHERE');
          qryCadFis.SQL.Add('  FIS_TIP_FC = "F" AND');
          qryCadFis.SQL.Add('  FIS_NUMDOC = :NUMDOC AND');
          qryCadFis.SQL.Add('  FIS_ESPDOC = "NF" AND');
          qryCadFis.SQL.Add('  FIS_CODEMP = :CODEMP AND');
          qryCadFis.SQL.Add('  FIS_FORCLI = :CODFOR AND');
          qryCadFis.SQL.Add('  FIS_ORIDOC <> "V" AND ');
          qryCadFis.SQL.Add('  IFNULL(FIS_SERIE_, "") = :SERIE_ ');
          pSetParamns(qryCadFis);
          qryCadFis.ExecSQL;
        End;
      End;

      result := fRestauraRegitro_DEL('CADFIS', qryDel);

      If Not Result Then
        Exit;

      qryDel.SQL.Clear;
      qryDel.SQL.Add('DELETE FROM DEL_CADFIS');
      qryDel.SQL.Add('WHERE');
      qryDel.SQL.Add('  FIS_TIP_FC = "F" AND');
      qryDel.SQL.Add('  FIS_NUMDOC = :NUMDOC AND');
      qryDel.SQL.Add('  FIS_ESPDOC = "NF" AND');
      qryDel.SQL.Add('  FIS_CODEMP = :CODEMP AND');
      qryDel.SQL.Add('  FIS_FORCLI = :CODFOR AND');
      qryDel.SQL.Add('  IFNULL(FIS_SERIE_, "") = :SERIE_ ');
      pSetParamns(qryDel);
      qryDel.ExecSQL;

      qryRes.SQL.Add('UPDATE DOCIMP');
      qryRes.SQL.Add('   SET IMP_SEQDET = IMP_OLDNTD');
      qryRes.SQL.Add(' WHERE IMP_OLDNTD IN (SELECT AUTOINCREM');
      qryRes.SQL.Add('                        FROM NOTDET');
      qryRes.SQL.Add('                       WHERE DET_NUMDOC = :NUMDOC');
      qryRes.SQL.Add('                         AND DET_ESPDOC = "NF"');
      qryRes.SQL.Add('                         AND DET_SERIE_ = :SERIE_');
      qryRes.SQL.Add('                         AND DET_CODFOR = :CODFOR');
      qryRes.SQL.Add('                         AND DET_CODEMP = :CODEMP)');
      pSetParamns(qryRes);
      qryRes.ExecSQL;

      qryRes.SQL.Clear;
      qryRes.SQL.Add('SELECT * FROM DOCIMP');
      qryRes.SQL.Add(' WHERE IMP_OLDNTD IN (SELECT AUTOINCREM');
      qryRes.SQL.Add('                        FROM NOTDET');
      qryRes.SQL.Add('                       WHERE DET_NUMDOC = :NUMDOC');
      qryRes.SQL.Add('                         AND DET_ESPDOC = "NF"');
      qryRes.SQL.Add('                         AND DET_SERIE_ = :SERIE_');
      qryRes.SQL.Add('                         AND DET_CODFOR = :CODFOR');
      qryRes.SQL.Add('                         AND DET_CODEMP = :CODEMP)');
      pSetParamns(qryRes);
      qryRes.Open;

      blnNotaImportacao := qryRes.RecordCount > 0;

    Except
      Result := False;
    End;
  Finally
    FreeAndNil(qryDel);
    FreeAndNil(qryCadFis);
    FreeAndNil(qryRes);
  End
end;

Procedure TfrmCancelamentoDocumentos.pRestauraPrecoMedio(strCodIte, strSeqUlt: String; fltPreMed, fltPreUlt, fltImpUlt, fltCotMoe: Double; blnAtuPreMed: Boolean);
  Var
    qryIteger: TUniQuery;
    strNotUlt,
    strNumDoc, strEspDoc, strCodEmp, strSerie, strCodFor: String;
    dtaDtaUlt: TDate;
    fltQtdUCo: Double;
    blnAchouNota: Boolean;

    function fLocalizaDocAnt(var AfltPreMed, AfltPreUlt, AfltImpUlt, AfltCotMoe: Double; blnDel: boolean = False): boolean;

      var strNotUltEncontrada:string;
    begin
      Result := False;

      qryIteger.SQL.Clear;

      If blnDel Then
      Begin
        qryIteger.SQL.Add('SELECT DET_MEDANT, ');
        qryIteger.SQL.Add('       DET_PREANT, ');
        qryIteger.SQL.Add('       DET_IMPANT, ');
        qryIteger.SQL.Add('       DET_SEQANT, ');
        qryIteger.SQL.Add('       DET_NUMDOC, ');
        qryIteger.SQL.Add('       DET_ESPDOC, ');
        qryIteger.SQL.Add('       IFNULL(DET_SERIE_, "") AS DET_SERIE_, ');
        qryIteger.SQL.Add('       DET_CODEMP, ');
        qryIteger.SQL.Add('       DET_CODFOR, ');
        qryIteger.SQL.Add('       AUX_COTMOE  ');
        qryIteger.SQL.Add('  FROM DEL_MOVDET DEL ');
        qryIteger.SQL.Add(' INNER JOIN DEL_MOVTRI T ON T.DET_SEQGER = DEL.AUTOINCREM ');
        qryIteger.SQL.Add(' LEFT JOIN DEL_AUXMOV A ON A.AUX_SEQGER = DEL.DET_SEQGER ');
        qryIteger.SQL.Add(' WHERE DEL.AUTOINCREM = :AUTOINCREM ');
        qryIteger.SQL.Add(' ORDER BY DEL.AUTOINCREM DESC ');
      end
      Else
      begin
        qryIteger.SQL.Add(' SELECT DET_QTDITE, ');
        qryIteger.SQL.Add('        DET_DTAENT,                   ');
        qryIteger.SQL.Add('        AUX_COTMOE,                   ');
        qryIteger.SQL.Add('        DET_SEQANT, ');
        qryIteger.SQL.Add('        DET_NUMDOC, ');
        qryIteger.SQL.Add('        DET_ESPDOC, ');
        qryIteger.SQL.Add('        IFNULL(DET_SERIE_, "") AS DET_SERIE_, ');
        qryIteger.SQL.Add('        DET_CODEMP, ');
        qryIteger.SQL.Add('        DET_CODFOR ');

        qryIteger.SQL.Add(' FROM MOVDET D                        ');
        qryIteger.SQL.Add(' LEFT JOIN AUXMOV A ON A.AUX_SEQGER = D.DET_SEQGER ');
        qryIteger.SQL.Add(' INNER JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM ');
        qryIteger.SQL.Add(' WHERE D.AUTOINCREM = :AUTOINCREM ');
        qryIteger.SQL.Add(' ORDER BY D.AUTOINCREM DESC ');
      end;

      qryIteger.ParamByName('AUTOINCREM').AsString := strSeqUlt;

      qryIteger.Open;
      If (Not qryIteger.IsEmpty) Then
        Result := True;

      If Result Or blnDel Then
      Begin
        strNumDoc := qryIteger.FieldByName('DET_NUMDOC').AsString;
        strEspDoc := qryIteger.FieldByName('DET_ESPDOC').AsString;
        strCodEmp := qryIteger.FieldByName('DET_CODEMP').AsString;
        strSerie  := qryIteger.FieldByName('DET_SERIE_').AsString;
        strCodFor := qryIteger.FieldByName('DET_CODFOR').AsString;
        strNotUltEncontrada := fCodificaChaveNota(strNumDoc, strEspDoc, strCodEmp, strSerie, strCodFor);
        strNotUlt := strNotUltEncontrada;


        AfltCotMoe := qryIteger.FieldByName('AUX_COTMOE').AsFloat;
        Exit;
      End;

      If fLocalizaDocAnt(AfltPreMed, AfltPreUlt, AfltImpUlt, AfltCotMoe, True) Then
      Begin
        if fEmptyStr(qryIteger.FieldByName('DET_SEQANT').AsString)  Then
          Exit(False);
        strNumDoc := qryIteger.FieldByName('DET_NUMDOC').AsString;
        strEspDoc := qryIteger.FieldByName('DET_ESPDOC').AsString;
        strCodEmp := qryIteger.FieldByName('DET_CODEMP').AsString;
        strSerie  := qryIteger.FieldByName('DET_SERIE_').AsString;
        strCodFor := qryIteger.FieldByName('DET_CODFOR').AsString;

        strSeqUlt  := qryIteger.FieldByName('DET_SEQANT').AsString;
        strNotUltEncontrada := fCodificaChaveNota(strNumDoc, strEspDoc, strCodEmp, strSerie, strCodFor);
        If Not fEmptyStr(strNotUltEncontrada) Then
        Begin
          AfltPreMed := qryIteger.FieldByName('DET_MEDANT').AsFloat;
          AfltPreUlt := qryIteger.FieldByName('DET_PREANT').AsFloat;
          AfltImpUlt := qryIteger.FieldByName('DET_IMPANT').AsFloat;
          AfltCotMoe := qryIteger.FieldByName('AUX_COTMOE').AsFloat;
        End;

        Result := fLocalizaDocAnt(AfltPreMed, AfltPreUlt, AfltImpUlt, AfltCotMoe);
        If Result Then
        Begin
          strNotUltEncontrada := fCodificaChaveNota(strNumDoc, strEspDoc, strCodEmp, strSerie, strCodFor);
          strNotUlt := strNotUltEncontrada;
          strNumDoc := qryIteger.FieldByName('DET_NUMDOC').AsString;
          strEspDoc := qryIteger.FieldByName('DET_ESPDOC').AsString;
          strCodEmp := qryIteger.FieldByName('DET_CODEMP').AsString;
          strSerie  := qryIteger.FieldByName('DET_SERIE_').AsString;
          strCodFor := qryIteger.FieldByName('DET_CODFOR').AsString;

        End
        Else
        begin
          strNotUlt := '';
          strNumDoc := '';
          strEspDoc := '';
          strCodEmp := '';
          strSerie  := '';
          strCodFor := '';
          AfltPreMed := 0;
          AfltPreUlt := 0;
          AfltImpUlt := 0;
          AfltCotMoe := 0;
        End;
      End;

    End;
Begin
  fltQtdUCo := 0;
  dtaDtaUlt := 0;
  blnAchouNota := False;


  qryIteger := fCriaQuery(Self);

  If Not fEmptyStr(strSeqUlt) Then
  Begin
    With qryIteger, SQL Do
    Begin
      Clear;
      If (fLocalizaDocAnt(fltPreMed, fltPreUlt, fltImpUlt, fltCotMoe)) and (Not IsEmpty) Then      Begin
        fltQtdUCo := FieldByName('DET_QTDITE').AsFloat;
        dtaDtaUlt := FieldByName('DET_DTAENT').AsDateTime;
      End;

      blnAchouNota := Not IsEmpty;
    End;
  End;

  With qryIteger, SQL Do
  Begin
    Clear;
    Add('UPDATE ITEGER SET ');

    Add('  ITE_NOTULT = :NOTULT, ');
    Add('  ITE_ULTCOT = :ULTCOT, ');
    Add('  ITE_FORULT = :FORULT, ');
    Add('  ITE_PREULT = :PREULT, ');
    Add('  ITE_IMPULT = :IMPULT, ');
    Add('  ITE_DTAULT = :DTAULT, ');
    Add('  ITE_QTDUCO = :QTDUCO ');

    If blnAtuPreMed Then
      Add('  ,ITE_PREMED = :PREMED ');

    Add('WHERE ');

    Add('  ITE_CODITE = :CODITE AND');
    Add('  ITE_CODEMP = :CODEMP');

    ParamByName('PREULT').AsFloat := fltPreUlt;
    ParamByName('IMPULT').AsFloat := fltImpUlt;
    ParamByName('ULTCOT').AsFloat := fltCotMoe;

    If blnAtuPreMed Then
      ParamByName('PREMED').AsFloat := fltPreMed;

    If Not fEmptyStr(strNotUlt) and (fExisteFornecedor(strCodFor)) Then
    Begin
      ParamByName('NOTULT').AsString := strNotUlt;
      If fRetStatusFornecedor(strCodFor) Then
        ParamByName('FORULT').AsString := strCodFor
      Else
        ParamByName('FORULT').Clear;
    End;

    If blnAchouNota Then
    Begin
      ParamByName('DTAULT').AsDate   := dtaDtaUlt;
      ParamByName('QTDUCO').AsFloat  := fltQtdUCo;
    End;

    ParamByName('CODITE').AsString := strCodIte;
    ParamByName('CODEMP').AsString := VS_strCodEmp;

    ExecSQL;
  End;
  FreeAndNil(qryIteger);
End;

Procedure TfrmCancelamentoDocumentos.pVoltaContasAPagarConfirmadas(strNumDoc, strCodEmp, strEspDoc: String);
  Var
    qryCtpCnf: TUniQuery;
    qryDetCnf: TUniQuery;

    qryCadPag: TUniQuery;
    qryCtpDet: TUniQuery;

    strSQL   : String;

    Procedure pCopiaCadPag;
      Var
        intContador: Integer;
    Begin
      qryCadPag.Insert;

      For intContador := 0 To qryCadPag.Fields.Count - 1 Do
        qryCadPag.Fields[intContador].Value := qryCtpCnf.FieldByName(qryCadPag.Fields[intContador].FieldName).Value;

      qryCadPag.Post;
    end;

    Procedure pCopiaCtpDet;
      Var
        intContador: Integer;
    Begin
      qryCtpDet.Insert;

      For intContador := 0 To qryCtpDet.Fields.Count - 1 Do
        qryCtpDet.Fields[intContador].Value := qryDetCnf.FieldByName(qryCtpDet.Fields[intContador].FieldName).Value;

      qryCtpDet.Post;
    end;

    Procedure pSelecionaCTPDET;
      Var
        strSQL   : String;
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  * ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CTPDETCNF ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  CTP_SEQCTP = :SEQCTP ';

      qryDetCnf.Close;
      qryDetCnf.SQL.Clear;
      qryDetCnf.SQL.Add(strSQL);
      qryDetCnf.ParamByName('SEQCTP').AsString := qryCtpCnf.FieldByName('AUTOINCREM').AsString;
      qryDetCnf.Open;
    End;

Begin
  strSQL := '';
  strSQL := strSQL + ' SELECT C.* FROM CTPCNF C ';
  strSQL := strSQL + ' INNER JOIN MOVGER G ON G.AUTOINCREM = C.CTP_DOCCNF  ';
  strSQL := strSQL + ' WHERE   ';
  strSQL := strSQL + '   GER_NUMFAT = :NUMFAT AND ';
  strSQL := strSQL + '   GER_EMPFAT = :EMPFAT AND ';
  strSQL := strSQL + '   GER_TIPFAT = :TIPFAT     ';

  qryCtpCnf := fCriaQuery;
  qryDetCnf := fCriaQuery;
  qryCadPag := fCriaQuery;
  qryCtpDet := fCriaQuery;

  qryCadPag.SQL.Text := 'SELECT * FROM CADPAG WHERE FALSE';
  qryCadPag.Open;

  qryCtpDet.SQL.Text := 'SELECT * FROM CTPDET WHERE FALSE';
  qryCtpDet.Open;

  With qryCtpCnf Do
  Begin
    SQL.Text := strSQL;

    ParamByName('NUMFAT').AsString := strNumDoc;
    ParamByName('EMPFAT').AsString := strCodEmp;
    ParamByName('TIPFAT').AsString := strEspDoc;

    Open;

    While Not Eof Do
    Begin
      pCopiaCadPag;

      pSelecionaCTPDET;

      While Not qryDetCnf.Eof Do
      Begin
        pCopiaCtpDet;
        qryDetCnf.Delete;
      End;

      Delete;
    End;

  End;

  FreeAndNil(qryCtpCnf);
  FreeAndNil(qryDetCnf);
  FreeAndNil(qryCadPag);
  FreeAndNil(qryCtpDet);
End;

function TfrmCancelamentoDocumentos.fCancelaTLBaixaEntregaFutura(strNumDoc, strEspDoc, strCodEmp, strCodCli, strSeqDet: String): Boolean;
  Var
    strAutInc: String;
    qryMovGer,
    qryMovDet,
    qryMovObs,
    qryMovTri,
    qryMovRef,
    qryMovAux: TUniQuery;
begin
  Result := True;
  Try
    qryMovGer := fCriaQuery;
    qryMovDet := fCriaQuery;
    qryMovObs := fCriaQuery;
    qryMovTri := fCriaQuery;
    qryMovRef := fCriaQuery;
    qryMovAux := fCriaQuery;
    Try
      qryMovGer.Close;
      qryMovGer.SQL.Text :=
            ' SELECT M.AUTOINCREM FROM MOVGER M '+
            '     INNER JOIN AUXMOV A ON M.AUTOINCREM = A.AUX_SEQGER '+
            ' WHERE AUX_SEQDOR = :SEQORI AND '+
            '       GER_NUMFAT = :NUMDOC AND '+
            '       GER_TIPFAT = :ESPDOC AND '+
            '       GER_EMPFAT = :CODEMP AND '+
            '       GER_CLIFAT = :CODCLI AND '+
            '       GER_ESPDOC = "TL"        ';
      qryMovGer.ParamByName('NUMDOC').AsString := strNumDoc;
      qryMovGer.ParamByName('ESPDOC').AsString := strEspDoc;
      qryMovGer.ParamByName('CODEMP').AsString := strCodEmp;
      qryMovGer.ParamByName('CODCLI').AsString := strCodCli;
      qryMovGer.ParamByName('SEQORI').AsString := strSeqDet;
      qryMovGer.Open;

      If Not qryMovGer.IsEmpty Then
      Begin
        strAutInc := qryMovGer.FieldByName('AUTOINCREM').AsString;

        qryMovGer.Close;
        qryMovGer.SQL.Text := 'SELECT * FROM MOVGER WHERE AUTOINCREM = :AUTINC';
        qryMovGer.ParamByName('AUTINC').AsString := strAutInc;
        qryMovGer.Open;

        qryMovDet.Close;
        qryMovDet.SQL.Text := 'SELECT * FROM MOVDET WHERE DET_SEQGER = :AUTINC';
        qryMovDet.ParamByName('AUTINC').AsString := strAutInc;
        qryMovDet.Open;
        qryMovDet.First;

        If Not qryMovDet.IsEmpty Then
        Begin
          While Not qryMovDet.Eof Do
          Begin
            If LeftStr(qryMovDet.FieldByName('DET_CLAFIS').AsString, 1) >= '5' Then
            Begin
              Result := Result And objCadLot.fAtualizaEstoqueLote(qryMovDet.FieldByName('DET_CODITE').AsString,
                                                                  'E',
                                                                  qryMovDet.FieldByName('DET_NUMLOT').AsString,
                                                                  qryMovDet.FieldByName('DET_QTDITE').AsFloat);
            End
            Else
            Begin
              Result := Result And objCadLot.fAtualizaEstoqueLote(qryMovDet.FieldByName('DET_CODITE').AsString,
                                                                  'S',
                                                                  qryMovDet.FieldByName('DET_NUMLOT').AsString,
                                                                  qryMovDet.FieldByName('DET_QTDITE').AsFloat);
            End;

            qryMovTri.Close;
            qryMovTri.SQL.Text := 'SELECT * FROM MOVTRI WHERE DET_SEQGER = :SEQGER';
            qryMovTri.ParamByName('SEQGER').AsString := qryMovDet.FieldByName('AUTOINCREM').AsString;
            qryMovTri.Open;

            qryMovAux.Close;
            qryMovAux.SQL.Text := 'SELECT * FROM MOVAUX WHERE DET_SEQGER = :SEQGER';
            qryMovAux.ParamByName('SEQGER').AsString := qryMovDet.FieldByName('AUTOINCREM').AsString;
            qryMovAux.Open;

            fVerificaIntegridade(Self.Name, 'MOVDET', qryMovDet, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

            qryMovRef.Close;
            qryMovRef.SQL.Text := 'SELECT * FROM MOVREF WHERE REF_SEQGER = :AUTINC';
            qryMovRef.ParamByName('AUTINC').AsString := qryMovDet.FieldByName('AUTOINCREM').AsString;
            qryMovRef.Open;

            If Not qryMovRef.IsEmpty Then
            Begin
              qryMovRef.First;
              While Not qryMovRef.Eof Do
              Begin
                fVerificaIntegridade(Self.Name, 'MOVREF', qryMovRef, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
                fApagaRegistro('MOVREF', qryMovRef.FieldByName('REF_SEQGER').AsString);
                qryMovRef.Next;
              End;
            End;

            fVerificaIntegridade(Self.Name, 'MOVTRI', qryMovTri, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
            fVerificaIntegridade(Self.Name, 'MOVAUX', qryMovAux, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

            ReprocessarItem(qryMovDet.FieldByName('DET_CODITE').AsString, '', True, True);

            qryMovDet.Next;
          End;
        End;

        qryMovObs.Close;
        qryMovObs.SQL.Text := 'SELECT * FROM MOVOBS WHERE MOV_SEQGER = :SEQGER';
        qryMovObs.ParamByName('SEQGER').AsString := strAutInc;
        qryMovObs.Open;

        fVerificaIntegridade(Self.Name, 'MOVGER', qryMovGer, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
        pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_MOVGER', strAutInc);

        fVerificaIntegridade(Self.Name, 'MOVOBS', qryMovObs, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        qryMovGer.Close;
        qryMovGer.SQL.Text := 'DELETE FROM MOVDET WHERE DET_SEQGER = :AUTINC';
        qryMovGer.ParamByName('AUTINC').AsString := strAutInc;
        qryMovGer.ExecSQL;

        qryMovGer.Close;
        qryMovGer.SQL.Text := 'DELETE FROM MOVGER WHERE AUTOINCREM = :AUTINC';
        qryMovGer.ParamByName('AUTINC').AsString := strAutInc;
        qryMovGer.ExecSQL;
      End;
    Finally
      FreeAndNil(qryMovGer);
      FreeAndNil(qryMovDet);
      FreeAndNil(qryMovObs);
      FreeAndNil(qryMovTri);
      FreeAndNil(qryMovRef);
      FreeAndNil(qryMovAux);
    End;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[fCancelaTLBaixaEntregaFutura]');
      Result := False;
    End;
  End;
End;

