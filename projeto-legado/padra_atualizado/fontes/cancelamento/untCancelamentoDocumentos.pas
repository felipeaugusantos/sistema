                    strNumLotMovimentacaoEstoque := FieldByName(strSigDet + 'NUMLOT').AsString;
                    If Assigned(objEndDoc) Then
                      If (Not fCfgSis('MANEND', VarBoolean)) Then
                        If fCampoTabela('DET_EXTFUL', 'MOVTRI', ['DET_SEQGER'], [FieldByName('AUTOINCREM').AsString]) <> 'S' Then
                          strNumLotMovimentacaoEstoque := 'A DEFINIR';

                    Result := fAtualizaEstoque(FieldByName(strSigDet + 'CODITE').AsString,
                                     FieldByName(strSigDet + 'QTDITE').AsFloat,
                                     'E',
                                     strNumLotMovimentacaoEstoque,
                                     strEspDoc,
                                     blnFutLot);
                  End
                  Else
                  Begin
                    Result := fAtualizaEstoqueML(FieldByName(strSigDet + 'CODITE').AsString,
                                       -1 * FieldByName(strSigDet + 'QTDITE').AsFloat,
                                       FieldByName(strSigDet + 'NUMLOT').AsString);
                  End;

                End
                Else
                Begin
                  Result := TProdAcabado.fAtualizaEstoque(FieldByName(strSigDet + 'CODACA').AsString,
                                                FieldByName(strSigDet + 'EMPACA').AsString,
                                                FieldByName(strSigDet + 'CODEMP').AsString,
                                                'E',
                                                FieldByName(strSigDet + 'QTDITE').AsFloat);
                End;

              End;

            End
            Else
            Begin

              If (fRetornaDataBalanco(strCodIte, strCodEmp) < IIf(FieldByName(strSigDet + 'DTAENT').AsFloat = 0, fNow, FieldByName(strSigDet + 'DTAENT').AsFloat)) Then
              Begin
                If (FieldByName(strSigDet + 'PROACA').AsString <> 'S') Then
                Begin

                  If Not SameText(strEspDoc, 'ML') Then
                  Begin
                    Result := fAtualizaEstoque(FieldByName(strSigDet + 'CODITE').AsString,
                                     FieldByName(strSigDet + 'QTDITE').AsFloat,
                                     'S',
                                     FieldByName(strSigDet + 'NUMLOT').AsString,
                                     strEspDoc,
                                     blnFutLot);
                  End
                  Else
                  Begin
                    Result := fAtualizaEstoqueML(FieldByName(strSigDet + 'CODITE').AsString,
                                       FieldByName(strSigDet + 'QTDITE').AsFloat,
                                       FieldByName(strSigDet + 'NUMLOT').AsString);
                  End;

                End
                Else
                Begin
                  Result := TProdAcabado.fAtualizaEstoque(FieldByName(strSigDet + 'CODACA').AsString,
                                                FieldByName(strSigDet + 'EMPACA').AsString,
                                                FieldByName(strSigDet + 'CODEMP').AsString,
                                                'S',
                                                FieldByName(strSigDet + 'QTDITE').AsFloat);
                End;

              End;

            End;

          End;

          if not Result then
            Exit;

          If fFalhaEmTransacao Then
            Exit(False);

          {*******************************************}
          {* CASO SEJA 'NOTDET' NAO ATUALIZA ESTOQUE *}
          {****************************************MV*}
          If (Not blnAjusteSaldoExterno) And
             (Pos('NOTDET', strArqDet) <= 0)                                                         And
             (Pos('TINDET', strArqDet) <= 0)                                                         And
             (Pos('ITEM ESPECIAL', fRetNomProduto(FieldByName(strSigDet + 'CODITE').AsString)) <= 0) And
             (FieldByName(strSigDet + 'PROACA').AsString = 'S')                                      Then
          Begin

            If LeftStr(FieldByName(strSigDet + 'CLAFIS').AsString, 1) >= '5' Then
            Begin

              If (fRetornaDataBalanco(strCodIte, strCodEmp) < VS_Date) Then
              Begin
                If Not TProdAcabado.fAtualizaEstoque(FieldByName(strSigDet + 'CODACA').AsString,
                                                     FieldByName(strSigDet + 'EMPACA').AsString,
                                                     FieldByName(strSigDet + 'CODEMP').AsString,
                                                     'E',
                                                     FieldByName(strSigDet + 'QTDITE').AsFloat) Then
                Begin
                  Result := False;
                  Exit;
                End;
              End;

            End
            Else
            Begin

              If (fRetornaDataBalanco(strCodIte, strCodEmp) < FieldByName(strSigDet + 'DTAENT').AsFloat) Then
              Begin
                if StrToIntDef(fCfgSis('ESTFLJ'), 1) = 1 then
                begin
                  If Not TProdAcabado.fAtualizaEstoque(FieldByName(strSigDet + 'CODACA').AsString,
                                                       FieldByName(strSigDet + 'EMPACA').AsString,
                                                       FieldByName(strSigDet + 'CODEMP').AsString,
                                                       'S',
                                                       FieldByName(strSigDet + 'QTDITE').AsFloat) Then
                  Begin
                    Result := False;
                    Exit;
                  End;
                end;
              End;
            End;

          End;

          {***********************************************************************************************}
          {* DEVE BAIXAR O ESTOQUE DO PRODUTO ACABADO GERADO DURANTE A EMISSAO DA "PA" (PRODUCAO AVULSA) *}
          {********************************************************************************************JC*}
          If (strEspDoc = 'PA') And
             (Pos('MOVDET', strArqDet) > 0) And
             (Not fEmptyStr(FieldByName(strSigDet + 'CODACA').AsString)) And
             (FieldByName(strSigDet + 'PROEMB').AsString <> 'S') Then
          Begin
            If Not TProdAcabado.fAtualizaEstoque(FieldByName(strSigDet + 'CODACA').AsString,
                                                 FieldByName(strSigDet + 'EMPACA').AsString,
                                                 FieldByName(strSigDet + 'CODEMP').AsString,
                                                 'S',
                                                 FieldByName(strSigDet + 'QTDITE').AsFloat) Then
            Begin
              Result := False;
              Exit;
            End;
          End;

          If (arrEspecies[intIndiceEsp][0] = 'NE') And (Pos(FieldByName('DET_CLAFIS').AsString, '1922_2922') <= 0) And (Not FblnNotaComFisRef) And
              fEhUltimaNotaDoItem(strEspDoc, strNumDoc, strCliFor, strSerie, FieldByName('DET_CODITE').AsString, fltPreMed, fltPreUlt, fltImpUlt, fltUltCot, strSeqUlt, blnAtuPreMed) Then
            pRestauraPrecoMedio(FieldByName('DET_CODITE').AsString,
                                strSeqUlt,
                                fltPreMed,
                                fltPreUlt,
                                fltImpUlt,
                                fltUltCot,
                                blnAtuPreMed);
          If MatchStr(arrEspecies[intIndiceEsp][0], ['NE','ND']) And (fCfgSis('COFEND', varBoolean) Or fCfgSis('UDEVME', varBoolean)) Then
            pApagaFATEND(FieldByName('AUTOINCREM').AsString);
          {******************************************************************}
          {* Quando vender item estrutura, não carregando os sub-produtos,  *}
          {* e baixar estoque dos sub.produtos atraves da emissao de uma    *}
          {* ordem de producao, esta ordem de producao deve ser cancelada e *}
          {* o estoque dos sub.produtos deve ser atualizado                 *}
          {***************************************************************JC*}
          If ((fCfgSis('BXSBIT') > '1') Or fCfgSis('VENVID', varBoolean)) Then
          Begin
            If (FindField('DET_ORDPRO') <> Nil) Then
            Begin
              If (Not fEmptyStr(FieldByName('DET_ORDPRO').AsString)) Then
              Begin
                If Not fCancelaOrdemProducaoVenda(FieldByName('DET_ORDPRO').AsString,
                                                  IIF(FieldByName('DET_TIP_FC').AsString = 'C',
                                                      FieldByName('DET_CODCLI').AsString,
                                                      FieldByName('DET_CODFOR').AsString),
                                                  FieldByName('DET_CODEMP').AsString,
                                                  FieldByName('DET_TIP_FC').AsString) Then
                Begin
                  Result := False;
                  Exit;
                End;
              End;
            End;
          End;

          {*******************************************}
          {* GRAVA NOS ARQUIVOS DELETADOS            *}
          {****************************************MV*}
          fVerificaIntegridade(Self.Name, strArqDet, qryTemp01, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

          If (Pos(strArqDet, 'MOVDET_') > 0) And
            (FieldByName(strSigDet + 'PROMOC').AsString = 'S') Then
          Begin
            If (Not Assigned(InvokerUpdPromo)) Then
              InvokerUpdPromo := TInvokerUpdatePromo.New();

            InvokerUpdPromo.pAdd(TUpdatePromo.New(
                                   TParametrosPromocao.New()
                                     .CodIte(FieldByName(strSigDet + 'CODITE').AsString)
                                     .CodEmp(FieldByName(strSigDet + 'CODEMP').AsString)
                                     .CodCli(FieldByName(strSigDet + 'CODCLI').AsString)
                                 ));
          End;

          ReprocessarItem(FieldByName(strSigDet + 'CODITE').AsString, '', True, True);

          If fUsaFlex(FieldByName(strSigDet + 'CODITE').AsString) Then
          Begin
            objMovFlex := TMovFlex.Create(Nil);
            objMovFlex.pExcluir(strNumDoc,
                                strEspDoc,
                                VS_strCodEmp,
                                strCliFor,
                                FieldByName(strSigDet + 'CODITE').AsString,
                                FieldByName('AUTOINCREM').AsString);
            FreeAndNil(objMovFlex);
          End;

          If Assigned(objEndDoc) And (not blnWmsGerouPedidoDeEnderecamento) And (Not fConsignacaoFechouEmNota(strNumDoc, strEspDoc, strCliFor)) And
             ((Not Assigned(FindField(strSigDet + 'CLAFIS'))) Or (Pos(FieldByName(strSigDet + 'CLAFIS').AsString, '1922_2922_5922_6922') <= 0)) And
             (not LMantemPDConferido) Then
          Begin
            If fCampoTabela('DET_EXTFUL', 'MOVTRI', ['DET_SEQGER'], [FieldByName('AUTOINCREM').AsString]) <> 'S' Then
              objEndDoc.pAddItem(FieldByName(strSigDet + 'CODITE').AsString,
                                 IfThen(Not fEmptyStr(strNumLotMovimentacaoEstoque) And (Not fCfgSis('MANEND', VarBoolean)), strNumLotMovimentacaoEstoque, FieldByName(strSigDet + 'NUMLOT').AsString),
                                 FieldByName(strSigDet + 'QTDITE').AsFloat,
                                 FieldByName(strSigDet + 'CODACA').AsString,
                                 FieldByName(strSigDet + 'EMPACA').AsString,
                                 FieldByName(strSigDet + 'PROACA').AsString='S');
          End;

          Next;
        End;
        Close;

      End;

      If fFalhaEmTransacao Then
        Exit(False);

      If (Assigned(objEndDoc)) And
         (objEndDoc.fQtdItens > 0) And
         (Pos('NOTGER', strArqGer) <= 0) And
         (Pos('TINGER', strArqGer) <= 0) Then
      Begin
        strCliFilAux := fCampoTabela('CLI_CODCLI', 'CADCLI', ['CLI_CODCLI'], [fCadEmp('CLIFIL')]);

        If fEmptyStr(strCliFilAux) Then
        Begin
          fRollback;
          Result := False;
          fMensagemCancelamento('Atenção', 'Esse cancelamento irá gerar um pedido de endereçamento, entretanto o "Cliente Filial" desta empresa não está configurado ou não existe. '+
                               'Corrija essa infomação no Cadastro de Empresas!', ['&Ok']);
          FreeAndNil(objEndDoc);
          Exit;
        End;

        blnGerouEnderecamento := False;
        If ((LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList.Count = 0) Or
           ((LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList.Count > 0) And (FblnAbastecimentoPeloDeposito))) And
           (Not FCancelamentoDeFFPelaNotaEspecial) Then
        Begin
          If Not fEhDocumentoComDevolucaoAutomatizadaParaDocumentosDeOutrasEmpresas(strNumDoc, strEspDoc, strCliFor) Then
          Begin
            If (objEndDoc.fGerarPedidoParaReservarEstoque) Then
            Begin
              blnGerouEnderecamento := True
            End
            Else
            Begin
              fRollback;
              Result := False;
              fMensagemCancelamento('Atenção', 'Erro ao gerar pedido de endereçamento. Tente realizar o cancelamento novamente!', ['&Ok']);
              FreeAndNil(objEndDoc);
              Exit;
            End;
          End;
        End;

        FreeAndNil(objEndDoc);
      End;

      If stlPedCom.Count > 0 Then
      Begin
        If Not fDesfaturaPedidoCompra(stlPedCom) Then
        Begin
          Result := False;
          Exit;
        End;
      End;

      {*******************************************}
      {* GRAVA NOS ARQUIVOS DELETADOS            *}
      {****************************************MV*}
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  * ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + strArqGer + IIF((Pos(strArqGer,'TINGER_') > 0), ' T ', ' ');

      If (Pos(strArqGer,'TINGER_') > 0) Then
      Begin
        strSQL := strSQL + ' INNER JOIN MOVGER D ON';
        strSQL := strSQL + '                      D.GER_NUMDOC = T.' + strSigGer + 'NUMDOC AND ';
        strSQL := strSQL + '                      D.GER_ESPDOC = T.' + strSigGer + 'ESPDOC AND ';
        strSQL := strSQL + '                      D.GER_CODEMP = T.' + strSigGer + 'CODEMP     ';

        strSigGer := 'D.' + strSigGer;
      End;

      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + strSigGer + strTipFc + ' = :CLIFOR AND ';
      strSQL := strSQL + strSigGer + 'NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + strSigGer + 'ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + strSigGer + 'CODEMP = :CODEMP ';

      If ((arrEspecies[intIndiceEsp][0] = 'NE') And (Pos(strArqGer,'TINGER_') <= 0))  Or
         ((arrEspecies[intIndiceEsp][0] = 'OF') And (Pos(strArqGer,'TINGER_') <= 0)) Or
         ((arrEspecies[intIndiceEsp][0] = 'EF') And (Pos(strArqGer,'TINGER_') <= 0)) Then
      Begin

        If fEmptyStr(strSerie) Then
          strSQL := strSQL + '  AND ((' + strSigGer + 'SERIE_ IS NULL) OR (' + strSigGer + 'SERIE_ = "")) '
        Else
          strSQL := strSQL + '  AND (' + strSigGer + 'SERIE_ = :SERIE_) ';

      End;

      If (blnVerificaOrigem) And (Pos(strArqGer,'TINGER_') <= 0) Then
      Begin

        If (Pos(arrEspecies[intIndiceEsp][0], 'NF_EL_NS_IF_IV_D1_OF_NC_IC_NP_EF_RL_DC_') > 0) Then
        Begin
          strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC IN ("V","C") ';
        End
        Else If (arrEspecies[intIndiceEsp][0] = 'ND') Then
        Begin
          If Not blnConEqu Then
            strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC = "D" '
          Else
            strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC = "" ';
        End
        Else If (arrEspecies[intIndiceEsp][0] = 'DL') Then
        Begin
          strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC = "" ';
        End
        Else
        Begin
          strSQL := strSQL + ' AND (' + strSigGer + 'ORIDOC IS NULL OR ' + strSigGer + 'ORIDOC = "") ';
        End;

      End;

      With qryTemp01 Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CLIFOR').AsString := strCliFor;
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := VS_strCodEmp;

        If (Not fEmptyStr(strSerie)) Then
        Begin
          If ( (arrEspecies[intIndiceEsp][0] = 'NE') And (Pos(strArqGer,'TINGER_') <= 0) ) Or
             (arrEspecIes[intIndiceEsp][0] = 'OF')                                         Or
             (arrEspecIes[intIndiceEsp][0] = 'EF')                                         Then

          ParamByName('SERIE_').AsString := strSerie;
        End;

        Open;

        {*****************************************}
        {* CASO TENHA FRETE E VENHA DE UM PEDI-  *}
        {* DO, LIMPA O FREBAI.                   *}
        {**************************************MV*}
        If (Pos(strArqGer,'MOVGER_') > 0) Then
        Begin
          If Assigned(objConEnt) And (Pos(strEspDoc, 'NF_IF_IV_D1_FF_MI_RB_') > 0) Then
          Begin
            If (FieldByName('GER_ENTFAT').AsString = 'S') Then
            Begin
               objConEnt.fSetNumDoc(ParamByName('NUMDOC').AsString,
                                    ParamByName('ESPDOC').AsString,
                                    ParamByName('CODEMP').AsString,
                                    ParamByName('CLIFOR').AsString);
              If fEmptyStr(strNum_Pd) Then
              Begin
                {**************************************************************}
                {* Documento Entrega Futura emitido direto pela tela de venda *}
                {***********************************************************VA*}

                If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
                Begin
                  objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEmpOri);
                  objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;
                End
                Else
                Begin
                  objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaOri);
                  objConEnt.fProcessaArrayDatasControleEntregaRomaneio;
                End;

              End
              Else
              Begin
                {****************************************************************}
                {* Documento Entrega Futura originado de um pedido              *}
                {*************************************************************VA*}
                If (Length(objConEnt.arrDtaAux) > 0) Or (Length(objConEnt.arrDtaEmpAux) > 0) Then
                Begin

                  If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
                  Begin
                    objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;//Referente ao Documento
                    objConEnt.pCopiarArray(objConEnt.arrDtaEmpAux, objConEnt.arrDtaEmpOri);
                    objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;//Referente ao Pedido //Tirar reserva destas datas
                  End
                  Else
                  Begin

                    {****************************************************************}
                    {* Pedido cancelado em conjunto com o documento de faturamento   *}
                    {*************************************************************VA*}
                    //objConEnt.arrDtaOri; //já carregado com eventuais datas de entrega futura que só estão na MOVGER //Tirar reserva destas datas
                    //objConEnt.arrDtaEnt; //já carregado com eventuais datas de entrega futura que só então na FATGOR //Reservar estas datas
                    objConEnt.fProcessaArrayDatasControleEntregaRomaneio;//Referente ao Documento

                    {****************************************************************}
                    {* Já que o pedido foi apagado, tirar a reserva de datas dele   *}
                    {*************************************************************VA*}
                    objConEnt.pCopiarArray(objConEnt.arrDtaAux, objConEnt.arrDtaOri);
                    objConEnt.fProcessaArrayDatasControleEntregaRomaneio;//Referente ao Pedido //Tirar reserva destas datas

                  End;

                End
                Else
                Begin
                  {****************************************************************}
                  {* Quando se respondeu não à pergunta "Se deseja cancelar o     *}
                  {* pedido em conjunto com o documento de faturamento", levantar *}
                  {* divergências de datas entre os documentos e fazer os devidos *}
                  {* ajustes.                                                     *}
                  {*************************************************************VA*}
                  If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
                  Begin
                    objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEmpOri, tBusDatasDivergentesDocFat);//Tirar reserva destas datas
                    objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEmpEnt, tBusDatasDivergentesPedOrc);//Reservar estas datas
                    objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;//Referente ao Documento
                  End
                  Else
                  Begin
                    objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaOri, tBusDatasDivergentesDocFat);//Tirar reserva destas datas
                    objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEnt, tBusDatasDivergentesPedOrc);//Reservar estas datas
                    objConEnt.fProcessaArrayDatasControleEntregaRomaneio;//Referente ao Documento
                  End;

                End;
              End;
            End
            Else
            Begin
              {**********************************************************************}
              {* Cancelou o pedido junto com o documento faturado porém o documento *}
              {* em questão não é de Entrega (Situação onde o pedido é desmembrando *}
              {* em documentos de Entrega futura, Entrega Imediata, etc             *}
              {*******************************************************************VA*}
              If objConEnt.fEhControleDeEntregaRomaneioMultiloja Then
              Begin

                If (Not fEmptyStr(strNum_Pd)) And (Length(objConEnt.arrDtaEmpAux) > 0) Then
                Begin
                  objConEnt.pCopiarArray(objConEnt.arrDtaEmpAux, objConEnt.arrDtaEmpOri);
                  objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;//Referente ao Pedido //Tirar reserva destas datas
                End;

              End
              Else
              Begin

                If (Not fEmptyStr(strNum_Pd)) And (Length(objConEnt.arrDtaAux) > 0) Then
                Begin
                  objConEnt.pCopiarArray(objConEnt.arrDtaAux, objConEnt.arrDtaOri);
                  objConEnt.fProcessaArrayDatasControleEntregaRomaneio;//Referente ao Pedido //Tirar reserva destas datas
                End;

              End;

            End;
          End;

          If (FieldByName('GER_TOTFRE').AsFloat > 0) And
             (Not fEmptyStr(strNum_Pd))              Then
          Begin
            pAtualizaFreteBaixado;
          End;

          If (FindField('GER_OPRFLJ') <> Nil)           And
             (FieldByName('GER_OPRFLJ').AsString = 'S') Then
          Begin
            pAjustaEstoqueProdAcabado(arrProdAcabado, True);
          End;

        End;

        If (arrEspecies[intIndiceEsp][0] = 'NE') And (strArqGer = 'NOTGER') Then
        Begin
          pVoltaNotaSaidaTE(FieldByName('GER_NUMDOC').AsString, FieldByName('GER_CODEMP').AsString, FieldByName('GER_ESPDOC').AsString);
          pVoltaContasAPagarConfirmadas(FieldByName('GER_NUMDOC').AsString, FieldByName('GER_CODEMP').AsString, FieldByName('GER_ESPDOC').AsString);
        End;

        If Pos(strArqGer, 'MOVGER_NOTGER_') > 0 Then
          fVerificaIntegridade(Self.Name, strArqGer, qryTemp01, True, False, fMotivoDelecao, fOperadorDoCancelamento, True, fGetEspSel)
        Else
          fVerificaIntegridade(Self.Name, strArqGer, qryTemp01, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

        pAdicionarAuditoriaFaturamento(fGetEspSel, 'DEL_'+strArqGer, FieldByName('AUTOINCREM').AsString);

        pGravaDeletadosAuxMov(strArqGer, FieldByName('AUTOINCREM').AsString);
        pGravaDeletadosSerMov(strArqGer, FieldByName('AUTOINCREM').AsString);
        pCarregaListaItensDel(strArqGer, FieldByName('AUTOINCREM').AsString);
        pGravaDeletadosDigImp(strArqGer, FieldByName('AUTOINCREM').AsString);

        If fCfgSis('RESLTP', varBoolean) Then
          pApagaReservaEnderecamentoDaLotPre(FieldByName('AUTOINCREM').AsString);

        If (arrEspecies[intIndiceEsp][0] = 'NF') And
           (qryTemp01.FieldByName('GER_MEN001').AsString  = 'GARANTIA(TE)') And
           (Pos(fCfgSis('CLAREF'), RightStr(qryTemp01.FieldByName('GER_CLAFIS').AsString, 3)) > 0) And
           (Not blnCancelamentoDeBaixaDeRefugo) Then
         pRestauraMovGad(FieldByName('GER_NUMDOC').AsString, FieldByName('GER_DTADOC').AsDateTime);

        If (Pos('MOVGER', strArqGer) > 0) Then
        Begin
          Try
            qryMovObs := fCriaQuery(Self);
            With qryMovObs Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add('SELECT * FROM MOVOBS');
              SQL.Add('WHERE MOV_SEQGER = :AUTINC');

              ParamByName('AUTINC').AsString := qryTemp01.FieldByName('AUTOINCREM').AsString;
              Open;

              If Not IsEmpty Then
                fVerificaIntegridade(Self.Name, 'MOVOBS', qryMovObs, True, False, EmptyStr, fOperadorDoCancelamento);
            End;
          Finally
            FreeAndNil(qryMovObs);
          End;

          Try
            qryMovRes := fCriaQuery(Self);
            With qryMovRes Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add('SELECT * FROM MOVRES');
              SQL.Add('WHERE RES_SEQGER = :AUTINC');

              ParamByName('AUTINC').AsString := qryTemp01.FieldByName('AUTOINCREM').AsString;
              Open;

              If Not IsEmpty Then
                fVerificaIntegridade(Self.Name, 'MOVRES', qryMovRes, True, False, EmptyStr, fOperadorDoCancelamento);
            End;
          Finally
            FreeAndNil(qryMovRes);
          End;
        End;

        If (Pos('MOVGER', strArqGer) > 0) And fUsaRotinaWMS Then
          fCancelarBaixaLotesWMS(FieldByName('GER_NUMDOC').AsString,
                                 FieldByName('GER_ESPDOC').AsString,
                                 FieldByName('GER_CODEMP').AsString,
                                 FieldByName('GER_CODCLI').AsString);

        strEmpDocPR := fCampoTabela('AUX_EMP_PR', 'AUXMOV JOIN MOVGER ON MOVGER.AUTOINCREM = AUXMOV.AUX_SEQGER',
                                    ['MOVGER.AUTOINCREM'], [FieldByName('AUTOINCREM').AsString]);

        If Pos('MOVGER', strArqGer) > 0 Then
        Begin
          If Not fCancelaDocumentoProducao(FieldByName('GER_NUM_PR').AsString,
                                           IIF(Not fEmptyStr(strEmpDocPR), strEmpDocPR,
                                            FieldByName('GER_CODEMP').AsString)) Then
          Begin
            Result := False;
            Exit;
          End;
        End;

        If fUsaRequisicaoEnvioMateriais Then
        Begin
          If (Pos('MOVGER', strArqGer) > 0) And (strEspDoc = 'RQ') Then
          Begin
            strDocFatRQ := FieldByName('GER_NUMFAT').AsString;
            strTipFatRQ := FieldByName('GER_TIPFAT').AsString;
            strEmpFatRQ := FieldByName('GER_EMPFAT').AsString;
          End;
        End;

        If (Pos('MOVGER', strArqGer) > 0) And (FieldByName('GER_TIP_FC').AsString = 'C') Then
        Begin
          pLimparDocumentoBrinde(FieldByName('GER_NUMDOC').AsString,
                                 FieldByName('GER_ESPDOC').AsString,
                                 FieldByName('GER_CODEMP').AsString);

          pLimparUltimaCompraDocumento(FieldByName('GER_NUMDOC').AsString,
                                       FieldByName('GER_ESPDOC').AsString,
                                       FieldByName('GER_CODCLI').AsString);

          dtaGerEnt := FieldByName('GER_DTAENT').AsDateTime;
        End;

        Close;
      End;

      If (Pos(strArqGer,'TINGER_') > 0) Then
      Begin
        strSQL := '';
        strSQL := strSQL + ' DELETE ';
        strSQL := strSQL + '   FROM ' + strArqGer;

        strSigGer := Copy(strSigGer, 3, Length(strSigGer)-2);

      End
      Else
      Begin
        strSQL := '';
        strSQL := strSQL + 'DELETE FROM ';
        strSQL := strSQL + strArqGer + ' ';
      End;

      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + strSigGer + strTipFc + ' = :CLIFOR AND ';
      strSQL := strSQL + strSigGer + 'NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + strSigGer + 'ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + strSigGer + 'CODEMP = :CODEMP ';

      If (Pos(arrEspecies[intIndiceEsp][0], 'NE_EF_OF_ND_') > 0) And (Pos(strArqGer,'TINGER_') <= 0) Then
      Begin

        If fEmptyStr(strSerie) Then
          strSQL := strSQL + '  AND ((' + strSigGer + 'SERIE_ IS NULL) OR (' + strSigGer + 'SERIE_ = "")) '
        Else
          strSQL := strSQL + '  AND (' + strSigGer + 'SERIE_ = :SERIE_) ';

      End;

      If (blnVerificaOrigem) And (Pos(strArqGer,'TINGER_') <= 0) Then
      Begin

        If (Pos(arrEspecies[intIndiceEsp][0], 'NF_EL_NS_IF_IV_D1_OF_NC_IC_NP_EF_RL_DC_') > 0) Then
        Begin
          strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC IN ("V","C") ';
        End
        Else If (arrEspecies[intIndiceEsp][0] = 'ND') Then
        Begin
          If Not blnConEqu Then
            strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC = "D" '
          Else
            strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC = "" ';
        End
        Else If (arrEspecies[intIndiceEsp][0] = 'DL') Then
        Begin
          strSQL := strSQL + ' AND ' + strSigGer + 'ORIDOC = "" ';
        End
        Else
        Begin
          strSQL := strSQL + ' AND (' + strSigGer + 'ORIDOC IS NULL OR ' + strSigGer + 'ORIDOC = "") ';
        End;

      End;

      { Tratar as tabelas de numero de serie }
      If (Pos('MOVDET', strArqDet) > 0) Then
      begin
        if strEspDoc= 'AJ' then
        begin
          if Not TNumeroSerie.fCancelamentoAjusteEstoque(strCliFor, strNumDoc, strEspDoc, VS_strCodEmp) then
          begin
            Result := False;
            Exit;
          end;
        end
        else
        begin
          if Not TNumeroSerie.Cancelamento(strCliFor, strNumDoc, strEspDoc, VS_strCodEmp, strSerie, strTipFc,fGetEspSel) then
          begin
            Result := False;
            Exit;
          end;
        end;
      end
      else if (Pos('NOTDET', strArqDet) > 0) then
      begin
        if Not TNumeroSerie.CancelamentoConfirmacaoDocumento(strCliFor, strNumDoc, strEspDoc, VS_strCodEmp, strSerie, strTipFc) then
        begin
          Result := False;
          Exit;
        end;
      end;

      If fFalhaEmTransacao Then
        Exit(False);

      If Not ( (Pos(strArqGer,'TINGER_') > 0) And (arrEspecies[intIndiceEsp][0] = 'NP') And (strTipFc = 'CODFOR') ) Then
      Begin
        If (Pos('MOVDET', strArqDet) > 0) Then
        Begin
          qryGenDor.Close;
          qryGenDor.SQL.Clear;
          qryGenDor.SQL.Add('  UPDATE                     ');
          qryGenDor.SQL.Add('    FGOCAI                   ');
          qryGenDor.SQL.Add('  SET                        ');
          qryGenDor.SQL.Add('    FGC_DETINC = NULL,       ');
          qryGenDor.SQL.Add('    FGC_NUMFAT = NULL,       ');
          qryGenDor.SQL.Add('    FGC_TIPFAT = NULL,       ');
          qryGenDor.SQL.Add('    FGC_EMPFAT = NULL        ');
          qryGenDor.SQL.Add('  WHERE FGC_NUMFAT =:NUMDOC  ');
          qryGenDor.SQL.Add('    AND FGC_TIPFAT =:ESPDOC  ');
          qryGenDor.SQL.Add('    AND FGC_EMPFAT =:EMPDOC  ');

          qryGenDor.ParamByName('NUMDOC').AsString := strNumDoc;
          qryGenDor.ParamByName('ESPDOC').AsString := strEspDoc;
          qryGenDor.ParamByName('EMPDOC').AsString := VS_strCodEmp;
          qryGenDor.ExecSQL;
          qryGenDor.Close;
        End;

        With qryGenDor Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('CLIFOR').AsString := strCliFor;
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspDoc;
          ParamByName('CODEMP').AsString := VS_strCodEmp;

        If (Not fEmptyStr(strSerie)) And
           (Pos(arrEspecies[intIndiceEsp][0], 'NE_EF_OF_ND_') > 0) And
           (Pos(strArqGer,'TINGER_') <= 0) Then
          ParamByName('SERIE_').AsString := strSerie;

          ExecSQL;
          Close;
        End;
      End;

      If (Pos('MOVGER', strArqGer) > 0) Then
        pAtualizaPriComCliente(strCliFor, 0, dtaGerEnt);
    End;

    imgItensNota.Picture := imgAlterado.Picture;
    imgDadosNota.Picture := imgAlterado.Picture;

    pCancelaDocumentosTransfEstoqueMl(strNumDoc, strEspDoc, blnDocumentoExiste);

    If fUsaRequisicaoEnvioMateriais And (strEspDoc = 'RQ') Then
      pAtualizarCustoVendaVidro(strDocFatRQ, strTipFatRQ, strEmpFatRQ);

    {******************************************}
    {* ATUALIZA OS ITENS DE PROMOÇÃO          *}
    {***************************************FS*}
    If Assigned(InvokerUpdPromo) And ((strEspDoc <> 'OR') Or (fCfgSis('DOCPRO', varString) = '1')) Then
      InvokerUpdPromo.fAtualizaQtdDisponivel();

    If (Not blnDocumentoExiste) And (Not blnCancelouLivro) Then
    Begin
      Result := False;
      fRollBack;
      pAtribuiPicture(Nil);
      fMensagem('', 'Esse documento não existe!', ['&Ok']);
    End;

    If fFalhaEmTransacao Then
      Exit(False);

  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaItensDocumento]');
      Result := False;
    End;
  End;

  SetLength(arrProdAcabado, 0);

  If Assigned(qryGenDor) Then FreeAndNil(qryGenDor);
  If Assigned(stlPedCom) Then FreeAndNil(stlPedCom);
  If Assigned(stlPedComAux) Then FreeAndNil(stlPedComAux);
  If Assigned(objEndDoc) Then FreeAndNil(objEndDoc);

end;

function TfrmCancelamentoDocumentos.fCancelaItensFaturado(strEspDoc,
  strNumDoc, strCliFor: String; strTip_FC: String = ''): Boolean;
  Var
    strPrx,
    strAux,
    strSQL : String;
    arrTab : Array[1..4] of String;
    intIdx : integer;
    blnGer : Boolean;
begin

  Try
    Result := True;

    {****************************************************************************}
    {* VARRE AS TABELAS DE MOVIMENTAÇÃO RETIRANDO A REFERÊNCIA ONDE O DOCUMENTO *}
    {* QUE ESTÁ SENDO CANCELADO É O DOCUMENTO DE FATURAMENTO.                   *}
    {*************************************************************************VA*}

    If fEmptyStr(strTip_FC) Then
      strTip_FC := Self.strTipFc;

    arrTab[1]:='MOVDET' ;
    arrTab[2]:='MOVGER' ;
    arrTab[3]:='NOTDET' ;
    arrTab[4]:='NOTGER' ;

    strSQL := '';
    strSQL := strSQL + 'UPDATE ';
    strSQL := strSQL + '  <TABELA> ';
    strSQL := strSQL + 'SET ';
    strSQL := strSQL + '  <P>_JAFATU = 0, ';
    strSQL := strSQL + '  '+'<CAMPO>'+'  ';
    strSQL := strSQL + '  <P>_TIPFAT = NULL, ';
    strSQL := strSQL + '  <P>_NUMFAT = NULL, ';
    strSQL := strSQL + '  <P>_EMPFAT = NULL, ';
    strSQL := strSQL + '  <P>_DTAFAT = NULL, ';
    strSQL := strSQL + '  <P>_VENFAT = NULL, ';
    strSQL := strSQL + '  <P>_CNDFAT = NULL, ';
    strSQL := strSQL + '  <P>_VALFAT = NULL, ';
    strSQL := strSQL + '  <P>_CLIFAT = NULL  ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  <P>_' + strTip_FC + ' = :CLIFOR AND ';
    strSQL := strSQL + '  <P>_NUMFAT = :NUMDOC AND ';
    strSQL := strSQL + '  <P>_TIPFAT = :ESPDOC AND ';
    strSQL := strSQL + '  <P>_EMPFAT = :CODEMP ';

    For intIdx:=1 To 4 Do
    Begin
      If Pos('DET',arrTab[intIdx]) > 0 Then
      Begin
        blnGer:=False;
        strPrx:='DET'
      End
      Else
      Begin
        blnGer:=True;
        strPrx:='GER';
      End;

      If fTemRegMovDet(blnGer, arrTab[intIdx], strTip_FC, strCliFor, strNumDoc, strEspDoc, VS_strCodEmp) Then
      Begin
        strAux:='';
        strAux := AnsiReplaceStr(strSQL, '<TABELA>', arrTab[intIdx]);
        strAux := AnsiReplaceStr(strAux, '<P>', strPrx);

        If fCampoExiste(arrTab[intIdx], strPrx+'_DESCFF', True) Then
        Begin
          strAux := AnsiReplaceStr(strAux, '<CAMPO>', strPrx+'_DESCFF = 0.00,');
        End
        Else
        Begin
          strAux := AnsiReplaceStr(strAux, '<CAMPO>','');
        End;

        With qryTemp01 Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strAux);
          ParamByName('CLIFOR').AsString := strCliFor;
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspDoc;
          ParamByName('CODEMP').AsString := VS_strCodEmp;
          ExecSQL;
          Close;
        End;
      End;
    End;

    imgItensNota.Picture := imgAlterado.Picture;
  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaItensFaturado]');
      Result := False;
    End;
  End;

end;

function TfrmCancelamentoDocumentos.fCancelaContasReceber(strEspDoc,
  strNumDoc, strCliFor, strCodEmp: String; PermiteRecursividade: Boolean = True; blnEhGarantiaGA: Boolean = False): Boolean;
  Var
    strSQL   : String;
    blnDupPar: Boolean;
    strCodFavorecidoCredito,
    strNumCcrGA: String;
    strNumDupRec: String;
begin
  strNumDupRec:= EmptyStr;
  strCodFavorecidoCredito := EmptyStr;
  strNumCcrGA := EmptyStr;
  Try
    Result := True;

    If (fEmptyStr(strNumDoc)) or ((strEspdoc <> 'CT') and  (fEmptyStr(strCliFor))) Then
    Begin
      Exit;
    End;

    {**************************************}
    {* CANCELA COMISSAO PROFISSIONAL      *}
    {***********************************LU*}
    pCancelaComissaoProfissional(strEspDoc, strNumDoc, strCliFor, strCodEmp);

    {**************************************}
    {* CANCELA CLUBE FIDELIDADE           *}
    {***********************************AF*}
    pCancelaClubeFidelidade(strEspDoc, strNumDoc, strCodEmp);

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE  ';
    strSQL := strSQL + '  CADREC.*      ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  CADREC ';

    If blnEhGarantiaGA Then
      strSQL := strSQL + '  INNER JOIN MOVGER ON CTR_INCDOC = MOVGER.AUTOINCREM ';

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CTR_NUMDUP = :NUMDUP AND ';
    strSQL := strSQL + '  CTR_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  CTR_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  CTR_CODEMP = :CODEMP ';
    strSQL := strSQL + ' ORDER BY 1, 2, 5 ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDUP').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      lstCtrBaixadas.Clear;
      FCtrPixGerado.Clear;

      While (Not Eof) Do
      Begin

        blnDupPar  := fCtrBaixadaParcial(qryTemp01);

        If (Not blnFaturamento) Then
        Begin
           If ((FieldByName('CTR_VALDUP').AsFloat = 0) Or (blnDupPar)) And
              (FieldByName('CTR_VRTRDV').AsFloat = 0) Then
          Begin
            lstCtrBaixadas.Add(FieldByName('CTR_NUMDUP').AsString +
                               FieldByName('CTR_PARCEL').AsString + ' - ' +
                               FieldByName('CTR_ESPDOC').AsString + ' Loja: ' +
                               FieldByName('CTR_CODEMP').AsString);
            Next;
            Continue;
          End;

          If (FieldByName('CTR_DTAREC').AsString.IsEmpty) And
             (Not FieldByName('CTR_TX_PIX').AsString.IsEmpty) Then
          Begin
            FCtrPixGerado.Add(FieldByName('CTR_NUMDUP').AsString +
                              FieldByName('CTR_PARCEL').AsString + ' - ' +
                              FieldByName('CTR_ESPDOC').AsString + ' Loja: ' +
                              FieldByName('CTR_CODEMP').AsString);
            Next;
            Continue;
          End;
        End;

        If VS_strHabilitarCRM And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
        Begin
          TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(FieldByName('CTR_NUMDUP').AsString,
                                                   FieldByName('CTR_ESPDOC').AsString,
                                                   FieldByName('CTR_CODEMP').AsString,
                                                   FieldByName('CTR_CODCLI').AsString,
                                                   FieldByName('CTR_PARCEL').AsString,
                                                   FieldByName('CTR_CODVEN').AsString,
                                                   fRetCgcCpf(FieldByName('CTR_CODCLI').AsString),
                                                   afcExcluiDuplicata, True);
        End;

        fApagaDuplicataContasReceber(qryTemp01, Self.Name);

        Next;
      End;

      Close;

      Result := (lstCtrBaixadas.Count <= 0) And (FCtrPixGerado.Count <= 0);

      if Result and PermiteRecursividade then
      begin
        if fObterClienteFavorecidoCredito(strNumDoc,strCliFor, strEspDoc,strCodFavorecidoCredito) then
        begin
          if strCliFor <> strCodFavorecidoCredito then
          begin
            Result := fCancelaContasReceber(strEspDoc, strNumDoc, strCodFavorecidoCredito, strCodEmp, False);
          end;
        end
        //Cancelamento de GA com favorecido informado.
        Else If (blnEhGarantiaGA) And (fObterCreditoFavorecidoGA(strNumDoc, strCliFor, strNumCcrGA)) Then
        Begin
          Result := fCancelaContasReceber('CC', strNumCcrGA, strCliFor, strCodEmp, False, False);
        End;
      end;

      if Result then
      begin
        imgCtaReceber.Picture := imgAlterado.Picture;
      end;
    End;

  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaContasReceber]');
      Result := False;
    End;
  End;
end;


function TfrmCancelamentoDocumentos.fCancelaCTE(strNumDoc, strSerie, strCodEmp: string): Boolean;
var
  strSQL   : String;
  strSeqGerCte: string;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  * ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVCTE ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CTE_NUMCTE = :NUMCTE ';
  strSQL := strSQL + '  AND CTE_SERIE_ = :SERIE_ ';
  strSQL := strSQL + '  AND CTE_CODEMP = :CODEMP ';

  strSeqGerCte := '';

  Try
    qryTemp01.SQL.Clear;
    qryTemp01.SQL.Add(strSQL);
    qryTemp01.ParamByName('NUMCTE').AsString := strNumDoc;
    qryTemp01.ParamByName('SERIE_').AsString := strSerie;
    qryTemp01.ParamByName('CODEMP').AsString := IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);
    qryTemp01.Open;

    Result := not qryTemp01.IsEmpty;

    if Result then
    begin
      strSeqGerCte := qryTemp01.FieldByName('AUTOINCREM').AsString;
      fVerificaIntegridade(Self.Name, 'MOVCTE', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
      qryTemp01.Delete;
    end;

    if not Result then
    begin
      qryTemp01.SQL.Clear;
      qryTemp01.SQL.Add(AnsiReplaceStr(strSQL, 'MOVCTE', 'NOTCTE'));
      qryTemp01.ParamByName('NUMCTE').AsString := strNumDoc;
      qryTemp01.ParamByName('SERIE_').AsString := strSerie;
      qryTemp01.ParamByName('CODEMP').AsString := IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);
      qryTemp01.Open;

      Result := not qryTemp01.IsEmpty;

      if Result then
      begin
        strSeqGerCte := qryTemp01.FieldByName('AUTOINCREM').AsString;
        fVerificaIntegridade(Self.Name, 'NOTCTE', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
        qryTemp01.Delete;
      end;
    end;

    if (Result) and (not fEmptyStr(strSeqGerCte)) then
    begin
      qryTemp01.Close;
      qryTemp01.SQL.Clear;
      qryTemp01.SQL.Add('SELECT * FROM PARCTE WHERE PAR_SEQGER = :SEQGER');
      qryTemp01.ParamByName('SEQGER').AsString := strSeqGerCte;
      qryTemp01.Open;

      if not qryTemp01.IsEmpty then
      begin
        fVerificaIntegridade(Self.Name, 'PARCTE', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
        qryTemp01.Delete;
      end;
    end;

    imgDadosNota.Picture := imgAlterado.Picture;

  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaCTe]');
      Result := False;
    End;
  End;
end;

function TfrmCancelamentoDocumentos.fCancelaCTeLivroFiscal(strNumDoc, strSerie: String): Boolean;
var
  intContador  : Integer;
  strSQL   : String;
  qryGenFis: TUniQuery;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  CADFIS.* ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADFIS ';
  strSQL := strSQL + '  JOIN MOVCTE ON RIGHT(FIS_NUMDOC,9) = CTE_NUMCTE ';
  strSQL := strSQL + '                      AND FIS_SERIE_ = CTE_SERIE_ ';
  strSQL := strSQL + '                      AND FIS_CODEMP IN (CTE_CODEMP, CTE_EMPCLI) ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  FIS_NUMDOC = :NUMDOC ';
  strSQL := strSQL + '  AND FIS_ESPDOC = "CT" ';
  strSQL := strSQL + '  AND FIS_SERIE_ = :SERIE_ ';

  qryGenFis := fCriaQuery(Self);
  try
    Try
      Result := True;

      qryGenFis.SQL.Add(strSQL);
      strSQL := AnsiReplaceStr(strSQL, 'MOVCTE', 'NOTCTE');
      qryGenFis.SQL.Add('UNION ALL ');
      qryGenFis.SQL.Add(strSQL);
      qryGenFis.ParamByName('NUMDOC').AsString := strNumDoc;
      qryGenFis.ParamByName('SERIE_').AsString := strSerie;
      qryGenFis.Open;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  * ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADFIS ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  FIS_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '  AND FIS_ENTSAI = :ENTSAI ';
      strSQL := strSQL + '  AND FIS_FORCLI = :FORCLI ';
      strSQL := strSQL + '  AND FIS_TIP_FC = :TIP_FC ';
      strSQL := strSQL + '  AND FIS_ESPDOC = :ESPDOC ';
      qryTemp01.SQL.Clear;
      qryTemp01.SQL.Add(strSQL);

      strSQL := '';
      strSQL := strSQL + 'DELETE ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CADFIS ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  FIS_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '  AND FIS_ENTSAI = :ENTSAI ';
      strSQL := strSQL + '  AND FIS_FORCLI = :FORCLI ';
      strSQL := strSQL + '  AND FIS_TIP_FC = :TIP_FC ';
      strSQL := strSQL + '  AND FIS_ESPDOC = :ESPDOC ';
      qryTemp02.SQL.Clear;
      qryTemp02.SQL.Add(strSQL);

      while not qryGenFis.Eof do
      begin
        qryTemp01.Close;
        qryTemp01.ParamByName('NUMDOC').AsString := qryGenFis.FieldByName('FIS_NUMDOC').AsString;
        qryTemp01.ParamByName('ENTSAI').AsString := qryGenFis.FieldByName('FIS_ENTSAI').AsString;
        qryTemp01.ParamByName('FORCLI').AsString := qryGenFis.FieldByName('FIS_FORCLI').AsString;
        qryTemp01.ParamByName('TIP_FC').AsString := qryGenFis.FieldByName('FIS_TIP_FC').AsString;
        qryTemp01.ParamByName('ESPDOC').AsString := qryGenFis.FieldByName('FIS_ESPDOC').AsString;
        qryTemp01.Open;

        if (not qryTemp01.IsEmpty) then
        begin
          fVerificaIntegridade(Self.Name, 'CADFIS', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);

          if qryTemp01.FieldByName('FIS_ENTSAI').AsString = 'E' then
          begin
            qryTemp02.ParamByName('NUMDOC').AsString := qryGenFis.FieldByName('FIS_NUMDOC').AsString;
            qryTemp02.ParamByName('ENTSAI').AsString := qryGenFis.FieldByName('FIS_ENTSAI').AsString;
            qryTemp02.ParamByName('FORCLI').AsString := qryGenFis.FieldByName('FIS_FORCLI').AsString;
            qryTemp02.ParamByName('TIP_FC').AsString := qryGenFis.FieldByName('FIS_TIP_FC').AsString;
            qryTemp02.ParamByName('ESPDOC').AsString := qryGenFis.FieldByName('FIS_ESPDOC').AsString;
            qryTemp02.ExecSql;
          end
          else
          If (qryTemp01.FieldByName('FIS_HISTOR').AsString <> 'CANCELADO') Then
          Begin
            qryTemp01.Edit;
            qryTemp01.FieldByName('FIS_HISTOR').AsString := 'CANCELADO';

            qryTemp01.FieldByName('FIS_BASPIS').Value := Null;
            qryTemp01.FieldByName('FIS_ALQPIS').Value := Null;
            qryTemp01.FieldByName('FIS_TOTPIS').Value := Null;

            qryTemp01.FieldByName('FIS_BASCOF').Value := Null;
            qryTemp01.FieldByName('FIS_ALQCOF').Value := Null;
            qryTemp01.FieldByName('FIS_TOTCOF').Value := Null;

            For intContador := 1 To 5 Do
            Begin
              qryTemp01.FieldByName('FIS_VLCON' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_BASIC' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_ALQIC' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_VLRIC' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_OUTRA' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_ISENT' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_RETID' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_BASIP' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_VLRIP' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_BCRET' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_DACES' + IntToStr(intContador)).Value := Null;
              qryTemp01.FieldByName('FIS_VALIS' + IntToStr(intContador)).Value := Null;
            End;
            qryTemp01.Post;
            Result := True;
          End
          Else
            Result := False;

        end;

        qryGenFis.Next;
      end;

      imgLivroFiscal.Picture := imgAlterado.Picture;

    Except
      On E: Exception Do
      Begin
        fRollBack;
        pMensagensErro(E.Message, '[fCancelaCTeLivroFiscal]');
        Result := False;
      End;
    End;
  finally
    FreeAndNil(qryGenFis);
  end;
end;

function TfrmCancelamentoDocumentos.fCtrBaixadaParcial(
  qryCadRec: TUniQuery): Boolean;
  Var
    strNumDup: String;
    strParcel: String;
    intQtdDup: Integer;
begin

  Result := False;

  intQtdDup := 0;
  strNumDup := qryCadRec.FieldByName('CTR_NUMDUP').AsString;
  strParcel := qryCadRec.FieldByName('CTR_PARCEL').AsString;

  While (Not qryCadRec.Eof)                                        And
        (qryCadRec.FieldByName('CTR_NUMDUP').AsString = strNumDup) And
        (qryCadRec.FieldByName('CTR_PARCEL').AsString = strParcel) Do
  Begin
    qryCadRec.Next;
  End;

  {*******************************************}
  {* CASO SEJA FIM DE ARQUIVO, NÃO RETROCEDE *}
  {* O REGISTRO                              *}
  {****************************************MV*}
  If (Not qryCadRec.Eof) Then
    qryCadRec.Prior;

  If (intQtdDup > 1) Then
    Result := True;

end;

