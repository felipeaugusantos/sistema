function TfrmCancelamentoDocumentos.fTemBaixaDeRetorno(strNumDoc, strCliFor: String): Boolean;
  Var
    qryAux: TUniQuery;
Begin
  qryAux := fCriaQuery(Self);
  Try
    Try

      qryAux.SQL.Add('SELECT                                                ');
      qryAux.SQL.Add('  COUNT(*) AS QTD                                     ');
      qryAux.SQL.Add('FROM                                                  ');
      qryAux.SQL.Add('  MOVGAE                                              ');
      qryAux.SQL.Add('  INNER JOIN MOVGAD ON MOVGAD.AUTOINCREM = GAE_SEQGAD ');
      qryAux.SQL.Add('  INNER JOIN MOVGAU ON GAU_SEQGAE = MOVGAE.AUTOINCREM ');
      qryAux.SQL.Add('WHERE GAE_NUMENV = :NUMENV                            ');
      qryAux.SQL.Add('  AND GAE_EMPENV = :CODEMP                            ');
      qryAux.SQL.Add('  AND GAD_CODFOR = :CODFOR                            ');
      qryAux.SQL.Add('  AND GAE_ESPENV IN ("NF","GF")                       ');
      qryAux.SQL.Add('  AND GAU_SEQDET <> :VALOR_BAIXA_DEVOLUCAO_ENVIO      ');

      qryAux.ParamByName('NUMENV').AsString := strNumDoc;
      qryAux.ParamByName('CODFOR').AsString := strCliFor;
      qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryAux.ParamByName('VALOR_BAIXA_DEVOLUCAO_ENVIO').AsString := SEQDET_BAIXA_DEVOLUCAO_ENVIO;

      qryAux.Open;
      Result := qryAux.FieldByName('QTD').AsInteger > 0;
      qryAux.Close;

    finally
      FreeAndNil(qryAux);
    end;
  Except

    On E: Exception Do
    Begin
      Result := True;
      pMensagensErro(E.Message, '[fPermiteCancelarGarantia]');
    End;

  End;

End;

function TfrmCancelamentoDocumentos.fRetornaDocumentosVinculadosGarantia(strEspSel,
  strNumDoc, strCliFor: String): TArrayOfTDadosDocumentos;
 Var
    qryAux: TUniQuery;
    objSQLMovimentacaoPosterior : TSQLMovimentacaoPosterior;
Begin
  SetLength(Result,0);
  objSQLMovimentacaoPosterior := TSQLMovimentacaoPosterior.Create;
  qryAux := fCriaQuery(nil);
  try
    objSQLMovimentacaoPosterior.strCodigoEmpresaLogada := VS_strCodEmp;
    objSQLMovimentacaoPosterior.strCodigoEmpresaGarantia := fCfgSis('EMPGAR', varString);
    objSQLMovimentacaoPosterior.blnUtilizaGarantiaPelaMatriz := fCfgSis('GARMAT', varBoolean);
    objSQLMovimentacaoPosterior.strSigla := strEspSel;

    Try

      With qryAux Do
      Begin
        Close;
        SQL.Clear;
        SQL.Text := objSQLMovimentacaoPosterior.fRetornaSQL;

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('CLIFOR').AsString := strCliFor;

        If FindParam('CODEMP') <> Nil Then
          ParamByName('CODEMP').AsString := VS_strCodEmp;

        Open;

        First;
        SetLength(Result, RecordCount);
        while not eof do
        begin
          Result[RecNo -1].strNumeroDocumento  := FieldByName('NUMDOC').AsString;
          Result[RecNo -1].strEspecieDocumento := FieldByName('ESPDOC').AsString;
          Result[RecNo -1].strCodigoEmpresa    := FieldByName('CODEMP').AsString;
          next;
        end;
      End;

    Except

      On E: Exception Do
      Begin
        SetLength(Result, 0);
        pMensagensErro(E.Message, '[fPermiteCancelarGarantia]');
      End;

    End;
  finally
    FreeAndNil(objSQLMovimentacaoPosterior);
    FreeAndNil(qryAux);
  end;
end;

function TfrmCancelamentoDocumentos.fExisteEnvioParaFornecedorDaGarantia(strEspSel, strNumDoc,strCliFor: String): Boolean;
  Var
    qryConsulta : TUniQuery;
    strMensagem : String;
Begin
  qryConsulta := fCriaQuery;
  Try
    With qryConsulta, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT A.GAD_CODITE AS CODITE, ');
      Add('        D.DET_DESCRI AS DESCRI, ');
      Add('        E.GAE_NUMENV AS NUMENV, ');
      Add('        E.GAE_ESPENV AS ESPENV, ');
      Add('        E.GAE_DTAENV AS DTAENV  ');
      Add(' FROM MOVGRC R ');
      Add('   INNER JOIN MOVDET D ON D.AUTOINCREM = R.GRC_SEQDET ');
      Add('   INNER JOIN MOVGER G ON G.AUTOINCREM = D.DET_SEQGER ');
      Add('   INNER JOIN MOVGAD A ON A.AUTOINCREM = R.GRC_SEQGAD ');
      Add('   INNER JOIN MOVGAE E ON E.GAE_SEQGAD = D.AUTOINCREM ');
      Add(' WHERE G.GER_NUMDOC = :NUMDOC ');
      Add('   AND G.GER_CODCLI = :CODCLI ');
      Add('   AND G.GER_ESPDOC = :ESPDOC ');
      Add('   AND G.GER_CODEMP = :CODEMP ');
      Add('   AND GAE_NUMENV IS NOT NULL ');

      If strEspSel <> 'GA' Then
        Add('   AND G.GER_SERIE_ = :SERDOC');

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('CODCLI').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('ESPDOC').AsString := IfThen( strEspSel = 'NW', 'NF', strEspSel );
      If strEspSel <> 'GA' Then
      Begin
        If blnNW_Nfe Then
          ParamByName('SERDOC').AsString := strSerFsc
        Else
          ParamByName('SERDOC').AsString := edtSerie.Text;
      End;


      Open;

      Result := Not IsEmpty;

      If Result Then
      Begin
        strMensagem := '';
        While Not Eof Do
        Begin
          strMensagem := strMensagem + FieldByName('CODITE').AsString + ' - ' +
                                       fPadR(FieldByName('DESCRI').AsString,30) + ' ' +
                                       FieldByName('NUMENV').AsString + '-' +
                                       FieldByName('ESPENV').AsString;

          Next;

          If not Eof Then
            strMensagem := strMensagem + #13;
        End;

        fMensagemCancelamento('', 'Não é possível cancelar essa garantia pois os seguintes itens já foram enviados para o fornecedor:' + #13 + strMensagem, ['&OK']);

      End;


    End;

  Finally
    FreeAndNil(qryConsulta);
  End;

End;

