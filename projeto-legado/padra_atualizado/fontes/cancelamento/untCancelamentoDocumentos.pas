function TfrmCancelamentoDocumentos.fTemRegMovDet(blnOpcGer: Boolean; strTabela,
  strTip_FC, strCliFor, strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  qryGen := fCriaQuery;
  With qryGen, SQL Do
  Begin
    Add('SELECT COUNT(*) AS QTDREG FROM ' + strTabela);
    Add('WHERE');

    If blnOpcGer Then
    Begin
      Add('  GER_' + strTip_FC + ' = :CLIFOR AND ');
      Add('  GER_NUMFAT = :NUMDOC AND ');
      Add('  GER_TIPFAT = :ESPDOC AND ');
      Add('  GER_EMPFAT = :CODEMP    ');
    End Else
    Begin
      Add('  DET_' + strTip_FC + ' = :CLIFOR AND ');
      Add('  DET_NUMFAT = :NUMDOC AND ');
      Add('  DET_TIPFAT = :ESPDOC AND ');
      Add('  DET_EMPFAT = :CODEMP    ');
    End;

    ParamByName('CLIFOR').AsString := strCliFor;
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;

    Open;
    Result := FieldByName('QTDREG').AsInteger > 0;
    Close;

  End;
  FreeAndNil(qryGen);
End;

