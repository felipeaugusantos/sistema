            blnFilkar := FieldByName(strSigDet + 'FILKAR').AsBoolean;

          //REQ.: 228304
          If (strEspDoc = 'PA') Then
          Begin
             If (FieldByName(strSigDet + 'ESPDOC').AsString = 'PA') And
                (Pos('MOVDET', strArqDet) > 0) And
