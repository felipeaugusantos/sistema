procedure TfrmCancelamentoDocumentos.pCancelarPendencia(const blnValidarIntegridade : Boolean; const blnEscolherPendencia : Boolean);
  Var
    LDocCancelamento : TDocCancelamento;
    blnTemDocumento : Boolean;
    intOpcaoSelecionada : Integer;
begin
  If (Not fDeveVerificarLogDeCancelamento) Then
    Exit;
  If (blnValidarIntegridade) Then
    FLogCancelamento.ValidouIntegridadeDocumentos(EmptyStr, EmptyStr);
  If (Not blnEscolherPendencia) Then
    Exit;
  LDocCancelamento := FLogCancelamento.EscolherPendencia(VS_strCodEmp, blnTemDocumento);
  btnPendentesDeCancelamento.Visible := blnTemDocumento;
  If fEmptyStr(LDocCancelamento.Documento) Then
    Exit;
  blnCancelandoDocumentoLogCan := True;
  Try
    btnCancelar.Click;
    intOpcaoSelecionada := TfrmOpcaoCancelamento.EscolherOpcaoCancelamento(lsbEspecies, LDocCancelamento.OpcaoDeCancelamento);
    If (intOpcaoSelecionada = -1) Then
      Exit;
    lsbEspecies.ItemIndex := intOpcaoSelecionada;
    lsbEspeciesDblClick(lsbEspecies);
    edtNumDoc.Text := LDocCancelamento.Documento;
    edtCliFor.Text := LDocCancelamento.CodigoCliente;
    If (edtTipPes.Visible) Then
      edtTipPes.Text := LDocCancelamento.TipoClienteFornecedor;
    If (edtSerie.Visible) Then
      edtSerie.Text := LDocCancelamento.SerieFiscal;
    btnAdicionar.Click;
  Finally
    blnCancelandoDocumentoLogCan := False;
    btnPendentesDeCancelamento.Visible := FLogCancelamento.ExistePendenciaDeCancelamento(VS_strCodEmp);
  End;
end;

function TfrmCancelamentoDocumentos.fOperadorDoCancelamento : String;
begin
  Result := strLoginUsuarioLogado;
  If (Not blnCancelandoDocumentoLogCan) Then
    Exit;
  If fEmptyStr(strOpeDel) Then
    Exit;
  Result := strOpeDel;
end;

procedure TfrmCancelamentoDocumentos.pVerificaSeEstaCancelandoPendencia(var blnCancelandoPendencia : Boolean);
  Var
    blnTemDocumento : Boolean;
begin
  blnCancelandoPendencia := False;
  btnPendentesDeCancelamento.Visible := False;
  blnTemDocumento := False;
  If (Not fDeveVerificarLogDeCancelamento) Then
    Exit;
  FLogCancelamento.VerificarSeDocumentoJaFoiCancelado(VS_strCodEmp, blnTemDocumento);
  If (Not blnTemDocumento) Then
    Exit;
  If (Not FLogCancelamento.ExistePendenciaDeCancelamento(VS_strCodEmp)) Then
    Exit;
  btnPendentesDeCancelamento.Visible := True;
  If FLogCancelamento.EhDocumentoPendente(edtNumDoc.Text, edtCliFor.Text) Then
  Begin
    blnCancelandoPendencia := True;
    Exit;
  End;
end;

procedure TfrmCancelamentoDocumentos.pCancelarProSer(strCodEmp, strNumDoc, strEspDoc: String);
Var
  qryTabela : TUniQuery;
begin
  qryTabela := fCriaQuery;
  Try
    qryTabela.SQL.Add('SELECT * FROM PROSER WHERE SER_CODEMP = :CODEMP');
    qryTabela.SQL.Add('AND SER_NUMDOC = :NUMDOC');
    qryTabela.SQL.Add('AND SER_ESPDOC = :ESPDOC');
    qryTabela.SQL.Add('AND fCfgSis("CFG_NUMSER",SER_CODEMP) = "S"');
    qryTabela.SQL.Add('AND fCfgSis("CFG_ENTEND",SER_CODEMP) = "N"');
    qryTabela.ParamByName('CODEMP').AsString := strCodEmp;
    qryTabela.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTabela.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTabela.Open;
    If Not qryTabela.IsEmpty Then
    Begin
      qryTabela.First;
      While Not qryTabela.Eof Do
      Begin
        fVerificaIntegridade(Self.Name, 'PROSER', qryTabela, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);
        qryTabela.Next;
      End;
    End;
    qryTabela.SQL.Clear;
    qryTabela.SQL.Add('DELETE FROM PROSER ');
    qryTabela.SQL.Add('WHERE SER_CODEMP = :CODEMP');
    qryTabela.SQL.Add('  AND SER_NUMDOC = :NUMDOC');
    qryTabela.SQL.Add('  AND SER_ESPDOC = :ESPDOC');
    qryTabela.SQL.Add('  AND fCfgSis("CFG_NUMSER",SER_CODEMP) = "S"');
    qryTabela.SQL.Add('  AND fCfgSis("CFG_ENTEND",SER_CODEMP) = "N"');
    qryTabela.ParamByName('CODEMP').AsString := strCodEmp;
    qryTabela.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTabela.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTabela.ExecSQL;
  Finally
    qryTabela.Free;
  End;
End;

procedure TfrmCancelamentoDocumentos.pApagaReservaEnderecamentoDaLotPre(AStrMovGer: String);
var
  lQryComand: TUniQuery;
  lSeqFatGor: String;
begin
  lQryComand := fCriaQuery;
  Try
    lQryComand.SQL.Add('SELECT FD.FDO_SEQGER ');
    lQryComand.SQL.Add(' FROM MOVGER G');
    lQryComand.SQL.Add('  INNER JOIN MOVDET D ON D.DET_SEQGER = G.AUTOINCREM   ');
    lQryComand.SQL.Add('  INNER JOIN LOTPRE P ON P.LTP_SEQDET = D.AUTOINCREM   ');
    lQryComand.SQL.Add('  INNER JOIN EXTDOR ED ON ED.FDO_SEQPRE = P.AUTOINCREM ');
    lQryComand.SQL.Add('  INNER JOIN FATDOR FD ON FD.AUTOINCREM = ED.FDO_SEQFDO');
    lQryComand.SQL.Add(' WHERE G.AUTOINCREM = "'+AStrMovGer+'"');
    lQryComand.SQL.Add(' GROUP BY FD.FDO_SEQGER');
    lQryComand.Open;

    If lQryComand.IsEmpty then
      Exit;

    lSeqFatGor := lQryComand.FieldByName('FDO_SEQGER').AsString;

    lQryComand.SQL.Clear;
    lQryComand.SQL.Add('DELETE FROM FATGOR WHERE AUTOINCREM = "'+lSeqFatGor+'"');
    lQryComand.ExecSQL;
  Finally
    FreeAndNil(lQryComand);
  End;
end;

function TfrmCancelamentoDocumentos.fCancelaBaixaOrdemProducao(AStrEspDoc, AStrNumDoc, AstrCliFor: String): Boolean;
var
  qryAux: TUniQuery;
  strAutIncMovGer,
  strCodPro: String;
begin
  Result := True;
  qryAux := fCriaQuery;

  Try
    qryAux.SQL.Clear;
    qryAux.SQL.Add(' SELECT                                                ');
    qryAux.SQL.Add('  MOVGER.AUTOINCREM AS GER_AUTINC,                     ');
    qryAux.SQL.Add('  PRO_CODPRO                                           ');
    qryAux.SQL.Add(' FROM MOVGER                                           ');
    qryAux.SQL.Add(' INNER JOIN RFGORD ON ORD_SEQGER = MOVGER.AUTOINCREM   ');
    qryAux.SQL.Add(' INNER JOIN MOVPRO ON ORD_SEQORD = MOVPRO.AUTOINCREM   ');
    If AStrEspDoc = 'OF' Then
      qryAux.SQL.Add(' INNER JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM  ');
    qryAux.SQL.Add(' WHERE TRUE                                            ');
    qryAux.SQL.Add('  AND GER_NUMDOC = :NUMDOC                             ');
    If AStrEspDoc = 'OF' Then
      qryAux.SQL.Add('  AND AUX_OPCDOC = :ESPDOC                           ')
    Else
      qryAux.SQL.Add('  AND GER_ESPDOC = :ESPDOC                             ');
    qryAux.SQL.Add('  AND GER_CODCLI = :CODCLI                             ');
    qryAux.SQL.Add('  AND GER_CODEMP = :CODEMP                             ');
    qryAux.SQL.Add(' LIMIT 1                                               ');

    qryAux.ParamByName('NUMDOC').AsString := AStrNumDoc;

    If AStrEspDoc = 'OF' Then
      qryAux.ParamByName('ESPDOC').AsString := 'OU'
    Else
      qryAux.ParamByName('ESPDOC').AsString := AStrEspDoc;
    qryAux.ParamByName('CODCLI').AsString := AstrCliFor;
    qryAux.ParamByName('CODEMP').AsString := VS_StrCodEmp;

    qryAux.Open;

    strAutIncMovGer := qryAux.FieldByName('GER_AUTINC').AsString;
    strCodPro := qryAux.FieldByName('PRO_CODPRO').AsString;

    If fEmptyStr(strAutIncMovGer) Then
      Exit;

    Result := TfrmCancelaBaixaOrdProd.fCancelaBaixa(strCodPro);
  Finally
    FreeAndNil(qryAux);
  End;
end;

