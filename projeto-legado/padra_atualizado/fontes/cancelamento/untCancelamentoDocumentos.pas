End;

procedure TfrmCancelamentoDocumentos.pObtemDadosLocacaoEquipamento(const strEspDoc, strNumDoc: String);
var
  qryAux: TUniQuery;
begin

  If fEmptyStr(strNumDoc) Then
    Exit;

  qryAux := fCriaQuery(Self);
  Try
    Try
      qryAux.SQL.Add('SELECT DISTINCT                                                   ');
      qryAux.SQL.Add('       EQL_AUT_PD, FGO_NUMDOC, FGO_ESPDOC, FGO_CODEMP, EQF_SEQCON ');
      qryAux.SQL.Add('  FROM CONEQL                                           ');
      qryAux.SQL.Add('  INNER JOIN EQLFAT ON  (EQF_SEQCON = CONEQL.AUTOINCREM)');
      qryAux.SQL.Add('  LEFT  JOIN FATGOR ON FATGOR.AUTOINCREM = EQL_AUT_PD   ');
      qryAux.SQL.Add('  WHERE EQF_ESPDOC = :EQF_ESPDOC                        ');
      qryAux.SQL.Add('    AND EQF_NUMDOC = :EQF_NUMDOC                        ');
      qryAux.SQL.Add('    AND EQF_EMPDOC = :EQF_EMPDOC                        ');

      qryAux.ParamByName('EQF_ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('EQF_NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('EQF_EMPDOC').AsString := VS_strCodEmp;

      qryAux.Open;
      If Not qryAux.isEmpty Then
      Begin
        FNumDocAdt :=  qryAux.FieldByName('FGO_NUMDOC').AsString;
        FEmpDocAdt :=  qryAux.FieldByName('FGO_CODEMP').AsString;
        FAutDocAdt :=  qryAux.FieldByName('EQL_AUT_PD').AsString;
        FEspDocAdt :=  'PD';
        FAutIncCon :=  qryAux.FieldByName('EQF_SEQCON').AsString;
      End;

    Finally
      qryAux.Close;
      FreeAndNil(qryAux);
    End;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.pObtemDadosAdiantamentoLocacaoEquipamento]');
    End;
  End;
End;

function TfrmCancelamentoDocumentos.fEhGarantiaComDocFiscal(strEspSel,
  strNumDoc, strCliFor: String; Var strDocGar: String): Boolean;
  Var
    strSQL: String;
    qryTmp: TUniQuery;
begin
  Result := False;
  strDocGar := '';

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   GRC_OPCDOC, ';
  strSQL := strSQL + '   GRC_TIPMOD, ';
  strSQL := strSQL + '   IFNULL(DET_NUMDOC, "") AS NUMDOC, ';
  strSQL := strSQL + '   IFNULL(DET_ESPDOC, "") AS ESPDOC ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   MOVGRC ';
  strSQL := strSQL + '        JOIN MOVGAD ON (MOVGAD.AUTOINCREM = GRC_SEQGAD) ';
  strSQL := strSQL + '        JOIN MOVGAG ON (MOVGAG.AUTOINCREM = MOVGAD.GAD_SEQGAG) ';
  strSQL := strSQL + '   LEFT JOIN MOVDET ON (MOVDET.AUTOINCREM = MOVGRC.GRC_SEQDET) ';
  strSQL := strSQL + ' WHERE ';
  If strEspSel = 'NW' Then
  Begin
    strSQL := strSQL + '   DET_NUMDOC = :NUMENT AND ';
    strSQL := strSQL + '   DET_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '   DET_CODCLI = :CODCLI  ';
  End
  Else
  Begin
    strSQL := strSQL + '   GAG_NUMENT = :NUMENT AND ';
    strSQL := strSQL + '   GAG_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '   GAG_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '   GRC_OPCDOC IN ("OE", "NE") ';
  End;

  Try
    qryTmp := fCriaQuery(Self);

    With qryTmp Do
    Begin
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMENT').AsString := strNumDoc;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := strCliFor;
      Open;

      If Not IsEmpty Then
      Begin
        strDocGar := FieldByName('NUMDOC').AsString;
        strDocGar := strDocGar + ' selecionando ' + IfThen(Pos(FieldByName('GRC_OPCDOC').AsString, 'OE_DV_') > 0, ' "Outras Entrada" ', ' "Entrada de Mercadorias" ');
        Result := Not fEmptyStr(strDocGar);
      End;
    end;
  Except
    On E:Exception Do
      pMensagensErro(E.Message, '[fEhGarantiaComDocFiscal]');
  End;
end;

function TfrmCancelamentoDocumentos.fEhNFDevolucao(strNumDoc, strTipFc, strSerie, strCodEmp,
  strEspDoc: String): Boolean;

  Function fGetSQLDoc(strTab: String): String;
  Begin
    Result := '';
    Result := Result + ' SELECT ';
    Result := Result + '    *   ';
    Result := Result + ' FROM ';
    Result := Result + '  ' + strTab + '  ';
    Result := Result + ' WHERE ';
    Result := Result + '   DET_NUMDOC = :NUMDOC AND ';
    Result := Result + '   DET_TIP_FC = :TIP_FC AND ';
    Result := Result + '   DET_ESPDOC = :ESPDOC AND ';
    Result := Result + '   DET_CODEMP = :CODEMP AND ';
    Result := Result + '   LEFT(DET_CLAFIS,1) < 5 AND ';
    If Not fEmptyStr(strSerie) Then
      Result := Result + ' IFNULL(DET_SERIE_, "") = :SERIE AND ';
    Result := Result + '   DET_CODEMP = :CODEMP AND';
    Result := Result + '   TRIM(IFNULL(DET_DOCDEV, "")) <> ""  ';
  End;

  Var
    qryGer : TUniQuery;

begin
  qryGer := fCriaQuery(Nil);
  Try
    With qryGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fGetSQLDoc('MOVDET'));
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('TIP_FC').AsString := strTipFc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      If Not fEmptyStr(strSerie) Then
        ParamByName('SERIE').AsString := strSerie;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      If (IsEmpty) Then
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQLDoc('NOTDET'));
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('TIP_FC').AsString := strTipFc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        If Not fEmptyStr(strSerie) Then
          ParamByName('SERIE').AsString := strSerie;
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;
      End;

      Result := Not IsEmpty;

      Close;
    End;
  Finally
    FreeAndNil(qryGer);
  End;
end;

function TfrmCancelamentoDocumentos.fEhNFDevolucaoClientesPorOutrasEntradas(strNumDoc, strTipFc, strSerie, strCodEmp: String; strEspDoc: String = 'NF'): Boolean;

  Function fGetSQLDoc: String;
  Begin
    Result := '';
    Result := Result + ' SELECT G.AUTOINCREM ';
    Result := Result + '    FROM MOVGER G';
    Result := Result + '   INNER JOIN AUXMOV A ON G.AUTOINCREM = A.AUX_SEQGER ';
    Result := Result + ' WHERE ';
    Result := Result + '   GER_NUMDOC = :NUMDOC AND ';
    Result := Result + '   GER_TIP_FC = :TIP_FC AND ';
    Result := Result + '   GER_ESPDOC = :ESPDOC AND ';
    Result := Result + '   GER_CODEMP = :CODEMP AND ';
    Result := Result + '   LEFT(GER_CLAFIS,1) < 5 AND ';
    If Not fEmptyStr(strSerie) Then
      Result := Result + ' IFNULL(GER_SERIE_, "") = :SERIE AND ';
    Result := Result + '   GER_CODEMP = :CODEMP AND';
    Result := Result + '   AUX_OPCDOC = "OE" ';
  End;

  Var
    qryGer : TUniQuery;
begin
  qryGer := fCriaQuery(Nil);
  Try
    With qryGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fGetSQLDoc);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('TIP_FC').AsString := strTipFc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      If Not fEmptyStr(strSerie) Then
        ParamByName('SERIE').AsString := strSerie;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      Result := Not IsEmpty;

      Close;
    End;
  Finally
    FreeAndNil(qryGer);
  End;
end;

function TfrmCancelamentoDocumentos.fEhDevolucaoDeColetaPorGarantia(strEspSel, strNumDocSel, strCliForSel, strSerie: String;
                                                                    out AstrCreditoNumDup, AstrCreditoEspDoc, AstrCreditoCodEmp, AstrCreditoCodCli: String;
                                                                    out AblnTemCreditoDeColetaPorGarantia: Boolean ): Boolean;
var
  strAutIncMovger : String;
  qryAux: TUniQuery;
begin

  qryAux := fCriaQuery(Self);

  Try
    AblnTemCreditoDeColetaPorGarantia := False;
    strAutIncMovger := '';
    AstrCreditoNumDup := '';
    AstrCreditoEspDoc := '';
    AstrCreditoCodEmp := '';
    AstrCreditoCodCli := '';

    qryAux.SQl.Add('SELECT AUXMOV.AUX_COLETA, MOVGER.AUTOINCREM AS AUTINC');
    qryAux.SQl.Add('  FROM MOVGER');
    qryAux.SQl.Add(' INNER JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM');
    qryAux.SQl.Add(' WHERE GER_NUMDOC = :NUMDOC');
    qryAux.SQl.Add('   AND GER_CODEMP = "' + VS_StrCodEMP + '"');
    qryAux.SQl.Add('   AND GER_CODCLI = :CODCLI');
    qryAux.SQl.Add('   AND GER_ESPDOC = :ESPDOC');

    If Not strSerie.IsEmpty Then
      qryAux.SQl.Add('   AND GER_SERIE_ = :SERIE_');

    qryAux.ParamByName('NUMDOC').AsString := strNumDocSel;
    qryAux.ParamByName('CODCLI').AsString := strCliForSel;
    qryAux.ParamByName('ESPDOC').AsString := strEspSel;

    If Not strSerie.IsEmpty Then
      qryAux.ParamByName('SERIE_').AsString := strSerie;

    qryAux.Open;

    strAutIncMovger := qryAux.FieldByName('AUTINC').AsString;
    Result := qryAux.FieldByName('AUX_COLETA').AsString = 'S';

    If Result Then
    Begin
     qryAux.Close;
     qryAux.SQl.Clear;
     qryAux.SQl.Add('   SELECT CTR_NUMDUP, CTR_ESPDOC, CTR_CODEMP, CTR_CODCLI, GCD_QTDSEM, GCD_TIPGAR, GCD_TIPGAR, IF((COUNT(1)>0), "S","N") AS TEMCREDITO  ');
     qryAux.SQl.Add('     FROM MOVGCG                                                                                                                     ');
     qryAux.SQl.Add('    INNER JOIN MOVGCD ON MOVGCG.AUTOINCREM = MOVGCD.GCD_SEQGCG                                                                       ');
     qryAux.SQl.Add('    INNER JOIN CADREC ON CTR_INCDOC = GCG_SEQGER                                                                                     ');
     qryAux.SQl.Add('    WHERE GCG_SEQGER = :AUTINC                                                                                                       ');
     qryAux.SQl.Add('    GROUP BY CTR_NUMDUP, CTR_ESPDOC, CTR_CODEMP, CTR_CODCLI                                                                          ');
     qryAux.SQl.Add('   HAVING ((GCD_QTDSEM > 0 AND GCD_TIPGAR = 0)                                                                                       ');
     qryAux.SQl.Add('            OR                                                                                                                       ');
     qryAux.SQl.Add('           (GCD_TIPGAR = 2))                                                                                                         ');

     qryAux.ParamByName('AUTINC').AsString := strAutIncMovger;
     qryAux.Open;

     AstrCreditoNumDup := qryAux.FieldByName('CTR_NUMDUP').AsString;
     AstrCreditoEspDoc := qryAux.FieldByName('CTR_ESPDOC').AsString;
     AstrCreditoCodEmp := qryAux.FieldByName('CTR_CODEMP').AsString;
     AstrCreditoCodCli := qryAux.FieldByName('CTR_CODCLI').AsString;
     AblnTemCreditoDeColetaPorGarantia := qryAux.FieldByName('TEMCREDITO').AsString = 'S' ;
    End

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TfrmCancelamentoDocumentos.fEhDocumentoDeDevolucao(const strNumDoc,
  strEspDoc, strTipFc, strCliFor: String): Boolean;
  Var
    qryAux: TUniQuery;
    strSQL: String;
begin
  qryAux := fCriaQuery;
  Try
    strSQL := '';
    strSQL := strSQL + ' SELECT COUNT(1) AS QTD ';
    strSQL := strSQL + ' FROM MOVDET ';
    strSQL := strSQL + ' WHERE DET_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '   AND DET_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '   AND DET_CODEMP = :CODEMP ';
    strSQL := strSQL + '   AND DET_' + strTipFc + ' = :CLIFOR ';
    strSQL := strSQL + '   AND LOCATE(DET_CLAFIS, :CLADEV) > 0 ';

    strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(strSQL, 'MOVDET', 'NOTDET');

    qryAux.SQL.Text := 'SELECT SUM(QTD) AS QTD FROM ('+ strSQL +') AS MOV';

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.ParamByName('CLIFOR').AsString := strCliFor;
    qryAux.ParamByName('CLADEV').AsString := VS_strClaDev;
    qryAux.Open;

    Result := (qryAux.FieldByName('QTD').AsInteger > 0);
  Finally
    FreeAndNil(qryAux);
  End;
end;

