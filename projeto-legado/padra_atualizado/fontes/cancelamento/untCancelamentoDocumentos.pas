function TfrmCancelamentoDocumentos.fVerificarTransfAutomDocVenda(
  Const strNumDoc, strEspDoc, strCodCli: String): Boolean;
  Var
    strDocs: TArray<String>;
begin
  Result := True;

  If fExisteMovGeradoTransfAutomDocVenda(strNumDoc, strEspDoc, strCodCli, strDocs) Then
  Begin
    Result := False;

    pCriarFormularios(TfrmCancelamentoDocResumo, frmCancelamentoDocResumo);
    frmCancelamentoDocResumo.memResumo.Font.Name := 'Courier New';
    frmCancelamentoDocResumo.memResumo.Font.Size := 10;
    frmCancelamentoDocResumo.memResumo.Lines.Add('Esta venda tem transferência de estoque que foi gerada automaticamente para as empresas responsáveis pelo carregamento dos produtos.');
    frmCancelamentoDocResumo.memResumo.Lines.Add('Por favor, cancele o(s) documento(s) na empresa de origem para depois efetuar o cancelamento da venda.');
    frmCancelamentoDocResumo.memResumo.Lines.Add('Documentos:');
    frmCancelamentoDocResumo.memResumo.Lines.Add('');
    frmCancelamentoDocResumo.memResumo.Lines.AddStrings(strDocs);
    If (FExecutandoCanceladorAutomatico) Then
      pMensagemOK(frmCancelamentoDocResumo.memResumo.Lines.Text)
    Else If CancelandoNFViaFulFillment Then
      objFulFillmentLogBuilder.pSalvarLog(frmCancelamentoDocResumo.memResumo.Lines.Text, True)
    Else
      frmCancelamentoDocResumo.ShowModal;

    pFreeAndNil(frmCancelamentoDocResumo);
  End;
end;

function TfrmCancelamentoDocumentos.fPermiteCanRecClienteGar(strEspSel,
  strNumDoc, strCliFor: String; var strDocGar: String): Boolean;
 Var
    qryAux: TUniQuery;
    strSQL: String;
begin
  Result := False;

  qryAux := fCriaQuery(Self);

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   DISTINCT GG.GAG_NUMENT NUMENT ';
  strSQL := strSQL + ' FROM MOVGER G ';
  strSQL := strSQL + ' JOIN MOVDET D ON D.DET_SEQGER = G.AUTOINCREM ';
  strSQL := strSQL + ' JOIN MOVGRC M ON  M.GRC_SEQDET = D.AUTOINCREM ';
  strSQL := strSQL + ' JOIN MOVGAD GD ON GD.AUTOINCREM = M.GRC_SEQGAD ';
  strSQL := strSQL + ' JOIN MOVGAG GG ON GG.AUTOINCREM = GD.GAD_SEQGAG ';
  strSQL := strSQL + ' WHERE G.GER_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '       G.GER_ESPDOC = :ESPDOC AND ';

  If (Pos(strEspSel, 'GA_GC_') > 0) Then
  Begin
    If SameText(strEspSel, 'GA') Then
      strSQL := strSQL + '   M.GRC_OPCDOC = "GA" AND '
    Else
      strSQL := strSQL + '   M.GRC_OPCDOC IN ("GC", "EC") AND ';
  End
  Else
    strSQL := strSQL + '     M.GRC_OPCDOC IN ("OU", "OE", "NE", "DV") AND ';

  If Not fEmptyStr(strCliFor) Then
    strSQL := strSQL + '     G.GER_CODCLI = :CODCLI AND ';

  strSQL := strSQL + '       G.GER_CODEMP = :CODEMP ';

  If Pos(strEspSel, 'NE_ND_') > 0 Then
    strSQL := strSQL + ' AND G.GER_SERIE_ = :SERIE ';

  Try

    With qryAux Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := IIF(Pos(strEspSel, 'NE_ND_') > 0, 'NF', strEspSel);

      If Not fEmptyStr(strCliFor) Then
      ParamByName('CODCLI').AsString := strCliFor;

      ParamByName('CODEMP').AsString := VS_strCodEmp;

      If Pos(strEspSel, 'NE_ND_') > 0 Then
        ParamByName('SERIE').AsString := edtSerie.Text;

      Open;

      If (IsEmpty) Then
        Result := True
      Else
        strDocGar := FieldByName('NUMENT').AsString;
    End;

  Except

    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fPermiteCanRecClienteGar]');
    End;

  End;
end;

