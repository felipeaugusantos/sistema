procedure TfrmCancelamentoDocumentos.pVoltaNotaSaidaTE(strNumFat, strEmpFat, strTipFat: String);
  Var
    qryTmp : TUniQuery;
    strSQL : String;
begin
  qryTmp := fCriaQuery(Self);

  Try
    strSQL := '';
    strSQL := strSQL + ' UPDATE NOTGER               ';
    strSQL := strSQL + '    SET GER_NUMFAT = "",     ';
    strSQL := strSQL + '        GER_EMPFAT = NULL,   ';
    strSQL := strSQL + '        GER_TIPFAT = "",     ';
    strSQL := strSQL + '        GER_DTAFAT = NULL,   ';
    strSQL := strSQL + '        GER_VENFAT = NULL,   ';
    strSQL := strSQL + '        GER_CNDFAT = "",     ';
    strSQL := strSQL + '        GER_VALFAT = 0.0     ';
    strSQL := strSQL + '  WHERE GER_NUMFAT = :NUMFAT ';
    strSQL := strSQL + '    AND GER_EMPFAT = :EMPFAT ';
    strSQL := strSQL + '    AND GER_TIPFAT = :TIPFAT ';

    With qryTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMFAT').AsString := strNumFat;
      ParamByName('EMPFAT').AsString := strEmpFat;
      ParamByName('TIPFAT').AsString := strTipFat;
      ExecSQL;
      Close;
    End;

  Finally
    FreeAndNil(qryTmp);
  End;
end;

function TfrmCancelamentoDocumentos.RetornaDuplicatasBoletoRegistrado(
  ADataSet: TDataSet): String;
begin
  Result := '';
  ADataSet.First;
  While Not ADataSet.Eof Do
  Begin
    Result := Result + ADataSet.FieldByName('CTRINC').AsString + ',';
    ADataSet.Next;
  End;

  Result:= LeftStr(Result, Result.Length - 1);
end;

function TfrmCancelamentoDocumentos.VerificarCadRecAbertoPix(strNumDoc,
  strEspDoc, strCliFor, strCodEmp: String): TStringList;
  Var
    qryAux: TUniQuery;
    strAutincMovGerFC: string;
begin
  Result := TStringList.Create;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  CTR_NUMDUP, ');
  qryAux.SQL.Add('  CTR_PARCEL, ');
  qryAux.SQL.Add('  CTR_ESPDOC, ');
  qryAux.SQL.Add('  CTR_CODEMP, ');
  qryAux.SQL.Add('  CTR_CODCLI  ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');

  if not fEmptyStr(strCliFor) then
    qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');
  qryAux.SQL.Add('  CTR_DTAREC IS NULL AND ');
  qryAux.SQL.Add('  CTR_TX_PIX IS NOT NULL ');

  qryAux.ParamByName('NUMDUP').AsString := AnsiRightStr(strNumDoc, fTamDocCadRec());
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCodEmp;
  if not fEmptyStr(strCliFor) then
    qryAux.ParamByName('CODCLI').AsString := strCliFor;
  qryAux.Open;

  if qryAux.IsEmpty then
  begin
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT AUTOINCREM FROM MOVGER ');
    qryAux.SQL.Add('WHERE GER_NUMDOC = :NUMDOC');
    qryAux.SQL.Add('AND GER_ESPDOC = :ESPDOC');
    qryAux.SQL.Add('AND GER_CODEMP = :CODEMP');
    if not fEmptyStr(strCliFor) then
      qryAux.SQL.Add('AND GER_CODCLI = :CODCLI');

    qryAux.ParamByName('NUMDOC').AsString := AnsiRightStr(strNumDoc, fTamDocCadRec());
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    if not fEmptyStr(strCliFor) then
      qryAux.ParamByName('CODCLI').AsString := strCliFor;
    qryAux.Open;

    if not qryAux.IsEmpty then
    begin
      strAutincMovGerFC := qryAux.FieldByName('AUTOINCREM').AsString;
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT * FROM CADREC ');
      qryAux.SQL.Add('WHERE CTR_SEQFCO = :SEQFCO');

      qryAux.ParamByName('SEQFCO').AsString := strAutincMovGerFC;
      qryAux.Open;

      if not qryAux.IsEmpty then
      begin
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add('SELECT ');
        qryAux.SQL.Add('  CTR_NUMDUP, ');
        qryAux.SQL.Add('  CTR_PARCEL, ');
        qryAux.SQL.Add('  CTR_ESPDOC, ');
        qryAux.SQL.Add('  CTR_CODEMP, ');
        qryAux.SQL.Add('  CTR_CODCLI  ');
        qryAux.SQL.Add('FROM ');
        qryAux.SQL.Add('  CADREC ');
        qryAux.SQL.Add('WHERE ');
        qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
        qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
        qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');
        if not fEmptyStr(strCliFor) then
          qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');
        qryAux.SQL.Add('  CTR_DTAREC IS NULL AND ');
        qryAux.SQL.Add('  CTR_TX_PIX IS NOT NULL ');

        qryAux.ParamByName('NUMDUP').AsString := AnsiRightStr(strNumDoc, fTamDocCadRec());
        qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
        qryAux.ParamByName('CODEMP').AsString := strCodEmp;
        if not fEmptyStr(strCliFor) then
          qryAux.ParamByName('CODCLI').AsString := strCliFor;
        qryAux.Open;
      end;
    end;
  end;

  While (Not qryAux.Eof) Do
  Begin
    Result.Add(qryAux.FieldByName('CTR_NUMDUP').AsString +
               qryAux.FieldByName('CTR_PARCEL').AsString + ' - ' +
               qryAux.FieldByName('CTR_ESPDOC').AsString + ' Loja: ' +
               qryAux.FieldByName('CTR_CODEMP').AsString);
    qryAux.Next;
  End;

  qryAux.Close;
  FreeAndNil(qryAux);
end;

function TfrmCancelamentoDocumentos.fVerificaNotaFiscalEletronica(
  strNumDoc: String; strCodcli: String; Var strEspCan: String): Boolean;
  Var
    qryGen: TUniQuery;
    strEspecie: String;
begin
  If (fCfgSis('USNFCE', varBoolean) Or fUsaSat) And (strEspCan = 'IF') Or (strEspCan = 'IC') Then
    strEspecie := '"IF" '
  Else If strEspCan = 'NS' Then
    strEspecie := '"NS" '
  Else
    strEspecie := '"NF", "EL"';

  Try

    qryGen := fCriaQuery(Self);
    qryGen.SQL.Text := 'SELECT FIS_ESPDOC, FIS_ACESSO, FIS_ORIDOC FROM ' +
                       'CADFIS WHERE FIS_NUMDOC = :NUMDOC AND FIS_ESPDOC IN (' + strEspecie + ') AND ' +
                       'FIS_FORCLI = :CODCLI AND FIS_CODEMP = :CODEMP ';
    qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
    qryGen.ParamByName('CODCLI').AsString := strCodcli;
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGen.Open;

    Result := Not ((qryGen.FieldByName('FIS_ACESSO').IsNull) Or (fEmptyStr(qryGen.FieldByName('FIS_ACESSO').AsString)));

    If Result Then
      Result := qryGen.FieldByName('FIS_ORIDOC').AsString = 'V';

    If Result Then
      strEspCan := qryGen.FieldByName('FIS_ESPDOC').AsString;

  Finally
    FreeAndNil(qryGen);
  End;
end;

function TfrmCancelamentoDocumentos.fPodeCancelarTravaFechamento(strEspSel, strTipFc, strNumDoc, strCliFor: String): Boolean;
  Var
    qryTmpAux : TUniQuery;
    strSQL    : String;
    dtaDtaFec : TDate;
begin
  Result    := True;

  If not (fCfgSis('UTIFEC', varBoolean)) then
    exit;

  If (Not fSuportaInterfaceGrafica) Then
    Exit;

  qryTmpAux := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  GER_DTAENT ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  GER_' + strTipFc + '  = :CLIFOR AND ';
  strSQL := strSQL + '  GER_CODEMP = :CODEMP';
  With qryTmpAux Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspSel;
    ParamByName('CLIFOR').AsString := strCliFor;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;

    If Not IsEmpty Then
    Begin
      dtaDtaEntEstoque := FieldByName('GER_DTAENT').AsDateTime;

      dtaDtaFec := TFechamentoEstoque.fDataFechamento;

      If (not fEmptyDate(FieldByName('GER_DTAENT').AsString)) and (FieldByName('GER_DTAENT').AsDateTime <= dtaDtaFec) Then
      Begin
        pMensagemOk('A data de entrada do documento (' + FormatDateTime('DD/MM/YYY', FieldByName('GER_DTAENT').AsDateTime) +
                    ') é menor ou igual a do último fechamento de estoque (' + FormatDateTime('DD/MM/YYY', dtaDtaFec) + ')!');
        Result := False;

      End Else
      Begin
        dtaDtaFec := TFechamentoFiscal.fDataFechamento;

        If  (not fEmptyDate(FieldByName('GER_DTAENT').AsString)) and (FieldByName('GER_DTAENT').AsDateTime <= dtaDtaFec) Then
        Begin
          pMensagemOk('A data de entrada do documento (' + FormatDateTime('DD/MM/YYY', FieldByName('GER_DTAENT').AsDateTime) +
                      ') é menor ou igual a do último fechamento fiscal (' + FormatDateTime('DD/MM/YYY', dtaDtaFec) + ')!');
          Result := False;
        End;

      End;

    End;

    Close;
    FreeAndNil(qryTmpAux);
  End;
end;

function TfrmCancelamentoDocumentos.fPodeCancelar(strEspSel, strTipFc,
  strNumDoc, strCliFor: String): Boolean;
  Var
    qryTmpAux : TUniQuery;
    strSQL    : String;
    strDtaEnt : String;
begin
  Result    := True;

  strDtaEnt := '';

  qryTmpAux := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  GER_DTAENT ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  GER_' + strTipFc + '  = :CLIFOR AND ';
  strSQL := strSQL + '  GER_CODEMP = :CODEMP';
  With qryTmpAux Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspSel;
    ParamByName('CLIFOR').AsString := strCliFor;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;
    If Not IsEmpty Then
    Begin

      strDtaEnt := FieldByName('GER_DTAENT').AsString;

    End
    Else
    Begin
      Close;
      SQL.Clear;
      strSQL := AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CLIFOR').AsString := strCliFor;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;
      If Not IsEmpty Then
      Begin

        strDtaEnt := FieldByName('GER_DTAENT').AsString;

      End;

    End;
    Close;
    FreeAndNil(qryTmpAux);
  End;

  If (strDtaEnt <> '') And (StrToDate(strDtaEnt) <= StrToDate(strDtTrav)) Then
    Result := False;
end;

function TfrmCancelamentoDocumentos.fPodeDesfaturarDocumento(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryAux: TUniQuery;
    strSQL: String;
    strSQLFin: String;
begin
  if not fEmptyStr(strNumDoc) then
  Begin
    qryAux := fCriaQuery(Self);
    strSQL := '';
    strSQL := strSQL + '  SELECT ';
    strSQL := strSQL + '    COUNT(DISTINCT CONCAT(DET_NUMDOC, DET_ESPDOC, DET_CODEMP, DET_CODCLI)) AS QTDITE ';
    strSQL := strSQL + '  FROM ';
    strSQL := strSQL + '    MOVDET ';
    strSQL := strSQL + '  WHERE ';
    strSQL := strSQL + '    DET_NUM_PD = :NUMPED AND ';
    strSQL := strSQL + '    DET_ESP_PD = :ESPPED AND ';
    strSQL := strSQL + '    DET_EMP_PD = :EMPPED AND ';
    strSQL := strSQL + '    DET_ESPDOC NOT IN ("ML", "PR", "TM", "NV", "IV") ';

    strSQLFin := '';
    strSQLFin := strSQLFin + 'SELECT ';
    strSQLFin := strSQLFin + '  SUM(QTDITE) AS TOTAL ';
    strSQLFin := strSQLFin + 'FROM (' + strSQL + ') AS TBL ';

    qryAux.SQL.Clear;
    qryAux.SQL.Add(strSQLFin);
    qryAux.ParamByName('NUMPED').AsString := strNumDoc;
    qryAux.ParamByName('ESPPED').AsString := strEspDoc;
    qryAux.ParamByName('EMPPED').AsString := strCodEmp;
    qryAux.Open;

    Result := qryAux.FieldByName('TOTAL').AsInteger <= 1;

    FreeAndNil(qryAux);
  End
  Else
    Result := True;
end;

function TfrmCancelamentoDocumentos.fPossuiSeparacaoUtilizandoLocTransitoria(const ANumDoc, AEspDoc, ACodEmp: String): Boolean;
var
  LQry: TUniQuery;
begin
  Result := False;

  if (not fGuardarItensSeparadosQuandoUtilizarLocTransitoriaVAGAO) then
    Exit;

  LQry := fCriaQuery;

  try
    LQry.Close;
    LQry.SQL.Clear;
    LQry.SQL.Text :=
      ' SELECT COUNT(1) QTD ' +
      ' FROM FATDOR D ' +
      ' INNER JOIN LOTDOR L ON D.AUTOINCREM = L.LDO_SEQFDO ' +
      ' WHERE D.FDO_NUMDOC = :NUMDOC ' +
      '   AND D.FDO_ESPDOC = :ESPDOC ' +
      '   AND D.FDO_CODEMP = :CODEMP ';
    LQry.ParamByName('NUMDOC').AsString := ANumDoc;
    LQry.ParamByName('ESPDOC').AsString := AEspDoc;
    LQry.ParamByName('CODEMP').AsString := ACodEmp;
    LQry.Open;

    Result := LQry.FieldByName('QTD').AsInteger > 0;
  finally
    FreeAndNil(LQry);
  end;
end;

