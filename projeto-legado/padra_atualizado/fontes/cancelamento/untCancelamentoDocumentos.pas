    begin
      If Assigned(lstCtrBaixadas) Then
        FreeAndNil(lstCtrBaixadas);

      If ((strEspSel <> 'ND') and (strEspSel <> 'DL')) Then
      Begin
        lstCtrBaixadas := fVerificarCadRecBaixado(strNumDocSel, strEspSel, IIF(strEspSel = 'CT', strClienteCTe, strCliForSel), VS_strCodEmp);

        If (lstCtrBaixadas.Count = 0) And
           ((pos(strEspSel,'NF_G2_') > 0) And (fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF'))) And
           (fEhDevolucaoDeColetaPorGarantia(IIF(strEspSel='G2', 'NF', strEspSel), strNumDocSel, strCliForSel, edtSerie.Text,
                                            strCreditoNumDup, strCreditoEspDoc, strCreditoCodEmp, strCreditoCodCli,
                                            blnTemCreditoDeColetaPorGarantia )) Then
        Begin
          If blnTemCreditoDeColetaPorGarantia Then
            lstCtrBaixadas := fVerificarCadRecBaixado(strCreditoNumDup, strCreditoEspDoc,strCreditoCodCli, strCreditoCodEmp);
        End;

        FUtilizaContabilidadeERecebidoPorAdiantamento := False;
        If lstCtrBaixadas.Count > 0 Then
        Begin
          FUtilizaContabilidadeERecebidoPorAdiantamento := untCadRec.UtilizaContabilidadeERecebidoPorAdiantamento(LNumeroPedidoAdiantamento,
                                                                                                                  strNumDocSel,
                                                                                                                  strEspSel,
                                                                                                                  VS_strCodEmp,
                                                                                                                  strCliForSel);

          If FUtilizaContabilidadeERecebidoPorAdiantamento Then
            FUtilizaContabilidadeERecebidoPorAdiantamento := fMensagem('ATENÇÃO',
                                                                       'Este documento está recebido e é proveniente de adiantamento do pedido ' +
                                                                         LNumeroPedidoAdiantamento + '.' + #13 +
                                                                         'Se continuar com o cancelamento, será feito o estorno e a exclusão do título.' + #13 +
                                                                         'Deseja continuar?',
                                                                       ['&Sim', '&Não'], 2) = 1;
        End;
      End
      Else
        lstCtrBaixadas := fVerificarCadRecBaixado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, Vs_strCodEmp);
    end;

    procedure SetaListaDeCtrPixAtivo;
    Begin
      If Assigned(FCtrPixGerado) Then
        FreeAndNil(FCtrPixGerado);

      FCtrPixGerado := VerificarCadRecAbertoPix(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, Vs_strCodEmp);
    End;

    procedure pMensagemDocumentosVinculados(strMensagem : string);
    var
      arrMensagem: TStringArray;
      i : integer;
    begin
      strMensagemCancelamento := '';
      SetLength(arrMensagem, 0);

      pAddDados(arrMensagem, '---------------------------------------------');
      pAddDados(arrMensagem, '| Documento         |  Espécie  |  Empresa  |');
      pAddDados(arrMensagem, '---------------------------------------------');

      for i := 0 to High(arrDadosDocumentos) do
      begin
        pAddDados(arrMensagem, '| ' + fPadR(arrDadosDocumentos[i].strNumeroDocumento  , 18, ' ') + '|' +
                               fPadC(arrDadosDocumentos[i].strEspecieDocumento        , 11, ' ') + '|' +
                               fPadC(arrDadosDocumentos[i].strCodigoEmpresa           , 11, ' ') + '|');

      end;

      If CancelandoNFViaFulFillment Then
        objFulFillmentLogBuilder.pSalvarLog(strMensagem + sLineBreak + arrMensagem.ToString(sLineBreak), True)
      Else
        fMensagemTabela('ATENÇÃO!',
                        'Documentos',
                        arrMensagem,
                        strMensagem,
                        ['&Ok'],
                        1,
                        False,
                        1,
                        0,
                        False,
                        0,
                        False,
                        False,
                        False,
                        500,
                        60);
    end;

    function fDeveGerarReservaEstoqueEnderecamentoPedidoOriginal: Boolean;
    begin
      Result := False;

      If Not blnSolicitouQueDesejaCancelarPedidoOriginal Then
        Exit;

      If Not fEspeciesQuePodemSerProvenientesFataurmentoORPD(strEspSel) Then
        Exit;

      If Not fUsaEnderecamento Then
        Exit;

      If Not fCfgSis('CANEND', varBoolean) Then
        Exit;

      Result := True;
    end;

    function fRetornaEspecie():String;
    begin
      Result := strEspSel;

      If (arrEspecies[intIndiceEsp][0] = 'NC') Then
        Exit('NF');

      If (arrEspecies[intIndiceEsp][0] = 'DC') Then
        Exit('NF');
    end;

begin
  strDocumentoJaConstaComoCanceladoNaSefaz := '';
  blnEhCancelamentoX929 := False;
  blnCancelandoPendencia := False;
  blnGerouEnderecamentoPDOri := False;
  FAtualizouEstoqueLote := False;
  blnPermitiuCancelarComChaveAcessoDuplicada := False;

  pVerificaSeEstaCancelandoPendencia(blnCancelandoPendencia);

  objCancTransfPedComMltLj := nil;
  blnDocGarantiaPropriaEmpresa := False;
  strTmpDoc := '';
  strTmpEsp := '';
  strTmpEmp := '';
  strCodPrj := '';
  strEmpCliCTe := '';
  strClienteCTe := '';
  strFornecedorCTe := '';
  strImportouCTe := '';
  strChaveDeAcessoCTe := '';
  strMensagemDeErro := '';

  strCodPro := '';

  strCliFat := '';

  blnNotaImportacao := False;
  blnEhNFDevolucaoClientesPorOutrasEntradas := False;
  blnEhNFDevolucao := False;

  lstCtpGnrBaixa.Clear;
  lstCtpCFrBaixa.Clear;
  lstCtpAntBaixa.Clear;
  lstCodIteDelet.Clear;

  blnLimpouUltimaCompra := False;
  LblnPedidoProvenienteDeOrcamento := False;
  LblnCancelarOrcamentoOriginalPedido := False;

  FUtilizaContabilidadeERecebidoPorAdiantamento := False;

  FAuditFaturamento.Limpar;

  FCancelarCTeViaBanco := False;

  FEhNotaEspecialFator := False;
  FDocOrigem.strNumDoc := EmptyStr;

  blnResult := False;
  Try
    qryAux001 := fCriaQuery;

    blnCancNFeOK := False;

    blnNotaEletronica := False;

    pGetEspecieCancelamento(strEspSel, strEspCan, blnNotaEletronica);

    if CancelandoNFViaFulFillment then
      blnNotaEletronica := False;

    strEspecieNFe := fAcertaEspecieNfe(strEspSel);

    strNumDocSel := edtNumDoc.Text;
    strCliForSel := edtCliFor.Text;
    strSerieSel  := edtSerie.Text;

    FstrEspecieSelecionada   := strEspSel;
    FstrDocumentoSelecionado := edtNumDoc.Text;
    FstrSerieSelecionada     := edtSerie.Text;
    FstrClienteSelecionado   := edtCliFor.Text;

    blnCancelandoNotaDeImportacao := fEhNotaDeImportacao(strNumDocSel, strSerieSel, strCliForSel);

    FblnCancelamentoAgrupamentoPedido := False;
    If (Pos(strEspSel, 'PD_') > 0) And (fCfgSis('F11PGR', varBoolean)) Then
    Begin
      If (fCampoTabela('FGO_ORIGEM', 'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'],
                                               [strNumDocSel, strEspSel, VS_strCodEmp]) = 'AGRUPAMENTO') Then
      Begin
        FblnCancelamentoAgrupamentoPedido := True;
      End;
    End;

    If (Not fPodeCancelarCashbackGeradoVenda(strNumDocSel, strEspSel, VS_strCodEmp)) Then
    Begin
      btnCancelar.Click;
      Exit;
    End;

    If (strEspSel = 'TA') And (fCfgSis('UTIWMS', VarString, VS_strCodEmp) = 'S')  Then
    Begin
      fMensagemCancelamento('ATENÇÃO!', 'A "T.A." "Transferência de estoque entra armazéns", ' +
        'não pode ser cancelado nesta opção. ' +
        'caso precise voltar a nota de entrada, deve ser feito uma nota de devolução ' +
        'ou gerar uma nova transferencia entre localizações', ['&Ok']);
      btnCancelar.Click;
      Exit;
    End;

    if ((strEspSel = 'PD') and fUsaRotinaWMS and fUsaOndaSeparacaoAgrupamento) then
    begin
      fMensagemCancelamento('', 'Essa empresa está utilizando WMS e Remessa(s) de Pedido/Separação. Para cancelar um '+
                  'pedido de venda, é necessário acessar a rotina "Baixar Pedido que não será entregue".');
      btnCancelar.Click;
      Exit;
    end;

    If fPedidoPossuiItensEmSemparacao(strEspSel, strNumDocSel, strCliForSel) Then
    Begin
      fMensagemCancelamento('ATENÇÃO!', 'Pedido está em separação, para efetuar o cancelamento é necessário solicitar para o separador "Limpar a Separação"', ['&Ok']);
      btnCancelar.Click;
      Exit;
    End;

    If fExisteRemessaDevolucaoVinculada(strNumDocSel, strEspSel) Then
    Begin
      btnCancelar.Click;
      Exit;
    End;

    objPedidoAlpe.pCarregaPedidoAlpe(strNumDocSel, strEspSel, VS_strCodEmp);
    if (objPedidoAlpe.strTipRec = 'ALPEF') or
       (objPedidoAlpe.strTipRec = 'ALPEP') or
       (objPedidoAlpe.strTipRec = 'ALPEFP') then
    begin
      fMensagemCancelamento('ATENÇÃO!', 'Não é permitido o cancelamento de um documento ALPE já faturado! Por favor, entre em contato com o backoffice da Alpe.', ['&Ok']);
      btnCancelar.Click;
      Exit;
    end;

    strNumOco    := fCampoTabela('GER_CODOCO', 'ADEGER', ['GER_DOCDEV', 'GER_ESPDEV', 'GER_EMPDEV'], [strNumDocSel, strEspSel, VS_strCodEmp]);

    If (Pos(strEspSel, 'NE_NI_GR_GF_NG_NR_') > 0) Then
      strTipFc  := 'CODFOR'
    Else
    Begin

      If (Pos(strEspSel, 'EL_NC_IC_OF_NP_EF_DC_') > 0) Then
      Begin

        If edtTipPes.Text = 'C' Then
          strTipFc := 'CODCLI'
        Else
          strTipFc := 'CODFOR';

      End
      Else
        strTipFc := 'CODCLI';

    End;

    If (Not fPemiteCancelarDocumentoComEntregaLalaMove(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel, IIF(strTipFc = 'CODFOR', 'F', 'C'))) Then
      Exit;

    strSerFsc := fSerieFiscal(strEspSel);

    pValidarStatusDoDocumentoFiscal(blnNotaEletronica, strEspecieNFe, strEspCan, strTipFc, strMensagemAux, strEspSel);
    If (Not fEmptyStr(strMensagemAux)) Then
      SetTexto(strMensagemAux);

    //RETORNO FORNECEDOR
    If (strEspSel = 'NG') And (fDocumentoGarantiaRetornoDoFornecedor('', strNumDocSel, strCliForSel, edtSerie.Text)) Then
    Begin
      fMensagemCancelamento('Atenção!', 'Documento de Garantia "Retorno do Fornecedor", não pode ser cancelado nesta opção.', ['&Ok']);
      btnCancelar.Click;
      Exit;
    End;

    //Verifica se o documento é um envio para o fornecedor e se a oção selecionada esta correta
    If (strEspSel = 'NR') And (fDocumentoGarantiaEnvioParaFornecedor('NF', strNumDocSel, strCliForSel, edtSerie.Text)) Then
    Begin
      fMensagemCancelamento('Atenção!', 'Documento de Garantia "Envio para o Fornecedor", não pode ser cancelado nesta opção.', ['&Ok']);
      btnCancelar.Click;
      Exit;
    End;

    If (strEspSel = 'NR') And (fRetDocOri(blnAchouRegistroOriDoc, strNumDocSel, 'F', strSerieSel, VS_strCodEmp, strCliForSel) <> 'G') Then
    Begin
      fMensagemCancelamento('Atenção!', 'Este documento não é referente a Nota de Garantia (Retorno de Fornecedor)!', ['&Ok']);
      btnCancelar.Click;
      Exit;
    End;

    If strEspSel = 'NE' Then
    Begin
      If(Pos(strEspSel, 'NE') > 0) And ((fCfgSis('UDEVME') = 'S') Or (fCfgSis('COFEND') = 'S')) then
        If TGestorReservaDevolucao.TemDevolucaoRealizada(fRetAutIncMovGer(strNumDocSel, 'NF', strCliForSel, strSerieSel)) then
        Begin
          fMensagem('Atenção!', 'Este documento teve devolução, é preciso cancelar o documento de devolução primeiro!', ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;
    End;

    If strEspSel = 'NP' Then
    Begin
      strEspSel  := 'NF';
      If fDocumentoGarantiaEnvioParaFornecedor(strEspSel, strNumDocSel, strCliForSel, edtSerie.Text) Then
      Begin
        fMensagemCancelamento('Atenção!', 'Documento de Garantia "Envio para o Fornecedor", não pode ser cancelado por "NP - Nota Especial".', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;
      If (edtTipPes.Text = 'F') And (fDocumentoOutrasSaidasFornecedor(strEspSel, strNumDocSel, strCliForSel, edtSerie.Text)) Then
      Begin
        fMensagemCancelamento('Atenção!', 'Documento de Outras Saidas, não pode ser cancelado por "NP - Nota Especial".', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;
      If (Not fDocumentoFiscalExiste(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel, IIF(strTipFc = 'CODFOR', 'F', 'C'), IIF(edtSerie.Visible, edtSerie.Text, strSerFsc), 'V')) Then
      Begin
        fMensagemCancelamento('Atenção!', 'Documento (Nota Especial) não encontrado no livro fiscal!', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;
    End;

    If fCfgSis('UTI_RE', varBoolean) And (fCfgSis('EMPRES') = VS_strCodEmp) Then
    Begin
      If fEhDocumentoDeDevolucao(strNumDocSel, strEspSel, strTipFc, strCliForSel) Then
      Begin
        fMensagemCancelamento('Atenção!', 'Não é permitido efetuar o cancelamento de devoluções de empresas do Regime Especial (CFG_UTI_RE) '+
                              'porque o processo de devolução gera transferências automáticas.'+ sLineBreak +
                              'Se a devolução foi emitida incorretamente, verifique onde foi realizada a entrada do estoque e '+
                              'faça a transferência entre as lojas.', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;
      If fEhDocumentoDeVenda(strNumDocSel, strEspSel, strTipFc, strCliForSel) Then
      Begin
        fMensagemCancelamento('Atenção!', 'Não é permitido efetuar o cancelamento de vendas de empresas do Regime Especial (CFG_UTI_RE). '+
                              'Neste caso, é obrigatório fazer a devolução estando fisicamente e logado na empresa.', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;
    End;

    If (fCfgSis('CDTCLV', varBoolean)) Then
    Begin
      If (Not fPermiteCancelarDocumentoVinculadoComodatoCilindroVasilhame(
              strNumDocSel, strEspSel, strCliForSel)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;
    End;

    If (strEspSel = 'PD') Then
    Begin
      strAutIncSel := fCampoTabela('AUTOINCREM', 'FATGOR', ['FGO_NUMDOC', 'FGO_CODEMP', 'FGO_ESPDOC'], [strNumDocSel, VS_strCodEmp, strEspSel]);
      If (Not fVerificaAcessoSistema('CANPDA')) And (fPedidoExpedido(strAutIncSel)) Then
      Begin
        fMensagemCancelamento('Atenção!', 'Pedido expedido, para efetuar o cancelamento é necessário cancelar a expedição.', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;
    End;

    {CR - Retorno de consignação, solicita a série do documento}
    If fCR_Fechou_Em_NF(strNumDocSel, strCliForSel, strDtaEnt, strDtaDoc) Then
    Begin

      if (not FblnCancelandoRetornoConsignadoAutomatico) And (Not FblnAbastecimentoPeloDeposito) then
      Begin
        If (Not fSuportaInterfaceGrafica) Then
        Begin
          pMensagemOK('CR fechou em NF - tem que solicitar os dados da consignação retorno');
          btnCancelar.Click;
          Exit;
        End;

        Try

          pCriarFormularios(TfrmFatDigDadosConsignacao, frmFatDigDadosConsignacao);

          Try

            frmFatDigDadosConsignacao.edtNumDoc.Enabled := False;
            frmFatDigDadosConsignacao.edtEspDoc.Enabled := False;
            frmFatDigDadosConsignacao.mskDtaEnt.Enabled := False;
            frmFatDigDadosConsignacao.mskDtaDoc.Enabled := False;

            frmFatDigDadosConsignacao.edtNumDoc.Text := strNumDocSel;
            frmFatDigDadosConsignacao.edtEspDoc.Text := 'NF';
            frmFatDigDadosConsignacao.mskDtaEnt.Text := strDtaEnt;
            frmFatDigDadosConsignacao.mskDtaDoc.Text := strDtaDoc;

            frmFatDigDadosConsignacao.OnShow := Nil;
            frmFatDigDadosConsignacao.showModal;

            If (frmFatDigDadosConsignacao.ModalResult = mrOk) then
              If Not fEmptyStr(frmFatDigDadosConsignacao.edtSerie.Text) Then
                strSerFsc := frmFatDigDadosConsignacao.edtSerie.Text;

            {"C" = Consignação}
            If chkInutilizacao.Checked Then
              If fCampoTabela('GER_ORIDOC','MOVGER',['GER_NUMDOC', 'GER_ESPDOC', 'GER_CODEMP', 'GER_CODCLI',  'GER_SERIE_'],
                                                    [strNumDocSel, 'NF',         VS_strCodEmp,  strCliForSel, strSerFsc]) = 'C' Then
                chkInutilizacao.Checked := False;

          Finally
            pFreeAndNil(frmFatDigDadosConsignacao);
          End;

        Except
          On E: Exception Do
          Begin
            pMensagensErro(E.Message, '');
            btnCancelar.Click;
            Exit;
          End;
        End;
      End;
    End;
    {********************************************************}
    {* CASO ESTEJA USANDO NOTA ELETRONICA E PAINEL NFE, IRÁ *}
    {* VERIFICAR SE O DOCUMENTO ESTÁ COMO PENDENTE NO PAINEL*}
    {*****************************************************MV*}
    If (fDocumentoPendenteNoPainelNFe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'))) Then
    Begin
      btnCancelar.Click;
      Exit;
    End;

    If (strEspSel = 'RM') Then
    Begin
      If (fCfgSis('OPCROM', varString) = '1') And
         (fCfgSis('TIPEXP', varString) = '5') And
         (not (fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean))) And
         (fTemPedidoFaturadoNoRomaneio(strNumDocSel)) Then
      Begin
        fMensagemCancelamento('', 'Existem pedidos faturados nesse romaneio, é necessário cancelar os faturamentos e depois cancelar o romaneio!');
        btnCancelar.Click;
        Exit;
      End
      Else If (fRomaneioBaixado(strNumDocSel)) Then
      Begin
        fMensagemCancelamento('', 'Esse romaneio já está baixado. É necessário cancelar as baixas antes de excluí-lo!');
        btnCancelar.Click;
        Exit;
      End
      Else If (TRomaneioRepository.fRomaneioVinculadoComDespesa(strNumDocSel, '', '', Smensagem)) Then
      Begin
        fMensagemCancelamento('', Smensagem);
        btnCancelar.Click;
        Exit;
      End
      Else If (fUsaPLPPorRomaneio) Then
      Begin
        If (fRomaneioTemPLPEnviada(strNumDocSel)) Then
        Begin
          fMensagemCancelamento('', 'Não é possível cancelar o romaneio, pois ele possui pré-listas de postagem já transmitidas aos Correios!');
          btnCancelar.Click;
          Exit;
        End
        Else If (fRomaneioTemPLPEmAberto(strNumDocSel)) Then
        Begin
          fMensagemCancelamento('', 'Não é possível cancelar o romaneio, pois ele possui pré-listas de postagem dos Correios em aberto, para cancelar, remova os documentos do romaneio!');
          btnCancelar.Click;
          Exit;
        End
      End;
      If (Not fTravouRomaneio(strNumDocSel)) Then
        Exit;
    End;

    if not TValidaOrigemFaturamento.DocumentoPermiteCancelamento(strNumDocSel, arrEspecies[intIndiceEsp][0], VS_strCodEmp) then
    begin
      btnCancelar.Click;
      Exit;
    end;

    If (Pos(arrEspecies[intIndiceEsp][0], 'PD_OR_') > 0) Then
    Begin
      If not TYapayFacade.fPedidoPodeSerCancelado(strNumDocSel, arrEspecies[intIndiceEsp][0], VS_strCodEmp, strRetornoErro) then
      begin
        objLiberacao.Clear;
        objLiberacao.strDirAce    := 'CANYAP';
        objLiberacao.strCodOpe    := strLoginUsuarioLogado;
        objLiberacao.objMsgLibera.pAddTexto('O documento possui cobrança YAPAY com status local ativo, porém houve um motivo de desistência do mesmo.');
        objLiberacao.pInformaNumDocEspDocCodEmp(strNumDocSel, strEspSel, VS_strCodEmp);

        blnCancelaDocumentoCobrancaYapay := objLiberacao.fLibera;

        if not blnCancelaDocumentoCobrancaYapay then
        begin
          btnCancelar.Click;
          Exit;
        end
      end;

      if (Pos(arrEspecies[intIndiceEsp][0], 'PD') > 0) and
         (TFacadeCobrancaEletronica.fExisteCobrancaEletronica(
                   strNumDocSel, arrEspecies[intIndiceEsp][0],
                   VS_strCodEmp, tcPagarMe)) then
      begin
        If Not fLiberaCancelamentoDocumentoComCobrancaEletronica(strNumDocSel, arrEspecies[intIndiceEsp][0], VS_strCodEmp) Then
        begin
          btnCancelar.Click;
          Exit;
        end
      end;

      if MatchStr(TPixDao.RetornaStatusSePedidoPossuirPix(strNumDocSel, arrEspecies[intIndiceEsp][0], VS_strCodEmp), STATUS_PIX_ATIVO) Then
      begin
        If arrEspecies[intIndiceEsp][0] = 'PD' Then
        Begin
          fMensagemCancelamento('PIX',
                    'Pedido ' +
                    strNumDocSel + '-' +
                    arrEspecies[intIndiceEsp][0] + '-' +
                    VS_strCodEmp +
                    ' possuí cobrança Pix ativa!' + #13 +
                    'Para cancelar o documento, é necessário remover o Pix do pedido.',
                    ['&OK']);

          btnCancelar.Click;
          Exit;
        End;
      end;

      If (arrEspecies[intIndiceEsp][0] = 'PD') and (fPedidoEntradaMercadoria(strNumDocSel)) then
      Begin
        fMensagemCancelamento('', 'Pedido não pode ser cancelado pois é oriundo de reserva de estoque de entrada de mercadorias e será baixado no ato do endereçamento do produto.');
        btnCancelar.Click;
        Exit;
      End
      Else begin
        blnDocGarantiaPropriaEmpresa := TGarantiaPropriaEmpresaCancelamento.fEhPedidoReposicaoGarantia(strNumDocSel, arrEspecies[intIndiceEsp][0], VS_strCodEmp);
        if Not blnDocGarantiaPropriaEmpresa  then
        begin
          If Not fVerificaPermiteCancelarDocumentoCRM(strNumDocSel,
                                                      arrEspecies[intIndiceEsp][0],
                                                      strCliForSel,
                                                      VS_strCodEmp,'') Then
          Begin
            fMensagemCancelamento('', 'Documento foi criado pelo CRM. Para cancelá-lo, deve-se utilizar o CRM, clicando '+
                        'com o botão direito do mouse na ocorrência e em seguida na opção [BAIXAR (NÃO SERÁ ENTREGUE) ALT+F9]!"');
            btnCancelar.Click;
            Exit;
          End;
        end;
      end;
    End;

    Try
      If (MatchStr(strEspSel, ['NF','FF'])) Then
      Begin
        If fExisteDocumentoRemessaContaOrdemNaoCancelado(strNumDocSel,
             strEspSel) Then
        Begin
          fMensagemCancelamento('ATENÇÃO', 'Existe um documento de Remessa por Conta e Ordem '
                              + 'vinculado a este documento. Cancele primeiramente '
                              + 'o documento de Remessa por Conta e Ordem.' , ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;
      End;

      If (MatchStr(strEspSel, ['FF', 'NF'])) Then
      Begin
        If fVerificaDocumentoFator(VS_strCodEmp, strEspSel, strNumDocSel, FDocOrigem) Then
        Begin
          fMensagemCancelamento('ATENÇÃO', 'A FF informada teve origem de um faturamento por fator. ' +
                                ' Cancele primeiro o documento de origem: ' + FDocOrigem.strDocOri , ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;

        If fEnNotaEspecialDocumentoFator(VS_strCodEmp, strEspSel, strNumDocSel, strCliForSel, fRetSerFsc, FDocOrigem) Then
        Begin
          FEhNotaEspecialFator := True;

          If (fMensagem('', 'A NF informada teve origem de um faturamento por fator. ' +
                            'Serão cancelados todos os documentos envolvidos: ' +
                             strNumDocSel +'-'+strEspSel +', ' + FDocOrigem.strDocOri + '. ' +
                             'Deseja continuar?', ['&Sim', '&Não']) = 2) Then
          Begin
            btnCancelar.Click;
            Exit;
          End;
        End;
      End;

      If (Pos(strEspSel, 'NE_') > 0) Then
      Begin
        strDocOri := fRetDocOri(blnAchouRegistroOriDoc, strNumDocSel, 'F', strSerieSel, VS_strCodEmp, strCliForSel, blnPedidoEntrada, IIF(Not blnPedidoEntrada, 'NF', 'PD'));

        If strDocOri = 'G' Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Nota Fiscal Referente a Recebimento de Garantia de Fornecedor, Utilize a Opção "NR - Nota de Garantia (Retorno de Fornecedor)"!', ['&O k']);
          Exit;
        End
        Else If strDocOri = 'D' Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Nota Fiscal Referente a Devolução, Utilize a Opção "ND - Nota de Entrada - Devolução"!', ['&O k']);
          Exit;
        End;

        If Not TDefineBaixaPedido.fLiberaPreparacaoTECancelamento(strNumDocSel, strSerieSel, VS_strCodEmp, strCliForSel, IIF(Not blnPedidoEntrada, 'NF', 'PD')) Then
          Exit;

        objCancTransfPedComMltLj := TCancelaTransferenciaPedidoCompraMultiLoja.fCarregaDocumentoCancelamento(strNumDocSel,
                                                                                                             IIF(Not blnPedidoEntrada, 'NF', 'PD'),
                                                                                                             edtSerie.Text,
                                                                                                             strCliForSel,
                                                                                                             VS_StrCodEmp);
        If objCancTransfPedComMltLj.fTemDocumentoDeTransferenciaFaturado Then
        Begin
          btnCancelar.Click;
          Exit;
        End;

        //Verifica se Existe Agendamento de Recebimento e seu status.
        If fUsaRotinaWMS and fConferenciaDepoisDaEntrada Then
        Begin
          qryAgeRec := fCriaQuery;
          Try
            With qryAgeRec, SQL Do
            Begin
              Close;
              Clear;

              Add(' SELECT ADC_SEQGER, ARC_STATUS, ARC_IDEDIG          ');
              Add(' FROM AGEDOC                                        ');
              Add('   INNER JOIN AGEREC A ON A.AUTOINCREM = ADC_SEQGER ');
              Add(' WHERE ADC_CODEMP = :CODEMP                         ');
              Add('   AND ADC_CODFOR = :CODFOR                         ');
              Add('   AND ADC_ESPDOC = :ESPDOC                         ');
              Add('   AND ADC_NUMDOC = :NUMDOC                         ');
              Add('   AND ADC_SERIE_ = :SERIE_                         ');

              ParamByName('CODEMP').AsString := VS_strCodEmp;
              ParamByName('CODFOR').AsString := strCliForSel;
              ParamByName('ESPDOC').AsString := IfThen(blnPedidoEntrada, 'PD', 'NF');
              ParamByName('NUMDOC').AsString := strNumDocSel;
              ParamByName('SERIE_').AsString := strSerieSel;

              Open;

              strSeqGer := FieldByName('ADC_SEQGER').AsString;
              strStaAge := FieldByName('ARC_STATUS').AsString;
              strIdeDigPlano := FieldByName('ARC_IDEDIG').AsString;
              intQtdAgeDoc := fCampoTabela('COUNT(0)', 'AGEDOC', ['ADC_SEQGER'], [strSeqGer]);

              Close;
              Clear;
              Add('SELECT                                 ');
              Add('  SUM(IFNULL(AIT_QTDEND,0)) AS QTDEND, ');
              Add('  SUM(IFNULL(AIT_QTDDEV,0)) AS QTDDEV  ');
              Add('FROM                                   ');
              Add('  AGEITE                               ');
              Add('WHERE AIT_SEQGER = :SEQGER             ');
              ParamByName('SEQGER').AsString := strSeqGer;
              Open;

              If (fieldByName('QTDEND').AsInteger > 0) And
                 (fCfgSis('CNFEND', varBoolean)) Then
              Begin
                if (fMensagem('Confirma?', 'Essa nota fiscal esta em um plano de recebimento onde o endereçamento já está em andamento.' +
                   ' Deseja cancelar a nota de entrada e endereçamentos já realizados? ', ['&Sim', '&Não']) = 2) then
                  Exit;
              End;

              If (fieldByName('QTDEND').AsInteger > 0) And
                 (Not fCfgSis('CNFEND', varBoolean)) Then
              Begin
                fMensagemCancelamento('','Essa nota fiscal está em um plano de recebimento onde o endereçamento já está em andamento e não pode ser cancelada!', ['&OK']);
                Exit;
              End
              Else If fieldByName('QTDDEV').AsInteger > 0 Then
              Begin
                fMensagemCancelamento('','Essa nota fiscal está em um plano de recebimento que possui itens devolvidos ao fornecedor e não pode ser cancelada!', ['&OK']);
                Exit;
              End
              Else if not fEmptyStr(strSeqGer) And ( Pos(strStaAge, 'CN_EP') > 0 ) Then
              Begin
                If intQtdAgeDoc = 1 Then
                Begin
                  if fMensagem('', 'O Plano de Recebimento deste documento sera Excluído pois só existe o documento que está sendo cancelado, Deseja continuar?', ['&Sim', '&Não'], 2) = 2 Then
                    Exit;
                End
                Else If fMensagem('', 'O Documento a cancelar já está ' +  IfThen(strStaAge = 'CN', 'conferido', 'planejado') +
                                      ', ao cancelar o sistema irá redistribuir as quantidades conferidas e planejadas dos documentos restantes ' +
                                      ' do plano de recebimento "Sequêncial de Conf.: ' + strIdeDigPlano + '" , Deseja continuar?', ['&Sim', '&Não'], 2) = 2 Then
                  Exit;
              End;

            End;
          Finally
            FreeAndNil(qryAgeRec);
          End;
        End;

        If (fCfgSis('OUSAFO', varString) = '2') And (Pos(arrEspecies[intIndiceEsp][0], 'NE_') > 0) Then
        Begin
           {Verificar se existe algum espelho emitido que ainda não foi confirmado para nota de entrada, }
           { isto é, existe uma devolução para a nota que está tentando cancelar e ainda não foi efetivada (espelho confirmado) }

          qryEspGerNe := fCriaQuery;
          try
            qryEspGerNe.SQL.Clear;
            qryEspGerNe.SQL.Add(' SELECT                                                 ');
            qryEspGerNe.SQL.Add('   GROUP_CONCAT(DISTINCT(GER_NUMESP)) AS ESPELHOS       ');
            qryEspGerNe.SQL.Add(' FROM ESPDET E                                          ');
            qryEspGerNe.SQL.Add('  INNER JOIN ESPGER G ON E.DET_SEQGER = G.AUTOINCREM    ');
            qryEspGerNe.SQL.Add('  INNER JOIN MOVDET D ON E.DET_SEQDET = D.AUTOINCREM    ');
            qryEspGerNe.SQL.Add(' WHERE D.DET_NUMDOC = :NUMDOC                           ');
            qryEspGerNe.SQL.Add('   AND D.DET_ESPDOC = :ESPDOC                           ');
            qryEspGerNe.SQL.Add('   AND D.DET_CODEMP = :CODEMP                           ');
            qryEspGerNe.SQL.Add('   AND D.DET_SERIE_ = :SERIE_                           ');
            qryEspGerNe.SQL.Add('   AND D.DET_CODFOR = :CODFOR                           ');
            qryEspGerNe.SQL.Add('   AND D.DET_TIP_FC = "F"                               ');
            qryEspGerNe.SQL.Add('   AND G.GER_MOVGER IS NULL                             ');
            qryEspGerNe.SQL.Add(' GROUP BY D.DET_NUMDOC                                  ');

            qryEspGerNe.ParamByName('NUMDOC').AsString := strNumDocSel;
            qryEspGerNe.ParamByName('ESPDOC').AsString := IfThen(blnPedidoEntrada, 'PD', 'NF');
            qryEspGerNe.ParamByName('CODEMP').AsString := VS_strCodEmp;
            qryEspGerNe.ParamByName('SERIE_').AsString := strSerieSel;
            qryEspGerNe.ParamByName('CODFOR').AsString := strCliForSel;

            qryEspGerNe.Close;
            qryEspGerNe.Open;

            If (Not qryEspGerNe.isEmpty) Then
            Begin
              fMensagemCancelamento('','Existe(m) o(s) espelho(s): '+ qryEspGerNe.FieldByName('ESPELHOS').asString + #13#10 +
                           'Emitido(s) para essa nota de entrada!' + #13#10 +
                           'Para cancelar essa nota de entrada, será necessário realizar a exclusão desse(s) espelho(s)' + #13#10 +
                           'Para realizar a exclusão desse(s) espelho(s), utilizar a rotina: '  + #13#10 +
                           ' > Principal > Faturamento > Efetivação de Outras Saídas / Garantia Envio para Fornecedor ', ['&OK'],
                           0, 600, 1);
              Exit;
            End;
          finally
            FreeAndNil(qryEspGerNe);
          end;

        End;


      End;

      blnNotaServicoOriundaConfirmacaoPedido := (strEspSel = 'NS') And (fRetOpcDocTrue(strNumDocSel, 'NS', VS_strCodEmp, strCliForSel, edtTipPes.Text) = 'CP');

      If (Pos(strEspSel, 'EF_') > 0) Then
      Begin
        If (fRetOpcDocTrue(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, edtTipPes.Text,
                      ifthen(edtSerie.visible, edtSerie.text,'')) <> 'FE') Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', strNumDocSel+'-NF não é um documento emitido por "Outras Entradas de Fornecedores" utilize a opção "EF - Nota de Outras Entradas de Fornecedores"!', ['&O k']);
          Exit;
        End
        else
        begin
          if Not TCancelamentoBaixaEnvio.fEstornarBaixaEnvioConserto(strNumDocSel, strEspSel, VS_strCodEmp, True) then
            Exit;
        end;
      End
      Else
      Begin
        If (fRetOpcDocTrue(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, edtTipPes.Text) = 'FE') Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Utilize a opção "EF - Nota de Outras Entradas de Fornecedores" para cancelamento deste documento!', ['&O k']);
          Exit;
        End;
      End;

      If (Pos(strEspSel, 'OF_') > 0) Then
      Begin
        If (edtTipPes.Text = 'C') and (fCadRecExiste(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel)) then
        begin
          fMensagemCancelamento('ATENÇÃO!', strNumDocSel+'-NF possui contas a receber e portanto deve ser cancelada na opção "NF - Nota Fiscal"!', ['&OK']);
          Exit;
        end;
        If (edtTipPes.Text = 'F') And (Pos(fRetOpcDocTrue(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, edtTipPes.Text, '', True), 'NE_') > 0) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', strNumDocSel+'-NF não é um documento emitido por "Outras Saídas" utilize a opção "NP - Nota Especial (Fornecedor)"!', ['&OK']);
          Exit;
        End
        Else If (Pos(fRetOpcDocTrue(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, edtTipPes.Text), 'OE_DV_') > 0) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', strNumDocSel+'-NF não é um documento emitido por "Outras Saídas" utilize a opção "NF - Nota Fiscal"!', ['&O k']);
          Exit;
        End
        Else If (fRetOpcDocTrue(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, edtTipPes.Text) = 'NG') Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', strNumDocSel+'-NF não é um documento emitido por "Outras Saídas" utilize a opção "NG - Nota de Garantia (Envio p/ Fornecedor)"!', ['&O k']);
          Exit;
        End
        Else If (fRetOpcDocTrue(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, edtTipPes.Text) = 'EM') Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', strNumDocSel+'-NF não é um documento emitido por "Outras Saídas" utilize a opção "NE - NOTA DE ENTRADA"!', ['&O k']);
          Exit;
        End;
      End;

      If (Pos(strEspSel, 'ND_') > 0) Then
      Begin
        strDocOri := fRetDocOri(blnAchouRegistroOriDoc, strNumDocSel, IIF(edtTipPes.Text='','F',edtTipPes.Text), strSerieSel, VS_strCodEmp, strCliForSel, blnPedidoEntrada, IIF(Not blnPedidoEntrada, 'NF', 'PD'));

        If (strDocOri <> 'D') And (Not blnConEqu) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Este documento não é referente a Nota de Entrada - Devolução!', ['&O k']);
          Exit;
        End

          Else If blnConEqu And (Not fVerificaDocConcertoEquipamento(strNumDocSel, IIF(edtTipPes.Text='','F',edtTipPes.Text), strSerieSel, VS_strCodEmp, strCliForSel, blnPedidoEntrada, IIF(Not blnPedidoEntrada, 'NF', 'PD')) )Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Este documento não é referente a Nota de Entrada - Conserto de Equipamento!', ['&O k']);
          Exit;
        End
      End;

      (* nao precisa valida mais, apos a alteraçao do REFENT onde o retorno do for eh feito pela entrada de mercadorias
        podese cancelar por aqui ou pelo tipo NE - nota de entrada que toda a garantia eh validado
      If (Pos(strEspSel, 'NR_') > 0) Then
      Begin
        strDocOri := fRetDocOri(strNumDocSel, 'F', strSerieSel, VS_strCodEmp, strCliForSel);

        If strDocOri <> 'G' Then
        Begin
          fMensagem('ATENÇÃO!', 'Este documento não é referente a Nota de Garantia (Retorno de Fornecedor)!', ['&O k']);
          Exit;
        End;

      End;

      If (Pos(strEspSel, 'GR_') > 0) Then
      Begin
        strDocOri := fRetDocOri(strNumDocSel, 'F', strSerieSel, VS_strCodEmp, strCliForSel, True, 'GR');

        If strDocOri <> 'G' Then
        Begin
          fMensagem('ATENÇÃO!', 'Este documento não é referente a Nota de Garantia (Retorno de Fornecedor)!', ['&O k']);
          Exit;
        End;

      End;*)

      If (Pos(strEspSel, 'GA_') > 0) Then
      Begin
        If fEhGarantiaComDocFiscal(strEspSel, strNumDocSel, strCliForSel, strDocNW) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Este é um documento de Nota de Garantia. Cancele o documento nº ' + strDocNW + 'pela opção (NW - Nota de Garantia (Recebimento do Cliente))!', ['&O k']);
          Exit;
        End;
      End;

      If (Pos(strEspSel, 'NE_') > 0) And fNEUtilizada Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'Nota de entrada já utilizada para liberação de Entrega Futura!', ['&O k']);
        Exit;
      End;

      If (Pos(strEspSel, 'NE_') > 0) And
         fTemConhecimentoVariasNotas('NF', strNumDocSel, strCliForSel, strSerieSel, strSeqFis, strCadFis, strNotas) And
         (Not fPergunta('Existe(m) conhecimento(s) de frete ' + strCadFis + ' relacionado(s) às Notas ' + strNotas +
          ' que não serão cancelados automaticamente. Deseja prosseguir o cancelamento?')) Then
      Begin
        Exit;
      End;

      If (Pos(strEspSel, 'NE_ND_') > 0) And (not fVerificaTAPendente(strNumDocSel, strCliForSel, strSerieSel, strEspSel, '', False)) Then
      Begin
        Exit;
      End;

      // Verifica se existem itens que sairam do almoxarifado e não voltaram (somente autocenter)
      If fQuantidadeItensPendenteAlmoxarifeAutocenter(strNumDocSel, strEspSel, VS_strCodEmp) > 0 Then
      Begin
        fMensagemCancelamento('', 'Pedido possui itens que saíram do almoxarifado e não voltaram, é preciso efetuar a conferência de entrada '
                    + 'dos itens para poder cancelar!', ['&O k']);
        Exit;
      End;

      recStatusPedido := fPedidoFaturado(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel);
      If (recStatusPedido.blnFaturado Or recStatusPedido.blnParcial) Then
      Begin
        If strEspSel = 'PR' Then
          fMensagemCancelamento('ATENÇÃO!', 'Pedido de Devolução '+IIF(recStatusPedido.blnParcial,'baixado parcialmente','já baixado')+'!', ['&O k'])
        Else
          fMensagemCancelamento('ATENÇÃO!', 'O ' + IIF(strEspSel='PD','pedido ','orçamento ') + IIF(recStatusPedido.blnParcial,'baixado parcialmente','já baixado')  + ', ' +
            'portanto não é possível cancelá-lo.', ['&Ok']);
        Exit;
      End;

      If (Pos(strEspSel, 'PD_OR_') > 0) And fPedidoOrcamentoBaixado(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel )Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'Não é permitido cancelar '+IfThen(strEspSel='PD', 'pedido de venda', 'orçamento')+' que possua formulação baixada. '+#13+
                              'Para efetuar o cancelamento, acesse a rotina de Formulação de Tinta de Máquina e desmarque a baixa da OP', ['&O k']);
        Exit;
      End;

      {**********************}
      { Data da Trava Fiscal }
      {*******************RV*}
      strDtTrav := fCfgSis('DTTRAV');

      If (Pos(strEspCan, 'NF_EL_IF_IV_D1_NE_NI_ND_NG_NW_') > 0) And (strDtTrav <> '') And (Not fPodeCancelar(strEspCan, strTipFc, strNumDocSel, strCliForSel)) Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'Data do Documento menor que a Data da Trava Fiscal, não pode ser cancelado.', ['&Ok']);
        Exit;
      End;

      If (Pos(strEspCan, 'NF_EL_IF_IV_D1_NE_NI_ND_NG_NW_') > 0) And (Not fPodeCancelarTravaFechamento(strEspCan, strTipFc, edtNumDoc.Text, edtCliFor.Text)) Then
      Begin
        Exit;
      End;

      If (fCfgSis('USNFCE', varBoolean)) And
         (Pos(strEspCan, 'IF_') > 0) And
         (Not (fPodeCancelarNFCeCAT83Art14(strEspSel, strEspCan, strTipFc, strNumDocSel, strCliForSel))) And
         (Pos(fRetUFEmpresa, fCfgSis('UFCNFC')) > 0) And
         (Not chkInutilizacao.Checked) Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'O emitente deverá solicitar o cancelamento em prazo não superior a 30 (trinta) minutos contados do momento em que foi concedida a Autorização de Uso da NFC-e.', ['&Ok']);
        Exit;
      End;

      If fCupomTemItensDevolvidos(strNumDocSel, strEspCan, VS_strCodEmp) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If (strEspSel = 'EP') And fEmprestimoBaixado(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'Esse Empréstimo já sofreu baixa, não pode ser cancelado.', ['&Ok']);
        Exit;
      End;

      If (strEspSel = 'BE') And (Not fAprovaCancBaixaEmprestimo(strEspSel, strNumDocSel, strCliForSel)) Then
      Begin
        Exit;
      End;

      If fEntregaFuturaBaixada(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'Documento de Entrega Futura com baixa não pode ser cancelado.' + #13 +
                              'Cancele os documentos de baixa primeiro.', ['&Ok']);
        Exit;
      End;

      if (strTipFc <> 'CODFOR') And (fTemPedidoDeBaixaDeEntregaFutura(strEspSel, strNumDocSel, strCliForSel)) then
      begin
        fMensagemCancelamento('ATENÇÃO!', 'Documento de Entrega Futura com baixa não pode ser cancelado.' + sLineBreak +
                              'Cancele os pedidos de baixa primeiro.', ['&OK']);
        Exit;
      end;

      If (Pos(strEspSel, 'PD_') > 0) Then
      Begin
        if (fCfgSis('GARMAT',varBoolean)) then
        begin
          If (VS_strCodEmp = fCfgSis('EMPGAR', varString)) then
          Begin
            If (fPedidoVendaVinculadoANFdeEntrada(strNumDocSel, strCliForSel)) then
            Begin
              btnCancelar.Click;
              Exit;
            end;
          End
          Else
          begin
            If (fPedidoVendaVinculadoAGarantia(strNumDocSel, strCliForSel)) then
            Begin
              btnCancelar.Click;
              Exit;
            end;
          End;
        end;

        if fPedidoReservaEstoqueOrdemProducaoIndustrial(strNumDocSel, strCliForSel) then
        begin
          btnCancelar.Click;
          Exit;
        end;

      end;

      If (strEspSel = 'IF') And (Not fCupomFiscalImpresso(strNumDocSel, strCliForSel)) And (Not blnFaturamento) Then
      Begin
        If Not fPedeSenhaCancelarCupomNaoImpresso Then
        Begin
          Exit;
        End;
      End;

      If fExistePedidoRetira(strNumDocSel, strEspSel, VS_strCodEmp, strSerieSel, strCliForSel) Then
      Begin
        fMensagemCancelamento('', 'Existe um pedido de devolução para retirada vinculado a esse documento, cancele o pedido antes de cancelar o documento!', ['&OK']);
        Exit;
      End;

      If ((strEspSel <> 'ND') and (strEspSel <> 'DL')) And (fDocumentoDevolucao(strNumDocSel, strEspCan, VS_strCodEmp, strCliForSel, strSerieSel)) Then
      Begin
        fMensagemCancelamento('ATENÇÃO!', 'Documento informado é uma Devolução, faça o cancelamento pela opção correta.', ['&OK']);
        Exit;
      End;

      {****************************************************}
      {* SE FOR NF DE CONFIRMAÇÃO DE CUPOM FISCAL,        *}
      {* DEVERÁ SER MOSTRADA UMA TELA LISTANDO OS CUPONS  *}
      {*************************************************MM*}
      If (strEspSel = 'NF') Then
        pNFConfirmacaoCupons(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel);

      If blnPegaDados And fAdCancelamentoJaExiste Then
        Exit;

      If (Pos(strEspSel,'NE_ND_RM_CT_DL_NR_') <= 0) Then
      Begin
        If (Pos(strEspSel, 'NF_NW_EF_') > 0) And (Not edtSerie.Visible) Then
          strSer_Nf := strSerFsc
        Else If (strEspSel = 'IF') And (fCfgSis('USNFCE', varBoolean) Or fUsaSat) And (Not edtSerie.Visible) Then
          strSer_Nf := strSerFsc
        Else
          strSer_Nf := IIF(edtSerie.Visible, strSerieSel, '');

        strStatus := fStatusNFe(strEspCan, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), blnDifChvAcesso);

        If strEspSel = 'NW' then
        Begin
          {Tratamento para selecionar a opção correta quando utilizado NW - NOTA DE GARANTIA (RECEBIMENTO DO CLIENTE)
           req: 205645}
          If (strStatus = '') and (blnNW_Nfe)  Then
          Begin
            fMensagemCancelamento('', 'O documento não pertence a opção selecionada! ' + #13#10 +
                        'Escolher a opção: Entrada de Mercadorias.');
            Exit;
          End
          Else If  (strStatus <> '') And (not blnNW_Nfe) Then
          Begin
            fMensagemCancelamento('', 'O documento não pertence a opção selecionada! ' + #13#10 +
                          'Escolher a opção: Outras Entradas.');
            Exit;
          End
          Else If (Not fEhGarantiaComDocFiscal(strEspSel, strNumDocSel, strCliForSel, strDocNW)) Then
          Begin
            fMensagemCancelamento('', 'O documento selecionado não pertence a garantia.');
            Exit;
          End;
        End;

        If (chkInutilizacao.Checked) and (not CancelandoNFViaFulFillment) Then
        Begin
          If (strStatus <> 'EE') Then
          Begin
            fMensagemCancelamento('', 'Só é possível inutilizar uma nota que esteja com o status de Erro no Painel.');
            Exit;
          End;
        End
        Else If (strStatus <> '') And (strStatus <> 'AT') And (strStatus <> 'DN') And (Not blnPegaDados) And (strStatus <> 'CN')
                And (Not blnCancelarSATouCFTefAutomatico) And (Not CancelandoNFViaFulFillment) And (Not FblnAbastecimentoPeloDeposito) And (Not FblnCancelandoRetornoConsignadoAutomatico) Then
        Begin
          If (blnDifChvAcesso) Then
          Begin
            If fMensagem('ATENÇÃO!', 'Documento com erro de Chave de Acesso Duplicada. Deseja realizar o cancelamento?', ['&Sim', '&Não'], 2) = 2 Then
              Exit;

            objLiberacao.Clear;
            objLiberacao.strDirAce := 'PERMCANNFENFCEERRCHVACESDUP';
            objLiberacao.strCodOpe := strLoginUsuarioLogado;
            objLiberacao.objMsgLibera.pAddTexto('Permissão para cancelamento de NF/NFCE com erro de chave de acesso duplicada.');
            objLiberacao.objMsgLibera.pAddTexto('Documento: ' + strNumDocSel + '-' + strEspSel + '-' + VS_strCodEmp);
            If (Not objLiberacao.fLibera) Then
              Exit;
            blnPermitiuCancelarComChaveAcessoDuplicada := True;
          End;
          If (Not blnDifChvAcesso) Then
          Begin
            fMensagemCancelamento('', 'Documento não autorizado no PainelNFe. Por favor:' + #13#10 +
              '1) Regularize o documento no PainelNFe, ou' + #13#10 +
              '2) Escolha a opção inutilização.');
            Exit;
          End;
        End;

        if fVerificaTemCTeVinculada(strNumDocSel, strEspSel, strTipFC, strCliForSel, strNumCTe, strCodEmpCTE, strAcessoCTE, strSerieCTe) then
        begin

          If fEmptyStr(strAcessoCTE) Then
          Begin
            fMensagemCancelamento('', 'Este documento tem CTe vinculado a ele. '+#13#10+
                        'Empresa Transportadora (' + strCodEmpCTE + ') o CTe: '+ strNumCTe+', porém o mesmo não está autorizado. '+#13#10+
                        'Verifique, é preciso desvincular o CTe para prosseguir!' + #13#10);

            Exit;
          End;

          fMensagemCancelamento('', 'Este documento tem CTe vinculado a ele.' + #13#10 +
                      'Cancele antes na empresa Transportadora (' + strCodEmpCTE + ') o CTe: ' + strNumCTe + '!');

          Exit;
        end;

        If SameText(strEspSel, 'NF') Then
        Begin
          If fExisteEstornoNotaFiscal(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel) Then
          Begin
            Exit;
          End;
        End;

        If fCfgSis('MONFAS', varBoolean) And (fExisteOrdemProducaoRefugada(strCodPro, strEspSel, strNumDocSel, strCliForSel)) Then
        Begin
          if (fMensagem('Confirma?', 'Ao cancelar esta nota de refugo a OP ' + strCodPro + ' será reaberta!' + #13#10 +
                 ' Deseja prosseguir? ', ['&Sim', '&Não']) = 2) then
                Exit;
        End;

        If DeveMostrarDocumentoCancelamento Then
        Begin
          If (Not fMostraDocumentoCancelamento(strNumDocSel,strEspCan,strCliForSel,strEspSel, strSer_Nf, blnCancelandoPendencia)) Then
            Exit;
        End;
      End
      Else If (Pos(strEspSel,'NE_NR_') > 0) Then
      Begin
        {**************************************************}
        {* SE CASO ENTRAR NESSA FUNÇÃO É PORQUE EH        *}
        {* DOCUMENTO DE RECEBIMENTO DE CLIENTE (GARANTIA) *}
        {* ENTÃO NÃO FAZ A VALIDAÇÃO DA NE DE ENTRADA     *}
        {************************************************FC}
        If fPermiteCanRecClienteGar(strEspSel, strNumDocSel, strCliForSel, strDocGar) Then
        Begin
          If Not fExisteNE(strNumDocSel, strSerieSel, strCliForSel) Then
          Begin
            fMensagemCancelamento('ATENÇÃO!', 'Esse documento (NE) não existe!', ['&Ok']);
            Exit;
          End
          Else If fNEDevolvida(strNumDocSel, strSerieSel, strCliForSel) Then
          Begin
            fMensagemCancelamento('ATENÇÃO!', 'Esse documento (NE) ja foi Devolvido!', ['&OK']);
            Exit;
          End
          Else
          Begin
            If Not fImprimeEspelho Then
            Exit;
          End;
        End;
      End
      Else If SameText(strEspSel, 'CT') Then
      Begin
        if not fExisteCTe(edtNumDoc.Text, edtSerie.Text, VS_strCodEmp, strEmpCliCTe, strClienteCTe, strFornecedorCTe, strChaveDeAcessoCTe, strImportouCTe) then
        begin
          fMensagemCancelamento('ATENÇÃO!', 'Documento não encontrado!', ['&Ok']);
          Exit;
        end;

        if fEmptyStr(strChaveDeAcessoCTe) Then
        begin
          strNumCTe := '';
          strSerieCTe := '';
          strCodEmpCTE := '';
          FCancelarCTeViaBanco := (fMensagem('ATENÇÃO!','O Conhecimento de Transporte informado não está autorizado.'+#13+
                                                        'Deseja continuar com o cancelamento ?' , ['&Sim', '&Não'], 2) = 1);

          If not FCancelarCTeViaBanco Then
            Exit;

          strNumCTe := edtNumDoc.Text;
          strSerieCTe := edtSerie.Text;
          strCodEmpCTE := VS_strCodEmp;
        end;

        If (not fEmptyStr(strChaveDeAcessoCTe)) And (not (strImportouCTe = 'S')) Then
        begin
          fMensagemCancelamento('ATENÇÃO!', 'O Conhecimento de Transporte informado ainda não foi importado!', ['&Ok']);
          Exit;
        end;

        if not fInformarOcorrencia(blnCancelandoPendencia) then
          Exit;
      End;

      {********************************************************************}
      {* SE FOR NOTA FISCAL (NF) E ESTE DOCUMENTO É UMA NOTA EMITIDA PELO *}
      {* RECEBIMENTO DE CLIENTE (GARANTIA) NÃO DEIXA CANCELAR A NOTA.     *}
      {* É NECESSÁRIO CANCELAR PELA NOVA OPÇÃO                            *}
      {* NW - NOTA DE GARANTIA (RECEBIMENTO DE CLIENTE)                   *}
      {******************************************************************FC}

      if (Pos(strEspSel, 'GF_NG_') > 0) then
      begin
        if TCancelamentoBaixaEnvio.fVerificarMovGaeBaixada(strNumDocSel, strEspSel, VS_strCodEmp) then
        begin
          Exit;
        end;
      end;

      //Validando se existe documento de transferência vinculado a garantia
      if (Pos(strEspSel, 'NW_GA') > 0) then
      begin
        if Not fCancelaPedidoVenda(strNumDocSel, strEspSel, strCliForSel) then
        begin
          fMensagemCancelamento('Atenção!','Este documento não pode ser cancelado '+slinebreak+
                               'porque não foi possível excluir seu pedido '+slinebreak+
                               'de transferência.',['&Ok']);
          btnCancelar.Click;
          Exit;
        end;
      end;

      If (Pos(strEspSel, 'NF_NE_ND_') > 0) Then
      Begin
        If Not fPermiteCanRecClienteGar(strEspSel, strNumDocSel, strCliForSel, strDocGar) Then
        Begin
          If fExisteReposicaoDaGarantia('NW', strNumDocSel, strCliForSel, strDocGar, strOpcDocGar) Then
          Begin
            fMensagemCancelamento('ATENÇÃO!', 'Este documento não pode ser cancelado, ' + #13#10 +
                                  'pois o mesmo foi reposto ao cliente. ' + #13#10 +
                                  'Efetue Primeiro o Cancelamento da reposição ao cliente. ' + #13#10 +
                                  'Cancele o documento nº ' + strDocGar + ' através da opção: ' + #13#10 +
                                  IIF(strOpcDocGar = 'GC',
                                  '"GC" - Garantia (Envio para o Cliente)',
                                  '"OF" - Nota de Outras Saídas') , ['&Ok']);

            btnCancelar.Click;
            Exit;
          End
          Else
          Begin
            fMensagemCancelamento('ATENÇÃO!', 'Este documento não pode ser cancelado, pois o mesmo foi ' + #13#10 +
                                  'gerado através de um Recebimento de Cliente (Garantia).' + #13#10 +
                                  'Cancele o documento através da opção: ' + #13#10 +
                                  '"NW" - Nota de Garantia (Recebimento do Cliente).', ['&Ok']);

            btnCancelar.Click;
            Exit;
          End;
        End;
      End;

      {********************************************************************}
      {* ANTES DE EFETUAR O CANCELAMENTO VERIFICA SE EXISTE ALGUM DOCUMEN *}
      {* TO DE REPOSIÇÃO P/ O CLIENTE, CASO TENHA DEVE SER CANCELADO ANTES*}
      {* DE CANCELAR O RECEBIMENTO DO CLIENTE                             *}
      {********************************************************************}
      if (pos(strEspSel,'_NW_') > 0) then
      begin
        if Not fVerificarSeDocumentoColeta(strEspSel, strNumDocSel, VS_strCodEmp) then
        begin
          btnCancelar.Click;
          Exit;
        end;
      end;

      If (Pos(strEspSel, 'NW_GA_') > 0) Then
      Begin
        If fExisteReposicaoDaGarantia(strEspSel, strNumDocSel, strCliForSel, strDocGar, strOpcDocGar) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Este documento não pode ser cancelado, ' + #13#10 +
                                'pois o mesmo foi reposto ao cliente. ' + #13#10 +
                                'Efetue Primeiro o Cancelamento da reposição ao cliente. ' + #13#10 +
                                'Cancele o documento nº ' + strDocGar + ' através da opção: ' + #13#10 +
                                IIF(strOpcDocGar = 'GC',
                                '"GC" - Garantia (Envio para o Cliente)',
                                '"OF" - Nota de Outras Saídas') , ['&Ok']);

          btnCancelar.Click;
          Exit;
        End
        Else If fExisteEnvioParaFornecedorDaGarantia(strEspSel, strNumDocSel, strCliForSel) Then
        Begin
          btnCancelar.Click;
          Exit;
        End;

        if (TGarantiaPropriaEmpresaCancelamento.fGarantiaTemPedidoReposicao(strCliForSel, strNumDocSel, strEspSel, VS_strCodEmp)) then
          Exit;

        //Caso seja filial, não permite cancelar caso o Pedido já foi expedido e Efetuado a TE;
        If fCfgSis('GARMAT', VarBoolean) And (VS_strCodEmp <> fCfgSis('EMPGAR', varString)) Then
        Begin
          If Not fPedidoGarantiaTEBaixado(strEspSel) Then
          Begin
            btnCancelar.Click;
            Exit;
          End;

        End;

      End;

      {**********************************************************}
      {* CASO ESTEJA CANCELANDO UM DOCUMENTO DE GARANTIA        *}
      {* O SISTEMA VERIFICA SE O DOCUMENTO CANCELADO É O ÚLTIMO *}
      {* POIS NÃO PODE SER CANCELADO UM ENVIO PARA FORNECEDOR   *}
      {* SE O DOC. DE RETORNO DE FORNECEDOR ESTIVER ABERTO      *}
      {*******************************************************MM*}
      // Foi removido a validação do espsel {'NR_NG_'} pois
      // para cancelar o retorno de fornecedor nao tem necessidade
      // de bloquear se o retorno ja foi feito para o cliente ou nao
      // req. 55154. #GB
      objCancelamentoGarantia := TCancelamentoGarantia.Create;
      try
        objCancelamentoGarantia.strSigla := strEspSel;
        If objCancelamentoGarantia.fVerificaMovimentacoesPosteriores Then
        Begin

          arrDadosDocumentos := fRetornaDocumentosVinculadosGarantia(strEspSel, strNumDocSel, strCliForSel);
          If (Length(arrDadosDocumentos)> 0) Then
          Begin
            If objCancelamentoGarantia.fEhRecebimentoCliente Then
              strEspPos := 'ENVIO(S) P/ FORNECEDOR'
            Else If (Pos(strEspSel,'GF_NG_') > 0) Then
              strEspPos := 'RETORNO(S) DE FORNECEDOR'
            Else If (Pos(strEspSel,'GR_NR_') > 0) Then
              strEspPos := 'BAIXA DE REFUGO';

            pMensagemDocumentosVinculados( 'O documento '+strNumDocSel+' não pode ser cancelado, ' +
                                           'pois os documentos acima listados, ref. ao ' + strEspPos +
                                           ' em aberto estão relacionados a ele.');
            btnCancelar.Click;
            Exit;
          End
          Else
          If (Pos(strEspSel, 'GF_NG_') > 0) And fTemBaixaDeRetorno(strNumDocSel, strCliForSel) Then
          Begin
            fMensagemCancelamento('', 'Existe produtos que já foram baixados nesta garantia, não é possível cancelar esse documento!', ['&OK']);
            Exit;
          End;
        End;
      finally
        FreeAndNil(objCancelamentoGarantia);
      end;


      //Cancelamento de devolucao de tinta de maquina pigmento/base
      If (Not fCfgSis('CNDVPB', varBoolean)) Then
        pPegaDocumentoPrincipalTintaMaquinaDevolucao(strNumDocSel, strEspSel, VS_strCodEmp,
                                                     strTmpDoc, strTmpEsp, strTmpEmp);

      If (Not fEmptyStr(strTmpDoc)) Then
      Begin
        If TinGer.fVerificaTinDetBaixado(strTmpDoc, strTmpEmp, strTmpEsp,
          Format('O documento %s - %s - %s não pode ser devolvido. Será necessário efetuar uma nova venda !',
                [strNumDocSel, strEspSel, VS_strCodEmp])) then
        Begin
          btnCancelar.Click;
          Exit;
        End;
      End;

      pPegaDocumentoEntregaFutura(strNumDocSel, strEspSel, VS_strCodEmp,
                                  strTmpDoc,      strTmpEsp, strTmpEmp);

      If fEmptyStr(strTmpDoc) Then
      Begin
        strTmpDoc := strNumDocSel;
        strTmpEsp := strEspSel;
        strTmpEmp := VS_strCodEmp;
      End;

      If (fSuportaInterfaceGrafica) Then
      Begin
        if (fCfgSis('EXIDOC') <> 'V') and (fExisteDocumentoBaixado(strTmpDoc, VS_strCodEmp, strTmpEsp)) Then
        begin
          If  (fMensagem('','Existem Fórmulas que foram baixadas na formulação de tinta de máquina, '+
                            'para cancelar o documento será necessário que desmarque a baixa.'+ #13 +
                            'Deseja desmarcar a baixa? ', ['&Não','&Sim']) = 2) Then
          begin
            Try
              qryAux := fCriaQuery(Self);

              // Atualizar a tabela do Documento Selecionado
              qryAux.SQL.Clear;
              qryAux.Close;
              qryAux.SQL.Text := 'UPDATE TINDET               '+
                                 '   SET DET_OPEBAI = NULL    '+
                                 '     , DET_DTABAI = NULL    '+
                                 '     , DET_HORBAI = NULL    '+
                                 '     , DET_BAIXAD = "N"     '+
                                 ' WHERE DET_NUMDOC = :NUMDOC '+
                                 '   AND DET_CODEMP = :CODEMP '+
                                 '   AND DET_ESPDOC = :ESPDOC ';

              pSetParametros(qryAux, strTmpDoc, VS_strCodEmp, strTmpEsp);

              qryAux.ExecSQL;

              qryAux.SQl.Clear;
              qryAux.Close;
              qryAux.SQl.Text := 'SELECT DET_NUM_PD          '+
                                 '     , DET_ESP_PD          '+
                                 '     , DET_EMP_PD          '+
                                 '  FROM MOVDET              '+
                                 ' WHERE DET_NUMDOC = :NUMDOC'+
                                 '   AND DET_CODEMP = :CODEMP'+
                                 '   AND DET_ESPDOC = :ESPDOC';

              pSetParametros(qryAux, strTmpDoc, VS_strCodEmp, strTmpEsp);
              qryAux.Open;

              strDetNumPD  := qryAux.FieldbyName('DET_NUM_PD').AsString;
              strDetEspDoc := qryAux.FieldbyName('DET_ESP_PD').AsString;
              strDetEmpPD := qryAux.FieldbyName('DET_EMP_PD').AsString;

              // Atualizar a tabela do documento de origem (Pedido/Orçamento)
              qryAux.SQL.Clear;
              qryAux.Close;
              qryAux.SQL.Text := 'UPDATE TINDOR               '+
                                 '   SET FDO_OPEBAI = NULL    '+
                                 '     , FDO_DTABAI = NULL    '+
                                 '     , FDO_HORBAI = NULL    '+
                                 '     , FDO_BAIXAD = "N"     '+
                                 ' WHERE FDO_NUMDOC = :NUMDOC '+
                                 '   AND FDO_CODEMP = :CODEMP '+
                                 '   AND FDO_ESPDOC = :ESPDOC ';
              pSetParametros(qryAux, strDetNumPD, IIF(fEmptyStr(strDetEmpPD), VS_strCodEmp, strDetEmpPD), strDetEspDoc);
              qryAux.ExecSQL;

            finally
              pFreeAndNil(qryAux);
            end;
          end
          else
          begin
            btnCancelar.Click;
            Exit;
          end
        end
        else if TinGer.fVerificaTinDetBaixado(strNumDocSel, VS_strCodEmp, strEspSel,
          Format('O documento %s - %s - %s não pode ser cancelado pois existem produtos já baixados',
          [strNumDocSel, strEspSel, VS_strCodEmp])) then
        begin
          btnCancelar.Click;
          Exit;
        end;
      End;

      If fVerificaDocumentoConfirmado(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If fVerificaDocumentoRomaneio(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If fVerificaDocumentoRequisicaoCompra(strEspSel, strNumDocSel, VS_strCodEmp) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If fVerificaDocumentoEntrega(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If Not fVerificaDocumentoAgrupado(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      if not fVerificaDocEntradaAbastecimento(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel) then
      Begin
        btnCancelar.Click;
        Exit;
      End;
                                                           //COLOMARTI
      If (Pos(strEspSel, 'NF_EL_IF_IV_D1_NE_NI_ND_') > 0) And (fCfgSis('BXSBIT') = '3') And
         (fCfgSis('ORDPRO', varBoolean)) And (fBaixaOrdemProducaoAutomaticamente) And (fSuportaInterfaceGrafica) Then
      Begin
        If fGetOrdensBaixadasVenda(strEspSel, strNumDocSel, strCliForSel, strOPsBaixadas) Then
        Begin
          fMensagemCancelamento('', 'Este documento não pode ser cancelado pois existem ordens de produção baixadas para ele.' +#13#10
                    + 'Ordens: ' + strOPsBaixadas);
          btnCancelar.Click;
          Exit;
        End;
      End;

      {************************************************************************************}
      {* NÃO VERIFICA QTD DE DIAS PARA CANCELAR QUANDO 'ND' - Nota de Entrada - Devolução *}
      {*********************************************************************************RN*}
      If (fSuportaInterfaceGrafica) And
         (Not SameText(strEspSel, 'ND')) And
         (Not SameText(strEspSel, 'DL')) And
         (Not fVerificarDiasCancelamento(strNumDocSel, strEspSel, strTipFc, strCliForSel, blnNotaEletronica, dtaDtaNota, strCfgDesc)) Then
      Begin
        If (fCfgSis('NFEUSA', varString) = 'S') And (blnNotaEletronica) Then
        Begin
          If fDocumentoJaConstaComoCanceladoNaSefaz(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel, strTipFc) Then
            strDocumentoJaConstaComoCanceladoNaSefaz := 'S'
          Else
            strDocumentoJaConstaComoCanceladoNaSefaz := 'N';
          If (strDocumentoJaConstaComoCanceladoNaSefaz <> 'S') Then
          Begin
            objLiberacao.Clear;
            objLiberacao.strDirAce    := 'CNFEFP';
            objLiberacao.strCodOpe    := strLoginUsuarioLogado;
            objLiberacao.objMsgLibera.pAddTexto('Tentativa de ' + IIF(chkInutilizacao.Checked, 'inutilização', 'cancelamento') + ' fora do prazo.');
            objLiberacao.objMsgLibera.pAddSeparador;
            objLiberacao.objMsgLibera.pAddTextoCaption('Documento', strNumDocSel + '-' + strEspSel + '-' + VS_strCodEmp, 22);

            If SameText(strTipFc,'CODFOR') Then
              objLiberacao.objMsgLibera.pAddTextoCaption('Fornecedor', strCliForSel + '-' + fRetNomFornecedor(strCliForSel), 22)
            Else
              objLiberacao.objMsgLibera.pAddTextoCaption('Cliente', strCliForSel + '-' + fRetNomCliente(strCliForSel), 22);

            If fCarregaInformacoesDoCancelamnento(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel, recDadosCancelamento) Then
            Begin
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor'    , recDadosCancelamento.strCodVen + '-' + fRetNomeOperador(recDadosCancelamento.strCodVen), 22);
              objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Documento', FloatToStrF(recDadosCancelamento.fltTotGer, ffNumber, 12, 2)                           , 22);
              objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto.', recDadosCancelamento.strCodCnd + '-' + fRetDesConPag(recDadosCancelamento.strCodCnd)   , 22);
              objLiberacao.objMsgLibera.pAddTextoCaption(''            , fFormataCondPag(recDadosCancelamento.strConPag)                                        , 22);
              objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pagto.', recDadosCancelamento.strCodFpg + '-' + fRetDescFpg(recDadosCancelamento.strCodFpg)     , 22);
            End;

            objLiberacao.objMsgLibera.pAddTextoCaption('Data/Hora do Documento', FormatDateTime('dd/mm/yyyy hh:nn:ss', dtaDtaNota) , 22);
            objLiberacao.objMsgLibera.pAddTextoCaption('Prazo Configurado'     , strCfgDesc                                        , 22);

            objLiberacao.objMsgLibera.pAddSeparador;

            objLiberacao.pInformaNumDocEspDocCodEmp(strNumDocSel, strEspSel, VS_strCodEmp);

            If not objLiberacao.fLibera then
            Begin
              fMensagemCancelamento('', 'Não é permitido cancelar ou inutilizar uma NFe com número de dias desde a data de emissão  ' +
                            'até a data atual superior ao configurado que é de: ' + strCfgDesc + '!', ['&OK']);
              btnCancelar.Click;
              Exit;
            End;
          End;
        End

        {*****************************************************************}
        {* PEDE SENHA PARA PERMITIR CANCELAMENTO - QD ULTRAPASSADO PRAZO *}
        {**************************************************************LU*}
        Else If Not fEmptyStr(fCfgSis('SENCAN')) Then
        Begin
          ffrmSenha(strSenha);
          If strSenha <> fCfgSis('SENCAN') Then
          Begin
            fMensagemCancelamento('', 'Não é permitido cancelar um documento com número de dias desde a data de emissão  ' +
                          'até a data atual superior ao configurado no cancelamento de documentos que é de: ' +
                          IntToStr(fCfgSis('CANDOC', varInteger)) + ' dias !', ['&OK']);
            btnCancelar.Click;
            Exit;
          End;
        End;
      End;

      {*******************************}
      {* VERIFICA SALDO DE BALANÇO   *}
      {* ALTERAÇÃO PEDIDA PELO MARIO *}
      {* 14/03/2007                  *}
      {****************************AF*}
      If (fSuportaInterfaceGrafica) And (Not fVerificaSalBal(strEspSel, strNumDocSel, strCliForSel)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      {********************************************************}
      {*PROCEDURE QUE VERIFICA SE O DOCUMENTO A SER CANCELADO *}
      {*FOI ENVIADO POR REMESSA BANCÁRIA. SE FOI ENVIADA EXIBE*}
      {*UMA MENSAGEM, TRAVA E MOSTRA OS DADOS DA DUPLICATA    *}
      {******************************************************PZ}
      If fVerificaEnvioRemessa(strEspSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If fUsaRequisicaoEnvioMateriais Then
      Begin
        If fVerificarObraFinalizada(strNumDocSel, strEspSel, strCliForSel) Then
        Begin
          btnCancelar.Click;
          Exit;
        End;

        If fVerificarRequisicoes(strNumDocSel, strEspSel, strCliForSel) Then
        Begin
          btnCancelar.Click;
          Exit;
        End;
      End;

      If fVerificaDocumentoPromocaoBrindes(strNumDocSel, strEspSel, strCliForSel, edtTipPes.Text) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If fVerificaContratoLocacaoEquipamentos(strNumDocSel, strEspSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If (Pos(strEspSel, 'NF_EL_IF_IV_D1_MI_FF_') > 0) Then
      Begin

        If fDocumentoEhProvenienteDeExpedicao(strEspSel, strNumDocSel, strCliForSel) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Este documento já foi expedido.' + #13#10 +
                                'É necessário autorização para seu cancelamento / inutilização.', ['&Ok']);
          If Not fPermiteCancelarDocumentoProvenienteDeExpedicao Then
          Begin
            btnCancelar.Click;
            Exit;
          End;
        End;

      End;

      If (Pos(strEspSel, 'NE_OF_EF_' + IIF(edtTipPes.Text = 'F', 'ND_', '')) > 0) Then
      Begin
        {*********************************************************************}
        {*   Se For nota de Entrada e o "Saldo + EntFut" Apos o cancelamento *}
        {* ficar negativo solicita Senha de liberacao para poder cancelar    *}
        {******************************************************************WG*}
        blnTemMovimento117 := fTemMovimento117('NF', strNumDocSel, strCliForSel, strSerieSel);
        If (strEspSel = 'NE') And ((Not blnPedidoEntrada) And (fTemMovimentoVinculado117('NF', strNumDocSel, strCliForSel, strSerieSel, strDocumentos))) Then
        Begin
          fMensagemCancelamento('', 'Para cancelar um documento x922 é preciso cancelar os documento x117 ou x116 amarrados a ele.' + #$A#$D + strDocumentos);
          Exit;
        End;

        If (strEspSel = 'NE') And (Not (fValidaSaldoNegativoAposCancelamento(
                                                  strNumDocSel,
                                                  IIF(Not blnPedidoEntrada,'NF', 'PD'),
                                                  strCliForSel,
                                                  strSerieSel,
                                                  strEspSel ))) Then
          Exit;

        lstCtpBaixadas := fVerificarCadPagBaixado(strEspSel, strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, IfThen(strEspSel = 'EF', strSerieCan, strSerieSel));

        lstCtpReteBaix:= fVerificarCadPagRetencoesBaixado(strNumDocSel, VS_strCodEmp, strCliForSel, strSerieSel, IIF(Not blnPedidoEntrada,'NF', 'PD'));

        if strEspSel = 'EF' then
        begin
          strAutIncMovGer := fRetAutIncMovGer(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);
          pVerificarCadPagBaixadoFunrural();
        end;

        lstCtpAgrupada := fVerificarCadPagAgrupado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);

        If strEspSel = 'NE' Then
        Begin
          lstCtpGnrBaixa := fVerificarCadPagGnrBaixado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);
          lstCtpCFrBaixa := fVerificarCadPagCFrBaixado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);
          lstCtpAntBaixa := fVerificarCadPagAntBaixado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);

          lstCtpGnrAgrup := fVerificarCadPagGnrAgrupado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);
          lstCtpCFrAgrup := fVerificarCadPagCFrAgrupado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);
          lstCtpAntAgrup := fVerificarCadPagAntAgrupado(strNumDocSel, IIF(Not blnPedidoEntrada,'NF', 'PD'), strCliForSel, strSerieSel);
        End;

        If (lstCtpBaixadas.Count > 0) Or (lstCtpGnrBaixa.Count > 0) Or
           (lstCtpCFrBaixa.Count > 0) Or (lstCtpAntBaixa.Count > 0) Or
           (lstCtpAgrupada.Count > 0) Or (lstCtpGnrAgrup.Count > 0) Or
           (lstCtpCFrAgrup.Count > 0) Or (lstCtpAntAgrup.Count > 0) Or
           (lstCtpReteBaix.Count > 0) Then
        Begin
          pGeraResumo;
          Exit;
        End;
      End
      Else
      Begin
        If (Not blnFaturamento) Then
        Begin
          pSetaListaDeCtrBaixadas;
          SetaListaDeCtrPixAtivo;

          If (lstCtrBaixadas.Count > 0) Or (FCtrPixGerado.Count > 0) Then
          Begin
            If FExecutandoCanceladorAutomatico Then
              Raise ExceptionEstornoMalsucedido.Create(Format('Estorno: Duplicatas Baixadas %d, Duplicatas Pix Gerado: %d ', [lstCtrBaixadas.Count, FCtrPixGerado.Count]));

            If (blnCancelarSATouCFTefAutomatico) or (CancelandoNFViaFulFillment) or (FblnCancelandoRetornoConsignadoAutomatico) or
               (FUtilizaContabilidadeERecebidoPorAdiantamento) Then
            Begin
              If FUtilizaContabilidadeERecebidoPorAdiantamento Then
              Begin
                If Not untFuncoesSimples.fVerificaAcessoSistema('frmEstornoCtaReceber') Then
                Begin
                  fMensagem('ATENÇÃO', 'Operador sem direito de acesso para liberar o estorno.', ['&Ok']);
                  Exit;
                End;
              End;

              pEstornoReceber(True);
              pSetaListaDeCtrBaixadas;
              SetaListaDeCtrPixAtivo;

              If (lstCtrBaixadas.Count > 0) Or (FCtrPixGerado.Count > 0) Then
              Begin
                if not(CancelandoNFViaFulFillment) then
                  pGeraResumo;
                Exit;
              End;
            End
            Else IF FblnCancelamentoLocEqu Then
            Begin

              For intContB:= 0 To lstCtrBaixadas.Count-1 do
              Begin
                strAuxiliar := Copy(lstCtrBaixadas[intContB], 0, Pos('-', lstCtrBaixadas[intContB]));
                strParcela := Copy(strAuxiliar, 13, Length(strAuxiliar)-13);
                pEstornoReceber(False, False, strParcela);
              End;

              pSetaListaDeCtrBaixadas;
              If (lstCtrBaixadas.Count > 0) Then
              Begin
                if not(CancelandoNFViaFulFillment) then
                  pGeraResumo;
                Exit;
              End;

            End
            Else
            Begin
              pGeraResumo;
              Exit;
            End;
          End;

          {*********************************************************}
          {* CARREGA O VALOR TOTAL DO ADIANTAMENTO(S) DO PEDIDO    *}
          {******************************************************JC*}
          If (strEspSel = 'PD') And
             (objPedidoAlpe.strTipRec <> 'ALPE') And
             (TAdiantamento.fGetTotaisAdiantamento(strNumDocSel,
                                                   strEspSel,
                                                   VS_strCodEmp).fltValLan > 0.00) Then
          Begin
            fMensagemCancelamento('', 'Este pedido possui crédito disponível referente adiantamento de cliente, ' +
                        'portanto será necessário estornar este recebimento antes de cancelar o pedido!');
            Exit;
          End;

        End;
      End;

      if (strEspSel = 'CT') then
      begin
        lstCtpBaixadas := fVerificarCadPagBaixado(strEspSel, strNumDocSel, 'CT', strFornecedorCTe, edtSerie.Text);

        lstCtpAgrupada := fVerificarCadPagAgrupado(strNumDocSel, 'CT', strFornecedorCTe, edtSerie.Text);

        if (lstCtpBaixadas.Count > 0) Or (lstCtpAgrupada.Count > 0) then
        begin
          pGeraResumo;
          Exit;
        end;
      end;

      {*************************************************}
      {* VERIFICA SE O DOCUMENTO TEM CONTAS A PAGAR DE *}
      {* SERVIÇO TERCEIRIZADO BAIXADO                  *}
      {**********************************************MM*}
      If fCfgSis('AUTCEN',varBoolean) And
        (Pos(strEspSel, 'NS_NF_MI_FF_') > 0) Then
      Begin
        If Assigned(lstCtpServBaix) Then
          FreeAndNil(lstCtpServBaix);

        lstCtpServBaix := fVerificarCadPagServBaixado (strNumDocSel, strEspSel, strCliForSel);
        lstCtpServAgru := fVerificarCadPagServAgrupado(strNumDocSel, strEspSel, strCliForSel);

        If (lstCtpServBaix.Count + lstCtpServAgru.Count > 0) Then
        Begin
          pGeraResumo;
          Exit;
        End;
      End;

      If (fSuportaInterfaceGrafica) And (Not fVerificarDevolucoes(strNumDocSel, strEspSel, strCliForSel)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If Not fVerificaDocProvFatORPD(strEspSel, strNumDocSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If (strEspSel = 'PD') And (Not fVerificaPedAbastecimento(strNumDocSel, strEspSel, VS_strCodEmp)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      {*REQ.148688**********RP*}
      If Not fVerificarTransfAutomDocVenda(strNumDocSel, strEspSel, strCliForSel) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If strEspSel = 'NS' Then
      Begin
        If not fVerificaSituacaoDoDocumentoFiscal(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), IIF(edtSerie.Visible, strSerieSel, strSerFsc)) Then
        Begin
          fMensagemCancelamento('ATENÇÃO', 'A nota de serviço informada não pode ser cancelada pois ela não foi autorizada na prefeitura. '+#13+
                               'Reenvie o documento pelo painel e depois da autorização na prefeitura, efetue o cancelamento!',
                               ['&Ok'], 0, 750);
          btnCancelar.Click;
          Exit;
        End;
      End;

      blnGnreDeSaidaApagaDuplicatasContasPagar := False;

      If (fRetornaEspecieCancelamento(strEspSel) = 'NF') then
      begin
        If fGnreDeSaidaExisteContasPagarBaixado(strNumDocSel, strCliForSel, IIF(edtSerie.Visible, strSerieSel, strSerFsc)) Then
        Begin
          fMensagemCancelamento('ATENÇÃO', 'Esta Nota Fiscal teve GNRE gerada para recolhimento e já está quitada no Contas a Pagar.'+#13+
                               'Não será permitido cancelar esta nota fiscal.'+#13+
                               'Para realizar o cancelamento dela, será necessário desfazer a baixa deste imposto, fazendo o estorno do seu Contas a Pagar.'+#13+
                               'Procure o Departamento Financeiro para maiores detalhes.', ['&Ok'], 0, 750);
          btnCancelar.Click;
          Exit;
        End;

        If fGnreDeSaidaExisteContasPagarAberto(strNumDocSel, strCliForSel, IIF(edtSerie.Visible, strSerieSel, strSerFsc)) Then
        Begin
          blnGnreDeSaidaApagaDuplicatasContasPagar :=
            fMensagem('ATENÇÃO', 'Esta Nota Fiscal teve GNRE gerada para recolhimento mas o título está aberto no Contas a Pagar.'+#13+
                                 'Procure o Departamento Financeiro para informá-lo que não deve recolher a guia, pois a nota fiscal será cancelada.'+#13+
                                 'Com o cancelamento da nota fiscal, o título da GNRE será apagado do Contas a Pagar.'+#13+
                                 'Confirma o cancelamento da Nota Fiscal ?', ['&Sim', '&Não'], 1, False, 1, 100, False, 0, False, False, False, 0, 700) = 1;

          If not blnGnreDeSaidaApagaDuplicatasContasPagar then
          Begin
            btnCancelar.Click;
            Exit;
          End;
        End;

      End;

      pAtribuiPicture(imgNaoAlterado.Picture);

      blnPedidoCompraBaixado := False;

      If (Pos(strEspSel, 'NF_EL_NS_IF_IV_D1_NI_NC_IC_EF_DC_' ) > 0) Then
      Begin
        if (strEspSel = 'NS') and fNotaFiscalTemContasAPagarGeradaPelaRotinaDeResumoISS(strNumDocSel, strEspSel, strCliForSel) then
        begin
          fMensagemCancelamento('ATENÇÃO!', 'Esta Nota Fiscal já teve seu Contas a Pagar gerado através da Apuração do ISS.'+slineBreak+
                                            'A operação de cancelamento não é permitida.', ['&Ok']);
          btnCancelar.Click;
          Exit;
        end;

        If fSuportaInterfaceGrafica Then
          blnPedidoCompraBaixado := (fPedidoCompraBaixado(strEspSel, strNumDocSel, qryAux001));

        If blnPedidoCompraBaixado Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'O Pedido de compra dessa nota de transferência já foi baixado!' + #13#10 +
                                'Não será possível cancelar essa nota de transferência!', ['&Ok']);
          btnCancelar.Click;
          Exit;
        End
        Else
        Begin
          blnEhNFDevolucaoClientesPorOutrasEntradas := (fUsaRotinaWMS) And (SameText(strEspSel, 'NF')) And (fEhNFDevolucaoClientesPorOutrasEntradas(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF'));
          blnEhNFDevolucao := (SameText(strEspSel, 'NF')) And (fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF'));

          If (blnEhNFDevolucaoClientesPorOutrasEntradas Or blnEhNFDevolucao) Then
          Begin
            If Not(fVerificaTAPendente(strNumDocSel, strCliForSel, fRetSerFsc ,cnsEspParaBuscaDeTAGenerica, '', False)) Then
            Begin
              btnCancelar.Click;
              Exit;
            End;
          End;

          blnEhNFDevolucao := False; //Essa variável será realimentada mais abaixo conforme a necessidade;
        End;
      End
      Else If (Pos(strEspSel, 'DV_' ) > 0) Then
      Begin
        If Not(fVerificaTAPendente(strNumDocSel, strCliForSel, fRetSerFsc, cnsEspParaBuscaDeTAGenerica, 'DV', False)) Then
        Begin
          btnCancelar.Click;
          Exit;
        End;
      End;

      If SameText(strEspSel, 'PD') And
        (Not fVerificaSeTemPedidoVinculadoComOrcamentoTransf(VS_strCodEmp, strNumDocSel)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If (strEspSel = 'ND') And (blnConEqu) Then
      Begin
        If (Not TConEqu.fNotaEntradaEquipamentoExiste(strNumDocSel, 'NF', strSerieSel, strCliForSel, VS_strCodEmp, edtTipPes.Text)) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Nota de entrada não foi encontrada. Operação cancelada!', ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;

        If (TConEqu.fNotaEntradaPossuiVinculoOS(strNumDocSel, 'NF', strSerieSel, strCliForSel, VS_strCodEmp, 'E', strDadosOs)) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Nota de entrada está vinculada a OS ' + QuotedStr(strDadosOs) + '. Operação cancelada!', ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;
      End;

      If (strEspSel = 'DL') Then
      Begin
        If (Not fNotaEntradaLocEquipamentoExiste(strNumDocSel, 'NF', strSerieSel, strCliForSel, VS_strCodEmp, edtTipPes.Text)) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Nota de entrada não foi encontrada. Operação cancelada!', ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;
      End;

      If Not objLock.fLock_Unlock(TfrmEntEnderecamentoProduto.fGetChaveDocumento(
        strNumDocSel, VS_strCodEmp, strCliForSel), True, False) Then
      Begin
        fMensagemCancelamento('', 'Esse Documento está sendo utilizado em Outra Estação por ' +
                      fGetHostLock(TfrmEntEnderecamentoProduto.fGetChaveDocumento(
                        strNumDocSel, VS_strCodEmp, strCliForSel))  + '!', ['&Ok']);
        btnCancelar.Click;
        Exit;
      End;

      If SameText(strEspSel, 'RO') And (Not fDocumentoROExiste(VS_strCodEmp,
        strNumDocSel, strCliForSel)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If blnPegaDados Then
      Begin
        ModalResult := MrOK;
        Exit;
      End;

      If (strEspSel = 'NF') And
         (fCfgSis('PROCTR') = '1') And
         (fCfgSis('AGDPIF') = 'S') Then
      Begin
        If fExisteParcelaBaixadaAgrupamentoFinanceiroDeConfirmacaoDeCupomFiscal(
                           strNumDocSel, strEspSel, VS_strCodEmp) Then
        Begin
          fMensagemCancelamento('ATENÇÃO!', 'Não foi possível cancelar o documento pois já existe baixa financeira!', ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;
      End;

      {$Region 'Baixa ocorrência CRM Garantia'}
      if (Pos(arrEspecies[intIndiceEsp][0], 'GA_NW_') > 0) Then
      begin
        TLibCancelamentoDocGarantia
          .pIncluirHistoricoCRMCancelamentoGarantia(strNumDocSel,
                                                    IfThen(strEspSel='GA', 'GA', 'NF'),
                                                    strCliForSel,
                                                    VS_strCodEmp);
      end;
      {$EndRegion 'Baixa ocorrência CRM Garantia'}

      If (fCfgSis('OUSAFO', varString) = '2') And (Pos(arrEspecies[intIndiceEsp][0], 'GA_NW_') > 0) Then
      Begin
        Try
          qryEspGer := fCriaQuery;
          If arrEspecies[intIndiceEsp][0] = 'GA' Then
          Begin
            qryEspGer.Sql.Add('SELECT ESPGER.AUTOINCREM, ESPGER.GER_MOVGER,');
            qryEspGer.Sql.Add('       CONCAT("Esta garantia possui um espelho emitido. Empresa: ", IFNULL(MOVGER.GER_CODEMP, ""),');
            qryEspGer.Sql.Add('       " Numero: ", IFNULL(MOVGER.GER_NUMDOC, ""),');
            qryEspGer.Sql.Add('       " Espécie: ", IFNULL(MOVGER.GER_ESPDOC, ""),');
            qryEspGer.Sql.Add('       " Série: ", IFNULL(MOVGER.GER_SERIE_, ""),');
            qryEspGer.Sql.Add('       IF(MOVGER.GER_TIP_FC = "C", "Cliente: ", "Fornecedor: "), IF(MOVGER.GER_TIP_FC = "C", IFNULL(MOVGER.GER_CODCLI, "") , IFNULL(MOVGER.GER_CODFOR, ""))) AS DOCEMI');

            qryEspGer.Sql.Add('  FROM ESPDEG');
            qryEspGer.Sql.Add(' INNER JOIN ESPDET ON ESPDET.AUTOINCREM = DEG_SEQGER ');
            qryEspGer.Sql.Add(' INNER JOIN ESPGER ON ESPGER.AUTOINCREM = DET_SEQGER ');
            qryEspGer.Sql.Add(' INNER JOIN MOVGAD ON MOVGAD.AUTOINCREM = DEG_SEQGAD');
            qryEspGer.Sql.Add(' INNER JOIN MOVGAG ON MOVGAG.AUTOINCREM = MOVGAD.GAD_SEQGAG');
            qryEspGer.Sql.Add('  LEFT JOIN MOVGER ON MOVGER.AUTOINCREM = ESPGER.GER_MOVGER');

            qryEspGer.Sql.Add(' WHERE GAG_NUMENT = :NUMENT');
            qryEspGer.Sql.Add('   AND GAG_CODCLI = :CODCLI');
            qryEspGer.Sql.Add('   AND GAG_CODEMP = :CODEMP');
          End
          Else
          Begin
            qryEspGer.Sql.Add(' SELECT ESPGER.AUTOINCREM, ESPGER.GER_MOVGER,            ');
            qryEspGer.Sql.Add('      CONCAT("Esta garantia possui um espelho emitido em aberto. ",');
            qryEspGer.Sql.Add('      " Espelho: ", IFNULL(ESPGER.GER_NUMESP, ""),       ');
            qryEspGer.Sql.Add('      " Empresa: ", IFNULL(MOVGER.GER_CODEMP, ""),       ');
            qryEspGer.Sql.Add('      IF(ESPGER.GER_TIP_FC = "C", " Cliente: ", " Fornecedor: "), IF(ESPGER.GER_TIP_FC = "C", IFNULL(ESPGER.GER_CODCLI, "") , IFNULL(ESPGER.GER_CODFOR, ""))) AS DOCEMI');
            qryEspGer.Sql.Add(' FROM MOVGER                                              ');
            qryEspGer.Sql.Add(' INNER JOIN MOVDET ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ');
            qryEspGer.Sql.Add(' INNER JOIN MOVGRC ON GRC_SEQDET = MOVDET.AUTOINCREM      ');
            qryEspGer.Sql.Add(' INNER JOIN ESPDEG ON DEG_SEQGAD = GRC_SEQGAD             ');
            qryEspGer.Sql.Add(' INNER JOIN ESPDET ON ESPDET.AUTOINCREM = DEG_SEQGER      ');
            qryEspGer.Sql.Add(' INNER JOIN ESPGER ON ESPGER.AUTOINCREM = ESPDET.DET_SEQGER ');
            qryEspGer.Sql.Add(' WHERE MOVGER.GER_NUMDOC = :NUMENT                        ');
            qryEspGer.Sql.Add('   AND MOVGER.GER_CODCLI = :CODCLI                        ');
            qryEspGer.Sql.Add('   AND MOVGER.GER_CODEMP = :CODEMP                        ');
            qryEspGer.Sql.Add('   AND MOVGER.GER_SERIE_ = :SERIE_                        ');
            qryEspGer.Sql.Add(' GROUP BY ESPGER.GER_NUMESP                               ');
          End;

          qryEspGer.ParamByName('NUMENT').AsString := strNumDocSel;
          qryEspGer.ParamByName('CODCLI').AsString := strCliForSel;
          qryEspGer.ParamByName('CODEMP').AsString := VS_strCodEmp;
          If (arrEspecies[intIndiceEsp][0] = 'NW') Then
          Begin
            If blnNW_Nfe Then
              qryEspGer.ParamByName('SERIE_').AsString := fCfgSis('SERFSC', VarString)
            Else
              qryEspGer.ParamByName('SERIE_').AsString := edtSerie.Text;
          End;

          qryEspGer.Open;

          If Not qryEspGer.IsEmpty Then
          Begin
            If (arrEspecies[intIndiceEsp][0] = 'GA') Then
            Begin
              If qryEspGer.FieldByName('GER_MOVGER').AsString <> '' Then
              Begin
                fMensagemCancelamento('', qryEspGer.FieldByName('DOCEMI').AsString);
                btnCancelar.Click;
                Exit;
              End;
              strIncEspGer := qryEspGer.FieldByName('AUTOINCREM').AsString;
            End
            Else
            Begin
              { Espelho Emitido para fornedor, mais ainda não foi confirmado }
              If (Not fEmptyStr(qryEspGer.FieldByName('AUTOINCREM').AsString)) And
                      fEmptyStr(qryEspGer.FieldByName('GER_MOVGER').AsString) Then
              Begin
                fMensagemCancelamento('', qryEspGer.FieldByName('DOCEMI').AsString);
                btnCancelar.Click;
                Exit;
              End;
            End;
          End;
        Finally
          FreeAndNil(qryEspGer);
        End;

      End;

      If (fCfgSis('OUSAFO', varString) = '2') And (Pos(arrEspecies[intIndiceEsp][0], 'OF_NG_') > 0) Then
      Begin

        Try
          qryEspGer := fCriaQuery;
          With qryEspGer, SQL Do
          Begin
            Close;
            Clear;
            Add(' SELECT E.GER_NUMESP, E.AUTOINCREM ');
            Add(' FROM MOVGER G ');
            Add('   INNER JOIN ESPGER E ON E.GER_MOVGER = G.AUTOINCREM ');
            Add(' WHERE G.GER_NUMDOC = :NUMDOC ');
            Add('   AND G.GER_ESPDOC = :ESPDOC ');
            Add('   AND G.GER_SERIE_ = :SERIE_ ');
            Add('   AND G.GER_CODFOR = :CODFOR ');
            Add('   AND G.GER_TIP_FC = "F"     ');

            ParamByName('NUMDOC').AsString := strNumDocSel;
            ParamByName('ESPDOC').AsString := 'NF';
            ParamByName('SERIE_').AsString := fCfgSis('SERFSC');
            ParamByName('CODFOR').AsString := strCliForSel;

            Open;

            If Not IsEmpty Then
            Begin
              strIncEspGer := FieldByName('AUTOINCREM').AsString;
              intRespostaEspelho := fMensagem('', 'O Documento a ser cancelado foi originado de um espelho, o que deseja fazer com o espelho?', ['Reabrir Espelho', 'Deletar Espelho'], 1, False,1, 155);
            End;

          End;

        Finally
          FreeAndNil(qryEspGer);
        End;
      End;

      If fCfgSis('UTLPRJ', varBoolean) And Pos(strEspSel, 'NF_NS_OR_PD_') > 0 Then
      Begin
        If SameText(strEspSel, 'NF') And fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF') Then
          strCodPrj := TProjeto.fProjetoDaVendaDevolvida(strNumDocSel, strEspSel, VS_strCodEmp)
        Else
          strCodPrj := TProjeto.fProjetoDaVenda(strNumDocSel, strEspSel, VS_strCodEmp);
      End;

      If (dtaDtaEntEstoque > 0) And (Not objFechamentoEstoque.fVeSeTravaFechamentoEstoque(traMovimentacao, dtaDtaEntEstoque)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      If (dtaDtaEntEstoque > 0) And (Not objFechamentoFiscal.fVeSeTravaFechamentoFiscal(trfMovimentacao, dtaDtaEntEstoque)) Then
      Begin
        btnCancelar.Click;
        Exit;
      End;

      if (fCfgSis('CONSIG', varBoolean)) and (strEspSel = 'ND') and (Not blnPedidoEntrada) then
      Begin
        if not TRetornoConsignacaoBuilder.fPermitidoCancelarNotaDevolucaoSimbolica(strNumDocSel, 'NF', VS_strCodEmp, strRetornoErro) then
        Begin
          fMensagemCancelamento('ATENÇÃO!', strRetornoErro, ['&Ok']);
          btnCancelar.Click;
          Exit;
        End;
      end;

      If (Pos(strEspSel, 'OR_PD_PR_') > 0) then
      begin
        if Not blnDocGarantiaPropriaEmpresa then
          blnDocGarantiaPropriaEmpresa := TGarantiaPropriaEmpresaCancelamento.fEhPedidoReposicaoGarantia(strNumDocSel, arrEspecies[intIndiceEsp][0], VS_strCodEmp);
        if Not blnDocGarantiaPropriaEmpresa  then
        begin
          if fVerificaSePDProvOR(strNumDocSel,
                                 strEspSel,
                                 VS_strCodEmp,
                                 strNumDocOR,
                                 strEspDocOR,
                                 strCodEmpOR,
                                 strCodCliOR) And
           (Not fEspeciesQuePodemSerProvenientesFataurmentoORPD(strEspSel)) Then
          Begin
            LblnPedidoProvenienteDeOrcamento := True;

            If (strEspDocOR <> 'PD') And
               (fMensagem('Atenção', 'O documento ' + strNumDocSel + '-' + strEspSel + ' foi originado a partir do documento: ' + strNumDocOR + '-' + strEspDocOR + '.' + #13#10 +
                          'Deseja cancelar o documento original? ', ['&Sim', '&Não']) = 1) Then
            begin
              LblnCancelarOrcamentoOriginalPedido := True;
              If Not fVerificaAcessoSistema('CANCOR') Then
                fMensagemCancelamento( 'ATENÇÃO', 'Usuário sem permissão para cancelar documentos da espécie OR.', ['&Ok']);
            end
            else
              LblnCancelarOrcamentoOriginalPedido := False;
          End;
        end;
      end;

      blnEhCancelamentoX929 := fEhCancelamentoX929(strNumDocSel, strCliForSel);

      SetLength(ArrayPedDevolucao, 0);

      If (Pos(strEspSel, 'NF_ND_') > 0) And fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF') Then
      Begin
        If fCfgSis('EXISTA', varBoolean) Then
          pProcessaArrayPedidosFatDevolucao(strNumDocSel, 'NF', strCliForSel);
      End
      Else If (Pos(strEspSel, 'DV_') > 0) And fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'DV') Then
      Begin
        If fCfgSis('EXISTA', varBoolean) Then
          pProcessaArrayPedidosFatDevolucao(strNumDocSel, 'DV', strCliForSel);
      End;

      If fTransferenciaDeSaidaJaTeveEntradaRealizada(strNumDocSel, strEspecieNFe, VS_strCodEmp, strCliForSel, IIF(SameText(strTipFc,'CODFOR'), 'F', 'C'), fRetSerFsc) Then
      Begin
        fRollBack;
        fMensagem('ATENÇÃO!', 'Transferência de saída já teve entrada realizada - Não é possível cancelar!', ['&OK']);
        Exit;
      End;

      If (Pos(strEspSel, fEspeciesComVinculoFiscal) > 0) And (Not fNotaFiscalDenegada(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'))) And (Not blnPegaDados) And (Not FNFSeSubstituicao) Then
      Begin
        If (blnNotaEletronica Or chkInutilizacao.Checked Or (fSatComIntegradorCitel(strEspecieNFe))) Then
        Begin
          If edtSerie.Visible Then
            strSerieCan := strSerieSel
          Else
            strSerieCan := strSerFsc;

          FillChar(LMotivoCancelamento, SizeOf(LMotivoCancelamento), #0);
          LMotivoCancelamento.CodigoMotivo := strMotDel;
          LMotivoCancelamento.DescricaoMotivo := strDesMot;
          LMotivoCancelamento.ComplementoDoHistorico := strHisCom;

          If (Not FLogCancelamento.GravaLogDeCancelamento(strAutIncLogCan,
                                                          edtNumDoc.Text,
                                                          strEspecieNFe,
                                                          VS_strCodEmp,
                                                          strSerieCan,
                                                          edtCliFor.Text,
                                                          IIF(SameText(strTipFc,'CODFOR'), 'F','C'),
                                                          LMotivoCancelamento,
                                                          arrEspecies[intIndiceEsp][0])) Then
          Begin
            fMensagem('ATENÇÃO!', 'Não foi possível cancelar o documento! Por favor, tente novamente.', ['&OK']);
            btnCancelar.Click;
            Exit;
          End;

          If (Not blnPermitiuCancelarComChaveAcessoDuplicada) And
             (fStatusNFe(strEspSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), blnDifChvAcesso) <> 'CN') Then
          Begin
            SetTexto('Enviando ' + IIF(chkInutilizacao.Checked,'inutilização', 'cancelamento') + ' de NFe...');
            Try
              If Not chkInutilizacao.Checked Then
              Begin
                If fSatComIntegradorCitel(strEspecieNFe) Then
                Begin
                  If (fEmptyStr(VS_NumSerSat)) Then
                  Begin
                    fMensagemCancelamento('ATENÇÃO!', 'Foi detectado o uso do "Integrador SAT Citel", porém não foi possível carregar o número de série do SAT, verifique o opcoes_sat.ini!', ['&OK']);
                    btnCancelar.Click;
                    Exit;
                  End;

                  If (Not fJaCancelouLogSat(strNumDocSel, strEspecieNFe, VS_strCodEmp, strSerieCan, strCliForSel, IIF(SameText(strTipFc,'CODFOR'), 'F','C'), VS_NumSerSat)) Then
                  Begin
                    If not fGravarLogSat(strNumDocSel, strEspecieNFe, VS_strCodEmp, strSerieCan, strCliForSel,
                                         IIF(SameText(strTipFc,'CODFOR'), 'F','C'), 'CN', VS_NumSerSat, fMotivoDelecao, VS_ImpressoraSat) Then
                    Begin
                      fMensagemCancelamento('ATENÇÃO!', 'Não foi possível enviar o cancelamento. (Gravação do LOGSAT setando status "CN")', ['&Ok']);
                      btnCancelar.Click;
                      Exit;
                    End;

                    If not fValidaCancelamentoSAT(strNumDocSel, strEspecieNFe, VS_strCodEmp, strSerieCan, strCliForSel,
                                                  IIF(SameText(strTipFc,'CODFOR'), 'F','C'), VS_NumSerSat) Then
                    Begin
                      fVoltaStatusAnterior(strNumDocSel, strEspecieNFe, VS_strCodEmp, strSerieCan, strCliForSel,
                                          IIF(SameText(strTipFc,'CODFOR'), 'F','C'), 'CN', VS_NumSerSat);

                      strMensagemErroSat := fCampoTabela('NFE_MENSAG', 'LOGSAT', ['NFE_NUMDOC', 'NFE_ESPDOC', 'NFE_CODEMP', 'NFE_CODCLI', 'NFE_SERIE_', 'NFE_NUMSER'],
                                                                          [strNumDocSel, strEspecieNFe, VS_strCodEmp, strCliForSel, strSerieCan, VS_NumSerSat]);

                      fMensagemCancelamento('ATENÇÃO!', 'Não foi possível enviar o cancelamento. (O integrador não processou o registro na LOGSAT)' + sLineBreak +
                                            IIF(fEmptyStr(strMensagemErroSat), '', 'Erro: ' + strMensagemErroSat), ['&Ok']);
                      btnCancelar.Click;
                      Exit;
                    End;
                  End;
                End
                Else If (Not fEnviarCancelamentoLibNfe(strNumDocSel, strEspecieNFe, VS_strCodEmp,
                  strSerieCan, strCliForSel,
                  IIF(SameText(strTipFc,'CODFOR'), 'F','C'), fMotivoDelecao, strErros)) Then
                Begin
                  If not fConfirmaCancelamentoLibNfe(strEspecieNFe, strErros) Then
                  Begin
                    If (fValidouIntegridadeDocumentoFiscal(strAutIncLogCan, strErros)) Then
                      strAutIncLogCan := ''
                    Else
                      pAtualizaLogDeCancelamento(strAutIncLogCan, False, False, False, True, strErros);
                    fMensagemCancelamento('ATENÇÃO!', 'Não foi possível enviar o cancelamento.'+#13+
                                                      IIF(strEspecieNFe = 'NF', strErros, ''), ['&Ok']);
                    btnCancelar.Click;
                    Exit;
                  End;
                End;
              End
              Else
              Begin
                if not CancelandoNFViaFulFillment then
                  pInutilizarNumeros(strNumDocSel, strSerieCan, fMotivoDelecao, IIF(pos(strEspSel, 'IF_IC_') > 0, 'IF', 'NF'));
              End;

              pAtualizaLogDeCancelamento(strAutIncLogCan, True, False, False, False, IIF(chkInutilizacao.Checked, 'Inutilização', 'Cancelamento') + ' na Sefaz concluído com sucesso.');

            Except
              On E: Exception Do
              Begin
                pAtualizaLogDeCancelamento(strAutIncLogCan, False, False, False, True, E.Message);
                fMensagemCancelamento('ATENÇÃO!', E.Message, ['&Ok']);
                btnCancelar.Click;
                Exit;
              End;
            End;
          End;
        End;
      End;

      pStepBy;

      fStartTransaction;

      If (Not fRetornaCashbackUtilizadoVenda(strNumDocSel, strEspSel, VS_strCodEmp)) Then
      Begin
        pAbortaCancelamento(strAutIncLogCan, 'Problema no retorna cashback utilizando venda');
        Exit;
      End;

      If (Not fCancelaCashbackGeradoVenda(strNumDocSel, strEspSel, VS_strCodEmp)) Then
      Begin
        pAbortaCancelamento(strAutIncLogCan, 'Problema no cancelamento do cashback');
        Exit;
      End;

      pGeraLogLiberacao(strNumDocSel, strEspSel, VS_strCodEmp);

      If FEhNotaDenegadaComCTe Then
      Begin
        If not fCancelarCTeDaNotaDenegada(strNumCTe, 'CT', strCodEmpCTE, strSerieCTe) Then
        Begin
          pAbortaCancelamento(strAutIncLogCan, 'Problemas no cancelamento do CTe da nota denegada.');
          Exit;
        End;
      End;

      If SameText(strEspSel, 'NF') Then
      Begin
        If not fCancelaEstornoNotaFiscal(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel) Then
        Begin
          pAbortaCancelamento(strAutIncLogCan, 'Problemas no cancelamento do estorno da nota fiscal.');
          Exit;
        End;
      End;

      If blnGnreDeSaidaApagaDuplicatasContasPagar Then
      Begin
        pGnreDeSaidaApagarDuplicatasContasPagar(strNumDocSel, strCliForSel, IIF(edtSerie.Visible, strSerieSel, strSerFsc));
      End;

      If (strEspSel = 'NF') And (strTipFc = 'CODCLI') Then
      Begin
        pCancelaNotaEspecialComplementarDeIPI(strNumDocSel, strEspSel, strCliForSel);
      End;

      {*REQ.148688**********RP*}
      If fExisteTransfAutomaticaDocVenda(strNumDocSel, strEspSel) Then
      Begin
        qryTemp01.First;
        While Not qryTemp01.Eof Do
        Begin
          fVerificaIntegridade(Self.Name, 'TRACAR', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
          qryTemp01.Delete;
        End;
      End;

      if fCfgSis('CONFFF', varBoolean) then
      Begin
        if not fExcluirVinculoMeiaNota(strNumDocSel, strEspSel, VS_strCodEmp) then
        Begin
          pAbortaCancelamento(strAutIncLogCan, 'Problemas ao limpar o relacionamento de meia-nota.');
          Exit;
        End;
      End;

      if fCfgSis('ESP_AD', varBoolean) then
        TGerarEspelhoDevolucaoAD.pApagarEspelhoGeradoPelaAD(strNumDocSel, strEspSel, VS_strCodEmp);

      if fCfgSis('CONSIG', varBoolean) then
      Begin
        if (strEspSel = 'ND') and (Not blnPedidoEntrada) then
          TRetornoConsignacaoBuilder.pCancelarDevolucaoSimbolica(strNumDocSel, 'NF', VS_strCodEmp, strCliForSel, strSerieSel)
        Else
          TRetornoConsignacaoBuilder.pLimparFaturamentoDevolucaoSimbolica(strNumDocSel, strEspSel, VS_strCodEmp);
      End;

      If (MatchStr(strEspSel, ['NF'])) And
         (Length(ArrayPedidos) > 0) Then
        pProcessaEstornoAdiantamentoPedidosFaturados;

      If (MatchStr(strEspSel,['PD'])) Then
      Begin
        LDocumentoVinculado := Nil;

        If (TFacadeCobrancaEletronica.fExisteAdiantamentoClienteCobrancaEletronica(
                     strNumDocSel, strEspSel, VS_strCodEmp, tcPagarMe)) Then
        Begin
          TFacadeCobrancaEletronica.pProcessaEstornoAdiantamento(
                                      strNumDocSel, strEspSel, VS_strCodEmp, tcPagarMe);
        End;

        If (Not fPermiteCancelarDocumentosContaOrdemRemessaContaOrdem(
                 strNumDocSel, strEspSel, LDocumentoVinculado, LNumDocRemessa,
                 LEspDocRemessa, LCodEmpRemessa, LCodCliRemessa,
                 LMen001Remessa)) Then
        Begin
          pAbortaCancelamento(strAutIncLogCan, 'Problema ao cancelar a remessa de Conta e Ordem.');
          Exit;
        End;

        If Assigned(LDocumentoVinculado) Then
        Begin
          Try
            If Not fCancelaItensOrcPed(LDocumentoVinculado.strEspDoc,
                                       LDocumentoVinculado.strNumDoc,
                                       LDocumentoVinculado.strCodCli) Then
            Begin
              pAbortaCancelamento(strAutIncLogCan, 'Problema ao cancelar documentos vinculados.');
              Exit;
            End;
          Finally
            FreeAndNil(LDocumentoVinculado);
          End;
        End;
      End;

      If fDeveGerarReservaEstoqueEnderecamentoPedidoOriginal Then
      Begin
        pDesfaturaItensPedidoOriginalParaGerarPedidoReserva(strNumDocSel, strEspSel, strCliForSel);

        blnResult := fGeraPedidoReservaEstoqueEnderecamentoPedidoOriginal(strNumDocSel, strEspSel);
        blnGerouEnderecamentoPDOri := blnResult;

        If not blnResult Then
          strMensagemDeErro := 'Problema ao gerar reserva de estoque de endereçamento.';
      End;

      pVerificaDocProvFatORPD(strEspSel, strNumDocSel, strCliForSel);

      If (Pos(strEspSel,'GF_NG_') > 0) Then
        blnResult := fDeletaBaixaRealizadaEnvioDevolucao(strEspSel, strNumDocSel, strCliForSel, ArrayOfTMovGauCancelado);

      If (strTipFc = 'CODCLI') And (fCfgSis('UTINPS', varBoolean)) Then
        TNetpoints.pCancelarNetpoints(strNumDocSel, strEspSel, VS_strCodEmp,
          strCliForSel, IIF(Pos(strEspSel, 'OR_PD_') > 0, '', IIF(edtSerie.Visible, strSerieSel, strSerFsc)),
          Self.Name, fMotivoDelecao, '');

      if (pos(strEspSel,ESPECIE_RETORNO_COLETA_GARANTIA) > 0) then
      begin
        blnResult := fCancelarRetornoColeta(strEspSel, strNumDocSel, VS_strCodEmp);

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar retorno de coleta garantia.';
      end;

      {*******************************************}
      {* CASO SEJA EMPRESTIMO                    *}
      {****************************************LA*}
      If ( Pos( strEspSel, 'EP' ) > 0 ) Then
      Begin
        blnResult := fCancelaItensDocumento(strEspSel, strNumDocSel, strCliForSel);
                   // And  fApagaEmprestimo(strEspSel, strNumDocSel, strCliForSel);

        If not blnResult Then
          strMensagemDeErro := 'Problema no cancelamento de empréstimo';
      End

      {*******************************************}
      {* CASO SEJA BAIXA DE EMPRESTIMO           *}
      {****************************************PZ*}
      Else If ( Pos( strEspSel, 'BE' ) > 0 ) Then
      Begin
        blnResult := fAtualizaQtdeBaixaEmprestimo(strEspSel,strNumDocSel,strCliForSel);

        If (blnResult) Then
          blnResult := fCancelaItensDocumento(strEspSel, strNumDocSel, strCliForSel);

        If not blnResult Then
          strMensagemDeErro := 'Problema na baixa de empréstimo';
      End

      {*******************************************}
      {* CASO SEJA BAIXA DE CONHECIMENTO TRANSP. *}
      {****************************************WS*}
      else if (strEspSel = 'CT') then
      begin
        blnResult := fCancelaCTeLivroFiscal(strNumDocSel, edtSerie.Text);

        if blnResult then
          blnResult := fCancelaContasReceber(strEspSel, strNumDocSel, strClienteCTe, VS_strCodEmp);

        if blnResult then
          blnResult := fCancelaContasPagar(strEspSel, strEspSel, strNumDocSel, strFornecedorCTe, edtSerie.Text);

        if blnResult then
          blnResult := fCancelaCTE(RightStr(strNumDocSel, 9), edtSerie.Text, VS_strCodEmp);

        if blnResult then
          blnResult := fAtualizaStatusCTe('CC');

        if blnResult then
        begin
          If not FCancelarCTeViaBanco Then
            blnResult := fEnviarCancelamentoConhecimento(RightStr(strNumDocSel, 9), fMotivoDelecao, fRetNomeOperador(strLoginUsuarioLogado));

          if blnResult then
            imgItensNota.Picture := imgAlterado.Picture;
        end;

        If not blnResult Then
          strMensagemDeErro := 'Problema ao cancelar conhecimento de transporte';
      end

      {*******************************************}
      {* CASO SEJA NOTA FISCAL                   *}
      {****************************************MV*}
      Else If ( Pos( strEspSel, 'NF_EL_NS_IF_IV_D1_NI_NC_IC_DC_' ) > 0 ) Then
      Begin
        if (Pos( strEspSel, 'NF_' ) > 0) then
        begin
          blnResult := Not TGarantiaPropriaEmpresaCancelamento.fEhDocumentoPerdaComSaidaVinculado(strNumDocSel, strEspSel, VS_strCodEmp);
        end
        else
          blnREsult := True;

        if blnResult then
        begin
          if TGarantiaPropriaEmpresaCancelamento.fDocumentoFiscalComOrigemGarantiaPropriaEmpresa(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel) then
          begin
            blnDocGarantiaPropriaEmpresa := True;
            blnResult := TGarantiaPropriaEmpresaCancelamento.fRefazAvalizacaoGarantiaPropriaEmpresa(strNumDocSel, strEspSel, strCliForSel, VS_strCodEmp);
          end
          else
            blnResult := True;
        end;

        if blnResult then
        begin

          If (blnResult) And (fCfgSis('MONFAS', varBoolean)) Then
            blnResult := fCancelaBaixaOrdemProducao(strEspSel, strNumDocSel, strCliForSel);

          If (Not blnPedidoCompraBaixado) Then
          Begin

           If (Not blnEhNFDevolucaoClientesPorOutrasEntradas) And (fUsaRotinaWMS Or fCfgSis('DEVEND', varBoolean)) Then
             blnEhNFDevolucaoClientesPorOutrasEntradas := (SameText(strEspSel, 'NF')) And (fEhNFDevolucaoClientesPorOutrasEntradas(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF'));

            blnEhNFDevolucao := SameText(strEspSel, 'NF') And fEhNFDevolucao(strNumDocSel, fRetTipPes('C'), fRetSerFsc, VS_strCodEmp, 'NF');

           blnEhDocumentoConsignado := fConsignacaoFechouEmNota(strNumDocSel, strEspSel, strCliForSel);
           blnRetornoRemessa := fCancelarPedidoDeReservaDeEstoqueParaRetornoDeRemessa(strNumDocSel, strEspSel, strCliForSel);

            {*******************************************}
            {* MODO DE CANCELAMENTO CONVENCIONAL.      *}
            {****************************************MV*}
            If Pos(strEspSel, 'IF_IV_D1_') > 0 Then
              blnResult := True
            Else
            Begin
              blnResult := True;

              If Pos(strEspSel, 'NS_') > 0 Then
                blnCancNFeOK := fMarcarNFeComoCancelada(strNumDocSel, strEspSel, VS_strCodEmp, strCliForSel);
            End;

            If (blnResult) And
               (fCfgSis('PROCTR') = '1') And
               (fCfgSis('AGDPIF') = 'S') Then
            Begin
              blnResult := fDesagruparFinaneiroDeConfirmacaoDeCupomFiscal(
                            strNumDocSel, strEspSel, VS_strCodEmp);

              If Not blnResult Then
              Begin
                strMensagemDeErro := 'Problema ao cancelar nota fiscal com agrupamento financeiro das confirmações de Cupons Fiscais';
                fMensagemCancelamento('ATENÇÃO!', 'Não foi possível desagrupar as duplicatas. Entre em contato com a Citel!', ['&Ok']);
              End;
            End;


            {Coleta}
            If (blnResult) And (blnEhNFDevolucao) And (fEhDevolucaoDeColetaPorGarantia(strEspSel, strNumDocSel, strCliForSel, edtSerie.Text,
                                                                                       strCreditoNumDup, strCreditoEspDoc, strCreditoCodEmp, strCreditoCodCli,
                                                                                       blnTemCreditoDeColetaPorGarantia )) Then
              blnResult := fCancelarPedidoColeta(strEspSel, strNumDocSel, strCliForSel, edtSerie.Text);

            If (blnResult) And fUsaRotinaWMS then  {implementado conforme a versão 40.5 }
                blnResult := fVerificaTAPendente(strNumDocSel, strCliForSel, strSerieSel, strEspSel, '', True);

            If (blnResult) Then
              blnResult := fCancelaBaixaFutura(strNumDocSel, strEspSel, strCliForSel);

            pStepBy;

            blnDocumentoEmitidoPorRegimeEspecial := False;

            If (blnResult) Then
            Begin
              blnDocumentoEmitidoPorRegimeEspecial := fDocumentoEmitidoPorRegimeEspecial(strNumDocSel, strEspSel, strCliForSel);

              If blnDocumentoEmitidoPorRegimeEspecial Then
                strCliFat := fRetornaCliFatDocConfirmacao(strNumDocSel, strEspSel, strCliForSel)
              Else
                strCliFat := fRetornaCliFat(strNumDocSel, strEspSel, strCliForSel);

              If (strEspSel = 'NI') Then
              Begin

                If (blnResult) Then
                  blnResult := fCancelaLivroFiscal('NF', strNumDocSel, strCliForSel, strSerFsc, strIncFis);

                If (blnResult) Then
                  blnResult := fCancelaItensDocumento('NF', strNumDocSel, strCliForSel);

                If (blnResult) Then
                  blnResult := fDesmarcaPedidoCompra('NF', strNumDocSel, strCliForSel);
              End
              Else
              Begin
                // Caso For nota fiscal, e usa wms, é preciso passar a instancia do obj de endereçamento
                //para endereçar os itens cancelados. para voltar para o estoque. Hidromar 09-11-16 (req. 47697);
                If (Pos(strEspSel, 'NF_IF_' ) > 0) And fUsaRotinaWMS And (Not blnEhNFDevolucao) And (Not blnEhNFDevolucaoClientesPorOutrasEntradas) Then
                  blnResult := fCancelaItensDocumento(strEspSel, strNumDocSel, strCliForSel, '',
                                                      fRetornaObjEnderecamentoDoc(strEspSel, strNumDocSel, strCliForSel, strSerFsc, IIf(strTipFc = 'CODFOR', 'F','C')))
                Else
                  blnResult := fCancelaItensDocumento(strEspSel, strNumDocSel, strCliForSel);
              End;

            End;

            If (blnResult) And ((blnEhNFDevolucao) Or (blnEhNFDevolucaoClientesPorOutrasEntradas) Or (blnEhDocumentoConsignado) Or blnRetornoRemessa) Then
              blnResult := fCancelaPedidoDeReserva('NF', strNumDocSel, strCliForSel, fRetSerFsc, fRetTipPes('C'));

            If (blnResult) And SameText(strEspSel, 'NF') Then
              blnResult := fCancelaContasPagarUC(strEspSel, strNumDocSel, strCliForSel);

            pStepBy;

            If (blnResult) Then
            Begin
              If blnDocumentoEmitidoPorRegimeEspecial Then
                blnResult := fCancelaItensFaturado(strEspSel, strNumDocSel, IIF(fEmptyStr(strCliFat), strCliForSel, strCliFat), 'CODCLI')
              Else
                blnResult := fCancelaItensFaturado(strEspSel, strNumDocSel, IIF(fEmptyStr(strCliFat), strCliForSel, strCliFat));
            End;

            pStepBy;

            If (blnResult) Then
              blnResult := fCancelaContasReceber(fRetornaEspecie, strNumDocSel, strCliForSel, VS_strCodEmp);

            {Crédito Gerado na Coleta}
            If (blnResult) And (blnTemCreditoDeColetaPorGarantia) Then
              blnResult := fCancelaContasReceber(strCreditoEspDoc, strCreditoNumDup, strCreditoCodCli, strCreditoCodEmp);

            pStepBy;

            If (blnResult) Then
              blnResult := fCancelaContasPagarServ(strEspSel, strNumDocSel, strCliForSel);

            pStepBy;

            If (blnResult) And (Not blnApagPed) Then
              blnResult := fVoltaCtrConfirmacao(strEspSel, strNumDocSel, strCliForSel);

            pStepBy;

            If (blnResult) Then
              blnResult := fApagaDocumentoRomaneio(strNumDocSel, strEspSel, strCliForSel);

            If (blnResult) And (VS_strTipExp = '5') Then
              blnResult := fDesfaturaDocumentoRomaneio(strNumDocSel, strEspSel, VS_strCodEmp);

            pStepBy;

            If (blnResult) Then
              blnResult := fDesfaturaPedidoVendaOuOrcamento(strEspSel, strNumDocSel, strCliForSel, '', False);

            If (blnResult) Then
              blnResult := fDesfaturarAjustesConfirmados(strEspSel, strNumDocSel, strCliForSel);

            pStepBy;

            {*******************************************}
            {* CANCELA PEDIDO DE COMPRA                *}
            {****************************************MV*}
            If (blnResult) And (fSuportaInterfaceGrafica) Then
              blnResult := fCancelaPedidoCompra(qryAux001.FieldByName('PCG_NUMPED').AsString);
          End;
        end;

        If ( Pos( strEspSel, 'NS_NF_' ) > 0 ) And
           ( fCfgSis('LOCEQU', VarBoolean) ) Then
        Begin

          If DocumentoEmitidoPelaLocacaoEquipamentos(strEspSel, strNumDocSel) Then
          Begin
