function TfrmCancelamentoDocumentos.fValidaCancelamentoSAT(strNumDoc, strEspDoc, strCodEmp, strSerie, strCodCli, strTip_FC, strNumSer: String): Boolean;
  Var
    LVerificar: Boolean;
    LTentativas: Integer;
begin
  Result := False;

  LVerificar  := False;
  LTentativas := 0;

  While not LVerificar Do
  Begin
    Result := fSATCancelado(strNumDoc, strEspDoc, strCodEmp, strSerie, strCodCli, strTip_FC, strNumSer);

    If Result Then
      LVerificar := True;

    If LTentativas >= 20 Then
      LVerificar := True;

    Inc(LTentativas);

    If not Result Then
      Sleep(1000);

    Application.ProcessMessages;
  End;
end;

function TfrmCancelamentoDocumentos.fEhNotaDeImportacao(AStrNumdoc, AStrSerie, AStrCodFor: String): Boolean;
var
  qryRes: TUniQuery;
begin
  qryRes := fCriaQuery;
  Try
    qryRes.SQL.Clear;
    qryRes.SQL.Add('SELECT * FROM DOCIMP');
    qryRes.SQL.Add(' WHERE IMP_OLDNTD IN (SELECT AUTOINCREM');
    qryRes.SQL.Add('                        FROM NOTDET');
    qryRes.SQL.Add('                       WHERE DET_NUMDOC = :NUMDOC');
    qryRes.SQL.Add('                         AND DET_ESPDOC = "NF"');
    qryRes.SQL.Add('                         AND DET_SERIE_ = :SERIE_');
    qryRes.SQL.Add('                         AND DET_CODFOR = :CODFOR');
    qryRes.SQL.Add('                         AND DET_CODEMP = :CODEMP)');

    qryRes.ParamByName('NUMDOC').AsString := AStrNumDoc;
    qryRes.ParamByName('SERIE_').AsString := AStrSerie;
