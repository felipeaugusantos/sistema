procedure TfrmCancelamentoDocumentos.pRestauraMovGad(strNumDoc: string; dtaDoc: TDate);
var qryRest: TUniQuery;
begin
  qryRest := fCriaQuery;
  Try
    qryRest.SQL.Add('UPDATE  MOVGAD');
    qryRest.SQL.Add('INNER JOIN MOVDET ON DET_CODITE = GAD_CODITE');
    qryRest.SQL.Add('                  AND DET_NUMDOC = GAD_NUMRET');
    qryRest.SQL.Add('                  AND DET_DTADOC = GAD_DTARET');
    qryRest.SQL.Add(' SET GAD_QTDRET = IF((GAD_QTDRET - DET_QTDITE) < 0, 0, (GAD_QTDRET - DET_QTDITE)), GAD_MOTBAI = NULL');
    qryRest.SQL.Add('WHERE GAD_NUMRET = :NUMRET');
    qryRest.SQL.Add('AND GAD_DTARET = :DTARET');

    qryRest.ParamByName('NUMRET').AsString := strNumDoc;
    qryRest.ParamByName('DTARET').AsDateTime := dtaDoc;

    qryRest.ExecSQL;
  Finally
    FreeAndNil(qryRest);
  End;
end;


function TfrmCancelamentoDocumentos.fExecutaSqlGenerico(aProcQry: TProcQry): Boolean;
Var
  QryAux: TUniQuery;
begin
  Try
    Try
      QryAux := fCriaQuery();
      QryAux.Close;
      QryAux.Sql.Clear;
      //método anônimo
      aProcQry(QryAux);
      QryAux.ExecSql;
      Result := True;
    Except
      On E: Exception do
      begin
        Result := False;
      end;
    End;
  Finally
    if Assigned(QryAux) then
    begin
      FreeAndNil(QryAux);
    end;
  End;
end;

function TfrmCancelamentoDocumentos.fScriptAtualizaMovGADQuandoCancelamentoGau: String;
Var
  strSql: String;
begin
  strSql := 'UPDATE MOVGAD ';
  strSql := strSql + 'SET MOVGAD.GAD_QTDRET = (MOVGAD.GAD_QTDRET - (%s)) ';
  strSql := strSql + ' WHERE MOVGAD.AUTOINCREM = :AUTINCGAD ';
  Result := Format(strSql,[fScriptObterQtdRetGae]);
end;

function TfrmCancelamentoDocumentos.fScriptObterQtdRetGae: String;
begin
  Result := 'SELECT GAE_QTDRET ';
  Result := Result + 'FROM MOVGAE ';
  Result := Result + 'WHERE MOVGAE.AUTOINCREM = :AUTINCGAE ';
end;

function TfrmCancelamentoDocumentos.fAtualizaMovGadQuandoCancelamentoGau(Const strAutIncGad, strAutIncGae: String;  Const ArrayOfTMovGauCancelado: TArrayOfTMovGauCancelado): Boolean;
Var
  aItem: TMovGauCancelado;
  blnLocalizado: Boolean;
  i: Integer;
begin
  Result := Length(ArrayOfTMovGauCancelado) = 0;

  if Result then
    Exit(Result);   //retorna verdadeiro quando o conjunto estiver matriz.

  blnLocalizado := False;

  for I := Low(ArrayOfTMovGauCancelado) to High(ArrayOfTMovGauCancelado) do
  begin
    aItem := ArrayOfTMovGauCancelado[i];

    if (aItem.strSeqGad = strAutIncGad) then
    begin
      if (aItem.strSeqGae = strAutIncGae)  then
      begin
        blnLocalizado := True;
      end;
    end;

    if blnLocalizado then
      Break;
  end;

  if Not blnLocalizado then
  begin
    Exit(True)
  end;

  Result := fExecutaSqlGenerico(procedure(Var aQry: TUniQuery)
                                begin
                                  aQry.Sql.Add(fScriptAtualizaMovGADQuandoCancelamentoGau);
                                  aQry.ParamByName('AUTINCGAE').AsString := aItem.strSeqGae;
                                  aQry.ParamByName('AUTINCGAD').AsString := aItem.strSeqGad;
                                end);

end;

function TfrmCancelamentoDocumentos.fPedidoPossuiItensEmSemparacao(strEspSel, strNumDocSel, strCliForSel: String): Boolean;
var
  qryAux: TUniQuery;
begin
  if not (strEspSel = 'PD') then
    Exit(False);

  qryAux := fCriaQuery();
  Try
    qryAux.SQL.Text := 'SELECT SQL_NO_CACHE COUNT(1) AS QTDE                             '+
                       '  FROM                                                           '+
                       '  (                                                              '+
                       '  SELECT IF((SUM(FD.FDO_QTDITE) - SUM(FD.FDO_QTDBAI))            '+
                       '            = SUM(ED.FDO_QTDEXP), "S", "N") AS EXPTOT            '+
                       '    FROM FATGOR FG                                               '+
                       '    JOIN FATDOR FD ON FD.FDO_NUMDOC = FG.FGO_NUMDOC              '+
                       '                  AND FD.FDO_ESPDOC = FG.FGO_ESPDOC              '+
                       '                  AND FD.FDO_CODEMP = FG.FGO_CODEMP              '+
                       '                  AND FD.FDO_CODCLI = FG.FGO_CODCLI              '+
                       '                  AND FD.FDO_JAFATU = 0                          '+
                       '    JOIN EXTDOR ED ON FD.AUTOINCREM = ED.FDO_SEQFDO              '+
                       '   WHERE FG.FGO_NUMDOC = :NUMDOC                                 '+
                       '     AND FG.FGO_ESPDOC = :ESPDOC                                 '+
                       '     AND FG.FGO_CODEMP = :CODEMP                                 '+
                       '     AND FG.FGO_CODCLI = :CODCLI                                 '+
                       '     AND IF(FG.FGO_SEPIMP = "N" OR IFNULL(FG.FGO_SEPIMP,"") = "",'+
                       '           "0",                                                  '+
                       '           IF(FG.FGO_SEPIMP = "S",                               '+
                       '              "1",                                               '+
                       '              FG.FGO_SEPIMP)) <> "0"                             '+
                       '   GROUP BY FGO_NUMDOC, FGO_ESPDOC, FGO_CODEMP                   '+
                       '   ) TMP                                                         '+
                       '  WHERE TMP.EXPTOT = "N"                                         ';

    qryAux.ParamByName('NUMDOC').AsString := strNumDocSel;
    qryAux.ParamByName('ESPDOC').AsString := strEspSel;
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCliForSel;
    qryAux.Open;

    Result := (qryAux.FieldByName('QTDE').AsInteger > 0);
  Finally
    FreeAndNil(qryAux);
  End;
end;

procedure TfrmCancelamentoDocumentos.pExibirAvisoAbastecimentoDeposito(const strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
var
  strSql: String;
  strObs: String;
  qrySelect: TUniQuery;
begin
  strSql := '';
  strObs := '';

  strSql := strSql + ' SELECT GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI, GER_CODFOR';
  strSql := strSql + '   FROM MOVGER';
  strSql := strSql + '  INNER JOIN AUXMOV ON MOVGER.AUTOINCREM = AUX_SEQGER';
  strSql := strSql + '  WHERE AUX_DOCABA = :DOCABA';
  strSql := strSql + '    AND AUX_ESPABA = :ESPABA';
  strSql := strSql + '    AND AUX_EMPABA = :EMPABA';
  strSql := strSql + '    AND AUX_CLIABA = :CLIABA';

  qrySelect := fCriaQuery();
  try
    qrySelect.SQL.Text := strSql;
    qrySelect.ParamByName('DOCABA').AsString := strNumDoc;
    qrySelect.ParamByName('ESPABA').AsString := strEspDoc;
    qrySelect.ParamByName('EMPABA').AsString := strCodEmp;
    qrySelect.ParamByName('CLIABA').AsString := strCodCli;

    qrySelect.Open;
    if qrySelect.IsEmpty then
      Exit;

    strObs := strObs + '.----------------------------------------------------------.' + sLineBreak;
    strObs := strObs + '| Documento    | Espécie | Empresa | Cliente  | Fornecedor |' + sLineBreak;
    strObs := strObs + '|----------------------------------------------------------|' + sLineBreak;

    while not qrySelect.Eof do
    begin
      strObs := strObs + '| ' + qrySelect.FieldByName('GER_NUMDOC').AsString;
      strObs := strObs + ' |    ' + qrySelect.FieldByName('GER_ESPDOC').AsString + '  ';
      strObs := strObs + ' |   ' + qrySelect.FieldByName('GER_CODEMP').AsString + '  ';
      strObs := strObs + ' | ' + qrySelect.FieldByName('GER_CODCLI').AsString.PadLeft(8);
      strObs := strObs + ' |  ' + qrySelect.FieldByName('GER_CODFOR').AsString.PadLeft(8) + '  |';
      strObs := strObs + sLineBreak;

      qrySelect.Next;
    end;

    strObs := strObs + '.----------------------------------------------------------.';
  finally
    FreeAndNil(qrySelect);
  end;

  pCriarFormularios(TfrmObservacao, frmObservacao);
  try
    frmObservacao.Width := 500;
    frmObservacao.lblMensagem.Caption :=
      'ATENÇÃO! Esta venda possui documentos de transferência relacionados que foram gerados através da rotina automática para o' +
      ' depósito. Verifique se será preciso realizar o cancelamento destes documentos também.';
    frmObservacao.memObs.Font.Name := 'Courier New';
    frmObservacao.memObs.Texto := strObs;
    If FExecutandoCanceladorAutomatico Then
      pMensagemOK(frmObservacao.lblMensagem.caption + slIneBreak + strObs)
    Else
      frmObservacao.ShowModal;
  finally
    pFreeAndNil(frmObservacao);
  end;
end;

function TfrmCancelamentoDocumentos.fVerificaDocEntradaAbastecimento(const strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
var
  strSql: String;
  qrySelect: TUniQuery;
  qryAbaDep: TUniQuery;
begin
  Result := True;

  strSql := '';
  strSql := strSql + ' SELECT AUX_DOCABA, AUX_ESPABA, AUX_EMPABA, AUX_CLIABA, GER_CLAFIS';
  strSql := strSql + '   FROM MOVGER';
  strSql := strSql + '  INNER JOIN AUXMOV ON MOVGER.AUTOINCREM = AUX_SEQGER';
  strSql := strSql + '  WHERE GER_NUMDOC = :NUMDOC';
  strSql := strSql + '    AND GER_ESPDOC = :ESPDOC';
  strSql := strSql + '    AND GER_CODEMP = :CODEMP';
  strSql := strSql + '    AND GER_CODCLI = :CODCLI';

  qrySelect := fCriaQuery();
  try
    qrySelect.SQL.Text := strSql;
    qrySelect.ParamByName('NUMDOC').AsString := strNumDoc;
    qrySelect.ParamByName('ESPDOC').AsString := strEspDoc;
    qrySelect.ParamByName('CODEMP').AsString := strCodEmp;
    qrySelect.ParamByName('CODCLI').AsString := strCodCli;

    qrySelect.Open;
    if qrySelect.IsEmpty or
       fEmptyStr(qrySelect.FieldByName('AUX_DOCABA').AsString) or
       (LeftStr(qrySelect.FieldByName('GER_CLAFIS').AsString, 1) < '5') then
      Exit;

    strSql := '';
    strSql := strSql + ' SELECT GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI, GER_CODFOR';
    strSql := strSql + '   FROM MOVGER';
    strSql := strSql + '  INNER JOIN AUXMOV ON MOVGER.AUTOINCREM = AUX_SEQGER';
    strSql := strSql + '  WHERE AUX_DOCABA = :DOCABA';
    strSql := strSql + '    AND AUX_ESPABA = :ESPABA';
    strSql := strSql + '    AND AUX_EMPABA = :EMPABA';
    strSql := strSql + '    AND AUX_CLIABA = :CLIABA';
    strSql := strSql + '    AND LEFT(GER_CLAFIS,1) < 5';

    qryAbaDep := fCriaQuery();
    try
      qryAbaDep.SQL.Text := strSql;
      qryAbaDep.ParamByName('DOCABA').AsString := qrySelect.FieldByName('AUX_DOCABA').AsString;
      qryAbaDep.ParamByName('ESPABA').AsString := qrySelect.FieldByName('AUX_ESPABA').AsString;
      qryAbaDep.ParamByName('EMPABA').AsString := qrySelect.FieldByName('AUX_EMPABA').AsString;
      qryAbaDep.ParamByName('CLIABA').AsString := qrySelect.FieldByName('AUX_CLIABA').AsString;

      qryAbaDep.Open;
      if qryAbaDep.IsEmpty then
        Exit;

      fMensagemCancelamento('ATENÇÃO!',
        'O documento informado não pode ser cancelado pois a transferência de entrada que está ligada a este ainda não foi' +
        ' cancelada. Cancele primeiro a transferência ' + qryAbaDep.FieldByName('GER_NUMDOC').AsString + ' do fornecedor ' +
        qryAbaDep.FieldByName('GER_CODFOR').AsString + ' na empresa ' + qryAbaDep.FieldByName('GER_CODEMP').AsString +
        ' e depois realize o cancelamento desta saída.', ['&Ok']);
      Result := False;
    finally
      FreeAndNil(qryAbaDep);
    end;

  finally
    FreeAndNil(qrySelect);
  end;

end;

function TfrmCancelamentoDocumentos.fRetAutIncMovGer(const strNumDoc, strEspDoc, strCliFor,
  strSerie: String): String;
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);
  try
    qryAux.SQL.Add('SELECT ');
    qryAux.SQL.Add('  AUTOINCREM ');
    qryAux.SQL.Add('FROM MOVGER ');
    qryAux.SQL.Add('WHERE GER_NUMDOC = :NUMDOC');
    qryAux.SQL.Add('  AND GER_CODEMP = :CODEMP');

    If (fEmptyStr(strSerie)) Then
      qryAux.SQL.Add('  AND ((GER_SERIE_ IS NULL) OR (GER_SERIE_ = ""))')
    Else
      qryAux.SQL.Add('  AND GER_SERIE_ = :SERIE_');

    if (not fEmptyStr(strCliFor)) then
      qryAux.SQL.Add('  AND GER_CODFOR = :CODFOR');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('CODEMP').AsString := IIF(strEspDoc <> 'CT', VS_strCodEmp, strEmpCliCTe);

    If (Not fEmptyStr(strSerie)) Then
      qryAux.ParamByName('SERIE_').AsString := strSerie;

    if (not fEmptyStr(strCliFor)) then
      qryAux.ParamByName('CODFOR').AsString := strCliFor;
    qryAux.Open;

    Result := qryAux.FieldByName('AUTOINCREM').AsString;

    qryAux.Close;
  finally
    FreeAndNil(qryAux);
  end;
end;

procedure TfrmCancelamentoDocumentos.pVerificarCadPagBaixadoFunrural();
Var
  qryAux: TUniQuery;
begin
  if Not Assigned(lstCtpBaixadas) then
    Exit;

  if fEmptyStr(strAutIncMovGer) then
    Exit;

  qryAux := fCriaQuery(Self);
  try
    qryAux.SQL.Add('SELECT ');
    qryAux.SQL.Add('  CTP_NUMDUP, ');
    qryAux.SQL.Add('  CTP_PARCEL, ');
    qryAux.SQL.Add('  CTP_CODEMP, ');
    qryAux.SQL.Add('  CTP_CODFOR  ');
    qryAux.SQL.Add('FROM CADPAG ');
    qryAux.SQL.Add('WHERE CTP_SEQRFR = :SEQRFR');
    qryAux.SQL.Add('  AND CTP_DTAPAG IS NOT NULL');

    qryAux.ParamByName('SEQRFR').AsString := strAutIncMovGer;

    qryAux.Open;

    While (Not qryAux.Eof) Do
    Begin
      lstCtpBaixadas.Add(qryAux.FieldByName('CTP_NUMDUP').AsString +
                 qryAux.FieldByName('CTP_PARCEL').AsString + ' Loja: ' +
                 qryAux.FieldByName('CTP_CODEMP').AsString);
      qryAux.Next;
    End;

    qryAux.Close;
  finally
    FreeAndNil(qryAux);
  end;
end;

function TfrmCancelamentoDocumentos.fCancelaContasPagarFunrural(): Boolean;
  Var
    intRecordCount: Integer;
    strArqCtpDet  : String;

    strSQL   : String;
    strDupDel: String;
    strArqCtp: String;
    blnDupPar: Boolean;
    qryGenTmp: TUniQuery;

begin
  if fEmptyStr(strAutIncMovGer) then
    Exit(True);

  qryGenTmp := fCriaQuery(Self);

  Try
    Result := True;
    strDupDel    := '';

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM CADPAG ';
    strSQL := strSQL + 'WHERE CTP_SEQRFR = :SEQRFR ';
    strSQL := strSQL + ' ORDER BY AUTOINCREM, CTP_CODFOR, CTP_CODEMP ';

    With qryTemp01 Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('SEQRFR').AsString := strAutIncMovGer;

      Open;
      intRecordCount := RecordCount;

      lstCtpBaixadas.Clear;

      While (Not Eof) Do
      Begin

        blnDupPar := fCtpBaixadaParcial(qryTemp01);

        If (FieldByName('CTP_VALDUP').AsFloat = 0) Or (blnDupPar) Then
        Begin

          lstCtpBaixadas.Add(FieldByName('CTP_NUMDUP').AsString +
                             FieldByName('CTP_PARCEL').AsString + ' Loja: ' +
                             FieldByName('CTP_CODEMP').AsString);
          Next;
          Continue;
        End;

        strArqCtp    := 'CADPAG';
        strArqCtpDet := 'CTPDET';

        {*******************************************}
        {* SELECIONA O REGISTRO NO CTPDET PARA SER *}
        {* GRAVADO NOS DELETADOS                   *}
        {****************************************MV*}
        strSQL := '';
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  * ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL + strArqCtpDet + ' ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  CTP_NUMDUP = :NUMDUP AND ';
        strSQL := strSQL + '  CTP_PARCEL = :PARCEL AND ';

        If (FieldByName('CTP_SERIE_').IsNull) Then
          strSQL := strSQL + ' ((CTP_SERIE_ IS NULL) OR (CTP_SERIE_ = "")) AND '
        Else
          strSQL := strSQL + '  CTP_SERIE_ = :SERIE_ AND ';

        strSQL := strSQL + '  CTP_CODFOR = :CODFOR AND ';
        strSQL := strSQL + '  CTP_CODEMP = :CODEMP ';

        qryTemp02.Close;
        qryTemp02.SQL.Clear;
        qryTemp02.SQL.Add(strSQL);
        qryTemp02.ParamByName('NUMDUP').AsString := FieldByName('CTP_NUMDUP').AsString;
        qryTemp02.ParamByName('PARCEL').AsString := FieldByName('CTP_PARCEL').AsString;

        If (Not FieldByName('CTP_SERIE_').IsNull) Then
          qryTemp02.ParamByName('SERIE_').AsString := FieldByName('CTP_SERIE_').AsString;

        qryTemp02.ParamByName('CODFOR').AsString := FieldByName('CTP_CODFOR').AsString;
        qryTemp02.ParamByName('CODEMP').AsString := FieldByName('CTP_CODEMP').AsString;
        qryTemp02.Open;

        While (Not qryTemp02.Eof) Do
        Begin
          fVerificaIntegridade(Self.Name, strArqCtpDet, qryTemp02, True, False, EmptyStr, fOperadorDoCancelamento);
          qryTemp02.Next;
        End;

        untLogCtp.GravaLogCtp(FieldByName('AUTOINCREM').AsString, 'EXCLUSAO', Self.Name);

        qryTemp02.Close;

        {*******************************************}
        {* MONTA O WHERE DO DELETE                 *}
        {****************************************MV*}
        strDupDel := strDupDel + ' ( CTP_NUMDUP = ' + QuotedStr(FieldByName('CTP_NUMDUP').AsString) + ' AND ';
        strDupDel := strDupDel + '   CTP_PARCEL = ' + QuotedStr(FieldByName('CTP_PARCEL').AsString) + ' AND ';

        If (FieldByName('CTP_SERIE_').IsNull) Then
          strDupDel := strDupDel + '   IFNULL(CTP_SERIE_, "") = "" AND '
        Else
          strDupDel := strDupDel + '   CTP_SERIE_ = ' + QuotedStr(FieldByName('CTP_SERIE_').AsString) + ' AND ';

        strDupDel := strDupDel + '   CTP_CODFOR = ' + QuotedStr(FieldByName('CTP_CODFOR').AsString) + ' AND ';
        strDupDel := strDupDel + '   CTP_CODEMP = ' + QuotedStr(FieldByName('CTP_CODEMP').AsString) + ') ';

        fVerificaIntegridade(Self.Name, strArqCtp, qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);

        If (RecNo < intRecordCount) Then
          strDupDel := strDupDel + ' OR ';

        Next;
      End;

      Close;

      If (lstCtpBaixadas.Count > 0) Then
      Begin
        strDupDel := '';
        Result := False;
      End;

      If (Not fEmptyStr(strDupDel)) Then
      Begin
        {*******************************************}
        {* DELETA AS DUPLICATAS                    *}
        {****************************************MV*}
        strSQL := '';
        strSQL := strSQL + 'DELETE FROM CADPAG ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + strDupDel;
        With qryGenTmp Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ExecSQL;
          Close;
        End;

        {*******************************************}
        {* DELETA CTPDET(X)                        *}
        {****************************************MV*}
        strSQL := '';
        strSQL := strSQL + 'DELETE FROM ' + strArqCtpDet + ' ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + AnsiReplaceStr(strDupDel, 'CTP_CODEMP', 'CTP_EMPORI');
        With qryGenTmp Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ExecSQL;
          Close;
        End;

      End;
      imgCtaPagar.Picture := imgAlterado.Picture;

    End;
  Except
    On E: Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message, '[fCancelaContasPagarFunrural]');
      Result := False;
    End;
  End;

  FreeAndNil(qryGenTmp);

end;

function TfrmCancelamentoDocumentos.fVerificarSeDocumentoColeta(var strEspDoc: String; const strNumDoc, strEmpDoc: String): Boolean;
CONST
  ESPECIE_RETORNO_COLETA_GARANTIA: String = 'G2';
Var
  CancelaRetornoColeta: TCancelamentoRetornoColeta;
begin
  Result := True;
  CancelaRetornoColeta := TCancelamentoRetornoColeta.Create(strNumDoc, strEspDoc, strEmpDoc);
  Try
    if CancelaRetornoColeta.fCarregaColeta then
    Begin
      if CancelaRetornoColeta.fVericaSeTemEnvioParaFornecedor then
      begin
        Result := False;
        fMensagemCancelamento('', 'Exite envio para o forncedor para as garantias atreladas a esta coleta!');
      end;

      if CancelaRetornoColeta.blnTemReposicao then
        Result := False
      else
      begin
        // blnConfirmado é a resposta para a pergunta se deseja cancelar o retorno de coleta
        Result := CancelaRetornoColeta.blnConfirmado;
        strEspDoc := ESPECIE_RETORNO_COLETA_GARANTIA;
      end;
    end;
  Finally
    FreeAndNil(CancelaRetornoColeta);
  End;
end;

function TfrmCancelamentoDocumentos.fCancelarRetornoColeta(var strEspDoc: String; const strNumDoc, strEmpDoc: String): Boolean;
Var
  CancelaRetornoColeta: TCancelamentoRetornoColeta;
begin
  Result := False;
  CancelaRetornoColeta := TCancelamentoRetornoColeta.Create(strNumDoc, 'NW', strEmpDoc);
  Try
    if CancelaRetornoColeta.fCarregaColeta(True) then
    Begin
      Result :=  fCancelaContasReceber('NF',strNumDoc, CancelaRetornoColeta.fGetCodCli,strEmpDoc);
      if Result then
      begin
        Result := CancelaRetornoColeta.fCancelarTitulosCredito(fCancelaContasReceber);
        if Result then
          Result := CancelaRetornoColeta.fCancelarColeta(fApagaGarantia);
      end;
    end;
  Finally
      FreeAndNil(CancelaRetornoColeta);
  End;
end;

procedure TfrmCancelamentoDocumentos.pCancelaSepFdo(strNumDoc, strEspDoc: String);
var
  strSQL : String;
  qryDelSepFdo : TUniQuery;
  strAutInc: String;
begin

  strSQL := '';
  strSQL := strSQL + 'SELECT S.*  FROM SEPFDO S ';
  strSQL := strSQL + 'INNER JOIN FATDOR F ON (S.FDO_SEQFDO = F.AUTOINCREM) ';
  strSQL := strSQL + 'INNER JOIN MOVDET M ON (F.FDO_NUMDOC = M.DET_NUM_PD AND F.FDO_CODITE = M.DET_CODITE AND F.FDO_CODEMP = M.DET_EMP_PD AND F.FDO_SEQIND = M.DET_IND_PD AND M.DET_QTDITE = S.FDO_QTDSEP)';
  strSQL := strSQL + 'WHERE M.DET_NUMDOC = :NUMDOC AND M.DET_ESPDOC = :ESPDOC AND M.DET_CODEMP = :CODEMP ';
  strSQL := strSQL + 'GROUP BY M.DET_CODITE';
  qryDelSepFdo := fCriaQuery(Self);
  Try
    qryDelSepFdo.Close;
    qryDelSepFdo.SQL.Clear;
    qryDelSepFdo.SQL.Add(strSQL);
    qryDelSepFdo.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDelSepFdo.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDelSepFdo.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDelSepFdo.Open;

    if qryDelSepFdo.IsEmpty then
      Exit;

    qryDelSepFdo.First;
    strAutInc := EmptyStr;
    While Not qryDelSepFdo.Eof Do
    Begin
      fVerificaIntegridade('TfrmCancelamentoDocumentos', 'SEPFDO', qryDelSepFdo, True, False, EmptyStr, fOperadorDoCancelamento);
      pIncrementaListaStr(qryDelSepFdo.FieldByName('AUTOINCREM').AsString, strAutInc, True);
      qryDelSepFdo.Next;
    End;

    if fEmptyStr(strAutInc) then
      Exit;

    qryDelSepFdo.Close;
    qryDelSepFdo.SQL.Clear;
    qryDelSepFdo.SQL.Add('DELETE FROM SEPFDO WHERE AUTOINCREM IN('+strAutInc+')');
    qryDelSepFdo.ExecSQL;

  Finally
    FreeAndNil(qryDelSepFdo);
  End;
end;

function TfrmCancelamentoDocumentos.fCancelaItensEfetivadosOrcamentoEmPedido(strNumDoc, strEspSel, strCliFor: String): Boolean;
var
  strSQL: String;
  qryUpdate: TUniQuery;
begin
  strSQL := '';
  strSQL := strSQL + 'UPDATE ';
  strSQL := strSQL + '  FATDOR ';
  strSQL := strSQL + 'SET ';
  strSQL := strSQL + '  FDO_QTDBAI = NULL, ';
  strSQL := strSQL + '  FDO_JAFATU = 0, ';
  strSQL := strSQL + '  FDO_TIPFAT = NULL, ';
  strSQL := strSQL + '  FDO_NUMFAT = NULL, ';
  strSQL := strSQL + '  FDO_EMPFAT = NULL, ';
  strSQL := strSQL + '  FDO_DTAFAT = NULL, ';
  strSQL := strSQL + '  FDO_VENFAT = NULL, ';
  strSQL := strSQL + '  FDO_CNDFAT = NULL, ';
  strSQL := strSQL + '  FDO_VALFAT = NULL ';
  strSQL := strSQL + ' WHERE FDO_NUMFAT = :NUMFAT ';
  strSQL := strSQL + '   AND FDO_TIPFAT = :TIPFAT ';
  strSQL := strSQL + '   AND FDO_CODCLI = :CODCLI ';
  strSQL := strSQL + '   AND FDO_EMPFAT = :EMPFAT ';
  strSQL := strSQL + '   AND FDO_JAFATU = 1 ';
  If fPedidoOriginadoOutroPedidoPeloF11Caixa(strNumDoc, VS_strCodEmp) Then
    strSQL := strSQL + '   AND FDO_ESPDOC = "PD" '
  Else
    strSQL := strSQL + '   AND FDO_ESPDOC = "OR" ';

  qryUpdate := fCriaQuery();
  try
    qryUpdate.Sql.Text := strSQL;
    qryUpdate.ParamByName('NUMFAT').AsString := strNumDoc;
    qryUpdate.ParamByName('TIPFAT').AsString := strEspSel;
    qryUpdate.ParamByName('CODCLI').AsString := strCliFor;
    qryUpdate.ParamByName('EMPFAT').AsString := VS_strCodEmp;
    qryUpdate.ExecSQL;

    Result := True;
  finally
    FreeAndNil(qryUpdate);
  end;

end;

function TfrmCancelamentoDocumentos.fGnreDeSaidaRetornaChaveDeAcesso(ANumDoc, ACodCli, ASerie: String): String;
var
  LQryAux: TUniQuery;
  LSql: String;
begin
  LQryAux := fCriaQuery;

  Try
    LSql := '';
    LSql := LSql + 'SELECT FIS_ACESSO FROM MOVGER ';
    LSql := LSql + 'INNER JOIN CADFIS ON CADFIS.FIS_NUMDOC = MOVGER.GER_NUMDOC AND ';
    LSql := LSql + '                     CADFIS.FIS_ESPDOC = MOVGER.GER_ESPDOC AND ';
    LSql := LSql + '                     CADFIS.FIS_CODEMP = MOVGER.GER_CODEMP AND ';
    LSql := LSql + '                     CADFIS.FIS_FORCLI = MOVGER.GER_CODCLI AND ';
    LSql := LSql + '                     CADFIS.FIS_SERIE_ = MOVGER.GER_SERIE_ ';
    LSql := LSql + 'WHERE LEFT(GER_CLAFIS,1) >= 5 ';
    LSql := LSql + '  AND GER_TIP_FC = "C" ';
    LSql := LSql + '  AND GER_ORIDOC = "V" ';
    LSql := LSql + '  AND GER_ESPDOC = "NF" ';
    LSql := LSql + '  AND GER_NUMDOC = :NUMDOC ';
    LSql := LSql + '  AND GER_CODCLI = :CODCLI ';
    LSql := LSql + '  AND GER_SERIE_ = :SERIE_ ';
    LSql := LSql + '  AND GER_CODEMP = :CODEMP ';
    LSql := LSql + ' UNION ALL ' + AnsiReplaceStr(LSql, 'MOVGER', 'NOTGER');

    LQryAux.Close;
    LQryAux.SQL.Clear;
    LQryAux.SQL.Text := LSql;
    LQryAux.ParamByName('NUMDOC').AsString := ANumDoc;
    LQryAux.ParamByName('CODCLI').AsString := ACodCli;
    LQryAux.ParamByName('SERIE_').AsString := ASerie;
    LQryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    LQryAux.Open;

    Result := LQryAux.FieldByName('FIS_ACESSO').AsString;

  Finally
    FreeAndNil(LQryAux);
  End;
end;

