function TfrmCancelamentoDocumentos.fCancelaContasPagarCFr(strEspDoc,
  strNumDoc, strCliFor, strSerie: String): Boolean;
  Var
    intRecordCount: Integer;
    strArqCtpDet  : String;

    strSQL   : String;
    strDupDel: String;
    strArqCtp: String;
    blnDupPar: Boolean;
    qryGenTmp: TUniQuery;
    qryTemp01: TUniQuery;
    qryTemFis: TUniQuery;

    Function fSQLCadPag: String;
      Var
        strSQL   : String;
    Begin
