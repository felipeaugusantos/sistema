  qryAux.SQL.Add('  DUPAGP ');
  qryAux.SQL.Add('WHERE ');

  qryAux.SQL.Add('  CTP_NOTENT = :NOTENT ');

  qryAux.ParamByName('NOTENT').AsString := strNumDoc + strEspDoc + VS_strCodEmp + fstrEspaco(strSerie, 3) + strCliFor;

  qryAux.Open;

  With qryAux Do
  While (Not qryAux.Eof) Do
  Begin
    Result.Add('Agrup: ' + fPadR(fieldbyname('CTP_NUMAGR').AsString,18,' ') +
               'Duplic: ' + fPadR(fieldbyname('CTP_NUMDUP').AsString + '-' +
                                  fieldbyname('CTP_PARCEL').AsString + '-' +
                                  fieldbyname('CTP_CODEMP').AsString, 19,' ') +
               'Venc: ' + fPadR(fieldbyname('CTP_DTAVEN').AsString,12,' ') +
               'Valor: ' + FormatFloat('#,##0.00',fieldbyname('CTP_VALDUP').AsFloat));
    qryAux.Next;
  End;

  qryAux.Close;
  FreeAndNil(qryAux);
end;

{**********************************************************}
{* VERIFICA SE O DOCUMENTO NÃO ESTÁ EM NENHUM AGRUPAMENTO *}
{*******************************************************LU*}
function TfrmCancelamentoDocumentos.fVerificaDocumentoAgrupado(strEspSel, strNumDoc, strCliFor: String): Boolean;
  Var
    strSQL: String;
    qryGen: TUniQuery;
    strMsg: String;
begin

  If (strEspSel = 'NW') Then
  Begin
    strEspSel := 'NF';
  End
  Else
  If (strEspSel = 'GA') Then
  Begin
    strEspSel := 'CC';
    strNumDoc := fCampoTabela('GAG_NUMCCR', 'MOVGAG', ['GAG_NUMENT','GAG_CODEMP'], [strNumDoc, VS_strCodEmp]);
  End;

  Result := False;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  CTR_NUMAGR AS NUMAGR, ';
  strSQL := strSQL + '  CONCAT(CTR_NUMDUP,CTR_PARCEL,"-",CTR_ESPDOC) AS NUMDUP, ';
  strSQL := strSQL + '  CTR_DTAVEN AS DTAVEN, ';
  strSQL := strSQL + '  CTR_VALDUP AS VALDUP ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  DUPAGR ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CTR_NUMDUP = :NUMDUP AND ';
  If ((strEspSel = 'ND') or (strEspSel = 'DL')) Then
    strSQL := strSQL + '  ((CTR_ESPDOC = "NF") OR (CTR_ESPDOC = "PD")) AND '
  Else
    strSQL := strSQL + '  CTR_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  CTR_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '  CTR_CODEMP = :CODEMP ';
  strSQL := strSQL + 'ORDER BY NUMAGR, NUMDUP, DTAVEN, VALDUP ';

  qryGen := fCriaQuery;

  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDUP').AsString := strNumDoc;
    If ((strEspSel <> 'ND') and (strEspSel <> 'DL')) Then
      ParamByName('ESPDOC').AsString := strEspSel;
    ParamByName('CODCLI').AsString := strCliFor;
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;

    If (Not IsEmpty) Then
    Begin
      First;
      strMsg := '';
      While Not Eof Do
      Begin
        strMsg := strMsg +
                  'Agrup: ' + fPadR(fieldbyname('NUMAGR').AsString,12,' ') +
                  ' Duplic: ' + fPadR(fieldbyname('NUMDUP').AsString,12,' ') +
                  ' Venc: ' + fPadR(fieldbyname('DTAVEN').AsString,12,' ') +
                  ' Valor: ' + FormatFloat('#,##0.00',fieldbyname('VALDUP').AsFloat) + #13#10;
        Next;
      End;

      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.lblMensagem.caption := 'Não foi possível cancelar o documento pois a(s) duplicata(s) abaixo está agrupada(s):';
        frmObservacao.memObs.Texto := strMsg;
        If FExecutandoCanceladorAutomatico Then
          pMensagemOK(frmObservacao.lblMensagem.caption + slIneBreak + strMsg)
        Else If CancelandoNFViaFulFillment Then
          objFulFillmentLogBuilder.pSalvarLog(strMsg, True)
        Else
          frmObservacao.ShowModal;
      Except
        On E: Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message, '[frmCancelamentoDocumentos.fVerificaDocumentoAgrupado]');
        End;
      End;

      pFreeAndNil(frmObservacao);

    End
    Else
      Result := True;

  End;

  FreeAndNil(qryGen);
end;

function TfrmCancelamentoDocumentos.fMensagemCancelamento(strTitulo, strTexto: String; arrOpcoes: TStringArray = [];
  intFormHeight: Integer = 0; intFormWidth: Integer = 0; intQtdLinha: Integer = -1): Integer;
begin
  Result :=
    TMensagem.New(
      TMensagemParams.New
        .Titulo(strTitulo)
        .Texto(strTexto)
        .Botoes(arrOpcoes)
        .AlturaForm(intFormHeight)
        .LarguraForm(intFormWidth)
        .QuantLinhas(intQtdLinha)
        .FulFillmentLog(Self.objFulFillmentLogBuilder)
    ).Show;
end;

function TfrmCancelamentoDocumentos.fMostraDocumentoCancelamento(strDocumento, strEspecie, strCliente, strEspecieSel, strSerie:String; blnCancelandoPendencia : Boolean):Boolean;

  function fPegaTipoAjuste: String;
    Var
      qryGenDet: TUniQuery;
  Begin
    qryGenDet := fCriaQuery;

    With qryGenDet Do
    Begin
      Close;
      SQL.Clear;

      SQL.Add('SELECT                      ');
      SQL.Add('  GER_ESPDOC,               ');
      SQL.Add('  GER_NUMDOC                ');
      SQL.Add('FROM                        ');
      SQL.Add('  MOVGER                    ');
      SQL.Add('WHERE                       ');
      SQL.Add('  GER_CODCLI = :CODCLI AND  ');
      SQL.Add('  GER_NUMDOC = :NUMDOC AND  ');
      SQL.Add('  GER_ESPDOC = "AJ"    AND  ');
      SQL.Add('  GER_CODEMP = :CODEMP      ');
      SQL.Add('UNION ALL                   ');
      SQL.Add('SELECT                      ');
      SQL.Add('   GER_ESPDOC,              ');
      SQL.Add('   GER_NUMDOC               ');
      SQL.Add('FROM                        ');
      SQL.Add('   MOVGER                   ');
      SQL.Add('WHERE                       ');
      SQL.Add('  GER_CODCLI = :CODCLI AND  ');
      SQL.Add('  GER_NUMFAT = :NUMDOC AND  ');
      SQL.Add('  GER_TIPFAT = "AJ"    AND  ');
      SQL.Add('  GER_EMPFAT = :CODEMP;     ');


      ParamByName('CODCLI').AsString := strCliente;
      ParamByName('NUMDOC').AsString := strDocumento;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      Result := IIF(fEmptyStr(FieldByName('GER_ESPDOC').AsString), 'AJ', FieldByName('GER_ESPDOC').AsString);

      strNumDocML := FieldByName('GER_NUMDOC').AsString;
      strEspDocML := FieldByName('GER_ESPDOC').AsString;

    End;

    FreeAndNil(qryGenDet);
  End;

  Var
    strTabela   : String;
    strSigForCli: String;
    strNomeArquivo: String;
    strSerieSel : String;
begin

  strTabela := '';

  Result := True;

  If blnPDV Then
    Exit;

  If (Not blnFaturamento) Then
  Begin
    If (Assigned(reiReimpressao)) Then
      FreeAndNil(reiReimpressao);

    If edtTipPes.Visible Then
      strSigForCli := edtTipPes.Text
    Else
      strSigForCli := IIF((Pos(strEspecieSel,'NE_NI_OF_NG_NR_GF_GR_EF_') > 0),'F','C');

    If (pos(strEspecieSel, 'NC_IC_DC_') = 0) Then
    Begin
      reiReimpressao := TReimpressao.Create(strDocumento,  //edtNumDoc.Text,
                                            IIF( Pos(strEspecieSel, 'NR_NG_EF' ) > 0 , 'NF', IIF(strEspecieSel = 'AJ', fPegaTipoAjuste, strEspecie)),
                                            VS_Date,       //StrToDate(mskDtaIni.Text),
                                            VS_Date,       //StrToDate(mskDtaFin.Text),
                                            strCliente,    //edtCodCliente.Text,
                                            VS_strCodEmp,  //edtCodEmpresa.Text,
                                            '',            //edtCodVendedor.Text,
                                            True,          //blnFaturamento,
                                            strSigForCli,  //strTip_Fc
                                            True,          //blnPergSep
                                            False,         //blnFatVenda
                                            IIF(strEspecieSel = 'NG', False, True), //blnCancelamento
                                            IIF(Pos(strEspecieSel, 'NW_EF_') > 0, 'NF', strEspecieSel), //Especiel Selecionada
                                            strSerie,      //Serie da Nota
                                            False,
                                            0,
                                            False,
                                            '');

      With reiReimpressao.objDocumentos.cdsDocumentos Do
      Begin

        If IsEmpty Then
        Begin
          fMensagem('','Documento não encontrado !!!',['&O K']);
          Result := False;
          pSetFocus(edtNumDoc);
          Exit;
        End;

        If objLock.fDocumentoTravado(FieldByName('TABELA').AsString,
                             FieldByName('NUMDOC').AsString,
                             FieldByName('ESPDOC').AsString,
                             FieldByName('CODEMP').AsString,
                             FieldByName('CODCLI').AsString) Then
        Begin
          Result := False;
          pSetFocus(edtNumDoc);
          Exit;
        End;

        strTabela := fRetornaTabela(FieldByName('TABELA').AsString);

        If (fCfgSis('UTIFEC', varBoolean)) then
        begin
          dtaDtaFecEstoque := TFechamentoEstoque.fDataFechamento;
          dtaDtaFecFiscal  := TFechamentoFiscal.fDataFechamento;

          If (SameText(strTabela, 'MOVDET') Or SameText(strTabela, 'MOVGER')) And Assigned(FindField('DTAENT')) Then
          Begin
            dtaDtaEntEstoque := FieldByName('DTAENT').AsDateTime;

            If (FieldByName('DTAENT').AsDateTime <= dtaDtaFecEstoque) Then
            Begin
              pMensagemOk('A data de entrada do documento (' + FormatDateTime('DD/MM/YYY', FieldByName('DTAENT').AsDateTime) +
                          ') é menor ou igual a do último fechamento de estoque (' + FormatDateTime('DD/MM/YYY', dtaDtaFecEstoque) + ')!');
              Result := False;
              pSetFocus(edtNumDoc);
              Exit;
            End;

            If (FieldByName('DTAENT').AsDateTime <= dtaDtaFecFiscal) Then
            Begin
              pMensagemOk('A data de entrada do documento (' + FormatDateTime('DD/MM/YYY', FieldByName('DTAENT').AsDateTime) +
                          ') é menor ou igual a do último fechamento fiscal (' + FormatDateTime('DD/MM/YYY', dtaDtaFecFiscal) + ')!');
              Result := False;
              pSetFocus(edtNumDoc);
              Exit;
            End;

          End;
        end;

        TCfgRel.AtivarCfgLayoutRegraCancelamento := True;

        If (Not blnCancelandoPendencia) And (Pos(FieldByName('ESPDOC').AsString,'NF_EL_NS_RL_') > 0) Then
        Begin

          pImprimeFatImp(strTabela,
                         FieldByName('NUMDOC').AsString,
                         FieldByName('ESPDOC').AsString,
                         FieldByName('CODEMP').AsString,
                         FieldByName('CODCLI').AsString,
                         FieldByName('TIP_FC').AsString,
                         FieldByName('ORIDOC').AsString,
                         True,
                         strNomeArquivo,
                         False,
                         'V'); //strTipImp

        End
        Else If (Not blnCancelandoPendencia) And (Pos(strEspecieSel, 'NE_RO_') <= 0) Then
        Begin

          pImprimeFatImp(strTabela,
                         IIF(SameText(FieldByName('ESPDOC').AsString, 'ML'), MidStr(FieldByName('NUMFAT').AsString,1, fTamDocCadRec()), FieldByName('NUMDOC').AsString),
                         IIF(SameText(MidStr(FieldByName('NUMFAT').AsString, 8, 2), 'ML') And SameText(FieldByName('ESPDOC').AsString, 'AJ'), 'ML', FieldByName('ESPDOC').AsString),
                         FieldByName('CODEMP').AsString,
                         FieldByName('CODCLI').AsString,
                         FieldByName('TIP_FC').AsString,
                         FieldByName('ORIDOC').AsString,
                         True,
                         strNomeArquivo,
                         False,
                         'V', //strTipImp
                         1,
                         impComPrecoGeral,
                         0,
                         False,
                         False); //blnImpTck

        End;
        TCfgRel.AtivarCfgLayoutRegraCancelamento := False;
      End;

    End
    Else
    Begin
      If Not (fExisteNotaComplemento(edtNumDoc.Text, edtSerie.Text, edtCliFor.Text)) Then
      Begin
        fMensagem('','Documento não encontrado !!!',['&O K']);
        Result := False;
        pSetFocus(edtNumDoc);
        Exit;
      End;
    End;

    blnCancelarCupomNoEcf := False;
    If strEspecieSel = 'IF' Then
    Begin
      If ((fCfgSis('USNFCE', varBoolean) Or fUsaSat)) Then
        strSerieSel := fCfgSis('SERNFC')
      Else
        strSerieSel := fCfgSis('SERFSC');

      If Not fPodeCancelarCupomFiscal(edtNumDoc.Text, strSerieSel, edtCliFor.Text) Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    If blnPegaDados Then
      Result := (fMensagem('', 'Confirma o documento digitado para cancelamento ?', ['&Sim', '&Não']) = 1)
    Else
    Begin
      If FblnCancelamentoLocEqu Then
        Result := True
      Else
        Result := (fMensagem('', 'Deseja ' + IIF(chkInutilizacao.Checked, 'inutilizar', 'cancelar') + ' o documento ?', ['&Sim', '&Não']) = 1);
    End;

    if fPodeCancelarLinkPagamentoCitel(Result, edtNumDoc.Text, arrEspecies[intIndiceEsp][0], VS_strCodEmp) then
    begin
      if not TLinkPagamentoCitelClass.fTemSaldoSuficienteAdtCli(edtNumDoc.Text,
                                                                arrEspecies[intIndiceEsp][0],
                                                                VS_strCodEmp) then
      begin
        btnCancelar.Click;
        Result := False;
      end
      else
      begin
        if not TLinkPagamentoCitelClass.fProcessaCancelamento(edtNumDoc.Text, arrEspecies[intIndiceEsp][0], VS_strCodEmp) then
        begin
          pMensagemOK('Processo cancelado!');
          btnCancelar.Click;
          Result := False;
        end ;
      end ;
    end ;

    If Result Then
    Begin
      if Not (fUsaProtocolo and (not blnPegaDados)) Then
        Result := fInformarOcorrencia(blnCancelandoPendencia);
    End
    Else
      Result := False;

    Application.ProcessMessages;
  End;

end;

function TfrmCancelamentoDocumentos.fRetornaTabela(strTabela:String):String;
Begin

  If strTabela = 'MOVGER' Then
    Result := 'MOVDET'

  Else If strTabela = 'FATGOR' Then
    Result := 'FATDOR'

  Else If strTabela = 'NOTGER' Then
    Result := 'NOTDET'

  Else If strTabela = 'MOVGAG' Then
    Result := 'MOVGAD';

End;

function TfrmCancelamentoDocumentos.fRetSQLCodCli(strEspSel: String): string;
begin
  If Pos(strEspSel, 'NE_') > 0 Then
    Result := '  DET_CODFOR = :CODCLI '
  Else
    Result := '  DET_CODCLI = :CODCLI ';
end;

