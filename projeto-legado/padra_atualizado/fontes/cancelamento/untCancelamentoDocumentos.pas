function TfrmCancelamentoDocumentos.fGetOrdensBaixadasVenda(strEspSel, strNumDoc, strCliFor: String; Out strOrdens: String): Boolean;
  Var
    qryOP: TUniQuery;
begin
  qryOP := fCriaQuery;
  Try
    qryOP.SQL.Add('SELECT GROUP_CONCAT(PRO_CODPRO) AS CODPRO');
    qryOP.SQL.Add('  FROM MOVPRO');
    qryOP.SQL.Add(' WHERE (PRO_CODEMP, PRO_NUMDOC, PRO_ESPDOC) IN (SELECT DET_EMP_PD,');
    qryOP.SQL.Add('                                                       DET_NUM_PD,');
    qryOP.SQL.Add('                                                       DET_ESP_PD');
    qryOP.SQL.Add('                                                  FROM MOVDET ');
    qryOP.SQL.Add('                                                 WHERE DET_NUMDOC = :NUMDOC');
    qryOP.SQL.Add('                                                   AND DET_ESPDOC = :ESPDOC');
    qryOP.SQL.Add('                                                   AND DET_CODCLI = :CODCLI');
    qryOP.SQL.Add('                                                   AND DET_CODEMP = :CODEMP');
    qryOP.SQL.Add('                                                UNION');
    qryOP.SQL.Add('                                                SELECT DET_CODEMP,');
    qryOP.SQL.Add('                                                       DET_NUMDOC,');
    qryOP.SQL.Add('                                                       DET_ESPDOC');
    qryOP.SQL.Add('                                                  FROM MOVDET ');
    qryOP.SQL.Add('                                                 WHERE DET_NUMDOC = :NUMDOC');
    qryOP.SQL.Add('                                                   AND DET_ESPDOC = :ESPDOC');
    qryOP.SQL.Add('                                                   AND DET_CODCLI = :CODCLI');
    qryOP.SQL.Add('                                                   AND DET_CODEMP = :CODEMP)');

    qryOP.ParamByName('NUMDOC').AsString := strNumDoc;
    qryOP.ParamByName('ESPDOC').AsString := strEspSel;
    qryOP.ParamByName('CODCLI').AsString := strCliFor;
    qryOP.ParamByName('CODEMP').AsString := VS_strCodEmp;

    qryOP.Open;

    If qryOP.IsEmpty Then
    Begin
      qryOP.Close;
      qryOP.SQL.Text := AnsiReplaceStr(qryOP.SQL.Text, 'MOVDET', 'NOTDET');
      qryOP.Open;
    End;

    strOrdens := AnsiReplaceStr(qryOP.FieldByName('CODPRO').AsString, ',' , ', ');

    Result := Not fEmptyStr(strOrdens);
  Finally
    FreeAndNil(qryOP);
  End;
end;

function TfrmCancelamentoDocumentos.fGetSqlTAPendente(strNumDoc, strSerie, strCodFor, VS_strCodEmp, strEspSel: String; strEspBus: String=''):String;
  Var
    strEspDoc,
    strSQL: String;
Begin
  Result:= '';

  If Not strEspBus.IsEmpty Then
    strEspDoc := strEspBus
  Else If Not blnPedidoEntrada Then
    strEspDoc := 'NF'
  Else
    strEspDoc := 'PD';

  if strEspSel = 'CR' then
    strEspDoc := strEspSel;


  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   ENT.AUTOINCREM, ';
  strSQL := strSQL + '   TA.GER_ESPDOC, TA.GER_NUMDOC, TA.GER_CODEMP, TA.GER_SERIE_, ';
  strSQL := strSQL + '   TA.GER_CODCLI, CLI_NOMCLI,  ';
  strSQL := strSQL + '   CONCAT(TA.GER_ESPDOC, "-", TA.GER_NUMDOC, "-", TA.GER_CODEMP, "-", TA.GER_SERIE_ ) AS DOCUME, ';
  strSQL := strSQL + '   CONCAT(TA.GER_CODCLI, "-", IFNULL(CLI_NOMCLI, "")) AS NOMCLI ';
  strSQL := strSQL + ' FROM ';
  strSQL := strSQL + '   MOVGER ENT ';

  strSQL := strSQL + ' INNER JOIN AUXMOV ON AUX_SEQDOR = ENT.AUTOINCREM ';

  strSQL := strSQL + ' INNER JOIN MOVGER TA ON TA.AUTOINCREM = AUX_SEQGER ';

  strSQL := strSQL + ' LEFT JOIN CADCLI ON CLI_CODCLI = TA.GER_CODCLI ';

  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '       ENT.GER_NUMDOC = '+QuotedStr(strNumDoc)+' ';
  strSQL := strSQL + '   AND ENT.GER_ESPDOC = '+QuotedStr(strEspDoc)+' ';
  strSQL := strSQL + '   AND ENT.GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';

  If ((Pos(strEspSel, 'ND_NF_CR_') > 0) Or (strEspSel = cnsEspParaBuscaDeTAGenerica)) And (edtTipPes.Text = 'C') Then
    strSQL := strSQL + '   AND ENT.GER_CODCLI = '+QuotedStr(strCodFor)+' '
  Else
    strSQL := strSQL + '   AND ENT.GER_CODFOR = '+QuotedStr(strCodFor)+' ';
  strSQL := strSQL + '   AND IFNULL(ENT.GER_SERIE_, "") = '+QuotedStr(strSerie)+' ';
  strSQL := strSQL + '   ORDER BY ENT.AUTOINCREM ';
  Result:= strSQL;
end;

