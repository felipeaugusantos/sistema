  qryPedido.sql.add(strSQL);
  qryPedido.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryPedido.ParamByName('NUMDOC').AsString := strNumPed;
  qryPedido.open;
  result := not qryPedido.isEmpty;
end;

function TfrmCancelamentoDocumentos.fCancelaPedidoCompra(strNumPed: String): Boolean;
  Var
    strCampoSaldo,
    strSQL: String;
    strForFil: String;
    blnLibPcm: Boolean;
    intDEQTPC: Integer;
begin
  If fEmptyStr(strNumPed) Then
  Begin
    Result := TRUE;
    Exit;
  End;

  Try
    strForFil := fRetForFilialTodos;
    blnLibPcm := fCfgSis('LIBPCM', varBoolean);
    intDEQTPC := fCfgSis('DEQTPC', varInteger);

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  PCMDET ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  PCD_NUMPED = :NUMPED AND ';
    strSQL := strSQL + '  PCD_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  PCD_CODEMP = :CODEMP ';

    With qryTemp01 Do
    Begin

      strCampoSaldo := fRetCampoAtualizaSaldoPedidoCompra('',
                                                          strNumPed,
                                                          VS_strCodEmp,
                                                          blnLibPcm,
                                                          strForFil);

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('ESPDOC').AsString := 'PD';
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      While (Not Eof) Do
      Begin
        pEstornaSaldoItemPedidoCompra(FieldByName('AUTOINCREM').AsString, strCampoSaldo, intDEQTPC);

        pLiberaSeqGar('PD', strNumPed, '', 'SEQ_PCMDET');
        fVerificaIntegridade(Self.Name, 'PCMDET', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
        Next;
      End;

      Close;

    End;

    strSQL := AnsiReplaceStr(strSQL, 'PCMDET', 'PCMGER');
    strSQL := AnsiReplaceStr(strSQL, 'PCD_', 'PCG_');

    With qryTemp01 Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('ESPDOC').AsString := 'PD';
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      Open;

      While (Not Eof) Do
      Begin
        fVerificaIntegridade(Self.Name, 'PCMGER', qryTemp01, True, False, EmptyStr, fOperadorDoCancelamento);
        Next;
      End;

      Close;

    End;

    strSQL := '';
    strSQL := strSQL + 'DELETE  FROM ';
    strSQL := strSQL + '  PCMDET ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  PCD_NUMPED = :NUMPED AND ';
    strSQL := strSQL + '  PCD_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  PCD_CODEMP = :CODEMP ';

    With qryTemp01 Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('ESPDOC').AsString := 'PD';
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ExecSQL;
      Close;
    End;

    strSQL := '';
    strSQL := strSQL + 'DELETE  FROM ';
    strSQL := strSQL + '  PCMGER ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  PCG_NUMPED = :NUMPED AND ';
    strSQL := strSQL + '  PCG_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  PCG_CODEMP = :CODEMP ';

    With qryTemp01 Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMPED').AsString := strNumPed;
      ParamByName('ESPDOC').AsString := 'PD';
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ExecSQL;
      Close;

    End;

    If fCfgSis('URMEIE', varBoolean) Then
        TManutencaoEquipamentoInterno.pAjustaStatusAutomatica(TManutencaoEquipamentoInterno.fRetornaSolicitacaoVinculada(strNumPed, 'PD'));

    Result := True;
  Except
    On E: Exception Do
    Begin
      fRollBack;
      Result := False;
      pMensagensErro(E.Message, '[TfrmCancelamentoDocumentos.fCancelaPedidoCompra]');
    End;
  End;

end;

function TfrmCancelamentoDocumentos.fDesmarcaPedidoCompra(strEspSel,
  strNumDoc, strCliFor: String; blnGarantia : Boolean = False): Boolean;
  Var
    strSQL   : String;
    qryGenGer: TUniQuery;
    blnNEConsumo: Boolean;
begin
  blnNEConsumo := False;

  If Not blnGarantia then
  begin
    if (strEspSel = 'NF') and blnFLUPDC Then
    begin
      blnNEConsumo := fEntradaParaConsumo(strCliFor);
    end;
  end;

  Try

    qryGenGer := fCriaQuery(Self);

    Try

      strSQL := '';
      strSQL := strSQL + 'UPDATE ';
      strSQL := strSQL + '  PCMGER ';
      strSQL := strSQL + 'SET ';
      strSQL := strSQL + '  PCG_JAEMIT = 0, ';
      strSQL := strSQL + '  PCG_DTAEMI = NULL, ';
      strSQL := strSQL + '  PCG_VALEMI = NULL, ';
      strSQL := strSQL + '  PCG_DOCEMI = NULL, ';
      strSQL := strSQL + '  PCG_ESPEMI = NULL, ';
      strSQL := strSQL + '  PCG_SEREMI = NULL  ';

      if blnFLUPDC and blnNEConsumo then
       strSQL := strSQL + ',  PCG_BAIXAD = 0 ';

      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  PCG_DOCEMI = :NUMDOC AND ';
      strSQL := strSQL + '  PCG_ESPEMI = :ESPDOC AND ';
      strSQL := strSQL + '  PCG_CODFOR = :CODFOR AND ';
      If Not blnGarantia Then
        strSQL := strSQL + '  PCG_CODEMP = :CODEMP '
      Else
      Begin
        strSQL := strSQL + '  PCG_CODEMP = (SELECT EMP_CODEMP FROM CADEMP ';
        strSQL := strSQL + '                WHERE  EMP_FORFIL = :CODFOR)  ';
      end;

      With qryGenGer Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspSel;
        ParamByName('CODFOR').AsString := strCliFor;

        If Not blnGarantia Then
          ParamByName('CODEMP').AsString := VS_strCodEmp;

        ExecSQL;
        Close;
      End;

      strSQL := AnsiReplaceStr(strSQL, 'PCMGER', 'PCMDET');
      strSQL := AnsiReplaceStr(strSQL, 'PCG_', 'PCD_');

      With qryGenGer Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspSel;
        ParamByName('CODFOR').AsString := strCliFor;

        If Not blnGarantia Then
          ParamByName('CODEMP').AsString := VS_strCodEmp;

        ExecSQL;
        Close;
      End;
      Result := True;

    Except
      On E: Exception Do
      Begin
        fRollBack;
        Result := False;
        pMensagensErro(E.Message, '[fDesmarcaPedidoCompra]');
      End;
    End;

  Finally
    FreeAndNil(qryGenGer);
  End;

end;

