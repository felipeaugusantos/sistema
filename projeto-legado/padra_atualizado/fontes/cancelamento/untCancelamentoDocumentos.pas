function TfrmCancelamentoDocumentos.fAprovaCancBaixaEmprestimo(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
Var
  strSQL   : String;
  qryBaiEmp: TUniQuery;
  qryCon_FF: TUniQuery;
begin
  Result    := False;

  Try
    qryBaiEmp := fCriaQuery;
    qryCon_FF := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT        ';
    strSQL := strSQL + '  DET_DOCFUT, ';
    strSQL := strSQL + '  DET_ESPFUT, ';
    strSQL := strSQL + '  DET_EMPFUT, ';
    strSQL := strSQL + '  DET_KEY_EP, ';
    strSQL := strSQL + '  DET_QTDITE, ';
    strSQL := strSQL + '  DET_SEQGER   ';
    strSQL := strSQL + 'FROM      ';
    strSQL := strSQL + '  MOVDET  ';
    strSQL := strSQL + 'WHERE     ';
    strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  IFNULL(DET_KEY_EP, "") <> "" ';//CASO ESTEJA PREENCHIDO

    With qryBaiEmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;
    End;

    {**********************************}
    {* VERIFICA SE O DOCUMENTO EXISTE *}
    {*******************************PZ*}
    If (Not qryBaiEmp.IsEmpty) Then
    Begin
      Result := True;
      {****************************************************}
      {* VERIFICA SE A BAIXA FOI REALIZADA ATRAVÉS DE FF. *}
      {* QUANDO É BAIXADA ATRAVÉS DE FF, PREENCHE O       *}
      {* DET_DOCFUT COM O NÚMERO DA FF QUE FOI GERADA.    *}
      {*************************************************PZ*}
      If (Not fEmptyStr(qryBaiEmp.FieldByName('DET_DOCFUT').AsString)) Then
      Begin
        Result := False;

        strSQL := '';
        strSQL := strSQL + 'SELECT        ';
        strSQL := strSQL + '  DET_NUMDOC  ';
        strSQL := strSQL + 'FROM      ';
        strSQL := strSQL + '  MOVDET  ';
        strSQL := strSQL + 'WHERE     ';
        strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
        strSQL := strSQL + '  DET_CODCLI = :CODCLI     ';

        With qryCon_FF Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NUMDOC').AsString := qryBaiEmp.FieldByName('DET_DOCFUT').AsString;
          ParamByName('ESPDOC').AsString := qryBaiEmp.FieldByName('DET_ESPFUT').AsString;
          ParamByName('CODEMP').AsString := qryBaiEmp.FieldByName('DET_EMPFUT').AsString;
          ParamByName('CODCLI').AsString := strCodCli;
          Open;

          {******************************************************}
          {* VERIFICA SE A FF JÁ FOI CANCELADA, CASO CONTRÁRIO, *}
          {* NÃO PERMITE CANCELAR A BAIXA DE EMPRÉSTIMO.        *}
          {***************************************************PZ*}
          If (IsEmpty) Then
            Result := True
          Else
          Begin
            pAtribuiPicture(Nil);
            fMensagemCancelamento('ATENÇÃO!','Essa baixa de empréstimo, está vincula a FF de número: ' +
                                 qryBaiEmp.FieldByName('DET_DOCFUT').AsString + '.' + #13 +
                                 ' É necessário realizar o cancelamento desta FF para cancelar esta baixa!',
                                 ['&O k']);
          End;
        End;
      End;
    End
    Else
    Begin
      fMensagemCancelamento('ATENÇÃO!','Documento não encontrado!',['&O k']);
      Result := False;
    End;

    //Verifica Contas A Pagar
    If Result Then
    Begin
       btnEstorno.Enabled := False;
       If fExisteDuplicatasBaixadasBaixaEmprestimo(qryBaiEmp.FieldByName('DET_SEQGER').AsString) then
       Begin
         Result := False;
         btnEstorno.Enabled := True;
       End;
    End
  Except
    On E:Exception Do
      pMensagensErro(E.Message,'[TfrmCancelamentoDocumentos.fAprovaCancBaixaEmprestimo]');
  End;

  FreeAndNil(qryBaiEmp);
  FreeAndNil(qryCon_FF);
end;

function TfrmCancelamentoDocumentos.fAtualizaQtdeBaixaEmprestimo(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
Var
  qryQtdBai: TUniQuery;
  strSQL   : String;
  blnGravou: Boolean;
begin
  Try
    qryQtdBai := fCriaQuery;
    blnGravou := True;

    strSQL := '';
    strSQL := strSQL + 'SELECT        ';
    strSQL := strSQL + '  DET_KEY_EP, ';
    strSQL := strSQL + '  DET_QTDITE  ';
    strSQL := strSQL + 'FROM      ';
    strSQL := strSQL + '  MOVDET  ';
    strSQL := strSQL + 'WHERE     ';
    strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  IFNULL(DET_KEY_EP, "") <> "" ';//CASO ESTEJA PREENCHIDO

    With qryQtdBai Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspSel;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      If (Not IsEmpty) Then
      Begin
        While Not Eof Do
        Begin
          If (Not fCancelaQuantidadeEmprestimo(FieldByName('DET_QTDITE').AsFloat, FieldByName('DET_KEY_EP').AsString)) Then
            blnGravou := False;

          Next;
        End;
      End;
    End;

    Result := blnGravou;
  Except
    On E:Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[TfrmCancelamentoDocumentos.fAtualizaQtdeBaixaEmprestimo]');
    End;
  End;

  FreeAndNil(qryQtdBai);
end;


function TfrmCancelamentoDocumentos.fDeletaBaixaRealizadaEnvioDevolucao(strEspSel, strNumDoc, strCodFor: String; Out aArrayOfTMovGAuCancelado: TArrayOfTMovGAuCancelado): Boolean;

  procedure pAdicionarItemArrayTMovGauCancelado(Var aArrayOfTMovGAuCancelado: TArrayOfTMovGAuCancelado; Const blnBaixado: Boolean; Const strSeqGad, strSeqGae: String);
  Var
    NovoTamanho: Integer;
  begin
    if Not blnBaixado then
      exit;
    NovoTamanho := Length(aArrayOfTMovGAuCancelado)+1;
    SetLength(aArrayOfTMovGAuCancelado, NovoTamanho);
    aArrayOfTMovGAuCancelado[high(aArrayOfTMovGAuCancelado)].Baixado := blnBaixado;
    aArrayOfTMovGAuCancelado[high(aArrayOfTMovGAuCancelado)].strSeqGad := strSeqGad;
    aArrayOfTMovGAuCancelado[high(aArrayOfTMovGAuCancelado)].strSeqGae := strSeqGae;
  end;

Var
  qryMovGau : TUniQuery;
  qryDelete : TUniQuery;
  blnFilEmp : Boolean;
begin
  Setlength(aArrayOfTMovGAuCancelado,0);
  If (fCfgSis('GARMAT', varBoolean)) then
    blnFilEmp := (VS_strCodEmp <> fCfgSis('EMPGAR', varString))
  Else
    blnFilEmp := True;

  qryMovGau := fCriaQuery;
  qryDelete := fCriaQuery;
  Try
    qryDelete.SQL.Text := 'DELETE FROM MOVGAU WHERE AUTOINCREM = :AUTOINCREM';

    qryMovGau.SQL.Add('SELECT                                                ');
    qryMovGau.SQL.Add('  MOVGAU.*                                            ');
    qryMovGau.SQL.Add('FROM                                                  ');
    qryMovGau.SQL.Add('  MOVGAE                                              ');
    qryMovGau.SQL.Add('  INNER JOIN MOVGAD ON MOVGAD.AUTOINCREM = GAE_SEQGAD ');
    qryMovGau.SQL.Add('  INNER JOIN MOVGAU ON GAU_SEQGAE = MOVGAE.AUTOINCREM ');
    qryMovGau.SQL.Add('WHERE GAE_NUMENV = :NUMDOC                            ');
    qryMovGau.SQL.Add('  AND GAE_ESPENV = :ESPDOC                            ');
    qryMovGau.SQL.Add('  AND GAD_CODFOR = :CODFOR                            ');
    qryMovGau.SQL.Add('  AND GAU_SEQDET = :VALOR_BAIXA_DEVOLUCAO             ');

    If blnFilEmp Then
      qryMovGau.SQL.Add('  AND GAE_EMPENV = :CODEMP                          ');

    qryMovGau.ParamByName('NUMDOC').AsString := strNumDoc;
    qryMovGau.ParamByName('ESPDOC').AsString := IIF(strEspSel = 'NG', 'NF', strEspSel);
    qryMovGau.ParamByName('CODFOR').AsString := strCodFor;
    qryMovGau.ParamByName('VALOR_BAIXA_DEVOLUCAO').AsString := SEQDET_BAIXA_DEVOLUCAO_ENVIO;

    If qryMovGau.FindParam('CODEMP') <> Nil Then
      qryMovGau.ParamByName('CODEMP').AsString := VS_strCodEmp;

    qryMovGau.Open;

    qryMovGau.First;
    while not qryMovGau.EOF do
    begin
      pAdicionarItemArrayTMovGauCancelado(aArrayOfTMovGAuCancelado,
                                          (qryMovGau.FieldByName('GAU_SEQDET').AsString = SEQDET_BAIXA_DEVOLUCAO_ENVIO),
                                           qryMovGau.FieldByName('GAU_SEQGAD').AsString,
                                           qryMovGau.FieldByName('GAU_SEQGAE').AsString);

      fVerificaIntegridade(Self.Name, 'MOVGAU', qryMovGau, True, False, fMotivoDelecao, fOperadorDoCancelamento, False, fGetEspSel);

      qryDelete.ParamByName('AUTOINCREM').AsString := qryMovGau.FieldByName('AUTOINCREM').AsString;
      qryDelete.ExecSQL;

      qryMovGau.Next;
    end;

    Result := True;
  Finally
    FreeAndNil(qryMovGau);
    FreeAndNil(qryDelete);
  End;
end;

