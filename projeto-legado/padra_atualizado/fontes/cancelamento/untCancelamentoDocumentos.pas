function TfrmCancelamentoDocumentos.CancelarBoletosRegistrado(
  ADataSet: TDataSet): Boolean;
var
  LCarteiraBoleto : String;
  LBancoBoleto : String;
begin
  Result := False;

  If (fMensagem('ATENÇÃO!','Este documento possui títulos registrados no banco.' + #13#10 +
                           'Deve-se cancelar primeiro o registro!' + #13#10 +
                           'Deseja cancelar agora?', ['&Sim', '&Não'])= 1) Then

  Begin
    Try
      Self.Visible := False;

      LCarteiraBoleto := ADataSet.FieldByName('CTR_CARTEI').AsString;
      LBancoBoleto := ADataSet.FieldByName('CTR_BCOBOL').AsString;
      case AnsiIndexStr(LBancoBoleto, ['341', '756', '033', '001', '748']) of
        0 : Result := fCancelarBoletosRegistradosItauAPI(LCarteiraBoleto, RetornaDuplicatasBoletoRegistrado(ADataSet));
        1 : Result := fCancelarBoletosRegistradosSicoobAPI(LCarteiraBoleto, RetornaDuplicatasBoletoRegistrado(ADataSet));
        2 : Result := fCancelarBoletosRegistradosSantanderAPI(LCarteiraBoleto, RetornaDuplicatasBoletoRegistrado(ADataSet));
        3 : Result := CancelaBoletoRegistradoBancoDoBrasil(LCarteiraBoleto, RetornaDuplicatasBoletoRegistrado(ADataSet));
        4 : Result := fCancelarBoletosRegistradosSicredAPI(LCarteiraBoleto, RetornaDuplicatasBoletoRegistrado(ADataSet));
      end;

      If Not Result Then
      Begin
        fMensagem('ATENÇÃO!','Não foi possível cancelar todos os boletos registrados.' + #13#10 +
                             'Operação cancelada!',['&O K']);
      End;

    Finally
      Self.Visible := True;
    End;
  End;
end;

function TfrmCancelamentoDocumentos.DeveMostrarDocumentoCancelamento: Boolean;
begin
  Result := True;

  If (Not fSuportaInterfaceGrafica) Then
