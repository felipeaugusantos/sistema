function TfrmCancelamentoDocumentos.fCR_Fechou_Em_NF(strNumDoc, strCodCli: String; var strDtaEnt, strDtaDoc: String): Boolean;
var
  qryAux : TUniQuery;
begin

  Result := False;
  qryAux := fCriaQuery();

  Try

    qryAux.CLose;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('');
    qryAux.SQL.Add('SELECT        ');
    qryAux.SQL.Add('  GER_DTAENT, ');
    qryAux.SQL.Add('  GER_DTADOC, ');
    qryAux.SQL.Add('  AUX_OPCDOC  ');
    qryAux.SQL.Add('FROM          ');
    qryAux.SQL.Add('  MOVGER      ');
    qryAux.SQL.Add('  INNER JOIN AUXMOV ON (AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM) ');
    qryAux.SQL.Add('WHERE GER_NUMDOC = :NUMDOC ');
    qryAux.SQL.Add('  AND GER_ESPDOC = :ESPDOC ');
    qryAux.SQL.Add('  AND GER_CODEMP = :CODEMP ');
    qryAux.SQL.Add('  AND GER_CODCLI = :CODCLI ');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := 'NF';
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.Open;

    If Not qryAux.IsEmpty Then
    Begin
      If qryAux.FieldByName('AUX_OPCDOC').AsString = 'CR' Then
      Begin
        strDtaEnt := qryAux.FieldByName('GER_DTAENT').AsString;
        strDtaDoc := qryAux.FieldByName('GER_DTADOC').AsString;
        Result := True;
      End;
    End;

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TfrmCancelamentoDocumentos.fDesfaturaPedidoVendaOuOrcamento(strEspSel,
  strNumDoc, strCodCli, strCodEmp: String; blnOrc: Boolean; strNumFat: String = '';
  strTipFat: String = ''; strEmpFat: String = ''): Boolean;

  Const cnsFdoQtdBai = ' ,FDO_QTDBAI = IF(FDO_SEQIND = -1, 0, FDO_QTDBAI) ';

  Var
    strSQL   : String;
    qryGenGor: TUniQuery;
begin

  If (blnPodeDesfaturar) Then
  Begin
    Try

      {**************************************************************}
      {* Desmarca a baixa da formulação do documento de origem      *}
      {***********************************************************LU*}
      pDesmarcarBaixaPedidoOrigem(strNumDoc,
                                  strEspSel,
                                  strCodCli);

      qryGenGor := fCriaQuery(Self);

      Try

        strSQL := '';
        strSQL := strSQL + 'UPDATE ';
        strSQL := strSQL + '  FATGOR ';
        strSQL := strSQL + 'SET ';
        strSQL := strSQL + '  FGO_JAFATU = 0, ';
        strSQL := strSQL + '  FGO_TIPFAT = NULL, ';
        strSQL := strSQL + '  FGO_NUMFAT = NULL, ';
        strSQL := strSQL + '  FGO_EMPFAT = NULL, ';
        strSQL := strSQL + '  FGO_DTAFAT = NULL, ';
        strSQL := strSQL + '  FGO_VENFAT = NULL, ';
        strSQL := strSQL + '  FGO_CNDFAT = NULL, ';
        strSQL := strSQL + '  FGO_VALFAT = NULL  ';
        If blnNotaServicoOriundaConfirmacaoPedido Then
          strSQL := strSQL + cnsFdoQtdBai;
        strSQL := strSQL + 'WHERE ';

        If (Not fEmptyStr(strCodCli)) Then
          strSQL := strSQL + '  FGO_CODCLI = :CLIFOR AND ';

        If blnOrc Then
        Begin
          strSQL := strSQL + '  FGO_NUMDOC = :NUMDOC AND ';
          strSQL := strSQL + '  FGO_ESPDOC = :ESPDOC AND ';
          strSQL := strSQL + '  FGO_CODEMP = :CODEMP ';
        End
        Else
        Begin
          strSQL := strSQL + '  FGO_NUMFAT = :NUMFAT AND ';
          strSQL := strSQL + '  FGO_TIPFAT = :TIPFAT AND ';
          strSQL := strSQL + '  FGO_EMPFAT = :CODEMP ';
        End;

        With qryGenGor Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          If blnNotaServicoOriundaConfirmacaoPedido Then
            SQL.Text:=AnsiReplaceStr(SQL.Text, cnsFdoQtdBai, '');
          If (Not fEmptyStr(strCodCli)) Then
            ParamByName('CLIFOR').AsString := strCodCli;

          If blnOrc Then
          Begin
            ParamByName('NUMDOC').AsString := strNumDoc;
            ParamByName('ESPDOC').AsString := strEspSel;
            ParamByName('CODEMP').AsString := strCodEmp;
          End
          Else
          Begin
            ParamByName('NUMFAT').AsString := strNumDoc;
            ParamByName('TIPFAT').AsString := strEspSel;
            ParamByName('CODEMP').AsString := VS_strCodEmp;
          End;

          ExecSQL;
          Close;
        End;

        pAtualizaCancelamentoFaturamentoPedido(strNumDoc, strEspSel, VS_strCodEmp);

        strSQL := AnsiReplaceStr(strSQL, 'FATGOR', 'FATDOR');
        strSQL := AnsiReplaceStr(strSQL, 'FGO_', 'FDO_');

        If blnOrc And Not fEmptyStr(strNumFat) Then
          strSQL := strSQL + ' AND FDO_NUMFAT = :NUMFAT ' +
                             ' AND FDO_TIPFAT = :TIPFAT ' +
                             ' AND FDO_EMPFAT = :EMPFAT ' ;
        With qryGenGor Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          If (Not fEmptyStr(strCodCli)) Then
            ParamByName('CLIFOR').AsString := strCodCli;

          If blnOrc Then
          Begin
            ParamByName('NUMDOC').AsString := strNumDoc;
            ParamByName('ESPDOC').AsString := strEspSel;
            ParamByName('CODEMP').AsString := strCodEmp;

            If Not fEmptyStr(strNumFat) Then
            Begin
              ParamByName('NUMFAT').AsString := strNumFat;
              ParamByName('TIPFAT').AsString := strTipFat;
              ParamByName('EMPFAT').AsString := strEmpFat;
            End;

          End
          Else
          Begin
            ParamByName('NUMFAT').AsString := strNumDoc;
            ParamByName('TIPFAT').AsString := strEspSel;
            ParamByName('CODEMP').AsString := VS_strCodEmp;
          End;

          ExecSQL;
          Close;
        End;

        if blnOrc then
          pAtualizaStatusPD(strNumDoc, strEspSel, strCodEmp)
        else
          pAtualizaStatusPD(strNumDoc, strEspSel, VS_strCodEmp, True);


        Result := True;

      Except
        On E: Exception Do
        Begin
          fRollBack;
          Result := False;
          pMensagensErro(E.Message, '[fDesfaturaPedidoVendaOuOrcamento]');
        End;
      End;

    Finally
      FreeAndNil(qryGenGor);
    End;
  End
  Else
    Result := True;

end;

function TfrmCancelamentoDocumentos.fDesfaturarAjustesConfirmados(strEspSel,
  strNumDoc, strCodCli: String): Boolean;
var
  strSQL:string;
begin
  strSQL:=' UPDATE MOVDET, ' +
          '        MOVTRI  ' +
          '   SET DET_DOCCAJ = NULL ' +
          ' WHERE                   ' +
          '   MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER AND ' +
          '   MOVDET.DET_ESPDOC = "AJ" AND ' +
          '   MOVDET.DET_CODCLI = ' + QuotedStr(strCodCli) + ' AND ' +
          '   MOVTRI.DET_DOCCAJ = ' + QuotedStr(Concat(strNumdoc, strEspSel, VS_strCodEmp));

  Result := fExecutaSQL(strSQL);

  {***********************************************************************************}
  {* EXECUÇÃO EM SEPARADO DO WHERE ENVOLVENDO "DET_ESPDOC" E "DET_TIPFAT" (SEM "OR") *}
  {* CONFORME SOLICITADO NO REQUISITO 18293                                          *}
  {*********************************************************************************VA}
  If Result Then
     Result := fExecutaSQL(AnsiReplaceStr(strSQL,'DET_ESPDOC','DET_TIPFAT'));
end;

