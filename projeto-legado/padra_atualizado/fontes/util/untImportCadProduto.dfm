        object Memo102: TfrxMemoView
          Left = 260.787570000000000000
          Top = 340.157700000000600000
          Width = 801.260360000000000000
          Height = 253.228510000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsItalic]
          Memo.UTF8W = (
            'Ex: Coluna DI:  00000001,00000002'
            '      Coluna DJ:   CODF001,CODF002'
            '      Coluna Dk:  CNAF001,CNAF002     '
            ''
            
              'Essas 3 listas trabalham em conjunto. pois sera gravado invariav' +
              'elmente o c'#243'digo do fornecedor e o c'#243'digo de fabrica, validando ' +
              'se o mesmo ja n'#227'o esta associado a outro produto.'
            
              'Quando isto ocorrer ser'#225' exibido no validador o erro "A lista ag' +
              'rupada identificada como : Fornecedores".'
            
              'A quantidade de elementos existente na Coluna DI deve o mesmo co' +
              'ntido na Coluna DJ; A coluna DK '#233' opcional mas se tiver valor em' +
              ' apenas uma posi'#231#227'o as demais devem ter o os elementos vazio'
            'Ex: Coluna DI: 00000001,00000002,00000003'
            '      Coluna DJ:  CODF001,CODF002,CODF003'
            '      Coluna DK: CNAF001, ,CNAF003'
            ''
            
              'Agora se for Apenas para o 1'#186' fornecedor, ent'#227'o a informa'#231#227'o pod' +
              'e ser informada da seguinte forma:'
            '      Coluna DK:CNAF001')
          ParentFont = False
        end
