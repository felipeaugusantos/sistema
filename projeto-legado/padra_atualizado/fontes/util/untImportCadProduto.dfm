      object Child2: TfrxChild
        FillType = ftBrush
        Height = 1020.473100000000000000
        Top = 1043.150280000000000000
        Width = 1099.843230000000000000
        Child = frxHelp.Child17
        StartNewPage = True
        object Memo17: TfrxMemoView
          Left = 11.338590000000000000
          Top = 143.622140000000000000
          Width = 1077.166050000000000000
          Height = 143.622140000000000000
          Memo.UTF8W = (
            
              '   Os campos de Margem e Pre'#231'o de Venda s'#227'o atualizados automati' +
              'camente conforme op'#231#227'o escolhida na tela inicial de filtros. O c' +
              'ampo Comiss'#227'o n'#227'o '#233' atualizado por este procedimento. O sistema ' +
              'est'#225' preparado para n'#227'o considerar os dados enviados em branco, ' +
              'mantendo a informa'#231#227'o que est'#225' no Cadastro de Produtos. Desta fo' +
              'rma, '#233' poss'#237'vel atualizar somente alguns campos, preservando os ' +
              'demais campos do Produto.'
            ''
            
              '    A ordem utilizada pelo Sistema para localizar o produto ser'#225 +
              ':'
            '        1'#186') Pelo C'#243'digo do Item ( Coluna A )'
            '        2'#186') Pelo C'#243'digo de Barras ( Coluna B )'
            
              '        3'#186') Pelo C'#243'digo do Fornecedor + C'#243'digo de F'#225'brica ( Colu' +
              'na D + Coluna C )'
            
              '        4'#186') Pelo C'#243'digo do Fornecedor + C'#243'digo de F'#225'brica ( Colu' +
              'na D + Coluna C ) - Guia Fornecedores se CFG_TABPRF = N'#227'o')
        end
        object Memo16: TfrxMemoView
          Left = 11.338590000000000000
          Top = 994.197280000000100000
          Width = 1084.725110000000000000
          Height = 18.897650000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsBold]
          HAlign = haCenter
          Memo.UTF8W = (
            'Figura 2 - Complemento')
          ParentFont = False
        end
        object Memo10: TfrxMemoView
          Left = 15.118120000000000000
          Top = 287.244279999999900000
          Width = 616.063390000000000000
          Height = 18.897650000000000000
          Memo.UTF8W = (
            'Os campos da guia complemento segue abaixo, conforme figura 2')
        end
        object Memo3: TfrxMemoView
          Left = 11.559060000000000000
          Top = 105.826840000000000000
          Width = 1073.386520000000000000
          Height = 34.015770000000000000
          Memo.UTF8W = (
            
              '    Na Coluna AX (Boca de Caixa) existe uma configura'#231#227'o "CFG_DO' +
              'VCPP" que define qual descri'#231#227'o ir'#225' compor esse campo. Por isso ' +
              'no Cadastro de Produtos o mesmo poder'#225' estar com outro nome por ' +
              'causa desta configura'#231#227'o. A Figura 1 mostra os detalhes dos camp' +
              'os que s'#227'o atualizados no Cadastro de Produtos (Aba 1 - Geral). ')
        end
        object Memo63: TfrxMemoView
          Left = 3.779530000000000000
