        object Memo100: TfrxMemoView
          Left = 260.787570000000000000
          Top = 317.480519999996400000
          Width = 801.260360000000000000
          Height = 18.897650000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsItalic]
          Memo.UTF8W = (
            
              'Esses campos devem ser representados separados por ",", gerando ' +
              'assim a lista para ser inserida no grid'
            'seguindo a mesma ordem de declara'#231#245'es')
          ParentFont = False
        end
        object Memo101: TfrxMemoView
          Left = 158.740260000000000000
