          Width = 1065.827460000000000000
          Height = 52.913420000000000000
          Memo.UTF8W = (
            
              '     '#201' poss'#237'vel realizar a importa'#231#227'o por arquivo do tipo CSV. S' +
              'egue a mesma ordem dos campos em Excel e a mesma l'#243'gica de impor' +
              'ta'#231#227'o, por'#233'm os campos s'#227'o separados por ";". A Figura 11 ir'#225' de' +
              'monstrar melhor este tipo de arquivo.  Observe na imagem que o c' +
              'ampo que esta selecionado s'#227'o campo que n'#227'o ser'#225' importado para ' +
              'o Sistema, coluna '
            'G e H.')
        end
