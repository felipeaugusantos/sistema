      object Child15: TfrxChild
        FillType = ftBrush
        Height = 680.314960630000000000
        Top = 10760.321910000000000000
        Width = 1099.843230000000000000
        Child = frxHelp.Child14
        StartNewPage = True
        object Memo80: TfrxMemoView
          Left = 71.811070000000000000
          Top = 49.133889999999160000
          Width = 888.189550000000000000
          Height = 634.961040000000000000
          ExpressionDelimiters = '[#]'
          Memo.UTF8W = (
            'Listas de verifica'#231#227'o de mercadoria: garantia e/ou troca'
            ''
            
              'Temos dois tipos de lista de verifica'#231#227'o: garantia de mercadoria' +
              ' e troca de mercadoria. Uma lista de verifica'#231#227'o (checklist) con' +
              'siste no agrupamento de itens que devem ser verificados antes de' +
              ' aceitar a devolu'#231#227'o do produto, e seu tipo determinado pelo gru' +
              'po dos elementos que a comp'#245'em. '
            ''
            'Caracter'#237'stica das listas de verifica'#231#227'o de mercadoria: '
            '    '#8226' '#201' individual por produto e loja; '
            '    '#8226' Pode conter quantos itens forem necess'#225'rios;'
            
              '    '#8226' e Todos os itens devem pertencer ao mesmo grupo (garantia ' +
              'ou troca).'
            ''
            
              'Os itens que v'#227'o compor '#224's listas devem ser previamente cadastra' +
              'dos. Utilize a rotina '#8220'Checklist para Troca de Mercadoria e Devo' +
              'lu'#231#227'o de Garantia'#8221'.'
            ''
            
              'A montagem da lista '#233' feita no cadastro do produto, onde '#233' poss'#237 +
              'vel associar um elemento '#224' lista e adicionar seu conte'#250'do. Enten' +
              'de-se por conte'#250'do o texto informativo que ser'#225' impresso para in' +
              'stru'#231#227'o referente '#224'quele item.'
            ''
            
              'S'#227'o tr'#234's tipos de elementos: multilinhas, linha '#250'nica e '#8220'N/A'#8221'. O' +
              ' primeiro permite 3 linhas de texto, com o m'#225'ximo de 240 caracte' +
              'res; j'#225' segundo '#233' uma linha '#250'nica com limite de 80 caracteres; e' +
              ' o '#250'ltimo n'#227'o permite inserir informa'#231#227'o.'
            ''
            
              'Uma lista pode ser importada ao cadastro e produto por planilha ' +
              'eletr'#244'nica, desde que devidamente representada via texto. A tran' +
              'scri'#231#227'o da lista em texto '#233' feita utilizando nota'#231#227'o '#8220'JSON'#8221'. A s' +
              'eguir '#233' demonstrado uma lista no cadastro de produtos e sua conv' +
              'ers'#227'o em texto.'
            ''
            
              'A lista '#233' transcrita entre colchetes e deve conter apenas os ele' +
              'mentos associados ao produto. Entre os colchetes s'#227'o informados ' +
              'os itens associados, separando cada elemento por v'#237'rgula.'
            ''
            
              'Quando item n'#227'o tem conte'#250'do (todos do tipo '#8220'N/A'#8221', ou que n'#227'o fo' +
              'i informado seu conte'#250'do), pode ser inserido apenas seu c'#243'digo e' +
              'ntre aspas duplas Exemplo: ['#8220'00008'#8221', '#8220'00012'#8221'].')
        end
      end
      object Child16: TfrxChild
        FillType = ftBrush
        Height = 680.314960630000000000
        Top = 12166.307070000000000000
        Width = 1099.843230000000000000
        Child = frxHelp.Child18
        StartNewPage = True
        object Memo103: TfrxMemoView
          Left = 71.811023620000000000
          Top = 325.039580000000600000
          Width = 888.188976380000000000
          Height = 309.921460000000000000
          Memo.UTF8W = (
            'Explicando imagem da transcri'#231#227'o, linha a linha.'
            ''
            'Linha 1, abertura/in'#237'cio da lista;'
            ''
            
              'Linha 2, representa'#231#227'o do item '#8220'00008'#8221'. Neste caso, o elemento '#233 +
              ' do tipo N/A, que n'#227'o tem conte'#250'do. Elemento que n'#227'o tem conte'#250'd' +
              'o ou n'#227'o ser'#225' inserido, pode ser informado apenas seu c'#243'digo. O ' +
              'c'#243'digo deve estar entre aspas duplas '#8211' '#8220'00008'#8221'. A v'#237'rgula ap'#243's o' +
              ' c'#243'digo tem a fun'#231#227'o de separar os itens da lista e '#233' obrigat'#243'ri' +
              'a quando houver mais de um elemento.'
            ''
            'Linha 3, representa'#231#227'o do item '#8220'000012'#8221
            ''
            
              'Na pr'#243'xima linha come'#231'a a representa'#231#227'o de elemento composto de ' +
              'duas informa'#231#245'es: c'#243'digo do item e conte'#250'do. '
            ''
            'Linha 4, abertura do pr'#243'ximo elemento;'
            'Linha 5, informa'#231#227'o do c'#243'digo do item;'
            'Linha 6, informa'#231#227'o do conte'#250'do do item;'
            
              'Linha 7, fechamento do elemento e v'#237'rgula para separar o pr'#243'ximo' +
              ' elemento.'
            
              'Linhas 8 a 11, representa'#231#227'o do elemento composto de c'#243'digo do i' +
              'tem e conte'#250'do, assim como o anterior iniciado na linha 4.'
            'Linha 12, t'#233'rmino/fechamento da lista.')
        end
        object Memo104: TfrxMemoView
