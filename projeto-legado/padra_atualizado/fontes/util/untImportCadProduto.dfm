        object Memo64: TfrxMemoView
          Left = 94.488250000000000000
          Width = 986.457330000000000000
          Height = 34.015770000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsItalic]
          Memo.UTF8W = (
            
              '      A coluna A (C'#243'digo do Produto) dever'#225' ser formatada para T' +
              'exto mesmo quando vazio, pois o arquivo em excel ser'#225' convertido' +
              ' para CSV, para otimizar o processamento dos dados.'
            
              'Caso este processo n'#227'o seja realizado ao converter para CSV, ira' +
              ' faltar a Coluna (A)')
          ParentFont = False
        end
        object Memo65: TfrxMemoView
          Left = 94.488250000000000000
          Top = 34.015769999999970000
          Width = 986.457330000000000000
          Height = 34.015770000000000000
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clBlack
          Font.Height = -13
          Font.Name = 'Arial'
          Font.Style = [fsItalic]
          Memo.UTF8W = (
            
              '      Os campos texto como Coluna G (Descri'#231#227'o), n'#227'o podem conte' +
              'r ";", como o arquivo vai ser convertido em CSV separado por pon' +
              'to e virgula(;), ocorrer'#225' erros indesejados.')
          ParentFont = False
        end
