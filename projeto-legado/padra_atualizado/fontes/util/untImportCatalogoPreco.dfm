          Memo.UTF8W = (
            
              'Na Coluna T (Outros Valores) existe uma configura'#231#227'o "CFG_DOVCPP' +
              '" que define qual descri'#231#227'o ir'#225' compor esse campo. Por isso no C' +
              'adastro de Produtos o mesmo poder'#225' estar com outro nome por caus' +
