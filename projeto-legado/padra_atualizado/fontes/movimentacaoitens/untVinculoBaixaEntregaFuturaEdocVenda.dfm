        object Memo5: TfrxMemoView
          Left = 7.559060000000000000
          Top = 147.401670000000000000
          Width = 729.449290000000000000
          Height = 60.472480000000000000
          Memo.UTF8W = (
            
              '      A '#225'rea em azul '#233' onde podemos digitar a nota x922 a ser vi' +
              'nculada, ou pode usar o bot'#227'o do grid, que '#233' onde podemos abrir ' +
              'a consulta, e selecionar o documento desejado.'
            
              '      Ao confirmar e encontrar o documeto ser'#225' alterado o campo ' +
              'Qtd. Vinc. '
            
              '      Caso a quantidade n'#227'o for suficiente criar'#225' mais um regist' +
              'ro, para possibilitar fazer um novo v'#237'nculo.')
        end
      end
