      fatVenda.fltImpFed := FieldByName('ITE_IMPFED').AsFloat;
      fatVenda.fltDesOpe := FieldByName('ITE_DESOPE').AsFloat;
      fatVenda.fltPreMed := FieldByName('ITE_PREMED').AsFloat;
      fatVenda.fltPreUlt := FieldByName('ITE_PREULT').AsFloat;
      fatVenda.fltImpUlt := FieldByName('ITE_IMPULT').AsFloat;
      fatVenda.strCodCmg := FieldByName('ITE_CODCMG').AsString;
      fatVenda.fltSomaColorantes := FieldByName('ITE_SOMCOL').AsFloat;

      strRecalcularPrecosFdoIte := FieldByName('ITE_FDOITERECALC').AsString;

      strEmpPrdAlt := FieldByName('ITE_EMPPRD').AsString;

      fatVenda.IDKitPromocao := FieldBYName('ITE_PROKIT').AsString;

      if blnEnabledVariasChapasLote then
        edtQtdChapas.Text := FormatFloat(edtQtdChapas.EditFormat, FieldByName('ITE_QTDCHA').AsFloat);

      blnMantemPrecoUnitario := (FieldByName('ITE_MNTPRC').AsString = 'S');
    End;

    pCarregaItensAlteracao(False);

    pAtualizaUnitarioLiquido;

    pArmazenaInformacaoItem;

    pCarregaUltimaVenda;

    dtaEntLib := StrToDateDef(mskDtaEnt.Text, EncodeDate(9999, 12, 31));

  Finally
