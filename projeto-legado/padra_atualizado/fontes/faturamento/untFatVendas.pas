function TfrmFatVendas.fValidaCreditosProfissionalParaEmissaoBrinde: Boolean;
begin
  Result := True;

  If (strOpcDoc = 'BR') And (fCfgSis('TCOPRO') = '1') And (fCfgSis('VERCRP') <> 'N') And (fCfgSis('DEBBRP', VarString) = 'S') Then
  Begin
    If (fClienteProfissional(fatVenda.strCodCli)) And (Not fProfissionalTemCredito(fatVenda.strCodCli, fatVenda.fltTotGer)) Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Profissional não possui crédito suficiente.');
      objLiberacao.objMsgLibera.pAddSeparador(67);
      objLiberacao.objMsgLibera.pAddTextoCaption('Saldo da comissão do profissional', FormatFloat('#,##0.00', fTotalCreditosProfissional(fatVenda.strCodCli)), 36, alDireita, teAmbos, '', 15);
      objLiberacao.objMsgLibera.pAddTextoCaption('Total do brinde'                  , FormatFloat('#,##0.00', fatVenda.fltTotGer)                            , 36, alDireita, teAmbos, '', 15);
      objLiberacao.objMsgLibera.pAddSeparador(67);

      objLiberacao.strDirAce := 'VERCRP';
      objLiberacao.blnTraTel := fCfgSis('VERCRP') = 'T';
      objLiberacao.strMsgSen := 'Profissional não possui crédito suficiente.';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

      If (Not objLiberacao.fLibera) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

  {****************************************************}
  {* SE FOR FORMA DE PAGAMENTO CARTÃO DE CRÉDITO E    *}
  {* FOR TROCA NÃO PODE SER NEGATIVO O VALOR FINAL    *}
  {* SENÃO NÃO VAI GRAVAR MOVMOD E NEM CARTÃO DANDO   *}
  {* ERRO NO RELATÓRIO DE EMISSÃO DIÁRIA MOD2 NO      *}
  {* RESUMO DE MODALIDADES                            *}
  {*************************************************AF*}
  If fatVenda.VS_blnUsaFpg And (strOpcDoc = 'TR') Then
  Begin
    If Pos(fatVenda.strCodFpg,'007') > 0 Then
    Begin
      If fFormataFloat(fatVenda.fltTotGer,2) < 0 Then
      Begin
        fMensagem('','Valor da troca não pode ser negativo para cartão de crédito!',['&OK']);
        Result := False;
        Exit;
      End;
    End;
  End;

end;

function TfrmFatVendas.fPermiteVendaCNPJouCPF(strCodCli: String; strCodEmp: String): Boolean;
  Var
    strValorConfig : String;
    intCgcCpf: Integer;
begin
  Result := True;
  strValorConfig := fCfgSis('VNTIPP', VarString, strCodEmp);

  If strValorConfig <> '3' Then
  Begin
    intCgcCpf := fCampoTabela('CLI_CGCCPF', 'CADCLI', ['CLI_CODCLI'], [strCodCli]);
    If (strValorConfig = '1') And (intCgcCpf = 1) Then
    Begin
      fMensagem('ATENÇÃO!', 'Sdomente é permitido realizar Vendas para CPF!', ['&O k']);
      Result := False;
    End
    Else If (strValorConfig = '2') And (intCgcCpf = 2) Then
    Begin
      fMensagem('ATENÇÃO!', 'Somente é permitido realizar Vendas para CNPJ!', ['&O k']);
      Result := False;
    End;
  End;
end;

function TfrmFatVendas.fPermiteTrocarClienteComCNPJouCPF(strCodCli: String): Boolean;
  Var
    cdsDados : TUniClientDataSet;
begin
  Result := True;

  If (Pos(strOpcDoc, 'OR_PD_VN_') <= 0) Then
    Exit;

  If (Not pnlEmpresa.Visible) And (fCfgSis('VNTIPP', VarString) = '3') Then
    Exit;

  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      If Not fPermiteVendaCNPJouCPF(strCodCli, cdsDados.FieldByName('ITE_EMPITE').AsString) Then
      Begin
        Result := False;
        Break;
      End;

      cdsDados.Next;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
end;

