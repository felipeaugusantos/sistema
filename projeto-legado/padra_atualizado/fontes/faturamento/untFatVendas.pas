function TfrmFatVendas.fValidaDataEntregaPedidoHeranca():Boolean;
Var
  cdsDados : TUniClientDataSet;
  strCodEmpTrava: String;
  stlItens: TStringList;
begin
  Result := True;

  If (Not fCfgSis('CONENT', varBoolean)) Then
    Exit;

  If (Not blnHerancaOrcamentoPedido) Then
    Exit;

  If Not Assigned(fatVenda.objConEnt) Then
    Exit;

  cdsDados := TUniClientDataSet.Create(Nil);
  stlItens := TStringList.Create;
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.Filtered := False;
    cdsDados.Filter := 'ITE_ENTRET = ''E'' AND ((ITE_ENTFUT = ''S'' AND ITE_MOTFUT = ''P'') OR (ITE_ENTFUT <> ''S''))';
    cdsDados.Filtered := True;

    cdsDados.First;
    While (Not cdsDados.Eof) Do
    Begin
      strCodEmpTrava := IIF(fatVenda.objConEnt.fEhControleDeEntregaRomaneioMultiloja,
                            cdsDados.FieldByName('ITE_EMPITE').AsString,
                            VS_strCodEmp);

      If (Not fatVenda.objConEnt.fDataExisteNaMatriz(cdsDados.FieldByName('ITE_DTENTR').AsDateTime, fatVenda.objConEnt.arrDtaOri)) Then
      Begin
        If (Not fatVenda.objConEnt.fDataDisponivel(cdsDados.FieldByName('ITE_DTENTR').AsDateTime, strCodEmpTrava)) Then
        Begin
          stlItens.Add(cdsDados.FieldByName('ITE_CODITE').AsString + ' - ' +
                       cdsDados.FieldByName('ITE_DESITE').AsString + ' - ' +
                       'Data: ' + FormatDateTime('dd/MM/yyyy', cdsDados.FieldByName('ITE_DTENTR').AsDateTime));
          Result := False;
        End;
      End;

      cdsDados.Next;
    End;

    If (Not Result) Then
      fMensagem('ATENÇÃO!', 'Data não disponível para entrega dos seguintes itens:' + #10+#13+ stlItens.Text, ['&Ok']);
  Finally
    FreeAndNil(cdsDados);
    FreeAndNil(stlItens);
  End;
end;

