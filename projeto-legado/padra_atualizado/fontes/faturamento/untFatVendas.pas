function TfrmFatVendas.fItemEstaEmRomaneioRetNumRom(strCodIte, strTabela, strAutInc: String; Var strNumRom: String): Boolean;
  Var
    strSQL: String;
    qryGen: TUniQuery;
    qryNot: TUniQuery;
    qryDoc: TUniQuery;
begin
  qryGen := fCriaQuery(Nil);
  qryNot := fCriaQuery(Nil);
  qryDoc := fCriaQuery(Nil);
  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE            ';
    strSQL := strSQL + '   GER_NUMROM                  ';
    strSQL := strSQL + ' FROM                          ';
    strSQL := strSQL + '   ROMGERX G                   ';
    strSQL := strSQL + '   INNER JOIN ROMDETX D ON D.DET_SEQGER = G.AUTOINCREM ';
    strSQL := strSQL + ' WHERE                         ';
    strSQL := strSQL + '   D.DET_CODITE  = :CODITE AND ';
    strSQL := strSQL + '   G.GER_NUMDOC  = :NUMDOC AND ';
    strSQL := strSQL + '   G.GER_ESPDOC  = :ESPDOC AND ';
    strSQL := strSQL + '   G.GER_CODEMP  = :CODEMP AND ';
    strSQL := strSQL + '   G.GER_DTABAI IS NULL AND    ';
    strSQL := strSQL + '   NOT EXISTS (SELECT R.AUTOINCREM ';
    strSQL := strSQL + '               FROM ROMTRAX R ';
    strSQL := strSQL + '               WHERE G.AUTOINCREM = R.TRA_SEQGER) ';

    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strSQL);
    qryGen.ParamByName('CODITE').AsString := strCodIte;
    qryGen.ParamByName('NUMDOC').AsString := strDocDev;
    qryGen.ParamByName('ESPDOC').AsString := strEspDev;
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryGen.Open;
    If qryGen.IsEmpty then
      Result := False
    Else
    Begin
      strNumRom := qryGen.FieldByName('GER_NUMROM').AsString;
      Result := True;
    End;

    If (Not Result) And (strTabela = 'NOTDET') Then
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT T.DET_SEQDET FROM NOTDET D ';
      strSQL := strSQL + '   INNER JOIN NOTTRI T ON D.AUTOINCREM = T.DET_SEQGER ';
      strSQL := strSQL + 'WHERE D.AUTOINCREM = :AUTINC ';

      qryNot.Close;
      qryNot.SQL.Clear;
      qryNot.SQL.Add(strSQL);
      qryNot.ParamByName('AUTINC').AsString := strAutInc;
      qryNot.Open;

      If Not qryNot.IsEmpty Then
      Begin
        strSQL := '';
        strSQL := strSQL + 'SELECT DET_NUMDOC, DET_ESPDOC, DET_CODITE FROM MOVDET ';
        strSQL := strSQL + ' WHERE AUTOINCREM = :AUTINC ';

        qryDoc.Close;
        qryDoc.SQL.Clear;
        qryDoc.SQL.Add(strSQL);
        qryDoc.ParamByName('AUTINC').AsString := qryNot.FieldByName('DET_SEQDET').AsString;
        qryDoc.Open;

        If Not qryDoc.IsEmpty Then
        Begin
          qryGen.Close;
          qryGen.ParamByName('CODITE').AsString := qryDoc.FieldByName('DET_CODITE').AsString;
          qryGen.ParamByName('NUMDOC').AsString := qryDoc.FieldByName('DET_NUMDOC').AsString;
          qryGen.ParamByName('ESPDOC').AsString := qryDoc.FieldByName('DET_ESPDOC').AsString;
          qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
          qryGen.Open;
          If Not qryGen.IsEmpty then
          Begin
            strNumRom := qryGen.FieldByName('GER_NUMROM').AsString;
            strNumRom := strNumRom + #13 +
               'Doc.Ori.: '+qryGen.ParamByName('NUMDOC').AsString+'-'+qryGen.ParamByName('ESPDOC').AsString+' '+'Doc.Cnf.: '+strDocDev+'-'+strEspDev;
            Result := True;
          End;
        End;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
    FreeAndNil(qryNot);
    FreeAndNil(qryDoc);
  End;
end;

