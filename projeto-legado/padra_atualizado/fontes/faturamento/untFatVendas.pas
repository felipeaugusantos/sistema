procedure TfrmFatVendas.pEscolheEmpresaProducaoForaLoja;
  Var
    strEmpPrdNov: String;
    strEmpPrdAnt: String;
begin
  If (cdsVenda.FieldByName('ITE_ESCPRD').AsInteger = 0) Then
    Exit;

  strEmpPrdNov := fatVenda.fEscolheEmpresaProducaoTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString);
  strEmpPrdAnt := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

  cdsVenda.Edit;
  cdsVenda.FieldByName('ITE_EMPPRD').AsString  := strEmpPrdNov;
  cdsVenda.FieldByName('ITE_ESCPRD').AsInteger := 0;
  cdsVenda.Post;

  pRecalculaTintaMaquinaSelecionadoCasoNecessario(strEmpPrdAnt);
end;

function TfrmFatVendas.fConfereEmpresaProducaoForaLoja: Boolean;
var
  prcScroll: TprcScroll;
begin

  Result := True;

  Try
    pDisableControls(cdsVenda, prcScroll);
    cdsVenda.First;
    While (Not cdsVenda.Eof) And (Result) Do
    Begin
      If (cdsVenda.FieldByName('ITE_ESCPRD').AsInteger = 1)     And
         (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
      Begin
        Result := False;
      End;

      cdsVenda.Next;
    End;

  Finally
    pEnableControls(cdsVenda, prcScroll);
  End;

  If (Not Result) Then
  Begin
    fMensagem('ATENÇÃO!', 'Há produtos de tinta de máquina pendentes para ' +
                          'alteração de empresa de produção.', ['&Ok']);
  End;

  if Result then
  begin
    Try
      pDisableControls(cdsVenda, prcScroll);
      cdsVenda.First;
      While (Not cdsVenda.Eof) And (Result) Do
      Begin
        If (cdsVenda.FieldByName('ITE_EMPPRD').AsString = VS_strCodEmp) and (edtOprFlj.Text = 'S') And
           (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') And
           //Caso somente a propria loja pode produzir a tinta nao deve travar. Req: 129319
           (fRetornaEmpresasPodemProduzirTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString) <> VS_strCodEmp) Then
        Begin
          Result := False;
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_ESCPRD').AsInteger := 1;
          cdsVenda.Post;
        End;

        cdsVenda.Next;
      End;

    Finally
      pEnableControls(cdsVenda, prcScroll);
    End;

    If (Not Result) Then
    Begin
      fMensagem('ATENÇÃO!', 'A opção "Gerar produção fora da loja?" está como "S", ' +
       'porém existem produtos sem a empresa de produção definida, selecione o produto e pressione [ESPAÇO] ', ['&Ok']);
    End;
  end;
end;

function TfrmFatVendas.fVerificaAcessoPermissaoUtilizacaoLotesRastreaveis: Boolean;
var
  blnLoteDeProdutoRastravel : Boolean;
  strEmpresa                : String;
  fltSaldoDisponivelLote    : Double;
  fltSaldoDisponivelItem    : Double;
begin

  Result := True;

  If (edtNumLot.Text = 'A DEFINIR') Then
    Exit;

  If (edtNumLot.Text = 'GARANTIA') Then
    Exit;

  If (strOpcDoc <> 'PD') Then
    Exit;

  strEmpresa := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

  blnLoteDeProdutoRastravel := fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis(strEmpresa) And
                               fProdutoRastreavel(fCodItem);

  If (blnLoteDeProdutoRastravel) Then
  Begin

    If Not fVerificaAcessoSistema('LOTCRP') Then
    Begin

      fltSaldoDisponivelLote := fRetornaSaldoDisponivel(fCodItem,
                                                        False,
                                                        True,
                                                        edtNumLot.Text,
                                                        True,
                                                        strEmpresa,
                                                        IIF(strEspOrc = 'PD', strNumOrc, ''));

      fltSaldoDisponivelItem := fRetornaSaldoDisponivel(fCodItem,
                                                        False,
                                                        True,
                                                        '',
                                                        True,
                                                        strEmpresa,
                                                        IIF(strEspOrc = 'PD', strNumOrc, ''));

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Utilização de Lotes Rastreáveis na Venda');
      objLiberacao.objMsgLibera.pAddSeparador(67);
      objLiberacao.objMsgLibera.pAddTextoCaption('Cliente ' , fatVenda.strCodCli + '-' + fatVenda.strCliNom);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor ', fatVenda.strCodVen + '-' + fatVenda.strNomVen);
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTextoCaption('Produto                           ', fCodItem + '-' + fRetNomProduto(fCodItem));
      objLiberacao.objMsgLibera.pAddTextoCaption('Lote Informado                    ', edtNumLot.Text);
      objLiberacao.objMsgLibera.pAddTextoCaption('Qtd. Digitada no Documento        ', FloatToStrF(fStrToFloat(edtQtdIte.Text), ffFixed, 12, fCfgSis('DECQTD', varInteger)));
      objLiberacao.objMsgLibera.pAddTextoCaption('Saldo Disponível do Lote          ', FloatToStrF(fltSaldoDisponivelLote, ffFixed, 12, fCfgSis('DECQTD', varInteger)));
      objLiberacao.objMsgLibera.pAddTextoCaption('Saldo Disponível Total do Produto ', FloatToStrF(fltSaldoDisponivelItem, ffFixed, 12, fCfgSis('DECQTD', varInteger)));
      objLiberacao.objMsgLibera.pAddTextoCaption('Lote Atende o Total da Venda      ', IIF(fltSaldoDisponivelLote >= fStrToFloat(edtQtdIte.Text), 'Sim', 'Não'));
      objLiberacao.objMsgLibera.pAddSeparador(67);

      objLiberacao.strDirAce := 'LOTCRP';
      objLiberacao.strMsgSen := 'Utilização de Lotes Rastreáveis na Venda';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

      Result := objLiberacao.fLibera;

    End;

  End;

end;

function TfrmFatVendas.fVerificaAlterandoPedidoReferenciadoOrcamentoTransferencia(): Boolean;
begin
  Result := True;

  {************************************************************************************}
  {* NÃO É PERMITIDO ALTERAR UM PEDIDO NO QUAL ELE FOI REFERENCIADO EM UM ORÇAMENTO   *}
  {* DE TRANSFERÊNCIA. É NECESSÁRIO CANCELAR O ORÇAMENTO PARA PODER ALTERAR O PEDIDO. *}
  {*********************************************************************************FC*}
  FVariaveisFechamentoVenda.strNumOrcRef := '';
  FVariaveisFechamentoVenda.strEmpOrcRef := '';

  If SameText(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'PD') And
     SameText(fatVenda.strOpcDoc, 'VN')               And
     fEhPedidoRefenciadoHaUmOrcamento(strNumOrc,
                                      strEmpOrc,
                                      FVariaveisFechamentoVenda.strNumOrcRef,
                                      FVariaveisFechamentoVenda.strEmpOrcRef)   Then
  Begin
    pMensagemOk('Não é possível alterar um pedido no qual ele foi referenciado à um orçamento de transferência. ' +
                'Cancele a OR-' + FVariaveisFechamentoVenda.strNumOrcRef + '-' + FVariaveisFechamentoVenda.strEmpOrcRef + ', para depois alterar este pedido.');
    Result := False;
    Exit;
  End;

end;

function TfrmFatVendas.fVerificaCamposInterna: Boolean;
Var
  blnExit: Boolean;
begin
  Result := fVerificaCampos;

