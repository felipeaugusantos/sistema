    //SE NAO VALIDOU OS SALDOS DOS PRODUTOS NAO DEVE MOSTRAR AS INFORMACOES DO CLIENTE
    //JA QUE NAO IRA ABRIR A TELA DE VENDA MESMO
    If fatVenda.blnFecharForm Then
