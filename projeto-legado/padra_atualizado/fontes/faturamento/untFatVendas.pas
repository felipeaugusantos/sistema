procedure TfrmFatVendas.pLimpaDadosItem(blnManterEmpresaDeFaturamentoDigitada : Boolean = False);
var
  strEmpresaDeFaturamentoDigitada : String;
  blnManterEmpresa : Boolean;
begin

  strEmpresaDeFaturamentoDigitada := edtCodEmp.Text;
  blnManterEmpresa := (blnManterEmpresaDeFaturamentoDigitada Or fatVenda.blnCarregandoEstrutura) And (Not fEmptyStr(strEmpresaDeFaturamentoDigitada));

  fatVenda.blnTintaMaquinaEmExecussao := False;
  pLimpaVariaveisReferentesAoProduto;

  pLimpaPanel(pnlDadosItem);
  pLimpaPanel(pnlEmpresa);

  pHabilitarMetragem('','');

  pAtualizaUnitarioLiquido;

  If fatVenda.blnAbastecimentoDeposito Then
  Begin
    edtCodEmp.Text := fatVenda.strEmpresaAbastecimentoDeposito;
    if fCfgSis('NOMEMP') = '2' then
      edtNomEmp.Text := fRetFantasiaEmpresa(fatVenda.strEmpresaAbastecimentoDeposito)
    else
      edtNomEmp.Text := fRetNomeEmpresa(fatVenda.strEmpresaAbastecimentoDeposito);

    strEmpAnt := fatVenda.strEmpresaAbastecimentoDeposito;
  End
  Else If fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo Then
  Begin
    edtCodEmp.Text := fatVenda.strEmpresaRegimeEspecialPorEmpresa;
    if fCfgSis('NOMEMP') = '2' then
      edtNomEmp.Text := fRetFantasiaEmpresa(fatVenda.strEmpresaRegimeEspecialPorEmpresa)
    else
      edtNomEmp.Text := fRetNomeEmpresa(fatVenda.strEmpresaRegimeEspecialPorEmpresa);

    strEmpAnt := fatVenda.strEmpresaRegimeEspecialPorEmpresa;
  End
  Else If Not fEmptyStr(fatVenda.strEmp_TE) Then
  Begin
    edtCodEmp.Text := fatVenda.strEmp_TE;
    if fCfgSis('NOMEMP') = '2' then
    begin
      edtNomEmp.Text := fRetFantasiaEmpresa(fatVenda.strEmp_TE);
    end
    else
    begin
      edtNomEmp.Text := fRetNomeEmpresa(fatVenda.strEmp_TE);
    end;

    strEmpAnt      := fatVenda.strEmp_TE;
  End
  Else If fatVenda.blnEmpFat Then
  Begin

    If (blnManterEmpresa) Then
      edtCodEmp.Text := strEmpresaDeFaturamentoDigitada
    Else
    If Not fEmptyStr(fCfgSis('SUGEMP', varString)) Then
      edtCodEmp.Text := fCfgSis('SUGEMP', varString)
    Else
    If Not fEmptyStr(strCodEmpDef) Then
      edtCodEmp.Text := strCodEmpDef
    Else
      edtCodEmp.Text := VS_strCodEmp;

    if fCfgSis('NOMEMP') = '2' then
      edtNomEmp.Text := fRetFantasiaEmpresa(edtCodEmp.Text)
    else
      edtNomEmp.Text := fRetNomeEmpresa(edtCodEmp.Text);

    strEmpAnt      := edtCodEmp.Text;
  End;

  If (not fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo) and (fCfgSis('IDEEMP', varString) = 'S') And (Not fEmptyStr(edtCodCli.Text)) Then
  Begin
    If ((Pos(strOpcDoc, 'PD_OR_') > 0) And (fCfgSis('EMPFAT', varString) = 'S')) Or
       ((strOpcDoc = 'VN') And (fCfgSis('EMPFVN', varString) = 'S')) Then
    Begin
      edtCodEmp.Text := fCampoTabela('CLI_EMPIDE', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text]);

      If fEmptyStr(edtCodEmp.Text) Then
      Begin
        edtCodEmp.Text := strEmpAnt;
      End
      Else
      Begin
        strEmpAnt := edtCodEmp.Text;
        If fCfgSis('OBEMID', varBoolean) Then
        Begin
          edtCodEmp.Enabled := False;
        End;
      End;

      If fCfgSis('NOMEMP') = '2' Then
        edtNomEmp.Text := fRetFantasiaEmpresa(edtCodEmp.Text)
      Else
        edtNomEmp.Text := fRetNomeEmpresa(edtCodEmp.Text);
    End;
  End;

  pnlEmpresa.Enabled := fEmptyStr(fatVenda.strEmp_TE) and (not fatVenda.blnAbastecimentoDeposito) and (not fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo);

  mnuAltEmpItem.Visible  := (pnlEmpresa.Enabled And fatVenda.blnEmpFat);
  mnuAltEmpItens.Visible := (pnlEmpresa.Enabled And fatVenda.blnEmpFat) or fatVenda.blnAbastecimentoDeposito or fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo;

  If cbTabPrecoItem.Items.IndexOf('P') >= 0 Then
    cbTabPrecoItem.Items.Delete(cbTabPrecoItem.Items.IndexOf('P'));

  cbTabPrecoItem.Text := '';
  strTabPreItePrincipalAnt := EmptyStr;
  strTabPreCarregadoDoItem := EmptyStr;

  If (Not cbTabPrecoItem.Enabled) Then
    cbTabPrecoItem.Enabled := True;

  if not blnItemAgregado then
    strTabPreIteAnt     := '';

  strEmpIteAnt := '';
  blnAltEmpIte := False;

  pSetaCampoDestino;

  mskDtaEnt.Clear;
  cmbEntRetChange(nil);

  cmbCliBus.ItemIndex :=  0;
  cmbTurEnt.ItemIndex := -1;

  blnUltVen := False;

  chkBrinde.Checked := chkBrinde.Visible And (strOpcDoc = 'BR');
  strTipBri := '';
  strCodPar := '';
  blnInserindoBrindeDV := False;

  pMostraLote(False);
  pMostraColunaLote;

  strCodAtu := '';
  blnTraIte := False;
  strTabAntTra := '';
  fltPreAntTra := 0;

  chkPegou.Checked := False;
  chkBaseDeTroca.Visible := False;
  chkBaseDeTroca.Checked := False;
  intEntRetAnt := -1;

  If cbTabPreco.Visible Then
  Begin
    If (Pos(cbTabPreco.Text, '1_2_3_4_5_6_7_') > 0) Then
      fatVenda.strTabPre := cbTabPreco.Text
    Else If fValidaCampos(cbTabPreco, True) Then
      fatVenda.strTabPre := cbTabPreco.Text;
  End;

  If cbTabPrecoItem.Visible Then
  Begin
    If fEmptyStr(strTabPreIteAnt) Then
      cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(fatVenda.strTabPre)
    Else
      cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(strTabPreIteAnt)
  End;

  fatVenda.IDKitPromocao := '';
  blnInformouNumerosDeSerie := False;
  blnLibQMDPEI := False;
  strIteAnt := '';
  if not blnInserindoMaisUmItemPeloCodBar then
    blnTipBusCodBar := False;
end;

