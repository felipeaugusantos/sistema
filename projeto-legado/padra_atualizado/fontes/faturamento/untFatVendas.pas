  procedure pAtualizaPreTabVarTab(const strTabela : String);
  begin
    With cdsVenda Do
    Begin
      If fEmptyStr(strTabela) Or (FieldByName('ITE_PREVE' + strTabela).AsFloat = 0) Then
        FieldByName('ITE_PRETAB').AsFloat := FieldByName('ITE_UNIORI').AsFloat
      Else
        FieldByName('ITE_PRETAB').AsFloat := FieldByName('ITE_PREVE' + strTabela).AsFloat +
                               fFormataFloat(FieldByName('ITE_PREVE' + strTabela).AsFloat *
                                            (FieldByName('ITE_TAXJUR').AsFloat / 100.0), fatVenda.VS_intDecUni);

      FieldByName('ITE_PRETAB').AsFloat := fFormataFloat(FieldByName('ITE_PRETAB').AsFloat, fatVenda.VS_intDecUni);

      If fCfgSis('PRETAB', varBoolean) Then
      Begin
        If FieldByName('ITE_PRETAB').AsFloat <> 0 Then
          FieldByName('ITE_VARTAB').AsFloat := ((FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_PRETAB').AsFloat) - 1) * 100;
      End
      Else
      Begin
        If FieldByName('ITE_UNIORI').AsFloat <> 0 Then
          FieldByName('ITE_VARTAB').AsFloat := ((FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_UNIORI').AsFloat) - 1) * 100;
      End;
    End;
  end;

  function fEmTransf: Boolean;
  begin
    Result := False;
    If Assigned(fatVenda) Then
      Result := (Not fEmptyStr(fatVenda.strEmp_TE)) And (fatVenda.blnCliFil);
  end;

  function fDataSetIteger: TDataSet;
  begin
    If ((strIdePro = 'NOR') And
        (blnAlternouEntreClienteFilialClienteComum Or
         fEmTransf Or
         Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado Or
         Self.blnRecalculandoPrecosAbaDep Or
         blnAlternouEntreDoisClientesFiliais)) Then
      Result := qryConIte
    Else
      Result := cdsVenda;
  end;

  procedure pCarregaPrecosAtuais(const strTabela : String);
  begin
    With cdsVenda Do
    Begin
      FieldByName('ITE_PRECOM').AsFloat := qryConIte.FieldByName('ITE_PRECOM').AsFloat;
      FieldByName('ITE_PREVE1').AsFloat := qryConIte.FieldByName('ITE_PREVE1').AsFloat;
      FieldByName('ITE_PREVE2').AsFloat := qryConIte.FieldByName('ITE_PREVE2').AsFloat;
      FieldByName('ITE_PREVE3').AsFloat := qryConIte.FieldByName('ITE_PREVE3').AsFloat;
      FieldByName('ITE_PREVE4').AsFloat := qryConIte.FieldByName('ITE_PREVE4').AsFloat;
      FieldByName('ITE_PREVE5').AsFloat := qryConIte.FieldByName('ITE_PREVE5').AsFloat;
      FieldByName('ITE_PREVE6').AsFloat := qryConIte.FieldByName('ITE_PREVE6').AsFloat;
      FieldByName('ITE_PREVE7').AsFloat := qryConIte.FieldByName('ITE_PREVE7').AsFloat;

      FieldByName('ITE_PREATU').AsFloat := FieldByName('ITE_PREVE' + IIF(fEmptyStr(strTabela), '1', strTabela)).AsFloat;

      FieldByName('ITE_UNIORI').AsFloat := fatVenda.fltUniOri;
      FieldByName('ITE_UNIVIS').AsFloat := fatVenda.fltUniVis;

      If (fFormataFloat(qryConIte.FieldByName('ITE_PREULT').AsFloat, 2) <> 0.00) Then
      Begin
        FieldByName('ITE_PREULT').AsFloat := fFormataFloat(qryConIte.FieldByName('ITE_PREULT').AsFloat, 2);
        FieldByName('ITE_TOTULT').AsFloat := fFormataFloat(FieldByName('ITE_PREULT').AsFloat * FieldByName('ITE_QTDITE').AsFloat, 2);
      End;

      If (fFormataFloat(qryConIte.FieldByName('ITE_IMPULT').AsFloat, 2) <> 0.00) Then
      Begin
        FieldByName('ITE_IMPULT').AsFloat := fFormataFloat(qryConIte.FieldByName('ITE_IMPULT').AsFloat, 2);
        FieldByName('ITE_TOTIMP').AsFloat := fFormataFloat(FieldByName('ITE_IMPULT').AsFloat * FieldByName('ITE_QTDITE').AsFloat, 2);
      End;
    End;
  end;

  procedure pCalculaTotGerIte;
  begin
    If (Not blnFechamentoVenda) Or ((fCfgSis('CNDPES', varBoolean)) And (Self.blnZerarDescontoDoItemRecalculoPrecos)) Then
    Begin
      fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
      pCalculaCustoRealTintaMaquinaSelecionado;
    End;
  end;

begin
  Result := false;

  blnChamouRecalculoTabelaPrecoTinta := False;
  If blnRecalculaTabelaTintasPrecos Then
  Begin
    pInformacao('Calculando Tabelas de Preços Tintas...', pgbStatus);
    fatVenda.pRecalculaTabelasPrecoTinta(True, True, blnRecalculandoPrecosAbaDep);
    If (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela) Then
      blnChamouRecalculoTabelaPrecoTinta := True;
  End;

  pInformacao('Recalculando Preços, Aguarde...', pgbStatus);

  blnAlternouEntreClienteFilialClienteComum := False;
  If (Self.strCliAnt <> '') Then
  Begin
    strCliFilDestaEmpresa := fRetornaClienteFilial(VS_strCodEmp);

    blnAlternouEntreClienteFilialClienteComum :=
      ((strCliFilDestaEmpresa = edtCodCli.Text) And (strCliFilDestaEmpresa <> Self.strCliAnt)) Or
      ((strCliFilDestaEmpresa <> edtCodCli.Text) And (strCliFilDestaEmpresa = Self.strCliAnt));
  End;

  blnAlternouEntreDoisClientesFiliais := False;
  If (Self.strCliAnt <> '') And (edtCodCli.Text <> '') And (Self.strCliAnt <> edtCodCli.Text) Then
  Begin
    If fClienteFilial(Self.strCliAnt) And fClienteFilial(edtCodCli.Text) Then
      blnAlternouEntreDoisClientesFiliais := True;
  End;

  If fEmptyStr(strTabPre) then
    strTabPre := '1';

  If fEmptyStr(fatVenda.strTabPre) then
    fatVenda.strTabPre := '1';

  fatVenda.intPrzMed := fFloatToInt(fCalcMediaPagto(fatVenda.strConPag));

  blnLimpouDicionario := False;

  With cdsVenda Do
  Begin

    First;

    While Not Eof Do
    Begin
      pProgresso(RecNo, RecordCount, pgbStatus);

      strEmpItePro := fatVenda.fGetEmpPrecoPromoItem(fEmpIte, FieldByName('ITE_EMPDMP').AsString);

      If FieldByName('ITE_BRINDE').AsString = 'S' Then
      Begin
        Next;
        Continue;
      End;

      //Deve recalcular os precos somente dos itens da mesma promocao coletiva Req: 74451
      If Not fEmptyStr(strCodigoPromocaoColetiva) Then
      Begin
        If TProQtdColetiva.fGetCodPro(FieldByName('ITE_CODITE').AsString) <> strCodigoPromocaoColetiva Then
        Begin
          Next;
          Continue;
        End;
      End;

      If blnRecalcularSomenteItensTinta Then
      Begin
        If (FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
        Begin
          Next;
          Continue;
        End;
      End;

      If blnRecalculaItemKit Then
      Begin
        If (fatVenda.stlItensNaoTemPromocaoKit.IndexOf(FieldByName('ITE_CODITE').AsString) > -1) Then
        Begin
          Next;
          Continue;
        End;
      End;

      pAbreQryConIte;

      fltUniDigOriginal := FieldByName('ITE_UNIDIG').AsFloat;

      strCodBarEmb := FieldByName('ITE_BAREMB').AsString;

      fatVenda.strIteCom := 'N';

      strIdePro := FieldByName('ITE_IDEPRO').AsString;

      fatVenda.strIdePro := strIdePro;
      fatVenda.strIteTin := FieldByName('ITE_ITETIN').AsString;
      TProQtdColetiva.strRshTinAtual := FieldByName('ITE_ITETIN').AsString;

      blnItemEspecial := (Pos('ITEM ESPECIAL', FieldByName('ITE_DESORI').AsString) > 0);

      fatVenda.fltPreVe1 := FieldByName('ITE_PREVE1').AsFloat;
      fatVenda.fltPreVe2 := FieldByName('ITE_PREVE2').AsFloat;
      fatVenda.fltPreVe3 := FieldByName('ITE_PREVE3').AsFloat;
      fatVenda.fltPreVe4 := FieldByName('ITE_PREVE4').AsFloat;
      fatVenda.fltPreVe5 := FieldByName('ITE_PREVE5').AsFloat;
      fatVenda.fltPreVe6 := FieldByName('ITE_PREVE6').AsFloat;
      fatVenda.fltPreVe7 := FieldByName('ITE_PREVE7').AsFloat;
      fatVenda.fltPreLot := FieldByName('ITE_PRELOT').AsFloat;

      If blnRecacularItensPromocaoQtdMin And (fCfgSis('UTIVMP', varString) = 'S') Then
      Begin
        If (Length(objPromVlrMinTotalProdutos.ArrItemPro) = 0) Then
          Break;

        If Not objPromVlrMinTotalProdutos.fCodItePossuiPromo(FieldByName('ITE_CODITE').AsString) Then
        Begin
          Next;
          Continue;
        End;

        If Not fVerificaPodeRecalcularItemPromocaoVlrMin(cdsVenda.FieldByName('ITE_CODITE').AsString)  Then
        Begin
          Next;
          Continue;
        End;
      End;

      {************************************}
      { DEFINI A TABELA DE PRECO DE ACORDO }
      { COM A CONFIGURACAO                 }
      {*********************************JB*}
      If (strIdePro = 'NOR') Then
      Begin
        strTabPreEmbTmp := fRetornaTabPreCodBarraEmb(FieldByName('ITE_CODITE').AsString,
                                                     FieldByName('ITE_BAREMB').AsString);

        If (Not fEmptyStr(FieldByName('ITE_BAREMB').AsString)) And
           (fCfgSis('PRVEMB', VarBoolean))                     And
           (Not fEmptyStr(strTabPreEmbTmp))                    And
           (Not SameText(strTabPreEmbTmp, 'F'))                Then
        Begin
          If fCfgSis('PREEMB', VarInteger) = 2 Then
            strTabela := FieldByName('ITE_TABPRE').AsString
          Else
          Begin
            Next;
            Continue;
          End;
        End
        Else
        Begin
          If (fCfgSis('TABITE', varBoolean) Or (strOpcDoc = 'CP')) And
             (Not blnAltTabRecalculoPrecos) And (FieldByName('ITE_TABPRE').AsString <> '') Then
            strTabela := FieldByName('ITE_TABPRE').AsString
          Else
           strTabela := fatVenda.strTabPre;
        End;
      End
      Else
      Begin

        If (fCfgSis('PRTTIN') = 'S') Then
        Begin
          If (fCfgSis('TABITE', varBoolean) Or (strOpcDoc = 'CP')) And
           (Not blnAltTabRecalculoPrecos) And (FieldByName('ITE_TABPRE').AsString <> '') Then
            strTabela := FieldByName('ITE_TABPRE').AsString
          Else
            strTabela := fatVenda.strTabPre;
        End
        Else If fEmptyStr(fatVenda.strTabTin) And fEmptyStr(fTabelaPrecoClienteOuVendedor) Then
        Begin
          strTabela := fatVenda.strTabPre;
        End
        Else
        Begin
          If fEmptyStr(fatVenda.strTabTin) Then
            strTabela := fTabelaPrecoClienteOuVendedor
          Else
            strTabela := fatVenda.strTabTin;
        End;

        //strTabela := fatVenda.fTabelaPrecoTinta(edtCodCli.Text, strOpcDoc, FieldByName('ITE_TABPRE').AsString, True, False, blnAltTabRecalculoPrecos);
      End;

      If fEmptyStr(strTabela) Then
      Begin
        If cbTabPrecoItem.Visible Then
          strTabela := FieldByName('ITE_TABPRE').AsString;
        If fEmptyStr(strTabela) Then
          strTabela := cbTabPreco.Text;
      End;

      If (fEmptyStr(strTabela)) Or (Not fValidouTabelaPrecoConsulta(strTabela)) Then
        Raise ExceptionAutcom.Create('A tabela de preços informada para recálculo dos preços é inválida.');

      If (Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado) Then
      Begin
        pAbreQryConIte;
        fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                      qryConIte.FieldByName('ITE_CODEMP').AsString,
                                      strTabela);

        If (cdsVenda.FieldByName('ITE_CUSITE').AsFloat = fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)) Then
        Begin
          Next;
          Continue;
        End
        Else If (Not blnLimpouDicionario) Then
        Begin
          fatVenda.pEsvaziaCdsIteger;
          TLimparCaches.Execute;
          blnLimpouDicionario := True;
        End;
      End;

      {*********************************************}
      {* ATUALIZA A VARIAVEL DO PREÇO COM DESCONTO *}
      {* PARA PODER USA-LA NO RECALCULO.           *}
      {* fltProPreVen                             *}
      {******************************************AC*}
      If (strIdePro = 'NOR') or
         ((strIdePro <> 'NOR') And
         ( (TProQtdColetiva.fEhTintaComPromocaoCompostaPorKit(cdsVenda.FieldByName('ITE_ITETIN').AsString))) Or
           (fItemPromocaoVlrMin(FieldByName('ITE_CODITE').AsString))) then
      Begin
        fatVenda.strPromoc := 'N';
        If ((fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(FieldByName('ITE_CODITE').AsString, strEmpItePro))) Or
           ((strIdePro <> 'NOR') And
           (TProQtdColetiva.fEhTintaComPromocaoCompostaPorKit(cdsVenda.FieldByName('ITE_ITETIN').AsString))) Then
        Begin
          If ((strIdePro <> 'NOR') Or ((strIdePro = 'NOR') And fEmptyStr(FieldByName('ITE_CODACA').AsString))) And
             (fRetornaPrecoPromocaoPelaTabIte(FieldByName('ITE_PROMOC').AsString = 'S')) Then
          Begin
            If fRetornaPrecosPromocao(FieldByName('ITE_CODITE').AsString,  //aqui promoc
                                      edtCodCli.Text,
                                      VS_Date,
                                      FieldByName('ITE_QTDITE').AsFloat,

                                      fatVenda.fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,'',
                                        FieldByName('AUTOINCREM').AsString,'', '',strEmpItePro, False),

                                      fatVenda.fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,'',
                                        FieldByName('AUTOINCREM').AsString,'', '',strEmpItePro, False,
                                        False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,True {Somente em promocao}),

                                      fatVenda.intPrzMed,
                                      fatVenda.fltProPreCus,
                                      fatVenda.fltProPreVen,
                                      fatVenda.fltProComVar,
                                      fatVenda.fltProComAta,
                                      fatVenda.fltProComDis,
                                      fltQtdDis,
                                      fatVenda.fltProDesF07,
                                      fatVenda.strComPro,
                                      fatVenda.strCodPro,
                                      blnParticiona,
                                      blnPromo,
                                      strTabela,
                                      fatVenda.strCodCnd,
                                      '',
                                      '',
                                      True,
                                      False,
                                      '-1',
                                      ((FieldByName('ITE_ENTRET').AsString = 'E') And (FieldByName('ITE_ENTFUT').AsString = 'N')),
                                      ((FieldByName('ITE_ENTRET').AsString = 'E') And (FieldByName('ITE_ENTFUT').AsString = 'S')),
                                      FieldByName('ITE_MOTFUT').AsString,
                                      strEmpItePro,
                                      strNumOrc,
                                      strEspOrc,
                                      Nil,
                                      False,
                                      '',
                                      objPromVlrMinTotalProdutos,
                                      FieldByName('ITE_ITETIN').AsString,
                                      FieldByName('ITE_SOMCOL').AsFloat) Then
            Begin
              If (Not blnParticiona) Then
                fatVenda.strPromoc := 'S';

              If (Pos(strOpcDoc, 'PD_OR_VN_CS_') > 0) And (FieldByName('ITE_PROMOC').AsString = 'S') And (fatVenda.strPromoc = 'N') Then
              Begin
                If fValidaPromocao(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_QTDITE').AsFloat) Then
                  fatVenda.strPromoc := 'S'
                Else
                  fatVenda.strPromoc := 'N';
              End;
            End;
          End;
        End;
      End
      Else
        fatVenda.strPromoc := FieldByName('ITE_PROMOC').AsString;

      If (intSeqItemEstruturaRecalcular > 0) And
         (FieldByName('ITE_SEQEST').AsInteger <> intSeqItemEstruturaRecalcular) Then
      Begin
        Next;
        Continue;
      End;

      blnItemEntrouOuSaiuDePromocao := fatVenda.strPromoc <> FieldByName('ITE_PROMOC').AsString;

      If blnRecalculaSomenteItensQueEntraramOuSairamDePromocao And
        (fatVenda.strPromoc = FieldByName('ITE_PROMOC').AsString) Then
      Begin
        Next;
        Continue;
      End;

      fltUniDol := 0.0;

      If blnRecalcularSomentePrecosComCotacaoDolar Then
      Begin
        If Not fItemUtilizaPrecoEmDolar(FieldByName('ITE_CODITE').AsString) Then
        Begin
          Next;
          Continue;
        End;

        If fFormataFloat(fatVenda.fltVlCtVn, 6) <= 0 Then
        Begin
          Next;
          Continue;
        End;

        fltUniDol := FieldByName('ITE_UNIDOL').AsFloat;

        If fFormataFloat(fltUniDol, 6) <= 0 Then
        Begin
          Next;
          Continue;
        End;
      End;

      If blnRecalculaSomenteItensQueSairamDePromocao then
      Begin
        If Not ((fRetornaPromocaoOriginal = 'S') and (fatVenda.strPromoc = 'N')) Then
        Begin
          Next;
          Continue;
        End;
      End;

      If blnRecalculaSomenteItensQueEntraramEmPromocao then
      Begin
        If Not ((fRetornaPromocaoOriginal = 'N') and (fatVenda.strPromoc = 'S')) Then
        Begin
          Next;
          Continue;
        End;
      End;

      {**************************************}
      {* CASO ESTIVER CONFIGURADO NO AUTTIN *}
      {* PARA UTILIZAR PREÇO DA TABELA FIXA *}
      {* RECALCULAR UTILIZANDO TAL TABELA.  *}
      {***********************************MV*}
      If ((strIdePro <> 'NOR') Or Not fEmptyStr(FieldByName('ITE_CODACA').AsString)) And
         (fCfgSis('PREGER') = '1') And
         (fCfgSis('PRTTIN') = 'N') Then
      Begin
        strTabela := fCfgSis('TABPRE');
      End;

      If fEmptyStr(strTabela) Then
      Begin
        If cbTabPrecoItem.Visible Then
          strTabela := FieldByName('ITE_TABPRE').AsString;
        If fEmptyStr(strTabela) Then
          strTabela := cbTabPreco.Text;
      End;

      If (fEmptyStr(strTabela)) Or (Not fValidouTabelaPrecoConsulta(strTabela)) Then
        Raise ExceptionAutcom.Create('A tabela de preços informada para recálculo dos preços é inválida.');

      fltComTbl := fCampoTabela('ITE_COMTB' + strTabela,
                                'ITEGER',
                                ['ITE_CODITE', 'ITE_CODEMP'],
                                [FieldByName('ITE_CODITE').AsString, VS_StrCodEmp]);

      If (fatVenda.stlItensNaoTemLote.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
         (fatVenda.objCadLot.fItemSemNenhumLote(FieldByName('ITE_CODITE').AsString)) Then
      Begin
        fatVenda.stlItensNaoTemLote.Add(FieldByName('ITE_CODITE').AsString);
      End;

      If (Not fatVenda.fEhEmissaoDocumentoWMS) And
         (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
         (fatVenda.stlItensNaoTemLote.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And

         (fatVenda.objCadLot.fExisteLote(FieldByName('ITE_CODITE').AsString,
                                         IIF(fatVenda.blnEmpFat, FieldByName('ITE_EMPITE').AsString, fatVenda.fEmpresaSaldoMatriz_CD),
                                         FieldByName('ITE_NUMLOT').AsString)) And

          fatVenda.fCalculaPrecosLote(FieldByName('ITE_QTDITE').AsFloat, fltUniLot, IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,'')) Then
      Begin
        fltUnitar := fltUniLot;
        fatVenda.fltUniVis := fltUniLot;
        fatVenda.fltTaxJur := 0.00;

        If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao Then
        Begin
          fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);
          fltUnitar := fltUnitar + fFormataFloat(fltUnitar * (fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString) / 100.0), 04);
        End;
      End

      Else If (fatVenda.blnCliFil) And (fatVenda.fFilialPromocao) Then
      Begin
        fltUnitar := fatVenda.fPegaPrecoSugeridoTE(qryConIte, FieldByName('ITE_EMPITE').AsString, fatVenda.strPromoc);
      End

      Else If SameText(fCfgSis('SUGVLE'), '1') Then
        fltUnitar := fatVenda.fPegaPrecoVenda( fDataSetIteger, FieldByName('ITE_EMPITE').AsString, FieldByName('ITE_ENTSAI').AsString,
                                               fStrToFloat(edtMargem.Text), blnItemEspecial,
                                               strIdePro, strTabela, True,
                                               fatVenda.FTaxJur, fatVenda.FUniVis,
                                               Not fEmptyStr(FieldByName('ITE_BAREMB').AsString),
                                               fRetornaPrecoCodBarraEmb(FieldByName('ITE_CODITE').AsString,
                                                                        FieldByName('ITE_BAREMB').AsString,
                                                                        VS_strCodEmp,
                                                                        strTabela,
                                                                        True),
                                               fRetornaTabPreCodBarraEmb(FieldByName('ITE_CODITE').AsString,
                                                                         FieldByName('ITE_BAREMB').AsString))
      Else
      Begin
        If (fatVenda.stlItensNaoEhEstrutura.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
           (Not fItemEstrutura(FieldByName('ITE_CODITE').AsString)) Then
        Begin
          fatVenda.stlItensNaoEhEstrutura.Add(FieldByName('ITE_CODITE').AsString);
        End;

        If (fatVenda.stlItensNaoEhEstrutura.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) Then
        Begin
          blnAplicarTaxaJuros := (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao);
          fltUnitar := fatVenda.fCalculaPrecoEstrutura( blnAplicarTaxaJuros,
                                                        Preco_de_Venda,
                                                        FieldByName('ITE_CODITE').AsString,
                                                        FieldByName('ITE_EMPITE').AsString,
                                                        FieldByName('ITE_ENTSAI').AsString,
                                                        strTabela,
                                                        fStrToFloat(edtMargem.Text) );
          fatVenda.fltUniVis := fltUnitar;
          fatVenda.fltTaxJur := 0.00;

          If blnAplicarTaxaJuros Then
          Begin
            fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);
            fltUnitar := fltUnitar + fFormataFloat(fltUnitar * (fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString) / 100.0), 04);
          End;
        End

        Else fltUnitar := fatVenda.fPegaPrecoVenda( fDataSetIteger, FieldByName('ITE_EMPITE').AsString, FieldByName('ITE_ENTSAI').AsString,
                                                    fStrToFloat(edtMargem.Text), blnItemEspecial,
                                                    strIdePro, strTabela, True,
                                                    fatVenda.FTaxJur, fatVenda.FUniVis,
                                                    Not fEmptyStr(FieldByName('ITE_BAREMB').AsString),
                                                    fRetornaPrecoCodBarraEmb(FieldByName('ITE_CODITE').AsString,
                                                                             FieldByName('ITE_BAREMB').AsString,
                                                                             VS_strCodEmp,
                                                                             strTabela,
                                                                             True),
                                                    fRetornaTabPreCodBarraEmb(FieldByName('ITE_CODITE').AsString,
                                                                              FieldByName('ITE_BAREMB').AsString));
      End;

      If (fItemCombo) Then
      Begin
        fatVenda.strIteCom := 'S';
        fatVenda.fltTaxJur := 0.00;

        If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao Then
        Begin
          fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);
          fltUnitar          := FieldByName('ITE_UNIVIS').AsFloat +
                                fFormataFloat(FieldByName('ITE_UNIVIS').AsFloat *
                                             (fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString) / 100.0), 04);
        End
        ELse
          fltUnitar := FieldByName('ITE_UNIVIS').AsFloat;

        fatVenda.fltUniVis := FieldByName('ITE_UNIVIS').AsFloat;
      End;

      if (fRestaurarValorItemEstruturaComRateio) then
        fltUnitar := cdsVenda.FieldByName('ITE_ESTORI').AsFloat;

      fatVenda.pCalculaValorRT(fltUnitar, fatVenda.FVal_RT);

      fatVenda.fltUniOri := fltUnitar;

      If (fRestaurarValorItemEstruturaComRateio) And
         (fatVenda.fAplicaTaxaJuros) And
         (fAplicarTaxaJurosPrecoSugestao) And
         (Not fAplicarTaxaJurosPrecoDigitado) Then
      Begin
        fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);
        fltUnitar := fltUnitar + fFormataFloat(fltUnitar * (fatVenda.fltTaxJur / 100.0), fatVenda.VS_intDecUni);
      End;

      If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
         (Not fTemQuantEmbalagemFechada(FieldByName('ITE_CODITE').AsString)) Then
      Begin
        fatVenda.stlItensNaoTemQtdeEmbFec.Add(FieldByName('ITE_CODITE').AsString);
      End;

      {************************************************}
      {* VERIFICA SE EH MULTIPLO DE EMBALAGEM FECHADA *}
      {* APLICA O DESCONTO PARA EMBALAGEM FECHADA     *}
      {********************************************JC**}
      If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
         fEhEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString, strTabela, FieldByName('ITE_QTDITE').AsFloat) And (fatVenda.strPromoc <> 'S') Then
      Begin
        If (fCfgSis('TRPEMB') = '2') And
           (Pos(strOpcDoc, 'UC_') <= 0) Then
        Begin
          fatVenda.fltUniOri := fltUnitar;

          fltPreEmbFec := fatVenda.fGetUnitarioEmbalagemFechada(FieldByName('ITE_CODITE').AsString, strTabela, FieldByName('ITE_QTDITE').AsFloat, fltUnitar, True);

          fltPreEmbFec := fFormataFloat(fltPreEmbFec, fatVenda.VS_intDecUni);

          If fltPreEmbFec > 0 Then
          Begin
            fltUnitar := fltPreEmbFec;
            fatVenda.fltUniOri := fltPreEmbFec;
          End;
        End
        Else
        Begin
          If fCalcularDescontoEmbFechada Then
            fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString, strTabela, FieldByName('ITE_QTDITE').AsFloat, '')
          Else
            fltPercDesEmbFec := 0.00;

          fltUnitar := fltUnitar * ( 1 - ( fltPercDesEmbFec / 100 ) );
          fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(VS_strCodEmp, FieldByName('ITE_CODITE').AsString, strTabela, '', FieldByName('ITE_QTDITE').AsFloat, fltPercDesEmbFec);
        End;
      End;

      if (fCfgSis('RATEST', varString) = 'C') then
      begin
        fltUnitar := fRetornaValorEstrutura(FieldByName('ITE_CODITE').AsString ,fltUnitar ,StrToIntDef(strTabPre,1));
      end;

      {**************************************************}
      {* ATUALIZA A TAB DE PREÇOS DO ITEM NA TEMPORARIA *}
      {***********************************************LU*}
      If (blnAltTabRecalculoPrecos Or ((strIdePro <> 'NOR') And (FieldByName('ITE_TABPRE').AsString <> strTabela) And (fCfgSis('PRTTIN') = 'N'))) And
         ((Not fItemCombo) Or (SameText(FieldByName('ITE_TABCOM').AsString, 'F'))) Then
      Begin
        Edit;
        FieldByName('ITE_TABPRE').AsString := strTabela;
        Post;

        If (fEmptyStr(fatVenda.strTabTin) And fEmptyStr(fTabelaPrecoClienteOuVendedor)) Or
           (fCfgSis('PRTTIN') = 'S') Then
        Begin
          If (strIdePro <> 'NOR') And fEmptyStr(FieldByName('ITE_CODCMG').AsString)  Then
          Begin
            If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And cbTabPreco.Visible Then
            Begin
              If (fatVenda.fItemPassivelDeVerificacaoPromo(FieldByName('ITE_CODITE').AsString, strEmpItePro)) Then
              Begin
                FillChar(dadosPromocao, SizeOf(dadosPromocao), #0);
                dadosPromocao := fDadosPromocao(FieldByName('ITE_CODITE').AsString,
                                                strEmpItePro,
                                                fatVenda.strCodCli,
                                                strTabela);

                fatVenda.strPromoc := IIF(fEmptyStr(dadosPromocao.strCodPro), 'N', 'S');
                fatVenda.strCodPro := dadosPromocao.strCodPro;
              End;
            End;
          End;
        End;
      End;

      Edit;

      If (Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado) Then
      Begin
        If fRecalculaCustos(strTabela) Then
        Begin
          pCarregaPrecosAtuais(strTabela);
          pRecalculaCat17(strTabela);
          pRecalculaMargemLucro;
          pAtualizaPreTabVarTab(strTabela);

          Post;

          pCalculaTotGerIte;
        End
        Else
        Begin
          Cancel;
        End;

        Next;
        Continue;
      End;

      If (blnAlternouEntreClienteFilialClienteComum) Then
      Begin
        FieldByName('ABF_CODABF').AsString := fatVenda.fGetCodAbf(FieldByName('ITE_CODITE').AsString, fatVenda.fGetEmpCalculoItem(FieldByName('ITE_EMPITE').AsString));
      End;

      FieldByName('ITE_PROMOC').AsString  := fatVenda.strPromoc;
      FieldByName('ITE_CODPRO').AsString  := fatVenda.strCodPro;
      FieldByName('ITE_COMTBL').AsFloat   := fltComTbl;
      FieldByName('ITE_PROCUS').AsFloat   := IIF(fatVenda.strPromoc = 'S', fatVenda.fltProPreCus, 0);
      FieldByName('ITE_PROVEN').AsFloat   := IIF(fatVenda.strPromoc = 'S', fatVenda.fltProPreVen, 0);
      FieldByName('ITE_PROCVA').AsFloat   := IIF(fatVenda.strPromoc = 'S', fatVenda.fltProComVar, 0);
      FieldByName('ITE_PROCAT').AsFloat   := IIF(fatVenda.strPromoc = 'S', fatVenda.fltProComAta, 0);
      FieldByName('ITE_PROCDI').AsFloat   := IIF(fatVenda.strPromoc = 'S', fatVenda.fltProComDis, 0);
      FieldByName('ITE_DESF07').AsFloat   := IIF(fatVenda.strPromoc = 'S', fatVenda.fltProDesF07, 0);

      If (Self.blnDescProfissRecalculoPrecos) And (Not blnManterPrecoDigitado) And
         (fatVenda.strPromoc <> 'S') And (Not fatVenda.fDocumentoParaFornecedor) Then
        FieldByName('ITE_DESCON').AsFloat := fRetDescontoCliente(fatVenda.strCodCli);

      If (Not fPerguntouSeProdutosComDescontoTeraoPrecoOuDescontoAjustado) Then
        If Self.blnZerarDescontoDoItemRecalculoPrecos Then
          FieldByName('ITE_DESCON').AsFloat := 0.00;

      If (fProcessarRegraDescontoDeProfissionalPorItem) Then
        If (Not fProcessarRegraDescontoDeProfissionalPorItem_PermiteAlterarDesconto) Then
          FieldByName('ITE_DESCON').AsFloat := 0.00;

      If blnRecalcularSomentePrecosComCotacaoDolar Then
        FieldByName('ITE_DESCON').AsFloat := 0.00;

      If (fatVenda.strIteCom = 'S') or
         ((fatVenda.strPromoc = 'S') And
          (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao)) Then
      Begin
        If (Not blnManterPrecoDigitado) And (Not blnManterDescontoItemEstruturaPromoc) Then
          FieldByName('ITE_DESCON').AsFloat := 0.00;
      End;

      If fCfgSis('DESCND',varBoolean) Then
        fatVenda.strDstCnd := fCampoTabela('ITE_DESCND','CADITE', ['ITE_CODITE'],[FieldByName('ITE_CODITE').AsString]);

      fltDesMax := 0;

      {*******************************************}
      {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
      {* APLICA O PERCENTUAL DE DESCONTO         *}
      {****************************************MV*}
      If (fatVenda.strCAbDes = 'S') And
         (fCfgSis('CNDVEN') = 'I') And
         (fatVenda.strIteCom <> 'S') And
         (fatVenda.strStatus <> 'C') And
         (FieldByName('ITE_PRELOT').AsFloat = 0) And
         ((fatVenda.strPromoc <> 'S') Or
          (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
         (Not fAplicarTaxaJurosPrecoDigitado) Then
      Begin
        {********************************************************************}
        {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
        {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
        {****************************************************************MM**}
        fltDesMax := fatVenda.fRetornaDescLinGru(FieldByName('ITE_CODITE').AsString, fatVenda.strCodCnd);

        If fCfgSis('DESCND',varBoolean) Then
        Begin
          If (fatVenda.strDstCnd = 'S') Then
            fltUnitar := fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, fltDesMax)
        End
        Else If (fatVenda.strCodFpg = '007') Then
        Begin
          If (fatVenda.strAbDeCc = 'S') Then
            fltUnitar := fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, fltDesMax);
        End
        Else
          fltUnitar := fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, fltDesMax);

        fltUnitar := fFormataFloat(fltUnitar, fatVenda.VS_intDecUni);
      End;

      If fAplicarDescontoRessarcimentoCAT(FieldByName('ITE_IDEPRO').AsString) Then
      begin
        fltUnitar := fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, FieldByName('ABF_CODABF').AsString, strTabela, fltUnitar);
      end;

      If fCarregarEstruturaVidro(FieldByName('ITE_CODITE').AsString, FieldByName('AUTOINCREM').AsInteger) Then
      Begin
        fltUnitar := fAtualizaPrecosEstruturaVidro(strTabela, FieldByName('ITE_ENTFUT').AsString, FieldByName('ITE_EMPITE').AsString, False, True);
      End;

      If (Self.blnVerUniOriRecalculoPrecos) Then
      Begin

        If (fFormataFloat(fatVenda.fltUniOri, 2) = fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, 2)) Then
        Begin
          Cancel;
          Next;
          Continue;
        End;

      End;

      If fDestacarDescontoDaCondicaoPagamentoNoCampoDescontoDosItensEmPromocao Then
      Begin
        If blnManterPrecoDigitado Then
        Begin
          fltDesMax := FieldByName('ITE_DESCON').AsFloat;
          fatVenda.blnProCnd := FieldByName('ITE_PROCND').AsBoolean;
        End
        Else
        Begin
          fatVenda.blnProCnd := False;

          blnProCndAnt := FieldByName('ITE_PROCND').AsBoolean;

          If (fatVenda.strPromoc = 'S') And
             (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
          Begin
            fltDesMax := fatVenda.fRetornaDescLinGru(FieldByName('ITE_CODITE').AsString, fatVenda.strCodCnd);

            If (fltDesMax > 0) Then
            Begin
              FieldByName('ITE_DESCON').AsFloat   := fltDesMax;
              FieldByName('ITE_PROCND').AsBoolean := True;

              fatVenda.blnProCnd := True;
            End;
          End;

          {*********************************************************}
          {* Não destacou desconto condição sobre o preço promoção *}
          {* agora mas havia destacado para a condição anterior!   *}
          {******************************************************VA*}
          If (Not fatVenda.blnProCnd) And (blnProCndAnt) Then
          Begin
            FieldByName('ITE_DESCON').AsFloat   := 0;
            FieldByName('ITE_PROCND').AsBoolean := False;
          End;
        End;
      End;

      If blnUtilizaVendaMadeira Then
        fltUnitar := fltUnitar + fatVenda.fRetornaVrAcrescApaBen(fltUnitar, FieldByName('ITE_PERAPA').AsFloat, FieldByName('ITE_PERBEN').AsFloat);

      If fAplicarTaxaJurosPrecoDigitado And (Not blnAltTabRecalculoPrecos) Then
        fltUnitar := FieldByName('ITE_UNIDIG').AsFloat;

      FieldByName('ITE_UNIORI').AsFloat := fatVenda.fltUniOri;
      FieldByName('ITE_UNIVIS').AsFloat := fatVenda.fltUniVis;
      FieldByName('ITE_TAXJUR').AsFloat := fatVenda.fltTaxJur;
      FieldByName('ITE_VAL_RT').AsFloat := fatVenda.fltVal_RT;

      If (Not blnManterPrecoDigitado) Then
      Begin
        If (fCfgSis('DESCND',varBoolean)) And (fatVenda.strPromoc <> 'S') Then
        Begin
          FieldByName('ITE_UNIDIG').AsFloat := FieldByName('ITE_UNIORI').AsFloat;
        End
        Else If (Not fCfgSis('DESCND',varBoolean)) Or (fatVenda.strPromoc = 'S') Then
        Begin
          FieldByName('ITE_UNIDIG').AsFloat := fFormataFloat(fltUnitar, fatVenda.VS_intDecUni);
        End;
      End;

      If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoDigitado Then
      Begin
        fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);

        fltUnitar := fltUnitar + (fltUnitar * fatVenda.fltTaxJur / 100.0);

        FieldByName('ITE_TAXJUR').AsFloat := fatVenda.fltTaxJur;
      End;

      If fCfgSis('DESCND',varBoolean) Then
        FieldByName('ITE_DESCON').AsFloat := IIF(fatVenda.strDstCnd = 'S', fltDesMax, 0)
      Else
        fltUnitar := fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, FieldByName('ITE_DESCON').AsFloat);

      If (FieldByName('ITE_LIBUNI').AsString = 'S') And
         (fFormataFloat(FieldByName('ITE_UNITAR').AsFloat, fCfgSis('DECUNI', varInteger)) <> fFormataFloat(fltUnitar, fCfgSis('DECUNI', varInteger))) Then
        FieldByName('ITE_LIBUNI').AsString := 'N';

      FieldByName('ITE_PROKIT').Asstring := '';
      if (fatVenda.strPromoc = 'S') And
         (not fEmptyStr(TProQtdColetiva.strIDKitAtivo)) then
       Begin
         fltUnitar                          := fatVenda.fltProPreVen;
         FieldByName('ITE_UNIDIG').AsFloat  := fatVenda.fltProPreVen;
         FieldByName('ITE_PROKIT').Asstring := TProQtdColetiva.strIDKitAtivo;

        if (fCfgSis('TRAPRO') = 'N') and (fCfgSis('TRAPRP') = '2') then
          FieldByName('ITE_UNIORI').AsFloat  := fatVenda.fltProPreVen;
       End;

       If (fatVenda.strPromoc = 'S') And
          (strIdePro <> 'NOR') And
          (fItemPromocaoVlrMin(FieldByName('ITE_CODITE').AsString)) Then
       Begin
         fltUnitar                          := fatVenda.fltProPreVen;
         FieldByName('ITE_UNIDIG').AsFloat  := fatVenda.fltProPreVen;
         If (fCfgSis('TRAPRO') = 'N') and (fCfgSis('TRAPRP') = '2') then
          FieldByName('ITE_UNIORI').AsFloat  := fatVenda.fltProPreVen;
       End;

      If (Not blnManterPrecoDigitado) Then
      Begin
        If fPerguntouSeProdutosComDescontoTeraoPrecoOuDescontoAjustado Then //Resposta de: Ajustar o Desconto/Ajustar o Valor da Venda (CFG_ALTPOP)
        Begin
          //blnAjustaPrecoVenda/blnAjustaDesconto = Resposta de: Ajustar o Desconto/Ajustar o Valor da Venda (CFG_ALTPOP)
          //blnAtualizaPrecos = //Resposta de: Manter Preços Negociados/Atualizar Preços (CFG_ATPROR/CFG_ATPRPO)                       
          If (blnAjustaPrecoVenda) Then
            FieldByName('ITE_UNITAR').AsFloat := fltUnitar
          Else If (blnAjustaDesconto And blnAtualizaPrecos And (cdsVenda.FieldByName('ITE_DESCON').AsFloat = 0)) Then
            FieldByName('ITE_UNITAR').AsFloat := fltUnitar  
        End
        Else
          FieldByName('ITE_UNITAR').AsFloat := fltUnitar;
      End;

      If blnRecalcularSomentePrecosComCotacaoDolar Then
      Begin
        FieldByName('ITE_LIBUNI').AsString := 'N';
        FieldByName('ITE_DESCON').AsFloat  := 0.0;
        FieldByName('ITE_UNIDIG').AsFloat  := fFormataFloat(fltUniDol * fatVenda.fltVlCtVn, fatVenda.VS_intDecUni);
        FieldByName('ITE_UNITAR').AsFloat  := fFormataFloat(fltUniDol * fatVenda.fltVlCtVn, fatVenda.VS_intDecUni);
        FieldByName('ITE_TOTITE').AsFloat  := fFormataFloat(FieldByName('ITE_UNITAR').AsFloat * FieldByName('ITE_QTDITE').AsInteger, 2);
      End
      Else If (fPerguntouSeProdutosComDescontoTeraoPrecoOuDescontoAjustado) then
      begin
        if (cdsVenda.FieldByName('ITE_DESCON').AsFloat > 0) then
        begin
          If (blnAjustaDesconto) Then
          Begin
            cdsVenda.FieldByName('ITE_DESCON').AsFloat := (1 - ((cdsVenda.FieldByName('ITE_TOTITE').AsFloat / cdsVenda.FieldByName('ITE_QTDITE').AsFloat) / cdsVenda.FieldByName('ITE_UNIDIG').AsFloat)) * 100;
          End
          Else If (blnAjustaPrecoVenda) Then
          Begin
            cdsVenda.FieldByName('ITE_UNITAR').AsFloat := cdsVenda.FieldByName('ITE_UNIDIG').AsFloat * (1 - (cdsVenda.FieldByName('ITE_DESCON').AsFloat / 100));
            cdsVenda.FieldByName('ITE_TOTITE').AsFloat := cdsVenda.FieldByName('ITE_UNIDIG').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsInteger * (1 - (cdsVenda.FieldByName('ITE_DESCON').AsFloat / 100));
          End;
        end
        else
        begin
          //se não houve desconto então volta o valor unitário original pois não deveria alterar o preço
          If (Not blnAtualizaPrecos) Then //Resposta de: Manter Preços Negociados/Atualizar Preços (CFG_ATPROR/CFG_ATPRPO)
          Begin
            cdsVenda.FieldByName('ITE_UNIDIG').AsFloat := fltUniDigOriginal;
            cdsVenda.FieldByName('ITE_UNITAR').AsFloat := fltUniDigOriginal;
          End;
        end;
      end;

      If (strIdePro <> 'NOR') Then
      Begin
        FieldByName('ITE_PRVTIN').AsFloat := fltUnitar;
      End;

      fRecalculaCustos(strTabela);

      pRecalculaCat17(strTabela);

      pRecalculaMargemLucro;

      FieldByName('ITE_TOTITE').AsFloat := fFormataFloat(FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNITAR').AsFloat, 02);

      FieldByName('FLG_STATUS').AsString:= fatVenda.strStatus;

      pAtualizaPreTabVarTab(strTabela);

      If (fatVenda.fltVlCtVn > 0) And fItemUtilizaPrecoEmDolar(FieldByName('ITE_CODITE').AsString) Then
      Begin
        FieldByName('ITE_UNIDOL').AsFloat := FieldByName('ITE_UNITAR').AsFloat / fatVenda.fltVlCtVn;
      End;

      If FieldByName('ITE_EHEMBA').AsBoolean Then
      Begin
        FieldByName('ITE_PEREMB').AsFloat := fPercDescEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString,
                                                                           FieldByName('ITE_TABPRE').AsString,
                                                                           FieldByName('ITE_QTDITE').AsFloat,
                                                                           '');
        If (FieldByName('ITE_UNIORI').AsFloat <> FieldByName('ITE_UNIDIG').AsFloat) Then
          FieldByName('ITE_VLPEMB').AsFloat := fFormataFloat((FieldByName('ITE_UNIORI').AsFloat - (FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_PEREMB').AsFloat / 100)), fatVenda.VS_intDecUni)
        Else
          FieldByName('ITE_VLPEMB').AsFloat := FieldByName('ITE_UNIORI').AsFloat;

        FieldByName('ITE_PEREMB').AsFloat := fFormataFloat(((1 - (FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_VLPEMB').AsFloat)) * 100), fatVenda.VS_intDecUni);

        FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_VLPEMB').AsFloat), fatVenda.VS_intDecUni);
      End
      Else
      Begin
        FieldByName('ITE_PEREMB').AsFloat := 0;
        FieldByName('ITE_VLPEMB').AsFloat := 0;
        FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNIORI').AsFloat), fatVenda.VS_intDecUni);
      End;

      fatVenda.pAcertaSituacaoItem(cdsVenda);

      If (strIdePro = 'NOR') Or ((strIdePro <> 'NOR') And blnRecalculaTabelaTintasPrecos) Then
        FieldByName('ITE_FDOITERECALC').AsString := 'S';

      Post;

      If (not Self.blnRecalculoParaTrava) Then
      Begin
        pAddCalcFlex;
      End;

      pCalculaTotGerIte;

      Next;
    End;
  End;

  fatVenda.strPromoc    := 'N';
  fatVenda.fltProPreCus := 0;
  fatVenda.fltProPreVen := 0;
  fatVenda.fltProComVar := 0;
  fatVenda.fltProComAta := 0;
  fatVenda.fltProComDis := 0;
  fatVenda.fltProDesF07 := 0;

  If blnRecalculaTabelaTintasPrecos Then
  Begin
    If blnChamouRecalculoTabelaPrecoTinta Then
      fatVenda.pRecalculaTabelasPrecoTinta(False, False{FALSE > PARA VOLTAR O PREÇO DE PROMOÇÃO});
  End;

  If fDeveRecalcularPrecoSubItensEstruturaRateado Then
    pRecalculaPrecoSubItensEstruturaRateado;

  If (not Self.blnRecalculoParaTrava) Then
  Begin
    If TMostraTravaMinimaHelper.fExibeTravaMinima Then
    Begin
      fExecutarModal(procedure
        begin
          fatVenda.fVerificaVrMinimo(fatVenda.fltTotGer,
                                     fatVenda.fltTotGer,
                                     fatVenda.intPrzMed,
                                     '',
                                     False,
                                     False,
                                     pgbStatus);
        end, 'Aguarde, Verificando valor mínimo produtos ...', '');
    End;
  End;

  fatVenda.fltPreVe1 := 0.0;
  fatVenda.fltPreVe2 := 0.0;
  fatVenda.fltPreVe3 := 0.0;
  fatVenda.fltPreVe4 := 0.0;
  fatVenda.fltPreVe5 := 0.0;
  fatVenda.fltPreVe6 := 0.0;
  fatVenda.fltPreVe7 := 0.0;
  fatVenda.fltPreLot := 0.0;

  If (not Self.blnRecalculoParaTrava) And (Not blnRecacularItensPromocaoQtdMin) Then
  Begin
    pVerificaComboVigenteGeral(pgbStatus);
  End;
end;

