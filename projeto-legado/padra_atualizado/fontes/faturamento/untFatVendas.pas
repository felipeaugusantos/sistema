function TfrmFatVendas.fValidaItemNaoAcabado(blnValidaConfirma : Boolean): Boolean;
  Var
    cdsDados : TUniClientDataSet;
    strIteCodDep : String;
    stlProdutosNaoAcabados : TStringList;
    intContador: Integer;
Begin

  Result := True;

  If Not blnValidaConfirma Then
  Begin
    If Not fVerificaSeEhItemAcabado(qryConCit.FieldByName('ITE_CODDEP').AsString) Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido vender um item que não seja produto acabado!', ['&O k']);
      Result := False;
    End;
  End
  Else
  Begin

    If Not((fCfgSis('EXIACA', varBoolean)) And (Pos(fatVenda.strOpcDoc, 'OR_PD_VN_') > 0)) Then
      Exit;

    cdsDados := TUniClientDataSet.Create(Nil);
    stlProdutosNaoAcabados := TStringList.Create;

    Try
      pCloneDataSet(cdsDados, cdsVenda);
      cdsDados.First;

      While Not cdsDados.Eof  Do
      Begin
        strIteCodDep := (fCampoTabela('ITE_CODDEP', 'CADITE', ['ITE_CODITE'], [cdsDados.FieldByName('ITE_CODITE').AsString], False));
        If Not fVerificaSeEhItemAcabado(strIteCodDep) Then
        Begin
          stlProdutosNaoAcabados.Add(cdsDados.FieldByName('ITE_CODITE').AsString +'-'+cdsDados.FieldByName('ITE_DESITE').AsString);
        End;
        cdsDados.Next;
      End;

      If stlProdutosNaoAcabados.Count > 0 Then
      Begin
        pCriarFormularios(TfrmObservacao, frmObservacao);
        try
          frmObservacao.lblMensagem.Caption := 'Itens não acabados ';
          frmObservacao.memObs.Texto := 'Não é permitido vender um item que não seja produto acabado!';

          For intContador := 0 To stlProdutosNaoAcabados.Count - 1 Do
          Begin
            frmObservacao.memObs.Texto := frmObservacao.memObs.Texto + #13+
                                          'Item: '+stlProdutosNaoAcabados[intContador];

          End;
          frmObservacao.ShowModal;

          Result := False;
        Finally
          pFreeAndNil(frmObservacao);
        End;
      End;

    Finally
      FreeAndNil(stlProdutosNaoAcabados);
      FreeAndNil(cdsDados);
    End;
  End;

End;

function TfrmFatVendas.fValidaVenRepInat(out strVenInat: String; out strRepInat: String;
  out strCodIteVenInat: String; out strCodIteRepInat: String): Boolean;
 Var
   cdsDados : TUniClientDataSet;
begin
  strVenInat := '';
  strRepInat := '';
  cdsDados := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.First;
    While (Not cdsDados.Eof) Do 
    Begin
      If (pnlVendedor.Enabled And pnlVendedor.Visible) Then
      Begin
        If (Not fEmptyStr(cdsDados.FieldByName('ITE_CODVEN').AsString)) Then 
        Begin
          If (fCampoTabela('OPE_STATUS', 'CADOPE', ['OPE_CODOPE'], [cdsDados.FieldByName('ITE_CODVEN').AsString], False) <> 'A') Then 
          Begin
            pIncrementaListaStr('Ite.: '+cdsDados.FieldByName('ITE_CODITE').AsString+' Ven.: '+cdsDados.FieldByName('ITE_CODVEN').AsString, strVenInat);
            pIncrementaListaStr(cdsDados.FieldByName('ITE_CODITE').AsString, strCodIteVenInat);
          End;
        End;
      End;

      If (pnlRepresentante.Enabled And pnlRepresentante.Visible) Then
      Begin
        If (Not fEmptyStr(cdsDados.FieldByName('ITE_CODVE2').AsString)) Then 
        Begin
          If (fCampoTabela('OPE_STATUS', 'CADOPE', ['OPE_CODOPE'], [cdsDados.FieldByName('ITE_CODVE2').AsString], False) <> 'A') Then 
          Begin
            pIncrementaListaStr('Ite.: '+cdsDados.FieldByName('ITE_CODITE').AsString+' Ve2.: '+cdsDados.FieldByName('ITE_CODVE2').AsString, strRepInat);
            pIncrementaListaStr(cdsDados.FieldByName('ITE_CODITE').AsString+'_', strCodIteRepInat);
          End;
        End;
      End;

      cdsDados.Next;
    End;
  Finally
    Result := (strVenInat.IsEmpty And strRepInat.IsEmpty);
    FreeAndNil(cdsDados);
  End;
end;

function TfrmFatVendas.fValidaItensDevolucaoEmitidosDiasVencidos: Boolean;
  Var
    strChaveTmp: String;
    cdsClone: TUniClientDataSet;

    intDiaNF,
    intDiaFF: Integer;
    strDocEmi,
    strDtaEmi,
    strVenEmi,
    strIteEmi,
    strDesEmi,
    strQtdEmi,
    strValUni,
    strTotIte: String;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha  : TLinhaMsgLibera;

  function fDiasPassadosDoctoOriginal(dtaDtaDev: TDateTime): Integer;
  begin
    Result := DaysBetween(VS_Date, dtaDtaDev);
  end;

  function fRetornaChaveAcesso(strNumDoc, strEspDoc, strCodEmp: String; dtaDataEnt: TDateTime): String;
    Var
      qryAux: TUniQuery;
      function fRetornaSql(strTabGer, strTabDet: String): String;
      begin
        Result := '';
        Result := Result + 'SELECT ';
        Result := Result + '  FIS_ACESSO ';
        Result := Result + 'FROM ';
        Result := Result + '  CADFIS ';
        Result := Result + 'JOIN ' + strTabGer + ' G ON G.GER_NUMDOC = FIS_NUMDOC AND ';
        Result := Result + '                            G.GER_ESPDOC = FIS_ESPDOC AND ';
        Result := Result + '                            G.GER_CODEMP = FIS_CODEMP AND ';
        Result := Result + '                            IFNULL(G.GER_CODFOR, G.GER_CODCLI) = FIS_FORCLI AND ';
        Result := Result + '                            G.GER_TIP_FC = FIS_TIP_FC AND ';
        Result := Result + '                            G.GER_TIP_FC = FIS_TIP_FC ';

        Result := Result + 'JOIN ' + strTabDet + ' D ON D.DET_SEQGER = G.AUTOINCREM ';
        Result := Result + 'WHERE ';
        Result := Result + '  D.DET_NUMDOC = :NUMDOC AND ';
        Result := Result + '  D.DET_ESPDOC = :ESPDOC AND ';
        Result := Result + '  D.DET_CODEMP = :CODEMP AND ';
        Result := Result + '  D.DET_DTAENT = :DTAENT ';
      end;
  begin
    qryAux := fCriaQuery(Self);
    qryAux.SQL.Add(fRetornaSql('MOVGER', 'MOVDET'));
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('DTAENT').AsDateTime := dtaDataEnt;
    qryAux.Open;

    If (qryAux.IsEmpty) Then
    Begin
      qryAux.SQL.Clear;
      qryAux.SQL.Add(fRetornaSql('NOTGER', 'NOTDET'));
      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.ParamByName('DTAENT').AsDateTime := dtaDataEnt;
      qryAux.Open;
    End;

    Result := qryAux.FieldByName('FIS_ACESSO').AsString;

    FreeAndNil(qryAux);
  end;
begin
  Result := True;

  intDiaNF := fCfgSis('DIADVE', VarInteger);
  intDiaFF := fCfgSis('DIADEV', VarInteger);

  objLiberacao.Clear;
  objLiberacao.objMsgLibera.pAddSeparador(119);
  objLiberacao.objMsgLibera.pAddTexto('<<<   Devolução com Documentos Emitidos Fora do Prazo   >>>', alCentro, teAmbos, '', 119);
  objLiberacao.objMsgLibera.pAddSeparador(119);
  objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade de dias limite para Devolução - Nota Eletrônica'   , fStrZero(intDiaNF.ToString, 3) + ' dias', 60);
  objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade de dias limite para Devolução - Demais Documentos' , fStrZero(intDiaFF.ToString, 3) + ' dias', 60);
  objLiberacao.objMsgLibera.pAddSeparador(119);
  objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  , edtCodCli.Text + '-' + edtNomCli.Text, 9);
  objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor' , fatVenda.strCodVen + '-' + fRetNomVendRep(fatVenda.strCodVen));

  objTabela := TRegistroMsgLiberaTabela.Create;

  objLinha  := TLinhaMsgLibera.Create;
  objLinha.enuTipoLinha := tlCabecalho;
  objLinha.pAddColuna(''  , 'Documento'  , 21 , alEsquerda , teAutcom);
  objLinha.pAddColuna(''  , 'Dt.Emissão' , 12 , alCentro   , teAutcom);
  objLinha.pAddColuna(''  , 'Ven'        , 4  , alCentro   , teAutcom);
  objLinha.pAddColuna(''  , 'Cód.'       , fTamCodIte, alCentro   , teAutcom);
  objLinha.pAddColuna(''  , 'Produto'    , 20 , alEsquerda   , teAutcom);
  objLinha.pAddColuna(''  , 'Quantidade' , 12 , alDireita  , teAutcom);
  objLinha.pAddColuna(''  , 'Vr.Unitário', 11 , alDireita  , teAutcom);
  objLinha.pAddColuna(''  , 'Vr.Total'   , 16 , alDireita  , teAutcom);
  objTabela.lstLinhas.Add(objLinha);

  cdsClone := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsClone, cdsVenda);

  With cdsClone Do
  Begin
    First;

    While Not Eof Do
    Begin

      If Not fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
      Begin
        strChaveTmp := fRetornaChaveAcesso(FieldByName('ITE_DOCDEV').AsString,
                                           FieldByName('ITE_ESPDEV').AsString,
                                           FieldByName('ITE_EMPDEV').AsString,
                                           FieldByName('ITE_EMIDEV').AsDateTime);

        If (((Not fEmptyStr(strChaveTmp)) And
             (fDiasPassadosDoctoOriginal(FieldByName('ITE_EMIDEV').AsDateTime) >= intDiaNF))  Or
             (fEmptyStr(strChaveTmp)      And
             (fDiasPassadosDoctoOriginal(FieldByName('ITE_EMIDEV').AsDateTime) >= intDiaFF))) Then
        Begin
          strDocEmi := FieldByName('ITE_DOCDEV').AsString + '-' + FieldByName('ITE_ESPDEV').AsString + '-' + FieldByName('ITE_EMPDEV').AsString;
          strDtaEmi := FormatDateTime('dd/mm/yyyy', FieldByName('ITE_EMIDEV').AsDateTime);
          strVenEmi := FieldByName('ITE_CODVEN').AsString;
          strIteEmi := FieldByName('ITE_CODITE').AsString;
          strDesEmi := FieldByName('ITE_DESITE').AsString;
          strQtdEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), FieldByName('ITE_QTDITE').AsFloat);
          strValUni := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), FieldByName('ITE_UNITAR').AsFloat);
          strTotIte := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), FieldByName('ITE_TOTITE').AsFloat);


          objLinha  := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlValor;
          objLinha.pAddColuna('Documento'  , strDocEmi , 21 , alEsquerda);
          objLinha.pAddColuna('Dt.Emissão' , strDtaEmi , 12 , alCentro  );
          objLinha.pAddColuna('Ven'        , strVenEmi , 4  , alCentro  );
          objLinha.pAddColuna('Cód.'       , strIteEmi , fTamCodIte, alCentro  );
          objLinha.pAddColuna('Produto'    , strDesEmi , 20 , alEsquerda);
          objLinha.pAddColuna('Quantidade' , strQtdEmi , 12 , alDireita );
          objLinha.pAddColuna('Vr.Unitário', strValUni , 11 , alDireita );
          objLinha.pAddColuna('Vr.Total'   , strTotIte , 16 , alDireita );
          objTabela.lstLinhas.Add(objLinha);

          Result := False;
        End;
      End;

      Next;
    End;

  End;

  FreeAndNil(cdsClone);


  If Not Result Then
  begin
    objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

    objLiberacao.strDirAce := 'DIAVEN';
    objLiberacao.strSenLib := fCfgSis('DIAVEN');
    objLiberacao.strMsgSen := 'Devolução de Documentos';
    objLiberacao.strCodOpe := fatVenda.strCodVen;
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.objMsgLibera.strTitulo := 'Devolução com Documentos Emitidos Fora do Prazo';

    Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
  end
  else
    FreeAndNil(objTabela);

end;

function TfrmFatVendas.fValidaItensPedRefOR: Boolean;
  Var
    cdsClone: TUniClientDataSet;
    strItens: String;
    strItensAtend: String;

  procedure pZeraQtdDifAndDig;
  Begin
    With fatVenda.cdsPedRefOR Do
    Begin
      First;

      While Not Eof Do
      Begin
        Edit;
        FieldByName('QTDDIG').AsFloat := 0;

        If FieldByName('SALDIS').AsFloat <= 0 Then
        Begin
          If FieldByName('QTDITE').AsFloat = FieldByName('QTDDIG').AsFloat Then
            FieldByName('QTDDIF').AsFloat := 0
          Else
            FieldByName('QTDDIF').AsFloat := FieldByName('QTDDIG').AsFloat - FieldByName('QTDITE').AsFloat;
        End
        Else
        Begin
          If FieldByName('SALDIS').AsFloat < FieldByName('QTDITE').AsFloat Then
            FieldByName('QTDDIF').AsFloat := (FieldByName('SALDIS').AsFloat + FieldByName('QTDDIG').AsFloat) - FieldByName('QTDITE').AsFloat
          Else
            FieldByName('QTDDIF').AsFloat := 0;
        End;

        Post;

        Next;
      End;
    End;
  End;
begin
  Result := True;
  strItens := '';
  strItensAtend := '';

  If Assigned(fatVenda.cdsPedRefOR) And (cdsVenda.RecordCount > 0) Then
  Begin
    Try
      cdsClone := TUniClientDataSet.Create(Self);
      pCloneDataSet(cdsClone, cdsVenda);
      pZeraQtdDifAndDig;

      With cdsClone Do
      Begin
        First;

        While Not Eof Do
        Begin
          If fatVenda.cdsPedRefOR.Locate('CODITE;NUMLOT', VarArrayOf([FieldByName('ITE_CODITE').AsString, FieldByName('ITE_NUMLOT').AsString]), []) Then
          Begin
            If fatVenda.cdsPedRefOR.FieldByName('SALDIS').AsFloat < fatVenda.cdsPedRefOR.FieldByName('QTDITE').AsFloat Then
            Begin
              fatVenda.cdsPedRefOR.Edit;
              fatVenda.cdsPedRefOR.FieldByName('QTDDIG').AsFloat := fatVenda.cdsPedRefOR.FieldByName('QTDDIG').AsFloat + FieldByName('ITE_QTDITE').AsFloat;

              If fatVenda.cdsPedRefOR.FieldByName('SALDIS').AsFloat <= 0 Then
              Begin
                If fatVenda.cdsPedRefOR.FieldByName('QTDITE').AsFloat = fatVenda.cdsPedRefOR.FieldByName('QTDDIG').AsFloat Then
                  fatVenda.cdsPedRefOR.FieldByName('QTDDIF').AsFloat := 0
                Else
                  fatVenda.cdsPedRefOR.FieldByName('QTDDIF').AsFloat := fatVenda.cdsPedRefOR.FieldByName('QTDDIG').AsFloat - fatVenda.cdsPedRefOR.FieldByName('QTDITE').AsFloat;
              End
              Else
              Begin
                If fatVenda.cdsPedRefOR.FieldByName('SALDIS').AsFloat < fatVenda.cdsPedRefOR.FieldByName('QTDITE').AsFloat Then
                  fatVenda.cdsPedRefOR.FieldByName('QTDDIF').AsFloat := (fatVenda.cdsPedRefOR.FieldByName('SALDIS').AsFloat + fatVenda.cdsPedRefOR.FieldByName('QTDDIG').AsFloat) - fatVenda.cdsPedRefOR.FieldByName('QTDITE').AsFloat
                Else
                  fatVenda.cdsPedRefOR.FieldByName('QTDDIF').AsFloat := 0;
              End;

              fatVenda.cdsPedRefOR.Post;
            End
            Else
              strItensAtend := strItensAtend + FieldByName('ITE_CODITE').AsString + '-' + FieldByName('ITE_DESITE').AsString + #13#10;
          End
          Else
            strItens := strItens + FieldByName('ITE_CODITE').AsString + '-' + FieldByName('ITE_DESITE').AsString + #13#10;

          Next;
        End;

        If Not fEmptyStr(strItens) Then
        Begin
          pCriarFormularios(TfrmObservacao, frmObservacao);
          frmObservacao.lblMensagem.Caption := 'Itens que não possuem no pedido ' + fatVenda.strNumPedRefOR + '-' + fatVenda.strEmpPedRefOR;
          frmObservacao.memObs.Texto := 'Os itens: ' + #13#10 + strItens +
                                        'não possuem no pedido de referência ' +
                                        fatVenda.strNumPedRefOR + '-' + fatVenda.strEmpPedRefOR +
                                        ', por isso o orçamento não pode ser finalizado.';
          frmObservacao.ShowModal;
          pFreeAndNil(frmObservacao);

          Result := False;
        End;

        If Result Then
        Begin
          If Not fEmptyStr(strItensAtend) Then
          Begin
            pCriarFormularios(TfrmObservacao, frmObservacao);
            frmObservacao.lblMensagem.Caption := 'Itens que já foram atendidos pedido ' + fatVenda.strNumPedRefOR + '-' + fatVenda.strEmpPedRefOR;
            frmObservacao.memObs.Texto := 'Os itens: ' + #13#10 + strItensAtend +
                                          'já foram atendidos, por isso os mesmo não precisa ser inserido no Orçamento. ' +
                                          'Remova-os para poder finalizar este Orçamento.';
            frmObservacao.ShowModal;
            pFreeAndNil(frmObservacao);

            Result := False;
          End;
        End;

        If Result Then
        Begin
          fatVenda.cdsPedRefOR.Filtered := False;
          fatVenda.cdsPedRefOR.Filter   := '(QTDDIF <> 0)';
          fatVenda.cdsPedRefOR.Filtered := True;

          Result := fatVenda.cdsPedRefOR.IsEmpty;

          If Not Result Then
          Begin
            pCriarFormularios(TfrmRelacaoItensPedRefOR, frmRelacaoItensPedRefOR);
            frmRelacaoItensPedRefOR.Caption  := frmRelacaoItensPedRefOR.Caption + ' ' + fatVenda.strNumPedRefOR + '-' + fatVenda.strEmpPedRefOR;
            frmRelacaoItensPedRefOR.cdsDados := fatVenda.cdsPedRefOR;
            frmRelacaoItensPedRefOR.ShowModal;
            pFreeAndNil(frmRelacaoItensPedRefOR);
          End;

          fatVenda.cdsPedRefOR.Filtered := False;
          fatVenda.cdsPedRefOR.Filter   := '';
          fatVenda.cdsPedRefOR.Filtered := True;
        End;
      End;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, 'TfrmFatVendas.fValidaItensPedRefOR');
      End;
    End;

    FreeAndNil(cdsClone);
  End;
end;

function TfrmFatVendas.fValidaItensRemessa(strClienteRemessa,
  strDocumentoRemessa: string): Boolean;
var
  qryConsulta: TUniQuery;
  strClaEnv: string;
  fltQtdeTotalPendente: Double;
  frmFatMostraProdDivergenteRemessa: TfrmFatMostraProdDivergenteRemessa;
  stlItens: TStringList;
  intIndice: Integer;
  fltQtdItensFaturamento: Double;
begin
  Result := False;

  strClaEnv := '5' + fCfgSis('CFRSAI') + '_' + '6' + fCfgSis('CFRSAI') + '_' + '5' + fCfgSis('CFRSAS') + '_' + '6' + fCfgSis('CFRSAS') + '_';
  qryConsulta := fCriaQuery;
  stlItens := TStringList.Create;
  try
    pCriarFormularios(TfrmFatMostraProdDivergenteRemessa, frmFatMostraProdDivergenteRemessa);
    frmFatMostraProdDivergenteRemessa.pAbreClient;

    If (fCfgSis('MDLVFE', varString) = '2') Then
    Begin
      qryConsulta.Close;
      qryConsulta.SQL.Clear;
      qryConsulta.SQL.Add(fSinteticoNotaRemessa(Not fEmptyStr(strDocumentoRemessa), False));

      qryConsulta.Close;
      qryConsulta.ParamByName('CODCLI').AsString := strClienteRemessa;
      qryConsulta.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryConsulta.ParamByName('CLAENV').AsString := strClaEnv;

      If (Not fEmptyStr(strDocumentoRemessa)) Then
        qryConsulta.ParamByName('NUMDOC').AsString := strDocumentoRemessa;

      qryConsulta.Open;
      If (qryConsulta.IsEmpty) Then
      Begin
        pMensagemOk('Documento não encontrado!');
        Exit;
      End;

      If (Not fEmptyStr(strDocumentoRemessa)) Then
      Begin
        fltQtdeTotalPendente := 0;

        qryConsulta.First;
        While Not qryConsulta.Eof Do
        Begin
          fltQtdeTotalPendente := fltQtdeTotalPendente
                                + qryConsulta.FieldByName('DET_QTDPEN').AsFloat;

          qryConsulta.Next;
        End;

        If (fFormataFloat(fltQtdeTotalPendente, fCfgSis('DECQTD', varInteger)) <= 0) Then
        Begin
          pMensagemOk('Documento informado não possui itens pendentes. Verifique.');
          Exit;
        End;
      End;
    End;

    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add(fSinteticoNotaRemessa(Not fEmptyStr(strDocumentoRemessa)));

    cdsVenda.DisableControls;
    cdsVenda.First;
    while not cdsVenda.Eof do
    begin
      qryConsulta.Close;
      qryConsulta.ParamByName('CODCLI').AsString := strClienteRemessa;
      qryConsulta.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryConsulta.ParamByName('CLAENV').AsString := strClaEnv;
      qryConsulta.ParamByName('CODITE').AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;

      If (Not fEmptyStr(strDocumentoRemessa)) Then
        qryConsulta.ParamByName('NUMDOC').AsString := strDocumentoRemessa;

      qryConsulta.Open;
      If qryConsulta.IsEmpty Then
      Begin
        If fEmptyStr(strDocumentoRemessa) Then
        Begin
          frmFatMostraProdDivergenteRemessa.pIncluirItem(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                         fRetNomProduto(cdsVenda.FieldByName('ITE_CODITE').AsString),
                                                         'Item não consta na remessa para o cliente',
                                                         cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                                         0);
        End
        Else
        Begin
          pMensagemOk('Documento não existe ou não encontrado para o cliente informado.');
          Exit;
        End;
      End
      Else
      Begin
        If (fFormataFloat(qryConsulta.FieldByName('DET_QTDPEN').AsFloat, fCfgSis('DECQTD', varInteger)) <
            fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fCfgSis('DECQTD', varInteger))) Then
        Begin
          frmFatMostraProdDivergenteRemessa.pIncluirItem(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                         fRetNomProduto(cdsVenda.FieldByName('ITE_CODITE').AsString),
                                                         'Item com divergencia nas quantidades',
                                                         cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                                         qryConsulta.FieldByName('DET_QTDPEN').AsFloat);
        End
        Else If (Not fEmptyStr(strDocumentoRemessa)) And (Not stlItens.Find(cdsVenda.FieldByName('ITE_CODITE').AsString, intIndice)) Then
        Begin
          fltQtdItensFaturamento := frmFatMostraProdDivergenteRemessa.fRetQtdItensFaturamento(cdsVenda, qryConsulta.FieldByName('DET_QTDPEN').AsFloat, cdsVenda.FieldByName('ITE_CODITE').AsString);

          If (fltQtdItensFaturamento > fFormataFloat(qryConsulta.FieldByName('DET_QTDPEN').AsFloat, fCfgSis('DECQTD', varInteger))) Then
          Begin
            frmFatMostraProdDivergenteRemessa.pIncluirItem(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                           fRetNomProduto(cdsVenda.FieldByName('ITE_CODITE').AsString),
                                                           'Item com divergencia nas quantidades',
                                                           fltQtdItensFaturamento,
                                                           qryConsulta.FieldByName('DET_QTDPEN').AsFloat);
          End;

          stlItens.Add(cdsVenda.FieldByName('ITE_CODITE').AsString);
        End;
      End;

      cdsVenda.Next;
    end;

    if frmFatMostraProdDivergenteRemessa.cdsItensRemessa.RecordCount > 0 then
    begin
      frmFatMostraProdDivergenteRemessa.ShowModal;
      Exit;
    end;

    Result := True;
  finally
    cdsVenda.EnableControls;
    FreeAndNil(qryConsulta);
    FreeAndNil(stlItens);
    pFreeAndNil(frmFatMostraProdDivergenteRemessa);
  end;
end;

function TfrmFatVendas.fValidaItensVencidos(dtaDtaVal: TDateTime = 0;
                                            strCodIte: String = '';
                                            strDesIte: String = '';
                                            strDesMar: String = '';
                                            strUnidad: String = '';
                                            fltSalDis: Double = 0;
                                            fltQtdIte: Double = 0;
                                            fltUnitar: Double = 0;
                                            fltTotIte: Double = 0;
                                            fltUniOri: Double = 0): Boolean;
  Var
    objTabela : TRegistroMsgLiberaTabela;
    objLinha  : TLinhaMsgLibera;
    cdsClone: TUniClientDataSet;

    strCodEmi,
    strDesEmi,
    strMarEmi,
    strUndEmi,
    strDtaEmi,
    strSalEmi,
    strQtdEmi,
    strUniOri,
    strUniTar,
    strTotIte: String;

    fltSalTmp: Double;

  function fGetSalDis: Double;
    Var
      strEmpIte: String;
  Begin
    With cdsClone Do
    Begin
      strEmpIte := IfThen(fEmptyStr(FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, FieldByName('ITE_EMPITE').AsString);

      If Not fEmptyStr(FieldByName('ITE_NUMLOT').AsString) Then
      Begin
        If fatVenda.objCadLot.fExisteLote(FieldByName('ITE_CODITE').AsString,
                                          strEmpIte,
                                          FieldByName('ITE_NUMLOT').AsString) Then
          Result := fatVenda.objCadLot.qryCadLot.FieldByName('LOT_SALDOS').AsFloat
        Else
          Result := 0;

        If fUsaQtdPendenteEntregaFutura(True, strEmpIte) Then
          Result := Result + TEntregaFutura.New(
                               TParamEF.New()
                                 .CodIte(FieldByName('ITE_CODITE').AsString)
                                 .CodEmp(strEmpIte)
                                 .Lote(FieldByName('ITE_NUMLOT').AsString)
                                 .Faturamento(True)
                               ).Total();

        Result := Result - TSaldoReservado.New(
                             TReservaParametros.New()
                               .EmpresaItem(strEmpIte)
                               .NumeroDocumento(fatVenda.strNumOrc)
                               .CodigoItem(FieldByName('ITE_CODITE').AsString)
                               .CodEmpresa(strEmpIte)
                               .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                               .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                               .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                               .NumeroLote(FieldByName('ITE_NUMLOT').AsString)
                               .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                            ).fGetQuantidade();
      End
      Else
      Begin
        If fatVenda.blnSaldoMatriz Then
          fatVenda.pCarregaEstoqueMatriz(FieldByName('ITE_CODITE').AsString, '');

        If fatVenda.blnSaldoMatriz Then
          Result := fatVenda.fltSaldoMatriz
        Else
          Result := FieldByName('ITE_SALDOS').AsFloat;

        If fUsaQtdPendenteEntregaFutura(True, strEmpIte) Then
          Result := Result + TEntregaFutura.New(
                               TParamEF.New()
                                 .CodIte(FieldByName('ITE_CODITE').AsString)
                                 .CodEmp(strEmpIte)
                                 .Faturamento(True)
                               ).Total();

        Result := Result - TSaldoReservado.New(
                             TReservaParametros.New()
                               .EmpresaItem(strEmpIte)
                               .NumeroDocumento(fatVenda.strNumOrc)
                               .CodigoItem(FieldByName('ITE_CODITE').AsString)
                               .CodEmpresa(strEmpIte)
                               .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                               .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                               .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                               .NumeroLote(FieldByName('ITE_NUMLOT').AsString)
                               .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                            ).fGetQuantidade();
      End;
    End;
  End;
begin
  Result := True;

  If Not fCfgSis('VALFOR', VarBoolean) Then
    Exit;

  objLiberacao.Clear;
  objLiberacao.objMsgLibera.pAddSeparador(127);
  objLiberacao.objMsgLibera.pAddTexto('<<<   Data de Validade de Preço da Tabela do Fornecedor Expirada   >>>', alCentro, teAmbos, '', 127);
  objLiberacao.objMsgLibera.pAddSeparador(127);
  objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'     , edtCodCli.Text + '-' + edtNomCli.Text                         , 10);
  objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor'    ,fatVenda.strCodVen + '-' + fRetNomVendRep(fatVenda.strCodVen)  , 10);

  If fCfgSis('CNDVEN') = 'I' Then
  Begin
    objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pag' , fatVenda.strCodCnd + '-' + fRetDesConPag(fatVenda.strCodCnd)  , 10);
    objLiberacao.objMsgLibera.pAddTextoCaption('Prz. Cond' , fFormataCondPag(fatVenda.strConPag)                           , 10);
    objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pgto', fatVenda.strCodFpg + '-' + fRetDesFpg(fatVenda.strCodFpg)     , 10);
  End;

  objTabela := TRegistroMsgLiberaTabela.Create;

  objLinha  := TLinhaMsgLibera.Create;
  objLinha.enuTipoLinha := tlCabecalho;
  objLinha.pAddColuna(''  , 'Código/Descrição' , 24 , alEsquerda , teAutcom);
  objLinha.pAddColuna(''  , 'Marca'            , 7  , alEsquerda , teAutcom);
  objLinha.pAddColuna(''  , 'Und.'             , 4  , alCentro   , teAutcom);
  objLinha.pAddColuna(''  , 'Validade'         , 9  , alCentro   , teAutcom);
  objLinha.pAddColuna(''  , 'Saldo Disp.'      , 12 , alDireita  , teAutcom);
  objLinha.pAddColuna(''  , 'Quantidade'       , 12 , alDireita  , teAutcom);
  objLinha.pAddColuna(''  , 'Pr. Unitário'     , 13 , alDireita  , teAutcom);
  objLinha.pAddColuna(''  , 'Valor Total'      , 14 , alDireita  , teAutcom);
  objLinha.pAddColuna(''  , 'Pr. Tabela'       , 13 , alDireita  , teAutcom);
  objTabela.lstLinhas.Add(objLinha);



  If fEmptyStr(strCodIte) Then
  Begin
    cdsClone := TUniClientDataSet.Create(Self);
    pCloneDataSet(cdsClone, cdsVenda);

    With cdsClone Do
    Begin
      First;

      While Not Eof Do
      Begin

        If FieldByName('ITE_DTAVAL').AsDateTime < fNow Then
        Begin
          fltSalTmp := fGetSalDis;

          strCodEmi := FieldByName('ITE_CODITE').AsString;
          strDesEmi := FieldByName('ITE_DESITE').AsString;
          strMarEmi := FieldByName('ITE_DESMAR').AsString;
          strUndEmi := fRetSiglaUni(FieldByName('ITE_UNIDAD').AsString);
          strDtaEmi := FormatDateTime('dd/mm/yy', FieldByName('ITE_DTAVAL').AsDateTime);
          strSalEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), fltSalTmp);
          strQtdEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), FieldByName('ITE_QTDITE').AsFloat);
          strUniTar := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), FieldByName('ITE_UNITAR').AsFloat);
          strTotIte := FormatFloat(fMskDigitos(2), FieldByName('ITE_TOTITE').AsFloat);
          strUniOri := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), FieldByName('ITE_UNIORI').AsFloat);


          objLinha  := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlValor;
          objLinha.pAddColuna('Código/Descrição' , strCodEmi + '-' + strDesEmi  , 24 , alEsquerda );
          objLinha.pAddColuna('Marca'            , strMarEmi                    , 7  , alEsquerda );
          objLinha.pAddColuna('Und.'             , strUndEmi                    , 4  , alCentro   );
          objLinha.pAddColuna('Validade'         , strDtaEmi                    , 9  , alCentro   );
          objLinha.pAddColuna('Saldo Disp.'      , strSalEmi                    , 12 , alDireita  );
          objLinha.pAddColuna('Quantidade'       , strQtdEmi                    , 12 , alDireita  );
          objLinha.pAddColuna('Pr. Unitário'     , strUniTar                    , 13 , alDireita  );
          objLinha.pAddColuna('Valor Total'      , strTotIte                    , 14 , alDireita  );
          objLinha.pAddColuna('Pr. Tabela'       , strUniOri                    , 13 , alDireita  );
          objTabela.lstLinhas.Add(objLinha);

          Result := False;
        End;

        Next;
      End;
    End;

    FreeAndNil(cdsClone);
  End
  Else
  Begin
    If dtaDtaVal < fNow Then
    Begin
      strCodEmi := strCodIte;
      strDesEmi := strDesIte;
      strMarEmi := strDesMar;
      strUndEmi := strUnidad;
      strDtaEmi := FormatDateTime('dd/mm/yy', dtaDtaVal);
      strSalEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), fltSalDis);
      strQtdEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), fltQtdIte);
      strUniTar := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniTar);
      strTotIte := FormatFloat(fMskDigitos(2), fltTotIte);
      strUniOri := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniOri);

      objLinha  := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlValor;
      objLinha.pAddColuna('Código/Descrição' , strCodEmi + '-' + strDesEmi  , 24 , alEsquerda );
      objLinha.pAddColuna('Marca'            , strMarEmi                    , 7  , alEsquerda );
      objLinha.pAddColuna('Und.'             , strUndEmi                    , 4  , alCentro   );
      objLinha.pAddColuna('Validade'         , strDtaEmi                    , 9  , alCentro   );
      objLinha.pAddColuna('Saldo Disp.'      , strSalEmi                    , 12 , alDireita  );
      objLinha.pAddColuna('Quantidade'       , strQtdEmi                    , 12 , alDireita  );
      objLinha.pAddColuna('Pr. Unitário'     , strUniTar                    , 13 , alDireita  );
      objLinha.pAddColuna('Valor Total'      , strTotIte                    , 14 , alDireita  );
      objLinha.pAddColuna('Pr. Tabela'       , strUniOri                    , 13 , alDireita  );
      objTabela.lstLinhas.Add(objLinha);

      Result := False;
    End;
  End;

  If Result Then
    FreeAndNil(objTabela)
  else
  begin
    objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);
    objLiberacao.strDirAce := 'SENFOR';
    objLiberacao.strSenLib := fCfgSis('SENFOR');
    objLiberacao.strMsgSen := 'Liberação da Validade de Preço da Tabela do Fornecedor';
    objLiberacao.strCodOpe := fatVenda.strCodVen;
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.objMsgLibera.strTitulo := 'Validade de Preço da Tabela do Fornecedor';

    Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
  end;
end;

