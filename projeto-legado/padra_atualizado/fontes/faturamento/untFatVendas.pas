function TfrmFatVendas.fCarregarDuplicatasPedirFormasPagamento(): Boolean;
Type
  TDigDuplicResult = (ddrTrue, ddrBreak, ddrContinue, ddrClose);

Var
  intContador: Integer;
  frmFatFormasPagamento : TfrmFatFormasPagamento;
  blnDescontaCreditoAutomatico: Boolean;
  varDigDuplicResult: TDigDuplicResult;

  function fChamaDigitaDuplic(aResult: Boolean; aStrCodFpg: String): TDigDuplicResult;
    Var
      fltCreAut: Double;
  begin
    Result := IIF(aResult, ddrTrue, ddrBreak);

    If (Result = ddrTrue) Then
    Begin
      If (fatVenda.fDescontaCreditoAutomatico((ckbAbCrAu.Enabled) And (ckbAbCrAu.Checked))) Then
        fltCreAut := fGetTotalCredCli(edtCodCli.Text, strNumOrc, strEspOrc, strEmpOrc, blnUsaEmpOri)
      Else
        fltCreAut := 0;

      If (Not fatVenda.fDigitaDuplicata(FVariaveisFechamentoVenda.blnMostraDigDuplic,
                                        FVariaveisFechamentoVenda.arrDatas,
                                        IIF(fUsaPrevisaoDeEntregaNoFinal(fatVenda.strOpcDoc) Or fatVenda.fUtilizarDataPrvDataFatComoDataBaseParaCalculoVencimento(aStrCodFpg),
                                            fatVenda.dtaPreVis,
                                            StrToDateDef(mskPreVis.Text, 0)),
                                        False,
                                        arrDuplicCop,
                                        0,
                                        fltCreAut)) Then
      Begin
        Result := ddrClose;
      End;
    End;

    If (Result = ddrTrue) And fatVenda.fPedeDuplicata Then
    Begin
      If (fatVenda.strConPag <> '01999') Then
      Begin
        FVariaveisFechamentoVenda.strCndTmp := fRetornaCndPag(FVariaveisFechamentoVenda.arrDatas, fatVenda.dtaDigDup);

        {********************************************}
        {* VERIFICA TRAVAS DE CONDIÇÃO DE PAGAMENTO *}
        {*****************************************MV*}
        If (Not fTravaCondicaoPagamento(FVariaveisFechamentoVenda.strCndTmp, FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, strOpcDoc)) Then
        Begin
          If (fCfgSis('CNDVEN') = 'I') Then
        Result := ddrBreak
          Else
        Result := ddrContinue
        End;

        If (fatVenda.Vs_blnUsaFpg)              And
           (fStatusCndPag(FVariaveisFechamentoVenda.strCndTmp) = A_VISTA) And
           (FVariaveisFechamentoVenda.blnMostraDigDuplic)                 Then
        Begin
          fMensagem('', 'A condição de pagamento deve ser a prazo.', ['&Ok']);
          Result := ddrContinue;
        End;

        FVariaveisFechamentoVenda.strCndAtu := FVariaveisFechamentoVenda.strCndTmp;

        {*************************************************************}
        {* CASO FOI ALTERADO A CONDICAO DE PAGAMENTO, ENTAO          *}
        {* VALIDA O PRAZO MEDIO DA NOVA CONDICAO...                  *}
        {**********************************************************JC*}
        If (((fatVenda.strConPag <> FVariaveisFechamentoVenda.strCndAtu) Or (Not fatVenda.blnVerPrzMed)) And (Not fatVenda.fVerificaPrazoMedio(FVariaveisFechamentoVenda.strCndAtu))) Or
          (((fatVenda.strConPag <> FVariaveisFechamentoVenda.strCndAtu) Or (Not fatVenda.blnVerMaxPar)) And (Not fatVenda.fVerificaQtdMaxParcelas(FVariaveisFechamentoVenda.strCndAtu))) Then
        Begin
          Result := ddrContinue;
//        Result := False;
//        Break;
        End
        Else
          fatVenda.strConPag := FVariaveisFechamentoVenda.strCndAtu;
      End
      Else
        FVariaveisFechamentoVenda.strCndAtu := '01999';
    End;
  end;

begin
  Result := True;
  fatVenda.blnReceberTefPorUltimo := False;
  {*****************************************}
  {* CARREGA DUPLICATAS PARA PAGAMENTO     *}
  {**************************************MV*}
  While True Do
  Begin
    If (fatVenda.strOpcDoc = 'CP') And (fatVenda.strCodFpg = '016') And
       (fatVenda.objFinanc.fRetDespesasAcessorias > 0) Then
      fatVenda.pRecalculaTotGerFinanceira;

    fatVenda.pCalculaTotalParaCadRec;

    {************************************************************************}
    {* Caso o total ja pago pelo cliente for maior que zero, implicando na  *}
    {* geracao de credito para o cliente (total para contas a receber < 0), *}
    {* somente ira gerar este credito caso a configuracao permita           *}
    {*********************************************************************JC*}
    If (fatVenda.fltDupRec > 0) And
       (fatVenda.fltTotCadRec < 0) And (Not fCfgSis('GERCRE', varBoolean)) Then
    Begin
      fatVenda.fltTotCadRec := 0;
    End;

    If (Not fatVenda.blnGravaCtrTe) And (fatVenda.blnCliFil) Then
      fatVenda.fltTotCadRec := 0;

    If (fatVenda.strOpcDoc = 'DV') And blnDevEsp Then
      fatVenda.fltTotCadRec := 0;

    If (fatVenda.fltTotCadRec <> 0.0) Then //Marcos
    Begin
      If (Pos(fatVenda.strEspDoc, 'NF_EL_NS_MI_FF_IF_IV_D1_TR_DV_PR_PD_TE_OR_DD_CS_') > 0) And
         IIF(fatVenda.strOpcDoc = 'NC', IIF(not fatVenda.blnNCFornecedor And
                                           (fatVenda.objNfeComplemento.tncTipoNota in [tncComplementoValor, tncComplementoIPI, tncComplementoFrete]), True,
                                        IIF(fatVenda.blnNCFornecedor And
                                           (fatVenda.objNfeComplemento.tncTipoNota in [tncCreditoIcms, tncEstornoDeCredito]) And
                                            fatVenda.blnOFGCTP, True, False)), True) Then
      Begin
        varDigDuplicResult := fChamaDigitaDuplic(Result, '');
        If (varDigDuplicResult = ddrClose) Then
        Begin
          Result := False;
          Break;
        End
        Else If (varDigDuplicResult = ddrBreak) Then
          Break
        Else If (varDigDuplicResult = ddrContinue) Then
          Continue;

        {************************************************************************************************************}
        {* Caso for emissao de pedido, configurado para travar a forma de pagamento negociada (F11-Resumo de caixa) *}
        {* e foi selecionado forma de pagamento Parcelado, entao pede as formas de pagamento                        *}
        {* negociadas com o cliente para travar no resumo de caixa...                                               *}
        {*********************************************************************************************************JC*}
        If ((Pos(fatVenda.strEspDoc, 'OR_PD') > 0) And (fatVenda.VS_blnUsaFpg)) And
           (((fCfgSis('TFPF11', varBoolean) Or fCfgSis('SFPGPD', varBoolean)) And
           fPos(fatVenda.strCodFpg, '009_013_')) Or
           (fatVenda.fDescontaCreditoAutomatico((ckbAbCrAu.Enabled) And (ckbAbCrAu.Checked)))) Then
        Begin
          blnDescontaCreditoAutomatico := fatVenda.fDescontaCreditoAutomatico((ckbAbCrAu.Enabled) And (ckbAbCrAu.Checked));
          With fatvenda, objFormasPagtoNegociada Do
          Begin
            strCodCar := '';
            intQtdPaC := 0;
            Result    := True;

            If fatVenda.fBaixaAdiantamentoAutomatico And (fltValAdt>0) And
               ((fltTotCadRec - fltValAdt - fltBolAdt) <> 0) Then
            Begin
              If (fMensagem('ATENÇÃO!', 'Existem adiantamentos baixados para esse pedido. Será necessário estornar para efetuar um novo adiantamento. Confirma o estorno?', ['&S i m', '&N ã o'], 2) = 1) Then
              Begin
                pEstornaAdiantamentoAutomatico(strNumOrc, strEspOrc, strEmpOrc);
                fatVenda.recValAdt := TAdiantamento.fGetTotaisAdiantamento(strNumOrc, strEspOrc, strEmpOrc);
                fatVenda.fltValAdt := fatVenda.recValAdt.fltValLan;
                objFormasPagtoNegociada.pCarregarFormasPagtoNegociadas(fatVenda.strIncOrc);
              End
              Else
                Result := False;
            End;

            If Result Then
              Result := fPedeFormasPagamento(strOpcDoc,
                                             strCodCli,
                                             strCodFpg,
                                             strCodCnd,
                                             strConPag,
                                             blnEnt_CD,
                                             (fltDupRec + fltValAdt + fltBolAdt) > 0,
                                             fltTotCadRec - fltValAdt - fltBolAdt,
                                             ((strCodFpg <> '013') And (Not blnDescontaCreditoAutomatico)),
                                             blnDescontaCreditoAutomatico,
                                             blnUsaEmpOri);

            If Result And fFormaPagtoSelecionada('007') Then
            Begin
              strCodCar := cdsFormasNegociadas.FieldByName('CODCAR').AsString;
              intQtdPaC := cdsFormasNegociadas.FieldByName('QTDPAR').AsInteger;
            End;

            If Result And fatVenda.fBaixaAdiantamentoAutomatico And fFormaPagtoSelecionada('013') Then
            Begin
              blnBaixaAdiantamentoAutomatico := True;
              fatVenda.stlDupCreditos.text := fBuscaDuplicatasSelecionadas;
              fltCredUtilizados := fValorFormaPagtoSelecionada('013');
            End;

            If (blnDescontaCreditoAutomatico) And (fltCredUtilizados > 0) Then
              fltTotCredAutomatico := fltCredUtilizados;

            If Result And fFormaPagtoSelecionada('008') Then
            Begin
              fatVenda.strConPag := cdsFormasNegociadas.FieldByName('CONPAG').AsString;
              varDigDuplicResult := fChamaDigitaDuplic(Result, '008');
              If (varDigDuplicResult = ddrClose) Then
              Begin
                Result := False;
                Break;
              End
              Else If (varDigDuplicResult = ddrBreak) Then
                Break
              Else If (varDigDuplicResult = ddrContinue) Then
                Continue;
            End;
          End;
        End

        {*************************************}
        {* ABRE TELA PARA DIGITAÇÃO DE FORMA *}
        {* DE PAGAMENTO                      *}
        {**********************************AF*}
        {*******************************************}
        {* SÓ ENTRA NESSES CALCULOS SE NAO FOR MEIA*}
        {* NOTA                                    *}
        {****************************************MV*}
        Else If (Pos(strOpcDoc, 'OR_PD_TE_NC_BR_OU_OV_OF_OE_EF_CE_UC_CN_') <= 0) And
                (Not fatVenda.blnMeiaNota) And
                (fatVenda.fltTotCadRec > fatVenda.fltValAdt + fatVenda.fltBolAdt) Then
        Begin
          FVariaveisFechamentoVenda.fltTotMod := fatVenda.fltTotCadRec - fatVenda.fltValAdt - fatVenda.fltBolAdt;

          {************************************}
          {* SE FOR DINHEIRO                  *}
          {*********************************AF*}
          If (fatVenda.VS_blnUsaFpg) And ((fatVenda.strCodFpg = '001') Or (fEmptyStr(fatVenda.strCodFpg) And (Pos(fatVenda.strEspDoc, 'DV_PR_TR_DD_') > 0))) Then
          Begin
            fatVenda.fltValDin := FVariaveisFechamentoVenda.fltTotMod;
          End

          {************************************}
          {* SE FOR CARTAO DE CREDITO         *}
          {*********************************AF*}
          Else If ((fatVenda.VS_blnUsaFpg) And
                   (fatVenda.strCodFpg = '007') And
                   (fatVenda.fBaixaDuplicataAVista)) Then
          Begin

            if Assigned(fatVenda.objTefRecebimento) then
              fatVenda.blnReceberTefPorUltimo := True
            else
              Result := fDigCartoes(FVariaveisFechamentoVenda.fltTotMod,
                                    qryFatGor.FieldByName('FGO_CODCAR').AsString,
                                    EmptyStr,
                                    qryFatGor.FieldByName('FGO_QTDPAC').AsInteger);

          End

          {************************************}
          {* SE FOR CHEQUE A VISTA            *}
          {*********************************AF*}
          Else If (fatVenda.VS_blnUsaFpg) And (fatVenda.strCodFpg = '006') And (fatVenda.fBaixaDuplicataAVista) Then
          Begin

            If (fCfgSis('CHQRCX', varBoolean)) And
               (fCfgSis('CHQVIS', varBoolean)) And
               (Pos(fatVenda.strEspDoc, 'PD_OR_') <= 0)  And
               (Pos(fatVenda.strOpcDoc, 'TR_DV_PR_DD_') <= 0)  And
               (fStrToFloat(edtTotImp.Text) >= 0)        Then
            Begin

              Try
                pCriarFormularios(TfrmFatFormasPagamento,frmFatFormasPagamento);

                If (fCfgSis('USADIG')= 'S') Then
                  frmFatFormasPagamento.strCodOpe := fatVenda.strCodDig
                Else
                  frmFatFormasPagamento.strCodOpe := fatVenda.strCodVen;

                frmFatFormasPagamento.strCodCnd    := fatVenda.strCodCnd;
                frmFatFormasPagamento.strMskCnd    := fatVenda.strConPag;
                frmFatFormasPagamento.fltValTot    := FVariaveisFechamentoVenda.fltTotMod;
                frmFatFormasPagamento.cdsChqPre    := fatVenda.cdsChequePre;
                frmFatFormasPagamento.cdsChqVis    := fatVenda.cdsChequeVis;
                frmFatFormasPagamento.blnTroChq    := (fCfgSis('TROCHQ', varBoolean)); // Troco para cheque;
                frmFatFormasPagamento.blnAltBas    := fUtilizarComoDataBaseCtrDataEmissaoPedido(fatVenda.fFaturandoPedido, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento) Or fatVenda.fUtilizarDataPrvDataFatComoDataBaseParaCalculoVencimento;
                If (fUtilizarComoDataBaseCtrDataPrevisaoPedido(fatVenda.fFaturandoPedido)) And (fatVenda.dtaPreVis <> 0) And (VS_Date < fatVenda.dtaPreVis) Then
                  frmFatFormasPagamento.dtaDtaEntOri := fatVenda.dtaPreVis
                Else
                  frmFatFormasPagamento.dtaDtaEntOri := fatVenda.dtaDtaEntOri;

                Result := frmFatFormasPagamento.fChequeVis(FloatToStrF(FVariaveisFechamentoVenda.fltTotMod,ffFixed,12,2),
+                                                          IIF(MatchStr(fatVenda.strOpcDoc, ['CP', 'CF']), 'CONFIRMAÇÃO DE VENDAS', 'VENDA'));

                If Not Result Then
                Begin
                  fatVenda.objFinanc.pLimpaDados;
                  fatVenda.cdsChequePre.EmptyDataSet;
                  fatVenda.cdsChequeVis.EmptyDataSet;
                  fatVenda.optTroco      := otNada;
                  fatVenda.fltValorTroco := 0.0;
                End
                Else
                Begin
                  fatVenda.optTroco      := frmFatFormasPagamento.optTroco;
                  fatVenda.fltValorTroco := frmFatFormasPagamento.fltValorTroco;
                  fatVenda.fltValCqV     := FVariaveisFechamentoVenda.fltTotMod;
                  If fatVenda.optTroco = otTroco Then
                    fatVenda.fltValCqV := fatVenda.fltValCqV + fatVenda.fltValorTroco;
                End;

              Except
                On E: Exception Do
                Begin
                  Result := False;
                  pMensagensErro(E.Message, '[fConfirmaVenda_9]');
                End;
              End;

              pFreeAndNil(frmFatFormasPagamento);

            End
            Else
            Begin
              fatVenda.fltValCqV := FVariaveisFechamentoVenda.fltTotMod;
            End;

          End

          {************************************}
          {* SE FOR CHEQUE A PRAZO            *}
          {*********************************AF*}
          Else If (fatVenda.VS_blnUsaFpg) And (fatVenda.strCodFpg = '002') And (fatVenda.fBaixaDuplicataAVista) Then
          Begin

            If (fCfgSis('CHQRCX', varBoolean)) And
               (Pos(fatVenda.strEspDoc, 'PD_OR_') <= 0)  And
               (Pos(fatVenda.strOpcDoc, 'TR_DV_PR_DD_') <= 0)  And
               (fStrToFloat(edtTotImp.Text) >= 0)        Then
            Begin

              Try
                pCriarFormularios(TfrmFatFormasPagamento,frmFatFormasPagamento);

                If (fCfgSis('USADIG')= 'S') Then
                  frmFatFormasPagamento.strCodOpe := fatVenda.strCodDig
                Else
                  frmFatFormasPagamento.strCodOpe := fatVenda.strCodVen;

                frmFatFormasPagamento.strCodCnd    := fatVenda.strCodCnd;
                frmFatFormasPagamento.strMskCnd    := fatVenda.strConPag;
                frmFatFormasPagamento.fltValTot    := FVariaveisFechamentoVenda.fltTotMod;
                frmFatFormasPagamento.cdsChqPre    := fatVenda.cdsChequePre;
                frmFatFormasPagamento.cdsChqVis    := fatVenda.cdsChequeVis;
                frmFatFormasPagamento.blnTroChq    := (fCfgSis('TROCHQ', varBoolean)); // Troco para cheque;
                frmFatFormasPagamento.blnAltBas    := fUtilizarComoDataBaseCtrDataEmissaoPedido(fatVenda.fFaturandoPedido, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento) Or fatVenda.fUtilizarDataPrvDataFatComoDataBaseParaCalculoVencimento;
                If (fUtilizarComoDataBaseCtrDataPrevisaoPedido(fatVenda.fFaturandoPedido)) And (fatVenda.dtaPreVis <> 0) And (VS_Date < fatVenda.dtaPreVis) Then
                  frmFatFormasPagamento.dtaDtaEntOri := fatVenda.dtaPreVis
                Else
                  frmFatFormasPagamento.dtaDtaEntOri := fatVenda.dtaDtaEntOri;

                frmFatFormasPagamento.strConfDocsAutIncCadRec := fatVenda.strConfDocsAutIncCadRec;

                Result := frmFatFormasPagamento.fChequePre(FloatToStrF(FVariaveisFechamentoVenda.fltTotMod,ffFixed,12,2),
+                                                          IIF(MatchStr(fatVenda.strOpcDoc, ['CP', 'CF']), 'CONFIRMAÇÃO DE VENDAS', 'VENDA'));

                If Not Result Then
                Begin
                  fatVenda.objFinanc.pLimpaDados;
                  fatVenda.cdsChequePre.EmptyDataSet;
                  fatVenda.cdsChequeVis.EmptyDataSet;
                  fatVenda.optTrocoPre      := otNada;
                  fatVenda.fltValorTrocoPre := 0.0;
                End
                Else
                Begin
                  fatVenda.optTrocoPre      := frmFatFormasPagamento.optTroco;
                  fatVenda.fltValorTrocoPre := frmFatFormasPagamento.fltValorTroco;
                  fatVenda.fltValCqP        := FVariaveisFechamentoVenda.fltTotMod;
                  If fatVenda.optTrocoPre = otTroco Then
                    fatVenda.fltValCqP := fatVenda.fltValCqP + fatVenda.fltValorTrocoPre;
                End;

              Except
                On E: Exception Do
                Begin
                  Result := False;
                  pMensagensErro(E.Message, '[fConfirmaVenda_10]');
                End;
              End;

              pFreeAndNil(frmFatFormasPagamento);

            End
            Else
            Begin
              fatVenda.fltValCqP := FVariaveisFechamentoVenda.fltTotMod;
            End;

          End
          {*******************************}
          {* SE FOR FINANCIAMENTO        *}
          {****************************LA*}
          // VAI ENTRAR COMO CARTAO
          Else If (fatVenda.VS_blnUsaFpg) And ((fatVenda.strCodFpg = '016')) Then
          Begin
            fatVenda.fltValFin := FVariaveisFechamentoVenda.fltTotMod;
          End

          {*******************************************}
          {* SE FOR 008 - FATURADO -> E <- FOR PAGA- *}
          {* MENTO ANTECIPADO, GRAVA O PAGAMENTO AN- *}
          {* TECIPADO COMO DINHEIRO NO CAIXA         *}
          {****************************************MV*}
          Else If (fatVenda.VS_blnUsaFpg) And (Pos(fatVenda.strCodFpg,'008_') > 0) Then
          Begin
            {***********************************************************************}
            {* ADICIONADO A ATRIBUIÇÃO ABAIXO POIS NÃO ESTAVA GRAVANDO MODALIDADES *}
            {* "MOVMOD" QUANDO ENTRAVA NA ROTINA PARA DESMEMBRAR OS DOCUMENTOS     *}
            {* REQ: 25664 - 16/10/2014                                             *}
            {********************************************************************RN*}
            fatVenda.fltFatura := FVariaveisFechamentoVenda.fltTotMod;
          End

          {****************************************************}
          {* SE FOR 013 - Utilização de Creditos E CFG_BAIAVI *}
          {****************************************************}
          Else If (fatVenda.VS_blnUsaFpg) And (Pos(fatVenda.strCodFpg,'013_') > 0) And fCfgSis('BAIAVI', VarBoolean) Then
          Begin
            Result := fPedirFormasPagamentoCreditoCliente;
            If Result Then
            Begin
              FVariaveisFechamentoVenda.blnMostraDigDuplic := False;
              fatVenda.strConPag := '01000';
            End
          End

          {************************************}
          {* SE FOR PARCELADO                 *}
          {*********************************AF*}
          Else If (fatVenda.VS_blnUsaFpg) And (fatVenda.strCodFpg = '009') and (not fEhVnFechandoOrcamento) Then
          Begin

            Try
              pCriarFormularios(TfrmFatFormasPagamento,frmFatFormasPagamento);
              frmFatFormasPagamento.fatVenda     := fatVenda;
              frmFatFormasPagamento.strCodOpe    := fatVenda.strCodDig;
              frmFatFormasPagamento.strCodCnd    := fatVenda.strCodCnd;
              frmFatFormasPagamento.strMskCnd    := fatVenda.strConPag;
              frmFatFormasPagamento.fltValTot    := FVariaveisFechamentoVenda.fltTotMod;
              frmFatFormasPagamento.cdsChqPre    := fatVenda.cdsChequePre;
              frmFatFormasPagamento.cdsChqVis    := fatVenda.cdsChequeVis;
              frmFatFormasPagamento.blnAltBas    := fUtilizarComoDataBaseCtrDataEmissaoPedido(fatVenda.fFaturandoPedido, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento) Or fatVenda.fUtilizarDataPrvDataFatComoDataBaseParaCalculoVencimento;
              If (fUtilizarComoDataBaseCtrDataPrevisaoPedido(fatVenda.fFaturandoPedido)) And (fatVenda.dtaPreVis <> 0) And (VS_Date < fatVenda.dtaPreVis) Then
                frmFatFormasPagamento.dtaDtaEntOri := fatVenda.dtaPreVis
              Else
                frmFatFormasPagamento.dtaDtaEntOri := fatVenda.dtaDtaEntOri;

              frmFatFormasPagamento.blnFpg009 := True;

              If fClienteConsumidor(fatVenda.strCliOri, False, True) Then
              Begin
                frmFatFormasPagamento.edtFaturado.ReadOnly := True;
                frmFatFormasPagamento.edtFaturado.Visible := False;
                frmFatFormasPagamento.lblFaturado.Visible := False;
                frmFatFormasPagamento.Height              := 270;
              End;

              if fCfgSis('BAIAVI', VarBoolean) then
              begin
                frmFatFormasPagamento.strCliente          := fatVenda.strCodCli;
                frmFatFormasPagamento.edtValCre.Enabled   := True;
                frmFatFormasPagamento.edtValCre.Visible   := True;
                frmFatFormasPagamento.lblValCre.Visible   := True;
                frmFatFormasPagamento.lblValCre.Caption   := 'Crédito Cliente:';
              end;

              frmFatFormasPagamento.edtFinanc.Enabled := Pos(fatVenda.strOpcDoc, 'VN_CS_') > 0;
              frmFatFormasPagamento.lblFinanc.Enabled := Pos(fatVenda.strOpcDoc, 'VN_CS_') > 0;

              if Assigned(fatVenda.objTefRecebimento) then //'TEFVN_'
              Begin
                frmFatFormasPagamento.objTefRecebimento            := fatVenda.objTefRecebimento;
                frmFatFormasPagamento.strSessaoTef                 := fatVenda.strSessaoTef;
                frmFatFormasPagamento.blnExecutandoPeloFaturamento := True;
              End;

              If frmFatFormasPagamento.ShowModal = mrOK Then
                Result := True
              Else
              Begin
                if fGaranteCancelamentoTefCitel(frmFatFormasPagamento.arrCartoes) then
                  if not fAutoConfirmaTransacaoPendenteEstaAtivada then
                    fMensagem('ATENÇÃO!', 'Transação de cartão no TEF foi DESFEITA!'+#13+'Avisar cliente.', ['&Ok']);
                fatVenda.blnRealizandoAdiantamentoPedidoPeloVN := False ;
                fatVenda.objFinanc.pLimpaDados;
                Result := False;
              End;

              If Result Then
              Begin
                If (frmFatFormasPagamento.fltDinhei + frmFatFormasPagamento.fltChqVis + frmFatFormasPagamento.fltChqPre +
                    frmFatFormasPagamento.fltCartao + frmFatFormasPagamento.fltOrdPag + frmFatFormasPagamento.fltFatura +
                    frmFatFormasPagamento.fltValFin + frmFatFormasPagamento.fltValCrd) = 0 Then
                  Result := False;
              End;

              If Result Then
              Begin
                fatVenda.optTrocoDinheiro      := frmFatFormasPagamento.optTroco;
                fatVenda.fltValorTrocoDinheiro := frmFatFormasPagamento.fltValorTroco;

                {************************************}
                {* ALIMENTA VARIAVEIS QUE VÃO SER   *}
                {* GRAVADAS NO RESUMO DE CAIXA      *}
                {*********************************AF*}
                fatVenda.fltValCqP := frmFatFormasPagamento.fltChqPre;
                fatVenda.fltValCqV := frmFatFormasPagamento.fltChqVis;
                fatVenda.fltValDin := frmFatFormasPagamento.fltDinhei;
                fatVenda.fltValCar := frmFatFormasPagamento.fltCartao;
                fatVenda.fltValOrd := frmFatFormasPagamento.fltOrdPag;
                fatVenda.fltFatura := frmFatFormasPagamento.fltFatura;
                fatVenda.fltValFin := frmFatFormasPagamento.fltValFin;
                fatVenda.fltValCre := - frmFatFormasPagamento.fltValCrd;

                if (fatVenda.fltValCre < 0) Then
                Begin
                  fatVenda.fltCredUtilizados   := frmFatFormasPagamento.fltValCrd;
                  fatVenda.fltTotCre           := frmFatFormasPagamento.fltTotCreditos;
                  fatVenda.stlDupCreditos.Text := frmFatFormasPagamento.stlDupCreditos.Text;
                End;

                {************************************}
                {* AGORA TENHO QUE MONTA UMA NOVA   *}
                {* FORMA DE PAGAMENTO               *}
                {*********************************AF*}
                For intContador := 0 To 23 Do
                Begin
                  arrDuplicFat[intContador] := fatVenda.arrDuplicata[intContador];
                End;

                SetLength(arrCartoes,Length(frmFatFormasPagamento.arrCartoes));

                For intContador := 0 To Length(frmFatFormasPagamento.arrCartoes)-1 Do
                Begin
                  arrCartoes[intContador] := frmFatFormasPagamento.arrCartoes[intContador];
                End;

                fatVenda.objFinanc.pSalvaCartoes(arrCartoes);

                If (frmFatFormasPagamento.fltDinhei > 0) Or
                   (frmFatFormasPagamento.fltChqVis > 0) Or
                   (frmFatFormasPagamento.fltChqPre > 0) Or
                   (frmFatFormasPagamento.fltCartao > 0) Or
                   (frmFatFormasPagamento.fltOrdPag > 0) Or
                   (frmFatFormasPagamento.fltValFin > 0) Or
                   (frmFatFormasPagamento.fltValCrd > 0) Then
                Begin
                  intContador := 0;
                  pZeraDigDuplic(fatVenda.arrDuplicata);

                  fatVenda.arrDuplicata[intContador].intNumDup := 0;
                  fatVenda.arrDuplicata[intContador].strSequen := 'A';
                  fatVenda.arrDuplicata[intContador].curValor  := frmFatFormasPagamento.fltDinhei +
                                                         frmFatFormasPagamento.fltChqVis +
                                                         frmFatFormasPagamento.fltChqPre +
                                                         frmFatFormasPagamento.fltCartao +
                                                         frmFatFormasPagamento.fltOrdPag +
                                                         frmFatFormasPagamento.fltValFin +
                                                         frmFatFormasPagamento.fltValCrd;

                  if frmFatFormasPagamento.fltValorTroco <> 0 then
                    fatVenda.arrDuplicata[intContador].curValor := fatVenda.arrDuplicata[intContador].curValor - frmFatFormasPagamento.fltValorTroco;

                  fatVenda.arrDuplicata[intContador].dtaDtaVen := FormatDateTime('dd/mm/yyyy',VS_Date);

                  If fatVenda.fltFatura > 0.0 Then
                  Begin

                    While (arrDuplicFat[intContador].dtaDtaVen <> '') And
                          (intContador < 23)                          Do
                    Begin

                      fatVenda.arrDuplicata[intContador + 1].intNumDup := 0;
                      fatVenda.arrDuplicata[intContador + 1].strSequen := String(arrLetras[intContador + 1]);
                      fatVenda.arrDuplicata[intContador + 1].curValor  := arrDuplicFat[intContador].curValor;
                      fatVenda.arrDuplicata[intContador + 1].dtaDtaVen := arrDuplicFat[intContador].dtaDtaVen;
                      Inc(intContador);

                    End;

                  End;

                End;


                intContador := 0;
                {*****************************************}
                {* REFAZ A CONDIÇÃO DE PAGAMENTO         *}
                {**************************************AF*}
                While (fatVenda.arrDuplicata[intContador].dtaDtaVen <> '') And (intContador < 23) Do
                Begin

                  SetLength(FVariaveisFechamentoVenda.arrDatas, intContador + 1);
                  FVariaveisFechamentoVenda.arrDatas[intContador] := StrToDate(fatVenda.ArrDuplicata[intContador].dtaDtaVen);
                  Inc(intContador);

                End;
                FVariaveisFechamentoVenda.strCndAtu := fRetornaCndPag(FVariaveisFechamentoVenda.arrDatas, VS_Date);

              End
              Else
              Begin
                fatVenda.optTrocoDinheiro      := otNada;
                fatVenda.fltValorTrocoDinheiro := 0;
              End;


            Except
              On E: Exception Do
              Begin
                Result := False;
                FVariaveisFechamentoVenda.strCndAtu := '';
                pMensagensErro(E.Message, '[fConfirmaVenda_11]');
              End;
            End;

            pFreeAndNil(frmFatFormasPagamento);

            {*************************************************************}
            {*  CASO A CONDICAO DE PAGAMENTO NAO TENHA SIDO ALTERADA     *}
            {*  OU PASSOU NA VALIDACAO DO PRAZO MEDIO A NOVA CONDICAO... *}
            {**********************************************************JC*}
            If ((fatVenda.strConPag = FVariaveisFechamentoVenda.strCndAtu) And (fatVenda.blnVerPrzMed) And (fatVenda.blnVerMaxPar)) Or
              ((fatVenda.fVerificaPrazoMedio(FVariaveisFechamentoVenda.strCndAtu)) And (fatVenda.fVerificaQtdMaxParcelas(FVariaveisFechamentoVenda.strCndAtu))) Then
              Break
            Else
              Result := False;

            If Not Result Then
            Begin
              fatVenda.cdsChequePre.EmptyDataSet;
              fatVenda.cdsChequeVis.EmptyDataSet;
              SetLength(arrCartoes,0);
              Break;
            End;

          End;

        End;

      End;

      Break;

    End
    Else
      Break;

  End;

  Result := fValidaPixGeradoAnteriormenteNaoRecebido(Result) ;

  fatVenda.blnMostrouDigDuplic := FVariaveisFechamentoVenda.blnMostraDigDuplic;

  {*******************************************}
  {* RESTAURA A DIGDUPLIC                    *}
  {****************************************MV*}
  If (FVariaveisFechamentoVenda.blnMostraDigDuplic) Then
  Begin
    For intContador := 0 To 23 Do
    Begin
      fatVenda.arrDuplicata[intContador] := arrDuplicCop[intContador];
    End;
  End;

  If (Not fEmptyStr(FVariaveisFechamentoVenda.strCndAtu)) Then
    fatVenda.strConPag := FVariaveisFechamentoVenda.strCndAtu;

end;

function TfrmFatVendas.fCarregarBrindesPromocaoCompostaPorKit: Boolean;
  var
    LstlKitsAtivos   : TStringList;
    LstlKitsInativos : TStringList;
Begin
  Result := True;
  Try
    LstlKitsAtivos   := TStringList.Create;
    LstlKitsInativos := TStringList.Create;
    Try
      CdsVenda.DisableControls;

      TProQtdColetiva.cdsDadosPromocaoKit := Nil;
      fatVenda.pCarregarDadosParaPromocaoPorKit;
      if (Assigned(fatVenda.cdsDadosPromocaoKit) and (fatVenda.cdsDadosPromocaoKit.RecordCount > 0))  then
        TProQtdColetiva.cdsDadosPromocaoKit := fatVenda.cdsDadosPromocaoKit;

      cdsVenda.First;
      While Not cdsVenda.Eof Do
      Begin
        if not fEmptystr(cdsVenda.FieldByName('ITE_PROKIT').AsString) Then
        Begin
          if (TProQtdColetiva.fVerificarKitAtivo(cdsVenda.FieldByName('ITE_PROKIT').AsString)) Then
          Begin
            If LstlKitsAtivos.IndexOf(cdsVenda.FieldByName('ITE_PROKIT').AsString) = -1 Then
              LstlKitsAtivos.Add(cdsVenda.FieldByName('ITE_PROKIT').AsString);
          End
          Else
          begin
            If LstlKitsInativos.IndexOf(cdsVenda.FieldByName('ITE_PROKIT').AsString) = -1 Then
              LstlKitsInativos.Add(cdsVenda.FieldByName('ITE_PROKIT').AsString);
          end;
        End;
        cdsVenda.Next;
      End;

      if LstlKitsAtivos.Count > 0 then
        fRevisarBrindesPromocaoCompostaPorKit(LstlKitsAtivos, True);

      if LstlKitsInativos.Count > 0 then
        fRevisarBrindesPromocaoCompostaPorKit(LstlKitsInativos, False);

      CdsVenda.EnableControls;
    Finally
      FreeAndNil(LstlKitsAtivos);
      FreeAndNil(LstlKitsInativos);
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fCarregarBrindesPromocaoCompostaPorKit]');
    End;
  End;
end;

function TfrmFatVendas.fCarregarEstruturaVidro(strCodIte: String; intID: Integer; blnLimparDig: Boolean = True): Boolean;
begin
  Result := False;
  If blnUtilizaVendaVidro And Assigned(fatVenda) And Assigned(fatVenda.objEstruturaVidros) Then
  Begin
    Result := fEhItemVendaVidro(strCodIte);

    If blnLimparDig Then
      fatVenda.objEstruturaVidros.pCancelarDigitacao;

    If Result Then
      fatVenda.objEstruturaVidros.pCarregarEstrutura(intID);
  End;
end;

function TfrmFatVendas.fCarregarValoresParaConfirmacaoDocumentos(): Boolean;
Var
  intContador: Integer;
begin
  Result := True;

  If (Pos(strOpcDoc, 'CF_CI_CN_') > 0) Then
  Begin
    fatVenda.fltDesEsp := 0.0;
    fatVenda.fltDupRec := 0.0;
    fatVenda.fltValAdt := 0.0;
    fatVenda.fltBolAdt := 0.0;

    With fatVenda.qryTemporariaConfirmacao Do
    Begin

      First;

      For intContador := 0 To Length(fatVenda.arrMatItens)-1 Do
      Begin
        If LeftStr(fatVenda.arrMatItens[intContador].strClaFis, 1) < '5' Then
        Begin
          fatVenda.fltDesEsp := fatVenda.fltDesEsp + fatVenda.arrMatItens[intContador].fltTotIte;
          fatVenda.fltDesSai := fatVenda.fltDesSai + fatVenda.arrMatItens[intContador].fltTotIte;
        End;
      End;

      While (Not Eof) Do
      Begin

        {**********************************************}
        {*         SOMA DUPLICATAS RECEBIDAS          *}
        {* QUANDO O DOC. FOI SINTETIZADO, NAO SOMA    *}
        {* A DUPREC PQ A DEVOL. NAO ESTARA MAIS       *}
        {* PRESENTE NA OPERACAO. A FF ESTA PRESENTE   *}
        {* POIS E NECESSARIO FATURALA, E ELA CARREGA  *}
        {* CONSIGO TODAS AS DEVOL. SINTETIZADAS.      *}
        {****************************************MV,JB*}
        If Not SameText(FieldByName('SAV_SINTET').AsString, 'S') and
           Not ((strOpcDoc = 'CF') And (fatVenda.blnMeiaNota)) Then
          fatVenda.fltDupRec := fatVenda.fltDupRec + FieldByName('TMP_DUPREC').AsFloat -
                                FieldByName('TMP_JURSUJ').AsFloat + FieldByName('TMP_DESSUJ').AsFloat;

        {***********************************************************************************}
        {* O DESCONTO DAS DEVOLUÇÕES SERÁ SOMADO ATRAVÉS DA VÁRIAVEL: "fatVenda.fltDesSai" *}
        {********************************************************************************RN*}
        If (StrToInt(LeftStr(FieldByName('TMP_CLAFIS').AsString, 1)) < 5) And
           (Not ((Pos(strOpcDoc, 'CF_') > 0) And (FieldByName('SAV_SINTET').AsString = 'N') And (FieldByName('TMP_ESPDOC').AsString = 'TR'))) Then
        Begin
          Next;
          Continue;
        End;

        {*****************************************}
        {* SOMA DESCONTO ESPECIAL                *}
        {**************************************MV*}
        If Not ((strOpcDoc = 'CF') And (fatVenda.blnMeiaNota)) Then
          fatVenda.fltDesEsp := fatVenda.fltDesEsp + FieldByName('TMP_DESESP').AsFloat;

        Next;
      End;

    End;

    fatVenda.fltDesEsp := fatVenda.fltDesEsp + fatVenda.fltDesSai;

    {***************************************************************************}
    {* QUANDO FOR CONFIRMACAO DE NOTA DE CONCRETO DA SECOL, DEVE VERIFICAR SE  *}
    {* O PEDIDO DE VENDA POSSUI CONTAS A RECEBER QUITADO                       *}
    {************************************************************************JC*}
    If (strOpcDoc = 'CN') And (fCfgSis('TPNFCR') = SECOL) And
       (Not fEmptyStr(fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_NUM_PD').AsString)) Then
    Begin
      fatVenda.fltDupRec := fatVenda.fltDupRec +
                            fatVenda.fTotalDuplicataQuitada(fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_NUM_PD').AsString,
                                                            fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_ESP_PD').AsString,
                                                            fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_EMP_PD').AsString);

      fatVenda.fltValAdt := fatVenda.fltValAdt +
                            TAdiantamento.fGetTotaisAdiantamento(fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_NUM_PD').AsString,
                                                                 fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_ESP_PD').AsString,
                                                                 fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_EMP_PD').AsString).fltValLan;
    End;

  End;

  FVariaveisFechamentoVenda.fltDesMinConf := 0;
  fatVenda.fltDesEspDifeF4 := 0;

  If strOpcDoc = 'CF' Then
  Begin
    If (fFormataFloat(fatVenda.fltDesEspConfF4,2) > 0) Then 
    Begin
      If (fFormataFloat(fatVenda.fltDesEspConfF4,2) > 0) >= (fFormataFloat(fatVenda.fltDesEsp,2) > 0) Then 
      Begin
        fatVenda.fltDesEspDifeF4 := fFormataFloat(fatVenda.fltDesEspConfF4 - fatVenda.fltDesEsp, 2);
        fatVenda.fltDesEsp := 0;
      End
      Else
      Begin
        fatVenda.fltDesEsp := fFormataFloat(fatVenda.fltDesEsp - fatVenda.fltDesEspConfF4, 2);
      End
    End;
    
     FVariaveisFechamentoVenda.fltDesMinConf := fatVenda.fltDesEsp;
  End;  
    
end;

function TfrmFatVendas.fCfgUtilizarOrdemProducao(strOpcDoc: String): Boolean;
begin
  Result := false;

  If (Pos(strOpcDoc,'OR_') > 0) And (fCfgSis('ORD_OR') = 'S') then
    Result := true
  else
  If (Pos(strOpcDoc,'PD_') > 0) And (fCfgSis('ORD_PD') = 'S') then
      Result := true;
end;

function TfrmFatVendas.fCliLoj: Boolean;
begin
  Result := fCfgSis('CLILOJ', varBoolean) And (Pos(strOpcDoc, 'OR_PD_VN_') > 0);
end;

function TfrmFatVendas.fRecalculaPrecoDinamico(strCodCliAnt, strCodCliAtu: String): Boolean;
  Var
    strTipAbfAnt : String;
    strTipAbfAtu : String;
begin
  Result := False;

  If (fCfgSis('CLPVDI', varBoolean)) Then
  Begin
    If (fEmptyStr(strCodCliAnt)) Or (fEmptyStr(strCodCliAtu)) Then
      Result := True
    Else
    Begin
      strTipAbfAnt := fGetTipoAbfCliente(strCodCliAnt,'','',IIF(strCodCliAnt = fRetornaClienteFilial(VS_strCodEmp), fatVenda.strEmp_TE, ''));
      strTipAbfAtu := fGetTipoAbfCliente(strCodCliAtu,'','',IIF(strCodCliAtu = fRetornaClienteFilial(VS_strCodEmp), fatVenda.strEmp_TE, ''));

      Result := (strTipAbfAnt <> strTipAbfAtu);

      If (Not Result) Then
        Result := (fRetEstadoCliente(strCodCliAnt)) <> (fRetEstadoCliente(strCodCliAtu));
    End;
  End;
end;

function TfrmFatVendas.fRecalculaPrecoLoteAoAlterarDestino: Boolean;
begin
  Result := True;

  If (Not Assigned(fatVenda)) Then
    Exit(False);

  If (fStrToFloat(edtQtdIte.Text) <= 0) Then
    Exit(False);

  If (Not pnlItemLote.Visible) Then
    Exit(False);

  If (fEmptyStr(edtNumLot.Text)) Then
    Exit(False);

  If ('A DEFINIR'.Equals(edtNumLot.Text)) Then
    Exit(False);

  If ('GARANTIA'.Equals(edtNumLot.Text)) Then
    Exit(False);
end;

function TfrmFatVendas.fDigitarEstruturaVidro: Boolean;
begin
  fatVenda.objEstruturaVidros.strTabelaPreco := fTabelaPrecoItem;
  fatVenda.objEstruturaVidros.strEntregaFutura := fEntregaFuturaItem;
  fatVenda.objEstruturaVidros.strEmpresaItem := fRetEmpresaItem;

  Result := fatVenda.objEstruturaVidros.fDigitarEstrutura;

  If Result Then
    fAtualizaPrecosEstruturaVidro(fatVenda.objEstruturaVidros.strTabelaPreco,
      fatVenda.objEstruturaVidros.strEntregaFutura, fRetEmpresaItem);
end;

function TfrmFatVendas.fDigitarServicoInicioVenda: Boolean;
begin
  Result := fCfgSis('BTDISE',varBoolean) And fUsaServico And (Pos(strOpcDoc, 'PD_OR_VN_') > 0);
end;

function TfrmFatVendas.fDigitarServicosFechamentoVenda(): Boolean;
begin
  Result := True;
  If //(fatVenda.blnMulLoj) Or  //Comentado pelo REQ.:203718
     (fEmptyStr(strNumOrc) And fEmptyStr(fatVenda.strCodS01)) Or
     ((fCfgSis('USACCR', varBoolean)) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL])) Then
  Begin
    FillChar(fatVenda.FRecSer, SizeOf(fatVenda.FRecSer), #0);
  End;

  If (Not ((fCfgSis('USACCR', varBoolean)) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]))) And
     (Not PixJaRecebido) Then
  Begin
    If Not fDigitarServicoInicioVenda Then
    begin
      If Not fDigServico(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc) Then
      Begin
        Result := False;
        pAtualizaTemporaria;
        Exit;
      End;
    end
    else
    begin
      If (not fatVenda.FRecSer.fTemCobranca) Then
      Begin
        pDeletaItemServico;
        fatVenda.pDeletaItemServicoMatriz;
        fatVenda.blnDocumentoTemServicos := False;
      End;
    end;
  End;

  {******************************************************}
  {* TRAVA PARA NAO GRAVAR PD/OR/VN SEM ITENS DE SERVICO *}
  {58618***********************************************LE}
  If (fUsaServico) And (Pos(strOpcDoc,'VN_VS_PD_OR_') > 0 ) And
     (dbgItens.DataSource.DataSet.IsEmpty)  Then
  Begin
    fMensagem('ATENÇÃO!', 'É necessário informar pelo menos um produto ou um serviço.', ['&Ok']);
    Result := False;
  End;

  If (fUsaServico) And
     (Pos(strOpcDoc,'VN_VS_PD_OR_') > 0 ) And
     (btnServico.Visible)  And
     (dbgItens.DataSource.DataSet.RecordCount = 1) And
     (fEhItemServico(dbgItens.DataSource.DataSet.FieldByName('ITE_CODITE').AsString)) And
     (fatVenda.fltTotSer = 0) And
     (not fatVenda.fEmissaoPedidoBrinde()) Then
  Begin
    fMensagem('ATENÇÃO!', 'É necessário informar pelo menos um serviço com valor maior que 0,00. O serviço pode ser '+
                          'incluído através do botão [Alt+F5 Serviços]', ['&Ok']);
    Result := False;
  End;
end;

function TfrmFatVendas.fAtualizaPrecoEmNegociacao: Boolean;
begin
  Result := (blnTemNegocAtiva) And (Not fCfgSis('TRANEG', varBoolean)) And
            (TCadNegBussiness.fClienteTemNegociacaoVinculada(edtCodCli.Text)) And
            (Not TCadNegBussiness.fItemSemNenhumaNegociacao(edtCodIte.Text));
end;

function TfrmFatVendas.fAtualizaPrecosEstruturaVidro(strTabelaPreco, strEntregaFutura, strEmpresaItem: String; blnAtualizaEdits: Boolean = True; blnSalvar: Boolean = False): Double;
  Var
    fltDesMax: Double;
begin
  fatVenda.objEstruturaVidros.strTabelaPreco := strTabelaPreco;
  fatVenda.objEstruturaVidros.strEntregaFutura := strEntregaFutura;
  fatVenda.objEstruturaVidros.strEmpresaItem := strEmpresaItem;

  fatVenda.objEstruturaVidros.pRecalcularPrecos(fatVenda.fCalculaAliquota);

  With TSubItensVidroManager.fCalcularTotais(fatVenda.objEstruturaVidros.subItensEstrutura) Do
  Begin
    fatVenda.fltCusIte := fltPrecoCustoTotal;
    fatVenda.fltPreCus := fltPrecoCustoTotal;
    fatVenda.fltPreCu2 := fltPrecoCustoRealTotal;

    If fltPrecoVendaTotal <> 0 Then
    Begin
      fatVenda.fltIcmSai := fltIcmsSaidaTotal / fltPrecoVendaTotal * 100;
      fatVenda.fltImpFed := fltImpostosFederaisTotal / fltPrecoVendaTotal * 100;
      fatVenda.fltDesOpe := fltDespesasOperacionaisTotal / fltPrecoVendaTotal * 100;
    End
    Else
    Begin
      fatVenda.fltIcmSai := 0;
      fatVenda.fltImpFed := 0;
      fatVenda.fltDesOpe := 0;
    End;

    fatVenda.fltOutVal := fltOutrosValoresTotal;
    fatVenda.fltPreMed := fltPrecoMedioTotal;
    fatVenda.fltImpUlt := fltPrecoUltimaCompraTotal;
    fatVenda.fltPreUlt := fltPrecoUltimaComImpostosTotal;

    fatVenda.fltPreVe1 := fltPrecoVenda1Total;
    fatVenda.fltPreVe2 := fltPrecoVenda2Total;
    fatVenda.fltPreVe3 := fltPrecoVenda3Total;
    fatVenda.fltPreVe4 := fltPrecoVenda4Total;
    fatVenda.fltPreVe5 := fltPrecoVenda5Total;
    fatVenda.fltPreVe6 := fltPrecoVenda6Total;
    fatVenda.fltPreVe7 := fltPrecoVenda7Total;

    fatVenda.fltUniVis := fltPrecoVendaTotal;
    fatVenda.fltUniOri := fatVenda.fltUniVis;
    fatVenda.fltTaxJur := 0.00;

    If (fCfgSis('CNDVEN') = 'I') And (fatVenda.fGetTaxVprItem(fCfgSis('ITEVID'), strEmpresaItem) > 0) Then
    Begin
      If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
      Begin
        fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(fCfgSis('ITEVID'), strEmpresaItem);
        fatVenda.fltUniOri := fatVenda.fltUniOri + fFormataFloat(fatVenda.fltUniOri * (fatVenda.fGetTaxVprItem(fCfgSis('ITEVID'), strEmpresaItem) / 100.0), 04);
      End;
    End;

    fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);

    Result := fatVenda.fltUniOri;//Unitario original = preco a vista (tabela) + juros + RT

    If (fatVenda.strCAbDes = 'S') And (fCfgSis('CNDVEN') = 'I') And (Not fAplicarTaxaJurosPrecoDigitado) Then
    Begin
      fltDesMax := fatVenda.fRetornaDescLinGru(fCfgSis('ITEVID'), fatVenda.strCodCnd);

      If (fatVenda.strCodFpg = '007') Then
      Begin
        If (fatVenda.strAbDeCc = 'S') Then
          Result := Result - fatVenda.fRetornaVrDesconto(2, Result, fltDesMax);
      End
      Else
        Result := Result - fatVenda.fRetornaVrDesconto(2, Result, fltDesMax);

      Result := fFormataFloat(Result, fatVenda.VS_intDecUni);
    End;

    If blnAtualizaEdits Then
      edtUnitar.Text := FormatFloat(edtUnitar.EditFormat, Result);
  End;

  If blnSalvar Then
    fatVenda.objEstruturaVidros.pSalvarEstrutura;

  pAtualizaUnitarioLiquido;
end;

function TfrmFatVendas.fBuscaPrecoTabelaRemessa(strCodIte: string; fltValorDefault: Double): Double;
var
  qryPrecoRemessa: TUniQuery;
begin
  try
    Result := fltValorDefault;

    qryPrecoRemessa := fCriaQuery();
    qryPrecoRemessa.Close;
    qryPrecoRemessa.SQL.Clear;
    qryPrecoRemessa.SQL.Add('SELECT ITE_PRECUS, ITE_PREMED, ITE_PREULT, ITE_IMPULT, ITE_PREVE1, ITE_PREVE2,');
    qryPrecoRemessa.SQL.Add('       ITE_PREVE3, ITE_PREVE4, ITE_PREVE5, ITE_PREVE6, ITE_PREVE7');
    qryPrecoRemessa.SQL.Add('FROM ITEGER ');
    qryPrecoRemessa.SQL.Add('WHERE ITE_CODITE = :CODITE AND ITE_CODEMP = :CODEMP');
    qryPrecoRemessa.ParamByName('CODITE').AsString := strCodIte;
    qryPrecoRemessa.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryPrecoRemessa.Open;

    case StrToIntDef(fCfgSis('PREREM'),-1) of
      0: Result := qryPrecoRemessa.FieldByName('ITE_PRECUS').AsFloat;
      1: Result := qryPrecoRemessa.FieldByName('ITE_PREMED').AsFloat;
      2: Result := qryPrecoRemessa.FieldByName('ITE_PREULT').AsFloat;
      3: Result := qryPrecoRemessa.FieldByName('ITE_IMPULT').AsFloat;
      4: Result := qryPrecoRemessa.FieldByName('ITE_PREVE1').AsFloat;
      5: Result := qryPrecoRemessa.FieldByName('ITE_PREVE2').AsFloat;
      6: Result := qryPrecoRemessa.FieldByName('ITE_PREVE3').AsFloat;
      7: Result := qryPrecoRemessa.FieldByName('ITE_PREVE4').AsFloat;
      8: Result := qryPrecoRemessa.FieldByName('ITE_PREVE5').AsFloat;
      9: Result := qryPrecoRemessa.FieldByName('ITE_PREVE6').AsFloat;
      10: Result := qryPrecoRemessa.FieldByName('ITE_PREVE7').AsFloat;
    end;
  finally
    FreeAndNil(qryPrecoRemessa);
  end;
end;

function TfrmFatVendas.fBuscaTipoFrete(strNumDoc, strEspDoc,
  strCodEmp, strAiDvOr: string): integer;
var
  qryTipoFrete: TUniQuery;
begin
  Result := 0;
  qryTipoFrete := fCriaQuery;

  try
    qryTipoFrete.Close;
    qryTipoFrete.SQL.Clear;
    qryTipoFrete.SQL.Add('SELECT G.GER_TIPFRE');
    qryTipoFrete.SQL.Add('FROM MOVGER G');
    qryTipoFrete.SQL.Add('INNER JOIN MOVDET D ON D.DET_SEQGER = G.AUTOINCREM');

    qryTipoFrete.SQL.Add('WHERE G.GER_NUMDOC = :NUMDOC');
    qryTipoFrete.SQL.Add('AND G.GER_ESPDOC = :ESPDOC');
    qryTipoFrete.SQL.Add('AND G.GER_CODEMP = :CODEMP');
    qryTipoFrete.SQL.Add('AND D.AUTOINCREM = :AUTOIN');


    qryTipoFrete.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTipoFrete.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTipoFrete.ParamByName('CODEMP').AsString := strCodEmp;
    qryTipoFrete.ParamByName('AUTOIN').AsString := strAiDvOr;

    qryTipoFrete.Open;

    if not qryTipoFrete.IsEmpty then
      Result := StrToIntDef(qryTipoFrete.FieldByName('GER_TIPFRE').AsString, 0);
  finally
    FreeAndNil(qryTipoFrete);
  end;
end;

