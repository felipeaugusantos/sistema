procedure TfrmFatVendas.pCarregaItensBrinde;
  Var strSQL: String;
      qryGen: TUniQuery;
Begin
  qryGen := fCriaQuery(Self);
  cpvIteBrindes.DataSet := qryGen;
  cdsIteBrindes.Close;
  cdsIteBrindes.SetProvider(cpvIteBrindes);

  strSQL := '';
  strSQL := strSQL + 'SELECT SQL_NO_CACHE           ';
  strSQL := strSQL + '   DET_CODITE      AS CODITE, ';
  strSQL := strSQL + '   SUM(DET_QTDITE) AS QTDITE  ';
  strSQL := strSQL + ' FROM         ';
  strSQL := strSQL + '   MOVDET,   ';
  strSQL := strSQL + '   MOVGER G, ';
  strSQL := strSQL + '   CADITE     ';
  strSQL := strSQL + ' WHERE        ';
  strSQL := strSQL + '   DET_CODITE  = ITE_CODITE   AND ';
  strSQL := strSQL + '   DET_SEQGER  = G.AUTOINCREM AND ';
  strSQL := strSQL + '   GER_CGCCON  = :CGCCPF      AND ';
  strSQL := strSQL + '   DET_CODEMP  = :CODEMP      AND ';
  strSQL := strSQL + '   DET_DTAENT >= :DTPROB      AND ';
  strSQL := strSQL + '   DET_TIP_FC  = "C"          AND ';
  strSQL := strSQL + '   (DET_ESPDOC  = "BR" OR LOCATE(DET_CLAFIS,' + CLAFIS_BR + ')) ';
  strSQL := strSQL + ' GROUP BY     ';
  strSQL := strSQL + '   DET_CODITE ';

  qryGen.Close;
  qryGen.SQL.Clear;
  qryGen.SQL.Add(strSQL);
  qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryGen.ParamByName('CGCCPF').AsString := fatVenda.strCliCgc;
  qryGen.ParamByName('DTPROB').AsString := fCfgSis('DTPROB');
  qryGen.Open;

  pSetaClient(qryGen);

  cdsIteBrindes.Open;

  FreeAndNil(qryGen);
End;

procedure TfrmFatVendas.cbxPreTesChange(Sender: TObject);
begin
  inherited;

  If cbxPreTes.Visible And Not fEmptyStr(cbxPreTes.Text) Then
  Begin
    If CharInSet(RightStr(cbxPreTes.Text,1)[1], ['1'..'9']) Then
      fatVenda.strPreETe := 'VE' + RightStr(cbxPreTes.Text,1)

    Else If cbxPreTes.Text = 'Últ. Compra' Then
      fatVenda.strPreETe := 'ULT'

    Else If cbxPreTes.Text = 'Últ. Compra + Impostos' Then
      fatVenda.strPreETe := 'IMP'

    Else If cbxPreTes.Text = 'Médio' Then
      fatVenda.strPreETe := 'MED'

    Else If cbxPreTes.Text = 'Médio sem ICMS' Then
      fatVenda.strPreETe := 'SIC'

    Else
      fatVenda.strPreETe := 'CUS';
  End;

end;

