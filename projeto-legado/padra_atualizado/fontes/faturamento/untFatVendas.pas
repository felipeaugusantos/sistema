function TfrmFatVendas.fConfirma(pgbStatus: TcxProgressBar = nil): Boolean;
  Var
    blnConfirma : Boolean;
    arrLogLibAnt: TArrLogLib;
    frmFatDadosNotaComp : TfrmFatDadosNotaComp;
    blnLimparLiberacaoEstoque: Boolean;
    frmRcxDigCartoes : TfrmRcxDigCartoes;
begin
  Result := False;
  Try
    pProgresso (0, 0, pgbStatus);
    pInformacao(MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA, pgbStatus);

    arrLogLibAnt := arrLogLib;
    SetLength(arrLogAviAux, 0);

    fatVenda.strCliCgc := AnsiReplaceStr(fatVenda.strCliCgc,'.','');
    fatVenda.strCliCgc := AnsiReplaceStr(fatVenda.strCliCgc,'-','');
    fatVenda.strCliCgc := AnsiReplaceStr(fatVenda.strCliCgc,'/','');

    pZeraDigDuplic(fatVenda.arrDuplicata);

    If (strOpcDoc <> 'CP') Then
      fatVenda.strOprFlj := edtOprFlj.Text;

    Case cbbComInd.ItemIndex Of
      IDX_COMERCIALIZACAO  : fatVenda.strIndCom := 'C';
      IDX_INDUSTRIALIZACAO : fatVenda.strIndCom := 'I';
    End;

    If cbbUsoConsRev.Visible then
      Case cbbUsoConsRev.ItemIndex Of
        IDX_USO_CONSUMO  : fatVenda.strCliCon := 'S';
        IDX_REVENDA,
        IDX_PRODUCAO     : fatVenda.strCliCon := 'N';
      End;

    {************************************************************}
    {* VERIFICA SE EXISTE ITENS COM OBRIGATORIEDADE DE CPF/CNPJ *}
    {* VERIFICA CPF\CGC VALIDO                                  *}
    {*********************************************************JB*}
    If (strOpcDoc <> 'VN') And (Not fatVenda.fVerificaItemObrigCpfCnpj) Then
    Begin
      If (Pos(strOpcDoc,'OR_PD_') <= 0) And (fatVenda.fTrocaUFEndEntrega <> 'EX') Then
        Exit;

      If (Not fInformaCPFCNPJItensComObrigatoriedade(strOpcDoc)) Then
        Exit;
    End;

    If (Not fatVenda.fVerificaItemObrigCodIbama) Then
    Begin
      If (Pos(strOpcDoc,'OR_PD_') <= 0) Then
        Exit;
    End;

    If (fatVenda.blnEmpFat) And (fatVenda.strOpcDoc = 'VN') And
       (Not fatVenda.fVerificaEstoqueItens(fatVenda.strOpcDoc)) Then
    Begin
      Exit;
    End;

    blnConfirma := True;
    blnVendaConfirm := False;

    {*****************************************}
    {* CASO ESTEJA DESABILITADO, SAI         *}
    {**************************************MV*}
    If (Not btnConfirma.Enabled) Or (Not btnConfirma.Visible) Then
    Begin
      Exit;
    End;

    If (fCfgSis('USASER', varBoolean)) Or (fCfgSis('CONEQU', varBoolean)) Then
    Begin
      pAdicionaItemServico;
    End;

    if not fatVenda.fRecebidoPorPix then
    begin
      If Not fEmptyStr(edtForPag.Text) Then
      Begin
        If (fCfgSis('CNDVEN') = 'I') Or fEmptyStr(fatVenda.strCodFpg) Then
          fatVenda.strCodFpg := edtForPag.Text;
      End;
    end;

    {******************************************************}
    {* FORÇA A TRAVA "SENPEM" NA CONFIRMAÇÃO DO DOCUMENTO *}
    {******************************************************}
    If (fatVenda.fClienteFilialVenda(edtCodCli.Text)) Then
    Begin
      If (fRetornaClienteFilial(VS_strCodEmp) = edtCodCli.Text) And (blnLib_TE) Then
      Begin
        blnLib_TE := False;
        blnLibMsg := False;
      End;
    End;

    fatVenda.fltFat_TE := fatVenda.recDadCli.fltFat_TE;
    fatVenda.fltFatTE2 := fatVenda.recDadCli.fltFatTE2;
    fatVenda.strTEPREV := fatVenda.recDadCli.strTEPREV;
    fatVenda.strTEPPRO := fatVenda.recDadCli.strTEPPRO;

    btnCancelaItem.Click;

    If fVerificaCamposInterna Then
    Begin
      pMostraStatusPedBloqueado;

      If Not fVerificarDebitosEmAtrasoCliente() Then
        Exit;

      {*****************************************}
      {* CASO FOR NOTA DE COMPLEMENTO          *}
      {**************************************MV*}
      If strOpcDoc = 'NC' Then
      Begin
        pCriarFormularios(TfrmFatDadosNotaComp, frmFatDadosNotaComp);
        Try
          Try
            frmFatDadosNotaComp.fatVenda := fatVenda;
            frmFatDadosNotaComp.blnSatComplementar  := blnSatComplementar;
            frmFatDadosNotaComp.blnNFCeComplementar := blnNFCeComplementar;
            frmFatDadosNotaComp.ShowModal;
            blnConfirma := frmFatDadosNotaComp.blnConfirma;
          Except
            On E: Exception Do
            Begin
              blnConfirma := False;
              pMensagensErro(E.Message, '[pConfirma]');
            End;
          End;
        Finally
          pFreeAndNil(frmFatDadosNotaComp);
        End;
      End;

      If fEhAbastecimentoPorDepositoComTintaDeMaquinaComProducaoForaDaLoja Then
      Begin
        fatVenda.strOprFlj := 'S';
      End;

      pHabilitaCamposItem(False);
      dbgItens.Enabled    := False;

      Try
        Try
          If (Pos(strOpcDoc, 'PD_OR') > 0) And fatVenda.blnNovoFechamentoOrcamentoPedido Then
            blnConfirma := blnConfirma And fConfirmaNovoFechamentoOrcamentoPedido
          Else If (strOpcDoc = 'VN') And fatVenda.blnNovoFechamentoVenda Then
            blnConfirma := blnConfirma And fConfirmaNovoFechamentoVenda
          Else
            blnConfirma := blnConfirma And fConfirmaVenda(pgbStatus);
        Except
          blnConfirma := False;
          Raise;
        End;

        If blnConfirma Then
        Begin
          If (Pos(strOpcDoc, 'TE_OF_') > 0) And (Not fEmptyStr(strNumRemessa)) Then
            Self.blnConfirma := blnConfirma;

          Result := True;
          fatVenda.blnConfTransFF := False;
          blnVendaConfirm := True;

          If (fatVenda.strEspDoc = 'PD') and
             (fCfgSis('YAPHAB',varBoolean)) and
             (TYapayFacade.fCondicaoPagamentoGeraCobranca(fatVenda.strCodCnd)) then
          begin
            if not fEnviarCobrancaYapay then
            begin
              fatVenda.blnGravouDocumentos := False;
              Result := False;
              Exit;
            end;
          end;

          fatVenda.pExibirMensagemDocumentoGravado;

          If (Not fEmptyStr(Self.strCodCliDef)) Then
            Self.strCodCliDef :=  fatVenda.strCodCli;
          If (Not fEmptyStr(Self.strProspe)) Then
            Self.strProspe := fatVenda.strProspe;

          Self.Close;
        End;
      Finally
        If Not blnConfirma Then
        Begin
          pProgresso (0, 0, pgbStatus);
          pInformacao('Aguarde, Cancelando Fechamento Venda...', pgbStatus);

          if Assigned(fatVenda.objTefRecebimento) then //'TEFVN_'
          Begin
            Try
              pCriarFormularios(TfrmRcxDigCartoes, frmRcxDigCartoes);
              frmRcxDigCartoes.pGarantirCancelamentoTefRecebimento(fatVenda.objTefRecebimento,
                                                                   fatVenda.strArquivoTef);
            Finally
              pFreeAndNil(frmRcxDigCartoes);
            End;
          End;

          blnLimparLiberacaoEstoque := IIF((fatVenda.blnSolicitouFecharOREmPD) And
                                           (fLogLibExists('LBSDVN', arrLogLib)) And (Not fLogLibExists('LBSDVN', arrLogLibAnt)), True, False);

          fatVenda.blnUsaDesEspExpCalc := fatVenda.blnUsaDesEspExpCalcIni;
          blnPassouPelaTelaDescontoEConfirmou := False;
          fatVenda.blnPassouPelaTelaDescontoEConfirmou := False;
          fatVenda.fltPorDesVer := 0.00;
          fatVenda.blnTaxVpr := False;
          fatVenda.blnDeCndF := False;
          fatVenda.strUltCndVenLib:= '';
          fatVenda.strUltCodVenLib:= '';
          fatVenda.blnAplicaTaxaEntrega := False;
          fatVenda.blnSolicitouFecharOREmPD := False;
          fatVenda.blnRestringirElementosMargem := True;

          If fRateiaFreteItensTransportadora(fatVenda.strCodTra, fatVenda.strTipFre) And (fatVenda.fltFreRat > 0) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
          Begin
            fatVenda.fltValFre := fatVenda.fltFreRat;
            fatVenda.fltFreDig := fatVenda.fltFreRat;
            fatVenda.fltFreRat := 0.00;
          End;

          If fatVenda.fAplicaFreteComoAcrescimoNFCe Then
          Begin
            fatVenda.fltValFre := fatVenda.fltValFreAntesAcrescimoNFCe;
            fatVenda.fltDesAce := fatVenda.fltDesAceAntesAcrescimoNFCe;
          End;

          If fCfgSis('CNDVEN') = 'F' Then
          Begin
            fatVenda.fltTaxJur := 0;
            fatVenda.fltTaxVpr := 0;
            pVoltaBkpArrMatItens;
            //limpa as variáveis referentes à condição de pagamento (Req. 202377)
            fatVenda.pAtualizaInformacoesCondPagamento(Nil, True);
          End;

          if blnRealizouCalculoPrioridade then
          begin
            cdsVenda.Data := cdsVendaBkp.Data;
            cdsVenda.EmptyDataSet;
            pCloneDataSet(cdsVenda, cdsVendaBkp);
            blnRealizouCalculoPrioridade := False;
          end;

          pAbortarEmissaoVenda();

          pProgresso (0, 0, pgbStatus);
          pInformacao('Aguarde, Cancelando Fechamento Venda...', pgbStatus);

          If (strOpcDoc = 'DD') Then
          Begin
            fatVenda.cdsDocDem.EmptyDataSet;
            cdsVenda.EmptyDataSet;
          End;

          If (strOpcDoc = 'NC') And (fatVenda.objNfeComplemento.tncTipoNota = tncRestIcmsStEstoque) Then
          Begin
            fatVenda.strMen001  := '';
            fatVenda.strMen002  := '';
            fatVenda.strMen003  := '';
            fatVenda.strMen004  := '';
            fatVenda.strMen005  := '';
            fatVenda.strMenNc01 := '';
            fatVenda.strMenNc02 := '';
            fatVenda.strMenNc03 := '';
            fatVenda.strMenNc04 := '';
            fatVenda.strMenNc05 := '';
            fatVenda.strMenNc06 := '';
            fatVenda.strMenNc07 := '';
            fatVenda.strMenNc08 := '';
            fatVenda.strMenNc09 := '';
            fatVenda.strMenNc10 := '';
          End;

          fatVenda.pAtualizaTemporariaItens(cdsVenda, fatVenda.fVerificaImpRateadoDescOrgaoPublico Or
                                                      fatVenda.fCarregaValorBrutoParaAplicarDescontoProfissional Or
                                                      ((strOpcDoc = 'CF') And (fatVenda.fltPorDes <> 0)),
                                                      blnLimparLiberacaoEstoque);

          fatVenda.blnAgrIte := False;
          fatVenda.fltPorDes := 0;
          fatVenda.fltDesEsp := 0;

          If (Not fEmptyStr(strNumOrc)) And
             (fatVenda.fltPorDesTmp > 0) Then
            fatVenda.fltPorDes := fatVenda.fltPorDesTmp;

          pCalculaTotais;

          pAtualizaTemporaria;

          If (Not edtCodCli.ReadOnly) And (edtCodCli.Enabled) Then
          Begin
            pSetFocus(edtCodCli);
          End
          Else If (fatVenda.blnMeiaNota) Or (Pos(strOpcDoc,'CF_CT_CI_CN_CP_OV_') > 0) Then
          Begin
            btnCancelaItem.Click;
            mskCndPag.Enabled := False;
          End;
        End;
      End;
    End;
  Except
    On E: ExceptionAutComSugerirVendaPresencial Do
    Begin
      Result := False;

      If (Not fatVenda.blnAvisouSugerirVendaPresencial) Then
      Begin
        fMensagem('Atenção!', E.Message, ['&Ok']);
        fatVenda.blnAvisouSugerirVendaPresencial := True;
        Abort;
      End;
    End;

    On E: Exception Do
    Begin
      pMensagensErro(E.Message,'[fConfirma]');
    End;
  End;
end;

procedure TfrmFatVendas.cmbTipEntChange(Sender: TObject);

  function fForcaRecalcPromEntFut():Boolean;
  begin
    Result := False;

    If (cdsVenda = Nil) Then
      Exit;

    If blnAtualizandoDados Then
      Exit;

    Result := True;

    If (cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') Then
      Exit;

    If (btnAdicionar.Tag > 0) Then
    Begin
      Result := (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E') And
                (cdsVenda.FieldByName('ITE_ENTFUT').AsString = 'S');
    End;
  end;

begin
  inherited;

  If cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA Then //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
  Begin
    cmbMotEntFut.Enabled := True;

    If (btnAdicionar.Tag <= 0) Or (blnAltEmpIte) Or (cmbMotEntFut.ItemIndex = -1) Then
      cmbMotEntFut.ItemIndex := fCfgSis('SUENFU', varInteger, fGetEmpConfigEntrega);

    cmbMotEntFutChange(Sender);

    cmbCliBus.Enabled := blnClienteBuscaEntrega;
  End
  Else
  Begin
    cmbMotEntFut.Enabled := False;
    cmbMotEntFut.ItemIndex := -1;

    If cmbEntRet.ItemIndex = IDX_RETIRA Then //Caso for Retira
    Begin
      mskDtaEnt.Enabled := False;
      mskDtaEnt.Text    := DateToStr( Trunc( fNow() ) );
      edtDiaEnt.Enabled := False;
      edtDiaEnt.Clear;
    End
    Else
    Begin
      mskDtaEnt.Enabled := True;
      edtDiaEnt.Enabled := True;

      If (fTrazerDataEntregaEmBranco(strOpcDoc)) Then
      Begin
        edtDiaEnt.Clear;
        mskDtaEnt.Text := '';
      End
      Else
      Begin
        edtDiaEnt.Text := fCfgSis('QMDPEI', varInteger, fGetEmpConfigEntrega);

        If fEmptyStr(edtDiaEnt.Text) Then
          edtDiaEnt.Text := '0';

        If (dtaEntImediata > 0) Then
        Begin
          If (Not fCfgSis('PDVIME', varBoolean)) Then
          Begin
            mskDtaEnt.Text := DateToStr(dtaEntImediata);
            edtDiaEnt.Text := FloatToStr(dtaEntImediata - Trunc(fNow()));
          End
          Else
          Begin
            edtDiaEnt.Text := fCfgSis('QMDPEI', varInteger, fGetEmpConfigEntrega);
            mskDtaEnt.Text := DateToStr(VS_DATE + StrToInt(edtDiaEnt.Text));
          End;
        End
        Else If Not (Assigned(fatVenda.objConEnt) And (Not fatVenda.fTemEntregaFutura('P'))) Then
          mskDtaEnt.Text := DateToStr(VS_DATE + StrToInt(edtDiaEnt.Text))
        Else
          mskDtaEnt.Text := DateToStr(fatVenda.objConEnt.fProximaDataDisponivel);

        pDefinirEntImedZero();
      End;
    End;

    cmbCliBus.Enabled := False;
    cmbCliBus.ItemIndex := 0;
  End;

  pCalculaPromocaoEntFut(fForcaRecalcPromEntFut());

  {Sugerir prazo do fornecedor na inclusão para itens de entrega imediata!}
  pSugerirPrazoFornecedor;
  pSugerirDataEntregaFuturaPrevisao();

end;

