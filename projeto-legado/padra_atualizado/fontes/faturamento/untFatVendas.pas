begin
  result := True ;
  If (fatVenda.VS_blnUsaFpg) And ((fatVenda.strCodFpg = '012')) Then
  Begin
    fatVenda.fltValOrd := FVariaveisFechamentoVenda.fltTotMod;
    If fatVenda.fltValOrd <> 0.00 then
