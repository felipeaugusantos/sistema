procedure TfrmFatVendas.pInformacoesClienteRodape;
  Var
    strMsg : String;
    blnNF_CPF,
    blnCF_CPF,
    blnIPI_CPF: Boolean;
begin
  strMsg    := '';
  blnNF_CPF := fCfgSis('CPFOBR', varBoolean);
  blnCF_CPF := fCfgSis('CF_CPF', varBoolean);

  blnIPI_CPF := False;
  If (fStrToFloat(edtSohIpi.Text) > 0) And (fatVenda.strCliEst <> 'EX') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    If (fEmptyStr(fatVenda.strCliCgc)) Or (fReplicatorStr(fatVenda.strCliCgc[1], Length(fatVenda.strCliCgc)) = fatVenda.strCliCgc) Then
    Begin
      blnIPI_CPF := True;
    End;
  End;

  If (Not fatvenda.fDocumentoParaFornecedor) or (blnIPI_CPF) Then
  Begin
    If (fClienteConsumidor(fatVenda.strCliOri, False, True)) Then
    Begin
      pnlInfo.Caption := '[F12] para alterar dados do consumidor.';

      If (blnIPI_CPF) and (not blnPermiteFinalizarOrcamentoIPISemDadosConsumidor) Then
      Begin
        pnlInfo.Font.Color := clRed;
        pnlInfo.Caption    := pnlInfo.Caption + ' ' + 'CLIENTE SEM CPF / CNPJ. É OBRIGATÓRIO DEVIDO AO IPI.';
      End
      Else
      Begin
        pnlInfo.Font.Color := clBlack;
      End;
    End
    Else
    Begin
      If (blnNF_CPF) Or (blnCF_CPF) or (blnIPI_CPF) Then
      Begin
        If (Not fatVenda.fPermiteNotaServicoSemCpf) or (blnIPI_CPF) Then
        Begin
          If (fEmptyStr(fatVenda.strCliCgc)) Then
            strMsg := 'CLIENTE SEM CPF / CNPJ. NÃO SERÁ PERMITIDA A EMISSÃO DE '
          Else If (fReplicatorStr(fatVenda.strCliCgc[1], Length(fatVenda.strCliCgc)) = fatVenda.strCliCgc)
              And (fatVenda.fTrocaUFEndEntrega <> 'EX')Then
            strMsg := 'O CPF / CNPJ DO CLIENTE NÃO É VÁLIDO PARA EMITIR ';

          If Not fEmptyStr(strMsg) Then
          Begin
            If blnNF_CPF Then
              strMsg := strMsg + 'NOTA FISCAL';

            If blnNF_CPF And blnCF_CPF Then
              strMsg := strMsg + ' OU ';

            If blnCF_CPF Then
              strMsg := strMsg + 'CUPOM FISCAL';

            pnlInfo.Caption := strMsg;

            if (blnIPI_CPF) then
            begin
              pnlInfo.Font.Color := clRed;
              pnlInfo.Caption    := pnlInfo.Caption + ' (C/ IPI)';
            end
            else
              pnlInfo.Font.Color := clBlack;
          End;
        End;
      End
    End;
  End;
end;

