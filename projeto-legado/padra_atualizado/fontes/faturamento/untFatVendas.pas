  End;

  intTmpIdxDes := cmbEntRet.ItemIndex;
  intTmpIdxEnt := cmbTipEnt.ItemIndex;
  intTmpIdxRet := cmbLocRet.ItemIndex;
  intTmpIdxMot := cmbMotEntFut.ItemIndex;
  intTmpIdxBus := cmbCliBus.ItemIndex;
  strTmpEntrad := mskDtaEnt.Text;
  intTmpIdxTur := cmbTurEnt.ItemIndex;

  pLimpaInformacoesItem;

  btnQtdPigmentos.Visible := false;


  blnValidaAcimaDaCapacidadeMax:= False;

  strDesNes := '';
  fatVenda.fltSaldoMatriz := 0.0;

  {Foca somente se a origem for o próprio "btnCancelaItem"}
  If Assigned(Sender) And (Sender Is TBitBtnLocked) Then
    If ((Sender As TBitBtnLocked).Name = btnCancelaItem.Name) Then
      If (edtCodIte.Enabled) And (pnlDadosItem.Enabled) Then
        pSetFocus(edtCodIte);

  {**********************************************}
  {* NECESSARIO PARA NAO ZERAR UNITÁRIO DO ITEM *}
  {*******************************************AC*}
  fatVenda.strIdePro := '';

  edtQtdIte.Visible     := True;
  lblQuantidade.Visible := True;
  btnNumSeries.Visible  := False;

  edtQtdIte.Enabled := True;

  // Ao cancelar, desabilita destino caso tenha itens. e habilita caso não tenha
  RecResult1Destino := fPermitirApenas1Destino;
  If RecResult1Destino.blnPermitirApenas1Destino Then
    pEnabledDestino(RecResult1Destino.intQtdItemEmp <= 0);

  blnAdicionando := False;
  blnIteAlt := False;
  blnProAca := False;

  pFechaVendeItem(Sender);

  {Req.: 97118. Bloqueia novamente campo de descrição.}
  edtDesIte.ReadOnly := True;
  edtDesIte.TabStop  := FALSE;
  edtUnidad.ReadOnly := True;
  edtUnidad.TabStop  := FALSE;

  {Req: 126003 - Após cancelar desbloqueia caixas}
  If (blnBloqueio_Abastecimento) Then
    pBloqueioAbastecimento(False);

  If (blnBloqueio_ItemCombo) Then
    pBloqueioItemCombo(False);

  strLoteMenorValidade := '';
