  fatVenda.strEspOrc := strEspOrc;
  fatVenda.strEmpOri := strEmpOrc;
  fatVenda.blnHerancaOrcamentoPedido := blnHerancaOrcamentoPedido;

  fatVenda.blnVendaRapidaAtivada := (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Pos('Venda Rápida', Self.Caption) > 0);

  If fatVenda.fEhVendaRapida(fatVenda.fRetClienteVendaRapida) And (blnPrimeiraVez) Then
  Begin
    edtCodCli.Text := fatVenda.fRetClienteVendaRapida;
    pCarregaCliente;
  End;

  If (fDeveCarregarPedidoOrcamento) Then
  Begin

    edtCodCli.Text     := qryFatGor.FieldByName('FGO_CODCLI').AsString;
    fatVenda.strCodCli := edtCodCli.Text;

    mskPlaVei.Text     := qryFatGor.FieldByName('FGO_PLAVEI').AsString;
    edtKM_Vei.Text     := qryFatGor.FieldByName('FGO_KM_VEI').AsString;

    {*******************************************************************}
    {* Precisa das informacoes do Cliente para Calcular o Valor do ST  *}
    {***************************************************************JC**}
