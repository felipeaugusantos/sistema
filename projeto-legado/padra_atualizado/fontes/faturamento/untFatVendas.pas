function TfrmFatVendas.fValidaSaldoLote: Boolean;
  Const
    SEPARADOR = '<<SEPARADOR>>';
  Var
    chrKey: Char;
    blnPedSen: Boolean;
    blnSenSal: Boolean;
    intIndex : Integer;
    stlLotes : TStringList;
    arrNumLot: TStringArray;
    fltSaldos: Double;
    strEmpSal: String;
    strLoteMenor: String;
    fltMenorSaldo: Double;
    blnLoteDigTemSaldo: Boolean;
    strArmazemPrincipal: String;
    fltSaldoDisponivelArmazemPrincipal: Double;
    intFocoBotao: Integer;
    fltSaldoTotal: Double;

  function fTemSaldo(strNumLot: String): Boolean;
  var
    strEmpPrd: String;
  begin
    strEmpPrd := '';

    {*********************************************************************************}
    {* INSERINDO A TINTA NOS ITENS, TEM QUE ESCOLHER A EMPRESA QUE PRODUZIRA A TINTA *}
    {******************************************************************************PH*}
    If (fatVenda.strIdePro <> 'NOR') Then
    Begin

      If (edtOprFlj.Text = 'N') And (chkEntCD.Checked) Then
      Begin
        If Assigned(recForTin.Formulas) Then
          recforTin.Formulas.fRecalculaSaldos(fatVenda.strEmp_CD, fStrToFloat(edtQtdIte.Text), fatVenda.strNumOrc, False, IIF(fInformaLoteBaseImobiliaria, edtNumLot.Text, ''));
      End
      Else
      Begin
        If fatVenda.blnEmpfat Then
          strEmpPrd := edtCodEmp.Text
        Else
        Begin
          If btnAdicionar.Tag = 0 Then
            strEmpPrd := fatVenda.fEscolheEmpresaProducaoTinta(fatVenda.strIdePro)
          Else
            strEmpPrd := '';
        End;

        If Not ((fEntregaFuturaItem = 'S') And (fTravaSaldoEntFutColorante = 'N') And (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR'))Then
        begin
          If Assigned(recForTin.Formulas) Then
            recforTin.Formulas.fRecalculaSaldos(strEmpPrd, fStrToFloat(edtQtdIte.Text), fatVenda.strNumOrc, False, IIF(fInformaLoteBaseImobiliaria, edtNumLot.Text, ''));
        end;
      End;

    End;

    Result := fVerificaQtdEstoque(fStrToFloat(edtQtdIte.Text), fltSaldos,
                                  blnPedSen, blnSenSal, False, False, strNumLot,
                                 (fAlterandoProduto) And SameText(edtNumLot.Text, strNumLot));//Alterando Item?
    If blnSenSal Then
      Result := False;
  end;

  function fMensagemTrocaLoteComMenorSaldo: Boolean;
  begin
    Result := False;

    If (Not fCfgSis('MSGLTE', varBoolean)) Then
      Exit;

    If (blnVendeTudoLote) Then
      Exit;

    If (Not blnLoteDigTemSaldo) Then
      Exit;

    If (strLoteMenor = edtNumLot.Text) Then
      Exit;

    If (Pos(strOpcDoc, 'OE_EF_OF_DV_') > 0) Then
      Exit;

    If (fCfgSis('CTLEST') = '2') Then
      Exit;

    If (fUsaSugestaoLoteMenorValidade) Then
      Exit;

    If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And (edtNumLot.Text = 'A DEFINIR') Then
      Exit;

    Result := True;
  end;

begin
  Result := True;

  fltSaldoTotal := 0;

  If (Pos(strOpcDoc, 'TE_OF_') > 0) And (Not fEmptyStr(strNumRemessa)) Then
  Begin
    Exit;
  End;

  If (pnlItemLote.Visible) And
     (fatVenda.strIdePro = 'NOR') And //Tinta de maquina deve validar o estoque no btnAdicionar
     (Not fEmptyStr(fCodItem)) And
     (Not fEmptyStr(edtNumLot.Text)) And
     (Not fatVenda.fEhEmissaoDocumentoWMS) And
     (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
     ((cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Or (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA)) Then //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
  Begin
    fltSaldos     := fltSaldoItemAtu;
    fltMenorSaldo := fltSaldoItemAtu;
    strLoteMenor  := edtNumLot.Text;

    blnLoteDigTemSaldo := IIF((Pos(strOpcDoc, 'OE_EF_') > 0),True,fTemSaldo(edtNumLot.Text));

    SetLength(arrNumLot, 0);

    strEmpSal := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

    fltSaldoDisponivelArmazemPrincipal := 0;

    If fCfgSis('CTLEST') = '2' Then //Configurado que usa Armazem
    Begin
      strArmazemPrincipal := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(fCodItem);
    End;

    stlLotes := TStringList.Create;
    Try
      If (fatVenda.strIdePro = 'NOR') Then
      begin
        stlLotes.Text :=
          AnsiReplaceStr(fCampoTabela( 'GROUP_CONCAT(LOT_NUMLOT SEPARATOR "' + SEPARADOR + '")',
                                       'CADLOT', ['LOT_CODITE', 'LOT_CODEMP', 'LOT_STATUS'], [fCodItem, strEmpSal, 'S']), SEPARADOR, #13#10);
      end
      else
      begin
        stlLotes.Text :=
          AnsiReplaceStr(fCampoTabela( 'GROUP_CONCAT(LOT_NUMLOT SEPARATOR "' + SEPARADOR + '")',
                                       'CADLOT', ['LOT_CODITE', 'LOT_CODEMP', 'LOT_PRITIN', 'LOT_STATUS'], [fCodItem, strEmpSal, 'S', 'S']), SEPARADOR, #13#10);
      end;

      For intIndex := 0 To stlLotes.Count -1 Do
      Begin

        If (not fUsaSugestaoLoteMenorValidade) and (stlLotes[intIndex] = edtNumLot.Text) Then
          Continue;

        If stlLotes[intIndex] = 'A DEFINIR' Then
          Continue;

        if (fUsaSugestaoLoteMenorValidade) and (stlLotes[intIndex] = 'GARANTIA') then
          Continue;

        fltSaldos := fatVenda.objCadLot.fSaldoLote(fCodItem, strEmpSal, stlLotes[intIndex]);

        If fUsaQtdPendenteEntregaFutura(True, strEmpSal) Then
          fltSaldos := fltSaldos +  TEntregaFutura.New(
                                      TParamEF.New()
                                        .CodIte(fCodItem)
                                        .CodEmp(strEmpSal)
                                        .Lote(stlLotes[intIndex])
                                        .Faturamento(True)
                                      ).Total();

        If fTemSaldo(stlLotes[intIndex]) Then
        Begin
          pAddDados(arrNumLot, stlLotes[intIndex]);

          If fltSaldos < fltMenorSaldo Then
          Begin
            fltMenorSaldo := fltSaldos;
            strLoteMenor  := stlLotes[intIndex];
          End;
        End;

        If (strArmazemPrincipal = stlLotes[intIndex]) Then
        Begin
          fltSaldoDisponivelArmazemPrincipal := fatVenda.fltSaldoDisponivelItem;
        End;

        fltSaldoTotal := fltSaldoTotal + fltSaldos;
      End;
    Finally
      FreeAndNil(stlLotes);
    End;

    if fUsaSugestaoLoteMenorValidade then
    begin
      if not blnLiberadoLoteDifLoteMenorValidade then
      begin
        strLoteMenorValidade := '';
        if Length(arrNumLot) > 0 then
          strLoteMenorValidade := fatVenda
                                   .objCadLot
                                     .fRetLoteMenorValidade(
                                       fCodItem,
                                       IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD),
                                       arrNumLot);

        if not fEmptyStr(strLoteMenorValidade) then
        begin
          edtNumLot.Text := strLoteMenorValidade;
          Result := fValidaCampos(edtNumLot, True);

          fltSaldos := fatVenda.objCadLot.fSaldoLote(fCodItem, strEmpSal, edtNumLot.Text);

          If fUsaQtdPendenteEntregaFutura(True, strEmpSal) Then
            fltSaldos := fltSaldos +  TEntregaFutura.New(
                                        TParamEF.New()
                                          .CodIte(fCodItem)
                                          .CodEmp(strEmpSal)
                                          .Lote(edtNumLot.Text)
                                          .Faturamento(True)
                                        ).Total();

          blnLoteDigTemSaldo := IIF((Pos(strOpcDoc, 'OE_EF_') > 0),True,fTemSaldo(edtNumLot.Text));
        end;
      end;
    end;

    If fUtilizouDefinicaoLoteSeparacaoSemWMS() Then
      blnLoteDigTemSaldo := (fltSaldoTotal >= fStrToFloat(edtQtdIte.Text));

    If (fCfgSis('CTLEST') = '2') And //Configurado que usa Armazem
       (SameText(edtNumLot.Text, strArmazemPrincipal)) And
       (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
    Begin
      //Nao deve verifiar se o armazem é o com menor saldo quando for o principal
    End

    Else If (fCfgSis('CTLEST') = '2') And //Configurado que usa Armazem
            (Not fUsaSugestaoLoteMenorValidade) And
            (Not SameText(edtNumLot.Text, strArmazemPrincipal)) And //Nao é o armazem principal
            (fltSaldoDisponivelArmazemPrincipal > 0) And
            (fCfgSis('ALTARM') = 'N') And //Armazem principal ainda tem saldo disponivel
            (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
    Begin
      fMensagem('', 'O armazém principal ainda possui saldo disponível, ' +
                    'portanto será necessário consumir todo este saldo ' +
                    'antes de utilizar outro armazém!' + #13#10 +
                    'Armazém Principal: ' + strArmazemPrincipal + #13#10 +
                    'Saldo Disponível.: ' + FormatFloat('#,##0.00',
                                          fltSaldoDisponivelArmazemPrincipal), ['&Ok']);
      Result := False;
    End

    Else If (Pos(strOpcDoc, 'DV_PR_') <= 0) Then
    Begin

      If (blnVendeTudoLote) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
      Begin

        If (fStrToFloat(edtQtdIte.Text) < fStrToFloat(edtSalDis.Text)) Then
        Begin
          pMensagemOk('É obrigatória a venda da quantidade total de produtos deste lote!');
          Result := False;
          Exit;
        End;

        If fLoteTotalJaInserido Then
        Begin
          pMensagemOk('Já foi inserido este produto com a quantidade total deste lote!');
          Result := False;
          Exit;
        End;

      End

      Else If (Not blnLoteDigTemSaldo) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
      Begin

        If Length(arrNumLot) > 0 Then
        Begin

          If (fMensagem('','O ' + fatVenda.objCadLot.strTitLab + ' informado para este produto não possui saldo ' +
                           'suficiente para esta quantidade. Deseja trocar o ' + fatVenda.objCadLot.strTitLab + ' do produto?', ['',''], 2) = 1) Then
          Begin
            chrKey       := '?';
            Result       := fPesquisaLote(edtNumLot, chrKey, arrNumLot) And fValidaCampos(edtNumLot, True);
            blnMudarFoco := False;
          End;

        End
        Else
        Begin
          pMensagemOk('Este produto não possui lotes que tenham saldo suficiente para esta quantidade!');
        End;

      End

      Else If fMensagemTrocaLoteComMenorSaldo Then
      Begin
        If fCfgSis('FCMGLT', varString) = 'S' Then
          intFocoBotao := 1
        Else
          intFocoBotao := 2;

        If (fMensagem('', 'Deseja trocar o ' + fatVenda.objCadLot.strTitLab + ' do produto ' +
                          'pelo ' + fatVenda.objCadLot.strTitLab + ' com menor saldo (' + strLoteMenor + ')?', ['&Sim','&Não'], intFocoBotao) = 1) Then
        Begin
          edtNumLot.Text := strLoteMenor;
          Result         := fValidaCampos(edtNumLot, True);
          blnMudarFoco   := False;
        End
        Else If (fCfgSis('SNMGLT', varBoolean)) Then
          pValidaDireitoAcessoIncLtIte(strLoteMenor);
      End;
    End;

  End;
end;

procedure TfrmFatVendas.pValidaDireitoAcessoIncLtIte(strCodLotSug: String);
var
  objLiberacao: TLiberacao;
begin
  if Pos(strOpcDoc, 'PD_OR_VN_') = 0 then
    Exit;

  if not fVerificaAcessoSistema('INCLTITE', strLoginUsuarioLogado) then
  begin
    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('Inclusão de item com lote diferente da sugestão com saldo menor');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTexto('Item: '+ fCodItem);
      objLiberacao.objMsgLibera.pAddTexto('Lote sugerido: '+ strCodLotSug);
      objLiberacao.objMsgLibera.pAddTexto('Lote incluído: '+ edtNumLot.Text);
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTexto('Solicitação de liberação para incluir lote');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.strDirAce  := 'INCLTITE';
      objLiberacao.strSenLib  := fCfgSis('SENLBD');
      objLiberacao.strMsgSen  := 'Inclusão de item com lote diferente da sugestão com saldo menor';
      objLiberacao.strCodOpe  := strLoginUsuarioLogado;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

      if not objLiberacao.fLibera then
      begin
        edtNumLot.Text := '';
        pSetFocus(edtNumLot);
        blnMudarFoco := False;
      end;

    finally
      FreeAndNil(objLiberacao);
    end;
  end;
end;

procedure TfrmFatVendas.pValidaItemComSerieInformada(
  var strItensSemSerie: String);
  var
    intRecNo: Integer;
    prcScroll: TprcScroll;

  function fTemSeriesDevidamenteInformadas():Boolean;
  var
    intQtdSer: Integer;
  begin
    Result := False;
    intQtdSer := 0;

    fatVenda.objFatSerieItem.cdsSeries.First;
    While (Not fatVenda.objFatSerieItem.cdsSeries.Eof) Do
    Begin
      intQtdSer := intQtdSer + fatVenda.objFatSerieItem.cdsSeries.FieldByName('QTDSER').AsInteger;
      fatVenda.objFatSerieItem.cdsSeries.Next;
    End;

    If (intQtdSer = Trunc(cdsVenda.FieldByName('ITE_QTDITE').AsFloat)) Then
      Result := True;
  end;
begin
  pDisableControls(cdsVenda, prcScroll);
  intRecNo := cdsVenda.RecNo;

  cdsVenda.First;
  While Not cdsVenda.Eof do
  Begin
    If (fProdutoUsaNumeroDeSerie(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString)) Then
    Begin

      fatVenda.objFatSerieItem.AutoincItem := IIF(fEmptyStr(cdsVenda.FieldByName('ITE_SEQDET').AsString), cdsVenda.FieldByName('AUTOINCREM').AsString, cdsVenda.FieldByName('ITE_SEQDET').AsString);
      fatVenda.objFatSerieItem.pFiltraDataSetSeries;
      If (Not fTemSeriesDevidamenteInformadas) Then
      Begin
        If (FEmptyStr(strItensSemSerie)) Then
          strItensSemSerie := cdsVenda.FieldByName('ITE_CODITE').AsString+'-'+cdsVenda.FieldByName('ITE_DESITE').AsString
        Else
          strItensSemSerie := strItensSemSerie + #13 + cdsVenda.FieldByName('ITE_CODITE').AsString+'-'+cdsVenda.FieldByName('ITE_DESITE').AsString;
      End;
    End;

   cdsVenda.Next;

  End;

  cdsVenda.RecNo := intRecNo;
  pEnableControls(cdsVenda, prcScroll);
end;

function TfrmFatVendas.fTemItemEstrutura:Boolean;
var
  cdsItens : TUniClientDataSet;
begin
  Result := False;

  cdsItens := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsItens, cdsVenda);

    cdsItens.First;
    While (Not cdsItens.Eof) Do
    Begin
      If (fEhOuCompoeEstrutura(cdsItens.FieldByName('ITE_CODITE').AsString, VS_strCodEmp).blnPrincipal) Then
        Exit(True);

      cdsItens.Next;
    End;
  Finally
    FreeAndNil(cdsItens);
  End;
end;

function TfrmFatVendas.fValidarEstruturaExterna(strCodCli: String; strNomCli: String; strCodEmp: String): Boolean;
  Var
    strCodigoExterno : String;
    strSiglaExterno : String;
    strValorCfg : String;
begin
  Result := True;

  strCodigoExterno := fCampoTabela('EEE_CODEEE', 'CADEEE', ['EEE_CODCLI'], [strCodCli], False);
  If fEmptyStr(strCodigoExterno) Then
    Exit();

  strSiglaExterno  := fCampoTabela('SIS_HUBMKP', 'FULL_CFGSIS', ['SIS_CODCFG', 'SIS_CODEMP', 'SIS_VALCFG'], ['CFG_CODEEE', strCodEmp, strCodigoExterno], False);
  strValorCfg      := fCampoTabela('SIS_VALCFG', 'FULL_CFGSIS', ['SIS_CODCFG', 'SIS_CODEMP', 'SIS_HUBMKP'], ['CFG_PERCPR', strCodEmp, strSiglaExterno], False);

  If (strValorCfg = 'N') And (fTemItemEstrutura) Then
  Begin
    pMensagemOk('Sistema está configurado para não permitir remessas e '+
                'vendas para o full com o código do item principal da '+
                'estrutura (CFG_PERCPR).'+sLineBreak+
                'Fale com o responsável pelo Fulfillment para resolver essa questão.'+sLineBreak+
                'Cliente do código externo: '+strCodigoExterno+' - '+strNomCli+sLineBreak+
                'Sigla do externo: '+strSiglaExterno);
    Result := False;
  End;
end;

procedure TfrmFatVendas.pHabilitarMetragem(strCodIte, strCodUni: String);
begin
  blnMetragemObrigatoria := (blnUtilizaVendaMadeira Or
                             blnUtilizaVendaVidro Or
                             blnUtilizaVendaMetroLinear) And fMetragemObrigatoria(strCodUni);

  blnPermiteAparelhamentoBeneficiamento :=
                            (blnUtilizaVendaMadeira Or
                             blnUtilizaVendaVidro Or
                             blnUtilizaVendaMetroLinear) And fPermiteAparelhamentoBeneficiamento(strCodUni);

  If fEhItemVendaVidro(strCodIte) Then
  Begin
    blnMetragemObrigatoria := False;
    blnPermiteAparelhamentoBeneficiamento := False;
  End;

  edtQtdPec.Enabled  := blnMetragemObrigatoria;
  edtComPec.Enabled  := blnMetragemObrigatoria;
  edtLarPec.Enabled  := blnMetragemObrigatoria;
  edtEspPec.Enabled  := blnMetragemObrigatoria;
  edtQtdIte.ReadOnly := blnMetragemObrigatoria;
  edtUntPec.Enabled  := blnMetragemObrigatoria;

  edtAparel.Enabled  := blnPermiteAparelhamentoBeneficiamento;
  edtBenefi.Enabled  := blnPermiteAparelhamentoBeneficiamento;

  If Not blnPermiteAparelhamentoBeneficiamento Then
  Begin
    edtPerBen.Text := '0,00';
    edtPerApa.Text := '0,00';
    edtAparel.Text := 'N';
    edtBenefi.Text := 'N';
  End;

  If Not blnMetragemObrigatoria Then
  Begin
    edtQtdPec.Text := '0,00000';
    edtComPec.Text := '0,00000';
    edtLarPec.Text := '0,00000';
    edtEspPec.Text := IIF(blnUtilizaVendaVidro,'1,00000','0,00000');

    If blnUtilizaVendaVidro Then
    Begin
      lblQtdMadeira.Caption := '';
      lblQuantidade.Caption := 'Quantidade:';
