procedure TfrmFatVendas.mnuTrocaPDRefORClick(Sender: TObject);
  Var
    cdsClone: TUniClientDataSet;
begin

  If Not fVerificaAcessoSistema('TRPROR') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Trocar Pedido de Referência do Orçamento!', ['&O k']);
    Exit;
  End;

  If Not mnuTrocaPDRefOR.Visible Then
    Exit;

  {****************************************************}
  {* FAZ A CÓPIA POIS SE O USUÁRIO ABORTAR IRÁ MANTER *}
  {* O PEDIDOS QUE FOI SELECIONADO NO MOMENTO EM QUE  *}
  {* ESCOLHEU O CLIENTE                               *}
  {*************************************************FC*}
  cdsClone := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsClone, fatVenda.cdsPedRefOR);

  pCriarFormularios(TfrmFatDigPedido, frmFatDigPedido);
  frmFatDigPedido.fatVenda     := fatVenda;
  frmFatDigPedido.ShowModal;

  If Assigned(fatVenda.cdsPedRefOR) Then
    FreeAndNil(fatVenda.cdsPedRefOR);

  fatVenda.cdsPedRefOR := TUniClientDataSet.Create(Self);

  If frmFatDigPedido.ModalResult = mrOk Then
  Begin
    pCloneDataSet(fatVenda.cdsPedRefOR, frmFatDigPedido.cdsDados);

    fatVenda.strNumPedRefOR      := frmFatDigPedido.edtNumPed.Text;
    fatVenda.strEmpPedRefOR      := frmFatDigPedido.edtCodEmp.Text;
    fatVenda.strCliAntOrcRef     := edtCodCli.Text;
  End
  Else
    pCloneDataSet(fatVenda.cdsPedRefOR, cdsClone);

  FreeAndNil(cdsClone);
  pFreeAndNil(frmFatDigPedido);
end;

