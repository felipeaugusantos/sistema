  LstrCodCnd: String ;
begin
  Result := True ;

  LblnOrcamentoCondicaoNoFinalAntigo := (Pos(strOpcDoc, 'OR_') > 0) and (fCfgSis('NVORPD') = 'N') and (fCfgSis('CNDVEN') = 'F') ;

  if (fCfgSis('CNDVEN') = 'F') then
    if not LblnOrcamentoCondicaoNoFinalAntigo then
      Exit ;

  if not pnlCndPag.Visible then
    if not LblnOrcamentoCondicaoNoFinalAntigo then
      Exit ;

