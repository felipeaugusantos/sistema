procedure TfrmFatVendas.pMostraComissaoVend;
  Var
    item: TDadosFechamento;
    cdsDados   : TUniClientDataSet;
    arrIteCom : TMatrizFechamento;
begin
  cdsDados    :=  TUniClientDataSet.Create(Self);

  pCloneDataSet(cdsDados, cdsVenda);
  cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

  Try

    pCriarFormularios(TfrmFatMostraComissao, frmFatMostraComissao);

    arrIteCom := fatVenda.fRecalculaComissao();

    cdsDados.First;

    For item In arrIteCom Do
    Begin
      If cdsDados.Locate('AUTOINCREM', item.intAutInc, []) Then
      Begin
        cdsDados.Edit;
        cdsDados.FieldByName('GRU_PERCOM').AsFloat := item.fltPerCom;
        cdsDados.FieldByName('ITE_COMVEN').AsFloat := item.fltTotCom;
        cdsDados.Post;
      End;

      frmFatMostraComissao.fltTotGer := frmFatMostraComissao.fltTotGer + cdsDados.FieldByName('ITE_TOTITE').AsFloat;
      frmFatMostraComissao.fltTotCom := frmFatMostraComissao.fltTotCom + cdsDados.FieldByName('ITE_COMVEN').AsFloat;

      cdsDados.Next;
    End;

    pCloneDataSet(frmFatMostraComissao.cdsDados, cdsDados);

    frmFatMostraComissao.cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

    frmFatMostraComissao.ShowModal;
    
  Except
    On E: ExceptionAutCom Do
      fMensagem('', E.Message, ['&O K']);

    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;

  FreeAndNil(cdsDados);
  pFreeAndNil(frmFatMostraComissao);
end;

