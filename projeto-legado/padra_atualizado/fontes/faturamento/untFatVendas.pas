function TfrmFatVendas.fCarregaItensConfirmacao(objConfDocs: TConfirmacaoDocumentos): Boolean;
  Var
    strCodTraSav: string;
begin

  Try
    frmFatVendas.Enabled := False;
    pnlCabecalho.Enabled := False;
    pnlDadosItem.Enabled := False;
    Screen.Cursor        := crHourGlass;
    Try
      strCodTraSav := fatVenda.strCodTra;

      Result := objConfDocs.fCarregaItensConfirmacaoDocumentos;

      If fCfgSis('CFNDIT', varBoolean) Then
        Result := objConfDocs.fChamaTelaParaConfirmacaoDosItens;

      If (fatVenda.strOpcDoc = 'CF') And
         (fatVenda.blnResolveuConflitoDeTransportadora) And
         (strCodTraSav <> fatVenda.strCodTra) And
         (Not fEmptyStr(strCodTraSav)) And
         (fCfgSis('TRADOC') = 'S') Then
        fatVenda.strCodTra := strCodTraSav;

      If Result Then
      Begin
        fatVenda.fltTotalLiqItensConf := fatVenda.fltTotPro;
        fatVenda.blnGrvConfComFFComBol := objConfDocs.blnConfTemFFComBol;
      End;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fCarregaItensConfirmacao]');
      End;
    End;
  Finally
    pHabilitaChkVendaPresencial;

    frmFatVendas.Enabled := True;
    pnlCabecalho.Enabled := True;
    pnlDadosItem.Enabled := (Pos(strOpcDoc, 'CP_CF_CI_') <=0);
    Screen.Cursor        := crDefault;

    pAtualizarEditsTotais;
  End;
end;

procedure TfrmFatVendas.pAtualizaDadosVenda(cdsItens: TUniClientDataSet);
  Var
    blnAltIte: Boolean;
    prcScrollVenda: TprcScroll;
    prcScrollItens: TprcScroll;
Begin
  With cdsItens Do
  Begin
    blnAltIte := False;

    Try
      pDisableControls(cdsVenda, prcScrollVenda);
      pDisableControls(cdsItens, prcScrollItens);

      First;

      While Not Eof Do
      Begin
        If fEmptyStr(FieldByName('ITE_CODITE').AsString) Then
          Break;

        If (RoundTo(FieldByName('ITE_PREINI').AsFloat, -2) <> RoundTo(FieldByName('ITE_UNITAR').AsFloat, -2)) And
           cdsVenda.Locate('AUTOINCREM', FieldByName('AUTOINCREM').AsInteger, []) Then
        Begin
          blnAltIte := True;

          cdsVenda.Edit;

          cdsVenda.FieldByName('ITE_UNITAR').AsFloat := FieldByName('ITE_UNITAR').AsFloat;
          cdsVenda.FieldByName('ITE_UNIDIG').AsFloat := FieldByName('ITE_UNIDIG').AsFloat;
          cdsVenda.FieldByName('ITE_DESCON').AsFloat := IIF(fUtilizaUnitarioLiquidoOuAplicarTaxaJurosPrecoDigitado And (not fPodeEditarPrecoUnitario),
                                                            fatVenda.fCalculaDescontoItem(FieldByName('ITE_UNIDIG').AsFloat,
                                                                                          FieldByName('ITE_UNITAR').AsFloat), 0);
          cdsVenda.FieldByName('ITE_TOTITE').AsFloat := FieldByName('ITE_TOTITE').AsFloat;

          If (fatVenda.strIdePro = 'NOR') And (Pos('ITEM ESPECIAL', cdsVenda.FieldByName('ITE_DESORI').AsString) <= 0) And
             (Not fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
          Begin
            pCalculaPrecoCusto(cdsVenda, cdsVenda.FieldByName('ITE_UNITAR').AsFloat,
                               cdsVenda.FieldByName('ITE_CUSITE').AsFloat,
                               (Pos('ITEM ESPECIAL', cdsVenda.FieldByName('ITE_DESORI').AsString) > 0),
                               fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString),
                               cdsVenda.FieldByName('ITE_ICMSAI').AsFloat);
           
            cdsVenda.FieldByName('ITE_PRECUS').AsFloat := fatVenda.fltPreCus;
            cdsVenda.FieldByName('ITE_PRECU2').AsFloat := fatVenda.fltPreCu2;
          End;

          If fEmptyStr(cdsVenda.FieldByName('ITE_TABPRE').AsString) Or (cdsVenda.FieldByName('ITE_PREVE' + cdsVenda.FieldByName('ITE_TABPRE').AsString).AsFloat = 0) Then
            cdsVenda.FieldByName('ITE_PRETAB').AsFloat := cdsVenda.FieldByName('ITE_UNIORI').AsFloat
          Else
            cdsVenda.FieldByName('ITE_PRETAB').AsFloat := cdsVenda.FieldByName('ITE_PREVE' + cdsVenda.FieldByName('ITE_TABPRE').AsString).AsFloat +
                                            fFormataFloat(cdsVenda.FieldByName('ITE_PREVE' + cdsVenda.FieldByName('ITE_TABPRE').AsString).AsFloat *
                                                         (cdsVenda.FieldByName('ITE_TAXJUR').AsFloat / 100.0), fatVenda.VS_intDecUni);

          cdsVenda.FieldByName('ITE_PRETAB').AsFloat := fFormataFloat(cdsVenda.FieldByName('ITE_PRETAB').AsFloat, fatVenda.VS_intDecUni);

          If fCfgSis('PRETAB', varBoolean) Then
          Begin
            If cdsVenda.FieldByName('ITE_PRETAB').AsFloat <> 0 Then
              cdsVenda.FieldByName('ITE_VARTAB').AsFloat := ((cdsVenda.FieldByName('ITE_UNITAR').AsFloat / cdsVenda.FieldByName('ITE_PRETAB').AsFloat) - 1) * 100;
          End
          Else
          Begin
            If cdsVenda.FieldByName('ITE_UNIORI').AsFloat <> 0 Then
              cdsVenda.FieldByName('ITE_VARTAB').AsFloat := ((cdsVenda.FieldByName('ITE_UNITAR').AsFloat / cdsVenda.FieldByName('ITE_UNIORI').AsFloat) - 1) * 100;
          End;

          If (fatVenda.fltVlCtVn > 0) And fItemUtilizaPrecoEmDolar(cdsVenda.FieldByName('ITE_CODITE').AsString) Then
          Begin
            cdsVenda.FieldByName('ITE_UNIDOL').AsFloat := cdsVenda.FieldByName('ITE_UNITAR').AsFloat / fatVenda.fltVlCtVn;
          End;

          cdsVenda.Post;

          If (Not blnFechamentoVenda) Then
          Begin
            fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
            pCalculaCustoRealTintaMaquinaSelecionado;
          End;

        End;

        Next;
      End;

      If blnAltIte Then
      Begin
        pCalculaTotais;
        If Not fEmptyStr(edtCodIte.Text) Then
          pAtualizaDados(Nil);
      End;

    Finally
      pEnableControls(cdsVenda, prcScrollVenda);
      pEnableControls(cdsItens, prcScrollItens);
    End;

  End;
End;

function TfrmFatVendas.fUtilizaUnitarioLiquido: Boolean;
begin
  Result := (fCfgSis('EDIUNL', varBoolean)) And
            (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And
            (Not blnUtilizaVendaMadeira) And
            (Not blnUtilizaVendaVidro) And
            (Not blnUtilizaVendaMetroLinear);
end;

procedure TfrmFatVendas.pAtualizarValorBrutoItensConfirmacao;
  Var
    prcScrollVenda: TprcScroll;
Begin
  With cdsVenda Do
  Begin

    Try
      pCalculaTotais;

      pDisableControls(cdsVenda, prcScrollVenda);

      First;

      While Not Eof Do
      Begin
        //MESMA REGRA QUE ESTÁ pCalcPorDes
        If (FieldByName('ITE_PROMOC').AsString <> 'S') Or (fatVenda.fPermiteDescontoPromocao(FieldByName('ITE_CODPRO').AsString, tapcdePromocaoCorrente)) Then
        Begin
          Edit;
          FieldByName('ITE_UNIDIG').AsFloat := FieldByName('ITE_TOTITE').AsFloat / FieldByName('ITE_QTDITE').AsFloat;
          FieldByName('ITE_UNIDIG').AsFloat := fFormataFloat(FieldByName('ITE_UNIDIG').AsFloat / (1 - fatVenda.fltDescProfissional / 100), fatVenda.VS_intDecUni);
          FieldByName('ITE_UNITAR').AsFloat := FieldByName('ITE_UNIDIG').AsFloat;
          FieldByName('ITE_DESCON').AsFloat := 0;
          FieldByName('ITE_TOTITE').AsFloat := fFormataFloat(FieldByName('ITE_UNITAR').AsFloat * FieldByName('ITE_QTDITE').AsFloat, 2);
          Post;
        End;

        Next;
      End;

      pCalculaTotais;

    Finally
      pEnableControls(cdsVenda, prcScrollVenda);
    End;

  End;
End;

procedure TfrmFatVendas.pMostraMargem(blnFatDigDesconto:Boolean=False);
  Var
    strOperador: String;
    frmMosMar : TfrmFatMostraMargemNovo;
    fltDesEspTmp,
    fltLimCre : Double;
    blnUsaUniLiq : Boolean;
    dicInfEmp: TDicionario;
begin

  blnUsaUniLiq := fUtilizaUnitarioLiquidoOuAplicarTaxaJurosPrecoDigitado;

  If (fStrToFloat(edtTotGer.Text) <= 0.0) Then
    Exit;

  If Not fValidaCamposInterna(edtSenDig) Then
    Exit;

  If Not fValidaCamposInterna(edtSenVen) Then
    Exit;

  btnCancelaItem.Click;

  HintControler.HideHint;

  {*****************************************}
  {* TRATAMENTO DE SENHA FIXA, VARIAVEL OU *}
  {* POR USUÁRIO                           *}
  {**************************************WI*}
  If (Not fEmptyStr(fCfgSis('SENMAR'))) Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Visualizar ' + IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' de Lucro');

    objLiberacao.strDirAce := 'MRGLU';
    objLiberacao.strSenLib := fCfgSis('SENMAR');
    objLiberacao.strMsgSen := IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' de Lucro';
    objLiberacao.strCodOpe := fatVenda.strCodVen;
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Exit;
  End;

  Try

    fatVenda.blnRestringirElementosMargem := True;

    fltDesEspTmp := 0;
    If (Not fEmptyStr(strNumOrc)) Or (fatVenda.blnHerancaOrcamentoPedido And (Not blnHerancaOrcamentoPedidoZerandoDesconto)) Then
      fltDesEspTmp := qryFatGor.FieldByName('FGO_DESESP').AsFloat;

    If (Pos(fatVenda.strOpcDoc, 'CP_OV_') > 0) Then
      fltDesEspTmp := fatVenda.fltDesEspConfPed;

    fltLimCre := 0;
    If (Not fatVenda.fDocumentoParaFornecedor) Then
      fltLimCre := qryConCli.FieldByName('CLI_LIMCRE').AsFloat;

    dicInfEmp := TDicionario.Create;
    dicInfEmp['oprflj']    := edtOprFlj.Text;
    dicInfEmp['empprd']    := fCfgSis('EMPPRD');
    dicInfEmp['emp_cd']    := fCfgSis('EMP_CD');
    dicInfEmp['Cd_S_N']    := IIF(chkEntCD.Checked, 'S', 'N');
    dicInfEmp['empfat']    := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);
    dicInfEmp['FatS_N']    := IIF(fatVenda.blnEmpFat, 'S', 'N');

    frmMosMar := TfrmFatMostraMargemNovo.Create(Self,
                                                fatVenda,
                                                qryTinta,
                                                strOperador,
                                                cbTabPrecoItem.Visible,
                                                fltLimCre,
                                                False,
                                                False,
                                                Nil,
                                                Nil,
                                                IIF(blnFatDigDesconto, fatVenda.fltDesEsp, fltDesEspTmp),
                                                strCcnAnt,
                                                blnFatDigDesconto,
                                                '',
                                                blnUsaUniLiq,
                                                fPodeEditarPrecoUnitario,
                                                fPodeAplicarTaxaJurosPrecoDigitado,
                                                dicInfEmp);

    frmMosMar.ShowModal;

    If (frmMosMar.ModalResult = mrOk) Then
    Begin
      pAtualizaDadosVenda(frmMosMar.cdsItens);
      fatVenda.fltDesEspF4 := frmMosMar.fGetDesEsp;
      fatVenda.fltDesEspConfF4 := fFormataFloat(frmMosMar.fltTotUniOri - frmMosMar.fltTotUnitar, 2);
      fatVenda.blnAbriuF4 := True;
      fatVenda.FfltMarLuc := frmMosMar.fltTotMargem;
    End;
  Except
    On E: Exception Do
    Begin
      cdsVenda.EnableControls;
      pMensagensErro(E.Message, '[pMostraMargem]');
    End;
  End;

  pFreeAndNil(frmMosMar);
  If Assigned(dicInfEmp) Then FreeAndNil(dicInfEmp);
end;

procedure TfrmFatVendas.pMostraMultiLotes(strCodIte: string);
var
  qryMultiLote: TUniQuery;
  blnArmazem: Boolean;
begin
  qryMultiLote := fCriaQuery;

  try
    blnArmazem := (fCfgSis('CTLEST') = '2');

    qryMultiLote.Close;
    qryMultiLote.SQL.Clear;
    qryMultiLote.SQL.Add('SELECT LOT_NUMLOT');

    if blnArmazem then
    begin
      qryMultiLote.SQL.Add(', AMZ_DESCRI');
    end
    else
    Begin
      qryMultiLote.SQL.Add(', " " AS AMZ_DESCRI');
    End;

    qryMultiLote.SQL.Add(', 0.0000 AS QTDITE');
    qryMultiLote.SQL.Add('FROM CADLOT L');
    qryMultiLote.SQL.Add('INNER JOIN CADITE');
    qryMultiLote.SQL.Add('ON ITE_CODITE = LOT_CODITE');

    if blnArmazem then
    begin
      qryMultiLote.SQL.Add('LEFT JOIN CADAMZ ON AMZ_CODAMZ = LOT_NUMLOT AND AMZ_CODEMP = L.LOT_CODEMP');
    end;

    qryMultiLote.SQL.Add('WHERE LOT_CODITE = :CODITE AND    LOT_CODEMP = :CODEMP ');
    qryMultiLote.SQL.Add('AND LOT_STATUS = "S" AND LOT_LOTAPR = "S"');
    qryMultiLote.SQL.Add('ORDER BY LOT_NUMLOT');

    qryMultiLote.ParamByName('CODITE').AsString := strCodIte;
    qryMultiLote.ParamByName('CODEMP').AsString := VS_strCodEmp;

    qryMultiLote.Open;

    if (not qryMultiLote.IsEmpty) then
    begin
      try
        try
          pCriarFormularios(TfrmFatMultiLote, frmFatMultiLote);
          pCarregaMultiLote(qryMultiLote);

          if blnArmazem then
          begin
            frmFatMultiLote.grdMultiLoteDBTableViewDESARM.DataBinding.FieldName := 'AMZ_DESCRI';
          end
          else
          begin
            frmFatMultiLote.grdMultiLoteDBTableViewDESARM.DataBinding.FieldName.Empty;
          end;

          frmFatMultiLote.grdMultiLoteDBTableViewDESARM.Visible := blnArmazem;

          if frmFatMultiLote.ShowModal = mrOk then
          begin
            if not frmFatMultiLote.cdsMultiLote.IsEmpty then
            begin
              blnEhMultiLote := True;
              frmFatMultiLote.cdsMultiLote.First;
              while not frmFatMultiLote.cdsMultiLote.Eof do
              begin
                if frmFatMultiLote.cdsMultiLoteQTDITE.AsFloat > 0 then
                begin
                  fIncluirItem(edtCodIte.Text,
                               frmFatMultiLote.cdsMultiLoteLOT_NUMLOT.AsString,
                               frmFatMultiLote.cdsMultiLoteQTDITE.AsFloat,
                               StrToFloatDef(edtUnitar.Text,0),
                               '',
                               '',
                               '',
                               StrToFloatDef(edtDesCon.Text,0));
                end;
                frmFatMultiLote.cdsMultiLote.Next;
              end;
              btnCancelaItem.Click;
              pLimpaDadosItem();
            end;
          end;
        except
          On E: Exception Do
            pMensagensErro(E.Message, '[pMostraMultiLotes]');
        end;
      finally
        FreeAndNil(frmFatMultiLote);
        blnEhMultiLote := False;
      end;
    end
    else
    begin
      fMensagem('', 'Não há lotes para esse item!', ['&Ok']);
    end;
  finally
    FreeAndNil(qryMultiLote);
  end;
end;

procedure TfrmFatVendas.pMostraMultiSeries(blnAlteraItem: Boolean);
  Var
    frmFatMultiSerie: TfrmFatMultiSerie;
    prcScroll: TprcScroll;
    strAutIncItemSerie: String;
begin
  If Not fValidaCampos(edtNumLot) Then
    Exit;

  pCriarFormularios(TfrmFatMultiSerie, frmFatMultiSerie);

  Try
    //adicionado por conta do fValidaCampos(edtQtdIte) mais abaixo, que invoca o
    //evento AfterScoll, que estava restaurando a quantidade anterior no edtQtdIte
    pDisableControls(cdsVenda, prcScroll);

    If blnAlteraItem Then
    Begin
      strAutIncItemSerie := IntToStr(cdsVenda.FieldByName('AUTOINCREM').AsInteger);
      fatVenda.objFatSerieItem.AutoincItem := strAutIncItemSerie;
      If fatVenda.objFatSerieItem.cdsFatSeries.IsEmpty Then
        fatVenda.objFatSerieItem.pCarregaSeriesItem(edtCodIte.Text, edtCodEmp.Text);
    End
    Else
    Begin
      strAutIncItemSerie := IntToStr(IfNull(cdsVenda.FieldByName('MAX_AUTINC').Value,0) +1);
      fatVenda.objFatSerieItem.AutoincItem := strAutIncItemSerie;
      fatVenda.objFatSerieItem.pCarregaSeriesItem(edtCodIte.Text, edtCodEmp.Text);
    End;

    frmFatMultiSerie.pAlimentaCdsSeries(fatVenda.objFatSerieItem.cdsFatSeries);

    frmFatMultiSerie.ShowModal;

    If frmFatMultiSerie.ModalResult <> mrOk Then
      Exit;

    fatVenda.objFatSerieItem.pFiltraDataSetSeries;

    fltQtdDigAnt   := fStrToFloat(edtQtdIte.Text);
    edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, fatVenda.objFatSerieItem.fGetTotQuantSerie + fltQtdDigAnt);
    edtQtdIteExit(edtQtdIte);

    fatVenda.objFatSerieItem.cdsSeries.Filtered := False;

    If Not fValidaCampos(edtQtdIte) Then
      Exit;

    blnInformouNumerosDeSerie := True;

    If Not fAdicionar Then
      Exit;

    fatVenda.objFatSerieItem.AutoincItem := strAutIncItemSerie;

    fatVenda.objFatSerieItem.pApagaSeries;

    frmFatMultiSerie.cdsSeries.First;
    While Not frmFatMultiSerie.cdsSeries.Eof Do
    Begin
      If (frmFatMultiSerie.cdsSeriesQTDSER.AsFloat > 0) Then
      Begin
        fatVenda.objFatSerieItem.pInsereSerie(frmFatMultiSerie.cdsSeriesNUMSER.AsString,
                                              frmFatMultiSerie.cdsSeriesQTDSER.AsFloat);

        fatVenda.objFatSerieItem.pInsereSerieParaGravacao(frmFatMultiSerie.cdsSeriesNUMSER.AsString,
                                                          frmFatMultiSerie.cdsSeriesQTDSER.AsFloat);
      End;
      frmFatMultiSerie.cdsSeries.Next;
    End;

  Finally
    blnInformouNumerosDeSerie := False;
    pEnableControls(cdsVenda, prcScroll);
    pFreeAndNil(frmFatMultiSerie);
  End;
end;

