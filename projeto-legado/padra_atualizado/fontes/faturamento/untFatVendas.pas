end;

function TfrmFatVendas.fAtribuiEspecieDocumentoSelecionadaParaObjVenda(blnVerificaSePermiteEmitirCupom: Boolean=True): Boolean;
var
  blnExit: Boolean;
begin
  Result := True;

  pVerificaSeEhSaldoMatriz;
  fatVenda.blnEnt_CD := chkEntCD.Checked;

  {*****************************************}
  {* PEGA ESPECIE DO DOCUMENTO             *}
  {**************************************MV*}
  fatVenda.strEspDoc := FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc;
  fatVenda.strTipFat := FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strDesCri;

  if (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'PD') then
  Begin
    If (Not fNovoFechamentoComCondicaoNoFinal) Then
    Begin
      If Not fValidaCodFpg(fatVenda.strCodFpg, fatVenda.strConPag, blnExit) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

  If (strOpcDoc = 'CF') Then
    fatVenda.pDeduzSeguridadeSocial;

  {*****************************************}
  {* VERIFICA SE É NOTA ESPECIAL           *}
  {**************************************MV*}
  If (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'NE') Then
  Begin
    fatVenda.blnNotEsp := True;
    If fatVenda.fEhVendaItemConcreto And fatVenda.blnDesmembrarNotaProdutosServicos Then
      fatVenda.strEspDoc := 'NS'
    Else
      fatVenda.strEspDoc := 'NF';
  End
  Else
    fatVenda.blnNotEsp := False;

  If blnVerificaSePermiteEmitirCupom Then
    If Not fPermiteEmitirCupom(fatVenda) Then
    Begin
      Result := False;
      Exit;
    End;

  If strOpcDoc = 'PI' Then
    fatVenda.strTipFat := fCfgSis('DESCPI');
end;

