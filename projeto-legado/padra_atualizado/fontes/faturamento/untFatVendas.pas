function TfrmFatVendas.fTemControleNumeroSerieOutrasSaidas(
  strCOdIte: string): Boolean;
var
  qryNumeroSerie: TUniQuery;
  strSQL: string;
begin
  try
    Result := False;

    strSQL := '';
    strSQL := strSQL + 'SELECT I.ITE_USASER ';
    strSQL := strSQL + 'FROM CADITE C ';
    strSQL := strSQL + 'INNER JOIN ITEGER I ';
    strSQL := strSQL + 'ON(C.ITE_CODITE = I.ITE_CODITE) ';
    strSQL := strSQL + 'WHERE C.ITE_CODITE = :CODITE ';
    strSQL := strSQL + 'AND I.ITE_CODEMP = :CODEMP ';

    qryNumeroSerie := fCriaQuery(nil);
    qryNumeroSerie.Close;
    qryNumeroSerie.SQL.Clear;
    qryNumeroSerie.SQL.Add(strSQL);
    qryNumeroSerie.ParamByName('CODITE').AsString := strCOdIte;
    qryNumeroSerie.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryNumeroSerie.Open;

    if not qryNumeroSerie.IsEmpty then
    begin
      Result := qryNumeroSerie.FieldByName('ITE_USASER').AsString = 'S';
    end;
  finally
    FreeAndNil(qryNumeroSerie);
  end;
end;

function TfrmFatVendas.fTemCreditoLancadoParaDocumento(const strNumDoc,
  strEspDoc, strCodEmp, strCodCli: String): Boolean;
var
  qryCredito: TUniQuery;
begin
  qryCredito := fCriaQuery;

  try
    qryCredito.Close;
    qryCredito.SQL.Clear;
    qryCredito.SQL.Add('SELECT SUM(IFNULL(IF(ADT_TIPLAN = "C", ADT_VALLAN, -ADT_VALLAN), 0)) AS VALLAN');
    qryCredito.SQL.Add('FROM ADTCLI');
    qryCredito.SQL.Add('WHERE ADT_NUMDOC = :NUMDOC');
    qryCredito.SQL.Add('AND ADT_ESPDOC = :ESPDOC');
    qryCredito.SQL.Add('AND ADT_EMPLAN = :CODEMP');
    qryCredito.SQL.Add('AND ADT_CODCLI = :CODCLI');

    qryCredito.ParamByName('NUMDOC').AsString := strNumDoc;
    qryCredito.ParamByName('ESPDOC').AsString := strEspDoc;
    qryCredito.ParamByName('CODEMP').AsString := strCodEmp;
    qryCredito.ParamByName('CODCLI').AsString := strCodCli;

    qryCredito.Open;

    Result := (qryCredito.FieldByName('VALLAN').AsFloat > 0);
  finally
    FreeAndNil(qryCredito);
  end;
end;

function TfrmFatVendas.fTemItemEspecialVenda: Boolean;
  Var
    cdsDados: TUniClientDataSet;
begin
  Result := False;

  cdsDados :=  TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  cdsDados.First;

  While Not cdsDados.Eof do
  begin
    Result := fPos('ITEM ESPECIAL', cdsDados.FieldByName('ITE_DESORI').AsString);

    If Result Then
      Break;

    cdsDados.Next;
  End;

  pFreeAndNil(cdsDados);
end;

function TfrmFatVendas.fPermiteCarregarOrcamentoOutraLojaComItemEspecial: Boolean;
begin
  Result := True;

  If Not fTemItemEspecialVenda Then
    Exit;

  {*****************************************************************}
  {* SE CASO FOR ORÇAMENTO DE OUTRA LOJA O SISTEMA IRÁ EMITIR UM   *}
  {* PEDIDO BASEANDO-SE NO ORÇAMENTO, ENTÃO É NECESSÁRIO VERIFICAR *}
  {* SE PODE EMIRTIR PEDIDO COM ITEM ESPECIAL NA LOJA CORRENTE     *}
  {**************************************************************FC*}
  If (fPermiteItemEspecial(strEspOrc)) And
     (strEspOrc = 'OR') And
     fatVenda.fOrcamentoOutraLojaORVN Then
    Result := False;

  If Not Result Then
    fMensagem('', 'Não é permitido gerar o pedido com item especial.', ['&O k']);
end;

