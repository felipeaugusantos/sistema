function TfrmFatVendas.fValidaPromocao(strCodIte: String=''; fltQtdIte: Double=0): Boolean;
  Var
    strIte: String;
    fltQtd: Double;

    fltPreCus: Double;
    fltPreVen: Double;
    fltComVar: Double;
    fltComAta: Double;
    fltComDis: Double;
    fltDesF07: Double;
    fltQtdDis: Double;
    fltQtdLim: Double;
    fltQtdMin: Double;
    blnParticiona: Boolean;
    blnPromo: Boolean;
    strComPro: String;
    strCodPro : String;

  procedure pMsgPromocaoQtdLimiteExcedida(AQtdDis : Double);
  begin
    AQtdDis := IfThen(AQtdDis < 0, 0, AQtdDis);
    fMensagem('Item em Promoção', 'A quantidade limite da promoção foi excedida !' + #13 + 'Quantidade disponível: ' + FloatToStrF(AQtdDis, ffNumber,12,2), ['&Ok']);
  end;

begin
  Result := True;
  strIte := IIF(Not fEmptyStr(strCodIte), strCodIte, edtCodIte.Text);
  fltQtd := IIF(fltQtdIte <> 0, fltQtdIte, fStrToFloat(edtQtdIte.Text));

  If (fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(strIte, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) And
     fRetornaPrecosPromocao(strIte,
                            edtCodCli.Text,
                            VS_Date,
                            fltQtd,

                            fatVenda.fRetQtdDigitada(strIte, '', IIF(btnAdicionar.Tag <= 0, '',
                                                     cdsVenda.FieldByName('AUTOINCREM').AsString), '', '', fRetEmpresaItem, False),

                            fatVenda.fRetQtdDigitada(strIte, '', IIF(btnAdicionar.Tag <= 0, '',
                                                    cdsVenda.FieldByName('AUTOINCREM').AsString), '', '', fRetEmpresaItem,
                                                    False, False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior, True {Somente em promocao}),

                            fatVenda.intPrzMed,
                            fltPreCus,
                            fltPreVen,
                            fltComVar,
                            fltComAta,
                            fltComDis,
                            fltQtdDis,
                            fltDesF07,
                            strComPro,
                            strCodPro,
                            blnParticiona,
                            blnPromo,
                            fTabelaPrecoItem,
                            fatVenda.strCodCnd,
                            '',
                            '',
                            True,
                            False,
                            '-1',
                            (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                            (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                            fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                            fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                            strNumOrc,
                            strEspOrc,
                            Nil,
                            False,
                            '',
                            objPromVlrMinTotalProdutos,
                            '',
                            fatVenda.fltSomaColorantes) Then
  Begin
    fatVenda.strPromoc := 'S';

    If blnParticiona Then
    Begin
      pMsgPromocaoQtdLimiteExcedida(fltQtdDis);
      fatVenda.strPromoc := 'N';
      Result := False;
    End;

  End
  Else
  Begin
    fatVenda.strPromoc := 'N';
    If blnPromo Then
    Begin
      fltQtdLim := fDadosPromocao(IIF(Not fEmptyStr(strCodIte), strCodIte, fCodItem), fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem), edtCodCli.Text, fTabelaPrecoItem, '', strNumOrc, strEspOrc, strCodPro).fltQtdLim;
      fltQtdMin := fDadosPromocao(IIF(Not fEmptyStr(strCodIte), strCodIte, fCodItem), fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem), edtCodCli.Text, fTabelaPrecoItem, '', strNumOrc, strEspOrc, strCodPro).fltQtdMin;

      If (fltQtdMin > 0) And (fltQtd < fltQtdMin) And (fltQtdDis > 0) Then
        fMensagem('Item em Promoção','A quantidade mínima promocional não foi atingida !'+#13+'Quantidade mínima para promoção: '+FloatToStrF(fltQtdMin,ffNumber,12,2), ['&OK'])

      Else If (fltQtdLim > 0) Then
        pMsgPromocaoQtdLimiteExcedida(fltQtdDis)

      Else If (blnParticiona) Then
        pMsgPromocaoQtdLimiteExcedida(fltQtdDis);

      Result := False;
    End;
  End;

  pEditarDesconto;
  pEditarPrecoUnitario;

end;

