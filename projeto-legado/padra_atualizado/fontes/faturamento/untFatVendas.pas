function TfrmFatVendas.fValidaCondicaoPagamentoFechamentoVenda(blnVerificaTipoFaturamentoConformePerfil: Boolean=False): Boolean;

  function fPermiteTipoFaturamentoConformeCondicao(): Boolean;
  begin
    Result := True;
    If (blnVerificaTipoFaturamentoConformePerfil) Then
      Result := fatVenda.fPermiteTipoFaturamentoConformeCondicao(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc);
  end;

begin
  Result := True;

  If (fTravaCondicaoDePagamentoEmCampanha) Then
  Begin
    pMensagemOk('A Condição e Forma de pagamento informados não podem ser usados com os itens em campanha selecionados!');
    Result := False;
    Exit;
  End;

  If blnApenasPrazo And (Copy(fatVenda.strConPag,3,3) = '000') Then
  Begin
    If Not((Pos(strOpcDoc, 'PD_OR_') > 0) And (blnApenasVista)) Then
    Begin
      pMensagemOk(MSG_SOMENTE_A_PRAZO);
      Exit(False);
    End
  End;

  If (fCfgSis('TPFCCX') <> 'C') And (blnApenasVista) And (Copy(fatVenda.strConPag,3,3) <> '000') And (Not blnApenasPrazo) Then
  Begin
    pRetornaUltimoFechamento(FVariaveisFechamentoVenda.fltSalFec, FVariaveisFechamentoVenda.dtaDtaFec);
    If FVariaveisFechamentoVenda.dtaDtaFec = VS_Date Then
      pMensagemOk('O fechamento de caixa referente ao dia ' + FormatDateTime('dd/mm/yyyy',VS_Date) + ' já foi efetuado. Só é permitido venda à vista!')
    Else If Not fNecessitaFecharCaixa(False, FVariaveisFechamentoVenda.dtaCaiAbe, False) Then
      pMensagemOK('O caixa do dia ' + DateToStr(FVariaveisFechamentoVenda.dtaCaiAbe) + ' ainda não foi fechado. Só é permitido venda à vista!');

    Result := False;
    Exit;
  End;

  {****************************************************}
  {* SE FOR FORMA DE PAGAMENTO UTILIZAÇÃO DE CREDITOS *}
  {* PASSA APENAS SE O VALOR TOTAL NÃO ULTRAPASSAR    *}
  {* O TOTAL DE CREDITOS QUE O CLIENTE POSSUI         *}
  {*************************************************AF*}
  If (fCfgSis('EXICRE', varString) = 'S') And fatVenda.VS_blnUsaFpg And (Pos(strOpcDoc,'CF_CI_CT_CN_CO_') <= 0) Then
  Begin
    If Pos(fatVenda.strCodFpg,'013') > 0 Then
    Begin
      If fFormataFloat(fatVenda.fltTotGer,2) > fFormataFloat(fatVenda.fltTotCre,2) Then
      Begin
        fMensagem('','Valor da venda não pode ultrapassar o total de créditos que o cliente possui!'+#13+
                  'Altere a forma de pagamento para "009 - Parcelado" para escolher todas as formas de pagamento da venda.',['&OK']);
        Result := False;
        Exit;
      End;
    End;
  End;

  If (Not fPermiteTipoFaturamentoConformeCondicao) Then
  Begin
    Result := False;
    Exit;
  End

end;

