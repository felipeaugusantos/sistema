procedure TfrmFatVendas.pProdutoPodeSerDevolvido;
var
  strMensagem: string;
  blnDocNaoExpedido,
  blnDocNaoRomaneio: Boolean;
begin

  blnDocNaoExpedido := False;
  blnDocNaoRomaneio := False;

  if ((pos(strOpcDoc, 'DV') <> 0) and (fCfgSis('TIPEXP') = '2')) then
  begin

    try

      pCriarFormularios(TfrmFatMostraProdNaoDevolver, frmFatMostraProdNaoDevolver);
      frmFatMostraProdNaoDevolver.pAbreClientItens;

      {****************************************************************}
      { SÓ É POSSÍVEL A DEVOLUÇÃO SE O ITEM FOI BAIXADO PELA EXPEDICAO }
      { E O ITEM ESTÁ EM UM DOS ROMANEIO                               }
      {*************************************************************CH*}
      strMensagem := '';

      cdsVenda.DisableControls;
      cdsVenda.First;
      While not cdsVenda.Eof do
      begin

        if not(fDocumentoExpedido(cdsVenda.FieldByName('ITE_DOCDEV').AsString,
                                  cdsVenda.FieldByName('ITE_ESPDEV').AsString,
                                  cdsVenda.FieldByName('ITE_EMPDEV').AsString)) Then
          blnDocNaoExpedido := True;

        if not(fItemEstaEmRomaneio(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                   cdsVenda.FieldByName('ITE_DOCDEV').AsString,
                                   cdsVenda.FieldByName('ITE_ESPDEV').AsString,
                                   cdsVenda.FieldByName('ITE_EMPDEV').AsString)) then
          blnDocNaoRomaneio := True;

        if ((blnDocNaoExpedido) or (blnDocNaoRomaneio)) Then
        begin
          frmFatMostraProdNaoDevolver.pIncluiItem( cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                   cdsVenda.FieldByName('ITE_DESITE').AsString,
                                                   cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                                   cdsVenda.FieldByName('ITE_UNIDIG').AsFloat,
                                                   cdsVenda.FieldByName('ITE_TOTITE').AsFloat );
        end;
        cdsVenda.Next;
      end;
      cdsVenda.EnableControls;

      if frmFatMostraProdNaoDevolver.cdsItens.RecordCount > 0 then
      begin

        If (blnDocNaoExpedido) And (blnDocNaoRomaneio) Then
          strMensagem := 'O Documento não foi baixado pela expedição e não está vinculado a nenhum romaneio.';

        If (Not blnDocNaoExpedido) And (blnDocNaoRomaneio) Then
          strMensagem := 'Documento expedido e não vinculado a nenhum romaneio.';

        frmFatMostraProdNaoDevolver.Caption := strMensagem;
        frmFatMostraProdNaoDevolver.ShowModal;
      end;

      pFreeAndNil(frmFatMostraProdNaoDevolver);

    except
      fMensagem('','Não consegui relacionar os registros devolvidos! Tente novamente!',['&OK']);
    end;

  end;

end;

function TfrmFatVendas.fValidaCusto: Boolean;
Var
  cdsDados: TUniClientDataSet;
  sltItems: TStringList;
begin
  Result := True;

  sltItems := TStringList.Create;
  cdsDados := TUniClientDataSet.Create(Self);

  pCloneDataSet(cdsDados, cdsVenda);
  cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

  Try
    cdsDados.First;

    While Not cdsDados.Eof Do
    Begin
      If (Pos('ITEM ESPECIAL', cdsDados.FieldByName('ITE_DESORI').AsString) = 0) And
         (not fEhItemServico(cdsDados.FieldByName('ITE_CODITE').AsString)) And
         (cdsDados.FieldByName('ITE_IDEPRO').AsString = 'NOR') And
         (cdsDados.FieldByName('ITE_CUSITE').AsFloat <= 0) Then
      Begin
        sltItems.Add(cdsDados.FieldByName('ITE_CODITE').AsString + ' - ' + cdsDados.FieldByName('ITE_DESITE').AsString);
        Result := False;
      End;

      cdsDados.Next;
    End;

    If not Result Then
    Begin
      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.Caption := 'ATENÇÃO';
        frmObservacao.lblMensagem.caption := 'Produtos com valor de custo inválido:';
        frmObservacao.memObs.texto := sltItems.Text;
        frmObservacao.ShowModal;
      Finally
        FreeAndNil(frmObservacao);
      End;
    End;

  Finally
    FreeAndNil(cdsDados);
    FreeAndNil(sltItems);
  End;
end;

function TfrmFatVendas.fValidaDocumentoDevolucaoEmitidosDiasVencidos(strNumDoc,
  strEspDoc, strEmpDoc, strCodCli: string): Boolean;
var
  qryConsulta: TUniQuery;
  fltTotDoc: Double;
  dtaDtaDoc: TDateTime;
  strChaveTmp,
  strPrazo,
  strCodVen: String;
  intDiaNF,
  intDiaFF: integer;
  strSenhaFixa: String;

  function fDiasPassadosDoctoOriginal(dtaDtaDev: TDateTime): Integer;
  begin
    Result := DaysBetween(VS_Date, dtaDtaDev);
  end;

  function fRetornaChaveAcesso(strNumDoc, strEspDoc, strCodEmp: String; dtaDataEnt: TDateTime): String;
    Var
      qryAux: TUniQuery;
      function fRetornaSql(strTabGer, strTabDet: String): String;
      begin
        Result := '';
        Result := Result + 'SELECT ';
        Result := Result + '  FIS_ACESSO ';
        Result := Result + 'FROM ';
        Result := Result + '  CADFIS ';
        Result := Result + 'JOIN ' + strTabGer + ' G ON G.GER_NUMDOC = FIS_NUMDOC AND ';
        Result := Result + '                            G.GER_ESPDOC = FIS_ESPDOC AND ';
        Result := Result + '                            G.GER_CODEMP = FIS_CODEMP AND ';
        Result := Result + '                            IFNULL(G.GER_CODFOR, G.GER_CODCLI) = FIS_FORCLI AND ';
        Result := Result + '                            G.GER_TIP_FC = FIS_TIP_FC AND ';
        Result := Result + '                            G.GER_TIP_FC = FIS_TIP_FC ';

        Result := Result + 'JOIN ' + strTabDet + ' D ON D.DET_SEQGER = G.AUTOINCREM ';
        Result := Result + 'WHERE ';
        Result := Result + '  D.DET_NUMDOC = :NUMDOC AND ';
        Result := Result + '  D.DET_ESPDOC = :ESPDOC AND ';
        Result := Result + '  D.DET_CODEMP = :CODEMP AND ';
        Result := Result + '  D.DET_DTAENT = :DTAENT ';
      end;
  begin
    qryAux := fCriaQuery(Self);

    try
      qryAux.SQL.Add(fRetornaSql('MOVGER', 'MOVDET'));
      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.ParamByName('DTAENT').AsDateTime := dtaDataEnt;
      qryAux.Open;

      If (qryAux.IsEmpty) Then
      Begin
        qryAux.SQL.Clear;
        qryAux.SQL.Add(fRetornaSql('NOTGER', 'NOTDET'));
        qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
        qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
        qryAux.ParamByName('CODEMP').AsString := strCodEmp;
        qryAux.ParamByName('DTAENT').AsDateTime := dtaDataEnt;
        qryAux.Open;
      End;

      Result := qryAux.FieldByName('FIS_ACESSO').AsString;
    finally
      FreeAndNil(qryAux);
    end;
  end;


begin
  Result := True;

  if (fEmptyStr(strNumDoc)) or (fEmptyStr(strEspDoc)) or (fEmptyStr(strEmpDoc)) then
  begin
    Exit;
  end;

  qryConsulta := fCriaQuery();
  try
    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add('SELECT GER_CODVEN, GER_CODCLI, GER_DTAENT, GER_VLRCON');
    qryConsulta.SQL.Add('FROM MOVGER');
    qryConsulta.SQL.Add('WHERE GER_NUMDOC = :NUMDOC');
    qryConsulta.SQL.Add('AND GER_ESPDOC = :ESPDOC');
    qryConsulta.SQL.Add('AND GER_CODEMP = :CODEMP');
    qryConsulta.SQL.Add('AND GER_CODCLI = :CODCLI');
    qryConsulta.SQL.Add('UNION');
    qryConsulta.SQL.Add('SELECT GER_CODVEN, GER_CODCLI, GER_DTAENT, GER_VLRCON');
    qryConsulta.SQL.Add('FROM NOTGER');
    qryConsulta.SQL.Add('WHERE GER_NUMDOC = :NUMDOC');
    qryConsulta.SQL.Add('AND GER_ESPDOC = :ESPDOC');
    qryConsulta.SQL.Add('AND GER_CODEMP = :CODEMP');
    qryConsulta.SQL.Add('AND GER_CODCLI = :CODCLI');

    qryConsulta.ParamByName('NUMDOC').AsString := strNumDoc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspDoc;
    qryConsulta.ParamByName('CODEMP').AsString := strEmpDoc;
    qryConsulta.ParamByName('CODCLI').AsString := strCodCli;

    qryConsulta.Open;

    if not qryConsulta.IsEmpty then
    begin
      fltTotDoc := qryConsulta.FieldByName('GER_VLRCON').AsFloat;
      dtaDtaDoc := qryConsulta.FieldByName('GER_DTAENT').AsDateTime;
      strCodVen := qryConsulta.FieldByName('GER_CODVEN').AsString;

      intDiaNF := fCfgSis('DIADVE', VarInteger);
      intDiaFF := fCfgSis('DIADEV', VarInteger);

      strChaveTmp := fRetornaChaveAcesso(strNumDoc,strEspDoc,strEmpDoc,dtaDtaDoc);

      if (((Not fEmptyStr(strChaveTmp)) and (fDiasPassadosDoctoOriginal(dtaDtaDoc) >= intDiaNF)) or
          ((fEmptyStr(strChaveTmp)) and (fDiasPassadosDoctoOriginal(dtaDtaDoc) >= intDiaFF))) then
      begin
        if (Not fEmptyStr(strChaveTmp)) then
        begin
          strPrazo :=  fStrZero(IntToStr(intDiaNF), 3);
        end
        else
        begin
          strPrazo :=  fStrZero(IntToStr(intDiaFF), 3);
        end;

        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddSeparador(80);
        objLiberacao.objMsgLibera.pAddTexto('DEVOLUÇÃO FORA DO PRAZO');
        objLiberacao.objMsgLibera.pAddSeparador(80);
        objLiberacao.objMsgLibera.pAddTextoCaption('Documento'           , strNumDoc + '-' + strEspDoc + '-' + strEmpDoc              , 22);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'             , fRetNomCliente(strCodCli)                                  , 22);
        objLiberacao.objMsgLibera.pAddTextoCaption('Dt.Emissão'          , FormatDateTime('dd/mm/yyyy', dtaDtaDoc)                    , 22);
        objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Documento'        , FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltTotDoc) , 22);
        objLiberacao.objMsgLibera.pAddTextoCaption('Vend.Documento'      , strCodVen + '-' + fRetNomVendRep(strCodVen)                , 22);
        objLiberacao.objMsgLibera.pAddTextoCaption('Prazo para devolução', strPrazo + ' dias'                                         , 22);
        objLiberacao.objMsgLibera.pAddSeparador(80);

        strSenhaFixa := fCfgSis('DIAVEN');
        objLiberacao.strDirAce := 'DIAVEN';
        objLiberacao.blnManterCompatibilidadeSenCfg := Not fEmptyStr(strSenhaFixa);
        objLiberacao.strSenLib    := strSenhaFixa;
        objLiberacao.strMsgSen := 'Devolução de Documentos';
        objLiberacao.strCodOpe := fatVenda.strCodVen;
        objLiberacao.strCodDig := fatVenda.strCodDig;

        Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
      end;
    end;
  finally
    FreeAndNil(qryConsulta);
  end;
end;

