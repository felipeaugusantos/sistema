  strSQL := strSQL + '  G.ITE_LOCFIS, ';
  strSQL := strSQL + '  A.ABF_CODABF, ';
  strSQL := strSQL + '  I.ITE_PESOIT, ';
  strSQL := strSQL + '  I.ITE_PESLIQ, ';
  strSQL := strSQL + '  I.ITE_OBRCPF, ';
  strSQL := strSQL + '  I.ITE_EMBALA, ';
  strSQL := strSQL + '  I.ITE_CILVAS, ';

  If fCfgSis('IMPDIG') = '1' Then
    strSQL := strSQL + '  I.ITE_IMPDIR  '
  Else
    strSQL := strSQL + '  G.ITE_IMPDIR  ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADITE I, ';
  strSQL := strSQL + '  ITEGER G, ';
  strSQL := strSQL + '  ABFICM A ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  I.ITE_CODITE = G.ITE_CODITE AND ';

  If fCfgSis('TIPABF') = '1' Then
    strSQL := strSQL + '  I.ITE_CODABF = A.ABF_CODABF AND '
  Else
    strSQL := strSQL + '  G.ITE_CODABF = A.ABF_CODABF AND ';

  strSQL := strSQL + '  I.ITE_CODITE = :CODITE AND ';
  strSQL := strSQL + '  G.ITE_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '  A.ABF_ESTADO = :ESTADO ';

  {*****************************************}
  {* PREPARA A QUERY PARA RETORNAR DADOS   *}
  {* DO ITEM E DA ABREVIAÇÃO FISCAL        *}
  {**************************************MV*}
  With qryGenIte Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
  End;

  Try

    pnlCabecalho.Enabled := False;
    pnlDadosItem.Enabled := False;
    Screen.Cursor        := crHourGlass;

    With fatVenda.qryTemporariaConfirmacao Do
    Begin

      First;
      blnPegMsg := True;
      blnPegEndEnt := True;
      fatVenda.strPlaVei := '';
      fatVenda.strKm_Vei := '';

      fatVenda.blnCSTCEQ := fCfgSis('CSTCEQ', varBoolean);

      While (Not Eof) Do
      Begin
        {*************************************************************************}
        {* SE FOR PEDIDO DE BAIXA DE ENTREGA FUTURA, DEVE BAIXAR A QTD. ENTREGUE *}
        {* E BAIXAR OS DOCUMENTOS DE ENTREGA FUTURA CORRESPONDENTES              *}
        {**********************************************************************MM*}
        If (strOpcDoc = 'CP') And (Assigned(FindField('TMP_BENFUT'))) And (FieldByName('TMP_BENFUT').AsString = 'S') Then
        Begin
          If (Not Assigned(fatVenda.dicDesEspItens)) Then
            fatVenda.dicDesEspItens := TDicionario.Create;

          fatVenda.blnBaiEntFut := True;
          fatVenda.pAdicionaItensDaBaixaDeEntregaFutura(FieldByName('TMP_AUTINC').AsString);
        End
        Else
        Begin
          fatVenda.blnBaiEntFut := False;
          If (Assigned(fatVenda.cdsBaiEntFut)) Then
            fatVenda.cdsBaiEntFut.EmptyDataSet;
        End;

        If fEmptyStr(fatVenda.strFasObr) Then
          fatVenda.strFasObr := FieldByName('TMP_FASOBR').AsString;

        {******************************************}
        {* PEGA AS MENSAGENS DO PRIMEIRO REGISTRO *}
        {* QUE POSSUI MENSAGENS GRAVADAS.         *}
        {***************************************PZ*}
        If (blnPegMsg) And
           ((Not fEmptyStr(FieldByName('TMP_MEN001').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MEN002').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MEN003').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MEN004').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MEN005').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MENEXP').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MENEX2').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MENEX3').AsString)) Or
            (Not fEmptyStr(FieldByName('TMP_MENEX4').AsString))) Then
        Begin
          fatVenda.strMen001 := FieldByName('TMP_MEN001').AsString;
          fatVenda.strMen002 := FieldByName('TMP_MEN002').AsString;
          fatVenda.strMen003 := FieldByName('TMP_MEN003').AsString;
          fatVenda.strMen004 := FieldByName('TMP_MEN004').AsString;
          fatVenda.strMen005 := FieldByName('TMP_MEN005').AsString;
          fatVenda.strMenExp := FieldByName('TMP_MENEXP').AsString;
          fatVenda.strMenEx2 := FieldByName('TMP_MENEX2').AsString;
          fatVenda.strMeneX3 := FieldByName('TMP_MENEX3').AsString;
          fatVenda.strMeneX4 := FieldByName('TMP_MENEX4').AsString;
          blnPegMsg := False;
        End;

        If (fCfgSis('SUJROM', VarString, fGetEmpConfigEntrega) = 'S') And
           (blnPegEndEnt) Then
        Begin
          fatVenda.pCarregaEnderecoEntrega(fatVenda,
                                           FieldByName('TMP_NOMTAB').AsString,
                                           FieldByName('TMP_AUTINC').AsString,
                                           True);

          blnPegEndEnt := fEmptyStr(fatVenda.strEndEnt);

          If Not blnPegEndEnt Then
            fatVenda.blnEndEntConfDoc := True;
        End
        Else
          blnPegEndEnt := False;

        For intContador := 1 To 30 Do
        Begin

          If (Not fEmptyStr(FieldByName('TMP_CODS' + fStrZero(intContador, 2)).AsString)) Then
          Begin

            fatVenda.pAtribuiValoresServico(intContServico,
                                            FieldByName('TMP_CODS' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_DESS' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_IDES' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_BRIS' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_PARS' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_TBRS' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_VENS' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_VE2S' + fStrZero(intContador, 2)).AsString,
                                            FieldByName('TMP_QTDS' + fStrZero(intContador, 2)).AsFloat,
                                            FieldByName('TMP_UNIS' + fStrZero(intContador, 2)).AsFloat,
                                            FieldByName('TMP_VALS' + fStrZero(intContador, 2)).AsFloat,
                                            FieldByName('TMP_CUSS' + fStrZero(intContador, 2)).AsFloat,
                                            FieldByName('TMP_DECS' + fStrZero(intContador, 2)).AsFloat );
            Inc(intContServico);

          End;
        End;

        fatVenda.pAcertaValorServicos;

        If (Pos(FieldByName('TMP_NUMDOC').AsString, fatVenda.strNumDocsPD) <= 0) Then
          fatVenda.strNumDocsPD := fatVenda.strNumDocsPD + FieldByName('TMP_NUMDOC').AsString + ',';

        {*****************************************}
        {* SOMA DESCONTO ESPECIAL                *}
        {**************************************MV*}
        fatVenda.fltDesEsp := fatVenda.fltDesEsp + FieldByName('TMP_DESESP').AsFloat;

        {*****************************************}
        {* CARREGA DOCUMENTO DETALHADO           *}
        {**************************************MV*}
        qryGenDor.Close;
        qryGenDor.ParamByName('NUMDOC').AsString := FieldByName('TMP_NUMDOC').AsString;
        qryGenDor.ParamByName('ESPDOC').AsString := FieldByName('TMP_ESPDOC').AsString;
        qryGenDor.ParamByName('CODEMP').AsString := FieldByName('TMP_CODEMP').AsString;
        qryGenDor.Open;

        If fEmptyStr(fatVenda.strPlaVei) Then
          fatVenda.strPlaVei := qryGenDor.FieldByName('FGO_PLAVEI').AsString;

        If fEmptyStr(fatVenda.strKM_Vei) Then
          fatVenda.strKm_Vei := qryGenDor.FieldByName('FGO_KM_VEI').AsString;

        {************************************}
        {* CARREGA DOCUMENTO FATGOR         *}
        {*********************************JB*}
        qryGenGor.Close;
        qryGenGor.SQL.Clear;
        qryGenGor.SQL.Add('SELECT ');
        qryGenGor.SQL.Add('  FGO_TIPFRE, ');
        qryGenGor.SQL.Add('  FGO_NUMDOC, ');
        qryGenGor.SQL.Add('  FGO_ESPDOC, ');
        qryGenGor.SQL.Add('  FGO_CODEMP, ');
        qryGenGor.SQL.Add('  FGO_OPRFLJ, ');
        qryGenGor.SQL.Add('  FGO_DTAENT, ');
        qryGenGor.SQL.Add('  FGO_EDIPES, ');
        qryGenGor.SQL.Add('  FGO_CODPRJ, ');
        qryGenGor.SQL.Add('  FGO_PREVIS, ');
        qryGenGor.SQL.Add('  FGO_NUMDRW,  ');
        qryGenGor.SQL.Add('  FGO_CLICEO  ');
        qryGenGor.SQL.Add('FROM ');
        qryGenGor.SQL.Add('  FATGOR ');
        qryGenGor.SQL.Add('  LEFT JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM ');
        qryGenGor.SQL.Add('WHERE ');
        qryGenGor.SQL.Add('  AUTOINCREM = :SEQGER ');
        qryGenGor.ParamByName('SEQGER').AsString := qryGenDor.FieldByName('FDO_SEQGER').AsString;
        qryGenGor.Open;
        fatVenda.strTipFre    := qryGenGor.FieldByName('FGO_TIPFRE').AsString;
        fatVenda.strNumOrc    := qryGenGor.FieldByName('FGO_NUMDOC').AsString;
        fatVenda.strEspOrc    := qryGenGor.FieldByName('FGO_ESPDOC').AsString;
        fatVenda.strEmpOri    := qryGenGor.FieldByName('FGO_CODEMP').AsString;
        fatVenda.strOprFlj    := qryGenGor.FieldByName('FGO_OPRFLJ').AsString;
        fatVenda.dtaDtaEntOri := qryGenGor.FieldByName('FGO_DTAENT').AsDateTime;
        fatVenda.dtaPreVis    := qryGenGor.FieldByName('FGO_PREVIS').AsDateTime;
        fatVenda.strCodPrj    := qryGenGor.FieldByName('FGO_CODPRJ').AsString;
        fatVenda.strCliCEO     := qryGenGor.FieldByName('FGO_CLICEO').AsString;

        if fEmptyStr(fatVenda.strNumeroDrawback) then
          fatVenda.strNumeroDrawback := qryGenGor.FieldByName('FGO_NUMDRW').AsString;

        If (qryGenGor.FieldByName('FGO_EDIPES').AsString = 'S') Then
          fatVenda.strEdiPes := 'E';

        fatVenda.fGetFdoIte.pPreencherDataSetFdoIte(qryGenDor.FieldByName('FDO_SEQGER').AsString);

        While (Not qryGenDor.Eof) Do
        Begin
          pProgress(qryGenDor.RecNo, qryGenDor.RecordCount);

          {*****************************************}
          {* SÓ ADICIONA AS SAÍDAS                 *}
          {**************************************MV*}
          If (StrToInt(LeftStr(qryGenDor.FieldByName('FDO_CLAFIS').AsString, 1)) < 5) Then
          Begin
            fatVenda.fltDesEsp := fatVenda.fltDesEsp + qryGenDor.FieldByName('FDO_TOTITE').AsFloat;
            fatVenda.fltDesSai := fatVenda.fltDesSai + qryGenDor.FieldByName('FDO_TOTITE').AsFloat;

            qryGenDor.Next;
            Continue;
          End;

          If fEhItemServico(qryGenDor.FieldByName('FDO_CODITE').AsString) Then
          Begin

            If fatVenda.strConfSer = 'S' Then
            Begin
              pIncluirNaMatrizDePedidos(fatvenda.arrPedidos, qryGenDor.FieldByName('FDO_NUMDOC').AsString,
                                                             qryGenDor.FieldByName('FDO_ESPDOC').AsString,
                                                             qryGenDor.FieldByName('FDO_CODEMP').AsString);
            End
            Else
            Begin
              pIncluirNaMatrizDePedidos(fatvenda.arrPedidosConf, qryGenDor.FieldByName('FDO_NUMDOC').AsString,
                                                                 qryGenDor.FieldByName('FDO_ESPDOC').AsString,
                                                                 qryGenDor.FieldByName('FDO_CODEMP').AsString);
            End;

            qryGenDor.Next;
            Continue;
          End;

          If (strItemAnt <> qryGenDor.FieldByName('FDO_CODITE').AsString)  Or
             (strGrupoAnt <> qryGenDor.FieldByName('GRU_CODGRU').AsString) Then
          Begin

            {*****************************************}
            {* CARREGA ITEM                          *}
            {**************************************MV*}
            qryGenIte.Close;
            qryGenIte.ParamByName('CODITE').AsString := qryGenDor.FieldByName('FDO_CODITE').AsString;
            qryGenIte.ParamByName('CODEMP').AsString := fatVenda.fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString);
            qryGenIte.ParamByName('ESTADO').AsString := fatVenda.fGetUFEmpresa(qryGenDor.FieldByName('FDO_EMPITE').AsString);
            qryGenIte.Open;

            strItemAnt  := qryGenDor.FieldByName('FDO_CODITE').AsString;
            strGrupoAnt := qryGenDor.FieldByName('GRU_CODGRU').AsString;

          End;

          If (qryGenDor.FieldByName('FDO_QTDEMB').AsFloat > 0) Then
            fltUnitarioEmb := (qryGenDor.FieldByName('FDO_PREEMB').AsFloat /
                               qryGenDor.FieldByName('FDO_QTDEMB').AsFloat)
          Else
            fltUnitarioEmb := 0.0;

          (**********************************************)
          (* PARA ADICINAR NA TEMPORARIA CORRETAMENTE   *)
          (*******************************************LA*)
          fatVenda.blnEnt_CD := SameText(qryGenDor.FieldByName('FGO_ENT_CD').AsString, 'S');

          If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
          Begin
            recMadeira.fltComPec := qryGenDor.FieldByName('FDO_COMPEC').AsFloat;
            recMadeira.fltLarPec := qryGenDor.FieldByName('FDO_LARPEC').AsFloat;
            recMadeira.fltEspPec := qryGenDor.FieldByName('FDO_ESPPEC').AsFloat;

            recMadeira.fltQtdPec := fCalculaQuantidadePecas(qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                                            recMadeira.fltComPec,
                                                            recMadeira.fltLarPec,
                                                            recMadeira.fltEspPec,
                                                            fRetSiglaUnidade(qryGenDor.FieldByName('FDO_UNIDAD').AsString));

            recMadeira.strAparel := qryGenDor.FieldByName('FDO_APAREL').AsString;
            recMadeira.fltPerApa := qryGenDor.FieldByName('FDO_PERAPA').AsFloat;
            recMadeira.strBenefi := qryGenDor.FieldByName('FDO_BENEFI').AsString;
            recMadeira.fltPerBen := qryGenDor.FieldByName('FDO_PERBEN').AsFloat;
          End;

          fltCusIte := qryGenDor.FieldByName('FDO_TOTCUS').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat;

          If Not (fCfgSis('ALPDEX', VarBoolean) Or (qryGenDor.FieldByName('FDO_JAFATU').AsInteger = 0)) Then
          Begin
            qryGenDor.Next;
            Continue;
          End;

          blnSintetiza := False;
//REQ.:236691 A SINTETIZAÇÃO DE ITENS FAZ COM QUE O CANCELAMENTO DA NOTA GERADA NÃO CONSIGA DESFATURAR OS PEDIDOS
//QUE DERAM ORIGEM A NOTA, UMA VEZ QUE, O SISTEMA USA OS CAMPOS NUM_PD, EMP_PD E PRINCIPALEMENTE O IND_PD DENTRO
//DA FUNÇÃO IND_PD fCancelaItensDocumento AO AGRUPAR E PERCO ESSAS INFORMAÇÕES POIS O SISTEMA FAZ N LINHAS VIRAR 1
//CASO O ITEM ESTEJA REPETIDO, ARMAZENANDO NOS CAMPOS UM_PD, EMP_PD, IND_PD O ÚLTIMO REGISTRO QUE ELE AGRUPOU.
{COMENTADO
          If (strOpcDoc = 'OV') And Assigned(fatVenda.objItensPedidos) And
             (qryGenDor.FieldByName('FDO_IDEPRO').AsString = 'NOR') And
             (Pos('ITEM ESPECIAL', qryGenIte.FieldByName('ITE_DESITE').AsString) <= 0) And
             (Not fEhItemVendaVidro(qryGenDor.FieldByName('FDO_CODITE').AsString)) And
             (fatVenda.fLocalizaItem(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                     qryGenDor.FieldByName('FDO_DESCRI').AsString,
                                     qryGenDor.FieldByName('FDO_UNITAR').AsFloat,
                                     qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                     qryGenDor.FieldByName('FDO_NUMLOT').AsString,
                                     recMadeira)) Then
          Begin
            blnSintetiza := True;

            If blnSintetiza And (fCfgSis('DESFIN', VarBoolean)) Then
            Begin
              blnSintetiza := False;
            End;

            If blnSintetiza And (fatVenda.fTotalDuplicataQuitada(qryGenDor.FieldByName('FDO_NUMDOC').AsString,
                                                                 qryGenDor.FieldByName('FDO_ESPDOC').AsString,
                                                                 qryGenDor.FieldByName('FDO_CODEMP').AsString, '') > 0) Then
            Begin
              blnSintetiza := False;
            End;

            If blnSintetiza And (TAdiantamento.fGetTotaisAdiantamento(qryGenDor.FieldByName('FDO_NUMDOC').AsString,
                                                                      qryGenDor.FieldByName('FDO_ESPDOC').AsString,
                                                                      qryGenDor.FieldByName('FDO_CODEMP').AsString).fltValLan > 0) Then
            Begin
              blnSintetiza := False;
            End;

            If blnSintetiza Then
            Begin
              blnSintetiza := fatVenda.fSomaNaTemporaria(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                                         qryGenDor.FieldByName('FDO_DESCRI').AsString,
                                                         qryGenDor.FieldByName('FDO_NUMLOT').AsString,
                                                         qryGenDor.FieldByName('FDO_UNITAR').AsFloat,
                                                         qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                                         qryGenDor.FieldByName('FDO_TOTITE').AsFloat,
                                                         qryGenDor.FieldByName('FDO_TOTCUS').AsFloat,
                                                         qryGenDor.FieldByName('FDO_TOTCU2').AsFloat,
                                                         qryGenDor.FieldByName('FDO_QTDEMB').AsFloat,
                                                         qryGenDor.FieldByName('FDO_PREEMB').AsFloat,
                                                         qryGenIte.FieldByName('ITE_IPISAI').AsFloat,
                                                         recMadeira,'',
                                                         qryGenDor.FieldByName('FDO_CODEMP').AsString);
            End;

          End;
}
          If Not blnSintetiza Then
          Begin
            If qryGenDor.FieldByName('FDO_IDEPRO').AsString <> 'NOR' Then
            Begin
              If Not IsTintaExistente(qryGenDor.FieldByName('FDO_IDEPRO').AsString) Then
              Begin
                Result := False;
                pnlCabecalho.Enabled := True;
                pnlDadosItem.Enabled := True;
                Screen.Cursor        := crDefault;
                Exit;
              End;
            End;

            fltProPreCus := 0;
            fltProPreVen := 0;
            fltProComVar := 0;
            fltProComAta := 0;
            fltProComDis := 0;
            fltQtdDis    := 0;
            fltProDesF07 := 0;

            intPraMedio := fFloatToInt(fCalcMediaPagto(qryGenDor.FieldByName('FDO_CONPAG').AsString));

            strPromocao := qryGenDor.FieldByName('FDO_PROMOC').AsString;

            If fEmptyStr(qryGenDor.FieldByName('TABPRE').AsString) then
              strTabPreIte := strTabPre
            Else
              strTabPreIte := qryGenDor.FieldByName('TABPRE').AsString;

            strCodCndTmp := '';

            If fCfgSis('USACND', varBoolean) Then
            Begin
              strCodCndTmp := qryGenDor.FieldByName('FDO_CODCND').AsString;
            End;

            {*************************************************************************}
            {* Somente deve carregar os dados da promocao, caso o produto estava em  *}
            {* promocao quando o pedido foi feito. Pois ocorre de o produto nao      *}
            {* estar mais em promocao no momento em que vai faturar o mesmo (ex: F11)*}
            {* porem o desconto que nao se aplica a um produto em promocao, sera     *}
            {* aplicado alterando o preco combinado no balcao com o cliente. O mesmo *}
            {* vale para produtos que nao estavam em promocao e agora estao, nao deve*}
            {* retirar o desconto que foi concedido ao cliente.                      *}
            {**********************************************************************JC*}
            If (fatVenda.fFilialPromocao) And (strPromocao = 'S') Then
            Begin
              If Not (fRetornaPrecosPromocao(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                             fatVenda.strCodCli,
                                             VS_Date,
                                             qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                             0,
                                             0,
                                             intPraMedio,
                                             fltProPreCus,
                                             fltProPreVen,
                                             fltProComVar,
                                             fltProComAta,
                                             fltProComDis,
                                             fltQtdDis,
                                             fltProDesF07,
                                             fatVenda.strComPro,
                                             fatVenda.strCodPro,
                                             blnParticiona,
                                             blnPromo,
                                             strTabPreIte,
                                             strCodCndTmp,
                                             '',
                                             '',
                                             True,
                                             False,
                                             '-1',
                                             ((qryGenDor.FieldByName('FDO_ENTRET').AsString = 'E') And (qryGenDor.FieldByName('FDO_ENTFUT').AsString = 'N')),
                                             ((qryGenDor.FieldByName('FDO_ENTRET').AsString = 'E') And (qryGenDor.FieldByName('FDO_ENTFUT').AsString = 'S')),
                                             qryGenDor.FieldByName('FDO_MOTFUT').AsString,
                                             '',
                                             strNumOrc,
                                             strEspOrc,
                                             Nil,
                                             False,
                                             '',
                                             objPromVlrMinTotalProdutos)) Then
              Begin
                fltProComVar := qryGenDor.FieldByName('FDO_PERCOM').AsFloat;
                fltProComAta := qryGenDor.FieldByName('FDO_PERREP').AsFloat;
                fltProComDis := qryGenDor.FieldByName('FDO_PERCOM').AsFloat;
              End;
            End;

            fatVenda.pCarregaValoresCusto(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                          qryGenDor.FieldByName('FDO_CODEMP').AsString,
                                          qryGenDor.FieldByName('FDO_TABPRE').AsString);

            If (fCfgSis('CUSOCP', varString) = 'S') Then
            Begin
              If (qryGenDor.FieldByName('FDO_IDEPRO').AsString = 'NOR') Then
              Begin
                If (fltCusIte <> fatVenda.fRetPreCus(qryGenIte.FieldByName('ITE_PRECUS').AsFloat)) Then
                Begin
                   If (qryGenDor.FieldByName('FDO_PROACA').AsString <> 'S') And
                      (Pos('ITEM ESPECIAL', qryGenIte.FieldByName('ITE_DESITE').AsString) <= 0) And
                      (fCfgSis('MCAT17', varString) = 'N') And
                      (fltProPreCus = 0) Then
                  Begin
                    fltCusIte := fatVenda.fRetPreCus(qryGenIte.FieldByName('ITE_PRECUS').AsFloat);
                  End;
                End;
              End;
            End;

            recForTin.intModDil   := IfNull(qryGenDor.FieldByName('FOR_MODDIL').Value, 0);
            recForTin.strTextBase := IfNull(qryGenDor.FieldByName('FOR_TEXBAS').Value, '');
            recForTin.strTipCor   := IfNull(qryGenDor.FieldByName('FOR_TIPCOR').Value, '');
            recForTin.strCompB    := IfNull(qryGenDor.FieldByName('FOR_ITECOB').Value, '');
            recForTin.strUniver   := IfNull(qryGenDor.FieldByName('FOR_UNIVER').Value, '');
            recForTin.strCatali   := IfNull(qryGenDor.FieldByName('FOR_CATALI').Value, '');

            If fatVenda.fUtilizaPrecoSubItensEstrutura(Pos('ITEM ESPECIAL', qryGenDor.FieldByName('FDO_DESCRI').AsString) > 0,
                                                       qryGenDor.FieldByName('FDO_CODITE').AsString) Then
            Begin
              impSubIteEst.strCodIte := qryGenDor.FieldByName('FDO_CODITE').AsString;
              impSubIteEst.strEmpIte := qryGenDor.FieldByName('FDO_EMPITE').AsString;
              impSubIteEst.fltUniPai := qryGenDor.FieldByName('FDO_UNITAR').AsFloat;
              impSubIteEst.fltQtdPai := qryGenDor.FieldByName('FDO_QTDITE').AsFloat;

              fatVenda.pRetImpostosSubItensEstrutura(impSubIteEst);
              fltOutValIte := impSubIteEst.fltOutVal;
              fltDesOpeIte := impSubIteEst.fltDesOpe;
              fltIcmSaiIte := impSubIteEst.fltIcmSai;
              fltImpFedIte := impSubIteEst.fltImpFed;

              fltItePreVe1 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','1',fatVenda.fltMargem);
              fltItePreVe2 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','2',fatVenda.fltMargem);
              fltItePreVe3 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','3',fatVenda.fltMargem);
              fltItePreVe4 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','4',fatVenda.fltMargem);
              fltItePreVe5 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','5',fatVenda.fltMargem);
              fltItePreVe6 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','6',fatVenda.fltMargem);
              fltItePreVe7 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,qryGenDor.FieldByName('FDO_CODITE').AsString,qryGenDor.FieldByName('FDO_EMPITE').AsString,'S','7',fatVenda.fltMargem);
            End
            Else
            Begin
              fltOutValIte := fatVenda.fRetOutVal(qryGenIte.FieldByName('ITE_OUTVAL').AsFloat);
              fltDesOpeIte := fatVenda.fRetDesOpe(qryGenIte.FieldByName('ITE_DESOPE').AsFloat);
              fltIcmSaiIte := fatVenda.fRetIcmSai(qryGenIte.FieldByName('ITE_ICMSAI').AsFloat);
              fltImpFedIte := fatVenda.fRetImpFed(qryGenIte.FieldByName('ITE_IMPFED').AsFloat);

              fltItePreVe1 := qryGenIte.FieldByName('ITE_PREVE1').AsFloat;
              fltItePreVe2 := qryGenIte.FieldByName('ITE_PREVE2').AsFloat;
              fltItePreVe3 := qryGenIte.FieldByName('ITE_PREVE3').AsFloat;
              fltItePreVe4 := qryGenIte.FieldByName('ITE_PREVE4').AsFloat;
              fltItePreVe5 := qryGenIte.FieldByName('ITE_PREVE5').AsFloat;
              fltItePreVe6 := qryGenIte.FieldByName('ITE_PREVE6').AsFloat;
              fltItePreVe7 := qryGenIte.FieldByName('ITE_PREVE7').AsFloat;
            End;

            fltPesBruTmp := qryGenDor.FieldByName('FDO_TOTPES').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat;
            fltPesLiqTmp := qryGenIte.FieldByName('ITE_PESLIQ').AsFloat;

            If (fatVenda.strEdiPes = 'E') And (blnPesPed) Then
            Begin
              fltPesBruTmp := fFormataFloat(qryGenDor.FieldByName('FDO_TOTPES').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat, 2);
              fltPesLiqTmp := fFormataFloat(qryGenDor.FieldByName('FDO_PESLIQ').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat, 2);
            End;

            If fatVenda.strTipOpe = 'R' Then
              fltUniDigDescontada := qryGenDor.FieldByName('FDO_UNITAR').AsFloat
            Else
              fltUniDigDescontada := qryGenDor.FieldByName('FDO_UNIDIG').AsFloat;

            If Not ((fatVenda.strJurPro = 'N') And (strPromocao = 'S')) Then
            Begin
              If fAplicarTaxaJurosPrecoDigitado Then
              Begin
                fltUniDigDescontada := fltUniDigDescontada + (fltUniDigDescontada * qryGenDor.FieldByName('FDO_TAXJUR').AsFloat / 100.0);
              End;
            End;

            //INICIO
            fltUniDigDescontada := fFormataFloat(fltUniDigDescontada, fatVenda.VS_intDecUni);
            fltUniDigDescontada := fltUniDigDescontada - fatVenda.fRetornaVrDesconto(2, fltUniDigDescontada, qryGenDor.FieldByName('FDO_DESCON').AsFloat);
            fltUniDigDescontada := fFormataFloat(fltUniDigDescontada, fatVenda.fMaxDecUni);
            fltUniDigDescontada := fFormataFloat(fltUniDigDescontada, fatVenda.VS_intDecUni);
            //FIM

            fltComLiq := 0;
            If (fatVenda.blnEmCampanha) And
               (fCfgSis('MARMKP') = '4') Then
            Begin
              fatVenda.objCamGer.objCamDet.fVerificaProdutoCampanha(fatVenda.strCodCli,
                                                                    qryGenDor.FieldByName('FDO_CODITE').AsString,
                                                                    EmptyStr,
                                                                    EmptyStr,
                                                                    0,
                                                                    fltVlrCam,
                                                                    fatVenda.strCodCmg,
                                                                    fltComLiq);
            End;

            fatVenda.objIcStPv.pAdd(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                    fatVenda.fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                                    fatVenda.GetTipAbf(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                                    fatVenda.fUFDestTrib(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                                    qryGenDor.FieldByName('FDO_CODFIS').AsString,
                                    fltImcSTPV,
                                    blnCalcST,
                                    0,
                                    fltComLiq);

            fltFdoItePerDesEmbFec := fatVenda.fGetFdoIte.fRetornarPercentualDescontoEmbalagemFechada(qryGenDor.FieldByName('AUTOINCREM').AsString);
            If (fltFdoItePerDesEmbFec > 0) Then
              fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(qryGenDor.FieldByName('FDO_CODEMP').AsString, qryGenDor.FieldByName('FDO_CODITE').AsString,
                strTabPreIte, '', qryGenDor.FieldByName('FDO_QTDITE').AsFloat, fltFdoItePerDesEmbFec);


            fatVenda.pAdicionaRegistroTemporaria(cdsVenda,
                                                 btnAdicionar,
                                                 qryGenDor.FieldByName('FDO_IDEPRO').AsString,
                                                 qryGenDor.FieldByName('GRU_CODGRU').AsString,
                                                 qryGenDor.FieldByName('FDO_CODITE').AsString,
                                                 qryGenDor.FieldByName('FDO_DESCRI').AsString,
                                                 qryGenDor.FieldByName('FDO_DESCRI').AsString,
                                                 qryGenIte.FieldByName('ITE_DESFAB').AsString,
                                                 qryGenDor.FieldByName('FDO_UNIDAD').AsString,
                                                 qryGenDor.FieldByName('FDO_UNIDAD').AsString,
                                                 qryGenDor.FieldByName('FDO_CODMAR').AsString,
                                                 qryGenDor.FieldByName('FDO_FORITE').AsString,
                                                 qryGenDor.FieldByName('FDO_REFERE').AsString,
                                                 qryGenDor.FieldByName('FDO_UNIORI').AsFloat,
                                                 qryGenDor.FieldByName('FDO_UNIVIS').AsFloat,
                                                 fltUniDigDescontada,
                                                 0.00,
                                                 qryGenDor.FieldByName('FDO_DESCON').AsFloat,
                                                 qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                                 fltUniDigDescontada * qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                                 'S',
                                                 qryGenDor.FieldByName('FDO_TOTCUS').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                                 qryGenDor.FieldByName('FDO_TOTCUS').AsFloat,
                                                 qryGenIte.FieldByName('ITE_COMLUB').AsString,
                                                 qryGenIte.FieldByName('ITE_IPISAI').AsFloat,
                                                 qryGenIte.FieldByName('ITE_DESMAX').AsFloat,
                                                 fltItePreVe1,
                                                 fltItePreVe2,
                                                 fltItePreVe3,
                                                 fltItePreVe4,
                                                 fltItePreVe5,
                                                 fltItePreVe6,
                                                 fltItePreVe7,
                                                 fCalculaPrecoVenda(2, fltCusIte,
                                                                       fltUniDigDescontada,
                                                                       0,
                                                                       fltIcmSaiIte + fatVenda.fAlqDifIcmsPrecoDinamico(qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, qryGenIte.FieldByName('ABF_CODABF').AsString, qryGenDor.FieldByName('FDO_CODFIS').AsString, fltIcmSaiIte),
                                                                       fltImpFedIte,
                                                                       fltDesOpeIte + fatVenda.fltDesOpeCli,
                                                                       fRetornaValCom(qryGenIte.FieldByName('ITE_COMTB' + qryGenDor.FieldByName('FDO_TABPRE').AsString ).AsFloat),
                                                                       fatVenda.VS_strMARMKP,
                                                                       '',
                                                                       -1,
                                                                       fltImcSTPV,
                                                                       blnCalcST,
                                                                       IIF( not fCfgSis('CLPVDI', varBoolean), fatVenda.fGetAlqDifal(qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, qryGenIte.FieldByName('ABF_CODABF').AsString, qryGenDor.FieldByName('FDO_CODFIS').AsString),0),
                                                                       IIF( not fCfgSis('CLPVDI', varBoolean), fatVenda.fGetAlqFcpIcms(qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, qryGenIte.FieldByName('ABF_CODABF').AsString, qryGenDor.FieldByName('FDO_CODFIS').AsString, fltIcmSaiIte, fltUniDigDescontada ),0),
                                                                       fltOutValIte,
                                                                       fatVenda.fRestringirElementosMargem),
                                                 qryGenIte.FieldByName('ITE_SALDOS').AsFloat,
                                                 qryGenDor.FieldByName('ITE_INCPIS').AsString,
