procedure TfrmFatVendas.edtEntregaExit(Sender: TObject);
begin
  inherited;

  If Pos(edtEntrega.Text,'SN') <= 0 Then
  Begin
    fMensagem('ATENÇÃO!', 'A Entrega deve ser "S" ou "N"!', ['&O k']);
    pSetFocus(edtEntrega);
    Exit;
  End

  Else If fatVenda.strEntreg <> edtEntrega.Text Then
  Begin

    If (Not fatVenda.fVerificaEstoqueItens(strOpcDoc)) Then
    Begin
      edtEntrega.Text := fatVenda.strEntreg;
      pVerificaSeEhSaldoMatriz;
      fatVenda.pAtualizaSaldoItens;

      pSetFocus(edtEntrega);
      Exit;
    End
    Else
      fatVenda.strEntreg := edtEntrega.Text;

  End;

  If (edtEntrega.Text = 'S') And fatVenda.fTemEntregaFutura Then
  Begin
    pMensagemOk('Não é possível utilizar Entrega = "S" quando há itens com entrega futura!');
    pSetFocus(edtEntrega);
  End;
end;

procedure TfrmFatVendas.edtEntregaChange(Sender: TObject);
begin
  inherited;
  If (edtEntrega.Text = 'S') Then
  Begin
    If (fEmptyStr(fRetornaClienteFilial(VS_strCodEmp))) Then
    Begin
      fMensagem('ATENÇÃO', 'O cliente filial dessa empresa não está cadastrado!' + #13#10 +
                           'Por favor, verifique no cadastro de empresas!', ['&Ok']);
      edtEntrega.Text := 'N';
    End;
  End;

  pVerificaSeEhSaldoMatriz;
end;

