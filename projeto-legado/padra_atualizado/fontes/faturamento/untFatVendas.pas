  End;
end;

function TfrmFatVendas.fVerificaNoPedidoValorMinimoEmitirNF: Boolean;
begin
  Result := True;

  If (fatVenda.strEspDoc = 'PD') And (fCfgSis('PEDMIN')  = 'S' ) Then
  Begin
    Result := fatVenda.fVerificaValorMinimoEmitirNF(False);
