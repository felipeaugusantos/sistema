                                  'por produto vendido. ' +
                                  'Deseja emitir o documento de brinde?')
    Else
      blnPedeBrindes := fPergunta('Cliente possui direito a brinde por pontos acumulados ' +
                                  'por produto vendido (' + strNumDoc + '-' + strEspDoc + '). ' +
                                  'Deseja emitir o documento de brinde?');

