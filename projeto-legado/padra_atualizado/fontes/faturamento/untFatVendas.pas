function TfrmFatVendas.fRetornaMarkupAntigo(curPreVen, curPreCus, curIcmsVenda, curImpFed, curDesOpe,
                                            curValCom, curDifal, curFcp: Currency):Double;
Begin
  curPrecus := curPrecus + ( curIcmsVenda + curImpFed + curDesOpe + curValCom + curDifal + curFcp );

  If curPrecus <> 0 Then
    Result := ( ( curPreVen / curPrecus ) * 100 ) - 100
  Else
    Result := 0;
End;

