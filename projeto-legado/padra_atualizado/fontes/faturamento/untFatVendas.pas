procedure TfrmFatVendas.pAtualizaMatrizFechamentoComSeriesDigitadas;
  Var
    prcScroll: TprcScroll;
    intIdx: Integer;
begin
  intRecNo := cdsVenda.RecNo;
  pDisableControls(cdsVenda, prcScroll);
  Try
    For intIdx := 0 To Length(fatVenda.arrMatItens) -1 Do
    Begin
      If (fProdutoUsaNumeroDeSerie(fatVenda.arrMatItens[intIdx].strCodIte, fatVenda.arrMatItens[intIdx].strEmpIte)) Then
      Begin
        If (cdsVenda.Locate('AUTOINCREM', fatVenda.arrMatItens[intIdx].intAutInc, [])) Then
          fatVenda.pPreencheMatrizSeriesMatrizFechamento(cdsVenda.FieldByName('ITE_TEMNSE').AsString,
                                                         IfEmptyStr(cdsVenda.FieldByName('ITE_SEQDET').AsString, cdsVenda.FieldByName('AUTOINCREM').AsString),
                                                         fatVenda.arrMatItens[intIdx]);
      End;
    End;
  Finally
    cdsVenda.RecNo := intRecNo;
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

function TfrmFatVendas.fVerificarControleDeSerie: Boolean;
  Var
    strItensSemSerie: String;
    blnPodeTerAltera: Boolean;
begin
  blnPodeTerAltera := False;
  strItensSemSerie := '';
  pValidaItemComSerieInformada(strItensSemSerie);

  If (Not fEmptyStr(strItensSemSerie)) Then
  Begin
    fMensagem('Aviso', 'Há itens com controle de número de série que não contém série informada: '+ strItensSemSerie, ['&Ok']);

    Try
      mnuNumeroSerieItensClick(Self);
    Finally
      blnPodeTerAltera := True;
      strItensSemSerie := '';
      pValidaItemComSerieInformada(strItensSemSerie);
    End;
  End;

  Result := fEmptyStr(strItensSemSerie);

  If (Result) Then
  Begin
    If (fatVenda.objFatSerieItem.cdsSeries.RecordCount > 0) Then
    Begin
      fatVenda.objFatSerieItem.cdsFatSeries.EmptyDataSet;
      fatVenda.objFatSerieItem.cdsFatSeries.Filtered := False;
      pCloneDataSet(fatVenda.objFatSerieItem.cdsFatSeries, fatVenda.objFatSerieItem.cdsSeries);
    End;

    If blnPodeTerAltera Then
      pAtualizaMatrizFechamentoComSeriesDigitadas;
  End;
end;

function TfrmFatVendas.fVerificarDebitosEmAtrasoCliente: Boolean;
begin
  Result := True;

  If fatVenda.blnVerDebAtr Then
    pRemoverTravaLogAvi('DEATR', fatVenda.strNTrava);

  {*****************************************}
  {* VALIDA NOVAMENTE CODIGO DO CLIENTE    *}
  {* POIS PODE TER PASSADO O CAMPO COM TAB *}
  {**************************************MA*}
  If (fatVenda.blnVerDebAtr) And (Pos(strOpcDoc, 'OU_OV_NC_BR_TE_OE_OF_EF_CF_CI_CO_MF_UC_DV_PR_') <= 0) And (Not fatVenda.blnComVal) And
     (Not fatVenda.blnCliFil) And
     (mskCndPag.Visible) And
     (fatVenda.fCfgSisTraMax(strOpcDoc) <> 'N') And
     (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) And
     (Not fatVenda.fDebitoCliente(edtForPag.Text, mskCndPag.Text, 3)) Then
  Begin
    objLiberacao.Clear;

    If fCfgSis('CLIATR', varBoolean) Then
    Begin
      If (fCfgSis('TRFTCR', varString) = '2') And (fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli]) <> '') Then
        objLiberacao.objMsgLibera.pAddTexto('A rede de lojas desse cliente possui débito(s) em atraso!')
      Else If fatVenda.fRetAtrasoMaxCliente(fatVenda.strCodCli) > 0 Then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Esse cliente possui débito(s) em atraso há mais de ' + IntToStr(fatVenda.fRetAtrasoMaxCliente(fatVenda.strCodCli)) + ' dias!');
        TDuplicataAtrasoFaturamento.fCarregaMensagemLiberacao(fatVenda.strCodCli, objLiberacao.objMsgLibera);
      end
      Else
        objLiberacao.objMsgLibera.pAddTexto('Este cliente possui débitos em atraso!');
    End
    Else
    Begin
      If (fCfgSis('TRFTCR', varString) = '2') And (fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli]) <> '') Then
        objLiberacao.objMsgLibera.pAddTexto('A rede de lojas desse cliente possui débito(s) em atraso!')
      Else If fCfgSis('ATRMAX', varInteger) > 0 Then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Esse cliente possui débito(s) em atraso há mais de ' + IntToStr(fCfgSis('ATRMAX', varInteger)) + ' dias!');
        TDuplicataAtrasoFaturamento.fCarregaMensagemLiberacao(fatVenda.strCodCli, objLiberacao.objMsgLibera);
      end
      Else
        objLiberacao.objMsgLibera.pAddTexto('Este cliente possui débitos em atraso!');
    End;

    objLiberacao.strDirAce := 'DEATR';
    objLiberacao.blnTraTel := (fatVenda.fCfgSisTraMax(fatVenda.strOpcDoc) = 'T');
    objLiberacao.strSenLib := fCfgSis('SENMAX');
    objLiberacao.strMsgSen := 'Débito em Atraso';
    objLiberacao.strCodOpe := IIF(fEmptyStr(FatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.strCliente := (fatVenda.strCodCli + '-' + fatVenda.strCliOri);
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    If (fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
    Begin
      If Not (fSomenteAvisaPoisVaiTravarNoFinalVenda('DEATR') And (fatVenda.fCfgSisTraMax(fatVenda.strOpcDoc) = 'T')) Then
        fatVenda.blnVerDebAtr := False;
    End
    Else
    Begin
      fatVenda.blnVerDebAtr := True;
      Exit(False);
    End;
  End;

end;

function TfrmFatVendas.fVerificarEstoqueAntesGravarDocumento(): Boolean;
begin
  Result := True;

  {********************************************************************************}
  {* NO F10 ANTES DE GRAVAR O DOCUMENTO VERIFICA NOVAMENTE O ESTOQUE DOS PRODUTOS *}
  {* OBS: SOLICITADO PELO CLIENTE MATIZ 25/07/2013                                *}
  {***************************************************************************JC***}
  If (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_OU_TE_') > 0) And (Not fatVenda.blnSolicitouEmpresasTE) Then
  Begin
    Try
      pCriarFormularios(TfrmGravando,frmGravandoConfirmaVenda);
      try
        frmGravandoConfirmaVenda.fExecutarAcao := fVerificaEstoqueTodosItens;
        frmGravandoConfirmaVenda.ShowModal;
        Result := frmGravandoConfirmaVenda.blnConfirma;
      finally
        pFreeAndNil(frmGravandoConfirmaVenda);
      end;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message,'[fConfirmaVenda - frmGravando]');
      End;
    End;

    If Not Result Then
    Begin
      Exit;
    End;
  End;

end;

function TfrmFatVendas.fVerificarProdutosRelacionadosCondicaoPagamento(): Boolean;
begin
  Result := True;

  {******************************************************}
  {* TRAVA VENDA DE PRODUTOS QUE NÃO TEM PERMISSÃO PARA *}
  {* SEREM VENDIDOS COM DETERMINADAS CONDIÇÕES DE PAGTO *}
  {***************************************************MM*}
  If (fCfgSis('ITECND', varBoolean)) And
     (fCfgSis('USACND', varBoolean)) And
     (fCfgSis('CNDVEN', varString) = 'F') And
     (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('TRAVA DE PRODUTOS QUE NAO PODEM SER VENDIDOS NA CONDICAO DE PAGAMENTO INFORMADA', alCentro, teAmbos, '', 93);
    objLiberacao.objMsgLibera.pAddSeparador(126);
    objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto'        , fatVenda.FCodCnd + '-' + Copy(fRetDesConPag(fatVenda.FCodCnd),1,73), 17);
    objLiberacao.objMsgLibera.pAddTextoCaption('                 ' , fFormataCondPag(fRetConPag(fatVenda.FCodCnd))                      , 17);
    objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Total Produtos' , FormatFloat('#,##0.00',FVariaveisFechamentoVenda.fltTotTrava)             , 17);
    objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor'          , fRetCodVenDef(edtSenVen.Text)+'-'+Copy(edtNomVen.Text,1,73)        , 17);
    objLiberacao.objMsgLibera.pAddSeparador(126);
    objLiberacao.objMsgLibera.pAddTexto('Os produtos listados abaixo não podem ser vendidos na condicao de pagamento informada.');

    If (fTemProdutoNaoRelacionadoCondPagto(objLiberacao.objMsgLibera, FVariaveisFechamentoVenda.fltTotTrava, fatVenda.FCodCnd)) Then
    Begin
      objLiberacao.strDirAce := 'ITECND';
      objLiberacao.strSenLib := fCfgSis('SENITC');
      objLiberacao.strMsgSen := 'Trava de Produtos que não podem ser vendidos com determinadas Condições de Pagamento';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
      objLiberacao.pInformaNumDocEspDocCodEmp(
                      fatVenda.strNumDoc,
                      fatVenda.strEspDoc,
                      fatVenda.strEmpDoc);

      If (Not objLiberacao.fLibera) Then
      Begin
        Result := False;
        Exit;
      End;
    End;

  End;

end;

function TfrmFatVendas.fVerificarResultadoDigitacaoCondicaoPagamentoFinalVenda(
  fraDigCndPagamento: TfraDigCndPagamento; Var strConPag, strCodCnd, strCodFpg: String;
  Var blnZerTax: Boolean): Boolean;
begin
  Result := fraDigCndPagamento.blnConfirma;

  If (Result) And
     (fCfgSis('LIBCND') = '1') And
     (fCfgSis('USACND', varBoolean)) And
     (fCfgSis('PFLCLI', varBoolean)) And
     (strOpcDoc <> 'EP') Then
  Begin
    If fraDigCndPagamento.qryCadCnd.FieldByName('CND_CODIGO').IsNull Then
    Begin
      fraDigCndPagamento.fExibeAlertaCondicaoNaoPermitida;

      Result := False;
    End;
  End;

  If Result Then
  Begin
    strConPag := fraDigCndPagamento.mskCndPag.Text;
    strCodCnd := fraDigCndPagamento.edtCodCnd.Text;
    strCodFpg := fraDigCndPagamento.edtForPag.Text;
    blnZerTax := fraDigCndPagamento.chkZerTax.Checked;
    fatVenda.blnZerTax := blnZerTax;
    fatVenda.intPrzMed := fFloatToInt(fCalcMediaPagto(strConPag));
    if fraDigCndPagamento.blnRecalculaPrecos then
    Begin
      pRecalculaPrecos(False,
                       True,
                       False,
                       False,
                       '',
                       False,
                       False,
                       False,
                       False,
                       True);
    end;

    If (Not fEmptyStr(fatVenda.strNumOrc)) And
       (fEmptyStr(Self.strCodigPagAoAbrir)) And
       (Not fEmptyStr(fraDigCndPagamento.strCodigPagAoAbrir)) And
       (fraDigCndPagamento.edtCodCnd.Text <> fraDigCndPagamento.strCodigPagAoAbrir) Then
    Begin
      Self.strCodigPagAoAbrir := fraDigCndPagamento.strCodigPagAoAbrir;
      Self.strCondiPagAoAbrir := fraDigCndPagamento.strCondiPagAoAbrir;
      Self.strFormaPagAoAbrir := fraDigCndPagamento.strFormaPagAoAbrir;
    End;
  End;

  If (Pos(strOpcDoc, 'PD_OR_') > 0) And
     (Pos(fraDigCndPagamento.edtForPag.Text, '007_') > 0) And
     fatVenda.VS_blnUsaFpg And Result And
     fCfgSis('SOLCAR', varBoolean) Then
  Begin
    Result := Result And fatVenda.fPedeDadosCartao();
  End
  Else
  Begin
    fatVenda.strCodCar := '';
    fatVenda.intQtdPaC := 0;
  End;

  {Trocou condição de pagamento, solicita senha novamente}
  If (strCodCndAnt <> strCodCnd) Then
    blnSenPrazoMedioMaximoVenda := False;
end;

