procedure TfrmFatVendas.pAtualizaDbGridItens(const blnBeforeInsert, blnEnabledGrid: Boolean);
begin
  If (blnBeforeInsert) Then
  Begin
    dbgItens.Enabled := False;
    If (fEstaNaConsultaTab) Then
      dbgItens.DataSource := Nil
    Else
      dbgItens.Refresh;
  End
  Else
  Begin
    dbgItens.Enabled := blnEnabledGrid;
    If (fEstaNaConsultaTab) Then
      dbgItens.DataSource := dtsVenda;
    dbgItens.Refresh;
  End;
end;

procedure TfrmFatVendas.btnAdicionarClick(Sender: TObject);
  Var
    blnEnabledGrid: Boolean;
    strInfLabelGrid: String;
begin
  blnRecalcValUniEntFut := False;

  blnBtnCancela := True;

  inherited;

  //Ainda esta calculando os impostos
  If intCalculandoImpostos > -1 Then
    Exit;

  if not fPodeAdicionarItem then
    Exit;

  If (Not fValidaSenhaAlteracaoTE) Then
    Exit;

  If edtNumLot.Text = 'GARANTIA' Then
  Begin
    fMensagem('Atenção', 'Não é permitido utilizar o lote "Garantia" no faturamento pois ele é um lote de controle interno da rotina de Garantia.'+#13+
                         'Selecione um lote válido para continuar', ['&OK']);
    Exit;
  End;

  If fAlterandoProduto() And (fItemSelecionadoTemAbastecimentoEmAndamento()) Then
  Begin
    fMensagem('ATENÇÃO!!!','Este produto possui solicitação de abastecimento em andamento e não pode ser alterado. ' + #10+#13 +
                           'Se você deseja aumentar a quantidade do produto, inclua o item novamente. ' + #10+#13 +
                           'Senão, pressione delete sobre o produto no grid e o item pode ser excluído.',['&OK']);
    Exit;
  End;

  If (fAlterandoProduto) And (fCfgSis('ALTVMT', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    If fTravaProdutoNaoPodeTerSeuValorAlterado Then
    Begin
      fMensagem('ATENÇÃO!','Valor informado é menor que o valor autorizado!',['&OK']);
      Exit;
    End;
  End;

  If fAlterandoProduto() And (Not fPermiteAlterarItemFormulacaoBaixada) Then
    Exit;

  If blnEdtQtdIteOnEnterExecutadoMasOnExitNaoExecutado Then
  Begin
    blnEdtQtdIteOnEnterExecutadoMasOnExitNaoExecutado := False;
    edtQtdIte.OnExit(edtQtdIte);
  End;

  If InterlockedIncrement(intConfirmando) = 0 Then
  Begin
    blnEnabledGrid := dbgItens.Enabled;

    Try
      strInfLabelGrid := IIF(fAlterandoProduto, 'Alterando', 'Inserindo') + ' Produto (' + edtDesIte.Text + ')';

      pLabelInformacaoGrid(strInfLabelGrid);

      pAtualizaDbGridItens(True, blnEnabledGrid);

      If (Not fAlterandoProduto) And (fCfgSis('ALTVMT', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
        fatVenda.strNumLib := EmptyStr;

      If (strOpcDoc = 'DV') Or
         (MatchStr(strOpcDoc,['VN','PD','OR']) And (fCfgSis('USACCR', varBoolean)) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL])) Then
        TfrmGravando.fExecutarModal(pAdicionar, 'Aguarde, ' + LeftStr(strInfLabelGrid, 60) + '...', '')
      Else
        pAdicionar;

      if fCfgSis('PROKIT', varBoolean) then
        fCarregarBrindesPromocaoCompostaPorKit;

      {Req: 126003 - Após adicionar desbloqueia caixas}
      If (blnBloqueio_Abastecimento) Then
        pBloqueioAbastecimento(False);

      If (blnBloqueio_ItemCombo) Then
        pBloqueioItemCombo(False);

      if Self.blnAdicionarResult Then
        blnAdicionando := False;

      fatVenda.pFormataDecimaisGrid(nil);

      InterlockedDecrement(intConfirmando);

    Except
      On E: Exception Do
      Begin
        InterlockedDecrement(intConfirmando);
        pMensagensErro(E.Message, '[frmFatVendas.btnAdicionarClick]');
      End;
    End;

    pLabelInformacaoGrid('');

    pAtualizaDbGridItens(False, blnEnabledGrid);

    If (strOpcDoc = 'OR') Then
    Begin
      If Assigned(qryFatGor) Then
      Begin
        If (MatchStr(qryFatGor.FieldByName('FGO_STSDEP').AsString, ['APROVADO', 'NÃO APROVADO', 'EM ANÁLISE'])) Then
          blnReanalizarSistemaDEPS := True;
      End;
    End;
  End
  Else
    InterlockedDecrement(intConfirmando);

  blnRecalcValUniEntFut := True;
  blnBtnCancela := False;
  blnLibQtdeMultVenda := False;

  TProQtdColetiva.strRshTinAtual := '';
End;

procedure TfrmFatVendas.pAdicionar;
  Var
    LfrmAguarde: TfrmGravando;
begin
  Try
    Try
      pCriarFormularios(TfrmGravando, LfrmAguarde);
      LfrmAguarde.fExecutarAcao := fAdicionar;
      LfrmAguarde.ShowModal;
      blnAdicionarResult := LfrmAguarde.blnConfirma;
      If LfrmAguarde.blnConfirma Then
      Begin
        pZeraVariaveisPigmento();
        pFechaVendeItem;
      End;

    Finally
      pFreeAndNil(LfrmAguarde);
    End;

  Except
    On E: ExceptionAutCom Do
    Begin
      pMensagemOk(E.Message);
    End;

    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '');
    End;
  End;

end;

function TfrmFatVendas.fAbreTelaFechamentoConcreto: Boolean;
begin

  Result := False;

  If (strOpcDoc = 'VN') And fatVenda.fEhVendaConcreto And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
    Exit(True);

  If (Pos(strOpcDoc, 'PD_VN_') > 0) And fatVenda.fEhVendaConcreto And MatchStr(fCfgSis('TPNFCR'),[J_A_MASSA_CONCRETO]) Then
    Exit(True);

end;

function TfrmFatVendas.fInsereItemAgregado(const blnAlterandoProduto: Boolean; const strCodIte: String): Boolean;
  Var
    strCodIteAgregado : String;
begin
  Result := False;

  If (Not FUsaProdutosAgregados) Then
    Exit;

  If (Pos(strOpcDoc, 'DV_PR_') > 0) Then
    Exit;

  If (blnItemAgregado) Then
    Exit;

  If (blnAlterandoProduto) Then
    Exit;

  If (blnInserindoCombo) Then
    Exit;

  strCodIteAgregado := Trim(fCampoTabela('AGR_CODITE', 'CADAGR', ['AGR_CODITE'], [strCodIte], False));

  If (fEmptyStr(strCodIteAgregado)) Then
    Exit;

  Result := True;
end;

function TfrmFatVendas.fTravarDestino(const blnApenasAjusta: Boolean=False): Boolean;
  Var
    strMsgDes,
    strCodEmp: String;
begin
  Result := False;

  strCodEmp := IfEmptyStr(edtCodEmp.Text, VS_strCodEmp);
  Try
    {Somente Retira}
    If (Not Result) And
       (Not fPermiteInserirSomenteItemRetira(edtCodIte.Text,
                                             strCodEmp,
                                             strOpcDoc,
                                             cmbEntRet.ItemIndex = IDX_RETIRA)) Then
    Begin
      If blnApenasAjusta Then
      Begin
        cmbEntRet.ItemIndex := IDX_RETIRA;
      End
      Else
      Begin
        Result    := True;
        strMsgDes := 'Retira';
      End;
    End;

    {Somente Entrega}
    If (Not Result) And
       (Not fPermiteInserirSomenteItemEntrega(edtCodIte.Text,
                                              strCodEmp,
                                              strOpcDoc,
                                              cmbEntRet.ItemIndex = IDX_ENTREGA)) Then
    Begin
      If blnApenasAjusta Then
      Begin
        cmbEntRet.ItemIndex := IDX_ENTREGA;
      End
      Else
      Begin
        Result    := True;
        strMsgDes := 'Entrega';
      End;
    End;

  Finally
    If Result Then
    Begin
      If cmbEntRet.Enabled And cmbEntRet.Visible Then
        pSetFocus(cmbEntRet)
      Else
        pSetFocus(edtCodIte);

      FatVenda.pMostraMensagem('Atenção!', 'Item '+edtCodIte.Text+' só é permitido ser '+
                               IfThen(fAlterandoProduto, 'alterado', 'incluído')+' como '+strMsgDes+'!', edtCodIte.Text);
    End;
  End;
end;

function TfrmFatVendas.fAdicionar(pgbStatus: TcxProgressBar = Nil): Boolean;
  Const
    MAX_PROGRESSO: Integer = 25;
    CNS_REFUNTDEF: Double = -999.9999;
  Var
    intEtapa       : Integer;
    fltQtdPendAlmox: Double;
    fltQtdDigitada : Double;
    blnAltera      : Boolean;
    blnResult      : Boolean;
    blnAltTodos    : Boolean;
    blnDupIte      : Boolean;
    fltValor       : Double;
    fltMltVen      : Double;
    fltMltCom      : Double;
    fltUniTmp      : Double;
    fltSaldos      : Double;
    strEmpPrd      : String;
    strPergun      : String;
    stlColorantes  : TStringList;
    intRecNo       : Integer;
    blnPediuSenha  : Boolean;
    blnOrdProBaixad: Boolean;
    blnItemTemQueTerEstoqueValidado: Boolean;
    strSubItensSemEst: String;
    strTmpDoc,
    strTmpEsp,
    strTmpEmp : String;
    blnProducaoForaLoja: Boolean;
    strTmpIdePro : String;
    strMltVen : String;
    fltUnitarBkp      : Double;
    strEmpTmp: String;
    strCliConGrid: String;
    strTpOperGrid: String;
    strCliConDevo: String;
    strTpOperDevo: String;
    objMsgSubItensSemEst: TMensagemLiberacao;
    cdsTintaInf: TUniClientDataSet;
    intContador: integer;
    fltQtdItensOU: Double;
    strNumSer: string;
    strIteRep: String;
    intDecQtd: Integer;
    intUltimoAutIncItem: Integer;
    objItensEstrutura : TItensEstrutura;
    fltEstoqueTotalEmpresasPrioridade : Double;

    function fZerarValorBrindeDV: Boolean;
    begin
      Result := blnInserindoBrindeDV;
      If (Not fEmptyStr(fRetComplementoStrClaDevBrinde(strOpcDoc))) Then
        Result := False;
    end;

    function fJaEstaNoGrid(strCodIte: String): Boolean;
    Var
      cdsDados : TUniClientDataSet;
    begin
      strIteRep := '';

      cdsDados := TUniClientDataSet.Create(Nil);
      Try
        pCloneDataSet(cdsDados, cdsVenda);
        cdsDados.Filtered := False;
        cdsDados.Filter := '(ITE_CODITE = ' + QuotedStr(strCodIte) + ') AND (ITE_ITETIN = ' + QuotedStr(IIF(fEmptyStr(strIteTin), '', strIteTin)) + ')';
        cdsDados.Filtered := True;

        Result := Not cdsDados.IsEmpty;

        If Result Then
        Begin
          strIteRep := 'Nº' + cdsDados.FieldByName('ITE_ORDITE').AsString + ' - ' +
                              cdsDados.FieldByName('ITE_CODITE').AsString + ' - ' +
                              cdsDados.FieldByName('ITE_DESITE').AsString + ' - ' +
                              IIF(fEmptyStr(cdsDados.FieldByName('ITE_ITETIN').AsString), '[NORMAL]', '[TINTA]');
        End;
      Finally
        FreeAndNil(cdsDados);
      End;
    End;

    function fExcedeLimiteItensNFe: Boolean;
      Var
        strInformacao: String;
    begin
      With fatVenda Do
      Begin
        If (Pos(strOpcDoc, 'PD_OR_VN_CP_') <= 0) Then
          Result := fUltrapassouLimiteItensNFe(cdsVenda.RecordCount + 1, '', strInformacao)
        Else
        Begin
          If (Not fUltrapassouLimiteItensNFe(cdsVenda.RecordCount + 1, '', strInformacao)) Then
          Begin
            Result := False;
            Exit;
          End;

          strInformacao := EmptyStr;

          If cmbEntRet.ItemIndex = IDX_RETIRA Then
            Result := fUltrapassouLimiteItensNFe(fGetQtdItensCdsVenda(fGetFiltroRetira) + 1, 'Retira', strInformacao)

          Else If cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA Then
            Result := fUltrapassouLimiteItensNFe(fGetQtdItensCdsVenda(fGetFiltroEntregaImediata) + 1, 'Entrega Imediata', strInformacao)

          Else
            Result := fUltrapassouLimiteItensNFe(fGetQtdItensCdsVenda(fGetFiltroEntregaFutura) + 1, 'Entrega Futura', strInformacao);
        End;

        If Result Then
          pMensagemSonora(strInformacao);
      End;
    end;

  Function fValorSuperiorAoUnitarioMaximo : Boolean;
    Var
      fltVlrFtr,
      fltFator : Double;
  Begin
    Result   := True;
    fltFator := fCfgSis('FTPRVE', varDouble);

    If (fltFator > 0) Then
    Begin
      fltVlrFtr := fatVenda.fltUniOri * fltFator;

      If (fltUniDig > fltVlrFtr) Then
        Result := False;
    End;
  End;

  function fedtQtdIte: TEditFocus;
  begin
    If (blnUtilizaVendaVidro Or blnUtilizaVendaMadeira) And (pnlQtdMadeira.Visible) And (pnlQtdMadeira.Enabled) And
       ((edtQtdPec.Visible) And (edtQtdPec.Enabled) And (Not edtQtdPec.ReadOnly)) Then
      Result := edtQtdPec
    Else
      Result := edtQtdIte;
  end;

  function fQuandoCarregarSubItensRatearValorSugerido: Boolean;
  begin
    Result := (fCfgSis('RATEST', varString) = 'S') Or (fCfgSis('RATEST', varString) = 'C') Or (fatVenda.strPromoc = 'S');
  end;

  procedure pVerificaSeEstruturaFoiAlteradaERecalculaPrecos;
  begin

    If objEstruturaPersonalizada.blnEstruturaFoiPersonalizada Then
    Begin

      objItensEstrutura := TItensEstrutura.Create;
      objItensEstrutura.pSetObjEsttruturaPersonalizada(objEstruturaPersonalizada);

      Try
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                      fatVenda.fCalculaPrecoEstrutura(False,
                                                                      Preco_de_Venda,
                                                                      fCodItem,
                                                                      fRetEmpresaItem,
                                                                      'S',
                                                                      IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                                      fStrToFloat(edtMargem.Text),
                                                                      1,
                                                                      objItensEstrutura));
      Finally
        FreeAndNil(objItensEstrutura);
      End;

      fltUniDig          := fStrToFloat(edtUnitar.Text);
      fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
      fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);
      pCalculaTotIte;

    End;

  end;

begin

  Result := False;

  intDecQtd := fCfgSis('DECQTD', varInteger);
  intUltimoAutIncItem := -1;

  fltUnitarBkp := CNS_REFUNTDEF;
  Try
    intEtapa := 0;

    pInformacao('Aguarde, Validando dados do produto...', pgbStatus);
    pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

    If (Not fEmptyStr(edtCodEmp.Text)) and (not fEmpresaExiste(edtCodEmp.Text)) Then
    Begin
      FatVenda.pMostraMensagem('ATENÇÃO!', 'A empresa não foi informada corretamente. Verifique!', edtCodIte.Text);
      Exit;
    end;

    If fEstaNaConsultaTab And (fatVenda.strIdePro = 'NOR') Then
      pCalculaImpostosNaConsultaTab;

    strTmpDoc := '';
    strTmpEsp := '';
    strTmpEmp := '';
    blnAltera := fAlterandoProduto;
    blnDupIte := False;

    pVerificaSeDevolucaoEhDestinadaAColetaDeProdutosPorGarantia;

    strMltVen := fRetornaSeTravaAvisaSolicitaSenhaMultiploVenda;

    If Not fVerificaAcessoPermissaoUtilizacaoLotesRastreaveis Then
    Begin
      btnCancelaItem.Click;
      Exit;
    End;

    If (Not blnAltera) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Length(TProQtdColetiva.ArrItemPro) > 0) And (Not fGridVendaVazio) Then
    Begin
      If (Not fEmptyStr(TProQtdColetiva.fGetCodPro(edtCodIte.Text))) And fJaEstaNoGrid(edtCodIte.Text) And (fEhPromocaoTabIte) Then
      Begin
        FatVenda.pMostraMensagem('Atenção','Não é possível a inclusão repetida de itens em "Promoção Coletiva" exceto, se forem de tipos diferentes (Item Normal + Item Tinta)!'+#10#13+
                                           'Se necessário, altere a quantidade do item:'+#10#13+strIteRep+#10#13+'já incluído neste documento.', edtCodIte.Text);
        btnCancelaItem.Click;
        Exit;
      End;
    End;

    If (Not blnAltera) And fatVenda.blnFromOrdemProducao Then
    Begin
      FatVenda.pMostraMensagem('','Não é permitido incluir itens em pedidos com ordem de produção vinculada!', edtCodIte.Text);
      btnCancelaItem.Click;
      Exit;
    End;

    If Assigned(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
    Begin
      If TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
      Begin
        FatVenda.pMostraMensagem('ATENÇÃO', 'Não é permitido incluir/alterar itens de uma venda com o Pix já recebido.', edtCodIte.Text);
        Exit;
      End;
    End;

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin

      If (fCfgSis('LOCRET', varString) = 'S') And
         (fCfgSis('EMPFAT', varString) = 'S') And
         (fCfgSis('ENT_CD', varString) = 'S') Then
      Begin
        If (pnlEntrega.Visible) And (cmbEntRet.Visible) And
           (cmbEntRet.Enabled) And (cmbEntRet.Text = 'RETIRA') And
           (pnlLocRet.Visible) And (cmbLocRet.Visible) And
           (cmbLocRet.Enabled) And (cmbLocRet.Text = 'CAIXA') And
           (pnlEmpresa.Visible) And (edtCodEmp.Visible) And
           (edtCodEmp.Enabled) And (edtCodEmp.Text <> VS_strCodEmp) Then
        Begin
          FatVenda.pMostraMensagem('','O destino do item não pode ser RETIRA - CAIXA na operação multi-lojas. Favor utilizar RETIRA - EXPEDIÇÃO ou ENTREGA - IMEDIATA!', edtCodIte.Text);
          pSetFocus(cmbEntRet);
          Exit;
        End;

      End;

      If (chkPegou.Visible) And (chkPegou.Checked) And (pnlItemLote.Visible) And
         (Pos('Lote', lblNumLot.Caption) > 0) And (edtNumLot.Text = 'A DEFINIR') Then
      Begin
        FatVenda.pMostraMensagem('','O lote não pode ser A DEFINIR quando o item estiver marcado como já pegou!', edtCodIte.Text);

        If (edtNumLot.ReadOnly) Then
        Begin
          pSetFocus(chkPegou);
        End
        Else
        Begin
          pSetFocus(edtNumLot);
        End;

        Exit;
      End;

      {Valida Condição de Pagamento/Destino}
      If fCfgSis('RETENT',varBoolean) Then
      Begin
        If (fCfgSis('CNDVEN') = 'I') And (fCfgSis('USACND') = 'S') And (pnlEntrega.Visible) Then
          If Not fControleRetiraEntregaPorCndPagto(edtCodCnd.Text) Then
          Begin
            btnCancelaItem.Click;
            Exit;
          End;
      End;

      {Validação se Avisa ou Trava Destino caso o item tenha "Entrega Futura pendente"}
      If (pnlEntrega.Visible) Then
      Begin
        If Not fControleDestino(fCodItem,
                                IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                edtCodCli.Text) Then
        Begin
          btnCancelaItem.Click;
          Exit;
        End;
      End;

      {Verificar direito de acesso ao vender (OR/PD/VN) em entega futura?}
      if (fEhOrcamentoPedido(strOpcDoc)) then
      Begin
        If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then
        Begin
          If Not fVerificaDireitoAcessoVendaFuturaOR_PD_VN(strOpcDoc, fatVenda.strEspDoc) Then
          Begin
            btnCancelaItem.Click;
            Exit;
          End;
        End;
      End;

      If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then
      Begin
        If(chkBrinde.Visible) And (chkBrinde.Checked) Then
        Begin
          FatVenda.pMostraMensagem('', 'Não é permitido selecionar brinde para um produto que seja entrega futura!', edtCodIte.Text);
          btnCancelaItem.Click;
          Exit;
        End;
      End

    End;

    If blnConEqu And (btnAdicionar.Tag = 0) And (edtCodIte.Text <> fCfgSis('ITECON', VarString)) Then
    Begin
      FatVenda.pMostraMensagem('', 'Só é possível informar o item ' + fCfgSis('ITECON', VarString) + '-' +
                                   fRetNomProduto(fCfgSis('ITECON', VarString)) + ' para este tipo de operação!', edtCodIte.Text);
      btnCancelaItem.Click;
      Exit;
    End;

    If (fCfgSis('IMPLST', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin
      If (fRetEmpresaItem <> VS_strCodEmp) Then
      Begin
        If (fCampoTabela('ITE_IMPLIS', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [edtCodIte.text, fRetEmpresaItem]) = 'N') Then
        Begin
          FatVenda.pMostraMensagem('Atenção', 'Item não permitido para empresa informada!', edtCodIte.Text);
          btnCancelaItem.Click;
          Exit;
        End;
      End
      Else
      Begin
        If (fCampoTabela('ITE_IMPLIS', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [edtCodIte.text, VS_strCodEmp]) = 'N') Then
        Begin
          If Not fVerificaAcessoSistema('PRODIMPLIST') Then
          Begin
            If Not fValidaAcessoProdImpLista Then
              Exit;
          End;
        End;
      End;
    End;

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (pnlEntrega.Visible) And
       (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then
    Begin
      If (fCfgSis('ENTDEF', varBoolean)) And (pnlItemLote.Visible) And (edtNumLot.Text <> 'A DEFINIR') Then
      Begin
        Result := False;
        FatVenda.pMostraMensagem('', fatVenda.objCadLot.strTitLab + ' informado é inválido quando se trata de Entrega Futura, utilizar "A DEFINIR"!', edtCodIte.Text);
        pSetFocus(edtNumLot);
        Exit;
      End
      Else If (blnAltera) And fTemComboComItemBrinde(cdsVenda.FieldByName('ITE_SEQCOM').AsInteger) Then
      Begin
        Result := False;
        FatVenda.pMostraMensagem('', 'Não é permitido alterar venda de combo para Entrega Futura pois o mesmo possui brinde em sua composição!', edtCodIte.Text);
        pSetFocus(cmbTipEnt);
        Exit;
      End
    End;

    If (strOpcDoc = 'TE') And
       (fCfgSis('NUMSER', varString) = 'S') And
       (fCfgSis('BLNSTE', varString) = 'S') And
       (fProdutoComControleDeNumeroDeSerie(edtCodIte.Text)) Then
    Begin
      FatVenda.pMostraMensagem('', 'Produto com controle de número de série, sistema configurado para obrigar incluir o produto em um pedido para realizar expedição!', edtCodIte.Text);
      btnCancelaItem.Click;
      Exit;
    End;

    If (Not blnAltera) And (edtNumLot.Visible) And (fatVenda.blnCliFil) And
       (fUsaRotinaWMS(VS_strCodEmp)) And (fCfgSis('LOTDIF', varString) = 'N') And fProdutoRastreavel(edtCodIte.Text) Then
    Begin
      If fExisteLotesDistintosParaUmMesmoItem(edtCodIte.Text, edtNumLot.Text) Then
      Begin
        FatVenda.pMostraMensagem('Atenção',' Não é permitido inserir o mesmo produto com lotes diferentes'+#13+
                                           ' para cliente filial quando estiver utilizando rotina de WMS.', edtCodIte.Text);
        btnCancelaItem.Click;
        Exit;
      End;
    End;

    If (Not blnAltera) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
        objPromVlrMinTotalProdutos.fPossuiItensPromocaoVlrMinimo And
       (Not fGridVendaVazio) And (fCfgSis('UTIVMP', varString) = 'S') Then
    Begin
      If (Not fEmptyStr(objPromVlrMinTotalProdutos.fGetCodPro(edtCodIte.Text))) And
          fJaEstaNoGrid(edtCodIte.Text) And (fEhPromocaoTabIte) Then
      Begin
        FatVenda.pMostraMensagem('Atenção','Não é possível a inclusão repetida de itens em "Promoção por valor mínimo do total dos produtos" exceto, se forem de tipos diferentes (Item Normal + Item Tinta)!'+#10#13+
                                           'Se necessário, altere a quantidade do item:'+#10#13+strIteRep+#10#13+'já incluído neste documento.', edtCodIte.Text);
        btnCancelaItem.Click;
        Exit;
      End;
    End;

    If Not fValidaCampos(edtDiaEnt, True) Then
      Exit;

    intRecNo := cdsVenda.RecNo;

    strQtdIte := edtQtdIte.Text;

    strLibEstComSenha := 'N';//Liberou sem estoque mediante senha

    strTmpIdePro := fatVenda.strIdePro;

    If (strOpcDoc = 'TR') And (fatVenda.strIdePro <> 'NOR') And (cmbEntSai.Text[1] = 'E') Then
    Begin
      fMensagem('ATENÇÃO!','Não é permitido realizar uma entrada de Troca de uma Tinta de Máquina. ' + #13#10 +
                           'Utilizar a rotina de Devolução!',['&OK']);
      btnCancelaItem.Click;
      Exit;
    End;

    If (Pos(strOpcDoc, 'DV_PR_') > 0) And (fatVenda.blnDevolucaoCompleta) Then
    Begin

      If (fatVenda.blnDevRap) Then
      Begin

        fatVenda.blnFecharForm := fFecharFatVendas_DevolucaoRapida;
        Self.Repaint;

        btnCancelaItem.Click;
        Exit;

      End
      Else
      Begin
        fMensagem('ATENÇÃO!','Não é permitido incluir/alterar produtos!',['&O K']);
        btnCancelaItem.Click;
        Exit;
      End;

    End;

    strEmpTmp := IfThen(fatVenda.blnEmpFat,
                        IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                        VS_strCodEmp);

    If (Not blnAltera) And (Pos(strOpcDoc, 'VN_OR_PD_') > 0) And (Not fPermiteFazerVenda(edtCodIte.Text, strEmpTmp)) Then
    Begin
      FatVenda.pMostraMensagem('', MSG_TRAVA_PRECO_VENDA_DINAMICA, edtCodIte.Text);
      btnCancelaItem.Click;
      Exit;
    End;


    If (btnAdicionar.Tag = 0)                         And
       (Pos(strOpcDoc, 'VN_OR_PD_') > 0)              And
       (fCfgSis('TRVAFO') = '1')                      And
       (Not fValidaItensVencidos(fRetDtaValProduto(edtCodIte.Text, strEmpTmp),
                                 edtCodite.Text,
                                 edtDesIte.Text,
                                 fRetNomMarcaItem(edtCodite.Text),
                                 edtSigla.Text,
                                 fStrToFloat(edtSalDis.Text),
                                 fStrToFloat(edtQtdIte.Text),
                                 fStrToFloat(edtUnitar.Text),
                                 fStrToFloat(edtTotIte.Text),
                                 fatVenda.fltUniOri)) Then
    Begin
      btnCancelaItem.Click;
      Exit;
    End;

    If fTravaExclusaoAlteracaoDoItemExpedido(cdsVenda.FieldByName('ITE_ENTRET').AsString, cdsVenda.FieldByName('ITE_ENTFUT').AsString) Then
    Begin
      FatVenda.pMostraMensagem('ATENÇÃO!','Não é permitido alterar este produto, pois o mesmo já possui quantidade expedida!', edtCodIte.Text);
      btnCancelaItem.Click;
      Exit;
    End;

    If (fAlterandoProduto) And
       (cdsVenda.FieldByName('ITE_SEQINC').AsInteger > 0) And (Not fEmptyStr(strNumOrc)) And
       (fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fCfgSis('DECQTD', VarInteger)) <>
        fFormataFloat(fStrToFloat(edtQtdIte.Text), fCfgSis('DECQTD', VarInteger))) Then
    Begin
      //Verifica se existem itens que sairam do almoxarifado e não voltaram (somente autocenter)
      fltQtdPendAlmox := fQuantidadeItensPendenteAlmoxarifeAutocenter(strNumOrc, strEspOrc, strEmpOrc,
                                                                      cdsVenda.FieldByName('ITE_SEQINC').AsInteger);

      If fFormataFloat(fltQtdPendAlmox, fCfgSis('DECQTD', VarInteger)) >
         fFormataFloat(fStrToFloat(edtQtdIte.Text), fCfgSis('DECQTD', VarInteger)) Then
      Begin
        FatVenda.pMostraMensagem('', 'A quantidade do produto não pode ser menor que a quantidade de '+
                                     'itens que saíram do almoxarifado e não voltaram (' +
                                     FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), fltQtdPendAlmox) + '), ' +
                                     'é preciso efetuar a conferência de entrada dos itens para poder alterar a quantidade do mesmo!', edtCodIte.Text);
        btnCancelaItem.Click;
        Exit;
      End;

      If fTemProdutosAguardandoConferenciaAlmoxarifado(strNumOrc, strEspOrc, strEmpOrc, 'E',
                                                       cdsVenda.FieldByName('ITE_SEQINC').AsInteger) Then
      Begin
        FatVenda.pMostraMensagem('', 'Existe quantidade pendente deste produto para conferência de entrada no almoxarifado. ' +
                                     'É preciso efetuar a conferência de entrada dos itens para poder alterar a quantidade do mesmo!', edtCodIte.Text);
        btnCancelaItem.Click;
        Exit;
      End;
    End;

    If (fAlterandoProduto) And
       (fFormataFloat(fStrToFloat(edtQtdIte.Text), fCfgSis('DECQTD', VarInteger)) <
        fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fCfgSis('DECQTD', VarInteger))) And
       (Not fPodeExcluirItemRequsicaoCompra(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                            fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fCfgSis('DECQTD', VarInteger)) -
                                            fFormataFloat(fStrToFloat(edtQtdIte.Text), fCfgSis('DECQTD', VarInteger)))) Then
    Begin
      btnCancelaItem.Click;
      Exit;
    End;

    If (fAlterandoProduto) And
       (Not fPodeAlterarItemOutroVendedor(fatVenda.strCodVen, cdsVenda.FieldByName('ITE_CODVEN').AsString)) Then
    Begin
      btnCancelaItem.Click;
      Exit;
    End;

    {* PRÉ ROMANEIO *}
    If (btnAdicionar.Tag <= 0) And
       (strOpcDoc = 'PD') And
       (strEspOrc = 'PD') And
       (fCfgSis('USPRRO',varString) = 'S') And
       (fPDEmPreRomaneio(strNumOrc, strEspOrc, edtCodCli.Text, strEmpOrc)) Then
    Begin
      fMensagem('ATENÇÃO!','Este pedido está inserido em um Pré-Romaneio!' + #13 +
                           'Não é permitida a inclusão de novos produtos', ['&O k']);
      btnCancelaItem.Click;
      Exit;
    End;

    If (btnAdicionar.Tag <= 0) And fExcedeLimiteItensNFe Then
    Begin
      btnCancelaItem.Click;
      Exit;
    End;

    If (fAlterandoProduto) And (not fValidaPodeAlterarItemComRequisicao) Then
    Begin
      btnCancelaItem.Click;
      Exit;
    End;

    If (Not fatVenda.fLiberaTravaTipoMovimento(fatVenda.fRetornaTipoMovimento(cmbEntRet.ItemIndex, cmbTipEnt.ItemIndex), edtCodEmp.Text, edtCodIte.Text, edtDesIte.Text, fStrToFloat(edtQtdIte.Text), btnAdicionar.Tag)) Then
    Begin
      Exit;
    End;

    If ((fatVenda.blnMeiaNota) Or (fatVenda.blnComVal)) And (btnAdicionar.Tag <= 0) Then
    Begin
      fMensagem('', 'Não é permitido adicionar itens!', ['&Ok']);
      Exit;
    End;

    If (fTravarDestino) Then
      Exit;

    If (fatVenda.fltUniOri <= 0) And (Not blnInserindoBrindeDV) Then
    Begin
      If (strOpcDoc = 'NE') And (fatVenda.opcItensNFEspecialTinta <> opcVazio) Then
      Begin
        fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);
        fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
        fatVenda.fltTaxJur := 0;
        fatVenda.fltVal_RT := 0;
      End
      Else
      Begin
        FatVenda.pMostraMensagem('', 'Esse produto está com o preço de venda Zerado!' + #13#10 +
                            'Favor corrigir.', edtCodIte.Text);
      Exit;
    End;
    End;

    If fCfgSis('CUSESP', varBoolean) Then
    Begin

      If (fatVenda.fltPreCus <= 0) Then
      Begin
        FatVenda.pMostraMensagem('', 'A Esse produto está com o preço de custo Zerado!' + #13#10 +
                            'Favor corrigir.', edtCodIte.Text);
        Exit;
      End;

    End
    Else
    Begin
      If fCfgSis('MMIIES', varDouble) <= 0 Then
      Begin
        FatVenda.pMostraMensagem('', 'A Margem mínima para item especial está Zerada!' + #13#10 +
                            'Favor corrigir.', edtCodIte.Text);
        Exit;
      End;
    End;

    If (Not fEmptyStr(edtNumLot.Text)) And
       (Not fatVenda.fEhEmissaoDocumentoWMS) And
       (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
       (Pos(strOpcDoc, 'DV_PR_MF_') <= 0) And
       (SameText(edtNumLot.Text,'A DEFINIR')) And
       (Not fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS()) And
       (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then  //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
    Begin
      If Pos(strOpcDoc,'OF_CS_') > 0 Then
        fMensagem('', fatVenda.objCadLot.strTitLab + ' informado é inválido para esse tipo de documento!!', ['&Ok'])
      Else
        FatVenda.pMostraMensagem('', fatVenda.objCadLot.strTitLab + ' informado é inválido quando não se trata de Entrega Futura!!', edtCodIte.Text);
      pSetFocus(edtNumLot);
      Exit;
    End;

    {** CASO ESTIVER USANDO A ROTINA WMS, NÃO PERMITIR A INFORMAÇÃO DO LOTE "A DEFINIR", EXCETO PARA ENTREGA FUTURA}
    If (Not fEmptyStr(edtNumLot.Text)) And
       ((fUsaRotinaWMS(VS_strCodEmp)) Or (fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text))) And
       (Pos(strOpcDoc, 'VN_')> 0) And
       (SameText(edtNumLot.Text,'A DEFINIR')) And
       (Not fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS()) And
       (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
    Begin
      fMensagem('', fatVenda.objCadLot.strTitLab + ' informado é inválido quando não se trata de Entrega Futura!!', ['&Ok']);
      pSetFocus(edtNumLot);
      Exit;
    End;

    {** CASO ESTIVER USANDO A ROTINA WMS, NÃO PERMITIR INFORMAR O LOTE DIRETO, EXCETO PARA ENTREGA IMEDIATA}
    If (Not fEmptyStr(edtNumLot.Text)) And
       ((fUsaRotinaWMS(VS_strCodEmp)) Or (fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text))) And
       (Pos(strOpcDoc, 'VN_')> 0) And
       (Not SameText(edtNumLot.Text,'A DEFINIR')) And
       (Not fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS()) And
       (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then
    Begin
      fMensagem('', fatVenda.objCadLot.strTitLab + ' informado para Entrega Futura deve ser sempre A DEFINIR!', ['&Ok']);
      pSetFocus(edtNumLot);
      Exit;
    End;

    If (fClienteConsumidor(fatVenda.strCliOri, False, True)) And
       (chkEntCD.Checked) And (fCfgSis('CON_CD', varString) = 'N') Then
    Begin
      FatVenda.pMostraMensagem('','Sistema configurado para não permitir utilizar entrega pelo CD para ' +
                                  'cliente consumidor. Por favor, desmarque a opção de entrega pelo CD!', edtCodIte.Text);
      pSetFocus(chkEntCD);
      Exit;
    End;

    If Not fVerificaSePodeInserirItemConcreto Then
      Exit;

    If Not fEmptyStr(edtCodIte.Text) And
       Not fInformarMecanicos(strMecanicos, blnAltTodos) Then
    Begin
      Exit;
    End;

    If (fInsereProdutoAtivacaoConformeElementosDoComboDeVenda) Then
    Begin
      Exit;
    End;

    If (fOperacaoVaiDeixarValorVendaMenorQueDescontoEspecial) Then
    Begin
      Exit;
    End;

    {********************************}
    {* TRAVA A QUANTIDADE EM 999999 *}
    {*****************************TS*}
    If (fCfgSis('VENVID', varString) = 'N') And
       (fCfgSis('VENMAD', varString) = 'N') Then
    Begin
      If (fStrToFloat(edtQtdIte.Text) > 999999) Then
      Begin
        FatVenda.pMostraMensagem('ATENÇÃO!', 'Quantidade não permitida.', edtCodIte.Text);
        edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 0);
        pSetFocus(edtQtdIte);
        Exit;
      End;
    End;

    recDuplicaItem.fltDesCon := fStrToFloat(edtDesCon.Text);
    recDuplicaItem.fltUnitar := fStrToFloat(edtUnitar.Text);

    fltUniTmp := fStrToFloat(edtUnitar.Text);

    If Pos(strOpcDoc, 'DV_PR_') <= 0 Then
    Begin

      fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                    qryConIte.FieldByName('ITE_CODEMP').AsString,
                                    fTabelaPrecoItem);

      pCalculaPrecoCusto(qryConIte, fltUniTmp {fStrToFloat(edtUnitar.Text)}, fatVenda.fRetPreCus(fatVenda.fltCusIte),
                         (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0),
                         fEhItemVendaVidro(qryConIte.FieldByName('ITE_CODITE').AsString),
                         IIf(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte), fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)));
    End;



    pInformacao('Aguarde, Validando dados da venda...', pgbStatus);
    pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

    blnValidaNaoCompra := False;

    If (fHabilitaRotinaRemessaOrdemServico(True)) Or (fVerificaCamposInterna) Then
    Begin
      If fAlterandoProduto Then
        cdsVenda.Locate('AUTOINCREM', btnAdicionar.Tag,[]);//para garantir que esta posicionado no registro sendo alterado

      fltUnitarBkp := fStrToFloat(edtUnitar.Text);

      If fatVenda.fltPreVe1 = 0 Then
        fatVenda.fltPreVe1 := qryConIte.FieldByName('ITE_PREVE1').AsFloat;

      If fatVenda.fltPreVe2 = 0 Then
        fatVenda.fltPreVe2 := qryConIte.FieldByName('ITE_PREVE2').AsFloat;

      If fatVenda.fltPreVe3 = 0 Then
        fatVenda.fltPreVe3 := qryConIte.FieldByName('ITE_PREVE3').AsFloat;

      If fatVenda.fltPreVe4 = 0 Then
        fatVenda.fltPreVe4 := qryConIte.FieldByName('ITE_PREVE4').AsFloat;

      If fatVenda.fltPreVe5 = 0 Then
        fatVenda.fltPreVe5 := qryConIte.FieldByName('ITE_PREVE5').AsFloat;

      If fatVenda.fltPreVe6 = 0 Then
        fatVenda.fltPreVe6 := qryConIte.FieldByName('ITE_PREVE6').AsFloat;

      If fatVenda.fltPreVe7 = 0 Then
        fatVenda.fltPreVe7 := qryConIte.FieldByName('ITE_PREVE7').AsFloat;

      If chkBrinde.Visible Then
      Begin
         If Not fPedeDadosBrinde(chkBrinde.Checked, strCodPar, strTipBri) Then
          Exit;
      End
      Else If (Not blnInserindoBrindeDV) Then
        chkBrinde.Checked := False;

      If (chkBrinde.Visible And chkBrinde.Checked) Or (fZerarValorBrindeDV) Then
      Begin
        If (fPermiteBrindeComValorZero) And (Not ((strOpcDoc = 'VN') And (fCfgSis('SUG_BR') = '1') And (fatVenda.strIdePro <> 'NOR'))) Then
          edtUnitar.Text := '0,00';
        edtDesCon.Text := FormatFloat(fMskDigitos(intDecDes), 0);
      End;

      If Not fValidaCampos(cmbMotEntFut) Then
        Exit;

      If Not fValidaCampos(mskDtaEnt) Then
        Exit;

      If Not fValidaCampos(edtCodEmp) Then
        Exit;

      If Not fValidaCampos(cbTabPrecoItem) Then
        Exit;

      If (fatVenda.fDocumentoParaFornecedor) Or (strOpcDoc = 'TE') And (pnlItemLote.Visible) Then
      Begin
        blnValidaAcimaDaCapacidadeMax:= True;
        If Not fValidaCampos(edtQtdIte) Then
        Begin
          blnValidaAcimaDaCapacidadeMax:= False;
          Exit;
        End;
      End;

      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
      If blnUtilizaVendaMadeira Then
      Begin
        pInformacao('Aguarde, Calculando aparelhamento/beneficiamento...', pgbStatus);
        pAtualizaUnitarioAparelBenefi;
      End;

      {****************************************}
      {* ESTA FUNÇÃO FOI COLOCADA AQUI POR    *}
      {* CAUSA DA VARIAVEL STRSTATUS QUE EH   *}
      {* CARREGADA NESTA FUNÇÃO E FICA ERRADO *}
      {* DEPOIS DE PASSAR PELO VALIDA CAMPOS. *}
      {*************************************AF*}
      fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem, 'S', fStrToFloat(edtMargem.Text), False, 'NOR', fTabelaPrecoItem);

      If (fatVenda.blnVerDebAtr) Then
        pRemoverTravaLogAvi('DEATR', fatVenda.strNTrava);

      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
      If (fatVenda.blnVerDebAtr) And
         (Not fatVenda.blnCliFil) And
         (mskCndPag.Visible) And
         (fatVenda.fCfgSisTraMax(strOpcDoc) <> 'N') And
         (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) And
         (Not fatVenda.fDebitoCliente(edtForPag.Text, mskCndPag.Text, 3)) Then
      Begin
        pInformacao('Aguarde, Verificando débitos em atraso do cliente...', pgbStatus);

        objLiberacao.Clear;

        If fCfgSis('CLIATR', varBoolean) Then
        Begin
          If (fCfgSis('TRFTCR', varString) = '2') And (fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli]) <> '') Then
            objLiberacao.objMsgLibera.pAddTexto('A rede de lojas desse cliente possui débito(s) em atraso!')
          Else If fatVenda.fRetAtrasoMaxCliente(fatVenda.strCodCli) > 0 Then
          begin
            objLiberacao.objMsgLibera.pAddTexto('Esse cliente possui débito(s) em atraso há mais de ' + IntToStr(fatVenda.fRetAtrasoMaxCliente(fatVenda.strCodCli)) + ' dias!');
            TDuplicataAtrasoFaturamento.fCarregaMensagemLiberacao(fatVenda.strCodCli, objLiberacao.objMsgLibera);
          end
          Else
            objLiberacao.objMsgLibera.pAddTexto('Este cliente possui débitos em atraso!');
        End
        Else
        Begin
          If (fCfgSis('TRFTCR', varString) = '2') And (fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli]) <> '') Then
            objLiberacao.objMsgLibera.pAddTexto('A rede de lojas desse cliente possui débito(s) em atraso!')
          Else If fCfgSis('ATRMAX', varInteger) > 0 Then
          begin
            objLiberacao.objMsgLibera.pAddTexto('Esse cliente possui débito(s) em atraso há mais de ' + IntToStr(fCfgSis('ATRMAX', varInteger)) + ' dias!');
            TDuplicataAtrasoFaturamento.fCarregaMensagemLiberacao(fatVenda.strCodCli, objLiberacao.objMsgLibera);
          end
          Else
            objLiberacao.objMsgLibera.pAddTexto('Este cliente possui débitos em atraso!');
        End;

        objLiberacao.strDirAce := 'DEATR';
        objLiberacao.blnTraTel := (fatVenda.fCfgSisTraMax(fatVenda.strOpcDoc) = 'T');
        objLiberacao.strSenLib := fCfgSis('SENMAX');
        objLiberacao.strMsgSen := 'Débito em Atraso';
        objLiberacao.strCodOpe := IIF(fEmptyStr(fatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
        objLiberacao.strCodDig := fatVenda.strCodDig;
        objLiberacao.strCliente := (fatVenda.strCodCli + '-' + fatVenda.strCliOri);
        objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

        If (fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
          fatVenda.blnVerDebAtr := False
        Else
        Begin
          fatVenda.blnVerDebAtr := True;
          Exit;
        End;

      End;

      pInformacao('Aguarde, Validando produto...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If (fEmptyStr(edtCodIte.Text)) Then
      Begin
        pSetFocus(edtCodIte);
        Exit;
      End;

      {*****************************************}
      {* CASO NÃO TENHA CARREGADO O ITEM       *}
      {**************************************MV*}
      If (fEmptyStr(edtDesIte.Text)) Then
      Begin
        If (Not fValidaCampos(edtCodIte, True)) Then
          Exit;
      End;

      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
      If (pnlQtdMadeira.Visible) And (Not blnUtilizaVendaMetroLinear) Then
      Begin
        pInformacao('Aguarde, Validando dados madeira...', pgbStatus);

        If Not (fValidaCampos(edtQtdPec, True)  And
                fValidaCampos(edtComPec, True)  And
                fValidaCampos(edtLarPec, True)  And
                fValidaCampos(edtEspPec, True)) Then
        Begin
          Exit;
        End;
      End;

      pInformacao('Aguarde, Validando múltiplo de ' + IIF(fValidaMultiploCompra, 'compra', 'venda') + '...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If (fValidaMultiploCompra) Then
      Begin

        If fStrToFloat(fedtQtdIte.Text) < qryConCit.FieldByName('ITE_MLTCOM').AsFloat Then
        Begin

          If Not SameValue(fStrToFloat(fedtQtdIte.Text), fStrToFloat(edtSaldis.Text)) Then
          Begin
            FatVenda.pMostraMensagem('','A quantidade deve ser igual ou múltiplo (Compra) de: ' + FloatToStrF(qryConCit.FieldByName('ITE_MLTCOM').AsFloat, ffNumber, 12, 3), edtCodIte.Text);
            fedtQtdIte.Text := FloatToStrF(qryConCit.FieldByName('ITE_MLTCOM').AsFloat, ffNumber, 12, fCfgSis('DECQTD', varInteger));
            pSetFocus(fedtQtdIte);
            Exit;
          End;

        End
        Else
        Begin

          fltValor := fFormataFloatInterna(fStrToFloat(fedtQtdIte.Text) / qryConCit.FieldByName('ITE_MLTCOM').AsFloat, fCfgSis('DECQTD', varInteger));

          If (fltValor - Int(fltValor)) > 0 Then
          Begin
            If Not SameValue(fStrToFloat(fedtQtdIte.Text), fStrToFloat(edtSaldis.Text)) Then
            Begin

              FatVenda.pMostraMensagem('','A quantidade deve ser igual ou múltiplo (Compra) de: ' + FloatToStrF(qryConCit.FieldByName('ITE_MLTCOM').AsFloat, ffNumber, 12, 3), edtCodIte.Text);

              fltValor  := fStrToFloat(fedtQtdIte.Text);
              fltMltCom := qryConCit.FieldByName('ITE_MLTCOM').AsFloat;
              fltValor  := Int( ( ( fltValor + fltMltCom ) / fltMltCom ) ) * fltMltCom;
              fedtQtdIte.Text := FloatToStrF(fltValor, ffNumber, 12, fCfgSis('DECQTD', varInteger));

              pSetFocus(fedtQtdIte);
              Exit;

            End;
          End;

        End;

      End

      Else

      {*******************************************}
      {* VERIFICA MULTIPLO DE VENDA              *}
      {****************************************AF*}
      //SENMTP
      If (qryConCit.FieldByName('ITE_MLTVEN').AsFloat > 0) And (Not fDesconsideraMultiploVenda(cdsVenda.FieldByName('ITE_NFESTI').AsInteger)) And
       (Not fNotaFiscalEspiritoSanto) Then
      Begin
        If (fFormataFloat(fStrToFloat(edtQtdIte.Text), 2) < fFormataFloat(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, 2)) Then
        Begin
          If (Pos(strMltVen, '14') > 0) Then // 1-Trava / 4-Solicita Senha
          Begin
            If Not fPermiteVenderSaldoRemanecente(fStrToFloat(fedtQtdIte.Text)) Then
            Begin
              FatVenda.pMostraMensagem('','A quantidade deve ser igual ou múltiplo de: ' + FloatToStrF(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, intDecQtd), edtCodIte.Text);

              If (strMltVen = '4') Then // Solicita Senha
                blnResult := fPedeSenhaMultiploVenda
              Else
                blnResult := False;

              If blnResult Then
                fatVenda.lstItensLiberadosTravaMultiploVenda.fAdd(edtCodIte.Text,
                                                                  fStrToFloat(edtQtdIte.Text),
                                                                  qryConCit.FieldByName('ITE_MLTVEN').AsFloat);

              If (Not blnResult) Then
              Begin
                {*****************************************}
                {* TRAZ COMO SUGESTAO O PROXIMO MULTIPLO *}
                {**************************************JC*}
                fedtQtdIte.Text := FloatToStrF(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, intDecQtd);
                pAtualizaUnitarioSugestaoItemOuLote;
                fltUnitarBkp := fStrToFloat(edtUnitar.Text);

                pSetFocus(fedtQtdIte);

                Exit;
              End;

            End;
          End
          Else If (strMltVen = '3') Then  // Avisa
          Begin
            FatVenda.pMostraMensagem('','A quantidade digitada não é múltiplo de: ' + FloatToStrF(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, intDecQtd), edtCodIte.Text);
          End;

        End
        Else
        Begin
          {****************************************************************************************************************************************************}
          {* ESTOU CHAMANDO A fFormataFloatInterna, pois quando usa SAT ele utiliza a fArredondaABNT_NBR5891_77 que por sua vez gera os seguintes resultados: *}
          {* fArredondaABNT_NBR5891_77(12500, 4) = 12500                                                                                                      *}
          {* fArredondaABNT_NBR5891_77(125000, 4) = 0,0001                                                                                                    *}
          {*************************************************************************************************************************************************RN*}
          fltValor := fFormataFloatInterna(fStrToFloat(fedtQtdIte.Text) / qryConCit.FieldByName('ITE_MLTVEN').AsFloat, intDecQtd);

          If (fltValor - Int(fltValor)) > 0 Then
          Begin
            If (Pos(strMltVen, '14') > 0) Then // 1-Trava / 4-Solicita Senha
            Begin
              If Not fPermiteVenderSaldoRemanecente(fStrToFloat(fedtQtdIte.Text)) Then
              Begin
                FatVenda.pMostraMensagem('','A quantidade deve ser igual ou múltiplo de: ' + FloatToStrF(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, intDecQtd), edtCodIte.Text);

                If (strMltVen = '4') Then // Solicita Senha
                  blnResult := fPedeSenhaMultiploVenda
                Else
                  blnResult := False;

                If blnResult Then
                  fatVenda.lstItensLiberadosTravaMultiploVenda.fAdd(edtCodIte.Text,
                                                                    fStrToFloat(edtQtdIte.Text),
                                                                    qryConCit.FieldByName('ITE_MLTVEN').AsFloat);

                If (Not blnResult) Then
                Begin
                  {*****************************************}
                  {* TRAZ COMO SUGESTAO O PROXIMO MULTIPLO *}
                  {**************************************JC*}
                  fltValor  := fStrToFloat(fedtQtdIte.Text);
                  fltMltVen := qryConCit.FieldByName('ITE_MLTVEN').AsFloat;
                  fltValor  := Int( ( ( fltValor + fltMltVen ) / fltMltVen ) ) * fltMltVen;

                  If (strMltVen = '4') Then
                    fedtQtdIte.Text := FloatToStrF(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, intDecQtd)
                  Else
                    fedtQtdIte.Text := FloatToStrF(fltValor, ffNumber, 12, intDecQtd);

                  pAtualizaUnitarioSugestaoItemOuLote;
                  fltUnitarBkp := fStrToFloat(edtUnitar.Text);

                  pSetFocus(fedtQtdIte);

                  Exit;
                End;
              End;
            End
            Else If (strMltVen = '3') Then // Avisa
            Begin
              FatVenda.pMostraMensagem('','A quantidade digitada não é múltiplo de: ' + FloatToStrF(qryConCit.FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, intDecQtd), edtCodIte.Text);
            End;
          End;
        End;
      End;

      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
      If (Assigned(fTravaQuantidadeTinta)) Then
      Begin
        pInformacao('Aguarde, Verificando trava quantidade tinta...', pgbStatus);

        If (Not fTravaQuantidadeTinta(fatVenda.strIdePro, strTipEmb, intQtdEmb, fStrToFloat(edtQtdIte.Text))) Then
        Begin
          pSetFocus(edtQtdIte);
          fMensagem('ATENÇÃO!', edtQtdIte.Text + ' não é uma quantidade válida!', ['&Ok']);
          Exit;
        End;

      End;

      pInformacao('Aguarde, Verificando produto base/pigmento...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If (Not fValidaProdutoBasePigmento) Then
      Begin
        Exit;
      End;

      pInformacao('Aguarde, Verificando venda de produto tintométrico...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      if (fatVenda.strIdePro <> 'NOR') then
      begin
        if (fCfgSis('TINACA', varBoolean)) And (Not fProdutoAcabadoJaInserido) then
        begin
          if fExisteTintaJaProduzida(
            strIteTin
            , strCatalize
            , strLinTin
            , strTipPre
            , fatVenda.strIdePro
            , fltVolPro) then
          begin
            objLiberacao.Clear;
            objLiberacao.objMsgLibera.pAddTexto('Liberação para venda de produto tintométrico com produto acabado em estoque');

            objLiberacao.strDirAce := 'TINACA';
            objLiberacao.strSenLib := fCfgSis('SENTAC');
            objLiberacao.strMsgSen := 'Venda de produto tintométrico com produto acabado em estoque';
            objLiberacao.strCodOpe := strLoginUsuarioLogado;
            objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

            if not fatVenda.fFatMensagemLiberacao(objLiberacao) then
              Exit;
          end;
        end;
      end;

      pInformacao('Aguarde, Calculando total do produto...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      {**************************************}
      {* ARREDONDA PARA AS CASAS DECIMAIS   *}
      {* CONFIGURADAS                       *}
      {***********************************AF*}
      If (Not fEmptyStr(edtUnitar.Text)) Then
      Begin
        If MatchStr(strOpcDoc, ['DV', 'NE']) Then
          edtUnitar.Text := FloatToStrF(fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.fMaxDecUni), ffFixed, 12, fatVenda.fMaxDecUni)
        else
          edtUnitar.Text := FloatToStrF(fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni), ffFixed, 12, fatVenda.VS_intDecUni);
      End;

      pCalculaTotIte();

      If (fStrToFloat(edtTotIte.Text) < 0.0) Then
      Begin
        pSetFocus(edtQtdIte);
        FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é possivel confirmar um total negativo!', edtCodIte.Text);
        Exit;
      End
      Else If (fStrToFloat(edtTotIte.Text) = 0.0) Then
      Begin
        If (Not fPermiteBrindeComValorZero) And ((Not (chkBrinde.Visible And chkBrinde.Checked)) And (Not blnInserindoBrindeDV)) Then
        Begin
          pSetFocus(edtQtdIte);
          FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é possível confirmar um total Zero!', edtCodIte.Text);
          Exit;
        End;
      End;

      fltUniDig := fStrToFloat(edtUnitar.Text);

      If (Pos(strOpcDoc,'PD_OR_VN_') > 0) And
         (Not fValorSuperiorAoUnitarioMaximo) Then
      Begin
        FatVenda.pMostraMensagem('ATENÇÃO!','O valor digitado está superior ao valor de teto máximo permitido.' + #13 +
                                            'Esta operação não será permitida! Para ajustar esta configuração,' + #13 +
                                            'procure nas configurações do sistema o código CFG_FTPRVE', edtCodIte.Text);
        pSetFocus(edtUnitar);
        Exit;
      End;

      If (fatVenda.stlItensNaoEhEstrutura.IndexOf(fCodItem) = -1) And
         (Not fItemEstrutura(fCodItem)) Then
      Begin
        fatVenda.stlItensNaoEhEstrutura.Add(fCodItem);
      End;

      If (Not blnAltera) Then
      Begin
        blnBaixaSubItemEstrutura  := False;

        If (Not fatVenda.blnCarregandoEstrutura) Then
        Begin
          blnAlterouEstruraOriginal := False;
          intSequencialEstruturaPer := -1;
        End;

      End;

      pInformacao('Aguarde, Verificando produto estrutura...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If (Not blnAltera) And
         (Pos(strOpcDoc,'PD_OR_VN_CS_BR_OU_OF_EF_OV_TE_UC_') > 0) And  // INCLUIDO BAIXA ESTRUTURA OUTRAS SAIDAS, OUTRAS SAIDAS FORN. OUT.SAI.+1 PEDIDO
         (Not fatVenda.blnCarregandoEstrutura) And
         (fatVenda.stlItensNaoEhEstrutura.IndexOf(fCodItem) = -1) And
         (Not (recDuplicaItem.fltQtdPro > 0)) Then
      Begin

        If (objEstruturaPersonalizada.fUsuarioDesejaAlterarEstrutura) Then
          objEstruturaPersonalizada.fCarregarEstruturaOriginalParaPersonalizacao(fCodItem);

        blnAlterouEstruraOriginal := objEstruturaPersonalizada.blnEstruturaFoiPersonalizada;
        intSequencialEstruturaPer := objEstruturaPersonalizada.intSequencialDaEstruturaPersonalizada;

        If fCfgSis('CAREST', varString) = 'R' Then
        Begin

          If qryConCit.FieldByName('ITE_CAREST').AsString = 'S' Then
          Begin
            pCarregaEstrutura(
                               fCodItem,
                               fRetEmpresaItem,
                               fStrToFloat(edtQtdIte.Text),
                               fStrToFloat(edtDesCon.Text),
                               IIF(fQuandoCarregarSubItensRatearValorSugerido, fStrToFloat(edtTotIte.Text), 0),
                               IIF(fQuandoCarregarSubItensRatearValorSugerido, fStrToFloat(edtQtdIte.Text) * fatVenda.fltUniOri, 0)
                             );
            Exit;
          End
          Else
          Begin
            pVerificaSeEstruturaFoiAlteradaERecalculaPrecos;
            blnBaixaSubItemEstrutura := fCfgSis('BXSBIT') <> '1';
          End;

        End
        Else
        If fCfgSis('CAREST', varString) = 'S' Then
        Begin

          If fMensagem('', 'Carregar os itens da estrutura?', ['&S i m', '&N ã o']) = 1 Then
          Begin
            pCarregaEstrutura(
                               fCodItem,
                               fRetEmpresaItem,
                               fStrToFloat(edtQtdIte.Text),
                               fStrToFloat(edtDesCon.Text),
                               IIF(fQuandoCarregarSubItensRatearValorSugerido, fStrToFloat(edtTotIte.Text), 0),
                               IIF(fQuandoCarregarSubItensRatearValorSugerido, fStrToFloat(edtQtdIte.Text) * fatVenda.fltUniOri, 0)
                             );
            Exit;
          End
          Else
          Begin
            pVerificaSeEstruturaFoiAlteradaERecalculaPrecos;
            blnBaixaSubItemEstrutura  := fCfgSis('BXSBIT', varString, fCodEmp) <> '1';
          End;

        End
        Else If fCfgSis('CAREST', varString, fCodEmp) = 'N' Then
        Begin
          pVerificaSeEstruturaFoiAlteradaERecalculaPrecos;
          blnBaixaSubItemEstrutura := fCfgSis('BXSBIT', varString, fCodEmp) <> '1';
        End
        Else If fCfgSis('CAREST', varString, fCodEmp) = 'P' Then
        Begin
          pCarregaEstrutura(
                             fCodItem,
                             fRetEmpresaItem,
                             fStrToFloat(edtQtdIte.Text),
                             fStrToFloat(edtDesCon.Text),
                             IIF((fCfgSis('RATEST', varString) = 'S') Or (fCfgSis('RATEST', varString) = 'C'), fStrToFloat(edtTotIte.Text), 0),
                             IIF((fCfgSis('RATEST', varString) = 'S') Or (fCfgSis('RATEST', varString) = 'C'), fStrToFloat(FloatToStrF(fStrToFloat(edtQtdIte.Text) * fatVenda.fltUniOri, ffFixed, 12, 2)), 0)
                           );
          Exit;
        End;

      End;

      pInformacao('Aguarde, Definindo empresa de produção tinta...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      {*********************************************************************************}
      {* INSERINDO A TINTA NOS ITENS, TEM QUE ESCOLHER A EMPRESA QUE PRODUZIRA A TINTA *}
      {******************************************************************************PH*}
      If (fatVenda.strIdePro <> 'NOR') Then
      Begin
        //Ao mudar aqui verificar a necessidade de mudar ponto com referência REQ.: 182691
        If (edtOprFlj.Text = 'N') And (chkEntCD.Checked) Then
        Begin
          If (fCfgSis('OPRFLJ', varBoolean)) And (edtOprFlj.Visible) Then
            strEmpPrd := fatVenda.strEmp_CD;

          If Assigned(recForTin.Formulas) Then
            recforTin.Formulas.fRecalculaSaldos(fatVenda.strEmp_CD, fStrToFloat(edtQtdIte.Text), fatVenda.strNumOrc, False, IIF(fInformaLoteBaseImobiliaria, edtNumLot.Text, ''));

        End
        Else
        Begin
          If (fatVenda.blnEmpfat) and (edtOprFlj.Text = 'N')Then
            strEmpPrd := edtCodEmp.Text
          Else
          Begin
            If btnAdicionar.Tag = 0 Then
              strEmpPrd := fatVenda.fEscolheEmpresaProducaoTinta(fatVenda.strIdePro)
            Else
              strEmpPrd := '';
          End;

          if Not ((fEntregaFuturaItem = 'S') And (fTravaSaldoEntFutColorante = 'N') And (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR'))Then
          begin
            If Assigned(recForTin.Formulas) Then
              recforTin.Formulas.fRecalculaSaldos(strEmpPrd, fStrToFloat(edtQtdIte.Text), fatVenda.strNumOrc, False, IIF(fInformaLoteBaseImobiliaria, edtNumLot.Text, ''));
          end;
        End;
      End
      Else
        strEmpPrd := '';

      //adicionada a verificacao da quantidade da embalagens para as tintas autmomotivas(darka)
      //foi necessaria essa modificacao pq o campo quantidade foi liberado para as automotivas;
      If (fatVenda.strIdePro <> 'NOR') And (Not fTintaBaixaProduto(fatVenda.strIdePro))    Then
      Begin
        intQtdEmb := fStrToFloat(edtQtdIte.Text);
      End;

      If (fatVenda.strIdePro <> 'NOR') Then
      Begin
        If fTintaDeMaquinaComPrecoDeVendaZerado(strEmpPrd) Then
        Begin
          FatVenda.pMostraMensagem('ATENÇÃO!', 'Não será possível prosseguir, um dos componentes da tinta está com o preço de venda zerado.' + #13 +
                                       'Favor verificar o preço de venda de cada componente da formulação!', edtCodIte.Text);
          pSetFocus(btnAdicionar);
          Exit;
        End;
      End;

      pInformacao('Aguarde, Validando preço unitário do produto...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If not ((Pos(strOpcDoc, 'VN_NE_') > 0) and (blnEhItensEntrada)) Then
      Begin
        cdsTintaInf := Nil;
        Try
          If (fAnalisaTodosCompomentesAoTravarUnitarioDeTintaComoProdutoNormal) Then
          Begin
            If (fatVenda.strIdePro <> 'NOR') Then
            Begin
              cdsTintaInf := fCriaCdsInformacoesTinta(Self);
              pPreencheCdsInformacoesTinta(strEmpPrd, cdsTintaInf);
            End;
          End;

          If (Not fValidaUnitario(fStrToFloat(edtDesCon.Text), cdsTintaInf, pCalculaAliquotasParaMargemAntesAdicionarItem)) Then
            Exit;
        Finally
          If Assigned(cdsTintaInf) Then
            FreeAndNil(cdsTintaInf);
        End;
      End;

      fltSaldoItemEmpCar := 0;
      If strOpcDoc <> 'DV' Then
        strEmpCar := fatVenda.fRetEmpCarregamento(edtCodIte.Text, (fDestinoEntRetItem = 'E'));

      If fatVenda.fEmpCarPreenchidaEmpDif(strEmpCar, VS_strCodEmp) Then
      Begin
        If pnlEntCD.Visible And chkEntCD.Checked Then
        Begin
          FatVenda.pMostraMensagem('', 'O produto '+ edtCodIte.Text +'-'+ edtDesIte.Text +' possui empresa responsável pelo carregamento e entrega definida no cadastro ('+ strEmpCar +').'+
                          sLineBreak + 'Neste caso, não é permitido gerar o pedido com este item como entrega pelo CD.', edtCodIte.Text);
          pSetFocus(chkEntCD);
          Exit;
        End;

        fltSaldoItemEmpCar := fRetSaldosEmpresa(edtCodIte.Text, strEmpCar, edtNumLot.Text);
      End;

      pInformacao('Aguarde, Validando estoque do produto...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If (Pos(strOpcDoc, 'DV_PR_OF_') <= 0) And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
      Begin
        objMsgSubItensSemEst := TMensagemLiberacao.Create(Self);
        try
          try
            blnOrdProBaixad := False;

            {****************************************************************}
            {* QUANDO O SISTEMA ESTIVER CONFIGURADO PARA BAIXAR ESTOQUE DOS *}
            {* SUB-PRODUTOS SOMENTE QUANDO NAO HOUVER ESTOQUE DO PRODUTO    *}
            {* ESTRUTURA, VERIFICA SE OS SUB-PRODUTOS POSSUEM ESTOQUE NECES-*}
            {* SARIO PARA REALIZAR A VENDA...                               *}
            {************************************************************JC**}
            If blnBaixaSubItemEstrutura And ((fCfgSis('BXSBIT', varString, fCodEmp) = '2') Or (fCfgSis('BXSBIT', varString, fCodEmp) = '3')) Then
            Begin
              blnOrdProBaixad := blnAltera And
                                (Not fEmptyStr(cdsVenda.FieldByName('ITE_ORDPRO').AsString)) And
                                  (TOrdPro.fOrdemProducaoBaixada(cdsVenda.FieldByName('ITE_ORDPRO').AsString, VS_strCodEmp));

              fltSaldos := fatVenda.fRetornaSaldoDisponivelItemNormal(edtCodEmp.Text,
                                                                      qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                      edtNumLot.Text,
                                                                      IIF(fAlterandoProduto, intToStr(btnAdicionar.Tag), ''),
                                                                      strCodAca,
                                                                      strEmpAca,
                                                                      fltSaldoItemAtu);
              If (fCfgSis('BXSBIT', varString, fCodEmp) = '3') And
                 (fatVenda.strIdePro = 'NOR') And
                 (fStrToFloat(edtQtdIte.Text) > 0) And
                 (fltSaldos >= fStrToFloat(edtQtdIte.Text)) Then
              Begin
                {**********************************************************************************************}
                {* QUANDO O PRODUTO ESTRUTURA POSSUIR ESTOQUE SUFICIENTE ENTAO DEVE BAIXAR O ESTOQUE DO MESMO *}
                  {*******************************************************************************************JC*}
                  If IIF(blnAltera, fEmptyStr(cdsVenda.FieldByName('ITE_ORDPRO').AsString), True) Then
                    blnBaixaSubItemEstrutura := False;
              End;

              {********************************************************************************************}
              {* CASO NAO VALIDE O ESTOQUE DOS SUB-PRODUTOS ENTAO NAO PERMITE INSERIR O PRODUTO ESTRUTURA *}
              {*****************************************************************************************JC*}
              If blnBaixaSubItemEstrutura And (Not blnOrdProBaixad) Then
              Begin
                If (Not fatVenda.fVerificaQtdEstoqueSubItensEstrutura(strOpcDoc,
                                                                      qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                      IIF(fAlterandoProduto, IntToStr(btnAdicionar.Tag), ''),
                                                                      fStrToFloat(edtQtdIte.Text),
                                                                      True,
                                                                      objMsgSubItensSemEst,
                                                                      blnPediuSenha,
                                                                      True,
                                                                      edtCodEmp.Text,
                                                                      fDestinoEntRetItem,
                                                                      fEntregaFuturaItem,
                                                                      fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                                                      blnAlterouEstruraOriginal,
                                                                      intSequencialEstruturaPer)) Then
                Begin
                  Exit;
                End;

                If Not fEmptyStr(strSubItensSemEst) And blnPediuSenha Then //Liberou sem estoque mediante senha
                Begin
                  strLibEstComSenha := 'S';
                End;
              End;

              {*******************************************}
              {* VARIÁVEL DE CONTROLE PARA DUPLICAR ITEM *}
              {****************************************MM*}
              If (fltSaldos > 0) And
                 (Not blnMetragemObrigatoria) And {Req: 99438 Desviamos o fluxo aqui, pois o sistema nesse
                                                        momento não consegue trabalhar com metragem para gerar OP do excedente.}
                 (IIF(recDuplicaItem.fltQtdPro > 0, recDuplicaItem.fltQtdPro, fStrToFloat(edtQtdIte.Text)) > fltSaldos) Then
              Begin
                blnDupIte := fPergunta('A quantidade informada é maior que a quantidade disponível em estoque. '+#13+
                                       'Solicita ordem de produção para a quantidade excedente?');

                {***************************************************************}
                {* SE FOR DUPLICAR, GUARDA AS INFORMAÇÕES DIGITADAS DO PRODUTO *}
                {************************************************************MM*}
                If (blnDupIte) Then
                Begin
                  recDuplicaItem.strCodIte := qryConIte.FieldByName('ITE_CODITE').AsString;

                  If cbbComple.Visible And (Not fEmptyStr(cbbComple.Text)) Then
                    recDuplicaItem.strComple := cbbComple.Text;

                  recDuplicaItem.fltQtdEst := fltSaldos;
                  recDuplicaItem.fltQtdPro := fStrToFloat(edtQtdIte.Text) - fltSaldos;

                  edtQtdIte.Text := FloatToStrF(recDuplicaItem.fltQtdPro, ffFixed, 12, fCfgSis('DECQTD', varInteger));
                End
                Else
                Begin
                  recDuplicaItem.strCodIte := EmptyStr;
                  recDuplicaItem.strComple := EmptyStr;
                  recDuplicaItem.fltQtdEst := 0.00;
                  recDuplicaItem.fltQtdPro := 0.00;
                  recDuplicaItem.fltDesCon := 0.00;
                  recDuplicaItem.fltUnitar := 0.00;
                End;
              End;
            End

            Else If fEhItemVendaVidro(fCodItem) And Assigned(fatVenda.objEstruturaVidros) Then
            Begin
              If (Not fatVenda.fVerificaQtdEstoqueEstruturaVidro(strOpcDoc,
                                                                 qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                 IIF(fAlterandoProduto, IntToStr(btnAdicionar.Tag), ''),
                                                                 fStrToFloat(edtQtdIte.Text),
                                                                 True,
                                                                 objMsgSubItensSemEst,
                                                                 blnPediuSenha)) Then
              Begin
                Exit;
              End;

              If Not objMsgSubItensSemEst.IsEmpty And blnPediuSenha Then //Liberou sem estoque mediante senha
              Begin
                strLibEstComSenha := 'S';
              End;
            End;

            {*******************************************************************************************}
            {* CASO NAO BAIXE O ESTOQUE DOS SUB-PRODUTOS ENTAO VALIDA O ESTOQUE DO PRODUTO "ESTRUTURA" *}
            {****************************************************************************************JC*}
            {* CASO NÃO TENHA SIDO TRATADO POR NENHUMA REGRA ESPECÍFICA ACIMA, VALIDA O ESTOQUE        *}
            {****************************************************************************************VA*}
            blnItemTemQueTerEstoqueValidado := (Not blnBaixaSubItemEstrutura Or blnOrdProBaixad) And
                                               (Not (fEhItemVendaVidro(fCodItem) And Assigned(fatVenda.objEstruturaVidros)));

            If (blnItemTemQueTerEstoqueValidado) and ((not fUtilizaEmpresaPrioridadeEstoque) or (fUtilizaEmpresaPrioridadeEstoque and (not chkEmpresaPrioridade.Checked))) Then
            Begin
              If MatchStr(strOpcDoc,['VN','PD','OR']) Then
              Begin
                If (fatVenda.strIdePro = 'NOR') Then
                Begin
                  If fatVenda.fItensComSaldoEmProcessamento(fCodItem, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD)) Then
                    Exit(False);
                End;
              End;

              If (Not fVerificaQtdEstoque(fStrToFloat(edtQtdIte.Text))) Then
              Begin
                If (fStrToFloat(edtQtdIte.Text) <= 0.00) Then
                Begin
                  {******************************************************************************}
                  {* CASO NÃO DE ENTER NO CAMPO DE QUANTIDADE E TENTA ADICIONAR CLICANDO DIRETO *}
                  {***************************************************************************VA*}
                  fValidaCampos(edtQtdIte);
                End;  

                Exit;
              End;
            End;

            if (Pos(strOpcDoc, 'PD_OR_') > 0) and (fUtilizaEmpresaPrioridadeEstoque) and (btnAdicionar.Tag = 0) and (chkEmpresaPrioridade.Checked) then
            begin
              if not fValidaEstoqueEmpresaPrioridade(True, fltEstoqueTotalEmpresasPrioridade) then
              begin
                Exit;
              end;
            end;
            
          except
            On E: Exception Do
            Begin
              Result := False;
              pMensagensErro(E.Message,'fAdicionar');
            End;
          end;
        finally
          FreeAndNil(objMsgSubItensSemEst);
        end;

      End
      Else
      Begin
        {******************************************************************************}
        {* DEVE TRAVAR O ESTOQUE MESMO FILTRANDO PELA DATA, CLIENTE: JABU, REQ: 17970 *}
        {****************************************************************06/05/2014*RN*}
        If (strOpcDoc = 'OF') Then // And (Not fatVenda.blnDvComDta)
        Begin
          If (Not fVerificaQtdEstoque(fStrToFloat(edtQtdIte.Text))) Then
            Exit;
        End;

        If (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Or (strOpcDoc <> 'OF') Then
        Begin
          fltQtdDigitada := fRetQtdDigitadaDevolucao;

          If fAlterandoProduto Then
            fltQtdDigitada := fltQtdDigitada - cdsVenda.FieldByName('ITE_QTDITE').AsFloat;

          If (fStrToFloat(edtQtdIte.Text) + fltQtdDigitada > fltQtdDev) Then
          Begin
            fMensagem('', 'Não há quantidade suficiente para devolução!', ['&O k']);
            pSetFocus(edtQtdIte);
            Exit;
          End;

          If fCfgSis('USOREV', varBoolean) Then
          Begin
            strCliConGrid := fRetPrimeiroCliConEntreOsDocsInseridos;
            strTpOperGrid := fRetPrimeiroTpOperEntreOsDocsInseridos;
            strCliConDevo := fRetCliConPeloAutInc(fatVenda.qryTemporaria.FieldByName('DET_TABELA').AsString, fatVenda.qryTemporaria.FieldByName('DET_AUTOIN').AsString);
            strTpOperDevo := fRetTpOperPeloAutInc(fatVenda.qryTemporaria.FieldByName('DET_TABELA').AsString, fatVenda.qryTemporaria.FieldByName('DET_AUTOIN').AsString);

            If (Not fEmptyStr(strCliConGrid)) And (Not fEmptyStr(strCliConDevo)) And (strCliConGrid <> strCliConDevo) Then
            Begin
              If (strCliConGrid = 'S') Then
                fMensagem('','Não é possível devolver em uma mesma operação um documento gravado como Revenda.' + #13#10 +
                             'Já foram selecionados documentos gravados como Uso/Consumo!', ['&Ok'])
              Else
                fMensagem('','Não é possível devolver em uma mesma operação um documento gravado como Uso/Consumo.' + #13#10 +
                             'Já foram selecionados documentos gravados como Revenda!', ['&Ok']);
              Exit;
            End;

            If (fatVenda.strCliCon <> strCliConDevo) Then
            Begin
              fatVenda.strCliCon := strCliConDevo;
              fatVenda.pRedefineTipoAbf;
            End;

            If (Not fEmptyStr(strTpOperGrid)) And (Not fEmptyStr(strTpOperDevo)) And (strTpOperGrid <> strTpOperDevo) Then
            Begin
              fMensagem('','Não é possível devolver um documento com tipo de operações diferentes.' + #13#10 +
                           'USO/CONSUMO, REVENDA e INDUSTRIALIZAÇÃO!', ['&Ok']);
              Exit;
            End;

            If (fatVenda.strTpOper <> strTpOperDevo) Then
            Begin
              fatVenda.strTpOper := strTpOperDevo;
              fatVenda.pRedefineTipoAbf;
            End;
          End;
        End;

        If (fCfgSis('BXSBIT', varString, fCodEmp) = '2') Then
        Begin
          blnBaixaSubItemEstrutura := (Pos(strOpcDoc, 'DV_PR_') > 0) And
                                      (Not fEmptyStr(fatVenda.qryTemporaria.FieldByName('DET_ORDPRO').AsString)) And
                                      (TOrdPro.fOrdemProducaoBaixada(fatVenda.qryTemporaria.FieldByName('DET_ORDPRO').AsString,
                                                                     fatVenda.qryTemporaria.FieldByName('DET_CODEMP').AsString));
        End;
      End;

      If (Pos(strOpcDoc, 'DV_PR_') > 0) And (strIdeDev <> 'NOR') Then
        pInformacao('Aguarde, Definindo tipo de devolução tinta...', pgbStatus)
      Else
        pInformacao('Aguarde, Adicionando produto...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If fUsaRotinaWMS(fatVenda.fEmpresaSaldoMatriz_CD) And (fatVenda.strIdePro <> 'NOR') Then
      Begin
        Try
          stlColorantes := TStringList.Create;
          If Not fatVenda.fValidaLoteEmbalagemColorantesWMS(edtCodIte.Text, fatVenda.strIdePro,
                                                            fatVenda.strCodEmb, fatVenda.fEmpresaSaldoMatriz_CD,
                                                            recForTin.Formulas, fatVenda.objCadLot, stlColorantes) Then
          Begin
            pMensagemSonora('Para vender uma tinta é necessário que todos os Colorantes/Embalagens possuam o ' +
                            '"lote principal para tinta de máquina" informado corretamente no cadastro ' +
                            'de lotes. Favor verificar o cadastro de lotes dos produtos: ' +
                            AnsiReplaceStr(stlColorantes.CommaText, ',', ', '));
            Exit;
          End;
        Finally
          FreeAndNil(stlColorantes);
        End;
      End
      Else If (fCfgSis('TMQLOT', varString) = 'S') And (fatVenda.strIdePro <> 'NOR') Then
      Begin
        If Not fValidaLoteEmbalagemColorantesLocal Then
          Exit;
      End;

      If (Pos(strOpcDoc, 'DV_PR_') > 0) And (strIdeDev <> 'NOR') And (btnAdicionar.Tag = 0) Then
      Begin
        pPegaDocumentoEntregaFutura(strDocDev, strEspDev, strEmpDev,
                                    strTmpDoc, strTmpEsp, strTmpEmp,
                                    fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                    fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString);

{        If (Not fEmptyStr(strTmpDoc)) Then
          blnDocDevBaiEntFut := True;}

        If fEmptyStr(strTmpDoc) Then
        Begin
          strTmpDoc := strDocDev;
          strTmpEsp := strEspDev;
          strTmpEmp := strEmpDev;
        End;

        If fatVenda.fPermiteDevolverTintaMaquina(fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                                 fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString,
                                                 fatVenda.qryTemporaria.FieldByName('DET_NUMDOC').AsString,
                                                 fatVenda.qryTemporaria.FieldByName('DET_ESPDOC').AsString,
                                                 fatVenda.qryTemporaria.FieldByName('DET_CODEMP').AsString,
                                                 fStrToFloat(edtQtdIte.Text)) Then
        Begin
          if ((fCfgSis('ESTFLJ') = 2) And (fCfgSis('USATMQ') = 'S')   And
            (fVerificarTintaBaixaEntFut(strTmpDoc, strTmpEsp, strTmpEmp)) And
            (Pos(fRetornarClaFisDevolucao(strTmpDoc, strTmpEsp, strTmpEmp), '5922_6922_'+CLAFIS_ENTFUT_VEN) > 0)) Then
          begin
            if TinGer.fVerificaTinDetBaixado(strDocDev,
                                             strEmpDev,
                                             strEspDev,
                                             fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                             fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString,
                                             'Os produtos abaixo não podem ser devolvidos como Pigmento/Base pois os mesmos já foram baixados!') then
              Exit;

            blnProducaoForaLoja := TinGer.fProducaoForaLoja(strTmpDoc,
                                                            strTmpEmp,
                                                            strTmpEsp,
                                                            fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                                            fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString);

            If (blnProducaoForaLoja) And (Not TinGer.fVerificaTinDetExiste(strTmpDoc, strTmpEmp, strTmpEsp)) Then
            Begin
              fMensagem('ATENÇÃO', Format('Não é possivel realizar a devolução do documento %s-%s-%s, ' +
                'produto [%s], ' +
                'pois o mesmo é tinta de máquina com produção fora de loja, e a formulação de tinta de máquina foi apagada, ' +
                'fazer a devolução como "PRODUTO ACABADO". ', [fatVenda.qryTemporaria.FieldByName('DET_NUMDOC').AsString, fatVenda.qryTemporaria.FieldByName('DET_ESPDOC').AsString, fatVenda.qryTemporaria.FieldByName('DET_CODEMP').AsString, fatVenda.qryTemporaria.FieldByName('DET_DESCRI').AsString]), ['OK']);
              Exit;
            End;

            if (blnProducaoForaLoja) And (not fatVenda.fIsTintaDisponivelEmpresa(fatVenda.qryTemporaria.FieldByName('DET_IDEPRO').AsString, fatVenda.qryTemporaria.FieldByName('DET_CODEMP').AsString)) then
            begin
              fMensagem('ATENÇÃO', Format('Não é possivel realizar a devolução do produto [%s], ' +
                'pois o mesmo é uma tinta de máquina com produção fora de loja, e a empresa logada [%s] não  possui a tinta [%s] disponível ', [
                fatVenda.qryTemporaria.FieldByName('DET_DESCRI').AsString,
                VS_strCodEmp,
                fRetornaNomeTinta(fatVenda.qryTemporaria.FieldByName('DET_IDEPRO').AsString)]), ['OK']);
              Exit;
            end;

            If fTipoTinta(strIdeDev) = ttAutomotiva Then
              strPergun := Format('Essa modalidade de devolução gravará uma entrada individual das bases no estoque na empresa logada [%s]. Confirma?', [VS_strCodEmp])
            Else
              strPergun := Format('Essa modalidade de devolução gravará uma entrada individual da base e seus colorantes no estoque na empresa logada [%s]. Confirma?', [VS_strCodEmp]);

            If fPergunta(strPergun) Then
              fatVenda.strPigBas := 'S'
            Else
              Exit;

          end
          else
          If fVerificaAcessoSistema('PIGBAS') And
             (fMensagem('', 'Gerar entrada no estoque por:', ['Produto &Acabado', 'Pigmento/&Base'], 1, False, 1, 180) = 2) Then
          Begin

            if (fatVenda.qryTemporaria.FieldByName('DET_PROACA').AsString = 'S')  then
            begin
              fMensagem('ATENÇÃO!',' O Item '+ fatVenda.qryTemporaria.FieldByName('DET_DESCRI').AsString  +' é um produto acabado, portanto não deve ser devolvido como "pigmento/base" !', ['&Ok']);
              exit;
            end;

            if TinGer.fVerificaTinDetBaixado(strDocDev,
                                             strEmpDev,
                                             strEspDev,
                                             fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                             fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString,
                                             'Os produtos abaixo não podem ser devolvidos como Pigmento/Base pois os mesmos já foram baixados!') then
              Exit;

            blnProducaoForaLoja := TinGer.fProducaoForaLoja(strTmpDoc,
                                                            strTmpEmp,
                                                            strTmpEsp,
                                                            fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                                            fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString);

             
            If (blnProducaoForaLoja) Then
            Begin
              fMensagem('ATENÇÃO', 'O documento '+strTmpDoc+'-'+strTmpEsp+'-'+strTmpEmp+' foi feito como produção fora de loja e será produzido na empresa '+
                                   fCampoTabela('DET_EMPPRD', 'TINDET', ['DET_NUMDOC','DET_ESPDOC','DET_CODEMP'], [strTmpDoc, strTmpEsp, strTmpEmp])+
                                   '. Portanto, não é permitido realizar a devolução de "Pigmento/Base" na empresa de emissão '+strTmpEmp+
                                   '. Realize a devolução através da opção "Produto Acabado" se a formulação já foi baixada na loja '+
                                   fCampoTabela('DET_EMPPRD', 'TINDET', ['DET_NUMDOC','DET_ESPDOC','DET_CODEMP'], [strTmpDoc, strTmpEsp, strTmpEmp])+
                                   ' ou, cancele o documento de venda.', ['OK']); 
              exit;                     
            End;

            If fTipoTinta(strIdeDev) = ttAutomotiva Then
              strPergun := Format('Essa modalidade de devolução gravará uma entrada individual das bases no estoque na empresa logada [%s]. Confirma?', [VS_strCodEmp])
            Else
              strPergun := Format('Essa modalidade de devolução gravará uma entrada individual da base e seus colorantes no estoque na empresa logada [%s]. Confirma?', [VS_strCodEmp]);

            If fPergunta(strPergun) Then
              fatVenda.strPigBas := 'S'
            Else
              Exit;
          End
          Else
            fatVenda.strPigBas := 'N';
        End
        Else
        Begin
          fMensagem('ATENÇÃO!', 'Não é permitida a devolução de Tinta de Máquina!', ['&O k']);
          Exit;
        End;

        if fatVenda.strPigBas = 'S' then
        begin
          if TinGer.fVerificaTinDetBaixado(strDocDev,
                                           strEmpDev,
                                           strEspDev,
                                           fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString,
                                           fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString,
                                           'Os produtos abaixo não podem ser devolvidos como Pigmento/Base pois os mesmos já foram baixados!') then
            Exit;

          If (fatVenda.qryTemporaria.FieldByName('DET_PROACA').AsString = 'S') Then
          Begin
            fMensagem('ATENÇÃO!', Format('O produto [%s - %s] é um produto acabado e não pode ser devolvido como pigmento/base!', [
              fatVenda.qryTemporaria.FieldByName('DET_CODITE').AsString, fatVenda.qryTemporaria.FieldByName('DET_DESCRI').AsString]), ['&OK']);
            Exit;
          End;

        end
        Else
        Begin
          If (TinGer.fVerificaTinDetExiste(strTmpDoc, strTmpEmp, strTmpEsp)) And (Not TinGer.fVerificaTinDetBaixado(strDocDev, strEmpDev, strEspDev, fatVenda.qryTemporaria.FieldByName('DET_CODACA').AsString, fatVenda.qryTemporaria.FieldByName('DET_EMPACA').AsString, '')) Then
          begin
            fMensagem('ATENÇÃO!', Format('O produto [%s - %s] não foi baixado portando não pode ser devolvido como [Produto Acabado]!', [
                fatVenda.qryTemporaria.FieldByName('DET_CODITE').AsString, fatVenda.qryTemporaria.FieldByName('DET_DESCRI').AsString]), ['&OK']);
            Exit;
          End;
        End;
      End
      Else fatVenda.strPigBas := 'N';

      if (Pos(strOpcDoc, 'OU_OF_') > 0) and (fCfgSis('NUMSER', varString) = 'S') and (fTemControleNumeroSerieOutrasSaidas(Trim(edtCodIte.Text))) then
      begin
        intContador := 0;
        fltQtdItensOU := fStrToFloat(edtQtdIte.Text,0);

        while intContador < fltQtdItensOU do
        begin
          strNumSer := InputBox('Número de série','Informe o número de série:','');

          if fEmptyStr(strNumSer) then
          begin
            pMensagemOk('Número de série não foi preenchido!');
            btnCancelaItem.Click;
            Exit;
          end;

          if Pos(',' + strNumSer, strTodosNumSer) > 0 then
          begin
            pMensagemOk('Número de série já foi utilizado!');
            btnCancelaItem.Click;
            Exit;
          end;

          if not fExisteNumeroSerie(strNumSer, Trim(edtCodIte.Text)) then
          begin
            pMensagemOk('Número de série não foi localizado para o item: ' + edtQtdIte.Text + ' ou já foi utilizado!');
            btnCancelaItem.Click;
            Exit;
          end
          else
          begin
            strTodosNumSer := strTodosNumSer + ',' + strNumSer;
            strTodosCodIte := strTodosCodIte + ',' + Trim(edtCodIte.Text);
          end;

          Inc(intContador);
        end;
      end;

      If (Pos(strOpcDoc, 'DV_PR_') > 0) And (strIdeDev <> 'NOR') And (btnAdicionar.Tag = 0) Then
        blnProAca := (fatVenda.strPigBas = 'N');

      If (fCfgSis('ORDPRO', varBoolean)) Then
        blnConsMovPro := fTabelaMovProVazia;

      If (strOpcDoc = 'NP') Then
        pDescricaoNotaFiscalEspecial;

      pInformacao('Aguarde, Calculando total do produto...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      pCalculaTotIte(fStrToFloat(edtUnitar.Text));

      pInformacao('Aguarde, ' + IIF(fAlterandoProduto, 'Alterando ', 'Inserindo ') +
                  'Produto (' + LeftStr(edtDesIte.Text, 20) + '...)', pgbStatus);

      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      pAdicionaItem(strEmpPrd);

      intUltimoAutIncItem := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

      If (Not blnAltera) And Assigned(recForTin.Formulas) And (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
      Begin
        pInformacao('Aguarde, ' + IIF(fAlterandoProduto, 'Alterando ', 'Inserindo ') + 'Formulação...', pgbStatus);
        pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
        fatVenda.dicFormulas.AdicionarObjeto(cdsVenda.FieldByName('AUTOINCREM').AsString, recForTin.Formulas);
        If Assigned(fatVenda.objCopiaSegVenda) Then
          fatVenda.objCopiaSegVenda.pAtualizarDadosItem;
      End;

      If (cdsVenda.RecordCount = 1) Then
        fatVenda.intIdxPri := cmbEntRet.ItemIndex;

      pInformacao('Aguarde, Alterando data de entrega dos itens...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If (cmbEntRet.ItemIndex = IDX_ENTREGA) And
         (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) And
         (Not blnInserindoItemPlanilha) Then
      Begin
        dtaEntImediata := strToDateDef(mskDtaEnt.Text,0);
        If (dtaEntImediata > 0) And ((fCfgSis('PDVIME', varString) = 'N') And (fCfgSis('UGPDTE', varString) = 'N') And (Pos(strOpcDoc, 'OR_PD_VN_') > 0)) Then
          pAlteraDataEntregaImediataItens(dtaEntImediata);
      End;

      blnSenAumTro := False;
      blnSenAutOutEnt := False;

      pArmazenaInformacaoItem;

      If (fMostraGridSubItens) Then
      Begin
        pInformacao('Aguarde, Carregando sub-itens concreto...', pgbStatus);
        pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

        pCarregaEstrutura(fCodItem, fRetEmpresaItem, fStrToFloat(edtQtdIte.Text), 0, 0, 0, True);

        pInformacao('Aguarde, Calculando total da venda...', pgbStatus);
        pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

        pCalculaTotais(False, cdsVenda.FieldByName('AUTOINCREM').AsInteger);

        btnCancelaItem.Click;
      End
      Else
      Begin
        pInformacao('Aguarde, Calculando total da venda...', pgbStatus);
        pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

        pCalculaTotais(False, cdsVenda.FieldByName('AUTOINCREM').AsInteger);
        pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
        If (fInsereItemAgregado(blnAltera, qryConCit.FieldByName('ITE_CODITE').AsString)) Then
        Begin
          pInformacao('Aguarde, Inserindo produto agregado...', pgbStatus);
          blnItemAgregado := True;
          btnCancelaItem.Click;
          pInsereItemAgregado(strTmpIdePro);
        End
        Else If (Not blnEhMultiLote) Then
          btnCancelaItem.Click;

        {**********************************************************}
        {* CASO QTDE VENDIDA FOR MAIOR QUE DISPONÍVEL NO ESTOQUE, *}
        {* ADICIONAR 2 ITENS COM MESMO CÓDIGO NA VENDA:           *}
        {*   1- ITEM COM QTDE DISPONÍVEL EM ESTOQUE               *}
        {*   2- ITEM COM QTDE A SER ENVIADA PARA PRODUÇÃO         *}
        {*******************************************************MM*}
        pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);
        If (blnDupIte) Then
        Begin
          pInformacao('Aguarde, Duplicando produto...', pgbStatus);
          pDuplicaItem;
        End;
      End;

      pInformacao('Aguarde, Finalizando ' + IIF(blnAltera, 'alteração ', 'inclusão ') + '...', pgbStatus);
      pProgresso(fInc(intEtapa), MAX_PROGRESSO, pgbStatus);

      If blnAltera Then
      Begin
        cdsVenda.RecNo := intRecNo;
      End;

      pProgresso(MAX_PROGRESSO, MAX_PROGRESSO, pgbStatus);

      Result := True;
    End
    Else
    Begin
      Result := False;

      if not blnBtnCancela then
        btnCancelaItem.Click;
    End;

    edtSigla.Text := '';
    pSetLabelUnidadeMedida;
    blnValidaNaoCompra := True;

    pAdicionaProdutosComboVenda(blnAltera, False, intUltimoAutIncItem);
    pExibirBotaoDescricaoItem('');

    strLoteMenorValidade := '';
    blnLiberadoLoteDifLoteMenorValidade := False;
    blnJaAvisouEntFut := False;

  Finally
    If (Not Result) And (fStrToFloat(edtUnitar.Text) <> 0) And (fltUnitarBkp <> CNS_REFUNTDEF) Then
    Begin
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUnitarBkp);
    End;

    pAtualizaUnitarioLiquido;

    If Assigned(objImpulsionadorVendasCRM) Then
    Begin
      If Result And (objImpulsionadorVendasCRM.blnInserirItemManualmente = True) Then
      Begin
        objImpulsionadorVendasCRM.pAtualizarItemInserido(objImpulsionadorVendasCRM.strCodIteAtu);
        objImpulsionadorVendasCRM.blnInserirItemManualmente := False;
        pCarregarProdutosCrmConsumiveis(True, btnAdicionar);
      End;
    End;
  End;
end;

function TfrmFatVendas.fAgruparItensMesmasCaracteristicasNaEmissaoPedido: Boolean;
begin
  Result := True;
  If (Pos(fatVenda.strEspDoc, 'PD_OR_') > 0) And fatVenda.blnAgrIte Then
  Begin
    Result := fatVenda.fAgruparItensMesmasCaracteristicasPedido;
    If Not Result Then
      Exit;
  End;
end;

function TfrmFatVendas.fAjustaEmpresaPrioridade(var blnMostrouMsg: Boolean): Boolean;
var
  qryPrioridade: TUniQuery;
  objSalLoj: TSaldoLojas;
  fltQtdItePrioridade: Double;
  strCodEmpPrioridade: string;
  fltEstoqueEmpresa: Double;
  recSaldos, recSaldosML: TRecSaldos;
  fltQtdItensEmpPrioridade: Double;
  fltOutValIte,
  fltDesOpeIte,
  fltImpFedIte,
  fltIcmSaiIte: Double;
  strCodSit: string;
  strTabPreTmp: string;
  fltImcSTPV: Double;
  blnCalcST: Boolean;
  recMadeira: TDadosMadeira;
  frmObservacao: TfrmObservacao;
  intContador: integer;
  strEmpresaItemSaida: String;
  blnAplicaPrecoCustoEmpresaFaturamento: Boolean;
  fltPrecoCusto: Double;
  fltPrecoCusto2: Double;

    function fUsaValoresItem: Boolean;
    begin
      If strOpcDoc = 'DV' Then
        Result := False
      Else
        Result := (fatVenda.strIdePro = 'NOR') and (not blnProAca) And
                  (Not fEhItemVendaVidro(fCodItem));
    end;

    function fAlterarItemComboDevolucao : Boolean;
    begin

      Result := False;

      If (Pos(strOpcDoc, 'DV_PR_') > 0) Then
        If (fAlterandoProduto) Then
          If (cdsVendaBkp.FieldByName('ITE_SEQCOM').AsInteger > 0) And (cdsVendaBkp.FieldByName('ITE_ATIVAC').AsString <> 'S') Then
            Exit(True);

    end;

    function fEhProdutoAcabado: Boolean;
    begin
      Result := (fatVenda.strIdePro = 'NOR') and (blnProAca);
    end;

begin
  cdsVenda.DisableConstraints;
  blnRealizouCalculoPrioridade := True;
  pCloneDataSet(cdsVendaBkp, cdsVenda);
  cdsVendaBkp.First;
  qryPrioridade := fCriaQuery;
  objSalLoj := TSaldoLojas.Create(Self);

  blnAplicaPrecoCustoEmpresaFaturamento := False;

  If fFaturamentoComCustoDaEmpresaPrioridade() Then
    blnAplicaPrecoCustoEmpresaFaturamento := True;

  try
    Result := False;
    blnMostrouMsg := False;
    SetLength(arrSaldoEmpPriori, 0);

    while not cdsVendaBkp.Eof do
    begin
      strCodEmpPrioridade := cdsVendaBkp.FieldByName('ITE_EMPITE').AsString;

      if (not fUtilizaEmpresaPrioridade(strCodEmpPrioridade)) or (fCfgSis('SLDPED', varString, strCodEmpPrioridade) <> 'T') then
      begin
        if cdsVenda.Locate('AUTOINCREM', cdsVendaBkp.FieldByName('AUTOINCREM').AsInteger, []) then
        begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_EMPEXP').AsString := strCodEmpPrioridade;
          cdsVenda.Post;
        end;

        cdsVendaBkp.Next;
        Continue;
      end;

      if cdsVenda.Locate('AUTOINCREM', cdsVendaBkp.FieldByName('AUTOINCREM').AsInteger, []) then
        cdsVenda.Delete;

