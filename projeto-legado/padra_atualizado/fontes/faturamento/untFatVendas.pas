  strSQL := strSQL + '  D.DET_DESCRI, ';
  strSQL := strSQL + '  D.DET_UNITAR, ';

  strSQL := strSQL + '  0.00 AS DET_QTDFAT, ';
  strSQL := strSQL + '  0.00 AS DET_VALFAT, ';


  strSQL := strSQL + '  IFNULL(R.CON_DESESP,0.0) AS CON_DESESP, ';
  strSQL := strSQL + '  IFNULL(D.DET_QTDITE,0.0) AS DET_QTDENV, ';
  strSQL := strSQL + '  IFNULL(R.CON_QTDITE,0.0) AS DET_QTFARE, ';
  strSQL := strSQL + '  IFNULL(D.DET_QTDITE,0.0) - IFNULL(R.CON_QTDITE,0.0) AS DET_QTDPEN, ';
  strSQL := strSQL + '  IFNULL(D.DET_UNITAR,0.0) * IFNULL(D.DET_QTDITE,0.0) AS DET_TOTITE, ';
  strSQL := strSQL + '  IFNULL(D.DET_UNITAR,0.0) * (IFNULL(D.DET_QTDITE,0.0) - IFNULL(R.CON_QTDITE,0.0)) AS DET_TOTPEN, ';
  strSQL := strSQL + '  IFNULL(D.DET_UNITAR,0.0) * IFNULL(R.CON_QTDITE,0.0) AS DET_TOTFAT, ';
  strSQL := strSQL + '  D.DET_CODCLI ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVDET D ';
  strSQL := strSQL + '  INNER JOIN CADITE I ON D.DET_CODITE = I.ITE_CODITE ';
  strSQL := strSQL + '  INNER JOIN ITEGER P ON P.ITE_CODITE = D.DET_CODITE ';
  strSQL := strSQL + '  LEFT  JOIN CADUNI U ON I.ITE_CODUNI = U.UNI_CODUNI ';
  strSQL := strSQL + '  LEFT  JOIN (SELECT CON_AUTICS, CON_NUMDOC, CON_ESPDOC, CON_CODEMP, CON_CODITE, SUM(CON_QTDITE) AS CON_QTDITE, SUM(CON_DESESP) AS CON_DESESP ';
  strSQL := strSQL + '              FROM (SELECT CON_AUTICS, CON_NUMDOC, CON_ESPDOC, CON_CODEMP, CON_CODITE, CON_QTDITE, CON_DESESP ';
  strSQL := strSQL + '                      FROM MOVCON ';
  strSQL := strSQL + '                    UNION ALL ';
  strSQL := strSQL + '                    SELECT CON_AUTICS, CON_NUMDOC, CON_ESPDOC, CON_CODEMP, CON_CODITE, CON_QTDITE, CON_DESESP ';

  strSQL := strSQL + '                      FROM NOTCON) AS A GROUP BY CON_AUTICS, CON_NUMDOC, CON_ESPDOC, CON_CODEMP, CON_CODITE ';
  strSQL := strSQL + '              ) AS R ';
  strSQL := strSQL + '               ON R.CON_NUMDOC = D.DET_NUMDOC ';
  strSQL := strSQL + '              AND R.CON_ESPDOC = D.DET_ESPDOC ';
  strSQL := strSQL + '              AND R.CON_CODEMP = D.DET_CODEMP ';
  strSQL := strSQL + '              AND R.CON_CODITE = D.DET_CODITE ';
  strSQL := strSQL + '              AND ((R.CON_AUTICS = D.AUTOINCREM) OR (IFNULL(R.CON_AUTICS, "") = "")) ';
  strSQL := strSQL + 'LEFT JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM  ';

  strSQL := strSQL + 'WHERE ';

  strSQL := strSQL + '  ((D.DET_ESPDOC = "NF" AND ';
  strSQL := strSQL + '    LOCATE(D.DET_CLAFIS,:CLAENV) > 0) OR (D.DET_ESPDOC = "ER")) AND ';

  strSQL := strSQL + ' D.DET_CODCLI = :CODCLI AND ';
  strSQL := strSQL + ' D.DET_CODEMP = :CODEMP AND ';
  strSQL := strSQL + ' P.ITE_CODEMP = :CODEMP ';

  If blnFiltrarCodIte Then
    strSQL := strSQL + ' AND D.DET_CODITE = :CODITE ';

  If blnFiltroDocumento Then
    strSQL := strSQL + ' AND D.DET_NUMDOC = :NUMDOC ';

  strSQL := strSQL + ' ORDER BY D.DET_NUMDOC ';

  Result := strSQL;
end;

function TfrmFatVendas.fProcessarRegraDescontoDeProfissionalPorItem: Boolean;
begin

  Result := False;

  If Not (fCfgSis('CLIDES') = 'S') Then
    Exit;

  If Not (fCfgSis('PEMIFF') = '2') Then
    Exit;

  If Not (fCfgSis('DPDIDE') = '1') Then
    Exit;

  If Not (fCfgSis('APLDES') = 'S') Then
    Exit;

  If Not (fCfgSis('DCVBVL') = 'B') Then
    Exit;

  Result := True;

end;

function TfrmFatVendas.fProcessarRegraDescontoDeProfissionalPorItem_PermiteAlterarDesconto: Boolean;
  var
    LDescontoDoProfissional : Double;
begin

  Result := False;

  If fatVenda.strCodCli.IsEmpty Then
    Exit;

  If fClienteTemPermissaoParaEmitirFF(fatVenda.strCodCli) Then
    Exit;

  LDescontoDoProfissional := fRetDescontoCliente(fatVenda.strCodCli);

  Result := IIF(LDescontoDoProfissional > 0, False, True);

end;

function TfrmFatVendas.fAplicarDescProfissNosItensAoTrocarCliente: Boolean;
begin
  Result := (fCfgSis('CLIDES') = 'S'  ) And // Usa desconto do profissional
            (fCfgSis('DCVBVL') = 'B'  ) And // Carregar preco bruto
            (fCfgSis('DPDIDE') = '1'  ) And // Aplicar desconto no item
            (fCfgSis('FATUDE') = 'S'  ) And // Utiliza desconto na tela de Faturamento
            (Not fProcessarRegraDescontoDeProfissionalPorItem);
end;

function TfrmFatVendas.fDefineOpcoesDocumentoConfirmacaoNotaConcreto(): Boolean;
Var
  intContador: Integer;
begin
  Result := True;
  If fatVenda.blnConfirmandoNotaFiscalConcreto And (strOpcDoc <> 'PD') And (strOpcDoc <> 'OR') Then
  Begin
    For intContador := Low(FVariaveisFechamentoVenda.arrOpcoes) To High(FVariaveisFechamentoVenda.arrOpcoes) Do
    Begin
      If (FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc = 'NF') Then
      Begin
        If MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
        Begin
          intSavPosAtual := intContador;

          If MatchStr(strOpcDoc,['VN','CP']) Then
            Break;
        End;

        FVariaveisFechamentoVenda.arrOpcoes[intContador].strDesCri := 'Nota Serviço';
        FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc := 'NS';
        FVariaveisFechamentoVenda.arrOpcoes[intContador].strOpcLet := 'N';
        FVariaveisFechamentoVenda.arrOpcoes[intContador].strMosMen := 'S';
      End;
    End;
  End;
end;

function TfrmFatVendas.fDefineOpcoesDocumentoTransferencia(): Boolean;
Var
  intContador: Integer;
begin
  Result := True;

  If (strOpcDoc = 'TE') Then
  Begin
    For intContador := Low(FVariaveisFechamentoVenda.arrOpcoes) To High(FVariaveisFechamentoVenda.arrOpcoes) Do
    Begin
      If Pos(FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc, 'NF_TE_') <= 0 Then
      Begin
        FVariaveisFechamentoVenda.arrOpcoes[intContador].strOpcLet := #0;
        FVariaveisFechamentoVenda.arrOpcoes[intContador].strMosMen := 'N';
      End;
    End;
  End;

end;

function TfrmFatVendas.fDefineOpcoesDocumentoVendaMultiloja(): Boolean;
Var
  intContador: Integer;
begin
  Result := True;

  If fatVenda.fVendaMultiLoja Then
  Begin
    For intContador := Low(FVariaveisFechamentoVenda.arrOpcoes) To High(FVariaveisFechamentoVenda.arrOpcoes) Do
    Begin
      If (Pos(FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc, 'NF_MI_FF_') > 0) Then
        Continue;

      If (Pos(FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc, 'OR_PD_') > 0) And fCfgSis('EMPFAT', VarBoolean) Then
        Continue;

      FVariaveisFechamentoVenda.arrOpcoes[intContador].strDesCri := 'Nota Fiscal';
      FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc := 'NF';
      FVariaveisFechamentoVenda.arrOpcoes[intContador].strOpcLet := 'N';
      FVariaveisFechamentoVenda.arrOpcoes[intContador].strMosMen := 'S';
    End;
  End;

end;

function TfrmFatVendas.fDefineSeMostraTelaDescontoNaVenda(): Boolean;
begin
  Result := True;

  FVariaveisFechamentoVenda.blnMostraDesconto := True;

  If (fCfgSis('USASER', varBoolean)) Then
  Begin
    If fatVenda.fSomenteItensDeServico(fatVenda.arrMatItens) Then
    Begin
      fatVenda.fltDesEsp := 0;
      FVariaveisFechamentoVenda.blnMostraDesconto := False;
    End;
  End;

  If (Not fMostraTelaDeDescontoQuandoUtilizaCorteDePedidoDeVenda(strOpcDoc)) Then
  Begin
    FVariaveisFechamentoVenda.blnMostraDesconto := False;
  End;

  If fatVenda.blnConfirmandoNotaFiscalConcreto And (fCfgSis('TPNFCR') = PRESTCON) And (strOpcDoc = 'VN') Then
  Begin
    FVariaveisFechamentoVenda.blnMostraDesconto := False;
  End;

  If (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
  Begin
    FVariaveisFechamentoVenda.blnMostraDesconto := False;
  End;

end;

function TfrmFatVendas.fDefinirSeOrcamentoGravandoComoPedido: Boolean;
var
  blnMostrouMsgEmpPriori: Boolean;
  blnExit: Boolean;
begin
  Result := True;
  {*******************************************}
  {* QUANDO É UMA OR PARA CLIENTE FILIAL COM *}
  {* PEDIDO REFERENCIADO SEMPRE SERÁ OR      *}
  {****************************************FC*}
  If Assigned(fatVenda.cdsPedRefOR)          And
    (strOpcDoc = 'OR')                       And
    (Not fEmptyStr(fatVenda.strNumPedRefOR)) And
    (Not fEmptyStr(fatVenda.strEmpPedRefOR)) Then
  Begin
    fatVenda.strEspDoc := 'OR';
  End
  {*******************************************************************************}
  {* CASO CARREGOU UM ORCAMENTO DE OUTRA LOJA SOMENTE PERMITE GRAVAR COMO PEDIDO *}
  {***************************************************************************JC**}
  Else If (strOpcDoc = 'OR') And fatVenda.fOrcamentoOutraLojaORVN Then
  Begin
    fatVenda.strEspDoc := 'PD';
    fatVenda.strTipFat := 'PEDIDO';
  End

  {*****************************************}
  {* CASO USE PEDIDO DE VENDA, ESTANDO NA  *}
  {* OPCAO ORCAMENTO PERMITE CONFIRMAR COMO*}
  {* PEDIDO                                *}
  {**************************************MV*}
  Else If fCfgSis('USAPDV', varBoolean) And (strOpcDoc = 'OR') And blnGravarComo And
          ((fVerificaAcessoSistema('frmFatVendas - PD')) or ((blnEstouNoCrm) And (fVerificaAcessoSistema('CRMPED')))) And
          IIF(Not fPermiteItemEspecial('PD'), Not fTemItemEspecialVenda, True) And
          (((fatVenda.fRetornaStatusClienteVenda(edtCodCli.Text) = 'A') Or (Not fCfgSis('PTRASC', varBoolean))) Or
           ((fatVenda.fRetornaStatusClienteVenda(edtCodCli.Text) = 'I') And (fCfgSis('INVNDC', varBoolean)))) Then
  Begin
    If (Not fEmptyStr(fatVenda.strNumOrc)) And (Assigned(qryFatGor)) Then
    Begin
       If (qryFatGor.Active) Then
         If (qryFatGor.FieldByName('FGO_DTAORI').AsDateTime <> 0) Then
           fatVenda.dtaDtaOri := qryFatGor.FieldByName('FGO_DTAORI').AsDateTime;
    End;

      If (fMensagem('', 'Gravar como: ', ['&Orçamento', '&Pedido']) = 2) Then
      Begin
        If (fCfgSis('NUMSER', VarString) = 'S') And (fCfgSis('OINSPP', VarString) = 'S') Then
        Begin
          Result := fVerificarControleDeSerie;
          If Not Result Then
          Begin
            fMensagem('', 'Existem produtos com controle por série, mas sem a devida série informada!', ['&Ok']);
            Exit(False);
          End;
        End;

      if blnPermiteFinalizarOrcamentoIPISemDadosConsumidor and blnCpfCnpjVazio then
      Begin
        fMensagem('','Não é possível efetuar o pedido sem informação de CPF/CNPJ. (É obrigatório devido ao IPI)',['&Ok']);
        Result := False;
        Exit;
      End;

      If fCfgSis('VNPOOR', varBoolean) Then
        fatVenda.blnGerOrc := (strOpcDoc = 'OR') And fEmptyStr(strNumOrc);

      FVariaveisFechamentoVenda.strPedAbe := fPedidosEmAbertoParaVeiculo(mskPlaVei.Text, strNumOrc);

      If (Not fEmptyStr(FVariaveisFechamentoVenda.strPedAbe)) and ((fCfgSis('1PDPLA', varBoolean))) Then
      Begin
        fMensagem('','Já existe pedido de venda em aberto para este veículo!' + #13#10 +
                     'Pedido(s): ' + FVariaveisFechamentoVenda.strPedAbe,['&Ok']);
        Result := False;
        Exit;
      End;

      blnSolicitouFecharOREmPDLocal := True;
      fatVenda.strEspDoc := 'PD';
      fatVenda.strTipFat := 'PEDIDO';

      If fEmptyStr(fatVenda.strCliCtt) And fSolicitaContatoAutorizado(fatVenda.strEspDoc) Then
      Begin
        If Not fFatDigContatoCpfRG Then
          Exit(False);
      End;

      If (Not fatVenda.fVerificaItemObrigCpfCnpj) Then
      Begin
        If (Not fInformaCPFCNPJItensComObrigatoriedade(fatVenda.strEspDoc)) Then
          Exit(False);
      End;

      If (Not fNovoFechamentoComCondicaoNoFinal()) Then
      Begin
        If Not fValidaCodFpg(fatVenda.strCodFpg, fatVenda.strConPag, blnExit) Then
        Begin
          Result := False;
          Exit;
        End;
      End;
                                           {Req: 112490 - Mantém data somente se carregou um OR}
      If fCfgSis('DTORPD', varBoolean) And (Not fEmptyStr(fatVenda.strNumOrc)) Then
      Begin
        fatVenda.dtaGraPed := fatVenda.dtaDtaEntOri;
        fatVenda.dtaPrevis := fatVenda.dtaPreVisOri;
      End
      Else
      Begin
        fatVenda.dtaGraPed := VS_Date;
        fatVenda.dtaHorPed := fRetHoraServidor;
        fatVenda.dtaDtaOri := VS_Date;

        If fatVenda.dtaPreVis < fatVenda.dtaGraPed Then
          fatVenda.dtaPreVis := fatVenda.dtaGraPed;
      End;

      If chkEntCD.Checked And (fatVenda.strOpcDoc = 'OR') And (fUsaRotinaWMS(fCfgSis('EMP_CD')) Or fCfgSis('TMQLOT', varBoolean)) Then
      Begin
        pMensagemSonora(
            'Foi selecionada a opção de entrega pelo CD, portanto este documento será de responsabilidade do CD. ' +
            'Se a finalização for em pedido, este não poderá mais ser alterado. Somente será possível realizar o ' +
            'cancelamento através do menu de cancelamento de documentos, porém antes será necessário ' +
            'entrar em contato com o responsável pelo CD e confirmar se o documento ainda não foi faturado!');
      End;

      If (fUtilizaEmpresaPrioridade) And (fCfgSis('SLDPED') = 'T') Then
      Begin
        If ((fCfgSis('SCPDES', varString) = 'S') Or
            (fMensagem('', 'Deseja realizar o cálculo da prioridade de estoque?', ['&Sim', '&Não']) = 1)) Then
        Begin
          pCarregarEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque(edtCodCli.Text);
          If Not fAjustaEmpresaPrioridade(blnMostrouMsgEmpPriori) Then
          Begin
            if not blnMostrouMsgEmpPriori Then
              fMensagem('ATENÇÃO','Não foi possível realizar o cálculo da prioridade de estoque!',['&OK']);
            Result := False;
            Exit;
          End
          Else
          Begin
            fatVenda.blnEmpresaPrioridade := True;
            fatVenda.pPreencheMatrizFechamento('', pOnPreencheMatrizItens);
          End;
        End;
      End;

      If (strOpcDoc = 'OR') And
         (TControleCashback.fPermiteUtilizarRotinaCashback) Then
      Begin
        pUtilizaCashbackCliente;
        If fatVenda.fltDesCsh > 0 Then
        Begin
          fatVenda.fltDesEsp := fatVenda.fltDesEsp
                              + fatVenda.fltDesCsh;
        End;
      End;
    End;
  End;

end;

function TfrmFatVendas.fEhVnFechandoOrcamento(): Boolean ;
begin
  result := False ;

  if fatVenda.strOpcDoc <> 'VN' then
    exit ;

  if fatVenda.strEspDoc <> 'OR' then
    exit ;

  result := True ;
end;

function TfrmFatVendas.fDefinirValorJaRecebidoComoPagamentoAntecipado: Boolean;
begin
  Result := True;
  {*******************************************}
  {* CASO ESTEJA FATURANDO OU ALTERANDO UM   *}
  {* PEDIDO, ABATE O VALOR PAGO ANTECIPADO   *}
  {*************************************MV,JB*}
  If (Pos(fatVenda.strOpcDoc, 'VN_VS_CS_PD_') > 0) And (Not fEmptyStr(strEspOrc)) And (strEspOrc <> 'OR') Then
  Begin
    fatVenda.fltDupRec := fatVenda.fTotalDuplicataQuitada(strNumOrc, strEspOrc, strEmpOrc,'');
    fatVenda.recValAdt := TAdiantamento.fGetTotaisAdiantamento(strNumOrc, strEspOrc, strEmpOrc);
    fatVenda.fltValAdt := fatVenda.recValAdt.fltValLan;

    If fatVenda.fltTotGer + fatVenda.fltTotSer < fatVenda.fltDupRec Then
    Begin
      If (strOpcDoc <> 'PD') Or (Not fCfgSis('GERCRE', varBoolean)) Then
      Begin
        fMensagem('ATENÇÃO!', 'O Valor Total não pode ser menor que o valor já Recebido do pedido: R$ ' +
                              FormatFloat(',0.00', fatVenda.fltDupRec) , ['&Ok']);
        Result := False;
        Exit;
      End;
    End;
  End

  Else If (fProcessaPagamentoAntecipadoPedidos(fatVenda.strOpcDoc)) Then
  Begin
    fatVenda.fltDupRec := 0.0;
    fatVenda.fltValAdt := 0.0;
    fatVenda.cdsPagAnt.First;

    While (Not fatVenda.cdsPagAnt.Eof) Do
    Begin
      fatVenda.fltDupRec := fatVenda.fltDupRec + fatVenda.cdsPagAnt.FieldByName('DUPREC').AsFloat;
      fatVenda.fltValAdt := fatVenda.fltValAdt + fatVenda.cdsPagAnt.FieldByName('ADTCLI').AsFloat;
      fatVenda.cdsPagAnt.Next;
    End;

    fatVenda.cdsPagAnt.First;
  End

  Else If (Pos(fatVenda.strOpcDoc, 'EM_') > 0) Then
  Begin
    fatVenda.fltDupRec := fatVenda.fTotalDuplicataQuitada(strNumOrc, strEspOrc, strEmpOrc,'');
    fatVenda.recValAdt := TAdiantamento.fGetTotaisAdiantamento(strNumOrc, strEspOrc, strEmpOrc);
    fatVenda.fltValAdt := fatVenda.recValAdt.fltValLan;
  End;

  If (Pos(fatVenda.strOpcDoc, 'VN_VS_CS_CP_') > 0) And (fatVenda.strEspOrc = 'PD') And (Pos(IfEmptyStr(fatVenda.strEspDoc, 'PD'), 'OR_PD_') <= 0) Then
  Begin
    If fatVenda.fPedidoAPrazoComEntradaQuitada(fatVenda.strNumOrc,
                                               fatVenda.strEspOrc,
                                               fatVenda.strEmpOri,
                                               fatVenda.strConPag) Then
    Begin
      fatVenda.pAlteraCondicaoPagamentoRemovendoEntrada(fatVenda.FConPag);
    End;
  End;
end;

