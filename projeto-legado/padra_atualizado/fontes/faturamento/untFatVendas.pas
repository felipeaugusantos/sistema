  If Not blnExibir Then
  Begin
    If pnlEmbarcacao.Visible Then
      pnlDadosAdicionais.Height := pnlDadosAdicionais.Height - pnlEmbarcacao.Height;

    pnlEmbarcacao.Visible := False;
    pnlEmbarcacao.Caption := '';
  End
  Else
  Begin
    If Not pnlEmbarcacao.Visible Then
      pnlDadosAdicionais.Height := pnlDadosAdicionais.Height + (pnlEmbarcacao.Height * 2);

    pnlEmbarcacao.Height  := (pnlEmbarcacao.Height * 2);
