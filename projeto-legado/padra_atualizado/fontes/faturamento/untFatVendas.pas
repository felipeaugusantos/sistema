function TfrmFatVendas.fInformaLoteBaseImobiliaria(blnVerificarSomenteConfig : Boolean = False) : Boolean;

  function fLOTBAS : Boolean;
  begin
    Result := fCfgSis('LOTBAS', varBoolean) And (fatVenda.strIdePro <> 'NOR');
  end;

begin

  If Not Assigned(fatVenda) Then
    Exit(False);

  If (blnVerificarSomenteConfig) Then
    Exit(fLOTBAS)
  Else
  Begin

    Result := fLOTBAS;

    If Result And Assigned(fTipoTinta) And (fTipoTinta(fatVenda.strIdePro) in [ttImobiliaria]) Then
      Result := True
    Else
      Result := False;

  End;

end;

function TfrmFatVendas.fInformarMecanicos(Var strCodMec: String; Var blnAltTodos: Boolean): Boolean;
begin
  Result := True;

  If Not (fatVenda.fEhAutocenter And pnlPlacaVeiculo.Visible) Then
    Exit;

  If Not fCfgSis('MECPRO', varBoolean) Then
    Exit;

  If fCfgSis('ACOSER') = '2' Then
    Exit;
    
  If Not fExibirServicoParaAutocenter Then
    Exit;

  Try
    pCriarFormularios(TfrmDigMecanicos, frmDigMecanicos);
    frmDigMecanicos.stlMecanicos.CommaText := strCodMec;
    frmDigMecanicos.blnViaFatVendas        := True;

    frmDigMecanicos.pnlAltMecGer.Visible := blnAltTodos;

    Result := frmDigMecanicos.ShowModal = mrOk;

    If Result Then
    Begin
      strCodMec   := frmDigMecanicos.stlMecanicos.CommaText;
      blnAltTodos := frmDigMecanicos.chkAltMecGer.checked;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '');
    End;
  End;

  pFreeAndNil(frmDigMecanicos);

end;

function TfrmFatVendas.fInformarProfissionalFechamentoVenda(): Boolean;
begin
  Result := True;

  If (fCfgSis('NROPRO') <> '1') And
     ((Not fatVenda.blnConfirmandoNotaFiscalConcreto) Or (FVariaveisFechamentoVenda.blnSecol) Or (fatVenda.strOpcDoc = 'CN')) And
     (Pos(fatVenda.strOpcDoc, 'NC_TE_CF_DV_PR_CI_CT_VS_EP_UC_DD_CS_NP_PA_ER_') <= 0) Then
  Begin
    If Not fPedeProfissional(fatVenda) Then
    Begin
      Result := False;
      Exit;
    End;
  End;

end;

function TfrmFatVendas.fZonaFrancaPermiteDescontoEspecial: Boolean;
begin
  Result := (Not SameText(fatVenda.strZonFra, 'S'));
  If (Not Result) Then
  Begin
    If (Not fatVenda.fAplicaIcmsComoDescontoZonaFranca) Then
      Exit;

    If (fatVenda.blnClienteZonaFrancaComDescontoEspecial) Then
      Exit;

    If (fatVenda.fEhClienteZonaFrancaSimplesNacional('')) Then
      Exit;

    If (fCfgSis('ZFMDES', varString) = 'N') Then
      Exit;

    Result := True;
  End;
end;

function TfrmFatVendas.fInformarValorDescontosGeraisVenda(): Boolean;
  Var
    frmFatDigDesconto : TfrmFatDigDesconto;
    LResultVerificaVrMinimo: Boolean;
begin
  If (fatVenda.fBloquearPercentualDescontoNoFechamentoDaVenda(fatVenda.fltPorDes))  Then
    Exit(False);

  If (fatVenda.fBloquearDescontoEspecialNoFechamentoDaVenda(fatVenda.fltDesEsp))  Then
    Exit(False);

  Result := True;

  pUtilizaCashbackCliente;

  {************************************************}
  {* EXPLICANDO O:                                *}
  {* Or (fatVenda.fltDesEsp > fatVenda.fltTotPro) *}
  {* QUANDO FAZIA UM ORÇAMENTO EX: 100 ITENS DE   *}
  {* R$ 1,00 E DAVA UM DESCONTO ESP. DE R$ 70,00. *}
  {* CARREGAVA O ORÇAMENTO P/ FATURAR E DIMINUIA  *}
  {* A QUANTIDADE DO ITEM P/ 10. O TOTGER FICAVA  *}
  {* NEGATIVO, E GRAVAVA O DOCUMENTO NEGATIVO.    *}
  {*********************************************MV*}
  If fPermitirDescontoEspecial(strOpcDoc) And blnFechamentoComDesconto And
     (fZonaFrancaPermiteDescontoEspecial) And
     (Not SameText(fatVenda.strBenRei, 'S'))                           And
     (( ( fatVenda.fltTotGer + fatVenda.fltDesEsp ) > 0.0) Or (fatVenda.fltDesEsp > Abs(fatVenda.fltTotPro))) And
     (Not fatVenda.blnCliFil)                                                                                 And
     ((Not FVariaveisFechamentoVenda.blnApenasServico)) And // Não entra se houver apenas serviço
     (FVariaveisFechamentoVenda.blnMostraDesconto)                                                                   Then
  Begin

    FVariaveisFechamentoVenda.fltDesEspTmp       := fatVenda.fltDesEsp;
    FVariaveisFechamentoVenda.fltTotMod          := 0.0;
    fatVenda.fltPorDes := 0.0;
    fatVenda.fltDesEsp := 0.0;

    FVariaveisFechamentoVenda.fltSerAnt := fatVenda.fltTotSer;
    fatVenda.fltTotSer := 0.0;

    FVariaveisFechamentoVenda.fltDesAceAnt := fatVenda.fltDesAce;
    fatVenda.fltDesAce := 0.0;

    Try
      Try
        pPreencheMatrizFechamento;
      Except
        On E: ExceptionAutCom Do
        Begin
          fMensagem('', E.Message, ['&O K']);
          Result := False;
        End;

        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[frmFatVendas.fConfirmaVenda]');
          Result := False;
        End;
      End;

      {*****************************************}
      {* CALCULA TOTAL GERAL                   *}
      {**************************************MV*}
      pCalculaTotGer(False, False);

      FVariaveisFechamentoVenda.fltTotAnt := fatVenda.fltTotGer;

      Screen.Cursor := crDefault;

      If strOpcDoc <> 'EP' Then
      Begin
        Try
          fltSavTotGer := fatVenda.fltTotGer;

          pCriarFormularios(TfrmFatDigDesconto, frmFatDigDesconto);
          try
            frmFatDigDesconto.fatVenda := fatVenda;

            frmFatDigDesconto.pFuncCalculaTotais := pCalculaTotais;
            frmFatDigDesconto.pOnCalculaTotGer   := pOnCalculaTotGer;
            frmFatDigDesconto.pMostraMargem      := pMostraMargem;

            FVariaveisFechamentoVenda.fltDescontosCliente := 0;

            If (fCfgSis('DDESFD', varInteger) > 0) And (fCfgSis('TDESFD') = 'B') And (fatVenda.strPromoc = 'N') Then
            Begin
              If ((VS_Date - fCampoTabela('CLI_ULTCOM', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli])) <= fCfgSis('DDESFD', varInteger)) Then
                FVariaveisFechamentoVenda.fltDescontosCliente := fatVenda.fltDescFidelidade;
            End;

            If fAplicarDescProfissionalNoDesEsp Then
            Begin
              FVariaveisFechamentoVenda.fltDescontosCliente := FVariaveisFechamentoVenda.fltDescontosCliente + fatVenda.fltDescProfissional;

              frmFatDigDesconto.pDesbloqueiaCaixaDeDesconto;

              If (fatVenda.strOpcDoc <> 'OF') And (FVariaveisFechamentoVenda.fltDescontosCliente > 0) Then
              Begin
                //Caso nao permita editar o desconto do Profissional
                If Not fCfgSis('EDIDEP', VarBoolean) Then
                  frmFatDigDesconto.pBloqueiaCaixaDeDesconto
                Else
                  frmFatDigDesconto.fltDesMaxProfiss := FVariaveisFechamentoVenda.fltDescontosCliente;
              End;

            End;

            If strCliAntDes <> edtCodCli.Text then
            Begin
              fatVenda.fltPorDesTmp := FVariaveisFechamentoVenda.fltDescontosCliente;
              strCliAntDes := edtCodCli.Text;
            End;

            frmFatDigDesconto.pAtualizaInformacoesVenda;

            frmFatDigDesconto.edtPorDes.Text     := FormatFloat('#,##0.00', fatVenda.fltPorDesTmp);
            frmFatDigDesconto.edtDesEsp.Text     := FormatFloat('#,##0.00', FVariaveisFechamentoVenda.fltDesEspTmp);

            frmFatDigDesconto.blnTemTro    := FVariaveisFechamentoVenda.blnTemTro;
            frmFatDigDesconto.fltTotGerAnt := FVariaveisFechamentoVenda.fltTotAnt;
            frmFatDigDesconto.fltDesEspAnt := FVariaveisFechamentoVenda.fltDesEspTmp;
            frmFatDigDesconto.fltPorDesAnt := fatVenda.fltPorDesTmp;

            frmFatDigDesconto.ShowModal;

            fltSavPorDes := fatVenda.fltPorDes;
            fltSavDesEsp := fatVenda.fltDesEsp;

            fatVenda.fltDesEsp := fatVenda.fltDesEsp
                                + fatVenda.fltDesCsh;

            If Not frmFatDigDesconto.blnConfirma Then
            Begin
              fatVenda.fltDesEsp := fatVenda.fltDesEsp
                                  - fatVenda.fltDesCsh;

              Result := False;

              If SameText(fatVenda.strOpcDoc, 'CF') Then
                pCalculaTotGer(False, False);
            End;

            blnPassouPelaTelaDescontoEConfirmou := frmFatDigDesconto.blnConfirma;
            fatVenda.blnPassouPelaTelaDescontoEConfirmou := blnPassouPelaTelaDescontoEConfirmou;
            fatVenda.fltPorDesVer := fFormataFloat(fStrToFloat(frmFatDigDesconto.edtPorDes.Text),2) ;
          finally
            pFreeAndNil(frmFatDigDesconto);
          end;
        Except
          On E: Exception Do
          Begin
            Result := False;
            pMensagensErro(E.Message, '[fConfirmaVenda]');
          End;
        End;
      End;
    Finally
      fatVenda.fltTotSer := FVariaveisFechamentoVenda.fltSerAnt;
      fatVenda.fltDesAce := FVariaveisFechamentoVenda.fltDesAceAnt;
    End;
  End
  Else
  Begin

    If ((VS_strTRVEPR = '2') Or (fUsaTravaIteAIteComOrcPedCarregado) Or (fatVenda.strOpcDoc = 'CF')) And
       (Pos(fatVenda.strOpcDoc, 'OU_OV_OF_DV_DD_CN_') <= 0) And
       (IIF(fatVenda.strOpcDoc = 'CF', (fFormataFloat(fatVenda.fltDesEsp+fatVenda.fltDesEspDifeF4, 4) > fFormataFloat(FVariaveisFechamentoVenda.fltDesMinConf, 4)), True)) And
       (fatVenda.fValidaMinimoAntesDaCondicaoNoFinal(FVariaveisFechamentoVenda.blnUsaCndVenFinal)) Then // Not FVariaveisFechamentoVenda.blnUsaCndVenFinal
    Begin

      fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
        begin
          Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0),
                                               fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0),
                                               fatVenda.intPrzMed,
                                               EmptyStr, True, True, pgbProgresso);
          LResultVerificaVrMinimo := Result;
        end, 'Aguarde, Verificando valor mínimo produtos ...', '');

      Result := LResultVerificaVrMinimo;

      If Not Result Then
      Begin
        If (fCfgSis('TRAREM', varString) = '1') And (fCfgSis('ALTVMT', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
          pAjustaValorProdutoPrecoMinimo;
      End;

      If Result Then
        If (fatVenda.strOpcDoc = 'CF') Then
          fatVenda.fltDesEspRef := fatVenda.fCalculaDescontoConfirmacao(FVariaveisFechamentoVenda.fltDesMinConf);

    End;

    fatVenda.fltDesEsp := fatVenda.fltDesEsp
                        + fatVenda.fltDesCsh;
  End;

  If Assigned(frmFechamentoVenda) Then
  Begin
    pProgresso (0, 0, frmFechamentoVenda.pgbStatus);
    pInformacao(MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA, frmFechamentoVenda.pgbStatus);
    NotificarFechamentoVendaObservers;
  End;

end;

function TfrmFatVendas.fInsereProdutoAtivacaoConformeElementosDoComboDeVenda: Boolean;
Var
  strTabPreTmp: String;
  strEmpIteTmp: String;
begin

  Result := False;

  Try

    If (Pos(strOpcDoc, 'OR_PD_VN_') <= 0) Then
      Exit;

    If (blnInserindoProdAtivacao) Or
       (blnInserindoCombo)        Or
       (fAlterandoProduto)     Or
       (Not fPermiteAtivarComboVenda(fatVenda.strIdePro, edtCodIte.Text)) Then
      Exit;

    strTabPreTmp := fatVenda.fDefineTabelaPrecoItem(fatVenda.strIdePro, '');

    If (cbTabPrecoItem.Visible) Then
      strTabPreTmp := fTabelaDePrecoDosItens;

    strEmpIteTmp := edtCodEmp.Text;

    If (fatVenda.blnEnt_CD) Then
      strEmpIteTmp := fatVenda.strEmp_CD;

    If (fEmptyStr(strEmpIteTmp)) Then
      strEmpIteTmp := VS_strCodEmp;

    fatVenda.objComVen.setCodIte(edtCodIte.Text);
    fatVenda.objComVen.setTabPre(strTabPreTmp);
    fatVenda.objComVen.setCodEmp(strEmpIteTmp);
    fatVenda.objComVen.setEntRet(LeftStr(cmbEntRet.Text, 1));

    If (fatVenda.objComVen.fAbreTelaIndicacaoProdCombo) Then
    Begin
      blnInserindoProdAtivacao := True;
      pLimpaDadosItem;
      edtCodIte.Text := fatVenda.objComVen.getIteAti;
      pCarregaItem(True, True);
      
      If (fatVenda.blnEmpFat) Then
        edtCodEmp.Text := strEmpIteTmp;

      edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, fatVenda.objComVen.getQtdAti);
      edtNumLot.Text := fatVenda.objComVen.getLotAti;
      pCalculaTotIte;
      fltUniDig := fStrToFloat(edtUnitar.Text);
      pAdicionar;
      pLimpaDadosItem;
      Result := True;
    End;
  Finally
    blnInserindoProdAtivacao := False;
  End;
end;

function TfrmFatVendas.fInsereProdutosComboVenda(pgbProgresso: TcxProgressBar): Boolean;
Var
  fltQtdIte : Double;
  intQtdCom : Integer;
  blnInseriu: Boolean;
  blnLibBri : Boolean;
  intQtdReg : Integer;
  blnPromoComboAtivado: Boolean;
  strEmpIte: String;
  strCodIte: String;
  strNumLot: String;

  function fLiberaTravaPermissaoBrinde: Boolean;
  var
    objTabela : TRegistroMsgLiberaTabela;
    objLinha :  TLinhaMsgLibera;
  begin
    Result := fVerificaAcessoSistema('frmFatVendas - BR', fatVenda.strCodVen);

    If (Not Result) Then
    Begin
      With fatVenda.objComVen.cdsProCom Do
      Begin
        First;

        objTabela := TRegistroMsgLiberaTabela.Create;

        While Not Eof Do
        Begin
          If (FieldByName('BRINDE').AsString = 'S') And (FieldByName('MARDES').AsString = 'S') Then
          Begin

            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.pAddColuna('COD.'        , FieldByName('CODITE').AsString                                                         , fTamCodIte   );
            objLinha.pAddColuna('DESCRICAO.'  , Copy(FieldByName('DESITE').AsString, 1,37)                                             , 37           );
            objLinha.pAddColuna('UN.'         , Copy(FieldByName('SIGUNI').AsString, 1,2)                                              , 2            );
            objLinha.pAddColuna('QUANTIDADE.' , FloatToStrF(FieldByName('QTDITE').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)) , 10, alDireita);
            objLinha.pAddColuna('SITUAÇÃO.'   , 'BRINDE'                                                                               , 11           );

            objTabela.lstLinhas.Add(objLinha);

          End;

          Next;
        End;

        If objTabela.isEmpty Then
        begin
          FreeAndNil(objTabela);
          Result := True;
        end
        else
        Begin
          objLiberacao.objMsgLibera.pAddSeparador(76, teAutcom);
          objLiberacao.objMsgLibera.pAddTexto('LIBERAÇÃO DE PRODUTOS DE BRINDE EM COMBO DE VENDA',alCentro, teAmbos, '', 76);

          objLinha := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'COD.'        , 5 , alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'DESCRICAO.'  , 37, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'UN.'         , 2 , alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'QUANTIDADE.' , 10, alDireita , teAutcom);
          objLinha.pAddColuna('', 'SITUAÇÃO.'   , 11, alEsquerda, teAutcom);

          objTabela.lstLinhas.Insert(0, objLinha);

          objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

          objLiberacao.strDirAce := 'LIBBRCB';
          objLiberacao.strMsgSen := 'LIBERAÇÃO DE PRODUTOS DE BRINDE EM COMBO DE VENDA';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
        End;
      End;
    End;
  End;

begin
  Result     := False;
  blnInseriu := False;

  Try
    If (Not fCfgSis('ALPRCO', varBoolean)) Then
    Begin
      blnInserindoCombo := True;
      fltQtdIte := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
      strEmpIte := cdsVenda.FieldByName('ITE_EMPITE').AsString;
      strCodIte := cdsVenda.FieldByName('ITE_CODITE').AsString;
      strNumLot := cdsVenda.FieldByName('ITE_NUMLOT').AsString;
      cdsVenda.Delete;
      edtCodIte.Text := strCodIte;
      edtCodEmp.Text := strEmpIte;
      edtNumLot.Text := strNumLot;
      pSetaCampoDestino();
      pCarregaItem(True, True);
      pCarregaInformacaoItem;
      edtQtdIte.Text := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), fltQtdIte);
      pAdicionar;
      pLimpaDadosItem;
      blnInserindoCombo := False;
    End;

    cdsVenda.Edit;
    cdsVenda.FieldByName('ITE_ATIVAC').AsString  := 'S';
    cdsVenda.FieldByName('ITE_SITUAC').AsString  := 'C';
    cdsVenda.FieldByName('ITE_SEQCOM').AsInteger := fatVenda.intSeqCom;
    cdsVenda.Post;

    fltQtdIte := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
    intQtdReg := cdsVenda.RecordCount;

    pInfoStatusGravacao(pgbProgresso, 'Aguarde...Inserindo Produtos do Combo...');

    blnLibBri := fLiberaTravaPermissaoBrinde;


    With fatVenda.objComVen.cdsProCom Do
    Begin
      pgbProgresso.Properties.Max := RecordCount;
      blnInserindoCombo := True;

      blnPromoComboAtivado := True;
      if fCfgSis('VLSECB', varBoolean) then
      begin
        First;
        while not Eof do
        begin
          if (FieldByName('MARDES').AsString = 'N') And
             (FieldByName('BRINDE').AsString <> 'S') then
          begin
            blnPromoComboAtivado := False;
            Break;
          end;
          Next;
        end;
      end;

      First;

      While Not Eof Do
      Begin
        If (FieldByName('MARDES').AsString = 'S')                   And
           ((FieldByName('BRINDE').AsString <> 'S') Or (blnLibBri)) Then
        Begin
          pInfoStatusGravacao(pgbProgresso, 'Aguarde...Inserindo Produto do Combo...' +
                                            FieldByName('CODITE').AsString + '-' + Copy(FieldByName('DESITE').AsString, 1, 15));

          intQtdCom := Trunc(fFormataFloat(fltQtdIte / FieldByName('QTDATI').AsFloat, fCfgSis('DECQTD', varInteger)));

          If (intQtdCom > 0) Then
          Begin
            fatVenda.strIteCom := 'S';
            edtCodIte.Text := FieldByName('CODITE').AsString;
            edtCodEmp.Text := FieldByName('CODEMP').AsString;
            pSetaCampoDestino();
            pCarregaItem(True, True);
            pCarregaInformacaoItem;

            fatVenda.fltTaxJur := 0.00;

            edtQtdIte.Text := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), FieldByName('QTDITE').AsFloat * intQtdCom);
            edtNumLot.Text := FieldByName('NUMLOT').AsString;

            If (FieldByName('BRINDE').AsString <> 'S' ) Then
            Begin
              if blnPromoComboAtivado then
              begin
                edtUnitar.Text := FormatFloat(fMskDigitos(fCfgSis('DECUNI', varInteger)), FieldByName('PREVEN').AsFloat);
                fatVenda.fltUniOri := FieldByName('PREVEN').AsFloat;
                fatVenda.fltUniVis := FieldByName('PREVEN').AsFloat;
              end;

              If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao Then
              Begin
                fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('CODITE').AsString, FieldByName('CODEMP').AsString);

                edtUnitar.Text     := FormatFloat(fMskDigitos(fCfgSis('DECUNI', varInteger)),
                                      fatVenda.fltUniOri +
                                      fFormataFloat(fatVenda.fltUniOri *
                                      (fatVenda.fGetTaxVprItem(FieldByName('CODITE').AsString, FieldByName('CODEMP').AsString) / 100.0), 04));

                fatVenda.fltUniOri := fstrToFloat(edtUnitar.Text);
              End;
            End
            Else
              chkBrinde.Checked := True;

            pCalculaTotIte;
            fltUniDig := fStrToFloat(edtUnitar.Text);

            pAdicionar;
            pLimpaDadosItem;

            If (cdsVenda.FieldByName('ITE_CODITE').AsString = FieldByName('CODITE').AsString) And
               (cdsVenda.RecordCount > intQtdReg) Then
            Begin
              cdsVenda.Edit;
              cdsVenda.FieldByName('ITE_EMPITE').AsString  := fatVenda.objComVen.getCodEmp;
              cdsVenda.FieldByName('ITE_ATIVAC').AsString  := 'N';

              If (FieldByName('BRINDE').AsString = 'S') Then
                cdsVenda.FieldByName('ITE_SITUAC').AsString := 'B'
              Else if blnPromoComboAtivado then
                cdsVenda.FieldByName('ITE_SITUAC').AsString := 'P';

              If (Pos(FieldByName('TABPRE').AsString, '1234567') > 0) Then
                cdsVenda.FieldByName('ITE_TABPRE').AsString  := FieldByName('TABPRE').AsString
              Else If (Not fEmptyStr(fatVenda.strTabPre)) Then
                cdsVenda.FieldByName('ITE_TABPRE').AsString  := fatVenda.strTabPre;

              cdsVenda.FieldByName('ITE_TABCOM').AsString  := FieldByName('TABPRE').AsString;
              cdsVenda.FieldByName('ITE_SEQCOM').AsInteger := fatVenda.intSeqCom;
              cdsVenda.FieldByName('ITE_QTDATI').AsFloat   := FieldByName('QTDATI').AsFloat;
              cdsVenda.FieldByName('ITE_QTDCOM').AsFloat   := FieldByName('QTDITE').AsFloat;
              cdsVenda.Post;
              blnInseriu := True;
            End;
          End;
        End;

        Next;
        pStepStatusGravacao(pgbProgresso);
      End;

    End;

    If (blnInseriu) Then
      fatVenda.intSeqCom := fatVenda.intSeqCom + 1
    Else
    Begin
      cdsVenda.Edit;
      cdsVenda.FieldByName('ITE_ATIVAC').AsString  := 'N';
      cdsVenda.FieldByName('ITE_SITUAC').AsString  := 'N';
      cdsVenda.FieldByName('ITE_SEQCOM').AsInteger := 0;
      cdsVenda.Post;
    End;

    Result := True;

  Except
    On E: Exception Do
      pMensagensErro(e.Message, '[TfrmFatVendas.fInsereProdutosComboVenda]');
  End;

  fatVenda.strIteCom := 'N';
  blnInserindoCombo  := False;
  pAtualizaUnitarioLiquido;

end;

function TfrmFatVendas.fInserirItensLogSeparacaoAutocenter: Boolean;
begin
  Result := True;

  If ((fatVenda.fEhAutocenter) Or (fCfgSis('RETDEV', varBoolean))) And (Assigned(fatVenda.cdsLogItensSep)) Then
  Begin
    {******************************************************************************}
    {* CASO O USUÁRIO INSIRA UMA PLACA EM UM PEDIDO ORIGINALMENTE PLACA INFORMADA *}
    {* E APAGUE NOVAMENTE, EXECUTA pInsereTodosItensNoCdsLogItensSep('A') ONDE    *}
    {* ITE_QTDANT E ITE_QTDITE FICARÃO COM O MESMO VALOR FAZENDO COM QUE O LOG NÃO*}
    {* SEJA GRAVADO                                                               *}
    {***************************************************************************VA*}
    If (strOpcDoc = 'PD') And
       (Not fEmptyStr(fatVenda.strNumOrc)) And
       (fEmptyStr(fatVenda.strPlaVei)) And
       (blnPDAutCenComPlacaInseridaPosterior) Then
    Begin
      fatVenda.pInsereTodosItensNoCdsLogItensSep('A');
    End
    {******************************************************************************}
    {* CASO ORÇAMENTO TRANSFORMADO EM PEDIDO COM EXPEDIÇÃO SERVIÇOS               *}
    {***************************************************************************VA*}
    Else If (fatVenda.fOrcamentoComoPedido) Then
    Begin
      fatVenda.pInsereTodosItensNoCdsLogItensSep('I');
    End;
  End;

end;

procedure TfrmfatVendas.pInformacaoMecanicos(strCodMec: String);
  Var
    stlMecanico: TStringList;
    intMecanico: Integer;
    strNomMecan: String;
begin
  If Not dbgItens.Focused Then
    Exit;

  If fatVenda.fEhAutocenter And pnlPlacaVeiculo.Visible Then
  Begin
    stlMecanico := TStringList.Create;
    stlMecanico.CommaText := strCodMec;

    For intMecanico := 0 To stlMecanico.Count -1 Do
    Begin
      strNomMecan := Trim(fRetNomeOperador(stlMecanico[intMecanico]));

      If Pos(' ', strNomMecan) > 0 Then
        strNomMecan := LeftStr(strNomMecan, Pos(' ', strNomMecan) -1);

      stlMecanico[intMecanico] := stlMecanico[intMecanico] + '-' + strNomMecan;
    End;

    strNomMecan := AnsiReplaceStr(stlMecanico.CommaText, ',', ', ');

    pLabelInformacaoGrid('Mecânico(s): ' + strNomMecan);
    stlMecanico.Destroy;
  End;
end;

