function TfrmFatVendas.fObterMensagemDocDev: String;
var intContItenNota, i : Integer;
    lstDocumentos: TStringList;
    strDocDevAnt, strDocDev: String;
    blnNaoStringVazia, blnEhDiferenteAnterior : Boolean;
begin
  Result := '';

  If Length(fatVenda.arrMatItens) = 0 Then
    Exit;

  strDocDevAnt  := EmptyStr;
  strDocDev     := EmptyStr;
  lstDocumentos := Nil;

  Try
    lstDocumentos := TStringList.Create;

    For intContItenNota := 0 To PRed(Length(fatVenda.arrMatItens)) Do
    Begin
      If not (fEmptyStr(fatVenda.arrMatItens[intContItenNota].strDocDev)) Then
        strDocDev := (fatVenda.arrMatItens[intContItenNota].strDocDev + ' - ' + fatVenda.arrMatItens[intContItenNota].strEspDev);

      blnNaoStringVazia := Not fEmptyStr(strDocDev);
      blnEhDiferenteAnterior := (strDocDevAnt <> strDocDev);

      If blnNaoStringVazia And blnEhDiferenteAnterior And (lstDocumentos.indexof(strDocDev) = -1 ) Then
      Begin
        lstDocumentos.Add(fatVenda.arrMatItens[intContItenNota].strDocDev);
        strDocDevAnt := strDocDev;
      End;
    End;

    If lstDocumentos.Count = 0 Then
      Exit;

    For i := 0  To lstDocumentos.count -1 Do
    Begin
      Result := Result + lstDocumentos[i];
      If (i = (lstDocumentos.count -1)) Then
        Result := Result + '.'
      Else If (i = (lstDocumentos.count -2)) Then
        Result := Result + ' e '
      Else
        Result := Result + ', '
    End;

    Result := 'Doc Origem: '+ Result;

  Finally
    If Assigned(lstDocumentos) Then
      FreeAndNil(lstDocumentos);
  End;
end;

