procedure TfrmFatVendas.pEditarCPFCliente;
  Var
    qryUpd: TUniQuery;
  blnControleTransacaoLocal: Boolean;
begin
  blnControleTransacaoLocal := False;
  try
    qryUpd := fCriaQuery;
    try
      if not fInTransaction then
      begin
        fStartTransaction;
        blnControleTransacaoLocal := True;
      end;

      qryUpd.SQL.text :=
        'UPDATE CADCLI' + sLineBreak +
        '   SET CLI_CGCCPF = :CGCCPF,' + sLineBreak +
        '       CLI_C_G_C_ = :C_G_C_' + sLineBreak +
        ' WHERE CLI_CODCLI = :CODCLI';

      qryUpd.ParamByName('CODCLI').AsString  := fatVenda.strCodCli;
      qryUpd.ParamByName('CGCCPF').AsInteger := fatVenda.intCgcCpf;
      qryUpd.ParamByName('C_G_C_').AsString  := fatVenda.strCliCgc;
      qryUpd.ExecSQL;

      if blnControleTransacaoLocal then
        fCommit;
    finally
      FreeAndNil(qryUpd);
    end;
  except
  end;

  if blnControleTransacaoLocal and fInTransaction then
    fRollBack;
end;

