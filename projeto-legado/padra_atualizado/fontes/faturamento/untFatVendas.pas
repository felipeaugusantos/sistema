  Result := True;
end;

procedure TfrmFatVendas.pAtualizaUnitarioSugestao(blnAtualizar: Boolean = False);
  var
    fltUnitario,
    fltQtdDis,
    fltDesMax,
    fltCusIte,
    fltDedCus: Double;

    blnParticiona,
    blnPromo,
    blnTemEmbFec,
    blnValidPromo : Boolean;

    strTabelaPreco,
    strPromoAnt,
    strCodProAnt: String;
    fltPercDesEmbFec: Double;
begin
  fltUnitario := 0;

  If (fStrToFloat(edtUnitar.Text) <> 0) Then
    fltUnitario := fStrToFloat(edtUnitar.Text);

  {******************************************************}
  {* SE FOR PRODUTO NORMAL E A QUANTIDADE FOI INFORMADA *}
  {**************************************************JC**}
  If (fatVenda.strIdePro = 'NOR')
    And (fStrToFloat(edtQtdIte.Text) > 0)
    And ((Not edtQtdIte.ReadOnly) Or (fAtualizaPrecoEmNegociacao) Or fEhItemMetragemComEmbalagemFechadaComDesconto())
    And (Not fEmptyStr(edtCodIte.Text))
    And (Pos(strOpcDoc, 'DV_PR_') <= 0)
    And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor)
    And (not blnProAca)
    And (Not fEhItemVendaVidro(fCodItem))
    And (Pos('ITEM ESPECIAL', fRetNomProduto(edtCodIte.Text)) <= 0)
    And (strOpcDoc <> 'MF') Then
  Begin

    strTabelaPreco := fTabelaPrecoItem;

    If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) And
       (Not fTemQuantEmbalagemFechada(edtCodIte.Text)) Then
    Begin
      fatVenda.stlItensNaoTemQtdeEmbFec.Add(edtCodIte.Text);
    End;

    {******************************************************}
    {* VARIAVEIS PARA VERIFICAR SE VALIDOU A PROMOCAO E   *}
    {* SE POSSUI QUANTDADE DE EMBALAGEM FECHADA           *}
    {**************************************************JC**}
    //blnTemEmbFec  := (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) And
    //                 (fQuantEmbalagemFechadaItem(edtCodIte.Text, strTabelaPreco, fStrToFloat(edtQtdIte.Text)) > 0);
    blnTemEmbFec := fTemQuantEmbalagemFechada(edtCodIte.Text) And
                    (Not blnInserindoCombo) And (Not blnAlterandoCombo); //prevalece o preço do combo, mesmo se tiver embalagem fechada

    {*********************************}
    {* RETORNA O PRECO DE PROMOCAO   *}
    {*****************************JC**}
    strPromoAnt        := fatVenda.strPromoc;
    strCodProAnt       := fatVenda.strCodPro;
    fatVenda.strPromoc := 'N';

    If (fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(edtCodIte.Text, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) Then
    Begin
      If (fRetornaPrecosPromocao(edtCodIte.Text,
                                 edtCodCli.Text,
                                 VS_Date,
                                 IIF(fStrToFloat(edtQtdIte.Text) > 0, fStrToFloat(edtQtdIte.Text), 1),

                                 fatVenda.fRetQtdDigitada(edtCodIte.Text,'',IntToStr(btnAdicionar.Tag),'','',fRetEmpresaItem,False),

                                 fatVenda.fRetQtdDigitada(edtCodIte.Text,'',IntToStr(btnAdicionar.Tag),'','',fRetEmpresaItem,False,
                                                          False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,True {Somente em promocao}),

                                 fatVenda.intPrzMed,
                                 fatVenda.fltProPreCus,
                                 fatVenda.fltProPreVen,
                                 fatVenda.fltProComVar,
                                 fatVenda.fltProComAta,
                                 fatVenda.fltProComDis,
                                 fltQtdDis,
                                 fatVenda.fltProDesF07,
                                 fatVenda.strComPro,
                                 fatVenda.strCodPro,
                                 blnParticiona,
                                 blnPromo,
                                 strTabelaPreco,
                                 fatVenda.strCodCnd,
                                 '',
                                 '',
                                 True,
                                 False,
                                 '-1',
                                 (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                                 (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                                 fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                 fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                 strNumOrc,
                                 strEspOrc,
                                 Nil,
                                 False,
                                 '',
                                 objPromVlrMinTotalProdutos,
                                 '',
                                 fatVenda.fltSomaColorantes)) Then
      Begin
        If (Not blnParticiona) Then
        Begin
          fatVenda.strPromoc := 'S';
          pDesconsideraPromocaoTabItem(fatVenda.strPromoc, True);
        End;
      End;
    End;

    If qryConCit.FindField('ITE_DESCND') <> NIL Then
      fatVenda.strDstCnd := qryConCit.FieldByName('ITE_DESCND').AsString;

    blnValidPromo := strPromoAnt <> fatVenda.strPromoc;

    If (fUtilizaUnitarioLiquido) Then
    Begin
      If (fCfgSis('CLIDES')  = 'S') And
         (fCfgSis('DCVBVL')  = 'B') And
         (fCfgSis('FATUDE')  = 'S') And
         (fCfgSis('DPDIDE')  = '1') And
         (edtDesCon.Visible)Then
      Begin    
        If ((fatVenda.strPromoc = 'S') And
            (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao)) Or
           (fatVenda.strIteCom = 'S') Then
        Begin
          edtDesCon.Text := FloatToStrF(0, ffNumber, 12, intDecDes)
        End
        Else If (blnValidPromo) Then
        Begin 
          edtDesCon.Text := FloatToStrF(fRetDescontoCliente(fatVenda.strCodCli), ffNumber, 12, intDecDes);
        End;
      End;
    End;
    
    pEditarDesconto;
    pEditarPrecoUnitario;

    {******************************************************}
    {* CONTROLE DE QUANTIDADE LIMITE REFERENTE A PROMOÇÃO *}
    {****************************************************PZ}
    If (Pos(strOpcDoc, 'PD_OR_VN_CS_') > 0) And
       ((fDadosPromocao(fCodItem, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem), edtCodCli.Text, strTabelaPreco, '', strNumOrc, strEspOrc, fatVenda.strCodPro).fltQtdMin > 0) Or
        (fDadosPromocao(fCodItem, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem), edtCodCli.Text, strTabelaPreco, '', strNumOrc, strEspOrc, fatVenda.strCodPro).fltQtdLim > 0)) Then
    Begin
      fValidaPromocao;
      blnValidPromo := strPromoAnt <> fatVenda.strPromoc;

      If (Not blnValidPromo) And fatVenda.strPromoc.Equals('S') And (Not fatVenda.strCodPro.IsEmpty) Then
        If fEhPromocaoPorQuantidadeMinimaEscalonada(fCampoTabela('PRO_IDXPRO', 'CADPRO ', ['PRO_CODPRO'], [fatVenda.strCodPro])) Then
          blnValidPromo := fatVenda.fltProPreVen <> fStrToFloat(edtUnitar.Text);

    End;

    If (Not blnValidPromo) And (strPromoAnt = 'S') And (fatVenda.strPromoc = 'S') Then
    Begin
      blnValidPromo := strCodProAnt <> fatVenda.strCodPro;
    End;

    {**************************************************}
    {* CASO POSSUI QUANTIDADE DE METRAGEM OU ESTEJA   *}
    {* EM PROMOCAO E VERIFICA QUANTIDADE LIMITE DA    *}
    {* MESMA; ENTAO, PEGA O PRECO DE VENDA NOVAMENTE  *}
    {* PARA ATUALIZAR O EDIT DE VALOR UNITARIO E A    *}
    {* VARIAVEL DE VALOR ORIGINAL DO PRODUTO.....     *}
    {**********************************************JC**}
    If blnTemEmbFec Or blnValidPromo Or blnAtualizar  Then
    Begin
      If SameText(fCfgSis('SUGVLE'), '1') Or ((fatVenda.stlItensNaoEhEstrutura.IndexOf(fCodItem) > 0) Or (Not fItemEstrutura(fCodItem))) Then
      Begin
        {*********************************}
        {* CALCULA O UNITARIO DO PRODUTO *}
        {*****************************JC**}
        fltUnitario := fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                cmbEntSai.Text[1],
                                                fStrToFloat(edtMargem.Text),
                                                Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0,
                                                'NOR',
                                                strTabelaPreco,
                                                True,
                                                fatVenda.FTaxJur,
                                                fatVenda.FUniVis,
                                                (Not fEmptyStr(strCodBarEmb)),
                                                fRetornaPrecoCodBarraEmb(edtCodIte.Text,
                                                                         strCodBarEmb,
                                                                         qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                                         strTabelaPreco,
                                                                         True),
                                                fRetornaTabPreCodBarraEmb(edtCodIte.Text, strCodBarEmb),
                                                '', (chkBrinde.Visible And chkBrinde.Checked));

        fatVenda.pCalculaValorRT(fltUnitario, fatVenda.FVal_RT);
        fatVenda.fltUniOri := fltUnitario;
      End
      Else If SameText(fCfgSis('SUGVLE'), '2') And (blnTemEmbFec) And (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) Then
      Begin
        If fItemEstrutura(fCodItem) And (fatVenda.strPromoc <> 'S') Then
        Begin
          If fCalcularDescontoEmbFechada Then
            fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(edtCodIte.Text, strTabelaPreco, fStrToFloat(edtQtdIte.Text), strCodBarEmb)
          Else
            fltPercDesEmbFec := 0.00;

          If (fltPercDesEmbFec = 0.00) Then
          Begin
            fltUnitario := fatVenda.fltUniOri;
            fatVenda.pCalculaValorRT(fltUnitario, fatVenda.FVal_RT);
          End;
        End;
      End;
    End;

    If fDestacarDescontoDaCondicaoPagamentoNoCampoDescontoDosItensEmPromocao Then
    Begin
      fatVenda.blnProCnd := False;
      
      If (fatVenda.strPromoc = 'S') And
         (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
      Begin
        fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

        If (fltDesMax > 0) Then
        Begin
          edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);

          fatVenda.blnProCnd := True;

          pEditarDesconto;
        End;
      End;
    End;

    {*********************************************}
    {* CASO POSSUI QUANTIDADE EMBALAGEM FECHADA  *}
    {*****************************************JC**}
    If blnTemEmbFec And (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) Then
    Begin
      {*******************************************************************}
      {* VERIFICA SE EH MULTIPLO DE EMBALAGEM FECHADA (PORTANTO NAO ESTA *}
      {* EM PROMOCAO); SE FOR, APLICA O DESCONTO PARA EMBALAGEM FECHADA  *}
      {***************************************************************JC**}
      If fEhEmbalagemFechadaItem(edtCodIte.Text, strTabelaPreco, fStrToFloat(edtQtdIte.Text)) And (fatVenda.strPromoc <> 'S') Then
      Begin
        If fCalcularDescontoEmbFechada Then
          fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(edtCodIte.Text, strTabelaPreco, fStrToFloat(edtQtdIte.Text), strCodBarEmb)
        Else
          fltPercDesEmbFec := 0.00;

        fltUnitario := ( fltUnitario * ( 1 - ( fltPercDesEmbFec / 100 ) ) );
        fltUnitario := fFormataFloat(fltUnitario, fatVenda.VS_intDecUni);
        fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(VS_strCodEmp, edtCodIte.Text, strTabelaPreco, '', fStrToFloat(edtQtdIte.Text), fltPercDesEmbFec);
      End;
    End;

    If Not fEmptyStr(strCodBarEmb) And fCfgSis('PRVEMB', VarBoolean) Then
    Begin
      If fRetornaPrecoCodBarraEmb( edtCodIte.Text, strCodBarEmb, qryConIte.FieldByName('ITE_CODEMP').AsString, strTabelaPreco, False ) > 0 Then
        blnTemEmbFec := True;
    End;

    {*****************************************************}
    {* CASO POSSUI QUANTIDADE DE METRAGEM OU ESTEJA      *}
    {* EM PROMOCAO E VERIFICA QUANTIDADE LIMITE DA MESMA *}
    {**************************************************JC*}
    If blnTemEmbFec Or blnValidPromo Or blnAtualizar Then
    Begin
      {*******************************************}
      {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
      {* APLICA O PERCENTUAL DE DESCONTO         *}
      {****************************************MV*}
      If (fatVenda.strCAbDes = 'S') And
         (fCfgSis('CNDVEN') = 'I') And
         (fatVenda.strStatus <> 'C') And
         ((fatVenda.strPromoc <> 'S') Or (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
         (Not fAplicarTaxaJurosPrecoDigitado) Then
      Begin
        {********************************************************************}
        {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
        {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
        {****************************************************************MM**}
        fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

        If fCfgSis('DESCND',varBoolean) Then
        Begin
          If (fatVenda.strDstCnd = 'S') Then
          Begin
            fltUnitario := fltUnitario;
            edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
          End
          Else
            fltUnitario := fltUnitario;

        End
        Else If (fatVenda.strCodFpg = '007') Then
        Begin
          If (fatVenda.strAbDeCc = 'S') Then
            fltUnitario :=  fltUnitario - fatVenda.fRetornaVrDesconto(2, fltUnitario, fltDesMax);
        End
        Else
          fltUnitario := fltUnitario - fatVenda.fRetornaVrDesconto(2, fltUnitario, fltDesMax);

        fltUnitario := fFormataFloat(fltUnitario, fatVenda.VS_intDecUni);
      End;

      If fAplicarDescontoRessarcimentoCAT Then
      begin
        fltUnitario := fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fltUnitario);
      end;

      if (fCfgSis('RATEST', varString) = 'C') then
      begin
        fltUnitario := fRetornaValorEstrutura(edtCodIte.Text ,fltUnitario ,StrToIntDef(strTabPre,1));
      end;

      {****************************************}
      {* ATUALIZA O VALOR UNITARIO DO PRODUTO *}
      {*************************************MV*}
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUnitario);
    End;

    {*****************************}
    {* ATUALIZA O PREÇO DE CUSTO *}
    {**************************MM*}
    fatVenda.pCarregaValoresCusto(fCodItem,
                                  qryConIte.FieldByName('ITE_CODEMP').AsString,
                                  fTabelaPrecoItem);

    strNotUltCat17 := '';
    fltDedCus := 0;
    If (Pos(fCfgSis('MCAT17'),'D_A_C_M_V_') > 0) Then
      fltDedCus := fatVenda.fRetornaPrecoCustoDeduzindoRessarcimentoCAT(
                                             fCodItem,
                                             fRetEmpresaItem,
                                             fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)),
                                             qryConCit.FieldByName('ITE_CODFOR').AsString,

                                             IIF(((fatVenda.strIdePro = 'NOR') And
                                                  (fatVenda.strPromoc = 'S') And
                                                  (fatVenda.fltProPreCus > 0) and
                                                  (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao)),
                                                fatVenda.fltProPreCus,
                                                fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)),

                                             strNotUltCat17);

    If (fatVenda.strIdePro = 'NOR') And
       (fatVenda.strPromoc = 'S') And
       (fatVenda.fltProPreCus > 0) and
       (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
    begin
      fltCusIte := IIF((fltDedCus > 0), fltDedCus, fatVenda.fltProPreCus)
    end
    Else
      fltCusIte := fatVenda.fRetornaPrecoCusto(Preco_de_Custo,
                                               fCodItem,
                                               fRetEmpresaItem,
                                               IIF((fltDedCus > 0), fltDedCus, fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)),
                                               '',
                                               Nil,
                                               (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));

    fltCusIte := fatVenda.fRetPreCus(fltCusIte);

    pCalculaPrecoCusto(qryConIte, fStrToFloat(edtUnitar.Text), fltCusIte,
                       (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0),
                       fEhItemVendaVidro(qryConIte.FieldByName('ITE_CODITE').AsString),
                       IIf(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                              qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte), fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)));

  End;

  pCarregaDescontoNegociacaoCliente(fatVenda.strIdePro);
  pAtualizaUnitarioLiquido;

end;

procedure TfrmFatVendas.pAtualizaVendedorInativoDosItens(venVenRep: TVenRep; strCodIteVenInat, strCodIteRepInat: String; blnAlteracaoGeral: Boolean = False);
  Var
    intRecNo  : Integer;
    strFilter : String;
    blnFiltered: Boolean;
    prcScroll: TprcScroll;
begin
  if cdsVenda.IsEmpty then
    Exit;

  intRecNo := cdsVenda.RecNo;
  strFilter   := cdsVenda.Filter;
  blnFiltered := cdsVenda.Filtered;
  pDisableControls(cdsVenda, prcScroll);
  try

    cdsVenda.First;
    while not cdsVenda.Eof do
    begin
      if (not blnAlteracaoGeral) then
      begin
        if (venVenRep = venVendedor) and (Pos(cdsVenda.FieldByName('ITE_CODITE').AsString, strCodIteVenInat) = 0) then
        begin
          cdsVenda.Next;
          Continue;
        end
        else if (venVenRep = venRepresentante) and (Pos(cdsVenda.FieldByName('ITE_CODITE').AsString, strCodIteRepInat) = 0) then
        begin
          cdsVenda.Next;
          Continue;
        end;
      end;

      cdsVenda.Edit;
      cdsVenda.FieldByName(IIF(venVenRep = venVendedor, 'ITE_CODVEN', 'ITE_CODVE2')).AsString := IIF(venVenRep = venVendedor,
                                                                                                     fatVenda.strCodVen,
                                                                                                     fatVenda.strCodVe2);
      cdsVenda.Post;

      cdsVenda.Next;
    end;
  finally
    cdsVenda.Filter   := strFilter;
    cdsVenda.Filtered := blnFiltered;
    cdsVenda.RecNo := intRecNo;

    pEnableControls(cdsVenda, prcScroll);
  end;
end;

