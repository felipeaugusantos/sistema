  Begin
    If pnlDadosFazenda.Visible Then
      pnlDadosAdicionais.Height := pnlDadosAdicionais.Height - pnlDadosFazenda.Height;

    pnlDadosFazenda.Visible := False;
    pnlDadosFazenda.Caption := '';
  End
  Else
  Begin
    If Not pnlDadosFazenda.Visible Then
