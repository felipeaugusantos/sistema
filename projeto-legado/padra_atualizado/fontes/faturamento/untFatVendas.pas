function TfrmFatVendas.fSelecionouUmaNf: Boolean;
  Var
    cdsDados: TUniClientDataSet;
    strDoc  : String;
begin
  strDoc := '';
  Result := True;  

  cdsDados := TUniClientDataSet.Create(Self);
  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;

  cdsDados.First;
  While Not cdsDados.Eof Do
  Begin
    If (((Not fEmptyStr(strDoc)) And
        (strDoc <> (cdsDados.FieldByName('ITE_DOCDEV').AsString + cdsDados.FieldByName('ITE_ESPDEV').AsString))) Or
        (cdsDados.FieldByName('ITE_ESPDEV').AsString <> 'NF')) Then
    Begin
      cdsDados.Last;
      Result := False;
    End;

    strDoc := cdsDados.FieldByName('ITE_DOCDEV').AsString + cdsDados.FieldByName('ITE_ESPDEV').AsString;
    cdsDados.Next;  
  End; 

  FreeAndNil(cdsDados);
end;

