    Result := (Pos(strOpcDoc, 'OR_PD_') > 0) And
              (fCfgSis('ALTTIF', varString) = 'S');
  end;

  function fItemSelecionadoEhItemTinta():Boolean;
  begin
    Result := (Not cdsVenda.IsEmpty) And
              (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR');
  end;

begin
