function TfrmFatVendas.fValidaEspecieVendaPresencial: Boolean;
  Var
    strEspeciesPermitidas: String;
begin
  Result := True;

  If Not fatVenda.blnVendaPresencial Then
    Exit;

  If Not fatVenda.fValidaEspecieVendaPresencial(fatVenda.strEspDoc, strEspeciesPermitidas) Then
  Begin
    pMensagemOk(Format(MSG_ESPECIES_PERMITIDAS_VENDA_PRESENCIAL, [strEspeciesPermitidas]));
