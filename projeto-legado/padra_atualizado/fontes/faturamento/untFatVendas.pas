{*********************************************************}
{* NESSA PROCEDURE, A VARIAVEL "dicRetorno" ENVIA OS PA- *}
{* RAMETROS PARA A FUNCAO DE PRECOS, E RECEBE OS RESUL-  *}
{* TADOS RETORNADOS QUE SAO USADOS NO FATURAMENTO        *}
{******************************************************MV*}
procedure TfrmFatVendas.btnTintaMaquinaClick(Sender: TObject);
  Var
    strIdePro: String;
    fltPreVen,
    fltDesMax: Double;
    strOpcPreTin: String;
    blnProPreTin: Boolean;
    blnUsaPreMedTin,
    blnUsaPreCusTin: Boolean;
    strEmpSalResTin: String;
    strTabPreTin: String;
    strUnidadTin: String;

    function fJaSelecionouPrecoTE: Boolean;
    begin
      Result := fCfgSis('ESCPTE', varBoolean) And
                fatVenda.blnCliFil And (Not fEmptyStr(fatVenda.strPreETe));
    end;

begin
  inherited;

  HintControler.HideHint;

  //Req 119454
  If intExcluindoProduto <> -1 Then
  Begin
    Exit;
  End;

  If intConfirmando <> -1 Then
  Begin
    Exit;
  End;

  If fEmptyStr(edtCodCli.Text) Then
  Begin
    fMensagem('ATENÇÃO!', 'O código do cliente deve ser preenchido!', ['&O k']);
    Exit;
  End;

  If (Not btnTintaMaquina.Enabled) Or (Not btnTintaMaquina.Visible) Then
    Exit;

  If (Assigned(ActiveControl)) And (ActiveControl.Parent <> pnlItemCodigo) And (ActiveControl <> dbgItens) Then
    Exit;

  If btnCancelaItem.Enabled Then
    btnCancelaItemClick(btnTintaMaquina);

  blnUsaPreCusTin := (fatVenda.blnCliFil And (fatVenda.strTEPREV = 'CUS') And (fatVenda.strPromoc <> 'S')) Or
                     (fatVenda.blnCliFil And (fatVenda.strTEPPRO = 'CUS') And (fatVenda.strPromoc = 'S')) Or
                     ((fCfgSis('PROSOE') = 'C') And (Pos(strOpcDoc, 'OU_OF_') > 0)) Or
                     ((fCfgSis('PROENT') = 'C') And (Pos(strOpcDoc, 'OE_EF_') > 0)) Or
                     (Pos(strOpcDoc, '_OV_PI_') > 0) Or
                     ((strOpcDoc = 'BR') And (fCfgSis('SUG_BR') = '1') Or
                     ((strOpcDoc = 'VN') And (fCfgSis('SUG_BR') = '1') And chkBrinde.Visible And chkBrinde.Checked));

   blnUsaPreMedTin := ((fCfgSis('PROSOE') = 'M') And (Pos(strOpcDoc, 'OU_OF_') > 0)) Or
                      ((fCfgSis('PROENT') = 'M') And (Pos(strOpcDoc, 'OE_EF_') > 0));

  blnProPreTin := (fCfgSis('PROPRE') = TRegraPrecoSugestao.PrecoDeTabela.Valor.ToString);

  Try
    dbgItens.Enabled := False;

    strIdePro := fEscolheTintaNovo(fatVenda.strCodCli);
  Finally
    dbgItens.Enabled := True;
  End;

  if strIdePro = '' then
    Exit;

  If (strIdePro = 'ACA') And chkEntCD.Visible And chkEntCD.Checked Then
    strEmpSalResTin := fatVenda.fEmpresaSaldoMatriz_CD
  Else
    strEmpSalResTin := VS_strCodEmp;

  If (Pos(strOpcDoc, 'OE_EF_') > 0) And (strIdePro <> 'ACA') Then
  Begin
    fMensagem('','Apenas permitido Produtos Acabados para Outras Entradas!',['&OK']);
    Exit;
  End;

  If (strOpcDoc = 'OF') And (strIdePro <> 'ACA') Then
  Begin
    fMensagem('','Apenas permitido Produtos Acabados para Outras Saídas - Fornecedor!',['&OK']);
    Exit;
  End;

  If (strOpcDoc = 'PA') And (strIdePro = 'ACA') Then
  Begin
    fMensagem('','Não é permitido Produtos Acabados para "Ordem de Produção Avulsa de Produtos Tintométricos"!',['&OK']);
    Exit;
  End;

  If (strOpcDoc = 'OU') And (strIdePro <> 'ACA') And (fCfgSis('PROSOE') = 'M') then
  Begin
    fMensagem('','Apenas permitido Produtos Acabados para "Outras Saídas de Cliente" quando o parâmetro [CFG_PROENT] estiver marcado "Médio!"',['&OK']);
    Exit;
  End;

  If Not fatVenda.fTabelasConfiguradasCorretamente(strIdePro, strCodAca) Then
  Begin
    fMensagem('ATENÇÃO','Tabela de geração da tinta não está ativa no faturamento !' + #13#10 +
                        'Favor verificar tabela de geração no Auttin.' + #13#10 +
                        'Favor verificar o parâmetro CFG_TABPRC.'  ,['&OK']);
    Exit;
  End;

  fltPreVen := 0;
  fltDesMax := 0;

  strTabPreTin := fatVenda.fDefineTabelaPrecoItem(strIdePro, strCodAca);

  strOpcPreTin := fatVenda.strPreETe;

  If fJaSelecionouPrecoTE Then
  Begin
    If CharInSet(RightStr(fatVenda.strPreETe, 1)[1], ['1'..'9']) Then
    Begin
      blnUsaPreCusTin := False;
      strTabPreTin := RightStr(fatVenda.strPreETe, 1);
    End
    Else
      blnUsaPreCusTin := (fatVenda.strPreETe = 'CUS');
  End;

  If (strIdePro <> 'NOR') Then
  Begin

    If fatVenda.fPodeUtilizarTinta(strIdePro) Then
    Begin

      {*******************************************}
      {* LIMPA O RETORNO                         *}
      {****************************************MV*}
      dicRetorno.Limpar;

      {*******************************************}
      {* ALIMENTA A VARIAVEIS USADAS NA FUNCAO   *}
      {****************************************MV*}
      dicRetorno['idepro']    := strIdePro;
      dicRetorno['codemp']    := strEmpSalResTin;
      dicRetorno['opcdoc']    := strOpcDoc;
      dicRetorno['oprflj']    := edtOprFlj.Text;
      dicRetorno['empprd']    := fCfgSis('EMPPRD');
      dicRetorno['emp_cd']    := fCfgSis('EMP_CD');
      dicRetorno['Cd_S_N']    := IIF(chkEntCD.Checked, 'S', 'N');
      dicRetorno['empfat']    := fatVenda.fGetEmpPrecoVendaItemTinta(edtCodEmp.Text);
      dicRetorno['FatS_N']    := IIF(fatVenda.blnEmpFat, 'S', 'N');
      dicRetorno['usaprecus'] := blnUsaPreCusTin;
      dicRetorno['usapremed'] := blnUsaPreMedTin;
      dicRetorno['tippre']    := strTipPre;
      dicRetorno['lazqua']    := intLazQua;
      dicRetorno['tipemb']    := strTipEmb;
      dicRetorno['qtdemb']    := intQtdEmb;

      dicRetorno['tabpre']    := strTabPreTin; //Precisa Apenas ser passado para a DLL

      dicRetorno['linha_']    := strLinTin;
      dicRetorno['catali']    := strCatalize;
      dicRetorno['porper']    := strPorPer;
      dicRetorno['codcli']    := fatVenda.strCodCli;
      dicRetorno['przmed']    := fatVenda.intPrzMed;
      dicRetorno['codcnd']    := fatVenda.strCodCnd;
      dicRetorno['propre']    := blnProPreTin ;

      dicRetorno.AdicionarObjeto('calculadorFatVendas', TFatVendasCalculadorWrapper.Create(fatVenda));
      dicRetorno.AdicionarObjeto('calculadorFatVendasTAB', TFatVendasCalculadorWrapperTAB.Create(fatVenda));

      Try
        dbgItens.Enabled := False;

        {*******************************************************************}
        {* É NECESSARIO QUE ALTERE A EMPRESA DA DLL DE TINTA DE MAQUINA    *}
        {* PARA QUE CALCULE CORRETAMENTE OS PRECOS DE ACORDO COM A EMPRESA *}
        {* QUE IRA FATURAR O PRODUTO (DARKA).                              *}
        {***************************************************************JC**}
        pSetaEmpresaLogadaTinta(dicRetorno['codemp']);

        //Habilitando edit para tinta de maquina
        edtCodIte.Enabled := True;

        If fRetornaPreco(Self, qryTinta, fatVenda.qryTintaAux, dicRetorno, True, Not fEstaNaConsultaTab, sltItems) Then
        Begin
          fatVenda.blnTintaMaquinaEmExecussao := True;
          pExecutaRetornoPrecoTintadeMaquina(blnUsaPreCusTin, strIdePro, strTabPreTin,
                                             strUnidadTin, fltPreVen, fltDesMax,
                                             strEmpSalResTin, strOpcPreTin, dicRetorno,
                                             qryTinta, blnProPreTin);

          If fCfgSis('TMQLOT', varBoolean) Then
          Begin
            If Not fValidaLoteEmbalagemColorantesLocal Then
            Begin
              If btnCancelaItem.Enabled Then
                btnCancelaItem.Click;
            End
            Else
              SelectNext(edtCodIte, True, True);
          End
          Else 
            SelectNext(edtCodIte, True, True);
        End
        Else
        Begin
          {**********************************************}
          {* NECESSARIO PARA NAO ZERAR UNITÁRIO DO ITEM *}
          {*******************************************AC*}
          fatVenda.strIdePro := '';
          pSetFocus(edtCodIte);
        End;
      Finally
        {**********************************************************}
        {* DEVE VOLTAR A EMPRESA LOGADA NOVAMENTE NA DLL DA TINTA *}
        {*  >>> ATENCAO: NAO REMOVER ESTA FUNCAO DO FINNALY <<<   *}
        {******************************************************JC**}
        pSetaEmpresaLogadaTinta(VS_strCodEmp);
        dbgItens.Enabled := True;
      End;
    End
    Else
    Begin
      fatVenda.strIdePro := '';
      fMensagem('ATENÇÃO!', 'Não é permitido vender uma tinta ' + fRetornaNomeTinta(strIdePro) +
                            ' sem utilizar produção fora da loja.', ['&Ok']);
    End;
  End;

end;

