function TfrmFatVendas.fConfirmaCupomFiscal: Boolean;
  Var
    objConfCupom: TConfirmacaoCupom;
    frmFatConfCupomFiscal : TfrmFatConfCupomFiscal;
begin
  If Not btnConfirma.Enabled Then
  Begin
    Result := False;
    Exit;
  End;

  pEnabledFechamento(False);

  Try
    frmFatVendas.Enabled := False;

    objConfCupom := TConfirmacaoCupom.CreateInstance(Self, fatVenda);

    Try
      pCriarFormularios(TfrmFatConfCupomFiscal, frmFatConfCupomFiscal);

      frmFatConfCupomFiscal.objConfCupom := objConfCupom;

      frmFatConfCupomFiscal.fatVenda := fatVenda;
      frmFatConfCupomFiscal.showModal;

      Result := frmFatConfCupomFiscal.blnConfirma;

      If Result Then
      Begin
        fatVenda.strNotEspConf := objConfCupom.strConfirmacaoCupomEspecial;
        fatVenda.strCliFat := frmFatConfCupomFiscal.edtCodCli.Text;

        If frmFatConfCupomFiscal.edtCliFat.Text <> fatVenda.strCodCli Then
        Begin
          fatVenda.strCodCli := '';
          edtCodCli.Text     := frmFatConfCupomFiscal.edtCliFat.Text;
          pCarregaCliente;
        End;

        pMostrarDadosFazendaRodape(False);

        If fCfgSis('CADFAZ', VarBoolean) And Not fEmptyStr(objConfCupom.strCodFaz) Then
        Begin
          If fatVenda.fSelecionarFazendaCliente(edtCodCli.Text, objConfCupom.strCodFaz) Then
          Begin
            pMostrarDadosFazendaRodape(True);
          End;
        End;

        If (Not fEmptyStr(objConfCupom.strCodEmb)) And (fCfgSis('CADEMB', VarBoolean)) Then Begin
          fatVenda.strCodEmbarcacao := objConfCupom.strCodEmb;
          pMostrarDadosEmbarcacaoRodape(True);
        End Else Begin
          pMostrarDadosEmbarcacaoRodape(False);
        End;

        {******************************************}
        {* VERIFICA A ORIGEM DA COND.\FORMA PAGTO *}
        {* CAD. CLIENTE OU DOCUMENTO              *}
        {***************************************JB*}
        If Not fCfgSis('CFICPG', varBoolean) Then
        Begin

          If Not fEmptyStr(objConfCupom.strTipoFrete) Then
            fatVenda.strTipFre := objConfCupom.strTipoFrete;

          If fCfgSis('USACND', varBoolean) Then
          Begin
            edtCodCnd.Text := objConfCupom.strCodigoCondicaoPagamento;
            strCcnAnt      := edtCodCnd.Text;
            pCarregaCondicao;
          End;

          If fatVenda.VS_blnUsaFpg THen
          Begin
            edtForPag.Text := objConfCupom.strCodigoFormaPagamento;
            strFpgAnt      := edtForPag.Text;
            pCarregaForPag;
          End;

          mskCndPag.Text   := objConfCupom.strCondicaoPagamento;
          fatVenda.FConPag := objConfCupom.strCondicaoPagamento;

          If (Not fCfgSis('INFIEL', varBoolean)) Or
             ((fatVenda.strOpcDoc = 'CI') And (fCfgSis('PROCTR') = '1')) Then
          Begin

            If Not fEmptyStr(fTiraCaracEspeciais(mskCndPag.Text)) Then
            Begin
              mskCndPag.ReadOnly := True;
              mskCndPag.TabStop  := False;
            End;

            If Not fEmptyStr(edtForPag.Text) Then
            Begin
              edtForPag.ReadOnly := True;
              edtForPag.TabStop  := False;
            End;

            If Not fEmptyStr(edtCodCnd.Text) Then
            Begin
              edtCodCnd.ReadOnly := True;
              edtCodCnd.TabStop  := False;
            End;

          End;

        End;

      End
      Else
        pEnabledFechamento(True);

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fConfirmaCupomFiscal]');
      End;
    End;

    FreeAndNil(objConfCupom);    

    pFreeAndNil(frmFatConfCupomFiscal);

  Finally
    frmFatVendas.Enabled := True;
  End;

end;

function TfrmFatVendas.fConfirmaNotaConcreto: Boolean;
  Var
    objConfNotaConcreto: TConfirmacaoNotaConcreto;

    strCodCndTmp: String;
    strConPagTmp: String;
    strCodFpgTmp: String;

    procedure pBackupVariaveis;
    Begin
      strCodCndTmp := fatVenda.strCodCnd;
      strConPagTmp := fatVenda.strConPag;
      strCodFpgTmp := fatVenda.strCodFpg;
    End;

    procedure pRestauraVariaveis;
    Begin
      fatVenda.strCodCnd := strCodCndTmp;
      fatVenda.strConPag := strConPagTmp;
      fatVenda.strCodFpg := strCodFpgTmp;
    End;
begin
  If Not btnConfirma.Enabled Then
  Begin
    Result := False;
    Exit;
  End;

  pEnabledFechamento(False);

  Try
    frmFatVendas.Enabled := False;

    objConfNotaConcreto := TConfirmacaoNotaConcreto.CreateInstance(Self, fatVenda);

    Try
      pCriarFormularios(TfrmFatConfNotaConcreto, frmFatConfNotaConcreto);

      frmFatConfNotaConcreto.objConfNotaConcreto := objConfNotaConcreto;

      frmFatConfNotaConcreto.fatVenda := fatVenda;
      frmFatConfNotaConcreto.showModal;

      Result := frmFatConfNotaConcreto.blnConfirma;

      If Result Then
      Begin

        If (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO) Then
          fatVenda.strCliFat := fRetornaClienteFilial(VS_strCodEmp);

        If frmFatConfNotaConcreto.edtCliFat.Text <> fatVenda.strCodCli Then
        Begin
          pBackupVariaveis;
          fatVenda.strCodCli := '';
          edtCodCli.Text     := frmFatConfNotaConcreto.edtCliFat.Text;
          pCarregaCliente;
          pRestauraVariaveis;
        End;
      End
      Else
        pEnabledFechamento(True);

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fConfirmaNotaConcreto]');
      End;
    End;

    FreeAndNil(objConfNotaConcreto);

    pFreeAndNil(frmFatConfNotaConcreto);

  Finally
    frmFatVendas.Enabled := True;
  End;

end;

