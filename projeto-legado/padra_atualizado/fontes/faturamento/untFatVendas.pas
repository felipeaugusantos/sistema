procedure TfrmFatVendas.pRecalculaPrecoParaTrava(strTabPreAtual,
  strTabPreAlterada: string);
var
  cdsVendaBkp: TUniClientDataSet;
begin
  cdsVendaBkp := TUniClientDataSet.Create(nil);
  try
    if (not cdsVenda.IsEmpty) then
    begin
      pCloneDataSet(cdsVendaBkp, cdsVenda, False, True);
      fatVenda.strTabPre := strTabPreAlterada;
      pRecalculaPrecos(False, True, False, True, EmptyStr, False, False, False, False, False, False, True);
      fatVenda.pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, Nil, True);
      pCloneDataSet(cdsVenda, cdsVendaBkp, False, True);
      fatVenda.strTabPre := strTabPreAtual;
      pRecalculaPrecos(False, True, False, True, EmptyStr, False, False, False, True, False, False, True);
    end;
  finally
    FreeAndNil(cdsVendaBkp);
  end;
end;

procedure TfrmFatVendas.pRecalculaPrecos(blnVerUniOri             : Boolean = False;
                                         blnAltTab                : Boolean = False;
                                         blnAplicaDescProfiss     : Boolean = False;
                                         blnRecalculaTabelaTintas : Boolean = True;
                                         strPromocaoColetiva      : String  = '';
                                         blnSomentePromocao       : Boolean = False;
                                         blnSomenteSaidaPromocao  : Boolean = False;
                                         blnSomenteEntradaPromocao: Boolean = False;
                                         blnManterPrecoDigitado   : Boolean = False;
                                         blnZerarDescontoDoItem   : Boolean = False;
                                         blnSomentePrecosComCotacaoDolar: Boolean = False;
                                         blnRecalculoParaTrava    : Boolean = False;
                                         intSeqItemEstrutura      : Integer = 0;
                                         blnSomenteItensTinta     : Boolean = False;
                                         blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado: Boolean = False;
                                         blnRecalculandoPrecosAbaDep: Boolean = False;
                                         blnRecalculaItemKit      : Boolean = False;
                                         blnSomentePromocaoQtdMin : Boolean = False;
                                         blnManterDescontoItemEstruturaPromoc: Boolean = False);
  Var
    intRecNo : Integer;
    prcScroll: TprcScroll;
    strRshTinAtualAux: String;
begin
  If (Pos(strOpcDoc, 'CF_CI_CN_CT_CO_MF_DV_PR_DD_') > 0) Or
     (fatVenda.blnComVal) Then
    Exit;

  If (blnConEqu) And (strOpcDoc = 'OU') And (Not fEmptyStr(strAutincIteRemessa)) Then
    Exit;

  If cdsVenda.IsEmpty Then
    Exit;

  intRecNo := 0;

  strRshTinAtualAux := TProQtdColetiva.strRshTinAtual;
  Try
    pDisableControls(cdsVenda, prcScroll);
    intRecNo := cdsVenda.RecNo;
    pgbProgresso.Visible  := False;  
    fatVenda.pgbProgresso := nil;

    Self.blnVerUniOriRecalculoPrecos   := blnVerUniOri;
    Self.blnAltTabRecalculoPrecos      := blnAltTab;
    Self.blnDescProfissRecalculoPrecos := blnAplicaDescProfiss;
    Self.blnZerarDescontoDoItemRecalculoPrecos := blnZerarDescontoDoItem;
    Self.blnRecalcularSomentePrecosComCotacaoDolar := blnSomentePrecosComCotacaoDolar;
    Self.blnRecalculaTabelaTintasPrecos:= blnRecalculaTabelaTintas;
    Self.blnRecalcularSomenteItensTinta:= blnSomenteItensTinta;
    Self.blnManterPrecoDigitado        := blnManterPrecoDigitado;
    Self.strCodigoPromocaoColetiva     := strPromocaoColetiva;
    Self.blnRecalculaSomenteItensQueEntraramOuSairamDePromocao := blnSomentePromocao;
    Self.blnRecalculaSomenteItensQueSairamDePromocao := blnSomenteSaidaPromocao;
    Self.blnRecalculaSomenteItensQueEntraramEmPromocao := blnSomenteEntradaPromocao;
    Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado := blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado;
    Self.intSeqItemEstruturaRecalcular := intSeqItemEstrutura;
    Self.blnRecalculoParaTrava := blnRecalculoParaTrava;
    Self.blnRecalculandoPrecosAbaDep := blnRecalculandoPrecosAbaDep;
    Self.blnRecalculaItemKit := blnRecalculaItemKit;
    Self.blnRecacularItensPromocaoQtdMin := blnSomentePromocaoQtdMin;
    Self.blnManterDescontoItemEstruturaPromoc := blnManterDescontoItemEstruturaPromoc;

    fChamaTelaGravando(fRecalculaPrecosInterna);

  Finally
    TProQtdColetiva.strRshTinAtual := strRshTinAtualAux;

    If (intRecNo <= cdsVenda.RecordCount) Then
      cdsVenda.RecNo := intRecNo
    Else
      cdsVenda.Last;

    pEnableControls(cdsVenda, prcScroll);
    fatVenda.pgbProgresso := pgbProgresso;
  End;
end;

procedure TfrmFatVendas.pRemoveEstruturaItem(strCodIte, strCodEmp : String; intSeqEst : Integer);
var
  qryEstrutura: TUniQuery;
  strCodIteSelecionado : String;
  strCampoSubItem: String;
begin
  qryEstrutura := fCriaQuery;

  strCodIteSelecionado := cdsVenda.FieldByName('ITE_CODITE').AsString;
  strCampoSubItem := IIF((Pos(strOpcDoc, 'TE_') > 0), 'TRASUB', 'VENSUB');
  try

    qryEstrutura.Close;
    qryEstrutura.SQL.Clear;
    qryEstrutura.SQL.Add(fatVenda.fGetSQLSubItensEstruturas);
    qryEstrutura.ParamByName('CODITE').AsString := strCodIte;
    qryEstrutura.ParamByName('CODEMP').AsString := strCodEmp;
    qryEstrutura.Open;

    while not qryEstrutura.Eof do
    begin

      {Definido no cadastro de produtos!}
      If (fCfgSis(strCampoSubItem, varString) = 'P') And
         (strCodIteSelecionado <> qryEstrutura.FieldByName('DMT_ITESUB').AsString) Then
      Begin

        If (fCampoTabela('ITE_' + strCampoSubItem, 'CADITE', ['ITE_CODITE'], [qryEstrutura.FieldByName('DMT_ITESUB').AsString]) <> 'S') Then
          If cdsVenda.Locate('ITE_CODITE;ITE_SEQEST', VarArrayOf([qryEstrutura.FieldByName('DMT_ITESUB').AsString, intSeqEst]), []) Then
            TfrmGravando.fExecutarModal(pDeletaItemAndCalculaTotais, 'Aguarde, Deletando item ...', '');

      End
      Else
      Begin

        If cdsVenda.Locate('ITE_CODITE;ITE_SEQEST', VarArrayOf([qryEstrutura.FieldByName('DMT_ITESUB').AsString, intSeqEst]), []) Then
          TfrmGravando.fExecutarModal(pDeletaItemAndCalculaTotais, 'Aguarde, Deletando item ...', '');

      End;

      qryEstrutura.Next;

    end;

  finally
    FreeAndNil(qryEstrutura);
  end;

end;

procedure TfrmFatVendas.pRecalculaPrecoSubItensEstruturaRateado;
  Var
    objItensEstrutura: TItensEstrutura;
    subItem: TSubItemEstrutura;
    stlEstrutPai: TStringList;
    strCodPai,
    strEstrut,
    strTabPre: String;
    fltPreVen: Double;
    intItem: Integer;
begin
  objItensEstrutura := TItensEstrutura.Create;
  stlEstrutPai := TStringList.Create;
  cdsVenda.DisableControls;

  Try
    stlEstrutPai.Sorted := True;
    stlEstrutPai.Duplicates := dupIgnore;

    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      If Not fEmptyStr(cdsVenda.FieldByName('ITE_ITEEST').AsString) Then
        stlEstrutPai.Add(cdsVenda.FieldByName('ITE_ITEEST').AsString + '_' + cdsVenda.FieldByName('ITE_TABPRE').AsString);

      cdsVenda.Next;
    End;

    For strEstrut In stlEstrutPai Do
    Begin
      strCodPai := Copy(strEstrut, 1, Pos('_', strEstrut) - 1);
      strTabPre := Copy(strEstrut, Pos('_', strEstrut) + 1, 3);

      if (Pos(strTabPre, '1234567') <= 0) then
        strTabPre := '';

      qryConIte.Close;
      qryConIte.ParamByName('CODITE').AsString := strCodPai;
      qryConIte.ParamByName('CODEMP').AsString := fatVenda.fGetEmpPrecoVendaItem(fRetEmpresaItem);
      qryConIte.Open;

      fltPreVen := fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem, 'S', fStrToFloat(edtMargem.Text), False, 'NOR', strTabPre);

      objItensEstrutura.pCarregarEstrutura(strCodPai, 1, fatVenda.fGetEmpPrecoVendaItem(fRetEmpresaItem));
      objItensEstrutura.pAcertarPrecos(fltPreVen);

      For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
      Begin
        subItem := objItensEstrutura[intItem];

        If cdsVenda.Locate('ITE_ITEEST;ITE_CODITE', VarArrayOf([strCodPai, subItem.strCodigo]), []) Then
        Begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_UNIDIG').AsFloat := subItem.fltPreVen;
          cdsVenda.FieldByName('ITE_UNITAR').AsFloat :=
            fFormataFloat(cdsVenda.FieldByName('ITE_UNIDIG').AsFloat * (1 - (cdsVenda.FieldByName('ITE_DESCON').AsFloat / 100)), fatVenda.VS_intDecUni);
          cdsVenda.FieldByName('ITE_TOTITE').AsFloat :=
            fFormataFloat(cdsVenda.FieldByName('ITE_UNITAR').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat, 2);
          cdsVenda.Post;
        End;
      End;
    End;
  Finally
    cdsVenda.EnableControls;
    FreeAndNil(stlEstrutPai);
    FreeAndNil(objItensEstrutura);
  End;
end;

