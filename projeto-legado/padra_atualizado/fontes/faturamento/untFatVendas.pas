    {* AS MENSAGENS DO PEDIDO                              *}
    {****************************************************RV*}
    If (Not blnCarregandoAutSer) And (strOpcDoc <> 'PD')    And
       (strEspOrc = 'PD') And fCfgSis('MPEDFA', varBoolean) And
       (Not fEmptyStr(fatVenda.strMen001))                  Then
    Begin
      btnMsgPed.Visible := True;
      btnMsgPed.Click;
    End;

    If (strOpcDoc = 'PD') And (strEspOrc = 'PD') Then
      fatVenda.pExibirMensagemExpedicao;

    If (TMostraTravaMinimaHelper.fExibeTravaMinima) And
       (Not blnRecalcNaVerDivergenciaPromocao)And
       (Not blnRecalcularItens) And
       (Not blnVerificaVlrMinCndPgtoNoFinalDaVenda) Then
    Begin
      fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
        begin
          Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotGer,
                                               fatVenda.fltTotGer,
                                               fatVenda.intPrzMed,
                                               '',
                                               False,
                                               False,
                                               pgbProgresso);
        end, 'Aguarde, Verificando valor mínimo produtos ...', '');
    End;

    if blnExibeSaldoGrid then
      fChamaTelaGravando(fCarregarSaldoEmpresasGrid, 'Aguarde, Carregando saldo das lojas ...');

    If (Not fatVenda.objCopiaSegVenda.Habilitado) And (fHabilitaRecuperarVenda) Then
    Begin
      fatVenda.objCopiaSegVenda.Habilitado := True;
      fatVenda.objCopiaSegVenda.pCarregarVendaParaRecuperacao;
    End;
  End;

  If blnHerancaOrcamentoPedido Then
  Begin
    If (Not fEmptyStr(Concat(strNumOrc, strEspOrc, strEmpOrc))) Then
      fatVenda.strOrcamentoPedidoHeranca := Concat(strNumOrc, strEspOrc, strEmpOrc);
    fatVenda.blnHerancaOrcamentoPedido := True;
    fatVenda.strNumOrc := '';
    fatVenda.strEspOrc := '';
    fatVenda.strEmpOri := '';
    Self.strNumOrc     := '';
    Self.strEspOrc     := '';
    Self.strEmpOrc     := '';
  End;

  If (fatVenda.VS_blnUsaFpg) And (fCfgSis('CNDVEN') <> 'F') And (Pos(strOpcDoc, 'OF_BR_NC_DV_PR_OE_EF_UC_DD_') <= 0) Then
