{* VERIFICA OS ITENS DA TEMPORARIA PARA  *}
{* BUSCAR OS QUE PODEM TER SAIDO DA PRO- *}
{* MOCAO APOS CONDIÇÃO INFORMADA...      *}
{**************************************IV*}
function TfrmFatVendas.fVeriCalcItensForaPromocao(blnRecalculaUsandoCndNoInicio: Boolean;
                                                  blnRecalculaUsandoCndNoFim: Boolean;
                                                  blnSomenteVerificacao: Boolean = False): Boolean;
  Var
    fltUnitar,
    fltDesMax,
    fltComTbl: Double;
    fltPreEmbFec: Double;
    strIdePro: String;
    strTabela: String;
    strEmpItePro: String;
    fltQtdDis: Double;
    blnParticiona: Boolean;
    blnPromo: Boolean;

    recIteEst: TItemEstru;
    cfgSUGVLE: Integer;

    fltImcSTPV : Double;
    blnCalcST : Boolean;
    strCodSit : String;
    cdsDadosPar : TUniClientDataSet;
    fltPercDesEmbFec: Double;
    blnChamouRecalculoTabelaPrecoTinta: Boolean;
    fltComLiq,
    fltVlrCam : Double;

  function fTemItensTintaComPromocaoPorCnd: Boolean;
    Var
      cdsDados : TUniClientDataSet;
  begin
    cdsDados := TUniClientDataSet.Create(Nil);
    Try
      pCloneDataSet(cdsDados, cdsVenda);
      cdsDados.Filtered := False;
      cdsDados.Filter := 'ITE_RECPRO = ''S'' ';
      cdsDados.Filtered := True;

      Result := Not cdsDados.IsEmpty;
    Finally
      FreeAndNil(cdsDados);
    End;
  end;

  procedure pAbreQryConIte(strEmpIte: String='');
  begin
    If fEmptyStr(strEmpIte) Then
      strEmpIte := fRetEmpresaItem;

    If (qryConIte.FieldByName('ITE_CODITE').AsString <> cdsVenda.FieldByName('ITE_CODITE').AsString) Or
       (qryConIte.FieldByName('ITE_CODEMP').AsString <> fatVenda.fGetEmpPrecoVendaItem(strEmpIte)) Then
    Begin
      qryConIte.Close;
      qryConIte.ParamByName('CODITE').AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;
      qryConIte.ParamByName('CODEMP').AsString := fatVenda.fGetEmpPrecoVendaItem(strEmpIte);
      qryConIte.Open;
    End;
  end;

  function fEmpIte: String;
  Begin
    Result := IIF(fEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsVenda.FieldByName('ITE_EMPITE').AsString);
  End;

  function fEhItemEstrutPaiCujoPromocVeioDosFilhos: Boolean;
  begin
    Result := (cfgSUGVLE = 2);

    If Result Then
    Begin
      With cdsVenda Do
      Begin
        recIteEst := fEhOuCompoeEstrutura(FieldByName('ITE_CODITE').AsString);
        Result := (recIteEst.blnEstrutura) And (recIteEst.blnPrincipal) And (FieldByName('ITE_PROMOC').AsString = 'S') And (fItemSemNenhumaPromocao(FieldByName('ITE_CODITE').AsString, strEmpItePro, '', Nil, False));
      End;
    End
  end;

begin
  Result := False;
  blnPromocaoRetirada := False;

  If (Pos(strOpcDoc, 'CF_CI_CP_CN_CT_CO_MF_DV_PR_DD_') > 0) Or (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
    Exit;

  If Not fEmptyStr(fatVenda.strNumPok) Then
    Exit;

  If (Not fCfgSis('RECCND', varBoolean)) And
     (Not fCfgSis('RECPRO', varBoolean)) Then
    Exit;

  cfgSUGVLE := fCfgSis('SUGVLE', varInteger);

  With cdsVenda Do
  Begin
    cdsVenda.DisableControls;

    blnChamouRecalculoTabelaPrecoTinta := False;
    fatVenda.strAutIncAltPromocTin := IIF(blnSomenteVerificacao, 'S', '');
    If (fatVenda.fMarcaItensComPromocaoPorCnd) Then
    Begin
      If (fTemItensTintaComPromocaoPorCnd) Then
      Begin
        pRecalculaPrecos(False,
                         False,
                         False,
                         True,
                         '',
                         False,
                         False,
                         False,
                         False,
                         False,
                         False,
                         False,
                         0,
                         True);

        If (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela) Then
        Begin
          fatVenda.strAutIncAltPromocTin := ''; //Deixei restrito à TRegraPrecoSugestao.PrecoDePromocao porque não consigo testar todos os cenários com TRegraPrecoSugestao.PrecoDeTabela
          blnChamouRecalculoTabelaPrecoTinta := True;
        End;
      End;
    End;

    If (Not blnChamouRecalculoTabelaPrecoTinta) Then
    Begin
      If (Not blnSomenteVerificacao) Then
      Begin
        If (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela) Then
        Begin
          fatVenda.pRecalculaTabelasPrecoTinta(False, True{TRUE > PARA TRAZER O PREÇO DE TABELA});
          blnChamouRecalculoTabelaPrecoTinta := True;
        End;
      End;
    End;

    cdsDadosPar := TUniClientDataSet.Create(Nil);
    pCloneDataSet(cdsDadosPar, cdsVenda);
    Try

      First;
      While Not Eof Do
      Begin
        TProQtdColetiva.strRshTinAtual := FieldByName('ITE_ITETIN').AsString;

        strCodBarEmb := FieldByName('ITE_BAREMB').AsString;
        strEmpItePro := fatVenda.fGetEmpPrecoPromoItem(fEmpIte, FieldByName('ITE_EMPDMP').AsString);

        If (Not (fEhItemEstrutPaiCujoPromocVeioDosFilhos)) And
           (Not (fVendendoEstrutSugerindoValPaiRateandoEntreFilhos(FieldByName('ITE_SEQEST').AsInteger > 0))) And
           ((FieldByName('ITE_PROMOC').AsString = 'S') Or blnRecalculaUsandoCndNoInicio Or blnRecalculaUsandoCndNoFim) Then
        Begin

          {************************************}
          { DEFINI A TABELA DE PRECO DE ACORDO }
          { COM A CONFIGURACAO                 }
          {*********************************JB*}
          If FieldByName('ITE_IDEPRO').AsString = 'NOR' Then
          Begin
            If (fCfgSis('TABITE', varBoolean) Or (strOpcDoc = 'CP')) And
               (FieldByName('ITE_TABPRE').AsString <> '') Then
              strTabela := FieldByName('ITE_TABPRE').AsString
            Else strTabela := fatVenda.strTabPre;
          End
          Else
          Begin
            strTabela := fatVenda.fTabelaPrecoTinta(edtCodCli.Text, strOpcDoc, FieldByName('ITE_TABPRE').AsString, True, False, False);
          End;

          strIdePro := FieldByName('ITE_IDEPRO').AsString;

          fatVenda.strIdePro := strIdePro;

          blnItemEspecial := (Pos('ITEM ESPECIAL', FieldByName('ITE_DESORI').AsString) > 0);

          fatVenda.fltPreVe1 := FieldByName('ITE_PREVE1').AsFloat;
          fatVenda.fltPreVe2 := FieldByName('ITE_PREVE2').AsFloat;
          fatVenda.fltPreVe3 := FieldByName('ITE_PREVE3').AsFloat;
          fatVenda.fltPreVe4 := FieldByName('ITE_PREVE4').AsFloat;
          fatVenda.fltPreVe5 := FieldByName('ITE_PREVE5').AsFloat;
          fatVenda.fltPreVe6 := FieldByName('ITE_PREVE6').AsFloat;
          fatVenda.fltPreVe7 := FieldByName('ITE_PREVE7').AsFloat;
          fatVenda.fltPreLot := FieldByName('ITE_PRELOT').AsFloat;

          If FieldByName('ITE_IDEPRO').AsString = 'NOR' Then
          Begin
            fatVenda.strPromoc := 'N';

            If (fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(FieldByName('ITE_CODITE').AsString, strEmpItePro)) And (fRetornaPrecoPromocaoPelaTabIte(FieldByName('ITE_PROMOC').AsString = 'S')) Then
            Begin
              If (fRetornaPrecosPromocao(FieldByName('ITE_CODITE').AsString,
                                         edtCodCli.Text,
                                         VS_Date,
                                         FieldByName('ITE_QTDITE').AsFloat,

                                         fatVenda.fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,
                                                                  '',
                                                                  FieldByName('AUTOINCREM').AsString,
                                                                  '',
                                                                  '',
                                                                  strEmpItePro,
                                                                  False,
                                                                  False,
                                                                  False,
                                                                  False,
                                                                  False,
                                                                  '',
                                                                  '',
                                                                  '',
                                                                  cdsDadosPar),

                                         fatVenda.fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,
                                                                  '',
                                                                  FieldByName('AUTOINCREM').AsString,
                                                                  '',
                                                                  '',
                                                                  strEmpItePro,
                                                                  False,
                                                                  False,
                                                                  fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,
                                                                  True,
                                                                  False,
                                                                  '',
                                                                  '',
                                                                  '',
                                                                  cdsDadosPar),

                                         fatVenda.intPrzMed,
                                         fatVenda.fltProPreCus,
                                         fatVenda.fltProPreVen,
                                         fatVenda.fltProComVar,
                                         fatVenda.fltProComAta,
                                         fatVenda.fltProComDis,
                                         fltQtdDis,
                                         fatVenda.fltProDesF07,
                                         fatVenda.strComPro,
                                         fatVenda.strCodPro,
                                         blnParticiona,
                                         blnPromo,
                                         strTabela,
                                         fatVenda.strCodCnd,
                                         '',
                                         '',
                                         True,
                                         False,
                                         '-1',
                                         ((FieldByName('ITE_ENTRET').AsString = 'E') And (FieldByName('ITE_ENTFUT').AsString = 'N')),
                                         ((FieldByName('ITE_ENTRET').AsString = 'E') And (FieldByName('ITE_ENTFUT').AsString = 'S')),
                                         FieldByName('ITE_MOTFUT').AsString,
                                         strEmpItePro,
                                         strNumOrc,
                                         strEspOrc,
                                         Nil,
                                         False,
                                         '',
                                         objPromVlrMinTotalProdutos,
                                         '',
                                         FieldByName('ITE_SOMCOL').AsFloat)) Then
              Begin
                If (Not blnParticiona) Then
                  fatVenda.strPromoc := 'S';
              End;
            End;
          End
          Else
            fatVenda.strPromoc := FieldByName('ITE_PROMOC').AsString;

          If (Not blnSomenteVerificacao) Then
          Begin
            pEditarDesconto;
            pEditarPrecoUnitario;
          End;

          If ((FieldByName('ITE_PROMOC').AsString <> fatVenda.strPromoc) Or
              (Pos(FieldByName('AUTOINCREM').AsString, fatVenda.strAutIncAltPromocTin) > 0) Or
              (blnRecalculaUsandoCndNoInicio And (FieldByName('ITE_PROMOC').AsString = 'S'))) And
             (Not ((FieldByName('ITE_BRINDE').AsString = 'S') And (fCfgSis('ZERBRI', varString) = '1'))) Then
          Begin
            If (Not blnSomenteVerificacao) Then
            Begin
              fltComTbl := fCampoTabela('ITE_COMTB' + strTabela,
                                        'ITEGER',
                                       ['ITE_CODITE', 'ITE_CODEMP'],
                                       [FieldByName('ITE_CODITE').AsString, VS_StrCodEmp]);

              fltUnitar := fatVenda.fPegaPrecoVenda(cdsVenda,
                                                    FieldByName('ITE_EMPITE').AsString,
                                                    FieldByName('ITE_ENTSAI').AsString,
                                                    fStrToFloat(edtMargem.Text),
                                                    blnItemEspecial,
                                                    strIdePro,
                                                    strTabela,
                                                    True,
                                                    fatVenda.FTaxJur,
                                                    fatVenda.FUniVis);

              fatVenda.pCalculaValorRT(fltUnitar, fatVenda.FVal_RT);

              fatVenda.fltUniOri := fltUnitar;

              Edit;

              FieldByName('ITE_COMTBL').AsFloat := fltComTbl;

              If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
                 (Not fTemQuantEmbalagemFechada(FieldByName('ITE_CODITE').AsString)) Then
              Begin
                fatVenda.stlItensNaoTemQtdeEmbFec.Add(FieldByName('ITE_CODITE').AsString);
              End;

              {*******************************************************************}
              {* VERIFICA SE EH MULTIPLO DE EMBALAGEM FECHADA (PORTANTO NAO ESTA *}
              {* EM PROMOCAO); SE FOR, APLICA O DESCONTO PARA EMBALAGEM FECHADA  *}
              {***************************************************************JC**}
              If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
                 (fEhEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString, strTabela, FieldByName('ITE_QTDITE').AsFloat)) And (fatVenda.strPromoc <> 'S') Then
              Begin
                If (fCfgSis('TRPEMB') = '2') And
                   (Pos(strOpcDoc, 'UC_') <= 0) Then
                Begin
                  fltPreEmbFec := fatVenda.fGetUnitarioEmbalagemFechada(FieldByName('ITE_CODITE').AsString, strTabela, FieldByName('ITE_QTDITE').AsFloat,0);

                  If fltPreEmbFec > 0 Then
                  Begin
                    fltUnitar := fltPreEmbFec;
                    fatVenda.fltUniOri := fltPreEmbFec;
                  End;
                End
                Else
                Begin
                  If fCalcularDescontoEmbFechada Then
                    fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString, strTabela, FieldByName('ITE_QTDITE').AsFloat, strCodBarEmb)
                  Else
                    fltPercDesEmbFec := 0.00;

                  fltUnitar := ( fltUnitar * ( 1 - ( fltPercDesEmbFec / 100 ) ) );
                  fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(VS_strCodEmp, FieldByName('ITE_CODITE').AsString, strTabela, '', FieldByName('ITE_QTDITE').AsFloat, fltPercDesEmbFec);
                End;
              End;

              If (fatVenda.strCAbDes = 'S') And
                 (fCfgSis('CNDVEN') = 'I') And
                 (fatVenda.strStatus <> 'C') And
                 ((fatVenda.strPromoc <> 'S') Or
                  (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
                 (Not fAplicarTaxaJurosPrecoDigitado) Then
              Begin
              {********************************************************************}
                {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
                {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
                {****************************************************************MM**}
                fltDesMax := fatVenda.fRetornaDescLinGru(FieldByName('ITE_CODITE').AsString, fatVenda.strCodCnd);

                If (fatVenda.strCodFpg = '007') Then
                Begin
                  If (fatVenda.strAbDeCc = 'S') Then
                    fltUnitar :=  fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, fltDesMax);
                End
                Else
                  fltUnitar :=  fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, fltDesMax);

                fltUnitar := fFormataFloat(fltUnitar, fatVenda.VS_intDecUni);
              End;

              If fAplicarDescontoRessarcimentoCAT(FieldByName('ITE_IDEPRO').AsString) Then
              begin
                pAbreQryConIte(IIF(fFaturamentoComCustoDaEmpresaPrioridade(), FieldByName('ITE_EMPITE').AsString, ''));
                fltUnitar := fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, FieldByName('ABF_CODABF').AsString, strTabela, fltUnitar);
              end;

              FieldByName('ITE_TAXJUR').AsFloat := fatVenda.fltTaxJur;
              FieldByName('ITE_UNIVIS').AsFloat := fatVenda.fltUniVis;
              FieldByName('ITE_UNIORI').AsFloat := fatVenda.fltUniOri;
              FieldByName('ITE_UNIDIG').AsFloat := fFormataFloat(fltUnitar, fatVenda.VS_intDecUni);
              FieldByName('ITE_VAL_RT').AsFloat := fatVenda.fltVal_RT;

              If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoDigitado Then
              Begin
                fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);

                fltUnitar := fltUnitar + (fltUnitar * fatVenda.fltTaxJur / 100.0);

                FieldByName('ITE_TAXJUR').AsFloat := fatVenda.fltTaxJur;
              End;

              {***********************************}
              {* SE RETIRAR O AREDONDAMENTO DEVE *}
              {* RETIRAR NO CARREGAMENTO DO PEDI *}
              {* DO                              *}
              {********************************AF*}
              fltUnitar := fFormataFloat(fltUnitar - fatVenda.fRetornaVrDesconto(2, fltUnitar, FieldByName('ITE_DESCON').AsFloat), fatVenda.VS_intDecUni);

              FieldByName('ITE_UNITAR').AsFloat := fltUnitar;

              If (strIdePro <> 'NOR') Then
                FieldByName('ITE_PRVTIN').AsFloat := fltUnitar;

              If (FieldByName('ITE_IDEPRO').AsString = 'NOR') And
                 (Not fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString)) And
                 (FieldByName('ITE_PROACA').AsInteger <> 1) Then
              Begin
                If (fCfgSis('IMPCF4') = 'S') Then
                  FieldByName('ITE_ICMSAI').AsFloat := fatVenda.fCalculaAliquota(FieldByName('ITE_CODITE').AsString,
                                                                                 FieldByName('ITE_EMPITE').AsString,
                                                                                 FieldByName('ITE_IMPDIR').AsString);

                //Caso o produto tenha entrado ou saído de promoção deve recalcular o preco de custo (Req: 100862)
                If (Not blnItemEspecial) And
                   (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
                Begin
                  pAbreQryConIte(IIF(fFaturamentoComCustoDaEmpresaPrioridade(), FieldByName('ITE_EMPITE').AsString, ''));

                  fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                strTabela);

                  If (fatVenda.strPromoc = 'S') And (fatVenda.fltProPreCus > 0) Then
                    FieldByName('ITE_CUSITE').AsFloat := fatVenda.fltProPreCus
                  Else
                    FieldByName('ITE_CUSITE').AsFloat := fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat);

                  fatVenda.fltPreCus := FieldByName('ITE_CUSITE').AsFloat;

                  pCalculaPrecoCusto(qryConIte,
                                     FieldByName('ITE_UNITAR').AsFloat,
                                     FieldByName('ITE_CUSITE').AsFloat,
                                     blnItemEspecial,
                                     fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString),
                                     FieldByName('ITE_ICMSAI').AsFloat);

                  FieldByName('ITE_PRECUS').AsFloat := fatVenda.fltPreCus;
                  FieldByName('ITE_PRECU2').AsFloat := fatVenda.fltPreCu2;

                  FieldByName('ITE_TOTCUS').AsFloat := fatVenda.fltPreCus * FieldByName('ITE_QTDITE').AsFloat;
                  FieldByName('ITE_TOTCU2').AsFloat := fatVenda.fltPreCu2 * FieldByName('ITE_QTDITE').AsFloat;
                End;
              End;

              strCodSit := '';
              If (Not fEmptyStr(fatVenda.fTrocaUFEndEntrega)) And (Not fEmptyStr(fatVenda.GetTipAbf(FieldByName('ITE_EMPITE').AsString))) And
                 (fatVenda.fBuscaAbfIcm(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, FieldByName('ABF_CODABF').AsString, fatVenda.fTrocaUFEndEntrega)) Then
                strCodSit := fatVenda.cdsAbfIcm.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(FieldByName('ITE_EMPITE').AsString)).AsString;

              fltComLiq := 0;
              If (fatVenda.blnEmCampanha) And
                 (fCfgSis('MARMKP') = '4') Then
              Begin
                fatVenda.objCamGer.objCamDet.fVerificaProdutoCampanha(fatVenda.strCodCli,
                                                                      FieldByName('ITE_CODITE').AsString,
                                                                      EmptyStr,
                                                                      EmptyStr,
                                                                      0,
                                                                      fltVlrCam,
                                                                      fatVenda.strCodCmg,
                                                                      fltComLiq);
              End;

              fatVenda.objIcStPv.pAdd(FieldByName('ITE_CODITE').AsString,
                                      fatVenda.fGetEmpCalculoItem(FieldByName('ITE_EMPITE').AsString),
                                      fatVenda.GetTipAbf(FieldByName('ITE_EMPITE').AsString),
                                      fatVenda.fUFDestTrib(FieldByName('ITE_EMPITE').AsString),
                                      strCodSit,
                                      fltImcSTPV,
                                      blnCalcST,
                                      0,
                                      fltComLiq);

              FieldByName('ITE_MARLUC').AsFloat := fCalculaPrecoVenda(2,
                                                                      FieldByName('ITE_PRECUS').AsFloat,
                                                                      fltUnitar,
                                                                      0,
                                                                      FieldByName('ITE_ICMSAI').AsFloat + fatVenda.fAlqDifIcmsPrecoDinamico(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, FieldByName('ABF_CODABF').AsString, strCodSit, FieldByName('ITE_ICMSAI').AsFloat),
                                                                      FieldByName('ITE_IMPFED').AsFloat,
                                                                      FieldByName('ITE_DESOPE').AsFloat + fatVenda.fltDesOpeCli,
                                                                      fRetornaValCom(fltComTbl),
                                                                      fatVenda.VS_strMARMKP,
                                                                      '',
                                                                      -1,
                                                                      fltImcSTPV,
                                                                      blnCalcST,
                                                                      IIF( not fCfgSis('CLPVDI', varBoolean), fatVenda.fGetAlqDifal(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, FieldByName('ABF_CODABF').AsString, strCodSit),0),
                                                                      IIF( not fCfgSis('CLPVDI', varBoolean), fatVenda.fGetAlqFcpIcms(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, FieldByName('ABF_CODABF').AsString, strCodSit, FieldByName('ITE_ICMSAI').AsFloat, fltUnitar ),0),
                                                                      FieldByName('ITE_OUTVAL').AsFloat,
                                                                      fatVenda.fRestringirElementosMargem);


              FieldByName('ITE_TOTITE').AsFloat := fFormataFloat(FieldByName('ITE_QTDITE').AsFloat * fltUnitar, 02);

              If (fatVenda.strPromoc = 'N') And (FieldByName('ITE_PROMOC').AsString = 'S') Then
                blnPromocaoRetirada := True;

              FieldByName('FLG_STATUS').AsString := fatVenda.strStatus;
              FieldByName('ITE_PROMOC').AsString := fatVenda.strPromoc;
              FieldByName('ITE_CODPRO').AsString := fatVenda.strCodPro;

              fatVenda.pAcertaSituacaoItem(cdsVenda);

              Post;

              If (Not blnFechamentoVenda) Then
              Begin
                fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
                pCalculaCustoRealTintaMaquinaSelecionado;
              End
              Else If (Pos(FieldByName('AUTOINCREM').AsString, fatVenda.strAutIncAltPromocTin) > 0) Then
              Begin
                fatVenda.pAcertaPrecosTinta(FieldByName('AUTOINCREM').AsInteger, True);
                fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
              End;

            End;

            Result := True;

          End;

        End;

        Next;
      End;

    Finally
      If blnChamouRecalculoTabelaPrecoTinta Then
        fatVenda.pRecalculaTabelasPrecoTinta(False, False{FALSE > PARA VOLTAR O PREÇO DE PROMOÇÃO});

      cdsVenda.EnableControls;
      FreeAndNil(cdsDadosPar);
    End;

  End;

  fatVenda.fltPreVe1 := 0.0;
  fatVenda.fltPreVe2 := 0.0;
  fatVenda.fltPreVe3 := 0.0;
  fatVenda.fltPreVe4 := 0.0;
  fatVenda.fltPreVe5 := 0.0;
  fatVenda.fltPreVe6 := 0.0;
  fatVenda.fltPreVe7 := 0.0;
  fatVenda.fltPreLot := 0.0;

end;

{*****************************************}
{* RECALCULA O UNITÁRIO DO ITEM E TODOS  *}
