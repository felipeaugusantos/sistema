procedure TfrmFatVendas.pConfirma;
  Var
    intContador : Integer;
    blnGerouNota: Boolean;
    arrLogLibAnt: TArrLogLib;
    arrLogAviAnt: TArrLogAvi;
    blnModificaFidelizacao : Boolean;
    fltDesAceOri: Double;
    blnCliCon,
    blnCliBal: Boolean;
    strNomImp,
    strLayPadrao: string;
    strEmpCliFil: String;
    strCodForFil: String;
    strPermiteAltCliente: String;
    objImpressao: TEditorFastImpressao;
    frmFatTrocaCliente: TfrmFatTrocaCliente;
begin
  fatVenda.blnAvisouSugerirVendaPresencial := False;

  arrLogLibAnt := arrLogLib;
  arrLogAviAnt := arrLogAvi;
  SetLength(arrLogAviAux, 0);

  fatVenda.blnZerRat := False;
  strCodCliGravado   := edtCodCli.Text;
  blnGerouNota := False;

  {****************************************************}
  {* VERIFICA SE O CLIENTE FOI CARREGADO CORRETAMENTE *}
  {*************************************************JB*}
  If (Not qryConCli.Active) Then
  Begin
    fMensagem('ATENÇÃO!', 'O Cliente não foi carregado corretamente, tente novamente.', ['&Ok']);
    pSetFocus(edtCodCli);
    Exit;
  End;

  fatVenda.stlFormulacaoBaixada := stlFormulacaoBaixada;
  fatVenda.stlFormulacaoEtiImpressa := stlFormulacaoEtiImpressa;
  fatVenda.stlDadosBaixaFormulacao  := stlDadosBaixaFormulacao;

  {****************************************************}
  {* VERIFICA SE O CLIENTE FOI CARREGADO CORRETAMENTE *}
  {*************************************************JB*}
  If (Not qryConCli.Active) Then
  Begin
    fMensagem('ATENÇÃO!', 'O Cliente não foi carregado corretamente, tente novamente.', ['&Ok']);
    pSetFocus(edtCodCli);
    Exit;
  End;

  If (Pos(strOpcDoc,'PD_OR_VN_') > 0) And (not fUsaServico) Then
  Begin
    If (dbgItens.DataSource.DataSet.IsEmpty) Then
    Begin
      fMensagem('ATENÇÃO!', 'É necessário informar pelo menos um produto.', ['&Ok']);
      Exit;
    End;
  End;

  {**********************************************************************}
  {* REVALIDA TABELA DE PREÇO CASO USUÁRIO APERTE F10 SEM SAIR DO CAMPO *}
  {*******************************************************************VA*}
  If (cbTabPreco.Visible) And
     (cbTabPreco.Text <> fatVenda.strTabPre) Then
  Begin
    If (Not fValidaCampos(cbTabPreco, True)) Then
      Exit;
  End;

  {*****************************************}
  {* VALIDA CONDICAO DE PAGTO CARREGADA    *}
  {**************************************IV*}
  If fCfgSis('USACND', varBoolean) Then
  Begin
    If (Not fValidaCampos(edtCodCnd, True)) Then
      Exit;
  End;

  {*****************************************}
  {* VALIDA FORMA DE PAGAMENTO CARREGADA   *}
  {**************************************IV*}
  If fatVenda.VS_blnUsaFpg Then
  Begin
    If (Not fValidaCampos(edtForPag, True)) Then
      Exit;
  End;

  {*********************************************************}
  {* TRAVA QUANDO SELECIONAR A OPCAO PRODUCAO FORA DA LOJA *}
  {* E NAO EXISTIR NENHUM ITEM TINTA DE MAQUINA            *}
  {******************************************************JB*}
  If (SameText(edtOprFlj.Text, 'S')) And (Not fVerificaTemTinta) Then
  Begin
    fMensagem('ATENÇÃO!', 'A opção "Gerar produção fora da loja" aplica-se somente quando houver tinta de maquina.', ['&Ok']);
    Exit;
  End;

  If fatVenda.fTemLoteVazio(cdsVenda) Then
  Begin
    Exit;
  End;

  If Not fValidaEmissaoNotaServicoConcreto Then
  Begin
    Exit;
  End;

  If Not fValidaProgrediuTabelaPreco Then
  Begin
    Exit;
  End;

  If Not fValidaItensPedRefOR Then
    Exit;

  If fatVenda.fTemItensDescNegativo Then
    Exit;

  If not fValidaRegEsp2 Then
    Exit;

   If (Pos(strOpcDoc, 'OF_') <= 0) And fCfgSis('MLTOPE', varBoolean) Then
  Begin
    If fVerificaDivergCliVen Then
      Exit;
  End;

  If Not fatVenda.fVerificaFornedorMarcaNaoPermitidosParaCliente Then
    Exit;

  {*******************************************************}
  {* CASO EXISTIR PGTO ANTECIPADO BAIXADO, O VALOR DO PD *}
  {* NAO PODE SER MENOR QUE PGTO ANTECIPADO.             *}
  {****************************************************JB*}
  If (SameText(strOpcDoc, 'PD')) And (Not fCfgSis('GERCRE', varBoolean)) And
     (fatVenda.fTotalDuplicataQuitada(strNumOrc, 'PD', strEmpOrc) > fStrToFloat(edtTotGer.Text)) Then
  Begin
    fMensagem('ATENÇÃO!', 'O pagamento antecipado não pode ser maior que o valor do pedido!', ['&Ok']);
    Exit;
  End;

  If ((Not SameText(strOpcDoc, 'NC')) And (Not fCfgSis('USASER', varBoolean))) Or
     (Not fExibirServicoParaAutocenter) Or
     (fCfgSis('USASER', varBoolean) And (fCfgSis('TIPNFS') = '2') And (Pos(strOpcDoc, 'VS_PD_OR_CF_CN_CP_OV_NC_') <= 0)) Or
     ((Pos(strOpcDoc,'PD_OR_') > 0) And (Not fCfgSis('PDORSE', VarBoolean))) Then
  Begin
    If (dbgItens.DataSource.DataSet.IsEmpty) Then
    Begin
      fMensagem('ATENÇÃO!', 'É necessário informar pelo menos um produto.', ['&Ok']);
      Exit;
    End;
  End;

  pHabilitaPanels(False);

  Try
    fatVenda.objCopiaSegVenda.Habilitado := False;

    {*******************************************}
    {* TROCA CLIENTE                           *}
    {****************************************AF*}
    strPermiteAltCliente := fatVenda.fPermiteTrocarClienteNaDevolucao(False);
    If strPermiteAltCliente = 'T' Then
      Exit;

    If strPermiteAltCliente = 'S' Then
    Begin

      blnTrocandoClienteDV := True;
      pCriarFormularios(TfrmFatTrocaCliente,frmFatTrocaCliente);
      Try
        Try
          frmFatTrocaCliente.qryFatGor := qryFatGor;
          frmFatTrocaCliente.fatVenda := fatVenda;
          frmFatTrocaCliente.blnEspeciePermitidaDevolucao := fEspeciePermitidaDevolucao('NF');

          If mskCndPag.Visible Then
            frmFatTrocaCliente.strCndEdt := mskCndPag.Text
          Else
            frmFatTrocaCliente.strCndEdt := '';

          frmFatTrocaCliente.ShowModal;

          If Not frmFatTrocaCliente.blnResult Then
          Begin
            pFreeAndNil(frmFatTrocaCliente);
            Exit;
          End;

          If frmFatTrocaCliente.edtCliFat.Text <> fatVenda.strCodCli Then
          Begin
            strCodCliAnt := edtCodCli.Text;

            edtCodCli.Text := frmFatTrocaCliente.edtCliFat.Text;
            If Not fValidaCampos(edtCodCli, True) Then
            Begin
              edtCodCli.Text := strCodCliAnt;
              pCarregaCliente;
              pFreeAndNil(frmFatTrocaCliente);
              Exit;
            End;

            If fEmptyStr(fatVenda.strCodCliTrocadoDev) Then
              fatVenda.strCodCliTrocadoDev := strCodCliAnt;

          End;

        Except
          On E: Exception Do
            pMensagensErro(E.Message,'[pConfirma - FatVendas - Troca Cliente]');
        End;
      Finally
        blnTrocandoClienteDV := False;
        pFreeAndNil(frmFatTrocaCliente);
      End;

    End;

    If chkReutilOrc.Visible Then
    Begin
      If chkReutilOrc.Checked Then
        fatVenda.blnReutilizarOrcamento := True
      Else
        fatVenda.blnReutilizarOrcamento := False;
    End
    Else
      fatVenda.blnReutilizarOrcamento := False;

    If (strOpcDoc = 'UC') Then
    Begin
      pCriarFormularios(TfrmFatDigDadosUsoConsumo, frmFatDigDadosUsoConsumo);
      If frmFatDigDadosUsoConsumo.ShowModal = mrOk Then
      Begin
        fatVenda.strFornecedorUsoConsumo := frmFatDigDadosUsoConsumo.edtCodFor.Text;
        fatVenda.strCentroCustoUsoConsumo := frmFatDigDadosUsoConsumo.fraPlanoDeContas.MskCodCta.Text;
        fatVenda.strHistoricoUsoConsumo := frmFatDigDadosUsoConsumo.edtHistor.Text;
        fatVenda.strCodEve := IIF(fCfgSis('EVUSCS', varBoolean), frmFatDigDadosUsoConsumo.edtCodEve.Text,'');

        {**************************************************************}
        {* JOGA O HISTORICO DE CONSUMO PARA UMAS DAS MENSAGENS PADRÃO *}
        {***********************************************************PE*}
        For intContador := 1 To 5 Do
        Begin
          If fEmptyStr(GetPropValue(fatVenda, 'strMen00'+ IntToStr(intContador))) Then
          Begin
            SetPropValue(fatVenda, 'strMen00'+ IntToStr(intContador),fatVenda.strHistoricoUsoConsumo);
            Break;
          End;
        End;

      End
      Else
      Begin
        FreeAndNil(frmFatDigDadosUsoConsumo);
        Exit;
      End;
      FreeAndNil(frmFatDigDadosUsoConsumo);
    End;

    blnModificaFidelizacao := False;
    If (fEntraNaRegraDeFidelizacao) Then
      blnModificaFidelizacao := fPerdeuFidelidade;

    {*************************************************}
    {* ALTERA DE CLIENTE FILIAL P/ FORNECEDOR FILIAL *}
    {*REQ.247597***********************************RP*}
    If (strOpcDoc = 'CT') And fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo Then
    Begin
      If fClienteFilial(edtCodCli.Text, strEmpCliFil) Then
      Begin
        strCodForFil := fGetFornecedorFilial(strEmpCliFil);

        If fEmptyStr(strCodForFil) Then
        Begin
          pMensagemOk('Fornecedor filial não preenchido no cadastro da empresa "'+ strEmpCliFil +'".'+ sLineBreak +
                      'Por favor, corrija o cadastro e tente novamente.');
          Exit;
        End;

        If strCodForFil <> fatVenda.strCodCli Then
        Begin
          fatVenda.strCliFat      := fatVenda.strCodCli; //é utilizado no update (GER_JAFATU = 1)
          fatVenda.strCliFatFFEsp := fatVenda.strCodCli; //grava na NOTGER (GER_CLIFAT), é utilizado no cancelamento
          fatVenda.strCodCli      := strCodForFil;
          fatVenda.strOriDoc      := 'V';
        End;
      End;
    End;

    If (strOpcDoc = 'DV') And (fatVenda.blnDevolvendoRegEsp) Then
    Begin
      fatVenda.strEmpLogDevRegEsp := fRetornaEmpresaItens;

      If fEmptyStr(fatVenda.strEmpLogDevRegEsp) Then
        Exit;
    End;

    fatVenda.blnUtiAbaAutoCredPend := ckbAbCrAu.Checked;

    If (Pos(strOpcDoc, 'PD_OR_') > 0) Then
    Begin
      fatVenda.pSetaVendaPresencialParaClienteForaDoEstadoMedianteCFG(False, True);
      chkVenPre.Checked := fatVenda.blnVendaPresencial;
    End;

    Try
      fltDesEspOri := 0.0;
      fltDesAceOri := fatVenda.fltDesAce;

      Try
        pCriarFormularios(TfrmGravando, frmFechamentoVenda);
        frmFechamentoVenda.fExecutarAcao := fGeraNota;
        frmFechamentoVenda.ShowModal;
        blnGerouNota := frmFechamentoVenda.blnConfirma;
      Except
        On E: Exception Do
        Begin
          blnGerouNota := False;
          pMensagensErro(E.Message, '');
        End;
      End;

      pFreeAndNil(frmFechamentoVenda);

      If Not blnGerouNota Then
      Begin
        if not fatVenda.fRecebidoPorPix then
          fatVenda.fltDesAce := fltDesAceOri;
        Exit;
      End;

      blnLiberouTravaDevolucao := False;

      If (edtSenVen.Enabled) And (blnModificaFidelizacao) Then
        pTrocaVendedorFidelizacao;

      if fVerificaEnviaLinkPagtoOnline(fatVenda.strEspDoc, fatVenda.strCodFpg, fatVenda.strCodCnd) then
        fChamaTelaGravando(fLinkPagtoOnline);

      pEnviarSMS();

      pEnviarEmail();

      pAtualizaProdutosGravadosVendaPerdida;
    Except

      fatVenda.strEntFut        := 'N';
      pAtualizaTemporaria;

    End;

    blnCliCon := fClienteConsumidor(edtNomCli.Text, False, True);
    blnCliBal := fClienteConsumidor(edtNomCli.Text, True, False);

    If (blnGerouNota) And (strOpcDoc = 'VN') Then
    Begin
      Try
        If (Not blnCliCon) And (Not blnCliBal) Then
          pVerificarPromocaoBrindes('','')
        Else
        Begin
          For intContador := 0 To fatVenda.objFatVendaImp.ItemsCount -1 Do
          Begin
            pVerificarPromocaoBrindes(fatVenda.objFatVendaImp[intContador].strNumDoc,
                                      fatVenda.objFatVendaImp[intContador].strEspDoc);
          End;
        End;
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[TfrmFatVendas.pConfirma: pVerificarPromocaoBrindes]');
          InterlockedDecrement(intConfirmando);
        End
      End;
    End;

  Finally
    If (Pos(strOpcDoc,'CT_CF_CN_NC_CI_CP_OV_VS_') <= 0) Then
    Begin
      pHabilitaCamposItem(True);
      dbgItens.Enabled := True;
    End;

    pEnabledFechamento(True);

    If Pos(strOpcDoc, 'VN_CS_PD_OR_') > 0 Then
      blnComVen := True;

    If (edtCodIte.Enabled) And (pnlDadosItem.Enabled) Then
      pSetFocus(edtCodIte);

    pApagaLogVarNaoUtilizado(fatVenda.stlNumLib,arrLogLib);

    pDeletaItemServico(False);
    pCalculaTotais;
    SetLength(fatVenda.arrMatItens, 0);

    if not fatVenda.fRecebidoPorPix then
    begin
      arrLogLib := arrLogLibAnt;
      arrLogAvi := arrLogAviAnt;
    end ;

    Screen.Cursor := crDefault;

    blnMudouTabelaPreco := False;

    If blnGerouNota And fatVenda.fEhConsertoEquipamento Then
    Begin
      objMeqMer := TMeqMer.Create;
      objMeqMer.strAutGer := fatVenda.strAutIncConEqu;
      objMeqMer.strNumDoc := fatVenda.strNumDoc;
      objMeqMer.strEspDoc := fatVenda.strEspDoc;
      objMeqMer.strSerie_ := fatVenda.strSerFsc;
      objMeqMer.strEmpGer := VS_strCodEmp;
      objMeqMer.strCodCli := fatVenda.strCodCli;
      objMeqMer.strTipOpe := 'S';
      objMeqMer.dtaDtaGer := fatVenda.dtaDtaEnt;
      blnConfirma   := True;
      blnFecharForm := True;
    End;

    If (Not blnGerouNota) And
      (fatVenda.blnLiberacaoRemotaNoFinalVenda) And
      (fatVenda.blnVerPrzMed Or fatVenda.blnVerMaxPar) Then
    Begin
      fatVenda.blnVerPrzMed := False;
      fatVenda.blnVerMaxPar := False;
    End;

    if VS_blnTefCitel then
    begin
      if blnGerouNota then
        pFinalizarTefCitel
      else
      begin
        if fGaranteCancelamentoTefCitel(arrCartoes) then
        begin
          if fatVenda.strOpcDoc = 'VN' then
            SetLength(arrCartoes, 0);
          if not fAutoConfirmaTransacaoPendenteEstaAtivada then
            fMensagem('ATENÇÃO!', 'Transação de cartão no TEF foi DESFEITA!'+#13+'Avisar cliente.', ['&Ok']);
        end ;
      end;
    end;

    If (blnGerouNota) And (strOpcDoc = 'DV') And
       ((fCfgSis('DOCCRE', varString) = 'S') Or
        ((fCfgSis('DOCCRE', varString) = 'P') And (fMensagem('', 'Deseja emitir documento de comprovante de geração de crédito?', ['&Sim', '&Não']) = 1))) Then
    begin

      strLayPadrao := fCampoTabela('LAY_CODLAY', 'LAYETI', ['LAY_TIPLAY', 'LAY_CODEMP', 'LAY_PADRAO'], [ARR_TIPO_LAYOUT[tpeComprovanteGeracaoCredito], VS_strCodEmp, 'S']);

      if (not fEmptyStr(strLayPadrao))  then
      begin

        if fEmptyStr(strNomImp) then
        begin
          TCfgRel.fExecutePrintDialog(strNomImp);
          if fEmptyStr(strNomImp) then
            strNomImp := TCfgRel.fGetImpressoraSelecionada;
        end;

        objImpressao := TEditorFastImpressao.Create(Nil);

        objImpressao.recDocume.blnComprovanteGeracaoCredito := True;
        objImpressao.recDocume.strNumDoc := fatvenda.strNumDoc ;
        objImpressao.recDocume.strEspDoc := fatvenda.strEspDoc ;
        objImpressao.recDocume.strCodEmp := VS_strCodEmp ;
        objImpressao.recDocume.blnTemLay := True;
        objImpressao.recDocume.strCodLay := strLayPadrao;
        objImpressao.recDocume.strNomImp := strNomImp;
        objImpressao.fImprimeDocumento(tpaNormal);

        FreeAndNil(objImpressao);

      end;

    end;

    fatVenda.objCopiaSegVenda.Habilitado := ('PD_OR_VN_'.Contains(strOpcDoc)) And (fCfgSis('PERSAV', varBoolean));

    blnRealizouCalculoPrioridade := False;

  End;
end;

