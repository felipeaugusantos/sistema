function TfrmFatVendas.fAlteraDadosProdCombo(
  pgbProgresso: TcxProgressBar): Boolean;
Var
  strSeqCom: String;
  strEmpTmp: String;
  intRecNo : Integer;
  fltQtdIte: Double;
  intQtdCom: Integer;
  blnAtuPnl: Boolean;
  cdsIteCom: TUniClientDataSet;
begin
  intRecNo  := cdsVenda.RecNo;

  Try
    pInfoStatusGravacao(pgbProgresso, 'Aguarde...Recalculando Produtos do Combo...');

    strSeqCom := cdsVenda.FieldByName('ITE_SEQCOM').AsString;
    fltQtdIte := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
    strEmpTmp := cdsVenda.FieldByName('ITE_EMPITE').AsString;

    cdsIteCom          := TUniClientDataSet.Create(Self);
    cdsIteCom.Data     := cdsVenda.Data;
    cdsIteCom.LogChanges := False;
    cdsIteCom.Filter   := 'ITE_SEQCOM = ' + quotedStr(strSeqCom) + '  AND ITE_ATIVAC = ' + quotedStr('N');
    cdsIteCom.Filtered := True;

    blnAtuPnl := blnAtualizarPnlDadosItemNaVendaModoTab;
    blnAlterandoCombo := True;

    pgbProgresso.Properties.Max := cdsIteCom.RecordCount;

    While Not cdsIteCom.Eof Do
    Begin
      If (cdsVenda.Locate('AUTOINCREM', cdsIteCom.FieldByName('AUTOINCREM').AsString, [])) Then
      Begin
        pInfoStatusGravacao(pgbProgresso, 'Aguarde...Recalculando Produto do Combo: ' + #13#10 + cdsIteCom.FieldByName('ITE_CODITE').AsString + '-' + Copy(cdsIteCom.FieldByName('ITE_DESITE').AsString, 1, 15));
        blnAtualizarPnlDadosItemNaVendaModoTab := True;
        pSetaCampoDestino();
        pCarregaItensAlteracao;
        pCarregaInformacaoItem;

        blnAtualizarPnlDadosItemNaVendaModoTab := blnAtuPnl;

        intQtdCom      := Trunc(fFormataFloat(fltQtdIte / cdsVenda.FieldByName('ITE_QTDATI').AsFloat, fCfgSis('DECQTD', varInteger)));
        edtQtdIte.Text := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), cdsVenda.FieldByName('ITE_QTDCOM').AsFloat * intQtdCom);

        If (fatVenda.blnEmpFat) Then
          edtCodEmp.Text := strEmpTmp;

        If blnAtualizarItensDoComboParaPrecoDeTabela Then
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                        fatVenda.fPegaPrecoVenda(cdsVenda, fRetEmpresaItem,
                                                                 'S',
                                                                 fStrToFloat(edtMargem.Text),
                                                                 False,
                                                                 fatVenda.strIdePro,
                                                                 cbTabPrecoItem.Text,
                                                                 True,
                                                                 fatVenda.FTaxJur,
                                                                 fatVenda.FUniVis));
        pAdicionar;
        pLimpaDadosItem;
      End;

      pStepStatusGravacao(pgbProgresso);
      cdsIteCom.Next;
    End;

    Result := True;

  Finally
    cdsVenda.RecNo    := intRecNo;
    blnAlterandoCombo := False;
    FreeAndNil(cdsIteCom);
  End;
end;

