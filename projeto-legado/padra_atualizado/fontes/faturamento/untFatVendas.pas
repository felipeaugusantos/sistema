function TfrmFatVendas.AtualizaDadosTFAutomaticaOrdemPagamento: Boolean;
  Var
    LResumoCaixa: TResumoDeCaixa;
begin
  Result := True;

  If Not Assigned(fatVenda) Then
    Exit;

  fatVenda.FPortadorTFAutomatica := EmptyStr;
  fatVenda.FValorTFAutomatica := 0.00;

  If Not fatVenda.strCodFpg.Equals('012') Then
    Exit;

  If Not MatchStr(fatVenda.strOpcDoc, ['VN']) Then
    Exit;

  LResumoCaixa := TResumoDeCaixa.Create;

  Try
    If Not LResumoCaixa.TransferenciaOrdemPagamentoAutomaticaFaturamento Then
      Exit;

    If Not fCfgSis('BAIAVI', varBoolean) Then
      Exit;

    If fFormataFloat(fatVenda.fltValOrd, 2) = 0.00 Then
      Exit;

    If Assigned(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
      Exit;

    fatVenda.FPortadorTFAutomatica := LResumoCaixa.RetornaPortadorTFAutomatica(True);
    Result := Not fatVenda.FPortadorTFAutomatica.IsEmpty;

    If Result Then
      fatVenda.FValorTFAutomatica := fFormataFloat(fatVenda.fltValOrd, 2);
  Finally
    FreeAndNil(LResumoCaixa);
  End;
end;

