        End;

      End;

    End;

  End;

end;

procedure TfrmFatVendas.pCodCliKeyPress(var Key: Char);
  Var
    arrSel : TConsultasArray;
    objfrmPnl : TPanelCxClientes;
begin

  If fEntraCons(Key) And (Not edtCodCli.ReadOnly) Then
  Begin
    Try
      objfrmPnl := TPanelCxClientes.Create(TfrmPnlDadosCliente);
      objfrmPnl.strNomForm := self.name;
      If fPesqCliente(conCliCompleta, Self, edtCodCli, edtNomCli, qryConCli,
                      Key, arrSel, True, objfrmPnl, False, '', IIf(strOpcDoc='EM',EmptyStr,strOpcDoc)) then
      Begin
        If (fValidaCampos(edtCodCli, True)) and (blnMudarFoco) Then
          Self.SelectNext(ActiveControl, True, True);
      End
      Else
      Begin
        pPesquisaCadCli(qryConCli, qryConCli, edtCodCli.Text, True, IIF((Pos(strOpcDoc, 'OR_PD_VN_') > 0), True, False));
      End;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[pCodCliKeyPress]');
    End;
    FreeAndNil(objfrmPnl);

  End;

End;

