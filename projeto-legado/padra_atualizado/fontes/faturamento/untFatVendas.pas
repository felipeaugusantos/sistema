function TfrmFatVendas.fSolicitarEnderecoDeEntrega: Boolean;
begin
  Result := True;
  If (Not fatVenda.blnPediuEnderecoEntrega) And (Not fatVenda.fPedeEnderecoEntrega) Then
    Exit(False);

  If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) Then
    pHabilitaChkVendaPresencial;
end;

function TfrmFatVendas.fSolicitarEnderecoEntregaQuandoAtendeRegraFiscal: Boolean;
begin
  Result := True;

  //Selecao de endereco de entrega ira ocorrer dentro da nova tela de fechamento.
  If (Pos(strOpcDoc, 'PD_OR') > 0) And fatVenda.blnNovoFechamentoOrcamentoPedido Then
    Exit;

  If fatVenda.fAtendeRegraFiscalEndEntrega Then
  Begin
    If fatVenda.fPedeEnderecoEntrega then
    Begin
      If (fatVenda.opeAlterouUFEntrega = opRecalcularDifal) Then
      Begin
        pRecalculaPrecos(False, True);
        pCalculaTotais;
      End;

      pPreencheMatrizFechamento;
    End
    Else
      Result := False;
  End;

end;

function TfrmFatVendas.fSomenteItensEntregaFutura: Boolean;
  Var
    cdsDados: TUniClientDataSet;
begin
  Result   := Not cdsVenda.IsEmpty;
  cdsDados := TUniClientDataSet.Create(nil);
  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;
  With cdsDados Do
  Begin
    First;
    While Not Eof Do
    Begin
      If (FieldByName('ITE_ENTFUT').AsString <> 'S') Then
      Begin
        Result := False;
        Break;
      End;
      Next;
    End;
  End;
  FreeAndNil(cdsDados);
end;

function TfrmFatVendas.fSQLDet(strIdDocumentosSelecionados,
                               strPrefixoDet,
                               strTabDet      : String;
                               tpPrecoImpItem : TTipoPrecoImpItem): String;
Begin
  Result := '';
  Result := Result + 'SELECT                         ';
  Result := Result + '  ' + strTabDet     + '.AUTOINCREM,   ';
  Result := Result + '  ' + strPrefixoDet + 'NUMDOC NUMDOC, ';
  Result := Result + '  ' + strPrefixoDet + 'CODEMP CODEMP, ';
  Result := Result + '  ' + strPrefixoDet + 'ESPDOC ESPDOC, ';
  Result := Result + '  ' + strPrefixoDet + 'CODITE CODITE, ';
  Result := Result + '  ' + strPrefixoDet + 'QTDITE QTDITE, ';
  Result := Result + '  ' + strPrefixoDet + 'NUMLOT NUMLOT, ';
  Result := Result + '  ' + strPrefixoDet + 'DOCDEV DOCDEV, ';
  Result := Result + '  ' + strPrefixoDet + 'ESPDEV ESPDEV, ';
  Result := Result + '  ' + strPrefixoDet + 'EMPDEV EMPDEV, ';
  Result := Result + '  ' + strPrefixoDet + 'CODACA CODACA, ';
  Result := Result + '  ' + strPrefixoDet + 'ITETIN ITETIN, ';
  Result := Result + '  ' + strPrefixoDet + 'EMPACA EMPACA, ';
  Result := Result + '  ' + strPrefixoDet + 'CLAFIS CLAFIS, ';
  Result := Result + '  ' + strPrefixoDet + 'TOTCUS TOTCUS, ';

  Result := Result + '  ' + strPrefixoDet + 'TOTITE TOTITE, ';
  Result := Result + '  ' + '  0.0 TOTAL, ';

  if tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoDocumentoOriginalComDesconto] then
    Result := Result + '  ' + strPrefixoDet + 'UNIDIG UNIDIG, '
  else
    Result := Result + '  0 UNIDIG, ';

  if tpPrecoImpItem in [tpPrecoDocumentoOriginalComDesconto, tpPrecoTabelaAtualComDesconto] then
    Result := Result + '  ' + strPrefixoDet + 'DESCON DESCON,  '
  else
    Result := Result + '  0 DESCON, ';

  Result := Result + strPrefixoDet + 'IDEPRO IDEPRO, ';
  Result := Result + strPrefixoDet + 'DESCRI DESCRI, ';
  Result := Result + ' "'+strTabDet+'" TABELA, ';

  If (strTabDet = 'NOTDET') Then
  Begin
    Result := Result + ' DET_SEQDET AS INCCNF, ';
    Result := Result + '        " " AS COMPLE, ';
  End
  Else
  Begin
    Result := Result + '        " " AS INCCNF, ';
    Result := Result + strPrefixoDet + 'COMPLE AS COMPLE, ';
  End;

  If (strTabDet = 'FATDOR') Then
  Begin
    Result := Result + ' FDO_ENTRET AS ENTRET, ';
    Result := Result + ' FDO_LOCRET AS LOCRET, ';
    Result := Result + ' FDO_MOTFUT AS MOTFUT, ';
    Result := Result + ' FDO_ENTFUT AS ENTFUT, ';
  End
  Else
  Begin
    Result := Result + ' IF(GER_ENTFAT = "S", "E", "R") AS ENTRET, ';
    Result := Result + ' " " AS LOCRET, ';
    Result := Result + ' " " AS MOTFUT, ';
    Result := Result + ' GER_ENTFUT AS ENTFUT, ';
  End;


  Result := Result + ' 1 NUMERO_REPETICAO ';

  Result := Result + 'FROM                           ';
  Result := Result + '  ' + strTabDet + '            ';

  If (strTabDet = 'NOTDET') Then
  Begin
    Result := Result + ' LEFT JOIN NOTTRI ON NOTDET.AUTOINCREM = NOTTRI.DET_SEQGER ';
    Result := Result + ' LEFT JOIN NOTGER ON NOTDET.DET_SEQGER = NOTGER.AUTOINCREM ';
  End
  Else If (strTabDet = 'MOVDET') Then
  Begin
    Result := Result + ' LEFT JOIN MOVTRI ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ';
    Result := Result + ' LEFT JOIN MOVGER ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
  End
  Else If (strTabDet = 'FATDOR') Then
    Result := Result + ' LEFT JOIN EXTDOR ON(FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO) ';

  Result := Result + 'WHERE ' + strTabDet + '.' + strPrefixoDet + 'SEQGER IN ('+IIF(fEmptyStr(strIdDocumentosSelecionados),'""', strIdDocumentosSelecionados)+') ';
  Result := Result + '  AND ' + strPrefixoDet + 'PROACA = ''N''       ';
  Result := Result + '  AND ' + strPrefixoDet + 'PROEMB <> ''S''      ';
End;

