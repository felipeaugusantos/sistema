procedure TfrmFatVendas.pAtualizaItensEstrutura(intSeqEst: Integer);
Var
  intRecNo: Integer;
  prcScrollVenda: TprcScroll;
begin
  If fatVenda.fUtilizarPrecoSubItemEstruturaTravaPreco(False) And (intSeqEst > 0) Then
  Begin
    pRecalculaPrecos(False, False, False, True, '', False, False, False, False, False, False, False, intSeqEst);
    Try
      pDisableControls(cdsVenda, prcScrollVenda);
      With cdsVenda Do
      Begin
        intRecNo := RecNo;
        First;

        While Not Eof Do
        Begin
          If (FieldByName('ITE_SEQEST').AsInteger = intSeqEst) Then
          Begin
            Edit;
            FieldByName('ITE_SEQEST').AsInteger := 0;
            FieldByName('ITE_ITEEST').AsString  := '';
            FieldByName('ITE_UNIEST').AsInteger := 0;
            FieldByName('ITE_QTDSBI').AsInteger := 0;
            FieldByName('ITE_UNISBI').AsInteger := 0;
            FieldByName('ITE_ESTORI').AsFloat := 0;
            Post;
          End;
          Next;
        End;

        If (intRecNo > RecordCount) Then
          Last
        Else
          RecNo := intRecNo;
      End;
    Finally
      pEnableControls(cdsVenda, prcScrollVenda);
    End;
  End;
end;

procedure TfrmFatVendas.pApagaItensComboVenda(strAtivac: String; intSeqCom: Integer);
Var
  intRecNo: Integer;
begin
  If (strAtivac = 'S') Then
  Begin
    With cdsVenda Do
    Begin
      intRecNo := RecNo;
      First;

      While Not Eof Do
      Begin
        If (FieldByName('ITE_SEQCOM').AsInteger = intSeqCom) And (FieldByName('ITE_ATIVAC').AsString <> 'S') Then
        Begin
          Delete;
          Continue;
        End;

        Next;
      End;

      If (intRecNo > RecordCount) Then
        Last
      Else
        RecNo := intRecNo;
    End;
  End;
end;

procedure TfrmFatVendas.pProcessarRegraDescontoDeProfissionalPorItem;
  var
    LDescontoDoProfissional : Double;
    LPermiteAlterarDesconto : Boolean;
begin

  If fatVenda.strCodCli.IsEmpty Then
    Exit;

  LDescontoDoProfissional := fRetDescontoCliente(fatVenda.strCodCli);
  LPermiteAlterarDesconto := False;

  Try

    If fClienteTemPermissaoParaEmitirFF(fatVenda.strCodCli) Then
    Begin
      LPermiteAlterarDesconto := False;
      Exit;
    End;

    If (LDescontoDoProfissional > 0) Then
      edtDesCon.Text := FloatToStrF(LDescontoDoProfissional, ffNumber, 12, intDecDes);

    LPermiteAlterarDesconto := IIF(LDescontoDoProfissional > 0, False, True);

  Finally

    If LPermiteAlterarDesconto Then
    Begin
      edtDescon.ReadOnly    := False;
      edtDescon.TabStop     := True;
      edtDescon.Color       := clWhite;
      edtDescon.NormalColor := clWhite;
    End
    Else
    Begin
      edtDescon.ReadOnly    := True;
      edtDescon.TabStop     := False;
      edtDescon.Color       := $00FFDFB8;
      edtDescon.NormalColor := $00FFDFB8;
    End;

  End;

end;

