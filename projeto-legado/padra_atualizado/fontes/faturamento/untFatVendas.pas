function TfrmFatVendas.fValidaPrazoMedioMaximoVenda: Boolean;
  Var
    strCodVenTmp: String;
    strCodCndTmp: String;
    strCodCliTmp: String;
    strCodFpgTmp: String;
    strConPagTmp: String;
begin
  Result := True;

  If fCfgSis('PRZMED', varBoolean) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    If fCfgSis('CNDVEN') = 'I' Then
    Begin
      strCodVenTmp := fRetCodVenDef(edtSenVen.Text);
      strCodCndTmp := edtCodCnd.Text;
      strCodCliTmp := edtCodCli.Text;
      strCodFpgTmp := edtForPag.Text;
      strConPagTmp := mskCndPag.Text;
    End
    Else
    Begin
      strCodVenTmp := fatVenda.strCodVen;
      strCodCndTmp := fatVenda.strCodCnd;
      strCodCliTmp := fatVenda.strCodCli;
      strCodFpgTmp := fatVenda.strCodFpg;
      strConPagTmp := fatVenda.strConPag;
    End;

    {Verifica se já foi liberado}
    If Not blnSenPrazoMedioMaximoVenda Then
    Begin

      If (strCodVenTmp <> '') And
         (strCodCndTmp <> '') And
         (strCodCliTmp <> '') And
         (strCodFpgTmp <> '') Then
      Begin

        blnSenPrazoMedioMaximoVenda := fValidaPrazoMedioMaximoVenda(strCodVenTmp,
                                                                    strCodCndTmp,
                                                                    strCodCliTmp,
                                                                    strCodFpgTmp,
                                                                    strConPagTmp);

        Result := blnSenPrazoMedioMaximoVenda;

      End;

    End;

  End;

end;

function TfrmFatVendas.fValidaPrazoMedioMaximoVenda(strCodVen, strCodCnd, strCodCli, strCodFpg, strCndPag : String): Boolean;
var
  intPrzMedVen : Integer;
  intPrzMaxVen : Integer;
  fltPrzMedCnd : Real;
  cdsPrzMed    : TUniClientDataSet;
  strCodVend   : String;

  function fGetPrzMedCnd: Double;
  var
    qryAux : TUniQuery;
  begin
    qryAux := fCriaQuery;
    try
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT CND_PRZMED, CND_CNDPAG FROM CADCND WHERE CND_CODIGO = ' + QuotedStr(strCodCnd));
      qryAux.Open;

      //Req: 116024
      If qryAux.FieldByName('CND_PRZMED').AsFloat <= 0 Then
        Exit(fFloatToInt(fCalcMediaPagto(strCndPag)));

      strCndPag := qryAux.FieldByName('CND_CNDPAG').AsString;

      Result := qryAux.FieldByName('CND_PRZMED').AsFloat;

    finally
      FreeAndNil(qryAux);
    end;
  end;

  procedure pCriaDataSetPrzMed;
  begin
    cdsPrzMed := TUniClientDataSet.Create(Self);

    With cdsPrzMed.FieldDefs.AddFieldDef Do
    Begin
      Name := 'PRZMED';
      DataType := ftFloat;
      Required := False;
    End;

    cdsPrzMed.CreateDataSet;
  end;

begin

  Result := True;

  if (not fEmptyStr(strCodVen)) and
     (not fEmptyStr(strCodCnd)) and
     (not fEmptyStr(strCodCli)) and
     (not fEmptyStr(strCodFpg)) then
  begin
    strCodVend := strCodVen;

    {Média do Vendedor}
    intPrzMedVen := fGetPrzMedVen(strCodVend);

    {Localiza na Faixa o Máximo para essa Média}
    intPrzMaxVen := fGetPrzMaxVen(intPrzMedVen);

    {Prazo Médio da Condição Utilizada}
    fltPrzMedCnd := fGetPrzMedCnd;

    {Cria DataSet Prazo Médio}
    pCriaDataSetPrzMed;

    Try
      {Excedeu?}
      While (fltPrzMedCnd > intPrzMaxVen) And Result Do
      begin
        cdsPrzMed.EmptyDataSet;

        {Solicita Senha}
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddSeparador(65);
        objLiberacao.objMsgLibera.pAddTexto('Prazo médio do vendedor excedido.');
        objLiberacao.objMsgLibera.pAddSeparador(65);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'               , strCodCli + ' - ' + fRetNomCliente(strCodCli), 21);
        objLiberacao.objMsgLibera.pAddTextoCaption('Condição de pagamento' , strCodCnd + ' - ' + fRetDesConPag(strCodCnd) , 21);

        if (strCndPag <> '') Then
        objLiberacao.objMsgLibera.pAddTextoCaption('                     ' , fFormataCondPag(strCndPag)                   , 21);

        objLiberacao.objMsgLibera.pAddTextoCaption('Forma de pagamento'    , strCodFpg + ' - ' + fRetDescFpg(strCodFpg)   , 21);
        objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor'              , strCodVend+ ' - ' + fRetNomVendRep(strCodVend), 21);
        objLiberacao.objMsgLibera.pAddSeparador(65);
        objLiberacao.objMsgLibera.pAddTextoCaption('Prz.Méd.Vendedor'      , IntToStr(intPrzMedVen)   + ' dias'           , 21);
        objLiberacao.objMsgLibera.pAddTextoCaption('Prz.Méd.Máx'           , IntToStr(intPrzMaxVen)   + ' dias'           , 21);
        objLiberacao.objMsgLibera.pAddTextoCaption('Prz.Méd.Desta Venda'   , FloatToStr(fltPrzMedCnd) + ' dias'           , 21);
        objLiberacao.objMsgLibera.pAddSeparador(65);

        objLiberacao.strDirAce := 'PRZMED';
        objLiberacao.strMsgSen := 'Prazo médio do vendedor excedido';
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := fatVenda.strCodDig;
        objLiberacao.strCliente := strCodCli + ' - ' + fRetNomCliente(strCodCli);

        cdsPrzMed.AppendRecord([fltPrzMedCnd]);
        objLiberacao.cdsXmlTra := cdsPrzMed;

        Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

        If Result Then
        Begin
          strCodVend := objLiberacao.strOperador;

          intPrzMedVen := fGetPrzMedVen(strCodVend);
          intPrzMaxVen := fGetPrzMaxVen(intPrzMedVen);

          objLiberacao.cdsXmlTra := nil;
        End;
      end;
    Finally
      If Assigned(objLiberacao.cdsXmlTra) Then
        objLiberacao.cdsXmlTra := nil;
      FreeAndNil(cdsPrzMed);
    End;

  end;

end;

function TfrmFatVendas.fValidaProdutoBasePigmento: Boolean;
begin
  {*******************************************}
  {* VALIDA SOMENTE SE ESTIVER INSERINDO     *}
  {***21/05/2008***************************MV*}

  Result := True;

  If (btnAdicionar.Tag <= 0) Then
  Begin

    {**************************************}
    {* SENHA DE PRODUTO BASE              *}
    {***********************************AF*}
    If (qryConCit.FieldByName('ITE_ITEBAS').AsString = 'S')              And
       ((fatVenda.strIdePro = 'NOR') Or (fEmptyStr(fatVenda.strIdePro))) And
       (fatVenda.strOpcDoc <> 'DV') And
       (fatVenda.opcItensNFespTinta = opcVazio) and
       (Not blnProAca) And
       fPedeSenhaParaProdutoBase Then
    Begin
      objLiberacao.Clear;
      objLiberacao.strDirAce    := 'PEVEPB';
      objLiberacao.strSenLib    := fCfgSis('SENBAS');
      objLiberacao.blnManterCompatibilidadeSenCfg := not fEmptyStr(objLiberacao.strSenLib);
      objLiberacao.strMsgSen    := 'Permitir venda de produto base no faturamento';
      objLiberacao.strCodOpe := fatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente   := (edtCodCli.Text + '-' + edtNomCli.Text);
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
      objLiberacao.objMsgLibera.pAddTexto('Permitir venda de produto base no faturamento');

      Result := objLiberacao.fLibera;

      If not Result Then
        Exit;

    End;

    {**************************************}
    {* SENHA DE PRODUTO PIGMENTO          *}
    {***********************************AF*}
    If (qryConCit.FieldByName('ITE_ITEPIG').AsString = 'S')               And
       (Not fEmptyStr(fCfgSis('SENPIG')))                                 And
       ((fatVenda.strIdePro = 'NOR') Or (fEmptyStr(fatVenda.strIdePro)))  And
       (fatVenda.strOpcDoc <> 'DV') And
       (fatVenda.opcItensNFespTinta = opcVazio) Then
    Begin

      strSenha := '';
      If ffrmSenha(strSenha,'Produto Pigmento') Then
      Begin

        If strSenha <> fCfgSis('SENPIG') Then
        Begin
          fMensagem('','Senha para venda de produto pigmento incorreta!',['&OK']);
          REsult := False;
        End;

      End
      Else
      Begin
        REsult := False;
        Exit;
      End;

    End;

  End;
end;

procedure TfrmFatVendas.pCarregaFornecedor;
begin

  fatVenda.blnGravaCtrTe := False;
  fatVenda.strCodEmpTe   := '';
  fatVenda.strTipEmiTe   := '';
  fatVenda.strCodForTe   := '';
  fatVenda.strPerEmpTe   := '';

  pPesquisaCadFor(qryConCli, qryConCli, edtCodCli.Text);
  With qryConCli Do
  Begin

    edtNomCli.Text  := FieldbyName('FOR_NOMFOR').AsString;

    If (Not IsEmpty) Then
    Begin

      If (fEmptyStr(fatVenda.strCodCli))                            Or
         (fatVenda.strCodCli <> FieldByName('FOR_NOMFOR').AsString) Or
         (Not fEmptyStr(strNumOrc))                                 Then
      Begin

        If fEmptyStr(strNumOrc) Or (fatVenda.strCodCli <> FieldByName('FOR_NOMFOR').AsString) Then
        Begin
          fatVenda.strContat := FieldByName('FOR_CONTAT').AsString;
          fatVenda.strFone01 := FieldByName('FOR_FONE01').AsString;
        End;

        fatVenda.strCodCli := FieldByName('FOR_CODFOR').AsString;                   // Fornecedor - Codigo
        fatVenda.strCliOri := FieldByName('FOR_NOMFOR').AsString;                   //         - Nome Original
        fatVenda.strCliNom := FieldByName('FOR_NOMFOR').AsString;                   //         - Nome
        fatVenda.strCliEnd := FieldByName('FOR_ENDERE').AsString + ', ' +
                              FieldByName('FOR_ENDNUM').AsString;                   //         - Endereco
        fatVenda.strCliNum := FieldByName('FOR_ENDNUM').AsString;                   //         - Numero
        fatVenda.strCliCom := FieldByName('FOR_ENDCOM').AsString;                   //         - Complemento
        fatVenda.strCliBai := FieldByName('FOR_BAIRRO').AsString;                   //         - Bairro
        fatVenda.strCliCep := FieldByName('FOR_C_E_P_').AsString;                   //         - Cep
        fatVenda.strCodCid := FieldByName('FOR_CODCID').AsString;                   //         - Cód. Cidade
        fatVenda.strCliCid := fRetNomCidade(FieldByName('FOR_CODCID').AsString);    //         - Cidade
        fatVenda.strCliEst := fRetNomCidade(FieldByName('FOR_CODCID').AsString, 1); //         - Estado
        fatVenda.strCliTel := FieldByName('FOR_FONE01').AsString;                   //         - Telefone
        fatVenda.strCli_Rg := '';                                                   //         - RG
        fatVenda.strCliCgc := FieldByName('FOR_C_G_C_').AsString;                   //         - CNPJ
        fatVenda.strObserv := FieldByName('FOR_OBSERV').AsString;                   //         - Observações
        fatVenda.strCliAti := '';                                                   //         - Atividade
        fatVenda.strCliEma := FieldByName('FOR_EMAIL3').AsString;                   //         - Email
        fatVenda.strCliEm2 := '';
        fatVenda.strCliFax := FieldByName('FOR_F_A_X_').AsString;
        {*****************************************************}
        {* SE FOR OUTRAS SAÍDAS PARA FORNECEDOR CliDAc = 'S' *}
        {**************************************************AL*}
        If strOpcDoc = 'OF' Then
          fatVenda.strCliDAc := 'S' // - Cobrar despesa acessória
        Else
          fatVenda.strCliDAc := 'N';
          
        {**************************}
        {* DADOS DE ENTREGA       *}
        {***********************LA*}
        fatVenda.strEndEnt := '';
        fatVenda.strBaiEnt := '';
        fatVenda.strCepEnt := '';
        fatVenda.strCidEnt := '';
        fatVenda.strNomCidEnt := '';        
        fatVenda.strEstEnt := '';
        fatVenda.strRefEnt := '';

        {***************************}
        {* DADOS DE COBRANÇA       *}
        {***********************LA**}
        fatVenda.strEndCob := '';
        fatVenda.strBaiCob := '';
        fatVenda.strCepCob := '';
        fatVenda.strCidCob := '';
        fatVenda.strEstCob := '';

        fatVenda.strCodPor := '';

        edtSenVen.Text := '';
        edtNomVen.Text := '';
        edtCodRep.Text := '';

        If fEmptyStr(FieldByName('FOR_CGCCPF').AsString) Then
          fatVenda.intCgcCpf := 0
        Else
          fatVenda.intCgcCpf := FieldByName('FOR_CGCCPF').AsInteger;                //         - CGC/CPF

        fatVenda.strCliIes := FieldByName('FOR_I_E_S_').AsString;                   //         - Ins.Estadual
        fatVenda.strCliImp := '';                                                   //         - Insc. Municipal Produtor
        fatVenda.strCliOrg := 'N';                                                  //         - Orgao Publico
        fatVenda.strDesPis := 'N';                                                  //         - Orgao Publico
        fatVenda.strZonFra := 'N';                                                  //         - Zona Franca de Manaus
        fatVenda.strDesZon := 'N';                                                  //         - Desconto Especial para Cliente Zona Franca
        fatVenda.strCodReg := '';                                                   //         - Código da Região
        fatVenda.strCliCon := 'N';                                                  //         - Consumidor Final (S/N)
        fatVenda.strCodRep := '';                                                   //         - Código do Representante
        fatVenda.strTabPre := '1';                                                  //         - Tabela de Preco
        fatVenda.strCliPer := 'N';
        fatVenda.strCliOrgDifal := 'N';                                             //         - Gera Difal para Orgao Publico

        cbTabPreco.Clear;
        cbTabPreco.Items.Add('1');
        cbTabPreco.ItemIndex := 0;

        {*****************************************}
        {* SETA A VARIAVEL CLIENTE FILIAL        *}
        {**************************************MV*}
        fatVenda.blnCliFil := FALSE;
        fatVenda.fltFat_TE := 0.0000;
        fatVenda.fltFatTE2 := 0.0000;
        fatVenda.strTEPREV := '';
        fatVenda.strTEPPRO := '';

        If assigned(fatVenda.objItensNotaEspelho) Then
        Begin
          fatVenda.blnForFil := fFornecedorFilial(FieldByName('FOR_CODFOR').AsString);
