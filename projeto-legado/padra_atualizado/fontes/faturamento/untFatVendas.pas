procedure TfrmFatVendas.mnuAltMecanicosClick(Sender: TObject);
  Var
    intRecNo: Integer;
    prcScroll: TprcScroll;
    strCodMec: String;
    blnAltTodos: Boolean;

  procedure pAlteraMecanico;
  begin
    cdsVenda.Edit;
    cdsVenda.FieldByName('ITE_CODMEC').AsString := strCodMec;
    cdsVenda.Post;
  end;

begin

  If Not fVerificaAcessoSistema('ALMITE') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Alterar Mecânicos dos Itens!', ['&O k']);
    Exit;
  End;

  If cdsVenda.IsEmpty Then
    Exit;

  If Not mnuAltMecanicos.Visible Then
    Exit;

  strCodMec := '';

  If dbgItens.Focused Then
    strCodMec := strMecanicos;

  blnAltTodos := True;

  If Not fInformarMecanicos(strCodMec, blnAltTodos) Then
    Exit;

  If Not blnAltTodos Then
    pAlteraMecanico
  Else
  Begin
    With cdsVenda Do
    Begin
      pDisableControls(cdsVenda, prcScroll);
      intRecNo := RecNo;

      First;

      While Not Eof Do
      Begin
        pAlteraMecanico;
        Next;
      End;

      RecNo := intRecNo;
      pEnableControls(cdsVenda, prcScroll);
    End;
  End;

  strMecanicos := cdsVenda.FieldByName('ITE_CODMEC').AsString;
  pInformacaoMecanicos(strMecanicos);

end;

function TfrmFatVendas.fVerificaPermissaoEntFut: Boolean;
  Var
    intRecNo: Integer;
    prcScroll: TprcScroll;
    strTrvFut: String;
    strFilter: String;
    objTabela: TRegistroMsgLiberaTabela;
    objLinha: TLinhaMsgLibera;
    cdsItensEntFut: TUniClientDataSet;

  function fPermiteStatusAguardando(strCodIte: String): Boolean;
  Begin
    Result := fCampoTabela('ITE_PEEFUT', 'CADITE', ['ITE_CODITE'], [strCodIte]) = 'S';
  End;

  function fPermiteStatusPrevisaoEntrega(strCodIte: String): Boolean;
  Begin
    Result := fCampoTabela('ITE_PEFUTP', 'CADITE', ['ITE_CODITE'], [strCodIte]) = 'S';
  End;

  function fPermiteStatusFaltaProduto(strCodIte: String): Boolean;
  Begin
    Result := fCampoTabela('ITE_PEFFPR', 'CADITE', ['ITE_CODITE'], [strCodIte]) = 'S';
  End;

  procedure pAdicionaLinhaMsg;
  begin
    objLinha := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlValor;
    objLinha.pAddColuna('Código'     , cdsVenda.FieldByName('ITE_CODITE').AsString                                                        , 07, alCentro);
    objLinha.pAddColuna('Descrição'  , cdsVenda.FieldByName('ITE_DESITE').AsString                                                        , 45, alEsquerda);
    objLinha.pAddColuna('UN'         , fRetSiglaUnidade(cdsVenda.FieldByName('ITE_CODUNI').AsString)                                      , 03, alCentro);
    objLinha.pAddColuna('UN'         , cdsVenda.FieldByName('ITE_MOTFUT').AsString                                                        , 03, alCentro);
    objLinha.pAddColuna('Quantidade' , FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), cdsVenda.FieldByName('ITE_QTDITE').AsFloat), 11, alDireita);
    objLinha.pAddColuna('Vr.Unitário', FormatFloat(fMskDigitos(fCfgSis('DECUNI', varInteger)), cdsVenda.FieldByName('ITE_UNITAR').AsFloat), 11, alDireita);
    objLinha.pAddColuna('Vr.Total'   , FormatFloat(fMskDigitos(2), cdsVenda.FieldByName('ITE_TOTITE').AsFloat)                            , 11, alDireita);
    objTabela.lstLinhas.Add(objLinha);
  end;

  procedure pFiltraCdsItensEntFutBloqueada;
  begin
    If (Not Assigned(cdsItensEntFut)) Or (cdsItensEntFut.IsEmpty) Then
      Exit;
    cdsItensEntFut.Filtered := False;
    cdsItensEntFut.Filter   := cdsItensEntFut.Filter + IIF(fEmptyStr(cdsItensEntFut.Filter), '',' OR ') + 'AUTOINCREM = ' + cdsVenda.FieldByName('AUTOINCREM').AsString;
    cdsItensEntFut.Filtered := True;
  end;

  procedure pReprocessaCustosCDS;
  begin
    strFilter := '';
    Try
      If Assigned(cdsItensEntFut) Then
      Begin
        If cdsItensEntFut.Filtered  Then
          strFilter := cdsItensEntFut.Filter;
      End;

      pRecalculaPrecos(False, False, False, True, '', False, False, False, False, False, False, False, 0, False, True);
    Finally
      If Assigned(cdsItensEntFut) Then
      Begin
        FreeAndNil(cdsItensEntFut);
        cdsItensEntFut := TUniClientDataSet.Create(Nil);
        pCloneDataSet(cdsItensEntFut, cdsVenda);

        If (strFilter <> '') Then
        Begin
          cdsItensEntFut.Filtered := False;
          cdsItensEntFut.Filter   := strFilter;
          cdsItensEntFut.Filtered := True;
        End;
      End;
      pCalculaTotais;
    End;
  end;

begin
  Result := True;
  strTrvFut := '';

  If fCfgSis('LIBEFU', varInteger) = 2 Then
  Begin
    objTabela := TRegistroMsgLiberaTabela.Create;
    objLinha  := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlCabecalho;
    objLinha.pAddColuna('', 'Código'     , 07, alCentro);
    objLinha.pAddColuna('', 'Descrição'  , 45, alEsquerda);
    objLinha.pAddColuna('', 'UN'         , 03, alCentro);
    objLinha.pAddColuna('', 'Mot'        , 03, alCentro);
    objLinha.pAddColuna('', 'Quantidade' , 11, alDireita);
    objLinha.pAddColuna('', 'Vr.Unitário', 11, alDireita);
    objLinha.pAddColuna('', 'Vr.Total'   , 11, alDireita);
    objTabela.lstLinhas.Add(objLinha);

    cdsItensEntFut := TUniClientDataSet.Create(Nil);
    pCloneDataSet(cdsItensEntFut, cdsVenda);
  End;

  With cdsVenda Do
  Begin
    pDisableControls(cdsVenda, prcScroll);
    intRecNo := RecNo;

    First;
    While Not Eof Do
    Begin
      If (FieldByName('ITE_ENTFUT').AsString = 'S') Then
        strTrvFut := strTrvFut + FieldByName('ITE_CODITE').AsString;

      If (FieldByName('ITE_ENTFUT').AsString = 'S') And //Entrega Futura
         (FieldByName('ITE_MOTFUT').AsString = 'A') And //Aguardando Cliente
         (Not fPermiteStatusAguardando(FieldByName('ITE_CODITE').AsString)) Then //Sem permissao
      Begin
        If fCfgSis('LIBEFU', varInteger) = 2 Then
        Begin
          pAdicionaLinhaMsg;
          pFiltraCdsItensEntFutBloqueada;
        End
        Else
        Begin
          fMensagem('ATENÇÃO!', Format('Entrega Futura com status "Aguardando Cliente" ' +
                                       'não permitida para o produto %s-%s!',
                                       [FieldByName('ITE_CODITE').AsString,
                                        FieldByName('ITE_DESITE').AsString]), ['&Ok']);
          Result := False;
          Break;
        End;
      End;

      If (FieldByName('ITE_ENTFUT').AsString = 'S') And //Entrega Futura
         (FieldByName('ITE_MOTFUT').AsString = 'P') And //Previsao de Entrega
         (Not fPermiteStatusPrevisaoEntrega(FieldByName('ITE_CODITE').AsString)) Then //Sem permissao
      Begin
        If fCfgSis('LIBEFU', varInteger) = 2 Then
        Begin
          pAdicionaLinhaMsg;
          pFiltraCdsItensEntFutBloqueada;
        End
        Else
        Begin
          fMensagem('ATENÇÃO!', Format('Entrega Futura com status "Previsão de Entrega" ' +
                                       'não permitida para o produto %s-%s!',
                                       [FieldByName('ITE_CODITE').AsString,
                                        FieldByName('ITE_DESITE').AsString]), ['&Ok']);
          Result := False;
          Break;
        End;
      End;

      If (FieldByName('ITE_ENTFUT').AsString = 'S') And //Entrega Futura
         (FieldByName('ITE_MOTFUT').AsString = 'F') And //Falta de Produto
         (Not fPermiteStatusFaltaProduto(FieldByName('ITE_CODITE').AsString)) Then //Sem permissao
      Begin
        If fCfgSis('LIBEFU', varInteger) = 2 Then
        Begin
          pAdicionaLinhaMsg;
          pFiltraCdsItensEntFutBloqueada;
        End
        Else
        Begin
          fMensagem('ATENÇÃO!', Format('Entrega Futura com status "Falta de Produto" ' +
                                       'não permitida para o produto %s-%s!',
                                       [FieldByName('ITE_CODITE').AsString,
                                        FieldByName('ITE_DESITE').AsString]), ['&Ok']);
          Result := False;
          Break;
        End;
      End;

      If (FieldByName('ITE_ENTFUT').AsString =   'S') And  //Entrega Futura
         (FieldByName('ITE_MOTFUT').AsString =   'F') And  //Falta Produto
         (FieldByName('ITE_IDEPRO').AsString = 'NOR') And  //Item Normal
         (Not fCfgSis('PEFUTF', varBoolean))          Then //Sem permissao
      Begin
        If (fatVenda.fRetornaSaldoDisponivelItemNormal(FieldByName('ITE_EMPITE').AsString,
                                                       FieldByName('ITE_CODITE').AsString,
                                                       FieldByName('ITE_NUMLOT').AsString,
                                                       FieldByName('AUTOINCREM').AsString,
                                                       FieldByName('ITE_CODACA').AsString,
                                                       FieldByName('ITE_EMPACA').AsString,
                                                       FieldByName('ITE_SALDOS').AsFloat,
                                                       True,
                                                       True,
                                                       IIF(fatVenda.blnEmpFat, FieldByName('ITE_EMPITE').AsString, '')) >= FieldByName('ITE_QTDITE').AsFloat) Then
        Begin
          If fCfgSis('LIBEFU', varInteger) = 2 Then
          Begin
            pAdicionaLinhaMsg;
            pFiltraCdsItensEntFutBloqueada;
          End
          Else
          Begin
            fMensagem('ATENÇÃO',Format('Entrega Futura com ' +
                                       'Status "Falta de Produto" não permitida quando o ' +
                                       'produto possuir estoque disponível!' + #13#10 + 'Produto: %s-%s',
                                       [FieldByName('ITE_CODITE').AsString,
                                        FieldByName('ITE_DESITE').AsString]), ['&Ok']);
            Result := False;
            Break;
          End;
        End;
      End;

      If (FieldByName('ITE_ENTFUT').AsString = 'S') And  //Entrega Futura
         (FieldByName('ITE_MOTFUT').AsString = 'F') And  //Falta Produto
         (Not fItemAtivoParaCompras(FieldByName('ITE_CODITE').AsString)) Then
      Begin
        If fCfgSis('LIBEFU', varInteger) = 2 Then
        Begin
          pAdicionaLinhaMsg;
          pFiltraCdsItensEntFutBloqueada;
        End
        Else
        Begin
          fMensagem('ATENÇÃO',Format('Entrega Futura com ' +
                                     'Status "Falta de Produto" não permitida quando o ' +
                                     'produto não estiver ativo para compras!' + #13#10 + 'Produto: %s-%s',
                                     [FieldByName('ITE_CODITE').AsString,
                                      FieldByName('ITE_DESITE').AsString]), ['&Ok']);
          Result := False;
          Break;
        End;
      End;

      Next;
    End;

    If (Result) And (Not fEmptyStr(strTrvFut)) And
       (Pos(fatVenda.strOpcDoc, 'OR_PD_VN_') > 0) And (Not fVerificaAcessoSistema('EMIFUT', strLoginUsuarioLogado)) Then
    Begin
      pReprocessaCustosCDS;

      objLiberacao.Clear;
      objLiberacao.objMsgRemota.strDirAce := 'EMIFUT';
      fatVenda.pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);

      objLiberacao.objMsgLibera.pAddTexto('Emissão de Entrega Futura.');

      objLiberacao.strDirAce := 'EMIFUT';
      objLiberacao.strMsgSen := 'Emissão de Entrega Futura.';
      objLiberacao.strCodOpe := fatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      If Not fatVenda.fFatMensagemLiberacao(objLiberacao) Then
        Result := False;

      pReprocessaCustosCDS;
    End;

    If (Result) And Assigned(objTabela) And (objTabela.lstLinhas.Count > 1) And
       (Pos(fatVenda.strOpcDoc, 'OR_PD_VN_') > 0) And (fSolicitarLiberacaoEntregaFuturaProdutosRestritos) Then
    Begin
      pReprocessaCustosCDS;

      objLiberacao.Clear;

      objLiberacao.strDirAce  := 'EMIFUTNL';
      objLiberacao.strMsgSen  := 'Venda de produtos em entrega futura para produtos não liberados.';
      objLiberacao.strCodOpe  := fatVenda.strCodVen;
      objLiberacao.strCodDig  := fatVenda.strCodDig;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      If (fCfgSis('TEFTPD', varInteger) = 1) Then
        pMontaObjMsgRemotaEntFutNaoLiberada(cdsItensEntFut)
      Else
        pMontaObjMsgRemotaEntFutNaoLiberada(objTabela);

      pMontaObjMsgLiberaEntFutNaoLiberada(objTabela);
      If Not fatVenda.fFatMensagemLiberacao(objLiberacao) Then
        Result := False;

      pReprocessaCustosCDS;
    End;

    RecNo := intRecNo;
    pEnableControls(cdsVenda, prcScroll);
  End;

  If Assigned(cdsItensEntFut) Then
    FreeAndNil(cdsItensEntFut);
end;

function TfrmFatVendas.fVerificaPermitidoInformarVendedor(blnCampoVendedor: Boolean): Boolean;
  Var
    strOpusvd: String;
begin
  Result := True;

  If Not fCfgSis('VTOPVD', varBoolean) Then
    Exit;

  strOpusvd := fCfgSis('OPUSVD', varString);

  If ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('G')) And (strOpusvd[1] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('D')) And (strOpusvd[2] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('T')) And (strOpusvd[3] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('O')) And (strOpusvd[4] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('S')) And (strOpusvd[5] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('I')) And (strOpusvd[6] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('C')) And (strOpusvd[7] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('E')) And (strOpusvd[8] = 'S')) Or
     ((qryConOpe.FieldByName('OPE_INTEXT').AsString.Equals('A')) And (strOpusvd[9] = 'S')) Then
    Exit;

  If (blnJaInformouVendedor) And (fatVenda.strCodVen = strVenAnt) And (blnCampoVendedor) Then
    Exit;

  If (blnJaInformouVendedor2) And (fatVenda.strCodVe2 = strRepAnt) And (Not blnCampoVendedor) Then
    Exit;

  objLiberacao.Clear;
  objLiberacao.objMsgLibera.pAddTexto('Permitir liberar operador nos campos vendedor/vendedor 2 no faturamento!');
  objLiberacao.objMsgLibera.pAddSeparador(95);
  objLiberacao.objMsgLibera.pAddTextoCaption('Cliente', fatVenda.strCodCli + '-' + fatVenda.strCliNom);
  objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor', qryConOpe.FieldByName('OPE_CODOPE').AsString + '-' + qryConOpe.FieldByName('OPE_NOMOPE').AsString);
  objLiberacao.objMsgLibera.pAddSeparador(95);

  objLiberacao.strDirAce := 'VTOPVD';
  objLiberacao.strMsgSen := 'Permitir liberar operador nos campos vendedor/vendedor 2 no faturamento!';
  objLiberacao.strCodOpe := strLoginUsuarioLogado;

  Result := objLiberacao.fLibera;
end;

function TfrmFatVendas.fVerificaPodeRecalcularItemPromocaoVlrMin(
  const strCodIte: String): Boolean;
var
  fltUniTarOri: Double;
  fltUniTarAtu: Double;
  fltUniTarProm: Double;
begin
  fltUniTarProm:= IIF(cdsVenda.FieldByName('ITE_PROVEN').AsFloat > 0,
                      cdsVenda.FieldByName('ITE_PROVEN').AsFloat,
                      cdsVenda.FieldByName('ITE_UNIDIG').AsFloat);
  fltUniTarOri := cdsVenda.FieldByName('ITE_UNIDIG').AsFloat;
  fltUniTarAtu := cdsVenda.FieldByName('ITE_UNITAR').AsFloat;

  Result := (SameValue(fltUniTarAtu, fltUniTarProm)) Or (SameValue(fltUniTarAtu, fltUniTarOri));
end;

