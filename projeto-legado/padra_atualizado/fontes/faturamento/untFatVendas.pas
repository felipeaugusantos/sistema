procedure TfrmFatVendas.pSetarRespostaEnvioDeEmail(var blnEnviaEmail, blnJaPeguntou : Boolean; const strEspDoc: String);
begin
  If (fCfgSis('NVORPD', varString) = 'N') Then
    Exit;

  If (Not Assigned(fatVenda.objPerguntasImpressaoDocumento)) Then
    Exit;

  If (Pos(strEspDoc, 'PD_OR_') <= 0) Then
    Exit;

  blnEnviaEmail := fatVenda.objPerguntasImpressaoDocumento.blnEnviarEmail;
  blnJaPeguntou := True;
end;

procedure TfrmFatVendas.pEnviarEmail;
  Var
    objParametrosEnvio : TParametrosEnvio;
    intCount : Integer;
    blnJaPeguntou : Boolean;
    blnEnviaEmail : Boolean;
begin
  blnJaPeguntou := False;
  blnEnviaEmail := False;

  if OperadorCitelLogado then
    Exit;

  Try
    for intCount:=0 to Length(fatVenda.arrDocDisparo)-1 do
    begin
      If (Not fDisparaEmailAutomatico(fatVenda.arrDocDisparo[intCount].strNumDoc,
                                      fatVenda.arrDocDisparo[intCount].strOpcDoc,
                                      fatVenda.arrDocDisparo[intCount].strEspDoc,
                                      fatVenda.arrDocDisparo[intCount].strNumOrc,
                                      fatVenda.arrDocDisparo[intCount].strEspOrc,
                                      fatVenda.arrDocDisparo[intCount].strCodEmp,
                                      fatVenda.arrDocDisparo[intCount].strCodCli,
                                      fatVenda.arrDocDisparo[intCount].QrCodePix,
                                      TFuncoesPix.RetornaLinkCitel(fatVenda.arrDocDisparo[intCount].LinkCitel, fCfgSis('HOMPIX', varString)),
                                      TGeraArquivoAnexoEmailAutomatico.New(fatVenda.arrDocDisparo[intCount].strNumDoc,
                                                                           fatVenda.arrDocDisparo[intCount].strEspDoc,
                                                                           fatVenda.arrDocDisparo[intCount].strCodEmp,
                                                                           fatVenda.arrDocDisparo[intCount].strCodCli,
                                                                           False,
                                                                           fatVenda.arrDocDisparo[intCount].strOpcDoc),
                                      '')) Then
      Begin
        If ((fCfgSis('FATEMA', varString) = 'S') And ((fatVenda.arrDocDisparo[intCount].strEspDoc = 'OR') Or (fatVenda.arrDocDisparo[intCount].strEspDoc = 'PD'))) Then
        Begin
          pSetarRespostaEnvioDeEmail(blnEnviaEmail, blnJaPeguntou, fatVenda.arrDocDisparo[intCount].strEspDoc);
          If (Not blnJaPeguntou) then
          Begin
            If (fMensagem('CONFIRMAÇÃO', 'Deseja enviar e-mail do ' + IIF(fatVenda.arrDocDisparo[intCount].strEspDoc = 'OR', 'orçamento', 'pedido') + ' gerado?', ['&Sim', '&Não'], 2) = 1) Then
              blnEnviaEmail := True
            Else
              blnEnviaEmail := False;

            blnJaPeguntou := True;
          End;

          If blnEnviaEmail Then
          Begin
            pSetDefaultParametrosEnvio(objParametrosEnvio);
            EnviarEmailPedOrc(Self,
                              strLoginUsuarioLogado,
                              fatVenda.arrDocDisparo[intCount].strAutIncFatGor,
                              fatVenda.arrDocDisparo[intCount].strNumDoc,
                              fatVenda.arrDocDisparo[intCount].strEspDoc,
                              fatVenda.arrDocDisparo[intCount].strCodEmp,
                              fatVenda.arrDocDisparo[intCount].strCodCli,
                              objParametrosEnvio);

          End;
        End;
      End;
    End;
  Except
    On E: Exception Do
      pMensagensErro(e.Message, '[pEnviarEmail]');
  End;
end;

procedure TfrmFatVendas.pEnviarSMS;
  Var
    LQRCodePix: String;
    intCount: Integer;
    DestinatarioWhatsapp: TDestinatarioWhatsapp;
begin
  if OperadorCitelLogado then
    Exit;

  DestinatarioWhatsapp := TDestinatarioWhatsapp.Create;
  try
    for intCount:=0 to Length(fatVenda.arrDocDisparo)-1 do
    begin
      If (fEmptyStr(fatVenda.arrDocDisparo[intCount].strNumOrc)) Or
         (fatVenda.arrDocDisparo[intCount].strOpcDoc = 'OR') Or
         (fatVenda.arrDocDisparo[intCount].strOpcDoc = 'PD') Or
         ((fatVenda.arrDocDisparo[intCount].strOpcDoc = 'VN') And (fatVenda.arrDocDisparo[intCount].strEspDoc = 'OR')) Or
         ((fatVenda.arrDocDisparo[intCount].strOpcDoc = 'VN') And (fatVenda.arrDocDisparo[intCount].strEspDoc = 'PD')) Then
      Begin
        LQRCodePix := fatVenda.arrDocDisparo[intCount].QrCodePix;
        If Not fatVenda.arrDocDisparo[intCount].LinkCitel.IsEmpty Then
          LQRCodePix := TFuncoesPix.RetornaLinkCitel(fatVenda.arrDocDisparo[intCount].LinkCitel, fCfgSis('HOMPIX', varString));

        fDisparaWhatsappAutomatico(fatVenda.arrDocDisparo[intCount].strNumDoc,
                                   fatVenda.arrDocDisparo[intCount].strOpcDoc,
                                   fatVenda.arrDocDisparo[intCount].strEspDoc,
                                   fatVenda.arrDocDisparo[intCount].strNumOrc,
                                   fatVenda.arrDocDisparo[intCount].strEspOrc,
                                   fatVenda.arrDocDisparo[intCount].strCodEmp,
                                   fatVenda.arrDocDisparo[intCount].strCodCli,
                                   LQRCodePix,
                                   True,
                                   '',
                                   TGeraArquivoAnexoEmailAutomatico.New(fatVenda.arrDocDisparo[intCount].strNumDoc,
                                                                        fatVenda.arrDocDisparo[intCount].strEspDoc,
                                                                        fatVenda.arrDocDisparo[intCount].strCodEmp,
                                                                        fatVenda.arrDocDisparo[intCount].strCodCli,
                                                                        False,
                                                                        fatVenda.arrDocDisparo[intCount].strOpcDoc),
                                   '',
                                   '',
                                   '',
                                   Self.UnitName,
                                   '',
                                   '',
                                   '',
                                   '',
                                   '',
                                   '',
                                   False,
                                   False,
                                   DestinatarioWhatsapp);

        fDisparaSMSAutomatico(fatVenda.arrDocDisparo[intCount].strNumDoc,
                              fatVenda.arrDocDisparo[intCount].strOpcDoc,
                              fatVenda.arrDocDisparo[intCount].strEspDoc,
                              fatVenda.arrDocDisparo[intCount].strNumOrc,
                              fatVenda.arrDocDisparo[intCount].strEspOrc,
                              fatVenda.arrDocDisparo[intCount].strCodEmp,
                              fatVenda.arrDocDisparo[intCount].strCodCli,
                              LQRCodePix);
      End;
    End;
  finally
    FreeAndNil(DestinatarioWhatsapp);
  end;
end;

procedure TfrmFatVendas.pEscapePressed;

  function fCheckParent(Sender, Parent: TWinControl): Boolean;
  begin
    If (Sender = Nil) Or (Sender.Parent = nil) Then
      Result := False
    Else If Sender.Parent = Parent Then
      Result := True
    Else
      Result := fCheckParent(Sender.Parent, Parent);
  end;

begin

  If fCheckParent(ActiveControl, pnlPesquisarDescricao) Or
     fCheckParent(ActiveControl, pnlDadosItem)  Or
     fCheckParent(ActiveControl, pnlItemCodigo) Or
     fCheckParent(ActiveControl, pnlItemLote)   Or
     fCheckParent(ActiveControl, pnlEmpresa)    Or
     fCheckParent(ActiveControl, pnlItemFim)    Then
  Begin

    If edtCodIte.Focused Then
    Begin

      btnCancelaItem.Click;
      If (Not fatVenda.blnMeiaNota) And blnPermiteAlterarCliente Then
      Begin
        edtCodCli.ReadOnly := False;
        edtSenVen.ReadOnly := False;

        If (Not fatVenda.fDocumentoParaFornecedor) And (qryConCli.Active) Then
          pVerificaAlterarVendedor(qryConCli.FieldByName('CLI_CODVEN').AsString, qryConCli.FieldByName('CLI_CODREP').AsString);
      End;

      If Pos(strOpcDoc, 'DV_PR_DD_') > 0 Then
      Begin
        fatVenda.pDestravaELimpaStlDocDevLck('','','','','',True);

        cdsVenda.EmptyDataSet;

        If (fatVenda.qryTemporaria.Active) Then
        Begin
          With fatVenda.qryTemporaria Do
          Begin
            First;

            While (Not Eof) Do
              Delete;

          End;
        End;
      End;

      pCalculaTotais;

      If (strOpcDoc = 'EP') Then
      Begin
        pSetFocus(rdgTipEmp.Components[rdgTipEmp.ItemIndex] As (TWinControl));
      End
      Else If {(Not edtCodCli.ReadOnly) And} (edtCodCli.Enabled) Then
      Begin
        pSetFocus(edtCodCli);
      End
      Else If (fatVenda.blnMeiaNota) Or (Pos(strOpcDoc,'CF_CT_CI_CN_CP_OV_') > 0) Then
      Begin

        If (fCfgSis('USADIG', varBoolean)) And (Not blnCarregouSenhaVendedorAutomaticamente) Then
        Begin
          pSetFocus(edtSenDig);
        End
        Else If fPermiteFocoCampoVendedor Then
        Begin
          pSetFocus(edtSenVen);
        End;

      End;
    End
    Else
    Begin
      btnCancelaItem.Click;
      pSetFocus(edtCodIte);
    End;

  End
  Else If Assigned(ActiveControl) And (ActiveControl.Parent = pnlBotoesVenda) And (pnlDadosItem.Enabled) Then
  Begin

    If (btnAdicionar.Tag <= 0) Then
    Begin
      edtCodIte.Enabled := True;
      pSetFocus(edtCodIte);
    End
    Else
    Begin
      btnCancelaItem.Click;
      pSetFocus(edtCodIte);
    End;

  End
  Else If pnlPlacaVeiculo.Visible And (edtCodCli.Focused) Then
  Begin
    mskPlaVei.Enabled  := True;
    btnCadVei.Enabled  := True;
    edtKM_Vei.Enabled  := True;
    pSetFocus(mskPlaVei);
  End
  Else
    inherited;

end;

