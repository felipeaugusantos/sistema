procedure TfrmFatVendas.pMostraUltimasVendas;
  Var
    strSQL  : String;
    qryUltVen: TUniQuery;
    strCodRedeLojasCliente: String;
    frmFatMostraUltVendas : TfrmFatMostraUltVendas;
begin

  strCodRedeLojasCliente := fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text]);

  If Not fEmptyStr(strCodRedeLojasCliente) And
     (fMensagem('','Exibir movimento para toda a rede de lojas do cliente?', ['','']) = 2) Then
  Begin
    strCodRedeLojasCliente := '';
  End;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  DET_DTAENT, ';
  strSQL := strSQL + '  DET_DESCRI, ';
  strSQL := strSQL + '  DET_CODEMP, ';
  strSQL := strSQL + '  DET_CODVEN, ';
  strSQL := strSQL + '  DET_NUMDOC, ';
  strSQL := strSQL + '  DET_ESPDOC, ';
  strSQL := strSQL + '  DET_CLAFIS, ';
  strSQL := strSQL + '  DET_DESCON, ';
  strSQL := strSQL + '  IF(DET_CLAFIS<5000, -1, 1) * DET_QTDITE AS DET_QTDITE, ';
  strSQL := strSQL + '  IF(DET_DESCON < 0, DET_UNITAR, DET_UNIORI) * IF(DET_CLAFIS<5000, -1, 1) AS DET_UNIORI, ';
  strSQL := strSQL + '  (DET_UNITAR - (DET_DESESP / DET_QTDITE)) * IF(DET_CLAFIS<5000, -1, 1) AS DET_UNILIQ, ';
  strSQL := strSQL + '  "N" AS VENPER,  ';
  strSQL := strSQL + '  NULL AS MOTVPD, ';
  strSQL := strSQL + '  NULL AS OBSVPD, ';
  strSQL := strSQL + '  GER_NOMCON AS NOMCON, ';
  strSQL := strSQL + '  GER_ENDCON AS ENDCON, ';

  strSQL := strSQL + '  CASE ';
  strSQL := strSQL + '    WHEN LENGTH( GER_CGCCON ) = 11 THEN ';
  strSQL := strSQL + '     CONCAT( SUBSTR( GER_CGCCON, 1,3),".", SUBSTR( GER_CGCCON, 4,3),".", SUBSTR( GER_CGCCON, 7,3),".", SUBSTR( GER_CGCCON, 10,2)  ) ';
  strSQL := strSQL + '    WHEN LENGTH( GER_CGCCON ) > 11 THEN ';
  strSQL := strSQL + '     CONCAT( SUBSTR( GER_CGCCON, 1,2),".", SUBSTR( GER_CGCCON, 3,3),".", SUBSTR( GER_CGCCON, 6,3),"/", SUBSTR( GER_CGCCON, 9,4),"/", SUBSTR( GER_CGCCON, 13,2)  ) ';
  strSQL := strSQL + '  END AS CGCCON, ';

  strSQL := strSQL + '  (SELECT CID_NOMCID FROM CADCID WHERE CID_CODCID = GER_CIDCON) AS NOMCID, ';
  strSQL := strSQL + '  GER_ESTCON AS ESTCON, ';
  strSQL := strSQL + '  DET_UNIORI AS CFG_UNIORI, ';
  strSQL := strSQL + '  DET_UNITAR AS CFG_UNITAR, ';
  strSQL := strSQL + '  DET_DESESP AS CFG_DESESP, ';
  strSQL := strSQL + '  DET_VALIPI, ';
  strSQL := strSQL + '  DET_VALRET, ';
  strSQL := strSQL + '  DET_TOTFRE, ';
  strSQL := strSQL + '  DET_VLRCON, ';
  strSQL := strSQL + '  T.DET_VFCPST ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVDET ';
  strSQL := strSQL + '  INNER JOIN MOVGER ON GER_NUMDOC = DET_NUMDOC AND ';
  strSQL := strSQL + '                       GER_ESPDOC = DET_ESPDOC AND ';
  strSQL := strSQL + '                       GER_CODEMP = DET_CODEMP AND ';
  strSQL := strSQL + '                       GER_CODCLI = DET_CODCLI     ';
  strSQL := strSQL + '  INNER JOIN CADCLI ON DET_CODCLI = CLI_CODCLI ';
  strSQL := strSQL + '  INNER JOIN MOVTRI T ON T.DET_SEQGER = MOVDET.AUTOINCREM ';
  strSQL := strSQL + 'WHERE ';

  strSQL := strSQL + '  DET_CODCLI NOT IN (' + VS_strCliFil + ') AND ';
  strSQL := strSQL + '  ((LOCATE(DET_CLAFIS, :CLAVEN) > 0) OR (LOCATE(DET_CLAFIS, :CLADEV) > 0) ';

  If fCfgSis('ENTBRF', varBoolean) Then
    strSQL := strSQL + ' OR (DET_ESPDOC = "BR") OR LOCATE(DET_CLAFIS,' + CLAFIS_BR + ')) AND '
  Else
   strSQL := strSQL + ') AND ';

  strSQL := strSQL + '  LOCATE(DET_ESPDOC, "AJ_TR_") <= 0 AND ';

  If Not fEmptyStr(edtCodCli.Text) Then
  Begin
    strSQL := strSQL + '  (CLI_CODCLI = :CODCLI ';
    If Not fEmptyStr(strCodRedeLojasCliente) Then
      strSQL := strSQL + '  OR CLI_CODRED = "' + strCodRedeLojasCliente + '") AND '
    Else
      strSQL := strSQL + '  ) AND ';
  End;

  strSQL := strSQL + '  DET_CODITE = :CODITE ';

  If fCfgSis('EXVPF7', VarBoolean) Then
  Begin
    strSQL := strSQL + '  UNION ALL ';
    strSQL := strSQL + '  SELECT ';
    strSQL := strSQL + '    VPG_DTACAD, ';
    strSQL := strSQL + '    VPD_DESITE, ';
    strSQL := strSQL + '    VPD_CODEMP, ';
    strSQL := strSQL + '    VPG_CODVEN, ';
    strSQL := strSQL + '    VPG_NUMDOC, ';
    strSQL := strSQL + '    VPG_ESPDOC, ';
    strSQL := strSQL + '    "5102" AS VPG_CLAFIS, ';
    strSQL := strSQL + '    0.00 AS DET_DESCON, ';
    strSQL := strSQL + '    VPD_QTDITE, ';
    strSQL := strSQL + '    VPD_UNIORI, ';
    strSQL := strSQL + '    VPD_UNITAR, ';
    strSQL := strSQL + '    "S" AS VENPER, ';
    strSQL := strSQL + '    MOT_DESMOT AS MOTVPD, ';
    strSQL := strSQL + '    VPD_OBSERV AS OBSVPD, ';
    strSQL := strSQL + '    NULL AS NOMCON, ';
    strSQL := strSQL + '    NULL AS ENDCON, ';
    strSQL := strSQL + '    NULL AS CGCCON, ';
    strSQL := strSQL + '    NULL AS NOMCID, ';
    strSQL := strSQL + '    NULL AS ESTCON, ';
    strSQL := strSQL + '    VPD_UNIORI AS CFG_UNIORI, ';
    strSQL := strSQL + '    VPD_UNITAR AS CFG_UNITAR, ';
    strSQL := strSQL + '    0.00 AS CFG_DESESP, ';
    strSQL := strSQL + '    0.00 AS DET_VALIPI, ';
    strSQL := strSQL + '    0.00 AS DET_VALRET, ';
    strSQL := strSQL + '    0.00 AS DET_TOTFRE, ';
    strSQL := strSQL + '    0.00 AS DET_VLRCON, ';
    strSQL := strSQL + '    0.00 AS DET_VFCPST  ';
    strSQL := strSQL + '  FROM ';
    strSQL := strSQL + '    MOVVPG ';
    strSQL := strSQL + '    INNER JOIN MOVVPD ON VPD_CODIGO = VPG_CODIGO AND VPD_CODEMP = VPG_CODEMP ';
    strSQL := strSQL + '    INNER JOIN CADCLI ON CLI_CODCLI = VPG_CODCLI ';
    strSQL := strSQL + '    LEFT  JOIN MOTVPD ON MOT_CODMOT = VPD_CODMOT ';
    strSQL := strSQL + '  WHERE ';
    strSQL := strSQL + '    VPG_CODCLI NOT IN (' + VS_strCliFil + ') AND ';

    If Not fEmptyStr(edtCodCli.Text) Then
    Begin
      strSQL := strSQL + '  (CLI_CODCLI = :CODCLI ';
      If Not fEmptyStr(strCodRedeLojasCliente) Then
        strSQL := strSQL + '  OR CLI_CODRED = "' + strCodRedeLojasCliente + '") AND '
      Else
        strSQL := strSQL + '  ) AND ';
    End;

    strSQL := strSQL + '    VPD_CODITE = :CODITE ';
  End;

  strSQL := strSQL + 'ORDER BY ';
  strSQL := strSQL + '  1 DESC ';

  qryUltVen := fCriarQuery(strSQL, Self);
  With qryUltVen Do
  Begin
    //ParamByName('CODEMP').AsString := VS_strCodEmp;
    ParamByName('CODCLI').AsString := qryConCli.FieldByName('CLI_CODCLI').AsString;
    ParamByName('CODITE').AsString := IIF(dbgItens.Focused,cdsVenda.FieldByName('ITE_CODITE').AsString, fCodItem);

    ParamByName('CLAVEN').AsString := VS_strClaVen;
    ParamByName('CLADEV').AsString := VS_strClaDev;

    Open;
    (FieldByName('DET_QTDITE') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('DET_UNIORI') As TFloatField).DisplayFormat := '#,####0.0000';
    (FieldByName('DET_UNILIQ') As TFloatField).DisplayFormat := '#,####0.0000';
    (FieldByName('CFG_UNIORI') As TFloatField).DisplayFormat := '#,####0.0000';
    (FieldByName('CFG_UNITAR') As TFloatField).DisplayFormat := '#,####0.0000';
    (FieldByName('CFG_DESESP') As TFloatField).DisplayFormat := '#,####0.0000';
    (FieldByName('DET_DESCON') As TFloatField).DisplayFormat := '#,##0.00';
    (qryUltVen.FieldByName('DET_VALIPI') As TFloatField).DisplayFormat := '#,##0.00';
    (qryUltVen.FieldByName('DET_VALRET') As TFloatField).DisplayFormat := '#,##0.00';
    (qryUltVen.FieldByName('DET_TOTFRE') As TFloatField).DisplayFormat := '#,##0.00';
    (qryUltVen.FieldByName('DET_VLRCON') As TFloatField).DisplayFormat := '#,##0.00';
    (qryUltVen.FieldByName('DET_VFCPST') As TFloatField).DisplayFormat := '#,##0.00';

    If (Not IsEmpty) Then
    Begin

      Try
        pCriarformularios(TfrmFatMostraUltVendas, frmFatMostraUltVendas);
        frmFatMostraUltVendas.dtsUltVen.DataSet := qryUltVen;
        frmFatMostraUltVendas.cxGrid1DBUltVendasCFG_UNIORI.Visible := fCfgSis('EVLPRA', varBoolean);
        frmFatMostraUltVendas.cxGrid1DBUltVendasCFG_UNITAR.Visible := fCfgSis('EVLPRA', varBoolean);
        frmFatMostraUltVendas.cxGrid1DBUltVendasCFG_DESESP.Visible := fCfgSis('EVLPRA', varBoolean);
        frmFatMostraUltVendas.showModal;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '[pMostraUltimasVendas]');
      End;
      pFreeAndNil(frmFatMostraUltVendas);

    End
    Else
    Begin
      fMensagem('', 'Não há vendas para esse item!', ['&O k']);
    End;

    Close;
    FreeAndNil(qryUltVen);
  End;

end;

function TfrmFatVendas.fDigPrecoCusto: Double;
  Var
    frmFatDigPrecoCusto : TfrmFatDigPrecoCusto;
begin

  Result := 0.0;

  Try
    pCriarFormularios(TfrmFatDigPrecoCusto, frmFatDigPrecoCusto);

    While Not frmFatDigPrecoCusto.blnConfirma Do
    Begin

      If (fAlterandoProduto) Then
      Begin
        frmFatDigPrecoCusto.fltPreCus := fFormataFloat(cdsVenda.FieldByName('ITE_PRECUS').AsFloat, 4);
        frmFatDigPrecoCusto.strNcmOut := cdsVenda.FieldByName('ITE_CLAIPI').AsString;
      End
      Else If(SameText(fatVenda.strCliEst, 'EX')) Then
      Begin
        frmFatDigPrecoCusto.strNcmOut := fRetornaNCM('', fatVenda.strCliEst, fatVenda.strCodCid, qryConIte.FieldByName('ITE_CODITE').AsString, '');
      End;

      frmFatDigPrecoCusto.showModal;

      If frmFatDigPrecoCusto.blnConfirma Then
      Begin
        strNcmOut := frmFatDigPrecoCusto.dbeNcmOut.Text;
        Result := fStrToFloat(frmFatDigPrecoCusto.edtPreCus.Text);
      End;

    End;

  Except
    On E: Exception Do
    Begin
      Result := 0.0;
      pMensagensErro(E.Message, '[fDigPrecoCusto]');
    End;
  End;

  pFreeAndNil(frmFatDigPrecoCusto);

end;

