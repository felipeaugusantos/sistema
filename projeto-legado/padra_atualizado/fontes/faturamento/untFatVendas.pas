function TfrmFatVendas.fValidaDevCompletaPDOS(blnPed_OS: Boolean): Boolean;
var
  blnPed_OS_Sec: Boolean;
  qryIteDev: TUniQuery;
begin
  Result := True;

  if (not fatVenda.blnDevolucaoCompleta) then
    Exit;

  qryIteDev := fCriaQuery;

  try
    qryIteDev.SQL.Clear;
    qryIteDev.SQL.Add('SELECT * ');
    qryIteDev.SQL.Add('FROM ' + fatVenda.strTmpIteDev + ' ');
    qryIteDev.SQL.Add('WHERE ');
    qryIteDev.SQL.Add('  DET_NUMDOC = :NUMDOC AND ');
    qryIteDev.SQL.Add('  DET_ESPDOC = :ESPDOC AND ');
    qryIteDev.SQL.Add('  DET_CODEMP = :CODEMP ');

    if fatVenda.fDocumentoParaFornecedor then
      qryIteDev.SQL.Add('  AND DET_TIP_FC = "F" ')
    else
      qryIteDev.SQL.Add('  AND DET_TIP_FC = "C" ');

    if (fatVenda.strPigBas = 'S') then
      qryIteDev.SQL.Add('  AND DET_PROACA = "N" ');

    qryIteDev.ParamByName('NUMDOC').AsString := qryConDev.FieldByName('DET_NUMDOC').AsString;
    qryIteDev.ParamByName('ESPDOC').AsString := qryConDev.FieldByName('DET_ESPDOC').AsString;
    qryIteDev.ParamByName('CODEMP').AsString := qryConDev.FieldByName('DET_CODEMP').AsString;

    qryIteDev.Open;
    qryIteDev.First;

    while not qryIteDev.Eof do
    begin
      blnPed_OS_Sec := (qryIteDev.FieldByName('DET_ESP_PD').AsString = 'PD')
        and (not fEmptyStr(fRetornaOrdemServicoPedido(qryIteDev.FieldByName('DET_NUM_PD').AsString, qryIteDev.FieldByName('DET_EMP_PD').AsString)));

      if (blnPed_OS_Sec <> blnPed_OS) then
      begin
        Result := False;
        fMensagem('ATENÇÃO!','Não é permitido efetuar devolução de vendas oriundas de OS e vendas não oriundas de OS por conta da configuração "CFG_CSTCEQ".', ['&Ok']);
        Exit;
      end;

      qryIteDev.Next;
    end;
  finally
    FreeAndNil(qryIteDev);
  end;
end;

function TfrmFatVendas.fRateiaFreteDaTransportadoraNosProdutos: Boolean;
begin
  Result := True;

  If fRateiaFreteItensTransportadora(fatVenda.strCodTra, fatVenda.strTipFre) And (fatVenda.fltValFre > 0) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    fatVenda.fltFreRat := fatVenda.fltValFre;
    fatVenda.fltValFre := 0.00;
    fatVenda.fltFreDig := 0.00;

    fatVenda.pCalculaTotGer;
    pAtualizarEditsTotais;
  End;

end;

function TfrmFatVendas.fVerificaCreditoAlpe: Boolean;
var
  objParametrosMensagem: TParametrosMensagem;
begin
  Result := True;

  if (fCfgSis('USAALP', varBoolean)) and
     (fatVenda.strCodCnd = fCfgSis('CPGALP', varString)) and
     (fatVenda.fltTotGer > fatVenda.fltCreAlp) then
  begin
    objParametrosMensagem := TParametrosMensagem.Create;
    try
      objParametrosMensagem.Titulo := 'Alpe';
      objParametrosMensagem.Texto  := 'Cliente não possui saldo suficiente!'+#13#10+
                                      'Valor Total do Pedido: ' + Format('%m', [fatVenda.fltTotGer])+#13#10+
                                      'Saldo Disponível: ' + Format('%m', [fatVenda.fltCreAlp])+#13#10;
      objParametrosMensagem.Opcoes := ['&OK'];
      fMensagem(objParametrosMensagem);
    finally
      objParametrosMensagem.Free;
    end;

    Result := False;
  end;
end;

function TfrmFatVendas.fRealizaFechamentoVenda(): Boolean;
var
  LfltIcmOrg,
  LfltTotSPro,
  LfltTotCPro,
  LfltTotBruSPro,
  LfltTotBruCPro,
  LfltTotGer,
  LfltTotPro,
  LfltTotDes    : Double;
begin
  Result := True;

  LfltIcmOrg     := fatVenda.fltIcmOrg;
  LfltTotSPro    := fatVenda.fltTotSPro;
  LfltTotCPro    := fatVenda.fltTotCPro;
  LfltTotBruSPro := fatVenda.fltTotBruSPro;
  LfltTotBruCPro := fatVenda.fltTotBruCPro;
  LfltTotGer     := fatVenda.fltTotGer;
  LfltTotPro     := fatVenda.fltTotPro;
  LfltTotDes     := fatVenda.fltTotDes;

  Try
    If Not fatVenda.fValidaAliquotaInternaEstadoDestino Then
      Exit(False);

    If Not fRateiaFreteDaTransportadoraNosProdutos() Then
      Exit(False);

    If Not fatVenda.fValidouItensBonificados(strOpcDoc) Then
      Exit(False);

    If Not fValidaPermissaoEmitirCupom Then
      Exit(False);

    If fatVenda.fItensObrNfe(True) Then
      Exit(False);

    If Not fSolicitarEnderecoDeEntrega() Then
      Exit(False);

    If Not fValidaEspecieVendaPresencial Then
      Exit(False);

    If Not fatVenda.fSolicitaDataHoraEntradaSaidaNotaFiscal() Then
      Exit(False);

    If Not fVerificaSeCondicaoPagamentoDeveSerAVista() Then
      Exit(False);

    If Not fAjustarCondicaoPagamentoNotaComplementar() Then
      Exit(False);

    If Not fDefinirValorJaRecebidoComoPagamentoAntecipado() Then
      Exit(False);

    If Not fCarregarDuplicatasPedirFormasPagamento() Then
      Exit(False)
    else
      pDesabilitaControlesPixConfirmado ;

    If Not fPedeDadosFinanceira(FVariaveisFechamentoVenda.fltTotMod) Then
      Exit(False);

    If Not fAlterarDuplicatasAdicionandoValorDoAdiantamento() Then
      Exit(False);

    If Not fVerificaNoPedidoValorMinimoEmitirNF() Then
      Exit(False);

    If Not fatVenda.fVerificaValorMinimoParcela() Then
      Exit(False);

    If Not fPerguntarSeGeraFormulacaoTintaMaquina() Then
      Exit(False);

    If (Not fValidouMinimoDocumentosDesmembrados) Then
      Exit(False);

    If Not fVerificaIntervaloMargemValorCndPagto() Then
      Exit(False);

    If Not fatVenda.fVerificaValorCrediario(fRetCodVenDef(edtSenVen.Text)) Then
      Exit(False);

    If fatVenda.fTemProdutosComboVigenciaVencida() Then
      Exit(False);

    If Not fVerificaDebitosAtrasoLimiteCredito() Then
      Exit(False);

    If Not fatVenda.fProcessarRequisicaoCompra(objCdsVinculos) Then
      Exit(False);

    If Not fPerguntarSeEnviaPedidoParaLiberacao() Then
      Exit(False);

    If Not fVerificaFlexNegativo() Then
      Exit(False);

    If fItensComSaldoEmProcessamento() Then
      Exit(False);

    If Not fatVenda.fDefineAbastecimentoItensSemEstoqueSuficiente Then
      Exit(False);

    If Not fatVenda.fRealizarLiberacaoRemotaFinalVenda() Then
    Begin
      Exit(False);
    End
    Else
    Begin
      If fatVenda.blnLiberacaoRemotaNoFinalVenda And (fCfgSis('ALTVMT', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
        pAjustaValorProdutoPrecoMinimo;
    End;

    If Not fValidarNumeroComandaEmissaoPedido() Then
      Exit(False);

    If Not fRetornarContatoAoCliente() Then
      Exit(False);

    If Not fProdutoAmostra() Then
      Exit(False);

    If (Not fatVenda.fPedeDadosDoCaixa) Then
      Exit(False);

    if not fValidarDescontoEntreCapaItensCtrlF10() then
      Exit(False);

    if Not fGeraTransacaoPix() then
      Exit(False);

    If (Not fatVenda.fLiberarEmitirPedidoYapayValorMaiorCfgYAPSSR(objLiberacao)) Then
      Exit(False);

    if not fatVenda.fVerificaInfoIntegradorSatCitel then
      Exit(False);

    If (Not fValidouPedidoComLinkDePagamento) Then
      Exit(False);

    If (Not fValidouPedidoComLinkDePagamentoCobrancaEletronica) Then
      Exit(False);

    If Not fPerguntarSeConfirmaEmissaoVenda() Then
      Exit(False);

    If Not fatVenda.AtualizaValorTotalDoRegistroDoPix() Then
      Exit(False);

    If Not AtualizaDadosTFAutomaticaOrdemPagamento Then
      Exit(False);

    If Not fValidarSeValorVendaDifereValorPedido() Then
      Exit(False);

    If Not fInserirItensLogSeparacaoAutocenter() Then
      Exit(False);

    If Not fPermiteFaturamentoNoDiaDaSemana() Then
      Exit(False);

    If Not fVerificarEstoqueAntesGravarDocumento() Then
      Exit(False);

    If (THorOpe.fExisteRestricoesDeAcesso(resVenda, True)) Then
      Exit(False);

    if fSeForTefENaoExecutouOperacao() then
      Exit(False);

    If (Pos(strOpcDoc, 'VN_') > 0) And
       (Pos(fatVenda.strEspDoc, 'PD_') > 0) And
       fEmptyStr(fatVenda.strCodigoCaixa) And
       (fatVenda.blnRealizandoAdiantamentoPedidoPeloVN) Then
    Begin
      If Not fatVenda.fPedeDadosDoCaixa() Then
        Exit(False);
    End;

    If Not fVerificaCreditoAlpe() Then
      Exit(False);

    If Not fatVenda.fVerificaCondicaoBonificacaoPedidoVenda() Then
      Exit(False);

    If Not fPermiteAlteracaoValorContabilComAdiantamento Then
      Exit(False);

    If Not fLimpaSeparacaoItensServico() Then
      Exit(False);

    If Not fLimpaArrayDocDisparo() Then
      Exit(False);

    If Not fGravarDocumentoVenda() Then
      Exit(False);

    fatVenda.pGravaVinculoRequisicoes;
  Finally
    If (Not Result) Then
    Begin
      If Not fatVenda.fExecutandoNovoFechamentoOrcamentoPedido() Then
        pAbortarEmissaoVenda();

      If (fatVenda.strTipOpe = 'R') And
         (Not blnConfirma) Then
      Begin
        fatVenda.strTipOpe := 'V';

        fatVenda.fltIcmOrg     := LfltIcmOrg;
        fatVenda.fltTotSPro    := LfltTotSPro;
        fatVenda.fltTotCPro    := LfltTotCPro;
        fatVenda.fltTotBruSPro := LfltTotBruSPro;
        fatVenda.fltTotBruCPro := LfltTotBruCPro;
        fatVenda.fltTotGer     := LfltTotGer;
        fatVenda.fltTotPro     := LfltTotPro;
        fatVenda.fltTotDes     := LfltTotDes;
      End;
    End;
  End;

end;

