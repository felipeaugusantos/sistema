function TfrmFatVendas.fRecalculaImpostos(pgbStatus: TcxProgressBar): Boolean;
  Var
    prcScrollVenda: TprcScroll;
Begin
  Result := True;

  With cdsVenda Do
  Begin
    pInfoStatusGravacao(pgbStatus, 'Aguarde...Recalculando Impostos...');
    pDisableControls(cdsVenda, prcScrollVenda);
    Try
      First;
      While Not Eof Do
      Begin
        fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
        Next;
      End;
    Finally
      pEnableControls(cdsVenda, prcScrollVenda);
      pCalculaTotais;
      First;
    End;
  End;
end;

procedure TfrmFatVendas.pRecalculaImpostos;
begin
  If fGridVendaVazio Then
    Exit;

  pCriarFormularios(TfrmGravando, frmGravando);
  Try
    Try
      frmGravando.pgbStatus.Visible := False;
      frmGravando.fExecutarAcao := fRecalculaImpostos;
      frmGravando.ShowModal;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '');
      End;
    End;
  Finally
    pFreeAndNil(frmGravando);
  End;
end;

procedure TfrmFatVendas.pRecalcularItensComboVenda(intSeqCom: Integer);
Var
  intRecNo: Integer;
begin

  Try
    blnAtualizarItensDoComboParaPrecoDeTabela := True;
    pAlteraDadosProdCombo;
  Finally
    blnAtualizarItensDoComboParaPrecoDeTabela := False;
  End;

  intRecNo := cdsVenda.RecNo;
  cdsVenda.First;

  cdsVenda.DisableControls;

  Try

    While Not cdsVenda.Eof Do
    Begin
      If (cdsVenda.FieldByName('ITE_SEQCOM').AsInteger = intSeqCom) And (cdsVenda.FieldByName('ITE_ATIVAC').AsString <> 'S') Then
      Begin
        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_SITUAC').AsString := 'N';
        cdsVenda.Post;
      End;
      cdsVenda.Next;
    End;

  Finally
    cdsVenda.EnableControls;
  End;

  dbgItens.Refresh;

  If (intRecNo > cdsVenda.RecordCount) Then
    cdsVenda.Last
  Else
    cdsVenda.RecNo := intRecNo;

end;

procedure TfrmFatVendas.pRecalcularItensPromocaoValorMinTotProdutos(
  const strCodIte, strCodUni: String; blnDel: Boolean; strRshDel,
  strRshAtu: String);
  Var
    blnRecalcular : Boolean;
begin
  If Not (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Exit;

  If Not fCfgSis('UTIVMP', varBoolean) Then
    Exit;

  If (fRecalculaItensPromocaoValorMinimoTotal(strCodIte,
                                              strCodUni,
                                              blnDel,
                                              strRshDel,
                                              strRshAtu)) Then
  Begin
    blnRecalcular := True;
    If (blnDel) And (Length(objPromVlrMinTotalProdutos.ArrItemPro) = 0) Then
      blnRecalcular := False;
