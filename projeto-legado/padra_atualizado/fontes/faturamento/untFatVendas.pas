procedure TfrmFatVendas.mnuImportarItensDeOutrosDocumentosClick(Sender: TObject);
Var
  frmDigDocumentoEmpresa: TfrmDigDocumentoEmpresa;
  blnImportado  : Boolean;
  blnSintetizar : Boolean;
begin
  inherited;

  If Not fVerificaAcessoSistema('IMITOD') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Importar itens de outros documentos!', ['&O k']);
    Exit;
  End;

  If Not mnuImportarItensDeOutrosDocumentos.Visible Then
    Exit;

  If Not fVerificaCamposInterna Then
    Exit;

  blnImportado := False;
  pCriarFormularios(TfrmDigDocumentoEmpresa, frmDigDocumentoEmpresa);
  frmDigDocumentoEmpresa.objFatVenda := fatVenda;

  Try
    Repeat
      If (Pos(strOpcDoc, 'TE_') > 0) Then
        frmDigDocumentoEmpresa.blnTipoPreco := False;

      frmDigDocumentoEmpresa.ShowModal;
      If frmDigDocumentoEmpresa.blnConfirma Then
      Begin

        blnSintetizar := frmDigDocumentoEmpresa.blnAgruparItens And fCfgSis('IMPSIN', VarBoolean);

        If (blnSintetizar) Then
          blnSintetizar := fEmptyStr(frmDigDocumentoEmpresa.edtNumDoc.Text);

        If (blnSintetizar) Then
        Begin
          blnImportado := fSintetizarItensDeOutroDocumento(frmDigDocumentoEmpresa.strIdFATGORSelecionados,
                                                           frmDigDocumentoEmpresa.strIdMOVGERSelecionados,
                                                           frmDigDocumentoEmpresa.strIdNOTGERRSelecionados,
                                                           frmDigDocumentoEmpresa.tpPrecoImpItem,
                                                           frmDigDocumentoEmpresa.blnOrdemOriginal,
                                                           frmDigDocumentoEmpresa.blnCarregarAmbiente);
        End
        Else
        Begin
          blnImportado := fImportaItensDeOutroDocumento(frmDigDocumentoEmpresa.strIdFATGORSelecionados,
                                                        frmDigDocumentoEmpresa.strIdMOVGERSelecionados,
                                                        frmDigDocumentoEmpresa.strIdNOTGERRSelecionados,
                                                        frmDigDocumentoEmpresa.tpPrecoImpItem,
                                                        frmDigDocumentoEmpresa.blnAgruparItens,
                                                        frmDigDocumentoEmpresa.blnOrdemOriginal,
                                                        frmDigDocumentoEmpresa.blnCarregarAmbiente);
        End;

      End;
    Until blnImportado Or Not frmDigDocumentoEmpresa.blnConfirma;

    If (frmDigDocumentoEmpresa.tpPrecoImpItem = tpPrecoDocumentoOriginalComDesconto) Or
       (frmDigDocumentoEmpresa.tpPrecoImpItem = tpPrecoDocumentoOriginalSemDesconto) Then
      fatVenda.pAcertaPrecosTinta(-1, True);

  Finally
    FreeAndNil(frmDigDocumentoEmpresa);
  End;
end;

procedure TfrmFatVendas.mnuIncluirVendasPerdidasClick(Sender: TObject);
Var
  objItem             : TItemVendasPerdidas;
  qryTemp             : TUniQuery;
  blnExigeSenha       : Boolean;
  strSenha,
  strSenhaConfg       : String;
  blnExisteOcorrencia : Boolean;
begin

  inherited;

  If Not fVerificaAcessoSistema('INVDPE') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Incluir Vendas Perdidas!', ['&O k']);
    Exit;
  End;

  If cdsVenda.IsEmpty Then
  Begin
    fMensagem('', 'Não há nenhum item para ser adicionado em vendas perdidas!', ['&Ok']);
    Exit;
  End;

  blnExisteOcorrencia := (Not fEmptyStr(fRetornaCodigoOcorrencia(strNumOrc,
                                        strEspOrc,
                                        fatVenda.strCodCli,
                                        VS_strCodEmp,'')));

  pCriarFormularios(TfrmFatSelItemVendaPerdida, frmFatSelItemVendaPerdida);
  frmFatSelItemVendaPerdida.blnExisteDocumento  := not fEmptyStr(strNumOrc);
  frmFatSelItemVendaPerdida.blnExisteOcorrencia := blnExisteOcorrencia;

  Try

    pCloneDataSet(frmFatSelItemVendaPerdida.cdsVenda, cdsVenda);

    If frmFatSelItemVendaPerdida.ShowModal = mrOk Then
    Begin

      blnExigeSenha := ((Not fEmptyStr(fCfgSis('SENEXI'))) And (strOpcDoc <> 'OR'))
                         Or ((Not fEmptyStr(fCfgSis('SENEIO'))) And (strOpcDoc = 'OR'));

      {Documento não gravado ou item novo,
       não precisa solicitar senha! Req: 162662}
      If (blnExigeSenha) Then
        If fEmptyStr(strNumOrc) Or (Not fExisteItemPD_OR(strNumOrc,
                                                         strEspOrc,
                                                         strEmpOrc,
                                                         cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                         cdsVenda.FieldByName('ITE_SEQINC').AsString)) Then
          blnExigeSenha := False;

      If (blnExigeSenha) Then
      Begin

        If ((Not fEmptyStr(fCfgSis('SENEXI'))) And (strOpcDoc <> 'OR')) Then
          strSenhaConfg := fCfgSis('SENEXI')
        Else If ((Not fEmptyStr(fCfgSis('SENEIO'))) And (strOpcDoc = 'OR')) Then
          strSenhaConfg := fCfgSis('SENEIO')
        Else
          strSenhaConfg := '';

        If ffrmSenha(strSenha, IIF(blnExisteOcorrencia, 'Inclusão Venda Perdida', 'Exclusão de item')) Then
        Begin

          If (strSenha <> strSenhaConfg) Then
          Begin
            fMensagem('','Senha incorreta!',['&OK']);
            Exit;
          End;

        End
        Else
          Exit;
      End;

      For objItem In frmFatSelItemVendaPerdida.oblItens Do
      Begin
        If cdsVenda.Locate('AUTOINCREM', objItem.strAutoIncrem, []) And fDeletaItem(False) Then
          fatVenda.ItensVendaPerdida.Add(objItem)
        Else
          objItem.Destroy;
      End;

      pCalculaTotais;
    End;
  Finally
    FreeAndNil(frmFatSelItemVendaPerdida);

    If (cdsVenda.IsEmpty) and (not fEmptyStr(strNumOrc)) Then
    begin
      fatVenda.strNumDoc := strNumOrc;
      fatVenda.strEspDoc := strEspOrc;
      fatVenda.pInsereVendasPerdidas(false);

      If blnExisteOcorrencia Then
      Begin
        TfrmFatAltQtdeItensPedido.pBaixarPedidoNaoEntregue(strNumOrc,
                                                           strEspOrc,
                                                           VS_strCodEmp,
                                                           fatVenda.strCodCli,
                                                           False,
                                                           True);
      End
      Else
      Begin
        qryTemp := fCriaQuery(Self);
        try
          With qryTemp Do
          Begin

            fStartTransaction();

            Try

              Close;
              SQL.Clear;
              SQL.Add('DELETE FROM FATGOR         ');
              SQL.Add('WHERE FGO_NUMDOC = :NUMDOC ');
              SQL.Add('  AND FGO_ESPDOC = :ESPDOC ');
              SQL.Add('  AND FGO_CODCLI = :CODCLI ');
              SQL.Add('  AND FGO_CODEMP = :CODEMP ');
              ParamByName('NUMDOC').AsString := strNumOrc;
              ParamByName('ESPDOC').AsString := strEspOrc;
              ParamByName('CODCLI').AsString := fatVenda.strCodCli;
              ParamByName('CODEMP').AsString := VS_strCodEmp;

              {Reprocessar Saldos}
              TReprocessarSaldoItem.New
                .AddItensDoDocumento(
                  TItensReprocessarDoDocumento.New
                    .Documento(strNumOrc)
                    .Especie(strEspOrc)
                    .Empresa(VS_strCodEmp)
                  ).NotificarRoboParaReprocessarSaldos;

              ExecSQL;
              fCommit();

            Except
              fRollBack();
            End;

          End;

        finally
          FreeAndNil(qryTemp);
        end;
      End;

      Self.Close;
    end;

  End;
end;

