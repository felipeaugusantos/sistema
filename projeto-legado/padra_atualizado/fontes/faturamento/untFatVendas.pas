procedure TfrmFatVendas.pCarregarFormulacaoEtiImpressa;
Var
  qryAux: TUniQuery;
begin
  stlFormulacaoEtiImpressa := TStringList.Create;

  If fEmptyStr(strNumOrc) Then
    Exit;

  qryAux := fCriaQuery(Self);

  qryAux.SQL.Clear;
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  FDO_CODACA, ');
  qryAux.SQL.Add('  FDO_EMPACA ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  TINDOR ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  FDO_IMPRES = 1 AND ');
  qryAux.SQL.Add('  FDO_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  FDO_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  FDO_CODEMP = :CODEMP ');

  qryAux.ParamByName('NUMDOC').AsString := strNumOrc;
  qryAux.ParamByName('ESPDOC').AsString := strEspOrc;
  qryAux.ParamByName('CODEMP').AsString := strEmpOrc;
  qryAux.Open;

  While (Not qryAux.Eof) Do
  Begin
    stlFormulacaoEtiImpressa.Add(qryAux.FieldByName('FDO_CODACA').AsString +
                                 qryAux.FieldByName('FDO_EMPACA').AsString);

    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

