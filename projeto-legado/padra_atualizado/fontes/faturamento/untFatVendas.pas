            fatVenda.objItensPedidos.pAddItem(cdsVenda.FieldByName('AUTOINCREM').AsInteger, recItemPedido);
          End;

          {********************************}
          {* CARREGA AS FORMULAS DA TINTA *}
          {*****************************PH*}
