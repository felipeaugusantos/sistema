procedure TfrmFatVendas.pAtualizaProdutosGravadosVendaPerdida;
  Var
    cdsDados: TUniClientDataSet;
    qryAux: TUniQuery;
begin
  If Not mnuImportarVendasPerdidas.Visible Then
    Exit;

  cdsDados := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.Filtered := False;
    cdsDados.Filter   := 'ITE_SEQVDP <> '''' ';
    cdsDados.Filtered := True;

    If cdsDados.IsEmpty Then
      Exit;

    qryAux := fCriaQuery(Self);
    Try
      cdsDados.First;
      While Not cdsDados.Eof Do
      Begin
        qryAux.Close;
        qryAux.SQL.Clear;

        qryAux.SQL.Add(' UPDATE MOVVPD ');
        qryAux.SQL.Add('   SET VPD_IMPORT = "S" ');
        qryAux.SQL.Add(' WHERE AUTOINCREM = :SEQVDP ');
        qryAux.SQL.Add(' AND VPD_CODITE = :CODITE ');
        qryAux.SQL.Add(' AND VPD_CODEMP = :CODEMP ');

        qryAux.ParamByName('SEQVDP').AsString := cdsDados.FieldByName('ITE_SEQVDP').AsString;
        qryAux.ParamByName('CODITE').AsString := cdsDados.FieldByName('ITE_CODITE').AsString;
        qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;

        qryAux.ExecSQL;

        cdsDados.Next;
      End;

    Finally
      FreeAndNil(qryAux);
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
end;

procedure TfrmFatVendas.pRemoveProdutosCombo;
Var
  intSeqCom: Integer;
begin
  intSeqCom := cdsVenda.FieldByName('ITE_SEQCOM').AsInteger;

  cdsVenda.Edit;
  cdsVenda.FieldByName('ITE_ATIVAC').AsString  := 'N';

  If (cdsVenda.FieldByName('ITE_SITUAC').AsString = 'C') Then
    cdsVenda.FieldByName('ITE_SITUAC').AsString  := 'N';

  cdsVenda.FieldByName('ITE_SEQCOM').AsInteger := 0;
  cdsVenda.Post;

  pApagaItensComboVenda('S', intSeqCom);

  FatVenda.fOrdemItem(cdsVenda,'Delete',Nil);

  pCalculaTotais;
end;

