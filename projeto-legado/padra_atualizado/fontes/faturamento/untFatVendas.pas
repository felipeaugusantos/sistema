function TfrmFatVendas.fUtilizaCampoUnitarioLiquido : Boolean;
begin
  Result := False;
  If (Not edtUniLiq.Visible) Then
    Exit;
  If (edtUniLiq.ReadOnly) Then
    Exit;
  If (Not fUtilizaUnitarioLiquido) Then
    Exit;
  Result := True;
end;

function TfrmFatVendas.fItemSelecionadoCarregado(const ACodIte: String): Boolean;
begin
  Result := (Not fEmptyStr(ACodIte)) And
            qryConCit.Active And (Not qryConCit.IsEmpty) And
            (qryConCit.FieldByName('ITE_CODITE').AsString = ACodIte) And
            qryConIte.Active And
            (qryConIte.FieldByName('ITE_CODITE').AsString = ACodIte);
end;

procedure TfrmFatVendas.pRemoveItensAdicionadosPelaImportacao(const intSequencialAutoincrem : Integer);
  Var
    strFilter : String;
    blnFiltered : Boolean;
begin
  strFilter := cdsVenda.Filter;
  blnFiltered := cdsVenda.Filtered;
  Try
    cdsVenda.Filter := 'AUTOINCREM > ' + IntToStr(intSequencialAutoincrem);
    cdsVenda.Filtered := True;
    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      cdsVenda.Delete;
      Continue;
    End;
  Finally
    cdsVenda.Filtered := blnFiltered;
    cdsVenda.Filter := strFilter;
  End;
end;

procedure TfrmFatVendas.pCancelarNotaServico(strNumDoc, strForCli, strSerie_: String);
var
  intIndex: Integer;
  frmCancelamentoDocumentos: TFrmCancelamentoDocumentos;
begin
  frmCancelamentoDocumentos := TfrmCancelamentoDocumentos.Create(Self);
  Try
    intIndex := frmCancelamentoDocumentos.lsbEspecies.Items.IndexOf('NS - Nota Servicos');

    If intIndex = -1 Then
      Exit;

    frmCancelamentoDocumentos.FNFSeSubstituicao  := True;
    frmCancelamentoDocumentos.lsbEspecies.ItemIndex := intIndex;
    frmCancelamentoDocumentos.lsbEspecies.Selected[intIndex] := True;
    frmCancelamentoDocumentos.lsbEspeciesDblClick(frmCancelamentoDocumentos.lsbEspecies);
    frmCancelamentoDocumentos.edtNumDoc.Text := strNumDoc;
    frmCancelamentoDocumentos.edtCliFor.Text := strForCli;
    frmCancelamentoDocumentos.edtSerie.Text  := strSerie_;
    frmCancelamentoDocumentos.edtDesCri.Text := fRetNomCliente(strForCli);
    pSetFocus(frmCancelamentoDocumentos.btnAdicionar);
    frmCancelamentoDocumentos.ShowModal;
  Finally
    pFreeAndNil(frmCancelamentoDocumentos);
  End;
end;

function TfrmFatVendas.fSubstituicaoNotaServico: Boolean;
var
  qryGen : TUniQuery;
  strNumDoc: String;
  strEspDoc: String;
  strCodEmp: String;
  strSerie_: String;
  strForCli: String;
  strAcesso: String;
  strStatus: String;
begin
  Result := False;

  qryGen := fCriaQuery(Self);

  Try
    If fPesqNotaFiscalServicoSubstituicao(Self, qryGen) Then
    begin
      strNumDoc := qryGen.FieldByName('FIS_NUMDOC').AsString;
      strEspDoc := qryGen.FieldByName('FIS_ESPDOC').AsString;
      strCodEmp := qryGen.FieldByName('FIS_CODEMP').AsString;
      strSerie_ := qryGen.FieldByName('FIS_SERIE_').AsString;
      strForCli := qryGen.FieldByName('FIS_FORCLI').AsString;
      strAcesso := qryGen.FieldByName('FIS_ACESSO').AsString;
    end;

  Finally
    FreeAndNil(qryGen);
  End;

  If fEmptyStr(strAcesso) Then
    Exit;

   strStatus := fCampoTabela('NFE_STATUS', 'LOGNFE', ['NFE_ACESSO'], [strAcesso]);

  If (strStatus = 'AT') Then
  Begin
    pCancelarNotaServico(strNumDoc, strForCli, strSerie_);
  End;

   strStatus := fCampoTabela('NFE_STATUS', 'LOGNFE', ['NFE_ACESSO'], [strAcesso]);

  If (strStatus = 'CN') Then
  Begin
    fatVenda.strNfsSub := strAcesso;
    Result := True;
  End;

  If not Result Then
    fMensagem('ATENÇÃO!', 'Não foi possível referenciar a NFSe selecionada!', ['&Ok']);

end;

function TfrmFatVendas.fPedeVoucherClubeDoPintor: Boolean;
var
  objControleClubePintor : TControleClubeDoPintor;
  blnPossuiBrinde        : Boolean;
  strVoucher             : String;
begin
  Result := True;

  objControleClubePintor := TControleClubeDoPintor.Create;
  Try
    blnPossuiBrinde := objControleClubePintor.fPermiteUtilizarRotinaClubeDoPintor And
                       ((strOpcDoc = 'BR') Or
                        ((strOpcDoc = 'PD') And fatVenda.fPossuiBrindeProduto));

    If Not blnPossuiBrinde Then
    Begin
      fatVenda.strVchCdp := EmptyStr;
      Exit;
    End;

    If (Not fEmptyStr(fatVenda.strVchCdp)) Then
      Exit;

    Try
      strVoucher := InputBox('Clube do Pintor','Informe o voucher:', EmptyStr);

      If fEmptyStr(strVoucher) Then
        Exit;

      If fMensagem('Confirmação', 'Após confirmar o uso do Voucher não será possível '+
                                  'cancelar sua utilização. Deseja continuar?', ['Sim','Não']) = 2 Then
        Exit;

      If objControleClubePintor.fResgatarVoucherClubeDoPintor(
                                  strVoucher,
                                  strOpcDoc,
                                  blnPossuiBrinde) Then
        fatVenda.strVchCdp := strVoucher;
    Except
      On E:Exception Do
      Begin
        fMensagem('Erro', E.Message, ['&OK']);
        Result := False;
      End;
    End;
  Finally
    FreeAndNil(objControleClubePintor);
  End;
end;

function TfrmFatVendas.fValidouTabelaPrecoConsulta(const strTabPre : String) : Boolean;
begin
  If (fEmptyStr(strTabPre)) Then
    Exit(True);
  If (Length(strTabPre) = 1) And (CharInSet(strTabPre[1], ['1'..'7'])) Then
    Exit(True);
  If (StrToIntDef(strTabPre, -1) <= 0) Then
    Exit(False);
  Try
    Result := fCampoExiste('ITEGER', 'ITE_PREVE' + strTabPre, True);
  Except
    Result := False;
  End;
end;

function TfrmFatVendas.fRetornaNomeDaEmpresa(const strCodEmp : String) : String;
begin
  if fCfgSis('NOMEMP') = '2' then
    Result := fRetFantasiaEmpresa(strCodEmp)
  else
    Result := fRetNomeEmpresaSelec(strCodEmp);
end;

function TfrmFatVendas.fDeveCarregarPedidoOrcamento: Boolean;
begin
  Result := (Not fEmptyStr(strNumOrc)) And (blnPrimeiraVez);
end;

function TfrmFatVendas.fHabilitaRecuperarVenda : Boolean;
begin
  Result := ('PD_OR_VN_'.Contains(strOpcDoc)) And (fCfgSis('PERSAV', varString) = 'S');
end;

