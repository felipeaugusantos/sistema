procedure TfrmFatVendas.pMensagemVendedorDiferenteItensPedido;
var
  stlVendedores : TStrings;
  cdsDados      : TUniClientDataSet;
  strLinha      : String;
begin
  stlVendedores := TStringList.Create;
  cdsDados      := TUniClientDataSet.Create(nil);
  cdsDados.Data := cdsVenda.Data;

  Try
    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      strLinha := cdsDados.FieldByName('ITE_CODVEN').AsString
                + ' - '
                + fRetNomVendRep(cdsDados.FieldByName('ITE_CODVEN').AsString);

      If (stlVendedores.IndexOf(strLinha) < 0) Then
        stlVendedores.Add(strLinha);

      cdsDados.Next;
    End;

    pMensagemOk('O sistema está configurado para usar mais de um vendedor por pedido '+
                '(CFG_VNDSPD). Neste cenário, o vendedor informado no campo "Vendedor" '+
                'deve ser obrigatoriamente algum vendedor dos itens do pedido. Ajuste '+
                'o vendedor para poder continuar com a alteração.'+#13#10+
                #13#10+'Vendedor(res) do(s) item(ns):'+#13#10+
                stlVendedores.Text+#13#10+
                'Vendedor informado:'+#13#10+
                edtSenVen.Text + ' - ' + edtNomVen.Text,
                0, 196 + (Self.Canvas.TextWidth('X') * (10 + stlVendedores.Count)));
  Finally
    FreeAndNil(stlVendedores);
    FreeAndNil(cdsDados);
  End;
end;

