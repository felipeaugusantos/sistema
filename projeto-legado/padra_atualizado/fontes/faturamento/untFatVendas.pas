procedure TfrmFatVendas.mnuDescontoPorMarcaClick(Sender: TObject);
  Var
    frmFatDigDescontoPorMarca: TfrmFatDigDescontoPorMarca;
    cdsDados: TUniClientDataSet;
    stlProdutosSemDesconto: TStringList;
begin
  inherited;

  If cdsVenda.IsEmpty Then
    Exit;

  pCriarFormularios(TfrmFatDigDescontoPorMarca, frmFatDigDescontoPorMarca);
  stlProdutosSemDesconto := TStringList.Create;

  Try
    frmFatDigDescontoPorMarca.pAdicionaItens(cdsVenda);
    frmFatDigDescontoPorMarca.ShowModal;
    If frmFatDigDescontoPorMarca.ModalResult = mrOk Then
    Begin
      cdsDados := TUniClientDataSet.Create(Nil);
      Try
        pCloneDataSet(cdsDados, cdsVenda);

        cdsDados.Filtered := False;
        cdsDados.Filter   := 'ITE_CODMAR IN (' + frmFatDigDescontoPorMarca.strMarcasAltera + ')';
        cdsDados.Filtered := True;

        While Not cdsDados.Eof Do
        Begin
          cdsVenda.Locate('ITE_CODITE', cdsDados.FieldByName('ITE_CODITE').AsString, []);
          pSetFocus(dbgItens);
          Try
            pCarregaItensAlteracao;
            If (Not edtDesCon.ReadOnly) Then
            Begin
              edtDesCon.Text := frmFatDigDescontoPorMarca.fRetornaDescontoMarca(cdsDados.FieldByName('ITE_CODMAR').AsString);
              btnAdicionar.Click;
            End
            Else
            Begin
              stlProdutosSemDesconto.Add(cdsDados.FieldByName('ITE_CODITE').AsString+'-'+cdsDados.FieldByName('ITE_DESITE').AsString);
            End;
          Finally
            btnCancelaItem.Click;
            pSetFocus(dbgItens);
          End;
          cdsDados.Next;
        End;
      Finally
        FreeAndNil(cdsDados);
      End;
    End;

    If (stlProdutosSemDesconto.Count > 0) Then
    Begin
      fMensagem('ATENÇÃO!', 'Itens cujos descontos, não puderam ser aplicados: '+stlProdutosSemDesconto.CommaText, ['&Ok']);
    End;
  Finally
    pFreeAndNil(frmFatDigDescontoPorMarca);
    FreeAndNil(stlProdutosSemDesconto);
  End;
end;

procedure TfrmFatVendas.edtOprFljChange(Sender: TObject);
begin
  inherited;

