function TfrmFatVendas.fProdutoAcabadoJaInserido: Boolean;
Var
  strSQL: String;
  cdsDados : TUniClientDataSet;
  qryGen: TUniQuery;
begin
  Result := False;

  If cdsVenda.RecordCount <= 0 Then
    Exit;

  Try
    cdsDados := TUniClientDataSet.Create(Nil);
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.First;
    qryGen := fCriaQuery(Nil);
    strSQL :=  ' SELECT                                   ' +
               '   ACA_CODACA                             ' +
               '   , DET_DESCRI                           ' +
               '   , ACA_EMPEST                           ' +
               '   , ACA_SALDOS                           ' +
               '   , DET_ITETIN                           ' +
               '   , DET_CATALI                           ' +
               '   , DET_LINTIN                           ' +
               '   , DET_TIPPRE                           ' +
               '   , DET_IDEPRO                           ' +
               '   , DET_VOLPRO                           ' +
               ' FROM                                     ' +
               '    TINDET T                              ' +
               '   INNER JOIN ACAGER A                    ' +
               '     ON T.DET_CODACA = A.ACA_CODACA       ' +
               '    AND T.DET_EMPACA = A.ACA_CODEMP       ' +
               ' WHERE A.ACA_CODACA = :CODACA AND         ' +
               '       A.ACA_EMPEST = :CODEMP AND         ' +
               '       A.ACA_SALDOS > 0                   ';

    While Not cdsDados.Eof Do
    Begin
      qryGen.Close;
      qryGen.SQL.Clear;
      qryGen.SQL.Add(strSQL);
      qryGen.ParamByName('CODACA').AsString := cdsDados.FieldByName('ITE_CODACA').AsString;
      qryGen.ParamByName('CODEMP').AsString := VS_StrCodEmp;
      qryGen.Open;

      If Not qryGen.IsEmpty Then
      Begin
        If qryGen.FieldByName('DET_IDEPRO').AsString = fatVenda.strIdePro Then
          Result := True;

        If Result Then
        Begin
          If qryGen.FieldByName('DET_ITETIN').AsString = strIteTin Then
            Result := True
          Else
            Result := False;

          If Result Then
          Begin
            If qryGen.FieldByName('DET_CATALI').AsString = strCatalize Then
              Result := True
            Else
              Result := False;

            If Result Then
            Begin
              If qryGen.FieldByName('DET_LINTIN').AsString = strLinTin Then
                Result := True
              Else
                Result := False;

              If Result Then
              Begin
                If qryGen.FieldByName('DET_TIPPRE').AsString = strTipPre Then
                  Result := True
                Else
                  Result := False;

                If Result Then
                Begin
                  If qryGen.FieldByName('DET_VOLPRO').AsFloat = fltVolPro Then
                    Result := True
                  Else
                    Result := False;
                End;
              End;
            End;
          End;
        End;
      End;

      If Result Then
        Break;

      cdsDados.Next;
    End;
  Finally
    FreeAndNil(qryGen);
    FreeAndNil(cdsDados);
  End;
end;

function TfrmFatVendas.fProdutoAmostra: Boolean;
var
  blnExisteProdutoAmostra: Boolean;
  frmProdutoAmostra: TfrmProdutoAmostra;
begin
  Result := True;
  Try

    If (fatVenda.strEspDoc = 'PD') And ((fCfgSis('IMPAVE', varString) = 'S') And (fatVenda.fExisteTintaAutomotiva)) Then
    Begin
      If fMensagem('','Existe tinta de máquina automotiva neste pedido de venda.'+#13+
                      'Deseja imprimir o comprovante de recebimento da amostra do veículo?', ['&Sim', '&Não'] ) = 1 Then
      Begin
        blnExisteProdutoAmostra := Not fEmptyStr(fatVenda.strDesAmo);
        pCriarFormularios(TfrmProdutoAmostra, frmProdutoAmostra);
        frmProdutoAmostra.ShowModal;
        If frmProdutoAmostra.blnConfirma Then
        Begin
          fatVenda.strNomCli := frmProdutoAmostra.strNomCli;
          fatVenda.strDesAmo := frmProdutoAmostra.strDesAmo;
          fatVenda.blnImprimeAmostraVeiculo := True;
        End
        Else
        Begin
          If Not blnExisteProdutoAmostra Then
          Begin
            fatVenda.strNomCli := '';
            fatVenda.strDesAmo := '';
          End;
          fatVenda.blnImprimeAmostraVeiculo := False;
        End;
        pFreeAndNil(frmProdutoAmostra);
      End;
    End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fProdutoAmostra]');
        Result := False;
        Exit;
      End;
  End;
end;

