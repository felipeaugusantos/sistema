function TfrmFatVendas.fExibirTelaValidacaoComanda: Boolean;
begin
  Result := False;

  If Not fCfgSis('COMAND',varBoolean) Then
    Exit;

  Result := (fatVenda.strOpcDoc = 'PD') Or
            (blnSolicitouFecharOREmPDLocal) Or
            ((fatVenda.strOpcDoc = 'VN') And (fatVenda.strEspDoc = 'PD'));
end;

function TfrmFatVendas.fValidarNumeroComandaEmissaoPedido(): Boolean;
begin
  Result := True;

  {Comanda - PD, VN ou Conversão de OR em PD}
  if fExibirTelaValidacaoComanda then
  begin
    repeat

      {Devido ao repeat sempre inicia "Result" com True!}
      Result := True;

      FVariaveisFechamentoVenda.Comanda := TfrmFatDigCodBarrasComanda.fDigCodBarrasComanda(strNumOrc, strEspOrc, strEmpOrc);

      {Usuário cancelou digitação da comanda!}
      if (FVariaveisFechamentoVenda.Comanda.blnCancelaDig) then
      begin
        Result := False;
        Break;
      end;

      if (FVariaveisFechamentoVenda.Comanda.blnResult) then
      begin

        {Comanda informada diferente da comanda que inicializou o novo pedido}
        if (not fEmptyStr(FVariaveisFechamentoVenda.Comanda.strCodComanda)) and (not fEmptyStr(fatVenda.strBarCom)) then
          if (fatVenda.strBarCom <> FVariaveisFechamentoVenda.Comanda.strCodComanda) then
          begin
            fMensagem('ATENÇÃO!','Divergência, a comanda informada é diferente da comanda que inicializou o novo pedido.', ['&OK']);
            Result := False;
            Continue;
          end;

        if (not fEmptyStr(FVariaveisFechamentoVenda.Comanda.strCodComanda)) then
          fatVenda.strBarCom := FVariaveisFechamentoVenda.Comanda.strCodComanda;

      end
      else
      begin

        fatVenda.strBarCom := '';

        {Comanda em uso!}
        if (FVariaveisFechamentoVenda.Comanda.blnEmUso) then
        begin
          fMensagem('ATENÇÃO!','A comanda "' + FVariaveisFechamentoVenda.Comanda.strCodComanda + '" esta em uso pelo pedido: ' + #13 +
                               'Documento: ' + FVariaveisFechamentoVenda.Comanda.Documento.strNumDoc + '-'
                                             + FVariaveisFechamentoVenda.Comanda.Documento.strEspDoc + '-'
                                             + FVariaveisFechamentoVenda.Comanda.Documento.strCodEmp, ['&OK']);
        end;

        {Comanda informada diferente da vinculada ao pedido}
        if (FVariaveisFechamentoVenda.Comanda.blnDif) then
          fMensagem('ATENÇÃO!','Divergência, a comanda informada é diferente da atual utilizada no pedido.', ['&OK']);

        Result := False;

      end;

    until (Result);

    if not(Result) then
      Exit;
  end;
end;

function TfrmFatVendas.fValidarSeValorVendaDifereValorPedido: Boolean;
begin
  Result := True;

  If fCfgSis('AVIDIF', varBoolean) Then
  Begin
    If (Not fEmptyStr(fatVenda.strNumOrc)) And
       (Pos(fatVenda.strEspDoc, 'PD_OR_') <= 0) And
       (fatVenda.fltTotOri <> 0) And
       (RoundTo(fatVenda.fltTotOri - fatVenda.fltTotGer, -2) <> 0) And
       (Not fPergunta('O Valor da Venda (R$ ' + FormatFloat('#,##0.00', fatVenda.fltTotGer) +
       ')' + #13#10 + 'difere do valor do Pedido  (R$ ' + FormatFloat('#,##0.00', fatVenda.fltTotOri) + ') em ' + #13#10 + 'R$ ' +
       FormatFloat('#,##0.00', RoundTo(fatVenda.fltTotGer - fatVenda.fltTotOri, -2)) + '. ' +
       #13#10 + 'Deseja continuar?')) Then
    Begin
      Result := False;
      Exit;
    End;
  End;

end;

function TfrmFatVendas.fValidarValorPedidoMenorQueTotalJaRecebido: Boolean;
begin
  Result := True;
  If (strOpcDoc = 'PD') And (Not fCfgSis('GERCRE', varBoolean)) And
     (fatVenda.fltTotGer < fatVenda.fTotalDuplicataQuitada(strNumOrc, strEspOrc, strEmpOrc)) Then
  Begin
    fMensagem('ATENÇÃO!', 'O Valor Total do Pedido não pode ser menor que o Total já Recebido: R$ ' +
                          FormatFloat(',0.00', fatVenda.fTotalDuplicataQuitada(strNumOrc, strEspOrc, strEmpOrc)) , ['&Ok']);
    Result := False;
  End;
end;

function TfrmFatVendas.fPodeDeletarItem(blnExibeSenha:Boolean=True): Boolean;
var
  strRequisicoes: String;
  strTransferencias: String;
  ItemEstrutura : TItemEstru;
  blnExigeSenha: Boolean;
  strSenhaConfg: String;
  LDescricaoDoDireitoDeAcesso : String;
  blnTemDireitoAcessoExclusao : Boolean;
begin
  Result := False;

  If fatVenda.strOpcDoc = 'CO' Then
    Exit;

  if cdsVenda.IsEmpty then
    Exit;

  If (Not fPermiteAlterarItemFormulacaoBaixada) Then
    Exit;

  If (Not fPermiteAlterarItem) Then
  Begin
    If (fEmptyStr(cdsVenda.FieldByName('ITE_EMPSOL').AsString)) Then
      Exit;

    If Not fPedeSenhaLiberacaoExcluirItemComSolicitacaoAbastecimento Then
      Exit;
  End;

  If Not fPodeAlterarItemOutroVendedor(fatVenda.strCodVen, cdsVenda.FieldByName('ITE_CODVEN').AsString) Then
    Exit;

  If Assigned(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
  Begin
    If TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
    Begin
      fMensagem('ATENÇÃO', 'Não é permitido excluir um item de uma venda com uma cobrança Pix já recebida.', ['&Ok']);
      Exit(False);
    End;
  End;

  If fatVenda.blnFromOrdemProducao Then
  Begin
    fMensagem('','Não é permitido excluir itens em pedidos com ordem de produção vinculada!', ['&OK']);
    btnCancelaItem.Click;
    Exit;
  End;

  If (strOpcDoc = 'PD') And fCfgSis('SLTFRC', varBoolean) Then
  Begin
    If fPossuiAbastecimentoVinculadoComReqCompra(cdsVenda.FieldByName('ITE_SEQDET').AsString, strRequisicoes) Then
    Begin
      fMensagem('','Produto vinculado à requisição de compra não pode ser excluído!' + #13#10 +
        'Req. Compra: ' + strRequisicoes + '.', ['&OK']);
      btnCancelaItem.Click;
      Exit;
    End;

    If fPossuiAbastecimentoVinculadoComTransferencia(cdsVenda.FieldByName('ITE_SEQDET').AsString, strTransferencias) Then
    Begin
      fMensagem('','Produto vinculado à transferência(s) de estoque não pode ser excluído!' + #13#10 +
        'Doc. Transf.: ' + strTransferencias + '.', ['&OK']);
      btnCancelaItem.Click;
      Exit;
    End;
  End;

  If fTravaExclusaoAlteracaoDoItemExpedido(cdsVenda.FieldByName('ITE_ENTRET').AsString, cdsVenda.FieldByName('ITE_ENTFUT').AsString, True) Then
  Begin
    fMensagem('ATENÇÃO!','Não é permitido excluir este produto, pois o mesmo já possui quantidade expedida!',['&O K']);
    Exit;
  End;

  If (fAlterandoProduto) And (cdsVenda.FieldByName('ITE_SEQINC').AsInteger > 0) And (Not fEmptyStr(strNumOrc)) Then
  Begin
    // Verifica se existem itens que sairam do almoxarifado e não voltaram (somente autocenter)
    If fQuantidadeItensPendenteAlmoxarifeAutocenter(strNumOrc, strEspOrc, strEmpOrc,
                                                    cdsVenda.FieldByName('ITE_SEQINC').AsInteger) > 0 Then
    Begin
      fMensagem('', 'Este produto possui itens que saíram do almoxarifado e não voltaram, ' +
                    'é preciso efetuar a conferência de entrada ' +
                    'dos itens para poder excluir o mesmo!', ['&O k']);
      Exit;
    End;
  End;

  //Prestcon
  If (strOpcDoc = 'CN') And Not fEmptyStr(cdsVenda.FieldByName('ITE_DOCCNF').AsString) Then
  Begin
    fMensagem('', 'Não é permitido excluir este produto, pois o mesmo pertence a ' +
                  'Nota Fiscal ' + cdsVenda.FieldByName('ITE_DOCCNF').AsString, ['&Ok']);
    Exit;
  End;

  If Not fPodeExcluirItemRequsicaoCompra(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                         fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fCfgSis('DECQTD', VarInteger))) Then
  Begin
    Exit;
  End;

  If Not fEmptyStr(cdsVenda.FieldByName('ITE_ORDPRO').AsString) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido excluir este produto pois o mesmo possui ordem de produção. ' +
                          'Para excluir este produto é necessário cancelar a ordem de produção ' +
                          cdsVenda.FieldByName('ITE_ORDPRO').AsString, ['&Ok']);
    Exit;
  End;

  If (stlFormulacaoBaixada.IndexOf(cdsVenda.FieldByName('ITE_CODACA').AsString +
                                   cdsVenda.FieldByName('ITE_EMPACA').AsString) >= 0) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido excluir esta tinta de máquina, pois a mesma já foi baixada.', ['&Ok']);
    Exit;
  End;

  If (cdsVenda.FieldByName('ITE_SEQEST').AsInteger > 0) And
     (Not fPermiteVenderSubItemEstruturaAvulso(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
  Begin
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fatVenda.blnCarregandoEstrutura) Then
    Begin
      ItemEstrutura := fEhOuCompoeEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
      If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
      Begin
        If fPergunta('Não é permitido excluir sub-produto da estrutura em separado, somente a estrutura completa.' + sLineBreak +
                     IIF(fCfgSis('VENSUB') = 'P', 'Serão excluídos os sub-produtos que não são permitidos informar separadamente na venda. ',
                                                  'Serão excluídos todos os sub-produtos da estrutura. ') +
                     'Deseja prosseguir?', False) Then
        Begin
          Result := True;
        End;
        Exit;
      End;
    End;
  End;

  If (cdsVenda.FieldByName('ITE_SEQEST').AsInteger > 0) And
     (Not fPermiteTransferenciaSubItemEstruturaAvulso(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
  Begin
    If (Pos(strOpcDoc, 'TE_') > 0) And (Not fatVenda.blnCarregandoEstrutura) Then
    Begin
      ItemEstrutura := fEhOuCompoeEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
      If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
      Begin
        If fPergunta('Não é permitido excluir sub-produto da estrutura em separado, somente a estrutura completa.' + sLineBreak +
                     IIF(fCfgSis('TRASUB') = 'P', 'Serão excluídos os sub-produtos que não são permitidos informar separadamente na transferência. ',
                                                  'Serão excluídos todos os sub-produtos da estrutura. ') +
                     'Deseja prosseguir?', False) Then
          Result := True;

        Exit;
      End;
    End;
  End;

  If (fOperacaoVaiDeixarValorVendaMenorQueDescontoEspecial(True)) Then
  Begin
    Exit;
  End;

  blnExigeSenha := ((Not fEmptyStr(fCfgSis('SENEXI'))) And (strOpcDoc <> 'OR'))
                     Or ((Not fEmptyStr(fCfgSis('SENEIO'))) And (strOpcDoc = 'OR'));

  {Documento não gravado ou item novo,
   não precisa solicitar senha! Req: 162662}
  If (blnExigeSenha) Then
    If fEmptyStr(strNumOrc) Or (Not fExisteItemPD_OR(strNumOrc,
                                                     strEspOrc,
                                                     strEmpOrc,
                                                     cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                     cdsVenda.FieldByName('ITE_SEQINC').AsString)) Then
      blnExigeSenha := False;

  If blnExigeSenha and  blnExibeSenha Then
  Begin
    If ((Not fEmptyStr(fCfgSis('SENEXI'))) And (strOpcDoc <> 'OR')) Then
    begin
      strSenhaConfg := fCfgSis('SENEXI');
      LDescricaoDoDireitoDeAcesso := 'PEREXCLPRODPED';
    end
    Else If ((Not fEmptyStr(fCfgSis('SENEIO'))) And (strOpcDoc = 'OR')) Then
    begin
      strSenhaConfg := fCfgSis('SENEIO');
      LDescricaoDoDireitoDeAcesso :=  'PEREXCLPRODORC';
    end
    Else
      strSenhaConfg := '';

    blnTemDireitoAcessoExclusao := VerificarDireitoAcessoExclusaoDoItem(LDescricaoDoDireitoDeAcesso, strSenhaConfg);

    If Not blnTemDireitoAcessoExclusao Then
      Exit;
  End;

  If (Not fatVenda.blnCarregandoEstrutura) And (Not fPermiteAlterarPedido(True)) Then
    Exit;

  If (cdsVenda.FieldByName('ITE_ATIVAC').AsString = 'S') And
     (fMensagem('ATENÇÃO!', 'O Produto que está excluindo é um Produto de Ativação do Combo de Venda. Excluindo esse Produto, todos os Produtos do Combo de Venda também serão excluídos. Confirma?', ['&S i m', '&N ã o'], 2) = 2) Then
    Exit;

  Result := True;
end;

function TfrmFatVendas.fDeletaItem(blnExibeSenha:Boolean=true; blnValidarExclusao: Boolean = True): Boolean;
  Var
    strAutInc: String;
    qryGenTmp: TUniQuery;
    prcScroll: TprcScroll;
    intRecNo : Integer;

    blnRecalcularItensSairamPromocao: Boolean;

    strDevDoc,
    strDevEsp,
    strDevEmp: String;
    strAtivac: String;
    intSeqCom: Integer;
    strIteDel: String;
    strUnidadeDel : String;
    strProDel: String;
    strCodPro: String;
    strRshDel : String;
    strRshAut : String;
    intSeqEst: Integer;
    RecResult1Destino : TRecResult1Destino;
    ItemEstrutura: TItemEstru;
    blnRecalcularProdutoDoCombo : Boolean;

  function fRetEmpIte():String;
  begin
    Result := cdsVenda.FieldByName('ITE_EMPITE').AsString;

    If (Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPDMP').AsString)) Then
      Result := fatVenda.fGetEmpPrecoPromoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString, cdsVenda.FieldByName('ITE_EMPDMP').AsString);
  end;

begin
  Result := False;

  If blnValidarExclusao Then
    If Not fPodeDeletarItem(blnExibeSenha) Then
      Exit;

  If (cdsVenda.FieldByName('ITE_SEQEST').AsInteger > 0) And
     (Not fPermiteVenderSubItemEstruturaAvulso(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
  Begin
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fatVenda.blnCarregandoEstrutura) Then
    Begin
      ItemEstrutura := fEhOuCompoeEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
      If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
      Begin
        pDeletaSubItensEstrutura;
        Exit;
      End;
    End;
  End;

  If (cdsVenda.FieldByName('ITE_SEQEST').AsInteger > 0) And
     (Not fPermiteTransferenciaSubItemEstruturaAvulso(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
  Begin
    If (Pos(strOpcDoc, 'TE_') > 0) And (Not fatVenda.blnCarregandoEstrutura) Then
    Begin
      ItemEstrutura := fEhOuCompoeEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
      If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
      Begin
        pDeletaSubItensEstrutura;
        Exit;
      End;
    End;
  End;

  If (Pos(strOpcDoc, 'DV_PR_') > 0) And ((fatVenda.blnDevolucaoCompleta) Or (cdsVenda.FieldByName('ITE_SEQCOM').AsInteger > 0)) Then
  Begin
    pDeletaItemDevolucaoCompleta;
    Exit;
  End;

  {
   Se produto sendo excluido esta em promocao e existem outros do mesmo no grid que tambem estao em promocao
   devemos recalcular o preco destes produtos verificando se eles sairam da promocao devido a quantidade minima
   nao ter sido atingida.
  }
  blnRecalcularItensSairamPromocao := (cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') And
                                      (fatVenda.fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                                cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                                                                cdsVenda.FieldByName('AUTOINCREM').AsString,
                                                                cdsVenda.FieldByName('ITE_CODACA').AsString,
                                                                cdsVenda.FieldByName('ITE_EMPACA').AsString,
                                                                fRetEmpIte,
                                                                False,
                                                                False,
                                                                fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,
                                                                True {Somente em promocao}) > 0);

  intRecNo := cdsVenda.RecNo;
  strIteDel := '';
  strUnidadeDel := '';
  strProDel := '';

  Try

    qryGenTmp := fCriaQuery(Self);

    If (Not cdsVenda.IsEmpty) Then
    Begin
      If (Not fEmptyStr(strNumOrc)) Then
      Begin
        If (cdsVenda.FieldByName('ITE_QTDBAI').AsFloat > 0.0) Then
        Begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_QTDITE').AsFloat := 0;
          cdsVenda.FieldByName('ITE_TOTITE').AsFloat := 0;
          cdsVenda.Post;

          pAtualizaTemporaria;
          pCalculaTotais;

          Exit;
        End;
      End;

      If ((lstOrdemProd.Count > 0)) And (lstOrdemProd.IndexOf(dbgItens.DataSource.DataSet.FieldByName('AUTOINCREM').AsString) <> -1) Then
      Begin
        lstOrdemProd.Delete(lstOrdemProd.IndexOf(dbgItens.DataSource.DataSet.FieldByName('AUTOINCREM').AsString));

        If lstOrdemProd.Count = 0 Then
          pnlOrdPro.Visible := False;
      End;

      If ((lstProdCampanha.Count > 0)) And (lstProdCampanha.IndexOf(dbgItens.DataSource.DataSet.FieldByName('ITE_CODITE').AsString) <> -1) Then
      Begin
        lstProdCampanha.Delete(lstProdCampanha.IndexOf(dbgItens.DataSource.DataSet.FieldByName('ITE_CODITE').AsString));

        If lstProdCampanha.Count = 0 Then
          pnlProdCampanha.Visible := False;
      End;

      If ((lstProdBonus.Count > 0)) And (lstProdBonus.IndexOf(dbgItens.DataSource.DataSet.FieldByName('ITE_CODITE').AsString) <> -1) Then
      Begin
        lstProdBonus.Delete(lstProdBonus.IndexOf(dbgItens.DataSource.DataSet.FieldByName('ITE_CODITE').AsString));

        If lstProdBonus.Count = 0 Then
          pnlProdBonus.Visible := False;
      End;

      Try
        pDisableControls(cdsVenda, prcScroll);

        strAutInc := cdsVenda.FieldByName('AUTOINCREM').AsString;

        If Assigned(fatVenda.dicFormulas.RetornaObjeto(strAutInc)) Then
        Begin
          fatVenda.dicFormulas.RetornaObjeto(strAutInc).Free;
          fatVenda.dicFormulas.Remove(strAutInc);
        End;

        If (fatVenda.fEhAutocenter) Or (fCfgSis('RETDEV', varString) = 'S') Then
          fatVenda.pInsereRegistroLogItensSep(cdsVenda, 'E', cdsVenda.FieldByName('ITE_QTDITE').AsFloat, True);

        If Assigned(fatVenda.dicFormulas.RetornaObjeto('tintaDeMaquina.' + strAutInc)) Then
        Begin
          fatVenda.dicFormulas.RetornaObjeto('tintaDeMaquina.' + strAutInc).Free;
          fatVenda.dicFormulas.Remove('tintaDeMaquina.' + strAutInc);
        End;

        If (fMostraGridSubItens) Then
        Begin
          fatVenda.cdsDadosSubItensEst.EmptyDataSet;
          pMostraGridSubItens(False);
        End;

        If blnUtilizaVendaVidro And Assigned(fatVenda.objEstruturaVidros) And
           fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString) Then
        Begin
          fatVenda.objEstruturaVidros.pExcluirEstrutura(cdsVenda.FieldByName('AUTOINCREM').AsInteger);
        End;

        If (fCfgSis('NSERQT', varString) = 'S') And (cdsVenda.FieldByName('ITE_TEMNSE').AsString = 'S') Then
        Begin
          fatVenda.objFatSerieItem.AutoincItem := IntToStr(cdsVenda.FieldByName('AUTOINCREM').AsInteger);
          fatVenda.objFatSerieItem.pApagaSeries;
        End;

        If (strOpcDoc = 'PD')             And
           (strEspOrc = 'PD')             And
           (fCfgSis('USPRRO', varString) = 'S') And
           (fPDEmPreRomaneio(strNumOrc, strEspOrc, edtCodCli.Text, strEmpOrc)) Then
        Begin
          SetLength(fatVenda.arrAutIncIteDel, Length(fatVenda.arrAutIncIteDel) + 1);
          fatVenda.arrAutIncIteDel[Length(fatVenda.arrAutIncIteDel) - 1] := cdsVenda.FieldByName('ITE_SEQDET').AsString;
        End;

        If Not fEmptyStr(cdsVenda.FieldByName('ITE_SEQDET').AsString) Then
          pIncrementaListaStr(cdsVenda.FieldByName('ITE_SEQDET').AsString, fatVenda.strAutIncIteDel, True);

        pRetiraDaListaConsulta(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_IDEPRO').AsString);
        pRetiraDaListaConsultaTintadeMaquina(cdsVenda.FieldByName('ITE_ITETIN').AsString, cdsVenda.FieldByName('ITE_IDEPRO').AsString);

        fatVenda.pDelCalcFlex(strAutInc);

        If (pnlFlexVend.Visible) Then
          pExibeInformacoesFlex;

        strDevDoc:= cdsVenda.FieldByName('ITE_DOCDEV').AsString;
        strDevEsp:= cdsVenda.FieldByName('ITE_ESPDEV').AsString;
        strDevEmp:= cdsVenda.FieldByName('ITE_EMPDEV').AsString;

        strAtivac := cdsVenda.FieldByName('ITE_ATIVAC').AsString;
        intSeqCom := cdsVenda.FieldByName('ITE_SEQCOM').AsInteger;
        intSeqEst := cdsVenda.FieldByName('ITE_SEQEST').AsInteger;

        blnRecalcularProdutoDoCombo := (fCfgSis('RECCOM', varString) = 'S') And (Not strAtivac.Equals('S')) And (intSeqCom > 0);

        If (fCfgSis('OSPDVN', varBoolean)) Then
        Begin
          fatVenda.objOrdSer.pExcluirItem(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_SEQORS').AsInteger);
        End;

        strIteDel     := cdsVenda.FieldByName('ITE_CODITE').AsString;
        strUnidadeDel := cdsVenda.FieldByName('ITE_CODUNI').AsString;
        strProDel := cdsVenda.FieldByName('ITE_PROMOC').AsString;
        strRshDel := cdsVenda.FieldByName('ITE_ITETIN').AsString;

        If MatchStr(fatVenda.strOpcDoc, ['PD']) Then
        Begin
          fatVenda.pAddItemListaItensRemovidosComSeqFdo(
            cdsVenda.FieldByName('ITE_SEQDET').AsString,
            cdsVenda.FieldByName('ITE_CODITE').AsString,
            cdsVenda.FieldByName('ITE_EMPITE').AsString,
            cdsVenda.FieldByName('ITE_NUMLOT').AsString);
        End;

        cdsVenda.Delete;

        pApagaItensComboVenda(strAtivac, intSeqCom);
        pAtualizaItensEstrutura(intSeqEst);
        pRemoverTravaLogAviPRMIN(strIteDel, StrToInt(strAutInc), fatVenda.strNTrava);

        If blnRecalcularProdutoDoCombo Then
          pRecalcularItensComboVenda(intSeqCom);

        If ((Pos(strOpcDoc, 'DV_PR_') > 0) And (Not fatVenda.blnDevolucaoCompleta)) Then
        Begin
          If fEhOUltimoItemDesteDoc(strDevDoc, strDevEsp, strDevEmp) Then
          Begin
            fatVenda.pDestravaELimpaStlDocDevLck(strTabDev, strDevDoc, strDevEsp, strDevEmp, fatVenda.strCodCli);
          End;
        End;

        FatVenda.fOrdemItem(cdsVenda,'Delete',Nil);

      Finally
        pEnableControls(cdsVenda, prcScroll, not blnAlteracaoSimilares);
        If cdsVenda.IsEmpty then
        Begin
          If fEstaRotinaPedidoRetiraEmpLocalSemWMSEmpCDComWMS Then
          Begin
            chkEntCD.Checked := False;
          End;

          If (pnlLegendas.Visible) Then
          begin
            pOcultaTodosPaineisContidosEm(pnlLegendas);
          end;

          fatVenda.blnNotEspVBT := False;
        End;
      End;
    End;

  Finally
    FreeAndNil(qryGenTmp);
  End;

  If (cdsVenda.IsEmpty) And (FatVenda.blnComVal) Then
  Begin
    FatVenda.blnComVal := False;
    edtCodCli.Enabled  := True;
  End;

  If (Not cdsVenda.IsEmpty) And
     (cdsVenda.RecordCount >= intRecNo) Then
  Begin
    cdsVenda.RecNo := intRecNo;
  End;

  // Habilita novamente o destino quando tem somente 1 item
  RecResult1Destino := fPermitirApenas1Destino;
  If RecResult1Destino.blnPermitirApenas1Destino And (RecResult1Destino.intQtdItemEmp <= 1) And (fCfgSis('ENTFAT', varString, fGetEmpConfigEntrega) = 'S') Then
    pEnabledDestino(True);

  strRshAut := cdsVenda.FieldByName('ITE_ITETIN').AsString;

  TProQtdColetiva.strRshTinAtual := cdsVenda.FieldByName('ITE_ITETIN').AsString;

  TProQtdColetiva.cdsDadosPromocaoKit := Nil;
  if fCfgSis('PROKIT', varBoolean) then
  Begin
    fatVenda.pCarregarDadosParaPromocaoPorKit;
    if (Assigned(fatVenda.cdsDadosPromocaoKit) and (fatVenda.cdsDadosPromocaoKit.RecordCount > 0))  then
      TProQtdColetiva.cdsDadosPromocaoKit := fatVenda.cdsDadosPromocaoKit;
  End;

  If (fRecalculaItensPromocaoColetiva(strIteDel, strUnidadeDel, strProDel, strCodPro, True, strRshDel, strRshAut)) Then
  Begin
    pRecalculaPrecos(False, False, False, True, strCodPro);
    pCalculaTotais;
  End
  Else If blnRecalcularItensSairamPromocao Then
  Begin
    pRecalculaPrecos(False, False, False, True, '', True, True {Somente saida de promocao}, False);
    pCalculaTotais;
  End
  Else if TProQtdColetiva.fRecalculaPrecosDevidoAPromocaoPorKit then
  Begin
    pRecalculaPrecos(False, False, False, True, '', False, False, False, False, False, False, False, 0, False, False, False, True);
    pCalculaTotais;
  End;

  pRecalcularItensPromocaoValorMinTotProdutos(strIteDel, strUnidadeDel,
                                              True, strRshDel, strRshAut);

  If (strOpcDoc = 'OR') Then
  Begin
    If Assigned(qryFatGor) Then
    Begin
      If (MatchStr(qryFatGor.FieldByName('FGO_STSDEP').AsString, ['APROVADO', 'NÃO APROVADO', 'EM ANÁLISE'])) Then
        blnReanalizarSistemaDEPS := True;
    End;
  End;

  if fCfgSis('PROKIT', varBoolean) then
    fCarregarBrindesPromocaoCompostaPorKit;

  If (fatVenda.strOpcDoc = 'DV') And (Not fEmptyStr(fatVenda.strCodPrj)) And
      (cdsVenda <> nil) And (cdsVenda.RecordCount = 0) Then
    fatVenda.strCodPrj := EmptyStr;

  Result := True;
end;

function TfrmFatVendas.fValidacaoFaturamentoMinimoDesmembradoSeraFeitaAposAbastecimento(): Boolean;
begin
  Result := (fatVenda.fVaiDefinirAbastecimentoItens) And (fatVenda.fDefinirAbastecimentoItens);
end;

function TfrmFatVendas.fValidouMinimoDocumentosDesmembrados(): Boolean;
begin
  Result := True;
  If (fatVenda.blnFinali) And (('OR_PD_').Contains(fatVenda.fGetEspecieDocumento)) And (Not fValidacaoFaturamentoMinimoDesmembradoSeraFeitaAposAbastecimento) Then
  Begin
    If (Not fatVenda.fValidouValorMinimoNosDocumentosDesmembrados(True)) Then
      Exit(False);
  End;
end;

function TfrmFatVendas.fDestacarAsRetencoes: Boolean;
begin
  Result := True;

  If (fatVenda.strOpcDoc = 'CT') And (Not fatVenda.fClienteDestacaRetencoes) Then
    Exit;

  {*****************************************}
  {* CALCULA TOTAL GERAL                   *}
  {**************************************MV*}
  If Not fatVenda.fExecutandoNovoFechamentoOrcamentoPedido() Then
    pCalculaTotGer;

  fatVenda.pDestacaRetencoes;  //Necessario para calcular as retencoes dos servicos

  If Not fatVenda.fExecutandoNovoFechamentoOrcamentoPedido() Then
    pAtualizarEditsTotais;
end;

function TfrmFatVendas.fDescricaoClienteOuVendedorTabelaPreco: String;
begin
  Result := 'Cliente';
  If fCfgSis('HIETAB', VarBoolean) Then
    If fEmptyStr(fCampoTabela('CLI_TABPRE', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text], False)) Then
      Result := 'Cliente/Vendedor';
end;

function TfrmFatVendas.fDesconsideraMultiploVenda(intNFESTI : Integer): Boolean;
var
  blnEhEmbalagem : Boolean;
begin

  Result := True;

  blnEhEmbalagem := Not fEmptyStr(strCodBarEmb);

  If ((strOpcDoc = 'NE') And (TOpcItensNFespTinta(intNFESTI) = opcBasesColorantesSemDestaqueImpostos) And (fCfgSis('NFTIES') = '2')) Then
    Exit;

  If ((blnEhEmbalagem) and (fCfgSis('QPDMVC') = '2')) Then
    Exit;

  If (fatVenda.blnCarregandoEstrutura And fCfgSis('MLTEST', varBoolean)) Then
    Exit;

  Result := False;

end;

procedure TfrmFatVendas.pDesconsideraPromocaoTabItem(strPromoc: String;
  blnPromo: Boolean; blnSelecionaPromocao: Boolean = True);
begin
  if cbTabPrecoItem.Items.IndexOf('P') >= 0 then
    cbTabPrecoItem.Items.Delete(cbTabPrecoItem.Items.IndexOf('P'));

  if Pos(strOpcDoc, 'OR_PD_VN_') <= 0 then
    Exit;

  if strPromoc <> 'S' then
    Exit;

  if not blnPromo then
    Exit;

  if fCfgSis('PROPRE', varString) <> '1' then
    Exit;

  if not fCfgSis('TABITE', varBoolean) then
    Exit;

  if not fCfgSis('ALITPR', varBoolean) then
    Exit;

  cbTabPrecoItem.Items.Add('P');

  if blnSelecionaPromocao then
  begin
    cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf('P');
    cbTabPrecoItemChange(cbTabPrecoItem);
  end;
end;

function TfrmFatVendas.fDescricaoItemParaLocalizar: String;
begin
  Result := cdsVenda.FieldByName('ITE_CODITE').AsString + ' ' + cdsVenda.FieldByName('ITE_DESITE').AsString;

  If (fCfgSis('EXFAVN', varBoolean)) Then
    Result := Result + ' ' + cdsVenda.FieldByName('ITE_CODFAB').AsString;
end;

procedure TfrmFatVendas.pHabilitaCamposItem(blnHabilita: Boolean);
  Var
    intContador: Integer;
begin
  If (blnConEqu) And (strOpcDoc = 'OU') And (Not fEmptyStr(strAutincIteRemessa)) Then
  Begin
    blnHabilita := False;
    dbgItens.Enabled     := fCfgSis('EDEQSA', varBoolean);
    pnlDadosItem.Enabled := dbgItens.Enabled;
  End;

  For intContador := 0 To pnlDadosItem.ControlCount -1 Do
  Begin

    If (pnlDadosItem.Controls[intContador] Is TEdit) Then
    Begin

      If (pnlDadosItem.Controls[intContador] As TEdit).Name = 'edtCodIte' Then
        (pnlDadosItem.Controls[intContador] As TEdit).Enabled := blnHabilita
      Else
        (pnlDadosItem.Controls[intContador] As TEdit).ReadOnly := Not blnHabilita;
    End;

  End;

  If (cmbEntRet.ItemIndex = IDX_RETIRA) Then  //0 - ENTREGA  1 - RETIRA
  Begin
    mskDtaEnt.Text := DateToStr( Trunc( fNow() ) );
    mskDtaEnt.Enabled := False;
    edtDiaEnt.Clear;
    edtDiaEnt.Enabled := False;
    cmbMotEntFut.Enabled := False;
    cmbMotEntFut.ItemIndex := -1;
  End;

  pHabilitarEdicaoEmpresa;
  pEditarDesconto;
  pEditarPrecoUnitario;

  If blnHabilita Then
  Begin
    edtQtdIte.ReadOnly    := False;
    edtQtdIte.TabStop     := True;
    edtQtdIte.Color       := clWhite;
    edtQtdIte.NormalColor := clWhite;
  End;
end;

procedure TfrmFatVendas.pAtualizaDados(DataSet: TDataSet);
  Var
    fltUnitar,
    fltPreBar: Double;
    strEmpSalRes: String;
    strTabPreEmbTmp: String;
    intDiaEnt: Extended;
begin

  blnAtualizandoDados := True;
  Try

    //Precisa Ficar Antes do Exit
    If cdsVenda.Active And (Not cdsVenda.IsEmpty) Then
      Self.intRecNo := cdsVenda.RecNo;

    If (blnAtualizandoRegimeEspecialItens) Then
      Exit;

    If (Not dbgItens.Focused) And
       (Not blnAtualizarPnlDadosItemNaVendaModoTab) And
       (Not blnAtualizandoEmpresaTransferencia) And
       (Not blnAlterandoPrecoAtravesDaTrava) And
       (Not blnForcarAtualizarDados) Then
      Exit;

    With cdsVenda Do
    Begin
      strEmpSalRes := IIF(fatVenda.blnEmpFat, FieldByName('ITE_EMPITE').AsString, fatVenda.fEmpresaSaldoMatriz_CD);

      btnAdicionar.Tag   := FieldByName('AUTOINCREM').AsInteger;

      If fatVenda.blnEmpFat Then
      Begin
        edtCodEmp.Text := FieldByName('ITE_EMPITE').AsString;
        if fCfgSis('NOMEMP') = '2' then
        begin
          edtNomEmp.Text := fRetFantasiaEmpresa(edtCodEmp.Text);
        end
        else
        begin
          edtNomEmp.Text := fRetNomeEmpresaSelec(edtCodEmp.Text);
        end;

        strEmpAnt      := FieldByName('ITE_EMPITE').AsString;
      End;

      edtQtdIte.Enabled := True;
      strTabPreIteAnt    := FieldByName('ITE_TABPRE').AsString;

      If (rdbCodIte.Checked) Or (rdbCodFab.Checked And edtCodFab.Visible) Then
        edtCodIte.Text := FieldByName('ITE_CODITE').AsString
      Else
        edtCodIte.Text := FieldByName('ITE_CODFAB').AsString;

      TProQtdColetiva.strRshTinAtual := FieldByName('ITE_ITETIN').AsString;
    
      pControlaDigitacaoValoresFracionados(FieldByName('ITE_CODUNI').AsString);
    
      blnProAca          := FieldByName('ITE_PROACA').AsInteger = 1;
      strCodAtu          := FieldByName('ITE_CODITE').AsString;
      edtCodFab.Text     := FieldByName('ITE_CODFAB').AsString;
      edtAplica.Text     := AnsiReplaceStr(AnsiReplaceStr(FieldByName('ITE_APLICA').AsString, #13, ' '), STRING_QUEBRA, ' ');
      edtLocFis.Text     := FieldByName('ITE_LOCFIS').AsString;
      edtDesIte.Text     := FieldByName('ITE_DESITE').AsString;
      edtMulVen.Text     := FloatToStrF(fRetMltVenItem(FieldByName('ITE_CODITE').AsString), ffNumber, 12, 4);
      strRefere          := FieldByName('ITE_REFERE').AsString;
      edtUnidad.Text     := FieldByName('ITE_CODUNI').AsString;
      edtSigla.Text      := fRetSiglaUnidade(FieldByName('ITE_CODUNI').AsString, qryCadUni);

      strCodPar          := FieldByName('ITE_CODPAR').AsString;
      strTipBri          := FieldByName('ITE_TIPBRI').AsString;

      If (strOpcDoc = 'DV') And (fCfgSis('VENBRI', varBoolean)) And (FieldByName('ITE_BRINDE').AsString = 'S') Then
        blnInserindoBrindeDV := FieldByName('ITE_BRINDE').AsString = 'S';

      chkBrinde.Checked  := FieldByName('ITE_BRINDE').AsString = 'S';
      chkPegou.Checked   := FieldByName('ITE_PEGOU_').AsString = 'S';
      chkBaseDeTroca.Visible := fExibeOpcaoRecABaseDeTroca(FieldByName('ITE_CODITE').AsString);
      chkBaseDeTroca.Checked := FieldByName('ITE_BASTRO').AsString = 'S';

      blnInserindoBrindeDV := False;

      pExibeQtdeCaixaMaster(FieldByName('ITE_CODITE').AsString);
      pSetLabelUnidadeMedida;

      btnEstruturaVidro.Visible := fCarregarEstruturaVidro(fCodItem, btnAdicionar.Tag);

      edtNumLot.Text     := FieldByName('ITE_NUMLOT').AsString;

      fatVenda.objCadLot.strLotAnt := FieldByName('ITE_NUMLOT').AsString;
      fatVenda.strIdePro := FieldByName('ITE_IDEPRO').AsString;

      pAjustaLote(FieldByName('ITE_CODITE').AsString,
                  IIF(fatVenda.blnEmpFat, FieldByName('ITE_EMPITE').AsString, fatVenda.fEmpresaSaldoMatriz_CD),
                  FieldByName('ITE_IDEPRO').AsString,
                  FieldByName('ITE_PROACA').AsInteger = 1,
                  TClassMatrizSaldosColorantes(fatVenda.dicFormulas.RetornaObjeto(FieldByName('AUTOINCREM').AsString)));

      pExibirComplementoDescricao(FieldByName('ITE_CODITE').AsString);
      pExibirBotaoDescricaoItem(FieldByName('ITE_CODITE').AsString);

      strEmpCar          := FieldByName('ITE_EMPCAR').AsString;
      fltSaldoItemEmpCar := FieldByName('ITE_SALCAR').AsFloat;

      fltSaldoItemAtu    := FieldByName('ITE_SALDOS').AsFloat;

      pCalculaSaldoPigmento();

      fltSaldoResItemAtu := TSaldoReservado.New(
                              TReservaParametros.New()
                                .EmpresaItem(IIF(fatVenda.blnEmpFat, FieldByName('ITE_EMPITE').AsString, ''))
                                .NumeroDocumento(fatVenda.strNumOrc)
                                .CodigoItem(FieldByName('ITE_CODITE').AsString)
                                .CodEmpresa(strEmpSalRes)
                                .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                                .CodItemAcabado(IIF((FieldByName('ITE_IDEPRO').AsString = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                                .EmpItemAcabado(IIF((FieldByName('ITE_IDEPRO').AsString = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                                .NumeroLote(fRetNumLoteSeAdequado(strEmpSalRes, FieldByName('ITE_NUMLOT').AsString, FieldByName('ITE_CODITE').AsString))
                                .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                            ).fGetQuantidade();

      fltQtdeDigitada := fatVenda.fRetQtdDigitada(edtCodIte.Text,
                                                  fRetNumLoteSeAdequado(strEmpSalRes, FieldByName('ITE_NUMLOT').AsString, edtCodIte.Text),
                                                  '',
                                                  '',
                                                  '',
                                                  edtCodEmp.Text);

      edtSalDis.Text := FormatFloat(edtQtdIte.EditFormat, (fltSaldoItemAtu - fltSaldoResItemAtu) - fltQtdeDigitada);
      pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
      pHintSaldoDisponivel;

      edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, FieldByName('ITE_QTDITE').AsFloat);
      fltQtdIteAnt := FieldByName('ITE_QTDITE').AsFloat;
      fltQtdDigAnt := FieldByName('ITE_QTDITE').AsFloat;

      If Not fEmptyStr(cdsVenda.FieldByName('ITE_ORDPRO').AsString) Then
        edtQtdIte.Enabled := False;

      If (Not fEmptyStr(cdsVenda.FieldByName('ITE_BAREMB').AsString)) Then
      Begin
        fltPreBar := fRetornaPrecoCodBarraEmb(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                              cdsVenda.FieldByName('ITE_BAREMB').AsString,
                                              '',
                                              '',
                                              True);

        strTabPreEmbTmp := fRetornaTabPreCodBarraEmb(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                     cdsVenda.FieldByName('ITE_BAREMB').AsString);

        If ((fCfgSis('PREEMB', VarInteger) = 1) And (fltPreBar > 0)) Or
           ((fCfgSis('PREEMB', VarInteger) = 2) And (Not fEmptyStr(strTabPreEmbTmp))) Then
          If fCfgSis('PRVEMB', VarBoolean) Then
            edtQtdIte.Enabled := False;
      End;

      edtQtdIte.Visible     := (cdsVenda.FieldByname('ITE_TEMNSE').AsString <> 'S');
      lblQuantidade.Visible := edtQtdIte.Visible;
      btnNumSeries.Visible  := Not edtQtdIte.Visible;

      strCodBarEmb := FieldByName('ITE_BAREMB').AsString;

      If (Not fEmptyStr(strCodBarEmb)) And (fCfgSis('PREEMB', VarInteger) = 2) Then
        strTabPreEmb := FieldByName('ITE_TABPRE').AsString
      Else
        strTabPreEmb := '';

      strMecanicos := FieldByName('ITE_CODMEC').AsString;
      strIteSeqRcd := FieldByName('ITE_SEQRCD').AsString;

      pInformacaoMecanicos(strMecanicos);

      edtQtdPec.Text := FormatFloat(edtQtdPec.EditFormat, FieldByName('ITE_QTDPEC').AsFloat);
      edtComPec.Text := FormatFloat(edtComPec.EditFormat, FieldByName('ITE_COMPEC').AsFloat);
      edtLarPec.Text := FormatFloat(edtLarPec.EditFormat, FieldByName('ITE_LARPEC').AsFloat);
      edtEspPec.Text := FormatFloat(edtEspPec.EditFormat, FieldByName('ITE_ESPPEC').AsFloat);

      edtAparel.Text := FieldByName('ITE_APAREL').AsString;
      edtBenefi.Text := FieldByName('ITE_BENEFI').AsString;
      edtPerApa.Text := FormatFloat('#,##0.00', FieldByName('ITE_PERAPA').AsFloat);
      edtPerBen.Text := FormatFloat('#,##0.00', FieldByName('ITE_PERBEN').AsFloat);

      pHabilitarMetragem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_CODUNI').AsString);

      If (blnMetragemObrigatoria) Then
      Begin
        If (fStrToFloat(edtQtdPec.Text) = 0) Then
          fControlaDigMetrosCubicos(True,False);
      End;

      cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(FieldByName('ITE_TABPRE').AsString);

      strTabPreCarregadoDoItem := FieldByName('ITE_TABPRE').AsString;

      If (strOpcDoc <> 'TR') Or ((strOpcDoc = 'TR') And (Not fGridVendaVazio)) Then
      Begin
        If FieldByName('ITE_ENTSAI').AsString = 'E' Then
          cmbEntSai.ItemIndex := 0  // 0 - Entrada 1 - Saída
        Else
          cmbEntSai.ItemIndex := 1; // 0 - Entrada 1 - Saída
      End;

      If FieldByName('ITE_ENTRET').AsString = 'E' Then
         cmbEntRet.ItemIndex := IDX_ENTREGA  //DESTINO: 0 - ENTREGA  1 - RETIRA
      Else
         cmbEntRet.ItemIndex := IDX_RETIRA; //DESTINO: 0 - ENTREGA  1 - RETIRA

      If FieldByName('ITE_ENTFUT').AsString = 'S' Then
         cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA  //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
      Else
         cmbTipEnt.ItemIndex := IDX_ENTREGA_IMEDIATA; //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA

      If FieldByName('ITE_ENTRET').AsString = 'R' Then
        cmbLocRet.ItemIndex := fRetLocalRetira(FieldByName('ITE_LOCRET').AsString);

      cmbEntRetChange(nil);

      if FieldByName('ITE_PROMOC').AsString = 'S' then
        pDesconsideraPromocaoTabItem(FieldByName('ITE_PROMOC').AsString, True)
      else if not fItemSemNenhumaPromocao(cdsVenda.FieldByName('ITE_CODITE').AsString, fatVenda.fGetEmpPrecoPromoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString, cdsVenda.FieldByName('ITE_EMPDMP').AsString)) then
      begin
        strTabPreIteAnt := cbTabPrecoItem.Text;
        pDesconsideraPromocaoTabItem('S', True, False);
      End;

      If cbTabPrecoItem.Visible Then
      Begin
        strTabPreIteAnt := cbTabPrecoItem.Text;
        pEditarDesconto;
        pEditarPrecoUnitario;
      End;

      cmbMotEntFut.ItemIndex := fMotivoEntFutToIndex(FieldByName('ITE_MOTFUT').AsString);
      cmbCliBus.ItemIndex := IIF(FieldByName('ITE_CLIBUS').AsString = 'S',1,0);
      cmbTurEnt.ItemIndex := fatVenda.objTurno.fTurnoStrToInt(FieldByName('ITE_TURENT').AsString);
      mskDtaEnt.Enabled := (cmbMotEntFut.ItemIndex In [IDX_MOTIVO_FALTA_PRODUTO, IDX_MOTIVO_PREVISAO_ENTREGA]) Or
                          ((cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA));

      edtDiaEnt.Enabled := mskDtaEnt.Enabled;

      {MANPRZ = Manter prazo de entrega?}
      If fCfgSis('MANPRZ', varBoolean) And (Pos(strOpcDoc, 'PD_') > 0) Then
      Begin

        If (FieldByName('ITE_QDENTR').AsInteger > 0) Then
        Begin
          intDiaEnt      := FieldByName('ITE_QDENTR').AsInteger;
          mskDtaEnt.Text := FormatDateTime('dd/mm/yyyy', VS_Date + intDiaEnt);
          edtDiaEnt.Text := FloatToStr(intDiaEnt);

          pDefinirEntImedZero();
        End
        Else
        Begin
          mskDtaEnt.Text := '';
          edtDiaEnt.Clear;
        End;

      End
      Else
      Begin

        If (FieldByName('ITE_DTENTR').AsDateTime <> 0) Then
        Begin
          mskDtaEnt.Text := FormatDateTime('dd/mm/yyyy', FieldByName('ITE_DTENTR').AsDateTime);
          intDiaEnt      := StrToDateDef(mskDtaEnt.Text, 0) - VS_Date;
          edtDiaEnt.Text := FloatToStr(intDiaEnt);

          pDefinirEntImedZero();
        End
        Else
        Begin
          mskDtaEnt.Text := '';
          edtDiaEnt.Clear;
        End;

      End;

      //Caso for entrega imediata
      If (FieldByName('ITE_ENTRET').AsString = 'E') And (FieldByName('ITE_ENTFUT').AsString <> 'S') Then
        dtaEntImediata := FieldByName('ITE_DTENTR').AsDateTime;

      fltUnitar := FieldByName('ITE_UNIDIG').AsFloat;

      If blnUtilizaVendaMadeira Then
        fltUnitar := fVoltaUnitarioSemAparelBenefi(fltUnitar, FieldByName('ITE_PERAPA').AsFloat, FieldByName('ITE_PERBEN').AsFloat);

      edtUnitar.Text     := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUnitar);

      edtDesCon.Text     := FormatFloat(fMskDigitos(intDecDes), FieldByName('ITE_DESCON').AsFloat);

      edtTotIte.Text     := FormatFloat('#,##0.00', FieldByName('ITE_TOTITE').AsFloat);
      edtVrTotCImpostos.Text := FormatFloat('#,##0.00', fCalcularValorComImpostos(fatVenda, FieldByName('ITE_CODITE').AsString, FieldByName('ITE_TOTITE').AsFloat, cdsVenda));

      If (FieldByName('ITE_QTDITE').AsFloat > 0) Then
      Begin
        edtUnitComImpostos.Text := FormatFloat(edtUnitComImpostos.EditFormat, fCalcularValorComImpostos(fatVenda,
                                                                                                        FieldByName('ITE_CODITE').AsString,
                                                                                                        FieldByName('ITE_TOTITE').AsFloat, cdsVenda) / FieldByName('ITE_QTDITE').AsFloat);
      End
      Else
        edtUnitComImpostos.Text := FormatFloat(edtUnitComImpostos.EditFormat, 0);

      If (edtUntPec.Visible) And (fStrToFloat(edtQtdPec.Text) > 0) Then
        edtUntPec.Text := FloatToStrF(FieldByName('ITE_TOTITE').AsFloat / FieldByName('ITE_QTDPEC').AsFloat, ffFixed, 12, fatVenda.VS_IntDecUni)
      else
        edtUntPec.Text := FloatToStrF(0, ffFixed, 12, fatVenda.VS_IntDecUni);

      fatVenda.fltUniOri := FieldByName('ITE_UNIORI').AsFloat;
      fatVenda.fltUniVis := FieldByName('ITE_UNIVIS').AsFloat;
      fatVenda.fltTaxJur := FieldByName('ITE_TAXJUR').AsFloat;
      fatVenda.fltVal_RT := FieldByName('ITE_VAL_RT').AsFloat;

      fatVenda.fltCusAnt := FieldByName('ITE_PRECUS').AsFloat;

      fatVenda.fltComAnt := FieldByName('ITE_PRECOM').AsFloat;
      fatVenda.fltUniAnt := FieldByName('ITE_UNIDIG').AsFloat;
      fatVenda.fltDesAnt := FieldByName('ITE_DESCON').AsFloat;

      fatVenda.strIteTin := FieldByName('ITE_ITETIN').AsString;

      fatVenda.fltPreVe1 := FieldByName('ITE_PREVE1').AsFloat;
      fatVenda.fltPreVe2 := FieldByName('ITE_PREVE2').AsFloat;
      fatVenda.fltPreVe3 := FieldByName('ITE_PREVE3').AsFloat;
      fatVenda.fltPreVe4 := FieldByName('ITE_PREVE4').AsFloat;
      fatVenda.fltPreVe5 := FieldByName('ITE_PREVE5').AsFloat;
      fatVenda.fltPreVe6 := FieldByName('ITE_PREVE6').AsFloat;
      fatVenda.fltPreVe7 := FieldByName('ITE_PREVE7').AsFloat;

      fatVenda.fltPreLot := FieldByName('ITE_PRELOT').AsFloat;

      strNcmOut := FieldByName('ITE_CLAIPI').AsString;

      If (Pos(strOpcDoc, 'DV_PR_OF_DD_') > 0) Or (fatVenda.blnComVal) Then
      Begin

        dtaEmiDev := FieldByName('ITE_EMIDEV').AsDateTime;
        strVenDev := FieldByName('ITE_CODVEN').AsString;
        strVenDev2:= FieldByName('ITE_CODVE2').AsString;
        strCndDev := FieldByName('ITE_CNDDEV').AsString;
        strCCndDv := FieldByName('ITE_CCNDDV').AsString;
        strDocDev := FieldByName('ITE_DOCDEV').AsString;
        strEspDev := FieldByName('ITE_ESPDEV').AsString;
        strEmpDev := FieldByName('ITE_EMPDEV').AsString;
        strDivDev := FieldByName('ITE_DIVDEV').AsString;

        fltQtdDev := FieldByName('ITE_QTDDEV').AsFloat;
        fltUniDev := FieldByName('ITE_UNIDEV').AsFloat;
        fltComDev := FieldByName('ITE_COMDEV').AsFloat;
        fltDesDev := FieldByName('ITE_DESDEV').AsFloat;
        fltCoDvRp := FieldByName('ITE_CODVRP').AsFloat;

        strAiDvOr := FieldByName('ITE_AIDVOR').AsString;
      
      End;

      strSeqDet := FieldByName('ITE_SEQDET').AsString;

      strSemEst := FieldByName('ITE_SEMEST').AsString;

      fatVenda.strCodEmb := FieldByName('ITE_ITEEMB').AsString;

      strIteCha   := FieldByName('ITE_ITECHA').AsString;
      strIteTin   := FieldByName('ITE_ITETIN').AsString;
      strChaFor   := FieldByName('ITE_CHAFOR').AsString;
      strCodAca   := FieldByName('ITE_CODACA').AsString;
      strEmpAca   := FieldByName('ITE_EMPACA').AsString;
      strDesCor   := FieldByName('ITE_DESCOR').AsString;
      strCatalize := FieldByName('ITE_CATALI').AsString;
      strLinTin   := FieldByName('ITE_LINTIN').AsString;
      fltEmbala   := FieldByName('ITE_EMBALA').AsFloat;
      strPorPer   := FieldByName('ITE_PORPER').AsString;

      strBaseQtdZerada := FieldByName('ITE_BAQTZE').AsString;

      intLazQua := FieldByName('ITE_LAZQUA').AsInteger;
      strTipPre := FieldByName('ITE_TIPPRE').AsString;
      strTipEmb := FieldByName('ITE_TIPEMB').AsString;
      intQtdEmb := FieldByName('ITE_QTDEMB').AsInteger;
      fltPreEmb := FieldByName('ITE_PREEMB').AsFloat;
      fltPrvTin := FieldByName('ITE_PRVTIN').AsFLoat;
      fltPrcTin := FieldByName('ITE_PRCTIN').AsFloat;
      fltFatTin := FieldByName('ITE_FATTIN').AsFloat;

      strMontad := FieldByName('ITE_MONTAD').AsString;
      strA_n_o_ := FieldByName('ITE_A_N_O_').AsString;
      fltVolPro := FieldByName('ITE_VOLPRO').AsFloat;
      strDesOri := FieldByName('ITE_DESORI').AsString;

      fatVenda.strPromoc    := FieldByName('ITE_PROMOC').AsString;
      fatVenda.strCodPro    := FieldByName('ITE_CODPRO').AsString;
      fatVenda.blnProCnd    := FieldByName('ITE_PROCND').AsBoolean;
      fatVenda.fltProPreCus := FieldByName('ITE_PROCUS').AsFloat;
      fatVenda.fltProPreVen := FieldByName('ITE_PROVEN').AsFloat;
      fatVenda.fltProComVar := FieldByName('ITE_PROCVA').AsFloat;
      fatVenda.fltProComAta := FieldByName('ITE_PROCAT').AsFloat;
      fatVenda.fltProComDis := FieldByName('ITE_PROCDI').AsFloat;
      fatVenda.fltProDesF07 := FieldByName('ITE_DESF07').AsFloat;

      strDesNes    := FieldByName('ITE_DESNES').AsString;

      if (not fEmptyStr(FieldByName('ITE_COMPLE').AsString)) and (cbbComple.Items.IndexOf(FieldByName('ITE_COMPLE').AsString) < 0) then
      begin
        cbbComple.Items.Add(FieldByName('ITE_COMPLE').AsString);
      end;

      cbbComple.ItemIndex := -1;
      if (cbbComple.Items.IndexOf(FieldByName('ITE_COMPLE').AsString) > -1) then
      begin
        cbbComple.ItemIndex := cbbComple.Items.IndexOf(FieldByName('ITE_COMPLE').AsString);
      end;

      intSeqInd := FieldByName('ITE_SEQIND').AsInteger;

      fltFatAce := FieldByName('ITE_FATACE').AsFloat;

      fltDesOpeTinta := FieldByName('ITE_DOPTIN').AsFloat;

      fatVenda.fltPreCus := FieldByName('ITE_PRECUS').AsFloat;
      fatVenda.fltPreCu2 := FieldByName('ITE_PRECU2').AsFloat;

      If (fatVenda.strIdePro = 'NOR') And
         (fatVenda.strPromoc = 'S') And
         (fatVenda.fltProPreCus > 0) And
         (Not fEhItemVendaVidro(fCodItem)) and
         (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
      Begin
        fatVenda.fltPreCus := fatVenda.fltProPreCus;
      End;

      (*****************************************)
      (* NAO RETIRAR - SERVE PARA NAO DEIXAR   *)
