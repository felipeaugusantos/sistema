procedure TfrmFatVendas.pCarregaDadosDosItensParaConfirmacaoDeTransferenciaDeEstoque(Var qryGenIte : TUniQuery);
  Var
    strSQL : String;
begin
  strSQL := EmptyStr;
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  I.ITE_CODITE, ';
  strSQL := strSQL + '  I.ITE_DESITE, ';
  strSQL := strSQL + '  I.ITE_DESSIM, ';
