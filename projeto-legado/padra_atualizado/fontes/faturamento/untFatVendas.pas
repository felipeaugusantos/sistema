      If Not Result Then
      Begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Permite marcar o checkbox "Brinde"?');
        objLiberacao.objMsgLibera.pAddSeparador(65);
        objLiberacao.objMsgLibera.pAddTextoCaption('Produto'    , edtCodIte.Text + ' - ' + edtDesIte.Text, 10);
        objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade' , edtQtdIte.Text                         , 10);
        objLiberacao.objMsgLibera.pAddQuebra;

        objLiberacao.strDirAce := 'CHKBRI';
        objLiberacao.strMsgSen := 'Permite marcar o checkbox "Brinde"?';
        objLiberacao.strCodOpe := fatVenda.strCodVen;
        objLiberacao.strCodDig := fatVenda.strCodDig;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

        Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
      End;
    End;
  end;

begin
  inherited;
