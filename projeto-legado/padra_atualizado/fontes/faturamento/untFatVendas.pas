function TfrmFatVendas.fPedeDadosFechamentoVenda(): Boolean;
  Var
    blnPedeTipoFechamentoLogoInicio: Boolean;
    blnVerificarSePermiteEmitirCupom: Boolean;
    blnVerificarTipFatConformePerfil: Boolean;
    LfltIcmOrg,
    LfltTotSPro,
    LfltTotCPro,
    LfltTotBruSPro,
    LfltTotBruCPro,
    LfltTotGer,
    LfltTotPro,
    LfltTotDes    : Double;

    function fPedeTipoFechamento(blnVerificaTipoFaturamentoConformePerfil: Boolean=True): Boolean;
    begin
      Result := True;

      If Not fDefineOpcoesDocumentoConfirmacaoNotaConcreto() Then
        Exit(False);

      If Not fDefineOpcoesDocumentoVendaMultiloja() Then
        Exit(False);

      If Not fDefineOpcoesDocumentoTransferencia() Then
        Exit(False);

      If Not fPedeEspecieDocumentoParaFechamento(blnVerificaTipoFaturamentoConformePerfil) Then
        Exit(False);
    end;

begin
  Result := True;

  LfltIcmOrg     := fatVenda.fltIcmOrg;
  LfltTotSPro    := fatVenda.fltTotSPro;
  LfltTotCPro    := fatVenda.fltTotCPro;
  LfltTotBruSPro := fatVenda.fltTotBruSPro;
  LfltTotBruCPro := fatVenda.fltTotBruCPro;
  LfltTotGer     := fatVenda.fltTotGer;
  LfltTotPro     := fatVenda.fltTotPro;
  LfltTotDes     := fatVenda.fltTotDes;

  Try
    blnPedeTipoFechamentoLogoInicio := (strOpcDoc = 'VN');
    blnVerificarTipFatConformePerfil := False;

    If blnPedeTipoFechamentoLogoInicio Then
    Begin
      blnVerificarSePermiteEmitirCupom := False;

      If Not fPedeTipoFechamento(blnVerificarTipFatConformePerfil) Then
        Exit(False);

      If (Not fEhOrcamentoPedido(strOpcDoc)) And (fVerificaItensComEntregaFutura) Then
      Begin
        If Not fVerificaDireitoAcessoVendaFuturaOR_PD_VN(strOpcDoc, fRetornaEspecieDocumento) Then
          Exit(False);
      End;

      If Not fAtribuiEspecieDocumentoSelecionadaParaObjVenda(blnVerificarSePermiteEmitirCupom) Then
        Exit(False);

      If (Pos(fatVenda.strEspDoc, 'FF_IF_') > 0) And (Not fatVenda.fValidarTipoFaturamentoRetencoes) Then
        Exit(False);

      blnVerificarTipFatConformePerfil := True;
    End;

    If (strOpcDoc = 'VN') And
       (strEspOrc = 'PD') And
       (fatVenda.strEspDoc <> 'PD') And
       (fCfgSis('CDTCLV', varBoolean)) Then
    Begin
      If (fExistePedidoNormalComCilindroVasilhameNaoFaturado(strNumOrc, strEspOrc)) Then
        Exit(False);
    End;

    If (Pos(strOpcDoc, 'PD_VN_') > 0) Then
      If Not fatVenda.fVerificaSeItensSemEstoqueIraGerarVendasPerdidas() Then
        Exit(False);

    If Not fPedeCondicaoPagamentoFechamentoVenda() Then
      Exit(False);

    If Not fValidaCondicaoPagamentoFechamentoVenda(blnVerificarTipFatConformePerfil) Then
      Exit(False);

    If Not fValidaSeExistePodeConfirmarComDesconto() Then
      Exit(False);

    If Not fValidaCreditosProfissionalParaEmissaoBrinde Then
      Exit(False);

    If Not fPedeVoucherClubeDoPintor Then
      Exit(False);

    If Not fInformaOperadorSolicitanteTransferencia Then
      Exit(False);

    If Not fValidaConsultaCreditoDadosCobrancaCliente Then
      Exit(False);

    If Not fInformarProfissionalFechamentoVenda() Then
      Exit(False);

    If Not fValidaVencimentoItensDevolucao() Then
      Exit(False);

    If Not blnPedeTipoFechamentoLogoInicio Then
    Begin
      If Not fPedeTipoFechamento() Then
        Exit(False);

      If (Not fEhOrcamentoPedido(strOpcDoc)) And (fVerificaItensComEntregaFutura) Then
      Begin
        If Not fVerificaDireitoAcessoVendaFuturaOR_PD_VN(strOpcDoc, fRetornaEspecieDocumento) Then
          Exit(False);
      End;
    End;

    If Not fVerificaObrigatoriedadeCpfCnpjNoItem() Then
      Exit(False);

    If Not fVerificaObrigatoriedadeCpfCnpjParaEmissaoNotaFiscal() Then
      Exit(False);

    If Not fValidaFechamentoEmCupomFiscal() Then
      Exit(False);

    If Not fVerificaSeCepEstaCorretoParaFechamento() Then
      Exit(False);

    If Not fVerificaAlterandoPedidoReferenciadoOrcamentoTransferencia() Then
      Exit(False);

    If Not fCarregaDescontoEspecialConfirmacaoPedido() Then
      Exit(False);

    If Not fVerificaSeAtendeRegraFiscalEnderecoDeEntrega() Then
      Exit(False);

    If Not fDigitarServicosFechamentoVenda() Then
      Exit(False);

    If Not fAtribuiEspecieDocumentoSelecionadaParaObjVenda() Then
      Exit(False);

    If (Not fPermitirUsarFormaDePagamentoDinheiro(strOpcDoc, fatvenda.strEspDoc, edtForPag.Text)) Then
      Exit(False);

    If Not fDefinirSeOrcamentoGravandoComoPedido() Then
      Exit(False);

    If ((fatVenda.strEspDoc = 'PD') Or
        (fatVenda.strOpcDoc = 'PD')) And
       (pnlCndPag.Visible) Then
    Begin
      TFacadeCobrancaEletronica.fValidaCadastroClienteCobrancaEletronica(
               fatVenda.strCodCli, fatVenda.strCodCnd, tcPagarMe);
    End;

    if not fValidaEnvioLinkPagamantoCndInicio then
      Exit(False) ;

    If (fatVenda.fBloquearPercentualDescontoNoFechamentoDaVenda(fatVenda.fltPorDes))  Then
      Exit(False);

    If (fatVenda.fBloquearDescontoEspecialNoFechamentoDaVenda(fatVenda.fltDesEsp))  Then
      Exit(False);

    if not fValidaPedidoCompra then
      Exit(False);

    If Not fValidarEmissaoPedidoEOrcamento() Then
      Exit(False);

    If Not fatVenda.fTemPermissaoEspecieDocumento Then
      Exit(False);

    If fatVenda.fTemLoteVazio(cdsVenda) Then
      Exit(False);

    If Not fPedeDadosVendaDeConcreto() Then
      Exit(False);

    If Not fPedeDadosEmissaoEmprestimo() Then
      Exit(False);

    if (Pos(strOpcDoc, 'PD_VN_') <= 0) then
      If Not fatVenda.fVerificaSeItensSemEstoqueIraGerarVendasPerdidas() Then
        Exit(False);

    If Not fPedeFaseDaObra() Then
      Exit(False);

    If Not fAtualizaEditsTotaisVenda Then
      Exit(False);

    If Not fPedeDadosEmissaoPedidoVenda Then
      Exit(False);

    If Not fValidarAlteracaoPedidoEOrcamento Then
      Exit(False);

    If Not fatVenda.fValidarEstoqueQuandoOrcamentoGravandoEmPedido() Then
      Exit(False);

    If Not fPedeDadosEmissaoOrcamento() Then
      Exit(False);

    If Not fPedeDadosEmissaoOutrasEspecies() Then
      Exit(False);

    If Not fTratarValorFreteNaEmissaoDeCupomNFCe() Then
      Exit(False);

    If Not fValidaLimiteBrindesMes() Then
      Exit(False);

    If Not fVerificarTaxaEntrega() Then
      Exit(False);

    If Not fDestacarAsRetencoes() Then
      Exit(False);

    If Not fVerificaSituacaoRegularConf() Then
      Exit(False);

    If (fatVenda.fClienteComProblemaNaConsultaDeSituacaoCadastral(edtCodCli.Text, fatVenda.strEspDoc, strOpcDoc)) Then
      Exit(False);

    If Not fPedeDadosEmissaoNotaFiscal() Then
      Exit(False);

    If Not fPedeDadosTratamentoInconsistenciaEFD() Then
      Exit(False);

    If Not fValidaTravaDePrecoComComissaoDoProfissionalEFrete() Then
      Exit(False);

  Finally
    If (Not Result) Then
    Begin
      If Not fatVenda.fExecutandoNovoFechamentoOrcamentoPedido() Then
        pAbortarEmissaoVenda();

      If (fatVenda.strTipOpe = 'R') And
         (Not blnConfirma) Then
      Begin
        fatVenda.strTipOpe := 'V';

        fatVenda.fltIcmOrg     := LfltIcmOrg;
        fatVenda.fltTotSPro    := LfltTotSPro;
        fatVenda.fltTotCPro    := LfltTotCPro;
        fatVenda.fltTotBruSPro := LfltTotBruSPro;
        fatVenda.fltTotBruCPro := LfltTotBruCPro;
        fatVenda.fltTotGer     := LfltTotGer;
        fatVenda.fltTotPro     := LfltTotPro;
        fatVenda.fltTotDes     := LfltTotDes;
      End;
    End;
  End;

end;

function TfrmFatVendas.fValidaDadosPedidoPagarMe: boolean;
var
  objParametrosMensagem: TParametrosMensagem;
begin
  Result := True;
  if (fCfgSis('PMEHAB',varBoolean)) then
  begin
    if (Assigned(qryFatGor)) And (Assigned(qryFatGor.FindField('FGO_NUMDOC'))) then
    begin
      Result := not TFacadeCobrancaEletronica.fExisteCobrancaEletronica(
                                                qryFatGor.fieldbyname('FGO_NUMDOC').AsString,
                                                qryFatGor.fieldbyname('FGO_ESPDOC').AsString,
                                                VS_strCodEmp,
                                                tcPagarMe,
                                                IIF((fatVenda.strOpcDoc='PD') or (fatVenda.strEspDoc='PD'), True, False));

      if not Result then
      begin
        objParametrosMensagem := TParametrosMensagem.Create;
        try
          objParametrosMensagem.Titulo      := 'Pagar.me';
          objParametrosMensagem.Texto       := 'Pedido possui Cobrança Pagar.me e não pode ser alterado/cancelado!';
          objParametrosMensagem.Opcoes      := ['&OK'];
          fMensagem(objParametrosMensagem);
        finally
          objParametrosMensagem.Free;
        end;
      end;
    end;
  end;
end;

function TfrmFatVendas.fValidaDadosPedidoYapay: boolean;
var
  objParametrosMensagem: TParametrosMensagem;
begin
  Result := True;
  if (fCfgSis('YAPHAB',varBoolean)) then
  begin
    If (Assigned(qryFatGor)) And (Assigned(qryFatGor.FindField('AUTOINCREM'))) Then
    Begin
