function TfrmfatVendas.fCarregaPedidoOrcamento(pgbStatus: TcxProgressBar = Nil): Boolean;
Var
  blnDeletouItens : Boolean;
  strSerInativos  : String;
  blnChkEntCD: Boolean;
begin
  Try
    blnCarregouPedido := False;
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
      fatVenda.OnAdicionouItemDoPedido := pOnAdicionouItemDoPedido;

    fatVenda.pCarregaPedidoOrcamento(qryFatGor, blnDeletouItens, pgbStatus);

    If fatVenda.fPermiteIPISemDadosConsumidor Then
    Begin
      fatVenda.fltDesAce := 0;
      fatVenda.fltDeADig := 0;
    End;

    TCdsVinculosRequisicoes.pCarregarClientDataSet(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                   qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                                   qryFatGor.FieldByName('FGO_CODCLI').AsString);

    blnChkEntCD := IIF((qryFatGor.FieldByName('FGO_ENT_CD').AsString = 'S') And (qryFatGor.FieldByName('FGO_ABADEP').AsString = 'N'), True, False);
    fatVenda.blnCarregouPedOrcEntCD := (blnChkEntCD And fCfgSis('EMPFAT', VarBoolean) And fCfgSis('LIB_CD', VarBoolean));

    If (fCfgSis('EMPFAT', VarBoolean)) Then
      chkEntCD.Checked := False
    Else
      chkEntCD.Checked := blnChkEntCD;

    edtCodCliExit(Nil);

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
      pRecalculaImpostos;

    fatVenda.blnFromOrdemProducao := False;
    If strOpcDoc = 'PD' Then
      fatVenda.blnFromOrdemProducao := fPedidoComOrdemDeProducao(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                                 qryFatGor.FieldByName('FGO_CODEMP').AsString);

    If fCfgSis('USASER', varBoolean) And (Pos(strOpcDoc, 'PD_OR_') > 0) Then
    Begin
      strSerInativos := '';
      If fatVenda.fGetSerInativos(strSerInativos) Then
      Begin
        fatVenda.blnFecharForm := True;
        fMensagem('Atenção', 'Pedido utilizando serviços inativos: ' + strSerInativos + #13#10 + 'Não é possível alterá-lo!', ['&OK']);
      End;
    End;

    if fatVenda.strMen001 = 'GARANTIA(TE)' Then
    Begin
      fatVenda.blnFecharForm := True;
      fMensagem('', 'Pedido referente a Garantia(TE) não é possível alterá-lo!', ['&OK']);
    End;

    If (Pos(strOpcDoc, 'VN_OR_PD_') > 0) And (fCfgSis('TRVAFO') = '1') And (Not fValidaItensVencidos) Then
    Begin
      fatVenda.blnFecharForm := True;
    End;

    // A variável blnMudouTabelaPreco é alterada para True para na hora de carregar o pedido o sistema manter a tabela de preço
    // escolhida no momento em que esse pedido foi criado ao invés de mudar para a tabela de preço da condição de pagamento.
    if blnAtualizaTabPreCnd then
    begin
      blnMudouTabelaPreco := True;
    end;

    strCliAntDes := edtCodCli.Text;
    fatVenda.OnAdicionouItemDoPedido := Nil;

    Result := Not fatVenda.blnFecharForm;

    blnCarregouPedido := True;
  Except
    On E: ExceptionAutCom Do
    Begin
      Result := False;
      fatVenda.blnFecharForm := True;
      pMensagemOk(E.Message);
    End;
    On E: Exception Do
    Begin
      Result := False;
      fatVenda.blnFecharForm := True;
      pMensagensErro(E.Message, '');
    End;
  End;
end;

