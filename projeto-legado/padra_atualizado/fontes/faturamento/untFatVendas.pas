function TfrmFatVendas.fTemItensEntregaImediata_ComDataEntregaInferior(out strItens: String): Boolean;
Var
  cdsDados : TUniClientDataSet;
  sltItens : TStringList;
begin

  cdsDados := TUniClientDataSet.Create(Nil);
  sltItens := TStringList.Create;
  sltItens.Clear;

  Try

    pCloneDataSet(cdsDados, cdsVenda);

    {Filtra itens de "Entrega/Imediata"}
    cdsDados.Filtered := False;
    cdsDados.Filter   := 'ITE_ENTRET = ''E'' AND ITE_ENTFUT <> ''S''';
    cdsDados.Filtered := True;

    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin

      If (cdsDados.FieldByName('ITE_DTENTR').AsDateTime < VS_Date) Then
        sltItens.Add(cdsDados.FieldByName('ITE_CODITE').AsString);

      cdsDados.Next;

    End;

    strItens := sltItens.CommaText;
    Result   := (sltItens.Count > 0);

  Finally
    FreeAndNil(cdsDados);
    FreeAndNil(sltItens);
  End;

end;

function TfrmFatVendas.fTemPrioridadeDeEstoquePorProdutoCadastrado: Boolean;
  const
    SELECT_PRIORIDADE = 'SELECT * FROM CADHIE WHERE HIE_CODITE = :CODITE AND HIE_EMPITE = :EMPITE';
    EXCETO_PRIORIDADE = 'AND HIE_EMPSAI NOT IN (#EXCETO)';
  var
    qryPrioridade       : TUniQuery;
    strCodItePrioridade : String;
    strCodEmpPrioridade : String;
begin

  Result := False;

  strCodItePrioridade := edtCodIte.Text;
  strCodEmpPrioridade := IIF(pnlEmpresa.Visible, edtCodEmp.Text, VS_strCodEmp);

  If strCodItePrioridade.IsEmpty Then
    Exit;

  If strCodEmpPrioridade.IsEmpty Then
    Exit;

  qryPrioridade := fCriaQuery;

  Try

    qryPrioridade.Close;
    qryPrioridade.SQL.Clear;
    qryPrioridade.SQL.Add(SELECT_PRIORIDADE);

    If Not fEmptyStr(strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque) Then
      qryPrioridade.SQL.Add(EXCETO_PRIORIDADE.Replace('#EXCETO', strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque));

    qryPrioridade.ParamByName('CODITE').AsString := strCodItePrioridade;
    qryPrioridade.ParamByName('EMPITE').AsString := strCodEmpPrioridade;
    qryPrioridade.Open;

    Result := Not qryPrioridade.IsEmpty;

  Finally
    FreeAndNil(qryPrioridade);
  End;

end;

