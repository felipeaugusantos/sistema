procedure TfrmFatVendas.pCarregaDocumentoNotaFator(blnNotaDeRemessa: Boolean; blnExibeFiltroSerie: Boolean = False);
Var
  RecFatorNotaEspecial : TRecFatorNotaEspecial;
  frmFatDigFatorNotEsp : TfrmFatDigFatorNotEsp;
begin

  FillChar(RecFatorNotaEspecial, SizeOf(RecFatorNotaEspecial), #0);

  If (Not fEmptyStr(strCliAnt)) Then
    Exit;

  pCriarFormularios(TfrmFatDigFatorNotEsp, frmFatDigFatorNotEsp);

  Try

    Try

      frmFatDigFatorNotEsp.blnNotaDeRemessa := blnNotaDeRemessa;
      frmFatDigFatorNotEsp.blnExibeFiltroSerie := blnExibeFiltroSerie;

      If (frmFatDigFatorNotEsp.ShowModal = mrOk) Then
      Begin

        RecFatorNotaEspecial.blnNotaDeRemessa       := blnNotaDeRemessa;
        RecFatorNotaEspecial.blnEhPorDocumento      := frmFatDigFatorNotEsp.fEhPorDocumento;

        If (RecFatorNotaEspecial.blnEhPorDocumento) Then
        Begin
          RecFatorNotaEspecial.strNumDoc              := frmFatDigFatorNotEsp.edtNumDoc.Text;
          RecFatorNotaEspecial.strEspDoc              := frmFatDigFatorNotEsp.edtEspDoc.Text;
          RecFatorNotaEspecial.strCliNov              := frmFatDigFatorNotEsp.edtCodCli.Text;
          RecFatorNotaEspecial.strCodEmp              := frmFatDigFatorNotEsp.edtCodEmp.Text;
          RecFatorNotaEspecial.fltFatNot              := fStrToFloat(frmFatDigFatorNotEsp.edtFatCal.Text);
          RecFatorNotaEspecial.strTipFatNEs           := frmFatDigFatorNotEsp.edtTipoFator.Text;
          RecFatorNotaEspecial.strSerieNf             := frmFatDigFatorNotEsp.edtSerDoc.Text;
          pCarregaDocumentoNotaFatorPorDocumento(RecFatorNotaEspecial);
        End
        Else
        Begin
          RecFatorNotaEspecial.strEspDoc              := frmFatDigFatorNotEsp.edtEspDoc_.Text;
          RecFatorNotaEspecial.strCodEmp              := frmFatDigFatorNotEsp.edtCodEmp_.Text;
          RecFatorNotaEspecial.strCliNov              := frmFatDigFatorNotEsp.edtCodCli_.Text;
          RecFatorNotaEspecial.fltFatNot              := fStrToFloat(frmFatDigFatorNotEsp.edtFatCal_.Text);
          RecFatorNotaEspecial.strTipFatNEs           := frmFatDigFatorNotEsp.edtTipoFator_.Text;
          RecFatorNotaEspecial.strSerieNf             := frmFatDigFatorNotEsp.edtSerDoc_.Text;
          RecFatorNotaEspecial.DocumentosSelecionados := frmFatDigFatorNotEsp.fRetornaDocumentosSelecionados;
          pCarregaDocumentoNotaFatorPorPeriodo(RecFatorNotaEspecial);
        End;

      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[pCarregaDocumentoNotaFator]');
      End;
    End;

  Finally
    pFreeAndNil(frmFatDigFatorNotEsp);
  End;

end;

procedure TfrmFatVendas.pCarregaDocumentoNotaFatorPorDocumento(RecFatorNotaEspecial: TRecFatorNotaEspecial);
Var
  blnConfirma : Boolean;
  strCliDoc   : String;
  strNomCli   : String;
  strSQL      : String;
  qryGenGer   : TUniQuery;
  strTabela   : String;
  strTabTri   : String;
  strMovMad   : String;
  cdsGenGer   : TUniClientDataSet;
  dspGenGer   : TUniDataSetProvider;
  frmRemessaMercadoriaFaltante : TfrmRemessaMercadoriaFaltante;
  strMercadoriasFaltantes      : string;
  intContMercadorias           : integer;
  blnAvisarOperadorVendaComPrecoCusto : Boolean;
begin

  If (Not fEmptyStr(strCliAnt)) Then
    Exit;

  qryGenGer := fCriaQuery(Self);
  cdsGenGer := TUniClientDataSet.Create(Self);
  dspGenGer := TUniDataSetProvider.Create(Self);
  dspGenGer.DataSet := qryGenGer;

  Try

    strCliDoc               := '';
    strNomCli               := '';
    strMercadoriasFaltantes := '';
    blnConfirma             := True;

    fatVenda.fltFatNot    := RecFatorNotaEspecial.fltFatNot;
    fatVenda.strTipFatNEs := RecFatorNotaEspecial.strTipFatNEs;

    strNomCli := fRetNomCliente(RecFatorNotaEspecial.strCliNov);

    If (blnConfirma) And (strOpcDoc = 'MF') Then
    Begin
      Try
        Try
          pCriarFormularios(TfrmRemessaMercadoriaFaltante, frmRemessaMercadoriaFaltante);
          frmRemessaMercadoriaFaltante.edtDocumento.Text := RecFatorNotaEspecial.strNumDoc;
          frmRemessaMercadoriaFaltante.edtEspecie.Text   := RecFatorNotaEspecial.strEspDoc;
          frmRemessaMercadoriaFaltante.edtCodEmp.Text    := RecFatorNotaEspecial.strCodEmp;
          frmRemessaMercadoriaFaltante.edtNomEmp.Text    := fRetNomeEmpresaSelec(RecFatorNotaEspecial.strCodEmp);
          frmRemessaMercadoriaFaltante.edtCodCli.Text    := RecFatorNotaEspecial.strCliNov;
          frmRemessaMercadoriaFaltante.edtNomCli.Text    := fRetNomCliente(RecFatorNotaEspecial.strCliNov);
          blnConfirma := (frmRemessaMercadoriaFaltante.ShowModal = mrOk);

          if blnConfirma then
          begin
            if (frmRemessaMercadoriaFaltante.stlMercadoriasFaltantes.Count) > 0 then
            begin
              for intContMercadorias := 0 to frmRemessaMercadoriaFaltante.stlMercadoriasFaltantes.Count - 1 do
              begin
                pIncrementaListaStr(frmRemessaMercadoriaFaltante.stlMercadoriasFaltantes[intContMercadorias], strMercadoriasFaltantes, True, True, ',', False);
              end;
            end;
          end;
        Finally
          pFreeAndNil(frmRemessaMercadoriaFaltante);
        End;
      Except
        On E: Exception Do
        Begin
          blnConfirma := False;
          pMensagensErro(E.Message, '[pCarregaDocumentoNotaFatorPorDocumento]');
        End;
      End;
    End;

    If (RecFatorNotaEspecial.blnNotaDeRemessa) Then
      fatVenda.fltFatNot := 1.0;

    if not(RecFatorNotaEspecial.blnNotaDeRemessa) and fCfgSis('CONFFF', varBoolean) then
    begin
      if fJaExisteConfirmacaoParaMeiaNota(RecFatorNotaEspecial.strNumDoc, RecFatorNotaEspecial.strEspDoc, RecFatorNotaEspecial.strCodEmp) then
      Begin
        fMensagem('ATENÇÃO!', 'Já existe um outro documento oriundo da confirmação deste. O procedimento será cancelado!', ['&O k']);
        blnConfirma := False;
      End;
    end;

    If (Not blnConfirma) Then
      Exit;

    fatVenda.blnMeiaNota             := True;
    fatVenda.blnMeiaNotaPorDocumento := True;

    {*******************************************}
    {* CARREGA DADOS DO CABECALHO              *}
    {****************************************MV*}
    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   GER_NUMDOC, ';
    strSQL := strSQL + '   GER_ESPDOC, ';
    strSQL := strSQL + '   GER_CODEMP, ';
    strSQL := strSQL + '   GER_CODCLI, ';
    strSQL := strSQL + '   GER_CONPAG, ';
    strSQL := strSQL + '   CLI_CONSUM, ';
    strSQL := strSQL + '   IF( GER_NOMCON IS NULL, CLI_NOMCLI, GER_NOMCON) AS GER_NOMCLI, ';
    strSQL := strSQL + '   IF( GER_ENDCON IS NULL, CLI_ENDERE, GER_ENDCON) AS GER_ENDCLI, ';
    strSQL := strSQL + '   IF( GER_ENDCON IS NULL, CLI_ENDNUM, "") AS GER_ENDNUM, ';
    strSQL := strSQL + '   IF( GER_BAICON IS NULL, CLI_BAIRRO, GER_BAICON) AS GER_BAICLI, ';
    strSQL := strSQL + '   IF( GER_CEPCON IS NULL, CLI_C_E_P_, GER_CEPCON) AS GER_CEPCLI, ';
    strSQL := strSQL + '   IF( GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) AS GER_CIDCLI, ';
    strSQL := strSQL + '   CID_NOMCID AS GER_NOMCID, ';
    strSQL := strSQL + '   IF( GER_ESTCON IS NULL, CID_ESTADO, GER_ESTCON) AS GER_ESTCLI, ';
    strSQL := strSQL + '   IF( GER_TELCON IS NULL, CLI_FONE01, GER_TELCON) AS GER_TELCLI, ';
    strSQL := strSQL + '   IF( AUX_NASCON IS NULL, CLI_NASCIM, AUX_NASCON) AS AUX_NASCON, ';
    strSQL := strSQL + '   IF( GER_CGCCPF IS NULL, CLI_CGCCPF, GER_CGCCPF) AS GER_CGCCPF, ';
    strSQL := strSQL + '   IF( GER_CGCCON IS NULL, CLI_C_G_C_, GER_CGCCON) AS GER_CGCCLI, ';
    strSQL := strSQL + '   IF( GER_IESCON IS NULL, CLI_I_E_S_, GER_IESCON) AS GER_IESCLI, ';
    strSQL := strSQL + '   IF( GER_R_GCON IS NULL, CLI_NUMR_G, GER_R_GCON) AS GER_R_GCLI, ';
    strSQL := strSQL + '   CLI_CODATI AS GER_CODATI, ';
    strSQL := strSQL + '   GER_CODFPG, ';
    strSQL := strSQL + '   GER_CODCND, ';
    strSQL := strSQL + '   GER_CODVEN, ';
    strSQL := strSQL + '   GER_CODDIG, ';
    strSQL := strSQL + '   GER_MEN001, ';
    strSQL := strSQL + '   GER_MEN002, ';
    strSQL := strSQL + '   GER_MEN003, ';
    strSQL := strSQL + '   GER_MEN004, ';
    strSQL := strSQL + '   GER_MEN005, ';
    strSQL := strSQL + '   GER_TIPFRE, ';
    strSQL := strSQL + '   GER_TOTFRE, ';
    strSQL := strSQL + '   GER_DTAENT, ';
    strSQL := strSQL + '   GER_CODTRA, ';
    strSQL := strSQL + '   GER_DESESP ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '   MOVGER, ';
    strSQL := strSQL + '   AUXMOV, ';
    strSQL := strSQL + '   CADCLI, ';
    strSQL := strSQL + '   CADCID  ';
    strSQL := strSQL + ' WHERE GER_CODCLI = CLI_CODCLI ';
    strSQL := strSQL + '     AND IF(GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) = CID_CODCID ';
    strSQL := strSQL + '     AND AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM ';
    strSQL := strSQL + '     AND GER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '     AND GER_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '     AND GER_CODEMP = :CODEMP ';

    If (Not fEmptyStr(RecFatorNotaEspecial.strSerieNf)) Then
      strSQL := strSQL + '  AND GER_SERIE_ = :SERIE ';

    IF (RecFatorNotaEspecial.blnNotaDeRemessa) Then
      strSQL := strSQL + '  AND GER_TIP_FC = "C" AND GER_ORIDOC = "V" ';

    strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(strSQL,'MOVGER','NOTGER'), 'AUXMOV', 'AUXNOT') + ' LIMIT 1 ';


    qryGenGer.Close;
    qryGenGer.SQL.Clear;
    qryGenGer.SQL.Add(strSQL);
    qryGenGer.ParamByName('NUMDOC').AsString := RecFatorNotaEspecial.strNumDoc;
    qryGenGer.ParamByName('ESPDOC').AsString := RecFatorNotaEspecial.strEspDoc;
    qryGenGer.ParamByName('CODEMP').AsString := RecFatorNotaEspecial.strCodEmp;

    If (Not fEmptyStr(RecFatorNotaEspecial.strSerieNf)) Then
      qryGenGer.ParamByName('SERIE').AsString := RecFatorNotaEspecial.strSerieNf;

    qryGenGer.Open;


    strCliDoc := qryGenGer.FieldByName('GER_CODCLI').AsString;

    edtCodCli.Text     := RecFatorNotaEspecial.strCliNov;
    fatVenda.strCodCli := '';

    fatVenda.strCodCid := qryGenGer.FieldByName('GER_CIDCLI').AsString;
    fatVenda.strCliEst := qryGenGer.FieldByName('GER_ESTCLI').AsString;

    If (fCfgSis('CNDESP', varInteger) = 1) Then
    Begin
      edtCodCnd.Text     := fCfgSis('CNDAVI', varString);
      mskCndPag.Text     := '01000';
      fatVenda.strCodCnd := edtCodCnd.Text;
      fatVenda.strConPag := mskCndPag.Text;
    End
    Else
    Begin
      edtCodCnd.Text     := qryGenGer.FieldByName('GER_CODCND').AsString;
      mskCndPag.Text     := qryGenGer.FieldByName('GER_CONPAG').AsString;
      fatVenda.strCodCnd := qryGenGer.FieldByName('GER_CODCND').AsString;
      fatVenda.strConPag := qryGenGer.FieldByName('GER_CONPAG').AsString;
    End;

    fatVenda.strCodFpg := qryGenGer.FieldByName('GER_CODFPG').AsString;
    edtForPag.Text     := qryGenGer.FieldByName('GER_CODFPG').AsString;

    strFpgAnt := fatVenda.strCodFpg;
    strConAtu := fatVenda.strConPag;

    fatVenda.strMen001 := qryGenGer.FieldByName('GER_MEN001').AsString;
    fatVenda.strMen002 := qryGenGer.FieldByName('GER_MEN002').AsString;
    fatVenda.strTipFre := qryGenGer.FieldByName('GER_TIPFRE').AsString;
    fatVenda.fltValFre := qryGenGer.FieldByName('GER_TOTFRE').AsFloat;

    fatVenda.strCodTra := qryGenGer.FieldByName('GER_CODTRA').AsString;

    pCarregaCliente;
    pCarregaForPag;
    pCarregaCondicao(strOpcDoc = 'CO');

    fatVenda.strNumDocContaOrdem := RecFatorNotaEspecial.strNumDoc;
    fatVenda.strDtaDocContaOrdem := qryGenGer.FieldByName('GER_DTAENT').AsString;

    fatVenda.strNumFatFFEsp := RecFatorNotaEspecial.strNumDoc;
    fatVenda.strTipFatFFEsp := RecFatorNotaEspecial.strEspDoc;
    fatVenda.strEmpFatFFEsp := RecFatorNotaEspecial.strCodEmp;
    fatVenda.strCliFatFFEsp := RecFatorNotaEspecial.strCliNov;

    If (strCliDoc = RecFatorNotaEspecial.strCliNov) Then
    Begin
      fatVenda.strCliNomContaOrdem := qryGenGer.FieldByName('GER_NOMCLI').AsString;
      fatVenda.strCliCgcContaOrdem := qryGenGer.FieldByName('GER_CGCCLI').AsString;
      fatVenda.strCliIesContaOrdem := qryGenGer.FieldByName('GER_IESCLI').AsString;
      fatVenda.strCliCon           := qryGenGer.FieldByName('CLI_CONSUM').AsString;
    End
    Else
    Begin
      fatVenda.strCliNomContaOrdem := strNomCli;
      fatVenda.strCliCgcContaOrdem := fatVenda.strCliCgc;
      fatVenda.strCliIesContaOrdem := fatVenda.strCliIes;
      fatVenda.strCliCon           := fatVenda.strCliCon;
    End;

    If (fCfgSis('USADIG', varBoolean)) Then
      edtSenVen.Text := qryGenGer.FieldByName('GER_CODVEN').AsString
    Else
      edtSenVen.Text := fRetSenhaVendedor(qryGenGer.FieldByName('GER_CODVEN').AsString);

    pCarregaVendedor;

    If (Not fValidaCampos(edtCodCli, True)) Then
      Exit;

    If (Not fValidaCampos(cbTabPreco, True)) Then
      Exit;

    If (strCliDoc = RecFatorNotaEspecial.strCliNov) Then
    Begin
      fatVenda.strCliNom := qryGenGer.FieldByName('GER_NOMCLI').AsString;
      fatVenda.strCliOri := qryGenGer.FieldByName('GER_NOMCLI').AsString;
      fatVenda.strCliEnd := qryGenGer.FieldByName('GER_ENDCLI').AsString;
      fatVenda.strCliNum := qryGenGer.FieldByName('GER_ENDNUM').AsString;
      fatVenda.strCliBai := qryGenGer.FieldByName('GER_BAICLI').AsString;
      fatVenda.strCliCep := qryGenGer.FieldByName('GER_CEPCLI').AsString;
      fatVenda.strCodCid := qryGenGer.FieldByName('GER_CIDCLI').AsString;
      fatVenda.strCliCid := qryGenGer.FieldByName('GER_NOMCID').AsString;
      fatVenda.strCliEst := qryGenGer.FieldByName('GER_ESTCLI').AsString;
      fatVenda.strCliTel := qryGenGer.FieldByName('GER_TELCLI').AsString;
      fatVenda.dtaNasCon := qryGenGer.FieldByName('AUX_NASCON').AsDateTime;
      fatVenda.strCliCgc := qryGenGer.FieldByName('GER_CGCCLI').AsString;
      fatVenda.intCgcCpf := qryGenGer.FieldByName('GER_CGCCPF').AsInteger;
      fatVenda.strCliIes := qryGenGer.FieldByName('GER_IESCLI').AsString;
      fatVenda.strCli_Rg := qryGenGer.FieldByName('GER_R_GCLI').AsString;
      fatVenda.strCliAti := qryGenGer.FieldByName('GER_CODATI').AsString;
    End;

    {********************************}
    {* MONTA A MENSAGEM DA CO OU MF *}
    {*****************************JB*}
    fatVenda.strMensagContaOrdem := IIF(fatVenda.strOpcDoc = 'CO','MERCADORIA POR CONTA E ORDEM', 'MERCADORIA FALTANTE') +
                                       ' DE '          + fatVenda.strCliNom +
                                       ' CNJP: '       + fatVenda.strCliCgc +
                                       ' IE: '         + fatVenda.strCliIes +
                                       ' CONFORME NF ' + fatVenda.strNumDocContaOrdem +
                                       ' DE '          + fatVenda.strDtaDocContaOrdem +
                                       ' DE R$ '       + '0,00' +
                                       ' ONDE '        + 'OS IMPOSTOS FORAM RECOLHIDOS/DESTACADOS NOS TERMOS DO ART. 129 DO RICMS.';

    fatVenda.arrMenOri[1] := qryGenGer.FieldByName('GER_MEN001').AsString;
    fatVenda.arrMenOri[2] := qryGenGer.FieldByName('GER_MEN002').AsString;
    fatVenda.arrMenOri[3] := qryGenGer.FieldByName('GER_MEN003').AsString;
    fatVenda.arrMenOri[4] := qryGenGer.FieldByName('GER_MEN004').AsString;
    fatVenda.arrMenOri[5] := qryGenGer.FieldByName('GER_MEN005').AsString;

    strTabela := 'MOVDET';
    strMovMad := 'MOVMAD';
    strTabTri := 'MOVTRI';

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  DET_CODITE, ';
    strSQL := strSQL + '  DET_CODEMP, ';
    strSQL := strSQL + '  DET_ESTADO, ';
    strSQL := strSQL + '  DET_UNITAR, ';
    strSQL := strSQL + '  DET_UNIORI, ';
    strSQL := strSQL + '  DET_DESESP, ';
    strSQL := strSQL + '  DET_QTDITE, ';

    strSQL := strSQL + '  DET_TOTULT, ';
    strSQL := strSQL + '  DET_IMPULT, ';
    strSQL := strSQL + '  DET_TOTMED, ';

    If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
    Begin
      strSQL := strSQL + '  DET_COMPEC, ';
      strSQL := strSQL + '  DET_LARPEC, ';
      strSQL := strSQL + '  DET_ESPPEC, ';

      strSQL := strSQL + '  DET_APAREL, ';
      strSQL := strSQL + '  DET_PERAPA, ';
      strSQL := strSQL + '  DET_BENEFI, ';
      strSQL := strSQL + '  DET_PERBEN, ';
    End;

    strSQL := strSQL + '  DET_TOTCUS, ';
    strSQL := strSQL + '  DET_TOTCU2, ';
    strSQL := strSQL + '  DET_TABPRE, ';
    strSQL := strSQL + '  DET_INCPIS, ';
    strSQL := strSQL + '  DET_IDEPRO, ';
    strSQL := strSQL + '  DET_DESCRI, ';
    strSQL := strSQL + '  DET_UNIDAD, ';
    strSQL := strSQL + '  DET_CODMAR, ';
    strSQL := strSQL + '  DET_FORITE, ';
    strSQL := strSQL + '  DET_REFERE, ';
    strSQL := strSQL + '  DET_DESCON, ';
    strSQL := strSQL + '  DET_TOTPES, ';
    strSQL := strSQL + '  DET_NUMLOT, ';
    strSQL := strSQL + '  DET_CODDIV, ';
    strSQL := strSQL + '  DET_CODVE2, ';
    strSQL := strSQL + '  DET_ENTFUT, ';
    strSQL := strSQL + '  DET_MOTFUT, ';
    strSQL := strSQL + '  DET_DTAFUT, ';
    strSQL := strSQL + '  ITE_CODGRU, ';
    strSQL := strSQL + '  UNI_ITEFRA, ';
    strSQL := strSQL + '  DET_CODACA, ';
    strSQL := strSQL + '  DET_EMPACA, ';
    strSQL := strSQL + IIF(strTabela = 'MOVDET', 'FIS_ACESSO, ', '');
    strSQL := strSQL + IfThen(RecFatorNotaEspecial.blnNotaDeRemessa,'  "N" AS DET_PROMOC, ', '  DET_PROMOC, ');
    strSQL := strSQL + '  DET_PROACA  ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '  ' + strTabela + ' D ';
    strSQL := strSQL + ' JOIN CADITE ON ITE_CODITE = DET_CODITE ';
    strSQL := strSQL + ' LEFT JOIN CADUNI ON UNI_CODUNI = DET_UNIDAD ';

    strSQL := strSQL + 'LEFT JOIN ' + strTabTri + ' T ON T.DET_SEQGER = D.AUTOINCREM ';

    If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
      strSQL := strSQL + ' LEFT JOIN ' + strMovMad + ' M ON M.DET_SEQGER = D.AUTOINCREM  ';

    If strTabela = 'MOVDET' Then
    Begin
      strSQL := strSQL + '  LEFT JOIN CADFIS ON CADFIS.FIS_NUMDOC = D.DET_NUMDOC AND ';
      strSQL := strSQL + '                      CADFIS.FIS_ESPDOC = D.DET_ESPDOC AND ';
      strSQL := strSQL + '                      CADFIS.FIS_SERIE_ = D.DET_SERIE_ AND ';
      strSQL := strSQL + '                      CADFIS.FIS_CODEMP = D.DET_CODEMP AND ';
      strSQL := strSQL + '                      CADFIS.FIS_FORCLI = D.DET_CODCLI AND ';
      strSQL := strSQL + '                      CADFIS.FIS_TIP_FC = D.DET_TIP_FC ';
    End;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  DET_ORIDOC = "V"         ';

    If (Not fEmptyStr(RecFatorNotaEspecial.strSerieNf)) Then
      strSQL := strSQL + '  AND DET_SERIE_ = :SERIE ';

    If (Pos(strOpcDoc, 'CO_VN_') > 0) Then
      strSQL := strSQL + ' AND DET_PROEMB <> "S"  ';

    If (Not fEmptyStr(strMercadoriasFaltantes)) Then
    Begin
      strSQL := strSQL + ' AND D.AUTOINCREM IN('+strMercadoriasFaltantes+')  ';
    End;

    strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(strSQL,'MOVDET','NOTDET'),'MOVMAD','NOTMAD'),'MOVTRI','NOTTRI');

    {*******************************************}
    {* CARREGA ITENS DO DOCUMENTO              *}
    {****************************************MV*}

    qryGenGer.Close;
    qryGenGer.SQL.Clear;
    qryGenGer.SQL.Add(strSQL);
    qryGenGer.ParamByName('NUMDOC').AsString := RecFatorNotaEspecial.strNumDoc;
    qryGenGer.ParamByName('ESPDOC').AsString := RecFatorNotaEspecial.strEspDoc;
    qryGenGer.ParamByName('CODEMP').AsString := RecFatorNotaEspecial.strCodEmp;
    qryGenGer.ParamByName('CODCLI').AsString := strCliDoc;

    If (Not fEmptyStr(RecFatorNotaEspecial.strSerieNf)) Then
      qryGenGer.ParamByName('SERIE').AsString := RecFatorNotaEspecial.strSerieNf;

    pSetaClient(qryGenGer);

    cdsGenGer.Close;
    cdsGenGer.SetProvider(dspGenGer);
    cdsGenGer.Open;

    qryGenGer.Open;


    TEmissaoNotaEspecial.pCarregaItensNotaEspecial(fatVenda, qryGenGer, blnAvisarOperadorVendaComPrecoCusto);

    IF fatVenda.fGravaChaveReferenciada Then
    Begin
      fatVenda.pCarregaChaveReferenciada(cdsGenGer);
    End;

    If strOpcDoc <> 'CO' Then
    Begin
      edtCodCli.ReadOnly := True;
      blnPermiteAlterarCliente := False;
    End;

    edtForPag.ReadOnly := True;
    edtCodCnd.ReadOnly := True;
    mskCndPag.Enabled  := False;

    If (fCfgSis('USADIG', varBoolean)) Then
    Begin
      edtSenVen.ReadOnly := True;

      If (Not blnCarregouSenhaVendedorAutomaticamente) Then
        pSetFocus(edtSenDig);
    End
    Else If fPermiteFocoCampoVendedor Then
    Begin
      pSetFocus(edtSenVen);
    End;

    If strOpcDoc = 'CO' Then
      pSetFocus(edtCodCli);

    pEnabledFechamento(True);

    If Pos(strOpcDoc, 'VN_CS_PD_OR_') > 0 Then
      blnComVen := True;

    pCalculaTotais;

  Finally
    FreeAndNil(qryGenGer);
    FreeAndNil(dspGenGer);
    FreeAndNil(cdsGenGer);
  End;

end;

procedure TfrmFatVendas.pCarregaDocumentoNotaFatorPorPeriodo(RecFatorNotaEspecial: TRecFatorNotaEspecial);
Var
  strCliDoc   : String;
  strNomCli   : String;
  strSQL      : String;
  qryGenGer   : TUniQuery;
  strTabela   : String;
  strTabTri   : String;
  strMovMad   : String;
  intContador : Integer;
  arrMeiaNota : TArrMeiaNota;
  cdsGenGer   : TUniClientDataSet;
  dspGenGer   : TUniDataSetProvider;
  strMercadoriasFaltantes : String;
  Documento               : TDocumento;
  blnAviso                : Boolean;
  blnAvisarOperadorVendaComPrecoCusto : Boolean;
begin

  If (Not fEmptyStr(strCliAnt)) Then
    Exit;

  qryGenGer := fCriaQuery(Self);
  cdsGenGer := TUniClientDataSet.Create(Self);
  dspGenGer := TUniDataSetProvider.Create(Self);
  dspGenGer.DataSet := qryGenGer;

  Try

    strCliDoc               := '';
    strNomCli               := '';
    strMercadoriasFaltantes := '';

    fatVenda.fltFatNot    := RecFatorNotaEspecial.fltFatNot;
    fatVenda.strTipFatNEs := RecFatorNotaEspecial.strTipFatNEs;

    fatVenda.blnMeiaNota             := True;
    fatVenda.blnMeiaNotaPorDocumento := False;

    strNomCli := fRetNomCliente(RecFatorNotaEspecial.strCliNov);

    edtCodCli.Text     := RecFatorNotaEspecial.strCliNov;
    fatVenda.strCodCli := '';

    If (fCfgSis('CNDESP', varInteger) = 1) Then
    Begin
      edtCodCnd.Text     := fCfgSis('CNDAVI', varString);
      mskCndPag.Text     := '01000';
      fatVenda.strCodCnd := edtCodCnd.Text;
      fatVenda.strConPag := mskCndPag.Text;
    End;

    strFpgAnt := fatVenda.strCodFpg;
    strConAtu := fatVenda.strConPag;

    fatVenda.strMen001 := '** NOTA ESPECIAL **';
    fatVenda.strMen002 := '';

    pCarregaCliente;

    fatVenda.strNumFatFFEsp := RecFatorNotaEspecial.strNumDoc;
    fatVenda.strTipFatFFEsp := RecFatorNotaEspecial.strEspDoc;
    fatVenda.strEmpFatFFEsp := RecFatorNotaEspecial.strCodEmp;
    fatVenda.strCliFatFFEsp := RecFatorNotaEspecial.strCliNov;

    fatVenda.strCliNomContaOrdem := strNomCli;
    fatVenda.strCliCgcContaOrdem := fatVenda.strCliCgc;
    fatVenda.strCliIesContaOrdem := fatVenda.strCliIes;
    fatVenda.strCliCon           := fatVenda.strCliCon;

    edtSenVen.Text := IIF(fCfgSis('USADIG', varBoolean), strLoginUsuarioLogado, fRetSenhaVendedor(strLoginUsuarioLogado));
    pCarregaVendedor;

    If (Not fValidaCampos(edtCodCli, True)) Then
      Exit;

    If (Not fValidaCampos(cbTabPreco, True)) Then
      Exit;

    {********************************}
    {* MONTA A MENSAGEM DA CO OU MF *}
    {*****************************JB*}
    fatVenda.strMensagContaOrdem := IIF(fatVenda.strOpcDoc = 'CO','MERCADORIA POR CONTA E ORDEM', 'MERCADORIA FALTANTE') +
                                       ' DE '          + fatVenda.strCliNom +
                                       ' CNJP: '       + fatVenda.strCliCgc +
                                       ' IE: '         + fatVenda.strCliIes +
                                       ' CONFORME NF ' + fatVenda.strNumDocContaOrdem +
                                       ' DE '          + fatVenda.strDtaDocContaOrdem +
                                       ' DE R$ '       + '0,00' +
                                       ' ONDE '        + 'OS IMPOSTOS FORAM RECOLHIDOS/DESTACADOS NOS TERMOS DO ART. 129 DO RICMS.';

    fatVenda.arrMenOri[1] := '';
    fatVenda.arrMenOri[2] := '';
    fatVenda.arrMenOri[3] := '';
    fatVenda.arrMenOri[4] := '';
    fatVenda.arrMenOri[5] := '';

    strTabela := 'MOVDET';
    strMovMad := 'MOVMAD';
    strTabTri := 'MOVTRI';

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  DET_CODITE, ';
    strSQL := strSQL + '  DET_CODEMP, ';
    strSQL := strSQL + '  DET_ESTADO, ';
    strSQL := strSQL + '  DET_UNITAR, ';
    strSQL := strSQL + '  DET_UNIORI, ';
    strSQL := strSQL + '  DET_DESESP, ';
    strSQL := strSQL + '  DET_QTDITE, ';

    strSQL := strSQL + '  DET_TOTULT, ';
    strSQL := strSQL + '  DET_IMPULT, ';
    strSQL := strSQL + '  DET_TOTMED, ';

    If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
    Begin
      strSQL := strSQL + '  DET_COMPEC, ';
      strSQL := strSQL + '  DET_LARPEC, ';
      strSQL := strSQL + '  DET_ESPPEC, ';

      strSQL := strSQL + '  DET_APAREL, ';
      strSQL := strSQL + '  DET_PERAPA, ';
      strSQL := strSQL + '  DET_BENEFI, ';
      strSQL := strSQL + '  DET_PERBEN, ';
    End;

    strSQL := strSQL + '  DET_TOTCUS, ';
    strSQL := strSQL + '  DET_TOTCU2, ';
    strSQL := strSQL + '  DET_TABPRE, ';
    strSQL := strSQL + '  DET_INCPIS, ';
    strSQL := strSQL + '  DET_IDEPRO, ';
    strSQL := strSQL + '  DET_DESCRI, ';
    strSQL := strSQL + '  DET_UNIDAD, ';
    strSQL := strSQL + '  DET_CODMAR, ';
    strSQL := strSQL + '  DET_FORITE, ';
    strSQL := strSQL + '  DET_REFERE, ';
    strSQL := strSQL + '  DET_DESCON, ';
    strSQL := strSQL + '  DET_TOTPES, ';
    strSQL := strSQL + '  DET_NUMLOT, ';
    strSQL := strSQL + '  DET_CODDIV, ';
    strSQL := strSQL + '  DET_CODVE2, ';
    strSQL := strSQL + '  DET_ENTFUT, ';
    strSQL := strSQL + '  DET_MOTFUT, ';
    strSQL := strSQL + '  DET_DTAFUT, ';
    strSQL := strSQL + '  ITE_CODGRU, ';
    strSQL := strSQL + '  UNI_ITEFRA, ';
    strSQL := strSQL + '  DET_CODACA, ';
    strSQL := strSQL + '  DET_EMPACA, ';
    strSQL := strSQL + IIF(strTabela = 'MOVDET', 'FIS_ACESSO, ', '');
    strSQL := strSQL + IfThen(RecFatorNotaEspecial.blnNotaDeRemessa,'  "N" AS DET_PROMOC, ', '  DET_PROMOC, ');
    strSQL := strSQL + '  DET_PROACA  ';
    strSQL := strSQL + ' FROM ';
    strSQL := strSQL + '  ' + strTabela + ' D ';
    strSQL := strSQL + ' JOIN CADITE ON ITE_CODITE = DET_CODITE ';
    strSQL := strSQL + ' LEFT JOIN CADUNI ON UNI_CODUNI = DET_UNIDAD ';

    strSQL := strSQL + 'LEFT JOIN ' + strTabTri + ' T ON T.DET_SEQGER = D.AUTOINCREM ';

    If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
      strSQL := strSQL + ' LEFT JOIN ' + strMovMad + ' M ON M.DET_SEQGER = D.AUTOINCREM  ';

    If strTabela = 'MOVDET' Then
    Begin
      strSQL := strSQL + '  LEFT JOIN CADFIS ON CADFIS.FIS_NUMDOC = D.DET_NUMDOC AND ';
      strSQL := strSQL + '                      CADFIS.FIS_ESPDOC = D.DET_ESPDOC AND ';
      strSQL := strSQL + '                      CADFIS.FIS_SERIE_ = D.DET_SERIE_ AND ';
      strSQL := strSQL + '                      CADFIS.FIS_CODEMP = D.DET_CODEMP AND ';
      strSQL := strSQL + '                      CADFIS.FIS_FORCLI = D.DET_CODCLI AND ';
      strSQL := strSQL + '                      CADFIS.FIS_TIP_FC = D.DET_TIP_FC ';
    End;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
    strSQL := strSQL + '  DET_ORIDOC = "V"         ';

    If (Pos(strOpcDoc, 'CO_VN_') > 0) Then
      strSQL := strSQL + ' AND DET_PROEMB <> "S"  ';

    If (Not fEmptyStr(strMercadoriasFaltantes)) Then
      strSQL := strSQL + ' AND D.AUTOINCREM IN('+strMercadoriasFaltantes+')  ';

    strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(strSQL,'MOVDET','NOTDET'),'MOVMAD','NOTMAD'),'MOVTRI','NOTTRI');

    {** Carrega itens dos documentos selecionados **}
    FillChar(arrMeiaNota, SizeOf(arrMeiaNota), #0);
    intContador := 0;
    blnAviso    := False;

    For Documento In RecFatorNotaEspecial.DocumentosSelecionados Do
    Begin

      qryGenGer.Close;
      qryGenGer.SQL.Clear;
      qryGenGer.SQL.Add(strSQL);
      qryGenGer.ParamByName('NUMDOC').AsString := Documento.strNumDoc;
      qryGenGer.ParamByName('ESPDOC').AsString := Documento.strEspDoc;
      qryGenGer.ParamByName('CODEMP').AsString := Documento.strCodEmp;
      qryGenGer.ParamByName('CODCLI').AsString := Documento.strCliFor;
      qryGenGer.Open;

      pSetaClient(qryGenGer);

      cdsGenGer.Close;
      cdsGenGer.SetProvider(dspGenGer);
      cdsGenGer.Open;

      TEmissaoNotaEspecial.pCarregaItensNotaEspecial(fatVenda, qryGenGer, blnAvisarOperadorVendaComPrecoCusto);

      IF fatVenda.fGravaChaveReferenciada Then
      Begin
         fatVenda.pCarregaChaveReferenciada(cdsGenGer);
      End;

      If Not blnAviso Then
        blnAviso := blnAvisarOperadorVendaComPrecoCusto;

      SetLength(arrMeiaNota, Length(arrMeiaNota) + 1);
      arrMeiaNota[intContador].strEmpDoc := Documento.strCodEmp;
      arrMeiaNota[intContador].strEspDoc := Documento.strEspDoc;
      arrMeiaNota[intContador].strNumDoc := Documento.strNumDoc;
      inc(intContador);

    End;

    If Assigned(arrMeiaNota) then
      fatVenda.arrDocMeiaNota := arrMeiaNota;

    If (blnAviso) Then
      fMensagem('ATENÇÃO!', 'Foi identificado preço de venda abaixo do custo, foi aplicado o preço de custo nesses casos!', ['&Ok']);

    If strOpcDoc <> 'CO' Then
    Begin
      edtCodCli.ReadOnly := True;
      blnPermiteAlterarCliente := False;
    End;

    If (fCfgSis('USADIG', varBoolean)) Then
    Begin
      edtSenVen.ReadOnly := True;

      If (Not blnCarregouSenhaVendedorAutomaticamente) Then
        pSetFocus(edtSenDig);
    End
    Else If fPermiteFocoCampoVendedor Then
    Begin
      pSetFocus(edtSenVen);
    End;

    If strOpcDoc = 'CO' Then
      pSetFocus(edtCodCli);

    pEnabledFechamento(True);

    If Pos(strOpcDoc, 'VN_CS_PD_') > 0 Then
      blnComVen := True;

    pCalculaTotais;

  Finally
    FreeAndNil(qryGenGer);
    FreeAndNil(dspGenGer);
    FreeAndNil(cdsGenGer);
  End;

end;

procedure TfrmFatVendas.pAdicionaItemServico;
  Var
    strOpcoes: String;
    intRecNo: Integer;
    prcScroll: TprcScroll;

  procedure pAdicionaServico(strCodigo: String);
  begin
    btnCancelaItem.Click;
    blnBuscarCodFab := False;

    If (Not fExisteItem(strCodigo)) Then
      Raise Exception.Create('Item serviço "' + strCodigo + '" não está cadastrado na tabela ITEGER na empresa "' + VS_strCodEmp + '".');

    edtCodIte.Text := strCodigo;

    strCodAtu := strCodigo;

    pCarregaItem(True, False);
    fatVenda.pInserirItemServico(btnAdicionar, qryConCit, qryConIte, qryConAbf);

    btnCancelaItem.Click;
  end;

begin
  strOpcoes := 'NC_OR_PD_VN_CS_VS_OU_OV_OE_OF_EF_CF_CP_OV_';
  intRecNo  := 0;

  If (Pos(strOpcDoc, strOpcoes) <= 0) Then
    Exit;

  If (blnConEqu) And (strOpcDoc = 'OU') Then
    Exit;

  Try
    pDisableControls(cdsVenda, prcScroll);
    intRecNo := cdsVenda.RecNo;

    If (Not cdsVenda.Locate('ITE_CODITE', fCfgSis('ITESER'), [])) Then
      pAdicionaServico(fCfgSis('ITESER'));

    If fCfgSis('AUTCEN', VarBoolean) And (fCfgSis('ITESER') <> fCfgSis('SERTER')) Then
      If (Not cdsVenda.Locate('ITE_CODITE', fCfgSis('SERTER'), [])) Then
        pAdicionaServico(fCfgSis('SERTER'));
  Finally
    Try
      cdsVenda.RecNo := intRecNo;
    Except
      //
    End;
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

procedure TfrmFatVendas.pAdicionaProdutosComboVenda(blnAltera, blnVerGer: Boolean; intAutInc: Integer = -1);
  Var
    strIndexName,
    strIndexFieldNames: String;
begin
  If (Pos(strOpcDoc, 'OR_PD_VN_CP_DV_PR_') <= 0) Then
    Exit;

  If (blnInserindoCombo) Or (blnAlterandoCombo) Then
    Exit;

  If (intAutInc > -1) Then
  Begin
    strIndexName := cdsVenda.IndexName;
    strIndexFieldNames := cdsVenda.IndexFieldNames;
    cdsVenda.IndexName := EmptyStr;
    cdsVenda.IndexFieldNames := 'AUTOINCREM';
    cdsVenda.Locate('AUTOINCREM',  intAutInc, []);
  End;

  Try
    If (Not fPermiteAtivarComboVenda(cdsVenda.FieldByName('ITE_IDEPRO').AsString, cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
      Exit;

    If (Pos(strOpcDoc, 'DV_PR_') > 0) Then
      If (cdsVenda.FieldByName('ITE_SEQCOM').AsInteger <= 0) Then
        Exit;

    {Passo o "Self" aqui pois em "btnCancelaItemClick" foi tratado para validar
     o Sender e não focar no "edtCodIte", quando chamado por essa PROCEDURE}
    if (not blnEhMultiLote) then
      btnCancelaItemClick(Self);

    If fTemComboVigenteParaProdutoAtivacao(cdsVenda) Then
    Begin

      If (Not fCfgSis('USABRI', varBoolean)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse Produto tentou ativar o Combo de Venda. Para utilizar a rotina do Combo de Venda, é preciso permitir utilizar Brinde no Faturamento.' + #13#10 +
                  'Verifique a Configuração CFG_USABRI nas Configurações do Sistema.', ['&O k']);
        Exit;
      End;

      If (Not fCfgSis('VENBRI', varBoolean)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Para utilizar o cadastro de Combo de Venda, é preciso configurar para não desmembrar os Produtos de Brinde dos demais Produtos no faturamento.' + #13#10 +
                  'Verifique a Configuração CFG_VENBRI nas Configurações do Sistema.', ['&O k']);
        Exit;
      End;

      If (Not blnAltera) Or (Not fExisteProdutoComboRelacionadoAoItemDeAtivacao(cdsVenda.FieldByName('ITE_SEQCOM').AsInteger)) Then
      Begin
        If (blnVerGer) Then
          fMensagem('', 'O Produto: ' + Copy(cdsVenda.FieldByName('ITE_CODITE').AsString + '-' + cdsVenda.FieldByName('ITE_DESITE').AsString,1, 50) + #13#10 +
                        'ativou a venda em sistema de combo. Será exibida a tela com os produtos disponíveis para utilização em conjunto com o produto vendido.', ['&O k'])
        Else
          fMensagem('', 'Este produto ativou a venda em sistema de combo.' + #13#10 +
                        'Será exibida a tela com os produtos disponíveis para utilização em conjunto com o produto vendido.', ['&O k']);

        fatVenda.objComVen.setAbrTel(True);

        If (fatVenda.objComVen.fAbreTelaSelecaoProdCombo) Then
        Begin
          If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (pnlEntrega.Visible) And
             (cdsVenda.FieldByName('ITE_ENTRET').AsString='E') And (cdsVenda.FieldByName('ITE_ENTFUT').AsString='S') Then
          Begin
            With fatVenda.objComVen.cdsProCom Do
            Begin
              First;
              While Not Eof Do
              Begin
                If (FieldByName('MARDES').AsString = 'S') And (FieldByName('BRINDE').AsString = 'S') Then
                Begin
                  fMensagem('ATENÇÃO!', 'Esse produto tentou ativar o Combo de Venda. Porém não é possivel a inclusão de itens de Brinde com Entrega Futura!', ['&O k']);
                  Exit;
                End;
                Next;
              End;
            End;
          End;

          pInsereProdutosComboVenda;
        End;
      End
      Else If (Not blnVerGer) Then
        pAlteraDadosProdCombo;
    End
    Else If (blnAltera) And (cdsVenda.FieldByName('ITE_ATIVAC').AsString = 'S') Then
    Begin
      If (blnVerGer) Then
        fMensagem('', 'O Produto: ' + Copy(cdsVenda.FieldByName('ITE_CODITE').AsString + '-' + cdsVenda.FieldByName('ITE_DESITE').AsString,1, 50) + #13#10 +
                      'foi alterado e o mesmo não pertence mais ao Combo de Venda. Os Produtos do Combo de Venda vinculados a este Produto, serão removidos agora.', ['&O k'])
      Else
        fMensagem('', 'O Produto foi alterado e o mesmo não pertence mais ao Combo de Venda.' + #13#10 +
                      'Os Produtos do Combo de Venda vinculados a este Produto, serão removidos agora.', ['&O k']);

      pRemoveProdutosCombo;
    End;
  Finally
    If (intAutInc > -1) Then
    Begin
      If (strIndexName.IsEmpty) Then
        cdsVenda.IndexFieldNames := strIndexFieldNames
      Else
        cdsVenda.IndexName := strIndexName;
      cdsVenda.Locate('AUTOINCREM',  intAutInc, []);
    End;

    If (Not blnEhMultiLote) Then
      pLimpaDadosItem();
  End;
end;

procedure TfrmFatVendas.pDeletaItemServico(blnVerSeTemServico: Boolean = True);
  Var
    intRecNo: Integer;
    prcScroll: TprcScroll;
begin
  intRecNo := 0;
  Try
    If blnVerSeTemServico And fatVenda.fPossuiServico() Then
      Exit;

    pDisableControls(cdsVenda, prcScroll);
    intRecNo := cdsVenda.RecNo;
    While cdsVenda.Locate('ITE_CODITE', fCfgSis('ITESER'), []) Do cdsVenda.Delete;
    While cdsVenda.Locate('ITE_CODITE', fCfgSis('SERTER'), []) Do cdsVenda.Delete;
  Finally
    Try
      cdsVenda.RecNo := intRecNo;
    Except
      //
    End;
    pEnableControls(cdsVenda, prcScroll);
  End;

end;

function TfrmFatVendas.fPodeDeletarItemGrade: Boolean;
  Var
    strProdutoExcluido : String;
begin
  Result := True;

  if fatVenda.blnEmSeparacao then
  begin
    fMensagem('', MSG_SEPARACAO, ['&OK']);
    Result := False;
    Exit;
  end;

  if (not fValidaPodeAlterarItemComRequisicao(True)) then
    Result := False;

  If (Not fValidaSenhaAlteracaoTE) Then
    Result := False;

  If (fCfgSis('SSEIIP', varBoolean)) Then
  Begin
    If (fCfgSis('F11FPD', varBoolean) And (fatVenda.strOpcDoc = 'PD') And (Not blnCarregouPedido)) Then
    begin
      strProdutoExcluido := strProdutoExcluido + '| '
                            + fPreencheEspaco(cdsVenda.FieldByName('ITE_CODITE').AsString, 6)
                            + ' | '
                            + fPreencheEspaco(cdsVenda.FieldByName('ITE_DESITE').AsString, 45)
                            + ' | '
                            + fPreencheEspaco(cdsVenda.FieldByName('ITE_SIGUNI').AsString, 2)
                            + ' | '
                            + fPreencheEspaco(FormatFloat(',0.00', cdsVenda.FieldByName('ITE_QTDITE').AsFloat), 10, False)
                            + ' | '
                            + fPreencheEspaco(FormatFloat(',0.00', cdsVenda.FieldByName('ITE_UNITAR').AsFloat), 14, False)
                            + ' | '
                            + fPreencheEspaco(FormatFloat(',0.00', cdsVenda.FieldByName('ITE_TOTITE').AsFloat), 11, False)
                            + ' |';

      objLiberacao.Clear;
      objLiberacao.strDirAce    := 'LIBEXCITEPED';
      objLiberacao.strMsgSen    := 'Liberar Exclusão do Item do Pedido de Venda Durante a Inserção do Pedido' ;
      objLiberacao.strCodOpe    := strLoginUsuarioLogado;
      objLiberacao.objMsgLibera.pAddTexto('Liberar Exclusão do Item do Pedido de Venda Durante a Inserção do Pedido');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTexto('Vendedor: ' + fatVenda.strCodVen + '-' + fRetNomeOperador(fatVenda.strCodVen));
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTexto('CPF/CNPJ: ' + fFormataCpfCgc(fatVenda.strCliCgc, fSetaPais));
      objLiberacao.objMsgLibera.pAddTexto('Cliente: ' + fatVenda.strCodCli + '-' + fatVenda.strCliNom);
      objLiberacao.objMsgLibera.pAddTexto('Nome Fantasia: ' + fRetNomFantasia(fatVenda.strCodCli));
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTexto('Produto excluído:');
      objLiberacao.objMsgLibera.pAddTexto('|---------------------------------------------------------------------------------------------------------|');
      objLiberacao.objMsgLibera.pAddTexto('| Código | Descrição                                     | UN | Quantidade |   Vr. Unitário |   Vr. Total |');
      objLiberacao.objMsgLibera.pAddTexto('|---------------------------------------------------------------------------------------------------------|');
      objLiberacao.objMsgLibera.pAddTexto(strProdutoExcluido);
      objLiberacao.objMsgLibera.pAddTexto('|---------------------------------------------------------------------------------------------------------|');

      Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
    end;
  end;
end;

procedure TfrmFatVendas.pDeletarItemGrade;
  Var
    intRecNo: Integer;
begin

  If (fatVenda.blnDevRap) Then
  Begin
    btnCancelaItem.Click;
    fatVenda.blnFecharForm := fFecharFatVendas_DevolucaoRapida;
    Self.FormPaint(Self);
    Exit;
  End;

  Try
    If InterlockedIncrement(intExcluindoProduto) = 0 Then
    Begin
      intRecNo := cdsVenda.RecNo;

      if not fPodeDeletarItemGrade then
        Exit;

      If (cdsVenda.FieldByName('ITE_SEQPER').AsInteger > 0) Then
        If (objEstruturaPersonalizada.blnEstruturaFoiPersonalizada) Then
          objEstruturaPersonalizada.pItemDeletadoSincronizar(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                             cdsVenda.FieldByName('ITE_SEQPER').AsInteger);

      If (cdsVenda.FieldByName('ITE_SEQEST').AsInteger > 0) And
         fEstaRemovendoItemDeEstrutura(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString) then
      begin
        pRemoveEstruturaItem(cdsVenda.FieldByName('ITE_ITEEST').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, cdsVenda.FieldByName('ITE_SEQEST').AsInteger);
      end
      else
      begin
        TfrmGravando.fExecutarModal(pDeletaItemAndCalculaTotais, 'Aguarde, Deletando item ...', '');
      end;

      //necessario para atualizar o produto corretamente, na menil ocorreu de gravar um produto com descricao de outro
      btnCancelaItem.Click;
      pSetFocus(dbgItens);

      fatVenda.strNumLib := EmptyStr;

      If (Not cdsVenda.IsEmpty) And (cdsVenda.RecordCount >= intRecNo) Then
        cdsVenda.RecNo := intRecNo;
    End;
  Finally
    InterlockedDecrement(intExcluindoProduto);
  End;
end;

procedure TfrmFatVendas.pDeletaSubItensEstrutura;
  Var
    intSeqEst: Integer;
    blnVenderItemSeparado: Boolean;
begin
  cdsVenda.DisableControls;
  intSeqEst := cdsVenda.FieldByName('ITE_SEQEST').AsInteger;
  Try
    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      blnVenderItemSeparado := IIF((Pos(strOpcDoc, 'TE_') > 0), fPermiteTransferenciaSubItemEstruturaAvulso(cdsVenda.FieldByName('ITE_CODITE').AsString),
                                                                fPermiteVenderSubItemEstruturaAvulso(cdsVenda.FieldByName('ITE_CODITE').AsString));

      If (cdsVenda.FieldByName('ITE_SEQEST').AsInteger = intSeqEst) And
         (Not blnVenderItemSeparado) Then
        cdsVenda.Delete
      Else
        cdsVenda.Next;
    End;
  Finally
    cdsVenda.EnableControls;
    pCalculaTotais;
    btnCancelaItem.Click;
  End;
end;

procedure TfrmFatVendas.pBeforePost(DataSet: TDataSet);
begin
  if blnExibirDadosEstrutura then
