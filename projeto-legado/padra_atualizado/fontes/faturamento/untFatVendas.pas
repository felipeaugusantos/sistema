end;

procedure TfrmFatVendas.edtOprFljExit(Sender: TObject);
  Var
    intRecNo: Integer;
    blnEscPrd: Boolean;
    strBckOprFlj: String;
    strEmpPrdAnt: String;

    function fVerificaPodeUtilizarTinta: Boolean;
    Begin
      Result := True;
      intRecNo := cdsVenda.RecNo;
      cdsVenda.First;

      While (Not cdsVenda.Eof) Do
      Begin

        If (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR')
          and (cdsVenda.FieldByName('ITE_ESCPRD').AsInteger = 0) Then
        Begin
           Result := (fatVenda.fPodeUtilizarTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString) );

           If Not Result Then
           Begin
             fMensagem('ATENÇÃO!', 'Tinta sem permissão para essa empresa!', ['&Ok']);
             Break;
           End;

        End;

        cdsVenda.Next;
      End;

      cdsVenda.RecNo := intRecNo;

    End;


begin
  inherited;
  If (fatVenda.strOprFlj <> edtOprFlj.Text) And (edtOprFlj.Text = 'S') Then
  Begin
    If (fatVenda.fVendaMultiLoja Or fatVenda.fPedidoMultiLoja) Then
    Begin
      edtOprFlj.Text := 'N';
      fMensagem('','Não é possível utilizar Produção fora da loja ' +
                   'quando estiver utilizando venda Multi-Empresa!', ['&Ok']);
      Exit;
    End;
  End;

  blnEscPrd := fCfgSis('ESCPRD', varBoolean);

  If (fatVenda.strOprFlj <> edtOprFlj.Text) Then
  Begin

    intRecNo := cdsVenda.RecNo;
    cdsVenda.First;

    While (Not cdsVenda.Eof) Do
    Begin
      If (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
      Begin
        strEmpPrdAnt := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

        cdsVenda.Edit;
        If (blnEscPrd) And (edtOprFlj.Text = 'S') Then
        Begin
          cdsVenda.FieldByName('ITE_ESCPRD').AsInteger := 1;
          pnlEscPrd.Visible := True;
        End
        Else
        Begin
          cdsVenda.FieldByName('ITE_ESCPRD').AsInteger := 0;
          If (edtOprFlj.Text = 'S') Then
            cdsVenda.FieldByName('ITE_EMPPRD').AsString := VS_strEmpPrd
          Else
            cdsVenda.FieldByName('ITE_EMPPRD').AsString := VS_strCodEmp;
        End;
        cdsVenda.Post;

        pRecalculaTintaMaquinaSelecionadoCasoNecessario(strEmpPrdAnt);
      End;

      cdsVenda.Next;
    End;
    cdsVenda.RecNo := intRecNo;

    strBckOprFlj := fatVenda.strOprFlj;
    fatVenda.strOprFlj := edtOprFlj.Text; {<<== "fatVenda.strOprFlj" É utilizado dentro dentro da "fatVenda.fVerificaEstoqueItens"}

    If Not (fatVenda.fVerificaEstoqueItens(strOpcDoc) And fVerificaPodeUtilizarTinta) Then
    Begin
      edtOprFlj.Text := strBckOprFlj;
      fatVenda.fVerificaEstoqueItens(strOpcDoc, '', False);
      pSetFocus(edtOprFlj);
      Exit;
    End;

  End;

end;

