    'FATGOR INNER JOIN EXTGOR ON FATGOR.AUTOINCREM = FGO_SEQFGO',
    ['FGO_NMPDAB','FGO_ESPDAB','FGO_EMPDAB'],
    [fatVenda.strNumOrc, fatVenda.strEspOrc, fatVenda.strEmpOri]);

