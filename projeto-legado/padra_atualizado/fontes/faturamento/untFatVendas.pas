    Begin
      edtDesCndPag.Visible := True;
    End
    Else
    Begin
      edtDesCndPag.Visible := False;
    End;

  End
  Else
  Begin

    edtDesCndPag.Visible := False;

  End;

  If Not fEmptyStr(strTipVen) Then
