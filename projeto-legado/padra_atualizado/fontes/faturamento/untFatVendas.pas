function TfrmFatVendas.fExibirTelaFinalizacaoNovoFechamentoOrcamentoPedido: Boolean;
  Var
    frmFechamentoOrcamentoPedido: TfrmFatDadosFechamentoPedido;
begin
  pCriarFormularios(TfrmFatDadosFechamentoPedido, frmFechamentoOrcamentoPedido);
  Try
    Self.AddFechamentoVendaObserver(frmFechamentoOrcamentoPedido);

    frmFechamentoOrcamentoPedido.Caption   := Self.Caption;
    frmFechamentoOrcamentoPedido.objVenda  := fatVenda;
    frmFechamentoOrcamentoPedido.qryFatGor := qryFatGor;

    frmFechamentoOrcamentoPedido.pAfterCalcTotGer := pAtualizarEditsTotais;
    frmFechamentoOrcamentoPedido.pAlteraEnderecoEntrega := pAlteraEnderecoEntrega;
    frmFechamentoOrcamentoPedido.fAtualizarDadosCondicaoPagamento := fAtualizarCondicaoPagamentoNovoFechamentoOrcamentoPedido;
    frmFechamentoOrcamentoPedido.fRealizarValidacoesFechamento := fRealizarValidacoesNovoFechamentoOrcamentoPedido;
    frmFechamentoOrcamentoPedido.fRealizaFechamentoVenda := fRealizaFechamentoVenda;
    frmFechamentoOrcamentoPedido.blnDescontaCreditoAutomatico := ckbAbCrAu.Checked;

    If (fCfgSis('CNDVEN') = 'F') Then
      pIniciarDigitacaoCondicaoPagamentoFinalVenda(frmFechamentoOrcamentoPedido.fraPagamento,
        fatVenda.FConPag, fatVenda.FCodCnd);

    frmFechamentoOrcamentoPedido.showModal;

    Result := frmFechamentoOrcamentoPedido.blnConfirma;
  Finally
    Self.RemoveFechamentoVendaObserver(frmFechamentoOrcamentoPedido);
    pFreeAndNil(frmFechamentoOrcamentoPedido);
  End;
end;

