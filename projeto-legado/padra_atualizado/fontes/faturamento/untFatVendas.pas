procedure TfrmFatVendas.pAtualizaTemporaria;
  Var
    intCol: Integer;
begin
  With cdsVenda Do
  Begin
    Filtered := False;
    Filter   := 'ITE_QTDITE > 0';
    Filtered := True;
    IndexFieldNames := 'ITE_ORDITE';

    fatVenda.pFormataDecimaisGrid(cdsVenda);

    fFindColumnByName(dbgItens, 'ITE_DESCON').Title.Caption := 'Desc.(' + fCfgSis('TIPDES') + ')';
  End;

  If (fMostraGridSubItens) Then
  Begin
    pAjustaTamanhoDescricaoItemGrid;

    fatVenda.pFormataDecimaisGrid(fatVenda.cdsDadosSubItensEst);
    fatVenda.cdsDadosSubItensEst.IndexFieldNames := 'ITE_ORDITE';

    For intCol := 0 To dbgItens.Columns.Count -1 Do
      If fFindColumnByName(dbgSubItens, dbgItens.Columns[intCol].FieldName) <> Nil Then
        With fFindColumnByName(dbgSubItens, dbgItens.Columns[intCol].FieldName), Title Do
        Begin
          Visible := dbgItens.Columns[intCol].Visible;
          Caption := dbgItens.Columns[intCol].Title.Caption;
          Width   := dbgItens.Columns[intCol].Width;
        End;
  End;

end;

