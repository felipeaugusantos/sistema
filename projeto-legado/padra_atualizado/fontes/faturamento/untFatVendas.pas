procedure TfrmFatVendas.mnuAltEmpItemClick(Sender: TObject);
  Var
    strEmpSel: String;

  function fAlteraEmpresaItemCombo(strEmpAlt: String; blnItemPosicionado: Boolean): Boolean;
  Var
    cdsVenTmp: TUniClientDataSet;
    intRecNo : Integer;
    prcScroll: TprcScroll;
  Begin
    Result := False;

    If (cdsVenda.FieldByName('ITE_ATIVAC').AsString <> 'S') Then
    Begin
      Result := True;
      Exit;
    End;

    intRecNo := cdsVenda.RecNo;

    Try
      pDisableControls(cdsVenda, prcScroll);
      cdsVenTmp := TUniClientDataSet.Create(Self);
      pCloneDataSet(cdsVenTmp, cdsVenda);
      cdsVenTmp.Filter := 'ITE_SEQCOM = ' + cdsVenda.FieldByName('ITE_SEQCOM').AsString + ' AND ' +
                          'ITE_ATIVAC <> ''S''';
      cdsVenTmp.Filtered := True;
      cdsVenTmp.Open;

      With cdsVenTmp Do
      Begin
        First;
        While Not Eof Do
        Begin
          If (cdsVenda.Locate('AUTOINCREM', FieldByName('AUTOINCREM').AsString, [])) Then
            fMenuAlteraEmpresaItem(strEmpAlt, blnItemPosicionado);
          Next;
        End;
      End;

      Result := True;
    Except
      On E: Exception Do
        pMensagensErro(e.Message, '[fAlteraEmpresaItemCombo]');
    End;

    FreeAndNil(cdsVenTmp);
    cdsVenda.RecNo := intRecNo;
    pEnableControls(cdsVenda, prcScroll);
  End;

begin
  inherited;

  If Not fVerificaAcessoSistema('ALEITE') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Alterar Empresa do Item!', ['&O k']);
    Exit;
  End;

  If edtCodEmp.ReadOnly And Not fEmptyStr(edtCodEmp.Hint) Then
  Begin
    fMensagem('Atenção', edtCodEmp.Hint, ['&OK']);
    Exit;
  End;

  If (fItemCombo) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido alterar a Empresa do Item do Combo de Venda.' + #13#10 +
                          'Esta rotina deve ser realizada através do Item de Ativação do Combo de Venda.', ['&O k']);
    Exit;
  End;

  btnCancelaItem.Click;
  strEmpSel := '';

  If mnuAltEmpItem.Visible And (Not cdsVenda.IsEmpty) Then
    pMostraEstoqueLojas(strEmpSel);

  If fSelecionouEmpresaDoClienteFilial(strEmpSel) Then
  Begin
    fMensagem('','ATENÇÃO! Não é permitido informar a Empresa do Cliente Filial!', ['&O k']);
    Exit;
  End;

  If Not fEmptyStr(strEmpSel) Then
  Begin
    fMenuAlteraEmpresaItem(strEmpSel, True, nil, fatVenda.blnPraticarPrecosEmpresaFaturamento);
    fAlteraEmpresaItemCombo(strEmpSel, True);
    pVerificaComboVigente;
  End;
end;

