function TfrmFatVendas.fDocumentoEletronicoAutorizado(
  qryConDev: TDataSet): Boolean;
  Var
    qryAux: TUniQuery;
begin
  Result := True;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT NFE_STATUS FROM LOGNFE WHERE ');
  qryAux.SQL.Add('  NFE_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  NFE_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  NFE_CODEMP = :CODEMP AND ');
  qryAux.SQL.Add('  NFE_CODCLI = :CODCLI AND ');
  qryAux.SQL.Add('  IFNULL(NFE_SERIE_, "") = :SERIE_ AND ');
  qryAux.SQL.Add('  NFE_TIP_FC = :TIP_FC ');

  qryAux.ParamByName('NUMDOC').AsString := qryConDev.FieldByName('DET_NUMDOC').AsString;
  qryAux.ParamByName('ESPDOC').AsString := qryConDev.FieldByName('DET_ESPDOC').AsString;
  qryAux.ParamByName('CODEMP').AsString := qryConDev.FieldByName('DET_CODEMP').AsString;
  qryAux.ParamByName('CODCLI').AsString := qryConDev.FieldByName('DET_FORCLI').AsString;
  qryAux.ParamByName('SERIE_').AsString := qryConDev.FieldByName('DET_SERIE_').AsString;
  qryAux.ParamByName('TIP_FC').AsString := qryConDev.FieldByName('DET_TIP_FC').AsString;
  qryAux.Open;

  If Not qryAux.IsEmpty Then
  Begin
    Result := (qryAux.FieldByName('NFE_STATUS').AsString = 'AT');
  End;

  FreeAndNil(qryAux);
end;

function TfrmFatVendas.fTemAlgumProdutoComPromocaoParaCliente(strCodCli: String): Boolean;
  Var
    cdsDados: TUniClientDataSet;
    strEmpItePro: String;

  function fEmpIte: String;
  Begin
    Result := IIF(fEmptyStr(cdsDados.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsDados.FieldByName('ITE_EMPITE').AsString);
  End;
begin
  Result := False;

  cdsDados := TUniClientDataSet.Create(Self);

  pCloneDataSet(cdsDados, cdsVenda);
  cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

  cdsDados.First;

  While Not cdsDados.Eof Do
  Begin

    strEmpItePro := fatVenda.fGetEmpPrecoPromoItem(fEmpIte, cdsDados.FieldByName('ITE_EMPDMP').AsString);

    If ((fatVenda.fItemPassivelDeVerificacaoPromo(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro)) And
        (fItemTemAlgumaPromocaoParaCliente(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro, strCodCli))) Or
       (fatVenda.fTintaTemPromocao(strCodCli, cdsDados.FieldByName('ITE_IDEPRO').AsString, cdsDados.FieldByName('AUTOINCREM').AsString, fatVenda)) Then
    Begin
      Result := True;
      Break;
    End;

    cdsDados.Next;

  End;

  FreeAndNil(cdsDados);
end;

function TfrmFatVendas.fTemAlgumProdutoComPromocaoRestritaNaoConsumidor(): Boolean;
  Var
    cdsDados: TUniClientDataSet;
    strEmpItePro: String;

  function fEmpIte: String;
  Begin
    Result := IIF(fEmptyStr(cdsDados.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsDados.FieldByName('ITE_EMPITE').AsString);
  End;
begin
  Result := False;

  cdsDados := TUniClientDataSet.Create(Self);

  pCloneDataSet(cdsDados, cdsVenda);
  cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

  cdsDados.First;

  While Not cdsDados.Eof Do
  Begin

    strEmpItePro := fatVenda.fGetEmpPrecoPromoItem(fEmpIte, cdsDados.FieldByName('ITE_EMPDMP').AsString);

    If (fatVenda.fItemPassivelDeVerificacaoPromo(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro)) And
       (fItemTemAlgumaPromocaoRestritaNaoConsumidor(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro)) Then
    Begin
      Result := True;
      Break;
    End;

    cdsDados.Next;

  End;

  FreeAndNil(cdsDados);
end;

