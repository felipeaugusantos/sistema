function TfrmFatVendas.fMSG_SenhaManterPrecos_ConfiguracaoPRAUDILigada: Boolean;
  Var
    fltTotalOrig: Double;
    fltTotalNovo: Double;
    strConPagBKP: String;
    strCodCndBKP: String;
    strTabPreBKP: String;
    cdsClone: TUniClientDataSet;
    blnTBPCND: Boolean;
begin
  blnTBPCND := (fCfgSis('TBPCND', VarString) = 'S');

  strConPagBKP := fatVenda.strConPag;
  strCodCndBKP := fatVenda.strCodCnd;
  strTabPreBKP := fatVenda.strTabPre;

  cdsClone := TUniClientDataSet.Create(Nil);

  try
    pCloneDataSet(cdsClone, cdsVenda);

    fatVenda.strConPag := strCndAnt;
    fatVenda.strCodCnd := strCcnAnt;

    fatVenda.pCalculaTaxVpr;

    pRecalculaPrecos(False,
                     False,
                     False,
                     True,
                     '',
                     False,
                     False,
                     False,
                     True);

    fltTotalOrig := fatVenda.fltTotGer;


    fatVenda.strConPag := strConPagBKP;
    fatVenda.strCodCnd := strCodCndBKP;

    If blnTBPCND Then
      fatVenda.strTabPre := Self.strTabPre;

    fatVenda.pCalculaTaxVpr;

    pRecalculaPrecos(False,
                     (blnTBPCND And (fatVenda.strTabPre <> strTabPreBKP)),
                     False,
                     True,
                     '',
                     False,
                     False,
                     False,
                     False);

    fltTotalNovo := fatVenda.fltTotGer;

    pCloneDataSet(cdsVenda, cdsClone);

    If fFormataFloat(fltTotalOrig,2) < fFormataFloat(fltTotalNovo,2) Then
      Result := fMSG_SenhaManterPrecos_MenorValorOriginal(fltTotalOrig, fltTotalNovo)
    Else
      Result := fMSG_SenhaManterPrecos_MaiorIgualValorOriginal(fltTotalOrig, fltTotalNovo);

  finally
    FreeAndNil(cdsClone);
    fatVenda.strConPag := strConPagBKP;
    fatVenda.strCodCnd := strCodCndBKP;

    If blnTBPCND Then
      fatVenda.strTabPre := strTabPreBKP;
  end;
end;

