    strVenOri: String;
    blnVisLim: Boolean;
    blnClienteLiberado: Boolean;
    blnEtCdMt: Boolean;
    fltAdt : Real;

    blnRecalcularItens: Boolean;
    blnRecalcNaVerDivergenciaPromocao: Boolean;

    LfrmGravando: TfrmGravando;
    blnVerificaVlrMinCndPgtoNoFinalDaVenda : Boolean;

  procedure pCarregaFazendaPedido;
  begin
    pMostrarDadosFazendaRodape(False);

    If fCfgSis('CADFAZ', VarBoolean) And
       Not fEmptyStr(qryFatGor.FieldByName('FGO_CODFAZ').AsString) Then
    Begin
      If fatVenda.fSelecionarFazendaCliente(qryFatGor.FieldByName('FGO_CODCLI').AsString,
                                            qryFatGor.FieldByName('FGO_CODFAZ').AsString) Then
      Begin
        pMostrarDadosFazendaRodape(True);
      End;
    End;
  end;

  procedure pCarregaEmbarcacaoPedido;
  begin
    fatVenda.strCodEmbarcacao := qryFatGor.FieldByName('FGO_CODEMB').AsString;

    pMostrarDadosEmbarcacaoRodape((fatVenda.fClientePossuiEmbarcacoes()) And (fatVenda.fSelecionarEmbarcacao()));
  end;

Begin

  If fatVenda.blnFecharForm Then
    Exit;

  blnVisLim := True;

  If Not fEmptyStr(strTipVen) Then
  Begin
    strVenOri := strOpcDoc;
    strOpcDoc := strTipVen;
  End;

  {*****************************************}
  {* VERIFICA SE UTILIZA CAMPANHA LIMITADA *}
  {**************************************IV*}
  If (Not fCfgSis('LIMBRI', varBoolean)) Or
     (strOpcDoc <> 'BR')                 Then
  Begin
    chkCamLim.Visible := False;
    blnVisLim         := False;
  End;

  {******************************************}
  {* CASO A CONDIÇÃO DE PAGAMENTO SEJA PARA *}
  {* O FINAL, DESABILITA O EDIT             *}
  {***************************************MV*}
  If fCfgSis('CNDVEN') = 'F' Then
  Begin

    mskCndPag.Visible  := False;
    lblCndPag.Visible  := False;
    edtCodCnd.Visible  := False;
                                        
    pnlCndPag.Visible  := False;

    If blnPrimVez Then
      pnlCabecalho.Height := pnlCabecalho.Height - pnlCndPag.Height;

  End
  Else
  Begin

    If ( fCfgSis('USACND', varBoolean) ) And
       (Pos(strOpcDoc,'OF_BR_NC_OE_EF_EP_UC_' + IIF(fCfgSis('ALCNDV', varBoolean), '', 'DV_PR_DD_')) <= 0) Then
    Begin

      edtCodCnd.Visible     := True;
      mskCndPag.Enabled     := False;
      mskCndPag.Color       := edtNomCli.Color;
      mskCndPag.NormalColor := edtNomCli.NormalColor;
      mskCndPag.Top         := edtCodCnd.Top;
      mskCndPag.Left        := edtCodCnd.Left + edtCodCnd.Width + 1;
      mskCndPag.Width       := 526;

    End
    Else
    Begin

      edtCodCnd.Visible     := False;
      mskCndPag.Enabled     := True;
      mskCndPag.Color       := clWhite;
      mskCndPag.NormalColor := clWhite;
      mskCndPag.Top         := edtCodCnd.Top;
      mskCndPag.Left        := edtCodCnd.Left;
      mskCndPag.Width       := 947;

    End;

    If (strOpcDoc = 'DV') And fCfgSis('DVVORI', varBoolean) And (Not fCfgSis('ALCNDV', varBoolean)) Then
    Begin
      edtCodCnd.ReadOnly := True;
      mskCndPag.ReadOnly := True;
      edtCodCnd.TabStop  := False;
      mskCndPag.TabStop  := False;
    End;

    If (Not fatVenda.VS_blnUsaFpg) Then
    Begin
      fatVenda.strCodFpg := '';
      edtForPag.Text     := '';
    End;

  End;

  blnVerificaVlrMinCndPgtoNoFinalDaVenda := fVerificaVlrMinCndPgtoNoFinalDaVenda;

  lblSohST.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_') > 0) And fCfgSis('EXI_ST', VarBoolean);
  edtSohST.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_') > 0) And fCfgSis('EXI_ST', VarBoolean);

  lblSohFCP.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_') > 0) And fCfgSis('EXI_ST', VarBoolean);
  edtSohFCP.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_') > 0) And fCfgSis('EXI_ST', VarBoolean);

  lblTotCBS.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_CP_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtTotCBS.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_CP_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtTotCBS.Enabled := edtTotCBS.Visible;

  lblTotIBS.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_CP_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtTotIBS.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_CP_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtTotIBS.Enabled := edtTotIBS.Visible;

