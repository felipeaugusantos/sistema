function TfrmFatVendas.fPedeCondicaoPagamentoFechamentoVenda(fraDigCndPagamento: TfraDigCndPagamento = nil): Boolean;
begin
  Result := True;
  {*******************************************}
  {* PEDE DIGITAÇÃO DA CONDIÇÃO DE PAGAMENTO *}
  {****************************************MV*}
  If (fCfgSis('CNDVEN') = 'F')         And
     (Pos(strOpcDoc, 'NC_BR_MF_CO_UC_') <= 0) And
     (Not ((Pos(strOpcDoc , 'CP_OV_') > 0) And (fatVenda.strCodFpg = '016') And fCfgSis('USAFPG', varBoolean))) Then
  Begin
    If (Not fDigCondicaoPagto(fatVenda.FConPag, fatVenda.FCodCnd, fatVenda.FCodFpg, fraDigCndPagamento)) Then
    Begin
      {Para evitar solicitação de senha ao cancelar senha na condição no final}
      If fCfgSis('PRZMED', varBoolean) Then
      Begin

        If (fCfgSis('CNDVEN') = 'F') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
        Begin
          fatVenda.strConPag := '';
          fatVenda.strCodCnd := '';
          blnSenPrazoMedioMaximoVenda := True;
        End;

      End;

      Result := False;
      Exit;
    End;

    If Not fVerificarProdutosRelacionadosCondicaoPagamento() Then
      Exit(False);
  End
  {*************************************************************}
  {* CASO PEDE A CONDICAO DE PAGAMENTO NO FINAL E NAO TENHA    *}
  {* PEDIDO A TELA DE DIGITACAO DA CONDICAO ENTAO FAZ A VALI-  *}
  {* DACAO DO PRAZO MEDIO DA CONDICAO DE VENDA...              *}
  {**********************************************************JC*}
  Else
  If (fCfgSis('CNDVEN') = 'F') And
    ((Not fatVenda.fVerificaPrazoMedio(fatVenda.strConPag)) Or
    (Not fatVenda.fVerificaQtdMaxParcelas(fatVenda.strConPag))) Then
  Begin
    Result := False;
    Exit;
  End;
end;

function TfrmFatVendas.fPedeDadosEmissaoEmprestimo: Boolean;
begin
  Result := True;
  {*****************************************}
  {* PEDDE DIGITAÇÃO DE MENSAGEM PARA EP   *}
  {**************************************LA*}
  If (fatVenda.strEspDoc = 'EP') Then
  Begin

    Try
      pCriarFormularios(TfrmFatDigMensagemEP, frmFatDigMensagemEP);
      frmFatDigMensagemEP.fatVenda  := fatVenda;

      Result := frmFatDigMensagemEP.showModal = mrok;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fConfirmaVenda_EP]');
        Result := False;
      End;
    End;

    pFreeAndNil(frmFatDigMensagemEP);

    If Not Result Then
    Begin
      Exit;
    End;
  End;

end;

function TfrmFatVendas.fPedeDadosEmissaoNotaFiscal(): Boolean;
var strProdSemCodBeneficio: String;
    strProdutosFaltandoCreditoPresumido: String;
    intContItenNota: integer;
    intTipFre: integer;
    strTextoMensagem: String;
    strClaSet: String;
    strClaFisIte:String;

  function fDigOcorrencia : Boolean;
  begin

    pCriarFormularios(TfrmDigOcorrencia, frmDigOcorrencia);

    Try
      frmDigOcorrencia.strCodOco := fatVenda.strMotDev;
      frmDigOcorrencia.blnInformarHisCom := True;
      frmDigOcorrencia.strOpcDoc := fatVenda.strOpcDoc;
      frmDigOcorrencia.ShowModal;

      If (frmDigOcorrencia.ModalResult = mrOk) Then
      Begin
        fatVenda.strMotDev := frmDigOcorrencia.strCodOco;
        fatVenda.strHisCom := frmDigOcorrencia.strHisCom;
        Result := True;
      End
      Else
      Begin
        pAtualizaTemporaria;
        pDesabilitaItensConfirmacao;
        Result := False;
      end;

    finally
      if Assigned(frmDigOcorrencia) then
        pFreeAndNil(frmDigOcorrencia);
    end;

  end;

begin
  Result := True;
  fatVenda.strClienteDaChaveASerDevolvida := EmptyStr;
  {*****************************************}
  {* CHAMA TELA PARA NOTA FISCAL           *}
  {**************************************MV*}
  If (Pos(fatVenda.strEspDoc, 'NF_EL_NS_') > 0) Or ((fatVenda.strOpcDoc = 'NC') And (blnSatComplementar Or blnNFCeComplementar)) Then
  Begin

    Try
      pCriarFormularios(TfrmFatDadosFiscais, frmFatDadosFiscais);
      frmFatDadosFiscais.fatVenda := fatVenda;
      frmFatDadosFiscais.blnNFCeComplementar := blnNFCeComplementar;

      {************************************************}
      {* SE OUTRAS ENTRADAS, PEGA CLASSIF. DE ENTRADA *}
      {*********************************************RL*}
      If fatVenda.fEhPedidoReposicaoClienteGarantia Then
      begin
        If (fatVenda.strCliEst = fatVenda.fGetUFEmpresa('')) Then
        begin
          fatVenda.strClaFis := '5949';
        end
        else begin
          fatVenda.strClaFis := '6949';
        end;
      end
      else  If (strOpcDoc = 'DD') Then
      Begin
        If (fatVenda.strCliEst = fatVenda.fGetUFEmpresa('')) Then
          fatVenda.strClaFis := '1913'
        Else
          fatVenda.strClaFis := '2913';
      End
      Else If (Pos(strCFOPDvAnt, '5917_6917_') > 0) Then
      Begin

        If (strCFOPDvAnt = '5917') Then
        Begin
          fatVenda.strClaFis := '1917';
          fatVenda.strCFOPDv := '1917';
        End
        Else
        Begin
          fatVenda.strClaFis := '2917';
          fatVenda.strCFOPDv := '2917';
        End;

        If Not fEmptyStr(fatVenda.strClaFi2) Then
        Begin
          If (strCFOPDvAnt = '5917') Then
            fatVenda.strClaFi2 := '1917'
          Else
            fatVenda.strClaFi2 := '2917';
        End;

        If Not fEmptyStr(fatVenda.strClaFi3) Then
        Begin
          If (strCFOPDvAnt = '5917') Then
            fatVenda.strClaFi3 := '1917'
          Else
            fatVenda.strClaFi3 := '2917';
        End;

      End;

      frmFatDadosFiscais.Caption := frmFatDadosFiscais.Caption;
      frmFatDadosFiscais.blnPodeCancelar  := True;
      frmFatDadosFiscais.pAfterCalcTotGer := pAtualizarEditsTotais;

      If (fCfgSis('ESPDEV', varBoolean)) And (fCfgSis('FRDVES', varString) = '2') And (Pos(strOpcDoc, 'DV_') > 0) Then
      Begin
        intTipFre := fBuscaTipoFrete(cdsVenda.FieldByName('ITE_DOCDEV').AsString, cdsVenda.FieldByName('ITE_ESPDEV').AsString, cdsVenda.FieldByName('ITE_EMPDEV').AsString, cdsVenda.FieldByName('ITE_AIDVOR').AsString);
        If intTipFre In [1,3,9,4] Then
        Begin
          frmFatDadosFiscais.fraDadosFechamentoVendaTransportadoraFrame.cmbTipFre.Clear;
          For intTipFre In arrSemFrete Do
            frmFatDadosFiscais.fraDadosFechamentoVendaTransportadoraFrame.cmbTipFre.Items.Add(fDescricaoFrete(IntToStr(intTipFre)));
        End
        Else If intTipFre In [2,5] Then
        Begin
          frmFatDadosFiscais.fraDadosFechamentoVendaTransportadoraFrame.cmbTipFre.Clear;
          For intTipFre In arrComFrete Do
            frmFatDadosFiscais.fraDadosFechamentoVendaTransportadoraFrame.pAdicionaElementoFreteConta(fDescricaoFrete(IntToStr(intTipFre)));
          If (fatVenda.fGetTipoFreteSugestao = fTipoFrete('Sem Frete')) Then
            frmFatDadosFiscais.fraDadosFechamentoVendaTransportadoraFrame.pAdicionaElementoFreteConta(fDescricaoFrete(fTipoFrete('Sem Frete')));
        End;

      End;

      If (strOpcDoc = 'NE') And fCfgSis('NESTIN', varBoolean) And
         (dtaInicialNesTin > 0) And (opcNesTinSel <> opcVazio) Then
      Begin
        If (dtaInicialNesTin = dtaFinalNesTin) Or
           (dtaFinalNesTin = 0) Then
          strTextoMensagem := 'Referente a '+FormatDateTime('dd/mm/yyyy', dtaInicialNesTin)
        Else
          strTextoMensagem := 'Referente ao período de '+FormatDateTime('dd/mm/yyyy', dtaInicialNesTin)
                            + ' a '+FormatDateTime('dd/mm/yyyy', dtaFinalNesTin);

        strTextoMensagem := strTextoMensagem
                          + ', NOTA EMITIDA NOS TERMOS DA SFE 16/2010';

        fatVenda.strMen001 := strTextoMensagem;
      End;

      If (fCfgSis('ADONGF', varString) = 'S') AND (strOpcDoc = 'OF') Then
      Begin
        strTextoMensagem := fObterMensagemDocDev;

        fatVenda.strMen001 := strTextoMensagem;
      End;

      Result := fSolicitarEnderecoDeEntrega;

      If Result And (Not fEmptyStr(strNumOrc)) Then
        fatVenda.strCodTra := fatVenda.fVerificaTranspDoctoDifEndEntrega;

      If Result Then
      Begin
        {Não exibe a tela}
        If fatVenda.fEhVendaRapida(fatVenda.strCodCli) and (not fCfgSis('VRAMSG', varBoolean)) Then
        Begin
          frmFatDadosFiscais.pOnShow;
          frmFatDadosFiscais.btnConfirmaDados.Click;

          if not frmFatDadosFiscais.blnConfirma then
            frmFatDadosFiscais.ShowModal;
        End
        Else
          frmFatDadosFiscais.ShowModal;

        Result := frmFatDadosFiscais.blnConfirma;

        if (Result) and (Pos(strOpcDoc, 'VN_OU_CP_CF_') > 0) and (fVerificaDETEXPORTOuDrawback(fatVenda.strClaFis)) then
        begin
          Result := fatVenda.fInformarDrawbackPorItem(True);
        end;

        If (Result) And (Pos(fatVenda.strOpcDoc, 'DV_') > 0) Then
        Begin
          strClaSet := fCfgSis('CLASET', VarString);
          For intContItenNota := 0 To PRed(Length(fatVenda.arrMatItens)) Do
          Begin
            strClaFisIte := fRetornaClaFisDocumentoDevolucao(fatVenda.arrMatItens[intContItenNota].strDocDev,
                                                             fatVenda.arrMatItens[intContItenNota].strEspDev,
                                                             fatVenda.arrMatItens[intContItenNota].strEmpDev,
                                                             fatVenda.arrMatItens[intContItenNota].strAiDvOr);
            If (Pos(strClaFisIte, strClaSet) > 0) Then
            Begin
              fatVenda.arrMatItens[intContItenNota].strChaveAcesso := fRetChaveAcesso(fatVenda.arrMatItens[intContItenNota].strDocDev,
                                                                                      fatVenda.arrMatItens[intContItenNota].strEspDev,
                                                                                      fatVenda.strCodCli,
                                                                                      fatVenda.arrMatItens[intContItenNota].strEmpDev);

              fatVenda.arrMatItens[intContItenNota].fltQtItCo := fatVenda.arrMatItens[intContItenNota].fltQtdIte;
            End;
          End;
        End;
      End;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fConfirmaVenda_7]');
      End;
    End;

    pFreeAndNil(frmFatDadosFiscais);

    if (Result) and (fatVenda.strEspDoc = 'NF') and (not fEmptyStr(fatVenda.strCodTra))
       and (fVerificaItensComEntregaImediata) and (fCfgSis('UTICTE', varBoolean))
       and (fCampoTabela('TRA_CONHAB', 'CADTRA', ['TRA_CODTRA'], [fatVenda.strCodTra]) = 'S') then
    begin
      try
        Result := TfrmFatDadosCTe.Exibir(fatVenda);
      except
        On E: Exception do
        begin
          Result := False;
          pMensagensErro(E.Message, '[fConfirmaVenda_CTe]');
        end;
      end;
    end
    else
      fatVenda.objDadosCte.blnGrava := False;

    If (Pos(strOpcDoc, 'DV_') > 0) And (Not fatVenda.fValidaDevolucaoComFreteSuperiorAoDocumentoOriginal) Then
    Begin
      Result := False;
      Exit;
    End;

    If not fatVenda.fValidaBeneficioFiscal(strProdSemCodBeneficio) Then
    Begin
      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.Caption := 'ATENÇÃO';
        frmObservacao.lblMensagem.Caption := 'Os seguintes itens estão sem o código do benefício fiscal preenchido.';
        frmObservacao.memObs.Texto := strProdSemCodBeneficio + #13#10 + 'Preencha o código do benefício na abreviação de ICMS.';
        frmObservacao.ShowModal;
      Finally
        pFreeAndNil(frmObservacao);
      End;

      Result := False;
    End;

    If not fatVenda.fValidaCreditoPresumido(strProdutosFaltandoCreditoPresumido) Then
    Begin
      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.Caption := 'ATENÇÃO';
        frmObservacao.lblMensagem.Caption := 'Verifique o código do benefício fiscal e a alíquota de crédito presumido dos itens abaixo:';
        frmObservacao.memObs.Texto := strProdutosFaltandoCreditoPresumido + #13#10 + 'Preencha essas informações na abreviação de ICMS ou no cadastro de NCM.';
        frmObservacao.ShowModal;
      Finally
        pFreeAndNil(frmObservacao);
      End;

      Result := False;
    End;

    {******************************************}
    {* VERIFICA SE É PERMITIDO TRANSFERÊNCIA  *}
    {* DE ESTOQUE PARA O CLIENTE SELECIONADO  *}
    {***************************************RV*}
    If (Pos(strOpcDoc, 'OU_OV_') > 0) And (fatVenda.strPerEmpTe <> 'S') And
       fatVenda.blnCliFil And (Pos(fatVenda.strClaFis, '5152_6152_5409_6409_') > 0) Then
    Begin
      Result := False;
      fMensagem('ATENÇÃO!', 'Transferência de Estoque não permitida para este cliente!', ['&O k']);
    End;

    {******************************************}
    {* CASO CANCELOU A TELA DOS DADOS FISCAIS *}
    {***************************************MV*}
    If (Not Result) Then
      Exit;

    If (Result) And
       (Pos(strOpcDoc, 'NE_OE_OU_OV_' + IIF(fatVenda.fEhOutrasEntradasFornecedorComDocumentoVinculado, 'EF_', '') + IIF(Not fatVenda.fTemItensDevolucao, 'OF_', '')) > 0) And
       ((Pos(fatVenda.strClaFis, VS_strClaDev) > 0) Or (Pos(fatVenda.strClaFis, CFOP_DEVOLUCAO) > 0) Or (Pos(fatVenda.strClaFis, fTransform(fCfgSis('CLAOSF', varString), 4)) > 0)) And
       (fCfgSis('NFEUSA', varBoolean)) And
       (Not fJaInformouChaveOutrasSaidas) And
       ((FileExists(ExtractFilePath(Application.ExeName) + '\nfe.310')) Or (fCfgSis('VERNFE') = '4.00')) Then
    Begin
      Try
        pCriarFormularios(TfrmFatDigChaveDev, frmFatDigChaveDev);
        frmFatDigChaveDev.edtChave.Text  := fatVenda.strChaveNFeRefDevolucao;
        frmFatDigChaveDev.edtNumCOO.Text := fatVenda.strNumCOONFeRefDevolucao;
        frmFatDigChaveDev.edtNumSer.Text := fatVenda.strNumSerNFeRefDevolucao;
        frmFatDigChaveDev.edtCodNSU.Text := fatVenda.strNumUSUNFeRefDevolucao;

        If fEmptyStr(fatVenda.strTipDocNfeRefDevolucao) Then
          fatVenda.strTipDocNfeRefDevolucao := 'N';

        frmFatDigChaveDev.blnAtualizaForm := False;

        If fatVenda.strTipDocNfeRefDevolucao = 'N' Then
          frmFatDigChaveDev.rdgDocVen.ItemIndex := 0
        Else If fatVenda.strTipDocNfeRefDevolucao = 'C' Then
          frmFatDigChaveDev.rdgDocVen.ItemIndex := 1
        Else  // TIPDOC = E
          frmFatDigChaveDev.rdgDocVen.ItemIndex := 2;

        if (strOpcDoc = 'OF') and (Pos(fatVenda.strClaFis, fTransform(fCfgSis('CLAOSF', varString), 4)) > 0) then
          frmFatDigChaveDev.FTipoChave := tcReferencia;

        frmFatDigChaveDev.blnAtualizaForm := True;
        frmFatDigChaveDev.ShowModal;

        If frmFatDigChaveDev.ModalResult = mrOk Then
        Begin
          If frmFatDigChaveDev.rdgDocVen.ItemIndex = 0 Then
            fatVenda.strTipDocNfeRefDevolucao := 'N'
          Else If frmFatDigChaveDev.rdgDocVen.ItemIndex = 1 Then
            fatVenda.strTipDocNfeRefDevolucao := 'C'
          Else
            fatVenda.strTipDocNfeRefDevolucao := 'E';

          If (frmFatDigChaveDev.rdgDocVen.ItemIndex = 0) Or
             (frmFatDigChaveDev.rdgDocVen.ItemIndex = 2) Then
          Begin
            fatVenda.strNumCOONFeRefDevolucao := '';
            fatVenda.strNumSerNFeRefDevolucao := '';
            fatVenda.strNumUSUNFeRefDevolucao := '';
            fatVenda.strNumDocNFeRefDevolucao := '';
            fatVenda.strChaveNFeRefDevolucao  := frmFatDigChaveDev.edtChave.Text;

            Result := (Not fEmptyStr(fatVenda.strChaveNFeRefDevolucao));

            if (frmFatDigChaveDev.FTipoChave = tcReferencia) and fEmptyStr(fatVenda.strChaveNFeRefDevolucao) then
              Result := True;
          End
          Else
          Begin
            fatVenda.strChaveNFeRefDevolucao  := '';
            fatVenda.strNumCOONFeRefDevolucao := frmFatDigChaveDev.edtNumCOO.Text;
            fatVenda.strNumSerNFeRefDevolucao := frmFatDigChaveDev.edtNumSer.Text;
            fatVenda.strNumUSUNFeRefDevolucao := frmFatDigChaveDev.edtCodNSU.Text;

            If (Length(fatVenda.strNumCOONFeRefDevolucao) > 6) And
               (LeftStr(fatVenda.strNumCOONFeRefDevolucao,3) <> '000') Then
               fMensagem('INFORMAÇÃO','Atenção! Na emissão deste tipo de nota fiscal é referenciado o '+
                                      'número do COO do cupom. O IF devolvido possui mais que 6 dígitos '+
                                      'válidos nesta informação e atualmente o sistema envia apenas 6 na '+
                                      'tag "NFE-REF-ECF". Por favor, entre em contato com a Citel antes de continuar.',['O K']);

            Result := (Not fEmptyStr(fatVenda.strNumCOONFeRefDevolucao)) And
                      (Not fEmptyStr(fatVenda.strNumSerNFeRefDevolucao)) And
                      (Not fEmptyStr(fatVenda.strNumUSUNFeRefDevolucao));

            if (frmFatDigChaveDev.FTipoChave = tcReferencia) and (fEmptyStr(fatVenda.strNumCOONFeRefDevolucao)) And
                                                                 (fEmptyStr(fatVenda.strNumSerNFeRefDevolucao)) And
                                                                 (fEmptyStr(fatVenda.strNumUSUNFeRefDevolucao)) then
              Result := True;

          End;
          If (Result) And (fatVenda.fUtilizarRotinaDeOutrasEntradasParaAnulacaoDeVendas) Then
          Begin
            fatVenda.strClienteDaChaveASerDevolvida := fatVenda.fGetClienteDaChaveASerDevolvida;
            fatVenda.pAtualizaClassTransferencias;
          End;
        End
        Else
        Begin
          Result := False;
        End;
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[]');
          Result := False;
        End;
      End;
      pFreeAndNil(frmFatDigChaveDev);
    End
    Else
    Begin
      If (Result) And (Not fatVenda.blnComVal) Then
      Begin
        fatVenda.strTipDocNfeRefDevolucao := '';
        fatVenda.strChaveNFeRefDevolucao  := '';
        fatVenda.strNumDocNFeRefDevolucao := '';
        fatVenda.strNumCOONFeRefDevolucao := '';
        fatVenda.strNumSerNFeRefDevolucao := '';
        fatVenda.strNumUSUNFeRefDevolucao := '';
      End;
    End;

    {**********************************}
    {* DIGITA OCORRÊNCIA DA DEVOLUÇÃO *}
    {*******************************RV*}
    If Result And fSolicitarDigitacaoDeOcorrencia Then
      Result := fDigOcorrencia;
  End
  Else If (Result) And MatchStr(strOpcDoc, ['DV']) And (StrToInt((LeftStr(fatVenda.strClaFis, 1))) < 5) Then
    Result := fDigOcorrencia;

  If Result And Self.blnNFSeSubstituicao Then
    Result := fSubstituicaoNotaServico;

end;

function TfrmFatVendas.fPedeDadosEmissaoOrcamento(): Boolean;
var
  frmFatDigMensagemOrc: TfrmFatDigMensagemOrc;
  LFreAnt: Double;
  LValidarAlteracoesOrcPosConfirmacao: Boolean;
begin
  Result := True;

  If (blnSatComplementar Or blnNFCeComplementar) Then
    Exit;

  If (fatVenda.strEspDoc = 'OR') Then
  Begin
    fatVenda.blnManterFreteRateadoItens := False;

    Try
      LValidarAlteracoesOrcPosConfirmacao := fEhOrcamentoComRateioDeFrete;

      if LValidarAlteracoesOrcPosConfirmacao and
        (not fHouveAlteracaoOrcamento) then
      begin
        fatVenda.fltFreDig := fatVenda.fRetornaSomaTotFreItensOri;
        fatVenda.blnManterFreteRateadoItens := True;
      end;

      LFreAnt := fatVenda.fltFreDig;

      pCriarFormularios(TfrmFatDigMensagemOrc, frmFatDigMensagemOrc);

      try
        frmFatDigMensagemOrc.blnPodeCancelar := True;
        frmFatDigMensagemOrc.qryFatGor := qryFatGor;
        frmFatDigMensagemOrc.fatVenda := fatVenda;

        If fEmptyStr(strProspe) Then
          Result := fSolicitarEnderecoDeEntrega
        Else
          fatVenda.blnPediuEnderecoEntrega := True; //Prospecto nao pede endereço de entrega.

        If Result And (Not fEmptyStr(strNumOrc)) Then
          fatVenda.strCodTra := fatVenda.fVerificaTranspDoctoDifEndEntrega;

        if (not fEmptyStr(fatVenda.strCodTra)) and (not fRetTransportadoraAtiva(fatVenda.strCodTra)) then
        begin
          fMensagem('', 'A Transportadora está inativada!', ['&Ok']);
          Result := False;
        end;

        If Result Then
        Begin
          frmFatDigMensagemOrc.fraTransportadora.strCodTra := fatVenda.strCodTra;

          {Não exibe a tela}
          If fatVenda.fEhVendaRapida(fatVenda.strCodCli) and (not fCfgSis('VRAMSG', varBoolean)) Then
          Begin
            frmFatDigMensagemOrc.pOnShow;
            frmFatDigMensagemOrc.btnConfirmaDados.Click;

            If Not frmFatDigMensagemOrc.blnConfirma Then
              frmFatDigMensagemOrc.showModal;
          End
          Else
            frmFatDigMensagemOrc.showModal;

          Result := frmFatDigMensagemOrc.blnConfirma;
        End;

        if (not Result) then
        begin
          fatVenda.blnManterFreteRateadoItens := False;
          fatVenda.fltFreDig := LFreAnt;
        end;

        if Result and LValidarAlteracoesOrcPosConfirmacao and
           ((fatVenda.fltFreDig <> LFreAnt) or fHouveAlteracaoOrcamento) then
        begin
          fatVenda.blnManterFreteRateadoItens := False;
          fMensagem('', 'O orçamento sofreu alterações e os valores serão recalculados. Com isso, o valor do frete definido anteriormente também será recalculado!', ['&Ok']);
        end;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '[fConfirmaVenda_6]');
      End;
    finally
      pFreeAndNil(frmFatDigMensagemOrc);
    end;
  End;
end;

function TfrmFatVendas.fPedeDadosEmissaoOutrasEspecies(): Boolean;
  Var
    frmFatDigMensagemGenerica : TfrmFatDigMensagemGenerica;
begin
  Result := True;

  If ((Pos(fatVenda.strEspDoc, 'MI_FF_BR_TR_DV_PR_IF_IV_D1_TE_UC_DD_CS_PA_') > 0) And (not blnSatComplementar) And (not blnNFCeComplementar)) Or (strOpcDoc = 'CI') Then
  Begin

    Try
      pCriarFormularios(TfrmFatDigMensagemGenerica, frmFatDigMensagemGenerica);

      frmFatDigMensagemGenerica.blnPodeCancelar := True;

      If ((fatVenda.strEspDoc = 'IF') And fatVenda.fPermiteFreteNoCupomFiscal) Or
         (strOpcDoc = 'CI')  Or ((strOpcDoc <> 'CI') And
         (Pos(fatVenda.strEspDoc,'MI_FF_DV_PR_') > 0)   And
         (fCfgSis('INFFRE', varBoolean)))  Then
        frmFatDigMensagemGenerica.pnlTransportadora.Visible := True
      Else
        frmFatDigMensagemGenerica.pnlTransportadora.Visible := False;

      If (strOpcDoc = 'CI') Then
        fatVenda.fltValFre := fatVenda.fltFreDig;

      If (Pos(fatVenda.strEspDoc, 'DV_PR_') > 0) Then
      Begin
        If (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
        Begin
          fatVenda.pCalculaFreteDespAcessDevolucaoFornecedor;
          fatVenda.fltFreDig := fatVenda.fltValFre;
          frmFatDigMensagemGenerica.edtValFre.Text := FormatFloat('#,##0.00', fatVenda.fltValFre);
          frmFatDigMensagemGenerica.edtDesAce.Text := FormatFloat('#,##0.00', fatVenda.fltDesAce);
        End;

        If (fatVenda.fltValFre = 0) Then
        Begin
          If (frmFatDigMensagemGenerica.pnlTransportadora.Visible) Then
          Begin
            fatVenda.strTipFre := IntToStr(fBuscaTipoFrete(cdsVenda.FieldByName('ITE_DOCDEV').AsString, cdsVenda.FieldByName('ITE_ESPDEV').AsString, cdsVenda.FieldByName('ITE_EMPDEV').AsString,  cdsVenda.FieldByName('ITE_AIDVOR').AsString));

            If Not fEmptyStr(fatVenda.strTipFre) Then
            Begin
              fatVenda.fltValFre := fatVenda.fRetornaValorFreteRateado(cdsVenda);
            End;
          End;

          If (fatVenda.fltValFre = 0) Then
            fatVenda.strTipFre := '9'
          Else
          Begin
            fatVenda.fltFreDig := fatVenda.fltValFre;
            fatVenda.fltFreteOriginalParaDevolucao := fatVenda.fltValFre;
          End;
        End
        Else
        Begin
          FVariaveisFechamentoVenda.strAuxTipFre:=fatVenda.fRetornaTipFre;
          If Not fEmptyStr(FVariaveisFechamentoVenda.strAuxTipFre) Then
            fatVenda.strTipFre := FVariaveisFechamentoVenda.strAuxTipFre;
        End;
      End;

      If (frmFatDigMensagemGenerica.pnlTransportadora.Visible) And (Not (strOpcDoc = 'CI')) Then
        frmFatDigMensagemGenerica.pnlDadosFrete.Visible := True
      Else
        frmFatDigMensagemGenerica.pnlDadosFrete.Visible := False;

      frmFatDigMensagemGenerica.pnlVolumes.Visible := (MatchStr(strOpcDoc,['CI','TR']));

      frmFatDigMensagemGenerica.fatVenda := fatVenda;

      if fEmptyStr(strProspe) Then
        Result := fSolicitarEnderecoDeEntrega
      Else
        fatVenda.blnPediuEnderecoEntrega := True; //Prospecto nao pede endereço de entrega.

      If Result And (Not fEmptyStr(strNumOrc)) Then
        fatVenda.strCodTra := fatVenda.fVerificaTranspDoctoDifEndEntrega;

      If Result Then
      Begin
        frmFatDigMensagemGenerica.showModal;
        Result := frmFatDigMensagemGenerica.blnConfirma;
      End;

      If Result Then
      Begin
        fatVenda.blnEhFechamentoVenda := True;
      End;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[fConfirmaVenda_6]');
    End;

    pFreeAndNil(frmFatDigMensagemGenerica);
  End;
end;

function TfrmFatVendas.fPedeDadosEmissaoPedidoVenda: Boolean;
begin
  Result := True;

  If Not fatVenda.fExibirTelaDadosDoPedido Then
    Exit;

  If Not fSolicitarEnderecoDeEntrega Then
    Exit(False);

  If Not fatVenda.fPedeDadosEmissaoPedidoVenda(qryFatGor, False) Then
    Exit(False);
end;

function TfrmFatVendas.fRealizarNovoFechamentoOrcamentoPedido(): Boolean;
begin
  Result := True;

  If Not fValidaDadosPedidoYapay() Then
    exit(False);

  If Not fValidaDadosPedidoPagarMe Then
    exit(False);

  If Not fDefineOpcoesDocumentoVendaMultiloja() Then
    Exit(False);

  If Not fPedeEspecieDocumentoParaFechamento() Then
    Exit(False);

  If (Not fPermitirUsarFormaDePagamentoDinheiro(strOpcDoc, fatVenda.strEspDoc, edtForPag.Text)) Then
    Exit(False);

  If (Not fEhOrcamentoPedido(strOpcDoc)) And (fVerificaItensComEntregaFutura) Then
  Begin
    If Not fVerificaDireitoAcessoVendaFuturaOR_PD_VN(strOpcDoc, fRetornaEspecieDocumento) Then
      Exit(False);
  End;

  If Not fAtribuiEspecieDocumentoSelecionadaParaObjVenda() Then
    Exit(False);

  If Not fVerificaObrigatoriedadeCpfCnpjParaEmissaoNotaFiscal() Then
    Exit(False);

  If Not fDefinirSeOrcamentoGravandoComoPedido() Then
    Exit(False);

  if not fValidaEnvioLinkPagamantoCndInicio then
    Exit(False) ;

  if fNovoOrcamentoFechandoEmPedido then
  begin
    If (Pos(strOpcDoc, 'OR_') > 0) And
       (fCfgSis('OINSPP', VarString) = 'S') And
       (fCfgSis('NUMSER', VarString) = 'S') Then
    Begin
      Result := fVerificarControleDeSerie;
      If Not Result Then
      Begin
        fMensagem('', 'Existem produtos com controle por série, mas sem a devida série informada!', ['&Ok']);
        Exit(False);
      End;
    End;
  end;

  If (fatVenda.fBloquearPercentualDescontoNoFechamentoDaVenda(fatVenda.fltPorDes))  Then
    Exit(False);

  If (fatVenda.fBloquearDescontoEspecialNoFechamentoDaVenda(fatVenda.fltDesEsp))  Then
    Exit(False);

  if not fValidaPedidoCompra then
    Exit(False);

  if (Pos(strOpcDoc, 'PD_OR_') > 0) then
    If Not fatVenda.fVerificaSeItensSemEstoqueIraGerarVendasPerdidas() Then
      Exit(False);

  If Not fPedeVoucherClubeDoPintor Then
    Exit(False);

  If Not fExibirTelaFinalizacaoNovoFechamentoOrcamentoPedido() Then
    Exit(False);
end;

