procedure TfrmFatvendas.pConsultaAlpe;
var
  objAlpeCondicao: TReceivablesSummaries;
  i, p: Integer;
begin
  objAlpeCondicao := TControllerReceivablesSummaries.fGet(fatVenda.strCliCgc);
  try
    if objAlpeCondicao <> nil then
    begin
      fatVenda.fltCreAlp := objAlpeCondicao.content[0].items[0].amount;

      for p := 0 to Length(objAlpeCondicao.content[0].relationship.properties)-1 do
      begin
        if objAlpeCondicao.content[0].relationship.properties[p].code = 'supplier-parcels' then
          mskCndPag.Text := fStrZero(objAlpeCondicao.content[0].relationship.properties[p].value[0].ToString,2);

        if objAlpeCondicao.content[0].relationship.properties[p].code = 'supplier-paymentTerm' then
          for i := 0 to Length(objAlpeCondicao.content[0].relationship.properties[p].value)-1 do
          begin
            mskCndPag.Text := mskCndPag.Text +
                              fStrZero(objAlpeCondicao.content[0].relationship.properties[1].value[i].ToString,3);
          end;
      end;

      edtDesCndPag.Text := fCampoTabela('CND_DESCRI', 'CADCND', ['CND_CODIGO'], [edtCodCnd.Text]) +
                           ' - Saldo Alpe: ' + Format('%m', [fatVenda.fltCreAlp]);
    end;
  finally
    FreeAndNil(objAlpeCondicao);
  end;
end;

procedure TfrmFatVendas.pConsultaAlpeLimiteBoleto;
var
  fltLimiteTotal,
  fltLimiteUtilizado,
  fltLimiteDisponivel,
  fltTotalDebito: Double;

  blnStopSupply: Boolean;
  blnFilPed: Boolean;

  strMsg,
  strPedidos: String;
begin
  fltLimiteTotal := 0.0;
  fltLimiteUtilizado := 0.0;
  fltLimiteDisponivel := 0.0;
  fatVenda.fltLimBolAlp := 0.0;
  fltTotalDebito := 0.0;

  if not TControllerPaymentProductsArrangements.fConsultaAlpeLimiteBoleto(fatVenda.strCliCgc,
                                                                          fltLimiteTotal,
                                                                          fltLimiteUtilizado,
                                                                          fltLimiteDisponivel,
                                                                          blnStopSupply,
                                                                          strMsg) then
  begin
    if blnStopSupply then
      edtDesCndPag.Text := fCampoTabela('CND_DESCRI', 'CADCND', ['CND_CODIGO'], [edtCodCnd.Text]) +
                           ' - StopSupply: '+strMsg;

    Exit;
  end;

  if fCfgSis('PDALLM', varBoolean) then
  begin
    strPedidos := strNumOrc;

    if not fEmptyStr(fatVenda.strNumDocsPD) then
      strPedidos := fatVenda.strNumDocsPD;

    blnFilPed := ((Pos(fatVenda.strOpcDoc, 'PD_VN_') > 0) And (fatVenda.strEspOrc = 'PD')) Or (Not fEmptyStr(fatVenda.strNumDocsPD));
    fltTotalDebito := fRetTotalPedidoVendaAberto(fatVenda.strCodCli, IIF(blnFilPed, strPedidos, ''), True);
  end;

  fltLimiteUtilizado := fltLimiteUtilizado + fltTotalDebito;
  fatVenda.fltLimBolAlp := fltLimiteDisponivel - fltTotalDebito;

  edtDesCndPag.Width := pnlCndPag.Width - 660;
  edtDesCndPag.Text := fCampoTabela('CND_DESCRI', 'CADCND', ['CND_CODIGO'], [edtCodCnd.Text]) +
                       ' - Limites Alpe -' +
                       ' Limite Total: '+Format('%m', [fltLimiteTotal])+
                       '   Limite Utilizado: '+Format('%m', [fltLimiteUtilizado])+
                       '   Limite Disponível: '+Format('%m', [fatVenda.fltLimBolAlp]);



end;

procedure TfrmFatVendas.pCarregaCondicao(blnVoltaFpgAnt: Boolean = False; blnAtualizaInformacoesCnd: Boolean = True);
  Var
    dtaBasTmp: TDateTime;
    strConTmp: String;
    strConAux: String;
    strTabPreAnt: string;
    strTabPrecoFat: string;
    intIndice: integer;
    frmFatSelecaoTabelaPreco: TfrmFatSelecaoTabelaPreco;

  function fZerarDescontoConcedidoNosItens(ACodCnd : String) : Boolean;
    const
      SQL = 'SELECT COUNT(*) AS TOT FROM CADCND WHERE (CND_DESMAX > 0) AND (CND_ABADES = "S") AND (CND_CODIGO = :CODIGO)';
    var
      qryAux : TUniQuery;
  begin

    Result := False;

    If Not (Pos(strOpcDoc,'OR_PD_VN_') > 0) Then
      Exit;

    If Not (fCfgSis('ZERDES', varBoolean)) Then
      Exit;

    If Not (fCfgSis('RECCND', varBoolean)) Then
      Exit;

    If Not (fCfgSis('CNDVEN') = 'I') Then
      Exit;

    qryAux := fCriaQuery();

    Try

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(SQL);
      qryAux.ParamByName('CODIGO').AsString := ACodCnd;
      qryAux.Open;

      Result := (Not qryAux.IsEmpty) And (qryAux.FieldByName('TOT').AsInteger > 0);

    Finally
      FreeAndNil(qryAux);
    End;

  end;

  procedure pZerarDescontoConcedidoNosItens;
  begin

    If cdsVenda.IsEmpty Then
      Exit;

    cdsVenda.DisableControls;

    Try

      cdsVenda.First;
      While Not cdsVenda.Eof Do
      Begin
        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_DESCON').AsFloat := 0;
        cdsVenda.Post;
        cdsVenda.Next;
      End;

    Finally
      cdsVenda.EnableControls;
    End;

  end;

begin

  edtDesCndPag.Width := intWidthDesCndInicial;

  If (Not fatVenda.fPermiteAlterarCondFormaPagtoConfNFConcreto) Then
    Exit;

  pPesquisaCadCnd(qryConCnd, qryConCnd, edtCodCnd.Text, 0, 0, False, edtCodCli.Text);
  If ( Not qryConCnd.IsEmpty ) Then
  Begin
    With qryConCnd Do
    Begin

      If fZerarDescontoConcedidoNosItens(edtCodCnd.Text) Then
      Begin
        pZerarDescontoConcedidoNosItens;
      End;

      If ( FieldByName('CND_TIPFOR').AsString = 'OUTROS' ) Then
      Begin
        mskCndPag.Enabled     := True;
        mskCndPag.Color       := clWindow;
        mskCndPag.NormalColor := clWindow;
      End
      Else
      Begin
        mskCndPag.Enabled     := False;
        mskCndPag.Color       := $00FFDFB8;
        mskCndPag.NormalColor := $00FFDFB8;
      End;

      {*******************RQ103411*}
      {* SO UTILIZAA A CONDIÇÃO   *}
      {* RETORNADA NA PESQUISA SE *}
      {* O CODIGO FOR DIFERENTE   *}
      {*************************FS*}
      If (FieldByName('CND_CODIGO').AsString <> strCodCndAnt) Then
        strConTmp := FieldByName('CND_CNDPAG').AsString
      Else
        strConTmp := strConAtu;
        
      If fEmptyStr(strConTmp) Then
        strConTmp := FieldByName('CND_CNDPAG').AsString;

      {******************************************************}
      {* MANTEM A CONDIÇÃO DE PAGAMENTO DO PEDIDO/ORÇAMENTO *}
      {***************************************************PZ*}
      If (Not fEmptyStr(fatVenda.strNumOrc))    And
         (Not fEmptyStr(fatVenda.strConPagOri)) And
         (fatVenda.fCarregaCondicaoPedido)      Then
      Begin
        If (FieldByName('CND_CODIGO').AsString <> strCodCndAnt) Then
          strConAtu := '';
          
        If (fEmptyStr(strConAtu)) Then
          strConTmp := fatVenda.strConPagOri
        Else
          strConTmp := strConAtu;
      End;

      If ((Not fEmptyStr(strCcnAnt)) And (strCcnAnt <> FieldByName('CND_CODIGO').AsString)) Or
         (fConPagFora(FieldByName('CND_TIPFOR').AsString)) Then
      Begin
        strConTmp := FieldByName('CND_CNDPAG').AsString;
      End;

      strConAux := '';

      If fatVenda.fUtilizarDataPrvDataFatComoDataBaseParaCalculoVencimento(FieldByName('CND_CODFPG').AsString) Then
        dtaBasTmp := fRetDataBaseCalculoCondicaoPagto(fatVenda.dtaPreVis, fatVenda.fFaturandoPedido, fatVenda.dtaDtaEntOri, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento)
      Else
        dtaBasTmp := fRetDataBaseCalculoCondicaoPagto(mskPreVis, fatVenda.fFaturandoPedido, fatVenda.dtaDtaEntOri, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento);

      If (SameText(FieldByName('CND_TIPFOR').AsString, 'OUTROS') And (fatVenda.blnMeiaNota)) and (strOpcDoc <> 'CO') Then
        mskCndPag.Text := FieldByName('CND_CNDPAG').AsString
      Else If (strOpcDoc = 'CO') and (not fEmptyStr(strConAtu)) Then
        mskCndPag.Text := strConAtu
      Else
      Begin
        If (fConPagFora(FieldByName('CND_TIPFOR').AsString)) Then
        Begin
          mskCndPag.Text := fRetCondicao(fatVenda.fRetConPagRef(FieldByName('CND_CODIGO').AsString),
                                         fatVenda.dtaUltDtaAlt,
                                         FieldByName('CND_CODIGO').AsString,
                                         FieldByName('CND_TIPFOR').AsString,
                                         strConTmp,
                                         dtaBasTmp,
                                         fatVenda.strOpcDoc,
                                         fatVenda.strCodCid);
          strConAux := mskCndPag.Text;
        End
        Else
          mskCndPag.Text := strConTmp;
      End;

      If Not fatVenda.fDocumentoParaFornecedor Then
      Begin
        If (fEmptyStr(strConAux)) And (Pos(FieldByName('CND_TIPFOR').AsString, 'OUTROS_') <= 0) Then
          strConAux := fRetConPagCodCnd(FieldByName('CND_CODIGO').AsString)
        Else
          strConAux := mskCndPag.Text;

        mskCndPag.Text := fRetCondicaoDiaFixoCliente(fatVenda.fRetConPagRef(FieldByName('CND_CODIGO').AsString),
                                                     fatVenda.dtaUltDtaAlt,
                                                     fatVenda.strCodCli,
                                                     strConAux,
                                                     dtaBasTmp,
                                                     fatVenda.strOpcDoc,
                                                     fatVenda.strCodCid);
      End;

      If fCfgSis('AJPZDF', VarBoolean) And (fatVenda.strOpcDoc = 'CP') Then
      Begin
        If (fConPagFora(fRetTipoForaConPag(fatVenda.strCodCndResolvidoEmConflito))) Or fClienteTemDiaFixo(fatVenda.strCodCli) Then
          If (fatVenda.strCodCndResolvidoEmConflito = qryConCnd.FieldByName('CND_CODIGO').AsString) Then
            mskCndPag.Text := fatVenda.strConPagResolvidoEmConflito;
      End;

      if (edtCodCnd.Visible) and
         (fCfgSis('USAALP', varBoolean)) and
         (edtCodCnd.Text = fCfgSis('CPGALP', varString)) then
        TfrmGravando.fExecutarModal(pConsultaAlpe, 'Aguarde, comunicando com a ALPE ...', '');

      if (edtCodCnd.Visible) and
         (fCfgSis('ALPKNK', varBoolean)) and
         (Pos(edtCodCnd.Text, fCfgSis('CNDBOL', varString)) > 0) then
        TfrmGravando.fExecutarModal(pConsultaAlpeLimiteBoleto, 'Aguarde, comunicando com a ALPE ...', '');

      If (strOpcDoc = 'CI') And (fCfgSis('INFIEL', varBoolean)) Then
      Begin
        If fatVenda.VS_blnUsaFpg And Not fEmptyStr(FieldByName('CND_CODFPG').AsString) Then
        Begin
          edtForPag.Text     := FieldByName('CND_CODFPG').AsString;
          edtForPag.ReadOnly := True;
          pCarregaForPag;
        End
        Else
          edtForPag.ReadOnly := False;
      End
      Else
      Begin
        If fatVenda.VS_blnUsaFpg And (Not fEmptyStr(FieldByName('CND_CODFPG').AsString)) Or (blnVoltaFpgAnt And (((strFpgAnt <> edtForPag.Text) And (Not fEmptyStr(strFpgAnt))))) Then
        Begin
          If (blnVoltaFpgAnt And (Not fEmptyStr(strFpgAnt))) Then
            edtForPag.Text := strFpgAnt
          Else
          Begin
            If (strOpcDoc = 'DV') And fCfgSis('DVVORI', varBoolean) And (fCfgSis('USACND', varBoolean)) Then
            Begin
              If (fStatusCndPag(mskCndPag.Text) = A_VISTA) Then
                edtForPag.Text := '001'
              Else
                edtForPag.Text := '008';
            End
            Else
              edtForPag.Text := FieldByName('CND_CODFPG').AsString;
          End;

          edtForPag.ReadOnly := True;

          pCarregaForPag;
        End
        Else
          edtForPag.ReadOnly := False;
      End;

      If Not fatVenda.fPermiteAlterarCondFormaPagtoPedido Then
        edtForPag.ReadOnly := True;

      strTabPrecoFat := fDevolveTabelaPrecoFaturamento(FieldbyName('CND_PRETAB').AsString);
      If (Not blnValidouTabPreCliMasNaoLiberouSenha) And
         (Not fEmptyStr(Trim(StringReplace(FieldbyName('CND_PRETAB').AsString,'N','',[rfReplaceAll, rfIgnoreCase])))) And
         (blnAtualizaTabPreCnd) And (((Pos(fatVenda.strTabPre,strTabPrecoFat) <= 0) and (not blnMudouTabelaPreco)) Or (strCcnAnt <> edtCodCnd.Text)) Then
      begin
        if (Length(strTabPrecoFat) = 1) then
        begin
          strMultiTabPreAtu := strTabPrecoFat;
        end;

        if (Length(strTabPrecoFat) > 1) and (not blnChamouTelaTabelaPreco) then
        begin
          try
            blnChamouTelaTabelaPreco := True;
            pCriarFormularios(TfrmFatSelecaoTabelaPreco,frmFatSelecaoTabelaPreco);
            frmFatSelecaoTabelaPreco.cbbTabPre.Clear;
            frmFatSelecaoTabelaPreco.cbbTabPre.Items.Add('');
            for intIndice := 1 to Length(strTabPrecoFat) do
            begin
              frmFatSelecaoTabelaPreco.cbbTabPre.Items.Add(strTabPrecoFat[intIndice]);
            end;
            frmFatSelecaoTabelaPreco.cbbTabPre.ItemIndex := 0;
            frmFatSelecaoTabelaPreco.ShowModal;
            if frmFatSelecaoTabelaPreco.ModalResult = mrOk then
            begin
              strTabPrecoFat := frmFatSelecaoTabelaPreco.cbbTabPre.Text;
              strMultiTabPreAtu := strTabPrecoFat;
            end;
          finally
            pFreeAndNil(frmFatSelecaoTabelaPreco);
          end;
        end;

        if length(strTabPrecoFat) = 1 then
        begin
          strTabPreAnt := fatVenda.strTabPre;
          strTabPre       := strTabPrecoFat;

          If (cbTabPreco.Items.IndexOf(strTabPre) < 0) And (Not fEmptyStr(strTabPre)) Then
          Begin
            cbTabPreco.Items.Add(strTabPre);
          End;

          cbTabPreco.Text    := strTabPre;

          If Not fValidaCampos(cbTabPreco, True) Then
          Begin
            strTabPre         := strTabPreAnt;
            strTabPrecoFat    := strTabPreAnt;
            strMultiTabPreAtu := strTabPreAnt;
          End;

          If (blnChamouTelaTabelaPreco) And
             (Not fEmptyStr(strTabPre)) And
             (Not cbTabPreco.Visible) And
             (strTabPre <> fatVenda.strTabPre) Then
          Begin
            fatVenda.strTabPre := strTabPre;
          End;
        end;
      End;

      fatVenda.strCodCnd := FieldByName('CND_CODIGO').AsString;
      if not fCondicaoDePagamentoAlpe then
        edtDesCndPag.Text  := FieldByName('CND_DESCRI').AsString;

      fatVenda.strDesCnd := FieldByName('CND_DESCRI').AsString;

      ValidacoesCondicaoPagamentoPix;

      {*Req.202377**********RP*}
      If blnAtualizaInformacoesCnd Then
        fatVenda.pAtualizaInformacoesCondPagamento(qryConCnd);

    End;
  End
  Else
    edtDesCndPag.Clear;
end;

function TfrmFatVendas.fCondicaoDePagamentoAlpe: Boolean;
begin
  Result := False;

  if fEmptyStr(edtCodCnd.Text) then
    Exit;

  if (fCfgSis('USAALP', varBoolean)) And (edtCodCnd.Text = fCfgSis('CPGALP', varString)) then
    Exit(True);

  if (fCfgSis('ALPKNK', varBoolean)) And (Pos(edtCodCnd.Text, fCfgSis('CNDBOL', varString)) > 0) then
    Exit(True);
end;

