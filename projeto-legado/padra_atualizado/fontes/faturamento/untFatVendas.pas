{*****************************************}
{* GERA QUANTAS NOTAS FISCAIS FOREM NE-  *}
{* CESSÁRIAS PARA QUE NÃO HAJA DESDOBRO. *}
{**************************************MV*}
function TfrmFatVendas.fGravaNotasFormAvulso: Boolean;
  Var
    arrTotFre: Array Of Double;
    arrDesAce: Array Of Double;
    arrDesEsp: Array Of Double;
    arrNumDoc: Array Of String;
    arrDupRec: Array Of Double;
    arrValAdt: Array Of Double;

    fltTotFre: Double;
    fltDesAce: Double;
    fltDesEsp: Double;
    fltDupRec: Double;
    fltValAdt: Double;

    arrMatItens : TMatrizFechamento;

    intIteNot: Integer;
    intQtdFol: Integer;
    intContador: Integer;
    intContItens: Integer;
    intIndice: Integer;
    fltTotIte: Double;
    fltFator: Double;
    intQtdIteNotaAtual: Integer;

begin

  Result := False;
  intIndice := 0;
  intIteNot := fCfgSis('ITENOT', varInteger);
  intQtdFol := Ceil(Length(fatVenda.arrMatItens) / intIteNot);
  SetLength(arrMatItens, Length(fatVenda.arrMatItens));

  SetLength(arrTotFre, intQtdFol);
  SetLength(arrDesAce, intQtdFol);
  SetLength(arrDesEsp, intQtdFol);
  SetLength(arrNumDoc, intQtdFol);
  SetLength(arrDupRec, intQtdFol);
  SetLength(arrValAdt, intQtdFol);

  {*****************************************}
  {* FAZ UMA CÓPIA DA MATRIZ DE ITENS E JÁ *}
  {* RATEIA OS VALORES.                    *}
  {**************************************MV*}
  fltTotIte := 0.0;
  For intContador := Low(fatVenda.arrMatItens) To High(fatVenda.arrMatItens) Do
  Begin
    arrMatItens[intContador] := fatVenda.arrMatItens[intContador];

    fltTotIte := fltTotIte + arrMatItens[intContador].fltTotIte;

    If ((intContador > 0) And ( ((intContador+1) Mod intIteNot) = 0 )) Or
       (intContador = High(fatVenda.arrMatItens))                    Then
    Begin
      fltFator := (fltTotIte / fatVenda.fltTotPro);

      arrTotFre[intIndice] := fFormataFloat(fltFator * fatVenda.fltValFre, 2);
      arrDesAce[intIndice] := fFormataFloat(fltFator * fatVenda.fltDesAce, 2);
      arrDesEsp[intIndice] := fFormataFloat(fltFator * fatVenda.fltDesEsp, 2);
      arrDupRec[intIndice] := fFormataFloat(fltFator * fatVenda.fltDupRec, 2);
      arrValAdt[intIndice] := fFormataFloat(fltFator * fatVenda.fltValAdt, 2);

      fltTotIte := 0.0;
      Inc(intIndice);
    End;

  End;

  {*****************************************}
  {* REALIZA ACERTO DE DIFERENÇA DE CENTA- *}
  {* VOS.                                  *}
  {**************************************MV*}
  fltTotFre := 0.0;
  fltDesAce := 0.0;
  fltDesEsp := 0.0;
  fltDupRec := 0.0;
  fltValAdt := 0.0;

  For intContador := Low(arrTotFre) To High(arrTotFre) Do
  Begin
    fltTotFre := fltTotFre + arrTotFre[intContador];
    fltDesAce := fltDesAce + arrDesAce[intContador];
    fltDesEsp := fltDesEsp + arrDesEsp[intContador];
    fltDupRec := fltDupRec + arrDupRec[intContador];
    fltValAdt := fltValAdt + arrValAdt[intContador];
  End;

  If (fFormataFloat(fltTotFre, 2) <> fFormataFloat(fatVenda.fltValFre, 2)) Then
    arrTotFre[0] := arrTotFre[0] + (fatVenda.fltValFre - fltTotFre);

  If (fFormataFloat(fltDesAce, 2) <> fFormataFloat(fatVenda.fltDesAce, 2)) Then
    arrDesAce[0] := arrDesAce[0] + (fatVenda.fltDesAce - fltDesAce);

  If (fFormataFloat(fltDesEsp, 2) <> fFormataFloat(fatVenda.fltDesEsp, 2)) Then
    arrDesEsp[0] := arrDesEsp[0] + (fatVenda.fltDesEsp - fltDesEsp);

  If (fFormataFloat(fltDupRec, 2) <> fFormataFloat(fatVenda.fltDupRec, 2)) Then
    arrDupRec[0] := arrDupRec[0] + (fatVenda.fltDupRec - fltDupRec);

  If (fFormataFloat(fltValAdt, 2) <> fFormataFloat(fatVenda.fltValAdt, 2)) Then
    arrValAdt[0] := arrValAdt[0] + (fatVenda.fltValAdt - fltValAdt);

  Try
    {*****************************************}
    {* GERA AS NOTAS, DEIXANDO CADA NOTA COM *}
    {* A QUANTIDADE EXATA DE ITENS QUE CABEM *}
    {* NO FORMULARIO AVULSO.                 *}
    {**************************************MV*}
    fatVenda.blnComTansacao      := False;
    fatVenda.blnImprimeDocs      := False;
    fatVenda.blnFormularioAvulso := True;
    fatVenda.intGrpNot           := StrToInt(fRetSequencial('GRPNOT', VS_strCodEmp));

    fatVenda.objFatVendaImp.pLimparDocumentos;

    fStartTransaction;

    intIndice := 0;
    For intContador := Low(arrTotFre) To High(arrTotFre) Do
    Begin

      SetLength(fatVenda.arrMatItens, 0);
      If (intContador < High(arrTotFre)) Then
        intQtdIteNotaAtual := intIteNot
      Else
        intQtdIteNotaAtual := (Length(arrMatItens) - intIndice);

      SetLength(fatVenda.arrMatItens, intQtdIteNotaAtual);

      For intContItens := 0 To intQtdIteNotaAtual-1 Do
      Begin
        fatVenda.arrMatItens[intContItens] := arrMatItens[intIndice];
        Inc(intIndice);
      End;

      fatVenda.fltValFre := arrTotFre[intContador];
      fatVenda.fltDesAce := arrDesAce[intContador];
      fatVenda.fltDesEsp := arrDesEsp[intContador];
      fatVenda.fltDupRec := arrDupRec[intContador];
      fatVenda.fltValAdt := arrValAdt[intContador];

      fatVenda.pDestacaRetencoes;
      fatVenda.pRetemImpostosNoDescontoEspecial;
      pCalculaTotGer(False, True, False);
      fatVenda.pDestacaRetencoes;  //Necessario para calcular as retencoes dos servicos
      fatVenda.pCalculaTotalParaCadRec;
      pAtualizarEditsTotais;

      fatVenda.pRateiaValores;

      fDigDuplic(fatVenda.arrDuplicata, fatVenda.strConPag, 0,
         fatVenda.fltTotCadRec - fatVenda.fltValAdt,
         False, True, False, fatVenda.dtaDigDup, False, fatVenda.fltImpFre, 'N',
         fCfgSis('DUPRED', varBoolean), True, fatVenda.fltValAdt, True,
         Nil,  //  arrValores
         '',   //  strEspDoc
         True, //  True
         True, //  True;
         fatVenda.pMostraContaCorrenteCliente);

      If fatVenda.fltValAdt > 0 Then
      Begin
        If Not fatVenda.fAdicionaAdiantamentoPrimeiraParcela Then
        Begin
          Result := False;
          fRollBack;
          Exit;
        End;
      End;

      Try
        pCriarFormularios(TfrmGravando,frmGravando);
        frmGravando.strChave := 'FATVENDAS';
        frmGravando.fExecutarAcao := fatVenda.fGravaArquivos;
        frmGravando.lblGravando.Caption := 'Aguarde, Gravando ' + IntToStr(intContador+1) + 'ª Nota';
        frmGravando.ShowModal;
        Result := frmGravando.blnConfirma;

        arrNumDoc[intContador] := fatVenda.strNumDoc;

        pFreeAndNil(frmGravando);

        If (Not Result) Then
        Begin
          fRollBack;
          Exit;
        End;

      Except
        On E: Exception Do
        Begin
          Result := False;
          fRollBack;
          pMensagensErro(IntToStr(intContador+1) + 'ª nota: ' + E.Message, '[fConfirmaVenda - frmGravando]');
          pFreeAndNil(frmGravando);
          Exit;
        End;
      End;

    End;

    fCommit;

  Except
    On E: Exception Do
    Begin
      Result := False;
      fRollBack;
    End;
  End;

  {*****************************************}
  {* CASO OCORREU TUDO OK, REALIZA AS IM-  *}
  {* PRESSÕES.                             *}
  {**************************************MV*}
  If Result Then
  Begin

    Try
      For intContador := 0 To fatVenda.objFatVendaImp.ItemsCount -1 Do
      Begin
        fMensagem('ATENÇÃO','INCLUA O FORMULÁRIO DA NOTA (' + fatVenda.objFatVendaImp[intContador].strNumDoc + ') ' +
                  'E TECLE ENTER PARA CONTINUAR!',['&OK']);
        fatVenda.objFatVendaImp.pImprimeNotaFiscal(fatVenda.objFatVendaImp[intContador]);
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro('Erro durante a impressão: ' + E.Message, '[fGravaNotasFormAvulso_1]');
      End;
    End;

    pAgruparDuplicatasDeNotaAvulsa(fatVenda, arrNumDoc);

  End;

end;

