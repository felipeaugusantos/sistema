function TfrmFatVendas.fConfirmaDadosCabecalho: Boolean;
  function fVaiFinalizarAutomaticamente():Boolean;
  var
    strOpcDocPerm: String;
  begin
    strOpcDocPerm := 'CI_CT_CP_OV_CN_';

    If (fCfgSis('DESICF', VarString) = 'N') Then
      strOpcDocPerm := strOpcDocPerm + 'CF_';

    Result := (Pos(strOpcDoc, strOpcDocPerm) > 0) Or
              (
                (Pos(strOpcDoc, 'CF_') > 0) And
                cdsVenda.IsEmpty And
                fatVenda.fPossuiServico
              );
  end;
begin
  Result := True;

  blnConfirmandoDadosCabecalho := True;

  Try
    If(Pos(strOpcDoc, 'TE_OF_') > 0) And (blnCarregouRemessa) Then
      Exit;

    If (Pos(strOpcDoc,'DV_PR_OF_EF_') > 0) Then
    Begin
      If (pnlVendedor.Visible) And
         (Not fEmptyStr(edtSenVen.Text)) And
         (MatchStr(fatVenda.strOpcDoc, ['DV'])) And
         (Not fValidaCampos(edtSenVen, True)) Then
        Exit(False);

      Try
        pCriarFormularios(TfrmGravando, frmGravando);
        frmGravando.fExecutarAcao := fDigDadosDevolucao;
        frmGravando.ShowModal;
        Result := frmGravando.blnConfirma;
        blnDesativaConfirmaDadosCabecalho := frmGravando.blnConfirma;

        If (Pos(strOpcDoc, 'OF_') > 0) And (Not fEmptyStr(strNumRemessa)) Then
        begin
          pIncluiItemRemessaDevolucao;
          blnCarregouRemessa := True;
          Exit;
        end;

      Except
        On E: Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message, '');
        End;
      End;
      pFreeAndNil(frmGravando);

      If Result And VS_strHabilitarCRM And (fatVenda.strOpcDoc = 'DV') And (fCfgSis('UTI_AD', varString) = 'S') And (Not blnLiberouADComSenha) Then
      Begin
        dtaEntImediata := VS_Date;

        Try
          pVerificaSeDevolucaoEhDestinadaAColetaDeProdutosPorGarantia;

          pCriarFormularios(TfrmGravando, frmGravando);
          frmGravando.fExecutarAcao := fatVenda.fCarregaItensDevolucaoAD;
          frmGravando.ShowModal;
          Result := frmGravando.blnConfirma;
        Finally
          If (Not Result) Then
          Begin
            blnOperadorConfirmouQuestaoSeEhColetaPorGarantia := False;
            fatVenda.blnColeta  := False;
          End;
          pFreeAndNil(frmGravando);
        End;

        pIncluirTodosItensNaListaConsulta;
        pIncluirTodosItensNaListaConsultaTintadeMaquina;

        pAtualizaTemporaria;
        pCalculaTotais;
      End;

    End
    Else If (Pos(strOpcDoc, 'DD_') > 0) Then
    Begin
      Result := fatVenda.fMostraDocDevDemonstracao;

      If (Result) Then
        Result := fCarregaItensDevDemonstracao;
    End
    Else If fVaiFinalizarAutomaticamente Then
    Begin
      pEnabledFechamento(True);

      If fCfgSis('DESCFF', varBoolean) And (strOpcDoc = 'CF') And (fValidaPodeUsarDescontoEspecial(True)) Then
      begin
        btnFechaComDesc.Click;
      end
      else
      begin
        btnConfirma.Click;
      end;
    End
    Else If (Pos(strOpcDoc, 'TE_') > 0) And (Not fEmptyStr(strNumRemessa)) Then
    Begin
      pIncluiItemRemessaDevolucao;
      blnCarregouRemessa := True;
    End
    Else
    Begin

      If (fCfgSis('USASER', varBoolean)) Then
      Begin

        If fCfgSis('TIPNFS') = '1' Then
        Begin
          If Pos(strOpcDoc, 'OR_PD_VN_CS__OU_OV_OE_EF_') > 0 Then
            pEnabledFechamento(True);
        End
        Else If Pos(strOpcDoc,'VS_PD_OR_CF_CP_OV_') > 0 Then
          pEnabledFechamento(True);
      End;

    End;
  Finally
    blnConfirmandoDadosCabecalho := False;
  End;
end;

