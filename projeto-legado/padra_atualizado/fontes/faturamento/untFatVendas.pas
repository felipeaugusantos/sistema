function TfrmFatVendas.fLocalizarDescricaoItem(FindOption: TFindOption): Boolean;
  Var
    intRecNoAtual: Integer;
    stlPalavras: TStringList;
    blnWasEnabled: Boolean;
    prcScroll: TprcScroll;
begin
  If cdsVenda.IsEmpty Then
    Exit(False);

  Result := False;
  intRecNoAtual := cdsVenda.RecNo;
  blnWasEnabled := Not cdsVenda.ControlsDisabled;

  stlPalavras := fGetPalavrasBuscaPorDescricao;
  Try
    If stlPalavras.Count = 0 Then
      Exit(False);

    If blnWasEnabled Then
      pDisableControls(cdsVenda, prcScroll);

    If FindOption = foFindFirst Then
      cdsVenda.First;

    If FindOption = foFindNext Then
      If cdsVenda.RecordCount = cdsVenda.RecNo Then
        Exit(False)
      Else
        cdsVenda.Next;

    While Not cdsVenda.Eof Do
    Begin
      If fAtendeFiltroDescricaoItem(stlPalavras, fDescricaoItemParaLocalizar) Then
        Exit(True);
      cdsVenda.Next;
    End;

    If cdsVenda.RecordCount = cdsVenda.RecNo Then
      Result := fAtendeFiltroDescricaoItem(stlPalavras, fDescricaoItemParaLocalizar);
  Finally
    If Not Result Then
      cdsVenda.RecNo := intRecNoAtual;
    If blnWasEnabled Then
      pEnableControls(cdsVenda, prcScroll);
    stlPalavras.Free;
  End;
end;

