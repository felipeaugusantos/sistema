function TfrmFatVendas.fRetQtdDigitadaDevolucao: Double;
  Var
    strAutInc: String;
    cdsDados: TUniClientDataSet;
begin
  cdsDados := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  Result := 0.0;

  If fAlterandoProduto Then
  Begin
    cdsDados.Locate('AUTOINCREM', btnAdicionar.Tag, []);
    strAutInc := cdsDados.FieldByName('ITE_INCDEV').AsString
  End
  Else
    strAutInc := qryConDev.FieldByName('DET_AUTOIN').AsString;

  cdsDados.First;

  While (Not cdsDados.Eof) Do
  Begin
    If strAutInc <> cdsDados.FieldByName('ITE_INCDEV').AsString Then
    Begin
      cdsDados.Next;
      Continue;
    End;

    Result := Result + cdsDados.FieldByName('ITE_QTDITE').AsFloat;
    cdsDados.Next;
  End;

  FreeAndNil(cdsDados);
end;

