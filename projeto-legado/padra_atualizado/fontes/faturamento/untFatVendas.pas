  blnInsertTmp := False;
end;

procedure TfrmFatVendas.dbgItensDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
  Var
    blnOrdPro: Boolean;
    strTexto : String;
    strPalavra: String;
    stlPalavras: TStringList;
    blnUsaCorSelDif: Boolean;

  function fLinhaSelecionada: Boolean;
  begin
    Result := ((gdSelected In State) Or (gdRowSelected In State)) And (dbgItens.Focused);
  end;

begin
  inherited;

  If cdsVenda = nil Then
    Exit;

  blnOrdPro := False;
  blnUsaCorSelDif := False;

  If Not cdsVenda.IsEmpty Then
  Begin
    If blnSemEstoque And (Not pnlSemEstoque.Visible) Then
    Begin
      pnlSemEstoque.Visible := Column.Field.DataSet.FieldByName('ITE_SEMEST').AsString = 'S';
    End;

    If (Not blnConsMovPro) And (Not fEmptyStr(strNumOrc) And (strEspOrc = 'PD')) And (blnUsaOrdPro) Then
    Begin
      blnOrdPro := Not fEmptyStr(Column.Field.DataSet.FieldByName('ITE_ORDPRO').AsString);
    End;

    If Not fPodeAlterarItemOutroVendedor(IIF(fEmptyStr(edtSenVen.Text), '', fatVenda.strCodVen),
                                         cdsVenda.FieldByName('ITE_CODVEN').AsString, False) Then
    Begin
      dbgItens.Canvas.Font.Color := clGray;
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
    End

    Else If (pnlSemEstoque.Visible) And
            (Column.Field.DataSet.FieldByName('ITE_SEMEST').AsString = 'S') Then
    Begin
      dbgItens.Canvas.Font.Color := clRed;
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
    End

    Else If (pnlValFor.Visible) And
            (Column.Field.DataSet.FieldByName('ITE_DTAVAL').AsDateTime < fNow) Then
    Begin
      If dbgItens.Canvas.Brush.Color <> clHighlight Then
      Begin
        dbgItens.Canvas.Font.Color := clNavy;
        dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
      End;
    End

    Else If blnOrdPro Then
    begin
      pnlOrdPro.Visible          := True;
      dbgItens.Canvas.Font.Color := clPurple;
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);

      If lstOrdemProd.IndexOf(Column.Field.DataSet.FieldByName('AUTOINCREM').AsString) = -1 Then
        lstOrdemProd.Add(Column.Field.DataSet.FieldByName('AUTOINCREM').AsString);
    End

    Else If (cdsVenda.FindField('FLG_STATUS') <> Nil)           And
            (cdsVenda.FieldByName('FLG_STATUS').AsString = 'C') Then
    begin
      pnlProdCampanha.Visible    := True;
      dbgItens.Canvas.Font.Color := clBlue;
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);

      If lstProdCampanha.IndexOf(Column.Field.DataSet.FieldByName('ITE_CODITE').AsString) = -1 Then
        lstProdCampanha.Add(Column.Field.DataSet.FieldByName('ITE_CODITE').AsString);
    End

    Else If (cdsVenda.FindField('FLG_STATUS') <> Nil)           And
            (cdsVenda.FieldByName('FLG_STATUS').AsString = 'B') Then
    begin
      pnlProdBonus.Visible := True;
      dbgItens.Canvas.Font.Color := clGreen;
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);

      If lstProdBonus.IndexOf(Column.Field.DataSet.FieldByName('ITE_CODITE').AsString) = -1 Then
        lstProdBonus.Add(Column.Field.DataSet.FieldByName('ITE_CODITE').AsString);
    End;

    If (cdsVenda.FieldByName('ITE_ESCPRD').AsInteger = 1) Then
    Begin
      dbgItens.Canvas.Font.Color := shpEscPrd.Brush.Color;
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
    End;

    If (cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') and (Column.Field.DataSet.FieldByName('ITE_SEMEST').AsString <> 'S') Then
    Begin
      If (Not fatVenda.blnCliFil) Or ((fatVenda.blnCliFil) And (PRECOS_TE_PROMOC.Contains(fatVenda.recDadCli.strTEPPRO))) Then
      Begin
        If (fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior) And
           (cdsVenda.FieldByName('ITE_UNITAR').AsFloat > cdsVenda.FieldByName('ITE_UNIORI').AsFloat) Then
        Begin
          dbgItens.Canvas.Font.Color := shpPromoUnitarMaior.Brush.Color;
          If Not pnlPromoUnitarMaior.Visible Then
            pnlPromoUnitarMaior.Visible := True;
        End
        Else
        Begin
          dbgItens.Canvas.Font.Color := clTeal;
          If Not pnlPromo.Visible Then
            pnlPromo.Visible := True;
        End;

        dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
      End;

      blnUsaCorSelDif := True;
    End;

    If (Column.FieldName = 'ITE_VARTAB') Then
    Begin
      If fFormataFloat(Column.Field.AsFloat, 2) < 0.00 Then
      Begin
        dbgItens.Canvas.Font.Color := clRed;
        dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
      End;
    End;

    If ((cdsVenda.RecNo Mod 2) = 0) And
       ((cdsVenda.RecNo <> Self.intRecNo) Or (Not dbgItens.Focused)) Then
    Begin
      dbgItens.Canvas.Brush.Color := strToIntDef(fCfgSis('CORZEB'), clMoneyGreen);
      dbgItens.Canvas.FillRect(Rect);
      dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
    End;

    If (Column.FieldName = 'ITE_QTDITE') And (Self.Enabled) And
       (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(cdsVenda.FieldByName('ITE_CODITE').AsString) = -1) Then
    Begin
      If (cdsVenda.FieldByName('ITE_SEQCOM').AsInteger = 0) And //não é combo
         (fatVenda.fGetUnitarioEmbalagemFechada(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                cdsVenda.FieldByName('ITE_TABPRE').AsString,
                                                cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                                cdsVenda.FieldByName('ITE_UNIORI').AsFloat) > 0) Then
      Begin
        If Not pnlQtdEmbFec.Visible Then
          pnlQtdEmbFec.Visible := True;

        If dbgItens.Canvas.Brush.Color <> clHighlight Then
        Begin
          dbgItens.Canvas.Brush.Color := clYellow;
          dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
        End;
      End;
    End;

    If fItemSelecionadoTemAbastecimentoEmAndamento() Then
    Begin
      pnlAbastecimento.Visible   := True;
      dbgItens.Canvas.Font.Color := shpAbastecimento.Brush.Color;
      dbgItens.DefaultDrawColumnCell(Rect, DataCol, Column,State);
    End;

    If (Column.Field.FieldName = 'ITE_NOMVEN') And Assigned(stlVendedores) Then
    Begin
      If stlVendedores.IndexOf(cdsVenda.FieldByName('ITE_NOMVEN').AsString) = -1 Then
        stlVendedores.Add(cdsVenda.FieldByName('ITE_NOMVEN').AsString);

      If stlVendedores.IndexOf(cdsVenda.FieldByName('ITE_NOMVEN').AsString) <= High(VENDEDORES_COLORS) Then
      Begin
        dbgItens.Canvas.Brush.Color := VENDEDORES_COLORS[stlVendedores.IndexOf(cdsVenda.FieldByName('ITE_NOMVEN').AsString)];

        If (fCalcularContraste(dbgItens.Canvas.Brush.Color, clBlack) > 125) Then
          dbgItens.Canvas.Font.Color := clBlack
        Else If (fCalcularContraste(dbgItens.Canvas.Brush.Color, clWhite) > 125) Then
          dbgItens.Canvas.Font.Color := clWhite
        Else
          dbgItens.Canvas.Font.Color := clBlack;

        dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
      End;
    End;

    If (dbgItens.Focused) Then
    Begin
      If ((Not blnRowSelect) And (Rect.Top = TStringGrid(dbgItens).CellRect(0, TStringGrid(dbgItens).Row).Top)) Or
         ((blnUsaCorSelDif) And (fLinhaSelecionada)) Then
      Begin
        dbgItens.Canvas.FillRect(Rect);

        If ((blnUsaCorSelDif) And (fLinhaSelecionada)) Then
          dbgItens.Canvas.Font.Style := [fsBold];

        dbgItens.Canvas.Font.Color := clWhite;
        dbgItens.Canvas.Brush.Color := clHighlight;
        dbgItens.DefaultDrawColumnCell(Rect,DataCol,Column,State);
      End;
    End;

    If (Column.Field.DataSet.FieldByName('ITE_DESCON').AsFloat < 0.00) Then
    Begin
      strTexto := '';

      If (Column.FieldName = 'ITE_DESCON') Then
      Begin
        strTexto := FormatFloat(TFloatField(Column.Field.DataSet.FieldByName('ITE_DESCON')).DisplayFormat, 0.00);
      End

      Else If (Column.FieldName = 'ITE_UNIDIG') Then
      Begin
        strTexto := FormatFloat(TFloatField(Column.Field.DataSet.FieldByName('ITE_UNIDIG')).DisplayFormat,
                                            Column.Field.DataSet.FieldByName('ITE_UNITAR').AsFloat);
      End;

      If Not fEmptyStr(strTexto) Then
      Begin
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Right - dbgItens.Canvas.TextWidth(strTexto) - 2, Top + 2, strTexto);
      End;
    End;

    If (Column.FieldName = 'ITE_ENTRET') Then
    Begin
      strTexto := Column.Field.AsString;

      If strTexto = 'E' Then
      Begin
        If Column.Field.DataSet.FieldByName('ITE_ENTFUT').AsString = 'S' Then
          strTexto := 'E.F'
        Else
          strTexto := 'E.I';
      End;

      If strTexto = 'R' Then
      Begin
        If Column.Field.DataSet.FieldByName('ITE_LOCRET').AsString = 'C' Then
          strTexto := 'R.C';

        If Column.Field.DataSet.FieldByName('ITE_LOCRET').AsString = 'E' Then
          strTexto := 'R.E';

        If Column.Field.DataSet.FieldByName('ITE_LOCRET').AsString = 'B' Then
          strTexto := 'R.B';

        If Column.Field.DataSet.FieldByName('ITE_LOCRET').AsString = 'B2' Then
          strTexto := 'R.B2';
      End;

      dbgItens.Canvas.FillRect(Rect);
      dbgItens.Canvas.TextOut(Rect.Left + 3, Rect.Top + 2, strTexto);
    End

    Else If (Column.FieldName = 'ITE_SOBENC') Then
    Begin
      dbgItens.Canvas.Font.Color := clBlack;

      If (Column.Field.AsString = 'S') Then
      Begin
        pnlSobEncomenda.Visible   := True;
        dbgItens.Canvas.Brush.Color := shpSobEncomenda.Brush.Color;
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'SIM');
      End
      Else
      Begin
        If (fLinhaSelecionada) And (Not blnUsaCorSelDif) Then
          dbgItens.Canvas.Font.Color := clWhite;

        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'NÃO');
      End;
    End

    Else If (Column.FieldName = 'ITE_SITUAC') Then
    Begin
      dbgItens.Canvas.Font.Color  := clBlack;

      If (Column.Field.AsString = 'B') Then
      Begin
        dbgItens.Canvas.Brush.Color := clYellow;
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'BRINDE');
      End
      Else If (Column.Field.AsString = 'C') Then
      Begin
        dbgItens.Canvas.Brush.Color := clAqua;
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'COMBO');
      End
      Else If (Column.Field.AsString = 'P') Then
      Begin
        dbgItens.Canvas.Brush.Color := clSkyBlue;
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'PROMO');
      End
      Else If (Column.Field.AsString = 'T') Then
      Begin
        dbgItens.Canvas.Brush.Color := clLime;
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'TINTA');
      End
      Else If (Column.Field.AsString = 'N') Then
      Begin
        //dbgItens.Canvas.Brush.Color := clYellow;
        dbgItens.Canvas.FillRect(Rect);
        dbgItens.Canvas.TextOut(Rect.Left + 5, Rect.Top + 2, 'NORMAL');
      End;
    End

    Else If pnlPesquisarDescricao.Visible And 'ITE_CODITE_ITE_DESITE_ITE_CODFAB'.Contains(Column.FieldName) Then
    Begin
      stlPalavras := fGetPalavrasBuscaPorDescricao;
      Try
        If fAtendeFiltroDescricaoItem(stlPalavras, fDescricaoItemParaLocalizar) Then
          For strPalavra In stlPalavras Do
            HighlightCellText(TDBGridCitel(Sender), Rect, Column, strPalavra, State, clYellow, clYellow, clNavy);
      Finally
        FreeAndNil(stlPalavras);
      End;
    End;
  End;

end;

