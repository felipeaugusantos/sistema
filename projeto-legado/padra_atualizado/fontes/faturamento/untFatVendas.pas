function TfrmFatVendas.fExisteLigacaoAgendada(strCodCli, strCodVen: string;
  dtaDtaAgendamento: TDateTime): Boolean;
var
  qryAgenda: TUniQuery;
begin
  Result := False;

  qryAgenda := fCriaQuery;

  try
    qryAgenda.Close;
    qryAgenda.SQL.Clear;
    qryAgenda.SQL.Add('SELECT * FROM AGETEL');
    qryAgenda.SQL.Add('WHERE AGE_CODCLI = :CODCLI');
    qryAgenda.SQL.Add('AND AGE_CODVEN = :CODVEN');
    qryAgenda.SQL.Add('AND AGE_DTAAGE = :DTAAGE');
    qryAgenda.SQL.Add('AND AGE_DTABAI IS NULL');
    qryAgenda.SQL.Add('AND AGE_HORBAI IS NULL');

    qryAgenda.ParamByName('CODCLI').AsString := strCodCli;
    qryAgenda.ParamByName('CODVEN').AsString := strCodVen;
    qryAgenda.ParamByName('DTAAGE').AsDate := dtaDtaAgendamento;

    qryAgenda.Open;

    if not qryAgenda.IsEmpty then
      Result := True;
  finally
    FreeAndNil(qryAgenda);
  end;
end;

function TfrmFatVendas.fExisteLotesDistintosParaUmMesmoItem(strCodIte, strNumLot: String): Boolean;
Var
  cdsDados : TUniClientDataSet;
begin
  Result := False;
  cdsDados := TUniClientDataSet.Create(Nil);

  Try
    pCloneDataSet(cdsDados, cdsVenda);

    With cdsDados Do
    Begin
      Filtered := False;
      Filter := 'ITE_CODITE = ' + QuotedStr(strCodIte);
      Filtered := True;

      While not Eof Do
      Begin
        If strNumLot <> FieldByName('ITE_NUMLOT').AsString Then
        Begin
          Result := True;
          Break;
        End;

        Next;
      End;

    End;

  Finally
    FreeAndNil(cdsDados);
  End;
End;

function TfrmFatVendas.fValidaLotesDistintosParaUmMesmoItem: Boolean;
Var
  cdsDados : TUniClientDataSet;
  sltItems : TStringList;
begin
  Result := False;
  cdsDados := TUniClientDataSet.Create(Nil);
  sltItems := TStringList.Create;

  Try
    pCloneDataSet(cdsDados, cdsVenda);

    With cdsDados Do
    Begin

      While not Eof Do
      Begin
        If fProdutoRastreavel(FieldByName('ITE_CODITE').AsString) Then
        Begin
          If fExisteLotesDistintosParaUmMesmoItem(FieldByName('ITE_CODITE').AsString,
                                                  FieldByName('ITE_NUMLOT').AsString) Then
          Begin
            sltItems.Add(FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' - Lote: ' + FieldByName('ITE_NUMLOT').AsString);
            Result := True;
          End;
        End;

        Next;
      End;

      If Result Then
      Begin
        Try
          pCriarFormularios(TfrmObservacao, frmObservacao);
          frmObservacao.Caption := 'Não é permitido o mesmo produto com lotes diferentes para cliente filial utilizando WMS';
          frmObservacao.lblMensagem.Caption := 'Relação de produtos iguais com lotes diferentes:';
          frmObservacao.Width := 850;
          frmObservacao.memObs.Font.Size := 8;
          frmObservacao.memObs.Texto := sltItems.Text;
          frmObservacao.ShowModal;
        Finally
          pFreeAndNil(frmObservacao);              
        End;

      End;

    End;

  Finally
    FreeAndNil(cdsDados);
    FreeAndNil(sltItems);
  End;
End;

function TfrmFatVendas.fOperacaoVaiDeixarValorVendaMenorQueDescontoEspecial(blnDeletandoItem: Boolean=False): Boolean;
  Var
    blnInserindoItem: Boolean;
    fltTotalPrevisto: Double;
    fltDesEspLocal: Double;
begin
  Result := False;

  If Assigned(fatVenda) Then
  Begin
    blnInserindoItem := (btnAdicionar.Tag = 0);

    If (fatVenda.blnHerancaOrcamentoPedido) And (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin
      fltDesEspLocal := qryFatGor.FieldByName('FGO_DESESP').AsFloat;

      If (fltDesEspLocal > 0) Then
      Begin
        If blnDeletandoItem Then
        Begin
          fltTotalPrevisto := fStrToFloat(edtTotImp.Text) - cdsVenda.FieldByName('ITE_TOTITE').AsFloat;
        End
        Else If blnInserindoItem Then
        Begin
          fltTotalPrevisto := fStrToFloat(edtTotImp.Text) + fStrToFloat(edtTotIte.Text);
        End
        Else
        Begin
          fltTotalPrevisto := (fStrToFloat(edtTotImp.Text) - cdsVenda.FieldByName('ITE_TOTITE').AsFloat) + fStrToFloat(edtTotIte.Text);
        End;

        If (fFormataFloat(fltTotalPrevisto, 4) = 0) Then
          fltTotalPrevisto := fatVenda.fltTotPro;

        If (fFormataFloat(fltDesEspLocal, 4) >= fFormataFloat(fltTotalPrevisto, 4)) Then
        Begin
          Result := True;
          If fMensagem('Atenção!', 'O valor do Desconto Especial: '+FormatFloat('#,##0.00', fFormataFloat(fltDesEspLocal, 2))+
                                   ', supera ou iguala o valor da venda!'+#10#13+
                                   'Deseja continuar com a alteração e remover o desconto?', ['&Sim', '&Não']) = 1 Then
          Begin
            Result := False;
            blnHerancaOrcamentoPedidoZerandoDesconto := True;
          End;
        End;
      End;
    End;
  End;
end;

function TfrmFatVendas.fValidaPodeAlterarItemComRequisicao(blnDelete: Boolean = False): Boolean;
