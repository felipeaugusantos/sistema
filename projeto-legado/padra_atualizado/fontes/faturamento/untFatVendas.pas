function TfrmFatVendas.fValidarMultiploVendaNoFinal(): Boolean;
var
  intRecNo: Integer;
  lstItensTrava: TListaItemTravaMultiploVenda;
  blnEhEmbalagem : Boolean;
  objCadIte : IMyCampoTabela;

  function fSaldoDisponivelDoItem():Double;
  var
    strEmpSalResT: String;
    strEmpCarT: String;
    fltSaldoItemAtuT: Double;
    fltSaldoResItemAtuT: Double;
    fltQtdeDigitadaT: Double;
  begin
    strEmpSalResT := IIF(fatVenda.blnEmpFat, cdsVenda.FieldByName('ITE_EMPITE').AsString, fatVenda.fEmpresaSaldoMatriz_CD);
    strEmpCarT := cdsVenda.FieldByName('ITE_EMPCAR').AsString;

    fltSaldoItemAtuT := cdsVenda.FieldByName('ITE_SALDOS').AsFloat;


    fltSaldoResItemAtuT := TSaldoReservado.New(
                             TReservaParametros.New()
                               .EmpresaItem(IIF(fatVenda.blnEmpFat, cdsVenda.FieldByName('ITE_EMPITE').AsString, ''))
                               .NumeroDocumento(fatVenda.strNumOrc)
                               .CodigoItem(cdsVenda.FieldByName('ITE_CODITE').AsString)
                               .CodEmpresa(strEmpSalResT)
                               .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                               .CodItemAcabado(IIF((cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR') And (Not fEmptyStr(cdsVenda.FieldByName('ITE_CODACA').AsString)), cdsVenda.FieldByName('ITE_CODACA').AsString, ''))
                               .EmpItemAcabado(IIF((cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR') And (Not fEmptyStr(cdsVenda.FieldByName('ITE_CODACA').AsString)), cdsVenda.FieldByName('ITE_EMPACA').AsString, ''))
                               .NumeroLote(fRetNumLoteSeAdequado(strEmpSalResT, cdsVenda.FieldByName('ITE_NUMLOT').AsString, cdsVenda.FieldByName('ITE_CODITE').AsString))
                               .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                           ).fGetQuantidade();

    fltQtdeDigitadaT := fatVenda.fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                fRetNumLoteSeAdequado(strEmpSalResT, cdsVenda.FieldByName('ITE_NUMLOT').AsString, cdsVenda.FieldByName('ITE_CODITE').AsString),
                                                cdsVenda.FieldByName('AUTOINCREM').AsString,
                                                '',
                                                '',
                                                cdsVenda.FieldByName('ITE_EMPITE').AsString);

    Result := fFormataFloat(fltSaldoItemAtuT - fltSaldoResItemAtuT - fltQtdeDigitadaT, fCfgSis('DECQTD', VarInteger));
  end;

  function fRetornaTipMltVenDoItem():String;
  begin
    Result := '';

    //Embalagem
    If (blnEhEmbalagem) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) then
      Exit(fCfgSis('QPDMVC'));

    //Brindes
    If (strOpcDoc = 'BR') Or (cdsVenda.FieldByName('ITE_BRINDE').AsString = 'S') Then
      Exit(fCfgSis('MLTVBR'));

    //Pedido, orçamento, vendas, devolução
    If Pos(strOpcDoc, 'PD_OR_VN_DV_') > 0 Then
      Exit(fCfgSis('MLTVEN'));

    //Outras saidas
    Result := fCfgSis('MLTVOU');
  end;

  function fDesconsideraMultiploVendaItem(Const intNfeSti: Integer):Boolean;
  begin

    Result := True;

    If ((strOpcDoc = 'NE') And (TOpcItensNFespTinta(intNFESTI) = opcBasesColorantesSemDestaqueImpostos) And (fCfgSis('NFTIES') = '2')) Then
      Exit;

    If ((blnEhEmbalagem) and (fCfgSis('QPDMVC') = '2')) Then
      Exit;

    If (objCadIte.FieldByName('ITE_CAREST').AsString = 'S') And fCfgSis('MLTEST', varBoolean) Then
      Exit;

    Result := False;
  end;

  function fPermiteVenderSaldoRemanecenteItem(Const fltQtdDig: Double):Boolean;
  begin
    If (Not fCfgSis('REMMLT', varBoolean)) Then
      Exit(False);

    Result := SameValue(fltQtdDig, fSaldoDisponivelDoItem());
  end;

  procedure pInicializaLiberacaoTrava();
  begin
    objLiberacao.Clear;

    objLiberacao.strDirAce := 'SENMTP';
    objLiberacao.strSenLib := fCfgSis('SENMTP');
    objLiberacao.strMsgSen := 'Senha para liberação de venda de item com quantidade fora do múltiplo de venda';
    objLiberacao.strCodOpe := fatVenda.strCodVen;
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.strCliente := fatVenda.strCodCli + '-' + fRetNomCliente(fatVenda.strCodCli);
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
  end;

  procedure pValidaItem();
  var
    strTipMltVen: String;
    strCodIteT: String;
    strDesIteT: String;
    fltQtdDigT: Double;
    fltMltVenT: Double;
    intDecQtd: Integer;
    fltResto: Double;
  begin
    blnEhEmbalagem := (Not fEmptyStr(cdsVenda.FieldByName('ITE_BAREMB').AsString));

    strTipMltVen := fRetornaTipMltVenDoItem();

    If (strTipMltVen = '2') Then
      Exit;

    intDecQtd := fCfgSis('DECQTD', varInteger);

    strCodIteT := cdsVenda.FieldByName('ITE_CODITE').AsString;
    strDesIteT := cdsVenda.FieldByName('ITE_DESITE').AsString;
    fltQtdDigT := fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, intDecQtd);

    objCadIte := fCadIte(strCodIteT);

    fltMltVenT := fFormataFloat(objCadIte.FieldByName('ITE_MLTVEN').AsFloat, intDecQtd);

    If (fltMltVenT <= 0) Then
      Exit;

    fltResto := Frac(fFormataFloat(fltQtdDigT / fltMltVenT, intDecQtd));

    If (fFormataFloat(fltResto, intDecQtd) = 0) Then
      Exit;

    If CompareValue(fFormataFloat(fltResto, intDecQtd), 0) = EqualsValue Then
      Exit;

    If fatVenda.lstItensLiberadosTravaMultiploVenda.fExiste(strCodIteT, fltQtdDigT, fltMltVenT) Then
      Exit;

    If fDesconsideraMultiploVendaItem(cdsVenda.FieldByName('ITE_NFESTI').AsInteger) Then
      Exit;

    If (Pos(strTipMltVen, '1_4_') > 0) And (fPermiteVenderSaldoRemanecenteItem(fltQtdDigT)) Then
      Exit;


    lstItensTrava.fAdd(strCodIteT,
                       strDesIteT,
                       fltMltVenT,
                       fltQtdDigT,
                       strTipMltVen);
  end;

  procedure pExibeItensComDivergencia(strMensagem: String);
  begin
    pCriarFormularios(TfrmObservacao, frmObservacao);
    Try
      frmObservacao.Caption := 'Itens com divergência no múltiplo de vendas ';
      frmObservacao.lblMensagem.Visible := False;
      frmObservacao.memObs.Text := strMensagem;
      frmObservacao.memObs.SelStart := 0;
      frmObservacao.Width := 700;
      frmObservacao.ShowModal;
    Finally
      pFreeAndNil(frmObservacao);
    End;
  end;
begin
  Result := True;

  If (cdsVenda.IsEmpty) Then
    Exit;

  If (fNotaFiscalEspiritoSanto()) Then
    Exit;

  intRecNo := cdsVenda.RecNo;
  cdsVenda.DisableControls;

  lstItensTrava := TListaItemTravaMultiploVenda.Create;

  Try
    cdsVenda.First;
    While (Not cdsVenda.Eof) do
    Begin
      pValidaItem();
      cdsVenda.Next;
    End;

    If (lstItensTrava.fExisteItens(ttTrava)) Then
    Begin
      pExibeItensComDivergencia(lstItensTrava.fGetMensagem(ttTrava));
      Exit(False);
    End;

    If (lstItensTrava.fExisteItens(ttAvisa)) Then
    Begin
      pExibeItensComDivergencia(lstItensTrava.fGetMensagem(ttAvisa));
    End;

    If (lstItensTrava.fExisteItens(ttLibera)) Then
    Begin
      pInicializaLiberacaoTrava();
      lstItensTrava.fGetMensagem(ttLibera, objLiberacao);

      Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
    End;

  Finally
    cdsVenda.RecNo := intRecNo;
    cdsVenda.EnableControls;

    FreeAndNil(lstItensTrava);
  End;
end;

