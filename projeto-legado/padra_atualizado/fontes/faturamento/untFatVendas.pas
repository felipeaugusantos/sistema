function TfrmFatVendas.AbreTelaParaPagamentoDoPix: Boolean;
  Var
    LDadosPix: TUniClientDataSet;

    LDadosRequisicaoPixAVista: TDadosRequisicaoPixAVista;

    LErro,
    LRetornoJson,
    LAutoIncremChavePix: String;

    LValorDoPedido: Double;
begin
  Result := True;

  If not MatchStr(fatVenda.strOpcDoc, ['VN', 'CF', 'CP']) Then
    Exit;

  if (fatVenda.strOpcDoc = 'VN') and (fatVenda.strEspDoc = 'PD') then
    Exit ;

  If Assigned(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
  Begin
    If TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(fatVenda.DadosPixDaVenda.ObjetoPixPago) THen
    Begin
      If FormatFloat(',0.00', fatVenda.DadosPixDaVenda.ObjetoPixPago.Valor) =
         FormatFloat(',0.00', fatVenda.DadosPixDaVenda.ObjetoPixPago.ValorPago) Then
        Exit;
    End;
  End;

  If Not fatVenda.DadosPixDaVenda.GerarPixDaVenda Then
    Exit;

  LDadosRequisicaoPixAVista := TDadosRequisicaoPixAVista.Create;

  Try
    LDadosPix := TUniClientDataSet.Create(Nil);

    If fatVenda.DadosPixDaVenda.TxIdPix.IsEmpty Then
    Begin
      LDadosRequisicaoPixAVista := TFuncoesPixAutcom.RetornaDadosRequisicaoPedido(fatVenda,
                                                                                  fatVenda.fltValOrd);

      LAutoIncremChavePix := fCfgSis('CHAPIX');

      LDadosRequisicaoPixAVista.TextoItemShipay := LDadosRequisicaoPixAVista.SolicitacaoPagador;
      LDadosRequisicaoPixAVista.UtilizaShipay := TPixDao.ChavePixUtilizaShipay(LAutoIncremChavePix);
      LDadosRequisicaoPixAVista.UtilizaTefScope := TPixDao.ChavePixUtilizaTefScope(LAutoIncremChavePix);
      LDadosRequisicaoPixAVista.TipoCobranca := 'instantanea';

      FDadosRequisicaoPix := TFuncoesPix.RetornaJsonDadosRequisicao(LDadosRequisicaoPixAVista);

      If Not fatVenda.objCopiaSegVenda.Habilitado Then
      Begin
        fatVenda.objCopiaSegVenda.Habilitado := fatVenda.strNumOrc.IsEmpty And
                                                fatVenda.strNumDoc.IsEmpty;
        fatVenda.objCopiaSegVenda.PixNaTela := 'S';
      End;

      fatVenda.objCopiaSegVenda.pAtualizarDadosGerais;
      fatVenda.objCopiaSegVenda.pAtualizarDadosItensPixQRCode;

      LRetornoJson := TFuncoesPixAutcom.PagarPixViaQRCodeGerandoNovoPix(LAutoIncremChavePix,
                                                                        FDadosRequisicaoPix,
                                                                        FDadosRetornoPix,
                                                                        fatVenda.strCodCli,
                                                                        False,
                                                                        TFuncoesPixAutcom.RetornaChaveDaVenda(fatVenda, Self.Caption),
                                                                        fatVenda.fltTotGer,
                                                                        IIF(fatVenda.strOpcDoc = 'CF', CONF_DOCS_SIMPLES, ''));

    End
    Else
    Begin
      LDadosPix := TPixDao.RetornaDadosDoPix(qryFatGor.FieldByName('FGO_TX_PIX').AsString,
                                             qryFatGor.FieldByName('FGO_EMPPIX').AsString);

      LValorDoPedido := fatVenda.fltTotGer;
      If fCfgSis('USABRI', varBoolean) THen
      Begin
        If fatVenda.fltTotProBri > 0 Then
          LValorDoPedido := LValorDoPedido - fatVenda.fltTotProBri;
      End;

      If fFormataFloat(LDadosPix.FieldByName('MPX_VALPIX').AsFloat, 2) <> fFormataFloat(LValorDoPedido, 2) Then
      Begin
        fMensagem('ATENÇÃO', 'Esse pedido já possui Pix gerado com um valor diferente do fechamento da venda.' + #13 +
                             'Para realizar o pagamento desse pedido, o valor do fechamento deve ser o mesmo registrado pelo Pix ' +
                             'ou deve ser removida a cobrança Pix do pedido.', ['&Ok']);

        Exit(False);
      End;

      If MatchStr(LDadosPix.FieldByName('MPX_STATUS').AsString, STATUS_PIX_PAGO) Then
      Begin
        fMensagem('ATENÇÃO', 'Esse QRCode já está recebido no Autcom.' + #13 +
                             'Recarregue o pedido para atualizar os dados.', ['&Ok']);

        Exit(False);
      End;

      FDadosRequisicaoPix := LDadosPix.FieldByName('MPX_JSOENV').AsString;

      LRetornoJson := TFuncoesPixAutcom.PagarPixViaPorQRCode(LDadosPix,
                                                             Self.Name,
                                                             True);
    End;

    LErro := TFuncoesPix.RetornaMensagemErroRequisicao(LRetornoJson);
    If Not LErro.IsEmpty Then
      Raise ExceptionAutcom.Create(LErro);

    FDadosRetornoPix := LRetornoJson;

    fatVenda.DadosPixDaVenda.ObjetoPixPago := TFuncoesPix.RetornaDadosDoRetornoPixConsulta(FDadosRetornoPix,
                                                                                           FDadosRequisicaoPix);

    Result := TFuncoesPixAutcom.PixPagoComValorOMesmoValorDaCobranca(fatVenda.DadosPixDaVenda.ObjetoPixPago);

    If Result Then
    Begin
      fatVenda.DadosPixDaVenda.ObjetoPixPago.JsonRetorno := FDadosRetornoPix;
      fatVenda.DadosPixDaVenda.ObjetoPixPago.JSonRequisicao := FDadosRequisicaoPix;
      fatVenda.DadosPixDaVenda.ObjetoPixPago.AutoIncremChavePix := fCfgSis('CHAPIX');
      fatVenda.DadosPixDaVenda.ObjetoPixPago.RecebidoPeloF11 := 'N';
      fatVenda.DadosPixDaVenda.ObjetoPixPago.CodigoPortador := TPixDao.Create.RetornaPortadorChavePix(fatVenda.DadosPixDaVenda.ObjetoPixPago.AutoIncremChavePix);
      fatVenda.DadosPixDaVenda.ObjetoPixPago.CriadoPelo := 'VENDA';

      fatVenda.DadosPixDaVenda.ObjetoPixPago.PlanoDeContas := fCfgSis('CTAPIX');
      If fatVenda.DadosPixDaVenda.ObjetoPixPago.PlanoDeContas.IsEmpty Then
        fatVenda.DadosPixDaVenda.ObjetoPixPago.PlanoDeContas := fCfgSis('CTATRA');

      If Not LDadosPix.IsEmpty Then
      Begin
        fatVenda.DadosPixDaVenda.ObjetoPixPago.AutoIncremMovPix := LDadosPix.FieldByName('AUTOINCREM').AsString;
        fatVenda.DadosPixDaVenda.ObjetoPixPago.CodigoPortador := LDadosPix.FieldByName('POR_CODPOR').AsString;
      End;

      If fatVenda.DadosPixDaVenda.TxIdPix.IsEmpty Then
      Begin
        If fatVenda.DadosPixDaVenda.ObjetoPixPago.SolicitacaoPagador.IsEmpty Then
        Begin
          fatVenda.DadosPixDaVenda.ObjetoPixPago.SolicitacaoPagador := LDadosRequisicaoPixAVista.SolicitacaoPagador;
          fatVenda.DadosPixDaVenda.ObjetoPixPago.NomeDevedor := LDadosRequisicaoPixAVista.NomeDevedor;
          fatVenda.DadosPixDaVenda.ObjetoPixPago.CPFCNPJDevedor := LDadosRequisicaoPixAVista.CPFCNPJDevedor;
        End;
      End;

      If fatVenda.DadosPixDaVenda.ObjetoPixPago.CodigoDoCaixa.IsEmpty Then
        fatVenda.DadosPixDaVenda.ObjetoPixPago.CodigoDoCaixa := fatVenda.strCodigoCaixa;

      fatVenda.DadosPixDaVenda.RecebidoPorPix := 'S';

      If pnlCndPag.Visible Then
        ValidacoesCondicaoPagamentoPix;
    End;

    TFuncoesPixAutcom.CarregaListaPixCriadoEmTela(fatVenda.DadosPixDaVenda.ListaPixGeradosNaTelaQRCode);

    If Not Result Then
      fMensagem('ATENÇÃO', 'O recebimento do Pix por QRCode não foi realizado. ' +
                           IIF(fEmptyStr(fRetornaTxPix),
                               #13 + 'Assim o registro do Pix não foi gerado.', ''), ['&Ok']);
  Finally
    FreeAndNil(LDadosPix);
  End;
end;

