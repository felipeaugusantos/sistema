procedure TfrmFatVendas.pAtualizaPedidoDeCompraDigitado;
  var
    intCont: Integer;
begin
  for intCont := 0 to Length(fatVenda.arrMatItens) -1 do
  begin
    if cdsVenda.Locate('AUTOINCREM', fatVenda.arrMatItens[intCont].intAutInc, []) then
    begin
      fatVenda.arrMatItens[intCont].strNumCmp := cdsVenda.FieldByName('ITE_NUMCMP').AsString;
      fatVenda.arrMatItens[intCont].intNItCmp := cdsVenda.FieldByName('ITE_NITCMP').AsInteger;
      fatVenda.arrMatItens[intCont].dtaDtaCmp := cdsVenda.FieldByName('ITE_DTACMP').AsDateTime;
      fatVenda.arrMatItens[intCont].strNumPla := cdsVenda.FieldByName('ITE_NUMPLA').AsString;
      fatVenda.arrMatItens[intCont].strParNum := cdsVenda.FieldByName('ITE_PARNUM').AsString;
      fatVenda.arrMatItens[intCont].strReqCom := cdsVenda.FieldByName('ITE_REQCOM').AsString;
      fatVenda.arrMatItens[intCont].strDesNes := cdsVenda.FieldByName('ITE_DESNES').AsString;
    end;
  end;
end;

