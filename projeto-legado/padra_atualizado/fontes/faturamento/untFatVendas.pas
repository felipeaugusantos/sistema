function TfrmFatVendas.fPerdeuFidelidade: Boolean;
  Var
    qryAux: TUniQuery;

    intCfgDiasUltOrcame: Integer;
    intCfgDiasUltVendas: Integer;
    intCfgDiasUltOcorre: Integer;

    blnFiel: Boolean;
    blnApenasDaLoja : Boolean;
    blnPessoaFisica : Boolean;
    strFisJur : String;

  procedure pFidelidadeFatGor(strEspDoc: String; intCfgDias: Integer);
  begin
    With qryAux, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT DATEDIFF(CURDATE(), FDO_DTAENT) AS DIAS                 ');
      Add('   FROM FATDOR                                                  ');
      Add('  INNER JOIN CADCLI ON CLI_CODCLI = FDO_CODCLI                  ');
      Add('  INNER JOIN CADATI ON CLI_CODATI = ATI_CODATI                  ');
      Add('  INNER JOIN GPAFID ON FID_CODGPA = ATI_CODGAT                  ');
      Add('                   AND FID_CODEMP = :CODEMP                     ');
      Add('                   AND FID_FISJUR = :FISJUR                     ');
      Add('  WHERE LEFT(FDO_CLAFIS, 1) >= 5                                ');
      Add('    AND FDO_CODVEN = CLI_CODVEN                                 ');
      Add('    AND FDO_CODCLI = :CODCLI                                    ');
      Add('    AND FDO_ESPDOC = "' + strEspDoc + '"                        ');

      If (blnApenasDaLoja) Then
        Add('  AND FDO_CODEMP = :CODEMP ');

      Add('  ORDER BY FDO_DTAENT DESC LIMIT 1                              ');
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODCLI').AsString := fatVenda.strCodCli;
      ParamByName('FISJUR').AsString := strFisJur;
      Open;

      If (Not IsEmpty) Then
        blnFiel := (FieldByName('DIAS').AsInteger <= intCfgDias);
    End;
  end;

Begin
  blnApenasDaLoja := (fCfgSis('EMPFID') = '1');
  qryAux := fCriaQuery(Self);
  Result := False;
  Try
    If (Not fEmptyStr(fCfgSis('VENESP'))) And (fCfgSis('VENESP') = fCampoTabela('CLI_CODVEN', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli])) Then
      Exit;

    With qryAux, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT COUNT(*) AS QTDE                               ');
      Add('   FROM CRMFAI                                         ');
      Add('   JOIN CADCLI ON CLI_CRMFAI = CRF_CODIGO              ');
      Add('  WHERE CLI_CODCLI = :CODCLI                           ');
      ParamByName('CODCLI').AsString := fatVenda.strCodCli;
      Open;

      If (fCfgSis('METFID') = 'N') And (FieldByName('QTDE').AsInteger > 0) Then
        Exit;

      blnPessoaFisica := fClientePessoaFisica(fatVenda.strCodCli);

      If (blnPessoaFisica) And (fGrupoAtividadeAutonomo(fatVenda.strCliAti)) Then
      Begin
        strFisJur := 'A';
        intCfgDiasUltOrcame := fCfgSis('FPAQDP', varInteger);
        intCfgDiasUltVendas := fCfgSis('FPAQDV', varInteger);
        intCfgDiasUltOcorre := fCfgSis('FPAQDC', varInteger);
      End
      Else If (blnPessoaFisica) Then
      Begin
        strFisJur := 'F';
        intCfgDiasUltOrcame := fCfgSis('FPFQDP', varInteger);
        intCfgDiasUltVendas := fCfgSis('FPFQDV', varInteger);
        intCfgDiasUltOcorre := fCfgSis('FPFQDC', varInteger);
      End
      Else
      Begin
        strFisJur := 'J';
        intCfgDiasUltOrcame := fCfgSis('FPJQDP', varInteger);
        intCfgDiasUltVendas := fCfgSis('FPJQDV', varInteger);
        intCfgDiasUltOcorre := fCfgSis('FPJQDC', varInteger);
      End;

      Close;
      Clear;
      Add(' SELECT COUNT(*) CNT ');
      Add('   FROM GPAFID ');
      Add('   JOIN CADGAT ON GAT_CODGAT = FID_CODGPA ');
      Add('   JOIN CADATI ON ATI_CODGAT = GAT_CODGAT ');
      Add('  WHERE FID_CODEMP = :CODEMP ');
      Add('    AND FID_FISJUR = :FISJUR ');
      Add('    AND ATI_CODATI = :CODATI ');
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('FISJUR').AsString := strFisJur;
      ParamByName('CODATI').AsString := fatVenda.strCliAti;
      Open;

      // Caso o grupo de atividade do cliente não estiver configurado, ignora a rotina de Fidelidade
      If (FieldByName('CNT').AsInteger <= 0) Then
        Exit;

      blnFiel := False;

      pFidelidadeFatGor('OR', intCfgDiasUltOrcame);

      If (Not blnFiel) Then
        pFidelidadeFatGor('PD', intCfgDiasUltVendas);

      If (Not blnFiel) Then
      Begin
        Close;
        Clear;
        Add(' SELECT DATEDIFF(CURDATE(), DET_DTAENT) AS DIAS                 ');
        Add('   FROM MOVDET                                                  ');
        Add('  INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM    ');
        Add('  INNER JOIN CADCLI ON CLI_CODCLI = DET_CODCLI                  ');
        Add('  INNER JOIN CADATI ON CLI_CODATI = ATI_CODATI                  ');
        Add('  INNER JOIN GPAFID ON FID_CODGPA = ATI_CODGAT                  ');
        Add('                   AND FID_CODEMP = :CODEMP                     ');
        Add('                   AND FID_FISJUR = :FISJUR                     ');
        Add('  WHERE DET_ESPDOC IN ("NF","FF")                               ');
        Add('    AND LEFT(DET_CLAFIS, 1) >= 5                                ');
        Add('    AND DET_CODVEN = CLI_CODVEN                                 ');
        Add('    AND DET_CODCLI = :CODCLI                                    ');

        If (blnApenasDaLoja) Then
          Add('  AND MOVTRI.DET_EMPORI = :CODEMP ');

        Add('  ORDER BY DET_DTAENT DESC LIMIT 1                              ');
        ParamByName('CODEMP').AsString := VS_strCodEmp;
        ParamByName('CODCLI').AsString := fatVenda.strCodCli;
        ParamByName('FISJUR').AsString := strFisJur;
        Open;

        If (Not IsEmpty) Then
          blnFiel := (FieldByName('DIAS').AsInteger <= intCfgDiasUltVendas);

        If (Not blnFiel) Then
        Begin
          Close;
          Clear;
          Add(' SELECT DATEDIFF(CURDATE(), CLI_ULTCOM) AS DIAS ');
          Add('   FROM CADCLI ');
          Add('  WHERE CLI_CODCLI = :CODCLI ');
          Add('    AND CLI_ULTCOM IS NOT NULL ');
          Add('    AND CLI_ULTCOM <> "0000-00-00" ');
          Add('    AND CLI_ULTCOM <> "1899-12-30" ');
          ParamByName('CODCLI').AsString := fatVenda.strCodCli;
          Open;

          If (Not IsEmpty) Then
            blnFiel := (FieldByName('DIAS').AsInteger <= intCfgDiasUltVendas);
        End;
      End;

      If (Not blnFiel) Then
      Begin
        Close;
        Clear;
        Add(' SELECT DATEDIFF(CURDATE(), MOVOCO.OCO_DTAINC) AS DIAS ');
        Add('   FROM MOVOCO ');
        Add('  INNER JOIN CADCLI ON CLI_CODCLI = MOVOCO.OCO_CODCLI ');
        Add('  INNER JOIN CADTOC ON TOC_CODTOC = MOVOCO.OCO_CODTOC ');
        Add('  INNER JOIN CADGOC ON GOC_CODGOC = TOC_CODGOC ');
        Add('  INNER JOIN OCOFID ON OCOFID.OCO_CODGOC = CADGOC.GOC_CODGOC ');
        Add('                   AND OCOFID.OCO_CODEMP = MOVOCO.OCO_CODEMP ');
        Add('  WHERE MOVOCO.OCO_CODCLI = :CODCLI ');

        If (blnApenasDaLoja) Then
          Add('  AND MOVOCO.OCO_CODEMP = ' + QuotedStr(VS_strCodEmp));

        Add('    AND MOVOCO.OCO_CODOPE = CLI_CODVEN ');
        Add('  ORDER BY MOVOCO.OCO_DTAINC DESC LIMIT 1 ');
        ParamByName('CODCLI').AsString := fatVenda.strCodCli;
        Open;

        If (Not IsEmpty) Then
          blnFiel := (FieldByName('DIAS').AsInteger <= intCfgDiasUltOcorre);
      End;
    End;

    If (blnFiel) Then
      Result := False
    Else
      Result := True;
  Finally
    FreeAndNil(qryAux);
  End;
End;

function TfrmFatVendas.fPerguntarSeConfirmaEmissaoVenda(): Boolean;
begin
  Result := True;

  if fatVenda.fRecebidoPorPix then
    exit ;

  If (fCfgSis('NVORPD',varBoolean) And (Pos(fatVenda.strOpcDoc, 'PD_OR') > 0)) Then
    Exit;

  If (fatVenda.blnFinali) And (fatVenda.blnCliFil) And (fRetornaClienteFilial(VS_strCodEmp) = fatVenda.strCodCli) Then
    Exit;

  If fatVenda.blnFinali And fatVenda.blnFinaliEnabled Then
    FVariaveisFechamentoVenda.strConfirma := 'Confirma o desmembramento do ' + IIF(fatVenda.strEspDoc = 'PD', 'Pedido', 'Orçamento') + '?'
  Else
    FVariaveisFechamentoVenda.strConfirma := 'Confirma emissão (' + fatVenda.strTipFat + ')?';

  {*****************************************}
  {* CONFIRMAÇÃO DO DOCUMENTO              *}
  {**************************************MV*}
  If (fMensagem('', FVariaveisFechamentoVenda.strConfirma, ['&Sim', '&Não']) = 2) Then
  Begin
    Result := False;
    Screen.Cursor := crDefault;
    Exit;
  End
  Else
  Begin
    pSetFocus(Self);
  End;

end;

function TfrmFatVendas.fPerguntarSeEnviaPedidoParaLiberacao: Boolean;
begin
  Result := True;

  fatVenda.blnOperadorEscolheuEnviarPedidoParaLiberacao := False;
  If fatVenda.blnLiberacaoRemotaNoFinalVenda Then
  Begin
    If (fatVenda.strEspDoc = 'PD') And fatVenda.blnUsaLiberacaoPedidosConformeEscolhaDoOperador Then
    Begin
      If (fCfgSis('LPSTER', VarBoolean) And fatVenda.strNumPok.IsEmpty) Then
        fatVenda.strEnvLib := 'N'
      Else
      Begin
        fatVenda.strEnvLib := IIF(fMensagem('','Enviar para Liberação de Pedidos?', ['',''], 2) = 2, 'N', 'S');
        fatVenda.blnOperadorEscolheuEnviarPedidoParaLiberacao := (fatVenda.strEnvLib = 'S');
      End
    End
  End;
end;

function TfrmFatVendas.fPerguntarSeGeraFormulacaoTintaMaquina: Boolean;
begin
  Result := True;
  fatVenda.blnMenFor := True;

  If (fEXIDOC) And (fVerificaTemTinta) Then
  Begin

    Try
      fatVenda.stlMenFor.Clear;

      {*****************************************}
      {* SE O PROCEDIMENTO FOR "GERAR".        *}
      {**************************************MV*}
      If (fCfgSis('POPTIN') = 'G') And (fCfgUtilizarOrdemProducao(fatVenda.strEspDoc))   Then
      Begin
        If fMensagem('','Gerar formulação de tinta de máquina?', ['','']) = 1 Then
        Begin
          pCriarFormularios(TfrmFatMenLab,frmFatMenLab);
          frmFatMenLab.memMensagem.Texto := fatVenda.stlMenFor.Text;

          If frmFatMenLab.ShowModal = mrOk Then
            fatVenda.stlMenFor.Text := frmFatMenLab.memMensagem.Texto
          Else
          Begin
            pFreeAndNil(frmFatMenLab);
            Result := False;
            Exit;
          End;
          pFreeAndNil(frmFatMenLab);
        End
        Else
          fatVenda.blnMenFor := False;
      End
      Else
      Begin
        {*****************************************}
        {* SE FOR IMPRIMIR SEMPRE IRÁ GERAR.     *}
        {**************************************MV*}
        fatVenda.blnMenFor := True;
      End;

    Except
      On E: Exception Do
      Begin
        pFreeAndNil(frmFatMenLab);
        Result := False;
        pMensagensErro(E.Message,'');
        Exit;
      End;
    End;

  End
  Else
    fatVenda.stlMenFor.Clear;
end;

