    strCfgBan := fCfgSis('BANVEN', VarString);

    objfrmPnlBanner := Nil;

    If (Pos('1', strCfgBan) > 0) Then
    Begin
      objfrmPnlBanner := TPanelCxBanner.Create(TfrmPnlBanner);
      objfrmPnlBanner.strTabPre := fatVenda.strTabPre;
      objfrmPnlBanner.strCodCli := fatVenda.strCodCli;
    End;

    objfrmPreFiltroCarro := Nil;

    If fCfgSis('PROVEI', varBoolean) Then
      objfrmPreFiltroCarro := TPanelCxPreFiltro.Create(TfrmPnlPreFiltroCarro);

    blnSitCodIte := edtCodIte.ReadOnly;
    edtCodIte.ReadOnly := True;

    If fPesqItem(conIteSimples,
                Self,
                edtCodIte,
                edtDesIte,
                qryConCit,
                chrKey,
                arrSel,
                True,
                objFrmPnl,
                fStrTituloConsulta,
                fatVenda.strTabPre,
                fatVenda.strConPag,
                fatVenda.fltTaxVpr,
                fatVenda.blnEmpFat,
                blnExiPar,
                0,
                cdrCodIte,
                '',    // strAplica: String
                False,
                edtCodCli.Text,
                fatVenda.strCodVen,
                True,   // blnMostrarPrecos
                False,  // blnTablet
                IIF(strOpcDoc = 'UC', False, True), // blnConsiderarExiLis
                '',     // Codigo do Comprador
                False,  // blnDepMatPriIndustrial
                False,  // blnDepProAcaIndustrial
                False,  // blnDepProEmbIndustrial
                False,  // blnDepProGraIndustrial
                False,  // blnVeioF11
                False,  // blnSomenteAgrotoxico
                False,  // blnMostrarItensDeServico
                False,  // blnExibeColunaSaldoCD
                fatVenda.strEmp_CD,
                fatVenda.fltDescFidelidade,
                True,   // blnFaturamento
                strCodFab,
                True,   // blnMostraSaldo
                '',     // strFiltros
                edtCodEmp.Text,
                fatVenda.fEmpresaSaldoMatriz_CD,
                strDescri,
                strCodBar,
                strProLoc,
                True,
                blnConEqu,
                False,
                objfrmPnlBanner,
                objfrmPreFiltroCarro,
                fatVenda.strCodCnd,
                fatVenda.strNumOrc,
                fatVenda.strEspOrc,
                '',
                '',
                '',
                fatVenda.strOpcDoc,
                IIF((Pos(fatVenda.strOpcDoc, 'OR_PD_VN_OF_TE_') > 0) And fatVenda.blnCliFil, 'N', IIF(strOpcDoc = 'OF', 'N', 'S'))) Then
    Begin
      If (fItemAddPorTabPelaPrimeiraVez) Then
      Begin
        (*******************************************************}
        {* CASO O ÚLTIMO REGISTRO TENHA SIDO INSERIDO PELO     *}
        {* "TAB" NA TELA DE CONSULTA, LIMPA TODOS OS CONTROLES *}
        {* REFERENTE AO ITEM PARA EVITAR ADD DUAS VEZES        *}
        {****************************************************VA*)
        btnCancelaItem.Click;
      End
      Else
      Begin
        Result := Not qryConCit.IsEmpty;

        edtCodIte.ReadOnly := False;

        If (rdbCodIte.Checked) Or (not blnBuscarCodFab) Then
          edtCodIte.Text := qryConCit.FieldByName('ITE_CODITE').AsString
        Else
          edtCodIte.Text := qryConCit.FieldByName('ITE_CODFAB').AsString;

        edtCodIte.ReadOnly := blnSitCodIte;

        strCodAtu := qryConCit.FieldByName('ITE_CODITE').AsString;

        (*******************************************************}
        {* SE USOU O "TAB" NA TELA DE CONSULTA E DEU "ESC"     *}
        {* NA TELINHA fmmFatVendaItem PARA ABANDONAR A OPERAÇÃO*}
        {* PROSSEGUINDO A CONSULTA DA FORMA NORMAL, PERDIA-SE  *}
        {* O FOCO DO edtCodIte AO RETORNAR À frmFatVendas      *}
        {****************************************************VA*)
        If (edtCodIte.CanFocus) And (Not edtCodIte.Focused) And (Not fEmptyStr(edtCodIte.Text)) Then
          pSetFocus(edtCodIte);

        (*******************************************************}
        {* VALIDA MARCAS CADASTRADAS NOS VENDEDORES DO CLIENTE *}
        {****************************************************IV*)
        If (Not fEmptyStr(strCliMarcas)) And (Pos(qryConCit.FieldByName('ITE_CODMAR').AsString, strCliMarcas) <= 0) Then
        Begin
          fMensagem('ATENÇÃO!', 'Item com Marca não permitida para este vendedor informado. Verifique!', ['&O k']);
        End
        Else If (Not fValidaVendedorMarca(fatvenda.strCodVen, edtCodIte.Text, strOpcDoc))Then
        Begin
          fMensagem('ATENÇÃO!', 'Item com Marca não permitida para este vendedor informado. Verifique!', ['&O k']);
          Result := False;
        End
        Else If (rdbCodFab.Checked) And (fEmptyStr(edtCodIte.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse item não possui código de fábrica!', ['&O k']);
        End
        Else
        Begin
          If (Not chkCheckOut.Checked) And fValidaCampos(edtCodIte, True) Then
            SelectNext(ActiveControl, True, True);
        End;
      End;
    End
    Else
    Begin
      btnCancelaItem.Click;
    End;
  Finally
    Self.intSemaforoKeyDown := intSemaforoAntesPesquisa;
    Self.blnPesquisando     := False;
    FreeAndNil(objfrmPnl);
    FreeAndNil(sltItensAntesPesquisa);

    If Assigned(objfrmPnlBanner) Then
      FreeAndNil(objfrmPnlBanner);

    If Assigned(objfrmPreFiltroCarro) Then
      FreeAndNil(objfrmPreFiltroCarro);

    edtCodIte.ReadOnly := blnSitCodIte;

  End;
End;

function TfrmFatVendas.fPesquisaQuestFidelidade(strDocCli, strNomCli: string; var strDocQuest: string): string;
var
  Participante: TParticipante;
  PreCadastro: TPreCadastro;
  blnEhCadastro: Boolean;
  blnCliCon: Boolean;
  strTelefone: string;
  intIndice: integer;
  blnErroCadastroQuest: Boolean;
begin
  Result := 'N';
  blnCliCon := fClienteConsumidor(strNomCli, False, True);
  pCriarFormularios(TfrmFatDigCnpj, frmFatDigCnpj);
  frmFatDigCnpj.edtCgcCpf.Text := '2';
  frmFatDigCnpj.edtNumCgc.EditMask := '999.999.999-99;0;';

  if Length(strDocCli) = 11 then
  begin
    frmFatDigCnpj.edtNumCgc.Text := strDocCli;
  end;
  frmFatDigCnpj.ShowModal;

  if frmFatDigCnpj.ModalResult = mrOk then
  begin
    try
      strDocQuest := frmFatDigCnpj.edtNumCgc.Text;
      Participante := TParticipante.Create;
      Participante := fConsultaQuestFidelidade(strDocQuest,IIF(not fEmptyStr(fCfgSis('CNPQUE')),fCfgSis('CNPQUE'),fRetCGCEmpresa(VS_strCodEmp)));
      if Participante.Erro then
      begin
        fMensagem('ATENÇÃO!', Participante.Mensagem, ['&Ok']);
        pBuscaClienteQuestNoAutcom(strDocQuest, blnCliCon, PreCadastro);
        blnEhCadastro := True;
      end
      else
      begin
        PreCadastro := TPreCadastro.Create;
        PreCadastro.CnpjParceiro := IIF(not fEmptyStr(fCfgSis('CNPQUE')),fCfgSis('CNPQUE'),fRetCGCEmpresa(VS_strCodEmp));
        PreCadastro.CpfCnpjParticipante := Participante.CpfCnpjParticipante;
        PreCadastro.PrimeiroNome := Participante.Nome;
        PreCadastro.DDD := Participante.Telefones[0].DDD;
        PreCadastro.Numero := Participante.Telefones[0].Numero;
        PreCadastro.Email := Participante.Email;
        blnEhCadastro := False;
      end;

      try
        pCriarFormularios(TfrmCadQuestFidelidade, frmCadQuestFidelidade);
        if Length(strDocQuest) = 11 then
        begin
          frmCadQuestFidelidade.edtCgcCpf.Text := '2';
          frmCadQuestFidelidade.edtNumCgc.EditMask := '999.999.999-99;0;';
        end
        else
        begin
          frmCadQuestFidelidade.edtCgcCpf.Text := '1';
          frmCadQuestFidelidade.edtNumCgc.EditMask := fRetMascaraC_G_C_(fSetaPais, C_G_C_);
        end;
        frmCadQuestFidelidade.edtNumCgc.Text := strDocQuest;
        frmCadQuestFidelidade.edtTelefone.Text := IIF(PreCadastro.DDD = 0,'',IntToStr(PreCadastro.DDD)) + PreCadastro.Numero;
        frmCadQuestFidelidade.edtNome.Text := PreCadastro.PrimeiroNome;
        frmCadQuestFidelidade.edtEmail.Text := PreCadastro.Email;
        frmCadQuestFidelidade.lblQuestPontos.Caption := '0,00';
        frmCadQuestFidelidade.lblQuestValor.Caption := 'R$ 0,00';

        if not Participante.Erro then
        begin
          frmCadQuestFidelidade.lblQuestPontos.Caption := FloatToStrF(Participante.SaldoDisponivelPontos, ffFixed, 12, 2);
          frmCadQuestFidelidade.lblQuestValor.Caption := 'R$ ' + FloatToStrF(Participante.SaldoDisponivelValor, ffFixed, 12, 2);

          frmCadQuestFidelidade.memHistoricoQuest.Lines.Clear;
          for intIndice := 0 to Participante.HistoricoCompras.Count - 1 do
          begin
            frmCadQuestFidelidade.memHistoricoQuest.Lines.Add('Produto: ' + Participante.HistoricoCompras[intIndice].Produto);
            frmCadQuestFidelidade.memHistoricoQuest.Lines.Add('Quantidade: '+ IntToStr(Participante.HistoricoCompras[intIndice].Compras));
            frmCadQuestFidelidade.memHistoricoQuest.Lines.Add('');
          end;

          frmCadQuestFidelidade.memOfertasQuest.Lines.Clear;
          for intIndice := 0 to Participante.Campanhas.Count - 1 do
          begin
            frmCadQuestFidelidade.memOfertasQuest.Lines.Add(Participante.Campanhas[intIndice].Descricao);
            frmCadQuestFidelidade.memOfertasQuest.Lines.Add('');
          end;
        end;

        frmCadQuestFidelidade.pHabilitaCampos(blnEhCadastro);
        blnErroCadastroQuest := True;

        while blnErroCadastroQuest do
        begin
          frmCadQuestFidelidade.ShowModal;
          if frmCadQuestFidelidade.ModalResult = mrOk then
          begin
            PreCadastro.CpfCnpjParticipante := frmCadQuestFidelidade.edtNumCgc.Text;
            strTelefone := frmCadQuestFidelidade.edtTelefone.Text;
            if fEmptyStr(strTelefone) then
            begin
              PreCadastro.DDD := 0;
              PreCadastro.Numero := '';
            end
            else
            begin
              PreCadastro.DDD := StrToIntDef(Copy(strTelefone,1,2),0);
              Delete(strTelefone,1,2);
              PreCadastro.Numero := Trim(strTelefone);
            end;
            PreCadastro.PrimeiroNome := frmCadQuestFidelidade.edtNome.Text;
            PreCadastro.Email := frmCadQuestFidelidade.edtEmail.Text;
            blnErroCadastroQuest := False;

            if Participante.Erro then
            begin
              pPreCadastroQuestFidelidade(PreCadastro);
              fMensagem('ATENÇÃO!', PreCadastro.Mensagem, ['&Ok']);
              if PreCadastro.Erro then
              begin
                blnErroCadastroQuest := True;
              end;
            end;

          end
          else
          begin
            Exit;
          end;
        end;
      finally
        FreeAndNil(frmCadQuestFidelidade);
      end;

      Result := 'S';
    finally
      if Assigned(Participante) then
      begin
        FreeAndNil(Participante);
      end;

      if Assigned(PreCadastro) then
      begin
        FreeAndNil(PreCadastro);
      end;
    end;
  end;
end;

