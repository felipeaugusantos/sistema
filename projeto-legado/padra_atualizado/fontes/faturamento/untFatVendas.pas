procedure TfrmFatVendas.pPreencheDicionarioRemessa(strClienteRemessa,
  strDocumentoRemessa: string);
var
  qryConsulta: TUniQuery;
  strClaEnv: string;
  fltQtdItePed: Double;
  objConsig   : TConsignacoes;
  intPosicao: integer;
  intContador: integer;
  cdsConsulta: TUniClientDataSet;
  blnTerminou: Boolean;
  strAutIncRemessa: String;
begin
  strClaEnv := '5' + fCfgSis('CFRSAI') + '_' + '6' + fCfgSis('CFRSAI') + '_' + '5' + fCfgSis('CFRSAS') + '_' + '6' + fCfgSis('CFRSAS') + '_';
  qryConsulta := fCriaQuery;
  try
    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add(fAnaliticoNotaRemessa(Not fEmptyStr(strDocumentoRemessa)));

    cdsVenda.DisableControls;
    cdsVenda.First;

    intContador := 0;

    while not cdsVenda.Eof do
    begin
      blnTerminou := False;
      objConsig := TConsignacoes.Create;
      fltQtdItePed := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
      qryConsulta.Close;
      qryConsulta.ParamByName('CODCLI').AsString := strClienteRemessa;
      qryConsulta.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryConsulta.ParamByName('CLAENV').AsString := strClaEnv;
      qryConsulta.ParamByName('CODITE').AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;

      If Not fEmptyStr(strDocumentoRemessa) Then
        qryConsulta.ParamByName('NUMDOC').AsString := strDocumentoRemessa;

      qryConsulta.Open;
      if not qryConsulta.IsEmpty then
      begin
        cdsConsulta := fCriaClientDatset(qryConsulta);
        cdsConsulta.First;
        while not cdsConsulta.Eof do
        begin
          if (cdsConsulta.FieldByName('DET_QTDPEN').AsFloat > 0) and (not blnTerminou) then
          begin
            if cdsConsulta.FieldByName('DET_QTDPEN').AsFloat < fltQtdItePed  then
            begin
              cdsConsulta.Edit;
              cdsConsulta.FieldByName('DET_QTFARE').AsFloat := cdsConsulta.FieldByName('DET_QTFARE').AsFloat + cdsConsulta.FieldByName('DET_QTDPEN').AsFloat;
              fltQtdItePed := fltQtdItePed - cdsConsulta.FieldByName('DET_QTDPEN').AsFloat;
              cdsConsulta.FieldByName('DET_QTDFAT').AsFloat := cdsConsulta.FieldByName('DET_QTDPEN').AsFloat;
              cdsConsulta.FieldByName('DET_QTDPEN').AsFloat := 0;
              cdsConsulta.Post;
            end
            else
            begin
              cdsConsulta.Edit;
              cdsConsulta.FieldByName('DET_QTFARE').AsFloat := fltQtdItePed;
              cdsConsulta.FieldByName('DET_QTDPEN').AsFloat := cdsConsulta.FieldByName('DET_QTDPEN').AsFloat - fltQtdItePed;
              cdsConsulta.FieldByName('DET_QTDFAT').AsFloat := fltQtdItePed;
              cdsConsulta.Post;
              blnTerminou := True;
            end;
            SetLength(objConsig.arrConsignacoes, Length(objConsig.arrConsignacoes) + 1);
            intPosicao := Length(objConsig.arrConsignacoes) - 1;

            objConsig.arrConsignacoes[intPosicao].strNumDoc := cdsConsulta.FieldByName('DET_NUMDOC').AsString;
            objConsig.arrConsignacoes[intPosicao].strEspDoc := cdsConsulta.FieldByName('DET_ESPDOC').AsString;
            objConsig.arrConsignacoes[intPosicao].strCodIte := cdsConsulta.FieldByName('DET_CODITE').AsString;
            objConsig.arrConsignacoes[intPosicao].strCodEmp := cdsConsulta.FieldByName('DET_CODEMP').AsString;
            objConsig.arrConsignacoes[intPosicao].fltQtdIte := cdsConsulta.FieldByName('DET_QTDFAT').AsFloat;
            objConsig.arrConsignacoes[intPosicao].strAutInc := cdsConsulta.FieldByName('AUTOINCREM').AsString;

            If (cdsConsulta.FieldByName('DET_QTDPEN').AsFloat = cdsConsulta.FieldByName('DET_QTDFAT').AsFloat) Then
            Begin
              objConsig.arrConsignacoes[intPosicao].fltDesEsp := cdsConsulta.FieldByName('DET_DESESP').AsFloat -
                                                                 cdsConsulta.FieldByName('CON_DESESP').AsFloat;

              fatVenda.fltDesEsp := fatVenda.fltDesEsp + cdsConsulta.FieldByName('DET_DESESP').AsFloat -
                                                         cdsConsulta.FieldByName('CON_DESESP').AsFloat;
            End
            Else
            Begin
              objConsig.arrConsignacoes[intPosicao].fltDesEsp := fFormataFloat(cdsConsulta.FieldByName('DET_DESESP').AsFloat /
                                                                               cdsConsulta.FieldByName('DET_QTDENV').AsFloat *
                                                                               cdsConsulta.FieldByName('DET_QTDFAT').AsFloat, 2);

              fatVenda.fltDesEsp := fatVenda.fltDesEsp + fFormataFloat(cdsConsulta.FieldByName('DET_DESESP').AsFloat /
                                                                       cdsConsulta.FieldByName('DET_QTDENV').AsFloat *
                                                                       cdsConsulta.FieldByName('DET_QTDFAT').AsFloat, 2);
            End;

            pIncrementaListaStr(objConsig.arrConsignacoes[intPosicao].strAutInc, strAutIncRemessa, True);
          end;

          if blnTerminou then
          begin
            Break;
          end;

          cdsConsulta.Next;
        end;

      end;
      If Not Assigned(fatVenda.dicDocs) Then
        fatVenda.dicDocs := TDicionario.Create;

      Inc(intContador);
      fatVenda.dicDocs.AdicionarObjeto(IntToStr(intContador), objConsig);
      cdsVenda.Next;
    end;

    fatVenda.pPreencheReferenciaRemessa(strAutIncRemessa);
  finally
    cdsVenda.EnableControls;
    FreeAndNil(qryConsulta);
  end;
end;

procedure TfrmFatVendas.pPreencheMatrizFechamento;
begin
  If Assigned(frmFechamentoVenda) Then
    pInformacao('Aguarde, Carregando dados do produto para Fechamento...', frmFechamentoVenda.pgbStatus);

  NotificarFechamentoVendaObservers;

  fatVenda.pPreencheMatrizFechamento('', pOnPreencheMatrizItens);

  If Assigned(frmFechamentoVenda) Then
  Begin
    pProgresso (0, 0, frmFechamentoVenda.pgbStatus);
    pInformacao(MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA, frmFechamentoVenda.pgbStatus);
  End;

  NotificarFechamentoVendaObservers;
end;

procedure TfrmFatVendas.pCalculaTotGer(blnZeraPercentuaisDesconto: Boolean = False;
                                       blnCalculaImpostos: Boolean = True;
                                       blnPegaClassificacaoItem: Boolean = True;
                                       strMensagemExibicao: String = '');
begin
  If Assigned(frmFechamentoVenda) Then
  Begin
    If fEmptyStr(strMensagemExibicao) Then
      pInformacao('Aguarde, Calculando valor dos produtos...', frmFechamentoVenda.pgbStatus)
    Else
      pInformacao(strMensagemExibicao, frmFechamentoVenda.pgbStatus);
  End;

  NotificarFechamentoVendaObservers;

  Try
    FInfoProcessamentoItem := strMensagemExibicao;
    fatVenda.pCalculaTotGer(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnCalculaTotGer, blnPegaClassificacaoItem);
  Finally
    FInfoProcessamentoItem := '';
  End;

  If Assigned(frmFechamentoVenda) Then
  Begin
    pProgresso (0, 0, frmFechamentoVenda.pgbStatus);
    pInformacao(MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA, frmFechamentoVenda.pgbStatus);
  End;

  NotificarFechamentoVendaObservers;
end;

procedure TfrmFatVendas.pOnPreencheMatrizItens(const item: TDadosFechamento; index, count: Integer; AInfo: String = '');
  Var
    strInfoProcessamento: String;
begin
  If Assigned(frmFechamentoVenda) Then
  Begin
    strInfoProcessamento := 'Aguarde, Processando produto %s...';
    If AInfo.IsEmpty Then
      AInfo := strInfoProcessamento;
    pInformacao(Format(AInfo, [item.strCodIte + '-' + fPadR(item.strDesIte, 10)]), frmFechamentoVenda.pgbStatus);
    pProgresso(Succ(index), count -1, frmFechamentoVenda.pgbStatus);
    NotificarFechamentoVendaObservers;
  End;
end;

procedure TfrmFatVendas.pOnAdicionouItemDoPedido;
var
  recItem: TThreadCarregarSaldoEmpresasGrid.TItem;
  recEmpSal: TThreadCarregarSaldoEmpresasGrid.TEmpSaldo;
begin
  If fCfgSis('UTIDEF', varBoolean) And fCfgSis('ULTAMB', varBoolean) Then
  Begin
    If Not fEmptyStr(cdsVenda.FieldByName('ITE_COMPLE').AsString) Then
    Begin
      If cbbComple.Items.IndexOf(cdsVenda.FieldByName('ITE_COMPLE').AsString) < 0 Then
        cbbComple.Items.Add(cdsVenda.FieldByName('ITE_COMPLE').AsString);
      strUltComple := cdsVenda.FieldByName('ITE_COMPLE').AsString;
    End;
  End;

  If blnExibeSaldoGrid Then
  Begin
    If Assigned(thrCarregarSaldoEmpresasGrid) Then
    Begin
      thrCarregarSaldoEmpresasGrid.AddItem(cdsVenda.FieldByName('AUTOINCREM').AsInteger,
                                           cdsVenda.FieldByName('ITE_CODITE').AsString,
                                           cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                                           cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                           fatVenda);
    End
    Else
    Begin
      recItem := TThreadCarregarSaldoEmpresasGrid.GetSaldoLojas(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                                cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                                                                cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                                fatVenda);
      cdsVenda.Edit;
      cdsVenda.FieldByName('ESTFIL').AsFloat := recItem.fltEstFil;
      cdsVenda.FieldByName('ESTLOJ').AsFloat := recItem.fltEstLoj;
      For recEmpSal In recItem.arrEmpSal Do
        cdsVenda.FieldByName('EST_EMP_' + recEmpSal.strCodEmp).AsFloat := recEmpSal.fltSalDis;
      cdsVenda.Post;
    End;
  End;
end;

procedure TfrmFatVendas.pOnCalculaTotGer(const item: TDadosFechamento; index, count: Integer; AInfo: String = '');
begin
  If Assigned(frmFechamentoVenda) Then
  Begin
    If FInfoProcessamentoItem = '' Then
      FInfoProcessamentoItem := 'Aguarde, Calculando valor do produto %s...';
    If AInfo.IsEmpty Or (FInfoProcessamentoItem = MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA) Then
      AInfo := FInfoProcessamentoItem;
    pInformacao(Format(AInfo, [item.strCodIte + '-' + fPadR(item.strDesIte, 10)]), frmFechamentoVenda.pgbStatus);
    pProgresso(Succ(index), count -1, frmFechamentoVenda.pgbStatus);
    NotificarFechamentoVendaObservers;
  End;
end;

procedure TfrmFatVendas.pEncontraCampoFocus(pnlGenerico: TPanel);
  Var
    intIdx: Integer;
    pnlTmp: TPanel;
    edtTmp: TEditFocus;
    mskTmp: TMaskEditFocus;
    cmbTmp: TComboBoxFocus;
begin
  For intIdx := 0 To pnlGenerico.ControlCount - 1 Do
  Begin
    If pnlGenerico.Controls[intIdx] Is TPanel Then
    begin
      pnlTmp := (pnlGenerico.Controls[intIdx] As TPanel);

      If (pnlTmp.Visible) And (pnlTmp.Enabled) Then
        pEncontraCampoFocus(pnlTmp);
    End
    Else
    Begin
      If pnlGenerico.Controls[intIdx] Is TEditFocus Then
      Begin
        edtTmp := (pnlGenerico.Controls[intIdx] As TEditFocus);

        If (edtTmp.Visible) And
           fEmptyStr(edtTmp.Text) And
           (Not edtTmp.ReadOnly) And
           (edtTmp.Enabled) Then
          pAddCampoArr(pnlGenerico.TabOrder, edtTmp);
      End
      Else If pnlGenerico.Controls[intIdx] Is TComboBoxFocus Then
      Begin
        cmbTmp := (pnlGenerico.Controls[intIdx] As TComboBoxFocus);

        If (cmbTmp.Visible) And
           fEmptyStr(cmbTmp.Text) And
           (cmbTmp.Enabled) Then
          pAddCampoArr(pnlGenerico.TabOrder, cmbTmp);
      End
      Else If pnlGenerico.Controls[intIdx] Is TMaskEditFocus Then
      Begin
        mskTmp := (pnlGenerico.Controls[intIdx] As TMaskEditFocus);

        If (mskTmp.Visible) And
           fEmptyStr(fTiraCaracEspeciaisPonto(mskTmp.Text)) And
           (Not mskTmp.ReadOnly) and (mskTmp.Enabled) Then
          pAddCampoArr(pnlGenerico.TabOrder, mskTmp);
      End;
    End;
  End;
end;

