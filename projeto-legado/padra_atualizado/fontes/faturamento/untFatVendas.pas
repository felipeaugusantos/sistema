procedure TfrmFatVendas.pUtilizaCashbackCliente;
var
  strNumDocLocal,
  strEspDocLocal,
  strMensagem        : String;
  fltValorDisponivel : Double;
begin
  fatVenda.fltDesCsh := 0;

  If (Not fatVenda.objControleCashback.fPermiteUtilizarRotinaCashback) Then
    Exit;

  fatVenda.objControleCashback.pLimparObjeto;

  strNumDocLocal := fatVenda.strNumOrc;
  strEspDocLocal := fatVenda.strEspOrc;

  If (strEspDocLocal = 'OR') And (fatVenda.strEspDoc = 'PD') Then
  Begin
    strNumDocLocal := EmptyStr;
    strEspDocLocal := fatVenda.strEspDoc;
  End
  Else If fEmptyStr(fatVenda.strNumOrc) Then
  Begin
    strNumDocLocal := fatVenda.strNumDoc;
    strEspDocLocal := fatVenda.strEspDoc;
  End;

  If fEmptyStr(strEspDocLocal) Then
    strEspDocLocal := fatVenda.strOpcDoc;

  fatVenda.objControleCashback.strNumDoc := strNumDocLocal;
  fatVenda.objControleCashback.strEspDoc := strEspDocLocal;
  fatVenda.objControleCashback.strCodEmp := VS_strCodEmp;
  fatVenda.objControleCashback.strCodCli := edtCodCli.Text;
  fatVenda.objControleCashback.strOrigem := 'V';
  fatVenda.objControleCashback.strFonCli := IIF(Not fEmptyStr(fatVenda.strCliTel), fatVenda.strCliTel, fatVenda.strCliCel);
  fatVenda.objControleCashback.strCpfCli := fatVenda.strCliCgc;
  fatVenda.objControleCashback.strCodVen := fatVenda.strCodVen;
  fatVenda.objControleCashback.cdsItens  := cdsVenda;

  fltValorDisponivel := fatVenda.objControleCashback.fCashbackDisponivelCliente(
                                                        VS_Date,
                                                        strMensagem);

  If fltValorDisponivel > 0 Then
  Begin
    fatVenda.blnUtilizouCashback := (fMensagem('Confirmação', strMensagem+' Deseja utilizar?', ['Sim','Não']) = 1);
    If fatVenda.blnUtilizouCashback Then
      fatVenda.fltDesCsh := fltValorDisponivel;
  End;
end;

procedure TfrmFatVendas.pUtilizaNumeroSerie(strNumDoc, strNumSer,
  strCodIte: string);
var
  qryNumeroSerie: TUniQuery;
  strSQL: string;
begin
  try
    strSQL := '';
    strSQL := strSQL + 'UPDATE PROSER ';
    strSQL := strSQL + 'SET SER_NUMDOC = :NUMDOC ';
    strSQL := strSQL + 'WHERE SER_CODITE = :CODITE ';
    strSQL := strSQL + 'AND SER_NUMSER = :NUMSER ';
    strSQL := strSQL + 'AND SER_CODEMP = :CODEMP ';

    qryNumeroSerie := fCriaQuery(nil);
    qryNumeroSerie.Close;
    qryNumeroSerie.SQL.Clear;
    qryNumeroSerie.SQL.Add(strSQL);
    qryNumeroSerie.ParamByName('NUMDOC').AsString := strNumDoc;
    qryNumeroSerie.ParamByName('CODITE').AsString := strCodIte;
    qryNumeroSerie.ParamByName('NUMSER').AsString := strNumSer;
    qryNumeroSerie.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryNumeroSerie.ExecSQL;

  finally
    FreeAndNil(qryNumeroSerie);
  end;
end;

