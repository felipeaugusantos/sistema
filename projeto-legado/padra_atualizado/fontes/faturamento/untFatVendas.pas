    blnExiPar := fExibirValorDaParcelaNoTotal;

    If (strOpcDoc = 'CT') Then
      pCarregaTela(True, 'TE')
    Else
      pCarregaTela(True);

    If (fCfgSis('FAT_PD', varBoolean) And (strOpcDoc = 'VN') And (strEspOrc = 'PD')) Then
    Begin
      If (fatVenda.fEhVendaItemConcreto) Then
      Begin
        strOps := TFatVendaImp.fGetOPs_PD(strNumOrc,
                                          strEspOrc,
                                          strEmpOrc);
        If Not fEmptyStr(strOps) Then
        Begin

          fMensagem('ATENÇÃO!', 'Este pedido de venda possui ordem de produção. O faturamento somente '+
                                'poderá ser realizado depois da baixa da ordem de produção. OP(s): '+ strOps +'.', ['&Ok']);

          blnFecharForm          := True;
          fatVenda.blnFecharForm := True;
          Exit;

        End;
      End;
    End;

    If lblTabPreco.Visible Then
    Begin
      edtNomCli.Width := 513;
      cbTabPreco.Text := fatVenda.strTabPre;
    End;

    If (Not fCfgSis('CONENT', varBoolean)) Or
       (    fCfgSis('EMPGER', varBoolean)) Or
       ( Pos(strOpcDoc, 'VN_PD_OR_CS_') <= 0) Then
    Begin
      lblEntrega.Visible := False;
      edtEntrega.Visible := False;
    End
    Else
