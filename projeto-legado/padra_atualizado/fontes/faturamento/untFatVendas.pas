  RecResult1Destino : TRecResult1Destino;
begin
  inherited;

  fatVenda.pLimpaDeletadosDoArrPromocaoQtdeColetiva(intConfirmando, strOpcDoc, fGridVendaVazio, cdsVenda);

  If (Pos(strOpcDoc, 'DV_PR_' ) > 0) And (btnAdicionar.Tag = 0) And (Not fatVenda.blnDevolucaoCompleta) Then
