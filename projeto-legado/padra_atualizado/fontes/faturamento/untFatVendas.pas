function TfrmFatVendas.fRetornarClaFisDevolucao(strNumDoc, strEspDoc,strCodEmp: String): String;
var
  Qry : TUniQuery;
begin

  Result := '';

  Qry := Nil;

  try
    Qry := fCriaQuery;

    Qry.Close;
    Qry.SQL.Clear;
    Qry.SQL.Text := ' SELECT DET_CLAFIS '+
                    '   FROM MOVDET '+
                    '  WHERE DET_CODEMP  = :CODEMP '+
                    '    AND DET_ESPDOC  = :ESPDOC '+
                    '    AND DET_NUMDOC  = :NUMDOC ';

    Qry.ParamByName('CODEMP').AsString := strCodEmp;
    Qry.ParamByName('ESPDOC').AsString := strEspDoc;
    Qry.ParamByName('NUMDOC').AsString := strNumDoc;

    Qry.Open;

    Qry.First;


    While not Qry.Eof Do
    begin

      if Result = '' then
        Result := Qry.FieldbyName('DET_CLAFIS').AsString
      else
        Result := Result + '_' + Qry.FieldbyName('DET_CLAFIS').AsString;

      Qry.Next;
    end;

  finally
    FreeAndNil(Qry);
  end;

end;

function TfrmFatVendas.fRetornaSeTravaAvisaSolicitaSenhaMultiploVenda: String;
var
  blnEhEmbalagem : Boolean;
