function TfrmFatVendas.fVerificaSePodeInserirItemConcreto: Boolean;
  Var
    strEmpIte: String;
begin
  Result := True;

  strEmpIte := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, IIF(fEmptyStr(fatVenda.strEmp_TE),VS_strCodEmp,fatVenda.strEmp_TE));

  If (strEmpIte <> VS_strCodEmp) And
     (fItemConcreto(fCodItem, strEmpIte)) And
     (fCfgSis('USACCR', varString, strEmpIte   ) = 'S') And
     (fCfgSis('USACCR', varString, VS_strCodEmp) = 'N') Then
  Begin
    Result := False;
    fMensagem('','Não é permitido inserir um produto concreto, pois a empresa de ' +
                 'emissão do documento "' + VS_strCodEmp + '" não está configurada para utilizar concreto. ' +
                 'Este documento deve ser emitido diretamente na empresa "' + strEmpIte + '" ou então ' +
                 'deve-se configurar que utiliza concreto na empresa "' + VS_strCodEmp + '"!', ['&Ok']);
  End;

  {Na J.A Massas e Concretos sempre precisa iniciar a venda de um concreto
   através do pedido de venda!}
  If (btnAdicionar.Tag <= 0) And (strOpcDoc = 'VN') And (strEspOrc <> 'PD') Then
  Begin

    If fItemConcreto(fCodItem) Then
    Begin

      Result := False;

      fMensagem('','Não é permitido inserir um produto concreto diretamente na venda normal, ' +
                   'é necessário criar um pedido de venda!', ['&Ok']);
    End

  End;

  If (btnAdicionar.Tag <= 0) And
     (cdsVenda.RecordCount > 0) And
     (fCfgSis('USACCR', varBoolean)) Then
  Begin

    If (strOpcDoc <> 'CN') Then //Prestcon
    Begin
      If fItemConcreto(cdsVenda.FieldByName('ITE_CODITE').AsString) Then
      Begin
        Result := False;

        fMensagem('','Não é permitido inserir mais produtos, ' +
                     'pois já foi inserido um produto concreto!', ['&Ok']);
      End

      Else If fItemConcreto(fCodItem) Then
      Begin
        Result := False;

        fMensagem('','Não é permitido inserir um produto concreto, ' +
                     'pois já foram inseridos outros produtos neste documento!', ['&Ok']);
      End;
    End;

  End;

  //Prestcon
  If Result And fCfgSis('USACCR', VarBoolean) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
  Begin
    If (fItemConcreto(fCodItem)) And (Pos(strOpcDoc, 'VN_PD_OR_') <= 0) Then
    Begin
      If fEmptyStr(cdsVenda.FieldByName('ITE_DOCCNF').AsString) Or (btnAdicionar.Tag <= 0) Then
      Begin
        fMensagem('', 'Somente é permitido utilizar item concreto na Venda Normal!', ['&Ok']);
        Exit;
      End;
    End;
  End;

end;

function TfrmFatVendas.fVerificaSituacaoRegularConf: Boolean;
var
  strMsgRetorno: string;
begin
  Result := True;

  If (Pos(strOpcDoc, 'CF_CP_VN_') <= 0) Then
    Exit;

  If fatVenda.strEspDoc <> 'NF' Then
    Exit;

  If fatVenda.intCgcCpf <> 1 Then
    Exit;

  If fClienteConsumidor(fatVenda.strCliOri, True, False) Then
    Result := TConsultaCadastroFit.VerificaSituacaoRegularConfirmacao(fatVenda.strCliCgc, fatVenda.strCliEst, fatVenda.strCliIes, strMsgRetorno)
  Else
    Result := TConsultaCadastroFit.VerificaSituacaoRegularConfirmacao(fatVenda.strCodCli, False, strMsgRetorno);

  If Not Result Then
  Begin
    If fEmptyStr(strMsgRetorno) Then
      strMsgRetorno := 'Erro ao realizar consulta da situação regular do cliente.';

    fMensagem('ATENÇÃO!', strMsgRetorno, ['&Ok']);
  End;
end;

procedure TfrmFatVendas.pHerancaVendasTintometricoPeriodo;
var
  blnResult: Boolean;
begin
  If (fatVenda.blnComVal) Then
  Begin
    pMensagemOk('Opção não permitida, pois já foi escolhida anteriormente a opção de herança para complemento de valores' + #13#10 + 'Favor cancelar todo o processo e iniciar novamente.');
    Exit;
  End;

  dtaInicialNesTin := 0;
  dtaFinalNesTin   := 0;
  opcNesTinSel     := opcVazio;

  Try
    pCriarFormularios(TfrmFatDigDatas, frmFatDigDatas);
    frmFatDigDatas.mskDtaIni.Text := DateToStr(VS_Date);
    frmFatDigDatas.mskDtaFin.Text := DateToStr(VS_Date);
    frmFatDigDatas.blnFatVenda := False;
    frmFatDigDatas.ShowModal;
    blnResult := frmFatDigDatas.blnConfirma;
    If blnResult Then
    Begin
      dtaInicialNesTin := StrToDate(frmFatDigDatas.mskDtaIni.Text);
      dtaFinalNesTin   := StrToDate(frmFatDigDatas.mskDtaFin.Text);
    End;
  Except
    On E: Exception Do
    Begin
      blnResult := False;
      pMensagensErro(E.Message, '');
    End;
  End;

  pFreeAndNil(frmFatDigDatas);

  If Not blnResult Then
    Exit;

  Case fGetMenu('', ['Produto acabado',
                     'Bases/Colorantes (Imobiliárias/Automotivas/Industriais), Sem destaque de impostos',
                     'Bases/Colorantes (Imobiliárias/Automotivas/Industriais), Com destaque de impostos',
                     'Somente colorantes tributados de imobiliárias',
                     'Somente colorantes não tributados de imobiliárias'], 1, False, False, 210) Of
    1: opcNesTinSel := opcProdutoAcabado;
    2: opcNesTinSel := opcBasesColorantesSemDestaqueImpostos;
    3: opcNesTinSel := opcBasesColorantesComDestaqueImpostos;
    4: opcNesTinSel := opcColorantesTributados;
    5: opcNesTinSel := opcColorantesNaoTributados;
  End;

  If (opcNesTinSel <> opcVazio) Then
  Begin
    fatVenda.opcItensNFEspecialTinta := opcNesTinSel;
    fatVenda.pItensNFEspecialTinta(dtaInicialNesTin, dtaFinalNesTin, opcNesTinSel, pIncluirItem, pgbProgresso, pCancelarNFEspecial);

    pPreencheMatrizFechamento;
    pCalculaTotGer;
    pAtualizarEditsTotais;
  End;
end;

procedure TfrmFatVendas.pIncluirItem(strCodIte, strDescri: String; fltQtdIte,
  fltUnitar: Double; strCodUni: String = ''; strCodAca: String = ''; strEmpAca: String = '');
begin
  btnCancelaItem.Click;
  cmbTipEnt.ItemIndex := 1;

  edtCodIte.Text := strCodIte;

  pCarregaItem(True, True, False);

  edtDesIte.Text := strDescri;

  If Not fEmptyStr(strCodUni) Then
    edtUnidad.Text := strCodUni;

  edtQtdIte.Text := FloatToStrF(fltQtdIte, ffFixed, 12, 4);
  edtQtdIteExit(edtQtdIte);

  edtUnitar.Text := FloatToStrF(fltUnitar, ffFixed, 12, fatVenda.fMaxDecUni);
  edtDesCon.Text := FloatToStrF(0, ffFixed, 5, intDecDes);
  cmbEntSai.ItemIndex := 1; // 0 - Entrada 1 - Saída
  Self.strCodAca := strCodAca;
  Self.strEmpAca := strEmpAca;

  If ((fatVenda.opcItensNFespTinta = opcColorantesTributados) And (Not fEhItemTributado(qryConAbf.FieldByName('ABF_CODSIT_SAI_CNC').AsString))) Or 
     ((fatVenda.opcItensNFespTinta = opcColorantesNaoTributados) And (fEhItemTributado(qryConAbf.FieldByName('ABF_CODSIT_SAI_CNC').AsString))) Then
  Begin
    btnCancelaItem.Click;
    Exit;
  End;

  btnAdicionar.Click;
  btnCancelaItem.Click;
end;

