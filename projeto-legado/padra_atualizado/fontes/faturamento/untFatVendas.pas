procedure TfrmFatVendas.btnNotEntClick(Sender: TObject);
  Var
    objIteEnt: TItensEntrada;
    strClienteFilial: String;
    LTabPre : String;
begin
  inherited;

  If Not btnNotEnt.Visible Then
    Exit;

  if fEmptyStr(edtNomCli.Text) then
  begin
    fMensagem('ATENÇÃO!', 'O código do ' + IIF(fatVenda.fDocumentoParaFornecedor, 'Fornecedor', 'Cliente') + ' deve ser preenchido!', ['&Ok']);
    pSetFocus(edtCodCli);
    Exit;
  end;

  strClienteFilial := '';
  If fClienteFilial(edtCodCli.Text) Then
    strClienteFilial := edtCodCli.Text;

  objIteEnt := TItensEntrada.Create;
  blnEhItensEntrada := True;

  LTabPre := '1';
  Try
    if (Assigned(fatVenda)) and (not fEmptyStr(fatVenda.strTabPre)) then
      LTabPre := fatVenda.strTabPre;

    objIteEnt.fCarregaItensNotaEntrada(
      pgbProgresso,
      fIncluirItem,
      strClienteFilial,
      (Pos(strOpcDoc, 'OU_OF_') > 0),
      LTabPre,
      blnConEqu,
      fatVenda.fEmpresaParaFaturamentoUsaWMS(IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text)),
      IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
      fatVenda.fDocumentoParaFornecedor);

    blnEhItensEntrada := False;

    If (Pos(strOpcDoc, 'VN_NE_') > 0) Then
    Begin
      If ((fatVenda.fDocumentoParaFornecedor) And (objIteEnt.blnPrecoFaturamento)) Or
         (Not (fatVenda.fDocumentoParaFornecedor)) Then
        pRecalculaPrecos;
      pCalculaTotais;
    End;
  Finally
    FreeAndNil(objIteEnt);
  End;
end;

