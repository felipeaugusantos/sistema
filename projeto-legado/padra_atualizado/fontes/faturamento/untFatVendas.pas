begin
  Result := (Self.blnAjustaDesconto Or Self.blnAjustaPrecoVenda); 
end;

function TfrmFatVendas.fRecalculaPrecosInterna(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    fltUnitar,
    fltDesMax,
    fltPreEmbFec,
    fltComTbl: Double;
    strIdePro: String;
    strTabela: String;
    strEmpItePro: String;
    fltQtdDis,
    fltUniLot: Double;
    fltUniDol: Double;
    blnParticiona: Boolean;
    blnPromo: Boolean;
    blnItemEntrouOuSaiuDePromocao: Boolean;
    blnLimpouDicionario: Boolean;
    strTabPreEmbTmp: String;
    fltImcSTPV : Double;
    blnCalcST : Boolean;
    strCodSit : String;
    fltDedCus : Double;
    fltUniDigOriginal: Double;
    blnProCndAnt: Boolean;
    fltPercDesEmbFec: Double;
    strCliFilDestaEmpresa: String;
    blnAlternouEntreClienteFilialClienteComum: Boolean;
    blnAlternouEntreDoisClientesFiliais: Boolean;
    blnChamouRecalculoTabelaPrecoTinta: Boolean;
    fltComLiq,
    fltVlrCam : Double;
    blnAplicarTaxaJuros : Boolean;

  function fEmpIte: String;
  Begin
    Result := IIF(fEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsVenda.FieldByName('ITE_EMPITE').AsString);
  End;

  procedure pAbreQryConIte;
  begin
    If (Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado) Or
       (qryConIte.FieldByName('ITE_CODITE').AsString <> cdsVenda.FieldByName('ITE_CODITE').AsString) Or
       (qryConIte.FieldByName('ITE_CODEMP').AsString <> fatVenda.fGetEmpPrecoVendaItem(fRetEmpresaItem)) Then
    Begin
      qryConIte.Close;
      qryConIte.ParamByName('CODITE').AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;
      qryConIte.ParamByName('CODEMP').AsString := fatVenda.fGetEmpPrecoVendaItem(fRetEmpresaItem);
      qryConIte.Open;
    End;
  end;

  function fRetornaPromocaoOriginal: String;
  Begin
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
      Result := fCampoTabela('FDO_PROMOC', 'FATDOR', ['AUTOINCREM'], [cdsVenda.FieldByName('ITE_SEQDET').AsString], False)
    Else
      Result := cdsVenda.FieldByName('ITE_PROMOC').AsString;
  End;

  function fRestaurarValorItemEstruturaComRateio: Boolean;
  begin
    Result := False;

    if (intSeqItemEstruturaRecalcular > 0) then
      Exit;

    if (fEmptyStr(cdsVenda.FieldByName('ITE_ITEEST').AsString)) then
      Exit;

    if (fCfgSis('RATEST', varString) <> 'S') then
      Exit;

    if (cdsVenda.FieldByName('ITE_ESTORI').AsFloat <= 0) then
      Exit;

    Result := True;
  end;

  function fRecalculaCustos(const strTabela : String): Boolean;
  begin
    Result := True;

    If Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado Then
      Result := False;

    With cdsVenda Do
    Begin
      If (FieldByName('ITE_IDEPRO').AsString = 'NOR') And
         (Not fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString)) And
         (FieldByName('ITE_PROACA').AsInteger <> 1) Then
      Begin
        If (fCfgSis('IMPCF4') = 'S') Then
          FieldByName('ITE_ICMSAI').AsFloat := fatVenda.fCalculaAliquota(FieldByName('ITE_CODITE').AsString,
                                                                         FieldByName('ITE_EMPITE').AsString,
                                                                         FieldByName('ITE_IMPDIR').AsString);

        //Caso o produto tenha entrado ou saído de promoção deve recalcular o preco de custo (Req: 100862)
        If (Not blnItemEspecial) And
           ((Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado And (fatVenda.strPromoc <> 'S')) Or
            ((blnItemEntrouOuSaiuDePromocao) And (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao))) Then
        Begin
          If (Not Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado) Then
          Begin
            //Se Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado = True já carregou para verficar a diferença de custo.
            pAbreQryConIte;
            fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                          qryConIte.FieldByName('ITE_CODEMP').AsString,
                                          strTabela);
          End;

          If (fatVenda.strPromoc = 'S') And (fatVenda.fltProPreCus > 0) Then
            FieldByName('ITE_CUSITE').AsFloat := fatVenda.fltProPreCus
          Else
            FieldByName('ITE_CUSITE').AsFloat := fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat);

          fatVenda.fltPreCus := FieldByName('ITE_CUSITE').AsFloat;

          pCalculaPrecoCusto(qryConIte,
                             FieldByName('ITE_UNITAR').AsFloat,
                             FieldByName('ITE_CUSITE').AsFloat,
                             blnItemEspecial,
                             fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString),
                             FieldByName('ITE_ICMSAI').AsFloat);

          FieldByName('ITE_PRECUS').AsFloat := fatVenda.fltPreCus;
          FieldByName('ITE_PRECU2').AsFloat := fatVenda.fltPreCu2;

          FieldByName('ITE_TOTCUS').AsFloat := fatVenda.fltPreCus * FieldByName('ITE_QTDITE').AsFloat;
          FieldByName('ITE_TOTCU2').AsFloat := fatVenda.fltPreCu2 * FieldByName('ITE_QTDITE').AsFloat;

          If Self.blnRecalculaCustosComPrecosNovosMasMantemPrecoDigitado Then
            Result := True;
        End;
      End;
    End;
  end;

  procedure pRecalculaCat17(const strTabela : String);
  begin
    With cdsVenda Do
    Begin
      strNotUltCat17 := '';
      If (Pos(fCfgSis('MCAT17'),'D_A_C_M_V_') > 0) And (strIdePro = 'NOR') Then
      Begin
        pAbreQryConIte;

        fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                      qryConIte.FieldByName('ITE_CODEMP').AsString,
                                      strTabela);

        fltDedCus := fatVenda.fRetornaPrecoCustoDeduzindoRessarcimentoCAT(
                                               FieldByName('ITE_CODITE').AsString,
                                               FieldByName('ITE_EMPITE').AsString,
                                               fatVenda.fGetCodAbf(FieldByName('ITE_CODITE').AsString, fatVenda.fGetEmpCalculoItem(FieldByName('ITE_EMPITE').AsString)),
                                               FieldByName('ITE_CODFOR').AsString,

                                               IIF(((strIdePro = 'NOR') And
                                                    (fatVenda.strPromoc = 'S') And
                                                    (fatVenda.fltProPreCus > 0) And
                                                    (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao)),
                                                  fatVenda.fltProPreCus,
                                                  fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)),

                                               strNotUltCat17);

        If (strIdePro = 'NOR') And
           (fatVenda.strPromoc = 'S') And
           (fatVenda.fltProPreCus > 0) and
           (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
        begin
          FieldByName('ITE_CUSITE').AsFloat := IIF((fltDedCus > 0), fltDedCus, fatVenda.fltProPreCus)
        end
        Else
          FieldByName('ITE_CUSITE').AsFloat := fatVenda.fRetornaPrecoCusto(Preco_de_Custo,
                                                   FieldByName('ITE_CODITE').AsString,
                                                   FieldByName('ITE_EMPITE').AsString,
                                                   IIF((fltDedCus > 0), fltDedCus, fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)),
                                                   '',
                                                   Nil,
                                                   (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));

        fatVenda.fltPreCus := FieldByName('ITE_CUSITE').AsFloat;

        pCalculaPrecoCusto(qryConIte,
                           FieldByName('ITE_UNITAR').AsFloat,
                           FieldByName('ITE_CUSITE').AsFloat,
                           blnItemEspecial,
                           fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString),
                           FieldByName('ITE_ICMSAI').AsFloat);

        FieldByName('ITE_PRECUS').AsFloat := fatVenda.fltPreCus;
        FieldByName('ITE_PRECU2').AsFloat := fatVenda.fltPreCu2;

        FieldByName('ITE_TOTCUS').AsFloat  := fatVenda.fltPreCus * FieldByName('ITE_QTDITE').AsFloat;
        FieldByName('ITE_TOTCU2').AsFloat  := fatVenda.fltPreCu2 * FieldByName('ITE_QTDITE').AsFloat;
        FieldByName('ITE_NOTC17').AsString := strNotUltCat17;
      End;
    End;
  end;

  procedure pRecalculaMargemLucro;
  begin
    With cdsVenda Do
    Begin
      strCodSit := '';
      If (Not fEmptyStr(fatVenda.fTrocaUFEndEntrega)) And (Not fEmptyStr(fatVenda.GetTipAbf(FieldByName('ITE_EMPITE').AsString))) And (fatVenda.fBuscaAbfIcm(cdsVenda.FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, cdsVenda.FieldByName('ABF_CODABF').AsString, fatVenda.fTrocaUFEndEntrega)) Then
        strCodSit := fatVenda.cdsAbfIcm.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(FieldByName('ITE_EMPITE').AsString)).AsString;

      fltComLiq := 0;
      If (fatVenda.blnEmCampanha) And
         (fCfgSis('MARMKP') = '4') Then
      Begin
        fatVenda.objCamGer.objCamDet.fVerificaProdutoCampanha(fatVenda.strCodCli,
                                                              FieldByName('ITE_CODITE').AsString,
                                                              EmptyStr,
                                                              EmptyStr,
                                                              0,
                                                              fltVlrCam,
                                                              fatVenda.strCodCmg,
                                                              fltComLiq);
      End;

      fatVenda.objIcStPv.pAdd(FieldByName('ITE_CODITE').AsString,
                              fatVenda.fGetEmpCalculoItem(FieldByName('ITE_EMPITE').AsString),
                              fatVenda.GetTipAbf(FieldByName('ITE_EMPITE').AsString),
                              fatVenda.fUFDestTrib(FieldByName('ITE_EMPITE').AsString),
                              strCodSit,
                              fltImcSTPV,
                              blnCalcST,
                              0,
                              fltComLiq);

      FieldByName('ITE_MARLUC').AsFloat := fCalculaPrecoVenda(2, FieldByName('ITE_PRECUS').AsFloat,
                                                                 FieldByName('ITE_UNITAR').AsFloat,
                                                                 0,
