function fRetornaValorUnitarioLiquidoTab(fatVenda: TFatVenda; strCodIte: String; fltUnitarTmp, fltDesCon:Double): Double;
  var
    fltUniLiqTmp: Double;
begin
  fltUniLiqTmp := fltUnitarTmp;

  {************************************************************************}
  {* COMENTADO PELO REQUISITO 139900 POIS ELE ESTAVA APLICANDO O JUROS DA *}
  {* CONDIÇÃO DUAS VEZES                                                  *}
  {*********************************************************************VA*}
  {If Not ((fatVenda.strJurPro = 'N') And (fatVenda.strPromoc = 'S')) Then
  Begin
    If fatVenda.fAplicaTaxaJuros Then
    Begin
      fatVenda.fltTaxJur := fatVenda.fltTaxVpr;
      fltUniLiqTmp   := fltUniLiqTmp + (fltUniLiqTmp * fatVenda.fltTaxJur / 100.0);
    End;
  End;}

  fltUniLiqTmp := fltUniLiqTmp - fatVenda.fRetornaVrDesconto(2, fltUniLiqTmp, fltDesCon);
  Result := fFormataFloat(fltUniLiqTmp, fatVenda.fMaxDecUni);
end;

function TfrmFatVendas.fCalcularValorComImpostos(const AFatVenda: TFatVenda;
                                                 const ACodigoItem : String;
                                                 const ATotalDoItemSemImpostos : Double;
                                                 const ACdsDadosItens: TUniClientDataSet) : Double;
  Var
    LRecGer : TRefTribCabecalho;
    LRecDet : TRefTribItem;
    LRetorno : TArrRefTribRetorno;
    LRecImposto : TCalculaImpostoItemSelecionado;
    LMatriz : TMatrizFechamento;
    LImpostosAtuais : Double;
begin
  If fEmptyStr(ACodigoItem) or (ATotalDoItemSemImpostos = 0) or (Not Assigned(AFatVenda)) Then
    Exit(ATotalDoItemSemImpostos);

  If (ACdsDadosItens = Nil) Then
  Begin
    FillChar(LRecImposto, SizeOf(LRecImposto), #0);
    LRecImposto.Unitario := fStrToFloat(edtUnitar.Text);
    LRecImposto.PercentualDesconto := fStrToFloat(edtDesCon.Text);
    LRecImposto.Quantidade := fStrToFloat(edtQtdIte.Text);
    If (LRecImposto.Quantidade = 0) Then
      LRecImposto.Quantidade := 1;
    LRecImposto.UnitarioLiquido := fRetornaValorUnitarioLiquidoTab(AFatVenda, ACodigoItem, fStrToFloat(edtUnitar.Text), fStrToFloat(edtDesCon.Text));
    LRecImposto.TotalDoItem := ATotalDoItemSemImpostos;
    LMatriz := fCalcularImpostosItemSelecionado(LRecImposto);

    If (Length(LMatriz) = 0) Then
      Exit(ATotalDoItemSemImpostos);

    Exit(ATotalDoItemSemImpostos + TTotalDesejadoDoItem.ImpostosQueSomamAoValorFinal(LMatriz[0]));
  End;

  LImpostosAtuais := ACdsDadosItens.FieldByName('ITE_VALRET').AsFloat + ACdsDadosItens.FieldByName('ITE_VALIPI').AsFloat;
  If (ACdsDadosItens.FieldByName('ITE_VALRET').AsFloat > 0) Then
    LImpostosAtuais := LImpostosAtuais + ACdsDadosItens.FieldByName('ITE_VALFCP').AsFloat;

  If AFatVenda.fZerarReformaTributariaEspeciesMIFF(ACdsDadosItens.FieldByName('ITE_ESPDEV').AsString) Then
    Exit(ATotalDoItemSemImpostos + LImpostosAtuais);

  LRecGer := Default(TRefTribCabecalho);
  LRecGer.strTipoOperacao := 'V';
  LRecGer.strEspecieDocumento := AFatVenda.strEspDoc;
  LRecGer.strTipoPessoa := IIF(AFatVenda.fDocumentoParaFornecedor, 'F', 'C');
  LRecGer.strCodigoPessoa := edtCodCli.Text;
  LRecGer.strVendaPresencial := IIF(chkVenPre.Checked, 'S', 'N');

  If fEmptyStr(AFatVenda.strAutEnt) Then
    LRecGer.strCidadeEntrega := fCampoTabela('CLI_CODCID', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text], False)
  Else
    LRecGer.strCidadeEntrega := fCampoTabela('ETC_CIDENT', 'ENTCLI', ['AUTOINCREM'], [AFatVenda.strAutEnt], False);

  LRecDet := Default(TRefTribItem);
  LRecDet.strCodigoItem := ACodigoItem;
  LRecDet.strIdItem := ACodigoItem;
  LRecDet.fltValorItem := ATotalDoItemSemImpostos;
  LRecDet.strEmpresa := ACdsDadosItens.FieldByName('ITE_EMPITE').AsString;
  LRecDet.strEntregaRetira := ACdsDadosItens.FieldByName('ITE_ENTRET').AsString;
  LRecDet.strCfop := IfEmptyStr(ACdsDadosItens.FieldByName('ITE_CLAFIS').AsString, ACdsDadosItens.FieldByName('ITE_CLATGE').AsString);
  LRecDet.strReferenciaDevolucao := IIF(AFatVenda.blnEstornoNotaFiscal, ACdsDadosItens.FieldByName('ITE_INCDEV').AsString, ACdsDadosItens.FieldByName('ITE_AIDVOR').AsString);
  LRecDet.strOrigemReferencia := fRefTribOrigemReferencia(ACdsDadosItens.FieldByName('ITE_TABDEV').AsString);
  LRecDet.fltDesconto := ACdsDadosItens.FieldByName('ITE_DESESP').AsFloat;
  LRecDet.fltFrete := ACdsDadosItens.FieldByName('ITE_TOTFRE').AsFloat;
  LRecDet.fltDespesaAcessoria := ACdsDadosItens.FieldByName('ITE_DESACE').AsFloat;
  LRecDet.fltValorIcms := ACdsDadosItens.FieldByName('ITE_VALICM').AsFloat;
  LRecDet.fltValorPis := ACdsDadosItens.FieldByName('ITE_VALPIS').AsFloat;
  LRecDet.fltValorCofins := ACdsDadosItens.FieldByName('ITE_VALCOF').AsFloat;
  LRecDet.fltValorFcp := ACdsDadosItens.FieldByName('ITE_VALFCP').AsFloat;
  LRecDet.fltValorDifal := ACdsDadosItens.FieldByName('ITE_VDIFAL').AsFloat;

  LRetorno := TRefTribCalculo.fCalcular(LRecGer, [LRecDet]);

  If (Length(LRetorno) > 0) Then
    Result := ATotalDoItemSemImpostos + LImpostosAtuais + LRetorno[0].TotalNovosImpostos
  Else
    Result := ATotalDoItemSemImpostos + LImpostosAtuais;
end;

