            recItemPedido.strEmpOrc := qryGenDor.FieldByName('FDO_CODEMP').AsString;
            recItemPedido.strCodIte := qryGenDor.FieldByName('FDO_CODITE').AsString;
            recItemPedido.intSeqInd := qryGenDor.FieldByName('FDO_SEQIND').AsInteger;
            recItemPedido.fltQtdOri := qryGenDor.FieldByName('FDO_QTDORI').AsFloat;
            recItemPedido.fltQtdBai := qryGenDor.FieldByName('FDO_QTDBAI').AsFloat;
            recItemPedido.fltQtdIte := qryGenDor.FieldByName('FDO_QTDITE').AsFloat;
            recItemPedido.fltDesEsp := qryGenDor.FieldByName('FDO_DESESP').AsFloat;
            recItemPedido.fltDesBai := qryGenDor.FieldByName('FDO_DESBAI').AsFloat;
            recItemPedido.strSeqDet := qryGenDor.FieldByName('AUTOINCREM').AsString;
            recItemPedido.strIncFut := qryGenDor.FieldByName('FDO_INCFUT').AsString;
