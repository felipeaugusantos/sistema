    Result := RecordCount > 0;
  End;
  FreeAndNil(cdsDados);
End;

function TfrmFatVendas.fVerificaUnanimidadeDataDeEntrega: TRecUnanimidadeDataEntrega;
  Var
    cdsDados: TUniClientDataSet;
begin
  FillChar(Result, SizeOf(Result), #0);

  If cdsVenda.IsEmpty Then
    Exit;

  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.First;
    Result.dtaDataDeEntrega := cdsDados.FieldByName('ITE_DTENTR').AsDateTime;
    cdsDados.Filtered := False;
    cdsDados.Filter := Format('ITE_ENTFUT = %s AND ITE_ENTRET = %s AND ITE_DTENTR <> %s', [QuotedStr('N'), QuotedStr('E'), QuotedStr(FormatDateTime('yyyy-mm-dd', Result.dtaDataDeEntrega))]);
    cdsDados.Filtered := True;
    Result.blnDataDeEntregaEhUnanimidade := (cdsDados.IsEmpty);
  Finally
    FreeAndNil(cdsDados);
  End;
end;

