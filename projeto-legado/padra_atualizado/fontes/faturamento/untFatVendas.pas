procedure TfrmFatVendas.edtPerApaExit(Sender: TObject);
var
  intAutInc: Integer;
begin
  inherited;
  if (fCfgSis('PERMAD', varBoolean)) and (StrToFloatDef(edtPerApa.Text, 0) <> fltPerApaAnt) then
  begin
    intAutInc := 0;
    If fAlterandoProduto Then
      intAutInc := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

    if StrToFloatDef(edtPerApa.Text, 0) > fCfgSis('PERAPA', varDouble) then
    begin
      if not fEmptyStr(fCfgSis('SEAUPE', varString)) then
      begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Senha para aumentar o percentual de sugestão de aparelhamento');
        objLiberacao.objMsgLibera.pAddSeparador(75);
        objLiberacao.objMsgLibera.pAddTexto('Item: ' + edtCodIte.Text + ' - ' +  LeftStr(edtDesIte.Text,50));
        objLiberacao.objMsgLibera.pAddTextoCaption('Percentual padrão'        , FloatToStrF(fCfgSis('PERAPA', varDouble),ffNumber,5,2), 24);
        objLiberacao.objMsgLibera.pAddTextoCaption('Percentual alterado'      , FloatToStrF(fStrToFloat(edtPerApa.Text) ,ffNumber,5,2), 24);

        objLiberacao.strDirAce := 'SEAUPE';
        objLiberacao.strSenLib := fCfgSis('SEAUPE');
        objLiberacao.strMsgSen := 'Senha para aumentar o percentual de sugestão de aparelhamento';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;
        objLiberacao.intAutInc := intAutInc;
        objLiberacao.strCodIte := edtCodIte.Text;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
        objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

        if (not fatVenda.fFatMensagemLiberacao(objLiberacao)) then
        begin
          fMensagem('','Senha incorreta!',['&OK']);
          edtPerApa.Text := FormatFloat('#,##0.00', fCfgSis('PERAPA', varDouble));
        end;
      end;
    end
    else
    if StrToFloatDef(edtPerApa.Text, 0) < fCfgSis('PERAPA', varDouble) then
    begin
      if not fEmptyStr(fCfgSis('SEDIPE', varString)) then
      begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Senha para diminuir o percentual de sugestão de aparelhamento');
        objLiberacao.objMsgLibera.pAddSeparador(75);
        objLiberacao.objMsgLibera.pAddTexto('Item: ' + edtCodIte.Text + ' - ' +  LeftStr(edtDesIte.Text,50));
        objLiberacao.objMsgLibera.pAddTextoCaption('Percentual padrão'        , FloatToStrF(fCfgSis('PERAPA', varDouble),ffNumber,5,2), 24);
        objLiberacao.objMsgLibera.pAddTextoCaption('Percentual alterado'      , FloatToStrF(fStrToFloat(edtPerApa.Text) ,ffNumber,5,2), 24);

        objLiberacao.strDirAce := 'SEDIPE';
        objLiberacao.strSenLib := fCfgSis('SEDIPE');
        objLiberacao.strMsgSen := 'Senha para diminuir o percentual de sugestão de aparelhamento';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;
        objLiberacao.intAutInc := intAutInc;
        objLiberacao.strCodIte := edtCodIte.Text;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
        objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

        if (not fatVenda.fFatMensagemLiberacao(objLiberacao)) then
        begin
          fMensagem('','Senha incorreta!',['&OK']);
          edtPerApa.Text := FormatFloat('#,##0.00', fCfgSis('PERAPA', varDouble));
        end;
      end;
    end;
  end;
end;

