function TfrmFatVendas.fValidarValorMinimoVendaPrazoParcelaMinimaCartao(): Boolean;
begin
  Result := True;

  {*******************************************}
  {* CONFIGURAÇÃO PARA TRAVA DE VALOR MINIMO *}
  {* PARA VENDA A PRAZO                      *}
  {*************************************MV/RV*}
  If (fCfgSis('CNDVEN') = 'I') And (Pos(strOpcDoc,'OU_OV_OF_BR_TE_NC_DV_PR_OE_EF_UC_DD_') <= 0) Then
  Begin
    If (Not fatVenda.fValidaValorMinimoVendaPrazo(mskCndPag.Text)) Then
    Begin
      Result := False;
      Exit;
    End;

    If (Pos(strOpcDoc, 'PD_OR_') > 0) And
       (Pos(edtForPag.Text, '007_') > 0) And
       fatVenda.VS_blnUsaFpg And Result And
       fCfgSis('SOLCAR', varBoolean) Then
    Begin
      FVariaveisFechamentoVenda.fltParMin := fStrToFloat(fCampoTabela('CAR_PARMIN', 'CADCAR', ['CAR_CODCAR'], [fatVenda.strCodCar]));

      If (Not fatVenda.fVerificaParMinCartao(fatVenda.intQtdPaC, FVariaveisFechamentoVenda.fltParMin)) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

end;

