procedure TfrmFatVendas.pVendasPorLinha;
Begin

  If (Pos(VS_strCodEmp, strEmpConsVendFatur) <= 0) Then
  Begin
    fMensagem('ATENÇÃO!', 'Usuário sem permissão de acesso a essa Empresa!', ['&O k']);
    InterlockedDecrement(intConfirmando);
  End
  Else
  Begin

    If Not fVerificaAcessoSistema('F11VDL') Then
    Begin
      fMensagem('', 'Operador não tem direito de acesso em Vendas por Linha!', ['&O k']);
      Exit;
    End;

    If (Not fatVenda.fDocumentoParaFornecedor) Then
    Begin
      If (InterlockedIncrement(intConfirmando) = 0) Then
      Begin
        Try
          pCriarFormularios(TfrmRelFatVendasCliente, frmRelFatVendasCliente);
          frmRelFatVendasCliente.blnFaturamento         := True;
          frmRelFatVendasCliente.blnSenha               := True;
          frmRelFatVendasCliente.blnVeioDoTelemarketing := True;
          frmRelFatVendasCliente.blnPorVendedor         := True;
          frmRelFatVendasCliente.blnPorLinha            := True;
          frmRelFatVendasCliente.edtCodVendedor.Text    := edtSenVen.Text;
          frmRelFatVendasCliente.blnSomenteVendas       := True;
          frmRelFatVendasCliente.strCodVen              := edtSenVen.Text;
          frmRelFatVendasCliente.oleVendas              := cdsVenda.Data;
          frmRelFatVendasCliente.edtCodCliente.Text     := edtCodCli.Text;
          frmRelFatVendasCliente.edtDesCliente.Text     := edtnomCli.Text;
          frmRelFatVendasCliente.ShowModal;

          InterlockedDecrement(intConfirmando);
        Except
          On E: Exception Do
          Begin
            InterlockedDecrement(intConfirmando);
            pMensagensErro(E.Message, '[pVendasPorLinha]');
          End;
        End;

        pFreeAndNil(frmRelFatVendasCliente);

      End
      Else
      Begin
        InterlockedDecrement(intConfirmando);
      End;
    End;

  End;
End;

