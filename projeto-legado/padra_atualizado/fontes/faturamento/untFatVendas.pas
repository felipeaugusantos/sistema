procedure TfrmFatVendas.pExibeInformacoesFlex;
  Var
    fltSldVenFle : Double;
    strCodOpe: String;
begin
  strCodOpe := IIF(fCfgSis('USADIG', varBoolean), edtSenVen.Text, fRetCodVendedor(edtSenVen.Text));

  fltSldVenFle := TMovFlex.fSaldoFlexDisponivelVendedor(strCodOpe,
    IIF(Not fEmptyStr(strNumOrc), strNumOrc, ''),
    IIF(Not fEmptyStr(strNumOrc), strEmpOrc, ''));

  lblSldFle.Caption := 'SALDO FLEX: ' + FormatFloat('#,##0.00', fltSldVenFle);

  lblFleAtu.Visible := False;
  If (VS_strTRVEPR = '1') Then
  Begin
    If blnAtualizaFlexPedido Then
    Begin
      blnAtualizaFlexPedido := False;
      pProcessaCalculoFlex;
    End;

    lblFleAtu.Visible := True;
    lblFleAtu.Caption := 'SALDO FLEX ATUALIZADO: ' + FormatFloat('#,##0.00', fatVenda.fGetValFleCalc(fltSldVenFle));
  End;
