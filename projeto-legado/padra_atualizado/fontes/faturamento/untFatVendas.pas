function TfrmFatVendas.MudaStatusPixGeradoSemReceber(const AblnCancelarPixSemPerguntar: boolean): Boolean;
begin
  Result := Not Assigned(fatVenda.DadosPixDaVenda.ObjetoPixPago);

  If Result Then
    Exit;

  Result := Not fatVenda.DadosPixDaVenda.TxIdPix.IsEmpty;

  If Result Then
    Exit;

  Result := TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(fatVenda.DadosPixDaVenda.ObjetoPixPago);

  If Not Result Then
  Begin
    Result := (AblnCancelarPixSemPerguntar) or (fMensagem('ATENÇÃO', 'Foi gerada uma cobrança Pix para o recebimento.' + #13 +
                                   'Se continuar, o sistema cancelará o registro do Pix junto ao banco.' + #13 +
                                   'Deseja realmente continuar?', ['&Sim', '&Não'], 2) = 1);

    If Not Result Then
      Exit;

    TfrmGravando.fExecutarModal(ChamarTelaMudarStatusPix, 'Aguarde... Cancelando a cobrança do Pix.', '');

    fatVenda.DadosPixDaVenda.ObjetoPixPago := Nil;
    fatVenda.DadosPixDaVenda.JaGerouPix := False;
    FDadosRetornoPix := '';
  End;
end;

