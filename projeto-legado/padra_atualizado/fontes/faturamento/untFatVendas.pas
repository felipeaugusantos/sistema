procedure TfrmFatVendas.pSetaComboOperacaoUsoConsumoRevenda;
begin
  If Assigned(fatVenda) Then
    pSetaVisibilidadeUsoConsumoRevenda((Pos('CCO',fatVenda.GetTipAbf) > 0) Or (Pos('CNC',fatVenda.GetTipAbf) > 0) Or (Pos('IND',fatVenda.GetTipAbf) > 0));

  If fatVenda.strTpOper = 'USO/CONSUMO' Then
    cbbUsoConsRev.ItemIndex := IDX_USO_CONSUMO
  Else If fatVenda.strTpOper = 'REVENDA' Then
    cbbUsoConsRev.ItemIndex := IDX_REVENDA
  Else If fatVenda.strTpOper = 'INDUSTRIALIZAÇÃO' Then
    cbbUsoConsRev.ItemIndex := IDX_PRODUCAO
  Else If fatVenda.strCliCon = 'S' Then
    cbbUsoConsRev.ItemIndex := IDX_USO_CONSUMO
  Else
    cbbUsoConsRev.ItemIndex := IDX_REVENDA;

  If Assigned(fatVenda) Then
  Begin
    Case cbbUsoConsRev.ItemIndex Of
      IDX_USO_CONSUMO  : fatVenda.strTpOper := 'USO/CONSUMO';
      IDX_REVENDA      : fatVenda.strTpOper := 'REVENDA';
      IDX_PRODUCAO     : fatVenda.strTpOper := 'INDUSTRIALIZAÇÃO';
    End;
  End;
end;

