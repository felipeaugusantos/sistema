function TfrmFatVendas.fHaveraAlteracaoPrecosVendaPresencial(blnVenPre: Boolean):Boolean;
var
  cdsBackup: TUniClientDataSet;
  cdsVendaLocal: TUniClientDataSet;
  blnVendaPresencialBkp: Boolean;
  intRecNo: Integer;

  procedure pEfetuaBackupDados();
  begin
    pCloneDataSet(cdsVendaLocal, cdsVenda);

    cdsBackup := cdsVenda;

    intRecNo := cdsVenda.RecNo;

    blnVendaPresencialBkp := fatVenda.blnVendaPresencial;

    pSetCdsVenda(cdsVendaLocal);
  end;

  procedure pRestauraBackupDados();
  begin
    pSetCdsVenda(cdsBackup);
    cdsVenda.RecNo := intRecNo;
    fatVenda.blnVendaPresencial := blnVendaPresencialBkp;
  end;

  function fHaveraAlteracaoPrecos():Boolean;
  begin
    Result := False;

    fatVenda.blnVendaPresencial := blnVenPre;

    pRecalculaPrecos;

    Try
      cdsVenda.DisableControls;

      cdsVenda.First;
      While (Not cdsVenda.Eof) Do
      Begin
        If cdsBackup.Locate('AUTOINCREM', cdsVenda.FieldByName('AUTOINCREM').AsString, []) Then
        Begin
          If (Not (cdsVenda.FieldByName('ITE_UNITAR').AsFloat = cdsBackup.FieldByName('ITE_UNITAR').AsFloat)) Then
            Exit(True);
        End;

        cdsVenda.Next;
      End;
    Finally
      cdsVenda.EnableControls;
    End;
  end;
begin
  Result := False;

  If (cdsVenda.IsEmpty) Then
    Exit;

  cdsVendaLocal := TUniClientDataSet.Create(Self);

  Try
    pEfetuaBackupDados;

    Result := fHaveraAlteracaoPrecos;

    pRestauraBackupDados;
  Finally
    FreeAndNil(cdsVendaLocal);
  End;
end;

function TfrmFatVendas.fHouveAlteracaoOrcamento: Boolean;
const
  LLabels: array [0..10] of string = ('Cliente',
                                      'Cond. Pagto',
                                      'Form. Pagto',
                                      'Vendedor',
                                      'Tipo Frete',
                                      'Transportadora',
                                      'Desp. Aces.',
                                      'Desconto R$',
                                      'Desconto %',
                                      'Produtos incluídos',
                                      'Produtos alterados');
var
  LAlteracoes,
  LLabel: Variant;
begin
  Result := False;

  LAlteracoes := fObterDetalhesModificacaoPedOrc(True, fatVenda.fVerificaImpRateadoDescOrgaoPublico);

  for LLabel in LLabels do
  begin
    if (Pos(LLabel, LAlteracoes) > 0) then
    begin
      Result := True;
      Break;
    end;
  end;
end;

procedure TfrmFatVendas.chkVenPreClick(Sender: TObject);
  Var
    blnAcessoParaAlterarVendaPresencial: Boolean;
    strCodTip : String;
    blnDeveRecalcularPrecos: Boolean;
    blnTravou: Boolean;

  function fPerguntaAlteraPrecosVendaPresencial():Boolean;
  begin
    Result := (fMensagem('', 'A venda presencial influencia no preço de venda do '+
                             'item. Ao confirmar, os valores serão recalculados.' + #10+#13 +
                             'Deseja realmente continuar?', ['&Sim', '&Não'], 1) = 1);
  end;

  procedure pInverteCheckedSemDispararEventoClick();
  Var
    objEventoVenPreClick : TNotifyEvent;
  begin
    objEventoVenPreClick := chkVenPre.OnClick;
    try
      chkVenPre.OnClick := Nil;
      chkVenPre.Checked := (Not chkVenPre.Checked);
    finally
      chkVenPre.OnClick := objEventoVenPreClick;
    end;
  end;
begin
  inherited;

  blnTravou := False;
  blnDeveRecalcularPrecos := False;

  If Assigned(fatVenda) Then
  Begin
    blnAcessoParaAlterarVendaPresencial := fVerificaAcessoSistema('ALTVPR', strLoginUsuarioLogado);

    If (Not blnAcessoParaAlterarVendaPresencial) And (chkVenPre.Visible) And (blnEntrouVenPre) Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Liberação para alterar o campo venda presencial');
      objLiberacao.objMsgLibera.pAddTexto('');
      objLiberacao.objMsgLibera.pAddTexto('Cliente: ' + fatVenda.strCodCli + ' - ' + fRetNomCliente(fatVenda.strCodCli));
      objLiberacao.objMsgLibera.pAddTexto('CPF/CNPJ: ' + fFormataCpfCgc(fatVenda.strCliCgc, fSetaPais));
      objLiberacao.objMsgLibera.pAddTexto('Cidade: ' + fatVenda.strCliCid + ' - ' + fatVenda.strCliEst);

      If (fCfgSis('USATPC', varBoolean)) Then
      Begin
        strCodTip := fRetTipoCliente(fatVenda.strCodCli);
        objLiberacao.objMsgLibera.pAddTexto('Tipo Cliente: '+ strCodTip + ' - ' + fRetDescTipoCli(strCodTip));
      End;

      objLiberacao.strDirAce  := 'ALTVPR';
      objLiberacao.strMsgSen  := 'Sem direito de acesso para alterar o campo venda presencial!';
      objLiberacao.strCodOpe  := fatVenda.strCodVen;
      objLiberacao.strCodDig  := fatVenda.strCodDig;

      If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Begin
        pInverteCheckedSemDispararEventoClick;
        blnTravou := True;
      End;

    End;

    If (Not blnTravou) Then
      blnDeveRecalcularPrecos := blnEntrouVenPre And
                                 (chkVenPre.Checked <> fatVenda.blnVendaPresencial) And
                                 fHaveraAlteracaoPrecosVendaPresencial(chkVenPre.Checked);

    If (Not blnDeveRecalcularPrecos) Or (blnTravou) Then
    Begin
      fatVenda.blnVendaPresencial := chkVenPre.Checked;
    End
    Else If blnDeveRecalcularPrecos And fPerguntaAlteraPrecosVendaPresencial Then
    Begin
      fatVenda.blnVendaPresencial := chkVenPre.Checked;
      pRecalculaPrecos;
      pCalculaTotais;
    End
    Else
    Begin
      pInverteCheckedSemDispararEventoClick;
      fatVenda.blnVendaPresencial := chkVenPre.Checked;
    End;
  End;
end;

