                pCalculaTotais;
              End;

            End;

            InterlockedDecrement(intConfirmando);
          End
          
          Else If (strOpcDoc = 'CT') Then
          Begin
            edtCodCli.Enabled := False;
            InterlockedIncrement(intConfirmando);
            {*****************************************}
            {* SE NÃO CONFIRMAR, NÃO FAZ NADA        *}
            {**************************************MV*}
            If (Not fConfirmaTransfEstoque) Then
            Begin
              Result := False;
              edtCodCli.Enabled := True;
            End;

            {*****************************************}
            {* CASO CONFIRMAR OS DOCUMENTOS, CARREGA *}
            {* OS ITENS NA TELA                      *}
            {**************************************MV*}
            If Result Then
            Begin

              {***************************************************************}
              {* VERIFICA NA CONFIRMAÇÃO SE O CLIENTE PARA O QUAL ESTÁ SENDO *}
              {* CONFIRMADOS OS DOCS É CLIENTE CONSUMIDOR                    *}
              {************************************************************LU*}
              If (fClienteConsumidor(qryConCli.FieldByName('CLI_NOMCLI').AsString, False, True)) Then
              Begin
                pInformacoesClienteRodape;

                If (Not fatVenda.blnGraCon) Then
                Begin
                  If fDadosCons Then
                  Begin
                    fatVenda.blnGraCon := True;
                    fatVenda.strConPag := '01000';
                    mskCndPag.Text     := '01000';
                    mskCndPag.Enabled  := False;
                  End
                  Else
                    fatVenda.blnGraCon := False;

                  pSetFocus(Self);
                End;

              End;

              Try
                pCriarFormularios(TfrmGravando, frmFechamentoVenda);
                frmFechamentoVenda.fExecutarAcao := fCarregaItensConfirmacaoTransfEstoque;
                frmFechamentoVenda.ShowModal;
                Result := frmFechamentoVenda.blnConfirma;
              Except
                On E: Exception Do
                Begin
                  Result := False;
                  pMensagensErro(E.Message, '');
                End;
              End;

              pFreeAndNil(frmFechamentoVenda);

              blnMudarFoco := False;
              pHabilitaCamposItem(False);
              dbgItens.Enabled := False;
              btnAdicionar.Enabled   := False;
              btnCancelaItem.Enabled := False;
              edtCodCli.Enabled := False;

              If (fCfgSis('USADIG', varBoolean)) Then
              Begin
                edtSenVen.Text := fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_CODVEN').AsString;
                edtNomVen.Text := fRetNomVendRep(edtSenVen.Text);
                strVenAnt      := edtSenVen.Text;
              End;

              If (Not Result) Then
              Begin
                Self.Close;
              End
              Else
              Begin
                fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo := (fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_REGES2').AsString = 'S');

                If (fCfgSis('USADIG', varBoolean)) And (Not blnCarregouSenhaVendedorAutomaticamente) Then
                Begin
                  pSetFocus(edtSenDig);
                End
                Else If fPermiteFocoCampoVendedor Then
                Begin
                  pSetFocus(edtSenVen);
                End;

                pAtualizaTemporaria;
                fExecutarModal(
                  function(pgbProgresso: TcxProgressBar): Boolean
                  begin
                    pCalculaTotais(False, -1, pgbProgresso);
                    Result := True;
                  end,
                  'Calculando Totais...',
                  ''
                );
              End;

            End;

            InterlockedDecrement(intConfirmando);

          End
          Else If Pos(strOpcDoc, 'CP_OV_') > 0 Then
          Begin
            edtCodCli.Enabled := False;
            {*****************************************}
            {* SE NÃO CONFIRMAR, NÃO FAZ NADA        *}
            {**************************************MV*}
            InterlockedIncrement(intConfirmando);
            If (Not fConfirmaPedido) Then
            Begin
              Result := False;
              edtCodCli.Enabled := True;
            End;

            {*****************************************}
            {* CASO CONFIRMAR OS DOCUMENTOS, CARREGA *}
            {* OS ITENS NA TELA                      *}
            {**************************************MV*}
            If Result Then
            Begin

              {***************************************************************}
              {* VERIFICA NA CONFIRMAÇÃO SE O CLIENTE PARA O QUAL ESTÁ SENDO *}
              {* CONFIRMADOS OS DOCS É CLIENTE CONSUMIDOR                    *}
              {************************************************************LU*}
              If (fClienteConsumidor(qryConCli.FieldByName('CLI_NOMCLI').AsString, False, True)) Then
              Begin
                pInformacoesClienteRodape;

                If (Not fatVenda.blnGraCon) Then
                Begin
                  If fDadosCons Then
                  Begin
                    fatVenda.blnGraCon := True;
                    fatVenda.strConPag := '01000';
                    mskCndPag.Text     := '01000';
                    mskCndPag.Enabled  := False;
                  End
                  Else
                    fatVenda.blnGraCon := False;

                  pSetFocus(Self);
                End;

              End;

              Try
                pCriarFormularios(TfrmGravando, frmAguarde);
                frmAguarde.fExecutarAcao := fCarregaItensConfirmacaoPedido;
                frmAguarde.ShowModal;
                Result := frmAguarde.blnConfirma;
              Except
                On E: Exception Do
                Begin
                  Result := False;
                  pMensagensErro(E.Message, '');
                End;
              End;

              pFreeAndNil(frmAguarde);

              blnMudarFoco := False;
              edtCodCnd.Text := fatVenda.strCodCnd;

              If fCfgSis('AJPZDF', VarBoolean) And (fCfgSis('CNDVEN') = 'I') Then
              Begin
                pCarregaCondicao;
                fatVenda.strConPag := mskCndPag.Text;
              End;

              edtDesCndPag.Text  := fRetDesConPag(edtCodCnd.Text);
              strCcnAnt := fatVenda.strCodCnd;
              mskCndPag.Text := fatVenda.strConPag;
              strCndAnt := fatVenda.strConPag;
              edtForPag.Text := fatVenda.strCodFpg;
              strFpgAnt := fatVenda.strCodFpg;
              pCarregaForPag;
              pHabilitaCamposItem(False);
              dbgItens.Enabled := False;
              btnAdicionar.Enabled   := False;
              btnCancelaItem.Enabled := False;
              edtCodCli.Enabled := False;

              If (Not fEmptyStr(fatVenda.strCodCnd)) And (fCfgSis('CNDVEN') = 'I') And
                 (fCfgSis('RECCND', varBoolean) And (fatVenda.strConPag <> '01999')) Then
              Begin
                fatVenda.pAtualizaInformacoesCondPagamento;
                fatVenda.pCalculaTaxVpr;
              End;

              If Not fatVenda.DadosPixDaVenda.TxIdPix.IsEmpty Then
              Begin
                mskCndPag.Enabled := False;
                edtCodCnd.Enabled := false;
              End
              Else
              Begin
                If fCampoTabela('CND_RECPIX', 'CADCND', ['CND_CODIGO'], [edtCodCnd.Text]) = 'S' Then
                Begin
                  fatVenda.DadosPixDaVenda.GerarPixDaVenda := True;
                  fatVenda.DadosPixDaVenda.AlterarCondicaoDePagamento := (Not MatchStr(fatVenda.strOpcDoc, ['VN'])) Or (Not fCfgSis('BAIAVI', varBoolean));
                End;
              End;

              pAtualizaUnitarioLiquido;

              If (fCfgSis('USADIG', varBoolean)) Then
              Begin
                edtSenVen.Text := fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_CODVEN').AsString;
                edtNomVen.Text := fRetNomVendRep(edtSenVen.Text);
                strVenAnt      := edtSenVen.Text;
                pCarregaVendedor(edtSenVen.Text);
              End;

              If (fCfgSis('REPVEN', varBoolean)) And (pnlRepresentante.Enabled) Then
              Begin
                edtCodRep.Text := fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_CODVE2').AsString;
                edtDesRep.Text := fRetNomVendRep(edtCodRep.Text);
                strRepAnt := edtCodRep.Text;
              End;

              If (Result) And (strOpcDoc <> 'OV') Then
                Result := fVerificaSaldosConfirmacaoPedidos;

              If (Result) And (strOpcDoc = 'CP') And (fCfgSis('CNDVEN') = 'I') And (fCfgSis('CNDICP') = 'S' {Pedir senha}) And
                 (Not fEmptyStr(edtCodCnd.Text)) And (Not fEmptyStr(mskCndPag.Text, True)) And (Not fEmptyStr(edtForPag.Text)) Then
              Begin
                edtCodCnd.ReadOnly := True;
                edtCodCnd.TabStop  := False;

                mskCndPag.ReadOnly := True;
                mskCndPag.TabStop  := False;

                edtForPag.ReadOnly := True;
                edtForPag.TabStop  := False;
              End;

              If (Not Result) Then
              Begin
                Self.Close;
              End
              Else
              Begin
                If (fCfgSis('CNDVEN') = 'I') And (pnlCndPag.Visible) And (pnlCndPag.Enabled) And (edtCodCnd.CanFocus) And (fEmptyStr(edtCodCnd.Text)) Then
                  pSetFocus(edtCodCnd)
                Else If (fCfgSis('CNDVEN') = 'I') And (pnlForPag.Visible) And (pnlForPag.Enabled) And (edtForPag.CanFocus) And (fEmptyStr(edtForPag.Text)) Then
                  pSetFocus(edtForPag)
                Else If (fCfgSis('USADIG', varBoolean)) And (Not blnCarregouSenhaVendedorAutomaticamente) Then
                  pSetFocus(edtSenDig)
                Else If fPermiteFocoCampoVendedor Then
                  pSetFocus(edtSenVen);

                pAtualizaTemporaria;
                pCalculaTotais;
              End;

            End;

            InterlockedDecrement(intConfirmando);

          End;

        End;

        If Result Then
        Begin
          {*****************************************}
          {* PEGA DADOS FISCAIS                    *}
          {**************************************MV*}
          fatVenda.pPegaDadosFiscais(fatVenda.fTrocaUFEndEntrega, fatVenda.strCliIes, fatVenda.strMicEmp, fatVenda.fGetUFEmpresa(''), True);

          If (fatVenda.strCodCli <> strCliAnt) And (Not fEmptyStr(strCliAnt)) And (Not fEmptyStr(fatVenda.strNumOrc)) Then
            blnRevalidarCondPgto := True;

          {***********************************************************************************}
          {* AO TROCAR UM CLIENTE DIFAL PARA UM NÃO DIFAL REVALIDA OS CONTROLES RELACIONADOS *}
          {********************************************************************************VA*}
          If (chkVenPre.Visible) And
             (fatVenda.blnVendaPresencial) And
             (fRevalidaVendaPresencialTrocaCliente) And
             (Not fatVenda.fAtendeRegrasDifal(True)) Then
          Begin
            fatVenda.blnVendaPresencial := False;
            pHabilitaChkVendaPresencial;

            If (Not fGridVendaVazio) Then
            Begin
              pRecalculaPrecos;
              pCalculaTotais;
            End;
          End;

          If (fatVenda.strCodCli <> strCliAnt) And (Not fEmptyStr(strCliAnt)) And (Not fGridVendaVazio) Then
          Begin
            With cdsVenda Do
            Begin
              DisableControls;
              First;
              While not eof do
              Begin
                fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
                pCalculaCustoRealTintaMaquinaSelecionado;
                Next;
              End;
              EnableControls;
            End;

            pCalculaTotais;
          End;

          strCliAnt := fatVenda.strCodCli;
          If Not strCliAnt.IsEmpty Then
            strUltCodCliValido := strCliAnt;
        End;

        If Result Then
        Begin
          If Not fEmptyStr(edtCodCnd.Text) Then
          Begin
            If Not fValidaCampos(edtCodCnd, False) Then
            Begin
              strCcnAnt := '';
              blnMudarFoco := False;
              pSetFocus(edtCodCnd);
            End;

            blnValidaCnd := True;
          End;
        End;

      End;

      If (Pos(strOpcDoc, 'CP_OV_') > 0) Then
        blnRecalcularPrecosAoMudarCondicaoDePagamento := True;

      {*************************************************}
      {* NÃO PERMITE VENDA A PRAZO PARA CLI-CONSUMIDOR *}
      {**********************************************AF*}
      If (edtCodCnd.Visible)             And
         (Not fEmptyStr(edtCodCnd.Text)) And
         (Not SameText(strOpcDoc, 'CP') Or (fEmptyStr(fatVenda.strConPag))) Then
      Begin
        pCarregaCondicao;
        fatVenda.strConPag := mskCndPag.Text;
      End;

      If (Result) And
         (fClienteConsumidor(fatVenda.strCliOri)) And
         (fStatusCndPag(fatVenda.strConPag) = A_PRAZO) And
         (fCfgSis('CNDVEN') = 'I') And
         (Not blnValidaCnd)        And
         (Not fCfgSis('PRZCON', varBoolean)) Then
      Begin
        fMensagem('ATENÇÃO!','A condição de pagamento não pode ser a prazo para cliente consumidor!',['&OK']);
        Result := False;
      End;

      If Result And
         (Pos(fCfgSis('ORCABR', varString), 'S_T_') > 0) And
         (Pos(strOpcDoc,'OR_PD_VN_CS_') > 0) And
         (Not fClienteConsumidor(qryConCli.FieldByName('CLI_NOMCLI').AsString, True, True)) And
         fExisteOrcamentoPendente(edtCodCli.Text, strNumOrc, '', fCfgSis('ORCABR', varString) = 'S') Then
      Begin
        stlPedidosTodasEmpresas := TStringList.Create;
        Try
          If fPedidoOuOrcamentoEmAbertoParaClienteTodasAsEmpresas(edtCodCli.Text,
                                                                  stlPedidosTodasEmpresas,
                                                                  IIF(fCfgSis('ORCABR', varString) = 'S',VS_strCodEmp, ''),
                                                                  'OR') Then
          Begin
            fMensagemTabela('ATENÇÃO!','Já existem orçamentos em aberto para este cliente:',TStringArray(stlPedidosTodasEmpresas.ToStringArray),'', ['&Ok']);
           End;
        Finally
          FreeAndNil(stlPedidosTodasEmpresas);
        End;
      End;

      if Result and (fCfgSis('CUPDES', varBoolean)) and (Pos(strOpcDoc, 'OR_PD_VN_') > 0) and (not fEmptyStr(edtCodCli.Text)) then
        pVerificaCupomDescontoCliente(edtCodCli.Text);

      // MANTER OS IFS... SEPARADOS. SABE NÉ... AQUELE CASO COM O TIPO VARIAVEL...
      If (Pos(strOpcDoc, 'VN_OR_PD_CS_') > 0) And fCfgSis('ENTFUT', varBoolean) Then
      Begin

        If Result And fTemEntregaFutura(edtCodCli.Text) Then
        Begin
          btnEntFut.Visible := True;
          fMensagem('ATENÇÃO!','Há entrega(s) futura(s) pendente(s) para esse cliente!',['&OK']);
        End
        Else btnEntFut.Visible := False;

      End
      Else btnEntFut.Visible := False;

      If (Pos(strOpcDoc, 'OR_') > 0) And fCfgSis('UTIPOR', varBoolean) Then
      Begin
        If Not fVerificaPermanenciaOrcPorVend(edtCodCli.Text,
                                              fatVenda.strCodVen,
                                              fatVenda.strNumOrc) Then
        Begin
          Result := False;
        End;
      End;

      If Result Then
        fClientePossuiCashback(True);
    End;

    If Result And (Sender = edtCodCli) And fatVenda.fEhVendaRapida(fatVenda.strCodCli) And blnMudarFoco And edtCodCli.Focused Then
    Begin
      blnMudarFoco := False;

      pSetFocusPanel(pnlCabecalho);

      If edtCodCli.Focused Then
        btnCancelaItem.Click;

      If (Not fValidaCampos(edtCodCnd, True)) Then
        pSetFocus(edtCodCnd)

      Else If (Not fValidaCampos(edtForPag, True)) Then
        pSetFocus(edtForPag);
    End;

    If (Sender = edtOprFlj) And (edtOprFlj.Visible) Then
    Begin
      If Pos(edtOprFlj.Text, 'SN') <= 0 Then
      Begin
        fMensagem('ATENÇÃO!','Informar S ou N para gerar produção fora da loja!',['&OK']);
        Result := False;
      End
    End

    {*******************************************}
    {* VALIDA A DATA DE PREVISÃO DE ENTREGA    *}
    {****************************************MV*}
    Else If (Sender = mskPreVis) And (mskPreVis.Visible) Then
    Begin

      If (fEmptyStr(fTiraCaracEspeciais(mskPreVis.Text))) Then
      Begin
        fMensagem('ATENÇÃO!','A previsão deve ser preenchida!',['&OK']);
        Result := False;
      End
      Else If (StrToDateDef(mskPreVis.Text,0) < fatVenda.dtaGraPed) Then
      Begin
        fMensagem('ATENÇÃO!','A previsão deve ser maior ou igual a ' + DateToStr(fatVenda.dtaGraPed) + '!',['&OK']);
        Result := False;
      End
      Else
      Begin
        fatVenda.dtaPreVis := StrToDate(mskPreVis.Text);

        If edtCodCnd.Visible And (Not fEmptyStr(edtCodCnd.Text)) Then
        Begin
          strTipForCnd := fCampoTabela('CND_TIPFOR', 'CADCND', ['CND_CODIGO'], [edtCodCnd.Text], False);

          If ((Not SameText(strTipForCnd, 'OUTROS')) Or fEmptyStr(mskCndPag.Text)) Then
          Begin
            pCarregaCondicao;
            fatVenda.strConPag := mskCndPag.Text;
          End;
        End;
      End;
    End

    {************************************}
    {* VALIDA A FORMA DE PAGAMENTO      *}
    {*********************************AF*}
    Else If (Sender = edtForPag) And (pnlForPag.Visible) Then
    Begin

      If (fatVenda.VS_blnUsaFpg) Then
      Begin

        If fEmptyStr(edtForPag.Text) Then
        Begin
          fMensagem('','O campo forma de pagamento deve ser preenchido!',['&OK']);
          Result := False;
        End
        Else if (StrOpcDoc = 'CS') And (fStatusCndPag(mskCndPag.Text) = A_VISTA) And  MatchStr(edtForPag.text, ['006','007','013']) then
        begin
          fMensagem('','A forma de pagamento deve ser dinheiro para o envio de mercadoria em consignação. '+
                       'Negociação do recebimento deve ser feita somente na rotina de faturamento!',['&OK']);
          Result := False;
        end
        Else If fRetornaStatusCadastro(edtForPag.Text, 'FPG', 'CADFPG', 'FPG_CODIGO') <> 'A' Then
        Begin
          fMensagem('ATENÇÃO!', 'Esta forma de pagamento não pode ser utilizada pois está inativa!', ['&O k']);
          Result := False;
        End
        Else
        Begin
          pCarregaForPag;

          If fEmptyStr(edtDesForPag.Text) Then
          Begin
            fMensagem('','Forma de pagamento não encontrada!',['&OK']);
            Result := False;
          End
          Else
          Begin

            stlForPag.Clear;
            stlCndPag.Clear;

            If (fCfgSis('USATPC') = 'S') And (Not fatVenda.fDocumentoParaFornecedor) And (Pos(strOpcDoc, 'OE_EF_') <= 0) Then
              pCarregaFormasPagto(edtCodCli.Text, stlForPag, stlCndPag);

            If (Not SameText(strFpgLib, edtForPag.Text)) Then
              pRemoverTravaLogAvi('FPGSEN', fatVenda.strNTrava);

            If (strOpcDoc = 'CI') And (edtForPag.Text = '013')             And
               (Not fCadRecCIQuitado(fatVenda.strTabelaConfMi, strMsgTmp)) Then
            Begin
              pMsgTravaConfCupomUtilizacaoCredito(strMsgTmp);
              Result := False;
            End;

            {**********************************************************}
            {* SE FOR CONFIRMAÇÃO DE DOCUMENTOS, NÃO PERMITE INFORMAR *}
            {* A FORMA DE PAGTO "013" - UTILIZAÇÃO DE CRÉDITO         *}
            {*******************************************************PZ*}
            If (Pos(strOpcDoc, 'CF_CP_OV_CE_CO_CT_') > 0) And (edtForPag.Text = '013') Then
            Begin
              fMensagem('ATENÇÃO!','Essa forma de pagamento não é permitida para confirmação de documentos', ['&O k']);
              Result := False;
            End

            Else If (stlForPag.Count > 0) And (stlForPag.IndexOf(edtForPag.Text) < 0) And
                    (Not SameText(strFpgLib, edtForPag.Text)) And
                    (  fEmptyStr(strCodFpgAuxDv) Or ( (Not fEmptyStr(strCodFpgAuxDv)) And (edtForPag.Text<>strCodFpgAuxDv) )  ) Then
            Begin
              objLiberacao.Clear;
              pMsgFormasPagtoPermitidasCliente(edtForPag.Text, stlForPag, objLiberacao.objMsgLibera);

              If fCfgSis('FPGCLI', varBoolean) Then
              Begin
                objLiberacao.strDirAce := 'FPGSEN';
                objLiberacao.strSenLib := fCfgSis('FPGSEN');
                objLiberacao.strMsgSen := 'Forma pagamento não permitida';
                objLiberacao.strCodOpe := fatVenda.strCodVen;
                objLiberacao.strCodDig := fatVenda.strCodDig;
                objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
                objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
                objLiberacao.fltValorVenda := fatVenda.fltTotGer;
                Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

                If Result Then
                  strFpgLib := edtForPag.Text
                Else
                  strFpgLib := '';
              End

              Else REsult := False;

            End

            Else If ((Not fatVenda.fBaixaDuplicataAVista) And (edtForPag.Text = '009')) And
                    (Pos(fatVenda.strOpcDoc, 'OR_PD_CN_') <= 0) And
                    (Not fatVenda.fPermiteFpgParceladoCI(edtForPag.Text))  Then
            Begin
              fMensagem('ATENÇÃO!', 'Sistema configurado para não baixar duplicatas à vista '+ #13#10 +
                                    'não permite forma de pagamento "Parcelado"!', ['&Ok']);
              Result := False;
            End

//            Else If fCfgSis('TFPF11', varBoolean) And (edtForPag.Text = '009') And (fatVenda.blnEnt_CD) Then
//            Begin
//              fMensagem('ATENÇÃO!', 'Sistema configurado para travar no F11 a forma de pagamento negociada, '+ #13#10 +
//                                    'portanto não é permitido forma de pagamento "Parcelado" para entregas pelo CD!', ['&Ok']);
//              Result := False;
//            End

            {*******************************************}
            {* DEIXOU FORMA DE PAGAMENTO 009 VENDER À  *}
            {* VISTA PARA PASSAR O CLIENTE CONSUMIDOR  *}
            {****************************************MV*}
            Else If (fStatusCndPag(fatVenda.strConPag) = A_VISTA)         And
                    (Pos(strOpcDoc,'OU_OV_BR_TE_NC_DV_PR_OE_EF_OF_UC_DD_PA_') > 0) And
                    (Pos(edtForPag.Text,'008_010_') > 0)                  And
                    (fatVenda.strConPag <> '01999')                       Then
            Begin
              fMensagem('','A forma de pagamento deve ser a vista!',['&OK']);
              Result := False;
            End;

            If (Result) And (fatVenda.VS_blnUsaFpg) And (Not fEmptyStr(edtForPag.Text)) And (Not fEmptyStr(mskCndPag.Text)) Then
            Begin

              If Pos(edtForPag.Text,'001_006_' + IIF(fCfgSis('PRACHC',varBoolean),'','002_007_')) > 0 Then
              Begin
                If (fStatusCndPag(mskCndPag.Text) <> A_VISTA) And (mskCndPag.Text <> '01999') Then
                Begin
                  fMensagem('','A condição de pagamento deve ser a vista!',['&OK']);
                  Result := False;

                  If Not pnlForPag.Visible Then
                  Begin
                    pSetFocus(edtCodCli);
                    Exit;
                  End;

                End;
              End;

              {*******************************************}
              {* LIBERADO PARCELADO A VISTA PARA VENDER  *}
              {* PARA CLIENTE CONSUMIDOR                 *}
              {****************************************MV*}
              If Pos(edtForPag.Text,'008_010_') > 0 Then
              Begin
                If fStatusCndPag(mskCndPag.Text) = A_VISTA Then
                Begin
                  fMensagem('','A condição de pagamento não pode ser a vista!',['&OK']);
                  Result := False;

                  If Not pnlForPag.Visible Then
                  Begin
                    pSetFocus(edtCodCli);
                    Exit;
                  End;

                End;
              End;

              If ((Pos(strOpcDoc, 'NE_') > 0) Or (fatVenda.blnMeiaNota)) And (Pos(edtForPag.Text, '007_') > 0) And (not fCfgSis('PERCAR', varBoolean)) Then
              Begin
                fMensagem('ATENÇÃO!', 'Devido as novas regras da nota fiscal 4.0, não é permitido modalidade "Cartão" para Nota Fiscal Especial ou meia nota!', ['&Ok']);
                Result := False;
                Exit;
              End;

            End;

            If fatVenda.blnLiberacaoRemotaNoFinalVenda And (mskCndPag.Text <> strCndAnt) Then
            Begin
              fatVenda.blnVerDebAtr := True;
              strCndAnt := mskCndPag.Text;
            End;

            If (Result) And (Not fatVenda.blnCliFil) And (mskCndPag.Visible) And (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
              If (fatVenda.blnVerDebAtr) Then
                Result := fatVenda.fDebitoCliente(edtForPag.Text, mskCndPag.Text, 3);
          End;

        End;

        If (Pos(strOpcDoc, 'PD_OR_') > 0) And (Pos(edtForPag.Text, '007_') > 0) And
           Result And fCfgSis('SOLCAR', varBoolean)   Then
        Begin
          If (edtForPag.Focused) Or fEmptyStr(fatVenda.strCodCar) Then
          Begin
            Result := fatVenda.fPedeDadosCartao;
          End;
        End
        Else
        Begin
          fatVenda.strCodCar := '';
          fatVenda.intQtdPaC := 0;
        End;

      End;

    End

    Else If (Sender = mskCndPag) And (mskCndPag.Visible) Then
    Begin

      {*****************************************}
      {* SÓ VALIDA SE A CONDIÇÃO FOR NO INICIO *}
      {**************************************MV*}
      If (fCfgSis('CNDVEN') = 'F') Then
      Begin
        Result := False;
      End;

      If fEmptyStr(fTiraCaracEspeciais(mskCndPag.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'A condição de pagamento deve ser preenchida!', ['&O k']);
        Result := False;
      End
      Else If StrToIntDef(Copy(mskCndPag.Text, 1, 2), 0 ) > 24 Then
      Begin
        fMensagem('', 'Não é permitido mais que 24 parcelas!', ['&O k']);
        Result := False;
      End

      {*****************************************************************************}
      {* VERIFICA SE TRAVA A CONDIÇÃO DE PAGAMENTO PARA LIBERAÇÃO ATRAVÉS DE SENHA *}
      {**************************************************************************PZ*}
      Else If (((fTiraCaracEspeciais(strCndAnt, True, True, True) <> fTiraCaracEspeciais(mskCndPag.Text, True, True, True))                                                                           And
                (fTiraCaracEspeciais(strCndLib, True, True, True) <> fTiraCaracEspeciais(mskCndPag.Text, True, True, True))) Or ((strCodLib <> edtCodCnd.Text) And (strCcnAnt <> edtCodCnd.Text)))    And
                 fTravarCondicaoPagamento(edtCodCnd.Text, mskCndPag.Text, fatVenda.strCodCli, fatVenda.strCodVen, fatVenda.strCodDig, fatVenda.strNTrava, '', fatVenda.stlNumLib, cdsVenda, FatVenda) Then
        Result := False

      {**********************************************}
      {* NÃO PERMITE VENDA A PRAZO PARA CONSIGNAÇÃO *}
      {*******************************************MM*}
      Else If (Result) And
              (Not fCfgSis('USACND', varBoolean)) And
              (StrOpcDoc = 'CS') And
              (fStatusCndPag(mskCndPag.Text) = A_PRAZO) Then
      Begin
        fMensagem('','A condição de pagamento não pode ser a prazo para envio de mercadoria em consignação!',['&OK']);
        Result := False;
      End

      Else If Result And fatVenda.fEhConsertoEquipamento And (fStatusCndPag(mskCndPag.Text) = A_PRAZO) Then
      Begin
        fMensagem('','A condição de pagamento deve ser a vista para nota de conserto de equipamento!',['&OK']);
        Result := False;
      End

      Else If (Not edtCodCnd.Visible) And
              (Pos(strOpcDoc,'DV_PR_TE_BR_NC_UC_EP_DD_') <= 0) And (Not fatVenda.blnCliFil) And
              (Not fatVenda.fCondicaoPagtoClienteOk(mskCndPag.Text, edtTotImp.Text)) Then
      Begin
        Result := False;
      End

      Else
      Begin
        strCndLib := fTiraCaracEspeciais(mskCndPag.Text, True, True, True);
        strCodLib := edtCodCnd.Text;

        {*********************************************************************}
        {* VALIDAÇÃO DA COND. PAGTO PARA FORA SEMANA, DEZENA, QUINZENA E MES *}
        {******************************************************************LU*}
        If Pos(copy(mskCndPag.Text, 1, 2), 'FS_FD_FQ_FM') > 0 Then
        Begin
          mskCndPag.Text := fValidaCndPagFora(mskCndPag.Text);
          fValidaCampos(mskCndPag, False);
        End
        Else
        Begin
          If (copy(mskCndPag.Text, 1, 1) = 'F') Then
          Begin
            fMensagem('ATENÇÃO!', 'Essa condição de pagamento não é valida!', ['&O k']);
            Result := False;
          End
          Else
          If (Result) Then
          Begin
            If (Pos(fatVenda.strOpcDoc, 'VN_PD_OR_') > 0) Then
              Result := fValidaCndPag(mskCndPag.Text, fatVenda.FConPag, VS_Date, False, fatVenda.strCodCli)
            Else
              Result := fValidaCndPag(mskCndPag.Text, fatVenda.FConPag, VS_Date);

            If Not Result Then
            Begin
              fMensagem('ATENÇÃO!', 'Essa condição de pagamento ' + fFormataCondPag(mskCndPag.Text) + ' ' +
                                    'não é valida!' + #13#10 +
                                    'Verifique se informou todas as parcelas e se as mesmas estão em ordem progressiva, ' +
                                    'exemplos válidos: (01)000, (01)030, (03)030.060.090', ['&O k']);
            End
            Else
            Begin
              If fEmptyStr(fatVenda.strConPag) Then
                Result := False;
            End;
          End;
        End;
      End;

      If (Not fEmptyStr(strCndAnt)) And
         (Not SameText(strCndAnt, fTiraCaracEspeciais(mskCndPag.Text))) Then
      Begin
        If  fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(fatVenda.blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), False) Then
          pRemoverTravaLogAvi('COMPR', fatVenda.strNTrava);

        blnTravaNaoCompra := False;
      End;

      If (Result) And (Not fatVenda.blnCliFil) And (Not pnlForPag.Visible) And (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
        If (mskCndPag.Text <> strCndAnt) Or (fatVenda.blnVerDebAtr) Then
          Result := fatVenda.fDebitoCliente(edtForPag.Text, mskCndPag.Text, 3);

      If Result And (Not fCfgSis('USACND', varBoolean)) Then
      Begin
        Result := fatVenda.fCondicaoPagtoClienteOk(mskCndPag.Text, edtTotImp.Text);
      End;

      mskCndPag.Text := fatVenda.strConPag;

      {*****************************************}
      {* CASO A CONDIÇÃO ESTEJA OK             *}
      {**************************************MV*}
      If (Result) And ((strCndAnt <> mskCndPag.Text) Or (Not fatVenda.blnVerPrzMed)) Then
        Result := fatVenda.fVerificaPrazoMedio(fatVenda.strConPag);

      If (Result) And ((strCndAnt <> mskCndPag.Text) Or (Not fatVenda.blnVerMaxPar)) Then
        Result := fatVenda.fVerificaQtdMaxParcelas(fatVenda.strConPag);

      If fCondicaoDiferenteDaOriginal And (mskCndPag.Enabled) Then
        blnValidaCnd := False;

      If (Not fCfgSis('USACND', varBoolean)) Or
         (mskCndPag.Enabled And mskCndPag.Visible) Then
      Begin
        If fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(fatVenda.blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), True) Then
        Begin
          If Result                    And
             (fCfgSis('CNDVEN') = 'I') Then
          Begin
            If (Pos(fatVenda.strOpcDoc, 'VN_PD_OR_') > 0)                                     And
               (Not blnTravaNaoCompra) And
               (Not fatVenda.fVerificaNaoCompra(blnTravaNaoCompra, fRetCodVenDef(edtSenVen.Text))) Then
              Result := False;
          End;
        End;
      End;

      If (Result) And (fCfgSis('RECCND', varBoolean) And (fatVenda.strConPag <> '01999')) Then
      Begin

        {*****************************************}
        {* CALCULA FATOR REFERENTE À MEDIA DA    *}
        {* CONDIÇÃO DE PAGAMENTO                 *}
        {**************************************MV*}
        fatVenda.pCalculaTaxVpr;

        If fCfgSis('CNDVEN') = 'F' Then
        Begin
          fatVenda.fltTaxJur := 0;
          fatVenda.fltTaxVpr := 0;
        End;

        pAtualizaUnitarioLiquido;

        If (strCndAnt <> fatVenda.strConPag) Then
          pRemoverTravaLogAvi('SENMPR', fatVenda.strNTrava);

        {*****************************************}
        {* RECALCULA OS PREÇOS                   *}
        {**************************************MV*}
        If ((Not fEmptyStr(strCndAnt)) Or (fEmptyStr(strCndAnt) And (Not fGridVendaVazio) And (mskCndPag.Enabled) And (Not fEmptyStr(mskCndPag.Text)))) And
           (strCndAnt <> fatVenda.strConPag)                              And
           ((fatVenda.fltTaxVpr >= 0.0) Or fCfgSis('RECCND', varBoolean)) Then
        Begin

          blnRecalcularPreco := False;
          blnManterPrecos    := False;

          If (fExibirMensagemManterPrecosOriginaisVendaTrocaCondicaoPagamento(fatVenda.strCodCnd)) And
             (Not fAplicarTaxaJurosPrecoDigitado) Then
          Begin
            {*********************************************}
            {* PERGUNTA MANTER O PRECO ORIGINAL          *}
            {******************************************FS*}
            If (Not fatVenda.blnCndEsp) And (fMensagem('AVISO!', 'Deseja manter os preços originais?', ['&Sim', '&Não'], 2) = 1) Then
            Begin

              blnManterPrecos := True;

              {*********************************************}
              {* SENHA P\ PERMITIR MANTER O PRECO ORIGINAL *}
              {******************************************JB*}
              If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (fCfgSis('PRAUDI', varBoolean)) Then
                blnManterPrecos := fMSG_SenhaManterPrecos_ConfiguracaoPRAUDILigada()
              Else If (Not (fEmptyStr(fCfgSis('SENMPR')))) Then
                blnManterPrecos := fMSG_SenhaManterPrecos();

              If (Not blnManterPrecos) Then
                fMensagem('ATENÇÃO!','Trava não liberada. Os preços serão recalculados com a nova condição de pagamento!',['&OK']);

              If Result Then
              Begin
                If fCfgSis('JURCUS', VarBoolean) Then
                Begin
                  pRecalculaPrecos(False,
                                   False,
                                   False,
                                   True,
                                   '',
                                   False,
                                   False,
                                   False,
                                   True { blnManterPrecoDigitado });
                  pCalculaTotais;
                End
                Else
                  blnRecalcularPreco := True;

                strCndAnt := fatVenda.strConPag;

              End;

            End
            Else
              blnRecalcularPreco := True;
          End
          Else
            blnRecalcularPreco := True;

          If blnRecalcularPreco Then
          Begin

            pRecalculaPrecos(False,
                             False,
                             False,
                             True,
                             '',
                             False,
                             False,
                             False,
                             blnManterPrecos { blnManterPrecoDigitado });

            pCalculaTotais;
            strCndAnt := fatVenda.strConPag;
          End;

        End;
      End
      Else
      Begin
        {**********************************************************************}
        {* INDEPENDENTE SE A CFG_RECCND = "N" PARA NÃO RECALCULAR OS PREÇO,   *}
        {* SEMPRE IRÁ RECALCULAR OS DE PROMOÇÃO, POIS CONFORME FOR ALTERADO A *}
        {* CONDIÇÃO DE PAGAMENTO, EXISTE A POSSIBILIDADE DE ALGUM ITEM ESTAR  *}
        {* DENTRO DO PRAZO MÉDIO DE ALGUMA PROMOÇÃO CONFIGURADA               *}
        {*******************************************************************FC*}
        If (Not fEmptyStr(strCndAnt))        And
           (strCndAnt <> fatVenda.strConPag) Then
        Begin
          If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And
             (fatVenda.fAplicaTaxaJuros)       And
             (fCfgSis('CNDVEN') = 'I')         Then
          Begin
            fatVenda.pCalculaTaxVpr;
          End;

          fatVenda.intPrzMed := fFloatToInt(fCalcMediaPagto(fatVenda.strConPag));

          If fVeriCalcItensForaPromocao(True, False) Then
            pCalculaTotais;

          pAtualizaUnitarioLiquido;

          strCndAnt := fatVenda.strConPag;
        End;
      End;

      If Result And fEmptyStr(strCndAnt) Then
        strCndAnt := fatVenda.strConPag;

      {*************************************************}
      {* NÃO PERMITE VENDA A PRAZO PARA CLI-CONSUMIDOR *}
      {**********************************************AF*}
      If (Result) And
         (fClienteConsumidor(fatVenda.strCliOri)) And
         (fStatusCndPag(fatVenda.strConPag) = A_PRAZO) And
         (blnBuscaPorChave)                  And
         (Not fCfgSis('PRZCON', varBoolean)) Then
      Begin
        fMensagem('','A condição de pagamento não pode ser a prazo para cliente consumidor!',['&OK']);
        Result := False;
      End;

      If (Result) Then
        strCndAnt := fatVenda.strConPag;

    End
    Else If (Sender = edtCodCnd) And (edtCodCnd.Visible) Then
    Begin

      If fEmptyStr(edtCodCnd.Text) Then
      Begin
        fMensagem('ATENÇÃO!', 'A condição deve ser preenchida!', ['&O k']);
        Result := False;
      End
      Else
      Begin
        //pCarregaCondicao;

        {Valida Condição de Pagamento/Destino}
        If fCfgSis('RETENT',varBoolean) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
          If (cdsVenda.RecordCount > 0) Then
            If (Not fEmptyStr(strCcnAnt)) And (edtCodCnd.Text <> strCcnAnt) Then
            Begin
              If (fCfgSis('CNDVEN') = 'I') And (fCfgSis('USACND') = 'S') And (pnlEntrega.Visible) Then
                If Not fControleRetiraEntregaPorCndPagto(edtCodCnd.Text, True) Then
                Begin
                  edtCodCnd.Text := strCcnAnt;
                  Result := False;
                End;
            End;

        {Trocou condição de pagamento, solicita senha novamente}
        If (edtCodCnd.Text <> strCcnAnt) Then
          blnSenPrazoMedioMaximoVenda := False;

        blnExisteCnd := Not fEmptyStr(fRetDesConPag(edtCodCnd.Text));

        If Not blnExisteCnd Then
        Begin
          fMensagem('ATENÇÃO!', 'Condição de pagamento não cadastrada!', ['&O k']);
          Result := False;
        End;
      End;

      If Result And (Not fEmpresaTemAcessoCondicaoPagto(edtCodCnd.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar esta condição. Verifique o Cadastro de Condições de Pagamento - Aba "Empresas Acesso".' , ['&O k']);
        Result := False;
      End;

      If Result And (Not fPermiteUtilizarEstaCondPagamento(edtCodCnd.Text, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento)) Then
      Begin
        Result := False;
      End;

      If Result And (blnAtualizaTabPreCnd) And (blnValidaCnd) Then
      Begin
        pCarregacondicao;
        blnFocusCodCnd := False;

        If (Not qryConCnd.IsEmpty) And
           (fEmptyStr(Trim(StringReplace(qryConCnd.FieldbyName('CND_PRETAB').AsString,'N','',[rfReplaceAll, rfIgnoreCase])))) Then
        Begin
          fMensagem('ATENÇÃO!', 'Esta condição não pode ser utilizada pois a tabela de preço não foi preenchida!', ['&O k']);
          Result         := False;
          blnFocusCodCnd := True;
        End;
      End;

      {SE CFG_CNDPES = "S"}
      if (Result) and (fatVenda.blnCondicaoEspecial) then
      Begin
        {SE A CONDIÇÃO ATUAL FOR "ESPECIAL", CHECAR A LISTA DE PRODUTOS JÁ INSERIDOS - KM}
        if (Not edtCodCnd.ReadOnly)  then
        Begin
          pCarregacondicao;
          if (fatVenda.blnCndEsp) then
          Begin
            pMostraOcultaFechamentoComDesconto(False);
            if fatVenda.fProdutoForaCondEsp(fatVenda.strCodCnd, cdsVenda) then
            Begin
              fMensagem('ATENÇÃO!','Essa condição de pagamento não poderá ser utilizada pois existem produtos não permitidos! ' +
                                   'Favor verificar e excluir os itens fora da política de parcelamento.', ['&Ok']);
              Result := False;
            End
            else {TODOS OS PRODUTOS PERTENCEM A CONDIÇÃO ESPECIAL, ENTÃO RECALCULA PREÇOS}
            Begin
              if (edtCodCnd.Text <> strCcnAnt) then
              Begin
                fMensagem('ATENÇÃO!', 'Foi escolhida uma condição de pagamento especial e os produtos terão seus preços de tabela definidos!', ['&Ok']);
                pRecalculaPrecos(False,
                                 True,
                                 False,
                                 False,
                                 '',
                                 False,
                                 False,
                                 False,
                                 False,
                                 True);
              End;
            End;
          End
          Else
            pMostraOcultaFechamentoComDesconto(fPermitirDescontoEspecial(strOpcDoc));
        End;
      End;

      If Result And (fatVenda.fPermiteAlterarCondFormaPagtoConfNFConcreto) And ((edtCodCnd.Text <> strCcnAnt) Or ((strFpgAnt <> edtForPag.Text) And (strFpgAnt <> ''))) Then
      Begin
        If (Not fEmptyStr(strCcnAnt)) Then
        Begin
          If (fCfgSis('CNDCLI', varBoolean)) And
             (fCfgSis('USATPC', varBoolean)) And
             (Not SameText(fatVenda.strCndLib, edtCodCnd.Text)) Then
            pRemoverTravaLogAvi('CNDSEN', fatVenda.strNTrava);

          If (edtCodCnd.Text <> strCcnAnt) Then
          Begin
            If fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(fatVenda.blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), False) Then
              pRemoverTravaLogAvi('COMPR', fatVenda.strNTrava);

            blnTravaNaoCompra := False;
          End;
        End;

        {*****************************************}
        {* SÓ VALIDA SE A CONDIÇÃO FOR NO INICIO *}
        {**************************************MA*}
        If (fCfgSis('CNDVEN') = 'F') Then
        Begin
          Result := False;
        End;

        pCarregaCondicao;

        {*****************************************************************************}
        {* VERIFICA SE TRAVA A CONDIÇÃO DE PAGAMENTO PARA LIBERAÇÃO ATRAVÉS DE SENHA *}
        {**************************************************************************PZ*}
        If (Result) And (strCodLib <> edtCodCnd.Text) Then
        Begin
          Result := (Not fTravarCondicaoPagamento(edtCodCnd.Text, mskCndPag.Text, fatVenda.strCodCli, fatVenda.strCodVen, fatVenda.strCodDig, fatVenda.strNTrava, '', fatVenda.stlNumLib, cdsVenda, FatVenda));

          If (Result) Then
            strCodLib := edtCodCnd.Text;
        End;

        If Result And fatVenda.fEhConsertoEquipamento And (fStatusCndPag(mskCndPag.Text) = A_PRAZO) Then
        Begin
          fMensagem('','A condição de pagamento deve ser a vista para nota de conserto de equipamento!',['&OK']);
          Result := False;
        End;

        {**********************************************}
        {* NÃO PERMITE VENDA A PRAZO PARA CONSIGNAÇÃO *}
        {*******************************************MM*}
        If (Result) And
           (fCfgSis('USACND', varBoolean)) And
           (StrOpcDoc = 'CS') And
           (fStatusCndPag(mskCndPag.Text) = A_PRAZO) Then
        Begin
          fMensagem('','A condição de pagamento não pode ser a prazo para envio de mercadoria em consignação!',['&OK']);
          Result := False;
        End;

        If qryConCnd.FieldByName('CND_CODIGO').IsNull Then
        Begin
          fMensagem('ATENÇÃO!', 'Essa condição não está cadastrada!', ['&O k']);
          Result := False;
        End;
        
        If Result Then
        Begin
          If (  fEmptyStr(strCodCndAuxDv) Or ( (Not fEmptyStr(strCodCndAuxDv)) And (edtCodCnd.Text<>strCodCndAuxDv) )  ) And
           (Not fatVenda.fCondicaoPagtoClienteOk(edtCodCnd.Text, edtTotImp.Text)) Then
            Result := False;
        End;

        strSugCndCli:=fatVenda.fCondicaoPagtoClienteSugestao;

        If (Not fEmptyStr(fatVenda.strCodPagOri)) And (fEmptyStr(strCndSug)) Then
          strCndSug:=fatVenda.strCodPagOri;

        If (Result)                                     And
           (fCfgSis('PFLCLI', varBoolean)               And
           fRetCampoCndPagto(strCcnAnt, 'CND_SENCND'))  And
           ((Not fEmptyStr(strSugCndCli) And (Not fEmptyStr(strCndSug)) And (edtCodCnd.Text <> strSugCndCli) And (edtCodCnd.Text <> strCndSug))) Then
        Begin

          objLiberacao.Clear;
          objliberacao.objMsgLibera.pAddTexto('Alteração da Condição de Pagamento sugerida.');
          objliberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto Sugerida'  , strCndSug + ' - ' + fRetDesConPag(strCndSug)           , 21);
          objliberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto Informada' , edtCodCnd.Text + ' - ' + fRetDesConPag(edtCodCnd.Text) , 21);

          If (fStrToFloat(edtTotImp.Text) > 0) And (Not ckbAbCrAu.Checked) Then
            objliberacao.objMsgLibera.pAddTextoCaption('Valor Total Documento' , FormatFloat('#,##0.00', fStrToFloat(edtTotImp.Text)) , 21);

          objLiberacao.strDirAce := 'SENCND';
          objLiberacao.strSenLib := fCfgSis('SENCND');
          objLiberacao.strMsgSen := 'Alteração da Condição de Pagamento';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := (fatVenda.strCodCli + '-' + fatVenda.strCliOri);
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

        End;

        If Result And (edtCodCnd.Text = strSugCndCli) Then
        Begin
          pRemoveLogAviCondicaoAnterior;
          pRemoveLogLibCondicaoAnterior;
        End;

        If (Result) And (Not fEmptyStr(fatVenda.strCodPagOri)) Then
           strCndSug:=edtCodCnd.Text;

        If (Result) Then
        Begin

          If fEmptyStr(fTiraCaracEspeciais(mskCndPag.Text)) Then
          Begin
            fMensagem('ATENÇÃO!', 'A condição de pagamento deve ser preenchida!', ['&O k']);
            Result := False;
          End
          Else If Not fValidaCndPag(mskCndPag.Text, fatVenda.FConPag, VS_Date) Then
          Begin
            fMensagem('ATENÇÃO!', 'Essa condição de pagamento ' + fFormataCondPag(mskCndPag.Text) + ' ' +
                                  'não é valida!' + #13#10 +
                                  'Verifique se informou todas as parcelas e se as mesmas estão em ordem progressiva, ' +
                                  'exemplos válidos: (01)000, (01)030, (03)030.060.090', ['&O k']);
            Result := False;
          End
          Else If fEmptyStr(fatVenda.strConPag) Then
          Begin
            Result := False;
          End;

//          * Esta travando a troca da condição, mesmo liberando na tela acima f1DigSenVar()
//          If Result Then
//          Begin
//            Result := fatVenda.fCondicaoPagtoClienteOk(edtCodCnd.Text);
//          End;

          If (fatVenda.blnVerDebAtr) And
             (Not fatVenda.blnCliFil) And (Result) And
             (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) And
             (Not pnlForPag.Visible) Then
          Begin
            Result := fatVenda.fDebitoCliente(edtForPag.Text, mskCndPag.Text, 3);
          End;

          mskCndPag.Text := fatVenda.strConPag;

          {*****************************************}
          {* CASO A CONDIÇÃO ESTEJA OK             *}
          {**************************************MV*}

          If Result And ((mskCndPag.Text <> strCndAnt) Or (Not fatVenda.blnVerPrzMed)) Then
            Result := fatVenda.fVerificaPrazoMedio(fatVenda.strConPag);

          If (Result) And ((strCndAnt <> mskCndPag.Text) Or (Not fatVenda.blnVerMaxPar)) Then
            Result := fatVenda.fVerificaQtdMaxParcelas(fatVenda.strConPag);

          If  fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(fatVenda.blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), True) Then
          Begin
            If Result                    And
               (fCfgSis('CNDVEN') = 'I') Then
            Begin
              If (Pos(fatVenda.strOpcDoc, 'VN_PD_OR_') > 0)                           And
                 (Not blnTravaNaoCompra)                                              And
                 (Not fatVenda.fVerificaNaoCompra(blnTravaNaoCompra, fRetCodVenDef(edtSenVen.Text))) Then
                Result := False;
            End;
          End;

          If (Result) And (fCfgSis('RECCND', varBoolean) And (fatVenda.strConPag <> '01999')) Then
          Begin
            {*****************************************}
            {* CALCULA FATOR REFERENTE À MEDIA DA    *}
            {* CONDIÇÃO DE PAGAMENTO                 *}
            {**************************************MV*}
            fatVenda.pCalculaTaxVpr;

            If fCfgSis('CNDVEN') = 'F' Then
            Begin
              fatVenda.fltTaxJur := 0;
              fatVenda.fltTaxVpr := 0;
            End;

            pAtualizaUnitarioLiquido;

            {*****************************************}
            {* RECALCULA OS PREÇOS                   *}
            {**************************************MV*}
            If //Req.: 113799 (Not fEmptyStr(strCcnAnt)) And
               (cdsVenda.RecordCount > 0) And
               (edtCodCnd.Text <> strCcnAnt) And
               ((fatVenda.fltTaxVpr >= 0.0) Or fCfgSis('RECCND', varBoolean)) Then
            Begin

              blnManterPrecos := False;

              If (fExibirMensagemManterPrecosOriginaisVendaTrocaCondicaoPagamento(edtCodCnd.Text)) And
                 (Not fAplicarTaxaJurosPrecoDigitado) Then
              Begin

                If (Not fatVenda.blnCndEsp) And (fMensagem('AVISO!', 'Deseja manter os preços originais?', ['&Sim', '&Não'], 2) = 1) Then
                Begin
                  blnManterPrecos := True;

                  If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (fCfgSis('PRAUDI', varBoolean)) Then
                    blnManterPrecos := fMSG_SenhaManterPrecos_ConfiguracaoPRAUDILigada()
                  Else If (Not (fEmptyStr(fCfgSis('SENMPR')))) Then
                    blnManterPrecos := fMSG_SenhaManterPrecos();

                  If (Not blnManterPrecos) Then
                    fMensagem('ATENÇÃO!','Trava não liberada. Os preços serão recalculados com a nova condição de pagamento!',['&OK']);
                End;

              End;

              {************************************}
              {* CASO USAR FATOR P\ NOTA ESPECIAL *}
              {* NAO RECALCULA O PRECO            *}
              {*********************************JB*}
              If (fatVenda.fltFatNot = 0) And ((blnRecalcularPrecosAoMudarCondicaoDePagamento) Or (blnRecalcularPrecosTransfEstoque)) Then
                pRecalculaPrecos(False,
                                 False,
                                 False,
                                 True,
                                 '',
                                 False,
                                 False,
                                 False,
                                 blnManterPrecos { blnManterPrecoDigitado });

              pCalculaTotais;
              strCndAnt := fatVenda.strConPag;
            End;

          End
          Else
          Begin
            {**********************************************************************}
            {* INDEPENDENTE SE A CFG_RECCND = "N" PARA NÃO RECALCULAR OS PREÇO,   *}
            {* SEMPRE IRÁ RECALCULAR OS DE PROMOÇÃO, POIS CONFORME FOR ALTERADO A *}
            {* CONDIÇÃO DE PAGAMENTO, EXISTE A POSSIBILIDADE DE ALGUM ITEM ESTAR  *}
            {* DENTRO DO PRAZO MÉDIO DE ALGUMA PROMOÇÃO CONFIGURADA               *}
            {*******************************************************************FC*}
            If (edtCodCnd.Text <> strCcnAnt) Then
            Begin
              If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And
                 (fatVenda.fAplicaTaxaJuros)       And
                 (fCfgSis('CNDVEN') = 'I')         Then
              Begin
                fatVenda.pCalculaTaxVpr;
              End;

              fatVenda.intPrzMed := fFloatToInt(fCalcMediaPagto(fatVenda.strConPag));

              If fVeriCalcItensForaPromocao(True, False) Then
                pCalculaTotais;

              pAtualizaUnitarioLiquido;

              strCndAnt := fatVenda.strConPag;
            End;
          End;

          If (Result) Then
          Begin
            strFpgAnt := edtForPag.Text;
            strConPagAnt := strCcnAnt;
            strConPagAtu := IIF(fEmptyStr(edtCodCnd.Text), fatVenda.strConPag, edtCodCnd.Text);
            blnCondicaoPagamentoModificada := Not (strConPagAnt = strConPagAtu);

            strCcnAnt := edtCodCnd.Text;
            If fEmptyStr(strCndAnt)  Then
              strCndAnt := fatVenda.strConPag;

            If (blnAtualizaTabPreCnd) And (blnCondicaoPagamentoModificada) and (not blnChamouTelaTabelaPreco) Then
            Begin
               blnChamouTelaTabelaPreco := True;
               strTabPrecoFat := fDevolveTabelaPrecoFaturamento(fCampoTabela('CND_PRETAB', 'CADCND', ['CND_CODIGO'], [IIF(fEmptyStr(edtCodCnd.Text), fatVenda.strConPag, edtCodCnd.Text)]));
               strMultiTabPreAtu := strTabPrecoFat;
               if Length(strTabPrecoFat) > 1 then
               begin
                 try
                   pCriarFormularios(TfrmFatSelecaoTabelaPreco,frmFatSelecaoTabelaPreco);
                   frmFatSelecaoTabelaPreco.cbbTabPre.Clear;
                   frmFatSelecaoTabelaPreco.cbbTabPre.Items.Add('');
                   for intIndice := 1 to Length(strTabPrecoFat) do
                   begin
                     frmFatSelecaoTabelaPreco.cbbTabPre.Items.Add(strTabPrecoFat[intIndice]);
                   end;
                   frmFatSelecaoTabelaPreco.cbbTabPre.ItemIndex := 0;
                   frmFatSelecaoTabelaPreco.ShowModal;
                   if frmFatSelecaoTabelaPreco.ModalResult = mrOk then
                   begin
                     strTabPrecoFat := frmFatSelecaoTabelaPreco.cbbTabPre.Text;
                     strMultiTabPreAtu := strTabPrecoFat;
                   end;
                 finally
                   pFreeAndNil(frmFatSelecaoTabelaPreco);
                 end;
               end;
            End;

            if (blnAtualizaTabPreCnd) And (blnCondicaoPagamentoModificada) And (Not blnValidouTabPreCliMasNaoLiberouSenha) then
            begin
               if strMultiTabPreAnt <> strMultiTabPreAtu then
               begin
                 strMultiTabPreAnt  := strMultiTabPreAtu;
                 if Length(strTabPrecoFat) = 1 then
                   fatVenda.strTabPre := strTabPrecoFat;
                 fatVenda.pCalculaTaxVpr;
                 pRecalculaPrecos(False, True, False, True, '', False, False, False, Self.blnManterPrecoDigitado);
                 pCalculaTotais;
                 if (cbTabPreco.Items.IndexOf(strTabPrecoFat) > 0) then
                 begin
                   cbTabPreco.Text    := strTabPrecoFat;
                 end;
               end;
            end;

            pAtualizaUnitarioLiquido;

          End;

        End;

      End
      Else
      Begin
        If (Result) And (blnRevalidarCondPgto) Then
        Begin
          Result := fatVenda.fCondicaoPagtoClienteOk(edtCodCnd.Text, edtTotImp.Text);
          blnMudarFoco := Result;
          blnRevalidarCondPgto := Not Result;
        End;
      End;

      If Result                                And
         SameText(strOpcDoc, 'DV')             And
        (Not fEmptyStr(edtForPag.Text))        And
        (Pos(edtForPag.Text, '001_008_') <= 0) Then
      Begin
        fMensagem('','A forma da condição de pagamento para devolução deve ser DINHEIRO (001) ou FATURADO (008)!',['&OK']);
        Result := False;
      End;

      {*************************************************}
      {* NÃO PERMITE VENDA A PRAZO PARA CLI-CONSUMIDOR *}
      {**********************************************AF*}
      If (Result) And
         (fClienteConsumidor(fatVenda.strCliOri)) And
         (fStatusCndPag(fatVenda.strConPag) = A_PRAZO) And
         (blnBuscaPorChave)                  And
         (Not fCfgSis('PRZCON', varBoolean)) Then
      Begin
        fMensagem('','A condição de pagamento não pode ser a prazo para cliente consumidor!',['&OK']);
        Result := False;
      End;

      If Result And (Not fEmptyStr(edtSenVen.Text)) And
        (Not fatVenda.fVendedorComCondicaoPagto(edtCodCnd.Text, mskCndPag.Text)) Then
      Begin
        Result := False;
      End;

      If Result Then
      Begin
        If (Not fClienteTemCndPagAssociado(edtCodCli.Text)) And
           (Not fEmptyStr(edtCodCnd.Text))                  And
           (Not fatVenda.fDocumentoParaFornecedor)          And
           (edtCodCnd.Text <> strCodCndAnt)                 And
           (Pos(strOpcDoc, 'OU_OE_OF_EF_') <= 0)               And
           (fCfgSis('TRACND', varBoolean))                  And
           (fCfgSis('CNDPRA', varString) = '2')             Then
        Begin
          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Liberação da condição de pagamento para quando é utilizado trava de cliente por condição de pagamento, e não há condição de');
          objLiberacao.objMsgLibera.pAddTexto('pagamento vinculado ao cliente.');


          If Not fEmptyStr(fatVenda.strCodCnd) Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Condição de pagamento', fatVenda.strCodCnd + '-' + fRetDesConPag(fatVenda.strCodCnd), 21);

          objLiberacao.strDirAce := 'CNDPRA';
          objLiberacao.strSenLib := fCfgSis('SENPRA');
          objLiberacao.strMsgSen := 'Condição de Pagamento';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
          begin
            fatVenda.strCodCnd := '';
            fatVenda.strDesCnd := '';
            edtDesCndPag.Text  := '';
            mskCndPag.Text     := '';
            edtForPag.Text     := '';
            edtDesForPag.Text  := '';
            fatVenda.strCodFpg := '';
            fatVenda.strDesFpg := '';
            Result := False;
          End;
        End;
      End;

      If Result Then
      Begin
        If Not TFuncoesPixAutcom.ValidacoesCondicaoDePagamentoPix(fatVenda, FCondicaoPixLiberada) Then
          Result := False;

        If Result Then
        Begin
          If Not TFuncoesPixAutcom.ValidaCondicaoPagamentoConfirmacaoDocumentos(fatVenda) Then
            Result := False;
        End;
      End;

      If Result Then
      Begin
        If (strCodCndAnt <> edtCodCnd.Text) Then
        Begin
          If (Not (fEmptyStr(strCodCndAnt))) Then
            If (Not fGridVendaVazio) Then
              fatVenda.blnTrocouCndPagtoIni := True;

          If (MatchStr(fatVenda.strOpcDoc, ['PD','OR','VN'])) Then
          Begin
            If ((Not fEmptyStr(strCodCndAnt)) And (strCodCndAnt <> edtCodCnd.Text)) Or
               (fEmptyStr(strCodCndAnt) And ((Not fEmptyStr(fatVenda.strCodPagOri)) And (fatVenda.strCodPagOri <> edtCodCnd.Text))) Then
            Begin
              fatVenda.fltDeADig := 0;
            End;
          End;

          strCodCndAnt := edtCodCnd.Text;
          strCndAnt := fTiraCaracEspeciais(mskCndPag.Text);
          If (mskCndPag.Visible) And (mskCndPag.Enabled) And (Not(fEmptyStr(mskCndPag.Text))) Then
            strConAtu := mskCndPag.Text;
        End
      End
      Else
      Begin
        {****************************************************************************************}
        {* SE HOUVE ALGUMA TRAVA QUE IMPEDIU A TROCA DA CONDIÇÃO VOLTA A CONDIÇÃO ANTERIOR POIS *}
        {* fatVenda.strCodCnd ESTAVA FICANDO COM O VALOR DA CONDIÇÃO INVÁLIDA                   *}
        {*************************************************************************************VA*}
        If (Not fEmptyStr(strCcnAnt)) And (Not fEmptyStr(fatVenda.strCodCnd)) And (edtCodCnd.Text = fatVenda.strCodCnd) And (edtCodCnd.Text <> strCcnAnt) Then
        Begin
          edtCodCnd.Text := strCcnAnt;
          pCarregaCondicao(True);
        End;
      End;

    End

    Else If (Sender = edtSenVen) And (pnlVendedor.Visible) And (fEmptyStr(edtCodIte.Text)) Then
    Begin

      If fEmptyStr(edtSenVen.Text) Then
      Begin
        fMensagem('ATENÇÃO!', 'O vendedor deve ser preenchido!', ['&O k']);
        Result := False;
      End
      Else
      Begin
        pCarregaVendedor;
        If qryConOpe.FieldByName('OPE_CODOPE').IsNull Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse vendedor não está cadastrado!', ['&O k']);
          Result := False;
        End
        Else If qryConOpe.FieldByName('OPE_STATUS').AsString <> 'A' Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse vendedor está inativo!', ['&O k']);
          Result := False;
        End
        Else If Not fVerificaPermitidoInformarVendedor(True) Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse tipo de vendedor está bloqueado para venda na configuração [CFG_OPUSVD]!', ['&O k']);
          Result := False;
        End;

        blnVendedorPermitido := True;
        If Result Then
        Begin
          blnVendedorPermitido := fVendedorPermitidoSeUsandoMultiVendedores(fatVenda.strCodCli, fatVenda.strCodVen);
          Result := blnVendedorPermitido;
        End;

        If (Not fEmptyStr(fatVenda.strCodVenOri)) And
           (fatVenda.strCodVen = strVenAnt) And
           (fatVenda.strCodVen = fatVenda.strCodVenOri)  Then
        Begin
          pRemoverTravaLogAvi('ALTVEO', fatVenda.strNTrava);
        End;

        If (fatVenda.strCodVen <> strVenAnt) Then
        Begin
          pRemoverTravaLogAvi('VENCND', fatVenda.strNTrava);

          {Trocou vendedor solicita senha novamente}
          blnSenPrazoMedioMaximoVenda := False;

        End;

        strSenAltVen := '';
        strDirAltVen := '';

        If (strOpcDoc <> 'OF') Then
        Begin
          If (blnVendedorPermitido) And (Not fEmptyStr(strVenAnt)) Then
          Begin
            If (fCfgSis('SEALVE', VarBoolean)) And
               (fCfgSis('VENESP') <> strVenCli) Then //Exceto o vendedor especial (Cliente sem "Dono")
            Begin
              strSenAltVen := '';
              strDirAltVen := 'SEALVE';
              objLiberacao.Clear;
              objLiberacao.objMsgLibera.pAddTexto('Alteração de vendedor sugerido.');
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor Anterior', strVenAnt + '-' + fRetNomeOperador(strVenAnt)                  , 18);
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor Atual'   , fatVenda.strCodVen + '-'+ fRetNomeOperador(fatVenda.strCodVen) , 18);
            End;

            If (Not fEmptyStr(fCfgSis('ALTVEO'))) And (Not fEmptyStr(strNumOrc)) Then
            Begin
              strSenAltVen := fCfgSis('ALTVEO');
              strDirAltVen := 'ALTVEO';
              objLiberacao.Clear;
              objLiberacao.objMsgLibera.pAddTexto('Alteração de vendedor em Pedido/Orçamento carregado.');
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor Anterior', strVenAnt + '-' + fRetNomeOperador(strVenAnt)                  , 18);
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor Atual'   , fatVenda.strCodVen + '-'+ fRetNomeOperador(fatVenda.strCodVen) , 18);
            End;
          End;
        End;

        If Not fEmptyStr(strDirAltVen) Then
        Begin
          If (Not fEmptyStr(fatVenda.strCodVen)) And (fatVenda.strCodVen <> strVenAnt) And (strVenCli <> fatVenda.strCodVen) Then
          Begin
            objLiberacao.strDirAce := strDirAltVen;
            objLiberacao.strSenLib := strSenAltVen;
            objLiberacao.strMsgSen := 'Alteração de Vendedor';
            objLiberacao.strCodOpe := fatVenda.strCodVen;
            objLiberacao.strCodDig := fatVenda.strCodDig;
            objLiberacao.strCliente := (fatVenda.strCodCli + '-' + fatVenda.strCliOri);
            objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

            If Not fatVenda.fFatMensagemLiberacao(objLiberacao) Then
            Begin
              Result := False;
              If (fEmptyStr(strCliAnt)) Or (strCliAnt = edtCodCli.Text) Then
                pRecarregaVendedorAnterior
              Else
                strVenAnt := fatVenda.strCodVen;
            End;
          End;
        End
        Else If (Not Result) And (Not blnVendedorPermitido) Then
        Begin
          pRecarregaVendedorAnterior;
        End;

        If (Result) And (fAtualizaVendedorInativoDosItens(venVendedor, strCodIteVenInat, strCodIteRepInat)) then
          pAtualizaVendedorInativoDosItens(venVendedor, strCodIteVenInat, strCodIteRepInat);

        If (Result) And (blnBuscaPorChave) Then
        Begin
          pAtualizaMatrizLiberacao(fatVenda.strCodVen);

          {**********************************************************************************}
          {* CASO NÃO USE DIGITADOR NEM VEDEDOR 2, O VENDEDOR É O ÚLTIMO CAMPO DO CABEÇALHO *}
          {* PS: PARA AS ESPECIES OU_BR_TE_NC_DV_PR_OE_EF_OF_UC_DD O VENDEDOR 2 FICA INVISIVEL *}
          {*******************************************************************************MV*}
          If (Not blnConfirmandoDadosCabecalho) And
             (fNaoUtilizaDigitadorENaoEhDevolucaoRapida) And
             IIF((Pos(strOpcDoc,'OU_OV_BR_TE_NC_DV_PR_OE_EF_OF_UC_DD_') > 0), True, (Not fCfgSis('REPVEN', varBoolean))) And
             (Not fDevolucaoComADCrmCarregada) Then
            Result := fConfirmaDadosCabecalho;
        End;

        If (Pos(strOpcDoc, 'OR_') > 0) And fCfgSis('UTIPOR', varBoolean) Then
        Begin
          If Not fVerificaPermanenciaOrcPorVend(edtCodCli.Text,
                                                fatVenda.strCodVen,
                                                fatVenda.strNumOrc) Then
          Begin
            Result := False;
          End;
        End;

        If (fCfgSis('TMPFAT', varInteger) > 0) And (blnBuscaPorChave) And (Result) Then
          pExibeDocsFaturSemRomaneio(qryConOpe.FieldByName('OPE_CODOPE').AsString);

        If (fCfgSis('DIASEN', varInteger) > 0) And (blnBuscaPorChave) And (Result) Then
          pExibeDocsFaturSemEntrega(qryConOpe.FieldByName('OPE_CODOPE').AsString);

        If fCfgSis('EXIPEF',varBoolean) And (blnBuscaPorChave) And (Result) Then
          pMostraEntFut(qryConOpe.FieldByName('OPE_CODOPE').AsString);

      End;

      If Result And (fCfgSis('CNDVEN') = 'I') And
        (Not fatVenda.fVendedorComCondicaoPagto(edtCodCnd.Text, mskCndPag.Text)) Then
        Result := False;

      If Result And fCfgSis('HIETAB', VarBoolean) And (fatVenda.strCodVen <> strVenAnt) Then
      Begin
        strTabPreCli := fTabelaPrecoClienteOuVendedor;
        If (Not fEmptyStr(strTabPreCli)) And (cbTabPreco.Text <> strTabPreCli) And cbTabPreco.Visible Then
        Begin
          cbTabPreco.Text := strTabPreCli;
          Result := fValidaCampos(cbTabPreco, True);
        End;
      End;

      If Result Then
        strVenAnt := fatVenda.strCodVen;

      If Result And (Not blnJaInformouVendedor) Then
        blnJaInformouVendedor := True;

      pCarregarProdutosCrmConsumiveis(Result, Sender);

      If Result Then
        pTrataSaldoFlex();

      If Result Then
        blnAlterouVendedor := (strVenAnt = fatVenda.strCodVen);

      {*** Sinaleiro ***}
      If (Result) Then
        If fUtilizaSinaleiro Then
          pCalculaTotais;

      If (Result) And (fCfgSis('CASOPE',varString)= 'S') And (Not edtSenDig.TabStop) And (Not fEmptyStr(edtSenDig.Text)) then
      Begin
        If (Not blnConfirmandoDadosCabecalho) And (blnBuscaPorChave) and (not blnDesativaConfirmaDadosCabecalho) And (Not fDevolucaoComADCrmCarregada) Then
        Begin
          Result := fConfirmaDadosCabecalho;
          if (not Result) and (blnDesativaConfirmaDadosCabecalho) then
            Result := True;
        End;
      End;

    End

    Else If (Sender = edtCodRep) And (pnlRepresentante.Enabled) And (fEmptyStr(edtCodIte.Text)) Then
    Begin

      fatVenda.strCodVe2 := edtCodRep.Text;

      If fEmptyStr(edtCodRep.Text) Then
      Begin
        edtDesRep.Clear;

        If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
          (fCfgSis('OBGVE2', varBoolean)) Then
        Begin
          fMensagem('ATENÇÃO!', 'O vendedor 2 deve ser preenchido!', ['&O k']);
          Result := False;
        End
        Else
        Begin
          {*******************************************}
          {* CASO NÃO USE DIGITADOR, O VENDEDOR É O  *}
          {* ÚLTIMO CAMPO DO CABEÇALHO               *}
          {****************************************MV*}
          If (Not blnConfirmandoDadosCabecalho) And (fNaoUtilizaDigitadorENaoEhDevolucaoRapida) And (Not fDevolucaoComADCrmCarregada)Then
            Result := fConfirmaDadosCabecalho;
        End;
      End
      Else
      Begin

        pCarregaRepres;

        If qryConOpe.FieldByName('OPE_CODOPE').IsNull Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse vendedor não está cadastrado!', ['&O k']);
          Result := False;
        End
        Else If qryConOpe.FieldByName('OPE_STATUS').AsString <> 'A' Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse vendedor está inativo!', ['&O k']);
          Result := False;
        End
        Else If Not fVerificaPermitidoInformarVendedor(False) Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse tipo de vendedor está bloqueado para venda na configuração [CFG_OPUSVD]!', ['&O k']);
          Result := False;
        End
        Else If (blnBuscaPorChave) Then
        Begin
          {*******************************************}
          {* CASO NÃO USE DIGITADOR, O VENDEDOR É O  *}
          {* ÚLTIMO CAMPO DO CABEÇALHO               *}
          {****************************************MV*}
          If (Not blnConfirmandoDadosCabecalho) And (fNaoUtilizaDigitadorENaoEhDevolucaoRapida) And (Not fDevolucaoComADCrmCarregada) Then
            Result := fConfirmaDadosCabecalho;
        End;

        If (Result) Then
        Begin

          If (fatVenda.strCodVe2 <> strRepAnt) Then
          Begin

            If (fCfgSis('SEALV2', VarBoolean)) And
               (fCfgSis('VENESP') <> strVenCli) Then //Exceto o vendedor especial (Cliente sem "Dono")
            Begin

              objLiberacao.Clear;
              objLiberacao.strDirAce  := 'SEALV2';
              objLiberacao.strMsgSen  := 'Alteração de Vendedor 2';
              objLiberacao.strCodOpe  := fatVenda.strCodVen;
              objLiberacao.strCodDig  := fatVenda.strCodDig;
              objLiberacao.strCliente := (fatVenda.strCodCli + '-' + fatVenda.strCliOri);
              objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

              objLiberacao.objMsgLibera.pAddTexto('Alteração de vendedor 2 sugerido.');
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor 2 Anterior', strRepAnt + '-' + fRetNomeOperador(strRepAnt)                  , 20);
              objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor 2 Atual'   , fatVenda.strCodVe2 + '-'+ fRetNomeOperador(fatVenda.strCodVe2) , 20);

              If Not fatVenda.fFatMensagemLiberacao(objLiberacao) Then
              Begin
                Result := False;

                edtCodRep.Text := strRepAnt;
                pCarregaRepres;

              End;

            End;

            pAtualizaVendedorInativoDosItens(venRepresentante, '', '', True);
          End;

          If fAtualizaVendedorInativoDosItens(venRepresentante, strCodIteVenInat, strCodIteRepInat) then
            pAtualizaVendedorInativoDosItens(venRepresentante, strCodIteVenInat, strCodIteRepInat);

        End;

        pCarregarProdutosCrmConsumiveis(Result, Sender);

        If Result And (Not blnJaInformouVendedor2) Then
          blnJaInformouVendedor2 := True;

        If Result Then
        Begin
          strRepAnt := fatVenda.strCodVe2;
          fatVenda.strCodRep := fatVenda.strCodVe2;
        End;

      End;
    End

    Else If (Sender = edtSenDig) And (fEmptyStr(edtCodIte.Text)) Then
    Begin
      If (pnlDigitador.Visible) Then
      Begin
        Result := fValidaCampoEdtSenDig;

        If Result Then
        Begin
          If (Not blnConfirmandoDadosCabecalho) And (blnBuscaPorChave) and (not blnDesativaConfirmaDadosCabecalho) And (Not fDevolucaoComADCrmCarregada) Then
          Begin
            Result := fConfirmaDadosCabecalho;
            if (not Result) and (blnDesativaConfirmaDadosCabecalho) then
              Result := True;
          End;
        End;

        If Not fEmptyStr(edtSenDig.Text) Then
        Begin
          If (fCfgSis('DIGVEN', varString) = 'S') And (fClienteConsumidor(fatVenda.strCliOri)) Then
          Begin
            edtSenVen.Text := fatVenda.strCodDig;
            pCarregaVendedor;
          End;

          {***************************************************}
          { SE O CLIENTE POSSUIR VENDEDOR PADRAO, NO QUAL FOR }
          { O MESMO DA CFG_VENDIG, O VENDEDOR PASSA A SER O   }
          { DIGITADOR                                         }
          {************************************************JB*}
          If SameText(edtSenVen.Text, fCfgSis('VENDIG')) And (Not fEmptyStr(fatVenda.strCodDig)) Then
          Begin
            edtSenVen.Text := fatVenda.strCodDig;
            pCarregaVendedor;
          End;

          pCarregarProdutosCrmConsumiveis(Result, Sender);
        End;
      End;

      If Result Then
        pTrataSaldoFlex();
                   { Ver Req: 147518 }
      If Result And blnBuscaPorChave  Then
        pPosicionarPrimeiroRegistroDeVendas;
    End

    Else If (Sender = edtCodIte) Then
    Begin

      blnInserido := False;

      If ((blnCalcQtdPigmento) And (strCodItePigmento <> edtCodIte.Text)) Or (fEmptyStr(edtCodIte.Text)) Then
        pZeraVariaveisPigmento();

      If (edtCodIte.ReadOnly) And (Not fEstaNaConsultaTab) Then
      Begin
        Result := False;
      End
      Else If fEmptyStr(edtCodIte.Text) Then
      Begin
        If (blnBuscaPorChave) Then
        Begin
          If fEstaNaConsultaTab And blnTrocandoProduto Then
          Begin
            fMensagem('', 'Informe o código do produto!', ['&OK']);
            Result := False;
          End
          Else If (Not blnPesquisando) Then
          Begin
            If InterlockedIncrement(intConfirmando) = 0 Then
            Begin
              Try
                blnMudarFoco := False;
                pHabilitaCamposItem(False);
                pSetFocus(dbgItens);
                pAtualizaDados(Nil);
                InterlockedDecrement(intConfirmando);

                {If (rdbCodFab.Checked) And (Not qryConCit.IsEmpty) Then
                Begin
                  If fEmptyStr(qryConCit.FieldByName('ITE_CODFAB').AsString) Then
                  Begin
                    fMensagem('ATENÇÃO!', 'Esse item não possui código de fábrica!', ['&O k']);
                    Result := False;
                  End;
                End;}
              Except
                On E: Exception Do
                Begin
                  InterlockedDecrement(intConfirmando);
                  pMensagensErro(E.Message, '[frmFatVendas.fValidaCampos]');
                End;
              End;
            End
            Else
              InterlockedDecrement(intConfirmando);
          End;  
        End;
      End
      Else
      Begin

        If (Not blnUtilizandoVendeItem) And (Not fValidaCampos(edtCodCli, True)) Then
        Begin
          Result := False;
        End
        Else
        Begin
          if blnBuscaPorChave And ((not rdbCodIte.Visible) Or (rdbCodIte.Checked)) Then
          Begin
            If fBarrasChapa(edtCodIte.Text) Then
              edtCodIte.Text := fStrZero(Copy(edtCodIte.Text,1,5), fTamCodIte);

            If fIsNumber(edtCodIte.Text) then
            Begin
              if Length(edtCodIte.Text) < fTamCodIte then
                edtCodIte.Text := fStrZero(edtCodIte.Text, fTamCodIte);
            End
            Else
            Begin
              If Not fEmptyStr(Trim(edtCodIte.Text)) Then
              Begin
                blnMudarFoco := False;
                Result := fConsultaProdutos(IIF(CharInSet( edtCodIte.Text[1] , ['0'..'9']),'',edtCodIte.Text),
                                            IIF(Not CharInSet( edtCodIte.Text[1] , ['0'..'9']),'',edtCodIte.Text));
              End
              Else
                Result := False;
            end;
          End;

          If Result Then
          Begin
            If blnBuscaPorChave And ((Pos(strOpcDoc, 'DV_PR_') > 0) Or fatVenda.fEhDevolucaoEspelhoOuParaFornecedor Or fatVenda.fEhOutrasEntradasFornecedorComDocumentoVinculado) Then
            Begin
              blnMudarFoco := False;
              If not fConsultaItemDev(False) Then
              Begin
                Result := False;
                fMensagem('', 'Item não encontrado!', ['&OK']);
              End;
            End
            Else
            Begin
              blnAtuEdits := ((blnBuscaPorChave) And (btnAdicionar.Tag <= 0))  Or
                             ((qryConCit.Active) And (qryConCit.FieldByName('ITE_CODITE').AsString <> edtCodIte.Text));
              Try
                blnMostrouSemelhantesQuandoPesquisandoCodFab := False;

                pCarregaItem(blnBuscaPorChave, blnAtuEdits, True, False, True, True, IIF(fAlterandoProduto, cdsVenda.FieldByName('ITE_SEQEST').AsInteger > 0, False));

                If (blnAtuEdits) Then
                  fatVenda.pLimpaDeletadosDoArrPromocaoQtdeColetiva(intConfirmando, strOpcDoc, fGridVendaVazio, cdsVenda);
                
                If (btnAdicionar.Tag = 0) Then
                Begin
                  blnInserido := fItemJaInserido;

                  blnInserindoMaisUmItemPeloCodBar := ((blnInserido) and (blnTipBusCodBar));

                  If (fUsaEmpIdentificaClienteSemPossibilidaMudar) Then
                  Begin
                    If (Not fValidaCampos(edtCodEmp)) Then
                    Begin
                      blnMudarFoco := False;
                      Result := False;
                    End;
                  End;
                End;

                If Result Then
                Begin
                  If IIF((blnBuscarCodFab And rdbCodFab.Checked), (Not blnMostrouSemelhantesQuandoPesquisandoCodFab) And (Not fatVenda.blnTintaMaquinaEmExecussao), True) Then
                  Begin
                    blnMostrouSemelhantesQuandoPesquisandoCodFab := True;
                    If (btnAdicionar.Tag = 0) And (blnBuscaPorChave) And
                       (fMostraItensSimilares(qryConCit.FieldByName('ITE_CODITE').AsString)) And
                       (qryConCit.FieldByName('ITE_CODITE').AsString <> edtCodIte.Text) Then
                    Begin
                      blnBuscarCodFab := False;
                      pCarregaItem(True, True);
                    End;
                  End;
                End;


                If fTabelaPrecoEmbalagemInvalido(fAlterandoProduto) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Esta embalagem está configurada para utilizar uma tabela de preço inválida!', edtCodIte.Text);
                  btnCancelaItem.Click;
                  Result := False;
                End
                {* A VALIDAÇÃO POR CLAFIS ITEM A ITEM NÃO É ADEQUADA AQUI, MAS SIM, NO FINAL DA VENDA POIS É LÁ QUE FICARÁ DEFINIDA QUAL VAI SER A CLAFIS PRINCIPAL REQ.: 73736 VA*}
                //Else If ((Pos(strOpcDoc, 'BR_') > 0) Or (Pos(fatVenda.strClaFis, '5910_6910_') > 0) Or (fatVenda.strTipOpe = 'B')) And
                Else If ((Pos(strOpcDoc, 'BR_') > 0) Or (fatVenda.strTipOpe = 'B')) And
                        (qryConCit.FieldByName('ITE_USABON').AsString = 'N') Then
                Begin
                  fMensagem('ATENÇÃO!', 'Esse item não pode ser bonificado!', ['&O k']);
                  Result := False;
                End
                Else If (qryConCit.FieldByName('ITE_CODITE').IsNull) Or (Not blnExisteIteger) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Esse item não está cadastrado!', edtCodIte.Text);
                  Result := False;
                End
                Else If qryConCit.FieldByName('ITE_ITEATI').AsString <> 'S' Then
                Begin
                  pLimpaDadosItem;
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Esse item está Inativo!', edtCodIte.Text);
                  Result := False;
                End
                Else If fatVenda.blnCliFil And (Pos(fatVenda.strOpcDoc, 'BR_UC_PA_') = 0) And (fatVenda.fPegaPrecoSugeridoTE(qryConIte, fRetEmpresaItem, fatVenda.strPromoc) <= 0.00) Then
                Begin
                  pLimpaDadosItem;
                  fMensagem('ATENÇÃO!', 'Não é permitido informar este produto para um cliente filial, ' +
                                        'pois o ' + fatVenda.fDescricaoCampoPrecoSugeridoTE +  ' ' +
                                        'deve ser maior que zero. Verifique este preço no cadastro do produto!', ['&O k']);
                  Result := False;
                End
                Else If fatVenda.blnCliFil And (fatVenda.strOpcDoc = 'PA') And (fatVenda.fPegaPrecoSugeridoPA(qryConIte, fRetEmpresaItem, fatVenda.strPromoc) <= 0.00) Then
                Begin
                  pLimpaDadosItem;
                  fMensagem('ATENÇÃO!', 'Não é permitido informar este produto para um cliente filial, ' +
                                        'pois o ' + fatVenda.fDescricaoCampoPrecoSugeridoPA +  ' ' +
                                        'deve ser maior que zero. Verifique este preço no cadastro do produto!', ['&O k']);
                  Result := False;
                End
                Else If (fCfgSis('UTI_RE', varString, fRetEmpresaItem()) = 'S') And
                        (Pos(fatVenda.strOpcDoc, 'PD_OR_') > 0) And
                        (Not SameText(fRetEmpresaItem(), fCfgSis('EMPRES', VarString))) And
                        (fatVenda.fPegaPrecoSugeridoTE(qryConIte, fRetEmpresaItem, fatVenda.strPromoc) <= 0.00) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido informar este produto quando (CFG_UTI_RE = SIM) '+
                                                       'na empresa do item (' + fRetEmpresaItem() + '), ' +
                                                       'pois o ' + fatVenda.fDescricaoCampoPrecoSugeridoTE +  ' ' +
                                                       'na empresa (' + qryConIte.FieldByName('ITE_CODEMP').AsString + ') ' +
                                                       'deve ser maior que zero. Verifique este preço no cadastro do produto!', edtCodIte.Text);
                  pLimpaDadosItem;
                  Result := False;
                End
                Else If fEhItemServico(qryConCit.FieldByName('ITE_CODITE').AsString) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido vender um item de Serviço!', edtCodIte.Text);
                  Result := False;
                End
                Else If (qryConCit.FieldByName('ITE_CODITE').AsString = fCfgSis('ITEFRE')) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido vender o item de Frete!', edtCodIte.Text);
                  Result := False;
                End
                Else If (qryConIte.FieldByName('ITE_DTABAL').AsDateTime >= VS_Date) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido vender um item com data de balanço ' + DateToStr(VS_Date) + '. Verifique!', edtCodIte.Text);
                  Result := False;
                End
                Else If (not fValidaPermiteVenderPara(False)) Then
                Begin
                  Result := False;
                End
                {************************************************************}
                {* VALIDA SE É ITEM ORDEM DE SERVIÇO EM ALTERAÇÃO DE PEDIDO *}
                {*********************************************************AF*}
                Else If (fCfgSis('OSPDVN', varString) = 'S') And (qryConCit.FieldByName('ITE_ORDSER').AsString = 'S') And (Not fEmptyStr(strNumOrc)) And (strEspOrc = 'PD') Then
                Begin
                  fMensagem('','Não é possível inserir dados na ordem de serviço em um pedido já emitido!',['&OK']);
                  Result := False;
                End
                Else If Not fValidaItemNaoAcabado(False) Then
                Begin
                  Result := False;
                End
                {******************************************************************}
                {* Sistema configurado para rateio de frete proporcional ao peso  *}
                {***************************************************************JC*}
                Else If (fCfgSis('RATFRV') = '2')                         And
                        (qryConCit.FieldByName('ITE_PESOIT').AsFloat = 0) And
                        (Pos(strOpcDoc, 'PD_OR_VN_') > 0)                 And
                        (btnAdicionar.Tag <= 0)                           Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido inserir um produto sem peso informado no cadastro!', edtCodIte.Text);
                  Result := False;
                End
                {**********************************************}
                {* NÃO PERMITE REALIZAR EMPRÉSTIMO DE ENTRADA *}
                {* PARA PRODUTOS DE TINTA DE MAQUINA.         *}
                {*******************************************PZ*}
                Else If (strOpcDoc = 'EP')            And
                        (fatVenda.strIdePro <> 'NOR') And
                        (SameText(fRetTipEmp, 'E'))   Then
                Begin
                  fMensagem('ATENÇÃO!', 'Não é permitido realizar empréstimo de entrada para produtos de tinta de máquina', ['&O k']);
                  Result := False;
                End
                {***************************************}
                {* ITEM VIDRO SOMENTE PARA PD/OR/VN/CP *}
                {************************************JC*}
                Else If (fEhItemVendaVidro(qryConCit.FieldByName('ITE_CODITE').AsString)) And
                        (Pos(strOpcDoc, 'PD_OR_VN_CP_DV_') <= 0)                          And
                        (btnAdicionar.Tag <= 0)                                           Then
                Begin
                  fMensagem('ATENÇÃO!', 'Item para venda de vidro permitido apenas para Orçamento / Pedido / Venda Normal / Devolução!', ['&O k']);
                  Result := False;
                End
                {***************************************}
                {* ITEM ESPECIAL SOMENTE PARA OR/PD    *}
                {************************************MV*}
                Else If (Not fPermiteItemEspecial(strOpcDoc)) And
                        (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0) And
                        (fatVenda.strIdePro = 'NOR')                                             And
                        (btnAdicionar.Tag <= 0)                                                  Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Item especial não permitido para ' + IIF(fRetDescOpcDoc(strOpcDoc).IsEmpty, 'opção de documento ' + strOpcDoc, fRetDescOpcDoc(strOpcDoc)) + '!', edtCodIte.Text);
                  Result := False;
                End
                Else If (Not fValidaVendedorMarca(fatvenda.strCodVen, edtCodIte.Text, strOpcDoc)) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Item com Marca não permitida para este vendedor informado. Verifique!', edtCodIte.Text);
                  Result := False;
                End
                Else If (Not fEmptyStr(strCliMarcas)) And (Pos(qryConCit.FieldByName('ITE_CODMAR').AsString, strCliMarcas) <= 0) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Item com Marca não permitida para este vendedor informado. Verifique!', edtCodIte.Text);
                  Result := False;
                End
                Else If (Not fValidaCfgITEVEN(fatvenda.strCodVen, fatvenda.strCodCli, edtCodIte.Text, strOpcDoc)) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Item com Marca/Fornecedor não permitida para o vendedor informado. Verifique!', edtCodIte.Text);
                  Result := False;
                End
                Else If (Not fEmptyStr(edtCodEmp.Text)) And (Not fEmpresaExiste(edtCodEmp.Text)) Then
                Begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'A empresa não foi informada corretamente. Verifique!', edtCodIte.Text);
                  Result := False;
                End
                Else If (fNaoPossuiLoteADefinirCadastrado(qryConCit.FieldByName('ITE_CODITE').AsString, edtCodEmp.Text, blnProAca)) Then
                Begin
                  FatVenda.pMostraMensagem('', 'Produto ' + qryConCit.FieldByName('ITE_CODITE').AsString + '-' +
                                               qryConCit.FieldByName('ITE_DESITE').AsString + ' não possui Lote A DEFINIR cadastrado!', edtCodIte.Text);
                  Result := False;
                End
                Else If fUsaRotinaWMS(fatVenda.fEmpresaSaldoMatriz_CD) And (fatVenda.strIdePro <> 'NOR') And
                        Not fatVenda.objCadLot.fExisteLotePrincipalTintaMaquina(qryConCit.FieldByName('ITE_CODITE').AsString, fatVenda.fEmpresaSaldoMatriz_CD) Then
                Begin
                  FatVenda.pMostraMensagem('', 'Produto ' + qryConCit.FieldByName('ITE_CODITE').AsString + '-' +
                                               qryConCit.FieldByName('ITE_DESITE').AsString + ' não possui "Lote Principal para Tinta de Máquina" cadastrado!', edtCodIte.Text);
                  Result := False;
                End
                Else If (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) = 0) And
                        (not fEhItemServico(qryConCit.FieldByName('ITE_CODITE').AsString)) And
                        (fatVenda.strIdePro = 'NOR') Then
                Begin

                  fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                fTabelaPrecoItem);

                  If (fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat) <= 0) Then
                  Begin
                    FatVenda.pMostraMensagem('','Produto: ' + qryConCit.FieldByName('ITE_CODITE').AsString + ' - ' +
                                             qryConCit.FieldByName('ITE_DESITE').AsString + #13 +
                                             ' com valor de custo inválido. Verifique!', edtCodIte.Text);
                    Result := False;
                  End;

                End;

                {***************************************}
                {* ITEM ESPECIAL SOMENTE COM SENHA     *}
                {************************************LU*}
                If Result And
                  (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0) And
                  (btnAdicionar.Tag <= 0)                                                  And
                  (Not blnBuscaPorChave)                                                   And
                  (fatVenda.strIdePro = 'NOR')                                             And
                  (Not fEmptyStr(fCfgSis('SENIES'))) Then
                Begin
                  objLiberacao.Clear;
                  objLiberacao.objMsgLibera.pAddTexto('Item especial - necessário digitação de senha para liberação!');

                  objLiberacao.strDirAce := 'LBITES';
                  objLiberacao.strSenLib := fCfgSis('SENIES');
                  objLiberacao.strMsgSen := 'Liberação de Item Especial';
                  objLiberacao.strCodOpe := IIF(fEmptyStr(fatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), fatVenda.strCodVen);
                  objLiberacao.strCodDig := fatVenda.strCodDig;
                  objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
                  objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

                  If Not (fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
                  Begin
                    fMensagem('','Senha para Item Especial incorreta!',['&OK']);
                    Result := False;
                  End;
                End;

                If (Not fatVenda.fValidarSeClienteEstoqueExternoPermiteFaturamento(edtCodCli.Text, strEstoqueExterno)) Then
                Begin
                  strTitEtr := 'T';
                  strTraIte := 'T';
                End;

                If Result And
                  (btnAdicionar.Tag = 0) {Incluindo} And
                  (Pos(strOpcDoc,'VN_OR_PD_CS_TE_') > 0) And
                  IIF(strOpcDoc = 'TE', (strTitEtr <> 'N'), (strTraIte <> 'N')) And
                  (fEmptyStr(strCodAca)) And
                  (fatVenda.strIdePro = 'NOR') And //SOMENTE PRODUTOS NORMAIS
                  (Not fEhItemVendaVidro(fCodItem)) And
                  blnInserido And
                  fEmptyStr(recDuplicaItem.strCodIte) And
                  (Not blnBuscaPorChave) And
                  (Not chkCheckOut.Checked) Then
                Begin
  {               If fCfgSis('SLTFRC', varBoolean) Then
                  Begin
                    fMensagem('','Não é permitido adicionar item repetido quando sistema configurado para ' +
                      'Definir tipo de abastecimento de estoque no Pedido de Venda!', ['&Ok']);
                    Result := False;
                  End
                  Else}
                  If (Not fatVenda.fValidarSeClienteEstoqueExternoPermiteFaturamento(edtCodCli.Text, strEstoqueExterno)) Then
                  Begin
                    FatVenda.pMostraMensagem('', Format('Não é permitido adicionar item repetido quando cliente do estoque externo '+
                      '"%s" não pode emitir faturamento pelo Autcom!', [strEstoqueExterno]), edtCodIte.Text);
                    Result := False;
                  End
                  Else
                  If IIF(strOpcDoc = 'TE', (strTitEtr <> 'N'), (strTraIte <> 'N')) Then
                  Begin
                    FatVenda.pMostraMensagem('','O item ' + edtCodIte.Text + ' já foi incluido nessa ' + IfThen(strOpcDoc = 'TE', 'transferência.', 'venda.'), edtCodIte.Text);
                    If IIF(strOpcDoc = 'TE', (strTitEtr = 'T'), (strTraIte = 'T')) Then
                    Begin
                      objLiberacao.Clear;
                      objLiberacao.objMsgLibera.pAddTexto('Item ' + edtCodIte.Text + ' - ' +  LeftStr(edtDesIte.Text,50) + ' repetido na ' + IfThen(strOpcDoc = 'TE', 'transferência.', 'venda.'));

                      objLiberacao.strDirAce := IfThen(strOpcDoc = 'TE', 'SENITR', 'SENITE');
                      objLiberacao.strSenLib := IIF(strOpcDoc = 'TE', fCfgSis('SENITR'), fCfgSis('SENITE'));
                      objLiberacao.strMsgSen := 'Item repetido na ' + IfThen(strOpcDoc = 'TE', 'transferência', 'venda');
                      objLiberacao.strCodOpe := fatVenda.strCodVen;
                      objLiberacao.strCodDig := fatVenda.strCodDig;
                      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
                      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

                      Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
                    End;
                  End;

                  If Not Result Then
                    cdsVenda.Locate('ITE_CODITE', fCodItem, []);
                End;

                If Result And
                  (blnCodBarEmb) And
                  (Not fEmptyStr(strCodBarEmb)) And
                  (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And
                  (btnAdicionar.Tag = 0) Then
                Begin
                  If (Not fatVenda.fEmbalagemNaoMostraFaturamento(strCodBarEmb, qryConCit.FieldByName('ITE_CODITE').AsString)) Then
                  Begin
                    FatVenda.pMostraMensagem('ATENÇÃO', 'Embalagem informada não é permitida no faturamento. Verifique!', edtCodIte.Text);
                    btnCancelaItem.Click();
                    Result := False;
                  End
                End;

                {**************************************}
                {* VALIDA SE É ITEM ORDEM DE SERVIÇO  *}
                {***********************************AF*}
                If Result And (fCfgSis('OSPDVN', varString) = 'S') And (qryConCit.FieldByName('ITE_ORDSER').AsString = 'S') And (Pos(strOpcDoc,'PD_OR_VN') > 0) Then
                Begin
                  edtQtdIte.Enabled := False;
                  {**************************************}
                  {* SE FOR PELO ENTER ABRE A JANELA DE *}
                  {* DIGITAÇÃO DO DADOS                 *}
                  {***********************************AF*}
                  If blnBuscaPorChave Then Begin
                    Result := fCarregaOrdemServicoVenda(qryConCit.FieldByName('ITE_CODITE').AsString, qryConCit.FieldByName('ITE_CODGRU').AsString, cdsVenda.FieldByName('ITE_SEQIND').AsInteger);
                  End Else Begin
                    If (Not fatVenda.objOrdSer.cdsOrdSer.Locate('ORD_CODITE;ORD_SEQIND',
                           VarArrayOf([qryConCit.FieldByName('ITE_CODITE').AsString,
                                       IIF(btnAdicionar.Tag = 0, fatVenda.objOrdSer.intSeqIndProd, cdsVenda.FieldByName('ITE_SEQORS').AsInteger)]), [])) Then
                    Begin
                      fMensagem('','Os dados do item ordem de serviço deve ser digitado!',['&OK']);
                      Result := False;
                    End;
                  End;
                End;

                If Result And (Not fPermiteVenderSubItemEstruturaAvulso(qryConCit.FieldByName('ITE_CODITE').AsString)) Then
                Begin
                  If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fatVenda.blnCarregandoEstrutura) And (Not fatVenda.blnCliFil) Then
                  Begin
                    ItemEstrutura := fEhOuCompoeEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
                    If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
                    Begin
                      FatVenda.pMostraMensagem('', 'Sub-Produto ' + qryConCit.FieldByName('ITE_CODITE').AsString + '-' +
                                                   qryConCit.FieldByName('ITE_DESITE').AsString + ' não permitido para venda em separado! Somente estrutura completa.', edtCodIte.Text);
                      Result := False;
                    End;
                  End;
                End;

                If Result And (Not fPermiteTransferenciaSubItemEstruturaAvulso(qryConCit.FieldByName('ITE_CODITE').AsString)) Then
                Begin
                  If (Pos(strOpcDoc, 'TE_') > 0) And (Not fatVenda.blnCarregandoEstrutura) Then
                  Begin
                    ItemEstrutura := fEhOuCompoeEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
                    If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
                    Begin
                      fatVenda.pMostraMensagem('', 'Sub-Produto ' + qryConCit.FieldByName('ITE_CODITE').AsString + '-' +
                                                   qryConCit.FieldByName('ITE_DESITE').AsString + ' não permitido para transferência em separado! Somente estrutura completa.', edtCodIte.Text);
                      Result := False;
                    End;
                  End;
                End;

                If Result And (Not fProdutoPermitidoTransferenciaEstoque) Then
                Begin
                  pMensagemOk(qryConCit.FieldByName('ITE_CODITE').AsString + '-' + qryConCit.FieldByName('ITE_DESITE').AsString +
                              ' não tem permissão para Transferência de Estoque! ' + #10#13 + 'Verifique.');
                  Result := False;
                End;

                lblProdutoPromocao.Visible := (Pos(strOpcDoc, 'PD_') > 0) And
                                              (Not fEmptyStr(fDadosPromocao(edtCodIte.Text,
                                                             fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                                             fatVenda.strCodCli,
                                                             fTabelaPrecoItem,
                                                             '',
                                                             strNumOrc,
                                                             strEspOrc).strCodPro));

                If (fCfgSis('EXDEPR', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
                Begin
                  If (blnAtuEdits) And (Not fItemSemNenhumaPromocao(edtCodIte.Text, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) Then
                  Begin
                    strCodPro := fDadosPromocao(edtCodIte.Text,
                                                fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                                fatVenda.strCodCli,
                                                fTabelaPrecoItem,
                                                '',
                                                strNumOrc,
                                                strEspOrc).strCodPro;

                    pDetalhesPromocao(edtCodIte.Text, fRetEmpresaItem, fTabelaPrecoItem, strCodPro);
                  End;
                End;

                If Result And fatVenda.fPrecoPautaFiscalDesatualizado(qryConCit.FieldByName('ITE_CODITE').AsString) Then
                Begin
                  fMensagem('ATENÇÃO!', 'O Item '+qryConCit.FieldByName('ITE_CODITE').AsString+' possui Preço de Pauta Fiscal desatualizado.'+#13+
                                        'Verifique o cadastro do produto!', ['&Ok']);
                  Result := False;
                End;

                If (fCfgSis('MSGEMF', varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
                Begin
                  If (blnAtuEdits) And (fTemQuantEmbalagemFechada(edtCodIte.Text)) Then
                    pVerificaQtdEmbalagemFechadaItem(edtCodIte.Text);
                End;

                If ((fCfgSis('EMPFAT', varString) = 'S') Or (fCfgSis('EMPFVN', varString) = 'S')) And(strIteAnt <> edtCodIte.Text) And (not blnEhInclusaoDeLoteRapido) And (Not blnInsercaoProdutoAgregadoComMultiLoja) And (Not blnInserindoCombo) Then
                Begin
                  strEmpSug := fCampoTabela('ITE_EMPSUG', 'CADITE', ['ITE_CODITE'], [edtCodIte.Text], False);
                  strEmpIde := fCampoTabela('CLI_EMPIDE', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text]);

                  If Not fEmptyStr(strEmpSug) And ((Not fCfgSis('OBEMID', varBoolean)) Or (fEmptyStr(strEmpIde))) Then
                  Begin
                    edtCodEmp.Text := strEmpSug;
                  End
                  Else
                  Begin
                    edtCodEmp.Text := strEmpAnt;
                  End;

                  if fCfgSis('NOMEMP') = '2' then
                  begin
                    edtNomEmp.Text := fRetFantasiaEmpresa(edtCodEmp.Text);
                  end
                  else
                  begin
                    edtNomEmp.Text := fRetNomeEmpresaSelec(edtCodEmp.Text);
                  end;

                  strIteAnt := edtCodIte.Text;
                End;

                If Result And (fCfgSis('UTIFMP', varString) = 'S') And
                   (Pos(strOpcDoc, 'OR_PD_VN_CP_CF_CI_') > 0) And
                   (fFornecedorNaoPermitidoParaCliente(edtCodCli.Text, qryConCit.FieldByName('ITE_CODFOR').AsString)) Then
                Begin
                  FatVenda.pMostraMensagem('', 'Fornecedor: ' + qryConCit.FieldByName('ITE_CODFOR').AsString + ' - ' +
                                               fRetNomFornecedor(qryConCit.FieldByName('ITE_CODFOR').AsString) +
                                               ' não permitido para o Cliente!', edtCodIte.Text);
                  Result := False;
                End;

                If Result And (fCfgSis('UTIFMP', varString) = 'S') And
                   (Pos(strOpcDoc, 'OR_PD_VN_CP_CF_CI_') > 0) And
                   (fMarcaNaoPermitidoParaCliente(edtCodCli.Text, qryConCit.FieldByName('ITE_CODMAR').AsString)) Then
                Begin
                  FatVenda.pMostraMensagem('','Marca: ' + qryConCit.FieldByName('ITE_CODMAR').AsString + ' - ' +
                                              fRetNomMarca(qryConCit.FieldByName('ITE_CODMAR').AsString) +
                                              ' não permitida para o Cliente!', edtCodIte.Text);
                  Result := False;
                End;

              Except
                On E: ExceptionAutCom Do
                Begin
                  Result := False;
                  pMensagemOk(E.Message);
                End;

                On E: Exception Do
                Begin
                  Result := False;
                  pMensagensErro(E.Message,'[TfrmFatVendas.fValidaCampos]');
                End;
              End;
            End;
          End;
        End;

        //Caso seja item de vidro
        If Result And btnEstruturaVidro.Visible Then
        Begin
          //Caso esteja no campo de codigo ou ainda nao tenha informado nenhum item da estrutura
          If blnBuscaPorChave Or Not fatVenda.objEstruturaVidros.blnTemSubItensDigitados Then
          Begin
            //Pede a tela de digitacao da estrutura do vidro
            Result := fDigitarEstruturaVidro;
          End;
        End;

        if (Result) and (blnBuscaPorChave) and
           ((Assigned(fatVenda) and fatVenda.blnCliFil) or
             fClienteFilial(edtCodCli.Text)) and
           (Pos(strOpcDoc, 'TE_PD_OR_VN_') > 0) and
           (not fEmptyStr(edtCodCli.Text)) and
           (not fEmptyStr(edtCodIte.Text)) and
           (not fEmptyStr(fCodEmp)) then
        begin
          if (Not fEmptyStr(fatVenda.strEmp_TE)) then
            strCliente := fRetornaClienteFilial(fatVenda.strEmp_TE)
          Else
            strCliente := edtCodCli.Text;

          If (fCfgSis('APOPNF', varString) = 'S') And
             (fVerificaExisteItemProdutoTransferenciaNaoFaturadas(fCodEmp, strCliente, edtCodIte.Text)) Then
          begin
            FatVenda.pMostraMensagem('ATENÇÃO!','Há Pedido/Orçamento em aberto para esse item de transferência de estoque, verifique!', edtCodIte.Text);
          end;
        end;

        If Result And blnBuscaPorChave And blnAtuEdits And chkCheckOut.Checked Then
        Begin
          blnMudarFoco := False;
          pAdicionaItemAutomatico(True, blnInserido);
        End;

        if Result and blnUtilizaChecklistGarantia then
          TCheckListGarantiaController.pImprimirCheckListTrocaMercadoria(edtCodIte.Text,VS_strCodEmp, True);

      End;

    End

    Else If (Sender = edtDesIte) Then
    Begin

      If (blnBuscaPorChave) Then
      Begin
        If (fCfgSis('CUSESP', varBoolean))                                          And
           (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0) Then
        Begin

          If (fatVenda.strIdePro = 'NOR') Then
          Begin
            parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);

            fatVenda.fltPreCus := fDigPrecoCusto;
            fatVenda.fltUniOri := fCalculaPrecoVenda(1, fatVenda.fltPreCus, 0.0, fCfgSis('MMIIES', varDouble), 0.0, 0.0, 0.0, 0.0, fatVenda.VS_strMARMKP, '', -1, 0, False, 0, 0, 0, fatVenda.fRestringirElementosMargem);
            fatVenda.fltUniVis := fatVenda.fltUniOri;
            fatVenda.fltTaxJur := 0;
            fatVenda.fltVal_RT := 0;
            edtUnitar.Text     := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

            strCodSit := '';
            If Not fEmptyStr(fatVenda.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString)) Then
              strCodSit := qryConAbf.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString)).AsString;

            fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                          qryConIte.FieldByName('ITE_CODEMP').AsString,
                                          fTabelaPrecoItem);

            fatVenda.fltPreCu2 := parPreCus.fCalculaPrecoCustoRealVenda(fStrToFloat(edtUnitar.Text),
                                                                        fatVenda.fltPreCus,
                                                                        IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat), fatVenda.fltOutVal),
                                                                        IIF((fatVenda.strIdePro = 'NOR'), IIF(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte), fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)), fatVenda.fltIcmSai),
                                                                        IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat), fatVenda.fltImpFed),
                                                                        IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat), fatVenda.fltDesOpe),
                                                                        IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fGetAlqDifal(qryConIte.FieldByName('ITE_CODITE').AsString, fRetEmpresaItem, qryConAbf.FieldByName('ABF_CODABF').AsString, strCodSit), 0),
                                                                        IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fGetAlqFcpIcms( qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                                                                          qryConAbf.FieldByName('ABF_CODABF').AsString,
                                                                                                          strCodSit,
                                                                                                          IIF(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConCit.FieldByName('ITE_CODITE').AsString,
                                                                                                                                                                 qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte), fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)),
                                                                                                          fStrToFloat(edtUnitar.Text)),0));

            FreeAndNil(parPreCus);
          End;

        End;
      End;

      If fCarregarEstruturaVidro(fCodItem, btnAdicionar.Tag, False) Then
      Begin
        fAtualizaPrecosEstruturaVidro(fTabelaPrecoItem, fEntregaFuturaItem, fRetEmpresaItem);
      End;

      pAtualizaUnitarioLiquido;

    End

    Else If (Sender = edtUnidad) Then
    Begin

      If (Not fEmptyStr(edtCodIte.Text)) Then
      Begin

        If (fEmptyStr(edtUnidad.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'A unidade deve ser preenchida!', ['&Ok']);
          Result := False;
        End
        Else If (fEmptyStr(fRetNomUnidade(edtUnidad.Text))) Then
        Begin
          fMensagem('ATENÇÃO!', 'Essa unidade não está cadastrada!', ['&Ok']);
          Result := False;
        End
        Else If (Not fEmptyStr(fRetNomUnidade(edtUnidad.Text))) Then
        Begin
           edtSigla.Text := fRetSiglaUnidade(edtUnidad.Text, qryCadUni);
           pSetLabelUnidadeMedida;
        End;

        If Result Then
        Begin
          If ((fStrToFloat(edtQtdPec.Text) = 0) And (fStrToFloat(edtQtdIte.Text) = 0)) Then
            pHabilitarMetragem(edtCodIte.Text, edtUnidad.Text);
        End;

      End;

    End

    Else If (Sender = edtCodEmp) Then
    Begin

      If (Result) And fSelecionouEmpresaDoClienteFilial(edtCodEmp.Text) Then
      Begin
        fMensagem('','ATENÇÃO! Não é permitido informar a Empresa do Cliente Filial!', ['&O k']);
        Result := False;
      End;

      If pnlEmpresa.Visible Then
      Begin
        If Not fEmptyStr(edtCodEmp.Text) Then
          edtCodEmp.Text := fStrZero(edtCodEmp.Text, 3);

        edtNomEmp.Text := fRetornaNomeDaEmpresa(edtCodEmp.Text);

        If fEmptyStr(edtCodEmp.Text) Then
        Begin
          fMensagem('ATENÇÃO!', 'Informe o Código da Empresa para o Item!', ['&Ok']);
          Result := False;
        End

        Else If fEmptyStr(edtNomEmp.Text) Then
        Begin
          fMensagem('ATENÇÃO!', 'Empresa não encontrada!', ['&Ok']);
          Result := False;
        End

        Else If (fCfgSis('ACEMPI', varBoolean)) And (Pos(edtCodEmp.Text, strEmpMultiLojaUsuarioLogado) <= 0) Then
        Begin
          If (Not blnEdtCodEmpOnExit) Then
            fMensagem('ATENÇÃO!', 'Usuário sem permissão de acesso a essa Empresa!', ['&O k']);
          Result := False;
        End

        Else If (edtCodEmp.Text <> VS_strCodEmp) And chkEntCD.Checked Then
        Begin
          fMensagem('','Não é possível utilizar multi-empresa, pois foi ' +
                       'selecionado a opção entrega pelo CD!', ['&Ok']);
          edtCodEmp.Text := VS_strCodEmp;
          Result := False;
        End

        Else If (edtCodEmp.Text <> VS_strCodEmp) And (edtOprFlj.Text = 'S') Then
        Begin
          fMensagem('','Não é possível utilizar multi-empresa, pois foi ' +
                       'selecionado a opção Gerar produção fora da loja!', ['&Ok']);
          edtCodEmp.Text := VS_strCodEmp;
          Result := False;
        End

        Else If Not fEmptyStr(fatVenda.strEmp_TE) And (edtCodEmp.Text <> fatVenda.strEmp_TE) Then
        Begin
          fMensagem('','Não é permitido informar uma empresa diferente da empresa ' +
                       'selecionada para emissão da transferência de estoque!', ['&Ok']);
          edtCodEmp.Text := fatVenda.strEmp_TE;
          Result := False;
        End

        Else If (fCfgSis('USATMQ', varBoolean)) And (Not fEmptyStr(fCodItem)) And (Not fEmptyStr(fatVenda.strIdePro)) And (fatVenda.strIdePro <> 'NOR') and
                (edtOprFlj.Text = 'N') And (Pos(fatVenda.strIdePro, fCadEmpDes('TINDIS', edtCodEmp.Text)) <= 0) then
        begin
          fMensagem('','Empresa não tem permissão para produzir esta Tinta!', ['&Ok']);
          edtCodEmp.Text := VS_strCodEmp;
          Result := False;
        End

        Else If (btnAdicionar.Tag > 0) And (edtCodEmp.Text <> cdsVenda.FieldByName('ITE_EMPITE').AsString) And
                (Not fatVenda.fPodeTrocarEmpresaItensPREPTE()) Then
        Begin
          edtCodEmp.Text := cdsVenda.FieldByName('ITE_EMPITE').AsString;
          Result := False;
        End;

        If Result And fatVenda.blnPraticarPrecosEmpresaFaturamento Then
        Begin
          If fCampoEmpresasNoServidorPreenchido(edtCodEmp.Text, VS_strCodEmp) Then
          Begin
            If Not fEmpresasNoMesmoServidor(edtCodEmp.Text, VS_strCodEmp) And Not VS_ConfiguracoesSincronizadas Then
            Begin
              pMensagemOk('Não é permitido informar uma empresa que não esteja no mesmo servidor quando ' +
                          'o sistema está configurado para praticar os preços da empresa destino!');
              Result := False;
            End;
          End
          Else If Not fEmpresaNesteServidor(edtCodEmp.Text) And Not VS_ConfiguracoesSincronizadas Then
          Begin
            pMensagemOk('Não é permitido informar uma empresa que não esteja neste servidor quando ' +
                        'o sistema configurado para praticar os preços da empresa destino!');
            Result := False;
          End
          Else If Not fatVenda.fValidaConfiguracoesEmpresaFaturamento(edtCodEmp.Text, strMsgTmp) Then
          Begin
            TfrmMemo.pShowMessage(strMsgTmp);
            Result := False;
          End;
        End;

        If Result And blnBuscaPorChave And (Not fCfgSis('EXILIS', varBoolean)) Then
        Begin

          If (Not fEmptyStr(fCodItem)) And (Not fatVenda.fImprimeListaItem(edtCodEmp.Text, fCodItem)) Then
          Begin
            Result := False;
          End;

        End;

        If Result And blnBuscaPorChave Then
        Begin
          strEmpSalRes := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

          If fatVenda.blnSaldoMatriz Then
            fltSaldoItemAtu := fatVenda.fltSaldoMatriz
          Else
            fltSaldoItemAtu := fRetSaldosEmpresa(edtCodIte.Text,
                                                 edtCodEmp.Text,
                                                 edtNumLot.Text,
                                                 fatVenda.fIgnorarLote(strEmpSalRes, edtCodIte.Text) Or fUtilizouDefinicaoLoteSeparacaoSemWMS());

          If fUsaQtdPendenteEntregaFutura(True, strEmpSalRes) Then
            fltSaldoItemAtu := fltSaldoItemAtu + TEntregaFutura.New(
                                                   TParamEF.New()
                                                     .CodIte(edtCodIte.Text)
                                                     .CodEmp(strEmpSalRes)
                                                     .Lote(fRetNumLoteSeAdequado(strEmpSalRes, '', edtCodIte.Text))
                                                     .Faturamento(True)
                                                   ).Total();

          If blnProAca Then
            fltSaldoItemAtu := TProdAcabado.fRetornaSaldo(strCodAca,strEmpAca,edtCodEmp.Text);

          pCalculaSaldoPigmento();

          If (blnProAca) Then
            fltSaldoResItemAtu := 0
          Else
            fltSaldoResItemAtu := TSaldoReservado.New(
                                    TReservaParametros.New()
                                      .EmpresaItem(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, ''))
                                      .NumeroDocumento(fatVenda.strNumOrc)
                                      .CodigoItem(qryConIte.FieldByName('ITE_CODITE').AsString)
                                      .CodEmpresa(strEmpSalRes)
                                      .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                                      .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                                      .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                                      .NumeroLote(fRetNumLoteSeAdequado(strEmpSalRes, '', qryConIte.FieldByName('ITE_CODITE').AsString))
                                      .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                                   ).fGetQuantidade();

          fltQtdeDigitada := fatVenda.fRetQtdDigitada(edtCodIte.Text, 
                                                      fRetNumLoteSeAdequado(strEmpSalRes, '', edtCodIte.Text),
                                                      '',
                                                      '', 
                                                      '', 
                                                      edtCodEmp.Text);

          edtSalDis.Text := FormatFloat(edtQtdIte.EditFormat, (fltSaldoItemAtu - fltSaldoResItemAtu) - fltQtdeDigitada);
          pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
          pHintSaldoDisponivel;
        End;

        If (Result)                                 And
           (blnBuscaPorChave)                       And
           (fatVenda.blnEmpFat)                     And
           (Not SameText(edtCodEmp.Text, strEmpAnt) And
           (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor)And
           (Pos(strOpcDoc, 'DV_PR_DD_') <= 0))      Then
        Begin
          blnEmpAntPro := fItemSemNenhumaPromocao(edtCodIte.Text, strEmpAnt);
          blnEmpAtuPro := fItemSemNenhumaPromocao(edtCodIte.Text, fatVenda.fGetEmpPrecoPromoItem(edtCodEmp.Text));

          If (blnEmpAntPro <> blnEmpAtuPro) Or fatVenda.blnPraticarPrecosEmpresaFaturamento Then
          Begin
            fltQtdAnt := fStrToFloat(edtQtdIte.Text);
            If fltQtdAnt = 0 Then
              If (qryConCit.FieldByName('ITE_MLTVEN').AsFloat > 0) Then
                fltQtdAnt := qryConCit.FieldByName('ITE_MLTVEN').AsFloat
              Else
                fltQtdAnt := 1;
            pCarregaItem(True, (fatVenda.strIdePro = 'NOR'), False, False, False);
            edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, fltQtdAnt);
            pAtualizaUnitarioSugestao;
            pCalculaTotIte;
          End;

          If (fatVenda.strIdePro <> 'NOR') Then
            pRecalcularPrecosTinta;
        End;

        If (Result) And
           (blnBuscaPorChave) And
           (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
           (fCfgSis('ILIEMP', varString) = 'S') And
           (fCfgSis('EXILIS', varString) = 'S') And
           (fCfgSis('IMPLST', varString) = 'N') And
           (fCfgSis('EMPFAT', varString) = 'S') And
           (fCampoTabela('ITE_IMPLIS', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [edtCodIte.Text, edtCodEmp.Text]) = 'N') Then
        Begin
          FatVenda.pMostraMensagem('', 'O item está bloqueado para venda nesta empresa.' + #10#13 +
                                       'Verifique o campo "Imprime Lista" aba "Complementos" no Cadastro de Produtos!', edtCodIte.Text);
          fatVenda.fImprimeListaItem(edtCodEmp.Text, edtCodIte.Text);
          Result := False;
        End;

        If (Result) And
           (Not fEmptyStr(edtCodEmp.Text)) And
           (edtCodEmp.Text <> VS_strCodEmp) And
           (Not fatVenda.fEstaEmAbastecimentoPorDeposito()) Then
        Begin
          If (Not fPermiteMultiLojaEmpresa(edtCodEmp.Text)) Then
          Begin
            FatVenda.pMostraMensagem('','A empresa ' + edtCodEmp.Text + ' está configurada para não permitir multi-lojas. ' +#10+#13+
                                        'Acesse o cadastro de empresas ou peça para o responsável e verifique a aba "Permissão de Tipos de Movimento de Venda".', edtCodIte.Text);
            Result := False;
          End;
        End;


        If (Result) Then
          strEmpAnt := edtCodEmp.Text;

        If Result Then
          Result := fPermiteVendaCNPJouCPF(edtCodCli.Text, edtCodEmp.Text);
      End;

      pHabilitarCheckPegou;

    End

    Else If (Sender = edtNumLot) And (Not blnConEqu) Then
    Begin

      If pnlItemLote.Visible Then
      Begin
        If (Assigned(fatVenda)) Then
          fatVenda.intIdxEntRetLot := cmbEntRet.ItemIndex;

        If (fCfgSis('CTLEST') = '2') Then
        Begin
          edtNomArm.Text := '';
          edtNumLot.Text := fStrZero(edtNumLot.Text, 3);
        End;

        {Devido a possibilidade de alterar o lote para a base da tinta imobiliária,
         é executado aqui o comando "fatVenda.objCadLot.fExisteLote" para que seja atualizado o "fatVenda.objCadLot.qryCadLot"}
        If (fInformaLoteBaseImobiliaria) Then
          fatVenda.objCadLot.fExisteLote(fCodItem,
                                         IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD),
                                         edtNumLot.Text);

        If fEmptyStr(edtNumLot.Text) Then
        Begin
          If Assigned(fatVenda.objCadLot) Then
            fatVenda.objCadLot.strLotAnt := '';

          If strOpcDoc <> 'OR' Then
          Begin
            fMensagem('ATENÇÃO!', 'Informe o número do ' + fatVenda.objCadLot.strTitLab + '!', ['&Ok']);
            Result := False;
          End;
        End

        Else If (fatVenda.strIdePro = 'NOR') And (Not fatVenda.objCadLot.fExisteLote(fCodItem,
                                                                                     IIF(fatVenda.blnEmpFat,
                                                                                           edtCodEmp.Text,
                                                                                           fatVenda.fEmpresaSaldoMatriz_CD),
                                                                                     edtNumLot.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', fatVenda.objCadLot.strTitLab + ' não encontrado!', ['&Ok']);

          If (fCfgSis('CTLEST') = '2') Then
            edtNumLot.Clear;

          Result := False;
        End

        Else If TPickingCheckOut.fWMSUtilizaPickingCheckOut And
                TPickingCheckOut.fRetornaLotePickingCheckOut(fCodItem, fRetEmpresaItem).Equals(edtNumLot.Text) And
               (Not fEhRetiraCaixa) Then
        Begin
          FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido informar um lote que está vinculado a uma localização picking check-out se o destino do produto não for retira-caixa.', edtCodIte.Text);
          Result := False;
        End

        Else If (Pos(strOpcDoc, 'TR_DV_PR_DD_') = 0) And
                (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) And
                (Not fatVenda.fEhEmissaoDocumentoWMS) And
                (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
                (RoundTo(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_SALDOS').AsFloat, -2) <= 0) And
                (SameText(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_NUMLOT').AsString,'A DEFINIR')) And
                (cmbTipEnt.ItemIndex <> IDX_ENTREGA_FUTURA) And
                ((Pos(strOpcDoc,'CS_') > 0) Or (Pos(strOpcDoc,'OR_PD_') <= 0)) Then
        Begin
          If Pos(strOpcDoc,'CS_') > 0 Then
          Begin
            fMensagem('', fatVenda.objCadLot.strTitLab + ' informado é inválido para esse tipo de documento!!', ['&Ok']);
            Result := False;
          End
          Else If Pos(strOpcDoc,'OR_PD_')<= 0 Then
          Begin
            FatVenda.pMostraMensagem('ATENÇÃO!', 'Esse ' + fatVenda.objCadLot.strTitLab + ' está sem saldo!', edtCodIte.Text);
            Result := False;
          End;
        End

        Else If (fEmptyStr(strNumRemessa)) And (Not fEmptyStr(fCampoTabela('LOT_AUTREM', 'CADLOT', ['LOT_NUMLOT', 'LOT_CODEMP', 'LOT_CODITE'], [edtNumLot.Text, VS_strCodEmp, edtCodIte.Text], False))) Then
        Begin
          FatVenda.pMostraMensagem('ATENÇÃO!', 'Não é permitido utilizar lotes gerados pela rotina de remessa de devolução no Faturamento.', edtCodIte.Text);
          Result := False;
        End

        Else If (fPermiteSomenteLotePicking) And
                (Not fEhLocalizacaoFisicaPicking(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_LOCFIS').AsString)) And
                (fatVenda.objCadLot.qryCadLot.FieldByName('LOT_NUMLOT').AsString <> 'A DEFINIR') Then
        Begin
          fMensagem('ATENÇÃO!', 'Somente pode ser utilizado lote do tipo "PICKING" ou "A DEFINIR"!', ['&Ok']);
          Result := False;
        End

        Else If (cmbTipEnt.Visible) And
                (Not fatVenda.fEhEmissaoDocumentoWMS) And
                (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
                (Pos(strOpcDoc, 'DV_PR_') <= 0) And
                (Not fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS()) And
                (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                (SameText(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_NUMLOT').AsString,'A DEFINIR')) Then
        Begin
          FatVenda.pMostraMensagem('ATENÇÃO!', 'Esse ' + fatVenda.objCadLot.strTitLab + ' somente pode ser utilizado com Entrega Futura!', edtCodIte.Text);
          Result := False;
        End

        {** CASO ESTIVER USANDO A ROTINA WMS, NÃO PERMITIR A INFORMAÇÃO DO LOTE "A DEFINIR", EXCETO PARA ENTREGA FUTURA}
        Else If (cmbTipEnt.Visible) And
                (fUsaRotinaWMS(VS_strCodEmp) Or (fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text))) And
                (Pos(strOpcDoc, 'VN_')> 0) And
                (Not fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS()) And
                (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                (SameText(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_NUMLOT').AsString,'A DEFINIR')) Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse ' + fatVenda.objCadLot.strTitLab + ' somente pode ser utilizado com Entrega Futura!', ['&Ok']);
          Result := False;
        End

        {** CASO ESTIVER USANDO A ROTINA WMS, NÃO PERMITIR INFORMAR O LOTE DIRETO, EXCETO PARA ENTREGA IMEDIATA}
        Else If (cmbTipEnt.Visible) And
                (fUsaRotinaWMS(VS_strCodEmp) Or (fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text))) And
                (Pos(strOpcDoc, 'VN_')> 0) And
                (Not fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS()) And
                (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                (Not SameText(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_NUMLOT').AsString,'A DEFINIR')) Then
        Begin
          fMensagem('ATENÇÃO!', fatVenda.objCadLot.strTitLab + ' informado para Entrega Futura deve ser sempre A DEFINIR!', ['&Ok']);
          Result := False;
        End
        Else If (fVerificaLoteTransitorio(edtCodIte.Text, edtNumLot.Text, VS_strCodEmp)) Then
        Begin
          pMensagemOK('Não é permitida a seleção de Lotes Transitórios!');
          Result := False;
        End

        Else If TCadLot.fBloqueiaTranfSaldoLote(fatVenda.objCadLot.qryCadLot.FieldByName('LOT_NUMLOT').AsString,
                                                '', edtCodIte.Text, VS_strCodEmp, True, fatVenda.objCadLot.strTitLab, True) Then
        Begin
          Result := False;
        End

        //Rotina WMS nao deve usar o saldo do Lote, mas sim do ITEGER (O lote somente sera definido na expedicao)
        Else If (((Not fatVenda.fEhEmissaoDocumentoWMS) And
                 (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text))) Or fLoteDefinidoNoPedido(fCodItem, fatVenda.fRetornarEmpresaWMSSePodeInformarLotePedido)) Or
                 (fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis And (fProdutoRastreavel(edtCodIte.Text)) And (edtNumLot.Text <> 'A DEFINIR')) Then
        Begin

          if (edtNumLot.Text = 'A DEFINIR') and fCfgSis('DLSWMS', varBoolean) and (not fUsaRotinaWMS) then
            fltSaldoItemAtu  := fRetSaldosEmpresa(fCodItem, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD), edtNumLot.Text, True)
          else
            fltSaldoItemAtu  := fatVenda.objCadLot.qryCadLot.FieldByName('LOT_SALDOS').AsFloat;

          blnVendeTudoLote := fatVenda.objCadLot.qryCadLot.FieldByName('LOT_VENTDO').AsString = 'S';

          strEmpSalRes := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

          If fUsaQtdPendenteEntregaFutura(True, strEmpSalRes) Then
            fltSaldoItemAtu := fltSaldoItemAtu + TEntregaFutura.New(
                                                   TParamEF.New()
                                                     .CodIte(fCodItem)
                                                     .CodEmp(strEmpSalRes)
                                                     .Lote(edtNumLot.Text)
                                                     .Faturamento(True)
                                                   ).Total();

          pCalculaSaldoPigmento();

          fltSaldoResItemAtu := TSaldoReservado.New(
                                  TReservaParametros.New()
                                    .EmpresaItem(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, ''))
                                    .NumeroDocumento(fatVenda.strNumOrc)
                                    .CodigoItem(fCodItem)
                                    .CodEmpresa(strEmpSalRes)
                                    .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                                    .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                                    .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                                    .NumeroLote(edtNumLot.Text)
                                    .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                                 ).fGetQuantidade();

          fltQtdeDigitada := fatVenda.fRetQtdDigitada(edtCodIte.Text,
                                                      edtNumLot.Text,
                                                      '',
                                                      '',
                                                      '',
                                                      edtCodEmp.Text);

          edtSalDis.Text := FormatFloat(edtQtdIte.EditFormat, (fltSaldoItemAtu - fltSaldoResItemAtu) - fltQtdeDigitada);
          pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
          pHintSaldoDisponivel;

          if (fUsaSugestaoLoteMenorValidade) and
             (not blnLiberadoLoteDifLoteMenorValidade) and
             ((not fEmptyStr(strLoteMenorValidade)) Or fVaiValidarLoteMenorValidadeEditandoItem()) and
             (Pos(fCfgSis('TRLTVL', varString),'A_T_N_L') > 0) then
          begin

            If fEmptyStr(strLoteMenorValidade) Then
              strLoteMenorValidadeTrava := fatVenda.objCadLot.fRetLoteMenorValidade(fCodItem, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD), nil)
            Else
              strLoteMenorValidadeTrava := strLoteMenorValidade;

            if edtNumLot.Text <> strLoteMenorValidadeTrava then
            begin
              dtaValidadeLoteSugerido := fCampoTabela('LOT_DTAVAL',
                                                      'CADLOT',
                                                      ['LOT_NUMLOT',
                                                       'LOT_CODEMP'],
                                                      [strLoteMenorValidadeTrava,
                                                       IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD)]);

              dtaValidadeLoteEscolhido := fCampoTabela('LOT_DTAVAL',
                                                       'CADLOT',
                                                       ['LOT_NUMLOT',
                                                        'LOT_CODEMP'],
                                                       [edtNumLot.Text,
                                                        IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD)]);

              fltSaldoLoteEscolhido := fStrToFloat(edtSalDis.Text);

              fltSaldoItemSugerido := fatVenda.objCadLot.fSaldoLote(fCodItem, strEmpSalRes, strLoteMenorValidadeTrava);

              If fUsaQtdPendenteEntregaFutura(True, strEmpSalRes) Then
                fltSaldoItemSugerido := fltSaldoItemSugerido + TEntregaFutura.New(
                                                               TParamEF.New()
                                                                 .CodIte(fCodItem)
                                                                 .CodEmp(strEmpSalRes)
                                                                 .Lote(strLoteMenorValidadeTrava)
                                                                 .Faturamento(True)
                                                               ).Total();

              fltSaldoResLoteSugerido := TSaldoReservado.New(
                                          TReservaParametros.New()
                                            .EmpresaItem(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, ''))
                                            .NumeroDocumento(fatVenda.strNumOrc)
                                            .CodigoItem(fCodItem)
                                            .CodEmpresa(strEmpSalRes)
                                            .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                                            .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                                            .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                                            .NumeroLote(strLoteMenorValidadeTrava)
                                            .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                                         ).fGetQuantidade();


                fltSaldoLoteSugerido := (fltSaldoItemSugerido - fltSaldoResLoteSugerido);

              if ((cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) and
                  (dtaValidadeLoteSugerido < dtaValidadeLoteEscolhido)) or
                 ((cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) and
                  ((dtaValidadeLoteSugerido <= dtaValidadeLoteEscolhido) or
                   (fltSaldoLoteEscolhido < StrToFloat(edtQtdIte.Text)))) then
              begin
                if fCfgSis('TRLTVL', varString) = 'N' then
                  blnLiberadoLoteDifLoteMenorValidade := True;

                if fCfgSis('TRLTVL', varString) = 'T' then
                begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Existem lotes com data de validade mais próxima à data atual'+
                                              IIF(cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA,
                                                  ' que possuem saldos suficientes para atender a quantidade informada! ',
                                                  '! ')+
                                              'Verifique a coluna "validade" na consulta de lotes.', edtCodIte.Text);

                  edtNumLot.Text := strLoteMenorValidadeTrava;
                  Exit(False);
                end;

                if fCfgSis('TRLTVL', varString) = 'A' then
                begin
                  FatVenda.pMostraMensagem('ATENÇÃO!', 'Existem lotes com data de validade mais próxima à data atual'+
                                              IIF(cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA,
                                                  ' que possuem saldos suficientes para atender a quantidade informada! ',
                                                  '! ')+
                                              'Verifique a coluna "validade" na consulta de lotes.', edtCodIte.Text);

                  blnLiberadoLoteDifLoteMenorValidade := True;
                end;

                if fCfgSis('TRLTVL', varString) = 'L' then
                begin
                  objLiberacao.Clear;
                  objLiberacao.strDirAce := 'ALTLTV';
                  objLiberacao.strCodOpe := strLoginUsuarioLogado;
                  objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

                  objLiberacao.objMsgLibera
                  .pAddTexto('Atenção! Existem lotes com data de validade mais próxima à data atual'+
                             IIF(cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA, '', '!'));

                  if cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA then
                    objLiberacao.objMsgLibera
                    .pAddTexto(' que possuem saldos suficientes para atender a quantidade informada!');

                  objLiberacao.objMsgLibera
                  .pAddTexto('');

                  objLiberacao.objMsgLibera
                  .pAddTexto('Produto: '+fCodItem+' - '+edtDesIte.Text);

                  if cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA then
                    objLiberacao.objMsgLibera
                    .pAddTexto('Qtde informada: '+edtQtdIte.Text);

                  objLiberacao.objMsgLibera
                  .pAddTexto('Lote Sugerido: '+strLoteMenorValidadeTrava+' - '+
                             'Validade: '+DateToStr(dtaValidadeLoteSugerido)+' '+
                             IIF(cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA,
                                 'Saldo: '+FloatToStr(fltSaldoLoteSugerido),
                                 ''));

                  objLiberacao.objMsgLibera
                  .pAddTexto('Lote escolhido: '+edtNumLot.Text+' - '+
                             'Validade: '+DateToStr(dtaValidadeLoteEscolhido)+' '+
                             IIF(cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA,
                                 'Saldo: '+FloatToStr(fltSaldoLoteEscolhido) +
                                         IIF(fltSaldoLoteEscolhido < strToFloat(edtQtdIte.Text), ' **INSUFICIENTE**', ''),
                                 ''));

                  Result := objLiberacao.fLibera;
                  if not Result then
                  begin
                    edtNumLot.Text := strLoteMenorValidadeTrava;
                    blnLiberadoLoteDifLoteMenorValidade := False;
                    Exit;
                  end
                  else
                    blnLiberadoLoteDifLoteMenorValidade := True;
                end;

              end;
            end;

          end;

          If blnBuscaPorChave And
             ((Not SameText(fatVenda.objCadLot.strLotAnt, edtNumLot.text)) Or
              (fStrToFloat(edtUnitar.Text) = 0) Or
              (fltQtdDigAnt <> fStrToFloat(edtQtdIte.Text)) Or
              ((intEntRetAnt >= 0) And (intEntRetAnt <> cmbEntRet.ItemIndex))) Then
          Begin

            If (Pos(strOpcDoc, 'DV_PR_') <= 0) And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
            Begin
              If fatVenda.fCalculaPrecosLote(fStrToFloat(edtQtdIte.Text), fltUniLot, IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,'')) Then
              Begin
                If fAplicarDescontoRessarcimentoCAT Then
                  fltUniLot := fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fltUniLot);

                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniLot);
              End  
              Else
              Begin
                If (fCfgSis('CTLEST') = '2') Then
                Begin
                  If ((Not SameText(fatVenda.objCadLot.strLotAnt, edtNumLot.text)) Or
                      (fStrToFloat(edtUnitar.Text) = 0) Or 
                      (fTemQuantEmbalagemFechada(edtCodIte.Text)) Or
                      (fatVenda.fItemPassivelDeVerificacaoPromo(edtCodIte.Text, fRetEmpresaItem))) Then
                  Begin   
                    pAtualizaUnitarioSugestao(Not fMantemPrecoUnitario);
                  End;
                End
                Else
                Begin  
                  If (btnAdicionar.Tag = 0) Or
                     (fStrToFloat(edtUnitar.Text) = 0) Or
                     blnEstaAlterandoQuantidade Then
                    pAtualizaUnitarioSugestao(Not fMantemPrecoUnitario);
                End;
                  
                If (fatVenda.strIdePro = 'NOR') Then
                  fltQtdDigAnt := fStrToFloat(edtQtdIte.Text);
              End;  
            End;

            If fatVenda.fltCusLot > 0 then
            Begin
              parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);

              fatVenda.fltPreCus := fatVenda.fltCusLot;

              strCodSit := '';
              If Not fEmptyStr(fatVenda.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString)) Then
                strCodSit := qryConAbf.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString)).AsString;

              fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                            qryConIte.FieldByName('ITE_CODEMP').AsString,
                                            fTabelaPrecoItem);

              fatVenda.fltPreCu2 := parPreCus.fCalculaPrecoCustoRealVenda(fStrToFloat(edtUnitar.Text),
                                                                          fatVenda.fltCusLot,
                                                                          0,
                                                                          fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat),
                                                                          fatVenda.fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat),
                                                                          fatVenda.fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat) + fatVenda.fltDesOpeCli,
                                                                          fatVenda.fGetAlqDifal(qryConIte.FieldByName('ITE_CODITE').AsString, fRetEmpresaItem,
                                                                                                qryConAbf.FieldByName('ABF_CODABF').AsString,
                                                                                                strCodSit),
                                                                          fatVenda.fGetAlqFcpIcms(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                                                                  qryConAbf.FieldByName('ABF_CODABF').AsString,
                                                                                                  strCodSit,
                                                                                                  IIF(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConCit.FieldByName('ITE_CODITE').AsString,
                                                                                                                                                         qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte),
                                                                                                                                                         fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)),
                                                                                                  fStrToFloat(edtUnitar.Text)));

              FreeAndNil(parPreCus);
            End;

            fatVenda.objCadLot.strLotAnt := edtNumLot.text;
            intEntRetAnt := cmbEntRet.ItemIndex;
          End;

        End

        Else If (Pos(strOpcDoc, 'DV_PR_') <= 0) And
                (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) And
                (fltQtdDigAnt <> fStrToFloat(edtQtdIte.Text)) Then
        Begin
          pAtualizaUnitarioSugestao;
          if (fatVenda.strIdePro = 'NOR') Then
            fltQtdDigAnt := fStrToFloat(edtQtdIte.Text);
        End;

        If fTravaLoteADefinir(strOpcDoc, edtCodIte.Text, edtNumLot.Text) Then
        Begin
          edtNumLot.Clear;
          Result := False;
        End;

        If (Result) Then
        Begin
          If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
          Begin
            If (Not fLoteAprovadoLibCompra(fCodItem, edtNumLot.Text, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD))) Then
            Begin
              If (Not ((edtNumLot.Text = 'A DEFINIR')  And
                       (fatVenda.fEhEmissaoDocumentoWMS Or
                        fatVenda.fEmpresaParaFaturamentoUsaWMS(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD))))) Then
              Begin
                Result := False;
                fMensagem('', fatVenda.objCadLot.strDescri+ ' não liberado para venda!', ['&OK']);
              End;
            End;

            If (Result) And (Not fEmptyStr(edtNumLot.Text)) Then
            Begin
              edtLocFis.Text := fatVenda.objCadLot.fLocalizacaoFisicaLote(fCodItem, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD), edtNumLot.Text);

              If (Not fEmptyStr(edtLocFis.Text)) And
                  TCadLot.fBloqueiaTranfSaldoLote(edtNumLot.Text, edtLocFis.Text, edtCodIte.Text, VS_strCodEmp, True, fatVenda.objCadLot.strDescri, True) Then
              Begin
                Result := False;
              End;
            End;

          End;

          pAjustaLegendaLote;
        End;

        If (Result) And (Pos(strOpcDoc, 'DV_PR_') > 0) Then
        Begin
          If (edtNumLot.Text = 'A DEFINIR') And (Not fCfgSis('DEVEND', VarBoolean)) And (Not fCfgSis('UTIWMS', VarBoolean)) Then
          Begin
            fMensagem('Atenção!', 'Não é possível informar ' + fatVenda.objCadLot.strDescri + ' ' +
                                  '"A DEFINIR" na rotina de devolução. Escolha um lote válido para ' +
                                  'continuar ou ative a configuração para ' +
                                  'gerar pedido de endereçamento (CFG_DEVEND) não liberado para venda!', ['&OK']);
            Result := False;
          End;
        End;

        If fCfgSis('MARMOR', varBoolean) Then
        Begin
          If Result Then
            fAlimentaQtdLoteChapa
          Else
            strNumLotAntAlterar := '';
        End;

        If fVerificaUtilizaDefinicaoLoteSeparacaoSemWMS() And
          (Not fEmptyStr(edtNumLot.Text))And
          (Not SameText(strNumLotAntAlterar, edtNumLot.text)) And
          (edtNumLot.Text <> 'A DEFINIR') Then
        Begin
          If fMensagem('', 'Produtos com lote devem ser definidos na separação, deseja realmente alterar o lote no pedido/orçamento?', ['&Sim', '&Não']) = 2 Then
          Begin
            edtNumLot.Text := 'A DEFINIR';
          End
          Else
          Begin
            If Not fLiberouTravaParaLoteQuandoUtilizaDefinicaoLoteSeparacaoSemWMS Then
              edtNumLot.Text := 'A DEFINIR';
          End;

          strNumLotAntAlterar := edtNumLot.Text;
        End;

        pAtualizaUnitarioLiquido;

      End
      Else if fatVenda.fDefinirLoteDevolucaoNaBaixa then
      Begin
        edtNomArm.Clear;
        edtNumLot.Clear;
      End;
    End

    Else If (Sender = cmbEntRet) Then
    Begin

      If (cmbEntRet.Visible) And (cmbEntRet.Enabled) Then
      Begin

        If TPickingCheckOut.fWMSUtilizaPickingCheckOut Then
          Result := fDefinirLotePickingCheckOut(fCodItem, IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text));

        If (Result) And (cmbEntRet.ItemIndex = IDX_VAZIO) And (Not fEmptyStr(edtCodIte.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'O Campo Destino deve ser informado!', ['&O k']);
          Result := False;
        End
        Else If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (Not fEmptyStr(edtCodIte.Text)) And (Not ((cmbTipEnt.Enabled) And (cmbTipEnt.Visible))) Then
        Begin
          Result := fPermiteItemEntregaParaConsumidor(Result);
        End
        Else If (Not fCfgSis('PREFUT', varBoolean)) And
                (chkVenPre.Visible And chkVenPre.Checked) And
                (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And
                (Not fEmptyStr(edtCodIte.Text)) Then
        Begin
          fMensagem('','Não é permitido utilizar entrega futura quando a venda é presencial!', ['&OK']);
          Result := False;
        End;

        If fUsaTabelaPrecoItemPorRetiraEntrega And
           fTabelaPrecoRetiraEntregaAlterada And
           (fAlterandoProduto) And
           ((strTabPreIteAnt <> cbTabPrecoItem.Text) Or
            (dicInfIte['cmbEntRet']<>cmbEntRet.ItemIndex)) Then
            pAtualizaTabPreRetiraEntrega;
      End;

      pHabilitarCheckPegou;
    End

    Else If (Sender = edtAparel) And blnUtilizaVendaMadeira Then
    Begin
      If Pos(edtAparel.Text,'SN') <= 0 Then
      Begin
        fMensagem('ATENÇÃO!', 'O Campo aparelhada deve ser "S" ou "N"!', ['&Ok']);
        Result := False;
      End
    End

    Else If (Sender = edtPerApa) And (edtPerApa.Enabled) And blnUtilizaVendaMadeira Then
    Begin
      If Not fValidaEscala(edtPerApa.Text, 0, 100) Then
      Begin
        fMensagem('','O percentual de acréscimo para aparelhado deve estar entre 0 e 100!', ['&Ok']);
        Result := False;
      End
      Else If fEmptyStr(edtPerApa.Text) Then
        edtPerApa.Text := '0,00';
    End

    Else If (Sender = edtBenefi) And blnUtilizaVendaMadeira  Then
    Begin
      If Pos(edtBenefi.Text,'SN') <= 0 Then
      Begin
        fMensagem('ATENÇÃO!', 'O Campo aparelhada deve ser "S" ou "N"!', ['&Ok']);
        Result := False;
      End;
    End

    Else If (Sender = edtPerBen) And (edtPerBen.Enabled) And blnUtilizaVendaMadeira Then
    Begin
      If Not fValidaEscala(edtPerBen.Text, 0, 100) Then
      Begin
        fMensagem('','O percentual de acréscimo para beneficiamento deve estar entre 0 e 100!', ['&Ok']);
        Result := False;
      End
      Else If fEmptyStr(edtPerBen.Text) Then
        edtPerBen.Text := '0,00';
    End

    Else If (Sender = edtQtdPec)    And
            (edtQtdPec.Enabled)     And
            (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) And
            (blnBuscaPorChave)      Then
    Begin
      If (fStrToFloat(edtQtdPec.Text) <= 0) And (Not ((blnUtilizaVendaMetroLinear) And (fatVenda.blnCarregandoEstrutura)))Then
      Begin
        If (fControlaDigMetrosCubicos(True)) Then
        Begin
          pSetFocus(edtQtdIte);
          blnMudarFoco := False;
        End
        Else
          Result := False;
      End
      Else
        pCalculaQtdMetrosCubicosAtualizandoUnitarioSugestao();
    End

    Else If (Sender = edtComPec)    And
            (edtComPec.Enabled)     And
            (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) And
            (blnBuscaPorChave)      Then
    Begin
      If fStrToFloat(edtComPec.Text) < 0 Then
      Begin
        If blnUtilizaVendaMetroLinear Then
          fMensagem('ATENÇÃO!', 'A metragem deve ser maior ou igual à Zero!', ['&O k'])
        Else If blnUtilizaVendaVidro Then
          fMensagem('ATENÇÃO!', fRetornaInfMedVIDRO(False,False,False,True) + ' deve ser maior ou igual à Zero!', ['&O k'])
        Else
          fMensagem('ATENÇÃO!', 'O comprimento deve ser maior ou igual à Zero!', ['&O k']);
        Result := False;
      End
      Else
      Begin
        blnUtilizaVendaVidroAux :=  (blnUtilizaVendaVidro) And (qryConCit.Active) And (fStrToFloat(edtComPec.Text) > 0);

        If (blnUtilizaVendaVidroAux) And
           (qryConCit.FieldByName('ITE_ALMAVI').AsFloat > 0) And
           (qryConCit.FieldByName('ITE_ALMAVI').AsFloat < fStrToFloat(edtComPec.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', fRetornaInfMedVIDRO(False,False,False,True)+' deve ser inferior à '+LowerCase(fRetornaInfMedVIDRO(False,False,True,True)) +' do produto (' +
                                FormatFloat(edtComPec.EditFormat, qryConCit.FieldByName('ITE_ALMAVI').AsFloat) + ' ' + lblMedCom.Caption + ')', ['&O k']);
          Result := False;
        End
        Else If (blnUtilizaVendaVidroAux) And
                (qryConCit.FieldByName('ITE_ALTMIN').AsFloat > 0) And
                (qryConCit.FieldByName('ITE_ALTMIN').AsFloat > fStrToFloat(edtComPec.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', fRetornaInfMedVIDRO(False,False,False,True)+' deve ser superior à '+LowerCase(fRetornaInfMedVIDRO(False,False,False,False,False,True)) +' do produto (' +
                                FormatFloat(edtComPec.EditFormat, qryConCit.FieldByName('ITE_ALTMIN').AsFloat) + ' ' + lblMedCom.Caption + ')', ['&O k']);
          Result := False;
        End
        Else
        Begin
          pCalculaQtdMetrosCubicosAtualizandoUnitarioSugestao();

          If (Not blnUtilizaVendaMadeira) And (blnUtilizaVendaVidro) And (blnRecalcValUniEntFut) Then
            pCalculaUnitarioMetrosCubicos;
        End;
      End;
    End

    Else If (Sender = edtLarPec)    And
            (edtLarPec.Enabled)     And
            (edtLarPec.Visible)     And
            (blnUtilizaVendaMadeira Or
             blnUtilizaVendaVidro)  And
            (blnBuscaPorChave)      Then
    Begin
      If fStrToFloat(edtLarPec.Text) <= 0 Then
      Begin
        fMensagem('ATENÇÃO!', 'A Largura deve ser maior que Zero!', ['&O k']);
        Result := False;
      End
      Else
      Begin
        blnLargPermitidas := fatVenda.fVerificarLarguraItem(edtCodIte.Text,
                                                            Trunc(RoundTo(fStrToFloat(edtLarPec.Text), -2)),
                                                            strLargPermitidas,
                                                            fltQtdPermit,
                                                            fltQtdLargAcima,
                                                            intLamAvi);

        blnUtilizaVendaVidroAux :=  (blnUtilizaVendaVidro) And (qryConCit.Active) And (fStrToFloat(edtLarPec.Text) > 0);

        If (blnUtilizaVendaVidroAux) And
           (qryConCit.FieldByName('ITE_LAMAVI').AsFloat > 0) And
           (qryConCit.FieldByName('ITE_LAMAVI').AsFloat < fStrToFloat(edtLarPec.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'A largura deve ser inferior à largura máxima do produto (' +
                                FormatFloat(edtLarPec.EditFormat, qryConCit.FieldByName('ITE_LAMAVI').AsFloat) + ' ' + lblMedLar.Caption + ')', ['&O k']);
          Result := False;
        End
        Else If (blnUtilizaVendaVidroAux) And
                (qryConCit.FieldByName('ITE_LARMIN').AsFloat > 0) And
                (qryConCit.FieldByName('ITE_LARMIN').AsFloat > fStrToFloat(edtLarPec.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'A largura deve ser superior à largura mínima do produto (' +
                                FormatFloat(edtLarPec.EditFormat, qryConCit.FieldByName('ITE_LARMIN').AsFloat) + ' ' + lblMedLar.Caption + ')', ['&O k']);
          Result := False;
        End
        Else If (blnUtilizaVendaVidro) And (Not blnLargPermitidas) Then
        Begin
          pMensagemOk('As larguras permitidas para este item são: ' + strLargPermitidas + '!');

          If (fStrToFloat(edtLarPec.Text) < fltQtdLargAcima) Then
            pMensagemOk('A largura sugerida para esta venda é: ' + FloatToStr(fltQtdLargAcima) + '.');

          Result := False;
        End        
        Else
        Begin
          If (blnUtilizaVendaVidro) And (blnLargPermitidas) And ( (intLamAvi <> fStrToFloat(edtLarPec.Text)) and (fltQtdPermit <> fStrToFloat(edtQtdPec.Text)) ) Then
          begin

            fltQtdReajustada := 0;

            if Frac(fStrToFloat(edtQtdPec.Text) / fltQtdPermit) > 0 then
            begin
              if (fCfgSis('QTDMTP', varBoolean)) then
              begin
                blnPedeSenhaQtdeMultiploVenda := fPedeSenhaQtdeMultiploVenda;
              end
              else
              begin
                blnPedeSenhaQtdeMultiploVenda := False;
              end;
              if (not blnPedeSenhaQtdeMultiploVenda) then
              begin
                fltQtdReajustada := (Floor(fStrToFloat(edtQtdPec.Text) / fltQtdPermit) * fltQtdPermit) + fltQtdPermit;
                pMensagemOk('A quantidade de peças para este item deve ser múltiplo de ' + FloatToStr(fltQtdPermit) + '. O sistema reajustará a quantidade.');
              end;
            end
            else
              fltQtdReajustada := (Floor(fStrToFloat(edtQtdPec.Text) / fltQtdPermit) * fltQtdPermit);

            if (Not blnPedeSenhaQtdeMultiploVenda) and  (fltQtdReajustada <> 0) then
              edtQtdPec.Text := FloatToStrF(fltQtdReajustada, ffFixed, 12, 5)
          end;

          pCalculaQtdMetrosCubicosAtualizandoUnitarioSugestao();

          If (Not blnUtilizaVendaMadeira) And (blnUtilizaVendaVidro) And (blnRecalcValUniEntFut) Then
            pCalculaUnitarioMetrosCubicos;
        End;
      End;
    End

    Else If (Sender = edtUntPec)    And
            (edtUntPec.Visible)     And
            (blnUtilizaVendaMadeira Or
             blnUtilizaVendaVidro)  And
            (blnBuscaPorChave)      Then
    Begin
      If (fEmptyStr(edtUntPec.Text)) Then
        edtUntPec.Text := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);

      if not edtUntPec.ReadOnly then
      begin
        // Verifica se o usuário digitou um valor unitário para a peça
        fltValUntPec := fStrToFloat(edtUntPec.Text);

        if fltValUntPec > 0 then
        begin
          fltQtdIte := fStrToFloat(edtQtdIte.Text);
          fltQtdPec := fStrToFloat(edtQtdPec.Text);
          edtUnitar.Text := FloatToStrF((fltValUntPec / fltQtdIte) * fltQtdPec, ffFixed, 12, fatVenda.VS_intDecUni);
        end;
      end;
    End

    Else If (Sender = edtEspPec)     And
            (edtEspPec.Enabled)      And
            (blnUtilizaVendaMadeira) And
            (blnBuscaPorChave)       Then
    Begin
      If fStrToFloat(edtEspPec.Text) <= 0 Then
      Begin
        fMensagem('ATENÇÃO!', 'A Espessura deve ser maior que Zero!', ['&O k']);
        Result := False;
      End
      Else
        pCalculaQtdMetrosCubicosAtualizandoUnitarioSugestao();
    End

    Else If (Sender = edtQtdIte) Then
    Begin

      If (blnBuscaPorChave) Then
      Begin

        If (edtQtdIte.ReadOnly) And (fStrToFloat(edtQtdPec.Text) <= 0) Then
        Begin
          Result := False;
        End

        Else If fEmptyStr(edtQtdIte.Text) Then
        Begin
          fMensagem('ATENÇÃO!', 'A Quantidade deve ser preenchida!', ['&O k']);
          Result := False;
        End

        Else If ((fCfgSis('CAMXUT',varString) = 'A') Or (fCfgSis('CAMXUT',varString) = 'T')) And
                Not(fUsaRotinaWMS) And blnValidaAcimaDaCapacidadeMax Then
        Begin
          cdsData:= Nil;
          If ((fatVenda.fDocumentoParaFornecedor) And (Not SameText(strOpcDoc,'OF'))) Or (strOpcDoc = 'TE') And (pnlItemLote.Visible) Then
          Begin

            cdsData     := fCriaDataCapaMaxima(cdsData);
            cdsData     := fInsereItemCapacidadeMaxima(edtCodIte.Text, edtNumLot.Text, fStrToFloat(edtQtdIte.Text), cdsData);

            If Not(fValidaCapacidadeMaximaLote(edtNumLot.Text, cdsData)) Then
            Begin
              Result := False;
              pSetFocus(edtQtdIte);
              Exit;
            End

          End
        End

        Else If (fStrToFloat(edtQtdIte.Text) <= 0) And (Not fEmptyStr(edtCodIte.Text)) Then
        Begin

          If (blnMetragemObrigatoria) Then
          Begin
            If (fControlaDigMetrosCubicos(False)) Then
            Begin
              pSetFocus(edtQtdPec);
              blnMudarFoco := False;
            End;
          End
          Else
          Begin
            fMensagem('ATENÇÃO!', 'A Quantidade deve ser maior que Zero!', ['&O k']);
            Result := False;
          End;

        End

        Else If ((Pos(strOpcDoc, 'DV_PR_OF_DD_') > 0) Or (fatVenda.blnComVal))  And (fltQtdDev > 0.0) Then
        Begin

          If (fStrToFloat(edtQtdIte.Text) > fltQtdDev) Then
          Begin
            fMensagem('ATENÇÃO!', 'A Quantidade deve ser menor ou igual a ' + FloatToStr(fltQtdDev) + '!', ['&O k']);
            Result := False;
          End;

        End;

        if (Pos(strOpcDoc, 'PD_OR_') > 0) and (fUtilizaEmpresaPrioridadeEstoque) and (btnAdicionar.Tag = 0) and (chkEmpresaPrioridade.Checked) then
        begin
          Result := Result And fValidaEstoqueEmpresaPrioridade(True, fltEstoqueTotalEmpresasPrioridade);
        end
        else
        begin
          Result := Result And fValidaSaldoLote;
        end;

        {**************************************************************}
        {* SE O PEDIDO ESTIVER INSERIDO EM UM PRÉ-ROMANEIO, A QTDE    *}
        {* DO ITEM NO PEDIDO NÃO PODE SER INFERIOR À QTDE DO ROMANEIO *}
        {***********************************************************MM*}
        If (strOpcDoc = 'PD') And
           (strEspOrc = 'PD') And
           (fAlterandoProduto) And //Alterando um produto
           (fCfgSis('USPRRO', varString) = 'S') Then //Usa pre romaneio
        Begin
          Result := fVerificaQtdeRomaneio(strNumOrc,
                                          strEspOrc,
                                          IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                          edtCodIte.Text,
                                          cdsVenda.FieldByName('ITE_SEQDET').AsString);
        End;

      End
      Else
      Begin

        If (Not fEmptyStr(edtQtdIte.Text)) And (fAlterandoProduto) And (strOpcDoc = 'MF') Then
        Begin

          If cdsVenda.FieldByName('ITE_QTDITE').AsFloat < fStrToFloat(edtQtdIte.Text) Then
          Begin
            fMensagem('','A quantidade deve ser menor que o original!',['&OK']);
            Result := False;
          End;

        End;

      End;

      If (Result) And
         (fCfgSis('VAQTTR', varBoolean)) And
         ((Pos(strOpcDoc, 'TE_') > 0)  Or ((Pos(strOpcDoc,'OR_PD_') > 0) And (fatVenda.strEmp_TE <> ''))) And
         (fClienteFilial(edtCodCli.Text)) And
         (fStrToFloat(edtQtdIte.Text) > 0) And
         ((fAlterandoProduto) Or (blnBuscaPorChave)) Then
      Begin

        Result := fValidaQuantTransfEmpresaDestino(edtCodIte.Text,
                                                   IIF(fatVenda.strEmp_TE <> '',
                                                       fatVenda.strEmp_TE,
                                                       VS_strCodEmp),
                                                   fCampoTabela('EMP_CODEMP', 'CADEMP', ['EMP_CLIFIL'], [edtCodCli.Text], False),
                                                   fStrToFloat(edtQtdIte.Text));
      End;

      If fAtualizaPrecoEmNegociacao Then
        pAtualizaUnitarioSugestao(Not blnImportandoItensDeOutroDocumento);

      If (Result) And
         ((Frac(fStrToFloat(edtQtdIte.Text)) <> 0) And Assigned(edtQtdIte.OnKeyPress)) And
         (Not blnUtilizaVendaVidro) And
         (Not blnUtilizaVendaMadeira) Then
      Begin
        {**********************************************************************}
        { CHECAGEM ADICIONAL, CASO O USUÁRIO TENTE DIGITAR UM VALOR FRACIONADO }
        { SEM APAGAR A VÍRGULA DA MÁSCARA                                      }
        {*******************************************************************VA*}
        fMensagem('ATENÇÃO!', 'Não é permitido informar valor fracionado para esse item!', ['&O k']);
        Result := False;
      End;

      If fEstaNaConsultaTab And blnBuscaPorChave and (fatVenda.strIdePro = 'NOR') Then
        pExecutarAtualizarImpostosNaConsultaTab;
    End
    Else If (Sender = cmbLocRet) And (pnlLocRet.Visible) And (pnlEntrega.Visible) Then
    Begin

      If TPickingCheckOut.fWMSUtilizaPickingCheckOut Then
        Result := fDefinirLotePickingCheckOut(fCodItem, IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text));

      If (Result) And (cmbLocRet.Visible) And (cmbLocRet.Enabled) Then
      Begin
        If (cmbLocRet.ItemIndex = IDX_VAZIO) And (Not fEmptyStr(edtCodIte.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'O Campo Local Retira deve ser informado!', ['&O k']);
          Result := False;
        End;
      End;
    End
    Else If (Sender = cmbTipEnt) And (cmbTipEnt.Enabled) And (cmbTipEnt.Visible) Then
    Begin

      If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
         (fatVenda.fClienteFilialVenda(edtCodCli.Text)) And (Not fEmptyStr(edtCodIte.Text)) Then
      Begin
        fMensagem('','Não é permitido Entrega Futura para Cliente Filial!', ['&OK']);
        Result := False;
      End

      Else If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
              (fCfgSis('EMPFAT', varBoolean)) And edtCodEmp.Visible And
              (edtCodEmp.Text <> VS_strCodEmp) And fEhEmpresaCD(edtCodEmp.Text) And
              (Not fCfgSis('PEF_CD', varBoolean)) Then
      Begin
        fMensagem('','Não é permitido Entrega Futura para a empresa "' + edtCodEmp.Text + '"!', ['&OK']);
        Result := False;
      End

      Else If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
              (chkEntCD.Checked) And (Not fEmptyStr(edtCodIte.Text)) And
              (Not fCfgSis('PEF_CD', varBoolean)) Then
      Begin
        fMensagem('','Não é permitido Entrega Futura com Entrega pelo CD!', ['&OK']);
        Result := False;
      End

      Else If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
              (edtEntrega.Text = 'S') Then
      Begin
        pMensagemOk('Não é possível utilizar Entrega = "S" quando há itens com entrega futura!');
        Result := False;
      End

      Else If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
              (fEhItemVendaVidro(fCodItem)) Then
      Begin
        fMensagem('','Não é permitido Entrega Futura para item de venda de vidro!', ['&OK']);
        Result := False;
      End

      Else If (Not fCfgSis('PREFUT', varBoolean)) And
              (chkVenPre.Visible And chkVenPre.Checked) And
              (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And
              (Not fEmptyStr(edtCodIte.Text)) Then
      Begin
        fMensagem('','Não é permitido utilizar entrega futura quando a venda é presencial!', ['&OK']);
        Result := False;
      End;

      fatVenda.fltFat_TE := fatVenda.recDadCli.fltFat_TE;
      fatVenda.fltFatTE2 := fatVenda.recDadCli.fltFatTE2;
      fatVenda.strTEPREV := fatVenda.recDadCli.strTEPREV;
      fatVenda.strTEPPRO := fatVenda.recDadCli.strTEPPRO;

      Result := fPermiteItemEntregaParaConsumidor(Result);

      //If (blnBuscaPorChave) Then
      //  pCalculaPromocaoEntFut;
    End
    Else If (Sender = cmbMotEntFut) And (blnBuscaPorChave) And (cmbMotEntFut.Enabled) And (Pos(strOpcDoc,'VN_PD_OR_CS_') > 0) And (Not blnInserindoCombo)  Then
    Begin

      If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
      Begin

        If cmbMotEntFut.ItemIndex < 0 Then
        Begin
          fMensagem('','O motivo da entrega futura deve ser selecionado!', ['&OK']);
          Result := False;
        End
        Else
        Begin
          If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_FALTA_PRODUTO)   And
             (qryConCli.FieldByName('CLI_PERFAL').AsString <> 'S') Then
          Begin
            fMensagem('ATENÇÃO','Este Cliente não tem permissão para Entrega Futura com ' + #13#10 +
                                'Status "Falta Produto"!',['&O k']);
            Result := False;
          End
          Else If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_AGUARDANDO_CLIENTE) And
                  (qryConCli.FieldByName('CLI_PERAGU').AsString <> 'S')    Then
          Begin
            fMensagem('ATENÇÃO','Este Cliente não tem permissão para Entrega Futura com ' + #13#10 +
                                'Status "Aguardando Cliente"!',['&O k']);
            Result := False;
          End
          Else If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_PREVISAO_ENTREGA) And
                  (qryConCli.FieldByName('CLI_PERPRE').AsString <> 'S')  Then
          Begin
            fMensagem('ATENÇÃO','Este Cliente não tem permissão para Entrega Futura com ' + #13#10 +
                                'Status "Previsão de Entrega"!',['&O k']);
            Result := False;
          End

          Else If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_FALTA_PRODUTO)   And
                  (qryConCit.FieldByName('ITE_PEFFPR').AsString <> 'S') Then
          Begin
            If fCfgSis('LIBEFU', varInteger) = 2 Then
            Begin
              If Not blnJaAvisouEntFut Then
              Begin
                fMensagem('AVISO','Este Item não tem permissão para Entrega Futura com Status "Falta Produto".' + #13#10 +
                                  'Ao fechar a venda, será solicitado senha de liberação.', ['&O k']);
                blnJaAvisouEntFut := True;
                Result := True;
              End;
            End
            Else
            Begin
              fMensagem('ATENÇÃO','Este Item não tem permissão para Entrega Futura com ' + #13#10 +
                                  'Status "Falta Produto"!',['&O k']);
              Result := False;
            End;
          End
          Else If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_AGUARDANDO_CLIENTE) And
                  (qryConCit.FieldByName('ITE_PEEFUT').AsString <> 'S')    Then
          Begin
            If fCfgSis('LIBEFU', varInteger) = 2 Then
            Begin
              If Not blnJaAvisouEntFut Then
              Begin
                fMensagem('AVISO','Este Item não tem permissão para Entrega Futura com Status "Aguardando Cliente".' + #13#10 +
                                  'Ao fechar a venda, será solicitado senha de liberação.', ['&O k']);
                blnJaAvisouEntFut := True;
                Result := True;
              End;
            End
            Else
            Begin
              fMensagem('ATENÇÃO','Este Item não tem permissão para Entrega Futura com ' + #13#10 +
                                  'Status "Aguardando Cliente"!',['&O k']);
              Result := False;
            End;
          End
          Else If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_PREVISAO_ENTREGA) And
                  (qryConCit.FieldByName('ITE_PEFUTP').AsString <> 'S')  Then
          Begin
            If fCfgSis('LIBEFU', varInteger) = 2 Then
            Begin
              If Not blnJaAvisouEntFut Then
              Begin
                fMensagem('AVISO','Este Item não tem permissão para Entrega Futura com Status "Previsão de Entrega".' + #13#10 +
                                  'Ao fechar a venda, será solicitado senha de liberação.', ['&O k']);
                blnJaAvisouEntFut := True;
                Result := True;
              End;
            End
            Else
            Begin
              fMensagem('ATENÇÃO','Este Item não tem permissão para Entrega Futura com ' + #13#10 +
                                  'Status "Previsão de Entrega"!',['&O k']);
              Result := False;
            End;
          End;

        End;

        If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_FALTA_PRODUTO) And (Not fCfgSis('PEFUTF', VarBoolean)) Then
        Begin
          If (fatVenda.strIdePro = 'NOR') And
             (fStrToFloat(edtQtdIte.Text) > 0) And
             (fatVenda.fRetornaSaldoDisponivelItemNormal(edtCodEmp.Text,
                                                         qryConIte.FieldByName('ITE_CODITE').AsString,
                                                         edtNumLot.Text,
                                                         IIF(fAlterandoProduto, intToStr(btnAdicionar.Tag), ''),
                                                         strCodAca,
                                                         strEmpAca,
                                                         fltSaldoItemAtu,
                                                         True,
                                                         True,
                                                         IIF(fatVenda.blnEmpFat, edtCodEmp.Text, '')) >= fStrToFloat(edtQtdIte.Text)) Then
          Begin
            fMensagem('ATENÇÃO','Não é permitido Entrega Futura com ' + #13#10 +
                                'Status "Falta de Produto" quando o ' +
                                'produto possuir estoque disponível!',['&O k']);
            Result := False;
          End;
        End;

        If (cmbMotEntFut.ItemIndex = IDX_MOTIVO_FALTA_PRODUTO) And
           (Not fItemAtivoParaCompras(qryConIte.FieldByName('ITE_CODITE').AsString)) Then
        Begin
          fMensagem('ATENÇÃO','Não é permitido Entrega Futura com ' +
                              'Status "Falta de Produto" quando o ' +
                              'produto não estiver ativo para compras!',['&O k']);
          Result := False;
        End;

      End;

    End

    Else If (Sender = edtDiaEnt) And
            (edtDiaEnt.Enabled)  And
            (edtDiaEnt.Visible)  And
            (Not fEmptyStr(fCodItem)) And
            (Pos(strOpcDoc,'VN_PD_OR_') > 0) Then
    Begin
      If fEmptyStr(edtDiaEnt.Text) Then
        edtDiaEnt.Text := '0';

      If StrToInt(edtDiaEnt.Text) < 0 Then
      Begin
        fMensagem('','O dia de entrega deve ser igual ou maior que zero!', ['&OK']);
        Result := False;
      End;
    End


    Else If (Sender = edtUniLiq) And
            (edtUniLiq.Visible) And (Not edtUniLiq.ReadOnly) And
            (Not fEmptyStr(fCodItem)) And
            (((Pos(strOpcDoc, 'VN_PD_OR_') > 0) And fCfgSis('ALTVLQ', varBoolean)) Or fUtilizaUnitarioLiquido) Then
    Begin
      If (fEmptyStr(edtUniLiq.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'O valor unitário líquido deve ser preenchido!', ['&OK']);
        Result := False;
      End
      Else If (fStrToFloat(edtUniLiq.Text) <= 0.0) Then
      Begin
        fMensagem('ATENÇÃO!', 'O valor unitário líquido deve ser maior que zero!', ['&OK']);
        Result := False;
      End
      Else If blnBuscaPorChave Then
      Begin
        If fUtilizaUnitarioLiquido Then
        Begin
          pRecalculaAtualizaDescontoItem;
          pRecalculaTotalItem;
        End
        Else
          pAtualizaUnitarioComLiquido;
      End;
    End

    Else If (Sender = edtUnitComImpostos) And
            (edtUnitComImpostos.Visible) And (Not edtUnitComImpostos.ReadOnly) And
            (Not fEmptyStr(fCodItem)) Then
    Begin
      If (fEmptyStr(edtUnitComImpostos.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'O valor unitário com impostos deve ser preenchido!', ['&OK']);
        Result := False;
      End
      Else If (fStrToFloat(edtUnitComImpostos.Text) <= 0.0) Then
      Begin
        fMensagem('ATENÇÃO!', 'O valor unitário com impostos deve ser maior que zero!', ['&OK']);
        Result := False;
      End
      Else If blnBuscaPorChave Then
      Begin
        If fUnitarioComImpostosFoiAlterado Then
          pAtualizaUnitarioComValorComImpostos;
        If (Not fUtilizaCampoUnitarioLiquido) Then
          Result := fValidaCampos(edtUnitar, True);
      End;
    End

    Else If (Sender = edtUniDol) And
            (pnlCotacaoDolar.Visible) And (Not edtUniDol.ReadOnly) And
            (Not fEmptyStr(fCodItem)) Then
    Begin
      If (fEmptyStr(edtUniDol.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'O valor unitário dólar deve ser preenchido!', ['&OK']);
        Result := False;
      End
      Else If (fStrToFloat(edtUniDol.Text) <= 0.0) Then
      Begin
        fMensagem('ATENÇÃO!', 'O valor unitário dólar deve ser maior que zero!', ['&OK']);
        Result := False;
      End
      Else If blnBuscaPorChave Then
      begin
        pAtualizaUnitarioComDolar;
      end;
    End

    Else If (Sender = mskDtaEnt) And
            (mskDtaEnt.Enabled) And
            (mskDtaEnt.Visible) And
            (Not fEmptyStr(fCodItem)) And
            (Not (blnInserindoCombo Or blnAlterandoCombo Or blnInserindoProdAtivacao Or blnAtualizarPnlDadosItemNaVendaModoTab)) And
            (Pos(strOpcDoc,'VN_PD_OR_') > 0) Then
    Begin

      If fEmptyStr(fTiraCaracEspeciais(mskDtaEnt.Text)) Then
      Begin
        fMensagem('','A data de entrega deve ser preenchida!', ['&OK']);
        Result := False;
      End
      Else If strToDateDef(mskDtaEnt.Text, 0) = 0 Then
      Begin
        fMensagem('ATENÇÃO!', mskDtaEnt.Text + ' não é uma data válida!', ['&Ok']);
        Result := False;
      End
      //QUANDO FOR ENTREGA FUTURA
      Else If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
      Begin

        With qryConCit Do
        Case cmbMotEntFut.ItemIndex Of
          IDX_MOTIVO_FALTA_PRODUTO:
             Begin
               If (Not fEmptyStr(fatVenda.strNumOrc)) And (fAlterandoProduto) And
                  (cdsVenda.FieldByName('ITE_MOTFUT').AsString = 'F') Then
                 dtaFutAnt := cdsVenda.FieldByName('ITE_DTENTR').AsDateTime
               Else
                 dtaFutAnt := VS_DATE + IIF(Active And (Not IsEmpty),
                                            FieldByName('ITE_DIAFOR').AsInteger,
                                            0);

               intDiaFor := dtaFutAnt - VS_Date;
               intDiaEnt := StrToDateDef(mskDtaEnt.Text, 0) - VS_Date;

               If dtaEntLib = StrToDate('31/12/9999') then
                 dtaEntLib := dtaFutAnt;

               If (StrToDate(mskDtaEnt.Text) <> dtaFutAnt) And (StrToDate(mskDtaEnt.Text) <> dtaEntLib) Then
               Begin
                 If fCfgSis('ALDENT') = 'T' Then
                 Begin
                   If (StrToDate(mskDtaEnt.Text) < fatVenda.dtaGraPed) Then
                   Begin
                     fMensagem('','A data deve ser maior ou igual a data do pedido (' + DateToStr(fatVenda.dtaGraPed) + ') !', ['&OK']);
                     dtaEntLib := dtaFutAnt;
                     Result := False;
                   End
                   Else If Not fPedeSenhaAltDataEntFut then
                   Begin
                     fMensagem('','A data deve ser igual a ' + DateToStr(dtaFutAnt) + '!', ['&OK']);
                     Result := False;
                   End
                   Else
                     dtaEntLib := StrToDate(mskDtaEnt.Text);
                 End
                 Else If StrToDate(mskDtaEnt.Text) < dtaFutAnt Then
                 Begin
                   If fCfgSis('ALDENT') = 'S' Then
                   Begin
                     If (StrToDate(mskDtaEnt.Text) < fatVenda.dtaGraPed) Then
                     Begin
                       fMensagem('','A data deve ser maior ou igual a data do pedido (' + DateToStr(fatVenda.dtaGraPed) + ') !', ['&OK']);
                       dtaEntLib := dtaFutAnt;
                       Result := False;
                     End
                     Else If Not fPedeSenhaAltDataEntFut then
                     Begin
                       fMensagem('','A data deve ser maior ou igual a ' + DateToStr(dtaFutAnt) + '!', ['&OK']);
                       Result := False;
                     End
                     Else
                       dtaEntLib := StrToDate(mskDtaEnt.Text);
                   End
                   Else
                   Begin
                     fMensagem('','A data deve ser maior ou igual a ' + DateToStr(dtaFutAnt) + '!', ['&OK']);
                     Result := False;
                   End;
                 End
                 Else
                   dtaEntLib := StrToDate(mskDtaEnt.Text);
               End
               Else
                 dtaEntLib := StrToDate(mskDtaEnt.Text);
             End;

          IDX_MOTIVO_AGUARDANDO_CLIENTE: mskDtaEnt.Text := '31/12/9999';

          IDX_MOTIVO_PREVISAO_ENTREGA:
             Begin

               If (StrToDate(mskDtaEnt.Text) < fatVenda.dtaGraPed) Then
               Begin
                 fMensagem('','A data deve ser maior ou igual a data do pedido (' +
                           DateToStr(fatVenda.dtaGraPed) + ') !', ['&OK']);
                 Result := False;
               End
               Else If (Not fatVenda.blnLibMaxDiaFutPrev) And
                       (DaysBetween(StrToDate(mskDtaEnt.Text), VS_Date) > fCfgSis('DIMXFP', varInteger, fGetEmpConfigEntrega)) Then
               Begin
                 objLiberacao.Clear;
                 objLiberacao.objMsgLibera.pAddTexto('A data de entrega não deve exceder mais que ' + fCfgSis('DIMXFP', varString, fGetEmpConfigEntrega) + ' dias da data atual!');

                 objLiberacao.strDirAce := 'DIMXFP';
                 objLiberacao.strMsgSen := 'Máximo de dias para Entrega Futura - Previsão de Entrega.';
                 objLiberacao.strCodOpe := fatVenda.strCodVen;
                 objLiberacao.strCodDig := fatVenda.strCodDig;
                 objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
                 objLiberacao.strCpfCnpj := fatVenda.strCliCgc;


                 Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

                 fatVenda.blnLibMaxDiaFutPrev := Result;
               End

               Else If (Not fatVenda.blnLibMinDiaFutPrev) And
                       (DaysBetween(VS_Date, StrToDate(mskDtaEnt.Text)) < fCfgSis('DIAPRE', varInteger, fGetEmpConfigEntrega)) Then
               Begin
                 objLiberacao.Clear;
                 objLiberacao.objMsgLibera.pAddTexto('A data de entrega deve ser maior que ' + fCfgSis('DIAPRE', varString, fGetEmpConfigEntrega) + ' dias contando a data atual');
                 objLiberacao.objMsgLibera.pAddTexto(' ');

                 objLiberacao.strDirAce := 'DIAPRE';
                 objLiberacao.strMsgSen := 'Mínimo de dias para Entrega Futura - Previsão de Entrega.';
                 objLiberacao.strCodOpe := fatVenda.strCodVen;
                 objLiberacao.strCodDig := fatVenda.strCodDig;
                 objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
                 objLiberacao.strCpfCnpj := fatVenda.strCliCgc;


                 Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

                fatVenda.blnLibMinDiaFutPrev := Result;
               End
               Else If Assigned(fatVenda.objConEnt) Then
               Begin
                 If (Not fatVenda.objConEnt.fDataExisteNaMatriz(StrToDateDef(mskDtaEnt.Text, 0), fatVenda.objConEnt.arrDtaOri)) Then
                 Begin
                   If (Not fatVenda.objConEnt.fDataDisponivel(StrToDateDef(mskDtaEnt.Text, 0),
                                                              IIF(fatVenda.objConEnt.fEhControleDeEntregaRomaneioMultiloja, fRetEmpresaItem, VS_strCodEmp))) Then
                   Begin
                     fMensagem('ATENÇÃO!', 'Data não disponível para entrega!', ['&Ok']);
                     Result := False;
                   End;
                 End;
               End;

             End;
        End;

      End
      //QUANDO FOR ENTREGA IMEDIATA
      Else If (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
      Begin
        If strToDateDef(mskDtaEnt.Text, 0) < VS_Date Then
        Begin
          fMensagem('ATENÇÃO!', 'A data de entrega deve ser maior ou igual a ' + DateToStr(VS_Date) + '.', ['&Ok']);
          Result := False;
        End
        Else If (fDataEntregaInferiorAoPermitido) And (Not fValidaDireitoDeAcessoQMDPEI) Then
        Begin
          Result := False;
        End
        Else If strToDateDef(mskDtaEnt.Text, 0) > (VS_Date + fCfgSis('DIAIME', varInteger, fGetEmpConfigEntrega)) Then
        Begin
          fMensagem('ATENÇÃO!', 'A data de entrega imediata não deve ultrapassar ' +
            fCfgSis('DIAIME', VarString, fGetEmpConfigEntrega) + ' dias!', ['&Ok']);
          Result := False;
        End
        Else If Assigned(fatVenda.objConEnt) Then
        Begin
          If (Not fatVenda.objConEnt.fDataExisteNaMatriz(StrToDateDef(mskDtaEnt.Text, 0), fatVenda.objConEnt.arrDtaOri)) Then
          Begin
            If (Not fatVenda.objConEnt.fDataDisponivel(StrToDateDef(mskDtaEnt.Text, 0),
                                                       IIF(fatVenda.objConEnt.fEhControleDeEntregaRomaneioMultiloja, fRetEmpresaItem, VS_strCodEmp))) Then
            Begin
              fMensagem('ATENÇÃO!', 'Data não disponível para entrega!', ['&Ok']);
              Result := False;
            End;
          End;
        End;
      End;

    End

    Else If (Sender = cmbEntSai) Then
    Begin

      If (blnBuscaPorChave) Or (Not fEmptyStr(cmbEntSai.Text)) Then
      Begin

        If (strOpcDoc = 'TR') Then
        Begin

          If fCfgSis('OPCTRO') = 'A' Then
          Begin
            If Pos(cmbEntSai.Text[1], 'SE') <= 0 Then
            Begin
              fMensagem('', 'Tipo de Movimento tem que ser Igual a E ou S !', ['&O k']);
              Result := False;
            End;
          End
          Else If fCfgSis('OPCTRO') = 'E' Then
          Begin
            If Pos(cmbEntSai.Text[1], 'E') <= 0 Then
            Begin
              fMensagem('', 'Tipo de Movimento tem que ser Igual a E!', ['&O k']);
              Result := False;
            End;
          End
          Else
          Begin
            If Pos(cmbEntSai.Text[1], 'S') <= 0 Then
            Begin
              fMensagem('', 'Tipo de Movimento tem que ser Igual a S!', ['&O k']);
              Result := False;
            End;
          End;

        End
        Else
        Begin
          If Pos(cmbEntSai.Text[1], 'SE') <= 0 Then
          Begin
            fMensagem('', 'Tipo de Movimento tem que ser Igual a E ou S !', ['&O k']);
            Result := False;
          End;
        End;

      End;

      If (Result) Then
      Begin
        blnRecalculaJuros := False;
        If (fAlterandoProduto) And (strOpcDoc = 'TR') Then
        Begin
          If (cdsVenda.FieldByName('ITE_ENTSAI').AsString <> cmbEntSai.Text[1]) Then
          Begin
            blnRecalculaJuros := True;
          End;
        End
        Else If (strOpcDoc = 'TR') And (blnBuscaPorChave) Then
          blnRecalculaJuros := True;

        If (blnRecalculaJuros) Then
        Begin
          Begin
            If cbTabPrecoItem.Visible Then
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem, cmbEntSai.Text[1], fStrToFloat(edtMargem.Text), False, 'NOR', fTabelaDePrecoDosItens))
            Else
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem, cmbEntSai.Text[1], fStrToFloat(edtMargem.Text)));

            {*******************************************}
            {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
            {* APLICA O PERCENTUAL DE DESCONTO         *}
            {****************************************JB*}
            If (fatVenda.strCAbDes = 'S') And (fCfgSis('CNDVEN') = 'I') And
               ((fatVenda.strPromoc <> 'S') Or
                (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
               (Not fAplicarTaxaJurosPrecoDigitado) Then
            Begin
              {********************************************************************}
              {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
              {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
              {****************************************************************MM**}
              fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

              If fCfgSis('DESCND',varBoolean) Then
              Begin
                If (fatVenda.strDstCnd = 'S') Then
                Begin
                  edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
                  edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
                End
                Else
                  edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

              End

              Else If (fatVenda.strCodFpg = '007') Then
              Begin
                If (fatVenda.strAbDeCc = 'S') Then
                  edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
              End
              Else
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
            End;

            If fAplicarDescontoRessarcimentoCAT Then
            begin
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fStrToFloat(edtUnitar.Text)));
            end;

          End;
        End;

      End;

      pAtualizaUnitarioLiquido;
    End

    Else If (Sender = edtUnitar) Then
    Begin

      If fEmptyStr(edtUnitar.Text) And (blnBuscaPorChave) Then
      Begin
        fMensagem('ATENÇÃO!', 'O Valor Unitário deve ser preenchido!', ['&O k']);
        Result := False;
      End
      Else If (fStrToFloat(edtUnitar.Text) <= 0) And (blnBuscaPorChave) Then
      Begin
        If (Not fPermiteBrindeComValorZero) And ((Not (chkBrinde.Visible And chkBrinde.Checked)) And (Not ((strOpcDoc = 'DV') And (chkBrinde.Checked)))) Then
        Begin
          fMensagem('ATENÇÃO!', 'O Valor Unitário deve ser maior que Zero!', ['&O k']);
          Result := False;
        End
        Else If (fPermiteBrindeComValorZero) Then
          edtUnitar.Text := '0,00';
      End
      Else If (Pos(strOpcDoc, 'DV_PR_DD_') > 0) And (fltUniDev > 0.0) Then
      Begin

        If fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni) > fFormataFloat(fltUniDev, fatVenda.VS_intDecUni) Then
        Begin
          fMensagem('ATENÇÃO!', 'O Unitário deve ser menor ou igual a ' + FloatToStr(fltUniDev) + '!', ['&O k']);
          Result := False;
        End;

      End;

      If (fatVenda.blnApenasUnitarioAcimaDoSugerido) And (blnBuscaPorChave) And (Not blnInserindoCombo) And
         (fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni) < fFormataFloat(IIF((Pos(strOpcDoc, 'DV_PR_DD_') > 0), fltUniDev, fUnitarioMinimo), fatVenda.VS_intDecUni)) Then
      Begin
        fMensagem('ATENÇÃO!', 'O Unitário deve ser maior ou igual a ' + FloatToStr(fFormataFloat(IIF((Pos(strOpcDoc, 'DV_PR_DD_') > 0), fltUniDev, fUnitarioMinimo), fatVenda.VS_intDecUni)) + '!', ['&OK']);
        Result := False;
      End;

      {****************************************}
      {* VERIFICA SE É TROCA DE MERCADORIA E  *}
      {* PEDE SENHA DE LIBERAÇÃO CASO PRECISE *}
      {*************************************RV*}
      If (strOpcDoc = 'TR') And Not blnSenAumTro Then
      Begin
        If (cmbEntSai.Text[1] = 'E') Then
        Begin
          If (fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni) > fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni)) Then
          Begin

            strSnTrTb    := fCfgSis('PWDTRO');
            objLiberacao.Clear;
            objLiberacao.objMsgLibera.pAddTexto('Aumento de Preço na Entrada para Troca');

            objLiberacao.strDirAce := 'PWDTRO';
            objLiberacao.strSenLib := strSnTrTb;
            objLiberacao.strMsgSen := 'Aumento de Preço na Entrada para Troca';
            objLiberacao.strCodOpe := fatVenda.strCodVen;
            objLiberacao.strCodDig := fatVenda.strCodDig;
            objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
            objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

            If cbTabPrecoItem.Visible Then
              fltPrtRen := fatVenda.fRetPrecoTroca('E', cbTabPrecoItem.Text)
            Else
              fltPrtRen := fatVenda.fRetPrecoTroca('E', fatVenda.strTabPre);

            objLiberacao.objMsgLibera.pAddTexto('Valor Sugerido: ' + FloatToStrF(fltPrtRen ,ffFixed, 12, 2));
            objLiberacao.objMsgLibera.pAddTexto('Valor Praticado: '+ FloatToStrF(fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni),ffFixed, 12,2));

            blnSenAumTro := fatVenda.fFatMensagemLiberacao(objLiberacao);

            Result       := blnSenAumTro;
            If Not Result Then
            Begin
              fMensagem('ATENÇÃO!', 'O Valor Unitário não pode ser maior que o Original!', ['&O k']);
            End;

          End;
        End;
      End;

      If (Pos(strOpcDoc, 'OE_EF_') > 0) And Not blnSenAutOutEnt Then
      Begin
        If (fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni) > fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni)) Then
        Begin

          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Aumento de Preço na Entrada para Troca');

          objLiberacao.strDirAce := 'SAPOUE';
          objLiberacao.strMsgSen := 'Aumento de Preço em outras entradas';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
          objLiberacao.tipCliFor  := IIF(strOpcDoc = 'EF', cfFornecedor, cfCliente);

          blnSenAutOutEnt := fatVenda.fFatMensagemLiberacao(objLiberacao);

          Result       := blnSenAutOutEnt;
          If Not Result Then
          Begin
            fMensagem('ATENÇÃO!', 'O Valor Unitário não pode ser maior que o Original!', ['&O k']);
          End;

        End;
      End;

      pAtualizaUnitarioLiquido;

      If fEstaNaConsultaTab And blnBuscaPorChave And (fatVenda.strIdePro = 'NOR') Then
        pExecutarAtualizarImpostosNaConsultaTab;

      if (not edtUnitar.ReadOnly) and (edtUntPec.Visible) then
      begin
        // Verifica se o usuário digitou um valor unitário para a peça
        fltValUnitar := fStrToFloat(edtUntPec.Text);

        if fltValUnitar > 0 then
        begin
          fltQtdIte := fStrToFloat(edtQtdIte.Text);
          edtUntPec.Text := FloatToStrF(fltValUnitar * fltQtdIte, ffFixed, 12, fatVenda.VS_intDecUni);
        end;
      end;

    End

    Else If (Sender = edtDesCon) Then
    Begin
      If fEstaNaConsultaTab And blnBuscaPorChave And (fatVenda.strIdePro = 'NOR') Then
        pExecutarAtualizarImpostosNaConsultaTab;

    End

    {***************************************************}
    {* VALIDA COMPLEMENTO DO PRODUTO                   *}
    {* VERIFICA CFG_DCOPRO E TORNA OU NÃO OBRIGATÓRIO  *}
    {************************************************RL*}
    Else If (Sender = cbbComple) And (cbbComple.Visible) Then
    Begin
      If (fCfgSis('DCOPRO', varBoolean)) Then
      begin
        If (fEmptyStr(cbbComple.Text)) And (Not fEmptyStr(edtDesIte.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'O complemento do produto deve ser preenchido!', ['&Ok']);
          Result := False;
        End;
      end;
    End

    else if (Sender = edtQtdChapas) and
       (blnBuscaPorChave) and
       (blnEnabledVariasChapasLote) and
       (pnlQtdVariasChapasLote.Visible) then
    begin
      if fValidaQtdChapas and
         Assigned(fatVenda.objCadLot) and
         Assigned(fatVenda.objCadLot.qryCadLot) and
         fatVenda.objCadLot.qryCadLot.Active then
       begin
        edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, fStrToFloat(edtQtdChapas.Text)
                                                          * fatVenda.objCadLot.qryCadLot.FieldByName('LOT_MEDL_A').AsFloat
                                                          * fatVenda.objCadLot.qryCadLot.FieldByName('LOT_MEDL_L').AsFloat);

        If (fltQtdDigAnt <> fStrToFloat(edtQtdIte.Text)) Then
          pAtualizaUnitarioSugestao();

       end
       else
        Result := False;
    end

    Else If (fCliLoj) Then
    Begin
      If (Sender = cbbClienteEstaNaLoja) Then
      Begin
        If (fEmptyStr(cbbClienteEstaNaLoja.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'É necessário informar se o cliente "está/não está" na loja! ', ['&Ok']);
          Result := False;
        End;
      End;
    End

    Else If (Sender = edtDescricaoLocalizar) And pnlPesquisarDescricao.Visible And blnBuscaPorChave Then
    Begin
      If Not fEmptyStr(edtDescricaoLocalizar.Text) Then
      Begin
        Result := fLocalizarDescricaoItem(foFindFirst);
        If Not Result Then
          pMensagemOk('Produto não foi localizado!');
      End;
    End

  End;

  If (Not blnBuscaPorChave) And (fatVenda.VS_blnUsaFpg) And (Sender = edtForPag) Then
  Begin

    Result := fValidaCodFpg(fatVenda.strCodFpg, fatVenda.strConPag, blnExit);

    If blnExit Then
      Exit;

  End;

  If Not fValidaPrazoMedioMaximoVenda Then
  Begin
    If fCfgSis('CNDVEN') = 'I' Then
      pSetFocus(edtCodCnd)
    Else
      pSetFocus(edtCodCli);
    Result := False;
    blnMudarFoco := False;
    Exit;
  End;

  if Result and
     (Sender = edtQtdChapas) and
     (not blnBuscaPorChave) and
     (blnEnabledVariasChapasLote) and
     (pnlQtdVariasChapasLote.Visible) then
  begin
    Result := fValidaQtdChapas;
  end;

  If (Result) And (Not fatVenda.fDocumentoParaFornecedor) And
     (Not fEmptyStr(fatVenda.strCodCli)) Then
  Begin
    blnVenCli := True;
    btnCCCli.Visible := True;
    btnResFin.Visible := True;
    If (Pos(strOpcDoc, 'PD_') > 0) And blnIteRep Then
    Begin
      blnIteRpr := True;
    End;
  End;

  {********************************************************}
  {* PARA CASOS EM QUE A CONDIÇÃO DE PAGAMENTO DO CLIENTE *}
  {* NÃO TEM TABELA DE PREÇO CADASTRADA                   *}
  {* (Dúvidas Procurar por blnAtualizaTabPreCnd)          *}
  {*****************************************************MM*}
  If (Sender = edtCodCli) And blnFocusCodCnd Then
  Begin
    Result         := False;
    Sender         := edtCodCnd;
    blnFocusCodCnd := False;
  End;

  If (Result) And (Sender = edtCodCli) And (Not fEmptyStr(edtCodCli.Text)) And (Not blnLibCan) Then
  Begin
    blnLibCan := fValidarCanhotoNotaFiscalPendente(fatVenda);
    Result    := blnLibCan;
  End;

  if (Result) and
     (Sender = edtCodCli) and
     (Not fEmptyStr(edtCodCli.Text)) and
     (Not blnPerguntarPedidoComplementar) and
     (fCfgSis('PEDCPL', varBoolean)) and
     ((Pos(strOpcDoc, 'PD_') > 0)) and
     (fEmptyStr(fatvenda.strNumOrc)) and
     (Not fClienteConsumidor(fRetNomCliente(edtCodCli.Text))) and
     (Not fatVenda.fClienteFilialVenda(edtCodCli.Text)) then
  begin
    blnPerguntarPedidoComplementar := True;

    frmConsultaFatDocumentosCliente := nil;
    strLocalNumDoc := EmptyStr;
    strLocalEspDoc := EmptyStr;

    pCriarFormularios(TfrmConsultaFatDocumentosCliente, frmConsultaFatDocumentosCliente);
    try
      frmConsultaFatDocumentosCliente
        .SetNomCli(edtNomCli.Text)
        .SetCodCli(edtCodCli.Text)
        .SetCodEmp(VS_strCodEmp)
        .SetEspDoc(strOpcDoc)
        .SetJaFatu('0');

      if (frmConsultaFatDocumentosCliente
            .fQuantidadePedidoEmAbertoParaCliente > 0)  then
      begin
        if (fMensagem('AVISO!', 'Existe pedido de venda não faturado '+
                                'para este cliente, deseja incluir complemento?', ['&Sim', '&Não'], 1) = 1) then
        begin
          frmConsultaFatDocumentosCliente
            .fAbrirConsultaFatDocumentosCliente(strLocalNumDoc, strLocalEspDoc);
        end;
      end;
    finally
      if Assigned(frmConsultaFatDocumentosCliente) then
        pFreeAndNil(frmConsultaFatDocumentosCliente);
    end;

    if not fEmptyStr(strLocalNumDoc) then
    begin
      strNumOrcPedAbrir      := strLocalNumDoc;
      strEspOrcPedAbrir      := strLocalEspDoc;
      fatVenda.blnFecharForm := True;
      Self.Repaint;
    end;
  end;

  If (Result) And
     (fCfgSis('UTCRVP', varBoolean)) And
     (Pos(fatVenda.strOpcDoc,'OR_PD_VN_F3_CP_') > 0) And
     (Sender = edtCodIte) And
     (Not fEmptyStr(edtCodIte.Text)) Then
  Begin
    Result := fValidaRestricaoVendaProduto(Sender);
  End;

  If Not Result Then
  Begin

    If (Sender = edtCodCli) Then
    Begin
      //Sulcores ver requisito 83222
      //Caso alterando um pedido e trocou o cliente, porém não validou o novo
      //deve voltar os dados do cliente anterior (strCliAnt). Hoje o sistema
      //esta limpando a variavel strCliAnt com isso esta recalculando os
      //precos negociados mesmo estando configurado para nao recalcular precos
      //ao trocar o cliente do documento. (Caso gere algum efeito colateral
      //desfazer esta alteracao e falar com Joao C.
      If (Not fEmptyStr(fatVenda.strNumOrc)) And (Assigned(qryFatGor)) And (qryFatGor.Active) And
         (qryFatGor.FieldByName('FGO_CODCLI').AsString = strCliAnt) Then
//         Requisito 87527
//         And (edtCodCli.Text <> strCliAnt) Then
      Begin
        If Not fCfgSis('RECACL', varBoolean) Then
        Begin
          edtCodCli.Text := strCliAnt;
          pCarregaCliente;
        End
        Else
          strCliAnt := '';
      End
     {********************************************************}
     {* EM ALGUNS CASOS QUANDO HÁ TROCA DE CLIENTES NÃO ESTÁ *}
     {* ENTRANDO NA FUNÇAO pCarregaCliente                   *}
     {*****************************************************LA*}
      Else
        strCliAnt := '';

      pnlCampanha.Visible := False;
      pVerificaTamanhoPnlCliente;
    End;

    Self.Enabled := TRUE;

    If (Sender = mskCndPag) And (edtCodCnd.Visible) And (Not edtCodCnd.ReadOnly) Then
    Begin
      pSetFocus(edtCodCnd);
    End
    Else If (Sender.Enabled) And (fPermiteSetFocusNoValidaCampos) Then
      pSetFocus(Sender);
  End
  Else If blnBuscaPorChave Then
    pCalculaTotIte;
end;

function TfrmFatVendas.fValidaClassificacaoFiscalDevolucao: Boolean;
begin
  Result := True;
  If (strOpcDoc = 'DV') And (Pos(fatVenda.strClaFis, VS_strClaDev + fRetComplementoStrClaDevBrinde(strOpcDoc)) <= 0) Then
  Begin
    pMensagemOK('A classificação ' + fatVenda.strClaFis + ' não está cadastrada nas classificações de devolução!');
    Result := False;
  End;
end;

function TfrmFatVendas.fPermiteSelecionarTabelaDePrecoNoFaturamento: Boolean;
begin
  Result := fCfgSis('SUGTBP') = 'S';
end;

function TfrmFatVendas.fUtilizaApenasUmaTabelaDePrecoNoFaturamento: boolean;
begin
  Result := fCfgSis('UTAPTB') <> '0';
end;

function TfrmFatVendas.fUtilizaTabelaDePrecoUsadaComoSugestaoNoFaturamento: boolean;
begin
  Result := fCfgSis('TBPSUG') <> '0';
end;

function TfrmFatVendas.fSistemaSugeriuTabelaCliente: Boolean;
begin
  if fUtilizaApenasUmaTabelaDePrecoNoFaturamento then
    Exit(False);

  if not fPermiteSelecionarTabelaDePrecoNoFaturamento then
    Exit(True);

  Result := not fUtilizaTabelaDePrecoUsadaComoSugestaoNoFaturamento;
end;

function TfrmFatVendas.fCalcularDescontoEspecialDevolucaoFornecedor: Boolean;
begin
  Result := True;
  If (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
    fatVenda.pCalculaDescontoEspecialDevolucaoFornecedor;
end;

function TfrmFatVendas.fCalcularImpostosAplicadosNoDescontoEspecial: Boolean;
begin
  Result := True;
  {*****************************************}
  {* FAZ ABATIMENTO DO VALOR DO IMPOSTO    *}
  {* QUANDO FOR ORGÃO PÚBLICO              *}
  {**************************************MV*}
  fatVenda.fltIcmOrg := 0.0;
  fatVenda.fltBasOrg := 0.0;

  {******************************************}
  {* CHAMA A FUNÇÃO PARA CALCULAR fltIcmOrg *}
  {* PARA SOMA-LO COM O DESCONTO ESPECIAL   *}
  {***************************************MV*}
  If (fatVenda.fAplicaDescontoIcmsOrgaoPublicoNoDescontoEspecial) And (fatVenda.strOpcDoc <> 'DV') Then
  Begin
    pCalculaTotGer(False, False);

    If fatVenda.fltDesEsp < fatVenda.fltIcmOrg Then
      fatVenda.fltDesEsp := fatVenda.fltIcmOrg;

    pCalculaTotGer(False, False); //mudar
  End;

  fatVenda.pDestacaRetencoes;

  If (fatVenda.strOpcDoc <> 'DV') Then
    fatVenda.pRetemImpostosNoDescontoEspecial;
end;

function TfrmFatVendas.fRetCorSinaleiroDocAtual(fltPrecus, fltCusrea: Double): String;
var
  qryFaixas : TUniQuery;
  fltValor  : Double;
begin

  Result := clWhite.ToString();

  If fEmptyStr(fatVenda.strCodVen) Then
    Exit;

  fltValor := IIF(fCfgSis('INDSIN', varString) = '1', fltPrecus, fltCusrea);

  qryFaixas := fCriaQuery();

  Try

    qryFaixas.Close;
    qryFaixas.SQL.Clear;
    qryFaixas.SQL.Add('SELECT            ');
    qryFaixas.SQL.Add('  MAR.FAI_CODFAI, ');
    qryFaixas.SQL.Add('  MAR.FAI_DESFAI, ');
    qryFaixas.SQL.Add('  PER.FAI_MARINI, ');
    qryFaixas.SQL.Add('  PER.FAI_MARFIN, ');
    qryFaixas.SQL.Add('  PER.FAI_CORFAI  ');
    qryFaixas.SQL.Add('FROM              ');
    qryFaixas.SQL.Add('  FAIMAR MAR      ');
    qryFaixas.SQL.Add('  INNER JOIN FAIPER PER ON (PER.FAI_CODFAI = MAR.FAI_CODFAI) ');
    qryFaixas.SQL.Add('WHERE 1=1');

    qryFaixas.SQL.Add('AND ((SELECT COUNT(*) FROM FAIVEN VEN WHERE VEN.FAI_CODFAI = MAR.FAI_CODFAI AND VEN.FAI_CODVEN = (' + fatVenda.strCodVen.QuotedString + ')) > 0 OR ');
    qryFaixas.SQL.Add('    (SELECT COUNT(*) FROM FAIVEN VEN WHERE VEN.FAI_CODFAI = MAR.FAI_CODFAI) = 0) ');

    qryFaixas.SQL.Add('ORDER BY                         ');
    qryFaixas.SQL.Add('  PER.FAI_CODFAI, PER.FAI_MARINI ');
    qryFaixas.Open;

    recSinaleiro.strMargemMesApuracao          := FormatFloat('#,##0.00', 0);
    recSinaleiro.strFaixaEncontradaMesApuracao := '';

    If Not qryFaixas.IsEmpty Then
    Begin

      qryFaixas.First;
      While Not qryFaixas.Eof Do
      Begin
        If ((fltValor >= qryFaixas.FieldByName('FAI_MARINI').AsFloat) And (fltValor <= qryFaixas.FieldByName('FAI_MARFIN').AsFloat)) Then
        Begin
          Result := qryFaixas.FieldByName('FAI_CORFAI').AsString;
          recSinaleiro.strMargemDocumentoAtual          := FormatFloat('#,##0.00', fltValor);
          recSinaleiro.strFaixaEncontradaDocumentoAtual := qryFaixas.FieldByName('FAI_CODFAI').AsString + '-' +
                                                           qryFaixas.FieldByName('FAI_DESFAI').AsString;
          Exit;
        End;
        qryFaixas.Next;
      End;

    End;

  Finally
    FreeAndNil(qryFaixas);
  End;

end;

function TfrmFatVendas.fRetCorSinaleiroMesApuracao: String;
var
  qryMargem : TUniQuery;
  strDtaIni, strDtaFin : String;

  qryFaixas : TUniQuery;
  fltValor  : Double;

const
  SQL_TOTCUS      = 'SUM(IF(LEFT(MOVDET.DET_CLAFIS, 1) < 5, - IFNULL(ROUND((IFNULL(DET_TOTCUS, 0)), 2), 0), IFNULL(ROUND((IFNULL(DET_TOTCUS, 0)), 2), 0))) AS TOTCUS,';
  SQL_TOTCUS_REAL = 'SUM(                                ' +
                    '  IF(                               ' +
                    '    LEFT(MOVDET.DET_CLAFIS, 1) < 5, ' +
                    '    - IFNULL(                       ' +
                    '      ROUND(                        ' +
                    '        (                           ' +
                    '          IFNULL(DET_TOTCUS, 0) + IFNULL(DET_OUTVAL, 0) + IFNULL(DET_ICMSAI, 0) + IFNULL(DET_IMPFED, 0) + IFNULL(DET_DESOPE, 0) ' +
                    '        ),                          ' +
                    '        2                           ' +
                    '      ),                            ' +
                    '      0                             ' +
                    '    ),                              ' +
                    '    IFNULL(                         ' +
                    '      ROUND(                        ' +
                    '        (                           ' +
                    '          IFNULL(DET_TOTCUS, 0) + IFNULL(DET_OUTVAL, 0) + IFNULL(DET_ICMSAI, 0) + IFNULL(DET_IMPFED, 0) + IFNULL(DET_DESOPE, 0) ' +
                    '        ),                          ' +
                    '        2                           ' +
                    '      ),                            ' +
                    '      0                             ' +
                    '    )                               ' +
                    '  )                                 ' +
                    ') AS TOTCUS, ';

begin

  Result := clWhite.ToString();

  If fEmptyStr(fatVenda.strCodVen) Then
    Exit;

  qryMargem := fCriaQuery;

  Try

    qryMargem.Close;
    qryMargem.SQL.Clear;

    qryMargem.SQL.Add('SET @VS_STRCLIFIL    := "' + VS_STRCLIFIL + '";');
    qryMargem.SQL.Add('SET @VS_STRCLAVEN    := "' + VS_STRCLAVEN + '";');
    qryMargem.SQL.Add('SET @VS_STRCLADEV    := "' + VS_STRCLADEV + '";');
    qryMargem.SQL.Add('SET @VS_STRCLAFIS_BR := "' + '5910_6910_' + '";');

    pRetornaPeriodoApuracaoSinaleiro(strDtaIni, strDtaFin);

    qryMargem.SQL.Add('SET @DTAINI := "' + FormatDateTime('yyyy-mm-dd', StrToDate(strDtaIni)) + '";');
    qryMargem.SQL.Add('SET @DTAFIN := "' + FormatDateTime('yyyy-mm-dd', StrToDate(strDtaFin)) + '";');
    qryMargem.SQL.Add('SET @CODEMP := "' + VS_strCodEmp + '";');

    qryMargem.SQL.Add('SET @ABRINDO_CONSULTA := TRUE;');
    qryMargem.SQL.Add('SET @VS_STRCODEMP := @CODEMP;');
    qryMargem.SQL.Add('SET @FATCLF = fCfgSis("FATCLF",@VS_STRCODEMP);');
    qryMargem.SQL.Add('SET @ENTBRF = fCfgSis("ENTBRF",@VS_STRCODEMP);');
    qryMargem.SQL.Add('SET @COM_FF = fCfgSis("COM_FF",@VS_STRCODEMP);');
    qryMargem.SQL.Add('SET @COM_FV = IFNULL(fCfgSis("COM_FV",@VS_STRCODEMP),fCfgSis("COM_FF",@VS_STRCODEMP));');
    qryMargem.SQL.Add('SET @COM_TR = fCfgSis("COM_TR",@VS_STRCODEMP);');
    qryMargem.SQL.Add('SET @COM_DV = fCfgSis("COM_DV",@VS_STRCODEMP);');
    qryMargem.SQL.Add('SET @SERTER = IFNULL(fCfgSis("SERTER",@VS_STRCODEMP),"");');
    qryMargem.SQL.Add('SET @ITESER = IFNULL(fCfgSis("ITESER",@VS_STRCODEMP),"");');
    qryMargem.SQL.Add('SET @DECUNI = fCfgSis("DECUNI",@VS_STRCODEMP);');
    qryMargem.SQL.Add('SET @MARMKP = fCfgSis("MARMKP",@VS_STRCODEMP);');

    qryMargem.SQL.Add('SELECT ');
    qryMargem.SQL.Add('  IF(((1-(SUM(TOTCUS)/SUM(TOTITE))) * 100) IS NULL,0,((1-(SUM(TOTCUS)/SUM(TOTITE)))*100)) AS MARGEM, ');
    qryMargem.SQL.Add('  IF((((SUM(TOTITE)/SUM(TOTCUS)) * 100)-100) IS NULL,0,(((SUM(TOTITE)/SUM(TOTCUS))*100)-100)) AS MARKUP ');
    qryMargem.SQL.Add('FROM ');
    qryMargem.SQL.Add('( ');
    qryMargem.SQL.Add('SELECT ');
    qryMargem.SQL.Add('  MOVDET.DET_CODITE, ');

    qryMargem.SQL.Add(IIF(fCfgSis('INDSIN', varString) = '1', SQL_TOTCUS, SQL_TOTCUS_REAL));

    qryMargem.SQL.Add('  SUM(IF((MOVDET.DET_ESPDOC = "BR") OR LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLAFIS_BR), 0.00, IF(LEFT(MOVDET.DET_CLAFIS,1) < 5, ');
    qryMargem.SQL.Add('  -(MOVDET.DET_TOTITE - MOVDET.DET_DESESP - MOVDET.DET_DESCFF), MOVDET.DET_TOTITE - MOVDET.DET_DESESP - MOVDET.DET_DESCFF))) AS TOTITE ');

    qryMargem.SQL.Add('FROM ');
    qryMargem.SQL.Add('  MOVDET ');
    qryMargem.SQL.Add('  INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ');
    qryMargem.SQL.Add('  LEFT  JOIN MOVICD ON MOVICD.ICD_SEQGER = MOVDET.AUTOINCREM AND MOVDET.DET_VALRET = 0 ');
    qryMargem.SQL.Add('WHERE MOVDET.DET_CODVEN = "' + fatVenda.strCodVen + '"');
    qryMargem.SQL.Add('  AND MOVDET.DET_DTAENT BETWEEN @DTAINI AND @DTAFIN ');
    qryMargem.SQL.Add('  AND MOVDET.DET_PROEMB <> "S" ');
    qryMargem.SQL.Add('  AND MOVDET.DET_TIP_FC = "C" ');
    qryMargem.SQL.Add('  AND IF(@FATCLF = "N",LOCATE(MOVDET.DET_CODCLI, @VS_STRCLIFIL) <= 0, TRUE) ');
    qryMargem.SQL.Add('  AND ((LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLAVEN) > 0) ');
    qryMargem.SQL.Add('  OR (LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLADEV) > 0) ');
    qryMargem.SQL.Add('  OR IF(@ENTBRF = "S",(MOVDET.DET_ESPDOC = "BR") ');
    qryMargem.SQL.Add('  OR LOCATE(MOVDET.DET_CLAFIS,@VS_STRCLAFIS_BR), FALSE)) ');
    qryMargem.SQL.Add('  AND IF(((@COM_FF = 2 AND IFNULL(MOVDET.DET_CONPAG,"01000") <> "01000") OR (@COM_FV = 2 AND IFNULL(MOVDET.DET_CONPAG,"01000")  = "01000")),MOVDET.DET_ESPDOC NOT IN ("FF"), TRUE) ');
    qryMargem.SQL.Add('  AND IF(@COM_TR = 2,MOVDET.DET_ESPDOC NOT IN ("TR"),TRUE) ');
    qryMargem.SQL.Add('  AND IF(@COM_DV = 2,MOVDET.DET_ESPDOC NOT IN ("DV"),TRUE) ');

    qryMargem.SQL.Add('UNION ALL ');

    qryMargem.SQL.Add('SELECT ');
    qryMargem.SQL.Add('  MOVDET.DET_CODITE, ');

    qryMargem.SQL.Add(IIF(fCfgSis('INDSIN', varString) = '1', SQL_TOTCUS, SQL_TOTCUS_REAL));

    qryMargem.SQL.Add('  SUM(IF((MOVDET.DET_ESPDOC = "BR") OR LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLAFIS_BR), 0.00, IF(LEFT(MOVDET.DET_CLAFIS,1) < 5, ');
    qryMargem.SQL.Add('  -(MOVDET.DET_TOTITE - MOVDET.DET_DESESP - MOVDET.DET_DESCFF), MOVDET.DET_TOTITE - MOVDET.DET_DESESP - MOVDET.DET_DESCFF))) AS TOTITE ');

    qryMargem.SQL.Add('FROM ');
    qryMargem.SQL.Add('  MOVDET ');
    qryMargem.SQL.Add('  INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ');
    qryMargem.SQL.Add('  LEFT  JOIN MOVICD ON MOVICD.ICD_SEQGER = MOVDET.AUTOINCREM AND MOVDET.DET_VALRET = 0 ');
    qryMargem.SQL.Add('WHERE MOVDET.DET_CODVEN = "' + fatVenda.strCodVen + '"');
    qryMargem.SQL.Add('  AND MOVDET.DET_DTAFAT BETWEEN @DTAINI AND @DTAFIN ');
    qryMargem.SQL.Add('  AND MOVDET.DET_PROEMB <> "S" ');
    qryMargem.SQL.Add('  AND MOVDET.DET_TIP_FC = "C" ');
    qryMargem.SQL.Add('  AND IF(@FATCLF = "N",LOCATE(MOVDET.DET_CODCLI, @VS_STRCLIFIL) <= 0, TRUE) ');
    qryMargem.SQL.Add('  AND ((LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLAVEN) > 0) ');
    qryMargem.SQL.Add('  OR (LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLADEV) > 0) ');
    qryMargem.SQL.Add('  OR IF(@ENTBRF = "S",(MOVDET.DET_ESPDOC = "BR") ');
    qryMargem.SQL.Add('  OR LOCATE(MOVDET.DET_CLAFIS, @VS_STRCLAFIS_BR), FALSE)) ');
    qryMargem.SQL.Add('  AND MOVDET.DET_ESPDOC IN((IF(((@COM_FF = 2 AND IFNULL(MOVDET.DET_CONPAG, "01000") <> "01000") OR (@COM_FV = 2 AND IFNULL(MOVDET.DET_CONPAG, "01000") = "01000")), "FF", "" )), IF(@COM_TR = 2, "TR", ""), IF(@COM_DV = 2, "DV", "")) ');
    qryMargem.SQL.Add('  ) AS TABELA ');
    qryMargem.Open;

    If Not qryMargem.IsEmpty Then
    Begin

      fltValor := qryMargem.FieldByName(fMargem_ou_Markup).AsFloat;

      qryFaixas := fCriaQuery();

      Try

        qryFaixas.Close;
        qryFaixas.SQL.Clear;
        qryFaixas.SQL.Add('SELECT            ');
        qryFaixas.SQL.Add('  MAR.FAI_CODFAI, ');
        qryFaixas.SQL.Add('  MAR.FAI_DESFAI, ');
        qryFaixas.SQL.Add('  PER.FAI_MARINI, ');
        qryFaixas.SQL.Add('  PER.FAI_MARFIN, ');
        qryFaixas.SQL.Add('  PER.FAI_CORFAI  ');
        qryFaixas.SQL.Add('FROM              ');
        qryFaixas.SQL.Add('  FAIMAR MAR      ');
        qryFaixas.SQL.Add('  INNER JOIN FAIPER PER ON (PER.FAI_CODFAI = MAR.FAI_CODFAI) ');
        qryFaixas.SQL.Add('WHERE 1=1');

        qryFaixas.SQL.Add('AND ((SELECT COUNT(*) FROM FAIVEN VEN WHERE VEN.FAI_CODFAI = MAR.FAI_CODFAI AND VEN.FAI_CODVEN = (' + fatVenda.strCodVen.QuotedString + ')) > 0 OR ');
        qryFaixas.SQL.Add('    (SELECT COUNT(*) FROM FAIVEN VEN WHERE VEN.FAI_CODFAI = MAR.FAI_CODFAI) = 0) ');

        qryFaixas.SQL.Add('ORDER BY                         ');
        qryFaixas.SQL.Add('  PER.FAI_CODFAI, PER.FAI_MARINI ');
        qryFaixas.Open;

        If Not qryFaixas.IsEmpty Then
        Begin

          qryFaixas.First;
          While Not qryFaixas.Eof Do
          Begin
            If ((fltValor >= qryFaixas.FieldByName('FAI_MARINI').AsFloat) And (fltValor <= qryFaixas.FieldByName('FAI_MARFIN').AsFloat)) Then
            Begin
              Result := qryFaixas.FieldByName('FAI_CORFAI').AsString;
              recSinaleiro.strMargemMesApuracao          := FormatFloat('#,##0.00', fltValor);
              recSinaleiro.strFaixaEncontradaMesApuracao := qryFaixas.FieldByName('FAI_CODFAI').AsString + '-' +
                                                            qryFaixas.FieldByName('FAI_DESFAI').AsString;
              Exit;
            End;
            qryFaixas.Next;
          End;

        End;

      Finally
        FreeAndNil(qryFaixas);
      End;

    End;

  Finally
    FreeAndNil(qryMargem);
  End;

end;

procedure TfrmFatVendas.pRetornaPeriodoApuracaoSinaleiro(out strDtaIni, strDtaFin: String);
Var
  dteMesAtual,
  dteDtaIniMeta,
  dteDtaFimMeta : TDateTime;
  strDiaFat     : String;
  blnSempreIniciarNoDiaPrimeiro : Boolean;
begin

  dteMesAtual := fRetDataServidor;

  {Dia de corte}
  strDiaFat := fCfgSis('DIASIN', varString);

  blnSempreIniciarNoDiaPrimeiro := False;
  If StrToInt(strDiaFat) > DayOf(EndOfTheMonth(dteMesAtual)) Then
  Begin
    strDiaFat := IntToStr(DayOf(EndOfTheMonth(dteMesAtual)));
    blnSempreIniciarNoDiaPrimeiro := True;
  End;

  If blnSempreIniciarNoDiaPrimeiro Then
    dteDtaIniMeta := StrToDate('01/' + FormatDateTime('mm/yyyy', dteMesAtual))
  Else
  Begin
    dteDtaIniMeta := StrToDate(strDiaFat + '/' + FormatDateTime('mm/yyyy', dteMesAtual));
    dteDtaIniMeta := IncDay(IncMonth(dteDtaIniMeta, -1), 1);
  End;

  dteDtaFimMeta := StrToDate(strDiaFat + '/' + FormatDateTime('mm/yyyy', dteMesAtual));

  strDtaIni := DateToStr(dteDtaIniMeta);
  strDtaFin := DateToStr(dteDtaFimMeta);

end;

procedure TfrmFatVendas.pCarregaCliente;
  Var
    qryConsul : TUniQuery;
    strTabTmp: String;
    strTabSuj: String;
    intcont: Integer;
    strVenCliAux: String;
    strCliCnd: String;
    strCliFpg: String;
    strAuxVen: String;
    i: Integer;
    blnMudouCliente: Boolean;
    strDocQue: string;
    blnMudouCliConsumidor: Boolean;
    blnMostrarObservacaoCliente: Boolean;

  function fEhTravaCliente(strDirAce: String): Boolean;
  begin
    Result := (strDirAce = 'TABCLI') Or //Troca de Tabela de Preço
              (strDirAce = 'TROTAB') Or //Troca de Tabela de Preço
              (strDirAce = 'SENPEM') Or //Transferência de Estoque não permitida para a própria loja
              (strDirAce = 'DEATR' ) Or //Débito em Atraso
              (strDirAce = 'COMPR' ) Or //Senha Nao Compra
              (strDirAce = 'CONCC' ) Or //Senha consulta de crédito - expirou
              (strDirAce = 'SENCND') Or //Senha para alterar a condição de pagamento do cliente sugerida
              (strDirAce = 'LIMCR' ) ;  //Limite de Crédito
  end;

  procedure pRemoveLogAviClienteAnterior;
    Var
      logAvi: TLogAvi;
      arrLogAviTmp: TArrLogAvi;
  begin
    For logAvi In arrLogAvi Do
    Begin
      If Not fEhTravaCliente(logAvi.strDirAce) Then
      Begin
        SetLength(arrLogAviTmp, Length(arrLogAviTmp) + 1);
        arrLogAviTmp[Length(arrLogAviTmp) - 1] := logAvi;
      End;
    End;
    arrLogAvi := arrLogAviTmp;
  end;

  procedure pRemoveLogLibClienteAnterior;
    Var
      logLib: TLogLib;
      arrLogLibTmp: TArrLogLib;
  begin
    For logLib In arrLogLib Do
    Begin
      If Not fEhTravaCliente(logLib.strDirAce) Then
      Begin
        SetLength(arrLogLibTmp, Length(arrLogLibTmp) + 1);
        arrLogLibTmp[Length(arrLogLibTmp) - 1] := logLib;
      End;
    End;
    arrLogLib := arrLogLibTmp;
  end;

  function fPreservarTabelaDePrecoDoPedidoOrcamentoAoTrocarCliente: Boolean;
  begin
    Result := (Not fEmptyStr(strNumOrc)) And
              (Not fEmptyStr(strEspOrc)) And
              (Not blnPrimeiraVez) And
              (Not fEmptyStr(strTabPrePedOrc)) And
              (Pos(strEspOrc, 'OR_PD_') > 0) And
              (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
              (fCfgSis('TRCLTB', varString) = 'S') And
              (fCfgSis('SUGTBP', varString) = 'S') And
              (fCfgSis('UTAPTB', varString) = '0');
  end;
begin
  fatVenda.blnGravaCtrTe := False;
  fatVenda.strCodEmpTe   := '';
  fatVenda.strTipEmiTe   := '';
  fatVenda.strCodForTe   := '';
  fatVenda.strPerEmpTe   := '';
  fatVenda.strCndLib     := '';

  strMultiTabPreAnt := EmptyStr;

  qryConCnd.Close;

  strTabTmp := EmptyStr;

  If fEmptyStr(fatVenda.strTabPre) Then
    fatVenda.strTabPre := '1'
  Else
    strTabTmp := fatVenda.strTabPre;

  If (blnPrimeiraVez) Then
    strTabPrePedOrc := fatVenda.strTabPre;

  If (Not fEmptyStr(fatVenda.strNumOrc)) And ((Not fEmptyStr(fatVenda.strEspOrc))) And (fPermiteSelecionarClienteDeOutroVendedor(fatVenda.strEspOrc)) Then
  Begin
    blnInformouClienteDeOutroVendedor := True;
    blnValidaVendedorDoCliente := False;
  End;

  pPesquisaCadCli(qryConCli, qryConCli, edtCodCli.Text, True, IIF((Pos(strOpcDoc, 'OR_PD_VN_') > 0), blnValidaVendedorDoCliente, False), EmptyStr, strOpcDoc);
  With qryConCli Do
  Begin

    If (fUtilizaEmpresaPrioridadeEstoque) Then
      pCarregarEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque(FieldbyName('CLI_CODCLI').AsString);

    fatVenda.strUsaQue := 'N';
    fatVenda.strDocQue := '';
    mnuQuestFidelidade.Visible := False;

    if (fCfgSis('PONQUE', varBoolean)) and (strOpcDoc = 'PD') then
    begin
      If fEmptyStr(strNumOrc) Then
      Begin
        If fMensagem('', 'Utilizar Quest Fidelidade?', ['&Sim', '&Não'], 2) = 1 Then
        Begin
          fatVenda.strUsaQue := fPesquisaQuestFidelidade(FieldbyName('CLI_C_G_C_').AsString, FieldbyName('CLI_NOMCLI').AsString, strDocQue);
          fatVenda.strDocQue := strDocQue;
        End;
      End
      Else
      Begin
        mnuQuestFidelidade.Visible := True;
        mnuQuestFidelidade.Caption := IIF(fBuscaInformacaoEstornoQuest(strNumOrc, strEspOrc, VS_strCodEmp), 'Cancelar', 'Utilizar') + ' Quest Fidelidade';
      End;
    end;

    blnMudouCliConsumidor := (fClienteConsumidor(FieldbyName('CLI_NOMCLI').AsString)) And
                             (Assigned(qryFatGor)) And
                             (Not fClienteConsumidor(qryFatGor.FieldByName('FGO_NOMCON').AsString)) And
                             (Not fEmptyStr(qryFatGor.FieldByName('FGO_NOMCON').AsString));

    If blnMudouCliConsumidor Then
      edtNomCli.Text := qryFatGor.FieldByName('FGO_NOMCON').AsString
    else
      edtNomCli.Text  := FieldbyName('CLI_NOMCLI').AsString;
    If (fCfgSis('USATPC') = 'S') And (Not fatVenda.fDocumentoParaFornecedor) And (Pos(strOpcDoc, 'OE_EF_') <= 0) Then
      pCarregaFormasPagto(edtCodCli.Text, stlForPag, stlCndPag);

    strFpgLib := '';

    If (Not IsEmpty) Then
    Begin
      If fEmptyStr(strNumOrc) And (Pos(strOpcDoc, 'OR_PD_VN_CS_TE_') > 0) Then
      Begin
        fatVenda.strMen001 := FieldByName('CLI_MSGPED').AsString;
        fatVenda.strMen002 := FieldByName('CLI_MSGPE2').AsString;
      End;

      fatVenda.blnPermFF := ((FieldByName('CLI_PERMFF').AsString = 'S') Or (FieldByName('CLI_PERMFV').AsString = 'S'));

      fatVenda.strStReEs := FieldByName('CLI_STREES').AsString;
      fatVenda.strPrStRe := FieldByName('CLI_PRSTRE').AsString;

      fatVenda.blnClienteEmCampanha := fatVenda.objCamGer.fVerificaClienteCampanha(FieldByName('CLI_CODCLI').AsString);

      If cbbComInd.Visible And (fatVenda.strCodCli <> FieldByName('CLI_CODCLI').AsString) Then
      Begin
        fatVenda.strIndCom := FieldByName('CLI_INDCOM').AsString;
        pSetaComboComercializacaoIndustrializacao;
      End;

      blnMudouCliente := ((Not fEmptyStr(fatVenda.strCodCli)) And (fatVenda.strCodCli <> FieldByName('CLI_CODCLI').AsString));

      If (fEmptyStr(fatVenda.strCodCli))                            Or
         (fatVenda.strCodCli <> FieldByName('CLI_CODCLI').AsString) Or
         (Not fEmptyStr(strNumOrc))                                 Then
      Begin
        {*******************************************************************************}
        {* QUANDO O CLIENTE É CARREGADO É NECESSÁRIO ZERAR AS TRAVAS, POIS SE EM ALGUM *}
        {* MOMENTO TROCAR O CLIENTE PODE FICAR TRAVAS DO CLIENTE ANTERIOR              *}
        {************************************************************************RN,JC**}
        blnLibCan := False;

        pRemoveLogLibClienteAnterior;
        pRemoveLogAviClienteAnterior;

        fatVenda.strCodCli := FieldByName('CLI_CODCLI').AsString;                   // Cliente - Codigo
        If blnMudouCliConsumidor Then
          fatVenda.strCliNom := qryFatGor.FieldByName('FGO_NOMCON').AsString                   //         - Nome
        Else
          fatVenda.strCliNom := FieldByName('CLI_NOMCLI').AsString;                   //         - Nome
        fatVenda.strCliOri := FieldByName('CLI_NOMCLI').AsString;                   //         - Nome Original

        fatVenda.strCliNum := FieldByName('CLI_ENDNUM').AsString;                   //         - Numero
        fatVenda.strCliCom := FieldByName('CLI_ENDCOM').AsString;                   //         - Complemento
        fatVenda.strCliEnd := FieldByName('CLI_ENDERE').AsString + ', ' +
                              FieldByName('CLI_ENDNUM').AsString + '  ' +           //         - Endereco
                              FieldByName('CLI_ENDCOM').AsString;

        fatVenda.strCliBai := FieldByName('CLI_BAIRRO').AsString;                   //         - Bairro
        fatVenda.strCliCep := FieldByName('CLI_C_E_P_').AsString;                   //         - Cep
        fatVenda.strCodCid := FieldByName('CLI_CODCID').AsString;                   //         - Cód. Cidade
        fatVenda.strCliTel := FieldByName('CLI_FONE01').AsString;                   //         - Telefone
        fatVenda.strCliCel := FieldByName('CLI_CELULA').AsString;
        fatVenda.strCliEma := FieldByName('CLI_EMAIL3').AsString;                   //         - Email NFe
        fatVenda.strCliEm2 := FieldByName('CLI_EMAIL2').AsString;                   //         - Email 2
        fatVenda.strCluFid := FieldByName('CLI_CLUFID').AsString;                   //         - Clube Fidelidade
        fatVenda.strCliFid := FieldByName('CLI_CLIFID').AsString;                   //         - Cliente Fidelidade
        fatVenda.fltPtoFid := 0;                                                    //         - Pontos da Venda
        fatVenda.fltSldFid := 0;                                                    //         - Saldo de Pontos do Clube Fidelidade

        {Quando J_A_MASSA_CONCRETO, será informado Obra e ART na tela de "frmFatDigDadosConcreto"}
        If (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO) Then
        Begin
          fatVenda.strCodObr := FieldByName('CLI_CODOBR').AsString;                 //         - Código Obra (Serviço)
          fatVenda.strCodArt := FieldByName('CLI_CODART').AsString;                 //         - Código Art. (Serviço)
          fatVenda.strCodCno := FieldByName('CLI_CODCNO').AsString;                 //         - Código CNO. (Serviço)
          fatVenda.strInsImo := FieldByName('CLI_INSIMO').AsString;                 //         - Inscr.Imobiliaria. (Serviço)
          fatVenda.strCodCib := FieldByName('CLI_CODCIB').AsString;                 //         - Código CIB. (Serviço)
        End;

        fatVenda.strCliFax := FieldByName('CLI_F_A_X_').AsString;                   //         - Fax
        {*******************************************}
        {* CARREGA O NOME E O ESTADO DA CIDADE     *}
        {****************************************MV*}
        fatVenda.strCliCid := fRetNomCidade(fatVenda.strCodCid);    // - Cidade
        fatVenda.strCliEst := fRetNomCidade(fatVenda.strCodCid, 1); // - Estado

        fatVenda.strCliAti := FieldByName('CLI_CODATI').AsString;                   //         - Atividade        fatVenda.blnConstr := (fAtividadeConstrutora(FieldByName('CLI_CODATI').AsString)); // Cliente construtora ????
        fatVenda.strCli_Rg := FieldByName('CLI_NUMR_G').AsString;                   //         - RG

        If (strOPcDoc = 'DV') And fCfgSis('CPFSDV', VarBoolean) And Not fEmptyStr(FieldByName('CLI_CPFDEV').AsString) Then
          fatVenda.strCliCgc := FieldByName('CLI_CPFDEV').AsString                  //         - CPF SOMENTE DEVOLUCAO
        Else
          fatVenda.strCliCgc := FieldByName('CLI_C_G_C_').AsString;                 //         - CNPJ

        blnMostrarObservacaoCliente := True;
        if (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) then
          blnMostrarObservacaoCliente := fCfgSis('EXBOBS', varBoolean);

        if blnMostrarObservacaoCliente then
          fatVenda.strObserv := FieldByName('CLI_OBSERV').AsString;                 //         - Observações

        fatVenda.strCliDAc := FieldByName('CLI_CODEAC').AsString;                   //         - Cobrar despesas acessórias do cliente

        fatVenda.strRegFis := FieldByName('CLI_REGFIS').AsString;                   //         - Calcular as regras fiscais ( CFOP e impostos ) considerando endereço de entrega

        fatVenda.strDesoST := FieldByName('CLI_DESOST').AsString;
        fatVenda.strDesoMT := FieldByName('CLI_DESOMT').AsString;
        fatVenda.strNatSer := FieldByName('CLI_NATSER').AsString;

        {*****************************************}
        {* SETA A VARIAVEL CLIENTE FILIAL        *}
        {**************************************MV*}
        fatVenda.blnCliFil := fatVenda.fClienteFilialVenda(qryConCli.FieldByName('CLI_CODCLI').AsString);
        fatVenda.fltFat_TE := fatVenda.recDadCli.fltFat_TE;
        fatVenda.fltFatTE2 := fatVenda.recDadCli.fltFatTE2;
        fatVenda.strTEPREV := fatVenda.recDadCli.strTEPREV;
        fatVenda.strTEPPRO := fatVenda.recDadCli.strTEPPRO;

        If fatVenda.fCarregaValorBrutoParaAplicarDescontoProfissional Then
          fatVenda.fltDescProfissional := fRetDescontoCliente(fatVenda.strCliFat)
        Else
          fatVenda.fltDescProfissional := fRetDescontoCliente(fatVenda.strCodCli);

        fatVenda.fltDescFidelidade   := fRetDescontoFidelidade(fatVenda.strCodCli);

        fatVenda.strCodAti := FieldByName('CLI_CODATI').AsString;
        fatVenda.strNomAti := fRetAtividade(fatVenda.strCodAti);
        fatVenda.strCodCac := FieldByName('CLI_CODCAC').AsString;
        fatVenda.strDesCac := fRetNomCanalAcesso(fatVenda.strCodCac);

        pnlInfo.Caption := '';
        pInformacoesClienteRodape;

        {**************************}
        {* DADOS DE ENTREGA       *}
        {***********************MV*}
        If (Not fEmptyStr(strNumOrc)) And (Assigned(qryFatGor)) and ((qryFatGor.FieldByName('FGO_CODCLI').AsString = FieldByName('CLI_CODCLI').AsString)) Then
          fatVenda.pCarregaEnderecoEntrega(fatVenda, 'FATGOR', qryFatGor.FieldByName('AUTOINCREM').AsString)
        Else
          fatVenda.pCarregaEnderecoEntrega(fatVenda, '', '', IIF(fCfgSis('NVORPD',varBoolean) And (Pos(strOpcDoc, 'PD_OR') > 0), True, False));

        {***************************}
        {* DADOS DE COBRANÇA       *}
        {***********************MV**}
        fatVenda.strEndCob := FieldByName('CLI_ENDCOB').AsString;
        fatVenda.strBaiCob := FieldByName('CLI_BAICOB').AsString;
        fatVenda.strCepCob := FieldByName('CLI_CEPCOB').AsString;
        fatVenda.strCidCob := fRetNomCidade(FieldByName('CLI_CIDCOB').AsString);
        fatVenda.strEstCob := fRetNomCidade(FieldByName('CLI_CIDCOB').AsString, 1);

        fatVenda.strDif_ST := FieldByName('CLI_DIF_ST').AsString;
        fatVenda.strSitP_C := FieldByName('CLI_SITP_C').AsString;
        fatVenda.strSitPCP := FieldByName('CLI_SITPCP').AsString;
        fatVenda.strMenP_C := FieldByName('CLI_MENP_C').AsString;
        fatVenda.strDiferi := FieldByName('CLI_DIFERI').AsString;
        fatVenda.fltRedIcmsCli := FieldByName('CLI_REDICM').AsFloat;
        fatVenda.strCliAti := FieldByName('CLI_CODATI').AsString;

        fatVenda.pProcessarDespesasOperacionaisComplementar(FieldByName('CLI_DESOPE').AsFloat);

        If (
              (Pos(strOpcDoc,'OU_OV_OF_BR_TE_NC_DV_PR_OE_EF_CO_UC_DD_') <= 0) Or
              ( (strOpcDoc = 'OU') And (blnConEqu) ) Or
              ( (strOpcDoc = 'TE') And (fCfgSis('CCNDTE', varBoolean)) )
           ) And
           (fEmptyStr(strNumOrc) Or
            IIF(fCfgSis('USACND', VarBoolean),
               (Not fEmptyStr(FieldByName('CND_CODCND').AsString)) And (Not fEmptyStr(strCliAnt)) And (strCliAnt <> edtCodCli.Text),
               (Not fEmptyStr(FieldByName('CND_CNDPAG').AsString)) And (Not fEmptyStr(strCliAnt)) And (strCliAnt <> edtCodCli.Text))) And
           (Not fEhMeiaNotaPorDocumento) Then
        Begin

          {************************************}
          {* SE USA CADCND                    *}
          {*********************************AF*}
          If (fCfgSis('USACND', varBoolean)) Then
          Begin
            strCliCnd := '';

            If (Pos(strOpcDoc,'OR_PD_VN_') > 0) Then
            Begin
              If (fEmptyStr(edtCodCnd.Text)) Then
                strCliCnd := fCfgSis('CNDINI');

              If (fEmptyStr(strCliCnd)) And (fCfgSis('CNDVEN') = 'F') And
                 (fTrocouClienteSemDocumentoGravado(FieldByName('CLI_CODCLI').AsString)) Then
                strCliCnd := fCfgSis('CNDINI');
            End;

            If fEmptyStr(strCliCnd) Then
              strCliCnd := FieldByName('CND_CODCND').AsString;

            If fatVenda.fEhVendaRapida(fatVenda.strCodCli) And
              (Not fEmptyStr(fatVenda.fRetCondicaoPagtoVendaRapida)) And
              fEmptyStr(strNumOrc) Then
              strCliCnd := fatVenda.fRetCondicaoPagtoVendaRapida;

            If (Not fEmptyStr(fCfgSis('CNDINI'))) And (fEmptyStr(strCliCnd)) And (Not fEmptyStr(edtCodCnd.Text)) Then
              strCliCnd := edtCodCnd.Text;

            If (strOpcDoc = 'EP') Then
            Begin
              edtCodCnd.Text     := '';
              mskCndPag.Text     := fCndEmp;
              edtDesCndPag.Text  := '';
              fatVenda.strConPag := fCndEmp;
              fatVenda.strDesCnd := '';
              strCndSug          := edtCodCnd.Text;
            End

            Else If (fatVenda.strOpcDoc <> 'CS') Or ((fatVenda.strOpcDoc = 'CS') And
                                                     (fStatusCndPag(fRetConPagCodCnd(strCliCnd)) = A_VISTA)) Then
            Begin
              edtCodCnd.Text     := strCliCnd;
              mskCndPag.Text     := fRetConPagCodCnd(strCliCnd);
              edtDesCndPag.Text  := fRetDesConPag(strCliCnd);
              fatVenda.strDesCnd := fRetDesConPag(strCliCnd);
              fatVenda.strConPag := fRetConPagCodCnd(strCliCnd);
              strCndSug          := edtCodCnd.Text;

              If Not fEmptyStr(edtCodCnd.Text) Then
              Begin
                fValidaCampos(edtCodCnd, False);
                blnValidaCnd := False;
              End
              Else
                strCcnAnt := '';

            End;

          End
          Else
          Begin
            If (strOpcDoc = 'EP') Then
            Begin
              mskCndPag.Text     := fCndEmp;
              fatVenda.strConPag := fCndEmp;
            End
            Else
            Begin
              mskCndPag.Text     := FieldByName('CND_CNDPAG').AsString;
              fatVenda.strConPag := FieldByName('CND_CNDPAG').AsString;
            End;
            If ((fatVenda.strOpcDoc = 'CS') And
               (fStatusCndPag(FieldByName('CND_CNDPAG').AsString) = A_VISTA)) Or
               (fatVenda.strOpcDoc <> 'CS') Then
            Begin
              mskCndPag.Text     := FieldByName('CND_CNDPAG').AsString;
              fatVenda.strConPag := FieldByName('CND_CNDPAG').AsString;
            End;
          End;

          {************************************}
          {* SE CND PAG ESTIVER NO FINAL      *}
          {*********************************AF*}
          If (fCfgSis('CNDVEN') = 'F') Then
          Begin
            If (strOpcDoc = 'EP') Then
              fatVenda.strConPag := fCndEmp
            Else If Not fEmptyStr(FieldByName('CND_CNDPAG').AsString) Then
              fatVenda.strConPag := FieldByName('CND_CNDPAG').AsString;

            If (strOpcDoc = 'EP') Then
            Begin
              fatVenda.strCodCnd := '';
              fatVenda.strDesCnd := '';
              edtCodCnd.Text     := fatVenda.strCodCnd;
              pCarregaCondicao;
            End
            Else If Not fEmptyStr(strCliCnd) Then
            Begin
              fatVenda.strCodCnd := strCliCnd;
              fatVenda.strDesCnd := fRetDesConPag(strCliCnd);
              edtCodCnd.Text     := fatVenda.strCodCnd;
              If Pos(strOpcDoc, 'OR_PD_VN_') > 0 Then
                pCarregaCondicao(False, False)
              Else
                pCarregaCondicao;
            End;

            If ((fatVenda.strOpcDoc = 'CS') And
               (fStatusCndPag(FieldByName('CND_CNDPAG').AsString) = A_VISTA)) Or
               (fatVenda.strOpcDoc <> 'CS') Then
            Begin
              If Not fEmptyStr(FieldByName('CND_CNDPAG').AsString) Then
                fatVenda.strConPag := FieldByName('CND_CNDPAG').AsString;

              If Not fEmptyStr(strCliCnd) Then
              Begin
                fatVenda.strCodCnd := strCliCnd;
                fatVenda.strDesCnd := fRetDesConPag(strCliCnd);
                edtCodCnd.Text     := fatVenda.strCodCnd;
                If Pos(strOpcDoc, 'OR_PD_VN_') > 0 Then
                  pCarregaCondicao(False, False)
                Else
                  pCarregaCondicao;
              End;
            End;
          End;

          {************************************}
          {* SE TIVER CONFIGURADO PARA FORMA  *}
          {* DE PAGAMENTO                     *}
          {*********************************AF*}
          If (fatVenda.VS_blnUsaFpg) Then
          Begin
            If(Pos(strOpcDoc,'EP_') > 0) Then
            Begin
              fatVenda.strCodFpg := IIF(fCndEmp = '01000', '001', '008');
              edtForPag.Text     := EmptyStr;
            End
            Else
            Begin
              strCliFpg := FieldByName('CLI_CODFPG').AsString;

              If fatVenda.fEhVendaRapida(fatVenda.strCodCli) And Not fEmptyStr(fatVenda.fRetFormaPagtoVendaRapida) Then
                strCliFpg := fatVenda.fRetFormaPagtoVendaRapida;

              fatVenda.strCodFpg := strCliFpg;

              If fCfgSis('CNDVEN') <> 'F' Then
              Begin
                edtForPag.Text    := strCliFpg;
                edtDesForPag.Text := fRetDesFpg(strCliFpg);
              End;
            End;
          End;
        End;

        If (Not blnTrocandoClienteDV) Then
        Begin
          If (fCfgSis('USADIG', varBoolean)) And (Pos(strOpcDoc,'CO_') <= 0) Then
          Begin
            If fEmptyStr(strNumOrc) And fCfgSis('MLTOPE', varBoolean) Then
            Begin
              strVenCliAux := fPesquisaCliVendedores(FieldByName('CLI_CODCLI').AsString);
            End
            Else
            Begin
              If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fEmptyStr(strNumOrc)) And (Assigned(qryFatGor)) and ((qryFatGor.FieldByName('FGO_CODCLI').AsString = FieldByName('CLI_CODCLI').AsString)) Then
                strVenCliAux := qryFatGor.FieldByName('FGO_CODVEN').AsString;
            End;

            {******************************************}
            {* SÓ TROCA DE VENDEDOR CASO HAJA MAIS DE *}
            {* UM VENDEDOR SELECIONADO NOS DOCUMENTOS *}
            {***************************************RV*}
            If (Length(arrCodVen) > 0) And (Pos(strOpcDoc,'DV_PR_DD_') > 0) Then
            Begin
              strAuxVen := '';
              For i := 0 To Length(arrCodVen) - 1 Do
              Begin
                If (strAuxVen <> '') And (strAuxVen <> arrCodVen[i]) Then
                Begin
                  If fEmptyStr(strVenCliAux) Then
                    strVenCliAux := qryConCli.FieldByName('CLI_CODVEN').AsString;
                  Break;
                End;
                strAuxVen := arrCodVen[i];
              End;
            End;

            If fEmptyStr(strVenCliAux) Then
              strVenCliAux := qryConCli.FieldByName('CLI_CODVEN').AsString;

            edtSenVen.Text := strVenCliAux;
            edtNomVen.Text := fRetNomVendRep(edtSenVen.Text);

            If (Pos(strOpcDoc, 'PD_OR_') > 0) And (Not fEmptyStr(strNumOrc)) And (Not fEmptyStr(strVenAnt)) And (Not fEmptyStr(strVenCliAux)) And (strVenCliAux <> strVenAnt) Then
              fValidaCampos(edtSenVen, True);
          End;

          If fEmptyStr(strVenCliAux) Then
            strVenCli := qryConCli.FieldByName('CLI_CODVEN').AsString
          Else
            strVenCli := strVenCliAux;
          If fEmptyStr(strNumOrc) Or (fEmptyStr(strVenAnt) And fCfgSis('USADIG', varBoolean)) Then
            strVenAnt := strVenCli;
        End;

        If fEmptyStr(FieldByName('CLI_CGCCPF').AsString) Then
          fatVenda.intCgcCpf := 0
        Else
          fatVenda.intCgcCpf := FieldByName('CLI_CGCCPF').AsInteger;                //         - CGC/CPF

        lblUtiNps.Visible := (blnUtiNps) And (fatVenda.intCgcCpf = 2);

        fatVenda.strCliIes := FieldByName('CLI_I_E_S_').AsString;                   //         - Ins.Estadual
        fatVenda.strCliImp := FieldByName('CLI_I_M_P_').AsString;                   //         - Insc. Municipal Produtor
        fatVenda.strProRur := FieldByName('CLI_PRORUR').AsString;                   //         - Produtor Rural
        fatVenda.strMicEmp := FieldByName('CLI_MICEMP').AsString;                   //         - MEI-Micro Empreendedor Individual
        fatVenda.strCliOrg := FieldByName('CLI_ORGPUB').AsString;                   //         - Orgao Publico
        fatVenda.strOrgFde := FieldByName('CLI_ORGFDE').AsString;                   //         - Orgao Publico de fora do estado
        fatVenda.strDesPis := FieldByName('CLI_DESPIS').AsString;                   //         - Orgao Publico
        fatVenda.strZonFra := FieldByName('CLI_ZONFRA').AsString;                   //         - Zona Franca de Manaus
        fatVenda.strDesZon := FieldByName('CLI_DESZON').AsString;                   //         - Desconto Especial para Cliente Zona Franca
        fatVenda.strCodZfm := FieldByName('CLI_SUFRAM').AsString;                   //         - Código Sufram
        fatVenda.blnCliExportacaoIndireta := fEhExportacaoIndireta(FieldByName('CLI_EXPIND').AsString, fatVenda.strTipOpe);//       - Cliente Exportação Indireta
        fatVenda.strCodReg := FieldByName('CLI_CODREG').AsString;                   //         - Código da Região
        fatVenda.strDesReg := fRetDesRegiao(FieldByName('CLI_CODREG').AsString);    //         - Descrição da Região
        fatVenda.strCliCon := FieldByName('CLI_CONSUM').AsString;                   //         - Consumidor Final (S/N)
        fatVenda.strCliOrgDifal := FieldByName('CLI_ORPUDF').AsString;              //         - Gera Difal para Orgao Publico

        If fCfgSis('USOREV', VarBoolean) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
        Begin
          If blnMudouCliente Then
            fatVenda.strTpOper := '';

          pSetaComboOperacaoUsoConsumoRevenda;

          If (blnMudouCliente) And (Not fGridVendaVazio) Then
            pRecalculaImpostos;

          If (Not fEmptyStr(strNumOrc)) And (Assigned(qryFatGor)) Then
          Begin
            If (qryFatGor.FindField('FGO_CONSUM') <> Nil) Then
            Begin
              If (Not fEmptyStr(qryFatGor.FieldByName('FGO_CONSUM').AsString)) Then
                fatVenda.strCliCon := qryFatGor.FieldByName('FGO_CONSUM').AsString;
            End;

            If (qryFatGor.FindField('FGO_TPOPER') <> Nil) Then
            Begin
              If (Not fEmptyStr(qryFatGor.FieldByName('FGO_TPOPER').AsString)) Then
                fatVenda.strTpOper := qryFatGor.FieldByName('FGO_TPOPER').AsString;
            End;

            pSetaComboOperacaoUsoConsumoRevenda;
            fatVenda.pRedefineTipoAbf;
          End;

        End;

        fatVenda.strCodRep := FieldbyName('CLI_CODREP').AsString;                   //         - Código do Representante
        fatVenda.strNomRep := fRetNomVendRep(FieldbyName('CLI_CODREP').AsString);   //         - Nome do Representante

        if (fCfgSis('SIMPAU', varBoolean) and fCfgSis('RETIMP', varBoolean)) then
        begin
          fatVenda.strRetPCo := 'N';                                                   //         - Retenção de Pis e Cofins
          fatVenda.strRetIrf := 'N';                                                   //         - Retenção de IRPF
          fatVenda.strCDesPI := 'N';                                                   //         - Retenção de Pis e Cofins
        end
        else
        begin
          fatVenda.strRetPCo := FieldbyName('CLI_RETPCO').AsString;                   //         - Retenção de Pis e Cofins
          fatVenda.strRetIrf := FieldbyName('CLI_RETIRF').AsString;                   //         - Retenção de IRPF
          fatVenda.strCDesPI := FieldbyName('CLI_CDESPI').AsString;                   //         - Retenção de Pis e Cofins
        end;

        fatVenda.strSitIPI := FieldByName('CLI_SITIPI').AsString;                   //         - Situação do IPI
        fatVenda.strEnqIPI := FieldByName('CLI_ENQIPI').AsString;                   //         - Enquadramento do IPI
        fatVenda.strMenIPI := FieldByName('CLI_MENIPI').AsString;                   //         - Mensagem do IPI
        fatVenda.strRetIss := FieldbyName('CLI_RETISS').AsString;                   //         - Retenção de ISS
        fatVenda.strOrPuRD := FieldbyName('CLI_ORPURD').AsString;                   //         - Tipo de Desconto (Rateio / Desconto)
        fatVenda.strCalIcm := FieldbyName('CLI_CALICM').AsString;                   //         - Calcula Desconto de ICMS (Orgão Public)
        fatVenda.fltRedIss := FieldbyName('CLI_REDISS').AsFloat;                    //         - Aliquota de ISS do Cliente (Prestcon)
        fatVenda.strCobIss := FieldbyName('CLI_COBISS').AsString;                   //         - Cobrar Iss sobre (T)otal da Nota ou Total dos (S)erviços (Prestcon)
        fatVenda.strSegSoc := FieldbyName('CLI_SEGSOC').AsString;                   //         - Seguridade Social

        fatVenda.strPerEmp := FieldByName('CLI_PEREMP').AsString;                   //         - Permite Emprestimo
        fatVenda.strCliPer := FieldByName('CLI_PERMUT').AsString;

        fatVenda.strCalIcm :=
          TFunctionFuncoesFaturamento.
            ValidarDescontoDeICMSOrgaoPublico(strOpcDoc,fatVenda.strCalIcm);

        If Pos(strOpcDoc,'CF_NC_DV_PR_CI_CN_CT_CP_OV_CO_DD_ER_') <= 0 Then
        Begin

          (****************************************************************)
          (****                   ALERTA IMPORTANTE                  ******)
          (* QUANDO ALTERAR AS REGRAS PARA A SUGESTAO DA TABELA DE PREÇO  *)
          (* ALTERAR TAMBEM A FUNÇÃO untRelGeraOr.fRetTabelaPreco        *)
          (*************************************************************LA*)
          strTabPre := '';
          cbTabPreco.Clear;

          If (fCfgSis('UTAPTB') <> '0') Then
            fatVenda.strTabPre := fCfgSis('UTAPTB')
          Else If fCfgSis('SUGTBP', varBoolean) Then
          Begin
            edtNomCli.Width := 513;
            lblTabPreco.Visible := True;
            cbTabPreco.Visible  := True;
            cbTabPreco.Text     := '1';
            strTabPre           := '1';

            strTabSuj := fCfgSis('TBPSUG');

            If strTabSuj <> '0' Then
            Begin
              strTabPre := strTabSuj;
              cbTabPreco.Text := strTabSuj;
              fatVenda.strTabPre := cbTabPreco.Text;
              cbTabPreco.Items.Add(strTabSuj);

              For intcont := 1 To Length(VS_strTabVen) Do
              Begin

                If (VS_strTabVen[intcont] = 'S') And (StrToInt(strTabSuj) <> intcont) Then
                Begin
                  cbTabPreco.Items.Add(IntToStr(intcont));
                  strTabPre := strTabPre + '_' + IntToStr(intcont);
                End;

              End;

            End

            Else If fEmptyStr(fTabelaPrecoClienteOuVendedor) Then
            Begin

              If (fCfgSis('TPRFAT', varBoolean)) And fRegredirTabelaDePrecoDoItem Then
                pCarregarTabelasDePrecoDoItem;

              If (fEmptyStr(fCfgSis('TBPRPD', varString))) Then
              Begin
                cbTabPreco.Items.Add('1');
                strTabPre  := '1';
                fatVenda.strTabPre := '1';
              End
              Else
              Begin
                strTabSuj          := fCfgSis('TBPRPD', varString);
                strTabPre          := strTabSuj;
                cbTabPreco.Text    := strTabSuj;
                fatVenda.strTabPre := cbTabPreco.Text;
                cbTabPreco.Items.Add(strTabSuj);

                For intcont := 1 To Length(VS_strTabVen) Do
                Begin
                  If (VS_strTabVen[intcont] = 'S') And (StrToInt(strTabSuj) <> intcont) Then
                  Begin
                    cbTabPreco.Items.Add(IntToStr(intcont));
                    strTabPre := strTabPre + '_' + IntToStr(intcont);
                  End;

                End;
              End;

            End
            Else
            Begin

              strTabPreCli       := fTabelaPrecoClienteOuVendedor;
              fatVenda.strTabPre := fTabelaPrecoClienteOuVendedor;
              cbTabPreco.Items.Add(fTabelaPrecoClienteOuVendedor);
              cbTabPreco.Text    := fTabelaPrecoClienteOuVendedor;
              strTabPre          := fTabelaPrecoClienteOuVendedor;

              If fCfgSis('REGTBP', varBoolean) Then
              Begin
                If fRegredirTabelaDePrecoDoItem Then
                Begin
                  cbTabPrecoItem.Clear;
                  cbTabPrecoItem.Items.Add(fTabelaPrecoClienteOuVendedor);
                End;
                For intcont := 1 To Length(VS_strTabVen) Do
                Begin
                  If (VS_strTabVen[intcont] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) > intcont) Then
                  Begin
                    cbTabPreco.Items.Add(intcont.ToString);
                    strTabPre := strTabPre + '_' + intcont.ToString;
                    If fRegredirTabelaDePrecoDoItem Then
                      cbTabPrecoItem.Items.Add(intcont.ToString);
                  End;
                End;
              End
              Else
              Begin
                If (VS_strTabVen[1] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 1) Then
                Begin
                  cbTabPreco.Items.Add('1');
                  strTabPre := strTabPre + '_1';
                End;

                If (VS_strTabVen[2] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 2) Then
                Begin
                  cbTabPreco.Items.Add('2');
                  strTabPre := strTabPre + '_2';
                End;

                If (VS_strTabVen[3] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 3) Then
                Begin
                  cbTabPreco.Items.Add('3');
                  strTabPre := strTabPre + '_3';
                End;

                If (VS_strTabVen[4] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 4) Then
                Begin
                  cbTabPreco.Items.Add('4');
                  strTabPre := strTabPre + '_4';
                End;

                If (VS_strTabVen[5] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 5) Then
                Begin
                  cbTabPreco.Items.Add('5');
                  strTabPre := strTabPre + '_5';
                End;

                If (VS_strTabVen[6] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 6) Then
                Begin
                  cbTabPreco.Items.Add('6');
                  strTabPre := strTabPre + '_6';
                End;

                If (VS_strTabVen[7] = 'S') And (strToIntDef(fTabelaPrecoClienteOuVendedor, 0) <> 7) Then
                Begin
                  cbTabPreco.Items.Add('7');
                  strTabPre := strTabPre + '_7';
                End;

              End;

            End;

          End
          Else
          Begin

            If fEmptyStr(fTabelaPrecoClienteOuVendedor) Then
            Begin

              {***********************************************************}
              {* VERIFICA SE EXISTE A TABELA DE PREÇO PADRÃO CONFIGURADA *}
              {********************************************************PZ*}
              If (fEmptyStr(fCfgSisL('TBPRPD', varString))) Then
              Begin

                edtNomCli.Width := 513;

                If Not cbTabPreco.Visible Then
                Begin
                  If copy(VS_strTabVen,1,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('1');
                    strTabPre := strTabPre + '_1';
                  End;
                  If copy(VS_strTabVen,2,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('2');
                    strTabPre := strTabPre + '_2';
                  End;
                  If copy(VS_strTabVen,3,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('3');
                    strTabPre := strTabPre + '_3';
                  End;
                  If copy(VS_strTabVen,4,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('4');
                    strTabPre := strTabPre + '_4';
                  End;
                  If copy(VS_strTabVen,5,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('5');
                    strTabPre := strTabPre + '_5';
                  End;
                  If copy(VS_strTabVen,6,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('6');
                    strTabPre := strTabPre + '_6';
                  End;
                  If copy(VS_strTabVen,7,1) = 'S' Then
                  Begin
                    cbTabPreco.Items.Add('7');
                    strTabPre := strTabPre + '_7';
                  End;

                End;

                lblTabPreco.Visible := True;
                cbTabPreco.Visible  := True;
              End
              Else
                fatVenda.strTabPre := fCfgSisL('TBPRPD');
            End
            Else
            Begin
              fatVenda.strTabPre := fTabelaPrecoClienteOuVendedor;                 //         - Tabela de Preco
              strTabPreCli       := fTabelaPrecoClienteOuVendedor;
            End;

          End;

          If (fPreservarTabelaDePrecoDoPedidoOrcamentoAoTrocarCliente) Then
          Begin
            fatVenda.strTabPre := strTabPrePedOrc;
            cbTabPreco.Text := strTabPrePedOrc;

            If (Not strTabPre.Contains(strTabPrePedOrc)) Then
            Begin
              cbTabPreco.Items.Add(strTabPrePedOrc);
              If fEmptyStr(strTabPre) Then
                strTabPre := strTabPrePedOrc
              Else
                strTabPre := strTabPre + '_' + strTabPrePedOrc;
            End;
          End;

          if (blnAtualizaTabPreCnd) and (blnChamouTelaTabelaPreco) and (Length(strMultiTabPreAtu) =1) then
          begin
            cbTabPreco.Text := strMultiTabPreAtu;
            strTabPre := strMultiTabPreAtu;
            fatVenda.strTabPre := strMultiTabPreAtu
          end;

        End;

        fatVenda.pCarregaAliquotasRetencao;

        If (((Pos(strOpcDoc,'OU_OV_') > 0) And fatVenda.blnCliFil) Or (strOpcDoc = 'MF')) Or
           (((strOpcDoc = 'CO') And (fCfgSis('CNDESP', varInteger) = 1))) Then
        Begin
          mskCndPag.Text     := '01000';
          fatVenda.strConPag := '01000';
        End;

        If (fCfgSis('USADIG', varBoolean)) Then
          pCarregaVendedor;

        //Se nao usar condicao de pagamento deve deixar editar a forma de pagamento
        If Not fCfgSis('USACND', varBoolean) and (fatVenda.VS_blnUsaFpg) Then
          edtForPag.ReadOnly := False
        Else
        Begin
          //Se a condicao de pagamento nao tiver uma forma de pagto vinculada deve deixar editar a forma de pagamento
          If qryConCnd.Active And fEmptyStr(qryConCnd.FieldByName('CND_CODFPG').AsString) and (fatVenda.VS_blnUsaFpg) Then
            edtForPag.ReadOnly := False
          Else
            edtForPag.ReadOnly := True;
        End;

        If Not fatVenda.fPermiteAlterarCondFormaPagtoPedido Then
          edtForPag.ReadOnly := True;

        pVerificaBtnNotEnt;

        pInformaSenhaAutomaticaVendedorNoFaturamento(strLoginUsuarioLogado, IIF(fCfgSis('USADIG', varBoolean), edtSenDig, edtSenVen));
      End;

    End;

  End;

  If (Pos(strOpcDoc, 'OR_PD_VN_CP_CF_OV_CI_NE_BR_') > 0) Then
    pHabilitaChkVendaPresencial
  Else
  Begin
    chkVenPre.Visible := False;
    chkVenPre.Enabled := False;
    chkVenPre.Checked := False;

    chkVenPreClick(chkVenPre);
  End;

  pHabilitarFatTot();

  If (fatVenda.blnCliFil) Then
  Begin
    fatVenda.pAtualizaClassTransferencias;

    If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And
       (fRetCodEmpClienteFilial(qryConCli.FieldByName('CLI_CODCLI').AsString) = VS_strCodEmp) And
       (pnlEntCD.Visible And chkEntCD.Visible) Then
      chkEntCD.Checked := False;
  End;

  fatVenda.pDefineSeClienteEmiteEnvioEstoqueExternoPeloAutcom;

  pCarregaPrecoTE;

  fatVenda.objFazenda.pLimparDadosFazenda;
  pMostrarDadosFazendaRodape(False);

  If Not fEmptyStr(strNLeads) Then
  Begin
    fatVenda.strNLeads := strNLeads;
    fatVenda.strNomFrm := Self.Name;
  End;

  If not fEmptyStr(strProspe) Then
  Begin
    Try
      blnGravarComo := False;
      qryConsul := fCriaQuery(Nil);
      With qryConsul, SQL Do
      Begin
        Close;
        Clear;
        Add('SELECT * FROM PROSPE WHERE PRO_CODPRO = :CODPRO');
        ParamByName('CODPRO').AsString := strProspe;
        Open;
        fatVenda.strProspe := strProspe;
        fatVenda.strCliNom := FieldByName('PRO_NOMCLI').AsString;  // - Nome
        fatVenda.strCliEnd := FieldByName('PRO_ENDERE').AsString + ', ' + FieldByName('PRO_ENDNUM').AsString;  // - Endereco
        fatVenda.strCliBai := FieldByName('PRO_BAIRRO').AsString;  // - Bairro
        fatVenda.strCliCep := FieldByName('PRO_C_E_P_').AsString;  // - Cep
        fatVenda.strCodCid := FieldByName('PRO_CODCID').AsString;  // - Cód. Cidade
        fatVenda.strCliCid := fRetNomCidade(FieldByName('PRO_CODCID').AsString);  // - Cidade
        fatVenda.strCliEst := fRetNomCidade(FieldByName('PRO_CODCID').AsString,1);  // - Estado
        fatVenda.strCliTel := FieldByName('PRO_FONE01').AsString;  // - Telefone
        fatVenda.strCliCgc := FieldByName('PRO_C_G_C_').AsString;  // - CNPJ
        fatVenda.strCli_Rg := FieldByName('PRO_NUMR_G').AsString;  // - RG
        fatVenda.intCgcCpf := FieldByName('PRO_CGCCPF').AsInteger; // - CGC/CPF
        fatVenda.strCliIes := FieldByName('PRO_I_E_S_').AsString;  // - Ins.Estadual
        fatVenda.strCliEma := FieldByName('PRO_EMAIL_').AsString;  // - Email para NFe
      End;
    Finally
      FreeAndNil(qryConsul);
    End;
  End;

  If Not fEmptyStr(strCliCgc) Then
    fatVenda.strCliCgc := strCliCgc;

  If (qryConCli.FieldByName('CLI_CODCLI').IsNull) And
     (Not fEmptyStr(strNumOrc)) And (blnPrimeiraVez) And (Not fPermiteSelecionarClienteDeOutroVendedor(strOpcDoc)) Then
  Begin
    fatVenda.blnFecharForm := True;

    fMensagem('ATENÇÃO!', 'Esse cliente não está cadastrado ou usuário '
                        +'não possui direito de acesso para selecioná-lo!', ['&Ok']);
  End;
end;

procedure TfrmFatVendas.pHabilitaChkVendaPresencial;
var
  blnEhPresencialPelaAbreviacao: Boolean;
begin
  If ((fatVenda.fAtendeRegrasDifal(True)) Or fatVenda.blnVendaPresencial) Then
  Begin
    blnEhPresencialPelaAbreviacao := ((fatVenda.GetTipAbf = '_SAI_NCO') and (fCfgSis('DIFVNP', VarBoolean))) or
                                     ((fatVenda.GetTipAbf = '_SAI_CTA') and (fCfgSis('DIFVNP', VarBoolean))) or
                                     ((fatVenda.GetTipAbf = '_SAI_CCO') and (fCfgSis('DIFVNC', VarBoolean))) or
                                     ((fatVenda.GetTipAbf = '_SAI_PRU') and (fCfgSis('DIFPRU', VarBoolean)));

    chkVenPre.Visible := True;
    chkVenPre.Enabled := True;
    If (cdsVenda.RecordCount = 0) and (fFormataFloat(fatVenda.fltTotSer, 2) = 0) Then
      chkVenPre.Checked := blnEhPresencialPelaAbreviacao
    Else If blnEhPresencialPelaAbreviacao And (strCliAnt <> '') And (strCliAnt <> edtCodCli.Text) Then
      chkVenPre.Checked := True
    Else
      chkVenPre.Checked := fatVenda.blnVendaPresencial;
  End
  Else
  Begin
    chkVenPre.Visible := False;
    chkVenPre.Enabled := False;
    chkVenPre.Checked := False;
  End;

  chkVenPreClick(chkVenPre);

end;

procedure TfrmFatVendas.pHabilitaDesabilitaTipoDeEntregaLocalRetira(blnInserindo: Boolean=False);
var
  strCfgEmpEnt: String;
begin
  Case cmbEntRet.ItemIndex Of
    //Entrega
    IDX_ENTREGA: Begin

                   strCfgEmpEnt := fGetEmpConfigEntrega;

                   cmbTipEnt.Enabled := (cmbEntRet.Enabled) Or
                                        ((cmbEntRet.Visible) And (cmbTipEnt.Visible) And (Not fCfgSis('ENTFAT',varBoolean,strCfgEmpEnt)) And fCfgSis('SUJROM',varBoolean,strCfgEmpEnt) And fCfgSis('ENTFUT',varBoolean,strCfgEmpEnt));

                   If (blnAltEmpIte) Or ((btnAdicionar.Tag <= 0) And (cmbTipEnt.Enabled) And (cmbTipEnt.Visible)) Then
                   Begin
                     If (fatVenda.fRetornaSGFTED(edtNumLot.Text, strCfgEmpEnt) = 'S') Then
                       cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA  //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                     Else
                       cmbTipEnt.ItemIndex := IDX_ENTREGA_IMEDIATA; //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                   End;

                   pnlTipEnt.Visible := fCfgSis('ENTFUT', varBoolean, fGetEmpConfigEntrega) And pnlEntrega.Visible;
                   pnlLocRet.Visible := False;
                 End;

    //Retira
    IDX_RETIRA: Begin
                  cmbTipEnt.Enabled := False;
                  cmbTipEnt.ItemIndex := IDX_ENTREGA_IMEDIATA; //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA

                  If blnInserindo Then
                    If (Not fEmptyStr(qryConIte.FieldByName('ITE_TIPRET').AsString)) Then
                      cmbLocRet.ItemIndex := fRetLocalRetira(qryConIte.FieldByName('ITE_TIPRET').AsString);

                  If fCfgSis('LOCRET', VarBoolean) Then
                  Begin
                    pnlTipEnt.Visible := False;
                    pnlLocRet.Visible := True;
                    cmbLocRet.Enabled := fCfgSis('ALOCRE', VarBoolean);
                  End
                  Else
                  Begin
                    pnlTipEnt.Visible := fCfgSis('ENTFUT', varBoolean, fGetEmpConfigEntrega) And pnlEntrega.Visible;
                    pnlLocRet.Visible := False;
                  End;
                End;
  End;
end;

procedure TfrmFatVendas.pCalculaPesBruLiqTinta(
  Formulacao: TClassMatrizSaldosColorantes; strIdePro: String);
var
  intContador: Integer;
begin
  fltPesBruTin := 0;
  fltPesLiqTin := 0;

  If (fTipoTinta(strIdePro) in [ttAutomotiva, ttIndustrial]) Then
  Begin
    For intContador := 0 To Formulacao.Count - 1 Do
    Begin
      If Formulacao[intContador].strBasCol <> EMBALAGEM then
      Begin
        fltPesBruTin := fltPesBruTin + Formulacao[intContador].fltQtdFormula;
        fltPesLiqTin := fltPesLiqTin + Formulacao[intContador].fltQtdFormula;
      End;
    End;

    fltPesBruTin := fFormataFloat((fltPesBruTin / 1000) + IfNull(fRetPesBru(fatVenda.strCodEmb), 0), 4);
    fltPesLiqTin := fFormataFloat((fltPesLiqTin / 1000) + IfNull(fRetPesBru(fatVenda.strCodEmb), 0), 4);
  End;
end;

procedure TfrmFatVendas.pCalculaPrecoCusto(dtsDados: TDataSet;
                                           fltUnitar,
                                           fltPreCus: Double;
                                           blnIteEsp: Boolean;
                                           blnIteVid: Boolean;
                                           fltIcmSai: Double);
Var
  calcCustoReal : TCalcCustoReal;
  strCodSit,
  strCodAbf     : String;

  function fPegaPreCusParametro : Boolean;
  begin

    Result := False;

    If (fatVenda.strIdePro = 'NOR') And (Not blnIteEsp) And (Not blnIteVid) Then
      Exit(True);

    If (fatVenda.fltPreCus = 0) And blnIteEsp Then
      Exit(True);

    If fatVenda.fHabilitouCustoPorTabelaDePreco Then
      Exit(True);

  end;

Begin

  With dtsDados Do
  Begin

    If fPegaPreCusParametro Then
      fatVenda.fltPreCus := fltPreCus;

    If (fatVenda.strIdePro = 'NOR') And (Not blnIteVid) Then
    Begin
      calcCustoReal := TCalcCustoReal.Create;
      calcCustoReal.fltUnitar := fltUnitar;
      calcCustoReal.fltPreCus := fltPreCus;
      calcCustoReal.fltOutVal := fatVenda.fRetOutVal(FieldByName('ITE_OUTVAL').AsFloat);
      calcCustoReal.fltIcmSai := fltIcmSai;
      calcCustoReal.fltImpFed := fatVenda.fRetImpFed(FieldByName('ITE_IMPFED').AsFloat);
      calcCustoReal.fltDesOpe := fatVenda.fRetDesOpe(FieldByName('ITE_DESOPE').AsFloat) + fatVenda.fltDesOpeCli;

      strCodSit := '';
      strCodAbf := fatVenda.fGetCodAbf(FieldByName('ITE_CODITE').AsString, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem));
      If (Not fEmptyStr(fatVenda.GetTipAbf(fRetEmpresaItem))) And (fatVenda.fBuscaAbfIcm(FieldByName('ITE_CODITE').AsString, fRetEmpresaItem, strCodAbf, fatVenda.fTrocaUFEndEntrega)) Then
        strCodSit := fatVenda.cdsAbfIcm.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(fRetEmpresaItem)).AsString;

      calcCustoReal.fltDifal := fatVenda.fGetAlqDifal(FieldByName('ITE_CODITE').AsString, fRetEmpresaItem,
                                                      strCodAbf,
                                                      strCodSit);

      calcCustoReal.fltFcp   := fatVenda.fGetAlqFcpIcms(FieldByName('ITE_CODITE').AsString,
                                                        fRetEmpresaItem,
                                                        strCodAbf,
                                                        strCodSit,
                                                        fltIcmSai,
                                                        fltUnitar);

      fatVenda.fltPreCu2 := fatVenda.fRetornaPrecoCusto(Preco_de_Custo_Real,
                                                        FieldByName('ITE_CODITE').AsString,
                                                        fRetEmpresaItem,
                                                        fltPreCus,
                                                        '',
                                                        calcCustoReal,
                                                        blnIteEsp);

      FreeAndNil(calcCustoReal);
    End;
  End;

End;

procedure TfrmFatVendas.pCalculaPromocaoEntFut(blnForcaRecalculo: Boolean = False);

  function fTabelaPrecoTintaDefault: String;
  begin
    Result := fatVenda.fTabelaPrecoTinta(edtCodCli.Text, '', '', False, False, False);
  end;

Var
  fltQtdDis: Double;
  blnParticiona: Boolean;
  blnPromo: Boolean;
  blnTemEmbFec: Boolean;
  fltUniTmp : Double;
  fltTmpUnt : Double;
  fltDesMax : Double;
  fltPercDesEmbFec: Double;
  blnAplicarTaxaJuros : Boolean;
begin
  blnTemEmbFec := False;

  If blnAtualizandoDados Then
    Exit;

  If Not blnRecalcValUniEntFut Then
    Exit;

  If Pos(strOpcDoc, 'VN_PD_OR_') <= 0 Then
    Exit;

  If fatVenda.strStatus = 'C' Then
    Exit;

  If Not blnForcaRecalculo Then
  Begin
    If Not ((cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA)) Then
      Exit;
  End;

  If fEmptyStr(edtCodIte.Text) Then
    Exit;

  If (Not fatVenda.fItemPassivelDeVerificacaoPromo(edtCodIte.Text, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) Then
    Exit;

  If (fatVenda.strIdePro = 'NOR') And (Not blnProAca) Then
  Begin
    pAtualizaQryConIte;
    If Not fUsaTabelaPrecoItemPorRetiraEntrega Then
      strTabPreIteAnt := cbTabPrecoItem.Text;

    If (fatVenda.stlItensNaoEhEstrutura.IndexOf(edtCodIte.Text) = -1) And
       (Not fItemEstrutura(edtCodIte.Text)) Then
    Begin
      fatVenda.stlItensNaoEhEstrutura.Add(edtCodIte.Text);
    End;

    If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) And
       (Not fTemQuantEmbalagemFechada(edtCodIte.Text)) Then
    Begin
      fatVenda.stlItensNaoTemQtdeEmbFec.Add(edtCodIte.Text);
    End;

    fatVenda.strPromoc := 'N';

    If (fatVenda.fFilialPromocao) And (fRetornaPrecoPromocaoPelaTabIte(fEhPromocaoTabIte)) Then
    Begin
      If (fRetornaPrecosPromocao(edtCodIte.Text,
                                 edtCodCli.Text,
                                 VS_Date,
                                 IIF(fStrToFloat(edtQtdIte.Text) > 0, fStrToFloat(edtQtdIte.Text), 1),

                                 fatVenda.fRetQtdDigitada(edtCodIte.Text,'',IntToStr(btnAdicionar.Tag),'','',fRetEmpresaItem,False),

                                 fatVenda.fRetQtdDigitada(edtCodIte.Text,'',IntToStr(btnAdicionar.Tag),'','',fRetEmpresaItem,False,
                                                          False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,True {Somente em promocao}),

                                 fatVenda.intPrzMed,
                                 fatVenda.fltProPreCus,
                                 fatVenda.fltProPreVen,
                                 fatVenda.fltProComVar,
                                 fatVenda.fltProComAta,
                                 fatVenda.fltProComDis,
                                 fltQtdDis,
                                 fatVenda.fltProDesF07,
                                 fatVenda.strComPro,
                                 fatVenda.strCodPro,
                                 blnParticiona,
                                 blnPromo,
                                 fTabelaPrecoItem,
                                 fatVenda.strCodCnd,
                                 '',
                                 '',
                                 True,
                                 False,
                                 '-1',
                                 (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                                 (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                                 fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                 fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                 strNumOrc,
                                 strEspOrc,
                                 Nil,
                                 False,
                                 '',
                                 objPromVlrMinTotalProdutos, '', fatVenda.fltSomaColorantes
                                 )) Then
      Begin
        If (Not blnParticiona) Then
          fatVenda.strPromoc := 'S';
      End;
    End;

    blnTemEmbFec  := (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1)      And
                     (fQuantEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text)) > 0) And
                     (fStrToFloat(edtQtdIte.Text) > 0)                                     And
                     (Not edtQtdIte.ReadOnly)                                              And
                     (Not fEmptyStr(edtCodIte.Text))                                       And
                     (Pos(strOpcDoc, 'DV_PR_') <= 0)                                       And
                     (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor)                    And
                     (Not fEhItemVendaVidro(fCodItem))                                     And
                     (Pos('ITEM ESPECIAL', fRetNomProduto(edtCodIte.Text)) <= 0);

    If SameText(fCfgSis('SUGVLE'), '1') Then
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                    fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                             'S',
                                                             fStrToFloat(edtMargem.Text),
                                                             False,
                                                             fatVenda.strIdePro,
                                                             fTabelaDePrecoDosItens,
                                                             True,
                                                             fatVenda.FTaxJur,
                                                             fatVenda.FUniVis))
    Else
    Begin
      If (fatVenda.stlItensNaoEhEstrutura.IndexOf(edtCodIte.Text) = -1) And fItemEstrutura(fCodItem) Then
      Begin
        blnAplicarTaxaJuros := (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao);
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                      fatVenda.fCalculaPrecoEstrutura(blnAplicarTaxaJuros,
                                                                      Preco_de_Venda,
                                                                      fCodItem,
                                                                      fRetEmpresaItem,
                                                                      'S',
                                                                      fTabelaDePrecoDosItens,
                                                                      fStrToFloat(edtMargem.Text)));
        //Preço unitario sugerido sem juros
        fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
        fatVenda.fltTaxJur := 0.00;

        If blnAplicarTaxaJuros Then
        Begin
          fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem);
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniVis + fFormataFloat(fatVenda.fltUniVis * (fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0), 04));
        End;
      End
      Else
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                      fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                               'S',
                                                               fStrToFloat(edtMargem.Text),
                                                               False,
                                                               fatVenda.strIdePro,
                                                               fTabelaDePrecoDosItens,
                                                               True,
                                                               fatVenda.FTaxJur,
                                                               fatVenda.FUniVis))
    End;
    if (fCfgSis('RATEST', varString) = 'C') then
    begin
      edtUnitar.Text := FloatToStrF(fRetornaValorEstrutura(edtCodIte.Text ,fStrToFloat(edtUnitar.Text) ,StrToIntDef(strTabela,1)), ffFixed, 12, 2);
    end;
  End
  Else
  Begin
    if (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) then
    Begin
      fltUniTmp := 0;
      Case StrToIntDef(fTabelaDePrecoDosItens, StrToIntDef(fTabelaPrecoTintaDefault(), 1)) Of
        1: fltUniTmp := fatVenda.fltPreVe1;
        2: fltUniTmp := fatVenda.fltPreVe2;
        3: fltUniTmp := fatVenda.fltPreVe3;
        4: fltUniTmp := fatVenda.fltPreVe4;
        5: fltUniTmp := fatVenda.fltPreVe5;
        6: fltUniTmp := fatVenda.fltPreVe6;
        7: fltUniTmp := fatVenda.fltPreVe7;
      End;

      If (fCfgSis('CLIDES') = 'S') And
         (fCfgSis('DCVBVL') = 'L') Then
      Begin
        fltUniTmp := fFormataFloat(fltUniTmp * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
      End;

      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniTmp);
      strTabPreIteAnt := strTabPreItePrincipalAnt;

        //Preço unitario sugerido sem juros
      fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
      fatVenda.fltTaxJur := 0.00;

      If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
      Begin
        fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem);
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniVis + fFormataFloat(fatVenda.fltUniVis * (fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem) / 100.0), 04));
      End;
    End;
  End;

  If (fatVenda.strIdePro = 'NOR') Or
     (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
  Begin
    fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);

    fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);

    edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
  End;

  If (blnTemEmbFec) And (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) Then
  Begin
    fltTmpUnt := fStrToFloat(edtUnitar.Text);
    If fEhEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text)) And (fatVenda.strPromoc <> 'S') Then
    Begin
      If fCalcularDescontoEmbFechada Then
        fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text), strCodBarEmb)
      Else
        fltPercDesEmbFec := 0.00;

      fltTmpUnt := ( fltTmpUnt * ( 1 - ( fltPercDesEmbFec / 100 ) ) );
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltTmpUnt);
      fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(VS_strCodEmp, edtCodIte.Text, fTabelaDePrecoDosItens, '', fStrToFloat(edtQtdIte.Text), fltPercDesEmbFec);
    End;
  End;

  If Not fEmptyStr(strCodBarEmb) And fCfgSis('PRVEMB', VarBoolean) And (Not fatVenda.blnCliFil) Then
  Begin
    If fRetornaPrecoCodBarraEmb( edtCodIte.Text, strCodBarEmb, qryConIte.FieldByName('ITE_CODEMP').AsString, fTabelaPrecoItem, False ) > 0 Then
    Begin
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                    fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                             'S',
                                                             fStrToFloat(edtMargem.Text),
                                                             False,
                                                             fatVenda.strIdePro,
                                                             IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                             True,
                                                             fatVenda.FTaxJur,
                                                             fatVenda.FUniVis,
                                                             (Not fEmptyStr(strCodBarEmb)),
                                                             fRetornaPrecoCodBarraEmb(edtCodIte.Text,
                                                                                      strCodBarEmb,
                                                                                      qryConCit.FieldByName('ITE_CODEMP').AsString,
                                                                                      fTabelaPrecoItem,
                                                                                      True),
                                                             fRetornaTabPreCodBarraEmb(edtCodIte.Text, strCodBarEmb)));

      If (fCfgSis('PREEMB', VarInteger) <> 1) Then //PREEMB PREÇO DEFINIDO NO CÓDIGO DE BARRAS DO CADASTRO DE PRODUTOS
      Begin
        If (blnTemEmbFec) And (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) Then
        Begin
          fltTmpUnt := fStrToFloat(edtUnitar.Text);
          If fEhEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text)) And (fatVenda.strPromoc <> 'S') Then
          Begin
            If fCalcularDescontoEmbFechada Then
              fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text), strCodBarEmb)
            Else
              fltPercDesEmbFec := 0.00;

            fltTmpUnt := ( fltTmpUnt * ( 1 - ( fltPercDesEmbFec / 100 ) ) );
            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltTmpUnt);
          End;
        End;
      End;

      fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);
      fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);
    End;
  End;

  {*******************************************}
  {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
  {* APLICA O PERCENTUAL DE DESCONTO         *}
  {****************************************MV*}
  If (fatVenda.strCAbDes = 'S') And
     (fCfgSis('CNDVEN') = 'I') And
     (fatVenda.strStatus <> 'C') And
     ((fatVenda.strPromoc <> 'S') Or
      (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
     (Not fAplicarTaxaJurosPrecoDigitado) Then
  Begin
    {********************************************************************}
    {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
    {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
    {****************************************************************MM**}
    fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

    If fCfgSis('DESCND',varBoolean) Then
    Begin
      If (fatVenda.strDstCnd = 'S') Then
      Begin
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
        edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
      End
      Else
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

    End

    Else If (fatVenda.strCodFpg = '007') Then
    Begin
      If (fatVenda.strAbDeCc = 'S') Then
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
    End
    Else
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
  End;

  If fAplicarDescontoRessarcimentoCAT Then
  begin
    edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fStrToFloat(edtUnitar.Text)));
  end;

  If fCarregarEstruturaVidro(fCodItem, btnAdicionar.Tag, False) Then
  Begin
    fAtualizaPrecosEstruturaVidro(fTabelaPrecoItem, fEntregaFuturaItem, fRetEmpresaItem);
  End;

  pAtualizaUnitarioLiquido;
end;

procedure TfrmFatVendas.pCarregaInformacaoItem;
begin
  If (Not Assigned(dicInfIte)) Then
    Exit;

  If (cbTabPrecoItem.Visible) Then
    cbTabPrecoItem.ItemIndex := dicInfIte['cbTabPrecoItem'];
  If (cmbEntRet.Visible) Then
    cmbEntRet.ItemIndex      := dicInfIte['cmbEntRet'];
  If (cmbTipEnt.Visible) Then
    cmbTipEnt.ItemIndex      := dicInfIte['cmbTipEnt'];
  If (cmbLocRet.Visible) Then
    cmbLocRet.ItemIndex      := dicInfIte['cmbLocRet'];
  If (cmbMotEntFut.Visible) Then
    cmbMotEntFut.ItemIndex   := dicInfIte['cmbMotEntFut'];
  If (cmbCliBus.Visible) Then
    cmbCliBus.ItemIndex      := dicInfIte['cmbCliBus'];
  If (cmbTurEnt.Visible) Then
    cmbTurEnt.ItemIndex      := dicInfIte['cmbTurEnt'];
  If (mskDtaEnt.Visible) Then
    mskDtaEnt.Text           := dicInfIte['mskDtaEnt'];
  If (chkPegou.Visible) Then
    chkPegou.Checked         :=  dicInfIte['chkPegou'];
end;

procedure TfrmFatVendas.pCarregaItem(blnBuscaPorChave, blnAtualizaEdits: Boolean;
  blnRepesquisa: Boolean = False; blnEstrut: Boolean = False; blnAlt: Boolean = True;
  blnExiTelaEmb: Boolean = False; blnCarregadoPorEstru: Boolean = False;
  strIdePro: String = '');
  Var
    blnBuscaCodBar  : Boolean;
    blnItemEspecial : Boolean;
    strCodIte       : String;
    strEmpSalRes    : String;
    strTabPreAux    : String;
    fltQtdDis       : Double;
    fltDesMax       : Double;
    fltPreEmbFec    : Double;
    blnParticiona   : Boolean;
    blnPromo        : Boolean;
    fltCusIte       : Double;
    blnAltera       : Boolean;
    blnCodigoFab    : Boolean;
    fltQtdBal       : Double;
    intQtdBal       : Integer;
    blnManterQtd    : Boolean;
    fltDedCus       : Double;
    fltPercDesEmbFec: Double;
    blnLoteDeProdutoRastravel: Boolean;
    blnAplicarTaxaJuros : Boolean;
    strTabPreCliPromo : String;
    blnConCitVazia  : Boolean;

    function fMaisDeUmaEmbalagem: Boolean;
      Var
        strSQL: String;
        qryTmp: TUniQuery;
    Begin
      Result := False;

      If (qryConCit.FindField('ITE_CODITE') <> NIL) Then
      Begin
        strSQL := '';
        strSQL := strSQL + ' SELECT ';
        strSQL := strSQL + '   COUNT(*) AS QTD ';
        strSQL := strSQL + ' FROM ';
        strSQL := strSQL + '   ITEBAR ';
        strSQL := strSQL + ' WHERE ';
        strSQL := strSQL + '   BAR_CODITE = :CODITE AND ';
        strSQL := strSQL + '   BAR_EXBFAT = "S"         ';

        If fCfgSis('PRVEMB', VarBoolean) And  (fCfgSis('PREEMB', VarString) = '1') Then
          strSQL := strSQL + ' AND COALESCE(BAR_PREVEN, 0) > 0 '
        Else If fCfgSis('PRVEMB', VarBoolean) And  (fCfgSis('PREEMB', VarString) = '2') Then
          strSQL := strSQL + ' AND COALESCE(BAR_TABPRE, "") <> "" ';

        qryTmp := fCriaQuery;

        With qryTmp Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('CODITE').AsString := qryConCit.FieldByName('ITE_CODITE').AsString;
          Open;

          If Not IsEmpty Then
            Result := FieldByName('QTD').AsInteger > 1;
        End;

        FreeAndNil(qryTmp);
      End;
    End;

    procedure pRecalculaPrecosEmbalagens(cdsEmb: TUniClientDataSet);
    Begin
      With cdsEmb Do
      Begin
        If Not IsEmpty Then
        Begin
          First;

          While Not Eof Do
          Begin
            Edit;
            FieldByName('PREVEN').AsFloat := fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                                      'S',
                                                                      fStrToFloat(edtMargem.Text),
                                                                      False,
                                                                      fatVenda.strIdePro,
                                                                      IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                                      True,
                                                                      fatVenda.FTaxJur,
                                                                      fatVenda.FUniVis,
                                                                      True,
                                                                      FieldByName('PREVEN').AsFloat,
                                                                      FieldByName('TABPRE').AsString);

            Post;

            Next;
          End;
        End;
      End;
    End;
begin
  blnManterQtd := False;

  blnLoteDeProdutoRastravel := fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis And
                               (Not fEmptyStr(edtNumLot.Text)) And
                               (edtNumLot.Text <> 'A DEFINIR') And
                               (qryConCit.FieldByName('ITE_RASTRE').AsString = 'S');

  blnAltera    := fAlterandoProduto;
  strEmpSalRes := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

  blnBuscaCodBar := True;
  blnCodBarEmb   := False;

  If blnAtualizaEdits Then
    blnProAca := False;

  {**********************************************}
  {* NECESSARIO PARA NAO ZERAR UNITÁRIO DO ITEM *}
  {*******************************************AF*}
  If blnAtualizaEdits Then
    fatVenda.strIdePro := '';

  {************************************************************************}
  {* Quando estiver alterando um produto sempre deve carregar o mesmo     *}
  {* pelo código do sistema "ITE_CODITE", pois na tavares no cadastro     *}
  {* os códigos de fábrica são repetidos e ocorre de vender um produto    *}
  {* com código de um e descrição de outro, baixando errado estoque etc...*}
  {********************************************************************JC**}
  blnCodigoFab := (rdbCodFab.Checked And blnBuscarCodFab And (Not fatVenda.blnTintaMaquinaEmExecussao)) And (Not blnUtilizandoVendeItem) And fEmptyStr(strAiDvOr) And (Not blnInserindoCombo);

  If (blnAltera) And (blnAlt) Then
  Begin
    cdsVenda.Locate('AUTOINCREM', btnAdicionar.Tag,[]);//para garantir que esta posicionado no registro sendo alterado
    edtCodIte.Text := cdsVenda.FieldByName('ITE_CODITE').AsString;
    blnCodigoFab   := False;
  End;

  If fBarrasBalanca(edtCodIte.Text, strBarBal) Then
  Begin
    intQtdBal := StrToIntDef(Copy(edtCodIte.Text, 8, 5),0);
    edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, intQtdBal);
    edtCodIte.Text := Copy(edtCodIte.Text, 3, 5);

    If fCfgSis('DVQBAL') = 'S' Then
    Begin
      fltQtdBal := intQtdBal / 1000;
      edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, fltQtdBal);
    End;

    blnBuscaCodBar := False;
    blnManterQtd := True;
  End
  Else If (Not fEmptyStr(edtCodIte.Text)) And ((Length(Trim(edtCodIte.Text)) <= fTamCodIte) Or (rdbCodFab.Checked)) Then
  Begin
    If (Not rdbCodFab.Checked) Or (rdbCodFab.Checked And fatVenda.blnTintaMaquinaEmExecussao) Then
      edtCodIte.Text := fStrZero(edtCodIte.Text, fTamCodIte);

    blnBuscaCodBar := False;
  End;

  If (blnPrimeiraVez) And (fEmptyStr(edtCodIte.Text)) Then
  Begin
    blnBuscaCodBar := False;
    blnCodigoFab := False;
  End;

  {**************************************************************}
  {* PESQUISA NO CADASTRO DE ITENS E NO CADASTRO DE SEMELHANTES *}
  {***********************************************************LU*}
  pPesquisaCadSemFast(qryConCit,
                      qryConCit,
                      edtCodIte.Text,
                      blnBuscaCodBar,
                      blnCodigoFab And blnBuscaPorChave,
                      '',
                      False,
                      (blnCodigoFab And blnBuscaPorChave And (fCfgSis('FABVEN', VarString) = 'G')));

 (*
  {******************************************}
  {* CASO NAO ENCONTROU O COD.BARRA DO ITEM *}
  {* BUSCA POR COD.BARRA EMBALAGEM.         *}
  {***************************************JB*}
  If (blnBuscaCodBar) And (qryConCit.IsEmpty) Then
  Begin
    pPesquisaCadSem(qryConCit, qryConCit, edtCodIte.Text,
                    blnBuscaCodBar,
                    (blnCodigoFab) And (blnBuscaPorChave),
                    '', True, Not fatVenda.blnEmpFat);

    blnCodBarEmb := Not qryConCit.IsEmpty;
  End;
*)
  blnCodBarEmb := blnBuscaCodBar And (qryConCit.RecordCount = 1) And
                  (qryConCit.FieldByName('BAR_EMBALA').AsFloat > 0);

  If blnExiTelaEmb                     And
     blnBuscaPorChave                  And
     (Not blnBuscaCodBar)              And
     (btnAdicionar.Tag = 0)            And
     (fCfgSis('ESCEMB', VarString) = 'S') And
     (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And
     fMaisDeUmaEmbalagem Then
  Begin
    pCriarFormularios(TfrmRelacaoEmbalagens, frmRelacaoEmbalagens);
    frmRelacaoEmbalagens.strCodIte := qryConCit.FieldByName('ITE_CODITE').AsString;
    frmRelacaoEmbalagens.pCarregaProdutos;
    pRecalculaPrecosEmbalagens(frmRelacaoEmbalagens.cdsProdutos);
    frmRelacaoEmbalagens.ShowModal;

    If frmRelacaoEmbalagens.ModalResult = mrOk Then
    Begin
      edtCodIte.Text := frmRelacaoEmbalagens.cdsProdutos.FieldByName('CODBAR').AsString;
      blnBuscaCodBar := True;

      pPesquisaCadSemFast(qryConCit, qryConCit, edtCodIte.Text,
        blnBuscaCodBar, blnCodigoFab And blnBuscaPorChave);

      blnCodBarEmb := blnBuscaCodBar And (qryConCit.RecordCount = 1) And
                      (qryConCit.FieldByName('BAR_EMBALA').AsFloat > 0);
    End;

    pFreeAndNil(frmRelacaoEmbalagens);
  End;

  If (blnRepesquisa) And (blnCodigoFab) And (qryConCit.RecordCount > 1) And (intConfirmando = -1) Then
  Begin
    blnBuscarCodFab := False;
    fConsultaProdutos('', '', edtCodIte.Text);
    blnMudarFoco    := False;
  End;

  blnBuscarCodFab := True;

  if (blnBuscaPorChave) and (not blnTipBusCodBar) and (not blnInserindoMaisUmItemPeloCodBar) then
    blnTipBusCodBar := (Length(Trim(edtCodIte.Text)) > fTamCodIte);

  {*******************************************************************}
  {* VERIFICA SE O PRODUTO DIGITADO ESTÁ CADASTRADO NA TABELA ITEGER *}
  {****************************************************************RL*}
  blnExisteIteger := True;

  With qryConCit Do
  Begin

    strCodIte := FieldByName('ITE_CODITE').AsString;

    edtCodIte.Text := FieldByName('ITE_CODITE').AsString;
    edtCodFab.Text := FieldByName('ITE_CODFAB').AsString;
    edtAplica.Text := AnsiReplaceStr(AnsiReplaceStr(FieldByName('ITE_APLICA').AsString, #13, ' '), STRING_QUEBRA, ' ');

    {********************************}
    {* TRAVA ITEM FRACIONADO OU NAO *}
    {*****************************AF*}
    {*****************************VA*}
    pControlaDigitacaoValoresFracionados(FieldByName('ITE_CODUNI').AsString);

    btnQbit.Visible := ((fCfgSis('QBTUTI', varString) = 'S') and (FieldByName('ITE_QBTUTI').AsString = 'S'));

    {*********************************************************************************************}
    {* CASO O ITEM DIGITADO NAO ESTEJA NA TEMPORARIA DE ITENS PARA DEVOLUÇÃO, NÃO CARREGA O ITEM *}
    {******************************************************************************************MV*}
    If (Pos(strOpcDoc, 'DV_PR_DD_') <= 0) Or (fAlterandoProduto) Or
       (fatVenda.qryTemporaria.Locate('AUTOINCREM', qryConDev.FieldByName('AUTOINCREM').AsInteger,
                                           [])) Then
    Begin

      blnItemEspecial := (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0);

      pHabilitaCamposItem(True);

      {*******************************************}
      {* DESABILITA O CAMPO DO CODIGO DO PRODUTO *}
      {* QUANDO FOR ALTERACAO                    *}
      {****************************************JB*}
      If (Not blnAtualizaEdits) And (blnIteAlt) Then
        edtCodIte.Enabled := False;

      If blnBuscaCodBar Then
        edtCodIte.Text := qryConCit.FieldByName('ITE_CODITE').AsString;

      strCodAtu := qryConCit.FieldByName('ITE_CODITE').AsString;

      //fixo por enquanto, alterar quando for tinta de maquina
      If (fEmptyStr(fatVenda.strIdePro)) Then
        fatVenda.strIdePro := 'NOR';

      if Assigned(objTintaMaquinaDeOutroPedido) then
        fatVenda.strIdePro := objTintaMaquinaDeOutroPedido.IdentificacaoProduto;

      If (blnItemEspecial) Or
         (fEhItemVendaVidro(fCodItem)) Or
         (fatVenda.fEhConsertoEquipamento) Or
         (fatVenda.fPermiteEditarDescricaoProdutoFaturamento) Then
      Begin
        edtDesIte.ReadOnly := False;
        edtDesIte.TabStop  := TRUE;
        edtUnidad.ReadOnly := False;
        edtUnidad.TabStop  := TRUE;
      End
      Else
      Begin
        edtDesIte.ReadOnly := True;
        edtDesIte.TabStop  := FALSE;
        edtUnidad.ReadOnly := True;
        edtUnidad.TabStop  := FALSE;
      End;

      blnUltVen := True;

      If blnAtualizaEdits Then
      Begin
        edtDesIte.Text := FieldByName('ITE_DESITE').AsString;
        edtMulVen.Text := FloatToStrF(FieldByName('ITE_MLTVEN').AsFloat, ffNumber, 12, 4);
        pExibeQtdeCaixaMaster(edtCodIte.Text);

        {************************************************************}
        { VERIFICA SE DEVE CONCATENAR A REFERENCIA JUNTO A DESCRICAO }
        {*********************************************************ED*}
        If (fCfgSis('IMPREF', varBoolean)) Then
        Begin
          {*************************************************************************}
          { ADICIONADO PQ A REFERENCIA FOI AUMENTADA DE 16 POSICOES PARA 30 (ALESSI)}
          {**********************************************************************AC*}
          If FieldByName('ITE_REFERE').Size = 30 Then
            edtDesIte.MaxLength := edtDesIte.MaxLength + 14;

          If (fCfgSis('MONDES', varString) = '1') Then
            edtDesIte.Text := FieldByName('ITE_DESITE').AsString +
                              IIF(Not fEmptyStr(FieldByName('ITE_REFERE').AsString),' ' + FieldByName('ITE_REFERE').AsString,'')
          Else
            edtDesIte.Text := IIF(Not fEmptyStr(FieldByName('ITE_REFERE').AsString),FieldByName('ITE_REFERE').AsString + ' ','') +
                              FieldByName('ITE_DESITE').AsString;
        End;

        strDesOri := edtDesIte.Text;

        If blnCodBarEmb And fCfgSis('PRVEMB', VarBoolean) And (Not fEmptyStr(FieldByName('BAR_DESCRI').AsString)) Then
        Begin
          edtDesIte.Text := FieldByName('BAR_DESCRI').AsString;
        End;

        strRefere        := FieldByName('ITE_REFERE').AsString;
        edtUnidad.Text   := FieldByName('ITE_CODUNI').AsString;
        edtSigla.Text    := fRetSiglaUnidade(FieldByName('ITE_CODUNI').AsString, qryCadUni);
        chkBaseDeTroca.Visible := fExibeOpcaoRecABaseDeTroca(qryConCit.FieldByName('ITE_CODITE').AsString);
        chkBaseDeTroca.Checked := ((fCfgSis('MARVBT', varBoolean)) And (chkBaseDeTroca.Visible));

        pSetLabelUnidadeMedida;
        btnEstruturaVidro.Visible := fCarregarEstruturaVidro(fCodItem, btnAdicionar.Tag);

        If fCfgSis('VENVID',varBoolean) Then
        Begin
          edtComPec.EditFormat := fFormataCasaDecimalVIDRO('#,##0.00');
          edtLarPec.EditFormat := fFormataCasaDecimalVIDRO('#,##0.00');
          edtComPec.Text := FormatFloat(edtComPec.EditFormat, FieldByName('ITE_ALTVID').AsFloat);
          edtLarPec.Text := FormatFloat(edtLarPec.EditFormat, FieldByName('ITE_LARVID').AsFloat);
        End;

        If fEmptyStr(cmbEntSai.Text[1]) Then
        Begin
          If (Pos(strOpcDoc, 'DV_PR_DD_') > 0) Then
            cmbEntSai.ItemIndex := 0 // 0 - Entrada 1 - Saída
          Else
          Begin
            cmbEntSai.Enabled := True;
            If (strOpcDoc = 'TR') And (fCfgSis('OPCTRO') <> 'A') Then
            Begin
              If fCfgSis('OPCTRO') = 'E' Then
                cmbEntSai.ItemIndex := 0  // 0 - Entrada 1 - Saída
              Else
                cmbEntSai.ItemIndex := 1; // 0 - Entrada 1 - Saída

              cmbEntSai.Enabled := False;
            End
            Else
              cmbEntSai.ItemIndex := 1; // 0 - Entrada 1 - Saída
          End;
        End;

        If (Not blnManterQtd) And (Not fatVenda.blnCarregandoEstrutura) Then
          edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, IIF(Not blnCodBarEmb, 0, FieldByName('BAR_EMBALA').AsFloat));

        edtQtdIte.Enabled := True;
        strCodBarEmb := '';
        strTabPreEmb := '';

        If blnCodBarEmb Then
        Begin
          strCodBarEmb := FieldByName('BAR_CODBAR').AsString;

          If (fCfgSis('PRVEMB', VarBoolean)) And
             ((fCfgSis('PREEMB', VarInteger) = 2) And (Not fEmptyStr(qryConCit.FieldByName('BAR_TABPRE').AsString))) Then
          Begin

            strTabPreEmb := FieldByName('BAR_TABPRE').AsString;

            If (Not cbTabPreco.Visible) And (Not cbTabPrecoItem.Visible) And (Not SameText(strTabPreEmb, 'F')) Then
              fatVenda.strTabPre := strTabPreEmb;
          End
          Else
            strTabPreEmb := '';

          If ((fCfgSis('PREEMB', VarInteger) = 1) And (qryConCit.FieldByName('BAR_PREVEN').AsFloat > 0)) Or
             ((fCfgSis('PREEMB', VarInteger) = 2) And (Not fEmptyStr(qryConCit.FieldByName('BAR_TABPRE').AsString))) Then
            If fCfgSis('PRVEMB', VarBoolean) Then
              edtQtdIte.Enabled := False;
        End
        Else
          strTabPreIteNor := fatVenda.strTabPre;

        edtDesCon.Text     := FormatFloat(fMskDigitos(intDecDes), 0);
        edtUnitar.Text     := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);
        edtUniLiq.Text     := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);
        edtTotIte.Text     := '0,00';
        edtVrTotCImpostos.Text := '0,00';
        edtUnitComImpostos.Text := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);
        fatVenda.fltUniOri := 0;
        fatVenda.fltUniVis := 0;
        fatVenda.fltTaxJur := 0;
        fatVenda.fltVal_RT := 0;
        fatVenda.fltComAnt := 0;
        fatVenda.fltPreVe1 := 0.0;
        fatVenda.fltPreVe2 := 0.0;
        fatVenda.fltPreVe3 := 0.0;
        fatVenda.fltPreVe4 := 0.0;
        fatVenda.fltPreVe5 := 0.0;
        fatVenda.fltPreVe6 := 0.0;
        fatVenda.fltPreVe7 := 0.0;
        fatVenda.fltPreLot := 0.0;
        fatVenda.strIteTin := '';

        strChaFor := '';
        strCodAca := '';
        strEmpAca := '';
        blnProAca := False;

        strMecanicos := '';
        strIteSeqRcd := '';

        pHabilitarMetragem(FieldByName('ITE_CODITE').AsString,
                           FieldByName('ITE_CODUNI').AsString);

        pAtualizaUnitarioLiquido;
      End;

    End
    Else
    Begin
      Close; // Fecha tabela de itens
    End;

  End;

  blnConCitVazia := False;
   If (qryConCit.FindField('ITE_CODITE') <> Nil) Then
     blnConCitVazia := fEmptyStr(qryConCit.FieldByName('ITE_CODITE').AsString);

  {*****************************************}
  {* VALORES DO ITEM                       *}
  {**************************************MV*}
  If (IIF(blnPrimeiraVez And blnConCitVazia, False, True)) And
     ((Not qryConCit.Active)   Or
      (Not qryConCit.IsEmpty)) Then
  Begin

    With qryConIte Do
    Begin

      If (Not qryConIte.Active) Or blnAtualizaEdits Or
         (qryConIte.FieldByName('ITE_CODITE').AsString <> qryConCit.FieldByName('ITE_CODITE').AsString) Or
         (qryConIte.FieldByName('ITE_CODEMP').AsString <> fatVenda.fGetEmpPrecoVendaItem(fRetEmpresaItem)) Then
      Begin
        Close;
        ParamByName('CODITE').AsString := qryConCit.FieldByName('ITE_CODITE').AsString;
        ParamByName('CODEMP').AsString := fatVenda.fGetEmpPrecoVendaItem(fRetEmpresaItem);
        Open;
      End;

      If Assigned(objImpulsionadorVendasCRM) And (objImpulsionadorVendasCRM.blnIncIte) Then
      Begin
        edtLocFis.Text := EmptyStr;
      End
      Else
      Begin
        If fatVenda.fEstaEmAbastecimentoPorDepositoUsandoPrecoLocal Then
          edtLocFis.Text := fCampoTabela('ITE_LOCFIS', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [edtCodIte.Text, strEmpSalRes])
        Else
          edtLocFis.Text := FieldByName('ITE_LOCFIS').AsString;
      End;

      fatVenda.intPrzMed := fFloatToInt(fCalcMediaPagto(mskCndPag.Text));

      If (fatVenda.strIdePro = 'NOR') Then
      begin

        blnParticiona := False;
        blnPromo      := False;
        fatVenda.strPromoc := IIF(fAlterandoProduto, fatVenda.strPromoc, 'N');

        If (Not fVendendoEstrutSugerindoValPaiRateandoEntreFilhos(fatVenda.blnCarregandoEstrutura)) And
           (Not fVendendoEstrutSugerindoValPaiRateandoEntreFilhos(blnCarregadoPorEstru)) And
           (fRetornaPrecoPromocaoPelaTabIte(fEhPromocaoTabIte)) And
           (fatVenda.fFilialPromocao) And
           (fatVenda.fItemPassivelDeVerificacaoPromo(FieldByName('ITE_CODITE').AsString, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) Then
        Begin
          strTabPreCliPromo := fTabelaPrecoItem;
          If fEmptyStr(strTabPreCliPromo) Then
          Begin
            If (cbTabPreco.Visible) And
               (Not fEmptyStr(cbTabPreco.Text)) Then
              strTabPreCliPromo := cbTabPreco.Text
            Else
              strTabPreCliPromo := fatVenda.strTabPre;
          End;

          If (fRetornaPrecosPromocao(FieldByName('ITE_CODITE').AsString,
                                     edtCodCli.Text,
                                     VS_Date,
                                     IIF(fStrToFloat(edtQtdIte.Text) > 0, fStrToFloat(edtQtdIte.Text), 1),

                                     fatVenda.fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,'',IntToStr(btnAdicionar.Tag),'','',fRetEmpresaItem,False),

                                     fatVenda.fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,'',IntToStr(btnAdicionar.Tag),'','',fRetEmpresaItem,False,
                                                              False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,True {Somente em promocao}),

                                     fatVenda.intPrzMed,
                                     fatVenda.fltProPreCus,
                                     fatVenda.fltProPreVen,
                                     fatVenda.fltProComVar,
                                     fatVenda.fltProComAta,
                                     fatVenda.fltProComDis,
                                     fltQtdDis,
                                     fatVenda.fltProDesF07,
                                     fatVenda.strComPro,
                                     fatVenda.strCodPro,
                                     blnParticiona,
                                     blnPromo,
                                     strTabPreCliPromo,
                                     fatVenda.strCodCnd,
                                     '',
                                     '',
                                     True,
                                     False,
                                     '-1',
                                     (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                                     (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                                     fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                     fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                     strNumOrc,
                                     strEspOrc,
                                     Nil,
                                     False,
                                     '',
                                     objPromVlrMinTotalProdutos,
                                     '',
                                     fatVenda.fltSomaColorantes)) Then
          Begin
            If (Not blnParticiona) Then
              fatVenda.strPromoc := 'S';
          End;
        End;
      end;

      If qryConCit.FindField('ITE_DESCND') <> NIL Then
        fatVenda.strDstCnd := qryConCit.FieldByName('ITE_DESCND').AsString;

      pEditarDesconto;
      pEditarPrecoUnitario;

      If fatVenda.blnSaldoMatriz Then
        fatVenda.pCarregaEstoqueMatriz(edtCodIte.Text, '');

      If blnAtualizaEdits Then
      Begin

        {************************************************************}
        {* TRAZ A TAB DE PREÇO DO CLIENTE COMO SUGESTÃO PARA O ITEM *}
        {*********************************************************LU*}

        pAjustaComboTabPrePromocao(blnPromo);

        If fatVenda.blnSaldoMatriz Then
          fltSaldoItemAtu := fatVenda.fltSaldoMatriz
        Else If fatVenda.fEstaEmAbastecimentoPorDepositoUsandoPrecoLocal Then
          fltSaldoItemAtu := fCampoTabela('ITE_SALDOS', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [edtCodIte.Text, strEmpSalRes])
        Else
          fltSaldoItemAtu := FieldByName('ITE_SALDOS').AsFloat;

        If fUsaQtdPendenteEntregaFutura(True, strEmpSalRes) Then
          fltSaldoItemAtu := fltSaldoItemAtu + TEntregaFutura.New(
                                                 TParamEF.New()
                                                   .CodIte(edtCodIte.Text)
                                                   .CodEmp(strEmpSalRes)
                                                   .Lote(fRetNumLoteSeAdequado(strEmpSalRes, '', edtCodIte.Text))
                                                   .Faturamento(True)
                                                 ).Total();

        If fEhObrigatorioDefinirLotePickingCheckOut(fRetEmpresaItem) Then
          fltSaldoItemAtu := fatVenda.objCadLot.fSaldoLote(edtCodIte.Text,
                                                           strEmpSalRes,
                                                           fRetNumLoteSeAdequado(strEmpSalRes, '', edtCodIte.Text));

        If blnProAca Then
          fltSaldoItemAtu := TProdAcabado.fRetornaSaldo(strCodAca,strEmpAca,edtCodEmp.Text);

        pCalculaSaldoPigmento();

        fltSaldoResItemAtu := TSaldoReservado.New(
                                TReservaParametros.New()
                                  .EmpresaItem(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, ''))
                                  .NumeroDocumento(fatVenda.strNumOrc)
                                  .CodigoItem(qryConIte.FieldByName('ITE_CODITE').AsString)
                                  .CodEmpresa(strEmpSalRes)
                                  .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                                  .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                                  .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                                  .NumeroLote(fRetNumLoteSeAdequado(strEmpSalRes, '', qryConIte.FieldByName('ITE_CODITE').AsString))
                                  .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                              ).fGetQuantidade();

        fltQtdeDigitada := fatVenda.fRetQtdDigitada(edtCodIte.Text,
                                                    fRetNumLoteSeAdequado(strEmpSalRes, '', edtCodIte.Text),
                                                    '',
                                                    '',
                                                    '',
                                                    edtCodEmp.Text);

        edtSalDis.Text := FormatFloat(edtQtdIte.EditFormat, (fltSaldoItemAtu - fltSaldoResItemAtu) - fltQtdeDigitada);
        pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
        pHintSaldoDisponivel;

        If (Pos(strOpcDoc, 'DV_PR_DD_') <= 0) And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
        Begin

          {*******************************************}
          {* PREÇO DE COMPRA                         *}
          {****************************************MV*}
          fatVenda.fltComAnt := qryConIte.FieldByName('ITE_PRECOM').AsFloat;

          {*******************************************}
          {* PREÇO DE VENDA 1,2,3 E 4                *}
          {****************************************MV*}
          If fatVenda.fUtilizaPrecoSubItensEstrutura((Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0), fCodItem) Then
          Begin
            fatVenda.fltPreVe1 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','1',fStrToFloat(edtMargem.Text));
            fatVenda.fltPreVe2 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','2',fStrToFloat(edtMargem.Text));
            fatVenda.fltPreVe3 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','3',fStrToFloat(edtMargem.Text));
            fatVenda.fltPreVe4 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','4',fStrToFloat(edtMargem.Text));
            fatVenda.fltPreVe5 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','5',fStrToFloat(edtMargem.Text));
            fatVenda.fltPreVe6 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','6',fStrToFloat(edtMargem.Text));
            fatVenda.fltPreVe7 := fatVenda.fCalculaPrecoEstrutura(False, Preco_de_Venda,fCodItem,fRetEmpresaItem,'S','7',fStrToFloat(edtMargem.Text));
          End
          Else
          Begin
            fatVenda.fltPreVe1 := qryConIte.FieldByName('ITE_PREVE1').AsFloat;
            fatVenda.fltPreVe2 := qryConIte.FieldByName('ITE_PREVE2').AsFloat;
            fatVenda.fltPreVe3 := qryConIte.FieldByName('ITE_PREVE3').AsFloat;
            fatVenda.fltPreVe4 := qryConIte.FieldByName('ITE_PREVE4').AsFloat;
            fatVenda.fltPreVe5 := qryConIte.FieldByName('ITE_PREVE5').AsFloat;
            fatVenda.fltPreVe6 := qryConIte.FieldByName('ITE_PREVE6').AsFloat;
            fatVenda.fltPreVe7 := qryConIte.FieldByName('ITE_PREVE7').AsFloat;
          End;

          {*****************************************}
          {* PEGA VALOR UNITARIO                   *}
          {**************************************MV*}
          If (fatVenda.strIdePro = 'NOR') And (Not fEhItemVendaVidro(fCodItem)) Then
          Begin
            If (fatVenda.stlItensNaoEhEstrutura.IndexOf(fCodItem) = -1) And
               (Not fItemEstrutura(fCodItem)) Then
            Begin
              fatVenda.stlItensNaoEhEstrutura.Add(fCodItem);
            End;

            If SameText(fCfgSis('SUGVLE'), '1') Or (blnEstrut) Then
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                            fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                                     'S',
                                                                     fStrToFloat(edtMargem.Text),
                                                                     False,
                                                                     fatVenda.strIdePro,
                                                                     IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                                     True,
                                                                     fatVenda.FTaxJur,
                                                                     fatVenda.FUniVis,
                                                                     blnCodBarEmb,
                                                                     qryConCit.FieldByName('BAR_PREVEN').AsFloat,
                                                                     qryConCit.FieldByName('BAR_TABPRE').AsString))
            Else
            Begin
              If (fatVenda.stlItensNaoEhEstrutura.IndexOf(fCodItem) = -1) And fItemEstrutura(fCodItem) Then
              Begin
                blnAplicarTaxaJuros := (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao);
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                              fatVenda.fCalculaPrecoEstrutura(blnAplicarTaxaJuros,
                                                                              Preco_de_Venda,
                                                                              fCodItem,
                                                                              fRetEmpresaItem,
                                                                              'S',
                                                                              IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                                              fStrToFloat(edtMargem.Text)));
                //Preço unitario sugerido sem juros
                fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
                fatVenda.fltTaxJur := 0.00;

                If blnAplicarTaxaJuros Then
                Begin
                  fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem);
                  edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniVis + fFormataFloat(fatVenda.fltUniVis * (fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0), 04));
                End;
              End
              Else
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                              fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                                       'S',
                                                                       fStrToFloat(edtMargem.Text),
                                                                       False,
                                                                       fatVenda.strIdePro,
                                                                       IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                                       True,
                                                                       fatVenda.FTaxJur,
                                                                       fatVenda.FUniVis,
                                                                       blnCodBarEmb,
                                                                       qryConCit.FieldByName('BAR_PREVEN').AsFloat,
                                                                       qryConCit.FieldByName('BAR_TABPRE').AsString));
            End;
            if (Pos(strOpcDoc, 'ER_') > 0) And (fCfgSis('VENOUT', varString) = 'S') then
            begin
              edtUnitar.Text := FloatToStrF(fBuscaPrecoTabelaRemessa(edtCodIte.Text, StrToFloatDef(edtUnitar.Text,0)), ffFixed, 12, 2);
            end;

            if (fCfgSis('RATEST', varString) = 'C') then
            begin
              edtUnitar.Text := FloatToStrF(fRetornaValorEstrutura(edtCodIte.Text ,fStrToFloat(edtUnitar.Text) ,StrToIntDef(strTabPre,1)), ffFixed, 12, 2);
            end;
          End;

          fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);

          fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);

          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

          If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) And
             (Not fTemQuantEmbalagemFechada(edtCodIte.Text)) Then
          Begin
            fatVenda.stlItensNaoTemQtdeEmbFec.Add(edtCodIte.Text);
          End;

          {********************************}
          { REALIZAR O CALCULO NESSA ORDEM }
          {*****************************CH*}

          {1.}
          {**************************************************************************}
          {* CASO ABATE O DESCONTO AUTOMATICAMENTE, APLICA O PERCENTUAL DE DESCONTO *}
          {***********************************************************************MV*}
          If (fatVenda.strCAbDes = 'S') And
             (fCfgSis('CNDVEN') = 'I') And
             ((fatVenda.strPromoc <> 'S') Or
              (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
             (fatVenda.strStatus <> 'C') And
             (Not fAplicarTaxaJurosPrecoDigitado) Then
          Begin
            {********************************************************************}
            {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
            {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
            {****************************************************************MM**}
            fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

            If fCfgSis('DESCND',varBoolean) Then
            Begin
              If (fatVenda.strDstCnd = 'S') Then
              Begin
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
                edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
              End
              Else
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

            End

            Else If (fatVenda.strCodFpg = '007') Then
            Begin
              If (fatVenda.strAbDeCc = 'S') Then
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
            End
            Else
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
          End;

          If fAplicarDescontoRessarcimentoCAT Then
          begin
            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fStrToFloat(edtUnitar.Text)));
          end;

          {2.}
          {************************************************}
          {* VERIFICA SE EH MULTIPLO DE EMBALAGEM FECHADA *}
          {* APLICA O DESCONTO PARA EMBALAGEM FECHADA     *}
          {********************************************JC**}
          strTabPreAux := fRetornaTabPreCodBarraEmb(edtCodIte.Text, strCodBarEmb);
          If (strTabPreAux.IsEmpty) Or (strTabPreAux = 'F') Then
            strTabPreAux := cbTabPreco.Text;

          If (strTabPreAux.IsEmpty) Then
            strTabPreAux := fatVenda.strTabPre;

          If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) And
             (fEhEmbalagemFechadaItem(edtCodIte.Text, strTabPreAux, fStrToFloat(edtQtdIte.Text))) And (fatVenda.strPromoc <> 'S') Then
          Begin
            If fCalcularDescontoEmbFechada Then
              fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(edtCodIte.Text, strTabPreAux, fStrToFloat(edtQtdIte.Text), '')
            Else
              fltPercDesEmbFec := 0.00;

            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
              fStrToFloat(edtUnitar.Text) * ( 1 - ( fltPercDesEmbFec / 100 ) ) );

            fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(VS_strCodEmp, edtCodIte.Text, strTabPreAux, '', fStrToFloat(edtQtdIte.Text), fltPercDesEmbFec);

            If (fCfgSis('TRPEMB') = '2') And
               (Pos(strOpcDoc, 'UC_') <= 0) Then
            Begin
              fltPreEmbFec := fatVenda.fGetUnitarioEmbalagemFechada(edtCodIte.Text, fatVenda.strTabPre, fStrToFloat(edtQtdIte.Text),0);

              If fltPreEmbFec > 0 Then
              Begin
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltPreEmbFec );
                fatVenda.fltUniOri := fltPreEmbFec;
              End;
            End;
          End;

          strNotUltCat17 := '';
          fltDedCus := 0;
          If (Pos(fCfgSis('MCAT17'),'D_A_C_M_V_') > 0) Then
          Begin

            fatVenda.pCarregaValoresCusto(fCodItem,
                                          qryConIte.FieldByName('ITE_CODEMP').AsString,
                                          fTabelaPrecoItem);

            fltDedCus := fatVenda.fRetornaPrecoCustoDeduzindoRessarcimentoCAT(
                                                   fCodItem,
                                                   fRetEmpresaItem,
                                                   fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)),
                                                   qryConCit.FieldByName('ITE_CODFOR').AsString,

                                                   IIF(((fatVenda.strIdePro = 'NOR') And
                                                        (fatVenda.strPromoc = 'S') And
                                                        (fatVenda.fltProPreCus > 0) and
                                                        (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao)),
                                                      fatVenda.fltProPreCus,
                                                      fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)),

                                                   strNotUltCat17);
          End;

          fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                        qryConIte.FieldByName('ITE_CODEMP').AsString,
                                        fTabelaPrecoItem);

          If (fatVenda.strIdePro = 'NOR') And
             (fatVenda.strPromoc = 'S') And
             (fatVenda.fltProPreCus > 0) and
             (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Then
          begin
            fltCusIte := IIF((fltDedCus > 0), fltDedCus, fatVenda.fltProPreCus)
          end
          Else
            fltCusIte := fatVenda.fRetornaPrecoCusto(Preco_de_Custo,
                                                     fCodItem,
                                                     fRetEmpresaItem,
                                                     IIF((fltDedCus > 0), fltDedCus, fatVenda.fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat)),
                                                     '',
                                                     Nil,
                                                     (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));

          fltCusIte := fatVenda.fRetPreCus(fltCusIte);

          pCalculaPrecoCusto(qryConIte, fStrToFloat(edtUnitar.Text), fltCusIte,
                            (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0),
                            fEhItemVendaVidro(qryConIte.FieldByName('ITE_CODITE').AsString),
                            IIf(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                                   qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte),
                                                                                   fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)));

          If fCarregarEstruturaVidro(fCodItem, btnAdicionar.Tag) Then
          Begin
            fAtualizaPrecosEstruturaVidro(fTabelaPrecoItem, fEntregaFuturaItem, fRetEmpresaItem);
          End;

          pAtualizaUnitarioLiquido;
        End
        Else
        Begin
          {*****************************************}
          {* PEGA QUANTIDADE E VALOR UNITARIO      *}
          {**************************************MV*}
          edtUnitar.Text   := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniDev);

          fatVenda.fltPreCus := fltCusDev;
          fatVenda.fltPreCu2 := fltCusDe2;
          fatVenda.fltOutVal := fltOutValDev;
          fatVenda.fltIcmSai := fltIcmSaiDev;
          fatVenda.fltImpFed := fltImpFedDev;
          fatVenda.fltDesOpe := fltDesOpeDev;
          fatVenda.fltUniOri := fltUniDev;
          fatVenda.fltUniVis := fltUniDev;
          fatVenda.fltTaxJur := 0;
          fatVenda.fltVal_RT := 0;

          fatVenda.fltPreVe1 := FieldByName('ITE_PREVE1').AsFloat;
          fatVenda.fltPreVe2 := FieldByName('ITE_PREVE2').AsFloat;
          fatVenda.fltPreVe3 := FieldByName('ITE_PREVE3').AsFloat;
          fatVenda.fltPreVe4 := FieldByName('ITE_PREVE4').AsFloat;
          fatVenda.fltPreVe5 := FieldByName('ITE_PREVE5').AsFloat;
          fatVenda.fltPreVe6 := FieldByName('ITE_PREVE6').AsFloat;
          fatVenda.fltPreVe7 := FieldByName('ITE_PREVE7').AsFloat;

          fatVenda.fltPreMed := fltPreMedDev;
          fatVenda.fltImpUlt := fltImpUltDev;
          fatVenda.fltPreUlt := fltPreUltDev;

        End;

        If cbTabPrecoItem.Visible Then
        Begin
          pEditarDesconto;
          pEditarPrecoUnitario;
        End;

        If Not cmbEntRet.Enabled Then
          cmbEntRetChange(nil);

        {Sugestão caso "Cliente está na loja!"}
        If (fCliLoj) Then
        Begin
          If (cmbEntRet.Visible) And (cmbEntRet.Enabled) Then
            If (cbbClienteEstaNaLoja.ItemIndex = IDX_CLIENTE_S_LOJA) Then
              cmbEntRet.ItemIndex := IDX_RETIRA;
        End;

        if (not fAlterandoProduto) And (cdsVenda.IsEmpty) then
        begin
          cmbEntRet.ItemIndex := fUtilizaDestinoadastroCliente(cmbEntRet.ItemIndex, edtCodCli.Text, strOpcDoc);
        end;

        {Sugerir prazo do fornecedor na inclusão para itens de entrega imediata!}
        pSugerirPrazoFornecedor;

        pSugerirDataEntregaFuturaPrevisao();

        pAtualizaUnitarioLiquido;

      End;

    End;

    If TFunctionFuncoesFaturamento.CadastroDeAbreviacaoFiscalIgualParaTodasAsEmpresas(fatVenda.fRetornaEmpresaTE_CD, fatVenda.fGetEmpCalculoItem(qryConIte.FieldByName('ITE_CODEMP').AsString)) Then
      pPesquisaAbfIcm(qryConAbf, qryConAbf, qryConCit.FieldByName('ITE_CODABF').AsString)
    Else
      pPesquisaAbfIcm(qryConAbf, qryConAbf, qryConIte.FieldByName('ITE_CODABF').AsString);

  End
  Else
  Begin
    qryConIte.Close;
  End;

  pHabilitarEdicaoEmpresa;

  //*****************************************************************************************************//
  // NAS CONFIGURACOES DO SISTEMA FAT3, EXISTE UMA CONFIGURACAO PARA DESABILITAR O DESCONTO ITEM A ITEM. //
  //**************************************************************************************************ED*//
  pEditarDesconto;

  if not blnLoteDeProdutoRastravel then
  begin
    pAjustaLote(qryConIte.FieldByName('ITE_CODITE').AsString,
                IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD),
                fatVenda.strIdePro, blnProAca, Nil);

    If (Not SameText(fatVenda.objCadLot.strLotAnt, edtNumLot.text)) Then
      fValidaCampos(edtNumLot, True);
  end;

  pExibirComplementoDescricao(qryConIte.FieldByName('ITE_CODITE').AsString);
  pExibirBotaoDescricaoItem(qryConIte.FieldByName('ITE_CODITE').AsString);

  If blnAtualizaEdits And fUtilizaDefinicaoAmbienteProduto And fCfgSis('ULTAMB', varBoolean) Then
    cbbComple.Text := strUltComple;

  If (fCfgSis('CLIDES') = 'S')   And
     (fCfgSis('DCVBVL') = 'B')   And
     (fCfgSis('FATUDE') = 'S')   And
     (fCfgSis('DPDIDE') = '1')   And
     (btnAdicionar.Tag = 0)      And
     (edtDesCon.Visible)         And
     ((fatVenda.strPromoc <> 'S') Or (fUtilizaUnitarioLiquido)) And
     (Not blnAdicionando Or blnAtualizaEdits) And
     (Not fatVenda.fDocumentoParaFornecedor) Then
  Begin
    blnAdicionando := True;

    If (fUtilizaUnitarioLiquido) And
       ((fatVenda.strPromoc = 'S') And
        (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao)) Or
       (fatVenda.strIteCom = 'S') Then
    begin
      edtDesCon.Text := FloatToStrF(0, ffNumber, 12, intDecDes)
    end
    Else
    Begin

      If fProcessarRegraDescontoDeProfissionalPorItem Then
        pProcessarRegraDescontoDeProfissionalPorItem
      Else
        edtDesCon.Text := FloatToStrF(fRetDescontoCliente(fatVenda.strCodCli), ffNumber, 12, intDecDes);

    End;
  End;

  pCarregaDescontoNegociacaoCliente(IIF(fEmptyStr(strIdePro), fatVenda.strIdePro, strIdePro));
  pCarregaUltimaVenda;
end;

procedure TfrmFatVendas.pAjustaComboTabPrePromocao(blnPromo: Boolean);
begin
  If (Not blnItemAgregado) Then
  Begin
    If fUsaTabelaPrecoItemPorRetiraEntrega Then
        pAtualizaTabPreRetiraEntrega
    Else
    If Not (fatVenda.blnCarregandoEstrutura) Then
    Begin
      If cbTabPrecoItem.Items.IndexOf(fatVenda.strTabPre) >= 0 Then
      Begin
        cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(fatVenda.strTabPre);
        cbTabPrecoItemChange(cbTabPrecoItem);
      End;
    End
    Else If cbTabPrecoItem.Items.Count > 0 Then
      cbTabPrecoItem.ItemIndex := 0;
  End
  Else
  Begin
    cbTabPrecoItemChange(cbTabPrecoItem);
  End;

  strTabPreCarregadoDoItem := cbTabPrecoItem.Text;
  pDesconsideraPromocaoTabItem(fatVenda.strPromoc, blnPromo);
end;

procedure TfrmFatVendas.pAjustaLegendaLote;
  Var
    strNomAmz: String;
begin
  If (pnlItemLote.Visible) Then
  Begin
    If (fCfgSis('CTLEST') = '2') Then
    Begin
      strNomAmz := fRetNomeArmazem(edtNumLot.Text);

      If fEmptyStr(strNomAmz) Then
      Begin
        edtNomArm.Visible := False;
        edtNumLot.Width := btnLoteRapido.Left-edtNumLot.Left - 2;
      End
      Else
      Begin
        edtNomArm.Visible := True;
        edtNumLot.Width := edtNomArm.Left-edtNumLot.Left - 2
      End;

      edtNomArm.Text := strNomAmz;
    End;
  End;
end;

function TfrmFatVendas.fUsaSugestaoLoteMenorValidade: Boolean;
begin
  if fCfgSis('NOMEMP') = '2' then
    Result := not fEmptyStr(fRetFantasiaEmpresa(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD)))
  else
    Result := not fEmptyStr(fRetNomeEmpresaSelec(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD)));

  if Result then
    Result := ((Pos(strOpcDoc, 'PD_OR_VN') > 0) and
               (fEmptyStr(strNumOrc) Or fEstaIncluindoProduto()) And
               ((fCfgSis('SGLTVL', varBoolean)) Or (fCfgSis('LMENDV', varBoolean))) and
               (not fUsaRotinaWMS(IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD))));
end;

procedure TfrmFatVendas.pAjustaLote(strCodIte, strCodEmp, strIdePro: String; blnProAca: Boolean; matrizFormulacao: TClassMatrizSaldosColorantes; blnValidaNumLot: Boolean=True);
Var
  intFormulacao: Integer;
  stlColorantes : TStringList;
  strLotPrinciTintaMaquina,
  strLisMsg: String;
  blnExisteCampoNumLotDev: Boolean;
  strNumLotDev: String;
  blnMantemLoteOriginalDocumento: Boolean;
  strIdeProAux: String;
  strCodEmpLot: string;
  LChaveAceOri: String;
Begin
  blnMantemLoteOriginalDocumento := fCfgSis('MANEND', varBoolean);

  If (blnMantemLoteOriginalDocumento) And
     (fCfgSis('FULLAD', VarString) = 'S') And
     (Pos(strOpcDoc, 'DV_PR_') > 0) And
     Assigned(qryConDev) And qryConDev.Active And
     (Not qryConDev.IsEmpty) Then
  Begin
    LChaveAceOri := fRetChaveAcesso(
                      qryConDev.FieldByName('DET_NUMDOC').AsString,
                      qryConDev.FieldByName('DET_ESPDOC').AsString,
                      qryConDev.FieldByName('DET_FORCLI').AsString,
                      qryConDev.FieldByName('DET_CODEMP').AsString,
                      qryConDev.FieldByName('DET_SERIE_').AsString,
                      qryConDev.FieldByName('DET_TIP_FC').AsString);

    If (Not fEmptyStr(LChaveAceOri)) And
       (fCampoTabela('NFE_IMPORT', 'NFEIMP',
                     ['NFE_ACESSO', 'NFE_STATUS'],
                     [LChaveAceOri, 'AT']) = 'S') Then
      blnMantemLoteOriginalDocumento := False;
  End;

  If fEmptyStr(fRetNomeEmpresaSelec(strCodEmp)) Then
    strCodEmp := fatVenda.fEmpresaSaldoMatriz_CD;

  If strIdePro = 'NOR' Then
  Begin
    If (fatVenda.stlItensNaoTemLote.IndexOf(strCodIte) = -1) And
       (fatVenda.objCadLot.fItemSemNenhumLote(strCodIte)) Then
    Begin
      fatVenda.stlItensNaoTemLote.Add(strCodIte);
    End;

    pMostraLote((Pos(strOpcDoc, OPC_LOTE) > 0) And
                (fatVenda.stlItensNaoTemLote.IndexOf(strCodIte) = -1) And
                fatVenda.objCadLot.fExisteLote(strCodIte, strCodEmp) And
                (Not blnProAca));
  End
  Else
  Begin
    If Assigned(matrizFormulacao) And (Not fEmptyStr(strIdePro)) Then
    Begin
      For intFormulacao := 0 To matrizFormulacao.Count -1 Do
      Begin
        If (fatVenda.stlItensNaoTemLote.IndexOf(matrizFormulacao[intFormulacao].strCodIte) = -1) And
           (fatVenda.objCadLot.fItemSemNenhumLote(matrizFormulacao[intFormulacao].strCodIte)) Then
        Begin
          fatVenda.stlItensNaoTemLote.Add(matrizFormulacao[intFormulacao].strCodIte);
        End;

        pMostraLote((Pos(strOpcDoc, OPC_LOTE) > 0) And
                    (fatVenda.stlItensNaoTemLote.IndexOf(matrizFormulacao[intFormulacao].strCodIte) = -1) And
                     fatVenda.objCadLot.fExisteLotePrincipalTintaMaquina(matrizFormulacao[intFormulacao].strCodIte, strCodEmp));

        If pnlItemLote.Visible Then
          Break;
      End;
    End
    Else
    If (fEmptyStr(strIdePro)) Then
      pMostraLote(False);
  End;

  If (Pos(strOpcDoc, 'DV_PR_DD_') > 0) Or (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
  Begin
    edtNumLot.ReadOnly := False;
    //Adicionando um produto
    If (btnAdicionar.Tag = 0) Then
    Begin
      If Assigned(qryConDev) And Assigned(qryConDev.FindField('DET_NUMLOT')) Then
      Begin
        If (qryConDev.FieldByName('DET_NUMLOT').AsString <> 'A DEFINIR') Or fEmptyStr(edtNumLot.Text) Then
        Begin
          If (fatVenda.objCadLot.fLoteAtivo(qryConDev.FieldByName('DET_NUMLOT').AsString, qryConDev.FieldByName('DET_CODEMP').AsString, qryConDev.FieldByName('DET_CODITE').AsString)) Then
            edtNumLot.Text := qryConDev.FieldByName('DET_NUMLOT').AsString;
        End;

        edtNumLot.ReadOnly := (qryConDev.FieldByName('DET_NUMLOT').AsString <> '') And
                              (qryConDev.FieldByName('DET_NUMLOT').AsString <> 'A DEFINIR') And
                              fatVenda.objCadLot.fLoteAtivo(qryConDev.FieldByName('DET_NUMLOT').AsString,
                                                            qryConDev.FieldByName('DET_CODEMP').AsString,
                                                            qryConDev.FieldByName('DET_CODITE').AsString);
      End;
    End
    //Alterando um produto
    Else
    Begin
      If fatVenda.qryTemporaria.Locate('DET_AUTOIN', cdsVenda.FieldByName('ITE_INCDEV').AsString, []) Then
      Begin
        edtNumLot.ReadOnly := (fatVenda.qryTemporaria.FieldByName('DET_NUMLOT').AsString <> '') And
                              (fatVenda.qryTemporaria.FieldByName('DET_NUMLOT').AsString <> 'A DEFINIR');
      End;
    End;
    edtNumLot.TabStop  := Not edtNumLot.ReadOnly;
  End;

  {Validações do Armazém}
  If (fCfgSis('CTLEST') = '2') Then
  Begin

    if (fUsaSugestaoLoteMenorValidade) and
       (fEmptyStr(edtNumLot.Text)) and
       (pnlItemLote.Visible) and
       (btnAdicionar.Tag <= 0) then
    begin
      strLoteMenorValidade := fatVenda.objCadLot.fRetLoteMenorValidade(fCodItem, strCodEmp, nil);
      edtNumLot.Text := strLoteMenorValidade;
    end;

    {Inclusão do Item - Carrega Armazém Principal}
    If (pnlItemLote.Visible) And fEmptyStr(edtNumLot.Text) And (btnAdicionar.Tag <= 0) And (not fUsaSugestaoLoteMenorValidade) Then
      edtNumLot.Text := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(fCodItem);

    {Inclusão do Combo - Carrega Armazém Principal}
    If (pnlItemLote.Visible) And
       (fEmptyStr(edtNumLot.Text)) And
       (not fUsaSugestaoLoteMenorValidade) And
       (blnInserindoCombo Or blnAlterandoCombo) And
       (btnAdicionar.Tag <= 0) Then
    Begin
      edtNumLot.Text := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(fCodItem);
    End;

    pAjustaLegendaLote;

    If (intConfirmando <> 0) And (btnAdicionar.Tag <= 0) Then
      if (pnlItemLote.Visible) and (fCfgSis('ARMOBR',varBoolean)) and (fCfgSis('CTLEST') = '2') and (Pos(strOpcDoc, 'PD_OR_VN_TE_') > 0) then
      begin
        edtNumLot.Clear;
        edtNomArm.Clear;
      end;

    {Bloqueio do campo "Armazém"}
    If (blnValidaNumLot And ((fatVenda.objCadLot.fSaldoLote(fCodItem,strCodEmp,edtNumLot.Text)) > 0) And
       (Pos(strOpcDoc, 'PD_OR_VN_CS_') > 0) And (fCfgSis('ALTARM') = 'N'))
       Or
       (blnValidaNumLot And ((fatVenda.objCadLot.fSaldoLote(fCodItem,strCodEmp,edtNumLot.Text)) <= 0) And
       (Pos(strOpcDoc, 'PD_OR_VN_CS_') > 0) And (fCfgSis('ALTARM') = 'N') And
       (fCfgSis('ALTASZ') = 'N'))
       Or
       (fBloquearArmazemEdicaoOrPdVn(blnValidaNumLot, ((fatVenda.objCadLot.fSaldoLote(fCodItem,strCodEmp,edtNumLot.Text)) > 0))) Then
    Begin
      edtNumLot.ReadOnly    := True;

      strIdeProAux := fatVenda.strIdePro;
      fatVenda.strIdePro := strIdePro;
      Try
        edtNumLot.TabStop  := Not fValidaCampos(edtNumLot);
      Finally
        fatVenda.strIdePro := strIdeProAux;
      End;

      edtNumLot.Color       := $00FFDFB8;
      edtNumLot.NormalColor := $00FFDFB8;
      edtNumLot.FocusColor  := $00FFDFB8;
    End
    Else
    Begin
      edtNumLot.ReadOnly    := False;
      edtNumLot.TabStop     := True;
      edtNumLot.Color       := clWindow;
      edtNumLot.NormalColor := clWindow;
      edtNumLot.FocusColor  := clInfoBk;
    End;

  End;

  {*************************************************************}
  {* SOMENTE PERMITIDO LOTE "A DEFINIR" UTILIZANDO ROTINAS WMS *}
  {**********************************************************JC*}
  If fCfgSis('CTLEST') = '1' Then {Validação somente para lotes}
  Begin

    If pnlItemLote.Visible Then
    Begin
      //Req 151661 - Se ja pegou o produto precisa informar de onde para baixa correta do estoque
      If (chkPegou.Visible And chkPegou.Checked) And fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
      Begin
        edtNumLot.ReadOnly   := False;
        edtNumLot.TabStop    := True;
        edtNumLot.Color      := clWindow;
        edtNumLot.FocusColor := clInfoBk;

        //Req 151661 - Como sugestao o principal para vendas
        If (pnlItemLote.Visible) And (fEmptyStr(edtNumLot.Text) Or 'A DEFINIR'.Equals(edtNumLot.Text)) Then
        Begin
          edtNumLot.Text := fatVenda.objCadLot.fRetArmazemPrincipalVenda(fCodItem);

          If fatVenda.objCadLot.fSaldoLote(fCodItem,strCodEmp,edtNumLot.Text) <= 0 Then
            edtNumLot.Text := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(fCodItem);

          If Not fEmptyStr(edtNumLot.Text) Then
            edtNumLot.ReadOnly := True;
        End;
      End
      Else If (fatVenda.fEhEmissaoDocumentoWMS Or fatVenda.fEmpresaParaFaturamentoUsaWMS(strCodEmp)) Then
      Begin

        If Not fCfgSis('WMSLOT', varBoolean) Then
        Begin
          strCodEmpLot := IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text);
          If fatVenda.objCadLot.fItemTeraLoteDefinidoPeloVendedor(fCodItem, strCodEmpLot, True) Then
          Begin
            edtNumLot.ReadOnly   := False;
            edtNumLot.TabStop    := True;
            edtNumLot.Color      := clWindow;
            edtNumLot.FocusColor := clInfoBk;
          End
          Else
          Begin

            If fEhObrigatorioDefinirLotePickingCheckOut(strCodEmpLot) Then
              fDefinirLotePickingCheckOut(fCodItem, IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text))
            Else
            edtNumLot.Text       := 'A DEFINIR';

            edtNumLot.ReadOnly   := True;
            edtNumLot.TabStop    := False;
            edtNumLot.Color      := $00FFDFB8;
            edtNumLot.FocusColor := $00FFDFB8;

            If fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis(strCodEmp) Then
              btnLoteRapido.Visible := False;

          End;
        End
        Else
        Begin
          If fatVenda.objCadLot.fItemTeraLoteDefinidoPeloVendedor(fCodItem) Then
          Begin
            edtNumLot.ReadOnly   := False;
            edtNumLot.TabStop    := True;
            edtNumLot.Color      := clWindow;
            edtNumLot.FocusColor := clInfoBk;
          End
          Else
          Begin
            edtNumLot.Text       := 'A DEFINIR';
            edtNumLot.ReadOnly   := True;
            edtNumLot.TabStop    := False;
            edtNumLot.Color      := $00FFDFB8;
            edtNumLot.FocusColor := $00FFDFB8;
          End;

        End;

      End
      Else
      Begin
        edtNumLot.ReadOnly   := False;
        edtNumLot.TabStop    := True;
        edtNumLot.Color      := clWindow;
          edtNumLot.FocusColor := clInfoBk;
      End;
    End
    Else
      edtNumLot.Clear;

    if (fUsaSugestaoLoteMenorValidade) and
       (fEmptyStr(edtNumLot.Text)) and
       (pnlItemLote.Visible) and
       (btnAdicionar.Tag <= 0) then
    begin
      strLoteMenorValidade := fatVenda.objCadLot.fRetLoteMenorValidade(fCodItem, strCodEmp, nil);
      edtNumLot.Text := strLoteMenorValidade;
    end;

    if (not fUsaSugestaoLoteMenorValidade) and (fCfgSis('FTLTPR', varBoolean)) then
    begin
      if (pnlItemLote.Visible) And fEmptyStr(edtNumLot.Text) then
        edtNumLot.Text := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(fCodItem);
    end;
  End;

  {***********************************************************************************}
  {* SOMENTE PERMITIDO LOTE "Principal para tinta de maquina" UTILIZANDO ROTINAS WMS *}
  {********************************************************************************JC*}
  If fUsaRotinaWMS(strCodEmp) And pnlItemLote.Visible And ((strIdePro <> 'NOR') Or blnProAca) And
     fatVenda.objCadLot.fExisteLotePrincipalTintaMaquina(strCodIte, strCodEmp) Then
  Begin
    If (fTipoTinta(strIdePro) In [ttImobiliaria]) And fCfgSis('TINWMS', varBoolean, strCodEmp ) Then
      edtNumLot.Text     := 'A DEFINIR'
    Else
      edtNumLot.Text     := fatVenda.objCadLot.fRetLotePrincipalTintaMaquina(strCodIte, strCodEmp);

    if strOpcDoc = 'UC' then
    begin
      edtNumLot.ReadOnly   := False;
      edtNumLot.TabStop    := True;
      edtNumLot.Color      := clWindow;
      edtNumLot.FocusColor := clInfoBk;
    end
    else
    begin
      edtNumLot.ReadOnly   := True;
      edtNumLot.TabStop    := False;
      edtNumLot.Color      := $00FFDFB8;
      edtNumLot.FocusColor := $00FFDFB8;
    end;

    fatVenda.objCadLot.fExisteLote(strCodIte, strCodEmp, edtNumLot.Text);
  End
  Else If (fCfgSis('TMQLOT', varBoolean) Or fInformaLoteBaseImobiliaria(True)) And pnlItemLote.Visible And ((strIdePro <> 'NOR') Or blnProAca) And (Not strCodIte.IsEmpty) Then
  Begin

    If Assigned(matrizFormulacao) Then
    Begin
      stlColorantes := TStringList.Create;
      Try
        strLotPrinciTintaMaquina := fatVenda.objCadLot.fRetLotePrincipalTintaMaquina(strCodIte, strCodEmp);   
      
        If strLotPrinciTintaMaquina.IsEmpty Then
        Begin
          fMensagem('ATENÇÃO!', 'Somente é permitido vender uma tinta que possua '+fatVenda.objCadLot.strDescri+' cadastrado. '+
                                'Verifique o '+fatVenda.objCadLot.strTitCad+' para o produto Base ' + strCodIte + '!', ['&Ok']);
        End

        Else If (Not fInformaLoteBaseImobiliaria(True)) And
                (Not fatVenda.fValidaLoteEmbalagemColorantes(strCodIte, strIdePro, fatVenda.strCodEmb, strCodEmp,
                                                             matrizFormulacao, fatVenda.objCadLot, stlColorantes)) Then
        Begin
          pMensagemSonora('Para vender uma tinta é necessário que todos os Colorantes/Embalagens possuam o ' +
                          '"Lote principal para Tinta Máquina" "'+strLotPrinciTintaMaquina+
                          '" informado corretamente no '+fatVenda.objCadLot.strTitCad+'. Favor verificar o '+fatVenda.objCadLot.strTitCad+' dos produtos: ' +
                          AnsiReplaceStr(stlColorantes.CommaText, ',', ', '));
        End;

        If (Not fInformaLoteBaseImobiliaria(True)) And
           (Not strLotPrinciTintaMaquina.IsEmpty) Then
        Begin
          strLisMsg := ''; 
              
          For intFormulacao := 0 To matrizFormulacao.Count -1 Do
          Begin
            If (strLotPrinciTintaMaquina <> fatVenda.objCadLot.fRetLotePrincipalTintaMaquina(matrizFormulacao[intFormulacao].strCodIte, strCodEmp)) Then
            Begin
              pIncrementaListaStr(matrizFormulacao[intFormulacao].strCodIte+'-'+
                                  fatVenda.objCadLot.fRetLotePrincipalTintaMaquina(matrizFormulacao[intFormulacao].strCodIte, strCodEmp), strLisMsg);
            End;
          End;

          If Not strLisMsg.IsEmpty Then
          Begin
            fMensagem('ATENÇÃO!', 'Os itens de tinta precisam ter o mesmo '+fatVenda.objCadLot.strDescri+' com "Lotes principal para Tinta Máquina" iguais entre o item base e os colorantes: '+#10#13+
                                  'Item Base-"Lotes principal para Tinta Máquina": ' + strCodIte + '-' + strLotPrinciTintaMaquina + #10#13+
                                  'Itens Colorantes-"Lotes principal para Tinta Máquina": ' + strLisMsg+'!', ['&Ok']);
            strLotPrinciTintaMaquina := '';                      
          End;
        End;

        If (Not strLotPrinciTintaMaquina.IsEmpty) Then
        Begin

          edtNumLot.Text       := strLotPrinciTintaMaquina;

          If Not fInformaLoteBaseImobiliaria Then
          Begin
            edtNumLot.ReadOnly   := True;
            edtNumLot.TabStop    := False;
            edtNumLot.Color      := $00FFDFB8;
            edtNumLot.FocusColor := $00FFDFB8;
          End;

          fatVenda.objCadLot.fExisteLote(strCodIte, strCodEmp, edtNumLot.Text);

        End;

      Finally
        FreeAndNil(stlColorantes);
      End;
    End;
  End;

  If (strIdePro = 'NOR') Or (Assigned(fTipoTinta) And (fTipoTinta(strIdePro) In [ttImobiliaria])) Then
  Begin
    If (Not fEmptyStr(edtNumLot.Text)) And
       (Not fatVenda.objCadLot.fExisteLote(strCodIte, strCodEmp, edtNumLot.Text)) Then
    Begin
      edtNumLot.Clear;
    End;

    If (pnlItemLote.Visible) And (Not fEmptyStr(edtNumLot.Text)) Then
    Begin
      edtLocFis.Text := fatVenda.objCadLot.fLocalizacaoFisicaLote(strCodIte, strCodEmp, edtNumLot.Text);
    End;
  End;

  If fUsaRotinaWMS And (Pos(strOpcDoc,'DV_PR_') > 0) And fCfgSis('DEVEND', varBoolean) And
     (Not fatVenda.blnDevolvendoMercadoriaDoEstoqueExterno) Then
  Begin
    If (Not blnMantemLoteOriginalDocumento) Or 
       (blnMantemLoteOriginalDocumento And fEmptyStr(edtNumLot.Text)) Then
    Begin
      edtNumLot.Text       := 'A DEFINIR';
      edtNumLot.ReadOnly   := True;
      edtNumLot.TabStop    := False;
      edtNumLot.Color      := $00FFDFB8;
      edtNumLot.FocusColor := $00FFDFB8;
    End;
  End;

  If (Pos(strOpcDoc,'DV_PR_') > 0) And (Not edtNumLot.ReadOnly) Then
  Begin
    strNumLotDev := '';
    blnExisteCampoNumLotDev := Assigned(qryConDev) And Assigned(qryConDev.FindField('DET_NUMLOT'));
    If blnExisteCampoNumLotDev Then
      strNumLotDev := qryConDev.FieldByName('DET_NUMLOT').AsString;

    If fatVenda.blnDevolvendoMercadoriaDoEstoqueExterno Then
    Begin
      edtNumLot.ReadOnly   := True;
      edtNumLot.TabStop    := False;
      edtNumLot.Color      := $00FFDFB8;
      edtNumLot.FocusColor := $00FFDFB8;
    End
    Else If (blnExisteCampoNumLotDev) And
            ((fEstaRotinaPedidoRetiraEmpLocalSemWMSEmpCDComWMS And (chkEntCD.Checked)) Or
             (fUsaRotinaWMS And fCfgSis('DEVEND', varBoolean) And (blnMantemLoteOriginalDocumento))) Then
    Begin
      edtNumLot.ReadOnly := (qryConDev.FieldByName('DET_NUMLOT').AsString <> '') And
                            (qryConDev.FieldByName('DET_NUMLOT').AsString <> 'A DEFINIR') And
                            fatVenda.objCadLot.fLoteAtivo(qryConDev.FieldByName('DET_NUMLOT').AsString,
                                                          qryConDev.FieldByName('DET_CODEMP').AsString,
                                                          qryConDev.FieldByName('DET_CODITE').AsString);
      If edtNumLot.ReadOnly Then
      Begin
        edtNumLot.TabStop    := False;
        edtNumLot.Color      := $00FFDFB8;
        edtNumLot.FocusColor := $00FFDFB8;
      End;
    End
    Else If (blnExisteCampoNumLotDev) And
            (Not fEmptyStr(strNumLotDev)) And
            ((Not fUsaRotinaWMS) And fCfgSis('DEVEND', varBoolean) And (blnMantemLoteOriginalDocumento)) Then
    Begin
      edtNumLot.ReadOnly := True;
      edtNumLot.TabStop    := False;
      edtNumLot.Color      := $00FFDFB8;
      edtNumLot.FocusColor := $00FFDFB8;
    End;
  End;

  If fUsaRotinaWMS And (Pos(strOpcDoc,'CS_') > 0) Then
  Begin
    edtNumLot.Text       := 'A DEFINIR';
    edtNumLot.ReadOnly   := True;
    edtNumLot.TabStop    := False;
    edtNumLot.Color      := $00FFDFB8;
    edtNumLot.FocusColor := $00FFDFB8;
  End;

  If fUtilizaDefinicaoLoteSeparacaoSemWMS(strCodIte, strCodEmp, strOpcDoc) And
     (pnlItemLote.Visible) And
     (Not edtNumLot.ReadOnly) And
     (fEmptyStr(edtNumLot.Text)) And
     (edtNumLot.Enabled) Then
  Begin
    edtNumLot.Text := 'A DEFINIR';
  End;

  if fAlimentaQtdLoteChapa Then
    fValidaCampos(edtNumLot, True);
End;

function TfrmFatVendas.fDefinirLotePickingCheckOut(strCodIte, strCodEmp : String) : Boolean;

  const
    LOTE_ADEFINIR = 'A DEFINIR';

  var
    strLotPickingCheckOut : String;
    strEmpresa : String;

  function fRetMSG : String;
  begin
    Result := 'Para usar retira caixa é preciso ter um lote vinculado a uma localização Picking Check-out.' + #13 +
              'Acerte os cadastros antes de continuar.';
  end;

begin

  Result := True;

  strEmpresa := IIF(strCodEmp.IsEmpty, VS_strCodEmp, strCodEmp);

  If strCodIte.IsEmpty Or strCodIte.Equals('00000') Then
    Exit;

  If Not TPickingCheckOut.fWMSUtilizaPickingCheckOut Then
    Exit;

  If Not (fatVenda.fEhEmissaoDocumentoWMS Or fatVenda.fEmpresaParaFaturamentoUsaWMS(strCodEmp)) Then
    Exit;

  {*** Operador informa o lote manualmente ***}
  If fCfgSis('WMSLOT', varBoolean) Then
  Begin

    If Not fEmptyStr(edtNumLot.Text) And fEhRetiraCaixa And
       Not TPickingCheckOut.fRetornaLotePickingCheckOut(strCodIte, strEmpresa).Equals(edtNumLot.Text) Then
    Begin
      fMensagem('ATENÇÃO!', 'É obrigatório informar um lote que está vinculado a uma localização picking check-out se o destino do produto for retira-caixa.', ['&Ok']);
      Exit(False);
    End;

    Exit;

  End;

  strLotPickingCheckOut := '';

  If (fEhObrigatorioDefinirLotePickingCheckOut(strEmpresa)) Then
  Begin
    strLotPickingCheckOut := TPickingCheckOut.fRetornaLotePickingCheckOut(strCodIte, strEmpresa);
    If (strLotPickingCheckOut.IsEmpty) Then
    Begin
      fMensagem('ATENÇÃO!', fRetMSG, ['&Ok']);
      Result := False;
    End;
  End;

  edtNumLot.Text := IIF(strLotPickingCheckOut.IsEmpty, LOTE_ADEFINIR, strLotPickingCheckOut);

  If LOTE_ADEFINIR.Equals(edtNumLot.Text) Then
    fltSaldoItemAtu := fRetSaldosEmpresa(strCodIte, strEmpresa)
  Else
    fltSaldoItemAtu := fatVenda.objCadLot.fSaldoLote(strCodIte, strEmpresa, edtNumLot.Text);

  fltSaldoResItemAtu := TSaldoReservado.New(
                          TReservaParametros.New()
                            .EmpresaItem(strEmpresa)
                            .NumeroDocumento(fatVenda.strNumOrc)
                            .CodigoItem(strCodIte)
                            .CodEmpresa(strEmpresa)
                            .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                            .NumeroLote(IIF(LOTE_ADEFINIR.Equals(edtNumLot.Text), '', edtNumLot.Text))
                            .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                         ).fGetQuantidade();

  edtSalDis.Text := FormatFloat(edtQtdIte.EditFormat, (fltSaldoItemAtu - fltSaldoResItemAtu) - fltQtdeDigitada);
  pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
  pHintSaldoDisponivel;

end;

function TfrmFatVendas.fRetornaValorEstrutura(strCodIte: string;
  fltValOri: Double; intIndice: integer): Double;
var
  qryEstrutura: TUniQuery;
begin
  Result := fltValOri;
  qryEstrutura := fCriaQuery(Nil);

  try
    qryEstrutura.Close;
    qryEstrutura.SQL.Clear;
    qryEstrutura.SQL.Add('SELECT SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE1))) AS PREVE1,');
    qryEstrutura.SQL.Add('       SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE2))) AS PREVE2,');
    qryEstrutura.SQL.Add('       SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE3))) AS PREVE3,');
    qryEstrutura.SQL.Add('       SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE4))) AS PREVE4,');
    qryEstrutura.SQL.Add('       SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE5))) AS PREVE5,');
    qryEstrutura.SQL.Add('       SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE6))) AS PREVE6,');
    qryEstrutura.SQL.Add('       SUM((D.DMT_QTDITE * (D.DMT_PRESUB * I.ITE_PREVE7))) AS PREVE7 ');
    qryEstrutura.SQL.Add('FROM GERMAT G');
    qryEstrutura.SQL.Add('INNER JOIN DETMAT D');
    qryEstrutura.SQL.Add('ON(G.AUTOINCREM = D.DMT_SEQGER)');
    qryEstrutura.SQL.Add('INNER JOIN ITEGER I');
    qryEstrutura.SQL.Add('ON(D.DMT_ITESUB = I.ITE_CODITE AND D.DMT_CODEMP = I.ITE_CODEMP)');
    qryEstrutura.SQL.Add('WHERE GMT_CODEMP = :CODEMP');
    qryEstrutura.SQL.Add('AND GMT_CODITE = :CODITE');

    qryEstrutura.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryEstrutura.ParamByName('CODITE').AsString := strCodIte;

    qryEstrutura.Open;

    if (qryEstrutura.IsEmpty) or (qryEstrutura.FieldByName('PREVE'+IntToStr(intIndice)).AsFloat <= 0) then
      Exit;

    Result := fFormataFloat(qryEstrutura.FieldByName('PREVE'+IntToStr(intIndice)).AsFloat, fCfgSis('DECUNI', varInteger));
  finally
    FreeAndNil(qryEstrutura);
  end;
end;

function TfrmFatVendas.fRetornaVolumeProduzido(fltVolPro: Double; strMontad: String; strIdePro: String): Double;
Var
  LFltVolume: Double;
begin
  LFltVolume := fltVolPro;
  Result := LFltVolume;

  If (strIdePro <> 'ALK') Then
    Exit;

  If strTipPre <> 'D' Then
    Exit;

  If (fGetConfTinta(strIdePro).fGet('VOLCAT') = 'S') Then
  Begin
    If strMontad = 'ATL PU' Then
      Result := fFormataFloat((LFltVolume * 6.75) / 9, 3)
    Else If strMontad = 'ATL PU FROTA' Then
      Result := fFormataFloat((LFltVolume * 7) / 9, 3);
  End;
end;

procedure TfrmFatVendas.pCarregaVendedor(strCodOpePar: String='');
  Var
    blnBuscarPorSenha: Boolean;
    blnVendedorEmpLog: Boolean;
begin

  blnBuscarPorSenha := (Not fCfgSis('USADIG', varBoolean));
  blnVendedorEmpLog := (fCfgSis('VENLOJ', varBoolean)) and (Pos(strOpcDoc, 'VN_PD_OR_') > 0);

  If fEmptyStr(strCodOpePar) Then
    strCodOpePar := edtSenVen.Text
  Else
    blnBuscarPorSenha := False;

  pPesquisaCadOpe(qryConOpe, qryConOpe, strCodOpePar, blnBuscarPorSenha, False, blnVendedorEmpLog);

  With qryConOpe Do
  Begin
    edtNomVen.Text     := FieldByName('OPE_NOMOPE').AsString;
    fatVenda.strCodVen := FieldByName('OPE_CODOPE').AsString;
    fatVenda.strNomVen := FieldByName('OPE_NOMOPE').AsString;
    fatVenda.fltComVen := FieldByName('OPE_PERCOM').AsFloat;
    fatVenda.strTipVen := FieldByName('OPE_INTEXT').AsString;
  End;
end;

procedure TfrmFatVendas.pChamaControleProducao;
  Var
    frmConsControleProducao: TfrmConsControleProducao;
begin
  Try
    pCriarFormularios(TfrmConsControleProducao,frmConsControleProducao);
    frmConsControleProducao.dtaDtaPre := StrToDate(mskPreVis.Text);
    frmConsControleProducao.strNumDoc := strNumOrc;
    frmConsControleProducao.strEspDoc := strEspOrc;
    frmConsControleProducao.blnAgendamento := False;        
    frmConsControleProducao.ShowModal;
    if (frmConsControleProducao.ModalResult = mrOk) then
    begin
      if frmConsControleProducao.dtaHPrevi > 0 then
        fatVenda.dtaHPreVi := frmConsControleProducao.dtaHPrevi;
    end;    
  Finally
    FreeAndNil(frmConsControleProducao);
  End;
end;

