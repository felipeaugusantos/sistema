function TfrmFatVendas.fVerificaSaldosConfirmacaoPedidos: Boolean;
  Var
    blnPedSen: Boolean;
    blnSemEst: Boolean;
begin
  Result := False;

  cdsVenda.First;
  If (cdsVenda.IsEmpty) And (fCfgSis('USASER', varBoolean)) Then
  Begin
    Result := True;
  End
  Else
  Begin
    While Not cdsVenda.Eof Do
    Begin
      If cdsVenda.FieldByName('ITE_LIBEST').AsString = 'S' Then
      Begin
        Next;
        Continue;
      End;

      fatVenda.strIdePro := cdsVenda.FieldByName('ITE_IDEPRO').AsString;
      recForTin.Formulas := TClassMatrizSaldosColorantes(fatVenda.dicFormulas.RetornaObjeto(cdsVenda.FieldByName('AUTOINCREM').AsString));

      Result := fTravaSubProduto(cdsVenda.FieldByName('ITE_CODITE').AsString);

      if not Result then
      begin
        Result := fatVenda.fVerificaQtdEstoque(cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                               strOpcDoc,
                                               cdsVenda.FieldByName('ITE_ENTSAI').AsString,
                                               cdsVenda.FieldByName('ITE_NUMORC').AsString,
                                               cdsVenda.FieldByName('AUTOINCREM').AsString,
                                               cdsVenda.FieldByName('ITE_CODITE').AsString,
                                               cdsVenda.FieldByName('ITE_CODACA').AsString,
                                               cdsVenda.FieldByName('ITE_EMPACA').AsString,
                                               cdsVenda.FieldByName('ITE_DESITE').AsString,
                                               cdsVenda.FieldByName('ITE_ENTRET').AsString,
                                               cdsVenda.FieldByName('ITE_ENTFUT').AsString,
                                               cdsVenda.FieldByName('ITE_MOTFUT').AsString,
                                               cdsVenda.FieldByName('ITE_QTDITE').AsFloat,  // fltQuantidade
                                               fatVenda.fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_NUMLOT').AsString, cdsVenda.FieldByName('AUTOINCREM').AsString, cdsVenda.FieldByName('ITE_CODACA').AsString, cdsVenda.FieldByName('ITE_EMPACA').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString),
                                               0,  // fltQtdAnt
                                               IIF(fatVenda.fEmpCarPreenchidaEmpDif(cdsVenda.FieldByName('ITE_EMPCAR').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString),
                                                   cdsVenda.FieldByName('ITE_SALCAR').AsFloat,
                                                   cdsVenda.FieldByName('ITE_SALDOS').AsFloat),
                                               False,
                                               strSemEst,
                                               TRUE,
                                               blnPedSen,
                                               blnSemEst,
                                               recForTin,
                                               False,
                                               cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                                               True,
                                               '',
                                               IIF(fatVenda.fEmpCarPreenchidaEmpDif(cdsVenda.FieldByName('ITE_EMPCAR').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString),
                                                   cdsVenda.FieldByName('ITE_EMPCAR').AsString, ''));
      end
      else
      begin
        Result := fVerificaQtdEstoqueSubProduto(strSemEst,
                                                cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                                cdsVenda.FieldByName('ITE_SALDOS').AsFloat,
                                                fatVenda.fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_NUMLOT').AsString, cdsVenda.FieldByName('AUTOINCREM').AsString, cdsVenda.FieldByName('ITE_CODACA').AsString, cdsVenda.FieldByName('ITE_EMPACA').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString),
                                                cdsVenda.FieldByName('ITE_CODITE').AsString);
      end;

      If Result And (strSemEst = 'S') And blnPedSen Then
      Begin
        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_LIBEST').AsString := 'S';
        cdsVenda.Post;
      End;

      If Not (Result) Then
        Break;

      cdsVenda.Next;
    End;
  End;
end;

