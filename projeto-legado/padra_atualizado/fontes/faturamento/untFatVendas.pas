begin

  Result.blnPermitirApenas1Destino := False;

  If (cdsVenda = Nil) Then
    Exit;

  If (fConfiguradoParaPermitirApenas1Destino) Then
  Begin

    cdsDados := TUniClientDataSet.Create(Nil);

    Try

      pCloneDataSet(cdsDados, cdsVenda);
      cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

      cdsDados.Filtered := False;
      cdsDados.Filter   := 'ITE_EMPITE = ' + QuotedStr(fGetEmpConfigEntrega());
      cdsDados.Filtered := True;

      If Not cdsDados.IsEmpty Then
      Begin

        cdsDados.First;

        Result.blnPermitirApenas1Destino := True;
        Result.intQtdItemEmp := cdsDados.RecordCount;

        If cdsDados.FieldByName('ITE_ENTRET').AsString = 'E' Then
          Result.intIdxEntRet := IDX_ENTREGA
        Else
          Result.intIdxEntRet := IDX_RETIRA;

        If cdsDados.FieldByName('ITE_ENTFUT').AsString = 'S' Then
          Result.intIdxTipEnt := IDX_ENTREGA_FUTURA
        Else
          Result.intIdxTipEnt := IDX_ENTREGA_IMEDIATA;

        Result.intIdxLocRet := fRetLocalRetira(cdsDados.FieldByName('ITE_LOCRET').AsString);
      End;

    Finally
      FreeAndNil(cdsDados);
    End;

  End;

end;

function TfrmFatVendas.fPermitirContinuarVendaSemInformarProdutos: Boolean;
begin
  Result := True;
  {*****************************************}
  {* CASO NAO SEJA NOTA DE COMPLEMENTO     *}
  {* NAO DEIXA CONFIRMAR SE O TOTAL FOR    *}
  {* MENOR OU IGUAL A ZERO                 *}
  {**************************************MV*}
  If strOpcDoc <> 'NC' Then
  Begin

    If (strOpcDoc = 'TR')                   And
       (cdsVenda.IsEmpty) Then
    Begin
      fMensagem('', 'Troca só pode ser confirmada se existir algum lançamento!', ['&O k']);
      Result := False;
      Exit;
    End

    Else If (Pos(strOpcDoc, 'DV_PR_DD_') > 0)                   And
            (cdsVenda.IsEmpty) Then
    Begin
      fMensagem('', 'Devolução só pode ser confirmada se existir algum lançamento!', ['&O k']);
      Result := False;
      Exit;
    End

    Else If (fatVenda.fltTotGer <= 0.0) And
            (Not fatVenda.fEmissaoPedidoBrinde()) And
            (Pos(strOpcDoc, 'TR_DV_PR_EP_DD_') <= 0) And
            (Not fCfgSis('USASER', varBoolean)) Then
    Begin
      fMensagem('', 'Documento com Valor R$ 0,00 não pode ser confirmado!', ['&O k']);
      Result := False;
      Exit;
    End;

  End;
end;

procedure TfrmFatVendas.pInsereItensDevolucao(strTabDev, strNumDoc, strEspDoc, strCodEmp, strCliDev: String; intSeqCom: Integer; pgbStatus: TcxProgressBar);
  Var
    qryIteDev: TUniQuery;
    qryItens: TUniQuery;
    intOrdIte: Integer;
    qryTemp: TDataSet;
    blnDevTin,
    blnPedSen,
    blnSemEst : Boolean;

    qryAux : TUniQuery;
    blnProAca : Boolean;

    recMadeira: TDadosMadeira;

    strTmpDoc,
    strTmpEsp,
    strTmpEmp : String;

    blnTemTintaDeMaquina: Boolean;
    blnProducaoForaLoja : Boolean;
    blnMesmoVendedorDV  : Boolean;
    blnMesmoTipoEntRetDV: Boolean;

    blnImpRef : Boolean;

    blnInseriu: Boolean;
    strClaBri: String;

    strPromocDevolu: String;

    fltImcSTPV : Double;
    blnCalcST : Boolean;
    strNumLot: String;
    blnMantemLoteOriginalDocumento: Boolean;

    LChaveAceOri: String;

    function f(dtsDataset: TDataSet; strNomCam: String): TField;
    begin
      Result := dtsDataset.FieldByName(strNomCam);
    end;

    function fCarregaNumLot(strCodIteDev, strEmpIteDev: String): Boolean;
    begin
      Result := True;

      If (fCfgSis('DEVIGN', varBoolean)) Then
      Begin
        If (strEmpIteDev <> VS_strCodEmp) Then
        Begin           
          If (fUsaRotinaWMS(strEmpIteDev)) And (Not fUsaRotinaWMS(VS_strCodEmp)) And 
             (Not fatVenda.objCadLot.fExisteLote(strCodIteDev, VS_strCodEmp)) Then
          Begin
            Result := False;
          End;
        End;
      End;
    end;
    
begin
  qryIteDev := Nil;
  qryItens  := Nil;
  strTmpDoc := '';
  strTmpEsp := '';
  strTmpEmp := '';
  blnImpRef := (fCfgSis('IMPREF', varBoolean));
  strClaBri := (fCfgSis('CLABRI', varString));
  blnMantemLoteOriginalDocumento := fCfgSis('MANEND', varBoolean);

  If (blnMantemLoteOriginalDocumento) And
     (fCfgSis('FULLAD', VarString) = 'S') And
     (Pos(strOpcDoc, 'DV_PR_') > 0) And
     Assigned(qryConDev) And qryConDev.Active And
     (Not qryConDev.IsEmpty) Then
  Begin
    LChaveAceOri := fRetChaveAcesso(
                      qryConDev.FieldByName('DET_NUMDOC').AsString,
                      qryConDev.FieldByName('DET_ESPDOC').AsString,
                      qryConDev.FieldByName('DET_FORCLI').AsString,
                      qryConDev.FieldByName('DET_CODEMP').AsString,
                      qryConDev.FieldByName('DET_SERIE_').AsString,
                      qryConDev.FieldByName('DET_TIP_FC').AsString);

    If (Not fEmptyStr(LChaveAceOri)) And
       (fCampoTabela('NFE_IMPORT', 'NFEIMP',
                     ['NFE_ACESSO', 'NFE_STATUS'],
                     [LChaveAceOri, 'AT']) = 'S') Then
      blnMantemLoteOriginalDocumento := False;
  End;

  fatVenda.strEntFat := 'S';
  dtaEntImediata     := VS_Date;
  fatVenda.dtaDtEntr := VS_Date;

  blnProAca := false;

  if ( fatVenda.strPigBas = 'S' ) then
  begin
    qryAux := fCriaQuery;

    try
      qryAux.SQL.Clear;
      qryAux.Close;
      qryAux.SQl.text := 'SELECT *  ' +
                         '  FROM '+ fatVenda.strTmpIteDev +' ' +
                         ' WHERE DET_NUMDOC = :NUMDOC '+
                         '   AND DET_ESPDOC = :ESPDOC '+
                         '   AND DET_CODEMP = :CODEMP '+
                         '   AND DET_EMPACA = :EMPACA '+
                         '   AND DET_CODACA = :CODACA ';

      If (intSeqCom > 0) And (Not fatVenda.blnDevolucaoCompleta) Then
        qryAux.SQl.text := qryAux.SQl.text + '   AND DET_SEQCOM = :SEQCOM ';

      qryAux.ParamByName('NUMDOC').AsString := strDocDev;
      qryAux.ParamByName('ESPDOC').AsString := strEspDev;
      qryAux.ParamByName('CODEMP').AsString := strEmpDev;
      qryAux.ParamByName('EMPACA').AsString := strEmpAca;
      qryAux.ParamByName('CODACA').AsString := strCodAca;

      If (intSeqCom > 0) And (Not fatVenda.blnDevolucaoCompleta) Then
        qryAux.ParamByName('SEQCOM').AsInteger := intSeqCom;

      qryAux.Open;

      blnProAca := (qryAux.FieldByName('DET_PROACA').AsString = 'S');

    finally
      FreeAndNil(qryAux);
    end;
  end;

  blnInseriu := False;
  Try
    qryTemp := dbgItens.DataSource.DataSet;
    intOrdIte := qryTemp.RecordCount+1;

    if (blnProAca) then
    begin
      fMensagem('ATENÇÃO!', 'Não é possível incluir um "Produto Acabado" como "Pigmento/Base"!', ['&Ok']);
      Exit;
    end;


    If (fatVenda.blnDevolucaoCompleta) And (qryTemp.Locate('ITE_DOCDEV;ITE_ESPDEV;ITE_EMPDEV', VarArrayOf([strDocDev, strEspDev, strEmpDev]), [])) Or
       (Not fatVenda.blnDevolucaoCompleta) And (qryTemp.Locate('ITE_DOCDEV;ITE_ESPDEV;ITE_EMPDEV;ITE_SEQCOM', VarArrayOf([strDocDev, strEspDev, strEmpDev, intSeqCom]), [])) Then
    Begin
      fMensagem('ATENÇÃO!', 'Este documento já foi incluído!', ['&Ok']);
      Exit;
    End;

    qryIteDev := fCriaQuery(Self);
    qryItens := fCriaQuery(Self);

    qryItens.SQL.Add('SELECT ');
    qryItens.SQL.Add('  CADITE.*, ');
    qryItens.SQL.Add('  ITEGER.*, ');

    IF(fCfgSis('IMPDIG', varString) = '1') Then
      qryItens.SQL.Add('CADITE.ITE_IMPDIR AS IMPDIR, ')
    Else
      qryItens.SQL.Add('ITEGER.ITE_IMPDIR AS IMPDIR, ');

    If fCfgSis('TIPABF') = '1' Then
      qryItens.SQL.Add('CADITE.ITE_CODABF AS CODABF ')
    Else
      qryItens.SQL.Add('ITEGER.ITE_CODABF AS CODABF ');

    qryItens.SQL.Add('FROM ');
    qryItens.SQL.Add('  CADITE ');
    qryItens.SQL.Add('JOIN ITEGER ON ITEGER.ITE_CODITE = CADITE.ITE_CODITE AND ');
    qryItens.SQL.Add('               ITEGER.ITE_CODEMP = :CODEMP ');
    qryItens.SQL.Add('WHERE ');
    qryItens.SQL.Add('  CADITE.ITE_CODITE = :CODITE ');

    Screen.Cursor := crHourGlass;

    Try
      qryIteDev.SQL.Clear;
      qryIteDev.SQL.Add('SELECT ');
      qryIteDev.SQL.Add('  * ');
      qryIteDev.SQL.Add('FROM ');
      qryIteDev.SQL.Add('  ' + fatVenda.strTmpIteDev + ' ');
      qryIteDev.SQL.Add('WHERE ');
      qryIteDev.SQL.Add('  DET_NUMDOC = :NUMDOC AND ');
      qryIteDev.SQL.Add('  DET_ESPDOC = :ESPDOC AND ');
      qryIteDev.SQL.Add('  DET_CODEMP = :CODEMP ');

      If fatVenda.fDocumentoParaFornecedor then
        qryIteDev.SQL.Add('  AND DET_TIP_FC = "F" ')
      Else
        qryIteDev.SQL.Add('  AND DET_TIP_FC = "C" ');

      if fatVenda.strPigBas = 'S' then
        qryIteDev.SQL.Add('  AND DET_PROACA = "N" ');

      If (intSeqCom > 0) And (Not fatVenda.blnDevolucaoCompleta) Then
        qryIteDev.SQL.Add('  AND DET_SEQCOM = :SEQCOM ');


      qryIteDev.ParamByName('NUMDOC').AsString := strDocDev;
      qryIteDev.ParamByName('ESPDOC').AsString := strEspDev;
      qryIteDev.ParamByName('CODEMP').AsString := strEmpDev;

      If (intSeqCom > 0) And (Not fatVenda.blnDevolucaoCompleta) Then
        qryIteDev.ParamByName('SEQCOM').AsInteger := intSeqCom;

      qryIteDev.Open;


      blnDevTin := True;

      //Verifica se existe a dll da tinta especifica no diretorio tintas
      While (Not qryIteDev.Eof) Do
      Begin
        If (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
        Begin
          If (Not IsTintaExistente(qryIteDev.FieldByName('DET_IDEPRO').AsString)) Then
          Begin
            btnCancelarVenda.Click;
            Exit;
          End;
        End;

        qryIteDev.Next;
      End;

      If (fCfgSis('DMOBMV', varBoolean)) And (strOpcDoc = 'DV') Then
      Begin
        blnMesmoVendedorDV := True;
        qryIteDev.First;
        While (Not qryIteDev.Eof) Do
        Begin
          If (qryIteDev.FieldByName('DET_CODVEN').AsString <> fatVenda.strCodVendedorDV) Then
          Begin
            blnMesmoVendedorDV := False;
            Break;
          End;

          qryIteDev.Next;
        End;

        If Not blnMesmoVendedorDV Then
        Begin
          fMensagem('ATENÇÃO!','O sistema está configurado para permitir na devolução apenas documentos do mesmo vendedor. '+
                    ' para conseguir devolver os documentos selecionados, será necessário emitir duas devoluções. (CFG_DMOBMV).', ['&OK']);
          Exit;
        End;
      End;

      If (fCfgSis('DVENRE', varBoolean)) And (strOpcDoc = 'DV') Then
      Begin
        blnMesmoTipoEntRetDV := True;
        qryIteDev.First;
        While (Not qryIteDev.Eof) Do
        Begin
          If (qryIteDev.FieldByName('DET_ENTRET').AsString <> fatVenda.strEntRetDevolucoes) Then
          Begin
            blnMesmoTipoEntRetDV := False;
            Break;
          End;

          qryIteDev.Next;
        End;

        If Not blnMesmoTipoEntRetDV Then
        Begin
          fMensagem('ATENÇÃO!','O sistema está configurado para permitir na devolução apenas documentos de "Entrega" ou "Retira". '+
                    ' para conseguir devolver os documentos selecionados, será necessário emitir duas devoluções. (CFG_DVENRE).', ['&OK']);
          Exit;
        End;
      End;

      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        If qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR' Then
        Begin
          blnDevTin := fatVenda.fPermiteDevolverTintaMaquina('',
                                                             '',
                                                             qryIteDev.FieldByName('DET_NUMDOC').AsString,
                                                             qryIteDev.FieldByName('DET_ESPDOC').AsString,
                                                             qryIteDev.FieldByName('DET_CODEMP').AsString);
          Break;
        End;

        qryIteDev.Next;
      End;

      If Not blnDevTin Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é permitida a devolução de Tinta de Máquina!', ['&O k']);
        Exit;
      End;

      If (strOpcDoc = 'OF') And (Not fGridVendaVazio) Then
      Begin
        If (Not fatVenda.fTemItensDevolucao) Then
        Begin
          pSetFocus(edtQtdIte);
          pMensagemOk('Você já inseriu itens sem referência a um documento. '+
                      'Não é permitida devolução de itens com e sem referência a documentos simultaneamente!');
          Exit;
        End;
      End;

      blnTemTintaDeMaquina := False;

      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        pProgresso(qryIteDev.RecNo, qryIteDev.RecordCount, pgbStatus);

        If (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
        Begin
          blnTemTintaDeMaquina := True;
          Break;
        End;

        qryIteDev.Next;
      End;

      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        If (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') And (fatVenda.strPigBas = 'S') And (qryIteDev.FieldByName('DET_PROACA').AsString = 'S') Then
        Begin
          fMensagem('ATENÇÃO!', Format('O produto [%s - %s] é um produto acabado e não pode ser devolvido como pigmento/base!', [
            qryIteDev.FieldByName('DET_CODITE').AsString, qryIteDev.FieldByName('DET_DESCRI').AsString]), ['&O k']);
          Exit;
        End;

        qryIteDev.Next;
      End;

      If ((intSeqCom > 0) And (Not fatVenda.blnDevolucaoCompleta)) Then
        fMensagem('ATENÇÃO','Foi selecionado um Produto referente a um Combo de Venda, portanto todos os Produtos que compõe este Combo, deverão ser devolvido!' + #13#10 +
                             'O Sistema irá carregar todos os Produtos correspondentes ao Combo automáticamente agora.', ['&O k']);

      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        blnInseriu := False;

        pPegaDocumentoEntregaFutura(strNumDoc, strEspDoc, strCodEmp,
                                    strTmpDoc, strTmpEsp, strTmpEmp,
                                    qryIteDev.FieldByName('DET_CODACA').AsString,
                                    qryIteDev.FieldByName('DET_EMPACA').AsString);



        if not ((fCfgSis('ESTFLJ') = 2) And (fCfgSis('USATMQ') = 'S')   And
          (fVerificarTintaBaixaEntFut(strNumDoc, strEspDoc, strCodEmp)) And
          (Pos(fRetornarClaFisDevolucao(strNumDoc, strEspDoc, strCodEmp), '5922_6922_'+CLAFIS_ENTFUT_VEN) > 0)) Then
        begin
{
          If (Not fEmptyStr(strTmpDoc)) And (fatVenda.strPigBas = 'S') And (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
          Begin
            fMensagem('ATENÇÃO!',' Documento de baixa de entrega futura de tinta de máquina não pode ser devolvido como "pigmento/base" !', ['&Ok']);
            Exit;
          End;
}
        end;

        If fEmptyStr(strTmpDoc) Then
        Begin
          strTmpDoc := strNumDoc;
          strTmpEsp := strEspDoc;
          strTmpEmp := strCodEmp;
        End;

        if (blnTemTintaDeMaquina) And (fatVenda.strPigBas = 'S') and TinGer.fVerificaTinDetBaixado(strNumDoc, strCodEmp, strEspDoc,
            'Os produtos abaixo não podem ser devolvidos como Pigmento/Base pois os mesmos já foram baixados!') then
        Begin
          Exit;
        End;

        If (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
        Begin
          if (fatVenda.strPigBas = 'S') then
          begin
            blnProducaoForaLoja := TinGer.fProducaoForaLoja(strTmpDoc,
                                                            strTmpEmp,
                                                            strTmpEsp,
                                                            qryIteDev.FieldByName('DET_CODACA').AsString,
                                                            qryIteDev.FieldByName('DET_EMPACA').AsString);

            If (blnProducaoForaLoja) And (Not TinGer.fVerificaTinDetExiste(strTmpDoc, strTmpEmp, strTmpEsp)) Then
            Begin
              fMensagem('ATENÇÃO', Format('Não é possivel realizar a devolução do documento %s-%s-%s, ' +
                'pois o mesmo contem tinta de máquina com produção fora de loja, e a formulação de tinta de máquina foi apagada, ' +
                'fazer a devolução como "PRODUTO ACABADO". ', [qryIteDev.FieldByName('DET_NUMDOC').AsString, qryIteDev.FieldByName('DET_ESPDOC').AsString, qryIteDev.FieldByName('DET_CODEMP').AsString]), ['OK']);
              Exit;
            End;

            if (blnProducaoForaLoja) And (not fatVenda.fIsTintaDisponivelEmpresa(qryIteDev.FieldByName('DET_IDEPRO').AsString, qryIteDev.FieldByName('DET_CODEMP').AsString)) then
            begin
              fMensagem('ATENÇÃO', Format('Não é possivel realizar a devolução do produto [%s], ' +
                'pois o mesmo é uma tinta de máquina com produção fora de loja, e a empresa logada [%s] não possui a tinta [%s] disponível ', [
                fatVenda.qryTemporaria.FieldByName('DET_DESCRI').AsString,
                VS_strCodEmp,
                fRetornaNomeTinta(qryIteDev.FieldByName('DET_IDEPRO').AsString)]), ['OK']);
              Exit;
            end;
          end
          Else if (fatVenda.strPigBas = 'N') then
          Begin
            If (TinGer.fVerificaTinDetExiste(strTmpDoc, strTmpEmp, strTmpEsp)) And (Not TinGer.fVerificaTinDetBaixado(strNumDoc, strCodEmp, strEspDoc, qryIteDev.FieldByName('DET_CODACA').AsString, qryIteDev.FieldByName('DET_EMPACA').AsString, '')) Then
            begin
              fMensagem('ATENÇÃO!', Format('O produto [%s - %s] não foi baixado portando não pode ser devolvido como [Produto Acabado]!', [
                qryIteDev.FieldByName('DET_CODITE').AsString, qryIteDev.FieldByName('DET_DESCRI').AsString]), ['&OK']);
              Exit;
            end;
          End;
        End;

        qryItens.Close;
        qryItens.ParamByName('CODITE').AsString := qryIteDev.FieldByName('DET_CODITE').AsString;
        qryItens.ParamByName('CODEMP').AsString := IIF(Not fEmptyStr(qryIteDev.FieldByName('DET_EMPCAR').AsString), qryIteDev.FieldByName('DET_EMPCAR').AsString, VS_strCodEmp);
        qryItens.Open;

        strNumLot := IIF(fCarregaNumLot(f(qryIteDev,'DET_CODITE').AsString, f(qryIteDev,'DET_CODEMP').AsString), f(qryIteDev,'DET_NUMLOT').AsString, '');
        If fUsaRotinaWMS And (Pos(strOpcDoc,'DV_PR_') > 0) And fCfgSis('DEVEND', varBoolean) Then
        Begin
          If (Not blnMantemLoteOriginalDocumento) Or
             (blnMantemLoteOriginalDocumento And fEmptyStr(strNumLot)) Then
            strNumLot := 'A DEFINIR';
        End;

        If SameText(strOpcDoc, 'EF') Then
        Begin
          If (fatVenda.fEhEmissaoDocumentoWMS Or fatVenda.fEmpresaParaFaturamentoUsaWMS(VS_strCodEmp)) Then
          Begin
            If Not fCfgSis('WMSLOT', varBoolean) Then
            Begin
              If Not fatVenda.objCadLot.fItemTeraLoteDefinidoPeloVendedor(fCodItem, VS_strCodEmp, True) Then
              Begin
                If Not fEhObrigatorioDefinirLotePickingCheckOut(VS_strCodEmp) Then
                Begin
                  strNumLot := 'A DEFINIR';
                End;
              End;
            End;
          End;
        End;

        If (strOpcDoc = 'DV') And fEmptyStr(strNumLot) And (fCfgSis('CTLEST') = '2') Then
          strNumLot := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(f(qryIteDev,'DET_CODITE').AsString);

        If (strOpcDoc = 'OF') Then
        Begin
          fatVenda.strIdePro := 'NOR';

          If Not fatVenda.fVerificaQtdEstoque(edtCodEmp.Text,
                                              strOpcDoc,
                                              cmbEntSai.Text[1],
                                              strNumOrc,
                                              IIF(fAlterandoProduto, intToStr(btnAdicionar.Tag), ''),
                                              f(qryIteDev,'DET_CODITE').AsString,
                                              strCodAca,
                                              strEmpAca,
                                              f(qryItens,'ITE_DESITE').AsString,
                                              fDestinoEntRetItem, //ENTREGA/RETIRA
                                              fEntregaFuturaItem, //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                                              fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                              f(qryIteDev,'DET_QTDITE').AsFloat,
                                              fatVenda.fRetQtdDigitada(f(qryIteDev,'DET_CODITE').AsString,
                                                                       strNumLot,
                                                                       f(qryIteDev,'AUTOINCREM').AsString,
                                                                       '',
                                                                       '',
                                                                       ''),
                                              0,
                                              f(qryItens,'ITE_SALDOS').AsFloat,
                                              fAlterandoProduto,
                                              strSemEst,
                                              True,
                                              blnPedSen,
                                              blnSemEst,
                                              recForTin) Then
          Begin
            Exit;
          End;
        End;

        If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
        Begin
          recMadeira.fltComPec := f(qryIteDev,'DET_COMPEC').AsFloat;
          recMadeira.fltLarPec := f(qryIteDev,'DET_LARPEC').AsFloat;
          recMadeira.fltEspPec := f(qryIteDev,'DET_ESPPEC').AsFloat;

          recMadeira.fltQtdPec := fCalculaQuantidadePecas(f(qryIteDev,'DET_QTDITE').AsFloat,
                                                          recMadeira.fltComPec,
                                                          recMadeira.fltLarPec,
                                                          recMadeira.fltEspPec,
                                                          fRetSiglaUnidade(f(qryIteDev,'DET_UNIDAD').AsString));

          recMadeira.strAparel := f(qryIteDev,'DET_APAREL').AsString;
          recMadeira.fltPerApa := f(qryIteDev,'DET_PERAPA').AsFloat;
          recMadeira.strBenefi := f(qryIteDev,'DET_BENEFI').AsString;
          recMadeira.fltPerBen := f(qryIteDev,'DET_PERBEN').AsFloat;
        End;

