procedure TfrmFatVendas.pAtualizaMargemLucroCdsVendas(cdsAtualizado: OleVariant; const intAutIncCalcMar: Integer);
  Var
    prcScroll : Tprcscroll;
    cdsItens : TUniClientDataSet;
    strFilter : String;
    blnFiltered : Boolean;
begin
  If (cdsVenda = nil) Or
     (Not cdsVenda.Active) Or
     (cdsVenda.IsEmpty) Then
    Exit;

  cdsItens := TUniClientDataSet.Create(Self);
  cdsItens.Data := cdsAtualizado;
  cdsItens.LogChanges := False;
  cdsItens.IndexFieldNames := 'AUTOINCREM';

  pDisableControls(cdsVenda, prcScroll);
  Try
    strFilter := cdsVenda.Filter;
    blnFiltered := cdsVenda.Filtered;
    Try
      fatVenda.objCopiaSegVenda.pDisableEventHandlers;

      If (intAutIncCalcMar <> -1) Then
      Begin
        cdsVenda.Filtered := False;
        cdsVenda.Filter := 'AUTOINCREM = ' + IntToStr(intAutIncCalcMar);
        cdsVenda.Filtered := True;
      End;

      cdsVenda.First;
      While Not cdsVenda.Eof Do
      Begin
        If (Not cdsItens.FindKey([cdsVenda.FieldByName('AUTOINCREM').AsString])) Then
        Begin
          cdsVenda.Next;
          Continue;
        End;

        cdsVenda.Edit;
        If (cdsItens.FindField('ITE_MARLUC') <> Nil) Then
          cdsVenda.FieldByName('ITE_MARLUC').AsFloat := cdsItens.FieldByName('ITE_MARLUC').AsFloat;
        If (Pos(fCfgSis('MCAT17'),'S_D_A_C_M_V_') > 0) Then
          If (cdsItens.FindField('ITE_MARCAT') <> Nil) Then
            cdsVenda.FieldByName('ITE_MARCAT').AsFloat := cdsItens.FieldByName('ITE_MARCAT').AsFloat;
        cdsVenda.Post;

        cdsVenda.Next;
      End;
    Finally
      If (intAutIncCalcMar <> -1) Then
      Begin
        cdsVenda.Filtered := False;
        cdsVenda.Filter := strFilter;
        cdsVenda.Filtered := blnFiltered;
      End;
      cdsVenda.Last;
      fatVenda.objCopiaSegVenda.pEnableEventHandlers(True, False);
    End;
  Finally
    pEnableControls(cdsVenda, prcScroll);
    FreeAndNil(cdsItens);
  End;
end;

