procedure TfrmFatVendas.pAjustaTamanhoDescricaoItemGrid;
var
  intColumn: Integer;
  intTamUti: Integer;
const
  intValMin: Integer = 240;
begin
  intTamUti := 0;
  For intColumn := 0 To dbgItens.Columns.Count -1 Do
    With dbgItens.Columns[intColumn] Do
      If Visible And (FieldName <> 'ITE_DESITE') Then
        Inc(intTamUti, Width);

  {Obrigatório tamanho mínimo, senão deixa barra de rolagem horizontal}
  If (dbgItens.Width - intTamUti - 60) >= intValMin Then
  Begin
    fFindColumnByName(dbgItens, 'ITE_DESITE').Width := (dbgItens.Width - intTamUti - 60);
    dbgItens.Options := dbgItens.Options + [dgRowSelect];
    blnRowSelect := True;
  End
  Else
  Begin
    fFindColumnByName(dbgItens, 'ITE_DESITE').Width := intValMin;
    dbgItens.Options := dbgItens.Options - [dgRowSelect];
    blnRowSelect := False;
  End;
end;

procedure TfrmFatVendas.pAjustaPanelDadosItemFixo;
Var
  intControl: Integer;
  intHeight : Integer;
begin
  intHeight := 0;

  For intControl := 0 To pnlDadosItemFixo.ControlCount - 1 Do
    If pnlDadosItemFixo.Controls[intControl] Is TPanel Then
      If TPanel(pnlDadosItemFixo.Controls[intControl]).Visible Then
        Inc(intHeight, TPanel(pnlDadosItemFixo.Controls[intControl]).Height);

  pnlDadosItemFixo.Height := intHeight + 3;
end;

procedure TfrmFatVendas.pSugerirCondicaoDePagto();
begin
  //Caso sugestao da condicao seja do cadastro do Cliente
  If (fCfgSis('SGCNDV') = '2') And qryConCli.Active And Assigned(qryConCli.FindField('CND_CODCND')) Then
  Begin
    edtCodCnd.Text     := qryConCli.FieldByName('CND_CODCND').AsString;
    fatVenda.strCodCnd := edtCodCnd.text;
    strCndAnt          := fatVenda.strConPag;
    fatVenda.strConPag := fRetConPagCodCnd(fatVenda.strCodCnd);
    mskCndPag.Text     := fatVenda.strConPag;
    pCarregaCondicao;
  End;

  //Caso sugestao seja a vista ou nao tenha condicao para o cliente
  If (fCfgSis('SGCNDV') = '1') Or fEmptyStr(fatVenda.strConPag) Then
  Begin
    fatVenda.strCodCnd := fCfgSis('CNDAVI', varString);
    edtCodCnd.Text     := fatVenda.strCodCnd;
    strCndAnt          := '01000';
    fatVenda.strConPag := '01000';
    mskCndPag.Text     := '01000';
  End;
end;

