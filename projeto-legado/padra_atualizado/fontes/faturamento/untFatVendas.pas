    Exit;

  if fCampoTabela('OPE_CASOPE', 'CADOPE', ['OPE_CODOPE'], [strCodVen], False) <> 'S' then
    Exit;

  Result := fRetSenhaVendedor(strCodVen);
end;

function TfrmFatVendas.fRetSQLVendedoresPermitidos: String;
  Var
    strCodVenEsp: String;
begin
  strCodVenEsp := fCfgSis('VENESP');

  Result :=
         '  SELECT ' +
         '    CVE_CODVEN AS CODVEN, ' +
         '    OPE_NOMOPE AS NOMVEN  ' +
         '  FROM ' +
         '    CLIVEN INNER JOIN CADOPE ON OPE_CODOPE = CVE_CODVEN ' +
         '  WHERE ' +
         '    CVE_CODCLI = :CODCLI ' +

         '  UNION ALL ' +

         '  SELECT ' +
         '    CLI_CODVEN AS CODVEN, ' +
         '    OPE_NOMOPE AS NOMVEN  ' +
         '  FROM ' +
         '    CADCLI INNER JOIN CADOPE ON OPE_CODOPE = CLI_CODVEN ' +
         '  WHERE ' +
         '    CLI_CODCLI = :CODCLI ';

  If Not fEmptyStr(strCodVenEsp) Then
  Begin
  Result := Result +
         '  UNION ALL ' +

         '  SELECT ' +
         '    CAST("'+strCodVenEsp+'" AS CHAR(3)) AS CODVEN, ' +
         '    CAST(CONCAT("'+fRetNomVendRep(strCodVenEsp)+'", " (CFG_VENESP)") AS CHAR(90)) AS NOMVEN ';
  End;

  Result := ' SELECT DISTINCT UPPER(CODVEN) AS CODVEN, NOMVEN FROM ('+Result+') AS VW ';
end;

function TfrmFatVendas.fPermiteAlterarVendedor: Boolean;
  Var
    blnMltOpe : Boolean;
    blnAltVen : Boolean;
begin
  blnAltVen := fCfgSis('ALTVEN', varBoolean);
  blnMltOpe := fCfgSis('MLTOPE', varBoolean);

  Result := blnAltVen;

  If (Not Result) Then
    Result := blnMltOpe;

  If (fEntraNaRegraDeFidelizacao) Then
  Begin
    If (Not fEmptyStr(fCfgSis('VENESP'))) And (fCfgSis('VENESP') = fCampoTabela('CLI_CODVEN', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli])) Then
      Result := True
    Else If fClienteNuncaMovimentou(fatVenda.strCodCli) Then
      Result := True
    Else If (fPerdeuFidelidade) Then
      Result := True
    Else If (Result) And (blnMltOpe) And (Not blnAltVen) Then
      Result := (fCampoTabela('COUNT(*)', 'CLIVEN', ['CVE_CODCLI'], [fatVenda.strCodCli]) > 0);
  End;
end;

function TfrmFatVendas.fVendedorPermitido(strCodCli,
  strCodVen: String): Boolean;
  Var
    qryGen: TUniQuery;
begin
  Result := True;

  qryGen:= fCriaQuery(Nil);
  Try
    qryGen.SQL.Text := fRetSQLVendedoresPermitidos;
    qryGen.ParamByName('CODCLI').AsString := strCodCli;
    qryGen.Open;

    If (Not qryGen.IsEmpty) Then
      Result := qryGen.Locate('CODVEN', strCodVen, []);

  Finally
    FreeAndNil(qryGen);
  End;

end;

function TfrmFatVendas.fVendedorPermitidoSeUsandoMultiVendedores(strCodCli, strCodVen: String; blnMostraListaVendedores: Boolean=True): Boolean;
   Var
     qryGen: TUniQuery;
begin
  Result := True;

  If (fEntraNaRegraDeFidelizacao) Then
  Begin
    If (fPerdeuFidelidade) Then
      Exit;
  End;

  If fatVenda.fDocumentoParaFornecedor Then
    Exit;

  If (Not fEmptyStr(fCfgSis('VENESP'))) And (fCfgSis('VENESP') = fCampoTabela('CLI_CODVEN', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli], False)) Then
    Exit;

  If fClienteNuncaComprou(fatVenda.strCodCli) Then
    Exit;

  If (fCfgSis('MLTOPE', varBoolean)) And (Not fCfgSis('ALTVEN', varBoolean)) Then
  Begin
    qryGen:= fCriaQuery(Nil);
    Try
      qryGen.SQL.Text := fRetSQLVendedoresPermitidos;
      qryGen.ParamByName('CODCLI').AsString := strCodCli;
      qryGen.Open;

      If (qryGen.IsEmpty) Then
      Begin
        Result := False;

        fMensagem('ATENÇÃO!', 'Sistema configurado para permitir a associação de mais de um vendedor por cliente (CFG_MLTOPE) com restrição para alterá-los na venda (CFG_ALTVEN), no entanto, '+
                              'não há nenhum vendedor padrão configurado para: '+strCodCli+'! Preencha corretamente o Cadastro do Cliente, campo "Vendedor" e/ou "[F4] Vendedores"',['&OK']);
      End
      Else
      Begin
        Result := qryGen.Locate('CODVEN', strCodVen, []);

        If (Not Result) And (blnMostraListaVendedores) Then
        Begin
          pCriarFormularios(TfrmObservacao, frmObservacao);
          Try
            frmObservacao.Caption := 'Sistema configurado para restringir a alteração do Vendedor'+IIF(fCfgSis('REPVEN', varBoolean),' 1','')+'.';
            frmObservacao.lblMensagem.Caption := 'Serão permitidos para esse cliente os seguintes vendedores:';

            qryGen.First;
            While Not qryGen.Eof Do
            Begin
              frmObservacao.memObs.Lines.Add(qryGen.FieldByName('CODVEN').Text+' - '+qryGen.FieldByName('NOMVEN').Text);
              qryGen.Next;
            End;

            frmObservacao.ShowModal;
          Finally
            pFreeAndNil(frmObservacao);
          End;
        End;
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

function TfrmFatVendas.fPermiteAtivarComboVenda(strIdePro, strCodIte: String): Boolean;
begin
  Result := True;

  If (strIdePro <> 'NOR') Then
    Result := False;

  If (fEhItemServico(strCodIte)) Then
    Result := False;

  If ((blnUtilizaVendaVidro) And (fEhItemVendaVidro(strCodIte))) Then
    Result := False;

  If ((blnUtilizaVendaMadeira Or blnUtilizaVendaMetroLinear) And
     (fMetragemObrigatoria(fRetUnidadeItem(strCodIte)))) Then
    Result := False;

  If ((blnUtilizaVendaMadeira Or blnUtilizaVendaMetroLinear) And
     (fPermiteAparelhamentoBeneficiamento(fRetUnidadeItem(strCodIte)))) Then
    Result := False;
end;

procedure TfrmFatVendas.pCarregaItensAlteracao(blnFoca: Boolean = True);
var
  blnItemEspecial   : Boolean;
  RecResult1Destino : TRecResult1Destino;
  strIteBkp: String;
  fltQtdBkp: Double;
  blnFiltraExiLis: Boolean;
begin

  If fatVenda.strOpcDoc = 'CO' Then
    Exit;

  If (Not blnFoca) Then
    dbgItens.DataSource.DataSet.AfterScroll := Nil;

  Try
    With cdsVenda Do
    Begin

      If Not IsEmpty Then
      Begin

        If blnFoca Then
          pAtualizaDados(Nil);

        pHabilitaCamposItem(True);

        pDesabilitaTabPreItem(fRetornaTabPreCodBarraEmb(FieldByName('ITE_CODITE').AsString,
                                                        FieldByName('ITE_BAREMB').AsString),
                                                        False);

        strIteAnt := edtCodIte.Text;

        If (blnFoca) Then
          pCarregaItem(True, False, False, False, True, False, FieldByName('ITE_SEQEST').AsInteger > 0)
        Else
        Begin
          blnFiltraExiLis := (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) And (Not fatVenda.blnEmpFat);
          pPesquisaCadIte(Nil, qryConCit, edtCodIte.Text, '', False, False, True, blnFiltraExiLis);

          If (Not qryConIte.Active) Or qryConIte.IsEmpty Or
             (qryConIte.FieldByName('ITE_CODITE').AsString <> qryConCit.FieldByName('ITE_CODITE').AsString) Then
          Begin
            pAtualizaQryConIte;
          End;

          blnItemEspecial := (Pos('ITEM ESPECIAL', FieldByName('ITE_DESITE').AsString) > 0);

          If (blnItemEspecial) Or (fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString)) Or (fatVenda.fEhConsertoEquipamento) Or
             ((fCfgSis('EDIFAT', varBoolean)) And (FieldByName('ITE_IDEPRO').AsString = 'NOR')) Or
             ((fCfgSis('EDITIN', varBoolean)) And (FieldByName('ITE_IDEPRO').AsString <> 'NOR')) Then
          Begin
            edtDesIte.ReadOnly := False;
            edtDesIte.TabStop  := TRUE;
            edtUnidad.ReadOnly := False;
            edtUnidad.TabStop  := TRUE;
          End
          Else
          Begin
            edtDesIte.ReadOnly := True;
            edtDesIte.TabStop  := FALSE;
            edtUnidad.ReadOnly := True;
            edtUnidad.TabStop  := FALSE;
          End;

        End;

        If qryConCit.FindField('ITE_DESCND') <> NIL Then
          fatVenda.strDstCnd := qryConCit.FieldByName('ITE_DESCND').AsString;

        If fCfgSis('DESCND',varBoolean) Then
        Begin
          pEditarPrecoUnitario;
          pEditarDesconto;
        End;

        If fCfgSis('ALTSIM', VarBoolean) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (fAlterandoProduto) Then
        Begin
          strIteBkp := edtCodIte.Text;
          If fMostraItensSimilares(edtCodIte.Text) And (strIteBkp <> edtCodIte.Text) Then
          Begin
            fltQtdBkp := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
            strIteBkp := edtCodIte.Text;
            blnAlteracaoSimilares := True;
            pDeletaItemAndCalculaTotais;
            btnCancelaItem.Click;
            edtCodIte.Text := strIteBkp;
            pCarregaItem(True, True);
            pAtualizaQryConIte;
            edtQtdIte.Text := FloatToStrF(fltQtdBkp, ffFixed,12, fCfgSis('DECQTD', varInteger));
          End;
        End;

        edtCodIte.Enabled := False;
        blnIteAlt := True;

        If (Not fEmptyStr(FieldByName('ITE_BAREMB').AsString)) And
           (fCfgSis('PREEMB', VarInteger) = 2)                 And
           (fCfgSis('PRVEMB', VarBoolean))                     Then
        Begin
          strTabPreEmb := FieldByName('ITE_TABPRE').AsString;
          fatVenda.strTabPre := strTabPreEmb;
        End;

        // Se permitir apenas 1 destino e houver apenas 1 item, pode alterar o destino
        RecResult1Destino := fPermitirApenas1Destino;
        If RecResult1Destino.blnPermitirApenas1Destino And (RecResult1Destino.intQtdItemEmp <= 1) Then
          pEnabledDestino(True);

        pHabilitaDesabilitaTipoDeEntregaLocalRetira(btnAdicionar.Tag=0);

{        If (fatVenda.strIdePro <> 'NOR') And (Not fTintaBaixaProduto(fatVenda.strIdePro))    Then
        Begin
          edtQtdIte.Enabled := False;
        End;}

        If fatVenda.blnFromOrdemProducao Then
          edtQtdIte.Enabled := False;

        If fLoteChapa(edtCodIte.Text, FCodEmp, edtNumLot.Text, False) Then
          edtQtdIte.Enabled := False;

        If blnFoca Then
        Begin

          If edtDesIte.Enabled Then
          Begin
            pSetFocus(edtDesIte);
          End
          Else If (cbbComple.Enabled) And (cbbComple.Visible) Then
          Begin
            pSetFocus(cbbComple);
          End
          Else If (edtQtdIte.Enabled) And (edtQtdIte.Visible) Then
          Begin
            pSetFocus(edtQtdIte);
          End
          Else
            pSetFocus(edtUnitar);

        End;

        {Req: 126003
         Ao alterar, verifica se foi solicitado abastecimento para esse item, os campos...
         Quantidade e Empresa são bloqueados, porém é permitido alterar os valores!}
        If (not fEmptyStr(fatVenda.strNumOrc)) and (fAlterandoProduto) Then
        Begin
          blnBloqueio_Abastecimento := Not FieldByName('ITE_PODALT').AsBoolean;
          pBloqueioAbastecimento(blnBloqueio_Abastecimento);
        End;

        blnBloqueio_ItemCombo := ((fItemCombo) Or (fBloqueiaAlteracaoDeCombo)) And (fAlterandoProduto);
        pBloqueioItemCombo(blnBloqueio_ItemCombo);

        If ((fatVenda.strOpcDoc = 'PD') Or (fatVenda.strEspDoc = 'PD')) And
           (fCfgSis('F11FPD', varBoolean)) Then
          blnTipBusCodBar := (FieldByName('ITE_LCTBAR').AsString = 'S');
      End
      Else
      Begin
        edtCodIte.Enabled := True;
        If (pnlDadosItem.Enabled) Then
          btnCancelaItem.Click;
//          pSetFocus(edtCodIte);
      End;

    End;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[pCarregaItensAlteracao]');
    End;
  End;

  If (Not blnFoca) Then
    dbgItens.DataSource.DataSet.AfterScroll := pAtualizaDados;

end;

procedure TfrmFatVendas.pCalculaTotais(blnAplicaDescontos: Boolean = False; intAutIncCalcMar: Integer = -1; pgbStatus: TcxProgressBar = Nil; blnRecalcularMarLuc: Boolean = True);

  Const
    SEP_MAR_CAM : String = ' / ';

  function fCamuflarValor(fltValor: Double): String;
  begin
    Result := Trim(FormatFloat('#,##0.00', fltValor));
    Result := AnsiReplaceStr(Result, ',', '');
    Result := AnsiReplaceStr(Result, '.', '');
    Result := RightStr(fReplicatorStr('0', 09) + Result, 09);
  end;

  procedure pSetarValorCamuflagem(strValor : String);
  begin
    lblMarCam.Caption := lblMarCam.Caption + strValor + SEP_MAR_CAM;
  End;

  Var
    strTotCus      : String;
    strTotCu2      : String;
    strTotBru      : String;
    strMarLiq      : String;
    strMarLiqSemDesOpe : String;
    strMarBru      : String;
    strMarBruVlr   : String;
    strMarLiqVlr   : String;
    strDescTotDocPerc : String;
    strCuReMZ      : String;
    strMarPreUltBru: String;
    strMarPreUltLiq: String;
    strMarPreMedBru: String;
    strMarPreMedLiq: String;
    strMarCadastro_: String;

    strMkpBru      : String;
    strMkpLiq      : String;
    strTotAtu      : String;
    strMarPraBrut  : String;

    fltMargem      : Double;
    fltTotIpi      : Double;
    fltSohIpi      : Double;
    fltSohST       : Double;
    fltSohFCP      : Double;
    fltPonBri      : Double;
    blnHabilita    : Boolean;
    fltTotIteSemImpComDes: Double;

    fltPesTot      : Double;
    fltLitTot      : Double;
    fltTotAtu      : Double;

    cdsDados       : TUniClientDataSet;

    recTotMarLuc : TRecTotaisMargemLucro;

    cdsData: OleVariant;

    fltTotImp: Double;
    fltTotCu2: Double;

    fltSohCBS: Double;
    fltSohIBS: Double;
    fltSohIS: Double;

    intCnt    : Integer;
    fltTotDescPerc: Double;
    fltLITGAL : Double;
    strCustoRealSemDesOpe : String;
    fltTotCre: Double;
    fltTotBru: Double;

    blnRestringirElementosMargemOriginal: Boolean;
    blnPrecisaRecalcularMargens : Boolean;

    function fAggr(FieldAgg: TField): Variant;
    Begin

      If TAggregateField(FieldAgg).Value = Null Then
        Result := 0
      Else
        Result := TAggregateField(FieldAgg).Value;

    End;

    procedure pAcumulaNovosImpostos;
      Var
        intSinal: Integer;
    Begin
      fltSohCBS := 0;
      fltSohIBS := 0;
      fltSohIS  := 0;

      If (Not cdsDados.Active) Or (cdsDados.IsEmpty) Then
        Exit;

      cdsDados.First;
      While Not cdsDados.Eof Do
      Begin
        If SameText(cdsDados.FieldByName('ITE_ENTSAI').AsString, 'E') Then
          intSinal := -1
        Else
          intSinal := 1;

        fltSohCBS := fltSohCBS + (intSinal * cdsDados.FieldByName('ITE_VALCBS').AsFloat);
        fltSohIBS := fltSohIBS + (intSinal * cdsDados.FieldByName('ITE_VALIBS').AsFloat);
        fltSohIS  := fltSohIS  + (intSinal * cdsDados.FieldByName('ITE_VAL_IS').AsFloat);

        cdsDados.Next;
      End;
    End;

begin

  cdsDados := fCriaTemporaria(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.LogChanges := False;

    pAcumulaNovosImpostos;

    pInformacao('Aguarde, Calculando totais da venda', pgbStatus);

    If (fCfgSis('EXIPRO', varString) = 'S') And (Pos(strOpcDoc, 'VN_OR_PD_') > 0) Then
      TPromocaoBrindes.pCalculaPontosGeradosVenda(cdsDados, strOpcDoc);

    Try
      With cdsDados Do
      Begin

        Filter := 'ITE_ENTSAI = ' + QuotedStr('E');
        Filtered := True;
        Active := False;
        Active := True;

        fltTotImp          := (-1) * fAggr(FieldByName('TOT_TOTITE'));
        fatVenda.fltTotGer := (-1) * fAggr(FieldByName('TOT_TOTUNI'));
        fatVenda.fltVlrBru := (-1) * fAggr(FieldByName('TOT_TOTUNI'));
        fatVenda.fltTotCus := (-1) * fAggr(FieldByName('TOT_TOTCUS'));
        fltTotIpi          := (-1) * fAggr(FieldByName('TOT_TOTIPI')) + fAggr(FieldByName('TOT_TOTITE'));
        fltSohIpi          := (-1) * fAggr(FieldByName('TOT_TOTIPI'));
        fltSohST           := (-1) * fAggr(FieldByName('TOT_TOTRET'));
        fltSohFCP          := (-1) * fAggr(FieldByName('TOT_VFCPST'));
        fltTotCu2          := (-1) * fAggr(FieldByName('TOT_TOTCU2'));
        fltPonBri          := (-1) * fAggr(FieldByName('TOT_PONBRI'));
        fltTotAtu          := (-1) * fAggr(FieldByName('TOT_PREATU'));
        fltTotBru          := (-1) * fAggr(FieldByName('TOT_BRUEMB'));

        Filtered := False;
        Filter := 'ITE_ENTSAI = ' + QuotedStr('S');
        Filtered := True;
        Active := False;
        Active := True;

        fltPesTot := fAggr(FieldByName('TOT_PESOIT'));

        {Total Litragem}
        If SameText(fCfgSis('LITGAL'), 'L') Then
          fltLITGAL := 1
        Else
          fltLITGAL := FLT_LITRO_GALAO;

        fltLitTot := fAggr(FieldByName('TOT_LITRAG')) / fltLITGAL;

        fltTotImp          := fltTotImp + fAggr(FieldByName('TOT_TOTITE'));
        fatVenda.fltTotGer := fatVenda.fltTotGer + fAggr(FieldByName('TOT_TOTUNI'));
        fatVenda.fltVlrBru := fatVenda.fltVlrBru + fAggr(FieldByName('TOT_TOTUNI'));
        fatVenda.fltTotCus := fatVenda.fltTotCus + fAggr(FieldByName('TOT_TOTCUS'));
        fltTotIpi          := fltTotIpi + fAggr(FieldByName('TOT_TOTITE')) + fAggr(FieldByName('TOT_TOTIPI'));
        fltSohIpi          := fltSohIpi + fAggr(FieldByName('TOT_TOTIPI'));
        fltSohST           := fltSohST  + fAggr(FieldByName('TOT_TOTRET'));
        fltSohFCP          := fltSohFCP + fAggr(FieldByName('TOT_VFCPST'));
        fltTotCu2          := fltTotCu2 + fAggr(FieldByName('TOT_TOTCU2'));
        fltPonBri          := fltPonBri + fAggr(FieldByName('TOT_PONBRI'));
        fltTotAtu          := fltTotAtu + fAggr(FieldByName('TOT_PREATU'));
        fltTotBru          := fltTotBru + fAggr(FieldByName('TOT_BRUEMB'));
      End;

      edtTotGer.Text := FormatFloat('#,##0.00', fltTotImp);
      edtTotIpi.Text := FormatFloat('#,##0.00', fltTotIpi);
      edtSohIPI.Text := FormatFloat('#,##0.00', fltSohIpi);
      edtSohST.Text  := FormatFloat('#,##0.00', fltSohST );
      edtSohFCP.Text := FormatFloat('#,##0.00', fltSohFCP );
      edtTotCBS.Text := FormatFloat('#,##0.00', fltSohCBS );
      edtTotIBS.Text := FormatFloat('#,##0.00', fltSohIBS );
      edtTotIS.Text  := FormatFloat('#,##0.00', fltSohIS  );
      lblQtdPon.Caption := 'Total Pontos: ' + FormatFloat('#,##0.00', fltPonBri);
      lblQtdPon.Visible := (fCfgSis('EXIPRO', varString) = 'S') And (Pos(strOpcDoc, 'VN_OR_PD_') > 0);

      If (ckbAbCrAu.Checked) Then
        fltTotCre := fGetTotalCredCli(edtCodCli.Text, strNumOrc, strEspOrc, strEmpOrc, blnUsaEmpOri)
      Else
        fltTotCre := 0;

      If Not fDigitarServicoInicioVenda Then
      Begin
        If blnExiPar Then
          edtTotImp.Text := FormatFloat('#,##0.00', (fltTotImp + fltSohIpi + fltSohST + fltSohFCP + fltSohCBS + fltSohIBS + fltSohIS - fltTotCre) / StrToIntDef(LeftStr(fatVenda.strConPag, 2), 1))
        Else
          edtTotImp.Text := FormatFloat('#,##0.00', fltTotImp + fltSohIpi + fltSohST + fltSohFCP + fltSohCBS + fltSohIBS + fltSohIS - fltTotCre);
      End
      Else
      Begin
        If blnExiPar Then
          edtTotImp.Text := FormatFloat('#,##0.00', (fltTotImp + fltSohIpi + fltSohST + fltSohFCP + + fltSohCBS + fltSohIBS + fltSohIS + fatVenda.fltTotSer - fltTotCre) / StrToIntDef(LeftStr(fatVenda.strConPag, 2), 1))
        Else
          edtTotImp.Text := FormatFloat('#,##0.00', fltTotImp + fltSohIpi + fltSohST + fltSohFCP + + fltSohCBS + fltSohIBS + fltSohIS + fatVenda.fltTotSer - fltTotCre);

        edtTotSer.Text := FloatToStrF( fatVenda.fltTotSer, ffNumber, 12, 2 );
      End;

      lblPesTot.Caption      := 'Peso Total: ' + FormatFloat('#,##0.00', fltPesTot);
      lblTotLitragem.Caption := 'Tot. Litragem: ' + FormatFloat('#,##0.00', fltLitTot);

      strTotCus := fCamuflarValor(fatVenda.fltTotCus);
      strTotCu2 := fCamuflarValor(fltTotCu2);
      strTotBru := fCamuflarValor(fatVenda.fltVlrBru);
      strTotAtu := fCamuflarValor(fltTotAtu);

      {Calcula total do desconto em percentual}

      fltTotDescPerc := 0;

      if fltTotBru > 0 then
        fltTotDescPerc    := (1- (fltTotImp / fltTotBru)) * 100;

      strDescTotDocPerc := fCamuflarValor(fltTotDescPerc);

      fltMargem := 0;

      blnHabilita := True;
      If cdsVenda.IsEmpty Then
        blnHabilita := False;

      pInformacao('Aguarde, Calculando total dos produtos', pgbStatus);

      blnPrecisaRecalcularMargens := True;
      If (Not blnRecalcularMarLuc) Then
        blnPrecisaRecalcularMargens := (strMarCam.Contains('S')) Or (shpMargemDoc.Visible) Or (fUtilizaSinaleiro);

      FillChar(recTotMarLuc, SizeOf(recTotMarLuc), #0);

      If (blnPrecisaRecalcularMargens) Then
      Begin
        {Req.: 280794}
        blnRestringirElementosMargemOriginal := fatVenda.blnRestringirElementosMargem;
        Try
          fatVenda.blnRestringirElementosMargem := True;
          cdsData := fatVenda.fCalculaMargemLucro(blnAplicaDescontos, intAutIncCalcMar, pgbStatus, False, False, True);
          fatVenda.pCalculaTotaisMargemLucro(cdsData,
                                             recTotMarLuc,
                                             0,
                                             False,
                                             intAutIncCalcMar);

          pAtualizaMargemLucroCdsVendas(cdsData, intAutIncCalcMar);
        Finally
          fatVenda.blnRestringirElementosMargem := blnRestringirElementosMargemOriginal;
        End;
      End;

      fltTotIteSemImpComDes := recTotMarLuc.fltTotUnitar; //TOTAL DOS ITENS COM DESCONTO APLICADO MAS SEM IMPOSTOS

      If blnHabilita Then
      Begin
        {****************************************}
        {* CALCULAR MARGEM DE LUCRO             *}
        {****************************************}
        fltMargem := fCalculaPrecoVenda(2, fatVenda.fltTotCus,
                                        fltTotIteSemImpComDes,
                                        0, 0, 0, 0, 0, fatVenda.VS_strMARMKP,
                                        fCfgSis('PCMPRO'), fCfgSis('DECUNI'), 0, False, 0, 0, 0, fatVenda.fRestringirElementosMargem);
      End;

      strMarBru := fCamuflarValor(fltMargem);
      strMarLiq := fCamuflarValor(recTotMarLuc.fltTotMarPrat);
      strMarLiqSemDesOpe := fCamuflarValor(recTotMarLuc.fltTotMarPratSemDesOpe);
      strCuReMZ := fCamuflarValor(recTotMarLuc.fltTotCusReaMZr);
      strCustoRealSemDesOpe := fCamuflarValor(recTotMarLuc.fltTotUnitar - fatVenda.fltCustoRealSemDesOpe);

      strMarBruVlr := fCamuflarValor(recTotMarLuc.fltTotUnitar - fatVenda.fltTotCus);
      strMarLiqVlr := fCamuflarValor(recTotMarLuc.fltTotUnitar - fltTotCu2);

      strMarPreUltBru := fCamuflarValor(recTotMarLuc.fltTotMarBru_PREULT);
      strMarPreUltLiq := fCamuflarValor(recTotMarLuc.fltTotMarLiq_PREULT);
      strMarPreMedBru := fCamuflarValor(recTotMarLuc.fltTotMarBru_PREMED);
      strMarPreMedLiq := fCamuflarValor(recTotMarLuc.fltTotMarLiq_PREMED);
      strMarCadastro_ := fCamuflarValor(recTotMarLuc.fltMargemDoCadastro);
      strMarPraBrut   := fCamuflarValor(recTotMarLuc.fltTotMrPrBr_PRECUS);

      If (pos(fCfgSis('MARMKP'), '1_5_') > 0) And (Length(strMarCam) > 1) Then
      Begin
        With cdsDados Do
        Begin
          If (Length(strMarCam) >= 11) and (strMarCam[11] = 'S') Then
            strMkpBru := fCamuflarValor(fRetornaMarkupAntigo(fltTotIteSemImpComDes,
                                                             fatVenda.fltTotCus, 0, 0, 0, 0, 0, 0));

          If (Length(strMarCam) >= 12) and (strMarCam[12] = 'S') Then
            strMkpLiq := fCamuflarValor(fRetornaMarkupAntigo(fltTotIteSemImpComDes,
                                                             fatVenda.fltTotCus + fAggr(FieldByName('TOT_OUTVAL')),
                                                             fAggr(FieldByName('TOT_ITE_ICMSAI')),
                                                             fAggr(FieldByName('TOT_ITE_IMPFED')),
                                                             fAggr(FieldByName('TOT_ITE_DESOPE')),
                                                             0,
                                                             IIF( not fCfgSis('CLPVDI', varBoolean), fAggr(FieldByName('TOT_VDIFAL')), 0),
                                                             IIF( not fCfgSis('CLPVDI', varBoolean), fAggr(FieldByName('TOT_TOTFCP')), 0) ));
        End;
      End;

      lblMarCam.Caption := '';

      If (Not fEmptyStr(strMarCam)) And
         (Length(strMarCam) > 1) And
         (strMarCam.Contains('S')) Then
      Begin
        For intCnt := 1 To Length(strMarCam) Do
        Begin
          If (strMarCam[intCnt] = 'S') Then
          Begin
            Case TMarCamOpcoes(intCnt - 1) Of
              mcoPrecoCusto:
                pSetarValorCamuflagem(strTotCus);

              mcoMargemBruta:
                pSetarValorCamuflagem(strMarBru);

              mcoMargemLiquida:
                pSetarValorCamuflagem(strMarLiq);

              mcoTotalProdutosPrecoTabela:
                pSetarValorCamuflagem(strTotBru);

              mcoCustoReal:
                pSetarValorCamuflagem(strTotCu2);

              mcoCustoRealComMargemZero:
                pSetarValorCamuflagem(strCuReMZ);

              mcoMargemBrutaValor:
                pSetarValorCamuflagem(strMarBruVlr);

              mcoMargemLiquidaValor:
                pSetarValorCamuflagem(strMarLiqVlr);

              mcoMargemLiquidaValorSemDesOpePer:
                pSetarValorCamuflagem(strMarLiqSemDesOpe);

              mcoMargemLiquidaValorSemDesOpeVal:
                pSetarValorCamuflagem(strCustoRealSemDesOpe);

              mcoUsandoMargemExibirMarkupBruto:
                pSetarValorCamuflagem(strMkpBru);

              mcoUsandoMargemExibirMarkupLiquido:
                pSetarValorCamuflagem(strMkpLiq);

              mcoDescTotDocumentoPerc:
                pSetarValorCamuflagem(strDescTotDocPerc);

              mcoPrecoUltimaCompraBruto:
                pSetarValorCamuflagem(strMarPreUltBru);

              mcoPrecoUltimaCompraLiquido:
                pSetarValorCamuflagem(strMarPreUltLiq);

              mcoPrecoMedioBruto:
                pSetarValorCamuflagem(strMarPreMedBru);

              mcoPrecoMedioLiquido:
                pSetarValorCamuflagem(strMarPreMedLiq);

              mcoTotalProdutosPrecoTabelaAtual:
                pSetarValorCamuflagem(strTotAtu);

              mcoMargemCadastroItemAtual:
                pSetarValorCamuflagem(strMarCadastro_);

              mcoMargemPraticadaBruta:
                pSetarValorCamuflagem(strMarPraBrut);
            End;
          End;
        End;
      End;

      {*****************************************}
      {* BOTOES QUE DEPENDEM DO TOTAL          *}
      {**************************************MV*}
      If strOpcDoc <> 'DV' Then
        btnMostraMargem.Visible := blnHabilita And fVerificaAcessoSistema('VIMLF4')
      Else
        btnMostraMargem.Visible := False;

      btnMostraMargem.Caption := '[F4] ' + IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + '/Lucro';

      btnTotalDesejadoVenda.Visible := blnHabilita and AnsiMatchText(strOpcDoc, ['OR', 'PD', 'VN']) and (fCfgSis('VALTOT', varBoolean));

      btnMostraItens.Visible  := blnHabilita;
      pEnabledFechamento(blnHabilita);

      If Pos(strOpcDoc, 'VN_CS_PD_OR_') > 0 Then
        blnComVen := blnHabilita;

      If (fCfgSis('USASER', varBoolean)) Then
      Begin
        If fCfgSis('TIPNFS') = '1' Then
        Begin
          If Pos(strOpcDoc, 'OR_PD_VN_CS_OU_OV_OE_EF_OF_') > 0 Then
            pEnabledFechamento(True);
        End
        Else If Pos(strOpcDoc,'VS_PD_OR_CF_CN_CP_OV_') > 0 Then
          pEnabledFechamento(True);
      End;

      If strOpcDoc = 'NC' Then
        pEnabledFechamento(True);

      pHabilitaMargemGraficaDeAcordoComA(TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True));

      {*** Sinaleiros ***}
      If (fUtilizaSinaleiro) Then
      Begin

        shpSinaleiroDocAtual.Brush.Color := StrToIntDef(fRetCorSinaleiroDocAtual(recTotMarLuc.fltTotMarPra_CUSITE, recTotMarLuc.fltTotMarPrat), 0);

        {Nesse sinaleiro, define a cor somente na primeira execução,
         ou na mudança de vendedor, para não ocasionar lentidão!}
        If (shpSinaleiroMesApuracao.Brush.Color = clWhite) Or
           (blnAlterouVendedor) Then
          shpSinaleiroMesApuracao.Brush.Color := StrToIntDef(fRetCorSinaleiroMesApuracao, 0);

      End;

    Except

    End;

    PostMessage(Application.Handle, WM_MESSAGEATUALIZOUTOTALVENDA, 0, 0);
    pInformacoesClienteRodape;
  Finally
    FreeAndNil(cdsDados);
  End;

end;

procedure TfrmFatVendas.pHabilitaMargemGraficaDeAcordoComA(fltMargem: Double);
begin

  If (shpMargemDoc.Visible) Then
  Begin

    If cdsVenda.IsEmpty Then
    Begin
      shpMargemDoc.Brush.Color := clGreen;
      shpMargemDoc.Pen.Color := clGreen;
    End
    Else If (fatVenda.fSomenteItensEmPromocaoNaVenda) And
            ((VS_strTRADES = '4') And (Not fatVenda.fConsiderarItemPromocionalMargemMinimaDocumento)) Then
    Begin
      shpMargemDoc.Brush.Color := clGreen;
      shpMargemDoc.Pen.Color := clGreen;
    End
    Else If (VS_strTRADES = '4') And (fCfgSis('MMCBRI', varString) = 'N') And
            (Not fatVenda.fTemItemPraValidarMargemMinimaPorDocumento(fatVenda.fConsiderarItemPromocionalMargemMinimaDocumento, fCfgSis('MMCBRI', varString) = 'S')) Then
    Begin
      shpMargemDoc.Brush.Color := clGreen;
      shpMargemDoc.Pen.Color := clGreen;
    End
    Else If (fltMargem < fCfgSis('MMDN2S', varDouble)) Then
    Begin
      shpMargemDoc.Brush.Color := clRed;
      shpMargemDoc.Pen.Color := clRed;
    End
    Else If fltMargem < fCfgSis('MMDN1S', varDouble) Then
    Begin
      shpMargemDoc.Brush.Color := clYellow;
      shpMargemDoc.Pen.Color := clYellow;
    End
    Else
    Begin
      shpMargemDoc.Brush.Color := clGreen;
      shpMargemDoc.Pen.Color := clGreen;
    End;

  End;

end;

