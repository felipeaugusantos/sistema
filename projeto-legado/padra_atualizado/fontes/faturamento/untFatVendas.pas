    end;

    function fItemComoEntregaFuturaNoPedido(strAutIncFdo: String): Boolean;
    begin
      Result := fCampoTabela('FDO_ENTFUT', 'FATDOR', ['AUTOINCREM'], [strAutIncFdo]) = 'S';
    end;

    function fRecalcularPrecoItensQueEntraramNaPromocao: Boolean;
      Var
        fltQtdJaDig, fltQtdJaEmPromoc: Double;
    begin
      Result := False;

      If cdsVenda.FieldByName('ITE_PROMOC').AsString <> 'S' Then
        Exit;

      fltQtdJaDig := fatVenda.fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                              cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                                              cdsVenda.FieldByName('AUTOINCREM').AsString,
                                              cdsVenda.FieldByName('ITE_CODACA').AsString,
                                              cdsVenda.FieldByName('ITE_EMPACA').AsString,
                                              cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                              False);

      fltQtdJaEmPromoc := fatVenda.fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                   cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                                                   cdsVenda.FieldByName('AUTOINCREM').AsString,
                                                   cdsVenda.FieldByName('ITE_CODACA').AsString,
                                                   cdsVenda.FieldByName('ITE_EMPACA').AsString,
                                                   cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                   False,
                                                   False,
                                                   fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,
                                                   True {Somente em promocao});

      Result := fltQtdJaDig <> fltQtdJaEmPromoc;
    end;

    function fAlterarItemComboDevolucao : Boolean;
    begin

      Result := False;

      If (Pos(strOpcDoc, 'DV_PR_') > 0) Then
        If (fAlterandoProduto) Then
          If (cdsVenda.FieldByName('ITE_SEQCOM').AsInteger > 0) And (cdsVenda.FieldByName('ITE_ATIVAC').AsString <> 'S') Then
            Exit(True);

    end;

    procedure pAdicionaItemUsandoHierarquiaCadPro;
      const
        SELECT_PRIORIDADE = 'SELECT * FROM CADHIE WHERE HIE_CODITE = :CODITE AND HIE_EMPITE = :EMPITE';
        EXCETO_PRIORIDADE = 'AND HIE_EMPSAI NOT IN (#EXCETO)';
        ORDENA_PRIORIDADE = 'ORDER BY HIE_ORDEM_';
      var
        objSalLoj           : TSaldoLojas;
