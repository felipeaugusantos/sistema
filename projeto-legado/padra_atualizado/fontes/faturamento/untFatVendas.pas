function TfrmFatVendas.fGetQtdeTab(const dblQtdePadrao: Double; var strAmbiente: String; RectLinhaGrid: TRect): Double;
var
  objForm: TfrmTabQtd;
begin
  If RectLinhaGrid = RectLinhaGrid.Empty Then
  Begin
    Result := -1;
    Exit;
  End;

  objForm := TfrmTabQtd.Create(nil);

  try
    objForm.dblQtde := dblQtdePadrao;
    objForm.Left := RectLinhaGrid.Left + 40;
    objForm.Top  := RectLinhaGrid.Bottom + 35;

    if fUtilizaDefinicaoAmbienteProduto then
    begin
      objForm.pnlQuantidade.Align := alLeft;
      objForm.pnlAmbiente.Visible := True;
      objForm.cbbAmbiente.Clear;
      objForm.cbbAmbiente.Items := Self.cbbComple.Items;
      objForm.cbbAmbiente.Text := strAmbiente;
      objForm.Width := 424;
    end
    else
    begin
      objForm.pnlAmbiente.Visible := False;
      objForm.pnlQuantidade.Align := alClient;
      objForm.Width := 125;
    end;

    if objForm.ShowModal = mrOk then
    begin
      Result := StrToFloatDef(objForm.edtQtde.Text, 0);

      if fUtilizaDefinicaoAmbienteProduto then
      begin
        Self.cbbComple.Clear;
        Self.cbbComple.Items := objForm.cbbAmbiente.Items;
        Self.cbbComple.ItemIndex := objForm.cbbAmbiente.Items.IndexOf(objForm.cbbAmbiente.Text);
        strAmbiente := Self.cbbComple.Text;
      end;
    end
    else
    begin
      Result := -1;
    end;
  finally
    FreeAndNil(objForm);
  end;
end;

procedure TfrmFatVendas.pHabilitarCamposEntrega;
  Var
    blnEntregaFutura: Boolean;
    blnRegCid       : Boolean;
begin
  blnRegCid              := fCfgSis('REGCID', varBoolean);
  blnEntregaFutura       := fCfgSis('ENTFUT', varBoolean, fGetEmpConfigEntrega) And pnlEntrega.Visible;
  blnClienteBuscaEntrega := blnEntregaFutura And fCfgSis('CLBUEF',varBoolean, fGetEmpConfigEntrega);

  cmbEntRet.Enabled      := fCfgSis('ENTFAT', varBoolean, fGetEmpConfigEntrega);

  lblEntRet.Visible      := pnlEntrega.Visible;
  cmbEntRet.Visible      := pnlEntrega.Visible;
  lblDatEnt.Visible      := pnlEntrega.Visible And ((not blnRegCid) Or (blnRegCid And fCfgSis('UGPDTE', varBoolean)));
  mskDtaEnt.Visible      := pnlEntrega.Visible And ((not blnRegCid) Or (blnRegCid And fCfgSis('UGPDTE', varBoolean)));
  edtDiaEnt.Visible      := pnlEntrega.Visible And ((not blnRegCid) Or (blnRegCid And fCfgSis('UGPDTE', varBoolean)));
  lblDiaEnt.Visible      := pnlEntrega.Visible And ((not blnRegCid) Or (blnRegCid And fCfgSis('UGPDTE', varBoolean)));

  lblTipEnt.Visible      := blnEntregaFutura;
  cmbTipEnt.Visible      := blnEntregaFutura;
  cmbTurEnt.Visible      := blnEntregaFutura;

  lblMotEntFut.Visible   := blnEntregaFutura;
  cmbMotEntFut.Visible   := blnEntregaFutura;

  cmbCliBus.Visible      := blnClienteBuscaEntrega;
  lblCliBus.Visible      := blnClienteBuscaEntrega;

  If fCfgSis('LOCRET', VarBoolean) Then
  Begin
    pnlTipEnt.Visible := (cmbEntRet.ItemIndex <> IDX_RETIRA) And blnEntregaFutura;
    pnlLocRet.Visible := (cmbEntRet.ItemIndex = IDX_RETIRA);
  End
  Else
  Begin
    pnlTipEnt.Visible := blnEntregaFutura;
    pnlLocRet.Visible := False;
  End;

  If blnEntregaFutura Then
  Begin
    If (fatVenda.fRetornaSGFTED(edtNumLot.Text, fGetEmpConfigEntrega) = 'S') Then
      cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA    //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
    Else
      cmbTipEnt.ItemIndex := IDX_ENTREGA_IMEDIATA; //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
  End;
end;

procedure TfrmFatVendas.pHabilitarEdicaoEmpresa;
  Var
    blnHabilitar: Boolean;
    strHintEmpresa: String;
    strRequisicoes: String;
    strTransferencias: String;
begin
  blnHabilitar := True;

  If fPedidoOriundoDesmembramento Then
  Begin
    strHintEmpresa := 'Pedido oriundo de desmembramento não pode ter a empresa do item alterada!';
    blnHabilitar   := False;
  End
  Else If (strOpcDoc = 'PD') And fCfgSis('SLTFRC', varBoolean) And (fAlterandoProduto) Then
  Begin
    If fPossuiAbastecimentoVinculadoComReqCompra(cdsVenda.FieldByName('ITE_SEQDET').AsString, strRequisicoes) Then
    Begin
      strHintEmpresa := 'Produto vinculado à requisição de compra não pode ter a empresa alterada!';
      blnHabilitar   := False;
    End
    Else If fPossuiAbastecimentoVinculadoComTransferencia(cdsVenda.FieldByName('ITE_SEQDET').AsString, strTransferencias) Then
    Begin
      strHintEmpresa := 'Produto vinculado à transferência(s) de estoque não pode ter a empresa alterada!';
      blnHabilitar   := False;
    End;
  End;

  edtCodEmp.Hint        := IIF(blnHabilitar, '', strHintEmpresa);
  edtCodEmp.NormalColor := IIF(blnHabilitar, clWindow, $00FFDFB8);
  edtCodEmp.ReadOnly    := IIF(blnHabilitar, False, True );
  edtCodEmp.TabStop     := IIF(blnHabilitar, True , False);
  edtCodEmp.ShowHint    := IIF(blnHabilitar, False, True );
end;

