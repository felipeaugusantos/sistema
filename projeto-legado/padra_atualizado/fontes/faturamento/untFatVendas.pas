function TfrmFatVendas.fCarregarSaldoEmpresasGrid(pgbProgresso: TcxProgressBar): Boolean;
var
  recItem: TThreadCarregarSaldoEmpresasGrid.TItem;
  recEmpSal: TThreadCarregarSaldoEmpresasGrid.TEmpSaldo;
begin
  Result := True;

  if not blnExibeSaldoGrid then
    Exit;

  if not assigned(thrCarregarSaldoEmpresasGrid) then
    Exit;

  while not thrCarregarSaldoEmpresasGrid.UpdatedAll do
  begin
    pgbProgresso.Properties.Max := 100;
    pgbProgresso.Position := thrCarregarSaldoEmpresasGrid.GetProgress;
    pProcessMessages;
    Sleep(300);
  end;

  thrCarregarSaldoEmpresasGrid.Terminate;
  thrCarregarSaldoEmpresasGrid.WaitFor;

  try
    cdsVenda.DisableControls;
    try
      pgbProgresso.Properties.Max := cdsVenda.RecordCount;
      cdsVenda.First;
      while not cdsVenda.Eof do
      begin
        cdsVenda.Edit;
        recItem := thrCarregarSaldoEmpresasGrid.GetItem(cdsVenda.FieldByName('AUTOINCREM').AsInteger);
        cdsVenda.FieldByName('ESTFIL').AsFloat := recItem.fltEstFil;
        cdsVenda.FieldByName('ESTLOJ').AsFloat := recItem.fltEstLoj;
        For recEmpSal In recItem.arrEmpSal Do
          cdsVenda.FieldByName('EST_EMP_' + recEmpSal.strCodEmp).AsFloat := recEmpSal.fltSalDis;
        cdsVenda.Post;
        cdsVenda.Next;
        pgbProgresso.Position := cdsVenda.RecNo;
        pProcessMessages;
      end;
    finally
      cdsVenda.EnableControls;
      cdsVenda.First;
    end;
  finally
    FreeAndNil(thrCarregarSaldoEmpresasGrid);
  end;
end;

procedure TfrmFatVendas.pExecutarAtualizarImpostosNaConsultaTab;
  Var
    fltUnitarioLiquido: Double;
begin
  tmrAtualizarImpostosNaConsultaTab.Enabled := False;

  //Ja esta calculando os impostos
  If intCalculandoImpostos > -1 Then
    Exit;

  If qryConCit.FindField('ITE_CODITE') = NIL Then
    Exit;

  fltUnitarioLiquido := fRetornaValorUnitarioLiquidoTab(fatVenda,
                                                        qryConCit.FieldByName('ITE_CODITE').AsString,
                                                        fStrToFloat(edtUnitar.Text),
                                                        fStrToFloat(edtDesCon.Text));

  If SameValue(Self.fltUltimoUniLiqModoTab, fltUnitarioLiquido) And
     SameValue(Self.fltUltimaQtdIteModoTab, fStrToFloat(edtQtdIte.Text)) Then
    Exit;

  pEscreveAtualizandoImpostosNaConsultaTab;

  tmrAtualizarImpostosNaConsultaTab.Enabled := True;
end;

