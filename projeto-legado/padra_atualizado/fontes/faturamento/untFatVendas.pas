function TfrmFatVendas.fValidaPlacaVeiculo(blnCarregadoPeloCliente: Boolean): Boolean;
  Var
    strCliVei: String;
    strPedAbe: String;
    strPlaTmp: String;
    strDesVeiTmp: string;
    objCliVei: TCliVei;
    objLiberacaoVeiculo: TLiberacao;

  function fPedeClienteVeiculo: Boolean;
  begin
    {*******************************************************************************}
    {* Caso nao tenha carregado um orcamento ou o cliente nao tenha sido informado *}
    {****************************************************************************jc*}
    Result := fEmptyStr(strNumOrc) Or fEmptyStr(edtCodCli.Text);

    If (Not fEmptyStr(edtCodCli.Text)) And
       (Not fVeiculoRelacionadoAoCliente(mskPlaVei.Text, edtCodCli.Text)) And
       (Not fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) Then
    Begin
      Result := True;
    End;

    If (fCfgSis('PLAGEN', varBoolean)) And
       (Sametext(mskPlaVei.Text, fCfgSis('PLACA_', varString))) Then
      Result := False
  end;

begin
  If fValidaPlaca(mskPlaVei.Text) Then
  Begin
    strDesVeiTmp := edtDesVei.Text;
    If fEmptyStr(mskPlaVei.Text) Then
    Begin
      Result := False;
      fMensagem('','Informe a placa do veículo!',['&Ok']);
    End
    Else
    Begin

      strPedAbe := fPedidosEmAbertoParaVeiculo(mskPlaVei.Text, strNumOrc);
      Result := True;

      If (strOpcDoc = 'OR') And (Not fEmptyStr(strPedAbe)) and (fCfgSis('1PDPLA', varBoolean)) Then
      Begin
        If fMensagem('','Já existe pedido de venda em aberto para este veículo!' + #13#10 +
                        'Pedido(s): ' + strPedAbe + #13#10 + 'Deseja continuar com o orçamento?',['&Sim', '&Não']) = 2 Then
          Result := False;
      End;

      If (strOpcDoc <> 'OR') And (Not fEmptyStr(strPedAbe)) and (fCfgSis('1PDPLA', varBoolean)) Then
      Begin
        fMensagem('','Já existe pedido de venda em aberto para este veículo!' + #13#10 +
                     'Pedido(s): ' + strPedAbe,['&Ok']);
        Result := False;
      End;

      If Result Then
      Begin
        edtDesVei.Text := fRetornaDescricaoVeic(mskPlaVei.Text);

        If (fCfgSis('ALTPLA', varBoolean)) and (not fEmptyStr(strNumOrc)) and (not fEmptyStr(fatVenda.strPlaVei)) and (fatVenda.strPlaVei <> mskPlaVei.Text) then
        Begin
          try
            objLiberacaoVeiculo := TLiberacao.Create;
            objLiberacaoVeiculo.Clear;
            objLiberacaoVeiculo.objMsgLibera.pAddTexto('Alteração da placa do veículo na alteração do pedido.');
            objLiberacaoVeiculo.objMsgLibera.pAddSeparador(65);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Pedido', strNumOrc + ' - ' + strEspOrc + ' - ' + strEmpOrc, 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Cliente' , edtCodCli.Text + ' - ' + edtNomCli.Text, 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Cidade' , fatVenda.strCliCid + ' - ' + fatVenda.strCliEst, 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('CPF/CNPJ' , fFormataCpfCgc(fatVenda.strCliCgc, fSetaPais), 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Vr.Pedido' , edtTotImp.Text, 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTexto('');
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Placa Atual' , Copy(fatVenda.strPlaVei,1,3) + '-' + Copy(fatVenda.strPlaVei,4,4), 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Veículo' , strDesVeiTmp, 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTexto('');
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Nova Placa' , Copy(mskPlaVei.Text,1,3) + '-' + Copy(mskPlaVei.Text,4,4), 30);
            objLiberacaoVeiculo.objMsgLibera.pAddTextoCaption('Veículo' , IIF(fEmptyStr(edtDesVei.Text),'Veículo ainda não cadastrado',edtDesVei.Text), 30);

            objLiberacaoVeiculo.strDirAce := 'CLIVEI';
            objLiberacaoVeiculo.strMsgSen := 'Altera placa do veículo';
            objLiberacaoVeiculo.strCodOpe := fatVenda.strCodVen;
            objLiberacaoVeiculo.strCodDig := fatVenda.strCodDig;
            objLiberacaoVeiculo.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

            If not objLiberacaoVeiculo.fLibera Then
            Begin
              mskPlaVei.Text := fatVenda.strPlaVei;
              edtDesVei.Text := fRetornaDescricaoVeic(mskPlaVei.Text);
              Result := False;
              Exit;
            End;
          finally
            If Assigned(objLiberacaoVeiculo) Then
            Begin
              FreeAndNil(objLiberacaoVeiculo);
            End;
          end;
        End;

        If Not blnCarregadoPeloCliente Then
        Begin
          strCliVei := '';

          If fPedeClienteVeiculo Then
            strCliVei := fRetClienteVeiculo(mskPlaVei.Text, edtCodCli.Text);

          If Not fEmptyStr(strCliVei) Then
            edtCodCli.Text := strCliVei;

          If fEmptyStr(edtDesVei.Text) Then
          Begin
            Result := False;
            fMensagem('','Nenhum veículo cadastrado com esta placa!',['&Ok']);
            mskPlaVei.Text := fChamaCadVei(VK_INSERT, mskPlaVei.Text);
            edtDesVei.Text := fRetornaDescricaoVeic(mskPlaVei.Text);

            If (not fEmptyStr(strNumOrc)) And (fEmptyStr(mskPlaVei.Text)) Then
            Begin
              mskPlaVei.Text := fatVenda.strPlaVei;
              edtDesVei.Text := fRetornaDescricaoVeic(mskPlaVei.Text);
              pRemoveLiberacao('CLIVEI');
            End;
          End
          Else If Not fEmptyStr(edtCodCli.Text) Then
          Begin
            strPlaTmp := fatVenda.strPlaVei;
            fatVenda.strPlaVei := mskPlaVei.Text;
            Result := fValidaCampos(edtCodCli, True);
            fatVenda.strPlaVei := strPlaTmp;
          End
          Else
          Begin
            Result := True;
          End;
        End;

        If (not fEmptyStr(edtDesVei.Text)) And (not fEmptyStr(edtCodCli.Text)) Then
        Begin
          strPlaTmp := fatVenda.strPlaVei;
          fatVenda.strPlaVei := mskPlaVei.Text;

          If (Not fEmptyStr(mskPlaVei.Text)) And (Not fEmptyStr(fatVenda.strPlaVei)) And
             (Not fVeiculoRelacionadoAoCliente(mskPlaVei.Text, edtCodCli.Text)) And
             (Not fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) And
             ((Not fCfgSis('PLAGEN', varBoolean) Or
             ((fCfgSis('PLAGEN', varBoolean)) And (Not (Sametext(mskPlaVei.Text, fCfgSis('PLACA_', varString))))))) Then
          Begin
            If fMensagem('', 'Veículo ' + fatVenda.strPlaVei + ' não cadastrado para este cliente.' + #13#10 +
                             'Deseja cadastrar o veículo para o cliente?', ['&Sim', '&Não'], 2) = 1 Then
            Begin
              objCliVei := TCliVei.Create(Self);
              objCliVei.strCodCli := fatVenda.strCodCli;
              objCliVei.strPlaVei := fatVenda.strPlaVei;
              objCliVei.strVeiAti := 'S';
              objCliVei.pInsereCliVei;
              objCliVei.Destroy;

              if (fatVenda.strPlaVei <> strPlaTmp) then
              begin
                If fMensagem('', 'Deseja remover o vínculo da placa '+strPlaTmp+' com o cliente?', ['&Sim', '&Não'], 2) = 1 Then
                Begin
                  TCliVei.pDesvinculaVeiculo(fatVenda.strCodCli, strPlaTmp);
                End;
              end;
            End
            Else
            Begin
              mskPlaVei.Clear;
              edtDesVei.Clear;
              edtKM_Vei.Clear;

              fatVenda.strPlaVei      := EmptyStr;
              fatVenda.strKM_Vei      := EmptyStr;
            End;
          End;
        End;

      End;
    End;
  End
  Else
  Begin
    Result := False;
    fMensagem('','Informe uma placa válida!',['&Ok']);
  End;

  If Result Then
  Begin
    {******************************************************************************}
    {* CASO O USUÁRIO INSIRA UMA PLACA EM UM PEDIDO ORIGINALMENTE PLACA INFORMADA *}
    {* EXECUTA pInsereTodosItensNoCdsLogItensSep('I') PARA GERAR A EXPEDIÇÃO DE   *}
    {* SERVIÇO NO MOMENTO DA GRAVAÇÃO                                             *}
    {***************************************************************************VA*}
    If (strOpcDoc = 'PD') And
       (Not fEmptyStr(fatVenda.strNumOrc)) And
       ((fatVenda.fEhAutocenter) Or (fCfgSis('RETDEV', varBoolean))) And
       (Assigned(fatVenda.cdsLogItensSep)) And
       (fEmptyStr(fatVenda.strPlaVei)) Then
    Begin
      fatVenda.pInsereTodosItensNoCdsLogItensSep('I');
      blnPDAutCenComPlacaInseridaPosterior := True;
    End;

    fatVenda.strPlaVei := mskPlaVei.Text;
    btnServico.Visible := fDigitarServicoInicioVenda;
    lblTotSer.Visible  := btnServico.Visible;
    edtTotSer.Visible  := btnServico.Visible;
  End;
end;

