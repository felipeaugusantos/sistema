procedure TfrmFatVendas.pCalculaTotIte(fltUniLiq: Double = 0);
Var
  fltQtdIte: Double;
  fltTotIte: Double;
  fltUnitar: Double;
begin

  If (Not fUtilizaUnitarioLiquido) Then
  Begin
    If fltUniLiq = 0 Then
    Begin
      pAtualizaUnitarioLiquido;
      fltUniLiq := fFormataFloat(fStrToFloat(edtUniLiq.Text), fatVenda.VS_intDecUni);
    End;
  End;

  If fEmptyStr(edtQtdIte.Text) Then
    edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 0);

  If fEmptyStr(edtQtdPec.Text) Then
    edtQtdPec.Text := FormatFloat(edtQtdPec.EditFormat, 0);

  If fEmptyStr(edtComPec.Text) Then
    edtComPec.Text := FormatFloat(edtComPec.EditFormat, 0);

  If fEmptyStr(edtLarPec.Text) Then
    edtLarPec.Text := FormatFloat(edtLarPec.EditFormat, 0);

  If fEmptyStr(edtEspPec.Text) Then
    edtEspPec.Text := FormatFloat(edtEspPec.EditFormat, IIF(blnUtilizaVendaVidro,1,0));

  If fEmptyStr(edtDesCon.Text) Then
    edtDesCon.Text := FormatFloat(fMskDigitos(intDecDes), 0);

  If fEmptyStr(edtUnitar.Text) Then
    edtUnitar.Text := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);

  If fEmptyStr(edtTotIte.Text) Then
    edtTotIte.Text := '0,00';

  If fEmptyStr(edtVrTotCImpostos.Text) Then
    edtVrTotCImpostos.Text := '0,00';

  If fEmptyStr(edtUnitComImpostos.Text) Then
    edtUnitComImpostos.Text := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);

  If fEmptyStr(edtUntPec.Text) Then
    edtUntPec.Text := FloatToStrF(0, ffFixed, 12, fatVenda.VS_intDecUni);

  {********************************}
  {* TRAVA ITEM FRACIONADO OU NAO *}
  {*****************************AF*}
  If qryConCit.FindField('ITE_CODUNI') <> NIL Then
  Begin
    If ((Not fItemFracionado(qryConCit.FieldByName('ITE_CODUNI').AsString, qryCadUni)) And
       (Not (fatVenda.blnCarregandoEstrutura And fCfgSis('USACCR', varBoolean)))     And
       ((strOpcDoc = 'NE') And (Not fCfgSis('NESTIN', varBoolean)))) Or ((fatVenda.strIdePro <> 'NOR'))  Then
    Begin
      edtQtdIte.Text := FloatToStrF(Int(fStrToFloat(edtQtdIte.Text)), ffFixed, 12, fCfgSis('DECQTD', varInteger));
    End;
  End;

  fltQtdIte := fStrToFloat(edtQtdIte.Text);
  fltUnitar := fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni);

  If (fUtilizaUnitarioLiquido) Then
  Begin
    If (edtUniLiq.Visible) And (Not edtUniLiq.ReadOnly) Then
    Begin
      If fltUniLiq = 0 Then
        fltUniLiq := fFormataFloat(fStrToFloat(edtUniLiq.Text), fatVenda.VS_intDecUni);
      fltTotIte := fatVenda.fCalculaTotalItem(fatVenda.strIdePro, fltUniLiq, fltQtdIte, 0, intQtdEmb);
    End
    Else
      fltTotIte := fatVenda.fCalculaTotalItem(fatVenda.strIdePro, fltUnitar, fltQtdIte, 0, intQtdEmb);
  End
  Else
  Begin
    If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoDigitado and fItemEstrutura(fCodItem) Then
      fltTotIte := fatVenda.fCalculaTotalItem(fatVenda.strIdePro, fltUnitar, fltQtdIte, 0, intQtdEmb)
    else
      fltTotIte := fatVenda.fCalculaTotalItem(fatVenda.strIdePro, fltUniLiq, fltQtdIte, 0, intQtdEmb);
  End;

  edtTotIte.Text := FloatToStrF(fltTotIte, ffFixed, 12, 2);
  If fItemSelecionadoCarregado(edtCodIte.Text) Then
    edtVrTotCImpostos.Text := FloatToStrF(fCalcularValorComImpostos(fatVenda, edtCodIte.Text, fltTotIte, Nil), ffFixed, 12, 2);
  pAtualizaUnitarioComImpostos;

  If (edtUntPec.Visible) And (fStrToFloat(edtQtdPec.Text) > 0) Then
    edtUntPec.Text := FloatToStrF(fltTotIte / fStrToFloat(edtQtdPec.Text), ffFixed, 12, fatVenda.VS_IntDecUni);

end;

procedure TfrmFatVendas.pCalculaUnitarioMetrosCubicos;
  Var
    fltUntAlt,
    fltLargur,
    fltCompri: Double;
begin
  fltUntAlt := fatVenda.fltUniOri;
  fltLargur := fRetLargura(edtCodIte.Text);
  fltCompri := fRetAltura(edtCodIte.Text);

  {******************************************************************}
  {* SE A LARGURA CADASTRADA FOR DIFERENTE DA LARGURA DIGITADA,     *}
  {* CALCULA O VALOR REFERENTE A LARGURA DIGITADA. FORMULA ABAIXO.  *}
  {* (VALOR UNIT. ORIGINAL / LARGURA CADASTRADA) * LARGURA DIGITADA *}
  {***************************************************************FC*}
  If (fltLargur <> fStrToFloat(edtLarPec.Text)) And (fltLargur <> 0) Then
    fltUntAlt := (fatVenda.fltUniOri / fltLargur) * fStrToFloat(edtLarPec.Text);

  {******************************************************************************}
  {* SE O COMPRIMENTO CADASTRADO FOR DIFERENTE DO COMPRIMENTO DIGITADO CAL-     *}
  {* CULA O VALOR REFERENTE O COMPRIMENTO DIGITADO, APLICANDO A REGRA DE 3.     *}
  {* (VALOR UNIT CALCULADO ACIMA * COMPRIMENTO DIGITADO)/COMPRIMENTO CADASTRADO.*}
  {***************************************************************************FC*}
  If (fltCompri <> fStrToFloat(edtComPec.Text)) And (fltCompri <> 0) Then
    fltUntAlt := (fltUntAlt * fStrToFloat(edtComPec.Text)) / fltCompri;

  {******************************************************************************}
  {* SE A QUANTIDADE (ÁREA EM M2) DO PRODUTO FOR MENOR QUE O LIMITE MÍNIMO      *}
  {* CONFIGURADO NO CADASTRO DO PRODUTO, DEVERÁ SER APLICADO UM FATOR NO        *}
  {* PREÇO UNITÁRIO PARA QUE NÃO HAJA DIFERENÇA NA NEGOCIAÇÃO ENTRE VEDEDORES   *}
  {***************************************************************************DF*}
  edtUnitar.Text := FormatFloat('#,##0.00', fltUntAlt *
    TFaixasMetragem.fRetFatorFaixaMetragem(edtCodIte.Text, fStrToFloat(edtQtdIte.Text)));

  pAtualizaUnitarioLiquido;
end;

