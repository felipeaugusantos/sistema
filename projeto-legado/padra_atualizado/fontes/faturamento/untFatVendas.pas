procedure TfrmFatVendas.edtCodCliExit(Sender: TObject);
var
  strDtaSef: string;
begin
  inherited;

  If fatVenda.fDocumentoParaFornecedor Then
    pPesquisaCadFor(qryConCli, qryConCli, edtCodCli.Text)
  Else
    pPesquisaCadCli(qryConCli, qryConCli, edtCodCli.Text, True, IIF((Pos(strOpcDoc, 'OR_PD_VN_') > 0), True, False));

  btnConsultaFit.Visible := False;
  If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And (fCfgSis('CONFIT', varBoolean)) And (Not fEmptyStr(edtCodCli.Text)) Then
  Begin
    If Not qryConCli.IsEmpty Then
      btnConsultaFit.Visible := (qryConCli.FieldByName('CLI_CGCCPF').AsString = '1');

    if btnConsultaFit.Visible then
    begin
      if fTeveConsultaSefaz('CADCLI', 'CLI_DTASEF', qryConCli.FieldByName('AUTOINCREM').AsString, strDtaSef) then
      begin
        btnConsultaFit.Glyph := Nil;
        ImageSefaz.GetBitmap(1, btnConsultaFit.Glyph);
        btnConsultaFit.Hint := 'Consulta Dados Cadastrais do CNPJ.' + sLineBreak + 'Última consulta realizada em '+strDtaSef+'.';
      end
      else
      begin
        btnConsultaFit.Glyph := Nil;
        ImageSefaz.GetBitmap(0, btnConsultaFit.Glyph);
        btnConsultaFit.Hint := 'Consulta Dados Cadastrais do CNPJ.';
      end;
    end;
  End;

  If (Not fEmptyStr(edtCodCli.Text)) And (blnTemNegocAtiva) Then
  Begin
    If TCadNegBussiness.fClienteTemNegociacaoVinculada(edtCodCli.Text) Then
    Begin
      pnlCampanha.Visible := True;
      lblCampanha.Caption := 'CLIENTE POSSUI NEGOCIAÇÃO';
    End
    Else
      pnlCampanha.Visible := False;
  End
  Else
    pnlCampanha.Visible := False;

  If Not pnlCampanha.Visible Then
  Begin
    If (Not fEmptyStr(edtCodCli.Text)) And fatVenda.objCamGer.fVerificaClienteCampanha(edtCodCli.Text) Then
    Begin
      pnlCampanha.Visible := True;
      lblCampanha.Caption := 'CLIENTE EM CAMPANHA';
    End
    Else
      pnlCampanha.Visible := False;
  End;

  If Not pnlCampanha.Visible Then
  Begin

    If (Not fEmptyStr(edtCodCli.Text)) And fatVenda.objBonger.fVerificaClienteComBonus(edtCodCli.Text) Then
    Begin
      lblCampanha.Caption := 'CLIENTE COM BÔNUS';
      pnlCampanha.Visible := True;
    End
    Else
      pnlCampanha.Visible := False;

  End;

  If Not pnlCampanha.Visible Then
  Begin
    If (fCfgSis('DDESFD', varInteger) > 0) Or (fExibePainelClubeFidelidade()) Then
    Begin
      edtTotPontosFidelidade.Text := '';
      mskDataAdesao.Text := '';
      If ((VS_Date - fCampoTabela('CLI_ULTCOM', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli])) <= fCfgSis('DDESFD', varInteger)) Then
      Begin
        lblCampanha.Caption := 'CLIENTE FIDELIDADE';
        pnlCampanha.Visible := True;
        edtTotPontosFidelidade.text := '';
        mskDataAdesao.Text := fCampoTabela('MIN(FID_DTACAD) DTACAD', 'CLUFID', ['FID_CODCLI'],[fatVenda.strCodCli]);
        if fValidaDataStr(mskDataAdesao.Text) then
        begin
          lblAnosAdesao.caption := '';
          case YearsBetween(strtodate(mskDataAdesao.text),VS_Date) of
            0: lblAnosAdesao.caption := '';
            1: lblAnosAdesao.caption := '1 ano de adesão';
            else lblAnosAdesao.caption := inttostr(YearsBetween(strtodate(mskDataAdesao.text),VS_Date) )+' anos de adesão';
          end;
          edtTotPontosFidelidade.text := fCampoTabela('SUM(FID_QTDPTO) QTDPTO','CLUFID',['FID_CODCLI','FID_CREDEB'], [fatVenda.strCodCli,'C']) -
                                         fCampoTabela('SUM(FID_QTDPTO) QTDPTO','CLUFID',['FID_CODCLI','FID_CREDEB'], [fatVenda.strCodCli,'D']);

        end;
        pnlClubeFidelidade_Sinaleiro.Visible := (edtTotPontosFidelidade.Text <> '') Or (fUtilizaSinaleiro) Or (fExibePainelClubeFidelidade());
        pClubeFidelidade((edtTotPontosFidelidade.Text <> '') Or fExibePainelClubeFidelidade());
      End
      Else
      Begin
        pnlCampanha.Visible := False;
        pClubeFidelidade(fExibePainelClubeFidelidade);
      End;
    End;
  End
  Else
    pClubeFidelidade(fExibePainelClubeFidelidade);

  pnlCampanha.Height := 21;

  If SameText(fatVenda.strOpcDoc, 'BR') And (Not fEmptyStr(fRetNomCliente(edtCodCli.Text))) Then
  Begin
    If Not pnlCampanha.Visible Then
    Begin
      If fClienteProfissional(edtCodCli.Text) Then
        lblCampanha.Caption := 'CLIENTE PROFISSIONAL'
      Else
        lblCampanha.Caption := 'CLIENTE NÃO PROFISSIONAL';

      pnlCampanha.Visible := True;
    End
    Else
    Begin
      lblCampanha.Font.Size := 7;
      // Duas linhas nao cabem nos 21 px do .dfm; 33 ainda fica dentro do pnlCliente (64)
      pnlCampanha.Height := 33;

      If fClienteProfissional(edtCodCli.Text) Then
        lblCampanha.Caption := lblCampanha.Caption + #13#10 + 'CLIENTE PROFISSIONAL'
      Else
        lblCampanha.Caption := lblCampanha.Caption + #13#10 + 'CLIENTE NÃO PROFISSIONAL';
    End;
  End;

  pVerificaTamanhoPnlCliente;

  If (Pos(strOpcDoc, 'OR_') > 0) And fCfgSis('UTIPOR', varBoolean) Then
  Begin
    If Not fVerificaPermanenciaOrcPorVend(edtCodCli.Text,
                                          fatVenda.strCodVen,
                                          fatVenda.strNumOrc) Then
    Begin
      pSetFocus(edtCodCli);
    End;
  End;

  If blnNEFornecedor Then
    pnlCampanha.Visible := False;

  mnuImportarRemessa.Visible := (fCampoTabela('CLI_REMOUT', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli], False) = 'S') And ((Pos(strOpcDoc, 'PD_ER_') > 0));
end;

