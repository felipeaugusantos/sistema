begin
  Result := '';
  If (Self.strOpcDoc <> 'VN') Then
    Exit;
  Result := VS_strCodEmp;
end;

procedure TfrmFatVendas.pGarantirBufferGridItens;

  procedure pGarantirBuffer(const objGrid: TDBGridCitel);
    Const
      CAPACIDADE_MINIMA = 40;
    Var
      intCapacidade: Integer;
  begin
    If (Not Assigned(objGrid)) Or (Not objGrid.HandleAllocated) Then
      Exit;

    If (Not Assigned(TDBGridCitelHack(objGrid).DataLink)) Or
       (TDBGridCitelHack(objGrid).DefaultRowHeight <= 0) Then
      Exit;

    intCapacidade := (objGrid.ClientHeight div TDBGridCitelHack(objGrid).DefaultRowHeight) + 2;

    If (intCapacidade < CAPACIDADE_MINIMA) Then
      intCapacidade := CAPACIDADE_MINIMA;

    If (TDBGridCitelHack(objGrid).DataLink.BufferCount < intCapacidade) Then
      TDBGridCitelHack(objGrid).DataLink.BufferCount := intCapacidade;
  end;

begin
  pGarantirBuffer(dbgItens);
  pGarantirBuffer(dbgSubItens);
end;

