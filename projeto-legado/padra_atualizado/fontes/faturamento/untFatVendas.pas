function TfrmFatVendas.fGetPalavrasBuscaPorDescricao: TStringList;
Var
  strPalavras: String;
begin
  Result := TStringList.Create;

  strPalavras := Trim(edtDescricaoLocalizar.Text);

  While Pos('  ', strPalavras) > 0 Do
    strPalavras := AnsiReplaceStr(strPalavras, '  ', ' ');

  Result.Text := AnsiReplaceStr(strPalavras, ' ', #13#10);
end;

function TfrmFatVendas.fAtendeFiltroDescricaoItem(stlPalavras: TStringList; strDescricao: String): Boolean;
  Var
    strPalavra: String;
begin
  Result := True;
  For strPalavra In stlPalavras Do
    Result := Result And
      UpperCase(fRemoveAcento(strDescricao))
        .Contains(UpperCase(fRemoveAcento(strPalavra)));
end;

