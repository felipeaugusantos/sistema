function  TfrmFatVendas.fDevolucaoComADCrm: Boolean;
Begin
  Result := VS_strHabilitarCRM And (fatVenda.strOpcDoc = 'DV') And (fCfgSis('UTI_AD', varString) = 'S');
End;

function TfrmFatVendas.fDevolucaoComADCrmCarregada: Boolean;
begin
  Result := fDevolucaoComADCrm And blnCarregouDadosAD And (Not blnLiberouADComSenha);
end;

function TfrmFatVendas.fDevolveDocumentoParaEmpresaAbastecimento(
  const strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
var
  strEmpresaAbastecimento: String;
begin
  Result := True;

  if (not fCfgSis('EMPDAD', varBoolean)) then
    Exit;

  if fCampoTabela('AUX_ABADEP','MOVGER INNER JOIN AUXMOV ON(MOVGER.AUTOINCREM = AUXMOV.AUX_SEQGER)',['GER_NUMDOC','GER_ESPDOC','GER_CODEMP','GER_CODCLI'],[strNumDoc,strEspDoc,strCodEmp,strCodCli]) <> 'S' then
    Exit;

  strEmpresaAbastecimento := fCampoTabela('AUX_EMPDEP','MOVGER INNER JOIN AUXMOV ON(MOVGER.AUTOINCREM = AUXMOV.AUX_SEQGER)',['GER_NUMDOC','GER_ESPDOC','GER_CODEMP','GER_CODCLI'],[strNumDoc,strEspDoc,strCodEmp,strCodCli]);

  if (Not fEmptyStr(strEmpresaAbastecimento)) and (strEmpresaAbastecimento <> VS_strCodEmp) then
  begin
    if fMensagem('', 'Abastecimento por depósito - Deseja voltar os itens para o estoque da:', ['Empresa do &Abastecimento', 'Empresa da &Devolução'], 1, False, 1, 250, False, 0, False, False, False, 0, 590) = 2 then
    begin
      Result := False;
      fatVenda.strPerguntaDevAbaDep := 'DEVOLUCAO';
    end
    else
    begin
      fatVenda.strPerguntaDevAbaDep := 'ABASTECIMENTO';
    end;
  end;

end;

procedure TfrmFatVendas.pAjustaTelaDevolucaoCRM;
Var
  intTipLib: Integer;
begin
  If fDevolucaoComADCrm Then
  Begin
    intTipLib := fGetMenu('Escolha o Tipo de Liberação:', ['Liberação com AD', 'Digitar senha de liberação'], 1, True);
    case intTipLib of
      -1: Begin
            PostMessage(Self.Handle,WM_CLOSE,0,0);
            ModalResult := MrCancel;
            Exit;
          End;
       2: Begin
            objLiberacao.Clear;
            objLiberacao.strDirAce    := 'EDSUAD';
            objLiberacao.strCodOpe    := strLoginUsuarioLogado;
            objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
            objLiberacao.objMsgLibera.pAddTexto('Entrada de Devolução/Garantia sem vinculo de uma Autorização de Devolução (AD).');

            blnLiberouADComSenha := objLiberacao.fLibera;
          End;
    end;

    If Not blnLiberouADComSenha Then
    Begin
      blnCarregouDadosAD := fConfirmaDadosCabecalho;

      If (cdsVenda.IsEmpty) Then
        fMensagem('ATENÇÃO', 'Nenhum item foi carregado para realizar a devolução!', ['&OK']);
    End;

  End;
end;

procedure TfrmFatVendas.pAjustaTelaPorEspecieDoc(const strOpcDoc: string);
const
  arrEspDoc: TArray<string> = ['DV'];
begin
  Case AnsiIndexStr(strOpcDoc, arrEspDoc) of
    0 : Begin
          pAjustaTelaDevolucaoCRM;
        End;
  End;
end;

procedure TfrmFatVendas.pAjustaValorProdutoPrecoMinimo;
var
  blnFiltered: Boolean;
  strFilter: String;
  prcScroll: TprcScroll;
  intConfirmandoBkp: Integer;
begin
  if not fCfgSis('ALTVMT', varBoolean) then
    Exit;

  if (Pos(strOpcDoc, 'PD_OR_VN_') <= 0) then
    Exit;

  if not Assigned(fatVenda.cdsTravaProdMin) then
    Exit;

  if not fatVenda.cdsTravaProdMin.Active then
    Exit;

  if fatVenda.cdsTravaProdMin.RecordCount <= 0 then
    Exit;

  if cdsVenda = Nil then
    Exit;

  if not cdsVenda.Active then
    Exit;

  if cdsVenda.RecordCount <= 0 then
    Exit;

  pDisableControls(cdsVenda, prcScroll);
  intConfirmandoBkp := intConfirmando;

  try
    VS_IgnoraTravaAjustePrecoAutorizado := True;
    strFilter   := cdsVenda.Filter;
    blnFiltered := cdsVenda.Filtered;

    fatVenda.cdsTravaProdMin.First;

    while not fatVenda.cdsTravaProdMin.Eof do
    begin
      intConfirmando := -1;
      cdsVenda.Filtered := False;
      cdsVenda.Filter := ' AUTOINCREM = '+QuotedStr(fatVenda.cdsTravaProdMin.FieldByName('SEQFDO').AsString )+' ';
      cdsVenda.Filtered := True;

      if cdsVenda.RecordCount <= 0 then
      begin
        fatVenda.cdsTravaProdMin.Next;
        Continue;
      end;

      pSetFocus(dbgItens);
      blnAlterandoPrecoAtravesDaTrava := True;
      pCarregaItensAlteracao;
      blnAlterandoPrecoAtravesDaTrava := False;

      edtUnitar.Text := FloatToStrF(fatVenda.cdsTravaProdMin.FieldByName('PREAUT').AsFloat, ffFixed, 12, 2);
      edtDesCon.Text := '0,00';

      btnAdicionar.Click;
      btnCancelaItem.Click;

      fatVenda.cdsTravaProdMin.Next;
    end;

    cdsVenda.Filter := strFilter;
    cdsVenda.Filtered := blnFiltered;
    pPreencheMatrizFechamento;
    pCalculaTotGer;
    pAtualizarEditsTotais;
    fatVenda.pCalculaTotalParaCadRec;

    fDigDuplic(fatVenda.arrDuplicata, fatVenda.strConPag, 0,
       fatVenda.fltTotCadRec - fatVenda.fltValAdt,
       False, True, False, fatVenda.dtaDigDup, False, fatVenda.fltImpFre, 'N',
       fCfgSis('DUPRED', varBoolean), True, fatVenda.fltValAdt, True,
       Nil,  //  arrValores
       '',   //  strEspDoc
       True, //  True
       True, //  True;
       fatVenda.pMostraContaCorrenteCliente);

    fatVenda.blnAlterouPrecoTravaRemota := True;

    pMensagemOk('Houveram alterações de preços para o valor autorizado, o valor final de todos os produtos devem estar igual ou maior que o autorizado.');
  finally
    pEnableControls(cdsVenda, prcScroll);
    blnAlterandoPrecoAtravesDaTrava := False;
    VS_IgnoraTravaAjustePrecoAutorizado := False;
    intConfirmando := intConfirmandoBkp;
  end;
end;

procedure TfrmFatVendas.pMostraProdutosDigitados;
  Var
    item: TDadosFechamento;
    fltPerCom: Double;
    fltTot_RT: Double;
    strVendedor: String;
    cdsDados   : TUniClientDataSet;
    objCalcComissaoVend: TCalculoComissaoVendedor;
    intContador: Integer;
    frmFatMostraProdutos : TfrmFatMostraProdutos;
begin
  If (Not fEmptyStr(fCfgSis('SENVCO'))) Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Visualizar Comissão');

    objLiberacao.strDirAce := 'VCOMIS';
    objLiberacao.strSenLib := fCfgSis('SENVCO');
    objLiberacao.strMsgSen := 'Comissão';
    objLiberacao.strCodOpe := fatVenda.strCodVen;
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;


    If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Exit;
  End;

  btnCancelaItem.Click;

  cdsDados := TUniClientDataSet.Create(Self);

  pCloneDataSet(cdsDados, cdsVenda);
  cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;

  Try
    pCriarFormularios(TfrmFatMostraProdutos, frmFatMostraProdutos);

    frmFatMostraProdutos.strPrzMed := FloatToStrF(fCalcMediaPagto(fatVenda.strConPag),ffFixed,12,0);

    pPreencheMatrizFechamento;

    For intContador := Low(fatVenda.arrMatItens) To High(fatVenda.arrMatItens) Do
    Begin
      fatVenda.pCalculaGravaICMSUFDestino('', '', fatVenda.arrMatItens[intContador] );
    End;

    If fCfgSis('EXIPRO', VarBoolean) And (Pos(strOpcDoc, 'VN_OR_PD_') > 0) Then
      TPromocaoBrindes.pCalculaPontosGeradosVenda(cdsDados, strOpcDoc);

    cdsDados.First;

    For item In fatVenda.arrMatItens Do
    Begin
      If Not fatVenda.fUsaVendedorDoItemParaComissao(item.strCodVen) Then
        strVendedor := fatVenda.strCodVen
      Else
        strVendedor := item.strCodVen;

      objCalcComissaoVend := fatVenda.fCriaCalculoComissaoVendedor(strVendedor);

      fltPerCom := objCalcComissaoVend.fRetPerComissao(item, fatVenda.strTipVen);

      fltTot_RT := item.fltRT_Ori * item.fltQtdIte;

      If cdsDados.Locate('AUTOINCREM', item.intAutInc, []) Then
      Begin
        cdsDados.Edit;
        cdsDados.FieldByName('GRU_PERCOM').AsFloat := fltPerCom;
        cdsDados.FieldByName('ITE_COMVEN').AsFloat := ((fltPerCom * (item.fltTotIte - item.fltDesEsp - fltTot_RT)) / 100);
        cdsDados.Post;
      End;

      frmFatMostraProdutos.fltTotQtq := frmFatMostraProdutos.fltTotQtq + cdsDados.FieldByName('ITE_QTDITE').AsFloat;
      frmFatMostraProdutos.fltTotUnt := frmFatMostraProdutos.fltTotUnt + cdsDados.FieldByName('ITE_UNITAR').AsFloat;
      frmFatMostraProdutos.fltTotGer := frmFatMostraProdutos.fltTotGer + cdsDados.FieldByName('ITE_TOTITE').AsFloat;
      frmFatMostraProdutos.fltTotCom := frmFatMostraProdutos.fltTotCom + cdsDados.FieldByName('ITE_COMVEN').AsFloat;
      frmFatMostraProdutos.fltTotPon := frmFatMostraProdutos.fltTotPon + cdsDados.FieldByName('ITE_PONBRI').AsFloat;

      FreeAndNil(objCalcComissaoVend);
    End;

    pCloneDataSet(frmFatMostraProdutos.cdsDados, cdsDados);

    frmFatMostraProdutos.cdsDados.IndexFieldNames := cdsVenda.IndexFieldNames;
    frmFatMostraProdutos.strOpcDoc := strOpcDoc;
    frmFatMostraProdutos.ShowModal;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[frmFatVendas.pMostraProdutosDigitados]');

    On E: ExceptionAutCom Do
      fMensagem('', E.Message, ['&O K']);
  End;

  FreeAndNil(cdsDados);
  pFreeAndNil(frmFatMostraProdutos);
end;

