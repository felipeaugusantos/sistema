    btnConfirma.Click;

  Finally
    frmFatVendas.Enabled := True;
  End;

end;

function TfrmFatVendas.fConfirmaPedido: Boolean;
begin
  If Not btnConfirma.Enabled Then
  Begin
    Result := False;
    Exit;
  End;

  pEnabledFechamento(False);

  Try
    frmFatVendas.Enabled := False;
    Try
      fatVenda.blnPedFabOSG := False;
      pCriarFormularios(TfrmFatConfPedidos, frmFatConfPedidos);
      frmFatConfPedidos.fatVenda := fatVenda;

      if frmFatConfPedidos.blnDeuErro then
      Begin
        Result := False;
        pFreeAndNil(frmFatConfPedidos);
        Exit;
      End;

      frmFatConfPedidos.pAlterarClienteConfirmacaoPedido := Self.pAlterarClienteConfirmacaoPedido;

      frmFatConfPedidos.ShowModal;

      If fCfgSis('INDCOM', varBoolean) Then
        fatVenda.strIndCom := frmFatConfPedidos.strIndCom;

      If fCfgSis('PORPED', varBoolean) Then
        fatVenda.strPorPed := frmFatConfPedidos.strCodPor;

      pMostrarDadosFazendaRodape(False);

      If fCfgSis('CADFAZ', VarBoolean) And Not fEmptyStr(frmFatConfPedidos.strCodFaz) Then
      Begin
        If fatVenda.fSelecionarFazendaCliente(edtCodCli.Text, frmFatConfPedidos.strCodFaz) Then
        Begin
          pMostrarDadosFazendaRodape(True);
        End;
      End;

      If (Not fEmptyStr(frmFatConfPedidos.strCodEmb)) And (fCfgSis('CADEMB', VarBoolean)) Then Begin
        fatVenda.strCodEmbarcacao := frmFatConfPedidos.strCodEmb;
        pMostrarDadosEmbarcacaoRodape(True);
      End Else Begin
        pMostrarDadosEmbarcacaoRodape(False);
      End;

      pSetaComboComercializacaoIndustrializacao;

      If fCfgSis('USOREV', VarBoolean) Then
      Begin
        fatVenda.strCliCon := frmFatConfPedidos.strCliCon;
        fatVenda.strTpOper := frmFatConfPedidos.strTpOper;
        fatVenda.pRedefineTipoAbf;
      End;

      cbTabPreco.Text     := fatVenda.strTabPre;
      fatVenda.strConfSer := frmFatConfPedidos.strTemSer;
      Result              := frmFatConfPedidos.blnConfirma;
      fatVenda.blnPedFabOSG := frmFatConfPedidos.blnPedFabOSG;

      If (VS_strTipExp = '4') Then
      Begin
        fatVenda.strOpeExp := frmFatConfPedidos.strOpeExp;
        fatVenda.strSepExp := frmFatConfPedidos.strSepExp;
      End;

      If (frmFatConfPedidos.blnConfirma) And
         (fatVenda.strTipOpe = 'R') Then
        fatVenda.strOpcDoc := 'CO';
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fConfirmaPedido]');
      End;
    End;

    pFreeAndNil(frmFatConfPedidos);

  Finally
    frmFatVendas.Enabled := True;
    pEnabledFechamento(True);
  End;

end;

