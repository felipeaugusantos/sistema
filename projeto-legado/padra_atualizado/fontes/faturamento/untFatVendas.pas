function TfrmFatVendas.fGerarArquivoTXTPrecosHUBCitel(strCaminhoArquivo: String): Boolean;
  Var
    txtArquivo : TextFile;
begin
  Result := False;

  If fEmptyStr(strCaminhoArquivo) Then
  Begin
    fMensagem('', 'Selecione a pasta e o nome do arquivo corretamente!', ['&Ok']);
    Exit();
  End;

  AssignFile(txtArquivo, strCaminhoArquivo);
  dbgItens.DataSource.DataSet.DisableControls;
  Try
    Rewrite(txtArquivo);
    Append(txtArquivo);
    Writeln(txtArquivo, 'SKU;PREÇO VENDA');

    dbgItens.DataSource.DataSet.First;
    While Not dbgItens.DataSource.DataSet.Eof Do
    Begin
      Writeln(txtArquivo, dbgItens.DataSource.DataSet.FieldByName('ITE_CODITE').AsString+';'+
              FormatFloat('#0.00', dbgItens.DataSource.DataSet.FieldByName('ITE_UNITAR').AsFloat));

      dbgItens.DataSource.DataSet.Next;
    End;

    Flush(txtArquivo);
    Result := True;
  Finally
    dbgItens.DataSource.DataSet.EnableControls;
    CloseFile(txtArquivo);
  End;
end;

