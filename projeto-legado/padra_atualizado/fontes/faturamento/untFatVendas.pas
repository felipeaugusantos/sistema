    {****************************************************LU*}
    lblTabPrecoItem.Visible := (fCfgSis('TABITE') = 'S') And (Pos(strOpcDoc, 'DV_PR_OF_DD_ER_') <= 0);
    cbTabPrecoItem.Visible  := (fCfgSis('TABITE') = 'S') And (Pos(strOpcDoc, 'DV_PR_OF_DD_ER_') <= 0);

    If cbTabPrecoItem.Visible Then
