procedure TfrmFatVendas.mnuObsCliClick(Sender: TObject);
  var
    qryQuery: TUniQuery;
begin
  inherited;

  If Not fVerificaAcessoSistema('OBCLVD') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Observações do Cliente!', ['&O k']);
    Exit;
  End;

  If InterlockedIncrement(intConfirmando) = 0 Then
  Begin

    If (mnuObsCli.Visible) And (mnuObsCli.Enabled) Then
    Begin
      pCriarFormularios(TfrmFatMostraObsCliente, frmFatMostraObsCliente);
      qryQuery := fCriaQuery;
      Try
        With qryQuery Do
        Begin
          SQL.Clear;
          SQL.Add(' SELECT ');
          SQL.Add('   CLI_OBSERV ');
          SQL.Add(' FROM CADCLI ');
          SQL.Add(' WHERE CLI_CODCLI = :CODCLI ');
          ParamByName('CODCLI').AsString := edtCodCli.Text;
          Open;

          Try
            frmFatMostraObsCliente.memObserv.Texto := FieldByName('CLI_OBSERV').AsString;
            frmFatMostraObsCliente.strCodCli       := qryConCli.FieldByName('CLI_CODCLI').AsString;
            frmFatMostraObsCliente.ShowModal;
          Except
            On E: Exception Do
              pMensagensErro(E.Message, '[mnuObsClick]');
          End;
        End;
      Finally
        FreeAndNil(qryQuery);
        pFreeAndNil(frmFatMostraObsCliente);
      End;
    End;

    InterlockedDecrement(intConfirmando);
  End
  Else
    InterlockedDecrement(intConfirmando);
