function TfrmFatVendas.fValidaEstoqueEmpresaPrioridade(const blnEfetuarTrava : Boolean; out fltEstoqueTotal : Double) : Boolean;
  const
    SELECT_PRIORIDADE = 'SELECT * FROM CADHIE WHERE HIE_CODITE = :CODITE AND HIE_EMPITE = :EMPITE';
    EXCETO_PRIORIDADE = 'AND HIE_EMPSAI NOT IN (#EXCETO)';
    ORDENA_PRIORIDADE = 'ORDER BY HIE_ORDEM_';

  var
    strCodEmp : string;
    qryPrioridade : TUniQuery;
    fltEstoqueEmpresa,
    fltTotalLancado : Double;
    objSalLoj: TSaldoLojas;
    recSaldos, recSaldosML: TRecSaldos;

  function fUsandoHierarquiaCadPro : Boolean;
  begin
    Result := fUtilizaEmpresaPrioridadeEstoqueUsandoHierarquiaCadPro_CadGeral And
              fTemPrioridadeDeEstoquePorProdutoCadastrado;
  end;

  function fGetEmpSai : String;
  begin
    Result := IIF(fUsandoHierarquiaCadPro, 'HIE_', 'EPS_') + 'EMPSAI';
  end;

  function fGetArmSai : String;
  begin
    Result := IIF(fUsandoHierarquiaCadPro, 'HIE_', 'EPS_') + 'ARMSAI';
  end;

begin
  Result := True;
  fltEstoqueTotal := 0;
  fltTotalLancado := 0;
  qryPrioridade := fCriaQuery;
  objSalLoj := TSaldoLojas.Create(Self);

  strCodEmp := IIF(pnlEmpresa.Visible, edtCodEmp.Text, VS_strCodEmp);

  try

    If fUsandoHierarquiaCadPro Then
    Begin

      qryPrioridade.Close;
      qryPrioridade.SQL.Clear;
      qryPrioridade.SQL.Add(SELECT_PRIORIDADE);

      If Not fEmptyStr(strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque) Then
        qryPrioridade.SQL.Add(EXCETO_PRIORIDADE.Replace('#EXCETO', strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque));

      qryPrioridade.ParamByName('CODITE').AsString := edtCodIte.Text;
      qryPrioridade.ParamByName('EMPITE').AsString := strCodEmp;
      qryPrioridade.SQL.Add(ORDENA_PRIORIDADE);
      qryPrioridade.Open;

    End
    Else
    Begin

      qryPrioridade.Close;
      qryPrioridade.SQL.Clear;
      qryPrioridade.SQL.Add('SELECT * FROM CADEPS');
      qryPrioridade.SQL.Add('WHERE EPS_CODEMP = :CODEMP');

      if not fEmptyStr(strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque) then
        qryPrioridade.SQL.Add('AND EPS_EMPSAI NOT IN('+strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque+')');

      qryPrioridade.SQL.Add('ORDER BY EPS_ORDEM_');
      qryPrioridade.ParamByName('CODEMP').AsString := strCodEmp;
      qryPrioridade.Open;

    End;

    if not qryPrioridade.IsEmpty then
    begin

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('As empresas prioritárias de saída não possuem estoque.');
      objLiberacao.objMsgLibera.pAddSeparador(67);

      while not qryPrioridade.Eof do
      begin
        if (fCfgSis('CTLEST',varString, qryPrioridade.FieldByName(fGetEmpSai).AsString) = '2') then
        begin
          fltEstoqueEmpresa := fRetSaldosEmpresa(edtCodIte.Text,
                                                 qryPrioridade.FieldByName(fGetEmpSai).AsString,
                                                 qryPrioridade.FieldByName(fGetArmSai).AsString,
                                                 fatVenda.fIgnorarLote(qryPrioridade.FieldByName(fGetEmpSai).AsString, edtCodIte.Text));

          objSalLoj.pCalculaSaldos(Nil,
                                   recSaldos, recSaldosML,
                                   fltEstoqueEmpresa, qryPrioridade.FieldByName(fGetEmpSai).AsString, qryPrioridade.FieldByName(fGetEmpSai).AsString,
                                   edtCodIte.Text, 0,
                                   fCfgSis('ENTFUT', varBoolean), False, fCfgSis('ORDPRO', varBoolean), fCfgSis('CALSAL', varInteger), qryPrioridade.FieldByName(fGetArmSai).AsString);

        end
        else
        begin
          fltEstoqueEmpresa := fRetSaldosEmpresa(edtCodIte.Text,
                                                 qryPrioridade.FieldByName(fGetEmpSai).AsString);

          objSalLoj.pCalculaSaldos(Nil,
                                   recSaldos, recSaldosML,
                                   fltEstoqueEmpresa, qryPrioridade.FieldByName(fGetEmpSai).AsString, qryPrioridade.FieldByName(fGetEmpSai).AsString,
                                   edtCodIte.Text, 0,
                                   fCfgSis('ENTFUT', varBoolean), False, fCfgSis('ORDPRO', varBoolean), fCfgSis('CALSAL', varInteger));
        end;


        objLiberacao.objMsgLibera.pAddTextoCaption('Empresa', qryPrioridade.FieldByName(fGetEmpSai).AsString + ' - ' + fRetNomeEmpresa(qryPrioridade.FieldByName(fGetEmpSai).AsString), 36, alEsquerda, teAmbos, '', 50);

        if (fCfgSis('CTLEST',varString, qryPrioridade.FieldByName(fGetEmpSai).AsString) = '2') then
        begin
          objLiberacao.objMsgLibera.pAddTextoCaption('Armazém', qryPrioridade.FieldByName(fGetArmSai).AsString + ' - ' + fRetNomeArmazemPorEmpresa(qryPrioridade.FieldByName(fGetArmSai).AsString, fGetEmpSai), 36, alEsquerda, teAmbos, '', 50);
        end;

        objLiberacao.objMsgLibera.pAddTextoCaption('Saldo'  , FormatFloat('#,##0.00', recSaldos.fltSalDis)      , 36, alEsquerda, teAmbos, '', 50);
        objLiberacao.objMsgLibera.pAddSeparador(67);

        fltEstoqueTotal := fltEstoqueTotal + recSaldos.fltSalDis;
        qryPrioridade.Next;
      end;

      If (blnEfetuarTrava) Then
      Begin
        if cdsVenda.RecordCount > 0 then
        begin
          cdsVenda.First;
          while not cdsVenda.Eof do
          begin
            if cdsVenda.FieldByName('ITE_CODITE').AsString = edtCodIte.Text then
            begin
              fltTotalLancado := fltTotalLancado + cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
            end;
            cdsVenda.Next;
          end;
          cdsVenda.First;
        end;

        if fltTotalLancado > 0 then
        begin
          objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade já lançada'  , FormatFloat('#,##0.00', fltTotalLancado)      , 36, alEsquerda, teAmbos, '', 50);
          objLiberacao.objMsgLibera.pAddSeparador(67);
        end;

        objLiberacao.strDirAce := 'LBSDVN';
        objLiberacao.blnTraTel := False;
        objLiberacao.strMsgSen := 'Liberação de produto sem saldo - Pedido.';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;
        objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
        objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
        objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

        If ((fltEstoqueTotal - (fltTotalLancado + StrToFloatDef(edtQtdIte.Text, 0))) < 0) Then
        Begin
          Result := objLiberacao.fLibera;
        End;
      End;

    end;

  finally
    FreeAndNil(qryPrioridade);
    FreeAndNil(objSalLoj);
  end;
end;

function TfrmFatVendas.fValidaFechamentoEmCupomFiscal(): Boolean;
Var
  intContador: Integer;
begin
  Result := True;

  If Result Then
  Begin
    If Not fPermiteEmitirCupomParaForaDoEstado(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, fatVenda) Then
    Begin
      Result := False;
      Exit;
    End;
  End;

  If (Result) and (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'IF') Then
  begin

    If fatVenda.fPossuiBrindeProduto Then
    begin
      fMensagem('', 'Não é permitido emitir cupom fiscal para produto de brinde.', ['&Ok']);
      Result := False;
      Exit;
    end

  end;

  If (Result) and (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'IF') Then
  begin

    If not fEmptyStr(fatVenda.strNumPok) Then
    begin
      fMensagem('', 'Não é permitido emitir cupom fiscal para vendas online (e-commerce).', ['&Ok']);
      Result := False;
      Exit;
    end

  end;

  {*****************************************}
  {* TRAVA A QUANTIDADE EM 9999,999 QUANDO *}
  {* FOR CUPOM FISCAL.                     *}
  {**************************************MV*}
  If FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'IF' Then
  Begin
    FVariaveisFechamentoVenda.strItensTravarIF := '';
    if not fCfgSis('USNFCE', varBoolean) then
    begin
      For intContador := 0 To Length(fatVenda.arrMatItens)-1 Do
      Begin
        If fFormataFloat(fatVenda.arrMatItens[intContador].fltQtdIte, 3) > fFormataFloat(MAX_QUANTIDADE_CUPOM,3) Then
        Begin
          FVariaveisFechamentoVenda.strItensTravarIF := FVariaveisFechamentoVenda.strItensTravarIF + fatVenda.arrMatItens[intContador].strDesIte + #13#10;
        End;
      End;
    end;

    If Not fEmptyStr(FVariaveisFechamentoVenda.strItensTravarIF) Then
    Begin
      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.lblMensagem.Caption := 'Itens com quantidade acima de ' + FloatToStrF(MAX_QUANTIDADE_CUPOM, ffNumber, 12, 3) + ':';
        frmObservacao.memObs.Texto := FVariaveisFechamentoVenda.strItensTravarIF;
        frmObservacao.ShowModal;
        FreeAndNil(frmObservacao);
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[TfrmObservacao_ItensIF]');
        End;
      End;

      Result := False;
      Exit;
    End;

  End;

  If (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'IF') And (fatVenda.fltTotSer > 0) Then
  Begin
    fMensagem('ATENÇÃO', 'Não é permitido faturar orçamentos/pedidos com serviço em cupom fiscal.', ['&Ok']);
    Result := False;
    Exit;
  End;

end;

function TfrmFatVendas.fValidaImpLis(out strProdImpLis: String): Boolean;
  Var
    cdsDados : TUniClientDataSet;
    strEmpresaDoItem : String;
    objIteger : IMyCampoTabela;

    function fEmpIte: String;
    begin
      If (chkEntCD.Checked) Then
        Result := fCfgSis('EMP_CD' , varString)
      Else
      Begin
        Result := IIF(fEmptyStr(cdsDados.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsDados.FieldByName('ITE_EMPITE').AsString);
      End;
    end;

begin
  cdsDados := TUniClientDataSet.Create(Nil);
  Try
    strProdImpLis := '';
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.First;
    While (Not cdsDados.Eof) Do
    Begin
      strEmpresaDoItem := fEmpIte;
      objIteger := fIteGer(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpresaDoItem);
      If (objIteger.FieldByName('ITE_IMPLIS').AsString = 'N') Then
        pIncrementaListaStr(cdsDados.FieldByName('ITE_CODITE').AsString+'-'+strEmpresaDoItem, strProdImpLis);
      cdsDados.Next;
    End;
    Result := fEmptyStr(strProdImpLis);
  Finally
    FreeAndNil(cdsDados);
  End;
end;

function TfrmFatVendas.fValidaIteInat(out strIteInat: String): Boolean;
  Var
    strBookMark: TBookmark;
begin
  Result := True;

  Try
    strIteInat := '';

    strBookMark := cdsVenda.Bookmark;
    cdsVenda.DisableControls();
    cdsVenda.First();

    Try
      While (Not cdsVenda.Eof) Do Begin
        If (fCampoTabela('ITE_ITEATI', 'CADITE', ['ITE_CODITE'], [cdsVenda.FieldByName('ITE_CODITE').AsString], False) <> 'S') Then Begin
          If (Not (Pos(cdsVenda.FieldByName('ITE_CODITE').AsString, strIteInat) > 0)) Then
            strIteInat := strIteInat + cdsVenda.FieldByName('ITE_CODITE').AsString + ', ';

          Result := False;
        End;

        cdsVenda.Next();
      End;

      strIteInat := Copy(strIteInat, 1, Length(strIteInat) - 2);
    Except
      On E: Exception Do Begin
        raise;
      End;
    End;
  Finally
    cdsVenda.Bookmark := strBookMark;
    cdsVenda.EnableControls();
  End;
end;

