procedure TfrmFatVendas.pRecalcularPrecosTinta;
  var
    item: TDadosFechamento;
    dicRetorno: TDicionario;
    stlItensTraMl: TStringList;
    arrBaixaPigmentos: TBaixaPigmentosArray;
    arrFormul: TForMulTinDetArray;
    fltPreVen: Double;
    fltDesMax: Double;
    strTabPreTin: String;
    strOpcPreTin: String;
    blnProPreTin: Boolean;
    blnUsaPreCusTin: Boolean;
    strEmpSalResTin: String;
    calcCustoReal: TCalcCustoReal;
    strCodSit,
    strCodAbf: String;

  function fJaSelecionouPrecoTE: Boolean;
  begin
    Result := fCfgSis('ESCPTE', varBoolean) And
              fatVenda.blnCliFil And (Not fEmptyStr(fatVenda.strPreETe));
  end;

  procedure pDefineTintaEmPromocao;
  begin
    If (fatVenda.strIdePro <> 'NOR') Then
    Begin
      fatVenda.strPromoc := IIF(fEmptyStr(ifNull(dicRetorno['promoc'], 'N')), 'N', ifNull(dicRetorno['promoc'], 'N'));

      if fCfgSis('PROKIT', varBoolean) then
        TProQtdColetiva.pAdicionarStatusPromocaoDaTinta(dicRetorno['itetin'], fatVenda.strPromoc);
    End;
  end;

begin

  If Not Assigned(fCalcularTabelasdePreco) Then
    Exit;

  dicRetorno := TDicionario.Create;
  stlItensTraMl := TStringList.Create;

  Try
    dicRetorno.Limpar;
    stlItensTraMl.Clear;
    SetLength(arrBaixaPigmentos, 0);

    If (item.strIdePro <> 'NOR') Then
    Begin
      SetLength(arrBaixaPigmentos, 0);
      stlItensTraMl := TStringList.Create;

      blnProPreTin := (fCfgSis('PROPRE') = TRegraPrecoSugestao.PrecoDeTabela.Valor.ToString);

      If (btnAdicionar.Tag > 0) And
         (cbTabPrecoItem.Visible) And
         (cbTabPrecoItem.Enabled) Then
        strTabPreTin := fTabelaDePrecoDosItens()
      Else
        strTabPreTin := fatVenda.fDefineTabelaPrecoItem(fatVenda.strIdePro, strCodAca);

      strOpcPreTin := fatVenda.strPreETe;

      blnUsaPreCusTin := (fatVenda.blnCliFil And (fatVenda.strTEPREV = 'CUS') And (fatVenda.strPromoc <> 'S')) Or
                         (fatVenda.blnCliFil And (fatVenda.strTEPPRO = 'CUS') And (fatVenda.strPromoc = 'S')) Or
                         ((fCfgSis('PROSOE') = 'C') And (Pos(strOpcDoc, 'OU_OF_') > 0)) Or
                         ((fCfgSis('PROENT') = 'C') And (Pos(strOpcDoc, 'OE_EF_') > 0)) Or
                         (Pos(strOpcDoc, '_OV_PI_') > 0) Or
                         ((strOpcDoc = 'BR') And (fCfgSis('SUG_BR') = '1') Or
                         ((strOpcDoc = 'VN') And (fCfgSis('SUG_BR') = '1') And chkBrinde.Visible And chkBrinde.Checked));

      If fJaSelecionouPrecoTE Then
      Begin
        If CharInSet(RightStr(fatVenda.strPreETe, 1)[1], ['1'..'9']) Then
        Begin
          blnUsaPreCusTin := False;
          strTabPreTin := RightStr(fatVenda.strPreETe, 1);
        End
        Else
          blnUsaPreCusTin := (fatVenda.strPreETe = 'CUS');
      End;

      strEmpSalResTin := VS_strCodEmp;

      dicRetorno['usaprecus'] := blnUsaPreCusTin;
      dicRetorno['tabpre'] := strTabPreTin;
      dicRetorno['fatace'] := fltFatAce;
      dicRetorno['idepro'] := fatVenda.strIdePro;
      dicRetorno['montad'] := strMontad;
      dicRetorno['a_n_o_'] := strA_n_o_;
      dicRetorno['itetin'] := strIteTin;
      dicRetorno['tippre'] := strTipPre;
      dicRetorno['itebas'] := edtCodIte.Text;
      dicRetorno['iteemb'] := fatVenda.strCodEmb;
      dicRetorno['codemp'] := strEmpSalResTin;
      dicRetorno['empite'] := strEmpSalResTin;
      dicRetorno['volpro'] := fltVolPro;
      dicRetorno['linha_'] := strLinTin;
      dicRetorno['qtdemb'] := intQtdEmb;
      dicRetorno['descri'] := edtDesIte.Text;
      dicRetorno['tipcor'] := recForTin.strTipCor;
      dicRetorno['catali'] := strCatalize;
      dicRetorno['propre'] := (blnProPreTin);

      dicRetorno['codempprd'] := strEmpSalResTin;
      dicRetorno['complementob'] := recForTin.strCompB;
      dicRetorno['oprflj']    := edtOprFlj.Text;
      dicRetorno['empprd']    := fCfgSis('EMPPRD');
      dicRetorno['emp_cd']    := fCfgSis('EMP_CD');
      dicRetorno['Cd_S_N']    := IIF(chkEntCD.Checked, 'S', 'N');
      dicRetorno['empfat']    := fatVenda.fGetEmpPrecoVendaItemTinta(edtCodEmp.Text);
      dicRetorno['FatS_N']    := IIF(fatVenda.blnEmpFat, 'S', 'N');

      {*******************************************************************}
      {* É NECESSARIO QUE ALTERE A EMPRESA DA DLL DE TINTA DE MAQUINA    *}
      {* PARA QUE CALCULE CORRETAMENTE OS PRECOS DE ACORDO COM A EMPRESA *}
      {* QUE IRA FATURAR O PRODUTO (DARKA).                              *}
      {***************************************************************JC**}
      If fatVenda.fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
        pSetaEmpresaLogadaTinta(VS_strCodEmp)
      Else
        pSetaEmpresaLogadaTinta(dicRetorno['codemp']);

      dicRetorno.AdicionarObjeto('calculadorFatVendas', TFatVendasCalculadorWrapper.Create(fatVenda));

      If fCalcularTabelasdePreco( fatVenda.strIdePro,   // Tipo de Produto
                                  strIteTin,   // Item da Tinta
                                  strTipPre,   // Tipo de Preço
                                  strLinTin,   // Linha da Tinta
                                  strCatalize,   // Catalizador Utilizado
                                  intLazQua,   // Quarto (Lazzumix)
                                  intQtdEmb,   // Quantidade de Embalagem
                                  fStrToFloat(edtQtdIte.Text),   // Quantidade do Item
                                  edtDesIte.Text,   // Descrição do Item
                                  fatVenda.qryTintaAux,      // Arquivo de Formulas!
                                  fltVolPro,   // Volume a ser produzido (Tinta c/ Venda Dinamica)
                                  arrFormul,        // Retorno da Formulação
                                  arrBaixaPigmentos,// Retorno dos Pigmentos a serem baixados
                                  stlItensTraMl,
                                  strCodDil,
                                  fltPorDil,
                                  strDilCon,
                                  fltPorCat,
                                  recForTin.strTipCor,
                                  recForTin.strTextBase,
                                  recForTin.intModDil,
                                  dicRetorno) Then
      Begin
        pDefineTintaEmPromocao;

        If ((strOpcDoc = 'VN') And blnUsaPreCusTin ) Then
          case fCfgSis('SUG_BR', varInteger) of
            1:fltPreVen := IfNull(dicRetorno['precus'], 0.0);
            2:fltPreVen := IfNull(dicRetorno['preve' + strTabPreTin], 0.0);
            3:fltPreVen := IfNull(dicRetorno['preult'], 0.0);
            4:fltPreVen := IfNull(dicRetorno['impult'], 0.0);
          else
            fltPreVen := IfNull(dicRetorno['precus'], 0.0);
          end
        Else
          fltPreVen := IfNull(dicRetorno['preve' + strTabPreTin], 0.0);

        If (fCfgSis('CLIDES') = 'S') And
           (fCfgSis('DCVBVL') = 'L') Then
        Begin
          fltPreVen := fFormataFloat(fltPreVen * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
        End;

        fatVenda.fltTaxJur := 0.00;

        If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
        Begin
          fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem);
          fltPreVen := fltPreVen + fFormataFloat(fltPreVen * (fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem) / 100.0), 04);
        End;

        fatVenda.pCalculaValorRT(fltPreVen, fatVenda.FVal_RT);

        fatVenda.fltUniOri := fltPreVen; //Com Juros
        fatVenda.fltUniVis := IfNull(dicRetorno['preve' + strTabPreTin], 0.0); //Sem juros

        {*******************************************************************************}
        {* COMENTADO POIS NÃO FAZ SENTIDO MUDAR O UNIORI E UNIVIS POR CONTA DA TRAVA   *}
        {* TRAVA DE PREÇO POR VALOR MÍNIMO O TRAVAMENTO DEVE/DEVERIA TER SIDO FEITO NA *}
        {* RESPECITVA TRAVA QUANDO CFG_PROPRE = PREÇO DE TABELA REQ.: 113403           *}
        {****************************************************************************VA*}
//        If blnProPreTin And (fatVenda.strPromoc = 'S') Then //Troca o unitario original por conta da promocao
//        Begin
//          fatVenda.fltUniOri := IfNull(dicRetorno['preve' + strTabPreTin], fltPreVen);
//          fatVenda.fltUniVis := IfNull(dicRetorno['preve' + strTabPreTin], dicRetorno['unitar']); //Sem juros
//        End;

        fatVenda.fltPreCus := IfNull(dicRetorno['precus'], 0.0);
        fatVenda.fltPreCu2 := IfNull(dicRetorno['precu2'], IfNull(dicRetorno['precus'], 0.0));

        If dicRetorno['unitar_sem_formatar'] = Null Then
          dicRetorno['unitar_sem_formatar'] := IfNull(dicRetorno['preve' + strTabPreTin], 0.0);

        fatVenda.fltOutVal := IfNull(dicRetorno['outval'], 0);

        If IfNull(dicRetorno['acerto'], 'N') = 'S' Then
        Begin
          fatVenda.fltIcmSai := IfNull(dicRetorno['icmsai'] / dicRetorno['preve' + strTabPreTin + '_original'] * 100, 0);
          fatVenda.fltImpFed := IfNull(dicRetorno['impfed'] / dicRetorno['preve' + strTabPreTin + '_original'] * 100, 0);
          fatVenda.fltDesOpe := IfNull(dicRetorno['desope'] / dicRetorno['preve' + strTabPreTin + '_original'] * 100, 0);
        End
        Else
        Begin
          fatVenda.fltIcmSai := IfNull(dicRetorno['icmsai'] / dicRetorno['unitar_sem_formatar'] * 100, 0);
          fatVenda.fltImpFed := IfNull(dicRetorno['impfed'] / dicRetorno['unitar_sem_formatar'] * 100, 0);
          fatVenda.fltDesOpe := IfNull(dicRetorno['desope'] / dicRetorno['unitar_sem_formatar'] * 100, 0);
        End;

        fatVenda.fltSomaColorantes := IfNull(dicRetorno['somcol'], 0);
        fatVenda.fltPreMed := IfNull(dicRetorno['premed'], 0);
        fatVenda.fltImpUlt := IfNull(dicRetorno['impult'], 0);
        fatVenda.fltPreUlt := IfNull(dicRetorno['preult'], 0);

        calcCustoReal := TCalcCustoReal.Create;
        calcCustoReal.fltUnitar := fltPreVen;
        calcCustoReal.fltPreCus := fatVenda.fltPreCus;

        strCodSit := '';
        strCodAbf := fatVenda.fGetCodAbf(edtCodIte.Text, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem));
        If (Not fEmptyStr(fatVenda.GetTipAbf(fRetEmpresaItem))) And (fatVenda.fBuscaAbfIcm(edtCodIte.Text, fRetEmpresaItem, strCodAbf, fatVenda.fTrocaUFEndEntrega)) Then
          strCodSit := fatVenda.cdsAbfIcm.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(fRetEmpresaItem)).AsString;

        calcCustoReal.fltDifal := fatVenda.fGetAlqDifal(edtCodIte.Text,
                                                        strEmpSalResTin,
                                                        strCodAbf,
                                                        strCodSit);

        calcCustoReal.fltFcp   := fatVenda.fGetAlqFcpIcms(edtCodIte.Text,
                                                          strEmpSalResTin,
                                                          strCodAbf,
                                                          strCodSit,
                                                          fatVenda.fltIcmSai,
                                                          calcCustoReal.fltUnitar);

        fatVenda.fltPreCu2 := fatVenda.fRetornaPrecoCusto(Preco_de_Custo_Real,
                                                          edtCodIte.Text,
                                                          strEmpSalResTin,
                                                          calcCustoReal.fltPreCus,
                                                          '',
                                                          calcCustoReal,
                                                          True);

        FreeAndNil(calcCustoReal);

        dicRetorno.Remove('unitar_sem_formatar');

        fatVenda.fltComAnt := IfNull(dicRetorno['precus'], 0.0);
        edtUnitar.Text     := FloatToStrF(fltPreVen, ffFixed, 12, fatVenda.VS_intDecUni);

        fatVenda.fltPreVe1 := IfNull(dicRetorno['preve1'], fatVenda.fltUniVis);
        fatVenda.fltPreVe2 := IfNull(dicRetorno['preve2'], fatVenda.fltUniVis);
        fatVenda.fltPreVe3 := IfNull(dicRetorno['preve3'], fatVenda.fltUniVis);
        fatVenda.fltPreVe4 := IfNull(dicRetorno['preve4'], fatVenda.fltUniVis);
        fatVenda.fltPreVe5 := IfNull(dicRetorno['preve5'], fatVenda.fltUniVis);
        fatVenda.fltPreVe6 := IfNull(dicRetorno['preve6'], fatVenda.fltUniVis);
        fatVenda.fltPreVe7 := IfNull(dicRetorno['preve7'], fatVenda.fltUniVis);

        fltPrcTin          := IfNull(dicRetorno['prctin'], 0.0);
        fltPrvTin          := IfNull(dicRetorno['preve' + strTabPreTin], 0.0);

        {*******************************************************************************}
        {* COMENTADO POIS NÃO FAZ SENTIDO MUDAR O UNIORI E UNIVIS POR CONTA DA TRAVA   *}
        {* TRAVA DE PREÇO POR VALOR MÍNIMO O TRAVAMENTO DEVE/DEVERIA TER SIDO FEITO NA *}
        {* RESPECITVA TRAVA QUANDO CFG_PROPRE = PREÇO DE TABELA REQ.: 113403           *}
        {****************************************************************************VA*}
//        If blnProPreTin And (fatVenda.strPromoc = 'S') Then //Troca o unitario original por conta da promocao
//          fltPrvTin := IfNull(dicRetorno['preve' + strTabPreTin], 0.0);

        fltDesOpeTinta     := IfNull(dicRetorno['desopetinta'], 0.0);

        If fltPrcTin <= 0 Then
          fltPrcTin := fatVenda.fltPreCus;

        If fltPrvTin <= 0 Then
          fltPrvTin := fatVenda.fltUniVis;

        If (fatVenda.blnCliFil) Then
        Begin
          if strOpcDoc = 'UC' then
          begin
            strOpcPreTin := fCfgSis('UCPREV');
          end
          Else If (SameText(strOpcDoc, 'PA')) Then
          begin
            strOpcPreTin := fCfgSis('PAPREV');
          end
          Else If Not fJaSelecionouPrecoTE Then
          Begin
            If (fatVenda.strPromoc = 'S') Then
              strOpcPreTin := fatVenda.strTEPPRO
            Else
              strOpcPreTin := fatVenda.strTEPREV;
          End;

          (************************************************************************)
          (* Quando é preco de custo ja esta sendo tratato acima no blnUsaPreCus  *)
          (*********************************************************************LA*)
          If strOpcPreTin = 'VE1' Then
            fltPrvTin := fatVenda.fltPreVe1

          Else If strOpcPreTin = 'VE2' Then
            fltPrvTin := fatVenda.fltPreVe2

          Else If strOpcPreTin = 'VE3' Then
            fltPrvTin := fatVenda.fltPreVe3

          Else If strOpcPreTin = 'VE4' Then
            fltPrvTin := fatVenda.fltPreVe4

          Else If strOpcPreTin = 'VE5' Then
            fltPrvTin := fatVenda.fltPreVe5

          Else If strOpcPreTin = 'VE6' Then
            fltPrvTin := fatVenda.fltPreVe6

          Else If strOpcPreTin = 'VE7' Then
            fltPrvTin := fatVenda.fltPreVe7

          Else If strOpcPreTin = 'MED' Then
            fltPrvTin := fatVenda.fltPreMed

          Else If strOpcPreTin = 'SIC' Then
            fltPrvTin := fatVenda.fltPreMed

          Else If strOpcPreTin = 'ULT' Then
            fltPrvTin := fatVenda.fltPreUlt

          Else If strOpcPreTin = 'IMP' Then
            fltPrvTin := fatVenda.fltImpUlt

          Else If strOpcPreTin = 'VEP' Then
            fltPrvTin := fatVenda.fltProPreVen

          Else If strOpcPreTin = 'CUP' Then
            fltPrvTin := fatVenda.fltProPreCus

          Else If strOpcPreTin = 'CSD' Then
            fltPrvTin := fCalculaCustoReal(IIF(fatVenda.strPromoc.Equals('S') And (fatVenda.fltProPreCus <> 0), fatVenda.fltProPreCus, fatVenda.fltPreCus),
                                           fatVenda.fltIcmSai,
                                           fatVenda.fltImpFed,
                                           0,
                                           fatVenda.fltOutVal)

          Else
            fltPrvTin := fatVenda.fltPreCus;

          If fatVenda.fltFat_TE > 0 Then
          Begin
            If (fatVenda.strPromoc <> 'S') Then
              fltPrvTin := fltPrvTin * fatVenda.fltFat_TE;
          End
          Else If fatVenda.fltFatTE2 > 0 Then
          Begin
            If (fatVenda.strPromoc <> 'S') Then
              fltPrvTin := fltPrvTin * fatVenda.fltFatTE2;
          End;

          fltPreVen := fltPrvTin;

          If (fCfgSis('CLIDES') = 'S') And
             (fCfgSis('DCVBVL') = 'L') Then
          Begin
            fltPreVen := fFormataFloat(fltPreVen * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
          End;

          fatVenda.fltTaxJur := 0.00;

          If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
          Begin
            fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem);
            fltPreVen := fltPreVen + fFormataFloat(fltPreVen * (fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem) / 100.0), 04);
          End;

          fatVenda.pCalculaValorRT(fltPreVen, fatVenda.FVal_RT);

          edtUnitar.Text := FloatToStrF(fltPreVen, ffFixed, 12, fatVenda.VS_intDecUni);

          If (fltPrvTin > 0) Then
          Begin
            fatVenda.fltUniOri := fltPreVen; //Com Juros
            fatVenda.fltUniVis := fltPrvTin; //Sem Juros
          End;
        End;

        {********************************************************************}
        {* RETORNA SE ALGUM PRODUTO DA FORMULACAO DA TINTA ESTA EM PROMOCAO *}
        {* SE TIVER NAO PODERÁ SER APLICADO O DESC. MAX POR LINHA/GRUPO     *}
        {****************************************************************AC**}
        pDefineTintaEmPromocao;

        If (fatVenda.strCAbDes = 'S') And
           (fCfgSis('CNDVEN') = 'I') And
           (fatVenda.strStatus <> 'C') And
           ((fatVenda.strPromoc <> 'S') Or
            (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
           (Not fAplicarTaxaJurosPrecoDigitado) Then
        Begin
          {********************************************************************}
          {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
          {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
          {****************************************************************MM**}
          fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

          If fCfgSis('DESCND',varBoolean) Then
          Begin
            If (fatVenda.strDstCnd = 'S') Then
            Begin
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
              edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
            End
            Else
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

          End

          Else If (fatVenda.strCodFpg = '007') Then
          Begin
            If (fatVenda.strAbDeCc = 'S') Then
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni) -
                  fatVenda.fRetornaVrDesconto(2, fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni), fltDesMax));
          End
          Else
            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
              fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni) -
                fatVenda.fRetornaVrDesconto(2, fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni), fltDesMax));
        End;

      End;
    End;

  Finally
    {**********************************************************}
    {* DEVE VOLTAR A EMPRESA LOGADA NOVAMENTE NA DLL DA TINTA *}
    {*  >>> ATENCAO: NAO REMOVER ESTA FUNCAO DO FINNALY <<<   *}
    {******************************************************JC**}
    pSetaEmpresaLogadaTinta(VS_strCodEmp);
    FreeAndNil(stlItensTraMl);
    FreeAndNil(dicRetorno);
  End;

  pAtualizaUnitarioLiquido;
end;

