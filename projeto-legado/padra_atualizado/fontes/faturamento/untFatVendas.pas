procedure TfrmFatVendas.pVerificaComboVigenteGeral(pgbStatus: TcxProgressBar = Nil);
Var
  cdsVenTmp: TUniClientDataSet;
begin

  If (Pos(strOpcDoc, 'OR_PD_VN_') <= 0) Then
    Exit;

  pInformacao('Verificando vigência produtos combo, Aguarde...', pgbStatus);

  Try
    cdsVenTmp := TUniClientDataSet.Create(Self);
    pCloneDataSet(cdsVenTmp, cdsVenda);
    cdsVenTmp.Open;

    With cdsVenTmp Do
    Begin
      First;

      While Not Eof Do
      Begin
        pProgresso(RecNo, RecordCount, pgbStatus);

        If fTemComboVigenteParaProdutoAtivacao(cdsVenTmp) Or
           cdsVenTmp.FieldByName('ITE_ATIVAC').AsString.Equals('S') Then
          If (cdsVenda.Locate('AUTOINCREM', FieldByName('AUTOINCREM').AsString, [])) Then
            pAdicionaProdutosComboVenda(True, True);

        Next;
      End;
    End;

  Except
    On E: Exception Do
      pMensagensErro(e.Message, '[TfrmFatVendas.pVerificaComboVigenteGeral]');
  End;

  FreeAndNil(cdsVenTmp);

end;

procedure TfrmFatVendas.pAlinharTotaisImpostos;
  Const
    INT_ESPACO_ENTRE_GRUPOS = 6;
    INT_ESPACO_TITULO_VALOR = 4;
  Var
    intDireita: Integer;
    intVisiveis: Integer;

  procedure pPosicionarGrupo(const lblTitulo: TLabel; const edtValor: TEditFocus);
  begin
    If Not edtValor.Visible Then
      Exit;
    Inc(intVisiveis);
    Case intVisiveis Of
      1: edtValor.Left := edtTotIpi.Left;
      2: edtValor.Left := edtTotSer.Left;
    Else
      edtValor.Left := intDireita - edtValor.Width;
    End;
    intDireita := edtValor.Left - INT_ESPACO_ENTRE_GRUPOS;
    If lblTitulo.Visible Then
    Begin
      lblTitulo.Left := edtValor.Left - INT_ESPACO_TITULO_VALOR - lblTitulo.Width;
      intDireita     := lblTitulo.Left - INT_ESPACO_ENTRE_GRUPOS;
    End;
  end;

begin
  intVisiveis := 0;
  intDireita := edtTotIpi.Left;
  pPosicionarGrupo(lblTotIS,  edtTotIS);
  pPosicionarGrupo(lblTotIBS, edtTotIBS);
  pPosicionarGrupo(lblTotCBS, edtTotCBS);
  pPosicionarGrupo(lblSohIPI, edtSohIPI);
  pPosicionarGrupo(lblSohFCP, edtSohFCP);
  pPosicionarGrupo(lblSohST,  edtSohST);
end;

procedure TfrmFatVendas.pPosicionaColunaAntes(const strColuna, strReferencia: String);
  Var
    colMover: TColumn;
    colRef: TColumn;
begin
  colMover := fFindColumnByName(dbgItens, strColuna);
  colRef   := fFindColumnByName(dbgItens, strReferencia);
  If (colMover = Nil) Or (colRef = Nil) Or (colMover = colRef) Then
    Exit;
  If (colMover.Index > colRef.Index) Then
    colMover.Index := colRef.Index
  Else
    colMover.Index := colRef.Index - 1;
end;

