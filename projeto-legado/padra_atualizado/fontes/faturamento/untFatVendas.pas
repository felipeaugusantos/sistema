procedure TfrmFatVendas.pProcessaCalculoFlex;
begin
  Try
    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      pAddCalcFlex;
      cdsVenda.Next;
    End;
  Finally
  End;
end;

procedure TfrmFatVendas.pAddCalcFlex;
  Var
    blnItemEmbalagemFechada: Boolean;
begin
  If (Not fEmptyStr(edtSenVen.Text)) And
     (pnlFlexVend.Visible) And
     (fCfgSis('EXFLVN', varString) = 'S') And
     (VS_strTRVEPR = '1') And
     (fatVenda.fGeraFlexOpe) And
     (fUsaFlex(cdsVenda.FieldByName('ITE_CODITE').AsString)) And
     ((cdsVenda.FieldByName('ITE_PROMOC').AsString = 'N') Or ((cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') And (fCfgSis('PROFLE', varString) = 'S'))) Then
  Begin
    blnItemEmbalagemFechada := fEhEmbalagemFechadaItem(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_TABPRE').AsString, cdsVenda.FieldByName('ITE_QTDITE').AsFloat);

    If (Not blnItemEmbalagemFechada) Or ((blnItemEmbalagemFechada) And (fCfgSis('EMFFLE', varBoolean))) Then
      fatVenda.fAddCalcFlex(cdsVenda.FieldByName('AUTOINCREM').AsString,
                            cdsVenda.FieldByName('ITE_CODITE').AsString,
                            cdsVenda.FieldByName('ITE_TOTITE').AsFloat,
                            cdsVenda.FieldByName('ITE_DESESP').AsFloat,
                            cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                            cdsVenda.FieldByName('ITE_UNIORI').AsFloat,
                            cdsVenda.FieldByName('ITE_DESMAX').AsFloat);

    pExibeInformacoesFlex;
  End;
end;

