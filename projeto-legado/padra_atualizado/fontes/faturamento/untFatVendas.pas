function TfrmFatVendas.fVerificaFlexNegativo: Boolean;
var
  intIndMatriz: Integer;
  arrMatrizesFechamento: TMatrizesFechamento;

  procedure pAddMatrizFechamento(const matriz: TMatrizFechamento);
  begin
    If Length(matriz) > 0 Then
    Begin
      SetLength(arrMatrizesFechamento, Length(arrMatrizesFechamento) + 1);
      arrMatrizesFechamento[Length(arrMatrizesFechamento) - 1] := matriz;
    End;
  end;
begin
  Result := True;

  if (fCfgSis('TRAREM') = '1') then
    Exit;

  If (Not fatVenda.fEhNecessarioValidarFlexNegativo) Then
    Exit;

  if fatVenda.fHaveraDesmembramentoVenda(fatVenda.arrMatItens) then
  begin
    With TDesmembrarMatrizItens.Create(fatVenda.arrMatItens, fatVenda.FRecSer,
      fatVenda.fEntregaImediataPorGrupoProdutos, fatVenda.fEntregaImediataPorDataDeEntrega,
      fatVenda.fEntregaImediataPorDataDeEntregaComRotaPorPedido,
      False, fatVenda.blnDesmembraPedRegEsp, EmptyStr, fatVenda.fDesmembrarPorCFG_ITEDOC) Do
    Begin
      blnVerificaDesmembramentoLimiteExcedidoLivro := fatVenda.fPermiteDesmembramentoLimiteExcedidoLivro;
      pDesmembrarMatrizItens;
      SetLength(arrMatrizesFechamento, 0);

      For intIndMatriz := 0 To Length(MatrizesItens) -1 Do
        pAddMatrizFechamento(MatrizesItens[intIndMatriz]);

      Result := fatvenda.fVerificaFlexNegativo(arrMatrizesFechamento);
      Destroy;
    End;
  end
  else
    Result := fatvenda.fVerificaFlexNegativo;
end;

