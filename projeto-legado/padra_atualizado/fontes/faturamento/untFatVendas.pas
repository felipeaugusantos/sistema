{******************************************}
{* VERIFICA SE CLIENTE JA LEVOU O NRO DE  *}
{* BRINDES CONFORME NRO LIMITE CADASTRADO *}
{* E DATA PROMOCIONAL...                  *}
{***************************************IV*}
function TfrmFatVendas.fConfereLimiteBrinde: Boolean;
  Var
    fltQtdItens : Double;
    strSQL : String;
    qryAux : TUniQuery;
    cdsDados: TUniClientDataSet;
Begin
  Result := True;
  qryAux := fCriaQuery(Self);
  cdsDados := TUniClientDataSet.Create(Self);
  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;

  Try
    pCriarformularios(TfrmFatMostraProdLimBrindes, frmFatMostraProdLimBrindes);

    Try
      pCarregaItensBrinde;
      
      With cdsDados do
      Begin

        First;
        While Not Eof do
        Begin
          cdsIteBrindes.Filtered := False;
          cdsIteBrindes.Filter   := 'CODITE = ' + FieldByName('ITE_CODITE').AsString;
          cdsIteBrindes.Filtered := True;

          strSQL := '';
          strSQL := strSQL + ' SELECT SQL_NO_CACHE ';
          strSQL := strSQL + '    ITE_MAXBRI       ';
          strSQL := strSQL + ' FROM      ';
          strSQL := strSQL + '    CADITE ';
          strSQL := strSQL + ' WHERE     ';
          strSQL := strSQL + '    ITE_CODITE = :CODITE ';

          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQL.Add(strSQL);
          qryAux.ParamByName('CODITE').AsString := FieldByName('ITE_CODITE').AsString;
          qryAux.Open;

          fltQtdItens := cdsIteBrindes.FieldByName('QTDITE').AsFloat + FieldByName('ITE_QTDITE').AsFloat;

          If ( fltQtdItens > qryAux.FieldByName('ITE_MAXBRI').AsFloat ) Then
          Begin
            frmFatMostraProdLimBrindes.cdsItens.Insert;
            frmFatMostraProdLimBrindes.cdsItensCODITE.AsString := FieldByName('ITE_CODITE').AsString;
            frmFatMostraProdLimBrindes.cdsItensDESCRI.AsString := FieldByName('ITE_DESITE').AsString;
            frmFatMostraProdLimBrindes.cdsItensQTDITE.Value := fltQtdItens;
            frmFatMostraProdLimBrindes.cdsItensMAXBRI.Value := qryAux.FieldByName('ITE_MAXBRI').AsFloat;
            frmFatMostraProdLimBrindes.cdsItens.Post;
          End;

          Next;
        End;

        If frmFatMostraProdLimBrindes.cdsItens.RecordCount > 0 Then
        Begin
          frmFatMostraProdLimBrindes.showModal;
          Result := False;
        End;
      End;

    Except

      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fConfereLimiteBrinde]');
      End;

    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[pMostraProdLimBrindes]');
    End;
  End;

  FreeAndNil(cdsDados);
  pFreeAndNil(frmFatMostraProdLimBrindes);

End;

