end;

function TfrmFatVendas.fPermiteDevolucaoProdutoComCashback(const strNumDoc, strEspDoc,
  strCodEmp, strCodIte, strDesIte: String; const fltQteIte: Double): Boolean;
var
  objControle : TControleCashback;
  strDocUti   : String;
begin
  objControle := TControleCashback.Create;
  Try
    If (Not objControle.fPermiteUtilizarRotinaCashback) Then
      Exit(True);

    Result := Not objControle.fExisteCashbackUtilizadoDaVenda(strNumDoc,
                                strEspDoc, strCodEmp, strDocUti);

    If Not Result Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Produto........: ' + strCodIte + ' - ' +  LeftStr(strDesIte,50));
      objLiberacao.objMsgLibera.pAddTexto('Qtde Venda.....: ' + FormatFloat(edtQtdIte.EditFormat, fltQteIte));
      objLiberacao.objMsgLibera.pAddTexto('Documento Venda: ' + strNumDoc+'-'+strEspDoc+'-'+strCodEmp);

      objLiberacao.strDirAce  := 'DIRLIBDEVPROCSH';
      objLiberacao.strSenLib  := EmptyStr;
      objLiberacao.strMsgSen  := 'Liberar devolução de produto que gerou Cashback e o mesmo já foi utilizado';
      objLiberacao.strCodOpe  := fatVenda.strCodVen;
      objLiberacao.strCodDig  := fatVenda.strCodDig;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
    End;
  Finally
    FreeAndNil(objControle);
  End;
end;

function TfrmFatVendas.fImportarPlanilhaDeFormaAutomatica : Boolean;
  Var
    blnImportouComSucesso : Boolean;
    LInputImporta : TInputImporta;
begin
  Result := False;
  If (fCfgSis('UIPFAT', varString) = 'N') Then
    Exit;
  LInputImporta := fGetInputImportaCdsVenda;
  Result := True;
  blnImportouComSucesso :=
    fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
                   Var
                     objImportaCdsVenda : TImportaCdsVenda;
                   begin
                     objImportaCdsVenda := TImportaCdsVenda.Create(fGetInputImportaCdsVenda,
                                                                   fatVenda.fPegaPrecoVenda,
                                                                   fatVenda.fUniDigDescontada,
                                                                   fatVenda.fCalculaPrecosLote,
                                                                   fatVenda.fEmpresaParaFaturamentoUsaWMS);
                     Try
                       pgbProgresso.Visible := True;
                       objImportaCdsVenda.Importar(ObjInterfaceImportaPlanilha.LinhasImportadas, cdsVenda, pgbProgresso);
                       pInformacao('Aguarde, Carregando dados do produto para Fechamento...', pgbProgresso);
                       pPreencheMatrizFechamento;
                       pInformacao('Aguarde, Calculando valor dos produtos...', pgbProgresso);
                       pCalculaTotGer;
                       pInformacao('Aguarde, Atualizando produtos ...', pgbProgresso);
                       fatVenda.pAtualizaTemporariaItens(cdsVenda, False, False, True);
                       pAtualizarEditsTotais;
                       pInformacao('Aguarde, verificando valor mínimo documento...', pgbProgresso);
                       Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotGer, fatVenda.fltTotGer, fatVenda.intPrzMed, '', True, True, pgbProgresso);
                     Finally
                       pgbProgresso.Visible := False;
                       FreeAndNil(objImportaCdsVenda);
                     End;
                   end, 'Aguarde, Importando...', '');

  If (Not blnImportouComSucesso) Then
  Begin
    fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
    begin
      Result := True;
      pRemoveItensAdicionadosPelaImportacao(LInputImporta.SequenciaAutoincrem);
      pInformacao('Aguarde, Carregando dados do produto para Fechamento...', pgbProgresso);
      pPreencheMatrizFechamento;
      pInformacao('Aguarde, Calculando valor dos produtos...', pgbProgresso);
      pCalculaTotGer;
      pInformacao('Aguarde, Atualizando produtos ...', pgbProgresso);
      fatVenda.pAtualizaTemporariaItens(cdsVenda, False, False, True);
      pAtualizarEditsTotais;
    end, 'Aguarde, Cancelando Importação...', '');
  End;
end;

function TfrmFatVendas.fGetInputImportaCdsVenda : TInputImporta;
begin
  FillChar(Result, SizeOf(Result), #0);
  Result.CodigoCliente := edtCodCli.Text;
  Result.CodigoEmpresa := VS_strCodEmp;
  Result.TabelaPreco := fatVenda.strTabPre;
  If fEmptyStr(Result.TabelaPreco) Then
    Result.TabelaPreco := '1';
  Result.SequenciaAutoincrem := fatVenda.fGetMaxAutIncClient(cdsVenda);
  Result.TurnoDeEntrega := fatVenda.objTurno.fGetTurno(EmptyStr);
  Result.CodigoVendedor := IIF(fEmptyStr(fatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), fatVenda.strCodVen);
  If fEmptyStr(Result.CodigoVendedor) Then
    Result.CodigoVendedor := strLoginUsuarioLogado;
  Result.NomeVendedor := fRetNomeOperador(Result.CodigoVendedor);
  Result.CodigoVendedor2 := fatVenda.strCodVe2;
  If (edtCodCnd.Visible) Then
  Begin
    Result.CodigoCondicao := edtCodCnd.Text;
    Result.PrazoDePagamento := fFloatToInt(fCalcMediaPagto(mskCndPag.Text));
    Result.CondicaoPagamento := mskCndPag.Text;
  End;
end;

