procedure TfrmFatVendas.pAddItemSemPromocaoProValorMinTotProdutos(const strCodIte: String);
var
  intRecNo: Integer;
  strFilter: String;
  blnFiltered: Boolean;
  blnDisabled: Boolean;
  prcScroll: TprcScroll;
  strCodPro: String;
Begin
  blnDisabled := False;

  Try

    If (Not cdsVenda.IsEmpty) Then
    Begin
      strFilter := cdsVenda.Filter;
      blnFiltered := cdsVenda.Filtered;
      intRecNo := cdsVenda.RecNo;

      If (Not cdsVenda.ControlsDisabled) Then
      Begin
        blnDisabled := True;
        pDisableControls(cdsVenda, prcScroll);
      End;

      strCodPro := objPromVlrMinTotalProdutos.fGetCodPro(strCodIte);

      If Not fEmptyStr(strCodPro) Then
        Exit;

      Try
        cdsVenda.Filtered := False;
        cdsVenda.Filter   := 'ITE_PROMOC = ' + QuotedStr('N');
        cdsVenda.Filtered := True;

        cdsVenda.First;
        While Not cdsVenda.Eof Do
        Begin
          If cdsVenda.FieldByName('ITE_CODITE').AsString = strCodIte Then
          Begin
            objPromVlrMinTotalProdutos.faddOrUpdateItem(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                        cdsVenda.FieldByName('ITE_CODUNI').AsString,
                                                        '',
                                                        cdsVenda.FieldByName('ITE_ITETIN').AsString,
                                                        cdsVenda.FieldByName('ITE_TOTITE').AsFloat,
                                                        0);
          End;

          cdsVenda.Next;
        End;

      Finally
        cdsVenda.Filtered := False;
        cdsVenda.Filter   := strFilter;
        cdsVenda.Filtered := blnFiltered;
        cdsVenda.RecNo    := intRecNo;

        If (blnDisabled) Then
          pEnableControls(cdsVenda, prcScroll, True);
      End;
    End;

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message,'');
    End;
  End;
End;

function TfrmFatVendas.fRecalculaItensPromocaoValorMinimoTotal(strCodIte,
  strCodigoUnidadeMedida: String; blnDel: Boolean; strRshDel, strRshAut: String): Boolean;
Var
  blnDisabled : Boolean;
  strFilter : String;
  blnFiltered : Boolean;
  fltVlrTotIte : Double;
  intRecNo : Integer;
  prcScroll: TprcScroll;
  intCnt : Integer;
  strCodPro: String;
  blnRecalcular: Boolean;
  blnAtvPro: Boolean;
  strRshTinAux: String;
begin

  blnDisabled := False;
  blnFiltered := cdsVenda.Filtered;
  strFilter := cdsVenda.Filter;
  intRecNo := cdsVenda.RecNo;

  strRshTinAux := IIF(fEmptyStr(cdsVenda.FieldByName('ITE_ITETIN').AsString), 'NOR', cdsVenda.FieldByName('ITE_ITETIN').AsString);

  blnAtvPro := False;
  blnRecalcular := False;

  If Not (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Exit(False);

  If (Not cdsVenda.ControlsDisabled) Then
  Begin
    blnDisabled := True;
    pDisableControls(cdsVenda, prcScroll);
  End;

  Try
    Try
      strCodPro := objPromVlrMinTotalProdutos.fGetCodPro(strCodIte);

      If (Not fGridVendaVazio)  Then
      Begin

        If Not (blnDel) Then
          pAddItemSemPromocaoProValorMinTotProdutos(strCodIte);

        If (Not objPromVlrMinTotalProdutos.fPossuiItensPromocaoVlrMinimo) And (Not blnDel) Then
          Exit(False);

        If Not (blnDel) Then
        Begin
          For intCnt := Low(objPromVlrMinTotalProdutos.ArrItemPro) To High(objPromVlrMinTotalProdutos.ArrItemPro) Do
          Begin
            cdsVenda.Filtered := False;
            cdsVenda.Filter   := 'ITE_CODITE = ' + QuotedStr( objPromVlrMinTotalProdutos.ArrItemPro[intCnt].strCodIte );

            If strRshTinAux <> 'NOR' Then
              cdsVenda.Filter   := cdsVenda.Filter + ' AND ITE_ITETIN = ' + QuotedStr( strRshTinAux );

            cdsVenda.Filtered := True;

            fltVlrTotIte := 0;

            If (Not cdsVenda.IsEmpty) Then
            Begin
              cdsVenda.First;
              While Not cdsVenda.Eof Do
              Begin
                fltVlrTotIte := fltVlrTotIte + cdsVenda.FieldByName('ITE_TOTITE').AsFloat;

                cdsVenda.Next;
              End;

              blnRecalcular := (blnRecalcular) Or (Not (SameValue(fltVlrTotIte,
                                                        objPromVlrMinTotalProdutos.ArrItemPro[intCnt].fltVlrIte)));

              If cdsVenda.FieldByName('ITE_ITETIN').AsString <> 'NOR' Then
                objPromVlrMinTotalProdutos.faddOrUpdateItem(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                            cdsVenda.FieldByName('ITE_CODUNI').AsString,
                                                            strCodPro,
                                                            cdsVenda.FieldByName('ITE_ITETIN').AsString,
                                                            fltVlrTotIte,
                                                            0,
                                                            0,
                                                            False,
                                                            0);
            End;

            blnAtvPro := objPromVlrMinTotalProdutos.fAtivaPromocao(strCodPro, strCodIte, strCodigoUnidadeMedida);
          End;

          blnRecalcular := (blnRecalcular or blnAtvPro) or (fEmptyStr(strCodPro) And (objPromVlrMinTotalProdutos.fPossuiItensPromocaoVlrMinimo));
        End;

      End;

      If blnDel Then
        objPromVlrMinTotalProdutos.pDelItem(strCodIte, strCodigoUnidadeMedida, strRshDel);

      Result := blnDel or blnRecalcular;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message,'');
      End;
    End;

  Finally
    cdsVenda.Filter := strFilter;
    cdsVenda.Filtered := blnFiltered;
    cdsVenda.RecNo := intRecNo;

    If (blnDisabled) Then
      pEnableControls(cdsVenda, prcScroll, True);
  End;
end;

function TfrmFatVendas.fGetCampoFocus: TWinControl;
  Var
    intIdx,
    intMenorPnl,
    intMenorCmp: Integer;
begin
  Result := nil;

  If Length(arrCampo) > 0 Then
  Begin
    intMenorPnl := arrCampo[0].intTabOrdPnl;
    intMenorCmp := arrCampo[0].objCampo.TabOrder;

    For intIdx := Low(arrCampo) To High(arrCampo) Do
    Begin
      If arrCampo[intIdx].intTabOrdPnl <= intMenorPnl Then
      Begin
        If arrCampo[intIdx].objCampo.TabOrder <= intMenorCmp Then
          Result := arrCampo[intIdx].objCampo;
      End;
    End;
  End;

end;

function TfrmFatVendas.fValidaUnitarioFinalDaVenda(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    objValDoc : TValidarPedido;
    objLiberacao : TLiberacao;
begin
  Result := True;

  If Pos(fatVenda.strOpcDoc, 'CF_CI_CT_') > 0 Then
    Exit;

  If (VS_strTRVEPR = '2') And (fCfgSis('TRVMKP') = 'F') Then
    Exit;

  If (Not btnAdicionar.Visible) Then
    Exit;

  If (Not btnAdicionar.Enabled) Then
    Exit;

  If Assigned(frmFechamentoVenda) Then
    pInformacao('Aguarde, Validando Valor Unitário dos Produtos...', frmFechamentoVenda.pgbStatus);

  NotificarFechamentoVendaObservers;

  btnCancelaItem.Click;
  objValDoc := TValidarPedido.Create(fatVenda);
  objLiberacao := TLiberacao.Create;
  Try
    objValDoc.onProgresso := pProgressoValidaUnitario;
    objValDoc.blnPedirSenha := False;
    objValDoc.blnValidarUnitarioIndividual := False;

    {********************************************************************************************}
    {* CASO FOR PERFIL DE CONDIÇÃO DE PAGAMENTO, É EDIÇÃO DE UM DOCUMENTO JÁ INSERIDO ***********}
    {* OU TROCOU-SE A CONDIÇÃO DE PAGAMENTO, E CFG_TRVMKP = 'I', VERIFICAR A MARGEM ITEM A ITEM *}
    {*****************************************************************************************KM*}
    if (fCfgSis('TRVMKP') = 'I') And
     (fatVenda.fUsaPerfilECadCnd) And
     (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) And
     ((not fEmptyStr(fatVenda.strNumOrc)) Or (fatVenda.blnTrocouCndPagtoIni)) And
     (fCfgSis('CNDVEN') = 'I') then
    Begin
      objValDoc.onIgnorarCondicao := Nil;
      Result := objValDoc.fValidaUnitMargemCndPagto;
      If Result And fatVenda.blnTrocouCndPagtoIni Then
        fatVenda.blnTrocouCndPagtoIni := False;
    End;

    If Result Then
    Begin
      objValDoc.onIgnorarCondicao := fIgnorarCondicaoUnitario;
      objValDoc.blnExecMontaMsgInterna := False;
      Result := objValDoc.fValidaUnitario;

      If (Not Result) Then
      Begin
        objLiberacao.Clear;
        fatVenda.pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);
        if not(objValDoc.objMsgMenMin.isEmpty) then
        Begin
          objLiberacao.objMsgLibera.fGetObjectFromJson(objValDoc.objMsgMenMin.fGetJsonObject.ToJson);
          objLiberacao.strDirAce := 'PRMIN4';
          objLiberacao.strSenLib := fCfgSis('SENLBD');
          objLiberacao.strMsgSen := 'Trava de Preço';
          objLiberacao.blnMosMen := True;
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
          objLiberacao.tipCliFor := IIF(fatVenda.strOpcDoc = 'OF', cfFornecedor, cfCliente);

          objLiberacao.blnNivel2 := fatVenda.recInfoTravaUnitario.blnNvl2;
          objLiberacao.strDirAceNv2 := 'PRMIN';

          objLiberacao.blnNivel3 := fatVenda.recInfoTravaUnitario.blnNvl3;
          objLiberacao.strDirAceNv3 := 'PRMIN5';

          objLiberacao.blnNivel4 := fatVenda.recInfoTravaUnitario.blnNvl4;
          objLiberacao.strDirAceNv4 := 'PRMIN2';
          objLiberacao.strSenLibNv4 := fCfgSis('SENLN2');

          objLiberacao.blnNivel5 := fatVenda.recInfoTravaUnitario.blnNvl5;
          objLiberacao.strDirAceNv5 := 'PRMIN6';
          objLiberacao.strSenLibNv5 := fCfgSis('SENLN2');

          objLiberacao.blnNivel6 := fatVenda.recInfoTravaUnitario.blnNvl6;
          objLiberacao.strDirAceNv6 := 'PRMIN3';
          objLiberacao.strSenLibNv6 := fCfgSis('SENLN3');

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

          if not Result  then
            Exit(False);
        End;

        objLiberacao.Clear;
        fatVenda.pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);
        if not(objValDoc.objMsgMenCus.isEmpty) then
        Begin
          objLiberacao.objMsgLibera.fGetObjectFromJson(objValDoc.objMsgMenCus.fGetJsonObject.ToJson);
          objLiberacao.strDirAce := 'VECUS';
          objLiberacao.strMsgSen := 'Liberacao de Venda abaixo do preço de custo';
          objLiberacao.blnMosMen := True;
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
          objLiberacao.tipCliFor := IIF(fatVenda.strOpcDoc = 'OF', cfFornecedor, cfCliente);

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

          if not Result then
            Exit(False);
        End;

        If Result And ((Not fatVenda.blnLiberacaoRemotaNoFinalVenda) Or (Not fatVenda.blnEhTravaItemAItemFinalVenda)) Then
          pAtualizaLiberacaoUnitario(objValDoc.stlIteMen);
      End;
    End;
  Finally
    FreeAndNil(objValDoc);
    FreeAndNil(objLiberacao);
  End;
end;

