function TfrmFatVendas.fConfirmaVenda(pgbStatus: TcxProgressBar = nil): Boolean;
begin
  Try
    If Assigned(FVariaveisFechamentoVenda) Then
      FreeAndNil(FVariaveisFechamentoVenda);
    
    FVariaveisFechamentoVenda := TVariaveisFechamentoVenda.Create;

    pIniciarVariaveisFechamentoVenda();

    Result := fIniciaFechamentoVenda() And
              fPedeDadosFechamentoVenda() And
              fRealizaFechamentoVenda();

    If not Result Then
    Begin
      If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) Then
        pHabilitaChkVendaPresencial;

      If fatVenda.EhClienteDifalComEntregaDentroDoEstado Then
        fatVenda.pLimparEnderecoEntrega;

      If (fCfgSis('ALTCOM', varBoolean)) Then
      Begin
        fatVenda.strCodDiv := EmptyStr;

        If Assigned(fatVenda.cdsProfiss) And (fatVenda.cdsProfiss.Active) Then
          fatVenda.cdsProfiss.EmptyDataSet;
      End;

      If (fatVenda.fBloqueiaTrocaDeEnderecoParaPrecoDeVendaComDifal) And
         (fatVenda.opeAlterouUFEntrega = opAbortarOperacao) Then
      Begin
        fatVenda.opeAlterouUFEntrega := opeNull;
        fConfirmaVenda(pgbStatus);
      End;
    End;

  Finally
    pSetFocus(Self);
    If Assigned(FVariaveisFechamentoVenda.qryGenDiv) Then
      FreeAndNil(FVariaveisFechamentoVenda.qryGenDiv);
  End;
end;

function TfrmFatVendas.fIniciaFechamentoVenda(): Boolean;
begin
  Result := True;

  Try

    If Not fValidacoesIniciais() Then
      Exit(False);

    If Not fPermiteCarregarOrcamentoOutraLojaComItemEspecial() Then
      Exit(False);

    If fEstaDigitandoOuAlterandoUmProduto() Then
      Exit(False);

    If Not fCalculaFreteDespesasDescontosNaConfirmacaoPedidos() Then
      Exit(False);

    If Not fSalvaUnitarioDigitado() Then
      Exit(False);

    If Not fPreencheMatrizFechamento() Then
      Exit(False);

    If Not fatVenda.fInformaNumerosDeSerieDevolucao Then
      Exit(False);

    If Not fSolicitarEnderecoEntregaQuandoAtendeRegraFiscal() Then
      Exit(False);

    If Not fatVenda.fValidaCoerenciaEntreOItemOriginalEOItemDevolvido Then
      Exit(False);

    If Not fSetaVariaveisFechamentoVendaAposPreencherMatrizItens() Then
      Exit(False);

    If Not fVerificaHorarioProgramacaoDeProducao() Then
      Exit(False);

    If Not fatVenda.fVerificaPesoItensRateioFrete() Then
      Exit(False);

    If Not fVerificaLimiteItensNFe() Then
      Exit(False);

    If Not fIniciarPercentualDescontoVenda() Then
      Exit(False);

    If Not fAtualizaEditsTotaisVendaInicioFechamento() Then
      Exit(False);

    If Not fValidaClassificacaoFiscalDevolucao() Then
      Exit(False);

    If Not fValidaEmpresaProducaoTinta() Then
      Exit(False);

    If Not fPermitirContinuarVendaSemInformarProdutos() Then
      Exit(False);

    If Not fIniciarValorDescontoEspecial() Then
      Exit(False);

    If Not fCalcularImpostosAplicadosNoDescontoEspecial() Then
      Exit(False);

    If Not fDefineSeMostraTelaDescontoNaVenda() Then
      Exit(False);

    If Not fCarregarValoresParaConfirmacaoDocumentos() Then
      Exit(False);

    If Not fCalcularDescontoEspecialDevolucaoFornecedor() Then
      Exit(False);

    If Not fSolicitarEmpresasParaAbastecimento() Then
      Exit(False);

    If Not fInformarValorDescontosGeraisVenda() Then
      Exit(False);

    If Not fValidarValorPedidoMenorQueTotalJaRecebido() Then
      Exit(False);

    If Not fValidarValorMinimoVendaPrazoParcelaMinimaCartao() Then
      Exit(False);

    If Not fAtualizaEditsTotaisVenda() Then
      Exit(False);

  Finally
    If (Not Result) Then
      If Not fatVenda.fExecutandoNovoFechamentoOrcamentoPedido() Then
        pAbortarEmissaoVenda();
  End;

end;

function TfrmFatVendas.fIniciarPercentualDescontoVenda: Boolean;
begin
  Result := True;
  //Quando nao exibir a tela do desconto especial ainda assim precisa
  //o desconto do profissinal nos produtos.
  If (Pos(strOpcDoc,'PD_OR_VN_') > 0) And (Not blnFechamentoComDesconto) Then
  Begin
    If strCliAntDes <> edtCodCli.Text then
    Begin
      fatVenda.fltPorDes    := 0;
      fatVenda.fltPorDesTmp := 0;
    End;

    If (fAplicarDescProfissionalNoDesEsp) And
       (fatVenda.fltDescProfissional > 0) Then
    Begin
      fatVenda.fltPorDes := fatVenda.fltDescProfissional;
    End
    Else If (Not fEmptyStr(strNumOrc)) And (fatVenda.fltPorDesTmp > 0) Then
    Begin
      fatVenda.fltPorDes := fatVenda.fltPorDesTmp;
    End;
  End;
end;

function TfrmFatVendas.fIniciarValorDescontoEspecial: Boolean;
var
  strNumDocLocal,
  strEspDocLocal : String;
begin
  Result := True;
  Screen.Cursor := crHourGlass;

  fatVenda.fltDesComercialZFM := 0;

  {*****************************************}
  {* PEGA DESCONTO ESPECIAL QUANDO ESTIVER *}
  {* CONFIRMANDO OU ALTERANDO PEDIDO OU    *}
  {* ORCAMENTO                             *}
  {**************************************MV*}
  If (Not fEmptyStr(strNumOrc)) Or (fatVenda.blnHerancaOrcamentoPedido And (Not blnHerancaOrcamentoPedidoZerandoDesconto)) Then
  Begin
    If (fatVenda.fPermiteDescontoComercialEmOperacaoZonaFrancaComDescontoDeIcms) Then
    Begin
      fatVenda.fltDesEsp := qryFatGor.FieldByName('FGO_DECZFM').AsFloat;
      fatVenda.fltDesComercialZFM := qryFatGor.FieldByName('FGO_DECZFM').AsFloat;
    End
    Else
      fatVenda.fltDesEsp := qryFatGor.FieldByName('FGO_DESESP').AsFloat;
  End;

  If Pos(strOpcDoc,'CO_MF_') > 0 Then
    fatVenda.fltDesEsp := fatVenda.fGetDesEspOri;

  If (fatVenda.blnAbriuF4) And (Not ('CF_CI_CT_CP_OV_').Contains(strOpcDoc)) Then
    fatVenda.fltDesEsp := fatVenda.fltDesEspF4;

  If (fatVenda.fZerarDesEsp) Then
    fatVenda.fltDesEsp := 0.0;

  if (fatVenda.blnHerancaOrcamentoPedido) then
    fatVenda.fltPorDes := qryFatGor.FieldByName('FGO_PORDES').AsFloat;

  If (Pos(strOpcDoc,'PD_OR_VN_') > 0) And (fatVenda.blnCliFil) Then
  Begin
    fatVenda.fltDesEsp := 0.0;
    fatVenda.fltPorDes := 0.0;
  End;

  fatVenda.objControleCashback.pLimparObjeto;

  strNumDocLocal := fatVenda.strNumOrc;
  strEspDocLocal := fatVenda.strEspOrc;

  If (strEspDocLocal = 'OR') And (fatVenda.strEspDoc = 'PD') Then
  Begin
    strNumDocLocal := EmptyStr;
    strEspDocLocal := fatVenda.strEspDoc;
  End
  Else If fEmptyStr(fatVenda.strNumOrc) Then
  Begin
    strNumDocLocal := fatVenda.strNumDoc;
    strEspDocLocal := fatVenda.strEspDoc;
  End;

  If fEmptyStr(strEspDocLocal) Then
    strEspDocLocal := fatVenda.strOpcDoc;

  fatVenda.objControleCashback.strNumDoc := strNumDocLocal;
  fatVenda.objControleCashback.strEspDoc := strEspDocLocal;
  fatVenda.objControleCashback.strCodEmp := VS_strCodEmp;
  fatVenda.objControleCashback.strCodCli := edtCodCli.Text;

  fatVenda.fltDesEsp := fatVenda.fltDesEsp
                      - fatVenda.objControleCashback.fValorDescontoCashbackDocumento;
end;

