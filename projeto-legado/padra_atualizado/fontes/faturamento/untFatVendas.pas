function TfrmFatVendas.fMenuAlteraPegPedItem(pgbStatus: TcxProgressBar = Nil): Boolean;
Var
  oleItensBackup: OleVariant;
  strFilterBackup: String;
  blnFilterBackup: Boolean;
  intAutIncBackup: Integer;
begin
  fatVenda.cdsVendaBackup := nil;
  Try
    oleItensBackup  := cdsVenda.Data;
    strFilterBackup := cdsVenda.Filter;
    blnFilterBackup := cdsVenda.Filtered;
    intAutIncBackup := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

    fatVenda.cdsVendaBackup := TUniClientDataSet.Create(nil);
    fatVenda.cdsVendaBackup.Data := cdsVenda.Data;

    Result := fAtualizaPegPedItems(pgbStatus);

    If Not Result Then
    Begin
      cdsVenda.Data       := oleItensBackup;
      cdsVenda.LogChanges := False;
      cdsVenda.Filter     := strFilterBackup;
      cdsVenda.Filtered   := blnFilterBackup;

      fatVenda.pFormataDecimaisGrid(nil);
    End;
    cdsVenda.Locate('AUTOINCREM', intAutIncBackup, []);

    pSetFocus(dbgItens);
    pAtualizaDados(Nil);
  Finally
    If Assigned(fatVenda.cdsVendaBackup) Then
    Begin
      if fatVenda.cdsVendaBackup.Active Then
        fatVenda.cdsVendaBackup.Close;
      FreeAndNil(fatVenda.cdsVendaBackup);
    End;
  End;
end;

function TfrmFatVendas.fAtualizaPegPedItems(pgbStatus: TcxProgressBar): Boolean;
var
  frmSelecionaPegPedItem: TfrmSelecionaPegPedItem;
begin
  Result := False;

  pCriarFormularios(TfrmSelecionaPegPedItem, frmSelecionaPegPedItem);
  Try
    Try
      frmSelecionaPegPedItem.Caption := 'Selecione a opção para os Itens (Geral)';
      frmSelecionaPegPedItem.ObjFatVenda := Self.fatVenda;
      frmSelecionaPegPedItem.ShowModal;
      Result := (frmSelecionaPegPedItem.ModalResult = mrOk);
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '');
    End;
  Finally
    pFreeAndNil(frmSelecionaPegPedItem);
  End;

end;

procedure TfrmFatVendas.pVerificaTamanhoPnlCliente;
const
  TAM_LINHA = 23;
var
  blnCompleto: Boolean;
begin
  blnCompleto := (edtMargem.Visible) Or
                (edtDesPro.Visible) Or
                (edtOprFlj.Visible) Or
                (cbbComInd.Visible) Or
                (cbbUsoConsRev.Visible) Or
                (pnlCampanha.Visible) Or
                (edtTotCre.Visible);

  If blnCompleto <> FpnlClienteCompleto Then
  Begin
    FpnlClienteCompleto := blnCompleto;
    If blnCompleto Then
    Begin
      pnlCliente.Height := pnlCliente.Height + TAM_LINHA;
      pnlCabecalho.Height := pnlCabecalho.Height + TAM_LINHA;
    End
    Else
    Begin
      pnlCliente.Height := pnlCliente.Height - TAM_LINHA;
      pnlCabecalho.Height := pnlCabecalho.Height - TAM_LINHA;
    End;
  End;

End;

