        objLiberacao.strMsgSen := 'Senha para diminuir o percentual de sugestão de beneficiamento';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;
        objLiberacao.intAutInc := intAutInc;
        objLiberacao.strCodIte := edtCodIte.Text;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
        objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

        if (not fatVenda.fFatMensagemLiberacao(objLiberacao)) then
        begin
          fMensagem('','Senha incorreta!',['&OK']);
          edtPerBen.Text := FormatFloat('#,##0.00', fCfgSis('PERBEN', varDouble));
        end;
      end;
