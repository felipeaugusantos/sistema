function TfrmFatVendas.fAtualizaEditsTotaisVenda(): Boolean;
begin
  Result := True;

  If (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) And (Not blnFechamentoComDesconto Or (fCfgSis('CNDVEN') = 'F')) And
     ((fatVenda.fltPorDes > 0.0) Or (fatVenda.fltDesEsp > 0.0))  Then
    pCalculaTotais(True);

  {*****************************************}
  {* CALCULA PESO BRUTO / LÍQUDO           *}
  {**************************************MV*}
  if not (fPermiteInformarPesoNoPedidoDeVenda And (fatVenda.strEspDoc = 'PD')) then
    fatVenda.pCalculaPesBruLiq;

  //Por seguranca vamos manter esta calculatotger
  //Nao remover sem falar com Joao C/Ronaldo/Zanon
  pCalculaTotGer(False, True, True, MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA);

  pAtualizarEditsTotais;
end;

function  TfrmFatVendas.fAtualizaEmpresaItems(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    strEmpSel: String;
begin
  Result := True;
  strEmpSel := '';

  If mnuAltEmpItens.Visible or fatVenda.blnAbastecimentoDeposito or fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo Then
    strEmpSel := fRetornaEmpresaItens;

  If (Not fEmptyStr(strEmpSel)) and fatVenda.blnAbastecimentoDeposito then
    fatVenda.strEmpresaAbastecimentoDeposito := strEmpSel
  Else If (Not fEmptyStr(strEmpSel)) and fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo then
