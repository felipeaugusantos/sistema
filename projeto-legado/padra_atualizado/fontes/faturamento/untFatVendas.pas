function TfrmFatVendas.fPodeExcluirItemRequsicaoCompra(strCodIte: String;
  fltQtdDel: Double): Boolean;
var
  strSQL: String;
  qryAux: TUniQuery;
  fltQtdTot: Double;

  function fQtdTotItem(strCodIte: String): Double;
  var
    intRecNo: Integer;
  Begin
    With cdsVenda Do
    Begin
      intRecNo := RecNo;
      DisableControls;
      Try
        First;
        Result := 0;
        While Not Eof Do
        Begin
          If FieldByName('ITE_CODITE').AsString = strCodIte Then
            Result := Result + FieldByName('ITE_QTDITE').AsFloat;

          Next;
        End;
      Finally
        RecNo := intRecNo;
        EnableControls;
      End;
    End;
  End;

begin
  Result := True;

  if fatVenda.blnReqAut then
    Exit;

  strSQL := '';
  strSQL := strSQL + ' SELECT                              ';
  strSQL := strSQL + '   RCD_CODIGO,                       ';
  strSQL := strSQL + '   GROUP_CONCAT(                     ';
  strSQL := strSQL + '     COT_NUMCOT                      ';
  strSQL := strSQL + '   ) AS COTACOES,                    ';
  strSQL := strSQL + '   GROUP_CONCAT(                     ';
  strSQL := strSQL + '     CONCAT(                         ';
  strSQL := strSQL + '       PCD_NUMPED,                   ';
  strSQL := strSQL + '       "-",                          ';
  strSQL := strSQL + '       PCD_ESPDOC,                   ';
  strSQL := strSQL + '       "-",                          ';
  strSQL := strSQL + '       PCD_CODEMP                    ';
  strSQL := strSQL + '     )                               ';
  strSQL := strSQL + '   ) AS PEDIDOS,                     ';
  strSQL := strSQL + '   SUM(RCD_QTDITE) AS RCD_QTDITE     ';
  strSQL := strSQL + ' FROM                                ';
  strSQL := strSQL + '   MOVRCD                            ';
  strSQL := strSQL + ' LEFT JOIN PCMDET                    ';
  strSQL := strSQL + '   ON PCMDET.AUTOINCREM = RCD_SEQPCD ';
  strSQL := strSQL + ' LEFT JOIN COTITE                    ';
  strSQL := strSQL + '   ON COTITE.AUTOINCREM = RCD_SEQCOT ';
  strSQL := strSQL + ' LEFT JOIN COTGER                    ';
  strSQL := strSQL + '   ON COTGER.AUTOINCREM = COT_SEQGER ';
  strSQL := strSQL + ' WHERE RCD_CODITE = :CODITE          ';
  strSQL := strSQL + '   AND RCD_CODIGO = :CODIGO          ';
  strSQL := strSQL + '   AND (                             ';
  strSQL := strSQL + '     (RCD_SEQPCD IS NOT NULL)        ';
  strSQL := strSQL + '     OR (RCD_SEQCOT IS NOT NULL)     ';
  strSQL := strSQL + '   )                                 ';

  qryAux := fCriaQuery();
  Try
    With qryAux Do
    Begin
      SQL.Text := strSQL;
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODIGO').AsString := fCampoTabela('RCG_CODIGO', 'MOVRCG', ['AUTOINCREM'], [fatVenda.strInRqCp]);
      Open;

      If FieldByName('RCD_QTDITE').IsNull Then
        Exit;

      fltQtdTot := fQtdTotItem(strCodIte);

      if fltQtdTot - fltQtdDel >= FieldByName('RCD_QTDITE').AsFloat Then
        Exit;

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Exclusão/Alteração de um item de um pedido de venda com requisição de compra');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTextoCaption('Item:', strCodIte + '-' + fRetNomProduto(strCodIte));
      objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade total do item no pedido'                                 , FloatToStrF(fltQtdTot, ffFixed, 12, fCfgSis('DECQTD', varInteger))                         , 70, alDireita, teAmbos, '', 10);
      objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade sendo retirada do pedido'                                , FloatToStrF(fltQtdDel, ffFixed, 12, fCfgSis('DECQTD', varInteger))                         , 70, alDireita, teAmbos, '', 10);
      objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade restante no pedido'                                      , FloatToStrF(fltQtdTot - fltQtdDel, ffFixed, 12, fCfgSis('DECQTD', varInteger))             , 70, alDireita, teAmbos, '', 10);
      objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade total que não pode ser excluída da requisição de compra' , FloatToStrF(FieldByName('RCD_QTDITE').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)) , 70, alDireita, teAmbos, '', 10);
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTextoCaption('Número da requisição de compra: ',  FieldByName('RCD_CODIGO').AsString);

      If Not FieldByName('COTACOES').IsNull Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Cotações vinculadas à requisição', FieldByName('COTACOES').AsString);
      If Not FieldByName('PEDIDOS').IsNull Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Pedidos de compra vinculados à requisição', FieldByName('PEDIDOS').AsString);

      objLiberacao.strDirAce := 'EXCITEREQCOM';
      objLiberacao.strMsgSen := 'Exclusão/Alteração de um item de um pedido de venda com requisição de compra';
      objLiberacao.strCodOpe := IIF(fEmptyStr(FatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;


      If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Begin
        Result := False;
      End;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

