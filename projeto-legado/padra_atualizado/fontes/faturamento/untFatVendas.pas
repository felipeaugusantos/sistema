end;

function TfrmFatVendas.fPedeEspecieDocumentoParaFechamento(blnVerificaTipoFaturamentoConformePerfil: Boolean=True): Boolean;
Var
  intContador: Integer;
  frmFatTipoFaturamento : TfrmFatTipoFaturamento;
begin
  Result := True;

  If ((Pos(strOpcDoc, 'VN_CF_CP_BR_UC_CS_TE_EM_') > 0) And ((fatVenda.fltTotGer > 0.0) Or
     (fCfgSis('USASER', varBoolean)))) Or
     ((Pos(strOpcDoc, 'DV_') > 0) And (Length(fRetEspeciesDevAD) > 2)) Then
  Begin

    If fatVenda.blnConfirmandoNotaFiscalConcreto And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) And (intSavPosAtual > -1) Then
    Begin
      FVariaveisFechamentoVenda.intPosAtual := intSavPosAtual; //Nota Fiscal/Servico
    End
    Else
    Begin
      if (fatVenda.fRecebidoPorPix) and (intSavPosAtual > -1) then
      begin
        FVariaveisFechamentoVenda.intPosAtual := intSavPosAtual;
      end
      else
      begin

        Try
          pCriarFormularios(TfrmFatTipoFaturamento, frmFatTipoFaturamento);

          frmFatTipoFaturamento.blnVerificaTipoFaturamentoConformePerfil := blnVerificaTipoFaturamentoConformePerfil;
          frmFatTipoFaturamento.strOpcDoc := strOpcDoc;
          frmFatTipoFaturamento.fatVenda  := fatVenda;
          frmFatTipoFaturamento.strConPag := fatVenda.strConPag;
          frmFatTipoFaturamento.arrOpcoes := FVariaveisFechamentoVenda.arrOpcoes;
          If (fTrocouClienteDoPedidoNoVendaNormal) Then
            frmFatTipoFaturamento.strEspecieSugestao := Self.strEspOrc;
          frmFatTipoFaturamento.ShowModal;

          Result := frmFatTipoFaturamento.blnConfirma;

          FVariaveisFechamentoVenda.intPosAtual := 0;
          If Result Then
          Begin
            FVariaveisFechamentoVenda.intPosAtual    := frmFatTipoFaturamento.intPosAtual;
            intSavPosAtual := frmFatTipoFaturamento.intPosAtual;

            fatVenda.blnCupEsp := SameText(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strOpcLet,'I');
          End;

        Except
          On E: Exception Do
          Begin
            Result := False;
            pMensagensErro(E.Message, '[fConfirmaVenda_3]');
          End;
        End;

        pFreeAndNil(frmFatTipoFaturamento);
      end ;
    End;

    If blnJaAvisouAltPD And
       SameText(strOpcDoc, 'VN') And
       SameText(strEspOrc, 'PD') And
       SameText(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'PD') And
       Not fValidaSePedidoOriundoOSPodeSerAlterado(strNumOrc, strEspOrc, strEmpOrc) Then
    Begin
      Result := False;
      Exit;
    End;

    If Result And
       (SameText(strOpcDoc, 'VN')) And
       (Pos(strEspOrc, 'PD_OR_') > 0) And
       (Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'PD_OR_') > 0) And
       (Not fTravaAlteracaoPedidoOrcamentoComPREPTE(strNumOrc, strEspOrc, strEmpOrc)) Then
    Begin
      Result := False;
      Exit;
    End;

    {*************************************************************************}
    {* SE FOR CARREGADO UM PEDIDO PARCIALMENTE FATURADO PELA VENDA NORMAL E  *}
    {* O MESMO FOR FECHADO COMO UM PEDIDO, NESTE CASO ABORTA A OPERAÇÃO PARA *}
    {* O USUÁRIO NAO REALIZAR ALTERAÇÕES NO PEDIDO. SÓ PODERÁ FECHAR COMO    *}
    {* DOCUMENTO DE VENDA.                                                   *}
    {***********************************************************************FC}
    If SameText(strOpcDoc, 'VN') And
       SameText(strEspOrc, 'PD') And
       SameText(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'PD') And
       fDocParcialmenteFat(strNumOrc, strEspOrc, strEmpOrc) Then
    Begin
      fMensagem('', 'Esse documento não pode ser gravado como Pedido, pois o mesmo é um Pedido parcialmente faturado!', ['&Ok']);
      Result := False;
      Exit;
    End;

    {******************************************}
    {* TRAVA CONFIRMACAO DE DOC. (IF) QUANDO  *}
    {* HOUVER FRETE                           *}
    {***************************************JB*}
    If (SameText(strOpcDoc, 'CF'))               And
       (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'IF') And
       (Not fatVenda.fPermiteFreteNoCupomFiscal) And
       (fExisteFrete)                            Then
    Begin
      fMensagem('', 'Esses documentos não podem ser confirmados em Cupom Fiscal (IF) porque ha documentos com frete!', ['&Ok']);
      Result := False;
      Exit;
    End;

    If (Pos(strOpcDoc, 'VN_CF_CP_') > 0) And
       (Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'FF_IF_') > 0 ) And
       (Not fatVenda.fValidarTipoFaturamentoRetencoes) Then
    Begin
      Result := False;
      Exit;
    End;

    If Result Then
    Begin

      {*************************************************}
      {* TRAVA DE DEVOLUÇÃO QUE FAZ REFERÊNCIA         *}
      {* A SOMENTE UMA NF, MEDIANTE CONFIG. CFG_DVUMNF *}
      {**********************************************MM*}
      If (SameText(strOpcDoc, 'DV'))               And
         (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'NF') And
         (fCfgSis('DVUMNF',varBoolean))            Then
      Begin
        If Not fSelecionouUmaNF Then
        Begin
          fMensagem('ATENÇÃO!','É permitida somente devolução referente a uma Nota Fiscal!', ['&Ok']);
          Result := False;
          Exit;
        End;
      End;

      If (fatVenda.blnMeiaNota) Then
      Begin
        If Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'NF_' + IIF(fCfgSis('PAFECF', varBoolean), 'OR_', 'IF_IV_')) <= 0 Then
        Begin
          fMensagem('', 'Meia nota só pode ser confirmada em Nota Fiscal ou ' + IIF(fCfgSis('PAFECF', varBoolean), 'Orçamento', 'Cupom Fiscal') + '!', ['&OK']);
          Result := False;
        End;
      End
      Else
      Begin

        {******************************************}
        {* VERIFICA O VALOR MINIMO P\ EMITIR A NF *}
        {***************************************JB*}
        If (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'NF') And (Not fatVenda.fVerificaValorMinimoEmitirNF) Then
        Begin
          Result := False;
        End;

        If (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'PI') And (fStatusCndPag(mskCndPag.Text) = A_PRAZO) Then
        Begin
          fMensagem('', 'Pigmento deve ser A Vista!', ['&O k']);
          Result := False;
        End;

        If (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'NE') Then
        Begin
          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Liberação de Nota Especial');

          objLiberacao.strDirAce := 'NOESP';
          objLiberacao.strSenLib := fCfgSis('SENNES');
          objLiberacao.strMsgSen := 'Nota Especial';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
            Result := False;
        End;

        If (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc = 'IF') Then
        Begin

          If fatVenda.blnCupEsp Then
          Begin
            objLiberacao.Clear;
            objLiberacao.objMsgLibera.pAddTexto('Liberação de Cupom Fiscal Especial');

            objLiberacao.strDirAce := 'CFESP';
            objLiberacao.strSenLib := fCfgSis('SENCFE');
            objLiberacao.strMsgSen := 'Cupom Fiscal Especial';
            objLiberacao.strCodOpe := fatVenda.strCodVen;
            objLiberacao.strCodDig := fatVenda.strCodDig;
            objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
            objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

            If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
              Result := False;
          End;

        End;

        If (Pos(strOpcDoc, 'VN_CS_ER_') > 0) And (FVariaveisFechamentoVenda.blnTraOrc) And (fatVenda.strEntFut <> 'S') Then
        Begin
          If Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'PD_OR_') > 0 Then
            Result := fatVenda.fVerificaEstoqueItens(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc)
          Else
          Begin
            Result := False;
            fMensagem('', 'Há produtos sem estoque, portanto só é permitido fazer Orçamento!', ['&Ok']);
          End;
        End;

      End;

    End;

    If (Result) And (Pos(strOpcDoc, 'VN_TE_') > 0) And
       (Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'PD_OR_') <= 0 ) And
       (fCfgSis('NUMSER', VarString) = 'S') Then
    Begin
      Result := fVerificarControleDeSerie;
      If Not Result Then
        fMensagem('', 'Existem produtos com controle por série, mas sem a devida série informada!', ['&Ok']);
    End;

    If (Result) And (Pos(strOpcDoc, 'VN_TE_') > 0) And
       (Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'OR_') <= 0 ) And
       (fCfgSis('OINSPP', VarString) = 'S') And
       (fCfgSis('NUMSER', VarString) = 'S') Then
    Begin
      Result := fVerificarControleDeSerie;
      If Not Result Then
        fMensagem('', 'Existem produtos com controle por série, mas sem a devida série informada!', ['&Ok']);
    End;

    If (Result) And
       (MatchStr(strOpcDoc, ['CP','CF','CO'])) And
       (fatVenda.strTipOpe = 'C') And
       (fatVenda.qryTemporariaConfirmacao.RecordCount > 0) Then
    Begin
      If fEhDocumentoContaOrdemComRemessa(
           fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString,
           fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString) Then
      Begin
        If Not fValidaTipoDocumentoRemessaEmitida(
                 fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString,
                 fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString,
                 fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString,
                 (FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc)) Then
        Begin
          Result := False;
        End;
      End;
    End;
  End
  Else
  Begin
    If (Pos(strOpcDoc, 'PD_') > 0) And
       (fCfgSis('OINSPP', VarString) = 'S') And
       (fCfgSis('NUMSER', VarString) = 'S') Then
    Begin
      Result := fVerificarControleDeSerie;
      If Not Result Then
        fMensagem('', 'Existem produtos com controle por série, mas sem a devida série informada!', ['&Ok']);
    End;

    If (strOpcDoc <> 'OR') And (strOpcDoc <> 'PD') And (FVariaveisFechamentoVenda.blnTraOrc) Then
    Begin
      fMensagem('', 'Há produtos sem estoque, portanto só é permitido fazer Orçamento!', ['&Ok']);
      Result := False;
    End;

    {*****************************************}
    {* SELECIONA A ESPECIE DE ACORDO COM A   *}
    {* OPCAO DE FATURAMENTO ESCOLHIDA        *}
    {**************************************MV*}
    If (strOpcDoc = 'EP') Then
      FVariaveisFechamentoVenda.strEspecie := 'EP'

    {*******************************************}
    {* SE FOR 'CF' E TOTAL DA NOTA <= 0, GRAVA *}
    {* COMO 'FF'                               *}
    {***22/04/2008***************************MV*}
    Else If (strOpcDoc = 'CF') Then
      FVariaveisFechamentoVenda.strEspecie := 'FF'

    Else If (strOpcDoc = 'OR') Then
      FVariaveisFechamentoVenda.strEspecie := 'OR'

    Else If (strOpcDoc = 'PD') Then
      FVariaveisFechamentoVenda.strEspecie := 'PD'

    Else If (strOpcDoc = 'BR') Then
      FVariaveisFechamentoVenda.strEspecie := 'BR'

    Else If (strOpcDoc = 'UC') Then
      FVariaveisFechamentoVenda.strEspecie := 'UC'

    Else If Pos(strOpcDoc, 'OU_OV_OF_') > 0 Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If Pos(strOpcDoc, 'OE_EF_') > 0 Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'NC') Then
    Begin
      If (blnSatComplementar Or blnNFCeComplementar) Then
        FVariaveisFechamentoVenda.strEspecie := 'IF'
      Else
        FVariaveisFechamentoVenda.strEspecie := 'NF';
    End

    Else If (strOpcDoc = 'IF') Then
      FVariaveisFechamentoVenda.strEspecie := 'IF'

    Else If (strOpcDoc = 'TE') Then
      FVariaveisFechamentoVenda.strEspecie := 'TE'

    Else If (strOpcDoc = 'TR') Then
      FVariaveisFechamentoVenda.strEspecie := 'TR'

    Else If (strOpcDoc = 'DV') Then
    Begin
      If (fatVenda.blnDevNota) Or (Pos(fRetEspeciesDevAD, 'NF_IF_') > 0) Then
        FVariaveisFechamentoVenda.strEspecie := 'NF'
      Else
        FVariaveisFechamentoVenda.strEspecie := 'DV';
    End
    Else If (strOpcDoc = 'DD') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'PI') Then
      FVariaveisFechamentoVenda.strEspecie := 'PI'

    Else If (strOpcDoc = 'CI') Then
    Begin
      If fatVenda.blnConfTransFF Then
        FVariaveisFechamentoVenda.strEspecie := 'FF'
      Else
        FVariaveisFechamentoVenda.strEspecie := 'NF';
    End

    Else If (strOpcDoc = 'CN') Then
    Begin
      FVariaveisFechamentoVenda.strEspecie := 'NS';
    End

    Else If (strOpcDoc = 'CT') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'NP') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'NE') Then
      FVariaveisFechamentoVenda.strEspecie := 'NE'

    Else If (strOpcDoc = 'CE') Then
      FVariaveisFechamentoVenda.strEspecie := 'IF'

    Else If (strOpcDoc = 'CO') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'MF') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'VS') Then
      FVariaveisFechamentoVenda.strEspecie := 'NS'

    Else If (strOpcDoc = 'PR') Then
      FVariaveisFechamentoVenda.strEspecie := 'PR'

    Else If (strOpcDoc = 'PA') Then
      FVariaveisFechamentoVenda.strEspecie := 'PA'

    Else If (strOpcDoc = 'EM') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'ER') Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else If (strOpcDoc = 'VN') And
            (Not fPermiteEmissaoEspecie('FF')) And
            (fPermiteEmissaoEspecie('NF')) Then
      FVariaveisFechamentoVenda.strEspecie := 'NF'

    Else
      FVariaveisFechamentoVenda.strEspecie := 'FF';

    If (fatVenda.blnConfirmandoNotaFiscalConcreto) and (FVariaveisFechamentoVenda.strEspecie = 'NF') And (Not MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL])) Then
    Begin
      FVariaveisFechamentoVenda.strEspecie := 'NS';
    End;

    FVariaveisFechamentoVenda.blnAchou := False;

    FVariaveisFechamentoVenda.intPosAtual := -1;
    For intContador := 0 To Length(FVariaveisFechamentoVenda.arrOpcoes)-1 Do
    Begin

      If FVariaveisFechamentoVenda.arrOpcoes[intContador].strEspDoc = FVariaveisFechamentoVenda.strEspecie Then
      Begin
        If (strOpcDoc = 'CE') Then
        Begin
          fatVenda.blnCupEsp := SameText(FVariaveisFechamentoVenda.arrOpcoes[intContador].strOpcLet,'I');
          FVariaveisFechamentoVenda.blnAchou := fatVenda.blnCupEsp;
        End
        Else
          FVariaveisFechamentoVenda.blnAchou := True;

        If FVariaveisFechamentoVenda.blnAchou Then
        Begin
          FVariaveisFechamentoVenda.intPosAtual := intContador;
          Break;
        End;
      End;

    End;

    If (Not FVariaveisFechamentoVenda.blnAchou) Then
    Begin
      fMensagem('ATENÇÃO!', 'A opção de ' + FVariaveisFechamentoVenda.strEspecie + ' não foi encontrada na matriz de opções!', ['&O k']);
      Result := False;
      Exit;
    End;

  End;

end;

