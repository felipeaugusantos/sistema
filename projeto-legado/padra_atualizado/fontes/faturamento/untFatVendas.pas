End;

function TfrmFatVendas.fValidarEmissaoPedidoEOrcamento(): Boolean;
Var
  strMensagemDEPS: String;
  LResultVerificaVrMinimo: Boolean;
begin
  {***************************************}
  {* VALIDAÇÂO DE STATUS DO SISTEMA DEPS *}
  {************************************AJ*}
  Result := ((Not blnReanalizarSistemaDEPS) Or (fatVenda.strEspDoc = 'OR')) And
             (TValidacoesSistemaDEPS.fVerificaStatusDoOrcamentoNoSistemaDEPS(fatVenda.strEspDoc, qryFatGor, fatVenda.strCodCnd));
  If Not Result Then
  Begin
    strMensagemDEPS := 'Não será possível gravar o pedido. Necessária a análise e aprovação de crédito DEPS.' + #13 +
                       IIF(((Pos(fatVenda.strEspDoc, 'PD_VN_') > 0) Or (strOpcDoc = 'VN')) And (qryFatGor.FieldByName('FGO_ESPDOC').AsString <> 'OR'),
                             'Favor gravar como Orçamento e, em seguida, aguardar a análise de crédito.',
                             'Status do Orçamento: ' + qryFatGor.FieldByName('FGO_STSDEP').AsString);
    If blnReanalizarSistemaDEPS Then
      strMensagemDEPS := 'Não será possível gravar o pedido, pois o orçamento necessita ser reanalisado pelo sistema DEPS.' + #13 +
                         'Isso ocorre por esse ser um orçamento alterado que já foi enviado para análise do sistema DEPS.' + #13 +
                         'Status atual do Orçamento: ' + qryFatGor.FieldByName('FGO_STSDEP').AsString;

    blnSolicitouFecharOREmPDLocal := False;
    fatVenda.strEspDoc := IIF(fEmptyStr(qryFatGor.FieldByName('FGO_ESPDOC').AsString),
                              fatVenda.strOpcDoc,
                              qryFatGor.FieldByName('FGO_ESPDOC').AsString);

    If fatVenda.strEspDoc = 'OR' Then
      fatVenda.strTipFat := 'Orçamento';

    fMensagem('ATENÇÃO', strMensagemDEPS, ['&OK']);
    Exit;
  End;

  fatVenda.blnEnviaOrcamentoAoDEPS := False;
  If (fatVenda.strEspDoc = 'OR') And
     (TValidacoesSistemaDEPS.fRealizarValidacaoSistemaDEPS(fatVenda.strCodCnd) = 'S') Then
  Begin
    fatVenda.blnEnviaOrcamentoAoDEPS := fMensagem('CONFIRMAÇÃO',
                                                  IIF((Not Assigned(qryFatGor)) Or (qryFatGor.FieldByName('FGO_STSDEP').AsString <> 'APROVADO'),
                                                      'Deseja enviar o orçamento para a análise de crédito no sistema DEPS?',
                                                      'Esse orçamento já foi aprovado anteriormente pelo Sistema DEPS. Deseja reenviar para análise de crédito DEPS?'),
                                                  ['&Sim', '&Não'], 2) = 1;

    If Not fatVenda.blnEnviaOrcamentoAoDEPS Then
      fMensagem('AVISO', 'A análise de crédito no sistema DEPS é obrigatória para geração do Pedido, para essa condição de pagamento. ' + #13 +
                         'O status de envio ao sistema DEPS ficará como "NÃO ENVIADO".', ['&OK']);
  End;

  If fTravarAoIniciarVendaSemOrcamento Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Não é possível concluir a emissão deste(a) '+fCamelCase(fatVenda.strTipFat)+'!');
    objLiberacao.objMsgLibera.pAddTexto('Documentos desta espécie, devem ser originados a partir de um Orçamento.');

    objLiberacao.strDirAce := 'LIBVPO';
    objLiberacao.strSenLib := fCfgSis('SENVPO');
    objLiberacao.strMsgSen := 'Iniciar nova Venda/Pedido sem Orçamento.';
    objLiberacao.strCodOpe := strLoginUsuarioLogado;
    objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

    If not objLiberacao.fLibera  Then
    Begin
      Result := False;
      Exit;
    End;
  End;
  
  If (strOpcDoc = 'OR') And (fatVenda.strEspDoc = 'PD') Then
  Begin
    If (Not fatVenda.fDebitoCliente(fatVenda.strCodFpg, fatVenda.strConPag, 3, fatVenda.strEspDoc)) Then
    Begin
      Result := False;
      Exit;
    End;

    If (Not fSolicitarEmpresasParaAbastecimento) Then
    Begin
      Result := False;
      Exit;
    End;

    If (Not fatVenda.fVerificaPrazoMedio(fatVenda.strConPag, 'PD')) Or
      (Not fatVenda.fVerificaQtdMaxParcelas(fatVenda.strConPag, 'PD')) Then
    Begin
      Result := False;
      Exit;
    End;

    If (VS_strTRVEPR = '2') Or (fatVenda.fltPorDes > 0.0) Or (fatVenda.fltDesEsp > 0.0) Then
    Begin
      fatVenda.blnSolicitouFecharOREmPD := blnSolicitouFecharOREmPDLocal;

      If (Not fEmptyStr(fatVenda.strNumOrc)) And
         (Not FVariaveisFechamentoVenda.blnUsaCndVenFinal) And
         ((fatVenda.fltPorDes > 0.0) Or (fatVenda.fltDesEsp > 0.0)) And
         (Not blnPassouPelaTelaDescontoEConfirmou) Then
      Begin
        FVariaveisFechamentoVenda.fltTotSerAux := fatVenda.fltTotSer;

        fatVenda.fltTotSer := 0.0;
        pCalculaTotGer(False, False);

        fatVenda.fltTotSer := FVariaveisFechamentoVenda.fltTotSerAux;
      End;
                                      { Adicionamos condição "OR" ver Req: 113402 }
      If ((Not fatVenda.blnVlrMin) Or fSomenteAvisaPoisVaiTravarNoFinalVenda('VEMIN')) Then
      Begin
        fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
          begin
            Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0),
                                                 fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0),
                                                 fatVenda.intPrzMed,
                                                 'PD', True, True, pgbProgresso);
            LResultVerificaVrMinimo := Result;
          end, 'Aguarde, Verificando valor mínimo produtos ...', '');

        If Not LResultVerificaVrMinimo Then
        Begin
          Result := False;
          Exit;
        End;
      End;
    End;

    If Not fatVenda.fVerificaConsultaDeCredito(fatVenda.strConPag, fatVenda.strCodFpg, fatVenda.strOpcDoc, fRetCodVenDef(edtSenVen.Text)) Then
    Begin
      Result := False;
      Exit;
    End;

    If Not fatVenda.fVerificaConsultaDadosCobranca(fatVenda.strConPag, fatVenda.strCodFpg, fRetCodVenDef(edtSenVen.Text)) Then
    Begin
      Result := False;
      Exit;
    End;

    If (fCfgSis('CNDVEN', varString) = 'F') Then
    Begin
      pRemoverTravaLogAviAux('LIBSEN');
      pRemoverTravaLogAviAux('INTFAT');
      pRemoverTravaLogAviAux('INTMAR');
      pRemoverTravaLogAviAux('INTPAR');

      If Not fatVenda.fVerificaIntervaloMargemValorCndPagto Then
      Begin
        Result := False;
        Exit;
      End;
    End;

  End;

  If (fValidaTravaDeValorMinimoParaPedidoDeVenda(strOpcDoc)) Or
     (fValidaTravaDeValorMinimoParaVendaFechadaEmPedido(strOpcDoc, fatVenda.strEspDoc)) Then
  Begin
    If ((Not fatVenda.blnVlrMin) Or fSomenteAvisaPoisVaiTravarNoFinalVenda('VEMIN')) Then
    Begin
      fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
        begin
          Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0),
                                               fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0),
                                               fatVenda.intPrzMed,
                                               'PD', True, True, pgbProgresso);
          LResultVerificaVrMinimo := Result;
        end, 'Aguarde, Verificando valor mínimo produtos ...', '');

      If Not LResultVerificaVrMinimo Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    If (fCfgSis('CNDVEN', varString) = 'F') Then
    Begin
      pRemoverTravaLogAviAux('LIBSEN');
      pRemoverTravaLogAviAux('INTFAT');
      pRemoverTravaLogAviAux('INTMAR');
      pRemoverTravaLogAviAux('INTPAR');

      If Not fatVenda.fVerificaIntervaloMargemValorCndPagto Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

  If (Pos(fatVenda.strEspDoc,'OR_') > 0) And (fCfgSis('MOVDAV',varInteger) > 1) And fCfgSis('CONDAV',varBoolean) Then
  Begin

    If fEmptyStr(fatVenda.strCliCgc) Or fClienteConsumidor(fatVenda.strCliNom) Or fEmptyStr(fatVenda.strCliNom) Then
    Begin
      fMensagem('', 'O sistema está configurado para obrigatóriamente informar o CPF/CNPJ e o Nome do cliente! Favor verifique!', ['&OK']);
      Result := False;
      Exit;
    End

  End;

  If (fatVenda.fValidarEstoqueNoFinal) Then
  Begin
    If Not fatVenda.fVerificaEstoqueItens(fatVenda.strEspDoc, '', True, False, True, -1, False, fTravaSubProduto) Then
    Begin
      Result := False;
      Exit;
    End;
  End;

  If (strOpcDoc = 'OR') And (fatVenda.strEspDoc = 'OR') And blnHerancaOrcamentoPedido Then
  Begin
    If Not fatVenda.fVerificaEstoqueItens(fatVenda.strEspDoc, '', True, False, True, -1, False, fTravaSubProduto) Then
    Begin
      Result := False;
      Exit;
    End;
  End;

  If (strOpcDoc = 'PD') And (fatVenda.strEspDoc = 'PD') And blnHerancaOrcamentoPedido Then
  Begin
    If Not fatVenda.fVerificaEstoqueItens(fatVenda.strEspDoc, '', True, False, True, -1, False, fTravaSubProduto) Then
    Begin
      Result := False;
      Exit;
    End;
  End;

  {*******************************************************************}
  {* CASO ESTEJA FAZENDO UM ORÇAMENTO E PEÇA PARA GRAVAR COMO PEDIDO *}
  {* VERIFICA O SALDO DO ESTOQUE                                     *}
  {****************************************************************LU*}
  If (strOpcDoc = 'OR') And (fatVenda.strEspDoc = 'PD') Then
  Begin
    If fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(fatVenda.blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), True) Then
    Begin
      If Not fatVenda.fVerificaNaoCompra(blnTravaNaoCompra, fRetCodVenDef(edtSenVen.Text), 'PD', True, IIF(fCfgSis('CNDVEN') = 'F', fatVenda.fExecutaTravaNaoCompra, True)) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

  If (Not fEmptyStr(fatVenda.strNumOrc))             And
     (Pos(fatVenda.strOpcDoc, 'PD_VN_') > 0)         And
     (fatVenda.strEspDoc = 'PD')                     And
     (qryFatGor.Active)                              And
     (qryFatGor.FieldByName('FGO_ENT_CD').AsString = 'S') Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Alteração de Pedido de entrega pelo CD');

    objLiberacao.strDirAce := 'ALTPCD';
    objLiberacao.strMsgSen := 'Alteração de Pedido Entrega pelo CD';
    objLiberacao.strCodOpe := strLoginUsuarioLogado;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
    objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
    If (Not objLiberacao.fLibera) Then
    Begin
      fMensagem('','Senha incorreta!',['&OK']);
      Result := False;
      Exit;
    End;

  End;

end;

function TfrmFatVendas.fValidaRestricaoVendaProduto(
  const Sender: TObject): Boolean;
var
  objRegrasRestricaoVendaProdutos : TRegrasRestricaoVendaProdutos;
begin
  Try
    objRegrasRestricaoVendaProdutos :=
      TRegrasRestricaoVendaProdutos
        .New
        .EspecieDocumento(fatVenda.strOpcDoc)
        .CodigoCliente(edtCodCli.Text)
        .fAdicionarCodigoProduto(edtCodIte.Text);

    Result := Not objRegrasRestricaoVendaProdutos.fPossuiRestricaoVenda;
