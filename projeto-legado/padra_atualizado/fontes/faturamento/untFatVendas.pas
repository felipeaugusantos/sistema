function TfrmFatVendas.fRetEmpresaAbastecimentoClienteFilial(strCodAba,
  strEspAba, strEmpAba: String): String;
var
  qryAbastecimento: TUniQuery;
begin
  qryAbastecimento := fCriaQuery;

  try
    Result := EmptyStr;

    qryAbastecimento.Close;
    qryAbastecimento.SQL.Clear;
    qryAbastecimento.SQL.Add('SELECT N.GER_CODCLI');
    qryAbastecimento.SQL.Add('FROM NOTGER N');
    qryAbastecimento.SQL.Add('INNER JOIN AUXNOT A');
    qryAbastecimento.SQL.Add('ON(N.AUTOINCREM = A.AUX_SEQGER)');
    qryAbastecimento.SQL.Add('WHERE A.AUX_DOCABA = :DOCABA');
    qryAbastecimento.SQL.Add('AND A.AUX_ESPABA = :ESPABA');
    qryAbastecimento.SQL.Add('AND A.AUX_EMPABA = :EMPABA');

    qryAbastecimento.ParamByName('DOCABA').AsString := strCodAba;
    qryAbastecimento.ParamByName('ESPABA').AsString := strEspAba;
    qryAbastecimento.ParamByName('EMPABA').AsString := strEmpAba;

    qryAbastecimento.Open;

    if qryAbastecimento.IsEmpty then
      Exit;

    Result := fRetCodEmpClienteFilial(qryAbastecimento.FieldByName('GER_CODCLI').AsString);
  finally
    FreeAndNil(qryAbastecimento);
  end;
end;

function TfrmFatVendas.fRetEmpresaItem: String;
begin
  Result := IIF(fatVenda.blnEmpFat, IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text), VS_strCodEmp);
end;

{*****************************************}
{* DIGITA A CONDIÇÃO DE PAGAMENTO        *}
{**************************************MV*}
function TfrmFatVendas.fDigCondicaoPagto(Var strConPag, strCodCnd, strCodFpg: String;
                                         fraDigCndPagamento: TfraDigCndPagamento = nil): Boolean;
  Var
    strFpgAnt     : String;
    strConAnt     : String;
    strCodCndAnt  : String;
    blnZerTax     : Boolean;
    blnExit       : Boolean;
    blnVeriCalcItensForaPromocao : Boolean;
    fltTotGerLiq : Double;
    fltTaxVprAnt : Double;
    blnTaxVprAnt : Boolean;
    blnTeraItensQueSairaoDaPromocao : Boolean;
    blnVerificouValorMinimo: Boolean;
    frmDigCndPagamento : TfrmDigCndPagamento;
    objValDoc : TValidarPedido;
begin
  If (Not fEmptyStr(fatVenda.strNumOrc))      And
     (Not fEmptyStr(Self.strCodigPagAoAbrir)) And
     (Self.strCodigPagAoAbrir <> strCodCnd)   And
     (Not Assigned(fraDigCndPagamento))       And
     (not fatVenda.fRecebidoPorPix)           Then
  Begin
    If Not fEmptyStr(Self.strCodigPagAoAbrir) Then
      strCodCnd := Self.strCodigPagAoAbrir;

    If Not fEmptyStr(Self.strCondiPagAoAbrir) Then
      strConPag := Self.strCondiPagAoAbrir;

    If Not fEmptyStr(Self.strFormaPagAoAbrir) Then
      strCodFpg := Self.strFormaPagAoAbrir;
  End;

  strFpgAnt     := strCodFpg;
  strConAnt     := strConPag;
  strCodCndAnt  := strCodCnd;
  blnZerTax     := False;

  {*****************************************}
  {* CHAMA A TELA DE CONDIÇÃO DE PAGAMENTO *}
  {**************************************MV*}
  Repeat
    If Assigned(fraDigCndPagamento) Then
    Begin
      Result := fVerificarResultadoDigitacaoCondicaoPagamentoFinalVenda(fraDigCndPagamento, strConPag, strCodCnd, strCodFpg, blnZerTax);
    End
    Else
    Begin
      pCriarFormularios(TfrmDigCndPagamento, frmDigCndPagamento);

      Try
        frmDigCndPagamento.Caption := Caption;
        pIniciarDigitacaoCondicaoPagamentoFinalVenda(frmDigCndPagamento.fraDigCndPagamento, strConPag, strCodCnd);

        frmDigCndPagamento.ShowModal;

        Result := fVerificarResultadoDigitacaoCondicaoPagamentoFinalVenda(frmDigCndPagamento.fraDigCndPagamento,
          strConPag, strCodCnd, strCodFpg, blnZerTax);
      Finally
        pFreeAndNil(frmDigCndPagamento);
      End;
    End;

    If (Not Result) Then
      Break;

    fatVenda.pAtualizaInformacoesCondPagamento;

    If fCfgSis('USACND', varBoolean) And (fCfgSis('CNDVEN') = 'F') And (qryConCnd.FieldByName('CND_CODIGO').AsString <> strCodCnd) Then
    Begin
      pPesquisaCadCnd(qryConCnd, qryConCnd, strCodCnd);
    End;

    If Not fTravaCondicaoPagamento(strConPag, strOpcDoc, strOpcDoc) Then
    Begin
      If Assigned(fraDigCndPagamento) Then
      Begin
        Result := False;
        Break;
      End;
      Continue;
    End;

    If Result Then
      fatVenda.blnDeCndF := True;

    {Valida Condição de Pagamento/Destino}
    If Result Then
      If fCfgSis('RETENT',varBoolean) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
      Begin
        If (fCfgSis('CNDVEN') = 'F') And (fCfgSis('USACND') = 'S') And (pnlEntrega.Visible) Then
          If Not fControleRetiraEntregaPorCndPagto(strCodCnd) Then
          Begin
            If Assigned(fraDigCndPagamento) Then
            Begin
              Result := False;
              Break;
            End;

            Continue;
          End;
      End;

    {*******************************************}
    {* NÃO CALCULAR JUROS QUANDO FOR DEVOLUÇÃO *}
    {****************************************PZ*}
    If (Result) And (Not blnZerTax) And (Pos(strOpcDoc, 'DV_PR_') <= 0) Then
    Begin
      fatVenda.pCalculaTaxVpr;
      If fatVenda.fltTaxVpr > 0 Then
      Begin
        fatVenda.blnTaxVpr := True;
        pAtualizaTemporaria;
        pCalculaTotais;
      End;

      blnTeraItensQueSairaoDaPromocao := fVeriCalcItensForaPromocao(False, True, True);
      {*******************************************************************************************}
      {* PARA EVITAR O SEGUINTE PAU REQ.:72122                                                   *}
      {* O CIDADÃO FAZ UM PEDIDO CUJO UM DOS ITENS ESTÁ EM PROMOÇÃO E O OUTRO NÃO.               *}
      {* APÓS DIGITAÇÃO DE UMA CONDIÇÃO DE PAGAMENTO X QUE TEM TAXA DE JUROS E SEU PRAZO MÉDIO   *}
      {* NÃO CONTEMPLE A PROMOÇÃO O ITEM SAIRÁ DA MESMA E VOLTARÁ O VALOR ORIGINAL DENTRO DA     *}
      {* fVeriCalcItensForaPromocao.                                                             *}
      {* A TAXA DE JUROS É APLICADA NAS MARCAÇÕES //1 E //2 DENTRO DA pCalculaTotGer. SÓ QUE CASO*}
      {* ALGUM ITEM SAIA DA PROMOÇÃO POR CONTA DA CONDIÇÃO DIGITADA A pCalculaTotGer É CHAMADA   *}
      {* NOVAMENTE //2. PORÉM A FUNÇÃO fVeriCalcItensForaPromocao SÓ ALTERA E VOLTA OS UNITARS   *}
      {* DOS ITENS QUE SAIRAM DA PROMOÇÃO POR ISTO O OUTRO ITEM TERÁ TAXA DE JUROS APLICADO DUAS *}
      {* VEZES. ENTÃO CASO blnTeraItensQueSairaoDaPromocao = True, DEIXA A APLICAÇÃO DO JUROS    *}
      {* PARA O BLOCO //2. OBS.: O TERCEIRO PARAMENTO DA fVeriCalcItensForaPromocao() FAZ COM QUE*}
      {* A FUNÇÃO SÓ TESTE SE TERÁ ALTERAÇÃO POSTERIOR                                           *}
      {****************************************************************************************VA*}
      If Not blnTeraItensQueSairaoDaPromocao Then
      Begin
        //1
        pCalculaTotGer(False, True, True);
        fatVenda.pAtualizaTemporariaItens(cdsVenda);
        pAtualizarEditsTotais;
      End;
    End;

    Result := fValidaCodFpg(strCodFpg, strConPag, blnExit);

    {*************************************************************************************}
    {* SE FOR DEVOLUÇÃO, UTILIZAR CADASTRO DE CONDIÇÃO DE PAGTO, SUGESTÃO DE CND PARA DV *}
    {* FOR Á VISTA, E O CÓDIGO DA CND Á VISTA ESTIVER EM BRANCO, TRAVA O CARA!           *}
    {**********************************************************************************RN*}
    If (strOpcDoc = 'DV') And (fCfgSis('USACND', varBoolean)) And (fCfgSis('SGCNDV', varString) = '1') And
       (fEmptyStr(fCfgSis('CNDAVI', varString))) And (fEmptyStr(strCodCnd)) Then
    Begin
      Result := False;
      fMensagem('','O sistema esta configurado para sugerir condição á vista, porém a condição á vista '+
                   'que é selecionada a partir da configuração (CFG_CNDAVI) esta vazia!',['&OK']);
    End;

    If Not Result Then
    Begin
      strCodFpg := strFpgAnt;
      strConPag := strConAnt;
      strCodCnd := strCodCndAnt;
      Exit;
    End;

    fltTaxVprAnt := fatVenda.fltTaxVpr;
    blnTaxVprAnt := fatVenda.blnTaxVpr;

    fatVenda.fltTaxVpr := 0;
    fatVenda.blnTaxVpr := False;
    Try
      blnVeriCalcItensForaPromocao := fVeriCalcItensForaPromocao(False, True);
    Finally
      fatVenda.fltTaxVpr := fltTaxVprAnt;
      fatVenda.blnTaxVpr := blnTaxVprAnt;
    End;

    If (blnVeriCalcItensForaPromocao) Then
    Begin
      pAtualizaTemporaria;
      pPreencheMatrizFechamento;
      pCalculaTotais;

      //2 VER COMENTÁRIO ACIMA
      pCalculaTotGer(False, True, True);
      fatVenda.pAtualizaTemporariaItens(cdsVenda);
      pAtualizarEditsTotais;
    End;

    If (fCfgSis('CNDVEN') = 'F') Then
    Begin
      pCalculaTotGer(False, True, True);

      If Not fVerificaValorMinimoAposInformarCondicaoPagamentoNoFinalDaVenda(blnVerificouValorMinimo) Then
      Begin
        If Assigned(fraDigCndPagamento) Then
        Begin
          Result := False;
          Break;
        End;

        fltTotGerLiq := 0;
        If (fatVenda.fltTotPro > 0) Then
          fltTotGerLiq := fatVenda.fltTotPro - fatVenda.fltDesEsp;

        If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (fltTotGerLiq < 0) And (fatVenda.fltDesEsp > 0) Then
        Begin
          Result := False;
          Break;
        End
        Else
        Begin
          Continue;
        End;
      End;

      {*******************************************}
      {* CONFIGURAÇÃO PARA TRAVA DE VALOR MINIMO *}
      {* PARA VENDA A PRAZO                      *}
      {*************************************MV/RV*}
      If (Pos(strOpcDoc,'OU_OV_OF_BR_TE_NC_DV_PR_OE_EF_UC_DD_') <= 0) Then
      Begin
        If (Not fatVenda.fValidaValorMinimoVendaPrazo(strConPag)) Then
        Begin
          If Assigned(fraDigCndPagamento) Then
          Begin
            Result := False;
            Break;
          End;
          Continue;
        End;
      End;
    End;

    If (Result) And (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
      Result := fatVenda.fDebitoCliente(strCodFpg, strConPag, 3);

    If (Result) Then
      Break;

  Until False;

  If Not Result Then
    Exit;

  If Result And ((strConPag <> strConAnt) Or (Not fatVenda.blnVerPrzMed)) Then
    Result := fatVenda.fVerificaPrazoMedio(strConPag);

  If Result And ((strConPag <> strConAnt) Or (Not fatVenda.blnVerMaxPar)) Then
    Result := fatVenda.fVerificaQtdMaxParcelas(strConPag);

  If Not Result Then
  Begin
    strConPag := strConAnt;
    strCodCnd := strCodCndAnt;
    Exit;
  End
  Else
  Begin
    mskCndPag.Text     := strConPag;
    fatVenda.strConPag := strConPag;
    fatVenda.strCodCnd := strCodCnd;
    fatVenda.strCodFpg := strCodFpg;

    strCndAnt := strConPag;
  End;

  Result := fValidaCampos(edtForPag,False);

  {********************************************************************************************}
  {* CASO FOR PERFIL DE CONDIÇÃO DE PAGAMENTO, EDIÇÃO DE UM DOCUMENTO JÁ INSERIDO *************}
  {* OU TROCOU-SE A CONDIÇÃO DE PAGAMENTO, E CFG_TRVMKP = 'I', VERIFICAR A MARGEM ITEM A ITEM *}
  {*****************************************************************************************KM*}
  if Result And
     (fCfgSis('TRVMKP') = 'I') And
     (fatVenda.fUsaPerfilECadCnd) And
     (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) And
     (fCfgSis('CNDVEN') = 'F') then
  Begin
    objValDoc := TValidarPedido.Create(fatVenda);
    Try
      objValDoc.onProgresso := pProgressoValidaUnitario;
      objValDoc.blnPedirSenha := False;
      objValDoc.blnValidarUnitarioIndividual := False;
      Result := objValDoc.fValidaUnitMargemCndPagto;
    Finally
      FreeAndNil(objValDoc);
    End;
  End;

  pCalculaTotGer(False, True, True);;
  pAtualizarEditsTotais;

  If (fatVenda.strCliOrg = 'S') Then
    pCalculaTotais(True);
End;


function TfrmFatVendas.fAtualizarCondicaoPagamentoNovoFechamentoOrcamentoPedido(fraDigCndPagamento: TfraDigCndPagamento; blnValidacoes: Boolean = True): Boolean;
  Var
    strFpgAnt     : String;
    strConAnt     : String;
    strCodCndAnt  : String;
    blnZerTax     : Boolean;
    blnExit       : Boolean;
    blnVeriCalcItensForaPromocao : Boolean;
    blnVerificouValorMinimo: Boolean;

  procedure pNotificar(AMensagem: String);
  begin
    If Assigned(frmFechamentoVenda) Then
    Begin
      pProgresso(0, 0, frmFechamentoVenda.pgbStatus);
      pInformacao(AMensagem, frmFechamentoVenda.pgbStatus);
      NotificarFechamentoVendaObservers;
    End;
  end;

begin
  strFpgAnt     := fatVenda.strCodFpg;
  strConAnt     := fatVenda.strConPag;
  strCodCndAnt  := fatVenda.strCodCnd;

  Result := False;

  blnVerificouValorMinimo := False;

  Try
    blnZerTax := False;

    If Not fVerificarResultadoDigitacaoCondicaoPagamentoFinalVenda(fraDigCndPagamento,
      fatVenda.FConPag, fatVenda.FCodCnd, fatVenda.FCodFpg, blnZerTax) Then
        Exit(False);

    fatVenda.pAtualizaInformacoesCondPagamento;

    If blnValidacoes Then
      If Not fTravaCondicaoPagamento(fatVenda.strConPag, strOpcDoc, strOpcDoc) Then
        Exit(False);

    fatVenda.blnDeCndF := True;

    {Valida Condição de Pagamento/Destino}
    If blnValidacoes Then
      If fCfgSis('RETENT',varBoolean) Then
        If pnlEntrega.Visible And (Not fControleRetiraEntregaPorCndPagto(fatVenda.strCodCnd)) Then
          Exit(False);

    If blnValidacoes Then
      If Not fValidaCodFpg(fatVenda.strCodFpg, fatVenda.strConPag, blnExit) Then
        Exit(False);

    fatVenda.fltTaxVpr := 0;
    fatVenda.blnTaxVpr := False;
    fatVenda.pZeraTaxJurMatrizItens;
    
    blnVeriCalcItensForaPromocao := fVeriCalcItensForaPromocao(False, True);

    If (Not blnZerTax) Then
    Begin
      fatVenda.pCalculaTaxVpr;

      If fatVenda.fltTaxVpr > 0 Then
        fatVenda.blnTaxVpr := True;
    End;

    If Assigned(fraDigCndPagamento) Then
      fraDigCndPagamento.pnlTrocarCondPagamento.Visible := blnPromocaoRetirada;

    If (blnVeriCalcItensForaPromocao) Then
    Begin
      pAtualizaTemporaria;
      pPreencheMatrizFechamento;
      pCalculaTotais;
    End;

    cdsVenda.First;

    If fatVenda.blnTaxVpr Then
      pCalculaTotGer(False, True, True, 'Aguarde, Aplicando taxa de juros da condição de pagamento ...')
    Else
      pCalculaTotGer(False, True, True, 'Aguarde, Atualizando condição de pagamento ...');

    //Necessário executar novamente pCalculaTotGer para correto valor do documento
    //Função precisa ser refatorada para que seja suficiente apenas uma chamada.
    If fatVenda.fHouveAlteracaoRegraTributariaItensAposCalculaTotger() Then
      pCalculaTotGer(False, True, True);

    pNotificar('Aguarde, Atualizando produtos ...');

    fatVenda.pAtualizaTemporariaItens(cdsVenda);
    pAtualizarEditsTotais;

    pNotificar('Aguarde, Verificando valor mínimo produtos ...');

    If blnValidacoes Then
      If Not fVerificaValorMinimoAposInformarCondicaoPagamentoNoFinalDaVenda(blnVerificouValorMinimo) Then
        Exit(False);

    pNotificar('Aguarde, Verificando valor mínimo venda prazo ...');

    If blnValidacoes Then
      If Not fatVenda.fValidaValorMinimoVendaPrazo(fatVenda.strConPag) Then
        Exit(False);

    pNotificar('Aguarde, Verificando débitos do cliente ...');

    If blnValidacoes Then
      If (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
        If Not fatVenda.fDebitoCliente(fatVenda.strCodFpg, fatVenda.strConPag, 3) Then
          Exit(False);

    pNotificar('Aguarde, Verificando prazo médio ...');

    If blnValidacoes Then
      If ((fatVenda.strConPag <> strConAnt) Or (Not fatVenda.blnVerPrzMed)) Then
        If Not fatVenda.fVerificaPrazoMedio(fatVenda.strConPag) Then
          Exit(False);

    pNotificar('Aguarde, Verificando máximo de parcelas ...');

    If blnValidacoes Then
      If ((fatVenda.strConPag <> strConAnt) Or (Not fatVenda.blnVerMaxPar)) Then
        If Not fatVenda.fVerificaQtdMaxParcelas(fatVenda.strConPag) Then
          Exit(False);

    mskCndPag.Text := fatVenda.strConPag;
    Self.strCndAnt := fatVenda.strConPag;

    pNotificar('Aguarde, Atualizando Totais ...');

    If (fatVenda.strCliOrg = 'S') Then
      pCalculaTotais(True);

    pNotificar('Aguarde, Verificando relação produtos x condição de pagamento ...');

    If blnValidacoes Then
      If Not fVerificarProdutosRelacionadosCondicaoPagamento() Then
        Exit(False);

    If blnValidacoes Then
      If Not fValidaCondicaoPagamentoFechamentoVenda() Then
        Exit(False);

    If blnVerificouValorMinimo Then
      Result := True
    Else
      Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotGer,
                                           fatVenda.fltTotGer,
                                           fatVenda.intPrzMed);

  Finally
    pNotificar(MSG_AGUARDE_REALIZANDO_FECHAMENTO_VENDA);

    If Not Result Then
    Begin
      fatVenda.strConPag := strConAnt;
      fatVenda.strCodCnd := strCodCndAnt;
      fatVenda.strCodFpg := strFpgAnt;

      {Para evitar solicitação de senha ao cancelar senha na condição no final}
      If fCfgSis('PRZMED', varBoolean) Then
      Begin
        fatVenda.strConPag := '';
        fatVenda.strCodCnd := '';
        fatVenda.strCodFpg := '';
        blnSenPrazoMedioMaximoVenda := True;
      End;
    End;
  End;

end;

function TfrmFatVendas.fAtualizaVendedorInativoDosItens(venVenRep: TVenRep; var strCodIteVenInat, strCodIteRepInat: String): Boolean;
var
  strVenInat,
  strRepInat: String;
begin
  Result := False;

  if (venVenRep = venVendedor) and (fatVenda.strCodVen = strVenAnt) then
    Exit;

  if (venVenRep = venRepresentante) and (fatVenda.strCodVe2 = strRepAnt) then
    Exit;

  if Pos(strOpcDoc, 'PD_OR_VN_') = 0 then
    Exit;

  if fatVenda.fUsaVendedorDoItemParaComissao(IIF(venVenRep = venVendedor,
                                                 fatVenda.strCodVen,
                                                 fatVenda.strCodVe2)) then
    Exit;

  if fValidaVenRepInat(strVenInat,
                       strRepInat,
                       strCodIteVenInat,
                       strCodIteRepInat) then
    Exit;

  Result := IIF(venVenRep = venVendedor, not fEmptyStr(strCodIteVenInat), not fEmptyStr(strCodIteRepInat));
end;

function TfrmFatVendas.fAvisoClienteForaDoEstado: Boolean;
  Var
    strEstCli: String;
    strEstEmp: String;
begin
  Result := False;

  If Not fCfgSis('AVVFUF', varBoolean) Then
    Exit;

  If Pos(strOpcDoc, 'VN_OR_PD_') <= 0 Then
    Exit;

  strEstCli := fRetUFCliente(edtCodCli.Text);
  strEstEmp := fatVenda.fGetUFEmpresa('');

  If strEstCli = strEstEmp Then
    Exit;

  Result := True;
end;

function TfrmFatVendas.fEstaRemovendoItemDeEstrutura(strItemRomovido, strCodEmp: string): Boolean;
var
  ItemEstrutura : TItemEstru;
begin
  Result := False;
  if ((fCfgSis('VENSUB', varString) = 'N') or (fCfgSis('VENSUB', varString) = 'P')) and (fCfgSis('CAREST', varString) = 'P') then
  begin
    if (Pos(strOpcDoc, 'PD_OR_VN_') > 0) and (not fatVenda.blnCarregandoEstrutura) then
    begin

      ItemEstrutura := fEhOuCompoeEstrutura(strItemRomovido, strCodEmp);
      if (ItemEstrutura.blnEstrutura) and (not ItemEstrutura.blnPrincipal) then
        Result := True;

    end;
  end;

  If ((fCfgSis('TRASUB', varString) <> 'S')) And (fCfgSis('CAREST', varString) = 'P') Then
  Begin
    If (Pos(strOpcDoc, 'TE_') > 0) And (Not fatVenda.blnCarregandoEstrutura) Then
    Begin
      ItemEstrutura := fEhOuCompoeEstrutura(strItemRomovido, strCodEmp);
      If (ItemEstrutura.blnEstrutura) And (Not ItemEstrutura.blnPrincipal) Then
        Result := True;
    End;
  End;
end;

function TfrmFatVendas.fEstaRotinaPedidoRetiraEmpLocalSemWMSEmpCDComWMS: Boolean;
begin
  Result := (Not fUsaRotinaWMS) And (fUsaRotinaWMS(fCfgSis('EMP_CD', varString))) And (Pos(strOpcDoc,'PR_') > 0);
end;

{*****************************************}
{* SALVA UNITARIO ORIGINAL               *}
{**************************************MV*}
function TfrmFatVendas.fSalvaUnitarioDigitado(): Boolean;
  Var
    intContador: Integer;
begin
  Result := True;
  For intContador := 0 To Length(fatVenda.arrMatItens) -1 Do
    fatVenda.arrMatItens[intContador].fltUniTmp := fatVenda.arrMatItens[intContador].fltUniTar;
end;

procedure TfrmFatVendas.pComissaoVendedor;
Begin

  If (blnComVen) Then
  Begin
    If Not fVerificaAcessoSistema('VENCLF') Then
    Begin
      fMensagem('', 'Operador não tem direito de acesso em Vendas por Clientes!', ['&O k']);
      Exit;
    End;

    If Not fVerificaAcessoSistema('COMVF9') Then
    Begin
      fMensagem('', 'Operador não tem direito de acesso a Comissão de Vendedores!', ['&O k']);
      Exit;
    End;

    If InterlockedIncrement(intConfirmando) = 0 Then
    Begin

      Try
        pMostraComissaoVend;
        pSetFocus(ActiveControl);

        InterlockedDecrement(intConfirmando);
      Except
        InterlockedDecrement(intConfirmando);
      End;

    End
    Else
      InterlockedDecrement(intConfirmando);

  End;

End;

procedure TfrmFatVendas.pAlteraComissaoVendedor;
Begin

  If InterlockedIncrement(intConfirmando) = 0 Then
  Begin
    Try
      Try
        pCriarFormularios(TfrmFatAltComissaoVendedor, frmFatAltComissaoVendedor);
        frmFatAltComissaoVendedor.fatVenda := fatVenda;
        frmFatAltComissaoVendedor.strOpcDoc := strOpcDoc;
        frmFatAltComissaoVendedor.ShowModal;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '');
      End;
      pFreeAndNil(frmFatAltComissaoVendedor);
    Finally
      InterlockedDecrement(intConfirmando);
    End;
  End
  Else
    InterlockedDecrement(intConfirmando);

End;

procedure TfrmFatVendas.mnuCompCustoClick(Sender: TObject);
begin
  inherited;
  If cdsVenda.IsEmpty Then Exit;

  If fVerificaAcessoSistema('VISCUS', strLoginUsuarioLogado) Then
    TfrmCadProdutosCompCusto.pMostraComposicaoPrecoCusto(cdsVenda.FieldByName('ITE_CODITE').AsString)
  Else
    fMensagem('', 'Esse usuário não tem acesso a esse recurso.', ['&Ok']);
end;

procedure TfrmFatVendas.btnComVenClick(Sender: TObject);
begin
  inherited;
  pComissaoVendedor;
end;

procedure TfrmFatVendas.pHabilitaPanels(blnHabilar: Boolean);
Begin
  pnlCabecalho.Enabled   := blnHabilar;
  pnlDadosItem.Enabled   := blnHabilar;
  pnlEntCD.Enabled       := blnHabilar;
  pnlBotoesVenda.Enabled := blnHabilar;
End;

function TfrmFatVendas.fValidaCampoEdtSenDig: Boolean;
begin
  Result := True;

  If (pnlDigitador.Visible) Then
  Begin
    If fEmptyStr(edtSenDig.Text) Then
    Begin
      fMensagem('ATENÇÃO!', 'O digitador deve ser preenchido!', ['&O k']);
      Result := False;
    End
    Else
    Begin
      pCarregaDigitador;
      If qryConOpe.FieldByName('OPE_CODOPE').IsNull Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse digitador não está cadastrado!', ['&O k']);
        Result := False;
      End
      Else If qryConOpe.FieldByName('OPE_STATUS').AsString <> 'A' Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse digitador está inativo!', ['&O k']);
        Result := False;
      End
    End;

    If Not Result Then
      pSetFocus(edtSenDig);
  End;
end;

function TfrmFatVendas.fValidaCamposF10: Boolean;
begin
  Result := fValidaCampoEdtSenDig;
end;

procedure TfrmFatVendas.btnConfirmaClick(Sender: TObject);
  Var
    frmAguarde: TfrmGravando;
    strFiltro: String;
    strMens: String;
    fltTotTrava: Double;
    strProdImpLis: String;
    strIteInat: String;
    strClienteRemessa: string;
    strVenInat: String;
    strRepInat: String;
    strItensDataEntregaInferior : String;
    strItensEmpCarIgual: String;
    strCodIteVenInat,
    strCodIteRepInat: String;
    strDocumentoRemessa: string;
    blnFoiCanceladoPedeCliente: Boolean;
begin
  inherited;

  if not fValidaCamposF10 then
    Exit;

  btnCancelaItem.Click;

  if Not fEmptyStr(Self.strNumSerie) then
    fatVenda.strNumSerie := Self.strNumSerie;

  if dtsVenda.DataSet is TUniClientDataSet then
  begin
    TUniClientDataSet(dtsVenda.DataSet).IndexName := String.Empty;
    TUniClientDataSet(dtsVenda.DataSet).IndexFieldNames := 'ITE_ORDITE';
  end;

  If (Not fValidaPermiteMultiLojaEmpresa(True)) Then
    Exit;

  if not fValidaPermiteVenderPara(True) then
    exit;

  If (Not fValidaDataEntregaPedidoHeranca) Then
    Exit;

  If (Not fValidaEmpIteItensTE(False)) Then
  Begin
    blnAtualizandoEmpresaTransferencia := True;
    Try
      pAtualizaEmpresaItemsTE;
    Finally
      blnAtualizandoEmpresaTransferencia := False;
    End;
  End;

  blnAtualizandoRegimeEspecialItens := True;
  Try
    pAtualizaRegimeEspecialItens;
  Finally
    blnAtualizandoRegimeEspecialItens := False;
  End;

  If InterlockedIncrement(intConfirmando) = 0 Then
  Begin
    If (Assigned(fatVenda)) And (fatVenda.blnGravouDocumentos) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Self.Close;
      Exit;
    End;

    strFiltro := cdsVenda.Filter;
    fatVenda.blnGravarDavPv := blnGravarDavPv;
    fatVenda.strClienteDaChaveASerDevolvida := EmptyStr;

    If (fatVenda.intSemaforoCalculaTotGer > -1) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If fPromocoesColetivasInconsitentes Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If fatvenda.fTemItensEntregaFutura('F') And
       (Not fClientePermiteEntregaFutura(edtCodCli.Text, 'F')) Then
    Begin
      fMensagem('ATENÇÃO','Este Cliente não tem permissão para Entrega Futura com ' + sLineBreak +
                          'Status "Falta Produto"!',['&O k']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If fatvenda.fTemItensEntregaFutura('A') And
       (Not fClientePermiteEntregaFutura(edtCodCli.Text, 'A')) Then
    Begin
      fMensagem('ATENÇÃO','Este Cliente não tem permissão para Entrega Futura com ' + sLineBreak +
                          'Status "Aguardando Cliente"!',['&O k']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If fatvenda.fTemItensEntregaFutura('P') And
       (Not fClientePermiteEntregaFutura(edtCodCli.Text, 'P')) Then
    Begin
      fMensagem('ATENÇÃO','Este Cliente não tem permissão para Entrega Futura com ' + sLineBreak +
                          'Status "Previsão de Entrega"!',['&O k']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If Not fVerificaPermissaoEntFut Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If fOrcamentoJaFaturado Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {Req.: 152432}
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin
      If fTemItensEntregaImediata_ComDataEntregaInferior(strItensDataEntregaInferior) Then
      Begin
        fMensagem('ATENÇÃO!', 'Revise o(s) item(ns) (' + strItensDataEntregaInferior + '), a data de entrega deve ser maior ou igual a ' + DateToStr(VS_Date) + '.', ['&Ok']);
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    if (not fValidarFalhaCadastralDeMultiplosDescontosNaNota) then
    begin
      InterlockedDecrement(intConfirmando);
      exit
    end;

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin
      If (fTemItensEntregaFuturaMarcadosComoBrinde) Then
      Begin
        fMensagem('Atenção','Há itens de entrega futura marcados como brinde. O que não é permitido!'+#10#13+
                            'Revise-os antes de confirmar.', ['&OK']);
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (fCfgSis('PREFUT', varString) = 'N') And (chkVenPre.Visible And chkVenPre.Checked) And (fVerificaItensComEntregaFutura) Then
    Begin
      fMensagem('','Não é permitido utilizar entrega futura quando a venda é presencial!', ['&OK']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (chkEntCD.Checked) And (fVerificaItensComEntregaFutura) And (fCfgSis('PEF_CD', varString) = 'N') Then
    Begin
      fMensagem('','Não é possível utilizar entrega pelo CD ' +
                   'com produtos de Entrega Futura!', ['&Ok']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (chkEntCD.Checked) And (fVerificaItensComEntregaFutura) And
       (Not fSomenteItensEntregaFutura) And (fCfgSis('PEF_CD', varString) = 'S') Then
    Begin
      fMensagem('','Pedido de Entrega pelo CD que tenha itens de Entrega ' +
                   'Futura deve conter somente itens ' +
                   'de Entrega Futura!', ['&Ok']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If fVerificaItensComEmpCarregamento Then
    Begin
      If fEmptyStr(fRetornaClienteFilial(VS_strCodEmp, 'C', True)) Then
      Begin
        pMensagemOK('Cliente filial não preenchido no cadastro da empresa logada (necessário para a geração de '+
                    'transferência automática da empresa de carregamento).'+ sLineBreak +'Verifique o cadastro da empresa e tente novamente!');
        InterlockedDecrement(intConfirmando);
        Exit;
      End;

      If chkEntCD.Checked Then
      Begin
        pMensagemOK('O produto '+ cdsVenda.FieldByName('ITE_CODITE').AsString +'-'+ cdsVenda.FieldByName('ITE_DESITE').AsString +' possui empresa '+
                    'responsável pelo carregamento e entrega definida no cadastro ('+ cdsVenda.FieldByName('ITE_EMPCAR').AsString +').'+
                    sLineBreak + 'Neste caso, não é permitido gerar o pedido com este item como entrega pelo CD.');
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (Pos(strOpcDoc, 'OR_PD_VN_CP_') > 0) And (fCfgSis('EMPCAR', varString) = 'S') And fVerificaItensComEmpCarregamentoIgualEmpItem(strItensEmpCarIgual) Then
    Begin
      If Not fPergunta('Os itens a seguir estão definidos com a Empresa de Carregamento igual à empresa do documento. '+
                       'Portanto não gerarão transferência automática: '+ strItensEmpCarIgual + sLineBreak +'Deseja prosseguir?') Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (strOpcDoc = 'NE') And (fCfgSis('NESTIN', varString) = 'S') And
       (fatVenda.fTemItensTintaPorHerancaNFEspecial) then
    begin
      if (Not fClientSelectEhClientFilialEmpLogada(edtCodCli.Text)) Then
      Begin
        pMensagemOk('Nota Fiscal Especial com itens adicionados através da função F1, '+
                    'só pode ser emitida para o Cliente Filial desta empresa!');
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    end;

    {
    Valida somente quando "EMCFEN = 1 e TR1DES = S".
    Pois a função "fQtdDestinoItens" valida o client independente de empresa.
    Quando multiempresa a função "fPermitirApenas1Destino" já válida bloqueando o destino!
    }
    If (fCfgSis('EMCFEN', VarInteger) = 1) And (fCfgSis('TR1DES', varString) = 'S') Then
    Begin
      If (fQtdDestinoItens > 1) Then
      Begin
        pMensagemOk('Não é permitido mais de 1 destino diferente! ( Retira / Entrega )');
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (fatVenda.fVendaMultiloja) And (fExisteItensEntregaFutura) And (Not fPermiteEntregaFuturaMultLoja) Then
    Begin
      pMensagemOk('Não é permitido inserir item de entrega futura para Venda Multi-Empresa quando alguma empresa do item for de replicação!');
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (fCfgSis('IMPLST', varString) = 'N') And
       (fEmptyStr(strNumOrc)) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fValidaImpLis(strProdImpLis)) Then
    Begin
      pMensagemOk('Os seguintes itens (código/empresa) não estão cadastrados: ' + strProdImpLis + '.' + #10#13 +
                  'Verifique o campo "Imprime Lista" aba "Complementos" no Cadastro de Produtos!');
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (blnGravarComo) And (Not fValidaIteInat(strIteInat)) Then
    Begin
      pMensagemOk('Os seguintes itens estão inativos: ' + strIteInat + '. Verifique!');
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fValidaVenRepInat(strVenInat, strRepInat, strCodIteVenInat, strCodIteRepInat)) Then
    Begin
      If Not strVenInat.IsEmpty Then
        pMensagemOk(IIF(fatVenda.fUsaVendedorDoItemParaComissao(fatVenda.strCodVen),
                        'Os seguintes itens foram incluídos com "Vendedor" inativo. Exclua-os e inclua-os novamente: ' +#10#13+ strVenInat,
                        'Os seguintes itens foram incluídos com "Vendedor" inativo. Informe um vendedor válido para que seja repassado aos itens: ' +#10#13+ strVenInat));

      If Not strRepInat.IsEmpty Then
        pMensagemOk(IIF(fatVenda.fUsaVendedorDoItemParaComissao(fatVenda.strCodVe2),
                        'Os seguintes itens foram incluídos com "Vendedor2" inativo. Exclua-os e inclua-os novamente: ' +#10#13+ strRepInat,
                        'Os seguintes itens foram incluídos com "Vendedor2" inativo. Informe um vendedor 2 válido para que seja repassado aos itens: ' +#10#13+ strRepInat));

      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {Valida Condição de Pagamento/Destino - Validado aqui devido a possibilidade de alterar o destino
     via tela "TfrmFatDigTipoEntregaItens"}
    If (fCfgSis('RETENT',varString) = 'S') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin
      If (fCfgSis('CNDVEN') = 'I') And (fCfgSis('USACND') = 'S') And (pnlEntrega.Visible) Then
      Begin
        If Not fControleRetiraEntregaPorCndPagto(edtCodCnd.Text, True) Then
        Begin
          InterlockedDecrement(intConfirmando);
          Exit;
        End;
      End;
    End;

    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (fatVenda.blnCliFil) And
       (fUsaRotinaWMS(VS_strCodEmp)) And (Not fCfgSis('LOTDIF', VarBoolean)) Then
    Begin
      If fValidaLotesDistintosParaUmMesmoItem Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;    

    If fatVenda.fEhAutocenter And pnlPlacaVeiculo.Visible And (Not fEmptyStr(fatVenda.strPlaVei)) Then
    Begin

      If (Not fCfgSis('EDCSIC', varBoolean)) And
         (fClienteConsumidor(fatVenda.strCliOri, False, True)) Then
      Begin
        While (Not fatVenda.fValidaCPFConsumidor) Do
        Begin
          If fPergunta('Sistema configurado para não permitir emitir documento para cliente ' +
                       'consumidor sem informar CPF/CNPJ quando utilizar rotina de Autocenter!' + #13#10 +
                       'Deseja informar agora?') Then
          Begin
            If (Not fDadosCons) Then
            Begin
              InterlockedDecrement(intConfirmando);
              Exit;
            End
            Else If fatVenda.blnUtilizarPreCadastroConsumidor And (Not fEmptyStr(fatVenda.strCodCliPreCadastro)) Then
            Begin
              edtCodCli.Text := fatVenda.strCodCliPreCadastro;
              fatVenda.strCodCliPreCadastro := '';
              fatVenda.blnGraCon := False;
              fValidaCampos(edtCodCli, True);
              InterlockedDecrement(intConfirmando);
              Exit;
            End;
          End
          Else
          Begin
            InterlockedDecrement(intConfirmando);
            Exit;
          End
        End;
      End;
    End;

    If fCfgSis('NPDF11', VarBoolean) And chkEntCD.Checked Then
    Begin
      If fatVenda.fTemItensEntregaImediata Then
      Begin
        fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                     'existem itens de entrega imediata e o ' +
                     'Sistema configurado para "Gerar novo Pedido de Venda com itens de ' +
                     'entrega imediata quando faturar um ' +
                     'pedido pelo F11 do Resumo de Caixa?" ', ['&OK']);

        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If fCfgSis('NPRF11', VarBoolean) And chkEntCD.Checked Then
    Begin
      If fatVenda.fTemItensRetira(opOutraEmpresa) Then
      Begin
        fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                     'existem itens de retira em outra loja e o ' +
                     'Sistema configurado para "Gerar novo Pedido de Venda com itens de ' +
                     'retira em outra loja quando faturar um ' +
                     'pedido pelo F11 do Resumo de Caixa?" ', ['&OK']);

        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If fCfgSis('NPLF11', VarBoolean) And chkEntCD.Checked Then
    Begin
      If fatVenda.fTemItensRetira(opPropriaEmpresa) Then
      Begin
       fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                     'existem itens de retira na mesma loja e o ' +
                     'Sistema configurado para "Gerar novo Pedido de Venda com itens de ' +
                     'retira na mesma loja quando faturar um ' +
                     'pedido pelo F11 do Resumo de Caixa?" ', ['&OK']);

        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If fCfgSis('LOCRET', VarBoolean) And chkEntCD.Checked Then
    Begin
      If fatVenda.fTemItensRetira(opTodasEmpresas, opLocalRetiraExpedicao) Then
      Begin
        fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                     'existem itens de retira expedição e o ' +
                     'Sistema irá gerar um novo pedido de venda quando faturar ' +
                     'pelo F11 do Resumo de Caixa?" ', ['&OK']);

        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If fClienteConsumidor(fatVenda.strCliOri, False, True) And
       chkEntCD.Checked And (fCfgSis('CON_CD', VarString) = 'N') Then
    Begin
      fMensagem('','Sistema configurado para não permitir utilizar entrega pelo CD para ' +
                   'cliente consumidor. Por favor, desmarque a opção de entrega pelo CD!', ['&OK']);
      pSetFocus(chkEntCD);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    fatVenda.blnRestringirElementosMargem := True;

    // Se for confirmação segue a configuração fCfgSis('SUJROM') (vide fatVenda.CreateInstance -> pCarregaCfgSis)
    If (Not fatVenda.fConfirmacaoComEntregaRetiraDefinidaPelaSujRom) And (strOpcDoc <> 'DV') Then
      fatVenda.strEntFat := IIF(fatVenda.fTemItensEntrega, 'S', 'N');

    {***********************************************************}
    {* SE CASO FOR CONFIRMACAO DE PD OU OUTRAS SAIDAS CLIENTE, *}
    {* O SISTEMA IRÁ VER SE TEM ITENS DE ENTREGA E HÁ DATA DE  *}
    {* ENTREGA PREENCHIDA, PARA ASSUMIR O MESMO. SE NÃO HOUVER *}
    {* E FOR ENTREGA ASSUMA A DATA ATUAL. SE NÃO FOR CONFIRMA- *}
    {* ÇÃO MANTE COMO ERA ANTES.                               *}
    {********************************************************FC*}
    If Pos(strOpcDoc, 'OV_CP_') <= 0 Then
      fatVenda.dtaDtEntr := IIF(fatVenda.fTemItensEntregaImediata Or fatVenda.fTemItensRetira,
                                IIF(dtaEntImediata < VS_date, VS_Date, dtaEntImediata),
                                StrToDate('31/12/9999'))
    Else If (Pos(strOpcDoc, 'OV_CP_') > 0)      And
            (SameText(fatVenda.strEntFat, 'S')) And
            (dtaEntImediata > 0) Then
      fatVenda.dtaDtEntr := IIF(fatVenda.fTemItensEntregaImediata Or fatVenda.fTemItensRetira, dtaEntImediata, StrToDate('31/12/9999'))
    Else If (Pos(strOpcDoc, 'OV_CP_') > 0)      And
            (SameText(fatVenda.strEntFat, 'N')) Then
      fatVenda.dtaDtEntr := 0;

    If (Pos(strOpcDoc,'TE') <= 0) And (fClienteFilial(edtCodCli.Text)) And (fExisteItensEntregaFutura) Then
    Begin
      pMensagemOk('Não é permitido inserir item de entrega futura para cliente filial!');
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (edtOprFlj.Text = 'S') And (chkEntCD.Checked) Then
    Begin
      pMensagemOk('Produção fora da loja não pode ser entrega pelo CD!');
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (strOpcDoc = 'TR') And (fCfgSis('SNTRIF') = 'F') And (Not fEmptyStr(fCfgSis('SENTRO'))) Then
    Begin

      objLiberacao.Clear;
      fatVenda.pMontaMsgTroca(cdsVenda, objLiberacao.objMsgLibera);

      objLiberacao.strDirAce := 'TROMER';
      objLiberacao.strSenLib := fCfgSis('SENTRO');
      objLiberacao.strMsgSen := 'Troca de Mercadorias';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

      If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;

    End;

    if (StrOpcDoc = 'CS') and (not fVerificaAcessoSistema('ENVCONSIGNACAO')) then
    begin
      objLiberacao.Clear;
      fatVenda.pMontaMsgConsignacao(cdsVenda, objLiberacao.objMsgLibera);

      objLiberacao.strDirAce := 'ENVCONSIGNACAO';
      objLiberacao.strMsgSen := 'Emissão do Envio de Mercadoria em Consignação';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;

      If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    end;

    {*********************************************************************}
    {* CASO NAO TENHA TRAVADO DIAS QUE NAO COMPRA NO ORCAMENTO OU PEDIDO *}
    {* E ESTEJA TENTANDO VENDER ESTE DOCUMENTO DEVE VERIFICAR NOVAMENTE  *}
    {******************************************************************LU*}
    If (Not fEmptyStr(strNumOrc)) And (strOpcDoc = 'VN') And (fCfgSis('TRANCV') = 'T') Then
    Begin
      If ((fatVenda.strEspOrc = 'OR') And (fCfgSis('TRANCO') <> 'T')) Or
         ((fatVenda.strEspOrc = 'PD') And (fCfgSis('TRANCP') <> 'T')) Then
      Begin
        If fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(fatVenda.blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), True) Then
        Begin
          If Not fatVenda.fVerificaNaoCompra(blnTravaNaoCompra, fRetCodVenDef(edtSenVen.Text), '', True, IIF(fCfgSis('CNDVEN') = 'F', fatVenda.fExecutaTravaNaoCompra, True)) Then
          Begin
            InterlockedDecrement(intConfirmando);
            Exit;
          End;
        End;
      End;
    End;

    If (strOpcDoc = 'BR') And (fCfgSis('LIMBRI') = 'S') Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Acesso ao módulo de Brindes com Campanha Limitada');
      objLiberacao.strDirAce := 'CAMLIM';
      objLiberacao.strSenLib := fCfgSis('SENCAL');
      objLiberacao.strMsgSen := 'Campanha Limitada de Brindes';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
      fatVenda.pAdicionaItensLiberacaoBrinde(objLiberacao.objMsgLibera, cdsVenda);

      If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;

      If (chkCamLim.Visible) And (chkCamLim.Checked) Then
      Begin

        If (Not fConfereLimiteBrinde) Then
        Begin
          InterlockedDecrement(intConfirmando);
          Exit;
        End;

      End;

    End;

    {*************************************************}
    {* VALIDA A QUANTIDADE MÍNIMA POR TABELA DE PREÇO }
    {**********************************************PZ*}
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('O(s) item(s) abaixo estão com a quantidade mínima inferior ao mínimo permitido na tabela de preço:');
    objLiberacao.objMsgLibera.pAddQuebra;
    objLiberacao.objMsgLibera.pAddTextoCaption('Cliente' , edtCodCli.Text+'-'+Copy(edtNomCli.Text,1,65));
    objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor', fRetCodVenDef(edtSenVen.Text)+'-'+Copy(edtNomVen.Text,1,70));
    objLiberacao.objMsgLibera.pAddTextoCaption('Total do Documento', edtTotImp.Text);
    objLiberacao.objMsgLibera.pAddQuebra;

    If (fCfgSis('TRQDMI', varString) = 'S') And
       (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
       (Not fValidaQtdeMinimaPorTabelaPreco(objLiberacao.objMsgLibera))
       Then
    Begin

      objLiberacao.strDirAce := 'TRQDMI';
      objLiberacao.strSenLib := fCfgSis('TRQDMI');
      objLiberacao.strMsgSen := 'Trava de quantidade mínima por tabela de preço';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

      If (Not objLiberacao.fLibera) Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;

      If (chkCamLim.Visible) And (chkCamLim.Checked) Then
      Begin

        If (Not fConfereLimiteBrinde) Then
        Begin
          InterlockedDecrement(intConfirmando);
          Exit;
        End;

      End;

    End;

    If (Pos(strOpcDoc, 'PD_OR_') > 0) Then
    Begin
      If fTemItemTintometrico(True) Then
      Begin
        blnSeEntregaPeloCDGarantirEmpresaProducaoAEmpresaCD := True;
        pCriarFormularios(TfrmGravando, frmAguarde);
        Try
          frmAguarde.fExecutarModalA(pTrocaEmpresaProducaoTinta, 'Aguarde...Atualizando Empresa de Produção da Tinta!', '');
          frmAguarde.ShowModal;
        Finally
          blnSeEntregaPeloCDGarantirEmpresaProducaoAEmpresaCD := False;
          pFreeAndNil(frmAguarde);
        End;
      End;
    End;

    If (Not fConfereEmpresaProducaoForaLoja) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {****************************************************************}
    {* O SISTEMA NÃO DEIXA PROSSEGUIR SE CASO ESTIVER VENDENDO ITEM *}
    {* CONCRETO E NÃO EXISTIR O MODELO DE CONTRATO DE EMPREITA      *}
    {**************************************************************FC}
    If (fCfgSis('USACCR', varBoolean)) And (fCfgSis('IMPCTR', varBoolean)) And (fCfgSis('TPNFCR') <> PRESTCON) Then
    Begin
      If (fatVenda.fEhVendaItemConcreto) And (Not TContratoEmpreitaHelper.fExisteArqModContratoEmpreita) Then
      Begin
        strMens := 'Existem itens concreto e o sistema está configurado para imprimir contrato de empreita de construção civil,' +
                   'porém o arquivo ' + ExtractFilePath(Application.ExeName) + 'MODELO_CONTRATO_EMPREITA.DOC não foi encontrado. ' +
                   'Não será possível prosseguir esta venda!';
        pMensagemOk(strMens);
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    //Prestcon
    If (strOpcDoc = 'VN') And fatVenda.fEhVendaConcreto And (fCfgSis('TPNFCR') = PRESTCON) Then
    Begin
      If (cdsVenda.FieldByName('ITE_PROMOC').AsString <> 'S') Or
         (Not fTemAlgumProdutoComPromocaoParaCliente(edtCodCli.Text)) Then
      Begin
        strMens := 'Existe item concreto porém não existe nenhuma "Promoção" para este cliente. ' +
                   'O preço de venda é determinado de acordo com o contrato firmado entre as partes com vigência estabelecida. ' +
                   'Para definir o período de validade e os clientes que utilizam esse preço é utilizado o cadastro de ' +
                   'promoção. Não será possível prosseguir esta venda!';
        pMensagemOk(strMens);
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    {*******************************************************************}
    {* O SISTEMA NÃO DEIXA PROSSEGUIR SE AUTTIN CONFIGURADO POR TABELA *}
    {* DE PREÇO E A TABELA NAO ESTIVER ATIVA NO FATURAMENTO CFG_TABPRC *}
    {*****************************************************************AC}
    If Not fatVenda.fTabelasTintasConfiguradasCorretamente Then
    Begin
      pMensagemOk('Tabela de geração da tinta não está ativa no faturamento !' + #13#10 +
                  'Favor verificar tabela de geração no Auttin.' + #13#10 +
                  'Favor verificar o parâmetro CFG_TABPRC.');
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {******************************************************}
    {* TRAVA VENDA DE PRODUTOS QUE NÃO TEM PERMISSÃO PARA *}
    {* SEREM VENDIDOS COM DETERMINADAS CONDIÇÕES DE PAGTO *}
    {***************************************************MM*}
    If (fCfgSis('ITECND', varBoolean)) And
       (fCfgSis('USACND', varBoolean)) And
       (fCfgSis('CNDVEN', varString) = 'I') And
       (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('TRAVA DE PRODUTOS QUE NAO PODEM SER VENDIDOS NA CONDICAO DE PAGAMENTO INFORMADA', alCentro, teAmbos, '', 93);
      objLiberacao.objMsgLibera.pAddSeparador(126);
      objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto'        , edtCodCnd.Text + '-' + Copy(edtDesCndPag.Text,1,73), 17);
      objLiberacao.objMsgLibera.pAddTextoCaption('                 ' , fFormataCondPag(fTiraCaracEspeciais(mskCndPag.Text))                      , 17);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Total Produtos' , FormatFloat('#,##0.00',fltTotTrava)                                , 17);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor'          , fRetCodVenDef(edtSenVen.Text)+'-'+Copy(edtNomVen.Text,1,73)        , 17);
      objLiberacao.objMsgLibera.pAddSeparador(126);
      objLiberacao.objMsgLibera.pAddTexto('Os produtos listados abaixo não podem ser vendidos na condicao de pagamento informada.');

      If (fTemProdutoNaoRelacionadoCondPagto(objLiberacao.objMsgLibera, fltTotTrava, edtCodCnd.Text)) Then
      Begin
        objLiberacao.strDirAce := 'ITECND';
        objLiberacao.strSenLib := fCfgSis('SENITC');
        objLiberacao.strMsgSen := 'Trava de Produtos que não podem ser vendidos com determinadas Condições de Pagamento';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
        objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
        objLiberacao.pInformaNumDocEspDocCodEmp(
                        fatVenda.strNumDoc,
                        fatVenda.strEspDoc,
                        fatVenda.strEmpDoc);

        If (Not objLiberacao.fLibera) Then
        Begin
          InterlockedDecrement(intConfirmando);
          Exit;
        End;
      End;
    End;

    If (strOpcDoc = 'DV') And
       (cdsVenda.RecordCount > 0) And
       (fEspeciePermitidaDevolucao('NF')) And
       (fPessoaJuridicaComIES(edtCodCli.Text)) Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Não é permitido emitir devolução para pessoa jurídica com inscrição estadual cadastrada.');

      objLiberacao.strDirAce := 'DEVPJ';
      objLiberacao.strSenLib := fCfgSis('SEDVPJ');
      objLiberacao.strMsgSen := 'Devolução Para Pessoa Jurídica';
      objLiberacao.strCodOpe := fatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      If Not fatVenda.fFatMensagemLiberacao(objLiberacao) Then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (Not fVerificaAcessoSistema('DVPJSI')) Then
    Begin
      If (strOpcDoc = 'DV') And
         (cdsVenda.RecordCount > 0) And
         (fEspeciePermitidaDevolucao('NF')) And
         (fPessoaJuridicaSemIES(edtCodCli.Text)) Then
      Begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Não é permitido emitir devolução para pessoa jurídica sem inscrição estadual cadastrada.');

        objLiberacao.strDirAce := 'DVPJSI';
        objLiberacao.strSenLib := fCfgSis('DVPJSI');
        objLiberacao.strMsgSen := 'Devolução Para Pessoa Jurídica';
        objLiberacao.strCodOpe := fatVenda.strCodVen;
        objLiberacao.strCodDig := fatVenda.strCodDig;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
        objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

        If Not fatVenda.fFatMensagemLiberacao(objLiberacao) Then
        Begin
          InterlockedDecrement(intConfirmando);
          Exit;
        End;
      End;
    End;

    If Not fValidaUnitarioFechamento Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If Not fValidaTrocaTabPreFechamento Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (Pos(strOpcDoc, 'VN_OR_PD_') > 0) And (fCfgSis('TRVAFO') = '2') And (Not fValidaItensVencidos) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {NÃO PERMITE VENDA A PRAZO PARA CONSIGNAÇÃO}
    If (fCfgSis('USACND', varString) = 'S') And
       (fCfgSis('CNDVEN') = 'I') And
       (StrOpcDoc = 'CS') And
       (fStatusCndPag(mskCndPag.Text) = A_PRAZO) Then
    Begin
      fMensagem('','A condição de pagamento não pode ser a prazo para envio de mercadoria em consignação!',['&OK']);
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {**************************************************************}
    {* TRAVA DE ALTERAÇÃO DA QTDE DOS ITENS DO PEDIDO QUANDO      *}
    {* O MESMO ESTÁ INSERIDO EM UM PRÉ-ROMANEIO E JÁ FOI EXPEDIDO *}
    {***********************************************************MM*}
    If Not fVerificaQtdeRomaneio(strNumOrc,
                                 strEspOrc,
                                 IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                 '',
                                 '') Then
    Begin
      Exit;
    End;

    If (Not fValidaEmpIteItensTE) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (Not fValidaEmpIteItensORPD) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If Not fConfereVendedor Then
    begin
      if (edtSenVen.Visible) and (edtSenVen.Enabled) then
        pSetFocus(edtSenVen);

      InterlockedDecrement(intConfirmando);
      Exit;
    end;

    If (Pos(strOpcDoc, 'VN_OR_PD_') > 0) And (not fValidaCusto) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    if strOpcDoc = 'EM' then
    begin
      blnFoiCanceladoPedeCliente := False;
      pPedeCliente(strClienteRemessa, strDocumentoRemessa, blnFoiCanceladoPedeCliente);
      if fEmptyStr(strClienteRemessa) then
      begin
        If Not blnFoiCanceladoPedeCliente Then
          pMensagemOk('O cliente da remessa deve ser preenchido.');

        InterlockedDecrement(intConfirmando);
        Exit;
      end;

      if not fValidaItensRemessa(strClienteRemessa, strDocumentoRemessa) then
      begin
        InterlockedDecrement(intConfirmando);
        Exit;
      end;
      pPreencheDicionarioRemessa(strClienteRemessa, strDocumentoRemessa);
    end;

    If (Pos(fatVenda.strOpcDoc, 'OR_PD_') > 0) And
       (fCfgSis('LTESMI', varString) = 'S') And
       (fatVenda.blnCliFil) And
       (fRetCodEmpClienteFilial(fatVenda.strCodCli) = VS_strCodEmp) Then
    Begin
      if not fatVenda.fValidarQuantidadeEstoqueMinimoParaClienteFilial then
      Begin
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (Pos(fatVenda.strOpcDoc, 'PD_OR_') > 0) And (fCfgSis('NSERQT', varString) = 'S') Then
    Begin
      If Not fValidaQuantSerieItens Then
      Begin
        pMensagemOk('A quantidade total das séries está divergente da quantidade do item "'+ fDescricaoItemParaLocalizar +'". Favor verificar');
        InterlockedDecrement(intConfirmando);
        Exit;
      End;
    End;

    If (Not fValidarEstruturaExterna(edtCodCli.Text, edtNomCli.Text, fCodEmp)) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    {**************************************************************}
    {* AVISO PARA USUÁRIO SOBRE A SITUAÇÃO DE ITEM DEVOLVIDO      *}
    {***********************************************************CH*}
    pProdutoPodeSerDevolvido;

    if (fCfgSis('CMEVNR', varString) = 'S') and (strOpcDoc = 'VN') and fTemItensEntregaBalcao then
    begin
      try
        pCriarFormularios(TfrmFatConfOrcamentosItens, frmFatConfOrcamentosItens);
        frmFatConfOrcamentosItens.strCodOpe := fatVenda.strCodVen;
        frmFatConfOrcamentosItens.blnRetBal := True;
        frmFatConfOrcamentosItens.blnRcxF11 := False;
        frmFatConfOrcamentosItens.ShowModal;

        if frmFatConfOrcamentosItens.blnConferido or frmFatConfOrcamentosItens.blnLimExp then
        begin
          cdsVenda.DisableControls;

          frmFatConfOrcamentosItens.cdsItens.First;

          while not frmFatConfOrcamentosItens.cdsItens.Eof do
          begin
            if cdsVenda.Locate('AUTOINCREM', frmFatConfOrcamentosItens.cdsItens.FieldByName('AUTOINCREM').AsString, []) then
            begin
              cdsVenda.Edit;
              cdsVenda.FieldByName('ITE_QTDEXP').AsFloat := frmFatConfOrcamentosItens.cdsItens.FieldByName('QTDLIB').AsFloat;
              cdsVenda.FieldByName('ITE_QTDRET').AsFloat := frmFatConfOrcamentosItens.cdsItens.FieldByName('QTDLIB').AsFloat;
              cdsVenda.Post;
            end;

            frmFatConfOrcamentosItens.cdsItens.Next;
          end;

          cdsVenda.EnableControls;

          if (not frmFatConfOrcamentosItens.blnConferido) then
          begin
            InterlockedDecrement(intConfirmando);
            Exit;
          end;
        end
        else
        begin
          InterlockedDecrement(intConfirmando);
          Exit;
        end;
      finally
        pFreeAndNil(frmFatConfOrcamentosItens);
      end;
    end;

    If Not fValidaItemNaoAcabado(True) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    If (Pos(strOpcDoc, 'OR_PD_') > 0) And (Not fValidarMultiploVendaNoFinal()) Then
    Begin
      InterlockedDecrement(intConfirmando);
      Exit;
    End;

    Try
      pMostraStatusPedBloqueado;

      blnFechamentoVenda := True;

      blnFechamentoComDesconto := (TButton(Sender).Tag = 99) Or (fConfirmacaoDocumentoComDescontoProfissional);
      blnBotaoFechamentoComDescontoPressionado := (blnFechamentoComDesconto) And (Not fConfirmacaoDocumentoComDescontoProfissional);

      If fatVenda.fPermiteInformarCupomDesconto And Not fEmptyStr(fatVenda.strCupDes) Then
        If Not TFatCupomDesconto.Create(fatVenda).PodeUtilizarCupom(fatVenda.strCupDes, False) Then
           blnFechamentoComDesconto := True;

      fatVenda.blnPassouPelaTelaDescontoEConfirmou := (TButton(Sender).Tag <> 99);

      pConfirma;

      recDuplicaItem.strCodIte := EmptyStr;
      recDuplicaItem.strComple := EmptyStr;
      recDuplicaItem.fltQtdEst := 0.00;
      recDuplicaItem.fltQtdPro := 0.00;
      recDuplicaItem.fltDesCon := 0.00;
      recDuplicaItem.fltUnitar := 0.00;

      pnlInfo2.Visible := False;
      pnlInfo2.Caption := '';

      If strOpcDoc <> 'NC' Then
        pHabilitaPanels(True)
      Else
        pnlBotoesVenda.Enabled := True;

      blnFechamentoVenda := False;

      InterlockedDecrement(intConfirmando);
    Except
      blnFechamentoVenda := False;
      pHabilitaPanels(True);
      InterlockedDecrement(intConfirmando);
    End;

    If (Pos(strOpcDoc, 'CO_VS_CP_CF_CI_')>0) Then
    Begin
      pnlDadosItem.Enabled := False;
      dbgItens.Enabled     := False;
    End;

    // ESTAVA MANTENDO O FILTRO ENTFUT = "S"
    cdsVenda.Filter := strFiltro;
  End
  Else
    InterlockedDecrement(intConfirmando)
End;

function TfrmFatVendas.fValidaPedidoCompra: Boolean;
begin
  Result := False;

  if (Pos(strOpcDoc, 'VN_OR_PD_') <= 0) then
  begin
    Result := True;
    Exit;
  end;

  if not fValidaPedidoCompraItens then
    Exit;

  if fAbrirTelaDePedDeCompraParaConferencia then
  begin
    if not fValidaConferenciaPedComp then
      Exit
    else if not fValidaPedidoCompraItens(False) then
      Exit;
  end;

  Result := True;
end;

function TfrmFatVendas.fAbrirTelaDePedDeCompraParaConferencia: Boolean;
begin
  Result := True;

  if (fCfgSis('TLCONF', varBoolean)) and
     (not blnExibiuTelaDePedCompra) and
     (fExisteItemComPedidoCompraInformado) then
    Exit;

  Result := False;
end;

function TfrmFatVendas.fValidaConferenciaPedComp: Boolean;
  var
    frmFatDigPedidoCompraItens: TfrmFatDigPedidoCompraItens;
begin
  Result := False;
  pCriarFormularios(TfrmFatDigPedidoCompraItens, frmFatDigPedidoCompraItens);
  try
    try
      pMontaObjFatDigPedComp(frmFatDigPedidoCompraItens);

      if frmFatDigPedidoCompraItens.ShowModal = mrOK then
      begin
        pAtualizaCdsVendaPedComp(frmFatDigPedidoCompraItens.cdsDados);
        pAtualizaPedidoDeCompraDigitado;
      end
      else
        Exit;

      Result := True;
    finally
      pFreeAndNil(frmFatDigPedidoCompraItens);
    end;
  except
    on E: Exception do
      pMensagensErro(E.Message, '');
  end;
end;

procedure TfrmFatVendas.pFiltraCdsSemItemServico(var cdsFiltro: TUniClientDataSet);
begin
  cdsFiltro.Filtered := False;
  cdsFiltro.Filter   := 'ITE_CODITE <> ' +  QuotedStr(fCfgSis('ITESER'));
  cdsFiltro.Filtered := True;
end;

procedure TfrmFatVendas.pMontaObjFatDigPedComp(var objPedComp: TfrmFatDigPedidoCompraItens);
begin
  objPedComp.strChamouF10FatVendas := True;

  objPedComp.cdsDados.Data := cdsVenda.Data;
  objPedComp.cdsDados.IndexFieldNames := 'ITE_NUMCMP;ITE_NITCMP;ITE_CODITE';
  objPedComp.cdsDados.First;
  objPedComp.cdsDados.LogChanges := False;
  objPedComp.Caption := 'Conferência de Digitação do Número do Pedido de Compra';
  pFiltraCdsSemItemServico(objPedComp.cdsDados);

  objPedComp.strCodCli := fatVenda.strCodCli;
  objPedComp.strCodVen := fatVenda.strCodVen;
  objPedComp.strNumDoc := strNumOrc;
  objPedComp.strEspDoc := strEspOrc;
  objPedComp.strCodEmp := strEmpOrc;
end;

procedure TfrmFatVendas.pAtualizaCdsVendaPedComp(cdsPedComp: TUniClientDataSet);
begin
  cdsPedComp.First;
  while not cdsPedComp.Eof do
  begin
    if cdsVenda.Locate('AUTOINCREM', cdsPedComp.FieldByName('AUTOINCREM').AsInteger, []) then
    begin
      cdsVenda.Edit;
      cdsVenda.FieldByName('ITE_NUMCMP').Value    := cdsPedComp.FieldByName('ITE_NUMCMP').Value;
      cdsVenda.FieldByName('ITE_NITCMP').Value    := cdsPedComp.FieldByName('ITE_NITCMP').Value;
      cdsVenda.FieldByName('ITE_DTACMP').Value    := cdsPedComp.FieldByName('ITE_DTACMP').Value;
      cdsVenda.FieldByName('ITE_COD_NF').AsString := cdsPedComp.FieldByName('ITE_COD_NF').AsString;
      cdsVenda.FieldByName('ITE_DES_NF').AsString := cdsPedComp.FieldByName('ITE_DES_NF').AsString;
      cdsVenda.FieldByName('ITE_CLIBAR').AsString := cdsPedComp.FieldByName('ITE_CLIBAR').AsString;
      cdsVenda.FieldByName('ITE_NUMPLA').AsString := cdsPedComp.FieldByName('ITE_NUMPLA').AsString;
      cdsVenda.FieldByName('ITE_PARNUM').AsString := cdsPedComp.FieldByName('ITE_PARNUM').AsString;
      cdsVenda.FieldByName('ITE_REQCOM').AsString := cdsPedComp.FieldByName('ITE_REQCOM').AsString;
      cdsVenda.FieldByName('ITE_DESNES').AsString := cdsPedComp.FieldByName('ITE_DESNES').AsString;
      cdsVenda.Post;
    end;
    cdsPedComp.Next;
  end;
end;

procedure TfrmFatVendas.btnConsultaFitClick(Sender: TObject);
var
  dicValoresAtuais, dicResultado: TDicionario;
begin
  inherited;

  If (Not qryConCli.Active) Then
  Begin
    fMensagem('ATENÇÃO!', 'O Cliente não foi carregado corretamente, tente novamente.', ['&Ok']);
    pSetFocus(edtCodCli);
    Exit;
  End;

  If qryConCli.FieldByName('CLI_CGCCPF').AsString <> '1' Then
    Exit;

  If fEmptyStr(qryConCli.FieldByName('CLI_C_G_C_').AsString) Then
  Begin
    fMensagem('Atenção', 'Informe o CNPJ antes de realizar a consulta', ['&Ok']);
    Exit;
  End;

  dicValoresAtuais := TDicionario.Create;
  dicResultado := TDicionario.Create;
  try
    dicValoresAtuais.Limpar;
    dicValoresAtuais.Adicionar(DESC_RAZAO_SOCIAL,  qryConCli.FieldByName('CLI_NOMCLI').AsString);
    dicValoresAtuais.Adicionar(DESC_NOME_FANTASIA, qryConCli.FieldByName('CLI_FANSOB').AsString);
    dicValoresAtuais.Adicionar(DESC_INSC_EST,      qryConCli.FieldByName('CLI_I_E_S_').AsString);
    dicValoresAtuais.Adicionar(DESC_ENDERECO,      qryConCli.FieldByName('CLI_ENDERE').AsString);
    dicValoresAtuais.Adicionar(DESC_NUMERO,        qryConCli.FieldByName('CLI_ENDNUM').AsString);
    dicValoresAtuais.Adicionar(DESC_COMPLEMENTO,   qryConCli.FieldByName('CLI_ENDCOM').AsString);
    dicValoresAtuais.Adicionar(DESC_BAIRRO,        qryConCli.FieldByName('CLI_BAIRRO').AsString);
    dicValoresAtuais.Adicionar(DESC_CEP,           qryConCli.FieldByName('CLI_C_E_P_').AsString);
    dicValoresAtuais.Adicionar(DESC_IBGE_CIDADE,   fRetornaCodIBGE(qryConCli.FieldByName('CLI_CODCID').AsString));
    dicValoresAtuais.Adicionar(DESC_CNPJ,          qryConCli.FieldByName('CLI_C_G_C_').AsString);
    dicValoresAtuais.Adicionar(DESC_CNAE,          qryConCli.FieldByName('CLI_CODCNA').AsString);

    objConsultaCadastroFit.pConsulta(dicValoresAtuais,
                                     dicResultado,
                                     qryConCli.FieldByName('CLI_C_G_C_').AsString,
                                     True,
                                     blnTemDivergenciaSefaz,
                                     False);
  finally
    FreeAndNil(dicValoresAtuais);
    FreeAndNil(dicResultado);
  end;

  SelectNext(ActiveControl, True, True);
end;

