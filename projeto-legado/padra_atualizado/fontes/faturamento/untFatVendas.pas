procedure TfrmFatVendas.mnuImportarVendasPerdidasClick(Sender: TObject);
var
  cdsVendasPerdidas: TUniClientDataSet;
  frmFatImportarVendasPerdidas: TfrmFatImportarVendasPerdidas;
begin
  inherited;

  If Not mnuImportarVendasPerdidas.Visible Then
    Exit;

  If Not fVerificaCamposInterna Then
    Exit;

  pCriarFormularios(TfrmFatImportarVendasPerdidas, frmFatImportarVendasPerdidas);
  frmFatImportarVendasPerdidas.pCarregaDados(edtCodCli.Text);

  Try
    If frmFatImportarVendasPerdidas.ShowModal = mrOk Then
    Begin
      If InterlockedIncrement(intConfirmando) = 0 Then
      Begin
        Try
          cdsVendasPerdidas := frmFatImportarVendasPerdidas.cdsDados;

          cdsVendasPerdidas.Filtered := False;
          cdsVendasPerdidas.Filter := 'SELECIONADO = ' + quotedStr('S');
          cdsVendasPerdidas.Filtered := True;

          cdsVendasPerdidas.First;
          While not cdsVendasPerdidas.Eof Do
          Begin
            If (rdbCodFab.Visible And rdbCodIte.Visible And rdbCodFab.Checked) Then
              rdbCodIte.Checked := True;

            edtCodIte.Text := cdsVendasPerdidas.FieldBYName('VPD_CODITE').AsString;
            pCarregaItem(True, True, False, True);

            If (pnlItemLote.visible) then
              edtNumLot.Text := TCadLot.fRetornaLoteAtivo(edtCodIte.Text, VS_strCodEmp);

            edtQtdIte.Text := cdsVendasPerdidas.FieldBYName('VPD_QTDITE').AsString;

            pLabelInformacaoGrid('Inserindo itens de vendas perdidas...');

            strNumCmpVndPer := cdsVendasPerdidas.FieldBYName('VPD_NUMCMP').AsString;
            intNItCmpVndPer := cdsVendasPerdidas.FieldBYName('VPD_NITCMP').AsInteger;
            dtaDtaCmpVndPer := cdsVendasPerdidas.FieldBYName('VPD_DTACMP').AsDateTime;
            strSeqVendaPerdida := cdsVendasPerdidas.FieldByName('AUTOINCREM').AsString;

            pAdicionar;

            strNumCmpVndPer := EmptyStr;
            intNItCmpVndPer := 0;
            dtaDtaCmpVndPer := 0;
            strSeqVendaPerdida := EmptyStr;

            pLimpaDadosItem;

            pProcessMessages;

            cdsVendasPerdidas.Next;
          End;
        Finally
          InterlockedDecrement(intConfirmando);
        End;
      End;
    End;
  Finally
    pFreeAndNil(frmFatImportarVendasPerdidas);
  End;

end;

function TFrmFatVendas.fGetSeqRequisicoesInseridas: String;
  Var
    cdsDados: TUniClientDataSet;
begin
  cdsDados := TUniClientDataSet.Create(nil);

  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;

  Result := '""';  

  With cdsDados Do
  Begin
    First;
    While Not Eof Do
    Begin
      If Not fEmptyStr(FieldByName('ITE_SEQRCD').AsString) Then
        Result := Result + ', "' + FieldByName('ITE_SEQRCD').AsString + '" ';
      Next;
    End;
  End;

  FreeAndNil(cdsDados);
end;

function TfrmFatVendas.fGetTotalCredCli(strCodCli, strNumDoc, strEspDoc,
  strCodEmp: String; blnUsaEmpOri: Boolean): Double;
Var
  fltCreAdt,
  fltCreCli : Double;
begin
  fltCreAdt := TAdiantamento.fGetTotaisAdiantamento(strNumDoc,
                                                    strEspDoc,
                                                    strCodEmp).fltValCre;

  fltCreCli := fGetTotalCreditosCliente(strCodCli, blnUsaEmpOri);

  Result    := fltCreAdt + fltCreCli;
end;

