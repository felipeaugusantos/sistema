procedure TfrmFatVendas.pRecalculaTintaMaquinaSelecionadoCasoNecessario(strEmpPrdAnt: String);
begin
  If (cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
    Exit;

  If strEmpPrdAnt = cdsVenda.FieldByName('ITE_EMPPRD').AsString Then
    Exit;

  If Not fatVenda.fAcertarCustoTintaMaquina(strEmpPrdAnt, cdsVenda.FieldByName('ITE_EMPPRD').AsString) Then
    Exit;

  fatVenda.pAcertaPrecosTinta(cdsVenda.FieldByName('AUTOINCREM').AsInteger, True);
  fatVenda.pCalculaTotGerProdutoSelecionado(cdsVenda);
end;

procedure TfrmFatVendas.pCalculaCustoRealTintaMaquinaSelecionado;
  Var
    strFilter: String;
begin
  Try
    If cdsVenda.FieldByName('ITE_IDEPRO').AsString = '' Then
      Exit;

    If cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR' Then
      Exit;

    strFilter := 'AUTOINCREM = ' + cdsVenda.FieldByName('AUTOINCREM').AsString;

    fatVenda.pPreencheMatrizFechamento(strFilter);
    fatVenda.pRecalculaCustos(fatVenda.arrMatItens);

    If Length(fatVenda.arrMatItens) = 0 Then
      Exit;

    cdsVenda.Edit;
    cdsVenda.FieldByName('ITE_PRECU2').AsFloat := fatVenda.arrMatItens[0].fltPreCu2;
    cdsVenda.FieldByName('ITE_TOTCU2').AsFloat := fatVenda.arrMatItens[0].fltTotCu2;
    cdsVenda.Post;
  Except
    On E: ExceptionAutCom Do
      pMensagemOk(E.Message);

    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;
end;

procedure TfrmFatVendas.pAtualizarEditsTotais;
begin
  If fDigitarServicoInicioVenda Then
  Begin
    edtTotGer.Text := FloatToStrF( fatVenda.fltTotGer -
                                   fatVenda.fltTotIpi -
                                   fatVenda.fltTotRet -
                                   fatVenda.fltTotFcpST -
                                   fatVenda.fltTotCBS -
                                   fatVenda.fltTotIBS -
                                   fatVenda.fltTotIS -
                                   fatVenda.fltTotSer, ffNumber, 12, 2 );
    edtTotSer.Text := FloatToStrF( fatVenda.fltTotSer, ffNumber, 12, 2 );
  End
  Else
  Begin
    edtTotGer.Text := FloatToStrF( fatVenda.fltTotGer -
                                   fatVenda.fltTotIpi -
                                   fatVenda.fltTotRet -
                                   fatVenda.fltTotFcpST -
                                   fatVenda.fltTotCBS -
                                   fatVenda.fltTotIBS -
                                   fatVenda.fltTotIS, ffNumber, 12, 2 );
  End;

  If blnExiPar Then
    edtTotImp.Text := FloatToStrF((fatVenda.fltTotGer / StrToIntDef(LeftStr(fatVenda.strConPag, 2), 1)), ffNumber, 12, 2 )
  Else
    edtTotImp.Text := FloatToStrF( fatVenda.fltTotGer, ffNumber, 12, 2 );

  edtTotIpi.Text := FloatToStrF( fatVenda.fltTotGer -
                                 fatVenda.fltTotRet -
                                 fatVenda.fltTotFcpST -
                                 fatVenda.fltTotCBS -
                                 fatVenda.fltTotIBS -
                                 fatVenda.fltTotIS, ffNumber, 12, 2 );

  edtSohIPI.Text := FloatToStrF( fatVenda.fltTotIpi, ffNumber, 12, 2 );
  edtSohST.Text  := FloatToStrF( fatVenda.fltTotRet, ffNumber, 12, 2 );
  edtSohFCP.Text := FloatToStrF( fatVenda.fltTotFcpST, ffNumber, 12, 2 );

  edtTotCBS.Text := FloatToStrF( fatVenda.fltTotCBS, ffNumber, 12, 2 );
  edtTotIBS.Text := FloatToStrF( fatVenda.fltTotIBS, ffNumber, 12, 2 );
  edtTotIS.Text  := FloatToStrF( fatVenda.fltTotIS,  ffNumber, 12, 2 );

  PostMessage(Application.Handle, WM_MESSAGEATUALIZOUTOTALVENDA, 0, 0);
end;

procedure TfrmFatVendas.pMostraEstoqueLojas;
  Var
    strEmpSel: String;
begin
  pMostraEstoqueLojas(strEmpSel, False);
end;

procedure TfrmFatVendas.pMostraEstoqueLojas(Var strEmpSel: String; blnPedEmp: Boolean = True);
  Var
    strCodIte: String;
    strTabIte: String;
    fltQtdIte: Double;
    frmFatMostraEstoqueEmp : TfrmFatMostraEstoqueEmp;
begin
  if (not fVerificaAcessoSistema('PVISPF')) then
    Exit;


  strEmpSel := '';
  fltQtdIte := 0.0;

  If Not fEmptyStr(fCodItem) Then
  Begin
    strCodIte := fCodItem;
    fltQtdIte := fStrToFloat(edtQtdIte.Text);
    strTabIte := fTabelaPrecoItem;
  End
  Else If cdsVenda.Active And (Not cdsVenda.IsEmpty) Then
  Begin
    strCodIte := cdsVenda.FieldByName('ITE_CODITE').AsString;
    fltQtdIte := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
    strTabIte := cdsVenda.FieldByName('ITE_TABPRE').AsString;
  End;

  If fEmptyStr(strCodIte) Then
    Exit;

  Try
    pCriarFormularios(TfrmFatMostraEstoqueEmp, frmFatMostraEstoqueEmp);
    frmFatMostraEstoqueEmp.blnFaturamento := True;
    frmFatMostraEstoqueEmp.strCodIte    := strCodIte;
    frmFatMostraEstoqueEmp.fltQtdIte    := fltQtdIte;
    frmFatMostraEstoqueEmp.strTabPre    := strTabIte;
    frmFatMostraEstoqueEmp.blnPedCorte  := fatVenda.blnPedCorte;
    frmFatMostraEstoqueEmp.edtItem.Text := strCodIte + ' - ' + fRetNomProduto(strCodIte);
    frmFatMostraEstoqueEmp.pnlSelecEmpresa.Visible := blnPedEmp;

    If frmFatMostraEstoqueEmp.showModal = mrOk Then
    Begin
      strEmpSel := frmFatMostraEstoqueEmp.edtCodEmp.Text;
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[pMostraEstoqueLojas]');
  End;

  pFreeAndNil(frmFatMostraEstoqueEmp);
end;

