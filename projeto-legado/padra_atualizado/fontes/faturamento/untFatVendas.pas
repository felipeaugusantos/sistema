procedure TfrmFatVendas.edtNumLotKeyPress(Sender: TObject; var Key: Char);
Var
  blnPesquisarLote: Boolean;

  function fMostrarLotePickingCheckout : Boolean;
begin
    Result := TPickingCheckOut.fWMSUtilizaPickingCheckOut And fEhRetiraCaixa;
  end;

begin
  inherited;
  blnPesquisarLote := (Not edtNumLot.ReadOnly) Or
    ((chkPegou.Visible And chkPegou.Checked) And fUsaRotinaExpedicaoConferenciaRetiraCaixa);

  If Not blnPesquisarLote Then
    Exit;

  blnNumLotAntAlterar := True;

  Try
    If fPesquisaLote(Sender, Key, nil, fMostrarLotePickingCheckout) Then
    Begin
      {******************************************************************}
      {* CASO SELECIONOU O LOTE A DEFINIR JA ALTERA PARA ENTREGA FUTURA *}
      {***************************************************************JC*}
      If (fCfgSis('ENTFUT', VarBoolean)) And (cmbTipEnt.Visible) And
         (SameText(edtNumLot.Text, 'A DEFINIR')) And
         ((cmbEntRet.ItemIndex = IDX_RETIRA) Or (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA)) Then
      Begin
        If (qryConCit.FieldByName('ITE_PEFFPR').AsString = 'S') Then
        Begin
          cmbEntRet.ItemIndex := IDX_ENTREGA;
          cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA;
          cmbMotEntFut.ItemIndex := IDX_MOTIVO_FALTA_PRODUTO;
        End;

        If (qryConCit.FieldByName('ITE_PEEFUT').AsString = 'S') Then
        Begin
          cmbEntRet.ItemIndex := IDX_ENTREGA;
          cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA;
          cmbMotEntFut.ItemIndex := IDX_MOTIVO_AGUARDANDO_CLIENTE;
        End;

        If (qryConCit.FieldByName('ITE_PEFUTP').AsString = 'S') Then
        Begin
          cmbEntRet.ItemIndex := IDX_ENTREGA;
          cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA;
          cmbMotEntFut.ItemIndex := IDX_MOTIVO_PREVISAO_ENTREGA;
        End;
      End;

      If fValidaCampos(edtNumLot, True) Then
        Self.SelectNext(ActiveControl, True, True);
    End;
  Finally
    blnNumLotAntAlterar := False;
  End;
end;

function TfrmFatVendas.fPesquisaLote(Sender    : TObject;
                                     Var Key   : Char;
                                     arrNumLot : TStringArray = Nil;
                                     blnMostrarLotePickingCheckout : Boolean = False): Boolean;
  var
    objfrmPnl: TPanelCxCadLote;
    blnApenasPrincipalVendaOuCheckout: Boolean;
    blnSaldoPositivo: Boolean;
    arrLotesAdd: TStringArray;
    cdsDados: TUniClientDataSet;
begin
  inherited;

  cdsDados := TUniClientDataSet.Create(Nil);

  Try
    blnApenasPrincipalVendaOuCheckout := ((chkPegou.Visible And chkPegou.Checked) And fUsaRotinaExpedicaoConferenciaRetiraCaixa);
    blnSaldoPositivo := ((chkPegou.Visible And chkPegou.Checked) And fUsaRotinaExpedicaoConferenciaRetiraCaixa);

    SetLength(arrLotesAdd, 0);

    if (fCfgSis('MARMOR', varBoolean)) and (fCfgSis('CTRLCH', varBoolean)) then
    begin
      pCloneDataSet(cdsDados, cdsVenda);
      cdsDados.Filtered := False;
      cdsDados.Filter := 'ITE_CODITE = ' + QuotedStr(fCodItem);
      cdsDados.Filtered := True;

      cdsDados.First;

      while not cdsDados.Eof do
      begin
        if not fEmptyStr(cdsDados.FieldByName('ITE_NUMLOT').AsString) then
          pAddDados(arrLotesAdd, cdsDados.FieldByName('ITE_NUMLOT').AsString);
        cdsDados.Next;
      end;
    end;

    objfrmPnl := TPanelCxCadLote.Create(TfrmPnlDadosCadLote);
