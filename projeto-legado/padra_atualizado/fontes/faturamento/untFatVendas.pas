function TfrmFatVendas.fTravaAlteracaoPedidoOrcamentoComPREPTE(strNumDoc,
  strEspDoc, strCodEmp: String): Boolean;
var
  qryPREPTE: TUniQuery;
  strDocumento: String;
  strCliente: String;
  strVendedor: String;
  strCondPagto: String;
  strFormaPagto: String;
begin
  Result := True;

  if fEmptyStr(strNumDoc) then
    Exit;

  if fEmptyStr(strEspDoc) then
    Exit;

  if fEmptyStr(strCodEmp) then
    Exit;

  if not fCfgSis('ALTPTE', varBoolean) then
    Exit;

  if fVerificaAcessoSistema('ALTPTE') then
    Exit;

  qryPREPTE := fCriaQuery;

  try
    qryPREPTE.Close;
    qryPREPTE.SQL.Clear;
    qryPREPTE.SQL.Add('SELECT F.FGO_NUMDOC, F.FGO_ESPDOC, F.FGO_CODEMP, F.FGO_CODCLI, F.FGO_CODVEN, F.FGO_CONPAG, F.FGO_CODFPG');
    qryPREPTE.SQL.Add('FROM FATGOR F');
    qryPREPTE.SQL.Add('INNER JOIN PREPTE P');
    qryPREPTE.SQL.Add('ON(F.FGO_NUMDOC = P.PRE_NUMDOC AND F.FGO_ESPDOC = P.PRE_ESPDOC AND F.FGO_CODEMP = P.PRE_EMPDOC)');
    qryPREPTE.SQL.Add('WHERE F.FGO_NUMDOC = :NUMDOC');
    qryPREPTE.SQL.Add('AND F.FGO_ESPDOC = :ESPDOC');
    qryPREPTE.SQL.Add('AND F.FGO_CODEMP = :CODEMP');

    qryPREPTE.ParamByName('NUMDOC').AsString := strNumDoc;
    qryPREPTE.ParamByName('ESPDOC').AsString := strEspDoc;
    qryPREPTE.ParamByName('CODEMP').AsString := strCodEmp;

    qryPREPTE.Open;

    if qryPREPTE.IsEmpty then
      Exit;

    strDocumento := Concat(qryPREPTE.FieldByName('FGO_NUMDOC').AsString,'-',qryPREPTE.FieldByName('FGO_ESPDOC').AsString,'-',qryPREPTE.FieldByName('FGO_CODEMP').AsString);
    strCliente := Concat(qryPREPTE.FieldByName('FGO_CODCLI').AsString,'-',fRetNomCliente(qryPREPTE.FieldByName('FGO_CODCLI').AsString));
    strVendedor := Concat(qryPREPTE.FieldByName('FGO_CODVEN').AsString,'-',fRetNomVendedor(qryPREPTE.FieldByName('FGO_CODVEN').AsString));
    strCondPagto := Concat(fFormataCondPag(qryPREPTE.FieldByName('FGO_CONPAG').AsString));
    strFormaPagto := Concat(qryPREPTE.FieldByName('FGO_CODFPG').AsString,'-',fRetDesFpg(qryPREPTE.FieldByName('FGO_CODFPG').AsString));

    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Permitir alterar Orçamento/Pedido originado a partir da Preparação de Transferência de Estoque!');
    objLiberacao.objMsgLibera.pAddSeparador(95);
    objLiberacao.objMsgLibera.pAddTextoCaption('Pedido', strDocumento, 12);
    objLiberacao.objMsgLibera.pAddTextoCaption('Cliente', strCliente, 12);
    objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor', strVendedor, 12);
    objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto.', strCondPagto, 12);
    objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pagto.', strFormaPagto, 12);
    objLiberacao.objMsgLibera.pAddSeparador(95);

    objLiberacao.strDirAce := 'ALTPTE';
    objLiberacao.strMsgSen := 'Permitir alterar Orçamento/Pedido originado a partir da Preparação de Transferência de Estoque!';
    objLiberacao.strCodOpe := strLoginUsuarioLogado;

    Result := objLiberacao.fLibera;
  finally
    FreeAndNil(qryPREPTE);
  end;
end;

function TfrmFatVendas.fPermiteAlteracaoValorContabilComAdiantamento: Boolean;
var
  LVlrAdiant : Double;

begin
  Result := True;

  If (TAdiantamento.fPermiteAlterarPedidoComAdiantamento = papSimTodosOsCamposComExigenciaQueOValorFiqueOMesmo) and (not fatVenda.fPedidoComPixPagoLiberadoParaAlteracao) Then
  Begin
    If (Not fEmptyStr(strNumOrc)) And (strOpcDoc = 'PD') Then
    Begin
      LVlrAdiant := TAdiantamento.fGetTotaisAdiantamento(strNumOrc,
                                                         strEspOrc,
                                                         strEmpOrc).fltValLan;
      If (LVlrAdiant > 0) Then
      Begin

        If (fFormataFloat(fStrToFloat(edtTotImp.Text), 2) <> fFormataFloat(qryFatGor.FieldByName('FGO_VLRCON').AsFloat, 2)) Then
        Begin
          if (fCfgSis('SSLAPA', varBoolean)) then
          begin
            if not fLiberouAltValorContabilPedidoComAdiantamento(fatVenda.strCodCli, strNumOrc+'-'+strEspOrc+'-'+strEmpOrc, fatVenda.dtaPreVis, fFormataFloat(qryFatGor.FieldByName('FGO_VLRCON').AsFloat, 2), fFormataFloat(fStrToFloat(edtTotImp.Text), 2), LVlrAdiant) then
              Result := False;
          end
          else
          begin
            fMensagem('Atenção','Esse pedido contém adiantamento!' + #13 + 'Seu valor contábil deve permanecer o mesmo!', ['&OK']);
            Result := False;
          end;
        End;

        If (fatVenda.fHaveraDesmembramentoVenda) Then
        Begin
          fMensagem('Atenção','Esse pedido contém adiantamento!' + #13 + 'O pedido não poderá ser desmembrado, verifique!', ['&OK']);
          Result := False;
        End;

      End;
    End;
  End;
end;

function TfrmFatVendas.fTravaCondicaoDePagamentoEmCampanha: Boolean;
var
  intContador: Integer;
begin
  Result := False;

  For intContador := 0 To Length(fatVenda.arrMatItens) -1 Do
  Begin
    If (Not fEmptyStr(fatVenda.arrMatItens[intContador].strCodCmg)) And
       (Not fatVenda.objCamGer.fConfirmaCondPagCampanha(fatVenda.arrMatItens[intContador].strCodCmg,
                                                       fatVenda.FCodCnd,
                                                       fatVenda.FCodFpg)) Then
    Begin
      Result := True;
      Break;
    End;

  End;

end;

