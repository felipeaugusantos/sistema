procedure TfrmFatVendas.pMostraLimiteCredito;
begin

  if strOpcDoc = 'ER' then
    Exit;

  If (strOpcDoc = 'BR') And
     fClienteProfissional(edtCodCli.Text) And
     fMostraCreditoComPortador(edtCodCli.Text, blnUsaEmpOri)  and
     (fCfgSis('TCOPRO') = '1') And
     (fCfgSis('EXTOSA', varBoolean)) Then
  Begin
    lblLimite.Visible := False;
    edtLimCre.Visible := False;
    edtTotCre.Visible := True;
    lblTotCre.Visible := True;
    lblTotCre.Caption := 'Total do Saldo:';
    edtTotCre.Text    := FormatFloat('#,##0.00', fTotalCreditosProfissional(edtCodCli.Text));
  End
  Else
  If (fCfgSis('LIMISN') <> 'N') And (fCfgSis('EXLICR',varBoolean)) Then
  Begin
    If (strOpcDoc <> 'DV') Then
    Begin

      If fVerificaAcessoSistema('EXLICR') Then
      Begin
        lblLimite.Visible := True;
        edtLimCre.Visible := True;
        edtLimCre.Text    := FormatFloat('#,##0.00', fLimiteCreditoCliente(qryConCli.FieldByName('CLI_CODCLI').AsString) - fatVenda.fltTotDeb);
      End;

    End;

    If fCfgSis('EXICRE', varBoolean) Then
    Begin
      lblTotCre.Visible := True;
      lblTotCre.Caption := 'Total dos Créditos:';
      edtTotCre.Visible := True;

