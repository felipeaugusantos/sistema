                  'Isso porque, quando a remessa foi feita a tinta já estava '+
                  'batida e sendo assim, já deveria ter sido solicitado '+
                  'abastecimento da filial antes da rotina "venda fora do '+
                  'estabelecimento - remessa". Depois, na rotina de remessa deve '+
                  'ser escolhido produto acabado.'+#13#10+
                  'Nesse caso para faturar, altere o pedido de venda para produção '+
                  'fora de loja = Não para poder continuar com o faturamento.',
                  0, (196 + (9 * Self.Canvas.TextWidth('X'))));

      fatVenda.blnFecharForm := True;

      Exit;
    End;

    strVenAnt := qryFatGor.FieldByName('FGO_CODVEN').AsString;

    If blnHerancaOrcamentoPedido Then
      fatVenda.blnVerEstOrc := False;

    If blnExibeSaldoGrid Then
    Begin
      thrCarregarSaldoEmpresasGrid := TThreadCarregarSaldoEmpresasGrid.Create(True);
      thrCarregarSaldoEmpresasGrid.Start;
    End;

    Try
      pCriarFormularios(TfrmGravando, LfrmGravando);
      LfrmGravando.fExecutarAcao := fCarregaPedidoOrcamento;
      LfrmGravando.ShowModal;
      blnFecharForm := Not LfrmGravando.blnConfirma;

      {Req.: 111192 - Retorna "blnVerEstOrc = True", para "travar/avisar" itens sem saldo no [F10]!}
      If blnHerancaOrcamentoPedido Then
        fatVenda.blnVerEstOrc := True;

    Except
