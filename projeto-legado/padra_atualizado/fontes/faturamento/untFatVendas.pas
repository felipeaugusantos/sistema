procedure TfrmFatVendas.pCalculaSaldoPigmento;
Var
  strEmpSalRes : String;
begin
  If Not blnCalcQtdPigmento Then
    Exit;

  strEmpSalRes := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

  If (Not blnSaldoAntPigmento) Then
  Begin
    fltSaldoAntPigmento := fltSaldoItemAtu;
    blnSaldoAntPigmento := True;
  End;

  fltSaldoItemAtu := fltSaldoAntPigmento + fRetornaSaldoGramas(edtCodIte.Text, strEmpSalRes);

  edtSalDis.Text  := FormatFloat('#,##0.00', (fltSaldoItemAtu - fltSaldoResItemAtu) - fltQtdeDigitada);
  pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
  pHintSaldoDisponivel;
end;

procedure TfrmFatVendas.pAtualizaUnitarioAparelBenefi;
  Var
    fltUnitario: Double;
begin
  inherited;
  If Not fEmptyStr(edtCodIte.Text) Then
  Begin
    fltUnitario := fStrToFloat(edtUnitar.Text);
    fltUnitario := fltUnitario + fatVenda.fRetornaVrAcrescApaBen(fltUnitario, fStrToFloat(edtPerApa.Text), fStrToFloat(edtPerBen.Text));
    edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUnitario);
  End;
  pAtualizaUnitarioLiquido;
end;

procedure TfrmFatVendas.pAtualizaUnitarioComLiquido;
  Var
    intIteracoes: Integer;
    fltLimiteInferior: Double;
    fltLimiteSuperior: Double;
    fltValorDesejado: Double;
begin
  If Not Assigned(fatVenda) Then
    Exit;

  fltLimiteInferior := 0.0;
  fltLimiteSuperior := Max(fStrToFloat(edtUnitar.Text), fStrToFloat(edtUniLiq.Text)) * 100;
  fltValorDesejado  := fStrToFloat(edtUniLiq.Text);

  FBuscandoUnitarioLiquido := True;
  Try
    For intIteracoes := 1 To 100 Do
    Begin
      edtUnitar.Text := FormatFloat(edtUniTar.EditFormat, (fltLimiteInferior + fltLimiteSuperior) / 2);

      pAtualizaUnitarioLiquido;

      If FormatFloat(edtUniLiq.EditFormat, fltValorDesejado) = edtUniLiq.Text Then
        Break;

      If fStrToFloat(edtUniLiq.Text) < fltValorDesejado Then
      Begin
        If fStrToFloat(edtUnitar.Text) = fltLimiteInferior Then
          Break;

        fltLimiteInferior := fStrToFloat(edtUnitar.Text);
      End
      Else
      Begin
        If fStrToFloat(edtUnitar.Text) = fltLimiteSuperior Then
          Break;

        fltLimiteSuperior := fStrToFloat(edtUnitar.Text);
      End
    End;
  Finally
    FBuscandoUnitarioLiquido := False;
  End;

  pAtualizaUnitarioComImpostos;

end;

procedure TfrmFatVendas.pAtualizaUnitarioComImpostos;
  Var
    objTotalDesejadoDoItem : TTotalDesejadoDoItem;
    fltUniLiq : Double;
begin
  If (Not Assigned(fatVenda)) Or (Not edtUnitComImpostos.Visible) Then
    Exit;

  If FBuscandoUnitarioLiquido Then
    Exit;
  If fEmptyStr(edtCodIte.Text) Or fEmptyStr(edtUnitar.Text) Then
  Begin
    edtUnitComImpostos.Clear;
    Exit;
  End;

  // Item ainda nao carregado (ex.: AfterScroll do grid): o pAtualizaDados preenche pelo cdsVenda
  If Not fItemSelecionadoCarregado(edtCodIte.Text) Then
    Exit;
  fltUniLiq := fStrToFloat(edtUniLiq.Text);
  If (fltUniLiq <= 0) Then
  Begin
    edtUnitComImpostos.Text := FormatFloat(edtUnitComImpostos.EditFormat, 0);
    Exit;
  End;

  objTotalDesejadoDoItem := TTotalDesejadoDoItem.Create(fCalcularImpostosItemSelecionado);
  Try
    edtUnitComImpostos.Text := FormatFloat(edtUnitComImpostos.EditFormat, objTotalDesejadoDoItem.CalcularValorFinalDoItem(fltUniLiq));
  Finally
    FreeAndNil(objTotalDesejadoDoItem);
  End;
end;

procedure TfrmFatVendas.pAtualizaUnitarioComValorComImpostos;
  Var
    objTotalDesejadoDoItem : TTotalDesejadoDoItem;
    fltUniLiq : Double;
begin
  If Not Assigned(fatVenda) Then
    Exit;

  objTotalDesejadoDoItem := TTotalDesejadoDoItem.Create(fCalcularImpostosItemSelecionado);
  Try
    fltUniLiq := objTotalDesejadoDoItem.ValorDesejadoConsiderandoImpostos(fStrToFloat(edtUnitComImpostos.Text), fatVenda.VS_intDecUni);
  Finally
    FreeAndNil(objTotalDesejadoDoItem);
  End;

  edtUniLiq.Text := FormatFloat(edtUnitar.EditFormat, fltUniLiq);

  If fUtilizaCampoUnitarioLiquido Then
    pRecalculaAtualizaDescontoItem
  Else
    pAtualizaUnitarioComLiquido;

  pRecalculaTotalItem;
end;

function TfrmFatVendas.fUnitarioComImpostosFoiAlterado : Boolean;
  Var
    objTotalDesejadoDoItem : TTotalDesejadoDoItem;
    fltUniLiq : Double;
begin
  Result := True;

  If (Not Assigned(fatVenda)) Or (Not fItemSelecionadoCarregado(edtCodIte.Text)) Then
    Exit;

  fltUniLiq := fStrToFloat(edtUniLiq.Text);
  If (fltUniLiq <= 0) Then
    Exit;

  objTotalDesejadoDoItem := TTotalDesejadoDoItem.Create(fCalcularImpostosItemSelecionado);
  Try
    Result := (FormatFloat(edtUnitComImpostos.EditFormat, objTotalDesejadoDoItem.CalcularValorFinalDoItem(fltUniLiq)) <>
               FormatFloat(edtUnitComImpostos.EditFormat, fStrToFloat(edtUnitComImpostos.Text)));
  Finally
    FreeAndNil(objTotalDesejadoDoItem);
  End;
end;

