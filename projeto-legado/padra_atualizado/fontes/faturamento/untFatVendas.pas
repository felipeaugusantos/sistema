procedure TfrmFatVendas.pMostraTravaGrupoFreteDiferente(strDocDev, strEspDev,
  strEmpDev, strFreDev: string);
var
  strMensagem: string;
  intTipFre: integer;
  frmObservacaoLocal: TfrmObservacao;
begin
  strMensagem := 'ATENÇÃO! O sistema está configurado para considerar o tipo do frete do documento na geração do crédito do contas a receber' +sLineBreak+
                 'da devolução (CFG_FRDVES). Sendo assim, não é permitido selecionar documentos com tipo de frete diferentes. Neste caso, será'+sLineBreak+
                 'preciso fazer duas devoluções.'+sLineBreak+sLineBreak+
                 'Documentos selecionados:'+sLineBreak;

  cdsVenda.First;
  while not cdsVenda.Eof do
  begin
    intTipFre := fBuscaTipoFrete(cdsVenda.FieldByName('ITE_DOCDEV').AsString, cdsVenda.FieldByName('ITE_ESPDEV').AsString, cdsVenda.FieldByName('ITE_EMPDEV').AsString, cdsVenda.FieldByName('ITE_AIDVOR').AsString);
    strMensagem := strMensagem + sLineBreak + cdsVenda.FieldByName('ITE_DOCDEV').AsString +' - '+ cdsVenda.FieldByName('ITE_ESPDEV').AsString +' - '+ cdsVenda.FieldByName('ITE_EMPDEV').AsString +' - Tipo de Frete: '+ fDescricaoFrete(IntToStr(intTipFre));
    cdsVenda.Next;
  end;
  cdsVenda.First;

  strMensagem := strMensagem + sLineBreak + strDocDev +' - '+ strEspDev +' - '+ strEmpDev +' - Tipo de Frete: '+ fDescricaoFrete(strFreDev);

  pCriarFormularios(TfrmObservacao, frmObservacaoLocal);

  try
    frmObservacaoLocal.lblMensagem.caption := 'Trava Frete';
    frmObservacaoLocal.memObs.Texto := strMensagem;
    frmObservacaoLocal.ShowModal;
  finally
    pFreeAndNil(frmObservacaoLocal);
  end;

end;

procedure TfrmFatVendas.pVerificaAlterarVendedor(strCodVendedor, strCodRepres: String; blnAlteraVendedorSugestao : Boolean = False);
Begin

  If (Not fPermiteAlterarVendedor) Then
  Begin
    If (fCfgSis('VENESP') <> strCodVendedor) Then
    Begin
      edtSenVen.ReadOnly := True;

      If (Not fCfgSis('USADIG', varBoolean)) Then
        edtSenVen.Text := fRetSenhaVendedor(strCodVendedor)
      Else
        edtSenVen.Text := strCodVendedor;

      edtNomVen.Text := fRetNomVendRep(strCodVendedor);
    End;
  End
  Else If (pnlVendedor.Visible) And (fEntraNaRegraDeFidelizacao) Then
    edtSenVen.ReadOnly := False;

  If (blnAlteraVendedorSugestao) And
     (fCfgSis('VENDE1', varBoolean)) And
     (Not fCfgSis('USADIG', varBoolean)) And
     (Pos(strOpcDoc, 'OR_PD_VN_') > 0)  And
     (Not blnCarregouSenhaVendedorAutomaticamente) And
     (fVendedorPermitido(fatVenda.strCodCli, strLoginUsuarioLogado)) Then
  Begin
    edtSenVen.Text := fRetSenhaVendedor(strLoginUsuarioLogado);
    edtNomVen.Text := fRetNomVendRep(edtSenVen.Text);
  End;

  {********************************}
  {* CARREGAR SEMPRE O VENDEDOR 2 *}
  {*****************************FS*}
  edtCodRep.ReadOnly := (Not fCfgSis('ALTVE2', varBoolean));
  edtCodRep.TabStop  := (Not edtCodRep.ReadOnly);

  If pnlRepresentante.Visible Then
  Begin
    edtCodRep.Text := IIF(strCliAnt <> edtCodCli.Text, strCodRepres, fatVenda.strCodVe2);
    edtDesRep.Text := fRetNomVendRep(edtCodRep.Text);
    strRepAnt := edtCodRep.Text;
  End;
End;

