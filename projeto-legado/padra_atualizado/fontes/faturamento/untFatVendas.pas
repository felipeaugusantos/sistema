procedure TfrmFatVendas.edtUnidadKeyPress(Sender: TObject; var Key: Char);
var
  chrKey: Char;
  arrUnidades: TConsultasArray;
  strUnidAnt : String;
begin
  If (edtUnidad.ReadOnly) Then
  Begin
    Key := #0;
    Exit;
  End;

  inherited;
  strUnidAnt := edtUnidad.Text;

  {*****************************}
  {* NOVA CONSULTA DE UNIDADES *}
  {**************************AC*}
  chrKey := Key;
  if fPesqUnidade(Self, edtUnidad, Nil, edtSigla, qryCadUni, chrKey, arrUnidades) then
  begin
    If strUnidAnt <> edtUnidad.Text Then
      pHabilitarMetragem(edtCodIte.Text, edtUnidad.Text);

    If fValidaCampos(edtUnidad, True) Then
      SelectNext(ActiveControl, True, True);
  end;

end;

