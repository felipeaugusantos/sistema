function TfrmFatVendas.fCarregaDocumentoHerancaFaturamento(qryDocHer: TUniQuery): Boolean;
begin
  Result := True;

  If (Pos(strOpcDoc, 'OU_TE_') > 0) And
     (Assigned(qryDocHer))          Then
  Begin
    Try
      pCriarFormularios(TfrmGravando, frmGravando);
      frmGravando.fExecutarAcao := fCarregaItensHerancaFaturamento;
      frmGravando.ShowModal;
      Result := frmGravando.blnConfirma;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '');
      End;
    End;

    pFreeAndNil(frmGravando);
  End;
end;

function TfrmFatVendas.fCarregaItensHerancaFaturamento(pgbStatus: TcxProgressBar = Nil): Boolean;
  procedure pInformacao(strMsg: String);
  begin
    If Assigned(pgbStatus) Then
      TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')).Caption := strMsg;
    pProcessMessages;
  end;

  procedure pProgress(intPos, intMax: Integer);
  Begin
    If Assigned(pgbStatus) Then
    Begin
      pgbStatus.Properties.Max := intMax;
      pgbStatus.Position := intPos;
      pProcessMessages;
    End;
  End;
Begin
  Result := True;

  Try
    With frmHerancaFaturamento.qryDoc Do
    Begin
      pInformacao('Carregando Produtos, Aguarde....');

      First;

      While Not Eof Do
      Begin
        pInformacao('Aguarde... Carregando Produtos ' + intToStr(RecNo) + '/' + intToStr(RecordCount));

        pProgress(frmHerancaFaturamento.qryDoc.RecNo,
                  frmHerancaFaturamento.qryDoc.RecordCount);

        fIncluirItem(FieldByName('DET_CODITE').AsString,
                     FieldByName('DET_NUMLOT').AsString,
                     FieldByName('DET_QTDITE').AsFloat,
                     0);

        Next;
      End;
    End;
  Finally
    FreeAndNil(frmHerancaFaturamento.qryDoc);
  End;
End;


function TfrmFatVendas.fCarregaOrdemServicoVenda(strCodIte, strGrupo: String;
  intSeqInd: Integer; AEditar: Boolean = False): Boolean;
begin
  Result := False;

  Try
    If (btnAdicionar.Tag <= 0) Then
    Begin
      fatVenda.objOrdSer.strNumDoc := strNumOrc;
      fatVenda.objOrdSer.strEspDoc := strEspOrc;
      fatVenda.objOrdSer.strCodEmp := VS_strCodEmp;
    End
    Else
    Begin
      If AEditar And (fEmptyStr(cdsVenda.FieldByName('ITE_EMPORC').AsString)) Then
      Begin
        fatVenda.objOrdSer.strCodEmp := VS_strCodEmp;
      End
      Else
      Begin
        fatVenda.objOrdSer.strNumDoc := cdsVenda.FieldByName('ITE_NUMORC').AsString;
        fatVenda.objOrdSer.strEspDoc := cdsVenda.FieldByName('ITE_ESPORC').AsString;
        fatVenda.objOrdSer.strCodEmp := cdsVenda.FieldByName('ITE_EMPORC').AsString;
      End;
    End;

    fatVenda.objOrdSer.strCodCli := fatVenda.strCodCli;
    fatVenda.objOrdSer.strCodIte := strCodIte;
    fatVenda.objOrdSer.strCodGru := strGrupo;

    If (Not AEditar) Then
    Begin
      fatVenda.objOrdSer.intSeqInd := fatVenda.objOrdSer.fGetSeqInd();
    End
    Else
    Begin
      fatVenda.objOrdSer.intSeqInd := intSeqInd;
    End;

    fatVenda.objOrdSer.blnTrava := ((Not fEmptyStr(strNumOrc)) And (strEspOrc = 'PD'));
    Result := fatVenda.objOrdSer.fAdicionarItemOrdemServico(AEditar);

    If Result Then
    Begin
      edtQtdIte.Text    := fatVenda.objOrdSer.strTotGerM2;
      edtQtdIte.Enabled := False;
    End
    Else
    Begin
      btnCancelaItem.Click;
      pSetFocus(dbgItens);
    End;

    fatVenda.objOrdSer.pAtualizaDados('','','','',0,False);

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message,'[TfrmFatVendas.fCarregaOrdemServicoVenda]');
    end;

  End;
end;

