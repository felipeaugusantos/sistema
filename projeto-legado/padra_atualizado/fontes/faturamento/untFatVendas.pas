procedure TfrmFatVendas.FormClose(Sender: TObject; var Action: TCloseAction);
  Var
    strSenha : String;
    frmRcxDigCartoes : TfrmRcxDigCartoes;

begin
  inherited;

  If Not ValidarSeExistePixRecebidoSemConfirmacao Then
  Begin
    Action := caNone;
    Exit;
  End;

  If (fPodeValidarAoFecharForm) And
     (Pos(strOpcDoc,'CF_CT_CP_OV_CI_CN_') <= 0) Then
  Begin

    If Not fEmptyStr(fCfgSis('SENSAV')) Then
    Begin

      If ffrmSenha(strSenha,'Venda iniciada') Then
      Begin

        If strSenha <> fCfgSis('SENSAV') Then
        Begin
          fMensagem('','Senha incorreta!',['&OK']);
          Action := caNone;
          Exit;
        End;

      End
      Else
      Begin
        Action := caNone;
        Exit;
      End;

    End;

    If 'PD_OR_VN_'.Contains(strOpcDoc) Then
      If fCfgSis('PERSAV',VarBoolean) Then
        If fPergunta('Salvar esta venda para ser restaurada mais tarde?') Then
          fatVenda.objCopiaSegVenda.ExcluirTabelasAoFinalizar := False;
  End;

  If Action = caNone Then
  Begin
    Exit;
  End;

  dbgItens.OnEnter := Nil;
  dbgItens.Enabled := False;

  FreeAndNil(fatVenda.objCopiaSegVenda);

  pEsvaziaArrayCfgDes;

  TEventosCadPro.fncUFDestTrib := nil;
  TEventosCadPro.fncUFEmpresa := nil;
  TEventosCadPro.fncPegaPrecoVenda := nil;
  TEventosCadPro.fncPegaIcmsSai := nil;
  TEventosCadPro.fncGetUnitarioEmbalagemFechada := nil;
  TEventosCadPro.fncOpcDoc := nil;
  TEventosCadPro.fncQueryEmCacheTrouxeAlgumRegistro := nil;
  TEventosCadPro.stlItensTemPromocao := Nil;
  TEventosCadPro.stlLinhaGrupoUnidadeEmPromocaoKit := Nil;

  pApagaLogVarNaoUtilizado(fatVenda.stlNumLib,arrLogLib);
  SetLength(arrLogLib, 0);
  SetLength(arrLogAvi, 0);
  SetLength(arrLogAviAux, 0);

  pZeraDigDuplic(fatVenda.arrDuplicata);

  If Assigned(qryTinta) Then
  Begin
    qryTinta.Close;
    FreeAndNil(qryTinta);
  End;

  FreeAndNil(lstOrdemProd);
  FreeAndNil(lstProdCampanha);
  FreeAndNil(lstProdBonus);

  If Assigned(stlFormulacaoBaixada) Then
    FreeAndNil(stlFormulacaoBaixada);

  If Assigned(stlFormulacaoEtiImpressa) Then
    FreeAndNil(stlFormulacaoEtiImpressa);

  If fatVenda.fEhAutocenter Then
    fatVenda.pLiberaLockedPrismas;

  If Pos(strOpcDoc, 'CF_CI_CN_CP_CT_OV_') > 0 Then
  Begin
    fatVenda.objLock.pDestravarTodos;
  End;

  FreeAndNil(qryConDev);
  FreeAndNil(qryConAbf);
  FreeAndNil(qryConCnd);
  FreeAndNil(qryConCli);
  FreeAndNil(qryConFpg);
  FreeAndNil(qryConOpe);
  FreeAndNil(qryFatDor);

  cdsVenda.BeforePost := Nil;
  {*****************************************}
  {* IRÁ LIBERAR SOZINHO.                  *}
  {**************************************MV*}
  {********************************************************************}
  {* VOLTEI A LIBERAR DA MEMORIA PORQUE NÃO ESTAVA LIBERANDO SOZINHO. *}
  {* ACONTECIA DE FAZER UM PEDIDO E DEPOIS IR NO F11 PARA FATURAR.    *}
  {* QUANDO TENTAVA DAR FREEANDNIL NO F11 ACONTECIA ACCESS VIOLATION  *}
  {*****************************************************************PZ*}
  pFreeCdsVenda;

  If Assigned(stlForPag) Then
    FreeAndNil(stlForPag);

  If Assigned(stlCndPag) Then
    FreeAndNil(stlCndPag);

  If Assigned(cdsIteDesEmb) Then
    FreeAndNil(cdsIteDesEmb);

  If Assigned(dicInfIte) Then
  Begin
    dicInfIte.Limpar;
    FreeAndNil(dicInfIte);
  End;

  If Assigned(FVariaveisFechamentoVenda) Then
  Begin
    SetLength(FVariaveisFechamentoVenda.arrOpcoes, 0);
    FreeAndNil(FVariaveisFechamentoVenda);
  End;

  TProQtdColetiva.pLimpar;
  TProQtdColetiva.cdsDadosPromocaoKit := nil;

  fatVenda.pInsereVendasPerdidas(true);

  If strOpcDoc = 'CT' Then
    fatVenda.objLock.pDestravarTodos;

  if Assigned(fatVenda.objTefRecebimento) then //'TEFVN_'
  Begin
    Try
      pCriarFormularios(TfrmRcxDigCartoes, frmRcxDigCartoes);
      frmRcxDigCartoes.pCancelarTefDeCartoesJaConfirmados(fatVenda.objTefRecebimento,
                                                          fatVenda.arrCartoes);
    Finally
      pFreeAndNil(frmRcxDigCartoes);
    End;
  End;

  if ckbAbCrAu.Enabled then
  begin
    pTravaDestravaCredito(False, edtCodCli.Text);
    fatVenda.objLock.pDestravarTodos;
  end;

  blnFaturarF11Finalizar := blnConfirmouOperacao And fAbrirDocumentoCarregadoF11();

  If (fCfgSis('TPFCCX') = 'C') Then
    blnFaturarF11Finalizar := blnFaturarF11Finalizar And fCaixaOperadorPertenceEmpresaLogada(IIF(fCfgSis('USADIG', VarBoolean), fatVenda.strCodDig, fatVenda.strCodVen));

  If ((Pos(fatvenda.strCodFpg, '008_014_015') > 0) And (fatVenda.blnMulLoj Or fatVenda.blnEnt_CD)) Then
    blnFaturarF11Finalizar := False;

  If blnFaturarF11Finalizar Then
  Begin
    strCodDigGravado := fatVenda.strCodDig;
    strCodVenGravado := fatVenda.strCodVen;
    strNumDocGravado := fatVenda.strNumDoc;
    strCodEmpGravado := fatVenda.strPedEmp;
    strAutoIncPedidosGerados  := fatvenda.strAutoIncPedidosGerados;
  End;


  If (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) Then
    fGetFuncoesCitelGrid.pSalvarView(dbgItens, fGetChaveLayoutGrid);

  If Assigned(fatVenda) Then
    FreeAndNil(fatVenda);

  If Assigned(objEstruturaPersonalizada) Then
    FreeAndNil(objEstruturaPersonalizada);

  FreeAndNil(dicRetorno);

  untFuncFat.strOpcDocUntFuncFat := '';

  FreeAndNil(FFechamentoVendaObservers);

  If Assigned(objPromVlrMinTotalProdutos) Then
    objPromVlrMinTotalProdutos.pLimpar;

end;

function TfrmFatVendas.fGetChaveLayoutGrid: String;
begin
  Result := Self.Name + '.' + dbgItens.Name;
end;

function TfrmFatVendas.fAbrirDocumentoCarregadoF11(): Boolean;
  Var
    strF11FPG : String;
begin
  Result := False;

  If Not fCfgSis('F11FPD', varBoolean) Then
    Exit();

  If (Pos(fCfgSis('ESPCFO', varString), 'PD_OR_') <= 0) Then
    Exit();

  If (Pos(fatVenda.strEspDoc, 'PD_OR_') <= 0) Then
    Exit();

  If (fCfgSis('ESPCFO', varString) = 'PD') And (fatVenda.strEspDoc = 'OR') Then
    Exit();

  If (fatVenda.strEspDoc = 'PD') And (fCfgSis('BOLADT', varBoolean)) And (fatVenda.fltBolAdt > 0) Then
    Exit();

  If Not (fatVenda.strEmpDoc = VS_strCodEmp) Then
    Exit();

  If Not fEmptyStr(fatVenda.strSeqDmp) Then
    Exit();

  If fClienteFilial(fatVenda.strCodCli) Then
    Exit();

  If Not fVerificaAcessoSistema('RCXF11') Then
    Exit();

  strF11FPG := fCfgSis('FPGF11', varString);

  If (Not strF11FPG.IsEmpty) Then
  Begin
    If (Pos(fatVenda.strCodFpg, strF11FPG) <= 0) Then
      Exit();
  End;

  Result := True;
end;

procedure TfrmFatVendas.pMostraObsCliente;
begin
  if (Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0) and
     (not fCfgSis('EXBOBS', varBoolean)) then
    Exit;

  {*****************************************}
  {* SE ESTIVER TUDO EM BRANCO, SAI        *}
  {**************************************MV*}
  If (fEmptyStr(qryConCli.FieldByName('CLI_OBSERV').AsString)) Then
    Exit;

  {*****************************************}
  {* REMESSA POR CONTA E ORDEM E REMESSA DE*}
  {* MERCADORIA FALTANTE NÃO MOSTRA OBS.   *}
  {**************************************MV*}
  If (Pos(fatVenda.strOpcDoc, 'CO_MF_') > 0) Then
    Exit;

  Try
    pCriarFormularios(TfrmFatMostraObsCliente, frmFatMostraObsCliente);
    frmFatMostraObsCliente.memObserv.Texto := qryConCli.FieldByName('CLI_OBSERV').AsString;
    frmFatMostraObsCliente.strCodCli       := qryConCli.FieldByName('CLI_CODCLI').AsString;
    frmFatMostraObsCliente.showModal;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[pMostraObsCliente]');
  End;

  pFreeAndNil(frmFatMostraObsCliente);

end;

procedure TfrmFatVendas.pMostraOcultaFechamentoComDesconto(const blnMostrar: Boolean);
begin
  If btnPopMenu.Visible = blnMostrar Then
    Exit;

  btnPopMenu.Visible := blnMostrar;

