                                                                   IIF( not fCfgSis('CLPVDI', varBoolean), fatVenda.fGetAlqFcpIcms(qryIteDoc.FieldByName('DET_CODITE').AsString, '', qryItens_.FieldByName('ABF_CODABF').AsString, qryIteDoc.FieldByName('DET_CODFIS').AsString, fatVenda.fRetIcmSai(qryItens_.FieldByName('ITE_ICMSAI').AsFloat), qryIteDoc.FieldByName('DET_UNITAR').AsFloat ),0),
