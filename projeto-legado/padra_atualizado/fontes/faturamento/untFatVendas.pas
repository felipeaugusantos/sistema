  pFinalizarTimerAtualizarImpostosNaConsultaTab;
End;

function TfrmFatVendas.fImportaItensDeOutroDocumento(AstrIdFATGORSelecionados,
                                                     AstrIdMOVGERSelecionados,
                                                     AstrIdNOTGERSelecionados : String;
                                                     tpPrecoImpItem           : TTipoPrecoImpItem;
                                                     AblnAgruparItens         : Boolean;
                                                     AblnOrdemOriginal        : Boolean;
                                                     AblnCarregarAmbiente     : Boolean): Boolean;
  Var
    strTabDet, strPrefixoDet, strNumLot : String;
    qryDet, 
    qryDev, 
    qryCnf: TUniQuery;

    objCadLot : TCadLot;

    LstrIDEPROItemImportacao,
    LstrITETINItemImportacao : String;
    LcdsItensAImportar : TUniClientDataSet;

    fltVlrIte,
    fltDesIte : Double;

    strCodIteLisOrc: String;
    stlCodIteCodEmp: TStringList;
    blnAchouRegistro: Boolean;

begin

  Result := True;
  qryDet := fCriaQuery();
  qryDev := fCriaQuery();
  qryCnf := fCriaQuery();

  blnImportandoItensDeOutroDocumento := True;

  Try
    qryDet.Sql.Add('SELECT * FROM ( ');

    strPrefixoDet := 'FDO_';
    strTabDet     := 'FATDOR';
    qryDet.Sql.Add(fSQLDet(AstrIdFATGORSelecionados, strPrefixoDet, strTabDet, tpPrecoImpItem));

    strPrefixoDet := 'DET_';
    strTabDet     := 'MOVDET';
    qryDet.Sql.Add(' UNION ALL ');
    qryDet.Sql.Add(fSQLDet(AstrIdMOVGERSelecionados, strPrefixoDet, strTabDet, tpPrecoImpItem));

    strPrefixoDet := 'DET_';
    strTabDet     := 'NOTDET';
    qryDet.Sql.Add(' UNION ALL ');
    qryDet.Sql.Add(fSQLDet(AstrIdNOTGERSelecionados, strPrefixoDet, strTabDet, tpPrecoImpItem));

    if (AblnOrdemOriginal) then
      qryDet.Sql.Add(') TAB ORDER BY CODEMP, ESPDOC, NUMDOC, AUTOINCREM ')
    else
      qryDet.Sql.Add(') TAB ORDER BY CODITE, DESCRI ');

    qryDet.Open;

    If qryDet.IsEmpty Then
    Begin
      pMensagemOk(MSG_IMPORTACAO);
      Result := False;
      Exit;
    End;

    If (Not dbgItens.DataSource.DataSet.IsEmpty) And
       (fMensagem('Pergunta', 'Existem itens inseridos no documento. Deseja excluí-los?', ['&Sim', '&Não'], 2) = 1) Then
    Begin
      dbgItens.DataSource.DataSet.Last;
      While (Not dbgItens.DataSource.DataSet.IsEmpty) And
            (Not dbgItens.DataSource.DataSet.Bof) Do
      Begin
        If Not fDeletaItem Then
          dbgItens.DataSource.DataSet.Prior;
      End;
      pCalculaTotais;
    End;

    qryDev.Close;
    qryDev.SQL.Clear;
    qryDev.SQL.Add('SELECT DET_IDEPRO AS IDEPRO, ');
    qryDev.SQL.Add('       DET_ITETIN AS ITETIN  ');
    qryDev.SQL.Add('FROM MOVDET ');
    qryDev.SQL.Add(' WHERE ');
    qryDev.SQL.Add('DET_NUMDOC = :NUMDOC AND ');
    qryDev.SQL.Add('DET_ESPDOC = :ESPDOC AND ');
    qryDev.SQL.Add('DET_CODEMP = :CODEMP AND ');
    qryDev.SQL.Add('DET_CODACA = :CODACA AND ');
    qryDev.SQL.Add('DET_EMPACA = :EMPACA ');

    qryCnf.Close;
    qryCnf.SQL.Clear;
    qryCnf.SQL.Add('SELECT DET_IDEPRO AS IDEPRO, ');
    qryCnf.SQL.Add('       DET_ITETIN AS ITETIN, ');
    qryCnf.SQL.Add('       DET_NUMDOC AS DOCCNF, ');
    qryCnf.SQL.Add('       DET_ESPDOC AS ESPCNF, ');
    qryCnf.SQL.Add('       DET_CODEMP AS EMPCNF  ');
    qryCnf.SQL.Add('FROM MOVDET ');
    qryCnf.SQL.Add(' WHERE ');
    qryCnf.SQL.Add('AUTOINCREM = :AUTINC ');

    qryDet.First;

    LcdsItensAImportar := fCriaClientDatSet(qryDet, True);

    while not qryDet.eof do
    Begin
      LstrIDEPROItemImportacao := '';
      LstrITETINItemImportacao := '';
      qryDev.Close;
      qryCnf.Close;
      
      {Req.: 152871 - Documento de devolução com tinta, busca dados na venda.}
      if (not fEmptyStr(qryDet.FieldByName('DOCDEV').AsString)) and
         (not fEmptyStr(qryDet.FieldByName('CODACA').AsString)) and
         (qryDet.FieldByName('TABELA').AsString = 'MOVDET') then
      begin
        qryDev.Close;
        qryDev.ParamByName('NUMDOC').AsString := qryDet.FieldByName('DOCDEV').AsString;
        qryDev.ParamByName('ESPDOC').AsString := qryDet.FieldByName('ESPDEV').AsString;
        qryDev.ParamByName('CODEMP').AsString := qryDet.FieldByName('EMPDEV').AsString;
        qryDev.ParamByName('CODACA').AsString := qryDet.FieldByName('CODACA').AsString;
        qryDev.ParamByName('EMPACA').AsString := qryDet.FieldByName('EMPACA').AsString;
        qryDev.Open;

        If (Not qryDev.IsEmpty) Then
        Begin
          if qryDev.FieldByName('IDEPRO').AsString <> 'NOR' then
          begin
            LstrIDEPROItemImportacao := qryDev.FieldByName('IDEPRO').AsString;
            LstrITETINItemImportacao := qryDev.FieldByName('ITETIN').AsString;
          end;
        End;
      end {Req.: 212402 - Documento de confirmação com tinta, busca dados na venda.}
      else if (not fEmptyStr(qryDet.FieldByName('INCCNF').AsString)) and
              (not fEmptyStr(qryDet.FieldByName('CODACA').AsString)) and
              (qryDet.FieldByName('TABELA').AsString = 'NOTDET') then
      begin
        qryCnf.Close;
        qryCnf.ParamByName('AUTINC').AsString := qryDet.FieldByName('INCCNF').AsString;
        qryCnf.Open;

        If (Not qryCnf.IsEmpty) Then
        begin
          if qryCnf.FieldByName('IDEPRO').AsString <> 'NOR' then
          begin
            LstrIDEPROItemImportacao := qryCnf.FieldByName('IDEPRO').AsString;
            LstrITETINItemImportacao := qryCnf.FieldByName('ITETIN').AsString;
          end;
        end;
      end;


      If (AblnCarregarAmbiente) Then
      Begin
        blnAchouRegistro := LcdsItensAImportar.Locate('CODITE;DESCRI;IDEPRO;ITETIN;NUMLOT;COMPLE', VarArrayOf([qryDet.FieldByName('CODITE').AsString,
                                                                                                               qryDet.FieldByName('DESCRI').AsString,
                                                                                                               IIF(fEmptyStr(LstrIDEPROItemImportacao), qryDet.FieldByName('IDEPRO').AsString, LstrIDEPROItemImportacao),
                                                                                                               IIF(fEmptyStr(LstrITETINItemImportacao), qryDet.FieldByName('ITETIN').AsString, LstrITETINItemImportacao),
                                                                                                               qryDet.FieldByName('NUMLOT').AsString,
                                                                                                               qryDet.FieldByName('COMPLE').AsString]), []);
      End
      Else
      Begin
        blnAchouRegistro := LcdsItensAImportar.Locate('CODITE;DESCRI;IDEPRO;ITETIN;NUMLOT', VarArrayOf([qryDet.FieldByName('CODITE').AsString,
                                                                                                               qryDet.FieldByName('DESCRI').AsString,
                                                                                                               IIF(fEmptyStr(LstrIDEPROItemImportacao), qryDet.FieldByName('IDEPRO').AsString, LstrIDEPROItemImportacao),
                                                                                                               IIF(fEmptyStr(LstrITETINItemImportacao), qryDet.FieldByName('ITETIN').AsString, LstrITETINItemImportacao),
                                                                                                               qryDet.FieldByName('NUMLOT').AsString]), []);
      End;

      if (not blnAchouRegistro) Or (not AblnAgruparItens) then
      Begin

        pCopiaRegistroDataSet(qryDet, LcdsItensAImportar);

        LcdsItensAImportar.Edit;
        LcdsItensAImportar.FieldByName('TOTAL').AsFloat := (LcdsItensAImportar.FieldByName('QTDITE').AsFloat * LcdsItensAImportar.FieldByName('UNIDIG').AsFloat);
        LcdsItensAImportar.Post;

        if not fEmptyStr(LstrIDEPROItemImportacao) then
        Begin
          LcdsItensAImportar.Edit;
          LcdsItensAImportar.FieldByName('IDEPRO').AsString := LstrIDEPROItemImportacao;
          LcdsItensAImportar.Post;
        End;

        if not fEmptyStr(LstrITETINItemImportacao) then
        Begin
          If (Not qryDev.IsEmpty) Then
          Begin
            LcdsItensAImportar.Edit;
            LcdsItensAImportar.FieldByName('NUMDOC').AsString := qryDet.FieldByName('DOCDEV').AsString;
            LcdsItensAImportar.FieldByName('CODEMP').AsString := qryDet.FieldByName('EMPDEV').AsString;
            LcdsItensAImportar.FieldByName('ESPDOC').AsString := qryDet.FieldByName('ESPDEV').AsString;
            LcdsItensAImportar.FieldByName('ITETIN').AsString := LstrITETINItemImportacao;
            LcdsItensAImportar.Post;
          End
          Else
          Begin
            LcdsItensAImportar.Edit;
            LcdsItensAImportar.FieldByName('NUMDOC').AsString := qryCnf.FieldByName('DOCCNF').AsString;
            LcdsItensAImportar.FieldByName('CODEMP').AsString := qryCnf.FieldByName('EMPCNF').AsString;
            LcdsItensAImportar.FieldByName('ESPDOC').AsString := qryCnf.FieldByName('ESPCNF').AsString;
            LcdsItensAImportar.FieldByName('ITETIN').AsString := LstrITETINItemImportacao;
            LcdsItensAImportar.Post;
          End;
        End;

      End
      Else
      Begin
        LcdsItensAImportar.Edit;
        LcdsItensAImportar.FieldByName('QTDITE').AsFloat := LcdsItensAImportar.FieldByName('QTDITE').AsFloat +
                                                                        qryDet.FieldByName('QTDITE').AsFloat;
        LcdsItensAImportar.FieldByName('UNIDIG').AsFloat := LcdsItensAImportar.FieldByName('UNIDIG').AsFloat +
                                                                        qryDet.FieldByName('UNIDIG').AsFloat;
        LcdsItensAImportar.FieldByName('DESCON').AsFloat := LcdsItensAImportar.FieldByName('DESCON').AsFloat +
                                                                        qryDet.FieldByName('DESCON').AsFloat;

        LcdsItensAImportar.FieldByName('NUMERO_REPETICAO').AsInteger := LcdsItensAImportar.FieldByName('NUMERO_REPETICAO').AsInteger+ 1;

        If LcdsItensAImportar.FieldByName('IDEPRO').AsString <> 'NOR' Then
          If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoDocumentoOriginalComDesconto] Then
            LcdsItensAImportar.FieldByName('TOTCUS').AsFloat := LcdsItensAImportar.FieldByName('TOTCUS').AsFloat + qryDet.FieldByName('TOTCUS').AsFloat;

        LcdsItensAImportar.FieldByName('TOTITE').AsFloat := LcdsItensAImportar.FieldByName('TOTITE').AsFloat + qryDet.FieldByName('TOTITE').AsFloat;
        LcdsItensAImportar.FieldByName('TOTAL').AsFloat  := LcdsItensAImportar.FieldByName('TOTAL').AsFloat  + (qryDet.FieldByName('QTDITE').AsFloat * qryDet.FieldByName('UNIDIG').AsFloat);

        LcdsItensAImportar.Post;

      End;

      qryDet.Next;
    End;

    pgbProgresso.Max := LcdsItensAImportar.RecordCount;
    pgbProgresso.Position := 0;
    pgbProgresso.Visible  := True;

    stlCodIteCodEmp := TStringList.Create;
    Try
      LcdsItensAImportar.First;
      While Not LcdsItensAImportar.Eof Do
      Begin
         pIncrementaListaStr(LcdsItensAImportar.FieldByName('CODITE').AsString, strCodIteLisOrc, True, True, ',', False);
         stlCodIteCodEmp.Add(LcdsItensAImportar.FieldByName('CODITE').AsString + VS_strCodEmp);

         LcdsItensAImportar.Next;
      End;
    Finally
      fatVenda.pCarregaStringListExcecoes(strCodIteLisOrc, '', stlCodIteCodEmp);
      FreeAndNil(stlCodIteCodEmp);
    End;

    LcdsItensAImportar.First;
    While Not LcdsItensAImportar.Eof Do
    Begin
      pgbProgresso.Position := pgbProgresso.Position +1;

      objCadLot := TCadLot.Create(Self);
      strNumLot := '';

      Try

        if fatVenda.fEmpresaParaFaturamentoUsaWMS(IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text)) then
          strNumLot := 'A DEFINIR'
        Else if fCfgSis('LOTIMP') = 'P' then
        Begin
          If (chkEntCD.Visible And chkEntCD.Checked) Then
          Begin
            If Not objCadLot.fItemSemNenhumLoteEmpresa(LcdsItensAImportar.FieldByName('CODITE').AsString, fCfgSis('EMP_CD')) Then
              strNumLot := objCadLot.fRetArmazemPrincipalVenda(LcdsItensAImportar.FieldByName('CODITE').AsString, fCfgSis('EMP_CD'));
          End
          Else
          Begin
            If Not objCadLot.fItemSemNenhumLoteEmpresa(LcdsItensAImportar.FieldByName('CODITE').AsString) Then
              strNumLot := objCadLot.fRetArmazemPrincipalVenda(LcdsItensAImportar.FieldByName('CODITE').AsString);
          End;
        End
        Else
        Begin
          if objCadLot.fExisteLote(LcdsItensAImportar.FieldByName('CODITE').AsString,
                                   IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                   LcdsItensAImportar.FieldByName('NUMLOT').AsString) then
            strNumLot := LcdsItensAImportar.FieldByName('NUMLOT').AsString
          else
            strNumLot := '';
        End;

      Finally
        FreeAndNil(objCadLot);
      End;

      if LcdsItensAImportar.FieldByName('IDEPRO').AsString <> 'NOR' then
      begin
        objTintaMaquinaDeOutroPedido := TTintaMaquinaDeOutroPedido.Create;

        objTintaMaquinaDeOutroPedido.NumeroPedidoOriginal  := LcdsItensAImportar.FieldByName('NUMDOC').AsString;
        objTintaMaquinaDeOutroPedido.EmpresaPedidoOriginal := LcdsItensAImportar.FieldByName('CODEMP').AsString;
        objTintaMaquinaDeOutroPedido.EspeciePedidoOriginal := LcdsItensAImportar.FieldByName('ESPDOC').AsString;
        objTintaMaquinaDeOutroPedido.CodigoProduto         := LcdsItensAImportar.FieldByName('CODITE').AsString;
        objTintaMaquinaDeOutroPedido.IdentificacaoProduto  := LcdsItensAImportar.FieldByName('IDEPRO').AsString;
        objTintaMaquinaDeOutroPedido.TipoPrecoItem         := tpPrecoImpItem;
        objTintaMaquinaDeOutroPedido.RashIteTin            := LcdsItensAImportar.FieldByName('ITETIN').AsString;
        objTintaMaquinaDeOutroPedido.CodigoAcabado         := LcdsItensAImportar.FieldByName('CODACA').AsString;
        objTintaMaquinaDeOutroPedido.EmpresaAcabado        := LcdsItensAImportar.FieldByName('EMPACA').AsString;

        If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoDocumentoOriginalComDesconto] Then
          objTintaMaquinaDeOutroPedido.PrecoDeCusto := (LcdsItensAImportar.FieldByName('TOTCUS').AsFloat / LcdsItensAImportar.FieldByName('QTDITE').AsFloat)
        Else
          objTintaMaquinaDeOutroPedido.PrecoDeCusto := LcdsItensAImportar.FieldByName('TOTCUS').AsFloat;

      end;

      If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoTabelaAtualSemDesconto, tpNenhumaDefinicao] Then
      Begin
        fltVlrIte := (LcdsItensAImportar.FieldByName('TOTAL').AsFloat / LcdsItensAImportar.FieldByName('QTDITE').AsFloat);
        fltDesIte := 0;
      End
      Else
      Begin

        If (tpPrecoImpItem = tpPrecoTabelaAtualComDesconto) And (Not AblnAgruparItens) Then
        Begin
          fltVlrIte := 0; {Vai pegar o preço da tabela atual}
          fltDesIte := LcdsItensAImportar.FieldByName('DESCON').AsFloat;
        End
        Else
        Begin
          fltVlrIte := (LcdsItensAImportar.FieldByName('TOTITE').AsFloat / LcdsItensAImportar.FieldByName('QTDITE').AsFloat);
          fltDesIte := 0; {TOTITE já tem o desconto do item}
        End;

      End;

      If fIncluirItem(LcdsItensAImportar.FieldByName('CODITE').AsString,
                      strNumLot,
                      LcdsItensAImportar.FieldByName('QTDITE').AsFloat,
                      fltVlrIte,
                      '',
                      '',
                      '',
                      fltDesIte,
                      LcdsItensAImportar.FieldByName('DESCRI').AsString,
                      False,
                      '',
                      IIF(AblnCarregarAmbiente, LcdsItensAImportar.FieldByName('COMPLE').AsString, ''),
                      LcdsItensAImportar.FieldByName('ENTRET').AsString,
                      LcdsItensAImportar.FieldByName('LOCRET').AsString,
                      LcdsItensAImportar.FieldByName('MOTFUT').AsString,
                      LcdsItensAImportar.FieldByName('ENTFUT').AsString) Then

        LcdsItensAImportar.Next
      Else
      Begin
        Case fMensagem('Pergunta',
                       'O item ' + LcdsItensAImportar.FieldByName('CODITE').AsString +
                       ' - ' + LcdsItensAImportar.FieldByName('DESCRI').AsString +
                       ' não foi inserido. O que deseja fazer?',
                       ['Tentar novamente', 'Ignorar', 'Cancelar'],
                       1, False, 1, 0, False, 0, False, False, True) Of
          2: LcdsItensAImportar.Next;
          3: Exit;
        End;
      End;

      if Assigned(objTintaMaquinaDeOutroPedido) then
        FreeAndNil(objTintaMaquinaDeOutroPedido);
    End;

  Finally
    pgbProgresso.Visible := False;

    FreeAndNil(qryDet);

    if Assigned(objTintaMaquinaDeOutroPedido) then
      FreeAndNil(objTintaMaquinaDeOutroPedido);

    if Assigned(qryDev) then
      FreeAndNil(qryDev);

    if Assigned(qryCnf) then
      FreeAndNil(qryCnf);

    if Assigned(LcdsItensAImportar) then
      FreeAndNil(LcdsItensAImportar);

    blnImportandoItensDeOutroDocumento := False;

  End;
end;

function TfrmFatVendas.fImportaTintaDeMaquinaDeOutroPedido : Boolean;
var SQuery : TUniquery;
    LblnLocFor : Boolean;
    matrizSaldosAux: TClassMatrizSaldosColorantes;
    LTabela,
    LTabelaTinta,
    LPrefixo : string;

    function fSQLCondicaoParaConsiderarIDETIN: string;
    begin
      Result := ' ';
      If Not fEmptyStr(objTintaMaquinaDeOutroPedido.RashIteTin) Then
        Result := ' AND T.'+LPrefixo+'_ITETIN = '+LTabela+'.'+LPrefixo+'_ITETIN '+
                  ' AND T.'+LPrefixo+'_ITETIN = '+QuotedStr(objTintaMaquinaDeOutroPedido.RashIteTin)+' '; 
    end;
begin
  Result := False;

  try
    SQuery := fCriaQuery(Nil);

    If Pos(objTintaMaquinaDeOutroPedido.EspeciePedidoOriginal, 'PD_OR_') > 0 Then
    Begin
      LTabela      := 'FATDOR ';
      LTabelaTinta := 'TINDOR';
      LPrefixo     := 'FDO';
    End
    Else
    Begin
      LTabela      := 'MOVDET ';
      LTabelaTinta := 'TINDET';
      LPrefixo     := 'DET';
    End;

    Try
      SQuery.Sql.Text := 'SELECT '+IIF(Pos(objTintaMaquinaDeOutroPedido.EspeciePedidoOriginal, 'PD_OR_') > 0, '*', '*, '''' DET_EMPITE')+
                         '  FROM '+LTabela+
                         '  LEFT JOIN FORTIN FT ON '+LTabela+'.'+LPrefixo+'_CODACA = FT.FOR_CODACA AND FT.FOR_EMPACA = '+LTabela+'.'+LPrefixo+'_EMPACA '+
                         '  JOIN CADITE I ON I.ITE_CODITE = '+LTabela+'.'+LPrefixo+'_CODITE '+
                         '  JOIN CADGRU C ON C.GRU_CODGRU = I.ITE_CODGRU '+
                         '  JOIN ITEGER G ON G.ITE_CODITE = '+LTabela+'.'+LPrefixo+'_CODITE AND G.ITE_CODEMP = :CODEMP '+
                         '  JOIN '+LTabelaTinta+' T ON T.'+LPrefixo+'_NUMDOC = '+LTabela+'.'+LPrefixo+'_NUMDOC '+
                         '                         AND T.'+LPrefixo+'_CODEMP = '+LTabela+'.'+LPrefixo+'_CODEMP '+
                         '                         AND T.'+LPrefixo+'_ESPDOC = '+LTabela+'.'+LPrefixo+'_ESPDOC '+
                         '                         AND T.'+LPrefixo+'_CODITE = '+LTabela+'.'+LPrefixo+'_CODITE '+
                         '                         ' + fSQLCondicaoParaConsiderarIDETIN +
                         '  JOIN ACAGER ACA ON ACA.ACA_CODACA = '+LTabela+'.'+LPrefixo+'_CODACA '+
                         '                 AND ACA.ACA_CODEMP = '+LTabela+'.'+LPrefixo+'_EMPACA '+
                         '                 AND ACA.ACA_EMPEST = '+LTabela+'.'+LPrefixo+'_CODEMP '+
                         ' WHERE '+LTabela+'.'+LPrefixo+'_NUMDOC = :NUMDOC '+
                         '   AND '+LTabela+'.'+LPrefixo+'_CODEMP = :CODEMP '+
                         '   AND '+LTabela+'.'+LPrefixo+'_ESPDOC = :ESPDOC '+
                         '   AND '+LTabela+'.'+LPrefixo+'_CODITE = :CODITE ';
      SQuery.ParamByName('NUMDOC').AsString := objTintaMaquinaDeOutroPedido.NumeroPedidoOriginal;
      SQuery.ParamByName('CODEMP').AsString := objTintaMaquinaDeOutroPedido.EmpresaPedidoOriginal;
      SQuery.ParamByName('ESPDOC').AsString := objTintaMaquinaDeOutroPedido.EspeciePedidoOriginal;
      SQuery.ParamByName('CODITE').AsString := objTintaMaquinaDeOutroPedido.CodigoProduto;
      SQuery.Open;

      fatVenda.strIdePro := objTintaMaquinaDeOutroPedido.IdentificacaoProduto;
      fatVenda.fltCusIte := SQuery.FieldByName('ACA_PRECUS').AsFloat;
      fatVenda.fltUniOri := SQuery.FieldByName(LPrefixo+'_UNIORI').AsFloat;

      recForTin.intModDil   := IfNull(SQuery.FieldByName('FOR_MODDIL').Value, 0);
      recForTin.strTextBase := IfNull(SQuery.FieldByName('FOR_TEXBAS').Value, '');
      recForTin.strTipCor   := IfNull(SQuery.FieldByName('FOR_TIPCOR').Value, '');
      recForTin.strCompB    := IfNull(SQuery.FieldByName('FOR_ITECOB').Value, '');
      recForTin.strUniver   := IfNull(SQuery.FieldByName('FOR_UNIVER').Value, '');
      recForTin.strCatali   := IfNull(SQuery.FieldByName('FOR_CATALI').Value, '');

      matrizSaldosAux := fDesfragmentaTintaSaldosOR(SQuery, LblnLocFor, Not fatVenda.blnVerEstOrc, True);

      If (Not LblnLocFor) Then
      Begin
        Exit;
      End;

      recForTin.Formulas := TClassMatrizSaldosColorantes(matrizSaldosAux);

      strIteTin          := SQuery.FieldByName(LPrefixo+'_ITETIN').AsString;
      fltVolPro          := SQuery.FieldByName(LPrefixo+'_VOLPRO').AsFloat;
      intLazQua          := SQuery.FieldByName(LPrefixo+'_LAZQUA').AsInteger;
      strTipPre          := SQuery.FieldByName(LPrefixo+'_TIPPRE').AsString;
      strTipEmb          := SQuery.FieldByName(LPrefixo+'_TIPEMB').AsString;
      intQtdEmb          := SQuery.FieldByName(LPrefixo+'_QTDEMB').AsInteger;
      fltPreEmb          := SQuery.FieldByName(LPrefixo+'_PREEMB').AsFloat;
      fltPrvTin          := SQuery.FieldByName(LPrefixo+'_PRVTIN').AsFLoat;
      fltPrcTin          := SQuery.FieldByName(LPrefixo+'_PRCTIN').AsFloat;
      fltFatTin          := SQuery.FieldByName(LPrefixo+'_FATTIN').AsFloat;
      strMontad          := SQuery.FieldByName(LPrefixo+'_MONTAD').AsString;
      strA_n_o_          := SQuery.FieldByName(LPrefixo+'_A_N_O_').AsString;
      fltFatAce          := SQuery.FieldByName('FOR_FATACE').AsFloat;
      fatVenda.strCodEmb := SQuery.FieldByName(LPrefixo+'_ITEEMB').AsString;

      strRefere := SQuery.FieldByName(LPrefixo+'_REFERE').AsString;
      If fEmptyStr(strRefere) Then
        strRefere := fatVenda.fRetReferenciaTinta(edtCodIte.Text);

      edtDesIte.Text := SQuery.FieldByName(LPrefixo+'_DESCRI').AsString;

      If SameText(objTintaMaquinaDeOutroPedido.IdentificacaoProduto, 'STA') And
         (fGetConfTinta(objTintaMaquinaDeOutroPedido.IdentificacaoProduto).fGet('DESPST') = 'S') Then
        edtDesIte.Text := edtDesIte.Text + ' ' + strLinTin + ' ' + strA_n_o_;

      strChaFor          := edtDesIte.Text + ' ' + strRefere;
      edtDesIte.ReadOnly := True;
      edtDesIte.TabStop  := FALSE;

      strCodDil := '';
      fltPorDil := 0.0;
      strDilCon := '';
      fltPorCat := 0.0;
      
      If (SQuery.FindField(LPrefixo + '_CODDIL') <> Nil) Then
        strCodDil := SQuery.FieldByName(LPrefixo + '_CODDIL').AsString; 
      If (SQuery.FindField(LPrefixo + '_PORDIL') <> Nil) Then  
        fltPorDil := SQuery.FieldByName(LPrefixo + '_PORDIL').AsFloat;
      If (SQuery.FindField(LPrefixo + '_DILCON') <> Nil) Then  
        strDilCon := SQuery.FieldByName(LPrefixo + '_DILCON').AsString;
      If (SQuery.FindField(LPrefixo + '_PORCAT') <> Nil) Then  
        fltPorCat := SQuery.FieldByName(LPrefixo + '_PORCAT').AsFloat;

      If fUsaRotinaWMS(fatVenda.fEmpresaSaldoMatriz_CD) Or fCfgSis('TMQLOT', varBoolean) Or fInformaLoteBaseImobiliaria(True) Then
        pAjustaLote(edtCodIte.Text, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD), fatVenda.strIdePro, blnProAca, recForTin.Formulas)
      Else If ((fatVenda.strIdePro <> 'NOR') And (Not fCfgSis('TMQLOT', varBoolean)) And (Not fInformaLoteBaseImobiliaria)) Then
        pMostraLote(False);

      SQuery.Close;

      Result := True;
    Finally
      FreeAndNil(SQuery);
    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[TfrmFatVendas.fImportaTintaDeMaquinaDeOutroPedido]');
  end;
end;

procedure TfrmFatVendas.pIncluiItemRemessaDevolucao;
var
  qryRemessa: TUniQuery;
  strItens: String;
  strLote: String;
begin
  qryRemessa := fCriaQuery;

  try
    strItens := EmptyStr;

    qryRemessa.Close;
    qryRemessa.SQL.Clear;
    qryRemessa.SQL.Add('SELECT R.RMV_CODITE, R.RMV_TIPOPE, R.RMV_QTDITE, D.DET_UNITAR, D.DET_DESCRI');
    qryRemessa.SQL.Add('FROM REMDEV R');
    qryRemessa.SQL.Add('INNER JOIN MOVDET D');
    qryRemessa.SQL.Add('ON(R.RMV_AUTDEV = D.AUTOINCREM)');
    qryRemessa.SQL.Add('WHERE R.RMV_NUMREM = :NUMREM');
    qryRemessa.SQL.Add('AND R.RMV_ESPREM = :ESPREM');
    qryRemessa.SQL.Add('AND R.RMV_EMPREM = :EMPREM');

    qryRemessa.ParamByName('NUMREM').AsString := strNumRemessa;
    qryRemessa.ParamByName('ESPREM').AsString := 'RD';
    qryRemessa.ParamByName('EMPREM').AsString := VS_strCodEmp;

    qryRemessa.Open;

    if qryRemessa.IsEmpty then
      Exit;

    while not qryRemessa.Eof do
    begin
      if (strOpcDoc = 'OF') and (fCampoTabela('ITE_CODFOR', 'CADITE', ['ITE_CODITE'], [qryRemessa.FieldByName('RMV_CODITE').AsString], False) <> edtCodCli.Text) then
      begin
        qryRemessa.Next;
        Continue;
      end;

      strLote := Concat(qryRemessa.FieldByName('RMV_TIPOPE').AsString, '_', strNumRemessa);

      fIncluirItem(qryRemessa.FieldByName('RMV_CODITE').AsString,
                   strLote,
                   qryRemessa.FieldByName('RMV_QTDITE').AsFloat,
                   qryRemessa.FieldByName('DET_UNITAR').AsFloat,
                   '',
                   '',
                   '',
                   0,
                   qryRemessa.FieldByName('DET_DESCRI').AsString);

      pIncrementaListaStr(qryRemessa.FieldByName('RMV_CODITE').AsString, strItens, True);

      qryRemessa.Next;
    end;

    pnlItens.Enabled := False;

    if cdsVenda.RecordCount <= 0 then
      Exit;

    btnConfirma.Click;

    if (blnConfirma) and (not fEmptyStr(strItens)) then
    begin
      pVinculaRemessaDevolucao(strOpcDoc, strNumRemessa, fatVenda.strAutInc, strItens);
    end;
  finally
    FreeAndNil(qryRemessa);
  end;
end;

procedure TfrmFatVendas.pIncluiNaListaConsulta;
  Var
    intRecNo: Integer;
    intIndice: Integer;
    strCodIte: String;
Begin
  If (cdsVenda = nil) Or cdsVenda.IsEmpty Then
    Exit;

  If Not SameText(cdsVenda.FieldByName('ITE_IDEPRO').AsString, 'NOR') Then
    Exit;

  strCodIte := cdsVenda.FieldByName('ITE_CODITE').AsString;
  If Not sltItems.Find(QuotedStr(strCodIte), intIndice) Then
    sltItems.Add(QuotedStr(strCodIte));

  If Assigned(cdsConsultaItem) And (Not cdsConsultaItem.IsEmpty) And
     Assigned(cdsConsultaItem.FindField('ITE_CODITE')) Then
  Begin
    With cdsConsultaItem Do
    Begin
      intRecNo := RecNo;
      If Locate('ITE_CODITE', strCodIte, []) Then
      Begin
        Edit;
        FieldByName('VENDIDO').AsInteger := 1;
        Post;
      End;
      RecNo := intRecNo;
    End;
  End;
End;

procedure TfrmFatVendas.pIncluiNaListaConsultaTintadeMaquina;
  Var
    intRecNo: Integer;
    intIndice: Integer;
    strIteTin: String;
    strFieldNameMD5: String;
    strFilter: String;
    blnFiltered: Boolean;
Begin
  If (cdsVenda = nil) Or cdsVenda.IsEmpty Then
    Exit;

  If SameText(cdsVenda.FieldByName('ITE_IDEPRO').AsString, 'NOR') Then
    Exit;

  strIteTin := cdsVenda.FieldByName('ITE_ITETIN').AsString;
  If Not sltItems.Find(QuotedStr(strIteTin), intIndice) Then
    sltItems.Add(QuotedStr(strIteTin));

  If (Not Assigned(cdsConsultaItem)) Then
    Exit;

  If (cdsConsultaItem.IsEmpty) Then
    Exit;

  strFieldNameMD5 := fGetCampoMD5KEYTabelaTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString);

  If (Not Assigned(cdsConsultaItem.FindField(strFieldNameMD5))) Then
    Exit;

  intRecNo := cdsConsultaItem.RecNo;
  Try
    If (cdsConsultaItem.FieldByName(strFieldNameMD5).DataType In [ftMemo, ftBlob]) Then
    Begin
      cdsConsultaItem.DisableControls;
      strFilter := cdsConsultaItem.Filter;
      blnFiltered := cdsConsultaItem.Filtered;
      Try
        cdsConsultaItem.Filtered := False;
        cdsConsultaItem.Filter := strFieldNameMD5 + ' LIKE ' + QuotedStr(strIteTin);
        cdsConsultaItem.Filtered := True;
        If (Not cdsConsultaItem.IsEmpty) then
        Begin
          cdsConsultaItem.Edit;
          cdsConsultaItem.FieldByName('VENDIDO').AsInteger := 1;
          cdsConsultaItem.Post;
        End;
      Finally
        cdsConsultaItem.Filtered := False;
        cdsConsultaItem.Filter := strFilter;
        cdsConsultaItem.Filtered := blnFiltered;
        cdsConsultaItem.EnableControls;
      End;
    End
    Else If cdsConsultaItem.Locate(strFieldNameMD5, strIteTin, []) Then
    Begin
      cdsConsultaItem.Edit;
      cdsConsultaItem.FieldByName('VENDIDO').AsInteger := 1;
      cdsConsultaItem.Post;
    End;
  Finally
    cdsConsultaItem.RecNo := intRecNo;
  End;
end;

procedure TfrmFatVendas.pRetiraDaListaConsulta(strCodIte, strIdePro: String);

  function fItemEstaRepetido:Boolean;
    Var
      cdsDados: TUniClientDataSet;
  begin
    Result := False;

    cdsDados := fCriaTemporaria(Self);
    Try
      pCloneDataSet(cdsDados, cdsVenda);
      With cdsDados Do
      Begin
        Active := False;
        Filter := 'ITE_CODITE = ' + QuotedStr(strCodIte);
        Filtered := True;
        Active := True;

        If Not IsEmpty Then
          Result := RecordCount > 1;
      End;

    Finally
      FreeAndNil(cdsDados)
    End;
  End;

  Var
    intIndice: Integer;
Begin
  If strIdePro <> 'NOR' Then
    Exit;
  (*********************************************************}
  {* SE ESTÁ REPETIDO MANTEM AINDA A MARCAÇÃO POIS CASO    *}
  {* ELE DER "TAB" NOVAMENTE, ELE CARREGARÁ O PRÓXIMO ITEM *}
  {* DE MESMO CÓDIGO                                       *}
  {******************************************************VA*)
  If fItemEstaRepetido Then
    Exit;

  If sltItems.Find(QuotedStr(strCodIte), intIndice) Then
    sltItems.Delete(intIndice);

  If Assigned(cdsConsultaItem) And (Not cdsConsultaItem.IsEmpty) And
     (cdsConsultaItem.FieldByName('ITE_CODITE').AsString = strCodIte) Then
  Begin
    cdsConsultaItem.Edit;
    cdsConsultaItem.FieldByName('VENDIDO').Clear;
    cdsConsultaItem.Post;
  End;
End;

procedure TfrmFatVendas.pRetiraDaListaConsultaTintadeMaquina(strCodIte, strIdePro: String);
  function fItemEstaRepetido:Boolean;
    Var
      cdsDados: TUniClientDataSet;
  begin
    Result := False;

    cdsDados := fCriaTemporaria(Self);
    Try
      pCloneDataSet(cdsDados, cdsVenda);
      With cdsDados Do
      Begin
        Active := False;
        Filter := 'ITE_ITETIN = ' + QuotedStr(strCodIte);
        Filtered := True;
        Active := True;

        If Not IsEmpty Then
          Result := RecordCount > 1;
      End;

    Finally
      FreeAndNil(cdsDados)
    End;
  End;

  Var
    intIndice: Integer;
Begin
  If strIdePro = 'NOR' Then
    Exit;
  (*********************************************************}
  {* SE ESTÁ REPETIDO MANTEM AINDA A MARCAÇÃO POIS CASO    *}
  {* ELE DER "TAB" NOVAMENTE, ELE CARREGARÁ O PRÓXIMO ITEM *}
  {* DE MESMO CÓDIGO                                       *}
  {******************************************************VA*)
  If fItemEstaRepetido Then
    Exit;

  If sltItems.Find(QuotedStr(strCodIte), intIndice) Then
    sltItems.Delete(intIndice);

  If Assigned(cdsConsultaItem) And (Not cdsConsultaItem.IsEmpty) And
     (cdsConsultaItem.FindField(fGetCampoMD5KEYTabelaTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString)) <> Nil) And
     (cdsConsultaItem.FieldByName(fGetCampoMD5KEYTabelaTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString)).AsString = strCodIte) Then
  Begin
    cdsConsultaItem.Edit;
    cdsConsultaItem.FieldByName('VENDIDO').Clear;
    cdsConsultaItem.Post;
  End;
end;

function TfrmFatVendas.fRetornarContatoAoCliente(): Boolean;
  Var
    frmDigDataHora: TfrmDigDataHora;
    frmDigCliente: TfrmDigCliente;
    blnDtaAgendamentoInformada: Boolean;
    regCliCon: TRegistroConsumidor;
    qryCliCon: TUniQuery;
    strAutInc: string;
begin
  Result := True;
  FillChar(regCliCon, SizeOf(regCliCon), #0);

  If (fCfgSis('RETCLI', varString) = 'N') Then
    Exit;

  {Pergunta se deseja retornar para o Cliente}
  if (fExibirPerguntaSeDesejaRetornarContatoAoCliente) And
    (fatVenda.strOpcDoc = 'OR') And
    (Not blnSolicitouFecharOREmPDLocal) Then
  Begin
    If (fCfgSis('RETCLI', varString) = 'S') Or  (fMensagem('', 'Retornar Contato ao Cliente?', ['&Sim', '&Não']) = 1) Then
    Begin
      blnDtaAgendamentoInformada := False;
      pCriarFormularios(TfrmDigDataHora, frmDigDataHora);

      if (not VS_strHabilitarCRM) and (fCfgSis('GERLIG', varBoolean)) then
      begin
        frmDigDataHora.Caption := 'Data do Retorno';
        frmDigDataHora.Label2.Visible := False;
        frmDigDataHora.mskHora__.Visible := False;
      end
      else
        frmDigDataHora.Caption := 'Dt / Hr do Retorno';

      Try
        repeat
          If (fCfgSis('NVORPD', varString) = 'S') Then
          Begin
            If (fDataValida(fatVenda.dtaDtaAgeRet)) Then
            Begin
              Result := True;
              Break;
            End
            Else If (fCfgSis('RETCLI', varString) = 'S') And
                    (fSolicitaRetornoContatoCliente(fatVenda.strEspDoc)) Then
              Exit;
          End;

          frmDigDataHora.ShowModal;

          If Not frmDigDataHora.blnConfirma Then
          Begin
            if (not VS_strHabilitarCRM) and (fCfgSis('GERLIG', varBoolean)) then
            begin
              if frmDigDataHora.ModalResult = mrCancel then
              begin
                Result := False;
                Exit;
              end;
            end;
            fMensagem('', 'Informe uma Data e Hora para retornar contato ao cliente!', ['&OK']);
            Continue;
          End;

          If (frmDigDataHora.mskHora__.Visible) And
             (StrToDateTime(Concat(DateToStr(VS_Date), ' ', TimeToStr(fTime()))) >=
              StrToDateTime(Concat(frmDigDataHora.mskData__.Text, ' ', frmDigDataHora.mskHora__.Text)))  Then
          Begin
            fMensagem('', 'A Data e Hora deve ser maior que a Data e Hora atual!', ['&OK']);
            Result := False;
          End;

          If (Not frmDigDataHora.mskHora__.Visible) And
             (VS_Date > StrToDateTimeDef(frmDigDataHora.mskData__.Text, 0)) Then
          Begin
            fMensagem('', 'A Data de retorno deve ser maior que a Data atual!', ['&OK']);
            Continue;
          End;

          fatVenda.dtaDtaAgeRet := StrToDate(frmDigDataHora.mskData__.Text);

          if frmDigDataHora.mskHora__.Visible then
            fatVenda.horHorAgeRet := StrToTime(frmDigDataHora.mskHora__.Text);

          if (not VS_strHabilitarCRM) and (fCfgSis('GERLIG', varBoolean)) then
          begin
            if (not fClienteConsumidor(fatVenda.strCliOri)) then
            begin
              if fExisteLigacaoAgendada(fatVenda.strCodCli, fatVenda.strCodVen, fatVenda.dtaDtaAgeRet) then
              begin
                if (fMensagem('ATENÇÃO', 'Este cliente já está listado na lista de atendimentos para o dia e vendedor informado. O que deseja fazer?',
                             ['&Alterar a Data informada', '&Finalizar o Orçamento sem gerar retorno ao cliente'], 1, False, 1, 400, False, 0, False, False, False, 0, 920) = 1) then
                begin
                  Continue;
                end
                else
                begin
                  Result := True;
                  Exit;
                end;
              end;
            end;
          end
          else
          begin
            If (DaysBetween(StrToDate(frmDigDataHora.mskData__.Text), fRetDataServidor) > fCfgSis('MAXAGE', varInteger)) Then
            Begin
              fMensagem('', 'O período de retorno não pode ultrapassar ' + fCfgSis('MAXAGE', varString) + ' dias!', ['&OK']);
              Continue;
            End;
          end;

          blnDtaAgendamentoInformada := True;
        until (blnDtaAgendamentoInformada);

        if (not VS_strHabilitarCRM) and (fCfgSis('GERLIG', varBoolean)) then
        begin
          if (fClienteConsumidor(fatVenda.strCliOri)) then
          begin
            pCriarFormularios(TfrmDigCliente, frmDigCliente);
            try
              frmDigCliente.blnTravaInativo := False;
              frmDigCliente.blnChamadaVeioDoOrcamento := True;
              frmDigCliente.edtCodCli.Text := fatVenda.strCodCli;
              frmDigCliente.btnConfirmaDados.Click;

              if frmDigCliente.ModalResult = mrOk then
              begin
                regCliCon.strCliNom := frmDigCliente.regConsum.strCliNom;
                regCliCon.strCliEnd := frmDigCliente.regConsum.strCliEnd;
                regCliCon.strCliBai := frmDigCliente.regConsum.strCliBai;
                regCliCon.strCliCep := frmDigCliente.regConsum.strCliCep;
                regCliCon.strCodCid := frmDigCliente.regConsum.strCodCid;
                regCliCon.strCliTel := frmDigCliente.regConsum.strCliTel;
                regCliCon.strCliCgc := frmDigCliente.regConsum.strCliCgc;
                regCliCon.strCli_Rg := frmDigCliente.regConsum.strCli_Rg;
                regCliCon.strCliIes := frmDigCliente.regConsum.strCliIes;
                regCliCon.strCliEml := frmDigCliente.regConsum.strCliEml;
                regCliCon.intCgcCpf := frmDigCliente.regConsum.intCgcCpf;
                regCliCon.strCodReg := frmDigCliente.regConsum.strCodReg;
              end;
            finally
              pFreeAndNil(frmDigCliente);
            end;
          end;

          Result := fatVenda.fGravaAgeTel(fatVenda.strCodCli, fatVenda.strCodVen, fatVenda.dtaDtaAgeRet, strAutInc);

          if (Result) and (regCliCon.strCliNom <> '') then
          begin
            Result := False;
            qryCliCon := fCriaQuery;

            try
              qryCliCon.Close;
              qryCliCon.SQL.Clear;
              qryCliCon.SQL.Add('INSERT INTO CONAGE                                                       ');
              qryCliCon.SQL.Add('(AUTOINCREM, CON_CODEMP, CON_NOMCON, CON_ENDCON, CON_BAICON, CON_CEPCON, CON_RG_CON, ');
              qryCliCon.SQL.Add(' CON_CODCID, CON_TELCON, CON_CGCCPF, CON_CGCCON, CON_IESCON, CON_EMLCON, CON_SEQGER, CON_CODREG) ');
              qryCliCon.SQL.Add('VALUES                                                                   ');
              qryCliCon.SQL.Add('(:AUTOIN, :CODEMP, :NOMCON, :ENDCON, :BAICON, :CEPCON, :RG_CON,          ');
              qryCliCon.SQL.Add(' :CODCID, :TELCON, :CGCCPF, :CGCCON, :IESCON, :EMLCON, :SEQGER, :CODREG) ');

              qryCliCon.ParamByName('AUTOIN').AsString  := fRetAutoIncrem('CONAGE', VS_strCodEmp);
              qryCliCon.ParamByName('SEQGER').AsString  := strAutInc;
              qryCliCon.ParamByName('CODEMP').AsString  := VS_strCodEmp;
              qryCliCon.ParamByName('NOMCON').AsString  := regCliCon.strCliNom;
              qryCliCon.ParamByName('ENDCON').AsString  := regCliCon.strCliEnd;
              qryCliCon.ParamByName('BAICON').AsString  := regCliCon.strCliBai;
              qryCliCon.ParamByName('CEPCON').AsString  := regCliCon.strCliCep;
              qryCliCon.ParamByName('RG_CON').AsString  := regCliCon.strCli_Rg;
              qryCliCon.ParamByName('CODCID').AsString  := regCliCon.strCodCid;
              qryCliCon.ParamByName('TELCON').AsString  := regCliCon.strCliTel;
              qryCliCon.ParamByName('CGCCPF').AsInteger := regCliCon.intCgcCpf;
              qryCliCon.ParamByName('CGCCON').AsString  := regCliCon.strCliCgc;
              qryCliCon.ParamByName('IESCON').AsString  := regCliCon.strCliIes;
              qryCliCon.ParamByName('EMLCON').AsString  := regCliCon.strCliEml;
              qryCliCon.ParamByName('CODREG').AsString  := regCliCon.strCodReg;

              qryCliCon.ExecSQL;
              Result := True;
            finally
              FreeAndNil(qryCliCon);
            end;
          end;
        end;
      Finally
        pFreeAndNil(frmDigDataHora);
      End;
    End;
  End;
end;

procedure TfrmFatVendas.mnuTrocarProdutoClick(Sender: TObject);
begin
  inherited;
  If cdsVenda.IsEmpty Then
    Exit;

  If Not mnuTrocarProduto.Visible Then
    Exit;

  btnCancelaItem.Click;

  fChamaTelaGravando(fTrocaItem, 'Aguarde, Executando a troca do produto ' +
    cdsVenda.FieldByName('ITE_DESITE').AsString);

  cdsVenda.Locate('ITE_ORDITE', intOrdIteTrocando, []);

  pSetFocus(dbgItens);

  pAtualizaDados(Nil);
end;

function TfrmFatVendas.fTrocandoClienteComCreditoNoPedido: Boolean;
var
  strClienteOriginal : String;
begin
  Result := False;

  If (Self.strEspOrc <> 'PD') Then
    Exit;

  If (fEmptyStr(Self.strNumOrc)) Then
    Exit;

  strClienteOriginal := fClienteOriginalDoPedido;

  If (fEmptyStr(strClienteOriginal)) Then
    Exit;

  If (strClienteOriginal = edtCodCli.Text) Then
    Exit;

  Result := fTemCreditoLancadoParaDocumento(Self.strNumOrc, Self.strEspOrc, Self.strEmpOrc, strClienteOriginal);
end;

Function TfrmFatVendas.fTrocaItem(pgbStatus: TcxProgressBar): Boolean;
Var
  intQtdReg: Integer;
  oleItensBackup: OleVariant;
  strFilterBackup: String;
  blnFilterBackup: Boolean;
  intAutIncBackup: Integer;
  blnTintaMaquinaEnabled: Boolean;
  blnTintaMaquinaVisible: Boolean;
Begin
  Result := False;

  If cdsVenda.IsEmpty Then
    Exit;

  blnTintaMaquinaEnabled := btnTintaMaquina.Enabled;
  blnTintaMaquinaVisible := btnTintaMaquina.Visible;

  oleItensBackup  := cdsVenda.Data;
  strFilterBackup := cdsVenda.Filter;
  blnFilterBackup := cdsVenda.Filtered;
  intAutIncBackup := cdsVenda.FieldByName('AUTOINCREM').AsInteger;
  intOrdIteTrocando := cdsVenda.FieldByName('ITE_ORDITE').AsInteger;
  strIdeProTrocando := cdsVenda.FieldByName('ITE_IDEPRO').AsString;

  fatVenda.cdsVendaBackup := nil;

  pCriarFormularios(TfrmFatVendaItem, frmFatVendaItem);
  Try
    pExibirImgPnlDadosItem(True);
    pnlDadosItem.Visible := False;
    pProcessMessages;

    blnTrocandoProduto := True;

    fatVenda.cdsVendaBackup := TUniClientDataSet.Create(nil);
    fatVenda.cdsVendaBackup.Data := cdsVenda.Data;

    If Not fPodeDeletarItem Then
      Exit;

    cdsVenda.Edit;
    cdsVenda.FieldByName('ITE_QTDITE').AsFloat := 0;
    cdsVenda.FieldByName('ITE_TOTITE').AsFloat := 0;
    cdsVenda.Post;

    Self.fGetOrdemItem;

		pCalculaTotais(False, intAutIncBackup);

    btnCancelaItem.Click;
    blnUtilizandoVendeItem := True;
    blnAtualizarPnlDadosItemNaVendaModoTab := False;

    btnTintaMaquina.Enabled := (strIdeProTrocando <> 'NOR') And blnTintaMaquinaEnabled;
    btnTintaMaquina.Visible := (strIdeProTrocando <> 'NOR') And blnTintaMaquinaVisible;

    Try
      pnlDadosItem.Parent     := frmFatVendaItem;
      pnlDadosItem.BevelOuter := bvNone;
      pnlDadosItem.Visible    := True;

      pProcessMessages;

      frmFatVendaItem.fValidaCamposVenda := fValidaCampos;

      edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 0);

      frmFatVendaItem.Width := fGetWidthVendeItemTAB;

      frmFatVendaItem.pnlUltimaCompra.Visible := Not fClienteConsumidor(fatVenda.strCliOri, False, True);

      Self.fltUltimoUniLiqModoTab := 0;
      Self.fltUltimaQtdIteModoTab := 0;

      If strIdeProTrocando = 'NOR' Then
      Begin
        frmFatVendaItem.pnlImpostos.Visible := True;
        frmFatVendaItem.ClientHeight := pnlDadosItem.Height + frmFatVendaItem.pnlStatus.Height + 30 + 70;
        pCalculaImpostosNaConsultaTab;
      End
      Else
      Begin
        frmFatVendaItem.pnlImpostos.Visible := False;
        frmFatVendaItem.ClientHeight := pnlDadosItem.Height + frmFatVendaItem.pnlStatus.Height + 30;
      End;

      intQtdReg := cdsVenda.RecordCount;

      frmFatVendaItem.OnIniciar := pTrocaItemIniciar;

      frmFatVendaItem.ShowModal;

      Result := (cdsVenda.RecordCount > intQtdReg);

      If Result Then
      Begin
        cdsVenda.Filtered := False;
        cdsVenda.Filter   := '(' + cdsVenda.Filter + ') OR (AUTOINCREM = ' + intAutIncBackup.ToString + ')';
        cdsVenda.Filtered := True;
        if cdsVenda.Locate('AUTOINCREM', intAutIncBackup, []) then
          fDeletaItem(False, False);
      End;

    Except
      On E: ExceptionAutCom Do
      Begin
        Result := False;
        pMensagemOk(E.Message);
      End;

      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TfrmFatVendas.fTrocaItem]');
      End;
    End;

  Finally
    blnAtualizarPnlDadosItemNaVendaModoTab := False;
    blnUtilizandoVendeItem := False;

    pnlDadosItem.BevelOuter := bvRaised;
    btnTintaMaquina.Enabled := blnTintaMaquinaEnabled;
    btnTintaMaquina.Visible := blnTintaMaquinaVisible;
    pnlDadosItem.Parent     := pnlDadosItemFixo;
    pnlDadosItem.Visible    := True;

    pProcessMessages;

    pFreeAndNil(frmFatVendaItem);

    pFinalizarTimerAtualizarImpostosNaConsultaTab;

    blnTrocandoProduto := False;

    pExibirImgPnlDadosItem(False);

    If Not Result Then
    Begin
      cdsVenda.Data       := oleItensBackup;
      cdsVenda.LogChanges := False;
    End;

    if cdsVenda.Filter <> strFilterBackup then
    begin
      cdsVenda.Filtered := False;
      cdsVenda.Filter   := strFilterBackup;
    end;

    cdsVenda.Filtered := blnFilterBackup;

    fatVenda.pFormataDecimaisGrid(nil);

    pCalculaTotais;

    cdsVenda.Locate('ITE_ORDITE', intOrdIteTrocando, []);

    pSetFocus(dbgItens);

    pAtualizaDados(Nil);

    If Assigned(fatVenda.cdsVendaBackup) Then
    Begin
      if fatVenda.cdsVendaBackup.Active Then
        fatVenda.cdsVendaBackup.Close;
      FreeAndNil(fatVenda.cdsVendaBackup);
    End;
  End;

end;

Function TfrmFatVendas.fVendeItem(cdsConsulta: TUniClientDataSet; DropControl: TControl; RectLinhaGrid: TRect): Boolean;
Var
  blnTintaMaquinaEnabled,
  blnTintaMaquinaVisible,
  blnConfiguracaoQtdeTab : Boolean;
  dblQtdeTab             : Double;
  strDefaultQtdeTab      : String;
  strAmbiente            : String;
  blnChamaExitQtdIte     : Boolean;

  procedure pAjustarPanelItens;
  begin
    pnlDadosItem.BevelOuter := bvRaised;
    btnTintaMaquina.Enabled := blnTintaMaquinaEnabled;
    btnTintaMaquina.Visible := blnTintaMaquinaVisible;

    edtCodIte.ReadOnly := False;
    edtCodIte.TabStop  := True;

    edtVerStt.Visible  := False;
    lblVerStt.Visible  := False;

    pnlDadosItem.Parent := pnlDadosItemFixo;
  end;

Begin
  If (VS_strModoTAB <> '2') And (fCfgSis('TABPTD', varString) = 'S') Then
  Begin
    Result := fVendeItemCompleto(cdsConsulta, DropControl, RectLinhaGrid);
    Exit;
  End;

  dblQtdeTab := 0;
  Result := False;
  btnCancelaItem.Click;
  btnExcluir.Visible := False;
  blnAtualizarPnlDadosItemNaVendaModoTab := False;
  blnUtilizandoVendeItem := True;

  blnTintaMaquinaEnabled := btnTintaMaquina.Enabled;
  blnTintaMaquinaVisible := btnTintaMaquina.Visible;

  btnTintaMaquina.Enabled := False;
  btnTintaMaquina.Visible := False;

  edtCodIte.ReadOnly := False;
  edtCodIte.TabStop  := True;

  Try

    Try

      If cdsConsulta.IsEmpty Then
        Exit;

      (***************************************************************}
      {* cdsConsultaItem COM VARIÁVEL DE REFERÊNCIA DE cdsConsulta   *}
      {* E É USADA PARA EDITAR O CAMPO "VENDIDO" DURANTE A EXIBIÇÃO  *}
      {* DA CONSULTA DE ITENS. ANTES DE SAIR DESTA FUNÇÃO A VARIÁVEL *}
      {* É DESVINCULADA POR cdsConsultaItem := Nil POIS ESTAVA DANDO *}
      {* VIOLAÇÃO DE MEMÓRIA EM ALGUMAS SITUAÇÕES                    *}
      {************************************************************VA*)
      cdsConsultaItem := cdsConsulta;

      edtCodIte.Text := cdsConsulta.FieldByName('ITE_CODITE').AsString;
      If cdsVenda.Locate('ITE_CODITE', edtCodIte.Text, []) Then
      Begin

        {Req.: 109880 - Tintas não altera por aqui!}
        If (cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
        Begin
          btnExcluir.Visible := True;
          blnAtualizarPnlDadosItemNaVendaModoTab := True;
          pAtualizaDados(Nil);
          blnAtualizarPnlDadosItemNaVendaModoTab := False;
        End;

      End;

      If fValidaCampos(edtCodIte, True) Then
      Begin
        blnConfiguracaoQtdeTab := VS_strModoTAB = '2'; // Pegar a configuração

        if blnConfiguracaoQtdeTab then
        begin
          strDefaultQtdeTab := '1';

          If (qryConCit.FieldByName('ITE_MLTVEN').AsFloat > 0) Then
            strDefaultQtdeTab := FormatFloat(edtQtdIte.EditFormat, qryConCit.FieldByName('ITE_MLTVEN').AsFloat);

          //quando acessado o TAB do produto, iniciar como 1,00 como default e não 0,00; req: 63928
          //se o produto em questão já estiver quantidade, carregar a informada anteriormente
          If (cdsConsulta.FieldByName('ITE_CODITE').AsString = cdsVenda.FieldByName('ITE_CODITE').AsString) And (cdsVenda.FieldByName('ITE_QTDITE').AsFloat > 0) Then
          Begin
            strDefaultQtdeTab := cdsVenda.FieldByName('ITE_QTDITE').AsString;
            strAmbiente := cdsVenda.FieldByName('ITE_COMPLE').AsString;
          End;

          dblQtdeTab := fGetQtdeTab(StrToFloatDef(strDefaultQtdeTab, 0), strAmbiente, RectLinhaGrid);
        end;

        if (blnConfiguracaoQtdeTab) and (dblQtdeTab = 0) then
        begin
          if cdsConsulta.FieldByName('VENDIDO').AsInteger = 1 then
          begin
            if cdsVenda.Locate('ITE_CODITE', cdsConsulta.FieldByName('ITE_CODITE').AsString, []) then
            begin
              cdsConsulta.Edit;
              cdsConsulta.FieldByName('VENDIDO').Value := Null;
              cdsConsulta.Post;

              pDeletarItemGrade;
            end;
          end;
        end
        else
        begin

          SelectNext(ActiveControl, True, True);

          pCriarFormularios(TfrmFatVendaItem, frmFatVendaItem);
          pnlDadosItem.Parent := frmFatVendaItem;
          pnlDadosItem.BevelOuter := bvNone;
          frmFatVendaItem.fValidaCamposVenda := fValidaCampos;

          edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 1);

          If (qryConCit.FieldByName('ITE_MLTVEN').AsFloat > 0) Then
          Begin
            edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, qryConCit.FieldByName('ITE_MLTVEN').AsFloat);

            If Not ((cdsConsulta.FieldByName('ITE_CODITE').AsString = cdsVenda.FieldByName('ITE_CODITE').AsString) And (cdsVenda.FieldByName('ITE_QTDITE').AsFloat > 0)) Then
              edtQtdIteExit(edtQtdIte);
          End;             

          //quando acessado o TAB do produto, iniciar como 1,00 como default e não 0,00; req: 63928
            //se o produto em questão já estiver quantidade, carregar a informada anteriormente
            If (cdsConsulta.FieldByName('ITE_CODITE').AsString = cdsVenda.FieldByName('ITE_CODITE').AsString) And (cdsVenda.FieldByName('ITE_QTDITE').AsFloat > 0) Then
              edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, cdsVenda.FieldByName('ITE_QTDITE').AsFloat);

            if (cdsConsulta.FindField('DESCCAT_TABFAT') <> nil ) and (fCfgSis('VERSTT') = 'S') then
            begin
              edtVerStt.Visible := True;
            lblVerStt.Visible := True;
            edtVerStt.Text    := FormatFloat('#,##0.00', cdsConsulta.FieldByName('DESCCAT_TABFAT').AsFloat);
          end;

          frmFatVendaItem.Width := fGetWidthVendeItemTAB;

          frmFatVendaItem.pnlUltimaCompra.Visible := Not fClienteConsumidor(fatVenda.strCliOri, False, True);

          Self.fltUltimoUniLiqModoTab := 0;
          Self.fltUltimaQtdIteModoTab := 0;

          if fatVenda.strIdePro <> 'NOR' then
          begin
            frmFatVendaItem.pnlImpostos.Visible := false ;
            frmFatVendaItem.ClientHeight := pnlDadosItem.Height + frmFatVendaItem.pnlStatus.Height + 30;
          end
          else
          begin
            frmFatVendaItem.pnlImpostos.Visible := True ;
            frmFatVendaItem.ClientHeight := pnlDadosItem.Height + frmFatVendaItem.pnlStatus.Height + 30 + 70;
            pCalculaImpostosNaConsultaTab;
          end;

          edtCodIte.ReadOnly := True;
          edtCodIte.TabStop  := False;

          // Quando a quantidade já veio informada a partir da configuração
          // para agilizar a inserção de itens no orçamento
          if (blnConfiguracaoQtdeTab) then
          begin
            if (dblQtdeTab > 0) then
            begin
              blnChamaExitQtdIte := (fStrToFloat(edtQtdIte.Text) <> dblQtdeTab);

              edtQtdIte.Text := FormatFloat(',0.00', dblQtdeTab);

              If blnChamaExitQtdIte Then
                edtQtdIteExit(edtQtdIte);

              btnAdicionar.Click;

            end;
          end
          else
          begin
            if fItemLoteChapa(fCodItem,strOpcDoc) then
              btnAdicionar.Tag := 0;

            frmFatVendaItem.ShowModal;
          end;

        end;

        Result := True;

      End;

    Except
      On E: ExceptionAutCom Do
      Begin
        Result := False;
        pMensagemOk(E.Message);
      End;

      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TfrmFatVendas.fVendeItem]');
      End;

    End;

  Finally

    If cdsConsultaItem <> Nil Then
      cdsConsultaItem := Nil;

    btnExcluir.Visible := False;
    blnAtualizarPnlDadosItemNaVendaModoTab := False;
    blnUtilizandoVendeItem := False;

    pAjustarPanelItens();
    pFreeAndNil(frmFatVendaItem);

    pFinalizarTimerAtualizarImpostosNaConsultaTab;
  End;
End;

Function TfrmFatVendas.fVendeItemCompleto(cdsConsulta: TUniClientDataSet; DropControl: TControl; RectLinhaGrid: TRect): Boolean;
  Var
    blnTintaMaquinaEnabled : Boolean;
    blnTintaMaquinaVisible : Boolean;

  procedure pAjustarPanelItens;
  begin
    pnlDadosItem.BevelOuter := bvRaised;
    btnTintaMaquina.Enabled := blnTintaMaquinaEnabled;
    btnTintaMaquina.Visible := blnTintaMaquinaVisible;
    edtCodIte.ReadOnly := False;
    edtCodIte.TabStop  := True;
    edtVerStt.Visible  := False;
    lblVerStt.Visible  := False;
    pnlDadosItem.Parent := pnlDadosItemFixo;
  end;

Begin
  If cdsConsulta.IsEmpty Then
  Begin
    Result := False;
    Exit;
  End;

  pCriarFormularios(TfrmFatVendaItem, frmFatVendaItem);
  Try
    cdsConsultaItem := cdsConsulta;
    Try
      btnExcluir.Visible := False;
      blnAtualizarPnlDadosItemNaVendaModoTab := False;
      blnUtilizandoVendeItem := True;
      blnTintaMaquinaEnabled := btnTintaMaquina.Enabled;
      blnTintaMaquinaVisible := btnTintaMaquina.Visible;
      btnTintaMaquina.Enabled := False;
      btnTintaMaquina.Visible := False;
      edtCodIte.ReadOnly := True;
      edtCodIte.TabStop  := False;
      edtCodIte.Text := cdsConsulta.FieldByName('ITE_CODITE').AsString;
      edtDesIte.Text := cdsConsulta.FieldByName('ITE_DESITE').AsString;
      edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 1);
      If Assigned(cdsConsulta.FindField('ITE_PREVE' + fatVenda.strTabPre)) Then
        edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), cdsConsulta.FieldByName('ITE_PREVE' + fatVenda.strTabPre).AsFloat);
      pnlDadosItem.Parent := frmFatVendaItem;
      pnlDadosItem.BevelOuter := bvNone;
      frmFatVendaItem.fValidaCamposVenda := fValidaCampos;
      frmFatVendaItem.Width := fGetWidthVendeItemTAB;
      frmFatVendaItem.pnlUltimaCompra.Visible := Not fClienteConsumidor(fatVenda.strCliOri, False, True);
      frmFatVendaItem.pnlImpostos.Visible := True;
      frmFatVendaItem.ClientHeight := pnlDadosItem.Height + frmFatVendaItem.pnlStatus.Height + 30 + 70;
      frmFatVendaItem.CloseExecute := procedure ()
        begin
          btnCancelaItem.Click;
        end;
      frmFatVendaItem.OnExecute :=
        function () : Boolean
        begin
          Result := False;
          Try
            btnCancelaItem.Click;

            edtCodIte.Text := cdsConsulta.FieldByName('ITE_CODITE').AsString;
            If cdsVenda.Locate('ITE_CODITE', edtCodIte.Text, []) Then
            Begin
              If (cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
              Begin
                btnExcluir.Visible := True;
                blnAtualizarPnlDadosItemNaVendaModoTab := True;
                pAtualizaDados(Nil);
                blnAtualizarPnlDadosItemNaVendaModoTab := False;
              End;
            End;

            If (Not fValidaCampos(edtCodIte, True)) Then
              Exit;

            Result := True;

            edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 1);

            If (qryConCit.FieldByName('ITE_MLTVEN').AsFloat > 0) Then
            Begin
              edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, qryConCit.FieldByName('ITE_MLTVEN').AsFloat);
              If Not ((cdsConsulta.FieldByName('ITE_CODITE').AsString = cdsVenda.FieldByName('ITE_CODITE').AsString) And (cdsVenda.FieldByName('ITE_QTDITE').AsFloat > 0)) Then
                edtQtdIteExit(edtQtdIte);
            End;

            If (cdsConsulta.FieldByName('ITE_CODITE').AsString = cdsVenda.FieldByName('ITE_CODITE').AsString) And (cdsVenda.FieldByName('ITE_QTDITE').AsFloat > 0) Then
              edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, cdsVenda.FieldByName('ITE_QTDITE').AsFloat);

            If (cdsConsulta.FindField('DESCCAT_TABFAT') <> Nil) And (fCfgSis('VERSTT') = 'S') Then
            Begin
              edtVerStt.Visible := True;
              lblVerStt.Visible := True;
              edtVerStt.Text := FormatFloat('#,##0.00', cdsConsulta.FieldByName('DESCCAT_TABFAT').AsFloat);
            End;

            pSetFocus(edtQtdIte);

            Self.fltUltimoUniLiqModoTab := 0;
            Self.fltUltimaQtdIteModoTab := 0;

            pCalculaImpostosNaConsultaTab;
            Application.ProcessMessages;

            If fItemLoteChapa(fCodItem, strOpcDoc) Then
              btnAdicionar.Tag := 0;
          Except
            On E: ExceptionAutCom Do
            Begin
              Result := False;
              pMensagemOk(E.Message);
            End;
            On E: Exception Do
            Begin
              Result := False;
              pMensagensErro(E.Message, '[TfrmFatVendas.fVendeItemCompleto]');
            End;
          End;
        end;
      frmFatVendaItem.ShowModal;
      Result := frmFatVendaItem.Execute;
      btnCancelaItem.Click;
    Finally
      If cdsConsultaItem <> Nil Then
        cdsConsultaItem := Nil;
      btnExcluir.Visible := False;
      blnAtualizarPnlDadosItemNaVendaModoTab := False;
      blnUtilizandoVendeItem := False;
      pAjustarPanelItens;
      pFinalizarTimerAtualizarImpostosNaConsultaTab;
    End;
  Finally
    pFreeAndNil(frmFatVendaItem);
  End;
End;

function TfrmFatVendas.fVendeItemTinta(cdsConsulta: TUniClientDataSet;
  DropControl: TControl): Boolean;
  Var
    blnTintaMaquinaEnabled,
    blnTintaMaquinaVisible: Boolean;
Begin
  Result := False;

  btnExcluir.Visible := False;
  blnAtualizarPnlDadosItemNaVendaModoTab := False;
  blnUtilizandoVendeItem := True;
  Try
    Try
      If cdsConsulta.IsEmpty Then
      Begin
        Exit;
      End;

      (***************************************************************}
      {* cdsConsultaItem COM VARIÁVEL DE REFERÊNCIA DE cdsConsulta   *}
      {* E É USADA PARA EDITAR O CAMPO "VENDIDO" DURANTE A EXIBIÇÃO  *}
      {* DA CONSULTA DE ITENS. ANTES DE SAIR DESTA FUNÇÃO A VARIÁVEL *}
      {* É DESVINCULADA POR cdsConsultaItem := Nil POIS ESTAVA DANDO *}
      {* VIOLAÇÃO DE MEMÓRIA EM ALGUMAS SITUAÇÕES                    *}
      {************************************************************VA*)
      cdsConsultaItem := cdsConsulta;

      If cdsVenda.Locate('ITE_ITETIN', strIteTin, []) Then
      Begin
        btnExcluir.Visible := True;
//        blnAtualizarPnlDadosItemNaVendaModoTab := True;
//        pAtualizaDados(Nil);
//        blnAtualizarPnlDadosItemNaVendaModoTab := False;
      End;

//      SelectNext(ActiveControl, True, True);

      blnTintaMaquinaEnabled := btnTintaMaquina.Enabled;
      blnTintaMaquinaVisible := btnTintaMaquina.Visible;

      pCriarFormularios(TfrmFatVendaItem, frmFatVendaItem);
      pnlDadosItem.Parent     := frmFatVendaItem;
      pnlDadosItem.BevelOuter := bvNone;
      btnTintaMaquina.Visible := False;
      btnTintaMaquina.Enabled := False;
      frmFatVendaItem.fValidaCamposVenda := fValidaCampos;

      frmFatVendaItem.Width := fGetWidthVendeItemTAB;

      frmFatVendaItem.ClientHeight := pnlDadosItem.Height + frmFatVendaItem.pnlStatus.Height + 30;

      edtCodIte.ReadOnly := True;
      edtCodIte.TabStop  := False;

      frmFatVendaItem.ShowModal;

      pnlDadosItem.BevelOuter := bvRaised;
      btnTintaMaquina.Enabled := blnTintaMaquinaEnabled;
      btnTintaMaquina.Visible := blnTintaMaquinaVisible;

      edtCodIte.ReadOnly := False;
      edtCodIte.TabStop  := True;

      pnlDadosItem.Parent := pnlDadosItemFixo;
      pFreeAndNil(frmFatVendaItem);

      Result := True;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TfrmFatVendas.fVendeItemTinta]');
      End;
    End;
  Finally
    If cdsConsultaItem <> Nil Then
      cdsConsultaItem := Nil;

    btnExcluir.Visible := False;
    blnAtualizarPnlDadosItemNaVendaModoTab := False;
    blnUtilizandoVendeItem := False;
  End;
end;

procedure TfrmFatVendas.pExcluiItemVendaConsulta;
begin
  If fEstaNaConsultaTab Then
  Begin
    fDeletaItem;
    pCalculaTotais;
    pFechaVendeItem;
    btnCancelaItem.Click;
  End;
End;

procedure TfrmFatVendas.pExecutaRetornoPrecoTintadeMaquina(
  blnUsaPreCus: Boolean; strIdePro, strTabPre, strUnidad: String; fltPreVen,
  fltDesMax: Double; strEmpSalResTin, strOpcPre: String; dicRetorno: TDicionario;
  qryTinta: TUniQuery; blnProPreTin: Boolean);

Var
  calcCustoReal: TCalcCustoReal;
  strCodSit,
  strCodAbf,
  strCodCam: String;

  blnEmCamp: Boolean;
  fltVlrCam,
  fltCusCam,
  fltPreClq: Double;

  procedure pPedeSenhaParaVenderSemEmbalagem;
  begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Liberação para venda sem embalagem.');
    objLiberacao.objMsgLibera.pAddTextoCaption('Cor'    , edtDesIte.Text                          , 7);
    objLiberacao.objMsgLibera.pAddTextoCaption('Qtde'   , edtQtdIte.Text                          , 7);
    objLiberacao.objMsgLibera.pAddTextoCaption('Volume' , FloatToStrF(fltVolPro, ffNumber, 12, 3) , 7);

    objLiberacao.strDirAce := 'AUTEMB';
    objLiberacao.strSenLib := fCfgSis('SENEMB');
    objLiberacao.strMsgSen := 'Venda de tinta automotiva sem embalagem';
    objLiberacao.strCodOpe := strLoginUsuarioLogado;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
    Begin
      btnCancelaItem.Click;
    End;
  end;

  function fJaSelecionouPrecoTE: Boolean;
  begin
    Result := fCfgSis('ESCPTE', varBoolean) And
              fatVenda.blnCliFil And (Not fEmptyStr(fatVenda.strPreETe));
  end;

  procedure pDefineTintaEmPromocao;
  begin
    {********************************************************************}
    {* RETORNA SE ALGUM PRODUTO DA FORMULACAO DA TINTA ESTA EM PROMOCAO *}
    {* SE TIVER NAO PODERÁ SER APLICADO O DESC. MAX POR LINHA/GRUPO     *}
    {****************************************************************AC**}
//      If (fatVenda.strPromoc <> 'S') And (fatVenda.strIdePro <> 'NOR') Then
    If (fatVenda.strIdePro <> 'NOR') Then
    Begin
      fatVenda.strPromoc := IIF(fEmptyStr(ifNull(dicRetorno['promoc'], 'N')), 'N', ifNull(dicRetorno['promoc'], 'N'));

      if fCfgSis('PROKIT', varBoolean) then
        TProQtdColetiva.pAdicionarStatusPromocaoDaTinta(dicRetorno['itetin'], fatVenda.strPromoc);
    End;
  end;
begin
  If InterlockedIncrement(intConfirmando) = 0 Then
  Begin
    Try
      pProcessMessages;

      edtCodIte.Text     := dicRetorno['codite'];

      //Desabilitando edit para tinta de maquina
      edtCodIte.Enabled    := False;

      strCodAtu            := dicRetorno['codite'];

      fltVlrCam := 0;
      fltCusCam := 0;

      TProQtdColetiva.strRshTinAtual := dicRetorno['itetin'];

      pCarregaItem(True, True, False, False, True, False, False, strIdePro);

      If cbTabPrecoItem.Visible Then
      Begin
        cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(strTabPre);
        strTabPreIteAnt := strTabPre;
      End;

      {********************************************}
      {* SE FEZ NECESSÁRIO ATRIBUIR O VALOR PARA  *}
      {* ESSA VARIÁVEL AQUI TAMBÉM, POIS TEM VA-  *}
      {* DAÇÕES QUE PRECISAM DELA. NÃO TIRAR DAQUI*}
      {***21/05/2008****************************MV*}
      fatVenda.strIdePro := strIdePro;
      fatVenda.strIteTin := dicRetorno['itetin'];

      pDefineTintaEmPromocao;

      {Req: 134419 - Precisa ser após a "pDefineTintaEmPromocao"}
      pEditarDesconto;
      pEditarPrecoUnitario;

      fltPreVen := dicRetorno['unitar'];
      fltVolPro := dicRetorno['volpro'];

      blnEmCamp := fatVenda.objCamGer.objCamDet.fVerificaProdutoCampanha(fatVenda.strCodCli,
                                                                         strCodAtu,
                                                                         fatVenda.strIdePro,fatVenda.strIteTin,
                                                                         fltVolPro,
                                                                         fltVlrCam,
                                                                         strCodCam,
                                                                         fltPreClq);

      If blnEmCamp And (fltVlrCam > 0) Then
      Begin
        fatVenda.strPromoc := 'N';
        fatVenda.strStatus := 'C';
        fatVenda.strCodCmg := strCodCam;
        fltPreVen := fltVlrCam;
        pDesabilitaTabPreItem;
      End;

      If (fCfgSis('CLIDES') = 'S') And
         (fCfgSis('DCVBVL') = 'L') Then
      Begin
        fltPreVen := fFormataFloat(fltPreVen * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
      End;

      fatVenda.fltTaxJur := 0.00;

      If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
      Begin
        fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(dicRetorno['codite'], strEmpSalResTin);
        fltPreVen := fltPreVen + fFormataFloat(fltPreVen * (fatVenda.fGetTaxVprItem(dicRetorno['codite'], strEmpSalResTin) / 100.0), 04);
      End;

      fatVenda.pCalculaValorRT(fltPreVen, fatVenda.FVal_RT);

      fatVenda.fltUniOri := fltPreVen; //Com Juros
      fatVenda.fltUniVis := dicRetorno['unitar']; //Sem juros

      {*******************************************************************************}
      {* COMENTADO POIS NÃO FAZ SENTIDO MUDAR O UNIORI E UNIVIS POR CONTA DA TRAVA   *}
      {* TRAVA DE PREÇO POR VALOR MÍNIMO O TRAVAMENTO DEVE/DEVERIA TER SIDO FEITO NA *}
      {* RESPECITVA TRAVA QUANDO CFG_PROPRE = PREÇO DE TABELA REQ.: 113403           *}
      {****************************************************************************VA*}
//      If blnProPreTin And (fatVenda.strPromoc = 'S') Then //Troca o unitario original por conta da promocao
//      Begin
//        fatVenda.fltUniOri := IfNull(dicRetorno['preve' + strTabPre], fltPreVen);
//        fatVenda.fltUniVis := IfNull(dicRetorno['preve' + strTabPre], dicRetorno['unitar']); //Sem juros
//      End;


      fatVenda.fltPreCus := dicRetorno['precus'];

      If fatVenda.objCamGer.fVerificaCustoItemCampanha(strEmpSalResTin, fatVenda.strCodCli, strCodAtu,
                                                       strIdePro,dicRetorno['itetin'], fltCusCam) Then
        fatVenda.fltPreCus := fltCusCam;

      fatVenda.fltPreCu2 := IfNull(dicRetorno['precu2'], dicRetorno['precus']);

      If dicRetorno['unitar_sem_formatar'] = Null Then
        dicRetorno['unitar_sem_formatar'] := dicRetorno['unitar'];

      fatVenda.fltOutVal := IfNull(dicRetorno['outval'], 0);

      If IfNull(dicRetorno['acerto'], 'N') = 'S' Then
      Begin
        fatVenda.fltIcmSai := IfNull(dicRetorno['icmsai'] / dicRetorno['preco_venda_original'] * 100, 0);
        fatVenda.fltImpFed := IfNull(dicRetorno['impfed'] / dicRetorno['preco_venda_original'] * 100, 0);
        fatVenda.fltDesOpe := IfNull(dicRetorno['desope'] / dicRetorno['preco_venda_original'] * 100, 0);
      End
      Else
      Begin
        fatVenda.fltIcmSai := IfNull(dicRetorno['icmsai'] / dicRetorno['unitar_sem_formatar'] * 100, 0);
        fatVenda.fltImpFed := IfNull(dicRetorno['impfed'] / dicRetorno['unitar_sem_formatar'] * 100, 0);
        fatVenda.fltDesOpe := IfNull(dicRetorno['desope'] / dicRetorno['unitar_sem_formatar'] * 100, 0);
      End;

      fatVenda.fltSomaColorantes := IfNull(dicRetorno['somcol'], 0);
      fatVenda.fltPreMed := IfNull(dicRetorno['premed'], 0);
      fatVenda.fltImpUlt := IfNull(dicRetorno['impult'], 0);
      fatVenda.fltPreUlt := IfNull(dicRetorno['preult'], 0);

      calcCustoReal := TCalcCustoReal.Create;
      calcCustoReal.fltUnitar := fltPreVen;
      calcCustoReal.fltPreCus := fatVenda.fltPreCus;

      strCodSit := '';
      strCodAbf := fatVenda.fGetCodAbf(dicRetorno['codite'], strEmpSalResTin);
      If (Not fEmptyStr(fatVenda.GetTipAbf(strEmpSalResTin))) And (fatVenda.fBuscaAbfIcm(dicRetorno['codite'], strEmpSalResTin, strCodAbf, fatVenda.fTrocaUFEndEntrega)) Then
        strCodSit := fatVenda.cdsAbfIcm.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(strEmpSalResTin)).AsString;

      calcCustoReal.fltDifal := fatVenda.fGetAlqDifal(dicRetorno['codite'],
                                                      strEmpSalResTin,
                                                      strCodAbf,
                                                      strCodSit);

      calcCustoReal.fltFcp   := fatVenda.fGetAlqFcpIcms(dicRetorno['codite'],
                                                        strEmpSalResTin,
                                                        strCodAbf,
                                                        strCodSit,
                                                        fatVenda.fltIcmSai,
                                                        calcCustoReal.fltUnitar);

      fatVenda.fltPreCu2 := fatVenda.fRetornaPrecoCusto(Preco_de_Custo_Real,
                                                        dicRetorno['codite'],
                                                        strEmpSalResTin,
                                                        calcCustoReal.fltPreCus,
                                                        '',
                                                        calcCustoReal,
                                                        True);

      FreeAndNil(calcCustoReal);

      dicRetorno.Remove('unitar_sem_formatar');

      fatVenda.fltComAnt := dicRetorno['precus'];
      edtUnitar.Text     := FloatToStrF(fltPreVen, ffFixed, 12, fatVenda.VS_intDecUni);

      fatVenda.fltPreVe1 := IfNull(dicRetorno['preve1'], fatVenda.fltUniVis);
      fatVenda.fltPreVe2 := IfNull(dicRetorno['preve2'], fatVenda.fltUniVis);
      fatVenda.fltPreVe3 := IfNull(dicRetorno['preve3'], fatVenda.fltUniVis);
      fatVenda.fltPreVe4 := IfNull(dicRetorno['preve4'], fatVenda.fltUniVis);
      fatVenda.fltPreVe5 := IfNull(dicRetorno['preve5'], fatVenda.fltUniVis);
      fatVenda.fltPreVe6 := IfNull(dicRetorno['preve6'], fatVenda.fltUniVis);
      fatVenda.fltPreVe7 := IfNull(dicRetorno['preve7'], fatVenda.fltUniVis);

      fltFatTin          := dicRetorno['fattin'];
      fltPrcTin          := dicRetorno['prctin'];
      fltPrvTin          := dicRetorno['prvtin'];

      {*******************************************************************************}
      {* COMENTADO POIS NÃO FAZ SENTIDO MUDAR O UNIORI E UNIVIS POR CONTA DA TRAVA   *}
      {* TRAVA DE PREÇO POR VALOR MÍNIMO O TRAVAMENTO DEVE/DEVERIA TER SIDO FEITO NA *}
      {* RESPECITVA TRAVA QUANDO CFG_PROPRE = PREÇO DE TABELA REQ.: 113403           *}
      {****************************************************************************VA*}
//      If blnProPreTin And (fatVenda.strPromoc = 'S') Then //Troca o unitario original por conta da promocao
//        fltPrvTin := IfNull(dicRetorno['preve' + strTabPre], dicRetorno['prvtin']);

      fltDesOpeTinta     := IfNull(dicRetorno['desopetinta'], 0.0);

      strBaseQtdZerada   := IfNull(dicRetorno['baseqtdzerada'], '');

      If fltPrcTin <= 0 Then
        fltPrcTin := fatVenda.fltPreCus;

      If fltPrvTin <= 0 Then
        fltPrvTin := fatVenda.fltUniVis;

      If (fatVenda.blnCliFil) Then
      Begin
        if strOpcDoc = 'UC' then
        begin
          strOpcPre := fCfgSis('UCPREV');
        end
        Else If (SameText(strOpcDoc, 'PA')) Then
        begin
          strOpcPre := fCfgSis('PAPREV');
        end
        Else If Not fJaSelecionouPrecoTE Then
        Begin
          If (fatVenda.strPromoc = 'S') Then
            strOpcPre := fatVenda.strTEPPRO
          Else
            strOpcPre := fatVenda.strTEPREV;
        End;

        (************************************************************************)
        (* Quando é preco de custo ja esta sendo tratato acima no blnUsaPreCus  *)
        (*********************************************************************LA*)
        If strOpcPre = 'VE1' Then
          fltPrvTin := fatVenda.fltPreVe1

        Else If strOpcPre = 'VE2' Then
          fltPrvTin := fatVenda.fltPreVe2

        Else If strOpcPre = 'VE3' Then
          fltPrvTin := fatVenda.fltPreVe3

        Else If strOpcPre = 'VE4' Then
          fltPrvTin := fatVenda.fltPreVe4

        Else If strOpcPre = 'VE5' Then
          fltPrvTin := fatVenda.fltPreVe5

        Else If strOpcPre = 'VE6' Then
          fltPrvTin := fatVenda.fltPreVe6

        Else If strOpcPre = 'VE7' Then
          fltPrvTin := fatVenda.fltPreVe7

        Else If strOpcPre = 'MED' Then
          fltPrvTin := fatVenda.fltPreMed

        Else If strOpcPre = 'SIC' Then
          fltPrvTin := fatVenda.fltPreMed

        Else If strOpcPre = 'ULT' Then
          fltPrvTin := fatVenda.fltPreUlt

        Else If strOpcPre = 'IMP' Then
          fltPrvTin := fatVenda.fltImpUlt

        Else If strOpcPre = 'VEP' Then
          fltPrvTin := fatVenda.fltProPreVen

        Else If strOpcPre = 'CUP' Then
          fltPrvTin := fatVenda.fltProPreCus

        Else If strOpcPre = 'CSD' Then
          fltPrvTin := fCalculaCustoReal(IIF(fatVenda.strPromoc.Equals('S') And (fatVenda.fltProPreCus <> 0), fatVenda.fltProPreCus, fatVenda.fltPreCus),
                                         fatVenda.fltIcmSai,
                                         fatVenda.fltImpFed,
                                         0,
                                         fatVenda.fltOutVal)

        Else
          fltPrvTin := fatVenda.fltPreCus;

        If fatVenda.fltFat_TE > 0 Then
        Begin
          If (fatVenda.strPromoc <> 'S') Then
            fltPrvTin := fltPrvTin * fatVenda.fltFat_TE;
        End
        Else If fatVenda.fltFatTE2 > 0 Then
        Begin
          If (fatVenda.strPromoc <> 'S') Then
            fltPrvTin := fltPrvTin * fatVenda.fltFatTE2;
        End;

        fltPreVen := fltPrvTin;

        If (fCfgSis('CLIDES') = 'S') And
           (fCfgSis('DCVBVL') = 'L') Then
        Begin
          fltPreVen := fFormataFloat(fltPreVen * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
        End;

        fatVenda.fltTaxJur := 0.00;

        If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
        Begin
          fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(dicRetorno['codite'], strEmpSalResTin);
          fltPreVen := fltPreVen + fFormataFloat(fltPreVen * (fatVenda.fGetTaxVprItem(dicRetorno['codite'], strEmpSalResTin) / 100.0), 04);
        End;

        fatVenda.pCalculaValorRT(fltPreVen, fatVenda.FVal_RT);

        edtUnitar.Text := FloatToStrF(fltPreVen, ffFixed, 12, fatVenda.VS_intDecUni);

        If (fltPrvTin > 0) Then
        Begin
          fatVenda.fltUniOri := fltPreVen; //Com Juros
          fatVenda.fltUniVis := fltPrvTin; //Sem Juros
        End;
      End;

      strDesCor          := dicRetorno['descor'];
      strIteTin          := dicRetorno['itetin'];
      //strChaFor          := dicRetorno['chafor'];
      strCatalize        := dicRetorno['catali'];
      strPorper          := dicRetorno['porper'];
      strLinTin          := dicRetorno['linha_'];
      strObsColorista    := IIF(dicRetorno['obscolorista']   = Null, '', dicRetorno['obscolorista']);
      intTipoFormulacao  := IIF(dicRetorno['tipoformulacao'] = Null, 0 , dicRetorno['tipoformulacao']);
      strTipEmb          := dicRetorno['tipemb'];
      intQtdEmb          := dicRetorno['qtdemb'];
      strTipPre          := dicRetorno['tippre'];
      intLazQua          := dicRetorno['lazqua'];
      fltPreEmb          := dicRetorno['preemb'];
      fltEmbala          := dicRetorno['embala'];
      fatVenda.strCodEmb := dicRetorno['iteemb'];
      strUnidad          := IIF(dicRetorno['unidad'] = Null, '', dicRetorno['unidad']);

      pRetornaDadosTinta(strIdePro, strIteTin, dicRetorno);

      strMontad := dicRetorno['montad'];
      strA_n_o_ := dicRetorno['a_n_o_'];
      fltFatAce := IfNull(dicRetorno['fatace'], 1.0);

      {*********************************************}
      {* VARIAVEIS DE TINTAS COM DILUIÇÃO DINAMICA *}
      {******************************************PH*}
      strCoddil := IfNull(dicRetorno['coddil'], '');
      fltPorDil := IfNull(dicRetorno['pordil'], 0.0);
      strDilCon := IfNull(dicRetorno['dilcon'], '');
      fltPorCat := IfNull(dicRetorno['porcat'], 0.0);

      recForTin.intModDil := IfNull(dicRetorno['moddil'], 0);
      recForTin.strTextBase := IfNull(dicRetorno['texbas'], '');
      recForTin.strTipCor := IfNull(dicRetorno['tipcor'], '');
      recForTin.Formulas := TClassMatrizSaldosColorantes(dicRetorno.RetornaObjeto('formul'));
      recForTin.Formulas := TClassMatrizSaldosColorantes.Create(recForTin.Formulas);
      recForTin.blnTemSaldoVenda := IfNull(dicRetorno['saldocols'], True);
      recForTin.fltQtdMaximoBase := IfNull(dicRetorno['maximoqtdbase'], 0);
      recForTin.strCompB := IfNull(dicRetorno['complementob'], '');
      recForTin.strUniver := IfNull(dicRetorno['univer'], '');
      recForTin.strCatali := IfNull(dicRetorno['catal_'], '');

      //fltVolPro := IfNull(dicRetorno['volpro'], 0);

      //Foi colocado nesse ponto para nao atrapalhar o peso da FatDadosFiscais;
      pCalculaPesBruLiqTinta(recForTin.Formulas, fatVenda.strIdePro);

      If dicRetorno['codaca'] <> Null Then
      Begin

        {***********************************************}
        {* PRODUTO ACABADO, RETORNAR TABELAS DE PRECOS *}
        {********************************************PH*}
        //passella

        strCodAca := dicRetorno['codaca'];
        strEmpAca := dicRetorno['empaca'];
        fltSaldoItemAtu := dicRetorno['saldos'];

        If (chkUtiAbastDep.Checked) Then
          fltSaldoItemAtu := TProdAcabado.fRetornaSaldo(strCodAca, strEmpAca, edtCodEmp.Text);

        pCalculaSaldoPigmento();

        fltSaldoResItemAtu := 0;

        fltQtdeDigitada := fatVenda.fRetQtdDigitada(edtCodIte.Text,
                                                    '',
                                                    '',
                                                    '',
                                                    '',
                                                    edtCodEmp.Text);

        edtSalDis.Text := FormatFloat(edtQtdIte.EditFormat, (fltSaldoItemAtu - fltQtdeDigitada));
        pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
        pHintSaldoDisponivel;
      End;

      strRefere := fRetornaReferenciaTinta(strIdePro, qryTinta);

      If fEmptyStr(strRefere) Then
        strRefere := fatVenda.fRetReferenciaTinta(edtCodIte.Text);

      edtDesIte.Text := fRetornaDescricaoTinta(strIdePro, strDesCor, qryTinta, strTipPre);
      edtMulVen.Text := FloatToStrF(fRetMltVenItem(edtCodIte.Text), ffNumber, 12, 4);
      pExibeQtdeCaixaMaster(edtCodIte.Text);

      If SameText(strIdePro, 'STA') And (fGetConfTinta(strIdePro).fGet('DESPST') = 'S') Then
        edtDesIte.Text := edtDesIte.Text + ' ' + strLinTin + ' ' + strA_n_o_;

      strChaFor          := edtDesIte.Text + ' ' + strRefere;
      edtDesIte.ReadOnly := True;
      edtDesIte.TabStop  := FALSE;

      If (Not fEmptyStr(strUnidad)) Then
      begin
        edtUnidad.Text := strUnidad;
        edtSigla.Text  := fRetSiglaUnidade(strUnidad, qryCadUni);
      end;

      // pSetFocus(edtQtdIte);
      SelectNext(edtCodIte, True, True);
      pSetFocus(cmbEntRet);
      fatVenda.strIdePro := strIdePro;

      {***************************************************}
      {* NOVA MODO DE VENDA DE TINTA                     *}
      {** 05/06/2008 - 15:00 **************************MV*}
  //      If (Assigned(fTintaVendaDinamica)) And (fTintaVendaDinamica(fatVenda.strIdePro)) And (Not fTintaBaixaProduto(fatVenda.strIdePro)) Then
      If (Not fTintaBaixaProduto(fatVenda.strIdePro)) and (fatVenda.strIdePro <> 'ACA')  Then
      Begin
        pSetFocus(edtUnitar);
        pSetFocus(cmbEntRet);
        edtQtdIte.Text := FloatToStrF(intQtdEmb, ffFixed, 12, fCfgSis('DECQTD', varInteger));
  //              edtQtdIte.Enabled := False;

        edtDesIte.Text := FloatToStrF(fRetornaVolumeProduzido(dicRetorno['volpro'], strMontad, strIdePro), ffFixed, 12, 3) + ' '+edtSigla.Text+' ' + edtDesIte.Text;
      End;

      strDesOri := edtDesIte.Text;

      If ((fCfgSis('EDITIN', varBoolean)) And
          (fatVenda.strIdePro <> 'NOR'))  Then
      Begin
        edtDesIte.ReadOnly := False;
        edtDesIte.TabStop  := TRUE;
        edtUnidad.ReadOnly := False;
        edtUnidad.TabStop  := TRUE;
        pSetFocus(edtDesIte);
      End;

      {*******************************************}
      {* PRODUTO ACABADO É CONSIDERADO UM PRODU- *}
      {* TO NORMAL.                              *}
      {****************************************MV*}
      If strIdePro = 'ACA' Then
      Begin
        fatVenda.strIdePro := 'NOR';
        blnProAca := True;
      End
      Else
      Begin
        If (fltPreEmb <= 0) And (fltVolPro > 0) Then
        Begin
          If (Not fEmptyStr(fCfgSis('SENEMB'))) And (fCfgSis('AUTEMB', varBoolean)) Then
            pPedeSenhaParaVenderSemEmbalagem;
        End;
      End;

      {********************************************************************}
      {* RETORNA SE ALGUM PRODUTO DA FORMULACAO DA TINTA ESTA EM PROMOCAO *}
      {* SE TIVER NAO PODERÁ SER APLICADO O DESC. MAX POR LINHA/GRUPO     *}
      {****************************************************************AC**}
      pDefineTintaEmPromocao;

      If (fatVenda.strCAbDes = 'S') And
         (fCfgSis('CNDVEN') = 'I') And
         (fatVenda.strStatus <> 'C') And
         ((fatVenda.strPromoc <> 'S') Or
          (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
         (Not fAplicarTaxaJurosPrecoDigitado) Then
      Begin
        {********************************************************************}
        {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
        {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
        {****************************************************************MM**}
        fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

        If fCfgSis('DESCND',varBoolean) Then
        Begin
          If (fatVenda.strDstCnd = 'S') Then
          Begin
            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
            edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
          End
          Else
            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

        End

        Else If (fatVenda.strCodFpg = '007') Then
        Begin
          If (fatVenda.strAbDeCc = 'S') Then
            edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni) - fatVenda.fRetornaVrDesconto(2, fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni), fltDesMax));
        End
        Else
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni) - fatVenda.fRetornaVrDesconto(2, fFormataFloat(fatVenda.fltUniOri, fatVenda.VS_intDecUni), fltDesMax));
      End;

      If fUsaRotinaWMS(fatVenda.fEmpresaSaldoMatriz_CD) Or fCfgSis('TMQLOT', varBoolean) Or fInformaLoteBaseImobiliaria(True) Then
        pAjustaLote(edtCodIte.Text, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD), fatVenda.strIdePro, blnProAca, recForTin.Formulas)
      Else If ((fatVenda.strIdePro <> 'NOR') And (Not fCfgSis('TMQLOT', varBoolean)) And (Not fInformaLoteBaseImobiliaria)) Then
        pMostraLote(False);

      pAtualizaUnitarioLiquido;

      pEditarPrecoUnitario;

      InterlockedDecrement(intConfirmando);
    Except
      On E: Exception Do
      Begin
        InterlockedDecrement(intConfirmando);
        pMensagensErro(E.Message, '[frmFatVendas.btnTintaMaquinaClick]');
      End;
    End;
  End
  Else
    InterlockedDecrement(intConfirmando);
end;

procedure TfrmFatVendas.pVerificaDigitosNumCOO;
  Var
    qryAux : TUniQuery;
begin

  If Not Assigned(qryConDev) Then
    Exit;

  qryAux := fCriaQuery;

  With qryAux, SQL Do
  Begin
    Add('SELECT FIS_NUMCOO FROM ');
    Add(' MOVDET ');
    Add('  INNER JOIN CADFIS F ON (F.FIS_NUMDOC = DET_NUMDOC) AND ');
    Add('  (F.FIS_ESPDOC = DET_ESPDOC) AND ');
    Add('  (F.FIS_CODEMP = DET_CODEMP) AND ');
    Add('  (F.FIS_FORCLI = DET_CODCLI) AND ');
    Add('  (IFNULL(F.FIS_SERIE_, "") = IFNULL(DET_SERIE_, "")) ');
    Add(' WHERE DET_NUMDOC = :NUMDOC AND DET_CODEMP = :CODEMP  ');
    Add(' AND DET_ESPDOC = :ESPDOC ');
    ParamByName('NUMDOC').Text := qryConDev.FieldByName('DET_NUMDOC').AsString;
    ParamByName('CODEMP').Text := qryConDev.FieldByName('DET_CODEMP').AsString;
    ParamByName('ESPDOC').Text := qryConDev.FieldByName('DET_ESPDOC').AsString;
    Open;

    If Not fEmptyStr(FieldByName('FIS_NUMCOO').AsString) Then
    Begin
      If (Length(FieldByName('FIS_NUMCOO').AsString) > 6) And
         (LeftStr(FieldByName('FIS_NUMCOO').AsString,3) <> '000') Then
        fMensagem('INFORMAÇÃO','Atenção! Na emissão deste tipo de nota fiscal é referenciado o '+
                               'número do COO do cupom. O IF devolvido possui mais que 6 dígitos '+
                               'válidos nesta informação e atualmente o sistema envia apenas 6 na '+
                               'tag "NFE-REF-ECF". Por favor, entre em contato com a Citel antes de continuar.',['O K']);
    End;


  End;

  FreeAndNil(qryAux);
end;

