procedure TfrmFatVendas.pAtualizaLiberacaoUnitario(stlAutInc: TStringList);
  Var
    prcScroll: TprcScroll;
    strIncIni : String;
    intCnt : Integer;
begin
  With cdsVenda Do
  Begin
    Try
      strIncIni := FieldByName('AUTOINCREM').AsString;
      pDisableControls(cdsVenda, prcScroll);
      If (Assigned(fatVenda)) And (Assigned(fatVenda.objCopiaSegVenda)) Then
        fatVenda.objCopiaSegVenda.pDisableEventHandlers;
      Try
        For intCnt := 0 To stlAutInc.Count-1 Do
        Begin
          If cdsVenda.Locate('AUTOINCREM', stlAutInc[intCnt], []) Then
          Begin
            Edit;
            FieldByName('ITE_LIBUNI').AsString := 'S';
            Post;
          End;
        End;

        cdsVenda.Locate('AUTOINCREM', strIncIni, []);
      Finally
        If (Assigned(fatVenda)) And (Assigned(fatVenda.objCopiaSegVenda)) Then
          fatVenda.objCopiaSegVenda.pEnableEventHandlers(False, False);
      End;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmFatVendas.pAtualizaLiberacaoUnitario]');
    End;

    pEnableControls(cdsVenda, prcScroll);
  End;
end;

