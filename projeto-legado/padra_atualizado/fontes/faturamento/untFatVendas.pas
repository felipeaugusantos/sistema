function TfrmFatVendas.fTravaProdutoNaoPodeTerSeuValorAlterado: Boolean;
var
  fltValorAutorizado: Double;
  fltValorDigitado: Double;
  fltDesconto: Double;
  strIncTrava: String;
begin
  Result := False;

  if VS_IgnoraTravaAjustePrecoAutorizado then
    Exit;

  if fEmptyStr(fatVenda.strNumLib) then
    Exit;

  if cdsVenda = Nil then
    Exit;

  if not cdsVenda.Active then
    Exit;

  if cdsVenda.RecordCount <= 0 then
    Exit;

  if cdsVenda.RecNo <= 0 then
    Exit;

  strIncTrava := fCampoTabela('AUTOINCREM', 'TPMGER', ['GER_NUMLIB'], [fatVenda.strNumLib]);

  if fEmptyStr(strIncTrava) then
    Exit;

  fltValorDigitado := StrToFloatDef(edtUnitar.Text, 0);

  fltDesconto := StrToFloatDef(edtDesCon.Text, 0);

  if fltDesconto > 0 then
    fltValorDigitado := ((fltValorDigitado * fltDesconto) / 100);

  fltValorAutorizado := fCampoTabela('DET_PREAUT', 'TPMDET', ['DET_SEQFDO','DET_CODITE', 'DET_SEQGER','DET_PROALT'], [cdsVenda.FieldByName('AUTOINCREM').AsString,cdsVenda.FieldByName('ITE_CODITE').AsString,strIncTrava,'S']);

  if fltValorAutorizado > fltValorDigitado then
    Result := True;
end;

function TfrmFatVendas.fCalcularDescontoEmbFechada : Boolean;
Var strTePreco : String;
begin
  Result := True;

  If (Pos(strOpcDoc, 'UC_') > 0) Then
    Result := False
  Else If (fatVenda.blnCliFil) Then
  Begin
    If fCfgSis('ESCPTE', varBoolean) Then
    Begin
      If Not fEmptyStr(fatVenda.strPreETe) Then
        strTePreco := fatVenda.strPreETe
      Else If (fatVenda.strPromoc = 'S') Then
        strTePreco := fatVenda.strTEPPRO
      Else
        strTePreco := fatVenda.strTEPREV
    End
    Else If (fatVenda.strPromoc = 'S') Then
      strTePreco := fatVenda.strTEPPRO
    Else
      strTePreco := fatVenda.strTEPREV;

    Result := (Pos(LeftStr(strTePreco,2),'VE_') > 0);
  End;
end;

procedure TfrmFatVendas.pInsereItensPlanilha;
  Var
    intLinha, intCampos : Integer;
    blnInseriu, blnUnitarioZerado: Boolean;
    fltValorUnitario : Double;
    intDestino       : Integer;
    fltValorUnitarioOriginal: Double;
    fltValorDesconto: Double;
    dadosPromocaoPlanilha: TDadosPromocao;
    dtaEntImediataTmp : TDate;
    dtaUltimaEntImediataIncluida : TDate;
begin
  If InterlockedIncrement(IntLocked) = 0 Then
  Begin
    dtaUltimaEntImediataIncluida := 0;
    Try
      Try
        pnlInfo.Caption := 'Aguarde... Inserindo Produtos.';
        pnlDadosItemFixo.Visible := False;
        pgbProgresso.Visible     := True;
        pgbProgresso.Max         := ObjInterfaceImportaPlanilha.LinhasImportadas.Count;

        For intLinha := 0 to ObjInterfaceImportaPlanilha.LinhasImportadas.Count -1 Do
        Begin
          If (Self.FCancelouImportacaoPlanilha) Then
            Exit;

          blnUnitarioZerado     := False;
          pgbProgresso.Position := intLinha;
          pProcessMessages;
          btnCancelaItem.Click;
          blnInseriu               := False;
          blnInserindoItemPlanilha := True;
          fltValorUnitario         := 0.00;
          intDestino               := -1;
          fltValorUnitarioOriginal := 0.00;
          fltValorDesconto         := 0.00;

          For intCampos := 0 to ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos.Count -1 Do
          Begin
            If (Self.FCancelouImportacaoPlanilha) Then
              Exit;

            If not fEmptyStr(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo) Then
            Begin
              {Código Item}
              If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_CODITE'  Then
              Begin
                edtCodIte.Text := ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo;
                blnInseriu := fValidaCampos(edtCodIte);
              End;
              {Quantidade Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_QTDITE')  Then
              Begin
                If edtQtdIte.ReadOnly Then
                Begin
                  edtQtdPec.Text := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger), False), fStrToFloat( ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo ));
                  edtQtdIte.Text := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger), False), fStrToFloat( ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo ));
                End
                Else
                  edtQtdIte.Text := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger), False), fStrToFloat( ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo ));

                edtQtdIteExit(edtQtdIte);
                blnInseriu := fValidaCampos(edtQtdIte);
              End;
              {Destino Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_ENTRET')  Then
              Begin
                If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'E' Then
                  cmbEntRet.ItemIndex := 0
                Else
                  cmbEntRet.ItemIndex := 1;

                blnInseriu := fValidaCampos(cmbEntRet);
                intDestino := cmbEntRet.ItemIndex;
              End;
              {Valor Unitario Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_UNIDIG')  Then
              Begin
                If fStrToFloat(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo) > 0 Then
                Begin
                  fltValorUnitarioOriginal := fStrToFloat(edtUnitar.Text);
                  edtUnitar.Text := FormatFloat(fMskDigitos(fCfgSis('DECUNI', varInteger), False), fStrToFloat(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo));
                  blnInseriu := fValidaCampos(edtUnitar);
                  fltValorUnitario := fStrToFloat(edtUnitar.Text);
                End
                Else
                  blnUnitarioZerado := True;
              End;

              If (blnInseriu) And (blnUnitarioZerado) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_UNITAR')  Then
              Begin
                If fStrToFloat(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo) > 0 Then
                Begin
                  fltValorUnitarioOriginal := fStrToFloat(edtUnitar.Text);
                  edtUnitar.Text := FormatFloat(fMskDigitos(fCfgSis('DECUNI', varInteger), False), fStrToFloat(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo));

                  blnInseriu        := fValidaCampos(edtUnitar);
                  blnUnitarioZerado := False;
                  fltValorUnitario  := fStrToFloat(edtUnitar.Text);
                End;
              End;
              {Desconto Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_DESCON')  Then
              Begin
                edtDesCon.Text := FormatFloat(fMskDigitos(2, False), fStrToFloat( ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo ));
                fltValorDesconto := fStrToFloat(edtDesCon.Text);
                blnInseriu := fValidaCampos(edtDesCon);
              End;
              {Tabela Preço Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_TABPRE') And
                 ((fCfgSis('TABITE', varBoolean) And (fCfgSis('UTAPTB') = 0))) Then
              Begin
                If cbTabPrecoItem.Items.IndexOf(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo) > -1 Then
                Begin
                  cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo);
                  blnInseriu := fValidaCampos(cbTabPrecoItem);
                End;

                {Alimentar novamente o Valor Unitário, pois ele é atualizando quando se troca a tabela de preço - KM}
                If (blnInseriu) Then
                Begin
                  If fltValorUnitario > 0 Then
                    edtUnitar.Text := FormatFloat(fMskDigitos(2, False), fltValorUnitario);
                End;
              End;
              {Complemento Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_COMPLE') And
                 (fCfgSis('FATCOM', varBoolean)) Then
              Begin
                cbbComple.Items.Add(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo);

                cbbComple.ItemIndex := -1;
                if (cbbComple.Items.IndexOf(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo) > -1) then
                begin
                  cbbComple.ItemIndex := cbbComple.Items.IndexOf(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo);
                end;
                blnInseriu := fValidaCampos(cbbComple);
              End;
              {Unidade Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_CODUNI') And
                 ((fCfgSis('EDIFAT', varBoolean)) Or  (fCfgSis('EDITIN', varBoolean)) Or (Copy(fCfgSis('ITEESP', varString), 1, 2) = 'SS')) Then
              Begin
                edtUnidad.Text := ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo;
                blnInseriu := fValidaCampos(edtUnidad);
              End;
              {Empresa Faturamento Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_EMPFAT') And
                 (fCfgSis('EMPFAT', varBoolean))  Then
              Begin
                edtCodEmp.Text := ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo;
                blnInseriu := fValidaCampos(edtCodEmp);

                {Alimentar novamente o Destino, pois ele é atualizando quando se informa a empresa - KM}
                If (blnInseriu) Then
                Begin
                  If intDestino > -1 Then
                    cmbEntRet.ItemIndex := intDestino;
                End;
              End;
              {Lote Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_NUMLOT')  Then
              Begin
                edtNumLot.Text := ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo;
                blnInseriu := fValidaCampos(edtNumLot);

                {Alimentar novamente o Valor Unitário, pois ele é atualizando quando se informa o lote - KM}
                If (blnInseriu) Then
                Begin
                  If fltValorUnitario > 0 Then
                    edtUnitar.Text := FormatFloat(fMskDigitos(2, False), fltValorUnitario);
                End;
              End;
              {Local Retira Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_LOCRET') And
                 (fCfgSis('LOCRET', varBoolean))  Then
              Begin
                cmbLocRet.ItemIndex := fRetLocalRetira(ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo);

                blnInseriu := fValidaCampos(cmbLocRet);
              End;
              {Tipo Entrega Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_ENTFUT') And
                 (fCfgSis('ENTFUT', varBoolean)) Then
              Begin
                If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'F' Then
                  cmbTipEnt.ItemIndex := 0
                Else
                  cmbTipEnt.ItemIndex := 1;
                blnInseriu := fValidaCampos(cmbTipEnt);
              End;
              {Motivo Entrega Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_MOTFUT') And
                  (fCfgSis('ENTFUT', varBoolean)) Then
              Begin
                If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'F' Then
                  cmbMotEntFut.ItemIndex := 0
                Else If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'A' Then
                  cmbMotEntFut.ItemIndex := 1
                Else
                  cmbMotEntFut.ItemIndex := 2;
                blnInseriu := fValidaCampos(cmbMotEntFut);
              End;
              {Cliente retira?}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_CLIBUS') And
                 (fCfgSis('ENTFUT', varBoolean) And fCfgSis('CLBUEF', varBoolean))  Then
              Begin
                If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'S' Then
                  cmbCliBus.ItemIndex := 0
                Else
                  cmbCliBus.ItemIndex := 1;
                blnInseriu := fValidaCampos(cmbCliBus);
              End;
              {Dias Entrega Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_DIAFOR')  Then
              Begin
                edtDiaEnt.Text := ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo;
                blnInseriu := fValidaCampos(edtDiaEnt);
              End;
              {Data Entrega Item}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_DTENTR')  Then
              Begin
                mskDtaEnt.Text := ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo;
                blnInseriu := fValidaCampos(mskDtaEnt);
              End;
              {Pegou?}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_PEGOU_') And
                 (fCfgSis('PEGPED', varBoolean))  Then
              Begin
                If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'S' Then
                  chkPegou.Checked := True
                Else
                  chkPegou.Checked := False;
                blnInseriu := fValidaCampos(chkPegou);
              End;
              {Brinde}
              If (blnInseriu) And
                 (ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.NomeCampo = 'ITE_BRINDE') And
                 (fCfgSis('USABRI', varBoolean)) Then
              Begin
                If ObjInterfaceImportaPlanilha.LinhasImportadas[intLinha].Campos[intCampos].Propriedades.Conteudo = 'S' Then
                  chkBrinde.Checked := True
                Else
                  chkBrinde.Checked := False;
                blnInseriu := fValidaCampos(chkPegou);
              End;
            End;
          End;

          If (fStrToFloat(edtUnitar.Text) = 0) Then
          Begin
            fMensagem('', 'O unitário do item ' + edtCodIte.Text + ' - ' + edtDesIte.Text + ' não pode ser zero!', ['&OK']);
            blnInseriu := False;
          End;

          If (fltValorUnitarioOriginal > 0) And (fStrToFloat(edtUnitar.Text) <> fltValorUnitarioOriginal) And (fCfgSis('EDIUNP', varString) = 'N') Then
          Begin
            dadosPromocaoPlanilha := fDadosPromocao(edtCodIte.Text,
                                                    fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                                    edtCodCli.Text,
                                                    fTabelaPrecoItem);

            If Not fEmptyStr(dadosPromocaoPlanilha.strCodPro) Then
            Begin
              If fMensagem('ATENÇÃO', 'Foi informado valor para item procional e o sistema está configurado para não permitir '+sLineBreak+
                                      'alterar o valor unitário do item em promoção (CFG_EDIUNP).'+sLineBreak+
                                      'Deseja prosseguir com a importação dos outros itens?', ['&Sim', '&Não']) = 2 Then
              Begin
                Exit;
              End
              Else
              Begin
                Continue;
              End;

            End;
          End;

          If (fltValorDesconto > 0) And (edtDescon.ReadOnly) Then
          Begin
            If fMensagem('ATENÇÃO', 'Foi informado desconto no item e o sistema está configurado para não permitir desconto neste cenário.'+sLineBreak+
                                    'Deseja prosseguir com a importação dos outros itens?', ['&Sim', '&Não']) = 2 Then
            Begin
              Exit;
            End
            Else
            Begin
              Continue;
            End;
          End;

          If blnInseriu Then
          Begin
            dtaEntImediataTmp := 0;
            If (cmbEntRet.ItemIndex = IDX_ENTREGA) And
               (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
              dtaEntImediataTmp := StrToDateDef(mskDtaEnt.Text, 0);

            btnAdicionar.Click;
            blnInserindoItemPlanilha := False;

            If (not blnGravouItemPlanilha) Then
            Begin
              If fMensagem('',
                'O item anterior não foi inserido, deseja continuar?',
                ['', '']) = 2 Then
              Begin
                Break;
                Exit;
              End;
            End
            Else
            Begin
              If (dtaEntImediataTmp > 0) Then
                dtaUltimaEntImediataIncluida := dtaEntImediataTmp;
            End;

            btnCancelaItem.Click;
          End
          Else
          Begin
            blnInserindoItemPlanilha := False;
            If fMensagem('',
              'O item anterior não foi inserido, deseja continuar?',
              ['', '']) = 2 Then
            Begin
              Break;
              Exit;
            End;
          End;
        End;
      Finally
        If (dtaUltimaEntImediataIncluida > 0) And (fCfgSis('PDVIME', varString) = 'N') And (Pos(strOpcDoc, 'OR_PD_VN_') > 0) Then
          pAlteraDataEntregaImediataItens(dtaUltimaEntImediataIncluida);
        pnlDadosItemFixo.Visible := True;
        pgbProgresso.Visible     := False;
        blnInserindoItemPlanilha := False;
        pnlInfo.Caption := '';
        InterlockedDecrement(IntLocked);
      End;
    Except
      On E: Exception Do
        fMensagem('', 'Erro ao inserir itens da planilha: ' + E.Message, ['&OK']);
    End;
  End
  Else
    InterlockedDecrement(IntLocked);
end;

