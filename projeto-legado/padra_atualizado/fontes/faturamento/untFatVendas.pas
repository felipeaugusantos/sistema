  Else
  Begin

    pnlRepresentante.Enabled := False;
    pnlRepresentante.Visible := False;

    If blnPrimVez Then
      pnlCabecalho.Height := pnlCabecalho.Height - pnlRepresentante.Height;
  End;

  {*****************************************}
  {* VERIFICA SE UTILIZA ENTREGA PELO CD.  *}
  {* VERIFICA SE VAI HABILITAR A ENTREGA   *}
  {* CD NA MATRIZ TAMBÉM.                  *}
  {**************************************MV*}
  blnEtCdMt := fCfgSis('ETCDMT', varBoolean);
  If (Not fCfgSis('ENT_CD', varBoolean))                       Or
     ( (VS_strCodEmp = fCfgSis('EMP_CD')) And (Not blnEtCdMt)) Or
     (Pos(strOpcDoc, 'PD_OR_') <= 0)                         Then
  Begin
    If Not blnVisLim Then 
      pnlEntCD.Visible := False;

    chkEntCD.Visible := False;
  End
  Else
  Begin
    pnlEntCD.Visible := True;

    If fEmptyStr(fatVenda.strNumOrc) Then
    Begin
      if not blnHerancaOrcamentoPedido then
      begin
        chkEntCD.Checked := fCfgSis('SUGECD', VarBoolean);
        blnEnt_CDAnt     := chkEntCD.Checked;
      end;
    End;
  End;

  If fCfgSis('EMPFAT', VarBoolean) Then
  Begin
    pnlEntCD.Visible := False;
    chkEntCD.Visible := False;
    chkEntCD.Checked := False;
    blnEnt_CDAnt     := False;
  End;

  If (fCfgSis('USACCR', varBoolean)) And
     (Pos(strOpcDoc, 'OR_PD_VN_CN_') > 0) Then
  Begin
    pnlEntCD.Visible := pnlEntCD.Visible Or (Not MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL,J_A_MASSA_CONCRETO]));
    chkDesmembrarNF_NS.Visible := (Not MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL,J_A_MASSA_CONCRETO]));

    If (Pos(strOpcDoc, 'VN_CN_') > 0) And (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      fatVenda.blnDesmembrarNotaProdutosServicos := False;

  End
  Else
  Begin
    chkDesmembrarNF_NS.Visible := False;

    {*********************************************************}
    {* NÃO DESMEMBRA PRODUTO DE SERVIÇO PARA OUTRAS ENTRADAS *}
    {******************************************************PZ*}
    If (Pos(strOpcDoc, 'OE_EF_') > 0) Then
      fatVenda.blnDesmembrarNotaProdutosServicos := False;

  end;

  chkUtiAbastDep.Checked := fatVenda.blnAbastecimentoDeposito;
  chkRegEsp2.Checked := fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo;
  if chkUtiAbastDep.Checked and chkEntCD.Checked then
    chkEntCD.Checked := False;

  If (fCfgSis('OPRFLJ', varBoolean))   And
     (VS_strCodEmp <> VS_strEmpPrd)    And
     (Pos(strOpcDoc, 'OR_PD_VN_CS_BR_UC_OU_') > 0) Then
  Begin
    lblOprFlj.Visible   := True;
    edtOprFlj.Visible   := True;
    pVerificaTamanhoPnlCliente;

    If (Not fEmptyStr(strNumOrc)) And (blnPrimeiraVez) And (Not chkUtiAbastDep.Checked) Then
      edtOprFlj.Text := fatVenda.strOprFlj;
  End;

  btnEndEnt.Visible := fatVenda.fPermiteEnderecoEntrega;

  pnlTipEmp.Visible := (strOpcDoc = 'EP');
  pnlPlacaVeiculo.Visible := fatVenda.fEhAutocenter;

  pnlEmprestimoPlaca.Visible := pnlTipEmp.Visible Or pnlPlacaVeiculo.Visible;

  mnuAltMecanicos.Visible := pnlPlacaVeiculo.Visible;

  If (strOpcDoc = 'EP') Then
  Begin
    strCndAnt             := fCndEmp;
    fatVenda.strConPag    := strCndAnt;
    mskCndPag.Text        := strCndAnt;
    mskCndPag.Enabled     := False;
    edtDesCndPag.Text     := strCndAnt;

    If (fatVenda.VS_blnUsaFpg) Then
      fatVenda.strCodFpg  := IIF(fCndEmp = '01000', '001', '008');

    pEditarDesconto;

    If blnPrimVez And pnlForPag.Visible Then
      pnlCabecalho.Height := pnlCabecalho.Height - pnlForPag.Height;
    pnlForPag.Visible     := False;

  End;

  If (fEmissaoNFVendaABaseDeTroca) Then
  Begin
    edtCodCnd.Text     := fCfgSis('CNDAVI', varString);
    mskCndPag.Text     := '01000';
    fatVenda.strCodCnd := edtCodCnd.Text;
    fatVenda.strConPag := mskCndPag.Text;
  End;

  If blnPrimVez And Not pnlEmprestimoPlaca.Visible Then
    pnlCabecalho.Height := pnlCabecalho.Height - pnlEmprestimoPlaca.Height;

  blnHabilitaCndPag := mskCndPag.Enabled;

  If Not fatVenda.fDocumentoParaFornecedor Then
  Begin
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (fCfgSis('CLIDES') = 'S') Then
      edtDesPro.Text := FormatFloat('#,##0.00', qryConCli.FieldByName('CLI_DESCON').AsFloat)
    Else
      edtDesPro.Text := '0,00';
  End
  Else
    edtDesPro.Text := '0,00';

  pAjustaTamanhoDescricaoItemGrid;

  fFindColumnByName(dbgItens, 'ITE_MARLUC').Visible := (fCfgSis('EXBMRG', varString) = 'S');
  fFindColumnByName(dbgItens, 'ITE_COMVEN').Visible := (fCfgSis('EXBCOM', varString) = 'S');

  blnAdicionando := False;

  pCarregaLocalRetira(cmbLocRet.Items);
  pSetaCampoDestino;

  chkEmpresaPrioridade.Enabled := (fCfgSis('VPEPED', varString) = 'N') Or ((fCfgSis('VPEPED', varString) = 'S') And (fEmptyStr(strNumOrc)));

  If (ckbAbCrAu.Visible) And
     (fatVenda.blnUtiAbaAutoCredPend) And
     (fGetTotalCredCli(fatVenda.strCodCli,
                       strNumOrc,
                       strEspOrc,
                       strEmpOrc,
                       blnUsaEmpOri) > 0) Then
  Begin
    ckbAbCrAu.Checked := True;
  End;
End;

procedure TfrmFatVendas.pCarregaUltimaVenda;
var
  qryUltVnd: TUniQuery;
  qryPreAlt: TUniQuery;
  strTipUlv: String;
  strHint  : String;
begin
  strHint := EmptyStr;
  pnlUltVnd.Visible := False;
  strTipUlv := fCfgSis('TIPULV', varString);

  if (not fCfgSis('USAULV', varBoolean)) or (strTipUlv = '0000') then
    Exit;

  qryUltVnd := fCriaQuery;
  try
    if (strTipUlv[1] = '1') or (strTipUlv[2] = '1') then
    begin
      qryUltVnd.SQL.Add('(');
      qryUltVnd.SQL.Add('SELECT ');
      qryUltVnd.SQL.Add('  IF(FDO_ESPDOC = "PD", "Pedido", "Orçamento") AS TIPO,');
      qryUltVnd.SQL.Add('  FDO_DTAENT AS DTAENT,');
      qryUltVnd.SQL.Add('  FDO_HORENT AS HORENT,');
      qryUltVnd.SQL.Add('  FDO_NUMDOC AS NUMDOC,');
      qryUltVnd.SQL.Add('  FDO_ESPDOC AS ESPDOC,');
      qryUltVnd.SQL.Add('  FDO_CODEMP AS CODEMP,');
      qryUltVnd.SQL.Add('  FDO_QTDITE AS QTDITE,');
      qryUltVnd.SQL.Add('  FDO_UNITAR AS UNITAR,');
      qryUltVnd.SQL.Add('  FDO_UNIORI AS UNIORI,');
      qryUltVnd.SQL.Add('  FDO_UNIDIG AS UNIDIG,');
      qryUltVnd.SQL.Add('  FDO_CODVEN AS CODVEN,');
      qryUltVnd.SQL.Add('  FDO_PROMOC AS PROMOC,');
      qryUltVnd.SQL.Add('  ""         AS MOTIVO ');
      qryUltVnd.SQL.Add(' FROM FATDOR');
      qryUltVnd.SQL.Add('WHERE FDO_ESPDOC IN ("XX"'+IIF(strTipUlv[1]='1',',"OR"','')+IIF(strTipUlv[2]='1',',"PD"','')+')');
      qryUltVnd.SQL.Add('  AND FDO_CODCLI = :CODCLI ');
      qryUltVnd.SQL.Add('  AND FDO_CODITE = :CODITE ');
      qryUltVnd.SQL.Add('  AND DATEDIFF(CURRENT_DATE, FDO_DTAENT) < :DIA ');
      qryUltVnd.SQL.Add('ORDER BY FDO_DTAENT DESC, FDO_HORENT DESC       ');
      qryUltVnd.SQL.Add('LIMIT 1 ');
      qryUltVnd.SQL.Add(')');
    end;

    if strTipUlv[3] = '1' then
    begin
      if not fEmptyStr(qryUltVnd.SQL.Text) then
        qryUltVnd.SQL.Add('UNION ALL ');

      qryUltVnd.SQL.Add('(');
      qryUltVnd.SQL.Add('SELECT ');
      qryUltVnd.SQL.Add('  "Venda" AS TIPO,');
      qryUltVnd.SQL.Add('  DET_DTAENT AS DTAENT,');
      qryUltVnd.SQL.Add('  DET_HORENT AS HORENT,');
      qryUltVnd.SQL.Add('  DET_NUMDOC AS NUMDOC,');
      qryUltVnd.SQL.Add('  DET_ESPDOC AS ESPDOC,');
      qryUltVnd.SQL.Add('  DET_CODEMP AS CODEMP,');
      qryUltVnd.SQL.Add('  DET_QTDITE AS QTDITE,');
      qryUltVnd.SQL.Add('  DET_UNITAR AS UNITAR,');
      qryUltVnd.SQL.Add('  DET_UNIORI AS UNIORI,');
      qryUltVnd.SQL.Add('  DET_UNIDIG AS UNIDIG,');
      qryUltVnd.SQL.Add('  DET_CODVEN AS CODVEN,');
      qryUltVnd.SQL.Add('  DET_PROMOC AS PROMOC,');
      qryUltVnd.SQL.Add('  ""         AS MOTIVO ');
      qryUltVnd.SQL.Add(' FROM MOVDET     ');
      qryUltVnd.SQL.Add('WHERE DET_CODCLI = :CODCLI ');
      qryUltVnd.SQL.Add('  AND DET_CODITE = :CODITE ');
      qryUltVnd.SQL.Add('  AND DATEDIFF(CURRENT_DATE, DET_DTAENT) < :DIA ');
      qryUltVnd.SQL.Add('  AND ((LOCATE(DET_CLAFIS, :CLAVEN) > 0) OR (LOCATE(DET_CLAFIS, :CLADEV) > 0)) ');
      qryUltVnd.SQL.Add('ORDER BY DET_DTAENT DESC, DET_HORENT DESC       ');
      qryUltVnd.SQL.Add('LIMIT 1 ');
      qryUltVnd.SQL.Add(')');

      qryUltVnd.SQL.Add('UNION ALL ');

      qryUltVnd.SQL.Add('(');
      qryUltVnd.SQL.Add('SELECT ');
      qryUltVnd.SQL.Add('  "Venda" AS TIPO,');
      qryUltVnd.SQL.Add('  DET_DTAENT AS DTAENT,');
      qryUltVnd.SQL.Add('  DET_HORENT AS HORENT,');
      qryUltVnd.SQL.Add('  DET_NUMDOC AS NUMDOC,');
      qryUltVnd.SQL.Add('  DET_ESPDOC AS ESPDOC,');
      qryUltVnd.SQL.Add('  DET_CODEMP AS CODEMP,');
      qryUltVnd.SQL.Add('  DET_QTDITE AS QTDITE,');
      qryUltVnd.SQL.Add('  DET_UNITAR AS UNITAR,');
      qryUltVnd.SQL.Add('  DET_UNIORI AS UNIORI,');
      qryUltVnd.SQL.Add('  DET_UNIDIG AS UNIDIG,');
      qryUltVnd.SQL.Add('  DET_CODVEN AS CODVEN,');
      qryUltVnd.SQL.Add('  DET_PROMOC AS PROMOC,');
      qryUltVnd.SQL.Add('  ""         AS MOTIVO ');
      qryUltVnd.SQL.Add(' FROM NOTDET           ');
      qryUltVnd.SQL.Add('WHERE DET_CODCLI = :CODCLI ');
      qryUltVnd.SQL.Add('  AND DET_CODITE = :CODITE ');
      qryUltVnd.SQL.Add('  AND DATEDIFF(CURRENT_DATE, DET_DTAENT) < :DIA ');
      qryUltVnd.SQL.Add('  AND ((LOCATE(DET_CLAFIS, :CLAVEN) > 0) OR (LOCATE(DET_CLAFIS, :CLADEV) > 0)) ');
      qryUltVnd.SQL.Add('ORDER BY DET_DTAENT DESC, DET_HORENT DESC       ');
      qryUltVnd.SQL.Add('LIMIT 1 ');
      qryUltVnd.SQL.Add(')');
    end;

    if strTipUlv[4] = '1' then
    begin
      if not fEmptyStr(qryUltVnd.SQL.Text) then
        qryUltVnd.SQL.Add('UNION ALL ');

      qryUltVnd.SQL.Add('(');
      qryUltVnd.SQL.Add('SELECT ');
      qryUltVnd.SQL.Add('  "Venda Perd." AS TIPO,');
      qryUltVnd.SQL.Add('  VPG_DTACAD AS DTAENT,');
      qryUltVnd.SQL.Add('  NULL       AS HORENT,');
      qryUltVnd.SQL.Add('  VPG_NUMDOC AS NUMDOC,');
      qryUltVnd.SQL.Add('  VPG_ESPDOC AS ESPDOC,');
      qryUltVnd.SQL.Add('  VPG_CODEMP AS CODEMP,');
      qryUltVnd.SQL.Add('  VPD_QTDITE AS QTDITE,');
      qryUltVnd.SQL.Add('  VPD_UNITAR AS UNITAR,');
      qryUltVnd.SQL.Add('  VPD_UNIORI AS UNIORI,');
      qryUltVnd.SQL.Add('  VPD_UNITAR AS UNIDIG,');
      qryUltVnd.SQL.Add('  VPG_CODVEN AS CODVEN,');
      qryUltVnd.SQL.Add('  "N"        AS PROMOC,');
      qryUltVnd.SQL.Add('  MOT_DESMOT AS MOTIVO');
      qryUltVnd.SQL.Add('FROM MOVVPG INNER JOIN MOVVPD ');
      qryUltVnd.SQL.Add('  ON VPG_CODEMP = VPD_CODEMP ');
      qryUltVnd.SQL.Add(' AND VPG_CODIGO = VPD_CODIGO ');
      qryUltVnd.SQL.Add('LEFT JOIN MOTVPD ON MOT_CODMOT = VPD_CODMOT ');
      qryUltVnd.SQL.Add('WHERE VPG_CODCLI = :CODCLI ');
      qryUltVnd.SQL.Add('  AND VPD_CODITE = :CODITE ');
      qryUltVnd.SQL.Add('  AND DATEDIFF(CURRENT_DATE, VPG_DTACAD) < :DIA ');
      qryUltVnd.SQL.Add('ORDER BY VPG_DTACAD DESC                        ');
      qryUltVnd.SQL.Add('LIMIT 1 ');
      qryUltVnd.SQL.Add(')');
    end;

    qryUltVnd.SQL.Text := 'SELECT * FROM ('+qryUltVnd.SQL.Text+') AS VW '+
                          'ORDER BY DTAENT DESC, HORENT DESC '+
                          'LIMIT 1';

    qryUltVnd.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
    qryUltVnd.ParamByName('CODITE').AsString := IIF(dbgItens.Focused,cdsVenda.FieldByName('ITE_CODITE').AsString, fCodItem);
    qryUltVnd.ParamByName('DIA').AsInteger   := fCfgSis('DIAULV', VarInteger);

    if strTipUlv[3] = '1' then
    begin
      qryUltVnd.ParamByName('CLAVEN').AsString := VS_strClaVen;
      qryUltVnd.ParamByName('CLADEV').AsString := VS_strClaDev;
    end;

    qryUltVnd.Open;
    pnlUltVnd.Visible := not qryUltVnd.IsEmpty;
    if pnlUltVnd.Visible then
    begin
      If (qryUltVnd.FieldByName('PROMOC').AsString = 'S') Then
      Begin
        If (Not fEmptyStr(strHint)) Then
          strHint := strHint
                   + #13#10;

        strHint := strHint
                 + 'Produto estava em Promoção.';
      End;

      fltUniUltVnd := 0;
      If (fCfgSis('APLPRC') = '1') Then
        fltUniUltVnd := qryUltVnd.FieldByName('UNITAR').AsFloat
      Else If (fCfgSis('APLPRC') = '2') Then
        fltUniUltVnd := qryUltVnd.FieldByName('UNIORI').AsFloat
      Else If (fCfgSis('APLPRC') = '3') Then
        fltUniUltVnd := qryUltVnd.FieldByName('UNIDIG').AsFloat;

      lblUltVndTip.Caption    := qryUltVnd.FieldByName('TIPO').AsString + ':';
      lblUltVndDta.Caption    := qryUltVnd.FieldByName('DTAENT').AsString;
      lblUltVndQtd.Caption    := FormatFloat(edtQtdIte.EditFormat, qryUltVnd.FieldByName('QTDITE').AsFloat);
      lblUltVndUni.Caption    := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniUltVnd);
      lblUltVndUniLiq.Caption := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), qryUltVnd.FieldByName('UNITAR').AsFloat);

      If fltUniUltVnd > fStrToFloat(edtUnitar.Text) Then
      Begin
        lblUltVndUni.Font.Color    := clBlue;
        lblUltVndUniLiq.Font.Color := clBlue;
      End
      Else If fltUniUltVnd < fStrToFloat(edtUnitar.Text) Then
      Begin
        lblUltVndUni.Font.Color    := clRed;
        lblUltVndUniLiq.Font.Color := clRed;
      End
      Else
      Begin
        lblUltVndUni.Font.Color    := clBlack;
        lblUltVndUniLiq.Font.Color := clBlack;
      End;

      lblUltVndVen.Caption := fRetNomeOperador(qryUltVnd.FieldByName('CODVEN').AsString);
      lblUltVndMot.Caption := qryUltVnd.FieldByName('MOTIVO').AsString;

      pnlUltVndMot.Visible := not fEmptyStr(qryUltVnd.FieldByName('MOTIVO').AsString);

      qryPreAlt := fCriaQuery;
      try
        qryPreAlt.SQL.Add('SELECT ');
        qryPreAlt.SQL.Add('  ALT_DTAALT ');
        qryPreAlt.SQL.Add('FROM');
        qryPreAlt.SQL.Add('  PREALT ');
        qryPreAlt.SQL.Add('WHERE ALT_CODITE = :CODITE ');
        qryPreAlt.SQL.Add('  AND ALT_CODEMP = :CODEMP ');
        qryPreAlt.SQL.Add('  AND ALT_DTAALT > :DTAALT ');

        qryPreAlt.ParamByName('CODITE').AsString := IIF(dbgItens.Focused,cdsVenda.FieldByName('ITE_CODITE').AsString, fCodItem);
        qryPreAlt.ParamByName('CODEMP').AsString := VS_strCodEmp;
        qryPreAlt.ParamByName('DTAALT').AsDateTime := qryUltVnd.FieldByName('DTAENT').AsDateTime;

        qryPreAlt.Open;

        If (Not qryPreAlt.IsEmpty) And
           (Not fEmptyStr(qryPreAlt.FieldByName('ALT_DTAALT').AsString)) Then
        Begin
          If (Not fEmptyStr(strHint)) Then
            strHint := strHint
                     + #13#10;

          strHint := strHint
                  + 'Houve alteração no custo deste produto em ' + qryPreAlt.FieldByName('ALT_DTAALT').AsString
        End;

        imgUltVnd.Visible := (Not fEmptyStr(strHint));
        if imgUltVnd.Visible then
          imgUltVnd.Hint := strHint;
      finally
        FreeAndNil(qryPreAlt);
      end;

    end;
  finally
    FreeAndNil(qryUltVnd);
  end;
end;

procedure TfrmFatVendas.pCarregaPrecoTE;
  Var
    intIndice: Integer;
    strTePreco: String;
Begin
  If (fatVenda.blnCliFil) And (fCfgSis('ESCPTE', varBoolean)) And (Pos(fatVenda.strOpcDoc, 'PA_BR_UC_') = 0) Then
  Begin
    pnlPrecoTE.Visible := True;

    If edtMargem.Visible Then
      pnlPrecoTE.left    := 174
    Else
      pnlPrecoTE.left    := 30;

    If (fatVenda.strPromoc = 'S') Then
      strTePreco := fatVenda.strTEPPRO
    Else
      strTePreco := fatVenda.strTEPREV;

    With cbxPreTes Do
    Begin
      Clear;
      Items.Add('de Custo');
      Items.Add('Últ. Compra');
      Items.Add('Últ. Compra + Impostos');
      Items.Add('Médio');
      If fCfgSis('UTISIC', varBoolean) Then
        Items.Add('Médio sem ICMS');

      For intIndice := 1 To Length(VS_strTabVen) Do
        If VS_strTabVen[intIndice] = 'S' Then
          Items.Add('de Venda ' + IntToStr(intIndice));

      If ItemIndex < 0 Then
      Begin
        If strTePreco = 'CUS' Then
          ItemIndex := 0
        Else If (strTePreco = 'ULT') Then
          ItemIndex := 1
        Else If (strTePreco = 'IMP') Then
          ItemIndex := 2
        Else If (strTePreco = 'MED') Then
          ItemIndex := 3
        Else If (strTePreco = 'SIC') And fCfgSis('UTISIC', varBoolean) Then
          ItemIndex := 4
        Else
          ItemIndex := items.IndexOf('de Venda ' + RightStr(strTePreco, 1));

        cbxPreTesChange(cbxPreTes);
      End;
    End;
  End

  Else pnlPrecoTE.Visible := False;

End;

function TfrmFatVendas.fItemUtilizaLocalDeRetira: Boolean;
begin
  Result := False;

  If (Not pnlLocRet.Visible) Then
    Exit;

  If (Not cmbLocRet.Visible) Then
    Exit;

  Result := True;
end;

procedure TfrmFatVendas.pCarregarEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque(const strCodCli : String);
  const
    SQL = 'SELECT MSA_CODEMP FROM EXEMSA WHERE MSA_CODCLI = :CODCLI';
  var
    qryExcecao : TUniQuery;
begin

  qryExcecao := fCriaQuery();

  strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque := '';

  Try

    qryExcecao.Close;
    qryExcecao.SQL.Clear;
    qryExcecao.SQL.Add(SQL);
    qryExcecao.ParamByName('CODCLI').AsString := strCodCli;
    qryExcecao.Open;

    qryExcecao.First;
    While Not qryExcecao.Eof Do
    Begin
      pIncrementaListaStr(qryExcecao.FieldByName('MSA_CODEMP').AsString, strEmpresasQueOClienteNaoPodeComprarNaPrioridadeDeSaidaDeEstoque, True, True, ',', False);
      qryExcecao.Next;
    End;

  Finally
    FreeAndNil(qryExcecao);
  End;

end;

procedure TfrmFatVendas.pMostraLote(blnMostrar: Boolean);
Begin
  blnVendeTudoLote               := False;
  pnlItemLote.Visible            := blnMostrar and (not fatVenda.fDefinirLoteDevolucaoNaBaixa);
  pnlQtdVariasChapasLote.Visible := blnEnabledVariasChapasLote and blnMostrar
    and qryConCit.Active and (qryConCit.FieldByName('ITE_GRAMAR').AsString = 'S');

  btnLoteRapido.Visible := fCfgSis('LOTRAP',varBoolean) and (btnAdicionar.Tag = 0);
End;

procedure TfrmFatVendas.FormShortCut(var Msg: TWMKey; var Handled: Boolean);
Var
  Rect: TRect;
  fltQtdeTab: Double;
  strAmbiente: String;
begin
  inherited;
  If Not dbgItens.Focused Then
    Exit;

  If (Msg.CharCode <> VK_TAB) Then
    Exit;

  {Caso ALT pressionado}
  If fKeyIsDown(VK_MENU) Then
    Exit;

  If fKeyIsDown(VK_SHIFT) Then
    Exit;

  If fKeyIsDown(VK_CONTROL) Then
    Exit;

  If cdsVenda.IsEmpty Then
    Exit;

  If pnlPesquisarDescricao.Visible Then
  Begin
    Msg.CharCode := 0;
    Try
      If InterlockedIncrement(intLockTab) = 0 Then
      Begin
        Rect := fGetGridRowScreenPosition(dbgItens, fFindColumnByName(dbgItens,'ITE_DESITE').Index);
        strAmbiente := cdsVenda.FieldByName('ITE_COMPLE').AsString;
        blnInsertTmp := True;
        fltQtdeTab := fGetQtdeTab(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, strAmbiente, Rect);
        If fltQtdeTab > 0 Then
        Begin
          pSetFocus(dbgItens);
          Try
            pCarregaItensAlteracao;
            {**************************************************}
            {* ALTERA A QTD DO ITEM E EXECUTA O EXIT DO MESMO *}
            {***********************************************JC*}
            fltQtdDigAnt   := fStrToFloat(edtQtdIte.Text);
            edtQtdIte.Text := FloatToStrF(fltQtdeTab, ffFixed, 12, fCfgSis('DECQTD', varInteger));
            edtQtdIteExit(edtQtdIte);

            If fUtilizaDefinicaoAmbienteProduto Then
              cbbComple.Text := strAmbiente;

            btnAdicionar.Click;
          Finally
            btnCancelaItem.Click;
            pSetFocus(dbgItens);
          End;
        End;
      End;
    Finally
      InterlockedDecrement(intLockTab);
    End;
  End;
end;

procedure TfrmFatVendas.pExibirImgPnlDadosItem(AVisible: Boolean);
begin
  ImgPnlDadosItem.Visible := AVisible;

  if not ImgPnlDadosItem.Visible then
    Exit;

  ImgPnlDadosItem.Top := pnlDadosItem.Top;
  ImgPnlDadosItem.Left := pnlDadosItem.Top;
  ImgPnlDadosItem.Width := pnlDadosItem.Width;
  ImgPnlDadosItem.Height := pnlDadosItem.Height;
  AssignPanelImageToPicture(pnlDadosItem, ImgPnlDadosItem);
  ImgPnlDadosItem.Visible := True;
  ImgPnlDadosItem.BringToFront;
  pProcessMessages;
end;

