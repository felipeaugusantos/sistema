  inherited;

  If (fRetTipEmp <> fatVenda.strTipEmp) And (fRetTipEmp = 'S') Then
  Begin
    fatVenda.strTipEmp := 'S';

    If Not fatVenda.fVerificaEstoqueItens(strOpcDoc, fRetTipEmp) Then
      rdgTipEmp.ItemIndex := 0;
