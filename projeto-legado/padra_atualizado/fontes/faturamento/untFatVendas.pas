function TfrmFatVendas.fProdutoPermitidoTransferenciaEstoque: Boolean;
begin
  Result := True;

  If (Not fCfgSis('TRITTE', varBoolean)) Then
    Exit;

  If (Not Pos(strOpcDoc, 'PD_OR_VN_TE_') > 0) Then
    Exit;

  If (Not fatVenda.blnCliFil) Then
    Exit;

  If (fCampoTabela('ITE_TRITTE', 'CADITE', ['ITE_CODITE'], [qryConCit.FieldByName('ITE_CODITE').AsString]) = 'S') Then
    Exit;

  Result := False;
end;

Procedure TfrmFatVendas.pAlteraDataEntregaImediataItens(dtaDtaEnt: TDate; blnSomenteAtrasados: Boolean=False);
  Var
    intRecNo: Integer;
    prcScroll: TprcScroll;
    blnAtualiza: Boolean;
    RecUnanimidadeDataEntrega : TRecUnanimidadeDataEntrega;
Begin

  RecUnanimidadeDataEntrega := fVerificaUnanimidadeDataDeEntrega;

  If RecUnanimidadeDataEntrega.blnDataDeEntregaEhUnanimidade Then
  Begin
    If RecUnanimidadeDataEntrega.dtaDataDeEntrega = dtaDtaEnt Then
      Exit;
  End;

  With cdsVenda Do
  Begin
    pDisableControls(cdsVenda, prcScroll);
    intRecNo := RecNo;

    First;
    While Not Eof Do
    Begin

      If (FieldByName('ITE_ENTFUT').AsString <> 'S') And
         (FieldByName('ITE_ENTRET').AsString = 'E') Then
      Begin
        blnAtualiza := True;
        If blnSomenteAtrasados Then
          blnAtualiza := (FieldByName('ITE_DTENTR').AsDateTime < dtaDtaEnt);
        
        If blnAtualiza Then
        Begin
          Edit;
          FieldByName('ITE_DTENTR').AsDateTime := dtaDtaEnt;

          If Not fEmptyStr(edtDiaEnt.Text) Then
            FieldByName('ITE_QDENTR').AsInteger := StrToIntDef(edtDiaEnt.Text, 0)
          Else
            FieldByName('ITE_QDENTR').AsInteger := 0;

          Post;
        End;
      End;

      Next;
    End;

    RecNo := intRecNo;
    pEnableControls(cdsVenda, prcScroll);
  End;

End;

procedure TfrmFatVendas.pAlteraDataEntregaImediataOrcPed;
  Var
    intRecNo: Integer;
    prcScroll: TprcScroll;

    strDtEntr: String;
    intDiaEnt: Extended;

    intQMDPEI: Integer;
    dtNovaDataMin: TDateTime;
    dtNovaData: TDateTime;

  function fRetornaEmpresaEntrega():String;
  begin
    Result := VS_strCodEmp;
    If Assigned(fatVenda) And fatVenda.blnEmpFat And (fCfgSis('EMCFEN', VarInteger) = 2) Then
      Result := cdsVenda.FieldByName('ITE_EMPITE').AsString;
  end;
Begin
  If (cdsVenda.IsEmpty) Then Exit;

  If (Not ((((strEspOrc = 'OR') Or (strOpcDoc = 'OR')) And (fCfgSis('DTENOR', varBoolean))))) Then
    Exit;

  pDisableControls(cdsVenda, prcScroll);
  intRecNo := cdsVenda.RecNo;

  cdsVenda.First;

  While Not cdsVenda.Eof Do Begin

    If (cdsVenda.FieldByName('ITE_ENTFUT').AsString <> 'S') And
       (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E') Then
    Begin
      cdsVenda.Edit;

      strDtEntr := FormatDateTime('dd/mm/yyyy', cdsVenda.FieldByName('ITE_DTENTR').AsDateTime);
      intDiaEnt := StrToDateDef(strDtEntr, 0) - fatVenda.dtaDtaEntOri;

      intQMDPEI := fCfgSis('QMDPEI', VarInteger, fRetornaEmpresaEntrega());
      dtNovaDataMin := IncDay(VS_Date, intQMDPEI);

      dtNovaData := VS_Date + intDiaEnt;

      If(dtNovaData < dtNovaDataMin) Then
        dtNovaData := dtNovaDataMin;

      cdsVenda.FieldByName('ITE_DTENTR').AsDateTime := dtNovaData;

      cdsVenda.Post;
    End;

    cdsVenda.Next;
  End;

  cdsVenda.RecNo := intRecNo;
  pEnableControls(cdsVenda, prcScroll);
End;

