procedure TfrmFatVendas.pHabilitarCheckPegou;
Var
  blnPegou: Boolean;
begin
  If Not chkPegou.Visible Then
    Exit;

  blnPegou := chkPegou.Checked;

  chkPegou.Enabled := True;

  If fRetEmpresaItem <> VS_strCodEmp Then
    chkPegou.Enabled := False;

  If (cmbEntRet.ItemIndex <> IDX_RETIRA) Then
    chkPegou.Enabled := False;

  If Not chkPegou.Enabled Then
    chkPegou.Checked := False;

  If (blnPegou <> chkPegou.Checked) And fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
    pAjustaLote(edtCodIte.Text,
                IIF(fatVenda.blnEmpFat,
                  IIF(fEmptyStr(edtCodEmp.Text),'',
                    fStrZero(edtCodEmp.Text,3)),
                       fatVenda.fEmpresaSaldoMatriz_CD),
                fatVenda.strIdePro,
                blnProAca,
                recForTin.Formulas);
end;

procedure TfrmFatVendas.pDesabilitaTabPreItem(strTabPreIte: String = ''; blnAlterando: Boolean = False);
begin
  If fEmptyStr(strTabPreIte) Then
    strTabPreIte := strTabPreEmb;

  If (fCfgSis('PRVEMB', VarBoolean))     And
     (fCfgSis('PREEMB', VarInteger) = 2) And
     (cbTabPrecoItem.Visible)            And
     (Not blnAlterando)                  And
     (Not fEmptyStr(strTabPreIte))       And
     (Not SameText(strTabPreIte, 'F'))   Then
  Begin
    If cbTabPrecoItem.Items.IndexOf(strTabPreIte) <> -1 Then
      cbTabPrecoItem.ItemIndex := cbTabPrecoItem.Items.IndexOf(strTabPreIte);

    cbTabPrecoItem.Enabled := False;
  End
  Else
  If Not fEmptyStr(fatVenda.strCodCmg) Then
    cbTabPrecoItem.Enabled := False
  Else
  If Not fUsaTabelaPrecoItemPorRetiraEntrega Then
    cbTabPrecoItem.Enabled := True;

  If cbTabPrecoItem.Visible And ((Not fEmptyStr(strTabPreEmb)) And (Not SameText(strTabPreEmb, 'F'))) Then
    fatVenda.strTabPre := fTabelaDePrecoDosItens;
end;

function TfrmFatVendas.fControlaDigMetrosCubicos(blnMetCub: Boolean; blnPedSen: Boolean = True): Boolean;
Var
  blnLibera: Boolean;
begin

  Result    := False;
  blnLibera := False;

  {************************************}
  {* CONTROLA OS CAMPOS PARA INFORMAR *}
  {* A QUANTIDADE DE METROS CÚBICOS.  *}
  {*********************************PZ*}
  If (blnMetCub) Then
  Begin

    {*************************************}
    {* CONTROLA SE IRÁ SOLICITAR A SENHA *}
    {**********************************PZ*}
    If (blnPedSen) Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Vendas em metros cúbicos');

      objLiberacao.strDirAce := 'METCUB';
      objLiberacao.strSenLib := fCfgSis('METCUB');
      objLiberacao.strMsgSen := 'Vendas em metros cúbicos';
      objLiberacao.strCodOpe := fatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      If (fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
        blnLibera := True;
    End
    Else
      blnLibera := True;

    If (blnLibera) Then
    Begin

      If (blnPedSen) Then
      Begin
        edtQtdPec.Text := FormatFloat(edtQtdPec.EditFormat, 0);
        edtComPec.Text := FormatFloat(edtComPec.EditFormat, 0);
        edtLarPec.Text := FormatFloat(edtLarPec.EditFormat, 0);
        edtEspPec.Text := FormatFloat(edtEspPec.EditFormat, IIF(blnUtilizaVendaVidro,1,0));
      End;

      {*******************************}
      {* SE FOR INCLUSÃO DE REGISTRO *}
      {****************************PZ*}
      If (btnAdicionar.Tag <= 0) Then
        edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 0);

      edtQtdPec.Enabled := False;
      edtComPec.Enabled := False;
      edtLarPec.Enabled := False;
      edtEspPec.Enabled := False;
      edtUntPec.Enabled := False;

      edtQtdIte.ReadOnly := False;

      Result := True;
    End;

  End
  Else
  Begin

    If (blnPedSen) Then
    Begin
      edtQtdPec.Text := FormatFloat(edtQtdPec.EditFormat, 0);
      edtComPec.Text := FormatFloat(edtComPec.EditFormat, 0);
      edtLarPec.Text := FormatFloat(edtLarPec.EditFormat, 0);
      edtEspPec.Text := FormatFloat(edtEspPec.EditFormat, IIF(blnUtilizaVendaVidro,1,0));
    End;

    {*******************************}
    {* SE FOR INCLUSÃO DE REGISTRO *}
    {****************************PZ*}
    If (btnAdicionar.Tag <= 0) Then
      edtQtdIte.Text := FormatFloat(edtQtdIte.EditFormat, 0);

    edtQtdPec.Enabled := True;
    edtComPec.Enabled := True;
    edtLarPec.Enabled := True;
    edtEspPec.Enabled := True;
    edtUntPec.Enabled := True;

    edtQtdIte.ReadOnly := True;

    Result := True;

  End;

end;

function TfrmFatVendas.fValidaEntregaFuturaPendente : Boolean;
begin
  Result := False;
  If (cmbEntRet.ItemIndex = IDX_RETIRA) Then
  Begin
    If (Pos(fCfgSis('TRAVAR', varString), '_A_T_') > 0) Then
    Begin
      Result := True;
      Exit;
    End;
  End
  Else If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
  Begin
    If (Pos(fCfgSis('TRAVAI', varString), '_A_T_') > 0) Then
    Begin
      Result := True;
      Exit;
    End;
  End
  Else If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then
  Begin
    If (Pos(fCfgSis('TRAVAF', varString), '_A_T_') > 0) Then
    Begin
      Result := True;
      Exit;
    End;
  End;
end;

function TfrmFatVendas.fControleDestino(strCodIte, strCodEmp, strCodCli : String): Boolean;
  Var
    blnAviso : Boolean;
    blnTrava : Boolean;
    fltQtdEntFut : Double;
begin
  Result := True;
  If (fCfgSis('ENTFUT', varString, fGetEmpConfigEntrega) = 'N') Then
    Exit;
  If (Not fValidaEntregaFuturaPendente) Then
    Exit;
  blnAviso := False;
  blnTrava := False;
  fltQtdEntFut := TEntregaFutura.New(
                    TParamEF.New()
                      .CodIte(strCodIte)
                      .CodEmp(strCodEmp)
                      .TipoTE(tteTodas)
                      .CodCli(strCodCli)
                    ).Total();
  If (cmbEntRet.ItemIndex = IDX_RETIRA) Then
  Begin
    If (fCfgSis('TRAVAR') = 'A') Then
    Begin
      If (fltQtdEntFut > 0) Then
        blnAviso := True;
    End
    Else If (fCfgSis('TRAVAR') = 'T') Then
    Begin
      If (fltQtdEntFut > 0) Then
        blnTrava := True;
    End;
  End
  Else If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) Then
  Begin
    If (fCfgSis('TRAVAI') = 'A') Then
    Begin
      If (fltQtdEntFut > 0) Then
        blnAviso := True;
    End
    Else If (fCfgSis('TRAVAI') = 'T') Then
    Begin
      If (fltQtdEntFut > 0) Then
        blnTrava := True;
    End;
  End
  Else If (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) Then
  Begin
    If (fCfgSis('TRAVAF') = 'A') Then
    Begin
      If (fltQtdEntFut > 0) Then
        blnAviso := True;
    End
    Else If (fCfgSis('TRAVAF') = 'T') Then
    Begin
      If (fltQtdEntFut > 0) Then
        blnTrava := True;
    End;
  End;
  If (blnTrava) Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Foi identificado a existência de "Entrega Futura Pendente" para o item: ' + strCodIte + '.');
    objLiberacao.strDirAce  := 'PERITE';
    objLiberacao.strMsgSen  := 'Foi identificado a existência de "Entrega Futura Pendente" para o item: ' + strCodIte + '.';
    objLiberacao.strCodOpe  := fatVenda.strCodVen;
    objLiberacao.strCodDig  := fatVenda.strCodDig;
    objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
    Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
  End
  Else If (blnAviso) Then
    fMensagem('AVISO!','Foi identificado a existência de "Entrega Futura Pendente" para o item: ' + strCodIte + '.' + #13#10 + 'Favor verificar!.',['&OK']);
end;

function TfrmFatVendas.fControleRetiraEntregaPorCndPagto(strCodCnd : String; blnAlterou_Condicao : Boolean = False): Boolean;
var
  blnRetira_Cnd : Boolean;
  blnEntIme_Cnd : Boolean;
  blnEntFut_Cnd : Boolean;

  blnRetira_Dig : Boolean;
  blnEntIme_Dig : Boolean;
  blnEntFut_Dig : Boolean;

  qryCadCnd   : TUniQuery;
  prcScroll   : Tprcscroll;

begin

  If (Not fEmptyStr(strCodCnd)) And (Not fIsNumber(strCodCnd)) Then
  Begin
    fMensagem('Atenção','Código de Condição de Pagamento inválido!',['&OK']);
    Result := False;
    Exit;
  End;

  Result := True;

  If Not fEmptyStr(strCodCnd) Then
  Begin

    qryCadCnd := Nil;
    Try
      qryCadCnd := fCriaQuery(Nil);

      qryCadCnd.Close;
      qryCadCnd.SQL.Text := 'SELECT * FROM CADCND WHERE CND_CODIGO = :CODIGO';
      qryCadCnd.ParamByName('CODIGO').AsString := strCodCnd;
      qryCadCnd.Open;

      If Not qryCadCnd.IsEmpty Then
      Begin
        blnRetira_Cnd := AnsiUpperCase(qryCadCnd.FieldByName('CND_RETIRA').AsString) = 'S';
        blnEntIme_Cnd := AnsiUpperCase(qryCadCnd.FieldByName('CND_ENTIME').AsString) = 'S';
        blnEntFut_Cnd := AnsiUpperCase(qryCadCnd.FieldByName('CND_ENTFUT').AsString) = 'S';
      End
      Else
      Begin
        blnRetira_Cnd := False;
        blnEntIme_Cnd := False;
        blnEntFut_Cnd := False;
      End;

    Finally
      If Assigned(qryCadCnd) Then
        FreeAndNil(qryCadCnd);
    End;

    {Condição no Final}
    If (fCfgSis('CNDVEN') = 'F') Or (blnAlterou_Condicao) Then
    Begin

      pDisableControls(cdsVenda, prcScroll);
      cdsVenda.First;

      Try

        While Not cdsVenda.Eof Do
        Begin

          If Not fEhItemServico(cdsVenda.FieldByName('ITE_CODITE').AsString) Then
          Begin

            {Retira}
            If (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'R') Then
              Result := blnRetira_Cnd;

            {Entrega Imediata}
            If (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsVenda.FieldByName('ITE_ENTFUT').AsString = 'N') Then
              Result := blnEntIme_Cnd;

            {Entrega Futura}
            If (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsVenda.FieldByName('ITE_ENTFUT').AsString = 'S') Then
              Result := blnEntFut_Cnd;

            If Not Result Then
              Break;

          End;

          cdsVenda.Next;

        End;

      Finally
        pEnableControls(cdsVenda, prcScroll);
      End;

    End
    Else
    {Condição no Início}
    If fCfgSis('CNDVEN') = 'I' Then
    Begin

      blnRetira_Dig := (cmbEntRet.ItemIndex = IDX_RETIRA);
      blnEntIme_Dig := (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA);
      blnEntFut_Dig := (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA);

      {Retira}
      If blnRetira_Dig Then
        Result := blnRetira_Cnd
      Else
      {Entrega Imediata}
      If blnEntIme_Dig Then
        Result := blnEntIme_Cnd
      Else
      {Entrega Futura}
      If blnEntFut_Dig Then
        Result := blnEntFut_Cnd;

    End;

  End;

  If Not Result Then
    fMensagem('Atenção','Esta Condição de Pagamento não permite o "Destino/Tipo Entrega" para o item(ns) informado(s), verifique!',['&OK']);

end;

procedure TfrmFatVendas.pCalculaQtdMetrosCubicosAtualizandoUnitarioSugestao();
var
  strQtdAux: String;
begin
