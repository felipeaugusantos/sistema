  Try
    If fEmptyStr(edtCodIte.Text) Then
      Exit;

    If (fStrToFloat(edtTotIte.Text) < 0.0) Then
    Begin
      pSetFocus(edtQtdIte);
      fMensagem('ATENÇÃO!', 'Não é possivel confirmar um total negativo!', ['&O k']);
      Exit;
    End
    Else If (fStrToFloat(edtTotIte.Text) = 0.0) Then
    Begin

      blnPodeIncluirBrindeZerado := fPermiteBrindeComValorZero And
                                    ((chkBrinde.Visible And chkBrinde.Checked) Or
                                      (blnInserindoBrindeDV)                   Or
                                      (strOpcDoc = 'BR')                       Or
                                      (((Pos(strOpcDoc,'DV_PR_') > 0)) And blnAlterandoCombo));

      If Not(blnPodeIncluirBrindeZerado) Then
      Begin
        pSetFocus(edtQtdIte);
        fMensagem('ATENÇÃO!', 'Não é possível confirmar um total zero!', ['&OK']);
        Exit;
      End;

    End;

    If (Pos(strOpcDoc, 'DV_PR_') <= 0) And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
    Begin
      If blnVendeTudoLote Then
      Begin
        If (fStrToFloat(edtQtdIte.Text) < fStrToFloat(edtSalDis.Text)) Then
        Begin
          pSetFocus(edtQtdIte);
          pMensagemOk('É obrigatória a venda da quantidade total de produtos deste lote!');
          Exit;
        End;

        If fLoteTotalJaInserido Then
        Begin
          pSetFocus(edtQtdIte);
          pMensagemOk('Já foi inserido este produto com a quantidade total deste lote!');
          Exit;
        End;
      End;
    End;

    If (Not fatVenda.blnCarregandoEstrutura) And (Not fPermiteAlterarPedido(True)) Then
    Begin
      pSetFocus(btnAdicionar);
      Exit;
    end;

    If (strOpcDoc = 'OF') And (Not fGridVendaVazio) Then
    Begin
      If (fatVenda.fTemItensDevolucao) And (strAiDvOr.IsEmpty) Then
      Begin
        pSetFocus(edtQtdIte);
        pMensagemOk('Você já inseriu itens de devolução referenciando um ou mais documentos. '+
                    'Não é permitida devolução de itens com e sem referência a documentos simultaneamente!');
        Exit;
      End
      Else If (Not fatVenda.fTemItensDevolucao) And (Not strAiDvOr.IsEmpty) Then
      Begin
        pSetFocus(edtQtdIte);
        pMensagemOk('Você já inseriu itens sem referência a um documento. '+
                    'Não é permitida devolução de itens com e sem referência a documentos simultaneamente!');
        Exit;
      End;
    End;

    {SE CFG_CNDPES = "S"}
    if (fatVenda.blnCondicaoEspecial) then
    Begin
      if  (fatVenda.blnCndEsp) and (edtCodCnd.Visible) then
      Begin
        If (Not fEhItemServico(edtCodIte.Text)) And (Not fatVenda.fItemCondicaoEspecial(edtCodIte.Text, fatVenda.strCodCnd)) Then
        Begin
          fMensagem('ATENÇÃO!', 'Este produto não poderá ser vendido na condição de pagamento escolhida. Favor Verificar.', ['&OK']);
          Exit;
        End;
      End;
    End;


    cpcParams := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);

    fltBFCPST := 0;
    fltPFCPST := 0;
    fltVFCPST := 0;

    fltVDesST := 0;
    strMDesST := '';
    strNumDrw := '';
    fltFreCot := 0;

    strChvRef := '';
    strIteRef := '';

    fltQtdDevolucao := 0.0;
    fltDeADevolucao := 0.0;
    fltUniDevolucao := 0.0;
    strIncDevolucao := '';

    fltQtdPonDevolu := 0.0;

    strPromocDevolu := '';

    strKey_EP := '';

    fltQtdBai := 0.0;
    If (Pos(strOpcDoc, 'DV_PR_') > 0) Or (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
    Begin
      If btnAdicionar.Tag = 0 Then
      Begin
        fltQtdDevolucao    := qryConDev.FieldByName('DET_QTDITE').AsFloat;
        fltUniDevolucao    := qryConDev.FieldByName('DET_UNITAR').AsFloat;
        fatVenda.fltPreCus := (qryConDev.FieldByName('DET_TOTCUS').AsFloat/qryConDev.FieldByName('DET_QTDITE').AsFloat);
        fatVenda.fltPreCu2 := (qryConDev.FieldByName('DET_TOTCU2').AsFloat/qryConDev.FieldByName('DET_QTDITE').AsFloat);
        fltQtdPonDevolu    := qryConDev.FieldByName('DET_QTDPON').AsFloat;
        strTabPreDev       := qryConDev.FieldByName('DET_TABPRE').AsString;
        strIncDevolucao    := qryConDev.FieldByName('DET_AUTOIN').AsString;
        fatVenda.fltUniOri := qryConDev.FieldByName('DET_UNIORI').AsFloat;
        fatVenda.fltUniVis := qryConDev.FieldByName('DET_UNIVIS').AsFloat;
        fatVenda.fltTaxJur := qryConDev.FieldByName('DET_TAXJUR').AsFloat;
        fatVenda.fltVal_RT := qryConDev.FieldByName('DET_VAL_RT').AsFloat;
        strEmpOriPDDev     := qryConDev.FieldByName('DET_EMPORI').AsString;
        fltBFCPST          := (qryConDev.FieldByName('DET_BFCPST').AsFloat/qryConDev.FieldByName('DET_QTDITE').AsFloat) * fStrToFloat(edtQtdIte.Text);
        fltPFCPST          := qryConDev.FieldByName('DET_PFCPST').AsFloat;
        fltVFCPST          := fFormataFloat(fltBFCPST * fltPFCPST / 100, 2);
        fltVDesST          := qryConDev.FieldByName('DET_VDESST').AsFloat;
        strMDesST          := qryConDev.FieldByName('DET_MDESST').AsString;
        strNumDrw          := qryConDev.FieldByName('DET_NUMDRW').AsString;
        fltFreCot          := qryConDev.FieldByName('DET_FRECOT').AsFloat * fStrToFloat(edtQtdIte.Text);
        strChvRef          := qryConDev.FieldByName('DET_CHVREF').AsString;
        strIteRef          := qryConDev.FieldByName('DET_ITEREF').AsString;

        if (not fEmptyStr(qryConDev.FieldByName('AUX_NUMDRW').AsString)) then
          fatVenda.strNumeroDrawback := qryConDev.FieldByName('AUX_NUMDRW').AsString;

        If Pos(qryConDev.FieldByName('DET_TABELA').AsString, 'MOVDET_NOTDET_') > 0 Then
        Begin
          strPromocDevolu := fCampoTabela('DET_PROMOC',
                                        IIF(qryConDev.FieldByName('DET_TABELA').AsString = 'MOVDET','MOVDET','NOTDET'),
                                        ['AUTOINCREM'],
                                        [strIncDevolucao]);

        End;
        If strPromocDevolu.IsEmpty Then
        Begin
          strPromocDevolu := 'N';
        End;

        If (fatVenda.blnDevolucaoCompleta) Then
          fltDeADevolucao := (qryConDev.FieldByName('DET_DESACE').AsFloat)
        Else
          fltDeADevolucao := (qryConDev.FieldByName('DET_DESACE').AsFloat/qryConDev.FieldByName('DET_QTDITE').AsFloat) * fStrToFloat(edtQtdIte.Text);

        {**********************************************************************}
        {* CASO FOR DEVOLUCAO DE PIGMENTO, TAMBEM DEVE DEVOLVER A EMBALAGEM...*}
        {*******************************************************************JC*}
        If fatVenda.strPigBas = 'S' Then
        Begin
          fatVenda.strCodEmb := qryConDev.FieldByName('DET_ITEEMB').AsString;
          strTipEmb := qryConDev.FieldByName('DET_TIPEMB').AsString;
          intQtdEmb := fStrToFloat(edtQtdIte.Text);
        End;

        If (fatVenda.strOpcDoc = 'DV') Then
        Begin
          If (fEmptyStr(fatVenda.strCodPrj)) And
             (cdsVenda.RecordCount = 0) Then
            fatVenda.strCodPrj := qryConDev.FieldByName('AUX_CODPRJ').AsString
          Else
          Begin
            If (Trim(fatVenda.strCodPrj) <> Trim(qryConDev.FieldByName('AUX_CODPRJ').AsString)) Then
            Begin
              If (fEmptyStr(fatVenda.strCodPrj)) Then
                fMensagem('', 'O item que está inserindo na devolução está vinculado ao projeto '+
                              qryConDev.FieldByName('AUX_CODPRJ').AsString+' e não pode ser '+
                              'inserido juntamento com itens sem projeto.', ['&Ok'])
              Else If (Not fEmptyStr(fatVenda.strCodPrj)) And (Not fEmptyStr(qryConDev.FieldByName('AUX_CODPRJ').AsString)) Then
                fMensagem('', 'O item que está inserindo na devolução está vinculado ao projeto '+
                              qryConDev.FieldByName('AUX_CODPRJ').AsString+' e não pode ser '+
                              'inserido juntamento com itens do projeto '+ fatVenda.strCodPrj +'.', ['&Ok'])
              Else If (Not fEmptyStr(fatVenda.strCodPrj)) And (fEmptyStr(qryConDev.FieldByName('AUX_CODPRJ').AsString)) Then
                fMensagem('', 'O item que está inserindo na devolução não está vinculado a projeto '+
                              'e não pode ser inserido juntamento com itens do projeto '+
                              fatVenda.strCodPrj +'.', ['&Ok'])
              Else
                fMensagem('', 'O item que está inserindo na devolução está vinculado ao projeto '+
                              qryConDev.FieldByName('AUX_CODPRJ').AsString+' e não pode ser '+
                              'inserido juntamento com itens sem projeto.', ['&Ok']);

              Exit;
            End;
          End;

          If not fatVenda.fValidaEmitenteDoDocumentoReferenciado(strChvRef) Then
          Begin
            fMensagem('', 'Não é permitido misturar documentos de lojas diferente.', ['&Ok']);
            Exit;
          End;

          If fatVenda.fExisteDocumentoReferenciadoDoMesmoItem(strChvRef, strIteRef) Then
          Begin
            fMensagem('', 'Não é permitido mais de um item do mesmo documento referenciado.'+#13+
                          'Altere o produto que já foi informado.', ['&Ok']);
            Exit;
          End;

        End;
      End
      Else
      Begin
        fltQtdDevolucao    := cdsVenda.FieldByName('ITE_QTDDEV').AsFloat;
        fltUniDevolucao    := cdsVenda.FieldByName('ITE_UNIDEV').AsFloat;
        fatVenda.fltPreCus := cdsVenda.FieldByName('ITE_PRECUS').AsFloat;
        fatVenda.fltPreCu2 := cdsVenda.FieldByName('ITE_PRECU2').AsFloat;
        fltQtdPonDevolu    := cdsVenda.FieldByName('ITE_QTPPRO').AsFloat;
        strTabPreDev       := cdsVenda.FieldByName('ITE_TABPRE').AsString;
        strIncDevolucao    := cdsVenda.FieldByName('ITE_INCDEV').AsString;
        fatVenda.fltUniOri := cdsVenda.FieldByName('ITE_UNIORI').AsFloat;
        fatVenda.fltUniVis := cdsVenda.FieldByName('ITE_UNIVIS').AsFloat;
        fatVenda.fltTaxJur := cdsVenda.FieldByName('ITE_TAXJUR').AsFloat;
        fatVenda.fltVal_RT := cdsVenda.FieldByName('ITE_VAL_RT').AsFloat;
        strEmpOriPDDev     := cdsVenda.FieldByName('ITE_EMPORC').AsString;
        fltBFCPST          := cdsVenda.FieldByName('ITE_BFCPST').AsFloat;
        fltPFCPST          := cdsVenda.FieldByName('ITE_PFCPST').AsFloat;
        fltVFCPST          := cdsVenda.FieldByName('ITE_VFCPST').AsFloat;
        strChvRef          := cdsVenda.FieldByName('ITE_CHVREF').AsString;
        strIteRef          := cdsVenda.FieldByName('ITE_ITEREF').AsString;
        strPromocDevolu    := cdsVenda.FieldByName('ITE_PROMOC').AsString;

        If strPromocDevolu.IsEmpty Then
        Begin
          strPromocDevolu := 'N';
        End;

        fltDeADevolucao := cdsVenda.FieldByName('ITE_DEADEV').AsFloat;

        {**********************************************************************}
        {* CASO FOR DEVOLUCAO DE PIGMENTO, TAMBEM DEVE DEVOLVER A EMBALAGEM...*}
        {*******************************************************************JC*}
        If cdsVenda.FieldByName('ITE_PIGBAS').AsString = 'S' Then
        Begin
          fatVenda.strCodEmb := cdsVenda.FieldByName('ITE_ITEEMB').AsString;
          strTipEmb := cdsVenda.FieldByName('ITE_TIPEMB').AsString;
          intQtdEmb := fStrToFloat(edtQtdIte.Text);
        End;

      End;
    End
    Else
    Begin
      If (btnAdicionar.Tag = 0) Then
      Begin
        fltQtdBai := 0.0;
        intSeqInd := 0;
      End
      Else
      Begin
        cdsVenda.Locate('AUTOINCREM',btnAdicionar.Tag,[]);
        fltQtdBai := cdsVenda.FieldByName('ITE_QTDBAI').AsFloat;
        intSeqInd := cdsVenda.FieldByName('ITE_SEQIND').AsInteger;
        strKey_EP := cdsVenda.FieldByName('ITE_KEY_EP').AsString;
      End;

      If (fCfgSis('CUSESP', varString) = 'N')                                     And
         (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0) Then
      Begin
        If (fatVenda.strIdePro = 'NOR') Then
        Begin
          fatVenda.fltPreCus := fatVenda.fRetornaPrecoCusto(Preco_de_Custo,
                                                            qryConIte.FieldByName('ITE_CODITE').AsString,
                                                            fRetEmpresaItem,
                                                            cpcParams.fCalculaPrecoCusto(fStrToFloat(edtUnitar.Text), fCfgSis('MMIIES', varDouble)),
                                                            '',
                                                            Nil,
                                                            True);
        End;                                                  

        fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                      qryConIte.FieldByName('ITE_CODEMP').AsString,
                                      fTabelaPrecoItem);

        calcCustoReal := TCalcCustoReal.Create;
        calcCustoReal.fltUnitar := fStrToFloat(edtUnitar.Text);
        calcCustoReal.fltPreCus := fatVenda.fltPreCus;
        calcCustoReal.fltOutVal := IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat), fatVenda.fltOutVal);
        calcCustoReal.fltIcmSai := IIF((fatVenda.strIdePro = 'NOR'), IIF(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte), fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)), fatVenda.fltIcmSai);
        calcCustoReal.fltImpFed := IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat), fatVenda.fltImpFed);
        calcCustoReal.fltDesOpe := IIF((fatVenda.strIdePro = 'NOR'), fatVenda.fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat), fatVenda.fltDesOpe) + fatVenda.fltDesOpeCli;

        strCodSit := '';
        If Not fEmptyStr(fatVenda.GetTipAbf(fRetEmpresaItem)) Then
          strCodSit := qryConAbf.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(fRetEmpresaItem)).AsString;

        calcCustoReal.fltDifal := fatVenda.fGetAlqDifal(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                        fRetEmpresaItem,
                                                        qryConAbf.FieldByName('ABF_CODABF').AsString,
                                                        strCodSit);

        calcCustoReal.fltFcp   := fatVenda.fGetAlqFcpIcms(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                          fRetEmpresaItem,
                                                          qryConAbf.FieldByName('ABF_CODABF').AsString,
                                                          strCodSit,
                                                          calcCustoReal.fltIcmSai,
                                                          fStrToFloat(edtUnitar.Text));

        fatVenda.fltPreCu2 := fatVenda.fRetornaPrecoCusto(Preco_de_Custo_Real,
                                                          qryConIte.FieldByName('ITE_CODITE').AsString,
                                                          fRetEmpresaItem,
                                                          fatVenda.fltPreCus,
                                                          '',
                                                          calcCustoReal,
                                                          True);

        FreeAndNil(calcCustoReal);
      End;
    End;

    If (fCfgSis('CUSESP', varString) = 'N')                                      And
       (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0) Then
    Begin
      fatVenda.fltComAnt := fatVenda.fltPreCus;
      fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);
      fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
      fatVenda.fltTaxJur := 0;
      fatVenda.fltVal_RT := 0;
    End;

    If (fatVenda.fltUniOri <= 0) Or
       ((Not fPermiteBrindeComValorZero) And
        ((fStrToFloat(edtUnitar.Text) <= 0) And (Not (chkBrinde.Visible And chkBrinde.Checked)) And (Not blnInserindoBrindeDV))) Then
    Begin
      If (strOpcDoc = 'NE') And (fatVenda.opcItensNFEspecialTinta <> opcVazio) Then
      Begin
        fatVenda.fltUniOri := fStrToFloat(edtUnitar.Text);
        fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
        fatVenda.fltTaxJur := 0;
        fatVenda.fltVal_RT := 0;
      End
      Else If (Pos(strOpcDoc, 'DV_') > 0) Or (fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
      Begin
        If (fatVenda.fltUniOri <= 0) Then
          fMensagem('', 'Campo [DET_UNIORI] da Tabela [' + strTabDev + '] Zerado!' + #13#10 +
                        'AUTOINCREM: ' + strDetAut + #13#10 +
                        'Favor entrar em contato com a Citel imediatamente.', ['&Ok']);
      End
      Else
        fMensagem('', 'Esse produto está com o preço de venda Zerado!' + #13#10 +
                      'Favor corrigir.', ['&Ok']);
      Exit;
    End;

    If Not fatVenda.fValidaCoerenciaEntreOItemOriginalEOItemDevolvido(False,
                                                                      qryConCit.FieldByName('ITE_CODITE').AsString,
                                                                      IIF(btnAdicionar.Tag = 0, strTabDev, cdsVenda.FieldByName('ITE_TABDEV').AsString),
                                                                      strAiDvOr) Then
    Begin
      Exit;
    End;

    If (fatVenda.blnApenasUnitarioAcimaDoSugerido) And (Not blnInserindoCombo) And
       (fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni) < fFormataFloat(IIF((Pos(strOpcDoc, 'DV_PR_DD_') > 0), fltUniDev, fUnitarioMinimo), fatVenda.VS_intDecUni)) Then
    Begin
      fMensagem('ATENÇÃO!', 'O Unitário deve ser maior ou igual a ' + FloatToStr(fFormataFloat(IIF((Pos(strOpcDoc, 'DV_PR_DD_') > 0), fltUniDev, fUnitarioMinimo), fatVenda.VS_intDecUni)) + '!', ['&OK']);
      Exit;
    End;

    If (Pos(strOpcDoc, 'DV_PR_DD_') <= 0) And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
    Begin
      If fatVenda.fUtilizaPrecoSubItensEstrutura(Pos('ITEM ESPECIAL', strDesOri) > 0,
                                                 qryConIte.FieldByName('ITE_CODITE').AsString) Then
      Begin
        impSubIteEst.strCodIte := qryConIte.FieldByName('ITE_CODITE').AsString;
        impSubIteEst.strEmpIte := fRetEmpresaItem;
        impSubIteEst.fltUniPai := fStrToFloat(edtUnitar.Text);
        impSubIteEst.fltQtdPai := fStrToFloat(edtQtdIte.Text);

        fatVenda.pRetImpostosSubItensEstrutura(impSubIteEst);

        fltOutValIte := impSubIteEst.fltOutVal;
        fltDesOpeIte := impSubIteEst.fltDesOpe;
        fltImpFedIte := impSubIteEst.fltImpFed;
        fltIcmSaiIte := impSubIteEst.fltIcmSai;
      End
      Else
      Begin

        {Produto Acabado}
        If fEhProdutoAcabado Then
        Begin
          fltOutValIte := fatVenda.fltOutVal;
          fltDesOpeIte := fatVenda.fltDesOpe;
          fltImpFedIte := fatVenda.fltImpFed;
          fltIcmSaiIte := fatVenda.fltIcmSai;
        End
        Else
        Begin
          fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                        qryConIte.FieldByName('ITE_CODEMP').AsString,
                                        fTabelaPrecoItem);

          fltOutValIte := IIF(fUsaValoresItem, fatVenda.fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat), fatVenda.fltOutVal);
          fltDesOpeIte := IIF(fUsaValoresItem, fatVenda.fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat), fatVenda.fltDesOpe);
          fltImpFedIte := IIF(fUsaValoresItem, fatVenda.fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat), fatVenda.fltImpFed);
          fltIcmSaiIte := IIF(fUsaValoresItem, IIF(fCfgSis('IMPCF4') = 'S', fatVenda.fCalculaAliquota(qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString, fStrImpDirIte), fatVenda.fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)), fatVenda.fltIcmSai);
        End;

      End;
    End
    Else
    Begin
      fltOutValIte := IIF(btnAdicionar.Tag = 0, fltOutValDev, cdsVenda.FieldByName('ITE_OUTVAL').AsFloat);
      fltIcmSaiIte := IIF(btnAdicionar.Tag = 0, fltIcmSaiDev, cdsVenda.FieldByName('ITE_ICMSAI').AsFloat);
      fltImpFedIte := IIF(btnAdicionar.Tag = 0, fltImpFedDev, cdsVenda.FieldByName('ITE_IMPFED').AsFloat);
      fltDesOpeIte := IIF(btnAdicionar.Tag = 0, fltDesOpeDev, cdsVenda.FieldByName('ITE_DESOPE').AsFloat);
    End;

    {********************************************************}
    {* QUANTIDADE DE M3, GRAVA SOMENTE SE A UNIDADE FOR M3  *}
    {****************************************************DP**}
    If (blnUtilizaVendaMadeira Or blnUtilizaVendaVidro Or blnUtilizaVendaMetroLinear) Then
    Begin
      fUnidadeM3(qryConCit.FieldByName('ITE_CODUNI').AsString);

      recMadeira.fltQtdPec := fStrToFloat(edtQtdPec.Text);
      recMadeira.fltComPec := fStrToFloat(edtComPec.Text);
      recMadeira.fltLarPec := fStrToFloat(edtLarPec.Text);
      recMadeira.fltEspPec := fStrToFloat(edtEspPec.Text);
      recMadeira.strAparel := edtAparel.Text;
      recMadeira.fltPerApa := fStrToFloat(edtPerApa.Text);
      recMadeira.strBenefi := edtBenefi.Text;
      recMadeira.fltPerBen := fStrToFloat(edtPerBen.Text);
    End;

    //Define o Vendedor do produto
    If btnAdicionar.Tag = 0 Then
    Begin
      If Pos(strOpcDoc, 'DV_PR_OF_DD_') > 0 Then
      Begin
        strVendedor  := strVenDev;
        strVendedor2 := strVenDev2;
      End
      Else
      Begin
        strVendedor  := fatVenda.strCodVen;
        strVendedor2 := fatVenda.strCodVe2;
      End;
    End
    Else
    Begin
      strVendedor  := cdsVenda.FieldByName('ITE_CODVEN').AsString;
      strVendedor2 := cdsVenda.FieldByName('ITE_CODVE2').AsString;
    End;

    strTabPreTmp := fatVenda.fDefineTabelaPrecoItem(fatVenda.strIdePro, strCodAca);

    fltQtdExp := IIF(btnAdicionar.Tag = 0, 0, cdsVenda.FieldByName('ITE_QTDEXP').AsFloat);

    {********************************************************}
    {* ITENS DE ENTREGA FUTURA O SISTEMA JA GRAVA EXPEDIDO, *}
    {* PORTANTO CASO ALTERE PARA NAO ENTREGA FUTURA DEVEMOS *}
    {* ZERAR A QUANTIDADE EXPEDIDA DO PRODUTO...            *}
    {****************************************************JC**}
    If (fltQtdExp > 0) And (Not fEmptyStr(strNumOrc)) And (fEntregaFuturaItem <> 'S') And
       (fItemComoEntregaFuturaNoPedido(cdsVenda.FieldByName('ITE_SEQDET').AsString))  Then
    Begin
      fltQtdExp := 0;
    End;

    strCodSit := '';
    If Not fEmptyStr(fatVenda.GetTipAbf(fRetEmpresaItem)) Then
      strCodSit := qryConAbf.FieldByName('ABF_CODSIT' + fatVenda.GetTipAbf(fRetEmpresaItem)).AsString;

    fltComLiq := 0;
    If (fatVenda.blnEmCampanha) And
       (fCfgSis('MARMKP') = '4') Then
    Begin
      fatVenda.objCamGer.objCamDet.fVerificaProdutoCampanha(fatVenda.strCodCli,
                                                            qryConCit.FieldByName('ITE_CODITE').AsString,
                                                            EmptyStr,
                                                            EmptyStr,
                                                            0,
                                                            fltVlrCam,
                                                            fatVenda.strCodCmg,
                                                            fltComLiq);
    End;

    fatVenda.objIcStPv.pAdd(qryConCit.FieldByName('ITE_CODITE').AsString,
                            fatVenda.fGetEmpCalculoItem(fRetEmpresaItem),
                            fatVenda.GetTipAbf(fRetEmpresaItem),
                            fatVenda.fUFDestTrib(fRetEmpresaItem),
                            strCodSit,
                            fltImcSTPV,
                            blnCalcST,
                            0,
                            fltComLiq);

    //Somente para auditoria - FDOITE
