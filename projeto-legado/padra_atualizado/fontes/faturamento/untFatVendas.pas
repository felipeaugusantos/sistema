function TfrmFatVendas.fEhMesmoGrupoFrete(intTipFreDev: integer): Boolean;
var
  intTipoFrete: integer;
  typTipoFreteDoc,
  typTipoFreteItem: TTipoFrete;
begin
  Result := True;
  typTipoFreteDoc := frComFrete;
  typTipoFreteItem := frComFrete;

  if not fCfgSis('ESPDEV', varBoolean) then
    Exit;

  if fCfgSis('FRDVES', varString) <> '2' then
    Exit;

  if cdsVenda.IsEmpty then
    Exit;

  if intTipFreDev = 0 then
    Exit;

  intTipoFrete := fBuscaTipoFrete(cdsVenda.FieldByName('ITE_DOCDEV').AsString, cdsVenda.FieldByName('ITE_ESPDEV').AsString, cdsVenda.FieldByName('ITE_EMPDEV').AsString, cdsVenda.FieldByName('ITE_AIDVOR').AsString);

  if intTipoFrete = 0 then
    Exit;


  case intTipoFrete of
    1,3,9,4: typTipoFreteDoc := frSemFrete;
    2,5    : typTipoFreteDoc := frComFrete;
  end;


  case intTipFreDev of
    1,3,9,4: typTipoFreteItem := frSemFrete;
    2,5    : typTipoFreteItem := frComFrete;
  end;

  Result := typTipoFreteDoc = typTipoFreteItem;
end;

function TfrmFatVendas.fEhFaturamentoDeConcreto: Boolean;
begin

  Result := False;

  If (fatVenda.strEspDoc = IIF(MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) And (strOpcDoc = 'VN'), 'NF', 'NS')) And
     (fatVenda.fEhVendaItemConcreto) And
     (fatVenda.blnDesmembrarNotaProdutosServicos) Then
    Exit(True);

  {NF de remessa da J.A}
  If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And
     (fatVenda.strEspDoc = 'NF') And (strOpcDoc = 'VN') And
     (fatVenda.fEhVendaItemConcreto) Then
    Exit(True);

  {Confirmação da NF de concreto da J.A}
  If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And
     (fatVenda.blnConfirmandoNotaFiscalConcreto) And
     (fatVenda.fEhVendaItemConcreto) Then
    Exit(True);

end;

