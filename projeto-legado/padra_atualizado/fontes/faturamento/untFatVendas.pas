  strSQL := strSQL + '   , D.FDO_UNIDAD                                                                ';
  strSQL := strSQL + '   , D.FDO_UNIDAD                                                                ';
  strSQL := strSQL + '   , D.FDO_CODMAR                                                                ';
  strSQL := strSQL + '   , D.FDO_FORITE                                                                ';
