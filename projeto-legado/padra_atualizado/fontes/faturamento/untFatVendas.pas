procedure TfrmFatVendas.pExibirComplementoDescricao(strCodIte: String);
  var
    blnExiCompl: Boolean;
begin
  If fEmptyStr(strCodIte) Or (Not Assigned(fatVenda)) Then
    blnExiCompl := False
  Else
  Begin
    blnExiCompl := (fCfgSis('FATCOM', varBoolean)) And
                   (fCampotabela('ITE_FATCOM', 'CADITE', ['ITE_CODITE'], [strCodIte], False) = 'S') And
                   (Not (fatVenda.blnDvComDta And fCfgSis('DCOPRO', varBoolean)));
  End;

  If blnExiCompl Then
  Begin
    If Not cbbComple.Visible Then
    Begin
      cbbComple.Visible   := True;
      edtDesIte.Width     := edtDesIte.Width - cbbComple.Width;
      edtDesIte.MaxLength := edtDesIte.MaxLength - cbbComple.MaxLength;
    End;
  End
  Else
  Begin
    If cbbComple.Visible Then
    Begin
      cbbComple.Visible   := False;
      edtDesIte.Width     := edtDesIte.Width + cbbComple.Width;
      edtDesIte.MaxLength := edtDesIte.MaxLength + cbbComple.MaxLength;
    End;
  End;
end;

