function TfrmFatVendas.fRevisarBrindesPromocaoCompostaPorKit(AListKit: TStringList; AInserirBrinde: Boolean): Boolean;
  var
    LstrKit   : String;
    LQueryKit : TUniQuery;
begin
  Result := True;

  Try
    CdsVenda.DisableControls;

    For LstrKit In AListKit Do
    Begin
      LQueryKit := TProQtdColetiva.fGetBrindesDoKit(LstrKit);
      if not LQueryKit.IsEmpty then
      Begin
        while not LQueryKit.Eof do
        Begin
          if cdsVenda.Locate('ITE_CODITE;ITE_BRINDE;ITE_PROKIT',
                              VarArrayOf([LQueryKit.FieldBYName('BRI_CODITE').AsString,
                                          'S',
                                          LQueryKit.FieldBYName('BRI_SEQKIT').AsString]), []) then
          Begin
            if not AInserirBrinde then
              fDeletaItem(False);
          End
          Else
          Begin
            if AInserirBrinde then
            Begin
              If fMensagem('ATENÇÃO!', 'Deseja incluir o brinde "'+LQueryKit.FieldBYName('BRI_CODITE').AsString+
              ' - '+fRetNomProduto(LQueryKit.FieldBYName('BRI_CODITE').AsString)+'" pertencente ao kit da promoção?', ['&Sim', '&Não']) = 1 Then
              Begin
                edtCodIte.Text    := LQueryKit.FieldBYName('BRI_CODITE').AsString;
                pCarregaItem(True, True, False, True);

                if fEmptyStr(edtNumLot.Text) and (pnlItemLote.visible) then
                  edtNumLot.Text := TCadLot.fRetornaLoteAtivo(edtCodIte.Text, VS_strCodEmp);

                edtQtdIte.Text    := LQueryKit.FieldBYName('BRI_QTDBRI').AsString;
                chkBrinde.Checked := True;

                if cdsVenda.Locate('ITE_PROKIT', LQueryKit.FieldBYName('BRI_SEQKIT').AsString, []) then
                Begin
                  If CdsVenda.FieldByName('ITE_ENTRET').AsString = 'E' Then
                  Begin
                    cmbEntRet.ItemIndex := IDX_ENTREGA;
                    cmbTipEnt.ItemIndex := IDX_ENTREGA_IMEDIATA;
                  End
                  Else
                    cmbEntRet.ItemIndex := IDX_RETIRA;
                End;

                fatVenda.strPromoc     := 'N';
                fatVenda.strCodPro     := '';
                fatVenda.IDKitPromocao := LQueryKit.FieldBYName('BRI_SEQKIT').AsString;

                pLabelInformacaoGrid('Inserindo brindes de promoção...');

                pAdicionar;

                pLimpaDadosItem;
              End;
            End;
          End;

          LQueryKit.next;
        End;
      End;
    End;

    CdsVenda.EnableControls;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fRevisarBrindesPromocaoCompostaPorKit]');
    End;
  End;
end;

