function TfrmFatVendas.fConfirmaMI(objConfDocs: TConfirmacaoDocumentos; var blnBaixouDocumentos: Boolean; var blnErroValidacao: Boolean): Boolean;
  Var
    frmFatConfDocumentos : TfrmFatConfDocumentos;
begin
  blnBaixouDocumentos := False;

  If Not btnConfirma.Enabled Then
  Begin
    Result := False;
    Exit;
  End;

  pEnabledFechamento(False);

  Try
    frmFatVendas.Enabled := False;

    Try
      pCriarFormularios(TfrmFatConfDocumentos, frmFatConfDocumentos);
      frmFatConfDocumentos.objConfDocs := objConfDocs;
      frmFatConfDocumentos.showModal;

      Result := frmFatConfDocumentos.blnConfirma;

      If (Result) Then
      Begin
        blnBaixouDocumentos := frmFatConfDocumentos.blnBaixouDocumentos;

        fatVenda.pSetaTipOpeDocumento(objConfDocs.stlDocSel);

        If (Not frmFatConfDocumentos.blnBaixouDocumentos) Then
        Begin
          fatVenda.strCliFat := frmFatConfDocumentos.edtCodCli.Text;

          If frmFatConfDocumentos.edtCliFat.Text <> fatVenda.strCodCli Then
          Begin
            fatVenda.strCodCli := '';
            edtCodCli.Text     := frmFatConfDocumentos.edtCliFat.Text;
            pCarregaCliente;
            If Not fValidaEstado(fatVenda.fTrocaUFEndEntrega) Then
            Begin
              fMensagem('ATENÇÃO!', 'Estado do cliente '+edtCodCli.Text+' inválido!' +#10#13+
                                    'Cidade: '+fatVenda.strCliCid +#10#13+
                                    'Estado: '+IfEmptyStr(fatVenda.strCliEst,'<SEM UF INFORMADA>') +#10#13+
                                    'Feche essa tela e corrija o cadastro do cliente antes de realizar essa confirmação!', ['&O k']);
              Result := False;
              blnErroValidacao := True;
            End;
          End;

          pMostrarDadosFazendaRodape(False);

          If fCfgSis('CADFAZ', VarBoolean) And Not fEmptyStr(objConfDocs.strCodFaz) Then
          Begin
            If fatVenda.fSelecionarFazendaCliente(edtCodCli.Text, objConfDocs.strCodFaz) Then
            Begin
              pMostrarDadosFazendaRodape(True);
            End;
          End;

          If (Not fEmptyStr(objConfDocs.strCodEmb)) And (fCfgSis('CADEMB', VarBoolean)) Then
          Begin
            fatVenda.strCodEmbarcacao := objConfDocs.strCodEmb;
            pMostrarDadosEmbarcacaoRodape(True);
          End
          Else
          Begin
            pMostrarDadosEmbarcacaoRodape(False);
          End;
        End;
      End
      Else
        pEnabledFechamento(True);
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[frmFatVendas.fConfirmaMI]');
      End;
    End;

    pFreeAndNil(frmFatConfDocumentos);

  Finally
    frmFatVendas.Enabled := True;
  End;

end;

function TfrmFatVendas.fCarregaItensDevCompleta(pgbStatus: TcxProgressBar): Boolean;
  Var
    strCliConGrid,
    strTpOperGrid,
    strCliConDevo,
    strTpOperDevo,
    strDevInc,
    strDevDoc,
    strDevEsp,
    strDevEmp,
    strDevTab,
    strCliDev: String;
    intSeqCom: Integer;
begin
  Result := True;
  pInformacao('Aguarde, Carregando Itens...', pgbStatus);

  strDevDoc := qryConDev.FieldByName('DET_NUMDOC').AsString;
  strDevEsp := qryConDev.FieldByName('DET_ESPDOC').AsString;
  strDevEmp := qryConDev.FieldByName('DET_CODEMP').AsString;
  intSeqCom := qryConDev.FieldByName('DET_SEQCOM').AsInteger;
  strDevInc := qryConDev.FieldByName('DET_AUTOIN').AsString;
  strDevTab := qryConDev.FieldByName('DET_TABELA').AsString;
  strCliDev := qryConDev.FieldByName('DET_FORCLI').AsString;

  If fCfgSis('USOREV', varBoolean) Then
  Begin
    strCliConGrid := fRetPrimeiroCliConEntreOsDocsInseridos;
    strTpOperGrid := fRetPrimeiroTpOperEntreOsDocsInseridos;
    strCliConDevo := fRetCliConPeloAutInc(qryConDev.FieldByName('DET_TABELA').AsString, qryConDev.FieldByName('DET_AUTOIN').AsString);
    strTpOperDevo := fRetTpOperPeloAutInc(qryConDev.FieldByName('DET_TABELA').AsString, qryConDev.FieldByName('DET_AUTOIN').AsString);

    If (Not fEmptyStr(strCliConGrid)) And (Not fEmptyStr(strCliConDevo)) And (strCliConGrid <> strCliConDevo) Then
    Begin
      If (strCliConGrid = 'S') Then
        fMensagem('','Não é possível devolver em uma mesma operação um documento gravado como Revenda.' + #13#10 +
                     'Já foram selecionados documentos gravados como Uso/Consumo!', ['&Ok'])
      Else
        fMensagem('','Não é possível devolver em uma mesma operação um documento gravado como Uso/Consumo.' + #13#10 +
                     'Já foram selecionados documentos gravados como Revenda!', ['&Ok']);
      Exit;
    End;

    If (fatVenda.strCliCon <> strCliConDevo) Then
    Begin
      fatVenda.strCliCon := strCliConDevo;
      fatVenda.pRedefineTipoAbf;
    End;

    If (Not fEmptyStr(strTpOperGrid)) And (Not fEmptyStr(strTpOperDevo)) And (strTpOperGrid <> strTpOperDevo) Then
    Begin
      fMensagem('','Não é possível devolver um documento com tipo de operações diferentes.' + #13#10 +
                   'USO/CONSUMO, REVENDA e INDUSTRIALIZAÇÃO!', ['&Ok']);
      Exit;
    End;

    If (fatVenda.strTpOper <> strTpOperDevo) Then
    Begin
      fatVenda.strTpOper := strTpOperDevo;
      fatVenda.pRedefineTipoAbf;
    End;
  End;

  If fatVenda.fTravaERegistraStlDocDevLck(strDevTab, strDevDoc, strDevEsp, strDevEmp, strCliDev, strDevInc) Then
  Begin
    pInsereItensDevolucao(strDevTab, strDevDoc, strDevEsp, strDevEmp, strCliDev, intSeqCom, pgbStatus);
  End;
end;

