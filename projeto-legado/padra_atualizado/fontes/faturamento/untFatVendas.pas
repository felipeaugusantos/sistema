function TfrmFatVendas.fVerificaDireitoAcessoVendaFuturaOR_PD: Boolean;
var
  blnAcesso_EntFut: Boolean;
begin
  Result := True;

  If (fCfgSis('USADIG', varBoolean)) And (pnlDigitador.Visible) And (Not fEmptyStr(edtSenDig.Text)) Then
    {Digitador tem acesso?}
    blnAcesso_EntFut := fVerificaAcessoSistema('ORPDVN', fRetCodVendedor(edtSenDig.Text))
  Else
    {Vendedor tem acesso?}
    blnAcesso_EntFut := fVerificaAcessoSistema('ORPDVN', fatVenda.strCodVen);

  If (Not blnAcesso_EntFut) Then
  Begin

    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Sem direito de acesso para vender (OR/PD) em Entrega Futura!');

    objLiberacao.strDirAce  := 'ORPDVN';
    objLiberacao.strMsgSen  := 'Sem direito de acesso para vender (OR/PD) em Entrega Futura!';
    objLiberacao.strCodOpe  := fatVenda.strCodVen;
    objLiberacao.strCodDig  := fatVenda.strCodDig;
    objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
  End;
end;

function TfrmFatVendas.fVerificaDireitoAcessoVendaFuturaOR_PD_VN(strOpcDoc: String;
  strEspDoc: String = ''): Boolean;
begin
  Result := True;

  if Pos(strOpcDoc, 'OR_PD_VN_') <= 0 then
    Exit;

  if not fCfgSis('ORPDVN',varBoolean) Then
    Exit;

  if (fEhOrcamentoPedido(strOpcDoc)) or ((fEhVendaNormal(strOpcDoc)) and (fFechouDocumentoEmOrcamentoPedido(strEspDoc))) then
  begin
    Result := fVerificaDireitoAcessoVendaFuturaOR_PD;
  end
  else if (fEhVendaNormal(strOpcDoc)) and (not fFechouDocumentoEmOrcamentoPedido(strEspDoc)) then
  begin
    Result := fVerificaDireitoAcessoVendaFuturaVN;
  end;
end;

function TfrmFatVendas.fVerificaDireitoAcessoVendaFuturaVN: Boolean;
var
  blnAcesso_EntFut: Boolean;
begin
  Result := True;

  If (fCfgSis('USADIG', varBoolean)) And (pnlDigitador.Visible) And (Not fEmptyStr(edtSenDig.Text)) Then
    {Digitador tem acesso?}
    blnAcesso_EntFut := fVerificaAcessoSistema('PVVNEF', fRetCodVendedor(edtSenDig.Text))
  Else
    {Vendedor tem acesso?}
    blnAcesso_EntFut := fVerificaAcessoSistema('PVVNEF', fatVenda.strCodVen);

  If (Not blnAcesso_EntFut) Then
  Begin

    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Sem direito de acesso para vender (VN) em Entrega Futura!');

    objLiberacao.strDirAce  := 'PVVNEF';
    objLiberacao.strMsgSen  := 'Sem direito de acesso para vender (VN) em Entrega Futura!';
    objLiberacao.strCodOpe  := fatVenda.strCodVen;
    objLiberacao.strCodDig  := fatVenda.strCodDig;
    objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
  End;
end;

function TfrmFatVendas.fVerificaDivergCliVen: Boolean;
Var
  qryGen, qryCli, qryEditor: TUniQuery;
  cdsDados                : TUniClientDataSet;
  strItens,
  strVendedores           : String;
  LrecInfoMarcaFornecedor : TrecInfoMarcaFornecedor;
  strCodigoVendedor       : String;
  blnPodeVenderSomenteParaAlgumasMarcas: Boolean;
  SLVendedoresQueNaoPodemVenderNenhumaMarca: TStringList;
  frmLisCli: TfrmObservacao;

  function fPermitirVendedorSemRelacao(Const strCodVen: String): Boolean;
  begin
    Result := False;

    If (fCfgSis('MDOPCV', varString) = '0') Then
    Begin
      SLVendedoresQueNaoPodemVenderNenhumaMarca.Add(strCodigoVendedor);
    End
    Else If (fCfgSis('MDOPCV', varString) = '1') Then
    Begin
      Result := True;
    End
    Else If (fCfgSis('MDOPCV', varString) = '2') Then
    Begin
      Result := True;

      qryCli := fCriaQuery(Nil);
      Try
        qryCli.Close;
        qryCli.SQL.Text := ' SELECT DISTINCT CONCAT((SELECT CONCAT("VENDEDOR: ",OPE_CODOPE," - ",OPE_NOMOPE) FROM CADOPE WHERE OPE_CODOPE = CVE_CODVEN LIMIT 1)," / CLIENTE: ",CLI_CODCLI," - ",CLI_NOMCLI) AS CLI '+
                           '   FROM CLIVEN INNER JOIN CADCLI ON CVE_CODCLI = CLI_CODCLI '+
                           '  WHERE CVE_CODVEN = :CODVEN      '+
                           '  ORDER BY CLI_NOMCLI, CLI_CODCLI ';
        qryCli.ParamByName('CODVEN').AsString := strCodVen;
        qryCli.Open;
        qryCli.First;

        If (Not qryCli.IsEmpty) Then
        Begin
          Result := False;

          If Not Assigned(frmLisCli) Then
          Begin
            pCriarFormularios(TfrmObservacao, frmLisCli);
            frmLisCli.lblMensagem.Caption := 'Vendedores/Clientes Permitidos';
            frmLisCli.Width := 800;
            frmLisCli.memObs.WordWrap := False;
          End;

          qryCli.Open;
          While Not qryCli.Eof Do
          Begin
            frmLisCli.memObs.Lines.Add(qryCli.Fields[0].Text);
            qryCli.Next;
          End;
        End;
      Finally
        FreeAndNil(qryCli);
      End;
    End;
  end;

begin
  Result := False;

  pInfoMarcaFornecedor(LrecInfoMarcaFornecedor);

  strItens      := EmptyStr;
  strVendedores := EmptyStr;

  frmLisCli := Nil;
  cdsDados  := TUniClientDataSet.Create(Nil);
  qryGen    := fCriaQuery(Nil);
  qryEditor := fCriaQuery(Nil);
  SLVendedoresQueNaoPodemVenderNenhumaMarca := TStringList.Create;
  SLVendedoresQueNaoPodemVenderNenhumaMarca.Sorted := True;
  SLVendedoresQueNaoPodemVenderNenhumaMarca.Duplicates := dupIgnore;
  Try
    qryGen.Close;
    qryGen.SQL.Text := 'SELECT '
                    + LrecInfoMarcaFornecedor.strFieldCodigoDestino
                    + '  FROM CLIVEN '
                    + ' WHERE CVE_CODCLI = :CODCLI ';
    qryGen.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
    qryGen.Open;

    If Not qryGen.IsEmpty Then
    Begin
      qryEditor.Close;
      qryEditor.SQL.Text := 'DROP TEMPORARY TABLE IF EXISTS TMP_REL_VEND_MARC; '
                          + 'CREATE TEMPORARY TABLE TMP_REL_VEND_MARC (	'
                          + '    CODVEN VARCHAR (21), '
                          + '    CODITE VARCHAR (9) '
                          + '); ';
      qryEditor.ExecSQL;

      cdsDados.Data            := cdsVenda.Data;
      cdsDados.LogChanges      := False;
      cdsDados.IndexFieldNames := 'ITE_CODVEN';
      strCodigoVendedor        := EmptyStr;

      If (fCfgSis('VNDSPD', varString) = 'N') Then
      Begin
        If (Not cdsDados.IsEmpty) Then
        Begin
          cdsDados.First;
          cdsDados.Edit;
          cdsDados.FieldByName('ITE_CODVEN').AsString := fatVenda.strCodVen;
          cdsDados.Post;

          cdsDados.Filtered := False;
          cdsDados.Filter   := 'ITE_CODVEN = '+QuotedStr(fatVenda.strCodVen);
          cdsDados.Filtered := True;
          cdsDados.First;
        End;
      End;

      cdsDados.First;
      While (Not cdsDados.Eof) Do
      Begin
        qryGen.Filtered := False;
        qryGen.Filter   := '';

        If strCodigoVendedor <> cdsDados.FieldByName('ITE_CODVEN').AsString Then
        Begin
          strCodigoVendedor := cdsDados.FieldByName('ITE_CODVEN').AsString;

          qryGen.Close;
          qryGen.SQL.Text := 'SELECT '
                           + LrecInfoMarcaFornecedor.strFieldCodigoDestino
                           + '  FROM CLIVEN '
                           + ' WHERE CVE_CODCLI = :CODCLI '
                           + '   AND CVE_CODVEN = :CODVEN ';

          qryGen.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
          qryGen.ParamByName('CODVEN').AsString := strCodigoVendedor;
          qryGen.Open;
        End;

        If qryGen.IsEmpty Then
        Begin
          fPermitirVendedorSemRelacao(strCodigoVendedor);
          cdsDados.Next;
          Continue;
        End
        Else
        Begin
          qryGen.Filtered := False;
          qryGen.Filter   := LrecInfoMarcaFornecedor.strFieldCodigoDestino + ' <> ''';
          qryGen.Filtered := True;

          blnPodeVenderSomenteParaAlgumasMarcas := (qryGen.RecordCount >= 1);

          If blnPodeVenderSomenteParaAlgumasMarcas Then
          Begin
            qryGen.Filtered := False;
            qryGen.Filter   := LrecInfoMarcaFornecedor.strFieldCodigoDestino + ' = '+ QuotedStr(cdsDados.FieldByName(LrecInfoMarcaFornecedor.strItemCodigo).AsString);
            qryGen.Filtered := True;

            If (qryGen.RecordCount = 0) Then
            Begin
              qryEditor.Close;
              qryEditor.SQL.Clear;
              qryEditor.SQL.Text := 'INSERT INTO TMP_REL_VEND_MARC (CODVEN, CODITE) VALUES (:CODVEN, :CODITE);';
              qryEditor.ParamByName('CODVEN').AsString := cdsDados.FieldByName('ITE_CODVEN').AsString;
              qryEditor.ParamByName('CODITE').AsString := cdsDados.FieldByName('ITE_CODITE').AsString;

              qryEditor.ExecSQL;
            End;
          End;
        End;

        cdsDados.Next;
      End;

      qryEditor.Close;
      qryEditor.SQL.Clear;
      qryEditor.SQL.Text := 'SELECT CODITE FROM TMP_REL_VEND_MARC';
      qryEditor.Open;

      If (Not qryEditor.IsEmpty) Or (SLVendedoresQueNaoPodemVenderNenhumaMarca.Count > 0) Or (Assigned(frmLisCli)) Then
      Begin
        Result := True;

        If (Not qryEditor.IsEmpty) Then
        Begin
          qryEditor.Close;

          If Assigned(prcExecutaRelatorio) Then
          begin
            If Assigned(prcExecutaRelatorio) Then
            begin
              prcExecutaRelatorio(432, 11972, [],
                                  [],
                                  [],
                                  nil,
                                  nil,
                                  True,
                                  False);
            End;
          End;
        End;

        If (SLVendedoresQueNaoPodemVenderNenhumaMarca.Count > 0) Then
        Begin
          pMensagemOk('O(s) vendedor(es) a seguir não pode(m) vender para esse cliente!'+#10#13+
                      SLVendedoresQueNaoPodemVenderNenhumaMarca.CommaText);
        End;

        If Assigned(frmLisCli) Then
        Begin
          frmLisCli.ShowModal;
          FreeAndNil(frmLisCli);
        End;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
    FreeAndNil(qryEditor);
    FreeAndNil(cdsDados);
    FreeAndNil(SLVendedoresQueNaoPodemVenderNenhumaMarca);
  End;
end;

function TfrmFatVendas.fVerificaIntervaloMargemValorCndPagto: Boolean;
begin
  Result := True;

  If (Not fatVenda.fDocumentoParaFornecedor) And
     (fCfgSis('CNDVEN') = 'F') And
     (fCfgSis('LIBCND') = '1') And
     (fCfgSis('USACND', varBoolean)) And
     (fCfgSis('PFLCLI', varBoolean)) Then
  Begin
    If (qryConCnd.FieldByName('CND_CODIGO').AsString <> fatVenda.strCodCnd) Then
    Begin
      pPesquisaCadCnd(qryConCnd, qryConCnd, fatVenda.strCodCnd);
    End;

    If (qryConCnd.FieldByName('CND_MARMIN').AsFloat > 0) Or (qryConCnd.FieldByName('CND_MARMAX').AsFloat > 0) Then
    Begin
      If Not fatVenda.fVerificaIntervaloMargemDocumento(qryConCnd.FieldByName('CND_MARMIN').AsFloat,
                                                        qryConCnd.FieldByName('CND_MARMAX').AsFloat,
                                                        'N',
                                                        qryConCnd.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
    If (qryConCnd.FieldByName('CND_FATMIN').AsFloat > 0) Or (qryConCnd.FieldByName('CND_FATMAX').AsFloat > 0) Then
    Begin
      If Not fatVenda.fVerificaIntervaloValorDocumento(qryConCnd.FieldByName('CND_FATMIN').AsFloat,
                                                       qryConCnd.FieldByName('CND_FATMAX').AsFloat,
                                                       'N',
                                                       qryConCnd.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

  If (Not fatVenda.fDocumentoParaFornecedor) And
     (fCfgSis('CNDVEN') = 'I')      And
      fCfgSis('USACND', varBoolean) And
      fCfgSis('PFLCLI', varBoolean) Then
  Begin
    If (qryConCnd.FieldByName('CND_MARMIN').AsFloat > 0) Or (qryConCnd.FieldByName('CND_MARMAX').AsFloat > 0) Then
    Begin
      If Not fatVenda.fVerificaIntervaloMargemDocumento(qryConCnd.FieldByName('CND_MARMIN').AsFloat,
                                                        qryConCnd.FieldByName('CND_MARMAX').AsFloat,
                                                        qryConCnd.FieldByName('CND_TRAMAR').AsString,
                                                        qryConCnd.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
    If (qryConCnd.FieldByName('CND_FATMIN').AsFloat > 0) Or (qryConCnd.FieldByName('CND_FATMAX').AsFloat > 0) Then
    Begin
      If Not fatVenda.fVerificaIntervaloValorDocumento(qryConCnd.FieldByName('CND_FATMIN').AsFloat,
                                                       qryConCnd.FieldByName('CND_FATMAX').AsFloat,
                                                       qryConCnd.FieldByName('CND_TRAFAT').AsString,
                                                       qryConCnd.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
    If (qryConCnd.FieldByName('CND_PARMIN').AsFloat > 0) Or (qryConCnd.FieldByName('CND_PARMAX').AsFloat > 0) Then
    Begin
      If Not fatVenda.fVerificaCondPagtoParcelaMinima(qryConCnd.FieldByName('CND_PARMIN').AsFloat,
                                                      qryConCnd.FieldByName('CND_PARMAX').AsFloat,
                                                      qryConCnd.FieldByName('CND_TRAPAR').AsString,
                                                      qryConCnd.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;
end;

function TfrmFatVendas.fVerificaItensComEmpCarregamento: Boolean;
  Var
    prcScroll: TprcScroll;
begin
  Result := False;
  With cdsVenda Do
  Begin
    pDisableControls(cdsVenda, prcScroll);
    First;
    While Not Eof Do
    Begin
      If fatVenda.fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString) Then
      Begin
        Result := True;
        Break;
      End;
      Next;
    End;
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

function TfrmFatVendas.fVerificaItensComEmpCarregamentoIgualEmpItem(out strCodItens: String): Boolean;
  Var
    prcScroll: TprcScroll;
    stlItens: TStringList;
    arrEmpCarSubIte: TArray<String>;
    blnMesmaEmpresa: Boolean;
begin
  stlItens := TStringList.Create;
  stlItens.Sorted     := True;
  stlItens.Duplicates := dupIgnore;
  Result := False;

  pDisableControls(cdsVenda, prcScroll);
  cdsVenda.First;
  While Not cdsVenda.Eof Do
  Begin
    blnMesmaEmpresa := False;

    If cdsVenda.FieldByName('ITE_BXSBIT').AsString = 'S' Then
    Begin
      If cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E' Then
      Begin
        arrEmpCarSubIte := fatVenda.fGetEmpCarregamentoSubIte(cdsVenda.FieldByName('ITE_CODITE').AsString);

        blnMesmaEmpresa := (Length(arrEmpCarSubIte) > 0) And
                            MatchStr(cdsVenda.FieldByName('ITE_EMPITE').AsString, arrEmpCarSubIte);
      End;
    End
    Else
    Begin
      blnMesmaEmpresa := Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPCAR').AsString) And
                         SameText(cdsVenda.FieldByName('ITE_EMPCAR').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString);
    End;

    If blnMesmaEmpresa Then
    Begin
      Result := True;
      stlItens.Add(cdsVenda.FieldByName('ITE_CODITE').AsString);
    End;
    cdsVenda.Next;
  End;
  pEnableControls(cdsVenda, prcScroll);

  strCodItens := IIF(Result, fCommaText(stlItens), '');
  stlItens.Free;
end;

function TfrmFatVendas.fVerificaItensComEntregaFutura: Boolean;
  Var
    cdsDados: TUniClientDataSet;
begin
  Result := False;
  cdsDados := TUniClientDataSet.Create(nil);
  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;
  With cdsDados Do
  Begin
    First;
    While Not Eof Do
    Begin
      If (FieldByName('ITE_ENTFUT').AsString = 'S') Then
      Begin
        Result := True;
        Break;
      End;
      Next;
    End;
  End;
