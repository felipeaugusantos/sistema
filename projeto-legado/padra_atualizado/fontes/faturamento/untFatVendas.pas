procedure TfrmFatVendas.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
  Var
    strSenha: String;
    strCodTmp: String;
    LblnApagaHint : Boolean;
begin
  If (blnExecutandoFormShow) Then
  Begin
    Key := 0;
    Exit;
  End;

  inherited;
  If (Assigned(fatVenda)) And (fatVenda.blnGravouDocumentos) Then
    Self.Close;

  LblnApagaHint := True;
  if (EdtCodIte.Focused) And
     ((Pos(strOpcDoc, 'OU_TE_') > 0) or ((strOpcDoc = 'NE') And (Not fatVenda.blnComVal))) And
     ((Key = VK_RETURN)or (Key = VK_TAB)) Then
    LblnApagaHint := False;

  if LblnApagaHint then
    HintControler.HideHint;

  Case Key Of
    VK_ESCAPE:
    Begin
      Self.FCancelouImportacaoPlanilha := True;
      If Assigned(ActiveControl) And (ActiveControl Is TRadioButton) Then
        Close;
    End;
  End;

  If InterlockedIncrement(intConfirmando) <> 0 Then
  Begin
    InterlockedDecrement(intConfirmando);
    Key := 0;
    Exit;
  End
  Else
    InterlockedDecrement(intConfirmando);

  If fIsInsert(Key) Then
  Begin
    If edtCodCli.Focused And (Not edtCodCli.ReadOnly) Then
    Begin
      fatVenda.strCodCli := '';

      If fatVenda.fDocumentoParaFornecedor Then
      Begin
        If fVerificaAcessoSistema('frmCadFornecedores') Then
        Begin
          If fEmptyStr(edtCodCli.Text) Or
             fEmptyStr(fCampoTabela('FOR_CODFOR', 'CADFOR', ['FOR_CODFOR'], [fStrZero(edtCodCli.Text, 8)])) Then
            strCodTmp := untFuncIns.fChamaCadFor(Key)
          Else
            strCodTmp := fAlteraCadFor(fStrZero(edtCodCli.Text, 8));

          If (Not fEmptyStr(strCodTmp)) Then
          Begin
            edtCodCli.Text := strCodTmp;
            edtNomCli.Text := fRetNomFornecedor(edtCodCli.Text);
          End;
        End;
      End
      Else
      Begin
        If fVerificaAcessoSistema('frmCadClientes') Then
        Begin
          If fEmptyStr(edtCodCli.Text)                                                                      Or
             (fClienteConsumidor(fRetNomCliente(fStrZero(edtCodCli.Text, 8))))                              Or
             fEmptyStr(fCampoTabela('CLI_CODCLI', 'CADCLI', ['CLI_CODCLI'], [fStrZero(edtCodCli.Text, 8)])) Then
            strCodTmp := fChamaCadCli(Key)
          Else
          Begin
            fatVenda.recDadCli.strCodCli := '';
            strCodTmp := fAlteraCadCli(fStrZero(edtCodCli.Text, 8));
          End;

          If (Not fEmptyStr(strCodTmp)) Then
          Begin
            edtCodCli.Text := strCodTmp;
            edtNomCli.Text := fRetNomCliente(edtCodCli.Text);
          End;
        End;
      End;
    End;
  End;

  If (Shift = [ssAlt]) And (Key = VK_F7) Then
    pConsultaPedidos

  Else If (Shift = [ssCtrl, ssShift]) And (Key = VK_F3) Then
    mnuTrocaPDRefOR.Click

  Else If (Shift = [ssCtrl, ssShift]) And (Key = VK_F10) And (mnuOrcamentos.Visible) Then
    mnuOrcamentos.Click

  Else If (Shift = [ssCtrl, ssShift]) And (Key = VK_F4) And (mnuConsultaCatalogos.Visible) Then
    mnuConsultaCatalogos.Click

  Else If (Shift = [ssCtrl, ssShift]) And (Key = VK_F5) And (mnuSimularVenda.Visible) Then
    mnuSimularVenda.Click

  Else If (Shift = [ssCtrl, ssShift]) And (Key = VK_F12) Then
    mnuTransfEstAnd.Click

  Else If (Shift = [ssCtrl, ssAlt]) And (Key = VK_F7) And (mnuAlterarPegPegGeral.Visible) Then
    mnuAlterarPegPegGeral.Click

  Else If (Shift = [ssCtrl]) And (Key = VK_F2) Then
  Begin
    If Not fVerificaAcessoSistema('ENRROM') Then
    Begin
      fMensagem('', 'Operador não tem direito de acesso em Entregas Realizadas no Romaneio!', ['&O k']);
      Exit;
    End
    Else
      pEntregasRealizadasRomaneio;
  End
  Else If (Shift = [ssCtrl]) And (Key = VK_F3) Then
  Begin
    If Not fVerificaAcessoSistema('ENPROM') Then
    Begin
      fMensagem('', 'Operador não tem direito de acesso em Entregas Pendentes no Romaneio!', ['&O k']);
      Exit;
    End
    Else
      pEntregasPendentesRomaneio;
  End
  Else If (Shift = [ssCtrl]) And (Key = VK_F4) Then
    mnuEntregasRetiraTotal.Click

  Else If (Shift = [ssCtrl]) And (Key = VK_F5) Then
    mnuNumCmp.Click

  Else If (Shift = [ssCtrl]) And (Key = VK_F7) Then
    btnLotIte.Click

  Else If (Shift = [ssCtrl]) And (char(Key) = 'E') And mnuExportarTXTPrecosHUBCitel.Enabled And mnuExportarTXTPrecosHUBCitel.Visible Then
    mnuExportarTXTPrecosHUBCitel.Click

  Else If (Shift = [ssCtrl]) And (Key = VK_F8) And mnuAltEmpItem.Visible Then
    mnuAltEmpItem.Click

  Else If (Shift = [ssCtrl]) And (Key = VK_F11) And mnuAltEmpItens.Visible Then
    mnuAltEmpItens.Click

  Else If (Shift = [ssCtrl]) And (char(Key) = 'D') then
    mnuVendDep.Click

  Else If (Shift = [ssCtrl]) And (char(Key) = 'F') And mnuVisualizarCubagemPaletizacaoDosProdutos.Visible Then
    mnuVisualizarCubagemPaletizacaoDosProdutos.Click

  Else If (Shift = [ssCtrl]) And (char(Key) = 'M') And mnuDescontoPorMarca.Visible Then
    mnuDescontoPorMarca.Click

  Else If (Shift = [ssShift]) And (Key = VK_F7) Then
  Begin
    If fatVenda.blnLibCnf Then
    Begin
      fatVenda.blnLibCnf   := False;
      pnlBotoesVenda.Color := clBtnFace;
    End
    Else
    Begin
      If ffrmSenha(strSenha) Then
      Begin
        If strSenha = SEN_CNF Then
        Begin
          fatVenda.blnLibCnf   := True;
          pnlBotoesVenda.Color := clNavy;
        End;
      End;
    End;
  End

  {*****************************************}
  {* RELACAO DE PEDIDOS DE VENDA POR DOCTO *}
  {**************************************DP*}
  Else If (Shift = [ssAlt]) And (Key = VK_F2) Then
  Begin
