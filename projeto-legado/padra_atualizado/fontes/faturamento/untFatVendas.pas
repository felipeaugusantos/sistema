      objLiberacao.strDirAce := 'frmFatVendas - BR';
      objLiberacao.strMsgSen := 'Emitir Brinde de Produto';
      objLiberacao.strCodOpe := fatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

      Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
    End
    Else
    Begin
      If (fCfgSis('USADIG', varBoolean)) And (pnlDigitador.Visible) And (Not fEmptyStr(edtSenDig.Text)) Then
        Result := fVerificaAcessoSistema('CHKBRI', fRetCodVendedor(edtSenDig.Text))
