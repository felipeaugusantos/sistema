procedure TfrmFatVendas.chkEntCDClick(Sender: TObject);
  Var 
    frmAguarde: TfrmGravando;
begin
  inherited;
  If chkEntCD.Checked And (fatVenda.fVendaMultiLoja Or fatVenda.fPedidoMultiLoja) Then
  Begin
    chkEntCD.Checked := False;
    fMensagem('','Não é possível utilizar entrega pelo CD ' +
                 'quando estiver utilizando venda Multi-Empresa!', ['&Ok']);
    Exit;
  End;

  If (chkEntCD.Checked) And
     (fatVenda.fClienteFilialVenda(edtCodCli.Text)) And
     (fRetCodEmpClienteFilial(edtCodCli.Text) = VS_strCodEmp) Then
  Begin
    chkEntCD.Checked := False;
    fMensagem('','Não é possível utilizar entrega pelo CD quando informar um cliente filial e o cliente filial for a própria loja!', ['&Ok']);
    Exit;
  End;

  If chkEntCD.Checked And fVerificaItensComEntregaFutura And Not fCfgSis('PEF_CD', varBoolean) Then
  Begin
    chkEntCD.Checked := False;
    fMensagem('','Não é possível utilizar entrega pelo CD ' +
                 'com produtos de Entrega Futura!', ['&Ok']);
    Exit;
  End;

  If chkEntCD.Checked And fVerificaItensComEmpCarregamento Then
  Begin
    chkEntCD.Checked := False;
    pMensagemOK('O produto '+ cdsVenda.FieldByName('ITE_CODITE').AsString +'-'+ cdsVenda.FieldByName('ITE_DESITE').AsString +' possui empresa '+
                'responsável pelo carregamento e entrega definida no cadastro ('+ cdsVenda.FieldByName('ITE_EMPCAR').AsString +').'+
                sLineBreak + 'Neste caso, não é permitido gerar o pedido com este item como entrega pelo CD.');
    Exit;
  End;

  If fClienteConsumidor(fatVenda.strCliOri, False, True) And
     chkEntCD.Checked And (fCfgSis('CON_CD', VarString) = 'N') Then
  Begin
    chkEntCD.Checked := False;
    fMensagem('','Sistema configurado para não permitir utilizar entrega pelo CD para ' +
                 'cliente consumidor!', ['&OK']);
    Exit;
  End;

  If fCfgSis('NPDF11', VarBoolean) And chkEntCD.Checked Then
  Begin
    If fatVenda.fTemItensEntregaImediata Then
    Begin
      chkEntCD.Checked := False;
      fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                   'existem itens de entrega imediata e o ' +
                   'Sistema configurado para "Gerar novo Pedido de Venda com itens de ' +
                   'entrega imediata quando faturar um pedido ' +
                   'pelo F11 do Resumo de Caixa?" ', ['&OK']);
      Exit;
    End;
  End;

  If fCfgSis('NPRF11', VarBoolean) And chkEntCD.Checked Then
  Begin
    If fatVenda.fTemItensRetira(opOutraEmpresa) Then
    Begin
      chkEntCD.Checked := False;
      fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                   'existem itens de retira em outra loja e o ' +
                   'Sistema configurado para "Gerar novo Pedido de Venda com itens de ' +
                   'retira em outra loja quando faturar um pedido ' +
                   'pelo F11 do Resumo de Caixa?" ', ['&OK']);
      Exit;
    End;
  End;

  If fCfgSis('NPLF11', VarBoolean) And chkEntCD.Checked Then
  Begin
    If fatVenda.fTemItensRetira(opPropriaEmpresa) Then
    Begin
      chkEntCD.Checked := False;
      fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                   'existem itens de retira na mesma loja e o ' +
                   'Sistema configurado para "Gerar novo Pedido de Venda com itens de ' +
                   'retira na mesma loja quando faturar um pedido ' +
                   'pelo F11 do Resumo de Caixa?" ', ['&OK']);
      Exit;
    End;
  End;

  If fCfgSis('LOCRET', VarBoolean) And chkEntCD.Checked Then
  Begin
    If fatVenda.fTemItensRetira(opTodasEmpresas, opLocalRetiraExpedicao) Then
    Begin
      chkEntCD.Checked := False;
      fMensagem('','Não é possível utilizar entrega pelo CD, pois ' +
                   'existem itens de retira expedição e o ' +
                   'Sistema irá gerar um novo pedido de venda quando faturar ' +
                   'pelo F11 do Resumo de Caixa?" ', ['&OK']);
      Exit;
    End;
  End;

  If Not fValidaEntregaCD Then
  Begin
    chkEntCD.Checked := False;
    fMensagem('ATENÇÃO!', 'Não é permitido vender para o Cliente Filial do Centro de Distribuição utilizando entrega pelo C.D.', ['&O k']);
    Exit;
  End;

  If chkEntCD.Checked And (chkEntCD.Checked <> blnEnt_CDAnt) And (fUsaRotinaWMS(fCfgSis('EMP_CD')) Or fCfgSis('TMQLOT', varBoolean)) And (fatVenda.strOpcDoc = 'PD') Then
  Begin
    pMensagemSonora(
      'Foi selecionada a opção de entrega pelo CD, portanto este documento será de responsabilidade do CD. ' +
      'Após ser gravado ele não poderá mais ser alterado. Somente será possível realizar o ' +
      'cancelamento através do menu de cancelamento de documentos, porém antes será necessário ' +
      'entrar em contato com o responsável pelo CD e confirmar se o documento ainda não foi faturado!');
  End;

  pVerificaSeEhSaldoMatriz;
  fatVenda.blnEnt_CD := chkEntCD.Checked;
  pVerificaComboVigenteGeral;

  If fUsaRotinaWMS(fatVenda.strEmp_CD) Then
  Begin
    fatVenda.pAtualizaLoteItensWMS;
  End;

  If (chkEntCD.Checked <> blnEnt_CDAnt) And (Not fatVenda.fVerificaEstoqueItens(strOpcDoc)) Then
  Begin
    chkEntCD.Checked   := blnEnt_CDAnt;
    fatVenda.blnEnt_CD := blnEnt_CDAnt;

    If fUsaRotinaWMS(fatVenda.strEmp_CD) Then
    Begin
      fatVenda.pAtualizaLoteItensWMS;
    End;

    fatVenda.pAtualizaSaldoItens;
  end
  Else
  Begin

    If chkEntCD.Checked Then
      edtOprFlj.Text := 'N';

    If (edtOprFlj.Text <> fatVenda.strOprFlj) Then
      edtOprFljExit(Self);

    If (blnEnt_CDAnt <> chkEntCD.Checked) And (fTemItemTintometrico) Then
    Begin
      pCriarFormularios(TfrmGravando, frmAguarde);
      Try
        frmAguarde.fExecutarModalA(pTrocaEmpresaProducaoTinta, 'Aguarde...Atualizando Empresa de Produção da Tinta!', '');
        frmAguarde.ShowModal;
      Finally
        pFreeAndNil(frmAguarde);
      End;
    End;

    blnEnt_CDAnt := chkEntCD.Checked;
  End;

  If (Not fEmptyStr(edtCodIte.Text)) Then
    btnCancelaItem.Click;

end;

