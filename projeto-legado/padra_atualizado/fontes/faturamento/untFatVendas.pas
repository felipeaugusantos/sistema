function TfrmFatVendas.fSetarEmpresaDoItem(strEmpIte: String;
  blnItemPosicionado: Boolean = False): Boolean;
  Var
    blnCancel: Boolean;
    prcScroll: TprcScroll;
    intAutIncValidar: Integer;
    oleItensOriginal: OleVariant;
    stlItens: TStringList;
begin
  Result := False;

  stlItens := TStringList.Create;

  Try

    If (fatVenda.strOprFlj = 'S') Then
    Begin
      fMensagem('','Não é possível alterar a empresa dos itens ' +
                   'quando estiver utilizando "Gerar ordem de produção fora da loja"!', ['&Ok']);
      Exit;
    End;

    If (fatVenda.blnEnt_CD) Then
    Begin
      fMensagem('','Não é possível alterar a empresa dos itens ' +
                   'quando estiver utilizando "Entrega através do CD"!', ['&Ok']);
      Exit;
    End;

    If blnItemPosicionado And (Not fatVenda.fPodeTrocarEmpresaItensPREPTE(blnItemPosicionado, stlItens)) Then
      Exit;

    Try
      Screen.Cursor := crHourGlass;
      btnCancelaItem.Click;
      pDisableControls(cdsVenda, prcScroll);
      oleItensOriginal := cdsVenda.Data;//Caso nao valide o estoque restaura os produtos originais

      If (Not blnItemPosicionado) Then
        cdsVenda.First;

      If (pgbProgresso <> Nil) And (Not blnItemPosicionado) Then
      Begin
        pgbProgresso.Visible  := True;
        pgbProgresso.Max      := cdsVenda.RecordCount;
        pgbProgresso.Position := 0;
      End;

      While (Not cdsVenda.Eof) Or blnItemPosicionado Do
      Begin
        If (pgbProgresso <> Nil) And (Not blnItemPosicionado) Then
        Begin
          pgbProgresso.Position := cdsVenda.RecNo;
          pProcessMessages;
        End;

        If (Not blnItemPosicionado) And (Not fatVenda.fPodeTrocarEmpresaItensPREPTE(blnItemPosicionado, stlItens)) Then
        Begin
          cdsVenda.Next;
          Continue;
        End;

        intAutIncValidar := cdsVenda.FieldByName('AUTOINCREM').AsInteger;
        Try
          If (cdsVenda.FieldByName('ITE_EMPITE').AsString <> strEmpIte) Then
          Begin
            blnForcarAtualizarDados := True;
            Try
              pSetFocus(dbgItens);
              pCarregaItensAlteracao;
            Finally
              blnForcarAtualizarDados := False;
            End;
            edtCodEmp.Text := strEmpIte;
            If fValidaCampos(edtCodEmp) Then
              btnAdicionar.Click;
            btnCancelaItem.Click;
          End;
        Finally
          cdsVenda.Locate('AUTOINCREM', intAutIncValidar, []);
        End;

        If (Not blnItemPosicionado) Then
          cdsVenda.Next
        Else
          Break;
      End;

      If (Not blnItemPosicionado) Then
        cdsVenda.First;

      If (pgbProgresso <> Nil) And (Not blnItemPosicionado) Then
        pgbProgresso.Visible := False;

      If (Not blnItemPosicionado) Then
        fatVenda.pMsgPodeTrocarEmpresaItensPREPTE(stlItens);
    Except
      On E: Exception Do
      Begin
        cdsVenda.Data := oleItensOriginal;
        cdsVenda.LogChanges := False;
        pMensagensErro(E.Message, '[TfrmFatVendas.fSetarEmpresaDoItem]');
      End;
    End;

  Finally
    FreeAndNil(stlItens);
  End;

  Screen.Cursor := crDefault;

  pEnableControls(cdsVenda, prcScroll);

  blnCancel := False;

  intAutIncValidar := -1;

  If blnItemPosicionado Then
    intAutIncValidar := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

  If blnCancel Then
  Begin
    cdsVenda.Data := oleItensOriginal;
    cdsVenda.LogChanges := False;
    fatVenda.pFormataDecimaisGrid(nil);
    If intAutIncValidar <> -1 Then
      cdsVenda.Locate('AUTOINCREM', intAutIncValidar, []);
  End;

 If Not blnCancel Then
   Result := True;
end;

function TfrmFatVendas.fSinteticoNotaRemessa(const blnFiltroDocumento,
  blnFiltrarCodIte: Boolean): string;
  Var
    strSQL: String;
Begin
  strSQL := '';

  fExecutaSQL('SET @AUTOINCREM := 0;');

  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  lPAD(@AUTOINCREM := @AUTOINCREM + 1,20,"0") AS AUTOINCREM, ';
  strSQL := strSQL + '  DET_NUMLOT, ';
  strSQL := strSQL + '  DET_IDEPRO, ';
  strSQL := strSQL + '  ITE_CODGRU, ';
  strSQL := strSQL + '  DET_UNIDAD, ';
  strSQL := strSQL + '  DET_CODMAR, ';
  strSQL := strSQL + '  DET_CODFOR, ';
  strSQL := strSQL + '  DET_REFERE, ';
  strSQL := strSQL + '  DET_VAL_RT, ';
  strSQL := strSQL + '  DET_UNIORI, ';
  strSQL := strSQL + '  DET_UNIVIS, ';
  strSQL := strSQL + '  DET_UNITAR, ';
  strSQL := strSQL + '  DET_TAXJUR, ';
  strSQL := strSQL + '  DET_DESCON, ';
  strSQL := strSQL + '  SUM(DET_DESESP) AS DET_DESESP, ';
  strSQL := strSQL + '  SUM(CON_DESESP) AS DET_DESBAI, ';
  strSQL := strSQL + '  DET_TOTCUS, ';
  strSQL := strSQL + '  DET_INCPIS, ';
  strSQL := strSQL + '  DET_ITECHA, ';
  strSQL := strSQL + '  DET_ITETIN, ';
  strSQL := strSQL + '  DET_DESCOR, ';
  strSQL := strSQL + '  DET_TIPPRE, ';
  strSQL := strSQL + '  DET_LAZQUA, ';
  strSQL := strSQL + '  DET_TIPEMB, ';
  strSQL := strSQL + '  DET_PRVTIN, ';
  strSQL := strSQL + '  DET_PRCTIN, ';
  strSQL := strSQL + '  DET_FATTIN, ';
  strSQL := strSQL + '  DET_PROMOC, ';
  strSQL := strSQL + '  DET_SEQTIN, ';
  strSQL := strSQL + '  DET_VOLPRO, ';
  strSQL := strSQL + '  DET_CODACA, ';
  strSQL := strSQL + '  DET_EMPACA, ';
  strSQL := strSQL + '  DET_PROACA, ';
  strSQL := strSQL + '  DET_TABPRE, ';
  strSQL := strSQL + '  DET_TOTCU2, ';
  strSQL := strSQL + '  ITE_PRECUS, ';
  strSQL := strSQL + '  DET_CODITE, ';
  strSQL := strSQL + '  DET_DESCRI, ';
  strSQL := strSQL + '  DET_UNITAR, ';

  strSQL := strSQL + '  0.00 AS DET_QTDFAT, ';
  strSQL := strSQL + '  0.00 AS DET_VALFAT, ';

  strSQL := strSQL + '  SUM(DET_QTDENV) AS DET_QTDENV, ';
  strSQL := strSQL + '  SUM(DET_QTFARE) AS DET_QTFARE, ';
  strSQL := strSQL + '  SUM(DET_QTDPEN) AS DET_QTDPEN, ';
  strSQL := strSQL + '  SUM(DET_TOTITE) AS DET_TOTITE, ';
  strSQL := strSQL + '  SUM(DET_TOTFAT) AS DET_TOTFAT, ';
  strSQL := strSQL + '  SUM(DET_TOTPEN) AS DET_TOTPEN, ';
  strSQL := strSQL + '  DET_CODCLI ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '   ( ' + fAnaliticoNotaRemessa(blnFiltroDocumento, blnFiltrarCodIte) + ' ) AS A ';
  strSQL := strSQL + 'GROUP BY ';
  strSQL := strSQL + '  A.DET_CODITE, A.DET_DESCRI, A.DET_UNIDAD, A.DET_UNITAR ';

  If (fCfgSis('MDLVFE', varString) = '1') Or
     ((fCfgSis('MDLVFE', varString) = '2') And
      (blnFiltrarCodIte)) Then
    strSQL := strSQL + 'HAVING SUM(IFNULL(DET_QTDPEN,0.0)) > 0.0 ';

  Result := strSQL;
end;

function TfrmFatVendas.fSintetizarItensDeOutroDocumento(strIdFATGORSelecionados,
                                                        strIdMOVGERSelecionados,
                                                        strIdNOTGERSelecionados : String;
                                                        tpPrecoImpItem          : TTipoPrecoImpItem;
                                                        AblnOrdemOriginal       : Boolean;
                                                        AblnCarregarAmbiente     : Boolean) : Boolean;
Var
  strTabDet,
  strPrefixoDet,
  strNumLot : String;

  qryDet,
  qryDev,
  qryCnf: TUniQuery;

  objCadLot : TCadLot;

  strIDEPROItemImportacao,
  strITETINItemImportacao : String;

  cdsItensAImportar : TUniClientDataSet;
  cdsItensDevolucao : TUniClientDataSet;
  cdsItensDevSobrou : TUniClientDataSet;

  blnNovoRegistro : Boolean;
  strItens,
  strQuantidade,
  strValor,
  strTotal,
  strSigUnidade : String;

  fltTotalGeral : Double;

  fltVlrIte,
  fltDesIte : Double;

  strCodIteLisOrc: String;
  stlCodIteCodEmp: TStringList;

begin

  Result := True;
  qryDet := fCriaQuery();
  qryDev := fCriaQuery();
  qryCnf := fCriaQuery();

  blnImportandoItensDeOutroDocumento := True;

  Try
    qryDet.Sql.Add('SELECT * FROM ( ');

    strPrefixoDet := 'FDO_';
    strTabDet     := 'FATDOR';
    qryDet.Sql.Add(fSQLDet(strIdFATGORSelecionados, strPrefixoDet, strTabDet, tpPrecoImpItem));

    strPrefixoDet := 'DET_';
    strTabDet     := 'MOVDET';
    qryDet.Sql.Add(' UNION ALL ');
    qryDet.Sql.Add(fSQLDet(strIdMOVGERSelecionados, strPrefixoDet, strTabDet, tpPrecoImpItem));

    strPrefixoDet := 'DET_';
    strTabDet     := 'NOTDET';
    qryDet.Sql.Add(' UNION ALL ');
    qryDet.Sql.Add(fSQLDet(strIdNOTGERSelecionados, strPrefixoDet, strTabDet, tpPrecoImpItem));

    if (AblnOrdemOriginal) then
      qryDet.Sql.Add(') TAB ORDER BY CODEMP, ESPDOC, NUMDOC, AUTOINCREM ')
    else
      qryDet.Sql.Add(') TAB ORDER BY CODITE, DESCRI ');

    qryDet.Open;

    If qryDet.IsEmpty Then
    Begin
      pMensagemOk(MSG_IMPORTACAO);
      Result := False;
      Exit;
    End;

    If (Not dbgItens.DataSource.DataSet.IsEmpty) And
       (fMensagem('Pergunta', 'Existem itens inseridos no documento. Deseja excluí-los?', ['&Sim', '&Não'], 2) = 1) Then
    Begin
      dbgItens.DataSource.DataSet.Last;
      While (Not dbgItens.DataSource.DataSet.IsEmpty) And
            (Not dbgItens.DataSource.DataSet.Bof) Do
      Begin
        If Not fDeletaItem Then
          dbgItens.DataSource.DataSet.Prior;
      End;
      pCalculaTotais;
    End;

    qryDev.Close;
    qryDev.SQL.Clear;
    qryDev.SQL.Add('SELECT DET_IDEPRO AS IDEPRO, ');
    qryDev.SQL.Add('       DET_ITETIN AS ITETIN  ');
    qryDev.SQL.Add('FROM MOVDET ');
    qryDev.SQL.Add(' WHERE ');
    qryDev.SQL.Add('DET_NUMDOC = :NUMDOC AND ');
    qryDev.SQL.Add('DET_ESPDOC = :ESPDOC AND ');
    qryDev.SQL.Add('DET_CODEMP = :CODEMP AND ');
    qryDev.SQL.Add('DET_CODACA = :CODACA AND ');
    qryDev.SQL.Add('DET_EMPACA = :EMPACA ');

    qryCnf.Close;
    qryCnf.SQL.Clear;
    qryCnf.SQL.Add('SELECT DET_IDEPRO AS IDEPRO, ');
    qryCnf.SQL.Add('       DET_ITETIN AS ITETIN, ');
    qryCnf.SQL.Add('       DET_NUMDOC AS DOCCNF, ');
    qryCnf.SQL.Add('       DET_ESPDOC AS ESPCNF, ');
    qryCnf.SQL.Add('       DET_CODEMP AS EMPCNF  ');
    qryCnf.SQL.Add('FROM MOVDET ');
    qryCnf.SQL.Add(' WHERE ');
    qryCnf.SQL.Add('AUTOINCREM = :AUTINC ');

    cdsItensAImportar := fCriaClientDatSet(qryDet, True);
    cdsItensDevolucao := fCriaClientDatSet(qryDet, True);
    cdsItensDevSobrou := fCriaClientDatSet(qryDet, True);

    {Devoluções}
    qryDet.First;
    while not qryDet.eof do
    Begin
      strIDEPROItemImportacao := '';
      strITETINItemImportacao := '';
      qryDev.Close;
      qryCnf.Close;

      If (StrToInt(LeftStr(qryDet.FieldByName('CLAFIS').AsString, 1)) < 5) Then
      Begin

        pCopiaRegistroDataSet(qryDet, cdsItensDevolucao);

        {Req.: 152871 - Documento de devolução com tinta, busca dados na venda.}
        if (not fEmptyStr(qryDet.FieldByName('DOCDEV').AsString)) and
           (not fEmptyStr(qryDet.FieldByName('CODACA').AsString)) and
           (qryDet.FieldByName('TABELA').AsString = 'MOVDET') then
        begin
          qryDev.Close;
          qryDev.ParamByName('NUMDOC').AsString := qryDet.FieldByName('DOCDEV').AsString;
          qryDev.ParamByName('ESPDOC').AsString := qryDet.FieldByName('ESPDEV').AsString;
          qryDev.ParamByName('CODEMP').AsString := qryDet.FieldByName('EMPDEV').AsString;
          qryDev.ParamByName('CODACA').AsString := qryDet.FieldByName('CODACA').AsString;
          qryDev.ParamByName('EMPACA').AsString := qryDet.FieldByName('EMPACA').AsString;
          qryDev.Open;

          If (Not qryDev.IsEmpty) Then
          Begin
            if qryDev.FieldByName('IDEPRO').AsString <> 'NOR' then
            begin
              strIDEPROItemImportacao := qryDev.FieldByName('IDEPRO').AsString;
              strITETINItemImportacao := qryDev.FieldByName('ITETIN').AsString;
            end;
          End;
        end;

        if not fEmptyStr(strIDEPROItemImportacao) then
        Begin
          cdsItensDevolucao.Edit;
          cdsItensDevolucao.FieldByName('IDEPRO').AsString := strIDEPROItemImportacao;
          cdsItensDevolucao.Post;
        End;

        if not fEmptyStr(strITETINItemImportacao) then
        Begin
          cdsItensDevolucao.Edit;
          cdsItensDevolucao.FieldByName('NUMDOC').AsString := qryDet.FieldByName('DOCDEV').AsString;
          cdsItensDevolucao.FieldByName('CODEMP').AsString := qryDet.FieldByName('EMPDEV').AsString;
          cdsItensDevolucao.FieldByName('ESPDOC').AsString := qryDet.FieldByName('ESPDEV').AsString;
          cdsItensDevolucao.FieldByName('ITETIN').AsString := strITETINItemImportacao;
          cdsItensDevolucao.Post;
        End;

      End;

      qryDet.Next;

    End;

    {Agrupamento}
    qryDet.First;
    while not qryDet.eof do
    Begin

      If (StrToInt(LeftStr(qryDet.FieldByName('CLAFIS').AsString, 1)) < 5) Then
      Begin
        qryDet.Next;
        Continue;
      End;

      {Req.: 212402 - Documento de confirmação com tinta, busca dados na venda.}
      if (not fEmptyStr(qryDet.FieldByName('INCCNF').AsString)) and
         (not fEmptyStr(qryDet.FieldByName('CODACA').AsString)) and
         (qryDet.FieldByName('TABELA').AsString = 'NOTDET') then
      begin
        qryCnf.Close;
        qryCnf.ParamByName('AUTINC').AsString := qryDet.FieldByName('INCCNF').AsString;
        qryCnf.Open;

        If (Not qryCnf.IsEmpty) Then
        begin
          if qryCnf.FieldByName('IDEPRO').AsString <> 'NOR' then
          begin
            strIDEPROItemImportacao := qryCnf.FieldByName('IDEPRO').AsString;
            strITETINItemImportacao := qryCnf.FieldByName('ITETIN').AsString;
          end;
        end;
      end;

      If (AblnCarregarAmbiente) Then
      Begin
        blnNovoRegistro := Not(cdsItensAImportar.Locate('CODITE;DESCRI;IDEPRO;ITETIN;COMPLE',
                                VarArrayOf([qryDet.FieldByName('CODITE').AsString,
                                            qryDet.FieldByName('DESCRI').AsString,
                                            IIF(fEmptyStr(strIDEPROItemImportacao), qryDet.FieldByName('IDEPRO').AsString, strIDEPROItemImportacao),
                                            IIF(fEmptyStr(strITETINItemImportacao), qryDet.FieldByName('ITETIN').AsString, strITETINItemImportacao),
                                            qryDet.FieldByName('COMPLE').AsString]), []));
      End
      Else
      Begin
        blnNovoRegistro := Not(cdsItensAImportar.Locate('CODITE;DESCRI;IDEPRO;ITETIN',
                                VarArrayOf([qryDet.FieldByName('CODITE').AsString,
                                            qryDet.FieldByName('DESCRI').AsString,
                                            IIF(fEmptyStr(strIDEPROItemImportacao), qryDet.FieldByName('IDEPRO').AsString, strIDEPROItemImportacao),
                                            IIF(fEmptyStr(strITETINItemImportacao), qryDet.FieldByName('ITETIN').AsString, strITETINItemImportacao)]), []));
      End;

      If (blnNovoRegistro) Then
      Begin

        pCopiaRegistroDataSet(qryDet, cdsItensAImportar);

        cdsItensAImportar.Edit;
        cdsItensAImportar.FieldByName('TOTAL').AsFloat := (cdsItensAImportar.FieldByName('QTDITE').AsFloat * cdsItensAImportar.FieldByName('UNIDIG').AsFloat);
        cdsItensAImportar.Post;

        if not fEmptyStr(strIDEPROItemImportacao) then
        Begin
          cdsItensAImportar.Edit;
          cdsItensAImportar.FieldByName('IDEPRO').AsString := strIDEPROItemImportacao;
          cdsItensAImportar.Post;
        End;

        if not fEmptyStr(strITETINItemImportacao) then
        Begin
          cdsItensAImportar.Edit;
          cdsItensAImportar.FieldByName('NUMDOC').AsString := qryCnf.FieldByName('DOCCNF').AsString;
          cdsItensAImportar.FieldByName('CODEMP').AsString := qryCnf.FieldByName('EMPCNF').AsString;
          cdsItensAImportar.FieldByName('ESPDOC').AsString := qryCnf.FieldByName('ESPCNF').AsString;
          cdsItensAImportar.FieldByName('ITETIN').AsString := strITETINItemImportacao;
          cdsItensAImportar.Post;
        End;

      End
      Else
      Begin
        cdsItensAImportar.Edit;
        cdsItensAImportar.FieldByName('QTDITE').AsFloat := cdsItensAImportar.FieldByName('QTDITE').AsFloat +
                                                                      qryDet.FieldByName('QTDITE').AsFloat;
        cdsItensAImportar.FieldByName('UNIDIG').AsFloat := cdsItensAImportar.FieldByName('UNIDIG').AsFloat +
                                                                      qryDet.FieldByName('UNIDIG').AsFloat;
        cdsItensAImportar.FieldByName('DESCON').AsFloat := cdsItensAImportar.FieldByName('DESCON').AsFloat +
                                                                      qryDet.FieldByName('DESCON').AsFloat;

        cdsItensAImportar.FieldByName('NUMERO_REPETICAO').AsInteger := cdsItensAImportar.FieldByName('NUMERO_REPETICAO').AsInteger+ 1;

        If cdsItensAImportar.FieldByName('IDEPRO').AsString <> 'NOR' Then
          If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoDocumentoOriginalComDesconto] Then
            cdsItensAImportar.FieldByName('TOTCUS').AsFloat := cdsItensAImportar.FieldByName('TOTCUS').AsFloat + qryDet.FieldByName('TOTCUS').AsFloat;

        cdsItensAImportar.FieldByName('TOTITE').AsFloat := cdsItensAImportar.FieldByName('TOTITE').AsFloat + qryDet.FieldByName('TOTITE').AsFloat;
        cdsItensAImportar.FieldByName('TOTAL').AsFloat  := cdsItensAImportar.FieldByName('TOTAL').AsFloat  + (qryDet.FieldByName('QTDITE').AsFloat * qryDet.FieldByName('UNIDIG').AsFloat);

        cdsItensAImportar.Post;
      End;

      qryDet.Next;

    End;

    {Abater devoluções}
    If Not(cdsItensDevolucao.IsEmpty) Then
    Begin

      cdsItensDevolucao.First;
      While Not cdsItensDevolucao.Eof Do
      Begin

        If (cdsItensAImportar.Locate('CODITE;DESCRI;IDEPRO;ITETIN',
                                VarArrayOf([cdsItensDevolucao.FieldByName('CODITE').AsString,
                                            cdsItensDevolucao.FieldByName('DESCRI').AsString,
                                            cdsItensDevolucao.FieldByName('IDEPRO').AsString,
                                            cdsItensDevolucao.FieldByName('ITETIN').AsString]), [])) Then
        Begin
          cdsItensAImportar.Edit;
          cdsItensAImportar.FieldByName('QTDITE').AsFloat := cdsItensAImportar.FieldByName('QTDITE').AsFloat -
                                                             cdsItensDevolucao.FieldByName('QTDITE').AsFloat;

          If cdsItensAImportar.FieldByName('IDEPRO').AsString <> 'NOR' Then
            If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoDocumentoOriginalComDesconto] Then
              cdsItensAImportar.FieldByName('TOTCUS').AsFloat := cdsItensAImportar.FieldByName('TOTCUS').AsFloat - cdsItensDevolucao.FieldByName('TOTCUS').AsFloat;

          cdsItensAImportar.FieldByName('TOTITE').AsFloat := cdsItensAImportar.FieldByName('TOTITE').AsFloat - cdsItensDevolucao.FieldByName('TOTITE').AsFloat;
          cdsItensAImportar.FieldByName('TOTAL').AsFloat  := cdsItensAImportar.FieldByName('TOTAL').AsFloat  - (cdsItensDevolucao.FieldByName('QTDITE').AsFloat * cdsItensDevolucao.FieldByName('UNIDIG').AsFloat);

          cdsItensAImportar.Post;
        End
        Else
          pCopiaRegistroDataSet(cdsItensDevolucao, cdsItensDevSobrou);

        cdsItensDevolucao.Next;

      End;

    End;

    {Valida se sobrou algo, após os abatimentos}
    cdsItensAImportar.Filtered := False;
    cdsItensAImportar.Filter   := 'QTDITE > 0';
    cdsItensAImportar.Filtered := True;

    If cdsItensAImportar.IsEmpty Then
    Begin
      pMensagemOk(MSG_IMPORTACAO);
      Exit(False);
    End;

    pgbProgresso.Max := cdsItensAImportar.RecordCount;
    pgbProgresso.Position := 0;
    pgbProgresso.Visible  := True;

    stlCodIteCodEmp := TStringList.Create;
    Try
      cdsItensAImportar.First;
      While Not cdsItensAImportar.Eof Do
      Begin
         pIncrementaListaStr(cdsItensAImportar.FieldByName('CODITE').AsString, strCodIteLisOrc, True, True, ',', False);
         stlCodIteCodEmp.Add(cdsItensAImportar.FieldByName('CODITE').AsString + VS_strCodEmp);

         cdsItensAImportar.Next;
      End;
    Finally
      fatVenda.pCarregaStringListExcecoes(strCodIteLisOrc, '', stlCodIteCodEmp);
      FreeAndNil(stlCodIteCodEmp);
    End;

    {Importar itens}
    cdsItensAImportar.First;
    While Not cdsItensAImportar.Eof Do
    Begin
      pgbProgresso.Position := pgbProgresso.Position +1;

      objCadLot := TCadLot.Create(Self);
      strNumLot := '';

      Try

        If (chkEntCD.Visible And chkEntCD.Checked) Then
        Begin
          If Not objCadLot.fItemSemNenhumLoteEmpresa(cdsItensAImportar.FieldByName('CODITE').AsString, fCfgSis('EMP_CD')) Then
            strNumLot := objCadLot.fRetArmazemPrincipalVenda(cdsItensAImportar.FieldByName('CODITE').AsString, fCfgSis('EMP_CD'));
        End
        Else
        Begin
          If Not objCadLot.fItemSemNenhumLoteEmpresa(cdsItensAImportar.FieldByName('CODITE').AsString) Then
            strNumLot := objCadLot.fRetArmazemPrincipalVenda(cdsItensAImportar.FieldByName('CODITE').AsString);
        End;

        if (fEmptyStr(strNumLot)) and
           (fUsaRotinaWMS(VS_strCodEmp) Or
            fatVenda.fEmpresaParaFaturamentoUsaWMS(IIF(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text))) then
          strNumLot := 'A DEFINIR';

      Finally
        FreeAndNil(objCadLot);
      End;

      if cdsItensAImportar.FieldByName('IDEPRO').AsString <> 'NOR' then
      begin
        objTintaMaquinaDeOutroPedido := TTintaMaquinaDeOutroPedido.Create;

        objTintaMaquinaDeOutroPedido.NumeroPedidoOriginal  := cdsItensAImportar.FieldByName('NUMDOC').AsString;
        objTintaMaquinaDeOutroPedido.EmpresaPedidoOriginal := cdsItensAImportar.FieldByName('CODEMP').AsString;
        objTintaMaquinaDeOutroPedido.EspeciePedidoOriginal := cdsItensAImportar.FieldByName('ESPDOC').AsString;
        objTintaMaquinaDeOutroPedido.CodigoProduto         := cdsItensAImportar.FieldByName('CODITE').AsString;
        objTintaMaquinaDeOutroPedido.IdentificacaoProduto  := cdsItensAImportar.FieldByName('IDEPRO').AsString;
        objTintaMaquinaDeOutroPedido.TipoPrecoItem         := tpPrecoImpItem;
        objTintaMaquinaDeOutroPedido.RashIteTin            := cdsItensAImportar.FieldByName('ITETIN').AsString;
        objTintaMaquinaDeOutroPedido.CodigoAcabado         := cdsItensAImportar.FieldByName('CODACA').AsString;
        objTintaMaquinaDeOutroPedido.EmpresaAcabado        := cdsItensAImportar.FieldByName('EMPACA').AsString;

        If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoDocumentoOriginalComDesconto] Then
          objTintaMaquinaDeOutroPedido.PrecoDeCusto := (cdsItensAImportar.FieldByName('TOTCUS').AsFloat / cdsItensAImportar.FieldByName('QTDITE').AsFloat)
        Else
          objTintaMaquinaDeOutroPedido.PrecoDeCusto := cdsItensAImportar.FieldByName('TOTCUS').AsFloat;

      end;

      If tpPrecoImpItem in [tpPrecoDocumentoOriginalSemDesconto, tpPrecoTabelaAtualSemDesconto, tpNenhumaDefinicao] Then
      Begin
        fltVlrIte := (cdsItensAImportar.FieldByName('TOTAL').AsFloat / cdsItensAImportar.FieldByName('QTDITE').AsFloat);
        fltDesIte := 0;
      End
      Else
      Begin

        If (tpPrecoImpItem = tpPrecoTabelaAtualComDesconto) Then
        Begin
          fltVlrIte := 0; {Vai pegar o preço da tabela atual}
          fltDesIte := cdsItensAImportar.FieldByName('DESCON').AsFloat;
        End
        Else
        Begin
          fltVlrIte := (cdsItensAImportar.FieldByName('TOTITE').AsFloat / cdsItensAImportar.FieldByName('QTDITE').AsFloat);
          fltDesIte := 0; {TOTITE já tem o desconto do item}
        End;

      End;

      If fIncluirItem(cdsItensAImportar.FieldByName('CODITE').AsString,
                      strNumLot,
                      cdsItensAImportar.FieldByName('QTDITE').AsFloat,
                      fltVlrIte,
                      '',
                      '',
                      '',
                      fltDesIte,
                      cdsItensAImportar.FieldByName('DESCRI').AsString,
                      False,
                      '',
                      IIF(AblnCarregarAmbiente, cdsItensAImportar.FieldByName('COMPLE').AsString, '')) Then
        cdsItensAImportar.Next
      Else
      Begin
        Case fMensagem('Pergunta',
                       'O item ' + cdsItensAImportar.FieldByName('CODITE').AsString +
                       ' - ' + cdsItensAImportar.FieldByName('DESCRI').AsString +
                       ' não foi inserido. O que deseja fazer?',
                       ['Tentar novamente', 'Ignorar', 'Cancelar'],
                       1, False, 1, 0, False, 0, False, False, True) Of
          2: cdsItensAImportar.Next;
          3: Exit;
        End;
      End;

      if Assigned(objTintaMaquinaDeOutroPedido) then
        FreeAndNil(objTintaMaquinaDeOutroPedido);

    End;

    If Not(cdsItensDevSobrou.IsEmpty) Then
    Begin

      fltTotalGeral := 0;

      strItens := fPadR('Código'   ,  7, ' ') +
                  fPadR('Descrição', 60, ' ') +
                  fPadR('UN'       ,  3, ' ') +
                  fPadR('Qtde.'    ,  8, ' ') +
                  fPadR('Valor'    ,  8, ' ') +
                  fPadR('Total'    ,  8, ' ') + #13#10;

      strItens := strItens + fPadL('', 94, '-') + #13#10;

      cdsItensDevSobrou.First;
      While Not cdsItensDevSobrou.Eof Do
      Begin

        strQuantidade := FormatFloat(edtQtdIte.EditFormat, cdsItensDevSobrou.FieldByName('QTDITE').AsFloat);
        strValor      := FormatFloat(edtQtdIte.EditFormat, cdsItensDevSobrou.FieldByName('UNIDIG').AsFloat);
        strTotal      := FormatFloat(edtQtdIte.EditFormat, cdsItensDevSobrou.FieldByName('QTDITE').AsFloat *
                                                           cdsItensDevSobrou.FieldByName('UNIDIG').AsFloat);
        strSigUnidade := fRetSiglaUnidadePorCodIte(cdsItensDevSobrou.FieldByName('CODITE').AsString);
        fltTotalGeral := fltTotalGeral + (cdsItensDevSobrou.FieldByName('QTDITE').AsFloat * cdsItensDevSobrou.FieldByName('UNIDIG').AsFloat);

        strItens := strItens + fPadR(cdsItensDevSobrou.FieldByName('CODITE').AsString,  7, ' ') +
                               fPadR(Copy(cdsItensDevSobrou.FieldByName('DESCRI').AsString, 0, 59), 60, ' ') +
                               fPadR(strSigUnidade,  3, ' ') +
                               fPadR(strQuantidade,  8, ' ') +
                               fPadR(strValor     ,  8, ' ') +
                               fPadR(strTotal     ,  8, ' ') + #13#10;

        cdsItensDevSobrou.Next;

      End;

      If Not strItens.IsEmpty Then
        strItens := strItens + #13#10 + fPadL('Total: ' + FormatFloat(edtQtdIte.EditFormat, fltTotalGeral), 94, ' ');

      pCriarFormularios(TfrmObservacao, frmObservacao);
      frmObservacao.Width := 768;


      Try

        frmObservacao.lblMensagem.Caption := 'Itens de devoluções que não foram deduzidos:';
        frmObservacao.memObs.Font.Size    := 8;
        frmObservacao.memObs.Font.Name    := 'Courier New';
        frmObservacao.memObs.Texto        := strItens;
        frmObservacao.ShowModal;

      Finally
        pFreeAndNil(frmObservacao);
      End;

    End;

  Finally
    pgbProgresso.Visible := False;

    FreeAndNil(qryDet);

    if Assigned(objTintaMaquinaDeOutroPedido) then
      FreeAndNil(objTintaMaquinaDeOutroPedido);

    if Assigned(qryDev) then
      FreeAndNil(qryDev);

    if Assigned(qryCnf) then
      FreeAndNil(qryCnf);

    if Assigned(cdsItensAImportar) then
      FreeAndNil(cdsItensAImportar);

    if Assigned(cdsItensDevolucao) then
      FreeAndNil(cdsItensDevolucao);

    if Assigned(cdsItensDevSobrou) then
      FreeAndNil(cdsItensDevSobrou);

    blnImportandoItensDeOutroDocumento := False;

  End;

end;

procedure TfrmFatVendas.fMenuAlteraEmpresaItem(strEmpAlt: String; blnItemPosicionado: Boolean=False; pgbStatus: TcxProgressBar = Nil;
                                               blnValidarComoSeEstivesseIncluindo: Boolean=False);
  Var
    blnCtrEntRetEmpIte: Boolean;

    oleItensBackup: OleVariant;
    strFilterBackup: String;
    blnFilterBackup: Boolean;
    intAutIncBackup: Integer;

    blnMudouEmpresa: Boolean;
    intContador : Integer;
    intField: Integer;
begin
  intAutIncBackup := -1;
  strFilterBackup := '' ;
  blnFilterBackup := False;
  blnCtrEntRetEmpIte := (fCfgSis('EMCFEN', varInteger) = 2) And
                        (Not fatVenda.blnAbastecimentoDeposito) And
                        (Not fatVenda.blnRegimeEspecialPorEmpresaComFaturamentoDuplo);
  fatVenda.cdsVendaBackup := nil;
  SetLength(arrSemSelecaoAutoIncrem, 0);

  try
    If Not fEmptyStr(strEmpAlt) Then
    Begin
      If blnCtrEntRetEmpIte Then
      Begin
        oleItensBackup  := cdsVenda.Data;
        strFilterBackup := cdsVenda.Filter;
        blnFilterBackup := cdsVenda.Filtered;
        intAutIncBackup := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

        fatVenda.cdsVendaBackup := TUniClientDataSet.Create(nil);
        fatVenda.cdsVendaBackup.Data := cdsVenda.Data;
      End;

      If fCfgSis('VLEMIT', varBoolean) Or (blnValidarComoSeEstivesseIncluindo) Then
        blnMudouEmpresa := fSetarEmpresaDoItem(strEmpAlt, blnItemPosicionado)
      Else
        blnMudouEmpresa := fatVenda.fAtualizaEmpresaItens(strEmpAlt, blnItemPosicionado,pgbStatus);

      If blnCtrEntRetEmpIte And blnMudouEmpresa Then
      Begin
        If Not fMenuEntregasRetiraTotal(strEmpAlt, IIF(blnItemPosicionado, intAutIncBackup, -1)) Then
        Begin
          cdsVenda.Data       := oleItensBackup;
          cdsVenda.LogChanges := False;
          cdsVenda.Filter     := strFilterBackup;
          cdsVenda.Filtered   := blnFilterBackup;

          fatVenda.pFormataDecimaisGrid(nil);
        End;
        cdsVenda.Locate('AUTOINCREM', intAutIncBackup, []);
      End;

      if length(arrSemSelecaoAutoIncrem) > 0 then
      begin
        for intContador := Low(arrSemSelecaoAutoIncrem) to High(arrSemSelecaoAutoIncrem) Do
        begin
          if cdsVenda.Locate('AUTOINCREM', arrSemSelecaoAutoIncrem[intContador], []) and
             fatVenda.cdsVendaBackup.Locate('AUTOINCREM', arrSemSelecaoAutoIncrem[intContador], []) then
          begin
            cdsVenda.Edit;
            For intField := 0 To cdsVenda.Fields.Count -1 Do
              cdsVenda.Fields[intField].Value := fatVenda.cdsVendaBackup.Fields[intField].Value;
            cdsVenda.Post;
          end;
        end;
      end;

      pSetFocus(dbgItens);
      pAtualizaDados(Nil);
    End;
  finally
    if Assigned(fatVenda.cdsVendaBackup) then
    begin
      if fatVenda.cdsVendaBackup.Active then
        fatVenda.cdsVendaBackup.Close;
      FreeAndNil(fatVenda.cdsVendaBackup);
    end;
  end;
end;

function TfrmFatVendas.fMenuEntregasRetiraTotal(strCodEmpPosAltEmp: String = '';
  intAutIncPosAltEmp: Integer = -1): Boolean;
var
  frmSelFatDigTipoEntregaItens: TfrmSelFatDigTipoEntregaItens;
begin

  Result := True;

  If mnuEntregasRetiraTotal.Visible Then
  Begin
    Result := False;

    pCriarFormularios(TfrmSelFatDigTipoEntregaItens, frmSelFatDigTipoEntregaItens);
    Try
      Try
        frmSelFatDigTipoEntregaItens.fatVenda := Self.fatVenda;
        frmSelFatDigTipoEntregaItens.BorderIcons := [biSystemMenu,biMinimize,biMaximize];
        frmSelFatDigTipoEntregaItens.WindowState := wsMaximized;
        If (frmSelFatDigTipoEntregaItens.ShowModal = mrOk) And frmSelFatDigTipoEntregaItens.blnSelecao Then
        Begin
          arrSemSelecaoAutoIncrem := frmSelFatDigTipoEntregaItens.arrSemSelecaoAutoIncrem;

          pCriarFormularios(TfrmFatDigTipoEntregaItens, frmFatDigTipoEntregaItens);
          Try
            Try
              frmFatDigTipoEntregaItens.strCodEmpPosAltEmp := strCodEmpPosAltEmp;
              frmFatDigTipoEntregaItens.intAutIncPosAltEmp := intAutIncPosAltEmp;
              frmFatDigTipoEntregaItens.fatVenda := Self.fatVenda;
              frmFatDigTipoEntregaItens.strSelecao := frmSelFatDigTipoEntregaItens.arrSelecao;
              frmFatDigTipoEntregaItens.strItensEntregaImediata := frmSelFatDigTipoEntregaItens.arrItensEntregaImediata;
              frmFatDigTipoEntregaItens.ShowModal;
              If frmFatDigTipoEntregaItens.blnAlterou Then
              Begin
                Result := True;

                If (LeftStr(frmFatDigTipoEntregaItens.cmbEntRet.Text, 1) = 'E') And (LeftStr(frmFatDigTipoEntregaItens.cmbTipEnt.Text, 1) = 'I') Then
                  dtaEntImediata := StrToDateDef(frmFatDigTipoEntregaItens.mskDtaEnt.Text, 0);

                If (Not blnManterPrecosNegociadosMedianteLiberacao) And
                   (Not blnManterPrecosDentroDiasTolerado) Then
                Begin
                  pRecalculaPrecos(False, False, False, True, '', True);
                  fPreencheMatrizFechamento;
                  pCalculaTotGer;
                  pAtualizarEditsTotais;
                End;
              End;
            Except
              On E: Exception Do
                pMensagensErro(E.Message, '');
            End;
          Finally
            pFreeAndNil(frmFatDigTipoEntregaItens);
            btnCancelaItem.Click;
          End;
        End;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '');
      End;

    Finally
      pFreeAndNil(frmSelFatDigTipoEntregaItens);

    End;
  End;
end;

procedure TfrmFatVendas.pIniciaProcessoComplementoValor;
begin

  If (Not cdsVenda.IsEmpty) Then
  Begin
    fMensagem('ATENÇÃO!', 'Para herdar os itens para Nota Fiscal de complemento de valor, favor excluir os itens já inseridos anteriormente e refazer o processo...', ['&O k']);
    Exit;
  End;

  If (fEmptyStr(edtCodCli.Text)) Then
  Begin
    fMensagem('ATENÇÃO!', 'Favor informar o Cliente antes de iniciar o processo de herança!', ['&O k']);
    pSetFocus(edtCodCli);
    Exit;
  End;

  If (fPedeDadosNotaReferenciaParaComplementoValor) Then
    pCarregaDadosNotaComplementoValor;

end;

function TfrmFatVendas.fSetaVariaveisFechamentoVendaAposPreencherMatrizItens(): Boolean;
Var
  intContador: Integer;
begin
  Result := True;

  If fatVenda.fHouveAlteracaoPeso Then
    fatVenda.strEdiPes := 'E';

  If strOpcDoc = VENDA_REMESSA_FORA_ESTABELECIMENTO_FATURAMENTO Then
    pSetaArrOpcoesRemassaForaEstabelecimento(FVariaveisFechamentoVenda.arrOpcoes)
  Else If fatVenda.blnMeiaNota Then
    pSetaArrOpcoesMeiaNota(FVariaveisFechamentoVenda.arrOpcoes)
  Else
    pSetaArrOpcoes(FVariaveisFechamentoVenda.arrOpcoes);

  fatVenda.blnConfirmandoNotaFiscalConcreto :=
    TFunctionFuncoesFaturamento.
      ValidarConfirmacaoNotaFiscalConcreto(fatVenda.fEhVendaItemConcreto,
                                           fatVenda.blnDesmembrarNotaProdutosServicos,
                                           strOpcDoc);

  fatVenda.blnTaxaBombeamentoPedOrc :=
    TFunctionFuncoesFaturamento.
       TaxaBombeamentoPedidoOrcamento(strOpcDoc,
                                      fatVenda.blnConfirmandoNotaFiscalConcreto,
                                      fatVenda.fEhVendaItemConcreto);

  If (fatVenda.blnTaxaBombeamentoPedOrc) And (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO) Then
  Begin
    fatVenda.fltTotBom := 0.0;
    fatVenda.fltPrcBom := 0.0;
    fatVenda.fltQtdBom := 0.0;
  End;
  If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And (strOpcDoc = 'VN') Then
  Begin
    fatVenda.fltTotBom := 0.0;
    fatVenda.fltPrcBom := 0.0;
    fatVenda.fltQtdBom := 0.0;
  End;

  {*******************************************}
  {* VERIFICA SE É NECESSÁRIO TRAVAR PARA    *}
  {* DEIXAR FECHAR SOMENTE COM ORÇAMENTO     *}
  {****************************************MV*}
  FVariaveisFechamentoVenda.blnTraOrc := False;
  If (fCfgSis('VSEORC', varBoolean) And (strOpcDoc = 'VN')) Then
  Begin
    For intContador := Low(fatVenda.arrMatItens) To High(fatVenda.arrMatItens) Do
    Begin
      If (fatVenda.arrMatItens[intContador].strSemEst = 'S') And (fatVenda.arrMatItens[intContador].strEntSai <> 'E') Then
      Begin
        FVariaveisFechamentoVenda.blnTraOrc := True;
        Break;
      End;
    End;
  End;
end;

procedure TfrmFatVendas.pIniciarDigitacaoCondicaoPagamentoFinalVenda(fraDigCndPagamento: TfraDigCndPagamento; Var strConPag, strCodCnd: String);
begin
  fraDigCndPagamento.blnCnfDoc         := (Pos(strOpcDoc, 'CF_CI_CP_OV_CE_CO_CT_') > 0);
  fraDigCndPagamento.qryConFpg         := qryConFpg;
  fraDigCndPagamento.fatVenda          := fatVenda;

  fraDigCndPagamento.strCodCli         := fatVenda.strCodCli;
  fraDigCndPagamento.strNomCli         := edtNomCli.Text;

  If (fCfgSis('USACND', varBoolean)) And (strOpcDoc <> 'EP') Then
  Begin
    fraDigCndPagamento.edtCodCnd.Text  := strCodCnd;
    fraDigCndPagamento.strCcnAnt       := strCodCnd;
  End;

  fraDigCndPagamento.edtForPag.Text    := fatVenda.strCodFpg;
  fraDigCndPagamento.edtDesForPag.Text := fRetDesFpg(fatVenda.strCodFpg);

  If (fCfgSis('CNDVEN') = 'F')                     And
      fCfgSis('USACND', varBoolean)                And
      fCfgSis('PFLCLI', varBoolean)                And
      fatVenda.fPermiteValidarMargemAndValorCodCnd Then
  Begin
    fraDigCndPagamento.fltMarDoc := fatVenda.fRetornaMargemPraticadaDocumento(fraDigCndPagamento.blnIgnMar);
    fraDigCndPagamento.fltValDoc := fatVenda.fltTotGer;
    fraDigCndPagamento.strOpcDoc := fatVenda.strOpcDoc;
  End
  Else
  Begin
    fraDigCndPagamento.fltMarDoc := 0;
    fraDigCndPagamento.fltValDoc := 0;
    fraDigCndPagamento.strOpcDoc := EmptyStr;
  End;

  If Not fEmptyStr(strCodCnd) Then
  Begin
    fraDigCndPagamento.pCarregaCondicao();
    strConPag := fraDigCndPagamento.mskCndPag.Text;

    If fEmptyStr(strConPag) Then
      fraDigCndPagamento.strCcnAnt := '';
  End;

  If (strOpcDoc <> 'EP') Then
    fraDigCndPagamento.mskCndPag.Text := strConPag
  Else
    fraDigCndPagamento.mskCndPag.Text := fCndEmp;

  fraDigCndPagamento.stlForPag.Text := stlForPag.Text;
  fraDigCndPagamento.stlCndPag.Text := stlCndPag.Text;

  {*********************************************}
  { CARREGA ESTES DADOS PARA SENHA DE LIBERACAO }
  { PARA ZERAR TAXA DE JUROS                    }
  {******************************************JB*}
  fraDigCndPagamento.strCodVen      := fatVenda.strCodVen;
  fraDigCndPagamento.strCodDig      := fatVenda.strCodDig;
  fraDigCndPagamento.strNTrava      := fatVenda.strNTrava;
  fraDigCndPagamento.stlNumLib      := fatVenda.stlNumLib;
  fraDigCndPagamento.blnHabZta      := True;

  fraDigCndPagamento.blnPodeCancelar := True;

  {*********************************}
  {* PARA TRAVA DE CONDIÇÃO DE PGTO*}
  {50660***************************LE}
  fraDigCndPagamento.strCndPedOrc   := strCndSug;

      If ((strOpcDoc = 'CI') And (Not fCfgSis('INFIEL', varBoolean))) Or
         ((strOpcDoc = 'CI') And (fCfgSis('PROCTR') = '1')) Or
         (strOpcDoc = 'EP') Or
         ((strOpcDoc = 'CP') And (fCfgSis('CNDICP') = 'S' {Pedir senha})) Then
      Begin
        If Not fEmptyStr(strConPag) Or (strOpcDoc = 'EP') Then
        Begin
      fraDigCndPagamento.mskCndPag.ReadOnly := True;
      fraDigCndPagamento.mskCndPag.TabStop  := False;
    End;

    If not fEmptyStr(strCodCnd) Then
    Begin
      fraDigCndPagamento.edtCodCnd.ReadOnly := True;
      fraDigCndPagamento.edtCodCnd.TabStop  := False;
    End;

    If not fEmptyStr(fatVenda.strCodFpg) Then
    Begin
      fraDigCndPagamento.edtForPag.ReadOnly := True;
      fraDigCndPagamento.edtForPag.TabStop  := False;
    End;
  End;

  If (strOpcDoc = 'DV') And fCfgSis('DVVORI', varBoolean) Then
  Begin
    strCCndDv := cdsVenda.FieldByName('ITE_CCNDDV').AsString;
    strCndDev := cdsVenda.FieldByName('ITE_CNDDEV').AsString;
    dtaEmiDev := cdsVenda.FieldByName('ITE_EMIDEV').AsDateTime;

    If fCfgSis('USACND', varBoolean) And (Not fEmptyStr(strCCndDv)) Then
    Begin
      fraDigCndPagamento.edtCodCnd.ReadOnly := Not fCfgSis('ALCNDV', varBoolean);
      fraDigCndPagamento.edtCodCnd.Text := strCCndDv;

      If fCfgSis('ALCNDV', varBoolean) Then
      Begin
        fraDigCndPagamento.strCodCndAuxDv := strCCndDv;

        If fCfgSis('USAFPG', varBoolean) Then
          fraDigCndPagamento.strCodFpgAuxDv := fatVenda.strCodFpg;
      End;
    End;

    If Not fEmptyStr(strCndDev) Then
    Begin
      fraDigCndPagamento.mskCndPag.ReadOnly := Not fCfgSis('ALCNDV', varBoolean);
      fraDigCndPagamento.mskCndPag.Text := fRetCondicaoDevolucao(dtaEmiDev, strCndDev);

      If (Not fEmptyStr(fraDigCndPagamento.strCodCndAuxDv)) And (fStatusCndPag(fraDigCndPagamento.mskCndPag.Text) = A_VISTA) And (fraDigCndPagamento.strCodCndAuxDv <> fCfgSis('CNDAVI', varString)) Then
      Begin
        fraDigCndPagamento.edtCodCnd.Text := fCfgSis('CNDAVI', varString);
        fraDigCndPagamento.strCodCndAuxDv := fraDigCndPagamento.edtCodCnd.Text;

        If (Not fEmptyStr(fraDigCndPagamento.strCodFpgAuxDv)) Then
        Begin
           fraDigCndPagamento.edtForPag.Text := '001';
           fraDigCndPagamento.strCodFpgAuxDv := fraDigCndPagamento.edtForPag.Text;
           fraDigCndPagamento.pCarregaForPag;
        End;
      End
      Else If (fCfgSis('USACND', varBoolean)) And
              (Not fCfgSis('ALCNDV', varBoolean)) Then
      Begin
        If (fStatusCndPag(fraDigCndPagamento.mskCndPag.Text) = A_VISTA) Then
          fraDigCndPagamento.edtForPag.Text := '001'
        Else
          fraDigCndPagamento.edtForPag.Text := '008';

        fatVenda.strCodFpg := fraDigCndPagamento.edtForPag.Text;
      End;
    End;
  End;
end;

procedure TfrmFatVendas.pIniciarVariaveisFechamentoVenda();
begin
  FVariaveisFechamentoVenda.blnSecol := (fCfgSis('TPNFCR') = SECOL);
  FVariaveisFechamentoVenda.qryGenDiv := fCriaQuery(Self);
  FVariaveisFechamentoVenda.blnUsaCndVenFinal := ((fCfgSis('USACND', varBoolean)) And (fCfgSis('CNDVEN', varString) = 'F'));
  FVariaveisFechamentoVenda.blnMostraDigDuplic := False;

  blnSolicitouFecharOREmPDLocal := False;
  fatVenda.blnBaixaAdiantamentoAutomatico := False;
  fatVenda.blnSolicitouFecharOREmPD := False;
  fatVenda.blnTaxVpr := False;
  fatVenda.blnDeCndF := False;
  fatVenda.blnVlrMin := False;
  fatVenda.blnAplicaTaxaEntrega := False;
  fatVenda.blnRestringirElementosMargem := False;
  fatVenda.blnEhFechamentoVenda := False;

  fatVenda.blnGerOrc := False;

  fatVenda.blnApenasPrazo := blnApenasPrazo;
  fatVenda.blnApenasVista := blnApenasVista;

  fatVenda.fltValCqP := 0;
  fatVenda.fltValCqV := 0;
  fatVenda.fltValDin := 0;
  fatVenda.fltValCar := 0;
  fatVenda.fltValOrd := 0;
  fatVenda.fltValFin := 0;
  fatVenda.fltFatura := 0;

  fatVenda.optTroco         := otNada;
  fatVenda.optTrocoPre      := otNada;
  fatVenda.optTrocoCar      := otNada;
  fatVenda.fltValorTroco    := 0.0;
  fatVenda.fltValorTrocoPre := 0.0;
  fatVenda.fltValorTrocoCar := 0.0;

  FVariaveisFechamentoVenda.intPosAtual := 0;
  FVariaveisFechamentoVenda.fltTotMod := 0.0;

  fatVenda.blnConApr := (mskCndPag.Text = '01999');

  FVariaveisFechamentoVenda.blnApenasServico := ((cdsVenda.RecordCount=1) And (cdsVenda.Locate('ITE_CODITE', fCfgSis('ITESER', varString), [])));

  {******************************************}
  {* VERIFICA SE EXISTE ALGUM DOCUMENTO A   *}
  {* SER CONFIRMADO ( TR/DV )               *}
  {***************************************MV*}
  FVariaveisFechamentoVenda.blnTemTro := False;
  If (strOpcDoc = 'CF') Then
  Begin
    fatVenda.qryTemporariaConfirmacao.First;
    While Not fatVenda.qryTemporariaConfirmacao.Eof Do
    Begin
      If (Pos( fatVenda.qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString, 'TR_DV_PR_DD_') > 0) Then
      Begin
        FVariaveisFechamentoVenda.blnTemTro := True;
        Break;
      End;
      fatVenda.qryTemporariaConfirmacao.Next;
    End;
  End;

end;

function TfrmFatVendas.fPedeDadosNotaReferenciaParaComplementoValor: Boolean;
begin

  Result := False;

  Try

    pCriarFormularios(TfrmFatDigDadosNfComplValor, frmFatDigDadosNfComplValor);
    frmFatDigDadosNfComplValor.blnDocFor := fatVenda.fDocumentoParaFornecedor;
    frmFatDigDadosNfComplValor.strCodFaz := fatVenda.objFazenda.strCodFaz;
    frmFatDigDadosNfComplValor.strCodcli := fatVenda.strCodCli;
    frmFatDigDadosNfComplValor.blnCupomIPI := blnEhNFCeComplementarIPI;
    frmFatDigDadosNfComplValor.ShowModal;

    If (frmFatDigDadosNfComplValor.blnConfirma) Then
    Begin
      FDtaIniNFeRef := strToDateDef(frmFatDigDadosNfComplValor.mskDtaIni.Text, 0);
      FDtaFinNFeRef := strToDateDef(frmFatDigDadosNfComplValor.mskDtaFin.Text, 0);
      fatVenda.strNumDocNfeRefDevolucao := frmFatDigDadosNfComplValor.edtNumDoc.Text;
      fatVenda.strTipDocNfeRefDevolucao := frmFatDigDadosNfComplValor.edtEspDoc.Text;
      fatVenda.strNumSerNFeRefDevolucao := frmFatDigDadosNfComplValor.edtSerie.Text;
      fatVenda.strChaveNFeRefDevolucao  := frmFatDigDadosNfComplValor.edtChaveAcesso.Text;
      Result := True;
    End
    Else
    Begin
      fatVenda.strNumDocNfeRefDevolucao := '';
      fatVenda.strTipDocNfeRefDevolucao := '';
      fatVenda.strNumSerNFeRefDevolucao := '';
      fatVenda.strChaveNFeRefDevolucao  := '';
    End;

  Except
    On E: Exception Do
      pMensagensErro(e.Message, '[TfrmFatVendas.fPedeDadosNotaReferenciaParaComplementoValor]');
  End;

  pFreeAndNil(frmFatDigDadosNfComplValor);

end;

function TfrmFatVendas.fPedeDadosVendaDeConcreto: Boolean;
begin
  Result := True;

  //Prestcon
  If fAbreTelaFechamentoConcreto Then
  Begin
    Try
      pCriarFormularios(TfrmFatDigDadosConcreto, frmFatDigDadosConcreto);
      frmFatDigDadosConcreto.fatVenda := fatVenda;
      frmFatDigDadosConcreto.ShowModal;
      Result := frmFatDigDadosConcreto.blnConfirma;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, 'Fechamento Concreto');
        Result := False;
      End;
    End;

    pFreeAndNil(frmFatDigDadosConcreto);

    If Not Result Then
      Exit;
  End;

end;

procedure TfrmFatVendas.pCarregaDadosNotaComplementoValor;
Begin

  pCriarFormularios(TfrmGravando, frmGravando);
  frmGravando.fExecutarAcao := fCarregaDadosNotaComplementoValor;
  frmGravando.ShowModal;

  If (frmGravando.blnConfirma) Then
  Begin
    fatVenda.blnComVal := True;
  End;

  pFreeAndNil(frmGravando);

  If (fatVenda.blnComVal) Then
  Begin
    If (fCfgSis('CNDVEN', varString) = 'I') And (blnTroCnd) Then
    Begin
      edtCodCnd.Text := fatVenda.strCodCnd;
      mskCndPag.Text := fatVenda.strConPag;
      edtForPag.Text := fatVenda.strCodFpg;

      fValidaCampos(edtCodCnd, True);
      fValidaCampos(mskCndPag, True);
      fValidaCampos(edtForPag, True);
    End;
  End;

End;

function TfrmFatVendas.fCarregaDadosNotaComplementoValor(pgbStatus: TcxProgressBar = nil): Boolean;
Var
  qryItens_ : TUniQuery;
  qryIteDoc : TUniQuery;
  strSQL    : String;
  recMadeira: TDadosMadeira;
  fltCusIte : Double;
  fltUniEmb : Double;

  strCCoTmp : String;
  strConTmp : String;
  strFpgTmp : String;

  fltImcSTPV : Double;
  blnCalcST : Boolean;

  procedure pSetaMsg(strMensag: String);
  Begin
    TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')).Caption := strMensag;
    pProcessMessages;
  End;
Begin

  Result := False;

  Try

    pSetaMsg('Aguarde...Carregando Itens!');

    qryIteDoc := fCriaQuery(Self);
    qryItens_ := fCriaQuery(Self);

    qryItens_.SQL.Add('SELECT ');
    qryItens_.SQL.Add('  CADITE.*, ');
    qryItens_.SQL.Add('  ITEGER.*, ');

    If fCfgSis('TIPABF') = '1' Then
      qryItens_.SQL.Add('CADITE.ITE_CODABF AS ABF_CODABF, ')
    Else
      qryItens_.SQL.Add('ITEGER.ITE_CODABF AS ABF_CODABF, ');

    qryItens_.SQL.Add('MAR_DESMAR ');

    qryItens_.SQL.Add('FROM ');
    qryItens_.SQL.Add('  CADITE ');
    qryItens_.SQL.Add('  INNER JOIN ITEGER ON ITEGER.ITE_CODITE = CADITE.ITE_CODITE AND ');
    qryItens_.SQL.Add('                       ITEGER.ITE_CODEMP = :CODEMP ');
    qryItens_.SQL.Add('  LEFT  JOIN CADMAR ON CADMAR.MAR_CODMAR = CADITE.ITE_CODMAR ');
    qryItens_.SQL.Add('WHERE ');
    qryItens_.SQL.Add('  CADITE.ITE_CODITE = :CODITE ');

    strSQL := '';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  DET_IDEPRO,  ';
    strSQL := strSQL + '  DET_CODITE,  ';
    strSQL := strSQL + '  DET_DESCRI,  ';
    strSQL := strSQL + '  DET_UNIDAD,  ';
    strSQL := strSQL + '  DET_CODMAR,  ';
    strSQL := strSQL + '  DET_FORITE,  ';
    strSQL := strSQL + '  DET_REFERE,  ';
    strSQL := strSQL + '  DET_UNIORI,  ';
    strSQL := strSQL + '  DET_UNITAR,  ';
    strSQL := strSQL + '  DET_DESCON,  ';
    strSQL := strSQL + '  DET_QTDITE,  ';
    strSQL := strSQL + '  DET_TOTITE,  ';
    strSQL := strSQL + '  DET_TOTCUS,  ';
    strSQL := strSQL + '  DET_TABPRE,  ';
    strSQL := strSQL + '  DET_INCPIS,  ';
    strSQL := strSQL + '  DET_QTDEMB,  ';
    strSQL := strSQL + '  DET_PREEMB,  ';
    strSQL := strSQL + '  DET_PROEMB,  ';
    strSQL := strSQL + '  DET_ITEEMB,  ';
    strSQL := strSQL + '  DET_TOTPES,  ';
    strSQL := strSQL + '  DET_PROMOC,  ';
    strSQL := strSQL + '  DET_SEQTIN,  ';
    strSQL := strSQL + '  DET_NUM_PD,  ';
    strSQL := strSQL + '  DET_ESP_PD,  ';
    strSQL := strSQL + '  DET_EMP_PD,  ';
    strSQL := strSQL + '  MOVDET.AUTOINCREM,  ';
    strSQL := strSQL + '  DET_QTDPON,  ';
    strSQL := strSQL + '  DET_CODACA,  ';
    strSQL := strSQL + '  DET_EMPACA,  ';
    strSQL := strSQL + '  DET_PROACA,  ';
    strSQL := strSQL + '  DET_NUMDOC,  ';
    strSQL := strSQL + '  DET_ESPDOC,  ';
    strSQL := strSQL + '  DET_CODEMP,  ';
    strSQL := strSQL + '  DET_CODCLI,  ';
    strSQL := strSQL + '  DET_TABPRE,  ';
    strSQL := strSQL + '  DET_TOTCU2,  ';
    strSQL := strSQL + '  DET_NUMLOT,  ';
    strSQL := strSQL + '  DET_CODVEN,  ';
    strSQL := strSQL + '  DET_CONPAG,  ';
    strSQL := strSQL + '  DET_CODCND,  ';
    strSQL := strSQL + '  DET_CODFPG,  ';
    strSQL := strSQL + '  DET_ITETIN,  ';
    strSQL := strSQL + '  DET_CLIBUS,  ';
    strSQL := strSQL + '  DET_CODVE2,  ';
    strSQL := strSQL + '  DET_VAL_RT,  ';
    strSQL := strSQL + '  DET_TAXJUR,  ';
    strSQL := strSQL + '  GER_ENTFAT,  ';
    strSQL := strSQL + '  DET_CODFIS,  ';

    If blnEhNFCeComplementarIPI Then
    Begin
      strSQL := strSQL + '  FIS_ACESSO,  ';
    End;

    strSQL := strSQL + '  DET_CFBIPI,  ';
    strSQL := strSQL + '  DET_CFAIPI,  ';
    strSQL := strSQL + '  DET_CFVIPI   ';

    strSQL := strSQL + 'FROM           ';
    strSQL := strSQL + '  MOVDET       ';
    strSQL := strSQL + '  INNER JOIN MOVGER ON MOVGER.AUTOINCREM = DET_SEQGER  ';
    strSQL := strSQL + '  LEFT  JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM  ';

    If blnEhNFCeComplementarIPI Then
    Begin
      strSQL := strSQL + '  INNER JOIN CADFIS ON MOVGER.GER_NUMDOC = FIS_NUMDOC AND ';
      strSQL := strSQL + '                       MOVGER.GER_ESPDOC = FIS_ESPDOC AND ';
      strSQL := strSQL + '                       MOVGER.GER_CODEMP = FIS_CODEMP AND ';
      strSQL := strSQL + '                       MOVGER.GER_TIP_FC = FIS_TIP_FC AND ';
      strSQL := strSQL + '                       IF(FIS_TIP_FC="C", MOVGER.GER_CODCLI, MOVGER.GER_CODFOR) = FIS_FORCLI AND ';
      strSQL := strSQL + '                       IFNULL(MOVGER.GER_SERIE_, "") = IFNULL(FIS_SERIE_, "") ';
    End;

    strSQL := strSQL + 'WHERE          ';

    If blnEhNFCeComplementarIPI Then
    Begin
      strSQL := strSQL + '  MOVGER.GER_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
      strSQL := strSQL + '  MOVGER.GER_ESPDOC = "IF" AND ';
      strSQL := strSQL + '  MOVTRI.DET_CFVIPI > 0 AND ';
      strSQL := strSQL + '  MOVTRI.DET_CIPIOK <> "S" AND ';
      strSQL := strSQL + '  IFNULL(CADFIS.FIS_ACESSO, "") <> "" AND ';
    End
    Else
    Begin
      strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
    End;

    strSQL := strSQL + '  DET_PROEMB <> "S"        ';

    strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(strSQL, 'MOVDET', 'NOTDET'), 'MOVGER', 'NOTGER'), 'MOVTRI', 'NOTTRI');

    qryIteDoc.Close;
    qryIteDoc.SQL.Clear;
    qryIteDoc.SQL.Add(strSQL);

    If blnEhNFCeComplementarIPI Then
    Begin
      qryIteDoc.ParamByName('DTAINI').AsDate := FDtaIniNFeRef;
      qryIteDoc.ParamByName('DTAFIN').AsDate := FDtaFinNFeRef;
    End
    Else
    Begin
      qryIteDoc.ParamByName('NUMDOC').AsString := fatVenda.strNumDocNFeRefDevolucao;
      qryIteDoc.ParamByName('ESPDOC').AsString := fatVenda.strTipDocNfeRefDevolucao;
      qryIteDoc.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryIteDoc.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
    End;

    qryIteDoc.Open;

    SetLength(fatVenda.arrChaveNFReferenciaDocumentos, 0);

    If (qryIteDoc.IsEmpty) Then
    Begin
      If blnEhNFCeComplementarIPI Then
        pMensagemOk('Nenhum documento encontrado no período.')
      Else
        pMensagemOk('Nenhum item encontrado para o documento:' + #13#10 +
                     fatVenda.strNumDocNFeRefDevolucao + '-' + fatVenda.strTipDocNfeRefDevolucao + '-'  + VS_strCodEmp)
    End
    Else
    Begin
      qryIteDoc.First;

      While Not qryIteDoc.Eof Do
      Begin
        If (qryIteDoc.RecNo = 1) Then
        Begin
          strConTmp := qryIteDoc.FieldByName('DET_CONPAG').AsString;
          strCCoTmp := qryIteDoc.FieldByName('DET_CODCND').AsString;
          strFpgTmp := qryIteDoc.FieldByName('DET_CODFPG').AsString;
        End;

        pSetaMsg('Aguarde...Inserindo itens: ' + intToStr(qryIteDoc.RecNo) + '/' + intToStr(qryIteDoc.RecordCount) + #13#10 +  Copy(qryIteDoc.FieldByName('DET_DESCRI').AsString, 1, 25));

        qryItens_.Close;
        qryItens_.ParamByName('CODITE').AsString := qryIteDoc.FieldByName('DET_CODITE').AsString;
        qryItens_.ParamByName('CODEMP').AsString := qryIteDoc.FieldByName('DET_CODEMP').AsString;
        qryItens_.Open;

        If fCfgSis('PRECUV') = '1' Then
          fltCusIte := qryIteDoc.FieldByName('DET_TOTCUS').AsFloat / (qryIteDoc.FieldByName('DET_QTDITE').AsFloat)
        Else
          fltCusIte := qryIteDoc.FieldByName('DET_TOTCU2').AsFloat / (qryIteDoc.FieldByName('DET_QTDITE').AsFloat);

        If (qryIteDoc.FieldByName('DET_QTDEMB').AsFloat > 0) Then
          fltUniEmb := (qryIteDoc.FieldByName('DET_PREEMB').AsFloat /
                        qryIteDoc.FieldByName('DET_QTDEMB').AsFloat)
        Else
          fltUniEmb := 0.0;

        fatVenda.objIcStPv.pAdd(qryIteDoc.FieldByName('DET_CODITE').AsString,
                                fatVenda.fGetEmpCalculoItem(),
                                fatVenda.GetTipAbf(),
                                fatVenda.fUFDestTrib(''),
                                qryIteDoc.FieldByName('DET_CODFIS').AsString,
                                fltImcSTPV,
                                blnCalcST);

        fatVenda.pCarregaValoresCusto(qryItens_.FieldByName('ITE_CODITE').AsString,
                                      qryItens_.FieldByName('ITE_CODEMP').AsString,
                                      qryIteDoc.FieldByName('DET_TABPRE').AsString);

        fatVenda.pAdicionaRegistroTemporaria(cdsVenda,
                                             Nil,
                                             qryIteDoc.FieldByName('DET_IDEPRO').AsString,
                                             qryItens_.FieldByName('ITE_CODGRU').AsString,
                                             qryIteDoc.FieldByName('DET_CODITE').AsString,
                                             qryIteDoc.FieldByName('DET_DESCRI').AsString,
                                             qryIteDoc.FieldByName('DET_DESCRI').AsString,
                                             qryItens_.FieldByName('ITE_DESFAB').AsString,
                                             qryIteDoc.FieldByName('DET_UNIDAD').AsString,
                                             qryIteDoc.FieldByName('DET_UNIDAD').AsString,
                                             qryIteDoc.FieldByName('DET_CODMAR').AsString,
                                             qryIteDoc.FieldByName('DET_FORITE').AsString,
                                             qryIteDoc.FieldByName('DET_REFERE').AsString,
                                             qryIteDoc.FieldByName('DET_UNIORI').AsFloat,
                                             qryIteDoc.FieldByName('DET_UNITAR').AsFloat,
                                             qryIteDoc.FieldByName('DET_UNITAR').AsFloat,
                                             qryIteDoc.FieldByName('DET_UNITAR').AsFloat,
                                             qryIteDoc.FieldByName('DET_DESCON').AsFloat,
                                             qryIteDoc.FieldByName('DET_QTDITE').AsFloat,
                                             qryIteDoc.FieldByName('DET_TOTITE').AsFloat,
                                             'S',
                                             qryIteDoc.FieldByName('DET_TOTCUS').AsFloat / (qryIteDoc.FieldByName('DET_QTDITE').AsFloat),
                                             qryIteDoc.FieldByName('DET_TOTCUS').AsFloat,
                                             qryItens_.FieldByName('ITE_COMLUB').AsString,
                                             qryItens_.FieldByName('ITE_IPISAI').AsFloat,
                                             qryItens_.FieldByName('ITE_DESMAX').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE1').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE2').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE3').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE4').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE5').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE6').AsFloat,
                                             qryItens_.FieldByName('ITE_PREVE7').AsFloat,
                                             fCalculaPrecoVenda(2, fltCusIte,
                                                                   qryIteDoc.FieldByName('DET_UNITAR').AsFloat,
                                                                   0,
                                                                   fatVenda.fRetIcmSai(qryItens_.FieldByName('ITE_ICMSAI').AsFloat) + fatVenda.fAlqDifIcmsPrecoDinamico(qryIteDoc.FieldByName('DET_CODITE').AsString, '', qryItens_.FieldByName('ABF_CODABF').AsString, qryIteDoc.FieldByName('DET_CODFIS').AsString, fatVenda.fRetIcmSai(qryItens_.FieldByName('ITE_ICMSAI').AsFloat)),
                                                                   fatVenda.fRetImpFed(qryItens_.FieldByName('ITE_IMPFED').AsFloat),
