function TfrmFatVendas.fUsaEmpIdentificaClienteSemPossibilidaMudar: Boolean;
begin
  Result := (fCfgSis('IDEEMP', varBoolean)) And
            (fCfgSis('OBEMID', varBoolean)) And
            (pnlEntrega.Visible) And
            (edtCodEmp.Visible) And
            (Not edtCodEmp.Enabled) And
            (Not fEmptyStr(edtCodEmp.Text)) And
            (edtCodEmp.Text <> VS_strCodEmp);
end;

function TfrmFatVendas.fUsaServico: Boolean;
begin
  Result := ((fCfgSis('USASER', varBoolean)) Or (fCfgSis('CONEQU', varBoolean)))And
            (IIF(Pos(strOpcDoc,'PD_OR_') > 0, fCfgSis('PDORSE',VarBoolean), True)) And
            ((fCfgSis('TIPNFS') = '1') Or ((fCfgSis('TIPNFS') = '2') And (Pos(strOpcDoc,'VS_PD_OR_CF_CP_OV_') > 0))) And
            (strOpcDoc <> 'NC') And
            (fExibirServicoParaAutocenter) And
            (IIF(fCfgSis('SERCLF', varBoolean) And fatVenda.blnCliFil, True, (Not fatVenda.blnCliFil))) And
            (Not fatVenda.blnDevNota) And
            //(Not fatVenda.blnMulLoj) And //Comentado pelo REQ.:203718
            (Not fatVenda.fEhVendaItemConcreto) And
            (strOpcDoc <> 'CS');
end;

