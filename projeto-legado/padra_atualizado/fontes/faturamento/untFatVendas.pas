Function TfrmFatVendas.fValidaUnitario(fltDesCon: Double;
                                       cdsIteTin: TUniClientDataSet;
                                       pCalcAliqMargemAntesAdicionarItem: TProcCalculaAliquotasParaMargemAntesAdicionarItem = nil): Boolean;
Var
  fltUnitar   : Double;
  fltTotalG   : Double;
  fltQtdJaDig : Double;
  fltQtdJaEmPromoc : Double;
  strTabPreTmp     : String;

  function fEhBrinde : Boolean;
  begin
    Result := (chkBrinde.Visible And chkBrinde.Checked) Or (blnInserindoBrindeDV) Or (strOpcDoc = 'BR');
  end;

Begin
  Result := True;
  If (fltDesCon > 0) And fatVenda.blnCliFil Then
  Begin
    fMensagem('', 'Desconto não é permitido para cliente filial!', ['&O k']);
    pSetFocus(edtDesCon);
    Result := False;
    Exit;
  End;

  If (fCfgSis('TIPDES') = '%') And (fltDesCon >= 100) Then
  Begin
    fMensagem('', 'Desconto não permitido!', ['&O k']);
    pSetFocus(edtDesCon);
    Result := False;
    Exit;
  End
  Else If (fCfgSis('TIPDES') <> '%') And (Not fEhBrinde) Then
  Begin

    If fFormataFloat(fltDesCon, fatVenda.VS_intDecUni) >= fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni) Then
    Begin
      fMensagem('', 'Desconto maior ou igual o valor unitário não permitido!', ['&Ok']);
      pSetFocus(edtDesCon);
      Result := False;
      Exit;
    End;

  End;

  fltUnitar := fStrToFloat(edtUnitar.Text);
  fltTotalG := fatVenda.fltTotGer;

  strTabPreTmp := fatVenda.fDefineTabelaPrecoItem(fatVenda.strIdePro, strCodAca);

  fltQtdJaDig := fatVenda.fRetQtdDigitada(fCodItem, edtNumLot.Text, IIF(btnAdicionar.Tag <= 0, '',
    cdsVenda.FieldByName('AUTOINCREM').AsString), strCodAca, strEmpAca, fRetEmpresaItem, False);

  fltQtdJaEmPromoc := fatVenda.fRetQtdDigitada(fCodItem, edtNumLot.Text, IIF(btnAdicionar.Tag <= 0, '',
    cdsVenda.FieldByName('AUTOINCREM').AsString), strCodAca, strEmpAca, fRetEmpresaItem,
    False, False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior, True {Somente em promocao});

  if (fatVenda.fUsaValidaMargemCondPerfilItem) and (fCfgSis('CNDVEN') = 'I') then
  Begin
    Result := fatVenda.fValidaMargemCondPatgo(fltUnitar,
                                              fltTotalG,
                                              strCcnAnt,
                                              fStrToFloat(edtQtdIte.Text),
                                              fltQtdJaDig,
                                              fltQtdJaEmPromoc,
                                              fatVenda.fltUniOri,
                                              0,
                                              fltPreEmb,
                                              fltUniDev,
                                              fltEmbala,
                                              fltDesCon,
                                              fltPrcTin,
                                              fltPrvTin,
                                              fatVenda.fltCusIte,
                                              intQtdEmb,
                                              cdsVenda.FieldByName('ITE_TOTITE').AsFloat,
                                              IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                              IIF(cbTabPrecoItem.Visible, fTabelaDePrecoDosItens, strTabPreTmp),
                                              fCodItem,
                                              edtDesIte.Text,
                                              fatVenda.strIdePro,
                                              strTipPre,
                                              strIteTin,
                                              strCatalize,
                                              fatVenda.strPromoc,
                                              cmbEntSai.Text[1],
                                              IIF(chkBrinde.Checked, 'S', 'N'),
                                              fAlterandoProduto,
                                              cdsVenda,
                                              qryConCit,
                                              qryTinta,
                                              qryConIte,
                                              fatVenda.fltPreLot,
                                              fRetSiglaUnidadePorCodIte(edtCodIte.Text),
                                              IIF((fatVenda.strIdePro = 'NOR') and (not blnProAca) And (Not fEhItemVendaVidro(fCodItem)), qryConIte.FieldByName('ITE_PREMED').AsFloat, fatVenda.fltPreMed),
                                              IIF((fatVenda.strIdePro = 'NOR') and (not blnProAca) And (Not fEhItemVendaVidro(fCodItem)), qryConIte.FieldByName('ITE_IMPULT').AsFloat, fatVenda.fltImpUlt),
                                              True,
                                              (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                                              (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                                              fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                              0,
                                              strCodBarEmb,
                                              IIF(btnAdicionar.Tag = 0, fatVenda.fltUnitarioSubItemEstrutura, cdsVenda.FieldByName('ITE_UNISBI').AsFloat),
                                              Nil,
                                              blnProAca,
                                              (blnInserindoCombo) Or (fItemCombo),
                                              '1',
                                              fltVolPro,
                                              False,
                                              cdsIteTin);
  End;

  If Result Then
  Begin
    Result := fatVenda.fValidaUnitario(fltUnitar,
                                       fltTotalG,
                                       strCcnAnt,
                                       fStrToFloat(edtQtdIte.Text),
                                       fltQtdJaDig,
                                       fltQtdJaEmPromoc,
                                       fatVenda.fltUniOri,
                                       0,
                                       fltPreEmb,
                                       fltUniDev,
                                       fltEmbala,
                                       fltDesCon,
                                       fltPrcTin,
                                       fltPrvTin,
                                       fatVenda.fltCusIte,
                                       intQtdEmb,
                                       cdsVenda.FieldByName('ITE_TOTITE').AsFloat,
                                       IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                       IIF(cbTabPrecoItem.Visible, fTabelaDePrecoDosItens, strTabPreTmp),
                                       fCodItem,
                                       edtDesIte.Text,
                                       fatVenda.strIdePro,
                                       strTipPre,
                                       strIteTin,
                                       strCatalize,
                                       fatVenda.strPromoc,
                                       cmbEntSai.Text[1],
                                       IIF(chkBrinde.Checked, 'S', 'N'),
                                       fAlterandoProduto,
                                       cdsVenda,
                                       qryConCit,
                                       qryTinta,
                                       qryConIte,
                                       fatVenda.fltPreLot,
                                       fRetSiglaUnidadePorCodIte(edtCodIte.Text),
                                       IIF((fatVenda.strIdePro = 'NOR') and (not blnProAca) And (Not fEhItemVendaVidro(fCodItem)), qryConIte.FieldByName('ITE_PREMED').AsFloat, fatVenda.fltPreMed),
                                       IIF((fatVenda.strIdePro = 'NOR') and (not blnProAca) And (Not fEhItemVendaVidro(fCodItem)), qryConIte.FieldByName('ITE_IMPULT').AsFloat, fatVenda.fltImpUlt),
                                       IIF((fatVenda.strIdePro = 'NOR') and (not blnProAca) And (Not fEhItemVendaVidro(fCodItem)), qryConIte.FieldByName('ITE_PREULT').AsFloat, fatVenda.fltPreUlt),
                                       True,
                                       (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                                       (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                                       fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                       0,
                                       strCodBarEmb,
                                       IIF(btnAdicionar.Tag = 0, fatVenda.fltUnitarioSubItemEstrutura, cdsVenda.FieldByName('ITE_UNISBI').AsFloat),
                                       Nil,
                                       blnProAca,
                                       (blnInserindoCombo) Or (fItemCombo),
                                       '1',
                                       fltVolPro,
                                       cdsIteTin,
                                       True,
                                       fEhPromocaoTabIte,
                                       pCalcAliqMargemAntesAdicionarItem);
  End;

  If Result Then
  Begin
    edtUnitar.Text     := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUnitar);
    fatVenda.fltTotGer := fltTotalG;
    pCalculaTotIte(fltUnitar);
    pAtualizaUnitarioLiquido;
  End;
End;

Function TfrmFatVendas.fVerificaLimiteCredito:Boolean;
  var
    fltValorCompra: Double;
    blnAplicarDescontos: Boolean;

    objParametrosMensagem: TParametrosMensagem;
Begin
  Result := True;

  if (fCfgSis('ALPKNK', varBoolean)) and
     (Pos(fatVenda.strCodCnd, fCfgSis('CNDBOL', varString)) > 0) then
  begin
    if fFormataFloat(fatVenda.fltTotGer, 2) > fFormataFloat(fatVenda.fltLimBolAlp, 2) then
    begin
      Result := False;

      objParametrosMensagem := TParametrosMensagem.Create;
      try
        objParametrosMensagem.Titulo := 'Alpe';
        objParametrosMensagem.Texto  := 'Cliente não possui limite suficiente!'+#13#10+
                                        'Valor Total do Pedido: ' + Format('%m', [fatVenda.fltTotGer])+#13#10+
                                        'Limite Alpe Disponível: ' + Format('%m', [fatVenda.fltLimBolAlp])+#13#10;
        objParametrosMensagem.Opcoes := ['&OK'];
        fMensagem(objParametrosMensagem);
      finally
        objParametrosMensagem.Free;
      end;
    end;

    Exit;
  end;

  //A partir de agora irá validar o limite de crédito pelo total do documento, inclusive com os impostos
  fltValorCompra := fatVenda.fltTotGer;

  If (Not (Pos(strOpcDoc, 'OU_OV_NC_BR_TE_OE_EF_OF_CF_CI_CN_UC_DV_PR_DD_') > 0)) And
     (qryConCli.Active) And
     (not blnNEFornecedor) Then
  Begin
    //blnAplicarDescontos := IIF((fatVenda.fltPorDes > 0) And (fCfgSis('CNDVEN') = 'F'), False, True);
    blnAplicarDescontos := True;
    
    Result := fatVenda.fVerificaLimiteCredito( fatVenda.strConPag,
                                               fLimiteCreditoCliente(qryConCli.FieldByName('CLI_CODCLI').AsString),
                                               fltValorCompra,
                                               True,
                                               blnAplicarDescontos );
  End
  Else
    Result := True;

End;

function TfrmFatVendas.fVerificaLimiteItensNFe: Boolean;
Var
