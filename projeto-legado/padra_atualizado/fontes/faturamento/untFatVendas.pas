  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddSeparador(65);
    objLiberacao.objMsgLibera.pAddTexto('Senha para Visualização do Resumo Financeiro do Cliente');
    objLiberacao.objMsgLibera.pAddSeparador(65);
    objLiberacao.objMsgLibera.pAddTextoCaption('CPF'                   , fRetCgcCpf(edtCodCli.Text)                        , 14);
