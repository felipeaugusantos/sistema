  blnGravouItemPlanilha := False;
  blnJaAvisouEntFut := False;
  blnTipBusCodBar := False;
  fltValorOriginalItemEstrutura := 0;
  blnInserindoMaisUmItemPeloCodBar := False;
end;

procedure TfrmFatVendas.dbgItensKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
  Var
    prcScroll: TprcScroll;
begin
  inherited;

  If blnAdicionando Then
  Begin
    Key := 0;
    Exit;
  End;

  If InterlockedIncrement(intConfirmando) <> 0 Then
  Begin
    InterlockedDecrement(intConfirmando);
    Key := 0;
    Exit;
  End
  Else
    InterlockedDecrement(intConfirmando);

  If (Key = VK_F1) Then
  Begin
    Key := 0;

    If blnAjuda Then
    Begin
      HintControler.HideHint;
      blnAjuda := False;
    End
    Else
    Begin
      dbgItens.Hint :=
        'ESC: Voltar ao código do item ' + #13#10 +
        'ENTER: Alterar Item ' + #13#10 +
        'DELETE: Deleta o item ' + #13#10 +
        'CTRL + CIMA: Mover item para cima ' + #13#10 +
        'CTRL + BAIXO: Mover item para baixo ';

      HintControler.ShowHint(Self.Left + dbgItens.Left + 25,
                             50 + Self.Top + dbgItens.Top, 'Teclas de atalho', dbgItens.Hint);
      blnAjuda := True;
    End;

    Exit;
  End;

  If (Key = VK_Escape) Then
  Begin
    btnCancelaItem.Click;
  End
  Else If (Key = VK_Return) Then
  Begin
    If (fPermiteAlterarItem) And (fPodeAlterarItemCombo) And (fPermiteAlterarItemFormulacaoBaixada) Then
    Begin
      If (Shift = [ssCtrl]) And mnuTrocarProduto.Visible Then
      Begin
        mnuTrocarProduto.Click;
      End
      Else
      Begin
        blnInsertTmp := False;
        pCarregaItensAlteracao;
      End;
    End;
  End
  Else If (Key = VK_Delete) And
           fEmptyStr(cdsVenda.FieldByName('ITE_KEY_EP').AsString) Then
  Begin
    pDeletarItemGrade;
  End
  Else If (Key = VK_SPACE) Then
  Begin
    pEscolheEmpresaProducaoForaLoja;
  End;

  If (Shift=[ssCtrl]) and (Key = VK_Down) Then
  Begin
    Key := 0;
    Try
      pDisableControls(cdsVenda, prcScroll);
      pMoveItemBaixo;
    Finally
      pEnableControls(cdsVenda, prcScroll, True);
    End;
  End;
  If (Shift=[ssCtrl]) and (Key = VK_Up) Then
  Begin
    Key := 0;
    Try
      pDisableControls(cdsVenda, prcScroll);
      pMoveItemCima;
    Finally
      pEnableControls(cdsVenda, prcScroll, True);
    End;
  End;

  If (Key = VK_TAB) And pnlPesquisarDescricao.Visible Then
  Begin
    Key := 0;
  End;

  If (Key = VK_TAB) And
    (Not blnRowSelect) Then
  Begin
    Key := 0;
    SelectNext(ActiveControl, True, True);
  End;

end;

