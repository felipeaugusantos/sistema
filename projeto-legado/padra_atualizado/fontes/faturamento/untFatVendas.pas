function TfrmFatVendas.fPermiteSugerirLocalRetira():Boolean;
begin
  Result := True;

  If (chkCheckOut.Checked) Then
    Result := (cmbLocRet.ItemIndex < 0);
end;

procedure TfrmFatVendas.pSetaCampoDestino(blnVerificaGridVendaVazio: Boolean=True);
var
  RecResult1Destino : TRecResult1Destino;
begin
  If fPermiteSugerirLocalRetira() Then
    cmbLocRet.ItemIndex := fSugestaoLocalRetira;

  RecResult1Destino := fPermitirApenas1Destino;

  If RecResult1Destino.blnPermitirApenas1Destino Then
  Begin
    pEnabledDestino(RecResult1Destino.intQtdItemEmp <= 0);
    cmbEntRet.ItemIndex := RecResult1Destino.intIdxEntRet;
    cmbTipEnt.ItemIndex := RecResult1Destino.intIdxTipEnt;
    cmbLocRet.ItemIndex := RecResult1Destino.intIdxLocRet;
  End
  Else If strOpcDoc = 'UC' Then
    cmbEntRet.ItemIndex := IDX_RETIRA
    
  Else If (Pos(strOpcDoc, 'DV_PR_') > 0) Then
    cmbEntRet.ItemIndex := IDX_ENTREGA

  Else If (blnDesVaz) And (cmbEntRet.Visible) And (fCfgSis('ENTFAT', varString, fGetEmpConfigEntrega) = 'S') And (fatVenda <> Nil) Then
  Begin
    If blnVerificaGridVendaVazio Then
      If fGridVendaVazio Then
        fatVenda.intIdxPri := IDX_VAZIO;

    If (fatVenda.intIdxPri = IDX_VAZIO) Then
    Begin
      cmbEntRet.ItemIndex := IDX_VAZIO; // Indice do primeiro registro inserido
      pnlLocRet.Visible := False;
    End
    Else
    Begin
      cmbEntRet.ItemIndex := fatVenda.intIdxPri; // Indice do primeiro registro inserido
      cmbTipEnt.ItemIndex := fTipEntPrimeiroItem;
      cmbLocRet.ItemIndex := fLocRetPrimeiroItem;
    End;
  End

  Else If (Assigned(fatVenda)) And (fatVenda.blnCliFil) Then
  Begin
    If fCfgSis('SUG_TE', VarString, fGetEmpConfigEntrega) = 'S' Then
      cmbEntRet.ItemIndex := IDX_ENTREGA  // Entrega
    Else
      cmbEntRet.ItemIndex := IDX_RETIRA; // Retira
  End

  Else If fCfgSis('SUJROM', VarString, fGetEmpConfigEntrega) = 'S' Then
    cmbEntRet.ItemIndex := IDX_ENTREGA  // Entrega
  Else
    cmbEntRet.ItemIndex := IDX_RETIRA; // Retira

  If (blnInserindoCombo Or blnAlterandoCombo Or blnInserindoProdAtivacao Or blnAtualizarPnlDadosItemNaVendaModoTab) Then Begin
    If (fatVenda.objComVen.getEntRet() = 'R') Then
       cmbEntRet.ItemIndex := IDX_RETIRA;

    If (fatVenda.objComVen.getEntRet() = 'E') Then
      cmbEntRet.ItemIndex := IDX_ENTREGA;

    cmbEntRetChange(nil);
  End;

  if (not fAlterandoProduto) And (cdsVenda <> Nil) And (cdsVenda.IsEmpty) then
  begin
    cmbEntRet.ItemIndex := fUtilizaDestinoadastroCliente(cmbEntRet.ItemIndex, edtCodCli.Text, strOpcDoc);
    cmbEntRetChange(nil);
  end;
end;

