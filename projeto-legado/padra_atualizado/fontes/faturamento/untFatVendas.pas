  Result := fFormasEnvioLinkPagamento(LstrCodCnd, LstrMsgOperadorLinkPgt) ;
  if not Result then
  begin
    fMensagem('ATENÇÃO!', ifThen(fEmptyStr(LstrMsgOperadorLinkPgt),'Para usar uma condição de pagamento de link de pagamento é necessário escolher uma forma de envio do Link!', LstrMsgOperadorLinkPgt) , ['&O k']);
    Exit;
  end;

end;

function TfrmFatVendas.fValidaPermiteMultiLojaEmpresa(blnExibeMensagem: Boolean = True): Boolean;
var
  intRecNo: Integer;
  stlEmpDes: TStringList;
  strEmpDes: String;
  strEmpErr: String;
begin
  Result := True;

  If fatVenda.fEstaEmAbastecimentoPorDeposito() Then
    Exit;

  stlEmpDes := TStringList.Create;
  strEmpErr := '';

  intRecNo := cdsVenda.RecNo;
  cdsVenda.DisableControls;

  Try
    cdsVenda.First;
    While (Not cdsVenda.Eof) Do
    Begin
      strEmpDes := cdsVenda.FieldByName('ITE_EMPITE').AsString;

      If (Not fEmptyStr(strEmpDes)) And
         (strEmpDes <> VS_strCodEmp) And
         (stlEmpDes.IndexOf(strEmpDes) < 0) Then
      Begin
        stlEmpDes.Add(strEmpDes);
      End;
      cdsVenda.Next;
    End;

    For strEmpDes In stlEmpDes Do
    Begin
      If (Not fPermiteMultiLojaEmpresa(strEmpDes)) Then
      Begin
        Result := False;

        If (Not blnExibeMensagem) Then
          Break;

        If fEmptyStr(strEmpErr) Then
          strEmpErr := strEmpDes
        Else
          strEmpErr := strEmpErr + ', ' + strEmpDes;
      End;
    End;

    If (blnExibeMensagem) And
       (Not Result) And
       (Not fEmptyStr(strEmpErr)) Then
    Begin
      pMensagemOk('As empresas (' + strEmpErr + ') estão configuradas para não permitir multi-lojas. ' +#10+#13+
                  'Acesse o cadastro de empresas ou peça para o responsável e verifique a aba "Permissão de Tipos de Movimento de Venda".');
    End;
  Finally
    FreeAndNil(stlEmpDes);
    cdsVenda.RecNo := intRecNo;
    cdsVenda.EnableControls;
  End;
end;

function TfrmFatVendas.fValidaPermiteVenderPara(const blnValidaTodosProdutos: Boolean): Boolean;

  function fValida(const strCodItem, strCodCliente, AEmpIte: string): Boolean;
  var
    enuTipoPermissaoVenda: TTipoPermissaoVenda;
    intTipoPessoa: integer;
    strDescricaoItem: string;
    objBuscaItem : IMyCampoTabela;
  const
    intTIPO_PESSOA_JURIDICA = 1;
    intTIPO_PESSOA_FISICA = 2;
    strMENSAGEM = 'É permitido vender o item %s (%s) apenas para clientes Pessoas %s. Verifique!';
  begin
    Result := True;

    If (Pos(strOpcDoc, 'PD_OR_VN_') = 0) then
      exit;

    if strCodItem.IsEmpty then
      exit;

    if strCodCliente.IsEmpty then
      exit;

    if (fCfgSis('PERVDA', varString) = '1') then
    begin
      objBuscaItem := fCadIte(strCodItem);
      enuTipoPermissaoVenda := TTipoPermissaoVenda.get(objBuscaItem.FieldByName('ITE_PERVDA').AsString);
    end
    else
    begin
      objBuscaItem := fIteGer(strCodItem, AEmpIte);
      enuTipoPermissaoVenda := TTipoPermissaoVenda.get(objBuscaItem.FieldByName('ITE_PEVNDA').AsString);
    end;

    if enuTipoPermissaoVenda = TTipoPermissaoVenda.tpvTodos then
      Exit;

    if not (enuTipoPermissaoVenda in  [Low(TTipoPermissaoVenda)..High(TTipoPermissaoVenda)]) then
      Exit;

    intTipoPessoa := StrToIntDef(fCampoTabela('CLI_CGCCPF', 'CADCLI', ['CLI_CODCLI'], [strCodCliente]), 0);

    if not (intTipoPessoa in [intTIPO_PESSOA_JURIDICA, intTIPO_PESSOA_FISICA]) then
      Exit;

    if (enuTipoPermissaoVenda = TTipoPermissaoVenda.tpvPessoasFisicas) and
       (intTipoPessoa <> intTIPO_PESSOA_FISICA) then
    begin
      strDescricaoItem := fCampoTabela('ITE_DESITE', 'CADITE', ['ITE_CODITE'], [strCodItem]);
      fMensagem('ATENÇÃO!',
                Format(strMENSAGEM, [strCodItem, strDescricaoItem, 'Físicas']),
                ['&O k']);
      Exit(False)
    end
    else if (enuTipoPermissaoVenda = TTipoPermissaoVenda.tpvPessoasJuridicas) and
            (intTipoPessoa <> intTIPO_PESSOA_JURIDICA) then
    begin
      strDescricaoItem := fCampoTabela('ITE_DESITE', 'CADITE', ['ITE_CODITE'], [strCodItem]);
      fMensagem('ATENÇÃO!',
                Format(strMENSAGEM, [strCodItem, strDescricaoItem, 'Jurídicas']),
                ['&O k']);
      Exit(False)
    end
    else if (enuTipoPermissaoVenda = TTipoPermissaoVenda.tpvNaoConsumidorFinalRevenda) and
      (fCampoTabela('CLI_CONSUM', 'CADCLI', ['CLI_CODCLI'], [strCodCliente]) <> 'N') then
    begin
      strDescricaoItem := fCampoTabela('ITE_DESITE', 'CADITE', ['ITE_CODITE'], [strCodItem]);
      fMensagem('ATENÇÃO!',
                Format('É permitido vender o item %s (%s) apenas para clientes não consumidor final. Verifique!', [strCodItem, strDescricaoItem]),
                ['&O k']);
      Exit(False)
    end;
  end;
var
  intRecNum: integer;
begin
  if blnValidaTodosProdutos then
  begin
    Result := True;

    if dtsVenda.DataSet.IsEmpty then
      exit;

    intRecNum := dtsVenda.DataSet.RecNo;
    dtsVenda.DataSet.DisableControls;
    try
      dtsVenda.DataSet.First;
      while not dtsVenda.DataSet.Eof do
      begin
        Result := fValida(dtsVenda.DataSet.FieldByName('ITE_CODITE').AsString,
                          edtCodCli.Text,
                          IIF(fatVenda.blnEnt_CD, fatVenda.strEmp_CD, dtsVenda.DataSet.FieldByName('ITE_EMPITE').AsString));
        if not Result then
          Break;

        dtsVenda.DataSet.Next;
      end;
    finally
      dtsVenda.DataSet.RecNo := intRecNum;
      dtsVenda.DataSet.EnableControls;
    end;
  end
  else
  begin
    result := fValida(qryConCit.FieldByName('ITE_CODITE').AsString,
                      edtCodCli.Text,
                      IIF(fatVenda.blnEnt_CD, fatVenda.strEmp_CD, fRetEmpresaItem()));
  end;
end;

