procedure TfrmFatVendas.pLimpaPanel(pnlDadosItem: TPanel);
  Var
    intContador: Integer;
    objCtrl : TControl;
Begin
  For intContador := 0 To pnlDadosItem.ControlCount -1 Do
  Begin
    objCtrl := pnlDadosItem.Controls[intContador];
    If (objCtrl Is TEdit) Then
    Begin
      If (fDeveLimparEdit(TEdit(objCtrl))) Then
        TEdit(objCtrl).Clear;
    End
    Else If (objCtrl Is TLabel) Then
    Begin
      If (TLabel(objCtrl).Tag = 99) Then
        TLabel(objCtrl).Caption := '';
    End
    Else If (objCtrl Is TPanel) Then
      pLimpaPanel(TPanel(objCtrl))
  End;
end;

function TfrmFatVendas.fDeveLimparEdit(const AEdit : TEdit): Boolean;
begin
  Result := True;
  If (Not blnUtilizandoVendeItem) Then
    Exit;
  If (VS_strModoTAB <> '1') Then
    Exit;
  If (fCfgSis('TABPTD', varString) <> 'S') Then
    Exit;
  If (AEdit.Name = 'edtCodIte') Or
     (AEdit.Name = 'edtDesIte') Or
     (AEdit.Name = 'edtQtdIte') Or
     (AEdit.Name = 'edtUnitar') Then
  Begin
    Result := False;
    Exit;
  End;
end;

function TfrmFatVendas.tmrAtualizarImpostosNaConsultaTab: TNewTimer;
begin
  if not TNewTimer.Has(Self.Name + '.tmrAtualizarImpostosNaConsultaTab') then
  begin
    Result := TNewTimer.Get(Self.Name + '.tmrAtualizarImpostosNaConsultaTab');
    Result.Interval := 500;
    Result.Enabled  := False;
    Result.OnTimer  := tmrAtualizarImpostosNaConsultaTabTimer;
  end
  else
    Result := TNewTimer.Get(Self.Name + '.tmrAtualizarImpostosNaConsultaTab');
end;

