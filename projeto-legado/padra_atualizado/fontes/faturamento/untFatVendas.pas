function TfrmFatVendas.fValidaConfiguracoesCRM: Boolean;
var
  strMens: String;
begin
  Result := True;

  If VS_strHabilitarCRM Then
  Begin
    If fEmptyStr(fCfgSis('TOCLCR')) And (Not fCfgSis('LIBPED', varBoolean)) Then
      strMens := '[CFG_TOCLCR] Tipo de Ocorrência - Solicitação de Liberação de Limite de Crédito.' + #13#10;

    If not fEmptyStr(strMens) Then
    Begin
      fMensagem('Informação',strMens + 'Configurações obrigatórias, favor configurar antes de prosseguir !', ['&O K']);
      Result := False;
      Exit;
    End;

    strMens := '';

    If fEmptyStr(fRetNomTipoOcorrencia(fCfgSis('TOCLCR'))) And (Not fCfgSis('LIBPED', varBoolean)) Then
      strMens := '[CFG_TOCLCR] Tipo de Ocorrência - Solicitação de Liberação de Limite de Crédito.' + #13#10;

    If not fEmptyStr(strMens) Then
    Begin
      fMensagem('Informação',strMens + 'Configurações Inválidas, favor configurar antes de prosseguir !', ['&O K']);
      Result := False;
      Exit;
    End;

  End;

end;

procedure TfrmFatVendas.pFinalizarTefCitel;
var
 intCont : Integer;
begin
  pRetornaIncDocTabela(fatVenda.strNumDoc,
                       fatVenda.strEspDoc,
                       fatVenda.strEmpDoc,
                       fatVenda.strCodCli,
                       strIncDoc,
                       strTabela);

  for intCont := 0 to length(arrCartoes) -1 do
  begin
    if fVerificaUtilizouTEFCitel(arrCartoes[intCont].strViaCli, arrCartoes[intCont].strViaLoj) then
    begin
      if arrCartoes[intCont].blnTefCnf then
      begin
        pAtualizaDadosFaturamentoTef(
          strIncDoc,
          strTabela,
          IntToStr(fatVenda.intSeqCon),
          arrCartoes[intCont].strViaCli,
          arrCartoes[intCont].strViaLoj,
          arrCartoes[intCont].strNumDoc,
          arrCartoes[intCont].strDtaTra);
      end
      else
      begin
        if fFinalizaCartao(arrCartoes[intCont].strNumDoc,
                           arrCartoes[intCont].strDtaTra,
                           arrCartoes[intCont].strHraTra,
                           arrCartoes[intCont].strViaCli,
                           arrCartoes[intCont].strViaLoj,
                           arrCartoes[intCont].strNumNsu,
                           strIncDoc,
                           strTabela,
                           arrCartoes[intCont].fltValDig,
                           arrCartoes[intCont].strViaCli +#13+ arrCartoes[intCont].strViaLoj,
                           IntToStr(fatVenda.intSeqCon),
                           arrCartoes[intCont].strControle) then
        begin
          arrCartoes[intCont].strStatusCartao := 'F';
        end;
      end;
    end;
  end;
end;

function TfrmFatVendas.fGaranteCancelamentoTefCitel(AarrCartoes : TCartoesResumoCaixaArray) : Boolean;
var
  intContCartao : Integer;
begin
  Result := False;
  for intContCartao := 0 to  Length(AarrCartoes) - 1 do
  begin
    if fVerificaUtilizouTEFCitel(AarrCartoes[intContCartao].strViaCli, AarrCartoes[intContCartao].strViaLoj) then
    begin
      if AarrCartoes[intContCartao].strStatusCartao = 'P' then
      begin
        pEstornaTransacaoPendente(False,
                                  AarrCartoes[intContCartao].strDtaTra,
                                  AarrCartoes[intContCartao].strHraTra,
                                  AarrCartoes[intContCartao].strNumDoc,
                                  '');

        AarrCartoes[intContCartao].strStatusCartao := 'C';

        pGravaTransacaoEstornada(AarrCartoes[intContCartao].strNumDoc,
                                 AarrCartoes[intContCartao].strNumNsu,
                                 AarrCartoes[intContCartao].strDtaTra,
                                 AarrCartoes[intContCartao].strHraTra,
                                 '',
                                 '',
                                 AarrCartoes[intContCartao].fltValDig,
                                 AarrCartoes[intContCartao].strControle);

        Result := True;
      end
      else if fAutoConfirmaTransacaoPendenteEstaAtivada and
        (AarrCartoes[intContCartao].strStatusCartao = 'F') then
      begin
        if fCancelaTransacaoEfetivada(
          fAjustaIdentificadorEstornoTef(AarrCartoes[intContCartao]),
          AarrCartoes[intContCartao].fltValDig,
          AarrCartoes[intContCartao].strDtaTra,
          AarrCartoes[intContCartao].strCodigoCarteiraDigital,
          AarrCartoes[intContCartao].strCodigoTipoOperacaoCartao,
          AarrCartoes[intContCartao].strCodigoBandeira) then
        begin
          AarrCartoes[intContCartao].strStatusCartao := 'C';
        end;
        Result := True;
      end;
    end;
  end;
end;

