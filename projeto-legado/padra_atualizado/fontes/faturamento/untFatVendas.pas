procedure TfrmFatVendas.cmbMotEntFutChange(Sender: TObject);
begin
  inherited;

  mskDtaEnt.Enabled := cmbMotEntFut.ItemIndex In [IDX_MOTIVO_FALTA_PRODUTO, IDX_MOTIVO_PREVISAO_ENTREGA];
  edtDiaEnt.Enabled := mskDtaEnt.Enabled;
  edtDiaEnt.Text := '0';

  blnJaAvisouEntFut := False;

  //Nao deve alterar a data automaticamente quando estiver alterando um registro
  If (fAlterandoProduto) And
     (strToDateDef(mskDtaEnt.Text, 0) > 0) And
     (ActiveControl <> cmbEntRet) And
     (ActiveControl <> cmbTipEnt) And
     (ActiveControl <> cmbMotEntFut) Then
    Exit;

  With qryConCit Do
  Case cmbMotEntFut.ItemIndex Of
    0: mskDtaEnt.Text := DateToStr(VS_DATE + StrToInt(edtDiaEnt.Text) +
                                      IIF(Active And (Not IsEmpty),
                                      qryConCit.FieldByName('ITE_DIAFOR').AsInteger, 0));

    1: mskDtaEnt.Text := '31/12/9999';

    2: If Assigned(fatVenda.objConEnt) Then
       Begin

         If fatVenda.dtaDtEntr < VS_DATE Then
           mskDtaEnt.Text := DateToStr(VS_DATE + StrToInt(edtDiaEnt.Text))
         Else
           mskDtaEnt.Text := DateToStr(fatVenda.dtaDtEntr);

       End

       Else mskDtaEnt.Text := DateToStr(VS_DATE + StrToInt(edtDiaEnt.Text));
  End;

  pCalculaPromocaoEntFut(True);

  pSugerirDataEntregaFuturaPrevisao();

end;

