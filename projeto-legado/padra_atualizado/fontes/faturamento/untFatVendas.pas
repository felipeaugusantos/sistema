function TfrmFatVendas.fQtdDestinoItens: Integer;
  Var
    prcScroll: TprcScroll;
    stlDestino: TStringList;
    strDestino: String;
begin
  stlDestino := TStringList.Create;
  pDisableControls(cdsVenda, prcScroll);
  Try
    With cdsVenda Do
    Begin
      First;
      While Not Eof Do
      Begin
        strDestino := cdsVenda.FieldByName('ITE_ENTRET').AsString +
                      cdsVenda.FieldByName('ITE_ENTFUT').AsString +
                      cdsVenda.FieldByName('ITE_LOCRET').AsString;
        If stlDestino.IndexOf(strDestino) = -1 Then
          stlDestino.Add(strDestino);
        Next;
      End;
    End;

    Result := stlDestino.Count;
  Finally
    stlDestino.Free;
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

