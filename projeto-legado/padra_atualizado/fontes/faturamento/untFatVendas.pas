function TfrmFatVendas.fExibeOpcaoRecABaseDeTroca(strCodIte: String): Boolean;
begin
  Result := False;

  If (Pos(strOpcDoc, 'PD') <= 0) Then
    Exit;

  If (Not fatVenda.fProdutoDeVendaABaseDeTroca(strCodIte)) Then
    Exit;

  Result := True;
end;

function TfrmFatVendas.fEmissaoNFVendaABaseDeTroca: Boolean;
begin
  Result := False;

  If (strOpcDoc <> 'NE') Then
    Exit;

  If (Not fCfgSis('USAVBT', varBoolean)) Then
    Exit;

  If (Not fFornecedorSelecionadoEhFornecedorFilialEmpLogada(edtCodCli.Text)) Then
    Exit;

  Result := True;
end;

procedure TfrmFatVendas.pHerancaRecebimentosABaseDeTroca;
begin
  If (Not fValidaEmissaoAtual) Then
    Exit;

  TfrmGravando.fExecutarModal(pCarregaItensDeRecebimentoABaseDeTroca, 'Aguarde, Carregando itens...', '');

  pCalculaTotais;
  pCalculaTotGer;
  pAtualizarEditsTotais;
end;

function TfrmFatVendas.fValidaEmissaoAtual: Boolean;
begin
  Result := False;

  If (fatVenda.blnComVal) Then
  Begin
    pMensagemOk('Opção não permitida, pois já foi escolhida anteriormente a '+
                'opção de herança para complemento de valores' + #13#10 +
                'Favor cancelar todo o processo e iniciar novamente.');
    Exit;
  End;

  Result := True;
end;

procedure TfrmFatVendas.pPreencheDatasEscolhidas(Var dteInicial: TDate; Var dteFinal: TDate);
  Var
    frmFatDigDatas: TfrmFatDigDatas;
begin
  pCriarFormularios(TfrmFatDigDatas, frmFatDigDatas);

  Try
    Try
      frmFatDigDatas.mskDtaIni.Text := DateToStr(VS_Date);
      frmFatDigDatas.mskDtaFin.Text := DateToStr(VS_Date);
      frmFatDigDatas.blnFatVenda := False;
      frmFatDigDatas.lblInformacao.Visible := False;
      frmFatDigDatas.ShowModal;

      If (frmFatDigDatas.blnConfirma) Then
      Begin
        dteInicial := StrToDate(frmFatDigDatas.mskDtaIni.Text);
        dteFinal := StrToDate(frmFatDigDatas.mskDtaFin.Text);
      End;
    Finally
      pFreeAndNil(frmFatDigDatas);
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;
end;

procedure TfrmFatVendas.pCarregaItensDeRecebimentoABaseDeTroca;
  Var
    qryTabela: TUniQuery;
    dteInicial,
    dteFinal: TDate;
begin
  qryTabela := fCriaQuery;
  dteInicial := 0;
  dteFinal := 0;

  Try
    pPreencheDatasEscolhidas(dteInicial, dteFinal);

    If (dteInicial <= 0) Or (dteFinal <= 0) Then
      Exit;

    fatVenda.pBuscaItensDeRecebimentoABaseDeTroca(qryTabela, dteInicial, dteFinal);

    If (qryTabela.IsEmpty) Then
    Begin
      pMensagemOk('Não foi encontrado nenhum item de recebimento a base de troca');
      Exit;
    End;

    fatVenda.blnNotEspVBT := True;
    pIncluirItensDeRecebimentoVBT(qryTabela);
  Finally
    FreeAndNil(qryTabela);
  End;
end;

procedure TfrmFatVendas.pCarregaItensDevolucaoDocNaoEntRomaneio;
begin
  fatVenda.blnDevolucaoEmpresaAbastecimento := fDevolveDocumentoParaEmpresaAbastecimento(strNumDocDev, strEspDocDev, strEmpDocDev, edtCodCli.Text);

  fatVenda.pCarregaItensDevolucao(strCodCliDef, '', strNumDocDev, strEspDocDev, '', strEmpDocDev,
                           StrToDateDef(strDtaDocDev, 0), StrToDateDef(strDtaDocDev, 0), fatVenda.strCodAde, nil) ;


  if (not fatVenda.qryTemporaria.IsEmpty) then
  begin
    blnDesativaConfirmaDadosCabecalho := True;
    edtCodCli.ReadOnly := True;
    edtSenVen.ReadOnly := fCfgSis('USADIG', varBoolean);
    Exit;
  end;

  fMensagem('ATENÇÃO!', 'Não foi possível carregar o documento para devolução!', ['&O k']);
  fatVenda.blnFecharForm := True;
  Self.FormPaint(Self);
end;

procedure TfrmFatVendas.pIncluirItensDeRecebimentoVBT(qryDados: TUniQuery);
begin
  qryDados.First;

  If (Not cdsVenda.IsEmpty) Then
    cdsVenda.EmptyDataSet;

  While (Not qryDados.Eof) Do
  Begin
    pIncluirItem(qryDados.FieldByName('DET_CODITE').AsString,
                 fRetNomProduto(qryDados.FieldByName('DET_CODITE').AsString),
                 qryDados.FieldByName('DET_QTDITE').AsFloat,
                 qryDados.FieldByName('DET_UNITAR').AsFloat);
    qryDados.Next;
  End;
end;

function TfrmFatVendas.fItemSelecionadoTemAbastecimentoEmAndamento():Boolean;
begin
  Result := False;

  If cdsVenda.IsEmpty Then
    Exit;

  If fEmptyStr(cdsVenda.FieldByName('ITE_EMPSOL').AsString) Then
    Exit;

  If (cdsVenda.FieldByName('ITE_EMPSOL').AsString = VS_strCodEmp) Then
    Exit;

  Result := True;
end;

function TfrmFatVendas.fValidaDireitoDeAcessoQMDPEI: Boolean;
begin
  Result := True;

  If (Not fatVenda.fDataLibQMDPEI(strToDateDef(mskDtaEnt.Text, 0))) And (Not blnLibQMDPEI) Then
  begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('A data de entrega imediata deve ser maior ou igual a ' + DateToStr(VS_Date + fCfgSis('QMDPEI', varInteger, fGetEmpConfigEntrega)) + '.');
    objLiberacao.objMsgLibera.pAddTexto('Data entrega informada: ' + mskDtaEnt.Text);
    objLiberacao.objMsgLibera.pAddTexto('');
    objLiberacao.objMsgLibera.pAddTexto('Informe a senha para permitir data de entrega imediata inferior aos dias definidos na configuração');
    objLiberacao.objMsgLibera.pAddTexto('"CFG_QMDPEI - Quantidade mínima de dias para Entrega Imediata".');
    objLiberacao.objMsgLibera.pAddTexto('');

    objLiberacao.strDirAce := 'QMDPEI';
    objLiberacao.strMsgSen := 'A data de entrega imediata deve ser maior ou igual a ' + DateToStr(VS_Date + fCfgSis('QMDPEI', varInteger, fGetEmpConfigEntrega)) + '.';
    objLiberacao.strCodOpe := fatVenda.strCodVen;
    objLiberacao.strCodDig := fatVenda.strCodDig;
    objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliOri;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
    blnLibQMDPEI := Result;
  End;
end;

function TfrmFatVendas.fDataEntregaInferiorAoPermitido: Boolean;
  Var
    intQMDPEI: Integer;
begin
  intQMDPEI := fCfgSis('QMDPEI', varInteger, fGetEmpConfigEntrega);
  Result := (strToDateDef(mskDtaEnt.Text, 0)) < (VS_Date + intQMDPEI);
end;

function TfrmFatVendas.fValidacoesIniciais: Boolean;
begin
  Result := True;
  If (fCfgSis('DESCFF', varString) = 'S') And (strOpcDoc = 'CF') And (blnBotaoFechamentoComDescontoPressionado) Then
    Result := fValidaPodeUsarDescontoEspecial;
end;

function TfrmFatVendas.fConfirmacaoDocumentoComDescontoProfissional: Boolean;
begin
  Result := ((strOpcDoc = 'CF') And (fatVenda.fltDescProfissional > 0));
end;

procedure TfrmFatVendas.pAtualizaSaldoDisponivelTotalEmpresaPrioridade;
  Var
    fltEstoqueTotal : Double;
begin
  edtSaldoDispTotal.Text := '0,00';
  If (Pos(strOpcDoc, 'PD_OR_') > 0) And (fUtilizaEmpresaPrioridade) Then
  Begin
    fValidaEstoqueEmpresaPrioridade(False, fltEstoqueTotal);
    pnlSaldoEmpresasPrioridade.Visible := True;
    edtSaldoDispTotal.Text := FormatFloat(edtQtdIte.EditFormat, fltEstoqueTotal);
    Exit;
  End;
  pnlSaldoEmpresasPrioridade.Visible := False;
end;

function TfrmFatVendas.fGetWidthVendeItemTAB : Integer;
begin
  Result := 1121;
  If (Pos(strOpcDoc, 'PD_OR_') > 0) And (fUtilizaEmpresaPrioridade) Then
    Result := Result + pnlSaldoEmpresasPrioridade.Width;
end;

function TfrmFatVendas.fValidaPermissaoEmitirCupom: Boolean;
begin
  Result := True;

  If (fatVenda.fObrigaCpfClientePedidoTipoFaturamentoCupom) And
     (MatchStr(fatVenda.strTipPed,['C'])) Then
