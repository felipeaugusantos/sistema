  edtTotIS.Visible := (Pos(strOpcDoc, 'PD_OR_VN_DV_OF_CF_TE_CP_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtTotIS.Enabled := edtTotIS.Visible;

  pAlinharTotaisImpostos;

  lblUnitComImpostos.Visible := (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtUnitComImpostos.Visible := (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;

  lblVrTotCImpostos.Visible := (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;
  edtVrTotCImpostos.Visible := (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And blnSomarNovosImpostosDaReformaAoValorContabil;

  lblUniLiq.Visible := (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And (fAplicarTaxaJurosPrecoDigitado Or fUtilizaUnitarioLiquido);
  edtUniLiq.Visible := (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And (fAplicarTaxaJurosPrecoDigitado Or fUtilizaUnitarioLiquido);
  lblVerStt.Visible := False;
  edtVerStt.Visible := False;

  {******************************************}
  {* SE CONFIGURADO PARA MOSTRAR VALOR DO   *}
  {* IPI NA TELA, EXIBE CAMPOS              *}
  {***************************************MA*}
