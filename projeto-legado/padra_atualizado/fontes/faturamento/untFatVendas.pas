function TfrmFatVendas.fTravaLoteADefinir(strOpcDoc, strCodIte,
  strNumLot: String): Boolean;
begin
  Result := False;

  if Pos(strOpcDoc, 'PD_OR_') <= 0 then
    Exit;

  if not fCfgSis('WMSLOT', varBoolean) then
    Exit;

  if strNumLot <> 'A DEFINIR' then
    Exit;

  if fCampoTabela('ITE_LOTEPD', 'CADITE', ['ITE_CODITE'], [strCodIte], False) <> 'S' then
    Exit;

  if fVerificaAcessoSistema('PILDEF') then
    Exit;

  objLiberacao.Clear;
  objLiberacao.objMsgLibera.pAddTexto('Permitir Lote A DEFINIR no Oraçamento/Pedido.');

  objLiberacao.strDirAce := 'PILDEF';
  objLiberacao.strMsgSen := 'Permitir Lote A DEFINIR no Oraçamento/Pedido.';
  objLiberacao.strCodOpe := fatVenda.strCodVen;
  objLiberacao.strCodDig := fatVenda.strCodDig;
  objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
  objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

  Result := Not fatVenda.fFatMensagemLiberacao(objLiberacao);
end;

