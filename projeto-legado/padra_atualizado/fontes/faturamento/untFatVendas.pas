function TfrmFatVendas.fEhItemMetragemComEmbalagemFechadaComDesconto():Boolean;
begin
  Result := False;

  If (Not blnMetragemObrigatoria) Then
    Exit;

  If (Not fTemQuantEmbalagemFechada(edtCodIte.Text)) Then
    Exit;

  If (Not fCalcularDescontoEmbFechada()) Then
