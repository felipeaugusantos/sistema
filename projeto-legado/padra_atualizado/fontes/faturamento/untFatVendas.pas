  Result := True;
  If (Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc, 'OR_PD_') > 0) Then
  Begin
    If fEmptyStr(fatVenda.strCliCep) Or (Length(fatVenda.strCliCep) < 8) Then
