  If (inherited fValidaCampos(Sender, blnBuscaPorChave)) Then
  Begin

    If (Sender = edtDesIte) And fEmptyStr(edtDesIte.Text) And Not(fEmptyStr(edtCodIte.Text)) Then
    Begin
      fMensagem('ATENÇÃO!', 'A descrição do item deve ser preenchida!', ['&Ok']);
      Result := False;
    End;

    If (Sender = rdgTipEmp) And (strOpcDoc = 'EP') Then
    Begin
    End;

    {Req.: 123285}
    If (Sender = edtOprFlj) And (edtOprFlj.Visible) And (Not fEmptyStr(fatVenda.strEmp_TE)) And (VS_strCodEmp <> fatVenda.strEmp_TE) Then
    Begin
      If Pos(edtOprFlj.Text, 'S') > 0 Then
      Begin
        edtOprFlj.Text := 'N';
        fMensagem('','Não é permitido informar "Produção Fora de Loja" pois foi informado transferência de estoque!', ['&Ok']);
        Result := False;
      End;
    End;


    {***************************************}
    {* VALIDA A TABELA DE PRECOS           *}
    {************************************LU*}
    If (Sender = cbTabPreco) And (cbTabPreco.Text <> fatVenda.strTabPre) And (fEmptyStr(strTabPreEmb)) Then
    Begin
      If (cbTabPreco.Visible) Then
      Begin
        If fEmptyStr(cbTabPreco.Text) Then
        Begin
          fMensagem('ATENÇÃO!', 'Escolha uma Tabela de Preços!', ['&O k']);
          Result := False;
        End
        Else If (fSistemaUsaEssaTabelaPreco(cbTabPreco.Text) = False) Then
        Begin
          fMensagem('ATENÇÃO!', 'Sistema não está configurado para utilizar a tabela de preço: '+cbTabPreco.Text+'. Verifique a configuração "CFG_TABPRC - '+fRetNomCfg('TABPRC')+'"', ['&O k']);
          Result := False;
        End
        Else If (fFaturamentoUsaEssaTabelaPreco(cbTabPreco.Text) = False) Then
        Begin
          fMensagem('ATENÇÃO!', 'Sistema não está configurado para utilizar a tabela de preço no faturamento: '+cbTabPreco.Text+'. Verifique a configuração "CFG_TABVEN - '+fRetNomCfg('TABVEN')+'"', ['&O k']);
          Result := False;
        End
        Else If (Not fValidouTabelaPrecoConsulta(cbTabPreco.Text)) Then
        Begin
          fMensagem('ATENÇÃO!', 'Tabela de preço escolhida não é válida!', ['&OK']);
          Result := False;
        End
        Else
        Begin
          strTabPrecoFat := fDevolveTabelaPrecoFaturamento(qryConCnd.FieldbyName('CND_PRETAB').AsString);
          If Pos(cbTabPreco.Text, '1234567') <= 0 Then
          Begin
            fMensagem('ATENÇÃO!', 'Tabela de Preços incorreta!', ['&O k']);
            Result := False;
          End

          Else If blnAtualizaTabPreCnd And
                 (Not fEmptyStr(Trim(StringReplace(qryConCnd.FieldbyName('CND_PRETAB').AsString,'N','',[rfReplaceAll, rfIgnoreCase])))) And
                 (Pos(cbTabPreco.Text, strTabPrecoFat) <= 0) Then
          Begin

            strSnTrTb := fCfgSis('TABCND');
            objLiberacao.Clear;
            objLiberacao.objMsgLibera.pAddTexto('Troca de tabela de preço da Condição de Pagamento.');
            objLiberacao.objMsgLibera.pAddSeparador(65);
            objLiberacao.objMsgLibera.pAddTextoCaption('Condição de pagamento', edtCodCnd.Text + ' - ' + mskCndPag.Text, 30);
            objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'              , edtCodCli.Text + ' - ' + edtNomCli.Text, 30);
            objLiberacao.objMsgLibera.pAddTextoCaption('Tabela de Preço do Cadastro' , qryConCnd.FieldbyName('CND_TABPRE').AsString, 30);
            objLiberacao.objMsgLibera.pAddTextoCaption('Tabela de Preço Alterada' , cbTabPreco.Text, 30);

            objLiberacao.strDirAce := 'TABCND';
            objLiberacao.strSenLib := strSnTrTb;
            objLiberacao.strMsgSen := 'Troca de Tabela de Preço';
            objLiberacao.strCodOpe := fatVenda.strCodVen;
            objLiberacao.strCodDig := fatVenda.strCodDig;
            objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

            Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

            If Result Then
            Begin
              fatVenda.strTabPre := cbTabPreco.Text;
              pRecalculaPrecos(False, True);
              pCalculaTotais;
              blnMudouTabelaPreco := True;
            End Else
            Begin
              Result := False;
            End;

          End

          Else If (fPermitidoSomenteRegredirTabelaDePreco) And (fOperadorProgrediuTabelaDePreco) Then
          Begin
            fMensagem('ATENÇÃO!', fRetMensagemTravaProgressaoTabelaDePreco, ['&Ok']);
            Result := False;
          End

          Else If ((Not fEmptyStr(fCfgSis('TABCLI')))                     And
                  (cbTabPreco.Text <> fTabelaPrecoClienteOuVendedor) And
                  (fCfgSis('TBPSUG') = '0'))                              Or
                  (strTabPreSenha[strToInt(cbTabPreco.Text)] = 'S')                 Then
          Begin
            fatVenda.blnTeveTravaTrocaTabelaPrecoGeral := True;
            pRemoverTravaLogAvi('TABCLI', fatVenda.strNTrava);

            strSnTrTb := fCfgSis('TABCLI');
            objLiberacao.Clear;
            objLiberacao.objMsgLibera.pAddTexto('Troca de tabela de preço do ' + fDescricaoClienteOuVendedorTabelaPreco + '.');

            objLiberacao.strDirAce := 'TABCLI';
            objLiberacao.strSenLib := strSnTrTb;
            objLiberacao.strMsgSen := 'Troca de Tabela de Preço';
            objLiberacao.strCodOpe := fatVenda.strCodVen;
            objLiberacao.strCodDig := fatVenda.strCodDig;
            objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
            objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

            pMontaCabecalhoMsgTabPreco;
            If fGridVendaVazio Then
            Begin
              objLinha := TLinhaMsgLibera.Create;
              objLinha.enuTipoLinha := tlValor;
              objLinha.pAddColuna('Código'      , ''                           , 06, alCentro,   teAmbos);
              objLinha.pAddColuna('Descrição'   , 'INICIANDO UM NOVO DOCUMENTO', 42, alEsquerda, teAmbos);
              objLinha.pAddColuna('UN'          , ''                           , 03, alCentro,   teAmbos);
              objLinha.pAddColuna('Tab. Atual'  , fatVenda.strTabPre           , 11, alCentro,   teAmbos);
              objLinha.pAddColuna('Pr.Tab.Atual', ''                           , 12, alDireita,  teAmbos);
              objLinha.pAddColuna('Nova Tabela' , cbTabPreco.Text              , 11, alCentro,   teAmbos);
              objLinha.pAddColuna('Pr.Tab.Nova' , ''                           , 12, alDireita,  teAmbos);
              objTabela.lstLinhas.Add(objLinha);

              strTabAntTra := fatVenda.strTabPre;
              fltPreAntTra := 0;
            End
            Else
            Begin
              pMontaMsgTabPreco(cbTabPreco.Text);
            End;
            objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

            pRecalculaPrecoParaTrava(fatVenda.strTabPre, cbTabPreco.Text);

            Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

            If Result Then
            Begin
              fatVenda.strTabPre := cbTabPreco.Text;
              pRecalculaPrecos(False, True);
              pCalculaTotais;
            End Else
            Begin
              Result := False;
            End;

          End

          Else If Pos(cbTabPreco.Text, IIF(blnAtualizaTabPreCnd,strTabPrecoFat, strTabPre)) <= 0 Then
          Begin
            pRemoverTravaLogAvi('TROTAB', fatVenda.strNTrava);

            strSnTrTb := fCfgSis('SNTRTB');
            If (Not fEmptyStr(strSnTrTb)) Then
            Begin
              If (cbTabPreco.Text <> fatVenda.strTabPre)           Or
                 (strTabPreSenha[strToInt(cbTabPreco.Text)] = 'S') Then
              Begin

                objLiberacao.Clear;

                objLiberacao.objMsgLibera.pAddTexto('Troca de tabela de preço.');

                objLiberacao.strDirAce := 'TROTAB';
                objLiberacao.strSenLib := strSnTrTb;
                objLiberacao.strMsgSen := 'Troca de Tabela de Preço';
                objLiberacao.strCodOpe := fatVenda.strCodVen;
                objLiberacao.strCodDig := fatVenda.strCodDig;
                objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
                objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

                Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

                If (cbTabPrecoItem.Visible) And (Result) Then
                Begin
                  If (cbTabPrecoItem.Items.IndexOf(cbTabPreco.Text) < 0) Then
                    cbTabPrecoItem.Items.Add(cbTabPreco.Text);
                End;
              End;

              If Result Then
              Begin
                fatVenda.strTabPre := cbTabPreco.Text;
                pRecalculaPrecos(False, True);
                pCalculaTotais;
              End;
            End
            Else
            Begin
              fMensagem('ATENÇÃO!', 'Tabela de Preços incorreta!', ['&O k']);
              Result := False;
            End;

          End
          Else
          Begin
            pRemoverTravaLogAvi('TABCLI', fatVenda.strNTrava);
            pRemoverTravaLogAvi('TROTAB', fatVenda.strNTrava);

            fatVenda.blnTeveTravaTrocaTabelaPrecoGeral := False;
            fatVenda.blnTeveTravaTrocaTabelaPrecoItens := False;

            If cbTabPreco.Text <> fatVenda.strTabPre Then
            Begin
              fatVenda.strTabPre := cbTabPreco.Text;
              pRecalculaPrecos(False, True);
              pCalculaTotais;
            End;
          End;
        End;
      End;

      If Result And blnValidouTabPreCliMasNaoLiberouSenha Then
      Begin
        If strMultiTabPreAnt <> strMultiTabPreAtu Then
        Begin
          strMultiTabPreAnt := strMultiTabPreAtu;
          strTabPre := strMultiTabPreAnt;
          fatVenda.pCalculaTaxVpr;
          pRecalculaPrecos(False, True, False, True, '', False, False, False, Self.blnManterPrecoDigitado);
          pCalculaTotais;
        End;
      End;
    End;

    blnValidouTabPreCliMasNaoLiberouSenha := (Sender = cbTabPreco) And
                                             (cbTabPreco.Text <> fatVenda.strTabPre) And
                                             (fEmptyStr(strTabPreEmb)) And
                                             (Not Result) And
                                             (Length(strTabPrecoFat) = 1);

    {***************************************}
    {* VALIDA A TABELA DE PRECOS DO ITEM   *}
    {************************************LU*}
    If (cbTabPrecoItem.Visible) And (Sender = cbTabPrecoItem) Then
    Begin
      If (fEmptyStr(fTabelaDePrecoDosItens)) And (blnBuscaPorChave) Then
      Begin
        FatVenda.pMostraMensagem('ATENÇÃO!', 'Escolha uma Tabela de Preços!', edtCodIte.Text);
        Result := False;
      End
      Else If (fSistemaUsaEssaTabelaPreco(fTabelaDePrecoDosItens) = False) And Not fEmptyStr(fTabelaDePrecoDosItens) Then
      Begin
        FatVenda.pMostraMensagem('ATENÇÃO!', 'Sistema não está configurado para utilizar a tabela de preço: '+fTabelaDePrecoDosItens+'. Verifique a configuração "CFG_TABPRC - '+fRetNomCfg('TABPRC')+'"', edtCodIte.Text);
        Result := False;
      End
      Else If (fFaturamentoUsaEssaTabelaPreco(fTabelaDePrecoDosItens) = False) And Not fEmptyStr(fTabelaDePrecoDosItens) Then
      Begin
        FatVenda.pMostraMensagem('ATENÇÃO!', 'Sistema não está configurado para utilizar a tabela de preço no faturamento: '+fTabelaDePrecoDosItens+'. Verifique a configuração "CFG_TABVEN - '+fRetNomCfg('TABVEN')+'"', edtCodIte.Text);
        Result := False;
      End
      Else
      If (blnBuscaPorChave) And
         (fUsaTabelaPrecoItemPorRetiraEntrega) And
         (fTabelaPrecoRetiraEntregaAlterada) And
         (blnEvocouOnChangeCbTabPrecoItem Or
         ((strTabPreIteAnt <> cbTabPrecoItem.Text) And
         (fEmptyStr(strTabPreEmb) Or SameText(strTabPreEmb, 'F')) And
         (Not blnInserindoCombo))) Then
      Begin

        strSnTrTb := fCfgSis('SNTBIT');

        If fEmptyStr(strSnTrTb) Then
        Begin
          pAtualizaTabPreRetiraEntrega;
          Result := False;
        End
        Else
        Begin

          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Troca de tabela de preço (Retira/Entrega) do Item ');

          objLiberacao.strDirAce := 'TABPREITE';
          objLiberacao.strSenLib := strSnTrTb;
          objLiberacao.strMsgSen := 'Troca de Tabela de Preço do Item';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          pMontaCabecalhoMsgTabPreco;
          If (fAlterandoProduto) Then
            pMontaMsgTabPreco(fTabelaDePrecoDosItens, btnAdicionar.Tag)
          Else  
            pMontaMsgTabPreco(fTabelaDePrecoDosItens, btnAdicionar.Tag, qryConIte, strTabPreIteAoEntrarCombo);
          objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

          If Result Then
            strTabPreIteAoEntrarCombo := fTabelaDePrecoDosItens;

          //If Result Then            strTabPreIteAnt := cbTabPrecoItem.Text;
        End;
      End;

      If (Result) And (fEmptyStr(strTabPreItePrincipalAnt)) Then
        strTabPreItePrincipalAnt := cbTabPrecoItem.Text;
      blnAplicaJurosCondicao := True;

      If Result And
        (blnBuscaPorChave) And
        (blnEvocouOnChangeCbTabPrecoItem Or
        ((strTabPreIteAnt <> cbTabPrecoItem.Text) And
         (fEmptyStr(strTabPreEmb) Or SameText(strTabPreEmb, 'F')) And
         (Not blnInserindoCombo))) Then
      Begin
        strTabPrecoFat := fDevolveTabelaPrecoFaturamento(qryConCnd.FieldbyName('CND_PRETAB').AsString);
        If Pos(fTabelaDePrecoDosItens, '1_2_3_4_5_6_7_') <= 0 Then
        Begin
          fMensagem('ATENÇÃO!', 'Tabela de Preços incorreta!', ['&O k']);
          Result := False;
        End

        Else If blnAtualizaTabPreCnd And
               (Not fEmptyStr(Trim(StringReplace(qryConCnd.FieldbyName('CND_PRETAB').AsString,'N','',[rfReplaceAll, rfIgnoreCase])))) And
               (Pos(fTabelaDePrecoDosItens, strTabPrecoFat) <= 0) Then
        Begin

          strSnTrTb := fCfgSis('TABCND');

          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Troca de tabela de preço da Condição de Pagamento.');
          objLiberacao.objMsgLibera.pAddSeparador(65);
          objLiberacao.objMsgLibera.pAddTextoCaption('Condição de pagamento', edtCodCnd.Text + ' - ' + mskCndPag.Text, 30);
          objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'              , edtCodCli.Text + ' - ' + edtNomCli.Text, 30);
          objLiberacao.objMsgLibera.pAddTextoCaption('Tabela de Preço do Cadastro' , qryConCnd.FieldbyName('CND_TABPRE').AsString, 30);
          objLiberacao.objMsgLibera.pAddTextoCaption('Tabela de Preço Alterada' , cbTabPreco.Text, 30);

          objLiberacao.strDirAce := 'TABCND';
          objLiberacao.strSenLib := strSnTrTb;
          objLiberacao.strMsgSen := 'Troca de Tabela de Preço';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);

        End;

        If Result And
           ((Not fEmptyStr(fCfgSis('TABCLI'))) And
           (fTabelaDePrecoDosItens <> fTabelaPrecoClienteOuVendedor) And
                (fCfgSis('TBPSUG') = '0')) Or
                ((fTabelaDePrecoDosItens <> fatVenda.strTabPre) And (strTabPreSenha[strToInt(fTabelaDePrecoDosItens)] = 'S')) Then
        Begin
          fatVenda.blnTeveTravaTrocaTabelaPrecoItens := True;
          strSnTrTb := fCfgSis('TABCLI');
          blnTraIte := True;

          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Troca de tabela de preço do Item.');

          objLiberacao.strDirAce := 'TABCLI';
          objLiberacao.strSenLib := strSnTrTb;
          objLiberacao.strMsgSen := 'Troca de Tabela de Preço';
          objLiberacao.strCodOpe := fatVenda.strCodVen;
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          pMontaCabecalhoMsgTabPreco;
          If (fAlterandoProduto) Then
            pMontaMsgTabPreco(fTabelaDePrecoDosItens, btnAdicionar.Tag)
          Else  
            pMontaMsgTabPreco(fTabelaDePrecoDosItens, btnAdicionar.Tag, qryConIte, fatVenda.strTabPre);
          objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

          Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
        End;

        blnTemEmbFec := False;

        If Result Then
        Begin

          If (fatVenda.strIdePro = 'NOR') Then
          Begin
            pAtualizaQryConIte;
            strTabPreIteAnt := strTabPreItePrincipalAnt;

            If (fatVenda.stlItensNaoEhEstrutura.IndexOf(edtCodIte.Text) = -1) And
               (Not fItemEstrutura(edtCodIte.Text)) Then
            Begin
              fatVenda.stlItensNaoEhEstrutura.Add(edtCodIte.Text);
            End;

            If (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) And
               (Not fTemQuantEmbalagemFechada(edtCodIte.Text)) Then
            Begin
              fatVenda.stlItensNaoTemQtdeEmbFec.Add(edtCodIte.Text);
            End;

            fatVenda.strPromoc := 'N';

            If (fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(edtCodIte.Text, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) And (fRetornaPrecoPromocaoPelaTabIte(fEhPromocaoTabIte)) Then
            Begin
              If (fRetornaPrecosPromocao(edtCodIte.Text,
                                         edtCodCli.Text,
                                         VS_Date,
                                         IIF(fStrToFloat(edtQtdIte.Text) > 0, fStrToFloat(edtQtdIte.Text), 1),

                                         fatVenda.fRetQtdDigitada(edtCodIte.Text, '', IntToStr(btnAdicionar.Tag), '', '', fRetEmpresaItem, False),

                                         fatVenda.fRetQtdDigitada(edtCodIte.Text, '', IntToStr(btnAdicionar.Tag), '', '', fRetEmpresaItem, False,
                                                                  False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior, True {Somente em promocao}),

                                         fatVenda.intPrzMed,
                                         fatVenda.fltProPreCus,
                                         fatVenda.fltProPreVen,
                                         fatVenda.fltProComVar,
                                         fatVenda.fltProComAta,
                                         fatVenda.fltProComDis,
                                         fltQtdDis,
                                         fatVenda.fltProDesF07,
                                         fatVenda.strComPro,
                                         fatVenda.strCodPro,
                                         blnParticiona,
                                         blnPromo,
                                         fTabelaDePrecoDosItens,
                                         fatVenda.strCodCnd,
                                         '',
                                         '',
                                         True,
                                         False,
                                         '-1',
                                         (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA),
                                         (cmbEntRet.ItemIndex = IDX_ENTREGA) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA),
                                         fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                         fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                         strNumOrc,
                                         strEspOrc,
                                         Nil,
                                         False,
                                         '',
                                         objPromVlrMinTotalProdutos,
                                         '',
                                         fatVenda.fltSomaColorantes)) Then
              Begin
                If (Not blnParticiona) Then
                  fatVenda.strPromoc := 'S';
              End;
            End;

            blnTemEmbFec  := (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1)      And
                             (fQuantEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text)) > 0) And
                             (fStrToFloat(edtQtdIte.Text) > 0)                                     And
                             (Not edtQtdIte.ReadOnly)                                              And
                             (Not fEmptyStr(edtCodIte.Text))                                       And
                             (Pos(strOpcDoc, 'DV_PR_') <= 0)                                       And
                             (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor)                    And
                             (Not fEhItemVendaVidro(fCodItem))                                     And
                             (Pos('ITEM ESPECIAL', fRetNomProduto(edtCodIte.Text)) <= 0);

            {Produto Acabado}
            If (blnProAca) And (Not fEmptyStr(strCodAca)) Then
            Begin

              {Se já inserido, os dados já estão corretos em "cdsVenda"!
               Se somente carregou o produto acabado, os dados estão corretos em "fatVenda"!}
              If (fItemJaInserido) Then
              Begin
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                              fatVenda.fPegaPrecoVenda(cdsVenda, fRetEmpresaItem,
                                                                       'S',
                                                                       fStrToFloat(edtMargem.Text),
                                                                       False,
                                                                       fatVenda.strIdePro,
                                                                       fTabelaDePrecoDosItens,
                                                                       True,
                                                                       fatVenda.FTaxJur,
                                                                       fatVenda.FUniVis));
              End
              Else
              Begin

                If (fEmptyStr(fatVenda.strTabTin) And fEmptyStr(fTabelaPrecoClienteOuVendedor)) Or
                   (fCfgSis('PRTTIN') = 'S') Then
                Begin
                  fltUniTmp := 0;

                  Case StrToIntDef(fTabelaDePrecoDosItens, 1) Of
                    1: fltUniTmp := fatVenda.fltPreVe1;
                    2: fltUniTmp := fatVenda.fltPreVe2;
                    3: fltUniTmp := fatVenda.fltPreVe3;
                    4: fltUniTmp := fatVenda.fltPreVe4;
                    5: fltUniTmp := fatVenda.fltPreVe5;
                    6: fltUniTmp := fatVenda.fltPreVe6;
                    7: fltUniTmp := fatVenda.fltPreVe7;
                  End;

                  If (fCfgSis('CLIDES') = 'S') And
                     (fCfgSis('DCVBVL') = 'L') Then
                  Begin
                    fltUniTmp := fFormataFloat(fltUniTmp * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
                  End;

                  edtUnitar.Text  := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniTmp);
                  strTabPreIteAnt := strTabPreItePrincipalAnt;

                  //Preço unitario sugerido sem juros
                  fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
                  fatVenda.fltTaxJur := 0.00;

                  If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
                  Begin
                    fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem);
                    edtUnitar.Text     := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniVis + fFormataFloat(fatVenda.fltUniVis * (fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0), 04));
                  End;

                End;

              End;

            End

            Else

            If (pnlItemLote.Visible) And 
               (Pos(strOpcDoc, 'DV_PR_') <= 0) And 
               (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) And
               (fatVenda.objCadLot.fExisteLote(fCodItem, IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD), edtNumLot.Text)) And
               (fatVenda.fCalculaPrecosLote(fStrToFloat(edtQtdIte.Text), fltUniLot, IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''))) Then
            Begin   
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniLot)
            End  

            Else 

            If SameText(fCfgSis('SUGVLE'), '1') Then
            Begin
              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                            fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                                     'S',
                                                                     fStrToFloat(edtMargem.Text),
                                                                     False,
                                                                     fatVenda.strIdePro,
                                                                     fTabelaDePrecoDosItens,
                                                                     True,
                                                                     fatVenda.FTaxJur,
                                                                     fatVenda.FUniVis))
            End                                                         

            Else

            Begin
              If (fatVenda.stlItensNaoEhEstrutura.IndexOf(edtCodIte.Text) = -1) And fItemEstrutura(fCodItem) Then
              Begin
                blnAplicarTaxaJuros := (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao);
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                              fatVenda.fCalculaPrecoEstrutura(blnAplicarTaxaJuros,
                                                                              Preco_de_Venda,
                                                                              fCodItem,
                                                                              fRetEmpresaItem,
                                                                              'S',
                                                                              fTabelaDePrecoDosItens,
                                                                              fStrToFloat(edtMargem.Text)));
                //Preço unitario sugerido sem juros
                fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
                fatVenda.fltTaxJur := 0.00;

                If blnAplicarTaxaJuros Then
                Begin
                  fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem);
                  edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniVis + fFormataFloat(fatVenda.fltUniVis * (fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0), 04));
                End;
              End
              else
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni),
                                              fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                                       'S',
                                                                       fStrToFloat(edtMargem.Text),
                                                                       False,
                                                                       fatVenda.strIdePro,
                                                                       fTabelaDePrecoDosItens,
                                                                       True,
                                                                       fatVenda.FTaxJur,
                                                                       fatVenda.FUniVis))
            End;

          End Else
          Begin
            If (fEmptyStr(fatVenda.strTabTin) And fEmptyStr(fTabelaPrecoClienteOuVendedor)) Or
               (fCfgSis('PRTTIN') = 'S') Then
            Begin
              fltUniTmp := 0;
              Case StrToIntDef(fTabelaDePrecoDosItens, 1) Of
                1: fltUniTmp := fatVenda.fltPreVe1;
                2: fltUniTmp := fatVenda.fltPreVe2;
                3: fltUniTmp := fatVenda.fltPreVe3;
                4: fltUniTmp := fatVenda.fltPreVe4;
                5: fltUniTmp := fatVenda.fltPreVe5;
                6: fltUniTmp := fatVenda.fltPreVe6;
                7: fltUniTmp := fatVenda.fltPreVe7;
              End;

              If (fCfgSis('CLIDES') = 'S') And
                 (fCfgSis('DCVBVL') = 'L') Then
              Begin
                fltUniTmp := fFormataFloat(fltUniTmp * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);
              End;

              edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUniTmp);
              strTabPreIteAnt := strTabPreItePrincipalAnt;

              //Preço unitario sugerido sem juros
              fatVenda.fltUniVis := fStrToFloat(edtUnitar.Text);
              fatVenda.fltTaxJur := 0.00;

              If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
              Begin
                fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem);
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniVis + fFormataFloat(fatVenda.fltUniVis * (fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0), 04));
              End;

              blnEmCamp := fatVenda.objCamGer.objCamDet.fVerificaProdutoCampanha(fatVenda.strCodCli,
                                                                                 edtCodIte.Text,
                                                                                 fatVenda.strIdePro,fatVenda.strIteTin,
                                                                                 fltVolPro,
                                                                                 fltVlrCam,
                                                                                 strCodCam,
                                                                                 fltPreClq);

              If blnEmCamp And (fltVlrCam > 0) Then
              Begin
                fatVenda.strPromoc := 'N';
                edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltVlrCam);
              End
              Else
              Begin
                If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And cbTabPrecoItem.Visible Then
                Begin
                  If (fatVenda.fItemPassivelDeVerificacaoPromo(edtCodIte.Text, fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem))) Then
                  Begin
                    FillChar(dadosPromocao, SizeOf(dadosPromocao), #0);
                    dadosPromocao := fDadosPromocao(edtCodIte.Text,
                                                    fatVenda.fGetEmpPrecoPromoItem(fRetEmpresaItem),
                                                    fatVenda.strCodCli,
                                                    fTabelaPrecoItem);

                    fatVenda.strPromoc := IIF(fEmptyStr(dadosPromocao.strCodPro), 'N', 'S');
                    fatVenda.strCodPro := dadosPromocao.strCodPro;
                  End;
                End;
              End;
            End
            Else
            Begin
              strTabPreIteAnt := strTabPreItePrincipalAnt;
              blnAplicaJurosCondicao := False;
            End;
          End;

          fltUnitario := 0;
          If (fStrToFloat(edtUnitar.Text) <> 0) Then
            fltUnitario := fStrToFloat(edtUnitar.Text);

          fatVenda.fltUniOri := fltUnitario;

          fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);

          {Desconto Embalagem}
          If (blnTemEmbFec) And (fatVenda.stlItensNaoTemQtdeEmbFec.IndexOf(edtCodIte.Text) = -1) Then
          Begin
            fltTmpUnt := fltUnitario;
            If fEhEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text)) And (fatVenda.strPromoc <> 'S') Then
            Begin
              If fCalcularDescontoEmbFechada Then
                fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text), '')
              Else
                fltPercDesEmbFec := 0.00;

              fltTmpUnt   := ( fltTmpUnt * ( 1 - ( fltPercDesEmbFec / 100 ) ) );
              fltUnitario := fltTmpUnt;
              fatVenda.FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(VS_strCodEmp, edtCodIte.Text, fTabelaDePrecoDosItens, '', fStrToFloat(edtQtdIte.Text), fltPercDesEmbFec);

              If (fCfgSis('TRPEMB') = '2') And
                 (Pos(strOpcDoc, 'UC_') <= 0) Then
              Begin
                fltPreEmbFec := fatVenda.fGetUnitarioEmbalagemFechada(edtCodIte.Text, fTabelaDePrecoDosItens, fStrToFloat(edtQtdIte.Text),0);

                If fltPreEmbFec > 0 Then
                Begin
                  fltUnitario := fltPreEmbFec;
                  fatVenda.fltUniOri := fltPreEmbFec;
                End;
              End;

            End;
          End;

          If Not fEmptyStr(strCodBarEmb) And (fCfgSis('PRVEMB', VarString) = 'S') And (Not fatVenda.blnCliFil) Then
          Begin
            If fRetornaPrecoCodBarraEmb( edtCodIte.Text, strCodBarEmb, qryConIte.FieldByName('ITE_CODEMP').AsString, fTabelaPrecoItem, False ) > 0 Then
            Begin
              fltUnitario := fatVenda.fPegaPrecoVenda(qryConIte, fRetEmpresaItem,
                                                      'S',
                                                      fStrToFloat(edtMargem.Text),
                                                      False,
                                                      fatVenda.strIdePro,
                                                      IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                      True,
                                                      fatVenda.FTaxJur,
                                                      fatVenda.FUniVis,
                                                      (Not fEmptyStr(strCodBarEmb)),
                                                      fRetornaPrecoCodBarraEmb(edtCodIte.Text,
                                                                               strCodBarEmb,
                                                                               qryConCit.FieldByName('ITE_CODEMP').AsString,
                                                                               fTabelaPrecoItem,
                                                                               True),
                                                      fRetornaTabPreCodBarraEmb(edtCodIte.Text, strCodBarEmb));

              fatVenda.fltUniOri := fltUnitario;
              fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);
            End;
          End;

          {*******************************************}
          {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
          {* APLICA O PERCENTUAL DE DESCONTO         *}
          {****************************************MV*}
          If (blnAplicaJurosCondicao) And
             (fatVenda.strCAbDes = 'S') And
             (fCfgSis('CNDVEN') = 'I') And
             ((fatVenda.strPromoc <> 'S') Or
              (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
             (Not fAplicarTaxaJurosPrecoDigitado) Then
          Begin
            {********************************************************************}
            {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
            {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
            {****************************************************************MM**}
            fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

            If fCfgSis('DESCND',varBoolean) Then
            Begin
              If (fatVenda.strDstCnd = 'S') Then
              Begin
                fltUnitario    := fatVenda.fltUniOri;
                edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
              End
              Else
                fltUnitario := fatVenda.fltUniOri;

            End

            Else If (fatVenda.strCodFpg = '007') Then
            Begin
              If (fatVenda.strAbDeCc = 'S') Then
                fltUnitario := fltUnitario - fatVenda.fRetornaVrDesconto(2, fltUnitario, fltDesMax);
            End
            Else
              fltUnitario := fltUnitario - fatVenda.fRetornaVrDesconto(2, fltUnitario, fltDesMax);

            fltUnitario := fFormataFloat(fltUnitario, fatVenda.VS_intDecUni);
          End;

          If fAplicarDescontoRessarcimentoCAT Then
          begin
            fltUnitario := fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fltUnitario);
          end;

          {Atualiza valor unitário}
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltUnitario);

          If fCarregarEstruturaVidro(fCodItem, btnAdicionar.Tag, False) Then
          Begin
            fAtualizaPrecosEstruturaVidro(fTabelaPrecoItem, fEntregaFuturaItem, fRetEmpresaItem);
          End;

          pAtualizaUnitarioLiquido;

        End;

        If fEstaNaConsultaTab And blnBuscaPorChave And (fatVenda.strIdePro = 'NOR') Then
          pExecutarAtualizarImpostosNaConsultaTab;
      End;

      If cbTabPrecoItem.Visible Then
      Begin
        pEditarDesconto;
        pEditarPrecoUnitario;
      End;
    End;

    If (Sender = edtKM_Vei) And (pnlPlacaVeiculo.Visible) And (edtKM_Vei.Enabled) Then
    Begin
      If Not fEmptyStr(edtKM_Vei.Text) Then
      Begin
        If fStrToFloat(edtKM_Vei.Text) <= 0 Then
        Begin
          Result := False;
          fMensagem('','A kilometragem do veículo deve ser maior que zero!', ['&Ok']);
        End
        Else
          fatVenda.strKM_Vei := edtKM_Vei.Text;
      End
      Else
      Begin
        {************************************************}
        {* VERIFICA SE PERMITE DEIXAR O CAMPO KILOMETRO *}
        {* VAZIO QUANDO FOR PEDIDO DE VENDA.            *}
        {*********************************************PZ*}
        If (strOpcDoc = 'PD') And (fCfgSis('DIG_KM', varString) = 'S') Then
        Begin
          fMensagem('ATENÇÃO!','A kilometragem do veículo deve ser preenchida!',['&O k']);
          Result := False;
        End
      End;
    End;

    If (Sender = edtNomCli) Then
    Begin
      If (Result) And (fAlteraNomeConsumidorTelaDeVendas(strOpcDoc)) And (fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) And (fEmptyStr(edtNomCli.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Obrigado informar um nome para o cliente consumidor.', ['&O k']);
        Result := False;
      End;
    End;

    If (Sender = edtCodCli) Then
    Begin

      If (Not fPermiteTrocarClienteDoPedidoNoVendaNormal) Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é possível trocar de cliente na rotina de Venda Normal!', ['&OK']);
        Result := False;
      End;

      If (Not fEmptyStr(edtCodCli.text)) And (Pos(strOpcDoc,'VN_') > 0) And (Not fatVenda.fDocumentoParaFornecedor) And (ClienteVinculadoTemEstoqueExterno(edtCodCli.text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é permitido utilizar cliente com estoque externo vinculado. Verifique!', ['&OK']);
        Result := False;
      End;

      If (fTrocandoClienteComCreditoNoPedido) Then
      Begin
        fMensagem('ATENÇÃO!', 'Foi utilizado abatimento automático de Crédito na geração deste pedido, alteração de Cliente não permitida.' +sLineBreak+
                              'Faça o estorno do Contas a Receber para depois prosseguir com a alteração', ['&OK']);
        Result := False;
      End;

      {Req.: 109610 - Limpa endereço de entrega ao trocar cliente}
      If (Result) And (Not fEmptyStr(strCliAnt)) And (strCliAnt <> edtCodCli.Text) Then
      Begin
        blnCliLgpd := false;

        If Not blnInformouClienteDeOutroVendedor Then
          blnValidaVendedorDoCliente := True;
        blnInformouClienteDeOutroVendedor := False;

        fatVenda.objDadosCte.pLimpaDadosObjeto;
        fatVenda.objDadosCte.objPartilha.pLimpaDadosObjeto;

        If (Not fEmptyStr(fatVenda.objEndEnt.recEndere.strIncrem)) Then
        Begin
          fatVenda.pLimparEnderecoEntrega;
          fatVenda.objEndEnt.recEndere.blnAltera := True;
          fatVenda.pEnderecoToFatVenda;
          fatVenda.objEndEnt.recEndere.blnAltera := False;
        End;

        {Req.: 129429}
        If (pnlEntrega.Visible) Then
        Begin

          If Not cdsVenda.IsEmpty Then
          Begin

            cdsVenda.DisableControls;

            Try

              cdsVenda.First;
              While Not cdsVenda.Eof Do
              Begin

                If Not fControleDestino(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                        IfThen(fEmptyStr(edtCodEmp.Text), VS_strCodEmp, edtCodEmp.Text),
                                        edtCodCli.Text) Then
                Begin
                  edtCodCli.Text := strCliAnt;
                  edtNomCli.Text := fRetNomCliente(strCliAnt);
                  Result := False;

                  Break;

                End;

                cdsVenda.Next;

              End;

            Finally
              cdsVenda.EnableControls;
            End;

          End;

        End;

        {Req.: 340381}
        If fCfgSis('LMPRVE', varBoolean) Then
        begin
          if fCfgSis('NROPRO', varString) = '2' then
            fatVenda.strCodDiv := EmptyStr;
        end;
      End;

      If (Result) And (blnDevEsp) And (Not fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Selecionar apenas Cliente Consumidor.', ['&O k']);
        Result := False;
      End;

      if (Result) and (Not blnCliLgpd) and (Not fEmptyStr(edtCodCli.text)) and (Pos(strOpcDoc,'PD_VN_') > 0) and (fCfgSis('INLGPD', varString) = 'S') and (Not fClienteConsumidor(fRetNomCliente(edtCodCli.Text))) then
      begin
        if (fCampoTabela('CLI_LEILGP', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text])= 'N') then
        Begin
          fMensagem('ATENÇÃO!', 'Este Cliente ' + edtCodCli.Text + ' - ' +fRetNomCliente(edtCodCli.Text) + ' não está incluído na Lei LGPD. ' + sLineBreak +
                                'Este é um aviso para atualizar os dados cadastrais e incluí-lo na Lei LGPD. ', ['&O k']);
          blnCliLgpd := true;
        End;
      end;

      If (Result) And (Not fValidaEntregaCD) Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é permitido vender para o Cliente Filial do Centro de Distribuição utilizando entrega pelo C.D.', ['&O k']);
        Result := False;
      End;

      If chkEntCD.Checked And
         fatVenda.fClienteFilialVenda(edtCodCli.Text) And
         (fRetCodEmpClienteFilial(edtCodCli.Text) = VS_strCodEmp) Then
      Begin
        chkEntCD.Checked := False;
        fMensagem('','Não é possível utilizar entrega pelo CD quando informar um cliente filial e o cliente filial for a própria loja!', ['&Ok']);
        Result := False;
      End;

      If (strCliAnt <> edtCodCli.Text) And (Not blnInserindoCombo) Then
      Begin
        blnLib_TE          := False;
        fatVenda.strEmp_TE := '';
        pLimpaDadosItem;
        pRemoverTravaLogAvi('SENPEM', fatVenda.strNTrava);
      End;

      If (Not fEmptyStr(strCliAnt)) And (strCliAnt <> edtCodCli.Text) And (Not blnInserindoCombo) Then
      Begin
        If (Not fatVenda.fValidarTrocaClientePedeSenha(strCliAnt, edtCodCli.Text, fRetCodVenDef(edtSenVen.Text))) Then
        Begin
          edtCodCli.Text := strCliAnt;
          edtNomCli.Text := fRetNomCliente(strCliAnt);
        End;
      End;

      If fEmptyStr(edtCodCli.Text) Then
      Begin
        fMensagem('ATENÇÃO!', 'O código do ' + IIF(fatVenda.fDocumentoParaFornecedor, 'Fornecedor', 'Cliente') + ' deve ser preenchido!', ['&O k']);
        Result := False;
      End

      Else If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
              (strCliAnt <> edtCodCli.Text)     And
              (Not fEmptyStr(fCampoTabela('CLI_CORRES', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text], False))) Then
      begin
        fMensagem('ATENÇÃO!', 'O cliente informado possui um correspondente, portanto o cliente utilizado para venda será atualizado!', ['&O k']);
        edtCodCli.Text := fCampoTabela('CLI_CORRES', 'CADCLI', ['CLI_CODCLI'], [edtCodCli.Text]);
        edtNomCli.Text := fRetNomCliente(edtCodCli.Text);
        Result := False;
      End

      Else If (Pos(strOpcDoc, 'VN_PD_OR_') > 0) And (Not fatVenda.fDocumentoParaFornecedor) And (TFatVenda.fTravarVendaClientePessoaFisica(edtCodCli.Text)) Then
      Begin
        Result := False;
      End

      Else If (fCfgSis('BRIDIV') = 'S') And (Not fatVenda.fDocumentoParaFornecedor) And (SameText(fatVenda.strOpcDoc, 'BR')) And (Not fClienteProfissional(edtCodCli.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Só é possível emitir BRINDE para clientes com vínculo no Cadastro de Diversos!', ['&OK']);
        Result := False;
      End

      Else If (Not fPermiteClienteDiaFixoOuDiaSemana(edtCodCli.Text, fatVenda.fUtilizarDataEmissaoCalcularDiaVencimento)) Then
      Begin
        Result := False;
      End

      {**********************************}
      {* VERIFICA STATUS DO CLIENTE     *}
      {*******************************JB*}
      Else If (fatVenda.fCfgSisTraScl(strOpcDoc)) And
              (Not fatVenda.fDocumentoParaFornecedor) Then
      Begin
       (******************************************************************************)
       (* ORIENTADO PARA MUDAR A TRAVA, VAI CONSIDERAR SOMENTE A TRAVA fCfgSisTraScl *)
       (***************************************************************************LA*)
        If (fatVenda.fRetornaStatusClienteVenda(edtCodCli.Text) = 'I') And
           (Not fatVenda.fPermiteVenderApenasDinheiroECartaoParaInativo(strOpcDoc)) Then
        Begin
          If (strOpcDoc = 'CF') Then
          Begin
            objLiberacao.Clear;
            objLiberacao.objMsgLibera.pAddTexto('Liberação de Confirmação de Documentos para Clientes Inativos.');

            objLiberacao.strDirAce := 'LIBCIC';
            objLiberacao.strSenLib := fCfgSis('SENCIC');
            objLiberacao.strMsgSen := 'Liberação de Confirmação de Documentos para Clientes Inativos';
            objLiberacao.strCodOpe := strLoginUsuarioLogado;
            objLiberacao.strCliente := edtCodCli.Text + '-' + fRetNomCliente(edtCodCli.Text);
            objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

            If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
            Begin
              strCliAnt := edtCodCli.Text;;
              Result    := False;
            End;
          End
          Else
          Begin
            fMensagem('ATENÇÃO!', 'Esse cliente está com atividade suspensa!', ['&O k']);
            strCliAnt := edtCodCli.Text;;
            Result    := False;
          End;
        End;
      End;

      {*****************************************}
      {* TRANSFERENCIA DE ESTOQUE PERMITIDA    *}
      {* SOMENTE PARA CLIENTE FILIAL <> DA     *}
      {* PROPRIA EMPRESA                       *}
      {**************************************AF*}
      If (Pos(strOpcDoc,'VN_CS_TE_') > 0) And (fatVenda.fClienteFilialVenda(edtCodCli.Text)) And Result Then
      Begin
        If (fRetornaClienteFilial(VS_strCodEmp) = edtCodCli.Text) And
           (Not fEmptyStr(edtSenVen.Text))                        And
           (Not blnLib_TE)                                        Then
        Begin
          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Liberação para efetuar transferência de estoque para a própria Loja');

          objLiberacao.strDirAce := 'SENPEM';
          objLiberacao.strSenLib := fCfgSis('SENPEM');
          objLiberacao.strMsgSen := 'Transferência de Estoque não permitida para a própria loja';
          objLiberacao.strCodOpe := IIF(fEmptyStr(FatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
            Result := False
          Else
          Begin
            blnLib_TE := True;

            If blnLibMsg Then
              fMensagem('ATENÇÃO!','Você está emitindo um documento para sua própria loja, confirme com seu' + #13#10 +
                                   'gerente se o procedimento está correto, pois será solicitado' + #13#10 +
                                   'senha de liberação no fechamento do documento!', ['&O k']);
          End;
        End;
      End
      {*******************************************}
      {* PERMITE OUTRAS ENTRADAS E OUTRAS SAÍDAS *}
      {* PARA CLIENTE FILIAL = A PROPRIA EMPRESA *}
      {****************************************RV*}
      Else If (Pos(strOpcDoc,'OV_OE_EF_UC_OR_PD_DV_DD_NC_PA_') <= 0) And (fatVenda.fClienteFilialVenda(edtCodCli.Text)) And Result Then
      Begin
        If (fRetornaClienteFilial(VS_strCodEmp, IIF(strOpcDoc = 'OF', 'F', 'C')) = edtCodCli.Text) And
           (Not fEmptyStr(edtSenVen.Text))                        And
           (Not blnLib_TE)                                        Then
        Begin
          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Liberação para efetuar confirmação de transferência de estoque para a própria Loja');

          objLiberacao.strDirAce := 'SENPEM';
          objLiberacao.strSenLib := fCfgSis('SENPEM');
          objLiberacao.strMsgSen := 'Transferência de Estoque não permitida para a própria loja';
          objLiberacao.strCodOpe := IIF(fEmptyStr(FatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
            Result := False
          Else
          Begin
            blnLib_TE := True;

            If blnLibMsg Then
              fMensagem('ATENÇÃO!','Você está emitindo um documento para sua própria loja, confirme com seu' + #13#10 +
                                   'gerente se o procedimento está correto, pois será solicitado' + #13#10 +
                                   'senha de liberação no fechamento do documento!', ['&O k']);
          End;
        End;
      End

      Else If (fatVenda.fClienteFilialVenda(edtCodCli.Text)) And (Pos( strOpcDoc, 'NP_TE_VN_CS_VS_CT_PD_OR_OU_OV_BR_UC_NC_OE_EF_NE_DV_PA_' ) <= 0) And Result Then
      Begin
        fMensagem('ATENÇÃO!', 'A Utilização de Cliente Filial é permitido somente para' + #13#10 +
                  'Transferência de Estoque, Ativo Imobilizado, Pedido, Orçamento e Devolução!', ['&O k']);
        Result := False;
      End;

      If (edtCodCli.Text = fRetornaClienteFilial(VS_strCodEmp)) Then
      Begin
        If (Pos(strOpcDoc,'OR_PD_') > 0) And Result And (fatVenda.strEmp_TE = '') Then
        Begin
          If Not fRetornaEmpresaTE Then
          Begin
            fMensagem('ATENÇÃO!', 'É necessário informar a Empresa que irá atender' + #13#10 +
                      'este documento através de Transferência de Estoque!', ['&O k']);
            Result := False;
          End;

          If Not fValidarClienteFilialComProdutosMultiLoja(fatVenda.strEmp_TE) Then
          Begin
            Result := False;
            fatVenda.strEmp_TE := '';
          End
          Else
          Begin
            fatVenda.recDadCli.fltFat_TE := fRetClienteFilialFatorTE(IIF(fEmptyStr(fatVenda.strEmp_TE),VS_strCodEmp,fatVenda.strEmp_TE), edtCodCli.Text);
            fatVenda.recDadCli.fltFatTE2 := fRetClienteFilialFatorTE_ST(IIF(fEmptyStr(fatVenda.strEmp_TE),VS_strCodEmp,fatVenda.strEmp_TE), edtCodCli.Text);
            fatVenda.recDadCli.strTEPREV := fGetTEPREV(IIF(fEmptyStr(fatVenda.strEmp_TE),VS_strCodEmp,fatVenda.strEmp_TE), edtCodCli.Text);
            fatVenda.recDadCli.strTEPPRO := fGetTEPPRO(IIF(fEmptyStr(fatVenda.strEmp_TE),VS_strCodEmp,fatVenda.strEmp_TE), edtCodCli.Text);
          End;
        End;
      End
      Else
        fatVenda.strEmp_TE := '';

      If (Result                                        And
          (Sender = edtCodCli)                          And
          (Not fEmptyStr(edtCodCli.Text))               And
          (Not fVerificaAcessoSistema('VALPED'))        And
           fatVenda.fClienteFilialVenda(edtCodCli.Text) And
           SameText(strOpcDoc, 'OR'))                        Or
          (Result And fatVenda.blnEhOrcamentoRefPed)         Then
      Begin
        If fCfgSis('VALPED', VarBoolean) Then
        Begin
          btnTintaMaquina.Enabled := False;

          If (fatVenda.strCliAntOrcRef <> edtCodCli.Text) Or
             (fEmptyStr(fatVenda.strNumPedRefOR) And
              fEmptyStr(fatVenda.strEmpPedRefOR)) Then
          Begin
            pCriarFormularios(TfrmFatDigPedido, frmFatDigPedido);
            frmFatDigPedido.fatVenda := fatVenda;
            frmFatDigPedido.ShowModal;

            If frmFatDigPedido.ModalResult = mrOk Then
            Begin
              If Assigned(fatVenda.cdsPedRefOR) Then
                FreeAndNil(fatVenda.cdsPedRefOR);

              fatVenda.cdsPedRefOR := TUniClientDataSet.Create(Self);
              pCloneDataSet(fatVenda.cdsPedRefOR, frmFatDigPedido.cdsDados);

              fatVenda.strNumPedRefOR      := frmFatDigPedido.edtNumPed.Text;
              fatVenda.strEmpPedRefOR      := frmFatDigPedido.edtCodEmp.Text;
              fatvenda.strCliAntOrcRef     := edtCodCli.Text;
              mnuTrocaPDRefOR.Visible      := True;
            End
            Else
            Begin
              pLimpaCamposPedRefOR;
              Result := False;
            End;

            pFreeAndNil(frmFatDigPedido);
          End;
        End
        Else
          pLimpaCamposPedRefOR;
      End
      Else
        pLimpaCamposPedRefOR;

      fatVenda.fltFat_TE := fatVenda.recDadCli.fltFat_TE;
      fatVenda.fltFatTE2 := fatVenda.recDadCli.fltFatTE2;
      fatVenda.strTEPREV := fatVenda.recDadCli.strTEPREV;
      fatVenda.strTEPPRO := fatVenda.recDadCli.strTEPPRO;

      {******************************************************}
      {*APAGA OS INDICES DA CONSULTA DE ITENS ANTERIOR, PELO*}
      {*FATO DE TER INCLUÍDO O CLIENTE NA PROMOÇÃO DOS ITENS*}
      {*E COM ISSO É NECESSÁRIO ATUALIZAR A CONSULTA        *}
      {***************************************************PZ*}
      If (fEmptyStr(fatVenda.strCodCli) Or (strCliAnt <> edtCodCli.Text)) And blnBuscaPorChave Then
        pApagaConsAnterior;

      {*****************************************}
      {* CASO FOR CLIENTE FILIAL E O OPERADOR  *}
      {* NÃO TIVER DIREITO DE ACESSO PARA TE   *}
      {**************************************AF*}
      If (Not fEmptyStr(edtCodCli.Text)) And fatVenda.fClienteFilialVenda(edtCodCli.Text) And (Pos(strOpcDoc,'PD_OR_UC_NC_PA_') <= 0) And (Not fatVenda.fDocumentoParaFornecedor) Then
      Begin
        If Not fVerificaAcessoSistema('frmFatVendas - TE') Then
        Begin
          fMensagem('', 'Operador não tem direito de acesso a Transferência de Estoque!', ['&O k']);
          Result := False;
        End;
      End;

      If Result And (Not fEmptyStr(strCliAnt)) And (strCliAnt <> edtCodCli.Text) And (Not blnInserindoCombo) And
         (Not fVerificaAcessoSistema('TRALTCLIORPED')) And (Pos(Self.strOpcDoc, 'TE_') > 0) Then
      Begin
        If (Not fatVenda.fValidarTrocaClienteTEPedeSenha(strCliAnt, edtCodCli.Text, fRetCodVenDef(edtSenVen.Text))) Then
        Begin
         edtCodCli.Text := strCliAnt;
         edtNomCli.Text := fRetNomCliente(strCliAnt);
         Result := False;
        End;
      End;

      fatVenda.fltFat_TE := fatVenda.recDadCli.fltFat_TE;
      fatVenda.fltFatTE2 := fatVenda.recDadCli.fltFatTE2;
      fatVenda.strTEPREV := fatVenda.recDadCli.strTEPREV;
      fatVenda.strTEPPRO := fatVenda.recDadCli.strTEPPRO;

      If (Not fEmptyStr(fatVenda.strCodCli)) And
         (Not fatVenda.fDocumentoParaFornecedor) And
         (Pos(strOpcDoc,'OR_PD_VN_CP_') > 0) And (fCfgSis('TAXENT', VarString) = 'S') Then
      Begin
        If fEmptyStr(fatVenda.strCodReg) Then
        Begin
          fMensagem('ATENÇÃO!', 'Favor cadastrar uma Região para o Cliente,' + #13#10 +
                                'importante para o cálculo do valor de entrega!', ['&O k']);
          Result := False;
        End
        Else If fEmptyStr(fRetNomRegiao(fatVenda.strCodReg)) Then
        Begin
          fMensagem('ATENÇÃO!', 'Essa Região não está cadastrada!', ['&O k']);
          Result := False;
        End
        Else If (Not fatVenda.fFaixaHorarioRegiaoPreenchida) Then
        Begin
          fMensagem('ATENÇÃO!', 'Para calcular o valor do frete de acordo com a região do cliente,' + #13#10 +
                                'é preciso cadastrar a faixa de horários da região, para o sistema poder' + #13#10 +
                                'verificar se o frete será cobrado novamente ou não!' + #13#10 +
                                'Para cadastrar vá em : Principal --> Manutenção de Cadastros --> ' + #13#10 +
                                'Auxiliares --> Regiões (Botão F3)', ['&O k']);
          Result := False;
        End;
      End;

      If (Result) And (Pos(strOpcDoc,'OR_PD_VN_') > 0) And (Not fValidouConsultaSituacaoCadastral(edtCodCli.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', Format(MSG_PAINEL_FECHADO_CONSULTA_CADASTRAL, [VS_strCodEmp]), ['&OK']);
        Result := False;
      End;

      chkUtiAbastDep.Enabled := not fatVenda.fClienteFilialVenda(edtCodCli.Text);
      if not chkUtiAbastDep.Enabled then
        chkUtiAbastDep.Checked := False;
    End;

    If (Sender = edtCodCli) And fatVenda.fDocumentoParaFornecedor Then
    Begin

      If fEmptyStr(fatVenda.strCodCli) Or (strCliAnt <> edtCodCli.Text) Then
      Begin

        If fEmptyStr(edtCodCli.Text) Then
        Begin
          fMensagem('ATENÇÃO!', 'O código do fornecedor deve ser preenchido!', ['&O k']);
          Result := False;
        End
        Else
        Begin
          pCarregaFornecedor;

          If qryConCli.FieldByName('FOR_CODFOR').IsNull Then
          Begin
            fMensagem('ATENÇÃO!', 'Esse fornecedor não está cadastrado!', ['&O k']);
            Result := False;
          End;

          pCarregaTela(False);

          If Result Then
          Begin

            {************************************************}
            {* RECALCULANDO PREÇOS QUANDO MUDA O FORNECEDOR *}
            {*********************************************LA*}
            If (fEmptyStr(fatVenda.strCodCli) Or (strCliAnt <> edtCodCli.Text)) Then
            Begin
              pRecalculaPrecos;
              pCalculaTotais;
              pEnabledFechamento(True);

              If Pos(strOpcDoc, 'VN_CS_PD_OR_') > 0 Then
                blnComVen := True;

              dbgItens.Repaint;
            End;

            If blnHabilitaCndPag Then
              If Not ( (fCfgSis('USACND', varString) = 'S') ) And (Not fatVenda.blnMeiaNota) Then
                mskCndPag.Enabled  := True;


            {*************************************************}
            {* COMENTEI POIS NÃO ESTAVA LEVANDO O NOME DO    *}
            {* FORNECEDOR NAS TRAVAS DE SENHAS DE LIBERAÇÕES *}
            {**********************************************PZ*}
            //fatVenda.strCliNom := '';

            {*****************************************}
            {* PEGA DADOS FISCAIS                    *}
            {**************************************LA*}
            fatVenda.pPegaDadosFiscais(fatVenda.fTrocaUFEndEntrega, fatVenda.strCliIes, fatVenda.strMicEmp, fatVenda.fGetUFEmpresa(''), True);
            strCliAnt := fatVenda.strCodCli;

            {*************************************************}
            {* NÃO PERMITE VENDA A PRAZO PARA CLI-CONSUMIDOR *}
            {**********************************************LA*}
            If edtCodCnd.Visible And (Not fEmptyStr(edtCodCnd.Text)) Then
            Begin
              pCarregaCondicao;
              fatVenda.strConPag := mskCndPag.Text;
            End;

          End;

        End;

      End;

    End;

    If (Sender = edtCodCli) And (fCfgSis('CFFRES') = 'S') And (strOpcDoc = 'CF') Then
    Begin
      If (fRetEmpRespConfDocs(edtCodCli.Text) <> VS_strCodEmp) And (Not fEmptyStr(fRetEmpRespConfDocs(edtCodCli.Text))) Then
      Begin
        fMensagem('ATENÇÃO!', 'Esta empresa não está autorizada a realizar confirmação de documentos para este cliente!', ['&O k']);
        Result := False;
      End;
    End;

    If (Sender = edtCodCli) And (edtCodCli.Text <> strCliAnt) Then
    Begin

      If (fCfgSis('VENFES', varString) = 'S') And (Pos(strOpcDoc, 'VN_PD_OR_') > 0) Then
      Begin
        strEstCli := fRetUFCliente(edtCodCli.Text);
        strEstEmp := fatVenda.fGetUFEmpresa('');

        If (strEstCli <> strEstEmp) Then
        Begin
          objLiberacao.Clear;
          objLiberacao.strDirAce     := 'LIBVENFORAEST';
          objLiberacao.strMsgSen     := 'Liberação de Venda para Fora do Estado';
          objLiberacao.strCodOpe     := strLoginUsuarioLogado;
          objLiberacao.objMsgLibera.pAddTexto('Venda para fora do Estado');
          objLiberacao.objMsgLibera.pAddTextoCaption('Estado Cliente: ', strEstCli, 24);
          objLiberacao.objMsgLibera.pAddTextoCaption('Estado Empresa: ', strEstEmp, 24);
          Result := objLiberacao.fLibera;
        End;

      End;


      If (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And (fCfgSis('SOM1PD', varString) = 'S') Then
      Begin
        If (fCfgSis('VEM1PD', varString) = 'E') Then
        Begin
          If fPedidoOuOrcamentoEmAbertoParaCliente(edtCodCli.Text,
                                                   strDocTmp,
                                                   strEspTmp) And (strDocTmp <> strNumOrc) And
                                                                  (strEspTmp <> strEspOrc) Then
          Begin
            Result := False;

            If fPergunta('Já existe um documento em aberto para este cliente deseja carregar o mesmo (' + strDocTmp + '-' + strEspTmp + ') ?') Then
            Begin
              strNumOrcPedAbrir := strDocTmp;
              strEspOrcPedAbrir := strEspTmp;
              fatVenda.blnFecharForm := True;
              Self.Repaint;
            End
            Else
              edtCodCli.Clear;
          End;
        End
        Else If (fCfgSis('VEM1PD', varString) = 'T') Then
        Begin
          stlPedidosTodasEmpresas := TStringList.Create;
          Try
            If fPedidoOuOrcamentoEmAbertoParaClienteTodasAsEmpresas(edtCodCli.Text,
                                                                    stlPedidosTodasEmpresas) Then
            Begin
              Result := False;
              fMensagemTabela('ATENÇÃO!','Já existem documentos em aberto para este cliente:',TStringArray(stlPedidosTodasEmpresas.ToStringArray),'', ['&Ok']);
            End;
          Finally
            FreeAndNil(stlPedidosTodasEmpresas);
          End;
        End;
      End;

      If Result And
        (Pos(strOpcDoc, 'PD_OR_') = 0) And
        (Not fatVenda.fValidarSeClienteEstoqueExternoPermiteFaturamento(edtCodCli.Text, strEstoqueExterno)) And
        (Not fatVenda.fEhDevolucaoMercadoriaDoEstoqueExterno(edtCodCli.Text)) Then
      Begin
        pMensagemOk(Format('O cliente do estoque externo "%s" não pode emitir faturamento pelo Autcom!', [strEstoqueExterno]));
        Result := False;
      End;

      If Result And fSolicitaContatoAutorizado(strOpcDoc) Then
      Begin
        Result := fFatDigContatoCpfRG;
      End;

      If Result Then
        Result := fPermiteTrocarClienteComCNPJouCPF(edtCodCli.Text);
    End;

    If (Result) And (Sender = edtCodCli) And (Not fatVenda.fDocumentoParaFornecedor) And ((fEmptyStr(fatVenda.strCodCli) Or (strCliAnt <> edtCodCli.Text) Or
    ((Not fatVenda.blnGraCon) And fClienteConsumidor(fatVenda.strCliOri, False, True) And blnBuscaPorChave))) and (not blnChamouTelaCOnfirmacao) and (not blnInserindoCombo) Then
    Begin
      edtNomCli.Enabled := False;
      edtNomCli.ReadOnly := True;
      edtNomCli.TabStop := False;
      edtNomCli.Color := $00FFDFB8;

      strTabPreAnt := fatVenda.strTabPre;

      pCarregaCliente;

      Result := fPossuiDirAceCliFil();

      If (Not fEmptyStr(strTabPreAnt)) And (Not fEmptyStr(fatVenda.strNumOrc)) And (fCfgSis('TBPCND', varString) = 'S') And (fCfgSis('CNDVEN', varString) = 'I') Then
        fatVenda.strTabPre := strTabPreAnt;

      If qryConCli.FieldByName('CLI_CODCLI').IsNull Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse cliente não está cadastrado' + IIF(Pos(strOpcDoc, 'VN_PD_OR_') > 0, ' ou usuário não possui direito de acesso para selecioná-lo!' +
                  IIF(btnCliOutroVendedor.Visible, ' Informe o CPF/CNPJ através do botão "Cliente de outro vendedor".', ''), '.'), ['&O k']);
        Result := False;
      End

      Else If (fEmptyStr(fatVenda.strNumDoc)) And (Not fEmptyStr(fatVenda.strCodCli)) And (Length(fatVenda.strCodCli) <> VS_intTamCodCli) Then
      Begin
        fMensagem('ATENÇÃO!', 'O tamanho do código do cliente deve ser de '+ VS_intTamCodCli.ToString +' dígitos. Favor entrar em contato com a Citel!', ['&O k']);
        Result := False;
      End

      Else If (fatVenda.strPerEmp = 'N') And (strOpcDoc = 'EP') Then
      Begin
        fMensagem('ATENÇÃO!', 'Empréstimo não permitido para esse cliente!', ['&O k']);
        Result := False;
      End

      Else If fEmptyStr(fRetNomCidade(fatVenda.strCodCid)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Cidade do Cliente inválida!', ['&O k']);
        Result := False;
      End

      Else If (Not fEmptyStr(fTabelaPrecoClienteOuVendedor)) And
              (Not fSistemaUsaEssaTabelaPreco(fTabelaPrecoClienteOuVendedor)) Then
      Begin
        If fSistemaSugeriuTabelaCliente Then
        Begin
          fMensagem('ATENÇÃO!', 'A tabela de preço "' + fTabelaPrecoClienteOuVendedor +
            '" informada no cadastro do ' + fDescricaoClienteOuVendedorTabelaPreco +
            ' não está configurada para ser utilizada pelo sistema. '+
            'Favor alterar a tabela de preço no cadastro do ' + fDescricaoClienteOuVendedorTabelaPreco +'!', ['&O k']);
          Result := False;
        End;
      End

      Else If (Not fEmptyStr(fTabelaPrecoClienteOuVendedor)) And
              (Not fFaturamentoUsaEssaTabelaPreco(fTabelaPrecoClienteOuVendedor)) Then
      Begin
        If fSistemaSugeriuTabelaCliente Then
        Begin
          fMensagem('ATENÇÃO!', 'A tabela de preço "' + fTabelaPrecoClienteOuVendedor +
                    '" informada no cadastro do ' + fDescricaoClienteOuVendedorTabelaPreco +
                    ' não está configurada para ser utilizada pelo sistema. '+
                    'Favor alterar a tabela de preço no cadastro do ' + fDescricaoClienteOuVendedorTabelaPreco +'!', ['&O k']);
          Result := False;
        End;
      End

      Else If Not fValidaEstado(fatVenda.fTrocaUFEndEntrega) Then
      Begin
        fMensagem('ATENÇÃO!', 'Estado do Cliente inválido!', ['&O k']);
        Result := False;
      End Else

      If (fatVenda.blnCliFil) And (strOpcDoc <> 'UC') And (strOpcDoc <> 'PA') Then
      Begin

        If fCfgSis('CONIPI', varBoolean) Then
        Begin
          If (fEmptyStr(VS_strClaID1)) Then
          Begin
            fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
            Result := False;
          End
          Else If (fEmptyStr(VS_strClaID2)) Then
          Begin
            fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
            Result := False;
          End
          Else If (fEmptyStr(VS_strClaID3)) Then
          Begin
            fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
            Result := False;
          End;
        End
        Else
        Begin
          If VS_strTipOpeTe = '3' Then
          Begin
            If (fEmptyStr(VS_strCLTDFT)) Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de depósito fechado no cadastro de empresas!', ['&Ok']);
              Result := False;
            End
            Else If (fEmptyStr(VS_strCLTDFC)) Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de depósito fechado no cadastro de empresas!', ['&Ok']);
              Result := False;
            End
            Else If (fEmptyStr(VS_strCLTDFS)) Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de depósito fechado no cadastro de empresas!', ['&Ok']);
              Result := False;
            End
          End
          Else
          Begin
            If (fEmptyStr(VS_strClaT01)) Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
              Result := False;
            End
            Else If (fEmptyStr(VS_strClaT02)) Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
              Result := False;
            End
            Else If (fEmptyStr(VS_strClaT03)) Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
              Result := False;
            End
            Else If (fEmptyStr(VS_strClaT04)) And (fatVenda.strTipEmiTe = 'V') Then
            Begin
              fMensagem('', 'É necessário configurar as classificações para transferência de estoque no cadastro de empresas!', ['&Ok']);
              Result := False;
            End;
          End;
        End;

      End;

      {**************************************************************}
      {* VERIFICA SE PERMITE ENTREGA FUTURA PARA CLIENTE CONSUMIDOR *}
      {***********************************************************RV*}
      If Result And (fCfgSis('PEFCON', varString, fGetEmpConfigEntrega) = 'N') And
         (fClienteConsumidor(fatVenda.strCliOri, False, True)) And (Pos(strOpcDoc, 'VN_CS_PD_OR_' ) > 0) Then
      Begin
        If fVerificaItensComEntregaFutura Then
        Begin
          fMensagem('ATENÇÃO!', 'Não é permitido Entrega Futura para Cliente Consumidor!' + #13 +
                                'Faça as correções no(s) produto(s) antes de trocar de Cliente!', ['&O k']);
          edtCodCli.Text := strCliAnt;
          edtNomCli.Text := fRetNomCliente(strCliAnt);
          Result := False;
        End;
      End;

      If Result And (Pos(strOpcDoc,'OR_PD_') > 0) And fUsaRotinaWMS(VS_strCodEmp) And (strAKZCliPed = edtCodCli.Text) then
      Begin
         Result := fCarregaConfiguracoesAKZNobel;
         If Result Then
         Begin
           fatVenda.strOriGor := 'AKZO NOBEL';
           fMensagem('ATENÇÃO!', 'O cliente selecionado é BROKER "AKZO NOBEL"' + #13 +
                                 'Esse pedido será recalculado na expedição conforme configurações.', ['&O k']);
         End;
      End
      Else
         fatVenda.strOriGor := 'AUTCOM';

      {****************************************************************}
      {* VERIFICA SE PERMITE ENTREGA IMEDIATA PARA CLIENTE CONSUMIDOR *}
      {*************************************************************FC*}
      If Result And (fCfgSis('PEICON', varString, fGetEmpConfigEntrega) = 'N') And (fClienteConsumidor(fatVenda.strCliOri, False, True)) And (Pos(strOpcDoc, 'VN_CS_PD_OR_' ) > 0) Then
      Begin
        If fVerificaItensComEntregaImediata Then
        Begin
          fMensagem('ATENÇÃO!', 'Não é permitido Entrega Imediata para Cliente Consumidor!' + #13 +
                                'Faça as correções no(s) produto(s) antes de trocar de Cliente!', ['&O k']);
          edtCodCli.Text := strCliAnt;
          edtNomCli.Text := fRetNomCliente(strCliAnt);
          Result := False;
        End;
      End;

      If Result And qryConCli.FieldByName('CLI_CODCLI').IsNull Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse cliente não está cadastrado!', ['&O k']);
        Result := False;
      End;

      pMostrarDadosFazendaRodape(False);

      If Result And (fCfgSis('CADFAZ', VarString) = 'S') And (Pos(strOpcDoc, 'CP_CF_CI_') <= 0) Then
      Begin
        Result := fatVenda.fSelecionarFazendaCliente(edtCodCli.Text);
        pMostrarDadosFazendaRodape(Result);
      End;

      pMostrarDadosEmbarcacaoRodape((fatVenda.fClientePossuiEmbarcacoes()) And (fatVenda.fSelecionarEmbarcacao()));

      {*****************************************}
      {* TRANSFERENCIA DE ESTOQUE PERMITIDA    *}
      {* SOMENTE PARA CLIENTE FILIAL           *}
      {**************************************MV*}
      If Result And (strOpcDoc = 'TE') And (Not fatVenda.blnCliFil) Then
      Begin
        fMensagem('ATENÇÃO!', 'Transferência de Estoque permitida somente para cliente filial!', ['&O k']);
        Result := False;
      End;

      If (Result) And (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And (fatVenda.blnCliFil) And (fRetornaClienteFilial(VS_strCodEmp) <> edtCodCli.Text) Then
      Begin
        If (Not fPermiteTransfEntreEmps(VS_strCodEmp, fRetCodEmpClienteFilial(edtCodCli.Text))) Then
        Begin
          fMensagem('ATENÇÃO!', 'Transferência de Estoque não permitida para este cliente!', ['&O k']);
          Result := False;
        End;
      End;

      {*******************************************}
      {* VERIFICA SE É PERMITIDO A TRANSFERÊNCIA *}
      {* PARA O CLIENTE FILIAL ESCOLHIDO         *}
      {****************************************RV*}
      If Result And (strOpcDoc = 'TE') And (fatVenda.blnCliFil) And (fatVenda.strPerEmpTe <> 'S') Then
      Begin

        If (fRetornaClienteFilial(VS_strCodEmp) = edtCodCli.Text) And
           (Not blnLib_TE)                                        Then
        Begin
          objLiberacao.Clear;
          objLiberacao.objMsgLibera.pAddTexto('Liberação para efetuar transferência de estoque para a própria Loja');

          objLiberacao.strDirAce := 'SENPEM';
          objLiberacao.strSenLib := fCfgSis('SENPEM');
          objLiberacao.strMsgSen := 'Transferência de Estoque não permitida para a própria loja';
          objLiberacao.strCodOpe := IIF(fEmptyStr(FatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
          objLiberacao.strCodDig := fatVenda.strCodDig;
          objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
          objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

          If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
            Result := False
          Else
          Begin
            blnLib_TE := True;

            If blnLibMsg Then
              fMensagem('ATENÇÃO!','Você está emitindo um documento para sua própria loja, confirme com seu' + #13#10 +
                                   'gerente se o procedimento está correto, pois será solicitado' + #13#10 +
                                   'senha de liberação no fechamento do documento!', ['&O k']);
          End;
        End
        Else If (Not blnLib_TE) Then
        Begin
          fMensagem('ATENÇÃO!', 'Transferência de Estoque não permitida para este cliente!', ['&O k']);
          Result := False;
        End;
      End;

      {*******************************************}
      {* CONFIRMAÇÃO DE TRANSFERÊNCIA PERMITIDA  *}
      {* SOMENTE PARA CIENTE FILIAL              *}
      {****************************************MV*}
      If Result And (strOpcDoc = 'CT') And (Not fatVenda.blnCliFil) Then
      Begin
        fMensagem('ATENÇÃO!', 'Confirmação de Transferência de Estoque permitida somente para cliente filial!', ['&O k']);
        Result := False;
      End;

      If Result And (strOpcDoc = 'CI') And fEmptyStr( fatvenda.strCliIes ) And (Length(fatVenda.strCliCgc) > 11) And (fCfgSis('CI_IES', varString) = 'S') Then
      Begin
        fMensagem('ATENÇÃO!', 'Cliente sem inscrição estadual para emissão de NF de confirmação ', ['&O k']);
        Result := False;
      End;

      {*****************************************}
      {* UTILIZAÇÃO DE CLIENTE FILIAL SOMENTE  *}
      {* PARA TRANSFERENCIA DE ESTOQUE         *}
      {**************************************MA*}
      If Result And (fatVenda.fClienteFilialVenda(edtCodCli.Text)) And (Pos( strOpcDoc, 'CP_NP_TE_VN_CS_VS_CT_PD_OR_OU_OV_BR_UC_NC_OE_EF_NE_DV_PA_' ) <= 0) Then
      Begin
        fMensagem('ATENÇÃO!', 'A Utilização de Cliente Filial é permitido somente para' + #13#10 +
                  'Transferência de Estoque, Ativo Imobilizado, Pedido, Orçamento e Devolução!', ['&O k']);
        Result := False;
      End
      else If Result And
              (not fClienteConsumidor(qryConCli.FieldByName('CLI_NOMCLI').AsString, true, True)) and
              (Pos(strOpcDoc,'OR_PD_VN_') > 0) And
              (fatVenda.intCgcCpf = 1) and
              (not TConsultaCadastroFit.VerificaSituacaoRegular(fatVenda.strCodCli, True)) Then
      begin
        Result := False;
      end

      {******************************************}
      {* A REGIAO DO CLIENTE É OBRIGATORIO      *}
      {* A REGIAO É UTILIZADA NO VALOR DO FRETE *}
      {***************************************AC*}
      Else If fEmptyStr(fatVenda.strCodReg) And (Pos(strOpcDoc,'OR_PD_VN_CP_') > 0) And (fCfgSis('TAXENT', VarString) = 'S') Then
      Begin
        fMensagem('ATENÇÃO!', 'Favor cadastrar uma Região para o Cliente,' + #13#10 +
                              'importante para o cálculo do valor de entrega!', ['&O k']);
        Result := False;
      End
      {******************************************}
      {* A REGIAO DO CLIENTE É OBRIGATORIO      *}
      {* A REGIAO É UTILIZADA NO VALOR DO FRETE *}
      {***************************************AC*}
      Else If fEmptyStr(fRetNomRegiao(fatVenda.strCodReg)) And (Pos(strOpcDoc,'OR_PD_VN_CP_') > 0) And (fCfgSis('TAXENT', VarString) = 'S') Then
      Begin
        fMensagem('ATENÇÃO!', 'Essa Região não está cadastrada!', ['&O k']);
        Result := False;
      End
      {******************************************}
      {* VERIFICA SE FOR ENTREGA POR REGIAO     *}
      {* SE A FAIXA DE HORARIOS ESTA CADASTRADA *}
      {***************************************AC*}
      Else If (Not fatVenda.fFaixaHorarioRegiaoPreenchida) And (Pos(strOpcDoc,'OR_PD_VN_CP_') > 0) And (fCfgSis('TAXENT', VarString) = 'S') Then
      Begin
        fMensagem('ATENÇÃO!', 'Para calcular o valor do frete de acordo com a região do cliente,' + #13#10 +
                              'é preciso cadastrar a faixa de horários da região, para o sistema poder' + #13#10 +
                              'verificar se o frete será cobrado novamente ou não!' + #13#10 +
                              'Para cadastrar vá em : Principal --> Manutenção de Cadastros --> ' + #13#10 +
                              'Auxiliares --> Regiões (Botão F3)', ['&O k']);
        Result := False;
      End;

      If (Result) And (fAvisoClienteForaDoEstado) Then
        fMensagem('ATENÇÃO!', 'Cliente fora do Estado!' + #13 + 'Atenção aos possíveis impostos adicionais que serão cobrados no faturamento.', ['&Ok']);

      If Result And fatVenda.fEhAutocenter And pnlPlacaVeiculo.Visible Then
      Begin
        blnCarregarPlacaCliente := True;

        If fVeiculoInativo(fatVenda.strPlaVei) Then
        Begin
          edtDesVei.Text := '';
          fMensagem('','Este veículo está inativo.',['&O k']);
          Result := False;
          blnCarregarPlacaCliente := False;
        End
        Else
        Begin
          If (Not fEmptyStr(mskPlaVei.Text)) And (Not fEmptyStr(fatVenda.strPlaVei)) And
             (Not fVeiculoRelacionadoAoCliente(mskPlaVei.Text, edtCodCli.Text)) And
             (Not fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) And
             ((Not fCfgSis('PLAGEN', varBoolean) Or
             ((fCfgSis('PLAGEN', varBoolean)) And (Not (Sametext(mskPlaVei.Text, fCfgSis('PLACA_', varString))))))) Then
          Begin
            If fMensagem('', 'Veículo ' + fatVenda.strPlaVei + ' não cadastrado para este cliente.' + #13#10 +
                             'Deseja cadastrar o veículo para o cliente?', ['&Sim', '&Não'], 2) = 1 Then
            Begin
              objCliVei := TCliVei.Create(Self);
              objCliVei.strCodCli := fatVenda.strCodCli;
              objCliVei.strPlaVei := fatVenda.strPlaVei;
              objCliVei.strVeiAti := 'S';
              objCliVei.pInsereCliVei;
              objCliVei.Destroy;
            End
            Else
            Begin
              mskPlaVei.Clear;
              edtDesVei.Clear;
              edtKM_Vei.Clear;

              fatVenda.strPlaVei      := EmptyStr;
              fatVenda.strKM_Vei      := EmptyStr;
              blnCarregarPlacaCliente := False;
            End;
          End;
        End;

        If blnCarregarPlacaCliente Then
          pCarregarPlacaCliente
      End;

      If Result Then
        Result := fPermiteVendaCNPJouCPF(edtCodCli.Text, IIF(pnlEmpresa.Visible, edtCodEmp.Text, VS_strCodEmp));

      fatVenda.strCliCon := qryConCli.FieldByName('CLI_CONSUM').AsString; //         - Consumidor Final (S/N)

      intWidthDesCndInicial := edtDesCndPag.Width;
      blnEstaAlterandoQuantidade := False;

      If (Result And fatVenda.blnCliFil And (Pos(strOpcDoc,'UC_NC_DV_PA_') <= 0)) Or (strOpcDoc = 'CT') Then
        pCarregaTela(False,'TE')
      Else
        pCarregaTela(False);

      //*************************************************//
      // NAS CONFIGURACOES DO SISTEMA FAT3, EXISTE UMA   //
      // CONFIGURACAO PARA DESABILITAR O DESCONTO ITEM A //
      // ITEM.                                           //
      //**********************************************ED*//
      pEditarDesconto;
      pEditarPrecoUnitario;

      If Result Then
      Begin
        If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
           (fCfgSis('CLIBEN', varString) = 'S') And
           (Not fatVenda.blnCliFil) And
           (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
        Begin
          pCriarFormularios(TfrmClienteResumo, frmClienteResumo);

          Try
            If frmClienteResumo.fCarregaResumo(fatVenda.strCodCli, fRetDesTipoAbf('C', fatVenda.strCodCli)) Then
              frmClienteResumo.ShowModal;
          Finally
            FreeAndNil(frmClienteResumo);
          End;
        End;
      End;

      If Result Then
      Begin

        If ( blnBuscaPorChave ) And (Not blnCarregandoAutSer) And (Not SameText(strOpcDoc, 'PA')) Then
        Begin
          pMostraObsCliente;

          If Pos(fatVenda.strOpcDoc, 'PD_OR_VN_') > 0 Then
            TFatVenda.pMensagemGarantiaEnvioCliente(qryConCli.FieldByName('CLI_CODCLI').AsString);
        End;

        If (Not fatVenda.blnCliFil) And
           (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
        Begin
          Result := fatVenda.fDebitoCliente('', '', 1);
        End;

      End;

      //*************************************************//
      // VERIFICA SE EH PERMITIDO ALTERAR OS VENDEDORES, //
      // NO ATO DO FATURAMENTO                           //
      //**********************************************ED*//
      If not ((strOpcDoc = 'DV') And (not fEmptyStr(edtSenVen.Text)) And edtSenVen.ReadOnly And (fClienteConsumidor(fRetNomCliente(strCliForDev), False, True))) Then
        pVerificaAlterarVendedor(qryConCli.FieldByName('CLI_CODVEN').AsString, qryConCli.FieldByName('CLI_CODREP').AsString, True);

      If Result Then
      Begin
        If (fCfgSis('UTDTFE', VarString) = 'S') And (fCfgSis('EXIDTE', VarString) = 'S') Then
          If Not fEmptyStr(fMsgFaixasHorariosEntregaCliente(qryConCli.FieldByName('CLI_CODCLI').AsString)) Then
            pMensagemSonora(fMsgFaixasHorariosEntregaCliente(qryConCli.FieldByName('CLI_CODCLI').AsString), False, 13);

        pMostraLimiteCredito;
        pMostraCreditoCashBack;

        {************************************}
        {* VERIFICA DIAS DE NAO COMPRA      *}
        {*----------------------------------*}
        {* ESTA FUNCAO NAO PODE FICAR ACIMA *}
        {* DA FUNCAO fDebitoCliente, DEVIDO *}
        {* A ALIMENTACAO DE VARIAVEIS USADA *}
        {* PELA FUNCAO fVerificaNaoCompra.  *}
        {*********************************WI*}
        With fatVenda Do
        Begin
          {*********************************************************************}
          {* SE USA PERFIL E A CONDIÇÃO É NO FINAL NÃO PODE TRAVAR AO TROCAR O *}
          {* CLIENTE POIS AINDA NÃO SE SABE SE A CONDIÇÃO DE PAGAMENTO USADA   *}
          {* ESTÁ CONFIGURADA PARA TRAVAR OS DIAS QUE NÃO COMPRA               *}
          {****************************************************REQ.:224643***VA*}
          If (fCfgSis('PFLCLI', varString) = 'S') And (fCfgSis('CNDVEN', varString) = 'F') Then
            blnCndTravaCli := False
          Else
            blnCndTravaCli := (fRetTraCliConPag(fatVenda.strCodCnd) = 'S');

          If (Not blnCliFil) And
            IIF(fatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(blnCndTravaCli, fStatusCndPag(fatVenda.strConPag), False),(Not blnTravaNaoCompra), True) Then
              Result := fVerificaNaoCompra(blnTravaNaoCompra, fRetCodVenDef(edtSenVen.Text), '', True, fatVenda.fExecutaTravaNaoCompra);
        End;

        If Result Then
        Begin

          {*****************************************}
          {* CALCULA FATOR REFERENTE À MEDIA DA    *}
          {* CONDIÇÃO DE PAGAMENTO                 *}
          {**************************************MV*}
          fatVenda.pCalculaTaxVpr;

          If fCfgSis('CNDVEN') = 'F' Then
          Begin
            fatVenda.fltTaxJur := 0;
            fatVenda.fltTaxVpr := 0;
          End;

          pAtualizaUnitarioLiquido;

          {*****************************************}
          {* RECALCULA OS PREÇOS                   *}
          {**************************************MV*}
          If (fEmptyStr(fatVenda.strCodCli) Or (strCliAnt <> edtCodCli.Text)) And
             (Pos(strOpcDoc, 'DV_PR_DD_') <= 0) And (Not fatVenda.fEhDevolucaoEspelhoOuParaFornecedor) Then
          Begin
            If (Not fEmptyStr(strNumOrc)) And (fClienteConsumidor(fRetNomCliente(strCliAnt), True, True)) Then
            Begin
              fatVenda.stlItensNaoTemPromocao.Clear;
              fatVenda.stlItensTemPromocao.Clear;
            End;

            {*****************************************}
            {* SÓ RECALCULA SE MUDAR DE TABELA.      *}
            {**************************************MV*}
            If (strTabPreAnt <> fatVenda.strTabPre)                     Or
               (fCfgSis('RECACL', varString) = 'S')                     Or
               (Pos(strOpcDoc, 'CI_CF_') > 0)                           Or
               (fRetDescontoCliente(strCliAnt) > 0)                     Or
               (fRetDescontoCliente(edtCodCli.Text) > 0)                Or
               (fClienteFilial(strCliAnt))                              Or
               (fClienteFilial(edtCodCli.Text))                         Or
               (fEmptyStr(strCliAnt))                                   Or
               (fTemAlgumProdutoComPromocaoParaCliente(strCliAnt))      Or
               (fTemAlgumProdutoComPromocaoParaCliente(edtCodCli.Text)) Or
               (fTemAlgumProdutoComPromocaoRestritaNaoConsumidor And fClienteConsumidor(fRetNomCliente(strCliAnt), True, True)) Or
               (fTemAlgumProdutoComPromocaoRestritaNaoConsumidor And fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) Or
               (fRecalculaPrecoDinamico(strCliAnt, edtCodCli.Text)) Then
            Begin

              blnManterPrecosDigitados  := False;
              blnAlterarTabelaPrecoItem := True;

              {Req.: 101971 Manter preços}
              If (strCliAnt <> edtCodCli.Text)     And
                 (Pos(strEspOrc, 'OR_PD_') > 0)    And
                 (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
                 (fCfgSis('TRCLTB', varString) = 'S') And //Quando trocar o cliente na alteração ou faturamento de um orçamento/pedido, manter a tabela de preço do documento original?
                 (fCfgSis('TABITE', varString) = 'S') And
                 (fCfgSis('UTAPTB', varString) = '0') Then
              Begin
                blnManterPrecosDigitados  := True;
                blnAlterarTabelaPrecoItem := False;
              End;

              pRecalculaPrecos(False,
                               blnAlterarTabelaPrecoItem,
                               fAplicarDescProfissNosItensAoTrocarCliente,
                               True,
                               '',
                               False,
                               False,
                               False,
                               blnManterPrecosDigitados,
                               fPrecoUnitarioJaPossuiPossuiDescontoProfissionalAplicado);

              pCalculaTotais;
              pEnabledFechamento(True);

              If Pos(strOpcDoc, 'VN_CS_PD_OR_') > 0 Then
                blnComVen := True;

              dbgItens.Repaint;
            End;
          End;

        End;

      End;

      If Result Then
      Begin
        pnlInfo.Caption := '';

        If (fClienteConsumidor(qryConCli.FieldByName('CLI_NOMCLI').AsString, False, True)) And
           (Pos(strOpcDoc,'CF_CI_CN_CT_CP_OV_') <= 0) And
           (Not  blnCarregandoAutSer) Then
        Begin

          If (Not fatVenda.blnGraCon) Then
          Begin

            If (fExibeTelaComDadosDoConsumidor) Then
              Result := fDadosCons
            Else If fAlteraNomeConsumidorTelaDeVendas(strOpcDoc) Then
            Begin
              edtNomCli.Enabled := True;
              edtNomCli.ReadOnly := False;
              edtNomCli.TabStop := True;
              edtNomCli.Color := clWindow;
            End;

            If Result And fatVenda.blnUtilizarPreCadastroConsumidor And (Not fEmptyStr(fatVenda.strCodCliPreCadastro)) Then
            Begin
              edtCodCli.Text := fatVenda.strCodCliPreCadastro;
              fatVenda.strCodCliPreCadastro := '';
              fatVenda.blnGraCon := False;
              Result := fValidaCampos(edtCodCli, blnBuscaPorChave);
              Exit;
            End;

            If Result Then
            Begin
              fatVenda.blnGraCon := True;
              fatVenda.strConPag := '01000';
              mskCndPag.Text     := '01000';
              mskCndPag.Enabled  := False;
            End
            Else
            Begin
              fatVenda.blnGraCon := False;
              Result             := False;
            End;

            pSetFocus(Self);

          End;

        End
        Else
        Begin

          If blnHabilitaCndPag Then
            If Not ( fCfgSis('USACND', varBoolean) ) And (Not fatVenda.blnMeiaNota) Then
              mskCndPag.Enabled := True;
        End;

        pInformacoesClienteRodape;

        If Result Then
        Begin
          {*****************************************}
          {* SE FOR CONFIRMAÇÃO DE DOCUMENTOS      *}
          {**************************************MV*}
          If (strOpcDoc = 'CF') Then
          Begin
            edtCodCli.Enabled := False;
            InterlockedIncrement(intConfirmando);

            objConfDocs := TConfirmacaoDocumentos.CreateInstance(Self, fatVenda);

            {*****************************************}
            {* SE NÃO CONFIRMAR, NÃO FAZ NADA        *}
            {**************************************MV*}
            blnBaixouDocumentos := False;
            blnErroValidacao := False;
            If (Not fConfirmaMI(objConfDocs, blnBaixouDocumentos, blnErroValidacao)) Then
            Begin
              Result := False;
              If (Not blnErroValidacao) Then
                edtCodCli.Enabled := True;
            End
            else
            begin
              blnChamouTelaCOnfirmacao := True;
            end;
            {*****************************************}
            {* CASO CONFIRMAR OS DOCUMENTOS, CARREGA *}
            {* OS ITENS NA TELA                      *}
            {**************************************MV*}
            If Result Then
            Begin
              If (Not blnBaixouDocumentos) Then
              Begin
                {***************************************************************}
                {* VERIFICA NA CONFIRMAÇÃO SE O CLIENTE PARA O QUAL ESTÁ SENDO *}
                {* CONFIRMADOS OS DOCS É CLIENTE CONSUMIDOR                    *}
                {************************************************************LU*}
                If (fClienteConsumidor(qryConCli.FieldByName('CLI_NOMCLI').AsString, False, True)) Then
                Begin
                  pInformacoesClienteRodape;

                  If (Not fatVenda.blnGraCon) Then
                  Begin
                    If fDadosCons Then
                    Begin
                      if (fCfgSis('PRECAD', varBoolean) and fCfgSis('PRPCCF', varBoolean)) then
                      begin
                        if Trim(fatVenda.strCodCliPreCadastro) <> '' then
                        begin
                          edtCodCli.Text := fatVenda.strCodCliPreCadastro;
                          pCarregaCliente;
                        end;
                      end;
                      fatVenda.blnGraCon := True;
                      fatVenda.strConPag := '01000';
                      mskCndPag.Text     := '01000';
                      mskCndPag.Enabled  := False;
                    End
                    Else
                      fatVenda.blnGraCon := False;

                    pSetFocus(Self);
                  End;

                End;

                Result := fCarregaItensConfirmacao(objConfDocs);
                FreeAndNil(objConfDocs);

                blnMudarFoco           := False;
                pHabilitaCamposItem(False);
                dbgItens.Enabled       := False;
                btnAdicionar.Enabled   := False;
                btnCancelaItem.Enabled := False;
                pEnabledFechamento(True);

