procedure TfrmFatVendas.pCarregarItensRemessaOS;
  Var
    objIteEnt: TItensEntrada;

    strStatus,
    strSubsta,
    strSituac,
    strFone  : String;
    arrSel   : TConsultasArray;
    intOpcoes: Integer;
    objfrmPnl: TPanelCxConsertoEquip;
    dtaOS    : TDatetime;
    qryEquGer: TUniQuery;
    chrKey: Char;
    strAutIncOsSel: String;

  function fFone: String; begin
    Result := ' IF(IFNULL(EQU_NOMCON, "") <> "", EQU_TELCON, CLI_FONE01) ';
  end;

  function fGetAutincArraySel(arrOrdServs: TConsultasArray): String;
    Var
      i: Integer;
  begin
    Result := '';

    If (Length(arrOrdServs) = 0) Then Exit;

    Result := arrOrdServs[0].strCodigo;

    For i := 1 To Length(arrOrdServs) - 1 Do Begin
      Result := Result + ', ' + arrOrdServs[i].strCodigo;
    End;
  end;

  function fGetAutIncItensOsSel(arrOrdServs: TConsultasArray): String;
    Var
      qryTemp: TUniQuery;
      strTemp: String;
  begin
    Result  := '';
    strTemp := fGetAutincArraySel(arrOrdServs);

    If (fEmptyStr(strTemp)) Then Exit;

    Try
      qryTemp := fCriaQuery(Self);

      Try
        qryTemp.Close();
        qryTemp.SQL.Clear();
        qryTemp.SQL.Text := 'SELECT DISTINCT ' +
                            '  D.AUTOINCREM, ' +
                            '  "XML" AS ORIGEM ' +
                            'FROM ' +
                            '  MOVGER G ' +
                            '  INNER JOIN MOVDET D ' +
                            '    ON G.AUTOINCREM = D.DET_SEQGER ' +
                            '  INNER JOIN MEQMER M ' +
                            '    ON M.MER_AUTGER = G.AUTOINCREM ' +
                            '    AND M.MER_TIPOPE = "E" ' +
                            'WHERE M.MER_AUTEQU IN ( ' + strTemp + ' ) ' +
                            '  AND IFNULL(M.MER_ACESSO, "") <> "" ' +
                            '  AND M.MER_AUTDET = D.AUTOINCREM ' +
                            'UNION ALL ' +
                            'SELECT DISTINCT ' +
                            '  D.AUTOINCREM, ' +
                            '  "MANUAL" AS ORIGEM ' +
                            'FROM ' +
                            '  MOVGER G ' +
                            '  INNER JOIN MOVDET D ' +
                            '    ON G.AUTOINCREM = D.DET_SEQGER ' +
                            '  INNER JOIN MEQMER M ' +
                            '    ON M.MER_AUTGER = G.AUTOINCREM ' +
                            '    AND M.MER_TIPOPE = "E" ' +
                            'WHERE M.MER_AUTEQU IN ( ' + strTemp + ' ) ' +
                            '  AND IFNULL(M.MER_ACESSO, "") = "" ';
        qryTemp.Open();

        If (Not qryTemp.IsEmpty) Then Begin
          qryTemp.First();

          Result := qryTemp.FieldByName('AUTOINCREM').AsString;

          qryTemp.Next();

          While (Not qryTemp.Eof) Do Begin
            Result := Result + ', ' + qryTemp.FieldByName('AUTOINCREM').AsString;

            qryTemp.Next();
          End;
        End;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, 'TfrmFatVendas.pCarregarItensRemessaOS.fGetAutIncItensOsSel');
      End;
    Finally
      FreeAndNil(qryTemp);
    End;
  end;

  procedure pPreencheVinculosMeqMerSai(strAutIncOs: String);
    Var
      qryTemp: TUniQuery;
      objMeqMer: TMeqMer;
  begin
    If (fEmptyStr(strAutIncOs)) Then Exit;

    Try
      qryTemp := fCriaQuery(Self);

      Try
        qryTemp.Close();
        qryTemp.SQL.Clear();
        qryTemp.SQL.Text := 'SELECT ' +
                            '  AUTOINCREM AS AUTEQU, ' +
                            '  EQU_CODEMP AS EMPEQU, ' +
                            '  EQU_NUMOSE AS NUMOSE, ' +
                            '  "" AS AUTGER, ' +
                            '  "" AS NUMDOC, ' +
                            '  "" AS ESPDOC, ' +
                            '  "" AS EMPGER, ' +
                            '  "" AS SERIE_, ' +
                            '  EQU_CODCLI AS CODCLI, ' +
                            '  "S" AS TIPOPE, ' +
                            '  CURRENT_DATE AS DTAGER, ' +
                            '  "" AS ACESSO, ' +
                            '  "" AS NCMEQU, ' +
                            '  "" AS AUTDET ' +
                            'FROM ' +
                            '  EQUGER ' +
                            'WHERE AUTOINCREM IN ( ' + strAutIncOs + ' ) ' +
                            'GROUP BY AUTOINCREM ';
        qryTemp.Open();

        If (Not qryTemp.IsEmpty) Then Begin
          qryTemp.First();

          fatVenda.lstMeqMerSai.Clear();

          While (Not qryTemp.Eof) Do Begin
            objMeqMer := TMeqMer.Create();

            objMeqMer.strAutInc := '';
            objMeqMer.strAutEqu := qryTemp.FieldByName('AUTEQU').AsString;
            objMeqMer.strEmpEqu := qryTemp.FieldByName('EMPEQU').AsString;
            objMeqMer.strNumOse := qryTemp.FieldByName('NUMOSE').AsString;
            objMeqMer.strAutGer := '';
            objMeqMer.strNumDoc := '';
            objMeqMer.strEspDoc := '';
            objMeqMer.strEmpGer := '';
            objMeqMer.strSerie_ := '';
            objMeqMer.strCodCli := qryTemp.FieldByName('CODCLI').AsString;
            objMeqMer.strTipOpe := qryTemp.FieldByName('TIPOPE').AsString;
            objMeqMer.dtaDtaGer := qryTemp.FieldByName('DTAGER').AsDateTime;
            objMeqMer.strChaveAcesso := '';
            objMeqMer.strAutDet := '';
            objMeqMer.strNCMEqu := '';
            objMeqMer.intIdxIteSel := -1;

            fatVenda.lstMeqMerSai.Add(objMeqMer);

            qryTemp.Next();
          End;
        End;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, 'TfrmFatVendas.pCarregarItensRemessaOS.fGetAutIncItensOsSel');
      End;
    Finally
      FreeAndNil(qryTemp);
    End;
  end;

begin

  If (Not mnuCarEquipManOS.Visible) Then Exit;

  If (cdsVenda.RecordCount > 0) Then Begin
    fMensagem('ALERTA','Não é permitido itens inseridos manualmente para emissão de saída de remessa de equipamento pelo carregamento de Ordem de Serviço.' + #13#10 + 'Operação cancelada!',['&OK']);
    Exit;
  End;

  If (Not fValidaCampos(edtCodCli, True)) Then
    Exit;

  strStatus := SELECT_STATUS_OS;
  strSubsta := SELECT_SUBSTA_OS;
  strSituac := SELECT_SITUAC_OS;
  strFone   := fFone;

  chrKey    := '/';

  If (Not fCfgSis('OSRENF', varBoolean)) Then
    intOpcoes := 4
  Else
    intOpcoes := 5;

  Try
    objfrmPnl := TPanelCxConsertoEquip.Create(TfrmPnlLegendaConsertoEquip);
    qryEquGer := fCriaQuery(Self);

    If fPesqOrdServ(Self,
                    Nil,
                    qryEquGer,
                    chrKey,
                    arrSel,
                    dtaOS,
                    strStatus,
                    strFone,
                    False,
                    'Consulta de Ordens de Serviço',
                    intOpcoes,
                    strSubsta,
                    strSituac,
                    objfrmPnl,
                    fatVenda.strCodCli,
                    '',
                    True) Then
    Begin
      If (Length(arrSel) > 0) Then Begin
        Try
          objIteEnt := TItensEntrada.Create;

          strAutIncOsSel := fGetAutIncItensOsSel(arrSel);

          If (fEmptyStr(strAutIncOsSel)) Then Begin
            fMensagem('ALERTA','Nenhum item foi encontrado a partir das Ordens de Serviço selecionadas. Operação cancelada!',['&OK']);
          End Else If (objIteEnt.fCarregaItensOrdemServico(pgbProgresso, fIncluirItem, strAutIncOsSel, fatVenda.strEmpDoc)) Then Begin
            pnlDadosItem.Enabled := False;
            dbgItens.Enabled     := False;
            mnuCarEquipManOS.Visible := False;

            pPreencheVinculosMeqMerSai(fGetAutincArraySel(arrSel)); //arrMeqMerEnt
          End;
        Finally
          FreeAndNil(objIteEnt);
        End;
      End;
    End;
  Finally
    FreeAndNil(qryEquGer);
    FreeAndNil(objfrmPnl);
  End;
end;

