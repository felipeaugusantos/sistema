procedure TfrmFatVendas.mnuNumCmpClick(
  Sender: TObject);
  Var
    prcScroll: TprcScroll;
begin
  inherited;

  If Not fVerificaAcessoSistema('INFPCI') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Informar Pedido de Compra dos Itens!', ['&O k']);
    Exit;
  End;

  If Not mnuNumCmp.Visible Then
    Exit;

  Try
    pCriarFormularios(TfrmFatDigPedidoCompraItens, frmFatDigPedidoCompraItens);
    frmFatDigPedidoCompraItens.cdsDados.Data := cdsVenda.Data;
    frmFatDigPedidoCompraItens.cdsDados.LogChanges := False;
    pFiltraCdsSemItemServico(frmFatDigPedidoCompraItens.cdsDados);

    frmFatDigPedidoCompraItens.strCodCli     := fatVenda.strCodCli;
    frmFatDigPedidoCompraItens.strCodVen     := fatVenda.strCodVen;
    frmFatDigPedidoCompraItens.strNumDoc     := strNumOrc;
    frmFatDigPedidoCompraItens.strEspDoc     := strEspOrc;
    frmFatDigPedidoCompraItens.strCodEmp     := strEmpOrc;

    If frmFatDigPedidoCompraItens.ShowModal = mrOK Then
    Begin
      Try
        pDisableControls(cdsVenda, prcScroll);
        intRecNo := cdsVenda.RecNo;

        With frmFatDigPedidoCompraItens.cdsDados Do
        Begin
          First;
          While Not Eof Do
          Begin
            If cdsVenda.Locate('AUTOINCREM', FieldByName('AUTOINCREM').AsInteger, []) Then
            Begin
              cdsVenda.Edit;
              cdsVenda.FieldByName('ITE_NUMCMP').Value := FieldByName('ITE_NUMCMP').Value;
              cdsVenda.FieldByName('ITE_NITCMP').Value := FieldByName('ITE_NITCMP').Value;
              cdsVenda.FieldByName('ITE_COD_NF').AsString := FieldByName('ITE_COD_NF').AsString;
              cdsVenda.FieldByName('ITE_DES_NF').AsString := FieldByName('ITE_DES_NF').AsString;
              cdsVenda.FieldByName('ITE_CLIBAR').AsString := FieldByName('ITE_CLIBAR').AsString;
              cdsVenda.FieldByName('ITE_NUMPLA').AsString := FieldByName('ITE_NUMPLA').AsString;
              cdsVenda.FieldByName('ITE_PARNUM').AsString := FieldByName('ITE_PARNUM').AsString;
              cdsVenda.FieldByName('ITE_REQCOM').AsString := FieldByName('ITE_REQCOM').AsString;
              cdsVenda.FieldByName('ITE_DESNES').AsString := FieldByName('ITE_DESNES').AsString;
              cdsVenda.FieldByName('ITE_DTACMP').Value := FieldByName('ITE_DTACMP').Value;

              cdsVenda.Post;
            End;
            Next;
          End;
        End;

      Finally
        cdsVenda.RecNo := intRecNo;
        pEnableControls(cdsVenda, prcScroll);
      End;
    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;

  pFreeAndNil(frmFatDigPedidoCompraItens);
end;

procedure TfrmFatVendas.mnuNumeroSerieItensClick(Sender: TObject);
  var
    frmFatItensSerie: TfrmFatItensSerie;
    intRecNo: Integer;
    prcScroll: TprcScroll;
    blnExisteItemControleSerie: Boolean;
    strNumeroSerie: String;
begin
  inherited;
  If cdsVenda.IsEmpty Then
    Exit  ;

  intRecNo := 0;

  pCriarFormularios(TfrmFatItensSerie, frmFatItensSerie);
  frmFatItensSerie.cdsSeries.CreateDataSet;

  Try
    pDisableControls(cdsVenda, prcScroll);
    intRecNo := cdsVenda.RecNo;
    cdsVenda.First;
    frmFatItensSerie.fatVenda := fatVenda;
    While Not cdsVenda.Eof do
    Begin
      If fProdutoUsaNumeroDeSerie(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
      Begin
        frmFatItensSerie.cdsSeries.Append;
        frmFatItensSerie.cdsSeriesCODITE.AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;
        frmFatItensSerie.cdsSeriesDESITE.AsString := cdsVenda.FieldByName('ITE_DESITE').AsString;
        frmFatItensSerie.cdsSeriesCODUNI.AsString := cdsVenda.FieldByName('ITE_SIGUNI').AsString;
        frmFatItensSerie.cdsSeriesCODFAB.AsString := cdsVenda.FieldByName('ITE_CODFAB').AsString;
        frmFatItensSerie.cdsSeriesQUANT.AsFloat   := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
        frmFatItensSerie.cdsSeriesCODEMP.AsString := cdsVenda.FieldByName('ITE_EMPITE').AsString;
        frmFatItensSerie.cdsSeriesAUTOINCREM.AsString := IIF(fEmptyStr(cdsVenda.FieldByName('ITE_SEQDET').AsString), cdsVenda.FieldByName('AUTOINCREM').AsString, cdsVenda.FieldByName('ITE_SEQDET').AsString);

        fatVenda.objFatSerieItem.cdsSeries.Filtered := False;
        fatVenda.objFatSerieItem.cdsSeries.Filter := 'AUTINC = '+ IIF(fEmptyStr(cdsVenda.FieldByName('ITE_SEQDET').AsString), cdsVenda.FieldByName('AUTOINCREM').AsString, cdsVenda.FieldByName('ITE_SEQDET').AsString);
        fatVenda.objFatSerieItem.cdsSeries.Filtered := True;

        If Not fatVenda.objFatSerieItem.cdsSeries.IsEmpty Then
        Begin
          fatVenda.objFatSerieItem.cdsSeries.First;

          strNumeroSerie := EmptyStr;

          While Not fatVenda.objFatSerieItem.cdsSeries.Eof Do
          Begin
            If fEmptyStr(strNumeroSerie) Then
              strNumeroSerie := fatVenda.objFatSerieItem.cdsSeries.FieldByName('NUMSER').AsString
            Else
              strNumeroSerie := strNumeroSerie + ',' + fatVenda.objFatSerieItem.cdsSeries.FieldByName('NUMSER').AsString;

            fatVenda.objFatSerieItem.cdsSeries.Next;
          End;

          frmFatItensSerie.cdsSeriesNUMSER.AsString := strNumeroSerie;
        End;

        frmFatItensSerie.cdsSeries.Post;
      End;

      cdsVenda.Next;
    End;

    fatVenda.objFatSerieItem.cdsSeries.Filtered := False;
    fatVenda.objFatSerieItem.cdsSeries.Filter := EmptyStr;

    blnExisteItemControleSerie := frmFatItensSerie.cdsSeries.IsEmpty;

    If Not blnExisteItemControleSerie Then
    Begin
      frmFatItensSerie.ShowModal;
      pAtualizaMatrizFechamentoComSeriesDigitadas;
    End
    Else
      fMensagem('Aviso', 'Não há itens com controle de número de série!', ['&Ok']);
  Finally
    frmFatItensSerie.cdsSeries.Close;
    cdsVenda.RecNo := intRecNo;
    pEnableControls(cdsVenda, prcScroll);
    pFreeAndNil(frmFatItensSerie);
  End;

end;

