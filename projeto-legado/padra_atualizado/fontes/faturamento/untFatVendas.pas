function TfrmFatVendas.fTabelaMovProVazia: Boolean;
  Var qryTmp: TUniQuery;
Begin

  Result := False;

  qryTmp := fCriaQuery;

  With qryTmp Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('SELECT');
    SQL.Add('  PRO_CODPRO');
    SQL.Add('FROM');
    SQL.Add('  MOVPRO');
    SQL.Add('LIMIT 1');
    Open;

    If IsEmpty Then
      Result := True;

    Close;
  End;

  FreeAndNil(qryTmp);
End;

function TfrmFatVendas.fEspeciePermitidaDevolucao(strEspecie: String): Boolean;
  Var
    cdsDados: TUniClientDataSet;
begin
  cdsDados := TUniClientDataSet.Create(Self);
  Try
    cdsDados.Data := cdsVenda.Data;
    cdsDados.LogChanges := False;

    If (Pos(strEspecie, 'NF_EL_IF_IV_D1_') > 0) Then
    Begin
      cdsDados.Filter   := '(ITE_ESPDEV = ' + QuotedStr('MI') + ')'
                  +' OR '+ '(ITE_ESPDEV = ' + QuotedStr('FF') + ')';
      cdsDados.Filtered := True;
    End
    Else
    Begin
      If qryConCli.FindField('CLI_DESCON') <> Nil Then
        If (qryConCli.FieldByName('CLI_DESCON').AsFloat > 0) And fDescontoClienteProfissional(fatVenda.strCodCli) Then
          blnNaoPermitirMIeFFnaMesmaDevolucao := True;

      cdsDados.Filter   := '(ITE_ESPDEV = ' + QuotedStr('NF') + ')'
                  +' OR '+ '(ITE_ESPDEV = ' + QuotedStr('EL') + ')'
                  +' OR '+ '(ITE_ESPDEV = ' + QuotedStr('IF') + ')';

      If blnNaoPermitirMIeFFnaMesmaDevolucao Then
      Begin
        If strEspecie = 'MI' Then
          cdsDados.Filter := cdsDados.Filter +' OR '+ '(ITE_ESPDEV = ' + QuotedStr('FF') + ')'

        Else If strEspecie = 'FF' Then
          cdsDados.Filter := cdsDados.Filter +' OR '+ '(ITE_ESPDEV = ' + QuotedStr('MI') + ')';
      End;

      cdsDados.Filtered := True;
    End;

    Result := (cdsDados.RecordCount <= 0);
  Finally
    FreeAndNil(cdsDados);
  End;
end;

function TfrmFatVendas.fExisteItensEntregaFutura: Boolean;
Var
  cdsVenTmp: TUniClientDataSet;
begin

  Try

    cdsVenTmp := TUniClientDataSet.Create(Self);
    cdsVenTmp.Data := cdsVenda.Data;
    cdsVenTmp.LogChanges := False;
    cdsVenTmp.Open;
    cdsVenTmp.LogChanges := False;

    With cdsVenTmp Do
    Begin
      First;
      Filter := 'ITE_ENTFUT = ' + QuotedStr('S');
      Filtered := True;
      Result := RecordCount > 0;
    End;

  Finally
    FreeAndNil(cdsVenTmp);
  End;

end;

function TfrmFatVendas.fExisteNumeroSerie(strNumSer,
  strCodIte: string): Boolean;
var
  qryNumeroSerie: TUniQuery;
  strSQL: string;
begin
  try
    strSQL := '';
    strSQL := strSQL + 'SELECT SER_NUMSER ';
    strSQL := strSQL + 'FROM PROSER ';
    strSQL := strSQL + 'WHERE SER_NUMSER = :NUMSER ';
    strSQL := strSQL + 'AND SER_CODITE = :CODITE ';
    strSQL := strSQL + 'AND SER_CODEMP = :CODEMP ';
    strSQL := strSQL + 'AND SER_NUMDOC IS NULL ';

    qryNumeroSerie := fCriaQuery(nil);
    qryNumeroSerie.Close;
    qryNumeroSerie.SQL.Clear;
    qryNumeroSerie.SQL.Add(strSQL);
    qryNumeroSerie.ParamByName('NUMSER').AsString := strNumSer;
    qryNumeroSerie.ParamByName('CODITE').AsString := strCodIte;
    qryNumeroSerie.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryNumeroSerie.Open;

    Result := not qryNumeroSerie.IsEmpty;
  finally
    FreeAndNil(qryNumeroSerie);
  end;
end;

function TfrmFatVendas.fExisteProdutoComboRelacionadoAoItemDeAtivacao(
  intSeqCom: Integer): Boolean;
Var
  cdsVenTmp: TUniClientDataSet;
begin

  Result := False;

  Try

    cdsVenTmp      := TUniClientDataSet.Create(Self);

    If (intSeqCom <= 0) Then
      Exit;

    cdsVenTmp.Data := cdsVenda.Data;
    cdsVenTmp.LogChanges := False;
    cdsVenTmp.First;

    While Not cdsVenTmp.Eof Do
    Begin
      If (cdsVenTmp.FieldByName('ITE_SEQCOM').AsInteger = intSeqCom) Then
      Begin
        Result := True;
        Break;
      End;

      cdsVenTmp.Next;
    End;

  Finally
    FreeAndNil(cdsVenTmp);
  End;

end;

function TfrmFatVendas.fFatDigContatoCpfRG: Boolean;
var
  LFrmFatDigContatoCpfRG: TfrmFatDigContatoCpfRG;
begin
  Result := True;

  If (fCampoTabela('COUNT(0)', 'CLICTT',
                   ['CLI_CODCLI', 'CLI_AUTCTT'],
                   [edtCodCli.Text, 'S']) = 0) Then
  Begin
    fatVenda.strCliCtt := '';
    fatVenda.strProCtt := '';
  End
  Else If (fCodCliContatoAutorizado(fatVenda.strCliCtt,
                                    fatVenda.strProCtt) <> edtCodCli.Text) Then
  Begin
    LFrmFatDigContatoCpfRG := nil;
    Try
      Try
        pCriarFormularios(TfrmFatDigContatoCpfRG, LFrmFatDigContatoCpfRG);

        LFrmFatDigContatoCpfRG.strCodCli := edtCodCli.Text;
        Result := LFrmFatDigContatoCpfRG.ShowModal = mrOk;

        If Result Then
        Begin
          fatVenda.strCliCtt := LFrmFatDigContatoCpfRG.strCliCtt;
          fatVenda.strProCtt := LFrmFatDigContatoCpfRG.strProCtt;
        End;
      Except
        On E: Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message, '[fFatDigContatoCpfRG]');
        End;
      End;
    Finally
      pFreeAndNil(LFrmFatDigContatoCpfRG);
    End;
  End;
end;

