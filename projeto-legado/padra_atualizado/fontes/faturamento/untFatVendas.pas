begin
  Result := (Not fEmptyStr(strCliAnt)) And
            (strCliAnt <> strCodCliNovo) And
            (fEmptyStr(strNumOrc));
end;


Function TfrmFatVendas.fValidaCodFpg(strCodFpg, strConPag: String; Var blnExit: Boolean): Boolean;
Begin
  Result  := True;
  blnExit := False;

  If (Not fEmptyStr(strCodFpg)) And (Not fEmptyStr(strConPag)) Then
  Begin

    If Pos(strCodFpg,'001_006_' + IIF((fCfgSis('PRACHC',varString) = 'S'),'','002_007_')) > 0 Then
    Begin
      If (fStatusCndPag(strConPag) <> A_VISTA) And (mskCndPag.Text <> '01999') Then
      Begin
        fMensagem('','A condição de pagamento deve ser a vista!',['&OK']);
        Result := False;
      End;
    End;

    {*******************************************}
    {* LIBERADO PARCELADO A VISTA PARA VENDER  *}
    {* PARA CLIENTE CONSUMIDOR                 *}
    {****************************************MV*}
    If Pos(strCodFpg,'008_010_014_') > 0 Then
    Begin
      If (fStatusCndPag(strConPag) = A_VISTA) And (mskCndPag.Text <> '01999') Then
      Begin
        If (Pos(strOpcDoc,'OU_OV_OF_BR_TE_NC_DV_PR_OE_EF_EP_UC_DD_') <= 0) Then
          fMensagem('','A condição de pagamento não pode ser a vista!',['&OK'])
        Else
          fMensagem('','A forma de pagamento deve ser a vista!',['&OK']); //Tem que ser a vista

        Result := False;
      End;
    End;

    If (strCodFpg = '009') And (fatVenda.strOpcDoc = 'TR') Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido utilizar forma de pagamento "Parcelado" para "Troca de Mercadorias"!', ['&Ok']);
      Result := False;
    End;

    If (strCodFpg = '007') And ((fatVenda.blnMeiaNota) Or (fatVenda.strOpcDoc = 'NE')) And (fCfgSis('PERCAR', varString) = 'N') Then
    Begin
      fMensagem('ATENÇÃO!', 'Devido as novas regras da nota fiscal 4.0, não é permitido modalidade "Cartão" para Nota Fiscal Especial ou meia nota!', ['&Ok']);
      Result := False;
    End;

    If (strCodFpg = '009') And (fatVenda.strOpcDoc = 'DV') Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido utilizar forma de pagamento "Parcelado" para "Devolução de Mercadorias"!', ['&Ok']);
      Result := False;
    End;

    If (Not fatVenda.fDocumentoParaFornecedor) And
       (Not fPermiteCondPagtoClienteInativo(fatVenda.strCodCnd, fatVenda.strCodFpg)) And
       (fatVenda.fRetornaStatusClienteVenda(edtCodCli.Text) = 'I') And
       (fatVenda.fPermiteVenderApenasDinheiroECartaoParaInativo(IIF(fEmptyStr(fatVenda.strEspDoc), fatVenda.strOpcDoc, fatVenda.strEspDoc))) Then
    Begin
      fMensagem('ATENÇÃO!', 'É permitido utilizar apenas as formas de pagamento "Dinheiro", "Cartão" ou "Ordem de Pagamento" (somente se "Recebimento por meio do PIX" estiver ativado na condição de pagamento) para clientes Inativos!', ['&OK']);
      Result := False;
    End;

    If Not Result And Not pnlForPag.Visible Then
    Begin
      pSetFocus(edtCodCli);
      blnExit := True;
    End;

  End;

End;

function TfrmFatVendas.fTemDescontoEspecialItensCombo(arrItens: TMatrizFechamento): Boolean;
  Var
    intContador : Integer;
begin
  Result := False;

  For intContador := 0 To Length(arrItens)-1 Do
  Begin
    If (arrItens[intContador].fltDesEsp > 0.0) And (fatVenda.fItemRelacionadoCombo(arrItens[intContador]))  Then
    Begin
      Result := True;
      Break;
    End;
  End;
end;

function TfrmFatVendas.fValidaSeExistePodeConfirmarComDesconto(): Boolean;
begin
  Result := True;

  If (Not fCfgSis('CMBDES', varBoolean)) Then
  Begin
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And ((fatVenda.fltPorDes > 0.0) Or (fatVenda.fltDesEsp > 0.0)) Then
    Begin
      If (fatVenda.fAposRateioTeraItemZerado) Then
      Begin
        pMensagemOk(fatVenda.fRetMensagemValorNegativoPelosDescontos);
        Result := False;
      End;

      If (fTemDescontoEspecialItensCombo(fatVenda.arrMatItens))Then
      Begin
        pMensagemOk('Desconto especial informado (' + FormatFloat('#,##0.00', fatVenda.fltDesEsp) + ') não permitido! ' + #13#10 +
                    'O valor não pode ser aplicado sobre produtos não promocionais ou relacionados a combos!');
        Result := False;
      End;
    End;
  End;
end;

function TfrmFatVendas.fValidaTravaDePrecoComComissaoDoProfissional: Boolean;
  var
    blnResultVerificaVrMinimo : Boolean;
begin

  Result := True;

  If Not fConsiderarComissaoDoProfissionalNaTravaDePreco(strOpcDoc) Then
    Exit;

  fatVenda.blnConsiderarAComissaoDoProfissionalNaTravaDePreco := True;

  Try

    fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
                   begin
                     Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotGer,
                                                          fatVenda.fltTotGer,
                                                          fatVenda.intPrzMed,
                                                          EmptyStr,
                                                          True,
                                                          True,
                                                          pgbProgresso);
                     blnResultVerificaVrMinimo := Result;
                   end, 'Aguarde, verificando valor mínimo documento...', '');

  Finally
    fatVenda.blnConsiderarAComissaoDoProfissionalNaTravaDePreco := False;
  End;

  Result := blnResultVerificaVrMinimo;

end;

function TfrmFatVendas.fValidaTravaDePrecoComComissaoDoProfissionalEFrete: Boolean;
  var
    blnValidaSimultaneamenteComissaoEFrete : Boolean;
begin

  Result := False;

  blnValidaSimultaneamenteComissaoEFrete := (fConsiderarComissaoDoProfissionalNaTravaDePreco(strOpcDoc) And
                                             fConsiderarFreteNaTravaDePreco(strOpcDoc));

  If (blnValidaSimultaneamenteComissaoEFrete) Then
  Begin

    If Not fValidaTravaDePrecoComComissaoDoProfissionalEFreteSimultaneamente Then
      Exit;

  End Else
  Begin

    If Not fValidaTravaDePrecoComComissaoDoProfissional() Then
      Exit;

    If Not fValidaTravaDePrecoComFrete() Then
      Exit;

  End;

  Result := True;

end;

function TfrmFatVendas.fValidaTravaDePrecoComComissaoDoProfissionalEFreteSimultaneamente: Boolean;
  var
    blnResultVerificaVrMinimo : Boolean;
begin

  fatVenda.blnConsiderarAComissaoDoProfissionalNaTravaDePreco := True;
  fatVenda.blnConsiderarValorDoFreteNaTravaDePreco            := True;

  Try

    fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
                   begin
                     Result := fatVenda.fVerificaVrMinimo(fatVenda.fltTotGer,
                                                          fatVenda.fltTotGer,
                                                          fatVenda.intPrzMed,
                                                          EmptyStr,
                                                          True,
                                                          True,
                                                          pgbProgresso);
                     blnResultVerificaVrMinimo := Result;
                   end, 'Aguarde, verificando valor mínimo documento...', '');

  Finally
    fatVenda.blnConsiderarAComissaoDoProfissionalNaTravaDePreco := False;
    fatVenda.blnConsiderarValorDoFreteNaTravaDePreco            := False;
  End;

  Result := blnResultVerificaVrMinimo;

end;

function TfrmFatVendas.fValidaTravaDePrecoComFrete : Boolean;
  var
    blnResultVerificaVrMinimo : Boolean;
begin

  Result := True;

  If Not fConsiderarFreteNaTravaDePreco(strOpcDoc) Then
    Exit;

  fatVenda.blnConsiderarValorDoFreteNaTravaDePreco := True;

  Try

