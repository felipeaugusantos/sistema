function TfrmFatVendas.fSolicitarDigitacaoDeOcorrencia: Boolean;
begin
  Result := True;

  If (Pos(strOpcDoc,'DV_DD_') > 0) Then
    Exit;

  If ((Pos(strOpcDoc, 'OU_OV_') > 0) And (Pos(fatVenda.strClaFis, VS_strClaNfo) > 0)) Then
    Exit;

  If (StrToInt(LeftStr(fatVenda.strClaFis, 1)) < 5) Then
    Exit;

  If ((strOpcDoc.Equals('OF')) And (fCfgSis('SOROSF', varBoolean))) Then
    Exit;

  Result := False;
end;

function TfrmFatVendas.fSolicitarEmpresasParaAbastecimento: Boolean;
begin
  Result := True;

  If (Not fatVenda.fPedeLojasTE) Then
    Exit(False);

  If (Not fatVenda.fPedeLojasColorantesTE) Then
