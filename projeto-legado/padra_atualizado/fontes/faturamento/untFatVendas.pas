            Begin
              Result := False;
              pnlCabecalho.Enabled := True;
              pnlDadosItem.Enabled := True;
              Screen.Cursor        := crDefault;
              Exit;
            End;

            fatVenda.dicFormulas.AdicionarObjeto(cdsVenda.FieldByName('AUTOINCREM').AsString, matrizSaldosAux);
          End;

          If fCfgSis('NSERQT', varBoolean) And (qryGenDor.FieldByName('FDO_TEMNSE').AsString = 'S') Then
          Begin
            fatVenda.objFatSerieItem.AutoincItem := IntToStr(cdsVenda.FieldByName('AUTOINCREM').AsInteger);
            fatVenda.objFatSerieItem.pCarregaSeriesItem(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                                        qryGenDor.FieldByName('FDO_EMPITE').AsString,
                                                        qryGenDor.FieldByName('AUTOINCREM').AsString,
                                                        qryGenDor.FieldByName('FDO_SEQGER').AsString);
          End;

          qryGenDor.Next;

          pProcessMessages;

        End;

        fatVenda.pAcertaTabelaPrecoTinta(FieldByName('TMP_NUMDOC').AsString,
                                         FieldByName('TMP_ESPDOC').AsString,
                                         FieldByName('TMP_CODEMP').AsString);

        fatVenda.blnVendaPresencial := FieldByName('TMP_VENPRE').AsString = 'S';

        if (not fatVenda.blnPedidoOS) then
          fatVenda.blnPedidoOS := (FieldByName('TMP_ESPDOC').AsString = 'PD')
            and (not fEmptyStr(fRetornaOrdemServicoPedido(FieldByName('TMP_NUMDOC').AsString, FieldByName('TMP_CODEMP').AsString)));

        strCodEqu := fRetornaCodEquOSPedido(FieldByName('TMP_NUMDOC').AsString, FieldByName('TMP_ESPDOC').AsString,
          FieldByName('TMP_CODEMP').AsString);

        if not fEmptyStr(strCodEqu) then
        begin
          strDesEqu := fCampoTabela('EQU_DESCRI', 'CADEQU', ['EQU_CODIGO'], [strCodEqu]);
          strModEqu := fCampoTabela('EQU_MODELO', 'CADEQU', ['EQU_CODIGO'], [strCodEqu]);

          if (not fEmptyStr(strDesEqu)) and (pos(strDesEqu, fatVenda.strEquDescri) <= 0) then
            fatVenda.strEquDescri := fatVenda.strEquDescri + IIF(fEmptyStr(fatVenda.strEquDescri), strDesEqu, ' / ' + strDesEqu);

          if (not fEmptyStr(strModEqu)) and (pos(strModEqu, fatVenda.strEquModelo) <= 0) then
            fatVenda.strEquModelo := fatVenda.strEquModelo + IIF(fEmptyStr(fatVenda.strEquModelo), strModEqu, ' / ' + strModEqu);
        end;

        Next;

        pProcessMessages;
      End;

      pHabilitaChkVendaPresencial;
      fatVenda.pAcertaProdutoAcabado;

      //retirar a virgula do final
      If (Not fEmptyStr(fatVenda.strNumDocsPD)) Then
        fatVenda.strNumDocsPD := Copy(fatVenda.strNumDocsPD, 1, Length(fatVenda.strNumDocsPD) - 1);

      Result := True;
      pnlCabecalho.Enabled := True;
      pnlDadosItem.Enabled := True;
      Screen.Cursor        := crDefault;
    End;

  Except

    On E: ExceptionAutcom Do
    Begin
      Result := False;

      pnlCabecalho.Enabled := True;
      pnlDadosItem.Enabled := True;
      Screen.Cursor        := crDefault;
      pMensagemOk(E.Message);
    End;

    On E: Exception Do
    Begin
      Result := False;

      pnlCabecalho.Enabled := True;
      pnlDadosItem.Enabled := True;
      Screen.Cursor        := crDefault;
      pMensagensErro(E.Message, '[fCarregaItensConfirmacaoPedido]');
    End;

  End;

  fatVenda.fltPorDes := 0.0;//Unitario do item ja esta liquido, nao deve aplicar o desconto novamente
  fatVenda.fltDesEsp := 0.0;
  fatVenda.fltValFre := 0.0;

  {*****************************************}
  {* SE OCORREU UM ERRO DURANTE O PROCES-  *}
  {* SAMENTO, SAI                          *}
  {**************************************MV*}
  If (Not Result) Then
    Exit;

  pInformacao('Processando Produtos, Aguarde....');

  fatVenda.pAtualizaDocumentoEntregaFutura;

  {*****************************************}
  {* PREENCHE A MATRIZ COM OS ITENS        *}
  {**************************************MV*}
  strCodTraSav := fatVenda.strCodTra;
  Try
    pPreencheMatrizFechamento;

    If (fatVenda.blnEndEntConfDoc) Then
    Begin
      fatVenda.blnDecidiuEndereco := False;
      Repeat
        If (Not fatVenda.fAlteraEnderecoEntrega(False, True, True, True, True)) Then
        Begin
          If fMensagem('', 'Nenhum Endereço de Entrega foi Informado, Continuar?', ['&Sim', '&Não']) = 1 Then
          Begin
            fatVenda.blnEndEntConfDoc := False;
            fatVenda.pLimparEnderecoEntrega;
            fatVenda.pEnderecoToFatVenda;
            fatVenda.blnDecidiuEndereco := True;
          End;
        End
        Else fatVenda.blnDecidiuEndereco := True;
      Until (fatVenda.blnDecidiuEndereco = True);
    End;

    If (fatVenda.strOpcDoc = 'CP') And (strCodTraSav <> fatVenda.strCodTra) And (Not fEmptyStr(strCodTraSav)) And
       (fCfgSis('TREXCP') = 'S' {Pedir senha}) Then
      fatVenda.strCodTra := strCodTraSav;

  Except
    On E: ExceptionAutCom Do
    Begin
      fMensagem('', E.Message, ['&O K']);
      Result := False;
      Exit;
    End;

    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[frmFatVendas.fCarregaItensConfirmacaoPedido]');
      Result := False;
      Exit;
    End;
  End;

  pInformacao('Totalizando Produtos, Aguarde....');

  {*****************************************}
  {* CALCULA TOTAL GERAL                   *}
  {**************************************MV*}
  pCalculaTotGer;
  pAtualizarEditsTotais;

  {*****************************************}
  {* MOSTRA ITENS DA CONFIRMAÇÃO           *}
  {**************************************MV*}
  If (Not (fatVenda.strConfSer = 'S')) Then
  Begin
    Try
      pCriarFormularios(TfrmFatConfPedidosItens, frmFatConfPedidosItens);
      If fatVenda.strOpcDoc = 'OV' Then
        frmFatConfPedidosItens.Caption := 'Outras Saídas - Itens';

      dbgItens.DataSource := Nil;
      frmFatConfPedidosItens.cdsDados  := cdsVenda;
      frmFatConfPedidosItens.strOpcDoc := strOpcDoc;
      frmFatConfPedidosItens.strCodCli := fatVenda.strCodCli;
      frmFatConfPedidosItens.objItensPedidos := fatVenda.objItensPedidos;
      frmFatConfPedidosItens.pAlteraSaldoEstoque;
      Result := (frmFatConfPedidosItens.showModal = mrOk);
      dbgItens.DataSource := dtsVenda;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fCarregaItensConfirmacaoPedido]');
      End;
    End;
  End
  Else
    Result := True;

  If Result Then
  Begin
    pCalculaFreteDespDescPagAntConfPedidos;

    If (Assigned(frmFatConfPedidosItens)) Then
      fatVenda.blnDeletouItenCp := frmFatConfPedidosItens.blnDeletouItenCp;
  End;

  If (Result) Then
    pMostraLimiteCredito;

  pFreeAndNil(frmFatConfPedidosItens);
  FreeAndNil(qryGenIte);
  FreeAndNil(qryGenDor);
end;

procedure TfrmFatVendas.pAtualizaUnitarioLiquido(blnAplicaUltimaVendaValorLiquido: Boolean = False);
  Var
    fltUniLiq: Double;
    fltUnitar: Double;
begin
  If Not Assigned(fatVenda) Then
    Exit;

  if blnAplicaUltimaVendaValorLiquido then
  begin
    fltUniLiq := fFormataFloat(fltUniUltVnd, fatVenda.VS_intDecUni);

    if (fCfgSis('CLIDES') = 'S') and (fCfgSis('DCVBVL') = 'L') then
      fltUniLiq := fFormataFloat(fltUniLiq * (100 - fatVenda.fltDescProfissional) / 100, fatVenda.VS_intDecUni);

    If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoDigitado Then
      fltUniLiq := fltUniLiq + (fltUniLiq * fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0);

    fltUnitar := fltUniLiq + fatVenda.fRetornaVrDesconto(1, fltUniLiq, fStrToFloat(edtDescon.Text));
    fltUnitar := fFormataFloat(fltUnitar, fatVenda.fMaxDecUni);

    edtUniTar.Text := FormatFloat(edtUniTar.EditFormat, fltUnitar);
  end
  else
  begin
    fltUniLiq := fFormataFloat(fStrToFloat(edtUnitar.Text), fatVenda.VS_intDecUni);

    If fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoDigitado Then
      fltUniLiq := fltUniLiq + (fltUniLiq * fatVenda.fGetTaxVprItem(fCodItem, fRetEmpresaItem) / 100.0);

    fltUniLiq := fltUniLiq - fatVenda.fRetornaVrDesconto(2, fltUniLiq, fStrToFloat(edtDescon.Text));
    fltUniLiq := fFormataFloat(fltUniLiq, fatVenda.fMaxDecUni);

    edtUniLiq.Text := FormatFloat(edtUniTar.EditFormat, fltUniLiq);
  end;

  pAtualizaUnitarioDolar(fStrToFloat(edtUniLiq.Text));
  pAtualizaUnitarioComImpostos;
end;

procedure TfrmFatVendas.pRecalculaAtualizaDescontoItem;
begin
  If Not Assigned(fatVenda) Then
    Exit;

  edtDescon.Text := FormatFloat(fMskDigitos(intDecDes),
    fatVenda.fCalculaDescontoItem(fStrToFloat(edtUnitar.Text), fStrToFloat(edtUniLiq.Text)));
end;

procedure TfrmFatVendas.pRecalculaTotalItem;
begin
  If Not Assigned(fatVenda) Then
    Exit;

  edtTotIte.Text := FloatToStrF((fStrToFloat(edtUniLiq.Text) * fStrToFloat(edtQtdIte.Text)), ffFixed, 12, 2);
  If fItemSelecionadoCarregado(edtCodIte.Text) Then
    edtVrTotCImpostos.Text := FloatToStrF(fCalcularValorComImpostos(fatVenda, edtCodIte.Text, fStrToFloat(edtTotIte.Text), Nil), ffFixed, 12, 2);
  pAtualizaUnitarioComImpostos;
end;

procedure TfrmFatVendas.pCalculaFreteDespDescPagAntConfPedidos;
  Var
    cdsItens: TUniClientDataSet;
    stlDocsFre: TStringList;
    qryGenGor: TUniQuery;
    fltDesCal: Double;
    strChaveDoc: String;
    recItemPedido: TRecItemPedido;
    arrItemPedidos: TArrItemPedidos;
begin
  {*****************************************}
  {* CALCULA O DESC. ESPECIAL PROPORCIONAL *}
  {* OBS: MELHORAR ESSA PARTE DO FRETE.    *}
  {**************************************MV*}
  cdsItens  := TUniClientDataSet.Create(Self);
  qryGenGor := fCriaQuery(Self);

  fatVenda.fltPorDes := 0.0;//Unitario do item ja esta liquido, nao deve aplicar o desconto novamente
  fatVenda.fltDesEsp := 0;
  fatVenda.fltValFre := 0;
  fatVenda.fltFreDig := 0;
  pAtualizaTemporaria;

  pCloneDataSet(cdsItens, cdsVenda);
  stlDocsFre := TStringList.Create;

  cdsItens.First;
  While (Not cdsItens.Eof) Do
  Begin
    If strOpcDoc = 'CP' Then
    Begin
      strChaveDoc := cdsItens.FieldByName('ITE_NUMORC').AsString +
                     cdsItens.FieldByName('ITE_ESPORC').AsString +
                     cdsItens.FieldByName('ITE_EMPORC').AsString;

      If (stlDocsFre.IndexOf(strChaveDoc) < 0) Then
      Begin
        stlDocsFre.Add(strChaveDoc);

        qryGenGor.Close;
        qryGenGor.SQL.Clear;
        qryGenGor.SQL.Add('SELECT ');
        qryGenGor.SQL.Add('  FGO_CODTRA, ');
        qryGenGor.SQL.Add('  FGO_FRERAT, ');
        qryGenGor.SQL.Add('  FGO_TOTFRE - FGO_FREBAI AS FGO_VALFRE, ');
        qryGenGor.SQL.Add('  FGO_PORDES, ');
        qryGenGor.SQL.Add('  FGO_TIPFRE  ');
        qryGenGor.SQL.Add('FROM ');
        qryGenGor.SQL.Add('  FATGOR ');
        qryGenGor.SQL.Add('  INNER JOIN EXTGOR ON FGO_SEQFGO = AUTOINCREM ');
        qryGenGor.SQL.Add('WHERE ');
        qryGenGor.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
        qryGenGor.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
        qryGenGor.SQL.Add('  FGO_CODEMP = :CODEMP ');

        qryGenGor.ParamByName('NUMDOC').AsString := cdsItens.FieldByName('ITE_NUMORC').AsString;
        qryGenGor.ParamByName('ESPDOC').AsString := cdsItens.FieldByName('ITE_ESPORC').AsString;
        qryGenGor.ParamByName('CODEMP').AsString := cdsItens.FieldByName('ITE_EMPORC').AsString;
        qryGenGor.Open;

        fatVenda.fltValFre := fatVenda.fltValFre + qryGenGor.FieldByName('FGO_VALFRE').AsFloat;
        fatVenda.fltFreDig := fatVenda.fltFreDig + qryGenGor.FieldByName('FGO_VALFRE').AsFloat;

        If fRateiaFreteItensTransportadora(qryGenGor.FieldByName('FGO_CODTRA').AsString, qryGenGor.FieldByName('FGO_TIPFRE').AsString) And (qryGenGor.FieldByName('FGO_FRERAT').AsFloat > 0) Then
        Begin
          fatVenda.fltValFre := fatVenda.fltValFre + qryGenGor.FieldByName('FGO_FRERAT').AsFloat;
          fatVenda.fltFreDig := fatVenda.fltFreDig + qryGenGor.FieldByName('FGO_FRERAT').AsFloat;
        End;
      End;

      fatVenda.fltPorDes := qryGenGor.FieldByName('FGO_PORDES').AsFloat;

      fltDesCal := fatVenda.fCalcDescEspecialItemConfPed( cdsItens.FieldByName('ITE_QTDORI').AsFloat,
                                                          cdsItens.FieldByName('ITE_QTDBAI').AsFloat,
                                                          cdsItens.FieldByName('ITE_QTDITE').AsFloat,
                                                          cdsItens.FieldByName('ITE_DESESP').AsFloat,
                                                          cdsItens.FieldByName('ITE_DESBAI').AsFloat );

      If (fatVenda.fltDesSai = 0) Then
      Begin
        If cdsVenda.Locate('ITE_SEQDET', cdsItens.FieldByName('ITE_SEQDET').AsString, []) Then
        Begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_DESEXP').AsFloat := fltDesCal;
          cdsVenda.Post;
        End;
      End;

      fatVenda.fltDesEsp := fatVenda.fltDesEsp + fltDesCal;
    End
    Else If (strOpcDoc = 'OV') And Assigned(fatVenda.objItensPedidos) Then
    Begin
      arrItemPedidos := fatVenda.objItensPedidos[cdsItens.FieldByName('AUTOINCREM').AsInteger];

      For recItemPedido In arrItemPedidos Do
      Begin
        If recItemPedido.fltQtdIte = 0 Then
          Continue;

        strChaveDoc := recItemPedido.strNumOrc +
                       recItemPedido.strEspOrc +
                       recItemPedido.strEmpOrc;

        If (stlDocsFre.IndexOf(strChaveDoc) < 0) Then
        Begin
          stlDocsFre.Add(strChaveDoc);

          qryGenGor.Close;
          qryGenGor.SQL.Clear;
          qryGenGor.SQL.Add('SELECT ');
          qryGenGor.SQL.Add('  FGO_TOTFRE - FGO_FREBAI AS FGO_VALFRE, ');
          qryGenGor.SQL.Add('  FGO_PORDES ');
          qryGenGor.SQL.Add('FROM ');
          qryGenGor.SQL.Add('  FATGOR ');
          qryGenGor.SQL.Add('WHERE ');
          qryGenGor.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
          qryGenGor.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
          qryGenGor.SQL.Add('  FGO_CODEMP = :CODEMP ');

          qryGenGor.ParamByName('NUMDOC').AsString := recItemPedido.strNumOrc;
          qryGenGor.ParamByName('ESPDOC').AsString := recItemPedido.strEspOrc;
          qryGenGor.ParamByName('CODEMP').AsString := recItemPedido.strEmpOrc;
          qryGenGor.Open;

          fatVenda.fltValFre := fatVenda.fltValFre + qryGenGor.FieldByName('FGO_VALFRE').AsFloat;
          fatVenda.fltFreDig := fatVenda.fltFreDig + qryGenGor.FieldByName('FGO_VALFRE').AsFloat;
        End;

        fatVenda.fltPorDes := qryGenGor.FieldByName('FGO_PORDES').AsFloat;

        fltDesCal := fatVenda.fCalcDescEspecialItemConfPed( recItemPedido.fltQtdOri,
                                                            recItemPedido.fltQtdBai,
                                                            recItemPedido.fltQtdIte,
                                                            recItemPedido.fltDesEsp,
                                                            recItemPedido.fltDesBai );

        If (fatVenda.fltDesSai = 0) Then
        Begin
          If cdsVenda.Locate('ITE_SEQDET', recItemPedido.strSeqDet, []) Then
          Begin
            cdsVenda.Edit;
            cdsVenda.FieldByName('ITE_DESEXP').AsFloat := fltDesCal;
            cdsVenda.Post;
          End;
        End;

        fatVenda.fltDesEsp := fatVenda.fltDesEsp + fltDesCal;        
      End;
    End;

    cdsItens.Next;
  End;

  fatVenda.fltDesEspConfPed := fatVenda.fltDesEsp;

  FreeAndNil(stlDocsFre);
  FreeAndNil(qryGenGor);
  FreeAndNil(cdsItens);

  fatVenda.pSintetizaPedidosPagAnt;
end;

procedure TfrmFatVendas.pItemsRepresentados;
Begin

  If Not fVerificaAcessoSistema('ITREPR') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Itens Representados!', ['&O k']);
    Exit;
  End;

  If blnIteRpr Then
  Begin

    If InterlockedIncrement(intConfirmando) = 0 Then
    Begin

      btnCancelaItem.Click;

      Try
        pCriarFormularios(TfrmFatItensRepresent, frmFatItensRepresent);
      Except
        fMensagem('','Não consegui criar o formulário! Tente novamente!',['&OK']);
        InterlockedDecrement(intConfirmando);
        Exit;
      End;

      Try
        frmFatItensRepresent.strNumDoc := fatVenda.strNumOrc;
        frmFatItensRepresent.strEspDoc := fatVenda.strEspOrc;
        frmFatItensRepresent.strCodEmp := VS_strCodEmp;
        frmFatItensRepresent.fatVenda := fatVenda;
        frmFatItensRepresent.ShowModal;
      Finally
        pFreeAndNil(frmFatItensRepresent);
      End;

      InterlockedDecrement(intConfirmando);
    End
    Else
      InterlockedDecrement(intConfirmando);

  End;

End;

function TfrmFatVendas.PixJaRecebido: Boolean;
begin
  Result := False;

  If Not Assigned(fatVenda.DadosPixDaVenda.ObjetoPixPago) Then
    Exit;

  Result := TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(fatVenda.DadosPixDaVenda.ObjetoPixPago);
  If Result Then
    Result := FormatFloat(',0.00', fatVenda.DadosPixDaVenda.ObjetoPixPago.Valor) =
              FormatFloat(',0.00', fatVenda.DadosPixDaVenda.ObjetoPixPago.ValorPago);
end;

