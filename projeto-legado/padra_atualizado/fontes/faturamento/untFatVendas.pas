procedure TfrmFatVendas.pSugerirPrazoFornecedor;
var
  blnAltera : Boolean;
  blnSugerirPrazoFornecedor : Boolean;
begin

  blnSugerirPrazoFornecedor := False;
  blnAltera := fAlterandoProduto;

  If Not qryConCit.Active Then
    Exit;

  If Not fCfgSis('PRZFOR', varBoolean) Then
    Exit;

  If blnAltera Then
    Exit;

  If (Pos(strOpcDoc, 'OR_PD_') <= 0) Then
    Exit;

  If (qryConCit.FieldByName('ITE_DIAFOR').AsInteger <= 0) Then
    Exit;

  If fCfgSis('PDVIME', varBoolean) Then
    blnSugerirPrazoFornecedor := True;

  If (Not fCfgSis('PDVIME', varBoolean)) And (Not fEmptyStr(edtDiaEnt.Text)) Then
    If qryConCit.FieldByName('ITE_DIAFOR').AsInteger > StrToInt(edtDiaEnt.Text) Then
      blnSugerirPrazoFornecedor := True;

  If (fEntregaImediataItem = 'S') And (blnSugerirPrazoFornecedor) Then
  Begin
    mskDtaEnt.Text := FormatDateTime('dd/mm/yyyy', VS_Date + qryConCit.FieldByName('ITE_DIAFOR').AsInteger);
    edtDiaEnt.Text := FloatToStr(qryConCit.FieldByName('ITE_DIAFOR').AsInteger);
  End;

end;

procedure TfrmFatVendas.pSugerirDataEntregaFuturaPrevisao();
begin
  If Not qryConCit.Active Then
    Exit;

  If Not fCfgSis('DEFCPR', varBoolean) Then
    Exit;

  If (fAlterandoProduto) Then
    Exit;

  If (Pos(strOpcDoc, 'OR_PD_') <= 0) Then
    Exit;

  If (qryConCit.FieldByName('ITE_DIAFOR').AsInteger <= 0) Then
    Exit;

  If (cmbEntRet.ItemIndex = IDX_ENTREGA) And
     (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And
     (cmbMotEntFut.ItemIndex = IDX_MOTIVO_PREVISAO_ENTREGA) Then
  Begin
    mskDtaEnt.Text := FormatDateTime('dd/mm/yyyy', IncDay(Date, qryConCit.FieldByName('ITE_DIAFOR').AsInteger));
    edtDiaEnt.Text := IntToStr(qryConCit.FieldByName('ITE_DIAFOR').AsInteger);
  End;
end;

