function TfrmFatVendas.fRevalidaPromocoesColetivas(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    intAux,
    intIdx : Integer;
    strItensNaMatrizItemProMasNaoGrid: String;
    strItensQuantidadeDiferentes: String;
    strItensQtdLimOuQtdMinDiferentes: String;
    cdsDados : TUniClientDataSet;
    qryPromo: TUniQuery;
begin
  Result := False;
    
  If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Not fGridVendaVazio) And
    (Length(TProQtdColetiva.ArrItemPro) > 0) Then
  Begin
    strItensNaMatrizItemProMasNaoGrid := '';
    strItensQuantidadeDiferentes := '';
    strItensQtdLimOuQtdMinDiferentes := '';
    
    cdsDados := TUniClientDataSet.Create(Nil);
    qryPromo := fCriaQuery;
    Try
      pCloneDataSet(cdsDados, cdsVenda);
      qryPromo.SQL.Text := 'SELECT '+
                           '  PRO_QTDMIN, ' +
                           '  PRO_QTDLIM, ' +
                           '  PRO_CODPRO  ' +
                           'FROM CADPRO INNER JOIN ITEPRO ON CADPRO.AUTOINCREM = ITEPRO.IPR_SEQGER ' +
                           'WHERE PRO_CODPRO = :PRO_CODPRO '+
                           '  AND IPR_CODITE = :IPR_CODITE '+
                           '  AND PRO_IDXPRO IN ('+IDX_TIPO_DESCONTO_PROMOCAO[tdpPrecoQuantidadeColetiva].ToString+','
                                                  +IDX_TIPO_DESCONTO_PROMOCAO[tdpPorcentoDescontoQuantidadeColetiva].ToString+')';

      //TESTA COERÊNCIA ENTRE A MATRIZ COLETIVA E O CDS DE VENDAS 
      For intIdx := Low(TProQtdColetiva.ArrItemPro) To High(TProQtdColetiva.ArrItemPro) Do
      Begin
        cdsDados.First;
        If (Not fEmptyStr(TProQtdColetiva.ArrItemPro[intIdx].strCodPro)) Then
        Begin
          If (TProQtdColetiva.ArrItemPro[intIdx].fltQtdIte > 0) Then
          Begin
            qryPromo.Close;
            qryPromo.ParamByName('PRO_CODPRO').AsString := TProQtdColetiva.ArrItemPro[intIdx].strCodPro;
            qryPromo.ParamByName('IPR_CODITE').AsString := TProQtdColetiva.ArrItemPro[intIdx].strCodIte;
            qryPromo.Open;

            If (Not qryPromo.IsEmpty) Then
            Begin
              If (qryPromo.FieldByName('PRO_QTDMIN').AsFloat <> TProQtdColetiva.ArrItemPro[intIdx].fltQtdMin) Or 
                 (qryPromo.FieldByName('PRO_QTDLIM').AsFloat <> TProQtdColetiva.ArrItemPro[intIdx].fltQtdLim) Then
              Begin   
                //TESTA SE AS QUANTIDADES LIMITES E MÍNIMAS ESTÃO IGUAIS NA MATRIZ COLETIVA E NO CADASTRO
                If (qryPromo.FieldByName('PRO_QTDMIN').AsFloat <> TProQtdColetiva.ArrItemPro[intIdx].fltQtdMin) Then
                Begin
                  pIncrementaListaStr(' Cod. Pro.: ' + TProQtdColetiva.ArrItemPro[intIdx].strCodPro +
                                      ' Min. Mat.: ' + FloatToStr(TProQtdColetiva.ArrItemPro[intIdx].fltQtdMin) +
                                      ' Min. Cad.: ' + FloatToStr(qryPromo.FieldByName('PRO_QTDMIN').AsFloat), strItensQtdLimOuQtdMinDiferentes);
                  Result := True;                    
                End;

                If (qryPromo.FieldByName('PRO_QTDLIM').AsFloat <> TProQtdColetiva.ArrItemPro[intIdx].fltQtdLim) Then
                Begin
                  pIncrementaListaStr(TProQtdColetiva.ArrItemPro[intIdx].strCodPro +
                                      ' Lim. Mat.: ' + FloatToStr(TProQtdColetiva.ArrItemPro[intIdx].fltQtdLim) +
                                      ' Lim. Cad.: ' + FloatToStr(qryPromo.FieldByName('PRO_QTDLIM').AsFloat), strItensQtdLimOuQtdMinDiferentes);
                  Result := True;                                        
                End;
              End;

              If Not (cdsDados.Locate('ITE_CODITE', TProQtdColetiva.ArrItemPro[intIdx].strCodIte, [])) Then
              Begin
                //TESTA SE HÁ ITENS NA MATRIZ COLETIVA E NÃO NO CDS E ESSE ITEM PODE TER ACIONADO PROMOÇÃO DE OUTROS ITENS
                For intAux := Low(TProQtdColetiva.ArrItemPro) To High(TProQtdColetiva.ArrItemPro) Do
                Begin
                  If (TProQtdColetiva.ArrItemPro[intAux].strCodPro = TProQtdColetiva.ArrItemPro[intIdx].strCodPro) Then
                  Begin
                    If (cdsDados.Locate('ITE_CODITE;ITE_PROMOC', VarArrayOf([TProQtdColetiva.ArrItemPro[intAux].strCodIte, 'S']), [])) Then
                    Begin
                      pIncrementaListaStr(TProQtdColetiva.ArrItemPro[intIdx].strCodIte, strItensNaMatrizItemProMasNaoGrid);
                      Result := True;                    
                    End;
                  End;
                End;
              End
              Else If (cdsDados.Locate('ITE_CODITE;ITE_PROMOC;ITE_ITETIN;ITE_CODPRO',
                                        VarArrayOf([TProQtdColetiva.ArrItemPro[intIdx].strCodIte,
                                                    'S',
                                                    IIF(TProQtdColetiva.ArrItemPro[intIdx].strRshTin = 'NOR', '', TProQtdColetiva.ArrItemPro[intIdx].strRshTin),
                                                    TProQtdColetiva.ArrItemPro[intIdx].strCodPro
                                                   ]), [loCaseInsensitive])) Then 
              Begin
                //TESTA SE A QUANTIDADE NO CDS É DIVERGENTE A DA MATRIZ COLETIVA
                If (TProQtdColetiva.ArrItemPro[intIdx].fltQtdIte <> cdsDados.FieldByName('ITE_QTDITE').AsFloat) Then
                Begin
                   pIncrementaListaStr(TProQtdColetiva.ArrItemPro[intIdx].strCodIte + ' ' +
                                      ' Qtd. Ven.: ' + FloatToStr(cdsDados.FieldByName('ITE_QTDITE').AsFloat) +
                                      ' Qtd. Mat.: ' + FloatToStr(TProQtdColetiva.ArrItemPro[intIdx].fltQtdIte), strItensQuantidadeDiferentes);
                   Result := True;                    
                End;
              End;
            End;
          End;
        End;
      End;
    Finally
      FreeAndNil(cdsDados);
      FreeAndNil(qryPromo);
    End;

    If Result Then
    Begin
      fMensagem('Atenção!', 'Encontrada uma inconsistência entre os itens com promoção coletiva!' +#10#13+
                            'Entre em contato com o suporte da Citel mostrado o conteúdo dessa mensagem ou registre com uma foto ou print dessa tela!' +#10#13+ 
                            'Recomenda-se excluir esses itens promocionais e incluí-los novamente ou reinciar essa operação fechando a tela de venda.' +#10#13+ 
                            IIF(fEmptyStr(strItensQtdLimOuQtdMinDiferentes),'',strItensQtdLimOuQtdMinDiferentes + #10#13)+
                            IIF(fEmptyStr(strItensNaMatrizItemProMasNaoGrid),'','Som. Mat.: '+strItensNaMatrizItemProMasNaoGrid + #10#13) +
                            IIF(fEmptyStr(strItensQuantidadeDiferentes),'',strItensQuantidadeDiferentes + #10#13)  
                            ,['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 250, 0, High(TProQtdColetiva.ArrItemPro));

    End;
  End;
end;

