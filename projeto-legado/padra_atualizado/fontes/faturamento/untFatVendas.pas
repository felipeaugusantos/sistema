  else if (fatVenda.strEspDoc = 'PD') And (fCfgSis('PEDMIN')  = 'T' ) Then
  begin
    Result := fatVenda.fVerificaValorMinimoEmitirNF(True);
  end;

end;


function TfrmFatVendas.fInformaCPFCNPJItensComObrigatoriedade(AOpcDoc: String): Boolean;
begin
  Result := True;
  If (AOpcDoc = 'PD') Or ((AOpcDoc = 'OR') And (fCfgSis('OBCPFO', varBoolean))) Then
  Begin
    If (Not fEmptyStr(fCampoTabela('CLI_CPFDEV', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli]))) Then
    Begin
      pMensagemOk('Documento possui itens com obrigatoriedade de CPF/CNPJ, ' +
                  'e o cliente está marcado com CPF/CNPJ somente para Devoluções.'+ #10+#13+
                  'Ajuste o cadastro do cliente antes de realizar a venda!');
      Result := False;
    End
    Else
    Begin
      If (fMensagem('ATENÇÃO!', 'Documento possui itens com obrigatoriedade de CPF/CNPJ, ' +
                                'não será possível emitir o documento sem informar CPF/CNPJ.'+ #10+#13+
                                'Deseja informar o CPF/CNPJ agora?', ['&Sim', '&Não']) = 1) Then
      Begin
        If (fatVenda.fInformaCnpj(True)) Then
        Begin
          If (Not fClienteConsumidor(fatVenda.strCliOri, False, True)) Then
          Begin
            pEditarCPFCliente;
            qryConCli.Close;
            qryConCli.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
            qryConCli.Open;
          End;
          blnCpfCnpjVazio := False;
        End
        Else
          Result := False;
      End
      Else
        Result := False;
    End;
  End;
end;

function TfrmFatVendas.fVerificaObrigatoriedadeCpfCnpjNoItem: Boolean;
begin
  Result := True;
  If strOpcDoc <> 'VN' Then
    Exit;

  If (Not fatVenda.fVerificaItemObrigCpfCnpj) Then
  Begin
    If (Pos(strOpcDoc,'OR_PD_') <= 0) And (Pos(fatVenda.strEspDoc,'OR_') <= 0) And (fatVenda.fTrocaUFEndEntrega <> 'EX') Then
      Exit(False);

    If (Not fInformaCPFCNPJItensComObrigatoriedade(strOpcDoc)) Then
      Exit(False);
  End;
end;

function TfrmFatVendas.fVerificaObrigatoriedadeCpfCnpjParaEmissaoNotaFiscal(): Boolean;
var
  blnAbrirFatDigCnpj : Boolean;
begin
  Result := True;

  If ((Pos(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc,'NF_EL_NS_') > 0)) And
     (fCfgSis('CPFOBR', varBoolean)) Then
  Begin

    If (fEmptyStr(fatVenda.strCliCgc)) And (Not fClienteEstrangeiroComIdPreenchido(qryConCli)) Then
    Begin
      If (Not fatVenda.fDocumentoParaFornecedor) And (Not fEmptyStr(qryConCli.FieldByName('CLI_CPFDEV').AsString)) Then
      Begin
        pMensagemOk('Para emissão de '+fDescricaoDocFat(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc)+' é necessário informar o CPF/CNPJ do cliente!');
        Result := False;
        Exit;
      End
      Else If (fMensagem('ATENÇÃO!', 'Para emissão de '+fDescricaoDocFat(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc)+' é necessário informar o CPF/CNPJ do cliente!' + #13#10 +
                                     'Deseja informar agora?', ['&Sim', '&Não']) = 2) Then
      Begin
        Result := False;
        Exit;
      End
      Else
      Begin

        If (fatVenda.fInformaCnpj(True)) Then
        Begin
          If fatVenda.fDocumentoParaFornecedor Then
          Begin
            pEditarCPFFornecedor;
            qryConCli.Close;
            qryConCli.ParamByName('CODFOR').AsString := fatVenda.strCodCli;
            qryConCli.Open;
          End Else
          Begin
            If (Not fClienteConsumidor(fatVenda.strCliOri, False, True)) Then
            Begin
              pEditarCPFCliente;
              qryConCli.Close;
              qryConCli.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
              qryConCli.Open;
            End;
          End;

        End
        Else
        Begin
          Result := False;
          Exit;
        End;
      End;
    End;

    If Not fatVenda.fDadosCorretosParaClienteConsumidor(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc) Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido emitir Nota Fiscal sem preencher todos os dados do cliente.', ['&Ok']);
      Result := False;
      Exit;
    End;

    If fatVenda.fTrocaUFEndEntrega <> 'EX' Then
    Begin
      If (Not fatVenda.fPermiteNotaServicoSemCpf) Then
      Begin
        If (Not fEmptyStr(fatVenda.strCliCgc)) And
           (fReplicatorStr(fatVenda.strCliCgc[1], Length(fatVenda.strCliCgc)) = fatVenda.strCliCgc) Then
        Begin
          fMensagem('', 'O CPF / CNPJ DO CLIENTE NÃO É VÁLIDO PARA EMITIR NOTA FISCAL.', ['&Ok']);
          Result := False;
          Exit;
        End;
      End;
    End;
  End;

  {Documentos com IPI deve obrigar CPF/CNPJ obrigatórios}
  If (fatVenda.fltTotIpi > 0) And (fatVenda.strCliEst <> 'EX') And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    If (not fatVenda.fPermiteIPISemDadosConsumidor) And ((fEmptyStr(fatVenda.strCliCgc)) Or (fReplicatorStr(fatVenda.strCliCgc[1], Length(fatVenda.strCliCgc)) = fatVenda.strCliCgc)) Then
    Begin
      blnCpfCnpjVazio    := True;
      blnAbrirFatDigCnpj := False;

      if not blnPermiteFinalizarOrcamentoIPISemDadosConsumidor then
      begin
        If (fMensagem('ATENÇÃO!', 'Para emitir '+fDescricaoDocFat(FVariaveisFechamentoVenda.arrOpcoes[FVariaveisFechamentoVenda.intPosAtual].strEspDoc)+' com IPI é obrigatório o CPF/CNPJ do cliente!' + #13#10 +
                                       'Deseja informar agora?', ['&Sim', '&Não']) = 1) Then
          blnAbrirFatDigCnpj := True;
      end
      else
      begin
        if (fMensagem('ATENÇÃO!', 'Para emitir Nota Fiscal com IPI é obrigatório o CPF/CNPJ do cliente!'+#13#10+
                                  'Deseja Continuar e Informar o CPF/CNPJ do Consumidor? (S/N)', ['&Sim', '&Não']) = 1) then
          blnAbrirFatDigCnpj := True;
      end;

      if (blnAbrirFatDigCnpj) then
      begin
        if (fatVenda.fInformaCnpj(True)) then
        begin
          if (not fClienteConsumidor(fatVenda.strCliOri, False, True)) then
          begin
            pEditarCPFCliente;
            qryConCli.Close;
            qryConCli.ParamByName('CODCLI').AsString := fatVenda.strCodCli;
            qryConCli.Open;
          end;
          blnCpfCnpjVazio := False;
        end
        else
          Result := False;
      end;

      if (not blnPermiteFinalizarOrcamentoIPISemDadosConsumidor) and  (blnCpfCnpjVazio) then
        Result := False;

      If Not Result Then
      Begin
        pAtualizaTemporaria;
        pDesabilitaItensConfirmacao;
        Exit;
      End;
    End;
  End;
end;

procedure TfrmFatVendas.btnCancelarVendaClick(Sender: TObject);
  var
    frmRcxDigCartoes : TfrmRcxDigCartoes;

begin
  inherited;

  If InterlockedIncrement(intConfirmando) = 0 Then
  Begin
    if Assigned(fatVenda.objTefRecebimento) then //'TEFVN_'
    Begin
      Try
        pCriarFormularios(TfrmRcxDigCartoes, frmRcxDigCartoes);

        frmRcxDigCartoes.pGarantirCancelamentoTefRecebimento(fatVenda.objTefRecebimento,
                                                             fatVenda.strArquivoTef);
      Finally
        pFreeAndNil(frmRcxDigCartoes);
      End;
    End;

    if Assigned(frmFatMostraProdNaoDevolver) then
      pFreeAndNil(frmFatMostraProdNaoDevolver);

    InterlockedDecrement(intConfirmando);
    Close;
  End
  Else
  Begin
    InterlockedDecrement(intConfirmando);
    Exit;
  End;

end;


