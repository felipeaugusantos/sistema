  End;

end;

function TfrmFatVendas.fIncluirItem(strCodIte,
                                    strNumLot: String;
                                    fltQtdIte: Double;
                                    fltUnitar: Double = 0;
                                    strSeqRcd: String = '';
                                    strDesIteRemessaEqu: String = '';
                                    strNcmIte: String = '';
                                    fltDescon: Double = 0;
                                    AstrDescricaoItem : String = '';
                                    AMantemPreco: Boolean = False;
                                    ACodEmpresa: String = '';
                                    ACompleItem: String = '';
                                    strEntRet: String = '';
                                    strLocRet: String = '';
                                    strMotFut: String = '';
                                    strEntFut: String = ''): Boolean;
Var
  intQtdReg: Integer;
  qryIteGer: TUniQuery;
  fltUniLiq : Double;
begin
  intQtdReg := cdsVenda.RecordCount;

  chkCheckOut.Checked := False;
  rdbCodIte.Checked := True;
  btnCancelaItem.Click;

  edtCodIte.Text := strCodIte;
  //fltUniLiq := 0; Hint

  If pnlEmpresa.Visible And pnlEmpresa.Enabled And (not fEmptyStr(ACodEmpresa)) Then
  Begin
    edtCodEmp.Text := ACodEmpresa;
  End;

  pCarregaItem(True, True, False, True);

  If qryConCit.IsEmpty Then
  Begin
    If (Not Assigned(objImpulsionadorVendasCRM)) Or (Assigned(objImpulsionadorVendasCRM) And (objImpulsionadorVendasCRM.blnInserirItemManualmente)) Then
      FatVenda.pMostraMensagem('', 'O item "'+ strCodIte +'" não está cadastrado!', edtCodIte.Text);

    Exit(False);
  End;

  If (Not fEmptyStr(ACompleItem)) Then
  Begin
    cbbComple.Text := ACompleItem;
  End;

  If (fatVenda.intIdxPri = IDX_VAZIO) Then
  Begin
    If (fatVenda.blnCliFil) Then
    Begin
      If fCfgSis('SUG_TE', VarString, fGetEmpConfigEntrega) = 'S' Then
        fatVenda.intIdxPri := IDX_ENTREGA
      Else
        fatVenda.intIdxPri := IDX_RETIRA;
    End
    Else
    Begin
      If fCfgSis('SUJROM', VarString, fGetEmpConfigEntrega) = 'S' Then
        fatVenda.intIdxPri := IDX_ENTREGA
      Else
        fatVenda.intIdxPri := IDX_RETIRA;
    End;

    pSetaCampoDestino(False);
  End;

  edtNumLot.Text := strNumLot;

  if (fatVenda.strOpcDoc = 'TE') and (not fEmptyStr(strNumLot)) and (UpperCase(strNumLot) = 'A DEFINIR') then
  begin
    edtNumLot.Text := fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(strCodIte);

    if fEmptyStr(edtNumLot.Text) then
    begin
      edtNumLot.Text := strNumLot;
    end;
  end;

  fltQtdDigAnt   := fStrToFloat(edtQtdIte.Text);
  edtQtdIte.Text := FloatToStrF(fltQtdIte, ffFixed,12, fCfgSis('DECQTD', varInteger));

  if not fEmptyStr(strEntRet) then
  begin
    if strEntRet = 'E' then
      cmbEntRet.ItemIndex := IDX_ENTREGA
    else
      cmbEntRet.ItemIndex := IDX_RETIRA;
    cmbEntRetChange(Nil);

    If (strEntRet = 'E') And (Not fEmptyStr(strEntFut)) Then
    Begin
      If (strEntFut = 'S') Then
        cmbTipEnt.ItemIndex := IDX_ENTREGA_FUTURA
      Else
        cmbTipEnt.ItemIndex := IDX_ENTREGA_IMEDIATA;

      cmbTipEntChange(Nil);
    End;

  end;

  if not fEmptyStr(strLocRet) then
  begin
    cmbLocRet.ItemIndex := fRetLocalRetira(strLocRet);
  end;

  if not fEmptyStr(strMotFut) then
  begin
    cmbMotEntFut.ItemIndex := fMotivoEntFutToIndex(strMotFut);
  end;

  if (fCfgSis('VENMTL', varBoolean)) And (pnlQtdMadeira.Visible) then
    edtQtdPec.Text := FloatToStrF(fltQtdIte, ffFixed,12, fCfgSis('DECQTD', varInteger));

  edtQtdIteExit(edtQtdIte);

  If fltUnitar > 0.00 Then
    edtUnitar.Text := FloatToStrF(fltUnitar, ffFixed,12, fatVenda.VS_intDecUni);

  if Assigned(objTintaMaquinaDeOutroPedido) then
  begin

    recForTin.Formulas := Nil;

    if not fImportaTintaDeMaquinaDeOutroPedido then
    begin
      btnCancelaItem.Click;
      Exit(False);
    end;

    {Carregar impostos}
    If (objTintaMaquinaDeOutroPedido.TipoPrecoItem = tpPrecoDocumentoOriginalComDesconto) Or
       (objTintaMaquinaDeOutroPedido.TipoPrecoItem = tpPrecoDocumentoOriginalSemDesconto) Then
    Begin

      qryIteGer := fCriaQuery();

      Try

        qryIteGer.Close;
        qryIteGer.SQL.Clear;
        qryIteGer.SQL.Add('SELECT * FROM ITEGER WHERE ITE_CODITE = :CODITE AND ITE_CODEMP = :CODEMP');
        qryIteGer.ParamByName('CODITE').AsString := strCodIte;
        qryIteGer.ParamByName('CODEMP').AsString := objTintaMaquinaDeOutroPedido.EmpresaPedidoOriginal;
        qryIteGer.Open;

        If Not qryIteGer.IsEmpty Then
        Begin

          If (fCfgSis('IMPCF4') = 'S') Then
            fatVenda.fltIcmSai := fatVenda.fCalculaAliquota(strCodIte, qryIteGer.FieldByName('ITE_CODEMP').AsString,
              fatVenda.GetImpDir(strCodIte, qryIteGer.FieldByName('ITE_CODEMP').AsString))
          Else
            fatVenda.fltIcmSai := IfNull(qryIteGer.FieldByName('ITE_ICMSAI').AsFloat, 0);

          fatVenda.fltOutVal := IfNull(qryIteGer.FieldByName('ITE_OUTVAL').AsFloat, 0);
          fatVenda.fltImpFed := IfNull(qryIteGer.FieldByName('ITE_IMPFED').AsFloat, 0);
          fatVenda.fltDesOpe := IfNull(qryIteGer.FieldByName('ITE_DESOPE').AsFloat, 0);

          fatVenda.fltPreMed := IfNull(qryIteGer.FieldByName('ITE_PREMED').AsFloat, 0);
          fatVenda.fltImpUlt := IfNull(qryIteGer.FieldByName('ITE_IMPULT').AsFloat, 0);
          fatVenda.fltPreUlt := IfNull(qryIteGer.FieldByName('ITE_PREULT').AsFloat, 0);
          fatVenda.fltPreCus := objTintaMaquinaDeOutroPedido.PrecoDeCusto;

        End;

      Finally
        FreeAndNil(qryIteGer);
      End;

    End;

    If (fltUnitar = 0.00) Then
      pRecalcularPrecosTinta;

    pCalculaTotIte;

  end;

  edtDesCon.Text := FloatToStrF(fltDescon, ffFixed, 5, intDecDes);

  strIteSeqRcd := strSeqRcd;
  blnMantemPrecoUnitario := AMantemPreco;

  if not fEmptyStr(AstrDescricaoItem) then
    edtDesIte.Text := AstrDescricaoItem;

  If Assigned(objImpulsionadorVendasCRM) Then
  Begin
    If objImpulsionadorVendasCRM.blnInserirItemManualmente Then
      Exit(False)
    Else
    Begin
      If objImpulsionadorVendasCRM.intTipPreco = 1 Then
      Begin
        fltUnitar := objImpulsionadorVendasCRM.fRetPrecoVenda(edtCodIte.Text);
        fltUniLiq := (objImpulsionadorVendasCRM.fGetCdsVendas as TUniClientDataSet).FieldByName('UNITAR').AsFloat;
        fltDescon := fatVenda.fCalculaDescontoItem(fltUnitar, fltUniLiq);
        fltDescon := IIF(fltDescon <= 0, 0, fltDescon);
        edtUnitar.Text := FloatToStrF(fltUnitar, ffFixed, 5, intDecDes);
        edtUniLiq.Text := FloatToStrF(fltUniLiq, ffFixed, 5, intDecDes);
        edtDesCon.Text := FloatToStrF(fltDescon, ffFixed, 5, intDecDes);
      End;
    End;
  End;

  btnAdicionar.Click;

  if (not blnEhMultiLote) then
    btnCancelaItem.Click;

  If (blnConEqu) And
     (Not fEmptyStr(strDesIteRemessaEqu)) And
     (Not fEmptyStr(strNcmIte)) And
     (strOpcDoc = 'OU') Then Begin
    cdsVenda.Edit();
    cdsVenda.FieldByName('ITE_DESITE').AsString := strDesIteRemessaEqu;
    cdsVenda.FieldByName('ITE_CLAIPI').AsString := strNcmIte;
    cdsVenda.Post();
  End;

  if Assigned(objTintaMaquinaDeOutroPedido) then
  begin
    strCodDil := '';
    fltPorDil := 0.0;
    strDilCon := '';
    fltPorCat := 0.0;
  end;

  Result := cdsVenda.RecordCount > intQtdReg;
end;

procedure TfrmFatVendas.pAdicionaItemAutomatico(blnValidou,
  blnInserido: Boolean);
  var
    fltQtdIte: Double;
    strCodIte, strTabPre: String;
Begin
  If (Not fEmptyStr(edtCodIte.Text)) And
     (blnValidou Or fValidaCampos(edtCodIte, True)) Then
  Begin

    fltQtdIte := fStrToFloat(edtQtdIte.Text);

    If SameValue(fltQtdIte, 0) Then
    fltQtdIte := 1.000;

    If strOpcDoc = 'TR' Then
    Begin
      If fMensagem('', 'Selecione o tipo de movimento!', ['&Entrada','&Saída']) = 1 Then
        cmbEntSai.ItemIndex := 0  // 0 - Entrada 1 - Saída
      Else
        cmbEntSai.ItemIndex := 1; // 0 - Entrada 1 - Saída
    End;

    If (Not fItemUtilizaLocalDeRetira) Then
      blnInserido := cdsVenda.Locate('ITE_CODITE;ITE_ENTSAI;ITE_UNITAR', VarArrayOf([fCodItem, cmbEntSai.Text[1], fStrToFloat(edtUnitar.Text)]), [])
    Else
      blnInserido := cdsVenda.Locate('ITE_CODITE;ITE_ENTSAI;ITE_LOCRET;ITE_UNITAR', VarArrayOf([fCodItem, cmbEntSai.Text[1], fRetornaLocalRetira, fStrToFloat(edtUnitar.Text)]), []);

    If blnInserido Then
    Begin
      pSetFocus(dbgItens);
      pCarregaItensAlteracao;
      fltQtdIte := fStrToFloat(edtQtdIte.Text) + fltQtdIte;
    End;

    If (fLiberarInfQtdChechOutPedido) And (fltQuantidadeCheckOut > 0) Then
    Begin
      fltQtdIte := IIF(blnInserido, fStrToFloat(edtQtdIte.Text), 0) + fltQuantidadeCheckOut;
      fltQuantidadeCheckOut := 0;
    End;

    {**************************************************}
    {* ALTERA A QTD DO ITEM E EXECUTA O EXIT DO MESMO *}
    {***********************************************JC*}
    fltQtdDigAnt   := fStrToFloat(edtQtdIte.Text);
    edtQtdIte.Text := FloatToStrF(fltQtdIte, ffFixed, 12, fCfgSis('DECQTD', varInteger));
    edtQtdIteExit(edtQtdIte);

    strCodIte := fCodItem;
    strTabPre := fTabelaPrecoItem;

    btnAdicionar.Click;
    btnCancelaItem.Click;

    pAgrupaItensComDescontoEmbalagemFechada(strCodIte, strTabPre);
  End;
end;

procedure TfrmFatVendas.pCarregaEstrutura(strCodIte, strEmpIte: String; fltQtdIte, fltDesCon: Double; fltTotIte: Double = 0; fltTotOri: Double = 0; blnConcreto: Boolean = False);
  Var
    objItensEstrutura: TItensEstrutura;
    subItem: TSubItemEstrutura;
    intItem: Integer;
    strNumLotPai: String;
    blnEmissaoEstruturaWMS: Boolean;
    blnInformaLoteADefinir: Boolean;
    dicAux: TDicionario;
    dicPreVenOriSubItens: TDicionario;
    frmCadLotSubItensEstrutura : TfrmCadLotSubItensEstrutura;
    intIdxEntRet,
    intIdxTipEnt,
    intModalResult : Integer;

    fltPrecoEstrutura : Double;

  function fVerificaImpLisEstrutura: Boolean;
    Var
      strItens: String;
      intItem : Integer;
  Begin
    strItens := '';
    Result   := True;

    For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
    Begin
      subItem := objItensEstrutura[intItem];

      If subItem.strImpLis <> 'S' Then
      Begin
        Result   := False;
        strItens := strItens + subItem.strCodigo + ' - ' + fRetNomProduto(subItem.strCodigo) + Chr(13) ;
      End;

    End;

    If Not Result Then
    Begin
      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.lblMensagem.Caption := 'Itens estrutura com "Imprime Lista" definido como "N", Regularizar!:';
        frmObservacao.memObs.Texto := strItens;
        frmObservacao.ShowModal;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '[fVerificaImpLisEstrutura]');
      End;
      pFreeAndNil(frmObservacao);
    End;

  End;

  function fDeveInformarLote : Boolean;
  Begin
    Result := True;

    If (blnEmissaoEstruturaWMS) And (strNumLotPai = 'A DEFINIR')  Then
      Result := False;
  End;

  function fRetornaVlrEstrutura: Double;
  Begin
    Result := fRetPrecoVenda(strCodIte, fTabelaPrecoItem, fCodEmp);
  End;

Begin
  Try
    dicAux := TDicionario.Create;
    dicPreVenOriSubItens := TDicionario.Create;

    objItensEstrutura := TItensEstrutura.Create;

    If objEstruturaPersonalizada.blnEstruturaFoiPersonalizada Then
      objItensEstrutura.pSetObjEsttruturaPersonalizada(objEstruturaPersonalizada);

    fatVenda.intIdxPri := cmbEntRet.ItemIndex;

    If (cbTabPrecoItem.Visible) Then
      dicAux['cbTabPrecoItem'] := cbTabPrecoItem.ItemIndex;
    If (cmbEntRet.Visible) Then
      dicAux['cmbEntRet'] := cmbEntRet.ItemIndex;
    If (cmbLocRet.Visible) Then
      dicAux['cmbLocRet'] := cmbLocRet.ItemIndex;
    If (cmbTipEnt.Visible) Then
      dicAux['cmbTipEnt'] := cmbTipEnt.ItemIndex;
    If (cmbMotEntFut.Visible) Then
      dicAux['cmbMotEntFut'] := cmbMotEntFut.ItemIndex;
    If (cmbCliBus.Visible) Then
      dicAux['cmbCliBus'] := cmbCliBus.ItemIndex;
    If (cmbTurEnt.Visible) Then
      dicAux['cmbTurEnt'] := cmbTurEnt.ItemIndex;
    If (mskDtaEnt.Visible) Then
      dicAux['mskDtaEnt'] := mskDtaEnt.Text;

    strNumLotPai := edtNumLot.Text;
    
    intIdxEntRet := -1;
    intIdxTipEnt := -1;
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (pnlEntrega.Visible) Then
    Begin
      intIdxEntRet := cmbEntRet.ItemIndex;
      intIdxTipEnt := cmbTipEnt.ItemIndex;
    End;

    pLimpaDadosItem(True);

    If (fMostraGridSubItens) Then
    Begin
      pMostraGridSubItens(True);

      If blnConcreto Then
      Begin
        fatVenda.cdsDadosSubItensEst.Tag := 0;
        fatVenda.cdsDadosSubItensEst.EmptyDataSet;
      End;
    End;

    If (dicAux['cbTabPrecoItem'] <> NULL) Then
      cbTabPrecoItem.ItemIndex := dicAux['cbTabPrecoItem'];

    fltPrecoEstrutura := fatVenda.fCalculaPrecoEstrutura(False,
                                                         Preco_de_Venda,
                                                         strCodIte,
                                                         strEmpIte,
                                                         'S',
                                                         IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''),
                                                         fStrToFloat(edtMargem.Text),
                                                         fltQtdIte,
                                                         objItensEstrutura,
                                                         False,
                                                         0,
                                                         IIF(fCfgSis('RATEST', varString) = 'S', fRetornaVlrEstrutura, 0));
    If (fltPrecoEstrutura > 0) Then
    Begin
      Try
        If (Not fCfgSis('EXILIS', varBoolean)) And (Not fVerificaImpLisEstrutura) Then
          Exit;

        Screen.Cursor     := crHourGlass;

        blnEmissaoEstruturaWMS := (Pos(strOpcDoc,'OR_PD_') > 0) And (fUsaRotinaWMS(VS_strCodEmp) Or fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text));
        
        rdbCodFab.Checked := False;
        rdbCodIte.Checked := True;

         If (fltTotIte <> 0) Then
         Begin
           If (fCfgSis('CNDVEN') = 'I') And
              (fCfgSis('USACND', varBoolean)) And
              (fCfgSis('PFLCLI', varBoolean)) Then
           Begin
             fatVenda.blnCarregandoEstruturaRateandoValorSugeridoSubItens := True;
           End;
         End;
        fatVenda.blnCarregandoEstrutura         := True;
        fatVenda.blnCarregandoEstruturaConcreto := blnConcreto;

        fatVenda.strCodItemEstrutura := strCodIte;
        fatVenda.intSeqInclusaoEstrutura := fRetornaSequencialUnico('SINCPD');

        pProcessMessages;
        pgbProgresso.Visible := True;
        pgbProgresso.Max     := objItensEstrutura.ItemsCount;

        If objEstruturaPersonalizada.blnEstruturaFoiPersonalizada Then
        Begin
          fltTotOri := fltPrecoEstrutura;
          fltTotIte := fltPrecoEstrutura;
        End;

        //Armazena o preco da estrutura original para realizar trava de preco (deve ficar antes de objItensEstrutura.pAcertarPrecos)
        If fltTotOri > 0 Then
          objItensEstrutura.pAcertarPrecos(fltTotOri);

        fatVenda.fltUnitarioItemEstrutura := objItensEstrutura.fltUnitarioItemEstrutura;
        For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
          dicPreVenOriSubItens[objItensEstrutura[intItem].strCodigo] := objItensEstrutura[intItem].fltPreVen;

        If fltTotIte > 0 Then
          objItensEstrutura.pAcertarPrecos(fltTotIte);

        If CompareValue(fFormataFloat(fltTotOri, 2), fFormataFloat(fltTotIte, 2), 0.02) = EqualsValue Then
        Begin
          For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
            dicPreVenOriSubItens[objItensEstrutura[intItem].strCodigo] := objItensEstrutura[intItem].fltPreVen;
        End;

        {Definir lotes para os sub-produtos, caso exista!}
        If (fDeveInformarLote) Then
        Begin

          frmCadLotSubItensEstrutura := TfrmCadLotSubItensEstrutura.Create(Self);
          frmCadLotSubItensEstrutura.Caption:= frmCadLotSubItensEstrutura.Caption + ' - ' + strCodIte + ' - ' + fRetNomProduto(strCodIte);
          frmCadLotSubItensEstrutura.strOpcDoc:= strOpcDoc;

          frmCadLotSubItensEstrutura.intIdxEntRet := intIdxEntRet;
          frmCadLotSubItensEstrutura.intIdxTipEnt := intIdxTipEnt;

          blnInformaLoteADefinir := (Pos(strOpcDoc,'OR_PD_') > 0) And (fUsaRotinaWMS(VS_strCodEmp) Or fatVenda.fEmpresaParaFaturamentoUsaWMS(IIF(fEmptyStr(strEmpIte), VS_strCodEmp, strEmpIte)));

          For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
          Begin
            subItem := objItensEstrutura[intItem];
            If fatVenda.objCadLot.fExisteLote(subItem.strCodigo, IIF(fEmptyStr(strEmpIte), VS_strCodEmp, strEmpIte)) Then
            begin
              if (fCfgSis('FTLTPR', varBoolean) And (Not(blnInformaLoteADefinir))) then
                frmCadLotSubItensEstrutura.fInserirItem(
                  subItem.strCodigo,
                    IIF(fEmptyStr(strEmpIte), VS_strCodEmp, strEmpIte),
                      blnInformaLoteADefinir,
                    fatVenda.objCadLot.fRetArmazemPrincipalOrcamentoPedidoVenda(subItem.strCodigo), subItem.fltQtdSub, (subItem.fltQtdSub * objItensEstrutura.fltQuantidadeItemEstrutura))
              else
                frmCadLotSubItensEstrutura.fInserirItem(
                  subItem.strCodigo,
                    IIF(fEmptyStr(strEmpIte), VS_strCodEmp, strEmpIte),
                      blnInformaLoteADefinir, '', subItem.fltQtdSub, (subItem.fltQtdSub * objItensEstrutura.fltQuantidadeItemEstrutura));
            end;
          End;

          If frmCadLotSubItensEstrutura.fExisteLoteParaInformar Then
          Begin

            repeat

              intModalResult := frmCadLotSubItensEstrutura.ShowModal;

              If (intModalResult = mrCancel) Then
                Exit;

            until (intModalResult = mrOk);

          End;

        End;

        For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
        Begin

          If not fEmptyStr(strEmpIte) Then
            edtCodEmp.Text := strEmpIte;

          subItem := objItensEstrutura[intItem];

          pgbProgresso.Position := Succ(intItem);

          edtCodIte.Text := subItem.strCodigo;
          edtQtdIte.Text := FloatToStr(subItem.fltQtdTot);
          
          pCarregaItem(True, True, False, True);

          {Lote}
          If (fDeveInformarLote) Then
          Begin
            If fatVenda.objCadLot.fExisteLote(subItem.strCodigo, IIF(fEmptyStr(strEmpIte), VS_strCodEmp, strEmpIte)) Then
              edtNumLot.Text := frmCadLotSubItensEstrutura.fRetLotInformado(subItem.strCodigo);
          End
          Else
          Begin
            If (blnEmissaoEstruturaWMS) And 
               (pnlItemLote.Visible) And 
               (strNumLotPai = 'A DEFINIR') Then
            Begin
              edtNumLot.Text := 'A DEFINIR';
              If (Not fatVenda.objCadLot.fExisteLote(subItem.strCodigo,
                                                     IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD),
                                                    'A DEFINIR', False)) Then
              Begin
                pMensagemOk('Sub-Item Estrutura ' + 
                            subItem.strCodigo + '-' +
                            fRetNomProduto(subItem.strCodigo) + ' não possui Lote A DEFINIR cadastrado!');
                edtNumLot.Text := '';                                    
              End;
            End;
          End;

          If blnUtilizaVendaMadeira Then
          Begin
            edtQtdPec.Text := FloatToStr(subItem.fltQtdPec);
            edtComPec.Text := FloatToStr(subItem.fltComPec);
            edtLarPec.Text := FloatToStr(subItem.fltLarPec);
            edtEspPec.Text := FloatToStr(subItem.fltEspPec);
            edtAparel.Text := subItem.strAparel;
            edtBenefi.Text := subItem.strBenefi;
            edtPerApa.Text := FloatToStr(subItem.fltPerApa);
            edtPerBen.Text := FloatToStr(subItem.fltPerBen);
          End;

          edtDesCon.Text := FloatToStrF(fltDesCon, ffFixed, 5, intDecDes);

          If (dicAux['cbTabPrecoItem'] <> NULL) Then
          Begin
            cbTabPrecoItem.ItemIndex := dicAux['cbTabPrecoItem'];
            If (cbTabPrecoItem.Visible) Then
            Begin
              blnEvocouOnChangeCbTabPrecoItem := True;
              cbTabPrecoItemChange(Nil);
              blnEvocouOnChangeCbTabPrecoItem := False;
            End;  
            strTabPreIteAnt := strTabPreItePrincipalAnt;
          End;
          If (dicAux['cmbEntRet'] <> NULL) Then
          Begin
            cmbEntRet.ItemIndex := dicAux['cmbEntRet'];
            If cmbEntRet.Enabled Then
              cmbEntRetChange(Nil);
          End;
          If (dicAux['cmbTipEnt'] <> NULL) Then
          Begin
            cmbTipEnt.ItemIndex := dicAux['cmbTipEnt'];
            If cmbTipEnt.Enabled Then
              cmbTipEntChange(Nil);
          End;
          If (dicAux['cmbLocRet'] <> NULL) Then
          Begin
            cmbLocRet.ItemIndex := dicAux['cmbLocRet'];
            If cmbLocRet.Enabled Then
              cmbLocRetChange(Nil);
          End;
          If (dicAux['cmbMotEntFut'] <> NULL) Then
          Begin
            cmbMotEntFut.ItemIndex := dicAux['cmbMotEntFut'];
            If cmbMotEntFut.Enabled Then
              cmbMotEntFutChange(Nil);
          End;
          If (dicAux['cmbCliBus'] <> NULL) Then
            cmbCliBus.ItemIndex := dicAux['cmbCliBus'];
          If (dicAux['cmbTurEnt'] <> NULL) Then
            cmbTurEnt.ItemIndex := dicAux['cmbTurEnt'];
          If (dicAux['mskDtaEnt'] <> NULL) Then
            mskDtaEnt.Text := dicAux['mskDtaEnt'];

          pLabelInformacaoGrid(IIF(fAlterandoProduto, 'Alterando', 'Inserindo') + ' Produto (' + edtDesIte.Text + ')');

          fltQtdDigAnt   := fStrToFloat(edtQtdIte.Text);

          //Carrega o preco de venda do item estrutura para utilizar na trava de preco
          fatVenda.fltQuantidadeSubItemEstrutura := subItem.fltQtdTot / objItensEstrutura.fltQuantidadeItemEstrutura;
          fatVenda.fltUnitarioSubItemEstrutura := dicPreVenOriSubItens[subItem.strCodigo];

          If blnConcreto Then
          Begin
            edtUnitar.Text := FloatToStrF(fatVenda.fltPreCus, ffFixed, 12, fatVenda.VS_intDecUni);
            pCalculaTotIte;
            fltUniDig := fStrToFloat(edtUnitar.Text);
            fltValorOriginalItemEstrutura := fStrToFloat(edtUnitar.Text);
            pAdicionaItem(VS_strCodEmp);
          End
          Else
          Begin
            If fltTotIte > 0 Then
            Begin
              edtDesCon.Text := FormatFloat(fMskDigitos(intDecDes), 0);
              edtUnitar.Text := FloatToStrF(subItem.fltPreVen, ffFixed, 12, fatVenda.VS_intDecUni);
              fltValorOriginalItemEstrutura := IIF(subItem.fltPreVenSemJuros = 0, subItem.fltPreVen, subItem.fltPreVenSemJuros);
            End;

            pAdicionar;
          End;

          pLabelInformacaoGrid('');

          pLimpaDadosItem;
        End;

      Finally

        fatVenda.blnCarregandoEstrutura         := False;
        fatVenda.blnCarregandoEstruturaConcreto := False;
        fatVenda.blnCarregandoEstruturaRateandoValorSugeridoSubItens := False;

        fatVenda.strCodItemEstrutura := '';
        fatVenda.intSeqInclusaoEstrutura := 0;
        fatVenda.fltUnitarioItemEstrutura := 0;
        fatVenda.fltQuantidadeSubItemEstrutura := 0;
        fatVenda.fltUnitarioSubItemEstrutura := 0;
        pgbProgresso.Visible   := False;
        pgbProgresso.Position  := 0;
        Screen.Cursor          := crDefault;

        If Assigned(frmCadLotSubItensEstrutura) Then
          pFreeAndNil(frmCadLotSubItensEstrutura);

        pLimpaDadosItem;

      End;
    End;

    //Prestcon
    If (strOpcDoc = 'VN') And (fatVenda.fEhVendaConcreto) And (MatchStr(fCfgSis('TPNFCR'), [PRESTCON])) Then
    Begin
      fatVenda.cdsDadosSubItensEst.Tag := 1;
      fatVenda.pCalculaPrecoCustoConcreto;
    End;

    pAtualizaUnitarioLiquido;

  Finally
    FreeAndNil(objItensEstrutura);
    FreeAndNil(dicPreVenOriSubItens);
    FreeAndNil(dicAux);
  End;
End;

