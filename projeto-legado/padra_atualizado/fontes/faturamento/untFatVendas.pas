function TfrmFatVendas.fTemItemTintometrico(blnFiltraEmpresaProducaoDiferenteEmpresaCD: Boolean=False): Boolean;
  Var
    cdsDados : TUniClientDataSet;
begin
  If (blnFiltraEmpresaProducaoDiferenteEmpresaCD) Then
    If (Not chkEntCD.Checked) Then
       Exit(False);

  cdsDados := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.Filtered := False;
    cdsDados.Filter := '(ITE_IDEPRO <> '+QuotedStr('NOR')+')';
    If (blnFiltraEmpresaProducaoDiferenteEmpresaCD) And (Not fEmptyStr(fatVenda.strEmp_CD)) Then
      cdsDados.Filter := cdsDados.Filter + ' AND (ITE_EMPPRD <> '+QuotedStr(fatVenda.strEmp_CD)+')';
    cdsDados.Filtered := True;

    Result := Not cdsDados.IsEmpty;
  Finally
    FreeAndNil(cdsDados);
  End;
end;

procedure TfrmFatVendas.pTrocaEmpresaProducaoTinta;
  Var
    intRecNo: Integer;
    strEmpPrdAnt: String;
begin
  //Ao mudar aqui verificar a necessidade de mudar ponto com referência REQ.: 182691
  If fatVenda.blnEmpfat Then
    Exit;

  If Not ((fCfgSis('OPRFLJ', varBoolean)) And (edtOprFlj.Visible)) Then
    Exit;

  If Not chkEntCD.Visible Then
    Exit;

  If edtOprFlj.Text = 'S' Then
    Exit; 

  intRecNo := cdsVenda.RecNo;
  cdsVenda.First;
  While (Not cdsVenda.Eof) Do
  Begin
    If (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
    Begin
      strEmpPrdAnt := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

      cdsVenda.Edit;

      If (chkEntCD.Checked) Or (blnSeEntregaPeloCDGarantirEmpresaProducaoAEmpresaCD) Then
      Begin
        cdsVenda.FieldByName('ITE_ESCPRD').AsInteger := 0;
        cdsVenda.FieldByName('ITE_EMPPRD').AsString := fatVenda.strEmp_CD;
      End
      Else
      Begin
        cdsVenda.FieldByName('ITE_EMPPRD').AsString := fatVenda.fEscolheEmpresaProducaoTinta(cdsVenda.FieldByName('ITE_IDEPRO').AsString);
      End;

      cdsVenda.Post;

      pRecalculaTintaMaquinaSelecionadoCasoNecessario(strEmpPrdAnt);
    End;

    cdsVenda.Next;
  End;
  cdsVenda.RecNo := intRecNo;
end;

