procedure TfrmFatVendas.edtMargemExit(Sender: TObject);
begin
  inherited;

  If fStrToFloat(edtMargem.Text) < 0 Then
  Begin
    fMensagem('ATENÇÃO!', 'A Margem de Lucro deve ser maior ou igual a Zero!', ['&O k']);
    pSetFocus(edtMargem);
  End

  Else If fatVenda.fltMargem <> fStrToFloat(edtMargem.Text) Then
  Begin
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Alteração da Margem de Lucro na Venda para ' + FormatFloat('#,##0.00', fStrToFloat(edtMargem.Text)) + '%.');

    objLiberacao.strDirAce := 'MARGE';
    objLiberacao.strSenLib := fCfgSis('SENIMA');
    objLiberacao.strMsgSen := 'Margem de Lucro';
    objLiberacao.strCodOpe := IIF(fEmptyStr(FatVenda.strCodVen), fRetCodVenDef(edtSenVen.Text), FatVenda.strCodVen);
    objLiberacao.strCodDig := FatVenda.strCodDig;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    If (fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
    Begin
      fatVenda.fltMargem := fStrToFloat(edtMargem.Text);
      pRecalculaPrecos;
      pCalculaTotais;
    End Else
    Begin
      edtMargem.Text := FormatFloat('#,##0.00', fatVenda.fltMargem);
      pSetFocus(edtMargem);
    End;
  End;

  edtCodCli.ReadOnly := Not blnPermiteAlterarCliente Or (fatVenda.fltMargem > 0);
end;

