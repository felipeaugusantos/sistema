procedure TfrmFatVendas.pAlimentaDataSetAgrupandoItensComDescontoEmbFechada(
  Const strCodIte: String; fltQtdTot: Double; cdsTmpIte: TUniClientDataSet);
  Var
    fltQtdTmp: Double;
begin
  cdsTmpIte.EmptyDataSet;

  cdsIteDesEmb.First;
  While Not cdsIteDesEmb.Eof Do
  Begin
    If CompareValue(fltQtdTot, cdsIteDesEmb.FieldByName('ITB_QTDEMB').AsFloat) = LessThanValue Then
      cdsIteDesEmb.Next
    Else
    Begin
      If SameValue(fltQtdTot, cdsIteDesEmb.FieldByName('ITB_QTDEMB').AsFloat) Then
        fltQtdTmp := cdsIteDesEmb.FieldByName('ITB_QTDEMB').AsFloat
      Else           //múltiplo da embalagem
        fltQtdTmp := Trunc(fltQtdTot / cdsIteDesEmb.FieldByName('ITB_QTDEMB').AsFloat) *
                     cdsIteDesEmb.FieldByName('ITB_QTDEMB').AsFloat;

      cdsTmpIte.Append;
      cdsTmpIte.FieldByName('ITE_CODITE').AsString := strCodIte;
      cdsTmpIte.FieldByName('ITE_QTDITE').AsFloat  := fltQtdTmp;
      cdsTmpIte.Post;

      fltQtdTot := fltQtdTot - fltQtdTmp;

      If SameValue(fltQtdTot, 0) Then
        Break;

      cdsIteDesEmb.First;
    End;
  End;

  //caso haja quantidade restante, insere no dataset temporário
  If CompareValue(fltQtdTot, 0) = GreaterThanValue Then
  Begin
    cdsTmpIte.Append;
    cdsTmpIte.FieldByName('ITE_CODITE').AsString := strCodIte;
    cdsTmpIte.FieldByName('ITE_QTDITE').AsFloat  := fltQtdTot;
    cdsTmpIte.Post;
  End;
end;

procedure TfrmFatVendas.pAtualizaCdsVendaConformeAgrupamentoItensDescontoEmbFechada(
  Const strCodIte, strEntSai: String; cdsTmpIte: TUniClientDataSet);
  Var
    blnFiltered, blnAlterou, blnRemoveu: Boolean;
    strIndex, strFilter: String;
    prcScroll: TprcScroll;
begin
  blnAlterou  := False;
  blnRemoveu  := False;
  strIndex    := cdsVenda.IndexFieldNames;
  strFilter   := cdsVenda.Filter;
  blnFiltered := cdsVenda.Filtered;

  If cdsTmpIte.IsEmpty Then
    Exit;

  pDisableControls(cdsVenda, prcScroll);
  Try
    cdsVenda.Filtered := False;
    cdsVenda.Filter   := 'ITE_CODITE = '+ QuotedStr(strCodIte) +' AND ITE_ENTSAI = '+ QuotedStr(strEntSai) + IIF(fItemUtilizaLocalDeRetira, ' AND ITE_LOCRET = '+QuotedStr(fRetornaLocalRetira), '');
    cdsVenda.Filtered := True;

    //atualiza o cdsVenda caso esteja diferente do dataset temporário
    cdsVenda.First;
    cdsTmpIte.First;
    While Not cdsTmpIte.Eof Do
    Begin
      If (cdsTmpIte.RecNo > cdsVenda.RecNo) Or
         (Not SameValue(cdsTmpIte.FieldByName('ITE_QTDITE').AsFloat, cdsVenda.FieldByName('ITE_QTDITE').AsFloat)) Then
      Begin
        blnAlterou := True;

        pSetFocus(dbgItens);
        pCarregaItensAlteracao;

        fltQtdDigAnt   := IIF(cdsTmpIte.RecNo > cdsVenda.RecNo, 0, fStrToFloat(edtQtdIte.Text));
        edtQtdIte.Text := FloatToStrF(cdsTmpIte.FieldByName('ITE_QTDITE').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger));
        edtQtdIteExit(edtQtdIte); //atualiza o valor unitário

        If cdsTmpIte.RecNo > cdsVenda.RecNo Then
          btnAdicionar.Tag := 0;

        btnAdicionar.Click;
        btnCancelaItem.Click;
      End;

      cdsTmpIte.Next;
      cdsVenda.Next;
    End;

    While cdsVenda.RecordCount > cdsTmpIte.RecordCount Do
    Begin
      blnRemoveu := True;
      cdsVenda.Delete;
    End;

  Finally
    cdsVenda.Filter   := strFilter;
    cdsVenda.Filtered := blnFiltered;

    If blnAlterou Or blnRemoveu Then
    Begin
      pCalculaTotais;

      cdsVenda.IndexFieldNames := EmptyStr;
      fatVenda.fOrdemItem(cdsVenda, 'Delete', Nil);
      cdsVenda.IndexFieldNames := strIndex;
    End;

    pEnableControls(cdsVenda, prcScroll);
  End;
end;

procedure TfrmFatVendas.pAgrupaItensComDescontoEmbalagemFechada(Const strCodIte, strTabPre: String);
  Var
    fltQtdTot: Double;
    blnEnabled: Boolean;
    cdsTmpIte: TUniClientDataSet;
begin
  If Not fatVenda.fCarregaDescontoEmbFechada(strCodIte, strTabPre, cdsIteDesEmb) Then
    Exit;

  If cdsIteDesEmb.RecordCount < 2 Then
    Exit;

  fltQtdTot := fatVenda.fRetQtdDigitada(strCodIte, '', '', '', '', edtCodEmp.Text,
                                        False, False, False, False, False, '', '',
                                        cmbEntSai.Text[1], nil, IIF(fItemUtilizaLocalDeRetira, fRetornaLocalRetira, ''));

  If SameValue(fltQtdTot, 0) Then
    Exit;

  blnEnabled := pnlDadosItem.Enabled;

  cdsTmpIte := TUniClientDataSet.Create(Nil);
  Try
    pnlDadosItem.Enabled := False;

    cdsTmpIte.FieldDefs.Add('ITE_CODITE', ftString, fTamCodIte);
    cdsTmpIte.FieldDefs.Add('ITE_QTDITE', ftFloat);
    cdsTmpIte.CreateDataSet;

    pAlimentaDataSetAgrupandoItensComDescontoEmbFechada(strCodIte, fltQtdTot, cdsTmpIte);

    pAtualizaCdsVendaConformeAgrupamentoItensDescontoEmbFechada(strCodIte, cmbEntSai.Text[1], cdsTmpIte);
  Finally
    FreeAndNil(cdsTmpIte);

    pnlDadosItem.Enabled := blnEnabled;
    btnCancelaItem.Click;
  End;
end;

function TfrmFatVendas.fDigServico(strEspDoc : String) : Boolean;
  Var
    blnMosSer,
    blnFilEsp: Boolean;

    intContador: Integer;

    blnBriSer: Boolean;

    edtCodSer,
    edtValSer,
    edtQtdSer,
    edtUniSer,
    edtDesSer,
    edtDecSer: TEdit;
begin
  Result := False;

  If (blnConEqu) And (strOpcDoc = 'OU') Then
  Begin
    Result := True;
    Exit;
  End;

  blnFilEsp := IIF(fEmptyStr(strEspDoc), True, (Pos(strEspDoc, 'NF_EL_NS_MI_FF_OR_PD_') > 0));

  If fUsaServico And blnFilEsp And (strOpcDoc <> 'BR') Then
  Begin

    If (strEspDoc = 'PD') And (fEmptyStr(strEspOrc)) Then
    Begin
      fatVenda.pCarregaContrato;
    End;

    Try
      pCriarFormularios(TfrmFatDigServico, frmFatDigServico);

      frmFatDigServico.fatVenda := fatVenda;
      frmFatDigServico.pCarregarServicos;

      frmFatDigServico.fPedeEnderecoEntrega := fatVenda.fPedeEnderecoEntrega;
      frmFatDigServico.blnNFSeSubstituicao  := Self.blnNFSeSubstituicao;

      blnMosSer := True;
      If Pos(strOpcDoc, 'CP_OV_') > 0 Then
      Begin

        blnMosSer := False;
        blnBriSer := False;
        For intContador := 1 To 30 Do
        Begin
          edtCodSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtCodSe' + IntToStr(intContador)));
          edtValSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtValSe' + IntToStr(intContador)));
          If Pos(strOpcDoc, 'CP_') > 0 Then
            blnBriSer := GetPropValue(frmFatDigServico.objServicos, 'strBriS' + fStrZero(IntToStr(intContador), 2)) = 'S';

          If ((fEmptyStr(edtCodSer.Text)) Or ((fStrToFloat(edtValSer.Text) <= 0.0) And (Not blnBriSer))) and (not fatVenda.blnPedFabOSG) Then
          Begin
            edtCodSer.TabStop := False;
            edtCodSer.ReadOnly := True;
            edtValSer.ReadOnly := True;
          End
          Else
            blnMosSer := True;
        End;

      End;

      {********************************************************}
      {* QUANDO CONFIRMAÇÃO DE DOCUMENTOS READONLY NOS CAMPOS *}
      {****************************************************GB**}
      If (Pos(fatVenda.strOpcDoc, 'CF_CI_CP_') > 0) Then
      Begin

        For intContador := 1 To 30 Do
        Begin
          edtCodSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtCodSe' + IntToStr(intContador)));
          edtValSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtValSe' + IntToStr(intContador)));
          edtQtdSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtQtdSe' + IntToStr(intContador)));
          edtUniSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtUniSe' + IntToStr(intContador)));
          edtDesSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtDesSe' + IntToStr(intContador)));
          edtDecSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtDecSe' + IntToStr(intContador)));

          if (not fatVenda.blnPedFabOSG) then
          begin
            edtCodSer.ReadOnly := True;
            edtValSer.ReadOnly := True;
            edtQtdSer.ReadOnly := True;
            edtUniSer.ReadOnly := True;
            edtDesSer.ReadOnly := True;
            edtDecSer.ReadOnly := True;
          end;
        End;

        frmFatDigServico.btnIdentTodos.Visible := False;
        frmFatDigServico.blnSoVisualizaIdent   := True;
        frmFatDigServico.lblTmpMed.Visible     := False;
        frmFatDigServico.lblTmpTot.Visible     := False;
        frmFatDigServico.edtTotTmp.Visible     := False;
      End;

      {****************************************************}
      {* QUANDO O "PD" POSSUIR UMA "OS" VINCULADA, PODERÁ *}
      {* FAZER QUALQUER TIPO DE ALTERAÇÃO NO SERVIÇO.     *}
      {* A "OS" SERÁ REGRAVADA COM O MESMO NÚMERO.        *}
      {*************************************************RN*}
      If (fCfgSis('GER_OS', varBoolean))    And
         (Not fEmptyStr(fatVenda.strNumOS)) And
         (strEspDoc <> 'PD') Then
      Begin
        For intContador := 1 To 30 Do
        Begin
          edtCodSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtCodSe' + IntToStr(intContador)));
          edtQtdSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtQtdSe' + IntToStr(intContador)));
          edtDesSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtDesSe' + IntToStr(intContador)));
          edtDecSer := TEdit(fComponentByName(frmFatDigServico.fGetPanel(intContador), 'edtDecSe' + IntToStr(intContador)));

          edtCodSer.ReadOnly := True;
          edtQtdSer.ReadOnly := True;
          edtDesSer.ReadOnly := True;
          edtDecSer.ReadOnly := True;
        End;
      End;

      Result := (frmFatDigServico.ShowModal = mrOk);

      If Not (blnMosSer) Then
        Result := True;

      If (Result) And (blnMosSer){ And (strOpcDoc <> 'CF')} Then
      Begin
        fatVenda.FRecSer      := frmFatDigServico.objServicos.recServicos;

        If fUsaRateioDeServicos Then
        Begin
          fatVenda.pCalculaValUniRateioServico;
        End;

        edtTotSer.Text := FormatFloat('#,##0.00', fatVenda.fltTotSer);
      End;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[pDigServico]');
    End;

    pFreeAndNil(frmFatDigServico);

    If Not (Result And fatVenda.FRecSer.fTemCobranca) Then
    Begin
      pDeletaItemServico;
      fatVenda.pDeletaItemServicoMatriz;
      fatVenda.blnDocumentoTemServicos := False;
    End;

  End
  Else
  Begin

    Result := True;

    If fUsaRateioDeServicos Then
    Begin
      fatVenda.pCalculaValUniRateioServico;
    End;

    If (fCfgSis('USASER', varBoolean)) Then
    Begin
      pDeletaItemServico;
      fatVenda.pDeletaItemServicoMatriz;
      fatVenda.blnDocumentoTemServicos := False;
    End;
  End;
end;

procedure TfrmFatVendas.pDuplicaItem;
begin
  Try
    If (recDuplicaItem.fltQtdEst <> 0) And (Not fEmptyStr(recDuplicaItem.strCodIte)) Then
    Begin
      edtCodIte.Text := recDuplicaItem.strCodIte;

      If cbbComple.Visible And (Not fEmptyStr(recDuplicaItem.strComple)) Then
        cbbComple.Text := recDuplicaItem.strComple;

      strCodAtu      := recDuplicaItem.strCodIte;

      pCarregaItem(True, True);

      pLabelInformacaoGrid(IIF(fAlterandoProduto, 'Alterando', 'Inserindo') + ' Produto (' + edtDesIte.Text + ')');

      edtQtdIte.Text := FloatToStrF(recDuplicaItem.fltQtdEst, ffFixed, 12, fCfgSis('DECQTD', varInteger));
      edtDesCon.Text := FloatToStrF(recDuplicaItem.fltDesCon, ffFixed, 12, intDecDes);
      edtUnitar.Text := FloatToStrF(recDuplicaItem.fltUnitar, ffFixed, 12, fatVenda.VS_intDecUni);
      pAdicionar;

      pLabelInformacaoGrid('');

      recDuplicaItem.strCodIte := EmptyStr;
      recDuplicaItem.strComple := EmptyStr;
      recDuplicaItem.fltQtdEst := 0.00;
      recDuplicaItem.fltQtdPro := 0.00;
      recDuplicaItem.fltDesCon := 0.00;
      recDuplicaItem.fltUnitar := 0.00;
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[pDuplicaItem]');
  End;
End;

{**********************************}
{* FAZ A CHAMADA DA TELA DE ITEMS *}
{* AGREGADOS E OS INSERE SE       *}
{* NECESSÁRIO                     *}
{*******************************AF*}
procedure TfrmFatVendas.pInsereItemAgregado(strIdePro: String);
Var
  blnBuscarCodFab : Boolean;
Begin
  blnBuscarCodFab := rdbCodFab.Checked;
  blnInsercaoProdutoAgregadoComMultiLoja := fCfgSis('EMPFAT', varBoolean);

  Try
    Try

      pCriarFormularios(TfrmFatProdAgregados,frmFatProdAgregados);
      frmFatProdAgregados.fatVenda  := fatVenda;
      frmFatProdAgregados.strCodIte := qryConCit.FieldByName('ITE_CODITE').AsString;
      frmFatProdAgregados.strDesIte := qryConCit.FieldByName('ITE_DESITE').AsString;
      frmFatProdAgregados.strQtdIte := strQtdIte;
      If blnInsercaoProdutoAgregadoComMultiLoja Then
        frmFatProdAgregados.strCodEmp := cdsVenda.FieldByName('ITE_EMPITE').AsString
      Else
        frmFatProdAgregados.strCodEmp := IIF(fEmptyStr(fatVenda.strEmp_TE), VS_strCodEmp, fatVenda.strEmp_TE);
      frmFatProdAgregados.blnExiCompl := (fCfgSis('FATCOM', varBoolean)) And
                                         (fCampotabela('ITE_FATCOM', 'CADITE', ['ITE_CODITE'], [qryConCit.FieldByName('ITE_CODITE').AsString], False) = 'S') And
                                         (Not (fatVenda.blnDvComDta And fCfgSis('DCOPRO', varBoolean)));

      If cbTabPrecoItem.Visible Then
        frmFatProdAgregados.strTabPre := fTabelaDePrecoDosItens
      Else
        frmFatProdAgregados.strTabPre := fatVenda.strTabPre;

      frmFatProdAgregados.strIdePro := strIdePro;
      frmFatProdAgregados.blnfValidaMultiploVenda := (Not fDesconsideraMultiploVenda(cdsVenda.FieldByName('ITE_NFESTI').AsInteger));

      if frmFatProdAgregados.fCarregaItensAgregados then
        frmFatProdAgregados.ShowModal;

      If frmFatProdAgregados.ModalResult = mrOk Then
      Begin

        With frmFatProdAgregados Do
        Begin
          cdsProAgr.First;

          While Not cdsProAgr.Eof Do
          Begin

            {**************************************}
            {* SE QUANTIDADE FOR MAIOR QUE ZERO   *}
            {* INSERE O ITEM                      *}
            {***********************************AF*}
            If cdsProAgr.FieldByName('QTDITE').AsFloat > 0 Then
            Begin
              edtCodIte.Text := cdsProAgr.FieldbyName('CODITE').AsString;

              strCodAtu      := cdsProAgr.FieldbyName('CODITE').AsString;

              If blnBuscarCodFab Then
                rdbCodIte.Checked := True;

              pCarregaItem(True, True);

              pLabelInformacaoGrid(IIF(fAlterandoProduto, 'Alterando', 'Inserindo') + ' Produto (' + edtDesIte.Text + ')');

              cmbEntRet.ItemIndex    := intTmpIdxDes; cmbEntRetChange(nil);
              cmbTipEnt.ItemIndex    := intTmpIdxEnt; cmbTipEntChange(nil);
              cmbLocRet.ItemIndex    := intTmpIdxRet; cmbLocRetChange(nil);
              cmbMotEntFut.ItemIndex := intTmpIdxMot; cmbMotEntFutChange(nil);
              cmbCliBus.ItemIndex    := intTmpIdxBus;
              cmbTurEnt.ItemIndex    := intTmpIdxTur;
              If Not fEmptyStr(fTiraCaracEspeciais(strTmpEntrad)) Then
                mskDtaEnt.Text       := strTmpEntrad
              Else
                mskDtaEnt.Text       := '';

              edtDiaEnt.Text := '0';
              edtQtdIte.Text := FloatToStrF(cdsProAgr.FieldByName('QTDITE').AsFloat,ffFixed,12,fCfgSis('DECQTD', varInteger));
              edtDesCon.Text := FloatToStrF(cdsProAgr.FieldByName('PERDES').AsFloat,ffFixed,12,intDecDes);
              edtUnitar.Text := FloatToStrF(cdsProAgr.FieldByName('UNITAR').AsFloat,ffFixed,12,fatVenda.VS_intDecUni);
              pAtualizaUnitarioSugestao;

              If (cdsProAgr.FieldByName('TEMLOT').AsString = 'S') Then
                edtNumLot.Text := cdsProAgr.FieldByName('NUMLOT').AsString;

              cbbComple.Text := cdsProAgr.FieldByName('COMPLE').AsString;
              edtCodEmp.Text := frmFatProdAgregados.strCodEmp;

              fTravarDestino(True);

              pAdicionar;

              pLabelInformacaoGrid('');
            End;

            cdsProAgr.Next;
          End;
        End;

      End;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[pInsereItemAgregado]');
    End;
  Finally
    intTmpIdxDes := -1;
    intTmpIdxEnt := -1;
    intTmpIdxRet := -1;
    intTmpIdxMot := -1;
    intTmpIdxBus := -1;
    intTmpIdxTur := -1;
    strTmpEntrad := '';

    blnInsercaoProdutoAgregadoComMultiLoja := False;
    blnItemAgregado := False;
    pFreeAndNil(frmFatProdAgregados);

    pAtualizaUnitarioLiquido;

    If blnBuscarCodFab Then
      rdbCodFab.Checked := True;
  End;
End;

procedure TfrmFatVendas.cmbEntRetChange(Sender: TObject);
Var
  cdsDados : TUniClientDataSet;
  blnManha,
  blnTarde,
  blnNoite,
  blnAtribuiValor : Boolean;
  intTurno : Integer;
begin
  inherited;

  pHabilitaDesabilitaTipoDeEntregaLocalRetira(btnAdicionar.Tag=0);

  blnAtribuiValor := (btnAdicionar.Tag = 0);
  intTurno := -1;

  {Req: 134134 - Alteração do PD_OR_}
  If (Not fEmptyStr(fatVenda.strNumOrc)) And (Pos(fatVenda.strOpcDoc, 'PD_OR') > 0) Then
  Begin
    If (cdsVenda <> Nil) Then
    Begin
      cdsDados := TUniClientDataSet.Create(Nil);

      Try

        pCloneDataSet(cdsDados, cdsVenda);

        cdsDados.Filtered := False;
        cdsDados.Filter   := 'ITE_TURENT = ' + QuotedStr('MANHÃ') + ' Or ' + 'ITE_TURENT = ' + QuotedStr('Manhã');
        cdsDados.Filtered := True;
        blnManha := Not cdsDados.IsEmpty;

        cdsDados.Filtered := False;
        cdsDados.Filter   := 'ITE_TURENT = ' + QuotedStr('TARDE') + ' Or ' + 'ITE_TURENT = ' + QuotedStr('Tarde');
        cdsDados.Filtered := True;
        blnTarde := Not cdsDados.IsEmpty;

        cdsDados.Filtered := False;
        cdsDados.Filter   := 'ITE_TURENT = ' + QuotedStr('NOITE') + ' Or ' + 'ITE_TURENT = ' + QuotedStr('Noite');
        cdsDados.Filtered := True;
        blnNoite := Not cdsDados.IsEmpty;

        If blnManha And (Not blnTarde And Not blnNoite) Then
        Begin
          blnAtribuiValor := False;
          intTurno        := fatVenda.objTurno.fTurnoStrToInt('Manhã');
        End;

        If blnTarde And (Not blnManha And Not blnNoite) Then
        Begin
          blnAtribuiValor := False;
          intTurno        := fatVenda.objTurno.fTurnoStrToInt('Tarde');
        End;

        If blnNoite And (Not blnManha And Not blnTarde) Then
        Begin
          blnAtribuiValor := False;
          intTurno        := fatVenda.objTurno.fTurnoStrToInt('Noite');
        End;

      Finally
        FreeAndNil(cdsDados);
      End;
    End;
  End
  Else
  {Req: 134134 - Inclusão do PD_OR_}
  If (fEmptyStr(fatVenda.strNumOrc)) And (Pos(fatVenda.strOpcDoc, 'PD_OR') > 0) Then
  Begin

    If (cdsVenda <> Nil) Then
    Begin
      cdsDados := TUniClientDataSet.Create(Nil);

      Try

        pCloneDataSet(cdsDados, cdsVenda);

        If (cdsDados.RecordCount > 0) Then
        Begin

          cdsDados.First;

          If (cdsDados.FieldByName('ITE_TURENT').AsString = 'MANHÃ') Or
             (cdsDados.FieldByName('ITE_TURENT').AsString = 'Manhã') Then
          Begin
            blnAtribuiValor := False;
            intTurno        := fatVenda.objTurno.fTurnoStrToInt('Manhã');
          End
          Else
          If (cdsDados.FieldByName('ITE_TURENT').AsString = 'TARDE') Or
             (cdsDados.FieldByName('ITE_TURENT').AsString = 'Tarde') Then
          Begin
            blnAtribuiValor := False;
            intTurno        := fatVenda.objTurno.fTurnoStrToInt('Tarde');
          End
          Else
          If (cdsDados.FieldByName('ITE_TURENT').AsString = 'NOITE') Or
             (cdsDados.FieldByName('ITE_TURENT').AsString = 'Noite') Then
          Begin
            blnAtribuiValor := False;
            intTurno        := fatVenda.objTurno.fTurnoStrToInt('Noite');
          End;
        End;

      Finally
        FreeAndNil(cdsDados);
      End;
    End;

  End;

  fatVenda.objTurno.pMostraTurno(fatVenda.objTurno.fExibeTurno(strOpcDoc, cmbEntRet.ItemIndex),
                                 lblTurno,
                                 cmbTurEnt,
                                 blnAtribuiValor);

  If Not blnAtribuiValor Then
    cmbTurEnt.ItemIndex := intTurno;

  cmbTipEntChange(nil);
  cmbLocRetChange(nil);
  pCalculaPromocaoEntFut;

  If (blnInserindoCombo Or blnAlterandoCombo Or blnInserindoProdAtivacao Or blnAtualizarPnlDadosItemNaVendaModoTab) Then
    fatVenda.objComVen.setEntRet(LeftStr(cmbEntRet.Text, 1));

  If fUsaTabelaPrecoItemPorRetiraEntrega And (btnAdicionar.Tag = 0) Then
      pAtualizaTabPreRetiraEntrega;

  pHabilitarCheckPegou;

  {Sugerir prazo do fornecedor na inclusão para itens de entrega imediata!}
  pSugerirPrazoFornecedor;
  pSugerirDataEntregaFuturaPrevisao();

  If (fRecalculaPrecoLoteAoAlterarDestino) Then
  Begin
    fValidaCampos(edtNumLot);
  End;
end;

procedure TfrmFatVendas.cmbEntRetEnter(Sender: TObject);
begin
  inherited;
  If btnAdicionar.Tag <= 0 Then
    cmbEntRetChange(Sender);

  intEntRetAnt := cmbEntRet.ItemIndex;
end;

procedure TfrmFatVendas.cmbEntSaiChange(Sender: TObject);
  var
    fltDesMax : Double;  
begin
  inherited;

  If (strOpcDoc <> 'TR') Or (Not qryConIte.Active) Then
    Exit;

  If (fAlterandoProduto) Then
  Begin

    If (cmbEntSai.Text[1] <> cdsVenda.FieldByName('ITE_ENTSAI').AsString) Then
    Begin
      If cbTabPrecoItem.Visible Then
        fatVenda.fltUniOri := fatVenda.fRetPrecoTroca(cmbEntSai.Text[1], fTabelaDePrecoDosItens)
      Else
        fatVenda.fltUniOri := fatVenda.fRetPrecoTroca(cmbEntSai.Text[1], fatVenda.strTabPre);

      fatVenda.fltUniVis := fatVenda.fltUniOri;//Sem juros
      fatVenda.fltTaxJur := 0.00;

      If cmbEntSai.Text <> 'E' Then
      Begin
        If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
        Begin
          fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem);
          fatVenda.fltUniOri := fatVenda.fltUniOri + fFormataFloat(fatVenda.fltUniOri * (fatVenda.fGetTaxVprItem(edtCodIte.Text, fRetEmpresaItem) / 100.0), 04);
        End;
      End;

      fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);
    End
    Else
    Begin
      fatVenda.fltUniOri := cdsVenda.FieldByName('ITE_UNIORI').AsFloat;
      fatVenda.fltUniVis := cdsVenda.FieldByName('ITE_UNIVIS').AsFloat;
      fatVenda.fltTaxJur := cdsVenda.FieldByName('ITE_TAXJUR').AsFloat;
      fatVenda.fltVal_RT := cdsVenda.FieldByName('ITE_VAL_RT').AsFloat;
    End;

    edtUnitar.Text     := FloatToStrF(fatVenda.fltUniOri, ffFixed, 12, fatVenda.VS_intDecUni);

    {*******************************************}
    {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
    {* APLICA O PERCENTUAL DE DESCONTO         *}
    {****************************************MV*}
    If (fatVenda.strCAbDes = 'S') And
       (fCfgSis('CNDVEN') = 'I') And
       (fatVenda.strStatus <> 'C') And
       ((fatVenda.strPromoc <> 'S') Or
        (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
       (Not fAplicarTaxaJurosPrecoDigitado) Then
    Begin
      {********************************************************************}
      {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
      {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
      {****************************************************************MM**}
      fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

      If fCfgSis('DESCND',varBoolean) Then
      Begin
        If (fatVenda.strDstCnd = 'S') Then
        Begin
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
          edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
        End
        Else
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

      End

      Else If (fatVenda.strCodFpg = '007') Then
      Begin
        If (fatVenda.strAbDeCc = 'S') Then
          edtUnitar.Text :=  FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
      End
      Else
        edtUnitar.Text :=  FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
    End;

    If fAplicarDescontoRessarcimentoCAT Then
    begin
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fStrToFloat(edtUnitar.Text)));
    end
  End
  Else
  Begin
    If cbTabPrecoItem.Visible Then
      fatVenda.fltUniOri := fatVenda.fRetPrecoTroca(cmbEntSai.Text[1], fTabelaDePrecoDosItens)
    Else
      fatVenda.fltUniOri := fatVenda.fRetPrecoTroca(cmbEntSai.Text[1], fatVenda.strTabPre);

    fatVenda.fltUniVis := fatVenda.fltUniOri;//Sem juros
    fatVenda.fltTaxJur := 0.00;

    If cmbEntSai.Text <> 'E' Then
    Begin
      If (fatVenda.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
      Begin
        fatVenda.fltTaxJur := fatVenda.fGetTaxVprItem(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString);
        fatVenda.fltUniOri := fatVenda.fltUniOri + fFormataFloat(fatVenda.fltUniOri * (fatVenda.fGetTaxVprItem(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString) / 100.0), 04);
      End;
    End;

    fatVenda.pCalculaValorRT(fatVenda.FUniOri, fatVenda.FVal_RT);

    edtUnitar.Text     := FloatToStrF(fatVenda.fltUniOri, ffFixed, 12, fatVenda.VS_intDecUni);
    {*******************************************}
    {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
    {* APLICA O PERCENTUAL DE DESCONTO         *}
    {****************************************MV*}
    If (fatVenda.strCAbDes = 'S') And
       (fCfgSis('CNDVEN') = 'I') And
       (fatVenda.strStatus <> 'C') And
       ((fatVenda.strPromoc <> 'S') Or
        (fatVenda.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
       (Not fAplicarTaxaJurosPrecoDigitado) Then
    Begin
      {********************************************************************}
      {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
      {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
      {****************************************************************MM**}
      fltDesMax := fatVenda.fRetornaDescLinGru(edtCodIte.Text, fatVenda.strCodCnd);

      If fCfgSis('DESCND',varBoolean) Then
      Begin
        If (fatVenda.strDstCnd = 'S') Then
        Begin
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);
          edtDesCon.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fltDesMax);
        End
        Else
          edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fltUniOri);

      End

      Else If (fatVenda.strCodFpg = '007') Then
      Begin
        If (fatVenda.strAbDeCc = 'S') Then
          edtUnitar.Text :=  FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
      End
      Else
        edtUnitar.Text :=  FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fFormataFloat(fatVenda.fltUniOri - fatVenda.fRetornaVrDesconto(2, fatVenda.fltUniOri, fltDesMax), fatVenda.VS_intDecUni));
    End;

    If fAplicarDescontoRessarcimentoCAT Then
    begin
      edtUnitar.Text := FormatFloat(fMskDigitos(fatVenda.VS_intDecUni), fatVenda.fRetornaPrecoVendaComDescontoRessarcimentoCAT(fCodItem, fRetEmpresaItem, fatVenda.fGetCodAbf(fCodItem, fatVenda.fGetEmpCalculoItem(fRetEmpresaItem)), fTabelaPrecoItem, fStrToFloat(edtUnitar.Text)));
    end;
  End;

  pAtualizaUnitarioLiquido;

  fValidaCampos(cmbEntSai);

end;

