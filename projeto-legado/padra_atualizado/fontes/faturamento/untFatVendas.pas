procedure TfrmFatVendas.edtCodIteEnter(Sender: TObject);
Var
  blnNesTin: Boolean;
  strMsgTmp: String;
begin
  inherited;

  lblProdutoPromocao.Visible := False;

  If fEstaNaConsultaTab Then
    If Not blnTrocandoProduto Then
      Exit;

  If (strOpcDoc = 'OU') Then
  Begin
    HintControler.ShowHint(Self.Left + edtCodIte.Left + edtCodIte.Width,
                           125 + Self.Top + edtCodIte.Top + edtCodIte.Height,
                           'Pesquisar Item',
                           'Pressione "/" ou "?" para Pesquisa no cadastro de Itens' + #13#10 +
                           'Pressione [ Shift + F3 ] para utilizar Herança de Faturamento');
  End
  Else If (strOpcDoc = 'TE') Then
  Begin
    HintControler.ShowHint(Self.Left + edtCodIte.Left + edtCodIte.Width,
                           125 + Self.Top + edtCodIte.Top + edtCodIte.Height,
                           'Pesquisar Item',
                           'Pressione "/" ou "?" para Pesquisa no cadastro de Itens' + #13#10 +
                           IIF(fCfgSis('HERATE', varBoolean), 'Pressione [ F1 ] para utilizar herança de Transferências de Estoque' + #13#10, '') +
                           'Pressione [ Shift + F3 ] para utilizar Herança de Faturamento');
  End

  Else If (strOpcDoc = 'NE') And (Not fatVenda.blnComVal) Then
  Begin
    blnNesTin := fCfgSis('NESTIN', varBoolean) And fClientSelectEhClientFilialEmpLogada(edtCodCli.Text);

    strMsgTmp := 'Pressione "/" ou "?" para Pesquisa no cadastro de Itens';

    If (blnNesTin) Then
      strMsgTmp := strMsgTmp + #13#10 + 'Pressione [ F1 ] para utilizar herança de itens tintométrico por período';

    strMsgTmp := strMsgTmp + #13#10 + 'Pressione [ F2 ] para utilizar herança de itens para emissão de Nota de Complemento de valor';

    If fCfgSis('IMPDIR', varBoolean) And fCfgSis('CUPIPI', varBoolean) And fClientSelectEhClientFilialEmpLogada(edtCodCli.Text) Then
      strMsgTmp := strMsgTmp + #13#10 + 'Pressione [ F3 ] para utilizar herança de itens para emissão de Nota de Complemento de IPI';

    If (fEmissaoNFVendaABaseDeTroca) Then
      strMsgTmp := strMsgTmp + #13#10 + 'Pressione [ F4 ] para utilizar herança de itens recebidos na Venda a Base de Troca';

    HintControler.ShowHint(Self.Left + pnlDadosItem.Left + edtCodIte.Left + edtCodIte.Width,
                           Self.Top  + pnlDadosItem.Top  + edtCodIte.Top  + 50, 'Pesquisar Item', strMsgTmp);

  End;
end;

