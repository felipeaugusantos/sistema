function TfrmFatVendas.fPermiteItemEntregaParaConsumidor(blnResult: Boolean): Boolean;
begin
  Result := blnResult;

  {**************************************************************}
  {* VERIFICA SE PERMITE ENTREGA FUTURA PARA CLIENTE CONSUMIDOR *}
  {***********************************************************RV*}
  If (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
     (Not fCfgSis('PEFCON', varBoolean, fGetEmpConfigEntrega)) And
     (fClienteConsumidor(fatVenda.strCliOri, False, True)) And
     (Pos(strOpcDoc, 'VN_PD_OR_CS_' ) > 0) And (Not fEmptyStr(edtCodIte.Text)) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido Entrega Futura para Cliente Consumidor!', ['&OK']);
    Result := False;
  End;

  {****************************************************************}
  {* VERIFICA SE PERMITE ENTREGA IMEDIATA PARA CLIENTE CONSUMIDOR *}
  {*************************************************************FC*}
  If (cmbTipEnt.ItemIndex = IDX_ENTREGA_IMEDIATA) And //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
     (Not fCfgSis('PEICON', varBoolean, fGetEmpConfigEntrega)) And
     (fClienteConsumidor(fatVenda.strCliOri, False, True)) And
     (Pos(strOpcDoc, 'VN_PD_OR_CS_' ) > 0) And (Not fEmptyStr(edtCodIte.Text)) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido Entrega Imediata para Cliente Consumidor!', ['&OK']);
    Result := False;
  End;
end;

