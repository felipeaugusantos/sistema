    Result := fValidaCodFpg(fatVenda.strCodFpg, fatVenda.strConPag, blnExit);

  blnValidouTodosCampos := Result;//Req: 76504
end;

function TfrmFatVendas.fVerificaDebitosAtrasoLimiteCredito: Boolean;
begin
  Result := True;
  fatVenda.blnLibCre := False;

  {*******************************************************************}
  {* NO F10 ANTES DE GRAVAR O DOCUMENTO VERIFICA O LIMITE DE CREDITO *}
  {****************************************************************PZ*}
  If (Not fatVenda.blnCliFil) And
     (Not fClienteConsumidor(fatVenda.strCliOri,True, True)) Then
