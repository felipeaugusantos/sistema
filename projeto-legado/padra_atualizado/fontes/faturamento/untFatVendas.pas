function TfrmFatVendas.fVerificarTintaBaixaEntFut(strNumDoc, strEspDoc,strCodEmp: String): Boolean;
var
  Qry : TUniQuery;
begin

  Qry := Nil;

  try
    Qry := fCriaQuery;

    Qry.Close;
    Qry.SQL.Clear;
    Qry.SQL.Text := ' SELECT 1 FIRST '+
                    '   FROM TINDET '+
                    '  WHERE DET_CODEMP  = :CODEMP '+
                    '    AND DET_ESPDOC  = :ESPDOC '+
                    '    AND DET_NUMDOC  = :NUMDOC '+
                    '    AND DET_BAIXAD  = "N"     ';

    Qry.ParamByName('CODEMP').AsString := strCodEmp;
    Qry.ParamByName('ESPDOC').AsString := strEspDoc;
    Qry.ParamByName('NUMDOC').AsString := strNumDoc;

    Qry.Open;

    Result := Not(Qry.IsEmpty);

  finally
    FreeAndNil(Qry);
  end;

end;

procedure TfrmFatVendas.FormActivate(Sender: TObject);
//Var
//  LMonitor: TMonitor;
begin
  inherited;
  If Not Assigned(fatVenda) Then
    Exit;

  If blnPrimeiraVez And (Not fatVenda.blnFecharForm) Then
  Begin

    blnPrimeiraVez := False;

    If (Not fEmptyStr(edtCodCli.Text)) And (Not blnCarregandoAutSer) And (Not fatVenda.fEhVendaRapida(fatVenda.strCodCli)) Then
    Begin
      strCliAnt := edtCodCli.Text;
      fValidaCampos(edtCodCli, True);

      //************************************************************************//
      // VERIFICA SE EH PERMITIDO ALTERAR OS VENDEDORES NO ATO DO FATURAMENTO   //
      //*********************************************************************ED*//
      If (Not fatVenda.fDocumentoParaFornecedor) And (qryConCli.Active) Then
        pVerificaAlterarVendedor(qryConCli.FieldByName('CLI_CODVEN').AsString, qryConCli.FieldByName('CLI_CODREP').AsString);

      If (Not fEmptyStr(strNumOrc)) Then
      Begin

        If fClienteConsumidor(fatVenda.strCliOri, False, True) Then
        Begin
          fatVenda.pCarregaDadosConsumidor(qryFatGor);
          edtNomCli.Text := fatVenda.strCliNom;
        End;

        If fatVenda.fCarregaCondicaoPedido Then
        Begin

          If ( qryFatGor.FieldByName('FGO_CODCND').AsString <> '' ) Then
          Begin
            fatVenda.pCarregaCondicaoPagamentoPedido(qryFatGor);

            If Not (fConPagFora(fRetTipoForaConPag(qryFatGor.FieldByName('FGO_CODCND').AsString))) Then
              blnValidaCnd := False;

            edtCodCnd.Text     := fatVenda.strCodCnd;
            strCcnAnt          := fatVenda.strCodCnd;

            If (fCfgSis('CNDVEN') = 'F') And (Pos(strOpcDoc, 'OR_PD_VN_') > 0) Then
              pCarregaCondicao(False, False)
            Else
              pCarregaCondicao;

            fatVenda.strConPag := mskCndPag.Text;
            strCndAnt          := mskCndPag.Text;

            If Not fEmptyStr(edtCodCnd.Text) Then
              pPesquisaCadCnd(qryConCnd, qryConCnd, edtCodCnd.Text);

            If (Not fatVenda.fPermiteAlterarCondFormaPagtoPedido) Then
            Begin
              edtCodCnd.ReadOnly := True;
              mskCndPag.ReadOnly := True;
              edtForPag.ReadOnly := True;
              edtCodCnd.TabStop  := False;
              mskCndPag.TabStop  := False;
              edtForPag.TabStop  := False;
              edtCodCli.ReadOnly := TRUE;
              blnPermiteAlterarCliente := False;
            End;
          End;

        End
        Else If (Not fCfgSis('USACND', varBoolean)) Then
        Begin
          mskCndPag.Text     := qryFatGor.FieldByName('FGO_CONPAG').AsString;
          fatVenda.strConPag := mskCndPag.Text;
          strCndAnt          := mskCndPag.Text;
        End;

        If (fatVenda.VS_blnUsaFpg) Then
        Begin
          fatVenda.strCodFpg := qryFatGor.FieldByName('FGO_CODFPG').AsString;
          edtForPag.Text     := qryFatGor.FieldByName('FGO_CODFPG').AsString;
          strFpgAnt          := qryFatGor.FieldByName('FGO_CODFPG').AsString;

          {*********************************************************************************}
          {* CASO FOR UM PEDIDO GERADO PELO F11 COM MODALIDADE "013-UTILIZACAO DE CREDITO" *}
          {* E "015-A RECEBER", ENTAO DEVE ALTERAR A FORMA DE PAGAMENTO DE 009 PARA 015    *}
          {* PARA GERAR O CONTAS A RECEBER A VISTA EM ABERTO                               *}
          {*****************************************************************************JC**}
          If (Pos(fatVenda.strOpcDoc, 'VN_CP_') > 0) And
             (fatVenda.fPedidoRecebidoModalidadesCreditoeAReceberF11(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                                     qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                                                     qryFatGor.FieldByName('FGO_CODEMP').AsString)) Then
          Begin
            fatVenda.strCodFpg := '015';
            edtForPag.Text     := '015';
            strFpgAnt          := '015';
            mskCndPag.Text     := '01000';
            fatVenda.strConPag := '01000';
            strCndAnt          := '01000';
          End;

          pCarregaForPag;

          //Se nao usar condicao de pagamento deve deixar editar a forma de pagamento
          If Not fCfgSis('USACND', varBoolean) Then
            edtForPag.ReadOnly := False
          Else
          Begin
            //Se a condicao de pagamento nao tiver uma forma de pagto vinculada deve deixar editar a forma de pagamento
            If qryConCnd.Active And fEmptyStr(qryConCnd.FieldByName('CND_CODFPG').AsString) Then
              edtForPag.ReadOnly := False
            Else
              edtForPag.ReadOnly := True;
          End;

          If Not fatVenda.fPermiteAlterarCondFormaPagtoPedido Then
            edtForPag.ReadOnly := True;
        End;

        If (fCfgSis('USADIG', varBoolean)) Then
        Begin
          edtSenVen.Text := qryFatGor.FieldByName('FGO_CODVEN').AsString;
          edtNomVen.Text := fRetNomVendRep(edtSenVen.Text);

          If (Not blnCarregouSenhaVendedorAutomaticamente) Then
            pSetFocus(edtSenDig);

          If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And Assigned(fatVenda) Then
          Begin
            If (Not fEmptyStr(edtSenVen.Text)) And (Not fatVenda.blnGraCon) And fClienteConsumidor(fatVenda.strCliOri, False, True) Then
            Begin
              fatVenda.blnGraCon := True;
            End;
          End;
        End
        Else If (Not edtSenVen.ReadOnly) And (fPermiteFocoCampoVendedor) Then
          pSetFocus(edtSenVen);

      End;

    End;

    If (Pos(strOpcDoc, 'CP_OV_') <= 0) Then
      blnRecalcularPrecosAoMudarCondicaoDePagamento := True;

    {*************************}
    {* ROTINA USADA PELO CRM *}
    {**********************AC*}
    If (not fEmptyStr(strCodCliDef)) Then
    Begin
      If (fEmptyStr(strNumOrc)) Then
      Begin
        edtCodCli.Text := strCodCliDef;
        pSetFocus(edtCodCli);
        fValidaCampos(edtCodCli, True);
      End;

      If Not fCfgSis('PERCLI', varBoolean) Then
      Begin
        edtCodCli.ReadOnly := TRUE;
        blnPermiteAlterarCliente := False;
      End;
    End;

    If SameText(strOpcDoc, 'PA') Then
    Begin
      edtCodCli.Text := fCadEmp('CLIFIL');
      fValidaCampos(edtCodCli, True);
      edtCodCli.Enabled := False;
      fatVenda.strCodCnd := fCfgSis('CNDAVI', varString);
      edtCodCnd.Text     := fatVenda.strCodCnd;
      strCndAnt          := '01000';
      fatVenda.strConPag := '01000';
      mskCndPag.Text     := '01000';
      mskCndPag.Enabled  := False;
      edtCodCnd.Enabled  := False;
      SelectNext(ActiveControl, True, True);
    End;

    If pnlPlacaVeiculo.Visible And Not fEmptyStr(mskPlaVei.Text) Then
      pSetFocus(mskPlaVei);

    //atualiza os dados gerais da copia de seguranca da venda atual (necessario apos carregar um pedido/orcamento)
    fatVenda.objCopiaSegVenda.pAtualizarDadosGerais;
    //Verifica se existem vendas nao finalizadas para o usuario + empresa logados
    If fatVenda.objCopiaSegVenda.fRecuperarVendaNaoFinalizada Then
    Begin
      btnCancelaItem.Click;
      Self.fVerificaCampos;
      pTrataSaldoFlex;
      pIncluirTodosItensNaListaConsulta;
      pIncluirTodosItensNaListaConsultaTintadeMaquina;
      fatVenda.objCopiaSegVenda.pAtualizarDadosGerais;
    End;
  End;

  blnCarregandoAutSer := FALSE;

  If fatVenda.fEhVendaRapida(fatVenda.strCodCli) Then
    pSetFocus(edtCodCli)
  Else If Not fEmptyStr(strCodCliDef) Then
    pSetFocus(edtCodCli)
  Else
    pSetFocusPanel(pnlCabecalho);

  If (Assigned(fatVenda)) And (fatVenda.blnGravouDocumentos) Then
    Self.Close
  else if (Not fatVenda.blnFecharForm) Then
    pAjustaTamanhoDescricaoItemGrid;

//  LMonitor := TMonitor(Screen.MonitorFromWindow(Application.Handle));
//  If (fUsaDoisMonitores) And
//     (Self.Height > LMonitor.WorkareaRect.Height) Then
//  Begin
//    Self.Top         := 0;
//    Self.WindowState := wsNormal;
//  End;

  If Not fValidaForCusPersonalizada Then
  Begin
    fMensagem('Atenção','O sistema está configurado para usar fórmula de custo'#13#10
                       +'personalizada [CFG_FRMCUS] e a tabela da fórmula está'#13#10
                       +'vazia ( tabela FORCUS ). Peça para o responsável rever'#13#10
                       +'a configuração "CFG_FRMCUS" ou entre em contato'#13#10
                       +'com a citel.'
              ,['&O K']);

    PostMessage(Self.Handle,WM_CLOSE,0,0);
    ModalResult := mrCancel;
  End;

  if (not fValidaCfgOSGarantiaLoja) then
  begin
    fMensagem('Atenção', 'Configurado para realizar a baixa automática do Contas a Receber do financeiro de ' +
                         'Ordem de Serviço - Garantia Loja - [CFG_OSGLC]. Verifique as configurações [CFG_OSGLPO] e [CFG_OSGLPC]!'
              ,['&O K']);

    PostMessage(Self.Handle,WM_CLOSE,0,0);
    ModalResult := mrCancel;
  end;
end;

procedure TfrmFatVendas.pCarregaMultiLote(qryMultiLote: TUniQuery);
begin
  qryMultiLote.First;
  frmFatMultiLote.cdsMultiLote.EmptyDataSet;

  while not qryMultiLote.Eof do
  begin
    frmFatMultiLote.cdsMultiLote.Append;
    frmFatMultiLote.cdsMultiLoteLOT_NUMLOT.AsString := qryMultiLote.FieldByName('LOT_NUMLOT').AsString;
    frmFatMultiLote.cdsMultiLoteAMZ_DESCRI.AsString := qryMultiLote.FieldByName('AMZ_DESCRI').AsString;
    frmFatMultiLote.cdsMultiLoteQTDITE.AsFloat := qryMultiLote.FieldByName('QTDITE').AsFloat;
    frmFatMultiLote.cdsMultiLote.Post;
    qryMultiLote.Next;
  end;

  if (not frmFatMultiLote.cdsMultiLote.IsEmpty) then
  begin
    frmFatMultiLote.cdsMultiLote.First;
  end;
end;

procedure TfrmFatVendas.pCriaBkpArrMatItens;
  Var
    intContador: Integer;
begin
  SetLength(arrMatItensBkp, 0);
  SetLength(arrMatItensBkp, Length(fatVenda.arrMatItens));
  For intContador := Low(fatVenda.arrMatItens) To High(fatVenda.arrMatItens) Do
    arrMatItensBkp[intContador] := fatVenda.arrMatItens[intContador];
end;

procedure TfrmFatVendas.pCriaCdsIteDesEmb;
begin
  cdsIteDesEmb := TUniClientDataSet.Create(Nil);
  cdsIteDesEmb.StoreDefs := True;

  cdsIteDesEmb.FieldDefs.Add('ITE_CODITE', ftString, fTamCodIte);
  cdsIteDesEmb.FieldDefs.Add('ITB_QTDEMB', ftFloat);

  cdsIteDesEmb.IndexDefs.Add('IDX_ITE_CODITE', 'ITE_CODITE', [ixDescending]);

  cdsIteDesEmb.CreateDataSet;
end;

procedure TfrmFatVendas.pVoltaBkpArrMatItens;
  Var
    intItemOri: Integer;
    intItemBkp: Integer;
begin
  For intItemBkp := Low(arrMatItensBkp) To High(arrMatItensBkp) Do
    For intItemOri := Low(fatVenda.arrMatItens) To High(fatVenda.arrMatItens) Do
      If fatVenda.arrMatItens[intItemOri].intAutInc = arrMatItensBkp[intItemBkp].intAutInc Then
        fatVenda.arrMatItens[intItemOri] := arrMatItensBkp[intItemBkp];
end;

procedure TfrmFatVendas.pZeraVariaveisPigmento;
begin
  blnCalcQtdPigmento  := False;
  strCodItePigmento   := '';
  fltSaldoAntPigmento := 0;
  blnSaldoAntPigmento := False;
end;

function TfrmFatVendas.fConsultaItemDev(blnConsulta : Boolean = True):Boolean;
  Var
    strEspSel: String;
    strNumRom: String;
    blnVerificaSeDocEstaEmRomaneio: Boolean;
    arrSel   : TConsultasArray;
    chrKey   : Char;
    objfrmPnl: TPanelCxItemDev;
    blnPed_OS: Boolean;
    strEmiDev: String;
    strEmidevAnt: String;
    blnDevolvendoItemComLoteFaturadoNoCDCujaOrigemEhPedidoEntregaCD: Boolean;

  function fRetProfisOriDoDocumentoEntregaFutura(strAutInc: String): String;
    Var
      strSQL   : String;
      qryGen: TUniQuery;
  begin
    Result := '';
    qryGen := fCriaQuery(Nil);
    Try
      strSQL := '';
      strSQL := strSQL + ' SELECT (SELECT DET_DOC.DET_CODDIV FROM MOVDET DET_DOC WHERE DET_DOC.AUTOINCREM=TRI_BAI.DET_INCFUT) AS DET_DOCDIV ';
      strSQL := strSQL + '   FROM MOVDET DET_BAI  ';
      strSQL := strSQL + '   INNER JOIN MOVTRI TRI_BAI ON DET_BAI.AUTOINCREM = TRI_BAI.DET_SEQGER ';
      strSQL := strSQL + '  WHERE DET_BAI.AUTOINCREM = :AUTOINCREM  ';

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('AUTOINCREM').AsString := strAutInc;
        Open;
        If Not IsEmpty Then
          Result := FieldByName('DET_DOCDIV').AsString;
        Close;
      End;

    Finally
      FreeAndNil(qryGen);
    End;
  end;

    {*******************************************}
    {* FILTRO DE PARCIAL/COMPLETE KEY          *}
    {***14/04/2008***************************MV*}

  function fValidarVencimentosDocumentos: Boolean;
  begin
    Result := True;

    If Not fCfgSis('DVVORI', varBoolean) Then
      Exit;

    strEmiDev    := '';
    strEmiDevAnt := '';

    If dtaEmidev > 0 Then
      strEmiDev := DateToStr(dtaEmidev);

    If dtaEmidevAnt > 0 Then
      strEmiDevAnt := DateToStr(dtaEmidevAnt);

    If ( Not SameText ( strCCndDv    + strCndDev    + strEmiDev ,
                        strCCndDvAnt + strCndDevAnt + strEmiDevAnt ) ) And
       ( Not fEmptyStr( strCCndDvAnt + strCndDevAnt + strEmiDevAnt ) ) Then
    Begin
      Result := False;
    End;

  end;

  function fEmpresaRegimeEspecial(strCodEmp: String): Boolean;
  begin
    Result := (fCfgSis('EMPRES', varString) = strCodEmp);
  end;

  function fDiasPassadosDocumentoOriginal: Integer;
  begin
    Result := DaysBetween(VS_Date, qryConDev.FieldByName('DET_DTAENT').AsDateTime);
  end;

  procedure pZerarVariaveisDevolucao;
  begin
    strCodCndAuxDv:='';
    strCodFpgAuxDv:='';

    strDocDev    := '';
    strEspDev    := '';
    strEmpDev    := '';
    strDivDev    := '';
    strAiDvOr    := '';

    strSeqDet    := '';

    fltQtdDev    := 0.0;
    fltUniDev    := 0.0;
    fltComDev    := 0.0;
    fltCoDvRp    := 0.0;
    fltDesDev    := 0.0;
  end;

  Var
    strWhere  : String;
    fltQtdDevolvido : Double;

begin
  Result := False;
  {*******************************************}
  {* FILTRO DE PARCIAL/COMPLETE KEY          *}
  {***14/04/2008***************************MV*}
  Try
    blnVerificaSeDocEstaEmRomaneio := (fUsaRomaneioNotaAbatendoDevolucao Or fCfgSisL('VRODEV', varBoolean)) And (Pos(strOpcDoc, 'DV_PR_') > 0);
    Try

      If (fatVenda.blnDevRap) Then
      Begin

        qryConDev.Close;
        qryConDev.SQL.Text := 'SELECT * FROM ' + fatVenda.strTmpIteDev;
        qryConDev.Open;

        Result := Not qryConDev.IsEmpty;

      End
      Else
      If blnConsulta Then
      Begin
        objfrmPnl := TPanelCxItemDev.Create(TfrmPnlDadosItemDev);
        objFrmPnl.strNomForm := Self.Name;
        chrKey := '/';

        Result := fPesqIteDev(Self, qryConDev, chrKey, arrSel, fatVenda.strTmpIteDev,
                              strOpcDoc, fCfgSis('ITESER'), fCfgSis('SERTER'),
                              fCfgSis('USASER', varBoolean),
                              True, objfrmPnl,'Consulta de Itens para Devolução',blnDevEsp);
      End
      Else
      Begin
        qryConDev.Close;
        qryConDev.SQL.Text := fSqlfPesqIteDev(fatVenda.strTmpIteDev, strOpcDoc, fCfgSis('ITESER'), fCfgSis('SERTER'), fCfgSis('USASER', varBoolean)).strSQLAndWhere;
        qryConDev.SQL.Add(' AND (ITE_BARRAS LIKE :CODITE ) ');
        qryConDev.ParamByName('CODITE').AsString := '%| ' + edtCodIte.Text + ' |%';
        qryConDev.Open;
        Result := Not qryConDev.IsEmpty;

        If Result Then
        Begin
          If qryConDev.RecordCount > 1 Then
          Begin
            Repeat
              fltQtdDevolvido := fRetQtdDigitadaDevolucao;
              if fltQtdDevolvido = qryConDev.FieldByName('DET_QTDITE').AsFloat Then
                qryConDev.Next;


            Until (fltQtdDevolvido < qryConDev.FieldByName('DET_QTDITE').AsFloat) Or qryConDev.Eof;

          End;

          strWhere := qryConDev.FieldByName('AUTOINCREM').AsString;

          qryConDev.Close;
          qryConDev.SQL.Text := 'SELECT * FROM ' + fatVenda.strTmpIteDev + ' WHERE AUTOINCREM = :AUTOINC';
          qryConDev.ParamByName('AUTOINC').AsString := strWhere;
          qryConDev.Open;

        End;

      End;

      If Result Then
      Begin
        If (Not fPermiteDevolucaoProdutoComCashback(qryConDev.FieldByName('DET_NUMDOC').AsString,
                                                    qryConDev.FieldByName('DET_ESPDOC').AsString,
                                                    qryConDev.FieldByName('DET_CODEMP').AsString,
                                                    qryConDev.FieldByName('DET_CODITE').AsString,
                                                    qryConDev.FieldByName('DET_DESCRI').AsString,
                                                    qryConDev.FieldByName('DET_QTDITE').AsFloat)) Then
        Begin
          Result := False;
          Exit;
        End;

        If (fTemADPendenteDocto(qryConDev.FieldByName('DET_CODEMP').AsString,
                                qryConDev.FieldByName('DET_FORCLI').AsString,
                                qryConDev.FieldByName('DET_NUMDOC').AsString,
                                qryConDev.FieldByName('DET_ESPDOC').AsString,
                                qryConDev.FieldByName('DET_SERIE_').AsString,
                                True)) Then
        Begin
          Result := False;
          Exit;
        End;

        If (fTemDocumentoWMSSemEnderecamento(qryConDev.FieldByName('DET_CODEMP').AsString,
                                             qryConDev.FieldByName('DET_FORCLI').AsString,
                                             qryConDev.FieldByName('DET_NUMDOC').AsString,
                                             qryConDev.FieldByName('DET_ESPDOC').AsString,
                                             qryConDev.FieldByName('DET_SERIE_').AsString,
                                             qryConDev.FieldByName('DET_CODITE').AsString,
                                             strOpcDoc,
                                             True)) Then
        Begin
          Result := False;
          Exit;
        End;

        If (Assigned(fatVenda)) And (strOpcDoc = 'OF') Then
          fatVenda.strEmpresaAbastecimentoOutrasSaidas := fRetEmpresaAbastecimentoClienteFilial(qryConDev.FieldByName('DET_NUMDOC').AsString, qryConDev.FieldByName('DET_ESPDOC').AsString, qryConDev.FieldByName('DET_CODEMP').AsString);

        If (strOpcDoc <> 'OF') and (Not fEhMesmoGrupoFrete(StrToIntDef(qryConDev.FieldByName('DET_TIPFRE').AsString, 0))) Then
        Begin
          pMostraTravaGrupoFreteDiferente(qryConDev.FieldByName('DET_NUMDOC').AsString, qryConDev.FieldByName('DET_ESPDOC').AsString, qryConDev.FieldByName('DET_CODEMP').AsString, qryConDev.FieldByName('DET_TIPFRE').AsString);
          Exit;
        End;

        if ( fatVenda.strPigBas = 'S' ) and ( qryConDev.FieldByName('DET_PROACA').AsString = 'S' )  then
        begin
          fMensagem('ATENÇÃO!',' O Item '+ qryConDev.FieldByName('DET_DESCRI').AsString  +' é um produto acabado, portanto não deve ser devolvido como "pigmento/base" !', ['&Ok']);
          exit;
        end;

        blnPed_OS := (qryConDev.FieldByName('DET_ESP_PD').AsString = 'PD')
          and (not fEmptyStr(fRetornaOrdemServicoPedido(qryConDev.FieldByName('DET_NUM_PD').AsString, qryConDev.FieldByName('DET_EMP_PD').AsString)));

        if (fCfgSis('SIMPAU', varBoolean)) and (fCfgSis('CSTCEQ', varBoolean)) then
        begin
          if (not fValidaDevCompletaPDOS(blnPed_OS)) then
            Exit;

          if (not fGridVendaVazio) and (fatVenda.blnPedidoOS <> blnPed_OS) then
          begin
            fMensagem('ATENÇÃO!','Não é permitido efetuar devolução de vendas oriundas de OS e vendas não oriundas de OS por conta da configuração "CFG_CSTCEQ".', ['&Ok']);
            Exit;
          end;
        end;

        If (qryConDev.FieldByName('DET_CODEMP').AsString <> VS_strCodEmp) Then
        Begin
          If fEmpresaRegimeEspecial(qryConDev.FieldByName('DET_CODEMP').AsString) Then
          Begin
            pMensagemOk('A empresa da nota selecionada ('+ qryConDev.FieldByName('DET_CODEMP').AsString +') é uma empresa do Regime Especial (CFG_UTI_RE).'+ sLineBreak +
                        'Sendo assim, a devolução deve ser feita fisicamente nela.');
            Exit;
          End;
        End;

        fatVenda.blnPedidoOS := blnPed_OS;

        If fGridVendaVazio Then
        Begin
          fatVenda.blnVendaPresencial := False;
          fatVenda.blnDevolvendoUtiNps := (qryConDev.FieldByName('AUX_UTINPS').AsString = 'S');
          fatVenda.strCpfNpsDevolucoes := fatVenda.strCliCgc;
          fatVenda.strCodVendedorDV    := qryConDev.FieldByName('DET_CODVEN').AsString;
          fatVenda.strEntRetDevolucoes := qryConDev.FieldByName('DET_ENTRET').AsString;
          If (fCfgSis('DVENRE', varBoolean)) And (strOpcDoc = 'DV') Then
            fatVenda.strEntFat := IIF(fatVenda.strEntRetDevolucoes = 'E', 'S', 'N');
          fatVenda.blnDevolvendoRegEsp := fEmpresaRegimeEspecial(qryConDev.FieldByName('DET_CODEMP').AsString);
        End
        Else
        Begin
          If (fatVenda.blnVendaPresencial) <> (IIF(qryConDev.FieldByName('AUX_VENPRE').Text='SIM', True, False)) Then
          Begin
            fMensagem('ATENÇÃO!','Não é permitido realizar devoluções de vendas presenciais com vendas '+
                 'que não são presenciais pois a movimentação fiscal é distinta entre estas operações.', ['&Ok']);
            exit;
          End;
          If (fCfgSis('UTINPS', varBoolean)) And (fatVenda.blnDevolvendoUtiNps <> (qryConDev.FieldByName('AUX_UTINPS').AsString = 'S')) Then
          Begin
            fMensagem('ATENÇÃO!','Não é permitido realizar devoluções de vendas que solicitaram netpoints com vendas '+
                      'que não solicitaram netpoints.', ['&OK']);
            Exit;
          End;
          If (fCfgSis('DMOBMV', varBoolean)) And (fatVenda.strCodVendedorDV <> qryConDev.FieldByName('DET_CODVEN').AsString)
             And (strOpcDoc = 'DV') Then
          Begin
            fMensagem('ATENÇÃO!','O sistema está configurado para permitir na devolução apenas documentos do mesmo vendedor. '+
                      ' para conseguir devolver os documentos selecionados, será necessário emitir duas devoluções. (CFG_DMOBMV).', ['&OK']);
            Exit;
          End;
          If (fCfgSis('DVENRE', varBoolean)) And (fatVenda.strEntRetDevolucoes <> qryConDev.FieldByName('DET_ENTRET').AsString)
             And (strOpcDoc = 'DV') Then
          Begin
            fMensagem('ATENÇÃO!','O sistema está configurado para permitir na devolução apenas documentos de "Entrega" ou "Retira". '+
                      ' para conseguir devolver os documentos selecionados, será necessário emitir duas devoluções. (CFG_DVENRE).', ['&OK']);
            Exit;
          End;
          If fatVenda.blnDevolvendoRegEsp <> fEmpresaRegimeEspecial(qryConDev.FieldByName('DET_CODEMP').AsString) Then
          Begin
            fMensagem('ATENÇÃO!','Não é permitido devolver venda de uma empresa que é Regime Especial (CFG_UTI_RE) com venda de outra empresa que não é. '+
                      'A venda da empresa do Regime Especial deve ser feita fisicamente nela e a devolução da outra empresa deve ser feita separadamente.', ['&OK']);
            Exit;
          End;
        End;

        If fEstaRotinaPedidoRetiraEmpLocalSemWMSEmpCDComWMS Then
        Begin
          blnDevolvendoItemComLoteFaturadoNoCDCujaOrigemEhPedidoEntregaCD := False;
          If (Assigned(qryConDev.FindField('DET_NUMLOT'))) Then
          Begin         
            blnDevolvendoItemComLoteFaturadoNoCDCujaOrigemEhPedidoEntregaCD :=
                  (Not fEmptyStr(qryConDev.FieldByName('DET_NUMLOT').AsString)) And 
                  (Not fatVenda.objCadLot.fExisteLote(qryConDev.FieldByName('DET_CODITE').AsString, VS_strCodEmp, qryConDev.FieldByName('DET_NUMLOT').AsString)) And                 
                  (fRetSeOrigemEhPedidoEntregaPeloCDPeloAutInc(qryConDev.FieldByName('DET_TABELA').AsString, qryConDev.FieldByName('DET_AUTOIN').AsString));
          End;         

          If fGridVendaVazio Then
          Begin
            If blnDevolvendoItemComLoteFaturadoNoCDCujaOrigemEhPedidoEntregaCD Then
            Begin
              chkEntCD.Checked := True;
            End;
          End
          Else
          Begin
            If ((chkEntCD.Checked) And (Not blnDevolvendoItemComLoteFaturadoNoCDCujaOrigemEhPedidoEntregaCD)) Or 
               ((Not chkEntCD.Checked) And (blnDevolvendoItemComLoteFaturadoNoCDCujaOrigemEhPedidoEntregaCD)) Then
            Begin
              fMensagem('ATENÇÃO!', 'Não é permitido realizar devoluções de vendas de itens com lote, cuja origem é entrega/faturamento pelo CD, ' +
                                    'em conjunto com devoluções de itens convencionais. Será necessário emitir duas devoluções!', ['&Ok']);
              exit;
            End;
          End;
        End;

        pVerificaDigitosNumCOO;
        fatVenda.blnVendaPresencial := IIF(qryConDev.FieldByName('AUX_VENPRE').Text='SIM', True, False);

        If (strOpcDoc = 'OF') Then
        Begin
          fatVenda.strDocDevOF := qryConDev.FieldByName('DET_NUMDOC').AsString;
        End;

        blnInserindoBrindeDV := False;
        chkBrinde.Checked    := False;
        If (fCfgSis('VENBRI', varString) = 'S') And
           (Pos(RightStr(qryConDev.FieldByName('DET_CLAFIS').AsString, 3), fCfgSis('CLABRI', varString)) > 0) And
           (Pos(strOpcDoc, 'OF_') <= 0) Then
        Begin
          blnInserindoBrindeDV := True;
          chkBrinde.Checked    := True;
        End;

        dtaEmiDev := qryConDev.FieldByName('DET_DTAENT').AsDateTime;
        strCndDev := qryConDev.FieldByName('DET_CONPAG').AsString;
        strCCndDv := qryConDev.FieldByName('DET_CODCND').AsString;
        strDocDev := qryConDev.FieldByName('DET_NUMDOC').AsString;
        strEspDev := qryConDev.FieldByName('DET_ESPDOC').AsString;
        strEmpDev := qryConDev.FieldByName('DET_CODEMP').AsString;
        strDivDev := qryConDev.FieldByName('DET_CODDIV').AsString;
        strCFOPDv := qryConDev.FieldByName('DET_CLAFIS').AsString;
        strAiDvOr := qryConDev.FieldByName('DET_AUTOIN').AsString;
        strCodAca := qryConDev.FieldByName('DET_CODACA').AsString;
        strEmpAca := qryConDev.FieldByName('DET_EMPACA').AsString;

        If (strDivDev.IsEmpty) And (Pos(strCFOPDv, CLAFIS_ENTFUT_VEN) > 0) Then
        Begin
          strDivDev := fRetProfisOriDoDocumentoEntregaFutura(strAiDvOr);
        End;   

        SetLength(arrCodVen, Length(arrCodVen) + 1);
        arrCodVen[Length(arrCodVen) - 1] := qryConDev.FieldByName('DET_CODVEN').AsString;

        strVenDev := qryConDev.FieldByName('DET_CODVEN').AsString;
        strVenDev2 := qryConDev.FieldByName('DET_CODVE2').AsString;

        fltQtdDev := qryConDev.FieldByName('DET_QTDITE').AsFloat;
        fltUniDev := qryConDev.FieldByName('DET_UNITAR').AsFloat;

        If blnUtilizaVendaMadeira Then
          fltUniDev := fVoltaUnitarioSemAparelBenefi(fltUniDev, qryConDev.FieldByName('DET_PERAPA').AsFloat,
                                                     qryConDev.FieldByName('DET_PERBEN').AsFloat);

        fltCusDev := qryConDev.FieldByName('DET_PRECUS').AsFloat;
        fltCusDe2 := qryConDev.FieldByName('DET_PRECU2').AsFloat;
        fltOutValDev := qryConDev.FieldByName('DET_OUTVAL').AsFloat;
        fltIcmSaiDev := qryConDev.FieldByName('DET_ICMSAI').AsFloat;
        fltImpFedDev := qryConDev.FieldByName('DET_IMPFED').AsFloat;
        fltDesOpeDev := qryConDev.FieldByName('DET_DESOPE').AsFloat;

        fltPreMedDev := qryConDev.FieldByName('DET_PREMED').AsFloat;
        fltImpUltDev := qryConDev.FieldByName('DET_IMPULT').AsFloat;
        fltPreUltDev := qryConDev.FieldByName('DET_PREULT').AsFloat;

        fltComDev := qryConDev.FieldByName('DET_PERCOM').AsFloat;
        fltCoDvRp := qryConDev.FieldByName('DET_PERREP').AsFloat;
        fltDesDev := qryConDev.FieldByName('DET_DESESP').AsFloat;

        strTabDev := qryConDev.FieldByName('DET_TABELA').AsString;
        strIdeDev := qryConDev.FieldByName('DET_IDEPRO').AsString;
        fltQtdDet := qryConDev.FieldByName('DET_QTDDET').AsFloat;

        strSeqDet := qryConDev.FieldByName('DET_AUTOIN').AsString;

        strCliForDev := qryConDev.FieldByName('DET_FORCLI').AsString;
        strITinDv := fRetIteTinDevolucao(strTabDev, strSeqDet);

        If cdsVenda.IsEmpty Then
        Begin
          dtaEmiDevAnt := 0;
          strCndDevAnt := '';
          strCCndDvAnt := '';          
          strDocDevAnt := '';
          strEspDevAnt := '';
          strEmpDevAnt := '';
          strCFOPDvAnt := '';
        End;

        If fDocumentoDeDevolucaoComDivergenciaDeDataECondicao(fValidarVencimentosDocumentos) Then
        Begin
          pMensagemOk('Documentos devem ser da mesma data e com mesma condição de pagamento, ' +
                      'pois o sistema está configurado para gravar o contas a receber da devolução com mesmos ' +
                      'vencimentos do documento de venda! ' + #13#10 +
                      'Docto. Atual.: Emiss.: ' + strEmiDev    + ' Cond. pagto: ' + strCCndDv    + ' - ' + strCndDev    + #13#10 +
                      'Docto. Selec.: Emiss.: ' + strEmiDevAnt + ' Cond. pagto: ' + strCCndDvAnt + ' - ' + strCndDevAnt );
        End



        {Else If (strOpcDoc = 'PR') And (Not fEmptyStr(strDocDevAnt)) And
           (Not SameText(strDocDevAnt + strEspDevAnt + strEmpDevAnt,
                         strDocDev    + strEspDev    + strEmpDev)) Then
        Begin

          fMensagem('', 'Não é permitido selecionar mais de um documento para devolução!', ['&Ok']);

        End}

        Else If (Not fEspeciePermitidaDevolucao(strEspDev)) Then
        Begin

          If (Pos(strEspDev, 'NF_EL_IF_IV_NV_D1_') > 0) Then
            strEspSel := '(MI/FF)'
          Else
          Begin
            If qryConCli.FindField('CLI_DESCON') <> Nil Then
              If (qryConCli.FieldByName('CLI_DESCON').AsFloat > 0) And fDescontoClienteProfissional(fatVenda.strCodCli) Then
                blnNaoPermitirMIeFFnaMesmaDevolucao := True;

            strEspSel := '(NF/IF)';

            If blnNaoPermitirMIeFFnaMesmaDevolucao Then
            Begin
              If strEspDev = 'MI' Then
                strEspSel := strEspSel + ' ou (FF)'

              Else If strEspDev = 'FF' Then
                strEspSel := strEspSel + ' ou (MI)'
            End;
          End;

          fMensagem('ATENÇÃO!', 'Não é permitido selecionar um documento de espécie (' + strEspDev + ') ' +
                                'pois já foi selecionado um documento de espécie ' + strEspSel + '!', ['&Ok']);

          pZerarVariaveisDevolucao;

        End

        Else If (blnVerificaSeDocEstaEmRomaneio) And fItemEstaEmRomaneioRetNumRom(qryConDev.FieldByName('DET_CODITE').AsString,
                                                                                  qryConDev.FieldByName('DET_TABELA').AsString,
                                                                                  qryConDev.FieldByName('DET_AUTOIN').AsString,
                                                                                  strNumRom) Then
        Begin
          fMensagem('', 'Este item está em Processo de Entrega no Romaneio Nº ' + strNumRom + '.', ['&Ok']);
          pZerarVariaveisDevolucao;
        End

        Else If Not fDocumentoEletronicoAutorizado(qryConDev) Then
        Begin
          pMensagemOk('Este documento ainda não está autorizado. Por favor, verifique.');

          pZerarVariaveisDevolucao;
        End
        Else If (strOpcDoc = 'DV') And (strEspDev = 'IF') And (Not fCupomJaImpresso(fRetNomTabGer(qryConDev.FieldByName('DET_TABELA').AsString),
                                                                                    qryConDev.FieldByName('DET_SEQGER').AsString)) Then
        Begin
          fMensagem('ATENÇÃO!', 'O cupom fiscal ainda não foi impresso.', ['&OK']);

          pZerarVariaveisDevolucao;
        End

        {*************************************************************}
        {* VERIFICA SE É PERMITIDO DEVOLVER OS PRODUTOS DO DOCUMENTO *}
        {**********************************************************TS*}
        Else If (Pos(strOpcDoc, 'DV_') > 0) And (fatVenda.blnDevolucaoCompleta) And //Dev. Completa
                (Not fPermiteReceberProdutoBloqueado) Then
        Begin
          pZerarVariaveisDevolucao;
        End

        {**********************************************************}
        {* VERIFICA SE É PERMITIDO DEVOLVER O PRODUTO SELECIONADO *}
        {*******************************************************TS*}
        Else If (Pos(strOpcDoc, 'DV_') > 0) And (Not fatVenda.blnDevolucaoCompleta) And //Dev. Parcial
                (Not fPermiteReceberDevolucao(qryConDev.FieldByName('DET_CODITE').AsString, strEmpDev)) And
                (Not fPermiteReceberProdutoBloqueado) Then
        Begin
          pZerarVariaveisDevolucao;
        End

        Else If (Pos(strOpcDoc, 'PR_') > 0)And
                (Not fPermiteReceberDevolucao(qryConDev.FieldByName('DET_CODITE').AsString, strEmpDev)) And
                (Not fPermiteReceberProdutoBloqueado)  Then
        Begin
          fMensagem('ATENÇÃO!', 'O Item selecionado está marcado em seu cadastro para não receber devolução!', ['&OK']);
          pZerarVariaveisDevolucao;
        End

        {***************************************************************************}
        { SEMPRE DEIXAR ESSE ELSE/IF SEMPRE POR ÚLTIMO POIS ELE É QUE VAI BLOQUEAR *}
        {*************************************************************************VA}
        Else If Not fatVenda.fTravaERegistraStlDocDevLck(strTabDev, strDocDev, strEspDev, strEmpDev, strCliForDev, strAiDvOr) Then
        Begin
          pZerarVariaveisDevolucao;
        End

        Else
        Begin

          {*********************************************************************}
          {* IGNORA O ENDEREÇO DE ENTREGA QUANDO FOR DOCUMENTO PARA FORNECEDOR *}
          {*******************************************************************PZ}
          If (Not SameText(strDocDevAnt + strEspDevAnt + strEmpDevAnt,
                           strDocDev    + strEspDev    + strEmpDev)) And
             (Not fatVenda.fDocumentoParaFornecedor) Then
          Begin

            fatVenda.pCarregaEnderecoEntrega(fatVenda,
                                             fRetNomTabGer(qryConDev.FieldByName('DET_TABELA').AsString),
                                             qryConDev.FieldByName('DET_SEQGER').AsString,
                                             True,
                                             fatVenda.DocumentoDeImportacaoFulfillment(strDocDev, strEspDev, strEmpDev));

          End;

          dtaEmiDevAnt := dtaEmiDev;
          strCndDevAnt := strCndDev;
          strCCndDvAnt := strCCndDv;
          strDocDevAnt := strDocDev;
          strEspDevAnt := strEspDev;
          strEmpDevAnt := strEmpDev;
          strCFOPDvAnt := strCFOPDv;

          if fatVenda.blnDevolucaoCompleta and (fatvenda.strOpcDoc = 'OF') then
          begin
            pVerificarSeExisteItemEmProcessoGarantia(strDocDevAnt, strEspDevAnt, strEmpDevAnt);
          end;

          fatVenda.blnDevNota := (Pos(strEspDev, 'NF_EL_IF_IV_NV_D1_') > 0);
          If (fatVenda.blnDevolucaoCompleta) Or (qryConDev.FieldByName('DET_SEQCOM').AsInteger > 0) Then
          Begin
            Try
              pCriarFormularios(TfrmGravando, frmGravando);
              frmGravando.fExecutarAcao := fCarregaItensDevCompleta;
              frmGravando.ShowModal;
            Finally
              FreeAndNil(frmGravando);
            End;
          End
          Else
          Begin
            If (Not fEmptyStr(qryConDev.FieldByName('DET_IDEPRO').AsString)) And
               (qryConDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
            Begin
              If (Not IsTintaExistente(qryConDev.FieldByName('DET_IDEPRO').AsString)) Then
              Begin
                BtnCancelaItem.Click;
                BtnCancelarVenda.Click;
                Exit;
              End;
            End;

            edtCodIte.Text      := qryConDev.FieldByName('DET_CODITE').AsString;
            strCodAtu           := qryConDev.FieldByName('DET_CODITE').AsString;
            strEmpCar           := qryConDev.FieldByName('DET_EMPCAR').AsString;

            If (Not fEmptyStr(edtCodIte.Text)) Then
            Begin
              pCarregaItem(True, True);

              If (strOpcDoc = 'OF') And (fCfgSis('IMPREF', varBoolean)) Then
                edtDesIte.Text   := fatVenda.fConcatRef(qryConDev.FieldByName('DET_DESCRI').AsString, qryConDev.FieldByName('DET_REFERE').AsString)
              Else
                edtDesIte.Text   := qryConDev.FieldByName('DET_DESCRI').AsString;

              edtMulVen.Text   := FloatToStrF(fRetMltVenItem(qryConDev.FieldByName('DET_CODITE').AsString), ffNumber, 12, 4);
              edtUnidad.Text   := qryConDev.FieldByName('DET_UNIDAD').AsString;
              edtSigla.Text    := fRetSiglaUnidade(qryConDev.FieldByName('DET_UNIDAD').AsString, qryCadUni);
              pSetLabelUnidadeMedida;

              edtUnitar.Text   := FloatToStrF(fltUniDev, ffFixed, 12, fatVenda.VS_intDecUni);

              strCodAca        := qryConDev.FieldByName('DET_CODACA').AsString;
              strEmpAca        := qryConDev.FieldByName('DET_EMPACA').AsString;
              blnProAca        := (qryConDev.FieldByName('DET_PROACA').AsString = 'S');

              edtComPec.Text := FormatFloat(edtComPec.EditFormat, qryConDev.FieldByName('DET_COMPEC').AsFloat);
              edtLarPec.Text := FormatFloat(edtLarPec.EditFormat, qryConDev.FieldByName('DET_LARPEC').AsFloat);
              edtEspPec.Text := FormatFloat(edtEspPec.EditFormat, qryConDev.FieldByName('DET_ESPPEC').AsFloat);

              edtAparel.Text := qryConDev.FieldByName('DET_APAREL').AsString;
              edtBenefi.Text := qryConDev.FieldByName('DET_BENEFI').AsString;
              edtPerApa.Text := FormatFloat('##,#0.00', qryConDev.FieldByName('DET_PERAPA').AsFloat);
              edtPerBen.Text := FormatFloat('##,#0.00', qryConDev.FieldByName('DET_PERBEN').AsFloat);

              pHabilitarMetragem(edtCodIte.Text, edtUnidad.Text);

              SelectNext(ActiveControl, True, True);

            End;

          End;

          strCodCndAuxDv:='';
          strCodFpgAuxDv:='';

          If (MatchStr(strOpcDoc, ['DV','PR'])) And fCfgSis('DVVORI', varBoolean) Then
          Begin
            If fCfgSis('USACND', varBoolean) Then
            Begin
              edtCodCnd.Text := strCCndDv;
              strCcnAnt      := edtCodCnd.Text;
              pCarregaCondicao;

              If fCfgSis('ALCNDV', varBoolean) Then
              Begin
                If Not fEmptyStr(edtCodCnd.Text) Then
                Begin
                  strCodCndAuxDv := strCCndDv;
                  fatVenda.strConPag := mskCndPag.Text;
                End;

                If fCfgSis('USAFPG', varBoolean) Then
                Begin
                  If Not fEmptyStr(edtForPag.Text) Then
                  Begin
                    fatVenda.strCodFpg := edtForPag.Text;
                    strCodFpgAuxDv := fatVenda.strCodFpg;
                  End;
                End;
              End;

            End;

            mskCndPag.Text := fRetCondicaoDevolucao(dtaEmiDev, strCndDev);
            If (Not fEmptyStr(strCodCndAuxDv)) And (fStatusCndPag(mskCndPag.Text) = A_VISTA) And (strCodCndAuxDv <> fCfgSis('CNDAVI', varString)) Then
            Begin
              edtCodCnd.Text := fCfgSis('CNDAVI', varString);
              strCodCndAuxDv := edtCodCnd.Text;
              fatVenda.strConPag := mskCndPag.Text;

              If (Not fEmptyStr(strCodFpgAuxDv)) Then
              Begin
                 edtForPag.Text := '001';
                 strCodFpgAuxDv := edtForPag.Text;
                 pCarregaForPag;
              End;
            End
            Else If (fCfgSis('USACND', varBoolean)) And
                    (Not fCfgSis('ALCNDV', varBoolean)) Then
            Begin
              If (fStatusCndPag(mskCndPag.Text) = A_VISTA) Then
                edtForPag.Text := '001'
              Else
                edtForPag.Text := '008';

              fatVenda.strCodFpg := edtForPag.Text;
            End;

          End;

        End;

      End;

    Finally
      FreeAndNil(objfrmPnl);
    End;

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[frmFatVendas.fConsultaItemDev]');
    End;
  End;

  pAtualizaUnitarioLiquido;
end;

function TfrmFatVendas.fDigDadosDevolucao(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    strDtaIni: String;
    strDtaFin: String;
    strCliCn2: String;
    strNumDoc,
    strEspDoc,
    strEmpDoc,
    strNumCoo: String;
begin
  pInformacao('Aguarde, Carregando documentos ...', pgbStatus);
  pProgresso(0, 0, pgbStatus);

  If VS_strHabilitarCRM And (fatVenda.strOpcDoc = 'DV') And (fCfgSis('UTI_AD', varString) = 'S') And (Not blnLiberouADComSenha) Then
  Begin
    Try
      pCriarFormularios(TfrmFatDigNumAD, frmFatDigNumAD);
      frmFatDigNumAD.strCodCli := edtCodCli.Text;
      frmFatDigNumAD.ShowModal;
      Result := frmFatDigNumAD.blnConfirma;
      If Result Then
      Begin
        fatVenda.strCodAde := frmFatDigNumAD.edtNumAD.Text;
        fatVenda.strMotDev := fCampoTabela('DET_CODMOT', 'ADEDET', ['DET_CODADE','DET_CODEMP'], [fatVenda.strCodAde,VS_strCodEmp]);
        strDtaIni := DateToStr(fCampoTabela('CAST(MIN(IF(IFNULL(DT.DET_DTAENT, "") = "", NT.DET_DTAENT, DT.DET_DTAENT)) AS DATE)', ADEDET_JOIN_MOVDET, ['AD.DET_CODADE','AD.DET_CODEMP'], [fatVenda.strCodAde,VS_strCodEmp]));
        strDtaFin := DateToStr(fCampoTabela('CAST(MAX(IF(IFNULL(DT.DET_DTAENT, "") = "", NT.DET_DTAENT, DT.DET_DTAENT)) AS DATE)', ADEDET_JOIN_MOVDET, ['AD.DET_CODADE','AD.DET_CODEMP'], [fatVenda.strCodAde,VS_strCodEmp]));
        edtCodCli.Text := frmFatDigNumAD.strCodCli;
        pCarregaCliente;
        pSugerirCondicaoDePagto;
      End;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '');
      End;
    End;
    pFreeAndNil(frmFatDigNumAD);
  End
  Else
  If blnDevEsp Then
  Begin
    fatVenda.blnDevolucaoCompleta := False;
    fatVenda.blnDvComDta := True;
    strEmpDoc := VS_strCodEmp;
    strDtaIni := DateToStr( Date - 3650 ) ;
    strDtaFin := DateToStr( Date );
    Result    := True
  End
  Else
  Begin
    Try
      pCriarFormularios(TfrmFatDigDatas, frmFatDigDatas);
      frmFatDigDatas.blnMosChkDev := True;
      frmFatDigDatas.blnOpcDoc := (Pos(strOpcDoc,'DV_PR_') > 0);
      blnCliPigBas := false;

      If Pos(strOpcDoc,'DV_PR_') > 0 Then
      Begin
        frmFatDigDatas.blnFatVenda := fClienteConsumidor(edtNomCli.Text, False, True);
        frmFatDigDatas.lblMsgOF.Visible := False;
        fatVenda.pDestravaELimpaStlDocDevLck('','','','','',True);
      End
      Else
      Begin
        frmFatDigDatas.blnFatVenda := False;
        frmFatDigDatas.lblMsgOF.Visible := True;
      End;

      frmFatDigDatas.strCodCli := edtCodCli.Text;
      frmFatDigDatas.blnNumDoc := True;
      frmFatDigDatas.strOpcDoc := strOpcDoc;
      frmFatDigDatas.showModal;

      Result    := frmFatDigDatas.blnConfirma;
      strDtaIni := frmFatDigDatas.mskDtaIni.Text;
      strDtaFin := frmFatDigDatas.mskDtaFin.Text;
      strNumDoc := frmFatDigDatas.edtNumDoc.Text;
      strEspDoc := frmFatDigDatas.edtEspDoc.Text;
      strNumCoo := frmFatDigDatas.edtNumCoo.Text;
      strEmpDoc := '';

      strEmpDocDev := frmFatDigDatas.edtCodEmp.Text;

      If (frmFatDigDatas.edtCodEmp.Visible) And
         (frmFatDigDatas.edtCodEmp.Enabled) And
         (Not fEmptyStr(frmFatDigDatas.edtCodEmp.Text)) Then
      Begin
        strEmpDoc             := frmFatDigDatas.edtCodEmp.Text;
        fatVenda.strEmpDocDev := frmFatDigDatas.edtCodEmp.Text;
      End;

      fatVenda.blnDevolucaoCompleta := frmFatDigDatas.chkDevCom.Checked;

      if blnCliPigBas Then
         fatVenda.strPigBas := 'S'
      else
        fatVenda.strPigBas := IIF(frmFatDigDatas.chkPigBas.Checked, 'S', 'N');

      blnBipaCod := (not fEmptyStr(frmFatDigDatas.edtNumDoc.Text)) And (not fEmptyStr(frmFatDigDatas.edtEspDoc.Text));

      If fEmptyStr(fTiraCaracEspeciais(strDtaIni)) And (fEmptyStr(strNumDoc) And (fEmptyStr(strNumCoo))) Then
        fatVenda.blnDvComDta := False
      Else
        fatVenda.blnDvComDta := True;

      If Not fEmptyStr(frmFatDigDatas.edtCodCliCon.Text) Then
        strCliCn2 := frmFatDigDatas.edtCodCliCon.Text
      Else
        strCliCn2 := '';

      If (Result) Then
        fatVenda.blnDevolucaoEmpresaAbastecimento := fDevolveDocumentoParaEmpresaAbastecimento(strNumDoc,strEspDoc,strEmpDocDev,edtCodCli.Text);

      If (Result) And
         (fCfgSis('DVOULJ', varString) = 'B') And
         (Not fEmptyStr(strEmpDocDev)) And
         (Not fEhMesmaBaseCNPJ(VS_strCodEmp, strEmpDocDev, True)) Then
        Result := False;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fDigDadosDevolucao]');
      End;
    End;

    pFreeAndNil(frmFatDigDatas);
  End;

  If Result And (not blnDevEsp) And fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True) And fEmptyStr(fatVenda.strCodAde) And (fEmptyStr(strNumRemessa)) Then
  Begin
    If fEmptyStr(strCliCn2) And
       fEmptyStr(strNumDoc) And
       fEmptyStr(strEspDoc) And
       fEmptyStr(strNumCoo) And ((VS_Date - StrToDateDef(strDtaIni, 0)) > 7) Then
    Begin
      Result := fMensagem('', 'Não foram informados filtros de documento, COO ou identificação ' +
        'do consumidor com isso a busca dos documentos poderá ser demorada. Deseja realmente ' +
        'continuar com essa operação?', ['','']) = 1;
    End;
  End;

  blnLiberouTravaDevolucao := False;
  If (fCfgSis('DOCDEV', varBoolean) And (not fEmptyStr(strNumDoc))) And (Pos(strOpcDoc, 'DV_PR_') > 0) Then
  Begin
    blnLiberouTravaDevolucao := fValidaDocumentoDevolucaoEmitidosDiasVencidos(strNumDoc, strEspDoc, strEmpDocDev, edtCodCli.Text);
    Result := blnLiberouTravaDevolucao;
  End;

  If Result And (fatVenda.blnDvComDta Or (Not fEmptyStr(strNumDoc)) Or (Not fEmptyStr(fatVenda.strCodAde))) Then
    fatVenda.pCarregaItensDevolucao(edtCodCli.Text, strCliCn2, strNumDoc, strEspDoc, strNumCoo, strEmpDoc,
                           StrToDateDef(strDtaIni, 0), StrToDateDef(strDtaFin, 0), fatVenda.strCodAde, pgbStatus)
  Else
    Exit;

  If fatVenda.qryTemporaria.IsEmpty Then
  Begin
    If fEmptyStr(fatVenda.strCodAde) Then
      fMensagem('ATENÇÃO!', 'Não há documentos nesse período!', ['&O k'])
    Else
      fMensagem('ATENÇÃO!', 'Não há documentos nesta AD para serem devolvidos!', ['&O k']);
    Result := False;
  End;

  If Result Then
  Begin
    edtCodCli.ReadOnly := True;
    edtSenVen.ReadOnly := fCfgSis('USADIG', varBoolean);
    lblTabPrecoItem.Visible := ((Pos(strOpcDoc, 'EF_') > 0) And (strNumDoc.IsEmpty));
    cbTabPrecoItem.Visible  := lblTabPrecoItem.Visible;
  End;

end;

function TfrmFatVendas.fDigDadosDevolucaoRapida(Var blnMSG : Boolean; pgbStatus: TcxProgressBar = Nil): Boolean;
Var
  strNumDoc,
  strEspDoc,
  strEmpDoc,
  strCliDoc,
  strNumCoo : String;
begin

  blnDesativaConfirmaDadosCabecalho := True;
  pInformacao('Aguarde, Carregando documento...', pgbStatus);
  pProgresso(0, 0, pgbStatus);

  Try

    pCriarFormularios(TfrmFatDigDatas, frmFatDigDatas);

    Try

      frmFatDigDatas.TipoTela     := ttDevolucaoRapida;
      frmFatDigDatas.blnMosChkDev := True;
      frmFatDigDatas.blnOpcDoc    := True;
      frmFatDigDatas.blnFatVenda  := False;

      frmFatDigDatas.lblMsgOF.Visible := False;
      fatVenda.pDestravaELimpaStlDocDevLck('','','','','',True);

      blnCliPigBas := False;

      frmFatDigDatas.strCodCli := '';
      frmFatDigDatas.blnNumDoc := True;
      frmFatDigDatas.strOpcDoc := strOpcDoc;
      frmFatDigDatas.showModal;

      Result := frmFatDigDatas.blnConfirma;
      blnMSG := Result;

      If Not Result Then
        Exit(False);

      If (frmFatDigDatas.blnLeitor_DevRap) Then
      Begin
        strNumDoc := frmFatDigDatas.strNumDoc_DevRap;
        strEspDoc := frmFatDigDatas.strEspDoc_DevRap;
        strEmpDoc := frmFatDigDatas.strEmpDoc_DevRap;
        strCliDoc := frmFatDigDatas.strCliDoc_DevRap;
      End
      Else
      Begin
        strNumDoc := frmFatDigDatas.edtNumDoc.Text;
        strEspDoc := frmFatDigDatas.edtEspDoc.Text;
        strEmpDoc := frmFatDigDatas.edtCodEmp.Text;
        strCliDoc := frmFatDigDatas.strCodCli;
      End;

      strNumCoo    := frmFatDigDatas.edtNumCoo.Text;
      strEmpDocDev := strEmpDoc;

      edtCodCli.Text := strCliDoc;
      edtCodCliExit(Self);

      pCarregaCliente;

      fatVenda.blnDevolucaoCompleta := frmFatDigDatas.chkDevCom.Checked;
      fatVenda.blnDvComDta          := False;
      fatVenda.strPigBas            := IIF(blnCliPigBas, 'S', IIF(frmFatDigDatas.chkPigBas.Checked, 'S', 'N'));

      If (Not fEmptyStr(strNumDoc)) Then
        fatVenda.pCarregaItensDevolucao(strCliDoc,
                                        '',
                                        strNumDoc,
                                        strEspDoc,
                                        strNumCoo,
                                        strEmpDoc,
                                        0,
                                        0,
                                        '',
                                        pgbStatus);

      If fatVenda.qryTemporaria.IsEmpty Then
        Exit(False);

      Result := fConsultaItemDev(False);

      If (Result) Then
      Begin
        edtCodCli.ReadOnly := True;
        edtSenVen.ReadOnly := (fCfgSis('USADIG', varBoolean));
        lblTabPrecoItem.Visible := ((Pos(strOpcDoc, 'EF_') > 0) And (strNumDoc.IsEmpty));
        cbTabPrecoItem.Visible  := lblTabPrecoItem.Visible;
      End;

    Finally
      pFreeAndNil(frmFatDigDatas);
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fDigDadosDevolucaoRapida]');
    End;
  End;

end;

