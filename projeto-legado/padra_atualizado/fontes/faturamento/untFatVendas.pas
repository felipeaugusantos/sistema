function TfrmFatVendas.fPermiteAlterarPedido(blnAlterando: Boolean): Boolean;
  Var
    strTmp: String;
    strOpc: String;
    strCliOrc: String;
    strOpcao: String;
begin
  Result := True;

  If blnAlterando Then
    strTmp := 'alter'
  Else
    strTmp := 'delet';

  If strOpcDoc = 'TE' Then
    strOpc := 'Transferência de Estoque'
  Else If strOpcDoc = 'OU' Then
    strOpc := 'Outras Saídas'
  Else
    strOpc := 'Venda Normal';

  strOpcao := IIF(fPos(strEspOrc, 'PD_'), 'pedido', 'orçamento');

  If (fPedidoOriundoDesmembramento) And (Not fCfgSis('EDPDDS', varBoolean)) Then
  Begin
    fMensagem('ATENÇÃO!', 'O sistema está configurado para não permitir alterar um pedido oriundo de desmembramento, '+
                          'você poderá apenas faturá-lo!', ['&Ok']);
    Result := False;
  End;

  If (Result) And
     (fPos(strOpcDoc, 'VN_TE_OU_')) And
     (Not fEmptyStr(strNumOrc) ) And
     (Not fEmptyStr(strEspOrc) ) And
     (Not fEmptyStr(strEmpOrc) ) And
     (fPos(strEspOrc, IIF(strOpcDoc = 'TE', 'PD_OR_', 'PD_'))) And
     (Not blnJaAvisouAltPD     ) Then
  Begin
    If fPermiteSelecionarEspeciePedido Then
    Begin
      fMensagem('ATENÇÃO!','Você está ' + strTmp + 'ando itens de um pedido, por isso só será permitido salvar o mesmo como pedido.',['&OK']);
      blnJaAvisouAltPD := True;
    End
    Else
    Begin
      If (strOpcDoc <> 'TE') Or ((strOpcDoc = 'TE') And (fCfgSis('PIAETE', varString) = 'N')) Then
      Begin
        fMensagem('ATENÇÃO!','Não é permitido ' + strTmp + 'ar itens de um '+strOpcao +' pela rotina de ' + strOpc +
                  '. Carregue o mesmo pela opção de '+strOpcao+' e realize as ' + IIF(blnAlterando, 'alterações', 'deleções') + ' necessárias.',['&OK']);
        Result := False;
      End;
    End;
  End;

  If (Result) And
     (fPos(strOpcDoc, 'VN_TE_OU_')) And
     (Not fEmptyStr(strNumOrc) ) And
     (Not fEmptyStr(strEspOrc) ) And
     (Not fEmptyStr(strEmpOrc) ) And
     (SameText(strEspOrc, 'OR')) And
     (Not blnJaAvisouAltPD     ) And
     (strEmpOrc <> fCodEmp)      And
     VS_strHabilitarCRM  Then
  Begin
    strCliOrc := fCampoTabela('FGO_CODCLI', 'FATGOR', ['FGO_CODEMP', 'FGO_ESPDOC', 'FGO_NUMDOC'],
                                                      [strEmpOrc, strEspOrc, strNumOrc]);

    If edtCodCli.Text <> strCliOrc Then
    Begin
      fMensagem('ATENÇÃO!','Não é permitido ' + strTmp + 'ar itens de um orçamento pela rotina de ' + strOpc +
                ' que incluem alteração de cliente. Carregue o mesmo pela opção de orçamento e realize as ' + IIF(blnAlterando, 'alterações', 'deleções') + ' necessárias.',['&OK']);
      Result := False;
    End;
  End;
end;

function TfrmFatVendas.fRetSenhaAutomaticaVendedorNoFaturamento(
  strCodVen: String): String;
begin
  if fCfgSis('USADIG', varBoolean) then
