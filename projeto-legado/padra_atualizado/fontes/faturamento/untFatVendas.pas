procedure TfrmFatVendas.bntSinaleiroInfoClick(Sender: TObject);
var
  frmDefinicoesSinaleiroFaturamento: TfrmDefinicoesSinaleiroFaturamento;
  intCnt : Integer;
begin

  inherited;

  If Not Assigned(fatVenda) Then
    Exit;

  If fEmptyStr(fatVenda.strCodVen) Then
    Exit;

  If (Not fVerificaAcessoSistema('SINALE')) Then
  Begin

    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Visualizar as informações e as margens/markups utilizadas na definição do sinaleiro do faturamento');

    objLiberacao.strDirAce  := 'SINALE';
    objLiberacao.strMsgSen  := 'Definições do Sinaleiro';
    objLiberacao.strCodOpe  := fatVenda.strCodVen;
    objLiberacao.strCodDig  := fatVenda.strCodDig;
    objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
    objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

    If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Exit;

  End;

  recSinaleiro.strPrecoUtilizadoParaCalculo := IIF(fCfgSis('INDSIN', varString) = '1', 'Preço de custo', 'Preço de custo real');
  recSinaleiro.strDiaParaCorte              := fCfgSis('DIASIN', varString);

  pCriarFormularios(TfrmDefinicoesSinaleiroFaturamento, frmDefinicoesSinaleiroFaturamento);

  Try

    frmDefinicoesSinaleiroFaturamento.recSinaleiro := Self.recSinaleiro;

    {Ajusta labels}
    for intCnt := 0 to frmDefinicoesSinaleiroFaturamento.ComponentCount -1 do
      If (frmDefinicoesSinaleiroFaturamento.Components[intCnt] Is TLabel) Then
        If (fMargem_ou_Markup = 'MARKUP') Then
          (frmDefinicoesSinaleiroFaturamento.Components[intCnt] As TLabel).Caption :=
            StringReplace((frmDefinicoesSinaleiroFaturamento.Components[intCnt] As TLabel).Caption, 'Margem', 'Markup', [rfReplaceAll]);

    frmDefinicoesSinaleiroFaturamento.ShowModal;

  Finally
    FreeAndNil(frmDefinicoesSinaleiroFaturamento);
  End;

end;

function TfrmFatVendas.fPodeAdicionarItem: Boolean;
begin
