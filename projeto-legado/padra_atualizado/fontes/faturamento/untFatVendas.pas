procedure TfrmFatVendas.pMontaMsgTabPreco(strTabPrecoNova: String; intAutInc:Integer=-1; qryIteGer: TDataSet = Nil; strTabPrecoAnter: String='');
  Var
    cdsIteCom: TUniClientDataSet;
    fltUnitarAnt: Double;
    strTabPreAnt: String;
    fltUnitarNov: Double;
    strTabPreNov: String;

    procedure pAdicionaLinha(cds: TDataSet);
    begin
      objLinha := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlValor;
      objLinha.pAddColuna('Código'      , cds.FieldByName('ITE_CODITE').AsString,fTamCodIte + 1 , alCentro,   teAmbos);
      If cds.FindField('ITE_DESITE') <> Nil Then
        objLinha.pAddColuna('Descrição' , cds.FieldByName('ITE_DESITE').AsString,42, alEsquerda, teAmbos)
      Else
        objLinha.pAddColuna('Descrição' , edtDesIte.Text                        ,42, alEsquerda, teAmbos);
      If cds.FindField('ITE_SIGUNI') <> Nil Then  
        objLinha.pAddColuna('UN'        , cds.FieldByName('ITE_SIGUNI').AsString,03, alCentro,   teAmbos)
      Else 
        objLinha.pAddColuna('UN'        , edtSigla.Text                         ,03, alCentro,   teAmbos);
      objLinha.pAddColuna('Tab. Atual'  , strTabPreAnt                          ,11, alCentro,   teAmbos);
      objLinha.pAddColuna('Pr.Tab.Atual', FormatFloat('#,##0.00', fltUnitarAnt) ,12, alDireita,  teAmbos);
      objLinha.pAddColuna('Nova Tabela' , strTabPreNov                          ,11, alCentro,   teAmbos);
      objLinha.pAddColuna('Pr.Tab.Nova' , FormatFloat('#,##0.00', fltUnitarNov) ,12, alDireita,  teAmbos);
      objTabela.lstLinhas.Add(objLinha);
    end;
    
begin
  If (strTabPrecoAnter.IsEmpty) Then
    strTabPrecoAnter := '1';

  If (Not Assigned(qryIteGer)) Then
  Begin
    cdsIteCom := TUniClientDataSet.Create(Nil);
    pCloneDataSet(cdsIteCom, cdsVenda);
    Try
      cdsIteCom.First;
      While Not cdsIteCom.Eof Do
      Begin
        if (intAutInc = -999) then
        Begin
          If (cdsIteCom.FieldByName('ITE_ITETRA').AsBoolean) Then
          Begin
            strTabPreAnt := cdsIteCom.FieldByName('ITE_TABANT').AsString;
            fltUnitarAnt := cdsIteCom.FieldByName('ITE_PREANT').AsFloat;

            strTabPreNov := cdsIteCom.FieldByName('ITE_TABPRE').AsString;
            fltUnitarNov := cdsIteCom.FieldByName('ITE_PRETAB').AsFloat;

            pAdicionaLinha(cdsIteCom);
          End;
        End
        Else If IIF(intAutInc = -1, True, intAutInc = cdsIteCom.FieldByName('AUTOINCREM').AsInteger) Then
        Begin
          strTabPreAnt := cdsIteCom.FieldByName('ITE_TABPRE').AsString;
          fltUnitarAnt := cdsIteCom.FieldByName('ITE_PRETAB').AsFloat;

          strTabPreNov := strTabPrecoNova;
          fltUnitarNov := fatVenda.fPegaPrecoVenda(cdsIteCom, cdsIteCom.FieldByName('ITE_EMPITE').AsString,
                                                   'S',
                                                   fStrToFloat(edtMargem.Text),
                                                   False,
                                                   fatVenda.strIdePro,
                                                   strTabPrecoNova,
                                                   True,
                                                   fatVenda.FTaxJur,
                                                   fatVenda.FUniVis);

          pAdicionaLinha(cdsIteCom)
        End;

        cdsIteCom.Next;
      End;
    Finally
      FreeAndNil(cdsIteCom);
    End;
  End
  Else
  Begin
    strTabPreAnt := strTabPrecoAnter;
    fltUnitarAnt := fatVenda.fPegaPrecoVenda(qryIteGer, qryIteGer.FieldByName('ITE_CODEMP').AsString,
                                             'S',
                                             fStrToFloat(edtMargem.Text),
                                             False,
                                             fatVenda.strIdePro,
                                             strTabPrecoAnter,
                                             True,
                                             fatVenda.FTaxJur,
                                             fatVenda.FUniVis);
    strTabPreNov := strTabPrecoNova;
    fltUnitarNov := fatVenda.fPegaPrecoVenda(qryIteGer, qryIteGer.FieldByName('ITE_CODEMP').AsString,
                                             'S',
                                             fStrToFloat(edtMargem.Text),
                                             False,
                                             fatVenda.strIdePro,
                                             strTabPrecoNova,
                                             True,
                                             fatVenda.FTaxJur,
                                             fatVenda.FUniVis);
    pAdicionaLinha(qryIteGer);                                         
  End;

  If (intAutInc = 0) Then
  Begin
    strTabAntTra := strTabPreAnt;
    fltPreAntTra := fltUnitarAnt;
  End;
end;

function TfrmFatVendas.fAlteraPrecoPedidoOrcamento(
  dtaDtaDoc: TDateTime; strCodVen, strCodDig, strCodCli: String): Boolean;

  Const
    MANTER_NEGOCIADOS = False;
    ATUALIZAR_PRECOS = True;
  Var
    intDias,
    intDiasTolerancia : Integer;
    strAtpSen,
    strMensagem,
    strDireitoAcesso : String;
    blnAtualizaPreco : Boolean;
begin
  blnPedidoVencido  := False;
  blnAtualizaPreco  := False;
  intDiasTolerancia := 0;
  blnManterPrecosDentroDiasTolerado := False;

  Result := MANTER_NEGOCIADOS;

  If (strEspOrc = 'PD') Then
  Begin
    blnAtualizaPreco  := fCfgSis('ATPRPO', varBoolean);
    intDiasTolerancia := fCfgSis('ATPRDI', varInteger);
    strAtpSen         := fCfgSis('ATPSEN');
    strDireitoAcesso  := 'ATPRPO';
    strMensagem       := 'pedido';
  End
  Else If (strEspOrc = 'OR') Then
  Begin
    blnAtualizaPreco  := fCfgSis('ATPROR', varBoolean);
    intDiasTolerancia := fCfgSis('ATPDIO', varInteger);
    strAtpSen         := fCfgSis('ATPSOR');
    strDireitoAcesso  := 'ATPROR';
    strMensagem       := 'orçamento';
  End;

  If blnAtualizaPreco Then
  Begin
    intDias := DaysBetween(VS_Date, dtaDtaDoc);
    If (intDias > intDiasTolerancia) Then
    Begin
      blnPedidoVencido := True;

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Atualização de preços ao alterar, faturar ou herança de um ' + strMensagem + '.');
      objLiberacao.objMsgLibera.pAddSeparador(85);
      objLiberacao.objMsgLibera.pAddTexto(Format('Documento com validade ultrapassada [%d dia%s] - Manter Preços Negociados.', [intDias, IIF(intDias = 1, '', 's')]));
      objLiberacao.objMsgLibera.pAddTextoCaption('Documento',  strNumOrc + '-' + strEspOrc + '-' + strEmpOrc);

      If fMensagem('', Format('Este documento ultrapassou a quantidade de [%d dia%s] de validade. ' +
                              'Escolha a opção desejada:', [intDias, IIF(intDias = 1, '', 's')]), ['&Manter Preços Negociados', '&Atualizar Preços'], 2, False, 1, 221) = 1 Then
      Begin
        objLiberacao.strDirAce := strDireitoAcesso;
        objLiberacao.strSenLib := strAtpSen;
        objLiberacao.strMsgSen := 'Atualização de preços ao alterar, faturar ou herança de um ' + strMensagem + '.';
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + fRetNomCliente(strCodCli);
        If fatVenda.fFatMensagemLiberacao(objLiberacao) Then
        Begin
          Result := MANTER_NEGOCIADOS;
          blnManterPrecosNegociadosMedianteLiberacao := True;
        End
        Else
        Begin
          fatVenda.blnFecharForm := True;
        End;
      End
      Else
        Result := ATUALIZAR_PRECOS;
    End
    Else
      blnManterPrecosDentroDiasTolerado := True;
  End;
end;

function TfrmFatVendas.fAlterarDuplicatasAdicionandoValorDoAdiantamento: Boolean;
begin
  Result := True;

  If fatVenda.fltValAdt + IIF(fatVenda.blnBolVen, 0, fatVenda.fltBolAdt) > 0 Then
  Begin
    If fatVenda.fPermiteInformarVencimentosParaBoletoDeAdiantamento(Not fatVenda.blnBolVen) Then
      Result := Result And fatVenda.fAdicionaAdiantamentoUltimaParcela
    Else
      Result := Result And fatVenda.fAdicionaAdiantamentoPrimeiraParcela;
  End;

  if (fatVenda.fltValAdt > 0) and (fatVenda.strOpcDoc = 'CP') then
  begin
    fatVenda.blnResCaiAdt :=
      TAdiantamento.fGetResCaiAdiantamento(fatVenda.strNumOrc,
                                           fatVenda.strEspOrc,
                                           fatVenda.strEmpDoc,
                                           fatVenda.strCodCli);
  end;
  
end;

function TfrmFatVendas.fAlterouAlgumCampoSemSerODeDataDeEntrega : Boolean;
var
  intDecQtd : Integer;
begin

  Result := True;

  intDecQtd := fCfgSis('DECQTD', VarInteger);

  If (pnlEmpresa.Visible) And (edtCodEmp.Text <> cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
    Exit;

  If fFormataFloat(fStrToFloat(edtQtdIte.Text), intDecQtd) <>
     fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, intDecQtd) Then
    Exit;

  If fFormataFloat(fStrToFloat(edtTotIte.Text), 2) <>
     fFormataFloat(cdsVenda.FieldByName('ITE_TOTITE').AsFloat, 2) Then
    Exit;

  Result := False;

end;

