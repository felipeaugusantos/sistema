function TfrmFatVendas.fValidarAlteracaoPedidoEOrcamento(): Boolean;
Var
  intIdx: Integer;
Begin
  Result := True;

  {************************************}
  {* SENHA P\ ALTERAÇÃO DO PEDIDO     *}
  {*********************************JB*}
  If (Not fEmptyStr(fatVenda.strNumOrc))                   And
     (fatVenda.strEspOrc = 'PD')                           And
     (fatVenda.strEspDoc = 'PD')                           And
     (qryFatGor.Active)                                    And
     (qryFatGor.FieldByName('FGO_ENT_CD').AsString <> 'S') And
     (Not (fEmptyStr(fCfgSis('SENPED', varString)))) Then
  Begin
    FVariaveisFechamentoVenda.stlAlteracoesDocumento := TStringList.Create;

    Try
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Alteração de Pedido');
      objLiberacao.objMsgLibera.pAddTextoCaption('Documento', Concat(fatVenda.strNumOrc, '-',
                                                                     fatVenda.strEspDoc, '-',
                                                                     fatVenda.strEmpDoc));
      objLiberacao.objMsgLibera.pAddTextoCaption('Data Doc', FormatDateTime('dd/mm/yyyy', fatVenda.dtaDtaEntOri));

      FVariaveisFechamentoVenda.stlAlteracoesDocumento.Text := fObterDetalhesModificacaoPedOrc();

      For intIdx := 0 To Pred(FVariaveisFechamentoVenda.stlAlteracoesDocumento.Count) Do
        objLiberacao.objMsgLibera.pAddTexto(FVariaveisFechamentoVenda.stlAlteracoesDocumento[intIdx]);

      objLiberacao.strDirAce := 'SENPED';
      objLiberacao.strSenLib := fCfgSis('SENPED', varString);
      objLiberacao.strMsgSen := 'Alteração de Pedido';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

      If (Not objLiberacao.fLibera) Then
      Begin
        fMensagem('','Senha incorreta!',['&OK']);
        Result := False;
        Exit;
      End;
    Finally
      FVariaveisFechamentoVenda.stlAlteracoesDocumento.Free;
    End;
  End;

  {************************************}
  {* SENHA P\ ALTERAÇÃO DO ORÇAMENTO  *}
  {*********************************VA*}
  If (Not fEmptyStr(fatVenda.strNumOrc))             And
     (fatVenda.strEspOrc = 'OR')                     And
     ((fatVenda.strEspDoc = 'OR') Or
       blnSolicitouFecharOREmPDLocal)                And
     (Not (fEmptyStr(fCfgSis('SENORC', varString)))) Then
  Begin
    FVariaveisFechamentoVenda.stlAlteracoesDocumento := TStringList.Create;

    Try
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Alteração de Orçamento');
      objLiberacao.objMsgLibera.pAddTextoCaption('Documento', Concat(fatVenda.strNumOrc, '-',
                                                                     fatVenda.strEspOrc, '-',
                                                                     fatVenda.strEmpDoc));

      objLiberacao.strDirAce := 'SENORC';
      objLiberacao.strSenLib := fCfgSis('SENORC', varString);
      objLiberacao.strMsgSen := 'Alteração de Orçamento';

      FVariaveisFechamentoVenda.stlAlteracoesDocumento.Text := fObterDetalhesModificacaoPedOrc();

      For intIdx := 0 To Pred(FVariaveisFechamentoVenda.stlAlteracoesDocumento.Count) Do
        objLiberacao.objMsgLibera.pAddTexto(FVariaveisFechamentoVenda.stlAlteracoesDocumento[intIdx]);

      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;

      If (Not objLiberacao.fLibera ) Then
      Begin
        fMensagem('','Senha incorreta!',['&OK']);
        Result := False;
        Exit;
      End;
    Finally
      FVariaveisFechamentoVenda.stlAlteracoesDocumento.Free;
    End;
  End;
End;

function TfrmFatVendas.fValidarClienteFilialComProdutosMultiLoja(
  strEmpresaTE: String): Boolean;
var
  cdsProdutos: TUniClientDataSet;
  strEmpPrdAnt: String;
begin
  Result := True;

  if cdsVenda.RecordCount <= 0 then
    Exit;

  cdsProdutos := TUniClientDataSet.Create(Self);

  try
    pCloneDataSet(cdsProdutos, cdsVenda);

    cdsProdutos.Filtered := False;
    cdsProdutos.Filter := ' ITE_EMPITE <> '+QuotedStr(strEmpresaTE)+' ';
    cdsProdutos.Filtered := True;

    if cdsProdutos.RecordCount <= 0 then
      Exit;

    if fMensagem('ATENÇÃO', 'Há itens no grid com empresa multi-lojas diferente da empresa que foi escolhida para fazer a transferência de estoque. '+
                            'Ao continuar, a empresa será atualizada no grid. Deseja realmente continuar?', ['&Sim', '&Não'], 2) = 2 then
    begin
      Exit(False);
    end;

    cdsVenda.DisableControls;

    try
      cdsVenda.First;

      while not cdsVenda.Eof do
      begin
        strEmpPrdAnt := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_EMPITE').AsString := strEmpresaTE;
        if not fEmptyStr(cdsVenda.FieldByName('ITE_EMPPRD').AsString) then
          cdsVenda.FieldByName('ITE_EMPPRD').AsString := strEmpresaTE;
        cdsVenda.Post;

        pRecalculaTintaMaquinaSelecionadoCasoNecessario(strEmpPrdAnt);

        cdsVenda.Next;
      end;
    finally
      cdsVenda.First;
      cdsVenda.EnableControls;
    end;
  finally
    FreeAndNil(cdsProdutos);
  end;
end;

