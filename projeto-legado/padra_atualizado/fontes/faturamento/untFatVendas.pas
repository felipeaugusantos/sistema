procedure TfrmFatVendas.pAtualizaUnitarioDolar(fltUniLiq: Double);
begin
  If Not Assigned(fatVenda) Then
    Exit;

  If Not pnlCotacaoDolar.Visible Then
    Exit;

  edtVlCtVn.Text := FormatFloat(edtUniDol.EditFormat, fatVenda.fltVlCtVn);
  edtDtCtVn.Text := FormatDateTime('dd/MM/yyyy', fatVenda.dtaDtCtVn);

  edtUniDol.Clear;
  If (fatVenda.fltVlCtVn > 0) And fItemUtilizaPrecoEmDolar(fCodItem) Then
    edtUniDol.Text := FormatFloat(edtUniDol.EditFormat, fltUniLiq / fatVenda.fltVlCtVn);
end;

function TfrmFatVendas.fVoltaUnitarioSemAparelBenefi(fltUnitar, fltPerApa,
  fltPerBen: Double): Double;
begin
  Result := fltUnitar;

  If (fltPerBen > 0) Then
    Result := (Result / (1 + (fltPerBen / 100)));

  If (fltPerApa > 0) Then
    Result := (Result / (1 + (fltPerApa / 100)));
end;

