function TfrmFatVendas.fExisteItemPD_OR(strNumDoc, strEspDoc, strEmpDoc, strCodIte, strSeqInc : String): Boolean;
var
  qryAux : TUniQuery;
const
  SQL = 'SELECT         ' +
        '  COUNT(*) TOT ' +
        'FROM           ' +
        '  FATDOR       ' +
        '  INNER JOIN EXTDOR ON (EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM) ' +
        'WHERE          ' +
        '  FDO_NUMDOC = :NUMDOC AND ' +
        '  FDO_ESPDOC = :ESPDOC AND ' +
        '  FDO_CODEMP = :CODEMP AND ' +
        '  FDO_CODITE = :CODITE AND ' +
        '  FDO_SEQINC = :SEQINC ';
begin

  If fEmptyStr(strNumDoc) Then
    Exit(False);

  If fEmptyStr(strEspDoc) Then
    Exit(False);

  If fEmptyStr(strEmpDoc) Then
    Exit(False);

  If fEmptyStr(strCodIte) Then
    Exit(False);

  If fEmptyStr(strSeqInc) Then
    Exit(False);

  qryAux := fCriaQuery;

  Try

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(SQL);
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strEmpDoc;
    qryAux.ParamByName('CODITE').AsString := strCodIte;
    qryAux.ParamByName('SEQINC').AsString := strSeqInc;
    qryAux.Open;

    Result := (Not qryAux.IsEmpty) And (qryAux.FieldByName('TOT').AsInteger > 0);

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TfrmFatVendas.fExisteItemTintaMaquina: Boolean;
Var
  cdsIteTmp: TUniClientDataSet;
begin

  Result := False;

  Try

    If (cdsVenda = nil) Or (cdsVenda.IsEmpty)  Then
      Exit;

    cdsIteTmp := TUniClientDataSet.Create(Self);
    cdsIteTmp.Data := cdsVenda.Data;
    cdsIteTmp.LogChanges := False;
    cdsIteTmp.Open;
    cdsIteTmp.LogChanges := False;

    cdsIteTmp.Filter   := 'ITE_IDEPRO <> ' + QuotedStr('NOR');
    cdsIteTmp.Filtered := True;

    Result := (Not cdsIteTmp.IsEmpty);

  Except
    On E: Exception Do
      pMensagensErro(e.Message, '[TfrmFatVendas.fExisteItemTintaMaquina]');
  End;

  FreeAndNil(cdsIteTmp);

end;

procedure TfrmFatVendas.pVerificaDivergenciasPedOrc;
  Var
    cdsItens : TUniClientDataSet;
    cdsDados : TUniClientDataSet;
    strIdePro: String;
    fltUniOri,
    fltVal_RT,
    fltUniLot: Double;
    strTabela: String;
    strEmpItePro: String;
    strCndTmp: String;
    blnParticiona,
    blnPromo: Boolean;
    fltQtdDis: Double;
    fltTaxaJuros: Double;
    fltUniSemJuros: Double;
    blnAplicarTaxaJuros : Boolean;

  function fEmpIte: String;
  Begin
    Result := IIF(fEmptyStr(cdsDados.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsDados.FieldByName('ITE_EMPITE').AsString);
  End;
begin

  cdsItens := TUniClientDataSet.Create(Self);
  cdsDados := TUniClientDataSet.Create(Self);

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'CODITE';
    DataType := ftString;
    Size := fTamCodIte + 1;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'DESCRI';
    DataType := ftString;
    Size := 50;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNIDAD';
    DataType := ftString;
    Size := 2;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'QTDITE';
    DataType := ftFloat;
    Precision := 2
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNIANT';
    DataType := ftFloat;
    Precision := fatVenda.VS_intDecUni;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'TOTANT';
    DataType := ftFloat;
    Precision := 2;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNICOM';
    DataType := ftFloat;
    Precision := fatVenda.VS_intDecUni;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'TOTCOM';
    DataType := ftFloat;
    Precision := 2;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNIATU';
    DataType := ftFloat;
    Precision := fatVenda.VS_intDecUni;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'TOTATU';
    DataType := ftFloat;
    Precision := 2;
  End;

  cdsItens.CreateDataSet;
  cdsItens.LogChanges := False;

  TFloatField(cdsItens.FieldByName('QTDITE')).DisplayFormat := '#,##0.00';
  TFloatField(cdsItens.FieldByName('UNIANT')).DisplayFormat := fMskDigitos(fatVenda.VS_intDecUni);
  TFloatField(cdsItens.FieldByName('TOTANT')).DisplayFormat := '#,##0.00';
  TFloatField(cdsItens.FieldByName('UNICOM')).DisplayFormat := fMskDigitos(fatVenda.VS_intDecUni);
  TFloatField(cdsItens.FieldByName('TOTCOM')).DisplayFormat := '#,##0.00';
  TFloatField(cdsItens.FieldByName('UNIATU')).DisplayFormat := fMskDigitos(fatVenda.VS_intDecUni);
  TFloatField(cdsItens.FieldByName('TOTATU')).DisplayFormat := '#,##0.00';

  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;

  strCndTmp := '';

  If (fCfgSis('CNDVEN') = 'I') Then
  Begin
    strCndTmp := IIF(Not fCfgSis('RECCND', varBoolean), fRetConPag(fatVenda.strCodCnd), '');

    fatVenda.pCalculaTaxVpr(strCndTmp);
  End;

  While (Not cdsDados.Eof) Do
  Begin
    blnParticiona := False;
    blnPromo      := False;
    fatVenda.strPromoc := 'N';

    strEmpItePro := fatVenda.fGetEmpPrecoPromoItem(fEmpIte, cdsDados.FieldByName('ITE_EMPDMP').AsString);
    strIdePro := cdsDados.FieldByName('ITE_IDEPRO').AsString;

    blnItemEspecial := (Pos('ITEM ESPECIAL', cdsDados.FieldByName('ITE_DESORI').AsString) > 0);

    If (strIdePro = 'NOR') Then
    Begin
      If fEmptyStr(cdsDados.FieldByName('ITE_TABPRE').AsString) Then
        strTabela := fatVenda.strTabPre
      Else
        strTabela := cdsDados.FieldByName('ITE_TABPRE').AsString;
    End
    Else
    Begin
      strTabela := fatVenda.fTabelaPrecoTinta(fatVenda.strCodCli, '', cdsDados.FieldByName('ITE_TABPRE').AsString, True, False, False);
    End;

    If (fatVenda.stlItensNaoEhEstrutura.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) And
       (Not fItemEstrutura(cdsDados.FieldByName('ITE_CODITE').AsString)) Then
    Begin
      fatVenda.stlItensNaoEhEstrutura.Add(cdsDados.FieldByName('ITE_CODITE').AsString);
    End;

    If (fatVenda.stlItensNaoTemLote.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) And
       (fatVenda.objCadLot.fItemSemNenhumLote(cdsDados.FieldByName('ITE_CODITE').AsString)) Then
    Begin
      fatVenda.stlItensNaoTemLote.Add(cdsDados.FieldByName('ITE_CODITE').AsString);
    End;

    If (fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro)) Then
    Begin
      If (fRetornaPrecosPromocao(cdsDados.FieldByName('ITE_CODITE').AsString,
                                 fatVenda.strCodCli,
                                 VS_Date,
                                 IIF(cdsDados.FieldByName('ITE_QTDITE').AsFloat > 0, cdsDados.FieldByName('ITE_QTDITE').AsFloat, 1),

                                 fatVenda.fRetQtdDigitada(cdsDados.FieldByName('ITE_CODITE').AsString,'',
                                   cdsDados.FieldByName('AUTOINCREM').AsString,'','',strEmpItePro, False),

                                 fatVenda.fRetQtdDigitada(cdsDados.FieldByName('ITE_CODITE').AsString,'',
                                   cdsDados.FieldByName('AUTOINCREM').AsString,'','',strEmpItePro,
                                   False, False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,True {Somente em promocao}),

                                 fatVenda.intPrzMed,
                                 fatVenda.fltProPreCus,
                                 fatVenda.fltProPreVen,
                                 fatVenda.fltProComVar,
                                 fatVenda.fltProComAta,
                                 fatVenda.fltProComDis,
                                 fltQtdDis,
                                 fatVenda.fltProDesF07,
                                 fatVenda.strComPro,
                                 fatVenda.strCodPro,
                                 blnParticiona,
                                 blnPromo,
                                 strTabela,
                                 fatVenda.strCodCnd,
                                 '',
                                 '',
                                 True,
                                 False,
                                 '-1',
                                 ((cdsDados.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsDados.FieldByName('ITE_ENTFUT').AsString = 'N')),
                                 ((cdsDados.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsDados.FieldByName('ITE_ENTFUT').AsString = 'S')),
                                 cdsDados.FieldByName('ITE_MOTFUT').AsString,
                                 strEmpItePro,
                                 strNumOrc,
                                 strEspOrc,
                                 Nil,
                                 False,
                                 '',
                                 objPromVlrMinTotalProdutos,
                                 '',
                                 cdsDados.FieldByName('ITE_SOMCOL').AsFloat)) Then
      Begin
        If (Not blnParticiona) Then
          fatVenda.strPromoc := 'S';
      End;
    End;

    If (strIdePro = 'NOR') And
       (fCfgSis('SUGVLE') = '2') And
       (fatVenda.stlItensNaoEhEstrutura.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) Then
    Begin
      blnAplicarTaxaJuros := Not ((fatVenda.strJurPro = 'N') And (cdsDados.FieldByName('ITE_PROMOC').AsString = 'S'));
      fltUniOri := fatVenda.fCalculaPrecoEstrutura( blnAplicarTaxaJuros And fAplicarTaxaJurosPrecoSugestao,
                                                    Preco_de_Venda,
                                                    cdsDados.FieldByName('ITE_CODITE').AsString,
                                                    cdsDados.FieldByName('ITE_EMPITE').AsString,
                                                    cdsDados.FieldByName('ITE_ENTSAI').AsString,
                                                    strTabela,
                                                    fStrToFloat(edtMargem.Text) );

      If blnAplicarTaxaJuros Then
      Begin
        If fAplicarTaxaJurosPrecoSugestao Then
          fltUniOri := fltUniOri + fFormataFloat(fltUniOri * (fatVenda.fGetTaxVprItem(cdsDados.FieldByName('ITE_CODITE').AsString, cdsDados.FieldByName('ITE_EMPITE').AsString, strCndTmp) / 100.0), 04);
      End;
    End

    Else if (strIdePro = 'NOR') And
            (Not fatVenda.fEhEmissaoDocumentoWMS) And
            (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
            (fatVenda.stlItensNaoTemLote.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) And

            (fatVenda.objCadLot.fExisteLote(cdsDados.FieldByName('ITE_CODITE').AsString,
                                            IIF(fatVenda.blnEmpFat,
                                                cdsDados.FieldByName('ITE_EMPITE').AsString,
                                                fatVenda.fEmpresaSaldoMatriz_CD),
                                            cdsDados.FieldByName('ITE_NUMLOT').AsString) And

            fatVenda.fCalculaPrecosLote(cdsDados.FieldByName('ITE_QTDITE').AsFloat, fltUniLot, IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''))) Then
    Begin
      fltUniOri := fltUniLot;

      If Not ((fatVenda.strJurPro = 'N') And (cdsDados.FieldByName('ITE_PROMOC').AsString = 'S')) Then
        If fAplicarTaxaJurosPrecoSugestao Then
          fltUniOri := fltUniOri + fFormataFloat(fltUniOri * (fatVenda.fGetTaxVprItem(cdsDados.FieldByName('ITE_CODITE').AsString, cdsDados.FieldByName('ITE_EMPITE').AsString, strCndTmp) / 100.0), 04);
    End

    Else
    Begin
      fltUniOri := fatVenda.fPegaPrecoVenda(cdsDados,
                                            cdsDados.FieldByName('ITE_EMPITE').AsString,
                                            cdsDados.FieldByName('ITE_ENTSAI').AsString,
                                            fStrToFloat(edtMargem.Text),
                                            blnItemEspecial,
                                            strIdePro,
                                            strTabela,
                                            True,
                                            fltTaxaJuros,
                                            fltUniSemJuros,
                                            (Not fEmptyStr(cdsDados.FieldByName('ITE_BAREMB').AsString)),
                                            fRetornaPrecoCodBarraEmb(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                     cdsDados.FieldByName('ITE_BAREMB').AsString,
                                                                     VS_strCodEmp,
                                                                     strTabela,
                                                                     True),
                                            fRetornaTabPreCodBarraEmb(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                      cdsDados.FieldByName('ITE_BAREMB').AsString),
                                            strCndTmp);
    End;

    fatVenda.pCalculaValorRT(fltUniOri, fltVal_RT);

    If fCarregarEstruturaVidro(cdsDados.FieldByName('ITE_CODITE').AsString, cdsDados.FieldByName('AUTOINCREM').AsInteger) Then
    Begin
      If fAtualizaPrecosEstruturaVidro(strTabela, cdsDados.FieldByName('ITE_ENTFUT').AsString, cdsDados.FieldByName('ITE_EMPITE').AsString, False) > 0 Then
        fltUniOri := fatVenda.fltUniOri;
    End;

    If fFormataFloat(fltUniOri, 2) <> fFormataFloat(cdsDados.FieldByName('ITE_UNIORI').AsFloat, 2) Then
    Begin
      cdsItens.Append;
      cdsItens.FieldByName('CODITE').AsString := cdsDados.FieldByName('ITE_CODITE').AsString;
      cdsItens.FieldByName('DESCRI').AsString := cdsDados.FieldByName('ITE_DESITE').AsString;
      cdsItens.FieldByName('UNIDAD').AsString := cdsDados.FieldByName('ITE_UNIDAD').AsString;
      cdsItens.FieldByName('QTDITE').AsFloat  := cdsDados.FieldByName('ITE_QTDITE').AsFloat;

      cdsItens.FieldByName('UNIANT').AsFloat  := cdsDados.FieldByName('ITE_UNIORI').AsFloat;
      cdsItens.FieldByName('TOTANT').AsFloat  := cdsDados.FieldByName('ITE_UNIORI').AsFloat *
                                                 cdsDados.FieldByName('ITE_QTDITE').AsFloat;

      cdsItens.FieldByName('UNICOM').AsFloat  := cdsDados.FieldByName('ITE_UNITAR').AsFloat;
      cdsItens.FieldByName('TOTCOM').AsFloat  := cdsDados.FieldByName('ITE_TOTITE').AsFloat;

      cdsItens.FieldByName('UNIATU').AsFloat  := fltUniOri;
      cdsItens.FieldByName('TOTATU').AsFloat  := fltUniOri * cdsDados.FieldByName('ITE_QTDITE').AsFloat;
      cdsItens.Post;
    End;

    cdsDados.Next;
  End;

  If (Not cdsItens.IsEmpty) Then
  Begin
    Try
      pCriarFormularios(TfrmFatMostraDivergenciasPedOrc, frmFatMostraDivergenciasPedOrc);
      frmFatMostraDivergenciasPedOrc.dbgItens.DataSource.DataSet := cdsItens;
      frmFatMostraDivergenciasPedOrc.ShowModal;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[pVerificaDivergenciasPedOrc]');
    End;

    pFreeAndNil(frmFatMostraDivergenciasPedOrc);

  End;

  FreeAndNil(cdsItens);
  FreeAndNil(cdsDados);

end;

procedure TfrmFatVendas.pVerificaDivergenciasPromo(const blnRecalcularItens: Boolean; out blnRecalculouItens: Boolean);
  Var
    cdsItens : TUniClientDataSet;
    cdsDados : TUniClientDataSet;
    strIdePro: String;
    fltUniOri,
    fltVal_RT,
    fltUniLot: Double;
    strTabela: String;
    strEmpItePro: String;
    blnParticiona,
    blnPromo: Boolean;
    fltQtdDis: Double;
    fltTaxaJuros: Double;
    fltUniSemJuros: Double;
    blnManterPrecoPromoc : Boolean;
    blnTemDivergenciasPromo: Boolean;
    blnAplicarTaxaJuros : Boolean;

  function fEmpIte: String;
  Begin
    Result := IIF(fEmptyStr(cdsDados.FieldByName('ITE_EMPITE').AsString), VS_strCodEmp, cdsDados.FieldByName('ITE_EMPITE').AsString);
  End;

  function fTemDivergencia: Boolean;
  Begin
    If (strIdePro = 'NOR') Then
      Result := ((cdsDados.FieldByName('ITE_PROMOC').AsString = 'S') and (fatVenda.strPromoc = 'N'))
    Else
      Result := fatVenda.fExisteTintaComPromocaoVencidaNoPedido(strNumOrc,
                                                                strEspOrc,
                                                                strEmpItePro,
                                                                fatVenda.strCodCli,
                                                                cdsDados.FieldByName('ITE_CODITE').AsString);
  End;

begin

  blnRecalculouItens := False;
  cdsItens := TUniClientDataSet.Create(Self);
  cdsDados := TUniClientDataSet.Create(Self);

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'CODITE';
    DataType := ftString;
    Size := fTamCodIte + 1;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'DESCRI';
    DataType := ftString;
    Size := 50;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNIDAD';
    DataType := ftString;
    Size := 2;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'QTDITE';
    DataType := ftFloat;
    Precision := 2
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNIANT';
    DataType := ftFloat;
    Precision := fatVenda.VS_intDecUni;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'TOTANT';
    DataType := ftFloat;
    Precision := 2;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNICOM';
    DataType := ftFloat;
    Precision := fatVenda.VS_intDecUni;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'TOTCOM';
    DataType := ftFloat;
    Precision := 2;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'UNIATU';
    DataType := ftFloat;
    Precision := fatVenda.VS_intDecUni;
  End;

  With cdsItens.FieldDefs.AddFieldDef Do
  Begin
    Name := 'TOTATU';
    DataType := ftFloat;
    Precision := 2;
  End;

  cdsItens.CreateDataSet;
  cdsItens.LogChanges := False;

  TFloatField(cdsItens.FieldByName('QTDITE')).DisplayFormat := '#,##0.00';
  TFloatField(cdsItens.FieldByName('UNIANT')).DisplayFormat := fMskDigitos(fatVenda.VS_intDecUni);
  TFloatField(cdsItens.FieldByName('TOTANT')).DisplayFormat := '#,##0.00';
  TFloatField(cdsItens.FieldByName('UNICOM')).DisplayFormat := fMskDigitos(fatVenda.VS_intDecUni);
  TFloatField(cdsItens.FieldByName('TOTCOM')).DisplayFormat := '#,##0.00';
  TFloatField(cdsItens.FieldByName('UNIATU')).DisplayFormat := fMskDigitos(fatVenda.VS_intDecUni);
  TFloatField(cdsItens.FieldByName('TOTATU')).DisplayFormat := '#,##0.00';

  cdsDados.Data := cdsVenda.Data;
  cdsDados.LogChanges := False;

  If (fCfgSis('CNDVEN') = 'I') Then
    fatVenda.pCalculaTaxVpr(IIF(Not fCfgSis('RECCND', varBoolean), fRetConPag(fatVenda.strCodCnd), ''));

  TProQtdColetiva.cdsDadosPromocaoKit := Nil;
  if fCfgSis('PROKIT', varBoolean) then
  Begin
    fatVenda.pCarregarDadosParaPromocaoPorKit;
    if (Assigned(fatVenda.cdsDadosPromocaoKit) and (fatVenda.cdsDadosPromocaoKit.RecordCount > 0))  then
      TProQtdColetiva.cdsDadosPromocaoKit := fatVenda.cdsDadosPromocaoKit;
  End;

  While (Not cdsDados.Eof) Do
  Begin
    blnParticiona := False;
    blnPromo      := False;
    fatVenda.strPromoc := 'N';

    strIdePro := cdsDados.FieldByName('ITE_IDEPRO').AsString;
    strEmpItePro := fatVenda.fGetEmpPrecoPromoItem(fEmpIte, cdsDados.FieldByName('ITE_EMPDMP').AsString);

    If (strIdePro = 'NOR') And
       (IfEmptyStr(cdsDados.FieldByName('ITE_PROMOC').AsString, 'N') = 'N') And
       (Not fatVenda.fItemPassivelDeVerificacaoPromo(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro)) Then
    Begin
      cdsDados.Next;
      Continue;
    End;

    blnItemEspecial := (Pos('ITEM ESPECIAL', cdsDados.FieldByName('ITE_DESORI').AsString) > 0);

    If (strIdePro = 'NOR') Then
    Begin
      If fEmptyStr(cdsDados.FieldByName('ITE_TABPRE').AsString) Then
        strTabela := fatVenda.strTabPre
      Else
        strTabela := cdsDados.FieldByName('ITE_TABPRE').AsString;
    End
    Else
    Begin
      strTabela := fatVenda.fTabelaPrecoTinta(fatVenda.strCodCli, '', cdsDados.FieldByName('ITE_TABPRE').AsString, True, False, False);
    End;

    If (fatVenda.stlItensNaoEhEstrutura.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) And
       (Not fItemEstrutura(cdsDados.FieldByName('ITE_CODITE').AsString)) Then
    Begin
      fatVenda.stlItensNaoEhEstrutura.Add(cdsDados.FieldByName('ITE_CODITE').AsString);
    End;

    If (fatVenda.stlItensNaoTemLote.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) And
       (fatVenda.objCadLot.fItemSemNenhumLote(cdsDados.FieldByName('ITE_CODITE').AsString)) Then
    Begin
      fatVenda.stlItensNaoTemLote.Add(cdsDados.FieldByName('ITE_CODITE').AsString);
    End;

    If (fatVenda.fFilialPromocao) And (fatVenda.fItemPassivelDeVerificacaoPromo(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpItePro)) Then
    Begin
      If (fRetornaPrecosPromocao(cdsDados.FieldByName('ITE_CODITE').AsString,
                                 fatVenda.strCodCli,
                                 VS_Date,
                                 IIF(cdsDados.FieldByName('ITE_QTDITE').AsFloat > 0, cdsDados.FieldByName('ITE_QTDITE').AsFloat, 1),

                                 fatVenda.fRetQtdDigitada(cdsDados.FieldByName('ITE_CODITE').AsString,'',
                                   cdsDados.FieldByName('AUTOINCREM').AsString,'','',strEmpItePro, False),

                                 fatVenda.fRetQtdDigitada(cdsDados.FieldByName('ITE_CODITE').AsString,'',
                                   cdsDados.FieldByName('AUTOINCREM').AsString,'','',strEmpItePro,
                                   False, False, fatVenda.fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,True {Somente em promocao}),

                                 fatVenda.intPrzMed,
                                 fatVenda.fltProPreCus,
                                 fatVenda.fltProPreVen,
                                 fatVenda.fltProComVar,
                                 fatVenda.fltProComAta,
                                 fatVenda.fltProComDis,
                                 fltQtdDis,
                                 fatVenda.fltProDesF07,
                                 fatVenda.strComPro,
                                 fatVenda.strCodPro,
                                 blnParticiona,
                                 blnPromo,
                                 strTabela,
                                 fatVenda.strCodCnd,
                                 '',
                                 '',
                                 True,
                                 False,
                                 '-1',
                                 ((cdsDados.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsDados.FieldByName('ITE_ENTFUT').AsString = 'N')),
                                 ((cdsDados.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsDados.FieldByName('ITE_ENTFUT').AsString = 'S')),
                                 cdsDados.FieldByName('ITE_MOTFUT').AsString,
                                 strEmpItePro,
                                 strNumOrc,
                                 strEspOrc,
                                 Nil,
                                 False,
                                 '',
                                 objPromVlrMinTotalProdutos,
                                 '',
                                 cdsDados.FieldByName('ITE_SOMCOL').AsFloat)) Then
      Begin
        If (Not blnParticiona) Then
          fatVenda.strPromoc := 'S';
      End;
    End;

    If (strIdePro = 'NOR') And
       (fCfgSis('SUGVLE') = '2') And
       (fatVenda.stlItensNaoEhEstrutura.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) Then
    Begin
      blnAplicarTaxaJuros := Not ((fatVenda.strJurPro = 'N') And (cdsDados.FieldByName('ITE_PROMOC').AsString = 'S'));
      fltUniOri := fatVenda.fCalculaPrecoEstrutura( blnAplicarTaxaJuros,
                                                    Preco_de_Venda,
                                                    cdsDados.FieldByName('ITE_CODITE').AsString,
                                                    cdsDados.FieldByName('ITE_EMPITE').AsString,
                                                    cdsDados.FieldByName('ITE_ENTSAI').AsString,
                                                    strTabela,
                                                    fStrToFloat(edtMargem.Text) );

      If blnAplicarTaxaJuros Then
      Begin
        fltUniOri := fltUniOri + fFormataFloat(fltUniOri * (fatVenda.fltTaxVpr / 100.0), 04);
      End;
    End

    Else if (strIdePro = 'NOR') And
            (Not fatVenda.fEhEmissaoDocumentoWMS) And
            (Not fatVenda.fEmpresaParaFaturamentoUsaWMS(edtCodEmp.Text)) And
            (fatVenda.stlItensNaoTemLote.IndexOf(cdsDados.FieldByName('ITE_CODITE').AsString) = -1) And

            (fatVenda.objCadLot.fExisteLote(cdsDados.FieldByName('ITE_CODITE').AsString,
                                            IIF(fatVenda.blnEmpFat,
                                                cdsDados.FieldByName('ITE_EMPITE').AsString,
                                                fatVenda.fEmpresaSaldoMatriz_CD),
                                            cdsDados.FieldByName('ITE_NUMLOT').AsString) And

            fatVenda.fCalculaPrecosLote(cdsDados.FieldByName('ITE_QTDITE').AsFloat, fltUniLot, IIF(cbTabPrecoItem.Visible,fTabelaDePrecoDosItens,''))) Then
    Begin
      fltUniOri := fltUniLot;

      If Not ((fatVenda.strJurPro = 'N') And (cdsDados.FieldByName('ITE_PROMOC').AsString = 'S')) Then
        fltUniOri := fltUniOri + fFormataFloat(fltUniOri * (fatVenda.fltTaxVpr / 100.0), 04);
    End

    Else
    Begin
      fltUniOri := fatVenda.fPegaPrecoVenda(cdsDados,
                                            cdsDados.FieldByName('ITE_EMPITE').AsString,
                                            cdsDados.FieldByName('ITE_ENTSAI').AsString,
                                            fStrToFloat(edtMargem.Text),
                                            blnItemEspecial,
                                            strIdePro,
                                            strTabela,
                                            True,
                                            fltTaxaJuros,
                                            fltUniSemJuros,
                                            (Not fEmptyStr(cdsDados.FieldByName('ITE_BAREMB').AsString)),
                                            fRetornaPrecoCodBarraEmb(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                     cdsDados.FieldByName('ITE_BAREMB').AsString,
                                                                     VS_strCodEmp,
                                                                     strTabela,
                                                                     True),
                                            fRetornaTabPreCodBarraEmb(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                      cdsDados.FieldByName('ITE_BAREMB').AsString));
    End;

    fatVenda.pCalculaValorRT(fltUniOri, fltVal_RT);

    If fCarregarEstruturaVidro(cdsDados.FieldByName('ITE_CODITE').AsString, cdsDados.FieldByName('AUTOINCREM').AsInteger) Then
    Begin
      If fAtualizaPrecosEstruturaVidro(strTabela, cdsDados.FieldByName('ITE_ENTFUT').AsString, cdsDados.FieldByName('ITE_EMPITE').AsString, False) > 0 Then
        fltUniOri := fatVenda.fltUniOri;
    End;

    {Verifica itens de (orçamento/pedido/venda) regitrados em época de promoção,
     mas atualmente a promoção esta expirada!}
    If ((fatVenda.blnCalculouDivergenciaPromo) And (strIdePro <> 'NOR')) Then
    Begin
      blnTemDivergenciasPromo := cdsDados.FieldByName('ITE_DIVPRM').AsString = 'S';
    End
    Else
      blnTemDivergenciasPromo := fTemDivergencia;

    If blnTemDivergenciasPromo Then
    begin
      cdsItens.Append;
      cdsItens.FieldByName('CODITE').AsString := cdsDados.FieldByName('ITE_CODITE').AsString;
      cdsItens.FieldByName('DESCRI').AsString := cdsDados.FieldByName('ITE_DESITE').AsString;
      cdsItens.FieldByName('UNIDAD').AsString := cdsDados.FieldByName('ITE_UNIDAD').AsString;
      cdsItens.FieldByName('QTDITE').AsFloat  := cdsDados.FieldByName('ITE_QTDITE').AsFloat;

      cdsItens.FieldByName('UNIANT').AsFloat  := cdsDados.FieldByName('ITE_UNIORI').AsFloat;
      cdsItens.FieldByName('TOTANT').AsFloat  := cdsDados.FieldByName('ITE_UNIORI').AsFloat *
                                                 cdsDados.FieldByName('ITE_QTDITE').AsFloat;

      cdsItens.FieldByName('UNICOM').AsFloat  := cdsDados.FieldByName('ITE_UNITAR').AsFloat;
      cdsItens.FieldByName('TOTCOM').AsFloat  := cdsDados.FieldByName('ITE_TOTITE').AsFloat;

      cdsItens.FieldByName('UNIATU').AsFloat  := fltUniOri;
      cdsItens.FieldByName('TOTATU').AsFloat  := fltUniOri * cdsDados.FieldByName('ITE_QTDITE').AsFloat;
      cdsItens.Post;
    End;

    cdsDados.Next;

  End;

  If (Not cdsItens.IsEmpty) Then
  Begin
    Try

      {Emite aviso ao usuário demonstrando os itens divergentes}
      pCriarFormularios(TfrmFatMostraDivergenciasPromo, frmFatMostraDivergenciasPromo);
      frmFatMostraDivergenciasPromo.dbgItens.DataSource.DataSet := cdsItens;

      {Informa código do pedido/orçamento}
      frmFatMostraDivergenciasPromo.lblMSG.Caption := StringReplace(frmFatMostraDivergenciasPromo.lblMSG.Caption, '[COD_PED_ORC]', (strNumOrc + '-' + strEspOrc), [rfReplaceAll]);
      frmFatMostraDivergenciasPromo.ShowModal;

      If blnRecalcularItens Then
      Begin
        If not blnPedidoVencido Then
        Begin
          blnPedidoVencido := False;

          {Recalcular itens}
          blnManterPrecoPromoc := fPergunta('O pedido está no prazo de validade, deseja manter os preços promocionais ?');
          pRecalculaPrecos(False, False, False, False, '', False, True, False, blnManterPrecoPromoc);
        end
        else
          pRecalculaPrecos(False, False, False, False, '', False, True);

        blnRecalculouItens := True;
      End;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[pVerificaDivergenciasPromo]');
    End;

    pFreeAndNil(frmFatMostraDivergenciasPromo);

  End;

  FreeAndNil(cdsItens);
  FreeAndNil(cdsDados);

end;

procedure TfrmFatVendas.pVerificarPromocaoBrindes(strNumDoc, strEspDoc: String);
var
  dtaMin, dtaMax: TDateTime;
  blnPedeBrindes,
  blnApenasPromoVigente: Boolean;
  frmFatPromocaoBrindes : TfrmFatPromocaoBrindes;
begin
  blnApenasPromoVigente := (not fCfgSis('PEBRFA', varBoolean));

  If (TPromocaoBrindes.fTemPromocaoDeBrindeEmVigencia) And
     (TFatEmitirBrindePromocao.fClienteTemPontosParaBrindes(
      fatVenda.strCodCli, strNumDoc, strEspDoc, dtaMin, dtaMax, blnApenasPromoVigente)) Then
  Begin
    If fEmptyStr(strNumDoc) Then
