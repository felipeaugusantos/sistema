Procedure TfrmFatVendas.pSetaArrOpcoes(Var arrOpcoes: TOpcoesFaturamentoArray);
  Var
    intIndice: Integer;
Begin
  SetLength(arrOpcoes, 16);

  intIndice := 0;

  If ((Pos(strOpcDoc,'CP_OV_CF_') > 0) And (fatVenda.strConfSer = 'S')) Or
     (fCfgSis('USASER', varBoolean) And (fCfgSis('TIPNFS') = '2') And (strOpcDoc = 'VS')) Then
  Begin
    arrOpcoes[intIndice].strDesCri := 'Nota Serviço';
    arrOpcoes[intIndice].strEspDoc := 'NS';
    arrOpcoes[intIndice].strOpcLet := 'N';
    arrOpcoes[intIndice].strMosMen := 'S';
  End

  Else If (strOpcDoc = 'NC') And blnNFCeComplementar Then
  Begin
    arrOpcoes[intIndice].strDesCri := 'NFCe';
    arrOpcoes[intIndice].strEspDoc := 'IF';
    arrOpcoes[intIndice].strOpcLet := 'N';
    arrOpcoes[intIndice].strMosMen := 'S';
  End

  Else
  Begin
    arrOpcoes[intIndice].strDesCri := 'Nota Fiscal';
    arrOpcoes[intIndice].strEspDoc := 'NF';
    arrOpcoes[intIndice].strOpcLet := 'N';
    arrOpcoes[intIndice].strMosMen := 'S';
  End;

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Orçamento';
  arrOpcoes[intIndice].strEspDoc := 'OR';

  If (Not fPermiteOpcaoDeFechamentoEmOrcamento) Then
  begin
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  end
  else
  begin
    arrOpcoes[intIndice].strOpcLet := 'O';
    arrOpcoes[intIndice].strMosMen := 'S';
  end;

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Pedido';
  arrOpcoes[intIndice].strEspDoc := 'PD';

  If fPermiteSelecionarEspeciePedido Then
  Begin
    arrOpcoes[intIndice].strOpcLet := 'P';
    arrOpcoes[intIndice].strMosMen := 'S';
  End
  Else
  Begin
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;

  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := fDescricaoIF;
  arrOpcoes[intIndice].strEspDoc := 'IF';

  If ((fCfgSis('USACUP', varBoolean)) Or (fCfgSis('USNFCE', varBoolean)) Or fUsaSat ) And (strOpcDoc <> 'CS') And (Not fCfgSis('PAFECF', varBoolean)) Then
  Begin
    arrOpcoes[intIndice].strOpcLet := 'C';
    arrOpcoes[intIndice].strMosMen := 'S';
  End
  Else
  Begin
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Transferência de Estoque';
  arrOpcoes[intIndice].strEspDoc := 'TE';
  If strOpcDoc = 'TE' Then
  Begin
    arrOpcoes[intIndice].strOpcLet := 'T';
    arrOpcoes[intIndice].strMosMen := 'S';
  End
  Else
  Begin
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Nota Especial';
  arrOpcoes[intIndice].strEspDoc := 'NE';
  If (fatVenda.strEntFut <> 'S') And (strOpcDoc <> 'CS') Then
    arrOpcoes[intIndice].strOpcLet := 'E'
  Else
    arrOpcoes[intIndice].strOpcLet := #0;
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Brinde';
  arrOpcoes[intIndice].strEspDoc := 'BR';
  If (strOpcDoc = 'BR') Then
    arrOpcoes[intIndice].strOpcLet := 'B'
  Else
    arrOpcoes[intIndice].strOpcLet := #0;
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Troca';
  arrOpcoes[intIndice].strEspDoc := 'TR';
  arrOpcoes[intIndice].strOpcLet := #0;
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Devolução';
  arrOpcoes[intIndice].strEspDoc := 'DV';
  arrOpcoes[intIndice].strOpcLet := #0;
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Faturamento Futuro';
  arrOpcoes[intIndice].strEspDoc := 'FF';
  If ((fCfgSis('PEMIFF') = '1') And (Not fCfgSis('PERMFF', varBoolean))) Or
      (strOpcDoc = 'CS') Then
    arrOpcoes[intIndice].strOpcLet := #0
  Else
    arrOpcoes[intIndice].strOpcLet := 'F';
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Pigmento';
  arrOpcoes[intIndice].strEspDoc := 'PI';
  If (fatVenda.strEntFut <> 'S') And (strOpcDoc <> 'CS') Then
    arrOpcoes[intIndice].strOpcLet := 'G'
  Else
    arrOpcoes[intIndice].strOpcLet := #0;
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Cupom Fiscal Especial';
  arrOpcoes[intIndice].strEspDoc := 'IF';

  If (fCfgSis('USACUP', varBoolean)) And
     (fatVenda.strEntFut <> 'S')     And
     (strOpcDoc <> 'CS')             And
     (Not fCfgSis('PAFECF', varBoolean)) Then
  Begin
    arrOpcoes[intIndice].strOpcLet := 'I';
    arrOpcoes[intIndice].strMosMen := 'N';
  End
  Else
  Begin
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Empréstimos de Produtos';
  arrOpcoes[intIndice].strEspDoc := 'EP';
  arrOpcoes[intIndice].strOpcLet := #0;
  arrOpcoes[intIndice].strMosMen := 'N';

  Inc(intIndice);
  arrOpcoes[intIndice].strDesCri := 'Uso/Consumo de Materiais';
  arrOpcoes[intIndice].strEspDoc := 'UC';

  If strOpcDoc = 'UC' Then
  Begin
    arrOpcoes[intIndice].strOpcLet := 'U';
    arrOpcoes[intIndice].strMosMen := 'S';
  End
  Else
  Begin
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;

  If strOpcDoc = 'BR' Then
  begin
    For intIndice := Low(arrOpcoes) To High(arrOpcoes) Do
      If Pos(arrOpcoes[intIndice].strEspDoc, 'NF_BR_') <= 0 Then
      Begin
        arrOpcoes[intIndice].strOpcLet := #0;
        arrOpcoes[intIndice].strMosMen := 'N';
      End;
    intIndice := 0;
  end;

  If strOpcDoc = 'UC' Then
  begin
    For intIndice := Low(arrOpcoes) To High(arrOpcoes) Do
      If Pos(arrOpcoes[intIndice].strEspDoc, 'NF_UC_') <= 0 Then
      Begin
        arrOpcoes[intIndice].strOpcLet := #0;
        arrOpcoes[intIndice].strMosMen := 'N';
      End;
    intIndice := 0;
  end;

  If strOpcDoc = 'PR' Then
  Begin
    Inc(intIndice);
    arrOpcoes[intIndice].strDesCri := 'Pedido de Devolução para Retirada';
    arrOpcoes[intIndice].strEspDoc := 'PR';
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;

  If strOpcDoc = 'CS' Then
  Begin
    Inc(intIndice);
    arrOpcoes[intIndice].strDesCri := 'Consignação';
    arrOpcoes[intIndice].strEspDoc := 'CS';
    arrOpcoes[intIndice].strOpcLet := 'S';
    arrOpcoes[intIndice].strMosMen := 'S';
  End;

  If strOpcDoc = 'PA' Then
  Begin
    Inc(intIndice);
    arrOpcoes[intIndice].strDesCri := 'Ordem de Produção Avulsa Produtos Tintométricos';
    arrOpcoes[intIndice].strEspDoc := 'PA';
    arrOpcoes[intIndice].strOpcLet := #0;
    arrOpcoes[intIndice].strMosMen := 'N';
  End;


  {****************************************************}
  {* SE FOR PEDIDO E ELE FOR DO TIPOPE = BONIFICADO,  *}
  {* SÓ PERMITIR FATURAR ELE COMO NF OU BR            *}
  {*************************************************FC*}
  If SameText(fatVenda.strTipOpe, 'B') And (Pos(fatVenda.strOpcDoc, 'VN_CP_') > 0) Then
  Begin
    For intIndice := Low(arrOpcoes) To High(arrOpcoes) Do
      If Pos(arrOpcoes[intIndice].strEspDoc, 'NF_BR_NS_') <= 0 Then
      Begin
        arrOpcoes[intIndice].strOpcLet := #0;
        arrOpcoes[intIndice].strMosMen := 'N';
      End
      Else
      Begin
        If arrOpcoes[intIndice].strEspDoc = 'BR' Then
          arrOpcoes[intIndice].strOpcLet := 'B'
        Else
          arrOpcoes[intIndice].strOpcLet := 'N';
      End;
  End;

  {*****************************************************}
  {* SE FOR UMA VENDA DE CONCRETO SÓ PODE FATURAR ELE  *}
  {* COMO NF (J_A_MASSA_CONCRETO)                      *}
  {*****************************************************}
  If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And
     (fatVenda.fEhVendaItemConcreto) Then
  Begin
    For intIndice := Low(arrOpcoes) To High(arrOpcoes) Do
      If Pos(arrOpcoes[intIndice].strEspDoc, 'NF_NS_' +
            IIF(strOpcDoc = 'OR', 'OR_', '') +
            IIF(strOpcDoc = 'PD', 'PD_', '') ) <= 0 Then
      Begin
        arrOpcoes[intIndice].strOpcLet := #0;
        arrOpcoes[intIndice].strMosMen := 'N';
      End
      Else
        arrOpcoes[intIndice].strOpcLet := IIF(strOpcDoc = 'PD', 'P', IIF(strOpcDoc = 'OR', 'O', 'N'));
  End

  Else

  {*****************************************************}
  {* SE FOR UMA VENDA DE CONCRETO SÓ PODE FATURAR ELE  *}
  {* COMO NF OU NS                                     *}
  {**************************************************FC*}
  If (MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL])) And
     (fatVenda.fEhVendaItemConcreto)  And
     (fatVenda.blnDesmembrarNotaProdutosServicos) Then
  Begin
    For intIndice := Low(arrOpcoes) To High(arrOpcoes) Do
      If Pos(arrOpcoes[intIndice].strEspDoc, 'NF_NS_' +
            IIF(strOpcDoc = 'OR', 'OR_', '') +
            IIF(strOpcDoc = 'PD', 'PD_', '') ) <= 0 Then
      Begin
        arrOpcoes[intIndice].strOpcLet := #0;
        arrOpcoes[intIndice].strMosMen := 'N';
      End
      Else
        arrOpcoes[intIndice].strOpcLet := IIF(strOpcDoc = 'PD', 'P', IIF(strOpcDoc = 'OR', 'O', 'N'));
  End;


  {*****************************************************}
  {* SE ESTIVER ALTERANDO UM PEDIDO PELA VENDA NORMAL, *}
  {* SOMENTE DEIXA SALVAR COMO PEDIDO                  *}
  {**************************************************FC*}
  If blnJaAvisouAltPD Then
  Begin
    SetLength(arrOpcoes, 1);

    intIndice := 0;
    arrOpcoes[intIndice].strDesCri := 'Pedido';
    arrOpcoes[intIndice].strEspDoc := 'PD';
    arrOpcoes[intIndice].strOpcLet := 'P';
    arrOpcoes[intIndice].strMosMen := 'S';
  End;

  If (fTrocouClienteDoPedidoNoVendaNormal) Then
  Begin
    SetLength(arrOpcoes, 0);
    intIndice := -1;
    If (fPermiteSelecionarEspeciePedido) Then
    Begin
      SetLength(arrOpcoes, Length(arrOpcoes) + 1);
      Inc(intIndice);
      arrOpcoes[intIndice].strDesCri := 'Pedido';
      arrOpcoes[intIndice].strEspDoc := 'PD';
      arrOpcoes[intIndice].strOpcLet := 'P';
      arrOpcoes[intIndice].strMosMen := 'S';
    End;
    If (fPermiteOpcaoDeFechamentoEmOrcamento) And (Self.strEspOrc = 'OR') Then
    Begin
      SetLength(arrOpcoes, Length(arrOpcoes) + 1);
      Inc(intIndice);
      arrOpcoes[intIndice].strDesCri := 'Orçamento';
      arrOpcoes[intIndice].strEspDoc := 'OR';
      arrOpcoes[intIndice].strOpcLet := 'O';
      arrOpcoes[intIndice].strMosMen := 'S';
    End;
  End;

  If (fatVenda.fEhConsertoEquipamento) or (Pos(fatVenda.strOpcDoc,'EM_ER_') > 0) Then
  Begin
    SetLength(arrOpcoes, 1);

    intIndice := 0;
    arrOpcoes[intIndice].strDesCri := 'Nota Fiscal';
    arrOpcoes[intIndice].strEspDoc := 'NF';
    arrOpcoes[intIndice].strOpcLet := 'N';
    arrOpcoes[intIndice].strMosMen := 'S';
  End;

  if (strOpcDoc = 'CS') and (fatVenda.fEhEmissaoDocumentoWMS) then
  Begin
    SetLength(arrOpcoes, 1);

    intIndice := 0;
    arrOpcoes[intIndice].strDesCri := 'Pedido';
    arrOpcoes[intIndice].strEspDoc := 'PD';
    arrOpcoes[intIndice].strOpcLet := 'P';
    arrOpcoes[intIndice].strMosMen := 'S';
  End;

  For intIndice := Low(arrOpcoes) To High(arrOpcoes) Do
  Begin
    If (Not fPermiteEmissaoEspecie(arrOpcoes[intIndice].strEspDoc)) Then
    Begin
      arrOpcoes[intIndice].strOpcLet := #0;
      arrOpcoes[intIndice].strMosMen := 'N';
    End;
  End;
End;

function TfrmFatVendas.fPermiteSelecionarEspeciePedido: Boolean;
begin
  Result := (Pos(strOpcDoc, 'VN_CS_') > 0) And
            fCfgSis('SVPDVN', varBoolean) And
            fCfgSis('USAPDV', varBoolean) And
            fVerificaAcessoSistema('frmFatVendas - PD') And
            (Not fatVenda.fOrcamentoOutraLojaORVN);

  If Result And (fPedidoOriundoDesmembramento) And (Not fCfgSis('EDPDDS', varBoolean)) Then
    Result := False;

  If (fatVenda.blnEnt_CD) And //Nao permite alterar pedido com contas a receber quitado
     (Not fEmptyStr(strNumOrc)) And (SameText(strEspOrc, 'PD')) Then
  Begin
    If (TFatVenda.fTotalDuplicataQuitada(strNumOrc,
                                         strEspOrc,
                                         strEmpOrc,
                                         fatVenda.fRetClienteOriginal) > 0) Then
    Begin
      Result := False;
    End;

    If (TAdiantamento.fGetTotaisAdiantamento(strNumOrc,
                                             strEspOrc,
                                             strEmpOrc).fltValLan > 0) Then
    Begin
      Result := False;
    End;
  End;

  If fUsaRotinaWMS(fatVenda.fEmpresaSaldoMatriz_CD) Then
    Result := False;

  {**********************************************}
  {* CASO SISTEMA ESTEJA CONFIGURADO PARA       *}
  {* PERMITIR ITEM ESPECIAL SÓ P/ ORÇAMENTO     *}
  {* NÃO DEVE ABRIR A OPÇÃO DE ESCOLHA DE OR/PD *}
  {*******************************************MM*}
  If (Not fPermiteItemEspecial('PD')) And fTemItemEspecialVenda Then
    Result := False;

  if (strOpcDoc = 'CS') and
     not(fatVenda.fEhEmissaoDocumentoWMS) and
     fCfgSis('PDENCS', varBoolean) then
    Result := True;

end;

function TfrmFatVendas.fVerificaQtdeRomaneio(strNumDoc, strEspDoc, strCodEmp, strCodIte, strAutInc: String): Boolean;
  Var
    qryGen      : TUniQuery;
    fltQtdRom,
    fltQtdExp,
    fltQtdAlt   : Double;
    strTemp     : String;
    blnPedeSenha: Boolean;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha  : TLinhaMsgLibera;
begin
  objTabela := TRegistroMsgLiberaTabela.Create;
  try
    Try
      Result      := True;

      fltQtdRom    := 0.00;
      fltQtdExp    := 0.00;
      strTemp      := EmptyStr;
      qryGen       := fCriaQuery;
      blnPedeSenha := False;

      If Not fEmptyStr(strCodEmp) And Not fEmptyStr(strNumDoc) And Not fEmptyStr(strEspDoc) Then
      Begin

        With qryGen Do
        Begin
          SQL.Clear;
          SQL.Add('SELECT ');
          SQL.Add('  G.GER_NUMROM, ');
          SQL.Add('  G.GER_EMPROM, ');
          SQL.Add('  D.DET_CODITE, ');
          SQL.Add('  D.DET_DESCRI, ');
          SQL.Add('  D.DET_QTDITE, ');
          SQL.Add('  U.UNI_SIGUNI, ');
          SQL.Add('  E.FDO_QTDEXP  ');

          SQL.Add('FROM ');
          SQL.Add('  ROMDETX D ');
          SQL.Add('  INNER JOIN ROMGERX G ON D.DET_NUMDOC = G.GER_NUMDOC ');
          SQL.Add('  INNER JOIN FATDOR  F ON F.FDO_NUMDOC = D.DET_NUMDOC ');
          SQL.Add('                      AND F.FDO_CODEMP = D.DET_CODEMP ');
          SQL.Add('                      AND F.FDO_ESPDOC = D.DET_ESPDOC ');
          SQL.Add('                      AND F.FDO_CODITE = D.DET_CODITE ');
          SQL.Add('                      AND F.FDO_CODCLI = D.DET_CODCLI ');
          SQL.Add('                      AND F.AUTOINCREM = D.DET_AUTINC ');
          SQL.Add('  INNER JOIN EXTDOR  E ON F.AUTOINCREM = E.FDO_SEQFDO ');
          SQL.Add('  LEFT  JOIN CADUNI  U ON U.UNI_CODUNI = D.DET_UNIDAD ');

          SQL.Add('WHERE GER_CODEMP = :CODEMP ');
          SQL.Add('AND   GER_NUMDOC = :NUMDOC ');
          SQL.Add('AND   GER_ESPDOC = :ESPDOC ');
          SQL.Add('AND   GER_STATUS = "P"     ');

          If Not fEmptyStr(strCodIte) Then
            SQL.Add('AND   DET_CODITE = :CODITE ');

          If Not fEmptyStr(strAutInc) Then
            SQL.Add('AND   DET_AUTINC = :AUTINC ');

          SQL.Add('ORDER BY D.DET_DESCRI ');

          ParamByName('CODEMP').AsString := strCodEmp;
          ParamByName('NUMDOC').AsString := strNumDoc;
          ParamByName('ESPDOC').AsString := strEspDoc;

          If Not fEmptyStr(strCodIte) Then
            ParamByName('CODITE').AsString := strCodIte;

          If Not fEmptyStr(strAutInc) Then
            ParamByName('AUTINC').AsString := strAutInc;

          Open;

          If Not IsEmpty Then
          Begin

            If fEmptyStr(strCodIte) Then
            Begin

              First;
              While Not EOF Do
              Begin
                If cdsVenda.Locate('ITE_CODITE', FieldByName('DET_CODITE').AsString, []) Then
                  fltQtdAlt := cdsVenda.FieldByName('ITE_QTDITE').AsFloat
                Else
                  fltQtdAlt := 0.00;

                if objTabela.isEmpty then
                begin
                  objLinha  := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlCabecalho;
                  objLinha.pAddColuna(''  , 'COD'          , 5  , alEsquerda , teAutcom);
                  objLinha.pAddColuna(''  , 'DESCRICAO'    , 35 , alEsquerda , teAutcom);
                  objLinha.pAddColuna(''  , 'UN'           , 2  , alCentro   , teAutcom);
                  objLinha.pAddColuna(''  , 'QTD.ORIGINAL' , 12 , alDireita  , teAutcom);
                  objLinha.pAddColuna(''  , 'QTD.ALTERADA' , 12 , alDireita  , teAutcom);
                  objTabela.lstLinhas.Add(objLinha);
                end;

                objLinha  := TLinhaMsgLibera.Create;
                objLinha.enuTipoLinha := tlValor;
                objLinha.pAddColuna('COD'          , FieldByName('DET_CODITE').AsString                         , fTamCodIte  , alEsquerda , teAutcom);
                objLinha.pAddColuna('DESCRICAO'    , FieldByName('DET_DESCRI').AsString                         , 35 , alEsquerda , teAutcom);
                objLinha.pAddColuna('UN'           , FieldByName('UNI_SIGUNI').AsString                         , 2  , alCentro   , teAutcom);
                objLinha.pAddColuna('QTD.ORIGINAL' , FormatFloat('#,##0.00', FieldByName('DET_QTDITE').AsFloat) , 12 , alDireita  , teAutcom);
                objLinha.pAddColuna('QTD.ALTERADA' , FormatFloat('#,##0.00', fltQtdAlt)                        , 12 , alDireita  , teAutcom);
                objTabela.lstLinhas.Add(objLinha);

                fltQtdExp := fltQtdExp + FieldByName('FDO_QTDEXP').AsFloat;

                If Not blnPedeSenha Then
                  blnPedeSenha := FieldByName('DET_QTDITE').AsFloat > fltQtdAlt;

                Next;
              End;

            End
            Else
            Begin
              fltQtdRom := FieldByName('DET_QTDITE').AsFloat;
              fltQtdExp := FieldByName('FDO_QTDEXP').AsFloat;
            End;

          End;

        End;

      End;

      If (Not fEmptyStr(strCodIte)) And
         (fltQtdRom <> 0) And
         (fltQtdRom < fStrToFloat(edtQtdIte.Text)) Then
      Begin
        fMensagem('ATENÇÃO!','Este pedido está inserido em um Pré-Romaneio!' + #13 +
                             'A quantidade do item ' + edtCodIte.Text + ' não pode ser superior a ' + FormatFloat('#,##0.00',fltQtdRom), ['&O k']);
        Result := False;
      End;

      If (Not fEmptyStr(strCodIte)) And
         (fltQtdExp <> 0) And
         (fltQtdExp > fStrToFloat(edtQtdIte.Text)) Then
      Begin
        fMensagem('ATENÇÃO!','A quantidade do item ' + edtCodIte.Text + ' (' + FormatFloat('#,##0.00',fStrToFloat(edtQtdIte.Text)) + ') não pode '
                             + #13 + ' ser menor que a quantidade expedida (' + FormatFloat('#,##0.00',fltQtdExp) + ') do mesmo!', ['&O k']);
        Result := False;
      End;

      If (Not objTabela.isEmpty) And (fltQtdExp <> 0) And (blnPedeSenha) And (qryGen.Active) Then
      Begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddSeparador(77);
        objLiberacao.objMsgLibera.pAddTexto('Alteração de produto em pedido contido no pré-romaneio.', alCentro, teAmbos, '', 77);
        objLiberacao.objMsgLibera.pAddSeparador(77);
        objLiberacao.objMsgLibera.pAddTextoCaption('Romaneio'       ,   qryGen.FieldByName('GER_NUMROM').AsString + ' - '
                                                                      + qryGen.FieldByName('GER_EMPROM').AsString         , 16);
        objLiberacao.objMsgLibera.pAddTextoCaption('Pedido de Venda',   strNumOrc + ' - ' + strEspOrc                     , 16);
        objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);
        objLiberacao.objMsgLibera.pAddQuebra;
        objLiberacao.objMsgLibera.pAddTexto('* Itens com QTD.ALTERADA = 0,00 são itens deletados');

        objLiberacao.strDirAce := 'ALPRRO';
        objLiberacao.strMsgSen := 'Alteração de produto em pedido contido no pré-romaneio';
        objLiberacao.strCodOpe := fatVenda.strCodVen;
        objLiberacao.strCodDig := fatVenda.strCodDig;
        objLiberacao.strCliente := edtCodCli.Text + '-' + edtNomCli.Text;

        Result := fatVenda.fFatMensagemLiberacao(objLiberacao);


      End;

      FreeAndNil(qryGen);

    Except

      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '');
      End;

    End;
  finally
    if objTabela.isEmpty then
      FreeAndNil(objTabela);
  end;
end;

function TfrmFatVendas.fPDEmPreRomaneio(strNumDoc, strEspDoc, strCodCli, strCodEmp: String): Boolean;
  Var
    qryGen : TUniQuery;
begin

  Result := False;

  If ( fEmptyStr(strNumDoc) And fEmptyStr(strEspDoc) And fEmptyStr(strCodEmp) ) Then
    Exit;

  qryGen := fCriaQuery;

  Try

    With qryGen Do
    Begin
      SQL.Clear;
      SQL.Add('SELECT ');
      SQL.Add('  GER_NUMROM ');
      SQL.Add('FROM ');
      SQL.Add('  ROMGERX D  ');
      SQL.Add('WHERE ');
      SQL.Add('  GER_CODEMP = :CODEMP AND ');
      SQL.Add('  GER_NUMDOC = :NUMDOC AND ');
      SQL.Add('  GER_ESPDOC = :ESPDOC AND ');
      SQL.Add('  GER_CODCLI = :CODCLI AND ');
      SQL.Add('  GER_STATUS = "P"         ');

      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      Result := Not IsEmpty;
    End;

  Finally
    FreeAndNil(qryGen);
  End;

End;

function TfrmFatVendas.fPedeDadosFinanceira(fltTotMod: Double): Boolean;
Begin
  Try
    Result := True;

    {*******************************************************************************************}
    {* SE FOR FORMA DE PAGAMENTO FINANCEIRA E FOR CONFIRMAÇÃO DE NOTA DE CONCRETO DA SECOL E O *}
    {* O VALOR PARA O CONTAS A RECEBER FOR ZERO, NÃO PEDE A TELA DA FINANCEIRA, POIS JÁ FOI    *}
    {* SOLICITADO ANTERIORMENTE NO PEDIDO DE VENDA.                                            *}
    {****************************************************************************************PZ*}
    If (Pos(strOpcDoc, 'TE_NC_BR_MF_CO_UC_') <= 0) And
       (((fatVenda.strCodFpg = '016') And (Not((fCfgSis('TPNFCR') = SECOL) And SameText(strOpcDoc, 'CN') And (fatVenda.fltTotCadRec = 0)))) Or
        ((fatVenda.strCodFpg = '009') And (fatVenda.fltValFin > 0))) Then
    Begin
      If (fatVenda.strCodFpg = '016') Then
      Begin

        If Pos(strOpcDoc, 'CP_OV_') <= 0 Then
        Begin
          If (fatVenda.strOpcDoc = 'OR') And (fatVenda.strEspDoc = 'OR') Then
            fMensagem('Informação','Esse "Orçamento" está sendo emitido com a forma de pagamento "016-Financiamento".'+#10#13+
                                   'Antes de faturá-lo, será necessário sua confirmação em "Pedido"!',['&OK']);

          SetLength(arrCartoes, 0);

          Result := fatVenda.fPedeDadosFinanceira(0);

          If Result And (Pos(fatVenda.strEspDoc, 'PD_OR_') <= 0) Then
            fatVenda.objFinanc.pSalvaCartoes(arrCartoes);

        End;

      End;

    End Else
    Begin
      fatVenda.objFinanc.pLimpaDados;
    End;

  Except

    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[TfrmFatVendas.fPedeDadosFinanceira]');
    End;

  End;

End;

function TfrmFatVendas.fPedeDadosTratamentoInconsistenciaEFD: Boolean;
begin
  Result := True;
  Try
    FillChar(fatVenda.recInconsistenciaEFD, SizeOf(fatVenda.recInconsistenciaEFD), #0);

    If (strOpcDoc = 'NE') And (Not blnNEFornecedor) Then
    Begin
      If Not fEmptyStr(fCfgSis('CLAINE')) Then
        fatVenda.pPedeDadosTratamentoInconsistenciaEFD;
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[TfrmFatVendas.fPedeDadosTratamentoInconsistenciaEFD]');
    End;
  End;
end;

Function TfrmFatVendas.fDigCartoes(fltTotMod: Double; strCodCar: String = '';
  strCodFin: String = ''; const AintQuantidadeParcelas: Integer = 0): Boolean;
Begin {fDigCartoes}
  Result := True;

  if fExibeTelaDigitacaoCartoes(fltTotMod) then
  Begin
    Result := fatVenda.fDigCartoes(arrCartoes, fltTotMod, strCodCar, strCodFin,
                                   AintQuantidadeParcelas);

    fatVenda.blnRealizandoAdiantamentoPedidoPeloVN := (Pos(fatVenda.strEspDoc, 'PD_') > 0) And Result;
  End

  Else If fatVenda.strCodFpg = '007' Then
    fatVenda.fltValCar := fltTotMod;

End; {fDigCartoes}

function TfrmFatVendas.fExibirServicoParaAutocenter: Boolean;
begin
  If fatVenda.fEhAutocenter And pnlPlacaVeiculo.Visible Then
  Begin
    With fatVenda, cdsVenda Do
      Result := (Not fEmptyStr(strPlavei)) Or
                (Not fEmptyStr(strCodS01));
  End
  Else
    Result := True;
end;

function TfrmFatVendas.fEmpresasEnvolvidasNaVendaUsamReplicacao: Boolean;
var
  cdsEmpIte: TUniClientDataSet;
begin
  Result := False;

  //Verifica se a empresa logada usa replicação
  if fEmpresaUsaReplicacao(VS_strCodEmp) then
    Exit(True);

  cdsEmpIte := TUniClientDataSet.Create(Nil);

  try
    pCloneDataSet(cdsEmpIte, cdsVenda);
    cdsEmpIte.DisableControls;
    cdsEmpIte.First;

    //Verifica se as empresas dos itens utilizam replicação.
    while not cdsEmpIte.Eof do
    begin
      if not fEmptyStr(cdsEmpIte.FieldByName('ITE_EMPITE').AsString) then
        Result := fEmpresaUsaReplicacao(cdsEmpIte.FieldByName('ITE_EMPITE').AsString);

      if Result then
        Exit;

      cdsEmpIte.Next;
    end;
  finally
    FreeAndNil(cdsEmpIte);
  end;
end;

function TfrmFatVendas.fClientePossuiCashback(
  const blnExibeMensagem: Boolean): Boolean;
var
  strNumDocLocal,
  strEspDocLocal,
  strMensagem    : String;
begin
  If (Not fatVenda.objControleCashback.fPermiteUtilizarRotinaCashback) Then
    Exit(True);

  If (fClienteConsumidor(fRetNomCliente(edtCodCli.Text), True, True)) And
     (fCfgSis('EXDACO') = 'N') And
     (fCfgSis('CLCCSH') <> '3') Then
    Exit(True);

  fatVenda.objControleCashback.pLimparObjeto;

  strNumDocLocal := fatVenda.strNumOrc;
  strEspDocLocal := fatVenda.strEspOrc;

  If (strEspDocLocal = 'OR') And (fatVenda.strEspDoc = 'PD') Then
  Begin
    strNumDocLocal := EmptyStr;
    strEspDocLocal := fatVenda.strEspDoc;
  End
  Else If fEmptyStr(fatVenda.strNumOrc) Then
  Begin
    strNumDocLocal := fatVenda.strNumDoc;
    strEspDocLocal := fatVenda.strEspDoc;
  End;

  If fEmptyStr(strEspDocLocal) Then
    strEspDocLocal := fatVenda.strOpcDoc;

  fatVenda.objControleCashback.strNumDoc := strNumDocLocal;
  fatVenda.objControleCashback.strEspDoc := strEspDocLocal;
  fatVenda.objControleCashback.strCodEmp := VS_strCodEmp;
  fatVenda.objControleCashback.strCodCli := edtCodCli.Text;
  fatVenda.objControleCashback.strCodVen := fatVenda.strCodVen;
  fatVenda.objControleCashback.strOrigem := 'V';
  fatVenda.objControleCashback.strFonCli := IIF(Not fEmptyStr(fatVenda.strCliTel), fatVenda.strCliTel, fatVenda.strCliCel);
  fatVenda.objControleCashback.strCpfCli := fatVenda.strCliCgc;

  Result := fatVenda.objControleCashback.fPossuiSaldoCashbackCliente(
                                            VS_Date,
                                            strMensagem);

  If (Result) And
     (blnExibeMensagem) Then
    fMensagem('Informação', strMensagem,['&OK']);
end;

function TfrmFatVendas.fExisteFrete: Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Result := True;

  If Not fTabelaExiste(fatVenda.strTabelaConfMi) Then
    Exit;

  qryGen := fCriaQuery;

  With qryGen Do
  Begin
    Close;
    SQL.Clear;

    SQL.Add('SELECT                      ');
    SQL.Add('  SUM(TMP_TOTFRE) AS TOTFRE ');
    SQL.Add('FROM                        ');
    SQL.Add(   fatVenda.strTabelaConfMi   );

    Open;

    Result :=  FieldByName('TOTFRE').AsFloat > 0;

  End;

  FreeAndNil(qryGen);
End;

