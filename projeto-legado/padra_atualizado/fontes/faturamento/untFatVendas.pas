      fMenuAlteraEmpresaItem(strEmpSel, False, pgbStatus, fatVenda.blnPraticarPrecosEmpresaFaturamento);
    end;

    pVerificaComboVigenteGeral(pgbStatus);
  End;
end;

function TfrmFatVendas.fAtualizaEmpresaItemsTE(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    prcScroll    : Tprcscroll;
    strEmpPrdAnt : String;
begin
  Result := True;

  If (Not fEmptyStr(fatVenda.strEmp_TE)) Then
  Begin
    pDisableControls(cdsVenda, prcScroll);
    Try
      cdsVenda.First;
      While Not cdsVenda.Eof Do
      Begin
        If fEmptyStr(cdsVenda.FieldByName('ITE_EMPSOL').AsString) Then
        Begin
          strEmpPrdAnt := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_EMPITE').AsString := fatVenda.strEmp_TE;
          If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPPRD').AsString) Then
            cdsVenda.FieldByName('ITE_EMPPRD').AsString := fatVenda.strEmp_TE;
          cdsVenda.Post;

          pRecalculaTintaMaquinaSelecionadoCasoNecessario(strEmpPrdAnt);
        End;

        cdsVenda.Next;
      End;
    Finally
      pEnableControls(cdsVenda, prcScroll);
      cdsVenda.First;
    End;
  End;
end;

