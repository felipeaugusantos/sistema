procedure TfrmFatVendas.mnuSimularVendaClick(Sender: TObject);
Var
  frmFatMostraItens: TfrmFatMostraItensFechamento;
begin
  inherited;

  If Not fVerificaAcessoSistema('VIPRIM') Then
  Begin
    fMensagem('', 'Operador não tem direito de acesso em Visualizar Produtos / Impostos!', ['&O k']);
    Exit;
  End;

  If Not mnuSimularVenda.Visible Then
    Exit;

  If Not fVerificaCamposInterna Then
    Exit;

  fatVenda.pSetBackupVar(['fltValFre', 'fltDesAce', 'fltDesEsp',
                          'fltPorDes', 'strTipPed', 'strTipOpe']);

  Try
    pPreencheMatrizFechamento;

    If fatVenda.fltDesEsp = 0 then
      fatVenda.fltDesEsp := fatVenda.fltDesespInfVen;

    fatVenda.fltPorDes := 0.00;
    fatVenda.strTipPed := 'A';
    fatVenda.strTipOpe := 'V';

    If fatVenda.fOrgaoPublicoOuZonaFranca() Then
      fatVenda.pCalculaTotGer();

    pCriarFormularios(TfrmFatMostraItensFechamento, frmFatMostraItens);

    Try
      frmFatMostraItens.strTipoFaturamento := fatVenda.strTipPed;
      frmFatMostraItens.fatVenda := fatVenda;
      frmFatMostraItens.ShowModal;
    Finally
      pFreeAndNil(frmFatMostraItens);
    End;

  Finally
    fatVenda.pGetBackupVar(['fltValFre', 'fltDesAce', 'fltDesEsp',
                            'fltPorDes', 'strTipPed', 'strTipOpe']);
  End;

end;

