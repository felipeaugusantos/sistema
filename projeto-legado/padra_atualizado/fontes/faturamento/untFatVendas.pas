  If (fCfgSis('USADIG', varBoolean)) Then
  Begin

    edtSenVen.PasswordChar := #0;
    edtSenVen.MaxLength    := 3;
    edtSenVen.TamCampo     := 3;
    edtSenVen.CompZeros    := True;

  End
  Else
  Begin
    lblDigita.Enabled := False;
    edtSenDig.Enabled := False;
    edtNomDig.Enabled := False;

    lblDigita.Visible := False;
    edtSenDig.Visible := False;
    edtNomDig.Visible := False;

    pnlDigitador.Visible := False;

    If blnPrimVez Then
      pnlCabecalho.Height := pnlCabecalho.Height - pnlDigitador.Height;

