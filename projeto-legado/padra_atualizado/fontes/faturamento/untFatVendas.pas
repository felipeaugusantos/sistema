function TfrmFatVendas.fGravarDocumentoVenda(): Boolean;
Var
  intContador: Integer;
begin
  Try
    {*******************************************}
    {* CASO FOR CONFIRMAÇÃO DE CUPOM FISCAL EM *}
    {* NOTA, A NOTA DEVE CONTER APENAS A CLAS- *}
    {* SIFICAÇÃO DA CONFIGURAÇÃO               *}
    {****************************************MV*}
    If (strOpcDoc = 'CI') Then
    Begin
      fatVenda.strClaFi2 := '';
      fatVenda.strClaFi3 := '';
    End;

    {*****************************************}
    {* RATEIA VALORES: FRETE, DESCONTO ESPE- *}
    {* CIAL, DESPESA ACESSÓRIA               *}
    {**************************************MV*}
    If (Pos(fatVenda.strEspDoc, 'DV_PR_DD_') <= 0) Then
    Begin
      fatVenda.pRateiaValores;
      fatVenda.pAjustarDescontoEspecialDevolucaoFornecedorConformeNotasOriginais;
    End;

    If (Pos(fatVenda.strEspDoc, 'PR_') > 0) And (fCfgSis('ZVFPDR', varBoolean)) Then
      fatVenda.pRateiaValores;

    If (Pos(fatVenda.strEspDoc, 'PD_OR_') > 0) And fatVenda.fExisteDiferencaNoValorDoFrete Then
    Begin
      Result := False;
      pMensagemOk('O valor do frete nos itens não corresponde ao que foi informado, tente novamente!');
      Exit;
    End;

    If (Pos(strOpcDoc, 'TE_OF_') > 0) And (Not fEmptyStr(strNumRemessa)) Then
    Begin
      fatVenda.strNumRemessaDevolucao := strNumRemessa;
    End;

    {*****************************************}
    {* REALIZA GRAVAÇÕES                     *}
    {**************************************MV*}
    Screen.Cursor := crHourGlass;

    fatVenda.opcComSemPreco := impComPrecoGeral;
    fatVenda.blnValTot := True;
    fatVenda.strCodVe2 := edtCodRep.Text;
    fatVenda.strEntreg := edtEntrega.Text;

    fatVenda.arrCartoes   := arrCartoes;
    fatVenda.arrDuplicFat := arrDuplicFat;
    fatVenda.arrDuplicCop := arrDuplicCop;

    If (Assigned(fatVenda)) And (fatVenda.blnGravouDocumentos) Then
    Begin
      pMensagemOK('Os documentos desta venda já foram gravados. '+
        'Favor entrar em contato com a Citel imediatamente!');
      Result := False;
      Exit;
    End;

    {**********************************************************************}
    { DEIXAR ESSE TRECHO SEMPRE POR ÚLTIMO E ANTES DAS FUNÇÕES DE GRAVAÇÃO }
    { POIS A FUNÇÃO fAgruparItensMesmasCaracteristicasPedido MODIFICA EM   }
    { DEFINITIVO O arrMatItens                                             }
    {*****************************************************REQ.:284162***VA*}
    If Not fAgruparItensMesmasCaracteristicasNaEmissaoPedido() Then
      Exit(False);

    If (Pos(fatVenda.strEspDoc, 'NF_EL_') > 0) And (Not fatVenda.fEhEmissaoNfe) And (fCfgSis('TIPFOR') = 'A') Then
    Begin
      Result := fGravaNotasFormAvulso;
    End
    Else
    Begin
      fatVenda.objFatVendaImp.pLimparDocumentos;

      If objEstruturaPersonalizada.blnEstruturaFoiPersonalizada Then
        fatVenda.pSetObjEsttruturaPersonalizada(objEstruturaPersonalizada);

      Try
        pCriarFormularios(TfrmGravando,frmGravandoConfirmaVenda);
        try
          frmGravandoConfirmaVenda.strChave := 'FATVENDAS';

          if fTravaPedidoComPixPago then
          begin
            fMensagem('Atenção','Esse pedido contém recebimento via PIX!' + #13 + 'Seu valor contábil deve permanecer o mesmo!', ['&OK']);
            Result := False;
            Exit;
          end ;

          If fatVenda.blnFinali Then
          Begin
            fatVenda.dtaPreAnt := IIF(fUsaPrevisaoDeEntregaNoFinal(strOpcDoc), fatVenda.dtaPreVis, StrToDateDef(mskPreVis.Text, 0));
            frmGravandoConfirmaVenda.fExecutarAcao := fatVenda.fDesmembraPDORMultiLoja
          End
          Else If fEhFaturamentoDeConcreto Then
          Begin
            frmGravandoConfirmaVenda.fExecutarAcao := fatVenda.fGravaNotaDeConcreto;
          End
          Else
            frmGravandoConfirmaVenda.fExecutarAcao := fatVenda.fGravaArquivosDesmembrandoVenda;

          If (Pos(strOpcDoc, 'OU_OF_') > 0) Then
          begin
            while (strTodosNumSer <> '') and (strTodosCodIte <> '') do
            begin
              Delete(strTodosNumSer,1,1);
              Delete(strTodosCodIte,1,1);

              FVariaveisFechamentoVenda.strNumSerExp  := Copy(strTodosNumSer,1,Pos(',',strTodosNumSer)-1);
              Delete(strTodosNumSer,1,Pos(',',strTodosNumSer)-1);

              if FVariaveisFechamentoVenda.strNumSerExp = '' then
              begin
                FVariaveisFechamentoVenda.strNumSerExp  := Copy(strTodosNumSer,1,Length(strTodosNumSer));
                Delete(strTodosNumSer,1,Length(strTodosNumSer));
              end;

              FVariaveisFechamentoVenda.strCodIteExp := Copy(strTodosCodIte,1,Pos(',',strTodosCodIte)-1);
              Delete(strTodosCodIte,1,Pos(',',strTodosCodIte)-1);

              if FVariaveisFechamentoVenda.strCodIteExp = '' then
              begin
                FVariaveisFechamentoVenda.strCodIteExp := Copy(strTodosCodIte,1,Length(strTodosCodIte));
                Delete(strTodosCodIte,1,Length(strTodosCodIte));
              end;

              pUtilizaNumeroSerie(strOpcDoc, FVariaveisFechamentoVenda.strNumSerExp, FVariaveisFechamentoVenda.strCodIteExp);
            end;
          end;

          frmGravandoConfirmaVenda.ShowModal;
          Result := frmGravandoConfirmaVenda.blnConfirma;
        finally
          pFreeAndNil(frmGravandoConfirmaVenda);
        end;
      Except
        On E: Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message,'[fConfirmaVenda - frmGravando]');
        End;
      End;
    End;

    Screen.Cursor := crDefault;

    If (Result) And (strOpcDoc = 'VN') And
       ((fCfgSis('USNFCE', varBoolean)) Or fUsaSat) And
       (fCfgSis('CUPEET', VarBoolean)) Then
    Begin
      For intContador := 0 To fatVenda.objFatVendaImp.ItemsCount -1 Do
        With fatVenda.objFatVendaImp[intContador] Do
          If ((strEspDoc = 'IF') Or ((strEspDoc = 'FF') And (Pos(strEspDoc, fCfgSis('ESP40C')) > 0))) And fPergunta('Imprimir endereço de entrega ' +
                                              '(' + IIF(fUsaSat, 'SAT ', IIF(strEspDoc='IF', 'NFCe: ', 'FF: ')) + strNumDoc + '-' + strEspDoc + ') ?') Then
          Begin
            pImprimirDadosEntregaNFCe(fatVenda.objFatVendaImp[intContador]);
          End;
    End;

    fatVenda.pDestravaELimpaStlDocDevLck('','','','','',True);

    blnConfirmouOperacao := TRUE;

    blnTravaFaturamentoF11 := (fatVenda.blnEnt_CD) OR (fatVenda.blnMulLoj) OR (fatvenda.blnFinali);

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fConfirmaVenda]');
    End;
  End;
end;

function TfrmFatVendas.fVerificaQtdEstoque(fltQuantidade: Double): Boolean;
  var
    blnPedSen, blnSemEst, blnComSen: Boolean;
    blnMosMsg: Boolean;
Begin
  blnComSen := Not ((fatVenda.blnEmpFat) And (fatVenda.strOpcDoc = 'VN'));
  blnMosMsg := (Not Assigned(objImpulsionadorVendasCRM)) Or (Assigned(objImpulsionadorVendasCRM) And (objImpulsionadorVendasCRM.blnInserirItemManualmente));

  If (fatVenda.fValidarEstoqueNoFinal) Then
    blnComSen := False;

  Result := fVerificaQtdEstoque(fltQuantidade, IIF(fatVenda.fEmpCarPreenchidaEmpDif(strEmpCar, VS_strCodEmp), fltSaldoItemEmpCar, fltSaldoItemAtu),
                                blnPedSen, blnSemEst, blnComSen, blnMosMsg, edtNumLot.Text);
end;

function TfrmFatVendas.fVerificaQtdEstoque(fltQuantidade, fltSaldoItem: Double; Var blnPedSen, blnSemEst: Boolean;
  blnComSenha, blnMosMsg: Boolean; strNumLote: String; blnVerAlterando: Boolean = True): Boolean;
Var
  intAutInc: Integer;
  fltQtdDig: Double;
  strCodEmpQtdDig: String;

  function fEhProdutoNormal : Boolean;
  begin

    Result := True;

    If (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> '') Then
      Result := cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR';

  end;

Begin
  intAutInc := 0;

  If blnVerAlterando Then
    intAutInc := btnAdicionar.Tag;

  {Req: 126003 - Já foi solicitado transferência, não precisa validar estoque}
  If (blnVerAlterando) And cdsVenda.Locate('AUTOINCREM', intAutInc, []) And (Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPSOL').AsString)) Then
  Begin
    Result    := true;
    strSemEst := 'N';
    Exit;
  End;

  if ((fEntregaFuturaItem = 'S') And (fTravaSaldoEntFutColorante = 'N') And (Not fEhProdutoNormal))Then
  Begin
    Result    := true;
    strSemEst := 'N';
    Exit;
  end;

  If (Pos(strOpcDoc, 'TE_OF_') > 0) And (Not fEmptyStr(strNumRemessa)) Then
  Begin
    Result    := true;
    strSemEst := 'N';
    Exit;
  End;

  strCodEmpQtdDig := edtCodEmp.Text;
  If (intAutInc > 0) Then
    If (Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString)) And (edtCodEmp.Text <> cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
      strCodEmpQtdDig := cdsVenda.FieldByName('ITE_EMPITE').AsString;

  If (intAutInc > 0) And
     (fEntregaFuturaItem <> cdsVenda.FieldByName('ITE_ENTFUT').AsString) Then
  Begin
    fltQtdDig := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
  End
  Else
  If (intAutInc > 0) And (cmbTipEnt.ItemIndex = IDX_ENTREGA_FUTURA) And
     (cmbMotEntFut.ItemIndex = IDX_MOTIVO_FALTA_PRODUTO) And (cdsVenda.FieldByName('ITE_MOTFUT').AsString <> 'F') Then
  Begin
    fltQtdDig := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
  End
  Else
    fltQtdDig := fatVenda.fRetQtdDigitada(fCodItem, IIF(intAutInc > 0, strNumLotAntAlterar, strNumLote), '', strCodAca, strEmpAca, strCodEmpQtdDig);

  Result := fTravaSubProduto(fCodItem);

  if not Result then
  begin
    Result := fatVenda.fVerificaQtdEstoque(edtCodEmp.Text,
                                           strOpcDoc,
                                           cmbEntSai.Text[1],
                                           strNumOrc,
                                           IIF(fAlterandoProduto, intToStr(btnAdicionar.Tag), ''),
                                           fCodItem,
                                           strCodAca,
                                           strEmpAca,
                                           qryConCit.FieldByName('ITE_DESITE').AsString,
                                           fDestinoEntRetItem, //ENTREGA/RETIRA
                                           fEntregaFuturaItem, //TIPO DE ENTREGA: 0 - FUTURA  1 - IMEDIATA
                                           fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex),
                                           fltQuantidade,
                                           fltQtdDig,
                                           fltQtdIteAnt,
                                           fltSaldoItem,
                                           intAutInc > 0,
                                           strSemEst,
                                           blnComSenha,
                                           blnPedSen,
                                           blnSemEst,
                                           recForTin,
                                           False,
                                           strNumLote,
                                           blnMosMsg,
                                           edtDesIte.text,
                                           IIF(fatVenda.fEmpCarPreenchidaEmpDif(strEmpCar, VS_strCodEmp), strEmpCar, ''));
  end
  else
  begin
    Result := fVerificaQtdEstoqueSubProduto(strSemEst, fltQuantidade, fltSaldoItem, fltQtdDig, fCodItem);
  end;

  If blnComSenha And (strSemEst = 'S') And blnPedSen And Result Then
  Begin
    strLibEstComSenha := 'S';//Liberou sem estoque mediante senha
  End;
End;

function TfrmFatVendas.fVerificaQtdEstoqueSubProduto(var strSemEst: string;
  fltQuantidade, fltSaldo, fltQtdDig: Double; strCodIte: string): Boolean;
var
  qryEstrutura: TUniQuery;
  strEmpSalRes,
  strSQL: string;
  fltSalDisEstrutura,
  fltSalResEstrutura,
  fltQtdFaltante,
  fltSaldoDis,
  fltSaldoItemAtu,
  fltSaldoResItemAtu,
  fltTotal: Double;
  intIndice: integer;
  arrItemSubProdutoTrava: Array of TRecItemSubProdutoTrava;
  objTabela : TRegistroMsgLiberaTabela;
  objLinha :  TLinhaMsgLibera;
begin
  Result := True;
  strSemEst := EmptyStr;

  {*************************************************************}
  {* OPCOES EM NAO SE DEVE VERIFICAR A TRAVA DE ESTOQUE        *}
  {**********************************************************JC*}
  If (fEntregaFuturaItem = 'S') And (fMotivoEntFutToSigla(cmbMotEntFut.ItemIndex) = 'F') And (fCfgSis('ENTFUT', varBoolean)) Then
  Begin
    If (fatVenda.strIdePro <> 'NOR') Or (fCfgSis(fCfgTravaSaldoEntFut(strOpcDoc, 'F')) = 'N') Then
    Begin
        Exit;
    End;
  End;

  {*************************************************************}
  {* OPCOES EM NAO SE DEVE VERIFICAR A TRAVA DE ESTOQUE        *}
  {**********************************************************JC*}
  If (Pos(strOpcDoc, 'OE_EF_NE_CE_') > 0) Or
     ((strOpcDoc = 'EP') And (fatVenda.strTipEmp = 'E')) Or
     ((fatVenda.strIdePro = 'NOR') And (Pos('ITEM ESPECIAL', fRetNomProduto(strCodIte)) > 0)) Or
     (fEhItemVendaVidro(strCodIte)) Or
     (cmbEntSai.Text[1] = 'E') Or
     (fltQuantidade <= 0.0) Then
  Begin
    Exit;
  End;

  SetLength(arrItemSubProdutoTrava, 0);

  strEmpSalRes := IIF(fatVenda.blnEmpFat, edtCodEmp.Text, fatVenda.fEmpresaSaldoMatriz_CD);

  fltSalResEstrutura := TSaldoReservado.New(
                          TReservaParametros.New()
                            .EmpresaItem(IIF(fatVenda.blnEmpFat, strEmpSalRes, ''))
                            .NumeroDocumento(fatVenda.strNumOrc)
                            .CodigoItem(strCodIte)
                            .CodEmpresa(strEmpSalRes)
                            .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                            .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                            .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                            .NumeroLote(fRetNumLoteSeAdequado(strEmpSalRes, '', strCodIte))
                            .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                         ).fGetQuantidade();

  fltSalDisEstrutura := fltSaldo - fltSalResEstrutura - fltQtdDig;

  if fltSalDisEstrutura > 0 then
  begin
    fltQtdFaltante := fltQuantidade - fltSalDisEstrutura;
  end
  else
  begin
    fltQtdFaltante := fltQuantidade;
  end;


  if fltQtdFaltante <= 0 then
    Exit;

  qryEstrutura := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + 'SELECT SQL_NO_CACHE           ';
  strSQL := strSQL + '  *                           ';
  strSQL := strSQL + 'FROM                          ';
  strSQL := strSQL + '  DETMAT                      ';
  strSQL := strSQL + 'INNER JOIN GERMAT G ON        ';
  strSQL := strSQL + '  DMT_SEQGER = G.AUTOINCREM   ';
  strSQL := strSQL + 'INNER JOIN ITEGER ON          ';
  strSQL := strSQL + '  DMT_ITESUB = ITE_CODITE AND ';
  strSQL := strSQL + '  ITE_CODEMP = :CODEMP        ';
  strSQL := strSQL + 'WHERE                         ';
  strSQL := strSQL + '  GMT_CODITE = :CODITE        ';

  try
    qryEstrutura.Close;
    qryEstrutura.SQL.Clear;
    qryEstrutura.SQL.Add(strSQL);
    qryEstrutura.ParamByName('CODITE').AsString := strCodIte;
    qryEstrutura.ParamByName('CODEMP').AsString := strEmpSalRes;
    qryEstrutura.Open;

    if qryEstrutura.IsEmpty then
      Exit;

    while not qryEstrutura.Eof do
    begin
      fltTotal := fltQtdFaltante * qryEstrutura.FieldByName('DMT_QTDITE').AsFloat;



      fltSaldoItemAtu := fRetSaldosEmpresa(qryEstrutura.FieldByName('DMT_ITESUB').AsString,
                                           strEmpSalRes);

      If fUsaQtdPendenteEntregaFutura(True, strEmpSalRes) Then
        fltSaldoItemAtu := fltSaldoItemAtu + TEntregaFutura.New(
                                               TParamEF.New()
                                                 .CodIte(qryEstrutura.FieldByName('DMT_ITESUB').AsString)
                                                 .CodEmp(strEmpSalRes)
                                                 .Lote(fRetNumLoteSeAdequado(strEmpSalRes, '', qryEstrutura.FieldByName('DMT_ITESUB').AsString))
                                                 .Faturamento(True)
                                               ).Total();

      If blnProAca Then
        fltSaldoItemAtu := TProdAcabado.fRetornaSaldo(strCodAca,strEmpAca,strEmpSalRes);

      pCalculaSaldoPigmento();

      fltSaldoResItemAtu := TSaldoReservado.New(
                              TReservaParametros.New()
                                .EmpresaItem(IIF(fatVenda.blnEmpFat, strEmpSalRes, ''))
                                .NumeroDocumento(fatVenda.strNumOrc)
                                .CodigoItem(qryEstrutura.FieldByName('DMT_ITESUB').AsString)
                                .CodEmpresa(strEmpSalRes)
                                .TipoFiltroDocumento(IIF(Not fEmptyStr(fatVenda.strNumOrc), tfdIgnorarDocumento, tfdTodos))
                                .CodItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strCodAca, ''))
                                .EmpItemAcabado(IIF((fatVenda.strIdePro = 'NOR') And (Not fEmptyStr(strCodAca)), strEmpAca, ''))
                                .NumeroLote(fRetNumLoteSeAdequado(strEmpSalRes, '', qryEstrutura.FieldByName('DMT_ITESUB').AsString))
                                .DesconsideraPedidosCorte(Not fatVenda.blnPedCorte)
                             ).fGetQuantidade();

      fltSaldoDis := fltSaldoItemAtu - fltSaldoResItemAtu;

      if fltTotal > fltSaldoDis then
      begin
        SetLength(arrItemSubProdutoTrava, Length(arrItemSubProdutoTrava) + 1);
        arrItemSubProdutoTrava[Length(arrItemSubProdutoTrava) - 1].strCodIte := qryEstrutura.FieldByName('DMT_ITESUB').AsString;
        arrItemSubProdutoTrava[Length(arrItemSubProdutoTrava) - 1].strDesIte := fRetNomProduto(qryEstrutura.FieldByName('DMT_ITESUB').AsString);
        arrItemSubProdutoTrava[Length(arrItemSubProdutoTrava) - 1].fltValNec := fltTotal;
        arrItemSubProdutoTrava[Length(arrItemSubProdutoTrava) - 1].fltValAtu := fltSaldoDis;

        Result := False;
      end;

      qryEstrutura.Next;
    end;

    if not Result then
    begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Item de subproduto não possui saldo suficiente.');
      objLiberacao.objMsgLibera.pAddSeparador(90);
      objLiberacao.objMsgLibera.pAddTexto('Item estrutura: ' +edtCodIte.Text + ' - ' + fRetNomProduto(edtCodIte.Text));

      objTabela := TRegistroMsgLiberaTabela.Create;

      objLinha := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlCabecalho;
      objLinha.pAddColuna('', 'Item'           , 5 , alEsquerda, teAutcom);
      objLinha.pAddColuna('', 'Descrição'      , 50, alEsquerda, teAutcom);
      objLinha.pAddColuna('', 'Qtd Atual'      , 10, alDireita , teAutcom);
      objLinha.pAddColuna('', 'Qtd Necessária' , 14, alDireita , teAutcom);
      objTabela.lstLinhas.Add(objLinha);

      for intIndice := 0 to Length(arrItemSubProdutoTrava) - 1 do
      begin
        objLinha := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.pAddColuna('Item'          , arrItemSubProdutoTrava[intIndice].strCodIte                                                          , 5            );
        objLinha.pAddColuna('Descrição'     , arrItemSubProdutoTrava[intIndice].strDesIte                                                          , 50           );
        objLinha.pAddColuna('Qtd Atual'     , FloatToStrF(arrItemSubProdutoTrava[intIndice].fltValAtu, ffFixed, 12, fCfgSis('DECQTD', varInteger)) , 10, alDireita);
        objLinha.pAddColuna('Qtd Necessária', FloatToStrF(arrItemSubProdutoTrava[intIndice].fltValNec, ffFixed, 12, fCfgSis('DECQTD', varInteger)) , 14, alDireita);

        objTabela.lstLinhas.Add(objLinha);
      end;

      objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

      objLiberacao.strDirAce := 'LBSDVN';
      objLiberacao.strMsgSen := 'Liberação de subproduto sem saldo.';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strSequencialUnicoDtaHra := fatVenda.FSequencialUnicoDtaHrLogVar;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + fatVenda.strCliNom;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      Result := objLiberacao.fLibera;

      if Result then
        strSemEst := 'S';
    end;

  finally
    FreeAndNil(qryEstrutura);
  end;
end;

function TfrmFatVendas.fTratarValorFreteNaEmissaoDeCupomNFCe: Boolean;
