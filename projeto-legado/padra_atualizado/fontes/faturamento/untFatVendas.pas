procedure TfrmFatVendas.pAgruparDuplicatasDeNotaAvulsa(fatVenda: TFatVenda; arrNumDoc: Array Of String);
  Var
    strCondicaoAgrupamento: String;
    intContador: Integer;
    frmAgrupDuplicatas: TfrmAgrupDuplicatas;

//    documento: TDadosImpressaoVenda;

    Function fMesmoCliente(arr: Array Of TDocAgrupamento): Boolean;
      Var
        intCont  : Integer;
        strCodCli: String;
    Begin
      Result := True;

      If Length(arr) > 0 Then
        strCodCli := arr[0].strCodCli;

      For intCont := Low(arr) To High(arr) Do
      Begin
        If strCodCli <> arr[intCont].strCodCli Then
        Begin
          Result := False;
          Break;
        End;
      End;
    End;
begin
  If (fStatusCndPag(fatVenda.strConPag) = A_VISTA) And (fatVenda.blnHouveBaixaAVista) Then
  Begin
    Exit;
  End;

  If Length(arrNumDoc) <= 1 Then
    Exit;

  If fCfgSis('AGNTAV', varBoolean) Then
  Begin
    If fMensagem('', 'Deseja agrupar as duplicatas?', ['&Sim', '&Não']) = 2 Then
      Exit;
  End
  Else
    Exit;

  strCondicaoAgrupamento := fCondicaoAgrupamento(fatVenda.strConPag,
    fatVenda.blnHouveBaixaAVista);

  pCriarFormularios(TfrmAgrupDuplicatas, frmAgrupDuplicatas);
  frmAgrupDuplicatas.strCondicaoNotaAvulsa := strCondicaoAgrupamento;

  SetLength(frmAgrupDuplicatas.arrDocsAgrupar, Length(arrNumDoc));
  For intContador := Low(arrNumDoc) To High(arrNumDoc) Do
  Begin
    frmAgrupDuplicatas.arrDocsAgrupar[intContador].strNumDoc := arrNumDoc[intContador];
    frmAgrupDuplicatas.arrDocsAgrupar[intContador].strEspDoc := 'NF';
    frmAgrupDuplicatas.arrDocsAgrupar[intContador].strCodEmp := VS_strCodEmp;
    frmAgrupDuplicatas.arrDocsAgrupar[intContador].strCodCli := fatVenda.strCodCli;
  End;

  frmAgrupDuplicatas.strPortadorNotaAvulsa := fatVenda.strCodPor;
  frmAgrupDuplicatas.blnFatVen := True;

  frmAgrupDuplicatas.ShowModal;

  pFreeAndNil(frmAgrupDuplicatas);
end;

function TfrmFatVendas.fCondicaoAgrupamento(strConPag: String;
  blnHouveBaixaAVista: Boolean): String;
  Var
    intQtdPar: Integer;
begin
  Result := strConPag;
  intQtdPar := StrToInt(LeftStr(strConPag, 2));

  If (intQtdPar > 1) Then
  Begin
    If (Copy(strConPag, 3, 3) = '000') And (blnHouveBaixaAVista) Then
    Begin
      Result := fStrZero(intQtdPar-1, 2) + Copy(strConPag, 6, Length(strConPag));
    End;
  End;
end;

