procedure TfrmFatVendas.pCalculaImpostosNaConsultaTab;
  Var
    cdsTemp: TUniClientDataSet;
    recMadeira: TDadosMadeira;
    pOnProcessaItem: TOnProcessaItem;
    strUltCompra: String;
    fltUnitarioLiquido: Double;
    strEntRet: String;
    blnCalcularImpostos : Boolean;
    blnCalcularComissao : Boolean;
begin

  Try
    tmrAtualizarImpostosNaConsultaTab.Enabled := False;

    If Not Assigned(frmFatVendaItem) Then
      Exit;

    If Not frmFatVendaItem.pnlImpostos.Visible Then
      Exit;

    If InterlockedIncrement(intCalculandoImpostos) > 0 Then
      Exit;

    If qryConCit.FindField('ITE_CODITE') = NIL Then
      Exit;

    If fEmptyStr(edtCodIte.Text) Then
      Exit;

    fltUnitarioLiquido := fRetornaValorUnitarioLiquidoTab(fatVenda, 
                                                          qryConCit.FieldByName('ITE_CODITE').AsString, 
                                                          fStrToFloat(edtUnitar.Text), 
                                                          fStrToFloat(edtDesCon.Text));

    If SameValue(Self.fltUltimoUniLiqModoTab, fltUnitarioLiquido) And
       SameValue(Self.fltUltimaQtdIteModoTab, fStrToFloat(edtQtdIte.Text)) Then
      Exit;

    If frmFatVendaItem.pnlUltimaCompra.Visible Then
      frmFatVendaItem.llbULtCompra.Caption := strUltCompra;

    If fItemEstrutura(qryConCit.FieldByName('ITE_CODITE').AsString) then
    begin
      frmFatVendaItem.pnlInfo.Font.Color := clRed;
      frmFatVendaItem.pnlInfo.Font.Style := [fsBold];
      frmFatVendaItem.pnlInfo.Caption := '..:: ITEM ESTRUTURA ::..';
    end;

    cdsTemp := fCriaTemporaria(Self);
    With cdsTemp Do
    Begin
      If fEmptyStr(cmbEntRet.Text) Then
        strEntRet :=  ''
      Else
        strEntRet := cmbEntRet.Text[1];

      fatVenda.blnApenasCalculoTotGerDosItens := True;
      fatVenda.pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                    qryConIte.FieldByName('ITE_CODEMP').AsString,
                                    IIF(cbTabPrecoItem.Visible, fTabelaDePrecoDosItens, fatVenda.fDefineTabelaPrecoItem(fatVenda.strIdePro, strCodAca)));

      blnCalcularComissao := False;
      blnCalcularImpostos := True;

      fatVenda.pAdicionaRegistroTemporaria(cdsTemp,
                                          nil,
                                          fatVenda.strIdePro,
                                          qryConCit.FieldByName('ITE_CODGRU').AsString,
                                          qryConCit.FieldByName('ITE_CODITE').AsString,
                                          strDesOri,
                                          edtDesIte.Text,
                                          qryConCit.FieldByName('ITE_DESFAB').AsString,
                                          qryConCit.FieldByName('ITE_CODUNI').AsString, // Unidade Original!!!
                                          edtUnidad.Text,
                                          qryConCit.FieldByName('ITE_CODMAR').AsString,
                                          qryConCit.FieldByName('ITE_CODFOR').AsString,
                                          strRefere,
                                          fatVenda.fltUniOri,
                                          fatVenda.fltUniVis,
                                          fltUnitarioLiquido,
                                          0.0,
                                          fStrToFloat(edtDesCon.Text),
                                          fStrToFloat(edtQtdIte.Text),
                                          fStrToFloat(edtTotIte.Text),
