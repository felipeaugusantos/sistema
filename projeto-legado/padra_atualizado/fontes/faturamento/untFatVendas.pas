function TfrmFatVendas.fPermiteFaturamentoNoDiaDaSemana(): Boolean;
Var
  i: Integer;
begin
  Result := True;

  If ((fatVenda.strOpcDoc = 'VN') And
      (Not ('OR_PD_'.Contains(fatVenda.strEspDoc)))) Or
     (fatVenda.strOpcDoc = 'CP') Then
  Begin
    If (Not fPermiteFaturamento(fatVenda.strCodCli, FVariaveisFechamentoVenda.strMsgDiasPermitidos)) Then
    Begin
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Cliente não permite faturamento no dia/semana.');
      objLiberacao.objMsgLibera.pAddTexto('Verifique em > Cadastro de Clientes > ABA "Datas de Controle" (CFG_UTDTFE).');

      If (Not fEmptyStr(FVariaveisFechamentoVenda.strMsgDiasPermitidos)) Then
      Begin
        objLiberacao.objMsgLibera.pAddQuebra;

        FVariaveisFechamentoVenda.stlMsgDiasPermitidos := TStringList.Create;
        try
          FVariaveisFechamentoVenda.stlMsgDiasPermitidos.Text := FVariaveisFechamentoVenda.strMsgDiasPermitidos;

          for i := 0 to FVariaveisFechamentoVenda.stlMsgDiasPermitidos.count - 1 do
            objLiberacao.objMsgLibera.pAddTexto(FVariaveisFechamentoVenda.stlMsgDiasPermitidos[i]);

        finally
          FreeAndNil(FVariaveisFechamentoVenda.stlMsgDiasPermitidos);
        end;

      End;

      objLiberacao.strDirAce := 'UTDTFA';
      objLiberacao.strMsgSen := 'Cliente não permite faturamento no dia/semana.';
      objLiberacao.strCodOpe := fatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + edtNomCli.Text;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      If (Not fatVenda.fFatMensagemLiberacao(objLiberacao)) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
  End;

end;

