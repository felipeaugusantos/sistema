function TfrmFatVendas.fVerificaValorMinimoAposInformarCondicaoPagamentoNoFinalDaVenda(var blnVerificou: Boolean): Boolean;
  Var
    fltTotGerLiq: Double;
    pgbStatus: TcxProgressBar;
    LResultVerificaVrMinimo: Boolean;
begin
  Result := True;
  fltTotGerLiq := 0;
  blnVerificou := False;

  {*******************************************************************************}
  {* QUANDO UTILIZAR CADASTRO DE COND.PAGTO E TRAVA DE PRECO POR DESC. MAXIMO    *}
  {* E A DIGITACAO DA COND. DE PAGAMENTO ESTEJA NO FINAL E NAO SEJA CONFIRMACAO  *}
  {* E A CONDICAO INFORMADA FOR DIFERENTE DA ANTERIOR, ENTAO:                    *}
  {* VERIFICA O VALOR MINIMO PARA VENDA (AGORA COM O DESCONTO MAXIMO DA CONDICAO)*}
  {** *************************************************************************JC*}
  If fVerificaVlrMinCndPgtoNoFinalDaVenda Then
  Begin
    If (fatVenda.fltTotPro > 0) Then
      fltTotGerLiq := fatVenda.fltTotPro - fatVenda.fltDesEsp + IIF(fatVenda.blnUtilizouCashback, fatVenda.fltDesCsh, 0);

    pgbStatus := nil;

    If Assigned(frmFechamentoVenda) Then
      pgbStatus := frmFechamentoVenda.pgbStatus;

    fExecutarModal(procedure
      begin
        LResultVerificaVrMinimo := fatVenda.fVerificaVrMinimo(fltTotGerLiq, fltTotGerLiq, fatVenda.intPrzMed,
          '', True, True, pgbStatus, NotificarFechamentoVendaObservers);
      end, 'Aguarde, Verificando valor mínimo produtos ...', '');

    Result := LResultVerificaVrMinimo;

    If Result Then
      Result := fatVenda.fVerificaIntervaloMargemValorCndPagto(fatVenda.strCodCnd);

    If Result Then
      If (fatVenda.strOpcDoc = 'CF') Then
        fatVenda.fltDesEspRef := fatVenda.fCalculaDescontoConfirmacao(FVariaveisFechamentoVenda.fltDesMinConf);

    blnVerificou := Result;
  End;
end;

function TfrmFatVendas.fVerificaVlrMinCndPgtoNoFinalDaVenda: Boolean;
begin
  Result := False;

  If Assigned(fatVenda) And (Assigned(FVariaveisFechamentoVenda)) Then
  Begin
    Result := (fCfgSis('USACND', varBoolean))  And
              ((VS_strTRVEPR = '2') Or (fUsaTravaIteAIteComOrcPedCarregado) Or (fatVenda.strOpcDoc = 'CF')) And
              (Pos(fatVenda.strOpcDoc, 'OU_OV_OF_DV_DD_') <= 0) And
              (IIF(fatVenda.strOpcDoc = 'CF', (fFormataFloat(fatVenda.fltDesEsp+fatVenda.fltDesEspDifeF4, 4) > fFormataFloat(FVariaveisFechamentoVenda.fltDesMinConf, 4)), True));
  End
  Else If Assigned(fatVenda) Then
    Result := (fCfgSis('USACND', varBoolean))  And
              ((VS_strTRVEPR = '2') Or (fUsaTravaIteAIteComOrcPedCarregado) Or (strOpcDoc = 'CF')) And
              (Pos(fatVenda.strOpcDoc, 'OU_OV_OF_DV_DD_') <= 0) ;
end;

