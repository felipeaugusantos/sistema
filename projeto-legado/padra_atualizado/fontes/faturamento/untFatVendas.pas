function TfrmFatVendas.fTravaCondicaoPagamento(strConPag, strEspecie, strOpcaoDoc: String): Boolean;
begin

  Result := True;

  {**********************************************}
  {* TRAVA PARA DIGITAÇÃO DE CS SEMPRE A VISTA! *}
  {*******************************************MM*}
  If (fatVenda.strOpcDoc = 'CS') And (fStatusCndPag(strConPag) = A_PRAZO) Then
  Begin
    fMensagem('', 'Consignação deve ser A Vista!', ['&O k']);
    Result := False;
  End

  {*************************************************}
  {* NÃO PERMITE VENDA A PRAZO PARA CLI-CONSUMIDOR *}
  {**********************************************AF*}
  Else If (Result)                                 And
          (Not fatVenda.fDocumentoParaFornecedor)  And
          (fClienteConsumidor(fatVenda.strCliOri)) And
          (fStatusCndPag(strConPag) = A_PRAZO)     And
          (Not fCfgSis('PRZCON', varBoolean)) Then
  Begin
    fMensagem('','A condição de pagamento não pode ser a prazo para cliente consumidor!',['&OK']);
    Result := False;
  End;

end;

