class function TDiarioToolsCitelDevCnpj.fDiarioToolsConsultaCnpj(const ACnpj: String): TDiarioToolsCitelDevCnpj;
var
  Certificado: TCertificado;
  qryCadCer: TUniQuery;

  LStream: TMemoryStream;
  LBase64Encoding: TBase64Encoding;
begin
  Certificado := TCertificado.Create;
  try
    qryCadCer := fCriaQuery;
    try
      qryCadCer.Close;
      qryCadCer.SQL.Text :=
      ' SELECT '+
      '   CER_ARQPFX, '+
      '   CER_SENHA_, '+
      '   EMP_C_G_C_ '+
      ' FROM '+
      '   CADCER '+
      ' INNER JOIN CADEMP '+
      '   ON CER_CODEMP = EMP_CODEMP '+
      ' WHERE '+
      '   CER_CODEMP = :CODEMP ';

      qryCadCer.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryCadCer.Open;

      if not qryCadCer.IsEmpty then
      begin
        LStream := TMemoryStream.Create;
        try
          TBlobField(qryCadCer.FieldByName('CER_ARQPFX')).SaveToStream(LStream);

          LStream.Position := 0;

          LBase64Encoding := TBase64Encoding.Create(0);
          try
            Certificado.certificado :=
              LBase64Encoding.EncodeBytesToString(
                LStream.Memory,
                LStream.Size
              );
          finally
            FreeAndNil(LBase64Encoding);
          end;
        finally
          FreeAndNil(LStream);
        end;

        Certificado.senha := fDecriptar(qryCadCer.FieldByName('CER_SENHA_').AsString);
        Certificado.cnpj := qryCadCer.FieldByName('EMP_C_G_C_').AsString;
      end;

      Result := TDiarioToolsCitelDevCnpj.fConsultaCnpj(ACnpj, Certificado);
    finally
      FreeAndNil(qryCadCer);
    end;
  finally
    FreeAndNil(Certificado);
  end;
end;

class function TDiarioToolsCitelDevCnpj.fConsultaCnpj(const ACnpj: String; Certificado: TCertificado): TDiarioToolsCitelDevCnpj;
var
  ControllerRest: TControllerRest;
  RestRequest: TRestRequest;

  JSONRetorno: String;
begin
  Result := nil;

  ControllerRest := TControllerRest.Create('DIARIO_TOOLS', TConfigurarDiarioTools.fConfigurarDiarioTools, nil, True);
  RestRequest := TRestRequest.Create(ControllerRest.RestClient);
  try
    RestRequest.Resource := ACnpj;
    RestRequest.Method := rmGET;

    RestRequest.Params.AddItem('X-API-Key', fCampoTabela('SIS_VALCFG', 'CFGSIS',  ['SIS_CODCFG', 'SIS_CODEMP'], ['CFG_KEYDTO', VS_strCodEmp]), pkHTTPHEADER);

    RestRequest
      .Params
        .AddItem('',
                 Certificado.ToJsonString,
                 TRestRequestParameterKind.pkREQUESTBODY,
                 [],
                 TRESTContentType.ctAPPLICATION_JSON
             );

    if ControllerRest.fExecute(RestRequest, JSONRetorno, ['200'], EmptyStr) then
      Result := TDiarioToolsCitelDevCnpj.FromJsonString(JSONRetorno);
  finally
    RestRequest.Free;
    ControllerRest.Free;
  end;
end;

