Function TFatVendaBase.fGetDecUni: Integer;
begin
 Result := fCfgSis('DECUNI', varInteger);

 If (strOpcDoc = 'CS') then
   Result := 2

 Else If Self.strNotImp = 'S' Then
   Result := Self.intDecImp

 Else If Self.FFulfillment.EhOperacaoFulfillment Then
   Result := Max(Result, 6)

 Else If (Self.blnBaiEntFut And (Not Self.blnExpedi)) Or
         (Pos(Self.strOpcDoc,'DV_NE_OF_') > 0) Or
         (Pos(Self.strOpcDocTrue,'FE_') > 0) Or
         ((Pos(Self.strOpcDoc,'GF_') > 0) And ((enuTipoEnvioFornecedorGarantia = tefDevolucao) Or (enuTipoEnvioFornecedorGarantia = tefConserto))) Or
         (opcItensNFespTinta <> opcVazio) Or
         (fCarregaValorBrutoParaAplicarDescontoProfissional) Then
 Begin
   Result := Max(Result, 4);
 End;

end;

