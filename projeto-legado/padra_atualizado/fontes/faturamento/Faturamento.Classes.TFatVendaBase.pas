function TFatVendaBase.fIcmsDiferido(const item: TDadosFechamento) : Double;
  Var
    fltIcmsBruto : Double;
    fltIcmsOp : Double;
    fltIcms : Double;
begin
  fltIcmsBruto := item.fltBasIcm * item.fltAlqIcm / 100;
  fltIcmsOp := fFormataFloat(fltIcmsBruto, 2);
  If (fFormataFloat(item.fltPerDif, 2) = 0) Then
  Begin
    Result := 0;
    Exit;
  End;
  If (fFormataFloat(item.fltPerDif, 2) = 100) Then
  Begin
    Result := fltIcmsOp;
    Exit;
  End;
  fltIcms := fFormataFloat(fltIcmsBruto * (1 - item.fltPerDif/100), 2);
  Result := fltIcmsOp - fltIcms;
end;

procedure TFatVendaBase.pCalculaDifalDevolucaoMatriz(Var item: TDadosFechamento);
  Var
    LItem : TDadosFechamento;
begin
  If (fCfgSis('ICMCDV', varString) = 'N') Then
    Exit;
  item.fltDifalDev := 0;
  LItem := item;
  pCalculaGravaICMSUFDestino('', '', LItem);
  If (LItem.blnGravaMovIcd) Then
    item.fltDifalDev := LItem.fltIcmsDifalDestino;
end;

function TFatVendaBase.fDifalItem(const item: TDadosFechamento) : Double;
begin
