procedure TFatVendaBase.pInsereTodosItensNoCdsLogItensSep(strStaLog: String = 'I');
  Var
    fltQtdAnt: Double;
    intRecNo : Integer;
    prcScroll: TprcScroll;
Begin
  intRecNo:= 0;

  cdsLogItensSep.EmptyDataSet;
  Try
    pDisableControls(cdsVenda, prcScroll);
    intRecNo := cdsVenda.RecNo;

    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      fltQtdAnt := 0;

      If strStaLog = 'A' Then
        fltQtdAnt := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;

      pInsereRegistroLogItensSep(cdsVenda, strStaLog, fltQtdAnt, True);
      cdsVenda.Next;
    End;

  Finally
    cdsVenda.RecNo := intRecNo;
    pEnableControls(cdsVenda, prcScroll);
  End;

End;

procedure TFatVendaBase.pCriacdsLogItensSep;
begin
  If Assigned(cdsLogItensSep) Then
    cdsLogItensSep.EmptyDataSet
  Else
    cdsLogItensSep := fCriaTemporaria(Self);
end;

procedure TFatVendaBase.pInsereRegistroLogItensSep(cdsItens: TUniClientDataSet; strStaLog: String; fltQtdAnt: Double; const blnPermiteAddLogItensSep : Boolean);

  procedure pAtualizaInfLog;
  begin
    cdsLogItensSep.Edit;
    cdsLogItensSep.FieldByName('ITE_STALOG').AsString := strStaLog;
    cdsLogItensSep.FieldByName('ITE_QTDANT').AsFloat  := fltQtdAnt;
    cdsLogItensSep.Post;
  end;

begin

  If Not Assigned(cdsLogItensSep) Then
    Exit;

  If (strStaLog = 'I') And (Not blnPermiteAddLogItensSep) Then
    Exit;

  {***********************************************************}
  {* CASO FOR INCLUSAO INSERE O PRODUTO NO LOG DE ALTERACOES *}
  {********************************************************JC*}
  If strStaLog = 'I' Then
  Begin
    pCopiaRegistroDataSet(cdsItens, cdsLogItensSep);
    pAtualizaInfLog;
  End

  {**********************}
  {* CASO FOR EXCLUSAO  *}
  {*******************JC*}
  Else If (strStaLog = 'E') Then
  Begin
    {***************************************************************************}
    {* CASO O REGISTRO NAO ESTIVER NO LOG DE ALTERACOES, SIGNIFICA QUE O MESMO *}
    {* NAO FOI ALTERADO, MAS DEVE SER GRAVADO NO LOG COMO EXCLUIDO             *}
    {************************************************************************JC*}
    If Not cdsLogItensSep.Locate('ITE_SEQINC', cdsItens.FieldByName('ITE_SEQINC').AsInteger, []) Then
    Begin
      pCopiaRegistroDataSet(cdsItens, cdsLogItensSep);
      pAtualizaInfLog;
    End

    {***************************************************************************}
    {* CASO O REGISTRO ESTIVER NO LOG DE ALTERACOES E SEU STATUS FOR ALTERADO  *}
    {* ENTAO ATUALIZA INFORMACOES DO MESMO                                     *}
    {************************************************************************JC*}
    Else If cdsLogItensSep.FieldByName('ITE_STALOG').AsString = 'A' Then
    Begin
      fltQtdAnt := cdsLogItensSep.FieldByName('ITE_QTDANT').AsFloat;//MANTEM A QUANTIDADE ANTERIOR
      pCopiaRegistroDataSet(cdsItens, cdsLogItensSep, True);
      pAtualizaInfLog;
    End
    Else
      cdsLogItensSep.Delete;
  End

  {**********************}
  {* CASO FOR ALTERACAO *}
  {*******************JC*}
  Else If strStaLog = 'A' Then
  Begin
    {***************************************************************************}
    {* CASO O REGISTRO NAO ESTIVER NO LOG DE ALTERACOES, SIGNIFICA QUE O MESMO *}
    {* NAO FOI UMA NOVA INCLUSAO, PORTANTO DEVE SER GRAVADO COMO ALTERADO      *}
    {************************************************************************JC*}
    If Not cdsLogItensSep.Locate('ITE_SEQINC', cdsItens.FieldByName('ITE_SEQINC').AsInteger, []) Then
    Begin
      pCopiaRegistroDataSet(cdsItens, cdsLogItensSep);
      pAtualizaInfLog;
    End

    {**************************************************************************}
    {* CASO O REGISTRO ESTIVER NO LOG DE ALTERACOES E SEU STATUS FOR INCLUSO  *}
    {* ENTAO ATUALIZA INFORMACOES DO MESMO E O MANTEM COMO INCLUSO            *}
    {***********************************************************************JC*}
    Else If cdsLogItensSep.FieldByName('ITE_STALOG').AsString = 'I' Then
    Begin
      pCopiaRegistroDataSet(cdsItens, cdsLogItensSep, True);
      strStaLog := 'I';//MANTEM STATUS COMO INCLUSAO
      pAtualizaInfLog;
    End

    {**************************************************************************}
    {* CASO O REGISTRO ESTIVER NO LOG DE ALTERACOES E SEU STATUS FOR ALTERADO *}
    {* ENTAO ATUALIZA INFORMACOES DO MESMO E O MANTEM COMO ALTERADO           *}
    {***********************************************************************JC*}
    Else
    Begin
      fltQtdAnt := cdsLogItensSep.FieldByName('ITE_QTDANT').AsFloat;//MANTEM A QUANTIDADE ANTERIOR
      pCopiaRegistroDataSet(cdsItens, cdsLogItensSep, True);
      pAtualizaInfLog;
    End;
  end;

end;

