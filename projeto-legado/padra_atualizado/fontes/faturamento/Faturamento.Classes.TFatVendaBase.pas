function TFatVendaBase.fCarregaValorBrutoParaAplicarDescontoProfissional(ADescontoPorItemNoCheckout : Boolean = False): Boolean;

  var
    LAplicaDescontoNoCheckout : Boolean;

  function fEhCheckoutNoCaixa : Boolean;
  begin

    Result := False;

    If (Not Self.strOriF11.Equals('S')) Then
      Exit;

    If (Not Self.blnOriF3) Then
      Exit;

    Result := True;

  end;

begin

  If fEhCheckoutNoCaixa Then
  Begin

    LAplicaDescontoNoCheckout := IIF(ADescontoPorItemNoCheckout, fCfgSis('DPDIDE') = '1', fCfgSis('DPDIDE') = '2');

    Result := (fCfgSis('CLIDES') = 'S'  ) And // Usa desconto do profissional
              (fCfgSis('DCVBVL') = 'B'  ) And // carregar preco bruto
              (LAplicaDescontoNoCheckout) And // aplicar desconto no checkout (Especial ou Item)
              (Self.fltDescProfissional > 0); // Cliente possui desconto do Profissional
  End
  Else
  Begin
    Result := (fCfgSis('CLIDES') = 'S'  ) And // Usa desconto do profissional
              (fCfgSis('DCVBVL') = 'B'  ) And // carregar preco bruto
              (fCfgSis('DPDIDE') = '2'  ) And // aplicar desconto da tela de desconto especial
              (fCfgSis('DESCCF') = 'S'  ) And // Carrega o valor bruto para aplicar desconto ddo profissional (Confirmacao de documentos)
              (fCfgSis('DESCFF') = 'S'  ) And // Permitir desconto especial na Conf. Documentos
              (Self.strOpcDoc    = 'CF' ) And // Confirmacao de documentos
              (Self.fltDescProfissional > 0); // Cliente possui desconto do Profissional
  End;

end;

function TFatVendaBase.fGetMesmoEndereco: String;
  var
    strEndC: String;
    strEndE: String;
begin
  strEndC := Self.strCliEnd;
  strEndE := Self.strEndEnt;

  //Remove Numero
  strEndC := AnsiReplaceStr(strEndC, Self.FCliNum, '');
  strEndE := AnsiReplaceStr(strEndE, Self.FCliNum, '');

  //Remove Complemento
  strEndC := AnsiReplaceStr(strEndC, Self.FCliCom, '');
  strEndE := AnsiReplaceStr(strEndE, Self.FCliCom, '');

  //Remove caracteres especiais, espacos etc...
  strEndC := fTiraCaracEspeciais(strEndC, True, True, True);
  strEndE := fTiraCaracEspeciais(strEndE, True, True, True);

  //Compara os enderecos
  Result := IIF(SameText(strEndC, strEndE), 'S', 'N');
end;

