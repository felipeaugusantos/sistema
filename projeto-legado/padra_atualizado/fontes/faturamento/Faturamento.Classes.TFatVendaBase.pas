function TFatVendaBase.fRetornaPrecoVendaComDescontoRessarcimentoCAT(strCodIte, strEmpIte, strCodAbf, strTabPre: String; fltPreVen: Double): Double;
  Var
    fltCustoOriginal: Double;
    fltCustoDeduzido: Double;
    fltPercDescontoTabela: Double;
    dtaUltDataCompra: TDateTime;
    strUltDocumento: String;
    fltUltPrecoCompra: Double;
    strUltFornecedor: String;
begin
  Result := fltPreVen;

  If (fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)) <> 'C') Then
    Exit;

  If fCfgSis('C17MOD', varString, GetEmpCfg(strEmpIte)) = '3' Then
    Exit;

  fGetInformacoesUltimaCompra(strCodIte, dtaUltDataCompra, strUltDocumento, fltUltPrecoCompra, strUltFornecedor);

  fltCustoOriginal := 100;//Valor ficticio apenas para testar se houve deducao CAT
  fltCustoDeduzido := fRetornaPrecoCustoDeduzindoRessarcimentoCAT(strCodIte, strEmpIte, strCodAbf, '', fltCustoOriginal, strUltDocumento);

  If fFormataFloat(fltCustoOriginal, 2) = fFormataFloat(fltCustoDeduzido, 2) Then
    Exit;

  fltPercDescontoTabela := fGetPercentualDescontoCAT(strCodAbf, fTrocaUFEndEntrega, strTabPre);

  If fltPercDescontoTabela <= 0 Then
    Exit;

  Result := fFormataFloat(Result * (1 - fltPercDescontoTabela / 100), VS_intDecUni);
end;

function TFatVendaBase.fRetornaPrecoCustoDeduzindoRessarcimentoCAT(strCodIte, strEmpIte, strCodAbf,
  strCodFor: String; fltCusIte: Double; var strNotC17: String): Double;
  Var
    qryConsul: TUniQuery;
    fltComLiq: Double;
    strCodSit: String;
    strEstFor: String;

    fltAlqIcm: Double;
    fltAlqRet: Double;
    fltValIva: Double;
    fltPerBas: Double;
    fltPeBaST: Double;
    fltCreIcm: Double;
    fltCre_ST: Double;

    dtaUltDataCompra: TDateTime;
    strUltDocumento: String;
    fltUltPrecoCompra: Double;
    strUltFornecedor: String;

    fltPercentualRessarcimento: Double;
    blnPossuiUltimaCompra: Boolean;

    function fCalculaICMS(strCodIte: String): Boolean;
    var
      strTipAbf: String;
      strCodFis: String;
      fltAlqIcm: Double;
      fltPerBas: Double;
    Begin
      fltAlqIcm := 0;
      fltPerBas := 0;
      If fBuscaAbfIcm(strCodIte,
                      strEmpIte,
                      fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte)),
                      IIF(fEmptyStr(strEstEnt),
                                    strCliEst,
                                    strEstEnt)) Then
      Begin
        strTipAbf := GetTipAbf(strEmpIte, OpcItensNFespTinta);
        strCodFis := cdsAbfIcm.FieldByName('ABF_CODSIT' + strTipAbf).AsString;
        fltAlqIcm := cdsAbfIcm.FieldByName('ABF_ALQICM' + strTipAbf).AsFloat;
        fltPerBas := cdsAbfIcm.FieldByName('ABF_BASICM' + strTipAbf).AsFloat;
      End;

      If ((TFunctionFuncoesFaturamento.OptantePorSimplesNacional(GetEmpCfg(strEmpIte)) <> 'S') And (fltPerBas > 0) And (fltAlqIcm > 0) And (Pos(RightStr(strCodFis, 2), '00,10,20') > 0)) Then
        Result := true
      Else
        Result := false;
    End;

    function fEhProdutoDeImportacaoDiretaComDeducaoDeCustoNoValorPrincipal: Boolean;
    Begin
      Result := False;

      If not (fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)) = 'M') Then
        Exit;

      If not (fRetImportacaoDiretaItem(strCodIte, GetEmpCfg(strEmpIte)) = 'S') Then
        Exit;

      Result := True;
    End;

begin
  Result := fltCusIte;

  FAuditoriaCat17.Limpar;

  If Self.fDentroDoEstado(strEmpIte) Then
    Exit;

  If fEhProdutoDeImportacaoDiretaComDeducaoDeCustoNoValorPrincipal Then
    Exit;

  //RITEC
  If fCfgSis('C17MOD', varInteger, GetEmpCfg(strEmpIte)) = 3 Then
  Begin
    fltComLiq := fCalculaPrecoCompraLiquido(strCodIte, fGetEmpCalculoItem(strEmpIte), cdsIteGer);

    strEstFor := fEstadoFornecedor(strCodFor);

    pRetDadosAbfFornecedor(strCodAbf, strCodFor, strEstFor, fltAlqIcm,
      fltAlqRet, fltValIva, fltPerBas, fltPeBaST, strCodSit);

    If (Not CST_SUBSTITUICAO.Contains(strCodSit)) Then
      Exit;

    fltCreIcm := fFormataFloat(fltComLiq * (fltAlqRet / 100), 2);

    fltCre_ST := fFormataFloat((fltComLiq * fltValIva) * (fltAlqRet / 100), 2) -
                 fFormataFloat( fltComLiq * (fltAlqRet / 100), 2);

    Result := fltCusIte - (fltCreIcm + fltCre_ST);

    FAuditoriaCat17
      .SetC17Mod(fCfgSis('C17MOD', varInteger, GetEmpCfg(strEmpIte)))
      .SetCodSit(strCodSit)
      .SetAlqRet(fltAlqRet)
      .SetValIva(fltValIva)
      .SetCodIte(strCodIte)
      .SetTeveReducao(True);

    Exit;
  End;

  If (Pos(fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)),'A_C_V_') > 0) Then
    If Not fCalculaICMS(strCodIte) Then
      Exit;

  blnPossuiUltimaCompra := fGetInformacoesUltimaCompra(strCodIte, dtaUltDataCompra, strUltDocumento, fltUltPrecoCompra, strUltFornecedor);
  If (Not blnPossuiUltimaCompra) and (fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)) <> 'C') Then
    Exit;

  If (Pos(fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)),'A_C_V_') > 0) Then
  Begin
    fltComLiq := fCalculaPrecoCompraLiquido(strCodIte, fGetEmpCalculoItem(strEmpIte), cdsIteGer);

    strEstFor := fEstadoFornecedor(strUltFornecedor);

    fltPercentualRessarcimento := fGetPercentualRessarcimentoCATIPIEnt(strCodIte, fGetEmpCalculoItem(strEmpIte), strCodAbf, strEstFor);

    Result := fltCusIte - fFormataFloat(fltComLiq * (fltPercentualRessarcimento / 100), 2);

    FAuditoriaCat17
      .SetMCAT17(fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)))
      .SetResTot(fltPercentualRessarcimento)
      .SetCodIte(strCodIte)
      .SetTeveReducao(True);

    Exit;
  End
  Else
  If (Pos(fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)),'D_M_S_') > 0) Then
  Begin
    qryConsul := fCriaQuery(Self);

    With qryConsul Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT IFNULL(DET_VAERET, 0.00) + IFNULL(DET_VLGNRE, 0.00) AS DET_VALRET,');
      SQL.Add('        IFNULL(DE.N16_PICMS, 0.00) AS DET_ALQICM, DET_QTDITE, DET_DTAENT, ');
      SQL.Add('        ROUND(IFNULL( DE.N17_VICMS,0),2) AS DET_VALICM ');
      SQL.Add('   FROM MOVDET D ');
      SQL.Add('   LEFT  JOIN MOVTRI T  ON T.DET_SEQGER  = D.AUTOINCREM ');
      SQL.Add('   LEFT  JOIN GERELE GE ON GE.GER_DOCENT = D.DET_NUMDOC ');
      SQL.Add('                       AND GE.GER_ESPENT = D.DET_ESPDOC ');
      SQL.Add('                       AND GE.GER_EMPENT = D.DET_CODEMP ');
      SQL.Add('                       AND GE.GER_CODFOR = D.DET_CODFOR ');
      SQL.Add('                       AND IFNULL(GE.B07_SERIE, "") = IFNULL(D.DET_SERIE_, "") ');
      SQL.Add('   LEFT JOIN DETELE DE ON DE.DET_SEQGER = GE.AUTOINCREM ');
      SQL.Add('                      AND DE.DET_CODITE = D.DET_CODITE ');
      SQL.Add('  WHERE D.DET_NUMDOC = :NUMDOC ');
      SQL.Add('    AND D.DET_ESPDOC = :ESPDOC ');
      SQL.Add('    AND D.DET_CODEMP = :CODEMP ');
      SQL.Add('    AND D.DET_CODFOR = :CODFOR ');
      SQL.Add('    AND D.DET_CODITE = :CODITE ');
      SQL.Add('    AND LOCATE(D.DET_CODFIS, :CODFIS) > 0 ');

      ParamByName('NUMDOC').AsString := Copy(strUltDocumento, 01, 12);
      ParamByName('ESPDOC').AsString := Copy(strUltDocumento, 13, 02);
      ParamByName('CODEMP').AsString := Copy(strUltDocumento, 15, 03);
      ParamByName('CODFOR').AsString := strUltFornecedor;
      ParamByName('CODFIS').AsString := CST_SUBSTITUICAO;
      ParamByName('CODITE').AsString := strCodIte;
      Open;

      If (Not IsEmpty) And (FieldByName('DET_QTDITE').AsFloat <> 0) And
         ((FieldByName('DET_VALRET').AsFloat > 0) Or (FieldByName('DET_ALQICM').AsFloat > 0)) Then
      Begin
        strNotC17 := strUltDocumento;
        fltCre_ST := (FieldByName('DET_VALRET').AsFloat  / FieldByName('DET_QTDITE').AsFloat);
        fltCreIcm := (FieldByName('DET_VALICM').AsFloat  / FieldByName('DET_QTDITE').AsFloat);
        Result    := fFormataFloat(fltCusIte - fltCre_ST - fltCreIcm, 2);

        FAuditoriaCat17
          .SetDocumentoUltimaCompra(strUltDocumento)
          .SetFornecedorUltimaCompra(strUltFornecedor)
          .SetCodIte(strCodIte)
          .SetTeveReducao(True);
      End;

      Close;
    End;

    FreeAndNil(qryConsul);
  end;
end;

function TFatVendaBase.fGetCodAbf(strCodIte: String; strCodEmp: String = ''): String;
  Var
    strCodEmpAux: String;
begin
  strCodEmpAux := strCodEmp;

  If (VS_strCodEmp = IfEmptyStr(strCodEmpAux, VS_strCodEmp)) Then
    If (VS_strCodEmp <> fRetornaEmpresaTE_CD) Then
      strCodEmpAux := IfEmptyStr(fRetornaEmpresaTE_CD, VS_strCodEmp);

  Result := untFuncoesGenerica.fGetCodAbf(strCodIte, strCodEmpAux);

  If fSimuladorLancamentoItemAtivado Then
    Result := FstrCodAbfSimulador;
end;

Function TFatVendaBase.fBuscaAbfIcm(strCodIte, strEmpIte, strCodAbf, strEstado: String): Boolean;
  Var
    qryAbfGen: TUniquery;
    LKey: string;
Begin
  Result := True;

 If fSimuladorLancamentoItemAtivado Then
    strEstado := FstrEstAbfSimulador;

  LKey := strCodIte + strEmpIte + strCodAbf + strEstado + fRetornaEmpresaTE_CD + fGetEmpCalculoItem(strEmpIte);

  If dicAbfIcm.TryGetValue(LKey, cdsAbfIcm) Then
    Exit;

  qryAbfGen := fCriaQuery(Self);
  Try
    With qryAbfGen, SQL Do
    Begin
      Close;

      Add(TFunctionFuncoesFaturamento.SqlBuscaAbfIcm(fRetornaEmpresaTE_CD, fGetEmpCalculoItem(strEmpIte)));

      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODABF').AsString := strCodAbf;
      ParamByName('ESTADO').AsString := strEstado;

      cdsAbfIcm := ExecutarQueryEmCache(qryAbfGen);

      If cdsAbfIcm.FieldByName('ABF_CODABF').AsString.IsEmpty Then
        Exit(False);

      dicAbfIcm.AddOrSetValue(LKey, cdsAbfIcm);
    End;
  Finally
    FreeAndNil(qryAbfGen);
  End;
End;

