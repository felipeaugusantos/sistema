function TFatVendaBase.fExecutarValidacaoMargemCondPagto_ItemAItem(ACodIte, ACodEmp: String): Boolean;
begin

  Result := True;

  If fConsiderarItemPromocionalNaValidacaoDaFaixaDeMargemMarkupDoPerfilCondPagto Then
