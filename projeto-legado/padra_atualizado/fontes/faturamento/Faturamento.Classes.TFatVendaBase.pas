procedure TFatVendaBase.pCalculaVariaveisDePisCofinsParaClienteZonaFranca;
  Var
    strClaFisIte: String;
    intContador : Integer;
    CalcResult  : TResultPisCofins;
    tmp         : TCalculoPisCofins;
begin

  pProcessMessages;

  fltTotPis_ZFM := 0;
  fltAlqPis_ZFM := 0;
  fltBasPis_ZFM := 0;
  fltTotCof_ZFM := 0;
  fltAlqCof_ZFM := 0;
  fltBasCof_ZFM := 0;

  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin

    strClaFisIte := arrMatItens[intContador].strClaFis;

    If fEmptyStr(arrMatItens[intContador].strIteAbf) Then
      arrMatItens[intContador].strIteAbf := arrMatItens[intContador].strCodIte;

    Try
      tmp := TCalculoPisCofins.Create;
      tmp.strCodEmbarcacao := FCodEmbarcacao;
      CalcResult := tmp.fCalculoPisCofins(VS_strCodEmp,arrMatItens[intContador].strIteAbf,
                                          strClaFisIte,
                                          arrMatItens[intContador].strCodFis,
                                          strCodCli,
                                          VS_strSimPau,
                                          strOpcDoc,arrMatItens[intContador].fltTotIte,
                                          arrMatItens[intContador].fltDesEsp,arrMatItens[intContador].fltValipi,
                                          arrMatItens[intContador].fltValRet,arrMatItens[intContador].fltValFre,
                                          arrMatItens[intContador].fltDesAce,arrMatItens[intContador].fltValIcm,
                                          arrMatItens[intContador].VisualizarFcpIcms.fltValor,
                                          IIF(fDocumentoParaFornecedor,'F','C'),
                                          arrMatItens[intContador].strIncPis,
                                          IIF(fEmptyStr(arrMatItens[intContador].strSit_PC), Self.strSitP_C, arrMatItens[intContador].strSit_PC),
                                          strMenP_C,dtaDtaEnt,strCodEmpTe,
                                          blnEhOperacaoDeTransferencia,
                                          blnBFut49,
                                          arrMatItens[intContador].strEntRet,
                                          arrMatItens[intContador].strEntFut,
                                          arrMatItens[intContador].strMotFut,
                                          arrMatItens[intContador].strClaIpi,
                                          True,
                                          '',
                                          -1,
                                          '',
                                          '',
                                          0,
                                          0,
                                          fDifalItem(arrMatItens[intContador]));
      If (Not CalcResult.blnResult) Then
        Abort;
    Finally
      FreeAndNil(tmp);
    End;

    fltBasPis_ZFM := fltBasPis_ZFM + CalcResult.dblBasePis;
    fltBasCof_ZFM := fltBasCof_ZFM + CalcResult.dblBaseCof;
    fltTotPis_ZFM := fltTotPis_ZFM + CalcResult.dblValorPis;
    fltTotCof_ZFM := fltTotCof_ZFM + CalcResult.dblValorCof;
    fltAlqPis_ZFM := CalcResult.dblAlqPis;
    fltAlqCof_ZFM := CalcResult.dblAlqCof;
  End;

end;

