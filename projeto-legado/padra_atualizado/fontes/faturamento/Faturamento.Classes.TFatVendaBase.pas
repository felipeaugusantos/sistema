                                                  const fltICMSai: Double;
                                                  const fltImpFed: Double;
                                                  const strTabPre: String;
                                                  dtaDtaEnt: TDateTime;
                                                  const fltProComAta: Double;
                                                  const fltProComDis: Double;
                                                  const blnPodAlt: Boolean;
                                                  const fltCusIte: Double;
                                                  const fltQtdPec: Double;
                                                  intSeqInc: Integer;
                                                  const strObsColorista : String;
                                                  const intTipoFormulacao : Integer;
                                                  const strNotC17: String;
                                                  const fltValorOriginalItemEstrutura: Double;
                                                  const strBasTro: String;
                                                  const strCodDig: String = '');

  Var
    strCodIte: String;
    blnDeveRecalcularTotGerItem : Boolean;
    fltQtdIteMovRcd: Double;
    fltQtdIteBaiReq: Double;

  function fInseriuOrcamentoDiferenteNoPassoAnterior: Boolean;
    Var
      strDocAtu: String;
  begin
    strDocAtu := cdsDados.FieldByName('ITE_NUMORC').AsString+cdsDados.FieldByName('ITE_ESPORC').AsString+cdsDados.FieldByName('ITE_EMPORC').AsString;

    Result := (Not fEmptyStr(strDocAtu)) And
              (Length(strDocAtu) = Length(Self.FChaveUltimoDocSeqInd)) And
              (strDocAtu <> Self.FChaveUltimoDocSeqInd);
  end;
Begin
  If (Not cdsDados.Locate('ITE_CHVUNI', strChaveUnica, [])) Then
    Raise Exception.Create('Registro não encontrado [AlteraRegistroTemporaria]!');

  If (fEmptyStr(cdsDados.FieldByName('ITE_CODITE').AsString)) Then
    Raise Exception.Create('Código do produto do registro não encontrado [AlteraRegistroTemporaria]!');

  pSetarImpostosFatParametrosComum(fGetEmpCalculoItem(cdsDados.FieldByName('ITE_EMPITE').AsString));

  strCodIte := cdsDados.FieldByName('ITE_CODITE').AsString;

  cdsDados.Edit;

  objCalculaImpostoPedido.pAtualizarImpostosCdsVendas(cdsDados, strChaveUnica, strCodAbf, fltQtdIte, fltUniTar, fltTotIte, blnDeveRecalcularTotGerItem);

  If TMostraTravaMinimaHelper.fExibeTravaMinima Then
    TMostraTravaMinimaHelper.pAtualizaAutInc(cdsDados.FieldByName('AUTOINCREM').AsString, strCodIte, cdsTravaMinima);

  cdsDados.FieldByName('ITE_NOTC17').AsString  := strNotC17;
  cdsDados.FieldByName('ITE_UNITAR').AsFloat   := fltUniTar;
  cdsDados.FieldByName('ITE_UNILOD').AsFloat   := fltUniTar;
  cdsDados.FieldByName('ITE_QTDITE').AsFloat   := fltQtdIte;

{$IFNDEF LINUX}
  If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
  Begin
    cdsDados.FieldByName('ITE_QTDPEC').AsFloat := fltQtdPec;

    if fltQtdPec = 0 then
      cdsDados.FieldByName('ITE_UNTPEC').AsFloat := 0
    else
      cdsDados.FieldByName('ITE_UNTPEC').AsFloat := fltTotIte / fltQtdPec;
  End;
{$ENDIF}

  If (Self.fltVlCtVn > 0) And fItemUtilizaPrecoEmDolar(cdsDados.FieldByName('ITE_CODITE').AsString) Then
  Begin
    cdsDados.FieldByName('ITE_UNIDOL').AsFloat := cdsDados.FieldByName('ITE_UNITAR').AsFloat / Self.fltVlCtVn;
  End;

  cdsDados.FieldByName('ITE_TOTITE').AsFloat   := fltTotIte;
  cdsDados.FieldByName('ITE_CUSITE').AsFloat   := fltCusIte;
  cdsDados.FieldByName('ITE_PRECUS').AsFloat   := fltPreCus;
  cdsDados.FieldByName('ITE_TOTCUS').AsFloat   := fltTotCus;
  cdsDados.FieldByName('ITE_PRECU2').AsFloat   := fltPreCu2;
  cdsDados.FieldByName('ITE_TOTCU2').AsFloat   := fltTotCu2;
  cdsDados.FieldByName('ITE_PREVE1').AsFloat   := fltPreVe1;
  cdsDados.FieldByName('ITE_PREVE2').AsFloat   := fltPreVe2;
  cdsDados.FieldByName('ITE_PREVE3').AsFloat   := fltPreVe3;
  cdsDados.FieldByName('ITE_PREVE4').AsFloat   := fltPreVe4;
  cdsDados.FieldByName('ITE_PREVE5').AsFloat   := fltPreVe5;
  cdsDados.FieldByName('ITE_PREVE6').AsFloat   := fltPreVe6;
  cdsDados.FieldByName('ITE_PREVE7').AsFloat   := fltPreVe7;
  cdsDados.FieldByName('ITE_SALDOS').AsFloat   := fltSaldos;
  cdsDados.FieldByName('ITE_DOCDEV').AsString  := strDocDev;
  cdsDados.FieldByName('ITE_ESPDEV').AsString  := strEspDev;
  cdsDados.FieldByName('ITE_EMPDEV').AsString  := strEmpDev;
  cdsDados.FieldByName('ABF_CODABF').AsString  := strCodAbf;
  cdsDados.FieldByName('ITE_PESOIT').AsFloat   := fltPesoIt;
  cdsDados.FieldByName('ITE_PESLIQ').AsFloat   := fltPesLiq;
  cdsDados.FieldByName('ITE_PROCUS').AsFloat   := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', fltProPreCus, 0);
  cdsDados.FieldByName('ITE_PROVEN').AsFloat   := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', fltProPreVen, 0);
  cdsDados.FieldByName('ITE_PROCVA').AsFloat   := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', fltProComVar, 0);
  cdsDados.FieldByName('ITE_PROCAT').AsFloat   := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', fltProComAta, 0);
  cdsDados.FieldByName('ITE_PROCDI').AsFloat   := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', fltProComDis, 0);
  cdsDados.FieldByName('ITE_COMPRO').AsString  := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', Self.strComPro, 'P');
  cdsDados.FieldByName('ITE_CODPRO').AsString  := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', Self.strCodPro, '');
  cdsDados.FieldByName('ITE_DESF07').AsFloat   := IIF(cdsDados.FieldByName('ITE_PROMOC').AsString = 'S', fltProDesF07, 0);
  cdsDados.FieldByName('ITE_QTDREC').AsFloat   := 0;
  cdsDados.FieldByName('ITE_QTORI2').AsFloat   := 0;
  cdsDados.FieldByName('ITE_QTDATE').AsFloat   := 0;

  if (intSeqInd = 0) and (Self.FseqIndUlt > 0) and (Not fInseriuOrcamentoDiferenteNoPassoAnterior) then
  Begin
    Self.FSeqIndUlt := Self.FseqIndUlt + 1;
    intSeqInd  := Self.FSeqIndUlt;
  End;

  if (Self.strEspDoc = 'PD') and (fCfgSis('PDOPRC', varBoolean)) then
  begin
    cdsDados.FieldByName('ITE_QTDREC').AsFloat := fRetQtdRecPDOPRC(Self.strNumDoc,
                                                                   Self.strEspDoc,
                                                                   Self.strEmpDoc,
                                                                   strCodIte,
                                                                   fltQtdIteMovRcd,
                                                                   fltQtdIteBaiReq);
    cdsDados.FieldByName('ITE_QTORI2').AsFloat := fltQtdIteMovRcd;
    cdsDados.FieldByName('ITE_QTDATE').AsFloat := fltQtdIteBaiReq;
  end;

  cdsDados.FieldByName('ITE_SEQIND').AsInteger := intSeqInd;
  cdsDados.FieldByName('ITE_QTDBAI').AsFloat := fltQtdBai;
  cdsDados.FieldByName('ITE_OUTVAL').AsFloat   := fltOutVal;
  cdsDados.FieldByName('SAV_OUTVAL').AsFloat   := fltOutVal;
  cdsDados.FieldByName('ITE_DESOPE').AsFloat   := fltDesOpe;
  cdsDados.FieldByName('ITE_ICMSAI').AsFloat   := fltIcmSai;
  cdsDados.FieldByName('ITE_IMPFED').AsFloat   := fltImpFed;
  cdsDados.FieldByName('FLG_STATUS').AsString  := strStatus;
  cdsDados.FieldByName('ITE_SEMEST').AsString  := strSemEst;
  cdsDados.FieldByName('ITE_TABANT').AsString := cdsDados.FieldByName('ITE_TABPRE').AsString;
  cdsDados.FieldByName('ITE_TABPRE').AsString := strTabPre;
  cdsDados.FieldByName('ITE_CODDIG').AsString := strCodDig;

  If (Pos(cdsDados.FieldByName('ITE_MOTFUT').AsString, 'P_F') > 0) And (dtaDtaEnt < Self.VS_Date) Then
    dtaDtaEnt := Self.VS_Date;

  {Data de Entrega}
  If dtaDtaEnt = 0 Then
    cdsDados.FieldByName('ITE_DTENTR').Value := Null
  Else
    cdsDados.FieldByName('ITE_DTENTR').AsDateTime := dtaDtaEnt;

  cdsDados.FieldByName('ITE_ENT_CD').AsBoolean  := Self.blnEnt_CD;

  If fEmptyStr(cdsDados.FieldByName('ITE_EMPSOL').AsString) Then
    cdsDados.FieldByName('ITE_PODALT').AsBoolean := blnPodAlt
  Else
    cdsDados.FieldByName('ITE_PODALT').AsBoolean := IIF(cdsDados.FieldByName('ITE_EMPSOL').AsString <> cdsDados.FieldByName('ITE_EMPITE').AsString, blnPodAlt, True);

  cdsDados.FieldByName('ITE_PREANT').AsFloat := cdsDados.FieldByName('ITE_PRETAB').AsFloat;

  If fEmptyStr(strTabPre) Or (cdsDados.FieldByName('ITE_PREVE' + strTabPre).AsFloat = 0) Then
    cdsDados.FieldByName('ITE_PRETAB').AsFloat := cdsDados.FieldByName('ITE_UNIORI').AsFloat
  Else
    cdsDados.FieldByName('ITE_PRETAB').AsFloat := cdsDados.FieldByName('ITE_PREVE' + strTabPre).AsFloat +
                           fFormataFloat(cdsDados.FieldByName('ITE_PREVE' + strTabPre).AsFloat *
                                        (cdsDados.FieldByName('ITE_TAXJUR').AsFloat / 100.0), Self.VS_intDecUni);

  cdsDados.FieldByName('ITE_PRETAB').AsFloat := fFormataFloat(cdsDados.FieldByName('ITE_PRETAB').AsFloat, Self.VS_intDecUni);

  If fCfgSis('PRETAB', varBoolean) Then
  Begin
    If cdsDados.FieldByName('ITE_PRETAB').AsFloat <> 0 Then
      cdsDados.FieldByName('ITE_VARTAB').AsFloat := ((cdsDados.FieldByName('ITE_UNITAR').AsFloat / cdsDados.FieldByName('ITE_PRETAB').AsFloat) - 1) * 100;
  End
  Else
  Begin
    If cdsDados.FieldByName('ITE_UNIORI').AsFloat <> 0 Then
      cdsDados.FieldByName('ITE_VARTAB').AsFloat := ((cdsDados.FieldByName('ITE_UNITAR').AsFloat / cdsDados.FieldByName('ITE_UNIORI').AsFloat) - 1) * 100;
  End;

  cdsDados.FieldByName('ITE_PREATU').AsFloat := cdsDados.FieldByName('ITE_PREVE' + IIF(fEmptyStr(strTabPre),'1', strTabPre)).AsFloat ;

  If (Pos(Self.strOpcDocTrue, 'BE_') <= 0) Then
  Begin
    If (intSeqInc <= 0) And (Pos(Self.strOpcDoc, 'OR_PD_VN_') > 0) Then
      intSeqInc := fRetornaSequencialUnico('SINCPD');
  End;

  cdsDados.FieldByName('ITE_SEQINC').AsInteger := intSeqInc;

  If (SameText(cdsDados.FieldByName('ITE_ATIVAC').AsString, 'S')) Then
    cdsDados.FieldByName('ITE_SITUAC').AsString := 'C'
  Else If (SameText(cdsDados.FieldByName('ITE_BRINDE').AsString, 'S')) Then
    cdsDados.FieldByName('ITE_SITUAC').AsString := 'B'
  Else If ((SameText(cdsDados.FieldByName('ITE_PROMOC').AsString, 'S')) Or ((cdsDados.FieldByName('ITE_SEQCOM').AsInteger > 0) And (Not SameText(cdsDados.FieldByName('ITE_BRINDE').AsString, 'S')))) And
          ((Not Self.blnCliFil) Or ((Self.blnCliFil) And (PRECOS_TE_PROMOC.Contains(Self.recDadCli.strTEPPRO)))) Then
    cdsDados.FieldByName('ITE_SITUAC').AsString := 'P'
  Else If (Not SameText(cdsDados.FieldByName('ITE_IDEPRO').AsString, 'NOR')) Then
    cdsDados.FieldByName('ITE_SITUAC').AsString := 'T'
  Else
    cdsDados.FieldByName('ITE_SITUAC').AsString := 'N';

  cdsDados.FieldByName('ITE_OBSCOL').AsString := strObsColorista;
  cdsDados.FieldByName('ITE_TIPFOR').AsInteger := intTipoFormulacao;

  If (Assigned(objOrdSer)) And (cdsDados.FieldByName('ITE_SEQORS').AsInteger = 0) Then
    cdsDados.FieldByName('ITE_SEQORS').AsInteger := objOrdSer.intSeqIndProd;

  If fEmpCarPreenchidaEmpDif(cdsDados.FieldByName('ITE_EMPCAR').AsString, cdsDados.FieldByName('ITE_EMPITE').AsString) Then
    cdsDados.FieldByName('ITE_SALCAR').AsFloat := fRetSaldosEmpresa(strCodIte, cdsDados.FieldByName('ITE_EMPCAR').AsString, cdsDados.FieldByName('ITE_NUMLOT').AsString)
  Else
    cdsDados.FieldByName('ITE_SALCAR').AsFloat := 0;

  cdsDados.FieldByName('ITE_PERDESEMBFEC').AsFloat := FAuditoriaEmbFechada.RetornarValorPercentualDescontoEmbalagemFechada(VS_strCodEmp, strCodIte, strTabPre, '', fltQtdIte);

  cdsDados.FieldByName('ITE_DESPRO').AsString := fRetDescPromocao(cdsDados.FieldByName('ITE_CODPRO').AsString);

  if (fltValorOriginalItemEstrutura > 0) then
    cdsDados.FieldByName('ITE_ESTORI').AsFloat   := fltValorOriginalItemEstrutura;

  If (Not fEmptyStr(strBasTro)) Then
    cdsDados.FieldByName('ITE_BASTRO').AsString := strBasTro;

  If (cdsDados.FieldByName('ITE_CNTEMB').AsInteger > 0) Then
    cdsDados.FieldByName('ITE_EHEMBA').AsBoolean := fEhEmbalagemFechadaItem(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                            cdsDados.FieldByName('ITE_TABPRE').AsString,
                                                                            cdsDados.FieldByName('ITE_QTDITE').AsFloat)
  Else
    cdsDados.FieldByName('ITE_EHEMBA').AsBoolean := False;

  If cdsDados.FieldByName('ITE_EHEMBA').AsBoolean Then
  Begin
    cdsDados.FieldByName('ITE_PEREMB').AsFloat := fPercDescEmbalagemFechadaItem(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                                cdsDados.FieldByName('ITE_TABPRE').AsString,
                                                                                cdsDados.FieldByName('ITE_QTDITE').AsFloat,
                                                                                EmptyStr);
    If (fFormataFloat(cdsDados.FieldByName('ITE_UNIORI').AsFloat, Self.VS_intDecUni) <> fFormataFloat(cdsDados.FieldByName('ITE_UNIDIG').AsFloat, Self.VS_intDecUni)) Then
      cdsDados.FieldByName('ITE_VLPEMB').AsFloat := fFormataFloat((cdsDados.FieldByName('ITE_UNIORI').AsFloat - (cdsDados.FieldByName('ITE_UNIORI').AsFloat * cdsDados.FieldByName('ITE_PEREMB').AsFloat / 100)), Self.VS_intDecUni)
    Else
      cdsDados.FieldByName('ITE_VLPEMB').AsFloat := cdsDados.FieldByName('ITE_UNIORI').AsFloat;

    cdsDados.FieldByName('ITE_PEREMB').AsFloat := fFormataFloat(((1 - (cdsDados.FieldByName('ITE_UNITAR').AsFloat / cdsDados.FieldByName('ITE_VLPEMB').AsFloat)) * 100), Self.VS_intDecUni);

    cdsDados.FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((cdsDados.FieldByName('ITE_QTDITE').AsFloat * cdsDados.FieldByName('ITE_VLPEMB').AsFloat), Self.VS_intDecUni);
  End
  Else
  Begin
    cdsDados.FieldByName('ITE_PEREMB').AsFloat := 0;
    cdsDados.FieldByName('ITE_VLPEMB').AsFloat := 0;
    cdsDados.FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((cdsDados.FieldByName('ITE_QTDITE').AsFloat * cdsDados.FieldByName('ITE_UNIORI').AsFloat), Self.VS_intDecUni);
  End;

  cdsDados.FieldByName('ITE_USADCE').AsString := fUsaCfopDecretoCeara(strCodIte);
  cdsDados.FieldByName('ITE_CLADCE').AsString := fRetornaCfopDecretoCeara(strCodIte);
  cdsDados.FieldByName('ITE_PIIZFM').AsFloat  := fCampoTabela('ITE_PIIZFM','CADITE',['ITE_CODITE'],[strCodIte], False) ;

  If (Not blnDeveRecalcularTotGerItem) Then
    pDefinirImpostosCalculadosNaVendaIcmCal(cdsDados);

  If ((Self.strOpcDoc = 'PD') Or (Self.strEspDoc = 'PD')) And
     (fCfgSis('F11FPD', varBoolean)) And
     (fEmptyStr(cdsDados.FieldByName('ITE_LCTBAR').AsString)) Then
  Begin
    cdsDados.FieldByName('ITE_LCTBAR').AsString := 'N';

    If (cdsDados.FieldByName('ITE_ENTRET').AsString = 'R') And
       (cdsDados.FieldByName('ITE_LOCRET').AsString = 'C') Then
    Begin
      If fFormataFloat(cdsDados.FieldByName('ITE_QTDEXP').AsFloat, Self.VS_intDecUni) =
         fFormataFloat(cdsDados.FieldByName('ITE_QTDITE').AsFloat, Self.VS_intDecUni) Then
      Begin
        If Not fEmptyStr(fCampoTabela('ITE_CODBAR','CADITE',['ITE_CODITE'],[cdsDados.FieldByName('ITE_CODITE').AsString], False)) Then
          cdsDados.FieldByName('ITE_LCTBAR').AsString := 'S';
      End;
    End;
  End;

  cdsDados.Post;

  If ((fEhAutocenter) Or (fCfgSis('RETDEV', varString) = 'S')) And (Not fEhItemServico(strCodIte)) Then
    pInsereRegistroLogItensSep(cdsDados, 'I', 0, True);

  If (Self.strOpcDoc = 'NP') And Assigned(objIcmsItemImob) Then
    objIcmsItemImob.intAutInc := cdsDados.FieldByName('AUTOINCREM').AsInteger;

  pDefinirAutIncItemLogLib(strCodIte, cdsDados.FieldByName('AUTOINCREM').AsInteger);

  If (blnDeveRecalcularTotGerItem) Then
    pCalculaTotGerProdutoSelecionado(cdsDados);
End;

procedure TFatVendaBase.pSetaCampoPromocaoPorCnd(cdsDados: TUniClientDataSet; matrizSaldosColorantes: TClassMatrizSaldosColorantes; blnEditaPosta: Boolean=False);
  Var
    intIndex: Integer;
begin
  If (Self.fMarcaItensComPromocaoPorCnd) Then
  Begin
    If (cdsDados.FieldByName('FLG_STATUS').AsString <> 'C') Then
    Begin
      If (cdsDados.FieldByName('ITE_IDEPRO').AsString <> 'NOR') And (fEmptyStr(cdsDados.FieldByName('ITE_RECPRO').AsString)) Then
      Begin
        If (Assigned(matrizSaldosColorantes)) Then
        Begin
          For intIndex := 0 To matrizSaldosColorantes.Count -1 Do
          Begin
            If fItemComPromocaoPorCnd(matrizSaldosColorantes[intIndex].strCodIte, cdsDados.FieldByName('ITE_EMPITE').AsString) Then
            Begin
              If blnEditaPosta Then
                cdsDados.Edit;

              cdsDados.FieldByName('ITE_RECPRO').AsString := 'S';

              If blnEditaPosta Then
                cdsDados.Post;

              Break;
            End;
          End;
        End;
      End;
    End;
  End;
end;

function TFatVendaBase.fOpcaoDeDocumentoNotaDeComplemento: Boolean;
begin
  Result := (strOpcDoc = 'NC') And (Not blnNotaCompValor);
end;

function TFatVendaBase.fPreencheMatrizFechamento: Boolean;
begin
  Result := True;
  Try
    Self.pPreencheMatrizFechamento;
  Except
    On E: ExceptionAutCom Do
    Begin
      Result := False;
      fMensagem('', E.Message, ['&O K']);
    End;

    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, 'fPreencheMatrizFechamento');
    End;
  End;
end;

function TFatVendaBase.fConfirmandoPedidosAgrupadoNoF11: Boolean;
begin
  Result := (Self.blnPedidoOrigemAgrupamento) And (Self.strOpcDocTrue = '11');
end;

procedure TFatVendaBase.pPreencheMatrizFechamento(strFilter: String = ''; pOnProcessaItem: TOnProcessaItem = nil; cdsCalculo: TUniClientDataSet = nil);
begin
  pPreencheMatrizFechamento(Self.arrMatItens, Self.arrMatItensCorte, strFilter, pOnProcessaItem, cdsCalculo);
end;

procedure TFatVendaBase.pPreencheMatrizFechamento(Var Itens, ItensCorte: TMatrizFechamento; strFilter: String = ''; pOnProcessaItem: TOnProcessaItem = nil; cdsCalculo: TUniClientDataSet = nil );
  Var
    intPosicao: Integer;
    cdsDados: TUniClientDataSet;
    blnAbfIcm: Boolean;
    stlDocsDev: TStringList;
    stlChavesDocsDev: TStringList;
    stlDocsDevEntFut: TStringList;
    strTipAbf: String;
    strIteAbf: String;

    strNumCooSerCupom : String;

    strNumDocRefDev,
    strEspDocRefDev,
    strEmpDocRefDev,
    strDtaEntRefDev,
    strClaFisDocDev: String;

    strNumDocOriFut,
    strEspDocOriFut,
    strEmpDocOriFut,
    strDtaEntOriFut: String;

    ValorAliquotaIBPT: TValorAliquotaIBPT;
    fltAuxiliar: Double;
    intDecQtd: Integer;
    LstrTabelaPreco : String;
    LfltPrecoVenda : Double;

    cdsItensTmp: TUniClientDataSet;
begin
  cdsDados := nil;
  stlDocsDev := nil;
  stlChavesDocsDev := nil;
  stlDocsDevEntFut := nil;

  Try
    Try
      If fOpcaoDeDocumentoNotaDeComplemento Then
        Exit;

      blnAplicaTaxaEntrega := False;

      strDocsDevolucao := '';
      strChavesDocsDev := '';
      strDocsDevEntFut := '';

      stlDocsDev := TStringList.Create;
      stlDocsDev.Duplicates := dupIgnore;
      stlDocsDev.Sorted := True;

      stlChavesDocsDev := TStringList.Create;
      stlChavesDocsDev.Duplicates := dupIgnore;
      stlChavesDocsDev.Sorted := True;

      stlDocsDevEntFut := TStringList.Create;
      stlDocsDevEntFut.Duplicates := dupIgnore;
      stlDocsDevEntFut.Sorted := True;

      cdsDados := TUniClientDataSet.Create(Self);

      if not Assigned(cdsCalculo) then
        cdsDados.Data := cdsVenda.Data
      else
        cdsDados.Data := cdsCalculo.Data;

      cdsDados.LogChanges := False;

      If cdsVenda.Filtered Or (Not fEmptyStr(strFilter)) Then
      Begin
        cdsDados.Filter := '(1 = 1)';

        If Not fEmptyStr(cdsVenda.Filter) Then
          cdsDados.Filter := cdsDados.Filter + ' AND ' + ' ('+ cdsVenda.Filter+') ';

        If Not fEmptyStr(strFilter) Then
          cdsDados.Filter := cdsDados.Filter + ' AND ' + ' ('+ strFilter+') ';

        cdsDados.Filtered := True;
      End;

      cdsDados.IndexFieldNames := 'ITE_ORDITE';

      blnTemTinta := False;
      SetLength(Itens, 0);
      SetLength(ItensCorte, 0);

      intDecQtd := fCfgSis('DECQTD', varInteger);

      With cdsDados Do
      Begin
        First;

        If (Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0) And ((blnDevolucaoCompleta) or (blnEspelhoDevolucaoCliente and Not fEmptyStr(FCodAde))) Then
        Begin
          fltDesEsp := 0;
          fltValFre := 0;
          FFreAnt   := 0;
          fltFreDig := 0;
          fltDesAce := 0;
          fltDeADig := 0;
        End;

        While (Not Eof) Do
        Begin
          If fEmptyStr(cdsDados.FieldByName('ABF_ITEABF').AsString) Then
            strIteAbf := cdsDados.FieldByName('ITE_CODITE').AsString
          Else
            strIteAbf := cdsDados.FieldByName('ABF_ITEABF').AsString;

          If fSimuladorLancamentoItemAtivado Then
          Begin
            strCliEst := FstrEstAbfSimulador;

            cdsDados.Edit;
            cdsDados.FieldByName('ABF_CODABF').AsString := FstrCodAbfSimulador;
