begin
  objMargemLucro.PreencherDataSetComInformacoesDaMargemLucroCalculada(cdsDados,
    strClaFis, fltDesOpeCli, blnProcessarTodosRegistros);
end;

function TFatVendaBase.fCalculaMargemLucro(blnAplicaDescontos: Boolean;
                                           intAutIncCalcMar: Integer = -1;
                                           pgbStatus: TcxProgressBar = Nil;
                                           blnMostraMargem: Boolean = False;
                                           blnUsaRegraITEMAR: Boolean = True;
                                           const blnCalculandoTotais : Boolean = False): OleVariant;
  Var
    strIMPCF4: String;
    strMarMkp: String;
    strMarPra: String;
    intRecNo : Integer;
    prcScroll: TprcScroll;
    fltTotalProdutosRateio: Double;
    blnItemPromocaoEntraNoRateio: Boolean;
    strFilter : String;
    blnFiltered : Boolean;

  function fDesconsiderarItemPromocional():Boolean;
  begin
    Result := False;
    If (cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') Then
    Begin
      If (VS_strTRADES = '4') And (Not fConsiderarItemPromocionalMargemMinimaDocumento) Then
        Exit(True);

      If (blnUsaRegraITEMAR) And (Not fConsiderarItemPromocionalNaValidacaoDaFaixaDeMargemMarkupDoPerfilCondPagto()) Then
        Exit(True);
    End;
  end;

begin
  strIMPCF4 := fCfgSis('IMPCF4');
  strMarMkp := fMarMpkParaVenda(fCfgSis('MARMKP'));
  strMarPra := fCfgSis('MARPRA');

  blnItemPromocaoEntraNoRateio := True;
  fltTotalProdutosRateio := 0;

  If blnAplicaDescontos Then
  Begin
    blnItemPromocaoEntraNoRateio := (fPermiteDescontoPromocao('', tapcdeOlhandoTodosItens)) Or
                                    (fSomenteItensEmPromocaoNaVenda) Or
                                    (fRegraPrecoSugestaoAtiva <> TRegraPrecoSugestao.PrecoDePromocao);
    fltTotalProdutosRateio := fGetTotalProdutosRateio(cdsVenda, blnItemPromocaoEntraNoRateio);
  End;

  With cdsVenda Do
  Begin

    intRecNo := RecNo;

    Try
      pDisableControls(cdsVenda, prcScroll);

      First;

      If intAutIncCalcMar = -1 Then
        objMargemLucro.cdsItensMargem.EmptyDataSet

      Else If objMargemLucro.cdsItensMargem.Locate('AUTOINCREM', intAutIncCalcMar, []) Then
        objMargemLucro.cdsItensMargem.Delete;

      If (Not blnMostraMargem) And (Not blnCalculandoTotais) Then
      Begin
        If Self.fConsiderarComissaoNoCalculoCustoRealMargem Then
          Self.fRecalculaComissao(True, '', True, False);
      End;

      strFilter := cdsVenda.Filter;
      blnFiltered := cdsVenda.Filtered;
      Try
        If (intAutIncCalcMar <> -1) Then
        Begin
          cdsVenda.Filtered := False;
          cdsVenda.Filter := 'AUTOINCREM = ' + IntToStr(intAutIncCalcMar);
          cdsVenda.Filtered := True;
        End;

        First;
        While (Not Eof) Do
        Begin
          pInformacao('Aguarde, Calculando total do produto (' + LeftStr(FieldByName('ITE_DESITE').AsString, 15) + '...)', pgbStatus);
          pProgresso(RecNo, RecordCount, pgbStatus);

          If fDesconsiderarItemPromocional() Then
          Begin
            Next;
            Continue;
          End;

          If (fIgnoraProdutoCortadoSemSaldo(FieldByName('AUTOINCREM').AsString)) Then
          Begin
            Next;
            Continue;
          End;

          If (fEhMargemMinimaDocumentoDesconsiderandoBrinde) And (fItemCdsBrinde(cdsVenda)) Then
          Begin
            Next;
            Continue;
          End;

          If objMargemLucro.cdsItensMargem.Locate('AUTOINCREM', FieldByName('AUTOINCREM').AsInteger, []) Then
            objMargemLucro.cdsItensMargem.Edit
          Else
            objMargemLucro.cdsItensMargem.Append;

          objMargemLucro.cdsItensMargem.FieldByName('ITE_SEQUEN').AsInteger := 1;

          pPrepararDataSetParaCalculoDaMargem(objMargemLucro.cdsItensMargem, cdsVenda, True, True, blnAplicaDescontos, fltTotalProdutosRateio, blnItemPromocaoEntraNoRateio, blnMostraMargem);

          objMargemLucro.cdsItensMargem.Post;

          Next;
        End;
      Finally
        If (intAutIncCalcMar <> -1) Then
        Begin
          cdsVenda.Filtered := False;
          cdsVenda.Filter := strFilter;
          cdsVenda.Filtered := blnFiltered;
        End;
      End;

    Except

      On E: ExceptionAutComSugerirVendaPresencial Do
      Begin

        If (Not blnAvisouSugerirVendaPresencial) Then
        Begin
          fMensagem('Atenção!', E.Message, ['&Ok']);
          blnAvisouSugerirVendaPresencial := True;
          Abort;
        End;

      End;

      On E: ExceptionAutCom Do
        pMensagemOk(E.Message);

      On E: Exception Do
        pMensagensErro(E.Message, '');

    End;

    pCalcularEPreencherMargemDataSet(objMargemLucro.cdsItensMargem);

    pEnableControls(cdsVenda, prcScroll);

    RecNo := intRecNo;

  End;

  Result := objMargemLucro.cdsItensMargem.Data;

end;

procedure TFatVendaBase.pAplicarRestricaoElementosMargem(cdsDados: TUniClientDataSet);
begin
  If fRestringirElementosMargem Then
  Begin
    If (strElementosMargem[1] = 'N') Then
      cdsDados.FieldByName('ITE_DESOPE').AsFloat := 0;

    If (strElementosMargem[2] = 'N') Then
      cdsDados.FieldByName('ITE_IMPFED').AsFloat := 0;

    If (strElementosMargem[3] = 'N') Then
      cdsDados.FieldByName('ITE_ICMCAL').AsFloat := 0;

    If (strElementosMargem[4] = 'N') Then
      cdsDados.FieldByName('ITE_OUTVAL').AsFloat := 0;

    If (strElementosMargem[5] = 'N') Then
    Begin
      cdsDados.FieldByName('ITE_VDIFAL').AsFloat := 0;
    End;

    If (strElementosMargem[6] = 'N') Then
    Begin
      cdsDados.FieldByName('ITE_VALFCP').AsFloat := 0;
    End;
  End;
end;

function TFatVendaBase.fRetornarAlqDifIcmsPrecoDinamicoParaCalMar(cdsVenda: TUniClientDataSet; blnLiquida: Boolean; const Item : TDadosFechamento): Double;
Var
  fltParIcmSai : Double;
begin
  fltParIcmSai := cdsVenda.FieldByName('ITE_ICMCAL').AsFloat;

  If (Not blnLiquida) Then
    fltParIcmSai := 0;

  Result := IIF(blnLiquida, fAlqDifIcmsPrecoDinamico(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, Item.strCodAbf, Item.strCodSit, fltParIcmSai),0) +
            IIF(blnLiquida, fAlqFcpIcmsPrecoDinamico(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, Item.strCodAbf, Item.strCodSit, fltParIcmSai, Item.fltUnitar),0);
end;

function TFatVendaBase.fRetornaPrecoCustoRealSub(fltParPrecoCusto,
  fltParPrecoVenda: Double; cdsVendaOri: TUniClientDataSet;
  blnItemEspecial: Boolean; cdsDados: TUniClientDataSet): Double;
Var
  calcCustoReal : TCalcCustoReal;
begin
  calcCustoReal := TCalcCustoReal.Create;
  Try
    calcCustoReal.fltUnitar := fltParPrecoVenda;
    calcCustoReal.fltPreCus := fltParPrecoCusto;
    calcCustoReal.fltOutVal := cdsDados.FieldByName('ITE_OUTVAL').AsFloat;
    calcCustoReal.fltIcmSai := cdsDados.FieldByName('ITE_ICMCAL').AsFloat;
    calcCustoReal.fltImpFed := cdsDados.FieldByName('ITE_IMPFED').AsFloat;
    calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(cdsDados.FieldByName('ITE_DESOPE').AsFloat);
    calcCustoReal.fltDifal  := cdsVendaOri.FieldByName('ITE_VDIFAL_MARGEM').AsFloat;
    calcCustoReal.fltFcp    := cdsDados.FieldByName('ITE_VALFCP').AsFloat;

    Result := fRetornaPrecoCusto(Preco_de_Custo_Real,
                                 cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                 cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                                 fltParPrecoCusto,
                                 '',
                                 calcCustoReal,
                                 blnItemEspecial);
  Finally
    FreeAndNil(calcCustoReal);
  End;
end;

procedure TFatVendaBase.pDefinirIcmsSTParteVendaECalculaSTMargemLucro(
  cdsDados: TUniClientDataSet; fltImcSTPV: Double; blnCalcST: Boolean);
begin
  If (Assigned(cdsDados.FindField('ITE_CALCST'))) Then
  Begin
    cdsDados.FieldByName('ITE_CALCST').AsBoolean := blnCalcST;
    cdsDados.FieldByName('ITE_ICMPAV').AsFloat   := fltImcSTPV;
  End;

  cdsDados.FieldByName('ITE_CALCST_MARGEM').AsBoolean := blnCalcST;
  cdsDados.FieldByName('ITE_ICMPAV_MARGEM').AsFloat   := fltImcSTPV;
end;

procedure TFatVendaBase.pDefinirImpostosCalculadosNaVendaIcmCal(cdsVenda: TUniClientDataSet);
var
  strMkpMar: String;
  strImpCf4: String;
  impSubIteEst: TImpostosSubItensEstrutura;
  fltIcmSai: Double;
  fltOutVal: Double;
  fltDesOpe: Double;
  fltImpFed: Double;
  strTabelaPreco : String;
  fltIcmsSaida   : Double;
  strEmpCfgIte : String;
begin
  strMkpMar := fMarMpkParaVenda(fCfgSis('MARMKP'));
  strImpCf4 := fCfgSis('IMPCF4');
  strEmpCfgIte := GetEmpCfg(cdsVenda.FieldByName('ITE_EMPITE').AsString);

  If Assigned(cdsVenda.FieldByName('ITE_TABPRE')) And (Not fEmptyStr(cdsVenda.FieldByName('ITE_TABPRE').AsString)) Then
    strTabelaPreco := cdsVenda.FieldByName('ITE_TABPRE').AsString
  Else
    strTabelaPreco := Self.strTabPre;

  If (strIMPCF4 = 'S')
    and (cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR')
    and (Not fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString))
    and (cdsVenda.FieldByName('ITE_PROACA').AsInteger <> 1) Then // COM OS IMPOSTOS CALCULADOS NA VENDA
  Begin
    If ((TFunctionFuncoesFaturamento.OptantePorSimplesNacional(strEmpCfgIte) = 'S') And (fCfgSis('ZERSIM', varString, strEmpCfgIte) = 'S')) Then
      cdsVenda.FieldByName('ITE_ICMCAL').AsFloat := 0
    Else
      cdsVenda.FieldByName('ITE_ICMCAL').AsFloat := fCalculaAliquota(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, cdsVenda.FieldByName('ITE_IMPDIR').AsString);

    If (strMkpMar = '4') And (Pos(cdsVenda.FieldByName('ITE_CODFIS_MARGEM').AsString, CST_SUBSTITUICAO) > 0) And (fDentroDoEstado(cdsVenda.FieldByName('ITE_EMPITE').AsString)) Then
    Begin

      pCarregaValoresCusto(cdsVenda.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString), strTabelaPreco);
      fltIcmsSaida := fIteGer(cdsVenda.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString)).FieldByName('ITE_ICMSAI').AsFloat;
      cdsVenda.FieldByName('ITE_ICMCAL').AsFloat := fRetIcmSai(fltIcmsSaida);

    End;

    If (cdsVenda.FieldByName('ITE_RICMPR').AsString = 'S') Then
    Begin
      cdsVenda.FieldByName('ITE_ICMCAL').AsFloat := fFormataFloat(cdsVenda.FieldByName('ITE_ICMCAL').AsFloat * fMultiplicadorReducaoRICMS(cdsVenda.FieldByName('ITE_PERRIC').AsFloat), 2);
    End;
  End
  Else if ((cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR')
    and (Not fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString))
    and (cdsVenda.FieldByName('ITE_PROACA').AsInteger <> 1)) then// COM OS IMPOSTOS DO CADASTRO DE PRODUTO
  Begin
    impSubIteEst.strCodIte := cdsVenda.FieldByName('ITE_CODITE').AsString;
    impSubIteEst.strEmpIte := cdsVenda.FieldByName('ITE_EMPITE').AsString;
    impSubIteEst.fltQtdPai := 1;
    impSubIteEst.fltUniPai := cdsVenda.FieldByName('ITE_UNITAR').AsFloat;

    If fUtilizaPrecoSubItensEstrutura(Pos('ITEM ESPECIAL', cdsVenda.FieldByName('ITE_DESITE').AsString) > 0, cdsVenda.FieldByName('ITE_CODITE').AsString) Then
    Begin
      pRetImpostosSubItensEstrutura(impSubIteEst);
      fltIcmSai := impSubIteEst.fltIcmSai;
      fltOutVal := impSubIteEst.fltOutVal;
      fltDesOpe := impSubIteEst.fltDesOpe;
      fltImpFed := impSubIteEst.fltImpFed;
    End
    Else
    Begin

      pRetImpostosItem(cdsVenda.FieldByName('ITE_CODITE').AsString,
                       fltIcmSai,
                       fltOutVal,
                       fltDesOpe,
                       fltImpFed,
                       cdsIteGer,
                       strTabelaPreco,
                       IIF(fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal(), VS_strCodEmp, cdsVenda.FieldByName('ITE_EMPITE').AsString));
    End;

    cdsVenda.FieldByName('ITE_ICMCAL').AsFloat   := fltIcmSai;
  End
  Else
  Begin
    cdsVenda.FieldByName('ITE_ICMCAL').AsFloat   := cdsVenda.FieldByName('ITE_ICMSAI').AsFloat;
  end;
end;

procedure TFatVendaBase.pDefinirImpostosCalculadosNaVendaOuDoProdutoParaMargemDeLucro(cdsDados, cdsVendaOri: TUniClientDataSet);
var
  strMkpMar: String;
  impSubIteEst: TImpostosSubItensEstrutura;
  fltIcmSai: Double;
  fltOutVal: Double;
  fltDesOpe: Double;
  fltImpFed: Double;
  strTabelaPreco : String;
begin
  strMkpMar := fMarMpkParaVenda(fCfgSis('MARMKP'));

  cdsDados.FieldByName('ITE_ICMCAL').AsFloat  := cdsVendaOri.FieldByName('ITE_ICMCAL').AsFloat;

  If (fCfgSis('IMPCF4', varString) = 'S')
    and (cdsVendaOri.FieldByName('ITE_IDEPRO').AsString = 'NOR')
    and (Not fEhItemVendaVidro(cdsVendaOri.FieldByName('ITE_CODITE').AsString))
    and (cdsVendaOri.FieldByName('ITE_PROACA').AsInteger <> 1) Then // COM OS IMPOSTOS CALCULADOS NA VENDA
  Begin
    cdsDados.FieldByName('ITE_COMTBL').AsFloat  := cdsVendaOri.FieldByName('ITE_COMTBL').AsFloat;
    cdsDados.FieldByName('ITE_IMPFED').AsFloat  := cdsVendaOri.FieldByName('ITE_IMPFED').AsFloat;
    cdsDados.FieldByName('ITE_OUTVAL').AsFloat  := cdsVendaOri.FieldByName('ITE_OUTVAL').AsFloat;
    cdsDados.FieldByName('ITE_DESOPE').AsFloat  := cdsVendaOri.FieldByName('ITE_DESOPE').AsFloat;

    cdsDados.FieldByName('ITE_ICMSAI').AsFloat  := IIF( (TFunctionFuncoesFaturamento.OptantePorSimplesNacional(GetEmpCfg(cdsVendaOri.FieldByName('ITE_EMPITE').AsString)) = 'S') And (fCfgSis('ZERSIM', varString, GetEmpCfg(cdsVendaOri.FieldByName('ITE_EMPITE').AsString)) = 'S'), 0,  cdsVendaOri.FieldByName('ITE_ICMSAI').AsFloat); //ITE_ICMSAI_MARGEM

    If (cdsVendaOri.FieldByName('ITE_RICMPR').AsString = 'S') Then
    Begin
      cdsDados.FieldByName('ITE_ICMSAI').AsFloat := fFormataFloat(cdsDados.FieldByName('ITE_ICMSAI').AsFloat * fMultiplicadorReducaoRICMS(cdsVendaOri.FieldByName('ITE_PERRIC').AsFloat), 2);
    End;
  End
  Else if ((cdsVendaOri.FieldByName('ITE_IDEPRO').AsString = 'NOR')
    and (Not fEhItemVendaVidro(cdsVendaOri.FieldByName('ITE_CODITE').AsString))
    and (cdsVendaOri.FieldByName('ITE_PROACA').AsInteger <> 1)) then// COM OS IMPOSTOS DO CADASTRO DE PRODUTO
  Begin
    impSubIteEst.strCodIte := cdsVendaOri.FieldByName('ITE_CODITE').AsString;
    impSubIteEst.strEmpIte := cdsVendaOri.FieldByName('ITE_EMPITE').AsString;
    impSubIteEst.fltQtdPai := 1;
    impSubIteEst.fltUniPai := cdsDados.FieldByName('ITE_UNITAR').AsFloat;

    If fUtilizaPrecoSubItensEstrutura(Pos('ITEM ESPECIAL', cdsVendaOri.FieldByName('ITE_DESITE').AsString) > 0, cdsVendaOri.FieldByName('ITE_CODITE').AsString) Then
    Begin
      pRetImpostosSubItensEstrutura(impSubIteEst);
      fltIcmSai := impSubIteEst.fltIcmSai;
      fltOutVal := impSubIteEst.fltOutVal;
      fltDesOpe := impSubIteEst.fltDesOpe;
      fltImpFed := impSubIteEst.fltImpFed;
    End
    Else
    Begin

      If Assigned(cdsVendaOri.FieldByName('ITE_TABPRE')) And (Not fEmptyStr(cdsVendaOri.FieldByName('ITE_TABPRE').AsString)) Then
        strTabelaPreco := cdsVendaOri.FieldByName('ITE_TABPRE').AsString
      Else
        strTabelaPreco := Self.strTabPre;

      pRetImpostosItem(cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                       fltIcmSai,
                       fltOutVal,
                       fltDesOpe,
                       fltImpFed,
                       cdsIteGer,
                       strTabelaPreco,
                       IIF(fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal(), VS_strCodEmp, cdsVendaOri.FieldByName('ITE_EMPITE').AsString));
    End;

    If (fCfgSis('PCMPRO') <> '3') {$IFNDEF LINUX} And (Not fMostraMargemUtilizaCOMTBX()){$ENDIF} Then
      cdsDados.FieldByName('ITE_COMTBL').AsFloat  := 0
    Else
      cdsDados.FieldByName('ITE_COMTBL').AsFloat := cdsVendaOri.FieldByName('ITE_COMTBL').Asfloat;

    cdsDados.FieldByName('ITE_ICMSAI').AsFloat   := fltIcmSai;
    cdsDados.FieldByName('ITE_OUTVAL').AsFloat   := fltOutVal;
    cdsDados.FieldByName('ITE_DESOPE').AsFloat   := fltDesOpe;
    cdsDados.FieldByName('ITE_IMPFED').AsFloat   := fltImpFed;
    cdsDados.FieldByName('ITE_ICMCAL').AsFloat   := fltIcmSai;
  End
  Else
  Begin
    cdsDados.FieldByName('ITE_COMTBL').AsFloat   := cdsVendaOri.FieldByName('ITE_COMTBL').AsFloat;
    cdsDados.FieldByName('ITE_ICMSAI').AsFloat   := cdsVendaOri.FieldByName('ITE_ICMSAI').AsFloat;
    cdsDados.FieldByName('ITE_OUTVAL').AsFloat   := cdsVendaOri.FieldByName('ITE_OUTVAL').AsFloat;
    cdsDados.FieldByName('ITE_DESOPE').AsFloat   := cdsVendaOri.FieldByName('ITE_DESOPE').AsFloat;
    cdsDados.FieldByName('ITE_IMPFED').AsFloat   := cdsVendaOri.FieldByName('ITE_IMPFED').AsFloat;
//    cdsDados.FieldByName('ITE_ICMCAL').AsFloat   := cdsDados.FieldByName('ITE_ICMSAI').AsFloat;
  end;

  cdsDados.FieldByName('ITE_OUTVAL').AsFloat := Self.fOutrosValoresParaMargem(cdsVendaOri.FieldByName('ITE_COMTBL').AsFloat,
                                                                              cdsDados.FieldByName('ITE_UNITAR').AsFloat,
                                                                              cdsDados.FieldByName('ITE_OUTVAL').AsFloat,
                                                                              cdsVendaOri.FieldByName('ITE_OUTVAL').AsFloat,
                                                                              VS_intDecUni);

  If ((fCfgSis('PCMPRO') = 3) And (fCfgSis('MARIDE', varString) = 'N')) Then
     cdsDados.FieldByName('ITE_COMTBL').AsFloat := 0;

end;

procedure TFatVendaBase.pDefinirMargemIdealDoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet);
begin
  If (cdsDados.FindField('ITE_MARIDE') <> Nil) Then
  Begin
    If Not fEmptyStr(cdsVendaOri.FieldByName('ITE_TABPRE').AsString) Then
      cdsDados.FieldByName('ITE_MARIDE').AsFloat := fIteGer(cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                                            fGetEmpCalculoItem(cdsVendaOri.FieldByName('ITE_EMPITE').AsString))
                                                            .FieldByName('ITE_MARID' + cdsVendaOri.FieldByName('ITE_TABPRE').AsString).AsFloat
    Else
      cdsDados.FieldByName('ITE_MARIDE').AsFloat := 0;
  End;
end;

procedure TFatVendaBase.pDefinirPrecoIdealDoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet; fltImcSTPV: Double; blnCalcST: Boolean);
var
  fltCalTmp: Double;
begin
  If (cdsDados.FindField('ITE_PREIDE') <> Nil) Then
  Begin
    if (fCfgSis('IMPCF4', varString) = 'S') and (cdsVendaOri.FieldByName('ITE_IDEPRO').AsString = 'NOR') then
      fltCalTmp := fCalculaAliquota(cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                    cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                                    cdsVendaOri.FieldByName('ITE_IMPDIR').AsString)
    else
      fltCalTmp := cdsDados.FieldByName('ITE_ICMSAI').AsFloat;

      cdsDados.FieldByName('ITE_PREIDE').AsFloat :=
        fCalculaPrecoVenda(1,
          cdsDados.FieldByName('ITE_CUSITE').AsFloat,
          0,
          cdsDados.FieldByName('ITE_MARIDE').AsFloat,
          fltCalTmp + fAlqDifIcmsPrecoDinamico(cdsVendaOri.FieldByName('ITE_CODITE').AsString, cdsVendaOri.FieldByName('ITE_EMPITE').AsString, cdsVendaOri.FieldByName('ITE_CODABF_MARGEM').AsString, cdsVendaOri.FieldByName('ITE_CODFIS_MARGEM').AsString, fltCalTmp) +
                      fAlqFcpIcmsPrecoDinamico(cdsVendaOri.FieldByName('ITE_CODITE').AsString, cdsVendaOri.FieldByName('ITE_EMPITE').AsString, cdsVendaOri.FieldByName('ITE_CODABF_MARGEM').AsString, cdsVendaOri.FieldByName('ITE_CODFIS_MARGEM').AsString, fltCalTmp, cdsDados.FieldByName('ITE_CUSITE').AsFloat),
          cdsDados.FieldByName('ITE_IMPFED').AsFloat,
          fProcessarDespesasOperacionaisComplementar(cdsDados.FieldByName('ITE_DESOPE').AsFloat),
          0,
          fMarMpkParaVenda,
          '',
          -1,
          fltImcSTPV,
          blnCalcST,
          0, 0,
          cdsDados.FieldByName('ITE_OUTVAL').AsFloat,
          fRestringirElementosMargem);

    cdsDados.FieldByName('ITE_ICMSAI_PREIDE').AsFloat := fltCalTmp;
  End;
end;

procedure TFatVendaBase.pDefinirPrecoMedioLiquidoEPrecoDeUltimaCompraLiquidoDoItemMargemLucro(
  cdsDados, cdsVendaOri: TUniClientDataSet; blnItemEspecial: Boolean);
var
  strMkpMar: String;
begin
  strMkpMar := fMarMpkParaVenda(fCfgSis('MARMKP'));
  cdsDados.FieldByName('ITE_PREMED').AsFloat  := cdsVendaOri.FieldByName('ITE_PREMED').AsFloat;

  cdsDados.FieldByName('ITE_PREMED_LIQ').AsFloat := fRetornaPrecoCustoRealSub(cdsDados.FieldByName('ITE_PREMED').AsFloat, cdsDados.FieldByName('ITE_UNITAR').AsFloat, cdsVendaOri, blnItemEspecial, cdsDados);
  cdsDados.FieldByName('ITE_PREULT_LIQ').AsFloat := fRetornaPrecoCustoRealSub(cdsDados.FieldByName('ITE_PREULT').AsFloat, cdsDados.FieldByName('ITE_UNITAR').AsFloat, cdsVendaOri, blnItemEspecial, cdsDados);

  If (strMkpMar = '5') Then
    cdsDados.FieldByName('ITE_MEDPRA').AsFloat := cdsDados.FieldByName('ITE_PREMED_LIQ').AsFloat
  Else
    cdsDados.FieldByName('ITE_MEDPRA').AsFloat := cdsDados.FieldByName('ITE_PREMED').AsFloat;
end;

procedure TFatVendaBase.pDefinirPrecoCustoDoItemMargemLucro(cdsDados, cdsVendaOri: TUniClientDataSet; fltImcSTPV: Double; blnCalcST: Boolean; blnItemEspecial: Boolean; blnPegaPrecoCusto: Boolean);
var
  calcCustoReal: TCalcCustoReal;
  strMkpMar: String;
  fltOutValProduto : Double;
begin
  strMkpMar := fMarMpkParaVenda(fCfgSis('MARMKP'));
  calcCustoReal := TCalcCustoReal.Create;
  calcCustoReal.fltUnitar := cdsDados.FieldByName('ITE_UNIORI').AsFloat;
  calcCustoReal.fltPreCus := cdsDados.FieldByName('ITE_CUSITE').AsFloat;
  If (Self.fCalcularOutrosValoresComBaseNoValorOriginal) Then
  Begin
    fltOutValProduto := fIteGer(cdsVendaOri.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(cdsVendaOri.FieldByName('ITE_EMPITE').AsString)).FieldByName('ITE_OUTVAL').AsFloat;
    calcCustoReal.fltOutVal :=  fFormataFloat(cdsVendaOri.FieldByName('ITE_COMTBL').AsFloat * fltUniOri / 100, VS_intDecUni) + fltOutValProduto;
  End
  Else
    calcCustoReal.fltOutVal := cdsDados.FieldByName('ITE_OUTVAL').AsFloat;
  calcCustoReal.fltIcmSai := cdsDados.FieldByName('ITE_ICMCAL').AsFloat;
  calcCustoReal.fltIcmPav := fltImcSTPV;
  calcCustoReal.blnCalcST := blnCalcST;
  calcCustoReal.fltImpFed := cdsDados.FieldByName('ITE_IMPFED').AsFloat;
  calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(cdsDados.FieldByName('ITE_DESOPE').AsFloat);
  calcCustoReal.fltDifal  := cdsVendaOri.FieldByName('ITE_VDIFAL_MARGEM').AsFloat;
  calcCustoReal.fltFrete  := cdsDados.FieldByName('ITE_UNIFRE').AsFloat;

  If ((cdsVendaOri.FieldByName('ITE_BASICM').AsFloat <> 0) Or (AnsiRightStr(strClaFis, 3) = '922') Or blnCarregaPedidoOrcamentoEntFut) Then
    calcCustoReal.fltFcp := cdsVendaOri.FieldByName('ITE_VALFCP_MARGEM').AsFloat;

  cdsDados.FieldByName('ITE_PRECU2').AsFloat :=
    fRetornaPrecoCusto(Preco_de_Custo_Real,
                       cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                       cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                       cdsDados.FieldByName('ITE_CUSITE').AsFloat,
                       '',
                       calcCustoReal,
                       blnItemEspecial);

  calcCustoReal.fltUnitar := cdsDados.FieldByName('ITE_UNITAR').AsFloat;
  calcCustoReal.fltPreCus := cdsDados.FieldByName('ITE_CUSITE').AsFloat;
  calcCustoReal.fltOutVal := cdsDados.FieldByName('ITE_OUTVAL').AsFloat;
  calcCustoReal.fltIcmSai := cdsDados.FieldByName('ITE_ICMCAL').AsFloat;
  calcCustoReal.fltIcmPav := fltImcSTPV;
  calcCustoReal.blnCalcST := blnCalcST;
  calcCustoReal.fltImpFed := cdsDados.FieldByName('ITE_IMPFED').AsFloat;
  calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(cdsDados.FieldByName('ITE_DESOPE').AsFloat);
  calcCustoReal.fltDifal  := cdsVendaOri.FieldByName('ITE_VDIFAL_MARGEM').AsFloat;
  calcCustoReal.fltFrete  := cdsDados.FieldByName('ITE_UNIFRE').AsFloat;

  If ((cdsVendaOri.FieldByName('ITE_BASICM').AsFloat <> 0) Or (AnsiRightStr(strClaFis, 3) = '922') Or blnCarregaPedidoOrcamentoEntFut) Then
    calcCustoReal.fltFcp := cdsVendaOri.FieldByName('ITE_VALFCP_MARGEM').AsFloat;

  If blnPegaPrecoCusto Then // VINDO DA VENDA
  Begin
    cdsDados.FieldByName('ITE_PRECUS').AsFloat :=
      fRetornaPrecoCusto(Preco_de_Custo_Real,
                         cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                         cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                         cdsDados.FieldByName('ITE_CUSITE').AsFloat,
                         '',
                         calcCustoReal,
                         blnItemEspecial);

    If (strMkpMar = '5') Then
      cdsDados.FieldByName('ITE_CUSPRA').AsFloat := fFormataFloat(cdsDados.FieldByName('ITE_PRECUS').AsFloat, VS_intDecUni)
    Else
      cdsDados.FieldByName('ITE_CUSPRA').AsFloat := cdsDados.FieldByName('ITE_CUSITE').AsFloat;

    If calcCustoReal.fltFrete > 0 Then
      cdsDados.FieldByName('ITE_CUSREA').AsFloat := cdsDados.FieldByName('ITE_PRECUS').AsFloat;
  End
  Else
  Begin
    If cdsDados.FieldByName('ITE_PRECUS').AsFloat <>
      fRetornaPrecoCusto(Preco_de_Custo_Real,
                         cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                         cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                         cdsDados.FieldByName('ITE_CUSITE').AsFloat,
                         '',
                         calcCustoReal,
                         blnItemEspecial) Then
      // CALCULA O CUSTO PRATICADO SEM IMPOSTOS
      cdsDados.FieldByName('ITE_CUSPRA').AsFloat := fCalculaCustoBruto(cdsDados.FieldByName('ITE_UNITAR').AsFloat,
                                                                       cdsDados.FieldByName('ITE_PRECUS').AsFloat,
                                                                       cdsDados.FieldByName('ITE_OUTVAL').AsFloat,
                                                                       cdsDados.FieldByName('ITE_ICMCAL').AsFloat,
                                                                       cdsDados.FieldByName('ITE_IMPFED').AsFloat,
                                                                       fProcessarDespesasOperacionaisComplementar(cdsDados.FieldByName('ITE_DESOPE').AsFloat))
    Else
      cdsDados.FieldByName('ITE_CUSPRA').AsFloat := cdsDados.FieldByName('ITE_CUSITE').AsFloat;
  End;

  calcCustoReal.blnCalcSt := False;
  calcCustoReal.fltIcmPav := 0;
  calcCustoReal.fltUnitar := cdsDados.FieldByName('ITE_UNITAR').AsFloat;
  calcCustoReal.fltPreCus := cdsVendaOri.FieldByName('ITE_IMPULT').AsFloat;
  calcCustoReal.fltOutVal := IIF(fCfgSis('EXIIMP', VarString) = '1', cdsDados.FieldByName('ITE_OUTVAL').AsFloat, 0);
  calcCustoReal.fltIcmSai := IIF(fCfgSis('EXIIMP', VarString) = '1', cdsDados.FieldByName('ITE_ICMCAL').AsFloat, 0);
  calcCustoReal.fltImpFed := IIF(fCfgSis('EXIIMP', VarString) = '1', cdsDados.FieldByName('ITE_IMPFED').AsFloat, 0);
  calcCustoReal.fltDesOpe := IIF(fCfgSis('EXIIMP', VarString) = '1', fProcessarDespesasOperacionaisComplementar(cdsDados.FieldByName('ITE_DESOPE').AsFloat), 0);
  calcCustoReal.fltDifal  := IIF(fCfgSis('EXIIMP', VarString) = '1', cdsVendaOri.FieldByName('ITE_VDIFAL_MARGEM').AsFloat, 0);
  calcCustoReal.fltFrete  := 0;

  If ((cdsVendaOri.FieldByName('ITE_BASICM').AsFloat <> 0) Or (AnsiRightStr(strClaFis, 3) = '922') Or blnCarregaPedidoOrcamentoEntFut) Then
    calcCustoReal.fltFcp := IIF(fCfgSis('EXIIMP', VarString) = '1', cdsVendaOri.FieldByName('ITE_VALFCP_MARGEM').AsFloat, 0);

    //ITE_IMPULT + Impostos de Saidas
  cdsDados.FieldByName('ITE_CUSIMP').AsFloat :=
      fRetornaPrecoCusto(Preco_de_Custo_Real,
                         cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                         cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                         cdsVendaOri.FieldByName('ITE_IMPULT').AsFloat,
                         '',
                         calcCustoReal,
                         blnItemEspecial);

  If (strMkpMar = '5') Then
    cdsDados.FieldByName('ITE_IMPULTPRA').AsFloat := cdsDados.FieldByName('ITE_CUSIMP').AsFloat
  Else
    cdsDados.FieldByName('ITE_IMPULTPRA').AsFloat := cdsDados.FieldByName('ITE_IMPULT').AsFloat;

  FreeAndNil(calcCustoReal);
end;

procedure TFatVendaBase.pDefinirPrecoDeUltimaCompraDoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet);
begin
  // PREÇO DE ÚLTIMA COMPRA
  If (cdsDados.FieldByName('ITE_IDEPRO').AsString = 'NOR') And
     (Not fEhItemVendaVidro(cdsVendaOri.FieldByName('ITE_CODITE').AsString)) Then
    cdsDados.FieldByName('ITE_PREULT').AsFloat := fIteGer(cdsVendaOri.FieldByName('ITE_CODITE').AsString, VS_strCodEmp).FieldByName('ITE_PREULT').AsFloat
  Else
    cdsDados.FieldByName('ITE_PREULT').AsFloat := cdsVendaOri.FieldByName('ITE_PREULT').AsFloat;
end;

procedure TFatVendaBase.pDefinirValorUnitarioOriginalDoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet);
var
  strPromocSav: String;
  strTabelaPreco: String;

  function fRetPreVenOri: Double;
  begin
    Result := 0;

    If (cdsVendaOri.FindField('ITE_PREVE' + strTabelaPreco) <> Nil) Then
    Begin
      Result := cdsVendaOri.FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat;
    End;

    If (Result = 0) Then
    Begin
      Case StrToIntDef(strTabelaPreco, 1) of
        1: Result := Self.fltPreVe1;
        2: Result := Self.fltPreVe2;
        3: Result := Self.fltPreVe3;
        4: Result := Self.fltPreVe4;
        5: Result := Self.fltPreVe5;
        6: Result := Self.fltPreVe6;
        7: Result := Self.fltPreVe7;
      End;
    End;

    If (Result = 0) Then
    Begin
      Result := fIteGer(cdsVendaOri.FieldByName('ITE_CODITE').AsString, IIF(blnEnt_CD, strEmp_CD, VS_strCodEmp)).FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat;
    End;
  end;

begin
  if fEmptyStr(cdsVendaOri.FieldByName('ITE_TABPRE').AsString) Then
    strTabelaPreco := Self.strTabPre
  else
    strTabelaPreco := cdsVendaOri.FieldByName('ITE_TABPRE').AsString;

  If fEmptyStr(strTabelaPreco) Then
    strTabelaPreco := '1';

  If fUtilizaPrecoEmbalagemFechadaComoMinimo(cdsVendaOri.FieldByName('ITE_IDEPRO').AsString,
                                             cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                             cdsVendaOri.FieldByName('ITE_TABPRE').AsString,
                                             cdsVendaOri.FieldByName('ITE_PROMOC').AsString,
                                             cdsVendaOri.FieldByName('ITE_QTDITE').AsFloat) Then
  Begin
    cdsDados.FieldByName('ITE_UNIORI').AsFloat := fGetUnitarioEmbalagemFechada(cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                                                               cdsVendaOri.FieldByName('ITE_TABPRE').AsString,
                                                                               cdsVendaOri.FieldByName('ITE_QTDITE').AsFloat,
                                                                               cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat);
    cdsDados.FieldByName('ITE_PREORI').AsFloat := cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat;
  End
  Else If fUtilizaPrecoTabelaTravaProdutoEmbalagem(cdsVendaOri.FieldByName('ITE_IDEPRO').AsString,
                                                   cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                                   cdsVendaOri.FieldByName('ITE_BAREMB').AsString) Then
  Begin
    strPromocSav := Self.strPromoc;
    Self.strPromoc := cdsVendaOri.FieldByName('ITE_PROMOC').AsString;
    cdsDados.FieldByName('ITE_UNIORI').AsFloat := fPegaPrecoVenda(cdsVendaOri,
                                                                  cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                                                                  cdsVendaOri.FieldByName('ITE_ENTSAI').AsString,
                                                                  fltMargem,
                                                                  (Pos('ITEM ESPECIAL', cdsVendaOri.FieldByName('ITE_DESITE').AsString) > 0),
                                                                  'NOR',
                                                                  cdsVendaOri.FieldByName('ITE_TABPRE').AsString,
                                                                  True,
                                                                  FTaxJur,
                                                                  FUniVis);
    cdsDados.FieldByName('ITE_PREORI').AsFloat := cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat;
    Self.strPromoc := strPromocSav;
  End
  Else
  Begin
    cdsDados.FieldByName('ITE_UNIORI').AsFloat := cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat;

    if (cdsVendaOri.FieldByName('ITE_PROMOC').AsString = 'S') then
      cdsDados.FieldByName('ITE_PREORI').AsFloat := cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat
    else
    begin
      If (cdsVendaOri.FindField('ITE_PREVE' + strTabelaPreco) <> Nil) Then
        cdsDados.FieldByName('ITE_PREORI').AsFloat := fRetPreVenOri
      Else
        cdsDados.FieldByName('ITE_PREORI').AsFloat := cdsVendaOri.FieldByName('ITE_PREORI').AsFloat
    end;
  End;

  If (cdsVendaOri.FindField('ITE_PREVE' + strTabelaPreco) <> Nil) Then
    cdsDados.FieldByName('ITE_PRETAB').AsFloat := fRetPreVenOri
  Else
    cdsDados.FieldByName('ITE_PRETAB').AsFloat := cdsVendaOri.FieldByName('ITE_PREORI').AsFloat
end;

procedure TFatVendaBase.pDefinirValorDoFCPdoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet);
begin
  If ((cdsVendaOri.FieldByName('ITE_BASICM').AsFloat <> 0) Or (AnsiRightStr(strClaFis, 3) = '922') Or blnCarregaPedidoOrcamentoEntFut) Then
    cdsDados.FieldByName('ITE_VALFCP').AsFloat := cdsVendaOri.FieldByName('ITE_VALFCP_MARGEM').AsFloat
  Else
    cdsDados.FieldByName('ITE_VALFCP').AsFloat := 0;
end;

procedure TFatVendaBase.pDefinirCustoCAT17MargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet);
var
  strNotC17: String;
begin
  If (cdsDados.FindField('ITE_CUSCAT') <> Nil) And (Pos(fCfgSis('MCAT17'),'S_D_A_C_M_V_') > 0) Then
  Begin
    If (fCfgSis('MCAT17') = 'S') Then
    Begin
      cdsDados.FieldByName('ITE_CUSCAT').AsFloat := fRetornaPrecoCustoDeduzindoRessarcimentoCAT(
                                                                     cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                                                     cdsVendaOri.FieldByName('ITE_EMPITE').AsString,
                                                                     cdsVendaOri.FieldByName('ITE_CODABF_MARGEM').AsString,
                                                                     cdsVendaOri.FieldByName('ITE_CODFOR').AsString,
                                                                     cdsDados.FieldByName('ITE_CUSITE').AsFloat,
                                                                     strNotC17);

      //Se nao houve dedução do CAT
      If fFormataFloat(cdsDados.FieldByName('ITE_CUSCAT').AsFloat, VS_intDecUni) = fFormataFloat(cdsDados.FieldByName('ITE_CUSITE').AsFloat, VS_intDecUni) Then
        cdsDados.FieldByName('ITE_CUSCAT').AsFloat := 0;
    End
    Else
      cdsDados.FieldByName('ITE_CUSCAT').AsFloat := cdsDados.FieldByName('ITE_CUSITE').AsFloat;
  End;
end;

procedure TFatVendaBase.pDefinirAliquotasParaOCalculoDaMargemDeLucro(cdsVenda: TUniClientDataSet; const Item : TDadosFechamento);
begin
  cdsVenda.FieldByName('ITE_VDIFAL_MARGEM').AsFloat   := fGetAlqDifal(Item.strCodIte, Item.strEmpIte, Item.strCodAbf, Item.strCodFis);
  cdsVenda.FieldByName('ITE_CODFIS_MARGEM').AsString  := Item.strCodFis;
  cdsVenda.FieldByName('ITE_CODABF_MARGEM').AsString  := Item.strCodAbf;
  cdsVenda.FieldByName('ITE_UTILIZA_PRECO_EM_DOLAR_MARGEM').AsBoolean := fItemUtilizaPrecoEmDolar(cdsVenda.FieldByName('ITE_CODITE').AsString);

  pDefinirImpostosCalculadosNaVendaIcmCal(cdsVenda);

  cdsVenda.FieldByName('ITE_CALMAR_PREDIN_MAR_MARGEM').AsFloat    := fRetornarAlqDifIcmsPrecoDinamicoParaCalMar(cdsVenda, True, Item);
  cdsVenda.FieldByName('ITE_CALMAR_PREDIN_MARLIQ_MARGEM').AsFloat := fRetornarAlqDifIcmsPrecoDinamicoParaCalMar(cdsVenda, False, Item);

  If (Item.VisualizarFcpIcms.fltValor > 0) And
     ((cdsVenda.FieldByName('ITE_BASICM').AsFloat <> 0) Or (AnsiRightStr(strClaFis, 3) = '922') Or blnCarregaPedidoOrcamentoEntFut) Then
  Begin
    cdsVenda.FieldByName('ITE_VALFCP_MARGEM').AsFloat := fGetAlqFcpIcms(Item);
  End
  Else
  Begin
    cdsVenda.FieldByName('ITE_VALFCP_MARGEM').AsFloat := 0;
  End;

  cdsVenda.FieldByName('ITE_ALQDIF_ICMS_MARGEM').AsFloat :=
    fAlqDifIcmsPrecoDinamico(
      Item.strCodIte
    , Item.strEmpIte
    , Item.strCodAbf
    , Item.strCodFis
    , cdsVenda.FieldByName('ITE_ICMCAL').AsFloat) +
    fAlqFcpIcmsPrecoDinamico(
      Item.strCodIte
    , Item.strEmpIte
    , Item.strCodAbf
    , Item.strCodFis
    , cdsVenda.FieldByName('ITE_ICMSAI').AsFloat
    , Item.fltUniTar);

  cdsVenda.FieldByName('ITE_ALQDIF_ICMS_MARGEM_IMPOSTOS').AsFloat :=
    fAlqDifIcmsPrecoDinamico(
      Item.strCodIte
    , Item.strEmpIte
    , Item.strCodAbf
    , Item.strCodFis
    , IIF(fCfgSis('EXIIMP', VarString) = '1', cdsVenda.FieldByName('ITE_ICMCAL').AsFloat, 0)) +
    fAlqFcpIcmsPrecoDinamico(
      Item.strCodIte
    , Item.strEmpIte
    , Item.strCodAbf
    , Item.strCodFis
    , IIF(fCfgSis('EXIIMP', VarString) = '1', cdsVenda.FieldByName('ITE_ICMCAL').AsFloat, 0)
    , Item.fltUniTar);

end;

procedure TFatVendaBase.pDefinirCustoDoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet);
begin
  cdsDados.FieldByName('SELECIONADO').AsString := 'S';
  cdsDados.FieldByName('ITE_ORDITE').AsInteger := cdsVendaOri.FieldByName('ITE_ORDITE').AsInteger;
  cdsDados.FieldByName('ITE_CUSITE').AsFloat  := cdsVendaOri.FieldByName('ITE_CUSITE').AsFloat;

  If Assigned(cdsDados.FieldByName('ITE_IDEPRO')) Then
    If fEmptyStr(cdsDados.FieldByName('ITE_IDEPRO').AsString) Then
      cdsDados.FieldByName('ITE_IDEPRO').AsString := cdsVendaOri.FieldByName('ITE_IDEPRO').AsString;

  //Caso configurado para somar a taxa de juros no preco de custo (Cofert)
  If fCfgSis('JURCUS', VarBoolean) Then
    cdsDados.FieldByName('ITE_CUSITE').AsFloat := cdsDados.FieldByName('ITE_CUSITE').AsFloat * (1 + cdsVendaOri.FieldByName('ITE_TAXJUR').AsFloat / 100);
end;

procedure TFatVendaBase.pDefinirValorUnitarioEValorTotalDoItemMargemLucro(cdsDados,
  cdsVendaOri: TUniClientDataSet; blnPegaUnitario, blnAplicaDescontos,
  blnItemPromocaoEntraNoRateio: Boolean; fltTotalProdutosRateio: Double);
var
  blnItemEntraNoRateio: Boolean;
  fltDesCndAux: Double;
  blnPorDesAplicado : Boolean;
  blnDesCndAplicado : Boolean;

  function fPodeEntrarNoRateio(aStrCodPro: String): Boolean;
  begin
    Result := True;

    If (fCfgSis('TRAPRO', varString) = 'C') Then
      Result := Not fTravarPeloPrecoPromocao(aStrCodPro);
  end;

  function fItemCarregadoJuntoPDouOR: Boolean;
  begin
    Result := (Length(cdsVendaOri.FieldByName('ITE_SEQDET').AsString) = 20) And
              (Not fEmptyStr(cdsVendaOri.FieldByName('ITE_NUMORC').AsString)) And
              (Not fEmptyStr(cdsVendaOri.FieldByName('ITE_ESPORC').AsString)) And
              (Not fEmptyStr(cdsVendaOri.FieldByName('ITE_EMPORC').AsString));
  end;

begin
  If blnPegaUnitario Then
  Begin
    cdsDados.FieldByName('ITE_UNIDIG').AsFloat  := cdsVendaOri.FieldByName('ITE_UNIDIG').AsFloat;
    cdsDados.FieldByName('ITE_TAXJUR').AsFloat  := cdsVendaOri.FieldByName('ITE_TAXJUR').AsFloat;
    cdsDados.FieldByName('ITE_UNITAR').AsFloat  := cdsVendaOri.FieldByName('ITE_UNITAR').AsFloat;
    cdsDados.FieldByName('ITE_TOTITE').AsFloat  := cdsVendaOri.FieldByName('ITE_TOTITE').AsFloat;
  End;

  If blnPegaUnitario And blnAplicaDescontos Then
  Begin
    If ((cdsVendaOri.FieldByName('ITE_PROMOC').AsString <> 'S') Or fPermiteDescontoPromocao(cdsVendaOri.FieldByName('ITE_CODPRO').AsString, tapcdePromocaoCorrente, fItemCarregadoJuntoPDouOR)) Then
    begin
      blnPorDesAplicado := fDescontoPorDesAplicado(cdsDados.FieldByName('ITE_UNITAR').AsFloat,
                                                  cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat,
                                                  cdsVendaOri.FieldByName('ITE_UNIDIG').AsFloat,
                                                  cdsVendaOri.FieldByName('ITE_DESCON').AsFloat,
                                                  fGetTaxVprItem(cdsVendaOri.FieldByName('ITE_CODITE').AsString, cdsVendaOri.FieldByName('ITE_EMPITE').AsString));

      blnDesCndAplicado := True;
      fltDesCndAux := 0;
      If (fCfgSis('CNDVEN') = 'F') Then
      Begin
        If (fltDMVCnd > 0) And (strCAbDes = 'S') Then
          fltDesCndAux := fltDMVCnd
        Else If (cdsVendaOri.FindField('ITE_DESCND') <> Nil) And (cdsVendaOri.FieldByName('ITE_DESCND').Value > 0) Then
          fltDesCndAux := cdsVendaOri.FieldByName('ITE_DESCND').Value;

        If (fltDesCndAux > 0) Then
        Begin
          blnDesCndAplicado := fDescontoDesCndAplicado(cdsDados.FieldByName('ITE_UNITAR').AsFloat,
                                                       cdsVendaOri.FieldByName('ITE_UNIORI').AsFloat,
                                                       cdsVendaOri.FieldByName('ITE_UNIDIG').AsFloat,
                                                       cdsVendaOri.FieldByName('ITE_DESCON').AsFloat,
                                                       fltDesCndAux,
                                                       fGetTaxVprItem(cdsVendaOri.FieldByName('ITE_CODITE').AsString, cdsVendaOri.FieldByName('ITE_EMPITE').AsString));
        End;
      End;

      If (Not blnPorDesAplicado) Then
        cdsDados.FieldByName('ITE_UNITAR').AsFloat := cdsDados.FieldByName('ITE_UNITAR').AsFloat - fFormataFloat(cdsDados.FieldByName('ITE_UNITAR').AsFloat * fltPorDes / 100, 2);

      If (Not blnDesCndAplicado) Then
        cdsDados.FieldByName('ITE_UNITAR').AsFloat  := cdsDados.FieldByName('ITE_UNITAR').AsFloat - fFormataFloat(cdsDados.FieldByName('ITE_UNITAR').AsFloat * fltDesCndAux / 100, 2);
    end;

    blnItemEntraNoRateio := fItemEntraRateio(cdsVendaOri);

    If (cdsVendaOri.FieldByName('ITE_PROMOC').AsString = 'S') And Not blnItemPromocaoEntraNoRateio Then
      blnItemEntraNoRateio := False;

    If blnItemEntraNoRateio And (cdsVendaOri.FieldByName('ITE_PROMOC').AsString = 'S') And (Not fPodeEntrarNoRateio(cdsVendaOri.FieldByName('ITE_CODPRO').AsString)) Then
      blnItemEntraNoRateio := False;

    If (fltTotalProdutosRateio > 0) And blnItemEntraNoRateio Then
      cdsDados.FieldByName('ITE_UNITAR').AsFloat := cdsDados.FieldByName('ITE_UNITAR').AsFloat
         - ((cdsVendaOri.FieldByName('ITE_TOTITE').AsFloat / fltTotalProdutosRateio) * fltDesEsp) / cdsVendaOri.FieldByName('ITE_QTDITE').AsFloat;

    cdsDados.FieldByName('ITE_TOTITE').AsFloat  := fFormataFloat(cdsDados.FieldByName('ITE_UNITAR').AsFloat * cdsVendaOri.FieldByName('ITE_QTDITE').AsFloat, 2);
  End;
end;

procedure TFatVendaBase.pCalcularValoresDataSetParaCalculoDaMargem(cdsDados,
  cdsVendaOri: TUniClientDataSet; blnPegaUnitario, blnPegaPrecoCusto,
  blnAplicaDescontos: Boolean; fltTotalProdutosRateio: Double;
  blnItemPromocaoEntraNoRateio: Boolean);
var
  fltImcSTPV: Double;
  blnCalcST: Boolean;
  fltDesF07 : Double;
  blnItemEspecial: Boolean;
  fltComliq,
  fltVlrCam : Double;
begin
  pDefinirCustoDoItemMargemLucro(cdsDados, cdsVendaOri);

  pDefinirValorUnitarioEValorTotalDoItemMargemLucro(cdsDados, cdsVendaOri, blnPegaUnitario, blnAplicaDescontos, blnItemPromocaoEntraNoRateio, fltTotalProdutosRateio);

  pDefinirValorUnitarioOriginalDoItemMargemLucro(cdsDados, cdsVendaOri);

  pDefinirImpostosCalculadosNaVendaOuDoProdutoParaMargemDeLucro(cdsDados, cdsVendaOri);

  pDefinirValorDoFCPdoItemMargemLucro(cdsDados, cdsVendaOri);

  pDefinirPrecoDeUltimaCompraDoItemMargemLucro(cdsDados, cdsVendaOri);

  fltDesF07 := 0;
  If (Assigned(cdsVendaOri.FindField('ITE_DESF07'))) Then
    fltDesF07 := cdsVendaOri.FieldByName('ITE_DESF07').AsFloat;

  fltComliq := 0;
  If (blnEmCampanha) And
     (fCfgSis('MARMKP') = '4') Then
  Begin
    objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                 cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                                                 EmptyStr,
                                                 EmptyStr,
                                                 0,
                                                 fltVlrCam,
                                                 strCodCmg,
                                                 fltComliq);
  End;

  objIcStPv.pAdd(cdsVendaOri.FieldByName('ITE_CODITE').AsString,
                 fGetEmpCalculoItem(cdsVendaOri.FieldByName('ITE_EMPITE').AsString),
                 GetTipAbf(cdsVendaOri.FieldByName('ITE_EMPITE').AsString),
                 fUFDestTrib(cdsVendaOri.FieldByName('ITE_EMPITE').AsString),
                 cdsVendaOri.FieldByName('ITE_CODFIS_MARGEM').AsString,
                 fltImcSTPV,
                 blnCalcST,
                 fltDesF07,
                 fltComliq);

  pDefinirIcmsSTParteVendaECalculaSTMargemLucro(cdsDados, fltImcSTPV, blnCalcST);

  blnItemEspecial := (Pos('ITEM ESPECIAL', cdsVendaOri.FieldByName('ITE_DESITE').AsString) > 0);

  pDefinirCustoCAT17MargemLucro(cdsDados, cdsVendaOri);

  pDefinirPrecoMedioLiquidoEPrecoDeUltimaCompraLiquidoDoItemMargemLucro(cdsDados, cdsVendaOri, blnItemEspecial);

  pDefinirPrecoCustoDoItemMargemLucro(cdsDados, cdsVendaOri, fltImcSTPV, blnCalcST, blnItemEspecial, blnPegaPrecoCusto);

  pDefinirMargemIdealDoItemMargemLucro(cdsDados, cdsVendaOri);

  pDefinirPrecoIdealDoItemMargemLucro(cdsDados, cdsVendaOri, fltImcSTPV, blnCalcST);
end;

procedure TFatVendaBase.pPrepararDataSetParaCalculoDaMargem( cdsDados, cdsVendaOri: TUniClientDataSet;
                                                     blnPegaUnitario, blnPegaPrecoCusto, blnAplicaDescontos: Boolean;
                                                     fltTotalProdutosRateio: Double;
                                                     blnItemPromocaoEntraNoRateio: Boolean;
                                                     blnMostraMargem: Boolean = False);
begin
  pCalcularValoresDataSetParaCalculoDaMargem(
    cdsDados,
    cdsVendaOri,
    blnPegaUnitario,
    blnPegaPrecoCusto,
    blnAplicaDescontos,
    fltTotalProdutosRateio,
    blnItemPromocaoEntraNoRateio
  );

  objMargemLucro.
    PreencherDataSetComInformacoesDoProduto(cdsDados, cdsVendaOri, fltDesOpeCli,
      strClaFis, Self.dtaDtCtVn, Self.fltVlCtVn,
      blnCarregaPedidoOrcamentoEntFut, fGetEmpCalculoItem, Self.fCalcularOutrosValoresComBaseNoValorOriginal);

  pAplicarRestricaoElementosMargem(cdsDados);

