function TFatVendaBase.fCalculaCustoBruto(fltPreVen, fltPreLiq, fltOutVal, fltIcmSai, fltImpFed, fltDesOpe: Double): Double;
Begin
  Result := fltPreLiq - (fltOutVal + (fltICMSai*fltPreVen/100) + (fltImpFed*fltPreVen/100) + (fltDesOpe*fltPreVen/100));
End;

function TFatVendaBase.fIdentificarIncGad(strIncDor: String): String;
const
  SQL: String = ' SELECT GPV_SEQGAD FROM MOVGPV WHERE GPV_SEQFDO = :INCFDO ';
Var
  Qry: TUniquery;
begin
  Result := emptyStr;
  Try
    Qry := fCriaQuery();
    Qry.Close;
    Qry.Sql.clear;
    Qry.sql.add(SQL);
    Qry.ParamByname('INCFDO').AsString := strIncDor;
    Qry.Open;
    if Not Qry.IsEmpty then
    begin
      Result := Qry.FieldbyName('GPV_SEQGAD').AsString;
    end;
  Except
    On E: Exception do
    begin
      Result := EmptyStr;
    end;
  End;
end;

