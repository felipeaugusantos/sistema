procedure TFatVendaBase.pDefineClassificacaoItem(Var item: TDadosFechamento; blnAtendeRegrasDifal: Boolean);
  Var
    InputDefineClafis : TInputDefineClassificacaoFiscal;
    OutputDefineClafis : TInputOutputClassificacaoFiscal;
begin
  If blnReimpressaoNotaFiscal Then
    Exit;

  If fEmptyStr(item.strCodFis) Then
    item.strCodFis := item.strCodSit;

  item.strCstAnt := item.strCodFis;

  InputDefineClafis := fGetInputDefineClassificacaoItem(blnAtendeRegrasDifal, item);
  OutputDefineClafis := objDefineClafis.GetClassificacao(InputDefineClafis);

  item.strClaFis := OutputDefineClafis.Classificacao;
  item.strCodFis := OutputDefineClafis.SituacaoTributaria;
  strClaSer := OutputDefineClafis.ClassificacaoDeServico;

  If OutputDefineClafis.AbortarProcedimento Then
  Begin
    fMensagem('Atenção', OutputDefineClafis.MensagemRetorno, ['&OK']);
    Abort;
  End;
end;

procedure TFatVendaBase.PreencherVariaviesSubstituicaoTributariaSimulada(const AResultadoIcmsSt: IResultadoImpostosFatControllerIcmsSt);
begin
  fltRet_SpItem := AResultadoIcmsSt.BaseDaSubstituicaoTributariaSimulada;
  fltRet_Sp := fltRet_Sp + fltRet_SpItem;

  fltAlqSub_Sp := AResultadoIcmsSt.AliquotaDaSubstituicaoTributariaSimulada;

  fltValSub_Sp := fltValSub_Sp + AResultadoIcmsSt.ValorDaSubstituicaoTributariaSimulada;

  If (fltValSub_Sp <= 0) Then
    fltValSub_Sp := 0;
end;

procedure TFatVendaBase.PreencherVariaviesBeneficioREIDI(const fltDescontoBeneficioREIDI: Double);
begin
  FValDesBenRei := FValDesBenRei + fltDescontoBeneficioREIDI;
end;

procedure TFatVendaBase.PreencherVariaviesIcmsOrgaoPublico(const item: TDadosFechamento;
  const AResultadoIcmsSt: IResultadoImpostosFatControllerIcmsSt);
begin
  If fEhClienteZonaFrancaSimplesNacional(Item.strEmpIte) Then
    Exit;

  fltOrgPubIcm := fltOrgPubIcm + AResultadoIcmsSt.ValorSeparadoDoIcmsDeOrgaoPublicoDoItem;
  fltOrgPubPis := fltOrgPubPis + AResultadoIcmsSt.ValorSeparadoDoPisDeOrgaoPublicoDoItem;
  fltOrgPubCof := fltOrgPubCof + AResultadoIcmsSt.ValorSeparadoDoCofinsDeOrgaoPublicoDoItem;

  fltIcmOrg    := fltIcmOrg + AResultadoIcmsSt.ValorDoIcmsDeOrgaoPublicoDoItem;
  fltBasOrg    := fltBasOrg + AResultadoIcmsSt.BaseDeIcmsDeOrgaoPublicoDoItem;
  fltNotBasOrg := fltNotBasOrg + AResultadoIcmsSt.TotalDaBaseDeIcmsDeOrgaoPublicoConfirmacao;
  fltNotIcmOrg := fltNotIcmOrg + AResultadoIcmsSt.TotalDoValorDeIcmsDeOrgaoPublicoConfirmacao;
end;

procedure TFatVendaBase.pAcumulaSTCustoAquisicao(const AMatItens: TDadosFechamento; AResultadoIcmsSt: IResultadoImpostosFatControllerIcmsSt);
begin
  fltRetFatNeg := fltRetFatNeg + AResultadoIcmsSt.FatorNegativo;
  fltRetFatPos := fltRetFatPos + AResultadoIcmsSt.FatorPositivo;

  fltBasRet_Sp := fltBasRet_Sp + AResultadoIcmsSt.BaseDaSTCustoAquisicao;
  fltValRet_Sp := fFormataFloat((fltRetFatPos - fltRetFatNeg), 2);

  pAcumulaIPIRet(AMatItens.strClaIPI, AResultadoIcmsSt.BaseDaSTCustoAquisicao,
    AResultadoIcmsSt.ValorDaSTCustoAquisicao);
end;

function TFatVendaBase.fRetornaPercentualDiferimento(strCodIte, strEmpIte: String): Double;
Begin
  Result := 0;

  If fCfgSis('RICMPR',varBoolean, GetEmpCfg(strEmpIte)) Then
  Begin
    Result := CONST_PERCENTUAL_DIFERIMENTO_RICMS;
  End;

  If fCfgSis('RICMAP',varBoolean, GetEmpCfg(strEmpIte)) Then
  Begin
    Result := fRetAliquotaDiferenciadaRICMPR(strCodIte, strEmpIte);
  End;
End;

function TFatVendaBase.fRetAliquotaDiferenciadaRICMPR(strCodIte, strEmpIte: String): Double;
Var
  strCodAbf : String;
begin
  Result := 0;

  strCodAbf := fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte));

  If (Not fEmptyStr(Self.GetTipAbf(strEmpIte))) And (fBuscaAbfIcm(strCodIte, strEmpIte, strCodAbf, fTrocaUFEndEntrega)) Then
  begin
    If fCfgSis('RICMAP',varBoolean, GetEmpCfg(strEmpIte)) Then
      If (cdsAbfIcm.HasField('ABF_ALQRIC'+Self.GetTipAbf(strEmpIte))) Then
         Result := cdsAbfIcm.FieldByName('ABF_ALQRIC'+Self.GetTipAbf(strEmpIte)).AsFloat;
  end;

end;

function TFatVendaBase.fUtilizaAmpara(strCodIte: String): Boolean;
var
  LItemAmpara: Boolean;
begin
  LItemAmpara := fItemAmpara(strCodIte);

  Result := TFunctionFuncoesFaturamento.UtilizaAmpara(Self.strCliEst, LItemAmpara);
end;

procedure TFatVendaBase.pCalcularDescontoEspecialParaClienteZonaFranca(var Itens: TDadosFechamento);
var
  strTipAbf: String;
  fltAlqIva: Double;
  fltValIcm: Double;
  fltAliquotaIcmsPraticada: Double;
  fltAliquotaIcmsInterestadual: Double;
  fltAliquotaIcmsDescontoEspecial: Double;
  fltValorIcmsPraticado: Double;
  fltValorIcmsComDesconto: Double;
  fltValorDescontoEspecial: Double;
  CalcResult: TResultPisCofins;

  procedure pIniciaVariaveis;
  Begin
    Itens.fltOrgPubAlqIcm := 0;
    Itens.fltOrgPubAlqPis := 0;
    Itens.fltOrgPubAlqCof := 0;

    Itens.fltOrgPubIcm := 0;
    Itens.fltOrgPubPis := 0;
    Itens.fltOrgPubCof := 0;

    Itens.fltBasVrd := 0;
    Itens.fltVrdIcm := 0;
    Itens.strMtdIcm := '';

    Itens.fltDesEspZonFra := 0;

    fltValorIcmsPraticado := 0;
    fltValorIcmsComDesconto  := 0;
    fltValorDescontoEspecial := 0;
  End;

  procedure pRetornaAliquotaPisCofins;
  Var
    tmp: TCalculoPisCofins;
  Begin
      If fEmptyStr(Itens.strIteAbf) Then
        Itens.strIteAbf := Itens.strCodIte;

      Try
        tmp := TCalculoPisCofins.Create;
        CalcResult := tmp.fCalculoPisCofins(VS_strCodEmp,
                                            Itens.strIteAbf,
                                            Itens.strClaFis,
                                            Itens.strCodFis,
                                            strCodCli,
                                            VS_strSimPau,
                                            strOpcDoc,
                                            Itens.fltTotIte,
                                            Itens.fltDesEsp,
                                            Itens.fltValipi,
                                            Itens.fltValRet,
                                            Itens.fltValFre,
                                            Itens.fltDesAce,
                                            Itens.fltValIcm,
                                            Itens.VisualizarFcpIcms.fltValor,
                                            IIF(fDocumentoParaFornecedor,'F','C'),
                                            Itens.strIncPis,
                                            IIF(fEmptyStr(Itens.strSit_PC), Self.strSitP_C, Itens.strSit_PC),
                                            strMenP_C,dtaDtaEnt,strCodEmpTe,
                                            blnEhOperacaoDeTransferencia,
                                            blnBFut49,
                                            Itens.strEntRet,
                                            Itens.strEntFut,
                                            Itens.strMotFut,
                                            '',
                                            True,
                                            '',
                                            -1,
                                            '',
                                            '',
                                            0,
                                            0,
                                            fDifalItem(Itens));
        If (Not CalcResult.blnResult) Then
          Abort;

      Finally
        FreeAndNil(tmp);
      End;
  End;

Begin
  If not Self.blnClienteZonaFrancaComDescontoEspecial Then
    Exit;

  pIniciaVariaveis;
  pRetornaAliquotaPisCofins;

  fltAliquotaIcmsPraticada        := Itens.fltAlqIcm;
  fltAliquotaIcmsInterestadual    := fRetornaAliquotaDeIcmsInterestadual(fGetUFEmpresa(Itens.strEmpIte), fTrocaUFEndEntrega);
  fltAliquotaIcmsDescontoEspecial := ( ( fltAliquotaIcmsInterestadual - fltAliquotaIcmsPraticada ) / ( 100 - fltAliquotaIcmsPraticada ) * 100 ) ;

  // Produtos com icms desonerado
  If (pos(RightStr(Itens.strCodFis, 2), '30_40_41_50_51_') > 0) Then
  Begin
    fltValorIcmsPraticado := fFormataFloat((Itens.fltTotIte * fltAliquotaIcmsPraticada) / 100, 2);

    Itens.fltOrgPubAlqIcm := fltAliquotaIcmsPraticada;
    Itens.fltOrgPubAlqPis := CalcResult.dblAlqPis;
    Itens.fltOrgPubAlqCof := CalcResult.dblAlqCof;

    Itens.fltOrgPubIcm := fltValorIcmsPraticado;
    Itens.fltOrgPubPis := fFormataFloat((Itens.fltTotIte * Itens.fltOrgPubAlqPis) / 100, 2);
    Itens.fltOrgPubCof := fFormataFloat((Itens.fltTotIte * Itens.fltOrgPubAlqCof) / 100, 2);

    Itens.fltBasIcm := 0;
    Itens.fltValIcm := 0;

    Itens.fltBasVrd := Itens.fltTotIte;
    Itens.fltVrdIcm := fltValorIcmsPraticado;
    Itens.strMtdIcm := '9';

    fltPisDesEspZonFra := fltPisDesEspZonFra + Itens.fltOrgPubPis;
    fltCofDesEspZonFra := fltCofDesEspZonFra + Itens.fltOrgPubCof;

    Itens.fltDesEspZonFra := Itens.fltOrgPubPis + Itens.fltOrgPubCof;

    fltValDesEspZonFra := fltValDesEspZonFra + Itens.fltOrgPubPis + Itens.fltOrgPubCof;
  End
  Else If pos(LeftStr(Itens.strCodFis, 1), '0_1_2_6_7_') > 0 Then
  Begin
    // Produtos de origem estrangeira
    If pos(LeftStr(Itens.strCodFis, 1), '1_2_6_7_') > 0 Then
    Begin
      fltValorDescontoEspecial := fFormataFloat((Itens.fltTotIte * fltAliquotaIcmsDescontoEspecial) / 100, 2);

      If fCfgSis('DESZON',varBoolean) Then
      Begin
        fltValorIcmsPraticado    := fFormataFloat((Itens.fltTotIte * fltAliquotaIcmsPraticada) / 100, 2);
        fltValorIcmsComDesconto  := (Itens.fltTotIte - fltValorIcmsPraticado);
        fltValorDescontoEspecial := fFormataFloat((fltValorIcmsComDesconto * fltAliquotaIcmsDescontoEspecial) / 100, 2);
      End;
    End;

    Itens.fltOrgPubAlqIcm := fltAliquotaIcmsDescontoEspecial;
    Itens.fltOrgPubAlqPis := CalcResult.dblAlqPis;
    Itens.fltOrgPubAlqCof := CalcResult.dblAlqCof;

    Itens.fltOrgPubIcm := fltValorDescontoEspecial;
    Itens.fltOrgPubPis := fFormataFloat((Itens.fltTotIte * Itens.fltOrgPubAlqPis) / 100, 2);
    Itens.fltOrgPubCof := fFormataFloat((Itens.fltTotIte * Itens.fltOrgPubAlqCof) / 100, 2);

    fltIcmDesEspZonFra := fltIcmDesEspZonFra + Itens.fltOrgPubIcm;
    fltPisDesEspZonFra := fltPisDesEspZonFra + Itens.fltOrgPubPis;
    fltCofDesEspZonFra := fltCofDesEspZonFra + Itens.fltOrgPubCof;

    If not fCfgSis('DZFICM',varBoolean) Then
    Begin
      fltIcmDesEspZonFra    := 0;
      Itens.fltOrgPubIcm    := 0;
      Itens.fltOrgPubAlqIcm := 0;
    End;

    Itens.fltDesEspZonFra := Itens.fltOrgPubIcm + Itens.fltOrgPubPis + Itens.fltOrgPubCof;

    fltValDesEspZonFra := fltValDesEspZonFra + Itens.fltOrgPubIcm + Itens.fltOrgPubPis + Itens.fltOrgPubCof;
  End;

  If (fCfgSis('TBSTZF') = '2') And (Itens.fltBasRet > 0) Then
  Begin
    strTipAbf       := Self.GetTipAbf(Itens.strEmpIte);
    fltAlqIva       := fRetornaPercIVA(Itens.strCodAbf, fTrocaUFEndEntrega, strTipAbf);
    fltValIcm       := fFormataFloat((Itens.fltTotIte * fltAliquotaIcmsPraticada) / 100, 2);
    Itens.fltBasRet := fFormataFloat((((Itens.fltTotIte - Itens.fltOrgPubPis - Itens.fltOrgPubCof - fltValIcm + Itens.fltValipi + Itens.fltValFre + Itens.fltDesAce) * fltAlqIva) * Itens.fltPeBaST) / 100, 2);
    Itens.fltValRet := fFormataFloat((Itens.fltBasRet * Itens.fltAlqRet) / 100 - fltValIcm, 2);
  End;

End;

procedure TFatVendaBase.pCalcularDescontoEspecialParaClienteZonaFrancaSimplesNacionalComIcmsDesonerado(var Itens: TDadosFechamento);

  procedure pZeraVariaveisDeTributacao;
  Begin
    itens.fltBasIcm := 0;
    itens.fltAlqIcm := 0;
    itens.fltValIcm := 0;
    itens.fltPerBas := 0;
    itens.fltPerRed := 0;
    itens.fltBasOrg := 0;
    itens.fltIcmOrg := 0;
  End;

  function fRetornaAliquotaIcmsSimplesNacional(strCodIte, strEmpIte: String): Double;
  Begin
    Result := fCfgSis('ICMSIM', varDouble, GetEmpCfg(strEmpIte));

    If fCfgSis('CONIPI', varBoolean, GetEmpCfg(strEmpIte)) Then
    Begin
      If (fItemRevInd(strCodIte, GetEmpCfg(strEmpIte)) = 'I') Or ((fCfgSis('INDCOM', varString, GetEmpCfg(strEmpIte)) = 'S') And (Self.strIndCom = 'I')) Then
      Begin
        Result := fCfgSis('ICMIND', varDouble, GetEmpCfg(strEmpIte));
      End;
    End;
  End;

Begin
  If not fEhClienteZonaFrancaSimplesNacional(Itens.strEmpIte) Then
    Exit;

  pZeraVariaveisDeTributacao;

  If not fEhClienteZonaFrancaSimplesNacionalComIcmsDesonerado(Itens) then
    Exit;

  Itens.fltDesEspZonFra := fFormataFloat((Itens.fltTotIte * fRetornaAliquotaIcmsSimplesNacional(Itens.strCodIte, Itens.strEmpIte)) / 100, 2);

  fltValDesEspZonFra := fltValDesEspZonFra + Itens.fltDesEspZonFra;
End;

