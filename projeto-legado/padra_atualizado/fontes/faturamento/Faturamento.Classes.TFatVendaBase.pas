function TFatVendaBase.fRetPrecoTroca(strEntSai, strTabela: String): Double;
  Var
    strCampo: String;
begin

  Result   := 0.0;

  If (strEntSai = 'E') Then
    strCampo := fCfgSis('PRTREN')
  Else
    strCampo := fCfgSis('PRTRSA');

  If (strCampo = 'PRECOM') Then
    Result := fltComAnt
  Else If (strCampo = 'PRECUS') Then
    Result := fltPreCus
  Else If (strCampo = 'PREVEN') Then
  Begin

    If (strTabela = '1') Then
      Result := fltPreVe1

    Else If (strTabela = '2') Then
      Result := fltPreVe2

    Else If (strTabela = '3') Then
      Result := fltPreVe3

    Else If (strTabela = '4') Then
      Result := fltPreVe4

    Else If (strTabela = '5') Then
      Result := fltPreVe5

    Else If (strTabela = '6') Then
      Result := fltPreVe6

    Else If (strTabela = '7') Then
      Result := fltPreVe7;

  End;

end;

function TFatVendaBase.fVerificaUsaPrecoCampanha(fltPreVen: Double; fltVlrCam: Double) : Boolean;
begin

