procedure TFatVendaBase.AtualizaDataMovimentoCadRec(AAutoInc : String; ADataAlterada: TDateTime);
  Var
    LAtuCadRec: TUniQuery;
begin

  If Not fEmptyStr(AAutoInc) Then
  Begin

    Try
      LAtuCadRec := fCriaQuery(Nil);
      LAtuCadRec.sql.Clear;
      LAtuCadRec.SQL.Add(' UPDATE CADREC ');
      LAtuCadRec.SQL.Add('    SET CTR_DTABAN = :DTABAN ');
      LAtuCadRec.SQL.Add('  WHERE AUTOINCREM IN (' + AAutoInc + ') ');
      LAtuCadRec.ParamByName('DTABAN').AsDateTime := ADataAlterada;
      LAtuCadRec.ExecSQL;
    Finally
      FreeAndNil(LAtuCadRec);
    End;

  End;

end;

procedure TFatVendaBase.pCalculaValorRT(var fltUnitOriginal, fltValorRT: Double);
  Var
    fltUniOriAnt: Double;
begin
  fltValorRT := 0.00;
  If fCfgSis('UTI_RT', varBoolean) Then
  Begin
    fltUniOriAnt    := fltUnitOriginal;
    fltUnitOriginal := fFormataFloat(fltUniOriAnt / (1 - (Self.fltPer_RT / 100)), VS_intDecUni);
    fltValorRT      := fltUnitOriginal - fltUniOriAnt;
  End;
end;

function TFatVendaBase.fVerificaNotPromocaoOuPrecoSugAtivaIgualPrecoTabela(const strPromoc : String): Boolean;
