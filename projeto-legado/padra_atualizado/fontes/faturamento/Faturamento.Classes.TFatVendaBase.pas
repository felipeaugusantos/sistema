Function TFatVendaBase.fCalculaAliquota(strCodIte, strEmpIte, strImpDir, strEntFut: String; blnEhCalcDifal: Boolean = False): Double;
  Var
    fltAlqIcm: Double;
    strCodSit: String;
    blnRedAlq,
    blnClaFisValida: Boolean;
begin
  blnRedAlq := (fCfgSis('IMPCF4', varBoolean, GetEmpCfg(strEmpIte))) And (fCfgSis('RAICF4', varBoolean, GetEmpCfg(strEmpIte)));

  pRetornaAliquotaItem(strCodIte, strEmpIte, fltAlqIcm, strCodSit, blnRedAlq, blnEhCalcDifal);

  Result := fltAlqIcm;

  If fUsaAliquotaDeIcmsDoSimplesNacional(GetEmpCfg(strEmpIte)) Then
  Begin
    If fCfgSis('CONIPI', varBoolean, GetEmpCfg(strEmpIte)) Then
    Begin
      If fItemRevInd(strCodIte, fGetEmpCalculoItem(strEmpIte)) = 'I' Then
      Begin
        Result := fCfgSis('ICMIND', varDouble, GetEmpCfg(strEmpIte));
      End
      Else
      Begin
        Result := fCfgSis('ICMSIM', varDouble, GetEmpCfg(strEmpIte));
      End;

      If fCfgSis('INDCOM', varBoolean, GetEmpCfg(strEmpIte)) then
      Begin
        If Self.strIndCom = 'I' then
        Begin
          Result := fCfgSis('ICMIND', varDouble, GetEmpCfg(strEmpIte));
        End
        ELse
        Begin
          Result := fCfgSis('ICMSIM', varDouble, GetEmpCfg(strEmpIte));
        End;
       End;
    End
    Else
    Begin
      Result := fCfgSis('ICMSIM', varDouble, GetEmpCfg(strEmpIte));
    End;

  End;

  If fDentroDoEstado(strEmpIte) Then
  Begin
    {******************************************}
    {* ZONA FRANCA TERÁ O MESMO COMPORTAMENTO *}
    {* DO ORGÃO PÚBLICO, OU SEJA, O ICMS É    *}
    {* DADO COMO DESCONTO NA NOTA.            *}
    {************************************MV,JB*}
    If ((strCliOrg = 'S') And (TFunctionFuncoesFaturamento.OptantePorSimplesNacional(GetEmpCfg(strEmpIte)) <> 'S') And (strCalIcm = 'S')) Or
       ((strZonFra = 'S') And (strCliCon = 'N'))                           Then
      Result := 0.0
    Else
    Begin
      If Pos(strCodSit, CST_SUBSTITUICAO) > 0 Then
      Begin
        If (Not IIF(fCfgSis('IMPDIR',varBoolean, GetEmpCfg(strEmpIte)), IIF((strImpDir = 'S'),True, False), False)) And
           (Not fEmptyStr(Self.GetTipAbf(strEmpIte))) And
           (Not TFunctionFuncoesFaturamento.fCalcBeneficioReducaoBaseIcmsST(Self.GetTipAbf(strEmpIte), strCodSit, fDentroDoEstado(strEmpIte))) Then
        Begin
          Result := 0.0
        End;
      End;
    End;

  End
  Else
  Begin
    If (TFunctionFuncoesFaturamento.OptantePorSimplesNacional(GetEmpCfg(strEmpIte)) = 'S') And (Pos(strCodSit, CST_SUBSTITUICAO) > 0) Then
      Result := 0.0;
  End;

  {************************************}
  {* SE O CLIENTE FOR ZONA FRANCA DE  *}
  {* MANAUS É ISENTO DE IMPOSTOS      *}
  {*********************************AF*}
  {*******************************************}
  {* SE FOR CONFIRMAÇÃO DE CUPOM EM NOTA TBM *}
  {* IGNORA OS IMPOSTOS                      *}
  {****************************************MV*}
  blnClaFisValida := True;
  If Self.blnConEqu And fEmptyStr(Self.strClaFis) Then
    blnClaFisValida := False;

  If (strZonFra = 'S')                                         Or
     ((strOpcDoc = 'CI') And (fCfgSis('ZERCIF', varBoolean)))  Or
     (Pos(strOpcDoc, 'CO_MF') > 0)                             Or
     ((blnClaFisValida) And
      (Pos(strClaFis, VS_strClaVen) <= 0) And
      (Pos(strClaFis, '1411_2411_1202_2202_5411_6411_5202_6202_5152_6152_') <= 0) And
      (Not fClassificacaoDeBrinde) And
      (strOpcDocTrue <> 'F3')) Or
     (LeftStr(strClaFis, 1) = '7')                             Then
    Result := 0.0;

  If fEmptyStr(strEntFut) Then
    strEntFut := Self.strEntFut;

  If (Not blnBaiEntFut) And (strEntFut = 'S') And ( not blnCarregaPedidoOrcamentoEntFut) Then
    Result := 0.0;
end;

function TFatVendaBase.fDentroDoEstado(strEmpresaItem: String): Boolean;
Var
  LDentroDoEstado: Boolean;
begin
{$IFDEF LINUX}
  LDentroDoEstado := untFuncoesGenerica.fDentroDoEstado(fTrocaUFEndEntrega, fGetEmpCalculoItem(strEmpresaItem));
{$ELSE}
  LDentroDoEstado := untFuncoesSimples.fDentroDoEstado(fTrocaUFEndEntrega, fGetEmpCalculoItem(strEmpresaItem));
{$ENDIF}
  Result := TFunctionFuncoesFaturamento.fDentroDoEstadoFaturamento(LDentroDoEstado, blnVendaPresencial);
end;

function TFatVendaBase.fFaturamentoDentroDoEstado: Boolean;
var
  LItem: TDadosFechamento;
begin
  if not Self.blnPraticarPrecosEmpresaFaturamento then
    Exit(fDentroDoEstado(VS_strCodEmp));

  if Length(Self.ArrMatItens) = 0 then
    Exit(fDentroDoEstado(VS_strCodEmp));

  Result := False;
  for LItem in Self.ArrMatItens Do
    if fDentroDoEstado(LItem.strEmpIte) then
      Exit(True);
end;

