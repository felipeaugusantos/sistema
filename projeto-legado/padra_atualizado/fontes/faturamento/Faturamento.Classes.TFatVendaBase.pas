procedure TFatVendaBase.pCalculaDesOrgItens(blnZerar: Boolean);
  Var
    fltDesOrgTmp: Double;
    intContador: Integer;
begin
  fltDesOrg    := 0;
  fltDesOrgTmp := 0;

  //Define o valor do icms dado como desconto para orgao publico
  //utilizado para aplicar o desconto especial de orgao publico
  //somente nos produtos tributados
  If (fltIcmOrg > 0) And (Not blnZerar) Then
  Begin
    If fltDesEsp > fltIcmOrg Then
      fltDesOrg := fltIcmOrg
    Else
      fltDesOrg := fltDesEsp;
  End;

  If (Self.FConsideraDescontoNaBaseDeCalculoOrgaoPublico) Then
    fltDesOrg := 0;

  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    arrMatItens[intContador].fltDesOrg := 0.00;

    If (Not Self.FConsideraDescontoNaBaseDeCalculoOrgaoPublico) Then
    Begin
      If (fltDesOrg > 0) And (arrMatItens[intContador].fltIcmOrg > 0) Then
      Begin
        arrMatItens[intContador].fltDesOrg := fFormataFloat(
          fltDesOrg * arrMatItens[intContador].fltIcmOrg / fltIcmOrg, 2);
      End;
    End;

    fltDesOrgTmp := fltDesOrgTmp + arrMatItens[intContador].fltDesOrg;
  End;

  fltDesOrgTmp := fltDesOrg - fltDesOrgTmp;

  If Abs(fltDesOrgTmp) <> 0.0 Then
    For intContador := 0 To Length(arrMatItens) -1 Do
      If (arrMatItens[intContador].fltIcmOrg > 0) Then
        pDistribuiADiferencaDoRateioItens(arrMatItens[intContador].fltDesOrg, fltDesOrgTmp);

  fltDesOrg := 0.00;
  For intContador := 0 To Length(arrMatItens) -1 Do
    fltDesOrg := fltDesOrg + arrMatItens[intContador].fltDesOrg;
end;

