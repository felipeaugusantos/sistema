procedure TFatVendaBase.pCalculaCreditoPresumido(var Item: TDadosFechamento; strTipAbf: String; fltTotGer: Double);

  function fDadosIncompletos: Boolean;
  begin
    Result := False;

    If fEmptyStr(Item.strCbenef) Then
      Exit(True);

    If fEmptyStr(Item.strCodPre) Then
      Exit(True);

    If not (Item.fltPerPre > 0) Then
      Exit(True);
  end;

begin
  If fBuscaAbfIcm(Item.strIteAbf,
                  Item.strEmpIte,
                  Item.strCodAbf,
                  IIF(fEmptyStr(strEstEnt),
                                strCliEst,
                                strEstEnt)) Then
  Begin
    Item.strCbenef := cdsAbfIcm.FieldByName('ABF_CODBEN' + strTipAbf).AsString;
    Item.strCodPre := cdsAbfIcm.FieldByName('ABF_CODPRE' + strTipAbf).AsString;
    Item.fltPerPre := cdsAbfIcm.FieldByName('ABF_PERPRE' + strTipAbf).AsFloat;
  End;

  If fDadosIncompletos Then
  Begin
    If fBuscaBenPre(Item.strClaIpi,
                    Item.strExcIpi,
                    Item.strCodFis,
                    IIF(fEmptyStr(strEstEnt),
                                  strCliEst,
                                  strEstEnt)) Then
    Begin
      Item.strCbenef := cdsBenPre.FieldByName('BEN_CBENEF').AsString;
      Item.strCodPre := cdsBenPre.FieldByName('BEN_CODPRE').AsString;
      Item.fltPerPre := cdsBenPre.FieldByName('BEN_PERPRE').AsFloat;
    End;
  End;

  If Pos(RightStr(Item.strCodFis, 2), '40_41_') > 0 Then
    Item.fltBasPre := fltTotGer
  Else
    Item.fltBasPre := Item.fltBasIcm;

  If (RightStr(Item.strCodFis, 2) = '51') And (Item.fltPerRed > 0) Then
    Item.fltBasPre := fFormataFloat((Item.fltBasPre * (100 - Item.fltPerRed)) / 100, 2);

  Item.fltValPre := fFormataFloat((Item.fltBasPre * Item.fltPerPre) / 100, 2);
end;

function TFatVendaBase.fBuscaBenPre(strClaIpi, strExcIpi, strCodCst, strEstado: String): Boolean;
Var
  qryBenPre: TUniquery;
  LKey: string;
Begin

  Result := True;

  LKey := strClaIpi + strExcIpi + strCodCst + strEstado;

  If dicBenPre.TryGetValue(LKey, cdsBenPre) Then
    Exit;

  qryBenPre := fCriaQuery(Self);
  Try
    qryBenPre := fCriaQuery(Self);
    qryBenPre.Close;
    qryBenPre.SQL.Add('SELECT ');
    qryBenPre.SQL.Add('  BEN_CODNCM, ');
    qryBenPre.SQL.Add('  BEN_CBENEF, ');
    qryBenPre.SQL.Add('  BEN_CODPRE, ');
    qryBenPre.SQL.Add('  BEN_PERPRE ');
    qryBenPre.SQL.Add('FROM BENPRE ');
    qryBenPre.SQL.Add('WHERE BEN_CODNCM = :CODNCM ');
    qryBenPre.SQL.Add('  AND BEN_CODEXC = :CODEXC ');
    qryBenPre.SQL.Add('  AND BEN_ESTADO = :ESTADO ');
    qryBenPre.SQL.Add('  AND BEN_CODCST = :CODCST ');

    qryBenPre.ParamByName('CODNCM').AsString := strClaIpi;
    qryBenPre.ParamByName('CODEXC').AsString := strExcIpi;
    qryBenPre.ParamByName('ESTADO').AsString := strEstado;
    qryBenPre.ParamByName('CODCST').AsString := strCodCst;

    cdsBenPre := ExecutarQueryEmCache(qryBenPre);

    If cdsBenPre.FieldByName('BEN_CODNCM').AsString.IsEmpty Then
      Exit(False);

    dicBenPre.AddOrSetValue(LKey, cdsBenPre);

  Finally
    FreeAndNil(qryBenPre);
  End;

End;

