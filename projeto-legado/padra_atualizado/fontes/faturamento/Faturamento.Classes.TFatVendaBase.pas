function TFatVendaBase.fNotaDeComplementoCalculaFCPComReducaoBaseIcmsST: Boolean;
begin
  Result := False;

  If not (strOpcDoc = 'NC') Then
    Exit;

  If not (fCfgSis('BBSFCP') = '2') Then
    Exit;

  If not (fRegimeSubstituicaoTributaria('', Self.fOpcDocClaSub) = '2') Then
    Exit;

  If not (pos(strTpAbre, '_SAI_CNC_SAI_TRS_') > 0) Then
