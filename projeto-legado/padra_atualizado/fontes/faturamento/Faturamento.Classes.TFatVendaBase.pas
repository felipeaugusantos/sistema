    Result := qryGen.FieldByName('ITE_REFERE').AsString;
  Finally
    FreeAndNil(qryGen);
  End;
end;

{************************************************************}
{* VERIFICA SE ESTÁ CONFIGURADO POR TABELA DE PREÇO(AUTTIN) *}
{* E SE A TABELA CONFIGURADA NAO ESTA ATIVA NO FATURAMENTO  *}
{*********************************************************AC*}
function TFatVendaBase.fTabelaPrecoTinta(ACodCli, AOpcDoc, ATabPre: String; ARegraPromocao, ARecalculoPrecos, AAltTabRecalculoPrecos: Boolean): String;
  Var
    strCodCliente: String;

  function fRetTabelaPrecoCliente: String;
  begin
    Result := fCampoTabela('CLI_TABPRE', 'CADCLI', ['CLI_CODCLI'], [strCodCliente], False);
    If (fEmptyStr(Result)) And (fCfgSis('HIETAB', varString) = 'S') Then
      Result := fCampoTabela('OPE_TABPRE', 'CADOPE', ['OPE_CODOPE'], [strCodVen], False);
  end;

begin
  If (Not fEmptyStr(ACodCli)) Then
    strCodCliente := ACodCli
  Else
    strCodCliente := Self.strCodCli;

  If (fCfgSis('PRTTIN') = 'S') Then
  Begin
    If (Not ARegraPromocao) Then
    Begin
      If (Not fEmptyStr(ATabPre)) Then
        Result := ATabPre
      Else
        Result := IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);
    End
    Else
    Begin
      If (Not ARecalculoPrecos) Then
      Begin
        If (Not fEmptyStr(AOpcDoc)) And (Not fEmptyStr(ATabPre)) Then
        Begin
          If ( (fCfgSis('TABITE', varString) = 'S') Or (AOpcDoc = 'CP') ) And (ATabPre <> '') Then
            Result := ATabPre
          Else
            Result := Self.strTabPre;
        End
        Else If (fEmptyStr(AOpcDoc)) And (Not fEmptyStr(ATabPre)) Then
        Begin
          If fEmptyStr(ATabPre) Then
            Result := Self.strTabPre
          Else
            Result := ATabPre;
        End
        Else
          Result := IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);
      End
      Else
      Begin
        If ( (fCfgSis('TABITE', varString) = 'S') Or (AOpcDoc = 'CP') ) And (Not AAltTabRecalculoPrecos) And (ATabPre <> '') Then
          Result := ATabPre
        Else
          Result := IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);
      End;
    End;
  End
  Else If fEmptyStr(Self.strTabTin) And fEmptyStr(fRetTabelaPrecoCliente()) Then
    Result := Self.strTabPre
  Else
  Begin
    If fEmptyStr(Self.strTabTin) Then
      Result := fRetTabelaPrecoCliente()
    Else
      Result := Self.strTabTin;
  End;
end;

function TFatVendaBase.fDefineTabelaPrecoItem(strIdePro, strCodAca: String): String;
Begin
  If ((strIdePro <> 'NOR') Or Not fEmptyStr(strCodAca)) Then
    Result := fTabelaPrecoTinta(Self.strCodCli, '', '', False, False, False)
  Else
    Result := Self.strTabPre;
End;

function TFatVendaBase.fRetornaDataEmissaoDocumento(strTabela,strNumDoc, strEspDoc, strCodEmp, strTipFC: String; strAutInc: String = ''): TDateTime;
var
  strSQL: String;
  qryAux: TUniQuery;
begin
  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   DET_DTAENT ';
  strSQL := strSQL + ' FROM ' + strTabela + ' ';
  strSQL := strSQL + ' WHERE ';
  strSQL := strSQL + '       DET_NUMDOC=:NUMDOC  ';
  strSQL := strSQL + '   AND DET_ESPDOC=:ESPDOC  ';
  strSQL := strSQL + '   AND DET_CODEMP=:CODEMP  ';
  strSQL := strSQL + '   AND DET_TIP_FC=:TIP_FC  ';

  If (Not fEmptyStr(strAutInc)) Then
    strSQL := strSQL + ' AND AUTOINCREM=:AUTINC  ';

  qryAux := fCriaQuery();

  Try
    qryAux.SQL.Add(strSQL);
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('TIP_FC').AsString := strTipFC;

    If (Not fEmptyStr(strAutInc)) Then
      qryAux.ParamByName('AUTINC').AsString := strAutInc;

    qryAux.Open;

    Result := qryAux.FieldByName('DET_DTAENT').AsDateTime;
  Finally
    FreeAndNil(qryAux);
  End;
end;

