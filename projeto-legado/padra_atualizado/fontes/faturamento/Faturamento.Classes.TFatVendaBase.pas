procedure TFatVendaBase.pAtualizaInformacoesCondPagamento(qryCndPag: TUniQuery = Nil; blnLimpar: Boolean = False);
  var
    blnAssigned: Boolean;
begin
  blnAssigned := Assigned(qryCndPag);

  If Not blnAssigned And Not blnLimpar Then
  Begin
    qryCndPag := fCriaQuery(Self);

    With qryCndPag, SQL Do
    Begin
      Clear;
      Add('SELECT SQL_NO_CACHE');
      Add('  CND_CODIGO,');
      Add('  CND_DESCRI,');
      Add('  CND_DESMAX,');
      Add('  CND_DESMGE,');
      Add('  CND_DESMSU,');
      Add('  CND_DESMVM,');
      Add('  CND_DESMGM,');
      Add('  CND_DESMSM,');
      Add('  CND_TXJURO,');
      Add('  CND_ABADES,');
      Add('  CND_DESCRI,');
      Add('  CND_TIPFOR,');
      Add('  CND_TABPRE,');
      Add('  CND_ABDECC,');
      Add('  CND_JURPRO,');
      Add('  CND_PRETAB,');
      Add('  CND_PRAMIN,');
      Add('  CND_CNDESP,');
      Add('  CND_TRACNC ');
      Add('FROM         ');
      Add('  CADCND     ');
      Add('WHERE        ');
      Add('  CND_CODIGO = ' + QuotedStr(Self.strCodCnd));

      Open;
    End;

  End;

  If blnLimpar Then
  Begin
    {********************************************************************************}
    {* Limpa todas as variáveis referentes à condição de pagamento, exceto o código *}
    {*Req.202377******************************************************************RP*}
    Self.strDesCnd := '';
    Self.blnCndEsp := False;
    Self.blnCndTravaCli  := False;
    Self.fltDMVCnd := 0.00;
    Self.fltDVMCnd := 0.00;
    Self.fltDMGCnd := 0.00;
    Self.fltDGMCnd := 0.00;
    Self.fltDMSCnd := 0.00;
    Self.fltDSMCnd := 0.00;
    Self.fltTxJCnd := 0.00;
    Self.strCAbDes := '';
    Self.strTipFor := '';
    Self.strAbDeCc := '';
    Self.strJurPro := '';
    Self.strCndTbP := '';
    Self.strPraMin := '';
    Self.strCndTpm := '';

    Exit;
  End;

  With qryCndPag Do
  Begin
    Self.strCodCnd := FieldByName('CND_CODIGO').AsString;
    Self.strDesCnd := FieldByName('CND_DESCRI').AsString;

    Self.blnCndEsp      := (FieldByName('CND_CNDESP').AsString = 'S');
    Self.blnCndTravaCli := (FieldByName('CND_TRACNC').AsString = 'S');

    Self.fltDMVCnd := FieldByName('CND_DESMAX').AsFloat;
    Self.fltDVMCnd := FieldByName('CND_DESMVM').AsFloat;

    Self.fltDMGCnd := FieldByName('CND_DESMGE').AsFloat;
    Self.fltDGMCnd := FieldByName('CND_DESMGM').AsFloat;

    Self.fltDMSCnd := FieldByName('CND_DESMSU').AsFloat;
    Self.fltDSMCnd := FieldByName('CND_DESMSM').AsFloat;

    Self.fltTxJCnd := FieldByName('CND_TXJURO').AsFloat;
    Self.strCAbDes := FieldByName('CND_ABADES').AsString;
    Self.strTipFor := FieldByName('CND_TIPFOR').AsString;
    Self.strAbDeCc := FieldByName('CND_ABDECC').AsString;
    Self.strJurPro := FieldByName('CND_JURPRO').AsString;
    Self.strCndTbP := FieldByName('CND_TABPRE').AsString;
    Self.strPraMin := FieldByName('CND_PRAMIN').AsString;
    Self.strCndTpm := FieldByName('CND_PRETAB').AsString;
  End;

  If (Self.blnBaiEntFut) And (Self.blnExpedi) Then
  Begin
    Self.fltDMVCnd := 0.00;
    Self.fltDVMCnd := 0.00;

    Self.fltDMGCnd := 0.00;
    Self.fltDGMCnd := 0.00;

    Self.fltDMSCnd := 0.00;
    Self.fltDSMCnd := 0.00;

    Self.fltTxJCnd := 0.00;
    Self.strCAbDes := 'N';
  End;

  If Not blnAssigned Then
    FreeAndNil(qryCndPag);
end;

{************************************************}
{* FUNÇÃO QUE RETORNA A POSIÇÃO DO ITEM NO GRID *}
{*********************************************AC*}
function TFatVendaBase.fOrdemItem(qryTabela: TDataset; btnStatus:String; btnAdiciona:TBitBtnLocked; intOrdem: Integer = 0):Integer;
  Var
    intCriei : Integer;
    prcScroll: TprcScroll;
begin

  Result   := 0;
  intCriei := 0;

  {*******************************************}
  {* QUANDO CARREGA PEDIDO E OU ORÇAMENTO    *}
  {****************************************AC*}
  If (Not Assigned(btnAdiciona)) Then
  Begin
    btnAdiciona     := TBitBtnLocked.Create(Self);
    btnAdiciona.Tag := 0;
    intCriei        := 1;
  End;

  Try
    pDisableControls(qryTabela, prcScroll);

    With qryTabela Do
    Begin

      If (btnStatus = 'Delete') Then //Delete
      Begin
        Try
         {$IFNDEF LINUX}
          If Assigned(Self.objCopiaSegVenda) Then
            Self.objCopiaSegVenda.pDisableEventHandlers;
         {$ENDIF}

          intOrdem := 0;

          First;
          While Not Eof Do
          Begin

            intOrdem := intOrdem + 1;

            Edit;
            FieldByName('ITE_ORDITE').AsInteger := intOrdem;
            Post;

            Next;

          End;
        Finally
         {$IFNDEF LINUX}
          If Assigned(Self.objCopiaSegVenda) Then
            Self.objCopiaSegVenda.pEnableEventHandlers((Not qryTabela.IsEmpty), False);
         {$ENDIF}
        End;

      End
      Else If (btnAdiciona.Tag <= 0) Then //Insere
      Begin
        if intOrdem > 0 then
        begin
          Result := intOrdem;
          Try
           {$IFNDEF LINUX}
            If Assigned(Self.objCopiaSegVenda) Then
              Self.objCopiaSegVenda.pDisableEventHandlers;
           {$ENDIF}

            If Locate('ITE_ORDITE', intOrdem, []) then
            Begin
              Last;
              While Not Bof Do
              Begin
                if FieldByName('ITE_ORDITE').AsInteger >= intOrdem then
                begin
                  Edit;
                  FieldByName('ITE_ORDITE').AsInteger := FieldByName('ITE_ORDITE').AsInteger + 1;
                  Post;
                end;
                Prior;
              End;
            End;
          Finally
           {$IFNDEF LINUX}
            If Assigned(Self.objCopiaSegVenda) Then
              Self.objCopiaSegVenda.pEnableEventHandlers((Not qryTabela.IsEmpty), False);
           {$ENDIF}
          End;
        end
        else
        begin
          Last;

          {*************************************************************}
          {* ACONTECIA CASOS DE NÃO TER NENHUM REGISTRO, MAS O RECNO   *}
          {* FICAVA 1, DESTA FORMA O SEQUENCIAL INICIAVA EM 2.         *}
          {* AJUSTADO PARA RESULTAR 1 QUANDO NÃO TIVER NENHUM REGISTRO.*}
          {**********************************************************PZ*}
          If (RecordCount = 0) Then
            Result := 1
          Else
            Result := RecNo + 1;

          If (intCriei = 1) Then
            FreeAndNil(btnAdiciona);
        End;

      End;

    End;

  Finally
    pEnableControls(qryTabela, prcScroll);
  End;

end;

{*****************************************}
{* CALCULA PESO BRUTO / LÍQUIDO          *}
{**************************************RV*}
procedure TFatVendaBase.pCalculaPesBruLiq(blnIgnorarItemServico: Boolean = False);
begin
  pCalculaPesBruLiq(arrMatItens, blnIgnorarItemServico);
end;

{*****************************************}
{* CALCULA PESO BRUTO / LÍQUIDO          *}
{**************************************RV*}
procedure TFatVendaBase.pCalculaPesBruLiq(Itens: TMatrizFechamento; blnIgnorarItemServico: Boolean = False);
  Var
    intContador: Integer;
begin
  fltPesLiq := 0.0;
  fltPesBru := 0.0;

  If (blnNotaTintaES) And (fCfgSis('NFTIES') = '1') Then
  Begin
    For intContador := 0 To Length(Itens) -1 Do
    Begin
      If blnIgnorarItemServico And (arrMatItens[intContador].strCodIte = fCfgSis('ITESER'))  Then
      Begin
        Continue;
      End;

      Itens[intContador].blnEdiPes     := False;

      Itens[intContador].fltPesoItCalc := Itens[intContador].fltQtdIte / 1000;
      Itens[intContador].fltPesLiqCalc := Itens[intContador].fltPesoItCalc;

      Itens[intContador].fltPesoItOri := Itens[intContador].fltQtdIte / 1000;
      Itens[intContador].fltPesLiqOri := Itens[intContador].fltPesoItOri;

      fltPesBru := fltPesBru + Itens[intContador].fltPesoItCalc;
    End;

    fltPesLiq := fltPesBru;
  End
  Else
  Begin
    For intContador := 0 To Length(Itens) -1 Do
    Begin
      If blnIgnorarItemServico And (arrMatItens[intContador].strCodIte = fCfgSis('ITESER'))  Then
        Continue;

      Itens[intContador].blnEdiPes     := False;

      Itens[intContador].fltPesoItCalc := (Itens[intContador].fltQtdIte * Itens[intContador].fltPesoIt);

      Itens[intContador].fltPesoItOri  := (Itens[intContador].fltQtdIte * Itens[intContador].fltPesoItCad);

      fltPesBru := fltPesBru + Itens[intContador].fltPesoItCalc;

      If fCfgSis('PESLIQ') = 'SOMA' Then
      Begin
          Itens[intContador].fltPesLiqCalc := (Itens[intContador].fltQtdIte * Itens[intContador].fltPesLiq);

          Itens[intContador].fltPesLiqOri  := (Itens[intContador].fltQtdIte * Itens[intContador].fltPesLiqCad);

          fltPesLiq := fltPesLiq + Itens[intContador].fltPesLiqCalc;
      End
      Else
      Begin
          Itens[intContador].fltPesLiqCalc := fFormataFloat(Itens[intContador].fltPesoItCalc * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);

          Itens[intContador].fltPesLiqOri  := fFormataFloat(Itens[intContador].fltPesoItOri * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);

          Itens[intContador].fltPesLiq     := fFormataFloat(Itens[intContador].fltPesoIt * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);

          fltPesLiq := fltPesLiq + Itens[intContador].fltPesLiqCalc;
      End;
    End;
  End;

  {*****************************}
  {* VERIFICA SE ZERA OS PESOS *}
  {**************************PZ*}
  If (fZerarPeso) Then
  Begin
    fltPesLiq := 0.0;
    fltPesBru := 0.0;

    For intContador := 0 To Length(Itens) -1 Do
    Begin
      Itens[intContador].fltPesoItCalc := 0;
      Itens[intContador].fltPesLiqCalc := 0;
      Itens[intContador].fltPesoIt     := 0;
      Itens[intContador].fltPesLiq     := 0;
    End;
  End;

end;

procedure TFatVendaBase.pCalculaPesBruLiq(out fltPesBruEnt: Double; out fltPesLiqEnt: Double);
  Var
    intContador: Integer;
begin
  fltPesBruEnt := 0;
  fltPesLiqEnt := 0;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (Not fItemEntrega(arrMatItens[intContador])) Then
      Continue;

    fltPesBruEnt := fltPesBruEnt + arrMatItens[intContador].fltPesoItCalc;
    fltPesLiqEnt := fltPesLiqEnt + arrMatItens[intContador].fltPesLiqCalc;
  End;
end;

procedure TFatVendaBase.pAtualizaClassTransferencias(blnForFil: Boolean=False);
  Var
    strSQL   : String;
    qryGenEmp: TUniQuery;
    blnCstTra : Boolean;
    strEmpFil : String;
    strEmpOriTE: String;
    LRegraClassificacoesTransferencias: IRegraImpostosClassificacoesTransferencias;
    LResultadoClassificacoesTransferencias: IResultadoRegraClassificacoesTransferencias;
    blnUsaEmpOriTE: Boolean;
begin
  Try
    blnUsaEmpOriTE := False;

    qryGenEmp := fCriaQuery(Self);
    blnCstTra := fCfgSis('CSTTRA', varBoolean);
    if blnRegimeEspecialPorEmpresaComFaturamentoDuplo then
    begin
      strEmpFil := strEmpOriPed;
      strEmpOriTE := strEmpresaRegimeEspecialPorEmpresa;
    end
    else
    if blnAbastecimentoDeposito then
    begin
      strEmpFil := strEmpOriPed;
      strEmpOriTE := FstrEmpresaAbastecimentoDeposito;
    end
    else
    if (not fEmptyStr(FstrEmpOriRegEsp)) then
    begin
      strEmpFil   := VS_strCodEmp;
      strEmpOriTE := FstrEmpOriRegEsp;
    end
    else if (not fEmptyStr(strEmpLogDevRegEsp)) then
    begin
      strEmpFil   := VS_strCodEmp;
      strEmpOriTE := strEmpLogDevRegEsp;
    end
    else
    begin
      If blnForFil Then
        strEmpFil := fRetEmpresaFornecedorFilial(strCodCli)
      Else
        strEmpFil := fRetCodEmpClienteFilial(strCodCli);

      strEmpOriTE := IIF(fEmptyStr(Self.strEmp_TE), VS_strCodEmp, Self.strEmp_TE);

      blnUsaEmpOriTE := True;
    end;

    LRegraClassificacoesTransferencias := ClassificacoesTransferencias;

    strSQL := LRegraClassificacoesTransferencias.ClassificacoesTransferenciasSQL;

    With qryGenEmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      ParamByName('CODEMP').AsString := strEmpOriTE;
      ParamByName('EMPDES').AsString := strEmpFil;
      Open;

      strCodEmpTe   := strEmpFil;
      strPerEmpTe   := FieldByName('PERTRA').AsString;

      LResultadoClassificacoesTransferencias :=
        LRegraClassificacoesTransferencias.ClassificacoesTransferenciasRegra(
          TParametrosRegraClassificacoesTransferencias.New()
            .CodigoDaEmpresaTE(strCodEmpTe)
            .CodigoDaEmpresaOrigemTE(strEmpOriTE)
            .CstTransfEstoqueEmpresa(blnCstTra)
            .TipoDeOperacao(FieldByName('TIPOPE').AsString)
            //Industrializacao e venda
            .TransfDeEstoqueClassifIndustrializacaoTributado(FieldByName('EMP_CLATI1').AsString)
            .TransfDeEstoqueClassifIndustrializacaoSubstCombustivelLubrificante(FieldByName('EMP_CLATI2').AsString)
            .TransfDeEstoqueClassifIndustrializacaoSubstDemaisProdutos(FieldByName('EMP_CLATI3').AsString)
            .TransfDeEstoqueClassifVendaTributado(FieldByName('EMP_CLAT01').AsString)
            .TransfDeEstoqueClassifVendaSubstCombustivelLubrificante(FieldByName('EMP_CLAT02').AsString)
            .TransfDeEstoqueClassifVendaSubstDemaisProdutos(FieldByName('EMP_CLAT03').AsString)
            .TransfDeEstoqueClassifTransferenciaDepositoFechadoTributado(FieldByName('EMP_CLTDFT').AsString)
            .TransfDeEstoqueClassifTransferenciaDepositoFechadoSubstCombustivelLubrificante(FieldByName('EMP_CLTDFC').AsString)
            .TransfDeEstoqueClassifTransferenciaDepositoFechadoSubstDemaisProdutos(FieldByName('EMP_CLTDFS').AsString)
            .TransfDeEstoqueCSTDeVendaTributado(FieldByName('EMP_CSTT01').AsString)
            .TransfDeEstoqueCSTDeVendaSubstCombustivelLubrificante(FieldByName('EMP_CSTT02').AsString)
            .TransfDeEstoqueCSTDeVendaSubstDemaisProdutos(FieldByName('EMP_CSTT03').AsString)
            //Transferencia produtos industrializacao e transferencias
            .TransfDeEstoqueClassifTransferenciaProdutosIndustrializacaoTributado(FieldByName('EMP_CLTTI1').AsString)
            .TransfDeEstoqueClassifTransferenciaProdutosIndustrializacaoSubstCombustivelLubrificante(FieldByName('EMP_CLTTI2').AsString)
            .TransfDeEstoqueClassifTransferenciaProdutosIndustrializacaoSubstDemaisProdutos(FieldByName('EMP_CLTTI3').AsString)
            .TransfDeEstoqueClassifTransferenciaTributado(FieldByName('EMP_CLATT1').AsString)
            .TransfDeEstoqueClassifTransferenciaSubstCombustivelLubrificante(FieldByName('EMP_CLATT2').AsString)
            .TransfDeEstoqueClassifTransferenciaSubstDemaisProdutos(FieldByName('EMP_CLATT3').AsString)
            .TransfDeEstoqueCSTDeTransferenciaTributado(FieldByName('EMP_CSTTT1').AsString)
            .TransfDeEstoqueCSTDeTransferenciaSubstCombustivelLubrificante(FieldByName('EMP_CSTTT2').AsString)
            .TransfDeEstoqueCSTDeTransferenciaSubstDemaisProdutos(FieldByName('EMP_CSTTT3').AsString)
            .TransfDeEstoqueDepositoFechadoCSTDeTransferenciaTributado(FieldByName('EMP_CSTDFT').AsString)
            .TransfDeEstoqueDepositoFechadoCSTDeTransferenciaSubstCombustivelLubrificante(FieldByName('EMP_CSTDFC').AsString)
            .TransfDeEstoqueDepositoFechadoCSTDeTransferenciaSubstDemaisProdutos(FieldByName('EMP_CSTDFS').AsString)
            .TransfDeEstoqueClassifVendaSubstImpDireta(FieldByName('EMP_CLAT04').AsString)
        );

      strTipEmiTe  := LResultadoClassificacoesTransferencias.TipoDeEmissaoTE;

      VS_strClaID1 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifIndustrializacaoOuTransferenciaProdutosIndustrializacaoTributado;
      VS_strClaID2 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifIndustrializacaoOuTransferenciaProdutosIndustrializacaoSubstCombustivelLubrificante;
      VS_strClaID3 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifIndustrializacaoOuTransferenciaProdutosIndustrializacaoSubstDemaisProdutos;

      VS_strClaT01 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifVendaOuTransferenciaTributado;
      VS_strClaT02 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifVendaOuTransferenciaSubstCombustivelLubrificante;
      VS_strClaT03 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifVendaOuTransferenciaSubstDemaisProdutos;
      VS_strClaT04 := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifVendaOuTransferenciaSubstImpDireta;
      VS_strCLTDFT := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifTransferenciaDepositoFechadoTributado;
      VS_strCLTDFC := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifTransferenciaDepositoFechadoSubstCombustivelLubrificante;
      VS_strCLTDFS := LResultadoClassificacoesTransferencias.TransfDeEstoqueClassifTransferenciaDepositoFechadoSubstDemaisProdutos;
      VS_strCSTT01 := LResultadoClassificacoesTransferencias.TransfDeEstoqueCSTDeVendaOuTransferenciaTributado;
      VS_strCSTT02 := LResultadoClassificacoesTransferencias.TransfDeEstoqueCSTDeVendaOuTransferenciaSubstCombustivelLubrificante;
      VS_strCSTT03 := LResultadoClassificacoesTransferencias.TransfDeEstoqueCSTDeVendaOuTransferenciaSubstDemaisProdutos;
      VS_strCSTDFT := LResultadoClassificacoesTransferencias.TransfDeEstoqueDepositoFechadoCSTDeVendaOuTransferenciaTributado;
      VS_strCSTDFC := LResultadoClassificacoesTransferencias.TransfDeEstoqueDepositoFechadoCSTDeVendaOuTransferenciaSubstCombustivelLubrificante;
      VS_strCSTDFS := LResultadoClassificacoesTransferencias.TransfDeEstoqueDepositoFechadoCSTDeVendaOuTransferenciaSubstDemaisProdutos;

      VS_strTipOpeTe := FieldByName('TIPOPE').AsString;

      blnGravaCtrTe := (FieldByName('FIN_GRVCTR').AsString = 'S') And (strOpcDoc <> 'UC');

      blnEhOperacaoDeTransferencia := Pos(FieldByName('TIPOPE').AsString, '2_3_') > 0;

      {********************************************************************************}
      {* QUANDO É CLIENTE FILIAL DA PRÓPRIA EMPRESA NÃO DEVE GERAR CONTAS A RECEBER   *}
      {* CONVERSADO COM RONALDO EM 16/09/2014; REQUISITO: 24261; CLIENTE: BELA TINTAS *}
      {*****************************************************************************RN*}
      If (blnGravaCtrTe) And (fRetornaClienteFilial(IIF(blnUsaEmpOriTE, strEmpOriTE, VS_strCodEmp)) = strCodCli) Then
        blnGravaCtrTe := False;

      If (Not blnGravaCtrTe) And (Self.blnCliFil) And (Not fEmptyStr(Self.FClienteDaChaveASerDevolvida)) And (Self.fUtilizarRotinaDeOutrasEntradasParaAnulacaoDeVendas) Then
        blnGravaCtrTe := True;

      Close;
    End;

  Finally
    FreeAndNil(qryGenEmp);
  End;

  strCodForTe := fGetFornecedorFilial(strEmpOriTE);

end;

