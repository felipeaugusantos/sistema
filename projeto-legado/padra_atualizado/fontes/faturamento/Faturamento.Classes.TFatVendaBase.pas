function TFatVendaBase.fPegaPrecoSugeridoTE(qryIteGer: TDataset; strEmpIte: String; strPromoc: String): Double;
  Var
    fltTmpImpFed: Double;
    fltTmpOutVal: Double;
    fltTmpValFre: Double;
    fltTmpIcmSai: Double;
    fltTmpDesOpe: Double;
    strCodAbf: String;
    strCodSit: String;
    blnSubTrib: Boolean;
Begin
  With qryIteGer Do
  Begin
    If (fCampoPrecoSugeridoTE = 'IMP') Then
      Result := FieldByName('ITE_IMPULT').AsFloat
    Else If (fCampoPrecoSugeridoTE = 'SIC') Then
      Result := FieldByName('ITE_MEDSIC').AsFloat
    Else If (fCampoPrecoSugeridoTE = 'VEP') Then
      Result := Self.fltProPreVen
    Else If (fCampoPrecoSugeridoTE = 'CUP') Then
      Result := Self.fltProPreCus
    Else If (fCampoPrecoSugeridoTE = 'CSD') Then
    Begin
      fltTmpImpFed := 0;
      fltTmpOutVal := 0;
      fltTmpIcmSai := 0;

      If (FindField('ITE_IMPFED') <> Nil) Then
        fltTmpImpFed := FieldByName('ITE_IMPFED').AsFloat;

      If (FindField('ITE_OUTVAL') <> Nil) Then
        fltTmpOutVal := FieldByName('ITE_OUTVAL').AsFloat;

      If (FindField('ITE_CODITE') <> Nil) Then
        fltTmpIcmSai := fGetIcmSai(FieldByName('ITE_CODITE').AsString, strEmpIte);

      Result := fCalculaCustoReal(IIF(Self.strPromoc.Equals('S') And (Self.fltProPreCus <> 0), Self.fltProPreCus, FieldByName('ITE_PRECUS').AsFloat),
                                  fltTmpIcmSai,
                                  fltTmpImpFed,
                                  0,
                                  fltTmpOutVal);
    End
    Else If (fCampoPrecoSugeridoTE = 'CFI') Then
    Begin
      fltTmpImpFed := 0;
      fltTmpDesOpe := 0;
      fltTmpValFre := 0;
      fltTmpIcmSai := 0;

      If (FindField('ITE_IMPFED') <> Nil) Then
        fltTmpImpFed := FieldByName('ITE_IMPFED').AsFloat;

      If (FindField('ITE_DESOPE') <> Nil) Then
        fltTmpDesOpe := FieldByName('ITE_DESOPE').AsFloat;

      If (fCfgSis('TEICMS', varString) = 'S') Then
      Begin
        If (FindField('ITE_CODITE') <> Nil) Then
          fltTmpIcmSai := fGetIcmSai(FieldByName('ITE_CODITE').AsString, strEmpIte);
      End
      Else
      Begin
        If (FindField('ITE_ICMSAI') <> Nil) Then
          fltTmpIcmSai := FieldByName('ITE_ICMSAI').AsFloat;
      End;

      If (FindField('ITE_VALFRE') <> Nil) Then
        fltTmpValFre := FieldByName('ITE_VALFRE').AsFloat;

      Result := ((FieldByName('ITE_PRECUS').AsFloat - fltTmpValFre) / (1 - ( fltTmpImpFed + fltTmpIcmSai + fltTmpDesOpe ) / 100));
    End
    Else If (fCampoPrecoSugeridoTE = 'VDC') Then
    Begin
      fltTmpValFre := 0;
      If (FindField('ITE_VALFRE') <> Nil) Then
        fltTmpValFre := FieldByName('ITE_VALFRE').AsFloat;
      Result := FieldByName('ITE_PRECUS').AsFloat - fltTmpValFre;
    End
    Else
    begin
      if (Assigned(FindField('ITE_PRE' + fCampoPrecoSugeridoTE))) then
      begin

        Result := FieldByName('ITE_PRE' + fCampoPrecoSugeridoTE).AsFloat;

        If (fCampoPrecoSugeridoTE = 'CUS') Then
          Result := fRetPreCus(Result);

      end
      else
        Result := 0.0;
    end;

    blnSubTrib := False;

    If Not fEmptyStr(Self.GetTipAbf(strEmpIte)) Then
    Begin
      If (FindField('ITE_CODITE') <> Nil) Then
      Begin
        strCodAbf := fGetCodAbf(FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(strEmpIte));

        If fBuscaAbfIcm(FieldByName('ITE_CODITE').AsString, strEmpIte, strCodAbf, Self.strCliEst) Then
        Begin
          strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpIte)).AsString;

          blnSubTrib := CST_SUBSTITUICAO.Contains(strCodSit);
        End;
      End;
    End;

    If blnSubTrib Then
    Begin
      If fltFatTE2 > 0 Then
      Begin
        If (strPromoc <> 'S') Then
          Result := Result * fltFatTE2;
      End;
    End
    Else
    Begin
      If fltFat_TE > 0 Then
      Begin
        If (strPromoc <> 'S') Then
          Result := Result * fltFat_TE;
      End;
    End;
  End;
End;

