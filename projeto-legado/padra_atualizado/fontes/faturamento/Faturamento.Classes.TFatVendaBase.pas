procedure TFatVendaBase.pCalculaTaxVpr(strConPagPar: String = '');
begin
  fltTaxVpr := fCalculaTaxVpr('', '', strConPagPar);
end;

function TFatVendaBase.fCalculaTaxVpr(strCodIte, strEmpIte, strConPagPar: String): Double;
  Var
    intPraMinIte: Integer;
    strConTmp: String;
Begin
  If fEmptyStr(strConPagPar) Then
    strConTmp := strConPag
  Else
    strConTmp := strConPagPar;

  Result := 0.0;
  intPraMinIte := 0;

  //Caso utilize prazo medio minimo para calculo de juros (cadastro de produtos)
  If Not fEmptyStr(strCodIte) And fCfgSis('PRAMIN', VarBoolean, GetEmpCfg(strEmpIte)) And (strPraMin = 'S') Then
  Begin
    intPraMinIte := fIteGer(strCodIte, fGetEmpCalculoItem(strEmpIte)).FieldByName('ITE_PRAMIN').AsInteger;
  End;

  //Taxa de juros da condicao de pagamento
  If fltTxJCnd > 0 Then
  Begin
    //Caso tenha prazo medio minimo do produto
    If intPraMinIte > 0 Then
    Begin
      //Somente calcula juros a partir do prazo medio minimo
      If fCalcMediaPagto(strConTmp) > intPraMinIte Then
        Result := fFormataFloat((fltTxJCnd / 30) * (fCalcMediaPagto(strConTmp) - intPraMinIte), 2);
    End
    Else
      Result := fFormataFloat((fltTxJCnd / 30) * fCalcMediaPagto(strConTmp) ,2)
  End
  //Taxa de juros das configuracoes de sistema
  Else
  Begin
    //Caso tenha prazo medio minimo do produto
    If intPraMinIte > 0 Then
    Begin
      //Verifica qual é maior, o prazo medio minimo do produto ou a quantidade
      //de dias para aplicar taxa de juros da configuracao
      intPraMinIte := Max(intPraMinIte, fCfgSis('DIATAX', varInteger, GetEmpCfg(strEmpIte)));

      //Somente calcula juros a partir do prazo medio minimo
      If fCalcMediaPagto(strConTmp) > intPraMinIte Then
        Result := fFormataFloat((fCfgSis('TAXJUR', varDouble, GetEmpCfg(strEmpIte)) / 30) * (fCalcMediaPagto(strConTmp) - intPraMinIte), 2);
    End
    Else If fCalcMediaPagto(strConTmp) > fCfgSis('DIATAX', varInteger, GetEmpCfg(strEmpIte)) Then
    Begin
      If fCfgSis('TAXAPL', varString, GetEmpCfg(strEmpIte)) = 'I' Then
        Result := fFormataFloat((fCfgSis('TAXJUR', varDouble, GetEmpCfg(strEmpIte)) / 30) * fCalcMediaPagto(strConTmp) ,2)
      Else
        Result := fFormataFloat((fCfgSis('TAXJUR', varDouble, GetEmpCfg(strEmpIte)) / 30) * (fCalcMediaPagto(strConTmp) - fCfgSis('DIATAX', varInteger, GetEmpCfg(strEmpIte))) ,2);
    End;
  End;
End;

function TFatVendaBase.fGetTaxVprItem(strCodIte: String; strEmpIte: String = ''; strConPagPar: String = ''): Double;
begin
  Result := Self.fltTaxVpr;

  //Caso tenha taxa de juros calculada e utilize prazo médio minimo por produto
  //deve calcular a taxa de juros novamente verificando o prazo medio minimo do produto.
  //
  //Atencao: manter destas forma pois em alguns pontos do faturamento a variavel
  //         fltTaxVpr é zerada indicando qua nao deve ser calculado juros.
  If (Result > 0) And fCfgSis('PRAMIN', VarBoolean, GetEmpCfg(strEmpIte)) Then
    Result := fCalculaTaxVpr(strCodIte, strEmpIte, strConPagPar);
end;

