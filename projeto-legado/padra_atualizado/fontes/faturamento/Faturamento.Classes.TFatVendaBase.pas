End;

function TFatVendaBase.fRetornaPrecoDeVendaComDifal(strCodIte, strEmpIte: String; fltUnitar: Double): Double;
var
  fltAlqDifal: Double;

  function fRetornaSituacaoTributaria: String;
  var
    strCodAbf: String;
  Begin
    Result := '';
    strCodAbf := fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte));
    If (Not fEmptyStr(Self.GetTipAbf(strEmpIte))) And (fBuscaAbfIcm(strCodIte, strEmpIte, strCodAbf, fTrocaUFEndEntrega)) Then
      Result := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpIte)).AsString;
  End;

Begin

  FCalculandoPrecoDeVendaComDifal := True;

  fltAlqDifal := fGetAlqDifal(strCodIte, strEmpIte, fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte)), fRetornaSituacaoTributaria);

  Try
    Result := fFormataFloat(fltUnitar / ((100 - fltAlqDifal) / 100), VS_intDecUni);
  Finally
    FCalculandoPrecoDeVendaComDifal := False;
  End;
End;

