procedure TFatVendaBase.pAcumulaIPIRet(strClaIPI: String; fltBasRet, fltValRet: Double);
  Var
    intIndice: Integer;
Begin
  For intIndice := Low(arrIPIRet) To High(arrIPIRet) Do
    With arrIPIRet[intIndice] Do
      If SameText(strClaIPI, strIpiRet) Then
      Begin
        fltBaIRet := fltBaIRet + fltBasRet;
        fltVaIRet := fltVaIRet + fltValRet;
        Exit;
      End;

  For intIndice := Low(arrIPIRet) To High(arrIPIRet) Do
    With arrIPIRet[intIndice] Do
      If fEmptyStr(strIpiRet) Then
      Begin
        strIpiRet := strClaIPI;
        fltBaIRet := fltBasRet;
        fltVaIRet := fltValRet;
