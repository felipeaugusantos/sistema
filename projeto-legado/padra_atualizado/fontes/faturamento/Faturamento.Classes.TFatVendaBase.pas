function TFatVendaBase.fRetornaSituacaoPisCofins(Const Item: TDadosFechamento): String;
begin
  Result := Self.strSitP_C;

  If not (Pos(Self.strOpcDoc, 'OR_PD_VN_') > 0) Then
    Exit;

  If not fEhVendaPresencialParaClienteInterestadual Then
    Exit;

  If (LeftStr(Item.strCodFis, 1) = '1') Then
    Exit;

  If fEmptyStr(Self.strSitPCP) Then
    Exit;

  Result := Self.strSitPCP;
end;

function TFatVendaBase.fCalculaValorDoImpostoDeImportacaoZonaFranca(strEmpIte: String): Boolean;
var
  strCodigoCidade: String;
  strIbgeEmpresa : String;
  strIbgeEntrega : String;
begin
  Result := False;

  strCodigoCidade := fCampoTabela('EMP_CODCID', 'CADEMP', ['EMP_CODEMP'], [strEmpIte], False);
  strIbgeEmpresa  := fCampoTabela('CID_COIBGE', 'CADCID', ['CID_CODCID'], [strCodigoCidade], False);
  strIbgeEntrega  := Self.enderecoEntrega.strCoIbge;

  If not TFunctionFuncoesFaturamento.fEhIbgeRegraZonaFranca(strIbgeEmpresa) Then
    Exit;

  Result := TFunctionFuncoesFaturamento.fCalculaIpiParaClienteZonaFranca(strIbgeEmpresa,
                                                                         strIbgeEntrega,
                                                                         Self.strCodZfm,
                                                                         (Self.strZonFra = 'S'),
                                                                         Self.blnVendaPresencial);

end;

function TFatVendaBase.fRetornaValorDoImpostoDeImportacaoZonaFranca: Double;
var
  intContador: Integer;
begin
  Result := 0;

  If not ((Pos(Self.strOpcDoc, 'PD_OR_VN_CP_') > 0) Or (Pos(Self.strOpcDocTrue, 'EI_11_') > 0)) Then
    Exit;

  If not fCfgSis('EIIZFM', varBoolean) Then
    Exit;

  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin
    If fCalculaValorDoImpostoDeImportacaoZonaFranca(arrMatItens[intContador].strEmpIte) Then
    Begin
      If arrMatItens[intContador].fltPiiZfm > 0 Then
        Result := Result + fFormataFloat((arrMatItens[intContador].fltTotIte * arrMatItens[intContador].fltPiiZfm) / 100, 2);
    End;
  End;

end;

function TFatVendaBase.fBloquearPercentualDescontoNoFechamentoDaVenda(
  const AfltPorDes: Double; const AForcarVerificacao: Boolean): Boolean;
begin
  Result := ((MatchStr(strOpcDoc, ['PD','VN'])) Or
             (MatchStr(strEspDoc, ['PD'])) Or
             (AForcarVerificacao)) And
            (AfltPorDes <> 0.00) And
            (fSomenteItensEmPromocaoNaVenda) And
            (Self.fltDescProfissional = 0) And
            (Not fPermiteDescontoPromocao('', tapcdeOlhandoTodosItens));

  If Result Then
  Begin
    pMensagemOk('Percentual de desconto informado não permitido, pois nesta venda ' +
                'foram informados apenas produtos em promoção e o desconto em percentual ' +
                'não é aplicado em produtos promocionais!');
  End;
end;

function TFatVendaBase.fBloquearDescontoEspecialNoFechamentoDaVenda(
  const AfltDesEsp: Double; const AForcarVerificacao: Boolean): Boolean;
  Var
    blnSomenteItensEmPromocaoNaVenda: Boolean;
    blnSomenteItensEmbalagemFechadaNaVenda: Boolean;

  function fHaMotivoParaBloqueio: Boolean;
  begin
    blnSomenteItensEmPromocaoNaVenda := fSomenteItensEmPromocaoNaVenda;
    blnSomenteItensEmbalagemFechadaNaVenda := fUsandoPrecoEmbalagemComoMinimo And fSomenteItensEmbalagemFechadaNaVenda;

    Result := blnSomenteItensEmPromocaoNaVenda Or blnSomenteItensEmbalagemFechadaNaVenda;

    If (Result) And
       (FObjControleCashback.fPermiteUtilizarRotinaCashback) Then
    Begin
      If fCfgSis('PROMCB', varBoolean) Then
        Result := False;
    End;
  end;
begin

  Result := ((MatchStr(strOpcDoc, ['PD','VN'])) Or
             (MatchStr(strEspDoc, ['PD'])) Or
             (AForcarVerificacao)) And
            (AfltDesEsp <> 0.00) And
            (fHaMotivoParaBloqueio) And
            (Not blnClienteZonaFrancaComDescontoEspecial) And
            (Not fPermiteDescontoPromocao('', tapcdeOlhandoTodosItens));

  If Result Then
  Begin
    If blnSomenteItensEmPromocaoNaVenda Then
    Begin
      pMensagemOk('Desconto especial informado não permitido, pois nesta venda ' +
                  'foram informados apenas produtos em promoção e o desconto especial ' +
                  'não é aplicado em produtos promocionais!');
    End
    Else If blnSomenteItensEmbalagemFechadaNaVenda Then
    Begin
      pMensagemOk('Desconto especial informado não permitido, pois nesta venda ' +
                  'foram informados apenas produtos com desconto de embalagem fechada e o desconto especial ' +
                  'não é aplicado nesse tipo de produto!');
    End;
  End;
end;

