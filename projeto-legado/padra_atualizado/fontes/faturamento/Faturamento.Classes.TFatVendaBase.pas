    Result := strEmpresaItem
  Else
    Result := fGetEmpPrecoVendaItem(strEmpresaItem);
end;

function TFatVendaBase.fEstaEmAbastecimentoPorDeposito: Boolean;
begin
  Result := (Pos(strOpcDoc, 'PD_OR_') > 0) and fCfgSis('ABADEP', varBoolean) And Self.blnAbastecimentoDeposito And (Not fEmptyStr(Self.strEmpresaAbastecimentoDeposito));
end;

function TFatVendaBase.fEstaEmAbastecimentoPorDepositoUsandoPrecoLocal: Boolean;
begin
  Result := fEstaEmAbastecimentoPorDeposito And (Pos(strOpcDoc, 'OR_PD_VN_') > 0) And (fCfgSis('VCABDP', varString) = 'L');
end;

function TFatVendaBase.fEhExpedicaoPedidoAbastecimentoPorDepositoUsandoPrecoLocal():Boolean;
begin
  Result := (Pos(Self.strOpcDocTrue, 'EI_EF_') > 0) And
            (Self.blnAbastecimentoDeposito) And
