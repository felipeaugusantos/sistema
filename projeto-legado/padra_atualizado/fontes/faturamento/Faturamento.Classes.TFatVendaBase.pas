function TFatVendaBase.fGetSQLSubItensEstruturas(AEstruturaPersonalizada : TEstruturaPersonalizada = Nil): String;
  var
    strTabGer : String;
    strTabDet : String;
    blnEstPer : Boolean;
begin

  strTabGer := 'GERMAT';
  strTabDet := 'DETMAT';

  blnEstPer := Assigned(AEstruturaPersonalizada) And (AEstruturaPersonalizada.blnEstruturaFoiPersonalizada);

  If blnEstPer Then
  Begin
    If Not AEstruturaPersonalizada.strTabTmpGer.IsEmpty Then
      strTabGer := AEstruturaPersonalizada.strTabTmpGer;

    If Not AEstruturaPersonalizada.strTabTmpDet.IsEmpty Then
      strTabDet := AEstruturaPersonalizada.strTabTmpDet;
  End;

  Result := '';
  Result := Result + 'SELECT SQL_NO_CACHE           ';
  Result := Result + '  *                           ';
  Result := Result + 'FROM                          ';
  Result := Result + '  '+strTabDet+'               ';
  Result := Result + 'INNER JOIN '+strTabGer+' G ON ';
  Result := Result + '  DMT_SEQGER = G.AUTOINCREM   ';
  Result := Result + 'INNER JOIN ITEGER ON          ';
  Result := Result + '  DMT_ITESUB = ITE_CODITE AND ';
  Result := Result + '  ITE_CODEMP = :CODEMP        ';
  Result := Result + 'WHERE                         ';
  Result := Result + '  GMT_CODITE = :CODITE        ';

  If blnEstPer Then
  Begin
    Result := Result + '  AND G.GMT_SEQPER = ' + AEstruturaPersonalizada.intSequencialDaEstruturaPersonalizada.ToString + ' ';
    Result := Result + '  AND   DMT_SEQPER = ' + AEstruturaPersonalizada.intSequencialDaEstruturaPersonalizada.ToString + ' ';
  End;

end;

procedure TFatVendaBase.pArmazenarItemNaListaDeItemForaPromo(strCodIte, strCodEmp: String);
begin
  If (stlItensNaoTemPromocao.IndexOf(strCodIte + strCodEmp) = -1) And
     (fItemSemNenhumaPromocao(strCodIte, strCodEmp)) Then
  Begin
    stlItensNaoTemPromocao.Add(strCodIte + strCodEmp);
  End;
end;

function TFatVendaBase.fItemPassivelDeVerificacaoPromo(strCodIte, strCodEmp: String): Boolean;
begin
  pArmazenarItemNaListaDeItemForaPromo(strCodIte, strCodEmp);
  {*****************************************************************************}
  {* stlItensNaoTemPromocao ARMAZENA ITENS QUE NÃO FIGURAM EM NENHUMA PROMOCAO *}
  {* PORTANTO, CASO ELE ESTEJA NESTA LISTA NEM CONTINUA VERIFICANDO O RESTANTE *}
  {* DAS ROTINAS DE PROMOÇÃO, POUPANDO PROCESSAMENTO                           *}
  {**************************************************************************VA*}
  Result := (stlItensNaoTemPromocao.IndexOf(strCodIte + strCodEmp) = -1);
end;

function TFatVendaBase.fFilialPromocao: Boolean;
begin
  Result := True;
  If (Self.blnCliFil) Then
  Begin
    If (Self.recDadCli.strTEPREV = Self.recDadCli.strTEPPRO) And (Not PRECOS_TE_PROMOC.Contains(Self.recDadCli.strTEPPRO)) Then
      Result := False;
  End;
end;

function TFatVendaBase.fGetAlqFcpIcms(item: TDadosFechamento): Double;
begin
  Result := 0;

  If (strOpcDoc = 'DV') Then
    Exit;

  Result := fReduzAlqFcpSeNecessario(item.strCodIte, item.strEmpIte, item.recDifalFCP.fltPerFcp);
end;

function TFatVendaBase.fGetAlqFcpIcms(strCodIte, strEmpIte, strCodAbf, strCodFis: String; fltAlqIcm, fltValIte: Double): Double;
  Var
    item : TDadosFechamento;
    strProEmb: String;
begin
  Result := 0;

  If fEmptyStr(Self.strCodCli) Or fEmptyStr(strCodIte) Or fEmptyStr(strCodAbf) Or fEmptyStr(strCodFis) Then
    Exit;

  If (strOpcDoc = 'DV') Then
    Exit;

  strProEmb := fCadIte(strCodIte).FieldByName('ITE_PROEMB').AsString;

  FillChar(item, SizeOf(item), #0);

  item.strCodIte := strCodIte;
  item.strEmpIte := strEmpIte;
  item.strIteAbf := strCodIte;
  item.strCodAbf := strCodAbf;
  item.strCodFis := strCodFis;
  item.fltAlqIcm := fltAlqIcm;
  item.fltBas__S := 100;
  item.fltBasIcm := fltValIte;
  item.fltTotIte := fltValIte;
  item.strDocDev := '';
  item.strEspDev := '';
  item.strEmpDev := '';
  item.opcINFesp := opcVazio;
  item.strProEmb := strProEmb;

  pCalculaGravaICMSUFDestino('', '', item);

  Result := fReduzAlqFcpSeNecessario(item.strCodIte, item.strEmpIte, item.recDifalFCP.fltPerFcp);
end;

