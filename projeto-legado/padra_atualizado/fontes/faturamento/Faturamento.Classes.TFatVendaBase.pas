{$IFDEF LINUX}
class function TFatVendaBase.cdsVenda: TUniClientDataSet;
var
  LInstance: TUniClientDataSet;
begin
  FMREW.BeginRead;
  try
    if FDicCdsVenda.TryGetValue(TThread.CurrentThread.ThreadID, LInstance) then
      Exit(LInstance);
    raise EThread.Create('No object cdsVenda for thread');
  finally
    FMREW.EndRead;
  end;
end;
{$ENDIF}

class procedure TFatVendaBase.pCriarCdsVenda(Owner: TComponent);
{$IFDEF LINUX}
var
  LKey: NativeUInt;
  LDataSet: TUniClientDataSet;
{$ENDIF}
begin
  {$IFDEF LINUX}
  FMREW.BeginWrite;
  try
    LKey := TThread.CurrentThread.ThreadID;
    if not FDicCdsVenda.TryGetValue(LKey, LDataSet) then
    begin
      LDataSet := fCriaTemporaria(Owner);
      FDicCdsVenda.Add(LKey, LDataSet);
    end;
  finally
    FMREW.EndWrite;
  end;
  {$ELSE}
  pSetCdsVenda(fCriaTemporaria(Owner));
  {$ENDIF}
end;

class procedure TFatVendaBase.pSetCdsVenda(ADataSet: TUniClientDataSet);
{$IFDEF LINUX}
var
  LKey: NativeUInt;
{$ENDIF}
begin
  {$IFDEF LINUX}
  FMREW.BeginWrite;
  try
    LKey := TThread.CurrentThread.ThreadID;
    FDicCdsVenda.AddOrSetValue(LKey, ADataSet);
  finally
    FMREW.EndWrite;
  end;
  {$ELSE}
  Faturamento.Classes.TFatVendaBase.cdsVenda := ADataSet;
  {$ENDIF}
end;

class procedure TFatVendaBase.pFreeCdsVenda();
{$IFDEF LINUX}
var
  LKey: NativeUInt;
  LDataSet: TUniClientDataSet;
{$ENDIF}
begin
  {$IFDEF LINUX}
  FMREW.BeginWrite;
  try
    LKey := TThread.CurrentThread.ThreadID;
    if FDicCdsVenda.TryGetValue(LKey, LDataSet) then
    begin
      LDataSet.Free;
      FDicCdsVenda.Remove(LKey);
    end;
  finally
    FMREW.EndWrite;
  end;
  {$ELSE}
  If Assigned(Faturamento.Classes.TFatVendaBase.cdsVenda) Then
    FreeAndNil(Faturamento.Classes.TFatVendaBase.cdsVenda);
  {$ENDIF}
end;

