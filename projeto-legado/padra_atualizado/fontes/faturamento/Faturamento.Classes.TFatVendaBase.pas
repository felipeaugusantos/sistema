procedure TFatVendaBase.pPegaPrecoVendaBonus(strCodIte: String; fltVlrPro: Double;
                                         Var fltPreVen: Double; Var strCodCmg: String);
  Var
    fltVlrDes,
    fltVlrCam   : Double;
    blnComBonus : Boolean;
    fltPreClq   : Double;
Begin
  blnComBonus   := False;

  {*******************************************}
  {* CÁLCULO DE BÔNUS                        *}
  {****************************************RL*}
  If (blnExisteCampanha) Or (blnExisteBonus) Then
  Begin

    fltVlrDes := 0;
    fltVlrCam := 0;

    {*******************************************}
    {* VERIFICA SE O PRODUTO OU SEU SIMILAR    *}
    {* ESTÁ EM ALGUMA CAMPANHA                 *}
    {****************************************RL*}
    blnEmCampanha := objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                                  strCodIte, Self.strIdePro, Self.strIteTin,
                                                                  0,
                                                                  fltVlrCam,
                                                                  strCodCmg,
                                                                  fltPreClq);

    {*************************************************}
    {* VERIFICA SE O GRUPO, A MARCA OU O FORNEC.     *}
    {* DO PROD. PERTENCE A ALGUMA CAMPANHA GENÉRICA  *}
    {**********************************************RL*}
    If (Not blnEmCampanha) And (Not fCfgSis('SIMCAM', varBoolean)) Then
      if objCamGer.objCamGen.fUsaCampanhaGenerica Then
        blnEmCampanha := objCamGer.objCamGen.fVerificaProdutoCampGenerica(strCodCli,
                                                                          fRetornaGrupoItem(strCodIte),
                                                                          fRetMarcaItem(strCodIte),
                                                                          fRetCodFornecedor(strCodIte));

    If Not blnEmCampanha Then
    Begin

      {*******************************************}
      {* VERIFICA SE O PRODUTO OU SEU SIMILAR    *}
      {* PARTICIPA DE ALGUM BÔNUS                *}
      {****************************************RL*}
      blnComBonus := objBonGer.objBonDet.fVerificaProdutoBonus(strCodCli,
                                                               strCodIte,
                                                               objCamGer.fRetornaRedeCliente(strCodCli));

      If blnComBonus Then
        fltVlrDes := fStrToFloat(objBonGer.objBonDet.strVlrDes);

      {*************************************************}
      {* VERIFICA SE O GRUPO, A MARCA OU O FORNEC.     *}
      {* DO PROD. PARTICIPA DE ALGUM BÔNUS GENÉRICO    *}
      {**********************************************RL*}
      If (Not blnComBonus) And (Not fCfgSis('SIMCAM', varBoolean)) Then
      Begin

        If objBonGer.objBonGen.fUsaBonusGenerico Then
          blnComBonus := objBonGer.objBonGen.fVerificaProdutoBonusGenerico(strCodCli,
                                                                           objCamGer.fRetornaRedeCliente(strCodCli),
                                                                           fRetornaGrupoItem(strCodIte),
                                                                           fRetMarcaItem(strCodIte),
                                                                           fRetCodFornecedor(strCodIte));

        If blnComBonus Then
          fltVlrDes := fStrToFloat(objBonGer.objBonGen.strVlrDes);

      End;

      If (Not blnEmCampanha) And (blnComBonus) And (fltVlrBon <> 0) Then
        fltVlrBon :=  fltVlrBon - ((fltVlrBon * (fltVlrDes / 100)));

    End
    Else
      strStatus := 'C';

  End;

  If blnEmCampanha And (fltVlrCam > 0) And (fVerificaUsaPrecoCampanha(fltPreVen, fltVlrCam)) Then
  Begin
    fltPreVen := fltVlrCam;
    strPromoc := 'N';
  End
  Else If (strPromoc = 'S') And (blnComBonus) Then
  Begin

    If fltVlrBon < fltVlrPro Then
    Begin

      fltPreVen := fltVlrBon;
      strStatus := 'B';

    End
    Else If fltVlrBon > fltVlrPro Then
      fltPreVen := fltVlrPro
    Else
      fltPreVen := 0;

  End
  Else If (strPromoc = 'N') And (blnComBonus) Then
  Begin

    fltPreVen := fltVlrBon;
    strStatus := 'B';

  End;

  If (Not blnEmCampanha) Then
    Self.objCamGer.pAcrescentaExcecaoCampanha(strCodIte);
End;

