procedure TFatVendaBase.pDistribuiADiferencaDoRateioItens(Var fltValAtu, fltValDif: Double);
begin
  If ((fltValAtu + fltValDif) >= 0) Then
  Begin
    fltValAtu := fltValAtu + fltValDif;
    fltValDif := 0.0;
  End
  Else
  Begin
    fltValDif := fltValDif + fltValAtu;
    fltValAtu := 0.0;
  End
end;

function TFatVendaBase.fGetTotalProdutosRateio(cdsItensVenda: TUniClientDataSet; blnConsiderarItemEmPromocao: Boolean): Double;
  Var
    cdsDados: TUniClientDataSet;

  function fPodeEntrarNoRateio: Boolean;
  begin
    Result := True;

    If (fCfgSis('TRAPRO', varString) = 'C') Then
      Result := Not fTravarPeloPrecoPromocao(cdsDados.FieldByName('ITE_CODPRO').AsString);
  end;

Begin
  Result := 0.00;

  cdsDados  := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsItensVenda);

  cdsDados.Filter   := cdsItensVenda.Filter;
  cdsDados.Filtered := cdsItensVenda.Filtered;

  cdsDados.First;
  While Not cdsDados.Eof Do
  Begin
    If fItemEntraRateio(cdsDados) Then
      If (cdsDados.FieldByName('ITE_PROMOC').AsString <> 'S') Or (blnConsiderarItemEmPromocao And fPodeEntrarNoRateio)  Then
        Result := Result + cdsDados.FieldByName('ITE_TOTITE').AsFloat;
    cdsDados.Next;
  End;

  FreeAndNil(cdsDados);
End;

function TFatVendaBase.fUsaDesCndDefinidoExpedicao: Boolean;
  Var
    item: TDadosFechamento;
begin
  Result := False;

  If (Self.blnExpedi) Then
  Begin
    For item in Self.arrMatItens Do
    Begin
      If (fFormataFloat(item.fltDesCndExp, 2) <> 0.00) Then
      Begin
        Result := True;
        Break;
      End;
    End;
  End;
end;

function TFatVendaBase.fTravarSeSaldoFicarNegativo(const AMotFut: String): Boolean;

  function fMotivosQueNaoReservaramSaldo: String;
  begin
    Case AnsiIndexStr(fCfgSis('CALSAL'), ['1', '2', '3', '4', '5']) Of
      0: Result := 'A_P_F_';
      1: Result := '';
      2: Result := 'F_';
      3: Result := 'A_P_';
      4: Result := 'A_F_';
    End;
  End;

begin
  Result := FblnTravarSeSaldoFicarNegativo;
  If Result Then
    If Pos(AMotFut, fMotivosQueNaoReservaramSaldo) > 0 Then
      Result := False;
end;

function TFatVendaBase.fRetDescMaxLinGru(strCodGru, strCodCnd : String; mdTipDes: TTipoMaxDesconto): Double;
  Var
    qryAux: TUniQuery;

    function fRetColunaDesMax(mdTipDes: TTipoMaxDesconto): String;
    Begin
      Result := '';

      If mdTipDes = mdGerenteMaster Then
        Result := Result + '  IF(IFNULL(G.CND_DESMGM,0) <> 0, G.CND_DESMGM, IF((SELECT COUNT(*) FROM CNDGRU T WHERE T.CND_CODGRU = G.CND_CODGRU AND T.CND_CODCND = G.CND_CODCND) > 0,  0, C.CND_DESMGM)) AS DESMAX '
      Else If mdTipDes = mdGerenteJunior Then
        Result := Result + '  IF(IFNULL(G.CND_DESMAG,0) <> 0, G.CND_DESMAG, IF((SELECT COUNT(*) FROM CNDGRU T WHERE T.CND_CODGRU = G.CND_CODGRU AND T.CND_CODCND = G.CND_CODCND) > 0,  0, C.CND_DESMGE)) AS DESMAX '
      Else If mdTipDes = mdSubGerenteMaster Then
        Result := Result + '  IF(IFNULL(G.CND_DESMSM,0) <> 0, G.CND_DESMSM, IF((SELECT COUNT(*) FROM CNDGRU T WHERE T.CND_CODGRU = G.CND_CODGRU AND T.CND_CODCND = G.CND_CODCND) > 0,  0, C.CND_DESMSM)) AS DESMAX '
      Else If mdTipDes = mdSubGerenteJunior Then
        Result := Result + '  IF(IFNULL(G.CND_DESMAS,0) <> 0, G.CND_DESMAS, IF((SELECT COUNT(*) FROM CNDGRU T WHERE T.CND_CODGRU = G.CND_CODGRU AND T.CND_CODCND = G.CND_CODCND) > 0,  0, C.CND_DESMSU)) AS DESMAX '
      Else If mdTipDes = mdVendedorMaster Then
        Result := Result + '  IF(IFNULL(G.CND_DESMVM,0) <> 0, G.CND_DESMVM, IF((SELECT COUNT(*) FROM CNDGRU T WHERE T.CND_CODGRU = G.CND_CODGRU AND T.CND_CODCND = G.CND_CODCND) > 0,  0, C.CND_DESMVM)) AS DESMAX '
      Else
        Result := Result + '  IF(IFNULL(G.CND_DESMAV,0) <> 0, G.CND_DESMAV, IF((SELECT COUNT(*) FROM CNDGRU T WHERE T.CND_CODGRU = G.CND_CODGRU AND T.CND_CODCND = G.CND_CODCND) > 0,  0, C.CND_DESMAX)) AS DESMAX ';

    End;

  procedure pOpenQuery(blnApenasLinha: Boolean = False);
  begin
    With qryAux Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT SQL_NO_CACHE ');
      SQL.Add(fRetColunaDesMax(mdTipDes));
      SQL.Add('  FROM CADCND C ');
      SQL.Add('  LEFT JOIN CNDGRU G ON C.CND_CODIGO = G.CND_CODCND ');
      SQL.Add(' WHERE C.CND_CODIGO = :CODCND ');

      If (blnApenasLinha) Then
        SQL.Add('   AND LEFT(G.CND_CODGRU, 3) = :CODGRU ')
      Else
        SQL.Add('   AND G.CND_CODGRU = :CODGRU ');

      ParamByName('CODCND').AsString := strCodCnd;

      If (blnApenasLinha) Then
        ParamByName('CODGRU').AsString := LeftStr(strCodGru, 3)
      Else
        ParamByName('CODGRU').AsString := strCodGru;

      Open;
    End;
  end;

begin
  If fEmptyStr(strCodCnd) Then
  Begin
    Result := 0.00;
    Exit;
  End;

  qryAux := fCriaQuery(Self);
  Try
    pOpenQuery;
    If Not qryAux.IsEmpty Then
      Result := qryAux.FieldByName('DESMAX').AsFloat
    Else
    Begin
      pOpenQuery(True);

      If Not qryAux.IsEmpty Then
        Result := qryAux.FieldByName('DESMAX').AsFloat
      Else
        Result := fRetDescMaxCnd(strCodCnd, mdTipDes);
    End;
  Finally
    FreeAndNil(qryAux);
  End;
End;

function TFatVendaBase.fRetPercentualDescontoCondPagamento(strCodGru, strCodIte, strEntSai: String): Double;
Var
  fltPerDes: Double;
  fltDesMax: Double;
Begin

  fltPerDes := 0;

  If ((Pos(strOpcDoc, 'TR_CA_') > 0) And (strEntSai = 'E')) Or
     (strCodIte = fCfgSis('ITEFRE')) Or
     (strCodIte = fCfgSis('ITEMAN')) Or
     (strCodIte = fCfgSis('ITELAN')) Or
     (strCodIte = fCfgSis('ITEBOM')) Or
     (strCodIte = fCfgSis('ITETAX')) Then
  Begin
    Result := fltPerDes;
    Exit;
  End;

  {********************************************************************}
  {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
  {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd/fltDMVCnd     *}
  {****************************************************************MM**}
  If (VS_strTRADES = '2') And
     (fCfgSis('LIGUCN',varString) = 'S') And
     (Not fEmptyStr(strCodGru)) Then
  Begin
    fltDesMax := fRetDescMaxLinGru(strCodGru, Self.strCodCnd, mdVendedor);
  End
  Else
    fltDesMax := fltDMVCnd;

  If (strCodFpg = '007') Then
  Begin
    If (strAbDeCc = 'S') Then
      fltPerDes := fltDesMax;
  End
  Else
    fltPerDes := fltDesMax;

  Result := fltPerDes;
End;

function TFatVendaBase.fAplicaDescontoCondPagamento(fltPerDes: Double; strPromoc, strIteCom: String; blnEhItemCarregadoJuntoPDouOR: Boolean=False; blnConsiderarProPre: Boolean=True; fltPreLot: Double = 0; blnPermiteDescontoPromocao: Boolean = False): Boolean;
Begin
  {****************************************************}
  {* NAO DEVE APLICAR O DESCONTO QUANDO FOR UMA       *}
  {* CONFIRMACAO, POIS OCORRE DE ALTERAR O VALOR JA   *}
  {* FECHADO DO DOCUMENTO E TAMBEM PODE OCORRER DE    *}
  {* APLICAR NOVAMENTE O DESCONTO                     *}
  {*************************************************JC*}
  Result := (blnDeCndF) And
            (strCAbDes = 'S') And
            (strIteCom <> 'S') And
            (fltPerDes > 0) And
            (fltPreLot = 0) And
            (fCfgSis('CNDVEN') = 'F') And
            (Pos(strOpcDoc, 'TE_NC_BR_UC_CF_CT_CI_CN_DV_') <= 0) And
            ((strPromoc <> 'S') Or
             (fCfgSis('PRODES', varString) = 'S') Or
             IIF(blnConsiderarProPre, (fRegraPrecoSugestaoAtiva(blnEhItemCarregadoJuntoPDouOR) = TRegraPrecoSugestao.PrecoDeTabela), False));

  If (blnPermiteDescontoPromocao) And
     (fltPerDes > 0) And
     (fCfgSis('CNDVEN') = 'I') And
     (Pos(strOpcDoc, 'TE_NC_BR_UC_CF_CT_CI_CN_DV_') <= 0) And
     (strPromoc = 'S') And
     (fCfgSis('PRODES', varString) = 'S') Then
  Begin
    Result := True;
  End;
End;

function TFatVendaBase.fTemItensPromoc: Boolean;
  Var
    item: TDadosFechamento;
begin
  Result := False;

  If Length(Self.ArrMatItens) > 0 Then
  Begin
    For item in Self.ArrMatItens Do
    Begin
      If (item.strPromoc = 'S') Then
      Begin
        Result := True;
        Break;
      End;
    End;
  End;
end;

function TFatVendaBase.fTemItensEmPromocaoQuePermiteDesconto: Boolean;
  Var
    item :TDadosFechamento;
begin
  Result := False;

  If Length(Self.ArrMatItens) > 0 Then
  Begin
    For item in Self.ArrMatItens Do
    Begin
      If fItemEntraRateio(item) Then
      Begin
        If fPermiteDescontoPromocao(item.strCodPro, tapcdePromocaoCorrente, fEhItemCarregadoJuntoPDouOR(item)) Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  End;
end;

function TFatVendaBase.fApenasItensEmPromocao: Boolean;
  Var
    item :TDadosFechamento;
begin
  Result := False;

  If Length(Self.ArrMatItens) > 0 Then
  Begin
    Result := fItemEntraRateio(Self.ArrMatItens[0]);

    For item In Self.ArrMatItens Do
    Begin
      If fItemEntraRateio(item) Then
        Result := Result And (item.strPromoc = 'S');

      If (Not Result) then
        Break;
    End;
  End;
end;

procedure TFatVendaBase.pCopiarMatrizItens(const itensOri: TMatrizFechamento; var itensDes: TMatrizFechamento);
  Var
    index: Integer;
begin
  SetLength(itensDes, length(itensOri));
  For index := Low(itensOri) To High(itensOri) Do
    itensDes[index] := itensOri[index];
end;

function TFatVendaBase.fAposRateioTeraItemAbaixoCusto: Boolean;
  Var
    Itens: TMatrizFechamento;
    item :TDadosFechamento;
    fltTotalCusto,
    fltTotalReal: Double;
begin
  Result := False;

  pCopiarMatrizItens(Self.ArrMatItens, itens);
  pRateiaValores(itens, False);
  If fCfgSis('MINCUS') = TRAVA_MINIMO_CUSTO_REAL Then
    pRecalculaCustos(itens, Nil, 1, 1, False);

  For item in Itens Do
  Begin
    fltTotalCusto := item.fltTotCus;
    fltTotalReal  := item.fltTotCu2;

    If fCfgSis('MINCUS') = TRAVA_MINIMO_PRECO_CUSTO Then
    Begin
      If (item.fltTotIte - item.fltDesEsp) < fltTotalCusto Then
      Begin
        Result := True;
        Break;
      End;
    End
    Else If fCfgSis('MINCUS') = TRAVA_MINIMO_CUSTO_REAL Then
    Begin
      If (item.fltTotIte - item.fltDesEsp) < fltTotalReal Then
      Begin
        Result := True;
        Break;
      End;
    End;

  End;

end;

function TFatVendaBase.fAposRateioTeraItemZerado(): Boolean;
  Var
    Itens: TMatrizFechamento;
    item :TDadosFechamento;
    blnRateiaDesEspPromocao: Boolean;
begin
  Result := False;

  blnRateiaDesEspPromocao := fPermiteDescontoPromocao('', tapcdeOlhandoTodosItens);

  pCopiarMatrizItens(Self.ArrMatItens, itens);
  pRateiaValores(itens, blnRateiaDesEspPromocao);

  For item in Itens Do
  Begin
    If (Not fEhItemServico(item.strCodIte)) And (item.strBrinde <> 'S') Then
    Begin
      If ((item.fltTotIte - item.fltDesEsp) <= 0.00) Then
      Begin
        Result := True;
        Break;
      End;
    End;
  End;
end;

function TFatVendaBase.fEhItemCarregadoJuntoPDouOR(item: TDadosFechamento): Boolean;
begin
  Result := (Length(item.strSeqDet) = 20) And
            (Not fEmptyStr(item.strNumOrc)) And
            (Not fEmptyStr(item.strEspOrc)) And
            (Not fEmptyStr(item.strEmpOrc));
end;

function TFatVendaBase.fItemEntraRateio(item: TDadosFechamento): Boolean;
begin
  Result := IIF(strEspDoc = 'TR',
               (item.strEntSai <> 'E'), True) And
               (Not fEhItemServico(item.strCodIte)) And
               (item.strBrinde <> 'S') And
               (item.strCodIte <> fCfgSis('ITEMAN')) And
               (item.strCodIte <> fCfgSis('ITELAN')) And
               (item.strCodIte <> fCfgSis('ITEBOM')) And
               (item.strCodIte <> fCfgSis('ITETAX')) And
               (item.strCodIte <> fCfgSis('ITEFRE'));
end;

function TFatVendaBase.fItemEntraRateio(cdsItensVenda: TUniClientDataSet): Boolean;
begin
  Result := IIF(strEspDoc = 'TR',
               (cdsItensVenda.FieldByName('ITE_ENTSAI').AsString <> 'E'), True) And
               (Not fEhItemServico(cdsItensVenda.FieldByName('ITE_CODITE').AsString)) And
               (cdsItensVenda.FieldByName('ITE_BRINDE').AsString <> 'S') And
               (cdsItensVenda.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITEMAN')) And
               (cdsItensVenda.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITELAN')) And
               (cdsItensVenda.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITEBOM')) And
               (cdsItensVenda.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITETAX')) And
               (cdsItensVenda.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITEFRE'));
end;

function TFatVendaBase.fRateiaDesEspPromocao: Boolean;
begin
  Result := (fTemItensEmPromocaoQuePermiteDesconto) Or
            (fApenasItensEmPromocao) Or
            (fAposRateioTeraItemZerado) Or
            (fAposRateioTeraItemAbaixoCusto And (fCfgSis('MINCUS') <> 'N'));
end;

function TFatVendaBase.fFlagDoItemPermiteRatearDesconto(item: TDadosFechamento): Boolean;
begin
  Result := (item.strRatDes <> 'N');
end;

function TFatVendaBase.fItemRelacionadoCombo(item: TDadosFechamento): Boolean;
begin
  Result := (item.intSeqCom > 0);
end;

function TFatVendaBase.fRetornaEmpresaCfg: String;
Begin
  Result := VS_strCodEmp;

  If not fEmptyStr(Self.strEmp_TE) Then
    Result := Self.strEmp_TE;

  If Self.blnEnt_CD And (not fEmptyStr(Self.strEmp_CD)) Then
    Result := Self.strEmp_CD;
End;

function TFatVendaBase.fValidaConfiguracoesEmpresaFaturamento(strEmpFat: string; var strConfigs: string): Boolean;
const
  CFG_JA_TRATADAS: Array[0..28] of string = ('CLASUF', 'CLASUB', 'ICMSIM', 'SIMPAU', 'BASDFL', 'COCURE', 'DFRDAF', 'IMPDIR',
     'IPIFRE', 'IPSTMF', 'ZERCIF', 'ZRICUC', 'USNFCE', 'BBSFCP', 'ZERSNO', 'ZERSIM', 'RETCON', 'IMPFRE', 'ALCOFP',
     'ALPISP', 'MODBEN', 'DIFDES', 'FAMECO', 'DTADFL', 'ICMIND', 'ISSSER', 'IFPR41', 'ITESER', 'SERTER');
var
  strCodCfg: string;
begin
  Result := True;
  if VS_strCodEmp = strEmpFat then Exit;
  if not blnPraticarPrecosEmpresaFaturamento then Exit;
  strConfigs := '*** Sistema configurado para praticar os preços da empresa destino ***';
  strConfigs := strConfigs + sLineBreak + '----------------------------------------------------------------------';
  strConfigs := strConfigs + sLineBreak + 'Divergência de valor de configuração entre as empresas:';
  for strCodCfg in ARRAY_CONFIG_EMPRESA_DESTINO_IMPOSTOS do
    if not MatchStr(strCodCfg, CFG_JA_TRATADAS) then
      if fCfgSis(strCodCfg, varString, VS_strCodEmp) <> fCfgSis(strCodCfg, varString, strEmpFat) then
      begin
        strConfigs := strConfigs + sLineBreak + '----------------------------------------------------------------------';
        strConfigs := strConfigs + sLineBreak + Format('CFG_%s (%s): "%s"', [strCodCfg, VS_strCodEmp , fCfgSis(strCodCfg, varString, VS_strCodEmp )]);
        strConfigs := strConfigs + sLineBreak + Format('CFG_%s (%s): "%s"', [strCodCfg, strEmpFat, fCfgSis(strCodCfg, varString, strEmpFat)]);
        Result := False;
      end;
end;

{********************************************}
{*                                          *}
{* CALCULA VALOR DO DESCONTO, DEPENDENDO DO *}
{* TIPO DE CONFIGURACAO QUE O CLIENTE ESTA  *}
{* UTILIZANDO:                              *}
{*                                          *}
{* % PORCENTAGEM OU  $ VALOR                *}
{*                                          *}
{*****************************************WI*}
Function TFatVendaBase.fRetornaVrDesconto( intOpcao: Integer; fltValUni, fltDesCon: Double ):Double;
Begin

  Result := fltDesCon;

  If (fCfgSis('TIPDES') = '%') Then
  Begin
    If (intOpcao = 1) Then
    Begin
      Result := fFormataFloat((fltValUni * 100) / (100-fltDesCon), VS_intDecUni);
      Result := fFormataFloat(Result - fltValUni, 02 );
    End
    Else
    Begin
      Result := fFormataFloat((fltValUni * fltDesCon) / 100, fMaxDecUni);
    End;
  End;

End;

function TFatVendaBase.fCalculaDescontoItem(fltUnitar, fltUniLiq: Double): Double;
begin
  Result := 0;

  If (fCfgSis('TIPDES') = '%') Then
  Begin
    If fltUnitar <> 0 Then
      Result := ( 1 - ( fltUniLiq / fltUnitar ) ) * 100;
  End
  Else
    Result := fltUnitar - fltUniLiq;
end;

function TFatVendaBase.fTravarPeloPrecoPromocao(aStrCodPro: String; opcAnalisePromocComDesEsp: TAnalisePromocComDesEsp=tapcdePromocaoCorrente): Boolean;
  Var
    strCodProAux: String;
    item :TDadosFechamento;
begin
  Result := False;

  If fCfgSis('TRAPRO', varString) = 'S' Then
    Exit(True);

  If fCfgSis('TRAPRO', varString) = 'C' Then
  Begin
    strCodProAux := IIF(fEmptyStr(aStrCodPro), Self.strCodPro, aStrCodPro);
    If (fCampoTabela('PRO_TRAPRO', 'CADPRO', ['PRO_CODPRO'], [strCodProAux], False) = 'S') Then
      Result := True;

    If (opcAnalisePromocComDesEsp = tapcdeOlhandoTodosItens) Then
    Begin
      If Length(Self.ArrMatItens) > 0 Then
      Begin
        For item in Self.ArrMatItens Do
        Begin
          If (fCampoTabela('PRO_TRAPRO', 'CADPRO', ['PRO_CODPRO'], [item.strCodPro], False) = 'N') Then
          Begin
            Result := False;
            Break;
          End
          Else If (fCampoTabela('PRO_TRAPRO', 'CADPRO', ['PRO_CODPRO'], [item.strCodPro], False) = 'S') Then
          Begin
            Result := True;
          End;
        End;
      End;
    End;
  End;
end;

{*************************************************************}
{* Quando não estiver utilizando o preço de promoção para    *}
{* trava de preço (preço mínimo exigido), aplicar travas de  *}
{* preços sobre o preço de promoção                          *}
{**********************************************************JC*}
function TFatVendaBase.fPermiteDescontoPromocao(aStrCodPro: String; opcAnalisePromocComDesEsp: TAnalisePromocComDesEsp=tapcdePromocaoCorrente; blnEhItemCarregadoJuntoPDouOR: Boolean=False): Boolean;
  Var
   strCodProAux: String;
begin
  strCodProAux := Self.strCodPro;
  If (fCfgSis('TRAPRO', varString) = 'C') Then
    strCodProAux := IIF(fEmptyStr(aStrCodPro), Self.strCodPro, aStrCodPro);

  Result := (fRegraPrecoSugestaoAtiva(blnEhItemCarregadoJuntoPDouOR) = TRegraPrecoSugestao.PrecoDeTabela) Or
            (Not fTravarPeloPrecoPromocao(strCodProAux, opcAnalisePromocComDesEsp));

  If (VS_strTRADES = '4') And (Not fConsiderarItemPromocionalMargemMinimaDocumento) Then
    Result := False;

  If (fCfgSis('PROCND', varString) = 'M') Then
    Result := True;
end;

function TFatVendaBase.fConsiderarItemPromocionalMargemMinimaDocumento: Boolean;
begin
  Result := True;

  If (VS_strTRADES = '4') And  // Opção de trava de preço de produto = ( Margem Minima por Documento )
     (fCfgSis('MAGRVN') = 'S') And  // Exibir margem gráfica no rodapé da tela de vendas? = ( SIM )
     (fCfgSis('MMDTPR') = 'N') And  // Margem minima por documento - Considerar o item promocional na trava?  = (NAO)
     (fCfgSis('EDIUNP') = 'N') And  // Alterar o valor unitário de produtos em promoção? = ( NAO )
     (fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) then
  Begin
    Result := False;
  End;

end;

function TFatVendaBase.fEhMargemMinimaDocumentoDesconsiderandoBrinde : Boolean;
begin
  Result := (VS_strTRADES = '4') And (fCfgSis('MMCBRI', varString) = 'N');
end;

function TFatVendaBase.fItemCdsBrinde(const ACdsVenda : TUniClientDataSet): Boolean;
begin
  Result := False;
  If (Assigned(ACdsVenda.FindField('ITE_BRINDE'))) Then
    Result := (ACdsVenda.FieldByName('ITE_BRINDE').AsString = 'S');
  If (Result) Then
    Exit;
  If (Not Assigned(ACdsVenda.FindField('ITE_CLAFIS'))) Then
    Exit;
  If (fEmptyStr(ACdsVenda.FieldByName('ITE_CLAFIS').AsString)) Then
    Exit;
  Result := (Pos(RightStr(ACdsVenda.FieldByName('ITE_CLAFIS').AsString, 3), fCfgSis('CLABRI', VarString) + '_910') > 0);
end;

function TFatVendaBase.fTemItemPraValidarMargemMinimaPorDocumento(const blnConsiderarItemPromocionalMargemMinimaDocumento, blnConsiderarItemBrindeMargemMinimaDocumento : Boolean): Boolean;
  Var
    cdsDados: TUniClientDataSet;
Begin
  cdsDados  := TUniClientDataSet.Create(Self);
  Try
    Result := False;
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      If (cdsDados.FieldByName('ITE_CODITE').AsString = fCfgSis('ITESER', varString)) Then
      Begin
        cdsDados.Next;
        Continue;
      End;
      If (cdsDados.FieldByName('ITE_CODITE').AsString = fCfgSis('SERTER', varString)) Then
      Begin
        cdsDados.Next;
        Continue;
      End;
      If (cdsDados.FieldByName('ITE_PROMOC').AsString = 'S') And (blnConsiderarItemPromocionalMargemMinimaDocumento) Then
      Begin
        Result := True;
        Exit;
      End;
      If (fItemCdsBrinde(cdsDados)) And (blnConsiderarItemBrindeMargemMinimaDocumento) Then
      Begin
        Result := True;
        Exit;
      End;
      If (Not fItemCdsBrinde(cdsDados)) And (cdsDados.FieldByName('ITE_PROMOC').AsString <> 'S') Then
      Begin
        Result := True;
        Exit;
      End;
      cdsDados.Next;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
End;

procedure TFatVendaBase.pRetornaUnitarioFrete(item: TDadosFechamento; Var fltUnitarItem: Double);
begin
  If (FFreRat > 0) And (fRateiaFreteItensTransportadora(FCodTra, FTipFre) Or blnBaiEntFut) And (Pos(strOpcDoc, 'PD_OR_VN_CP_') > 0) Then
  Begin
    If item.fltFreRat > 0 Then
      fltUnitarItem := fFormataFloat(fltUnitarItem + item.fltFreRat / item.fltQtdIte, VS_intDecUni);
  End;
end;

procedure TFatVendaBase.pRetornaUnitarioTaxaEntrega(item: TDadosFechamento; Var fltUnitarItem: Double);
begin
  {****************************************************}
  {* NAO DEVE APLICAR O FRETE (RATEIO) QUANDO FOR UMA *}
  {* CONFIRMACAO, POIS OCORRE DE ALTERAR O VALOR JA   *}
  {* FECHADO DO DOCUMENTO E TAMBEM PODE OCORRER DE    *}
  {* APLICAR NOVAMENTE O FRETE                        *}
  {*************************************************JC*}
  If (FTaxEnt > 0) And
     (blnAplicaTaxaEntrega) And
     (fCfgSis('TAXENT', varString) = 'S') And
     (Pos(strOpcDoc, 'PD_OR_VN_CP_') > 0) Then
  Begin
    If item.fltQtdIte <> 0 Then
      fltUnitarItem := fFormataFloat(fltUnitarItem + (item.fltTaxEnt / item.fltQtdIte), VS_intDecUni);
  End;
end;

procedure TFatVendaBase.pAtualizaValorTaxaEntrega;
  Var
    strCodCidade: String;
    horHorDoc: TDateTime;
    item: TDadosFechamento;
    fltTotIteEnt: Double;
begin
  //Calcula o total liquido dos produtos, removendo qualquer frete que tenha sido aplicado anteriormente,
  //ou seja, o valor dos produtos sem frete menos o desconto especial
  fltTotIteEnt := 0.00;

  For item In arrMatItens Do
  Begin
    If fItemEntrega(item) Then
      fltTotIteEnt := fltTotIteEnt + (item.fltTotIte - item.fltDesEsp - item.fltTaxEnt);
  End;

  FTaxEnt   := 0.00;
  horHorDoc := 0;

  If ((Pos(strOpcDoc, 'PD_OR_VN_CP_') > 0) Or blnExpedi) And (fltTotIteEnt > 0) And
     (fCampoTabela('CLI_TAXENT', 'CADCLI', ['CLI_CODCLI'], [FCodCli]) = 'S') And
     (fCfgSis('TAXENT', varString) = 'S') Then
  Begin
    If fEmptyStr(strAutEnt) Then
      strCodCidade := fCampoTabela('CLI_CODCID', 'CADCLI', ['CLI_CODCLI'], [FCodCli])
    Else
      strCodCidade := fCampoTabela('ETC_CIDENT', 'ENTCLI', ['AUTOINCREM'], [strAutEnt]);

    If (fltTotIteEnt < fltVlMinF) Then
    Begin
      If fCampoTabela('CID_COBTAX', 'CADCID', ['CID_CODCID'], [strCodCidade], False) = 'I' Then //Individual
        FTaxEnt := fCampoTabela('CID_VALENT', 'CADCID', ['CID_CODCID'], [strCodCidade])
      Else If fCampoTabela('CID_COBTAX', 'CADCID', ['CID_CODCID'], [strCodCidade], False) = 'R' Then  //Regiao do Cliente
      Begin
        If fCampoTabela('REG_COBTAX', 'CADREG', ['REG_CODREG'], [strCodReg]) = 'I' Then //Individual
          FTaxEnt := fCampoTabela('CID_VALENT', 'CADCID', ['CID_CODCID'], [strCodCidade])
        Else
        Begin //Ja houve uma ou varias vendas no dia
          If fExisteVendaNoDiaComTaxaEntrega(horHorDoc) Then
          Begin
            FTaxEnt := fVerificaSeCobraTaxaEntregaNovamente(horHorDoc, strCodCidade);
          End
          Else
            FTaxEnt := fCampoTabela('CID_VALENT', 'CADCID', ['CID_CODCID'], [strCodCidade]);
        End;
      End;
    End;
  End;

end;

function TFatVendaBase.fExisteVendaNoDiaComTaxaEntrega(Var horHorEnt: TDateTime): Boolean;

  function fRetPedExp(strNumPedExt: String): String;
  var
    stlPedExp: TStringList;
    intCont: Integer;
  Begin
    Result := '';
    Try
      stlPedExp := TStringList.Create;
      stlPedExp.CommaText := strNumPedExt;
      For intCont := 0 To stlPedExp.Count - 1 Do
      Begin
        Result := Result + '"' + stlPedExp[intCont] + '", ';
      End;

      Result := Copy(Result, 1, Length(Result) - 2);
    Finally
      FreeAndNil(stlPedExp);
    End;
  End;

  function fRetSQLVenda: String;
  Begin
    Result := '';
    Result := Result + ' SELECT FGO_HORENT AS HORENT                ';
    Result := Result + ' FROM FATGOR                                ';
    Result := Result + '   INNER JOIN EXTGOR ON                     ';
    Result := Result + '     EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM  ';
    Result := Result + ' WHERE FGO_CODCLI = :CODCLI                 ';
    Result := Result + '   AND FGO_ESPDOC IN ("OR","PD")            ';
    Result := Result + '   AND FGO_CODEMP = :CODEMP                 ';
    Result := Result + '   AND FGO_DTAENT = :DTAVEN                 ';
    Result := Result + '   AND FGO_JAFATU = 0                       ';
    Result := Result + '   AND FGO_TAXENT > 0                       ';

    If (Pos(strEspOrc , 'PD_OR_') > 0) Then
      Result := Result + '    AND FGO_NUMDOC <> :NUMDOC             '
    Else If  (Not fEmptyStr(strPedExp)) Then
      Result := Result + '    AND FGO_NUMDOC NOT IN (' + fRetPedExp(strPedExp) + ') ';

    Result := Result + '  UNION ALL                                 ';

    Result := Result + ' SELECT GER_HORENT AS HORENT                ';
    Result := Result + ' FROM MOVGER                                ';
    Result := Result + '   INNER JOIN AUXMOV ON                     ';
    Result := Result + '     AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM  ';
    Result := Result + ' WHERE GER_CODCLI = :CODCLI                 ';
    Result := Result + '   AND GER_ESPDOC IN ("MI","FF","IF","NF")  ';
    Result := Result + '   AND GER_CODEMP = :CODEMP                 ';
    Result := Result + '   AND GER_DTAENT = :DTAVEN                 ';
    Result := Result + '   AND AUX_TAXENT > 0                       ';
    Result := Result + ' ORDER BY HORENT DESC LIMIT 1               ';
  End;

  Var
    qryCons: TUniQuery;
begin
  Try
    qryCons := fCriaQuery(Nil);
    With qryCons Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fRetSQLVenda);

      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('CODEMP').AsString := VS_strCodEmp;

      If (Pos(strEspOrc , 'PD_OR_') > 0) Then
        ParamByName('NUMDOC').AsString := strNumOrc;

      ParamByName('DTAVEN').AsDateTime := VS_Date;

      Open;

      Result := RecordCount > 0;

      horHorEnt := FieldByName('HORENT').AsDateTime;
    End;
  Finally
    FreeAndNil(qryCons);
  End;
end;

function TFatVendaBase.fVerificaSeCobraTaxaEntregaNovamente(horHorDoc: TDateTime; strCodCidade: String): Double;
  Var
    qryHor: TUniQuery;
begin
  Result := 0;

  If fFaixaHorarioRegiaoPreenchida Then
  Begin
    Try
      qryHor:= fCriaQuery;

      With qryHor Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT FHO_HORINI, ');
        SQL.Add('        FHO_HORFIN  ');
        SQL.Add(' FROM REGFHO        ');
        SQL.Add(' WHERE FHO_CODREG = :CODREG ');
        ParamByName('CODREG').AsString := strCodReg;
        Open;
      End;

      qryHor.First;
      While Not qryHor.Eof Do
      Begin
        If ((FormatDateTime('hh:mm',fRetHoraServidor) > FormatDateTime('hh:mm',qryHor.FieldByName('FHO_HORINI').AsDateTime)) And
            (FormatDateTime('hh:mm',fRetHoraServidor) < FormatDateTime('hh:mm',qryHor.FieldByName('FHO_HORFIN').AsDateTime))) And
           (FormatDateTime('hh:mm',horHorDoc) < FormatDateTime('hh:mm',qryHor.FieldByName('FHO_HORINI').AsDateTime)) Then
          Result := fCampoTabela('CID_VALENT', 'CADCID', ['CID_CODCID'], [strCodCidade]);

        qryHor.Next;
      End;

    Finally
      FreeAndNil(qryHor);
    End;
  End
  Else
    Raise Exception.Create('Não foi possível calcular o valor da taxa de entrega, é preciso cadastrar ' +
      'a faixa de horários da região.' + #13#10 + 'Favor cadastrar para continuar o processo!');
end;

function TFatVendaBase.fFaixaHorarioCadastrado: Boolean;
  Var
    qryHor: TUniQuery;
begin
  Try
    Try
      qryHor := fCriaQuery;
      With qryHor Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT COUNT(*) AS QTD ');
        SQL.Add('   FROM REGFHO ');
        SQL.Add('  WHERE FHO_CODREG = :CODREG ');
        ParamByName('CODREG').AsString := strCodReg;
        Open;

        Result := qryHor.FieldByName('QTD').AsInteger > 0;
      End;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fFaixaHorarioCadastrado]');
      End;
    End;
  Finally
    FreeAndNil(qryHor);
  End;
end;

function TFatVendaBase.fFaixaHorarioRegiaoPreenchida: Boolean;
  Var
    strCodCidade: String;
begin
  Result := True;

  Try
    If fEmptyStr(strAutEnt) Then
      strCodCidade := fCampoTabela('CLI_CODCID', 'CADCLI', ['CLI_CODCLI'], [FCodCli])
    Else
      strCodCidade := fCampoTabela('ETC_CIDENT', 'ENTCLI', ['AUTOINCREM'], [strAutEnt]);

    If fCampoTabela('CID_COBTAX', 'CADCID', ['CID_CODCID'], [strCodCidade], False) = 'R' Then  //Regiao do Cliente
    Begin
      If fCampoTabela('REG_COBTAX', 'CADREG', ['REG_CODREG'], [strCodReg]) = 'P' Then   //Primeira venda do dia
        If Not fFaixaHorarioCadastrado Then
          Result := False;
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fFaixaHorarioRegiaoPreenchida]');
    End;
  End;
end;

