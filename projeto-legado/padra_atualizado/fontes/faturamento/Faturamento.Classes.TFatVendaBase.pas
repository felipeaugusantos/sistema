end;

function TFatVendaBase.GetClienteEmiteEnvioEstoqueExterno: Boolean;
begin
  Result := False;

  If Self.strCodCli.IsEmpty Then
    Exit;

  If Not fCfgSis('ESTEXT', VarBoolean) Then
    Exit;

  If String(fCampoTabela('EEE_CODEEE', 'CADEEE', ['EEE_CODCLI'], [Self.strCodCli], False)).IsEmpty Then
    Exit;

  Result := True;
end;

function TFatVendaBase.GetClienteRemessaEstoqueExternoMercadoLivre(var ACodExt: String; ACodCli: String = ''): Boolean;
Var
  LQuery: TUniQuery;
  LCampos: IMyCampotabela;
begin

  Result := False;

  If ACodCli.IsEmpty Then
    ACodCli := Self.strCodCli;

  If ACodCli.IsEmpty Then
    Exit;

  If Not fCfgSis('ESTEXT', VarBoolean) Then
    Exit;

  LQuery := fCriaQuery;

  Try
    LQuery.SQL.Add(' SELECT SQL_NO_CACHE ');
    LQuery.SQL.Add('   NFE_ACESSO, ');
    LQuery.SQL.Add('   NFE_IMPORT, ');
    LQuery.SQL.Add('   NFE_CODEXT, ');
    LQuery.SQL.Add('   NFE_HUBMKP, ');
    LQuery.SQL.Add('   GER_CLAFIS, ');
    LQuery.SQL.Add('   GER_CODCLI  ');
    LQuery.SQL.Add(' FROM          ');
    LQuery.SQL.Add('   NFEIMP      ');
    LQuery.SQL.Add('   JOIN CADFIS ');
    LQuery.SQL.Add('     ON FIS_ACESSO = NFE_ACESSO ');
    LQuery.SQL.Add('   JOIN MOVGER                  ');
    LQuery.SQL.Add('     ON GER_NUMDOC = FIS_NUMDOC ');
    LQuery.SQL.Add('     AND GER_ESPDOC = FIS_ESPDOC ');
    LQuery.SQL.Add('     AND GER_CODEMP = FIS_CODEMP ');
    LQuery.SQL.Add('     AND GER_CODCLI = FIS_FORCLI ');
    LQuery.SQL.Add('     AND GER_TIP_FC = FIS_TIP_FC ');
    LQuery.SQL.Add(' WHERE TRUE                      ');
    LQuery.SQL.Add('   AND NFE_DTAEMI >= DATE_ADD(CURRENT_DATE(), INTERVAL - 30 DAY) ');
    LQuery.SQL.Add('   AND NFE_CODEMP = "' + VS_strCodEmp   + '" ');
    LQuery.SQL.Add('   AND GER_CODCLI = "' + ACodCli + '" ');
    LQuery.SQL.Add('   AND GER_CLAFIS IN ('+FulfillmentSelectClassificacao(opRemessa, 'MLB')+') ');
    LQuery.SQL.Add('   AND NFE_ACESSO <> ""   ');
    LQuery.SQL.Add(' HAVING TRUE              ');
    LQuery.SQL.Add('   AND NFE_IMPORT = "S"   ');
    LQuery.SQL.Add('   AND NFE_HUBMKP = "MLB" ');
    LQuery.SQL.Add('   AND NFE_CODEXT <> ""   ');
    LQuery.SQL.Add(' LIMIT 1                  ');

    LCampos := ExecutarQueryEmCache(LQuery);

    ACodExt := LCampos.FieldByName('NFE_CODEXT').AsString;

    Result := Not ACodExt.IsEmpty;
  Finally
    FreeAndNil(LQuery);
  End;
end;

procedure TFatVendaBase.pAcertaPrecosTinta(intAutInc: Integer = -1; blnAcertaPrecoCusto: Boolean = False);
  Const
    CFG_PRODUCAO_FORA_LOJA_EMPRESA_CALCULAR_CUSTOS = 'PFLCUS';
    EMPRESA_DE_PRODUCAO = '2';
  Var
    strFilter: String;
    item: TDadosFechamento;
    dicRetorno: TDicionario;
    stlItensTraMl: TStringList;
    arrBaixaPigmentos: TBaixaPigmentosArray;
    arrFormul: TForMulTinDetArray;
    intIdx: Integer;
    arrMatItensCop : Array Of TDadosFechamento;
begin

  If Not Assigned(fCalcularTabelasdePreco) Then
    Exit;

  If Not Assigned(pSetaEmpresaLogadaTinta) Then
    Exit;

  SetLength(arrMatItensCop, 0);
  SetLength(arrMatItensCop, Length(Self.arrMatItens));
  For intIdx := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
    arrMatItensCop[intIdx] := Self.arrMatItens[intIdx];

  Try
    dicRetorno := TDicionario.Create;
    stlItensTraMl := TStringList.Create;

    strFilter := 'ITE_IDEPRO <> ' + QuotedStr('NOR');

    If intAutInc > -1 Then
      strFilter := strFilter + ' AND AUTOINCREM = ' + IntToStr(intAutInc);

    pPreencheMatrizFechamento(strFilter);

    If Assigned(pgbStatusGravacao) Then
    Begin
      pgbStatusGravacao.Position := 0;
      pgbStatusGravacao.Properties.Max := Length(arrMatItens);
    End;

    For item In arrMatItens Do
    Begin
      If Assigned(pgbStatusGravacao) Then
      Begin
        pStepStatusGravacao;
        pInfoStatusGravacao('Aguarde... Calculando ' +
          'Preços das Tintas...' + FloatToStr(pgbStatusGravacao.Position) + '/' + FloatToStr(pgbStatusGravacao.Properties.Max));
      End;

      dicRetorno.Limpar;
      stlItensTraMl.Clear;
      SetLength(arrBaixaPigmentos, 0);

      If (item.strIdePro <> 'NOR') Then
      Begin
        dicRetorno := TDicionario.Create;
        SetLength(arrBaixaPigmentos, 0);
        stlItensTraMl := TStringList.Create;

        dicRetorno['itebas'] := item.strCodIte;
        dicRetorno['iteemb'] := item.strIteEmb;
        dicRetorno['complementob'] := item.recForTin.strCompB;
        dicRetorno['fatace'] := item.fltFatAce;

        dicRetorno['empite'] := item.strEmpIte;

        If fEmptyStr(dicRetorno['empite']) And (fCfgSis(CFG_PRODUCAO_FORA_LOJA_EMPRESA_CALCULAR_CUSTOS) = EMPRESA_DE_PRODUCAO) then
          dicRetorno['empite'] := item.strEmpPrd;

        If fEmptyStr(dicRetorno['empite']) then
          dicRetorno['empite'] := VS_strCodEmp;

        dicRetorno['codemp'] := dicRetorno['empite'];

        {*******************************************************************}
        {* É NECESSARIO QUE ALTERE A EMPRESA DA DLL DE TINTA DE MAQUINA    *}
        {* PARA QUE CALCULE CORRETAMENTE OS PRECOS DE ACORDO COM A EMPRESA *}
        {* QUE IRA FATURAR O PRODUTO (DARKA).                              *}
        {***************************************************************JC**}
        If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
          pSetaEmpresaLogadaTinta(VS_strCodEmp)
        Else If Not fEmptyStr(item.strEmpPrd) And (fCfgSis(CFG_PRODUCAO_FORA_LOJA_EMPRESA_CALCULAR_CUSTOS) = EMPRESA_DE_PRODUCAO) Then
          pSetaEmpresaLogadaTinta(item.strEmpPrd)
        Else If Not fEmptyStr(item.strEmpIte) Then
          pSetaEmpresaLogadaTinta(item.strEmpIte);

        dicRetorno['descri'] := item.strDesIte;
        dicRetorno['tabpre'] := item.strTabPre;
        dicRetorno.AdicionarObjeto('calculadorAliquota', Self);

        If fCalcularTabelasdePreco( item.strIdePro,   // Tipo de Produto
                                    item.strIteTin,   // Item da Tinta
                                    item.strTipPre,   // Tipo de Preço
                                    item.strLinTin,   // Linha da Tinta
                                    item.strCatali,   // Catalizador Utilizado
                                    item.intLazQua,   // Quarto (Lazzumix)
                                    item.fltQtdEmb,   // Quantidade de Embalagem
                                    item.fltQtdIte,   // Quantidade do Item
                                    item.strDesIte,   // Descrição do Item
                                    qryTintaAux,      // Arquivo de Formulas!
                                    item.fltVolPro,   // Volume a ser produzido (Tinta c/ Venda Dinamica)
                                    arrFormul,        // Retorno da Formulação
                                    arrBaixaPigmentos,// Retorno dos Pigmentos a serem baixados
                                    stlItensTraMl,
                                    item.strCodDil,
                                    item.fltPorDil,
                                    item.strDilCon,
                                    item.fltPorCat,
                                    item.recForTin.strTipCor,
                                    item.recForTin.strTextBase,
                                    item.recForTin.intModDil,
                                    dicRetorno) And cdsVenda.Locate('AUTOINCREM', item.intAutInc, []) Then
        Begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_PREMED').AsFloat := IfNull(dicRetorno['premed'], 0.0);
          cdsVenda.FieldByName('ITE_IMPULT').AsFloat := IfNull(dicRetorno['impult'], 0.0);
          cdsVenda.FieldByName('ITE_PREULT').AsFloat := IfNull(dicRetorno['preult'], 0.0);
          cdsVenda.FieldByName('ITE_TOTMED').AsFloat := cdsVenda.FieldByName('ITE_PREMED').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          cdsVenda.FieldByName('ITE_TOTULT').AsFloat := cdsVenda.FieldByName('ITE_PREULT').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          cdsVenda.FieldByName('ITE_TOTIMP').AsFloat := cdsVenda.FieldByName('ITE_IMPULT').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;

          If blnAcertaPrecoCusto Then
          Begin
            cdsVenda.FieldByName('ITE_CUSITE').AsFloat := IfNull(dicRetorno['precus'], 0.0);
            cdsVenda.FieldByName('ITE_PRECUS').AsFloat := IfNull(dicRetorno['precus'], 0.0);
            cdsVenda.FieldByName('ITE_TOTCUS').AsFloat := cdsVenda.FieldByName('ITE_PRECUS').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;;
          End;
          cdsVenda.Post;
        End;
      End;
    End;

  Finally
    SetLength(arrMatItens, 0);
    SetLength(arrMatItens, Length(arrMatItensCop));
    For intIdx := Low(arrMatItensCop) To High(arrMatItensCop) Do
      Self.arrMatItens[intIdx] := arrMatItensCop[intIdx];
    {**********************************************************}
    {* DEVE VOLTAR A EMPRESA LOGADA NOVAMENTE NA DLL DA TINTA *}
    {*  >>> ATENCAO: NAO REMOVER ESTA FUNCAO DO FINNALY <<<   *}
    {******************************************************JC**}
    pSetaEmpresaLogadaTinta(VS_strCodEmp);
    FreeAndNil(stlItensTraMl);
    FreeAndNil(dicRetorno);
  End;
end;

function TFatVendaBase.fAcertarCustoTintaMaquina(AEmpresaFaturamento, AEmpresaProducao: String): Boolean;
