procedure TFatVendaBase.pSintetizaArrDesCffGer;
  Var
    intUltIndAlt,
    intContador: Integer;
    strDocCnfAux,
    strEspCnfAux,
    strEmpCnfAux: String;
    fltDesEspSin,
    fltDesCffClc,
    fltTotIteSin,
    fltDesCffAux: Double;

   procedure pIncluiOuAtualizaArr;
     Var
       intInd: Integer;
       blnDesCff: Boolean;
   begin
      blnDesCff := False;
      For intInd := 0 To Length(arrDesCffGer) -1 Do
      Begin
        If (arrDesCffGer[intInd].strNumDoc = strDocCnfAux) And
           (arrDesCffGer[intInd].strEspDoc = strEspCnfAux) And
           (arrDesCffGer[intInd].strCodEmp = strEmpCnfAux) Then
        Begin
          blnDesCff := True;
          Break;
        End;
      End;

      If blnDesCff Then
      Begin
        arrDesCffGer[intInd].fltValCff := arrDesCffGer[intInd].fltValCff + fltDesCffAux;
        intUltIndAlt := intInd;
      End
      Else
      Begin
        SetLength(arrDesCffGer, Length(arrDesCffGer) + 1);
        arrDesCffGer[Length(arrDesCffGer)-1].strNumDoc := strDocCnfAux;
        arrDesCffGer[Length(arrDesCffGer)-1].strEspDoc := strEspCnfAux;
        arrDesCffGer[Length(arrDesCffGer)-1].strCodEmp := strEmpCnfAux;
        arrDesCffGer[Length(arrDesCffGer)-1].fltValCff := fltDesCffAux;
        intUltIndAlt := Length(arrDesCffGer)-1;
      End;
   end;

   procedure pInsereItemNaoSintetizado;
   begin
     strDocCnfAux := arrMatItens[intContador].strDocCnf;
     strEspCnfAux := arrMatItens[intContador].strEspCnf;
     strEmpCnfAux := arrMatItens[intContador].strEmpCnf;
     fltDesCffAux := arrMatItens[intContador].fltDesCff;

     pIncluiOuAtualizaArr;
   end;

begin
  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin

    If fEhItemServico(arrMatItens[intContador].strCodIte) Then
      Continue;

    If Assigned(cdsIteSin) Then
    Begin
      cdsIteSin.Filtered:=False;
      cdsIteSin.Filter := 'AUTINC = ' + IntToStr(arrMatItens[intContador].intAutInc);
      cdsIteSin.Filtered:=True;

      If cdsIteSin.IsEmpty Then
      Begin
        //ITEM NÃO SINTETIZADO
        pInsereItemNaoSintetizado
      End
      Else
      Begin
        //ITEM SINTETIZADO ORIUNDO DE DOCUMENTOS DISTINTOS
        fltTotIteSin := 0.00;

        cdsIteSin.First;
        While Not cdsIteSin.Eof Do
        Begin
          fltTotIteSin := fltTotIteSin + cdsIteSin.FieldByName('TOTITE').AsFloat;
          cdsIteSin.Next;
        End;

        fltDesCffClc := 0.00;
        fltDesEspSin := arrMatItens[intContador].fltDesCff;

        cdsIteSin.First;
        While Not cdsIteSin.Eof Do
        Begin
          strDocCnfAux := cdsIteSin.FieldByName('DOCCNF').AsString;
          strEspCnfAux := cdsIteSin.FieldByName('ESPCNF').AsString;
          strEmpCnfAux := cdsIteSin.FieldByName('EMPCNF').AsString;
          fltDesCffAux := fFormataFloat(fltDesEspSin * (cdsIteSin.FieldByName('TOTITE').AsFloat / fltTotIteSin), 2);
          fltDesCffClc := fltDesCffClc + fltDesCffAux;

          pIncluiOuAtualizaArr;

          cdsIteSin.Next;
        End;

        //APURA SE HOUVE ALGUMA DIFERENÇA E CASO HAJA, JOGA PARA O ÚLTIMO DOCUMENTO DESSE ITEM
        If fFormataFloat(fltDesCffClc,2) > fFormataFloat(fltDesEspSin,2) Then
        Begin
          arrDesCffGer[intUltIndAlt].fltValCff := fFormataFloat(arrDesCffGer[intUltIndAlt].fltValCff - (fltDesCffClc - fltDesEspSin),2);
        End
        Else If fFormataFloat(fltDesCffClc,2) < fFormataFloat(fltDesEspSin,2) Then
        Begin
          arrDesCffGer[intUltIndAlt].fltValCff := fFormataFloat(arrDesCffGer[intUltIndAlt].fltValCff + (fltDesEspSin - fltDesCffClc),2);
        End;
      End;
    End
    Else
    Begin
      //ITEM NÃO SINTETIZADO
      pInsereItemNaoSintetizado;
    End;
  End;
end;

procedure TFatVendaBase.pSintetizaArrDesCffDet;
  Var
    intIncMatAux,
    intUltIndAlt,
    intContador: Integer;
    strIteCnfAux,
    strIncCnfAux: String;
    fltDesEspSin,
    fltDesCffClc,
    fltTotIteSin,
    fltDesCffAux: Double;

   procedure pIncluiOuAtualizaArr;
     Var
       intInd: Integer;
       blnDesCff: Boolean;
   begin
      blnDesCff := False;
      For intInd := 0 To Length(arrDesCffDet) -1 Do
      Begin
        If (arrDesCffDet[intInd].strSeqDet = strIncCnfAux) Then
        Begin
          blnDesCff := True;
          Break;
        End;
      End;

      If blnDesCff Then
      Begin
        arrDesCffDet[intInd].fltValCff := arrDesCffDet[intInd].fltValCff + fltDesCffAux;
        intUltIndAlt := intInd;
      End
      Else
      Begin
        SetLength(arrDesCffDet, Length(arrDesCffDet) + 1);
        arrDesCffDet[Length(arrDesCffDet)-1].intIncMat := intIncMatAux;
        arrDesCffDet[Length(arrDesCffDet)-1].strSeqDet := strIncCnfAux;
        arrDesCffDet[Length(arrDesCffDet)-1].strCodIte := strIteCnfAux;
        arrDesCffDet[Length(arrDesCffDet)-1].fltValCff := fltDesCffAux;
        intUltIndAlt := Length(arrDesCffDet)-1;
      End;
   end;

   procedure pInsereItemNaoSintetizado;
   begin
     intIncMatAux := arrMatItens[intContador].intAutInc;
     strIncCnfAux := arrMatItens[intContador].strSeqDet;
     strIteCnfAux := arrMatItens[intContador].strCodIte;
     fltDesCffAux := arrMatItens[intContador].fltDesCff;

     pIncluiOuAtualizaArr;
   end;

begin
  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin

    If fEhItemServico(arrMatItens[intContador].strCodIte) Then
      Continue;

    If Assigned(cdsIteSin) Then
    Begin
      cdsIteSin.Filtered:=False;
      cdsIteSin.Filter := 'AUTINC = ' + IntToStr(arrMatItens[intContador].intAutInc);
      cdsIteSin.Filtered:=True;

      If cdsIteSin.IsEmpty Then
      Begin
        //ITEM NÃO SINTETIZADO
        pInsereItemNaoSintetizado
      End
      Else
      Begin
        //ITEM SINTETIZADO ORIUNDO DE DOCUMENTOS DISTINTOS
        fltTotIteSin := 0.00;

        cdsIteSin.First;
        While Not cdsIteSin.Eof Do
        Begin
          fltTotIteSin := fltTotIteSin + cdsIteSin.FieldByName('TOTITE').AsFloat;
          cdsIteSin.Next;
        End;

        fltDesCffClc := 0.00;
        fltDesEspSin := arrMatItens[intContador].fltDesCff;

        cdsIteSin.First;
        While Not cdsIteSin.Eof Do
        Begin
          strIncCnfAux := cdsIteSin.FieldByName('INCCNF').AsString;
          strIteCnfAux := cdsIteSin.FieldByName('ITECNF').AsString;
          intIncMatAux := cdsIteSin.FieldByName('AUTINC').AsInteger;
          fltDesCffAux := fFormataFloat(fltDesEspSin * (cdsIteSin.FieldByName('TOTITE').AsFloat / fltTotIteSin), 2);
          fltDesCffClc := fltDesCffClc + fltDesCffAux;

          pIncluiOuAtualizaArr;

          cdsIteSin.Next;
        End;

        //APURA SE HOUVE ALGUMA DIFERENÇA E CASO HAJA, JOGA PARA O ÚLTIMO DOCUMENTO DESSE ITEM
        If fFormataFloat(fltDesCffClc,2) > fFormataFloat(fltDesEspSin,2) Then
        Begin
          arrDesCffDet[intUltIndAlt].fltValCff := fFormataFloat(arrDesCffDet[intUltIndAlt].fltValCff - (fltDesCffClc - fltDesEspSin),2);
        End
        Else If fFormataFloat(fltDesCffClc,2) < fFormataFloat(fltDesEspSin,2) Then
        Begin
          arrDesCffDet[intUltIndAlt].fltValCff := fFormataFloat(arrDesCffDet[intUltIndAlt].fltValCff + (fltDesEspSin - fltDesCffClc),2);
        End;
      End;
    End
    Else
    Begin
      //ITEM NÃO SINTETIZADO
      pInsereItemNaoSintetizado;
    End;
  End;
end;

procedure TFatVendaBase.pSintetizaClassificacoes(blnPegCla: Boolean = True; pOnProcessaItem: TOnProcessaItem = nil; LCurStep: Integer = 1; LMaxSteps: Integer = 1);
  const
    INFO_PROCESSAMENTO = 'Aguarde, Definindo Classificação Fiscal do produto %s ...';
  Var
    intContador: Integer;
    stlPrincipais: TStringList;
    stlAdicionais: TStringList;
    strClaAux: String;
    LAtendeRegrasDifalDefineClaFis: Boolean;
    sltServicos: TStringList;
    strEspDocQueNaoPodeDesdobrar: String;
    strMsgCfopNaoVenda : String;

  function fItemBonificado: Boolean;
  begin
    Result := (arrMatItens[intContador].strBrinde = 'S') Or
              (Pos(RightStr(strClaAux, 3), fCfgSis('CLABRI', VarString) + '_910') > 0);
  end;
begin
  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  If (Length(arrMatItens) <= 0) Then
    Exit;

  strEspDocQueNaoPodeDesdobrar := 'TR_';
  If fCfgSis('DESFIS', varBoolean) Then
    strEspDocQueNaoPodeDesdobrar := strEspDocQueNaoPodeDesdobrar + 'PD_OR_';

  //devolução de mercadoria não deve utilizar classificação fiscal de venda.
  if (strOpcDoc = 'GF') and (not fEmptyStr(strClaFis)) and (Pos(strClaFis, CFOP_DEVOLUCAO) <= 0) Then
  begin
    strClaFi2 := '';
    strClaFi3 := '';
    strClaFi4 := '';
    Exit;
  end;

  {***************************************}
  {* DEFINE A CLASSIFICACAO DOS PRODUTOS *}
  {***********************************JC**}
  If (blnPegCla) Then
  Begin
    LAtendeRegrasDifalDefineClaFis := fAtendeRegrasDifal(False);
    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If Assigned(pOnProcessaItem) Then
        pOnProcessaItem(arrMatItens[intContador], intContador + (Pred(LCurStep) * Length(arrMatItens)), Length(arrMatItens) * LMaxSteps, INFO_PROCESSAMENTO)
      Else If Assigned(pgbStatusGravacao) And (Length(arrMatItens) > 1) Then
      Begin
        pInformacao(Format(INFO_PROCESSAMENTO,
          [arrMatItens[intContador].strCodIte + '-' + fPadR(arrMatItens[intContador].strDesIte, 10)]), pgbStatusGravacao);
        pProgresso(Succ(intContador) + (Pred(LCurStep) * Length(arrMatItens)), Length(arrMatItens) * LMaxSteps, pgbStatusGravacao);
      End;
      pDefineClassificacaoItem(arrMatItens[intContador], LAtendeRegrasDifalDefineClaFis);
    End;
  End;

  strClaFis := '';
  strClaFi2 := '';
  strClaFi3 := '';
  strClaFi4 := '';
  stlPrincipais := TStringList.Create;
  stlAdicionais := TStringList.Create;
  sltServicos := TStringList.Create;

  Try
    //CARREGA A STRINGLIST COM AS CLAFIS PRIORITÁRIAS (EXEMPLO: VS_strClaVen)
    stlPrincipais.Clear;
    stlAdicionais.Clear;
    sltServicos.Clear;
    strMsgCfopNaoVenda := EmptyStr;
    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      strClaAux := arrMatItens[intContador].strClaFis;

      If (Not fItemBonificado) And (Pos(strClaAux, VS_strClaVen) <= 0) Then
        pIncrementaListaStr(strClaAux, strMsgCfopNaoVenda);

      If blnBaiEntFut And arrMatItens[intContador].strProEmb.Equals('S') Then
        Continue;

      If (Pos(strClaAux, '5933_6933_') > 0) And
         (Pos(strOpcDoc, 'OR_PD_') > 0) And
         (sltServicos.IndexOf(strClaAux) < 0) Then
      Begin
        sltServicos.Add(strClaAux);
      End;

      If (stlPrincipais.IndexOf(strClaAux) < 0) And (Pos(strClaAux, VS_strClaVen) > 0) Then
      Begin
        stlPrincipais.Add(strClaAux); //CARREGA A STRINGLIST COM AS CLAFIS PRIORITÁRIAS (EXEMPLO: VS_strClaVen)
      End;

      If (stlAdicionais.IndexOf(strClaAux) < 0) And (stlPrincipais.IndexOf(strClaAux) < 0) Then
      Begin
        stlAdicionais.Add(strClaAux); //CARREGA A STRINGLIST COM AS CLAFIS SECUNDÁRIAS
      End;
    End;

    If (stlPrincipais.Count >= 4) Then
      stlAdicionais.Clear;

    //SE TIVER MAIS QUE 4 CLAFIS DISTINTAS LEVANTA EXCESSÃO
    If (stlPrincipais.Count + stlAdicionais.Count - sltServicos.Count > 4) And (Pos(strOpcDoc, strEspDocQueNaoPodeDesdobrar) <= 0) Then
    Begin
      Raise ExceptionAutCom.Create('Ultrapassado o limite de classificações fiscais.' + #13#10 +
        'Classificações utilizadas: ' + stlPrincipais.CommaText);
    End;
    //SE TIVER MAIS QUE 4 CLAFIS DISTINTAS LEVANTA EXCESSÃO

    stlPrincipais.Sort;
    stlAdicionais.Sort;

    For intContador := 0 To stlPrincipais.Count-1 Do
    Begin
      If strClaFis.IsEmpty Then
      Begin
        strClaFis := stlPrincipais[intContador]
      End
      Else If strClaFi2.IsEmpty Then
      Begin
        strClaFi2 := stlPrincipais[intContador]
      End
      Else If strClaFi3.IsEmpty Then
      Begin
        strClaFi3 := stlPrincipais[intContador]
      End
      Else If strClaFi4.IsEmpty Then
      Begin
        strClaFi4 := stlPrincipais[intContador]
      End;
    End;

    For intContador := 0 To stlAdicionais.Count-1 Do
    Begin
      If strClaFis.IsEmpty Then
      Begin
        strClaFis := stlAdicionais[intContador]
      End
      Else If strClaFi2.IsEmpty Then
      Begin
        strClaFi2 := stlAdicionais[intContador]
      End
      Else If strClaFi3.IsEmpty Then
      Begin
        strClaFi3 := stlAdicionais[intContador]
      End
      Else If strClaFi4.IsEmpty Then
      Begin
        strClaFi4 := stlAdicionais[intContador]
      End;
    End;

    If (Not fEmptyStr(strMsgCfopNaoVenda)) And
       (Self.blnBloquearCfopQueNaoSejaDeVenda) Then
    Begin
      fRollBack;
      fMensagem('Atenção!', 'Esse documento possui classificações fiscais que não estão entre as "Classificações de Venda" do sistema (CFG_CLAVEN).' + sLineBreak +
                            'Não cadastradas: ' + strMsgCfopNaoVenda, ['&Ok']);
      Abort;
    End;
  Finally
    FreeAndNil(stlPrincipais);
    FreeAndNil(stlAdicionais);
    FreeAndNil(sltServicos);
  End;
end;

procedure TFatVendaBase.pGeraLegendaClassificacaoIPI;
  Var
    intItem: Integer;
    intContClaIpi: Integer;
begin
  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  {*****************************************}
  {* ZERA MATRIZ DE CLASSIFICAÇÃO DE IPI   *}
  {**************************************MV*}
  For intContClaIpi := Low(arrClaIpi) To High(arrClaIpi) Do
  Begin
    arrClaIpi[intContClaIpi] := '';
  End;

  For intItem := 0 To Length(arrMatItens) -1 Do
  Begin
    {*****************************************}
    {* SINTETIZA E GERA LEGENDA DE CLASSIFI- *}
    {* CAÇÃO DE IPI                          *}
    {**************************************MV*}
    For intContClaIpi := Low(arrClaIpi) To High(arrClaIpi) Do
    Begin

      If (fEmptyStr(arrClaIpi[intContClaIpi])) Then
      Begin
        If (fEmptyStr(arrMatItens[intItem].strClaIpi)) Then
        Begin
          Continue;
        End;

        arrClaIpi[intContClaIpi]           := arrMatItens[intItem].strClaIpi;
        arrMatItens[intItem].strLetIpi := Chr(65+intContClaIpi);
        Break;
      End
      Else If (arrClaIpi[intContClaIpi] = arrMatItens[intItem].strClaIpi) Then
      Begin
        arrMatItens[intItem].strLetIpi := Chr(65+intContClaIpi);
        Break;
      End;

    End;
  End;

  strClaIpA := IIF(Not fEmptyStr(arrClaIpi[00]), 'A: ' + arrClaIpi[00], '');
  strClaIpB := IIF(Not fEmptyStr(arrClaIpi[01]), 'B: ' + arrClaIpi[01], '');
  strClaIpC := IIF(Not fEmptyStr(arrClaIpi[02]), 'C: ' + arrClaIpi[02], '');
  strClaIpD := IIF(Not fEmptyStr(arrClaIpi[03]), 'D: ' + arrClaIpi[03], '');
  strClaIpE := IIF(Not fEmptyStr(arrClaIpi[04]), 'E: ' + arrClaIpi[04], '');
  strClaIpF := IIF(Not fEmptyStr(arrClaIpi[05]), 'F: ' + arrClaIpi[05], '');
  strClaIpG := IIF(Not fEmptyStr(arrClaIpi[06]), 'G: ' + arrClaIpi[06], '');
  strClaIpH := IIF(Not fEmptyStr(arrClaIpi[07]), 'H: ' + arrClaIpi[07], '');
  strClaIpJ := IIF(Not fEmptyStr(arrClaIpi[08]), 'I: ' + arrClaIpi[08], '');
  strClaIpL := IIF(Not fEmptyStr(arrClaIpi[09]), 'J: ' + arrClaIpi[09], '');
  strClaIpM := IIF(Not fEmptyStr(arrClaIpi[10]), 'K: ' + arrClaIpi[10], '');
  strClaIpN := IIF(Not fEmptyStr(arrClaIpi[11]), 'L: ' + arrClaIpi[11], '');
end;

procedure TFatVendaBase.pGeraResumoImpostosPagosNCM;
  Type
    TResumoNcm = record
      strClaIpi: String;
      fltTotIte: Double;
      fltDesEsp: Double;
      fltImpPag: Double;
      fltPeImPg: Double;
      fltFedImp: Double;
      fltPeImFd: Double;
      fltEstImp: Double;
      fltPeImEs: Double;
      fltMunImp: Double;
      fltPeImMn: Double;
    end;

  Var
    item  : TDadosFechamento;
    index : Integer;
    strResNcm: String;
    stlResNcm: TStringList;
    arrResNcm: Array Of TResumoNcm;

  function Add(strClaIpi: String): Integer;
  begin
    SetLength(arrResNcm, Length(arrResNcm) + 1);
    arrResNcm[Length(arrResNcm) -1].strClaIpi := strClaIpi;
    Result := Length(arrResNcm) -1;
  end;

  function GetIndex(strClaIpi: String): Integer;
    Var
      Index: Integer;
  begin
    For Index := Low(arrResNcm) To High(arrResNcm) Do
      If arrResNcm[Index].strClaIpi = strClaIpi Then
      Begin
        Result := Index;
        Exit;
      End;
    Result := Add(strClaIpi);
  end;

begin
  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  stlResNcm := TStringList.Create;
  stlResNcm.Sorted := True;

  For item in arrMatItens Do
  Begin
    index := GetIndex(item.strClaIpi);
    With arrResNcm[index] Do
    Begin
      fltImpPag := fltImpPag + item.fltImpPag;
      fltFedImp := fltFedImp + item.fltFedImp;
      fltEstImp := fltEstImp + item.fltEstImp;
      fltMunImp := fltMunImp + item.fltMunImp;
      fltTotIte := fltTotIte + item.fltTotIte;
      fltDesEsp := fltDesEsp + item.fltDesEsp;

      If fltTotIte - fltDesEsp <> 0.00 Then
      Begin
        If Not fUsaImpostoFonteIBPT Then
          fltPeImPg := fltImpPag / (fltTotIte - fltDesEsp) * 100
        Else
        Begin
          fltPeImFd := fltFedImp / (fltTotIte - fltDesEsp) * 100;
          fltPeImEs := fltEstImp / (fltTotIte - fltDesEsp) * 100;
          fltPeImMn := fltMunImp / (fltTotIte - fltDesEsp) * 100;
        End;
      End;
    End;
  End;

  For index := Low(arrResNcm) To High(arrResNcm) Do
    With arrResNcm[index] Do
    Begin
      If Not fUsaImpostoFonteIBPT Then
      Begin
        If fltPeImPg <> 0.00 Then
          stlResNcm.Add( ' - NCM ' + strClaIpi + ' = ' +
             fPadL(      FormatFloat('#,##0.00%', fltPeImPg), 06, ' ') + ' ' +
             fPadL(' ' + FormatFloat('#,##0.00' , fltImpPag), 14, '.') );
      End
      Else
      Begin
        strResNcm := ' - NCM ' + strClaIpi + ' = ';

        If fltPeImFd <> 0.00 Then
          strResNcm := strResNcm +
                       fPadL(      FormatFloat('#,##0.00%', fltPeImFd), 06, ' ') + ' ' +
                       fPadL(' ' + FormatFloat('#,##0.00' , fltFedImp), 12, '.') + ' Fed';

        If fltPeImEs <> 0.00 Then
          strResNcm := strResNcm + ' / ' +
                       fPadL(      FormatFloat('#,##0.00%', fltPeImEs), 06, ' ') + ' ' +
                       fPadL(' ' + FormatFloat('#,##0.00' , fltEstImp), 12, '.') + ' Est';

        If fltPeImMn <> 0.00 Then
          strResNcm := strResNcm + ' / ' +
                       fPadL(      FormatFloat('#,##0.00%', fltPeImMn), 06, ' ') + ' ' +
                       fPadL(' ' + FormatFloat('#,##0.00' , fltMunImp), 12, '.') + ' Mun';

        If (fltPeImPg = 0.00) And (fltPeImEs = 0.00) And (fltPeImMn = 0.00) Then
          strResNcm := '';

        If Not fEmptyStr(strResNcm) Then
          stlResNcm.Add(strResNcm);
      End;
    End;

  For index := 1 To 10 Do
    SetPropValue(Self, 'strImpPgNcm' + fStrZero(IntToStr(index), 2), '');

  For index := 1 To 10 Do
    If stlResNcm.Count >= index Then
      SetPropValue(Self, 'strImpPgNcm' + fStrZero(IntToStr(index), 2), stlResNcm[index-1]);

  FreeAndNil(stlResNcm);
  SetLength(arrResNcm, 0);
end;

procedure TFatVendaBase.pGeraAlqIteImpressao;
  Var
    intContador: Integer;
    strTmpAlqIte: String;
begin
  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin

    strTmpAlqIte := '';
    {*****************************************}
    {* DEFINE ALÍQUOTA DE ICMS DO ITEM PARA  *}
    {* IMPRESSÃO                             *}
    {**************************************MV*}
    If (fltBasIcm <= 0) And ((strCliOrg <> 'S') Or (strZonFra <> 'S')) Then
    Begin
      strTmpAlqIte := '';
    End
    Else
    Begin

      If (Pos(strClaFis, VS_strClaVen) > 0) And (VS_strSimPau = 'S') Then
      Begin
        strTmpAlqIte := '';
      End
      Else
      Begin

        If fDentroDoEstado(arrMatItens[intContador].strEmpIte) Then
        Begin

          If (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0) And (Not (fCfgSis('IMPDIR',varBoolean, GetEmpCfg(arrMatItens[intContador].strEmpIte)) And (arrMatItens[intContador].strImpDir = 'S'))) Then
          Begin
            strTmpAlqIte := '';
          End
          Else
          Begin
            If (arrMatItens[intContador].fltAlqIcm <= 0.0) Then
              strTmpAlqIte := FloatToStr(fltAlqIcm)
            Else
              strTmpAlqIte := FloatToStr(arrMatItens[intContador].fltAlqIcm);

            If (arrMatItens[intContador].fltBasIcm <= 0) And ((strCliOrg <> 'S') Or (strZonFra <> 'S')) Then
              strTmpAlqIte := ''
            Else
              strTmpAlqIte := fStrZero(strTmpAlqIte, 02);

          End;

        End
        Else
        Begin
          strTmpAlqIte := FloatToStr(arrMatItens[intContador].fltAlqIcm);
          strTmpAlqIte := fStrZero(strTmpAlqIte, 02);
        End;

      End;

    End;

    arrMatItens[intContador].strAlqIte := strTmpAlqIte;

  End;
end;

procedure TFatVendaBase.pSintetizaAbreviacaoFiscal;
  Var
    intContAbrFis: Integer;
    intContador: Integer;
    strCodMen: String;
    strMenAbf: String;
    strMenAtu: String;
begin
  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  {*****************************************}
  {* ZERA MATRIZ DE ABREVIAÇÃO FISCAL      *}
  {**************************************MV*}
  For intContAbrFis := Low(arrAbrFis) To High(arrAbrFis) Do
  Begin
    arrAbrFis[intContAbrFis] := '';
  End;

  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin

    If fEmptyStr( arrMatItens[intContador].strMen__S ) Then
    Begin
      arrMatItens[intContador].strCodMen := '';
      Continue;
    End;

    If (Not fEmptyStr(arrMatItens[intContador].strCodMen)) Then
    Begin

      strMenAtu := arrMatItens[intContador].strMen__S;

      For intContAbrFis := Low(arrAbrFis) To High(arrAbrFis) Do
      Begin

        If (fEmptyStr(arrAbrFis[intContAbrFis])) Then
        Begin

          strMenAbf := arrMatItens[intContador].strCodMen + ': ' + arrMatItens[intContador].strMen__S;
          arrAbrFis[intContAbrFis] := strMenAbf;
          Break;

        End

        {*****************************************}
        {* CASO SEJA A MESMA DESCRIÇÃO, PULA     *}
        {**************************************MV*}
        Else If (SameText(strMenAtu, Copy(arrAbrFis[intContAbrFis], 6, Length(arrAbrFis[intContAbrFis])))) Then
        Begin
          Break;
        End

        Else
        Begin
          strCodMen := arrMatItens[intContador].strCodMen;
          If (LeftStr(arrAbrFis[intContAbrFis], 3) = strCodMen) Then
          Begin
            arrMatItens[intContador].strCodMen := strCodMen;
            Break;
          End;
        End;

      End;

    End;

  End;

  strMenAbf01 := arrAbrFis[00];
  strMenAbf02 := arrAbrFis[01];
  strMenAbf03 := arrAbrFis[02];
  strMenAbf04 := arrAbrFis[03];
  strMenAbf05 := arrAbrFis[04];
  strMenAbf06 := arrAbrFis[05];
  strMenAbf07 := arrAbrFis[06];
  strMenAbf08 := arrAbrFis[07];
  strMenAbf09 := arrAbrFis[08];

end;

function TFatVendaBase.fCalculaIrSeDv: Double;
var
  intServico: Integer;
  fltValSer : Double;
  fltVlIRPJ : Double;
  strCodSer : String;
begin
  Result := 0;

  for intServico := 1 to 30 do
  begin
    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intServico.ToString, 2));

    if (fCampoTabela('SER_REIRPJ', 'CADSER', ['SER_CODSER'], [strCodSer]) = 'S') then
    begin
      fltValSer := GetPropValue(Self, 'fltValS' + fStrZero(intServico.ToString, 2));
      fltVlIRPJ := fFormataFloat(fCampoTabela('SER_VLIRPJ', 'CADSER', ['SER_CODSER'], [strCodSer]), 2);

      if (fltValSer >= fltVlIRPJ) then
        Result := Result + fFormataFloat((fltAlqIrf * fltValSer) / 100.0, 2);
    end;
  end;
end;

procedure TFatVendaBase.pCalculaPisCofinsCsllSeDv;
var
  intServico: Integer;
  fltValSer : Double;
  fltValPcc : Double;

  fltValPis : Double;
  fltValCof : Double;
  fltValCss : Double;

  strCodSer : String;
begin
  fltValPis := 0;
  fltValCof := 0;
  fltValCss := 0;

  for intServico := 1 to 30 do
  begin
    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intServico.ToString, 2));

    if (fCampoTabela('SER_RETPCC', 'CADSER', ['SER_CODSER'], [strCodSer]) = 'S') then
    begin
      fltValSer := GetPropValue(Self, 'fltValS' + fStrZero(intServico.ToString, 2));
      fltValPcc := fFormataFloat(fCampoTabela('SER_VALPCC', 'CADSER', ['SER_CODSER'], [strCodSer]), 2);

      if (fltValSer >= fltValPcc) then
      begin
        fltValPis := fltValPis + fFormataFloat((fltAlqPis * fltTotSer) / 100.0, 2);
        fltValCof := fltValCof + fFormataFloat((fltAlqCof * fltTotSer) / 100.0, 2);
        fltValCss := fltValCss + fFormataFloat((fltAlqCsl * fltTotSer) / 100.0, 2);
      end;
    end;
  end;

  fltPiSeDv := fltValPis;
  fltCoSeDv := fltValCof;
  fltCsSeDv := fltValCss;
end;

function TFatVendaBase.fTemItensNotaNormalDesmembramentoExpedicao: Boolean;
  Var
    item: TDadosFechamento;
begin
  Result := False;
  If blnDesmembrarMeiaNotaComNotaNormal Then
  Begin
    For item In arrMatItens Do
    Begin
      Result := (Not item.blnMeiaNotaFatorExpedicao);
      If Result Then
        Break;
    End;
  End;
end;

procedure TFatVendaBase.pDeduzSeguridadeSocial;
begin
  fltVlSgSo := 0.0;
  fltPeSgSo := 0.0;

  If (strSegSoc = 'S') And (Pos(strEspDoc,'NF_EL_NS_') > 0) Then
  Begin
    If fCfgSis('SSOISQ', varBoolean) Then
      fltVlSgSo := fCfgSis('PESGSO', varDouble) * fltBasIss / 100.0
    Else
      fltVlSgSo := fCfgSis('PESGSO', varDouble) * fltTotSer / 100.0;
    fltPeSgSo := fCfgSis('PESGSO', varDouble);
  End;
end;

procedure TFatVendaBase.pRecalculaCustos(Var arrMatItens: TMatrizFechamento; pOnProcessaItem: TOnProcessaItem = nil; LCurStep: Integer = 1; LMaxSteps: Integer = 1; LblnCarregaCustoRealSemDesOpe: Boolean = True);
  const
    INFO_PROCESSAMENTO = 'Aguarde, Recalculando Custos do produto %s ...';
  Var
    intIndice: Integer;
    fltIcmSai: Double;
    blnUsaIcmSai : Boolean;
    fltIcStPv : Double;
    blnCalcST : Boolean;
    blnIMPCF4 : Boolean;
    blnRAICF4 : Boolean;

  function fCustoReal(fltDespOper: Double): Double;
    Var
      calcCustoReal: TCalcCustoReal;
  begin
    calcCustoReal := TCalcCustoReal.Create;
    Try
      calcCustoReal.fltUnitar := (arrMatItens[intIndice].fltUniTar + (arrMatItens[intIndice].fltDesAce / arrMatItens[intIndice].fltQtdIte) ) - (arrMatItens[intIndice].fltDesEsp / arrMatItens[intIndice].fltQtdIte);
      calcCustoReal.fltPreCus := arrMatItens[intIndice].fltPreCus;
      calcCustoReal.fltOutVal := arrMatItens[intIndice].fltOutVal + fSomaComissaoAoOutrosValores(arrMatItens[intIndice]);
      calcCustoReal.fltIcmSai := fltIcmSai;
      calcCustoReal.fltIcmPav := arrMatItens[intIndice].fltIcmPav;
      calcCustoReal.blnCalcST := blnCalcST;
      calcCustoReal.fltImpFed := arrMatItens[intIndice].fltImpFed;
      calcCustoReal.fltDesOpe := fltDespOper;
      calcCustoReal.fltFrete  := (arrMatItens[intIndice].fltValFre / arrMatItens[intIndice].fltQtdIte);

      If (AnsiRightStr(arrMatItens[intIndice].strClaFis, 3) = '922') Then
      Begin
         calcCustoReal.fltIcmSai := fGetIcmsEntregaFutura(arrMatItens[intIndice]);
      End
      Else If (strEspDoc <> 'FF') Then
      Begin
        calcCustoReal.fltDifal := fGetAlqDifal(arrMatItens[intIndice].strCodIte,
                                               arrMatItens[intIndice].strEmpIte,
                                               arrMatItens[intIndice].strCodAbf,
                                               arrMatItens[intIndice].strCodFis);

        If (arrMatItens[intIndice].fltValRet = 0) And (arrMatItens[intIndice].fltBasIcm <> 0) Then
          calcCustoReal.fltFcp := fReduzAlqFcpSeNecessario(arrMatItens[intIndice].strCodIte, arrMatItens[intIndice].strEmpIte, arrMatItens[intIndice].recDifalFCP.fltPerFcp);
      End;

      Result := fRetornaPrecoCusto(Preco_de_Custo_Real,
                                   arrMatItens[intIndice].strCodIte,
                                   arrMatItens[intIndice].strEmpIte,
                                   arrMatItens[intIndice].fltPreCus,
                                   '',
                                   calcCustoReal,
                                   (Pos('ITEM ESPECIAL', arrMatItens[intIndice].strDesIte) > 0));
    Finally
      FreeAndNil(calcCustoReal);
    End;
  end;

Begin
  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  pProcessMessages;

  blnIMPCF4 := fCfgSis('IMPCF4', VarBoolean);
  blnRAICF4 := fCfgSis('RAICF4', varBoolean);

  If LblnCarregaCustoRealSemDesOpe Then
    Self.fltCustoRealSemDesOpe := 0;

  If (Pos(strOpcDoc, 'VN_CS_PD_OR_OU_OF_OV_CF_CP_') > 0) Then
  Begin
    For intIndice := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If Assigned(pOnProcessaItem) Then
        pOnProcessaItem(arrMatItens[intIndice], intIndice + (Pred(LCurStep) * Length(arrMatItens)), Length(arrMatItens) * LMaxSteps, INFO_PROCESSAMENTO)
      Else If Assigned(pgbStatusGravacao) And (Length(arrMatItens) > 1) Then
      Begin
        pInformacao(Format(INFO_PROCESSAMENTO,
          [arrMatItens[intIndice].strCodIte + '-' + fPadR(arrMatItens[intIndice].strDesIte, 10)]), pgbStatusGravacao);
        pProgresso(Succ(intIndice) + (Pred(LCurStep) * Length(arrMatItens)), Length(arrMatItens) * LMaxSteps, pgbStatusGravacao);
      End;

      blnCalcST := False;

      If (Pos('ITEM ESPECIAL', arrMatItens[intIndice].strDesOri) <= 0)  And
         (Not fEhItemServico(arrMatItens[intIndice].strCodIte))         And
         (Not blnMeiaNota)                                              Then
      Begin
        blnUsaIcmSai := False;

        arrMatItens[intIndice].fltIcmPav := 0;
        arrMatItens[intIndice].blnIcmSai := False;

        If (blnIMPCF4) And
           (fCfgSis('MARMKP') = '4') And
           (Self.fDentroDoEstado(arrMatItens[intIndice].strEmpIte)) And
           (Pos(arrMatItens[intIndice].strCodSit, CST_SUBSTITUICAO) > 0) And
           (Not fEmptyStr(Self.GetTipAbf(arrMatItens[intIndice]))) And
           (Not fEmptyStr(Self.fUFDestTrib(arrMatItens[intIndice].strEmpIte))) Then
        Begin
          blnUsaIcmSai := True;
          arrMatItens[intIndice].blnIcmSai := True;

          Self.objIcStPv.pAdd(arrMatItens[intIndice].strCodIte,
                              fGetEmpCalculoItem(arrMatItens[intIndice].strEmpIte),
                              Self.GetTipAbf(arrMatItens[intIndice]),
                              Self.fUFDestTrib(arrMatItens[intIndice].strEmpIte),
                              arrMatItens[intIndice].strCodSit,
                              fltIcStPv,
                              blnCalcST,
                              arrMatItens[intIndice].fltDesF07);

          arrMatItens[intIndice].fltICMSai := Self.objIcStPv.fGetIcmSai(arrMatItens[intIndice].strCodIte,
                                                                        fGetEmpCalculoItem(arrMatItens[intIndice].strEmpIte));

          If (blnCalcST) Then
            arrMatItens[intIndice].fltIcmPav := fltIcStPv;
        End;

        {*****************************************************}
        {* Caso configurado: Margem de Lucro do faturamento, *}
        {* calcular com os impostos praticados na Venda      *}
        {**************************************************JC*}
        If (blnIMPCF4) And (Not blnUsaIcmSai) And (Not blnRAICF4) Then
          fltIcmSai := arrMatItens[intIndice].fltAlqIcm //Icms praticado na venda
        Else
          fltIcmSai := arrMatItens[intIndice].fltICMSai;//Icms do cadastro de produto

        {***************************************************************}
        {* Caso for tinta de máquina, o icmsai já está                 *}
        {* preenchido corretamente respeitando a configuração 'IMPCF4' *}
        {************************************************************PH*}
        If (arrMatItens[intIndice].strIdePro <> 'NOR') Then
          fltIcmSai := arrMatItens[intIndice].fltICMSai;

        {***************************************************************}
        {* Caso for venda de vidro, o icmsai já está                   *}
        {* preenchido corretamente respeitando a configuração 'IMPCF4' *}
        {************************************************************JC*}
        If fEhItemVendaVidro(arrMatItens[intIndice].strCodIte) Then
          fltIcmSai := arrMatItens[intIndice].fltICMSai;

        {*****************************************************************************}
        {* Quando for Baixa de Entrega Futura, o icmsai do documento x922            *}
        {* pode estar somado com Icms, Difal e Fcp, então deve usar o icms da venda  *}
        {**************************************************************************BZ*}
        If (AnsiRightStr(arrMatItens[intIndice].strClaFis, 3) = '117') Or
           (AnsiRightStr(arrMatItens[intIndice].strClaFis, 3) = '116') Then
        Begin
          fltIcmSai := arrMatItens[intIndice].fltAlqIcm;
          arrMatItens[intIndice].fltICMSai := fltIcmSai;
        End;

        If (blnIMPCF4) And (arrMatItens[intIndice].strRICMPR = 'S') Then
        Begin
          fltIcmSai := fFormataFloat(arrMatItens[intIndice].fltAlqIcm * fMultiplicadorReducaoRICMS(arrMatItens[intIndice].fltPerRic), 2);
        End;

        If Not ((Pos(strOpcDoc, 'CP_') > 0) And Self.blnBaiEntFut And Self.blnExpedi) Then
        Begin
          if not Self.blnEhPedidoVendaCasada then
          begin
            arrMatItens[intIndice].fltPreCus := arrMatItens[intIndice].fltCusIte;
            arrMatItens[intIndice].fltPreCu2 := fCustoReal(fProcessarDespesasOperacionaisComplementar(arrMatItens[intIndice].fltDesOpe));
          end;
        End;

        If LblnCarregaCustoRealSemDesOpe Then
          Self.fltCustoRealSemDesOpe := Self.fltCustoRealSemDesOpe + fCustoReal(0);

        arrMatItens[intIndice].fltTotCus := arrMatItens[intIndice].fltPreCus * arrMatItens[intIndice].fltQtdIte;
        arrMatItens[intIndice].fltTotCu2 := arrMatItens[intIndice].fltPreCu2 * arrMatItens[intIndice].fltQtdIte;
      End
      Else
      Begin
        If (fCfgSis('AUTCEN', varString) = 'S') And (arrMatItens[intIndice].strCodIte = fCfgSis('SERTER')) Then
        Begin
          arrMatItens[intIndice].fltTotCus := fGetCustoServTerc;
          arrMatItens[intIndice].fltTotCu2 := fGetCustoServTerc;
        End
        Else If (fCfgSis('AUTCEN', varString) = 'S') And (arrMatItens[intIndice].strCodIte = fCfgSis('ITESER')) Then
        Begin
          arrMatItens[intIndice].fltTotCus := fGetCustoServNaoTerc;
          arrMatItens[intIndice].fltTotCu2 := fGetCustoServNaoTerc;
        End;
      End;
    End;
  End;
End;

procedure TFatVendaBase.pCalculaPisCofinsLivro(strClaFisP: String = '');
  Var
    strClaFisIte: String;
    intContador: Integer;
    CalcResult: TResultPisCofins;
    tmp: TCalculoPisCofins;
begin
  pProcessMessages;

  fltTotPis := 0;
  fltTotCof := 0;
  fltTotBasPis := 0;
  fltTotBasCof := 0;
  fltTotAlqPis := 0;
  fltTotAlqCof := 0;

  fltTotPis_Cnf := 0;
  fltAlqPis_Cnf := 0;
  fltBasPis_Cnf := 0;
  fltTotCof_Cnf := 0;
  fltAlqCof_Cnf := 0;
  fltBasCof_Cnf := 0;

  {************************************}
  {* CALCULA O VALOR TOTAL DE ITE QUE *}
  {* INCIDE PIS/COFINS                *}
  {*********************************AF*}
  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin
    strClaFisIte := arrMatItens[intContador].strClaFis;

    If Not fEmptyStr(strClaFisP) Then
      strClaFisIte := strClaFisP;

    If fEmptyStr(arrMatItens[intContador].strIteAbf) Then
      arrMatItens[intContador].strIteAbf := arrMatItens[intContador].strCodIte;

    Try
      tmp := TCalculoPisCofins.Create;
      tmp.strCodEmbarcacao := FCodEmbarcacao;
      If Self.Fulfillment.EhOperacaoFulfillment Then
        tmp.blnGerarException := True;
      CalcResult := tmp.fCalculoPisCofins(VS_strCodEmp,arrMatItens[intContador].strIteAbf,
                                          strClaFisIte,
                                          arrMatItens[intContador].strCodFis,
                                          strCodCli,
                                          VS_strSimPau,
                                          strOpcDoc,arrMatItens[intContador].fltTotIte,
                                          arrMatItens[intContador].fltDesEsp,arrMatItens[intContador].fltValipi,
                                          arrMatItens[intContador].fltValRet,arrMatItens[intContador].fltValFre,
                                          arrMatItens[intContador].fltDesAce,arrMatItens[intContador].fltValIcm,
                                          arrMatItens[intContador].VisualizarFcpIcms.fltValor,
                                          IIF(fDocumentoParaFornecedor,'F','C'),
                                          arrMatItens[intContador].strIncPis,
                                          IIF(fEmptyStr(arrMatItens[intContador].strSit_PC), Self.strSitP_C, arrMatItens[intContador].strSit_PC),
                                          strMenP_C,dtaDtaEnt,strCodEmpTe,
                                          blnEhOperacaoDeTransferencia,
                                          blnBFut49,
                                          arrMatItens[intContador].strEntRet,
                                          arrMatItens[intContador].strEntFut,
                                          arrMatItens[intContador].strMotFut,
                                          arrMatItens[intContador].strClaIpi,
                                          False,
                                          '',
                                          -1,
                                          '',
                                          '',
                                          0,
                                          0,
                                          fDifalItem(arrMatItens[intContador]));
      If (Not CalcResult.blnResult) Then
        Abort;
    Finally
      FreeAndNil(tmp);
       End;

    arrMatItens[intContador].strCSTPis := CalcResult.strCstPis;

    If strNotImp <> 'S' Then
    Begin
      arrMatItens[intContador].fltBasPis := CalcResult.dblBasePis;
      arrMatItens[intContador].fltAlqPis := CalcResult.dblAlqPis;
      arrMatItens[intContador].fltValPis := CalcResult.dblValorPis;
    End;

    arrMatItens[intContador].strNatPis := CalcResult.strNatRecPis;

    arrMatItens[intContador].strCSTCof := CalcResult.strCstCof;

    If strNotImp <> 'S' Then
    Begin
      arrMatItens[intContador].fltBasCof := CalcResult.dblBaseCof;
      arrMatItens[intContador].fltAlqCof := CalcResult.dblAlqCof;
      arrMatItens[intContador].fltValCof := CalcResult.dblValorCof;
    End;

    arrMatItens[intContador].strNatCof := CalcResult.strNatRecCof;

    If CalcResult.dblBasePis > 0 Then
    Begin
      fltTotAlqPis := CalcResult.dblAlqPis;
      fltTotAlqCof := CalcResult.dblAlqCof;
    End;

    {*************************************************************************************************************}
    {*  [  ] AUTCOM - COLOMARTI - RONALDO                                                                        *}
    {*     - DEVOLUCAO DE MERCADORIAS                                                                            *}
    {*       - A NOTA DE DEVOLUCAO EMITIDA PARA FORNECEDOR DEVE SEGUIR A MESMA TRIBUTACAO DA NOTA DE ENTRADA,    *}
    {*         CALCULANDO PROPROCIONALMENTE AOS ITENS DEVOLVIDOS.                                                *}
    {*       - NAO DEVE SER UTILIZADO O CALCULO DAS ABREVIACOES FISCAIS                                          *}
    {*       - TEMOS QUE ENQUADRAR NESTA SITUACAO:                                                               *}
    {*         * CST ( ICMS, IPI, PIS e COFINS )                                                                 *}
    {*         * BASE DE ICMS                                                                                    *}
    {*         * VALOR DE ICMS                                                                                   *}
