    Result := True;

  If (Self.fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela) Then
    Result := True;
end;

function TFatVendaBase.fVerificaAbateDescontoAutomaticamente(const strPromoc : String) : Boolean;
begin
  If Not (Self.strCAbDes = 'S') Then
    Exit(False);

  If Not (fVerificaNotPromocaoOuPrecoSugAtivaIgualPrecoTabela(strPromoc)) Then
    Exit(False);

  If (fAplicarTaxaJurosPrecoDigitado) Then
    Exit(False);

  If (Self.fUsandoF3PuroComCondicaoNoFinal) Then
    Exit(False);

  Result := True;
end;

