    FieldByName('ITE_ESPIPI').AsString  := aInput.strEspIpi;
    FieldByName('ITE_EMPIPI').AsString  := aInput.strEmpIpi;
    FieldByName('ITE_SEQVDP').AsString  := aInput.strSeqVdp;
    FieldByName('ITE_CODDIG').AsString  := strCodDig;

    if (aInput.fltValorOriginalItemEstrutura > 0) then
