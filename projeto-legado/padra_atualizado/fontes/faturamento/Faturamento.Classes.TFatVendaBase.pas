    fltPerDes: Double;
    strCodSit: String;
    fltImcSTPV: Double;
    blnCalcST: Boolean;
    fltAlqIcms: Double;
    LfltPrecoCusto,
    LfltMargemVenda: Double;
    LstrUltDocumento: String;
    strEmpresaPrecoCusto: String;
    strEmpresaPrecoVenda: String;
    fltComLiq,
    fltVlrCam: Double;

  function fMargemBruta: Double;
  begin
    Result := fIteGer(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda).FieldByName('ITE_MARBR' + IIF(fEmptyStr(strTabPreItem), strTabPre, strTabPreItem)).AsFloat;
  end;

  function fComTabPrc: Double;
  begin
    Result := fIteGer(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda).FieldByName('ITE_COMTB' + IIF(fEmptyStr(strTabPreItem), strTabPre, strTabPreItem)).AsFloat;
  end;

  function fIpiEnt: Double;
  begin
    Result := fIteGer(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda).FieldByName('ITE_IPIENT').AsFloat;
  end;

  function fCodAbf: String;
  begin
    Result := fGetCodAbf(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda);
  end;

Begin
  If fEmptyStr(strTabPre) then
    strTabPre := '1';

  if blnPraticarPrecosEmpresaFaturamento then
  begin
    strEmpresaPrecoVenda := fGetEmpCalculoItem(strEmpIte);
    strEmpresaPrecoCusto := fGetEmpCalculoItem(strEmpIte);
  end
  else
  begin
    strEmpresaPrecoVenda := VS_strCodEmp;
    strEmpresaPrecoCusto := VS_strCodEmp;

    If qryCadIte.FindField('ITE_CODEMP') <> Nil Then
      strEmpresaPrecoCusto := IIF(qryCadIte.FieldByName('ITE_CODEMP').AsString.IsEmpty, VS_strCodEmp, qryCadIte.FieldByName('ITE_CODEMP').AsString)
    Else If qryCadIte.FindField('ITE_EMPITE') <> Nil Then
      strEmpresaPrecoCusto := IIF(qryCadIte.FieldByName('ITE_EMPITE').AsString.IsEmpty, VS_strCodEmp, qryCadIte.FieldByName('ITE_EMPITE').AsString);
  end;

  pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                       strEmpresaPrecoCusto,
                       IIF(fEmptyStr(strTabPreItem), strTabPre, strTabPreItem));

  LfltPrecoCusto  := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
  LfltMargemVenda := fltMargem;
  If (Pos(fCfgSis('MCAT17', varString, GetEmpCfg(strEmpIte)), 'M_V_') > 0) Then
  Begin
    LfltPrecoCusto := fRetornaPrecoCustoDeduzindoRessarcimentoCAT(qryCadIte.FieldByName('ITE_CODITE').AsString,
                                                                  strEmpresaPrecoVenda,
                                                                  fCodAbf,
                                                                  '',
                                                                  fIteGer(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda).FieldByName('ITE_PRECUS').AsFloat,
                                                                  LstrUltDocumento);

    //se houve dedução mantem a margem para calculo do preço de venda
    if fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat) <> LfltPrecoCusto then
      LfltMargemVenda := fMargemBruta;
  End;

  strStatus := '';
  strCodCmg := '';

  fltValTax := 0;
  fltTaxaJuros := 0;

  strCodSit := '';
  If (Not fEmptyStr(Self.GetTipAbf(strEmpIte))) And (fBuscaAbfIcm(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, fTrocaUFEndEntrega)) Then
    strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpIte)).AsString;

  If (fCfgSis('IMPCF4', varString, GetEmpCfg(strEmpIte)) = 'S') Then
    fltAlqIcms := fCalculaAliquota(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte,
                                   GetImpDir(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda))
  Else
    fltAlqIcms := fRetIcmSai(qryCadIte.FieldByName('ITE_ICMSAI').AsFloat);

  fltComLiq := 0;
  If (blnEmCampanha) And
     (fCfgSis('MARMKP') = '4') Then
  Begin
    objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                 qryCadIte.FieldByName('ITE_CODITE').AsString,
                                                 EmptyStr,
                                                 EmptyStr,
                                                 0,
                                                 fltVlrCam,
                                                 strCodCmg,
                                                 fltComLiq);
  End;

  objIcStPv.pAdd(qryCadIte.FieldByName('ITE_CODITE').AsString,
                 fGetEmpCalculoItem(strEmpIte),
                 Self.GetTipAbf(strEmpIte),
                 Self.fUFDestTrib(strEmpIte),
                 strCodSit,
                 fltImcSTPV,
                 blnCalcST,
                 0,
                 fltComLiq);

  If fltMargem > 0 Then
  Begin
    If fEmptyStr(strTabPreItem) Then
    Begin

      pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                           strEmpresaPrecoCusto,
                           strTabPre);

      fltPreVen := fCalculaPrecoVenda(1,
                                      LfltPrecoCusto,
                                      qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat,
                                      LfltMargemVenda,
                                      fltAlqIcms + fAlqDifIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms) +
                                                   fAlqFcpIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms, qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat),
                                      fRetImpFed(qryCadIte.FieldByName('ITE_IMPFED').AsFloat),
                                      fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryCadIte.FieldByName('ITE_DESOPE').AsFloat)),
                                      fComTabPrc,
                                      fMarMpkParaVenda,
                                      '',
                                      -1,
                                      fltImcSTPV,
                                      blnCalcST,
                                      0,
                                      0,
                                      fRetOutVal(qryCadIte.FieldByName('ITE_OUTVAL').AsFloat),
                                      fRestringirElementosMargem );
      fltUniSemJuros := fltPreVen;
    End
    Else
    Begin

      pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                           strEmpresaPrecoCusto,
                           strTabPreItem);

      fltPreVen := fCalculaPrecoVenda(1,
                                      LfltPrecoCusto,
                                      qryCadIte.FieldByName('ITE_PREVE' + strTabPreItem).AsFloat,
                                      LfltMargemVenda,
                                      fltAlqIcms + fAlqDifIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms) +
                                                   fAlqFcpIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms, qryCadIte.FieldByName('ITE_PREVE' + strTabPreItem).AsFloat),
                                      fRetImpFed(qryCadIte.FieldByName('ITE_IMPFED').AsFloat),
                                      fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryCadIte.FieldByName('ITE_DESOPE').AsFloat)),
                                      fComTabPrc,
                                      fMarMpkParaVenda,
                                      '',
                                      -1,
                                      fltImcSTPV,
                                      blnCalcST,
                                      0,
                                      0,
                                      fRetOutVal(qryCadIte.FieldByName('ITE_OUTVAL').AsFloat),
                                      fRestringirElementosMargem );
      fltUniSemJuros := fltPreVen;
    End;

  End
  Else
  Begin
    If (Pos(strOpcDoc, 'UC_') > 0) Then
    Begin

      fltPreVen := qryCadIte.FieldByName('ITE_PRE' + fCfgSis('UCPREV')).AsFloat;

      If fCfgSis('UCPREV') = 'CUS' Then
        fltPreVen := fRetPreCus(fltPreVen);

      If (fCfgSis('FAT_UC') > 0) Then
        fltPreVen := fltPreVen * fCfgSis('FAT_UC');

      fltUniSemJuros := fltPreVen;
    End

    Else If (Pos(strOpcDoc, 'BR_') > 0) Or (blnItemBrinde) Then
    Begin
      If (strPromoc = 'S') And
         (fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) and
         (IIF(fCfgSis('SUG_BR', varString) = '1', fltProPreCus, fltProPreVen) > 0) Then
      Begin
        case fCfgSis('SUG_BR', varInteger) of
          1:fltPreVen := fltProPreCus;
          2:fltPreVen := fltProPreVen;
          3:fltPreVen := qryCadIte.FieldByName('ITE_PREULT').AsFloat;
          4:fltPreVen := qryCadIte.FieldByName('ITE_IMPULT').AsFloat;
        else
          fltPreVen := fltProPreCus;
        end;
      End
      Else
      Begin

        pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                             strEmpresaPrecoCusto,
                             IIF(strTabPreItem.IsEmpty, strTabPre, strTabPreItem));

        case fCfgSis('SUG_BR', varInteger) of
          1:fltPreVen := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
          2:Begin
              If fEmptyStr(strTabPreItem) Then
                fltPreVen := qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat
              Else
                fltPreVen := qryCadIte.FieldByName('ITE_PREVE' + strTabPreItem).AsFloat;
            End;
          3:fltPreVen := qryCadIte.FieldByName('ITE_PREULT').AsFloat;
          4:fltPreVen := qryCadIte.FieldByName('ITE_IMPULT').AsFloat;
        else
          fltPreVen := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
        end;
      End;

      fltUniSemJuros := fltPreVen;
    End

    Else If blnCliFil And blnVerPrecoCliFil Then
    Begin
      Result := fFormataFloat(fPegaPrecoSugeridoTE(qryCadIte, strEmpIte, Self.strPromoc), VS_intDecUni);
      fltUniSemJuros := Result;
      Exit;
    End

    Else If (Pos(strOpcDoc, 'OV_PI_') > 0) Then
    Begin

      pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                           strEmpresaPrecoCusto,
                           IIF(strTabPreItem.IsEmpty, strTabPre, strTabPreItem));

      fltPreVen := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
      fltUniSemJuros := fltPreVen;

    End

    Else
    Begin
      If fEhOutrasSaidasOuOutrasEntradasComPrecoCustoOuPrecoMedio() Then
      Begin

        pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                             strEmpresaPrecoCusto,
                             IIF(strTabPreItem.IsEmpty, strTabPre, strTabPreItem));

        if (Pos(strOpcDoc, 'OU_OF_') > 0) then
        Begin
          if (fCfgSis('PROSOE') = 'C') then
          Begin
            fltPreVen := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat)
          End
          Else
          Begin
            fltPreVen := qryCadIte.FieldByName('ITE_PREMED').AsFloat;
          End;
        End
        Else
        Begin
          if (fCfgSis('PROENT') = 'C') then
          Begin
            fltPreVen := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
          End
          Else
          Begin
            fltPreVen := qryCadIte.FieldByName('ITE_PREMED').AsFloat;
          End;
        End;
      End

      Else If (blnItemEspecial = False) Then
      Begin
        blnPrvEmb := fCfgSis('PRVEMB', VarBoolean, GetEmpCfg(strEmpIte));
        intPreEmb := fCfgSis('PREEMB', VarInteger, GetEmpCfg(strEmpIte));

        If  blnCodBarEmb   And
            blnPrvEmb      And
           (intPreEmb = 1) And
           (fltBarPreVen > 0.00) Then
          fltPreVen := fltBarPreVen
        Else
        Begin
          If (blnPrvEmb)                   And
            (intPreEmb = 2)                And
            (Not SameText(strTabEmb, 'F')) And
            (Not fEmptyStr(strTabEmb))     Then
            fltPreVen := qryCadIte.FieldByName('ITE_PREVE' + strTabEmb).AsFloat
          Else
          Begin
            If fEmptyStr(strTabPreItem) Then
              fltPreVen := qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat
            Else
              fltPreVen := qryCadIte.FieldByName('ITE_PREVE' + strTabPreItem).AsFloat;
          End;
        End;

        If (fCfgSis('CLPVDI', varBoolean, GetEmpCfg(strEmpIte))) And (Self.fUFDestTrib(strEmpIte) <> Self.fGetUFEmpresa(strEmpIte)) Then
        Begin

          pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                               strEmpresaPrecoCusto,
                               IIF(strTabPreItem.IsEmpty, strTabPre, strTabPreItem));

          fltPreVen := fCalculaPrecoVenda(1,
                                          LfltPrecoCusto,
                                          qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat,
                                          fMargemBruta,
                                          fltAlqIcms + fAlqDifIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms) +
                                                       fAlqFcpIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms, qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat),
                                          fRetImpFed(qryCadIte.FieldByName('ITE_IMPFED').AsFloat),
                                          fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryCadIte.FieldByName('ITE_DESOPE').AsFloat)),
                                          fComTabPrc,
                                          fMarMpkParaVenda,
                                          '',
                                          -1,
                                          fltImcSTPV,
                                          blnCalcST,
                                          0,
                                          0,
                                          fRetOutVal(qryCadIte.FieldByName('ITE_OUTVAL').AsFloat),
                                          fRestringirElementosMargem );
        End;
      End
      Else
      Begin
        if (fCfgSis('REVRIE', varBoolean, GetEmpCfg(strEmpIte))) and (qryCadIte.FindField('ITE_UNIVIS') <> nil) then
          fltPreVen := qryCadIte.FieldByName('ITE_UNIVIS').AsFloat
        else if (qryCadIte.FindField('ITE_UNIDIG') <> nil) then
          fltPreVen := qryCadIte.FieldByName('ITE_UNIDIG').AsFloat
        else
          fltPreVen := fCalculaPrecoVenda(1,
                                          LfltPrecoCusto,
                                          qryCadIte.FieldByName('ITE_PREVE' + strTabPreItem).AsFloat,
                                          LfltMargemVenda,
                                          fltAlqIcms + fAlqDifIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms) +
                                                       fAlqFcpIcmsPrecoDinamico(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fCodAbf, strCodSit, fltAlqIcms, qryCadIte.FieldByName('ITE_PREVE' + strTabPreItem).AsFloat),
                                          fRetImpFed(qryCadIte.FieldByName('ITE_IMPFED').AsFloat),
                                          fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryCadIte.FieldByName('ITE_DESOPE').AsFloat)),
                                          fComTabPrc,
                                          fMarMpkParaVenda,
                                          '',
                                          -1,
                                          fltImcSTPV,
                                          blnCalcST,
                                          0,
                                          0,
                                          fRetOutVal(qryCadIte.FieldByName('ITE_OUTVAL').AsFloat),
                                          fRestringirElementosMargem);
      End;

      fltValTax := fGetTaxVprItem(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, strConPagPar);

      If (Not fAplicaTaxaJuros) Then
        fltValTax := 0;

      If (Not Self.blnCalculaTaxCndF3Inicio) Then
      Begin
        If (Not fAplicarTaxaJurosPrecoSugestao) Then
          fltValTax := 0;

        If (blnEstaRecalculandoPeloAlteraPedidoVenda) Then
          fltValTax := 0;
      End;

      If (strOpcDoc = 'TR') Then
      Begin
        If (strEntSai = 'E') Then
          fltValTax := 0;

        If Self.strIdePro = 'NOR' then
        begin

          pCarregaValoresCusto(qryCadIte.FieldByName('ITE_CODITE').AsString,
                               strEmpresaPrecoCusto,
                               IIF(strTabPreItem.IsEmpty, strTabPre, strTabPreItem));

          If fEhOuCompoeEstrutura(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpresaPrecoVenda).blnEstrutura Then
          Begin
            If (Self.blnCarregandoEstrutura) Or (fCfgSis('SUGVLE', varInteger, GetEmpCfg(strEmpIte)) = 2) Then
              fltPreCus := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
          End
          Else
          Begin
            fltPreCus := fRetPreCus(qryCadIte.FieldByName('ITE_PRECUS').AsFloat);
          End
        end;

        If (fEmptyStr(strTabPreItem)) Then
          fltPreVen := fRetPrecoTroca(strEntSai, strTabPre)
        Else
          fltPreVen := fRetPrecoTroca(strEntSai, strTabPreItem);
      End;

      {*********************************************************}
      {* CALCULA O UNITARIO COM DESCONTO POR CLIENTE OU REGIAO *}
      {*****************************************************JC**}
      If fPercDescComissClienteRegiao(strCodCli, qryCadIte.FieldByName('ITE_CODITE').AsString, 'PERDES', fltPerDes) Then
      Begin
        fltPreVen := fltPreVen * ( 1 - fltPerDes / 100);
      End;

      If (fCfgSis('CLIDES', varString, GetEmpCfg(strEmpIte)) = 'S') And
         (fCfgSis('DCVBVL', varString, GetEmpCfg(strEmpIte)) = 'L') Then
      Begin
        fltPreVen := fFormataFloat(fltPreVen * (100 - fltDescProfissional) / 100, VS_intDecUni);
      End;

      If (fCfgSis('DDESFD', varInteger, GetEmpCfg(strEmpIte)) > 0) And (fCfgSis('TDESFD', varString, GetEmpCfg(strEmpIte)) = 'L') And (strPromoc = 'N') Then
      Begin
        If ((Self.VS_Date - fCampoTabela('CLI_ULTCOM', 'CADCLI', ['CLI_CODCLI'], [strCodCli])) <= fCfgSis('DDESFD', varInteger, GetEmpCfg(strEmpIte))) Then
        Begin
          fltPreVen := fFormataFloat(fltPreVen * (100 - fltDescFidelidade) / 100, VS_intDecUni);
        End;
      End;

      fltUniSemJuros := fltPreVen;

      If fltValTax > 0 Then
      Begin
        fltTaxaJuros := fltValTax;
        fltPreVen := fFormataFloat(fltPreVen, VS_intDecUni);
        fltPreVen := fltPreVen + fFormataFloat(fltPreVen * (fltValTax / 100.0), VS_intDecUni);
      End;

    End;

    {**********************************************}
    {* ARMAZENA PREVEN NA VAR. flrVlrBon PARA     *}
    {* TESTAR PREÇO DA PROMOÇÃO E PREÇO COM BÔNUS *}
    {*******************************************RL*}
    fltVlrBon := fltPreVen;
    fltVlrPro := 0;

    If (strPromoc = 'S') And
       (strIdePro = 'NOR') And
       (Not fEhOutrasSaidasOuOutrasEntradasComPrecoCustoOuPrecoMedio()) And
       ((fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao) Or
        (fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela) And (Self.strOriF11 = 'S') And (blnOriF3)) Then
    Begin
      If (Pos(strOpcDoc, 'BR_') > 0) Then
        fltPreVen      := fltPreVen + fFormataFloat(fltPreVen * (fltValTax / 100.0), VS_intDecUni)
      Else
      Begin
        fltUniSemJuros := fltProPreVen;
        fltPreVen      := fCalculaPrecoVendaConformeTaxaJurosOuJurosRemanescentePromoc(qryCadIte.FieldByName('ITE_CODITE').AsString, fltProPreVen, fltValTax);
      End;

      If (fCfgSis('PRSGCL', varString, GetEmpCfg(strEmpIte)) = '2') And
         (Not blnOriF3) And
         (Pos(strOpcDoc,'OR_PD_VN_') > 0) Then
      Begin
        fltDescontoPromocao := (1 - (fltProPreVen/qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat)) * 100;
        fltProPreVen        := qryCadIte.FieldByName('ITE_PREVE' + strTabPre).AsFloat;
        fltUniSemJuros      := fltProPreVen;
        fltPreVen           := fCalculaPrecoVendaConformeTaxaJurosOuJurosRemanescentePromoc(qryCadIte.FieldByName('ITE_CODITE').AsString, fltProPreVen, fltValTax);
      End;

      fltTaxaJuros := fltValTax;
      fltVlrPro := fltPreVen;
    End;

    pPegaPrecoVendaBonus(qryCadIte.FieldByName('ITE_CODITE').AsString, fltVlrPro, fltPreVen, strCodCmg);

    If strStatus = 'B' Then
    Begin
      fltTaxaJuros := 0;
      fltUniSemJuros := fltPreVen;
    End;
  End;

  If fltPreVen = 0 Then
  Begin
    if not ((fCfgSis('TABITE') = 'S') and (not fEmptyStr(strTabPreItem)) and (Pos(strOpcDoc, 'OR_PD_VN_') > 0)) then
    begin
      fltPreVen := qryCadIte.FieldByName('ITE_PREVE1').AsFloat;
      fltTaxaJuros := 0;
      fltUniSemJuros := fltPreVen;
    end;
  End;

  If fUsaPrecoDeVendaComDifal Then
  Begin
    fltPreVen := fRetornaPrecoDeVendaComDifal(qryCadIte.FieldByName('ITE_CODITE').AsString, strEmpIte, fltPreVen);
  End;

  Result := fFormataFloat(fltPreVen, VS_intDecUni);

  fltUniSemJuros := fFormataFloat(fltUniSemJuros, VS_intDecUni);

End;

function TFatVendaBase.fPegaPrecoVenda(const CdsDaVenda: TDataset) : TPegaPrecoVendaOutput;
  Var
    blnAplicarTaxaJuros : Boolean;
    blnItemEspecial : Boolean;
    fltUnitar : Double;
    fltVal_RT : Double;
    strDstCnd : String;
    fltUniTmp : Double;
begin
  FillChar(Result, SizeOf(Result), #0);
  blnItemEspecial := (Pos('ITEM ESPECIAL', CdsDaVenda.FieldByName('ITE_DESITE').AsString) > 0);

  Self.fltProPreCus := 0;
  Self.fltProPreVen := 0;
  Self.fltProComVar := 0;
  Self.fltProComAta := 0;
  Self.fltProComDis := 0;
  Self.fltProDesF07 := 0;
  Self.strPromoc := CdsDaVenda.FieldByName('ITE_PROMOC').AsString;
  If (Self.strPromoc = 'S') Then
  Begin
    Self.fltProPreCus := CdsDaVenda.FieldByName('ITE_PROCUS').AsFloat;
    Self.fltProPreVen := CdsDaVenda.FieldByName('ITE_PROVEN').AsFloat;
    Self.fltProComVar := CdsDaVenda.FieldByName('ITE_PROCVA').AsFloat;
    Self.fltProComAta := CdsDaVenda.FieldByName('ITE_PROCAT').AsFloat;
    Self.fltProComDis := CdsDaVenda.FieldByName('ITE_PROCDI').AsFloat;
    Self.fltProDesF07 := CdsDaVenda.FieldByName('ITE_DESF07').AsFloat;
  End;

  fltVal_RT := 0;

  If Self.fUtilizaPrecoSubItensEstrutura(blnItemEspecial, CdsDaVenda.FieldByName('ITE_CODITE').AsString) Then
  Begin
    blnAplicarTaxaJuros := (Self.fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao);

    fltUnitar := fFormataFloat(Self.fCalculaPrecoEstrutura(blnAplicarTaxaJuros,
                                                           Preco_de_Venda,
                                                           CdsDaVenda.FieldByName('ITE_CODITE').AsString,
                                                           CdsDaVenda.FieldByName('ITE_EMPITE').AsString,
                                                           'S',
                                                           CdsDaVenda.FieldByName('ITE_TABPRE').AsString,
                                                           0.0), Self.VS_intDecUni);

    Self.fltUniVis := fltUnitar;
    Result.ValorUnitarioSemJuros := fltUnitar;
    Self.fltTaxJur := 0.00;

    If (blnAplicarTaxaJuros) Then
    Begin
      Self.fltTaxJur := Self.fGetTaxVprItem(CdsDaVenda.FieldByName('ITE_CODITE').AsString, CdsDaVenda.FieldByName('ITE_EMPITE').AsString);
      fltUnitar := fFormataFloat(Self.fltUniVis + fFormataFloat(Self.fltUniVis * (Self.fGetTaxVprItem(CdsDaVenda.FieldByName('ITE_CODITE').AsString, CdsDaVenda.FieldByName('ITE_EMPITE').AsString) / 100.0), 04), Self.VS_intDecUni);
      Result.TaxaDeJurosDaCondicao := Self.fltTaxJur;
    End;
  End
  Else
    fltUnitar := fPegaPrecoVenda(CdsDaVenda,
                                 CdsDaVenda.FieldByName('ITE_EMPITE').AsString,
                                 'S',
                                 0,
                                 blnItemEspecial,
                                 CdsDaVenda.FieldByName('ITE_IDEPRO').AsString,
                                 CdsDaVenda.FieldByName('ITE_TABPRE').AsString,
                                 True,
                                 Result.TaxaDeJurosDaCondicao,
                                 Result.ValorUnitarioSemJuros);

  Result.StatusDoProduto := Self.strStatus;

  Self.pCalculaValorRT(fltUnitar, fltVal_RT);

  Result.ValorUnitarioOriginal := fltUnitar;

  strDstCnd := EmptyStr;
  If fCfgSis('DESCND',varBoolean) Then
    strDstCnd := fCampoTabela('ITE_DESCND', 'CADITE', ['ITE_CODITE'], [CdsDaVenda.FieldByName('ITE_CODITE').AsString], False);

  fltUniTmp := fltUnitar;

  If Self.fVerificaEmbalagemFechadaItemPromocao(CdsDaVenda.FieldByName('ITE_CODITE').AsString,
                                                CdsDaVenda.FieldByName('ITE_TABPRE').AsString,
                                                CdsDaVenda.FieldByName('ITE_PROMOC').AsString,
                                                CdsDaVenda.FieldByName('ITE_QTDITE').AsFloat) Then
  Begin
    Result.ItemEmbalagemFechada := True;
    Result.PercentualDescontoEmbalagemFechada := fPercDescEmbalagemFechadaItem(CdsDaVenda.FieldByName('ITE_CODITE').AsString,
                                                                               CdsDaVenda.FieldByName('ITE_TABPRE').AsString,
                                                                               CdsDaVenda.FieldByName('ITE_QTDITE').AsFloat,
                                                                               EmptyStr);
    fltUnitar := fltUnitar * (1 - (Result.PercentualDescontoEmbalagemFechada / 100));
  End;

  Result.ValorDescontoEmbalagemFechada := fFormataFloat(fltUniTmp - fltUnitar, Self.VS_intDecUni);

  fltUniTmp := fltUnitar;

  If Self.fVerificaAbateDescontoAutomaticamente(CdsDaVenda.FieldByName('ITE_PROMOC').AsString) Then
  Begin
    Result.PercentualDescontoCondicaoPagamento := Self.fRetornaDescLinGru(CdsDaVenda.FieldByName('ITE_CODITE').AsString, Self.strCodCnd);

    If fCfgSis('DESCND', varBoolean) Then
    Begin
      If (strDstCnd = 'S') Then
        fltUnitar := Self.fGetUnitarioComDescontoAplicado(fltUnitar, Result.PercentualDescontoCondicaoPagamento);
    End
    Else If (Self.strCodFpg = '007') Then
    Begin
      If (Self.strAbDeCc = 'S') Then
        fltUnitar := fGetUnitarioComDescontoAplicado(fltUnitar, Result.PercentualDescontoCondicaoPagamento);
    End
    Else
      fltUnitar := fGetUnitarioComDescontoAplicado(fltUnitar, Result.PercentualDescontoCondicaoPagamento);
  End;

  Result.ValorDescontoCondicaoPagamento := fFormataFloat(fltUniTmp - fltUnitar, Self.VS_intDecUni);

  If (fCfgSis('DESCND', varString) = 'S') And (strDstCnd = 'S') Then
    Result.ValorUnitario := Result.ValorUnitarioOriginal
  Else
    Result.ValorUnitario := fltUnitar;

  If (fFormataFloat(CdsDaVenda.FieldByName('ITE_DESCON').AsFloat, 2) > 0) Then
  Begin
    fltUnitar := fltUnitar - Self.fRetornaVrDesconto(2, fltUnitar, CdsDaVenda.FieldByName('ITE_DESCON').AsFloat);
    fltUnitar := fFormataFloat(fltUnitar, Self.fMaxDecUni);
  End;

  Result.ValorUnitarioLiquido := fltUnitar;
  Result.ValorCotacaoDolarVenda := fltVlCtVn;
end;

function TFatVendaBase.fVerificaEmbalagemFechadaItemPromocao(const strCodIte, strTabPre, strPromoc : String; const fltQtdIte : Double): Boolean;
begin
  If Not (Self.stlItensNaoTemQtdeEmbFec.IndexOf(strCodIte) = -1) Then
    Exit(False);

  If Not (fEhEmbalagemFechadaItem(strCodIte, IIF(fEmptyStr(strTabPre), strTabPre, strTabPre), fltQtdIte)) Then
    Exit(False);

  If Not (strPromoc <> 'S') Then
    Exit(False);

  Result := True;
end;

Procedure TFatVendaBase.pRetornaAliquotaItem(strCodIte, strEmpIte: String; Var fltPerIcm: Double; Var strCodSit: String; Var fltBasIcm: Double; Var fltPerRed: Double; blnRedAlq: Boolean = False; blnEhCalcDifal: Boolean = False);
  Var
    strTipAbf: String;
    blnAbfIcm: Boolean;
begin
  strTipAbf := GetTipAbf(strEmpIte, OpcItensNFespTinta);

  If fDentroDoEstado(strEmpIte) Then
    blnAbfIcm := fBuscaAbfIcm(strCodIte,
                              strEmpIte,
                              fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte)),
                              fGetUFEmpresa(strEmpIte))
  Else
    blnAbfIcm := fBuscaAbfIcm(strCodIte,
                              strEmpIte,
                              fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte)),
                              fTrocaUFEndEntrega);

  fltBasIcm := -1;
  fltPerRed := -1;

  If blnAbfIcm Then
  Begin
    If fTributarNaAliquotaInternaDoEstado(strEmpIte) Then
    Begin
      fltPerIcm := fAlqIcmEstEmp(fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpIte)), strEmpIte);
      strCodSit := '000';
      fltBasIcm := 100;
    End
    Else
    Begin
      If (Pos('SAI_', strTipAbf) > 0) And (((fCfgSis('CLPVDI', varString) = 'S') And (fCfgSis('ICMSEP', varString) = 'S')) Or (fCfgSis('UASCCR', varString) = 'S')) And (Not blnEhCalcDifal) Then
        fltPerIcm := cdsAbfIcm.FieldByName('ABF_ICMPRD' + strTipAbf).AsFloat
      Else
        fltPerIcm := cdsAbfIcm.FieldByName('ABF_ALQICM' + strTipAbf).AsFloat;

      strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + strTipAbf).AsString;
      fltBasIcm := cdsAbfIcm.FieldByName('ABF_BASICM' + strTipAbf).AsFloat;
    End;

    If (blnRedAlq) Then
    Begin
      If TFunctionsRegrasImpostosFaturamento.ClientePossuiReducaoBaseIcmsParaProdutosTributados(fltRedIcmsCli, strCodSit) Then
      Begin
        fltPerIcm := fFormataFloat((fltPerIcm * (100-fltRedIcmsCli)) / 100, 2);
        fltPerRed := fltRedIcmsCli;
      End
      Else If (cdsAbfIcm.HasField('ABF_BASICM' + strTipAbf)) Then
      Begin
        fltPerIcm := fFormataFloat((fltPerIcm * cdsAbfIcm.FieldByName('ABF_BASICM' + strTipAbf).AsFloat) / 100, 2);
      End;
    End;

    If (fEmptyStr(strCodSit)) Then
    Begin
      Raise ExceptionAutCom.Create('O código da situação tributária do item '+strCodIte+' não está preenchido corretamente!' +#10#13+
                                   'Abreviação: ' + cdsAbfIcm.FieldByName('ABF_CODABF').AsString + ' - '+ cdsAbfIcm.FieldByName('ABF_DESABF').AsString +#10#13+
                                   'Perfil: ' + strTipAbf +#10#13+
                                   'Estado: ' + cdsAbfIcm.FieldByName('ABF_ESTADO').AsString);
    End;
  End
  Else
  Begin
    If (Self.blnGerarExcecaoSeNaoAcharAliquotaICMS) Then
    Begin
      Raise ExceptionAutCom.Create('O sistema não conseguiu identificar a aliquota de ICMS do item: '+strCodIte+'. '+
                                   'Verifique a UF no "Cadastro do Cliente" e a Abreviação Fiscal do item no "Cadastro de Produtos". '+
                                   'Se ambos estiverem corretos entre em contato com a Citel!');
    End
    Else
    Begin
      fltPerIcm := fltAlqIcm;
      strCodSit := '';
    End;
  End;
End;

Procedure TFatVendaBase.pRetornaAliquotaItem(strCodIte, strEmpIte: String; Var fltPerIcm: Double; Var strCodSit: String; blnRedAlq: Boolean = False; blnEhCalcDifal: Boolean = False);
  Var
    LfltBasIcm,
    LfltPerRed: Double;
begin
  pRetornaAliquotaItem(strCodIte, strEmpIte, fltPerIcm, strCodSit, LfltBasIcm, LfltPerRed, blnRedAlq, blnEhCalcDifal);
end;

