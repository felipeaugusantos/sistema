Procedure TFatVendaBase.pCarregaCfgSis(strParOpcDoc: String=''; blnBeforeAfterCalculaTotGerItem: Boolean=False);
  var
    strTipFreAnt : string;
Begin
  strTipFreAnt := Self.strTipFre;
{$IFDEF LINUX}
  Self.VS_strClaVen  := Services.Core.Settings.VS_strClaVen;
  Self.VS_strClaDev  := Services.Core.Settings.VS_strClaDev;
  Self.VS_strClaNfo  := Services.Core.Settings.VS_strClaNfo;
  Self.VS_strFatCon  := Services.Core.Settings.VS_strFatCon;
  Self.VS_strRetCon  := Services.Core.Settings.VS_strRetCon;
  Self.VS_strDemCla  := Services.Core.Settings.VS_strDemCla;
{$ELSE}
  Self.VS_strClaVen  := untFuncoesSimples.VS_strClaVen;
  Self.VS_strClaDev  := untFuncoesSimples.VS_strClaDev;
  Self.VS_strClaNfo  := untFuncoesSimples.VS_strClaNfo;
  Self.VS_strFatCon  := untFuncoesSimples.VS_strFatCon;
  Self.VS_strRetCon  := untFuncoesSimples.VS_strRetCon;
  Self.VS_strDemCla  := untFuncoesSimples.VS_strDemCla;
{$ENDIF}
  pCarregaGlobaisSimplesNacional(EmptyStr);
  Self.strTipFre     := IIF(fCfgSis('CONSIG',varBoolean) And (strOpcDoc = 'CS'),'9',fCfgSis('TIPFRE'));

  If (Self.strEntFat.IsEmpty) Then
    Self.strEntFat   := fCfgSis('SUJROM');

  Self.VS_strMARMKP  := fMarMpkParaVenda(fCfgSis('MARMKP'));
  Self.VS_strTCoPro  := fCfgSis('TCOPRO');
  Self.VS_blnUsaFpg  := fCfgSis('USAFPG', varBoolean);
  Self.blnEmpFat     := fPermiteInformarEmpresaNoItemOpc(IIF(strParOpcDoc.IsEmpty, strOpcDoc, strParOpcDoc));
  if (Self.blnVerificarEstoqueComoPDORMultiLoja Or blnBeforeAfterCalculaTotGerItem Or Self.fManterFreteDefinidoFinalizacao) and (not fEmptyStr(strTipFreAnt)) then
    Self.strTipFre := strTipFreAnt;
  VS_strCla_UC       := fTransform(fCfgSis('CLA_UC'), 3);
  VS_strCFODVF       := fCfgSis('CFODVF');
  VS_strArtAtu       := fCfgSis('ARTATU');
End;

procedure TFatVendaBase.pBeforeCalculaTotGerItem(const AItem: TDadosFechamento);
var
  LEmpresaCalculo: string;
begin
  if Self.blnPraticarPrecosEmpresaFaturamento then
  begin
    LEmpresaCalculo := fGetEmpCalculoItem(AItem.strEmpIte);
    pSetaEmpresaCalculandoImpostos(LEmpresaCalculo);
    if not GetImpostosFatParametrosComum.CodigoDaEmpresa.Equals(LEmpresaCalculo) then
    begin
      Self.pCarregaCfgSis('', True);
      pSetarImpostosFatParametrosComum(LEmpresaCalculo);
    end;
    pCarregaGlobaisSimplesNacional(LEmpresaCalculo);
  end;
end;

procedure TFatVendaBase.pAfterCalculaTotGerItem(const AItem: TDadosFechamento);
begin
  If Self.blnPraticarPrecosEmpresaFaturamento Then
  Begin
    pSetaEmpresaCalculandoImpostos(EmptyStr);
    Self.pCarregaCfgSis('', True);
    pCarregaGlobaisSimplesNacional(EmptyStr);
  End;
end;

procedure TFatVendaBase.pCarregaConfiguracoesEmpresaDestinoPedidoTransfPedidoEntrCd;

  function fEmTransf: Boolean;
  begin
    Result := (Not fEmptyStr(FEmp_TE)) And (FCliFil);
  end;

  function fEmEnt_CD: Boolean;
  begin
    Result := (Not fEmptyStr(FEmp_CD)) And (FEnt_CD);
  end;

  procedure pCarregaArrCfgSisDes;
  var
    LCodCfg: string;
  begin
    VS_ArrCfgSisDes := [];
    for LCodCfg in ARRAY_CONFIG_EMPRESA_DESTINO_IMPOSTOS do
      pAddDados(VS_ArrCfgSisDes, LCodCfg);
  end;

begin
  If fCfgSis('CFGDES', varBoolean) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin
    If (fEmTransf Or fEmEnt_CD) Then
    Begin
      If (fEmTransf) And (VS_EmpCfgSisDes <> FEmp_TE) Then
      Begin
        VS_EmpCfgSisDes := FEmp_TE;
        pCarregaArrCfgSisDes;

        Self.pCarregaCfgSis;

        If (FCodCli <> '') Then
          If (Not fDocumentoParaFornecedor) Then
            Vs_strTpAbreDes := fGetTipoAbfCliente(FCodCli, '', '', IIF(FCodCli = fRetornaClienteFilial(VS_strCodEmp), FEmp_TE, ''));
      End;

      If (fEmEnt_CD) And (VS_EmpCfgSisDes <> FEmp_CD) Then
      Begin
        VS_EmpCfgSisDes := FEmp_CD;
        pCarregaArrCfgSisDes;

        Self.pCarregaCfgSis;

        If (FCodCli <> '') Then
          If (Not fDocumentoParaFornecedor) Then
            Vs_strTpAbreDes := fGetTipoAbfCliente(FCodCli, '', '', '');
      End;
    End
    Else
    Begin
      If (Not fEmptyStr(VS_EmpCfgSisDes)) Then
      Begin
        pEsvaziaArrayCfgDes;
        Self.pCarregaCfgSis;
      End;
    End;
  End;
end;

