procedure TFatVendaBase.pCalculaTotalParaCadRec;
begin
  Self.fltTotCadRec := fCalculaTotalParaCadRec;
end;

function TFatVendaBase.fCalculaTotalParaCadRec: Double;
begin
  Result := fFormataFloat(fltTotGer - fltDupRec - fltTotProBri - fltTotDevBri, 2);

  {***********************************************}
  {* RETENCAO PIS/COFINS/IRPJ/CSLL DOS PRODUTOS. *}
  {********************************************JC*}
  If Not fRetemImpostosNoDescontoEspecial Then
    Result := Result - fTotalRetencoesProdutos;

  {***********************************************}
  {* RETENCAO PIS/COFINS/IRPJ/CSLL DOS SERVICOS. *}
  {********************************************JC*}
  If (Pos(strEspDoc,'NF_EL_NS_IF_IV_') > 0) Then
    Result := Result - fTotalRetencoesServicos;

  If (strRetIss = 'S') Then
  Begin
    If Pos(strEspDoc,'NF_EL_NS_IF_IV_') > 0 Then
      Result := Result - fltValIss

    Else If blnTaxaBombeamentoPedOrc Then
      Result := Result - fltValIss

    //Quando utiliza forma de pagamento negociada para recebimento no F11
    Else If (Pos(strEspDoc, 'OR_PD') > 0) And (strCodFpg = '009') And (fCfgSis('TFPF11') = 'S') Then
      Result := Result - fltValIss;
  End;

  If (Self.fltValFre > 0) Then
  Begin

    If (Pos(Self.strOpcDoc, 'OF_EF_') <= 0) And (Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
    Begin
      If (fCfgSis('FRDVES', varString) = '0') Then
        Result := Result - Self.fltValFre
      Else If (fCfgSis('FRDVES', varString) = '2') Then
        If (Self.strTipFre = '1'{Emitente(CIF)}) Or (Self.strTipFre = '3'{Terceiros}) Or (Self.strTipFre = '9'{Sem Frete}) Or (Self.strTipFre = '4'{Transporte Próprio Remetente}) Then
          Result := Result - Self.fltValFre;
    End
    Else If (Self.strOpcDocTrue = 'BD') And (fCfgSis('FREBAI', varString) = 'S') Then
    Begin

      Result := Result - Self.fltValFre;

      If (fFormataFloat(Self.fltValFre, 2)) > (fFormataFloat(Result, 2)) Then
        Result := 0
      Else
        Result := Result - Self.fltValFre;

    End;

  End;

end;

function TFatVendaBase.fZerarPeso: Boolean;
begin
  Result := ((blnNotEsp) And (Pos(strClaFis, '1926_5926_2926_6926_') > 0));
end;

function TFatVendaBase.fDestacarIRPF(Var fltValRet: Double): Boolean;
  Var
    strSQL: String;
    fltTotDev: Double;
    fltTotRet: Double;
    intQtdNot: Integer;
    dtaDtaIni: TDateTime;
    dtaDtaFin: TDateTime;
    qryGenGer: TUniQuery;
    fltTotalDeFaturamentoNoMes: Double;

begin
  qryGenGer := fCriaQuery(Self);

  intQtdNot := 1;
  strNotRet := '';
  fltValRet := 0.0;

  {*******************************************}
  {* SE FOR RETENÇÃO E PESSOA JURIDICA       *}
  {****************************************MV*}
  If (strRetIrf <> 'S') Or (Length(strCliCgc) <= 11) Then
  Begin
    Result := False;
    Exit;
  End;

  dtaDtaIni := StartOfTheMonth(Self.VS_Date);
  dtaDtaFin := EndOfTheMonth(Self.VS_Date);

  {********************************************}
  {* PEGA AS ULTIMAS 4 NOTAS QUE NAO RETIVERAM*}
  {* OS IMPOSTOS                              *}
  {*****************************************MV*}
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  GER_NUMDOC, ';
  strSQL := strSQL + '  GER_ESPDOC, ';
  strSQL := strSQL + '  GER_DTAENT, ';
  strSQL := strSQL + '  GER_HORENT, ';
  strSQL := strSQL + '  GER_VALIRF AS TOTDEV, ';
  strSQL := strSQL + '  GER_IRFRET AS TOTRET ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + IIF(strOpcDoc = 'CF',' GER_ESPDOC <> "FF" AND ', '');
  strSQL := strSQL + '  GER_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '  GER_CODCLI = :CODCLI ';

  strSQL := strSQL + 'UNION ALL ' + AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');

  strSQL := strSQL + 'ORDER BY ';
  strSQL := strSQL + '  3 DESC, 4 DESC ';
  strSQL := strSQL + 'LIMIT 4 ';

  If (strCliOrg <> 'S') Then
  Begin

    With qryGenGer Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODCLI').AsString   := strCodCli;
      ParamByName('DTAINI').AsDateTime := dtaDtaIni;
      ParamByName('DTAFIN').AsDateTime := dtaDtaFin;
      Open;

      While ((Not Eof) And (intQtdNot < 4) And (FieldByName('TOTRET').AsFloat <= 0)) Do
      Begin
        strNotRet := strNotRet + FieldByName('GER_NUMDOC').AsString + '-' + FieldByName('GER_ESPDOC').AsString + ',';
        Inc(intQtdNot);
        Next;
      End;

      Close;
    End;

  End;

  If (RightStr(strNotRet, 1) = ',') Then
    strNotRet := Copy(strNotRet, 1, Length(strNotRet) -1);

  {*******************************************}
  {* SOMA OS IMPOSTOS RETIDOS E DEVIDOS      *}
  {****************************************MV*}
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  SUM(GER_VLRCON) AS TOTFAT, ';
  strSQL := strSQL + '  SUM(GER_VALIRF) AS TOTDEV, ';
  strSQL := strSQL + '  SUM(GER_IRFRET) AS TOTRET, ';

  strSQL := strSQL + '  SUM(GER_IRPRDV - GER_IRPRRT) AS TOTIRFPRO, ';
  strSQL := strSQL + '  SUM(GER_IRSEDV - GER_IRSERT) AS TOTIRFSER ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + IIF(strOpcDoc = 'CF',' GER_ESPDOC <> "FF" AND ', '');
  strSQL := strSQL + '  GER_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '  GER_CODCLI = :CODCLI ';

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('DTAINI').AsDateTime := dtaDtaIni;
    ParamByName('DTAFIN').AsDateTime := dtaDtaFin;
    Open;
    fltTotRet := FieldByName('TOTRET').AsFloat;
    fltTotDev := FieldByName('TOTDEV').AsFloat;

    fltIrPrRt := FieldByName('TOTIRFPRO').AsFloat;
    fltIrSeRt := FieldByName('TOTIRFSER').AsFloat;

    fltTotalDeFaturamentoNoMes := FieldByName('TOTFAT').AsFloat;

    Close;
  End;

  strSQL := AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('DTAINI').AsDateTime := dtaDtaIni;
    ParamByName('DTAFIN').AsDateTime := dtaDtaFin;
    Open;
    fltTotRet := fltTotRet + FieldByName('TOTRET').AsFloat;
    fltTotDev := fltTotDev + FieldByName('TOTDEV').AsFloat;

    fltIrPrRt := fltIrPrRt + FieldByName('TOTIRFPRO').AsFloat;
    fltIrSeRt := fltIrSeRt + FieldByName('TOTIRFSER').AsFloat;

    fltTotalDeFaturamentoNoMes := fltTotalDeFaturamentoNoMes + FieldByName('TOTFAT').AsFloat;

    Close;
  End;

  fltValRet := fltTotDev + fltValIrf;

  fltTotalDeFaturamentoNoMes := fltTotalDeFaturamentoNoMes + fltTotGer;

  fltIrPrRt := fltIrPrRt + fltIrPrDv;
  fltIrSeRt := fltIrSeRt + fltIrSeDv;

  If (fltTotalDeFaturamentoNoMes > fltMinIrf) Or ((strCliOrg = 'S') And (strCalIcm = 'N')) Then
  Begin
    fltValRet := fltValRet - fltTotRet;
    Result := True;
  End
  Else
  Begin
    Result    := False;
    fltValRet := 0.0;
    fltIrPrRt := 0.0;
    fltIrSeRt := 0.0;
    strNotRet := '';
  End;

  FreeAndNil(qryGenGer);

end;

function TFatVendaBase.fDestacarPis_Cofins_Csll(
  var fltSerRet: Double): Boolean;
  Var
    strSQL: String;
    fltTotDev: Double;
    fltTotRet: Double;
    intQtdNot: Integer;
    dtaDtaIni: TDateTime;
    dtaDtaFin: TDateTime;
    qryGenGer: TUniQuery;

begin
  qryGenGer := fCriaQuery(Self);

  intQtdNot := 1;
  strNoReSe := '';
  fltSerRet := 0.0;

  {*******************************************}
  {* SE FOR RETENÇÃO E PESSOA JURIDICA       *}
  {****************************************MV*}
  If (strRetPCo <> 'S') Or (Length(strCliCgc) <= 11) Then
  Begin
    Result := False;
    Exit;
  End;

  //FEDERAL
  If (strCliOrg = 'S') Then
  Begin
    fltSerRet := fltTotSer;
    fltRetPis := fltValPis;
    fltRetCof := fltValCof;
    fltRetCsl := fltValCsl;

    fltPiPrRt := fltPiPrDv;
    fltPiSeRt := fltPiSeDv;
    fltCoPrRt := fltCoPrDv;
    fltCoSeRt := fltCoSeDv;
    fltCsPrRt := fltCsPrDv;
    fltCsSeRt := fltCsSeDv;

    Result    := True;
    Exit;
  End;

  dtaDtaIni := StartOfTheMonth(Self.VS_Date);
  dtaDtaFin := EndOfTheMonth(Self.VS_Date);

  {********************************************}
  {* PEGA AS ULTIMAS 4 NOTAS QUE NAO RETIVERAM*}
  {* OS IMPOSTOS                              *}
  {*****************************************MV*}
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  GER_NUMDOC, ';
  strSQL := strSQL + '  GER_ESPDOC, ';
  strSQL := strSQL + '  GER_DTAENT, ';
  strSQL := strSQL + '  GER_HORENT, ';
  strSQL := strSQL + '  GER_TOTSER AS TOTDEV, ';
  strSQL := strSQL + '  GER_SERRET AS TOTRET ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + IIF(strOpcDoc = 'CF',' GER_ESPDOC <> "FF" AND ', '');
  strSQL := strSQL + '  GER_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '  GER_TOTSER > 0 AND ' ;
  strSQL := strSQL + '  GER_CODCLI = :CODCLI ';

  strSQL := strSQL + 'UNION ALL ' + AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');

  strSQL := strSQL + 'ORDER BY ';
  strSQL := strSQL + '  3 DESC, 4 DESC ';
  strSQL := strSQL + 'LIMIT 4 ';

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString   := strCodCli;
    ParamByName('DTAINI').AsDateTime := dtaDtaIni;
    ParamByName('DTAFIN').AsDateTime := dtaDtaFin;
    Open;

    While ((Not Eof) And (intQtdNot < 4) And (FieldByName('TOTRET').AsFloat <= 0)) Do
    Begin
      strNoReSe := strNoReSe + FieldByName('GER_NUMDOC').AsString + '-' + FieldByName('GER_ESPDOC').AsString + ',';
      Inc(intQtdNot);
      Next;
    End;

    Close;
  End;

  strNoReSe := Copy(strNoReSe, 1, Length(strNoReSe) -1);

  {*******************************************}
  {* SOMA OS SERVIÇOS RETIDOS E DEVIDOS      *}
  {****************************************MV*}
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  SUM(GER_VALPIS - GER_PISRET) AS TOTPIS, ';
  strSQL := strSQL + '  SUM(GER_VALCOF - GER_COFRET) AS TOTCOF, ';
  strSQL := strSQL + '  SUM(GER_VALCSL - GER_CSLRET) AS TOTCSL, ';

  strSQL := strSQL + '  SUM(GER_PIPRDV - GER_PIPRRT) AS TOTPISPRO, ';
  strSQL := strSQL + '  SUM(GER_COPRDV - GER_COPRRT) AS TOTCOFPRO, ';
  strSQL := strSQL + '  SUM(GER_CSPRDV - GER_CSPRRT) AS TOTCSLPRO, ';

  strSQL := strSQL + '  SUM(GER_PISEDV - GER_PISERT) AS TOTPISSER, ';
  strSQL := strSQL + '  SUM(GER_COSEDV - GER_COSERT) AS TOTCOFSER, ';
  strSQL := strSQL + '  SUM(GER_CSSEDV - GER_CSSERT) AS TOTCSLSER, ';

  strSQL := strSQL + '  SUM(GER_TOTSER) AS TOTDEV, ';
  strSQL := strSQL + '  SUM(GER_SERRET) AS TOTRET ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  MOVGER ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + IIF(strOpcDoc = 'CF',' GER_ESPDOC <> "FF" AND ', '');
  strSQL := strSQL + '  GER_DTAENT BETWEEN :DTAINI AND :DTAFIN AND ';
  strSQL := strSQL + '  GER_TOTSER > 0 AND ';
  strSQL := strSQL + '  GER_CODCLI = :CODCLI ';

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('DTAINI').AsDateTime := dtaDtaIni;
    ParamByName('DTAFIN').AsDateTime := dtaDtaFin;
    Open;
    fltTotRet := FieldByName('TOTRET').AsFloat;
    fltTotDev := FieldByName('TOTDEV').AsFloat;
    fltRetPis := FieldByName('TOTPIS').AsFloat;
    fltRetCof := FieldByName('TOTCOF').AsFloat;
    fltRetCsl := FieldByName('TOTCSL').AsFloat;

    fltPiPrRt := FieldByName('TOTPISPRO').AsFloat;
    fltPiSeRt := FieldByName('TOTPISSER').AsFloat;
    fltCoPrRt := FieldByName('TOTCOFPRO').AsFloat;
    fltCoSeRt := FieldByName('TOTCOFSER').AsFloat;
    fltCsPrRt := FieldByName('TOTCSLPRO').AsFloat;
    fltCsSeRt := FieldByName('TOTCSLSER').AsFloat;

    Close;
  End;

  strSQL := AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER');

  With qryGenGer Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString := strCodCli;
    Open;
    fltTotRet := fltTotRet + FieldByName('TOTRET').AsFloat;
    fltTotDev := fltTotDev + FieldByName('TOTDEV').AsFloat;
    fltRetPis := fltRetPis + FieldByName('TOTPIS').AsFloat;
    fltRetCof := fltRetCof + FieldByName('TOTCOF').AsFloat;
    fltRetCsl := fltRetCsl + FieldByName('TOTCSL').AsFloat;

    fltPiPrRt := fltPiPrRt + FieldByName('TOTPISPRO').AsFloat;
    fltPiSeRt := fltPiSeRt + FieldByName('TOTPISSER').AsFloat;
    fltCoPrRt := fltCoPrRt + FieldByName('TOTCOFPRO').AsFloat;
    fltCoSeRt := fltCoSeRt + FieldByName('TOTCOFSER').AsFloat;
    fltCsPrRt := fltCsPrRt + FieldByName('TOTCSLPRO').AsFloat;
    fltCsSeRt := fltCsSeRt + FieldByName('TOTCSLSER').AsFloat;
    Close;
  End;

  fltRetPis := fltRetPis + fltValPis;
  fltRetCof := fltRetCof + fltValCof;
  fltRetCsl := fltRetCsl + fltValCsl;

  fltSerRet := fltTotDev + fltTotSer;

  fltPiPrRt := fltPiPrRt + fltPiPrDv;
  fltPiSeRt := fltPiSeRt + fltPiSeDv;
  fltCoPrRt := fltCoPrRt + fltCoPrDv;
  fltCoSeRt := fltCoSeRt + fltCoSeDv;
  fltCsPrRt := fltCsPrRt + fltCsPrDv;
  fltCsSeRt := fltCsSeRt + fltCsSeDv;

  If (fltSerRet > fltMinSer) Then
  Begin
    fltSerRet := fltSerRet - fltTotRet;
    Result := True;
  End
  Else
  Begin
    Result    := False;
    fltSerRet := 0.0;
    fltRetPis := 0.0;
    fltRetCof := 0.0;
    fltRetCsl := 0.0;

    fltPiPrRt := 0.0;
    fltPiSeRt := 0.0;
    fltCoPrRt := 0.0;
    fltCoSeRt := 0.0;
    fltCsPrRt := 0.0;
    fltCsSeRt := 0.0;

    strNoReSe := '';
  End;

  FreeAndNil(qryGenGer);

end;

function TFatVendaBase.fZeraIrpjPisCofCsl: Boolean;
begin
  Result := False;

  If fTemQueZeraIprjPisCofCsl Then
  Begin
    If (strCliOrg = 'N') Then
    Begin
      fltAlqPis := 0.0;
      fltValPis := 0.0;
      fltAlqCof := 0.0;
      fltValCof := 0.0;
      fltAlqCsl := 0.0;
      fltValCsL := 0.0;

      fltPiPrDv := 0.0;
      fltPiSeDv := 0.0;
      fltCoPrDv := 0.0;
      fltCoSeDv := 0.0;
      fltCsPrDv := 0.0;
      fltCsSeDv := 0.0;

      Result := True;
    End;

    If Result And (Not ((strCliOrg = 'S') And (strCalIcm = 'N'))) Then
    Begin
      fltAlqIrf := 0.0;
      fltValIrf := 0.0;
      fltIrSeDv := 0.0;
      fltIrPrDv := 0.0;
    End;
  End;
end;

function TFatVendaBase.fTotalRetencoesServicos: Double;
begin
  Result := fltVlSgSo;//Seguridade social

  If (blnDtcIrf) Then
    Result := Result + fltIrSeRt;//Valor do IRPF Retido (Serviços)

  If (blnDtcPis) Then
    Result := Result + fltPiSeRt;//Valor do PIS Retido (Serviços)

  If (blnDtcCof) Then
    Result := Result + fltCoSeRt;//Valor do COFINS Retido (Serviços)

  If (blnDtcCsl) Then
    Result := Result + fltCsSeRt;//Valor do CSLL Retido (Serviços)
end;

Procedure TFatVendaBase.pLimparEnderecoEntrega;
begin
  FillChar(objEndEnt.recEndere, SizeOf(objEndEnt.recEndere), #0);

  If (Pos(Self.strOpcDoc, 'PD_OR_VN_CP_') > 0) And (fCfgSis('TAXENT', varString) = 'S') Then
    Self.pAtualizaValorTaxaEntrega;
end;

function TFatVendaBase.fRecebidoPorPix: boolean;
begin
  Result := False;

  If Not Assigned(self.DadosPixDaVenda.ObjetoPixPago) Then
    Exit;

  Result := TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(self.DadosPixDaVenda.ObjetoPixPago);
end;

Procedure TFatVendaBase.pEnderecoToFatVenda;
Begin
  Self.strAutEnt := objEndEnt.recEndere.strIncrem;

  If objEndEnt.recEndere.blnAltera Then
  Begin
    Self.enderecoEntrega := objEndEnt.recEndere;
    Self.enderecoEntrega.strNomCid := fRetNomCidade(Self.enderecoEntrega.strCidEnt);
    Self.enderecoEntrega.strCoIbge := fRetornaCodIBGE(Self.enderecoEntrega.strCidEnt);
    Self.strTraRdp := Self.enderecoEntrega.strTraRed;

    If Not fEmptyStr(Self.enderecoEntrega.strCodTra) Then
    Begin
      if not Self.fRecebidoPorPix then
      begin
        Self.strCodTra := Self.enderecoEntrega.strCodTra;
        Self.strTraEnt := fRetNomTransportadora(Self.enderecoEntrega.strCodTra);
      end;
    End;

    If Not fEmptyStr(Self.enderecoEntrega.strCobIss) Then
      Self.strCobIss := Self.enderecoEntrega.strCobIss;

    If Not fEmptyStr(Self.enderecoEntrega.strCodObr) Then
      Self.strCodObr := Self.enderecoEntrega.strCodObr;

    If Not fEmptyStr(Self.enderecoEntrega.strCodArt) Then
      Self.strCodArt := objEndEnt.recEndere.strCodArt;

    If Not fEmptyStr(Self.enderecoEntrega.strCodCno) Then
      Self.strCodCno := objEndEnt.recEndere.strCodCno;

    If Not fEmptyStr(Self.enderecoEntrega.strInsImo) Then
      Self.strInsImo := objEndEnt.recEndere.strInsImo;

    If Not fEmptyStr(Self.enderecoEntrega.strCodCib) Then
      Self.strCodCib := objEndEnt.recEndere.strCodCib;

    // verifica se o endereço que selecionado é diferente do endereço principal de entrega
    Self.strConCli := objEndEnt.recEndere.strConEnt;
    Self.strFonCli := objEndEnt.recEndere.strTelEnt;
    Self.strRefEnt := objEndEnt.recEndere.strRefEnt;

    If (Not fEmptyStr(Self.enderecoEntrega.strTipFre)) Then
      Self.strTipFre := IfThen(Not fPermitirFreteNoFaturamento, '9', Self.enderecoEntrega.strTipFre);

    If (Pos(Self.strOpcDoc, 'PD_OR_VN_CP_') > 0) And (fCfgSis('TAXENT', varString) = 'S') Then
      Self.pAtualizaValorTaxaEntrega;
  End;
End;

function TFatVendaBase.fTotalRetencoesProdutos: Double;
begin
  Result := 0.00;

  If (blnDtcIrf) Then
    Result := Result + fltIrPrRt;//Valor do IRPF Retido (Produto)

  If (blnDtcPis) Then
    Result := Result + fltPiPrRt;//Valor do PIS Retido (Produto)

  If (blnDtcCof) Then
    Result := Result + fltCoPrRt;//Valor do COFINS Retido (Produto)

  If (blnDtcCsl) Then
    Result := Result + fltCsPrRt;//Valor do CSLL Retido (Produto)
end;

function TFatVendaBase.fTemQueZeraIprjPisCofCsl: Boolean;
  Var
    fltMinImp: Double;
    blnZerImp: Boolean;

    fltValIrfTmp,
    fltValPisTmp,
    fltValCofTmp,
    fltValCslTmp: Double;
begin
  Result    := False;
  blnZerImp := False;

  If (blnDocumentoTemServicos) And (Pos(strEspDoc, 'NS_NF_') > 0) Then
    blnZerImp := True;

  If Not blnZerImp Then
    Exit;

  fltMinImp := fCfgSis('MINIMP', VarDouble);

  fltValIrfTmp := fltValIrf;
  fltValPisTmp := fltValPis;
  fltValCofTmp := fltValCof;
  fltValCslTmp := fltValCsL;

  Result := (fFormataFloat(fltValIrfTmp, 2) + fFormataFloat(fltValPisTmp, 2) +
             fFormataFloat(fltValCofTmp, 2) + fFormataFloat(fltValCsLTmp, 2)) < fFormataFloat(fltMinImp, 2);
end;

function TFatVendaBase.fNotaServicoConcretoSubProdutos: Boolean;
var
  blnFigueiredo_J_A_MassaConcreto : Boolean;
begin
  blnFigueiredo_J_A_MassaConcreto := (fCfgSis('TPNFCR') = FIGUEIREDO) Or (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO);
  Result := (Self.strEspDoc = 'NS') And
            blnFigueiredo_J_A_MassaConcreto And
            (fCfgSis('USACCR', varString) = 'S');
end;

function TFatVendaBase.fCstGravaIsento(strCodEmp: String; strCodFis: String; strClaFis: String): Boolean;
var
  strExcCfoCst: String;
begin
  strExcCfoCst := fCampoTabela('CFG_ISEOUT', 'CFOPCST', ['CFG_CODEMP', 'CFG_CODCFO', 'CFG_CODCST'], [strCodEmp, strClaFis, strCodFis], False);

  If not fEmptyStr(strExcCfoCst) Then
    Result := (strExcCfoCst = 'I')
  Else
    Result := fCodFisGravaIsento(strCodFis, strClaFis);
end;

{******************************************************************************}
{* DEFINE SE ITENS COM REDUÇÃO OU ITENS ISENTOS DO GRUPO X40 TERÃO SEU VALORES*}
{* GRAVADOS NO CAMPO "ISENTAS" DE ACORDO COM A INTERPRETAÇÃO/NECESSIDADE      *}
{* DA CONTABILIDADE DO CLIENTE                                                *}
{***************************************************************************VA*}
function TFatVendaBase.fCodFisGravaIsento(strCodFis: String; strClaFis: String): Boolean;
begin
  If (RightStr(strCodFis, 2) = '30') And (strToIntDef(strClaFis, 0) >= 5000) Then
    Result := (fCfgSis('LVRD30', varString) = 'I')
  Else If (RightStr(strCodFis, 2) = '51') And (strToIntDef(strClaFis, 0) >= 5000) Then
    Result := (fCfgSis('LVRD51', varString) = 'I')
  Else If (RightStr(strCodFis, 2) = '41') And ((strClaFis.Contains('905')) Or (strClaFis.Contains('906'))) Then
    Result := (fCfgSis('LVPS41') = 'I')
  Else If Pos(strCodFis, CST_REDUCAO) > 0 Then
  Begin
    Result := ((RightStr(strCodFis, 2) = '20') And (fCfgSis('LVPRED') = 'I')) Or
              ((RightStr(strCodFis, 2) = '70') And (fCfgSis('LVRD70') = 'I'))
  End
  Else If Pos(strCodFis, CST_ISENTO) > 0 Then
  Begin
    {**************************************************************************}
    {* GRUPO X40 TEM TRATAMENTO DIFERENCIADO. É DEFINIDO COMO ISENTO EM       *}
    {* COMBINAÇÃO COM A CFG_LVPISS. REQ. 33070                                *}
    {***********************************************************************VA*}
    Result := (RightStr(strCodFis, 2) <> '40') Or
              ((RightStr(strCodFis, 2) = '40') And (fCfgSis('LVPISS', varString) = 'I'));
  End
  Else If (RightStr(strCodFis, 2) = '41') And (strClaFis.Contains('922')) Then
