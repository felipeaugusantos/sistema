end;

function TFatVendaBase.fDescontoPorDesAplicado(const AUnitar, AUniOri, AUniDig, ADesCon, ATaxJur: Double): Boolean;
  var
    fltPorDesAux : Double;
    fltDesAux : Double;
    fltTotDesc : Double;
    blnTemDesconto : Boolean;
    intMaxDecUni : Integer;
    fltValDesCon : Double;
    fltValDesPgto : Double;
    fltValTaxJur : Double;
begin
  blnTemDesconto := False;

  intMaxDecUni := Max(VS_intDecUni, 4);

  if Self.fltPorDes > 0 then
  begin
    if (fFormataFloat(AUnitar, VS_intDecUni) <> fFormataFloat(AUniOri, VS_intDecUni)) then
    begin
      fltValDesCon := ((AUniDig * ADesCon) / 100);
      fltPorDesAux := fFormataFloat(((AUniDig - fltValDesCon) * Self.fltPorDes) / 100, intMaxDecUni);
      fltDesAux    := fFormataFloat(AUniOri, VS_intDecUni) - fFormataFloat(AUniDig, VS_intDecUni);

      fltValTaxJur := 0;
      If (ATaxJur > 0) Then
        fltValTaxJur := fFormataFloat(((AUniDig - fltValDesCon - fltPorDesAux) * (ATaxJur / 100)), VS_intDecUni);

      fltTotDesc   := (fltPorDesAux + fltDesAux + fltValDesCon) - fltValTaxJur;

      fltValDesPgto := 0;
      if strCAbDes = 'S' then
      begin
        fltValDesPgto := ((AUniOri - fltTotDesc) * fltDMVCnd) / 100;
      end;

      blnTemDesconto := CompareValue(AUnitar + fltTotDesc + fltValDesPgto, AUniOri, 0.05) = EqualsValue;
    end;
  end;

  Result := (Self.blnPassouPelaTelaDescontoEConfirmou) And (Self.fltPorDes <> 0) And blnTemDesconto;
end;

function TFatVendaBase.fDescontoDesCndAplicado(const AUnitar, AUniOri, AUniDig, ADesCon, ADesCnd, ATaxJur: Double): Boolean;
  var
    fltPorDesAux : Double;
    fltDesAux : Double;
    fltTotDesc : Double;
    blnTemDesconto : Boolean;
    intMaxDecUni : Integer;
    fltValDesCon : Double;
    fltValDesPgto : Double;
    fltValTaxJur : Double;
begin
  blnTemDesconto := False;

  intMaxDecUni := Max(VS_intDecUni, 4);

  if (ADesCnd > 0) then
  begin
    if (fFormataFloat(AUnitar, VS_intDecUni) <> fFormataFloat(AUniOri, VS_intDecUni)) then
    begin
      fltValDesCon  := ((AUniDig * ADesCon) / 100);
      fltPorDesAux  := fFormataFloat(((AUniDig - fltValDesCon) * Self.fltPorDes) / 100, intMaxDecUni);
      fltDesAux     := fFormataFloat(AUniOri, VS_intDecUni) - fFormataFloat(AUniDig, VS_intDecUni);

      fltValTaxJur := 0;
      If (ATaxJur > 0) Then
        fltValTaxJur := fFormataFloat(((AUniDig - fltValDesCon - fltPorDesAux) * (ATaxJur / 100)), VS_intDecUni);

      fltTotDesc := (fltPorDesAux + fltDesAux + fltValDesCon) - fltValTaxJur;

      fltValDesPgto := ((AUniOri - fltTotDesc) * ADesCnd) / 100;

      blnTemDesconto := CompareValue(AUnitar + fltTotDesc + fltValDesPgto, AUniOri, 0.05) = EqualsValue;
    end;
  end;

  Result := (Self.blnPassouPelaTelaDescontoEConfirmou) And (ADesCnd > 0) And blnTemDesconto;
end;

function TFatVendaBase.fTodosOsItensDaVendaSaoPromocionais: Boolean;
var
  cdsDados   : TUniClientDataSet;
  strEmpresa : String;
begin
  Result := True;

  If cdsVenda.IsEmpty Then
    Exit(False);

  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      strEmpresa := IIF(cdsDados.FieldByName('ITE_EMPITE').AsString.IsEmpty, VS_strCodEmp, fGetEmpPrecoPromoItem(cdsDados.FieldByName('ITE_EMPITE').AsString, cdsDados.FieldByName('ITE_EMPDMP').AsString));

      If fItemSemNenhumaPromocao(cdsDados.FieldByName('ITE_CODITE').AsString, strEmpresa) Then
        Exit(False);

      cdsDados.Next;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
end;

function TFatVendaBase.fConsiderarItemPromocionalNaValidacaoDaFaixaDeMargemMarkupDoPerfilCondPagto: Boolean;
begin
  Result := fCfgSis('ITEMAR', varBoolean);
end;

function TFatVendaBase.fEncontrouProdutoCortadoSemSaldo(strAutInc: String): Boolean;
var
  intContador: integer;
begin
  Result := False;

  for intContador := 0 to Length(Self.arrMatItensCorte) - 1 do
  begin
    if Self.arrMatItensCorte[intContador].strAutIncAnt = strAutInc then
    begin
      Exit(True);
    end;
  end;
end;

function TFatVendaBase.fIgnoraProdutoCortadoSemSaldo(strAutInc: String): Boolean;
begin
  Result := False;

  if (Pos(Self.strOpcDoc, 'PD_OR_VN_') <= 0) then
    Exit;

  if (Self.strOpcDoc = 'OR') and (Self.strEspDoc <> 'PD') then
    Exit;

  if (Self.strOpcDoc = 'VN') and (Self.strEspDoc <> 'PD') then
    Exit;

  if (not Assigned(Self.arrMatItensCorte)) then
    Exit;

  if (Length(Self.arrMatItensCorte) <= 0) then
    Exit;

  if (fEncontrouProdutoCortadoSemSaldo(strAutInc)) then
    Result := True;
end;

function TFatVendaBase.fRetornaItensCortadosNoFiltro(strFiltroOriginal: String; blnEhPedidoItemCortado: Boolean): String;
var
  intContador: Integer;
  strAutIncItens: String;
begin
  Result := strFiltroOriginal;

  if (cdsVenda = nil) then
    Exit;

  if (cdsVenda.RecordCount <= 0) then
    Exit;

  if (not Assigned(Self.arrMatItensCorte)) then
    Exit;

  if (Length(Self.arrMatItensCorte) <= 0) then
    Exit;

  strAutIncItens := '(';

  for intContador := 0 to Length(Self.arrMatItensCorte) - 1 do
  begin
    if cdsVenda.Locate('AUTOINCREM', Self.arrMatItensCorte[intContador].strAutIncAnt, []) then
    begin
      if Length(strAutIncItens) > 1 then
        strAutIncItens := strAutIncItens + ' AND ';

      if blnEhPedidoItemCortado then
      begin
         strAutIncItens := strAutIncItens +  ' AUTOINCREM = ' + QuotedStr(Self.arrMatItensCorte[intContador].strAutIncAnt);
      end
      else
      begin
        strAutIncItens := strAutIncItens +  ' AUTOINCREM <> ' + QuotedStr(Self.arrMatItensCorte[intContador].strAutIncAnt);
      end;
    end;
  end;

  if Length(strAutIncItens) <= 1 then
    Exit;

  if not fEmptyStr(Result) then
    Result := Result + ' AND ';

  Result := Result + strAutIncItens + ')';
end;

procedure TFatVendaBase.pAtualizaItensCortados(Var cdsDados: TUniClientDataSet; blnEhPedidoItemCortado: Boolean);
begin
  cdsDados.Filtered := False;
  cdsDados.Filter := fRetornaItensCortadosNoFiltro(cdsDados.Filter, blnEhPedidoItemCortado);
  cdsDados.Filtered := True;
end;

