procedure TFatVendaBase.pCalculaCadFis(Var arrLivFis : TArrLivFis; strChaveAcesso : String = '');
  Var
    blnConIpi: Boolean;
    fltDesAceUti: Double;
    fltTotFreUti: Double;
    strEspDocQueNaoPodeDesdobrar: String;
    strClaFisDesAce: String;
    strClaFisTotFre: String;
    intIndiceLivroAtual: Integer;
    fltTotRetencao: Double;
    fltFatTir: Double;
    intContador : Integer;
    itemNFeComp : TNfeComplementoItem;
    strClaFisTmp: String;
    fltAlqIcmTmp: Double;
    fltVlrConTmp: Double;
    fltBasIcmTmp: Double;
    fltValIcmTmp: Double;
    fltOutrasTmp: Double;
    fltIsentoTmp: Double;
    fltValRetTmp: Double;
    fltBasRetTmp: Double;
    fltBasIpiTmp: Double;
    fltValipiTmp: Double;
    fltDAcessTmp: Double;
    fltValIssTmp: Double;
    fltValFcpTmp: Double;
    fltBasFcpTmp: Double;
    fltAlqFcpTmp: Double;
    fltValFcpSTTmp: Double;
    fltBasFcpSTTmp: Double;
    fltVaERetTmp: Double;
    intIndiceLivro : Integer;
    intItemComp: Integer;
    fltBasCbsTmp: Double;
    fltVlrCbsTmp: Double;
    fltBasIbsTmp: Double;
    fltVlrIbsTmp: Double;
    fltBas_ISTmp: Double;
    fltVlr_ISTmp: Double;

    function fEmDocumentosDeEntradaGravarComoIsentasEmCADFISQuandoCSTx41EmOperacoesDeFulfillment : Boolean;
      var
        blnEntrada : Boolean;
    begin

      Result := False;

      If Not (Self.Fulfillment.EhOperacaoFulfillment) Then
        Exit;

      blnEntrada := (FulfillmentMovimentacaoEstoque(Self.arrMatItens[intContador].strClaFis, strChaveAcesso, Self.FFulfillment.SiglaHubMarketPlace).EntradaSaida.Equals('E')) Or
                    (strToIntDef(Self.arrMatItens[intContador].strClaFis, 0) < 5000);

      If Not (blnEntrada) Then
        Exit;

      If Not (Self.arrMatItens[intContador].strCodFis.Contains('41')) Then
        Exit;

      If Not (fCfgSis('LVPI41', varString) = 'I') Then
        Exit;

      Result := True;

    end;

    function GravarComoIsentas : Boolean;
    begin

      Result := False;

      If (  fNotaServicoConcretoSubProdutos )                                               Or
         (( (Pos(strClaFisTmp, CFOP_TRANSF_DEPOSITO_FECHADO) > 0) ) And (Not arrMatItens[intContador].strCodFis.Contains('41'))) Or
         ( (AnsiRightStr(strClaFisTmp, 3) = '910') And (blnConIpi) )                        Or
         ( (strOpcDoc <> 'NC') And fCstGravaIsento(VS_strCodEmp, arrMatItens[intContador].strCodFis, strClaFisTmp) ) Then
      Begin
        If ( AnsiRightStr(strClaFisTmp, 3) <> '922') Or ((AnsiRightStr(strClaFisTmp, 3) =  '922') And (arrMatItens[intContador].strCodFis.Contains('41'))) Then
          Exit(True);
      End;

      If (fEmDocumentosDeEntradaGravarComoIsentasEmCADFISQuandoCSTx41EmOperacoesDeFulfillment) Then
        Exit(True);

    end;

    procedure DefineFinalidadeNFe;
    begin
      If not (Self.strOpcDoc = 'DV') Then
        Exit;
      // devolução
      Self.strFinNfe := '4' ;
      Self.strFinTip := ''  ;
      // Retorno por Recusa
      If Self.blnRetornoPorRecusa Then
      Begin
        Self.strFinNfe := '5' ;

        If Self.blnDevolucaoCompleta Then
          Self.strFinTip := '03'
        Else
          Self.strFinTip := '06' ;
      End;
    end;

Begin
  FillChar(arrLivFis, Length(arrLivFis), #0);

  blnConIpi := fCfgSis('CONIPI', varBoolean);

  strEspDocQueNaoPodeDesdobrar := 'CR_TR_';
  If fCfgSis('DESFIS', varBoolean) Then
    strEspDocQueNaoPodeDesdobrar := strEspDocQueNaoPodeDesdobrar + 'PD_OR_';

  fltDesAceUti := 0;
  fltTotFreUti := 0;

  strClaFisDesAce := '';
  strClaFisTotFre := '';

  intIndiceLivroAtual := 0;

  DefineFinalidadeNFe;

  If (strOpcDoc <> 'NC') Then
  Begin
    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin

      If Not fEhItemServico(arrMatItens[intContador].strCodIte) Then
      Begin
        {*****************************************}
        {* REALIZA O CÁLCULO DO ITEM ATUAL.      *}
        {**************************************MV*}
        strClaFisTmp := arrMatItens[intContador].strClaFis;
        fltAlqIcmTmp := arrMatItens[intContador].fltAlqIcm;

        fltBasCbsTmp := arrMatItens[intContador].fltBasCBS;
        fltVlrCbsTmp := arrMatItens[intContador].fltValCBS;
        fltBasIbsTmp := arrMatItens[intContador].fltBasIBS;
        fltVlrIbsTmp := arrMatItens[intContador].fltValIBS;
        fltBas_ISTmp := arrMatItens[intContador].fltBas_IS;
        fltVlr_ISTmp := arrMatItens[intContador].fltVal_IS;

        fltVaERetTmp := 0;
        If (fGravaValorRetidoEntradaNosCamposProprios) Then
          fltVaERetTmp := arrMatItens[intContador].fltVaERet;

        fltVlrConTmp := arrMatItens[intContador].fltTotIte -
                        arrMatItens[intContador].fltDesEsp -
                        IIF(Self.blnClienteZonaFrancaComDescontoEspecial, arrMatItens[intContador].fltVrdIcm, 0) +
                        arrMatItens[intContador].fltValFre +
                        arrMatItens[intContador].fltDesAce +
                        arrMatItens[intContador].fltValIpi +
                        IIF((arrMatItens[intContador].fltValRet > 0), arrMatItens[intContador].recDifalFCP.fltValFcp, 0) +
                        arrMatItens[intContador].fltValRet +
                        fltVaERetTmp +
                        arrMatItens[intContador].fltValCBS +
                        arrMatItens[intContador].fltValIBS +
                        arrMatItens[intContador].fltVal_IS;

        If LeftStr(strClaFisTmp, 1) = '3' Then
        Begin
          fltVlrConTmp := fltVlrConTmp + arrMatItens[intContador].fltValPis +
                                         arrMatItens[intContador].fltValCof +
                                         arrMatItens[intContador].fltVal_II +
                                         arrMatItens[intContador].fltImpTax +
                                         arrMatItens[intContador].fltVafRmm +
                                         arrMatItens[intContador].fltValIcm +
                                         arrMatItens[intContador].fltDesAdu +
                                         arrMatItens[intContador].fltValIof;

        End;

        fltBasIcmTmp := arrMatItens[intContador].fltBasIcm;
        fltValIcmTmp := arrMatItens[intContador].fltValIcm;

        fltOutrasTmp := fltVlrConTmp                       -
                        arrMatItens[intContador].fltBasIcm -
                        arrMatItens[intContador].fltValIpi -
                        IIF((arrMatItens[intContador].fltValRet > 0), arrMatItens[intContador].recDifalFCP.fltValFcp, 0) -
                        arrMatItens[intContador].fltValRet -
                        fltVaERetTmp -
                        arrMatItens[intContador].fltValCBS -
                        arrMatItens[intContador].fltValIBS -
                        arrMatItens[intContador].fltVal_IS;

        If (fltOutrasTmp < 0.0) Then
          fltOutrasTmp := 0.0;

        fltIsentoTmp := 0.0;

        If GravarComoIsentas Then
        Begin
          fltIsentoTmp := fltOutrasTmp;
          fltOutrasTmp := 0.0;
        End;

        fltValRetTmp := arrMatItens[intContador].fltValRet;
        fltBasRetTmp := arrMatItens[intContador].fltBasRet;
        If (fGravaValorRetidoEntradaNosCamposProprios) Then
        Begin
          If fRegimeSubstituicaoTributaria(GetEmpCfg(arrMatItens[intContador].strEmpIte), Self.fOpcDocClaSub) = '1' Then
          Begin
            fltValRetTmp := arrMatItens[intContador].fltVaERet;
            fltBasRetTmp := arrMatItens[intContador].fltBaERet;
          End
          Else
          Begin
            fltValRetTmp := arrMatItens[intContador].fltValRet;
            fltBasRetTmp := arrMatItens[intContador].fltBasRet;
          End;
        End;

        fltValFcpTmp   := 0;
        fltBasFcpTmp   := 0;
        fltValFcpSTTmp := 0;
        fltBasFcpSTTmp := 0;

        fltAlqFcpTmp := arrMatItens[intContador].recDifalFCP.fltPerFcp;

        If fGravaEspelhoFundoCombateIMCeFundoCombateST(arrMatItens[intContador].strClaFis, arrMatItens[intContador].strEmpIte) Then
        Begin
          fltBasFcpTmp   := arrMatItens[intContador].EspelhoFcpIcms.fltBase;
          fltValFcpTmp   := arrMatItens[intContador].EspelhoFcpIcms.fltValor;

          fltBasFcpSTTmp := arrMatItens[intContador].EspelhoFcpIcmsST.fltBase;
          fltValFcpSTTmp := arrMatItens[intContador].EspelhoFcpIcmsST.fltValor;
        End
        Else
        Begin
          If (arrMatItens[intContador].VisualizarFcpIcms.fltBase <> arrMatItens[intContador].VisualizarFcpIcmsST.fltBase) And
             (arrMatItens[intContador].VisualizarFcpIcms.fltValor > 0) And (arrMatItens[intContador].VisualizarFcpIcmsST.fltValor > 0) Then
          Begin
            fltBasFcpTmp   := arrMatItens[intContador].VisualizarFcpIcms.fltBase;
            fltValFcpTmp   := arrMatItens[intContador].VisualizarFcpIcms.fltValor;

            fltBasFcpSTTmp := arrMatItens[intContador].VisualizarFcpIcmsST.fltBase;
            fltValFcpSTTmp := arrMatItens[intContador].VisualizarFcpIcmsST.fltValor;
          End
          Else
          Begin
            If (fltValRetTmp > 0) Then
            Begin
              fltValFcpSTTmp := arrMatItens[intContador].recDifalFCP.fltValFcp;
              fltBasFcpSTTmp := arrMatItens[intContador].recDifalFCP.fltBasFcp;
            End
            Else
            Begin
              fltBasFcpTmp   := arrMatItens[intContador].VisualizarFcpIcms.fltBase;
              fltValFcpTmp   := arrMatItens[intContador].VisualizarFcpIcms.fltValor;
            End;
          End;
        End;

        fltBasIpiTmp := arrMatItens[intContador].fltBasIpi;
        fltValIpiTmp := arrMatItens[intContador].fltValipi;
        fltValIssTmp := 0.0; // ATENÇÃO QUANDO FOR FAZER NO PADRÃO.

        {*****************************************}
        {* DESPESA ACESSÓRIA, UM CASO A PARTE:   *}
        {* SERÁ COLOCADA NA PRIMEIRA COLUNA CUJA *}
        {* ALÍQUOTA É A MESMA DA ALÍQUOTA DO ES- *}
        {* TADO DA EMPRESA.                      *}
        {* NESTE CASO, SOMA A TRIBUTAÇÃO SOBRE   *}
        {* A DESP. ACESSÓRIA NA SUBST. TRIB.     *}
        {* CASO NÃO ENCONTRE NENHUMA COLUNA,     *}
        {* CRIA-RÁ UMA NOVA PARA A DESP. ACE.    *}
        {**************************************MV*}
        fltDAcessTmp := 0.0;

        {*****************************************}
        {* 7101: ISENTO.                         *}
        {**************************************MV*}
        If (LeftStr(strClaFisTmp, 1) = '7') Then
        Begin
          fltOutrasTmp := fltVlrConTmp;

          If ((fltTotFreUti > 0.0) Or (fltDesAceUti > 0.0)) Then
          Begin
            fltIsentoTmp := fltTotFreUti + fltDesAceUti;
          End;

          fltVlrConTmp := fltVlrConTmp + fltTotFreUti + fltDesAceUti;

          fltTotFreUti   := 0.0;
          fltDesAceUti   := 0.0;

          fltAlqIcmTmp   := 0.0;
          fltBasIcmTmp   := 0.0;
          fltValIcmTmp   := 0.0;
          fltValRetTmp   := 0.0;
          fltBasRetTmp   := 0.0;
          fltBasIpiTmp   := 0.0;
          fltValipiTmp   := 0.0;
          fltDAcessTmp   := 0.0;
          fltValIssTmp   := 0.0;
          fltAlqFcpTmp   := 0.0;
          fltValFcpTmp   := 0.0;
          fltBasFcpTmp   := 0.0;
          fltValFcpSTTmp := 0.0;
          fltBasFcpSTTmp := 0.0;
        End;

        arrMatItens[intContador].fltOutIcm := fltOutrasTmp;
        arrMatItens[intContador].fltIseIcm := fltIsentoTmp;
        arrMatItens[intContador].fltVlrCon := fltVlrConTmp;

        If Not blnBaiEntFut And (arrMatItens[intContador].strEntFut = 'S') And (fCfgSis('ENFUOP') = '2') Then
        Begin
          fltBasRetTmp := 0.0;
          fltValRetTmp := 0.0;
          fltBasIpiTmp := 0.0;
          fltValipiTmp := 0.0;
        End;

        {*****************************************}
        {* CRIA NOVO REGISTRO NA MATRIZ.         *}
        {**************************************MV*}
        if Pos(strEspDoc, strEspDocQueNaoPodeDesdobrar) <= 0 then
        Begin
          intIndiceLivro := -1;
          If TDesmembrarMatrizItens.fDesdobroImpostos(arrMatItens[intContador].fltAlqIcm,
                                                      arrMatItens[intContador].strClaFis, intIndiceLivro, arrLivFis) Then
          Begin
            If (intIndiceLivro = 0) Then
            Begin
              Raise ExceptionAutCom.Create('Não foi possível gravar o bloco no livro fiscal. Quantidade máxima (5) de Classificações/Alíquotas excedida.'+#10#13+
                                           'Se possível, divida a operação em mais que um documento, reunindo os itens com mesmas características tributárias!');
            End;

            Inc(intIndiceLivroAtual);
            arrLivFis[intIndiceLivro].strClaFis   := strClaFisTmp;
            arrLivFis[intIndiceLivro].fltAlqIcm   := fltAlqIcmTmp;
            arrLivFis[intIndiceLivro].fltVlrCon   := fltVlrConTmp;
            arrLivFis[intIndiceLivro].fltBasIcm   := fltBasIcmTmp;
            arrLivFis[intIndiceLivro].fltValIcm   := fltValIcmTmp;
            arrLivFis[intIndiceLivro].fltOutras   := fltOutrasTmp;
            arrLivFis[intIndiceLivro].fltIsento   := fltIsentoTmp;
            arrLivFis[intIndiceLivro].fltRetido   := fltValRetTmp;
            arrLivFis[intIndiceLivro].fltBcReti   := fltBasRetTmp;
            arrLivFis[intIndiceLivro].fltBasIpi   := fltBasIpiTmp;
            arrLivFis[intIndiceLivro].fltValIpi   := fltValipiTmp;
            arrLivFis[intIndiceLivro].fltDAcess   := fltDAcessTmp;
            arrLivFis[intIndiceLivro].fltValIss   := fltValIssTmp;
            arrLivFis[intIndiceLivro].fltAlqFcp   := fltAlqFcpTmp;
            arrLivFis[intIndiceLivro].fltValFcp   := fltValFcpTmp;
            arrLivFis[intIndiceLivro].fltBasFcp   := fltBasFcpTmp;
            arrLivFis[intIndiceLivro].fltValFcpST := fltValFcpSTTmp;
            arrLivFis[intIndiceLivro].fltBasFcpST := fltBasFcpSTTmp;
            arrLivFis[intIndiceLivro].fltBasIbs   := fltBasIbsTmp;
            arrLivFis[intIndiceLivro].fltBasCbs   := fltBasCbsTmp;
            arrLivFis[intIndiceLivro].fltBas_IS   := fltBas_ISTmp;
            arrLivFis[intIndiceLivro].fltVlrIbs   := fltVlrIbsTmp;
            arrLivFis[intIndiceLivro].fltVlrCbs   := fltVlrCbsTmp;
            arrLivFis[intIndiceLivro].fltVlr_IS   := fltVlr_ISTmp;
          End

          {*****************************************}
          {* ACUMULA OS VALORES.                   *}
          {**************************************MV*}
          Else
          Begin
            arrLivFis[intIndiceLivro].fltVlrCon   := arrLivFis[intIndiceLivro].fltVlrCon + fltVlrConTmp;
            arrLivFis[intIndiceLivro].fltBasIcm   := arrLivFis[intIndiceLivro].fltBasIcm + fltBasIcmTmp;
            arrLivFis[intIndiceLivro].fltValIcm   := arrLivFis[intIndiceLivro].fltValIcm + fltValIcmTmp;
            arrLivFis[intIndiceLivro].fltOutras   := arrLivFis[intIndiceLivro].fltOutras + fltOutrasTmp;
            arrLivFis[intIndiceLivro].fltIsento   := arrLivFis[intIndiceLivro].fltIsento + fltIsentoTmp;
            arrLivFis[intIndiceLivro].fltRetido   := arrLivFis[intIndiceLivro].fltRetido + fltValRetTmp;
            arrLivFis[intIndiceLivro].fltBcReti   := arrLivFis[intIndiceLivro].fltBcReti + fltBasRetTmp;
            arrLivFis[intIndiceLivro].fltBasIpi   := arrLivFis[intIndiceLivro].fltBasIpi + fltBasIpiTmp;
            arrLivFis[intIndiceLivro].fltValIpi   := arrLivFis[intIndiceLivro].fltValIpi + fltValipiTmp;
            arrLivFis[intIndiceLivro].fltDAcess   := arrLivFis[intIndiceLivro].fltDAcess + fltDAcessTmp;
            arrLivFis[intIndiceLivro].fltValIss   := arrLivFis[intIndiceLivro].fltValIss + fltValIssTmp;
            arrLivFis[intIndiceLivro].fltBasFcp   := arrLivFis[intIndiceLivro].fltBasFcp + fltBasFCPTmp;
            arrLivFis[intIndiceLivro].fltValFcp   := arrLivFis[intIndiceLivro].fltValFcp + fltValFCPTmp;
            arrLivFis[intIndiceLivro].fltBasFcpST := arrLivFis[intIndiceLivro].fltBasFcpST + fltBasFcpSTTmp;
            arrLivFis[intIndiceLivro].fltValFcpST := arrLivFis[intIndiceLivro].fltValFcpST + fltValFcpSTTmp;
            arrLivFis[intIndiceLivro].fltBasIbs   := arrLivFis[intIndiceLivro].fltBasIbs + fltBasIbsTmp;
            arrLivFis[intIndiceLivro].fltBasCbs   := arrLivFis[intIndiceLivro].fltBasCbs + fltBasCbsTmp;
            arrLivFis[intIndiceLivro].fltBas_IS   := arrLivFis[intIndiceLivro].fltBas_IS + fltBas_ISTmp;
            arrLivFis[intIndiceLivro].fltVlrIbs   := arrLivFis[intIndiceLivro].fltVlrIbs + fltVlrIbsTmp;
            arrLivFis[intIndiceLivro].fltVlrCbs   := arrLivFis[intIndiceLivro].fltVlrCbs + fltVlrCbsTmp;
            arrLivFis[intIndiceLivro].fltVlr_IS   := arrLivFis[intIndiceLivro].fltVlr_IS + fltVlr_ISTmp;
          End;
        End;

      End//iteser
      Else
        arrMatItens[intContador].fltOutIcm := arrMatItens[intContador].fltVlrCon;
    End; //endfor

  End

  {*****************************************}
  {* NOTA DE COMPLEMENTO, GERA UMA COLUNA  *}
  {* FIXA.                                 *}
  {**************************************MV*}
  Else
  Begin
    If Not objNfeComplemento.blnTemItens Then
    Begin
      Inc(intIndiceLivroAtual);
      arrLivFis[intIndiceLivroAtual].strClaFis   := strClaFis;
      arrLivFis[intIndiceLivroAtual].fltAlqIcm   := fltIcmCom;
      arrLivFis[intIndiceLivroAtual].fltVlrCon   := fltTotGer;
      arrLivFis[intIndiceLivroAtual].fltBasIcm   := fltBasIcm;
      arrLivFis[intIndiceLivroAtual].fltValIcm   := fltTotIcm;
      arrLivFis[intIndiceLivroAtual].fltOutras   := fltTotGer - fltBasIcm - fltTotIpi - fltTotRet - fltTotFcpST;
      arrLivFis[intIndiceLivroAtual].fltIsento   := 0.0;
      arrLivFis[intIndiceLivroAtual].fltRetido   := fltTotRet;
      arrLivFis[intIndiceLivroAtual].fltBcReti   := fltBasRet;
      arrLivFis[intIndiceLivroAtual].fltBasIpi   := fltBasIpi;
      arrLivFis[intIndiceLivroAtual].fltValIpi   := fltTotIpi;
      arrLivFis[intIndiceLivroAtual].fltDAcess   := fltDesAce;
      arrLivFis[intIndiceLivroAtual].fltValIss   := fltTotSer;
      arrLivFis[intIndiceLivroAtual].fltBasFcp   := fltBasFcp;
      arrLivFis[intIndiceLivroAtual].fltAlqFCP   := fltAlqFcpST;
      arrLivFis[intIndiceLivroAtual].fltBasFcpST := fltBasFcpST;
      arrLivFis[intIndiceLivroAtual].fltValFcpST := fltTotFcpST;
      arrLivFis[intIndiceLivroAtual].fltBasIbs   := 0.0;
      arrLivFis[intIndiceLivroAtual].fltBasCbs   := 0.0;
      arrLivFis[intIndiceLivroAtual].fltBas_IS   := 0.0;
      arrLivFis[intIndiceLivroAtual].fltVlrIbs   := 0.0;
      arrLivFis[intIndiceLivroAtual].fltVlrCbs   := 0.0;
      arrLivFis[intIndiceLivroAtual].fltVlr_IS   := 0.0;
    End
    Else
    Begin
      If (Self.objNfeComplemento.tncTipoNota = tncComplementoValor) Then
      Begin
        For intItemComp := 0 To Length(Self.objNfeComplemento.arrItensNFe) -1 Do
        Begin
          itemNfeComp := Self.objNfeComplemento.arrItensNFe[intItemComp];

          If itemNfeComp.blnItemTemValor Then
          Begin
            fltVlrConTmp := itemNfeComp.fltValCom -
                            itemNfeComp.fltDesEsp +
                            itemNfeComp.fltValIpi +
                            itemNfeComp.fltValRet +
                            itemNfeComp.fltValFcpST;

            fltOutrasTmp := fltVlrConTmp -
                            itemNfeComp.fltBasIcm -
                            itemNfeComp.fltValIpi -
                            itemNfeComp.fltValRet -
                            itemNfeComp.fltValFcpST;

            If (fltOutrasTmp < 0.0) Then
              fltOutrasTmp := 0.0;

            fltIsentoTmp := 0.0;

            If fCstGravaIsento(VS_strCodEmp, itemNfeComp.strCodFis, itemNfeComp.strClaFis) Then
            Begin
              fltIsentoTmp := fltOutrasTmp;
              fltOutrasTmp := 0.0;
            End;

            itemNfeComp.fltOutIcm := fltOutrasTmp;
            itemNfeComp.fltIseIcm := fltIsentoTmp;
          End;

          Self.objNfeComplemento.arrItensNFe[intItemComp] := itemNfeComp;
        End;
      End;

      fltBasCbsTmp := 0.0;
      fltVlrCbsTmp := 0.0;
      fltBasIbsTmp := 0.0;
      fltVlrIbsTmp := 0.0;
      fltBas_ISTmp := 0.0;
      fltVlr_ISTmp := 0.0;

      For itemNfeComp In objNfeComplemento.arrItensNFe Do
      Begin
        If Not itemNfeComp.blnItemTemValor Then
          Continue;

        {*****************************************}
        {* CRIA NOVO REGISTRO NA MATRIZ.         *}
        {**************************************MV*}
        intIndiceLivro := -1;
        If TDesmembrarMatrizItens.fDesdobroImpostos(itemNfeComp.fltAlqIcm, itemNfeComp.strClaFis, intIndiceLivro, arrLivFis) Then
        Begin
          Inc(intIndiceLivroAtual);
          arrLivFis[intIndiceLivro].strClaFis   := itemNfeComp.strClaFis;
          arrLivFis[intIndiceLivro].fltAlqIcm   := itemNfeComp.fltAlqIcm;
          arrLivFis[intIndiceLivro].fltVlrCon   := itemNfeComp.fltValRet + itemNfeComp.fltValFcpST + itemNfeComp.fltValIpi + Iif(objNfeComplemento.tncTipoNota = tncComplementoValor, itemNfeComp.fltValCom, 0);
          arrLivFis[intIndiceLivro].fltBasIcm   := itemNfeComp.fltBasIcm;
          arrLivFis[intIndiceLivro].fltValIcm   := itemNfeComp.fltValIcm;
          arrLivFis[intIndiceLivro].fltOutras   := itemNfeComp.fltOutIcm;
          arrLivFis[intIndiceLivro].fltIsento   := itemNfeComp.fltIseIcm;
          arrLivFis[intIndiceLivro].fltRetido   := itemNfeComp.fltValRet;
          arrLivFis[intIndiceLivro].fltBcReti   := itemNfeComp.fltBasRet;
          arrLivFis[intIndiceLivro].fltBasIpi   := itemNfeComp.fltBasIpi;
          arrLivFis[intIndiceLivro].fltValIpi   := itemNfeComp.fltValIpi;
          arrLivFis[intIndiceLivro].fltDAcess   := 0.00;
          arrLivFis[intIndiceLivro].fltValIss   := 0.00;
          arrLivFis[intIndiceLivro].strCstPis   := itemNfeComp.strCstPis;
          arrLivFis[intIndiceLivro].fltBasPis   := itemNfeComp.fltBasPis;
          arrLivFis[intIndiceLivro].fltAlqPis   := itemNfeComp.fltAlqPis;
          arrLivFis[intIndiceLivro].fltValPis   := itemNfeComp.fltValPis;
          arrLivFis[intIndiceLivro].strCstCof   := itemNfeComp.strCstCof;
          arrLivFis[intIndiceLivro].fltBasCof   := itemNfeComp.fltBasCof;
          arrLivFis[intIndiceLivro].fltAlqCof   := itemNfeComp.fltAlqCof;
          arrLivFis[intIndiceLivro].fltValCof   := itemNfeComp.fltValCof;
          arrLivFis[intIndiceLivro].fltBasFcp   := itemNfeComp.fltBasFcp;
          arrLivFis[intIndiceLivro].fltAlqFCP   := itemNfeComp.fltAlqFcp;
          arrLivFis[intIndiceLivro].fltValFcp   := itemNfeComp.fltValFcp;
          arrLivFis[intIndiceLivro].fltBasFcpST := itemNfeComp.fltBasFcpST;
          arrLivFis[intIndiceLivro].fltValFcpST := itemNfeComp.fltValFcpST;
          arrLivFis[intIndiceLivro].fltBasIbs   := fltBasIbsTmp;
          arrLivFis[intIndiceLivro].fltBasCbs   := fltBasCbsTmp;
          arrLivFis[intIndiceLivro].fltBas_IS   := fltBas_ISTmp;
          arrLivFis[intIndiceLivro].fltVlrIbs   := fltVlrIbsTmp;
          arrLivFis[intIndiceLivro].fltVlrCbs   := fltVlrCbsTmp;
          arrLivFis[intIndiceLivro].fltVlr_IS   := fltVlr_ISTmp;
        End

        {*****************************************}
        {* ACUMULA OS VALORES.                   *}
        {**************************************MV*}
        Else
        Begin
          arrLivFis[intIndiceLivro].fltVlrCon   := arrLivFis[intIndiceLivro].fltVlrCon + itemNfeComp.fltValRet + itemNfeComp.fltValFcpST + itemNfeComp.fltValIpi + Iif(objNfeComplemento.tncTipoNota = tncComplementoValor, itemNfeComp.fltValCom, 0);
          arrLivFis[intIndiceLivro].fltBasIcm   := arrLivFis[intIndiceLivro].fltBasIcm + itemNfeComp.fltBasIcm;
          arrLivFis[intIndiceLivro].fltValIcm   := arrLivFis[intIndiceLivro].fltValIcm + itemNfeComp.fltValIcm;
          arrLivFis[intIndiceLivro].fltOutras   := arrLivFis[intIndiceLivro].fltOutras + itemNfeComp.fltOutIcm;
          arrLivFis[intIndiceLivro].fltIsento   := arrLivFis[intIndiceLivro].fltIsento + itemNfeComp.fltIseIcm;
          arrLivFis[intIndiceLivro].fltRetido   := arrLivFis[intIndiceLivro].fltRetido + itemNfeComp.fltValRet;
          arrLivFis[intIndiceLivro].fltBcReti   := arrLivFis[intIndiceLivro].fltBcReti + itemNfeComp.fltBasRet;
          arrLivFis[intIndiceLivro].fltBasIpi   := arrLivFis[intIndiceLivro].fltBasIpi + itemNfeComp.fltBasIpi;
          arrLivFis[intIndiceLivro].fltValIpi   := arrLivFis[intIndiceLivro].fltValIpi + itemNfeComp.fltValIpi;
          arrLivFis[intIndiceLivro].fltDAcess   := arrLivFis[intIndiceLivro].fltDAcess + 0.00;
          arrLivFis[intIndiceLivro].fltValIss   := arrLivFis[intIndiceLivro].fltValIss + 0.00;
          arrLivFis[intIndiceLivro].strCstPis   := itemNfeComp.strCstPis;
          arrLivFis[intIndiceLivro].fltBasPis   := arrLivFis[intIndiceLivro].fltBasPis + itemNfeComp.fltBasPis;
          arrLivFis[intIndiceLivro].fltAlqPis   := itemNfeComp.fltAlqPis;
          arrLivFis[intIndiceLivro].fltValPis   := arrLivFis[intIndiceLivro].fltValPis + itemNfeComp.fltValPis;
          arrLivFis[intIndiceLivro].strCstCof   := arrLivFis[intIndiceLivro].strCstCof + itemNfeComp.strCstCof;
          arrLivFis[intIndiceLivro].fltBasCof   := arrLivFis[intIndiceLivro].fltBasCof + itemNfeComp.fltBasCof;
          arrLivFis[intIndiceLivro].fltAlqCof   := itemNfeComp.fltAlqCof;
          arrLivFis[intIndiceLivro].fltValCof   := arrLivFis[intIndiceLivro].fltValCof + itemNfeComp.fltValCof;
          arrLivFis[intIndiceLivro].fltBasFcp   := arrLivFis[intIndiceLivro].fltBasFcp + itemNfeComp.fltValFcp;
          arrLivFis[intIndiceLivro].fltValFcp   := arrLivFis[intIndiceLivro].fltValFcp + itemNfeComp.fltValFcp;
          arrLivFis[intIndiceLivro].fltBasFcpST := arrLivFis[intIndiceLivro].fltBasFcpST + itemNfeComp.fltValFcpST;
          arrLivFis[intIndiceLivro].fltValFcpST := arrLivFis[intIndiceLivro].fltValFcpST + itemNfeComp.fltValFcpST;
          arrLivFis[intIndiceLivro].fltBasIbs   := arrLivFis[intIndiceLivro].fltBasIbs + fltBasIbsTmp;
          arrLivFis[intIndiceLivro].fltBasCbs   := arrLivFis[intIndiceLivro].fltBasCbs + fltBasCbsTmp;
          arrLivFis[intIndiceLivro].fltBas_IS   := arrLivFis[intIndiceLivro].fltBas_IS + fltBas_ISTmp;
          arrLivFis[intIndiceLivro].fltVlrIbs   := arrLivFis[intIndiceLivro].fltVlrIbs + fltVlrIbsTmp;
          arrLivFis[intIndiceLivro].fltVlrCbs   := arrLivFis[intIndiceLivro].fltVlrCbs + fltVlrCbsTmp;
          arrLivFis[intIndiceLivro].fltVlr_IS   := arrLivFis[intIndiceLivro].fltVlr_IS + fltVlr_ISTmp;
        End;

      End;

    End;

  End;

  If (fltTotSer > 0) Then
  Begin

    If (intIndiceLivroAtual >= 5) Then
    Begin
      Raise ExceptionAutCom.Create('Não foi possível gravar o bloco do serviço no livro fiscal. ' +
        'Quantidade máxima de Classificações/Alíquotas excedida.');
    End;

    {*******************************************}
    {* CALCULA TOTAL DA RETENÇÃO DO SERVIÇO    *}
    {****************************************MV*}
    fltTotRetencao := 0.0;
    If (strCliOrg = 'N') Or ((strCliOrg = 'S') And (strCalIcm = 'S')) Then
    Begin
      If (blnDtcIrf) Then
        fltTotRetencao := fltTotRetencao + fltIrSeRt;

      If (blnDtcPis) Then
        fltTotRetencao := fltTotRetencao + fltPiSeRt;

      If (blnDtcCof) Then
        fltTotRetencao := fltTotRetencao + fltCoSeRt;

      If (blnDtcCsl) Then
        fltTotRetencao := fltTotRetencao + fltCsSeRt;
    End;

    fltFatTir := fltTotRetencao / fltTotSer;

    fltVlrConTmp := fltTotSer - (fltTotSer * fltFatTir);

    Inc(intIndiceLivroAtual);
    arrLivFis[intIndiceLivroAtual].strClaFis := strClaSer;
    arrLivFis[intIndiceLivroAtual].fltAlqIcm := 0.0;
    arrLivFis[intIndiceLivroAtual].fltVlrCon := fltVlrConTmp;
    arrLivFis[intIndiceLivroAtual].fltBasIcm := 0.0;
    arrLivFis[intIndiceLivroAtual].fltValIcm := 0.0;

    If Not fNotaServicoConcretoSubProdutos Then
    Begin
      arrLivFis[intIndiceLivroAtual].fltOutras := fltVlrConTmp;
      arrLivFis[intIndiceLivroAtual].fltIsento := 0.0;
    End
    Else
    Begin
      arrLivFis[intIndiceLivroAtual].fltOutras := 0.0;
      arrLivFis[intIndiceLivroAtual].fltIsento := fltVlrConTmp;
    End;

    arrLivFis[intIndiceLivroAtual].fltRetido   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBcReti   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBasIpi   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltValIpi   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltDAcess   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltValIss   := fltValIss;
    arrLivFis[intIndiceLivroAtual].fltAlqFcp   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBasFcp   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltValFcp   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBasFcpST := 0.0;
    arrLivFis[intIndiceLivroAtual].fltValFcpST := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBasIbs   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBasCbs   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltBas_IS   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltVlrIbs   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltVlrCbs   := 0.0;
    arrLivFis[intIndiceLivroAtual].fltVlr_IS   := 0.0;

    If fltTotRetencao > 0.0 Then
    Begin
      arrLivFis[intIndiceLivroAtual].fltIrSeRt := fltIrSeRt;
      arrLivFis[intIndiceLivroAtual].fltPiSeRt := fltPiSeRt;
      arrLivFis[intIndiceLivroAtual].fltCoSeRt := fltCoSeRt;
      arrLivFis[intIndiceLivroAtual].fltCsSeRt := fltCsSeRt;
    End;

  End;
End;

function TFatVendaBase.GetTipAbf(): string;
begin
  Result := Self.GetTipAbf('', TOpcItensNFespTinta.opcVazio);
end;

function TFatVendaBase.GetTipAbf(item: TDadosFechamento): string;
begin
  Result := GetTipAbf(item.strEmpIte, item.opcINFesp);
end;

function TFatVendaBase.GetTipAbf(strEmpIte: string): string;
begin
  Result := GetTipAbf(strEmpIte, TOpcItensNFespTinta.opcVazio);
end;

procedure TFatVendaBase.pSetTipoOperacao(ATipoOperacao: string);
begin
  if Not fCfgSis('USOREV', varBoolean) then
    Exit;

  Self.strTpOper := ATipoOperacao;

  if Self.strTpOper.Equals('USO/CONSUMO') then
    Self.strCliCon := 'S'
  else if Self.strTpOper.Equals('REVENDA') then
    Self.strCliCon := 'N'
  else if Self.strTpOper.Equals('INDUSTRIALIZAÇÃO') then
    Self.strCliCon := 'N'
  else
    raise Exception.Create('Tipo de Operação inválido: ' + Self.strTpOper);

  Self.blnUtilizarTipoOperacaoNaDefinicaoAbreviacaoFiscal := True;
end;

function TFatVendaBase.GetTipAbf(strEmpIte: string; opcINFesp: TOpcItensNFespTinta): string;
begin
  //CONSIDERA QUANDO ESTÁ UTILIZANDO O SIMULADOR DE LANÇAMENTO DE ITENS DE VENDA
  If fSimuladorLancamentoItemAtivado Then
  Begin
    Result := FstrPerAbfSimulador;
    Exit;
  End;

  //CONSIDERAR O BLOCO "[CNC] Saída Contribuinte não Consumidor" DA ABREVIACAO FISCAL, QUANDO ABREVIACAO FISCAL NOVA ( ABFICM )
  If (opcINFesp in [opcBasesColorantesComDestaqueImpostos, opcColorantesTributados]) Then
  Begin
    Result := '_SAI_CNC';
    Exit;
  End;

  If Not fEmptyStr(Vs_strTpAbreDes) Then
  Begin
    Result := Vs_strTpAbreDes;
    Exit;
  End;

 {Quando for nota de importação o cliente não é definido desta forma carrega apenas o tipo abf do fornecedor}
  If (FCodCli = '') And (FCodFor <> '') Then
  Begin
    Result := fGetTipoAbreviacaoFornecedor(FCodFor);
    Exit;
  End;

  If fDocumentoParaFornecedor Then
  Begin
    Result := fGetTipoAbreviacaoFornecedor(FCodCli);
    Exit;
  End;

  Result := fGetTipoAbfCliente(Self.FCodCli,
                               IIF(fCfgSis('USOREV', VarBoolean) And blnUtilizarTipoOperacaoNaDefinicaoAbreviacaoFiscal, Self.FCliCon, ''),
                               IIF(Self.strTpOper.Equals('INDUSTRIALIZAÇÃO') And blnUtilizarTipoOperacaoNaDefinicaoAbreviacaoFiscal, 'S',''),
                               IIF(Self.FCodCli = fRetornaClienteFilial(VS_strCodEmp), Self.strEmp_TE, ''),
                               fGetEmpCalculoItem(strEmpIte));
end;

function TFatVendaBase.GetImpDir(strCodIte, strEmpIte: string): string;
begin
  If Self.blnPraticarPrecosEmpresaFaturamento Then
    Result := fRetImportacaoDiretaItem(strCodIte, fGetEmpCalculoItem(strEmpIte))
