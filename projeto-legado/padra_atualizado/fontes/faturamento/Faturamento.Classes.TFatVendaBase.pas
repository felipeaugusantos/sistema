procedure TFatVendaBase.pVinculaDocumentoAsTravasPrecoMinimo(strNumLib, strNumDoc, strEspDoc, strCodEmp: String);
var
  qryVincula: TUniQuery;
begin
  if fEmptyStr(strNumLib) then
    Exit;

  if fEmptyStr(strNumDoc) then
    Exit;

  if fEmptyStr(strEspDoc) then
    Exit;

  if fEmptyStr(strCodEmp) then
    Exit;

  qryVincula := fCriaQuery;

  try
    qryVincula.Close;
    qryVincula.SQL.Clear;
    qryVincula.SQL.Add('UPDATE TPMGER');
    qryVincula.SQL.Add('SET GER_NUMDOC = :NUMDOC, ');
    qryVincula.SQL.Add('    GER_ESPDOC = :ESPDOC, ');
    qryVincula.SQL.Add('    GER_CODEMP = :CODEMP  ');
    qryVincula.SQL.Add('WHERE GER_NUMLIB = :NUMLIB');

    qryVincula.ParamByName('NUMDOC').AsString := strNumDoc;
    qryVincula.ParamByName('ESPDOC').AsString := strEspDoc;
    qryVincula.ParamByName('CODEMP').AsString := strCodEmp;
    qryVincula.ParamByName('NUMLIB').AsString := strNumLib;

    qryVincula.ExecSQL;
  finally
    FreeAndNil(qryVincula);
  end;
end;

