  Var
    intSer: Integer;
begin
  If (Length(arrMatItens) = 0) And (strOpcDoc = 'NC') Then
  Begin
    Result := False;
    Exit;
  End;

  Result := False;

  For intSer := 1 To 30 Do
    If (GetPropValue(Self, 'strBriS' + fStrZero(intSer.ToString, 2)) = 'S') And
       (GetPropValue(Self, 'strCodS' + fStrZero(intSer.ToString, 2)) <> '') Then
