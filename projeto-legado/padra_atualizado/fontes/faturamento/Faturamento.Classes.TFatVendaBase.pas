function TFatVendaBase.fCriaCdsDesEspOri(Owner: TComponent): TUniClientDataSet;
begin
  Result := TUniClientDataSet.Create(Owner);
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'AUTOINCREM'; DataType := ftInteger;             Required := False; End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'ITE_CODITE'; DataType := ftString; Size := fTamCodIte ; Required := False; End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'ITE_DESESP'; DataType := ftFloat;               Required := False; End; //(12,02)
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'ITE_QTDITE'; DataType := ftFloat;               Required := False; End; //(12,02)
  Result.CreateDataSet;
  Result.IndexFieldNames := 'ITE_CODITE;AUTOINCREM';
  Result.LogChanges := False;
end;

