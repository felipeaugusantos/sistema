      If fEmptyStr(Result) Then
        Result := '90';
    end;

begin
  If blnTravaCalcTotGer Then
    Exit;

  LMaxEtapasProcessaItem := 3;
  LPosEtapasProcessaItem := 1;

  Try
    {*********************************}
    {* INICIA TOTALIZADORES VENDA    *}
    {******************************MV*}
    pIniciarVariaveisTotalizacaoVenda(intDecUni, blnZeraPercentuaisDesconto);

    {*********************************}
    {* CALCULA TOTAL DOS PRODUTOS    *}
    {******************************MV*}
    pCalcularPrecoUnitarioProdutosFechamentoVenda(intDecUni);

    //Seta variaveis Impostos.Fat.Parametros.Comum;
    pSetarImpostosFatParametrosComum(fGetEmpCalculoItem());

    {*********************************}
    {* CALCULA TOTAL DOS IMPOSTOS    *}
    {******************************MV*}
    LAtendeRegrasDifalDefineClaFis := fAtendeRegrasDifal(False);
    if (fCfgSis('ESPDEV', varString) = 'S')
         And ((Self.strOpcDocTrue = 'NW') And (pos(Self.strOpcDoc, 'DV_OE_') > 0))
           And Assigned(objItensNotaEspelho)
             And (Not blnConfirmacaoEspelho) then
      fltDesEsp := 0;
    For intContador := 0 To Length(arrMatItens) -1 Do
    Begin
      pBeforeCalculaTotGerItem(arrMatItens[intContador]);
      Try
        If Assigned(pgbStatusGravacao) And (Not Assigned(pOnProcessaItem)) And (Length(arrMatItens) > 1) Then
        Begin
          pInformacao(Format('Aguarde, Calculando valor do produto %s...',
            [arrMatItens[intContador].strCodIte + '-' + fPadR(arrMatItens[intContador].strDesIte, 10)]), pgbStatusGravacao);

          pProgresso(Succ(intContador), Length(arrMatItens) * LMaxEtapasProcessaItem, pgbStatusGravacao);
        End;

        {************************************************************************************************}
        {* A PRIMEIRA COISA QUE DEVE SER FEITA ANTES DE CALCULAR OS IMPOSTOS DEVE SER ZERAR OS MESMOS.  *}
        {* NA DARKA O VENDEDOR INFORMA UM CLIENTE FORA DO ESTADO, O SISTEMA CALCULA ST ETC...           *}
        {* NO FINAL O VENDEDOR ABORTA E TROCA PARA UM CLIENTE DENTRO DO ESTADO, PRESSIONA F10 NOVAMENTE,*}
        {* POREM AS VARIAVEIS FICAM COM OS VALORES ANTERIORES (OUTRO CLIENTE) E COMO NAO CALCULA ST     *}
        {* DENTRO DO ESTADO A MATRIZ FICA COM OS VALORES ERRADOS (SUJEIRA) GRAVANDO UMA NOTA FISCAL     *}
        {* DENTRO DO ESTADO COM ST. DA MESMA FORMA QUE ZERA OS TOTAIS TAMBEM DEVEMOS ZERAR A MATRIZ.    *}
        {* REQUISITO: 31939  - DARKA LOJA 017 13/03/2015                                                *}
        {*********************************************************************************************JC*}
        pZerarDadosIpiMatrizItens(false, intContador);
        pZerarDadosIcmsMatrizItens(false, intContador);
        pZerarDadosStMatrizItens(intContador);

        arrMatItens[intContador].strSit_PC := fRetornaSituacaoPisCofins(arrMatItens[intContador]);

        If fZeraIpiComoDespesaAcessoria(arrMatItens[intContador]) Then
        Begin
          arrMatItens[intContador].fltDesAce := 0;
        End;

        FImpostosFaturamento.SetarPosicaoMatriz(intContador);

        If (blnPegaClassificacaoItem) Then
          pDefineClassificacaoItem(arrMatItens[intContador], LAtendeRegrasDifalDefineClaFis);

        If fEhItemServico(arrMatItens[intContador].strCodIte) Then
          Continue;

        If (arrMatItens[intContador].strProEmb = 'S') Then
          Continue;

        pProcessMessages;

        strComLub := arrMatItens[intContador].strComLub;

        arrMatItens[intContador].fltDesEspBaiFut := fDescontoEspecialItemBaixaEntregaFutura(arrMatItens[intContador].intAutInc);

        If fEmptyStr(arrMatItens[intContador].strIteAbf) Then
          arrMatItens[intContador].strIteAbf := arrMatItens[intContador].strCodIte;

        If Not TFunctionFuncoesFaturamento.ValidarIpiSaida(strEspDoc) Then
        Begin
          strEnqIpi := Self.strEnqIPI;

          {***********************************************************************}
          {* Força utilização do cadastro de abreviação de IPI para alguns CFOPs *}
          {* Nesse cenário a CST de IPI segue as regras das abreviações de IPI   *}
          {********************************************************************BZ*}
          If Pos(arrMatItens[intContador].strClaFis, VS_strCfoIPI) > 0 Then
          Begin
            pRetornaDadosAbreviacaoIpi(arrMatItens[intContador].strIteAbf, arrMatItens[intContador].strClaFis, strCstIpi, strEnqIpi);
          End
          Else
          Begin
            Case TFunctionFuncoesFaturamento.ValidarSituacaoDoIpi(Self.strSitIPI)of
                 integer(sitTributado) : Begin
                                           pRetornaDadosAbreviacaoIpi(arrMatItens[intContador].strIteAbf, arrMatItens[intContador].strClaFis,
                                             strCstIpi, strEnqIpi);
                                         End;
                    integer(sitIsento) : strCSTIpi := '52';
              integer(sitNaoTributado) : strCSTIpi := '53';
                     integer(sitImune) : strCSTIpi := '54';
                  integer(sitSuspenso) : strCSTIpi := '55';
            End;
          End;
        End;

        pProcessMessages;

        pCalcularValorDoIpi(arrMatItens[intContador], intContador);

        If fEhNotaEspecialComplementarDeIPI(arrMatItens[intContador]) Then
        Begin
          arrMatItens[intContador].fltBasIpi := arrMatItens[intContador].fltCfbIpi;
          arrMatItens[intContador].fltAlqIpi := arrMatItens[intContador].fltCfaIpi;
          arrMatItens[intContador].fltValipi := arrMatItens[intContador].fltCfvIpi;
        End;

        If fEnviaIpiComoDespesaAcessoria(arrMatItens[intContador]) Then
        Begin
          If not blnEhFechamentoVenda Then
          Begin
            arrMatItens[intContador].fltCfbIpi := arrMatItens[intContador].fltBasIpi;
            arrMatItens[intContador].fltCfaIpi := arrMatItens[intContador].fltAlqIpi;
            arrMatItens[intContador].fltCfvIpi := arrMatItens[intContador].fltValipi;
          End;

          arrMatItens[intContador].fltBasIpi := 0;
          arrMatItens[intContador].fltAlqIpi := 0;
          arrMatItens[intContador].fltValipi := 0;
        End;

        if TFunctionsZerarImpostosRegrasImpostosFaturamento.fZerarIpiFaturamentoConsignacao(arrMatItens[intContador].strClaFis) then
          Self.fltValIpiZeradoFaturaConsignacao := Self.fltValIpiZeradoFaturaConsignacao + arrMatItens[intContador].fltIpiCon;

        if TFunctionsZerarImpostosRegrasImpostosFaturamento.fZerarSTFaturamentoConsignacao(arrMatItens[intContador].strClaFis) then
        Begin
          FImpostosFaturamento.IcmsSt.CalcularValorIcmsStFinal;
          Self.fltValSTZeradoFaturaConsignacao    := Self.fltValSTZeradoFaturaConsignacao + arrMatItens[intContador].fltValorCalculadoSTConsignacao;
        End;

        If fEmptyStr(arrMatItens[intContador].strIteAbf) Then
          arrMatItens[intContador].strIteAbf := arrMatItens[intContador].strCodIte;

        if fEmptyStr(arrMatItens[intContador].strRICMPR) then
          arrMatItens[intContador].strRICMPR := 'N';

        arrMatItens[intContador].fltIcmPrd := 0;

        If fDentroDoEstado(arrMatItens[intContador].strEmpIte) Then
        Begin

          arrMatItens[intContador].strCodMen := arrMatItens[intContador].strCodAbf;

          strRICMPR := FImpostosFaturamento.IcmsSt.ItemReducaoRICMPR(strRICMPR);

          {******************************************}
          {* ZONA FRANCA TERÁ O MESMO COMPORTAMENTO *}
          {* DO ORGÃO PÚBLICO, OU SEJA, O ICMS É    *}
          {* DADO COMO DESCONTO NA NOTA.            *}
          {************************************MV,JB*}
          If TFunctionFuncoesFaturamento.ClienteZonaFrancaOrgaoPublico(strCliOrg = 'S', strCalIcm = 'S', strZonFra = 'S', strCliCon = 'S') Then
          Begin

            fltVrdIcm := fltVrdIcm + arrMatItens[intContador].fltVrdIcm;
            fltBasVrd := fltBasVrd + arrMatItens[intContador].fltBasVrd;

          End;

          LResultadoIcmsSt := FImpostosFaturamento.IcmsSt.CalcularValorIcmsStFinal;
          PreencherVariaviesSubstituicaoTributariaSimulada(LResultadoIcmsSt);
          PreencherVariaviesIcmsOrgaoPublico(arrMatItens[intContador], LResultadoIcmsSt);

          If ((fCfgSis('CLPVDI', varString) = 'S') And (fCfgSis('ICMSEP', varString) = 'S')) Or (fCfgSis('UASCCR', varString) = 'S') Then
          Begin
            blnRedAlq := (fCfgSis('IMPCF4', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = 'S') And (fCfgSis('RAICF4', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = 'S');
            pRetornaAliquotaItem(arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEmpIte, fltIcmPrd, strCodSit, blnRedAlq);
            arrMatItens[intContador].fltIcmPrd := fltIcmPrd;
          End;

          arrMatItens[intContador].fltValRei := fCalcularBeneficioREIDI(arrMatItens[intContador], fCalcularPisCoFinsDoBeneficioREIDI(arrMatItens[intContador]));

          PreencherVariaviesBeneficioREIDI(arrMatItens[intContador].fltValRei);
          pAcumulaSTCustoAquisicao(arrMatItens[intContador], LResultadoIcmsSt);

          If (strBenRei = 'S') Then
          Begin
            fltAlPisP := TFunctionFuncoesFaturamento.ProdutoAliquotaPis;
            fltAlCofP := TFunctionFuncoesFaturamento.ProdutoAliquotaCofins;
          End;

          arrMatItens[intContador].fltBasIpr := 0;

          If arrMatItens[intContador].strRICMPR = 'S' Then
          Begin
            arrMatItens[intContador].fltBasIpr := arrMatItens[intContador].fltBasIcm;
            arrMatItens[intContador].fltPerRic := fRetornaPercentualDiferimento(arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEmpIte);

            fltTotDif := fltTotDif + arrMatItens[intContador].fltValDif;
            fltTotIpr := fltTotIpr + fTotalGeralItem(intContador);
          End;

          {***************************************}
          {* AMPARA RS - OPERAÇÃO INTERNA SEM ST *}
          {***************************************}
          If (Self.fUtilizaAmpara(arrMatItens[intContador].strCodIte)) And (arrMatItens[intContador].fltValRet = 0) Then
          Begin
            If fBuscaAbfIcm(arrMatItens[intContador].strIteAbf,
                            arrMatItens[intContador].strEmpIte,
                            arrMatItens[intContador].strCodAbf,
                            IIF(fEmptyStr(strEstEnt),
                                          strCliEst,
                                          strEstEnt)) Then
              fltAmpara_AliquotaFCP := cdsAbfIcm.FieldByName('ABF_ALQFCP' + GetTipAbf(arrMatItens[intContador])).AsFloat
            Else
              fltAmpara_AliquotaFCP := 0;

            arrMatItens[intContador].recDifalFCP.fltPerFcp := fltAmpara_AliquotaFCP;
            arrMatItens[intContador].recDifalFCP.fltValFcp := fFormataFloat(arrMatItens[intContador].fltBasIcm * fltAmpara_AliquotaFCP / 100, 2);
          End;

          If fEnviaCreditoPresumido(arrMatItens[intContador]) Then
            pCalculaCreditoPresumido(arrMatItens[intContador], GetTipAbf(arrMatItens[intContador]), fTotalGeralItem(intContador));

        End
        // (FORA DO ESTADO)
        Else
        Begin

          arrMatItens[intContador].strCodMen := arrMatItens[intContador].strCodAbf;

          LResultadoIcmsSt := FImpostosFaturamento.IcmsSt.CalcularValorIcmsStFinal;
          PreencherVariaviesIcmsOrgaoPublico(arrMatItens[intContador], LResultadoIcmsSt);
          PreencherVariaviesBeneficioREIDI(fCalcularBeneficioREIDI(arrMatItens[intContador], fCalcularPisCoFinsDoBeneficioREIDI(arrMatItens[intContador])));
          pCalcularDescontoEspecialParaClienteZonaFranca(arrMatItens[intContador]);
          pCalcularDescontoEspecialParaClienteZonaFrancaSimplesNacionalComIcmsDesonerado(arrMatItens[intContador]);

          If ((fCfgSis('CLPVDI', varString) = 'S') And (fCfgSis('ICMSEP', varString) = 'S')) Or (fCfgSis('UASCCR', varString) = 'S') Then
          Begin
            blnRedAlq := (fCfgSis('IMPCF4', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = 'S') And (fCfgSis('RAICF4', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = 'S');
            pRetornaAliquotaItem(arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEmpIte, fltIcmPrd, strCodSit, blnRedAlq);
            arrMatItens[intContador].fltIcmPrd := fltIcmPrd;
          End;

          If (strBenRei = 'S') Then
          Begin
            fltAlPisP := TFunctionFuncoesFaturamento.ProdutoAliquotaPis;
            fltAlCofP := TFunctionFuncoesFaturamento.ProdutoAliquotaCofins;
          End;

          fltVrdIcm := fltVrdIcm + arrMatItens[intContador].fltVrdIcm;
          fltBasVrd := fltBasVrd + arrMatItens[intContador].fltBasVrd;

          If fCalculaDescontoIcmsOrgaoPublicoForaDoEstado Then
          Begin
            arrMatItens[intContador].fltAlqIcm := 0.0;
            arrMatItens[intContador].fltBasIcm := 0.0;
            arrMatItens[intContador].fltValIcm := 0.0;
          End ;

        End;

        pCalculaSubstituicaoTributariaUsandoPrecoPautaFiscal(arrMatItens[intContador]);

        If fEhNotaEspecialComplementarDeIPI(arrMatItens[intContador]) Then
        Begin
          pZerarDadosIcmsMatrizItens(false, intContador);
        End;

        FEntraIPInaBaseIcms := LResultadoIcmsSt.EntraIPInaBaseIcms;

        {************************************}
        {* SOMA TOTAIS DE TRIB. E SUBST.    *}
        {*********************************MV*}
        If (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0) Then
          FTotProSubst := FTotProSubst + arrMatItens[intContador].fltTotIte
        Else If arrMatItens[intContador].strCodFis = '000' Then
          FTotProTrib := FTotProTrib  + arrMatItens[intContador].fltTotIte;

        If arrMatItens[intContador].fltPerRed > 0 Then
          FTotProRedIcm := FTotProRedIcm  + arrMatItens[intContador].fltTotIte;

        pProcessMessages;

        If (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) <= 0) Then
        Begin
          strComLub := 'T';
        End;

        {*****************************************}
        {* SE FOR CONFIRMAÇÃO DE CUPOM EM NOTA   *}
        {* E FOR UM PRODUTO TRIBUTADO ENTAO O    *}
        {* CODIGO FISCAL DEVE FICAR _90 (OUTRAS) *}
        {*************************************JC**}
        If (((strOpcDoc = 'CI') And (fCfgSis('ZERCIF', varString) = 'S'))
          And ((Pos(arrMatItens[intContador].strCodFis, CST_TRIBUTADO) > 0)
            OR (fCfgSis('PRACST', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = 'S' ))) Then
        Begin
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
        End;

        If (strZonFra = 'S') And
           (Not fEhCstTributacaoZonaFranca(arrMatItens[intContador])) And
           (Not fEhClienteZonaFrancaSimplesNacionalComIcmsDesonerado(arrMatItens[intContador])) And
           (Not fTributaClienteZonaFrancaUsoConsumo) Or
           (fZerarValoresICMSImportadoComSimilar(arrMatItens[intContador]))  Then
        Begin
          If (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0) Then
            arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '30'
          Else
            arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '40';
        End;

        {*******************************************}
        {* SE FOR CFOP X915 TRAZER CST 041 PARA OS *}
        {* PRODUTOS DA NOTA                        *}
        {****************************************IV*}
        If TFunctionsRegrasImpostosFaturamento.fClassificacaoEnvioOuRetornoMercadoriaConsertoGarantia(strClaFis) Then
        Begin
          arrMatItens[intContador].strCodFis := '041';
        End;

        If Self.blnCliExportacaoIndireta And (Pos(RightStr(arrMatItens[intContador].strClaFis, 3), '501_502_') > 0) Then
        Begin
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '41';

          arrMatItens[intContador].fltAlqIcm := 0.0;
          arrMatItens[intContador].fltBasIcm := 0.0;
          arrMatItens[intContador].fltValIcm := 0.0;

          arrMatItens[intContador].fltBasRet := 0.0;
          arrMatItens[intContador].fltValRet := 0.0;
        End;

        If TFunctionsRegrasImpostosFaturamento.fEhEntregaFuturaNaoControleDeEntrega(blnBaiEntFut, arrMatItens[intContador].strEntFut = 'S') Then
        Begin
          If (fCfgSis('VNENFU', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = '1') Then
          Begin
            If (Pos(arrMatItens[intContador].strCodFis, CST_TRIBUTADO) > 0) Then
              arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + fRetornaCstDaEntregaFutura;
          End
          Else
          Begin
            arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + fRetornaCstDaEntregaFutura;
          End;
        End;

        If TFunctionsRegrasImpostosFaturamento.
          fAlterarTributacaoIcmsPara41eZerarValores(fGetUFEmpresa(arrMatItens[intContador].strEmpIte), fEmpresaOptanteSimples,
            strOpcDoc, Self.strEspDoc, fItemTributado(arrMatItens[intContador]), fConfiguradoParaTrocarParaX41, fConfiguradoParaTrocarParaX41noParana(arrMatItens[intContador].strEmpIte)) Then
        Begin
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + IIF(fOrgaoPublicoOuZonaFranca, '40', '41');
        End;

        If fEhClienteZonaFrancaSimplesNacionalComIcmsDesonerado(arrMatItens[intContador]) Then
        Begin
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
        End;

        If fZerarValoresICMSImportadoComSimilar(arrMatItens[intContador]) Then
        Begin
          arrMatItens[intContador].fltAlqIcm := 0.0;
          arrMatItens[intContador].fltBasIcm := 0.0;
          arrMatItens[intContador].fltValIcm := 0.0;
        End;

        {*****************************************}
        {* QUANDO FOR NOTA DE IMPORTAÇÃO, CARRE- *}
        {* GA OS DADOS DIGITADOS.                *}
        {**************************************MV*}
        If (strNotImp = 'S') Then
        Begin
          arrMatItens[intContador].fltAlqIcm := arrMatItens[intContador].fltAlqIcmImp;
          arrMatItens[intContador].fltBasIcm := arrMatItens[intContador].fltBasIcmImp;
          arrMatItens[intContador].fltValIcm := arrMatItens[intContador].fltValIcmImp;

          arrMatItens[intContador].fltAlqIpi := arrMatItens[intContador].fltAlqIpiImp;
          arrMatItens[intContador].fltBasIpi := arrMatItens[intContador].fltBasIpiImp;
          arrMatItens[intContador].fltValIpi := arrMatItens[intContador].fltValIpiImp;

          arrMatItens[intContador].fltBasRet := arrMatItens[intContador].fltBasRetImp;
          arrMatItens[intContador].fltValRet := arrMatItens[intContador].fltValRetImp;
        End;

        {*************************************************************************************************************}
        {*  [  ] AUTCOM - COLOMARTI - RONALDO                                                                        *}
        {*     - DEVOLUCAO DE MERCADORIAS                                                                            *}
        {*       - A NOTA DE DEVOLUCAO EMITIDA PARA FORNECEDOR DEVE SEGUIR A MESMA TRIBUTACAO DA NOTA DE ENTRADA,    *}
        {*         CALCULANDO PROPROCIONALMENTE AOS ITENS DEVOLVIDOS.                                                *}
        {*       - NAO DEVE SER UTILIZADO O CALCULO DAS ABREVIACOES FISCAIS                                          *}
        {*       - TEMOS QUE ENQUADRAR NESTA SITUACAO:                                                               *}
        {*         * CST ( ICMS, IPI, PIS e COFINS )                                                                 *}
        {*         * BASE DE ICMS                                                                                    *}
        {*         * VALOR DE ICMS                                                                                   *}
        {*         * BASE DE IPI                                                                                     *}
        {*         * VALOR DE IPI                                                                                    *}
        {*         * BASE DE ST                                                                                      *}
        {*         * VALOR DE ST                                                                                     *}
        {*                                                                                                           *}
        {*       - O OBJETIVO DESTA ALTERACAO E´ DEIXAR A NOTA DE DEVOLUCAO FIEL A NOTA DE ENTRADA.                  *}
        {*************************************************************************************************************}
        blnUsaEsp := False;
        If fEhDevolucaoEspelhoOuParaFornecedor Then
        Begin
          blnUsaEsp := True;
          objItensNotaEspelho.strTabDev := arrMatItens[intContador].strTabDev;
        End;

        If Assigned(objItensNotaEspelho) Then
        Begin
          strIncEsp := arrMatItens[intContador].strIncDev;
          If (objItensNotaEspelho.strOpcDoc = 'FD') And (Not fEmptyStr(arrMatItens[intContador].strIncEsp)) Then
          Begin
            blnUsaEsp := True;
            strIncEsp := arrMatItens[intContador].strIncEsp;
            objItensNotaEspelho.strTabDev := 'MOVDET';
          End;

          objItensNotaEspelho.blnEmissaoNotaGarantiaEnvFornecedorConfirmacaoEspelho := ((Self.strOpcDoc = 'GF') And (blnConfirmacaoEspelho));
          If (Pos(Self.strOpcDoc, 'OF_GF_') > 0) And  (fCfgSis('ICMOPP', varString) = 'S') Then
            objItensNotaEspelho.blnUtilizarIcmsDoXmlDeEntrada := (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0);
        End;

        blnEspelhouFcpFcpSTDev := False;

        If (blnUsaEsp) And
           (Assigned(objItensNotaEspelho[strIncEsp])) and
           (Not blnConfirmacaoEspelho)
        Then
        Begin
          if (Self.strOpcDoc = 'GF') Or ((Self.strOpcDocTrue = 'NW') and (pos(Self.strOpcDoc, 'DV_OE_') > 0)) then
            arrMatItens[intContador].strCodFis := objItensNotaEspelho[arrMatItens[intContador].strIncDev].itemCalc.strCodFis;

          if (Not (((Self.strOpcDoc = 'GF') OR
               ((pos(Self.strOpcDoc, 'DV_OE_')>0) and  (Self.strOpcDocTrue = 'NW'))) and blnBloquearRestaurarValoresEspeplhoGF)) Or
                ((Self.strOpcDoc <> 'GF') and  (Self.strOpcDocTrue <> 'NW'))  then
          begin
            if fEhGarantiaEnvioFornecedorEAlterouValores then
            begin
              If TItensNotaEspelhoEnvioFornecedor(objItensNotaEspelho).fItemPrecoAlterado(strIncEsp) then
              begin
                TItensNotaEspelhoEnvioFornecedor(objItensNotaEspelho)
                  .GetItemCalc(strIncEsp)
                    .pAlterarValorItem(arrMatItens[intContador].fltTotIte, arrMatItens[intContador].fltQtdIte);
                objItensNotaEspelho[strIncEsp].itemCalc.fltDesEsp := arrMatItens[intContador].fltDesEsp;
              end;
            end ;

            ObjItensNotaEspelho[strIncEsp].pCalculaImpostosProporcional(arrMatItens[intContador].fltQtdIte);

            With ObjItensNotaEspelho[strIncEsp] Do
            Begin
              arrMatItens[intContador].strIdDest := itemCalc.strIdDest;
              arrMatItens[intContador].fltTotIte := itemCalc.fltTotIte;
              arrMatItens[intContador].fltDesEsp := itemCalc.fltDesEsp;
              if (Self.strOpcDocTrue = 'NW') And (pos(Self.strOpcDoc, 'DV_OE_') > 0) then
              begin
                fltDesEsp := fltDesEsp + arrMatItens[intContador].fltDesEsp;
              end;
              arrMatItens[intContador].fltVrdIcm := itemCalc.fltVrdIcm;
              arrMatItens[intContador].strMtdIcm := itemCalc.strMtdIcm;
              arrMatItens[intContador].strCodFis := itemCalc.strCodFis;

              If (Self.strBenRei = 'S') Then
                PreencherVariaviesBeneficioREIDI(itemCalc.fltDesEsp);

              If (objItensNotaEspelho.blnUtilizarIcmsDoXmlDeEntrada) Or
                 ((not blnEspelhoDevolucaoClienteFatDadosFiscais) And
                  (not fEhDevolucaoDeCupomEletronicoSAT(arrMatItens[intContador]))  And
                  (Not fEhOutrasSaidasDeFornecedorSimplesNacionalComFornecedorRegimeNormal) And
                 (not fEhDevolucaoDeFornecedorComDiferimentoSimplesNacional(arrMatItens[intContador]))) Then
              Begin
                arrMatItens[intContador].fltAlqIcm := itemCalc.fltAlqIcm;
                arrMatItens[intContador].fltBasIcm := itemCalc.fltBasIcm;
                arrMatItens[intContador].fltValIcm := itemCalc.fltValIcm;
                If (itemCalc.blnCarregouDadosDoXml) Then
                Begin
                  arrMatItens[intContador].fltPerRed := itemCalc.fltPerRed;
                  If (fFormataFloat(arrMatItens[intContador].fltPerRed, 2) = 0) And
                     (RightStr(arrMatItens[intContador].strCodFis, 2) = '51') And
                     (Self.strOpcDoc = 'OF') Then
                  Begin
                    arrMatItens[intContador].fltPerDif := itemCalc.fltPerDif;
                    arrMatItens[intContador].fltPerRed := itemCalc.fltPerDif;
                  End;
                End;
              End;

              arrMatItens[intContador].fltAlqIpi := itemCalc.fltAlqIpi;
              arrMatItens[intContador].fltBasIpi := itemCalc.fltBasIpi;
              arrMatItens[intContador].fltValIpi := itemCalc.fltValIpi;

              arrMatItens[intContador].fltBasRet := itemCalc.fltBasRet;
              arrMatItens[intContador].fltAlqRet := itemCalc.fltAlqRet;
              arrMatItens[intContador].fltValRet := itemCalc.fltValRet;
              arrMatItens[intContador].fltPeBaST := itemCalc.fltPeBaST;
              arrMatItens[intContador].fltValIva := itemCalc.fltValIva;

                If fZerarValFreDV Then
                Begin
                  arrMatItens[intContador].fltValFre := 0.00
                End
                Else
                Begin
                  If (fApurouValFreDesAceDevolucaoEspelho) Then
                  Begin
                    If (Self.fltValFreDevEspApurado = Self.fltValFre) Then
                      arrMatItens[intContador].fltValFre := itemCalc.fltValFre;
                  End
                  Else
                  Begin
                    arrMatItens[intContador].fltValFre := itemCalc.fltValFre
                  End;
                End;

              arrMatItens[intContador].fltFreSug := itemCalc.fltFreSug;
              arrMatItens[intContador].fltFreCot := itemCalc.fltFreCot;

              If (fCfgSis('ALDAVF', VarBoolean, GetEmpCfg(arrMatItens[intContador].strEmpIte))) Then
                itemCalc.fltDesAce := arrMatItens[intContador].fltDesAce;

              If (fApurouValFreDesAceDevolucaoEspelho) Then
              Begin
                If (Self.fltDesAceDevEspApurado = Self.fltDesAce) Then
                  arrMatItens[intContador].fltDesAce := itemCalc.fltDesAce;
              End
              Else
              Begin
                arrMatItens[intContador].fltDesAce := itemCalc.fltDesAce;
              End;

              arrMatItens[intContador].fltDesOpe := itemCalc.fltDesOpe;
              arrMatItens[intContador].fltImpFed := itemCalc.fltImpFed;
              arrMatItens[intContador].fltIcmSai := itemCalc.fltIcmSai;
              arrMatItens[intContador].fltOutVal := itemCalc.fltOutVal;

              arrMatItens[intContador].recDifalFCP.fltPerFcp := itemCalc.fltPerFcp;

              FillChar(arrMatItens[intContador].EspelhoFcpIcms  , SizeOf(arrMatItens[intContador].EspelhoFcpIcms)  , #0);
              FillChar(arrMatItens[intContador].EspelhoFcpIcmsST, SizeOf(arrMatItens[intContador].EspelhoFcpIcmsST), #0);

              If (objItensNotaEspelho.strOpcDoc = 'FD') then
              Begin
                arrMatItens[intContador].fltUniTar := itemCalc.fltUnitar;
                arrMatItens[intContador].fltUniDig := itemCalc.fltUniDig;
                arrMatItens[intContador].fltUniOri := itemCalc.fltUniOri;
                arrMatItens[intContador].fltUniVis := itemCalc.fltUniVis;
                arrMatItens[intContador].fltOutIcm := itemCalc.fltOutIcm;
                arrMatItens[intContador].fltIseIcm := itemCalc.fltIseIcm;
                arrMatItens[intContador].fltTotMed := itemCalc.fltTotMed;
                arrMatItens[intContador].fltPreMed := fFormataFloat(arrMatItens[intContador].fltTotMed / arrMatItens[intContador].fltQtdIte, 2);
                arrMatItens[intContador].fltAlERet := itemCalc.fltAlqRet;

                If (itemCalc.fltImpPag > 0) Then
                Begin
                  fltTotIteAux := arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp;
                  If (fltTotIteAux <> 0.00) Then
                  Begin
                    If (fFormataFloat(itemCalc.fltFedImp + itemCalc.fltEstImp + itemCalc.fltMunImp, 2) = 0.00) Then
                      arrMatItens[intContador].fltPeImPg := ((itemCalc.fltImpPag / fltTotIteAux) * 100)
                    Else
                    Begin
                      arrMatItens[intContador].fltPeImFd := ((itemCalc.fltFedImp / fltTotIteAux) * 100);
                      arrMatItens[intContador].fltPeImEs := ((itemCalc.fltEstImp / fltTotIteAux) * 100);
                      arrMatItens[intContador].fltPeImMn := ((itemCalc.fltMunImp / fltTotIteAux) * 100);
                    End;
                  End;
                End;
              End;

              If (fEhGarantiaFornecedorComDocumentoVinculado) Or
                 (fEhOutrasEntradasFornecedorComDocumentoVinculado) Then
              Begin
                arrMatItens[intContador].EspelhoFcpIcms.fltAliquota := itemCalc.fltPerFcp;
                arrMatItens[intContador].EspelhoFcpIcms.fltBase     := itemCalc.fltBasFcp;
                arrMatItens[intContador].EspelhoFcpIcms.fltValor    := itemCalc.fltValFcp;

                arrMatItens[intContador].EspelhoFcpIcmsST.fltAliquota := itemCalc.fltPerFcpST;
                arrMatItens[intContador].EspelhoFcpIcmsST.fltBase     := itemCalc.fltBasFcpST;
                arrMatItens[intContador].EspelhoFcpIcmsST.fltValor    := itemCalc.fltValFcpST;

                arrMatItens[intContador].recDifalFCP.fltPerFcp := itemCalc.fltPerFcpST;
                arrMatItens[intContador].recDifalFCP.fltBasFcp := itemCalc.fltBasFcpST;
                arrMatItens[intContador].recDifalFCP.fltValFcp := itemCalc.fltValFcpST;
              End
              Else If fEhDevolucaoParaFornecedorQueAbasteceEmpresaPorTransferenciaDeEstoque(arrMatItens[intContador].strClaFis) Then
              Begin
                arrMatItens[intContador].strCodFis := itemCalc.strDvfCodFis;

                arrMatItens[intContador].fltAlqIcm := itemCalc.fltDvfAlqIcm;
                arrMatItens[intContador].fltBasIcm := itemCalc.fltDvfBasIcm;
                arrMatItens[intContador].fltValIcm := itemCalc.fltDvfValIcm;

                arrMatItens[intContador].EspelhoFcpIcms.fltAliquota := itemCalc.fltDvfPerFcp;
                arrMatItens[intContador].EspelhoFcpIcms.fltBase     := itemCalc.fltDvfBasFcp;
                arrMatItens[intContador].EspelhoFcpIcms.fltValor    := itemCalc.fltDvfValFcp;

                arrMatItens[intContador].EspelhoFcpIcmsST.fltAliquota := itemCalc.fltDvfPfcpST;
                arrMatItens[intContador].EspelhoFcpIcmsST.fltBase     := itemCalc.fltDvfBfcpST;
                arrMatItens[intContador].EspelhoFcpIcmsST.fltValor    := itemCalc.fltDvfVfcpST;

                arrMatItens[intContador].recDifalFCP.fltPerFcp := itemCalc.fltDvfPfcpST;
                arrMatItens[intContador].recDifalFCP.fltBasFcp := itemCalc.fltDvfBfcpST;
                arrMatItens[intContador].recDifalFCP.fltValFcp := itemCalc.fltDvfVfcpST;

                If (itemCalc.blnDevFilPD) Then
                Begin
                  arrMatItens[intContador].fltBasRet := itemCalc.fltDvfBST;
                  arrMatItens[intContador].fltValRet := itemCalc.fltDvfVST;
                  arrMatItens[intContador].fltAlqRet := itemCalc.fltDvfPST;
                End;
              End
              Else
              Begin
                // FCP
                arrMatItens[intContador].VisualizarFcpIcms.fltBase     := itemCalc.fltBasFcp;
                arrMatItens[intContador].VisualizarFcpIcms.fltAliquota := itemCalc.fltPerFcp;
                arrMatItens[intContador].VisualizarFcpIcms.fltValor    := itemCalc.fltValFcp;

                arrMatItens[intContador].EspelhoFcpIcms.fltBase     := itemCalc.fltBasFcp;
                arrMatItens[intContador].EspelhoFcpIcms.fltAliquota := itemCalc.fltPerFcp;
                arrMatItens[intContador].EspelhoFcpIcms.fltValor    := itemCalc.fltValFcp;

                // FCP ST
                arrMatItens[intContador].VisualizarFcpIcmsST.fltBase     := itemCalc.fltBasFcpST;
                arrMatItens[intContador].VisualizarFcpIcmsST.fltAliquota := itemCalc.fltPerFcpST;
                arrMatItens[intContador].VisualizarFcpIcmsST.fltValor    := itemCalc.fltValFcpST;

                arrMatItens[intContador].EspelhoFcpIcmsST.fltBase     := itemCalc.fltBasFcpST;
                arrMatItens[intContador].EspelhoFcpIcmsST.fltAliquota := itemCalc.fltPerFcpST;
                arrMatItens[intContador].EspelhoFcpIcmsST.fltValor    := itemCalc.fltValFcpST;

                arrMatItens[intContador].recDifalFCP.fltBasFcp := itemCalc.fltBasFcpST;
                arrMatItens[intContador].recDifalFCP.fltPerFcp := itemCalc.fltPerFcpST;
                arrMatItens[intContador].recDifalFCP.fltValFcp := itemCalc.fltValFcpST;

                blnEspelhouFcpFcpSTDev := True;
              End;
            End;

            If fEhDevolucaoDeFornecedorComDiferimento(arrMatItens[intContador]) And fUsaPercentualDiferimento Then
            Begin
              arrMatItens[intContador].strRICMPR := 'S' ;
              arrMatItens[intContador].fltBasIpr := arrMatItens[intContador].fltBasIcm;

              If (arrMatItens[intContador].fltPerDif > 0) Then
              Begin
                arrMatItens[intContador].fltValDif := fIcmsDiferido(arrMatItens[intContador]);
                arrMatItens[intContador].fltPerBas := 100 - arrMatItens[intContador].fltPerDif;
                arrMatItens[intContador].fltPeBaST := 100 - arrMatItens[intContador].fltPerDif;
              End
              Else
              Begin
                fltPercentualDaBaseDeIcms := 100 -  fRetornaPercentualDiferimento(arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEmpIte);

                arrMatItens[intContador].fltPerBas := fltPercentualDaBaseDeIcms;
                arrMatItens[intContador].fltPeBaST := fltPercentualDaBaseDeIcms;

                arrMatItens[intContador].fltValDif := fArredondaValorIcms((arrMatItens[intContador].fltBasIcm * arrMatItens[intContador].fltAlqIcm) / 100,2);
                arrMatItens[intContador].fltValDif := fArredondaValorIcms(arrMatItens[intContador].fltValDif * (fltPercentualDaBaseDeIcms / 100), 2);
              End;

              fltTotDif := fltTotDif + arrMatItens[intContador].fltValDif;
              fltTotIpr := fltTotIpr + fTotalGeralItem(intContador);
            End;
          end;
        End;

        If fEhDevolucaoEspelhoPorAD Then
        Begin
          arrMatItens[intContador].fltValFre := arrMatItens[intContador].fltFreDev;
          arrMatItens[intContador].fltDesAce := arrMatItens[intContador].fltDeADev;
        End;

        If blnUsaEsp Then
          objItensNotaEspelho.strTabDev := '';

        if (strOpcDoc = 'CR') AND (VS_strSimPau = 'N') then
        Begin
          LobjConsignacaoBuilder := TRetornoConsignacaoBuilder.Create;
          try
            LobjConsignacaoBuilder.MatrizItens      := arrMatItens;
            LobjConsignacaoBuilder.DicionarioObjeto := dicDocs;
            LobjConsignacaoBuilder.pCalcularImpostosProporcionalPelaNotaEnvio(intContador);
          Finally
            FreeAndNil(LobjConsignacaoBuilder);
          End;
        End;

        //Caso o valor do icms seja menor ou igual à zero deve zerar Base, aliquota e valor
        If TFunctionsRegrasImpostosFaturamento.fValorDoIcmsMenorIgualAZero(arrMatItens[intContador].fltValIcm) Then
        Begin
          If (fItemTributado(arrMatItens[intContador])) then
          Begin
            if (((Not fEmpresaOptanteSimples) Or (fEmpresaOptanteSimples And fConfiguradoParaTrocarParaX41)) Or (fOrgaoPublicoOuZonaFranca)) Then
            Begin
              arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + IIF(fOrgaoPublicoOuZonaFranca, '40', '41');
            End;

            if TFunctionsZerarImpostosRegrasImpostosFaturamento.fZerarSTFaturamentoConsignacao(arrMatItens[intContador].strClaFis) then
              arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
          End;
        End;

        {*******************************************}
        {* CASO O CST SEJA X60 E POSSUA IPI OU ST  *}
        {* ALTERA O MESMO PARA X10, EX: 060 -> 010 *}
        {***************************************JC**}
        {* IPI MANTERÁ X60 REQ.:71156***********VA**}
        With arrMatItens[intContador] Do
          If (RightStr(strCodFis, 2) = '60') And ((fltValRet + fltValIcm) > 0) Then
            strCodFis := LeftStr(strCodFis, 1) + '10';

        {************************************************}
        {* QUANDO FOR NOTA DE ATIVO IMOBILIZADO, CARRE- *}
        {* GA OS DADOS DIGITADOS.                       *}
        {*********************************************JC*}
        If (strOpcDoc = 'NP') And Assigned(objIcmsItemImob) Then
        Begin
          objIcmsItemImob.intAutInc := arrMatItens[intContador].intAutInc;
          If objIcmsItemImob.blnInfVal Then
          Begin
            arrMatItens[intContador].fltAlqIcm := objIcmsItemImob.fltAlqIcm;
            arrMatItens[intContador].fltBasIcm := objIcmsItemImob.fltBasIcm;
            arrMatItens[intContador].fltValIcm := objIcmsItemImob.fltValIcm;
          End;
        End;

        if (strTipOpe = 'A') then
        begin
          if RightStr(arrMatItens[intContador].strCodFis, 2) = '00' then
          begin
            arrMatItens[intContador].fltValIcm := 0.00;
            arrMatItens[intContador].fltAlqIcm := 0.00;
            arrMatItens[intContador].fltBasIcm := 0.00;
            arrMatItens[intContador].fltValPis := 0.00;
            arrMatItens[intContador].fltValCof := 0.00;

            If Not fEmptyStr(fCfgSis('CSTAMO', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte))) Then
              arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + fCfgSis('CSTAMO', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte))
            Else
              arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '41';
          end
          else if RightStr(arrMatItens[intContador].strCodFis, 2) = '60' then
          begin
            arrMatItens[intContador].fltValIcm := 0.00;
            arrMatItens[intContador].fltValPis := 0.00;
            arrMatItens[intContador].fltValCof := 0.00;
          end;
        end;

        {Demonstração}
        if (strTipOpe = 'D') then
        begin

          If Not fEmptyStr(fCfgSis('DEMCLA', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte))) Then
            arrMatItens[intContador].strClaFis := Copy(arrMatItens[intContador].strClaFis,1,1) + Trim(fCfgSis('DEMCLA', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)))
          Else
            arrMatItens[intContador].strClaFis := Copy(arrMatItens[intContador].strClaFis,1,1) + Copy(Trim(fCfgSis('CLADEM', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte))), 1, 3);

          if (RightStr(arrMatItens[intContador].strCodFis, 2) = '00') Or
             (RightStr(arrMatItens[intContador].strCodFis, 2) = '10') Or
             (RightStr(arrMatItens[intContador].strCodFis, 2) = '60') then
          begin

            arrMatItens[intContador].fltValIcm := 0.00;
            arrMatItens[intContador].fltAlqIcm := 0.00;
            arrMatItens[intContador].fltBasIcm := 0.00;

            arrMatItens[intContador].fltValRet := 0.00;
            arrMatItens[intContador].fltAlqRet := 0.00;
            arrMatItens[intContador].fltBasRet := 0.00;

            if (RightStr(arrMatItens[intContador].strCodFis, 2) = '00') Then
              arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '40';

            If (fCfgSis('CSTDEM', varString, GetEmpCfg(arrMatItens[intContador].strEmpIte)) = '2') Then
              arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '50';

          end;

        end;

        If (blnCliFil) And fEhExpedicaoOuPDNota And (Not Self.DigImp.blnOperadorDigitouImpostos) Then
          If (Self.fZerarIcmsNotaTransferenciaEstadosEspecificos(arrMatItens[intContador].strClaFis)) Then
            Self.pZerarIcmsNotaTransferenciaEstadosEspecificos(intContador);

        If fZeraIcmsDaNotaFiscalParaAjusteDeEstoque(arrMatItens[intContador].strClaFis) Then
        Begin
          arrMatItens[intContador].fltValIcm := 0.00;
          arrMatItens[intContador].fltAlqIcm := 0.00;
          arrMatItens[intContador].fltBasIcm := 0.00;
          arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '41';
        End;

        If fZerarImpostosDaRemessaDeEstoqueExterno Then
        Begin
          pZerarDadosIcmsMatrizItens(false, intContador);
          pZerarDadosIpiMatrizItens(false, intContador);
          pZerarDadosStMatrizItens(intContador);
          arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '41';
        End;

        If fEhOutrasEntradasEmpresaLogadaSimplesNacional Then
        Begin
          pZerarDadosIcmsMatrizItens(false, intContador);
          pZerarDadosIpiMatrizItens(false, intContador);
          pZerarDadosStMatrizItens(intContador);
          arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '41';
        End;

        If fEhBonificacaoIncondicional(arrMatItens[intContador].strClaFis) Then
        Begin
          pZerarDadosIcmsMatrizItens(false, intContador);
          pZerarDadosStMatrizItens(intContador);
          arrMatItens[intContador].strCodFis := Copy(arrMatItens[intContador].strCodFis,1,1) + '90';
        End;

        If fEhClassificacaoFiscalParaRemessaDeIndustrializacao(arrMatItens[intContador].strClaFis) Then
        Begin
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '50';
        End;

        If fEhClassificacaoFiscalParaBaixaDeEstoqueDecorrenteDePerdaRouboOuDeterioracao(arrMatItens[intContador].strClaFis) Then
        Begin
          pZerarDadosIcmsMatrizItens(false, intContador);
          pZerarDadosIpiMatrizItens(false, intContador);
          pZerarDadosStMatrizItens(intContador);

          If fCfgSis('CFX927') = '2' Then
          Begin
            If Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0 Then
              arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '60'
            Else
              arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '41';
          End
          Else
          Begin
            arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
          End;
        End;

        If fNotaEspecialCST_X90(arrMatItens[intContador].strClaFis) Then
        Begin
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
        End;

        {******************************************}
        {* ZONA FRANCA TERÁ O MESMO COMPORTAMENTO *}
        {* DO ORGÃO PÚBLICO, OU SEJA, O ICMS É    *}
        {* DADO COMO DESCONTO NA NOTA.            *}
        {************************29/04/2009*****MV*}
        If ((strCliOrg = 'S') And (strOrPuRD = 'R')) Or (strZonFra = 'S') Then
        Begin
          fltIcmIte := fFormataFloat(arrMatItens[intContador].fltUniTar * arrMatItens[intContador].fltPerBas * arrMatItens[intContador].fltAlqAnt / 100 / 100, 2);

          pGeraAlqIcm(strComLub,
                      0,
                      0,
                      0,
                      fTotalGeralItem(intContador) - IIF((strCalIcm = 'S') Or (strZonFra = 'S'), fFormataFloat(fltIcmIte * arrMatItens[intContador].fltQtdIte, 2), 0),
                      arrMatItens[intContador].fltBasIpi,
                      arrMatItens[intContador].fltValIpi,
                      0);
        End
        Else
        Begin

          {*****************************************}
          {* GERA RESUMO DE ALIQUOTAS DE ICMS      *}
          {**************************************MV*}
          pGeraAlqIcm(strComLub,
                      IIF(Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0, 0, arrMatItens[intContador].fltAlqIcm),
                      arrMatItens[intContador].fltBasIcm,
                      arrMatItens[intContador].fltValIcm,
                      fTotalGeralItem(intContador),
                      arrMatItens[intContador].fltBasIpi,
                      arrMatItens[intContador].fltValIpi,
                      0);
        End;

        If (objNfeComplemento.tncTipoNota = tncComplementoValor) And (VS_strSimPau = 'S') Then
        Begin
          pZerarDadosIpiMatrizItens(false, intContador);
          pZerarDadosIcmsMatrizItens(false, intContador);
          pZerarDadosStMatrizItens(intContador);
        End;

        If Self.blnEspelhoDevolucaoClienteFatDadosFiscais Then
        Begin
          If not fEmptyStr(arrMatItens[intContador].strClaFis) Then
          Begin
            Case arrMatItens[intContador].strClaFis[1] Of
              '1': arrMatItens[intContador].strClaFis := '5' + RightStr(arrMatItens[intContador].strClaFis, 3);
              '2': arrMatItens[intContador].strClaFis := '6' + RightStr(arrMatItens[intContador].strClaFis, 3);
              '3': arrMatItens[intContador].strClaFis := '7' + RightStr(arrMatItens[intContador].strClaFis, 3);
            End;

            If (RightStr(arrMatItens[intContador].strClaFis, 3) = '411') And
               (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0) And
               (Self.strCliCon = 'S') Then
              arrMatItens[intContador].strClaFis := LeftStr(arrMatItens[intContador].strClaFis, 1) + '413';
          End;
        End;

        fltBasIpi := fltBasIpi + arrMatItens[intContador].fltBasIpi;
        fltTotIpi := fltTotipi + arrMatItens[intContador].fltValIpi;
        fltBasIcm := fltBasIcm + arrMatItens[intContador].fltBasIcm;
        fltTotIcm := fltTotIcm + arrMatItens[intContador].fltValIcm;
        fltBasRet := fltBasRet + arrMatItens[intContador].fltBasRet;
        fltTotRet := fltTotRet + arrMatItens[intContador].fltValRet;

        if fTotalizaBaseDeIcmsSimplesNacional(arrMatItens[intContador]) then
        begin
          if arrMatItens[intContador].strIndRev = 'I' then
          begin
            fltBasInd := fltBasInd + fTotalGeralItem(intContador);
          end
          else
          begin
            fltBasRev := fltBasRev + fTotalGeralItem(intContador);
          end;

          fltBasSim := fltBasSim + fTotalGeralItem(intContador);
        end;

        {*********************************************************}
        {* VALOR DO IMPOSTO EMBUTIDO NO PRECO DO PRODUTO ARTIGO  *}
        {* N.º 1 DA LEI 12.741/12, DISCRIMINADO NA NOTA FISCAL.  *}
        {******************************************************JC*}
        If Not fUsaImpostoFonteIBPT Then
        Begin
          arrMatItens[intContador].fltImpPag := fFormataFloat((arrMatItens[intContador].fltTotIte -
                                                               arrMatItens[intContador].fltDesEsp) *
                                                               arrMatItens[intContador].fltPeImPg / 100.00, 2);

          fltImpPag := fltImpPag + arrMatItens[intContador].fltImpPag;
        End
        Else
        Begin
          arrMatItens[intContador].fltFedImp := fFormataFloat((arrMatItens[intContador].fltTotIte -
                                                               arrMatItens[intContador].fltDesEsp) *
                                                               arrMatItens[intContador].fltPeImFd / 100.00, 2);

          fltFedImp := fltFedImp + arrMatItens[intContador].fltFedImp;

          arrMatItens[intContador].fltEstImp := fFormataFloat((arrMatItens[intContador].fltTotIte -
                                                               arrMatItens[intContador].fltDesEsp) *
                                                               arrMatItens[intContador].fltPeImEs / 100.00, 2);

          fltEstImp := fltEstImp + arrMatItens[intContador].fltEstImp;

          arrMatItens[intContador].fltMunImp := fFormataFloat((arrMatItens[intContador].fltTotIte -
                                                               arrMatItens[intContador].fltDesEsp) *
                                                               arrMatItens[intContador].fltPeImMn / 100.00, 2);

          fltMunImp := fltMunImp + arrMatItens[intContador].fltMunImp;
        End;

        If (fltTotPro - fltDesEsp) <> 0.00 Then
        Begin
          If Not fUsaImpostoFonteIBPT Then
            fltPeImPg := fltImpPag / (fltTotPro - fltDesEsp) * 100
          Else
          Begin
            fltPeImFd := fltFedImp / (fltTotPro - fltDesEsp) * 100;
            fltPeImEs := fltEstImp / (fltTotPro - fltDesEsp) * 100;
            fltPeImMn := fltMunImp / (fltTotPro - fltDesEsp) * 100;
          End;
        End;

        {*****************************************}
        {* SEPARA SUBSTITUICAO TRIBUTARIA        *}
        {* COMBUSTIVEL/LUBRIFICANTE E DEMAIS     *}
        {* PRODUTOS                              *}
        {**************************************MV*}
        If arrMatItens[intContador].fltValRet <> 0.0 Then
        Begin

          If strComLub = 'S' Then
          Begin
            fltRetCom := fltRetCom + arrMatItens[intContador].fltValRet;
            fltBcrCom := fltBcrCom + arrMatItens[intContador].fltBasRet;
          End
          Else
          Begin
            fltRetNor := fltRetNor + arrMatItens[intContador].fltValRet;
            fltBcrNor := fltBcrNor + arrMatItens[intContador].fltBasRet;
          End;

        End;

        If (arrMatItens[intContador].strBrinde = 'S') Then
        Begin
          If (Not fPermiteBrindeComValorZero) Then
          Begin
            fltTotProBri := fltTotProBri + (arrMatItens[intContador].fltTotIte +
                                            arrMatItens[intContador].fltValIpi +
                                            arrMatItens[intContador].fltValRet +
                                            arrMatItens[intContador].fltValFre +
                                                           arrMatItens[intContador].fltDesAce);
            fltTotIpiProBri := fltTotIpiProBri + arrMatItens[intContador].fltValIpi;
            fltTotRetProBri := fltTotRetProBri + arrMatItens[intContador].fltValRet;
          End
          Else If ((arrMatItens[intContador].fltTotIte > 0) And (Pos(arrMatItens[intContador].strClaFis, fRetComplementoStrClaDevBrinde(strOpcDoc)) > 0)) Then
          Begin
            fltTotDevBri := fltTotDevBri + (arrMatItens[intContador].fltTotIte +
                                            arrMatItens[intContador].fltValIpi +
                                            arrMatItens[intContador].fltValRet +
                                            arrMatItens[intContador].fltValFre +
                                            arrMatItens[intContador].fltDesAce);
          End;
        End;

        strEspDocAux := Self.strEspDoc;
        Try
          If fMeiaNotaComNotaNormalGerandoApenasNF(Self.blnDesmembrarMeiaNotaComNotaNormal, arrMatItens[intContador].blnMeiaNotaFatorExpedicao) Then
            Self.strEspDoc := 'NF';

          If (fCalculaRecDifalFCP) Then
            pCalculaGravaICMSUFDestino('', '', arrMatItens[intContador])
          Else If (strOpcDoc = 'DV') Then
            pCalculaDifalDevolucaoMatriz(arrMatItens[intContador]);
        Finally
          Self.strEspDoc := strEspDocAux;
        End;

        if TFunctionsZerarImpostosRegrasImpostosFaturamento.fZerarSTFaturamentoConsignacao(arrMatItens[intContador].strClaFis) then
        Begin
          Self.fltValFcpSTZeradoFaturaConsignacao := Self.fltValFcpSTZeradoFaturaConsignacao + arrMatItens[intContador].fltValorCalculadoFCPSTConsignacao;
        End;

        If (arrMatItens[intContador].fltValRet > 0) And (arrMatItens[intContador].recDifalFCP.fltValFcp > 0) Then
        Begin
          fltBasFcpST := fltBasFcpST + arrMatItens[intContador].recDifalFCP.fltBasFcp;
          fltTotFcpST := fltTotFcpST + arrMatItens[intContador].recDifalFCP.fltValFcp;
        End;

        If Assigned(pOnProcessaItem) Then
          pOnProcessaItem(arrMatItens[intContador], intContador, Length(arrMatItens) * LMaxEtapasProcessaItem);
      Finally
        pAfterCalculaTotGerItem(arrMatItens[intContador]);
      End;
    End; // end do for.

    if strOpcDoc = 'CR' then
    Begin
      fltTotCus := 0;
      For intContador := 0 To Length(arrMatItens) -1 Do
        fltTotCus := fltTotCus + arrMatItens[intContador].fltTotCus;
    End;

    //*****************************************************//
    // SE O CLIENTE FOR ORGAO PUBLICO E O TIPO DO DESCON.  //
    // DO IMPOSTO FOR RATEADO ENTAO ZERA O VALOR DA VAR.   //
    // QUE ARMAZENA O VALOR DA ALIQUOTA, QUE E SOMADA AO   //
    // DESCONTO ESPECIAL                                   //
    //**************************************************ED*//
    If (fVerificaImpRateadoDescOrgaoPublico) Then
    Begin
      fltIcmOrg := 0.0;

      fltTotSPro := 0.0;
      fltTotCPro := 0.0;

      fltTotBruSPro := 0.0;
      fltTotBruCPro := 0.0;

      fltTotGer := 0.0;
      fltTotPro := 0.0;
      fltTotDes := 0.0;

      For intContador := 0 To Length(arrMatItens) -1 Do
      Begin

        If fEhItemServico(arrMatItens[intContador].strCodIte) Then
          Continue;

        arrMatItens[intContador].fltBasOrg := 0.00;
        arrMatItens[intContador].fltIcmOrg := 0.00;

        If Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) <= 0 Then
        Begin
          If (fFormataFloat(arrMatItens[intContador].fltPerBas, 2) > 0) Then
            fltPorDesRat := fFormataFloat((arrMatItens[intContador].fltAlqAnt * arrMatItens[intContador].fltPerBas) / 100, 2)
          Else
            fltPorDesRat := arrMatItens[intContador].fltAlqAnt;
        End
        Else
          fltPorDesRat := 0;

        fltDesConTmp := fFormataFloat((arrMatItens[intContador].fltUnitar * fltPorDesRat) / 100, fMaxDecUni);
        fltUnitarTmp := fFormataFloat(arrMatItens[intContador].fltUnitar - fltDesConTmp, VS_intDecUni);
        fltTotIteTmp := fFormataFloat(arrMatItens[intContador].fltQtdIte * fltUnitarTmp, 2);
        fltTotIteTmp := fFormataFloat(fltTotIteTmp + (arrMatItens[intContador].fltUniEmb * arrMatItens[intContador].fltQtdEmb), 2);

        arrMatItens[intContador].fltUnitar := fFormataFloat(arrMatItens[intContador].fltUnitar - ((arrMatItens[intContador].fltUnitar * fltPorDesRat) / 100), intDecUni);
        arrMatItens[intContador].fltTotIte := fltTotIteTmp;

        If (arrMatItens[intContador].fltUniIcm = 0) Then
          arrMatItens[intContador].fltUniIcm := arrMatItens[intContador].fltUnitar
        Else
          arrMatItens[intContador].fltUniIcm := fFormataFloat(arrMatItens[intContador].fltUniIcm - ((arrMatItens[intContador].fltUniIcm * fltPorDesRat) / 100), 4);

        If (Not fItemEmPromocao(arrMatItens[intContador])) Then
        Begin
          fltTotSPro    := fltTotSPro + fltTotIteTmp;
          fltTotBruSPro := fltTotBruSPro + fFormataFloat(arrMatItens[intContador].fltQtdIte * arrMatItens[intContador].fltPreTab, 2);
        End
        Else
        Begin
          fltTotCPro    := fltTotCPro + fltTotIteTmp;
          fltTotBruCPro := fltTotBruCPro + fFormataFloat(arrMatItens[intContador].fltQtdIte * arrMatItens[intContador].fltPreTab, 2);
        End;

        fltTotGer := fltTotGer + fltTotIteTmp;
        fltTotPro := fltTotPro + fltTotIteTmp;
        fltTotDes := fltTotDes + fltDesConTmp;

      End;

    End;

    If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      blnCalcIssConcreto := fEhVendaItemConcreto
    Else
      blnCalcIssConcreto := fEhVendaItemConcreto And blnDesmembrarNotaProdutosServicos;

    If blnCalcIssConcreto And MatchStr(fCfgSis('TPNFCR'), [PRESTCON,SECOL]) Then
    Begin
      blnCalcIssConcreto := (strOpcDoc = 'CN') Or blnTaxaBombeamentoPedOrc;

      If Not blnCalcIssConcreto Then
      Begin
        fltBasIss := 0.0;
        fltPerIss := 0.0;
        fltValIss := 0.0;
      End;
    End;

    If blnCalcIssConcreto Then //Prestcon
    Begin

      {Se confirmação de nota de concreto da J.A Massa e Concreto,
       redução será informada na tela de dados fiscais!}
      If Not ((strOpcDoc = 'CN') And (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO)) Then
        pDefineAliquotaIss;

      fltBasIss := fltTotPro - fltDesEsp;

      If ((strOpcDoc = 'CN') Or blnTaxaBombeamentoPedOrc)Then
      Begin
        fltBasIss := fltBasIss + fltTotBom;

        fltBasIss := fltBasIss - IIF(strCobIss = 'T', 0, fltTotCus);
      End

      Else If ((fCfgSis('TPNFCR') = FIGUEIREDO) Or (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO)) And (Not blnNotaServicoConcreto) Then
      Begin
        For intContador := 0 To Length(arrMatItens) -1 Do
        Begin
          fltBasIss := fltBasIss - fCalculaPrecoEstrutura(
            False, Preco_de_Custo, arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEmpIte, 'S', '', 0, arrMatItens[intContador].fltQtdIte);
        End;
      End;

      If fltBasIss < 0 Then fltBasIss := 0;

      fltBasIss := fFormataFloat(fltBasIss * (1 - fltRedIss / 100), 2);
      fltValIss := fCalculaValorIss(fltBasIss, fltPerIss);
    End;

    If fEhNotaDeServicoComNaturezaIsenta Then
    Begin
      Self.fltPerIss := 0;
      Self.fltValIss := 0;
    End;

    fltTotSPro := fFormataFloat(fltTotSPro, 2);//Total dos Produtos Sem Promoção
    fltTotCPro := fFormataFloat(fltTotCPro, 2);//Total dos Produtos Com Promoção

    fltTotBruSPro := fFormataFloat(fltTotBruSPro, 2);//Total Bruto dos Produtos Sem Promoção
    fltTotBruCPro := fFormataFloat(fltTotBruCPro, 2);//Total Bruto dos Produtos Com Promoção

    fltTotGer := fFormataFloat(fltTotGer, 2);
    fltTotPro := fFormataFloat(fltTotPro, 2);
    fltTotDes := fFormataFloat(fltTotDes, 2);

    fltTotProChkSemDesApl := fFormataFloat(fltTotProChkSemDesApl, 2); //Total de produtos incluídos pelo F3 e que não terão desconto aplicado;

    {*****************************************}
    {* ABATE DESCONTO ESPECIAL DAS BASES     *}
    {**************************************MV*}
    SetLength(arrDesCffGer, 0);
    SetLength(arrDesCffDet, 0);
    If (fltDesEsp + fltDesEspDifeF4 > 0.0) Then
    Begin

      If Not ( ((strCliOrg = 'S') Or (strZonFra = 'S')) And
               (VS_strSimPau <> 'S') And
               (fDentroDoEstado('')) ) Then
      Begin

        {**************************************}
        {* RATEIA O VALOR DE DESCONTO NA BASE *}
        {* DA MATRIZ DE ITENS                 *}
        {***********************************AF*}
        fltDesEspRes := 0.0;
        SetLength(arrDesCffGer, 0);
        SetLength(arrDesCffDet, 0);

        For intContador := 0 To Length(arrMatItens)-1 Do
        Begin
          If fEhItemServico(arrMatItens[intContador].strCodIte) Then
            Continue;

          arrMatItens[intContador].fltDesCff := fFormataFloat(fltDesEspRef * (arrMatItens[intContador].fltTotIte / fltTotGer), 2);

          fltDesEspRes := fltDesEspRes + arrMatItens[intContador].fltDesCff;
        End;

        If fFormataFloat(fltDesEspRes,2) > fFormataFloat(fltDesEspRef,2) Then
        Begin
          For intContador := 0 To Length(arrMatItens)-1 Do
          Begin

            If arrMatItens[intContador].fltDesCff <> 0 Then
            Begin
              arrMatItens[intContador].fltDesCff := fFormataFloat(arrMatItens[intContador].fltDesCff - (fltDesEspRes - fltDesEspRef),2);
              Break;
            End;

          End;
        End;

        If fFormataFloat(fltDesEspRes,2) < fFormataFloat(fltDesEspRef,2) Then
        Begin
          For intContador := 0 To Length(arrMatItens)-1 Do
          Begin

            If arrMatItens[intContador].fltDesCff <> 0 Then
            Begin
              arrMatItens[0].fltDesCff := fFormataFloat(arrMatItens[0].fltDesCff + (fltDesEspRef - fltDesEspRes),2);
              Break;
            End;

          End;
        End;

        {*******************************************}
        {* SINTETIZA O DESCFF                      *}
        {****************************************AF*}
        pSintetizaArrDesCffGer;
        pSintetizaArrDesCffDet;
      End;

    End; {If (fltDesEsp > 0.0) Then...}

    pProcessMessages;

    {*****************************************}
    {* SINTETIZA AS CLASSIFICAÇÕES FISCAIS.  *}
    {**************************************MV*}
    Inc(LPosEtapasProcessaItem);
    pSintetizaClassificacoes(blnPegaClassificacaoItem, pOnProcessaItem, LPosEtapasProcessaItem, LMaxEtapasProcessaItem);
    pGeraLegendaClassificacaoIPI;
    pGeraResumoImpostosPagosNCM;
    pGeraAlqIteImpressao;
    pSintetizaAbreviacaoFiscal;

    pProcessMessages;

    {*******************************************}
    {* CALCULA IRPF, PIS, COFINS, CSLL DOS     *}
    {* SERVIÇOS                                *}
    {****************************************MV*}

    if (fCfgSis('IRCSER', varBoolean)) then
      fltIrSeDv := fCalculaIrSeDv
    else
      fltIrSeDv := fFormataFloat((fltAlqIrf * fltTotSer) / 100.0, 2);

    If (fCfgSis('PCCSER', varBoolean)) then
    Begin
      pCalculaPisCofinsCsllSeDv;
    End
    Else
    Begin
      fltPiSeDv := fFormataFloat((fltAlqPis * fltTotSer) / 100.0, 2);
      fltCoSeDv := fFormataFloat((fltAlqCof * fltTotSer) / 100.0, 2);
      fltCsSeDv := fFormataFloat((fltAlqCsl * fltTotSer) / 100.0, 2);
    End;

    {*******************************************}
    {* CALCULA IRPF, PIS, COFINS, CSLL DOS     *}
    {* PRODUTOS                                *}
    {****************************************MV*}
    fltIrPrDv := fFormataFloat((fRetornaBaseDeRetencaoDeProdutos * fltAlIrfP) / 100.0, 2);
    fltPiPrDv := fFormataFloat((fRetornaBaseDeRetencaoDeProdutos * fltAlPisP) / 100.0, 2);
    fltCoPrDv := fFormataFloat((fRetornaBaseDeRetencaoDeProdutos * fltAlCofP) / 100.0, 2);
    fltCsPrDv := fFormataFloat((fRetornaBaseDeRetencaoDeProdutos * fltAlCslP) / 100.0, 2);

    fltValIrf := fltIrSeDv;
    fltValPis := fltPiSeDv;
    fltValCof := fltCoSeDv;
    fltValCsl := fltCsSeDv;

    fltValIrf := fltValIrf + fltIrPrDv;
    fltValPis := fltValPis + fltPiPrDv;
    fltValCof := fltValCof + fltCoPrDv;
    fltValCsl := fltValCsl + fltCsPrDv;

    {*******************************************}
    {* ARREDONDAMENTO                          *}
    {****************************************MV*}
    fltValIrf := fFormataFloat(fltValIrf, 2);
    fltValPis := fFormataFloat(fltValPis, 2);
    fltValCof := fFormataFloat(fltValCof, 2);
    fltValCsl := fFormataFloat(fltValCsl, 2);

    {***********************************}
    { ISENTA OS IMPOSTOS                }
    {********************************JB*}
    strEspeciesZerar := TFunctionFuncoesFaturamento.IsentaImpostosEspeciesZerar(blnDesmembrarMeiaNotaComNotaNormal);

    If TFunctionsRegrasImpostosFaturamento.IsentaImpostosEspeciesZerarBaixaEntregaFuturaVendaItemConcreto(
         strEspDoc, strEspeciesZerar, strOpcDoc, SameText(strCliOrg, 'S'), SameText(strZonFra, 'S'),
         blnBaiEntFut, (strEntFut = 'S'), fEhVendaItemConcreto, blnDesmembrarNotaProdutosServicos) Then
    Begin
      If (fltTotRet > 0) Or (fltTotIpi > 0) Then
      Begin
        For intContador := 0 To Length(arrMatItens) -1 Do
        Begin
          If (fZerarSubstituicaoTributaria) Then
          Begin
            arrMatItens[intContador].fltBasRet := 0.0;
            arrMatItens[intContador].fltValRet := 0.0;
          End;

          If (fZerarIpi) Then
          Begin
            arrMatItens[intContador].fltBasIpi := 0.0;
            arrMatItens[intContador].fltValIpi := 0.0;
          End;
        End;
      End;

      If (fZerarSubstituicaoTributaria) Then
      Begin
        fltBasRet   := 0.0;
        fltTotRet   := 0.0;
        fltBasFcpST := 0.0;
        fltAlqFcpST := 0.0;
        fltTotFcpST := 0.0;
      End;

      If (fZerarIpi) Then
      Begin
        fltBasIpi := 0.0;
        fltTotIpi := 0.0;
      End;

      fltRetNor := 0.0;
      fltRetCom := 0.0;

      If (Self.fZerarDespesaAcessoria) Then
        fltDesAce := 0.0;

      fltValIrf := 0.0;
      fltValPis := 0.0;
      fltValCof := 0.0;
      fltValCsl := 0.0;

      If ((strZonFra = 'S') And (strCliCon = 'N')) Then
      Begin
        //Se estiver configurado que nao calcula os impostos no
        //pedido e orcamento nao deve calcular o desconto de
        //icms de zona franca para cliente nao consumidor final
        If fZerarSubstituicaoTributaria Then
        Begin
          fltDesEsp := fltDesEsp - fltIcmOrg;
          fltIcmOrg := 0.0;

          If fltDesEsp < 0.0 Then
            fltDesEsp := 0.0;
        End;
      End;

    End;

    {*****************************************}
    {* CALCULA ALÍQUOTA DE IPI               *}
    {**************************************MV*}
    fltAlqIpi := 0.0;
    If (fltBasIpi > 0.0) Then
      fltAlqIpi := (fltTotIpi / fltBasIpi) * 100;

    {*****************************************}
    {* CALCULO ALÍQUOTA RETIDO               *}
    {**************************************MV*}
    fltAlqRet := 0.0;
    If (fltBasRet > 0.0) Then
      fltAlqRet := (fltTotRet / fltBasRet) * 100;

    If fCalculaPisCofinsLivroFiscal Then
    Begin
      pCalculaPisCofinsLivro;
      If (strZonFra = 'S') Then
        pCalculaVariaveisDePisCofinsParaClienteZonaFranca;
    End;

    // A base da reforma usa o PIS/COFINS dos itens, por isso vem depois do calculo acima
    pCalcularImpostosReformaTributaria(arrMatItens);

    If (blnCalculaImpostos) Then
      pSomarReformaTributariaAosBrindes;

    {*****************************************}
    {* CALCULA TOTAL GERAL                   *}
    {**************************************MV*}
    If (blnCalculaImpostos) Then
    Begin
      If (Not fEmptyStr(strConPag)) Then
      Begin
        If (fStatusCndPag(strConPag) = A_PRAZO) And (StrToInt(Copy(strConPag,1,2)) >= 2) Then
        Begin
          fltImpFre := 0;
          If (fCfgSis('IMPFRE', varBoolean)) Then
            fltImpFre := fltImpFre + fltValFre;

          If (fCfgSis('IMPSUB', varBoolean)) Then
            fltImpFre := fltImpFre + fltTotRet + fltTotFcpST;

          If (fCfgSis('IMPIPI', varBoolean)) Then
            fltImpFre := fltImpFre + fltTotIpi;

          If (fCfgSis('IMPCBS', varBoolean)) Then
            fltImpFre := fltImpFre + fltTotCBS + fltTotIBS + fltTotIS;

        End
        Else
          fltImpFre := 0;
      End;

      fltTotGer := fltTotGer + ( Self.fltTotRet + Self.fltValFre + Self.fltTotIpi + Self.fltTotFcpST + Self.fltTotCBS + Self.fltTotIBS + Self.fltTotIS );
    End;

    blnImpostosNaPrimeiraParcela := (fltImpFre > 0);

    fltTotGer := fltTotGer - fltDesEsp;

    {*******************************************}
    {* SOMA SERVIÇO                            *}
    {****************************************MV*}
    fltTotGer := fltTotGer + fltTotSer;

    {*******************************************}
    {* PRESTCON - SOMA A TAXA DE BOMBEAMENTO   *}
    {****************************************MV*}
    fltTotGer := fltTotGer + fltTotBom;

    {*******************************************}
    {* DEDUZ SEGURIDADE SOCIAL                 *}
    {****************************************MV*}
    pDeduzSeguridadeSocial;
    //fltTotGer := fltTotGer - fltVlSgSo;

    {*******************************************}
    {* SOMA DESPESA ACESSÓRIA                  *}
    {****************************************MV*}
    fltTotGer := fltTotGer + fltDesAce;

    {******************************************}
    {* QUANDO OPERAÇÃO PARA ZONA FRANCA DE MA-*}
    {* NAUS, CALCULA PIS/COFINS.              *}
    {************************29/04/2009*****MV*}
    If (strZonFra = 'S') And (strEspDoc <> 'UC') And (Not blnBaiEntFut) Then
    Begin
      fltAlPisP := fCfgSis('ALPISP', varDouble);
      fltAlCofP := fCfgSis('ALCOFP', varDouble);

      // CBS/IBS/IS ja somaram no fltTotGer, mas nao compoem a base do PIS/COFINS
      LBasePisCofinsZonaFranca := fltTotGer;
      If (blnCalculaImpostos) Then
        LBasePisCofinsZonaFranca := LBasePisCofinsZonaFranca - (Self.fltTotCBS + Self.fltTotIBS + Self.fltTotIS);

      fltValPis := fFormataFloat(LBasePisCofinsZonaFranca * fltAlPisP / 100, 2);
      fltValCof := fFormataFloat(LBasePisCofinsZonaFranca * fltAlCofP / 100, 2);
    End;

    blnTravaCalcTotGer   := False;

    Inc(LPosEtapasProcessaItem);
    pRecalculaCustos(Self.arrMatItens, pOnProcessaItem, LPosEtapasProcessaItem, LMaxEtapasProcessaItem);

    strValEco := fGetValorEconomizado;

  Except

    On E: EAbort Do
    Begin
      blnTravaCalcTotGer := False;
      Raise;
    End;

    On E: ExceptionAutComSugerirVendaPresencial Do
    Begin
      blnTravaCalcTotGer := False;
      Raise;
    End;

    On E: Exception Do
    Begin
      blnTravaCalcTotGer := False;
      If FApenasLevantaExcecao Then
        Raise
      Else
        pMensagensErro(E.Message, '[pCalculaTotGer]');
    End;

  End;

end;

function TFatVendaBase.fZerarReformaTributariaEspeciesMIFF(const AEspecieDoDocumentoDevolvido: String): Boolean;
begin
  Result := fZerarReformaTributariaEspeciesMIFFDoDocumento(Self.strEspDoc, Self.strTipPed, AEspecieDoDocumentoDevolvido);
end;

function TFatVendaBase.fZerarReformaTributariaEspeciesMIFFDoDocumento(const AEspecieDocumento, ATipoPedido, AEspecieDoDocumentoDevolvido: String): Boolean;
begin
  Result := False;

  If fCfgSis('REF_FF', varBoolean) Then
    Exit;

  If (Pos(AEspecieDocumento, 'MI_FF_BR_') > 0) Then
    Exit(True);

  If (Pos(IIF(fEmptyStr(AEspecieDocumento), Self.strOpcDoc, AEspecieDocumento), 'PD_OR_') > 0) And (ATipoPedido = 'B') Then
    Exit(True);

  If (AEspecieDocumento <> 'DV') Then
    Exit;

  Result := (Pos(AEspecieDoDocumentoDevolvido, 'MI_FF_BR_') > 0);
end;

function TFatVendaBase.fDespesaAcessoriaGravadaParaReforma(const AItem: TDadosFechamento; const AEspecieDocumento: String): Double;
begin
  // A trigger calcula a reforma sobre o DET_DESACE gravado; na entrega futura (CFG_ENFUOP) o fGDadMovDet e o
  // fGNotDet movem IPI/ST/FCP-ST para a despesa acessoria depois deste calculo. Mesmas condicoes da gravacao.
  Result := AItem.fltDesAce;

  If (Pos(IIF(fEmptyStr(AEspecieDocumento), Self.strOpcDoc, AEspecieDocumento), 'PD_OR_') > 0) Then
    Exit;

  If fEhGravacaoDeNotGer Then
  Begin
    If (Self.strOpcDoc = 'CF') Then
      Exit;

    If Self.blnBaiEntFut And (fCfgSis('ENFUOP') = '1') Then
      Result := Result + AItem.fltValIpi
    Else If (AItem.strEntFutDocOri = 'S') And (fCfgSis('ENFUOP') = '2') Then
      Result := Result + AItem.fltValIpi + AItem.fltValRet + AItem.recDifalFCP.fltValFcp;
  End
  Else
  Begin
    If Self.blnBaiEntFut And (fCfgSis('ENFUOP') = '1') Then
      Result := Result + AItem.fltValIpi
    Else If (Not Self.blnBaiEntFut) And (AItem.strEntFut = 'S') And (fCfgSis('ENFUOP') = '2') Then
      Result := Result + AItem.fltValIpi + AItem.fltValRet + IIF((AItem.fltValRet > 0), AItem.recDifalFCP.fltValFcp, 0);
  End;
end;

function TFatVendaBase.fEhGravacaoDeNotGer: Boolean;
begin
  Result := False;

  If (Pos(Self.strOpcDoc, 'CF_CI_CT_FC_NE_') > 0) Then
    Exit(True);

  If (Self.blnNotEsp) Then
    Exit(True);

  If (Self.blnMeiaNota) Then
    Exit(True);

  If (Self.blnCupEsp) Then
    Exit(True);

  If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') and TFaturamentoMercadoLivre.NFeEmitidaPeloFaturador(Self.strChaveAcesso, Self.strFullNumPOK) Then
  Begin
    If Self.blnFullFilKar Then
      Exit(True);
  End;
end;

function TFatVendaBase.fReformaTributariaParaGravacao(const AItem: TDadosFechamento): TRefTribValoresGravacao;
begin
  Result := Default(TRefTribValoresGravacao);

  If FReformaGravadaPeloDelphi Or (Self.strOpcDoc = 'CR') Then
    Result := AItem.recRefGravacao;
end;

procedure TFatVendaBase.SetstrChaveAcesso(const Value: String);
begin
  FstrChaveAcesso := Value;
end;

procedure TFatVendaBase.pCalcularImpostosReformaTributaria(var AArrMatItens: TMatrizFechamento);
begin
  pCalcularImpostosReformaTributariaItens(AArrMatItens,
                                          Self.strEspDoc,
                                          Self.strTipPed,
                                          Self.strCodCli,
                                          Self.strAutEnt,
                                          Self.fDocumentoParaFornecedor,
                                          FTotCBS,
                                          FTotIBS,
                                          FTotIS,
                                          FTotBasCBS,
                                          FTotBasIBS,
                                          FTotBasIS);
end;

procedure TFatVendaBase.pCalcularImpostosReformaTributariaItens(var AArrMatItens: TMatrizFechamento;
                                                                const AEspecieDocumento,
                                                                      ATipoPedido,
                                                                      ACodigoPessoa,
                                                                      AAutoincrementoEntrega: String;
                                                                const AParaFornecedor: Boolean;
                                                                out ATotCBS,
                                                                    ATotIBS,
                                                                    ATotIS,
                                                                    ATotBasCBS,
                                                                    ATotBasIBS,
                                                                    ATotBasIS: Double);

  procedure pSetarImpostoNaMatriz(var AItemMatriz: TDadosFechamento; const AItemReforma : TRefTribRetorno);
  begin
    AItemMatriz.fltBasCBS := AItemReforma.BaseCBS;
    AItemMatriz.fltValCBS := AItemReforma.ValorCBS;
    AItemMatriz.fltAlqCBS := AItemReforma.AliquotaCBS;
    AItemMatriz.fltBasIBS := AItemReforma.BaseIBS;
    AItemMatriz.fltValIBS := AItemReforma.ValorIBS;
    AItemMatriz.fltAlqIBS := AItemReforma.AliquotaIBS;
    AItemMatriz.fltBas_IS := AItemReforma.BaseIS;
    AItemMatriz.fltVal_IS := AItemReforma.ValorIS;
    AItemMatriz.fltAlq_IS := AItemReforma.AliquotaIS;
    ATotCBS := ATotCBS + AItemMatriz.fltValCBS;
    ATotIBS := ATotIBS + AItemMatriz.fltValIBS;
    ATotIS  := ATotIS  + AItemMatriz.fltVal_IS;
    ATotBasCBS := ATotBasCBS + AItemMatriz.fltBasCBS;
    ATotBasIBS := ATotBasIBS + AItemMatriz.fltBasIBS;
    ATotBasIS  := ATotBasIS  + AItemMatriz.fltBas_IS;
  end;

  procedure pZerarImpostoNaMatriz(var AItemMatriz: TDadosFechamento);
  begin
    AItemMatriz.fltBasCBS := 0;
    AItemMatriz.fltValCBS := 0;
    AItemMatriz.fltAlqCBS := 0;
    AItemMatriz.fltBasIBS := 0;
    AItemMatriz.fltValIBS := 0;
    AItemMatriz.fltAlqIBS := 0;
    AItemMatriz.fltBas_IS := 0;
    AItemMatriz.fltVal_IS := 0;
    AItemMatriz.fltAlq_IS := 0;
  end;

  procedure pSetarImpostoDoDocumentoNaMatriz(var AItemMatriz: TDadosFechamento);
  begin
    AItemMatriz.fltBasCBS := AItemMatriz.recRefGravacao.fltBasCal;
    AItemMatriz.fltValCBS := AItemMatriz.recRefGravacao.fltCbsVal;
    AItemMatriz.fltAlqCBS := AItemMatriz.recRefGravacao.fltCbsAlq;
    AItemMatriz.fltBasIBS := AItemMatriz.recRefGravacao.fltBasCal;
    AItemMatriz.fltValIBS := AItemMatriz.recRefGravacao.fltValIbs;
    AItemMatriz.fltAlqIBS := AItemMatriz.recRefGravacao.fltIbsUfa + AItemMatriz.recRefGravacao.fltIbsMna;
    AItemMatriz.fltBas_IS := AItemMatriz.recRefGravacao.fltSelBas;
    AItemMatriz.fltVal_IS := AItemMatriz.recRefGravacao.fltSelVal;
    AItemMatriz.fltAlq_IS := AItemMatriz.recRefGravacao.fltSelAlq;
    ATotCBS := ATotCBS + AItemMatriz.fltValCBS;
    ATotIBS := ATotIBS + AItemMatriz.fltValIBS;
    ATotIS  := ATotIS  + AItemMatriz.fltVal_IS;
    ATotBasCBS := ATotBasCBS + AItemMatriz.fltBasCBS;
    ATotBasIBS := ATotBasIBS + AItemMatriz.fltBasIBS;
    ATotBasIS  := ATotBasIS  + AItemMatriz.fltBas_IS;
  end;

  function fMontarCabecalho : TRefTribCabecalho;
  begin
    Result := Default(TRefTribCabecalho);
    Result.strTipoOperacao := 'V';
    Result.strEspecieDocumento := AEspecieDocumento;
    Result.strTipoPessoa := IIF(AParaFornecedor, 'F', 'C');
    Result.strCodigoPessoa := ACodigoPessoa;
    Result.strVendaPresencial := IIF(Self.blnVendaPresencial, 'S', 'N');
    If fEmptyStr(AAutoincrementoEntrega) Then
      Result.strCidadeEntrega := fCampoTabela('CLI_CODCID', 'CADCLI', ['CLI_CODCLI'], [ACodigoPessoa], False)
    Else
      Result.strCidadeEntrega := fCampoTabela('ETC_CIDENT', 'ENTCLI', ['AUTOINCREM'], [AAutoincrementoEntrega], False);
  end;

  function fMontarItem(const AIndice : Integer) : TRefTribItem;
  begin
    Result := Default(TRefTribItem);
    Result.strIdItem := AArrMatItens[AIndice].strCodIte + '_' + AIndice.ToString;
    Result.strCodigoItem := AArrMatItens[AIndice].strCodIte;
    Result.fltValorItem := AArrMatItens[AIndice].fltTotIte;
    Result.strEmpresa := AArrMatItens[AIndice].strEmpIte;
    Result.strEntregaRetira := AArrMatItens[AIndice].strEntRet;
    Result.strCfop := AArrMatItens[AIndice].strClaFis;
    Result.strReferenciaDevolucao := IIF(Self.blnEstornoNotaFiscal, AArrMatItens[AIndice].strIncDev, AArrMatItens[AIndice].strAiDvOr);
    Result.strOrigemReferencia := fRefTribOrigemReferencia(AArrMatItens[AIndice].strTabDev);
    Result.fltDesconto := AArrMatItens[AIndice].fltDesEsp;
    Result.fltFrete := AArrMatItens[AIndice].fltValFre;
    Result.fltDespesaAcessoria := fDespesaAcessoriaGravadaParaReforma(AArrMatItens[AIndice], AEspecieDocumento);
    Result.fltValorIcms := AArrMatItens[AIndice].fltValIcm;
    Result.fltValorPis := AArrMatItens[AIndice].fltValPis;
    Result.fltValorCofins := AArrMatItens[AIndice].fltValCof;
    Result.fltValorFcp := AArrMatItens[AIndice].recDifalFCP.fltValFcp;
    Result.fltValorDifal := AArrMatItens[AIndice].recDifalFCP.fltDifDes;
  end;

  procedure pAtribuirGravacao(var AItemMatriz: TDadosFechamento; const AItemReforma : TRefTribRetorno);
  begin
    AItemMatriz.recRefGravacao.blnPreenchido := True;
    AItemMatriz.recRefGravacao.strCodCst := AItemReforma.strCodCst;
    AItemMatriz.recRefGravacao.strClaTri := AItemReforma.strClaTri;
    AItemMatriz.recRefGravacao.fltValOpe := AItemReforma.fltValOpe;
    AItemMatriz.recRefGravacao.fltBasCal := AItemReforma.fltBasCal;
    AItemMatriz.recRefGravacao.fltCbsAlq := AItemReforma.fltCbsAlq;
    AItemMatriz.recRefGravacao.fltCbsAld := AItemReforma.fltCbsAld;
    AItemMatriz.recRefGravacao.fltCbsVld := AItemReforma.fltCbsVld;
    AItemMatriz.recRefGravacao.fltCbsAlr := AItemReforma.fltCbsAlr;
    AItemMatriz.recRefGravacao.fltCbsVlt := AItemReforma.fltCbsVlt;
    AItemMatriz.recRefGravacao.fltCbsAle := AItemReforma.fltCbsAle;
    AItemMatriz.recRefGravacao.fltCbsVal := AItemReforma.fltCbsVal;
    AItemMatriz.recRefGravacao.fltIbsUfa := AItemReforma.fltIbsUfa;
    AItemMatriz.recRefGravacao.fltIbsUfd := AItemReforma.fltIbsUfd;
    AItemMatriz.recRefGravacao.fltIbsUvd := AItemReforma.fltIbsUvd;
    AItemMatriz.recRefGravacao.fltIbsUfr := AItemReforma.fltIbsUfr;
    AItemMatriz.recRefGravacao.fltIbsUft := AItemReforma.fltIbsUft;
    AItemMatriz.recRefGravacao.fltIbsUfe := AItemReforma.fltIbsUfe;
    AItemMatriz.recRefGravacao.fltIbsUfv := AItemReforma.fltIbsUfv;
    AItemMatriz.recRefGravacao.fltIbsMna := AItemReforma.fltIbsMna;
    AItemMatriz.recRefGravacao.fltIbsMnd := AItemReforma.fltIbsMnd;
    AItemMatriz.recRefGravacao.fltIbsMvd := AItemReforma.fltIbsMvd;
    AItemMatriz.recRefGravacao.fltIbsMnr := AItemReforma.fltIbsMnr;
    AItemMatriz.recRefGravacao.fltIbsMnt := AItemReforma.fltIbsMnt;
    AItemMatriz.recRefGravacao.fltIbsMne := AItemReforma.fltIbsMne;
    AItemMatriz.recRefGravacao.fltIbsMnv := AItemReforma.fltIbsMnv;
    AItemMatriz.recRefGravacao.fltValIbs := AItemReforma.fltValIbs;
    AItemMatriz.recRefGravacao.strSelCst := AItemReforma.strSelCst;
    AItemMatriz.recRefGravacao.strSelCla := AItemReforma.strSelCla;
    AItemMatriz.recRefGravacao.fltSelBas := AItemReforma.fltSelBas;
    AItemMatriz.recRefGravacao.fltSelAlq := AItemReforma.fltSelAlq;
    AItemMatriz.recRefGravacao.fltSelVal := AItemReforma.fltSelVal;
    AItemMatriz.recRefGravacao.strTriReg := AItemReforma.strTriReg;
    AItemMatriz.recRefGravacao.strCrePre := AItemReforma.strCrePre;
    AItemMatriz.recRefGravacao.strMonofa := AItemReforma.strMonofa;
  end;

  // Retorno de consignacao: a trigger nao calcula e a REF e gravada por nos. Mesma regra da
  // devolucao na trigger: perfil herdado do primeiro envio, valores do proprio retorno.
  procedure pCalcularRetornoConsignacao;
    Var
      LArrItens : TArrRefTribItem;
      LArrIndices : TArray<Integer>;
      LRetorno : TArrRefTribRetorno;
      LItemRetorno : TRefTribRetorno;
      LItem : TRefTribItem;
      LIndice : Integer;
      LSeqOrigem : String;
  begin
    SetLength(LArrItens, 0);
    SetLength(LArrIndices, 0);

    For LIndice := 0 To Length(AArrMatItens) -1 Do
    Begin
      LSeqOrigem := AArrMatItens[LIndice].recRefGravacao.strSeqOrigem;
      AArrMatItens[LIndice].recRefGravacao := Default(TRefTribValoresGravacao);
      AArrMatItens[LIndice].recRefGravacao.strSeqOrigem := LSeqOrigem;

      If fEmptyStr(LSeqOrigem) Then
        Continue;
      If fEhItemServico(AArrMatItens[LIndice].strCodIte) Then
        Continue;
      If (AArrMatItens[LIndice].strProEmb = 'S') Then
        Continue;

      LItem := fMontarItem(LIndice);
      LItem.strReferenciaDevolucao := LSeqOrigem;
      LItem.strOrigemReferencia := 'MOVREF';

      SetLength(LArrItens, Length(LArrItens) + 1);
      LArrItens[High(LArrItens)] := LItem;
      SetLength(LArrIndices, Length(LArrIndices) + 1);
      LArrIndices[High(LArrIndices)] := LIndice;
    End;

    If (Length(LArrItens) = 0) Then
      Exit;

    // A gravacao nao depende da CFG de soma no valor contabil, como na trigger
    LRetorno := TRefTribCalculo.fCalcular(fMontarCabecalho, LArrItens, True);

    For LItemRetorno In LRetorno Do
    Begin
      If Not LItemRetorno.Calculado Then
        Continue;

      LIndice := LArrIndices[LItemRetorno.intPosicao - 1];
      pAtribuirGravacao(AArrMatItens[LIndice], LItemRetorno);

      If fSomarNovosImpostosDaReformaAoValorContabil Then
        pSetarImpostoNaMatriz(AArrMatItens[LIndice], LItemRetorno);
    End;
  end;

  Var
    LRefGer : TRefTribCabecalho;
    LRefDet : TRefTribItem;
    LArrRefTribItem : TArrRefTribItem;
    LRefRetorno : TArrRefTribRetorno;
    LRefItemRetorno : TRefTribRetorno;
    LAchou : Boolean;
    LContador : Integer;
begin
  ATotCBS := 0;
  ATotIBS := 0;
  ATotIS  := 0;

  ATotBasCBS := 0;
  ATotBasIBS := 0;
  ATotBasIS  := 0;

  // Item sem retorno CALCULADO fica zerado, como a trigger grava na tabela REF
  For LContador := 0 To Length(AArrMatItens) -1 Do
    pZerarImpostoNaMatriz(AArrMatItens[LContador]);

  If (Self.strOpcDoc = 'CR') Then
  Begin
    pCalcularRetornoConsignacao;
    Exit;
  End;

  // Fulfillment: valores e a decisao de somar no contabil vem do documento, a CFG nao tem efeito
  If Self.blnReformaDefinidaPeloDocumento Then
  Begin
    If Self.blnReformaSomaNoContabilPeloDocumento Then
      For LContador := 0 To Length(AArrMatItens) -1 Do
        If AArrMatItens[LContador].recRefGravacao.blnPreenchido Then
          pSetarImpostoDoDocumentoNaMatriz(AArrMatItens[LContador]);
    Exit;
  End;

  If Not fSomarNovosImpostosDaReformaAoValorContabil Then
    Exit;

  LRefGer := fMontarCabecalho;

  SetLength(LArrRefTribItem, 0);
  For LContador := 0 To Length(AArrMatItens) -1 Do
  Begin
    If fEhItemServico(AArrMatItens[LContador].strCodIte) Then
      Continue;
    If (AArrMatItens[LContador].strProEmb = 'S') Then
      Continue;
    If fZerarReformaTributariaEspeciesMIFFDoDocumento(AEspecieDocumento, ATipoPedido, AArrMatItens[LContador].strEspDev) Then
      Continue;

    LRefDet := fMontarItem(LContador);
    SetLength(LArrRefTribItem, Length(LArrRefTribItem) + 1);
    LArrRefTribItem[Length(LArrRefTribItem)-1] := LRefDet;
  End;

  LRefRetorno := TRefTribCalculo.fCalcular(LRefGer, LArrRefTribItem);

  If Length(LRefRetorno) = 0 Then
    Exit;

  For LContador := 0 To Length(AArrMatItens) -1 Do
  Begin
    If fEhItemServico(AArrMatItens[LContador].strCodIte) Then
      Continue;
    If (AArrMatItens[LContador].strProEmb = 'S') Then
      Continue;
    LAchou := (LContador < Length(LRefRetorno)) And (LRefRetorno[LContador].strIdItem = AArrMatItens[LContador].strCodIte + '_' + LContador.ToString);
    If Not LAchou Then
    Begin
      For LRefItemRetorno In LRefRetorno Do
      Begin
        If LRefItemRetorno.strIdItem <> AArrMatItens[LContador].strCodIte + '_' + LContador.ToString Then
          Continue;
        If LRefItemRetorno.Calculado Then
          pSetarImpostoNaMatriz(AArrMatItens[LContador], LRefItemRetorno);
        Break;
      End;
    End
    Else
    Begin
      If LRefRetorno[LContador].Calculado Then
        pSetarImpostoNaMatriz(AArrMatItens[LContador], LRefRetorno[LContador]);
    End;
  End;
end;

procedure TFatVendaBase.pCopiarImpostosReformaTributaria(var ADestino: TDadosFechamento; const AArrOrigem: TMatrizFechamento);
var
  LIndice: Integer;
begin
  ADestino.fltBasCBS := 0;
  ADestino.fltValCBS := 0;
  ADestino.fltAlqCBS := 0;
  ADestino.fltBasIBS := 0;
  ADestino.fltValIBS := 0;
  ADestino.fltAlqIBS := 0;
  ADestino.fltBas_IS := 0;
  ADestino.fltVal_IS := 0;
  ADestino.fltAlq_IS := 0;

  For LIndice := Low(AArrOrigem) To High(AArrOrigem) Do
  Begin
    If (AArrOrigem[LIndice].intAutInc <> ADestino.intAutInc) Then
      Continue;

    ADestino.fltBasCBS := AArrOrigem[LIndice].fltBasCBS;
    ADestino.fltValCBS := AArrOrigem[LIndice].fltValCBS;
    ADestino.fltAlqCBS := AArrOrigem[LIndice].fltAlqCBS;
    ADestino.fltBasIBS := AArrOrigem[LIndice].fltBasIBS;
    ADestino.fltValIBS := AArrOrigem[LIndice].fltValIBS;
    ADestino.fltAlqIBS := AArrOrigem[LIndice].fltAlqIBS;
    ADestino.fltBas_IS := AArrOrigem[LIndice].fltBas_IS;
    ADestino.fltVal_IS := AArrOrigem[LIndice].fltVal_IS;
    ADestino.fltAlq_IS := AArrOrigem[LIndice].fltAlq_IS;
    Break;
  End;
end;

procedure TFatVendaBase.pSomarReformaTributariaAosBrindes(const AFator: Double = 1);
var
  LIndice: Integer;
  LValorReforma: Double;
begin
  For LIndice := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (arrMatItens[LIndice].strBrinde <> 'S') Then
      Continue;

    LValorReforma := (arrMatItens[LIndice].fltValCBS + arrMatItens[LIndice].fltValIBS + arrMatItens[LIndice].fltVal_IS) * AFator;

    If (Not fPermiteBrindeComValorZero) Then
    Begin
      fltTotProBri    := fltTotProBri + LValorReforma;
      fltTotRefProBri := fltTotRefProBri + LValorReforma;
    End
    Else If ((arrMatItens[LIndice].fltTotIte > 0) And (Pos(arrMatItens[LIndice].strClaFis, fRetComplementoStrClaDevBrinde(strOpcDoc)) > 0)) Then
      fltTotDevBri := fltTotDevBri + LValorReforma;
  End;
end;

procedure TFatVendaBase.pRecalcularReformaTributariaDosItens;
  Var
    LTotalAnterior : Double;
    LDiferenca     : Double;
begin
  LTotalAnterior := fltTotCBS + fltTotIBS + fltTotIS;
  pSomarReformaTributariaAosBrindes(-1);

  pCalcularImpostosReformaTributaria(arrMatItens);

  pSomarReformaTributariaAosBrindes;

  LDiferenca := (fltTotCBS + fltTotIBS + fltTotIS) - LTotalAnterior;
  fltTotGer  := fltTotGer + LDiferenca;

  If (Not fEmptyStr(strConPag)) And (fStatusCndPag(strConPag) = A_PRAZO) And
     (StrToInt(Copy(strConPag,1,2)) >= 2) And (fCfgSis('IMPCBS', varBoolean)) Then
  Begin
    fltImpFre := fltImpFre + LDiferenca;
    blnImpostosNaPrimeiraParcela := (fltImpFre > 0);
  End;
end;

function TFatVendaBase.fCalculaPisCofinsLivroFiscal: Boolean;
begin
  Result := False;

  If (Self.FApenasCalculoTotGerDosItens) Then
    Exit;

  If (strEspDoc = 'GF') Then
    Exit;

  If (Self.FFulfillment.EhOperacaoFulfillment) Then
    Exit;

  If (blnImportacaoSpedPisCofins) Then
    Exit;

  Result := True;
end;

procedure TFatVendaBase.pCalcularPisCofinsItemDerivado(var AItem: TDadosFechamento;
                                                       const AEmpresa,
                                                             ACliente,
                                                             ATipoPessoa: String;
                                                       const ATransferencia,
                                                             AAplicarDrawback: Boolean);
var
  LCalculo: TCalculoPisCofins;
  LResultado: TResultPisCofins;
begin
  If Not fCalculaPisCofinsLivroFiscal Then
    Exit;

  If fEmptyStr(AItem.strIteAbf) Then
    AItem.strIteAbf := AItem.strCodIte;

  LCalculo := TCalculoPisCofins.Create;
  Try
    LCalculo.blnGerarException := True;
    If AAplicarDrawback Then
      LCalculo.strCodEmbarcacao := FCodEmbarcacao;
    Try
      LResultado := LCalculo.fCalculoPisCofins(AEmpresa,
                                               AItem.strIteAbf,
                                               AItem.strClaFis,
                                               AItem.strCodFis,
                                               ACliente,
                                               TFunctionFuncoesFaturamento.OptantePorSimplesNacional(GetEmpCfg(AEmpresa)),
                                               'PD',
                                               AItem.fltTotIte,
                                               AItem.fltDesEsp,
                                               AItem.fltValipi,
                                               AItem.fltValRet,
                                               AItem.fltValFre,
                                               AItem.fltDesAce,
                                               AItem.fltValIcm,
                                               AItem.VisualizarFcpIcms.fltValor,
                                               ATipoPessoa,
                                               AItem.strIncPis,
                                               IIF(fEmptyStr(AItem.strSit_PC), Self.strSitP_C, AItem.strSit_PC),
                                               strMenP_C,
                                               dtaDtaEnt,
                                               strCodEmpTe,
                                               ATransferencia,
                                               False,
                                               AItem.strEntRet,
                                               AItem.strEntFut,
                                               AItem.strMotFut,
                                               AItem.strClaIpi,
                                               False,
                                               '',
                                               -1,
                                               '',
                                               '',
                                               0,
                                               0,
                                               fDifalItem(AItem));
    Except
      // Sem abreviacao de PIS/COFINS para o CFOP do pedido: segue com zero
      LResultado := Default(TResultPisCofins);
    End;
  Finally
    FreeAndNil(LCalculo);
  End;

  If (Not LResultado.blnResult) Then
    LResultado := Default(TResultPisCofins);

  AItem.strCSTPis := LResultado.strCstPis;
  AItem.fltBasPis := LResultado.dblBasePis;
  AItem.fltAlqPis := LResultado.dblAlqPis;
  AItem.fltValPis := LResultado.dblValorPis;
  AItem.strNatPis := LResultado.strNatRecPis;

  AItem.strCSTCof := LResultado.strCstCof;
  AItem.fltBasCof := LResultado.dblBaseCof;
  AItem.fltAlqCof := LResultado.dblAlqCof;
  AItem.fltValCof := LResultado.dblValorCof;
  AItem.strNatCof := LResultado.strNatRecCof;
end;

procedure TFatVendaBase.pSetaViaNfe;
begin
