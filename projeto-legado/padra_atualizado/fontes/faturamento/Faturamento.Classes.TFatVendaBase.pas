function TFatVendaBase.fZerarDespesaAcessoria: Boolean;
  Var
    strTipoSelecionado : String;
begin
  Result := False;

  If (fEmptyStr(Self.strEspDoc)) Then
    strTipoSelecionado := Self.strOpcDoc
  Else
    strTipoSelecionado := Self.strEspDoc;

  If (strTipoSelecionado = 'NF') Then
    Exit;

  If (strTipoSelecionado = 'PD') Then
    Exit;

  If (strTipoSelecionado = 'OR') Then
    Exit;

  If (strTipoSelecionado = 'PR') Then
    Exit;

  If (Self.strCodFpg = '016') Then
    Exit;

  If (Self.fltValFin <> 0) Then
    Exit;

  If (Assigned(Self.objDespesasFaturamento) And (Pos(Self.strEspDoc, 'MI_FF_DV_') > 0)) Then
    Exit;

  If ((Self.strCliDAc = 'S') And (Pos(Self.strEspDoc, 'MI_FF_DV_') > 0)) Then
    Exit;

  If fTemItensNotaNormalDesmembramentoExpedicao Then
    Exit;

  If (Self.blnBaiEntFut) Then
    Exit;

  Result := True;
end;

