procedure TFatVendaBase.pVoltaVrUnitarioSemDesconto(blnUsarUniIcm: Boolean = False);
  Var
    intContador: Integer;
begin
  For intContador := 0 To Length(arrMatItens) -1 Do
    If (blnUsarUniIcm) Then
      arrMatItens[intContador].fltUniTar := fFormataFloat(arrMatItens[intContador].fltUniIcm, VS_intDecUni)
    Else
      arrMatItens[intContador].fltUniTar := fFormataFloat(arrMatItens[intContador].fltUniTmp, VS_intDecUni);
end;

function TFatVendaBase.fEhJurosSemDescontoCartaoCondicaoFinalTotem(const AfltValTax: double): Boolean ;
begin
  Result := False ;

{$IFNDEF LINUX}
  if not VS_AutoatendimentoPagueFacil then
    Exit ;
{$ENDIF}
  if fCfgSis('CNDVEN') <> 'F' then
    Exit ;

  if AfltValTax <= 0 then
    Exit ;

  if Self.strAbDeCc <> 'N' then
    Exit ;

  Result := True ;
end ;

procedure TFatVendaBase.pAplicaTaxaJurosUnitario;
  Var
    intContador: Integer;
    fltValTax,
    fltVlrPro  : Double;
    fltTotProSemJuros: Double;
    fltTotProComJuros: Double;
begin

  fltTotProSemJuros := 0;
  fltTotProComJuros := 0;

  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    With arrMatItens[intContador] Do
    Begin
      Self.strIteCom := 'N';

      fltTotProSemJuros := fltTotProSemJuros +
        fFormataFloat(fltQtdIte * fFormataFloat(fltUnitar, VS_intDecUni), 2);

      {****************************************************}
      {* NAO DEVE APLICAR A TAXA DE JUROS QUANDO FOR UMA  *}
      {* CONFIRMACAO NEM DEVOLUCAO, POIS OCORRE DE        *}
      {* ALTERAR O VALOR JA FECHADO DO DOCUMENTO E        *}
      {* TAMBEM PODE OCORRER DE APLICAR NOVAMENTE O JUROS *}
      {*************************************************JC*}
      If (fGetTaxVprItem(strCodIte, strEmpIte) > 0) And
         ((blnRecalculaTaxCndF3Forcado And (Not blnEstaRecalculandoPeloAlteraPedidoVenda)) Or
          (blnCalculaTaxCndF3Inicio) Or
          ((blnTaxVpr) And (fCfgSis('CNDVEN') = 'F'))) And
         (strCodIte <> fCfgSis('ITEFRE')) And
         (strCodIte <> fCfgSis('ITEBOM')) And
         (strCodIte <> fCfgSis('ITETAX')) And
         (strCodIte <> fCfgSis('ITEMAN')) And
         (strCodIte <> fCfgSis('ITELAN')) And
         (Pos(strOpcDoc, 'TE_NC_BR_UC_CF_CT_CI_CN_DV_') <= 0) Then
      Begin

        fltValTax := fGetTaxVprItem(strCodIte, strEmpIte);

        If Pos(strOpcDoc, 'TR_CA_') > 0 Then
        Begin
          If strEntSai = 'E' Then
            fltValTax := 0;
        End;

        If (intSeqCom > 0) And (strAtivac <> 'S') Then
          Self.strIteCom := 'S';

        If (Not fAplicaTaxaJuros) Then
          fltValTax := 0;

        If (intSeqCom > 0) And (strAtivac <> 'S') And (strBrinde = 'S') Then
          fltValTax := 0;

        fltTaxJur := fltValTax;
      {$IFDEF LINUX}
        fltUniTar := fltUniTar + fFormataFloat(fltUniTar * (fltValTax / 100.0), VS_intDecUni);
      {$ELSE}
        if (strOriF11 = 'S') and (fCfgSis('CNDVEN') = 'F') and (fltTaxJur > 0) and (not VS_AutoatendimentoPagueFacil) then
        begin
          fltUniTar := fltUniDig - fFormataFloat(fltUniDig * (fltDesCon / 100.0), VS_intDecUni);
          fltUniTar := fltUniTar + fFormataFloat(fltUniTar * (fltTaxJur / 100.0), VS_intDecUni);
        end
        else
        Begin
          {CALCULANDO JUROS SOBRE O VALOR JÁ ACRESCIDO DELE, QUANDO CONDIÇÃO ESPECIAL E CND_F3 = "I"}
          if ((not (((blnCondicaoEspecial) and (blnCndEsp)) And (fCfgSis('CND_F3') = 'I')) And (strOriF11 = 'S'))
            or (strOriF11 = 'N')
            or VS_AutoatendimentoPagueFacil)  Then
            if not fEhJurosSemDescontoCartaoCondicaoFinalTotem(fltValTax) then
              fltUniTar := fltUniTar + fFormataFloat(fltUniTar * (fltValTax / 100.0), VS_intDecUni);
        End;
      {$ENDIF}

        fltVlrPro := 0;

        If (strPromoc = 'S') Then
        Begin
          fltVlrPro := fltUniTar;
        End;

        pPegaPrecoVendaBonus(strCodIte, fltVlrPro, fltUniTar, strCodCmg);

      End;

      fltTotProComJuros := fltTotProComJuros +
        fFormataFloat(fltQtdIte * fFormataFloat(fltUnitar, VS_intDecUni), 2);

      //TO-DO LIST: NUM SEGUNDO MOMENTO AJUSTAR CONDIÇÃO DE PAGAMENTO COM JUROS E DESCONTOS NO F11/F3
      //if (strOriF11 = 'S') and (fCfgSis('CNDVEN') = 'F') and (fltTaxJur > 0) and (fltDesCnd > 0) then
      //  fltUniTar := fltUniTar - fRetornaVrDesconto(2, fltUniTar, fltDesCnd);
    End;

  End;

  Self.fltTotJur := fltTotProComJuros - fltTotProSemJuros;

end;

procedure TFatVendaBase.pAplicaDescontoCondicaoUnitario;
  Var
    intContador: Integer;
    fltPerDes,
    fltVlrPro  : Double;
    strIteCom  : String;
    blnUsaDesCndDefinidoExpedicao: Boolean;
begin
  blnTemDescontoCondicaoPagamento := False;

  blnUsaDesCndDefinidoExpedicao := fUsaDesCndDefinidoExpedicao;

  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    With arrMatItens[intContador] Do
    Begin
      //SE ALGUM DOS ITENS NA EXPEDIÇÃO TEM DESCND, USA O FDO_DESCND DE CADA ITEM CONFORME O DOCUMENTO ORIGINAL
      If (blnUsaDesCndDefinidoExpedicao) Then
        fltPerDes := arrMatItens[intContador].fltDesCndExp
      Else
        fltPerDes := fRetPercentualDescontoCondPagamento(arrMatItens[intContador].strCodGru, arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEntSai);

      strIteCom := 'N';

      If (intSeqCom > 0) And (strAtivac <> 'S') Then
        strIteCom := 'S';

      If (fEmptyStr(Self.strNumPok)) Then
        fltDesCnd := 0;

      If (fAplicaDescontoCondPagamento(fltPerDes, strPromoc, strIteCom, fEhItemCarregadoJuntoPDouOR(arrMatItens[intContador]), True, arrMatItens[intContador].fltPreLot)) Then
      Begin
        If (fEmptyStr(Self.strNumPok)) Then
          fltDesCnd := fltPerDes;

        if (strOriF11 = 'S') and (fCfgSis('CNDVEN') = 'F') and (fltDesCnd > 0) and (not fEmptyStr(Self.strNumOrc)) then
        begin
          fltUniTar := fltUniDig - fFormataFloat(fltUniDig * (fltDesCon / 100.0), VS_intDecUni);
          fltUniTar := fltUniTar - fRetornaVrDesconto(2, fltUniTar, fltPerDes);
        end
        else
          fltUniTar := fltUniTar - fRetornaVrDesconto(2, fltUniTar, fltPerDes);

        fltVlrPro := 0;

        If strPromoc = 'S' Then
        Begin
          fltVlrPro := fltUniTar;
        End;

        pPegaPrecoVendaBonus(strCodIte, fltVlrPro, fltUniTar, strCodCmg);

        blnTemDescontoCondicaoPagamento := True;

        //TO-DO LIST: NUM SEGUNDO MOMENTO AJUSTAR CONDIÇÃO DE PAGAMENTO COM JUROS E DESCONTOS NO F11/F3
        //if (strOriF11 = 'S') and (fCfgSis('CNDVEN') = 'F') and (fltTaxJur > 0) and (fltDesCnd > 0) then
        //  fltUniTar := fltUniTar + fFormataFloat(fltUniOri * (fltTaxJur / 100.0), VS_intDecUni)
      End;
    End;

  End;

end;

procedure TFatVendaBase.pRateiaValores;
  Var
    blnRateiaDesEspPromocao: Boolean;
    blnRateiaDesEspPromocaoIncondicionalmente: Boolean;
    blnRateia: Boolean;
begin
  blnRateiaDesEspPromocao := True;
  blnRateiaDesEspPromocaoIncondicionalmente := False;

  {*********************************************************************}
  {* CASO CONFIGURADO PARA TRAZER COMO SUGESTAO O PRECO DE PROMOCAO    *}
  {* E O VALOR DO DOCUMENTO NAO FOR MENOR QUE O MINIMO (NAO TRAVOU)    *}
  {* ENTAO NAO DEVE FAZER O RATEIO DO DESCONTO ESPECIAL NOS ITENS      *}
  {* PROMOCAO, DO CONTRARIO SEMPRE DEVE FAZER O RATEIO MESMO NAS       *}
  {* PROMOCOES PARA EVITAR ITENS ABAIXO DO CUSTO E ATE MESMO NEGATIVOS *}
  {*****************************************************************JC**}
  If fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDePromocao Then
  Begin
    blnRateiaDesEspPromocao := False;

    If fTemItensPromoc Then
    Begin
      blnRateiaDesEspPromocao := fTemItensEmPromocaoQuePermiteDesconto;

      blnRateia := False;
      If (Not blnRateia) Then
        blnRateia := fApenasItensEmPromocao;
      If (Not blnRateia) Then
        blnRateia := fAposRateioTeraItemZerado;
      If (Not blnRateia) And (fCfgSis('MINCUS') <> 'N') Then
        blnRateia := fAposRateioTeraItemAbaixoCusto;

      If blnRateia Then
      Begin
        blnRateiaDesEspPromocao := True;
        blnRateiaDesEspPromocaoIncondicionalmente := True;
      End;
    End;
  End
  Else If (fCfgSis('TRAPRO', varString) = 'C') Then
  Begin
    If fApenasItensEmPromocao Then
      blnRateiaDesEspPromocaoIncondicionalmente := (fPermiteDescontoPromocao('', tapcdeOlhandoTodosItens));
  End;

  pRateiaValores(Self.arrMatItens, blnRateiaDesEspPromocao, blnRateiaDesEspPromocaoIncondicionalmente);
end;

{*****************************************}
{* RATEIA VALORES: FRETE, DESCONTO ESPE- *}
{* CIAL E DESPESA ACESSÓRIA              *}
{**************************************MV*}
procedure TFatVendaBase.pRateiaValores(Var Itens: TMatrizFechamento; blnRateiaDesEspPromocao: Boolean; blnRateiaDesEspPromocaoIncondicionalmente: Boolean=False);
  Var
    fltTotFrete    ,
    fltTotFreSug   ,
    fltTotFreRat   ,
    fltTotTaxEnt   ,
    fltTotDesAces  ,
    fltTotDesEsp   ,
    fltTotDeDVCf   ,
    fltTmpFrete    ,
    fltTmpFreSug   ,
    fltTmpFreRat   ,
    fltTmpTaxEnt   ,
    fltTmpDesAces  ,
    fltTmpDesEsp   ,
    fltTmpDeDVCf   ,
    fltPerCor      ,
    fltPerCorDesEsp,
    fltPerCorFrete,
    fltPerCorTaxEnt,
    fltPerCorDesAces,
    fltTotalItens  ,
    fltTotIteDesEsp,
    fltTotalPeso,
    fltTotIteEntrega,
    fltTotalPesoEntrega,
    fltTotalPesoNotaNormal,
    fltTotItensNotaNormal,
    fltTotFreCot,
    fltTmpFreCot : Double;
    intItem         : Integer;
    intExecRat      : Integer;
    blnRateiaFreSomItensEnt: Boolean;
    blnRateiaFreteDespAcessoriaSomenteItensNotaNormal: Boolean;
    blnMoveu: Boolean;
    strNumOrcLoc,
    strEspOrcLoc: String;
    blnOrdenaSecInc: Boolean;

    function fGetPesoItem(item: TDadosFechamento): Double;
    begin
      Result := fFormataFloat(item.fltQtdIte * item.fltPesoIt, 3);
    end;

    procedure pAtualizaRegistroItem;
    begin
      Itens[intItem].fltValFre := fltTmpFrete;
      Itens[intItem].fltFreSug := fltTmpFreSug;
      Itens[intItem].fltFreRat := fltTmpFreRat;
      Itens[intItem].fltTaxEnt := fltTmpTaxEnt;
      Itens[intItem].fltDesAce := fltTmpDesAces;
      Itens[intItem].fltDesEsp := fltTmpDesEsp;
      Itens[intItem].fltDeDVCf := fltTmpDeDVCf;

      if (strOpcDoc <> 'DV') then
        Itens[intItem].fltFreCot := fltTmpFreCot;
    end;

    function fPermiteRatearItem(fltFncTotIte, fltFncDesEsp: Double) : Boolean;
    begin
      Result := Not (fFormataFloat(fltFncTotIte - fltFncDesEsp, 2) <= 0.00);
    end;

    function fTemRateio: Boolean;
    begin
      Result := ((Abs(fltTmpFrete) + Abs(fltTmpFreSug) + Abs(fltTmpFreRat) + Abs(fltTmpTaxEnt) +
                  Abs(fltTmpDesAces) + Abs(fltTmpDesEsp) + Abs(fltTmpDeDVCf) + Abs(fltTmpFreCot)) <> 0.0);
    end;

    function fTemRateioFrete: Boolean;
    begin
      Result := ((Abs(fltTmpFrete) + Abs(fltTmpFreSug) + Abs(fltTmpFreRat) + Abs(fltTmpFreCot)) <> 0.0);
    end;

    function fTemRateioDespAcessoria: Boolean;
    begin
      Result := (Abs(fltTmpDesAces) <> 0.0);
    end;

    function fItemSemPromocao(item: TDadosFechamento): Boolean;
    begin
       Result := (item.strPromoc <> 'S') And ((item.intSeqCom <= 0) Or ((item.intSeqCom > 0) And (item.strAtivac = 'S')));
    end;

    function fItemComPromocaoQuePodeSerRateado(item: TDadosFechamento): Boolean;
    begin
      Result := False;

      If (item.strPromoc = 'S') Then
      Begin
        If blnRateiaDesEspPromocao Then
        Begin
          If blnRateiaDesEspPromocaoIncondicionalmente Then
          Begin
            Result := True
          End
          Else
          Begin
            If (fCfgSis('TRAPRO', varString) = 'C') Then
              Result := (Not fTravarPeloPrecoPromocao(item.strCodPro))
            Else
              Result := True
          End;
        End;
      End;
    end;

    function fSeEhEmbalagemFechadaValidarSePodeSerRateado(item: TDadosFechamento): Boolean;
    begin
      Result := True;

      If (stlItensNaoTemQtdeEmbFec.IndexOf(item.strCodIte) >= 0) Then
        Exit;

      If (fUsandoPrecoEmbalagemComoMinimo) Then
      Begin
        If (SameText(item.strIdePro, 'NOR')) And
           (Not fEhItemVendaVidro(item.strCodIte)) And
           (fEhEmbalagemFechadaItem(item.strCodIte, item.strTabPre, item.fltQtdIte)) Then
        Begin
          Result := False;
        End;
      End;
    end;

    function fConsiderarItemNoRateioDeDesconto(item: TDadosFechamento): Boolean;
    begin
      Result := (fFlagDoItemPermiteRatearDesconto(item)) And
                (fItemComPromocaoQuePodeSerRateado(item) Or (fItemSemPromocao(item))) And
                (fSeEhEmbalagemFechadaValidarSePodeSerRateado(item));
    end;

    procedure pOrdenaArray(Var arrMatOri: TMatrizFechamento; ordArr: TOrdArrIte; out blnMoveu: Boolean);
      Var
        i: Integer;
        itemArry: TDadosFechamento;
        blnMover: Boolean;
        blnFeito: Boolean;
    begin
      Repeat
        blnFeito := True;
        For i := Low(arrMatOri) To High(arrMatOri) - 1 Do
        Begin
          blnMover := False;

          Case ordArr Of
            tOrdIntAutInc:Begin
                            If (arrMatOri[i].intAutInc > 0) And (arrMatOri[i + 1].intAutInc > 0) Then
                              blnMover := (arrMatOri[i].intAutInc > arrMatOri[i + 1].intAutInc);
                          End;

            tOrdIncSeqInc:Begin
                            If (arrMatOri[i].intSeqInc > 0) And (arrMatOri[i + 1].intSeqInc > 0) Then
                              blnMover := (arrMatOri[i].intSeqInc > arrMatOri[i + 1].intSeqInc);
                          End;

            tOrdStrSeqDet:Begin
                            If (Length(arrMatOri[i].strSeqDet) = 20) And (Length(arrMatOri[i + 1].strSeqDet) = 20) Then
                              blnMover := (arrMatOri[i].strSeqDet > arrMatOri[i + 1].strSeqDet);
                          End;
          End;

          If blnMover Then
          Begin
            itemArry         := arrMatOri[i];
            arrMatOri[i]     := arrMatOri[i + 1];
            arrMatOri[i + 1] := itemArry;

            blnFeito := False;
            blnMoveu := True;
          End;
        End;
      Until blnFeito;
    end;

    function fOrdernarMatriz: Boolean;
      Var
        item: TDadosFechamento;
    begin
      strNumOrcLoc := Self.strNumOrc;
      strEspOrcLoc := Self.strEspOrc;

      If (Self.blnExpedi) Then
      Begin
        For item In Itens Do
        Begin
          strNumOrcLoc := item.strNumOrc;
          strEspOrcLoc := item.strEspOrc;

          If ((strNumOrcLoc <> '') And (strEspOrcLoc <> '')) Then
            Break;
        End;
      End;

      Result := (Not MatchStr(Self.strOpcDoc, ['PD','OR'])) And (Not fEmptyStr(strNumOrcLoc));
    end;

begin
  blnMoveu := False;

  blnOrdenaSecInc := ((Self.blnExpedi) Or ((Self.strOriF11 = 'S') And (Self.strEspDoc = 'PD')));

  If fOrdernarMatriz Then
  Begin
    If ((strEspOrcLoc = 'PD') And (fCfgSis('ORDPDV', varString, fRetornaEmpresaCfg) <> '3')) Or
       ((strEspOrcLoc = 'OR') And (fCfgSis('ORDORC', varString, fRetornaEmpresaCfg) <> '3')) Then
    Begin
      pOrdenaArray(Itens, IIF(blnOrdenaSecInc, tOrdIncSeqInc, tOrdStrSeqDet), blnMoveu);
    End;
  End;

  Try
    {***********************}
    {* INICIA AS VARIAVEIS *}
    {********************JC*}
    fltTmpFrete           := 0.0;
    fltTmpFreSug          := 0.0;
    fltTmpFreRat          := 0.0;
    fltTmpTaxEnt          := 0.0;
    fltTmpDesAces         := 0.0;
    fltTmpDesEsp          := 0.0;
    fltTmpDeDvCf          := 0.0;
    fltTotFrete           := 0.0;
    fltTotFreSug          := 0.0;
    fltTotFreRat          := 0.0;
    fltTotTaxEnt          := 0.0;
    fltTotDesAces         := 0.0;
    fltTotDesEsp          := 0.0;
    fltTotalItens         := 0.0;
    fltTotIteDesEsp       := 0.0;
    fltTotDeDVCf          := 0.0;
    fltTotIteEntrega      := 0.0;
    fltTotalPeso          := 0.0;
    fltTotalPesoEntrega   := 0.0;
    fltTotalPesoNotaNormal:= 0.0;
    fltTotItensNotaNormal := 0.0;
    fltTotFreCot          := 0.0;

    if (strOpcDoc = 'DV') then
      Self.fltFreCot := 0;

    blnRateiaFreSomItensEnt := False;
    blnRateiaFreteDespAcessoriaSomenteItensNotaNormal := fTemItensNotaNormalDesmembramentoExpedicao;

    {***************************************************************************************}
    {* CASO POSSUA ITENS DE ENTREGA, O FRETE DEVE SER RATEADO SOMENTE NESTES ITENS,        *}
    {* POIS NO DESMEMBRAMENTO DA VENDA O FRETE SERA GRAVADO APENAS NO DOCUMENTO DE ENTREGA *}
    {************************************************************************************JC*}
    For intItem := 0 To Length(Itens) -1 Do
      If Not blnRateiaFreteDespAcessoriaSomenteItensNotaNormal And
         (fItemEntrega(Itens[intItem])) Then
      Begin
         blnRateiaFreSomItensEnt := True;
         Break;
      End;

    For intItem := 0 To Length(Itens) -1 Do
    Begin
      {************************************************}
      {* ZERA OS VALORES DE FRETE E DESPESA ACESSORIA *}
      {*******************************************JC***}
      pAtualizaRegistroItem;

      {**************************************}
      {* ACUMULA O TOTAL DOS ITENS DE VENDA *}
      {*********************************JC***}
      If fItemEntraRateio(Itens[intItem]) Then
      Begin
        fltTotalItens := fltTotalItens + Itens[intItem].fltTotIte;
        fltTotalPeso  := fltTotalPeso  + fGetPesoItem(Itens[intItem]);

        If fConsiderarItemNoRateioDeDesconto(Itens[intItem]) Then
          fltTotIteDesEsp := fltTotIteDesEsp + Itens[intItem].fltTotIte;

        If (fItemEntrega(Itens[intItem])) Then
        Begin
          fltTotIteEntrega    := fltTotIteEntrega    + Itens[intItem].fltTotIte;
          fltTotalPesoEntrega := fltTotalPesoEntrega + fGetPesoItem(Itens[intItem]);
        End;

        If blnRateiaFreteDespAcessoriaSomenteItensNotaNormal And (Not Itens[intItem].blnMeiaNotaFatorExpedicao) Then
        Begin
          fltTotItensNotaNormal  := fltTotItensNotaNormal  + Itens[intItem].fltTotIte;
          fltTotalPesoNotaNormal := fltTotalPesoNotaNormal + fGetPesoItem(Itens[intItem]);
        End;
      End;
    End;

    If fltTotalItens <= 0.0 Then
      Exit;

    For intItem := 0 To Length(Itens) -1 Do
    Begin
      If Not fItemEntraRateio(Itens[intItem]) Then
        Continue;

      {**************************************}
      {* PERCENTUAL CORRESPONDENTE DO ITEM  *}
      {*********************************JC***}
      fltPerCor        := Itens[intItem].fltTotIte / fltTotalItens;
      fltPerCorDesAces := Itens[intItem].fltTotIte / fltTotalItens;

      If (fItemEntrega(Itens[intItem])) And (blnAplicaTaxaEntrega) And (fltTotIteEntrega <> 0) Then
        fltPerCorTaxEnt := Itens[intItem].fltTotIte / fltTotIteEntrega
      Else
        fltPerCorTaxEnt := 0.0;

      If blnRateiaFreteDespAcessoriaSomenteItensNotaNormal Then
      Begin
        If (Not Itens[intItem].blnMeiaNotaFatorExpedicao) Then
        Begin
          {******************************************************************}
          {* Sistema configurado para rateio de frete proporcional ao peso  *}
          {***************************************************************JC*}
          If (fCfgSis('RATFRV') = '2') And (fltTotalPesoNotaNormal <> 0) Then
            fltPerCorFrete := fGetPesoItem(Itens[intItem]) / fltTotalPesoNotaNormal
          Else
            fltPerCorFrete   := Itens[intItem].fltTotIte / fltTotItensNotaNormal;

          fltPerCorDesAces := Itens[intItem].fltTotIte / fltTotItensNotaNormal;
        End
        Else
        Begin
          fltPerCorFrete   := 0;
          fltPerCorDesAces := 0;
        End;
      End
      Else If blnRateiaFreSomItensEnt Then
      Begin
        If (fItemEntrega(Itens[intItem])) Then
        Begin
          {******************************************************************}
          {* Sistema configurado para rateio de frete proporcional ao peso  *}
          {***************************************************************JC*}
          If (fCfgSis('RATFRV') = '2') And (fltTotalPesoEntrega <> 0) Then
            fltPerCorFrete := fGetPesoItem(Itens[intItem]) / fltTotalPesoEntrega
          Else
            fltPerCorFrete := Itens[intItem].fltTotIte / fltTotIteEntrega;
        End
        Else
        Begin
          fltPerCorFrete   := 0;
          fltPerCorDesAces := 0;
        End;
      End
      Else
      Begin
        {******************************************************************}
        {* Sistema configurado para rateio de frete proporcional ao peso  *}
        {***************************************************************JC*}
        If (fCfgSis('RATFRV') = '2') And (fltTotalPeso <> 0) Then
          fltPerCorFrete := fGetPesoItem(Itens[intItem]) / fltTotalPeso
        Else
          fltPerCorFrete := Itens[intItem].fltTotIte / fltTotalItens;
      End;

      If fConsiderarItemNoRateioDeDesconto(Itens[intItem]) Then
        fltPerCorDesEsp := Itens[intItem].fltTotIte / fltTotIteDesEsp
      Else
        fltPerCorDesEsp := 0;

      {***********************************}
      {* CALCULA O VALOR FRETE E O TOTAL *}
      {******************************JC***}
      If (Self.blnUsaTotFreExpCalc) And (Self.fltFreAnt = Self.fltValFre) Then
        fltTmpFrete := Itens[intItem].fltValFreExp
      Else
        fltTmpFrete := fFormataFloat(Self.fltValFre * fltPerCorFrete, 2);
      fltTotFrete := fltTotFrete + fltTmpFrete;

      {********************************************}
      {* CALCULA O VALOR FRETE SUGERIDO E O TOTAL *}
      {***************************************JC***}
      fltTmpFreSug := fFormataFloat(Self.fltFreSug * fltPerCorFrete, 2);
      fltTotFreSug := fltTotFreSug + fltTmpFreSug;

      {********************************************}
      {* CALCULA O VALOR FRETE COTADO E O TOTAL   *}
      {********************************************}
      if (strOpcDoc <> 'DV') then
        fltTmpFreCot := fFormataFloat(Self.fltFreCot * fltPerCorFrete, 2)
      else
      begin
        fltTmpFreCot := Itens[intItem].fltFreCot;
        Self.fltFreCot := Self.fltFreCot + fltTmpFreCot;
      end;

      fltTotFreCot := fltTotFreCot + fltTmpFreCot;

      {******************************************}
      {* CALCULA O VALOR FRETE RATEIO E O TOTAL *}
      {*************************************JC***}
      fltTmpFreRat := IIF(FManterFreteRateadoItens, Itens[intItem].fltFreRatOri, fFormataFloat(Self.fltFreRat * fltPerCorFrete, 2));
      fltTotFreRat := fltTotFreRat + fltTmpFreRat;

      {**********************************************}
      {* CALCULA O VALOR DA TAXA DE ENTREGA E TOTAL *}
      {******************************************JC**}
      fltTmpTaxEnt := fFormataFloat(Self.fltTaxEnt * fltPerCorTaxEnt, 2);
      fltTotTaxEnt := fltTotTaxEnt + fltTmpTaxEnt;

      {*****************************************}
      {* CALCULA O VALOR DESP.ACESS. E O TOTAL *}
      {************************************JC***}
      If (Self.blnUsaDesAceExpCalc) And (Self.fltAceAnt = Self.fltDesAce) Then
        fltTmpDesAces := Itens[intItem].fltDesAceExp
      Else
        fltTmpDesAces := fFormataFloat(Self.fltDesAce * fltPerCorDesAces, 2);
      fltTotDesAces := fltTotDesAces + fltTmpDesAces;

      {*******************************************}
      {* CALCULA O VALOR DESC.ESPECIAL E O TOTAL *}
      {**************************************JC***}
      If Self.blnClienteZonaFrancaComDescontoEspecial Or fEhClienteZonaFrancaSimplesNacional(Itens[intItem].strEmpIte) Then
      Begin
        fltTmpDesEsp := Itens[intItem].fltDesEspZonFra;
      End
      {********************************************************************}
      {* QUANDO FOR BAIXA DE ENTREGA FUTURA NAO DEVE REALIZAR O RATEIO DO *}
      {* DESCONTO ESPECIAL, MAS SIM PRATICAR O MESMO QUE FOI CALCULADO    *}
      {* NA VENDA (OU PROPORCIONAL A QUANTIDADE BAIXADA)                  *}
      {****************************************************************JC**}
      Else If (Self.blnUsaDesEspExpCalc) Then
      Begin
        fltTmpDesEsp := Itens[intItem].fltDesEspExp;
      End
      Else If Self.FFulfillment.EhOperacaoFulfillment And Assigned(dicDesEspItens) Then
      Begin
        fltTmpDesEsp := IfNull(dicDesEspItens[intToStr(Itens[intItem].intAutInc)], 0.00);
      End
      Else If blnBaiEntFut And Assigned(dicDesEspItens) Then
      Begin
        fltTmpDesEsp := IfNull(dicDesEspItens[intToStr(Itens[intItem].intAutInc)], 0.00);
      End
      Else If blnDevolucaoAutomaticaEntregaFutura And Assigned(dicDesEspItens) Then
      Begin
        fltTmpDesEsp := IfNull(dicDesEspItens[intToStr(Itens[intItem].intAutInc)], 0.00);
      End
      Else If blnImportacaoSpedPisCofins And Assigned(dicDesEspItens) Then
      Begin
        fltTmpDesEsp := IfNull(dicDesEspItens[intToStr(Itens[intItem].intAutInc)], 0.00);
      End
      Else
        fltTmpDesEsp := fFormataFloat((Self.fltDesEsp - Self.fltDesOrg) * fltPerCorDesEsp, 2);

      fltTotDesEsp := fltTotDesEsp + fltTmpDesEsp;

      {***********************************************************}
      {* CALCULA O VALOR DO DESC.ESPECIAL DE DEVOLUÇÃO E O TOTAL *}
      {********************************************************JC*}
      fltTmpDeDVCf := fFormataFloat(Self.fltDeDVCf * fltPerCor, 2);
      fltTotDeDVCf := fltTotDeDVCf + fltTmpDeDVCf;

      {**********************************}
      {* ATUALIZA OS VALORES DO PRODUTO *}
      {*****************************JC***}
      pAtualizaRegistroItem;
    End;

    fltTmpFrete   := 0.0;
    fltTmpFreSug  := 0.0;
    fltTmpFreRat  := 0.0;
    fltTmpTaxEnt  := 0.0;
    fltTmpDesAces := 0.0;
    fltTmpDesEsp  := 0.0;
    fltTmpDeDVCf  := 0.0;
    fltTmpFreCot  := 0.0;

    {******************************************************}
    {* VERIFICA DIFERENCA DO TOTAL DO RATEIO E O ORIGINAL *}
    {**************************************************JC**}
    If (fFormataFloat(fltTotFrete, 4) <> fFormataFloat(Self.fltValFre, 4)) Then
      fltTmpFrete := fFormataFloat(Self.fltValFre - fltTotFrete, 4);

    If (fFormataFloat(fltTotFreSug, 4) <> fFormataFloat(Self.fltFreSug, 4)) Then
      fltTmpFreSug := fFormataFloat(Self.fltFreSug - fltTotFreSug, 4);

    If (fFormataFloat(fltTotFreCot, 4) <> fFormataFloat(Self.fltFreCot, 4)) Then
      fltTmpFreCot := fFormataFloat(Self.fltFreCot - fltTotFreCot, 4);

    If (fFormataFloat(fltTotFreRat, 4) <> fFormataFloat(Self.fltFreRat, 4)) Then
      fltTmpFreRat := fFormataFloat(Self.fltFreRat - fltTotFreRat, 4);

    If (fFormataFloat(fltTotTaxEnt, 4) <> fFormataFloat(Self.fltTaxEnt, 4)) And blnAplicaTaxaEntrega Then
      fltTmpTaxEnt := Self.fltTaxEnt - fltTotTaxEnt;

    If (fFormataFloat(fltTotDesAces, 4) <> fFormataFloat(Self.fltDesAce, 4)) Then
      fltTmpDesAces := Self.fltDesAce - fltTotDesAces;

    If (Not (blnBaiEntFut And Assigned(dicDesEspItens))) And
       (Not (blnDevolucaoAutomaticaEntregaFutura And Assigned(dicDesEspItens))) Then
    Begin
      If fFormataFloat(fltTotDesEsp, VS_intDecUni) <> fFormataFloat((Self.fltDesEsp - Self.fltDesOrg), VS_intDecUni) Then
        fltTmpDesEsp := fFormataFloat(((Self.fltDesEsp - Self.fltDesOrg) - fltTotDesEsp), VS_intDecUni);
    End;

    If (fltTotDeDVCf <> Self.fltDeDVCf) Then
      fltTmpDeDVCf := Self.fltDeDVCf - fltTotDeDVCf;

    {*********************************************************}
    {* JOGA A DIFERENCA NO PRIMEIRO ITEM DE VENDA ENCONTRADO *}
    {*****************************************************JC**}
    If (fTemRateio) Then
    Begin
      If blnRateiaFreteDespAcessoriaSomenteItensNotaNormal Then
      Begin
        If fTemRateioFrete Then
        Begin
          For intItem := 0 To Length(Itens) -1 Do
          Begin
            If (fItemEntraRateio(Itens[intItem]) And (Not Itens[intItem].blnMeiaNotaFatorExpedicao)) Then
            Begin
              pDistribuiADiferencaDoRateioItens(Itens[intItem].fltValFre, fltTmpFrete);
              pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreSug, fltTmpFreSug);
              pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreCot, fltTmpFreCot);
            End;
          End;
        End;
      End
      Else If blnRateiaFreSomItensEnt And fTemRateioFrete Then
      Begin
        For intItem := 0 To Length(Itens) -1 Do
        Begin
          If (fItemEntrega(Itens[intItem])) Then
          Begin
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltValFre, fltTmpFrete);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreSug, fltTmpFreSug);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreRat, fltTmpFreRat);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreCot, fltTmpFreCot);
          End;
        End;
      End;

      If fTemRateioDespAcessoria Then
      Begin
        For intItem := 0 To Length(Itens) -1 Do
        Begin
          If (fItemEntraRateio(Itens[intItem])) Then
          Begin
            If (blnRateiaFreSomItensEnt and (fItemEntrega(Itens[intItem]))) or (not blnRateiaFreSomItensEnt) Then
              pDistribuiADiferencaDoRateioItens(Itens[intItem].fltDesAce, fltTmpDesAces);
          End;
        End;
      End;

      intExecRat := 0;
      While (fTemRateio) Do
      Begin

        Inc(intExecRat);

        For intItem := 0 To Length(Itens) -1 Do
        Begin
          If Not fItemEntraRateio(Itens[intItem]) Then
            Continue;

          If (fItemEntrega(Itens[intItem])) Then
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltTaxEnt, fltTmpTaxEnt);

          {************************************************************}
          {* VERIFICA SE COM O RATEIO O ITEM NÃO VAI FICAR NEGATIVO,  *}
          {* TENTA FAZER O RATEIO NO MINIMO DUAS VEZES, E NA SEGUNDA, *}
          {* IGNORANDO A CONDIÇÃO INTEIRA.                            *}
          {*********************************************************RN*}
          If (fConsiderarItemNoRateioDeDesconto(Itens[intItem]) And
             (fPermiteRatearItem(Itens[intItem].fltTotIte, (fltTmpDesEsp + Itens[intItem].fltDesEsp)))) Or
             (intExecRat > 1)  Then
          Begin
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltValFre, fltTmpFrete);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreSug, fltTmpFreSug);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreRat, fltTmpFreRat);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltDesAce, fltTmpDesAces);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltDeDVCf, fltTmpDeDVCf);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltDesEsp, fltTmpDesEsp);
            pDistribuiADiferencaDoRateioItens(Itens[intItem].fltFreCot, fltTmpFreCot);
          End;

        End;

        If (intExecRat >= 2) Then
          Break;
      End;

    End;

    If (Not (blnBaiEntFut And Assigned(dicDesEspItens))) And
       (Not (blnDevolucaoAutomaticaEntregaFutura And Assigned(dicDesEspItens))) Then
    Begin
      fltTmpDesEsp := 0.00;
      //Soma ao desconto especial do item o valor do icms dado
      //como desconto para orgao publico, o desconto especial de
      //orgao publico é aplicado somente nos produtos tributados
      For intItem := 0 To Length(Itens) -1 Do
      Begin
        Itens[intItem].fltDesEsp := Itens[intItem].fltDesEsp + Itens[intItem].fltDesOrg;
        fltTmpDesEsp := fltTmpDesEsp + Itens[intItem].fltDesEsp;
      End;

      //Verificação por segurança, caso ocorra alguma falha na lógica do rateio
      //não deve permitir gravar o documento com o desconto especial com divergencia
      If fFormataFloat(fltTmpDesEsp, 2) <> fFormataFloat(Self.fltDesEsp, 2) Then
        Raise Exception.Create('Ocorreu algum problema durante o rateio do desconto ' +
          'especial nos produtos: O Somatório dos produtos diverge do valor total do desconto.');
    End;

    If fExisteIpiComoDespesaAcessoria Then
    Begin
      fltTotalItens := 0;

      For intItem := 0 To Length(Itens) -1 Do
      Begin
        If Not fItemEntraRateio(Itens[intItem]) Then
          Continue;

        Itens[intItem].fltDesAce := 0;

        If (Itens[intItem].fltCfvIpi = 0) Then
          Continue;

        fltTotalItens := fltTotalItens + Itens[intItem].fltTotIte;
      End;

      fltTotDesAces := 0;

      For intItem := 0 To Length(Itens) -1 Do
      Begin
        If Not fItemEntraRateio(Itens[intItem]) Then
          Continue;

        If (Itens[intItem].fltCfvIpi = 0) Then
          Continue;

        fltPerCorDesAces := Itens[intItem].fltTotIte / fltTotalItens;

        Itens[intItem].fltDesAce := fFormataFloat(Self.fltDesAce * fltPerCorDesAces, 2);
        fltTotDesAces := fltTotDesAces + Itens[intItem].fltDesAce;
      End;

      If (fFormataFloat(fltTotDesAces, 4) <> fFormataFloat(Self.fltDesAce, 4)) Then
        fltTmpDesAces := Self.fltDesAce - fltTotDesAces;

      If fTemRateioDespAcessoria Then
      Begin
        For intItem := 0 To Length(Itens) -1 Do
        Begin
          If (Itens[intItem].fltCfvIpi = 0) Then
            Continue;
          If (fFormataFloat(Itens[intItem].fltDesAce, 2) = 0) Then
            Continue;
          pDistribuiADiferencaDoRateioItens(Itens[intItem].fltDesAce, fltTmpDesAces);
        End;
      End;

    End;
  Finally
    If blnMoveu Then
    Begin
      pOrdenaArray(Itens, tOrdIntAutInc, blnMoveu);
    End;
  End;
end;

procedure TFatVendaBase.pDefineValoresItemServico(Var item: TDadosFechamento);
begin
  If Not fCfgSis('AUTCEN', VarBoolean) Then
  Begin
    item.fltUniOri := fltTotSer;
    item.fltUniVis := fltTotSer;
    item.fltTaxJur := 0;
    item.fltUniDig := fltTotSer;
    item.fltUnitar := fltTotSer;
    item.fltTotIte := fltTotSer;
    item.fltVlrCon := fltTotSer;
    item.fltTotCus := 0;
    item.fltTotCu2 := 0;
  End
  Else
  Begin
    If (fCfgSis('ITESER') = fCfgSis('SERTER')) Then
    Begin
      item.fltUniOri := fltTotSer;
      item.fltUniVis := fltTotSer;
      item.fltTaxJur := 0;
      item.fltUniDig := fltTotSer;
      item.fltUnitar := fltTotSer;
      item.fltTotIte := fltTotSer;
      item.fltVlrCon := fltTotSer;
      item.fltTotCus := fGetCustoServTerc;
      item.fltTotCu2 := fGetCustoServTerc;
    End
    Else
    Begin
      If item.strCodIte = fCfgSis('ITESER') Then
      Begin
        item.fltUniOri := fGetTotalServNaoTerc;
        item.fltUniVis := fGetTotalServNaoTerc;
        item.fltTaxJur := 0;
        item.fltUniDig := fGetTotalServNaoTerc;
        item.fltUnitar := fGetTotalServNaoTerc;
        item.fltTotIte := fGetTotalServNaoTerc;
        item.fltVlrCon := fGetTotalServNaoTerc;
        item.fltTotCus := fGetCustoServNaoTerc;
        item.fltTotCu2 := fGetCustoServNaoTerc;
      End
      Else If item.strCodIte = fCfgSis('SERTER') Then
      Begin
        item.fltUniOri := fGetTotalServTerc;
        item.fltUniVis := fGetTotalServTerc;
        item.fltTaxJur := 0;
        item.fltUniDig := fGetTotalServTerc;
        item.fltUnitar := fGetTotalServTerc;
        item.fltTotIte := fGetTotalServTerc;
        item.fltVlrCon := fGetTotalServTerc;
        item.fltTotCus := fGetCustoServTerc;
        item.fltTotCu2 := fGetCustoServTerc;
      End;
    End;
  End;
end;

