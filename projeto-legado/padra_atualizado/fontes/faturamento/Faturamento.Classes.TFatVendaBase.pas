function TFatVendaBase.fGetTotalServNaoTerc(strIdent: String = 'T'): Double;
  Var
    intIndSer: Integer;
    strCodSer: String;
    fltValSer: Double;
begin
  Result := 0;

  For intIndSer := 1 To 30 Do
  Begin
    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intToStr(intIndSer), 2));
    fltValSer := GetPropValue(Self, 'fltValS' + fStrZero(intToStr(intIndSer), 2));

    If fEmptyStr(strCodSer) Then
      Continue;

    If Not fEhServicoTerceirizado(strCodSer) Then
    Begin
      If strIdent = 'T' Then
      Begin
        If fUsaRateioDeServicos Then
        Begin
          If GetPropValue(Self, 'strIdeS' + fStrZero(intToStr(intIndSer), 2)) = 'S' Then
            Result := Result + fltValSer;
        End
        Else
          Result := Result + fltValSer
      End
      Else
      Begin
        If GetPropValue(Self, 'strIdeS' + fStrZero(intToStr(intIndSer), 2)) = strIdent Then
          Result := Result + fltValSer;
      End;
    End;
  End;

end;

