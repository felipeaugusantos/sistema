end;

procedure TFatVendaBase.pDefinirAutIncItemLogLib(strCodIte: String; intAutInc: Integer);
  Var
    intContador: Integer;
begin
  For intContador := Low(arrLogLib) To High(arrLogLib) Do
  Begin
    If (arrLogLib[intContador].strCodIte = strCodIte) And
       (arrLogLib[intContador].intAutInc <= 0)        Then
    Begin
      arrLogLib[intContador].intAutInc := intAutInc;
    End;
  End;

  For intContador := Low(arrLogAvi) To High(arrLogAvi) Do
  Begin
    If (arrLogAvi[intContador].strCodIte = strCodIte) And
       (arrLogAvi[intContador].intAutInc <= 0)        Then
    Begin
      arrLogAvi[intContador].intAutInc := intAutInc;
    End;
  End;
end;

procedure TFatVendaBase.pAcrescentaInformacoesAdicionaisNaMargem(cdsDados, cdsVendaOri: TUniClientDataSet);
var
  strExMaF4: String;

  function fMargemProduto(strProduto, strEmpresa, strTabela: String): Double;
  begin
    Result := fIteGer(strProduto, strEmpresa).FieldByName('ITE_MARBR' + strTabela).AsFloat;
  end;

begin
  strExMaF4 := fPadR(fCfgSis('EXMAF4'), 10);

  If ((fCfgSis('MARMKP') = '3') And (fCfgSis('EMKPF4', varString) = 'S')) Or ((Not fEmptyStr(strExMaF4)) And (Length(strExMaF4) >= 9) And (strExMaF4[9] = 'S')) Then
  Begin
    cdsDados.FieldByName('ITE_MKPPRO').AsFloat := fMargemProduto(cdsDados.FieldByName('ITE_CODITE').AsString,
                                                                 IIF(blnEnt_CD, strEmp_CD, VS_strCodEmp),
                                                                 cdsVendaOri.FieldByName('ITE_TABPRE').AsString);

    cdsDados.FieldByName('ITE_INDPRO').AsFloat := cdsDados.FieldByName('ITE_DESOPE').AsFloat +
                                                  cdsDados.FieldByName('ITE_IMPFED').AsFloat +
                                                  cdsDados.FieldByName('ITE_ICMCAL').AsFloat +
                                                  cdsDados.FieldByName('ITE_VDIFAL').AsFloat +
                                                  cdsDados.FieldByName('ITE_VALFCP').AsFloat ;

    cdsDados.FieldByName('ITE_ENCPRO').AsFloat := cdsDados.FieldByName('ITE_INDPRO').AsFloat +
                                                  cdsVendaOri.FieldByName('ITE_COMTBL').AsFloat;

  End;
end;

procedure TFatVendaBase.pCalculaTotaisMargemLucro(cdsData               : OleVariant;
                                                  Var
                                                  recTotMarLuc          : TRecTotaisMargemLucro;
                                                  fltDesEspecial        : Double  = 0;
                                                  blnParaEfeitoDeTravas : Boolean = False;
                                                  intAutIncCalcMar      : Integer = -1;
                                                  aIntDecUni            : Integer = 0;
                                                  blnIgnoraItensServico : Boolean = False);
  Var
    fltPraNum: Double;
    fltPraNumSemDesOpe: Double;
    fltMedNum: Double;
    fltImpNum: Double;
    fltProNum: Double;
    fltIdeNum: Double;
    fltC17Num: Double;

    fltTotPreUlt: Double;
    cdsItens: TUniClientDataSet;
    strMarPra: String;
    strMarMkp: String;
    strAux   : String;
    intDecUni: Integer;
    blnIteSai: Boolean;
begin
  strMarPra := fCfgSis('MARPRA');
  strMarMkp := fMarMpkParaVenda(fCfgSis('MARMKP'));
  If (aIntDecUni <> 0) Then
    intDecUni := aIntDecUni
  Else
    intDecUni := fCfgSis('DECUNI', varInteger);

  If (strMarMkp = '1') Or (strMarMkp = '2')  Then
    strAux := '_MAR'
  Else
    strAux := '_MKP';

  cdsItens := TUniClientDataSet.Create(Self);
  cdsItens.Data := cdsData;
  cdsItens.LogChanges := False;

  fltTotPreUlt  := 0;

  fltPraNum := 0;
  fltPraNumSemDesOpe := 0;
  fltMedNum := 0;
  fltImpNum := 0;
  fltProNum := 0;
  fltIdeNum := 0;
  fltC17Num := 0;
  FillChar(recTotMarLuc, SizeOf(recTotMarLuc), #0);
  Self.fltTotUniOri := 0.0;
  blnIteSai := False;

  With cdsItens Do
  Begin

    First;

    While (Not Eof) Do
    Begin

      If (blnParaEfeitoDeTravas) Then
      Begin

        If Not fExecutarValidacaoMargemCondPagto_ItemAItem(FieldByName('ITE_CODITE').AsString, fGetEmpPrecoPromoItem(FieldByName('ITE_EMPITE').AsString)) Then
        Begin
          Next;
          Continue;
        End;

      End;

      If blnIgnoraItensServico Then
      Begin
        If fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
        Begin
          Next;
          Continue;
        End;
      End;

      If Not ((SameText(strOpcDoc, 'TR')) And (SameText(FieldByName('ITE_ENTSAI').AsString, 'E'))) Then
      Begin
        If Not fEmptyStr(FieldByName('ITE_CODITE').AsString) Then
        Begin
          If (recTotMarLuc.strTemItensVenda = '') Then
          Begin
            If (Not fEhItemServico(FieldByName('ITE_CODITE').AsString)) Then
              recTotMarLuc.strTemItensVenda := 'S';
          End;

          fltTotUniOri := fltTotUniOri + (fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          fltTotPreUlt := fltTotPreUlt + (fFormataFloat(FieldByName('ITE_PREULT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          recTotMarLuc.fltTotQtdIte := recTotMarLuc.fltTotQtdIte + FieldByName('ITE_QTDITE').AsFloat;

          recTotMarLuc.fltTotPreUlt := recTotMarLuc.fltTotPreUlt + (fFormataFloat(FieldByName('ITE_PREULT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotUniOri := recTotMarLuc.fltTotUniOri + (fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotUniDig := recTotMarLuc.fltTotUniDig + (fFormataFloat(FieldByName('ITE_UNIDIG').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotUnitar := recTotMarLuc.fltTotUnitar + (fFormataFloat(FieldByName('ITE_UNITAR').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusto  := recTotMarLuc.fltTotCusto  + (fFormataFloat(FieldByName('ITE_PRECUS').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusto2 := recTotMarLuc.fltTotCusto2 + (fFormataFloat(FieldByName('ITE_PRECU2').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusIte := recTotMarLuc.fltTotCusIte + (fFormataFloat(FieldByName('ITE_CUSITE').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotMedio  := recTotMarLuc.fltTotMedio  + (fFormataFloat(FieldByName('ITE_PREMED').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusImp := recTotMarLuc.fltTotCusImp + (fFormataFloat(FieldByName('ITE_CUSIMP').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotImpUlt := recTotMarLuc.fltTotImpUlt + (fFormataFloat(FieldByName('ITE_IMPULT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotMedLiq := recTotMarLuc.fltTotMedLiq + (fFormataFloat(FieldByName('ITE_PREMED_LIQ').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          If (fCfgSis('MCAT17') = 'S') Then
          Begin
            If (FieldByName('ITE_CUSCAT').AsFloat = 0) Then
            Begin
              recTotMarLuc.fltTotVCat17 := recTotMarLuc.fltTotVCat17 + (fFormataFloat(FieldByName('ITE_PRECU2').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
            End
            Else
            Begin
              recTotMarLuc.fltTotVCat17 := recTotMarLuc.fltTotVCat17 + (fFormataFloat(FieldByName('ITE_PRECU2').AsFloat - (FieldByName('ITE_CUSITE').AsFloat-FieldByName('ITE_CUSCAT').AsFloat), intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
            End;
          End
          Else
          Begin
            recTotMarLuc.fltTotVCat17 := recTotMarLuc.fltTotVCat17 + (fFormataFloat(FieldByName('ITE_CUSCAT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          End;

          recTotMarLuc.fltTotPreUltLiq := recTotMarLuc.fltTotPreUltLiq + (fFormataFloat(FieldByName('ITE_PREULT_LIQ').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusReaMZr := recTotMarLuc.fltTotCusReaMZr + (fFormataFloat(FieldByName('ITE_CUMAZR').AsFloat,     intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          blnIteSai := True;

          If (FindField('ITE_PREIDE') <> Nil) Then
            recTotMarLuc.fltTotPreIde := recTotMarLuc.fltTotPreIde + (fFormataFloat(FieldByName('ITE_PREIDE').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          fltPraNum := fltPraNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRANUM' + strAux).AsFloat;
          fltPraNumSemDesOpe := fltPraNumSemDesOpe + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRANUM' + strAux + '_SDO').AsFloat;
          fltMedNum := fltMedNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_MEDNUM' + strAux).AsFloat;
          fltImpNum := fltImpNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_IMPNUM' + strAux).AsFloat;
          fltProNum := fltProNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRONUM' + strAux).AsFloat;

          If FindField('ITE_IDENUM_MAR') <> Nil Then
            fltIdeNum := fltIdeNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_IDENUM_MAR').AsFloat;

          If FindField('ITE_C17NUM_MAR') <> Nil Then
            fltC17Num := fltC17Num + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_C17NUM_MAR').AsFloat;

          if (FindField('ITE_PRETAB') <> Nil) then
            recTotMarLuc.fltTotPreTab := recTotMarLuc.fltTotPreTab + (fFormataFloat(FieldByName('ITE_PRETAB').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          if (FindField('ITE_PREORI') <> Nil) then
            recTotMarLuc.fltTotPreOri := recTotMarLuc.fltTotPreOri + (fFormataFloat(FieldByName('ITE_PREORI').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          if (FindField('AUTOINCREM') <> Nil) And (FindField('ITE_MKPPRO') <> Nil) then
            if (FieldByName('AUTOINCREM').AsInteger = intAutIncCalcMar) then
              recTotMarLuc.fltMargemDoCadastro := FieldByName('ITE_MKPPRO').AsFloat;
        End;

      End;

      Next;
    End;
    If (fltDesEspecial <> 0) Then
    Begin
      fltPraNum := fltPraNum - fltDesEspecial;
      fltPraNumSemDesOpe := fltPraNumSemDesOpe - fltDesEspecial;
      fltMedNum := fltMedNum - fltDesEspecial;
      fltImpNum := fltImpNum - fltDesEspecial;
      fltC17Num := fltC17Num - fltDesEspecial;
      recTotMarLuc.fltTotUnitar := recTotMarLuc.fltTotUnitar - fltDesEspecial;
    End;

    If (strMarMkp = '1') Or (strMarMkp = '2')  Then
    Begin
      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarPrat := (fltPraNum / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarPrat := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarPratSemDesOpe := (fltPraNumSemDesOpe / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarPratSemDesOpe := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarMedio := (fltMedNum / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarMedio := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarImpUlt := (fltImpNum / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarImpUlt := 0;

      If recTotMarLuc.fltTotUniOri <> 0 Then
        recTotMarLuc.fltTotMarItem := (fltProNum / recTotMarLuc.fltTotUniOri) * 100
      Else
        recTotMarLuc.fltTotMarItem  := 0;

      If recTotMarLuc.fltTotPreIde <> 0 Then
        recTotMarLuc.fltTotMarIde := (fltIdeNum / recTotMarLuc.fltTotPreIde) * 100
      Else
        recTotMarLuc.fltTotMarIde := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMCat17 := (fltC17Num / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMCat17 := 0;
    End
    Else
    Begin
      If (strMarMkp = '4') Then
      Begin
        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPrat := ((fltPraNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPrat := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPratSemDesOpe := ((fltPraNumSemDesOpe / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPratSemDesOpe := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarItem := ((fltProNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarItem  := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPra_PRECUS := ((fltPraNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPra_PRECUS := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPro_PRECUS := ((fltProNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPro_PRECUS := 0;

        If (recTotMarLuc.fltTotMedio <> 0) Then
          recTotMarLuc.fltTotMarLiq_PREMED := ((fltMedNum / recTotMarLuc.fltTotMedio) - 1) * 100
        Else
          recTotMarLuc.fltTotMarLiq_PREMED := 0;

        If (recTotMarLuc.fltTotPreUlt <> 0) Then
          recTotMarLuc.fltTotMarLiq_PREULT := ((fltMedNum / recTotMarLuc.fltTotPreUlt) - 1) * 100
        Else
          recTotMarLuc.fltTotMarLiq_PREULT := 0;

        If (recTotMarLuc.fltTotImpUlt <> 0) Then
          recTotMarLuc.fltTotMarLiq_IMPULT := ((fltMedNum / recTotMarLuc.fltTotImpUlt) - 1) * 100
        Else
          recTotMarLuc.fltTotMarLiq_IMPULT := 0;
      End

      Else If (strMarMkp = '5') Then
      Begin
        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarPrat := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotCusto) / recTotMarLuc.fltTotUnitar) * 100)
       Else
          recTotMarLuc.fltTotMarPrat := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarPratSemDesOpe := (((recTotMarLuc.fltTotUnitar - fltPraNumSemDesOpe) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarPratSemDesOpe := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarMedio := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotMedLiq) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarMedio := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarLiq_IMPULT := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotCusImp) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarLiq_IMPULT := 0;

        If (recTotMarLuc.fltTotPreUlt <> 0) Then
          recTotMarLuc.fltTotMarLiq_PREULT := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotPreUlt) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarLiq_PREULT := 0;

        If recTotMarLuc.fltTotUniOri <> 0 Then
          recTotMarLuc.fltTotMarBru_PREMED := (((recTotMarLuc.fltTotUniOri - fltMedNum) / recTotMarLuc.fltTotUniOri) * 100)
        Else
          recTotMarLuc.fltTotMarBru_PREMED  := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMePrBr := (((recTotMarLuc.fltTotUnitar - fltMedNum) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMePrBr := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMrPrBr := (((recTotMarLuc.fltTotUnitar - fltProNum) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMrPrBr := 0;

        If recTotMarLuc.fltTotUniOri <> 0 Then
          recTotMarLuc.fltTotMarItem := (((recTotMarLuc.fltTotUniOri - fltProNum) / recTotMarLuc.fltTotUniOri) * 100)
        Else
          recTotMarLuc.fltTotMarItem  := 0;

        If recTotMarLuc.fltTotPreIde <> 0 Then
          recTotMarLuc.fltTotMarIde := (((recTotMarLuc.fltTotPreIde - recTotMarLuc.fltTotCusReaMZr) / recTotMarLuc.fltTotPreIde) * 100)
        Else
          recTotMarLuc.fltTotMarIde := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMCat17 := (((recTotMarLuc.fltTotUnitar - fltC17Num) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMCat17 := 0;
      End

      Else
      Begin
        If fltPraNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarPrat := (recTotMarLuc.fltTotUnitar / fltPraNum) * 100;
          recTotMarLuc.fltTotMarPrat := recTotMarLuc.fltTotMarPrat - 100;
        End
        Else
          recTotMarLuc.fltTotMarPrat := 0;

        If fltPraNumSemDesOpe <> 0 Then
        Begin
          recTotMarLuc.fltTotMarPratSemDesOpe := (recTotMarLuc.fltTotUnitar / fltPraNumSemDesOpe) * 100;
          recTotMarLuc.fltTotMarPratSemDesOpe := recTotMarLuc.fltTotMarPratSemDesOpe - 100;
        End
        Else
          recTotMarLuc.fltTotMarPratSemDesOpe := 0;

        If fltProNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarItem := (recTotMarLuc.fltTotUniOri / fltProNum) * 100;
          recTotMarLuc.fltTotMarItem := recTotMarLuc.fltTotMarItem - 100;
        End
        Else
          recTotMarLuc.fltTotMarItem  := 0;
      End;

      If (strMarMkp <> '5') Then
      Begin
        If fltMedNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarMedio := (recTotMarLuc.fltTotUnitar / fltMedNum) * 100;
          recTotMarLuc.fltTotMarMedio := recTotMarLuc.fltTotMarMedio - 100;
        End Else
          recTotMarLuc.fltTotMarMedio := 0;

        If fltImpNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarImpUlt := (recTotMarLuc.fltTotUnitar / fltImpNum) * 100;
          recTotMarLuc.fltTotMarImpUlt := recTotMarLuc.fltTotMarImpUlt - 100;
        End Else
          recTotMarLuc.fltTotMarImpUlt := 0;

        If fltIdeNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarIde := (recTotMarLuc.fltTotPreIde / fltIdeNum) * 100;
          recTotMarLuc.fltTotMarIde := recTotMarLuc.fltTotPreIde - 100;
        End Else
          recTotMarLuc.fltTotMarIde := 0;

        If fltC17Num <> 0 Then
        Begin
          recTotMarLuc.fltTotMCat17 := (recTotMarLuc.fltTotUnitar / fltC17Num) * 100;
          recTotMarLuc.fltTotMCat17 := recTotMarLuc.fltTotMCat17 - 100;
        End Else
          recTotMarLuc.fltTotMCat17 := 0;
      End;
    End;

    If strMarPra = '2' Then
    Begin
      If (strMarMkp = '1') Or (strMarMkp = '2') Then
      Begin
        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarPrat := (fltTotPreUlt / recTotMarLuc.fltTotUnitar) * 100
        Else
          recTotMarLuc.fltTotMarPrat := 0;
      End
      Else
      Begin
        If fltTotPreUlt <> 0 Then
          recTotMarLuc.fltTotMarPrat := ((recTotMarLuc.fltTotUnitar / fltTotPreUlt) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPrat := 0;
      End;
    End;

    With recTotMarLuc Do
    Begin
      If strMarMkp = '2' Then
      Begin
        fltTotMarPrat   := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarPrat);
        fltTotMarMedio  := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarMedio);
        fltTotMarImpUlt := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarImpUlt);
        fltTotMarItem   := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarItem);
      End;
    End;

    recTotMarLuc.fltTotMarMedio  := fFormataFloat(recTotMarLuc.fltTotMarMedio, 2);
    recTotMarLuc.fltTotMarImpUlt := fFormataFloat(recTotMarLuc.fltTotMarImpUlt, 2);
    recTotMarLuc.fltTotMarPrat   := fFormataFloat(recTotMarLuc.fltTotMarPrat, 2);
    recTotMarLuc.fltTotMarItem   := fFormataFloat(recTotMarLuc.fltTotMarItem, 2);
    recTotMarLuc.fltTotMrPrBr    := fFormataFloat(recTotMarLuc.fltTotMrPrBr, 2);
    recTotMarLuc.fltTotMePrBr    := fFormataFloat(recTotMarLuc.fltTotMePrBr, 2);
  End;

  recTotMarLuc.blnSomenteItemEntrada := False;

  If (Not cdsItens.IsEmpty) And (Not blnIteSai) Then
    recTotMarLuc.blnSomenteItemEntrada := True;

  If strMarMkp <> '4' Then
  begin
    recTotMarLuc.fltTotMarPro_PRECUS := recTotMarLuc.fltTotMarItem;
    recTotMarLuc.fltTotMarPra_PRECUS := recTotMarLuc.fltTotMarPrat;
    recTotMarLuc.fltTotMrPrBr_PRECUS := recTotMarLuc.fltTotMrPrBr;
    recTotMarLuc.fltTotMePrBr_PREMED := recTotMarLuc.fltTotMePrBr;
    recTotMarLuc.fltTotMarLiq_PREMED := recTotMarLuc.fltTotMarMedio;

    If (strMarMkp = '5') Then
    Begin
      recTotMarLuc.fltTotMarLiq_PREULT := fFormataFloat(recTotMarLuc.fltTotMarLiq_PREULT, 2);
      recTotMarLuc.fltTotMarLiq_IMPULT := fFormataFloat(recTotMarLuc.fltTotMarLiq_IMPULT, 2);
    End
    Else
    Begin
      recTotMarLuc.fltTotMarLiq_PREULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotPreUltLiq, recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
      recTotMarLuc.fltTotMarLiq_IMPULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusImp,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
    End;
  end;

  recTotMarLuc.fltTotMarPro_CUSITE := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusIte,    recTotMarLuc.fltTotUniOri, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  recTotMarLuc.fltTotMarPra_CUSITE := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusIte,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  If (strMarMkp = '5') Then
    recTotMarLuc.fltTotMarBru_PREMED := fFormataFloat(recTotMarLuc.fltTotMarBru_PREMED, 2)
  Else
    recTotMarLuc.fltTotMarBru_PREMED := fCalculaPrecoVenda(2, recTotMarLuc.fltTotMedio,     recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  recTotMarLuc.fltTotMarBru_PREULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotPreUlt,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  recTotMarLuc.fltTotMarBru_IMPULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotImpUlt,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  If (strMarMkp = '5') Then
    recTotMarLuc.fltTotMarLiq_PREIDE := recTotMarLuc.fltTotMarIde
  Else
    recTotMarLuc.fltTotMarLiq_PREIDE := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusIte,    recTotMarLuc.fltTotPreIde, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);

  If (fCfgSis('MCAT17') = 'S') Then
  Begin
    recTotMarLuc.fltTotMarLiq_CAT_17 := fCalculaPrecoVenda(2, recTotMarLuc.fltTotVCat17,  recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  End
  Else
  Begin
    recTotMarLuc.fltTotMarLiq_CAT_17 := IIF(recTotMarLuc.fltTotVCat17 <> 0,
                                            fCalculaPrecoVenda(2, (recTotMarLuc.fltTotCusto2 - recTotMarLuc.fltTotVCat17),
                                                                   recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem ),0);
  End;

  recTotMarLuc.blnSomenteItemEntrada := ((Not cdsItens.IsEmpty) And (Not blnIteSai));
end;

procedure TFatVendaBase.pCalculaTotaisMargemLucro(cdsData               : OleVariant;
                                                  Var
                                                  recTotMarLuc          : TRecTotaisMargemLucro;
                                                  Var
                                                  fltTotMarkup: Double;
                                                  fltDesEspecial        : Double  = 0;
                                                  blnParaEfeitoDeTravas : Boolean = False;
                                                  fltDesconto           : Double = 0;
                                                  aIntDecUni            : Integer = 0;
                                                  blnIgnoraItensServico : Boolean = False);
Var
    fltPraNum: Double;
    fltPraNumSemDesOpe: Double;
    fltMedNum: Double;
    fltImpNum: Double;
    fltProNum: Double;
    fltIdeNum: Double;
    fltC17Num: Double;

    fltTotPreUlt: Double;
    cdsItens: TUniClientDataSet;
    strMarPra: String;
    strMarMkp: String;
    strAux   : String;
    intDecUni: Integer;
    blnIteSai: Boolean;

    fltPraNumMarkup: Double;
    fltPraDem: Double;
    fltTotUnitar: Double;
    fltTotPreUltMarkup: Double;
begin
  strMarPra := fCfgSis('MARPRA');
  strMarMkp := fMarMpkParaVenda(fCfgSis('MARMKP'));
  If (aIntDecUni <> 0) Then
    intDecUni := aIntDecUni
  Else
    intDecUni := fCfgSis('DECUNI', varInteger);

  If (strMarMkp = '1') Or (strMarMkp = '2')  Then
    strAux := '_MAR'
  Else
    strAux := '_MKP';

  cdsItens := TUniClientDataSet.Create(Self);
  cdsItens.Data := cdsData;
  cdsItens.LogChanges := False;

  fltTotPreUlt  := 0;

  fltPraNum := 0;
  fltPraNumSemDesOpe := 0;
  fltMedNum := 0;
  fltImpNum := 0;
  fltProNum := 0;
  fltIdeNum := 0;
  fltC17Num := 0;
  FillChar(recTotMarLuc, SizeOf(recTotMarLuc), #0);
  Self.fltTotUniOri := 0.0;
  blnIteSai := False;

  fltPraNumMarkup := 0;
  fltPraDem := 0;

  fltTotUnitar := 0.0;
  fltTotMarkup := 0.0;
  fltTotPreUltMarkup := 0.0;

  With cdsItens Do
  Begin

    First;

    While (Not Eof) Do
    Begin

      If (blnParaEfeitoDeTravas) Then
      Begin

        If Not fExecutarValidacaoMargemCondPagto_ItemAItem(FieldByName('ITE_CODITE').AsString, fGetEmpPrecoPromoItem(FieldByName('ITE_EMPITE').AsString)) Then
        Begin
          Next;
          Continue;
        End;

      End;

      If blnIgnoraItensServico Then
      Begin
        If fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
        Begin
          Next;
          Continue;
        End;
      End;

      If Not ((SameText(strOpcDoc, 'TR')) And (SameText(FieldByName('ITE_ENTSAI').AsString, 'E'))) Then
      Begin
        If Not fEmptyStr(FieldByName('ITE_CODITE').AsString) Then
        Begin
          fltTotUniOri := fltTotUniOri + (fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          fltTotPreUlt := fltTotPreUlt + (fFormataFloat(FieldByName('ITE_PREULT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);


          recTotMarLuc.fltTotQtdIte := recTotMarLuc.fltTotQtdIte + FieldByName('ITE_QTDITE').AsFloat;

          recTotMarLuc.fltTotPreUlt := recTotMarLuc.fltTotPreUlt + (fFormataFloat(FieldByName('ITE_PREULT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotUniOri := recTotMarLuc.fltTotUniOri + (fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotUniDig := recTotMarLuc.fltTotUniDig + (fFormataFloat(FieldByName('ITE_UNIDIG').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotUnitar := recTotMarLuc.fltTotUnitar + (fFormataFloat(FieldByName('ITE_UNITAR').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusto  := recTotMarLuc.fltTotCusto  + (fFormataFloat(FieldByName('ITE_PRECUS').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusto2 := recTotMarLuc.fltTotCusto2 + (fFormataFloat(FieldByName('ITE_PRECU2').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusIte := recTotMarLuc.fltTotCusIte + (fFormataFloat(FieldByName('ITE_CUSITE').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotMedio  := recTotMarLuc.fltTotMedio  + (fFormataFloat(FieldByName('ITE_PREMED').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusImp := recTotMarLuc.fltTotCusImp + (fFormataFloat(FieldByName('ITE_CUSIMP').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotImpUlt := recTotMarLuc.fltTotImpUlt + (fFormataFloat(FieldByName('ITE_IMPULT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotMedLiq := recTotMarLuc.fltTotMedLiq + (fFormataFloat(FieldByName('ITE_PREMED_LIQ').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          If (fCfgSis('MCAT17') = 'S') Then
          Begin
            If (FieldByName('ITE_CUSCAT').AsFloat = 0) Then
            Begin
              recTotMarLuc.fltTotVCat17 := recTotMarLuc.fltTotVCat17 + (fFormataFloat(FieldByName('ITE_PRECU2').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
            End
            Else
            Begin
              recTotMarLuc.fltTotVCat17 := recTotMarLuc.fltTotVCat17 + (fFormataFloat(FieldByName('ITE_PRECU2').AsFloat - (FieldByName('ITE_CUSITE').AsFloat-FieldByName('ITE_CUSCAT').AsFloat), intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
            End;
          End
          Else
          Begin
            recTotMarLuc.fltTotVCat17 := recTotMarLuc.fltTotVCat17 + (fFormataFloat(FieldByName('ITE_CUSCAT').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          End;

          recTotMarLuc.fltTotPreUltLiq := recTotMarLuc.fltTotPreUltLiq + (fFormataFloat(FieldByName('ITE_PREULT_LIQ').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
          recTotMarLuc.fltTotCusReaMZr := recTotMarLuc.fltTotCusReaMZr + (fFormataFloat(FieldByName('ITE_CUMAZR').AsFloat,     intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          blnIteSai := True;

          If (FindField('ITE_PREIDE') <> Nil) Then
            recTotMarLuc.fltTotPreIde := recTotMarLuc.fltTotPreIde + (fFormataFloat(FieldByName('ITE_PREIDE').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          fltPraNum := fltPraNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRANUM' + strAux).AsFloat;
          fltPraNumSemDesOpe := fltPraNumSemDesOpe + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRANUM' + strAux + '_SDO').AsFloat;
          fltMedNum := fltMedNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_MEDNUM' + strAux).AsFloat;
          fltImpNum := fltImpNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_IMPNUM' + strAux).AsFloat;
          fltProNum := fltProNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRONUM' + strAux).AsFloat;

          If FindField('ITE_IDENUM_MAR') <> Nil Then
            fltIdeNum := fltIdeNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_IDENUM_MAR').AsFloat;

          If FindField('ITE_C17NUM_MAR') <> Nil Then
            fltC17Num := fltC17Num + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_C17NUM_MAR').AsFloat;

          if (FindField('ITE_PRETAB') <> Nil) then
            recTotMarLuc.fltTotPreTab := recTotMarLuc.fltTotPreTab + (fFormataFloat(FieldByName('ITE_PRETAB').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);

          if (FindField('ITE_PREORI') <> Nil) then
            recTotMarLuc.fltTotPreOri := recTotMarLuc.fltTotPreOri + (fFormataFloat(FieldByName('ITE_PREORI').AsFloat, intDecUni) * FieldByName('ITE_QTDITE').AsFloat);
        End;

      End;

      If Not fEmptyStr(FieldByName('ITE_CODITE').AsString) Then
      Begin
        fltTotUnitar := fltTotUnitar + (FieldByName('ITE_UNITAR').AsFloat * FieldByName('ITE_QTDITE').AsFloat);
        fltTotPreUltMarkup := fltTotPreUltMarkup + (FieldByName('ITE_PREULT').AsFloat * FieldByName('ITE_QTDITE').AsFloat);

        fltPraDem := fltPraDem + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNITAR').AsFloat;
        fltPraNumMarkup := fltPraNumMarkup + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRANUM_MKP').AsFloat;
      End;

      Next;
    End;
    If (fltDesEspecial <> 0) Then
    Begin
      fltPraNum := fltPraNum - fltDesEspecial;
      fltPraNumSemDesOpe := fltPraNumSemDesOpe - fltDesEspecial;
      fltMedNum := fltMedNum - fltDesEspecial;
      fltImpNum := fltImpNum - fltDesEspecial;
      fltC17Num := fltC17Num - fltDesEspecial;
      recTotMarLuc.fltTotUnitar := recTotMarLuc.fltTotUnitar - fltDesEspecial;
    End;

    If (strMarMkp = '1') Or (strMarMkp = '2')  Then
    Begin
      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarPrat := (fltPraNum / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarPrat := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarPratSemDesOpe := (fltPraNumSemDesOpe / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarPratSemDesOpe := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarMedio := (fltMedNum / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarMedio := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMarImpUlt := (fltImpNum / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMarImpUlt := 0;

      If recTotMarLuc.fltTotUniOri <> 0 Then
        recTotMarLuc.fltTotMarItem := (fltProNum / recTotMarLuc.fltTotUniOri) * 100
      Else
        recTotMarLuc.fltTotMarItem  := 0;

      If recTotMarLuc.fltTotPreIde <> 0 Then
        recTotMarLuc.fltTotMarIde := (fltIdeNum / recTotMarLuc.fltTotPreIde) * 100
      Else
        recTotMarLuc.fltTotMarIde := 0;

      If recTotMarLuc.fltTotUnitar <> 0 Then
        recTotMarLuc.fltTotMCat17 := (fltC17Num / recTotMarLuc.fltTotUnitar) * 100
      Else
        recTotMarLuc.fltTotMCat17 := 0;
    End
    Else
    Begin
      If (strMarMkp = '4') Then
      Begin
        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPrat := ((fltPraNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPrat := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPratSemDesOpe := ((fltPraNumSemDesOpe / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPratSemDesOpe := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarItem := ((fltProNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarItem  := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPra_PRECUS := ((fltPraNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPra_PRECUS := 0;

        If (recTotMarLuc.fltTotCusIte <> 0) Then
          recTotMarLuc.fltTotMarPro_PRECUS := ((fltProNum / recTotMarLuc.fltTotCusIte) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPro_PRECUS := 0;

        If (recTotMarLuc.fltTotMedio <> 0) Then
          recTotMarLuc.fltTotMarLiq_PREMED := ((fltMedNum / recTotMarLuc.fltTotMedio) - 1) * 100
        Else
          recTotMarLuc.fltTotMarLiq_PREMED := 0;

        If (recTotMarLuc.fltTotPreUlt <> 0) Then
          recTotMarLuc.fltTotMarLiq_PREULT := ((fltMedNum / recTotMarLuc.fltTotPreUlt) - 1) * 100
        Else
          recTotMarLuc.fltTotMarLiq_PREULT := 0;

        If (recTotMarLuc.fltTotImpUlt <> 0) Then
          recTotMarLuc.fltTotMarLiq_IMPULT := ((fltMedNum / recTotMarLuc.fltTotImpUlt) - 1) * 100
        Else
          recTotMarLuc.fltTotMarLiq_IMPULT := 0;
      End

      Else If (strMarMkp = '5') Then
      Begin
        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarPrat := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotCusto) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarPrat := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarPratSemDesOpe := (((recTotMarLuc.fltTotUnitar - fltPraNumSemDesOpe) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarPratSemDesOpe := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarMedio := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotMedLiq) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarMedio := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarLiq_IMPULT := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotCusImp) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarLiq_IMPULT := 0;

        If (recTotMarLuc.fltTotPreUlt <> 0) Then
          recTotMarLuc.fltTotMarLiq_PREULT := (((recTotMarLuc.fltTotUnitar - recTotMarLuc.fltTotPreUlt) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMarLiq_PREULT := 0;

        If recTotMarLuc.fltTotUniOri <> 0 Then
          recTotMarLuc.fltTotMarBru_PREMED := (((recTotMarLuc.fltTotUniOri - fltMedNum) / recTotMarLuc.fltTotUniOri) * 100)
        Else
          recTotMarLuc.fltTotMarBru_PREMED  := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMePrBr := (((recTotMarLuc.fltTotUnitar - fltMedNum) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMePrBr := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMrPrBr := (((recTotMarLuc.fltTotUnitar - fltProNum) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMrPrBr := 0;

        If recTotMarLuc.fltTotUniOri <> 0 Then
          recTotMarLuc.fltTotMarItem := (((recTotMarLuc.fltTotUniOri - fltProNum) / recTotMarLuc.fltTotUniOri) * 100)
        Else
          recTotMarLuc.fltTotMarItem  := 0;

        If recTotMarLuc.fltTotPreIde <> 0 Then
          recTotMarLuc.fltTotMarIde := (((recTotMarLuc.fltTotPreIde - recTotMarLuc.fltTotCusReaMZr) / recTotMarLuc.fltTotPreIde) * 100)
        Else
          recTotMarLuc.fltTotMarIde := 0;

        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMCat17 := (((recTotMarLuc.fltTotUnitar - fltC17Num) / recTotMarLuc.fltTotUnitar) * 100)
        Else
          recTotMarLuc.fltTotMCat17 := 0;
      End

      Else
      Begin
        If fltPraNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarPrat := (recTotMarLuc.fltTotUnitar / fltPraNum) * 100;
          recTotMarLuc.fltTotMarPrat := recTotMarLuc.fltTotMarPrat - 100;
        End
        Else
          recTotMarLuc.fltTotMarPrat := 0;

        If fltPraNumSemDesOpe <> 0 Then
        Begin
          recTotMarLuc.fltTotMarPratSemDesOpe := (recTotMarLuc.fltTotUnitar / fltPraNumSemDesOpe) * 100;
          recTotMarLuc.fltTotMarPratSemDesOpe := recTotMarLuc.fltTotMarPratSemDesOpe - 100;
        End
        Else
          recTotMarLuc.fltTotMarPratSemDesOpe := 0;

        If fltProNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarItem := (recTotMarLuc.fltTotUniOri / fltProNum) * 100;
          recTotMarLuc.fltTotMarItem := recTotMarLuc.fltTotMarItem - 100;
        End
        Else
          recTotMarLuc.fltTotMarItem  := 0;
      End;

      If (strMarMkp <> '5') Then
      Begin
        If fltMedNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarMedio := (recTotMarLuc.fltTotUnitar / fltMedNum) * 100;
          recTotMarLuc.fltTotMarMedio := recTotMarLuc.fltTotMarMedio - 100;
        End Else
          recTotMarLuc.fltTotMarMedio := 0;

        If fltImpNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarImpUlt := (recTotMarLuc.fltTotUnitar / fltImpNum) * 100;
          recTotMarLuc.fltTotMarImpUlt := recTotMarLuc.fltTotMarImpUlt - 100;
        End Else
          recTotMarLuc.fltTotMarImpUlt := 0;

        If fltIdeNum <> 0 Then
        Begin
          recTotMarLuc.fltTotMarIde := (recTotMarLuc.fltTotPreIde / fltIdeNum) * 100;
          recTotMarLuc.fltTotMarIde := recTotMarLuc.fltTotPreIde - 100;
        End Else
          recTotMarLuc.fltTotMarIde := 0;

        If fltC17Num <> 0 Then
        Begin
          recTotMarLuc.fltTotMCat17 := (recTotMarLuc.fltTotUnitar / fltC17Num) * 100;
          recTotMarLuc.fltTotMCat17 := recTotMarLuc.fltTotMCat17 - 100;
        End Else
          recTotMarLuc.fltTotMCat17 := 0;
      End;
    End;

    If strMarPra = '2' Then
    Begin
      If (strMarMkp = '1') Or (strMarMkp = '2') Then
      Begin
        If recTotMarLuc.fltTotUnitar <> 0 Then
          recTotMarLuc.fltTotMarPrat := (fltTotPreUlt / recTotMarLuc.fltTotUnitar) * 100
        Else
          recTotMarLuc.fltTotMarPrat := 0;
      End
      Else
      Begin
        If fltTotPreUlt <> 0 Then
          recTotMarLuc.fltTotMarPrat := ((recTotMarLuc.fltTotUnitar / fltTotPreUlt) - 1) * 100
        Else
          recTotMarLuc.fltTotMarPrat := 0;
      End;
    End;

    With recTotMarLuc Do
    Begin
      If strMarMkp = '2' Then
      Begin
        fltTotMarPrat   := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarPrat);
        fltTotMarMedio  := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarMedio);
        fltTotMarImpUlt := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarImpUlt);
        fltTotMarItem   := untCalculoPrecoVenda.fMargemToMarkup(fltTotMarItem);
      End;
    End;

    recTotMarLuc.fltTotMarMedio  := fFormataFloat(recTotMarLuc.fltTotMarMedio, 2);
    recTotMarLuc.fltTotMarImpUlt := fFormataFloat(recTotMarLuc.fltTotMarImpUlt, 2);
    recTotMarLuc.fltTotMarPrat   := fFormataFloat(recTotMarLuc.fltTotMarPrat, 2);
    recTotMarLuc.fltTotMarItem   := fFormataFloat(recTotMarLuc.fltTotMarItem, 2);
    recTotMarLuc.fltTotMrPrBr    := fFormataFloat(recTotMarLuc.fltTotMrPrBr, 2);
    recTotMarLuc.fltTotMePrBr    := fFormataFloat(recTotMarLuc.fltTotMePrBr, 2);
  End;

  recTotMarLuc.blnSomenteItemEntrada := False;

  If (Not cdsItens.IsEmpty) And (Not blnIteSai) Then
    recTotMarLuc.blnSomenteItemEntrada := True;

  If strMarMkp <> '4' Then
  begin
    recTotMarLuc.fltTotMarPro_PRECUS := recTotMarLuc.fltTotMarItem;
    recTotMarLuc.fltTotMarPra_PRECUS := recTotMarLuc.fltTotMarPrat;
    recTotMarLuc.fltTotMrPrBr_PRECUS := recTotMarLuc.fltTotMrPrBr;
    recTotMarLuc.fltTotMePrBr_PREMED := recTotMarLuc.fltTotMePrBr;
    recTotMarLuc.fltTotMarLiq_PREMED := recTotMarLuc.fltTotMarMedio;

    If (strMarMkp = '5') Then
    Begin
      recTotMarLuc.fltTotMarLiq_PREULT := fFormataFloat(recTotMarLuc.fltTotMarLiq_PREULT, 2);
      recTotMarLuc.fltTotMarLiq_IMPULT := fFormataFloat(recTotMarLuc.fltTotMarLiq_IMPULT, 2);
    End
    Else
    Begin
      recTotMarLuc.fltTotMarLiq_PREULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotPreUltLiq, recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
      recTotMarLuc.fltTotMarLiq_IMPULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusImp,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
    End;
  end;

  recTotMarLuc.fltTotMarPro_CUSITE := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusIte,    recTotMarLuc.fltTotUniOri, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  recTotMarLuc.fltTotMarPra_CUSITE := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusIte,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  If (strMarMkp = '5') Then
    recTotMarLuc.fltTotMarBru_PREMED := fFormataFloat(recTotMarLuc.fltTotMarBru_PREMED, 2)
  Else
    recTotMarLuc.fltTotMarBru_PREMED := fCalculaPrecoVenda(2, recTotMarLuc.fltTotMedio,     recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  recTotMarLuc.fltTotMarBru_PREULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotPreUlt,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  recTotMarLuc.fltTotMarBru_IMPULT := fCalculaPrecoVenda(2, recTotMarLuc.fltTotImpUlt,    recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  If (strMarMkp = '5') Then
    recTotMarLuc.fltTotMarLiq_PREIDE := recTotMarLuc.fltTotMarIde
  Else
    recTotMarLuc.fltTotMarLiq_PREIDE := fCalculaPrecoVenda(2, recTotMarLuc.fltTotCusIte,    recTotMarLuc.fltTotPreIde, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);

  If (fCfgSis('MCAT17') = 'S') Then
  Begin
    recTotMarLuc.fltTotMarLiq_CAT_17 := fCalculaPrecoVenda(2, recTotMarLuc.fltTotVCat17,  recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  End
  Else
  Begin
    recTotMarLuc.fltTotMarLiq_CAT_17 := IIF(recTotMarLuc.fltTotVCat17 <> 0,
                                            fCalculaPrecoVenda(2, (recTotMarLuc.fltTotCusto2 - recTotMarLuc.fltTotVCat17),
                                                                   recTotMarLuc.fltTotUnitar, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem ),0);
  End;

  recTotMarLuc.blnSomenteItemEntrada := ((Not cdsItens.IsEmpty) And (Not blnIteSai));

  {**********************************************}
  {* DEDUZ O DESCONTO E O DESC. ESPECIAL PARA O *}
  {* CÁLCULO DA MARGEM DE LUCRO                 *}
  {*******************************************RV*}
  fltPraDem := fltPraDem - fltDesconto - fltDesEspecial;
  fltPraNumMarkup := fltPraNumMarkup - fltDesconto - fltDesEspecial;

  If fltPraNumMarkup <> 0 Then
  Begin
    fltTotMarkup := (fltPraDem / fltPraNumMarkup) * 100;
    fltTotMarkup := fltTotMarkup - 100;
  End Else
    fltTotMarkup := 0;

  If strMarPra = '2' Then
    If fltTotPreUltMarkup <> 0 Then
      fltTotMarkup := ((fltTotUnitar / fltTotPreUltMarkup) - 1) * 100
    Else
      fltTotMarkup := 0;

  fltTotMarkup   := fFormataFloat(fltTotMarkup, 2);

end;

procedure TFatVendaBase.pCalculaTotalMarkup(cdsData: OleVariant;
                                            Var fltTotMarkup: Double;
                                            fltDesconto   : Double = 0;
                                            fltDesEspecial: Double = 0);
  Var
    fltPraNum: Double;
    fltPraDem: Double;
    fltTotUnitar: Double;
    fltTotPreUlt: Double;

    cdsItens: TUniClientDataSet;
    strMarPra: String;
begin
  strMarPra := fCfgSis('MARPRA');

  cdsItens := TUniClientDataSet.Create(Self);
  cdsItens.Data := cdsData;
  cdsItens.LogChanges := False;

  fltPraNum := 0;
  fltPraDem := 0;

  fltTotUnitar := 0.0;
  fltTotMarkup := 0.0;
  fltTotPreUlt := 0.0;

  With cdsItens Do
  Begin
    First;

    While (Not Eof) Do
    Begin

      If Not fEmptyStr(FieldByName('ITE_CODITE').AsString) Then
      Begin
        fltTotUnitar := fltTotUnitar + (FieldByName('ITE_UNITAR').AsFloat * FieldByName('ITE_QTDITE').AsFloat);
        fltTotPreUlt := fltTotPreUlt + (FieldByName('ITE_PREULT').AsFloat * FieldByName('ITE_QTDITE').AsFloat);

        fltPraDem := fltPraDem + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNITAR').AsFloat;
        fltPraNum := fltPraNum + FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_PRANUM_MKP').AsFloat;
      End;

      Next;
    End;

    {**********************************************}
    {* DEDUZ O DESCONTO E O DESC. ESPECIAL PARA O *}
    {* CÁLCULO DA MARGEM DE LUCRO                 *}
    {*******************************************RV*}
    fltPraDem := fltPraDem - fltDesconto - fltDesEspecial;
    fltPraNum := fltPraNum - fltDesconto - fltDesEspecial;

    If fltPraNum <> 0 Then
    Begin
      fltTotMarkup := (fltPraDem / fltPraNum) * 100;
      fltTotMarkup := fltTotMarkup - 100;
    End Else
      fltTotMarkup := 0;

    If strMarPra = '2' Then
      If fltTotPreUlt <> 0 Then
        fltTotMarkup := ((fltTotUnitar / fltTotPreUlt) - 1) * 100
      Else
        fltTotMarkup := 0;

    fltTotMarkup   := fFormataFloat(fltTotMarkup, 2);
  End;
end;

procedure TFatVendaBase.pRetImpostosSubItensEstrutura(Var impSubIteEst: TImpostosSubItensEstrutura);
  Var
    qryDetMat: TUniQuery;
    fltVenTot: Double;
    fltQtdDis: Double;
    fltAlqIcmAux: Double;
    blnPromo : Boolean;
    blnParticiona: Boolean;
    strPromocAnt: String;
    strCodIteSub: String;
    fltTaxaJurosPrecoVenda : Double;
    fltUniSemJurosPrecoVenda : Double;

  function fCalculaPrecoVendaSugestaoSubItem(fltVenPre: Double): Double;
    Var
      fltPreEst: Double;
  Begin
    fltPreEst := fCalculaPrecoEstrutura(False,
                                        Preco_de_Venda,
                                        impSubIteEst.strCodIte,
                                        impSubIteEst.strEmpIte,
                                        'S',
                                        strTabPre,
                                        fltMargem);

    Result := fFormataFloat(((fltVenPre / fltPreEst) * impSubIteEst.fltUniPai), VS_intDecUni);
  End;

begin
  fltVenTot := 0.00;

  impSubIteEst.fltOutVal := 0.00;
  impSubIteEst.fltImpFed := 0.00;
  impSubIteEst.fltIcmSai := 0.00;
  impSubIteEst.fltDesOpe := 0.00;

  strPromocAnt := Self.strPromoc;

  qryDetMat := fCriaQuery;

  With qryDetMat, SQL Do
  Begin
    Clear;
    Add(fGetSQLSubItensEstruturas);

    ParamByName('CODITE').AsString := impSubIteEst.strCodIte;
    ParamByName('CODEMP').AsString := IIF(fEmptyStr(strEmp_TE), fGetEmpCalculoItem(impSubIteEst.strEmpIte), strEmp_TE);
    Open;
    First;

    SetLength(impSubIteEst.arrPrecos, RecordCount);

    While Not Eof Do
    Begin
      {**********************************************************************}
      {* O QUE FIZERES NESTE BLOCO REFERENTE A PROMOÇÃO, TERÁS QUE FAZER EM *}
      {* fCalculaPrecoEstrutura :(                                          *}
      {*******************************************************************VA*}
      If fCfgSis('SUGVLE', varInteger, GetEmpCfg(impSubIteEst.strEmpIte)) = 2 Then //2 = SUGESTÃO É A SOMA DOS PREÇOS DOS FILHOS
      Begin
        blnParticiona := False;
        blnPromo      := False;
        Self.strPromoc := 'N';

        strCodIteSub :=  FieldbyName('DMT_ITESUB').AsString;

        If (fItemPassivelDeVerificacaoPromo(strCodIteSub, fGetEmpCalculoItem(impSubIteEst.strEmpIte))) And
           (Self.fFilialPromocao) And fRetornaPrecosPromocao(strCodIteSub,
                                                             Self.strCodCli,
                                                             Self.VS_Date,
                                                             FieldbyName('DMT_QTDITE').AsFloat * impSubIteEst.fltQtdPai,
                                                             0,
                                                             0,
                                                             Self.intPrzMed,
                                                             Self.fltProPreCus,
                                                             Self.fltProPreVen,
                                                             Self.fltProComVar,
                                                             Self.fltProComAta,
                                                             Self.fltProComDis,
                                                             fltQtdDis,
                                                             fltProDesF07,
                                                             Self.strComPro,
                                                             Self.strCodPro,
                                                             blnParticiona,
                                                             blnPromo,
                                                             strTabPre,
                                                             Self.strCodCnd,
                                                             '',
                                                             '',
                                                             True,
                                                             False,
                                                             '-1',
                                                             False,
                                                             False,
                                                             '',
                                                             fGetEmpCalculoItem(impSubIteEst.strEmpIte),
                                                             strNumOrc,
                                                             strEspOrc) Then
        Begin
          If Not blnParticiona Then
          Begin
            Self.strPromoc := 'S';
          End;
        End;
        {**********************************************************************}
      End;

      fltTaxaJurosPrecoVenda := 0;
      fltUniSemJurosPrecoVenda := 0;

      impSubIteEst.arrPrecos[RecNo-1].fltQtdPro := FieldbyName('DMT_QTDITE').AsFloat * impSubIteEst.fltQtdPai;
      impSubIteEst.arrPrecos[RecNo-1].fltPreVen := fFormataFloat(fPegaPrecoVenda(qryDetMat, impSubIteEst.strEmpIte, 'S', fltMargem, False, 'NOR', strTabPre, True, fltTaxaJurosPrecoVenda, fltUniSemJurosPrecoVenda), VS_intDecUni);
      impSubIteEst.arrPrecos[RecNo-1].fltPreVenSemJuros := fltUniSemJurosPrecoVenda;

      If (impSubIteEst.fltUniPai > 0) And (fCfgSis('RATEST', varString, GetEmpCfg(impSubIteEst.strEmpIte)) = 'S') Then
        impSubIteEst.arrPrecos[RecNo-1].fltPreVen := fCalculaPrecoVendaSugestaoSubItem(impSubIteEst.arrPrecos[RecNo-1].fltPreVen);

      impSubIteEst.arrPrecos[RecNo-1].fltTotVen := fFormataFloat(impSubIteEst.arrPrecos[RecNo-1].fltPreVen * (impSubIteEst.arrPrecos[RecNo-1].fltQtdPro), 2);
      fltVenTot := fltVenTot + impSubIteEst.arrPrecos[RecNo-1].fltTotVen;

      Next;
    End;

    If fFormataFloat(fltVenTot, 2) <> fFormataFloat(impSubIteEst.fltUniPai * impSubIteEst.fltQtdPai, 2) Then
    Begin
      impSubIteEst.arrPrecos[0].fltTotVen := fFormataFloat(impSubIteEst.arrPrecos[0].fltTotVen + (impSubIteEst.fltUniPai * impSubIteEst.fltQtdPai) - fltVenTot, 2);
      impSubIteEst.arrPrecos[0].fltPreVen := impSubIteEst.arrPrecos[0].fltTotVen / impSubIteEst.arrPrecos[0].fltQtdPro;
    End;

    fltVenTot := 0.00;

    First;
    While Not Eof Do
    Begin

      pCarregaValoresCusto(impSubIteEst.strCodIte,
                           IIF(fEmptyStr(strEmp_TE), fGetEmpCalculoItem(impSubIteEst.strEmpIte), strEmp_TE),
                           strTabPre);

      impSubIteEst.fltOutVal := impSubIteEst.fltOutVal + fRetOutVal(FieldByName('ITE_OUTVAL').AsFloat);
      impSubIteEst.fltImpFed := impSubIteEst.fltImpFed + ((impSubIteEst.arrPrecos[RecNo-1].fltTotVen * fRetImpFed(FieldByName('ITE_IMPFED').AsFloat)) / 100);
      impSubIteEst.fltDesOpe := impSubIteEst.fltDesOpe + ((impSubIteEst.arrPrecos[RecNo-1].fltTotVen * fRetDesOpe(FieldByName('ITE_DESOPE').AsFloat)) / 100);

      If fCfgSis('IMPCF4') = 'S' Then
      Begin
        fltAlqIcmAux := Self.fltAlqIcm;
        If (fCfgSis('RAICF4', varString) = 'S') And (fCfgSis('SUGVLE', varInteger) = 2) And (fItemEstrutura(impSubIteEst.strCodIte)) Then
        Begin
          fltAlqIcmAux := fCalculaAliquota(impSubIteEst.strCodIte, impSubIteEst.strEmpIte, GetImpDir(impSubIteEst.strCodIte, impSubIteEst.strEmpIte));
        End;

        impSubIteEst.fltIcmSai := impSubIteEst.fltIcmSai + (impSubIteEst.arrPrecos[RecNo-1].fltTotVen * fltAlqIcmAux / 100)
      End
      Else
        impSubIteEst.fltIcmSai := impSubIteEst.fltIcmSai + ((impSubIteEst.arrPrecos[RecNo-1].fltTotVen * fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat)) / 100);

      fltVenTot := fltVenTot + impSubIteEst.arrPrecos[RecNo-1].fltTotVen;
      Next;
    End;

    //Encontra o % das Aliquotas
    impSubIteEst.fltImpFed := (impSubIteEst.fltImpFed * 100) / fltVenTot;
    impSubIteEst.fltDesOpe := (impSubIteEst.fltDesOpe * 100) / fltVenTot;
    impSubIteEst.fltIcmSai := (impSubIteEst.fltIcmSai * 100) / fltVenTot;
  End;

  Self.strPromoc := strPromocAnt;

  FreeAndNil(qryDetMat);
end;

function TFatVendaBase.fCriaCalculoComissaoVendedor(strVendedor: String): TCalculoComissaoVendedor;
begin
    Result := TCalculoComissaoVendedor.Create(strVendedor, strCodCli, strCliPer,
      strCodReg, strTabPre, strCodCnd, strConPag, blnDevNota, blnDevEsp, (Pos(strOpcDoc, 'GF_OF_') > 0), FfltMarLuc, Self.strEspDoc);
end;

function TFatVendaBase.fRecalculaComissao(cdsCalculo : TUniClientDataset): TMatrizFechamento;
{FUNÇÃO RECRIADA PARA SER UTILIZADA NO CALCULO DE COMISSÃO PRÉ-POST, USADA ORIGINALMENTE
 NA TRAVA DE MARGEM PRATICADA (fValidaMargemCondPatgo), PASSA-SE SOMENTE O CLIENT COM
 O REGISTRO DO ITEM A SER CALCULADO - KM}

  Var
    intCnt : Integer;
    fltPerCom: Double;
    fltTot_RT: Double;
    objCalcComissaoVend: TCalculoComissaoVendedor;
    strVendedor : String;
    strFilter : String;
    intRecNo : Integer;
    recTotMarLuc : TRecTotaisMargemLucro;
    cdsData : OleVariant;
    fltMarLuc : Double;
{$J+}
  const
    blnRecalculando : Boolean = False;
{$J-}
begin
  if (Self.fConsiderarComissaoNoCalculoCustoRealMargem) and (blnRecalculando) then
    exit;

  strFilter := '';
  SetLength(Result, 0);
  fltMarLuc := 0;

  intRecNo := cdsCalculo.RecNo;
  Try
    pPreencheMatrizFechamento(Result, Self.arrMatItensCorte, strFilter, pOnPreencheMatrizItens, cdsCalculo);

    If fCfgSis('OPCCOM') = 'MD' Then
    Begin
      blnRecalculando := True;
      try
        cdsData := Self.fCalculaMargemLucro(True);
      finally
        blnRecalculando := False;
      end;

      Self.pCalculaTotaisMargemLucro(cdsData,
                                     recTotMarLuc);

      fltMarLuc := TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True);
    End;

    FfltMarLuc := fltMarLuc;

    For intCnt := Low(Result) To High(Result) Do
    Begin
      pCalculaGravaICMSUFDestino('', '', Result[intCnt]);

      If (Not Self.fUsaVendedorDoItemParaComissao(Result[intCnt].strCodVen)) Then
        strVendedor := Self.strCodVen
      Else
        strVendedor := Result[intCnt].strCodVen;

      If fEmptyStr(Result[intCnt].strClaFis) Then
      Begin
        If (Pos(strOpcDoc, 'DV_OF_') > 0) Then
          Result[intCnt].strClaFis := '1102'
        Else
          Result[intCnt].strClaFis := '5102';
      End;

      objCalcComissaoVend := Self.fCriaCalculoComissaoVendedor(strVendedor);
      Try
        fltPerCom := objCalcComissaoVend.fRetPerComissao(Result[intCnt], Self.strTipVen);

        fltTot_RT := Result[intCnt].fltRT_Ori * Result[intCnt].fltQtdIte;

        Result[intCnt].fltPerCom := fltPerCom;
        Result[intCnt].fltTotCom := ((fltPerCom * (Result[intCnt].fltTotIte - Result[intCnt].fltDesEsp - fltTot_RT)) / 100);

      Finally
        FreeAndNil(objCalcComissaoVend);
      End;
    End;
  Finally
    cdsCalculo.RecNo := intRecNo;
  End;
end;

class function TFatVendaBase.fComissaoDoItemEntraNoOutVal: Boolean;
begin
  Result := (fCfgSis('PCMPRO') = 3) And (fCfgSis('MARIDE', varString) = 'N');
end;

function TFatVendaBase.fRecalculaComissao(blnAtualizaCdsVendas: Boolean = False; strAutInc: String = ''; blnRecalcCusRea: Boolean = False; blnVeioDoAdicionarRegistroTemporaria: Boolean = False; fltPercComissao: Double = 0): TMatrizFechamento;
  Var
    intCnt : Integer;
    fltPerCom: Double;
    fltTot_RT: Double;
    objCalcComissaoVend: TCalculoComissaoVendedor;
    strVendedor : String;
    prcScroll: TprcScroll;
    strFilter : String;
    calcCustoReal : TCalcCustoReal;
    intRecNo : Integer;
    strCodAbf,
    strCodSit : String;
    recTotMarLuc : TRecTotaisMargemLucro;
    cdsData : OleVariant;
    fltMarLuc : Double;
    blnComissaoDoItemEntraNoOutVal : Boolean;
{$J+}
  const
    blnRecalculando : Boolean = False;
{$J-}
begin
  if (Self.fConsiderarComissaoNoCalculoCustoRealMargem) and (blnRecalculando) then
    exit;

  strFilter := '';
  SetLength(Result, 0);
  fltMarLuc := 0;

  If (Not fEmptyStr(strAutInc)) Then
    strFilter := 'AUTOINCREM = ' + strAutInc; // Integer, não precisa de quoted()

  blnComissaoDoItemEntraNoOutVal := fComissaoDoItemEntraNoOutVal;

  intRecNo := cdsVenda.RecNo;
  Try
    pPreencheMatrizFechamento(Result, Self.arrMatItensCorte, strFilter);

    If fCfgSis('OPCCOM') = 'MD' Then
    Begin
      blnRecalculando := True;
      try
        If blnVeioDoAdicionarRegistroTemporaria Then
          pCalculaTotGerProdutoSelecionado(cdsVenda);

        cdsData := Self.fCalculaMargemLucro(True);
      finally
        blnRecalculando := False;
      end;

      Self.pCalculaTotaisMargemLucro(cdsData,
                                     recTotMarLuc);

      fltMarLuc := TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True);
    End;

    FfltMarLuc := fltMarLuc;

    For intCnt := Low(Result) To High(Result) Do
    Begin
      pCalculaGravaICMSUFDestino('', '', Result[intCnt]);

      If (Not Self.fUsaVendedorDoItemParaComissao(Result[intCnt].strCodVen)) Then
        strVendedor := Self.strCodVen
      Else
        strVendedor := Result[intCnt].strCodVen;

      If fEmptyStr(Result[intCnt].strClaFis) Then
      Begin
        If (Pos(strOpcDoc, 'DV_OF_') > 0) Then
          Result[intCnt].strClaFis := '1102'
        Else
          Result[intCnt].strClaFis := '5102';
      End;

      objCalcComissaoVend := Self.fCriaCalculoComissaoVendedor(strVendedor);

    {$IFNDEF LINUX}
      If Self.strOpcDocTrue = 'FC' Then
        Self.strTipVen := fRetTipoOperador(strVendedor);
    {$ENDIF}

      Try
        If fltPercComissao = 0 Then
          fltPerCom := objCalcComissaoVend.fRetPerComissao(Result[intCnt], Self.strTipVen)
        Else
          fltPerCom := fltPercComissao;

        fltTot_RT := Result[intCnt].fltRT_Ori * Result[intCnt].fltQtdIte;

        Result[intCnt].fltPerCom := fltPerCom;
        Result[intCnt].fltTotCom := ((fltPerCom * (Result[intCnt].fltTotIte - Result[intCnt].fltDesEsp - fltTot_RT)) / 100);

        If (blnAtualizaCdsVendas) Then
        Begin
          If cdsVenda.Locate('AUTOINCREM', Result[intCnt].intAutInc, []) Then
          Begin
            pDisableControls(cdsVenda, prcScroll);
            Try
              cdsVenda.Edit;
              cdsVenda.FieldByName('ITE_COMVEN').AsFloat := Result[intCnt].fltTotCom;

              If (blnRecalcCusRea) Then
                cdsVenda.FieldByName('ITE_OUTVAL').AsFloat := cdsVenda.FieldByName('SAV_OUTVAL').AsFloat;

              If (blnComissaoDoItemEntraNoOutVal) Then
                cdsVenda.FieldByName('ITE_OUTVAL').AsFloat := fFormataFloat(cdsVenda.FieldByName('ITE_COMTBL').AsFloat * cdsVenda.FieldByName('ITE_UNITAR').AsFloat / 100, VS_intDecUni);

              If (blnRecalcCusRea) Then
              Begin
                If (Not blnComissaoDoItemEntraNoOutVal) Then
                  cdsVenda.FieldByName('ITE_OUTVAL').AsFloat := cdsVenda.FieldByName('ITE_OUTVAL').AsFloat + IIF(cdsVenda.FieldByName('ITE_QTDITE').AsFloat <> 0, fFormataFloat(Result[intCnt].fltTotCom/cdsVenda.FieldByName('ITE_QTDITE').AsFloat, 2), 0);

                calcCustoReal := TCalcCustoReal.Create;
                Try
                  calcCustoReal.fltUnitar := cdsVenda.FieldByName('ITE_UNITAR').AsFloat;
                  calcCustoReal.fltPreCus := cdsVenda.FieldByName('ITE_PRECUS').AsFloat;
                  calcCustoReal.fltOutVal := cdsVenda.FieldByName('ITE_OUTVAL').AsFloat;
                  calcCustoReal.fltIcmSai := cdsVenda.FieldByName('ITE_ICMSAI').AsFloat;
                  calcCustoReal.fltImpFed := cdsVenda.FieldByName('ITE_IMPFED').AsFloat;
                  calcCustoReal.fltDesOpe := cdsVenda.FieldByName('ITE_DESOPE').AsFloat + Self.fltDesOpeCli;
                  calcCustoReal.fltIcmPav := Result[intCnt].fltIcmPav;
                  calcCustoReal.blnCalcST := Result[intCnt].blnIcmSai;

                  strCodSit := '';
                  strCodAbf := fGetCodAbf(cdsVenda.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString));
                  If (Not fEmptyStr(Self.GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString))) And (fBuscaAbfIcm(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, strCodAbf, fTrocaUFEndEntrega)) Then
                    strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString)).AsString;

                  calcCustoReal.fltDifal := fGetAlqDifal(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                         cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                         strCodAbf,
                                                         strCodSit);

                  If (cdsVenda.FieldByName('ITE_VAL_ST').AsFloat = 0) And
                     ((cdsVenda.FieldByName('ITE_BASICM').AsFloat <> 0) Or (AnsiRightStr(strClaFis, 3) = '922') Or blnCarregaPedidoOrcamentoEntFut) Then
                    calcCustoReal.fltFcp := fGetAlqFcpIcms(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                           cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                           strCodAbf,
                                                           strCodSit,
                                                           cdsVenda.FieldByName('ITE_ICMSAI').AsFloat,
                                                           calcCustoReal.fltUnitar);

                  cdsVenda.FieldByName('ITE_PRECU2').AsFloat := Self.fRetornaPrecoCusto(Preco_de_Custo_Real,
                                                                  cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                                  cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                                  cdsVenda.FieldByName('ITE_PRECUS').AsFloat,
                                                                  '',
                                                                  calcCustoReal,
                                                                  True);

                  cdsVenda.FieldByName('ITE_TOTCU2').AsFloat := cdsVenda.FieldByName('ITE_PRECU2').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
                Finally
                  FreeAndNil(calcCustoReal);
                End;
              End;

              cdsVenda.Post;
            Finally
              pEnableControls(cdsVenda, prcScroll);
            End;
          End;
        End;
      Finally
        FreeAndNil(objCalcComissaoVend);
      End;
    End;
  Finally
    cdsVenda.RecNo := intRecNo;
  End;
end;


function TFatVendaBase.fItemEmPromocao(ArrItens: TDadosFechamento): Boolean;
begin
  If ((arrItens.strPromoc <> 'S') And (arrItens.intSeqCom <= 0))                                 Or
     ((arrItens.strPromoc <> 'S') And ((arrItens.intSeqCom > 0) And (arrItens.strAtivac = 'S'))) Then
    Result := False
  Else
    Result := True;
end;

function TfatVendaBase.fEhItemConcreto(strCodIte: String): Boolean;
begin
  Result := TFunctionFuncoesFaturamento.
    fEhItemConcreto( blnSimplesRemessaConcretoDadosCliente,
                     fItemConcreto(strCodIte));
end;

function TfatVendaBase.fEhVendaItemConcreto: Boolean;
  var
    intCont: Integer;
begin
  Result := False;

  If (Not fCfgSis('USACCR', varBoolean)) Then
    Exit;

  For intCont := Low(arrMatItens) To High(arrMatItens) Do
    If fEhItemConcreto(arrMatItens[intCont].strCodIte) Then
    Begin
      Result := True;
      Break;
    End;

end;

procedure TFatVendaBase.pDefineAliquotaIss;
Var
  intIndSer : Integer;
  strCodSer : String;

  TipoOpcaoDeRetencaoISS : TTipoOpcaoDeRetencaoISS;

  function fCidadeDeEntregaEhDiferenteDaCidadeDaEmpresa : Boolean;
  begin
    Result := Not enderecoEntrega.strCodCid.Equals(fRetCidEmpresa(VS_strCodEmp));
  end;

  function fClientePessoaJuridica : Boolean;
  begin
    Result := Not fClientePessoaFisica(strCodCli);
  end;

  function fReterISSDoCadastroDaCidadeDoCliente : Boolean;
  begin

    Result := False;

    If Not (TipoOpcaoDeRetencaoISS = torReterISSDoCadastroDaCidadeDoCliente) Then
      Exit;

    If Not (fClientePessoaJuridica) Then
      Exit;

    If Not (fCidadeDeEntregaEhDiferenteDaCidadeDaEmpresa) Then
      Exit;

    Result := True;

  end;

begin

  TipoOpcaoDeRetencaoISS := fCfgSis('ISSJUR', varInteger);

  If (TipoOpcaoDeRetencaoISS = torReterISSDoCadastroDoCliente) Then
  Begin
    fltPerIss := fCampoTabela('CLI_ALQISS','CADCLI', ['CLI_CODCLI'], [strCodCli]);
    fltRedIss := fCampoTabela('CLI_REDISS','CADCLI', ['CLI_CODCLI'], [strCodCli]);
  End
  Else
  If (fReterISSDoCadastroDaCidadeDoCliente) Then
  Begin
    fltPerIss := fRetAliquotaIssCidade(enderecoEntrega.strCodCid);
    fltRedIss := fRetReducaoBaseIssCidade(enderecoEntrega.strCodCid);
  End;

  If (fltPerIss <= 0) And (fCfgSis('ISSSER', varString) = 'S') Then
  Begin
    For intIndSer := 1 To 30 Do
    Begin
      strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intToStr(intIndSer), 2));
      fltPerIss := fCampoTabela('SER_ALQISS','CADSER', ['SER_CODSER'], [strCodSer]);
      fltRedIss := fCampoTabela('SER_REDISS','CADSER', ['SER_CODSER'], [strCodSer]);

      If fltPerIss > 0 Then
        Break;

    End;

  End;

  If (fltPerIss <= 0) And (blnPedeEndEntregaServicos Or blnEndEntConfDoc) Then
  Begin
    fltPerIss := fRetAliquotaIssCidade(enderecoEntrega.strCodCid);
    fltRedIss := fRetReducaoBaseIssCidade(enderecoEntrega.strCodCid);
  End;

  If (fltPerIss <= 0) Then
  Begin
    fltPerIss := fRetAliquotaIssCidade(strCodCid);
    fltRedIss := fRetReducaoBaseIssCidade(strCodCid);
  End;

  If (fltPerIss <= 0) Then
  Begin
    fltPerIss := fCfgSis('PERISS', varDouble);
    fltRedIss := fCfgSis('REDISS', varDouble);
  End;
end;

function TfatVendaBase.fCalculaPrecoEstrutura(const blnVaiAplicarTaxaJuros : Boolean; opcPreco: TOpcPrecoEstrutura; strCodIte, strEmpIte,
  strEntSai, strTabPreItem: String; fltMargem: Double; fltQtdIte: Double = 1;
  objItensEstrutura: TItensEstrutura = nil; blnItemEspecial: Boolean = False;
  fltUnitar: Double = 0; fltVlrEstrutura: Double = 0): Double;
  Var
    qryDetMat: TUniQuery;
    recSubIte: TSubItemEstrutura;
    parPreCus: TParCalculaPrecoCusto;
    arrPrecos: Array Of TPrecos;
    fltVenTot: Double;
    fltVenTotSemJur: Double;
    fltQtdDis: Double;
    blnPromo : Boolean;
    blnParticiona: Boolean;
    blnSubItePromc: Boolean;
    strPromocAnt: String;
    strCodIteSub: String;
    strCodSit: String;
    strCodAbf: String;
    strEmpresaPrecoVenda: string;
    fltDifal: Double;
    fltFCP: Double;

    fltRateioUniSemPromocao,
    fltRateioPercentual,
    fltRateioValorRateado: Double;
    fltTaxaJurosPrecovenda : Double;
    fltUniSemJurosPrecovenda : Double;

  function fCalculaPrecoVendaSugestaoSubItem(fltVenPre: Double): Double;
    Var
      fltPreEst: Double;
  Begin
    fltPreEst := fCalculaPrecoEstrutura(False,
                                        Preco_de_Venda,
                                        strCodIte,
                                        strEmpIte,
                                        strEntSai,
                                        strTabPreItem,
                                        fltMargem);

    Result := fFormataFloat(((fltVenPre / fltPreEst) * fltUnitar), VS_intDecUni);
  End;

  function fGetSQL : String;
  begin

    If (Assigned(objItensEstrutura)) Then
      If (Assigned(objItensEstrutura.objEstruturaPersonalizada)) Then
        If (objItensEstrutura.objEstruturaPersonalizada.blnEstruturaFoiPersonalizada) Then
          Exit(fGetSQLSubItensEstruturas(objItensEstrutura.objEstruturaPersonalizada));

    Result := fGetSQLSubItensEstruturas;

  end;

Begin
  qryDetMat := fCriaQuery;

  Result := 0;
  fltVenTot := 0.00;
  fltVenTotSemJur := 0;
  blnSubItePromc := False;
  strPromocAnt := Self.strPromoc;

  If Assigned(objItensEstrutura) Then
  Begin
    objItensEstrutura.fltQuantidadeItemEstrutura := fltQtdIte;
    objItensEstrutura.Clear;
  End;

  strEmpresaPrecoVenda := IIF(fEmptyStr(strEmp_TE), fGetEmpCalculoItem(strEmpIte), strEmp_TE);

  With qryDetMat, SQL Do
  Begin
    Clear;

    Add(fGetSQL);

    ParamByName('CODITE').AsString := strCodIte;
    ParamByName('CODEMP').AsString := strEmpresaPrecoVenda;
    Open;
    First;

    Try
      pProcessMessages;

      parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);

      SetLength(arrPrecos, RecordCount);

      If Length(arrEstruAtual) > 0 Then
        SetLength(arrEstruAtual, 0);

      If fCfgSis('SUGVLE', varInteger, GetEmpCfg(strEmpIte)) = 2 Then
        SetLength(arrEstruAtual, RecordCount);

      While Not Eof Do
      Begin
        if strTabPreItem.isEmpty then
          strTabPreItem := strTabPre;

        {**********************************************************************}
        {* O QUE FIZERES NESTE BLOCO REFERENTE A PROMOÇÃO, TERÁS QUE FAZER EM *}
        {* pRetImpostosSubItensEstrutura :(                                   *}
        {*******************************************************************VA*}
        If fCfgSis('SUGVLE', varInteger, GetEmpCfg(strEmpIte)) = 2 Then //2 = SUGESTÃO É A SOMA DOS PREÇOS DOS FILHOS
        Begin
          blnParticiona := False;
          blnPromo      := False;
          Self.strPromoc := 'N';

          strCodIteSub :=  FieldbyName('DMT_ITESUB').AsString;

          If (fItemPassivelDeVerificacaoPromo(strCodIteSub, strEmpresaPrecoVenda)) And
             (Self.fFilialPromocao) And fRetornaPrecosPromocao(strCodIteSub,
                                                               Self.strCodCli,
                                                               Self.VS_Date,
                                                               FieldbyName('DMT_QTDITE').AsFloat * fltQtdIte,
                                                               0,
                                                               0,
                                                               Self.intPrzMed,
                                                               Self.fltProPreCus,
                                                               Self.fltProPreVen,
                                                               Self.fltProComVar,
                                                               Self.fltProComAta,
                                                               Self.fltProComDis,
                                                               fltQtdDis,
                                                               fltProDesF07,
                                                               Self.strComPro,
                                                               Self.strCodPro,
                                                               blnParticiona,
                                                               blnPromo,
                                                               strTabPreItem,
                                                               Self.strCodCnd,
                                                               '',
                                                               '',
                                                               True,
                                                               False,
                                                               '-1',
                                                               False,
                                                               False,
                                                               '',
                                                               strEmpresaPrecoVenda,
                                                               strNumOrc,
                                                               strEspOrc) Then
          Begin
            If Not blnParticiona Then
            Begin
              Self.strPromoc := 'S';
              blnSubItePromc := True;
            End;
          End;

          Self.arrEstruAtual[RecNo-1].strCodigo := strCodIteSub;
          Self.arrEstruAtual[RecNo-1].strPromoc := Self.strPromoc;
          {**********************************************************************}
        End;

        fltTaxaJurosPrecovenda := 0;
        fltUniSemJurosPrecovenda := 0;

        arrPrecos[RecNo-1].fltQtdPro := FieldbyName('DMT_QTDITE').AsFloat * fltQtdIte;
        arrPrecos[RecNo-1].fltPreVen := fFormataFloat(fPegaPrecoVenda(qryDetMat, strEmpIte, 'S', fltMargem, False, 'NOR', strTabPreItem, True, fltTaxaJurosPrecovenda, fltUniSemJurosPrecovenda), VS_intDecUni);
        arrPrecos[RecNo-1].fltPreVenSemJuros := IIF(fltUniSemJurosPrecovenda = 0, arrPrecos[RecNo-1].fltPreVen, fltUniSemJurosPrecovenda);

        If (Self.strPromoc = 'S') And (fCfgSis('RATEST', varString, GetEmpCfg(strEmpIte)) = 'S') And (fltVlrEstrutura > 0) And ((fCfgSis('SUGVLE', varInteger, GetEmpCfg(strEmpIte)) = 1)) Then
        Begin
          Self.strPromoc := 'N';
          fltRateioUniSemPromocao := fFormataFloat(fPegaPrecoVenda(qryDetMat, strEmpIte, 'S', fltMargem, False, 'NOR', strTabPreItem), VS_intDecUni);
          Self.strPromoc := 'S';

          fltRateioPercentual   := (fltRateioUniSemPromocao / fltVlrEstrutura) * 100;
          fltRateioValorRateado := (fltRateioPercentual * arrPrecos[RecNo-1].fltPreVen) / 100;

          arrPrecos[RecNo-1].fltPreVen := fltRateioValorRateado;
        End;

        If (fltUnitar > 0) And (fCfgSis('RATEST', varString, GetEmpCfg(strEmpIte)) = 'S') Then
          arrPrecos[RecNo-1].fltPreVen := fCalculaPrecoVendaSugestaoSubItem(arrPrecos[RecNo-1].fltPreVen);

        arrPrecos[RecNo-1].fltTotVen := fFormataFloat(arrPrecos[RecNo-1].fltPreVen * (arrPrecos[RecNo-1].fltQtdPro), 2);
        arrPrecos[RecNo-1].fltTotVenSemJuros := fFormataFloat(arrPrecos[RecNo-1].fltPreVenSemJuros * (arrPrecos[RecNo-1].fltQtdPro), 2);
        fltVenTot := fltVenTot + arrPrecos[RecNo-1].fltTotVen;
        fltVenTotSemJur := fltVenTotSemJur + arrPrecos[RecNo-1].fltTotVenSemJuros;

        Next;
      End;

      If (fltUnitar > 0) And (fFormataFloat(fltVenTot, 2) <> fFormataFloat(fltUnitar * fltQtdIte, 2)) Then
      Begin
        arrPrecos[0].fltTotVen := fFormataFloat(arrPrecos[0].fltTotVen + (fltUnitar * fltQtdIte) - fltVenTot, 2);
        arrPrecos[0].fltPreVen := arrPrecos[0].fltTotVen / arrPrecos[0].fltQtdPro;
      End;

      If (fltUnitar > 0) And (fFormataFloat(fltVenTotSemJur, 2) <> fFormataFloat(fltUnitar * fltQtdIte, 2)) Then
      Begin
        arrPrecos[0].fltTotVenSemJuros := fFormataFloat(arrPrecos[0].fltTotVenSemJuros + (fltUnitar * fltQtdIte) - fltVenTotSemJur, 2);
        arrPrecos[0].fltPreVenSemJuros := arrPrecos[0].fltTotVenSemJuros / arrPrecos[0].fltQtdPro;
      End;

      First;
      While Not Eof Do
      Begin

        pCarregaValoresCusto(FieldByName('ITE_CODITE').AsString,
                             strEmpresaPrecoVenda,
                             IIF(strTabPreItem.IsEmpty, Self.strTabPre, strTabPreItem));

        recSubIte.strCodigo := FieldbyName('DMT_ITESUB').AsString;
        recSubIte.strImpLis := FieldbyName('ITE_IMPLIS').AsString;
        recSubIte.fltSaldos := FieldbyName('ITE_SALDOS').AsFloat;
        recSubIte.fltQtdSub := FieldbyName('DMT_QTDITE').AsFloat;
        recSubIte.fltQtdTot := fFormataFloat(FieldbyName('DMT_QTDITE').AsFloat * fltQtdIte, fCfgSis('DECQTD', varInteger));

        //Venda
        If (fCfgSis('RATEST', varString, GetEmpCfg(strEmpIte)) = 'C') And (FindField('DMT_PRESUB') <> Nil) Then
          recSubIte.fltPreVen := fFormataFloat(FieldByName('ITE_PREVE' + strTabPreItem).AsFloat * FieldbyName('DMT_PRESUB').AsFloat, VS_intDecUni)
        Else
          recSubIte.fltPreVen := fFormataFloat(arrPrecos[RecNo-1].fltPreVen, VS_intDecUni);

        recSubIte.fltPreVenSemJuros := arrPrecos[RecNo-1].fltPreVenSemJuros;

        recSubIte.fltTotVen := fFormataFloat(recSubIte.fltPreVen * recSubIte.fltQtdTot, 2);
        recSubIte.fltTotVenSemJuros := fFormataFloat(recSubIte.fltPreVenSemJuros * recSubIte.fltQtdTot, 2);

        //Preço de Custo
        If blnItemEspecial Then
          recSubIte.fltPreCus := fFormataFloat(parPreCus.fCalculaPrecoCusto(recSubIte.fltPreVen, fCfgSis('MMIIES', varDouble, GetEmpCfg(strEmpIte))), VS_intDecUni)
        Else
          recSubIte.fltPreCus := fFormataFloat(fRetPreCus(FieldByName('ITE_PRECUS').AsFloat), VS_intDecUni);

        recSubIte.fltPreMed := FieldByName('ITE_PREMED').AsFloat;
        recSubIte.fltPreUlt := FieldByName('ITE_PREULT').AsFloat;
        recSubIte.fltImpUlt := FieldByName('ITE_IMPULT').AsFloat;

        recSubIte.fltTotCus := fFormataFloat(recSubIte.fltPreCus * recSubIte.fltQtdTot, 2);

        //Preço de Custo Real
        recSubIte.fltOutVal := fRetOutVal(FieldByName('ITE_OUTVAL').AsFloat);

        If fCfgSis('IMPCF4') = 'S' Then
          recSubIte.fltIcmSai := fCalculaAliquota(recSubIte.strCodigo, strEmpIte, GetImpDir(recSubIte.strCodigo, strEmpIte))
        Else
          recSubIte.fltIcmSai := fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat);

        recSubIte.fltImpFed := fRetImpFed(FieldByName('ITE_IMPFED').AsFloat);
        recSubIte.fltDesOpe := fRetDesOpe(FieldByName('ITE_DESOPE').AsFloat);

        strCodSit := '';
        strCodAbf := fGetCodAbf(recSubIte.strCodigo, strEmpresaPrecoVenda);
        If (Not fEmptyStr(Self.GetTipAbf(strEmpIte))) And (fBuscaAbfIcm(recSubIte.strCodigo, strEmpIte, strCodAbf, fTrocaUFEndEntrega)) Then
          strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpIte)).AsString;

        fltDifal := fGetAlqDifal(recSubIte.strCodigo,
                                 strEmpIte,
                                 strCodAbf,
                                 strCodSit);

        fltFcp := fGetAlqFcpIcms(recSubIte.strCodigo,
                                 strEmpIte,
                                 strCodAbf,
                                 strCodSit,
                                 recSubIte.fltIcmSai,
                                 recSubIte.fltPreVen);

        recSubIte.fltTotCu2 := parPreCus.fCalculaPrecoCustoRealVenda(recSubIte.fltPreVen,
                                                                     recSubIte.fltPreCus,
                                                                     recSubIte.fltOutVal,
                                                                     recSubIte.fltIcmSai,
                                                                     recSubIte.fltImpFed,
                                                                     fProcessarDespesasOperacionaisComplementar(recSubIte.fltDesOpe),
                                                                     fltDifal,
                                                                     fltFcp) * recSubIte.fltQtdTot;

        recSubIte.fltPreMin := fCalculaPrecoVenda(1, recSubIte.fltPreCus * (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100),
                                                     0,
                                                     fltMargem,
                                                     recSubIte.fltIcmSai,
                                                     recSubIte.fltImpFed,
                                                     (fProcessarDespesasOperacionaisComplementar(recSubIte.fltDesOpe)),
                                                     fRetComissaoTabelaItem(recSubIte.strCodigo, strTabPreItem), fMarMpkParaVenda, '', -1, 0, False, 0, 0,
                                                     recSubIte.fltOutVal,
                                                     fRestringirElementosMargem );

        recSubIte.fltTotMin := recSubIte.fltPreMin * recSubIte.fltQtdTot;

        If fCfgSis('VENMAD', varBoolean) Then
        Begin
          recSubIte.fltQtdPec := FieldbyName('DMT_QTDPEC').AsFloat * fltQtdIte;
          recSubIte.fltComPec := FieldbyName('DMT_COMPEC').AsFloat;
          recSubIte.fltLarPec := FieldbyName('DMT_LARPEC').AsFloat;
          recSubIte.fltEspPec := FieldbyName('DMT_ESPPEC').AsFloat;
          recSubIte.strAparel := FieldbyName('DMT_APAREL').AsString;
          recSubIte.strBenefi := FieldbyName('DMT_BENEFI').AsString;
          recSubIte.fltPerApa := FieldbyName('DMT_PERAPA').AsFloat;
          recSubIte.fltPerBen := FieldbyName('DMT_PERBEN').AsFloat;
        End;

        If opcPreco = Preco_de_Custo Then
        Begin
          Result := Result + recSubIte.fltTotCus;
        End

        Else If opcPreco = Preco_de_Custo_Real Then
        Begin
          Result := Result + recSubIte.fltTotCu2;
        End

        Else If opcPreco = Preco_de_Venda Then
        Begin
          If (blnVaiAplicarTaxaJuros) Then
            Result := Result + recSubIte.fltTotVenSemJuros
          Else
            Result := Result + recSubIte.fltTotVen;
        End

        Else If opcPreco = Trava_Preco_Margem_Minima_Liquida Then
        Begin
          Result := Result + recSubIte.fltTotMin;
        End;

        If Assigned(objItensEstrutura) Then
          objItensEstrutura.Add(recSubIte);

        Next;
      End;
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fCalculaPrecoEstrutura]');
      End;
    End;

  End;

  If (blnSubItePromc) Or (strPromocAnt='S') Then
    Self.strPromoc := 'S';

  FreeAndNil(parPreCus);
  FreeAndNil(qryDetMat);
End;

