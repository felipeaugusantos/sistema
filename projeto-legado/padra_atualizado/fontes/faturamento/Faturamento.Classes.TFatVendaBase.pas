    FieldByName('ITE_RATEST').AsString  := IIF(aInput.blnRatEst, 'S', 'N');;
    FieldByName('ITE_SEQPER').AsInteger := aInput.intSeqPer;
    FieldByName('ITE_PEDRET').AsString  := aInput.strPedRet;
    FieldByName('ITE_CFBIPI').AsFloat   := aInput.fltCfbIpi;
    FieldByName('ITE_CFAIPI').AsFloat   := aInput.fltCfaIpi;
    FieldByName('ITE_CFVIPI').AsFloat   := aInput.fltCfvIpi;
