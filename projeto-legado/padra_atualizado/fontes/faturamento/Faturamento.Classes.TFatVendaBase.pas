procedure TFatVendaBase.pIniciarVariaveisTotalizacaoVenda(var intDecUni: Integer; blnZeraPercentuaisDesconto: Boolean);
Var
  itemNFeComp: TNfeComplementoItem;
  strComLub: String;
begin
  blnTravaCalcTotGer := True;

  pLimparVariaveisTesteUnitario;

  fltRetFatNeg := 0;
  fltRetFatPos := 0;

  fltBasRetTotFre := 0.0;
  fltValRetTotFre := 0.0;
  fltBasRetDesAce := 0.0;
  fltValRetDesAce := 0.0;

  If MatchStr(strOpcDoc, ['DV', 'NE']) Then
    intDecUni := fMaxDecUni
  Else
    intDecUni := VS_intDecUni;

  blnTemAlgumItemEmPromocao := False;

  {*****************************************}
  {* PEGA DADOS FISCAIS                    *}
  {**************************************MV*}
  pPegaDadosFiscais(fTrocaUFEndEntrega, strCliIes, strMicEmp, fGetUFEmpresa(''), True);

  {*****************************************}
  {* ZERA VARIÁVEIS DE TOTAIS / IMPOSTOS   *}
  {**************************************MV*}
  If (strOpcDoc <> 'NC') Then
  Begin
    fltBasIpi := 0.0;
    fltTotIpi := 0.0;

    fltBasIcm := 0.0;
    fltTotIcm := 0.0;
  End;

  fltBasRet := 0.0;
  fltTotRet := 0.0;

  fltBasFcpST := 0.0;
  fltAlqFcpST := 0.0;
  fltTotFcpST := 0.0;

  fltTotCBS := 0.0;
  fltTotIBS := 0.0;
  fltTotIS  := 0.0;

  fltTotBasCBS := 0.0;
  fltTotBasIBS := 0.0;
  fltTotBasIS  := 0.0;

  fltRetNor := 0.0;
  fltRetCom := 0.0;
  fltBcrCom := 0.0;
  fltBcrNor := 0.0;
  fltBasSim := 0.0;
  fltBasInd := 0.0;
  fltBasRev := 0.0;

  fltImpPag := 0.0;
  fltPeImPg := 0.0;
  fltFedImp := 0.0;
  fltPeImFd := 0.0;
  fltEstImp := 0.0;
  fltPeImEs := 0.0;
  fltMunImp := 0.0;
  fltPeImMn := 0.0;

  fltTotSPro := 0.0;
  fltTotCPro := 0.0;

  fltTotBruSPro := 0.0;
  fltTotBruCPro := 0.0;

  fltTotGer := 0.0;
  fltTotUniOri := 0.0;
  fltTotPro := 0.0;
  fltTotCus := 0.0;
  fltTotMed := 0.0;
  fltTotDes := 0.0;
  fltTotProBri := 0.0;
  fltTotIpiProBri := 0.0;
  fltTotRetProBri := 0.0;
  fltTotRefProBri := 0.0;
  fltTotDevBri := 0.0;

  fltRet_Sp := 0.0;

  fltBasRet_Sp := 0.0;
  fltValRet_Sp := 0.0;
  fltAlqSub_Sp := 0.0;

  //Calcula o desconto icms orgao publico (usado no rateio do desconto especial)
  //Esta funcao deve ser chamada antes de zerar o icms de orgao publico (logo abaixo)
  pCalculaDesOrgItens(blnZeraPercentuaisDesconto);

  //Zera o icms de orgao publico Geral
  fltIcmOrg := 0.0;
  fltBasOrg := 0.0;

  fltNotIcmOrg := 0.0;
  fltNotBasOrg := 0.0;

  fltOrgPubIcm := 0;
  fltOrgPubPis := 0;
  fltOrgPubCof := 0;

  FValDesBenRei := 0.0;

  fltVrdIcm := 0.0;
  fltBasVrd := 0.0;

  fltTotProChkSemDesApl := 0.0;

  fltValDesEspZonFra := 0.0;
  fltIcmDesEspZonFra := 0.0;
  fltPisDesEspZonFra := 0.0;
  fltCofDesEspZonFra := 0.0;

  FImpostosFaturamento.SetarMatrizItens(arrMatItens);

  //Zera o icms de orgao publico Itens
  FImpostosFaturamento.IcmsSt.ZerarDadosDoOrgaoPublicoDeTodosOsItens;

  FillChar(arrIpiRet, SizeOf(arrIpiRet), #0);

  {*****************************************}
  {* LIMPA MATRIZ DE RESUMO DE ICMS        *}
  {**************************************MV*}
  SetLength(arrAlqIcm, 0);

  {*****************************************}
  {* NOTA DE COMPLEMENTO DE ICMS           *}
  {**************************************MV*}
  If strOpcDoc = 'NC' Then
  Begin

    fltTotGer := fltNotCom;
    {************************************}
    {* SÓ FAZ O CALCULO SE FOI DIGITADO *}
    {* VALOR TOTAL DA NOTA NO FORM      *}
    {* frmFatDadosNotaComp   o,O        *}
    {*********************************ER*}
    If fltBasIcm > 0 Then
      fltIcmCom := fFormataFloat((fltTotIcm / fltBasIcm) * 100, 2);

    {*****************************************}
    {* GERA RESUMO DE ALIQUOTAS DE ICMS      *}
    {**************************************MV*}
    pGeraAlqIcm('T',
                fltIcmCom,
                fltBasIcm,
                fltTotIcm,
                fltNotCom,
                fltBasIpi,
                fltTotIpi,
                fltDesAce);

    If objNfeComplemento.blnTemItens Then
    Begin
      {*****************************************}
      {* LIMPA MATRIZ DE RESUMO DE ICMS        *}
      {**************************************MV*}
      SetLength(arrAlqIcm, 0);

      {*****************************************}
      {* GERA RESUMO DE ALIQUOTAS DE ICMS      *}
      {**************************************MV*}
      For itemNfeComp In objNfeComplemento.arrItensNFe Do
      Begin
        If Not itemNfeComp.blnItemTemValor Then
          Continue;

        If (Pos(itemNfeComp.strCodFis, CST_SUBSTITUICAO) <= 0) Then
          strComLub := 'T'
        Else
          strComLub := itemNfeComp.strComLub;

        pGeraAlqIcm( strComLub,
                     itemNfeComp.fltAlqIcm,
                     itemNfeComp.fltBasIcm,
                     itemNfeComp.fltValIcm,
                     itemNfeComp.fltValRet + itemNfeComp.fltValIpi,
                     itemNfeComp.fltBasIpi,
                     itemNfeComp.fltValIpi,
                     0.00 );
      End;

    End;

  End;
  {*****************************************}
  {* VOLTA UNITARIO SEM DESCONTO           *}
  {**************************************MV*}
  If blnZeraPercentuaisDesconto Then
  Begin
    {*******************************************}
    {* ZERA FRETE PARA NÃO AFETAR TOTAL GERAL  *}
    {****************************************MV*}
      fltValFre := 0.0;

      //Prestcon
      If (strOpcDoc <> 'CN') And (Not blnTaxaBombeamentoPedOrc) And (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO) Then
      Begin
        fltQtdBom := 0.0;
        fltPrcBom := 0.0;
      fltTotBom := 0.0;
    End;

    fltDesEsp := 0.0;
    fltTotDes := 0.0;
    fltPorDes := 0.0;
    strEspDoc := '';
    fltDesAce := 0.0;
  End;

  If (blnZerRat) Then
    pZeraRateioServico;

//    strRICMPR := 'N';
  fltTotIpr := 0;
  fltBasIpr := 0;
  fltTotDif := 0;

  FTotProTrib  := 0.0;
  FTotProSubst := 0.0;
  FTotProRedIcm := 0.0;

  blnDocumentoTemServicos := False;

  fltValIpiZeradoFaturaConsignacao   := 0;
  fltValSTZeradoFaturaConsignacao    := 0;
  fltValFcpSTZeradoFaturaConsignacao := 0;
end;

procedure TFatVendaBase.pCalcularPrecoUnitarioProdutosFechamentoVenda(const intDecUni: Integer);
Var
  intContador: Integer;
  fltTotIteRat: Double;
  fltDesConTmp: Double;
  fltUnitarTmp: Double;
  fltTotIteTmp: Double;
  fltVlrCam,
  fltPreClq   : Double;
begin
  If (Not fTipoOperacaoRemessaContaOrdemSelecionada) And (Not fAplicouFatorFatorServico) Then
    pVoltaVrUnitarioSemDesconto;

  If (Not fAplicouFatorFatorServico) Then
  Begin
    pAplicaDescontoCondicaoUnitario;
    pAplicaTaxaJurosUnitario;
  End;

  {*****************************************}
  {* RATEIO DE FRETE E DESPESA ACESSORIA   *}
  {*************************************JC**}
  {******************************************************************************************}
  {* pRateiaValores TEM QUE FICAR NESSE PONTO POIS FUNÇÕES COMO pRetornaUnitarioFrete E     *}
  {* pRetornaUnitarioTaxaEntrega QUE ESTÃO EM pCalcPorDes, DEPENDEM DOS VALORES JÁ RATEADOS *}
  {* PARA DEFINIR O VALOR DO UNITÁRIO                                                       *}
  {**************************************************************************REQ.:169918**VA*}
  pRateiaValores;

  {***************************}
  {* CALCULA TOTAL DOS ITENS *}
  {************************MV*}
  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    If arrMatItens[intContador].strPromoc = 'S' Then
      blnTemAlgumItemEmPromocao := True;

    If fEhItemServico(arrMatItens[intContador].strCodIte) Then
    Begin
      arrMatItens[intContador].strCodFis := arrMatItens[intContador].strCodSit;

      pDefineValoresItemServico(arrMatItens[intContador]);

      If fEmptyStr(arrMatItens[intContador].strTabPre) Then
        arrMatItens[intContador].strTabPre := Self.strTabPre;

      If Not blnDocumentoTemServicos then
        blnDocumentoTemServicos := ( (fltTotSer > 0) or fPossuiBrindeServico() );

      Continue;
    End
    Else
    Begin
      If (Not blnDocumentoTemServicos) And ((strOpcDoc = 'PD') Or (fOrcamentoComoPedido)) then
        blnDocumentoTemServicos := (fGetTotalServNaoTerc('R') > 0) Or
                                   (fGetTotalServNaoTerc('I') > 0);
    End;

    If (arrMatItens[intContador].strProEmb = 'S') Then
      Continue;

    pProcessMessages;

    {*****************************************}
    {* CALCULA RATEIO DO PERCENTUAL DE DES-  *}
    {* CONTO ESPECIAL                        *}
    {**************************************MV*}
    If blnBaiEntFut And (Not blnExpedi) Then
      arrMatItens[intContador].fltUniTar := fFormataFloat(arrMatItens[intContador].fltUniTar, fMaxDecUni)
    Else
      arrMatItens[intContador].fltUniTar := fFormataFloat(arrMatItens[intContador].fltUniTar, intDecUni);

    arrMatItens[intContador].fltUniIcm := 0;

    If (fRatearDescontoEspecialEmConfDocumentos) And
       ((Self.strOpcDoc <> 'CE') Or ((Self.strOpcDoc = 'CE') And (Self.fltPorDes = 0))) Then
    Begin
      Self.fltDesEsp := 0;
      fltTotIteRat := arrMatItens[intContador].fltTotIte -
                      arrMatItens[intContador].fltDesEsp;
      arrMatItens[intContador].fltDesEsp := 0.0;

      arrMatItens[intContador].fltUnitar := fFormataFloat(fltTotIteRat /
                                                          arrMatItens[intContador].fltQtdIte, fMaxDecUni);

      pCalcPorDes(arrMatItens[intContador], fltTotIteTmp, fltDesConTmp, fMaxDecUni);
    End
    Else
      pCalcPorDes(arrMatItens[intContador], fltTotIteTmp, fltDesConTmp);

    {****************************************************************}
    {* QUANDO UTILIZA RATEIO DE SERVIÇOS, O VALOR TOTAL DE SERVIÇOS *}
    {* SERÁ DISSOLVIDO NOS ITENS                                    *}
    {*************************************************************MM*}
    If fUsaRateiodeServicos Then
    Begin
      fltUnitarTmp := (fltTotIteTmp + arrMatItens[intContador].fltSerRat) / arrMatItens[intContador].fltQtdIte;
    {$IFDEF LINUX}
      fltTotIteTmp := fFormataFloat(arrMatItens[intContador].fltQtdIte * fltUnitarTmp, 2);
    {$ELSE}
      If Assigned(VS_ObjFiscal) Then
        fltTotIteTmp := VS_objFiscal.fCalculaTotalSistema(arrMatItens[intContador].fltQtdIte, fltUnitarTmp)
      Else
        fltTotIteTmp := fFormataFloat(arrMatItens[intContador].fltQtdIte * fltUnitarTmp, 2);
    {$ENDIF}
      arrMatItens[intContador].fltUnitar := fltUnitarTmp;
      arrMatItens[intContador].fltTotIte := fltTotIteTmp;
    End;

    If (Not fItemEmPromocao(arrMatItens[intContador])) Then
    Begin
      fltTotSPro    := fltTotSPro + fltTotIteTmp;
      fltTotBruSPro := fltTotBruSPro + fFormataFloat(arrMatItens[intContador].fltQtdIte * arrMatItens[intContador].fltPreTab, 2);
    End
    Else
    Begin
      fltTotCPro    := fltTotCPro + fltTotIteTmp;
      fltTotBruCPro := fltTotBruCPro + fFormataFloat(arrMatItens[intContador].fltQtdIte * arrMatItens[intContador].fltPreTab, 2);
    End;

    If arrMatItens[intContador].strRatDes = 'N' Then
      fltTotProChkSemDesApl := fltTotProChkSemDesApl + fltTotIteTmp;

    fltTotGer := fltTotGer + fltTotIteTmp;
    fltTotPro := fltTotPro + fltTotIteTmp;
    fltTotDes := fltTotDes + fltDesConTmp;
    fltTotUniOri := fltTotUniOri + ( arrMatItens[intContador].fltUniOri * arrMatItens[intContador].fltQtdIte );

    fltTotCus := fltTotCus + fFormataFloat(arrMatItens[intContador].fltPreCus *
                                           arrMatItens[intContador].fltQtdIte, 2);

    {*****************************************}
    {* CALCULA O TOTAL MEDIO                 *}
    {**************************************MV*}
    arrMatItens[intContador].fltTotMed := fFormataFloat(arrMatItens[intContador].fltPreMed *
                                                        arrMatItens[intContador].fltQtdIte, 2);

    fltTotMed := fltTotMed + arrMatItens[intContador].fltTotMed;

    {*****************************************}
    {* PRECO DE COMPRA LIQUIDO (DET_COMLIQ)  *}
    {**************************************JC*}
    If (Not blnImportacaoSpedPisCofins) Or Self.FFulfillment.EhOperacaoFulfillment Then
    Begin
      If ((arrMatItens[intContador].strIdePro <> 'NOR') Or (arrMatItens[intContador].blnProAca)) Then
        arrMatItens[intContador].fltComLiq := arrMatItens[intContador].fltQtdIte * arrMatItens[intContador].fltPrcTin

      Else If (fEhItemVendaVidro(arrMatItens[intContador].strCodIte)) And Assigned(objEstruturaVidros) Then
      Begin
        objEstruturaVidros.pCarregarEstrutura(arrMatItens[intContador].intAutInc);
        arrMatItens[intContador].fltComLiq := arrMatItens[intContador].fltQtdIte *
          TSubItensVidroManager.fCalcularTotais(objEstruturaVidros.subItensEstrutura).fltPrecoCompraLiquidoTotal;
      End

      Else
      Begin
        fltPreClq := fCalculaPrecoCompraLiquido(arrMatItens[intContador].strCodIte, IIF(fCfgSis('ALTLOJ') <> 'S', VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri)), cdsIteGer);
        If (blnEmCampanha) And
           (fCfgSis('MARMKP') = '4') Then
        Begin
          objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                       arrMatItens[intContador].strCodIte,
                                                       EmptyStr,
                                                       EmptyStr,
                                                       0,
                                                       fltVlrCam,
                                                       strCodCmg,
                                                       fltPreClq);


          If (fltPreClq = 0) Then
            fltPreClq := fCalculaPrecoCompraLiquido(arrMatItens[intContador].strCodIte, IIF(fCfgSis('ALTLOJ') <> 'S', VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri)), cdsIteGer);
        End;

        arrMatItens[intContador].fltComLiq := arrMatItens[intContador].fltQtdIte * fltPreClq;
      End;
    End;
  End;
end;

