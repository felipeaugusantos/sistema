procedure TFatVendaBase.pCalcPorDes(Var fatItem: TDadosFechamento; Var fltValTotGer, fltValTotDes: Double; intDecUni: Integer = 0);
  Var
    fltDesConTmp: Double;
    fltUnitarTmp: Double;
    fltTotIteTmp: Double;
    fltPorDesAux: Double;

  function fConfirmacaoEspelho: Boolean;
  begin
    Result := blnConfirmacaoEspelho;

    If Result Then
    Begin
      If Not ((fCfgSis('USACND', varString) = 'S') And (fCfgSis('CNDVEN') = 'F')) Then
        Exit;

      If Not (fCampoTabela('CND_ABADES', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]) = 'S') Then
        Exit;

     If (fFormataFloat(fatItem.fltQtdIte * fatItem.fltUnitar, 2) <> fFormataFloat(fatItem.fltTotIte, 2)) Then
       Result := False;
    End;

  end;

  function fVaiCalcularImpostoProporcionalOF():Boolean;
  begin
    Result := False;

    If (Not (strOpcDoc = 'OF')) Then
      Exit;

    If (Not fEhDevolucaoEspelhoOuParaFornecedor) Then
      Exit;

    If (Not Assigned(objItensNotaEspelho)) Then
      Exit;

    If fEmptyStr(fatItem.strIncDev) Then
      Exit;

    objItensNotaEspelho.strTabDev := fatItem.strTabDev;

    If (Pos(Self.strOpcDoc, 'OF_GF_') > 0) And  (fCfgSis('ICMOPP', varString) = 'S') Then
      objItensNotaEspelho.blnUtilizarIcmsDoXmlDeEntrada := (Pos(IIF(fEmptyStr(fatItem.strCodFis), fatItem.strCodSit, fatItem.strCodFis), CST_SUBSTITUICAO) > 0);

    If (Not Assigned(objItensNotaEspelho[fatItem.strIncDev])) Then
    Begin
      objItensNotaEspelho.strTabDev := '';
      Exit;
    End
    Else
      objItensNotaEspelho.strTabDev := '';

    If fConfirmacaoEspelho Then
      Exit;

    If fEhGarantiaEnvioFornecedorEAlterouValores Then
      Exit;

    Result := True;
  end;
Begin
  fltValTotGer := 0;
  fltValTotDes := 0;

  If intDecUni = 0 Then
    intDecUni := VS_intDecUni;

  If (fFormataFloat(fatItem.fltPorDesExp, 2) <> 0.00) Then
    fltPorDesAux := fatItem.fltPorDesExp
  Else
    fltPorDesAux := Self.fltPorDes;

  If (fFormataFloat(fltPorDesAux, 2) <> 0.00) And
     (fatItem.strEntSai = 'S') And
     (fatItem.strCodIte <> fCfgSis('ITEFRE')) And
     (fatItem.strCodIte <> fCfgSis('ITEMAN')) And
     (fatItem.strCodIte <> fCfgSis('ITELAN')) And
     (fatItem.strCodIte <> fCfgSis('ITEBOM')) And
     (fatItem.strCodIte <> fCfgSis('ITETAX')) And
     ((Not fItemEmPromocao(fatItem)) Or fPermiteDescontoPromocao(fatItem.strCodPro, tapcdePromocaoCorrente, fEhItemCarregadoJuntoPDouOR(fatItem))) And
     (fFlagDoItemPermiteRatearDesconto(fatItem)) Then
  Begin

    fltDesConTmp := fFormataFloat((fatItem.fltUniTar * fltPorDesAux) / 100, fMaxDecUni);
    fltUnitarTmp := fFormataFloat(fatItem.fltUniTar - fltDesConTmp, intDecUni);

    pRetornaUnitarioFrete(fatItem, fltUnitarTmp);
    pRetornaUnitarioTaxaEntrega(fatItem, fltUnitarTmp);

  {$IFDEF LINUX}
    fltTotIteTmp := fFormataFloat(fatItem.fltQtdIte * fltUnitarTmp, 2);
  {$ELSE}
    If Assigned(VS_ObjFiscal) Then
      fltTotIteTmp := VS_objFiscal.fCalculaTotalSistema(fatItem.fltQtdIte, fltUnitarTmp)
    Else
      fltTotIteTmp := fFormataFloat(fatItem.fltQtdIte * fltUnitarTmp, 2);
  {$ENDIF}

    fatItem.fltUniIcm := fatItem.fltUnitar;

    fatItem.fltUnitar := fltUnitarTmp; //fFormataFloat(fatItem.fltUniTar - fltDesConTmp, intDecUni);
    fatItem.fltTotIte := fltTotIteTmp;

    fltValTotGer := fltTotIteTmp;
    fltValTotDes := fltDesConTmp;

  End
  Else
  Begin
    If fVaiCalcularImpostoProporcionalOF() Then
    Begin
      fltValTotGer := fatItem.fltTotIte;
      Exit;
    End;

    pRetornaUnitarioFrete(fatItem, fatItem.fltUnitar);
    pRetornaUnitarioTaxaEntrega(fatItem, fatItem.fltUnitar);

  {$IFDEF LINUX}
    fatItem.fltTotIte := fFormataFloat(fatItem.fltQtdIte * fatItem.fltUniTar, 2);
  {$ELSE}
    If Assigned(VS_ObjFiscal) Then
      fatItem.fltTotIte := VS_objFiscal.fCalculaTotalSistema(fatItem.fltQtdIte, fatItem.fltUniTar)
    Else
      fatItem.fltTotIte := fFormataFloat(fatItem.fltQtdIte * fatItem.fltUniTar, 2);
  {$ENDIF}

    If (fatItem.strEntSai = 'E') And (Pos(strOpcDoc, 'OE_EF_DV_PR_DD_CR_CA_') <= 0) Then
      fltValTotGer := -fatItem.fltTotIte
    Else
      fltValTotGer := fatItem.fltTotIte;
  End;

End;

