  Else If (RightStr(strCodFis, 2) = '41') And (strClaFis.Contains('915')) Then
    Result := (fCfgSis('IOS915') = 'I')
  Else
    Result := (fCfgSis('LVPSIC') = 'I');//PRODUTOS SEM INCIDENCIA DE ICMS
end;

