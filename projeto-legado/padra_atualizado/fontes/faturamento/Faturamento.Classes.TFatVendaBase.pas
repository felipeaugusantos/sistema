                                                    Self.blnBFut49,
                                                    Item.strEntRet,
                                                    Item.strEntFut,
                                                    Item.strMotFut,
                                                    '',
                                                    True,
                                                    '',
                                                    -1,
                                                    '',
                                                    '',
