function TfatVendaBase.fUtilizaDecretoReducaoRICMSdaAbreviacao(const item: TDadosFechamento): Boolean;
var
  LUtilizarRICMS : Boolean;
  LblnCheckBoxMarcado,
  LblnAlqMaiorQueZero: Boolean;

Begin
  LUtilizarRICMS := False;

  If fBuscaAbfIcm(item.strIteAbf, item.strEmpIte, item.strCodAbf, IIF(fEmptyStr(strEstEnt), strCliEst, strEstEnt)) Then
  Begin
    LblnCheckBoxMarcado := False;
    LblnAlqMaiorQueZero := False;

    If (cdsAbfIcm.HasField('ABF_RICMPR'+GetTipAbf(item))) Then
      LblnCheckBoxMarcado := (cdsAbfIcm.FieldByName('ABF_RICMPR'+GetTipAbf(item)).AsString = 'S');

    If fCfgSis('RICMAP',varBoolean) Then
      If (cdsAbfIcm.HasField('ABF_ALQRIC'+GetTipAbf(item))) Then
        LblnAlqMaiorQueZero := (cdsAbfIcm.FieldByName('ABF_ALQRIC'+GetTipAbf(item)).AsFloat > 0);

    LUtilizarRICMS := LblnCheckBoxMarcado Or LblnAlqMaiorQueZero;
  End;

  Result :=
    TFunctionFuncoesFaturamento
      .UtilizaDecretoReducaoRICMSdaAbreviacao(LUtilizarRICMS);
End;

