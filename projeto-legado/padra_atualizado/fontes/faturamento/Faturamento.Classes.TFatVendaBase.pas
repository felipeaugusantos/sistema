procedure TFatVendaBase.pProcessarDespesasOperacionaisComplementar(ADesOpeCli: Double);
begin

  If (Self.DespesasOperacionaisComplementar = docNaoUtilizar) Then
    Exit;

  If (Self.strOpcDoc.Equals('DV')) Then
    Exit;

  If Self.fSomarDespesasOperacionais_Cliente_Produto_Marketplace Then
    Self.fltDesOpeCli := (ADesOpeCli + Self.fltDesOpeGor)
  Else If Self.fSomarDespesasOperacionais_Marketplace Then
    Self.fltDesOpeCli := (Self.fltDesOpeGor);

end;

function TFatVendaBase.fProcessarDespesasOperacionaisComplementar(ADesOpeIte : Double) : Double;
begin

  Result := ADesOpeIte;

  If (Self.DespesasOperacionaisComplementar = docNaoUtilizar) Then
    Exit;

  If Self.fSomarDespesasOperacionais_Cliente_Produto_Marketplace Then
    Result := (ADesOpeIte + Self.fltDesOpeCli)
  Else If Self.fSomarDespesasOperacionais_Marketplace Then
    Result := (fltDesOpeCli);

end;

function TFatVendaBase.fMantemDescontoEspecialZonaFranca: Boolean;
begin
  Result := ((Pos(Copy(Self.strClaFis, 2, 3), fCfgSis('CFOPZF')) > 0) And (Pos(Self.strOpcDoc, 'VN_OU_OV_OF_NE_OE_EF_') > 0));
end;

function TFatVendaBase.fSomarDespesasOperacionais_Cliente_Produto_Marketplace: Boolean;
begin

  Result := True;

  If (Self.DespesasOperacionaisComplementar = docFormaComplementar) Then
    Exit;

  If ((Self.DespesasOperacionaisComplementar = docSubstitutiva) And (Not Self.fEhMarketPlace)) Then
    Exit;

  Result := False;

end;

