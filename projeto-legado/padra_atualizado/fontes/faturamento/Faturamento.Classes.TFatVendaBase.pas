function TFatVendaBase.fGetUnitarioEmbalagemFechada(strCodItem, strTabelaPreco: String; fltQtdItem, fltUnitOriginal: Double; blnUtilizaVlrUnitarioAtual: Boolean = False): Double;
  Var
    blnTemEmbFec     : Boolean;
    fltPercDesEmbFec : Double;
begin
  Result := 0.00;

  If fEmptyStr(strTabelaPreco) Then
    Exit;

  If (stlItensNaoTemQtdeEmbFec.IndexOf(strCodItem) = -1) And
     (Not fTemQuantEmbalagemFechada(strCodItem)) Then
  Begin
    stlItensNaoTemQtdeEmbFec.Add(strCodItem);
  End;

  blnTemEmbFec  := (stlItensNaoTemQtdeEmbFec.IndexOf(strCodItem) = -1) And
                   (fQuantEmbalagemFechadaItem(strCodItem, strTabelaPreco, fltQtdItem) > 0);

  {*********************************************}
  {* CASO POSSUI QUANTIDADE EMBALAGEM FECHADA  *}
  {*****************************************JC**}
  If blnTemEmbFec And (stlItensNaoTemQtdeEmbFec.IndexOf(strCodItem) = -1) Then
  Begin
    {*******************************************************************}
    {* VERIFICA SE EH MULTIPLO DE EMBALAGEM FECHADA (PORTANTO NAO ESTA *}
    {* EM PROMOCAO); SE FOR, APLICA O DESCONTO PARA EMBALAGEM FECHADA  *}
    {***************************************************************JC**}
    If fEhEmbalagemFechadaItem(strCodItem, strTabelaPreco, fltQtdItem) Then
    Begin
      If (blnCliFil) Then
      Begin
        If Pos(LeftStr(fCampoPrecoSugeridoTE,2), 'VE_') > 0 Then
          fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(strCodItem, strTabelaPreco, fltQtdItem, '')
        Else
          fltPercDesEmbFec := 0.00;
      End
      Else
        fltPercDesEmbFec := fPercDescEmbalagemFechadaItem(strCodItem, strTabelaPreco, fltQtdItem, '');

      If (fCfgSis('TRPEMB') = '2') And (Not blnUtilizaVlrUnitarioAtual) Then
        Result := (fRetPrecoVenda(strCodItem, strTabelaPreco) * (1 - (    fltPercDesEmbFec / 100 ) ) )
      Else
        Result := ( fltUnitOriginal * ( 1 - (  fltPercDesEmbFec / 100 ) ) );

      Try
        FAuditoriaEmbFechada
          .GravarClientDataSetItemAuditoriaEmbFechada(
            VS_strCodEmp,
            strCodItem,
            strTabelaPreco,
            '',
            fltQtdItem,
            fltPercDesEmbFec);
      Except

      End;
    End;
  End;

end;

