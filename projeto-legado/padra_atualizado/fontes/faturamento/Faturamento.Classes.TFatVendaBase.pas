begin
  Result := (Self.fConsiderarComissaoNoCalculoCustoRealMargem) And
            ((fCfgSis('PCMPRO', varString) = '2') Or (fComissaoDoItemEntraNoOutVal));
end;

class function TFatVendaBase.fOutrosValoresParaMargem(const fltComTbl, fltUnitar, fltOutVal, fltOutValOri : Double; const intDecUni : Integer) : Double;
begin
  Result := fltOutVal;
  If ((fCfgSis('IMPCF4', varString) <> 'S') And Self.fConsiderarComissaoNoCalculoCustoRealMargem) Or
     ((fCfgSis('PCMPRO', varString) = 3) And (fCfgSis('MARIDE', varString) = 'N')) {$IFNDEF LINUX} Or
     fMostraMargemUtilizaCOMTBX() {$ENDIF} Then
  Begin
    If ((fCfgSis('PCMPRO') = 3) And (fCfgSis('MARIDE', varString) = 'N')) Then
      Result := fFormataFloat(fltComTbl * fltUnitar / 100, intDecUni)
    Else
      Result := fltOutValOri;
  End;
end;

function TFatVendaBase.fGetIcmsEntregaFutura(var item: TDadosFechamento): Double;
  var
    fltIcmsSai: Double;
    fltDifal: Double;
    fltFcp: Double;
Begin
  fltIcmsSai := 0;
  fltDifal   := 0;
  fltFcp     := 0;

  If (AnsiRightStr(item.strClaFis, 3) = '922') Then
  Begin
    If (fCfgSis('IMPCF4') = 'S') Then
    begin
       fltIcmsSai := fCalculaAliquota(item.strCodIte, item.strEmpIte, item.strImpDir, 'N');

      If (strEspDoc <> 'FF') Then
      Begin
        fltDifal := fGetAlqDifal(item.strCodIte, item.strEmpIte, item.strCodAbf, item.strCodFis);

        If (item.fltValRet = 0) Then
          fltFcp := fReduzAlqFcpSeNecessario(item.strCodIte, item.strEmpIte, item.recDifalFCP.fltPerFcp);
      End;
    end
    else
      fltIcmsSai := fIteGer(item.strCodIte, VS_strCodEmp).FieldByName('ITE_ICMSAI').AsFloat;
  End;

  Result := fltIcmsSai + fltDifal + fltFcp;
End;

function TFatVendaBase.fReduzAlqFcpSeNecessario(Const aStrCodIte, aStrEmpIte: String; Const aFltAlqFcp: Double): Double;
  Var
    LstrCodSit: String;
    LfltPerRed,
    LfltBasIcm,
    LfltAlqIcm: Double;
begin
  Result := aFltAlqFcp;

  If (fCfgSis('IMPCF4') = 'S') And (fCfgSis('RAICF4') = 'S') Then
  Begin
    pRetornaAliquotaItem(aStrCodIte, aStrEmpIte, LfltAlqIcm, LstrCodSit, LfltBasIcm, LfltPerRed, True);

    If (Not fEmptyStr(LstrCodSit)) Then
    Begin
      If (LfltPerRed > 0) Then
        Result := fFormataFloat((Result * (100-LfltPerRed)) / 100, 2)
      Else If (LfltBasIcm < 100) Then
        Result := fFormataFloat((Result * LfltBasIcm) / 100, 2)
    End;
  End;
end;

function TFatVendaBase.fUtilizaPrecoSubItensEstrutura(blnItemEspecial: Boolean;
  strCodIte: String): Boolean;
begin
  Result := SameText(fCfgSis('SUGVLE'), '2')                                                     And
            (stlItensNaoEhEstrutura.IndexOf(strCodIte) = -1)                                     And
            ((blnItemEspecial And (fCfgSis('CUSESP', varString) = 'N')) Or (Not blnItemEspecial)) And
            fItemEstrutura(strCodIte);
end;

function TFatVendaBase.fRetornaPrecoCusto(opcPreco: TOpcPrecoEstrutura; strCodIte, strEmpIte: String;
  fltPreAtu: Double; strTabPre: String = ''; ccrCustoReal: TCalcCustoReal = Nil;
  blnItemEspecial: Boolean = False; fltTaxaJuros : Double = 0): Double;
  Var
    parPreCus: TParCalculaPrecoCusto;
    fltUniTmp,
    fltPreCus: Double;
begin
  If Assigned(ccrCustoReal) Then
  Begin
    If (ccrCustoReal.blnCalcSt) Then
    Begin
      ccrCustoReal.fltIcmSai := 0;
      ccrCustoReal.fltOutVal := ccrCustoReal.fltOutVal + ccrCustoReal.fltIcmPav;
    End;
  End;

  If fUtilizaPrecoSubItensEstrutura(blnItemEspecial, strCodIte) Then
  Begin
    If Assigned(ccrCustoReal) Then
      fltUniTmp := ccrCustoReal.fltUnitar
    Else
      fltUniTmp :=  0;

    Result := fCalculaPrecoEstrutura(False, opcPreco,
                                     strCodIte,
                                     strEmpIte,
                                     'S',
                                     IIF(opcPreco = Preco_de_Venda, strTabPre, ''),
                                     IIF(opcPreco = Preco_de_Venda, fltMargem, 0),
                                     1,
                                     Nil,
                                     blnItemEspecial,
                                     fltUniTmp);
  End
  Else If opcPreco = Preco_de_Custo_Real Then
  Begin

    If fRestringirElementosMargem Then
    Begin
      ccrCustoReal.fltDesOpe := IIF( (strElementosMargem[1] = 'S'), ccrCustoReal.fltDesOpe, 0 );
      ccrCustoReal.fltImpFed := IIF( (strElementosMargem[2] = 'S'), ccrCustoReal.fltImpFed, 0 );
      ccrCustoReal.fltIcmSai := IIF( (strElementosMargem[3] = 'S'), ccrCustoReal.fltIcmSai, 0 );
      ccrCustoReal.fltOutVal := IIF( (strElementosMargem[4] = 'S'), ccrCustoReal.fltOutVal, 0 );
      ccrCustoReal.fltDifal  := IIF( (strElementosMargem[5] = 'S'), ccrCustoReal.fltDifal,  0 );
      ccrCustoReal.fltFcp    := IIF( (strElementosMargem[6] = 'S'), ccrCustoReal.fltFcp,    0 );
    End;

    parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);
    Result    := parPreCus.fCalculaPrecoCustoRealVenda(ccrCustoReal.fltUnitar,
                                                       ccrCustoReal.fltPreCus,
                                                       ccrCustoReal.fltOutVal,
                                                       ccrCustoReal.fltIcmSai,
                                                       ccrCustoReal.fltImpFed,
                                                       ccrCustoReal.fltDesOpe,
                                                       ccrCustoReal.fltDifal,
                                                       ccrCustoReal.fltFcp,
                                                       0,
                                                       ccrCustoReal.fltFrete);
    FreeAndNil(parPreCus);
  End
  Else If opcPreco = Trava_Preco_de_Custo_Real Then
  Begin

    If fRestringirElementosMargem Then
    Begin
      ccrCustoReal.fltDesOpe := IIF( (strElementosMargem[1] = 'S'), ccrCustoReal.fltDesOpe, 0 );
      ccrCustoReal.fltImpFed := IIF( (strElementosMargem[2] = 'S'), ccrCustoReal.fltImpFed, 0 );
      ccrCustoReal.fltIcmSai := IIF( (strElementosMargem[3] = 'S'), ccrCustoReal.fltIcmSai, 0 );
      ccrCustoReal.fltOutVal := IIF( (strElementosMargem[4] = 'S'), ccrCustoReal.fltOutVal, 0 );
      ccrCustoReal.fltDifal  := IIF( (strElementosMargem[5] = 'S'), ccrCustoReal.fltDifal,  0 );
      ccrCustoReal.fltFcp    := IIF( (strElementosMargem[6] = 'S'), ccrCustoReal.fltFcp,    0 );
    End;

    parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);
    Result    := parPreCus.fCalculaPrecoCustoRealVenda(ccrCustoReal.fltUnitar,
                                                       ccrCustoReal.fltPreCus,
                                                       ccrCustoReal.fltOutVal,
                                                       ccrCustoReal.fltIcmSai,
                                                       ccrCustoReal.fltImpFed,
                                                       ccrCustoReal.fltDesOpe,
                                                       ccrCustoReal.fltDifal,
                                                       ccrCustoReal.fltFcp,
                                                       IIF(fCfgSis('JURCUS', VarBoolean),fltTaxaJuros,0));
    FreeAndNil(parPreCus);
  End
  Else
  If blnClienteEmCampanha And objCamGer.fVerificaCustoItemCampanha(VS_strCodEmp, strCodCli, strCodIte, '', '', fltPreCus) Then
  Begin
    Result := fltPreCus;
  End
  Else
    //Preço de Custo ou Preço de Venda
    Result := fltPreAtu;
end;

function TFatVendaBase.fGetCustoServNaoTerc: Double;
  Var
    intIndSer: Integer;
    strCodSer: String;
    fltQtdSer: Double;
    fltCusSer: Double;
begin
  Result := 0;

  For intIndSer := 1 To 30 Do
  Begin
    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intToStr(intIndSer), 2));
    fltQtdSer := GetPropValue(Self, 'fltQtdS' + fStrZero(intToStr(intIndSer), 2));

    If fEmptyStr(strCodSer) Then
      Continue;

    fltCusSer := 0;

    If Not fEhServicoTerceirizado(strCodSer) Then
    Begin
      fltCusSer := fRetCustoServico(strCodSer);
      If fltQtdSer > 0 Then
        fltCusSer := fltCusSer * fltQtdSer;
    End;

    Result := Result + fltCusSer;
  End;

End;

