          Itens[intPosicao].blnRatEst := FieldByName('ITE_RATEST').AsString = 'S';
          Itens[intPosicao].intSeqPer := FieldByName('ITE_SEQPER').AsInteger;
          Itens[intPosicao].strCilVas := FieldByName('ITE_CILVAS').AsString;
          Itens[intPosicao].strUpseml := FieldByName('ITE_UPSEML').AsString;
          Itens[intPosicao].strEmpExp := FieldByName('ITE_EMPEXP').AsString;
          Itens[intPosicao].fltCfbIpi := FieldByName('ITE_CFBIPI').AsFloat;
          Itens[intPosicao].fltCfaIpi := FieldByName('ITE_CFAIPI').AsFloat;
          Itens[intPosicao].fltCfvIpi := FieldByName('ITE_CFVIPI').AsFloat;
          Itens[intPosicao].strDocIpi := FieldByName('ITE_DOCIPI').AsString;
          Itens[intPosicao].strEspIpi := FieldByName('ITE_ESPIPI').AsString;
          Itens[intPosicao].strEmpIpi := FieldByName('ITE_EMPIPI').AsString;
          Itens[intPosicao].strUsaDce := (FieldByName('ITE_USADCE').AsString = 'S');
          Itens[intPosicao].strClaDce := FieldByName('ITE_CLADCE').AsString;
          Itens[intPosicao].fltFreRatOri := FieldByName('ITE_FRERAT').AsFloat;
          Itens[intPosicao].strChvRef := FieldByName('ITE_CHVREF').AsString;
          Itens[intPosicao].strIteRef := FieldByName('ITE_ITEREF').AsString;

          Itens[intPosicao].blnSepExc := False;
          If fCfgSis('SEPEXC', varBoolean) Then
            Itens[intPosicao].blnSepExc := (fCampoTabela('ITE_SEPEXC', 'CADITE', ['ITE_CODITE'], [Itens[intPosicao].strCodIte], False) = 'S');

          If fTipoOperacaoRemessaContaOrdemSelecionada Then
          Begin
            Itens[intPosicao].fltUnitar := FieldByName('ITE_UNIREM').AsFloat;
            Itens[intPosicao].fltTotIte := FieldByName('ITE_TOTREM').AsFloat;
          End;

          Itens[intPosicao].strLctBar := FieldByName('ITE_LCTBAR').AsString;

          Itens[intPosicao].strTckQbt := FieldByName('ITE_TCKQBT').AsString;
          Itens[intPosicao].fltSomaColorantes := FieldByName('ITE_SOMCOL').AsFloat;

          If fCfgSis('MKGDOC',varBoolean) Then
          Begin
            cdsItensTmp := TUniClientDataSet.Create(Self);

            Try
              pCloneDataSet(cdsItensTmp, objMargemLucro.cdsItensMargem);
              If cdsItensTmp.Locate('AUTOINCREM', FieldByName('AUTOINCREM').AsInteger, []) Then
              Begin
                Itens[intPosicao].fltMarProCusIte := cdsItensTmp.FieldByName('ITE_MARPRO_CUSITE').AsFloat;
                Itens[intPosicao].fltMarPraCusIte := cdsItensTmp.FieldByName('ITE_MARPRA_CUSITE').AsFloat;
                Itens[intPosicao].fltMarIte       := cdsItensTmp.FieldByName('ITE_MARITE').AsFloat;
                Itens[intPosicao].fltMarLuc       := cdsItensTmp.FieldByName('ITE_MARLUC').AsFloat;
              End;
            Finally
              FreeAndNil(cdsItensTmp);
            End;
          End;

          Next;

        End;

        EnableControls;
      End;

      strDocsDevolucao := stlDocsDev.CommaText;
      strChavesDocsDev := stlChavesDocsDev.CommaText;
      strDocsDevEntFut := stlDocsDevEntFut.CommaText;

      If fEmptyStr(fTiraCaracEspeciais(strDocsDevolucao, True, True, True, True, True, True)) Then
        strDocsDevolucao := '';

      If fEmptyStr(fTiraCaracEspeciais(strDocsDevEntFut, True, True, True, True, True, True)) Then
        strDocsDeVEntFut := '';
    Except

      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(cdsDados) then FreeAndNil(cdsDados);
    if Assigned(stlDocsDev) then FreeAndNil(stlDocsDev);
    if Assigned(stlChavesDocsDev) then FreeAndNil(stlChavesDocsDev);
    if Assigned(stlDocsDevEntFut) then FreeAndNil(stlDocsDevEntFut);
  End;
end;

