procedure TFatVendaBase.pCalculaPisCofinsLivro_SomenteCapa(strClaFisP: String = '');
  Var
    strClaFisIte: String;
    intContador : Integer;
    CalcResult  : TResultPisCofins;
    tmp         : TCalculoPisCofins;
begin

  pProcessMessages;

  fltTotPis := 0;
  fltTotCof := 0;

  fltTotBasPis := 0;
  fltTotBasCof := 0;
  fltTotAlqPis := 0;
  fltTotAlqCof := 0;

  fltTotPis_Cnf := 0;
  fltAlqPis_Cnf := 0;
  fltBasPis_Cnf := 0;
  fltTotCof_Cnf := 0;
  fltAlqCof_Cnf := 0;
  fltBasCof_Cnf := 0;

  fltAlqPis := 0;
  fltValPis := 0;
  fltRetPis := 0;

  fltAlqCof := 0;
  fltValCof := 0;
  fltRetCof := 0;

  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin

    strClaFisIte := arrMatItens[intContador].strClaFis;

    If Not fEmptyStr(strClaFisP) Then
      strClaFisIte := strClaFisP;

    If fEmptyStr(arrMatItens[intContador].strIteAbf) Then
      arrMatItens[intContador].strIteAbf := arrMatItens[intContador].strCodIte;

    Try
      tmp := TCalculoPisCofins.Create;
      tmp.strCodEmbarcacao := FCodEmbarcacao;
      CalcResult := tmp.fCalculoPisCofins(VS_strCodEmp,arrMatItens[intContador].strIteAbf,
                                          strClaFisIte,
                                          arrMatItens[intContador].strCodFis,
                                          strCodCli,
                                          VS_strSimPau,
                                          strOpcDoc,arrMatItens[intContador].fltTotIte,
                                          arrMatItens[intContador].fltDesEsp,arrMatItens[intContador].fltValipi,
                                          arrMatItens[intContador].fltValRet,arrMatItens[intContador].fltValFre,
                                          arrMatItens[intContador].fltDesAce,arrMatItens[intContador].fltValIcm,
                                          arrMatItens[intContador].VisualizarFcpIcms.fltValor,
                                          IIF(fDocumentoParaFornecedor,'F','C'),
                                          arrMatItens[intContador].strIncPis,
                                          IIF(fEmptyStr(arrMatItens[intContador].strSit_PC), Self.strSitP_C, arrMatItens[intContador].strSit_PC),
                                          strMenP_C,dtaDtaEnt,strCodEmpTe,
                                          blnEhOperacaoDeTransferencia,
                                          blnBFut49,
                                          arrMatItens[intContador].strEntRet,
                                          arrMatItens[intContador].strEntFut,
                                          arrMatItens[intContador].strMotFut,
                                          arrMatItens[intContador].strClaIpi,
                                          False,
                                          '',
                                          -1,
                                          '',
                                          '',
                                          0,
                                          0,
                                          fDifalItem(arrMatItens[intContador]));
      If (Not CalcResult.blnResult) Then
        Abort;
    Finally
      FreeAndNil(tmp);
       End;

    If CalcResult.dblBasePis > 0 Then
    Begin
      fltTotAlqPis := CalcResult.dblAlqPis;
      fltTotAlqCof := CalcResult.dblAlqCof;
    End;

    fltTotBasPis := fltTotBasPis + arrMatItens[intContador].fltBasPis;
    fltTotBasCof := fltTotBasCof + arrMatItens[intContador].fltBasCof;
    fltTotPis := fltTotPis + arrMatItens[intContador].fltValPis;
    fltTotCof := fltTotCof + arrMatItens[intContador].fltValCof;

    fltTotPis_Cnf := fltTotPis;
    fltTotCof_Cnf := fltTotCof;
    fltBasPis_Cnf := fltTotBasPis;
    fltBasCof_Cnf := fltTotBasCof;
    fltAlqPis_Cnf := CalcResult.dblAlqPis;
    fltAlqCof_Cnf := CalcResult.dblAlqCof;

    fltAlqPis := CalcResult.dblAlqPis;
    fltValPis := fltTotPis;
    fltRetPis := 0;

    fltAlqCof := CalcResult.dblAlqCof;
    fltValCof := fltTotCof;
    fltRetCof := 0;

  End;

end;

function TFatVendaBase.fGetValorEconomizado: String;
  Var
    fltValEco: Double;
    intIndex: Integer;
Begin
  fltValEco := 0;

  For intIndex := 0 To Length(arrMatItens) -1 Do
  Begin
    fltValEco := fltValEco + (arrMatItens[intIndex].fltUniOri * arrMatItens[intIndex].fltQtdIte)
                           - (arrMatItens[intIndex].fltTotIte);
  End;

  {*************************************************************}
  {* ACRESCENTA O DESCONTO ESPECIAL TOTAL AO VALOR ECONOMIZADO *}
  {**********************************************************AL*}
  fltValEco := fltValEco + fltDesEsp;

  Result := '';

  If fltValEco > 0 Then
    Result := FormatFloat('#,##0.00', fltValEco);
end;

