procedure TFatVendaBase.pCalculaGravaICMSUFDestino(strAutIncGra, strTabela: String;
  Var item: TDadosFechamento);
  Var
    fltBaseDestino,
    fltAlqInterestadualCalc,
    fltValorFCP,
    fltAliquotaFCP,
    fltAliquotaInternaEstadoDestino,
    fltPercentualProvisorioPartilha,
    fltBaseFCP: Double;
    LResultadoCalculoFcpDifalFinal: IResultadoCalculoFcpDifalFinal;
    LGravarMovIcdConsiderandoImpostosDigitados: Boolean;

    function fGravarMovIcdConsiderandoImpostosDigitadosOuEspelho: Boolean;
    Begin
      Result := False;

      If fGravarMovIcdConsiderandoImpostosDigitados(item) Then
        Exit(True);

      If (Assigned(objItensNotaEspelho)) Then
      Begin
        If Not (Self.strOpcDoc = 'DV') Then
          Exit;

        If (item.VisualizarFcpIcms.fltValor > 0) Then
          Exit(True);

        If (item.VisualizarFcpIcmsST.fltValor > 0) Then
          Exit(True);
      End;
    End;

    function fOperadorDigitouImpostosOuEspelho: Boolean;
    Begin
      Result := False;

      If Self.DigImp.blnOperadorDigitouImpostos Then
        Exit(True);

      If fGravarMovIcdConsiderandoImpostosDigitadosOuEspelho Then
        Exit(True);
    End;

    procedure PreencherVariaviesFcpDifal(
      const AResultadoCalculoFcpDifalFinal: IResultadoCalculoFcpDifalFinal);
    begin
      fltBaseDestino := AResultadoCalculoFcpDifalFinal.BaseDestino;
      fltBaseFCP     := AResultadoCalculoFcpDifalFinal.BaseFCP;
      fltValorFCP    := AResultadoCalculoFcpDifalFinal.ValorFCP;
      fltAliquotaFCP := AResultadoCalculoFcpDifalFinal.AliquotaFCP;
      fltAlqFcpST    := AResultadoCalculoFcpDifalFinal.AliquotaFCPST;

      {FCP}
      If Not fOperadorDigitouImpostosOuEspelho Then
      Begin
        item.VisualizarFcpIcms.fltBase     := AResultadoCalculoFcpDifalFinal.BaseFCP;
        item.VisualizarFcpIcms.fltAliquota := AResultadoCalculoFcpDifalFinal.AliquotaFCP;
        item.VisualizarFcpIcms.fltValor    := AResultadoCalculoFcpDifalFinal.ValorFCP;
      End;

      item.recDifalFCP := AResultadoCalculoFcpDifalFinal.RecordDifalFCP;

      {FCP ST}
      If Not fOperadorDigitouImpostosOuEspelho Then
      Begin
        If (item.fltValRet > 0) Then
        Begin
          item.VisualizarFcpIcmsST.fltBase       := AResultadoCalculoFcpDifalFinal.RecordDifalFCP.fltBasFcp;
          item.VisualizarFcpIcmsST.fltAliquota   := AResultadoCalculoFcpDifalFinal.RecordDifalFCP.fltPerFcp;
          item.VisualizarFcpIcmsST.fltValor      := AResultadoCalculoFcpDifalFinal.RecordDifalFCP.fltValFcp;
        End;

        item.fltValorCalculadoFCPSTConsignacao := AResultadoCalculoFcpDifalFinal.ValorCalculadoFCPSTConsignacao;
      End;

      fltAliquotaInternaEstadoDestino := AResultadoCalculoFcpDifalFinal.AliquotaInternaEstadoDestino;
      fltAlqInterestadualCalc         := AResultadoCalculoFcpDifalFinal.AlqInterestadualCalc;
      fltPercentualProvisorioPartilha := AResultadoCalculoFcpDifalFinal.PercentualProvisorioPartilha;
      item.fltIcmsDifalDestino        := AResultadoCalculoFcpDifalFinal.IcmsDestino;
      item.fltIcmsDifalOrigem         := AResultadoCalculoFcpDifalFinal.IcmsOrigem;
    end;

    procedure pGravaRegistros;
    Var
      LValorFCP,
      LBaseFCP: Double;
      LFcpProprio: String;
    Begin
      item.recDifalFCP.blnGrvInf := True;

      LFcpProprio := IIF(fEhFundoDeCombateDeOperacaoPropria(item.VisualizarFcpIcmsST.fltBase,
                                                            item.VisualizarFcpIcms.fltBase,
                                                            item.VisualizarFcpIcmsST.fltValor,
                                                            item.VisualizarFcpIcms.fltValor), 'S', 'N');

      If (strOpcDoc = 'OE') And (item.fltIcmsDifalDestino = 0) And (LFcpProprio = 'N') And (Not fOperadorDigitouImpostosOuEspelho) Then
      Begin
        fltBaseFCP     := 0;
        fltAliquotaFCP := 0;
        fltValorFCP    := 0;

        FillChar(item.VisualizarFcpIcms  , SizeOf(item.VisualizarFcpIcms), #0);
      End;

      If (Not fEmptyStr(strAutIncGra)) And
         (Not fEmptyStr(strTabela))  Then
      Begin

        LValorFCP := IIF(fOperadorDigitouImpostosOuEspelho, item.VisualizarFcpIcms.fltValor, fltValorFCP);
        LBaseFCP  := IIF(fOperadorDigitouImpostosOuEspelho, item.VisualizarFcpIcms.fltBase,  fltBaseFCP);

        {***************************************************************************************}
        {* Retirada a inversão dos valores do icms de origem e destino nos casos de devoluções *}
        {* para a atender a necessidade da NT 2020.005 conforme orientações do André Maximiano *}
        {*********************************************************************************** BZ*}
        pGravarICMSUFDest(strAutIncGra,
                          strTabela,
                          fltBaseDestino,
                          IIF(fOperadorDigitouImpostosOuEspelho, item.VisualizarFcpIcms.fltAliquota, fltAliquotaFCP),
                          fltAliquotaInternaEstadoDestino,
                          fltAlqInterestadualCalc,
                          fltPercentualProvisorioPartilha,
                          LValorFCP,
                          item.fltIcmsDifalDestino,
                          item.fltIcmsDifalOrigem,
                          LBaseFCP,
                          LFcpProprio);

      End;
    End;

    function fGravaMovIcd: Boolean;
    begin
      Result := False;

      If LResultadoCalculoFcpDifalFinal.SairDoProcedimento Then
        If Not LGravarMovIcdConsiderandoImpostosDigitados Then
          Exit;

      If Not LResultadoCalculoFcpDifalFinal.GravarOsRegistros Then
        If Not LGravarMovIcdConsiderandoImpostosDigitados Then
          Exit;

      Result := True;
    end;

begin
  FImpostosFaturamento.SetarDadosFechamento(item);
  pSetarImpostosFatParametrosComumFcpDifal(fGetEmpCalculoItem(item.strEmpIte), GetTipAbf(item));
  LResultadoCalculoFcpDifalFinal := FImpostosFaturamento.FcpDifal.CalcularValorFcpDifalFinal;
  LGravarMovIcdConsiderandoImpostosDigitados := fGravarMovIcdConsiderandoImpostosDigitadosOuEspelho;

  item.recDifalFCP.blnGrvInf := False;
  item.strAutoincrementoGravacaoDifal := strAutIncGra;

  item.blnGravaMovIcd := fGravaMovIcd;

  If LResultadoCalculoFcpDifalFinal.SairDoProcedimento Then
    If Not LGravarMovIcdConsiderandoImpostosDigitados Then
      Exit;

  FExibirMensagemAliquotaInternaEstadoDestino := LResultadoCalculoFcpDifalFinal.ExibirMensagemAliquotaInternaEstadoDestino;

  PreencherVariaviesFcpDifal(LResultadoCalculoFcpDifalFinal);

  If Not LResultadoCalculoFcpDifalFinal.GravarOsRegistros Then
    If Not LGravarMovIcdConsiderandoImpostosDigitados Then
      Exit;

  pGravaRegistros;
end;

procedure TFatVendaBase.pGravaICMSUFDestinoEspelho(strAutIncGra, strTabela: String;
  Var item: TDadosFechamento);
  Var
    fltBaseDestino,
    fltAlqInterestadualCalc,
    fltValorFCP,
    fltAliquotaFCP,
    fltAliquotaInternaEstadoDestino,
    fltPercentualProvisorioPartilha,
    fltBaseFCP: Double;
    strFcpProprio: String;

    procedure pGravaRegistros;
    Begin
      If (Not fEmptyStr(strAutIncGra)) And
         (Not fEmptyStr(strTabela))  Then
      Begin

        pGravarICMSUFDest(strAutIncGra,
                          strTabela,
                          fltBaseDestino,
                          fltAliquotaFCP,
                          fltAliquotaInternaEstadoDestino,
                          fltAlqInterestadualCalc,
                          fltPercentualProvisorioPartilha,
                          fltValorFCP,
                          item.fltIcmsDifalDestino,
                          item.fltIcmsDifalOrigem,
                          fltBaseFCP,
                          strFcpProprio);
      End;

    End;

begin
  fltBaseDestino                  := 0;
  fltAliquotaInternaEstadoDestino := 0;
  fltAlqInterestadualCalc         := 0;
  fltPercentualProvisorioPartilha := 0;
  item.fltIcmsDifalDestino        := 0;
  item.fltIcmsDifalOrigem         := 0;

  strFcpProprio := IIF(fEhFundoDeCombateDeOperacaoPropria(item.EspelhoFcpIcmsST.fltBase,
                                                          item.EspelhoFcpIcms.fltBase,
                                                          item.EspelhoFcpIcmsST.fltValor,
                                                          item.EspelhoFcpIcms.fltValor), 'S', 'N');

  If (Self.DigImp.blnOperadorDigitouImpostos) Then
  Begin
    fltAliquotaFCP := item.VisualizarFcpIcms.fltAliquota;
    fltValorFCP    := item.VisualizarFcpIcms.fltValor;
    fltBaseFCP     := item.VisualizarFcpIcms.fltBase;
  End
  Else
  Begin
    fltAliquotaFCP := item.EspelhoFcpIcms.fltAliquota;
    fltValorFCP    := item.EspelhoFcpIcms.fltValor;
    fltBaseFCP     := item.EspelhoFcpIcms.fltBase;
    if (strOpcdoc = 'GF') AND (item.EspelhoFcpIcmsST.fltValor > 0) Then
    begin
      fltAliquotaFCP := item.EspelhoFcpIcmsST.fltAliquota;
      fltValorFCP    := item.EspelhoFcpIcmsST.fltValor;
      fltBaseFCP     := item.EspelhoFcpIcmsST.fltBase;
    end;
  End;

  pGravaRegistros;
end;

procedure TFatVendaBase.pGravaICMSUFDestino(strAutIncGra, strTabela: String;
  Var item: TDadosFechamento);
  Var
    fltBaseDestino,
    fltAlqInterestadualCalc,
    fltValorFCP,
    fltAliquotaFCP,
    fltAliquotaInternaEstadoDestino,
    fltPercentualProvisorioPartilha,
    fltBaseFCP: Double;

    procedure pGravaRegistros;
    Begin
      If (Not fEmptyStr(strAutIncGra)) And
         (Not fEmptyStr(strTabela))  Then
      Begin
        {***************************************************************************************}
        {* Retirada a inversão dos valores do icms de origem e destino nos casos de devoluções *}
        {* para a atender a necessidade da NT 2020.005 conforme orientações do André Maximiano *}
        {*********************************************************************************** BZ*}
        pGravarICMSUFDest(strAutIncGra,
                          strTabela,
                          fltBaseDestino,
                          fltAliquotaFCP,
                          fltAliquotaInternaEstadoDestino,
                          fltAlqInterestadualCalc,
                          fltPercentualProvisorioPartilha,
                          fltValorFCP,
                          item.fltIcmsDifalDestino,
                          item.fltIcmsDifalOrigem,
                          fltBaseFCP,
                          IIF(item.fltValRet = 0, 'S', 'N'));
      End;
    End;

begin
  fltBaseDestino                  := 0;
  fltAliquotaInternaEstadoDestino := 0;
  fltAlqInterestadualCalc         := 0;
  fltPercentualProvisorioPartilha := 0;
  item.fltIcmsDifalDestino        := 0;
  item.fltIcmsDifalOrigem         := 0;

  If (fltValorIcmsDest > 0) Or
     ((item.recDifalFCP.fltAlqUfd > 0) And
      (item.recDifalFCP.fltAlqIne > 0) And
      (item.recDifalFCP.fltPerPar > 0)) Then
  Begin
    fltBaseDestino                  := item.recDifalFCP.fltBcuFde;
    fltAliquotaInternaEstadoDestino := item.recDifalFCP.fltAlqUfd;
    fltAlqInterestadualCalc         := item.recDifalFCP.fltAlqIne;
    fltPercentualProvisorioPartilha := item.recDifalFCP.fltPerPar;
    item.fltIcmsDifalDestino        := item.recDifalFCP.fltDifDes;
    item.fltIcmsDifalOrigem         := item.recDifalFCP.fltDifOri;
  End;

  fltAliquotaFCP := item.recDifalFCP.fltPerFcp;
  fltValorFCP    := item.recDifalFCP.fltValFcp;
  fltBaseFCP     := item.recDifalFCP.fltBasFcp;

  pGravaRegistros;

end;

function TFatVendaBase.fPrecoPautaFiscalDesatualizado(strCodIte: String): Boolean;
var
  dtaDtaIni: TDateTime;
  dtaDtaFin: TDateTime;
begin
  Result := false;

  If not fCfgSis('USA_PF', varBoolean) Then
    Exit;

  If not fUsaPrecoPautaFiscal(strCodIte) Then
    Exit;

  dtaDtaIni := fCampoTabela('PPF_DTAINI', 'CADPPF', ['PPF_CODITE','PPF_ESTADO'],
                                                    [strCodIte, IIF(fEmptyStr(strEstEnt), strCliEst, strEstEnt)], False);

  dtaDtaFin := fCampoTabela('PPF_DTAFIN', 'CADPPF', ['PPF_CODITE','PPF_ESTADO'],
                                                    [strCodIte, IIF(fEmptyStr(strEstEnt), strCliEst, strEstEnt)], False);

  If (dtaDtaIni = 0) And (dtaDtaFin = 0) Then
    Exit;

  If (dtaDtaIni = 0) Then
    Exit(True);

  If (dtaDtaFin = 0) Then
    Exit(True);

  If (dtaDtaIni > dtaDtaFin) Then
    Exit(True);

  If (Self.VS_Date > dtaDtaFin) Then
    Exit(True);

end;

procedure TFatVendaBase.pCalculaSubstituicaoTributariaUsandoPrecoPautaFiscal(var Item: TDadosFechamento);
var
  fltUniPPF: Double;
  fltBasPPF: Double;
  fltValPPF: Double;
begin
  If not fCfgSis('USA_PF', varBoolean) Then
    Exit;

  If not Item.blnUsaPPF Then
    Exit;

  If not (Item.fltValRet > 0) Then
    Exit;

  fltUniPPF := fCampoTabela('PPF_VLRPPF', 'CADPPF', ['PPF_CODITE','PPF_ESTADO'],
                                                    [Item.strCodIte, IIF(fEmptyStr(strEstEnt), strCliEst, strEstEnt)], False);

  If not (fltUniPPF > 0) Then
    Exit;

  fltBasPPF := fFormataFloat((fltUniPPF * Item.fltQtdIte), 2);
  fltValPPF := fFormataFloat((fltBasPPF * Item.fltAlIStS) / 100, 2);
  fltValPPF := fFormataFloat((fltValPPF - Item.fltValIcm), 2);

  If fltValPPF < 0 Then
  Begin
    fltBasPPF := 0;
    fltValPPF := 0;
  End;

  Item.fltBasRet := fltBasPPF;
  Item.fltValRet := fltValPPF;
end;

function TFatVendaBase.fEhFundoDeCombateDeOperacaoPropria(fltBasFcpST, fltBasFcp, fltVlrFcpST, fltVlrFcp: Double): Boolean;
begin
  Result := True;

  If (fltBasFcpST <> fltBasFcp) And (fltVlrFcpST > 0) And (fltVlrFcp > 0) Then
    Exit;

  If (fltBasFcpST <> fltBasFcp) Then
    Exit;

  If (fltBasFcpST = 0) And (fltVlrFcpST = 0) Then
    Exit;

  Result := False;
end;

