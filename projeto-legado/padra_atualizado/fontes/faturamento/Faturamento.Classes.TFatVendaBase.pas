function TFatVendaBase.fEhDocumentoBaixaEntregaFuturaComMaisDeUmaOrigem: Boolean;
  var
  stlDocFut : TStringList;
  item: TDadosFechamento;
  strDocAux : String;
begin
  Result := False;

  If Self.blnBaiEntFut Then
  Begin
    stlDocFut := TStringList.Create;
    stlDocFut.Sorted := True;
    stlDocFut.Duplicates := dupIgnore;
    Try
      For item In Self.arrMatItens Do
      Begin
        strDocAux := fCampoTabela('CONCAT(DET_NUMDOC,"-",DET_ESPDOC,"-",DET_CODEMP)', 'MOVDET', ['AUTOINCREM'], [item.strIncFut]);
        If (Not fEmptyStr(strDocAux)) Then
        Begin
          stlDocFut.Add(strDocAux);
          Result := (stlDocFut.Count > 1);
          If Result Then
            Break;
        End;
      End;
    Finally
      FreeAndNil(stlDocFut);
    End;
  End;
end;

function TFatVendaBase.fSomarDespesasOperacionais_Marketplace: Boolean;
begin

  Result := True;

  If (Self.DespesasOperacionaisComplementar = docSubstitutiva) And (Self.fEhMarketPlace) Then
    Exit;

  Result := False;

end;

procedure TFatVendaBase.pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto: Boolean = False;
  blnCalculaImpostos: Boolean = True; pOnProcessaItem: TOnProcessaItem = nil;
  blnPegaClassificacaoItem: Boolean = True);
begin
  If System.AtomicIncrement(intSemaforoCalculaTotGer) = 0 Then
  Begin
    Try
      pCalculaTotGerInterna(blnZeraPercentuaisDesconto,
                            blnCalculaImpostos,
                            pOnProcessaItem,
                            blnPegaClassificacaoItem);

      System.AtomicDecrement(intSemaforoCalculaTotGer);
    Except
      On E: EAbort Do
      Begin
        System.AtomicDecrement(intSemaforoCalculaTotGer);
        Raise;
      End;
      On E: ExceptionAutComSugerirVendaPresencial Do
      Begin
        System.AtomicDecrement(intSemaforoCalculaTotGer);
        Raise;
      End;
      On E: Exception Do
      Begin
        System.AtomicDecrement(intSemaforoCalculaTotGer);
        If FApenasLevantaExcecao Then
          Raise
        Else
          pMensagensErro(E.Message,'');
      End;
    End;
  End
  Else
  Begin
    System.AtomicDecrement(intSemaforoCalculaTotGer);
  End;
end;

