function TFatVendaBase.fItemEntrega(const item: TDadosFechamento): Boolean;
begin
  Result := False;

  If fItemEntregaFuturaClienteRetira(item) Then
    Exit;

  Result := fItemEntraRateio(item) And (item.strEntRet = 'E');
end;

function TFatVendaBase.fItemEntregaFuturaClienteRetira(const item: TDadosFechamento): Boolean;
begin
  Result := False;

  If (item.strEntRet <> 'E') Then
    Exit;

  If (item.strEntFut <> 'S') Then
    Exit;

  If (item.strCliBus <> 'S') Then
    Exit;

  Result := True;
end;

function TFatVendaBase.fEhDevAutomatizadaDocOutraEmpresa: Boolean;
begin

  Result := False;

  If Not Self.strOpcDoc.Equals('DV') Then
    Exit;

  If (fCfgSis('DVOULJ', varString) = 'N') Then
    Exit;

  If (fCfgSis('DVOULJ', varString) = 'B') And
     (Not fEhMesmaBaseCNPJ(VS_strCodEmp, strEmpDocDev)) Then
    Exit;

  If Not fCfgSis('DEVAUT', varBoolean) Then
    Exit;

  If Not (Self.strEmpDocDev <> EmptyStr) Then
    Exit;

  If Not (Self.strEmpDocDev <> VS_strCodEmp) Then
    Exit;

  Result := True;

end;

function TFatVendaBase.fEhCfopDentroDoEstado(const item: TDadosFechamento): Boolean;
Begin
  Result := TFunctionFuncoesFaturamento.fDentroDoEstadoCFOP(Self.blnVendaPresencial, Self.strCliEst, fDentroDoEstado(item.strEmpIte));

  If not fEhDevAutomatizadaDocOutraEmpresa Then
    Exit;

  Result := (fTrocaUFEndEntrega = fCadEmpDes('ESTADO', Self.strEmpDocDev));
End;

