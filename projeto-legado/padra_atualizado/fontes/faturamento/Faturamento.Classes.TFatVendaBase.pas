function TFatVendaBase.fCalculaPrecoVendaConformeTaxaJurosOuJurosRemanescentePromoc(Const strCodIte: String; Const fltPreVen: Double; Var fltValTax: Double): Double;
var
  qryTmp: TUniQuery;
  intDiasRemanescente: Integer;
  fltTxJurRemanescente: Double;
begin
  qryTmp := fCriaQuery();
  try
    qryTmp.SQL.Add('SELECT CPR_JURREM, IPR_PRZMED');
    qryTmp.SQL.Add('  FROM CADPRO');
    qryTmp.SQL.Add(' INNER JOIN CNDPRO ON CPR_SEQGER = CADPRO.AUTOINCREM');
    qryTmp.SQL.Add('  LEFT JOIN ITEPRO ON IPR_SEQGER = CADPRO.AUTOINCREM AND IPR_CODITE = :CODITE');
    qryTmp.SQL.Add(' WHERE PRO_CODPRO = :CODPRO');
    qryTmp.SQL.Add('   AND CPR_CODCND = :CODCND');

    qryTmp.ParamByName('CODPRO').AsString := strCodPro;
    qryTmp.ParamByName('CODCND').AsString := FCodCnd;
    qryTmp.ParamByName('CODITE').AsString := strCodIte;

    qryTmp.Open;

    if (not qryTmp.IsEmpty) and (qryTmp.FieldByName('CPR_JURREM').AsString = 'N') and (not qryTmp.FieldByName('IPR_PRZMED').IsNull) then
    begin
      Result := fltPreVen;
      fltValTax := 0;
    end
    else
    if (not qryTmp.IsEmpty) and (qryTmp.FieldByName('CPR_JURREM').AsString = 'S') and (qryTmp.FieldByName('IPR_PRZMED').AsInteger > 0) then
    begin
      intDiasRemanescente := intPrzMed - qryTmp.FieldByName('IPR_PRZMED').AsInteger;
      if intDiasRemanescente < 0 then
        intDiasRemanescente := 0;
      fltTxJurRemanescente := (fltTxJCnd / 30) * intDiasRemanescente;
      Result := fltPreVen + fFormataFloat(fltPreVen * (fltTxJurRemanescente / 100.0), VS_intDecUni);
      fltValTax := fltTxJurRemanescente;
    end
    else
      Result := fltPreVen + fFormataFloat(fltPreVen * (fltValTax / 100.0), VS_intDecUni);
  finally
    FreeAndNil(qryTmp);
  end;
end;

