procedure TFatVendaBase.pDestacaRetencoes;
begin
  fltRetIrf := 0.0;
  fltRetSer := 0.0;
  {*******************************************}
  {* VERIFICA SE IRA RETER E/OU DESTACAR OS  *}
  {* IMPOSTOS DE RETENÇÃO                    *}
  {****************************************MV*}
  blnDtcIrf := fDestacarIRPF(FRetIrf);
  blnDtcPis := fDestacarPis_Cofins_Csll(FRetSer);
  blnDtcCof := blnDtcPis;
  blnDtcCsl := blnDtcPis;

  If fTemQueZeraIprjPisCofCsl Then
  Begin
    If (strCliOrg = 'N') Then
    Begin
      blnDestacouRetencao := True;

      FRetSer   := 0.0;
      fltRetPis := 0.0;
      fltRetCof := 0.0;
      fltRetCsl := 0.0;

      fltPiPrRt := 0.0;
      fltPiSeRt := 0.0;
      fltCoPrRt := 0.0;
      fltCoSeRt := 0.0;
      fltCsPrRt := 0.0;
      fltCsSeRt := 0.0;

      strNoReSe := '';

      blnDtcPis := False;
      blnDtcCof := False;
      blnDtcCsl := False;
    End;

    If (Not ((strCliOrg = 'S') And (strCalIcm = 'N'))) Then
    Begin
      blnDestacouRetencao := True;

      FRetIrf   := 0.0;
      fltIrPrRt := 0.0;
      fltIrSeRt := 0.0;

      strNotRet := '';

      blnDtcIrf := False;
    End;
  End;
end;

