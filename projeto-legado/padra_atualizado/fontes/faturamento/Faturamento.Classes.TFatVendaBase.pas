function TFatVendaBase.fGetAlqDifal(strCodIte, strEmpIte, strCodAbf, strCodFis: String): Double;
Var
  item : TDadosFechamento;
  fltAlqIcm : Double;
  fltVPerBas: Double;
  strProEmb : String;

begin
  Result := 0;

  If fEmptyStr(Self.strCodCli) Or fEmptyStr(strCodIte) Or fEmptyStr(strCodAbf) Or fEmptyStr(strCodFis) Then
    Exit;

  If (Not fAtendeRegrasDIFAL(False, strEmpIte)) Or (blnVendaPresencial) Then
    Exit;

  If (Pos(strCodFis, CST_NAO_TRIBUTADO ) > 0) Then
    Exit;

  FillChar(item, SizeOf(item), #0);

  fltAlqIcm := fCalculaAliquota(strCodIte, strEmpIte, GetImpDir(strCodIte, strEmpIte), True);

  strProEmb := fCadIte(strCodIte).FieldByName('ITE_PROEMB').AsString;

  item.strCodIte := strCodIte;
  item.strEmpIte := strEmpIte;
  item.strIteAbf := strCodIte;
  item.strCodAbf := strCodAbf;
  item.strCodFis := strCodFis;
  item.fltAlqIcm := fltAlqIcm;
  item.fltBas__S := 100;
  item.fltBasIcm := 100;
  item.fltTotIte := 100;
  item.strDocDev := '';
  item.strEspDev := '';
  item.strEmpDev := '';
  item.opcINFesp := opcVazio;
  item.strProEmb := strProEmb;

  If not Self.FFulfillment.EhOperacaoFulfillment then
    pCalculaGravaICMSUFDestino('', '', item);

  If (fCfgSis('IMPCF4', varString, GetEmpCfg(strEmpIte)) = 'S') And (fCfgSis('RAICF4', varString, GetEmpCfg(strEmpIte)) = 'S') Then
  Begin
    fBuscaAbfIcm(strCodIte, strEmpIte, strCodAbf, fTrocaUFEndEntrega);
    fltVPerBas := cdsAbfIcm.FieldByName('ABF_BASICM' + Self.GetTipAbf(item)).AsFloat;
    Result := IIF(InRange(fltVPerBas, 0, 100), (item.recDifalFCP.fltAlDifa * fltVPerBas) / 100, 0);
  End
  Else
    Result := item.recDifalFCP.fltAlDifa;

end;

