procedure TFatVendaBase.pConfirmaNotaEspecialComplementarDeIPI;
Var
  qryAux: TUniQuery;
  LContador: Integer;
Begin

  If not (Self.strOpcDoc = 'NE') Then
    Exit;

  If not fCfgSis('CUPIPI', varBoolean) Then
    Exit;

  If not fCfgSis('IMPDIR', varBoolean) Then
    Exit;

  If not Self.blnCliFil Then
    Exit;

  If not (fRetornaClienteFilial(VS_strCodEmp) = strCodCli) Then
    Exit;

  qryAux := fCriaQuery;

  For LContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If arrMatItens[LContador].fltCfvIpi > 0 Then
    Begin
      qryAux.Close;
      qryAux.SQL.Text := 'UPDATE MOVDET, MOVTRI SET DET_CIPIOK = "S" '+
                         'WHERE MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER '+
                         '  AND MOVDET.DET_NUMDOC = :NUMDOC '+
                         '  AND MOVDET.DET_ESPDOC = :ESPDOC '+
                         '  AND MOVDET.DET_CODEMP = :CODEMP '+
                         '  AND MOVDET.DET_CODITE = :CODITE ';

      qryAux.ParamByName('NUMDOC').AsString := arrMatItens[LContador].strDocCnf;
      qryAux.ParamByName('ESPDOC').AsString := arrMatItens[LContador].strEspCnf;
      qryAux.ParamByName('CODEMP').AsString := arrMatItens[LContador].strEmpCnf;
      qryAux.ParamByName('CODITE').AsString := arrMatItens[LContador].strCodIte;
      qryAux.ExecSQL;

      qryAux.Close;
      qryAux.SQL.Text := 'UPDATE NOTDET, NOTTRI SET DET_CIPIOK = "S" '+
                         'WHERE NOTDET.AUTOINCREM = NOTTRI.DET_SEQGER '+
                         '  AND NOTDET.DET_NUMDOC = :NUMDOC '+
                         '  AND NOTDET.DET_ESPDOC = :ESPDOC '+
                         '  AND NOTDET.DET_CODEMP = :CODEMP '+
                         '  AND NOTDET.DET_CODITE = :CODITE ';

      qryAux.ParamByName('NUMDOC').AsString := arrMatItens[LContador].strDocCnf;
      qryAux.ParamByName('ESPDOC').AsString := arrMatItens[LContador].strEspCnf;
      qryAux.ParamByName('CODEMP').AsString := arrMatItens[LContador].strEmpCnf;
      qryAux.ParamByName('CODITE').AsString := arrMatItens[LContador].strCodIte;
      qryAux.ExecSQL;
    End;
  End;
End;

