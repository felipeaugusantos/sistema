          FieldByName('ITE_VARTAB').AsFloat := ((FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_UNIORI').AsFloat) - 1) * 100;
      End;

      FieldByName('ITE_PREATU').AsFloat := FieldByName('ITE_PREVE' + IIF(fEmptyStr(strTabPre),'1', strTabPre)).AsFloat ;

      If Not fEmptyStr(strSeqGad) Then
        FieldByName('GAD_SEQGAD').AsString := strSeqGad;

      FieldByName('ITE_BAREMB').AsString := strBarEmb;

      FieldByName('ITE_DEDVCF').AsFloat := fltDeDVCf;

      FieldByName('ITE_CODMEC').AsString := strCodMec;

      FieldByName('ITE_SEQRCD').AsString := strSeqRcd;

      If (Pos(strOpcDocTrue, 'BE_') <= 0) Then
      Begin
        If (intSeqInc <= 0) And (Pos(strOpcDoc, 'OR_PD_VN_') > 0) Then
          intSeqInc := fRetornaSequencialUnico('SINCPD');
      End;

      FieldByName('ITE_SEQINC').AsInteger := intSeqInc;

      If fEmptyStr(strCodVenIte) Then
        strCodVenIte := Self.strCodVen;

      If (fEmptyStr(strAltPCoIte)) Or (fCfgSis('ALTPCO', varString) = 'N') Then
        strAltPCoIte := 'N';

      FieldByName('ITE_CODVEN').AsString := strCodVenIte;
      FieldByName('ITE_NOMVEN').AsString := strCodVenIte + ' - ' + fRetNomVendedor(strCodVenIte);
      FieldByName('ITE_CODVE2').AsString := strCodVe2Ite;
      FieldByName('ITE_ALTPCO').AsString := strAltPCoIte;
      FieldByName('ITE_PERCOM').AsFloat  := fltPerComIte;

      {******************************************************************}
      {* SO É PREENCHIDO NA PRIMEIRA VEZ QUE CARREGA O PEDIDO/ORÇAMENTO *}
      {***************************************************************FC*}
      If FieldByName('ITE_QTDPRI').AsFloat = 0 Then
        FieldByName('ITE_QTDPRI').AsFloat := fltQtdIte;

      If fEmptyStr(FieldByName('ITE_INSERE').AsString) Or
         SameText(FieldByName('ITE_INSERE').AsString, 'N') Then
         FieldByName('ITE_INSERE').AsString := IIF(blnInserindoPDORCarregado And
                                                  (Not fEmptyStr(strNumOrc)) And
                                                  (fltQtdAnt <> fltQtdIte), 'S', 'N');

      // ESSES CAMPO SÓ SÃO USADOS PARA QUANDO ESTÁ SENDO ALTERADO UM PEDIDO/ORÇAMENTO
      If (FieldByName('ITE_QTDPRI').AsFloat <> fltQtdIte) And (FieldByName('ITE_INSERE').AsString = 'N') Then
        FieldByName('ITE_ALTERA').AsString := IIF(blnAlterandoPDORCarregado And
                                                 (Not fEmptyStr(strNumOrc)) And
                                                 (fltQtdAnt <> fltQtdIte), 'S', 'N')
      Else
        FieldByName('ITE_ALTERA').AsString := 'N';

      FieldByName('ITE_DOPTIN').AsFloat  := fltDopTin;
      FieldByName('ITE_LIBUNI').AsString := strLibUni;
      FieldByName('ITE_VALDIF').AsFloat  := fltValDif;
      FieldByName('ITE_EXCIPI').AsString := strExcIpi;
      FieldByName('ITE_DESMSU').AsFloat  := fltDesMSu;
      FieldByName('ITE_CLAFIS').AsString := strClaFis;
      FieldByName('ITE_AIDVOR').AsString := strAiDvOr;
      FieldByName('ITE_SEQOPI').AsString := strSeqOpI;
      FieldByName('ITE_RATDES').AsString := strRatDes;
      FieldByName('ITE_BRINDE').AsString := strBrinde;
      FieldByName('ITE_CODPAR').AsString := IIF(strBrinde = 'S', strCodPar, '');
      FieldByName('ITE_TIPBRI').AsString := IIF(strBrinde = 'S', strTipBri, '');

      FieldByName('ITE_BAQTZE').AsString := strBaseQtdZerada;

      FieldByName('ITE_EDIPES').AsBoolean  := blnEdiPes;

      If (fltPesoItCad <> -1) Then
        FieldByName('ITE_PESOITCAD').AsFloat := fltPesoItCad
      Else
        FieldByName('ITE_PESOITCAD').AsFloat := fltPesoIt;

      If (fltPesLiqCad <> -1) Then
        FieldByName('ITE_PESLIQCAD').AsFloat := fltPesLiqCad
      Else
        FieldByName('ITE_PESLIQCAD').AsFloat := fltPesLiq;

      FieldByName('ITE_SEQEST').AsInteger := intSeqEst;
      FieldByName('ITE_ITEEST').AsString  := strIteEst;
      FieldByName('ITE_UNIEST').AsFloat   := fltUniEst;
      FieldByName('ITE_QTDSBI').AsFloat   := fltQtdSbi;
      FieldByName('ITE_UNISBI').AsFloat   := fltUniSbi;

      If (fltQtdSbi > 0) Then
        FieldByName('ITE_ESTQTD').AsFloat := (fltQtdIte / fltQtdSbi)
      Else
        FieldByName('ITE_ESTQTD').AsFloat := 0;

      FieldByName('ITE_ATIVAC').AsString := 'N';

      If (Not fEmptyStr(strAtivac)) Then
      FieldByName('ITE_ATIVAC').AsString  := strAtivac;

      FieldByName('ITE_SEQCOM').AsInteger := intSeqCom;
      FieldByName('ITE_QTDATI').AsFloat   := fltQtdAti;
      FieldByName('ITE_QTDCOM').AsFloat   := fltQtdCom;
      FieldByName('ITE_TABCOM').AsString  := strTabCom;

      If fEmptyStr(FieldByName('ITE_EMPITE').AsString) Then
        FieldByName('ITE_DTAVAL').AsDateTime := fIteGer(FieldByName('ITE_CODITE').AsString, VS_strCodEmp).FieldByName('ITE_DTAVAL')
      Else
        FieldByName('ITE_DTAVAL').AsDateTime := fIteGer(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString).FieldByName('ITE_DTAVAL');

      If (SameText(strAtivac, 'S')) Then
        FieldByName('ITE_SITUAC').AsString := 'C'
      Else If (SameText(strBrinde, 'S')) Then
        FieldByName('ITE_SITUAC').AsString := 'B'
      Else If ((SameText(strPromoc, 'S')) Or ((intSeqCom > 0) And (Not SameText(strBrinde, 'S')))) And
              ((Not Self.blnCliFil) Or ((Self.blnCliFil) And (PRECOS_TE_PROMOC.Contains(Self.recDadCli.strTEPPRO)))) Then
        FieldByName('ITE_SITUAC').AsString := 'P'
      Else If (Not SameText(strIdePro, 'NOR')) Then
        FieldByName('ITE_SITUAC').AsString := 'T'
      Else
        FieldByName('ITE_SITUAC').AsString := 'N';

      FieldByName('ITE_PORGER').AsFloat  := fltPorGer;
      FieldByName('ITE_PORDET').AsFloat  := fltPorDet;

      FieldByName('ITE_LOTSEP').AsString := strLotSep;

      FieldByName('ITE_OBSCOL').AsString := strObsColorista;
      FieldByName('ITE_TIPFOR').AsInteger := intTipoFormulacao;

      FieldByName('ITE_FREMKP').AsFloat  := fltFreMkp;
      FieldByName('ITE_COMMKP').AsFloat  := fltComMkp;

      If (Assigned(objOrdSer)) And (FieldByName('ITE_SEQORS').AsInteger = 0) Then
        FieldByName('ITE_SEQORS').AsInteger := objOrdSer.intSeqIndProd;

      FieldByName('ITE_OPCABS').AsInteger := Integer(oaTodos);
      FieldByName('ITE_ATICOM').AsString := objInfAdi.FieldByName('ITE_ATICOM');

      pProdutosRelacionados;

      FieldByName('ITE_COD_NF').AsString := strCodNF;
      FieldByName('ITE_DES_NF').AsString := strDesNF;
      FieldByName('ITE_CLIBAR').AsString := strCliBar;

      FieldByName('ITE_DESCND').AsFloat  := fltDesCnd;
      FieldByName('ITE_PROESP').AsString := strProEsp;
      FieldByName('ITE_EXIBSE').AsString := strExibSE;

      If fDestacarDescontoDaCondicaoPagamentoNoCampoDescontoDosItensEmPromocao Then
      Begin
        FieldByName('ITE_PROCND').AsBoolean := False;
        If (FieldByName('ITE_PROMOC').AsString = 'S') Then
          FieldByName('ITE_PROCND').AsBoolean := IIF(FieldByName('ITE_DESCON').AsFloat > 0, True, False);
      End;

      FieldByName('ITE_PROKIT').AsString := FIDKitPromocao;

      FieldByName('ITE_EMPCAR').AsString := strEmpCar;
      FieldByName('ITE_DEVCAR').AsString := strAutoinDevCar;
      FieldByName('ITE_ENFUDO').AsString := strEntFutDocOri;
      FieldByName('ITE_TEMNSE').AsString := IIF(fEmptyStr(strTemNumSerie), 'N', strTemNumSerie);

      If fEmpCarPreenchidaEmpDif(strEmpCar, strEmpIte) Then
        FieldByName('ITE_SALCAR').AsFloat := fRetSaldosEmpresa(strCodIte, strEmpCar, strNumLot)
      Else
        FieldByName('ITE_SALCAR').AsFloat := 0;

      FieldByName('ITE_PERDESEMBFEC').AsFloat := FAuditoriaEmbFechada
        .RetornarValorPercentualDescontoEmbalagemFechada(VS_strCodEmp, strCodIte, strTabPre, '', fltQtdIte);

      FieldByName('ITE_FDOITERECALC').AsString := strFdoIteRecalcPrecos;

      pSetaCampoPromocaoPorCnd(cdsDados, recForTin.Formulas);

      FieldByName('ITE_OPSEEX').AsString := strOpSeEx;
      FieldByName('ITE_CONEXP').AsString := strConExp;
      FieldByName('ITE_EMBEXP').AsString := strEmbExp;
      FieldByName('ITE_OBSEXP').AsString := strObsExp;

      FieldByName('ITE_CHKOUT').AsString := strChkOut;
      FieldByName('ITE_RESERV').AsString := strReserv;

      FieldByName('ITE_MOVTRILOCFIS').AsString := strMovTriLocFis;

      FieldByName('ITE_SEQINV').AsInteger := intSeqInv;

      FieldByName('ITE_SEQEQL').AsString  := strSeqEql;
      FieldByName('ITE_QTDCHA').AsFloat   := fltQtdCha;
      FieldByName('ITE_NUMDRW').AsString  := strNumDrw;
      FieldByName('ITE_MNTPRC').AsString  := IIF(blnMntPrc, 'S', 'N');

      FieldByName('ITE_QTDRET').AsFloat  := fltQtdRet;
      FieldByName('ITE_DESPRO').AsString := IIF(FieldByName('ITE_CODPRO').AsString <> '', fRetDescPromocao(FieldByName('ITE_CODPRO').AsString), '');
      FieldByName('ITE_RECDEV').AsString := fIteGer(strCodIte, FieldByName('ITE_EMPITE').AsString).FieldByName('ITE_RECDEV').AsString;

      FieldByName('ITE_FRECOT').AsFloat   := fltFreCot;

      FieldByName('ITE_PIIZFM').AsFloat   := fCampoTabela('ITE_PIIZFM','CADITE',['ITE_CODITE'],[strCodIte], False) ;

      FieldByName('ITE_ALTEST').AsString  := IIF(blnAltEst, 'S', 'N');
      FieldByName('ITE_RATEST').AsString  := IIF(blnRatEst, 'S', 'N');
      FieldByName('ITE_SEQPER').AsInteger := intSeqPer;
      FieldByName('ITE_PEDRET').AsString  := strPedRet;
      FieldByName('ITE_CFBIPI').AsFloat   := fltCfbIpi;
      FieldByName('ITE_CFAIPI').AsFloat   := fltCfaIpi;
      FieldByName('ITE_CFVIPI').AsFloat   := fltCfvIpi;
      FieldByName('ITE_DOCIPI').AsString  := strDocIpi;
      FieldByName('ITE_ESPIPI').AsString  := strEspIpi;
      FieldByName('ITE_EMPIPI').AsString  := strEmpIpi;
      FieldByName('ITE_SEQVDP').AsString  := strSeqVdp;
      FieldByName('ITE_CODDIG').AsString  := strCodDig;
      FieldByName('ITE_CHVREF').AsString  := strChvRef;
      FieldByName('ITE_ITEREF').AsString  := strIteRef;

      If (fCfgSis('ALTVMT', varString) = 'S') And (Assigned(cdsTravaMinima)) And (cdsTravaMinima.RecordCount > 0) Then
      Begin
        cdsTravaMinima.Filtered := False;
        cdsTravaMinima.Filter := ' CODITE = '+QuotedStr(strCodIte)+'';
        cdsTravaMinima.Filtered := True;

        If cdsTravaMinima.RecordCount > 0 Then
          FieldByName('ITE_PREMIN').AsFloat := cdsTravaMinima.FieldByName('VLMINV_').AsFloat;

        cdsTravaMinima.Filtered := False;
      End;

      if (fltValorOriginalItemEstrutura > 0) then
        FieldByName('ITE_ESTORI').AsFloat   := fltValorOriginalItemEstrutura;

      FieldByName('ITE_CILVAS').AsString := strCilvas;

      If (stlItensNaoTemQtdeEmbFec.IndexOf(FieldByName('ITE_CODITE').AsString) >= 0) Then
      Begin
        FieldByName('ITE_EHEMBA').AsBoolean := False;
      End
      Else
      Begin
        FieldByName('ITE_EHEMBA').AsBoolean := fEhEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString,
                                                                       FieldByName('ITE_TABPRE').AsString,
                                                                       FieldByName('ITE_QTDITE').AsFloat);
      End;

      If FieldByName('ITE_EHEMBA').AsBoolean Then
      Begin
        FieldByName('ITE_PEREMB').AsFloat := fPercDescEmbalagemFechadaItem(FieldByName('ITE_CODITE').AsString,
                                                                           FieldByName('ITE_TABPRE').AsString,
                                                                           FieldByName('ITE_QTDITE').AsFloat,
                                                                           '');
        If (fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, VS_intDecUni) <> fFormataFloat(FieldByName('ITE_UNIDIG').AsFloat, VS_intDecUni)) Then
          FieldByName('ITE_VLPEMB').AsFloat := fFormataFloat((FieldByName('ITE_UNIORI').AsFloat - (FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_PEREMB').AsFloat / 100)), VS_intDecUni)
        Else
          FieldByName('ITE_VLPEMB').AsFloat := FieldByName('ITE_UNIORI').AsFloat;

        FieldByName('ITE_PEREMB').AsFloat := fFormataFloat(((1 - (FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_VLPEMB').AsFloat)) * 100), VS_intDecUni);

        FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_VLPEMB').AsFloat), VS_intDecUni);
      End
      Else
      Begin
        FieldByName('ITE_PEREMB').AsFloat := 0;
        FieldByName('ITE_VLPEMB').AsFloat := 0;
        FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNIORI').AsFloat), VS_intDecUni);
      End;

      FieldByName('ITE_SOBENC').AsString := strSobEnc;
      FieldByName('ITE_USADCE').AsString := fUsaCfopDecretoCeara(strCodIte);
      FieldByName('ITE_CLADCE').AsString := fRetornaCfopDecretoCeara(strCodIte);
      FieldByName('ITE_LCTBAR').AsString := IIF(blnTipBusCodBar,'S','N');

      FieldByName('ITE_TCKQBT').AsString := strTckQbt;
      FieldByName('ITE_SOMCOL').AsFloat := fltSomCol;
      Post;

    Finally
      cdsDados.EnableControls;
    End;

    If blnCalcularComissao Then
      pRecalculaComissao(FieldByName('AUTOINCREM').AsString);

    If ((fEhAutocenter) Or (fCfgSis('RETDEV', varString) = 'S')) And (Not fEhItemServico(strCodIte)) Then
      pInsereRegistroLogItensSep(cdsDados, strStaLog, fltQtdAnt, blnPermiteAddLogItensSep);

    If (Assigned(btnAdicionar)) Then
      btnAdicionar.Tag  := 0;

    If (strOpcDoc = 'NP') And Assigned(objIcmsItemImob) Then
      objIcmsItemImob.intAutInc := FieldByName('AUTOINCREM').AsInteger;

    pDefinirAutIncItemLogLib(strCodIte, FieldByName('AUTOINCREM').AsInteger);

    if blnCalcularImpostos then
      pCalculaTotGerProdutoSelecionado(cdsDados);

  End;

End;
{$endregion}

{$Region 'pAdicionaRegistroTemporariaNew'}
procedure TFatVendaBase.pAdicionaRegistroTemporariaNew(aInput: TDadosItemDTO);

  Var
    strStaLog: String;
    fltQtdAnt: Double;
    objInfAdi: IMyCampoTabela;
    objProRel: IMyCampoTabela;
    blnUsaTabPreEmbalagem: Boolean;
    strCodNF,
    strDesNF,
    strCliBar: String;
    recParametrosCalculoValorIpi : TParametrosCalculoValorIpi;

  function fInseriuOrcamentoDiferenteNoPassoAnterior: Boolean;
    Var
      strDocAtu: String;
  begin
    strDocAtu := aInput.strNumOrc+aInput.strEspOrc+aInput.strEmpOrc;

    Result := (Not fEmptyStr(strDocAtu)) And
              (Length(strDocAtu) = Length(FChaveUltimoDocSeqInd)) And
              (strDocAtu <> FChaveUltimoDocSeqInd);
  end;

  procedure pProdutosRelacionados;
  begin
    If (fCampoTabela('COUNT(*)', 'CLIPRO', [], [], False) <> 0) Then
    Begin
      objProRel := fCampoTabelaArray([
                                 'CLI_COD_NF AS COD_NF',
                                 'CLI_CODBAR AS CODBAR',
                                 'CLI_DES_NF AS DES_NF'
                                ],
                                ' CLIPRO ',
                                ['CLI_CODCLI', 'CLI_CODITE'], [strCodCli, aInput.strCodIte], False);

      strCodNF  := objProRel.FieldByName('COD_NF');
      strDesNF  := objProRel.FieldByName('DES_NF');
      strCliBar := objProRel.FieldByName('CODBAR');
    End;
  end;

Begin

  pSetarImpostosFatParametrosComum(fGetEmpCalculoItem(aInput.strEmpIte));

  {Concreto}
  If (blnCarregandoEstrutura And (strOpcDoc = 'VN') And (fCfgSis('TPNFCR') = PRESTCON)) Or
     (blnCarregandoEstrutura And (strOpcDoc = 'VN') And (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And (strEspDoc <> 'NF')) Then
    aInput.cdsDados := cdsDadosSubItensEst;

  With aInput.cdsDados Do
  Begin
    fltQtdAnt := 0;
    strStaLog := 'I';

    objInfAdi := fCadIte(aInput.strCodIte);

    If (Assigned(aInput.btnAdicionar)) And (aInput.btnAdicionar.Tag > 0) Then
    Begin
      Locate('AUTOINCREM', aInput.btnAdicionar.Tag, []);
      Edit;

      strStaLog := 'A'; //STATUS DO LOG DOS PRODUTOS
      fltQtdAnt := FieldByName('ITE_QTDITE').AsFloat; //QUANTIDADE ANTERIOR DO PRODUTO
    End
    Else if (blnConEqu) and (aInput.intSeqIte > 0) then
    Begin
      Append;
      FieldByName('AUTOINCREM').AsInteger := aInput.intSeqIte;
    End
    Else
    Begin
      Append;

      FieldByName('ITE_ITENOV').AsString := 'S' ;

      If TAggregateField(FieldByName('MAX_AUTINC')).Value = Null Then
        FieldByName('AUTOINCREM').AsInteger := 1
      Else
        FieldByName('AUTOINCREM').AsInteger := TAggregateField(FieldByName('MAX_AUTINC')).Value + 1;

      If TMostraTravaMinimaHelper.fExibeTravaMinima Then
        TMostraTravaMinimaHelper.pAtualizaAutInc(FieldByName('AUTOINCREM').AsString, aInput.strCodIte, cdsTravaMinima);
    End;

    FieldByName('ITE_OPESEP').AsString := aInput.strOpeSep;
    FieldByName('ITE_OPEEXP').AsString := aInput.strIteOpeExp;
    FieldByName('ITE_NOTC17').AsString  := aInput.strNotC17;
    FieldByName('ITE_IDEPRO').AsString  := strIdePro;
    FieldByName('ITE_CODGRU').AsString  := aInput.strCodGru;
    FieldByName('ITE_CODITE').AsString  := aInput.strCodIte;
    FieldByName('ITE_DESORI').AsString  := strDesOri;
    FieldByName('ITE_DESITE').AsString  := aInput.strDesIte;
    FieldByName('ITE_DESSIM').AsString  := aInput.strDesSim;
    FieldByName('ITE_CODCMG').AsString  := strCodCmg;

    FieldByName('ITE_CEREPI').AsString  := objInfAdi.FieldByName('ITE_CEREPI');
    FieldByName('ITE_MSGLV1').AsString  := objInfAdi.FieldByName('ITE_MSGLV1');
    FieldByName('ITE_MSGLV2').AsString  := objInfAdi.FieldByName('ITE_MSGLV2');

    If fEmptyStr(aInput.strDesFab) Then
      FieldByName('ITE_DESFAB').AsString  := objInfAdi.FieldByName('ITE_DESFAB')
    Else
      FieldByName('ITE_DESFAB').AsString  := aInput.strDesFab;

    If fEmptyStr(aInput.strUnidad) Then
      FieldByName('ITE_UNIDAD').AsString  := objInfAdi.FieldByName('ITE_CODUNI')
    Else
      FieldByName('ITE_UNIDAD').AsString  := aInput.strUnidad;

    If fEmptyStr(aInput.strCodUni) Then
      FieldByName('ITE_CODUNI').AsString  := objInfAdi.FieldByName('ITE_CODUNI')
    Else
      FieldByName('ITE_CODUNI').AsString  := aInput.strCodUni;

    If fEmptyStr(aInput.strCodMar) Then
      FieldByName('ITE_CODMAR').AsString  := objInfAdi.FieldByName('ITE_CODMAR')
    Else
      FieldByName('ITE_CODMAR').AsString  := aInput.strCodMar;

    FieldByName('ITE_CODFOR').AsString  := strCodFor;
    FieldByName('ITE_REFERE').AsString  := aInput.strRefere;
    FieldByName('ITE_VAL_RT').AsFloat   := aInput.fltVal_RT;

    If fltUniVis = 0 Then
    Begin
      fltTaxJur := 0;
      fltUniVis := fltUniOri;
    End;

    FieldByName('ITE_TAXJUR').AsFloat   := fltTaxJur;
    FieldByName('ITE_UNIVIS').AsFloat   := fltUniVis;
    FieldByName('ITE_UNIORI').AsFloat   := fltUniOri;
    FieldByName('ITE_UNITAR').AsFloat   := aInput.fltUniTar;
    FieldByName('ITE_UNILOD').AsFloat   := aInput.fltUniTar;
    FieldByName('ITE_UNITMP').AsFloat   := aInput.fltUniTmp;
    FieldByName('ITE_DESCON').AsFloat   := aInput.fltDesCon;
    FieldByName('ITE_QTDITE').AsFloat   := aInput.fltQtdIte;

  {$IFNDEF LINUX}
    If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
    Begin
      FieldByName('ITE_QTDPEC').AsFloat   := aInput.recMadeira.fltQtdPec;

      if aInput.recMadeira.fltQtdPec = 0 then
        FieldByName('ITE_UNTPEC').AsFloat := 0
      else
        FieldByName('ITE_UNTPEC').AsFloat := aInput.fltTotIte / aInput.recMadeira.fltQtdPec;

      FieldByName('ITE_COMPEC').AsFloat   := aInput.recMadeira.fltComPec;
      FieldByName('ITE_LARPEC').AsFloat   := aInput.recMadeira.fltLarPec;
      FieldByName('ITE_ESPPEC').AsFloat   := aInput.recMadeira.fltEspPec;

      FieldByName('ITE_APAREL').AsString  := aInput.recMadeira.strAparel;
      FieldByName('ITE_PERAPA').AsFloat   := aInput.recMadeira.fltPerApa;
      FieldByName('ITE_BENEFI').AsString  := aInput.recMadeira.strBenefi;
      FieldByName('ITE_PERBEN').AsFloat   := aInput.recMadeira.fltPerBen;
    End;
  {$ENDIF}

    If (Self.fltVlCtVn > 0) And fItemUtilizaPrecoEmDolar(FieldByName('ITE_CODITE').AsString) Then
    Begin
      FieldByName('ITE_UNIDOL').AsFloat := FieldByName('ITE_UNITAR').AsFloat / Self.fltVlCtVn;
    End;

    FieldByName('ITE_TOTITE').AsFloat   := aInput.fltTotIte;
    FieldByName('ITE_ENTSAI').AsString  := aInput.strEntSai;

    FieldByName('ITE_TOTULT').AsFloat   := aInput.fltTotUlt;
    FieldByName('ITE_IMPULT').AsFloat   := fltImpUlt;
    FieldByName('ITE_TOTIMP').AsFloat   := aInput.fltTotImp;
    FieldByName('ITE_PREULT').AsFloat   := fltPreUlt;

    FieldByName('ITE_CUSITE').AsFloat   := fltCusIte;
    FieldByName('ITE_PRECUS').AsFloat   := fltPreCus;
    FieldByName('ITE_TOTCUS').AsFloat   := fltTotCus;

    FieldByName('ITE_PRECU2').AsFloat   := fltPreCu2;
    FieldByName('ITE_TOTCU2').AsFloat   := aInput.fltTotCu2;

    FieldByName('ITE_COMLUB').AsString  := aInput.strComLub;
    FieldByName('ITE_IPISAI').AsFloat   := aInput.fltIpiSai;
    FieldByName('ITE_DESMAX').AsFloat   := aInput.fltDesMax;

    FieldByName('ITE_PREVE1').AsFloat   := fltPreVe1;
    FieldByName('ITE_PREVE2').AsFloat   := fltPreVe2;
