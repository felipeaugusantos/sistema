  item.fltBasIcm := 100;
  item.fltTotIte := 100;
  item.strDocDev := '';
  item.strEspDev := '';
  item.strEmpDev := '';
  item.opcINFesp := opcVazio;


  pCalculaGravaICMSUFDestino('', '', item);

  Result := item.recDifalFCP.fltAlDifa;

end;

