procedure TFatVendaBase.pAtualizarCdsComCalculoTotGer(cdsVenda: TUniClientDataSet; const Item : TDadosFechamento);
  Var
    strCodSit: String;
    fltImcSTPV: Double;
    blnCalcST: Boolean;
    strCodAbf: String;
    fltTotalItem : Double;
    fltComLiq: Double;
    fltVlrCam: Double;

  function fItemTintaOuItemVidroOuItemAcabado: Boolean;
  begin
    Result := (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Or
              (cdsVenda.FieldByName('ITE_PROACA').AsInteger = 1) Or
              (fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString));
  end;
begin
  cdsVenda.Edit;
  cdsVenda.FieldByName('ITE_VAL_ST').AsFloat  := Item.fltValRet;
  cdsVenda.FieldByName('ITE_VALFCP').AsFloat  := Item.recDifalFCP.fltValFcp;
  cdsVenda.FieldByName('ITE_VFCPST').AsFloat  := item.VisualizarFcpIcmsST.fltValor;
  cdsVenda.FieldByName('ITE_VALIPI').AsFloat  := Item.fltValIpi;
  cdsVenda.FieldByName('ITE_IPISAI').AsFloat  := Item.fltAlqIpi;
  cdsVenda.FieldByName('ITE_ALQICM').AsFloat  := Item.fltAlqIcm;
  cdsVenda.FieldByName('ITE_BASICM').AsFloat  := Item.fltBasIcm;
  cdsVenda.FieldByName('ITE_VALICM').AsFloat  := Item.fltValIcm;
  cdsVenda.FieldByName('ITE_PRECU2').AsFloat  := Item.fltTotCu2 / cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
  cdsVenda.FieldByName('ITE_TOTCU2').AsFloat  := Item.fltTotCu2;
  cdsVenda.FieldByName('ITE_BASRET').AsFloat  := Item.fltBasRet;
  cdsVenda.FieldByName('ITE_VALRET').AsFloat  := Item.fltValRet;
  cdsVenda.FieldByName('ABF_CODFIS').AsString := Item.strCodFis;
  cdsVenda.FieldByName('ITE_VDIFAL').AsFloat  := Item.recDifalFCP.fltDifDes;

  If (fCfgSis('IMPCF4', varString, GetEmpCfg(Item.strEmpIte)) = 'S') And (Not fItemTintaOuItemVidroOuItemAcabado) Then
    cdsVenda.FieldByName('ITE_ICMSAI').AsFloat := fCalculaAliquota(Item.strCodIte, Item.strEmpIte, Item.strImpDir)
  Else
    cdsVenda.FieldByName('ITE_ICMSAI').AsFloat := Item.fltIcmSai;

  strCodAbf := fGetCodAbf(cdsVenda.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString));
  If Not fEmptyStr(GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString)) And (fBuscaAbfIcm(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, strCodAbf, fTrocaUFEndEntrega)) Then
    strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString)).AsString;

  fltComLiq := 0;
  If (blnEmCampanha) And
     (fCfgSis('MARMKP') = '4') Then
  Begin
    objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                 cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                 EmptyStr,
                                                 EmptyStr,
                                                 0,
                                                 fltVlrCam,
                                                 strCodCmg,
                                                 fltComLiq);
  End;

  objIcStPv.pAdd(cdsVenda.FieldByName('ITE_CODITE').AsString,
                 fGetEmpCalculoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString),
                 GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString),
                 fUFDestTrib(cdsVenda.FieldByName('ITE_EMPITE').AsString),
                 strCodSit,
                 fltImcSTPV,
                 blnCalcST,
                 0,
                 fltComLiq);

  cdsVenda.FieldByName('ITE_MARLUC').AsFloat := fCalculaPrecoVenda(2,Item.fltCusIte,
                                                                     Item.fltUniTar,
                                                                     0,
                                                                     Item.fltAlqIcm + fAlqDifIcmsPrecoDinamico(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, Item.strCodAbf, Item.strCodFis, cdsVenda.FieldByName('ITE_ICMSAI').AsFloat)
                                                                                    + fAlqFcpIcmsPrecoDinamico(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, Item.strCodAbf, Item.strCodFis, cdsVenda.FieldByName('ITE_ICMSAI').AsFloat, Item.fltUniTar),
                                                                     Item.fltImpFed,
                                                                     Item.fltDesOpe,
                                                                     fRetornaValCom(Item.fltComTbl),
                                                                     VS_strMARMKP,
                                                                     '',
                                                                     -1,
                                                                     fltImcSTPV,
                                                                     blnCalcST,
                                                                     IIF( not fCfgSis('CLPVDI', varBoolean, GetEmpCfg(Item.strEmpIte)), Item.recDifalFCP.fltAlDifa, 0),
                                                                     IIF( not fCfgSis('CLPVDI', varBoolean, GetEmpCfg(Item.strEmpIte)) And (Item.fltValRet = 0) And (Item.fltBasIcm <> 0), Item.recDifalFCP.fltPerFcp, 0),
                                                                     Item.fltOutVal,
                                                                     fRestringirElementosMargem);

  {Valor Contábil}
  cdsVenda.FieldByName('ITE_VLRCON').AsFloat := cdsVenda.FieldByName('ITE_TOTITE').AsFloat +
                                                fltTotRet                         +
                                                fltTotIpi                         +
                                                fltTotFcpST                       +
                                                fltTotCBS                         +
                                                fltTotIBS                         +
                                                fltTotIS;

  {Valor Contábil Unitário}
  fltTotalItem := (cdsVenda.FieldByName('ITE_UNITAR').AsFloat*cdsVenda.FieldByName('ITE_QTDITE').AsFloat) +
                  fltTotRet +
                  fltTotIpi +
                  fltTotFcpST +
                  fltTotCBS +
                  fltTotIBS +
                  fltTotIS;
  cdsVenda.FieldByName('ITE_UNICON').AsFloat := fFormataFloat(fltTotalItem / cdsVenda.FieldByName('ITE_QTDITE').AsFloat, 2);

  cdsVenda.FieldByName('ITE_RICMPR').AsString := Item.strRICMPR;
  cdsVenda.FieldByName('ITE_PERRIC').AsFloat  := Item.fltPerRic;

  cdsVenda.FieldByName('ITE_VALIBS').AsFloat := Item.fltValIBS;
  cdsVenda.FieldByName('ITE_VALCBS').AsFloat := Item.fltValCBS;
  cdsVenda.FieldByName('ITE_VAL_IS').AsFloat := Item.fltVal_IS;
  cdsVenda.FieldByName('ITE_CLATGE').AsString := Item.strClaFis;
  cdsVenda.FieldByName('ITE_VALPIS').AsFloat := Item.fltValPis;
  cdsVenda.FieldByName('ITE_VALCOF').AsFloat := Item.fltValCof;

  {Campos para calculo da margem de lucro - F4}
  pDefinirAliquotasParaOCalculoDaMargemDeLucro(cdsVenda, Item);

  cdsVenda.Post;
end;

procedure TFatVendaBase.pCalculaTotGerProdutoSelecionado(cdsVenda: TUniClientDataSet);
  Var
    strFilter: String;
    pOnProcessaItem: TOnProcessaItem;
begin
  pOnProcessaItem := nil;

  If fOpcaoDeDocumentoNotaDeComplemento Then
    Exit;

  Try
    { MONTA O FILTRO DO REGISTRO POSICIONADO }
    strFilter := 'AUTOINCREM = ' + cdsVenda.FieldByName('AUTOINCREM').AsString;

    { PREENCHE A MATRIZ DE ITENS SOMENTE COM O PRODUTO POSICIONADO }
    pPreencheMatrizFechamento(strFilter, pOnProcessaItem, cdsVenda);

    { CALCULA OS TOTAIS SOMENTE DO PRODUTO POSICIONADO }
    pSetBackupVar(VARIAVEIS_ZERA_PERCENTUAIS_DESCONTO_TRUE);
    pCalculaTotGer(True);
    pGetBackupVar(VARIAVEIS_ZERA_PERCENTUAIS_DESCONTO_TRUE);

    { GRAVA O VALOR DO ST E IPI DO PRODUTO POSICIONADO }
    if Not Assigned(arrMatItens) then
      Exit;

    pAtualizarCdsComCalculoTotGer(cdsVenda, arrMatItens[0]);
  Except

    On E: ExceptionAutComSugerirVendaPresencial Do
    Begin

      If (Not blnAvisouSugerirVendaPresencial) Then
      Begin
        fMensagem('Atenção!', E.Message, ['&Ok']);
        blnAvisouSugerirVendaPresencial := True;
        Abort;
      End;

    End;

    On E: ExceptionAutCom Do
    Begin
      If FApenasLevantaExcecao Then
        Raise
      Else
        pMensagemOk(E.Message);
    End;

    On E: EAbort Do
      Raise;

    On E: Exception Do
    Begin
      If blnRaiseError Then
        Raise Exception.Create('Falha FuncFat')
      Else If FApenasLevantaExcecao Then
        Raise
      Else
        pMensagensErro(E.Message, '');
    End;

  End;
end;

procedure TFatVendaBase.pRestaurarValorIcmOrg(arrOrigem, arrDestino : TMatrizFechamento);
  Var
    index: Integer;
begin
  For index := Low(arrOrigem) To High(arrOrigem) Do
  Begin
    arrDestino[index].fltIcmOrg := arrOrigem[index].fltIcmOrg;
    arrDestino[index].fltBasOrg := arrOrigem[index].fltBasOrg;
  End;
end;

procedure TFatVendaBase.pCalculaTotGerZonaFrancaComDesconto(blnZeraPercentuaisDesconto: Boolean = False;
  blnCalculaImpostos: Boolean = True; pOnProcessaItem: TOnProcessaItem = nil; blnPegaClassificacaoItem: Boolean = True);
  Var
    arrMatItensCopia : TMatrizFechamento;
    fltBasOrgCopia : Double;
    fltIcmOrgCopia : Double;
begin
  If (Not Self.blnPassouPelaTelaDescontoEConfirmou) Then
  Begin
    pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    Exit;
  End;

  Self.fltDesEsp := Self.fltDesComercialZFM;
  Self.FConsideraDescontoNaBaseDeCalculoOrgaoPublico := True;
  Try
    pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    fltBasOrgCopia := Self.fltBasOrg;
    fltIcmOrgCopia := Self.fltIcmOrg;
    pCopiarMatrizItens(Self.arrMatItens, arrMatItensCopia);
  Finally
    Self.FConsideraDescontoNaBaseDeCalculoOrgaoPublico := False;
  End;
  If (Self.fltIcmOrg > 0) And
     (MatchStr(Self.strEspDoc, ['OR','PD','NF','EL','PR']) Or (strOriF11 = 'S') Or (strOpcDocTrue = 'BD')) Then
  Begin
    Self.fltDesEsp := fFormataFloat(Self.fltIcmOrg, 2) + fFormataFloat(Self.fltDesComercialZFM, 2);
    pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    pRestaurarValorIcmOrg(arrMatItensCopia, Self.arrMatItens);
    Self.fltBasOrg := fltBasOrgCopia;
    Self.fltIcmOrg := fltIcmOrgCopia;
  End;
end;

procedure TFatVendaBase.pCalculaTotGer(blnZeraPercentuaisDesconto: Boolean = False;
                                       blnCalculaImpostos: Boolean = True;
                                       pOnProcessaItem: TOnProcessaItem = nil;
                                       blnPegaClassificacaoItem: Boolean = True);
begin

  If (fUsaDesEspZonaFranca) Then
  Begin
    If Not fMantemDescontoEspecialZonaFranca Then
      Self.fltDesEsp := 0;

    pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    If (Self.fltValDesEspZonFra > 0) And
       (MatchStr(Self.strEspDoc, ['OR','PD','NF','EL']) Or (strOriF11 = 'S')) Then
    Begin
      Self.fltDesEsp := Self.fltValDesEspZonFra;
      pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    End;
  End
  Else If (fPermiteDescontoComercialEmOperacaoZonaFrancaComDescontoDeIcms) Then
  Begin
    pCalculaTotGerZonaFrancaComDesconto(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
  End
  Else If (fAplicaIcmsComoDescontoZonaFranca) Or ((strBenRei = 'S') And (Not Self.fEhDevolucaoEspelhoOuParaFornecedor)) Then
  Begin
    Self.fltDesEsp := 0;
    pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    If (Self.fltIcmOrg + Self.fltValDesBenRei > 0) And
       (MatchStr(Self.strEspDoc, ['OR','PD','NF','EL','PR']) Or (strOriF11 = 'S') Or (strOpcDocTrue = 'BD')) Then
    Begin
      Self.fltDesEsp := Self.fltIcmOrg + Self.fltValDesBenRei;
      pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);
    End;
  End
  Else
    pCalculaTotGerSemaforo(blnZeraPercentuaisDesconto, blnCalculaImpostos, pOnProcessaItem, blnPegaClassificacaoItem);

  If (objNfeComplemento.tncTipoNota = tncComplementoStPerfilCnc) Then
  Begin
    FImpostosFaturamento.IcmsEfetivo.CalcularValorIcmsEfetivo;
