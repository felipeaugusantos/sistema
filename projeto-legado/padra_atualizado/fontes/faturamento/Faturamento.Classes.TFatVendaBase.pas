     (strOprFlj <> 'S')                   And
     (fCfgSis('EMPPRD') <> VS_strCodEmp)  And
     (Not fEmptyStr(fCfgSis('EMPPRD')))   Then
  Begin
    Result := (Pos(strIdePro, fCadEmp('TINDIS')) > 0);
