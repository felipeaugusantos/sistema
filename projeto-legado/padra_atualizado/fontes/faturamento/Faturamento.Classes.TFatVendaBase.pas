      strCodArt := qryGeral.FieldByName('CODART').AsString;
      strCodCno := qryGeral.FieldByName('CODCNO').AsString;
      strInsImo := qryGeral.FieldByName('INSIMO').AsString;
      strCodCib := qryGeral.FieldByName('CODCIB').AsString;
    End;
  End;

  strEndCob := qryGeral.FieldByName('ENDCOB').AsString;
  strBaiCob := qryGeral.FieldByName('BAICOB').AsString;
  strCepCob := FormatMaskText('99999-999;0;_', qryGeral.FieldByName('CEPCOB').AsString);
  strCidCob := fRetNomCidade(qryGeral.FieldByName('CIDCOB').AsString);
  strEstCob := fRetNomCidade(qryGeral.FieldByName('CIDCOB').AsString, 1);

  strDiferi := qryGeral.FieldByName('DIFERI').AsString;
  strDif_ST := qryGeral.FieldByName('DIF_ST').AsString;
  strSitP_C := qryGeral.FieldByName('SITP_C').AsString;
  strSitPCP := qryGeral.FieldByName('SITPCP').AsString;
  strMenP_C := qryGeral.FieldByName('MENP_C').AsString;

  fltRedIcmsCli := qryGeral.FieldByName('REDICM').AsFloat;

  strCodAti     := qryGeral.FieldByName('CODATI').AsString;
  strNomAti     := fRetAtividade(strCodAti);
  strCliAti     := qryGeral.FieldByName('CODATI').AsString;
  blnConstr     := fAtividadeConstrutora(qryGeral.FieldByName('CODATI').AsString); // Cliente Construtora?
  strCodCac     := qryGeral.FieldByName('CODCAC').AsString;
  strCliDAc     := qryGeral.FieldByName('CODEAC').AsString;

  strCliOrgDifal := qryGeral.FieldByName('ORPUDF').AsString;

  strObserv := qryGeral.FieldByName('OBSERV').AsString;

  strDesoST := qryGeral.FieldByName('DESOST').AsString;
  strDesoMT := qryGeral.FieldByName('DESOMT').AsString;

  strNatSer := qryGeral.FieldByName('NATSER').AsString;

  blnClienteEmCampanha := objCamGer.fVerificaClienteCampanha(strCliente);

  pProcessarDespesasOperacionaisComplementar(qryGeral.FieldByName('DESOPE').AsFloat);

  fltDescProfissional := fRetDescontoCliente(strCodCli);
  fltDescFidelidade   := fRetDescontoFidelidade(strCodCli);

  If Not blnRemessaConcreto Then
  Begin
    strCodDiv := '';

    If blnCarregaCondicaoPagamento Then
    Begin
      strConPag := '01000';
      strCndFor := fFormataCondPag(strConPag); // Condição de pagamento formatada

      If (fCfgSis('USACND', varBoolean)) Then
      Begin
        With qryGeral Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add('SELECT CND_CODIGO, CND_DESCRI, CND_CNDESP, CND_TRACNC FROM CADCND WHERE CND_CNDPAG = "01000" LIMIT 1');
          Open;

          If Not IsEmpty Then
          Begin
            strCodCnd      := FieldByName('CND_CODIGO').AsString;   // Condicao      - Codigo
            strDesCnd      := FieldByName('CND_DESCRI').AsString;   // Condicao      - Descricao
            blnCndEsp      := (FieldByName('CND_CNDESP').AsString = 'S');   // Condicao      - Especial (S/N)
            blnCndTravaCli := (FieldByName('CND_TRACNC').AsString = 'S');   // Condicao     - Trava de clientes que não compram a mais de XX dias
          End;
        End;

      End;

      If (fCfgSis('USAFPG', varBoolean)) Then
      Begin
        strCodFpg := '001';           // Código da Forma de Pagamento
        strDesFpg := 'DINHEIRO';      // Descrição da Forma de Pagamento
      End;
    End;

  End;

  qryGeral.Close;
  FreeAndNil(qryGeral);
end;

function TFatVendaBase.fTemLoteInformadoParaProducaoAvulsadeTintaDeMaquina(
  strIdepPro: String; blnTemLoteInformado: Boolean): Boolean;
begin
  Result := false;

  if blnTemLoteInformado Then
    Exit;

  If (strIdepPro = 'NOR') Then
    Exit;

  If (Self.strOpcDoc <> 'PA') then
    Exit;

  Result := true;
end;

function TFatVendaBase.fInformaLoteParaTransferenciaAutomatica(blnTemLoteInformado: Boolean): Boolean;
begin
  Result := False;

  If (Not Self.blnGerandoTEAutomatica) Then
    Exit;

  If (blnTemLoteInformado) Then
    Exit;

  Result := True;
end;

function TFatVendaBase.fInformaLoteParaBrindesPromocao(blnTemLoteInformado: Boolean): Boolean;
begin
  Result := False;

  If (Not Self.blnDocumentoBrindePromocao) Then
    Exit;

  If (blnTemLoteInformado) Then
    Exit;

  Result := True;
end;

function TFatVendaBase.fRetComissaoFornecedor(strCodFor: String): Double;
begin

  Result := 0;

  If fEmptyStr(strCodFor) Then
    Exit;

  Result := fCampoTabela('FOR_PERCOM', 'CADFOR', ['FOR_CODFOR'], [strCodFor], False);

end;

function TFatVendaBase.fTemMensagemParaCFOP(strAutInc, strClaFis: string): Boolean;
var
  qryCFOPMsg: TUniQuery;
begin
  try
    qryCFOPMsg := fCriaQuery();
    qryCFOPMsg.Close;
    qryCFOPMsg.SQL.Clear;
    qryCFOPMsg.SQL.Add('SELECT CFO_CFOPMS FROM MSGCFO WHERE CFO_CFOPMS = :CFOPMS AND CFO_SEQABF = :SEQABF');
    qryCFOPMsg.ParamByName('CFOPMS').AsString := strClaFis;
    qryCFOPMsg.ParamByName('SEQABF').AsString := strAutInc;
    qryCFOPMsg.Open;
    Result := not qryCFOPMsg.IsEmpty;
  finally
    FreeAndNil(qryCFOPMsg);
  end;
end;

{**********************************************}
{ VERIFICA SE HA ITENS COM VALOR UNITARIO ZERO }
{*******************************************AA*}
procedure TFatVendaBase.pTravaItemUnitarZero(strCodIte, strDesIte: String;
  fltUnitar: Double; strProEmb, strBrinde, strClaFis: String; fltPrecoVenda : Double = 0  );
begin
  If (fltUnitar = 0.0) And (strCodIte <> fCfgSis('ITEFRE')) And
                           (Not fEhItemEspecial(strCodIte)) And
                           (Not fEhItemServico(strCodIte) ) And
                           (strProEmb <> 'S') And (strBrinde <> 'S') And
                           (Not blnOrigemAtivacaoContrato) And
                           (Not Self.FFulfillment.EhOperacaoFulfillment) And
                           (Not fEhComplementoDeValorComItemBonificado(strClaFis)) Then
  Begin
    Raise ExceptionAutCom.Create('O valor unitário do item não pode ser zero.' + #13#10 +
                                 'Código = '          + strCodIte         + ',' + #13#10 +
                                 'Descrição = '       + strDesIte         + ',' + #13#10 +
                                 'Valor Unitário = '  + FloatToStrF(fltUniTar, ffNumber, 15, 2) + ' / Conf. Decimais = ' + IntToStr(VS_intDecUni) +
                                 IIF(fltPrecoVenda > 0,',' + #13#10 +
                                 'Preço de Venda = '  + FloatToStrF(fltPrecoVenda, ffNumber, 15, 4) + ' / Tabela de Preço  = ' + strTabPre,''));
  End;
end;
