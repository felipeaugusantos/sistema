procedure TFatVendaBase.pRecalculaComissao(strAutInc: String);
  Var
    blnRecCusRea : Boolean;

  function fForcaRecalculoDeComissao: Boolean;
  Begin
    Result := (fCfgSis('PCMPRO', varString) = '3') And
              (fCfgSis('MARIDE', varString) = 'N') And
              (fCfgSis('COCURE', varString) = 'N') And
              (fCfgSis('EXBCOM', varString) = 'N');
  End;

begin
  blnRecCusRea := Self.fConsiderarComissaoNoCalculoCustoRealMargem Or fForcaRecalculoDeComissao;
  If ((fCfgSis('EXBCOM', varString) = 'S') Or (blnRecCusRea) Or (fCfgSis('OPCCOM') = 'MD')) And (Not fEmptyStr(Self.strCliEst)) Then
  Begin
    (cdsVenda.FieldByName('ITE_COMVEN') As TFloatField).DisplayFormat := '#,##0.00';
    Self.fRecalculaComissao(True, strAutInc, blnRecCusRea, True);
  End;
End;

