procedure TFatVendaBase.pDefineNcmDaTintaDeMaquina(var item: TDadosFechamento);
begin
  {******************************}
  {* LIMPA O CAMPO NCM DA TINTA *}
  {***************************JC*}
  item.strNcmTin := '';

  If (item.strIdePro <> 'NOR') Then
  Begin
    {******************************************************************************************}
    {* CASO FOR TINTA AUTOMOTIVA E ESTEJA CONFIGURADO PARA UTILIZAR O NCM DO PRODUTO DA VENDA *}
    {* PARA AS TINTAS AUTOMOTIVAS (CFG_NCMAUT), ENTAO UTILIZA A CLASSIFICACAO DE IPI DO ITEM  *}
    {***************************************************************************************JC*}

    If Assigned(fTipoTinta) And (fTipoTinta(item.strIdePro) = ttAutomotiva) Then
    Begin
      If fCfgSis('NCMAUT') = '2' Then //Produto para venda tinta de maquina
        item.strNcmTin := item.strClaIpi;
    End;

    {****************************************************************************************************}
    {* CASO NAO SEJA TINTA AUTOMOTIVA OU NAO ESTEJA CONFIGURADO PARA UTILIZAR O NCM DO PRODUTO DA VENDA *}
    {* PARA AS TINTAS AUTOMOTIVAS (CFG_NCMAUT), ENTAO TENTA RETORNAR O NCM DO ITEM EMBALAGEM.           *}
    {*************************************************************************************************JC*}
    If fEmptyStr(item.strNcmTin) Then
      item.strNcmTin := fRetClaIpi(item.strIteEmb);

    {****************************************************************************************************}
    {* CASO O NCM DA TINTA AINDA NAO TENHA SIDO DEFINIDO, ENTAO UTILIZA O DO PROPRIO ITEM DA VENDA      *}
    {*************************************************************************************************JC*}
    If fEmptyStr(item.strNcmTin) Then
      item.strNcmTin := item.strClaIpi;

    {****************************************************************************************************}
    {* VALIDA O NCM DA TINTA, CASO NAO SEJA VALIDO DEIXA VAZIO PARA A LIBNFE UTILIZAR O DO PROPRIO ITEM *}
    {*************************************************************************************************JC*}
    If (Length(item.strNcmTin) <> 8) And (Length(item.strNcmTin) <> 2) Then
    Begin
      item.strNcmTin := '';
    End;

    {*****************************************************************************************************}
    {* CASO O NCM DA TINTA TENHA SIDO DEFINIDO E VALIDADO ENTAO DEFINE O MESMO COMO CLASSIFICACAO DE IPI *}
    {**************************************************************************************************JC*}
    If Not fEmptyStr(item.strNcmTin) Then
      item.strClaIpi := item.strNcmTin;
  End
  Else
  If (Pos(strOpcDoc, 'OR_PD') > 0) And (Pos('ITEM ESPECIAL', fCadIte(item.strCodIte).FieldByName('ITE_DESITE')) > 0) Then
  Begin
    item.strNcmTin := item.strClaIpi;
  End;
end;

procedure TFatVendaBase.pAddDocsDevEntFut(stlDocsDevEntFut: TStringList; strTabDev, strAutIncDev: String;
                                          Var strNumDocOriFut: String; Var strEspDocOriFut: String; Var strEmpDocOriFut: String; Var strDtaEntOriFut: String; Var strClaFisDocDev: String);
var
  qryDev: TUniQuery;

begin
  strNumDocOriFut := '';
  strEspDocOriFut := '';
  strEmpDocOriFut := '';
  strDtaEntOriFut := '';
  strClaFisDocDev := '';

  if fEmptyStr(strAutIncDev) or (strTabDev <> 'MOVDET') then
    Exit;

  qryDev := fCriaQuery;
  try
    qryDev.SQL.Add('SELECT DET_DEV.DET_CLAFIS, DET_FUT.DET_NUMDOC, DET_FUT.DET_ESPDOC, DET_FUT.DET_CODEMP, DET_FUT.DET_DTAENT');
    qryDev.SQL.Add('  FROM MOVDET DET_DEV');
    qryDev.SQL.Add('       INNER JOIN MOVTRI TRI_DEV ON DET_DEV.AUTOINCREM = TRI_DEV.DET_SEQGER');
    qryDev.SQL.Add('       INNER JOIN MOVDET DET_FUT ON TRI_DEV.DET_INCFUT = DET_FUT.AUTOINCREM');
    qryDev.SQL.Add(' WHERE DET_DEV.AUTOINCREM = :AUTINC');

    qryDev.ParamByName('AUTINC').AsString := strAutIncDev;
    qryDev.Open;

    if qryDev.IsEmpty or fEmptyStr(qryDev.FieldByName('DET_NUMDOC').AsString) then
      Exit;

    strNumDocOriFut := qryDev.FieldByName('DET_NUMDOC').AsString;
    strEspDocOriFut := qryDev.FieldByName('DET_ESPDOC').AsString;
    strEmpDocOriFut := qryDev.FieldByName('DET_CODEMP').AsString;
    strDtaEntOriFut := qryDev.FieldByName('DET_DTAENT').AsString;
    strClaFisDocDev := qryDev.FieldByName('DET_CLAFIS').AsString;

    stlDocsDevEntFut.Add(strNumDocOriFut + '-' +
                         strEspDocOriFut + '-' +
                         strEmpDocOriFut + '-' +
                         strDtaEntOriFut);
  finally
    FreeAndNil(qryDev);
  end;

  stlDocsDevEntFut.Sorted := True;
end;

