function TFatVendaBase.fGravarMovIcdConsiderandoImpostosDigitados(item: TDadosFechamento): Boolean;
begin
  Result := False;

  If (Not (Pos(Self.strOpcDoc, 'NE_OF_OE_FE_OU_') > 0)) Then
    Exit;

  If (Not Self.DigImp.blnOperadorDigitouImpostos) Then
    Exit;

  If (item.VisualizarFcpIcms.fltBase > 0) Then
    Exit(True);

  If (item.VisualizarFcpIcms.fltValor > 0) Then
    Exit(True);

  If (item.VisualizarFcpIcms.fltAliquota > 0) Then
    Exit(True);
end;

