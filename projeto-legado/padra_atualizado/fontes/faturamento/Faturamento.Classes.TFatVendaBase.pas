function TFatVendaBase.fAtendeRegraFiscalEndEntrega:Boolean;
  const
    ENDERECO_DE_ENTREGA_DETERMINADO_NA_VENDA = '2';

  var
    LChaves   : TStringList;
    LContador : Integer;
begin

  If (strOpcDoc.Equals('DV')) And (Not fEmptyStr(Self.strChavesDocsDev)) And (Not strRegFis.Equals(ENDERECO_DE_ENTREGA_DETERMINADO_NA_VENDA)) Then
  Begin

    LChaves := TStringList.Create;

    Try

      LChaves.Sorted     := True;
      LChaves.Duplicates := dupIgnore;
      LChaves.CommaText  := Self.strChavesDocsDev;

      For LContador := 0 To LChaves.Count -1 Do
      Begin
        If DocumentoDeImportacaoFulfillment(LChaves[LContador]) Then
        Begin
          strRegFis := ENDERECO_DE_ENTREGA_DETERMINADO_NA_VENDA;
          Break;
        End;
      End;

    Finally
      FreeAndNil(LChaves);
    End;

  End;

  Result := TFunctionFuncoesFaturamento.fAtendeRegraFiscalEndEntrega(strOpcDoc,
                                                                     fAtividadeConstrutora(strCliAti),
                                                                     fDocumentoParaFornecedor,
                                                                     strRegFis);
end;

function TFatVendaBase.DocumentoDeImportacaoFulfillment(AChaAce : String) : Boolean;
  const
    SQL = 'SELECT * FROM NFEIMP WHERE NFE_ACESSO = :ACESSO';
  var
    LNfeImp : TUniQuery;
Begin

  Result := False;

  If AChaAce.IsEmpty Then
    Exit;

  LNfeImp := fCriaQuery(Nil);

  Try

    LNfeImp.Close;
    LNfeImp.SQL.Clear;
    LNfeImp.SQL.Add(SQL);

    LNfeImp.ParamByName('ACESSO').AsString := AChaAce;
    LNfeImp.Open;

    Result := Not LNfeImp.IsEmpty;

  Finally
    FreeAndNil(LNfeImp);
  End;

End;

function TFatVendaBase.DocumentoDeImportacaoFulfillment(ANumDoc, AEspDoc, ACodEmp : String) : Boolean;
  const
    SQL = 'SELECT * FROM NFEIMP WHERE NFE_NUMDOC = :NUMDOC AND NFE_ESPDOC = :ESPDOC AND NFE_CODEMP = :CODEMP';
  var
    LNfeImp : TUniQuery;
Begin

  Result := False;

  If ANumDoc.IsEmpty Then
    Exit;

  If AEspDoc.IsEmpty Then
    Exit;

  If ACodEmp.IsEmpty Then
    Exit;

  LNfeImp := fCriaQuery(Nil);

  Try

    LNfeImp.Close;
    LNfeImp.SQL.Clear;
    LNfeImp.SQL.Add(SQL);

    LNfeImp.ParamByName('NUMDOC').AsString := RightStr(ANumDoc, 9);
    LNfeImp.ParamByName('ESPDOC').AsString := AEspDoc;
    LNfeImp.ParamByName('CODEMP').AsString := ACodEmp;
    LNfeImp.Open;

    Result := Not LNfeImp.IsEmpty;

  Finally
    FreeAndNil(LNfeImp);
  End;

End;

function TFatVendaBase.fGetEmpCalculoItem(strEmpresaItem: String = ''; strCodEmpDef: String = ''): String;
begin
  If fEmptyStr(strCodEmpDef) Then
    strCodEmpDef := VS_strCodEmp;

  If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
    Exit(VS_strCodEmp);

  If Not fEmptyStr(VS_EmpCfgSisDes) Then
    Exit(VS_EmpCfgSisDes);

  If Self.blnPraticarPrecosEmpresaFaturamento Then
    Exit(fGetEmpPrecoVendaItem(IfEmptyStr(strEmpresaItem, strCodEmpDef)));

  If fEstaEmAbastecimentoPorDeposito Then
    Exit(IfEmptyStr(strEmpresaItem, strCodEmpDef));

  Result := strCodEmpDef;
end;

function TFatVendaBase.fGetEmpPrecoVendaItem(const strEmpresaItem: string): String;
begin
  If Not fEmptyStr(Self.fRetornaEmpresaTE_CD) Then
    Exit(Self.fRetornaEmpresaTE_CD);

  If (Pos(strOpcDoc, 'PD_OR_') > 0) and fCfgSis('ABADEP', varBoolean) Then
  Begin
    If fEstaEmAbastecimentoPorDeposito Then
    Begin
      If fEstaEmAbastecimentoPorDepositoUsandoPrecoLocal Then
        Exit(VS_strCodEmp);

      Exit(Self.strEmpresaAbastecimentoDeposito);
    End;

    If Self.blnEmpFat Then
      If strEmpresaItem <> EmptyStr Then
        Exit(strEmpresaItem);

    Exit(VS_strCodEmp);
  End;

  If (Pos(strOpcDoc, 'PD_OR_') > 0) and fCfgSis('UTIRE2', varBoolean) Then
  Begin
    If Self.blnRegimeEspecialPorEmpresaComFaturamentoDuplo And (Not fEmptyStr(Self.strEmpresaRegimeEspecialPorEmpresa)) Then
      Exit(Self.strEmpresaRegimeEspecialPorEmpresa);

    If Self.blnEmpFat Then
      If strEmpresaItem <> EmptyStr Then
        Exit(strEmpresaItem);

    Exit(VS_strCodEmp);
  End;

  If Self.blnPraticarPrecosEmpresaFaturamento Then
  Begin
    If (Self.blnEmpFat) Or (strOriF11 = 'S') Then
      If strEmpresaItem <> EmptyStr Then
        Exit(strEmpresaItem);

    Exit(VS_strCodEmp);
  End;

  Result := VS_strCodEmp;
end;

function TFatVendaBase.fGetEmpPrecoVendaItemTinta(const strEmpresaItem: string): String;
begin
  Result := IIF(Self.blnEmpFat, strEmpresaItem, Self.fEmpresaSaldoMatriz_CD);

  If (Pos(strOpcDoc, 'PD_OR_') > 0) and fCfgSis('ABADEP', varBoolean) Then
  Begin
    If fEstaEmAbastecimentoPorDeposito Then
    Begin
      If fEstaEmAbastecimentoPorDepositoUsandoPrecoLocal Then
        Result := VS_strCodEmp
      Else
        Result := Self.strEmpresaAbastecimentoDeposito;
    End;
  End;
end;

function TFatVendaBase.fGetEmpPrecoPromoItem(const strEmpresaItem: string; const strEmpresaOrig: String=''): String;
