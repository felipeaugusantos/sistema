function TFatVendaBase.fRetReferenciaTinta(strCodIte : String) : String;
Var
  qryGen : TUniQuery;
begin
  Try
    qryGen := fCriaQuery;

    qryGen.Close;
    qryGen.SQL.Text := 'SELECT ITE_REFERE '+
                       '  FROM CADITE '+
                       ' WHERE ITE_CODITE  = :CODITE '+
                       '   AND ITE_CODEMP  = :CODEMP ';

    qryGen.ParamByName('CODITE').AsString := strCodIte;
    qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
