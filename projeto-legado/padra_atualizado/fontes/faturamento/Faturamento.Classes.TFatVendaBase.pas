  Result := (Pos(RightStr(strClaFisP, 3),'152_409_905_906_552_') > 0) And
            (fEmpresaZeraIcmsTE(IIF(fEmptyStr(strEmp_TE),VS_strCodEmp, strEmp_TE), strCodCli));
end;

procedure TFatVendaBase.pZerarIcmsNotaTransferenciaEstadosEspecificos;
  Var
    intIdxIni,
    intIdxFin,
    intCnt : Integer;
begin
  If (intIndexMatriz = -1) Then
  Begin
    intIdxIni := 0;
    intIdxFin := Length(Self.arrMatItens)-1;
  End
  Else
  Begin
    intIdxIni := intIndexMatriz;
    intIdxFin := intIndexMatriz;
  End;

  For intCnt := intIdxIni To intIdxFin Do
  Begin
    pZerarDadosIcmsMatrizItens(False, intCnt);
    pZerarDadosIpiMatrizItens(True, intCnt);
    pZerarDadosStMatrizItens(intCnt);

    If Pos(Self.arrMatItens[intCnt].strCodFis, CST_TRIBUTADO) > 0 Then
      Self.arrMatItens[intCnt].strCodFis := LeftStr(Self.arrMatItens[intCnt].strCodFis, 1) + '41';
  End;

  If (intIndexMatriz = -1) Then
  Begin
    Self.fltBasIcm := 0;
    Self.fltTotIcm := 0;
    Self.fltBasIpi := 0;
    Self.fltTotIpi := 0;
    Self.fltBasRet := 0;
    Self.fltTotRet := 0;
  End;
end;

procedure TFatVendaBase.pGeraAlqIcm(strComLub: String; fltAlqIcm, fltBasIcm,
  fltValIcm, fltTotIte, fltBasIpi, fltValIpi, fltDesAce: Double);
  Var
    intPosAtual: Integer;
    intContador: Integer;
    intTamMat: Integer;
begin

  intTamMat := Length(arrAlqIcm);
  intPosAtual := -1;

  For intContador := 0 To intTamMat -1 Do
  Begin

    If (arrAlqIcm[intContador].fltAlqIcm = fltAlqIcm) And
       (arrAlqIcm[intContador].strComLub = strComLub) Then
    Begin
      intPosAtual := intContador;
      Break;
    End;

  End;

  If intPosAtual < 0 Then
  Begin

    SetLength(arrAlqIcm, intTamMat+1);
    intPosAtual := intTamMat;

  End;

  arrAlqIcm[intPosAtual].strComLub := strComLub;
  arrAlqIcm[intPosAtual].fltAlqIcm := fltAlqIcm;
  arrAlqIcm[intPosAtual].fltBasIcm := fFormataFloat(arrAlqIcm[intPosAtual].fltBasIcm + fltBasIcm, 2);
  arrAlqIcm[intPosAtual].fltValIcm := fFormataFloat(arrAlqIcm[intPosAtual].fltValIcm + fltValIcm, 2);
  arrAlqIcm[intPosAtual].fltTotIte := fFormataFloat(arrAlqIcm[intPosAtual].fltTotIte + fltTotIte, 2);
  arrAlqIcm[intPosAtual].fltBasIpi := fFormataFloat(arrAlqIcm[intPosAtual].fltBasIpi + fltBasIpi, 2);
  arrAlqIcm[intPosAtual].fltValIpi := fFormataFloat(arrAlqIcm[intPosAtual].fltValIpi + fltValIpi, 2);
  arrAlqIcm[intPosAtual].fltDesAce := fFormataFloat(arrAlqIcm[intPosAtual].fltDesAce + fltDesAce, 2);

end;

function TFatVendaBase.fTotalizaBaseDeIcmsSimplesNacional(const item: TDadosFechamento): boolean;

  const
    SUBSTITUTO_TRIBUTARIO : string = '2';

  function fItemSubstituido: boolean;
  begin
    Result := (Pos(item.strCodFis, CST_SUBSTITUICAO) > 0);
  end;

  function fSubstitutoTributarioIndustria: boolean;
  begin
    Result := (IIF(fCfgSis('SIMSUB', varString, GetEmpCfg(item.strEmpIte)) = '1', fItemSubstituido, not fItemSubstituido) and
              (fCfgSis('CONIPI', varString, GetEmpCfg(item.strEmpIte)) = 'S') and
              (fRegimeSubstituicaoTributaria(GetEmpCfg(item.strEmpIte), Self.fOpcDocClaSub) = SUBSTITUTO_TRIBUTARIO))
  end;

begin
  Result := (TFunctionFuncoesFaturamento.OptantePorSimplesNacional(GetEmpCfg(item.strEmpIte)) = 'S') and
            ((not fItemSubstituido) or (fSubstitutoTributarioIndustria));
end;

