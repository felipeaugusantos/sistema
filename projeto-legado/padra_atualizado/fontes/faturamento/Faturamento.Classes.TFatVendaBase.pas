                                                                         FieldByName('ITE_QTDITE').AsFloat,
                                                                         '');
      If (fFormataFloat(FieldByName('ITE_UNIORI').AsFloat, VS_intDecUni) <> fFormataFloat(FieldByName('ITE_UNIDIG').AsFloat, VS_intDecUni)) Then
        FieldByName('ITE_VLPEMB').AsFloat := fFormataFloat((FieldByName('ITE_UNIORI').AsFloat - (FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_PEREMB').AsFloat / 100)), VS_intDecUni)
      Else
        FieldByName('ITE_VLPEMB').AsFloat := FieldByName('ITE_UNIORI').AsFloat;

      FieldByName('ITE_PEREMB').AsFloat := fFormataFloat(((1 - (FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_VLPEMB').AsFloat)) * 100), VS_intDecUni);

      FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_VLPEMB').AsFloat), VS_intDecUni);
    End
    Else
    Begin
      FieldByName('ITE_PEREMB').AsFloat := 0;
      FieldByName('ITE_VLPEMB').AsFloat := 0;
      FieldByName('ITE_VLBEMB').AsFloat := fFormataFloat((FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNIORI').AsFloat), VS_intDecUni);
    End;

    FieldByName('ITE_SOBENC').AsString := aInput.strSobEnc;
    FieldByName('ITE_USADCE').AsString := fUsaCfopDecretoCeara(aInput.strCodIte);
    FieldByName('ITE_CLADCE').AsString := fRetornaCfopDecretoCeara(aInput.strCodIte);
    FieldByName('ITE_LCTBAR').AsString := IIF(aInput.blnTipBusCodBar,'S','N');

    FieldByName('ITE_TCKQBT').AsString := aInput.strTckQbt;

    Post;

    If aInput.blnCalcularComissao Then
      pRecalculaComissao(FieldByName('AUTOINCREM').AsString);

    If ((fEhAutocenter) Or (fCfgSis('RETDEV', varString) = 'S')) And (Not fEhItemServico(aInput.strCodIte)) Then
      pInsereRegistroLogItensSep(aInput.cdsDados, strStaLog, fltQtdAnt, True);

    If (Assigned(aInput.btnAdicionar)) Then
      aInput.btnAdicionar.Tag  := 0;

    If (strOpcDoc = 'NP') And Assigned(objIcmsItemImob) Then
      objIcmsItemImob.intAutInc := FieldByName('AUTOINCREM').AsInteger;

    pDefinirAutIncItemLogLib(aInput.strCodIte, FieldByName('AUTOINCREM').AsInteger);

    if aInput.blnCalcularImpostos then
      pCalculaTotGerProdutoSelecionado(aInput.cdsDados);

  End;

End;
