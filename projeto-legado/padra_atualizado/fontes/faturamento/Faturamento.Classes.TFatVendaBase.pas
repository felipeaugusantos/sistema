{$IFNDEF LINUX}
function TDadosFazenda.fSelecionarFazenda: Boolean;
var
  frmCadCliFazendas: TfrmCadCliFazendas;
Begin
  Try
    pCriarFormularios(TfrmCadCliFazendas, frmCadCliFazendas);

    frmCadCliFazendas.blnVendas := True;
    frmCadCliFazendas.strCodFaz := strCodFaz;
    frmCadCliFazendas.strCodCli := strCodCli;

    frmCadCliFazendas.ShowModal;

    Result := frmCadCliFazendas.blnConfirma;

    If Result Then
    Begin
      strCodFaz := frmCadCliFazendas.strCodFaz;
      pCarregarDadosFazenda;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[pAlteraCadFazendas]');
    End;
  End;

  pFreeAndNil(frmCadCliFazendas);
end;
{$ENDIF}

procedure TDadosFazenda.pLimparDadosFazenda;
begin
  strCodCli := '';
  strCodFaz := '';
  strNomFaz := '';
  strEndere := '';
  strBairro := '';
  strEndNum := '';
  strEndCom := '';
  strEndCep := '';
  strCodCid := '';
  strNomCid := '';
  strEstado := '';
  intCgcCpf := 0;
  strNuCnpj := '';
  strNumIes := '';
  strNomCon := '';
  strTelCon := '';
end;

procedure TDadosFazenda.pCarregarDadosFazenda;
  Var
    qryFazenda: TUniQuery;
Begin
  qryFazenda := fCriaQuery(nil);

  With qryFazenda, SQL Do
  Begin
    Clear;
    Add('SELECT        ');
    Add('  *           ');
    Add('FROM          ');
    Add('  CADFAZ      ');
    Add('WHERE FAZ_CODCLI = :CODCLI AND');
    Add('      FAZ_CODFAZ = :CODFAZ    ');

    ParamByName('CODCLI').AsString := strCodCli;
    ParamByName('CODFAZ').AsString := strCodFaz;

    Open;

    If Not IsEmpty Then
    Begin
      strNomFaz := FieldByName('FAZ_NOMFAZ').AsString;
      strEndere := FieldByName('FAZ_ENDERE').AsString;
      strEndNum := FieldByName('FAZ_ENDNUM').AsString;
      strBairro := FieldByName('FAZ_BAIRRO').AsString;
      strEndCom := FieldByName('FAZ_ENDCOM').AsString;
      strEndCep := FieldByName('FAZ_C_E_P_').AsString;
      strCodCid := FieldByName('FAZ_CODCID').AsString;
      strNomCid := fRetNomCidade(FieldByName('FAZ_CODCID').AsString);
      strEstado := fRetNomCidade(FieldByName('FAZ_CODCID').AsString, 1);
      intCgcCpf := FieldByName('FAZ_CGCCPF').AsInteger;
      strNuCnpj := FieldByName('FAZ_C_G_C_').AsString;
      strNumIes := FieldByName('FAZ_I_E_S_').AsString;
      strNomCon := FieldByName('FAZ_NOMCON').AsString;
      strTelCon := FieldByName('FAZ_TELCON').AsString;
    End
    Else
      pLimparDadosFazenda;
  End;

  FreeAndNil(qryFazenda);
end;

{ TItensEstrutura }

procedure TItensEstrutura.Add(item: TSubItemEstrutura);
begin
  SetLength(FItens, Length(FItens) + 1);
  FItens[Length(FItens) - 1] := item;
end;

procedure TItensEstrutura.Clear;
begin
  SetLength(FItens, 0);
end;

function TItensEstrutura.GetCount: Integer;
begin
  Result := Length(FItens);
end;

function TItensEstrutura.GetSubItem(index: integer): TSubItemEstrutura;
begin
  Result := FItens[index];
end;

function TItensEstrutura.GetValTotal: Double;
  Var
    intItem: Integer;
begin
  Result := 0;
  For intItem := 0 To ItemsCount -1 Do
    Result := Result + Items[intItem].fltTotVen;
end;

function TItensEstrutura.GetValUnitario: Double;
begin
  If FQuantidadeItemEstrutura = 0 Then
    Exit(0);
  Result := GetValTotal / FQuantidadeItemEstrutura;
end;

procedure TItensEstrutura.pAcertarPrecos(fltValTot: Double);
  Var
    intItem: Integer;
    intDecUni: Integer;
    fltTotAnt: Double;
begin
  If ItemsCount = 0 Then
    Exit;

  If (fCfgSis('RATEST', varString) = 'C') Then
    Exit;

  fltTotAnt := GetValTotal;
  intDecUni := fCfgSis('DECUNI', VarInteger);

  For intItem := 0 To ItemsCount -1 Do
  Begin
    FItens[intItem].fltPreVen := fFormataFloat( ( FItens[intItem].fltTotVen / fltTotAnt * fltValTot ) /
                                                  FItens[intItem].fltQtdTot, intDecUni );

    FItens[intItem].fltTotVen := fFormataFloat(FItens[intItem].fltPreVen * FItens[intItem].fltQtdTot, 2);
  End;

  If fFormataFloat(GetValTotal, 2) <> fFormataFloat(fltValTot, 2) Then
  Begin
    FItens[0].fltTotVen := fFormataFloat(FItens[0].fltTotVen + fltValTot - GetValTotal, 2);
    FItens[0].fltPreVen := FItens[0].fltTotVen / FItens[0].fltQtdTot;
  End;

end;

procedure TItensEstrutura.pCarregarEstrutura(strCodIte: String; fltQtdIte: Double;
  strCodEmp: String = ''; blnEntrega: Boolean = False);
  Var
    qryDetMat, qryIteGer: TUniQuery;
    recSubIte: TSubItemEstrutura;
Begin
  FQuantidadeItemEstrutura := fltQtdIte;

  Self.Clear;

  qryIteGer := fCriaQuery;
  qryDetMat := fCriaQuery;

  Try
    qryIteGer.SQL.Add('SELECT SQL_NO_CACHE ');
    qryIteGer.SQL.Add('  ITE_IMPLIS,       ');
    qryIteGer.SQL.Add('  ITE_SALDOS,       ');
    qryIteGer.SQL.Add('  ITE_PRECUS,       ');
    qryIteGer.SQL.Add('  ITE_PREVE1        ');
    qryIteGer.SQL.Add('FROM ITEGER         ');
    qryIteGer.SQL.Add('WHERE ITE_CODITE = :CODITE ');
    qryIteGer.SQL.Add('  AND ITE_CODEMP = :CODEMP ');

    qryDetMat.SQL.Add('SELECT SQL_NO_CACHE ');
    qryDetMat.SQL.Add('  DMT_ITESUB,       ');
    qryDetMat.SQL.Add('  DMT_QTDITE        ');
    qryDetMat.SQL.Add('FROM DETMAT         ');
    qryDetMat.SQL.Add('INNER JOIN GERMAT G ON DMT_SEQGER = G.AUTOINCREM ');
    qryDetMat.SQL.Add('WHERE GMT_CODITE = :CODITE ');

    qryDetMat.ParamByName('CODITE').AsString := strCodIte;
    qryDetMat.Open;

    qryDetMat.First;

    Try
      While Not qryDetMat.Eof Do
      Begin
        FillChar(recSubIte, SizeOf(recSubIte), #0);

        If fCfgSis('EMPCAR', varBoolean) And blnEntrega Then
          recSubIte.strEmpCar := fRetEmpCarregamentoItem(qryDetMat.FieldByName('DMT_ITESUB').AsString);

        qryIteGer.Close;
        qryIteGer.ParamByName('CODITE').AsString := qryDetMat.FieldByName('DMT_ITESUB').AsString;
        qryIteGer.ParamByName('CODEMP').AsString := IIF(Not recSubIte.strEmpCar.IsEmpty, recSubIte.strEmpCar,
                                                        IIF(Not strCodEmp.IsEmpty, strCodEmp, VS_strCodEmp));
        qryIteGer.Open;

        recSubIte.strCodigo := qryDetMat.FieldbyName('DMT_ITESUB').AsString;
        recSubIte.strImpLis := qryIteGer.FieldbyName('ITE_IMPLIS').AsString;
        recSubIte.fltSaldos := qryIteGer.FieldbyName('ITE_SALDOS').AsFloat;
        recSubIte.fltQtdSub := qryDetMat.FieldbyName('DMT_QTDITE').AsFloat;
        recSubIte.fltQtdTot := fFormataFloat(qryDetMat.FieldbyName('DMT_QTDITE').AsFloat * fltQtdIte, fCfgSis('DECQTD', varInteger));
        recSubIte.fltPreVen := fFormataFloat(qryIteGer.FieldByName('ITE_PREVE1').AsFloat, fCfgSis('DECUNI', varInteger));
        recSubIte.fltPreCus := fFormataFloat(qryIteGer.FieldByName('ITE_PRECUS').AsFloat, 4);
        recSubIte.fltPreCus := fFormataFloat(recSubIte.fltPreCus, fCfgSis('DECUNI', varInteger));
        recSubIte.fltTotCus := fFormataFloat(recSubIte.fltPreCus * recSubIte.fltQtdTot, 2);
        recSubIte.fltTotVen := fFormataFloat(recSubIte.fltPreVen * recSubIte.fltQtdTot, 2);

        Self.Add(recSubIte);

        qryDetMat.Next;
      End;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[pCarregarEstrutura]');
      End;
    End;

  Finally
    FreeAndNil(qryDetMat);
    FreeAndNil(qryIteGer);
  End;
End;

procedure TItensEstrutura.pSetObjEsttruturaPersonalizada(AEstruturaPersonalizada: TEstruturaPersonalizada);
begin
  If Assigned(AEstruturaPersonalizada) Then
    FobjEstruturaPersonalizada := AEstruturaPersonalizada;
end;


procedure TItensEstrutura.pCarregaItensEstruturaPersonalizada(strTabDetTemp: String;
                                                              intSeqPer: Integer;
                                                              strCodIte: String;
                                                              fltQtdIte: Double;
                                                              strCodEmp: String = '';
                                                              blnEntrega: Boolean = False);
var
  qryDetMat: TUniQuery;
  qryIteGer: TUniQuery;
  objItem: TSubItemEstrutura;

const strTabDet = 'DETPER';

  procedure pBuscaTabela(strTabela: String);
  begin
    qryDetMat.Close;
    qryDetMat.SQL.Clear;
    qryDetMat.SQL.Add('SELECT * FROM ' + strTabela + ' WHERE DMT_SEQPER =:SEQPER ');
    qryDetMat.ParamByName('SEQPER').AsInteger := intSeqPer;
    qryDetMat.Open;
  end;

begin
  qryDetMat := fCriaQuery;
  qryIteGer := fCriaQuery;

  Try
    qryIteGer.SQL.Add('  SELECT SQL_NO_CACHE        ');
    qryIteGer.SQL.Add('    ITE_IMPLIS,              ');
    qryIteGer.SQL.Add('    ITE_SALDOS,              ');
    qryIteGer.SQL.Add('    ITE_PRECUS,              ');
    qryIteGer.SQL.Add('    ITE_PREVE1               ');
    qryIteGer.SQL.Add('  FROM ITEGER                ');
    qryIteGer.SQL.Add('  WHERE ITE_CODITE = :CODITE ');
    qryIteGer.SQL.Add('    AND ITE_CODEMP = :CODEMP ');

    pBuscaTabela(strTabDet);

    If qryDetMat.IsEmpty And (Not fEmptyStr(strTabDetTemp)) And fTabelaExiste(strTabDetTemp) Then
      pBuscaTabela(strTabDetTemp);

    If (Not qryDetMat.IsEmpty) Then
    Begin
      Self.Clear;

      qryDetMat.First;
      While (Not qryDetMat.Eof) Do
      Begin
        If fCfgSis('EMPCAR', varBoolean) And blnEntrega Then
          objItem.strEmpCar := fRetEmpCarregamentoItem(qryDetMat.FieldByName('DMT_ITESUB').AsString);

        qryIteGer.Close;
        qryIteGer.ParamByName('CODITE').AsString := qryDetMat.FieldByName('DMT_ITESUB').AsString;
        qryIteGer.ParamByName('CODEMP').AsString := IIF(Not objItem.strEmpCar.IsEmpty, objItem.strEmpCar,
                                                        IIF(Not strCodEmp.IsEmpty, strCodEmp, VS_strCodEmp));
        qryIteGer.Open;

        objItem.strCodigo := qryDetMat.FieldbyName('DMT_ITESUB').AsString;
        objItem.strImpLis := qryIteGer.FieldbyName('ITE_IMPLIS').AsString;
        objItem.fltSaldos := qryIteGer.FieldbyName('ITE_SALDOS').AsFloat;
        objItem.fltQtdSub := qryDetMat.FieldbyName('DMT_QTDITE').AsFloat;
        objItem.fltQtdTot := fFormataFloat(qryDetMat.FieldbyName('DMT_QTDITE').AsFloat * fltQtdIte, fCfgSis('DECQTD', varInteger));
        objItem.fltPreVen := fFormataFloat(qryIteGer.FieldByName('ITE_PREVE1').AsFloat, fCfgSis('DECUNI', varInteger));
        objItem.fltPreCus := fFormataFloat(qryIteGer.FieldByName('ITE_PRECUS').AsFloat, 4);
        objItem.fltPreCus := fFormataFloat(objItem.fltPreCus, fCfgSis('DECUNI', varInteger));
        objItem.fltTotCus := fFormataFloat(objItem.fltPreCus * objItem.fltQtdTot, 2);
        objItem.fltTotVen := fFormataFloat(objItem.fltPreVen * objItem.fltQtdTot, 2);

        Self.Add(objItem);

        qryDetMat.Next;
      End;
    End;
  Finally
    FreeAndNil(qryDetMat);
    FreeAndNil(qryIteGer);
  End;

end;

initialization
{$IFDEF LINUX}
  FMREW := TMultiReadExclusiveWriteSynchronizer.Create;
  FDicCdsVenda := TDictionary<NativeUInt, TUniClientDataSet>.Create;
{$ENDIF}
finalization
{$IFDEF LINUX}
  FDicCdsVenda.Free;
  FMREW.Free;
{$ENDIF}
end.

