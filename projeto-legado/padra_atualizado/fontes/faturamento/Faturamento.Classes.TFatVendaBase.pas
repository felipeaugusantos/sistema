end;

function TFatVendaBase.fEhDevolucaoPorAD: Boolean;
begin
  Result := VS_strHabilitarCRM And (Self.strOpcDoc = 'DV') And (fCfgSis('UTI_AD', varString) = 'S');
end;

function TFatVendaBase.fEhDevolucaoEspelhoPorAD: Boolean;
begin
  If blnEspelhoADNaoEncontrado Then
    Exit(False);

  Result := VS_strHabilitarCRM And (Self.strOpcDoc = 'DV') And fCfgSis('UTI_AD', varBoolean) And fCfgSis('ESP_AD', varBoolean) And
            (Not Self.blnEspelhoDevolucaoCliente) And (Not Self.blnLiberouADComSenha);
end;

function TFatVendaBase.fGravaEspelhoFundoCombateIMCeFundoCombateST(strClaFis, strEmpIte: String): Boolean;
begin
  Result := False;

  If (Assigned(objItensNotaEspelho)) Then
  Begin
    If fEhDevolucaoParaFornecedorQueAbasteceEmpresaPorTransferenciaDeEstoque(strClaFis) Then
      Exit(True);

    If (fEhOutrasEntradasFornecedorComDocumentoVinculado) And (fDentroDoEstado(strEmpIte)) Then
      Exit(True);

    If fEhGarantiaFornecedorComDocumentoVinculado  Then
      Exit(True);

  End;
end;

function TFatVendaBase.fEhDevolucaoEspelhoOuParaFornecedor: Boolean;
  Var
    blnEspDev: Boolean;
begin
  Result := (Assigned(objItensNotaEspelho));

  If Result Then
  Begin
    blnEspDev := (fCfgSis('ESPDEV', varString) = 'S');

    Result := ((fEhOutrasEntradasFornecedorComDocumentoVinculado) Or (strOpcDoc = 'OF') Or (strOpcDoc = 'GF') Or (blnEspDev And (Pos(strOpcDoc, 'DV_PR_')> 0))) And
              (blnDvComDta Or (blnEspDev And (fEhDevolucaoPorAD Or (strOpcDocTrue = 'BD'))));

    if (Not Result) And blnEspDev And (Pos(strOpcDoc, 'DV_OE_') > 0) And (strOpcDocTrue = 'NW') then
      Result := True;
  End;
end;

function TFatVendaBase.fEhDevolucaoDemonstracaoNotaEspecial(strDocDev, strEspDev, strEmpDev: string): Boolean;
begin
  Result := False;

  if Self.strOpcDoc <> 'DD' then
    Exit;

  if (fEmptyStr(strDocDev)) or (fEmptyStr(strEspDev)) or (fEmptyStr(strEmpDev)) then
    Exit;

  Result := fCampoTabela('GER_NOTESP', 'NOTGER', ['GER_NUMDOC', 'GER_ESPDOC', 'GER_CODEMP'], [strDocDev, strEspDev, strEmpDev], False) = 'S';
end;

function TFatVendaBase.fEhDevolucaoMercadoriaDoEstoqueExterno(ACodCli: String): Boolean;
Var
  LCodExt: String;
begin
  Result := False;

  If Self.FFulfillment.EhOperacaoFulfillment Then
    Exit;

  If Not Self.strOpcDoc.Equals('DV') Then
    Exit;

  If Not fCfgSis('ESTEXT', VarBoolean) Then
    Exit;

  If Not Self.GetClienteEmiteEnvioEstoqueExterno Then
    If Not Self.GetClienteRemessaEstoqueExternoMercadoLivre(LCodExt, ACodCli) Then
      Exit;

  Result := True;
end;

function TFatVendaBase.fEhDevolucaoParaFornecedorQueAbasteceEmpresaPorTransferenciaDeEstoque(strClaFis: String): Boolean;
begin
  Result := (Assigned(objItensNotaEspelho) And blnForFil And (strOpcDoc = 'OF') And
             fCfgSis('DEVFIL',varBoolean) And (Pos(RightStr(strClaFis, 3), '_411_202_209') > 0)) ;
end;

function TFatVendaBase.fEhOutrasEntradasFornecedorComDocumentoVinculado: Boolean;
begin
  Result := (strOpcDoc = 'EF') And blnDvComDta;
end;

function TFatVendaBase.fEhGarantiaFornecedorComDocumentoVinculado: Boolean;
begin
  Result := False;

  If not (strOpcDoc = 'GF') Then
    Exit;

  If not blnDvComDta Then
    Exit;

  If Self.blnConfirmacaoEspelho Then
    Exit;

  Result := True;
end;

function TFatVendaBase.fEhPedidoReposicaoClienteGarantia: boolean;
