function TFatVenda.fPedeDadosDoCaixa: Boolean;
  Var
    frmRcxSelecionaCaixa: TfrmRcxSelecionaCaixa;
begin
  Result := True;

  If (fCfgSis('TPFCCX') = 'C') Then
  Begin
    Self.pDefineVariaveisSeGravaCaixa;
    If Self.blnCfgGravaResCai Then
    Begin
      pCriarFormularios(TfrmRcxSelecionaCaixa, frmRcxSelecionaCaixa);
      frmRcxSelecionaCaixa.blnValidacaoCaixaOrigemEDestino := False;
      frmRcxSelecionaCaixa.ShowModal;

      Self.strCodigoCaixa := frmRcxSelecionaCaixa.edtCodigoCaixa.Text;
      Result := (frmRcxSelecionaCaixa.ModalResult = mrOK) And
                (Not Self.strCodigoCaixa.IsEmpty);

      FreeAndNil(frmRcxSelecionaCaixa);

      If Not Result Then
        fMensagem('ATENÇÃO', 'É necessário selecionar o caixa antes de continuar.', ['&OK'])
      Else
      Begin
        If Assigned(Self.DadosPixDaVenda.ObjetoPixPago) Then
        Begin
          If TFuncoesPix.VerificaPixComStatusConcluidoEComValorPago(Self.DadosPixDaVenda.ObjetoPixPago) Then
            Self.DadosPixDaVenda.ObjetoPixPago.CodigoDoCaixa := Self.strCodigoCaixa;
        End;
      End;
    End;
  End;
end;

function TFatVenda.fEhExpedicaoEDeveGravarCaixaOrdemPagamento():Boolean;
