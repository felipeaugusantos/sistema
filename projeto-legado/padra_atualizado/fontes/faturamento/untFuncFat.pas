    {* CLASSIFICAÇÃO DEFINIDA PELA pDefineClassificacaoItem (NA HIDROMAR,            *}
    {* NA CONFIRMAÇÃO DE PEDIDO COM ENT.FUT. A DESCRIÇÃO NÃO ESTAVA FICANDO COERENTE)*)
    {* EU NÃO CONSEGUI SIMULAR, MAS PELO LEVANTAMENTO É PROBLEMA ANTIGO MAS QUE SÓ   *)
    {* PASSOU A SER PERCEBIDO APÓS A MUDANÇA IMPLEMENTADA PELO REQ.:44532            *}
    {*******************************************************************************VA}
    If (Self.strOpcDocTrue = '11') Or (fEmptyStr(Self.strDesCla)) Then
    Begin
      Self.strDesCla := fRetDesCla(Self.strClaFis)
    End;

    If ((strOpcDoc = 'CP') Or
        (Self.strOpcDocTrue = '11')) And
       (strTipOpe = 'C') And
       (Not fEmptyStr(strEspOrc)) And
       (Not fValidaTipoDocumentoRemessaEmitida(strNumOrc, strEspOrc, VS_strCodEmp,
              strEspDoc)) Then
    Begin
      Result := False;
      Exit;
    End;

    If (strCliCon = 'S') Or (blnCliConF11) Or
       ((strEspDoc = 'PD') And
        (fCfgSis('SLRQPV', varBoolean)) And
        (Pos(fCfgSis('SLDPED'), 'A_T_') > 0)) Then
    Begin
      If Not fGravaAtualizaConsumidor Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    If Not fValidouDataHoraCadRecDocsConf Then
    Begin
      Result := False;
      Exit;
    End;

    If Not fValidaRestricaoVendaProduto Then
    Begin
      Result := False;
      Exit;
    End;

    intTemTri := IIF(Not fApenasSubstituicao, 1, 0);
    intTemSub := IIF(fVerificaSituacaoTributaria(Self), 1, 0);
    intInflam := IIF(fVerificaItemInflamavel(Self), 1, 0);
    strNomVe2 := fRetNomVendRep(strCodVe2);
    strLocArm := fRetLocalArmazenamentoColetor();
    strCreAdt := fRetCreditoPedido;

    If Not blnGravandoVariosDocumentos Then
      intPrzMed := fCalculaPrazoMedioVenda;

    blnGraComPro := (strOpcDoc = 'BR') Or ((VS_strTCoPro = '1') And (Pos(strClaFis, '5910_6910') > 0));

    If (VS_strTCoPro = '4') Then
      blnGraComPro := False;

    pCarregaResumoCfop(Self);
    pCarregaResumoCodFiscal(Self);

    pGeraMensagemAplicacao;

    pGeraStringCuponsDevolucao;
    pCalculaBaseIcmsRICMPR;
    pCalculaQtdCodFis;

    pAtribuiCodigoPromocional;

    if strOpcDoc = 'CF' then
      pPreencherMsgCondPgtoBaixaEntFutNF;

    If (Not fTemItensEntrega) And
       (Not blnUsaEndEntregaServicosPedidoOrcamento) And
       (Not (blnPedeEndEntregaServicos And blnDocumentoTemServicos)) And
       (Not blnEndEntConfDoc) And
       (Not fImprimeEndEntregaItensRetira) And
       (Not blnForcEndEnt) Then
    Begin
      pLimparEnderecoEntrega;
      pEnderecoToFatVenda;
    End;

    If Not fEmptyStr(objFazenda.strCodFaz) And fCfgSis('CADFAZ', VarBoolean) Then
    Begin
      pLimparEnderecoEntrega;
      pEnderecoToFatVenda;
    End;

    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin

      {*****************************************}
      {* CASO O CLIENTE UTILIZE DIFERIMENTO DE *}
      {* ICMS, A SIT. TRIBUTÁRIA É 051 SE NÃO  *}
      {* HOUVER BASE DE ICMS. DO CONTRÁRIO 090 *}
      {**************************************MV*}
      If strDiferi = 'S' Then
      Begin
        If (fFormataFloat(arrMatItens[intContador].fltBasIcm, 2) = 0.00) Then
        Begin
          If Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0 Then
          Begin
            arrMatItens[intContador].strCodSit := LeftStr(arrMatItens[intContador].strCodSit, 1) + '60';
            arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '60';
          End
          Else
          Begin
            arrMatItens[intContador].strCodSit := LeftStr(arrMatItens[intContador].strCodSit, 1) + '51';
            arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '51';
          End;
        End
        Else
        Begin
          arrMatItens[intContador].strCodSit := LeftStr(arrMatItens[intContador].strCodSit, 1) + '90';
          arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
        End;
      End;

      {*************************************************************************}
      {* SE FOR BONIFICACAO O CST DO ITEM DEVE SER X90 PARA TODOS OS PRODUTOS  *}
      {*********************************************************************JC**}
      If (Pos(RightStr(strClaFis,3), '910_') > 0) And fCfgSis('CST90B', varBoolean) Then
      Begin
        With arrMatItens[intContador] Do
        Begin
          if (fCfgSis('90BPRD', varInteger) = 1) and (Pos(strCodFis, CST_TRIBUTADO) = 0) then
            Continue;

          strCodFis := LeftStr(strCodFis, 1) + '90';
          strCodSit := LeftStr(strCodSit, 1) + '90';
        End;
      End;

      {*************************************************************************}
      {* SE USO/CONSUMO O CST DO ITEM DEVE SER X90 PARA TODOS OS PRODUTOS      *}
      {*********************************************************************LD**}
      If (Pos(strOpcDoc, 'UC') > 0) And
         (Pos(strEspDoc, 'NF') > 0) And
         (Self.strCliCon = 'N' ) And
         fCfgSis('CST90C', varBoolean) Then
      Begin
        With arrMatItens[intContador] Do
        Begin
          strCodFis := LeftStr(strCodFis, 1) + '90';
          strCodSit := LeftStr(strCodSit, 1) + '90';
        End;
      End;
    End;

    {*******************************************}
    {* VALIDA ITEM AGROTOXICO P/ IMPRESSAO MSG *}
    {****************************************IV*}
    If fCfgSis('RECGRO', varBoolean) Then
    Begin
      blnIteGro := fVerificaItemAgrotoxico(Self);
      strMsgGro := MSG_AGROTOXICO;
    End;

    If fCfgSis('BFUT49', varBoolean) And Assigned(arrMatItens) Then
    begin
      If (strClaFis >= '5000') and (Pos('922', strClaFis) > 0) Then
        If (arrMatItens[0].strEntRet <> 'R') And (arrMatItens[0].strEntFut = 'S')And (arrMatItens[0].strMotFut <> 'F') then
          strDesCla := 'ENTREGA FUTURA'
        Else
        If (arrMatItens[0].strEntRet <> 'R') And (arrMatItens[0].strEntFut = 'S')And (arrMatItens[0].strMotFut = 'F') then
          strDesCla := 'FATURAMENTO ANTECIPADO' ;
    end;

    {*******************************************}
    {* CLIENTE SIMPLES NACIONAL COM CÁLCULO    *}
    {* DE ICMS OU SUBST. TRIBUTÁRIO, DEVE      *}
    {* ENVIAR CST 090, POIS NA NFE É A ÚNICA   *}
    {* CST QUE PERMITE O ENVIO DE TAIS VALORES *}
    {****************************************MV*}
    pAjustaCSTSimples;

    If SameText(strOpcDoc, 'CI') And SameText(strNotEspConf,'S') Then
      blnNotEsp := True;

    If SameText(strOpcDoc, 'CA') Then
      blnNotEsp := True;

    pProcessarInfAdProdSchaeffler;

    //*****INICIO INDICAÇÃO SE GRAVARÁ CADREC*****
    blnGravarCadRec := (Self.fVendaClienteNormalComClaFisdeVenda Or
                        Self.fVendaClienteFilialComIndicacaoParaGravarCadRec Or
                        Self.fConfirmacaoCupomGerandoNovoCadRec) And (Not blnBaiEntFut) And
                        IIF(strOpcDoc = 'CI', fGerarCTR_CI, True) Or
                        Self.fRotinasConsignacaoQueGravamCadRec;

    {**************************************************************}
    {* Caso seja confirmacao de cupom fiscal e esteja             *}
    {* configurado para Manter o Contas a Receber do Cupom Fiscal *}
    {* Não deve gravar contas a receber para o novo documento     *}
    {* independente se for cfop de venda ou nao                   *}
    {**********************************************************JC**}
    If fConfirmacaoCupomMantendoCadRecOri Then
      blnGravarCadRec := False;

    {**************************************************************}
    {* Caso seja confirmacao de cupom fiscal e esteja             *}
    {* configurado para Manter o Contas a Receber do Cupom Fiscal *}
    {* e gerar Agrupamento de Duplicatas, não deve gravar contas  *}
    {* a receber para o novo documento independente se for cfop   *)
    {* de venda ou não.                                           *}
    {**********************************************************WL**}
    If fConfirmacaoCupomAgrupandoCadRecCupons Then
      blnGravarCadRec := False;

    If (strOpcDoc = 'PA') Then
      blnGravarCadRec := False;

    If (blnComVal) Then
      blnGravarCadRec := True;

    If fEhConsertoEquipamento Then
      blnGravarCadRec := False;

    If ((blnDevNota) Or (strOpcDoc = 'DV')) And (blnGravarCadRec) And (fPossuiSomenteBrinde) Then
      blnGravarCadRec := False;

    If blnConfirmacaoEspelho Then
      blnGravarCadRec := False;

    If (strOpcDoc = 'OU') And (Not blnConEqu) Then
      blnGravarCadRec := blnCtrOutSai;

    If (fCfgSis('CDTCLV',varBoolean)) And
       (Pos(strEspDoc, 'PD_FF_IF_NF_') > 0) Then
    Begin
      If (fExisteCilindroVasilhameFaturamentoArrMatrizFechamento) Then
        blnGravarCadRec := False;
    End;

    If (MatchStr(strOpcDoc, ['CO','CP','CF'])) And
       (strTipOpe = 'R') Then
      blnGravarCadRec := False;

    If (strOpcDoc = 'NC') And (not blnNCFornecedor) And (objNfeComplemento.tncTipoNota in [tncComplementoIPI, tncComplementoFrete]) Then
      blnGravarCadRec := True;

    If blnEstornoNotaFiscal Then
      blnGravarCadRec := True;

    //*****FINAL INDICAÇÃO SE GRAVARÁ CADREC*****

    If (Not Assigned(qryConCit)) Then
      qryConCit := fCriarQuery('SELECT * FROM CADITE WHERE FALSE', Self);

    strEmpRec := '';

    strAutoEntTE := '';

    stlAutoConEnt.Clear;
    stlAutoTransfEmpCar.Clear;

    If (Pos(strEspDoc,'PD_OR_') > 0) And (cdsDadosPedBaixados.Active) Then
    Begin
      If (cdsDadosPedBaixados.RecordCount > 0) And (Not fOrcamentoComoPedido) Then
      Begin
        pInserePedidosPendentes;
        blnManterfltUniTmp := blnEhTelaAltItensPed;
        Try
          pPreencheMatrizFechamento;
        Finally
          blnManterfltUniTmp := False;
        End;

        If blnEhTelaAltItensPed Then
        Begin
          fltFreRat := 0;
          fltValFre := 0;
          fltFreDig := 0;

          pCalculaTotGer;
          pRateiaValores;

          fltValFre := fRetornaSomaTotFreItensOri;
          If fRateiaFreteItensTransportadora(strCodTra, strTipFre) And (fltValFre > 0) Then
          Begin
            fltFreRat := fltValFre;
            fltValFre := 0.00;
            fltFreDig := 0.00;
          End;

          If (fltValFre > 0) Or (fltFreRat > 0) Then
          Begin
            pCalculaTotGer;
            pRateiaValores;
          End;
        End
        Else
        Begin
          pCalculaTotGer;
          pRateiaValores;
        End;

        pAtualizaTemporariaItens(cdsVenda);
      End;
    End;

    If blnEhTelaAltItensPed Then
      Self.pCarregaDesBaiNaMatrizItens;

    If not fValidaBeneficioFiscal(strProdSemCodBeneficio) Then
    Begin
      Result := False;

      If fInTransaction Then
        fCancelaTransac;

      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.Caption := 'ATENÇÃO';
        frmObservacao.lblMensagem.Caption := 'Os seguintes itens estão sem o código do benefício fiscal preenchido.';
        frmObservacao.memObs.Texto := strProdSemCodBeneficio + #13#10 + 'Preencha o código do benefício na abreviação de ICMS.';
        frmObservacao.ShowModal;
      Finally
        pFreeAndNil(frmObservacao);
      End;

      Exit;
    End;

    If not fValidaCreditoPresumido(strProdutosFaltandoCreditoPresumido) Then
    Begin
      Result := False;

      If fInTransaction Then
        fCancelaTransac;

      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.Caption := 'ATENÇÃO';
        frmObservacao.lblMensagem.Caption := 'Verifique o código do benefício fiscal e a alíquota de crédito presumido dos itens abaixo:';
        frmObservacao.memObs.Texto := strProdutosFaltandoCreditoPresumido + #13#10 + 'Preencha essas informações na abreviação de ICMS ou no cadastro de NCM.';
        frmObservacao.ShowModal;
      Finally
        pFreeAndNil(frmObservacao);
      End;

      Exit;
    End;

    If not TValidadorValoresFlags.Execute(Self, strMensagemRetorno) Then
    Begin
      Result := False;

      If fInTransaction Then
        fCancelaTransac;

      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.Caption := 'ATENÇÃO';
        frmObservacao.lblMensagem.Caption := 'Dados Cadastrais com campos de flag N/S com valores inconsistentes.';
        frmObservacao.memObs.Texto := strMensagemRetorno;
        frmObservacao.ShowModal;
      Finally
        pFreeAndNil(frmObservacao);
      End;

      Exit;
    End;

    If (fDevolucaoComNetpoints) And (Self.strCpfNpsDevolucoes <> Self.strCliCgc) Then
    Begin
      If fInTransaction Then
        fCancelaTransac;
      Result := False;
      fMensagem('ATENÇÃO!', 'O cpf informado difere do Cpf das devoluções! Favor verificar.', ['&OK']);
      Exit;
    End;

    if (Self.blnComTansacao) and (not fInTransaction) and (fCfgSis('TRAREM') = '1') then
    begin
      if not fVerificaFlexNegativo then
      begin
        Result := False;
        Exit;
      end;
    end;

    If fTravaVendaPresencial(strMensagemRetorno) Then
    Begin
      If fInTransaction Then
        fCancelaTransac;
      fMensagem('ATENÇÃO!', strMensagemRetorno, ['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 400, 600);
      Result := False;
      Exit;
    End;

    If fTravaDeCaixaImpedeFaturamento(strMSGTravaCaixa) Then
    Begin
      If fInTransaction Then
        fCancelaTransac;

      Result := False;

      fMensagem('', strMSGTravaCaixa, ['&OK']);

      Exit;
    End;

    // Verifica se todos itens que utilizam lotes estão com os lotes preenchidos.
    If (blnImpSfa) Then
    Begin
      If fCfgSis('AMZSFA', varBoolean) Then
      Begin
        If Not fTodosLotesInformados(strProdSemLote) Then
        Begin
          if (blnBaiPedDev) and fCfgSis('DVRLOT', varBoolean) then
          begin
            if fInTransaction Then
            begin
              fCancelaTransac;
              Result := False;
              fMensagem('ATENÇÃO', 'Há inconsistências na estrutura da gravação do documento.' + #13 + 'Favor entrar em contato com a Citel!', ['&Ok']);
              Exit;
            end;

            if (not fAbrirTelaDefinirLoteDevBaixa) then
            begin
              Result := False;
              Exit;
            end;
          end
          else
          begin
            Result := False;
            If strOpcDocTrue = 'NG' Then
              TfrmMemo.pShowMessage('Os seguintes itens estão sem LOTE PRINCIPAL DE GARANTIA, efetue a manutenção do cadastro para prosseguir!' + #13#10 + strProdSemLote)
            Else
              TfrmMemo.pShowMessage('Os seguintes itens estão sem LOTE preenchido, preencha para prosseguir!' + #13#10 + strProdSemLote);
            Exit;
          end;
        End;
      End;
    End
    Else
    Begin
      If Not fTodosLotesInformados(strProdSemLote) Then
      Begin
        if (blnBaiPedDev) and fCfgSis('DVRLOT', varBoolean) then
        begin
          if fInTransaction Then
          begin
            fCancelaTransac;
            Result := False;
            fMensagem('ATENÇÃO', 'Há inconsistências na estrutura da gravação do documento.' + #13 + 'Favor entrar em contato com a Citel!', ['&Ok']);
            Exit;
          end;

          if (not fAbrirTelaDefinirLoteDevBaixa) then
          begin
            Result := False;
            Exit;
          end;
        end
        else
        begin
          Result := False;
          If strOpcDocTrue = 'NG' Then
            TfrmMemo.pShowMessage('Os seguintes itens estão sem LOTE PRINCIPAL DE GARANTIA, efetue a manutenção do cadastro para prosseguir!' + #13#10 + strProdSemLote)
          Else
            TfrmMemo.pShowMessage('Os seguintes itens estão sem LOTE preenchido, preencha para prosseguir!' + #13#10 + strProdSemLote);
          Exit;
        end;
      End;
    End;

    If (strOriF11 = 'S') And (Not fPodeInformarLoteADefinir(Self.strEspDoc)) Then
    Begin
      If fInTransaction Then
        fCancelaTransac;

      Result := False;
      fMensagem('ATENÇÃO!', 'Não é possível faturar documentos sem a definição de lote (lote "A DEFINIR"). Peça para o vendedor responsável alterar o documento ' +
                            'escolhendo o lote de onde deve sair a mercadoria e depois tente faturar novamente. Só é permitido gerar pedidos sem definição de lote por ' +
                            'conta da configuração "CFG_DLSWMS - Utilizar definição de lote na separação sem WMS ?", criada para faturamentos pela Expedição.', ['&OK']);
      Exit;
    End;

    If Assigned(pgbStatusGravacao) Then
      With pgbStatusGravacao.Properties Do
        Max := Max + Length(arrMatItens);

    {*******************************************}
    {* DEFINE A ESPÉCIE DE ACORDO COM O TIPO   *}
    {* DO PEDIDO                               *}
    {****************************************MV*}
    If ((strEspOrc = 'PD') And (Pos(strOpcDoc, 'VN_VS_') > 0)) Or
       ((Not fEmptyStr(strOpeExp)) And (Pos(strOpcDoc, 'CP_OV_') > 0)) Then
    Begin

      If ((fCfgSis('TIPEXP') = '3') And (fCfgSis('TPDCEX') = '1')) And (fEmptyStr(strTipPed)) Then
      Begin
        If fInTransaction Then
          fCancelaTransac;
        Result := False;
        fMensagem('ATENÇÃO!', 'O tipo do pedido não está preenchido! Favor verificar.', ['&Ok']);
        Exit;
      End
      Else
      Begin

        If ((fCfgSis('TIPEXP') = '3') And
           (fCfgSis('TPDCEX') = '2')) And
           (fEmptyStr(strTipPed))     And
           (Not fEmptyStr(strOpeExp)) And
           (Not blnEntregaImediataEmNovoPedido) And
           (Not blnRetiraOutraLojaEmNovoPedido) And
           (Not blnRetiraMesmaLojaEmNovoPedido) And
           (Not blnRetiraExpedicaoEmNovoPedido) And
           (Not blnAbastecTransfReqEmNovoPedido) Then
        Begin

          Try
            pCriarFormularios(TfrmFatTipoExpedicao, frmFatTipoExpedicao);
            frmFatTipoExpedicao.fatVenda := Self;
            frmFatTipoExpedicao.ShowModal;
            blnConfirma := frmFatTipoExpedicao.blnConfirma;
          Except
            On E: Exception Do
            Begin
              blnConfirma := False;
              pMensagensErro(E.Message, '[TFatVenda.fGravaArquivos]');
            End;
          End;

          pFreeAndNil(frmFatTipoExpedicao);

          If Not blnConfirma Then
          Begin
            If fInTransaction Then
              fCancelaTransac;
            Result := False;
            fMensagem('ATENÇÃO!', 'O tipo do pedido não está preenchido! Favor verificar.', ['&Ok']);
            Exit;
          End;

        End;

      End;

      {*****************************************}
      {* CASO FOR CLIENTE FILIAL, COLOCA FIXO: *}
      {* OUTRAS SAÍDAS: TIPO "A" (NOTA FISCAL) *}
      {* TRANSF. EST..: TIPO "B" (TE)          *}
      {**************************************MV*}
      If (blnCliFil) And (fEmptyStr(strOpeExp)) Then
      Begin
        If Pos(strOpcDoc, 'OU_OV_') > 0 Then
          strTipPed := 'A'
        Else
          strTipPed := 'B';
      End;

      If Not Pos(strOpcDoc,'VN_CS_') > 0 Then
      Begin

        If (strTipPed = 'A') Then
        Begin
          strEspDoc := 'NF';

          If ((strOpcDoc = 'VS') And (fCfgSis('EMPSER') <> 'PREFEITURA DE BRASILIA')) Then
            strEspDoc := 'NS';

        End

        Else If (strTipPed = 'B') Then
        Begin

          If (blnCliFil) Then
            strEspDoc := 'TE'
          Else If (strTipOpe = 'B') Then
            strEspDoc := 'BR'
          Else
            strEspDoc := 'FF';

        End

        Else If (strTipPed = 'C') Then
        Begin
          strEspDoc := 'IF';
        End;

      End;

    End;

    If (fCfgSis('USABRI', VarBoolean)) Then
    Begin
      If (blnExpedi) Then
      Begin
        blnSomenteBrindeProd := fPossuiSomenteProdutoBrinde();
        blnSomenteBrindeServ := False;
      End
      Else
      Begin
        blnSomenteBrindeProd := (fPossuiSomenteBrinde()) And (Not fPossuiBrindeServico());
        blnSomenteBrindeServ := (fPossuiSomenteBrinde()) And (Not fPossuiBrindeProduto());

        If (Not fEmptyStr(strNumDocsPD)) Then
        Begin
          strNumOrc := arrMatItens[0].strNumOrc;
          strEspOrc := arrMatItens[0].strEspOrc;
          strEmpOri := arrMatItens[0].strEmpOrc;
        End;
      End;
    End
    Else
    Begin
      blnSomenteBrindeProd := False;
      blnSomenteBrindeServ := False;
    End;

    {******************************************************************}
    {*Se for documento de brinde de produtos altera o EspDoc          *}
    {**************************************************************DF**}
    If (blnSomenteBrindeProd) And (Pos(strOpcDoc, 'NC_DV_') <= 0) And
       (Pos(strEspDoc, 'NF_IF_FF_') > 0) Then
      pDefinirDocumentoBrindeProduto();

    If (blnSomenteBrindeProd) And (Pos(strOpcDoc, 'NC_DV_') <= 0) And
       (Pos(strEspDoc, 'PD_') > 0) Then
      fltTotCadRec := 0.00;

    {******************************************************************}
    {*Se for documento de brinde de serviços altera o OpcDoc e TipFat *}
    {**************************************************************DF**}
    If (blnSomenteBrindeServ) And (Pos(strOpcDoc, 'NC_DV_') <= 0) And
      (Pos(strEspDoc, 'NF_NS_IF_FF_') > 0) Then
      pDefinirDocumentoBrindeServico();

    If (Not fPermiteEmissaoEspecie(strEspDoc)) Then
    Begin
      Result := False;

      If fInTransaction Then
        fCancelaTransac;

      fMensagem('ATENÇÃO!',Format(MSG_ESPECIE_EMISSAO_NAO_PERMITIDA, [fGetConfiguracaoPermiteEmissaoEspecie(strEspDoc)]) , ['&OK']);
      Exit;
    End;

    pCalculaCadFis(arrLivFis, Self.strChaveAcesso);

    pCalculaQtdPecas;

    if Length(arrLivFis) > 0 then
      pCalculaFunrural(arrLivFis[1].fltVlrCon);

    {$IFDEF TESTABILIDADE_AUTCOM}
      // Não testa se o painel está aberto
    {$ELSE}
      If (fCfgSis('NFEUSA', varString) = 'S') And
         (fCfgSis('PNLNFE', varString) = 'S') And
         (Not fPainelEstaAberto) And
         (Pos(strEspDoc, 'NF_EL_NS_') > 0) And
         (Not blnImpPafEcf) And
         (Not blnExecutandoFaturadorAutomatico) And
         (Not blnEspelhoDevolucaoCliente) And
         (Not blnImportacaoNfeParaSped) Then
      Begin
        Result := False;
        fCancelaTransac;
        fMensagem('ATENÇÃO!', 'Atenção: o PainelNFe da loja (' + VS_strCodEmp + ') não está aberto. Por favor verifique e feche a venda novamente.', ['&Ok']);
        Exit;
      End;

      If (Not blnImpPafEcf) And
         (Not blnExecutandoFaturadorAutomatico) And
         (Not blnEspelhoDevolucaoCliente) And
         (Not blnImportacaoNfeParaSped) And
         (fEmitenteComRestricaoFiscal(VS_strCodEmp, strEspDoc)) Then
      Begin
        Result := False;
        fCancelaTransac;
        fMensagem('ATENÇÃO!', 'Atenção: O Emitente não está habilitado para emissão de documento fiscal, verifique o cadastro junto a SEFAZ!', ['&OK']);
        Exit;
      End;

      if fSeForEmitirCTePainelNaoEstaAberto(Self.objDadosCte.blnGrava, Self.objDadosCte.strCodEmp) then
      begin
        Result := False;
        fCancelaTransac;
        fMensagem('ATENÇÃO!', 'Atenção: o PainelNFe da loja (' + Self.objDadosCte.strCodEmp + ') não está aberto. Por favor verifique e feche a venda novamente.', ['&Ok']);
        Exit;
      end;

      if fSeForEmitirCTEAutcomNaoEstaAberto(Self.objDadosCte.blnGrava, Self.objDadosCte.strCodEmp) then
      begin
        Result := False;
        fCancelaTransac;
        fMensagem('ATENÇÃO!', 'Atenção: o Autcom da loja (' + Self.objDadosCte.strCodEmp + ') não está aberto.' + #13 +
                              'Pelo menos um Autcom logado nesta loja precisa estar aberto para Importar os CTes emitidos.' + #13 +
                              'Por favor verifique e feche a venda novamente.', ['&Ok']);
        Exit;
      end;

      if fSeForEmitirSatIntegradorNaoEstaAberto(strEspDoc) then
      begin
        Result := False;
        fCancelaTransac;
        fMensagem('ATENÇÃO!', 'Atenção: o Integrador SAT Citel da loja (' + VS_strCodEmp + ') não está aberto. Por favor verifique e feche a venda novamente.', ['&Ok']);
        Exit;
      end ;

    {$ENDIF}

    If (blnComTansacao) And (Not blnEspelhoDevolucaoCliente) And (Not fValidaAtualizaEmailNFE(strEspDoc)) Then
    Begin
      Result   := False;
      FRespMsg := True;
      fCancelaTransac;
      Exit;
    End;

    //Trava de segurança se chegar nesse ponto indica falha na rotina, não deve prosseguir.
    If (strEspDoc <> 'PD') Then
      If (fltBolAdt > 0) And (Not blnBolVen) And (Not fSolicitaDigDuplicAdiantamentoPedido) Then
      Begin
        Result := False;
        fCancelaTransac;
        pMensagemOk('Boleto de adiantamento não permitido para a espécie do documento sendo gravado!');
        Exit;
      End;

    //Trava de segurança se chegar nesse ponto indica falha na rotina, não deve prosseguir.
    If (strEspDoc <> 'PD') Then
      If blnBolVen And Not blnExpedi Then
      Begin
        Result := False;
        fCancelaTransac;
        pMensagemOk('Pedido que possui Boleto(s) de Adiantamento deve ser faturado pela expedição!');
        Exit;
      End;

    Self.intNumBox := NAO_UTILIZA_BOX;

    If (fCfgSis('USABOX', varBoolean)) Or (fCfgSis('USABEI', varBoolean)) Then
      fExecutarModal(pRetornarBoxLivre, 'Verificando box de entrega livre. Aguarde ...', '');

    If (Self.intNumBox = 0) Then
    Begin
      Result := False;
      fCancelaTransac;
      pMensagemSonora('NÃO HÁ BOX DE ENTREGA LIVRE PARA UTILIZAÇÃO. POR FAVOR VERIFIQUE PARA PODER FINALIZAR A VENDA NOVAMENTE.', True, 48);
      Exit;
    End;

    If (Self.fEhNotaExportacao) And (Not Self.fInformouDadosExportacao) Then
    Begin
      If (fMensagem('ATENÇÃO!', 'Para emissão de Nota de Exportação é necessário informar o local de saída do país!' + #13#10 +
                                'Deseja informar agora?', ['&Sim', '&Não']) = 1) Then
      Begin
        Self.pSolicitaComplementoDadosExportacao;
      End;
    End;

    If blnValidarDadosNotaEletronica And (Not fDocumentoParaFornecedor) and (blnComTansacao) And (Not blnEspelhoDevolucaoCliente) Then
    Begin
      Try
        If Not fDadosClienteNFe(stlValidacoesNFe) Then
        Begin
          If (stlValidacoesNFe.Count > 0) Then
          Begin
            if not TfrmMultiConfirmacao.fMultiConfirmacao('Inconsistências nos dados para gerar a NFe', stlValidacoesNFe.Text) then
            begin
              FRespMsg := True;
              Result := False;
              fCancelaTransac;
              Exit;
            end;
          End
          Else
          Begin
            FRespMsg := True;
            Result := False;
            fCancelaTransac;
            Exit;
          End;
        End;

        if not blnIgnorarValidacaoCest then
        begin
          LstrListaItens := fGetItensParaValidacaoCestItens(arrMatItens);
          strMsgCest := fValidaCestItens(LstrListaItens);
          if Trim(strMsgCest) <> '' then
          begin
          if not TfrmMultiConfirmacao.fMultiConfirmacao('Inconsistências nos dados para gerar a NFe', strMsgCest) then
          begin
            FRespMsg := True;
            Result := False;
            fCancelaTransac;
            Exit;
          end;
        end;
        end;
      Finally
        If Assigned(stlValidacoesNFe) Then
          FreeAndNil(stlValidacoesNFe);
      End;
    End;

    gerenciadorProdutoAcabado.Importar(arrMatItens,
      strOprFlj,
      FFatVendasCalculador,
      blnCliFil,
      strTabPre,
      strTabTin,
      strEspDoc);

    {*************************************************}
    {* DEVE SER CHAMADO ANTES DA TRANSACAO PRINCIPAL *}
    {*********************************************JC**}
    If blnCarregaSeqConRcx Then
    Begin
      intSeqConRcx := StrToInt(fRetRcxCon(strEmpLog));
      If blnExpedi And (Pos(VS_strTipExp,  '3_4_5_') > 0) And fCfgSis('USABAC', varBoolean) Then
      Begin
        intSeqConRcxCredito := StrToInt(fRetRcxCon);
      End;
    End;

    {*************************************************}
    {* DEVE SER CHAMADO ANTES DA TRANSACAO PRINCIPAL *}
    {*********************************************JC**}
    If blnCarregarSeqMovCar Then
      fRetSequencialMovCar('MOVCAR', VS_strCodEmp, arrCartoes);

    If blnGravarDavPv And blnCliFil Then
    Begin
      blnGravarDavPv := False;
    End;

    If fClienteConsumidor(Self.strCliOri, False, True) And ((Pos(Self.strEspDoc, 'NF_EL_IF_IV_D1_') > 0) or
       (MatchStr(Self.strEspDoc,['PD']) And MatchStr(Self.strTipPed,['A','C']))) And (fEmptyStr(Self.strCliCgc) Or
       ((fReplicatorStr(Self.strCliCgc[1], Length(Self.strCliCgc)) = Self.strCliCgc) And (Self.strCliEst <> 'EX'))) Then
    Begin
      If Self.fltTotGer >= fStrToFloat(fReplaceStr(fCfgSis('MINCPF', varString),'.','')) Then
      Begin
        Result := False;
        fCancelaTransac;
        fMensagem('ATENÇÃO!','De acordo com o decreto 18.219 de 26 de janeiro de 2018' + #13 +
                             'em seu artigo primeiro inciso sexto determina que ' + #13 +
                             'deverá ser exigida a identificação do consumidor pelo CNPJ ou CPF ' + #13 +
                             'nas operações com valor igual ou superior a R$ : ' + FormatFloat('#,##0.00', fStrToFloat(fReplaceStr(fCfgSis('MINCPF', varString),'.',''))), ['&O k']);
        Exit;
      End;
    End;

    If (fEnviarDocumentoEletronico And fURLDocumentoEletronicoHomologacao) And (Not blnImpPafEcf) And (Not blnEspelhoDevolucaoCliente) Then
    Begin
      If fMensagem('', 'Documento emitido em ambiente de HOMOLOGAÇÃO, portanto não terá validade fiscal.' + #13#10 +
                       'Para ativar o ambiente de PRODUÇÃO entre em contato com a Citel.' + #13#10 +
                       'Deseja continuar? (S/N)', ['&Sim', '&Não'], IIF(VS_ExibirMensagemAoUsuario, 2, 1)) = 2 Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;
    End;

    {Req: 103134}
    strItem := fValidaItensTinta;
    If Not fEmptyStr(strItem) Then
    Begin
      fCancelaTransac;
      fMensagem('ATENÇÃO!','Ocorreu uma falha ao carregar a tinta de máquina, item: ' + strItem + '.' + #13#10 +
                           'Entre em contato com a Citel para que possamos levantar o motivo do problema.' + #13#10 +
                           'Para continuar com a venda, retire o produto do grid e insira o item novamente!.', ['&Ok']);
      Result := False;
      Exit;
    End;

    {Req: 201397}
    If fCfgSis('NUMPOK', varBoolean) And (Self.strEspDoc = 'PD') And (Not fEmptyStr(Self.strNumPok)) Then
    Begin
      If (fNUMPOK_Em_Duplicidade(strNum_PD)) Then
      Begin
        fCancelaTransac;
        fMensagem('ATENÇÃO!', 'Foi identificado o uso do NUMPOK: (' + Self.strNumPok + ') para o pedido: ' + strNum_PD + ', verifique!.', ['&Ok']);
        Exit(False);
      End;
    End;

    If (Pos(strEspDoc, 'NF_EL_IF_IV_D1_') > 0) Then
    Begin
      If (Not fValidaEstado(IIF(fEmptyStr(strEstEnt), strCliEst, strEstEnt))) Then
      Begin
        fCancelaTransac;
        fMensagem('ATENÇÃO!', '"'+IIF(fEmptyStr(strEstEnt), strCliEst, strEstEnt)+'" informado na cidade do cadastro do cliente não é uma unidade da federação válida! '+
                              'Corrija o cadastro antes de prosseguir essa operação informando uma cidade que esteja entre as 27 unidades federativas ou "EX" no caso ' +
                              'de cidades do exterior.', ['&Ok']);
        Result := False;
        Exit;
      End;
    End;

    If (Pos(strEspDoc, 'FF_NS_NF_IF_') > 0) And (Not fDocumentoParaFornecedor) And (ClienteVinculadoTemEstoqueExterno(Self.strCodCli)) Then
    Begin
      fCancelaTransac;
      fMensagem('ATENÇÃO!', 'Não é permitido utilizar cliente com estoque externo vinculado. Verifique!', ['&OK']);
      Result := False;
      Exit;
    End;

    If fUtilizaValidacaoLotesPedidoWMS Then
    Begin
      arrDocsConfPD := strDocsConfPD.Split([',']);

      For strTmpNumDoc In arrDocsConfPD Do
      Begin
        arrTmpNumDoc := strTmpNumDoc.Split(['-']);

        If Not fValidarDefinicaoLotesPedidoWMS(arrTmpNumDoc[0], arrTmpNumDoc[1], arrTmpNumDoc[2], LMensagem) Then
        Begin
          fCancelaTransac;
          pMensagemOk(LMensagem);
          Result := False;
          Exit;
        End;
      End;
    End;

    If Pos(strEspDoc, 'PD_OR_') <= 0 Then
    Begin
      pCalcIcmsEfetivo;
      pCalculaIcmsMonofasicoRetidoAnteriormente;
    End;

    If fDetalharDescontosDeImpostosDeOrgaoPublico Then
      pDetalharDescontosDeImpostosDeOrgaoPublico;

    blnAtuExp := True;

    If (blnExpedi) And (fCfgSis('TIPEXP', VarString) = '4') Then
      blnAtuExp := False;

    pGravarLogTesteUnitario;
    pGerarLotesEstoqueExterno;

    FblnAtualizaUltimaVenda := (Not blnCliFil) And
                               (
                                (Pos(strClaFis, VS_strClaVen) > 0) Or
                                (Pos(strClaFis, VS_strClaDev) > 0) Or
                                (IIF(fCfgSis('ENTBRF', varBoolean), ((strOpcDoc = 'BR') Or (fTemClafisBrindeEntreAsClafis)), False))
                               );

    FblnTravarSeSaldoFicarNegativo := (fCfgSis('BLOABS', varBoolean)) Or
                                      (fCfgSis('BLOSAL', varBoolean) And (Not fLogLibExists('LBSDVN', arrLogLib)));

    if (blnComTansacao) and (fPedidoJaFaturado) then
    begin
      Exit(False);
    end;

    If (blnComTansacao) Then
    begin
      FErroCarregarPonImp := '';
      FAuditFaturamento.Limpar;
      FAuditoriaSaldo.Limpar;
      FAuditoriaResumoCaixa.Limpar;
      fStartTransaction(frmModulo.GetCurrentConnection, LSafeCommitID);
    end;

    If (Not fEmTransacao) Then
      Raise Exception.Create('Houve um problema na gravação deste documento (fInTransaction failed). '+
        'Recomenda-se reinciar o Autcom e repetir a operação!');

    Try

      If fAlterouClienteDoOrcamentoPedido Then
      Begin
        pAtualizarClienteNaOcorrenciaCRMOrcamentoPedido;
      End;

      If blnBaiEntFut And Assigned(fLimpaPrevisaoEntFut) And (Not fLimpaPrevisaoEntFut) Then
      Begin
        fCancelaTransac;
        Result := FALSE;
        Exit;
      End;

      {**************************************************}
      {* AGENDAR TELEATENDIMENTO PARA CLIENTE DA VENDA  *}
      {***********************************************VA*}
      If fCfgSis('PMETEL',varBoolean) And (Not blnEspelhoDevolucaoCliente) Then
      Begin
        If (Pos(strClaFis, VS_strClaVen) > 0) And
           (Pos(strEspDoc, 'NF_IF_IV_EL_MI_FF_NS_') > 0) And
           (Pos(strOpcDoc, 'CF_CI_CN_OV_CE_CO_CT_EF_') <= 0) And
           (Not fClienteConsumidor(strCliOri, False, True)) Then
        Begin
          pInfoStatusGravacao('Aguarde... Agendando Teleatendimento');
          pStepStatusGravacao;

          If Not fGravaAgeTel(strCodCli, strCodVen) Then
          Begin
            fCancelaTransac;
            Result := FALSE;
            Exit;
          End;
        End;
      End;

      If (strOpcDoc = 'DV') And (Length(FArrItensNumeroSerieDevolucao) > 0) Then
      Begin
        If Not TNumeroSerie.fCancelaViaDevolucao(FArrItensNumeroSerieDevolucao) Then
        Begin
          fCancelaTransac;
          Result := FALSE;
          Exit;
        End;

        If Not TNumeroSerie.fCancelaViaDevolucaoConfirmacaoDocumento(FArrItensNumeroSerieDevolucao) Then
        Begin
          fCancelaTransac;
          Result := FALSE;
          Exit;
        End;
      End;

      {************************}
      {* RATEIA O VALOR DO RT *}
      {*********************PZ*}
      pRateiaValorRT;

      strEmpDoc := IIF(blnAlteraFormaPagamentoLiberacaoPedidoMultiEmp Or blnEmGeracaoVendasPerdidas, fEmpresaDocumentoGravaArquivos(), VS_strCodEmp);

      If (strOpcDoc <> 'CR') And (Not blnImportacaoNfeParaSped) Then
      Begin

        If (strEspDoc = 'NS') Then
          strSerFsc := fCfgSis('SERNFS')
        Else If ((strEspDoc = 'IF') And (fCfgSis('USNFCE', varBoolean) Or fUsaSat)) Then
          strSerFsc := fCfgSis('SERNFC')
        Else
        begin
          If (Self.blnImportacaoSpedPisCofins) Then
          Begin
            If (fEmptyStr(strSerFsc)) Then
              strSerFsc := fCfgSis('SERFSC');
          End
          Else
            strSerFsc := fCfgSis('SERFSC');
        end;

      End;

      If (blnNovoSequencial) Then
      Begin

        If (strEspDoc = 'NF') Then
        Begin
          If (Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') And (Not blnConfirmacaoEspelho) Then
            strNumDoc := fRetSequencial('PROESP', VS_strCodEmp, 12)
          Else If blnEspelhoDevolucaoCliente Then
            strNumDoc := fRetSequencial('PROESP', VS_strCodEmp, 12)
          Else
            strNumDoc := fRetornaSeqNota;
        End;

        If (strEspDoc = 'NS') Then
          strNumDoc := fRetSequencial('PRO_NS', VS_strCodEmp, fTamDocCadRec);

        If (strEspDoc = 'EP') Then
          strNumDoc := fRetSequencial('PRO_EP', VS_strCodEmp, fTamDocCadRec);

      end;

      strHorSai := TimeToStr(fRetHoraServidor);

      pInfoStatusGravacao('Aguarde... Preparando para Gravação');
      pStepStatusGravacao;

      {*****************************************}
      {* ATUALIZA:                             *}
      {* - ULTIMA COMPRA DO CLIENTE            *}
      {* - MAIOR COMPRA DO CLIENTE             *}
      {***********************************MV/MA*}
      If Pos(strEspDoc, 'PD_OR_PR_') <= 0 Then
      Begin
        If Pos(strClaFis, VS_strClaVen) > 0 Then
          blnAlteraCliente := True;
      End;

      pDefineVariaveisSeGravaCaixa;

      If (Not fEmptyStr(Self.strEmp_TE)) And (Pos(strEspDoc, 'NF_IF_IV_EL_MI_FF_NS_') > 0) then
      begin
        if (VS_strCodEmp <> Self.strEmp_TE) And (Not fCfgSis('TEDIFN', varBoolean)) then
        begin
          fCancelaTransac;
          fMensagem('ATENÇÃO!','O documento a ser gravado não está com o código de empresa correto!' + sLineBreak +
                               'Empresa Logada: ' + VS_strCodEmp + sLineBreak +
                               'Empresa de TE.: ' + Self.strEmp_TE + sLineBreak +
                               'Favor entrar em contato com a Citel e reportar essa mensagem!', ['&OK']);

          Result := FALSE;
          Exit;
        end;
      end;

      {**************************************}
      {* VERIFICA SE O SALDO NO CAIXA VAI   *}
      {* FICAR MAIOR QUE O MÁXIMO PERMITIDO *}
      {***********************************RS*}
      If blnCfgGravaResCai And blnValGravaResCai Then
      Begin
        If Not objResumoDeCaixa.fVerificaSaldoMaximo(fltValDin, fGetOperadorDaBaixa, strCodigoCaixa, fInTransaction) Then
        Begin
          fCancelaTransac;
          Result := FALSE;
          Exit;
        End;
      End;

      If DadosPixDaVenda.RecebidoPorPix = 'S' Then
      Begin
        LlstPixPago := fRetornaLstPixPago ;
        for LPixPago in LlstPixPago do
        begin
          LPixPago.SeqConRecebimento := intSeqConRcx;

          If blnCfgGravaResCai And blnValGravaResCai Then
            LPixPago.SeqConTransferencia := StrToInt(fRetRcxCon(strEmpLog));
        end ;
      End;

      If Not Self.FPortadorTFAutomatica.IsEmpty Then
      Begin
        If Self.FSeqconTFAutomatica = 0 Then
          Self.FSeqconTFAutomatica := StrToInt(fRetRcxCon(strEmpLog));
      End;

      {*****************************************}
      {* ATUALIZA OS DADOS DA MATRIZ PARA A    *}
      {* TEMPORARIA                            *}
      {**************************************MV*}
      pCarregaResumoCfop(Self);

      pInfoStatusGravacao('Aguarde... Retornando Sequencial ' + strEspDoc);
      pStepStatusGravacao;

      {*****************************************}
      {* PEGA NUMERO DE DOCUMENTO              *}
      {**************************************MV*}
      {************************************************}
      {* NUMERO DA NF E GERADO NO COMECO POR CAUSA DA *}
      {* NOTA FISCAL ELETRONICA                       *}
      {*********************************************PH*}
      If (blnNovoSequencial) Then
      Begin

        If (strEspDoc = 'UC') Then
          strNumDoc := fRetSequencial('PRO_UC', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'FF') Then
          strNumDoc := fRetSequencial('PRO_FF', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'OR') Then
        Begin
          If fEmptyStr(strNumOrc) Then
            strNumDoc := fRetSequencial('PRO_OR', strPedEmp, fTamDocCadRec)
          Else
            strNumDoc := strNumOrc;
        End

        Else If (strEspDoc = 'PR') Then
          strNumDoc := fRetSequencial('PRO_DR', strPedEmp, fTamDocCadRec)

        Else If (strEspDoc = 'PD') Then
        Begin
          If ( (fCfgSis('F11PGR', varString) = 'S') And (strOpcDoc = 'CP') And (strEspDoc = 'PD') And blnAgrupamentoPedidos) Or
             (fEmptyStr(strNumOrc)) Or (strOpcDoc = 'OR') Or
             ((Pos(strOpcDoc, 'VN_CS_') > 0) And (strEspOrc <> 'PD')) Or
             (blnRetiraOutraLojaEmNovoPedido) Or
             (blnRetiraMesmaLojaEmNovoPedido) Or
             (blnRetiraExpedicaoEmNovoPedido) Or
             (blnAbastecTransfReqEmNovoPedido) Or
             (blnEmitirNovoPedidoEntregaCD) Or
             (blnEntregaImediataEmNovoPedido) Or
             (blnDesmembramentoDePedidosComAdiantamento) Then
          Begin
            If (fltTotGer > 0) Or fEmissaoPedidoBrinde Or blnGravandoPedidoCorteFaltaEstoque Then
              strNumDoc := fRetSequencialPedido(strPedEmp)
          End
          Else
            strNumDoc := strNumOrc;
        End

        Else If (strEspDoc = 'BR') Then
          strNumDoc := fRetSequencial('PRO_BR', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'IF') Then
          strNumDoc := fRetSequencial('PRO_IF', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'TE') Then
          strNumDoc := fRetSequencial_TE

        Else If (strEspDoc = 'TR') Then
          strNumDoc := fRetSequencial('PRO_TR', VS_strCodEmp, fTamDocCadRec)

        Else If (Pos(strOpcDoc, 'DV') > 0) And (Pos(strEspDoc, 'NF_EL_') <= 0) Then
          strNumDoc := fRetSequencial('PRO_DV', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'PI') Then
          strNumDoc := fRetSequencial('PRO_PI', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'CS') Then
          strNumDoc := fRetSequencial('PRO_CS', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'GF') Then
          strNumDoc := fRetSequencial('PROGEF', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'PA') Then
          strNumDoc := fRetSequencial('PRO_PA', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'RB') Then
          strNumDoc := fRetSequencial('PRO_RB', VS_strCodEmp, fTamDocCadRec)

        Else If (strEspDoc = 'CR') Then
          strNumDoc := fRetSequencial('SEQRCS', VS_strCodEmp, fTamDocCadRec)
      End;

      If fRegravarRequisicoesDeCompra And FblnApagarRequisicaoCompra Then
      Begin
        for intContador := 0 to Pred(stlReqCompras.Count) do
          TfrmFatRequisicaoCompras.fApagaMovRcd(stlReqCompras[intContador]);
      End;


      If Self.lstLogAbt.fGravacaoPendente() Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Log do Abastecimento');
        pStepStatusGravacao;

        Self.lstLogAbt.pGravarListaLogAbt(strNumDoc,
                                          strEspDoc,
                                          VS_strCodEmp,
                                          True);
      End;


      blnTemAlgumItemComQuantidadeComprarJaPreenchida := fTemAlgumItemComQuantidadeComprarJaPreenchida;
      blnDeveGravarReqCompraEntFuturaFaltaProdutoF11Caixa := fDeveGravarReqCompraEntFuturaFaltaProdutoF11Caixa;

     If (STR_MSG_PEDIDO_NOVA_LOJA <> strMen001) Then
       If fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
         FblnHaveraDesmembramentoRetiraCaixa := fHaveraDesmembramentoVenda(arrMatItens);

      Self.blnChamouRequisicaoFaltaProdutoNaEmissaoPedido :=
