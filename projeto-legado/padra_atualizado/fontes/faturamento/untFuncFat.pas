      (FieldByName('ITE_UNIDIG') As TFloatField).DisplayFormat := fMskDigitos(fMaxDecUni)
    Else
      (FieldByName('ITE_UNIDIG') As TFloatField).DisplayFormat := fMskDigitos(VS_intDecUni);

    (FieldByName('ITE_TAXJUR') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_MARLUC') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_PRECUS') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_DESCON') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_TOTITE') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_IPISAI') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VALIPI') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VAL_ST') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VALFCP') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VALIBS') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VALCBS') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VAL_IS') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VLRCON') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_UNICON') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_MARCAT') As TFloatField).DisplayFormat := '#,##0.00';
    (FieldByName('ITE_VARTAB') As TFloatField).DisplayFormat := '#,##0.00;#,##0.00';

    If fCfgSis('EXISAL', varBoolean) Then
    Begin
      If Assigned(FindField('ESTLOJ')) Then
        (FieldByName('ESTLOJ') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', VarInteger));

