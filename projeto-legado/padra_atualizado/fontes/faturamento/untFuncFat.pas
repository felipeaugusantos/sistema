procedure TFatVenda.pCarregaItensOriginais(Var qryFatDor: TUniQuery);
begin
  qryFatDor.Close;
  qryFatDor.SQL.Clear;
  qryFatDor.SQL.Text := 'SELECT                   '+
                        '  FDO_CODITE,            '+
                        '  FDO_QTDITE,            '+
                        '  FDO_TOTITE             '+
                        'FROM                     '+
                        '  FATDOR                 '+
                        'WHERE                    '+
                        '  FDO_SEQGER = :SEQGER   ';

  qryFatDor.ParamByName('SEQGER').AsString := fRetAutIncPedido(strNumOrc, strEspOrc, strEmpOri);
  qryFatDor.Open;
end;

function TFatVenda.fDivergenciaNosItens(qryFatDor: TUniQuery;
  const blnVerificarTotalItem: Boolean): Boolean;
Var
  strCodIte      : String;
  fltQtdIte,
  fltTotIte      : Double;
  blnFoiAlterado : Boolean;
begin
  Result := True;

  If (qryFatDor.RecordCount <> cdsVenda.RecordCount) Then
    Exit;

  While (Not qryFatDor.Eof) Do
  Begin
    strCodIte := qryFatDor.FieldByName('FDO_CODITE').AsString;
    fltQtdIte := qryFatDor.FieldByName('FDO_QTDITE').AsFloat;
    fltTotIte := qryFatDor.FieldByName('FDO_TOTITE').AsFloat;

    If blnVerificarTotalItem Then
      blnFoiAlterado := (fItemFoiAlterado(strCodIte, fltQtdIte, fltTotIte))
    else
      blnFoiAlterado := (fItemFoiAlterado(strCodIte, fltQtdIte));

    If blnFoiAlterado Then
      Exit;

    qryFatDor.Next;
  End;

  Result := False;
end;

function TFatVenda.fItemFoiAlterado(strCodIte: String; fltQtdIte: Double): Boolean;
begin
  Result := False;

  If (cdsVenda.Locate('ITE_CODITE', strCodIte, [])) Then
  Begin
    If (CompareValue(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fltQtdIte) = EqualsValue) Then
      Exit;
  End;

  Result := True;
end;

function TFatVenda.fValorAdiantamento(fltVlrAReceber, fltTotAdiantamento: Double; Var fltVlrAdtDisponivel: Double): Double;
  Var
    fltVlrRestante: Double;
begin
  Result := 0;

  If (fltTotAdiantamento <= 0) Then
    Exit;

  fltVlrRestante := fltVlrAdtDisponivel - fltVlrAReceber;

  If (fltVlrRestante >= 0) Then
  Begin
    Result := fltVlrAReceber;
    fltVlrAdtDisponivel := fltVlrRestante;
  End
  Else
  Begin
    Result := fltVlrAdtDisponivel;
    fltVlrAdtDisponivel := 0;
  End;
end;

