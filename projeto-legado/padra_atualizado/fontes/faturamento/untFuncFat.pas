{**********************************}
{* RETORNA A TAG PELO HINT DO MENU *}
{*****************************PE*AF*}
function fRetTagMenu(strHint: String): Integer;
  Var
    intContador: Integer;
Begin
  Result := -1;

  For intContador := 0 To frmPrincipal.mnuAutcomK.Items.Count - 1 Do
  Begin
    If frmPrincipal.mnuAutcomK.Items[intContador].Visible = False Then
    Begin
      Result := fVerificaMenuTag(frmPrincipal.mnuAutcomK.Items[intContador], strHint);

      If Result > 0 Then
        Break;
    End;
  End;

  result := abs(Result);

End;

{***************************************}
{* RETORNA A TAG PELO HINT DO SUB-MENU *}
{************************************PE*}
function fVerificaMenuTag(Item: TMenuItem; strHintg: String ): Integer;
  Var
    intContador: Integer;
Begin

  Result := -1;

  If Item.Hint = strHintg Then
  Begin
    Result := Item.Tag;
  End
  Else
  Begin
    For intContador := 0 To Item.Count-1 Do
    Begin

      If Item[intContador].Hint = strHintg Then
      Begin
        Result := Item[intContador].Tag;
        Break;
      End;

      If Item[intContador].Count > 0 Then
      Begin
        Result := fVerificaMenuTag(Item[intContador], strHintg);

        If Result > 0 Then
          Break;
      End;

    End;
  End;

End;

function GetDescricaoDirAce(ADirAce: String): String;
Var
  LMenu: TMenuItem;
  I: Integer;
begin
  Result := '';
  LMenu := Nil;
  For I := 0 To Pred(frmPrincipal.mnuAutcomK.Items.Count) Do
  Begin
    LMenu := fFindMenu(ADirAce, frmPrincipal.mnuAutcomK.Items[I], True);
    If Assigned(LMenu) Then
      Break;
  End;
  If Assigned(LMenu) Then
    Result := fGetMenuPath(LMenu);
end;

{*********************************************}
{* RETORNA O IMAGEINDEX PELA TAG DO SUB-MENU *}
{******************************************PE*}
function fVerificaMenuImageIndex(Item: TMenuItem; intTag: Integer; blnTemDireito: Boolean ): Integer;
Var
  intContador: Integer;
Begin

  Result := -1;

  For intContador := 0 To Item.Count-1 Do
  Begin
    If Item[intContador].Tag = intTag Then
    Begin
      Result := Item[intContador].ImageIndex;
      Break;
    End;

    If Item[intContador].Count > 0 Then
    Begin
      Result := fVerificaMenuImageIndex(Item[intContador], intTag, blnTemDireito);

      If Result >  0 Then
        Break;
    End;
  End;
End;

{*****************************************}
{* RETORNA O IMAGEINDEX PELA TAG DO MENU *}
{**************************************AC*}
function fRetImagemIndexMenu(intTag: Integer; Var blnTemDireito: Boolean): Integer;
  Var
    intContador: Integer;
Begin

  Result := 0;
  blnTemDireito := True;

  For intContador := 0 To frmPrincipal.mnuAutcomK.Items.Count - 1 Do
  Begin
    If frmPrincipal.mnuAutcomK.Items[intContador].Visible = False Then
    Begin
      Result := fVerificaMenuImageIndex(frmPrincipal.mnuAutcomK.Items[intContador],intTag, True);

      If Result > 0 Then
        Break;
    End;
  End;
End;

