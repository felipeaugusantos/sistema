procedure TFatVenda.pAjustaCSTSimples;
  Var
    intContador: Integer;

  function fEnviar0900(strClaFis, strEmpIte: String): Boolean;
  Begin
    Result := False;

    If (fCfgSis('SIMPAU', varBoolean, GetEmpCfg(strEmpIte))) Then
    Begin
      If (Pos(strClaFis, fTransform(fCfgSis('CFODVF'),4)) > 0) And
         ( (Not fEmptyStr(strCodFor)) Or (fDocumentoParaFornecedor) ) And
         (Not fRetFornecedorSimples(strCodFor)) Then
      Begin
        Result := True;
      End
      Else If (LeftStr(strClaFis, 1) = '3') Then
      Begin
        Result := True;
      End
      Else If (strOpcDoc = 'DV') And (fCfgSis('CSTDEV', varString) = '2') then
      Begin
        Result := True;
      End;
    End;
  End;

begin
  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (fEnviar0900(arrMatItens[intContador].strClaFis, arrMatItens[intContador].strEmpIte)) And
       ( (fFormataFloat(arrMatItens[intContador].fltBasIcm, 2) > 0) Or
         (fFormataFloat(arrMatItens[intContador].fltAlqIcm, 2) > 0) Or
         (fFormataFloat(arrMatItens[intContador].fltValIcm, 2) > 0) Or
         (fFormataFloat(arrMatItens[intContador].fltBasRet, 2) > 0) Or
         (fFormataFloat(arrMatItens[intContador].fltAlqRet, 2) > 0) Or
         (fFormataFloat(arrMatItens[intContador].fltValRet, 2) > 0) ) Then
    Begin
      If FNotImp = 'S' Then
      Begin
        arrMatItens[intContador].strCodSit := '190';
        arrMatItens[intContador].strCodFis := '190';
      End
      Else
      Begin
        arrMatItens[intContador].strCodSit := LeftStr(arrMatItens[intContador].strCodSit, 1) + '90';
        arrMatItens[intContador].strCodFis := LeftStr(arrMatItens[intContador].strCodFis, 1) + '90';
      End
    End;
  End;
end;

