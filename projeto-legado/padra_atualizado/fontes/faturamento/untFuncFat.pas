{*****************************************}
{* SENHA PARA UTILIZAÇÃO DE CRÉDITO      *}
{*REQ40675-45504***********************LE*}
function fSenhaCreditos(cdsDadosTemp:TUniClientDataSet; strCampoCorrigido: String): Boolean;
  Var
    fltTotCre        : Double;
    fltTotCor        : Double;
    fltTotDup        : Double;
    blnMesmoCliente  : Boolean;
    strCli           : String;
    cdsAuxTemp       : TUniClientDataSet;
    objLiberacao     : TLiberacao;
    objTabela        : TRegistroMsgLiberaTabela;
    objLinha         : TLinhaMsgLibera;
    strCliCre        : String;
    fltCreCli        : Double;


    procedure pMontaHistorico;
    Begin

      With cdsAuxTemp  Do
      Begin
        If Not IsEmpty Then
        Begin
          First;

          strCli := FieldByName('CTR_CODCLI').AsString;
          blnMesmoCliente := True;

          While Not Eof Do
          Begin
            {*****************************}
            {* Grava o cliente com maior *}
            {* crédito na liberação      *}
            {**************************FS*}
            If (FieldByName('CTR_VALDUP').AsFloat < fltCreCli) Then
            Begin
              strCliCre := FieldByName('CTR_CODCLI').AsString;
              fltCreCli := FieldByName('CTR_VALDUP').AsFloat;
            End;

            If (strCli <> FieldByName('CTR_CODCLI').AsString) Then
              blnMesmoCliente := False;

            objLinha              := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.pAddColuna('Duplicata'   , fPadR(FieldByName('CTR_NUMDUP').AsString,12) + '-' + FieldByName('CTR_PARCEL').AsString + '-' + FieldByName('CTR_ESPDOC').AsString, 17 , alEsquerda, teAmbos);
            objLinha.pAddColuna('Cliente'     , FieldByName('CTR_NOMCLI').AsString                                   , 30 , alEsquerda, teAmbos);
            objLinha.pAddColuna('Emp'         , FieldByName('CTR_CODEMP').AsString                                   , 3  , alEsquerda, teAmbos);
            objLinha.pAddColuna('Dt.Cadastro' , FormatDateTime('dd/mm/yyyy', FieldByName('CTR_DTACAD').AsDateTime)   , 12 , alCentro  , teAmbos);
            objLinha.pAddColuna('Dt.Vencto. ' , FormatDateTime('dd/mm/yyyy', FieldByName('CTR_DTAVEN').AsDateTime)   , 12 , alCentro  , teAmbos);
            objLinha.pAddColuna('Vr.Duplicata', FormatFloat('###,###,##0.00', FieldByName('CTR_VALDUP').AsFloat)     , 14 , alDireita , teAmbos);
            objLinha.pAddColuna('Vr.Corrigido', FormatFloat('###,###,##0.00', FieldByName(strCampoCorrigido).AsFloat), 14 , alDireita , teAmbos);

            objTabela.lstLinhas.Add(objLinha);
            pProcessMessages;
            Next;
          End;
        End;
      End;

    End;

begin
  Result    := True;
  fltTotCre := 0;
  fltTotCor := 0;
  fltTotDup := 0;
  blnMesmoCliente := False;
  strCli := '';
  strCliCre := '';
  fltCreCli := 0;

   If Not fEmptyStr(fCfgSis('RCXCRE')) Then
   Begin
     cdsAuxTemp := TUniClientDataSet.Create(Nil);
     cdsAuxTemp.Data := cdsDadosTemp.Data;
     cdsAuxTemp.LogChanges := False;

    With cdsAuxTemp Do
    Begin
      DisableControls;
      Filter   := ' CTR_MARDES =' + QuotedStr('M');
      Filtered := True;
      EnableControls;

      First;
      While Not EOF Do
      Begin
        If FieldByName('CTR_VALDUP').AsFloat < 0 Then
          fltTotCre := fltTotCre + FieldByName('CTR_VALDUP').AsFloat;

        fltTotCor := fltTotCor + FieldByName(strCampoCorrigido).AsFloat;
        fltTotDup := fltTotDup + FieldByName('CTR_VALDUP').AsFloat;
        Next;
      End;
    End;

    If (fltTotCre < 0.0) Then
    Begin
      objLiberacao            := TLiberacao.Create;

      objLiberacao.strDirAce  := 'RCXCRE';
      objLiberacao.strSenLib  := fCfgSis('RCXCRE');
      objLiberacao.strMsgSen  := 'Senha para utilização de crédito';
      objLiberacao.strCodOpe  := strLoginUsuarioLogado;
      objLiberacao.strCliente := IIF(blnMesmoCliente, strCli, '');

      objLiberacao.objMsgLibera.pAddTexto('ACESSO A UTILIZAÇÃO DE CRÉDITO NO RECEBIMENTO DE DUPLICATAS', alCentro);

      objTabela := TRegistroMsgLiberaTabela.Create;

      objLinha  := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlCabecalho;
      objLinha.pAddColuna('', 'DUPLICATA'   , 17 , alEsquerda, teAutcom);
      objLinha.pAddColuna('', 'CLIENTE'     , 30 , alEsquerda, teAutcom);
      objLinha.pAddColuna('', 'EMP'         , 3  , alEsquerda, teAutcom);
      objLinha.pAddColuna('', 'DT.CADASTRO' , 12 , alCentro  , teAutcom);
      objLinha.pAddColuna('', 'DT.VENCTO. ' , 12 , alCentro  , teAutcom);
      objLinha.pAddColuna('', 'VR.DUPLICATA', 14 , alDireita  , teAutcom);
      objLinha.pAddColuna('', 'VR.CORRIGIDO', 14 , alDireita  , teAutcom);

      objTabela.lstLinhas.Add(objLinha);

      pMontaHistorico;

      objLinha              := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlTotal;
      objLinha.pAddColuna('TOTAL'   , 'TOTAL', 82 , alDireita, teAutcom);
      objLinha.pAddColuna('Vr.Duplicata', FormatFloat('###,###,##0.00', fltTotDup) , 14 , alDireita , teAmbos);
      objLinha.pAddColuna('Vr.Corrigido', FormatFloat('###,###,##0.00', fltTotCor) , 14 , alDireita , teAmbos);

      objTabela.lstLinhas.Add(objLinha);

      objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

      Result := objLiberacao.fLibera;
    End;

   FreeAndNil(cdsAuxTemp);
   FreeAndNil(objLiberacao);

  End;
end;

function fMesclaMensagemMaisJustificativa(strMensagem,
  strJustific: String; strJusLib: String = ''): String;
begin
  {***********************************************************************}
  {* SUBSTITUI FLAG DE JUSTIFICAVA CASO O PROGRAMADOR TENHA DETERMINADO  *}
  {* A POSIÇÃO DESEJADA, CASO CONTRÁRIO CONCATENA COM A MENSAGEM JOGANDO *}
  {* O TEXTO NO FINAL, GARANTINDO QUE SEMPRE A JUSTIFICAVA SEJA ENVIADA  *}
  {*********************************************************************VA}
  If fEmptyStr(strJustific) Then
    Result := AnsiReplaceStr(strMensagem, STRING_JUSTIFICATIVA, '')
  Else
  Begin
    If Pos(STRING_JUSTIFICATIVA, strMensagem) > 0 Then
      Result := AnsiReplaceStr(strMensagem, STRING_JUSTIFICATIVA, strJustific)
    Else
      Result := strMensagem + strJustific;
  End;

  If fEmptyStr(strJusLib) Then
  Begin
    Result := AnsiReplaceStr(Result, STRING_JUSTIFICATIVA_LIBERACAO, '');
  End
  Else
  Begin
    If Pos(STRING_JUSTIFICATIVA_LIBERACAO, Result) > 0 Then
    Begin
      Result := AnsiReplaceStr(Result, STRING_JUSTIFICATIVA_LIBERACAO, strJusLib);
    End
    Else
    Begin
      Result := Result + strJusLib;
    End;
  End;
end;

{******************************************}
{* VERIFICA SE PEDIDO / ORÇAMENTO EXISTE  *}
{* CASO EXISTA, CARREGA OS DADOS NA QUERY *}
{***************************************MV*}
{******************************************}
{* VERIFICA SE PEDIDO / ORÇAMENTO EXISTE  *}
{* E SE ELE TA FATURADO OU CANCELADO      *}
{* CASO EXISTA, CARREGA OS DADOS NA QUERY *}
{***************************************JB*}
function fDocumentoFatExiste(Var qryFatGor: TUniQuery;
                             strNumDoc,
                             strEspDoc,
                             strCodEmp: String;
                             Var blnJaFatu: Boolean;
                             Var blnJaBaix: Boolean;
                             Var blnImpresso: Boolean;
                             Var strCodVen: String;
                             Var blnSepImpresso: Boolean;
                             blnFilVal: Boolean = False): Boolean;
  Var
    strSQL: String;
begin

  strSQL := '';
  strSQL := strSQL + 'SELECT     ';
  strSQL := strSQL + '  *        ';
  strSQL := strSQL + 'FROM       ';
  strSQL := strSQL + '  FATGOR F ';
  strSQL := strSQL + '  LEFT JOIN EXTGOR E ON E.FGO_SEQFGO = F.AUTOINCREM ';
  strSQL := strSQL + '  LEFT JOIN SERGOR S ON S.FGO_SEQFGO = F.AUTOINCREM ';
  strSQL := strSQL + '  LEFT JOIN AUXGOR G ON G.AUX_SEQGER = F.AUTOINCREM ';

  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  F.FGO_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  F.FGO_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  F.FGO_CODEMP = :CODEMP ';

  If (blnFilVal) Then
    strSQL := strSQL + ' AND (FGO_TEMBRI = "S" OR FGO_VLRCON <> 0) ';

  With qryFatGor Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    Open;

    If (Not IsEmpty) Then
    Begin
      Result         := True;
      blnJaFatu      :=  (FieldByName('FGO_JAFATU').AsInteger = 1);
      blnJaBaix      := (FieldByName('FGO_JAFATU').AsInteger = 1) and
                        (FieldByName('FGO_NUMFAT').AsString = '') and
                        (FieldByName('FGO_MOTBAI').AsString <> '');
      blnImpresso    := (FieldByName('FGO_PEDIMP').AsString = 'S');
      blnSepImpresso := (FieldByName('FGO_SEPIMP').AsString = '1') or
                        (FieldByName('FGO_SEPIMP').AsString = '2');
      strCodVen      := FieldByName('FGO_CODVEN').AsString;
    End
    Else
    Begin
      Result         := False;
      blnJaFatu      := False;
      blnJaBaix      := False;
      blnImpresso    := False;
      blnSepImpresso := False;
      strCodVen      := '';
      qryFatGor.Close;
    End;

  End;

end;

function fTemOrdemProducaoTintaImpresso(strNumDoc, strEspDoc, strCodCli, strCodEmp: String): Boolean;
  Var
    strSQL: String;
    qryTinDor: TUniQuery;
begin
  Result := False;

  If fEmptyStr(strNumDoc) Then
    Exit;

  Try
    qryTinDor := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  T.FDO_ORDIMP AS ORDIMP ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  TINDOR T INNER JOIN FATDOR F ON T.FDO_SEQGER = F.FDO_SEQGER ';
    strSQL := strSQL + '                              AND T.FDO_CODITE = F.FDO_CODITE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  F.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  F.FDO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  F.FDO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  F.FDO_CODCLI = :CODCLI ';
    strSQL := strSQL + 'ORDER BY F.FDO_CODITE ';

    With qryTinDor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;
      First;
      While Not EOF Do
      Begin
        If (FieldByName('ORDIMP').AsInteger > 0) Then
        Begin
          Result := True;
          Last;
        End;

        Next;
      End;

    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[fTemOrdemProducaoTintaImpresso]');
  End;

  FreeAndNil(qryTinDor);
end;

function fTemProdutoTintometrico(strNumDoc, strEspDoc, strCodCli, strCodEmp: String): Boolean;
  Var
    strSQL: String;
    qryFatDor: TUniQuery;
begin
  Result := False;

  If fEmptyStr(strNumDoc) Then
    Exit;

  Try
    qryFatDor := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  COUNT(*) AS QTDITE ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  TINDOR T INNER JOIN FATDOR F ON T.FDO_SEQGER = F.FDO_SEQGER ';
    strSQL := strSQL + '                              AND T.FDO_CODITE = F.FDO_CODITE ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  F.FDO_NUMDOC  = :NUMDOC AND ';
    strSQL := strSQL + '  F.FDO_ESPDOC  = :ESPDOC AND ';
    strSQL := strSQL + '  F.FDO_CODEMP  = :CODEMP AND ';
    strSQL := strSQL + '  F.FDO_CODCLI  = :CODCLI AND ';
    strSQL := strSQL + '  IFNULL(F.FDO_IDEPRO,"NOR") <> "NOR" ';
    strSQL := strSQL + 'ORDER BY F.FDO_CODITE ';

    With qryFatDor Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      Result := FieldByName('QTDITE').AsInteger > 0
    End;

  Except

    On E: Exception Do
      pMensagensErro(E.Message, '[fTemProdutoTintometrico]');

  End;

  FreeAndNil(qryFatDor);
end;

