    FreeAndNil(valorDuplicatas);
  End;

  If (Result) And Assigned(FobjEstruturaPersonalizada) Then
    If (FobjEstruturaPersonalizada.blnEstruturaFoiPersonalizada) And (Pos(strOpcDoc,'VN_') > 0) Then
      FobjEstruturaPersonalizada.pGravarEstruturaPersonalizada(strNumDoc, strEspDoc, VS_strCodEmp);

  If (Result) And (blnDevAutomatizadaDocOutraEmpresa) Then
    Result := fGerarTransferenciaAjusteEstoqueDevolucaoAutomatizada;

  strMsgAux := fValidaQuantidadeEmDevolucaoConformeOriginal;
