  objLiberacao.objMsgLibera.pAddTextoCaption('CNPJ/CPF'         , fRetCgcCpf(strCliNov), 16);
  objLiberacao.objMsgLibera.pAddTextoCaption('Cidade'           , fRetNomCidade(fRetCodCidByCliente(strCliNov)) + '-' + fRetEstadoCliente(strCliNov), 16);
  objLiberacao.objMsgLibera.pAddSeparador(80);
