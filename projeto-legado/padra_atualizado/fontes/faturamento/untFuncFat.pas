procedure pCarregaInformacoesPedidoDevRetira(const fatVenda: TFatVenda;
  const strCodEmp, strNumDoc, strEspDoc:String);
var
  qryDados : TUniQuery;
begin
  qryDados := fCriaQuery(Nil);
  Try
    If (fEmptyStr(strCodEmp)) Or
       (fEmptyStr(strNumDoc)) Or
       (fEmptyStr(strEspDoc)) Then
      Exit;

    qryDados.Close;
    qryDados.SQL.Text := 'SELECT '
                       + '       G.FGO_MEN001 '
                       + '     , G.FGO_MEN002 '
                       + '     , A.AUX_MEN003 '
                       + '     , A.AUX_MEN004 '
                       + '     , A.AUX_MEN005 '
                       + '     , C.CND_CODIGO '
                       + '     , C.CND_DESCRI '
                       + '     , C.CND_CNDESP '
                       + '     , C.CND_TRACNC '
                       + '     , F.FPG_CODIGO '
                       + '     , F.FPG_DESCRI '
                       + '     , G.FGO_CONPAG '
                       + '     , E.FGO_VENPRE '
                       + '  FROM FATGOR G '
                       + '  LEFT JOIN AUXGOR A ON A.AUX_SEQGER = G.AUTOINCREM '
                       + '  LEFT JOIN EXTGOR E ON E.FGO_SEQFGO = G.AUTOINCREM '
                       + '  LEFT JOIN CADCND C ON C.CND_CODIGO = G.FGO_CODCND '
                       + '  LEFT JOIN CADFPG F ON F.FPG_CODIGO = G.FGO_CODFPG '
                       + ' WHERE G.FGO_CODEMP = :CODEMP '
                       + '   AND G.FGO_NUMDOC = :NUMDOC '
                       + '   AND G.FGO_ESPDOC = :ESPDOC ';

    qryDados.ParamByName('CODEMP').AsString := strCodEmp;
    qryDados.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDados.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDados.Open;

    If (qryDados.IsEmpty) Then
      Exit;

    fatVenda.strMsgAdi := qryDados.FieldByName('FGO_MEN001').AsString + ' '
                        + qryDados.FieldByName('FGO_MEN002').AsString + ' '
                        + qryDados.FieldByName('AUX_MEN003').AsString + ' '
                        + qryDados.FieldByName('AUX_MEN004').AsString + ' '
                        + qryDados.FieldByName('AUX_MEN005').AsString;

    fatVenda.strConPag := qryDados.FieldByName('FGO_CONPAG').AsString;
    fatVenda.strCndFor := fFormataCondPag(fatVenda.strConPag);
    fatVenda.blnVendaPresencial := (qryDados.FieldByName('FGO_VENPRE').AsString = 'S');

    If (fCfgSis('USACND', varBoolean)) Then
    Begin
      If fEmptyStr(qryDados.FieldByName('CND_CODIGO').AsString) Then
        Exit;

      fatVenda.strCodCnd      := qryDados.FieldByName('CND_CODIGO').AsString;
      fatVenda.strDesCnd      := qryDados.FieldByName('CND_DESCRI').AsString;
      fatVenda.blnCndEsp      := (qryDados.FieldByName('CND_CNDESP').AsString = 'S');
      fatVenda.blnCndTravaCli := (qryDados.FieldByName('CND_TRACNC').AsString = 'S');
    End;

    If (fCfgSis('USAFPG', varBoolean)) Then
    Begin
      fatVenda.strCodFpg := qryDados.FieldByName('FPG_CODIGO').AsString;
      fatVenda.strDesFpg := qryDados.FieldByName('FPG_DESCRI').AsString;
    End;
  Finally
    FreeAndNil(qryDados);
  End;
end;

function TFatVenda.fVerificaGrvCaixa(Var strMsgDif: String; const intSeqCon: Integer): Boolean;
  Var
    strSQL   : String;
    qryGenRcx: TUniQuery;

begin
  qryGenRcx := fCriaQuery(Self);

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  SUM(RCX_VALDOC) AS VALDOC, ';
  strSQL := strSQL + '  SUM(RCX_DINREC + RCX_CARREC + RCX_CHQAVI + RCX_CHQPRE + RCX_ORDREC + RCX_VALFIN) AS VALMOD ';
  strSQL := strSQL + 'FROM ';

  strSQL := strSQL + ' ( ';

  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  RCX_VALDOC, ';
  strSQL := strSQL + '  RCX_DINREC, ';
  strSQL := strSQL + '  RCX_CARREC, ';
  strSQL := strSQL + '  RCX_CHQAVI, ';
  strSQL := strSQL + '  RCX_CHQPRE, ';
  strSQL := strSQL + '  RCX_ORDREC, ';
  strSQL := strSQL + '  IFNULL(RCX_VALFIN, 0) AS RCX_VALFIN ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADRCXX ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  RCX_SEQCON = :SEQCON AND ';
  strSQL := strSQL + '  RCX_CODEMP = :CODEMP ';

  If blnImpPafEcf Then
  Begin
    strSQL := strSQL + ' UNION ALL ';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  RCX_VALDOC, ';
    strSQL := strSQL + '  RCX_DINREC, ';
    strSQL := strSQL + '  RCX_CARREC, ';
    strSQL := strSQL + '  RCX_CHQAVI, ';
    strSQL := strSQL + '  RCX_CHQPRE, ';
    strSQL := strSQL + '  RCX_ORDREC, ';
    strSQL := strSQL + '  IFNULL(RCX_VALFIN, 0) AS RCX_VALFIN ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADRCXX ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  RCX_ID_LOC = :ID_LOC AND ';
    strSQL := strSQL + '  RCX_ID_DOC = :ID_DOC AND ';
    strSQL := strSQL + '  RCX_NUMDOC NOT LIKE "F%" ';
  End;

  strSQL := strSQL + ' ) AS TAB ';

  With qryGenRcx Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('SEQCON').AsInteger := intSeqCon;
    ParamByName('CODEMP').AsString  := IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog);

    If blnImpPafEcf Then
    Begin
      ParamByName('ID_DOC').AsString := strPaf_Id_Doc;
      ParamByName('ID_LOC').AsString := strPaf_Id_Loc;
    End;

    Open;
    Result := fFormataFloat(FieldByName('VALDOC').AsFloat, 2) = fFormataFloat(FieldByName('VALMOD').AsFloat, 2);

    {***************************************}
    {* RETORNA A DIFERENÇA DAS MODALIDADES *}
    {*26/02/2015*REQ:22285***************AF*}
    If Not Result Then
      strMsgDif := 'ValDoc: ' + FloatToStrF(fFormataFloat(FieldByName('VALDOC').AsFloat, 2), ffFixed, 12, 2) + ' ' +
                   'ValMod: ' + FloatToStrF(fFormataFloat(FieldByName('VALMOD').AsFloat, 2), ffFixed, 12, 2);

    Close;
  End;

  FreeAndNil(qryGenRcx);
end;

function TFatVenda.fAdicionaAdiantamentoPrimeiraParcela(blnUtilizarValorTotalAdiantamento: Boolean = False; blnAlterarSequencialParcelas: Boolean = True; blnNotaEspecialFator: Boolean = False): Boolean;
  Const
  	strLetras = 'ABCDEFGHIJKLMNOPQRSTUVWYXZ';
  Var
    intContador: Integer;
    fltValDup: Double;
    strUltimaDtaParcela: String;
    fltUltimoValParcela: Double;
begin
  Result := True;
  intSeqDupBaiAdtCli := -1;

  If fltValAdt + IIF(blnBolVen, 0, fltBolAdt) = 0 Then
    Exit;

  If (fGerandoFFOuNFNaDeNotaEspecialPorValorComCadRecSeparado) Then
    Exit;

  strUltimaDtaParcela := arrDuplicata[High(arrDuplicata)].dtaDtaVen;
  fltUltimoValParcela := fFormataFloat(arrDuplicata[High(arrDuplicata)].curValor, 2);

  If (strUltimaDtaParcela <> '') And (fltUltimoValParcela <> 0) Then
  Begin
    Result := False;
    pMensagemOk('Documento possui adiantamento(s) de pedido. O valor do adiantamento(s) ' +
       'será lançado como a primeira parcela quitada, porém esta operação irá exceder a ' +
       'quantidade de parcelas disponíveis pelo sistema (12). Favor alterar a condição de ' +
       'pagamento do pedido removendo uma parcela antes de faturar!');
  End
  Else
  Begin
    If blnAlterarSequencialParcelas Then
    Begin
      For intContador := High(arrDuplicata) DownTo 1 Do
      Begin
        arrDuplicata[intContador] := arrDuplicata[intContador-1];
        //Altera o sequencial da parcela onde era "A" deve ficar "B"
        //Pode ocorrer de haver a parcela "A" duas vezes quando utiliza credito
        //por isso montei a funcao desta forma (JC)
        With arrDuplicata[intContador] Do
          If Pos(strSequen, strLetras) > 0 Then
            strSequen := strLetras[Pos(strSequen, strLetras)+1];
      End;
    End;

    If blnUtilizarValorTotalAdiantamento Then
    Begin
      fltValDup := fltValAdt + IIF(blnBolVen, 0, fltBolAdt);
    End
    //Caso o valor do adiantamento ultrapasse o valor do documento
    //deve gravar somente o necessario para quitar o documento
    Else If (fltValAdt + IIF(blnBolVen, 0, fltBolAdt) > fCalculaTotalParaCadRec) And (Not blnNotaEspecialFator) Then
    Begin
      pZeraDigDuplic(arrDuplicata);
      fltValDup := fCalculaTotalParaCadRec;
    End
    Else If fFaturandoPedidoComAdiantamentoParcial Then
    Begin
      fltValDup := fCalculaTotalParaCadRec - fltBolAdt;
    End
    Else
    Begin
      fltValDup := fltValAdt + IIF(blnBolVen, 0, fltBolAdt);
    End;

    //Adiciona uma parcela a vista quitada no valor do adiantamento
    arrDuplicata[0].strSequen := 'A';
    arrDuplicata[0].curValor  := fltValDup;
    arrDuplicata[0].dtaDtaVen := DateToStr(VS_Date);

    intSeqDupBaiAdtCli := 0;

    {*****************************************************************************************}
    {* COPIA DAS DUPLICATAS UTILIZADA PARA RESTAURAR A MESMA EM ALGUNS PONTOS DO FATURAMENTO *}
    {*************************************************************************************JC**}
    For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
      arrDuplicCop[intContador] := arrDuplicata[intContador];
  End;
end;

function TFatVenda.fAdicionaAdiantamentoUltimaParcela: Boolean;
  Var
    intContador: Integer;
    fltValDup: Double;
    strUltimaDtaParcela: String;
    fltUltimoValParcela: Double;
    strParcela: String;
begin
  Result := True;
  intSeqDupBaiAdtCli := -1;

  If fltValAdt + IIF(blnBolVen, 0, fltBolAdt) = 0 Then
    Exit;

  strUltimaDtaParcela := arrDuplicata[High(arrDuplicata)].dtaDtaVen;
  fltUltimoValParcela := fFormataFloat(arrDuplicata[High(arrDuplicata)].curValor, 2);

  If (strUltimaDtaParcela <> '') And (fltUltimoValParcela <> 0) Then
  Begin
    Result := False;
    pMensagemOk('O documento possui adiantamento de pedido. O valor do adiantamento ' +
       'será lançado como a última parcela quitada, porém esta operação irá exceder a ' +
       'quantidade de parcelas disponíveis pelo sistema (12). Favor alterar a condição de ' +
       'pagamento do pedido removendo uma parcela antes de faturar!');
    Exit;
  End;

  //Caso o valor do adiantamento ultrapasse o valor do documento
  //deve gravar somente o necessário para quitar o documento
  If fltValAdt + IIF(blnBolVen, 0, fltBolAdt) > fCalculaTotalParaCadRec Then
  Begin
    pZeraDigDuplic(arrDuplicata);
    fltValDup := fCalculaTotalParaCadRec;
  End
  Else
  Begin
    fltValDup := fltValAdt + IIF(blnBolVen, 0, fCalculaTotalParaCadRec - fltBolAdt);
  End;

  If fltValDup > 0 Then
  Begin
    //Busca a última parcela
    strParcela := '';
    For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
    Begin
      If arrDuplicata[intContador].curValor = 0 Then
        Break;
      strParcela := arrDuplicata[intContador].strSequen;
    End;

    If fEmptyStr(strParcela) Then
      strParcela := 'A'
    Else
      strParcela := fIncAlfaNumerico(strParcela);

    //Adiciona uma parcela à vista quitada no valor do restante do adiantamento
    arrDuplicata[intContador].strSequen := strParcela;
    arrDuplicata[intContador].curValor  := fltValDup;
    arrDuplicata[intContador].dtaDtaVen := DateToStr(VS_Date);

    intSeqDupBaiAdtCli := intContador;
  End;

  {*****************************************************************************************}
  {* COPIA DAS DUPLICATAS UTILIZADA PARA RESTAURAR A MESMA EM ALGUNS PONTOS DO FATURAMENTO *}
  {*************************************************************************************JC**}
  For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
    arrDuplicCop[intContador] := arrDuplicata[intContador];
end;

function TFatVenda.fLancarDebitoAdiantamento(const fltValRecAdt: Double;
  var strPedAdt: String; var totModalidades: TTotaisAdiantamento): Boolean;
  Var
    strPedido: String;
    strNumPed: String;
    strEspPed: String;
    strEmpPed: String;
    strDescri: String;
    stlPedidos: TStringList;
    item: TDadosFechamento;
    fltValDebRes: Double;
    totAdiantamento: TTotaisAdiantamento;

  function fEmitindoFaturamentoParaOutraLoja: Boolean;
  begin
    Result := (strOriF11 = 'S') And (Not fEmptyStr(Self.strEmpLog)) And (Self.blnMulLoj) And (Self.strEspDoc <> 'PD');
  end;

  function fGetDataAdiantamento(strNumPed, strEspPed, strEmpPed : String): String;
    Var
      qryAux : TUniQuery;
      strSQL : String;
  begin
    Result := '';

    strSQL := '';
    strSQL := strSQL + 'SELECT                     ';
    strSQL := strSQL + '  ADT_DTALAN               ';
    strSQL := strSQL + 'FROM                       ';
    strSQL := strSQL + '  ADTCLI                   ';
    strSQL := strSQL + 'WHERE ADT_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '  AND ADT_ESPDOC = :ESPDOC ';
    strSQL := strSQL + '  AND ADT_CODEMP = :CODEMP ';
    strSQL := strSQL + '  AND ADT_TIPLAN = "C"   ';
    strSQL := strSQL + '  AND ADT_ESTORN = "N"   ';

    qryAux := fCriaQuery();
    Try
      With qryAux Do
      Begin
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumPed;
        ParamByName('ESPDOC').AsString := strEspPed;
        ParamByName('CODEMP').AsString := strEmpPed;
        Open;

        If Not isEmpty Then
          Result := '-' + DateToStr(FieldByName('ADT_DTALAN').AsDateTime);
      End;
    Finally
      pFreeAndNil(qryAux);
    End;
  end;

begin
  Try
    Result    := True;

    If (fGerandoFFOuNFNaDeNotaEspecialPorValorComCadRecSeparado) Then
      Exit;

    strPedAdt := '';

    FillChar(totModalidades, SizeOf(totModalidades), #0);

    stlPedidos := TStringList.Create;

    For item In arrMatItens Do
    Begin
      If fEmptyStr(item.strNumOrc) Then
        Continue;

      strPedido := Concat(item.strNumOrc, item.strEspOrc, item.strEmpOrc);

      If stlPedidos.IndexOf(strPedido) = -1 Then
        stlPedidos.Add(strPedido);
    End;

    If (fCfgSis('TPNFCR') = SECOL) And (strOpcDoc = 'CN') Then
    Begin
      With qryTemporariaConfirmacao Do
      Begin
        If Not fEmptyStr(FieldByName('TMP_NUM_PD').AsString) Then
        Begin
          strPedido := Concat(FieldByName('TMP_NUM_PD').AsString,
                              FieldByName('TMP_ESP_PD').AsString,
                              FieldByName('TMP_EMP_PD').AsString);

          If stlPedidos.IndexOf(strPedido) = -1 Then
            stlPedidos.Add(strPedido);
        End;
      End;
    End;

    If stlPedidos.Count = 0 Then
      Exit(False);

    fltValDebRes := fltValRecAdt;

    For strPedido In stlPedidos Do
    Begin
      If fFormataFloat(fltValDebRes, 2) = 0.00 Then
        Break;

      If Not Result Then
        Break;

      strNumPed := Copy(strPedido, 1, fTamDocCadRec());
      strEspPed := Copy(strPedido, fTamDocCadRec() + 1, 2);
      strEmpPed := Copy(strPedido, fTamDocCadRec() + 3, 3);

      If fEmptyStr(strPedAdt) Then
        strPedAdt := 'ADIANTAMENTO DE CLIENTE REF. PEDIDO(S) '
      Else
        strPedAdt := strPedAdt + ', ';

      strPedAdt := strPedAdt + strNumPed + '-' + strEspPed + '-' + strEmpPed + fGetDataAdiantamento(strNumPed, strEspPed, strEmpPed);

      strDescri := 'DEBITO REF. EMISSÃO DOCTO: ' +
        Concat(strNumDoc, '-', strEspDoc, '-', strEmpDoc);

      Result := TAdiantamento.fLancarDebitoAdiantamento(
                  strNumPed, strEspPed, strEmpPed, strLoginUsuarioLogado,
                  strDescri, fltValDebRes, intSeqConRcx, totAdiantamento, '', IIF(fEmitindoFaturamentoParaOutraLoja, strEmpLog, ''));

      If Result Then
      Begin
        fltValDebRes := fltValDebRes - totAdiantamento.fltValLan;

        totModalidades.fltValLan := totModalidades.fltValLan + totAdiantamento.fltValLan;
        totModalidades.fltValChP := totModalidades.fltValChP + totAdiantamento.fltValChP;
        totModalidades.fltValChV := totModalidades.fltValChV + totAdiantamento.fltValChV;
        totModalidades.fltValCar := totModalidades.fltValCar + totAdiantamento.fltValCar;
        totModalidades.fltValOrd := totModalidades.fltValOrd + totAdiantamento.fltValOrd;
        totModalidades.fltValFin := totModalidades.fltValFin + totAdiantamento.fltValFin;
        totModalidades.fltValDin := totModalidades.fltValDin + totAdiantamento.fltValDin;
        totModalidades.fltValCre := totModalidades.fltValCre + totAdiantamento.fltValCre;
      End;

    End;

  Finally
    If Assigned(stlPedidos) Then
      FreeAndNil(stlPedidos);
  End;
end;

function TFatVenda.fRetornaEmpresaParaAdiantamentoPedido():String;
  function fUsaEmpresaOriginal():Boolean;
  begin
    Result := False;

    If blnRealizandoAdiantamentoPedidoPeloF11 Then
      Exit(True);

    If (blnEmitirNovoPedidoEntregaCD Or
        blnRetiraExpedicaoEmNovoPedido) And
       (Self.strEmpOri <> VS_strCodEmp) And
       (Not fEmptyStr(Self.strEmpOri))  And
       fCfgSis('ALTLOJ', VarBoolean)    Then
      Exit(True);

  end;
begin
  If fUsaEmpresaOriginal() Then
    Result := Self.strEmpOri
  Else If blnDesmembramentoDePedidosComAdiantamento Then
    Result := Self.strPedEmp
  Else
    Result := Self.strEmpDoc;
end;

function TFatVenda.fLancarAdiantamentoPedido(const totModalidades: TTotaisAdiantamento; blnAdtCliAnt: Boolean; strCtaBai: String = ''; strPorBai: String = ''): Boolean;
  Var
    documento: TDocAdiantamento;
    dadosAdiantamento: TDadosAdiantamento;

    LPortadorAdiantamento: String;
    LPortadorAdiantamentoOrdPagto: String;
begin
  If Not (blnEntregaImediataEmNovoPedido Or
          blnEmitirNovoPedidoEntregaCD Or
          blnRetiraOutraLojaEmNovoPedido Or
          blnRetiraMesmaLojaEmNovoPedido Or
          blnRetiraExpedicaoEmNovoPedido Or
          blnAbastecTransfReqEmNovoPedido Or
          blnRealizandoAdiantamentoPedidoPeloF11 Or
          blnBaixaAdiantamentoAutomatico Or
          blnDesmembramentoDePedidosComAdiantamento) Then
    Exit(True);

  documento.strNumDoc := fTiraCaracEspeciais(Self.strNumDoc);
  documento.strEspDoc := Self.strEspDoc;
  documento.strCodEmp := fRetornaEmpresaParaAdiantamentoPedido();

  documento.strCodCli := Self.strCodCli;
  documento.fltValLan := totModalidades.fltValLan;

  dadosAdiantamento.AddDocumento(documento);

  dadosAdiantamento.strTipLan := 'C';
  dadosAdiantamento.dtaDtaLan := VS_Date;
  dadosAdiantamento.horHorLan := fRetHoraServidor;
  dadosAdiantamento.strOpeLan := strLoginUsuarioLogado;
  dadosAdiantamento.strEmpLan := IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog);//Deve gravar a empresa do resumo de caixa
  dadosAdiantamento.intSeqCon := intSeqConRcx;

  If blnDesmembramentoDePedidosComAdiantamento Then
    dadosAdiantamento.strDescri := 'CREDITO DESMEMBRAMENTO DE PEDIDO COM ADIANTAMENTO ' + strNumOrc + '-' + strEspOrc

  Else If blnAdtCliAnt Then
    dadosAdiantamento.strDescri := 'CREDITO ADIANTAMENTO PEDIDO ' + strNumOrc + '-' + strEspOrc

  Else If blnRealizandoAdiantamentoPedidoPeloF11 Or blnBaixaAdiantamentoAutomatico Then
    dadosAdiantamento.strDescri := 'CREDITO ADIANTAMENTO PEDIDO ' + strNumOrc + '-' + strEspOrc

  Else If blnEmitirNovoPedidoEntregaCD Then
    dadosAdiantamento.strDescri := 'CREDITO EMISSAO DE PEDIDO A SER FATURADO PELA LOJA ' + strEmp_CD

  Else If blnRetiraOutraLojaEmNovoPedido Then
    dadosAdiantamento.strDescri := 'CREDITO FATURAMENTO EM PEDIDO RETIRA OUTRA LOJA'

  Else If blnRetiraExpedicaoEmNovoPedido Then
    dadosAdiantamento.strDescri := 'CREDITO FATURAMENTO EM PEDIDO RETIRA EXPEDIÇÃO'

  Else If blnEntregaImediataEmNovoPedido Then
    dadosAdiantamento.strDescri := 'CREDITO FATURAMENTO EM PEDIDO ENTREGA IMEDIATA'

  Else If blnRetiraMesmaLojaEmNovoPedido then
    dadosAdiantamento.strDescri := 'CREDITO FATURAMENTO EM PEDIDO RETIRA MESMA LOJA'

  Else if blnAbastecTransfReqEmNovoPedido then
    dadosAdiantamento.strDescri := 'CREDITO FATURAMENTO EM PEDIDO ABASTECIMENTO TRANSFERÊNCIA/REQUISIÇÃO';

  If (Not fEmptyStr(strPorBai)) Then
  Begin
    LPortadorAdiantamento := strPorBai;
    LPortadorAdiantamentoOrdPagto := strPorBai;
  End
  Else
  Begin
    LPortadorAdiantamento := RetornaPortadorAdiantamentoF11(strCodPor, totModalidades, False);
    LPortadorAdiantamentoOrdPagto := RetornaPortadorAdiantamentoF11(strCodPor, totModalidades, True);
  End;

  dadosAdiantamento.fltValDin := totModalidades.fltValDin;
  dadosAdiantamento.fltValChV := totModalidades.fltValChV;
  dadosAdiantamento.fltValChP := totModalidades.fltValChP;
  dadosAdiantamento.fltValCar := totModalidades.fltValCar;
  dadosAdiantamento.fltValOrd := totModalidades.fltValOrd;
  dadosAdiantamento.fltValFin := totModalidades.fltValFin;
  dadosAdiantamento.fltValCre := totModalidades.fltValCre;
  dadosAdiantamento.fltValLan := totModalidades.fltValLan;
  dadosAdiantamento.strCodPor := LPortadorAdiantamento;
  dadosAdiantamento.strCodPorOrdPagto := LPortadorAdiantamentoOrdPagto;
  dadosAdiantamento.strCodCta := strCtaBai;

  If fFormataFloat(dadosAdiantamento.fltValLan, 2) = 0.00 Then
    Exit(True);

  if Self.blnResCaiAdt then
    dadosAdiantamento.strOrigem := 'RCX';

  dadosAdiantamento.RecebidoPorPix := IIF(RecebidoPorPixOuPixAvulso(VS_Date).Equals('S'), True, False);

  Result := TAdiantamentoGenerico.fGravaAdiantamentoCliente(dadosAdiantamento);

  Result := Result And TAdiantamentoGenerico.fLiberaPedidoRetiraExpedicaoImpressaoSeparacaoMedianteAdiantamento(dadosAdiantamento);
end;

function TFatVenda.fGerarCreditoSaldoAdiantamento(pedidos: TDocumentos; strHisAdc: String = ''): Boolean;
  Var
    pedido: untFuncFatTypes.TDocumento;

  function fPedidoFaturado(strNumDoc, strEspDoc, strEmpDoc: String): Boolean;
  begin
    Result := fCampoTabela('FGO_JAFATU', 'FATGOR',
                          ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'],
                          [strNumDoc, strEspDoc, strEmpDoc]) = 1;
  end;

begin
  Result := True;

  For pedido In pedidos Do
  Begin
    If Not Result Then
      Break;

    If (fGerandoFFOuNFNaDeNotaEspecialPorValorComCadRecSeparado) Then
      Break;

    If (Pos(Self.strOpcDoc, 'VN_CP_') <= 0) Then
      Break;

    If (Pos(Self.strEspDoc, 'OR_PD_') > 0) And (Self.strOriF11 <> 'S') Then
      Break;

    If (fCfgSis('TPNFCR') = SECOL) Then
    Begin
      If (Length(arrMatItens) > 0) And (fEhItemSimplesRemessaConcreto(arrMatItens[0])) Then
        Break;
    End;

    If Not fPedidoFaturado(pedido.strNumDoc, pedido.strEspDoc, pedido.strCodEmp) Then
      Continue;

    {********************************************************************************}
    {* SE O PEDIDO POSSUIR CREDITO DE ADIANTAMENTOS DEVE BAIXAR ESTA SALDO E LANCAR *}
    {* NO CONTAS A RECEBER DO CLIENTE ATRAVES DE DOCUMENTO DE CREDITO "CC"          *}
    {*****************************************************************************JC*}
    If (TAdiantamento.fGetTotaisAdiantamento(pedido.strNumDoc,
                                             pedido.strEspDoc,
                                             pedido.strCodEmp).fltValLan > 0.00) Then
    Begin
      Result := TAdiantamento.fGerarCreditoSaldoAdiantamento(pedido.strNumDoc,
                                                             pedido.strEspDoc,
                                                             pedido.strCodEmp,
                                                             strNomeForm,
                                                             strLoginUsuarioLogado,
                                                             False,
                                                             '',
                                                             0,
                                                             Self.intSeqConRcxExterno,
                                                             strHisAdc);
    End;

  End;
end;

function TFatVenda.fExibirCentroDeCustoNoFaturamento: Boolean;
begin
  Result := ((fCfgSis('CTAFAT', varBoolean)) And (Pos(Self.strClaFis, VS_strClaVen + IIF(Not fEmptyStr(fCfgSis('CTRCDV')), VS_strClaDev, '')) > 0));
end;

procedure TFatVenda.pSetarCentroCustoFaturamento;
begin
  If ((Self.blnExpedi) Or (Self.strOriF11 = 'S')) And
     (fEmptyStr(Self.strCodCta)) And
     (Not fEmptyStr(Self.strCodFpg)) And
     (fExibirCentroDeCustoNoFaturamento) Then
  Begin
    Self.strCodCta := fRetCCustoFpg(Self.strCodFpg);
  End;
end;

class function TFatVenda.fTravarVendaClientePessoaFisica(strCodCli: String; strTipDoc: String = ''): Boolean;
begin
  Result := ((Not fEmptyStr(strCodCli)) And (fCfgSis('TRVEPF', varBoolean))) And
            ((strTipDoc = '2') Or (fClientePessoaFisica(strCodCli) And (Not fClienteConsumidor(fRetNomCliente(strCodCli), True, True))));

  If Result Then
    fMensagem('AVISO', 'Não é permitido realizar operações de vendas para pessoas físicas!'+#10#13+
                       'Configuração: "CFG_TRVEPF - Travar vendas e orçamentos para clientes pessoa física?"', ['&Ok']);
end;

class function TFatVenda.fTravaDocumentoBonificado(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryDocume: TUniQuery;
    strMotivos : String;
    strItens : String;
begin
  Result := False;
  strMotivos := '';
  strItens := '';

  If (Pos(strEspDoc, 'OR_PD_') <= 0) Then
    Exit;

  qryDocume := fCriaQuery(Nil);

  Try
    With qryDocume Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT G.FGO_TIPOPE, D.FDO_CODITE, D.FDO_DESCRI, I.ITE_USABON ');
      SQL.Add('   FROM FATDOR D ');
      SQL.Add('  INNER JOIN FATGOR G ON D.FDO_SEQGER = G.AUTOINCREM ');
      SQL.Add('  INNER JOIN CADITE I ON D.FDO_CODITE = I.ITE_CODITE ');
      SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC ');
      SQL.Add('    AND FDO_ESPDOC = :ESPDOC ');
      SQL.Add('    AND FDO_CODEMP = :CODEMP ');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      If (IsEmpty) Or (FieldByName('FGO_TIPOPE').AsString <> 'B') Then
        Exit;

      If (strEspDoc = 'PD') And (fCfgSis('BONPED') = 'N') And (Not fGetPedidoProvenienteDePromocaoBrinde(strNumDoc, strEspDoc, strCodEmp)) Then
        strMotivos := strMotivos + '- Configuração "CFG_BONPED" configurada para não permitir fazer bonificação na digitação do pedido.' + Chr(13);

      First;
      While Not Eof Do
      Begin
        If (FieldByName('ITE_USABON').AsString = 'N') Then
          strItens := strItens + FieldByName('FDO_CODITE').AsString + ' - ' + FieldByName('FDO_DESCRI').AsString + Chr(13);
        Next;
      End;

      If (Not fEmptyStr(strItens)) Then
      Begin
        If Not fEmptyStr(strMotivos) Then
          strMotivos := strMotivos + Chr(13);

        strMotivos := strMotivos + '- Itens que não podem ser utilizados em bonificação: ' + Chr(13);
        strMotivos := strMotivos + strItens + Chr(13);
        strMotivos := strMotivos + '(Verificar aba "Complementos" no cadastro de produtos)';
      End;

      If (Not fEmptyStr(strMotivos)) Then
      Begin
        Result := True;

        Try
          pCriarFormularios(TfrmObservacao, frmObservacao);
          frmObservacao.lblMensagem.Caption := 'Documento '  + strNumDoc + '-' + strEspDoc + '-' + strCodEmp + ' com restrições: ';
          frmObservacao.memObs.Texto := strMotivos;
          frmObservacao.memObs.SelStart := 0;
          frmObservacao.ShowModal;
        Except
          On E: Exception Do
            pMensagensErro(E.Message, '[TFatVenda.fTravaDocumentoBonificado]');
        End;
        pFreeAndNil(frmObservacao);
      End;

    End;
  Finally
    FreeAndNil(qryDocume);
  End;
end;

class function TFatVenda.fTravaOrcVenc(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  objLiberacao : TLiberacao;
  blnContinua,
  blnVencido  : Boolean;
  qryOrc      : TUniQuery;
begin

  blnContinua := False;

  qryOrc := fCriaQuery;

  try

    if (strNumDoc <> '') and (strEspDoc <> '') and (strCodEmp <> '') then
    begin

      qryOrc.Close;
      qryOrc.SQL.Clear;
      qryOrc.SQL.Add('SELECT');
      qryOrc.SQL.Add('  FATGOR.FGO_NUMDOC,');
      qryOrc.SQL.Add('  FATGOR.FGO_ESPDOC,');
      qryOrc.SQL.Add('  FATGOR.FGO_CODEMP,');
      qryOrc.SQL.Add('  FATGOR.FGO_CODCLI,');
      qryOrc.SQL.Add('  CADCLI.CLI_NOMCLI,');
      qryOrc.SQL.Add('  FATGOR.FGO_CODVEN,');
      qryOrc.SQL.Add('  CADOPE.OPE_NOMOPE,');
      qryOrc.SQL.Add('  FATGOR.FGO_NUMDOC,');
      qryOrc.SQL.Add('  FATGOR.FGO_DTAENT,');
      qryOrc.SQL.Add('  FATGOR.FGO_CONPAG,');
      qryOrc.SQL.Add('  FATGOR.FGO_CODCND,');
      qryOrc.SQL.Add('  FATGOR.FGO_CODFPG,');
      qryOrc.SQL.Add('  FATGOR.FGO_VLRCON,');
      qryOrc.SQL.Add('  EXTGOR.FGO_VALORC ');
      qryOrc.SQL.Add('FROM');
      qryOrc.SQL.Add('  FATGOR');
      qryOrc.SQL.Add('  INNER JOIN EXTGOR ON (EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM)');
      qryOrc.SQL.Add('  INNER JOIN CADCLI ON (CADCLI.CLI_CODCLI = FATGOR.FGO_CODCLI)');
      qryOrc.SQL.Add('  INNER JOIN CADOPE ON (CADOPE.OPE_CODOPE = FATGOR.FGO_CODVEN)');
      qryOrc.SQL.Add('WHERE');
      qryOrc.SQL.Add('  FATGOR.FGO_NUMDOC = :NUMDOC AND');
      qryOrc.SQL.Add('  FATGOR.FGO_ESPDOC = :ESPDOC AND');
      qryOrc.SQL.Add('  FATGOR.FGO_CODEMP = :CODEMP');

      qryOrc.ParamByName('NUMDOC').AsString := strNumDoc;
      qryOrc.ParamByName('ESPDOC').AsString := strEspDoc;
      qryOrc.ParamByName('CODEMP').AsString := strCodEmp;
      qryOrc.Open;

      If Not qryOrc.IsEmpty Then
      Begin
        If fCfgSis('IFVLOR', varBoolean) Then
          blnVencido := qryOrc.FieldByName('FGO_VALORC').AsDateTime < untFuncoesSimples.VS_Date
        Else
          blnVencido := (qryOrc.FieldByName('FGO_DTAENT').AsDateTime + fCfgSis('ORCVEN', varInteger)) < untFuncoesSimples.VS_Date;

        {Verifica se orçamento esta vencido}
        if blnVencido then
        begin
          objLiberacao := TLiberacao.Create;
          try
            objLiberacao.objMsgLibera.pAddSeparador(80);
            objLiberacao.objMsgLibera.pAddTexto(' ORÇAMENTO FORA DO PRAZO DE VALIDADE');
            objLiberacao.objMsgLibera.pAddSeparador(80);
            objLiberacao.objMsgLibera.pAddTextoCaption('Documento'     , qryOrc.FieldByName('FGO_NUMDOC').AsString + '-' +
                                                                         qryOrc.FieldByName('FGO_ESPDOC').AsString + '-' +
                                                                         qryOrc.FieldByName('FGO_CODEMP').AsString, 14);

            objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'       , qryOrc.FieldByName('FGO_CODCLI').AsString + '-' +
                                                                         qryOrc.FieldByName('CLI_NOMCLI').AsString, 14);

            objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor'      , qryOrc.FieldByName('FGO_CODVEN').AsString + '-' +
                                                                         qryOrc.FieldByName('OPE_NOMOPE').AsString, 14);

            objLiberacao.objMsgLibera.pAddTextoCaption('Dt. Emissão'   , qryOrc.FieldByName('FGO_DTAENT').AsString, 14);

            If fCfgSis('IFVLOR', varBoolean) Then
              objLiberacao.objMsgLibera.pAddTextoCaption('Dt. Validade', qryOrc.FieldByName('FGO_VALORC').AsString)
            Else
              objLiberacao.objMsgLibera.pAddTextoCaption('Dt. Validade', DateToStr(qryOrc.FieldByName('FGO_DTAENT').AsDateTime + fCfgSis('ORCVEN', varInteger)), 14);

            if fCfgSis('USACND', varBoolean) then
            begin
              objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto' ,   qryOrc.FieldByName('FGO_CODCND').AsString + '-' +
                                                                           fRetDesConPag(qryOrc.FieldByName('FGO_CODCND').AsString), 14);
              objLiberacao.objMsgLibera.pAddTextoCaption('              ', '(' + qryOrc.FieldByName('FGO_CODCND').AsString + ')' + fFormataCondPag(qryOrc.FieldByName('FGO_CONPAG').AsString), 14);
            end
            else
            begin
              objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto'   , '(' + qryOrc.FieldByName('FGO_CODCND').AsString + ')' + fFormataCondPag(qryOrc.FieldByName('FGO_CONPAG').AsString), 14);
            end;

            If fCfgSis('USAFPG', varBoolean) Then
              objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pagto'   , qryOrc.FieldByName('FGO_CODFPG').AsString + '-' + fRetDesForPag(qryOrc.FieldByName('FGO_CODFPG').AsString), 14);

            objLiberacao.objMsgLibera.pAddTextoCaption('Vr. Documento'   , 'R$ ' + FormatFloat('###,#0.00', qryOrc.FieldByName('FGO_VLRCON').AsFloat), 14);
            objLiberacao.objMsgLibera.pAddSeparador(80);

            {Solicita senha para edição}
            objLiberacao.strDirAce := 'ORCVBL';
            objLiberacao.strCodOpe := strLoginUsuarioLogado;
            objLiberacao.blnSempreVariavelUsuario := True;
            blnContinua := objLiberacao.fLibera;
          finally
            FreeAndNil(objLiberacao);
          end;
        end
        else
          blnContinua := True; {Não esta vencido!}

      end;

    end;

  finally
    FreeAndNil(qryOrc);
  end;

  Result := blnContinua;

end;

function TFatVenda.fExistemProdutosQuantidadeZerada: Boolean;
  Var
    intContador: Integer;
    strMsg: String;
    intQtdLinha: Integer;
begin
  Result := False;
  intQtdLinha := 0;
  strMsg := '';
  For intContador := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
  Begin
    If (Self.arrMatItens[intContador].fltQtdIte = 0) Then
    Begin
      Inc(intQtdLinha);
      strMsg := strMsg + #13#10 + Self.arrMatItens[intContador].strCodIte;
    End;
  End;

  If Not fEmptyStr(strMsg) Then
  Begin
    Result := True;
    fMensagem('Problema na expedição!', 'A quantidade dos itens a seguir estão zeradas.'+#10#13+
                                        'Feche essa tela e refaça o processo de expedição. Entre em contado com a Citel '+
                                        'se possível, informando os passos anteriores.' + #13#10 + strMsg, ['&Ok'],
                                        1, False, 1, 0, False, 0, False, False, False, 0, 0, intQtdLinha);
  End;
end;

function TFatVenda.fTemProdutosComboVigenciaVencida: Boolean;
Var
  intContador : integer;
  intSeqComAnt: Integer;
  strCodIteAti: String;
  strTabPreAti: String;
  strCodEmpAti: String;
  fltQtdIteAti: Double;
  objLiberacao : TLiberacao;
  objTabela : TRegistroMsgLiberaTabela;
  objLinha :  TLinhaMsgLibera;

  procedure pRetDadosProdutoAtivacaoCombo(intSeqCom: Integer);
  Var
    intCont: Integer;
  Begin
    For intCont := 0 To Length(arrMatItens) - 1 Do
    Begin
      If (arrMatItens[intCont].intSeqCom = intSeqCom) And (arrMatItens[intCont].strAtivac = 'S') Then
      Begin
        strCodIteAti := arrMatItens[intCont].strCodIte;
        strTabPreAti := arrMatItens[intCont].strTabPre;
        strCodEmpAti := arrMatItens[intCont].strEmpIte;
        fltQtdIteAti := arrMatItens[intCont].fltQtdIte;
        Break;
      End;
    End;
  End;
begin

  Result := False;

  If (Pos(strOpcDoc, 'OR_PD_VN_CP_') <= 0) Then
    Exit;

  objLiberacao := TLiberacao.Create;
  objTabela := TRegistroMsgLiberaTabela.Create;
  try
    Try
      intSeqComAnt := 0;
      strCodIteAti := '';

      For intContador := 0 To Length(arrMatItens) - 1 Do
      Begin
        If (arrMatItens[intContador].intSeqCom > 0) And (arrMatItens[intContador].strAtivac <> 'S') Then
        Begin
          If (intSeqComAnt <> arrMatItens[intContador].intSeqCom) Then
          Begin
            pRetDadosProdutoAtivacaoCombo(arrMatItens[intContador].intSeqCom);
            intSeqComAnt := arrMatItens[intContador].intSeqCom;
          End;

          Self.objComVen.setCodIte(strCodIteAti);
          Self.objComVen.setTabPre(strTabPreAti);

          Self.objComVen.setCodEmp(strCodEmpAti);

          If (blnEnt_CD) Then
            Self.objComVen.setCodEmp(strEmp_CD);

          Self.objComVen.setQtdIte(fltQtdIteAti);
          Self.objComVen.setIteCom(arrMatItens[intContador].strCodIte);

          If (Not Self.objComVen.fTemComboVigenteParaOProdutoComboOuSimilar) Then
          Begin
            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.pAddColuna('COD.'        , arrMatItens[intContador].strCodIte                                                          , fTamCodIte   );
            objLinha.pAddColuna('DESCRICAO.'  , arrMatItens[intContador].strDesIte                                                          , 37           );
            objLinha.pAddColuna('UN.'         , arrMatItens[intContador].strUnidad                                                          , 2            );
            objLinha.pAddColuna('QUANTIDADE.' , FloatToStrF(arrMatItens[intContador].fltQtdIte, ffFixed, 12, fCfgSis('DECQTD', varInteger)) , 10, alDireita);
            objLinha.pAddColuna('SITUAÇÃO.'   , IfThen(arrMatItens[intContador].strBrinde = 'S', 'BRINDE', 'PROMOCIONAL')                   , 11           );

            objTabela.lstLinhas.Add(objLinha);
          End;
        End;
      End;

      If objTabela.isEmpty Then
        FreeAndNil(objTabela)
      else
      Begin
        objLiberacao.objMsgLibera.pAddSeparador(76, teAutcom);
        objLiberacao.objMsgLibera.pAddTexto('LIBERAÇÃO DE PRODUTOS EM COMBO DE VENDA NÃO VIGÊNTE',alCentro, teAmbos, '', 76);
        objLinha := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlCabecalho;
        objLinha.pAddColuna('', 'COD.'        , fTamCodIte , alEsquerda, teAutcom);
        objLinha.pAddColuna('', 'DESCRICAO.'  , 37, alEsquerda, teAutcom);
        objLinha.pAddColuna('', 'UN.'         , 2 , alEsquerda, teAutcom);
        objLinha.pAddColuna('', 'QUANTIDADE.' , 10, alDireita , teAutcom);
        objLinha.pAddColuna('', 'SITUAÇÃO.'   , 11, alEsquerda, teAutcom);

        objTabela.lstLinhas.Insert(0, objLinha);

        objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

        objLiberacao.strDirAce := 'LIBCOM';
        objLiberacao.strSenLib := fCfgSis('LIBCOM');
        objLiberacao.strMsgSen := 'Produtos em Combo não Vigentes';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;

        If (Not fFatMensagemLiberacao(objLiberacao)) Then
          Result := True;
      End;

    Except
      On E: Exception Do
        pMensagensErro(e.Message, '[TFatVenda.fTemProdutosComboVigenciaVencida]');
    End;
  finally
    FreeAndNil(objLiberacao);
  end;
end;

