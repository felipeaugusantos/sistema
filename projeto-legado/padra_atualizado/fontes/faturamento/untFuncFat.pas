          Else If (Assigned(cdsCadIte.FindField('ITE_PRETAB'))) then
            fltPrecoTabelaProduto := cdsCadIte.FieldByName('ITE_PRETAB').AsFloat
          Else  
            fltPrecoTabelaProduto := fRetPrecoVenda(strCodIte, strTabPreIteLocal, fGetEmpCalculoItem(strEmpresaItem));

          {Mostra valor da tabela na msg de trava}
          If (strPromocIte = 'S') And (Not fTravarPeloPrecoPromocao('', tapcdePromocaoCorrente)) And (fCfgSis('TRAPRP') = '1') Then
          Begin
