                                   0.0,
                                   'V',
                                   arrMatItens[intIndIte].strNumLot,
                                   arrMatItens[intIndIte].fltTaxJur,
                                   arrMatItens[intIndIte].strLotAba);

            If (Not Result) Then
              Break;
          End;
        End;
      End;

      If Result And (fCfgSis('TIPSAB') = 'A') Then //TIPO DE ABASTECIMENTO = AUTOMATICO
      Begin
        stlAutoConEnt.Add( Application.ExeName + ' AUTOCONENT ' +
                           strLoginUsuarioLogado + ' ' +
                           strEmpFor + ' ' +
                           VS_strCodEmp );
      End;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fGEntGerLoja]');
      End;
    End;
  Finally
    SetLength(arrMatItens, 0);
    SetLength(arrMatItens, Length(arrMatItensBkp));
    For intContIte := Low(arrMatItensBkp) To High(arrMatItensBkp) Do
      arrMatItens[intContIte] := arrMatItensBkp[intContIte];
  End;

end;

function TFatVenda.fSolicitacaoTransferenciaMultiLoja: Boolean;
