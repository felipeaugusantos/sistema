class procedure TFatVenda.pAtualizacaoCotacaoDolar(ANumDoc, AEspDoc, AEmpDoc: String);
const
  MSG_ATUALIZAR_PRECO_VENDA =
    'Existem produtos com preço em dólar negociado anteriormente '+
    'e existe uma nova cotação atualizada. '+
    'Deseja atualizar o preço de venda dos produtos mantendo '+
    'o preço em dólar negociado?';
var
  LAlteraPedido: TAlterarPedido;
begin
  If Pos(AEspDoc, 'OR_PD_') <= 0 Then
    Exit;

  If Not fCfgSis('COTDOR', VarBoolean) Then
    Exit;

  If Not fCfgSis('RPVDOL', VarBoolean) Then
    Exit;

  If fRetornaInformacaoVenda(ANumDoc, AEspDoc, AEmpDoc, 'JAFATU').Equals('1') Then
    Exit;

  If Not fTemProdutosComCotacaoEmDolar(ANumDoc, AEspDoc, AEmpDoc) Then
    Exit;

  If Not fExisteNovaCotacaoDolarVenda(ANumDoc, AEspDoc, AEmpDoc) Then
    Exit;

  If Not fPergunta(MSG_ATUALIZAR_PRECO_VENDA) Then
    Exit;

  If Not fVerificaAcessoSistema('frmFatVendas - ' + AEspDoc) Then
  Begin
    If AEspDoc = 'PD' Then
      fMensagem('', 'Usuário não possui permissão de acesso para o módulo de pedidos!', ['&Ok'])
    Else
      fMensagem('', 'Usuário não possui permissão de acesso para o módulo de orçamentos!', ['&Ok']);
    Exit;
  End;

  LAlteraPedido := TAlterarPedido.Create(nil);
  Try
    If Not fValidaUtilizarPedido(ANumDoc, AEspDoc, AEmpDoc, AEspDoc, LAlteraPedido.qryFatGor) Then
      Exit;

    LAlteraPedido.strNumPed := ANumDoc;
    LAlteraPedido.strEspPed := AEspDoc;
    LAlteraPedido.strEmpPed := AEmpDoc;

    LAlteraPedido.blnRecalcularSomentePrecosComCotacaoDolar := True;
    LAlteraPedido.blnRecalculaPrecos := True;

    If Not LAlteraPedido.fCarregarPedido Then
      Exit;

    LAlteraPedido.objVenda.blnValidarDadosNotaEletronica := False;
    LAlteraPedido.objVenda.pAtualizarCotacaoDolarVenda;

    If Not LAlteraPedido.fCalculaTotalPedido Then
      Exit;

    If Not LAlteraPedido.fGravarPedido Then
      Exit;

    pMensagemOk('Documento atualizado com sucesso!');
  Finally
    pLiberaBloqueioPedido(LAlteraPedido.qryFatGor);
    FreeAndNil(LAlteraPedido);
  End;
end;

procedure TFatVenda.pAtribuiCamposUso(Var cpuCampos: TCamposUso; Var qryCadEmp : TUniQuery; cdsItens: TUniClientDataSet = nil);
begin
  If Not Assigned(cdsItens) Then
    cdsItens := cdsVenda;

  If cpuCampos = Nil Then
  Begin
    cpuCampos := TCamposUso.Create;
  End
  Else
  Begin
    cpuCampos.LimparCampos;
  End;

  cpuCampos.AdicionaCampos(cdsItens, 'ITENS');
  {*******************************************}
  {* QUERY ABERTA NA IMPRESSÃO DA NOTA       *}
  {****************************************MV*}
  cpuCampos.AdicionaCampos(qryCadEmp, 'CADEMP');
end;

procedure TFatVenda.pFinalizaCamposUso(Var cpuCampos: TCamposUso);
begin
  If cpuCampos <> Nil Then
    FreeAndNil(cpuCampos);
end;

procedure TFatVenda.pGeraEntradaTransfEstoque(strDocOri, strEspOri, strEmpOri,
  strSerOri, strCodForTe: String; blnPedidoCompra: Boolean);
var intQtd: integer;
begin
  Try
    pCriarFormularios(TfrmRecTransfEstoque, frmRecTransfEstoque);
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.blnAutEnt := True;
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.strDocOri := strDocOri;
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.strEspOri := strEspOri;
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.strEmpOri := strEmpOri;
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.strSerOri := strSerOri;
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.strCodForTe := strCodForTe;
    frmRecTransfEstoque.objEntradaSimplificada.recAutEntTe.blnPedidoCompra := blnPedidoCompra;
    intQtd := 0;
    While Not frmRecTransfEstoque.blnEntradaOk do
    Begin
      frmRecTransfEstoque.ShowModal;

      If Not fEmptyStr(frmRecTransfEstoque.strMensagem) Then
        Raise Exception.Create(frmRecTransfEstoque.strMensagem);

      inc(intQtd);
      If intQtd = 3 then
         Exit;
      If not frmRecTransfEstoque.blnEntradaOk Then
        Sleep(120000);
    End;
  Except
    On E: Exception Do
    Begin
      If Not blnPedidoCompra Then
      Begin
        pFreeAndNil(frmRecTransfEstoque);
        Raise Exception.Create(E.Message);
      End
      Else
        pMensagensErro(E.Message, '[pGeraEntradaTransfEstoque]');
    End;
  End;
  pFreeAndNil(frmRecTransfEstoque);
end;

