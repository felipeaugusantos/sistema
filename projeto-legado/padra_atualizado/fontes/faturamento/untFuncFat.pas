procedure TFatVenda.pPreencheReferenciaRemessa(strAutIncRemessa: String);
  Var
    qryDados: TUniQuery;
    strAutInc: String;
    strNotas: String;
begin
  If fEmptyStr(strAutIncRemessa) Then
    Exit;

  If Not Pos(strOpcDoc, 'EM_ET_') > 0 Then
    Exit;

  If Not fCfgSis('REFVFE', varBoolean) Then
    Exit;

  strAutInc := strAutIncRemessa;
  strNotas  := '';

  qryDados := fCriaQuery(Nil);
  Try
    qryDados.Close;
    qryDados.SQL.Clear;
    qryDados.SQL.Add('SELECT CON_SEQGER AS SEQGER FROM MOVCON ');
    qryDados.SQL.Add('WHERE CON_AUTICS IN (' + strAutInc + ')');
    qryDados.Open;

    qryDados.First;
    While Not qryDados.Eof Do
    Begin
      strAutInc := strAutInc + ', ' + fQuotedStr(qryDados.FieldByName('SEQGER').AsString);

      qryDados.Next;
    End;

    qryDados.Close;
    qryDados.SQL.Clear;

    qryDados.SQL.Add('SELECT DISTINCT ');
    qryDados.SQL.Add('  DET_NUMDOC AS NUMDOC, ');
    qryDados.SQL.Add('  DET_ESPDOC AS ESPDOC ');
    qryDados.SQL.Add('FROM                    ');
    qryDados.SQL.Add('  MOVDET                ');
    qryDados.SQL.Add('  INNER JOIN CADEMP ON CADEMP.EMP_CODEMP = MOVDET.DET_CODEMP ');
    qryDados.SQL.Add('  INNER JOIN CADFIS ON CADFIS.FIS_NUMDOC = MOVDET.DET_NUMDOC AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_ESPDOC = MOVDET.DET_ESPDOC AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_SERIE_ = MOVDET.DET_SERIE_ AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_CODEMP = MOVDET.DET_CODEMP AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_FORCLI = IF(CADFIS.FIS_TIP_FC="C", MOVDET.DET_CODCLI, MOVDET.DET_CODFOR) AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_TIP_FC = MOVDET.DET_TIP_FC     ');
    qryDados.SQL.Add('  LEFT JOIN CADECF ON CADFIS.FIS_NUMSER = CADECF.ECF_NUMSER ');
    qryDados.SQL.Add('WHERE                        ');
    qryDados.SQL.Add('  MOVDET.AUTOINCREM IN (' + strAutInc + ')');
    qryDados.SQL.Add(' AND (FIS_NUMCOO IS NOT NULL OR FIS_ACESSO IS NOT NULL) ');
    qryDados.SQL.Add(' UNION ALL ' + AnsiReplaceStr(qryDados.SQL.Text, 'MOVDET', 'NOTDET'));
    qryDados.SQL.Add('ORDER BY                     ');
    qryDados.SQL.Add('  NUMDOC                     ');

    qryDados.Open;

    qryDados.First;
    While Not qryDados.Eof Do
    Begin
      pIncrementaListaStr(qryDados.FieldByName('NUMDOC').AsString + '-' + qryDados.FieldByName('ESPDOC').AsString, strNotas);

      qryDados.Next;
    End;

    If Not fEmptyStr(strNotas) Then
      FNotasReferenciaRemessa := 'REF.REMESSA: ' + strNotas;
  Finally
    FreeAndNil(qryDados);
  End;

  pPreencheReferenciaRemessaSFat(strAutIncRemessa);
end;

procedure TFatVenda.pPreencheReferenciaRemessaSFat(strAutIncRemessa: String);
  Var
    qryDados: TUniQuery;
    strAutInc: String;
    strNotas: String;
    strNotasSer: String;
begin
  If fEmptyStr(strAutIncRemessa) Then
    Exit;

  If Not Pos(strOpcDoc, 'EM_ET_') > 0 Then
    Exit;

  If Not fCfgSis('REFVFE', varBoolean) Then
    Exit;

  strAutInc := strAutIncRemessa;
  strNotas  := '';

  qryDados := fCriaQuery(Nil);
  Try
    qryDados.Close;
    qryDados.SQL.Clear;

    qryDados.SQL.Add('SELECT DISTINCT ');
    qryDados.SQL.Add('  DET_NUMDOC AS NUMDOC, ');
    qryDados.SQL.Add('  DET_ESPDOC AS ESPDOC, ');
    qryDados.SQL.Add('  DET_SERIE_ AS SERIE_  ');
    qryDados.SQL.Add('FROM                    ');
    qryDados.SQL.Add('  MOVDET                ');
    qryDados.SQL.Add('  INNER JOIN CADEMP ON CADEMP.EMP_CODEMP = MOVDET.DET_CODEMP ');
    qryDados.SQL.Add('  INNER JOIN CADFIS ON CADFIS.FIS_NUMDOC = MOVDET.DET_NUMDOC AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_ESPDOC = MOVDET.DET_ESPDOC AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_SERIE_ = MOVDET.DET_SERIE_ AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_CODEMP = MOVDET.DET_CODEMP AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_FORCLI = IF(CADFIS.FIS_TIP_FC="C", MOVDET.DET_CODCLI, MOVDET.DET_CODFOR) AND ');
    qryDados.SQL.Add('                       CADFIS.FIS_TIP_FC = MOVDET.DET_TIP_FC     ');
    qryDados.SQL.Add('  LEFT JOIN CADECF ON CADFIS.FIS_NUMSER = CADECF.ECF_NUMSER ');
    qryDados.SQL.Add('WHERE                        ');
    qryDados.SQL.Add('  MOVDET.AUTOINCREM IN (' + strAutInc + ')');
    qryDados.SQL.Add(' AND (FIS_NUMCOO IS NOT NULL OR FIS_ACESSO IS NOT NULL) ');
    qryDados.SQL.Add(' UNION ALL ' + AnsiReplaceStr(qryDados.SQL.Text, 'MOVDET', 'NOTDET'));
    qryDados.SQL.Add('ORDER BY                     ');
    qryDados.SQL.Add('  NUMDOC                     ');

    qryDados.Open;

    qryDados.First;
    While Not qryDados.Eof Do
    Begin
      pIncrementaListaStr(qryDados.FieldByName('NUMDOC').AsString + '-' + qryDados.FieldByName('ESPDOC').AsString, strNotas);
      pIncrementaListaStr(qryDados.FieldByName('NUMDOC').AsString + '-' + qryDados.FieldByName('SERIE_').AsString, strNotasSer);

      qryDados.Next;
    End;

    If Not fEmptyStr(strNotas) Then
      strNotasReferenciaRemessaSFat := 'REF.REMESSA: ' + strNotas;

    If Not fEmptyStr(strNotasSer) Then
      strNotasReferenciaRemessaSFatSer := 'REF.REMESSA: ' + strNotasSer;

  Finally
    FreeAndNil(qryDados);
  End;
end;

