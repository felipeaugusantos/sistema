function TFatVenda.fPedidoBloqueado: Boolean;
  Const
    TRAVAS_QUE_NAO_BLOQUEIAM = 'VCOMIS_LBSDVN_LBSDOP';
  Var
    intContador: Integer;
begin

  Result := False;

  If blnEntregaImediataEmNovoPedido Or
     blnEmitirNovoPedidoEntregaCD   Or
     blnRetiraOutraLojaEmNovoPedido Or
     blnRetiraMesmaLojaEmNovoPedido Or
     blnRetiraExpedicaoEmNovoPedido Or
     blnAbastecTransfReqEmNovoPedido Then
    Exit;

  If (strEspDoc = 'PD') Or (strOpcDoc = 'PD') Then
  Begin

    If (fCfgSis('LPPDBL') = 'S') And
       (*******************************************************)
       (* FINANCIAMENTO SEMPRE GRAVA BLOQUEADO                *)
       (****************************************************LA*)
       (strCodFpg <> '016') Then
    Begin
      For intContador := Low(arrLogAvi) To High(arrLogAvi) Do
      Begin

        If Pos(arrLogAvi[intContador].strDirAce, TRAVAS_QUE_NAO_BLOQUEIAM) <= 0 Then
        Begin
          Result := True;
          Break;
        End;

      End;

      If (Not Result) Then
      Begin
        If (fCfgSis('LIBVIS') = 'S') And (fStatusCndPag(strConPag) = A_VISTA) Then
        Begin
          {*********************************************}
          {* BLOQUEIA PEDIDOS A VISTA CASO CONFIGURADO *}
          {******************************************RV*}
          Result := True;
        End
        Else If fEnvioPedidoParaLiberarObrigatorio Then
        Begin
          {*********************************************}
          {* FORÇA BLOQUEIO MESMO QUE "CLIENTE BOM"    *}
          {* (PEDIDO QUE NÃO HOUVE NENHUM BLOQUEIO)    *}
          {******************************************VA*}
          Result := True;
        End;
      End;

    End
    Else
    Begin
      Result := True;
    End;

  End;

end;

