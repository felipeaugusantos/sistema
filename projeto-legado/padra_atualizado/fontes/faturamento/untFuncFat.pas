function TFatVenda.fRetornaVrAcrescApaBen(fltValUni, fltPerApa, fltPerBen: Double): Double;
begin
  Result := fltValUni;
  Result := Result * ( 1 + ( (fltPerApa) / 100 ) );
  Result := Result * ( 1 + ( (fltPerBen) / 100 ) );
  Result := fFormataFloat( ( Result - fltValUni ), 04 );
end;

Procedure TFatVenda.pCriaCdsDocGer;
Begin
  cdsDocGer := TUniClientDataSet.Create(Self);

  With cdsDocGer, FieldDefs Do
  Begin
    With AddFieldDef Do Begin Name := 'AUTINC'; DataType := ftAutoInc; Required := False; End;
    With AddFieldDef Do Begin Name := 'NUMDOC'; DataType := ftString;  Required := False; End;
    With AddFieldDef Do Begin Name := 'ESPDOC'; DataType := ftString;  Required := False; End;
    With AddFieldDef Do Begin Name := 'CODEMP'; DataType := ftString;  Required := False; End;
    With AddFieldDef Do Begin Name := 'VLRTOT'; DataType := ftFloat;   Required := False; End;
    With AddFieldDef Do Begin Name := 'SERIE_'; DataType := ftString;  Required := False; End;
    With AddFieldDef Do Begin Name := 'CODCLI'; DataType := ftString;  Required := False; End;

    With AddFieldDef Do Begin Name := 'IMPRIM'; DataType := ftBoolean; Required := False; End;
    With AddFieldDef Do Begin Name := 'QTDVIA'; DataType := ftInteger; Required := False; End;
    With AddFieldDef Do Begin Name := 'IMPPRE'; DataType := ftBoolean; Required := False; End;
    With AddFieldDef Do Begin Name := 'IMPTOT'; DataType := ftBoolean; Required := False; End;
    With AddFieldDef Do Begin Name := 'IMPTRM'; DataType := ftBoolean; Required := False; End;

    With AddFieldDef Do Begin Name := 'IMPSEP'; DataType := ftBoolean; Required := False; End;
    With AddFieldDef Do Begin Name := 'SEPVIA'; DataType := ftInteger; Required := False; End;

    With AddFieldDef Do Begin Name := 'LIBPED'; DataType := ftBoolean; Required := False; End;

    With AddFieldDef Do Begin Name := 'PRDAMO'; DataType := ftBoolean; Required := False; End;

    CreateDataSet;

    LogChanges := False;

    IndexFieldNames := 'CODEMP';

    Open;

    FieldByName('IMPPRE').Visible := False;
    FieldByName('IMPTOT').Visible := False;
    FieldByName('IMPTRM').Visible := False;

    FieldByName('NUMDOC').Alignment := taCenter;
    FieldByName('ESPDOC').Alignment := taCenter;
    FieldByName('CODEMP').Alignment := taCenter;
    FieldByName('SERIE_').Alignment := taCenter;

    TFloatField(FieldByName('VLRTOT')).DisplayFormat := '###,##0.00';
  End;
End;

function TFatVenda.AtualizaValorTotalDoRegistroDoPix: Boolean;
begin
  Result := True;

  If Self.strEspDoc = 'PD' Then
  Begin
    If Self.DadosPixDaVenda.GerarPixDaVenda Then
    Begin
      Self.DadosPixDaVenda.ValorDoPix := Self.fltTotGer;

      If fCfgSis('USABRI', varBoolean, Self.strEmpLog) Then
      Begin
        If Self.fltTotProBri > 0 Then
        Begin
          Self.DadosPixDaVenda.ValorDoPix := fFormataFloat(Self.DadosPixDaVenda.ValorDoPix -
                                                           Self.fltTotProBri, 2);

          If fFormataFloat(Self.DadosPixDaVenda.ValorDoPix, 2) <= 0 Then
          Begin
            fMensagem('ATENÇÃO', 'Não é possível gerar o Pix em Pedidos que possui apenas brindes nos produtos selecionados.' + #13 +
                                 'Escolha outra condição de pagamento.', ['&Ok']);

            Result := False;
            Exit;
          End;
        End;
      End;

      If Self.DadosPixDaVenda.ValorDoPix <= 0 THen
      Begin
        fMensagem('ATENÇÃO', 'Não é possível gerar o Pix em Pedidos com o valor total menor ou igual a zero.', ['&Ok']);

        Result := False;
        Exit;
      End;
    End;
  End;
end;

procedure TFatVenda.pAtualizaDadosFaturamentoAutomatico;
var
  LSQL: String;
  LQuery: TUniQuery;
begin
  If Self.strAutIncFaturadorAutomatico.IsEmpty Then
    Exit;

  If Self.strNumDoc.IsEmpty Then
    Exit;

  If fDocumentoCancelado(Self.strNumDoc, Self.strEspDoc, VS_strCodEmp, Self.strCodCli, Self.strSerFsc) Then
    Exit;

  If fDocumentoInutilizado(Self.strNumDoc, Self.strEspDoc, VS_strCodEmp, Self.strCodCli, Self.strSerFsc) Then
    Exit;

  LQuery := fCriaQuery;
  Try
    Try
      LSQL := '';
      LSQL := LSQL + ' UPDATE ';
      LSQL := LSQL + '   FATAUT ';
      LSQL := LSQL + ' SET ';
      LSQL := LSQL + '   FAT_LOGDTA = :LOGDTA, ';
      LSQL := LSQL + '   FAT_NUMFAT = :NUMFAT, ';
      LSQL := LSQL + '   FAT_TIPFAT = :TIPFAT, ';
      LSQL := LSQL + '   FAT_EMPFAT = :EMPFAT, ';
      LSQL := LSQL + '   FAT_CLIFAT = :CLIFAT, ';
      LSQL := LSQL + '   FAT_SERFAT = :SERFAT, ';
      LSQL := LSQL + '   FAT_SEQGER = :SEQGER  ';
      LSQL := LSQL + ' WHERE AUTOINCREM = :AUTINC ';

      LQuery.SQL.Text := LSQL;

      LQuery.ParamByName('LOGDTA').AsDateTime := fNow();
      LQuery.ParamByName('NUMFAT').AsString := Self.strNumDoc;
      LQuery.ParamByName('TIPFAT').AsString := Self.strEspDoc;
      LQuery.ParamByName('EMPFAT').AsString := VS_strCodEmp;
      LQuery.ParamByName('CLIFAT').AsString := Self.strCodCli;
      LQuery.ParamByName('SERFAT').AsString := Self.strSerFsc;
      LQuery.ParamByName('SEQGER').AsString := Self.strAutInc;
      If LQuery.ParamByName('SEQGER').AsString.IsEmpty Then
        LQuery.ParamByName('SEQGER').Clear;
      LQuery.ParamByName('AUTINC').AsString := Self.strAutIncFaturadorAutomatico;

      LQuery.ExecSQL;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[pAtualizaDadosFaturamentoAutomatico]');
    End;
  Finally
    FreeAndNil(LQuery);
  End;
end;

procedure TFatVenda.pAtualizaValorPixComAdiantamentoAutomatico;
var
  fltValorAdiantamento: Double;
begin
  fltValorAdiantamento := TAdiantamento.fPedeValorAdiantamento(Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, 'RCX');

