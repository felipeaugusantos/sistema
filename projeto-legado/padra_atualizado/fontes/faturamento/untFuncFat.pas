     (( Pos(Self.strOpcDoc, 'OU_OV_') <= 0 ) Or
      ( Pos(Self.strOpcDoc, 'OE_EF_') <= 0 )) Then
    Result := True;

End;

procedure TFatVenda.pAcertaDataGravacaoDataPrevisao(dtaDtaGra, dtaPrevis: TDate);
  Var
