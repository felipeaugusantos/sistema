function TFatVenda.fPossuiBrindeProduto: Boolean;
  Var
    item: TDadosFechamento;
begin
  If (Length(arrMatItens) = 0) Then Begin
    Result := False;
    Exit;
  End;

  Result := False;

  For item In arrMatItens Do
    If (Not fEhItemServico(item.strCodIte)) And (item.strBrinde = 'S') Then
    Begin
      Result := True;
      Break;
    End;
end;

