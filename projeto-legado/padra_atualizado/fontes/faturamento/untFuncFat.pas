procedure TFatVenda.pVinculaFaturamentoContaOrdemNaRemessa;
var
  qryDados            : TUniQuery;
  strGerAutIncRemessa : String;
begin
  If (strTipOpe <> 'C') Or
     (Not fEhDocumentoContaOrdemComRemessa(strNumOrc, strEspOrc)) Then
    Exit;

  qryDados := fCriaQuery;
  Try
    strGerAutIncRemessa := EmptyStr;

    qryDados.SQL.Text := 'SELECT '
                       + '       M.GER_NUMDOC '
                       + '     , M.GER_ESPDOC '
                       + '     , M.GER_CODEMP '
                       + '     , M.AUTOINCREM '
                       + '  FROM EXTGOR X '
                       + ' INNER JOIN FATGOR G ON G.AUTOINCREM = X.FGO_SEQFGO '
                       + ' INNER JOIN MOVGER M ON M.GER_NUMDOC = G.FGO_NUMFAT '
                       + '                    AND M.GER_ESPDOC = G.FGO_TIPFAT '
                       + '                    AND M.GER_CODEMP = G.FGO_EMPFAT '
                       + ' WHERE X.FGO_AUTRCO = (SELECT F.AUTOINCREM FROM FATGOR F '
                       + '                        WHERE F.FGO_NUMDOC = :NUMDOC '
                       + '                          AND F.FGO_ESPDOC = :ESPDOC '
                       + '                          AND F.FGO_CODEMP = :CODEMP) '
                       + '   AND G.FGO_TIPOPE = "R" ';

    qryDados.ParamByName('NUMDOC').AsString := strNumOrc;
    qryDados.ParamByName('ESPDOC').AsString := strEspOrc;
    qryDados.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDados.Open;

    strGerAutIncRemessa := qryDados.FieldByName('AUTOINCREM').AsString;

    If fEmptyStr(strGerAutIncRemessa) Then
      Exit;

    qryDados.Close;
    qryDados.SQL.Text := 'UPDATE AUXMOV '
                       + '   SET AUX_AUTRCO = :AUTINC '
                       + ' WHERE AUX_SEQGER = :AUTINC_REMESSA ';

    qryDados.ParamByName('AUTINC').AsString         := strAutInc;
    qryDados.ParamByName('AUTINC_REMESSA').AsString := strGerAutIncRemessa;
    qryDados.ExecSQL;
  Finally
    FreeAndNil(qryDados);
  End;
end;

