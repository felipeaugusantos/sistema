function TFatVenda.fGravaPedidosTransferencia: Boolean;
  Var
    intIndLoj: Integer;
    intIndIte: Integer;
    intIndice: Integer;
    strCodEmpLj: String;
    arrCodEmp: TArrCodEmpML;
    arrQtdIte: TArrQtdIteML;
    arrLotAba: TArrLotAbaML;
    arrMatItensBkp: Array Of TDadosFechamento;
    intMaxAutInc: integer;
    intTotItens: integer;
Begin
  Result := TRUE;

  If Not Assigned(objSoliTE) Then
    Exit;

  If fRealizaGeracao_TE_RQ_MultiLoja Then
    Exit;

  strCodEmpLj := IIF(blnFinali, strPedEmp, IIF(Not fOrcamentoOutraLojaF11, strPedEmp, IIF(fEmptyStr(strEmpOri), strPedEmp, IIF((strEspDoc <> strEspOrc), strPedEmp, strEmpOri))));

  If fEmptyStr(strCodEmpLj) Then
    strCodEmpLj := VS_strCodEmp;

  Try

    If fPermiteGravarPedidoParaTransferenciaAutomatica Then
    With objSoliTE Do
    Begin
      stlLojas.Clear;

      if (fSolicitacaoTransferenciaMultiLoja) then
      begin
        SetLength(arrMatItensBkp, 0);
        intMaxAutInc := 0;
        For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
        With arrMatItens[intIndIte] Do
        Begin
          if intAutInc > intMaxAutInc then
          begin
            intMaxAutInc := intAutInc;
          end;
          If blnPodAlt Then
          Begin
            pRetornaInfMultiLoja(intAutInc, arrCodEmp, arrQtdIte, arrLotAba);
            if (Length(arrCodEmp) > 0) and (Length(arrQtdIte) > 0) and (Length(arrLotAba) > 0) then
            begin
              strEmpSol := arrCodEmp[0];
              fltQtdSol := arrQtdIte[0];
              strLotAba := arrLotAba[0];
              pTrocaLoteSelPorAbast(arrMatItens[intIndIte]);
              pAdicionaLojas(arrCodEmp[0]);

              for intIndice := 1 to Length(arrCodEmp) - 1 do
              begin
                SetLength(arrMatItensBkp, Length(arrMatItensBkp) + 1);
                arrMatItensBkp[Length(arrMatItensBkp) - 1] := arrMatItens[intIndIte];
                arrMatItensBkp[Length(arrMatItensBkp) - 1].strEmpSol := arrCodEmp[intIndice];
                arrMatItensBkp[Length(arrMatItensBkp) - 1].fltQtdSol := arrQtdIte[intIndice];
                arrMatItensBkp[Length(arrMatItensBkp) - 1].strLotAba := arrLotAba[intIndice];
                pTrocaLoteSelPorAbast(arrMatItensBkp[Length(arrMatItensBkp) - 1]);
                pAdicionaLojas(arrCodEmp[intIndice]);
              end;
            end;
          End;
        End;

        intTotItens := Length(arrMatItens);
        for intIndice := Low(arrMatItensBkp) to High(arrMatItensBkp) do
        begin
          Inc(intMaxAutInc);
          SetLength(arrMatItens, Length(arrMatItens) + 1);
          arrMatItens[intTotItens] := arrMatItensBkp[intIndice];
          arrMatItens[intTotItens].intAutInc := intMaxAutInc;
          Inc(intTotItens);
        end;
        pAplicaFatorMultiLoja(arrMatItens);
      end
      else
      begin
        For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
        With arrMatItens[intIndIte] Do
        Begin
          If blnPodAlt Then
          Begin
            strEmpSol := fGetEmpresa(intAutInc);
            fltQtdSol := fGetQtdSolicitada(intAutInc);
            strLotAba := fGetLote(intAutInc);

            {*********************************************************************************}
            {* SE FOR SOLICITADO O LOTE DA MESMA EMPRESA, O LOTE DE ABASTECIMENTO PASSA      *}
            {* A SER O LOTE DO PRODUTO, POIS HOJE NÃO É GERADO TRANSFERENCIA PARA A MESMA    *}
            {* LOJA, POR ISSO SERÁ CONSIDERADO O LOTE DE ABASTECIMENTO PARA BAIXAR O ESTOQUE *}
            {******************************************************************************FC*}
            pTrocaLoteSelPorAbast(arrMatItens[intIndIte]);
          End;
        End;
      end;

      For intIndLoj := 0 To stlLojas.count - 1 Do
      Begin
        (*************************************************)
        (* SE FOI SOLICITADO A PROPRIA LOJA DESCONSIDERA *)
        (**********************************************LA*)
        If stlLojas[intIndLoj] <> strCodEmpLj Then
        Begin
          Result := fGFatGorLoja(stlLojas[intIndLoj], True, False);

          If (Not Result) Then
          Begin
            Break;
          End
          Else
          Begin
            If (objSolColorantesTE.stlLojas.Find(stlLojas[intIndLoj], intIndice)) Then
              objSolColorantesTE.stlLojas.Delete(intIndice);
          End;
        End;
      End;

      For intIndLoj := 0 To objSolColorantesTE.stlLojas.count - 1 Do
      Begin
        (*************************************************)
        (* SE FOI SOLICITADO A PROPRIA LOJA DESCONSIDERA *)
        (**********************************************LA*)
        If objSolColorantesTE.stlLojas[intIndLoj] <> strCodEmpLj Then
        Begin
          Result := fGFatGorLoja(objSolColorantesTE.stlLojas[intIndLoj], True);

          If (Not Result) Then
            Break;
        End;
      End;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGravaLojasTE]');
    End;
  End;

end;

function TFatVenda.fGravaPortariaCAT(strCodEmp, strCodVen, strTipDoc,
  strNumDoc: string): Boolean;
var
  qryPortariaCat: TUniQuery;
  strSQLSaida1, strSQLSaida2, strSQLEntrada1, strSQLEntrada2: string;
  strSubstituto_Substituido, strEntSai: string;
begin
  try
    Result := False;

    strSQLSaida1 := '';
    strSQLSaida2 := '';
    strSQLEntrada1   := '';
    strSQLEntrada2   := '';

    qryPortariaCat := fCriaQuery(nil);
    qryPortariaCat.Close;
    qryPortariaCat.SQL.Clear;

    if StrToInt(LeftStr(strClaFis, 1)) >= 5 then
    begin
      strEntSai  := 'S';
    end
    else
    begin
      strEntSai  := 'E';
    end;

    if strEntSai = 'S' then
    begin
      if fRegimeSubstituicaoTributaria('', Self.fOpcDocClaSub) = '1' then
      begin
        //Substituído
        strSubstituto_Substituido := fCfgSis('CCATST');
      end
      else
      begin
        //Substituto
        strSubstituto_Substituido := fCfgSis('CCATSS');
      end;

      strSQLSaida1 := strSQLSaida1 + 'SELECT  DET_CLAFIS, ';
      strSQLSaida1 := strSQLSaida1 + 'SUM((CASE ';
      strSQLSaida1 := strSQLSaida1 + '  WHEN SUBSTRING(DET_CODFIS,2,2) = "20" THEN (DET_VLRCON - DET_BASICM) ';
      strSQLSaida1 := strSQLSaida1 + '  ELSE DET_VLRCON ';
      strSQLSaida1 := strSQLSaida1 + 'END)) AS VALOR, ';
      strSQLSaida1 := strSQLSaida1 + 'GROUP_CONCAT("x", SUBSTRING(DET_CODFIS,2,2) SEPARATOR "/") AS CODFIS ';
      strSQLSaida1 := strSQLSaida1 + 'FROM MOVDET ';
      strSQLSaida1 := strSQLSaida1 + 'WHERE DET_CODEMP = :CODEMP ';
      strSQLSaida1 := strSQLSaida1 + 'AND DET_CODVEN = :CODVEN ';
      strSQLSaida1 := strSQLSaida1 + 'AND DET_NUMDOC = :NUMDOC ';
      strSQLSaida1 := strSQLSaida1 + 'AND DET_ESPDOC  = :ESPDOC ';
      strSQLSaida1 := strSQLSaida1 + 'AND SUBSTRING(DET_CODFIS,2,2) IN("20","30","40", "41") ';
      strSQLSaida1 := strSQLSaida1 + 'AND LEFT(DET_CLAFIS,1) >= 5 ';
      strSQLSaida1 := strSQLSaida1 + 'GROUP BY DET_CLAFIS ';
      strSQLSaida1 := strSQLSaida1 + 'ORDER BY DET_CLAFIS, DET_CODFIS ';

      strSQLSaida2 := strSQLSaida2 + 'SELECT  DET_CLAFIS, DET_VLRCON AS VALOR, ';
      strSQLSaida2 := strSQLSaida2 + 'GROUP_CONCAT("x", SUBSTRING(DET_CODFIS,2,2) SEPARATOR "/") AS CODFIS ';
      strSQLSaida2 := strSQLSaida2 + 'FROM MOVDET ';
      strSQLSaida2 := strSQLSaida2 + 'WHERE DET_CODEMP = :CODEMP ';
      strSQLSaida2 := strSQLSaida2 + 'AND DET_CODVEN = :CODVEN ';
      strSQLSaida2 := strSQLSaida2 + 'AND DET_NUMDOC = :NUMDOC ';
      strSQLSaida2 := strSQLSaida2 + 'AND DET_ESPDOC  = :ESPDOC ';
      strSQLSaida2 := strSQLSaida2 + 'AND SUBSTRING(DET_CODFIS,2,2) IN("10","60","70", "90") ';
      strSQLSaida2 := strSQLSaida2 + 'AND LEFT(DET_CLAFIS,1) >= 5 ';
      strSQLSaida2 := strSQLSaida2 + 'GROUP BY DET_CLAFIS ';
      strSQLSaida2 := strSQLSaida2 + 'ORDER BY DET_CLAFIS, DET_CODFIS ';

      qryPortariaCat.SQL.Add(strSQLSaida1);
      qryPortariaCat.ParamByName('CODEMP').AsString  := strCodEmp;
      qryPortariaCat.ParamByName('CODVEN').AsString  := strCodVen;
      qryPortariaCat.ParamByName('NUMDOC').AsString  := strNumDoc;
      qryPortariaCat.ParamByName('ESPDOC').AsString  := strTipDoc;
      qryPortariaCat.Open;

      if not qryPortariaCat.IsEmpty then
      begin
        while not qryPortariaCat.Eof do
        begin
          pGravaFisAju(fCfgSis('CCATSA'), qryPortariaCat.FieldByName('DET_CLAFIS').AsString + ' - ' + qryPortariaCat.FieldByName('CODFIS').AsString, strNumDoc, strTipDoc, 1, qryPortariaCat.FieldByName('VALOR').AsFloat);
          qryPortariaCat.Next;
        end;
      end;

      qryPortariaCat.Close;
      qryPortariaCat.SQL.Clear;
      qryPortariaCat.SQL.Add(strSQLSaida2);
      qryPortariaCat.ParamByName('CODEMP').AsString  := strCodEmp;
      qryPortariaCat.ParamByName('CODVEN').AsString  := strCodVen;
      qryPortariaCat.ParamByName('NUMDOC').AsString  := strNumDoc;
      qryPortariaCat.ParamByName('ESPDOC').AsString  := strTipDoc;
      qryPortariaCat.Open;

      if not qryPortariaCat.IsEmpty then
      begin
        while not qryPortariaCat.Eof do
        begin
          pGravaFisAju(strSubstituto_Substituido, qryPortariaCat.FieldByName('DET_CLAFIS').AsString + ' - ' + qryPortariaCat.FieldByName('CODFIS').AsString, strNumDoc, strTipDoc, 2, qryPortariaCat.FieldByName('VALOR').AsFloat);
          qryPortariaCat.Next;
        end;
      end;
    end
    else if strEntSai  = 'E' then
    begin
      strSQLEntrada1 := strSQLEntrada1 + 'SELECT  DET_CLAFIS, ';
      strSQLEntrada1 := strSQLEntrada1 + 'SUM((CASE ';
      strSQLEntrada1 := strSQLEntrada1 + '  WHEN SUBSTRING(DET_CODFIS,2,2) = "20" THEN (DET_VLRCON - DET_BASICM) ';
      strSQLEntrada1 := strSQLEntrada1 + '  ELSE DET_VLRCON ';
      strSQLEntrada1 := strSQLEntrada1 + 'END)) AS VALOR, ';
      strSQLEntrada1 := strSQLEntrada1 + 'GROUP_CONCAT("x", SUBSTRING(DET_CODFIS,2,2) SEPARATOR "/") AS CODFIS ';
      strSQLEntrada1 := strSQLEntrada1 + 'FROM MOVDET ';
      strSQLEntrada1 := strSQLEntrada1 + 'WHERE DET_CODEMP = :CODEMP ';
      strSQLEntrada1 := strSQLEntrada1 + 'AND DET_CODVEN = :CODVEN ';
      strSQLEntrada1 := strSQLEntrada1 + 'AND DET_NUMDOC = :NUMDOC ';
      strSQLEntrada1 := strSQLEntrada1 + 'AND DET_ESPDOC  = :ESPDOC ';
      strSQLEntrada1 := strSQLEntrada1 + 'AND SUBSTRING(DET_CODFIS,2,2) IN("20","30","40", "41") ';
      strSQLEntrada1 := strSQLEntrada1 + 'AND LEFT(DET_CLAFIS,1) < 5 ';
      strSQLEntrada1 := strSQLEntrada1 + 'GROUP BY DET_CLAFIS ';
      strSQLEntrada1 := strSQLEntrada1 + 'ORDER BY DET_CLAFIS, DET_CODFIS ';

      strSQLEntrada2 := strSQLEntrada2 + 'SELECT  DET_CLAFIS, DET_VLRCON AS VALOR, ';
      strSQLEntrada2 := strSQLEntrada2 + 'GROUP_CONCAT("x", SUBSTRING(DET_CODFIS,2,2) SEPARATOR "/") AS CODFIS ';
      strSQLEntrada2 := strSQLEntrada2 + 'FROM MOVDET ';
      strSQLEntrada2 := strSQLEntrada2 + 'WHERE DET_CODEMP = :CODEMP ';
      strSQLEntrada2 := strSQLEntrada2 + 'AND DET_CODVEN = :CODVEN ';
      strSQLEntrada2 := strSQLEntrada2 + 'AND DET_NUMDOC = :NUMDOC ';
      strSQLEntrada2 := strSQLEntrada2 + 'AND DET_ESPDOC  = :ESPDOC ';
      strSQLEntrada2 := strSQLEntrada2 + 'AND SUBSTRING(DET_CODFIS,2,2) IN("10") ';
      strSQLEntrada2 := strSQLEntrada2 + 'AND LEFT(DET_CLAFIS,1) < 5 ';
      strSQLEntrada2 := strSQLEntrada2 + 'GROUP BY DET_CLAFIS ';
      strSQLEntrada2 := strSQLEntrada2 + 'ORDER BY DET_CLAFIS, DET_CODFIS ';

      qryPortariaCat.SQL.Add(strSQLEntrada1);
      qryPortariaCat.ParamByName('CODEMP').AsString  := strCodEmp;
      qryPortariaCat.ParamByName('CODVEN').AsString  := strCodVen;
      qryPortariaCat.ParamByName('NUMDOC').AsString  := strNumDoc;
      qryPortariaCat.ParamByName('ESPDOC').AsString  := strTipDoc;
      qryPortariaCat.Open;

      if not qryPortariaCat.IsEmpty then
      begin
        while not qryPortariaCat.Eof do
        begin
          pGravaFisAju(fCfgSis('CCATE1'), qryPortariaCat.FieldByName('DET_CLAFIS').AsString + ' - ' + qryPortariaCat.FieldByName('CODFIS').AsString, strNumDoc, strTipDoc, 3, qryPortariaCat.FieldByName('VALOR').AsFloat);
          qryPortariaCat.Next;
        end;
      end;

      qryPortariaCat.Close;
      qryPortariaCat.SQL.Clear;
      qryPortariaCat.SQL.Add(strSQLEntrada2);
      qryPortariaCat.ParamByName('CODEMP').AsString  := strCodEmp;
      qryPortariaCat.ParamByName('CODVEN').AsString  := strCodVen;
      qryPortariaCat.ParamByName('NUMDOC').AsString  := strNumDoc;
      qryPortariaCat.ParamByName('ESPDOC').AsString  := strTipDoc;
      qryPortariaCat.Open;

      if not qryPortariaCat.IsEmpty then
      begin
        while not qryPortariaCat.Eof do
        begin
          pGravaFisAju(fCfgSis('CCATE2'), qryPortariaCat.FieldByName('DET_CLAFIS').AsString + ' - ' + qryPortariaCat.FieldByName('CODFIS').AsString, strNumDoc, strTipDoc, 4, qryPortariaCat.FieldByName('VALOR').AsFloat);
          qryPortariaCat.Next;
        end;
      end;
    end;

    Result := True;
  finally
    FreeAndNil(qryPortariaCat);
  end;
end;

function TFatVenda.fGravaPDTransfEntFutF11: Boolean;
  Var
    intIndIte: Integer;

    fltDesEspLj,
    fltTotProLj,
    fltTotCusLj,
    fltTotMedLj,
    fltPesBruLj,
    fltPesLiqLj,
    fltBasIcmLj,
    fltValIcmLj,
    fltBasRetLj,
    fltValRetLj,
    fltBasIpiLj,
    fltValIpiLj,
    fltTotCbsLj,
    fltTotIbsLj,
    fltTotIsLj,
    fltBasCbsLj,
    fltBasIbsLj,
    fltBasIsLj,
    fltTotGerLj: Double;

    strTipPedLj,
    strCodCliLj,
    strNumDocLj,
    strCodCliAnt: String;

    LArrItensPD: TMatrizFechamento;

    arrDuplicatasBkp: TArrDigDuplicArray;
    item: TDadosFechamento;
    intContador: Integer;
    qryCliFil: TUniQuery;

    blnEntFut: Boolean;

    objOrdenarItensParaGravacao: TOrdenarItensParaGravacao;

  procedure pPrepararItemTransferencia(var AItem: TDadosFechamento);
  begin
    pAtualizaValoresItensTransferencia(AItem);
    AItem.fltDesCon := 0;
    AItem.fltDesEsp := 0;
    AItem.strEntFut := 'N';

    pDefineClassificacaoItem(AItem, fAtendeRegrasDifal(False, AItem.strEmpIte));

    pCalcularPisCofinsItemDerivado(AItem, VS_strCodEmp, strCodCliLj, 'C', True, False);
  end;

begin
  qryCliFil := fCriaQuery(Self);

  blnEntFut := False;
  strEntFut := 'N';

  SetLength(arrDuplicatasBkp, Length(arrDuplicata));
  For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
  Begin
    arrDuplicatasBkp[intContador] := arrDuplicata[intContador];
  End;

  fltDesEspLj := 0;
  fltTotProLj := 0;
  fltTotCusLj := 0;
  fltTotMedLj := 0;
  fltPesBruLj := 0;
  fltPesLiqLj := 0;

  fltBasIcmLj := 0;
  fltValIcmLj := 0;
  fltBasRetLj := 0;
  fltValRetLj := 0;
  fltBasIpiLj := 0;
  fltValIpiLj := 0;
  fltTotCbsLj := 0;
  fltTotIbsLj := 0;
  fltTotIsLj  := 0;
  fltTotGerLj := 0;

  Try
    strCodCliLj := fCadEmp('CLIFIL');
    strNumDocLj := fRetSequencialPedido(VS_strCodEmp);
    stlRequisocoesPD.Add(strNumDocLj);

    Self.strEmp_TE := fCfgSis('EMP_CD');
    strCodCliAnt   := strCodCli;
    strCodCli      := strCodCliLj;
    pCarregaDadosClienteBaixa(strCodCli);
    pAtualizaClassTransferencias;

    qryCliFil.SQL.Add('SELECT * FROM CADCLI JOIN CADCID ON CID_CODCID = CLI_CODCID WHERE CLI_CODCLI = :CODCLI');
    qryCliFil.ParamByName('CODCLI').AsString := strCodCliLj;
    qryCliFil.Open;

    If Pos(strEspDoc, 'NF_IF_IV_D1_') > 0 Then
      strTipPedLj := 'A'
    Else
      strTipPedLj := 'B';

    For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      With arrMatItens[intIndIte] Do
      Begin
        fltDesEspLj := fltDesEspLj + 0;
        fltTotProLj := fltTotProLj + arrMatItens[intIndIte].fltTotCus;
        fltTotCusLj := fltTotCusLj + arrMatItens[intIndIte].fltTotCus;
        fltTotMedLj := fltTotMedLj + arrMatItens[intIndIte].fltTotMed;

        fltBasIcmLj := fltBasIcmLj + arrMatItens[intIndIte].fltBasIcm;
        fltValIcmLj := fltValIcmLj + arrMatItens[intIndIte].fltValIcm;

        fltBasRetLj := fltBasRetLj + arrMatItens[intIndIte].fltBasRet;
        fltValRetLj := fltValRetLj + arrMatItens[intIndIte].fltValRet;

        fltBasIpiLj := fltBasIpiLj + arrMatItens[intIndIte].fltBasIpi;
        fltValIpiLj := fltValIpiLj + arrMatItens[intIndIte].fltValIpi;

        SetLength(LArrItensPD, Length(LArrItensPD) + 1);
        LArrItensPD[High(LArrItensPD)] := arrMatItens[intIndIte];
        pPrepararItemTransferencia(LArrItensPD[High(LArrItensPD)]);

        fltTotGerLj := fltTotProLj + fltValRetLj + fltValIpiLj + fltValFre + fltDesAce;

        fltPesBruLj := fltPesBruLj + fFormataFloat(arrMatItens[intIndIte].fltQtdIte *
                                                   arrMatItens[intIndIte].fltPesoIt, 3);

        fltPesLiqLj := fltPesLiqLj + fFormataFloat(arrMatItens[intIndIte].fltQtdIte *
                                                   arrMatItens[intIndIte].fltPesLiq, 3);
      End;
    End;

    If fCfgSis('PESLIQ') = 'FATOR' Then
      fltPesLiqLj := fFormataFloat(fltPesBruLj * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);

    pCalcularImpostosReformaTributariaItens(LArrItensPD,
                                            'PD',
                                            strTipPedLj,
                                            strCodCliLj,
                                            '',
                                            False,
                                            fltTotCbsLj,
                                            fltTotIbsLj,
                                            fltTotIsLj,
                                            fltBasCbsLj,
                                            fltBasIbsLj,
                                            fltBasIsLj);

    fltTotGerLj := fltTotGerLj + fltTotCbsLj + fltTotIbsLj + fltTotIsLj;

    fDigDuplic(arrDuplicata, strConPag, 0, fltTotGerLj, False, False, False, Self.VS_Date, False);

    If (VS_strHabilitarCRM) And (Not Assigned(objOcoCrm)) And (Not fEmptyStr(fCfgSis('VENORC', varString))) And (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
    Begin
      If blnGravandoPedidoCorteFaltaEstoque Then
        objOcoCrm := fAtualizaInformacoesCRM(strNumDocLj,
                                             'PD',
                                             VS_strCodEmp,
                                             strCodCliLj,
                                             '','',
                                             strCodVen,
                                             afcPedidoCorte,
                                             '',
                                             strCliCgc)
      Else
        objOcoCrm := fAtualizaInformacoesCRM(strNumDocLj,
                                             'PD',
                                             VS_strCodEmp,
                                             strCodCliLj,
                                             '','',
                                             strCodVen,
                                             afcPedido,
                                             '',
                                             strCliCgc);

      objOcoCrm.strInfAdc := strModificacoesItensPedido;
      objOcoCrm.blnImpSfa := blnImpSfa;
      If fDeveGerarOcorrenciaCRMParaProspecto Then
      Begin
        objOcoCrm.strCodPro := strProspe;
        objOcoCrm.strTip_FC := 'P';
      End;
      objOcoCrm.strNomFrm := '[TFatVenda.fGravaPDTransfEntFutF11]';
    End;

    Result := fGFatGor(0,
                       fltDesEspLj,
                       fltTotGerLj,
                       fltTotProLj,
                       fltTotCusLj,
                       fltTotMedLj,
                       fltPesBruLj,
                       fltPesLiqLj,
                       fltBasIcmLj,
                       fltValIcmLj,
                       fltBasRetLj,
                       fltValRetLj,
                       fltBasIpiLj,
                       fltValIpiLj,
                       fltTotCbsLj,
                       fltTotIbsLj,
                       fltTotIsLj,
                       strTipPedLj,
                       strCodCliLj,
                       VS_strCodEmp,
                       'PD',
                       strNumDocLj,
                       '',
                       strEmp_TE,
                       qryCliFil.FieldByName('CLI_NOMCLI').AsString,
                       qryCliFil.FieldByName('CLI_ENDERE').AsString,
                       qryCliFil.FieldByName('CLI_BAIRRO').AsString,
                       qryCliFil.FieldByName('CLI_C_E_P_').AsString,
                       qryCliFil.FieldByName('CLI_CODCID').AsString,
                       qryCliFil.FieldByName('CID_ESTADO').AsString,
                       qryCliFil.FieldByName('CLI_CODATI').AsString,
                       qryCliFil.FieldByName('CLI_FONE01').AsString,
                       qryCliFil.FieldByName('CLI_NASCIM').AsDateTime,
                       qryCliFil.FieldByName('CLI_CGCCPF').AsInteger,
                       qryCliFil.FieldByName('CLI_C_G_C_').AsString,
                       qryCliFil.FieldByName('CLI_I_E_S_').AsString,
                       qryCliFil.FieldByName('CLI_NUMR_G').AsString,
                       fltFatNot,
                       strTipFre,
                       fltValFre,
                       fltDesAce,
                       strMen001,
                       strMen002,
                       'N',
                       '',
                       strNumOrc,
                       strEspOrc,
                       IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri),
                       False,
                       'N',
                       '',
                       strMen003,
                       strMen004,
                       strMen005);

    If Assigned(objOcoCrm) Then
      FreeAndNil(objOcoCrm);

    If (Not Result) Then
      Exit;

    //Retorna o autoincremento dos itens para gravacao da tabela FATDOR
    For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
      arrMatItens[intIndIte].strAutoincrementoGravacao := fRetAutoIncrem('FATDOR', VS_strCodEmp);

    Try
      objOrdenarItensParaGravacao := TOrdenarItensParaGravacao.Create;

      objOrdenarItensParaGravacao.pSalvarOrdemMatrizItens(arrMatItens);
      objOrdenarItensParaGravacao.pOrdenarItensPorCodigo(arrMatItens);

      //Atualiza a matriz de itens ja ordenada por codigo de produto
      For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
        arrMatItens[intIndIte] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intIndIte];

      For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
      Begin
        item := arrMatItens[intIndIte];

        pPrepararItemTransferencia(item);
        pCopiarImpostosReformaTributaria(item, LArrItensPD);

        With arrMatItens[intIndIte] Do
        Begin
          Result := fGravaFatDorItem(item,
                                     VS_strCodEmp,
                                     strCodCliLj,
                                     'PD',
                                     strNumDocLj,
                                     blnEntFut);

          If (Not Result) Then
            Break;
        End;
      End;

    Finally
      //Restaura a ordenacao original dos itens
      objOrdenarItensParaGravacao.pRestaurarOrdemMatrizItens(arrMatItens);

      //Atualiza a matriz de itens com a ordem original de inclusao dos itens
      For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
        arrMatItens[intIndIte] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intIndIte];

      FreeAndNil(objOrdenarItensParaGravacao);
    End;

    {*********************************************}
    {* SE FOR PEDIDO E SE CFG_ENTFUT='S'         *}
    {* AO GERAR O DOCUMENTO, OS ITENS QUE        *}
    {* ESTIVEREM COMO "ENTREGA FUTURA",          *}
    {* DEVERAO SER GRAVADOS COMO "JA EXPEDIDOS"  *}
    {******************************************AC*}
    If Result And blnEntFut Then
      Result := fAtualizaPedidoComoJaExpedido(strAutIncFatGor);
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGravaPDTransfEntFutF11]');
    End;
  End;

  For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
  Begin
    arrDuplicata[intContador] := arrDuplicatasBkp[intContador];
  End;

  strCodCli      := strCodCliAnt;
  Self.strEmp_TE := '';
  pCarregaDadosClienteBaixa(strCodCli);
  pAtualizaClassTransferencias;
end;

function TFatVenda.fGeraPDAbastecimentoCDVendaEntregaFutura: Boolean;
begin
  Result := (fCfgSis('ENTABA', VarBoolean))       And
            (Not fBaixaDeEntregaFuturaApenasComoControleDeEntrega) And
            (fCfgSis('ESPCFO', VarString) = 'PD') And
            (fTemEntregaFutura(arrMatItens))      And
            (SameText(strOpcDocTrue, '11'))       And
            (SameText(strOriF11, 'S'));
end;

procedure TFatVenda.pAtualizaValoresItensTransferencia(Var item: TDadosFechamento);
  Var
    qryIteGer: TUniQuery;
    fltIcmSai: Double;
    parPreCus: TParCalculaPrecoCusto;

    procedure pCriaIteGer;
      Var
        strSQL: String;
    Begin
      strSQL := '';
      strSQL := strSQL + ' SELECT   ';
      strSQL := strSQL + '   *      ';
      strSQL := strSQL + ' FROM     ';
      strSQL := strSQL + '   ITEGER ';
      strSQL := strSQL + ' WHERE    ';
      strSQL := strSQL + '   ITE_CODITE = :CODITE AND ';
      strSQL := strSQL + '   ITE_CODEMP = :CODEMP     ';

      qryIteGer := fCriaQuery(Self);
      qryIteGer.SQL.Clear;
      qryIteGer.SQL.Add(strSQL);
    End;
begin
  pCriaIteGer;

  With qryIteGer Do
  Begin
    qryIteGer.Close;
    qryIteGer.ParamByName('CODITE').AsString := item.strCodIte;
    qryIteGer.ParamByName('CODEMP').AsString := IIF(fEmptyStr(Self.strEmp_TE),VS_strCodEmp,Self.strEmp_TE);
    qryIteGer.Open;
  End;

  item.fltUniOri := fPegaPrecoSugeridoTE(qryIteGer, qryIteGer.ParamByName('CODEMP').AsString, item.strPromoc);
  item.fltUniTar := item.fltUniOri;
  item.fltUniDig := item.fltUniTar;
  item.fltTotIte := item.fltUniTar * item.fltQtdIte;

  parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);

  If (Pos('ITEM ESPECIAL', item.strDesOri) <= 0) And
      Not fEhItemServico(item.strCodIte) Then
  Begin
    {*****************************************************}
    {* Caso configurado: Margem de Lucro do faturamento, *}
    {* calcular com os impostos praticados na Venda      *}
    {**************************************************JC*}
    If fCfgSis('IMPCF4', VarBoolean) Then
      fltIcmSai := item.fltAlqIcm //Icms praticado na venda
    Else
      fltIcmSai := item.fltICMSai;//Icms do cadastro de produto

    {***************************************************************}
    {* Caso for tinta de máquina, o icmsai já está                 *}
    {* preenchido corretamente respeitando a configuração 'IMPCF4' *}
    {************************************************************PH*}
    If (item.strIdePro <> 'NOR') Then
      fltIcmSai := item.fltICMSai;

    item.fltPreCus := item.fltCusIte;
    item.fltPreCu2 := parPreCus.fCalculaPrecoCustoRealVenda(item.fltUniTar - (item.fltDesEsp / item.fltQtdIte),
                                                            item.fltCusIte,
                                                            item.fltOutVal + fSomaComissaoAoOutrosValores(item),
                                                            fltIcmSai,
                                                            item.fltImpFed,
                                                            fProcessarDespesasOperacionaisComplementar(item.fltDesOpe),
                                                            item.recDifalFCP.fltAlDifa,
                                                            IIF((item.fltValRet = 0) and (item.fltBasIcm <> 0), item.recDifalFCP.fltPerFcp, 0));

    item.fltTotCus := item.fltPreCus * item.fltQtdIte;
    item.fltTotCu2 := item.fltPreCu2 * item.fltQtdIte;
  End
  Else
  Begin
    If fCfgSis('AUTCEN', VarBoolean) And (item.strCodIte = fCfgSis('SERTER')) Then
    Begin
      item.fltTotCus := fGetCustoServTerc;
      item.fltTotCu2 := fGetCustoServTerc;
    End
    Else If fCfgSis('AUTCEN', VarBoolean) And (item.strCodIte = fCfgSis('ITESER')) Then
    Begin
      item.fltTotCus := fGetCustoServNaoTerc;
      item.fltTotCu2 := fGetCustoServNaoTerc;
    End;
  End;

  FreeAndNil(parPreCus);
  FreeAndNil(qryIteGer);
end;

procedure TFatVenda.pLimpaArrayDocDisparo;
begin
  SetLength(arrDocDisparo, 0);
end;

procedure TFatVenda.pLimpaDeletadosDoArrPromocaoQtdeColetiva(intConfirmando: Integer; strOpcDoc: String; blnGridVendaVazio: Boolean; cdsItens: TUniClientDataSet);
var
  cdsClone : TUniClientDataSet;
  intIdx: Integer;
  stlItemPro : TStringList;
  stlRashIte : TStringList;
  stlItemUnd : TStringList;
  fltQtdIte  : Double;
  fltQtdLim  : Double;
  fltQtdMin  : Double;
  strCodPro  : String;
begin
  if intConfirmando = -1 then
  begin
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Length(TProQtdColetiva.ArrItemPro) > 0) Then
    Begin
      if blnGridVendaVazio then
      begin
        TProQtdColetiva.pLimpar;
      end
      else
      begin
        stlItemPro := TStringList.Create;
        stlRashIte := TStringList.Create;
        stlItemUnd := TStringList.Create;
        cdsClone := TUniClientDataSet.Create(nil);

        try
          pCloneDataSet(cdsClone, cdsItens);

          for intIdx := Low(TProQtdColetiva.ArrItemPro) to High(TProQtdColetiva.ArrItemPro) do
          begin
            stlItemPro.Add(TProQtdColetiva.ArrItemPro[intIdx].strCodIte);
            stlItemUnd.Add(TProQtdColetiva.ArrItemPro[intIdx].strCodUnidade);
            stlRashIte.Add(IIF(TProQtdColetiva.ArrItemPro[intIdx].strRshTin='NOR', '', TProQtdColetiva.ArrItemPro[intIdx].strRshTin));
          end;

          for intIdx := 0 to stlItemPro.Count -1 do
          begin
            If (TProQtdColetiva.OpcSys = tRegSysCaixa) Then
            Begin
              cdsClone.Filter := '(ITE_CODITE = '+QuotedStr(stlItemPro[intIdx])+') AND (ITE_CODUNI = '+QuotedStr(stlItemUnd[intIdx])+')';
              cdsClone.Filtered := True;

              If cdsClone.IsEmpty Then
              Begin
                TProQtdColetiva.pDelItem(stlItemPro[intIdx], stlItemUnd[intIdx], 'NOR')
              End
              Else
              Begin
                strCodPro := TProQtdColetiva.fGetCodPro(stlItemPro[intIdx]);
                TProQtdColetiva.pSetQtdLimMin(strCodPro, fltQtdLim, fltQtdMin);

                fltQtdIte := 0;
                cdsClone.First;
                While Not cdsClone.Eof Do
                Begin
                  fltQtdIte := fltQtdIte + cdsClone.FieldByName('ITE_QTDITE').Value;
                  cdsClone.Next;
                End;

                TProQtdColetiva.pAddOrUpdateItem(stlItemPro[intIdx], stlItemUnd[intIdx], strCodPro, fltQtdIte, fltQtdLim, fltQtdMin);
              End;
            End
            Else
            Begin
              If Not cdsClone.Locate('ITE_CODITE;ITE_UNIDAD;ITE_ITETIN', VarArrayOf([stlItemPro[intIdx], stlItemUnd[intIdx], stlRashIte[intIdx]]), [loCaseInsensitive]) Then
                TProQtdColetiva.pDelItem(stlItemPro[intIdx], stlItemUnd[intIdx], IIF(stlRashIte[intIdx]='', 'NOR', stlRashIte[intIdx]));
            End;
          end;
        finally
          FreeAndNil(cdsClone);
          FreeAndNil(stlItemPro);
          FreeAndNil(stlRashIte);
          FreeAndNil(stlItemUnd);
        end;
      end;
    end;
  end;
end;

function TFatVenda.fGravaPedidoItensCortados(blnSomenteVerificaTrava: Boolean = False): Boolean;
  Var
    intIndIte: Integer;

    fltTotProPD,
    fltTotGerPD,
    fltTotCusPD,
    fltBasRetPD,
    fltTotRetPD,
    fltBasIpiPD,
    fltTotIpiPD,
    fltTotMedPD,
    fltPesBruPD,
    fltPesLiqPD,
    fltBasIcmPD,
    fltValIcmPD,
    fltTotCbsPD,
    fltTotIbsPD,
    fltTotIsPD,
    fltBasCbsPD,
    fltBasIbsPD,
    fltBasIsPD: Double;

    strNumDocPD: String;

    arrDuplicatasBkp: TArrDigDuplicArray;
    intContador: Integer;

    blnEntFut: Boolean;

    objOrdenarItensParaGravacao: TOrdenarItensParaGravacao;
    LResultVerificaVrMinimo: Boolean;
begin
  Result := True;

  blnEntFut := False;

  If Length(arrMatItensCorte) = 0 Then
    Exit;

  SetLength(arrDuplicatasBkp, Length(arrDuplicata));
  For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
  Begin
    arrDuplicatasBkp[intContador] := arrDuplicata[intContador];
  End;

  fltTotProPD := 0;
  fltTotGerPD := 0;
  fltTotCusPD := 0;
  fltTotMedPD := 0;
  fltPesBruPD := 0;
  fltPesLiqPD := 0;
  fltBasRetPD := 0;
  fltTotRetPD := 0;
  fltBasIpiPD := 0;
  fltTotIpiPD := 0;

  fltBasIcmPD := 0;
  fltValIcmPD := 0;
  fltTotCbsPD := 0;
  fltTotIbsPD := 0;
  fltTotIsPD  := 0;

  Try
    Try
      strNumDocPD := fRetSequencialPedido(VS_strCodEmp);

      For intIndIte := Low(arrMatItensCorte) To High(arrMatItensCorte) Do
      Begin
        With arrMatItensCorte[intIndIte] Do
        Begin
          fltUniDig := (fltTotIte / fltQtdOri);
          fltUnitar := (fltTotIte / fltQtdOri);
          fltTotIte := fFormataFloat(fltQtdIte * fltUnitar, 2);
          fltTotCus := fFormataFloat(fltQtdIte * fltPreCus, 2);
          fltTotMed := fFormataFloat(fltQtdIte * fltPreMed, 2);
          fltBasIcm := fFormataFloat(fltBasIcm / fltQtdOri * fltQtdIte, 2);
          fltValIcm := fFormataFloat(fltValIcm / fltQtdOri * fltQtdIte, 2);
          fltBasRet := fFormataFloat(fltBasRet / fltQtdOri * fltQtdIte, 2);
          fltValRet := fFormataFloat(fltValRet / fltQtdOri * fltQtdIte, 2);
          fltBasIpi := fFormataFloat(fltBasIpi / fltQtdOri * fltQtdIte, 2);
          fltValIpi := fFormataFloat(fltValIpi / fltQtdOri * fltQtdIte, 2);
          fltDesCon := 0.00;
          fltDesEsp := 0.00;
          fltValFre := 0.00;
          fltDesAce := 0.00;

          pCalcularPisCofinsItemDerivado(arrMatItensCorte[intIndIte],
                                         VS_strCodEmp,
                                         strCodCli,
                                         IIF(fDocumentoParaFornecedor, 'F', 'C'),
                                         False,
                                         True);

          fltTotProPD := fltTotProPD + fltTotIte;
          fltTotCusPD := fltTotCusPD + fltTotCus;
          fltTotMedPD := fltTotMedPD + fltTotMed;
          fltBasIpiPD := fltBasIpiPD + fltBasIpi;
          fltTotIpiPD := fltTotIpiPD + fltValIpi;
          fltBasRetPD := fltBasRetPD + fltBasRet;
          fltTotRetPD := fltTotRetPD + fltValRet;

          fltTotGerPD := fltTotGerPD + fltTotIte + fltValRet + fltValIpi;

          fltBasIcmPD := fltBasIcmPD + fltBasIcm;
          fltValIcmPD := fltValIcmPD + fltValIcm;

          fltPesBruPD := fltPesBruPD + fFormataFloat(fltQtdIte * fltPesoIt, 3);
          fltPesLiqPD := fltPesLiqPD + fFormataFloat(fltQtdIte * fltPesLiq, 3);
        End;
      End;

      If fCfgSis('PESLIQ') = 'FATOR' Then
        fltPesLiqPD := fFormataFloat(fltPesBruPD * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);

      pCalcularImpostosReformaTributariaItens(arrMatItensCorte,
                                              'PD',
                                              strTipPed,
                                              strCodCli,
                                              Self.strAutEnt,
                                              Self.fDocumentoParaFornecedor,
                                              fltTotCbsPD,
                                              fltTotIbsPD,
                                              fltTotIsPD,
                                              fltBasCbsPD,
                                              fltBasIbsPD,
                                              fltBasIsPD);

      fltTotGerPD := fltTotGerPD + fltTotCbsPD + fltTotIbsPD + fltTotIsPD;

      fDigDuplic(arrDuplicata, strConPag, 0, fltTotGerPD, False, False, False, Self.VS_Date, False);

      If (Not fInTransaction) And (blnSomenteVerificaTrava) Then
      Begin
        fltTotGerPDCortado := fltTotGerPD;
        try
          If (fCfgSis('CNDVEN', varString) = 'F') Then
          Begin
            pRemoverTravaLogAviAux('LIBSEN');
            pRemoverTravaLogAviAux('INTFAT');
            pRemoverTravaLogAviAux('INTMAR');
            pRemoverTravaLogAviAux('INTPAR');

            If Not Self.fVerificaIntervaloMargemValorCndPagto Then
            Begin
              Exit(False);
            End;
          End;

          Self.blnVlrMin := False;
          fExecutarModal(function(pgbProgresso: TcxProgressBar): Boolean
            begin
              Result := Self.fVerificaVrMinimo(fltTotProPD, fltTotProPD, Self.intPrzMed,
                'PD', True, True, pgbProgresso, Nil, True);
              LResultVerificaVrMinimo := Result;
            end, 'Aguarde, Verificando valor mínimo produtos ...', '');

          Exit(LResultVerificaVrMinimo);
        finally
          fltTotGerPDCortado := 0;
        end;
      End;

      If (VS_strHabilitarCRM) And (Not Assigned(objOcoCrm)) And (Not fEmptyStr(fCfgSis('VENORC', varString))) And (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
      Begin
        objOcoCrm := fAtualizaInformacoesCRM(strNumDocPD,
                                             'PD',
                                             VS_strCodEmp,
                                             strCodCli,
                                             '','',
                                             strCodVen,
                                             afcPedidoCorte,
                                             '',
                                             strCliCgc);

        objOcoCrm.strInfAdc := fGetModificacoesItensPedido(strNumDocPD, 'PD', VS_strCodEmp, arrMatItensCorte);

        If fDeveGerarOcorrenciaCRMParaProspecto Then
        Begin
          objOcoCrm.strCodPro := strProspe;
          objOcoCrm.strTip_FC := 'P';
        End;
        objOcoCrm.strNomFrm := '[TFatVenda.fGravaPedidoItensCortados]';
      End;

      Result := fGFatGor(0, //Percentual de desconto
                         0, //Desconto Especial
                         fltTotGerPD,
                         fltTotProPD,
                         fltTotCusPD,
                         fltTotMedPD,
                         fltPesBruPD,
                         fltPesLiqPD,
                         fltBasIcmPD,
                         fltValIcmPD,
                         fltBasRetPD,
                         fltTotRetPD,
                         fltBasIpiPD,
                         fltTotIpiPD,
                         fltTotCbsPD,
                         fltTotIbsPD,
                         fltTotIsPD,
                         strTipPed,
                         strCodCli,
                         VS_strCodEmp,
                         'PD',
                         strNumDocPD,
                         strEmpFatGor,
                         strEmpFatGor,
                         strCliNom,
                         strCliEnd,
                         strCliBai,
                         strCliCep,
                         strCodCid,
                         strCliEst,
                         strCodAti,
                         strCliTel,
                         dtaNasCon,
                         intCgcCpf,
                         strCliCgc,
                         strCliIes,
                         strCli_Rg,
                         fltFatNot,
                         IfThen(Not fPermitirFreteNoFaturamento, '9', strTipFre),
                         0,  //Valor do Frete
                         0, //Despesas Acessorias
                         'PEDIDO DE ITENS CORTADOS REF. PD Nº ' + Self.strNumDoc,
                         '',
                         'S',
                         '', //Pedido de Corte = sim
                         '',
                         '',
                         '',
                         False,
                         'N',
                         '',
                         strMen003,
                         strMen004,
                         strMen005);

      If Assigned(objOcoCrm) Then
        FreeAndNil(objOcoCrm);

      If (Not Result) Then
        Exit;

      //Retorna o autoincremento dos itens para gravacao da tabela FATDOR
      For intIndIte := Low(arrMatItensCorte) To High(arrMatItensCorte) Do
        arrMatItensCorte[intIndIte].strAutoincrementoGravacao := fRetAutoIncrem('FATDOR', VS_strCodEmp);

      Try
        objOrdenarItensParaGravacao := TOrdenarItensParaGravacao.Create;

        objOrdenarItensParaGravacao.pSalvarOrdemMatrizItens(arrMatItensCorte);
        objOrdenarItensParaGravacao.pOrdenarItensPorCodigo(arrMatItensCorte);

        //Atualiza a matriz de itens ja ordenada por codigo de produto
        For intIndIte := Low(arrMatItensCorte) To High(arrMatItensCorte) Do
          arrMatItensCorte[intIndIte] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intIndIte];

        For intIndIte := Low(arrMatItensCorte) To High(arrMatItensCorte) Do
        Begin
          Result := fGravaFatDorItem(arrMatItensCorte[intIndIte],
                                     VS_strCodEmp,
                                     strCodCli,
                                     'PD',
                                     strNumDocPD,
                                     blnEntFut);

          If (Not Result) Then
            Break;

          Result := fAtualizaQtdBaiFatDor(arrMatItensCorte[intIndIte].strNumOrc,
                                          arrMatItensCorte[intIndIte].strEspOrc,
                                          arrMatItensCorte[intIndIte].strEmpOrc,
                                          arrMatItensCorte[intIndIte].strCodIte,
                                          arrMatItensCorte[intIndIte].intSeqInd,
                                          arrMatItensCorte[intIndIte].fltQtdIte,
                                          arrMatItensCorte[intIndIte].fltDesEsp,
                                          arrMatItensCorte[intIndIte].blnEntpCD,
                                          IfThen(fUsaPedidoBaixaEntregaFutura, arrMatItensCorte[intIndIte].strIncFut, ''));
          If (Not Result) Then
            Break;
        End;

        If Result And (Length(arrMatItens) = 0) And fOrcamentoComoPedido Then
          Result := fMarcaOrcPed(strNumDocPD,
                                 'PD',
                                 strNumOrc,
                                 strEspOrc,
                                 strCodVen,
                                 strConPag,
                                 fltTotGerPD,
                                 strEmpOri,
                                 False,
                                 '',
                                 '',
                                 '',
                                 '',
                                 '',
                                 False,
                                 blnGravarCadRec,
                                 strCodCli,
                                 strSerieGor,
                                 blnExecutandoFaturadorAutomatico);
      Finally
        //Restaura a ordenacao original dos itens
        objOrdenarItensParaGravacao.pRestaurarOrdemMatrizItens(arrMatItensCorte);

        //Atualiza a matriz de itens com a ordem original de inclusao dos itens
        For intIndIte := Low(arrMatItensCorte) To High(arrMatItensCorte) Do
          arrMatItensCorte[intIndIte] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intIndIte];

        FreeAndNil(objOrdenarItensParaGravacao);
      End;

      {*********************************************}
      {* SE FOR PEDIDO E SE CFG_ENTFUT='S'         *}
      {* AO GERAR O DOCUMENTO, OS ITENS QUE        *}
      {* ESTIVEREM COMO "ENTREGA FUTURA",          *}
      {* DEVERAO SER GRAVADOS COMO "JA EXPEDIDOS"  *}
      {******************************************AC*}
      If Result And blnEntFut Then
        Result := fAtualizaPedidoComoJaExpedido(strAutIncFatGor);

      If Result Then
        Self.strNumDocPDCorte := strNumDocPD;

      If Result Then
        SetLength(arrMatItensCorte, 0);

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fGravaPedidoItensCortados]');
      End;
    End;
  Finally
    For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
    Begin
      arrDuplicata[intContador] := arrDuplicatasBkp[intContador];
    End;
  End;
end;

function TFatVenda.fRetornaSomaTotFreItensOri: Double;
  Var
    item: TDadosFechamento;
begin
  Result := 0;

  For item in Self.arrMatItens Do
  Begin
    Result := Result + fCampoTabela('IF(IFNULL(FDO_FRERAT,0)>0, FDO_FRERAT, FDO_TOTFRE)',
                                    'FATDOR INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO',
                                    ['FATDOR.AUTOINCREM'],
                                    [item.strSeqDet]);
  End;
    
  Result := fFormataFloat(Result, 2);
end;

function TFatVenda.fMatrizTemCodIteRepetidos: Boolean;
var
  item: TDadosFechamento;
  dicVistos: TDictionary<String, Boolean>;
begin
  Result := False;
  dicVistos := TDictionary<String, Boolean>.Create;
  Try
    For item In Self.ArrMatItens Do
    Begin
      If dicVistos.ContainsKey(item.strCodIte) Then
      Begin
        Result := True;
        Exit;
      End;
      dicVistos.Add(item.strCodIte, True);
    End;
  Finally
    FreeAndNil(dicVistos);
  End;
end;

