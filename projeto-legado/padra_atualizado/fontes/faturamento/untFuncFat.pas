  function fCalculaValorModalidade(fltValOri: Double; Var fltTotMod: Double): Double;
  begin
    Result := 0.0;

    If intIndDoc = Length(objDesmembrar.MatrizesItens) -1 Then
      Result := fltValOri - fltTotMod
    Else
    Begin
      If fFormataFloat(fltTotCadRecIte + fltTotCadRecSer, 2) > 0 Then
        Result := fFormataFloat(fltValOri * fltTotCadRec / (fltTotCadRecIte + fltTotCadRecSer), 2);
    end;

    fltTotMod := fltTotMod + Result;
  end;

  function fGetModalidades: String;
