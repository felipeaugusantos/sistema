                                  qryConsignacao.FieldByName('CTR_VALORI').AsFloat,
                                  Self.arrDocConsignacao[intIndice].fltValDoc,                    // Valor Recebido
                                  qryConsignacao.FieldByName('CTR_VALJUR').AsFloat,                    // Valor Juros
                                  qryConsignacao.FieldByName('CTR_VALDES').AsFloat,                    // Valor Desconto
