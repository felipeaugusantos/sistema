    arrDuplicFre : TarrDuplicata;
    arrDuplicFCP : TarrDuplicata;
    arrDuplicCbs : TarrDuplicata;
    arrDuplicIbs : TarrDuplicata;
    arrDuplicIs  : TarrDuplicata;

    fltTotFin: Double;
    strHisBai: String;
    blnLancouCredito: Boolean;

    intSeqBai: Integer;
    fltValOri: Double;
    fltGrvOri: Double;
    fltValAnt: Double;

    strPedAdt: String;

    totAdiantamento: TTotaisAdiantamento;

    blnBaixaParcialParcelaCredito: Boolean;
    fltValorAnteriorParcelaCredito: Double;

    lstBanCtr : TBanCtrRepository;

    strCredito_Id_Loc : String;
    strCredito_Id_Doc : String;

    intIndice: integer;
    qryConsignacao: TUniQuery;
    intSeqBaiConsig: integer;
    strAutIncNovConsig: String;
    blnUtilizaCtaFulFillment: Boolean;

    qryDupCre: TUniQuery;
    fltVlrRestCre: Double;
    fltVlrRecDupCre: Double;
    fltVlrDupCre: Double;
    strHisCtrAux: String;
    blnVaiBaixarAVista: Boolean;

    strCodPorAux: String;
    strPorBaiAux: String;
    strCtaBaiAux: String;
    blnEhAdtPix: Boolean;

    LRecebidoPorPix,
    LPortadorCreditoPix: String;

    strNumOSe: String;

    strAutIncRec : String;
    strClienteCadRec : String;
    strPorBaiAdt: String;
    strCodCtaAdt: String;
    strPortadorAdtCredito : String;
    fltValorAdtCredito : Double;
    blnGravaCadRecBaixadoVendaSiteTablet: Boolean;

    function fQtdDup: Integer;
      Var
        I: Integer;
    Begin
      I      := 0;
      Result := 0;

      While (I < Length(arrDuplicata)) And
            (Not fEmptyStr(arrDuplicata[I].dtaDtaVen)) And
            (fFormataFloat(arrDuplicata[I].curValor,2) <> 0) Do
      Begin
        Inc(I);
        Inc(Result);
      End;
    End;

    function fRetornaCodEmpBaixa():String;
    begin
      Result := VS_strCodEmp;

      If blnVaiBaixarAVista Then
        If (VS_strCodEmp <> strEmpLog) Then
          Result := strEmpLog;
    end;

    function fMensagem(strTitulo, strTexto: String; arrOpcoes: Array Of String): Integer;
    begin
      If Self.Fulfillment.EhOperacaoFulfillment Then
        Raise Exception.Create(strTexto);

      Result := untFuncoesSimples.fMensagem(strTitulo, strTexto, arrOpcoes);
    end;

begin
  {Não deve ser gerado crédito do contas a receber para coleta de produto por garantia,
   o crédito será gerado posteriormente!}
  If (blnColeta) And (strOpcDoc = 'DV') And (fCfgSis('COLGAR', varString) = 'S') Then
    Exit(True);

  // Quando é recebimento de Garantia, seja por devoluçao ou  outras entradas, nunca deve gerar crédito para o cliente,
  // pois esse crédito é gerado ou pelo proprio recebimento, ou na rotina de crédito ou nao gera credito e troca-se a peça
  // apos o envio para o fornecedor ou reposição imediata.
  If fEhRecGarantia Then
  Begin
    Result := True;
    Exit;
  End;

  //Se for envio para fornecedor strOpcDoc = GF não deve gerar numa CadRec pois o documento é para fornecedor.
  If (strOpcDoc = 'GF') Then
  Begin
    Result := True;
    Exit;
  End;

  {*******************************************}
  {* TRAVA SE QUALQUER UMA DAS CONFIGURAÇÕES *}
  {* ABAIXO ESTIVER VAZIA OU INCORRETA       *}
  {****************************************JU*}
  If fEmptyStr(fRetDescCentroCusto(fCfgSis('CTAAVI'))) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração Lançamento bancário à vista - Plano de Contas do grupo Faturamento está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End;

  If fEmptyStr(fRetNomPortador(fCfgSis('PORAVI'))) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração Lançamento bancário à vista - Portador do grupo Faturamento está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End
  {*REQ*145940**********RP*}
  Else If Not fEmpresaTemAcessoPortador(fCfgSis('PORAVI')) Then
  Begin
    fRollback;
    fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador da configuração "Lançamento bancário à vista - Portador do grupo Faturamento". Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
    Result := False;
    Exit;
  End;

  fltBkpDin := 0.0;
  fltBkpCqP := 0.0;
  fltBkpCqV := 0.0;
  fltBkpCar := 0.0;
  fltBkpOrd := 0.0;
  fltBkpFin := 0.0;
  lstBanCtr := Nil;

  strPorBaiAut := '';
  strCtaBaiAut := '';
  strHisBaiAut := '';

  Try
    {**********************************************************}
    {* SÓ VAI UTILIZAR O PROCESSO DE AUTENTICAÇÃO DE CREDIT O *}
    {* SE NÃO ESTIVER CONFIGURADO PARA GRAVAR TR E DV BAIXADO *}
    {*******************************************************AF*}
    blnUALCCL := fCfgSis('UALCCL', varBoolean) And (((Pos(strEspDoc,'TR_DV_DD_CR_') > 0) And (Not fCfgSis('TROQUI', varBoolean))) Or
                                                    ((Not fDocumentoParaFornecedor) And (Pos(strEspDoc,'NF_EL') > 0) And
                                                     (Pos(strClaFis, fCfgSis('CLADEV')) > 0 )));
    Result := True;

    strCodigoBarrasContrato := '';

    If fCfgSis('SISCRE', varBoolean) And (Pos(strEspDoc, 'IF_IV_NF_D1_NS_FF_RB_') > 0) And (fStatusCndPag(strConPag) = A_PRAZO) And (fStatusFormaDePagamento(strCodFpg) = A_PRAZO) Then
    Begin
      For intContador := 1 To 5 Do
      Begin
        strCodigoBarrasContrato := TCarnePagamento.fNovoNumeroContrato(ContratoVenda);

        If Not (fCampoTabela('COUNT(*)', 'CADREC', ['CTR_BARCON'], [strCodigoBarrasContrato]) > 0) Then
          Break;

        If (intContador = 5) Then
        Begin
          fRollBack;
          fMensagem('', 'Favor ajustar corretamente o sequencial "CFG_SEQCRE", pois os números gerados já coincidem com contratos cadastrados!', ['&OK']);
          Result := False;
          Exit;
        End;
      End;
    End;

    strPortador := fDecidePortador;

    {***************************************}
    {* HISTÓRICO DO CONTAS A RECEBER       *}
    {************************************RV*}
    strHisCtr := fRetornaHistoricoDeContasAReceber;

    If (strOpcDoc = 'CS') Then
      strHisCtr := 'ENVIO CONSIG - ' + strNumDoc + '-' + strEspDoc
    Else If (strOpcDoc = 'FC') Then
      strHisCtr := 'FATURA CONSIG - ' + strNumDoc + '-' + strEspDoc;

    If (strOpcDoc = 'GF') Then
      strHisCtr := 'ENVIO DE MERCADORIA P/ CONSERTO (GARANTIA) - ' + strNumDoc + '-' + strEspDoc;

    If (strEspDoc = 'PD') Then
    Begin
      strHisCtr := 'REF. AO PEDIDO - ' + strNumDoc + '-' + strEspDoc;
    End;

    pCarregarDescontoPontualidade(fltPerDPo, intQtdDAV);

    fltValorAnteriorParcelaCredito := 0;

    //Se forem as mesmas parcelas indica que é uma baixa parcial (intSeqBai 0 e 1)
    blnBaixaParcialParcelaCredito := (intSeqDupBaiUtiCred > 0) And
      (arrDuplicata[intSeqDupBaiUtiCred].strSequen = arrDuplicata[intSeqDupBaiUtiCred -1].strSequen);

    If blnBaixaParcialParcelaCredito Then
      fltValorAnteriorParcelaCredito := ( arrDuplicata[intSeqDupBaiUtiCred   ].curValor +
                                          arrDuplicata[intSeqDupBaiUtiCred -1].curValor );

    If blnBaixaAdiantamentoAutomatico And
      (arrDuplicata[0].curValor<>fltCredUtilizados) Then
      arrDuplicata[0].curValor := fltCredUtilizados;

    blnJaLancouAdtCliTotal := False;
    intContador := 0;
    While (intContador < Length(arrDuplicata))                 And
          (Not fEmptyStr(arrDuplicata[intContador].dtaDtaVen)) And
          (fFormataFloat(arrDuplicata[intContador].curValor,2) <> 0) Do
    Begin
      blnLancouCredito := False;
      blnVaiBaixarAVista := False;

      If (LeftStr(strClaFis, 1) < '5') And (arrDuplicata[intContador].curValor > 0.0) And (strEspDoc <> 'TR') Then
      Begin
        arrDuplicata[intContador].curValor := -arrDuplicata[intContador].curValor;
        arrDuplicata[intContador].curArred := -arrDuplicata[intContador].curArred;
        blnLancouCredito := True;
      End;

      If (arrDuplicata[intContador].curValor < 0.0) Then
      Begin
        If (strOpcDoc = 'CR') Then
          strHisCtr := 'RETORNO CONSIG - ' + strNumDoc + '-' + strEspDoc

        Else If (strEspDoc = 'PD') And fCfgSis('GERCRE', varBoolean) Then
          strHisCtr := 'CREDITO REFERENTE ALTERACAO DE PEDIDO COM VALOR QUITADO (R$ ' + FormatFloat('#,##0.00', fltDupRec)+ ')'

        Else
          strHisCtr := 'REF.DEV.: ' + strNumDoc + '-' + strEspDoc + ' REF.DOC.: ' + strDocsDevolucao;

        if (Not fEmptyStr(strDocsDevEntFut)) then
          strHisCtr := strHisCtr + ' - DOC.ORIGEM ENT.FUT.: '+ strDocsDevEntFut;
      End;

      strHisCtrAux := fRetornaHistoricoComParcela(strHisCtr, intContador);
      fltValDup := arrDuplicata[intContador].curValor;
      dtaDtaRec := 0;
      fltValRec := 0.0;
      strPorBai := '';
      strCtaBai := '';
      strOpeBai := '';
      strSeqLan := '';
      strHisBai := '';
      strPorBaiAdt := '';
      strCodCtaAdt := '';

      blnGravaCadRecBaixadoVendaSiteTablet := False;
      If (strOpcDoc = 'DV') And fCfgSis('DVTBCR', varBoolean) Then
        blnGravaCadRecBaixadoVendaSiteTablet := fDeveGravarCadRecBaixadoVendaSiteTablet;

      If blnBaixaAdiantamentoAutomatico Then
      Begin
        dtaDtaRec := VS_Date;
        intSeqDupBaiUtiCred := 0;
      End;

      If (StrToDate(arrDuplicata[intContador].dtaDtaVen) <= Self.VS_Date) Or
         (fVaiBaixarOrdemPagamento) Or
         (Self.Fulfillment.EhOperacaoFulfillment) Then
      Begin
        blnVaiBaixarAVista := ((fBaixaDuplicataAVista(strEmpLog))                                                    And
                               (Pos(strCodFpg,'003_014_015_') <= 0)                                                  And
                               (Not fTemFormaPagtoAReceber)                                                          And
                               (IIF(Pos(strEspDoc,  'TR_DV_PR_TE_DD_') > 0, fCfgSis('TROQUI', varBoolean), True))    And
                               (fltTotCadRec <> 0)                                                                   And
                               (Not (((Pos(strEspDoc, 'NF_EL_') > 0)) And (Pos(strClaFis, fCfgSis('CLADEV')) > 0 ))) And
                               (Not fGerandoFFOuNFNaDeNotaEspecialPorValorComCadRecSeparado)                         And //TEM QUE GRAVAR EM ABERTO POIS SERÁ AJUSTADO DEPOIS

                               IIF(blnEntregaImediataEmNovoPedido Or
                                   blnEmitirNovoPedidoEntregaCD   Or
                                   blnRetiraOutraLojaEmNovoPedido Or
                                   blnRetiraMesmaLojaEmNovoPedido Or
                                   blnRetiraExpedicaoEmNovoPedido Or
                                   blnAbastecTransfReqEmNovoPedido Or
                                   blnRealizandoAdiantamentoPedidoPeloF11 Or
                                   blnDesmembramentoDePedidosComAdiantamento Or
                                   ((blnBaixaAdiantamentoAutomatico) And (intSeqDupBaiUtiCred > -1) And (intSeqDupBaiUtiCred = intContador)) Or
                                   blnRealizandoAdiantamentoPedidoPeloVN, True, strEspDoc <> 'PD') And

                               (Pos(strOpcDoc,'CS_CR_') <= 0)
                             )
                             OR ((intSeqDupBaiUtiCred > -1) And (intSeqDupBaiUtiCred = intContador))
                             OR ((intSeqDupBaiAdtCli > -1) And (intSeqDupBaiAdtCli = intContador))
                             OR (Self.Fulfillment.EhOperacaoFulfillment)
                             OR (blnGravaCadRecBaixadoVendaSiteTablet);

        strCodPor := fCfgSis('PORAVI', VarString, fRetornaCodEmpBaixa());

        {*REQ*145940**********RP*}
        If Not fEmpresaTemAcessoPortador(strCodPor) Then
        Begin
          fRollback;
          fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
          Result := False;
          Exit;
        End
        Else If fCfgSis('DACPOR', varBoolean) Then
        Begin
          If Pos(strCodPor, strPortadoresOperador) <= 0 Then
          Begin
            fRollBack;
            fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
            Result := False;
            Exit;
          End;
        End;

        If blnVaiBaixarAVista Then
        Begin
          blnUtilizaCtaFulFillment := False;

          If (intSeqDupBaiUtiCred > -1) And (intSeqDupBaiUtiCred = intContador) Then
          Begin
            strHisBai := fMontaHistoricoDupsCredito;
          End;

          blnHouveBaixaAVista := True;

          strCtaBai := fCfgSis('CTAAVI', VarString, fRetornaCodEmpBaixa());

          fltValDup := 0;
          dtaDtaRec := Self.VS_Date;

          pRemanejaArrendondamentoParaParcelaFaturada(arrDuplicata, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, intContador, FFoiGravacaoPorDesmembramento, strAutInc);

          strOpeBai := fGetOperadorDaBaixa;//Operador

          If (intSeqDupBaiAdtCli > -1) And
             (intSeqDupBaiAdtCli = intContador) And
             (Not strOpeAdt.IsEmpty) Then
          Begin
            strOpeBai := strOpeAdt;
          End;

          fltValRec := arrDuplicata[intContador].curValor;

          {***************************************}
          {* VALIDA CONDICAO DE PAGTO CARREGADA  *}
          {************************************RV*}
          If (fltValDin = 0) And (fltValCqP = 0) And (fltValCqV = 0) And
             (fltValCar = 0) And (fltValOrd = 0) And (fltValFin = 0) Then
          Begin
            If fCfgSis('USAFPG', varBoolean) Then
            Begin
              Case StrToIntDef(strCodFpg, 1) Of
                1,
                3,
                8,
                9,
                10,
                13,
                14,
                15:fltValDin := fltValRec;
                2 :fltValCqP := fltValRec;
                6 :fltValCqV := fltValRec;
                7 :fltValCar := fltValRec;
                12:fltValOrd := fltValRec;
                16:fltValFin := fltValRec;
              End;
            End
            Else
              fltValDin := fltValRec;
          End;

          If (strOriF11 = 'S') And
             (fCfgSis('NCDP11', varString) = 'S') And
             (fCfgSis('BAVF11', varString) = 'S') And
             (Not fEmptyStr(fCfgSis('PORRCX', varString))) Then
            strPorBai := fCfgSis('PORRCX', varString)
          Else
            strPorBai := fDefinePortadorBaixa(fRetornaCodEmpBaixa());

          strPorBan := fCfgSis('PORAVI');

          If (Not fEmptyStr(strPortador)) Then
          Begin
            strPorBan := strPortador;
          End;

          If Self.Fulfillment.EhOperacaoFulfillment Then
          Begin
            If (fltValRec < 0.0) Then
            Begin
              fltValRec := -fltTotCadRec;
              strHisBan := 'DEVOLUCAO FULFILLMENT - ' + strNumDoc + '-' + strEspDoc;
            End
            Else
            Begin
              fltValRec := fltTotCadRec;
              strHisBan := 'FULFILLMENT - ' + strNumDoc + '-' + strEspDoc;
            End;
            blnUtilizaCtaFulFillment := True;
            strPorBan := CfgFulFillment('CODPOR', Self.Fulfillment.SiglaHubMarketPlace);
          End
          Else If (strEspDoc = 'TR') Then
          Begin
            strHisBan := 'TROCA MERCADORIA - ' + strNumDoc;
          End
          Else If strEspDoc = 'DV' Then
          Begin
            strHisBan := 'DEVOLUCAO - ' + strNumDoc;
          End
          Else If strEspDoc = 'DD' Then
          Begin
            strHisBan := 'DEVOLUCAO DE DEMOSTRACAO - ' + strNumDoc;
          End
          Else If strEspDoc = 'PR' Then
          Begin
            strHisBan := 'PEDIDO DEVOLUCAO PARA RETIRADA - ' + strNumDoc;
          End
          Else If strEspDoc = 'CR' Then
          Begin
            strHisBan := 'RETORNO DE MERCADORIA EM CONSIGNAÇÃO - ' + strNumDoc;
          End
          Else If (strEspDoc = 'FC') Then
          Begin
            strHisBan := 'FATURAMENTO DE MERCADORIA EM CONSIGNAÇÃO - ' + strNumDoc;
          End
          Else If (strEspDoc = 'GF') Then
          Begin
            strHisBan := 'ENVIO DE MERCADORIA P/ CONSERTO (GARANTIA) - ' + strNumDoc;
          End
          Else If (strEspDoc = 'PD') Then
          Begin
            strHisBan := 'REF. PAGTO. ANTECIPADO - ' + strNumDoc + '-' + strEspDoc;
          End
          Else If strEspDoc = 'TE' Then
          Begin
            strHisBan := 'TRANSF. ESTOQUE - ' + strNumDoc;
          End
          Else If (fltValRec < 0.0) Then
          Begin
            strHisBan := 'DEVOLUCAO - ' + strNumDoc + '-' + strEspDoc;
          End
          Else
          Begin
            strHisBan := 'VENDA A VISTA - ' + strNumDoc;
          End;

          If blnGravaCadRecBaixadoVendaSiteTablet Then
          Begin
            strPorBan := fCfgSis('DVTBPB');
            strHisBan := Trim(strHisBan +' '+ fCfgSis('DVTBHB'));
          End;

          strSeqLan := '';

          If (Not blnValGravaResCai) And

             (intSeqDupBaiAdtCli <> intContador) And //Duplicata de Adiantamento não grava MOVBAN (Já foi paga pelo pedido)

             IIF( (intSeqDupBaiUtiCred > -1) And
                  (intSeqDupBaiUtiCred = intContador), fFormataFloat(fltValRec - fltCredUtilizados,2) <> 0, True) Then
          Begin
            lstBanCtr := TBanCtrRepository.Create;
            lstBanCtr.fAdd(strNumDoc,
                           'A',
                           strEspDoc,
                           VS_strCodEmp,
                           strCodCli,
                           strPedAdt + strInfErro + strHisCtrAux,
                           arrDuplicata[intContador].strHist02,
                           0,
                           IIF(fltValRec < 0.0, (-1) * fltValRec, fltValRec));

            strSeqLan := fGravaMovBan(IIF(blnUtilizaCtaFulFillment, CfgFulFillment('CODCTA', Self.Fulfillment.SiglaHubMarketPlace), fCfgSis('CTAAVI')),
                                      strPorBan,
                                      strCodVen,
                                      Self.VS_Date,
                                      fRetHoraServidor,
                                      strNumDoc,
                                      IIF(fltValRec < 0.0, 'D', 'C'),
                                      VS_strCodEmp,
                                      IIF(fltValRec < 0.0, (-1) * fltValRec, fltValRec),
                                      strHisBan,
                                      '',
                                      strCodCli,
                                      '',
                                      strNumDoc,
                                      0,
                                      'A',
                                      VS_strCodEmp,
                                      '',
                                      strCodEve,
                                      '',
                                      lstBanCtr.fGetList
                                     );

            FreeAndNil(lstBanCtr);

            Result := (Not fEmptyStr(strSeqLan));

            If (Result) And (fltCredUtilizados > 0) Then
            Begin
              qryDupCre := fCriaQuery();

              Try
                pCarregaDuplicatasCredito(stlDupCreditos, qryDupCre);

                fltVlrRestCre := fltCredUtilizados;

                qryDupCre.First;
                While Not qryDupCre.Eof Do
                Begin
                  lstBanCtr := TBanCtrRepository.Create;
                  Try
                    lstBanCtr.fAdd(qryDupCre.FieldByName('CTR_NUMDUP').AsString,
                                   qryDupCre.FieldByName('CTR_PARCEL').AsString,
                                   qryDupCre.FieldByName('CTR_ESPDOC').AsString,
                                   qryDupCre.FieldByName('CTR_CODEMP').AsString,
                                   qryDupCre.FieldByName('CTR_CODCLI').AsString,
                                   qryDupCre.FieldByName('CTR_HIST01').AsString,
                                   qryDupCre.FieldByName('CTR_HIST02').AsString,
                                   qryDupCre.FieldByName('CTR_SEQBAI').AsInteger,
                                   qryDupCre.FieldByName('CTR_VALREC').AsFloat,
                                   qryDupCre.FieldByName('CTR_VALJUR').AsFloat,
                                   qryDupCre.FieldByName('CTR_VALDES').AsFloat,
                                   qryDupCre.FieldByName('CTR_VALDUP').AsFloat);

                    fltVlrDupCre := IIF(qryDupCre.FieldByName('CTR_VALDUP').AsFloat > 0, qryDupCre.FieldByName('CTR_VALDUP').AsFloat, (-1 * qryDupCre.FieldByName('CTR_VALDUP').AsFloat));

                    If (fFormataFloat(fltVlrDupCre, 4) >= fFormataFloat(fltVlrRestCre, 4)) Then
                    Begin
                      fltVlrRecDupCre := fltVlrRestCre;
                      fltVlrRestCre   := 0;
                    End
                    Else
                    Begin
                      fltVlrRecDupCre := fltVlrDupCre;
                      fltVlrRestCre   := (fltVlrRestCre - fltVlrDupCre);
                    End;



                    Result := (Not fEmptyStr(fGravaMovBan(IIF(blnUtilizaCtaFulFillment, CfgFulFillment('CODCTA', Self.Fulfillment.SiglaHubMarketPlace), fCfgSis('CTAAVI')),
                                                          strPorBan,
                                                          strCodVen,
                                                          Self.VS_Date,
                                                          fRetHoraServidor,
                                                          strNumDoc,
                                                          'D',
                                                          VS_strCodEmp,
                                                          fltVlrRecDupCre,
                                                          'BAIXA DE CRÉDITO - ' + qryDupCre.FieldByName('CTR_NUMDUP').AsString + '-'
                                                                                + qryDupCre.FieldByName('CTR_ESPDOC').AsString,
                                                          '',
                                                          qryDupCre.FieldByName('CTR_CODCLI').AsString,
                                                          '',
                                                          qryDupCre.FieldByName('CTR_NUMDUP').AsString,
                                                          0,
                                                          qryDupCre.FieldByName('CTR_PARCEL').AsString,
                                                          qryDupCre.FieldByName('CTR_CODEMP').AsString,
                                                          '',
                                                          strCodEve,
                                                          '',
                                                          lstBanCtr.fGetList
                                                          )));
                    If (Not Result) Then
                      Break;

                    qryDupCre.Next;
                  Finally
                    FreeAndNil(lstBanCtr);
                  End;
                End;
              Finally
                FreeAndNil(qryDupCre);
              End;
            End;
          End;

        End;
      End
      Else
      Begin
        strCodPor := fCfgSis('PCTRAP');

        {*REQ*145940**********RP*}
        If Not fEmpresaTemAcessoPortador(strCodPor) Then
        Begin
          fRollback;
          fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
          Result := False;
          Exit;
        End;

        If fCfgSis('DACPOR', varBoolean) Then
        Begin
          If Pos(strCodPor, strPortadoresOperador) <= 0 Then
          Begin
            fRollBack;
            fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
            Result := False;
            Exit;
          End;
        End;
      End;

      If (Not fEmptyStr(strPortador)) Then
      Begin
        strCodPor := strPortador;

        {*REQ*145940**********RP*}
        If Not fEmpresaTemAcessoPortador(strCodPor) Then
        Begin
          fRollback;
          fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
          Result := False;
          Exit;
        End;

        If fCfgSis('DACPOR', varBoolean) Then
        Begin
          If Pos(strCodPor, strPortadoresOperador) <= 0 Then
          Begin
            fRollBack;
            fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
            Result := False;
            Exit;
          End;
        End;
      End;

      If (blnBaixaEmprestimos) Then
      Begin
        strCodPor := fCfgSis('POREMP', varString);

        {*REQ*145940**********RP*}
        If Not fEmpresaTemAcessoPortador(strCodPor) Then
        Begin
          fRollback;
          fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
          Result := False;
          Exit;
        End;

        If fCfgSis('DACPOR', varBoolean) Then
        Begin
          If Pos(strCodPor, strPortadoresOperador) <= 0 Then
          Begin
            fRollBack;
            fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
            Result := False;
            Exit;
          End;
        End;
      End;

      if AnsiMatchStr(strOpcDoc, ['CR', 'CS']) and (not fEmptyStr(fCfgSis('PORCON', varString))) then
      Begin
        strCodPor := fCfgSis('PORCON', varString);

        If Not fEmpresaTemAcessoPortador(strCodPor) Then
        Begin
          fRollback;
          fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
          Result := False;
          Exit;
        End;

        If fCfgSis('DACPOR', varBoolean) Then
        Begin
          If Pos(strCodPor, strPortadoresOperador) <= 0 Then
          Begin
            fRollBack;
            fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
            Result := False;
            Exit;
          End;
        End;
      End;

      If (Not Result) Then
        Break;

      strNomPor := fRetNomPortador(strCodPor);

      If blnBaixaAdiantamentoAutomatico Then
        fltValRec := fltCredUtilizados;

      If intContador = 0 Then
      Begin
        pMontaDuplicatasProporcional(fltVlrCom, arrDuplicVend, arrDuplicata, False, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltVlrExt, arrDuplicRepr, arrDuplicata, False, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltDesAce, arrDuplicAce , arrDuplicata, False, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);// Despesa acessória não tem configuração sempre rateia.
        pMontaDuplicatasProporcional(fltTotIpi, arrDuplicIPI , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPIPI', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltTotRet, arrDuplicRet , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPSUB', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltValFre, arrDuplicFre , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPFRE', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltTotFcpST, arrDuplicFCP,arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPSUB', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltTotCBS,   arrDuplicCbs,arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPCBS', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltTotIBS,   arrDuplicIbs,arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPCBS', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(fltTotIS,    arrDuplicIs, arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPCBS', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
      End;

      If blnBaixaParcialParcelaCredito And (arrDuplicata[intSeqDupBaiUtiCred].strSequen = arrDuplicata[intContador].strSequen) Then
      Begin
        fltParValCom := (arrDuplicVend[intSeqDupBaiUtiCred].curValor + arrDuplicVend[intSeqDupBaiUtiCred - 1].curValor);

        fltParFatCom := (arrDuplicVend[intSeqDupBaiUtiCred].curValor + arrDuplicVend[intSeqDupBaiUtiCred - 1].curValor) /
                        (arrDuplicata[intSeqDupBaiUtiCred ].curValor + arrDuplicata[intSeqDupBaiUtiCred  - 1].curValor);

        fltParComRep := (arrDuplicRepr[intSeqDupBaiUtiCred].curValor + arrDuplicRepr[intSeqDupBaiUtiCred - 1].curValor);

        fltParFatRep := (arrDuplicRepr[intSeqDupBaiUtiCred].curValor + arrDuplicRepr[intSeqDupBaiUtiCred - 1].curValor) /
                        (arrDuplicata[intSeqDupBaiUtiCred ].curValor + arrDuplicata[intSeqDupBaiUtiCred  - 1].curValor);
      End
      Else
      Begin
        fltParValCom := arrDuplicVend[intContador].curValor;
        fltParFatCom := arrDuplicVend[intContador].curValor;
        If arrDuplicata[intContador].curValor <> 0 Then
          fltParFatCom := fltParFatCom / arrDuplicata[intContador].curValor;

        fltParComRep := arrDuplicRepr[intContador].curValor;
        fltParFatRep := arrDuplicRepr[intContador].curValor;
        If arrDuplicata[intContador].curValor <> 0 Then
          fltParFatRep := fltParFatRep / arrDuplicata[intContador].curValor;
      End;

      fltParIpi := arrDuplicIPI[intContador].curValor;
      fltParFre := arrDuplicFre[intContador].curValor;
      fltParRet := arrDuplicRet[intContador].curValor;
      fltParAce := arrDuplicAce[intContador].curValor;
      fltParFCP := arrDuplicFCP[intContador].curValor;
      fltParCbs := arrDuplicCbs[intContador].curValor;
      fltParIbs := arrDuplicIbs[intContador].curValor;
      fltPar_Is := arrDuplicIs[intContador].curValor;

      If blnLancouCredito Then
      Begin
        fltParIpi := -fltParIpi;
        fltParFre := -fltParFre;
        fltParRet := -fltParRet;
        fltParAce := -fltParAce;
        fltParFCP := -fltParFCP;
        fltParCbs := -fltParCbs;
        fltParIbs := -fltParIbs;
        fltPar_Is := -fltPar_Is;
      End;

      If fQtdDup > 1 Then
      Begin
        If (intSeqDupBaiUtiCred <> intContador) Then
        Begin
          fltBkpDin := fltValDin;
          fltBkpCqP := fltValCqP;
          fltBkpCqV := fltValCqV;
          fltBkpCar := fltValCar;
          fltBkpOrd := fltValOrd;
          fltBkpFin := fltValFin;
        End;
      End
      Else
      Begin
        fltBkpDin := fltValDin;
        fltBkpCqP := fltValCqP;
        fltBkpCqV := fltValCqV;
        fltBkpCar := fltValCar;
        fltBkpOrd := fltValOrd;
        fltBkpFin := fltValFin;
      End;

      If ( (intSeqDupBaiUtiCred > -1) And (intSeqDupBaiUtiCred = intContador) ) Then
      Begin
        fltValDin := fltValRec;
        fltValCqP := 0;
        fltValCqV := 0;
        fltValCar := 0;
        fltValOrd := 0;
        fltValFin := 0;
      End;

      {***************************************}
      {* CASO ESCOLHEU TROCO, GRAVA NA MODA- *}
      {* LIDADE DINHEIRO.                    *}
      {************************************MV*}
      If (optTroco = otTroco) And (fltValorTroco > 0) And (intSeqDupBaiUtiCred <> intContador) Then
        fltValDin := fltValDin - fltValorTroco;

      If (optTrocoPre = otTroco) And (fltValorTrocoPre > 0) And (intSeqDupBaiUtiCred <> intContador) Then
        fltValDin := fltValDin - fltValorTrocoPre;

      If (optTrocoCar = otTroco) And (fltValorTrocoCar > 0) And (intSeqDupBaiUtiCred <> intContador) Then
        fltValDin := fltValDin - fltValorTrocoCar;

      If (optTrocoDinheiro = otTroco) And (fltValorTrocoDinheiro > 0) And (intSeqDupBaiUtiCred <> intContador) Then
        fltValDin := fltValDin - fltValorTrocoDinheiro;

      If fltTotCadRec <> 0 Then
      Begin

        fltTotFin := 0;

        If (intContador = 23) Or fEmptyStr(arrDuplicata[Succ(intContador)].dtaDtaVen) Then
        Begin

          If Pos(strOpcDoc, 'CP_OV_') > 0 Then
          Begin
            fltTotFin := fRetDescontoFinanceiroItem;
          End

          Else If (fltDesFin > 0) Then
          Begin
            If strTipFin = 'V' Then
              fltTotFin := fltDesFin
            Else
              fltTotFin := RoundTo( fltTotCadRec * fltDesFin / 100, -2);
          End;

        End;

        intSeqBai := 0;

        fltGrvOri := arrDuplicata[intContador].curValor;
        fltValOri := arrDuplicata[intContador].curValor;
        fltValAnt := arrDuplicata[intContador].curValor;

        If (intSeqDupBaiUtiCred > -1) And blnBaixaParcialParcelaCredito And
           (arrDuplicata[intContador].strSequen = arrDuplicata[intSeqDupBaiUtiCred].strSequen) Then
        Begin
          fltGrvOri := fltValorAnteriorParcelaCredito;

          If (intSeqDupBaiUtiCred = intContador) Then
          Begin
            intSeqBai := 1;
            fltValAnt := fltValorAnteriorParcelaCredito;
            If (fCfgSis('DESMRC', varString) = 'S') Then
              intSeqBai := fRetSeqBaiCadRecDesmembrados(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, arrDuplicata[intSeqDupBaiUtiCred].strSequen);
          End;

        End;

        strPedAdt := '';

        If (intSeqDupBaiAdtCli > -1) And
           (intSeqDupBaiAdtCli = intContador) And
           (Not blnBaixaAdiantamentoAutomatico) Then
        Begin
          Result := Result And fLancarDebitoAdiantamento(fltValRec, strPedAdt, totAdiantamento);

          If ((Not fEmptyStr(strNumPok)) Or (Not fEmptyStr(strPedSit))) Then
          Begin
            strCodPor := fDecidePortador;
            strPorBai := strCodPor;

            If (fEmptyStr(strCodPor)) Then
            Begin
              strCodPor := fCfgSis('PORRCX');
              strPorBai := fCfgSis('PORRCX');
            End;
          End
          Else
          Begin
            strCodPor := fCfgSis('PORRCX', varString, strEmpRec);
            if (fEmptyStr(strCodPor)) then
            begin
              strCodPor := fCfgSis('PORRCX');
            end;
            strPorBai := strCodPor;
          End;

          blnEhAdtPix := False;
          pCarregaCodigoPortadorPix(strNumOrc, strEspOrc, VS_strCodEmp, strCodCli, FCodPor, blnEhAdtPix);

          If blnEhAdtPix Then
            strPorBai := strCodPor;

          fltValCqP := totAdiantamento.fltValChP;
          fltValCqV := totAdiantamento.fltValChV;
          fltValCar := totAdiantamento.fltValCar;
          fltValOrd := totAdiantamento.fltValOrd;
          fltValFin := totAdiantamento.fltValFin;
          {HOJE NAO EXISTE UM CAMPO NO CADREC PARA GRAVAR O CREDITO UTILIZADO ENTAO LANCAMOS EM DINHEIRO}
          fltValDin := totAdiantamento.fltValDin + totAdiantamento.fltValCre;
        End;

        If Not fEmptyStr(strPedAdt) Then
          strPedAdt := strPedAdt + ' - ';

        If blnGravaCadRecBaixadoVendaSiteTablet Then
        Begin
          If (fltValRec < 0.0) Then
            fltValRec := -fltTotCadRec
          Else
            fltValRec := fltTotCadRec;

          dtaDtaRec := Self.VS_Date;
          fltValCar := 0;
          fltValDin := fltValRec;
          fltValDup := 0;
          fltValOrd := 0;
          fltValFin := 0;
          fltValCqP := 0;
          fltValCqV := 0;
          strHisBai := fCfgSis('DVTBHB');
          strCtaBai := fCfgSis('DVTBPC');
          strPorBai := fCfgSis('DVTBPB');
          strOpeBai := fGetOperadorDaBaixa;
        End;

        {*******************************************************************************}
        {* PEDIDO NAO DEVE GRAVAR CONTAS A RECEBER, SOMENTE LANCAMENTO DE ADIANTAMENTO *}
        {****************************************************************************JC*}
        If Result And (dtaDtaRec > 0) And
           (blnEntregaImediataEmNovoPedido Or blnEmitirNovoPedidoEntregaCD Or
            blnRetiraOutraLojaEmNovoPedido Or blnRetiraExpedicaoEmNovoPedido Or
            blnRealizandoAdiantamentoPedidoPeloF11 Or blnBaixaAdiantamentoAutomatico Or
            blnDesmembramentoDePedidosComAdiantamento Or blnRealizandoAdiantamentoPedidoPeloVN or
            fEhPedidoReposicaoClienteGarantia or blnRetiraMesmaLojaEmNovoPedido or
            blnAbastecTransfReqEmNovoPedido) Then
        Begin
          If (Not Self.blnResCaiAdt) Then
            Self.blnResCaiAdt := (strOriF11 = 'S');

          strPorBaiAdt := TAdiantamento.fGetCodPorAdiantamento(strNumOrc, strEspOrc, strEmpOri, strCodCli);
          strCodCtaAdt := TAdiantamento.fGetCodCtaAdiantamento(strNumOrc, strEspOrc, strEmpOri, strCodCli);

          If (intSeqDupBaiAdtCli = intContador) And (Not blnBaixaAdiantamentoAutomatico) Then
          Begin
            Result := fLancarAdiantamentoPedido(totAdiantamento, True, IfEmptyStr(strCodCtaAdt, strCtaBai), strPorBaiAdt);
            Result := (Result And fLiberaPREPTEPedido());
          End
          Else If (intSeqDupBaiUtiCred = intContador) Then
          Begin
            FillChar(totAdiantamento, SizeOf(totAdiantamento), #0);

            totAdiantamento.fltValCre := fltCredUtilizados;
            totAdiantamento.fltValLan := fltCredUtilizados;

            Result := fLancarAdiantamentoPedido(totAdiantamento, False, IfEmptyStr(strCodCtaAdt, strCtaBai), strPorBaiAdt);
            Result := (Result And fLiberaPREPTEPedido());
          End
          Else
          Begin
            If (Not blnJaLancouAdtCliTotal) Then
            Begin
              FillChar(totAdiantamento, SizeOf(totAdiantamento), #0);

              totAdiantamento.fltValChP := fltValCqP;
              totAdiantamento.fltValChV := fltValCqV;
              totAdiantamento.fltValCar := fltValCar;
              totAdiantamento.fltValOrd := fltValOrd;
              totAdiantamento.fltValFin := fltValFin;
              totAdiantamento.fltValDin := fltValDin;
              totAdiantamento.fltValLan := fltValCqP + fltValCqV + fltValCar + fltValOrd + fltValFin + fltValDin;

              Result := fLancarAdiantamentoPedido(totAdiantamento, False, IfEmptyStr(strCodCtaAdt, strCtaBai), strPorBaiAdt);
              Result := (Result And fLiberaPREPTEPedido());

              If Result Then
              Begin
                fltDifAdtCliCadRec := fFormataFloat(totAdiantamento.fltValLan, 2) - fFormataFloat(fltTotCadRec, 2);

                blnJaLancouAdtCliTotal := (CompareValue(fltDifAdtCliCadRec,     0) = EqualsValue) Or
                                          (CompareValue(fltDifAdtCliCadRec, +0.01) = EqualsValue) Or
                                          (CompareValue(fltDifAdtCliCadRec, -0.01) = EqualsValue);
              End;
            End;
          End;
        End;

        If Self.Fulfillment.EhOperacaoFulfillment Then
        Begin
          If (fltValRec < 0.0) Then
            fltValRec := -fltTotCadRec
          Else
            fltValRec := fltTotCadRec;

          dtaDtaRec := StrToDate(arrDuplicata[intContador].dtaDtaVen);
          fltValCar := IIF(blnDevNota, 0, fltValRec);
          fltValDin := IIF(blnDevNota, fltValRec, 0);
          fltValDup := 0;
          strCtaBai := CfgFulFillment('CODCTA', Self.Fulfillment.SiglaHubMarketPlace);
          strHisBai := 'FULFILLMENT';
          strCodVen := CfgFulFillment('CODVEN', Self.Fulfillment.SiglaHubMarketPlace);
          strPorBai := CfgFulFillment('CODPOR', Self.Fulfillment.SiglaHubMarketPlace);
          strOpeBai := CfgFulFillment('CODVEN', Self.Fulfillment.SiglaHubMarketPlace);
        End;

        if (strOpcDoc = 'CR') or ((fStatusCndPag(Self.strConPag) = A_VISTA) And (Not fEmptyStr(strChaveMeiaNota))) then
        begin
          strCtaBai := fCfgSis('CTAAVI');
          fltValDup := 0;
          dtaDtaRec := Self.VS_Date;
          strOpeBai := fGetOperadorDaBaixa;
          fltValRec := arrDuplicata[intContador].curValor;
          strPorBai := fDefinePortadorBaixa;
          If (fltValDin = 0) And (strOpcDoc = 'CR') Then
            fltValDin := fltValRec;
        end;

        {*******************************************************************************}
        {* PEDIDO NAO DEVE GRAVAR CONTAS A RECEBER, SOMENTE LANCAMENTO DE ADIANTAMENTO *}
        {****************************************************************************JC*}
        If Result And
           Not (blnEntregaImediataEmNovoPedido Or blnEmitirNovoPedidoEntregaCD Or
                blnRetiraOutraLojaEmNovoPedido Or blnRetiraExpedicaoEmNovoPedido Or
                blnRealizandoAdiantamentoPedidoPeloF11 Or blnBaixaAdiantamentoAutomatico Or
                blnDesmembramentoDePedidosComAdiantamento or blnRealizandoAdiantamentoPedidoPeloVN Or
                blnRetiraMesmaLojaEmNovoPedido Or blnAbastecTransfReqEmNovoPedido) Then
        begin
          strCodPorAux := IIF(Not fEmptyStr(strPorNotaEspFator), strPorNotaEspFator, IIF(Not fEmptyStr(FPorAdt) And (intSeqDupBaiAdtCli = intContador), FPorAdt, strCodPor));
          strPorBaiAux := RetornaPortadorDeBaixaCadRec(intContador, strPorBai, IIF(dtaDtaRec = 0, 0, fltValOrd));
          strCtaBaiAux := IIF(Not fEmptyStr(FCtaAdt) And (intSeqDupBaiAdtCli = intContador), FCtaAdt, strCtaBai);

          LRecebidoPorPix := RecebidoPorPixOuPixAvulso(dtaDtaRec, True);
          If LRecebidoPorPix.Equals('S') And (fFormataFloat(fltValOrd, 2) = 0.00) Then
            LRecebidoPorPix := 'N';
          RetornaPortadorEValorAdiantamentoCredito(strPortadorAdtCredito, fltValorAdtCredito);

          if Result and fOSGarantiaLoja(strNumOrc, strEspOrc, strEmpOri, strNumOSe) then
          begin
            strPorBaiAux := fCfgSis('OSGLPO', varString);
            strCtaBaiAux := fCfgSis('OSGLPC', varString);
            strHisBai := fCfgSis('OSGLHI', varString);
            dtaDtaRec := Self.VS_Date;
            fltValRec := fltValOri;
            fltValDin := fltValOri;
            fltValDup := 0;
            strOpeBai := strCodDig;
          end;

          strClienteCadRec := strCodCli;
          If (fUtilizarRotinaDeOutrasEntradasParaAnulacaoDeVendas) And (Self.blnCliFil) And (Not fEmptyStr(FClienteDaChaveASerDevolvida)) Then
            strClienteCadRec := FClienteDaChaveASerDevolvida;

          If blnAlterouPrecoTravaRemota Then
          Begin
            fltValDin := 0;
            fltValCqP := 0;
            fltValCqV := 0;
            fltValCar := 0;
            fltValOrd := 0;
            fltValFin := 0;

            If fCfgSis('USAFPG', varBoolean) Then
            Begin
              Case StrToIntDef(strCodFpg, 1) Of
                1,
                3,
                8,
                9,
                10,
                13,
                14,
                15:fltValDin := fltValRec;
                2 :fltValCqP := fltValRec;
                6 :fltValCqV := fltValRec;
                7 :fltValCar := fltValRec;
                12:fltValOrd := fltValRec;
                16:fltValFin := fltValRec;
              End;
            End
            Else
              fltValDin := fltValRec;
          End;

          Result := fGravaCadRec(strNomeForm,
                                 'INCLUSÃO',
                                 strNumDoc,
                                 arrDuplicata[intContador].strSequen,
                                 intSeqBai,
                                 strEspDoc,
                                 strClienteCadRec,
                                 VS_strCodEmp,
                                 strCodVen,
                                 strCodDig,
                                 strCodPorAux,
                                 IIF(Self.Fulfillment.EhOperacaoFulfillment, dtaDtaEnt, Self.VS_Date),
                                 StrToDate(arrDuplicata[intContador].dtaDtaVen),
                                 IIf(blnUALCCL, 0, fltValDup),
                                 IIf(blnUALCCL, 0, fltValOri),
                                 0.0,
                                 '',
                                 strPedAdt + strInfErro + strHisCtrAux,
                                 arrDuplicata[intContador].strHist02,
                                 strPorBaiAux,
                                 strCtaBaiAux,
                                 strOpeBai,
                                 strSeqLan,
                                 fltValRec,
                                 dtaDtaRec,
                                 IIF(intSeqDupBaiAdtCli = intContador, 'S', 'N'),
                                 strCodEve,
                                 '',
                                 strTipFor,
                                 strCodCnd,
                                 blnConApr,
                                 strCodCta,
                                 IIF(dtaDtaRec = 0, 0, intSeqConRcx),
                                 fltGrvOri,
                                 '',
                                 '',
                                 '',
                                 '',
                                 0,
                                 IIF((blnResCaiAdt) or (blnCfgGravaResCai And blnValGravaResCai), 1, 0),
                                 fltParValCom,
                                 fltParFatCom,
                                 IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
                                 strEmpRec, // Empresa de Origem
                                 '', // strDocDiv
                                 '', // strEspDiv
                                 '', // strEmpDiv
                                 '', // strCliDiv
                                 fltParComRep,
                                 fltParFatRep,
                                 strCodRep,
                                 fltParIpi,
                                 fltParRet,
                                 strOriF11,
                                 fltTotFin,
                                 0,
                                 IIF(dtaDtaRec = 0, 0, fltValCqP),
                                 IIF(dtaDtaRec = 0, 0, fltValCqV),
                                 IIF(dtaDtaRec = 0, 0, fltValDin),
                                 IIF(dtaDtaRec = 0, 0, fltValCar),
