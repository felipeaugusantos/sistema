                           qryConsignacao.FieldByName('CTR_PARCEL').AsString, intSeqBaiConsig,
                           'BAIXA PARCIAL - FAT. CONSIGNAÇÃO', strNomeForm);

              pGravaLogCtr(qryConsignacao.FieldByName('CTR_NUMDUP').AsString,
                           qryConsignacao.FieldByName('CTR_ESPDOC').AsString,
                           qryConsignacao.FieldByName('CTR_CODCLI').AsString,
                           qryConsignacao.FieldByName('CTR_CODEMP').AsString,
                           qryConsignacao.FieldByName('CTR_PARCEL').AsString, 0,
                           'ALTERAÇÃO DE BAIXA - FAT. CONSIGNAÇÃO', strNomeForm);
            End;
          end
          else
          begin
            Result := fBaixaTotal(qryConsignacao.FieldByName('CTR_NUMDUP').AsString,                   // Duplicata
                                  qryConsignacao.FieldByName('CTR_PARCEL').AsString,                   // Parcela
                                  qryConsignacao.FieldByName('CTR_ESPDOC').AsString,                   // Espécie
                                  qryConsignacao.FieldByName('CTR_CODEMP').AsString,                   // Empresa
