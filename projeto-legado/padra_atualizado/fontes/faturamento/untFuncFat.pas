  Finally
    FreeAndNil(objLiberacao);
  End;
end;

function TFatVenda.fValidarCustoMinimoPorProduto(blnPedeSenha: Boolean = True): Boolean;
  Var
    objValDoc   : TValidarPedido;
    strTRVEPRBkp: String;
    objCdsXmlF4: TUniClientDataSet;
begin
  strTRVEPRBkp := VS_strTRVEPR;
  objValDoc := TValidarPedido.Create(Self);
  objCdsXmlF4 := TMargemLucro.fCriaEstruturaDadosMargemLucro;
  Try
    objCdsXmlF4.Data := fCalculaMargemLucro(False, -1, Nil, True, False);
    objCdsXmlF4.LogChanges := False;

    VS_strTRVEPR := '1';//Altera para validar como se estivesse configurado para travar item a item

    objValDoc.onProgresso := nil;
    objValDoc.onIgnorarCondicao := nil;
    objValDoc.onAtualizaPrecos := pAtualizaPrecosParaTrava;
    objValDoc.blnPedirSenha := False;
    objValDoc.blnValidarUnitarioIndividual := False;
    objValDoc.blnExecMontaMsgInterna := False;

    Result := objValDoc.fValidaUnitario;

    If objValDoc.objMsgMenCus.isEmpty Then
      Result := True;

    If (Not Result) And blnPedeSenha Then
      Result := fLiberouVendaAbaixoDoCusto(objValDoc.objMsgMenCus.fGetJsonObject.ToJson, objCdsXmlF4);
  Finally
    VS_strTRVEPR := strTRVEPRBkp;//Restaura a trava configurada originalmente
    FreeAndNil(objValDoc);
    FreeAndNil(objCdsXmlF4);
  End;
end;

