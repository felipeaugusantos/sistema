function TFatVenda.fEscolheEmpresaProducaoTinta(strIdePro: String): String;
  Var
    qryGen: TUniQuery;
    strEmpresasPfl: String;
    strEmpPflSel: String;
begin

  strEmpresasPfl := '';
  strEmpPflSel   := '';

  If (strIdePro = 'NOR') Or (strOprFlj <> 'S') Then
  Begin
    Result := IIF(fEmptyStr(Self.strEmp_TE),VS_strCodEmp,Self.strEmp_TE);
    Exit;
  End;

  If Not fCfgSis('ESCPRD', varBoolean) Then
  Begin
    Result := VS_strEmpPrd;
    Exit;
  End;

  Try
    qryGen := fCriaQuery(Self);
    qryGen.SQL.Text :=
      'SELECT EMP_CODEMP, EMP_NOMEMP FROM CADEMP WHERE EMP_TINDIS LIKE "%' + strIdePro + '_%" AND EMP_CODEMP <> ' + QuotedStr(VS_strCodEmp);

    qryGen.Open;

    If qryGen.RecordCount > 1 Then
    Begin
      qryGen.First;

      While Not qryGen.Eof Do
      Begin
        If fEmptyStr(strEmpresasPfl) then
          strEmpresasPfl := qryGen.FieldByName('EMP_CODEMP').AsString
        Else
          strEmpresasPfl := strEmpresasPfl + '_' + qryGen.FieldByName('EMP_CODEMP').AsString;

        qryGen.Next;
      End;

      strEmpresasPfl := strEmpresasPfl + '_';
      strEmpPflSel := fRetornaEmpresaProducaoTinta(strEmpresasPfl);
    End;

    If qryGen.RecordCount = 0 Then
    Begin
      fMensagem('ATENÇÃO', Format('Não existe empresa configurada para produzir tinta %s'#10#13'será considerada a empresa atual', [fRetornaNomeTinta(strIdePro)]), ['OK']);
      Result := VS_strCodEmp;
    End
    Else
    Begin
      If qryGen.RecordCount = 1 Then
        Result := qryGen.FieldbyName('EMP_CODEMP').AsString
      Else
        Result := strEmpPflSel;
    End;

  Finally
    FreeAndNil(qryGen);
  End;
end;

function TFatVenda.fEspGui(strEspDoc: String): Boolean;
const
  arrEspGui : Array[0..7] of String = ('PD', 'OR', 'NF', 'IF', 'FF', 'DV', 'TR', 'EP');
var
  i         : Integer;
  strESPGUI : String;
begin

  Result := False;
  strESPGUI := fCfgSis('ESPGUI', varString);

  If Not fEmptyStr(strEspDoc) Then
  Begin

    For i := Low(arrEspGui) To High(arrEspGui) Do
    Begin

      If (arrEspGui[i] = strEspDoc) Then
      Begin
        Result := (strESPGUI[i+1] = 'S');
        Break;
      End;

    End;

  End;

end;

function TFatVenda.fRetVolumes: Double;
  Var
    intContador: Integer;
Begin
  Result := 0;
  
  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    With arrMatItens[intContador] Do
    Begin
      If fEhItemServico(arrMatItens[intContador].strCodIte) Then
        Continue;

      If not blnExp_CX Then
        Result := Result + fCalcVolumes(strCodIte, fltQtdIte, fltEmbala)
    End;
  End;

  If (intQtd_Cx > 0) Then
    Result := Result + intQtd_Cx;
End;

function TFatVenda.fRetVolumesSepExc: Double;
  Var
    intContador: Integer;
Begin
  Result := 0;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    With arrMatItens[intContador] Do
    Begin
      If fEhItemServico(strCodIte) Then
        Continue;

      If Not blnSepExc Then
        Continue;

      If blnExp_CX Then
        Continue;

      Result := Result + fCalcVolumes(strCodIte, fltQtdIte, fltEmbala);
    End;
  End;

  If (intQtd_Cx > 0) Then
    Result := Result + intQtd_Cx;
End;

function TFatVenda.fGeraEstoqueBaixaOrdProEstrutura(item: TDadosFechamento): Boolean;
begin

  Result := False;

  //Prestcon
  If MatchStr(strOpcDoc, ['VN','CP']) And fEhVendaConcreto And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
    Result := True

  //JV Vidros
  Else If Assigned(objEstruturaVidros) And fEhItemVendaVidro(item.strCodIte) Then
    Result := True

  //Quando for entrega futura e o configurado para emitir entrega futura dos sub itens nao vamos gerar a ordem de producao
  Else If (item.strBxSbIt = 'S') And (item.strEntFut = 'S') And (fCfgSis('EFTEST') = '2') Then
    Result := False

  Else If (item.strBxSbIt = 'S') And (Not blnEmitirOrdemProdSubItensNoPedido) And (fCfgSis('BXSBIT', varString) = '3') And (Not (strOpcDoc = 'DV')) Then
    Result := True

  Else If (item.strBxSbIt = 'S') And blnEmitirOrdemProdSubItensNoPedido Then
    Result := True;

end;

function TFatVenda.fBaixaOrdemProducaoAutomaticamente(var item: TDadosFechamento): Boolean;
begin

  If Self.FFulfillment.EhOperacaoFulfillment Then
    Exit(True);

  if fTemOPBaixada(item) then
    Exit(False);

  Result := (Not blnEmitirOrdemProdSubItensNoPedido) Or
            ((blnEmitirOrdemProdSubItensNoPedido) And (fCfgSis('BXOPAT', varBoolean)) And ((fCfgSis('BXSBIT', varString) = '2') Or ((fCfgSis('BXSBIT', varString) = '3') And fEhMarketPlace)));
end;

function TFatVenda.fDeveGerarOrdProItemEstruturaProdutoNormal: Boolean;
begin
  Result := True;

  If Not Self.Fulfillment.EhOperacaoFulfillment Then
    Exit;

  Result := FulfillmentMovimentacaoEstoque(Self.strClaFis, strChaveAcesso, Self.Fulfillment.SiglaHubMarketPlace).MovimentaEstoqueExterno Or
            FulfillmentMovimentacaoEstoque(Self.strClaFis, strChaveAcesso, Self.Fulfillment.SiglaHubMarketPlace).MovimentaEstoqueFisico;
end;

function TFatVenda.fGerarOrdProItensEstrutura(var item: TDadosFechamento; blnBaixar: Boolean = True): Boolean;
  Var
    objOrdPro: TOrdPro;
begin

  Result := True;

  Try

    objOrdPro := TOrdPro.Create(Nil, True);

    pCarregarDadosFulfillment;
    objOrdPro.Fulfillment.CopyFrom(Self.Fulfillment);

    objOrdPro.pSetRecItemDadosFechamento(item);

    If Assigned(FobjEstruturaPersonalizada) And (FobjEstruturaPersonalizada.blnEstruturaFoiPersonalizada) Then
      objOrdPro.pSetObjEsttruturaPersonalizada(FobjEstruturaPersonalizada);

    objOrdPro.strClaFis := Self.strClaFis;
    objOrdPro.dtaDtaEnt := Self.dtaDtaEnt;

    objOrdPro.blnTransacao := False;
    item.blnGerOrd := False;

    {CASO NAO TENHA GERADO A ORDEM DE PRODUCAO - CRIA UMA NOVA, SENAO SOMENTE BAIXA}
    If fEmptyStr(item.strOrdPro) Then
    Begin
      {ATRIBUI AS VARIAVEIS}
      objOrdPro.strNumDoc := strNumDoc;
      objOrdPro.strEspDoc := strEspDoc;
      objOrdPro.strCodEmp := VS_strCodEmp;
      objOrdPro.strCodCli := strCodCli;
      objOrdPro.strEndEnt := strAutEnt;
      objOrdPro.strCodIte := item.strCodIte;
      objOrdPro.strQtdApr := FloatToStrF(item.fltQtdIte, ffFixed, 12, 4);
      objOrdPro.strQtdPro := '0.0';
      objOrdPro.strConfer := fRetNomVendRep(strLoginUsuarioLogado);

      If strEspDoc = 'PD' Then
      Begin
        objOrdPro.strDtaPro := DateToStr(Self.dtaPreVis);

        objOrdPro.strNumPed := strNumDoc;
        objOrdPro.strEspPed := strEspDoc;
        objOrdPro.strEmpPed := IIF(fEmptyStr(strPedEmp), VS_strCodEmp, strPedEmp);
      End
      Else
      Begin
        objOrdPro.strDtaPro := DateToStr(Self.VS_Date);
      End;

      objOrdPro.strDtaCad := DateToStr(Self.VS_Date);

      objOrdPro.strObs001 := 'GERADO PELO FATURAMENTO - ' + strOpcDoc;
      objOrdPro.strObs002 := 'DOCUMENTO: ' + strNumDoc + '-' + strEspDoc;

      {O campo "Obs. para Faturamento/Expedição" será copiado para a ordem de produção, mediante parâmetro!.}
      If fCfgSis('OBPDOP', varBoolean) Then
      Begin
        objOrdPro.strObs_PD := strMenExp +
                               strMenEx2 +
                               strMenEx3 +
                               strMenEx4;
      End;

      //Prestcon
      If MatchStr(strOpcDoc, ['VN','CP']) And fEhVendaConcreto And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
      Begin
        If (fCfgSis('TPNFCR') = PRESTCON) Then
          objOrdPro.pDefineQtdSubItens := pDefineQtdSubItemConcreto;
      End
      //JV Vidros
      Else If Assigned(objEstruturaVidros) And fEhItemVendaVidro(item.strCodIte) Then
      Begin
        objEstruturaVidros.pCarregarEstrutura(item.intAutInc);
        TSubItensVidroManager.pClonarSubItens(objEstruturaVidros.subItensEstrutura, objOrdPro.subItensEstruturaVidro);
      End;

      {GERA A ORDEM DE PRODUCAO}
      Result := objOrdPro.fInsereOrdemProducao;

      If Result Then
      Begin
        {ATRIBUI O NUMERO DA ORDEM DE PRODUCAO A MATRIZ DE ITENS PARA GRAVACAO NO MOVDET/X}
        item.strOrdPro := objOrdPro.strCodPro;
        item.blnGerOrd := True;
      End;
    End
    Else
    Begin
      objOrdPro.pAtualizarClienteEndEntrega(item.strOrdPro, strCodCli, strAutEnt);

      If (strEspDoc = 'PD') Then
        objOrdPro.pAtualizarDadosPedido(item.strOrdPro,
                                        strNumDoc,
                                        strEspDoc,
                                        IIF(fEmptyStr(strPedEmp),
                                            VS_strCodEmp,
                                            strPedEmp));
    End;

    If Result And blnBaixar Then
    Begin
      Result := objOrdPro.fCarregaOrdPro(item.strOrdPro);
      if Result then
      begin
        If (Pos(strOpcDoc, 'DV_PR_') > 0) And (fCfgSis('BXSBIT') = '2') Then
          Result := objOrdPro.fBaixaOrdProDV(fFormataFloat(item.fltQtdIte, 4), objOrdPro.strConfer)
        Else
          Result := objOrdPro.fBaixaOrdPro(fFormataFloat(item.fltQtdIte, 4), objOrdPro.strConfer, fGeraEstoqueBaixaOrdProEstrutura(item));

        if not Result then
          raise Exception.Create('Não foi possível baixar a ordem de produção ' + item.strOrdPro);
      end
      else
        raise Exception.Create('Não foi possível encontrar a ordem de produção ' + item.strOrdPro);
    End;

  Except
    On E: EBaixaOrdemProducao Do
      Raise EBaixaOrdemProducao.Create(E.Message);
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[TFatVenda.fGerarOrdProItensEstrutura]');
    End;
  End;

  {DESTROI A CLASSE ORDEM DE PRODUCAO}
  FreeAndNil(objOrdPro);

end;

function TFatVenda.fTabelasConfiguradasCorretamente(strIdePro,
  strCodAca: String): Boolean;
var
  strTabelasPre: string;
  intContador: Integer;
begin
  Result := True;

  strTabelasPre := fCfgSis('TABPRC');
  If Length(strTabelasPre) < 7 Then
    strTabelasPre := strTabelasPre + StringOfChar('N',7-Length(strTabelasPre));

  If ((strIdePro <> 'NOR') Or Not fEmptyStr(strCodAca)) And (Not fEmptyStr(Self.strTabTin)) Then
  Begin
    For intContador := 1 To Length(strTabelasPre) Do
    Begin
      If intContador = StrToInt(Self.strTabTin) Then
      Begin
        If (Not (strTabelasPre[intContador] = 'S')) Then
        Begin
          Result := False;
          Break;
        End;
      End;
    End;
  End;
end;

function TFatVenda.fTabelasTintasConfiguradasCorretamente: Boolean;
Var
  cdsVenTmp: TUniClientDataSet;
begin
  Result := True;

  If (fEmptyStr(Self.strTabTin)) Then
    Exit;

  cdsVenTmp := TUniClientDataSet.Create(Self);
  Try
    cdsVenTmp.Data := cdsVenda.Data;
    cdsVenTmp.Open;
    cdsVenTmp.LogChanges := False;
    cdsVenTmp.Filtered := False;
    cdsVenTmp.Filter := Format('(ITE_IDEPRO <> %s) OR (ITE_CODACA <> %s)', [QuotedStr('NOR'), QuotedStr('')]);
    cdsVenTmp.Filtered := True;
    cdsVenTmp.First;
    While Not cdsVenTmp.Eof Do
    Begin
      If Not fTabelasConfiguradasCorretamente(cdsVenTmp.FieldByName('ITE_IDEPRO').AsString,
                                              cdsVenTmp.FieldByName('ITE_CODACA').AsString) Then
      Begin
        Result := False;
        Break;
      End;

      cdsVenTmp.Next;
    End;
  Finally
    FreeAndNil(cdsVenTmp);
  End;
end;

