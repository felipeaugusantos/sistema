function TFatVenda.fTemItensNaoLiberadosParaExibirBaixaSeparacao: Boolean;
  Var
    item: TDadosFechamento;
begin
  Result := False;
  For item In arrMatItens Do
    If Not fItemLiberadoParaExibirBaixaSeparacao(item) Then
      Exit(True);
end;

function TFatVenda.fGeraNovoPedidoEntregaImediata(strOriF11_: String; strEmpCfg: String = ''): Boolean;
begin
  Result := (strOriF11_ = 'S') And
            (fEmptyStr(strNumOS)) And
            (fCfgSis('NPDF11', varBoolean, strEmpCfg)) And
            fTemItensEntregaImediata(Self.arrMatItens) And
            fGeraNovoPedidoF11EmpresaOrigem And
            (Not fSomenteItensDeServico(Self.arrMatItens));
end;

procedure TFatVenda.pDefineSeGeraNovoPedidoEntregaImediata(strEmpCfg: String);
begin
  blnEntregaImediataEmNovoPedido := fGeraNovoPedidoEntregaImediata(strOriF11, strEmpCfg);

  If blnEntregaImediataEmNovoPedido Then
  Begin
    Self.strEspDoc := 'PD';
    Self.blnPedBlo := False;//Novo pedido ja deve gravar liberado

    If not fCfgSis('TPFPED', varBoolean) then
    Begin
      If (Self.strTipPed = 'C') And Not fCfgSis('TPPDCX', VarBoolean, strEmpCfg) Then
        Self.strTipPed := 'A';

      If fLimparTipoDePedidoPoisSeraDefinidoNaExpedicao(strEmpCfg) Then
        Self.strTipPed := '';
    End
    Else
    Begin
      Self.strTipPed := fBuscaTipPed(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri);
    End;
  End;
end;

function TFatVenda.fEntregaImediataPorDataDeEntrega(strOriF11_: String = ''): Boolean;
begin
  If fEmptyStr(strOriF11_) Then
    strOriF11_ := Self.strOriF11;

  Result := (fCfgSis('PDVIME', varBoolean)) And
            (fGeraNovoPedidoEntregaImediata(strOriF11_));
end;

function TFatVenda.fEntregaImediataPorGrupoProdutos(strOriF11_: String = ''): Boolean;
begin
  If fEmptyStr(strOriF11_) Then
    strOriF11_ := Self.strOriF11;

  Result := fGeraNovoPedidoEntregaImediata(strOriF11_) And fCfgSis('DESMGP', varBoolean);
end;

function TFatVenda.fEntregaImediataPorDataDeEntregaComRotaPorPedido: Boolean;
begin
  Result := (fCfgSis('UGPDTE', varBoolean)) And
            (fSomenteItensEntregaImediata);
end;

function TFatVenda.fGetOrdemMaoObra: String;
begin
  result := fRetOrdemMaoObra(strNumDoc, strEspDoc, VS_strCodEmp);
end;

function TFatVenda.fGetIesUni: String;
begin
  result := fRetornaIesUni(strCodCli);
end;

function TFatVenda.fGeraNovoPedidoF11EmpresaOrigem: Boolean;
begin
  Result := True;

  If (fCfgSis('TOLF11', varBoolean)) Then
    Exit;

  If (Not fCfgSis('TOLF11', varBoolean) And (VS_strCodEmp = Self.strEmpOri)) Then
    Exit;

  Result := False;
end;

function TFatVenda.fGeraNovoPedidoRetiraMesmaLoja(strOriF11_: String; strEmpCfg: String = ''): Boolean;
begin
  Result := (strOriF11_ = 'S') And
            (fEmptyStr(strNumOS)) And
            (fCfgSis('NPLF11', varString, strEmpCfg) = 'S') And
            fTemItensRetira(Self.arrMatItens, opPropriaEmpresa) And
            (fCfgSis('NOTDES', varString, strEmpCfg) = 'N') And
            (Not fTemItensRetira(Self.arrMatItens, opPropriaEmpresa, opLocalRetiraCaixa)) And
            (fGeraNovoPedidoF11EmpresaOrigem) And
            (Not fSomenteItensDeServico(Self.arrMatItens));
end;

