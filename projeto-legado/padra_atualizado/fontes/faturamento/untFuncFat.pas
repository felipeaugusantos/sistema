       fEmptyStr(strCliCep) Or
       (****************************)
       (* NO F11 NAO PEDE TELEFONE *)
       (*************************LA*)
      // fEmptyStr(strCliTel) Or
       fEmptyStr(strCliCgc) Then
    Begin
      Result := False;
    End;
  End;
end;

function TFatVenda.fMaxDataCliRede(strCampo: String): TDate;
Var
  qryGenCli: TUniQuery;
  strSQL: String;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  MAX(' + strCampo + ') AS MAXDTA ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADCLI ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CLI_CODCLI = :CODCLI ';
  If fCfgSis('TRFTCR', varString) = '2' Then
  Begin
    strSQL := strSQL + ' OR CLI_CODRED =              ';
    strSQL := strSQL + ' (SELECT                      ';
    strSQL := strSQL + '    CLI_CODRED                ';
    strSQL := strSQL + '  FROM                        ';
    strSQL := strSQL + '    CADCLI                    ';
    strSQL := strSQL + '  WHERE CLI_CODCLI = :CODCLI) ';
  End;

  qryGenCli := fCriaQuery(Self);
  Try
    With qryGenCli Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      Result := FieldByName('MAXDTA').AsDateTime;
    End;
  Finally
    FreeAndNil(qryGenCli);
  End;
end;

