function TFatVenda.fTemNecessidadeDePassarNoCaixaParaDesmembrarPedido(): Boolean;
begin
  If (Not fConPagComEntrada(Self.strConPag)) And (Pos(Self.strCodFpg, '008_010_012_014_015_') > 0) Then
    Exit(False);

  Result := True;
end;

function TFatVenda.fItemLiberadoParaExibirBaixaSeparacao(const
  item: TDadosFechamento): Boolean;
begin
  Result := True;

  if FEhTelaAltItensPed then
  begin
    Result := IIF(item.strExibSE = 'S', True, False);
    Exit;
  end;

  If Not fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
    Exit;

  If (strEspDoc = 'PD') And (strOriF11 <> 'S') And (Not blnBaiEntFut) Then
  Begin
    //Na emissao do pedido somente retira caixa deve exibir na impressao e baixa da separacao
    If (item.strEntRet = 'R') And (item.strLocRet = 'C') Then
      Exit;

    //Se nao tem necessidade de passar pelo caixa entao o produto ja fica liberado na baixa e impressao da separacao
    If (Not FblnHaveraDesmembramentoRetiraCaixa) And
       (Not fConPagComEntrada(Self.strConPag)) And (Pos(Self.strCodFpg, '008_010_012_014_015_') > 0) Then
      Exit;

    // Se CFG_SEPVIS (Permitir imprimir a separação de pedidos à vista)
    // E
    //   pedido for a Vista
    // OU
    //   CFG_PRACHC e strCodFpg 002/006/007 (Cartão, Cheque)
    // entao o produto ja fica liberado na baixa e impressao da separacao
    if (fCfgSis('SEPVIS', varString) = 'S') and
    ((fStatusCndPag(self.strConPag) = A_VISTA) or
    ((Pos(Self.strCodFpg, '002_006_007_') > 0) and (fCfgSis('PRACHC', varString) = 'S'))) then
      Exit;

    Result := False;
  End;

end;

