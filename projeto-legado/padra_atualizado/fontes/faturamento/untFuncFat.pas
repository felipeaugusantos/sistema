begin
  objPgtOnlineApi := TPagamentoOnline.Create;
  try
    objPgtOnlineApi.strNumDoc := strNumDoc;
    objPgtOnlineApi.strEspDoc := strEspDoc;
    objPgtOnlineApi.strCodEmp := strCodEmp;

    Result := objPgtOnlineApi.fDocumentoPagamentoOnline;
  finally
    FreeAndNil(objPgtOnlineApi);
  end;
end;


class function TFatVenda.fValidaUtilizarPedidoOrcamento(ANumDoc, AEspDoc, ACodEmp, AOpcDoc: String; qryFatGor: TUniQuery; chkHerOrc: TCheckBox = nil): Boolean;
  Var
    blnJaFatu,
    blnJaBaix,
    blnSomenteServ,
    blnImpresso,
    blnSepImpresso   : Boolean;
    strNumRom        : String;
    strCodVen        : String;
    blnUsaPafEcf     : Boolean;
    blnLibPed        : Boolean;
    arrDocumentos    : TArrDocumentos;
    i                : Integer;
    strDocsFaturados : String;
    blnAdiantamento  : Boolean;
    recTotaisAdiantamento : TTotaisAdiantamento;
    objParametrosMensagem: TParametrosMensagem;
    objLiberacao     : TLiberacao;

  function fExecutandoFaturamentoAutomatico: Boolean;
  const
    FaturamentoAutomaticoMonitorExeParam = 'FATURAMENTO_AUTOMATICO';
  begin
    Result := SameText(ParamStr(1), FaturamentoAutomaticoMonitorExeParam);
  end;

  function fDocEmRomaneio: Boolean;
  begin
    strNumRom := '';
    If ((AOpcDoc = 'PD') Or fCfgSis('USPRRO', varBoolean)) And (Not fEmptyStr(ANumDoc)) Then
    Begin
      strNumRom := fDocumentoEmRomaneio(ANumDoc, AEspDoc);
    End;
    Result := Not fEmptyStr(strNumRom);
  end;

  function fRetDocsFaturados(strNumDoc, strEspDoc, strEmpDoc: String): TArrDocumentos;
  var
    qryAux : TUniQuery;
    strSQL : String;
  begin
    qryAux := fCriaQuery;
    try
      strSQL := '';
      strSQL := strSQL + 'SELECT        ';
      strSQL := strSQL + '  DISTINCT    ';
      strSQL := strSQL + '  FDO_NUMFAT AS NUMDOC, ';
      strSQL := strSQL + '  FDO_TIPFAT AS ESPDOC, ';
      strSQL := strSQL + '  FDO_EMPFAT AS CODEMP  ';
      strSQL := strSQL + 'FROM          ';
      strSQL := strSQL + '  FATDOR      ';
      strSQL := strSQL + 'WHERE         ';
      strSQL := strSQL + '  FDO_NUMDOC = :NUM AND ';
      strSQL := strSQL + '  FDO_ESPDOC = :ESP AND ';
      strSQL := strSQL + '  FDO_CODEMP = :EMP AND ';
      strSQL := strSQL + '  FDO_NUMFAT <> ""      ';
      strSQL := strSQL + 'UNION         ';
      strSQL := strSQL + 'SELECT        ';
      strSQL := strSQL + '  DISTINCT    ';
      strSQL := strSQL + '  DET_NUMDOC, ';
      strSQL := strSQL + '  DET_ESPDOC, ';
      strSQL := strSQL + '  DET_CODEMP  ';
      strSQL := strSQL + 'FROM          ';
      strSQL := strSQL + '  MOVDET      ';
      strSQL := strSQL + 'WHERE         ';
      strSQL := strSQL + '  DET_NUM_PD = :NUM AND ';
      strSQL := strSQL + '  DET_ESP_PD = :ESP AND ';
      strSQL := strSQL + '  DET_EMP_PD = :EMP     ';
      strSQL := strSQL + 'ORDER BY                ';
      strSQL := strSQL + '  NUMDOC                ';

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(strSQL);
      qryAux.ParamByName('NUM').AsString := strNumDoc;
      qryAux.ParamByName('ESP').AsString := strEspDoc;
      qryAux.ParamByName('EMP').AsString := strEmpDoc;
      qryAux.Open;

      if not qryAux.IsEmpty then
      begin

        SetLength(Result, 0);

        qryAux.First;
        while not qryAux.Eof do
        begin
          SetLength(Result, Length(Result)+1);
          Result[Length(Result)-1].strNumDoc := qryAux.FieldByName('NUMDOC').AsString;
          Result[Length(Result)-1].strEspDoc := qryAux.FieldByName('ESPDOC').AsString;
          Result[Length(Result)-1].strCodEmp := qryAux.FieldByName('CODEMP').AsString;
          qryAux.Next;
        end;
      end;

    finally
      FreeAndNil(qryAux);
    end;
  end;

  function fPermiteReabrirDocumentoFormulacao: Boolean;
  begin
    Result := (Not fEmptyStr(ANumDoc)) And (Pos(AOpcDoc, 'OR_PD_') > 0) And (fCfgSis('POPTIN') = 'G') And
              (fCfgSis('EXIDOC') <> 'V') And
              (fReabrirPedidoOrcamentoBaixado(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                              qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                              qryFatGor.FieldByName('FGO_CODEMP').AsString,
                                              qryFatGor.FieldByName('FGO_CODCLI').AsString));
  end;

  function fSelecionouHerancaOrcamento(): Boolean;
  begin
    Result := Assigned(chkHerOrc) And chkHerOrc.Checked;
  end;

  function fNaoPermiteAcessoAoOrcamento():Boolean;
  begin
    Result := (Not fEmptyStr(ANumDoc)) And
              (AEspDoc = 'OR') And
              (Not fVerificaAcessoSistema('VERORC')) And
              (strCodVen <> strLoginUsuarioLogado) And
              (Not fEmptyStr(strCodVen)) And
              (Not fExecutandoFaturamentoAutomatico) And
              (Pos(strCodVen, fGetVendedoresGerentesOrSUBGerentes()) <= 0);
  end;

  function fNaoPermiteAcessoAoPedido():Boolean;
  begin
    Result := (Not VS_AutoatendimentoPagueFacil) And
              (Not fEmptyStr(ANumDoc)) And
              (AEspDoc = 'PD') And
              (Not fVerificaAcessoSistema('VERPED')) And
              (strCodVen <> strLoginUsuarioLogado) And
              (Not fEmptyStr(strCodVen)) And
              (Not fExecutandoFaturamentoAutomatico) And
              (Pos(strCodVen, fGetVendedoresGerentesOrSUBGerentes()) <= 0);
  end;

begin
  Result := True;
  blnJaFatu := False;
  blnUsaPafEcf := fCfgSis('PAFECF', varBoolean);
  blnLibPed    := fValidaTravaISETAU(fCfgSis('LIBPED', varBoolean));

  objLiberacao := TLiberacao.Create;

  Try
    If fEmptyStr(AEspDoc) Then
    Begin
      If (Pos(AOpcDoc,'VN_VS_CS_ER') > 0) And (Not fEmptyStr(ANumDoc)) Then
      Begin
        fMensagem('', 'A espécie deve ser preenchida!', ['&O k']);
        Result := False;
      End;
    End
    Else If (Pos(AEspDoc, 'OR_PD_') <= 0) Then
    Begin
      fMensagem('ATENÇÃO!', 'A Espécie deve ser OR ou PD!', ['&O k']);
      Result := False;
    End
    Else If (Not fEmptyStr(ANumDoc))                                                 And
            (Not fDocumentoFatExiste(qryFatGor, ANumDoc, AEspDoc, ACodEmp, blnJaFatu, blnJaBaix, blnImpresso, strCodVen, blnSepImpresso, True)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Esse documento não está cadastrado!', ['&O k']);
      Result := False;
    End

    Else If (Not fEmptyStr(ANumDoc)) And (fCampoTabela('FGO_ORIGEM', 'FATGOR', ['FGO_NUMDOC',   'FGO_ESPDOC',   'FGO_CODEMP'],
                                                                                      [ANumDoc, AEspDoc, ACodEmp]) = 'AGRUPAMENTO') Then
    Begin
      fMensagem('', 'Pedido agrupado, utilizar o F11 do Resumo de Caixa!', ['&Ok']);
      Result := False;
    end
    else if blnJaBaix then
    begin
      strDocsFaturados := fCampoTabela('FGO_MOTBAI', 'FATGOR', ['FGO_NUMDOC',   'FGO_ESPDOC',   'FGO_CODEMP'],
                                                               [ANumDoc, AEspDoc, ACodEmp]);

      if fCfgSis('HERORC', varBoolean) And Assigned(chkHerOrc) then
      begin
        If (fMensagem('ATENÇÃO!', 'Este documento já foi baixado. ' + strDocsFaturados + sLineBreak +
                                  'Deseja carregar os itens para emissão de um novo documento?', ['',''], 2) = 1) Then
          chkHerOrc.Checked := True
        Else
          Result := False;
      end
      else
      begin
        fMensagem('ATENÇÃO!', 'Este documento já foi baixado. ' + strDocsFaturados, ['&Ok']);
        Result := False;
      end;
    end
    Else If (blnJaFatu) Then
    Begin

      if fCfgSis('HERORC', varBoolean) And Assigned(chkHerOrc) then
      begin

        strDocsFaturados := '';

        arrDocumentos := fRetDocsFaturados(ANumDoc, AEspDoc, ACodEmp);
        for i := 0 to Length(arrDocumentos) -1 do
        begin
          strDocsFaturados := strDocsFaturados + '- ' + arrDocumentos[i].strNumDoc + '-' +
                                                        arrDocumentos[i].strEspDoc + '-' +
                                                        arrDocumentos[i].strCodEmp + sLineBreak;
        end;

        If (fMensagem('ATENÇÃO!', 'Este documento já foi faturado no(s) documento(s): ' + sLineBreak + strDocsFaturados +
                                  'Deseja carregar os itens para emissão de um novo pedido?', ['',''], 2) = 1) Then
        Begin
          chkHerOrc.Checked := True;
        End
        Else
        Begin
          Result := False;
        End;

      end
      else
      begin
        fMensagem('ATENÇÃO!', 'Este documento já foi faturado!', ['&Ok']);
        Result := False;
      end;

    End

    Else If (AOpcDoc = 'OU') And ((fCfgSis('OUTPED', varString)) = 'N') And fPedidoOrcamentoExclusivoOutraLoja(ANumDoc, AEspDoc, ACodEmp) Then
    begin
      pMensagemOk('Não é permitido faturar Pedido/Orçamento comum (diferente de Entrega pelo CD, Transferência) de Outras Lojas!');
      Result := False;
    end

    Else If (blnUsaPafEcf) And (fDavPreVendaCadastrado(ANumDoc, AEspDoc, ACodEmp)) And (Pos(AOpcDoc, 'PD_OR_') <= 0) Then
    Begin
      pMensagemOk('Não é permitido faturar este documento pois o mesmo possui um DAV associado. Use o PDVCitel.');
      Result := False;
    End

    Else If Not fCfgSis('ALPDEX', VarBoolean) And fDocParcialmenteFat(ANumDoc, AEspDoc, ACodEmp) And (AOpcDoc <> 'VN') Then
    Begin
      fMensagem('ATENÇÃO!', 'Esse documento foi parcialmente faturado, por isso não é possível altera-lo!', ['&O k']);
      Result := False;
    end

    Else If fNaoPermiteAcessoAoOrcamento() Then
    Begin
      fMensagem('ATENÇÃO!', 'Acesso ao documento não permitido!', ['&O k']);
      Result := False;
    End

    Else If fNaoPermiteAcessoAoPedido() Then
    Begin
      fMensagem('ATENÇÃO!', 'Acesso ao documento não permitido!', ['&O k']);
      Result := False;
    End

    Else If (Not fEmptyStr(ANumDoc)) And (AEspDoc = 'PD') And  (fCadRecTrocaRecebimentoPendenteAlterada(ANumDoc, AEspDoc, ACodEmp)) Then
    Begin
      fMensagem('ATENÇÃO!', 'O Pedido possui Contas a Receber baixado total ou parcial, referente a pendências de recebimento da Venda a Base de Troca. Para prosseguir com a alteração do Pedido, estorne a duplicata.', ['&O k']);
      Result := False;
    End

    Else If (Not fSelecionouHerancaOrcamento) And (blnUsaPafEcf) And (Pos(AOpcDoc, 'OR_PD_') > 0) And (fDavPreVendaImpressoOuFaturado(ANumDoc, AEspDoc)) Then
    Begin
      Result := False;
    End

    Else If (qryFatGor.FieldByName('FGO_ENT_CD').AsString  = 'S') And
            (qryFatGor.FieldByName('FGO_ESPDOC').AsString  = 'PD') And
            (qryFatGor.FieldByName('FGO_EMP_CD').AsString <> VS_strCodEmp) And
            (fEmptyStr(qryFatGor.FieldByName('FGO_NUMPOK').AsString)) And
            ( not fCfgSis('LIB_CD', varBoolean) ) And
            (Not fSelecionouHerancaOrcamento) Then
    Begin
      If (fCfgSis('EMPFAT', varBoolean)) Then
        pMensagemSonora(
          'Este pedido é de faturamento pela loja ' + qryFatGor.FieldByName('FGO_EMP_CD').AsString +
          ' e desde sua gravação é de responsabilidade desta loja. ' +
          'Ele não pode mais ser alterado. Somente será possível realizar o cancelamento através '+
          'do menu de cancelamento de documentos. Entre em contato com o responsável na loja ' +
          qryFatGor.FieldByName('FGO_EMP_CD').AsString  + ' e confirme se ainda não foi faturado.')
      Else
        pMensagemSonora(
          'Este pedido é entrega pelo CD e desde sua gravação é de responsabilidade do CD. '+
          'Ele não pode mais ser alterado. Somente será possível realizar o cancelamento através '+
          'do menu de cancelamento de documentos. Entre em contato com o responsável pelo CD e '+
          'confirme se ainda não foi faturado.');

      Result := False;
    End

    Else If fDocEmRomaneio Then
    Begin
      If fCfgSis('USPRRO', varBoolean) Then
        fMensagem('ATENÇÃO!', 'O Pedido ' + ANumDoc + '-' + AEspDoc + '-' + ACodEmp + ' ' +
                              'já encontra-se no Romaneio ' + strNumRom + ', portanto ' +
                              'será permitido alterar os itens apenas pela expedição!', ['&Ok'])
      Else
        fMensagem('ATENÇÃO!', 'Esse pedido está associado ao(s) Romaneio(s): ' + strNumRom + '.' + #13#10 +
                              'Remova esse pedido do(s) romaneio(s) para poder alterá-lo!', ['&Ok']);
      Result := False;
    End

    Else If fPedidoBaixaEntregaFutura(ANumDoc, AEspDoc, ACodEmp) Then
    Begin
      If AOpcDoc = 'PD' Then
        fMensagem('ATENÇÃO!', 'Pedidos de Baixa de Entrega Futura não podem ser alterados!', ['&Ok'])
      Else
        fMensagem('ATENÇÃO!', 'Pedidos de Baixa de Entrega Futura devem ser faturados pela rotina de Expedição!', ['&Ok']);

      Result := False;
    End

    else if TYapayFacade.fPedidoPossuiCobrancaAtiva(ANumDoc, AEspDoc, ACodEmp) then
    begin
      objParametrosMensagem := TParametrosMensagem.Create;
      try
        objParametrosMensagem.Titulo := 'Yapay';
        objParametrosMensagem.Texto := 'Pedido possui Cobrança Yapay ativa!';
        objParametrosMensagem.Opcoes := ['&OK'];
        objParametrosMensagem.Url.Caption := 'Visualizar cobrança';
        objParametrosMensagem.Url.Href :=
          TYapayFacade.fLinkPagamento(TYapayFacade.fGetAutIncFatGor(ANumDoc, AEspDoc, ACodEmp));
        fMensagem(objParametrosMensagem);
      finally
        objParametrosMensagem.Free;
      end;
      Result := False;
      exit;
    end

    Else If (AOpcDoc = 'PD') and
            (TFacadeCobrancaEletronica.fExisteCobrancaEletronica(ANumDoc, AOpcDoc, ACodEmp, tcPagarMe, True)) then
    begin
      objParametrosMensagem := TParametrosMensagem.Create;
      try
        objParametrosMensagem.Titulo := 'Pagar.me';
        objParametrosMensagem.Texto := 'Pedido possui Cobrança Pagar.me ativa!';
        objParametrosMensagem.Opcoes := ['&OK'];
        fMensagem(objParametrosMensagem);
      finally
        objParametrosMensagem.Free;
      end;
      Result := False;
      exit;
    end

    Else If (blnLibPed) And (SameText(AEspDoc, 'PD')) And (AOpcDoc <> 'PD') And
            (Not fEmptyStr(ANumDoc)) And (Not fPedLiberado(ANumDoc, ACodEmp)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Esse pedido não foi liberado para faturar!', ['&O k']);
      Result := False;
    End

    Else If (AOpcDoc = 'PD') And //Nao permite alterar pedido com contas a receber quitado

            (Not fEmptyStr(ANumDoc)) And (SameText(AEspDoc, 'PD')) And

            ((TFatVenda.fTotalDuplicataQuitada(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                               qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                               qryFatGor.FieldByName('FGO_CODEMP').AsString,
                                               qryFatGor.FieldByName('FGO_CODCLI').AsString) > 0) Or
             ((fDocParcialmenteFat(ANumDoc, AEspDoc, ACodEmp)) And (Not fLiberarPedidoParaQualquerAlteracao(qryFatGor.FieldByName('FGO_CONPAG').AsString,
                                                                                                                            qryFatGor.FieldByName('FGO_CODFPG').AsString)))) Then
    Begin
      Result := False;

      If (fCfgSis('GERCRE', varBoolean)) And
         (qryFatGor.FieldByName('FGO_ENT_CD').AsString <> 'S') Then
      Begin
        If (fMensagem('ATENÇÃO!', 'Não é permitido alterar um pedido ' +
                      'que possua contas a receber quitado ou ' + sLineBreak +
                      'um pedido parcialmente faturado!' + sLineBreak +
                      'Deseja apenas alterar a quantidade ' +
                      'de algum item deste pedido?', ['',''], 2) = 1) Then
        Begin
          If fBloqueiaPedido(qryFatGor) Then
          Begin
            pAlterarQuantidadeItensPedido(qryFatGor);
            pLiberaBloqueioPedido(qryFatGor);
          End;
        End;
      End
      Else
        fMensagem('ATENÇÃO!', 'Não é permitido alterar um pedido ' +
                  IIF(qryFatGor.FieldByName('FGO_ENT_CD').AsString  = 'S', 'CD ', '') +
                  'que possua contas a receber quitado!', ['&OK']);
    End;

    If (fCfgSis('UTIFNS', varBoolean)) And (AOpcDoc = 'PD') And (Not fEmptyStr(ANumDoc)) Then
    Begin
      If (fTemFatorServico(ANumDoc, AOpcDoc, ACodEmp)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse pedido já tem fator de serviço informado e não pode ser alterado!', ['&O k']);
        Result := False; 
        Exit;       
      End;
    End;

    {Valida se "Pode" / "Não Pode" alterar pedido com adiantamento}
    recTotaisAdiantamento := TAdiantamento.fGetTotaisAdiantamento(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                                  qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                                                  qryFatGor.FieldByName('FGO_CODEMP').AsString);
    blnAdiantamento := False;

    {1º Tem adiantamento}
    If ((recTotaisAdiantamento.blnExiAdt) And (recTotaisAdiantamento.fltValLan > 0)) Then
      blnAdiantamento := True;

    {2º Tem adiantamento em crédito}
    If ((recTotaisAdiantamento.blnExiAdt) And (recTotaisAdiantamento.fltValLan = 0) And (TAdiantamento.fAdiantamentoPossuiDebitos(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                                                                                                  qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                                                                                                                  qryFatGor.FieldByName('FGO_CODEMP').AsString,
                                                                                                                                  qryFatGor.FieldByName('FGO_CODCLI').AsString))) Then
      blnAdiantamento := True;

    If (AOpcDoc = 'PD') And
       (Not fEmptyStr(ANumDoc)) And (SameText(AEspDoc, 'PD')) And
       (TAdiantamento.fPermiteAlterarPedidoComAdiantamento <> papSimTodosOsCampos) And
       (TAdiantamento.fPermiteAlterarPedidoComAdiantamento <> papSimTodosOsCamposComExigenciaQueOValorFiqueOMesmo) And
       (blnAdiantamento) Then
    Begin

      Result := False;

      If (qryFatGor.FieldByName('FGO_ENT_CD').AsString <> 'S') Then
      Begin
        If (TAdiantamento.fPermiteAlterarPedidoComAdiantamento = papSimSomenteReduzindoAQuantidadeOuEliminandoProdutos) Then
        Begin

          If (qryFatGor.FieldByName('FGO_TIPREC').AsString = 'ALPE') or (qryFatGor.FieldByName('FGO_TIPREC').AsString = 'ALPEF') Then
            fMensagem('ATENÇÃO!', 'O pedido '+qryFatGor.FieldByName('FGO_NUMDOC').AsString+'-'+qryFatGor.FieldByName('FGO_ESPDOC').AsString+
                                  ' já possui adiantamento gerado pela Alpe. Sendo assim, sua alteração não é permitida. '+
                                  'Se for necessário, cancele o pedido e refaça o processo.', ['&OK'])
          Else If TLinkPagamentoCitelFornecedores.fEhLinkPagamentoCitel(qryFatGor.FieldByName('FGO_TIPREC').AsString) Then
            fMensagem('ATENÇÃO!', 'O pedido '+qryFatGor.FieldByName('FGO_NUMDOC').AsString+'-'+qryFatGor.FieldByName('FGO_ESPDOC').AsString+
                                  ' já possui adiantamento gerado pelo Link Pagamentos Citel. Sendo assim, sua alteração não é permitida. '+
                                  'Se for necessário, cancele o pedido e refaça o processo.', ['&OK'])
          Else
          If (fMensagem('ATENÇÃO!', 'Não é permitido alterar um pedido ' +
                        'que possua adiantamento de cliente!' + #13#10 +
                        'Deseja apenas alterar a quantidade ' +
                        'de algum item deste pedido?', ['',''], 2) = 1) Then
          Begin
            if (not fVerificaAcessoSistema('ALPDAD')) and (not fLiberaAlteracaoPedidoComAdiantamento(qryFatGor, recTotaisAdiantamento.fltValLan)) then
              fMensagem('ATENÇÃO!', 'Usuário sem direito para alterar um pedido' + #13 +'que possua adiantamento de cliente!', ['&OK'])
            else
            If fBloqueiaPedido(qryFatGor) Then
            Begin
              pAlterarQuantidadeItensPedido(qryFatGor);
              pLiberaBloqueioPedido(qryFatGor);
            End;
          End;

        End
        Else
        If (TAdiantamento.fPermiteAlterarPedidoComAdiantamento = papNaoNenhumaInformacao) Then
        Begin
          fMensagem('ATENÇÃO!', 'Não é permitido alterar um pedido que possua adiantamento de cliente!', ['&OK']);
        End;

      End
      Else
      Begin
        fMensagem('ATENÇÃO!', 'Não é permitido alterar um pedido de entrega ' + 'pelo CD que possua adiantamento de cliente!', ['&OK']);
      End;

    End
    Else If (Result) And
            (AOpcDoc = 'PD') And
            (Not fEmptyStr(ANumDoc)) And (SameText(AEspDoc, 'PD')) And
            (blnAdiantamento) and (not fVerificaAcessoSistema('ALPDAD')) Then
    Begin
      Result := fLiberaAlteracaoPedidoComAdiantamento(qryFatGor, recTotaisAdiantamento.fltValLan);
    End

    Else If (Not fSelecionouHerancaOrcamento) And
            (Not fEmptyStr(ANumDoc)) And
            (Not fPermiteReabrirDocumentoFormulacao) And
            (Pos(AOpcDoc, 'OR_PD_') > 0) And (fPedidoOrcamentoFormulacaoJaBaixada(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                                                  qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                                                                  qryFatGor.FieldByName('FGO_CODEMP').AsString,
                                                                                  qryFatGor.FieldByName('FGO_CODCLI').AsString)) And
            (Not fCfgSis('ALTTIF', varBoolean)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Existe formulação já baixada nesse ' + IIF(AOpcDoc = 'OR','Orçamento','Pedido') + ' !' + #13#10 +
                            'Para alterar o ' + IIF(AOpcDoc = 'OR','Orçamento','Pedido') + ' será necessário,' + #13#10 +
                            'desmarcar a baixa da formulação na formulação de tinta de máquina', ['&Ok']);
      Result := False;
    End
    Else If (Pos(AOpcDoc, 'PD_OR_VN_CP_') <= 0) And
            (fPedidoPossuiBrindes(ANumDoc, AEspDoc, ACodEmp)) Then
    Begin
      fMensagem('', 'Para faturar documentos com brindes é necessário utilizar o F11 do Resumo de Caixa!', ['&Ok']);
      Result := False;
    End
    Else If (Not fEmptyStr(ANumDoc))     And
            (Pos(AOpcDoc, 'OR_PD_') > 0)      And
            (TLinkPagamentoCitelCfg.fLinkPagamentoCitelLigado) And
            (fPedidoPossuiLinkPagamento(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                        qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                        qryFatGor.FieldByName('FGO_CODEMP').AsString)) Then
    Begin
      fMensagem('', 'Não é possível editar pedidos que tenham link de pagamento online associado!', ['&Ok']);
      Result := False;
    End;

    If Result And (AOpcDoc = 'PD') And (Not fEmptyStr(ANumDoc)) And fUsaRotinaWMS And (Not fSelecionouHerancaOrcamento) And
                  (strToIntDef(fSelecionaStatusSepImp(ANumDoc, AEspDoc, ACodEmp), 0) > 0) Then //Separacao ja impressa
    Begin
      If fCfgSis('EDIWMS', varBoolean) Then
        fMensagem('ATENÇÃO!', 'A separação de estoque deste pedido já foi impressa portanto será solicitado a senha de liberação antes de gravar as alterações!', ['&Ok'])
      Else
      Begin
        fMensagem('ATENÇÃO!', 'A separação de estoque deste pedido já foi impressa portanto não é possível alterá-lo!', ['&Ok']);
        Result := False;
      End
    End;

    {Liberação de Pedidos Externos}
    If Result And (SameText(AEspDoc, 'PD')) And (AOpcDoc <> 'PD') And
                  (Not fEmptyStr(ANumDoc)) And fCfgSis('LIBEXT', varBoolean) Then
    Begin

      If TLibExt.fPedidoTemOrigemExterna(ANumDoc, AEspDoc, ACodEmp) Then
      Begin
        If Not TLibExt.fPedidoDeOrigemExternaEstaLiberado(ANumDoc, AEspDoc, ACodEmp) Then
        Begin
          fMensagem('ATENÇÃO!', 'Esse pedido não foi liberado para faturar, aguardando "Liberação de Pedidos Externos"!', ['&Ok']);
          Result := False;
        End;
      End;

    End;

    If Result And (Not fEmptyStr(ANumDoc)) And (SameText(AEspDoc, 'PD')) And (AOpcDoc = 'VN') Then
    Begin
      {*********************************************************************************************************************}
      {* SE CONFIGURADO QUE TRAVA AS FORMAS DE PAGAMENTO NEGOCIADAS NO CAIXA E FOI INFORMADO VARIAS MODALIDADES E          *}
      {* SE CONFIGURADO QUE GERA UM NOVO PEDIDO DE ENTREGA IMEDIATA NO F11 E O PEDIDO POSSUI ITENS DE ENTREGA IMEDIATA E   *}
      {* SE O PEDIDO NAO FOI ORIGINADO PELO F11 DO RESUMO DE CAIXA, NAO PERMITE FATURAR O MESMO ANTES DE PASSAR PELO CAIXA *}
      {*********************************************************************************************************************}
      If fCfgSis('TFPF11', VarBoolean) And (qryFatGor.FieldByName('FGO_CODFPG').AsString = '009') And
         fCfgSis('NPDF11', VarBoolean) And (fPedidoPossuiItensEntregaImediata(ANumDoc, AEspDoc, ACodEmp)) And
         (Not fPedidoOriginadoOutroPedidoPeloF11Caixa(ANumDoc, ACodEmp)) Then
      Begin
        fMensagem('','Este pedido possui formas de pagamento negociadas e deve ser faturado pelo F11 do Resumo de Caixa!',['&OK']);
        Result := False;
      End;

      If fCfgSis('TFPF11', VarBoolean) And (qryFatGor.FieldByName('FGO_CODFPG').AsString = '009') And
         fCfgSis('NPRF11', VarBoolean) And (fPedidoPossuiItensRetira(ANumDoc, AEspDoc, ACodEmp)) And
         (Not fPedidoOriginadoOutroPedidoPeloF11Caixa(ANumDoc, ACodEmp)) Then
      Begin
        fMensagem('','Este pedido possui formas de pagamento negociadas e deve ser faturado pelo F11 do Resumo de Caixa!',['&OK']);
        Result := False;
      End;

      If fCfgSis('TFPF11', VarBoolean) And (qryFatGor.FieldByName('FGO_CODFPG').AsString = '009') And
         fCfgSis('NPLF11', VarBoolean) And (fPedidoPossuiItensRetira(ANumDoc, AEspDoc, ACodEmp)) And
         (Not fPedidoOriginadoOutroPedidoPeloF11Caixa(ANumDoc, ACodEmp)) Then
      Begin
        fMensagem('','Este pedido possui formas de pagamento negociadas e deve ser faturado pelo F11 do Resumo de Caixa!',['&OK']);
        Result := False;
      End;

      If fCfgSis('TFPF11', VarBoolean) And (qryFatGor.FieldByName('FGO_CODFPG').AsString = '009') And
         fCfgSis('LOCRET', VarBoolean) And (fPedidoPossuiItensRetira(ANumDoc, AEspDoc, ACodEmp)) And
         (Not fPedidoOriginadoOutroPedidoPeloF11Caixa(ANumDoc, ACodEmp)) Then
      Begin
        fMensagem('','Este pedido possui formas de pagamento negociadas e deve ser faturado pelo F11 do Resumo de Caixa!',['&OK']);
        Result := False;
      End;
    End;

    {**********************************************}
    {* CASO NAO PERMITA ALTERAR PEDIDOS IMPRESSOS *}
    {*******************************************JC*}
    If Result And (Not fCfgSis('ALTPDI', varBoolean)) And (blnImpresso)  And
                  (AOpcDoc = 'PD') And (Not fEmptyStr(ANumDoc)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Esse pedido já foi impresso portanto não é possível alterá-lo!', ['&Ok']);

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Esse pedido já foi impresso portanto não é possível alterá-lo!');
      objLiberacao.objMsgLibera.pAddTextoCaption('Pedido'   ,  qryFatGor.FieldByName('FGO_NUMDOC').AsString + '-' +
                                                               qryFatGor.FieldByName('FGO_ESPDOC').AsString + '-' +
                                                               qryFatGor.FieldByName('FGO_CODEMP').AsString                                                                         , 7 );
      objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  ,  qryFatGor.FieldByName('FGO_CODCLI').AsString + '-' +
                                                               fRetNomCliente(qryFatGor.FieldByName('FGO_CODCLI').AsString)                                                         , 7 );

      objLiberacao.strDirAce := 'ALTPDI';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.blnSempreVariavelUsuario := True;

      If objLiberacao.fLibera Then
      Begin
        Result := True;
      End
      Else
      Begin
        Result := False;
      End;
    End;

    {***********************************************************}
    {* CASO NAO PERMITA ALTERAR PEDIDOS COM SEPARAÇÃO IMPRESSA *}
    {********************************************************MM*}
    If Result And (blnSepImpresso) And (AOpcDoc = 'PD') And (Not fEmptyStr(ANumDoc)) And (Not fSelecionouHerancaOrcamento) Then
    Begin
      If fImpressaoParcialConsiderandoJaImpresso Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é possível alterar esse pedido, pois a separação já foi impressa!', ['&Ok']);
        Result := False;
      End
      Else If (fCfgSis('ALTPDS') = 'N') Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é possível alterar esse pedido, pois a separação já foi impressa!', ['&Ok']);

        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Não é possível alterar esse pedido, pois a separação já foi impressa!');
        objLiberacao.objMsgLibera.pAddTextoCaption('Pedido'   ,  qryFatGor.FieldByName('FGO_NUMDOC').AsString + '-' +
                                                                 qryFatGor.FieldByName('FGO_ESPDOC').AsString + '-' +
                                                                 qryFatGor.FieldByName('FGO_CODEMP').AsString                                                                         , 7 );
        objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  ,  qryFatGor.FieldByName('FGO_CODCLI').AsString + '-' +
                                                                 fRetNomCliente(qryFatGor.FieldByName('FGO_CODCLI').AsString)                                                         , 7 );

        objLiberacao.strDirAce := 'ALTPDS';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;
        objLiberacao.blnSempreVariavelUsuario := True;

        Result := objLiberacao.fLibera;
      End
      Else If (fCfgSis('ALTPDS') = 'C') And
              (qryFatGor.FieldByName('FGO_ENT_CD').AsString = 'S') And
              (qryFatGor.FieldByName('FGO_ESPDOC').AsString = 'PD') And
              (qryFatGor.FieldByName('FGO_EMP_CD').AsString <> VS_strCodEmp) Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é possível alterar, pois este pedido é entrega '
                            + 'pelo CD e a separação já foi impressa. '
                            + 'Somente será possível realizar alteração após limpar separação. '
                            + 'Entre em contato com o responsável pelo CD.', ['&Ok']);
        Result := False;
      End;
    End;

    {***********************************************************}
    {* CASO NAO PERMITA ALTERAR PEDIDOS COM ORDEM DE PRODUÇÃO  *}
    {* DE PRODUTOS TINTOMÉTRICOS IMPRESSA                      *}
    {********************************************************MM*}
    If Result And
      (Not fEmptyStr(ANumDoc)) And
      (VS_strUsaTmq = 'S')  And
      (Not fCfgSis('ALTPDT', varBoolean)) And
      (fTemProdutoTintometrico(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                               qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                               qryFatGor.FieldByName('FGO_CODCLI').AsString,
                               qryFatGor.FieldByName('FGO_CODEMP').AsString)) And
      (fTemOrdemProducaoTintaImpresso(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                      qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                      qryFatGor.FieldByName('FGO_CODCLI').AsString,
                                      qryFatGor.FieldByName('FGO_CODEMP').AsString)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é possível alterar esse pedido, ' + #13 +
                            'pois a ordem de produção de produtos tintométricos já foi impressa!', ['&Ok']);

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Não é possível alterar esse pedido, pois a ordem de produção de produtos tintométricos já foi impressa!');

      objLiberacao.objMsgLibera.pAddTextoCaption('Pedido'   ,  qryFatGor.FieldByName('FGO_NUMDOC').AsString + '-' +
                                                               qryFatGor.FieldByName('FGO_ESPDOC').AsString + '-' +
                                                               qryFatGor.FieldByName('FGO_CODEMP').AsString                                                                         , 7 );
      objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  ,  qryFatGor.FieldByName('FGO_CODCLI').AsString + '-' +
                                                               fRetNomCliente(qryFatGor.FieldByName('FGO_CODCLI').AsString)                                                         , 7 );

      objLiberacao.strDirAce := 'ALTPDT';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.blnSempreVariavelUsuario := True;

      If objLiberacao.fLibera Then
      Begin
        Result := True;
      End
      Else
      Begin
        Result := False;
      End;
    End;

    {*******************************************}
    {* CASO TENHA EFETUADO AS VALIDACAOES ACIMA*}
    {* E ESTAJA TUDO OK E USE NOTA DE SERVICO  *}
    {****************************************JC*}
    If Result And (Not fEmptyStr(ANumDoc)) And fCfgSis('USASER',varBoolean) And (fCfgSis('TIPNFS') = '2') Then
    Begin

      If fDocumentoPossuiServicos(ANumDoc, AEspDoc, ACodEmp, blnSomenteServ) Then
      Begin
        If SameText(AOpcDoc, 'VS') And (Not blnSomenteServ) Then
        Begin
          fMensagem('','Somente é permitido carregar documento que possua apenas serviços!', ['&OK']);
          Result := False;
        End
        Else If Pos(AOpcDoc, 'VS_PD_OR_') <= 0 Then
        Begin
          fMensagem('','Somente é permitido carregar documento que não possua serviços!', ['&OK']);
          Result := False;
        End;
      End
      Else If (AOpcDoc = 'VS') Then
      Begin
        fMensagem('','Somente é permitido carregar documento que possua apenas serviços!', ['&OK']);
        Result := False;
      End;

    End;

    {*****************************************************************************}
    {* VERIFICA SE O TINDOR ESTA EM PROCESSAMENTO, SE POSITIVO ENTAO NAO PERMITE *}
    {* ALTERAR O PEDIDO                                                          *}
    {**************************************************************************AC*}
    If Result And (VS_strUsaTmq = 'S')  And (Not fEmptyStr(ANumDoc)) And
      (Pos(AOpcDoc, 'OR_PD_') > 0) Then
    Begin
      If fFormulacaoEmProcessamento(qryFatGor) Then
      Begin
        fMensagem('ATENÇÃO!', 'Uma ou mais tinta de máquina desse documento: ' + qryFatGor.FieldByName('FGO_NUMDOC').AsString + '-'
                                                                               + qryFatGor.FieldByName('FGO_ESPDOC').AsString + ',' + #13#10 +
                              'estão em processamento na tela de formulação de tinta de máquina, ' + #13#10 +
                              'por isso o documento não poderá ser alterado.', ['OK']);
        Result := False;
      End;
    End;

    If qryFatGor.FindField('FGO_EMP_TE') <> NIL Then
    Begin
      If (Not fEmptyStr(qryFatGor.FieldByName('FGO_EMP_TE').AsString)) And
              (qryFatGor.FieldByName('FGO_EMP_TE').AsString <> VS_strCodEmp) And
              (Pos(AOpcDoc, 'OU_' ) > 0) And
              (Result) Then
      Begin
        fMensagem('ATENÇÃO!', 'O documento '+ANumDoc+'-'+AEspDoc+' deve ser faturado pela empresa: ' + qryFatGor.FieldByName('FGO_EMP_TE').AsString, ['&O k']);
        Result := False;
      End;
    End;

  Finally
    FreeAndNil(objLiberacao);
  End;

end;

function TFatVenda.fValidaValorMinimoVendaPrazo(strConPagAux: String): Boolean;
  Var
    objLiberacao : TLiberacao;
begin
  Result := True;
  If (fCfgSis('MINPRZ', varBoolean)) Then
  Begin
    If (fStatusCndPag(IIF(fEmptyStr(strConPagAux), Self.strConPag, strConPagAux)) = A_PRAZO) And
       (Self.fltTotGer > 0.0) And (Self.fltTotGer < fCfgSis('VRMIPR', varDouble)) Then
    Begin
      objLiberacao := TLiberacao.Create;
      try
        objLiberacao.objMsgLibera.pAddTexto('O valor R$' + FloatToStrF(Self.fltTotGer, ffFixed, 12, 2) +
                                            ' é menor que o mínimo permitido para venda a prazo: R$' +
                                            FloatToStrF(fCfgSis('VRMIPR', varDouble), ffFixed, 12, 2));

        objLiberacao.strDirAce := 'VLRMIN';
        objLiberacao.strSenLib := fCfgSis('VLRMIN');
        objLiberacao.strMsgSen := 'Valor mínimo a prazo';
        objLiberacao.strCodOpe := Self.strCodVen;
        objLiberacao.strCodDig := Self.strCodDig;
        objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliOri;
        objLiberacao.strCpfCnpj := Self.strCliCgc;

        Result := fFatMensagemLiberacao(objLiberacao);
      finally
        FreeAndNil(objLiberacao);
      end;
    End;
  End;
end;

function TFatVenda.fGerarCTR_CI: Boolean;
  Var
    qryGenTmp : TUniQuery;
Begin
  If Not fTabelaExiste(strTabelaConfMi) Then
  Begin
    Result := False;
    Exit;
  End;

  qryGenTmp := fCriaQuery;

  With qryGenTmp Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('SELECT             ');
    SQL.Add('  COUNT(*) AS QTD  ');
    SQL.Add('FROM               ');
    SQL.Add(   strTabelaConfMi   );
    SQL.Add('WHERE              ');
    SQL.Add('  TMP_GCTRCI = "T" ');
    Open;

    Result := (FieldByName('QTD').AsInteger > 0);

  End;

  FreeAndNil(qryGenTmp);
End;

Procedure TFatVenda.pFatVendaToEndereco;
Begin
  objEndEnt.recEndere.strIncrem := Self.strAutEnt;
  objEndEnt.recEndere.strCodCli := Self.strCodCli;
End;

procedure TFatVenda.pZeraFreteSugerido;
begin
  fltFreSug := 0.00;
  fltFreSugCal := 0.00;
end;

Function TFatVenda.fSalvaEnderecoEntrega(strEntFatP: String = ''): Boolean;
begin
  If fEmptyStr(strEntFatP) Then
    strEntFatP := strEntFat;

  Result := (strEntFat = 'S') Or
            (blnUsaEndEntregaServicosPedidoOrcamento) Or
            (blnPedeEndEntregaServicos And blnDocumentoTemServicos) Or
            ((Pos(strEspDoc, 'PD_OR_') > 0)  And fTemEntregaFutura) Or
            ((Pos(strEspDoc, 'PD_OR_') <= 0) And (strEntFut = 'S'));
end;

Function TFatVenda.fSelecionaEnderecoEntrega(blnFormataCep: Boolean = False;
                                             blnNomeCidade: Boolean = False): Boolean;
Begin
  If Not fEmptyStr(objFazenda.strCodFaz) And fCfgSis('CADFAZ', VarBoolean) Then
  Begin
    pLimparEnderecoEntrega;
    pEnderecoToFatVenda;
    Result := True;
    Exit;
  End;

  strAutEnt := objEndEnt.fRestauraEnderecoEntrega(strAutEnt);

  If fSalvaEnderecoEntrega Or fImprimeEndEntregaItensRetira Then
  Begin

    pFatVendaToEndereco;
    Result := objEndEnt.fSelecionaEnderecoEntrega(strCodCli, blnFormataCep, blnNomeCidade, strEspDoc);

    If Result And SelecionouEndEntComUFDifDoPedidoConf Then
    Begin
      Result := false;
      Exit;
    End;

    {*REQ.164501**********RP*}
    If Result Then
      pSetaVendaPresencialParaClienteForaDoEstadoMedianteCFG;

    If Result And EhClienteDifalComEntregaDentroDoEstado(True) Then
    Begin
      Result := false;
      Exit;
    End;

    If fBloqueiaTrocaDeEnderecoParaPrecoDeVendaComDifal Then
    Begin
      Self.opeAlterouUFEntrega := fRecalcularDIFAL;

      If (Self.opeAlterouUFEntrega = opAbortarOperacao) Then
      Begin
        Result := false;
        Exit;
      End;
    End;

    pEnderecoToFatVenda;

  End
  Else
  Begin
    (************************************************************)
    (* QUANDO NAO FOR ENTREGA FUTURA E NAO FOR GERAR ROMANEIO   *)
    (* NAO VAI GRAVAR O ENDEREÇO DE ENTREGA                     *)
    (*********************************************************LA*)
    If (blnSalvaEnderecoEntrega) And
       ((Pos(strEspDoc, 'PD_OR_') <= 0) And (strEntFut = 'N')) Then
    Begin
      objEndEnt.pSalvaEnderecoEntrega(strAutEnt);
    End;

    pSetaVendaPresencialParaClienteForaDoEstadoMedianteCFG;

    pLimparEnderecoEntrega;

    If (Not blnSalvaEnderecoEntrega) Then
    Begin
      objEndEnt.recEndere.blnAltera := True;
      pEnderecoToFatVenda;
    End;

    Result := True;

  End;
End;

function fServicoPendenteAutoCenter(strCodEmp,
  strNumDoc, strEspCfo: String): Boolean;
  Var
    qryPed: TUniQuery;
begin
  Result := False;

  If Not fCfgSis('AUTCEN', varBoolean) Then
    Exit;

  If fCfgSis('ACOSER') = '2' Then
    Exit;

  If strEspCfo <> 'PD' Then
    Exit;

  qryPed := fCriaQuery;
  Try
    pSQL(qryPed, repServicos, 'SERVICO_PENDENTE', [strCodEmp, strNumDoc]);
    qryPed.Open;

    Result := qryPed.Fields[0].AsInteger > 0;
  Finally
    FreeAndNil(qryPed);
  End;
end;

function TFatVenda.fPossuiServico: Boolean;
  Var
    intSer: Integer;
begin
  Result := False;

  For intSer := 1 To 30 Do
    If (GetPropValue(Self, 'strCodS' + fStrZero(intSer.ToString, 2)) <> '') Then
    Begin
      Result := True;
      Break;
    End;
end;

Function TFatVenda.fPossuiSoEnderecoPadrao: Boolean;
  Var
    qryGen : TUniQuery;
Begin
  Result := False;
  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Text:=
           ' SELECT           '+
           '  COUNT(*) AS QTD '+
           ' FROM ENTCLI      '+
           ' WHERE ETC_CODCLI = :CODCLI';

      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      If Not IsEmpty Then
        Result := (FieldByName('QTD').AsInteger = 1);
    End;

  Finally
    FreeAndNil(qryGen);
  End;
End;

function TFatVenda.fRetMensagemValorNegativoPelosDescontos: String;
begin
  If (Self.fltPorDes > 0) And (Self.fltDesEsp = 0) Then
  Begin
    Result := '% de desconto informado (' + FormatFloat('#,##0.00', Self.fltPorDes) + ') não permitido!' + #13#10 +
              'O mesmo aplicado sobre o(s) produto(s) não promocionais irá resultar em ' +
              'um valor líquido menor ou igual à zero!'
  End
  Else If (Self.fltPorDes = 0) And (Self.fltDesEsp > 0) Then
  Begin
    Result := 'Desconto Especial informado (' + FormatFloat('#,##0.00', Self.fltDesEsp) + ') não permitido!' + #13#10 +
              'O mesmo aplicado sobre o(s) produto(s) não promocionais irá resultar em ' +
              'um valor líquido menor ou igual à zero!'
  End
  Else
  Begin
    Result := 'Desconto Especial (' + FormatFloat('#,##0.00', Self.fltDesEsp) + ') ' +
              'e % de desconto (' + FormatFloat('#,##0.00', Self.fltPorDes) + ') não permitidos!' + #13#10 +
              'Os mesmos aplicados sobre o(s) produto(s) não promocionais irá resultar em ' +
              'um valor líquido menor ou igual à zero!'
  End;
end;

Function TFatVenda.fAlteraEnderecoEntrega(blnExibeTelaComUmEndereco: Boolean;
                                          blnSomenteSelecao: Boolean = False;
                                          blnFormataCep: Boolean = False;
                                          blnNomeCidade: Boolean = False;
                                          blnAviso: Boolean = False;
                                          blnBaiFut: Boolean = False;
                                          blnForcarChamada: Boolean = False): Boolean;
Begin

  If Self.blnUsaEndEntregaServicosPedidoOrcamento Then
  Begin
    Result := false;
    Exit;
  End;

  If Not fEmptyStr(objFazenda.strCodFaz) And fCfgSis('CADFAZ', VarBoolean) Then
  Begin
    pLimparEnderecoEntrega;
    pEnderecoToFatVenda;
    Result := True;
    Exit;
  End;

  If (Not fTemItensEntrega) And
     (Not (blnPedeEndEntregaServicos And blnDocumentoTemServicos)) And
     (Not blnBaiFut) And
     (Not blnEndEntConfDoc) And
     (Not fImprimeEndEntregaItensRetira) And
     (Not blnForcarChamada) Then
  Begin
    fMensagem('ATENÇÃO','Não é possível alterar o endereço, nenhum item de entrega imediata/futura encontrado!', ['&O k']);
    Result := false;
    Exit;
  End;

  pFatVendaToEndereco;

  Result := objEndEnt.fAlteraEnderecoEntrega(blnExibeTelaComUmEndereco, strCodCli, blnSomenteSelecao,
                         blnFormataCep, blnNomeCidade,  blnAviso, True, strEspDoc);

  If Result And SelecionouEndEntComUFDifDoPedidoConf Then
  Begin
    Result := False;
    Exit;
  End;

  {*REQ.164501**********RP*}
  If Result Then
    pSetaVendaPresencialParaClienteForaDoEstadoMedianteCFG;

  If Result And EhClienteDifalComEntregaDentroDoEstado(True) Then
  Begin
    Result := false;
    Exit;
  End;

  If fBloqueiaTrocaDeEnderecoParaPrecoDeVendaComDifal Then
  Begin
    Self.opeAlterouUFEntrega := fRecalcularDIFAL;

    If (Self.opeAlterouUFEntrega = opAbortarOperacao) Then
    Begin
      Result := false;
      Exit;
    End;
  End;

  Self.blnForcEndEnt := blnForcarChamada;

  If (blnForcarChamada) And (Result) Then
    Self.blnDecidiuEndereco := True
  Else If (blnForcarChamada) And (Not Result) Then
    Self.blnDecidiuEndereco := False;

  pEnderecoToFatVenda;
End;

function TFatVenda.EhClienteDifalComEntregaDentroDoEstado(blnExibeMsg: Boolean = False):Boolean;
var
  LItem: TDadosFechamento;
  LUfEntrega: String;
  blnNaoAtendeRegras: Boolean;
  strEmpNaoAtendeRegras: String;
  strEmpAtendeRegras: String;
  strEmpresas: String;
  strMensagem: String;
  strUfEmp: String;
begin
  Result := False;

  blnNaoAtendeRegras := False;
  strEmpNaoAtendeRegras := '';
  strEmpAtendeRegras := '';
  strEmpresas := '';

  If (Pos(strOpcDoc, 'PD_OR_VN_') <= 0) Then
    Exit;

  LUfEntrega := fRetNomCidade(objEndEnt.recEndere.strCidEnt,1);

  If (fCfgSis('EMPFAT', VarString) = 'S') Then
  Begin
    For LItem in Self.arrMatItens Do
    Begin
      If (Pos(LItem.strEmpIte, strEmpresas) > 0) Then
        Continue;

      strUfEmp := Self.fGetUFEmpresa(LItem.strEmpIte);

      If (strUfEmp = LUfEntrega) And fAtendeRegrasDifal(False, LItem.strEmpIte) Then
      Begin
        Result := True;

        strEmpAtendeRegras := strEmpAtendeRegras + 'Empresa: ' + LItem.strEmpIte + ' UF: ' + strUfEmp + sLineBreak;
      End
      Else
      Begin
        blnNaoAtendeRegras := True;
        strEmpNaoAtendeRegras := strEmpNaoAtendeRegras + 'Empresa: ' + LItem.strEmpIte + ' UF: ' + strUfEmp +sLineBreak;
      End;

      strEmpresas := strEmpresas + LItem.strEmpIte + '_';
    End;
  End
  Else
  Begin
    If fAtendeRegrasDifal(False) Then
    Begin
      For LItem in Self.arrMatItens Do
      Begin
        If Self.fGetUFEmpresa(LItem.strEmpIte) = LUfEntrega Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  End;

  If Result And blnExibeMsg Then
  Begin
    strMensagem := 'Para entrega dentro do estado marque opção Venda Presencial.';

    If (blnNaoAtendeRegras) Then
    Begin
      strMensagem := 'Para entrega dentro do estado (' + LUfEntrega + '), é preciso marcar a opção de Venda Presencial.' + sLineBreak +
                     'Porém, existem empresas que não atendem às regras de venda presencial.' + sLineBreak +
                     'Por favor, realize a digitação dos documentos separadamente.' + sLineBreak + sLineBreak;

      If (Not fEmptyStr(strEmpAtendeRegras)) Then
        strMensagem := strMensagem + 'Empresas que atendem às regras:' + sLineBreak + strEmpAtendeRegras + sLineBreak;

      If (Not fEmptyStr(strEmpNaoAtendeRegras)) Then
        strMensagem := strMensagem + 'Empresas que não atendem às regras:' + sLineBreak + strEmpNaoAtendeRegras;

      fMensagem('ATENÇÃO!', strMensagem, ['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 400, 600);
    End
    Else
      fMensagem('ATENÇÃO!', strMensagem, ['&Ok']);
  End;
End;

function TFatVenda.fAnalisaGravacaoCaixa: Boolean;
  Var
    strDifVal: String;
    strMsgAux: String;
begin
  Result := True;

  {*******************************}
  {* ANALISA GRAVAÇÃO DO CAIXA   *}
  {*26/02/2015*REQ:22285*******AF*}
  If blnCfgGravaResCai And blnValGravaResCai And Not blnGravandoVariosDocumentos And Not fVerificaGrvCaixa(strDifVal, intSeqCon) Then
  Begin
    Result := False;

    fRollback;

    strMsgAux := 'Ocorreu uma inconsistência na gravação dos valores do caixa!' + #13#10 +
                 strDifVal + #13#10 + 'Tente realizar a gravação novamente! Se o problema persistir entre em contato com a Citel!';

    If (Pos(strEspOrc, 'OR_PD_') > 0) And (Pos(strEspDoc, 'MI_FF_') > 0) And
       (fPDOrTinhaST) And (fFormataFloat(Abs(Self.fltValCre), 4) >= fFormataFloat(Self.fltTotGer, 4)) And
       (Not fCfgSis('IPSTMF', varBoolean)) And (fCfgSis('CALSUB', varBoolean)) Then
    Begin
      strMsgAux := 'Ocorreu uma inconsistência na gravação dos valores do caixa!' + #13#10 +
                   'O '+IIF(strEspOrc='OR','orçamento','pedido')+' possui ST, a espécie para fechamento é '+strEspDoc+' e a modalidade escolhida é '+
                   'Utilização de Crédito. Esta operação não é permitida!' +#13#10+
                   'Fature o pedido em outra modalidade e posteriormente utilize o crédito no caixa ou fature em nota.';
    End;

    If blnImpPafEcf Then
      pAddMsgErroAdicional(strMsgAux)
    Else
      pMensagemOk(strMsgAux);

    Exit;
  End;

  {*******************************}
  {* ANALISA GRAVAÇÃO DO CAIXA   *}
  {*15/04/2015*REQ:32610*******AF*}
  If (Not blnGravandoVariosDocumentos) And (Not fVerificaCartaoCheque) Then
  Begin
    Result := False;
    fRollback;
    Exit;
  End;

end;

function TFatVenda.fInformaNumerosDeSerieDevolucao: Boolean;
var
  frmFatSeriesItensDevolucao: TfrmFatSeriesItensDevolucao;
  Item: TDadosFechamento;
  strCampoDetSer: String;
begin
  Result := False;

  if not fCfgSis('NUMSER', varBoolean) then
    Exit(True);

  if Self.strOpcDoc <> 'DV' then
    Exit(True);

  if not Assigned(Self.arrMatItens) then
    Exit(True);

  if Length(Self.arrMatItens) <= 0 then
    Exit(True);

  pCriarFormularios(TfrmFatSeriesItensDevolucao, frmFatSeriesItensDevolucao);

  try
    for item in Self.arrMatItens do
    begin
      if Item.strTabDev = 'NOTDET' then
        strCampoDetSer := 'SER_SEQNOT'
      else
        strCampoDetSer := 'SER_SEQGER';

      if fEmptyStr(fCampoTabela('SER_NUMSER','DETSER',[strCampoDetSer],[item.strIncDev])) then
        Continue;

      frmFatSeriesItensDevolucao.cdsSeries.Append;
      frmFatSeriesItensDevolucao.cdsSeriesAUTINC.AsString := item.strIncDev;
      frmFatSeriesItensDevolucao.cdsSeriesCODITE.AsString := item.strCodIte;
      frmFatSeriesItensDevolucao.cdsSeriesDESITE.AsString := item.strDesIte;
      frmFatSeriesItensDevolucao.cdsSeriesQTDITE.AsFloat :=  item.fltQtdIte;
      frmFatSeriesItensDevolucao.cdsSeriesEMPDOC.AsString := item.strEmpOrc;
      frmFatSeriesItensDevolucao.cdsSeriesEMPITE.AsString := item.strEmpIte;
      frmFatSeriesItensDevolucao.cdsSeriesTABDEV.AsString := Item.strTabDev;
      frmFatSeriesItensDevolucao.cdsSeries.Post;
    end;

    if frmFatSeriesItensDevolucao.cdsSeries.IsEmpty then
      Exit(True);

    frmFatSeriesItensDevolucao.cdsSeries.First;

    frmFatSeriesItensDevolucao.ShowModal;

    if frmFatSeriesItensDevolucao.ModalResult <> mrOk then
      Exit;

    FillChar(FArrItensNumeroSerieDevolucao, SizeOf(FArrItensNumeroSerieDevolucao), #0);

    FArrItensNumeroSerieDevolucao := frmFatSeriesItensDevolucao.FArrItensNumeroSerieDevolucao;

    Result := True;
  finally
    pFreeAndNil(frmFatSeriesItensDevolucao);
  end;
end;

procedure TFatVenda.pCalculaPontosClubeFidelidade;
begin
  fltPtoFid := 0;
  fltSldFid := 0;

  If (fCfgSis('VLPCCL', varDouble) > 0) And (strCluFid = 'S') And (fPermitePontosClubeFidelidade) Then
  Begin
    fltPtoFid := ((fltTotPro - fltDesEsp)/fCfgSis('VLPCCL', varDouble));
  End;

  If (strCluFid = 'S') Then
  Begin
    fltSldFid := fSaldoClubeFidelidade(strCodCli);
    fltSldFid := fltSldFid + fltPtoFid;
  End;
end;

Function TFatVenda.fTravaValorMinimo(strEspVer: String = ''): Boolean;
Begin
  Result := False;

  If fEmptyStr(strEspVer) Then
    strEspVer := fRetornaEspecieDocumentoParaTravaDeValorMinimoNoFechamento;

  If (Pos(strEspVer, 'VN_CS_') > 0) And (Not fCfgSis('MINPVN', varBoolean)) Then
    Exit;

  If SameText(strEspVer, 'PD') And (Not fCfgSis('MINPPD', varBoolean)) Then
    Exit;

  If SameText(strEspVer, 'OR') And (Not fCfgSis('MINPOR', varBoolean)) Then
    Exit;

  If (blnComVal) Then
    Exit;

  Result := True;
End;

function TFatVenda.fRetornaEspecieDocumentoParaTravaDeValorMinimoNoFechamento: String;
begin
  Result := strOpcDoc;

  if (Pos(strOpcDoc, 'VN_OR_') <= 0) then
    Exit;

  if (fEmptyStr(strEspDoc)) then
    Exit;

  if (Pos(strEspDoc, 'PD_OR_') <= 0) then
    Exit;

  Result := strEspDoc;
end;

function TFatVenda.fTravouFlexNegativoPedido: Boolean;
var
  qryTrava: TUniQuery;
begin
  qryTrava := fCriaQuery;

  try
    qryTrava.Close;
    qryTrava.SQL.Clear;
    qryTrava.SQL.Add('SELECT * FROM LOGLIB');
    qryTrava.SQL.Add('WHERE LOG_NUMDOC = :NUMDOC');
    qryTrava.SQL.Add('AND LOG_ESPDOC = :ESPDOC');
    qryTrava.SQL.Add('AND LOG_CODEMP = :CODEMP');
    qryTrava.SQL.Add('AND LOG_DIRACE = :DIRACE');

    qryTrava.ParamByName('NUMDOC').AsString := strNumOrc;
    qryTrava.ParamByName('ESPDOC').AsString := IIF(Pos(strEspDoc, 'OR_PD_') > 0, strEspDoc, 'PD');
    qryTrava.ParamByName('CODEMP').AsString := strEmpDoc;
    qryTrava.ParamByName('DIRACE').AsString := 'LIFLNE';

    qryTrava.Open;

    Result := not qryTrava.IsEmpty;
  finally
    FreeAndNil(qryTrava);
  end;
end;

procedure TFatVenda.pImpressaoTermoTintaMaquina;
var
  strArquivoOri: string;
  strArquivoDes: string;
  Word: TWord;
  intIndice: integer;
  intLinha: integer;
  intQtdLinha: integer;
  blnImprime: Boolean;
  strTipImp: string;
  blnImprimeItem: Boolean;
  intImpTer: integer;
begin
  if not DirectoryExists(ExtractFilePath(Application.ExeName) + 'TERMO DE VENDA') then
    CreateDir(ExtractFilePath(Application.ExeName) + 'TERMO DE VENDA');

  if not FileExists(ExtractFilePath(Application.ExeName) + 'TermoVendaTintaMaquina.docx') then
  begin
    fMensagem('ATENÇÃO', 'Termo de venda não encontrado.', ['&Ok']);
    Exit;
  end;

  strArquivoOri := ExtractFilePath(Application.ExeName) + 'TermoVendaTintaMaquina.docx';
  strArquivoDes := ExtractFilePath(Application.ExeName) + 'TERMO DE VENDA\TermoVendaTintaMaquina_' + Self.strNumDoc +'_' + Self.strEspDoc + '_' +Self.strEmpDoc + '.docx';

  CopyFile(pChar(strArquivoOri), pChar(strArquivoDes), False);

  Word := TWord.fCriarWord(Self);

  if Word = nil then
    Exit;

  try
    intImpTer := fCfgSis('IMPTER', varInteger);

    if not Word.AbrirArquivo(strArquivoDes) Then
    begin
      fMensagem('','Não foi possível abrir o arquivo!',['&OK']);
      exit;
    End;

    Word.pInsereImagem(fCfgSis('PATLOG'), '{{IMAGEM}}');

    Word.pReplace('{{NOMCLI}}', Self.strCliNom);
    Word.pReplace('{{CODCLI}}', Self.strCodCli);
    Word.pReplace('{{DOCCLI}}', Self.strCliCgc);
    Word.pReplace('{{NOMFAN}}', fRetNomeEmpresa(Self.strEmpDoc));
    Word.pReplace('{{CODVEN}}', Self.strCodVen);
    Word.pReplace('{{NOMVEN}}', Self.strNomVen);
    Word.pReplace('{{DTAEMI}}', DateToStr(Self.dtaDtaEntOri));
    Word.pReplace('{{NUMPED}}', Self.strNumDoc);
    Word.pReplace('{{CIDADE}}', Self.strCliCid);

    intQtdLinha := 0;

    for intIndice := Low(Self.arrMatItens) to High(Self.arrMatItens) do
    begin
      if Self.arrMatItens[intIndice].strIdePro <> 'NOR' then
      begin
        case intImpTer of
          1: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttAutomotiva]) then
            Inc(intQtdLinha);
          2: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttImobiliaria]) then
            Inc(intQtdLinha);
          3: Inc(intQtdLinha);
        end;
      end;
    end;

    Word.pCriaTabela('{{TABELA}}', intQtdLinha, 2);
    intLinha := 1;

    Word.pCelulaNegrito(intLinha, 1);
    Word.pCelulaEscreve(intLinha, 1, 'Descrição do produto');
    Word.pCelulaNegrito(intLinha, 2);
    Word.pCelulaEscreve(intLinha, 2, 'Quantidade');

    for intIndice := Low(Self.arrMatItens) to High(Self.arrMatItens) do
    begin
      if (Self.arrMatItens[intIndice].strIdePro <> 'NOR') and (fImprimeTermoTintaMaquina) then
      begin
        blnImprimeItem := False;

        case intImpTer of
          1: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttAutomotiva]) then
            blnImprimeItem := True;
          2: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttImobiliaria]) then
            blnImprimeItem := True;
          3: blnImprimeItem := True;
        end;

        if blnImprimeItem then
        begin
          Inc(intLinha);
          Word.pCelulaEscreve(intLinha, 1, Self.arrMatItens[intIndice].strDesIte);
          Word.pCelulaAlignRight(intLinha, 2);
          Word.pCelulaEscreve(intLinha, 2, FloatToStrf(Self.arrMatItens[intIndice].fltQtdIte, ffFixed, 11, fCfgSis('DECQTD', varInteger)));
        end;
      end;
    end;


    Word.pInsereImagem(fCfgSis('PATLOG'), '{{FOTO}}');

    Word.pCriaTabela('{{TABELA1}}', intQtdLinha, 2);
    intLinha := 1;

    Word.pCelulaNegrito(intLinha, 1);
    Word.pCelulaEscreve(intLinha, 1, 'Descrição do produto');
    Word.pCelulaNegrito(intLinha, 2);
    Word.pCelulaEscreve(intLinha, 2, 'Quantidade');

    for intIndice := Low(Self.arrMatItens) to High(Self.arrMatItens) do
    begin
      if (Self.arrMatItens[intIndice].strIdePro <> 'NOR') and (fImprimeTermoTintaMaquina) then
      begin
        blnImprimeItem := False;

        case intImpTer of
          1: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttAutomotiva]) then
            blnImprimeItem := True;
          2: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttImobiliaria]) then
            blnImprimeItem := True;
          3: blnImprimeItem := True;
        end;

        if blnImprimeItem then
        begin
          Inc(intLinha);
          Word.pCelulaEscreve(intLinha, 1, Self.arrMatItens[intIndice].strDesIte);
          Word.pCelulaAlignRight(intLinha, 2);
          Word.pCelulaEscreve(intLinha, 2, FloatToStrf(Self.arrMatItens[intIndice].fltQtdIte, ffFixed, 11, fCfgSis('DECQTD', varInteger)));
        end;
      end;
    end;

    Word.pSalvar;

    pCarregaConfImpr(qryCfgRel, 'TermoVendaTintaMaquina');
    strNomImp := qryCfgRel.FieldByName('REL_NOMFIL').AsString;

    if fEmptyStr(strNomImp) then
    begin
      blnImprime := fPreImpressao(qryCfgRel, strNomImp, strTipImp, False, 'I');
    end
    else
    begin
      blnImprime := True;
    end;

    if blnImprime then
      TCfgRel.pPrintReport('TermoVendaTintaMaquina', ExtractFileName(strArquivoDes), strNomImp, Word);

    Word.pFechar;
    pProcessMessages;
  finally
    FreeAndNil(Word);
  end;
end;

procedure TFatVenda.pAplicaFatorMultiLoja(arrMatItens: TMatrizFechamento);
var
  fltFatorQtd: Double;
  intIndice: integer;
begin
  for intIndice := Low(arrMatItens) to High(arrMatItens) do
  begin
    if arrMatItens[intIndice].fltQtdSol <= 0 then
      Continue;

    fltFatorQtd := arrMatItens[intIndice].fltQtdSol / arrMatItens[intIndice].fltQtdIte;

    arrMatItens[intIndice].fltTotIte := arrMatItens[intIndice].fltTotIte * fltFatorQtd;
    arrMatItens[intIndice].fltVlrCon := arrMatItens[intIndice].fltVlrCon * fltFatorQtd;
    arrMatItens[intIndice].fltTotCus := arrMatItens[intIndice].fltTotCus * fltFatorQtd;
    arrMatItens[intIndice].fltTotMed := arrMatItens[intIndice].fltTotMed * fltFatorQtd;
    arrMatItens[intIndice].fltDesCon := arrMatItens[intIndice].fltDesCon * fltFatorQtd;
    arrMatItens[intIndice].fltValFre := arrMatItens[intIndice].fltValFre * fltFatorQtd;
    arrMatItens[intIndice].fltDesEsp := arrMatItens[intIndice].fltDesEsp * fltFatorQtd;
    arrMatItens[intIndice].fltDesAce := arrMatItens[intIndice].fltDesAce * fltFatorQtd;
    arrMatItens[intIndice].fltValipi := arrMatItens[intIndice].fltValipi * fltFatorQtd;
    arrMatItens[intIndice].fltBasIpi := arrMatItens[intIndice].fltBasIpi * fltFatorQtd;
    arrMatItens[intIndice].fltValIcm := arrMatItens[intIndice].fltValIcm * fltFatorQtd;
    arrMatItens[intIndice].fltBasIcm := arrMatItens[intIndice].fltBasIcm * fltFatorQtd;
    arrMatItens[intIndice].fltValRet := arrMatItens[intIndice].fltValRet * fltFatorQtd;
    arrMatItens[intIndice].fltBasRet := arrMatItens[intIndice].fltBasRet * fltFatorQtd;
    arrMatItens[intIndice].fltTotCu2 := arrMatItens[intIndice].fltTotCu2 * fltFatorQtd;
    arrMatItens[intIndice].fltFreSug := arrMatItens[intIndice].fltFreSug * fltFatorQtd;
    arrMatItens[intIndice].fltPesLiq := arrMatItens[intIndice].fltPesLiq * fltFatorQtd;
    arrMatItens[intIndice].fltVal_RT := arrMatItens[intIndice].fltVal_RT * fltFatorQtd;
    arrMatItens[intIndice].fltSerRat := arrMatItens[intIndice].fltSerRat * fltFatorQtd;
    arrMatItens[intIndice].fltFreRat := arrMatItens[intIndice].fltFreRat * fltFatorQtd;
    arrMatItens[intIndice].fltValFre := arrMatItens[intIndice].fltValFre * fltFatorQtd;
    arrMatItens[intIndice].fltTaxEnt := arrMatItens[intIndice].fltTaxEnt * fltFatorQtd;
    arrMatItens[intIndice].fltIcmPav := arrMatItens[intIndice].fltIcmPav * fltFatorQtd;
    arrMatItens[intIndice].fltICMSai := arrMatItens[intIndice].fltICMSai * fltFatorQtd;
    arrMatItens[intIndice].fltImpFed := arrMatItens[intIndice].fltImpFed * fltFatorQtd;
    arrMatItens[intIndice].fltDesOpe := arrMatItens[intIndice].fltDesOpe * fltFatorQtd;
    arrMatItens[intIndice].recDifalFCP.fltValFcp := arrMatItens[intIndice].recDifalFCP.fltValFcp * fltFatorQtd;
    arrMatItens[intIndice].fltPesoIt := arrMatItens[intIndice].fltPesoIt * fltFatorQtd;
    arrMatItens[intIndice].fltDesCnd := arrMatItens[intIndice].fltDesCnd * fltFatorQtd;
    arrMatItens[intIndice].fltQtdRco := arrMatItens[intIndice].fltQtdRco * fltFatorQtd;
    arrMatItens[intIndice].fltFreMkp := arrMatItens[intIndice].fltFreMkp * fltFatorQtd;
    arrMatItens[intIndice].fltComMkp := arrMatItens[intIndice].fltComMkp * fltFatorQtd;
    arrMatItens[intIndice].fltVDesST := arrMatItens[intIndice].fltVDesST * fltFatorQtd;
    arrMatItens[intIndice].fltBimRet := arrMatItens[intIndice].fltBimRet * fltFatorQtd;
    arrMatItens[intIndice].fltVimRet := arrMatItens[intIndice].fltVimRet * fltFatorQtd;

    arrMatItens[intIndice].fltQtdIte := arrMatItens[intIndice].fltQtdSol;
  end;
end;

function TFatVenda.fImprimeTermoTintaMaquina: Boolean;
var
  intImpTer: integer;
  intIndice: integer;
begin
  Result := False;

  intImpTer := fCfgSis('IMPTER', varInteger);

  if intImpTer = 0 then
    Exit;

  for intIndice := Low(Self.arrMatItens) to High(Self.arrMatItens) do
  begin
    if Self.arrMatItens[intIndice].strIdePro = 'NOR' then
      Continue;

    case intImpTer of
      1: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttAutomotiva]) then
           Exit(True);
      2: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttImobiliaria]) then
           Exit(True);
      3: if (fTipoTinta(Self.arrMatItens[intIndice].strIdePro) in [ttAutomotiva, ttImobiliaria]) then
           Exit(True);
    end;
  end;
end;

procedure TFatVenda.pCriaDataSetCfop;
begin
  cdsResTotCfop := TUniClientDataSet.Create(nil);

  With cdsResTotCfop Do
  Begin
    With FieldDefs.AddFieldDef Do
    Begin
      Name := 'CFOP';
      DataType := ftString;
      Required := False;
    End;

    With FieldDefs.AddFieldDef Do
    Begin
      Name := 'VALOR';
      DataType := ftFloat;
      Required := False;
    End;

    IndexFieldNames := 'CFOP';
    CreateDataSet;
    Open;
    LogChanges := False;
  End;
end;

