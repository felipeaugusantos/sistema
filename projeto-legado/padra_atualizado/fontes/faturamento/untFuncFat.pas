procedure pAtualizarVariaveisAposCarregarPedidosExpedicao(fatVenda: TFatVenda; const fltDesComercialZFM : Double);
begin
  fatVenda.strNumPok := fatVenda.objExpedicao.strNumPok;
  fatVenda.strPedSit := fatVenda.objExpedicao.strPedSit;

  fatVenda.intQtdTra := fatVenda.objExpedicao.intQtdTraTmp;

  fatVenda.strPedExp := LeftStr(fatVenda.strPedExp, length(fatVenda.strPedExp) -2);
  fatVenda.strDocExp := LeftStr(fatVenda.strDocExp, Length(fatVenda.strDocExp) -3);

  If (fatVenda.fZerarDesEsp) Then
    fatVenda.fltDesEsp := 0.0;

  fatVenda.fltDesComercialZFM := fltDesComercialZFM;
end;

procedure pProcessarConflitosPedidosExpedicao(AIndex: Integer; APedidos: TStringList; AParams: TExpedicaoParams);
var
  objPedido: TPedidoVenda;
begin
  If Assigned(AParams.objResolveConflitosPedido) Then
  Begin
    objPedido := TPedidoVenda(APedidos.Objects[AIndex]);

    If (AIndex = 0) Then
    Begin
      AParams.strCodTraSel := AParams.qryFatGor.FieldByName('FGO_CODTRA').AsString;
      AParams.strConPagSel := AParams.qryFatGor.FieldByName('FGO_CONPAG').AsString;
      AParams.strForPagSel := AParams.qryFatGor.FieldByName('FGO_CODFPG').AsString;
      AParams.strCodCndSel := AParams.qryFatGor.FieldByName('FGO_CODCND').AsString;
    End
    Else
    Begin
      If (Not AParams.blnCodTraDif) Then
      Begin
        If (Not fEmptyStr(AParams.strCodTraSel)) And
           (AParams.strCodTraSel <> AParams.qryFatGor.FieldByName('FGO_CODTRA').AsString) Then
          AParams.blnCodTraDif := True;
      End;

      If (Not AParams.blnConPagDif) Then
      Begin
        If (Not fEmptyStr(AParams.strConPagSel)) And
           (AParams.strConPagSel <> AParams.qryFatGor.FieldByName('FGO_CONPAG').AsString) Then
          AParams.blnConPagDif := True;
      End;

      If (Not AParams.blnForPagDif) Then
      Begin
        If (Not fEmptyStr(AParams.strForPagSel)) And
           (AParams.strForPagSel <> AParams.qryFatGor.FieldByName('FGO_CODFPG').AsString) Then
          AParams.blnForPagDif := True;
      End;

      If (Not AParams.blnCodCndDif) Then
      Begin
        If (Not fEmptyStr(AParams.strCodCndSel)) And
           (AParams.strCodCndSel <> AParams.qryFatGor.FieldByName('FGO_CODCND').AsString) Then
          AParams.blnCodCndDif := True;
      End;
    End;

    AParams.objResolveConflitosPedido.pAddDocumentos(objPedido.strNumDoc,
                                                     objPedido.strEspDoc,
                                                     objPedido.strCodEmp,
                                                     AParams.qryFatGor.FieldByName('FGO_CODCLI').AsString);
  End;
end;

procedure pAtualizaPedidoDadosExpedicao(strCodCon, strCodSep, strObsExp: String; objPedido: TPedidoVenda; blnExpedido, blnLimpar: Boolean;
  dtaInicioConferencia, dtaFinalConferencia: TDateTime; intQtdTra: Integer; strEspTra: String; blnAtualizarSeparadorSomenteSeVazio: Boolean = False;
  intQtdTraSepExc: Integer = 0; intQtdTraSepNExc: Integer = 0; blnAlterarVolumeEspeci: Boolean = True);
  Var
    strSQL: String;
    qryUpd: TUniQuery;
begin
  strSQL := '';
  strSQL := strSQL + 'UPDATE     ';
  strSQL := strSQL + '  EXTGOR E ';
  strSQL := strSQL + '  INNER JOIN FATGOR F ON F.AUTOINCREM = E.FGO_SEQFGO ';
  strSQL := strSQL + '  LEFT  JOIN AUXGOR A ON A.AUX_SEQGER = F.AUTOINCREM ';
  strSQL := strSQL + 'SET      ';
  strSQL := strSQL + '  E.FGO_OPEEXP = :OPEEXP, ';
  If blnAtualizarSeparadorSomenteSeVazio Then
    strSQL := strSQL + '  E.FGO_SEPEXP = IF(E.FGO_SEPEXP IS NULL, :SEPEXP, E.FGO_SEPEXP), '
  Else
    strSQL := strSQL + '  E.FGO_SEPEXP = :SEPEXP, ';
  strSQL := strSQL + '  E.FGO_OBSEXP = :OBSEXP  ';

  strSQL := strSQL + '  ,E.FGO_DTLBEX = :DTLBEX  ';
  strSQL := strSQL + '  ,E.FGO_HRLBEX = :HRLBEX  ';
  strSQL := strSQL + '  ,E.FGO_DTFICO = :DTFICO  ';
  strSQL := strSQL + '  ,E.FGO_HRFICO = :DTFICO  ';

  //data de início da conferência
  if blnLimpar then
  begin
    strSQL := strSQL + '  ,E.FGO_DTINCO = NULL  ';
    strSQL := strSQL + '  ,E.FGO_HRINCO = NULL  ';
  end
  else
  begin
    strSQL := strSQL + '  ,E.FGO_DTINCO = IFNULL(E.FGO_DTINCO, :DTINCO)  ';
    strSQL := strSQL + '  ,E.FGO_HRINCO = IFNULL(E.FGO_HRINCO, :DTINCO)  ';
  end;

  If (fCfgSis('VOLEXP') = 'S') Then
  Begin
    If (blnAlterarVolumeEspeci Or blnLimpar) Then
    Begin
      strSQL := strSQL + '  ,F.FGO_VOLUME = :VOLUME  ';
      strSQL := strSQL + '  ,F.FGO_ESPECI = :ESPECI  ';
    End;

    If fCfgSis('SEPEXC', varBoolean) Then
    Begin
      strSQL := strSQL + ' ,A.AUX_VOLEXS = :VOLEXS ';
      strSQL := strSQL + ' ,A.AUX_VOLEXN = :VOLEXN ';
    End;
  End;

  strSQL := strSQL + 'WHERE    ';
  strSQL := strSQL + '  F.FGO_NUMDOC = :NUMDOC AND ';
  strSQL := strSQL + '  F.FGO_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '  F.FGO_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '  F.FGO_CODCLI = :CODCLI     ';

  qryUpd := fCriaQuery;

  With qryUpd Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);

    If (Not blnLimpar) Then Begin
      ParamByName('OPEEXP').Value := IIF(fEmptyStr(strCodCon), Null, strCodCon);
      ParamByName('SEPEXP').Value := IIF(fEmptyStr(strCodSep), Null, strCodSep);
      ParamByName('OBSEXP').Value := IIF(fEmptyStr(strObsExp), Null, strObsExp);
      ParamByName('DTINCO').AsDateTime := dtaInicioConferencia;

      If blnExpedido Then Begin
        ParamByName('DTLBEX').AsDate := VS_Date;
        ParamByName('HRLBEX').AsTime := fTime();
        ParamByName('DTFICO').AsDateTime := dtaFinalConferencia;
      End Else Begin
        ParamByName('DTLBEX').Value := Null;
        ParamByName('HRLBEX').Value := Null;
        ParamByName('DTFICO').Value := Null;
      End;

      If (fCfgSis('VOLEXP') = 'S') Then
      Begin
        If FindParam('VOLUME') <> Nil Then
          ParamByName('VOLUME').AsInteger := intQtdTra;
        If FindParam('ESPECI') <> Nil Then
          ParamByName('ESPECI').AsString  := strEspTra;

        If fCfgSis('SEPEXC', varBoolean) Then
        Begin
          ParamByName('VOLEXS').AsInteger := intQtdTraSepExc;
          ParamByName('VOLEXN').AsInteger := intQtdTraSepNExc;
        End;
      End;
    End Else Begin
      ParamByName('OPEEXP').Value := Null;
      ParamByName('SEPEXP').Value := Null;
      ParamByName('OBSEXP').Value := Null;

      ParamByName('DTLBEX').Value := Null;
      ParamByName('HRLBEX').Value := Null;
      ParamByName('DTFICO').Value := Null;

      If (fCfgSis('VOLEXP') = 'S') Then
      Begin
        If FindParam('VOLUME') <> Nil Then
          ParamByName('VOLUME').AsInteger := 0;
        If FindParam('ESPECI') <> Nil Then
          ParamByName('ESPECI').AsString  := '';

        If fCfgSis('SEPEXC', varBoolean) Then
        Begin
          ParamByName('VOLEXS').AsInteger := 0;
          ParamByName('VOLEXN').AsInteger := 0;
        End;
      End;
    End;

    ParamByName('NUMDOC').AsString := objPedido.strNumDoc;
    ParamByName('ESPDOC').AsString := 'PD';
    ParamByName('CODEMP').AsString := objPedido.strCodEmp;
    ParamByName('CODCLI').AsString := objPedido.strCodCli;

    ExecSQL;
  End;

  FreeAndNil(qryUpd);
End;

procedure pLimparDadosExpedicaoPedido(objPedido: TPedidoVenda; AParams: TExpedicaoParams);
begin
  If (AParams.blnLimparExpedidos) Then
  Begin
    pAtualizaPedidoDadosExpedicao('', '', '', objPedido, False, True, 0, 0, 0, '');
    AParams.blnLimparExpedidos := False;
  End;
end;

function fCarregarPedidosExpedicao(fatVenda: TFatVenda; AParams: TExpedicaoParams; pgbStatus: TcxProgressBar): Boolean;
  Var
    objPedido: TPedidoVenda;
    LIndex: Integer;
    fltDesComercialZFM : Double;
begin
  If fatVenda.objExpedicao.blnRegEsp Then
    fatVenda.strEmpOriRegEsp := fatVenda.objExpedicao.strEmpOriRegEsp;

  fatVenda.intQtdePedidosExpedicao := fatVenda.objExpedicao.stlPedidos.Count;
  fltDesComercialZFM := 0;

  For LIndex := 0 To fatVenda.objExpedicao.stlPedidos.Count -1 Do
  Begin
    objPedido := TPedidoVenda(fatVenda.objExpedicao.stlPedidos.Objects[LIndex]);

    If Not fCarregarPedidoExpedicao(objPedido, fatVenda, AParams, pgbStatus) Then
      Exit(False);

    fltDesComercialZFM := fltDesComercialZFM + fatVenda.fltDesComercialZFM;
    pProcessarConflitosPedidosExpedicao(LIndex, fatVenda.objExpedicao.stlPedidos, fatVenda.objExpedicao);

    pCarregaDescontoEspecialExpedicao(fatVenda);

    pLimparDadosExpedicaoPedido(objPedido, fatVenda.objExpedicao);
  End;

  pAtualizarVariaveisAposCarregarPedidosExpedicao(fatVenda, fltDesComercialZFM);

  Result := True;
end;

function fCarregarPedidoExpedicao(objPedido: TPedidoVenda; fatVenda: TFatVenda; AParams: TExpedicaoParams; pgbStatus: TcxProgressBar): Boolean;
var
  blnDeletouItens: Boolean;
begin
  Result := True;

  fatVenda.strNumOrc    := objPedido.strNumDoc;
  fatVenda.strEspOrc    := objPedido.strEspDoc;
  fatVenda.strEmpOri    := objPedido.strCodEmp;
  fatVenda.strEmpOriPed := objPedido.strCodEmp;
  If AParams.blnAbastecimentoDeposito Then
  Begin
    If (AParams.strEmpOriRegEsp = objPedido.strCodEmp) And
       (Not fEmptyStr(AParams.strEmpresaSolicitanteAbastecimentoDeposito)) Then
      fatVenda.strEmpOriPed := AParams.strEmpresaSolicitanteAbastecimentoDeposito;
  End;

  fatVenda.objExpedicao.strNumDoc := fatVenda.strNumOrc;
  fatVenda.objExpedicao.strCodEmp := fatVenda.strEmpOri;

  fatVenda.strPedExp := fatVenda.strPedExp + objPedido.strNumDoc + ', ';
  fatVenda.strDocExp := fatVenda.strDocExp + objPedido.strNumDoc + '-' +
                                             objPedido.strEspDoc + '-' +
                                             objPedido.strCodEmp + ' / ';

  {*************************************************************}
  { ALIMENTA PROPRIEDADE fatvenda.strDocsConfPD PARA UTILIZAÇÃO }
  { NA "CONFIGURAÇÃO DA NOTA FISCAL ELETRÔNICA                  }
  {*********************************************************RL**}
  fatVenda.pAddDocsConfPD(objPedido.strNumDoc + '-' + objPedido.strEspDoc + '-' + objPedido.strCodEmp + ',');

  fatVenda.pAddRotasConfPD(fRetRotasPorPedido(objPedido.strNumDoc,
                                              objPedido.strEspDoc,
                                              objPedido.strCodEmp));

  fatVenda.pAddRegioesConfPD(fRetRegioesPorPedido(objPedido.strNumDoc,
                                                  objPedido.strEspDoc,
                                                  objPedido.strCodEmp));
  With fatVenda.objExpedicao.qryFatGor Do
  Begin
    Close;
    ParamByName('NUMDOC').AsString := fatVenda.strNumOrc;
    ParamByName('ESPDOC').AsString := fatVenda.strEspOrc;
    ParamByName('CODEMP').AsString := fatVenda.strEmpOri;
    Open;
  End;

  fatVenda.fltDesComercialZFM := fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_DECZFM').AsFloat;
  objPedido.fltDesCon := fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_DESCON').AsFloat;

  {**************************************************************************************************}
  {* FUNÇÃO pCarregaDadosCliente TEM QUE ESTAR ANTES DE pCarregaPedidoOrcamento, POIS, A FUNÇÃO     *}
  {* fCalculaAliquota CONTIDA DENTRO DO MESMO, USA A UF DO CLIENTE PARA EFETUAR O CALCULO DO ICMS E *}
  {* QUE É GRAVADO DET_ICMSAI DA MOVTRI USADO NO CALCULO DE MARGEM REQ.: 86373                      *}
  {************************************************************************************************VA}
  pCarregarClienteExpedicao(fatVenda);

  pAdicionaItensBaixaEntregaFuturaExpedicao(objPedido, fatVenda, fatVenda.objExpedicao);

  Try
    fatVenda.pCarregaPedidoOrcamento(fatVenda.objExpedicao.qryFatGor, blnDeletouItens, pgbStatus);
  Except
    On E: ExceptionAutcom Do
    Begin
      pMensagemOK(E.Message);
      Result := False;
    End;

    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[btnConfirma.pCarregaPedidoOrcamento]');
      Result := False;
    End;
  End;

  If fatVenda.blnFecharForm Then
    Exit(False);

  If Not fValidarPedidoComPromocaoDeTintaVencidaExpedicao(fatVenda) Then
    Exit(False);

  If Not fValidarPedidoOrigemAkzoNobelExpedicao(fatVenda) Then
    Exit(False);

  If fEmptyStr(fatVenda.objExpedicao.strNumPok) Then
    fatVenda.objExpedicao.strNumPok := fatVenda.strNumPok;

  If fEmptyStr(fatVenda.objExpedicao.strPedSit) Then
    fatVenda.objExpedicao.strPedSit := fatVenda.strPedSit;

  If fCfgSis('EXVOPD', varBoolean) Then
    fatVenda.objExpedicao.intQtdTraTmp := fatVenda.objExpedicao.intQtdTraTmp + Floor(fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_VOLUME').AsFloat)
  Else
    fatVenda.objExpedicao.intQtdTraTmp := fatVenda.objExpedicao.intQtdTraTmp + fatVenda.intQtdTra;

  If fRetirarAdiantamentoDaCondicaoDePagamento(objPedido.strNumDoc,
                                               objPedido.strEspDoc,
                                               objPedido.strCodEmp) Then
  Begin
    fatVenda.strConPag := fRetiraEntradaCndPagamento(fatVenda.strConPag);
  End;
end;

function fRetirarAdiantamentoDaCondicaoDePagamento(strNumDoc, strEspDoc, strCodEmp: String):Boolean;
var
  recAdiantamento: TTotaisAdiantamento;
begin
  Result := False;

  If not fCfgSis('ADTREC', varBoolean) Then
    Exit;

  If (Not fCfgExpedicaoParcialHabilitada) Then
    Exit;

  If not fPedidoFaturadoParcialmente(strNumDoc, strEspDoc, strCodEmp) then
    Exit;

  recAdiantamento := TAdiantamento.fGetTotaisAdiantamento(strNumDoc, strEspDoc, strCodEmp);

  If not recAdiantamento.blnExiAdt then
    Exit;

  If recAdiantamento.fltValLan > 0 then
    Exit;

  Result := True;
end;

procedure pCarregaDescontoEspecialExpedicao(fatVenda: TFatVenda);
  Var
    blnConsiderar: Boolean;
    strAutIncFgo : String;
begin
  {*********************************************}
  { CALCULA O DESCONTO ESPECIAL DE ACORDO COM A }
  { QUANTIDADE DE ITENS FALTANTES DO PEDIDO     }
  {******************************************JB*}
  fatVenda.objExpedicao.cdsItens.DisableControls;
  fatVenda.objExpedicao.cdsItens.First;
  fatVenda.fltDesEsp := 0;

  strAutIncFgo := '';
  If fatVenda.objExpedicao.blnExpediMult Or
     fatVenda.objExpedicao.blnMaisDeUmPedidoDoMesmoClienteComAdiantamento Then
    strAutIncFgo := fatVenda.objExpedicao.stlPedidos.CommaText;

  While (Not fatVenda.objExpedicao.cdsItens.Eof) Do
  Begin
    blnConsiderar := True;
    If (strAutIncFgo <> '') Then
      blnConsiderar := (Pos(fatVenda.objExpedicao.cdsItens.FieldByName('FDO_SEQGER').AsString, strAutIncFgo) > 0);

    If (fFormataFloat(fatVenda.objExpedicao.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger)) > 0) And blnConsiderar Then
    Begin
      If (fatVenda.objExpedicao.cdsItens.FieldByName('QTDEXP').AsFloat + fatVenda.objExpedicao.cdsItens.FieldByName('QTDBAI').AsFloat) =
         (fatVenda.objExpedicao.cdsItens.FieldByName('QTDTOT').AsFloat) Then
      Begin
        fatVenda.fltDesEsp := fatVenda.fltDesEsp + fFormataFloat(fatVenda.objExpedicao.cdsItens.FieldByName('DESESP').AsFloat -
                                                                 fatVenda.objExpedicao.cdsItens.FieldByName('DESBAI').AsFloat, 2);
      End
      Else
        fatVenda.fltDesEsp := fatVenda.fltDesEsp + fFormataFloat((fatVenda.objExpedicao.cdsItens.FieldByName('DESESP').AsFloat /
                                                                  fatVenda.objExpedicao.cdsItens.FieldByName('QTDTOT').AsFloat) *
                                                                  fatVenda.objExpedicao.cdsItens.FieldByName('QTDEXP').AsFloat, 2);
    End;
    fatVenda.objExpedicao.cdsItens.Next;
  End;
  fatVenda.objExpedicao.cdsItens.EnableControls;

  If (fatVenda.fltDesEsp < 0) Then
    fatVenda.fltDesEsp := 0;

  //Sempre que recalcular o desconto especial devemos formatar com 2 decimais
  fatVenda.fltDesEsp := fFormataFloat(fatVenda.fltDesEsp, 2);
end;


procedure pCarregarClienteExpedicao(fatVenda: TFatVenda);
Var
  strTipFor: String;
  strConAux: String;
begin
  fatVenda.objExpedicao.blnManPar := True;

  fatVenda.strConPag := fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CONPAG').AsString; // Condição de Pagamento
  fatVenda.strCodCnd := fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CODCND').AsString; // Condicao      - Codigo
  fatVenda.strCodFpg := fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CODFPG').AsString; // Código da Forma de Pagamento

  untFuncFat.pCarregarClientePedidoOrcamento(fatVenda, fatVenda.strEmpOri);

  pCarregaDescontoEspecialExpedicao(fatVenda);

  strTipFor := fRetTipoForaConPag(fatVenda.strCodCnd);

  strConAux := '';

  If (fConPagFora(strTipFor)) And fCfgSis('USACND', VarBoolean) And (Not fEmptyStr(fatVenda.strCodCnd)) Then
  Begin
    strConAux := fRetConPagCodCnd(fatVenda.strCodCnd);
    fatVenda.strConPag := fRetCondicao(fatVenda.fRetConPagRef, fatVenda.dtaUltDtaAlt, fatVenda.strCodCnd, strTipFor, strConAux, 0, '', fatVenda.strCodCid);

    If fatVenda.strConPag <> fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CONPAG').AsString Then
      fatVenda.objExpedicao.blnManPar := False;
  End;

  If Not fatVenda.fDocumentoParaFornecedor Then
  Begin
    If (fEmptyStr(strConAux)) And (Pos(strTipFor, 'OUTROS_DIA FIXO_') <= 0) And fCfgSis('USACND', VarBoolean) And (Not fEmptyStr(fatVenda.strCodCnd)) Then
      strConAux := fRetConPagCodCnd(fatVenda.strCodCnd)
    Else
      strConAux := fatVenda.strConPag;

    fatVenda.strConPag := fRetCondicaoDiaFixoCliente(fatVenda.fRetConPagRef, fatVenda.dtaUltDtaAlt, fatVenda.strCodCli, strConAux, 0, '', fatVenda.strCodCid);

    If fatVenda.strConPag <> fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CONPAG').AsString Then
      fatVenda.objExpedicao.blnManPar := False;
  End;

  If Assigned(fatVenda.objExpedicao.stlPedidos) And (fatVenda.objExpedicao.stlPedidos.Count > 1) Then
    fatVenda.objExpedicao.blnManPar := False;

  fatVenda.pCarregaAliquotasRetencao;
  fatVenda.pAtualizaClassTransferencias;
  fatVenda.pDefineSeClienteEmiteEnvioEstoqueExternoPeloAutcom;
end;

procedure pCarregarClientePedidoOrcamento(fatVenda: TFatVenda; strCodEmpSel: String = ''; blnCarregaSomenteEstadoCliente: Boolean=False; blnPedidoEntCd: Boolean=False);
  Var
    strSQL: String;
    qryGeral: TUniQuery;
begin
  If fEmptyStr(strCodEmpSel) Then
    strCodEmpSel := VS_strCodEmp;

  qryGeral := fCriaQuery(Nil);
  Try
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  FGO_DTAENT AS DTAENT, ';
    strSQL := strSQL + '  FGO_NUMDOC AS NUMDOC, ';
    strSQL := strSQL + '  FGO_ESPDOC AS ESPDOC, ';
    strSQL := strSQL + '  FGO_CODEMP AS CODEMP, ';
    strSQL := strSQL + '  FGO_CODVEN AS CODVEN, ';
    strSQL := strSQL + '  FGO_CODCLI AS CODCLI, ';
    strSQL := strSQL + '  CLI_NOMCLI AS CLIORI, ';
    strSQL := strSQL + '  CLI_I_M_P_ AS I_M_P_, ';
    strSQL := strSQL + '  CLI_PRORUR AS PRORUR, ';
