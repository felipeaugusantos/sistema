{**************************************}
{* GRAVA CLUBE DE FIDELIDADE :-)      *}
{***********************************AF*}
function TFatVenda.fGCluFid: Boolean;
  Var
    objCluFid: TCluFid;
    strCLABRI: String;
    fltVLPCCL: Double;
    blnBCFDCP: Boolean;
    strVALPCF: String;
    fltPtoClu: Double;

  procedure pCarregaCFGs();
  begin
    strCLABRI := fCfgSis('CLABRI', VarString);
    fltVLPCCL := fCfgSis('VLPCCL', VarDouble);
    blnBCFDCP := fCfgSis('BCFDCP', VarBoolean);
    strVALPCF := fCfgSis('VALPCF', VarString);
  end;

  function fEhDocBrinde():Boolean;
  begin
    Result := (strOpcDoc = 'BR') Or
              ((Pos(strEspDoc, 'FF_DV_NF_IF_NS_BR_') > 0) And (Pos(RightStr(strClaFis, 3), strCLABRI) > 0));
  end;

  function fCalcQtdPtoItensBrinde():Double;
  var
    intIndex:Integer;
    fltVALCFI: Double;
  begin
    Result := 0;

    If (Not blnBCFDCP) Then
      Exit;

    For intIndex := 0 To Pred(Length(arrMatItens)) Do
    Begin
      If (fEhDocBrinde) Or (Pos(RightStr(arrMatItens[intIndex].strClaFis, 3), strCLABRI) > 0) Then
      Begin
        If (strVALPCF = '1') Then
        Begin
          Result := Result + ((arrMatItens[intIndex].fltTotIte - arrMatItens[intIndex].fltDesEsp) / fltVLPCCL);
        End
        Else If (strVALPCF = '2') Then
        Begin
          fltVALCFI := fValorPontosClubeFidelidadeProduto(arrMatItens[intIndex].strCodIte);

          If (fltVALCFI > 0) And (arrMatItens[intIndex].fltQtdIte > 0) Then
            Result := Result + (fltVALCFI * arrMatItens[intIndex].fltQtdIte);
        End;
      End;
    End;
  end;

  function fCalcQtdPtoItensNormais():Double;
    Var
      intIndex  : Integer;
  begin
    Result := 0;

    If fEhDocBrinde Then
      Exit;

    If (fltVLPCCL > 0) Then
    Begin
      For intIndex := 0 To Pred(Length(arrMatItens)) Do
      Begin
        If (Pos(RightStr(arrMatItens[intIndex].strClaFis, 3), strCLABRI) <= 0) Then
          Result := Result + ((arrMatItens[intIndex].fltTotIte - arrMatItens[intIndex].fltDesEsp) / fltVLPCCL);
      End;
    End;
  end;

  function fRetornaDebitoCredito(fltProClu: Double):String;
  begin
    If fEhDocBrinde() Then
      Result := 'D'
    Else
    Begin
      Result := IfThen(LeftStr(strClaFis, 1) < '5','D','C');

      If (fltProClu < 0) Then
        Result := IIF(Result = 'D', 'C', IIF(Result = 'C', 'D', 'C'));
    End;
  end;
begin

  Try
    objCluFid := TCluFid.Create(Nil);

    Result := True;

    If (strCluFid = 'S') Then
    Begin
      pCarregaCFGs;

      fltPtoClu := fCalcQtdPtoItensNormais() - fCalcQtdPtoItensBrinde();

      If (fltPtoClu <> 0) Then
        Result := objCluFid.fGravaCluFid(strNumDoc,
                                         strEspDoc,
                                         strCliFid,
                                         fRetornaDebitoCredito(fltPtoClu),
                                         'REFERENTE A FATURAMENTO',
                                         Abs(fltPtoClu));
    End;

  Finally
    FreeAndNil(objCluFid);
  End;

end;

function TFatVenda.fGravaCadRecComProDocsConfirmados(dicDocsConf: TDicionario): Boolean;
  Var
    strHistor: String;
    strNomArq: String;
    strNumDup: String;
    intDocume: Integer;
    fltValCom: Double;
    documento: TDocumentoConf;
    qryComPro: TUniQuery;

  function fJaExisteCadRecDaComissao(docVenda: TDocumentoConf): Boolean;
    Var
      qryGen: TUniQuery;
  begin

    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Add('SELECT');
      Add('  COUNT(*) AS QTD');
      Add('FROM');
      Add(' CADREC ');
      Add('WHERE');
      Add('  CTR_ESPDOC = "CC"    AND');
      Add('  CTR_DOCDIV = :DOCDIV AND');
      Add('  CTR_ESPDIV = :ESPDIV AND');
      Add('  CTR_CLIDIV = :CLIDIV AND');
      Add('  CTR_EMPDIV = :EMPDIV    ');

      ParamByName('DOCDIV').AsString := docVenda.strNumDoc;
      ParamByName('ESPDIV').AsString := docVenda.strEspDoc;
      ParamByName('CLIDIV').AsString := docVenda.strCodCli;
      ParamByName('EMPDIV').AsString := docVenda.strCodEmp;

      Open;

      Result := FieldByName('QTD').AsInteger > 0;
    End;

    FreeAndNil(qryGen);

  end;

begin
  Result := True;

  If fCfgSis('TCOPRO') <> '2' Then
    Exit;

  qryComPro := fCriaQuery;

  With qryComPro, SQL Do
  Begin
    Add('SELECT ');
    Add('  CLI_CODCLI, ');
    Add('  COM_CREDEB, ');
    Add('  COM_VRVEND, ');
    Add('  COM_VRCOMI  ');
    Add('FROM ');
    Add('  COMPRO ');
    Add('  INNER JOIN CADDIV ON DIV_CODDIV = COM_CODPRO ');
    Add('  INNER JOIN CADCLI ON CLI_CODCLI = DIV_CODCLI ');
    Add('WHERE ');
    Add('  COM_NUMDOC = :NUMDOC AND ');
    Add('  COM_ESPDOC = :ESPDOC AND ');
    Add('  COM_CODEMP = :CODEMP AND ');
    Add('  COM_CODCLI = :CODCLI  ');
    Add('ORDER BY ');
    Add('  COM_CODPRO ');
  End;

  strNomArq := 'CADREC';

  For intDocume := 0 To dicDocsConf.Chaves.Count -1 Do
  Begin
    documento := TDocumentoConf(dicDocsConf.RetornaObjeto(dicDocsConf.Chaves[intDocume]));

    If Not Assigned(documento) Then
      Continue;

    If ((documento.strEspDoc = 'FF') And (fCfgSis('CPROFF') = '2')) Or   //FF pela data da confirmacao
       ((documento.strEspDoc = 'TR') And (fCfgSis('CPROTR') = '2')) Or   //TR pela data da confirmacao
       ((documento.strEspDoc = 'DV') And (fCfgSis('CPROTR') = '2')) Then //DV pela data da confirmacao
    Begin
      If fJaExisteCadRecDaComissao(documento) Then
        Continue;

      With qryComPro Do
      Begin
        Close;
        ParamByName('NUMDOC').AsString := documento.strNumDoc;
        ParamByName('ESPDOC').AsString := documento.strEspDoc;
        ParamByName('CODEMP').AsString := documento.strCodEmp;
        ParamByName('CODCLI').AsString := documento.strCodCli;
        Open;

        First;

        While Not Eof Do
        Begin

          If FieldByName('COM_CREDEB').AsString = 'C' Then
          Begin
            strHistor  := 'CREDITO COM.PROFISS.';
            fltValCom  := FieldByName('COM_VRCOMI').AsFloat * (-1);
          End
          Else
          Begin
            strHistor := 'DEBITO COM.PROFISS.';
            fltValCom  := FieldByName('COM_VRCOMI').AsFloat;
          End;

          strHistor := strHistor + 'REF.DOCUM. ' + documento.strNumDoc + '-' +
                                                   documento.strEspDoc + '-' +
                                                   documento.strCodEmp + '-' +
                                                   documento.strCodCli + ' ' +

                                   'CONFIRM.DOCUM. ' + strNumDoc    + '-' +
                                                       strEspDoc    + '-' +
                                                       VS_strCodEmp + '-' +
                                                       strCodCli;

          strNumDup := fRetSequencial('PROCCO', VS_strCodEmp, fTamDocCadRec);

          Result := fGravaCadRec(strNomeForm,
                                 'INCLUSÃO',
                                 strNumDup,                                 // Duplicata
                                 'A',                                       // Parcela
                                 0,                                         // Seq. Baixa
                                 'CC',                                      // Especie
                                 FieldByName('CLI_CODCLI').AsString,        // Cliente
                                 VS_strCodEmp,                              // Empresa
                                 strCodVen,                                 // Vendedor
                                 strCodDig,                                 // Digitador
                                 fRetornaCodPorComProfCadRec(strCodPor),    // Portador
                                 Self.VS_Date,                              // Data de cadastro
                                 Self.VS_Date,                              // Data de Vencimento
                                 fltValCom,                                 // Valor da Duplicata
                                 fltValCom,                                 // Valor Original
                                 0.0,                                       // Despesa de Cobrança
                                 'N',                                       // Desconto
                                 strHistor,                                // Histórico 1
                                 '',                                        // Histórico 2
                                 '',                                        // Portador da Baixa
                                 '',                                        // Centro de Custo da Baixa
                                 '',                                        // Operador da Baixa
                                 '',                                        // Documento da Baixa
                                 0.0,                                       // Valor do Recebimento
                                 0,                                         // Data do Recebimento
                                 'N',
                                 '',                                        // Código do Evento
                                 strPedSit,                                 // Código Velho (CONVERSÃO)
                                 '',                                        // Tipo de Fora (Condição de Pagamento)
                                 '',                                        // Código da Condição de Pagamento
                                 False,
                                 '',                                        // Codigo do Centro de Custo
                                 0,                                         // Sequencial de Controle
                                 0,
                                 '',                                        // Observação de Agrupamento 1
                                 '',                                        // Observação de Agrupamento 2
                                 '',                                        // Observação de Agrupamento 3
                                 '',
                                 0,
                                 0,
                                 0,
                                 0,
                                 '',
                                 '',                                        // Empresa de Origem
                                 strNumDoc,
                                 strEspDoc,
                                 VS_strCodEmp,
                                 strCodCli,
                                 0,
                                 0,
                                 '',
                                 0,
                                 0,
                                 'N',
                                 0,
                                 0,
                                 fltValCqP,
                                 fltValCqV,
                                 fltValDin,
                                 fltValCar,
                                 fltValOrd,
                                 fltValFin);

          If Not Result Then
            Break;

          Next;

        End; //Fim do While Not Eof Do

      End; //Fim do With qryComPro

    End;

  End;

  {If Length(arrLogCtr) > 0 Then
    Result := Result And fGravaLogCtr(arrLogCtr);}

  FreeAndNil(qryComPro);
end;

