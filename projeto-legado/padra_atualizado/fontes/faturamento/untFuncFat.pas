function TFatVenda.fGetMargemLucroPedido(const qryGenDor: TUniClientDataSet; const AImpostos: TImpostosSubItensEstrutura; const fltCusIte, fltUniDigDescontada: Double; const strCodAbf: String): Double;
  Var
    fltAliqDifal : Double;
    fltFCPIcms : Double;
    fltComliq : Double;
    fltVlrCam : Double;
    fltImcSTPV : Double;
    blnCalcST : Boolean;
    strCodCam: String;
begin
  fltAliqDifal := 0;
  fltFCPIcms := 0;

  If (Not fCfgSis('CLPVDI', varBoolean, GetEmpCfg(qryGenDor.FieldByName('ITE_EMPITE').AsString))) Then
    fltAliqDifal := Self.fGetAlqDifal(qryGenDor.FieldByName('ITE_CODITE').AsString, qryGenDor.FieldByName('ITE_EMPITE').AsString, strCodAbf, qryGenDor.FieldByName('FDO_CODFIS').AsString);

  If (Not fCfgSis('CLPVDI', varBoolean, GetEmpCfg(qryGenDor.FieldByName('ITE_EMPITE').AsString))) And (qryGenDor.FieldByName('FDO_VALRET').AsFloat = 0) And (qryGenDor.FieldByName('FDO_BASICM').AsFloat <> 0) Then
    fltFCPIcms := Self.fGetAlqFcpIcms(qryGenDor.FieldByName('ITE_CODITE').AsString, qryGenDor.FieldByName('ITE_EMPITE').AsString, strCodAbf, qryGenDor.FieldByName('FDO_CODFIS').AsString, AImpostos.fltIcmSai, fltUniDigDescontada);

  fltComliq := 0;
  If (blnEmCampanha) And
     (fCfgSis('MARMKP') = '4') Then
  Begin
    objCamGer.objCamDet.fVerificaProdutoCampanha(qryGenDor.FieldByName('FDO_CODCLI').AsString,
                                                 qryGenDor.FieldByName('ITE_CODITE').AsString,
                                                 EmptyStr,
                                                 EmptyStr,
                                                 0,
                                                 fltVlrCam,
                                                 strCodCam,
                                                 fltComliq);
  End;

  objIcStPv.pAdd(qryGenDor.FieldByName('ITE_CODITE').AsString,
                 fGetEmpCalculoItem(qryGenDor.FieldByName('ITE_EMPITE').AsString),
                 Self.GetTipAbf(qryGenDor.FieldByName('ITE_EMPITE').AsString),
                 Self.fUFDestTrib(qryGenDor.FieldByName('ITE_EMPITE').AsString),
                 qryGenDor.FieldByName('FDO_CODFIS').AsString,
                 fltImcSTPV,
                 blnCalcST,
                 0,
                 fltComliq);

  Result := fCalculaPrecoVenda(2,
                               fltCusIte,
                               fltUniDigDescontada,
                               0,
                               qryGenDor.FieldByName('FDO_ALQICM').AsFloat + fAlqDifIcmsPrecoDinamico(qryGenDor.FieldByName('ITE_CODITE').AsString, qryGenDor.FieldByName('ITE_EMPITE').AsString, strCodAbf, qryGenDor.FieldByName('ABF_CODFIS').AsString, AImpostos.fltIcmSai),
                               AImpostos.fltImpFed,
                               AImpostos.fltDesOpe,
                               fRetornaValCom(qryGenDor.FieldByName('ITE_COMTBL').AsFloat),
                               VS_strMARMKP,
                               '',
                               -1,
                               fltImcSTPV,
                               blnCalcST,
                               fltAliqDifal,
                               fltFCPIcms,
                               AImpostos.fltOutVal,
                               fRestringirElementosMargem);
end;

function TFatVenda.fGetImpostosDoCustoRealPedido(const qryGenDor: TUniClientDataSet; const fltQuantidade, fltUniDigDescontada, fltIcmsSaiIte: Double): TImpostosSubItensEstrutura;
begin
  FillChar(Result, SizeOf(Result), #0);
  Result.strCodIte := qryGenDor.FieldByName('FDO_CODITE').AsString;
  Result.strEmpIte := qryGenDor.FieldByName('FDO_EMPITE').AsString;
  Result.fltQtdPai := fltQuantidade;
  Result.fltUniPai := fltUniDigDescontada;

  If fUtilizaPrecoSubItensEstrutura(Pos('ITEM ESPECIAL', qryGenDor.FieldByName('ITE_DESITE').AsString) > 0,
                                    qryGenDor.FieldByName('FDO_CODITE').AsString) Then
    pRetImpostosSubItensEstrutura(Result)
  Else
  Begin
    Result.fltOutVal := fRetOutVal(qryGenDor.FieldByName('ITE_OUTVAL').AsFloat);
    Result.fltDesOpe := fRetDesOpe(qryGenDor.FieldByName('ITE_DESOPE').AsFloat);
    Result.fltIcmSai := fltIcmsSaiIte;
    Result.fltImpFed := fRetImpFed(qryGenDor.FieldByName('ITE_IMPFED').AsFloat);
  End;
end;

function TFatVenda.fValidaPrecoSugeridoTERegimeEspecialVendaNormalComoPedido():Boolean;
var
  intIndex: Integer;
  qryConIte: TUniQuery;
  strItens: String;
  blnTravou: Boolean;
  strEmpres: String;
begin
  Result := True;

  If (Not fAlgumaEmpresaUtilizaRegimeEspecial()) Then
    Exit;

  qryConIte := fCriarQueryIteGer();
  Try
    strItens := '';
    blnTravou := False;

    strEmpres := fCfgSis('EMPRES', VarString);

    For intIndex := 0 To PRed(Length(arrMatItens)) Do
    Begin
      If fCfgSis('UTI_RE', VarBoolean, arrMatItens[intIndex].strEmpIte) And
         (Not SameText(arrMatItens[intIndex].strEmpIte, strEmpres)) Then
      Begin
        qryConIte.Close;
        qryConIte.ParamByName('CODITE').AsString := arrMatItens[intIndex].strCodIte;
        qryConIte.ParamByName('CODEMP').AsString := arrMatItens[intIndex].strEmpIte;
        qryConIte.Open;

        If (fPegaPrecoSugeridoTE(qryConIte, arrMatItens[intIndex].strEmpIte, arrMatItens[intIndex].strPromoc) <= 0.00) Then
        Begin
          blnTravou := True;
          strItens := strItens + 'Empresa: ' + arrMatItens[intIndex].strEmpIte +
                                 ' Item: ' + arrMatItens[intIndex].strCodIte + ' - ' +
                                 arrMatItens[intIndex].strDesIte + #10+#13;
        End;
      End;
    End;

    If blnTravou Then
    Begin
      Result := False;

      fMensagem('ATENÇÃO!', 'Não é possível selecionar o tipo de documento PEDIDO ' +
                            'pois existem itens com o ' + fDescricaoCampoPrecoSugeridoTE + ' zerado quando (CFG_UTI_RE = SIM). ' +#10+#13+
                            'Por favor verifique este preço no cadastro dos produtos!' +#10+#13+
                            strItens, ['&Ok']);
    End;
  Finally
    FreeAndNil(qryConIte);
  End;
end;

function fTemFatorServico(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
var
  strAutIncPD: String;
begin
  Result := False;

  if fEmptyStr(strNumDoc) then
    Exit;

  if fEmptyStr(strCodEmp) then
    Exit;

  if fEmptyStr(strEspDoc) then
    Exit;

  if Pos(strEspDoc, 'PD_OR_') <= 0 then
    Exit;

  strAutIncPD := fCampoTabela('AUTOINCREM','FATGOR',['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'],[strNumDoc, strEspDoc, strCodEmp]);

  if fEmptyStr(strAutIncPD) then
    Exit;

  Result := (fCampoTabela('FGO_FATSER','EXTGOR',['FGO_SEQFGO'],[strAutIncPD]) > 0);
end;

function TFatVenda.fNomeProfissionais: String;
  Var
    strNomProfiss : String;
Begin
  Result := EmptyStr;

  If (Not Assigned(cdsProfiss)) Then
    Exit;

  If (Not cdsProfiss.Active) Then
    Exit;

  If (cdsProfiss.IsEmpty) Then
    Exit;

  cdsProfiss.First;
  While Not cdsProfiss.Eof Do
  Begin
    strNomProfiss := strNomProfiss + IIF(strNomProfiss.IsEmpty,'',', ') + cdsProfiss.FieldByName('DIV_CODDIV').AsString +
                     ' - ' + cdsProfiss.FieldByName('DIV_NOMDIV').AsString;
    cdsProfiss.Next;
  End;
  Result := strNomProfiss;
End;

function TFatVenda.fRetornaDataEntregaValida(strNumOrc, strEspOrc, strEmp_TE: String; dtaDataEntFGO: TDateTime): TDateTime;
var
  strCodEmp: String;
  blnTemItemEntregaImediataOuHerancaOrcamentoPedido: Boolean;
  blnDataInvalida: Boolean;
  blnRetornaDataAtual: Boolean;
begin
  strCodEmp := IIF(fEmptyStr(strEmp_TE), VS_strCodEmp, strEmp_TE);
  blnTemItemEntregaImediataOuHerancaOrcamentoPedido := ((fTemItensEntregaImediata(strNumOrc, strEspOrc, strCodEmp)) or (blnHerancaOrcamentoPedido));
  blnDataInvalida := ((dtaDataEntFGO < VS_Date) or (DateToStr(dtaDataEntFGO) = '31/12/9999'));
  blnRetornaDataAtual := (blnTemItemEntregaImediataOuHerancaOrcamentoPedido and blnDataInvalida);

  Result := IIF(blnRetornaDataAtual, VS_Date, dtaDataEntFGO);
end;

function fEhDocumentoComDevolucaoAutomatizadaParaDocumentosDeOutrasEmpresas(
  const strNumDoc, strEspDoc, strCliFor : String): Boolean;
var
  qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  Try
    qryConsulta.Close;
    qryConsulta.SQL.Text := 'SELECT AUTOINCREM FROM MOVGER '
                          + ' WHERE GER_NUMDOC = :NUMDOC '
                          + '   AND GER_ESPDOC = :ESPDOC '
                          + '   AND GER_CODCLI = :CODCLI '
                          + '   AND GER_CODEMP = :CODEMP '
                          + '   AND GER_MEN001 = :MEN001 ';

    qryConsulta.ParamByName('NUMDOC').AsString := strNumDoc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspDoc;
    qryConsulta.ParamByName('CODCLI').AsString := strCliFor;
    qryConsulta.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryConsulta.ParamByName('MEN001').AsString := MEN001_TRANSF_REF_DEV_AUT_DOCS_OUT_EMP;
    qryConsulta.Open;

    Result := Not qryConsulta.FieldByName('AUTOINCREM').AsString.IsEmpty;
  Finally
    FreeAndNil(qryConsulta);
  End;
end;

