procedure TFatVenda.pAjustarHistoricoDeOcorrenciaAposDevolucao;
  Var
    strCdOcor: String;
    strNumPD : String;
    strEmpPD : String;
    stlPedDev: TStringList;
    intCont  : Integer;
begin
  stlPedDev := TStringList.Create;

  Try
    For intCont := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If (stlPedDev.IndexOf(arrMatItens[intCont].strDocDev) >= 0) Then
        Continue
      Else
        stlPedDev.Add(arrMatItens[intCont].strDocDev);

      pRetNumeroPedidoVenda(arrMatItens[intCont].strDocDev,
        arrMatItens[intCont].strEspDev, arrMatItens[intCont].strEmpDev,
        Self.strCodCli, strNumPD, strEmpPD);

      If (fPedidoTotalmenteDevolvido(strNumPD, strEmpPD)) Then
      Begin
        strCdOcor := fRetornaCodigoOcorrencia(strNumPD, 'PD', '', strEmpPD, '');

        If (fFinalizarOcorrenciaAposDevolucaoTotal(strNumPD, strEmpPD)) Then
          pFinalizaOcorrencia(strCdOcor, strEmpPD);

        pGravaHistoricoDevolucaoTotal(strCdOcor, strEmpPD);
      End;
    End;
  Finally
    FreeAndNil(stlPedDev);
  End;
end;

