procedure TFatVenda.pNfeInfAdicVoucherClubeDoPintor( strNumDoc, strEspDoc, strCodEmp: String);
var
  qryTemCNF_NFE: TUniQuery;
begin

  qryTemCNF_NFE := fCriaQuery(Self);

  Try

    qryTemCNF_NFE.SQL.Clear;
    qryTemCNF_NFE.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryTemCNF_NFE.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryTemCNF_NFE.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strVoucherClubeDoPintor%'));
    qryTemCNF_NFE.Open;

    If qryTemCNF_NFE.FieldByName('USAMOVMOD').AsInteger > 0 Then
    Begin
      If Not fEmptyStr(strVchCdp) Then
        fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, 'Voucher Clube do Pintor: ' + strVchCdp, EmptyStr);
    End;
  Finally
    FreeAndNil(qryTemCNF_NFE);
  End;
end;

