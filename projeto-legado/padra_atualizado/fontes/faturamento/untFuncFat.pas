  objLiberacao.strSequencialUnicoDtaHra := FSequencialUnicoDtaHrLogVar;
  objLiberacao.blnExibirAvisosTravaRemota := Self.blnExibirAvisosTravaRemota;
  Result := fMensagemLiberacao(objLiberacao, strNTrava, stlNumLib);
end;

function TFatVenda.fGravaNotaDeConcreto(pgbStatus: TcxProgressBar): Boolean;
  Var
    strIteConcr,
    strNotaProd,
    strNotaServ,
    strInfAdcItem: String;

    fltQtdConcr,
    fltCusConcr,
    fltVlIssSav,
    fltFreteSav,
    fltDesAceSav,
    fltDesEspSav,
    fltPorDesSav,
    fltTotCadRecSav,
    fltTotGerSav: Double;
    dadosOriginal: OleVariant;

    fltTotTmp: Double;
    intIndMat: Integer;
    blnMostraDigDuplic: Boolean;
    arrDatas: TDateArray;

    intSequencialVendaConcreto: Integer;

    {*******************************************}
    {* OBJETOS PARA GERAR CONTRATO DE EMPREITA *}
    {*****************************************FC}
    objContratoEmpreita : IContratoEmpreita;
    objDadosCliente     : IDadosCliente;
    objDadosEmpresa     : IDadosEmpresa;
    objLocalObra        : ILocalObra;
    objItensContrato    : IItensContrato;
    objItensContratoList: IBaseList;

  procedure pCarregaDadosContrato;
  begin
    If (fCfgSis('TPNFCR') <> PRESTCON) And fCfgSis('IMPCTR', varBoolean) Then
    Begin
      objDadosCliente           := Factory.Create('DadosCliente') as IDadosCliente;
      objDadosCliente.Nome      := fRetNomCliente(strCodCli);
      objDadosCliente.Fone      := strCliTel;
      objDadosCliente.Fax       := strCliFax;
      objDadosCliente.Endereco  := strCliEnd;
      objDadosCliente.Email     := fRetEmailCliente(strCodCli);
      objDadosCliente.Municipio := strCliCid;
      objDadosCliente.Estado    := strCliEst;
      objDadosCliente.Cep       := strCliCep;
      objDadosCliente.CnpjCpf   := strCliCgc;
      objDadosCliente.IE        := strCliIes;

      objDadosEmpresa := TContratoEmpreitaHelper.fPreencheDadosEmpresa(VS_strCodEmp);

      objLocalObra              := Factory.Create('LocalObra') as ILocalObra;
      objLocalObra.Endereco     := IIF(strEndEnt <> '', strEndEnt, strCliEnd);
      objLocalObra.Bairro       := IIF(strBaiEnt <> '', strBaiEnt, strCliBai);
      objLocalObra.Municipio    := IIF(strCidEnt <> '', strCidEnt, strCliCid);
      objLocalObra.Estado       := IIF(strEstEnt <> '', strEstEnt, strCliEst);
      objLocalObra.Cep          := IIF(strCepEnt <> '', strCepEnt, strCliCep);
      objLocalObra.NaturezaObra := strCodObr + ' - ' + strCodArt;
    End;
  end;

  procedure pCarregaItensContrato;
    Var
      intItem: Integer;
  begin
    If (fCfgSis('TPNFCR') <> PRESTCON) And fCfgSis('IMPCTR', varBoolean) Then
    Begin
      objItensContratoList := Factory.CreateList;

      For intItem := 0 To Length(arrMatItens) -1 Do
      Begin
        Self.strItemConcreto := Self.strItemConcreto +
          arrMatItens[intItem].strCodIte + '-' + arrMatItens[intItem].strDesIte + ', ';

        objItensContrato               := Factory.Create('ItensContrato') as IItensContrato;
        objItensContrato.Volume        := arrMatItens[intItem].fltQtdIte;
        objItensContrato.DescricaoItem := arrMatItens[intItem].strDesIte;
        objItensContrato.Valor         := arrMatItens[intItem].fltTotIte - arrMatItens[intItem].fltDesEsp;
        objItensContratoList.Add(objItensContrato);
      End;
    End;
  end;

  procedure pGerarContrato;
  begin
    If (Not fEmptyStr(strNotaProd)) And
       (fCfgSis('TPNFCR') <> PRESTCON) And fCfgSis('IMPCTR', varBoolean) Then
    Begin
      objContratoEmpreita                := Factory.Create('ContratoEmpreita') as IContratoEmpreita;
      objContratoEmpreita.NumeroContrato := strNotaProd;
      objContratoEmpreita.DadosCliente   := objDadosCliente;
      objContratoEmpreita.DadosEmpresa   := objDadosEmpresa;
      objContratoEmpreita.LocalObra      := objLocalObra;
      objContratoEmpreita.ItensContrato  := objItensContratoList;
      TContratoEmpreitaHelper.fGeraContratoEmpreita(objContratoEmpreita, Self);
    End;
  end;

  function fItem(strCampo: String): TField;
  begin
    Result := cdsVenda.FieldByName('ITE_' + strCampo);
  end;

  procedure pZeraValores;
  begin
    Self.fltValIss    := 0.0;
    Self.fltValFre    := 0.0;
    Self.FFreAnt      := 0.0;
    Self.fltDesAce    := 0.0;
    Self.fltDesEsp    := 0.0;
    Self.fltPorDes    := 0.0;
    Self.fltTotCadRec := 0.0;
  end;

  procedure pAtualizaVariaveisOriginal;
  begin
    blnSimplesRemessaConcretoDadosCliente := False;
    blnSimplesRemessaConcreto             := False;

    blnNotaServicoConcreto     := False;
    intSequencialVendaConcreto := 0;
    cdsVenda.Data       := dadosOriginal;
    cdsVenda.LogChanges := False;
    Self.strEspDoc      := 'NS';
    Self.fltValIss      := fltVlIssSav;
    Self.fltValFre      := fltFreteSav;
    Self.fltDesAce      := fltDesAceSav;
    Self.fltDesEsp      := fltDesEspSav;
    Self.fltPorDes      := fltPorDesSav;
    Self.fltTotCadRec   := fltTotCadRecSav;
    Self.fltTotGer      := fltTotGerSav;

    If MatchStr(strOpcDoc,['VN','CP']) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
      pCarregaDadosClienteBaixa(Self.strCodCliOri, True);
  End;

  procedure pPreparaDocumentoParaGravar(strEspecie: String);
  begin
    pPreencheMatrizFechamento;

    pZeraValores;

    pCalculaTotGer;

    Self.strEspDoc := strEspecie;

    If ((Self.strEspDoc = 'NS') And (fCfgSis('TPNFCR') = CONCREMASSA)) Or          //CONCREMASSA
       ((Self.strEspDoc = 'NF') And (fCfgSis('TPNFCR') = FIGUEIREDO))  Or          //FIGUEIREDO
       ((Self.strEspDoc = 'NF') And (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO)) Then //J_A_MASSA_CONCRETO
    Begin
      Self.fltValFre := fltFreteSav;
      Self.fltDesAce := fltDesAceSav;
      pCalculaTotGer;
    End;

    If Self.strEspDoc = 'NS' Then
      Self.fltValIss := fltVlIssSav;

    pDestacaRetencoes;
    pRetemImpostosNoDescontoEspecial;
    pCalculaTotGer;

    pCalculaTotalParaCadRec;
    pRateiaValores;

    blnMostraDigDuplic := False;

    Result := fDigitaDuplicata(blnMostraDigDuplic,
                               arrDatas,
                               dtaPreAnt,
                               True,
                               arrDuplicCop);

    If fltValAdt + IIF(blnBolVen, 0, fltBolAdt) > 0 Then
    Begin
      Result := Result And fAdicionaAdiantamentoPrimeiraParcela;
    End;

  End;

  procedure pSetaPrecoCusto;
  begin
    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      cdsVenda.Edit;

      fItem('UNIDIG').AsFloat := fItem('PRECUS').AsFloat;
      fItem('UNITAR').AsFloat := fItem('PRECUS').AsFloat;
      fItem('TOTITE').AsFloat := fItem('TOTCUS').AsFloat;
      fItem('DESCON').AsFloat := 0;

      cdsVenda.Post;
      cdsVenda.Next;
    End;
    cdsVenda.First;
  end;

  procedure pSetaSequencialConcretoItens;
    Var
      intIndex: Integer;
  begin
    For intIndex := 0 To Length(arrMatItens) -1 Do
      If arrMatItens[intIndex].intSeqCcr = 0 Then
        arrMatItens[intIndex].intSeqCcr := intSequencialVendaConcreto;
  end;

begin
  Result := False;

  dadosOriginal   := cdsVenda.Data;

  fltVlIssSav     := Self.fltValIss;
  fltFreteSav     := Self.fltValFre;
  fltDesAceSav    := Self.fltDesAce;
  fltDesEspSav    := Self.fltDesEsp;
  fltPorDesSav    := Self.fltPorDes;
  fltTotCadRecSav := Self.fltTotCadRec;
  fltTotGerSav    := Self.fltTotGer;

  {**************************************************************}
  {* SE CASO ESTIVER HABILITADO PARA GERAR CONTRATO DE EMPREITA *}
  {* GERA O WORD E EXIBE PARA O USUÁRIO IMPRIMIR O DOCUMENTO    *}
  {************************************************************FC}
  pCarregaDadosContrato;

  intSequencialVendaConcreto := StrToInt(fRetSequencial('SEQCCR'));

  If MatchStr(strOpcDoc,['VN','CP']) And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
  Begin
    Self.strCodCliOri := Self.strCodCli;

    strInfAdcItem := '';
    strInfAdcItem := strInfAdcItem + 'Endereço da Obra: ' + fDescricaoEnderecoEntrega + ' - ';
    strInfAdcItem := strInfAdcItem + 'Cliente: ' + strCliNom + '(' + strCodCli + ') ';
    strInfAdcItem := strInfAdcItem + 'CNPJ: ' + fFormataCpfCgc(strCliCgc, fSetaPais);
  End;

  Try
    {******************************************}
    {* EMISSAO DE NOTA DE SERVICO DE CONCRETO *}
    {***************************************JC*}
    If (fCfgSis('TPNFCR') = CONCREMASSA) Or          //Concremassa
       (fCfgSis('TPNFCR') = FIGUEIREDO)  Or          //Figueiredo
       ((fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And blnConfirmandoNotaFiscalConcreto) Then //J_A_MASSA_CONCRETO
    Begin
      Self.strEspDoc := 'NS';
      pgbStatus.Position := 0;

      Self.strItemConcreto := '';
      Self.fltTotSerConcreto := 0;

      pCarregaItensContrato;

      {***************************************************************}
      {* PREPARA PARA EMITIR NOTA DE SERVICO COM PRECO DE CUSTO ZERO *}
      {* E PRECO DE VENDA LIQUIDO (PRECO DE VENDA - PRECO DE CUSTO)  *}
      {************************************************************JC*}
      If (fCfgSis('TPNFCR') = FIGUEIREDO) Then
      Begin
        For intIndMat := 0 To Length(arrMatItens) -1 Do
        Begin
          strIteConcr := arrMatItens[intIndMat].strCodIte;
          fltQtdConcr := arrMatItens[intIndMat].fltQtdIte;

          fltCusConcr := RoundTo(fCalculaPrecoEstrutura(False, Preco_de_Custo, strIteConcr, arrMatItens[intIndMat].strEmpIte, 'S', '', 0, fltQtdConcr), -2);

          fltTotTmp := (arrMatItens[intIndMat].fltTotIte - arrMatItens[intIndMat].fltDesEsp - fltCusConcr);

          If fltTotTmp <= 0 Then
            Raise ExceptionAutCom.Create('Não é possível emitir esta Nota de Serviço, ' +
                                         'pois o preço de venda total do produto concreto (' + arrMatItens[intIndMat].strDesIte +
                                         ') é menor que o custo total dos sub-produtos!');

          If cdsVenda.Locate('AUTOINCREM', arrMatItens[intIndMat].intAutInc, []) Then
          Begin
            cdsVenda.Edit;

            fItem('UNIDIG').AsFloat := fltTotTmp / fltQtdConcr;
            fItem('UNITAR').AsFloat := fltTotTmp / fltQtdConcr;
            fItem('TOTITE').AsFloat := fltTotTmp;
            fItem('DESCON').AsFloat := 0.00;
            fItem('PRECUS').AsFloat := 0.00;
            fItem('TOTCUS').AsFloat := 0.00;
            fItem('TOTCU2').AsFloat := 0.00;

            cdsVenda.Post;
          End;

        End;

        blnNotaServicoConcreto := True;

        pPreparaDocumentoParaGravar('NS');
      End

      Else

      If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      Begin

        blnNotaServicoConcreto := True;
        pPreparaDocumentoParaGravar('NS');

        If Self.fltTotBom > 0 Then
        Begin
          pInsereItemTaxaBombeamento(tbIteBom);
          pCalculaTotGer;
        End;

      End;

      Self.fltTotSerConcreto := Self.fltTotGer;

      pSetaSequencialConcretoItens;

      If Not fGravaArquivos(pgbStatus) Then
        Abort;

      strNotaServ := Self.strNumDoc;

      If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      Begin
        fMensagem('ATENÇÃO!', 'Nota de Concreto Emitida com Sucesso.' + #13#10 +
                              'Nota de Serviços Nº ' + strNotaServ, ['&Ok']);
      End;

    End;

    {************************************************************************}
    {* A NOTA DE SERVIÇO JÁ TEVE SUA strDesCla DEFINIDA NA TELA DE          *}
    {* DADOS FISCAIS.                                                       *}
    {* FORÇANDO Self.strDesCla := '' EU DEIXO POR CONTA DA fGravaArquivos O *}
    {* PREENCHIMENTO DA strDesCla REFERETE DA NF O QUE ME GARANTE QUE A     *}
    {* DESCRIÇÃO DA CLAFIS ESTARÁ IGUAL NO CADFIS, MOVGER E DANFE.          *}
    {**********************************************************************VA}
    Self.strDesCla := '';

    pgbStatus.Position := 0;

    If (fCfgSis('TPNFCR') = CONCREMASSA) Or          //Concremassa
       (fCfgSis('TPNFCR') = FIGUEIREDO)  Or          //Figueiredo
       ((fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And MatchStr(strOpcDoc,['VN','CP'])) Then //J_A_MASSA_CONCRETO
    Begin
      Self.strEspDoc := 'NF';
      //Concremassa
      If fCfgSis('TPNFCR') = CONCREMASSA Then
      Begin
        pZeraValores;
        blnSimplesRemessaConcretoDadosCliente := True;

        pSetaPrecoCusto;
        pPreencheMatrizFechamento;
        pCalculaTotGer;
        pRateiaValores;
      End
      //Figueiredo
      Else If ((fCfgSis('TPNFCR') = FIGUEIREDO) Or (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO)) Then
      Begin
        blnNotaServicoConcreto    := False;
        blnSimplesRemessaConcreto := True;

        cdsVenda.EmptyDataSet;

        For intIndMat := 0 To Length(arrMatItens) -1 Do
        Begin

          strIteConcr := arrMatItens[intIndMat].strCodIte;
          fltQtdConcr := arrMatItens[intIndMat].fltQtdIte;

          If ((fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And Assigned(fCarregaEstrutura)) And
             ((strOriF11 = 'S') Or (strOpcDocTrue = 'EI')) Then {<<== Caixa F11 ou Expedição ==>>}
            fCarregaEstrutura(arrMatItens[intIndMat], True)
          Else
            pCarregaEstrutura(strIteConcr, arrMatItens[intIndMat].strEmpIte, fltQtdConcr, 0, 0, 0, True); {<<== Venda Normal ==>>}

        End;

        pSetaPrecoCusto;
        pPreparaDocumentoParaGravar('NF');
      End;

      pSetaSequencialConcretoItens;

      pAtualizaDataHoraCadRecDocsConf;

      If Not fGravaArquivos(pgbStatus) Then
        Abort;

      strNotaProd := Self.strNumDoc;

      If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      Begin
        fMensagem('ATENÇÃO!', 'Nota de Concreto Emitida com Sucesso.' + #13#10 +
                              'Nota de Produtos Nº ' + strNotaProd, ['&Ok']);

      End
      Else
      Begin
        fMensagem('ATENÇÃO!', 'Nota de Concreto Emitida com Sucesso.' + #13#10 +
                              'Nota de Produtos Nº ' + strNotaProd    + #13#10 +
                              'Nota de Serviços Nº ' + strNotaServ    + #13#10 , ['&Ok']);
      End;

    End;

    If MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
    Begin
      If MatchStr(strOpcDoc,['VN','CP']) Then
      Begin
        Self.strEspDoc := 'NF';

        objFatVendaImp.blnImpBol := False;

        pCarregaDadosClienteBaixa(fRetornaClienteFilial(VS_strCodEmp), True);

        pCalculaTotGer;

        If Length(arrMatItens) > 0 Then
          arrMatItens[0].strDesNes := arrMatItens[0].strDesNes + strInfAdcItem;
      End
      Else If (strOpcDoc = 'CN') Then
      Begin
        Self.strEspDoc := 'NS';
        blnNotaServicoConcreto := True;

        If Self.fltTotBom > 0 Then
        Begin
          pInsereItemTaxaBombeamento(tbIteBom);
          pCalculaTotGer;
        End;
      End;

      pSetaSequencialConcretoItens;

      pCarregaItensContrato;

      If Not fGravaArquivos(pgbStatus) Then
        Abort;

      If MatchStr(strOpcDoc,['VN','CP']) Then
      Begin
        strNotaProd := Self.strNumDoc;
        fMensagem('ATENÇÃO!', 'Nota de Simples Remessa de Concreto Emitida com Sucesso.' + #13#10 +
                              'Nota Fiscal Nº ' + Self.strNumDoc, ['&Ok']);
      End
      Else If (strOpcDoc = 'CN') Then
        fMensagem('ATENÇÃO!', 'Nota de Serviços de Concreto Emitida com Sucesso.' + #13#10 +
                              'Nota Serviços Nº ' + Self.strNumDoc, ['&Ok']);
    End;

    {**************************************************************}
    {* SE CASO ESTIVER HABILITADO PARA GERAR CONTRATO DE EMPREITA *}
    {* GERA O WORD E EXIBE PARA O USUÁRIO IMPRIMIR O DOCUMENTO    *}
    {************************************************************FC}
    pGerarContrato;

    Result := True;

  Except
    On E: EAbort Do
    Begin
      fRollback;
      pAtualizaVariaveisOriginal;
    End;

    On E: ExceptionAutCom Do
    Begin
      fRollBack;
      pAtualizaVariaveisOriginal;
      pMensagemOk(E.Message);
    End;

    On E: Exception Do
    Begin
      fRollBack;
      pAtualizaVariaveisOriginal;
      pMensagensErro(E.Message, '[fGravaNotaDeConcreto]');
    End;
  End;

end;

