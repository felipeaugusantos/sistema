    Result := False;
end;

function TFatVenda.fPodeTerInformadoLoteParaTinta(strIdePro: String; strEmpCfg: String = ''): Boolean;
begin
  Result := True;

  If fUsaRotinaWMS(fEmpresaSaldoMatriz_CD) Or fCfgSis('TMQLOT', varBoolean, strEmpCfg) Or fInformaLoteBaseImobiliaria(strIdePro, True) Then
    Result := True
  Else If ((strIdePro <> 'NOR') And (Not fCfgSis('TMQLOT', varBoolean, strEmpCfg)) And (Not fInformaLoteBaseImobiliaria(strIdePro))) Then
    Result := False;
end;

function TFatVenda.fValidaPreenchimentoDoLote(const item : TDadosFechamento): Boolean;
begin
  Result := False;

  If (fEhItemServico(item.strCodIte)) Then
    Exit;

  If (Self.fEhDevolucaoDemonstracaoNotaEspecial(item.strDocDev, item.strEspDev, item.strEmpDev)) Then
    Exit;

  If (fItemFaturadoPorConsignacao(item.strSeqDet)) Then
    Exit;

  If (Not fValidaLoteBaixaEntregaFuturaOutraLoja(item.strEspFut, item.strEmpFut, item.strCodIte)) Then
    Exit;

  If (Not fPodeTerInformadoLoteParaTinta(item.strIdePro, item.strEmpIte)) Then
    Exit;

  Result := True;
end;

function TFatVenda.fValidaLoteBaixaEntregaFuturaOutraLoja(const strEspFut, strEmpFut, strCodIte: String): Boolean;
begin
  Result := True;

  if (Pos(strEspFut, 'NF_IF_FF') <= 0) then
    Exit;

  if not blnBaiEntFut then
    Exit;

  if strEmpFut = VS_strCodEmp then
    Exit;

  if fCampoTabela('COUNT(*)', 'CADLOT', ['LOT_CODEMP','LOT_CODITE'], [strEmpFut, strCodIte]) > 0 then
    Exit;

  if fCampoTabela('COUNT(*)', 'CADLOT', ['LOT_CODEMP','LOT_CODITE'], [VS_strCodEmp, strCodIte]) = 0 then
    Exit;

  Result := False;
end;

function TFatVenda.fTodosLotesInformados(Out strProdSemLote: String): Boolean;
Var
  item               : TDadosFechamento;
  blnUsarEmpresaItem : Boolean;
begin
   If blnTranferenciaDepositoFechado Then
     Exit(True);
  {******************************************************************}
  {* NOTA E CUPOM ESPECIAL NÃO MOVIMENTA ESTOQUE, E NÃO PEDE O LOTE *}
  {***************************************************************RN*}
  If (fPermiteGravarSemLotePreenchido) Then
  Begin
    Result := True;
    Exit;
  End;

  strProdSemLote := '';

  // Percorre todos os itens
  For item In arrMatItens Do
  Begin
    If (fValidaPreenchimentoDoLote(item)) Then
    Begin
      // Se estiver sem lote
      If fEmptyStr(item.strNumLot) Then
      Begin
        blnUsarEmpresaItem := (blnEmpfat) Or (blnPedidoContemItemPrioridade) Or
                              ((strOpcDoc = 'VN') And (strOriF11 = 'S') And
                               (Not fCfgSis('EMPFVN', varBoolean) And
                               (Not fEmptyStr(item.strEmpIte))));

        // Se existe lote para o item
        If objCadLot.fExisteLote(item.strCodIte, IIF(blnUsarEmpresaItem, item.strEmpIte, fEmpresaSaldoMatriz_CD)) And (Not item.blnProAca) Then
          strProdSemLote := strProdSemLote + item.strCodIte + ' - ' + item.strDesIte + #13#10;
      End;
    End;
  End;

  // Se houver algum item sem lote retorna false
  Result := fEmptyStr(strProdSemLote);
end;

