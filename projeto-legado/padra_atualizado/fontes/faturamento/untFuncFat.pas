{* CALCULA QUANTIDADE DE CODIGO FISCAL   *}
{**************************************MV*}
procedure TFatVenda.pCalculaQtdCodFis;
  Var
    intContador: Integer;
    stlCodFis: TStringList;
begin
  intQtdCfi := 0;
  strCodTri := '';
  Try
    stlCodFis := TStringList.Create;
    stlCodFis.Sorted := True;
    stlCodFis.Duplicates := dupIgnore;

    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      stlCodFis.Add(arrMatItens[intContador].strCodSit);
    End;

    intQtdCfi := stlCodFis.Count;
    strCodTri := stlCodFis.CommaText;
  Finally
    FreeAndNil(stlCodFis);
  End;

end;

function TFatVenda.fCustoRealTravaPreco(opCusto: TOpcaoCustoReal;
                                        fltUnitar: Double = 0;
                                        cdsItens: TUniClientDataSet = Nil;
                                        strTabPre: String = ''): Double;
  Var
    calcCustoReal: TCalcCustoReal;
    fltTaxaVlrPrz : Double;
    opcRetPreCus: TOpcPrecoEstrutura;
    strCodSit,
    strCodAbf: String;
begin
  Result := 0.0;

  pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                       qryConIte.FieldByName('ITE_CODEMP').AsString,
                       IIF(strTabPre.IsEmpty, Self.strTabPre, strTabPre));

  Case opCusto Of
    opCalcular: Begin
                  calcCustoReal := TCalcCustoReal.Create;
                  calcCustoReal.fltUnitar := fltUnitar;
                  calcCustoReal.fltPreCus := fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat);
                  calcCustoReal.fltOutVal := fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat);
                  calcCustoReal.fltImpFed := fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat);
                  calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat));

                  If fCfgSis('IMPCF4') = 'S' Then
                    calcCustoReal.fltIcmSai := fCalculaAliquota(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                                GetImpDir(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString))
                  Else
                    calcCustoReal.fltIcmSai := fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat);

                  strCodSit := '';
                  strCodAbf := fGetCodAbf(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
                  If (Not fEmptyStr(Self.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString))) And (fBuscaAbfIcm(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString, strCodAbf, fTrocaUFEndEntrega)) Then
                    strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString)).AsString;

                  calcCustoReal.fltDifal := fGetAlqDifal(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                         qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                         cdsAbfIcm.FieldByName('ABF_CODABF').AsString,
                                                         strCodSit);

                  calcCustoReal.fltFcp   := fGetAlqFcpIcms(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                           qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                           cdsAbfIcm.FieldByName('ABF_CODABF').AsString,
                                                           strCodSit,
                                                           calcCustoReal.fltIcmSai,
                                                           fltUnitar);

                  If (fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto) Then
                  Begin
                    fltTaxaVlrPrz := fGetTaxVprItem(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
                    opcRetPreCus := Trava_Preco_de_Custo_Real;
                  End
                  Else
                  Begin
                    fltTaxaVlrPrz := 0;
                    opcRetPreCus := Preco_de_Custo_Real;
                  End;

                  Result := fRetornaPrecoCusto(opcRetPreCus,
                                               qryConIte.FieldByName('ITE_CODITE').AsString,
                                               qryConIte.FieldByName('ITE_CODEMP').AsString,
                                               fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat),
                                               '',
                                               calcCustoReal,
                                               (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0),
                                               fltTaxaVlrPrz);
                  FreeAndNil(calcCustoReal);
                End;

    opVariaveis: Begin
                   Result :=  Self.fltPreCu2 *
                              (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100) + Self.fltOutVal;
                 End;

    opClientItens: Begin
                     Result := fFormataFloat(cdsItens.FieldByName( 'ITE_PRECU2' ).AsFloat, VS_intDecUni);
                   End;
  End;
end;


function TFatVenda.fPrecoMinimoMargemLiquida(opMargem     : TOpcaoMargemMinimaLiquida;
                                             strCodItem,
                                             strTabPreIte : String;
                                             fltMarMinIte : Double;
                                             cdsItens     : TUniClientDataSet;
                                             cdsIteTin    : TUniClientDataSet;
                                             strMarMin    : String): Double;
  Var
    fltAlqIcms : Double;
    fltCusto   : Double;
    blnRestringirElementosMargemOriginal : Boolean;

  function fUsaPrecoPelaMargemMinimaPorTodosComponentesTinta(cds: TUniClientDataSet): Boolean;
  begin
    Result := False;
    If (fAnalisaTodosCompomentesAoTravarUnitarioDeTintaComoProdutoNormal) Then
      If (Assigned(cds)) And (Not fEmptyStr(strMarMin)) Then
        If Assigned(cds.FindField('ITE_IDEPRO')) Then
          If (Not cds.IsEmpty) Then
            Result := (IfEmptyStr(cds.FieldByName('ITE_IDEPRO').AsString, 'NOR') <> 'NOR');
  end;

  function fRetPrecoPelaMargemMinimaPorTodosComponentesTinta(cds: TUniClientDataSet; strCampoMarMin: String; blAplicaJurosCnd: Boolean=False): Double;
    Var
      fltCusto_,
      fltMarMin: Double;
      intIdx: Integer;
      tintaDeMaquina: ITintaDeMaquina;
      strCodEmpTinta: String;
      dicInfEmp: TDicionario;
  begin
    Result := 0;
    Try
      If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
        strCodEmpTinta := VS_strCodEmp
      Else If Assigned(cds.FindField('ITE_EMPPRD')) And (Not fEmptyStr(cds.FieldByName('ITE_EMPPRD').AsString)) Then
        strCodEmpTinta := cds.FieldByName('ITE_EMPPRD').AsString
      Else If Assigned(cds.FindField('ITE_EMPITE')) And (Not fEmptyStr(cds.FieldByName('ITE_EMPITE').AsString)) Then
        strCodEmpTinta := cds.FieldByName('ITE_EMPITE').AsString
      Else strCodEmpTinta := VS_strCodEmp;

      pSetaEmpresaLogadaTinta(strCodEmpTinta);

      dicInfEmp := TDicionario.Create;
      dicInfEmp['oprflj'] := strOprFlj;
      dicInfEmp['empprd'] := fCfgSis('EMPPRD');
      dicInfEmp['emp_cd'] := fCfgSis('EMP_CD');
      dicInfEmp['Cd_S_N'] := IIF(blnEnt_CD, 'S', 'N');
      dicInfEmp['empfat'] := IIF(blnEmpFat, VS_strCodEmp, '');
      dicInfEmp['FatS_N'] := IIF(blnEmpFat, 'S', 'N');

      tintaDeMaquina := fGetITintadeMaquina(cds, dicInfEmp);

      for intIdx := 0 to tintaDeMaquina.Count - 1 do
      Begin
        If (TMargemMinima.UsaPrecoMedio) Then
          fltCusto_ := tintaDeMaquina[intIdx].PrecoMedio
        Else
          fltCusto_ := tintaDeMaquina[intIdx].PrecoCusto;

        If blAplicaJurosCnd Then
          fltCusto_ :=  fltCusto_ * (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100);

        fltMarMin :=  fCampoTabela(strCampoMarMin, 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [tintaDeMaquina[intIdx].CodIte, strCodEmpTinta], False);

        Result := Result + fCalculaPrecoVenda(1, fltCusto_,
                                                 0,
                                                 fltMarMin,
                                                 tintaDeMaquina[intIdx].IcmsSaida,
                                                 tintaDeMaquina[intIdx].ImpostosFederais,
                                                 fProcessarDespesasOperacionaisComplementar(tintaDeMaquina[intIdx].DespesasOperacionais),
                                                 fCampoTabela('ITE_COMTB' + strTabPre, 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [tintaDeMaquina[intIdx].CodIte, strCodEmpTinta], False),
                                                 fMarMpkParaVenda, '', -1, 0, False, 0, 0,
                                                 tintaDeMaquina[intIdx].OutrosValores,
                                                 fRestringirElementosMargem);
      End;
    Finally
      pSetaEmpresaLogadaTinta(VS_strCodEmp);

      If Assigned(dicInfEmp) Then
        FreeAndNil(dicInfEmp);
    End;
  end;

begin
  Result := 0;

  pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                       qryConIte.FieldByName('ITE_CODEMP').AsString,
                       IIF(strTabPreIte.IsEmpty, Self.strTabPre, strTabPreIte));

  blnRestringirElementosMargemOriginal := Self.blnRestringirElementosMargem;
  Try
    Self.blnRestringirElementosMargem := True;
    Case opMargem Of
      omCalcular: Begin
                    If fCfgSis('IMPCF4') = 'S' Then
                    Begin
                      fltAlqIcms := fCalculaAliquota(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                     qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                     GetImpDir(qryConCit.FieldByName('ITE_CODITE').AsString,
                                                               qryConIte.FieldByName('ITE_CODEMP').AsString));
                    End
                    Else
                      fltAlqIcms := fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat);

                    If (TMargemMinima.UsaPrecoMedio) Then
                      fltCusto := fGetPrecoMedioOperacao(qryConIte.FieldByName('ITE_PREMED'), qryConCit.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString)
                    Else
                      fltCusto := fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat);

                    Result := fCalculaPrecoVenda(1, fltCusto,
                                                    0,
                                                    fltMarMinIte,
                                                    fltAlqIcms,
                                                    fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat),
                                                    fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat)),
                                                    qryConIte.FieldByName('ITE_COMTB' + strTabPreIte).AsFloat,
                                                    fMarMpkParaVenda, '', -1, 0, False, 0, 0,
                                                    fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat),
                                                    fRestringirElementosMargem);

                    Result := Result * (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100);
                  End;

      omVariaveis: Begin
                     If fUsaPrecoPelaMargemMinimaPorTodosComponentesTinta(cdsIteTin) Then
                     Begin
                       Result := fRetPrecoPelaMargemMinimaPorTodosComponentesTinta(cdsIteTin, strMarMin, True);
                     End
                     Else
                     Begin
                       If (TMargemMinima.UsaPrecoMedio) Then
                         fltCusto := Self.fltPreMed * (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100)
                       Else
                         fltCusto := Self.fltPreCus * (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100);

                       Result := fCalculaPrecoVenda(1, fltCusto,
                                                       0,
                                                       fltMarMinIte,
                                                       Self.fltIcmSai,
                                                       Self.fltImpFed,
                                                       fProcessarDespesasOperacionaisComplementar(Self.fltDesOpe),
                                                       fRetComissaoTabelaItem(strCodItem, strTabPreIte),
                                                       fMarMpkParaVenda, '', -1, 0, False, 0, 0,
                                                       Self.fltOutVal,
                                                       fRestringirElementosMargem);
                     End;
                   End;

      omClientItens: Begin
                       If fUsaPrecoPelaMargemMinimaPorTodosComponentesTinta(cdsItens) Then
                       Begin
                         Result := fRetPrecoPelaMargemMinimaPorTodosComponentesTinta(cdsItens, strMarMin);
                       End
                       Else
                       Begin
                         If (TMargemMinima.UsaPrecoMedio) Then
                           fltCusto := fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), cdsItens.FieldByName('ITE_CODITE').AsString, IIF(cdsItens.FieldByName('ITE_EMPITE').AsString.IsEmpty, VS_strCodEmp, cdsItens.FieldByName('ITE_EMPITE').AsString))
                         Else
                           fltCusto := cdsItens.FieldByName('ITE_PRECUS').AsFloat;

                         Result := fCalculaPrecoVenda(1, fltCusto,
                                                         0,
                                                         fltMarMinIte,
                                                         cdsItens.FieldByName('ITE_ICMSAI').AsFloat,
                                                         cdsItens.FieldByName('ITE_IMPFED').AsFloat,
                                                         fProcessarDespesasOperacionaisComplementar(cdsItens.FieldByName('ITE_DESOPE').AsFloat),
                                                         cdsItens.FieldByName('ITE_COMTBL').AsFloat,
                                                         fMarMpkParaVenda, '', -1, 0, False, 0, 0,
                                                         cdsItens.FieldByName('ITE_OUTVAL').AsFloat,
                                                         fRestringirElementosMargem);
                       End;
                       Result := Result * (1 + IIF(fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto, fltTaxVpr, 0) / 100);
                     End;
    End;
  Finally
    Self.blnRestringirElementosMargem := blnRestringirElementosMargemOriginal;
  End;
end;

function TFatVenda.fGetPrecoMedioOperacao(const AField : TField; const ACodIte, ACodEmp : String) : Double;
begin
  Result := 0;
  If (Assigned(AField)) Then
    Result := AField.AsFloat;
  If (Result <> 0) Then
    Exit;
  Result := fCampoTabela('ITE_PREMED', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [ACodIte, ACodEmp], False);
end;


{******************************************}
{* CALCULA / TRAVA VALOR MINIMO           *}
{* OPCAO:                                 *}
{* 1 = USA O ITEM DIGITADO                *}
{* 2 = USA O ITEM ATUAL DO PROCESSAMENTO  *}
{***************************************WI*}
function TFatVenda.fRetornaUnitarioTrava(strIdeProIte: String; fltUnitar, fltUnitOrig, fltUniDev, fltQtdIte: Double;
                                     fltQtdJaDig: Double; fltQtdJaEmPromoc: Double; strEmpresaItem: String;
                                     strOpcao: String; blnVerPromocao: Boolean; var blnEmCamp: Boolean;
                                     strTabPreIte: String = '';
                                     intPraMed: Integer = 0; cdsItens: TUniClientDataSet = Nil; fltPreLot: Double = 0;
                                     intNivel : Integer = 0; blnEntIme: Boolean = False; blnEntFut: Boolean = False;
                                     strMotFut: String  = ''; strBarEmb: String = ''; blnProAcaIte: Boolean = False; blnIteCom: Boolean = False;
                                     fltPrecoSubItemEstrutura: Double = 0; fltVolPro: Double = 0;
                                     cdsIteTin: TUniClientDataSet = Nil; fltSomatorioColorantes : Double = 0): Double;
Const
  TRAVA_CUSTO_REAL = 'CUR';

Var
  strTraCam,
  strCodIte: String;
  fltQuanti: Double;

  fltTraFat: Double;
  fltQtdDis: Double;

  fltMarMin: Double;
  fltIcmSai: Double;
  fltImpFed: Double;
  fltDesOpe: Double;
  fltComTab: Double;

  blnIteEsp: Boolean;
  blnPromo : Boolean;
  blnParticiona: Boolean;
  blnDescontoCliente: Boolean;

  fltPreVenGer: Double;
  fltPreVenIte: Double;
  fltPreVenTraCam: Double;
  fltPreCusItem: Double;
  fltPreMedItem: Double;

  fltDesMax : Double;
  fltDesMaxIte : Double;

  blnTravarPeloPrecoPromocao: Boolean;

  strMarMin: String;

  fltUnitarEmbFechada: Double;

  blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco: Boolean;

  fltPreVenBar: Double;
  blnPrvEmb: Boolean;
  intPreEmb: Integer;
  strTabEmb: String;
  blnPerDesCliReg : Boolean;
  fltPerDesCliReg : Double;

  fltImcSTPV : Double;
  blnCalcST : Boolean;
  strCodSit : String;
  strCodAbf : String;
  fltAlqIcms : Double;

  blnRecPrvVenDin : Boolean;

  strLocTabPre,
  strLocTabPreIte: String;
  blnTabelaPrecoZerada : Boolean;

  blnTemEmbFec: Boolean;

  LstrUltDocumento : String;
  LfltCustoItem    : Double;
  fltComliq        : Double;
  fltVlrCam        : Double;
  fltDesPro        : Double;
  fltValorDeduzido : Double;
  strTabPrecoTrava : String;
  fltPrecoVendaTrava : Double;

  function fRetEmpresaUnitarioTrava : String;
  begin
    If strOpcao.Equals('1') Then
      Result := qryConIte.FieldByName('ITE_CODEMP').AsString
    Else
    Begin
      If Self.blnPraticarPrecosEmpresaFaturamento Then
        Result := fGetEmpCalculoItem()
      Else
        Result := VS_strCodEmp;

      If (cdsItens.FindField('ITE_EMPITE') <> Nil) And Self.blnEmpFat Then
        If Self.blnPraticarPrecosEmpresaFaturamento Then
          Result := fGetEmpCalculoItem(cdsItens.FieldByName('ITE_EMPITE').AsString)
        Else
          Result := IIF(cdsItens.FieldByName('ITE_EMPITE').AsString.IsEmpty, VS_strCodEmp, cdsItens.FieldByName('ITE_EMPITE').AsString);
    End;
  end;

  function fDescontoMaximoItem: Double;
    Var
      dataSetItem: TDataSet;
      strDesMax: String;
  begin

    If (TipoOpcaoDeTrava = totDescontoMaximoPorAtividade) Then
      Exit(fRetornaDescontoMaximoPorAtividade(fRetEmpresaUnitarioTrava, FCodCli, intNivel));

    If (strOpcao = '1') Then
      dataSetItem := qryConIte
    Else
      dataSetItem := cdsItens;

    Case intNivel Of
      1: strDesMax := 'ITE_DESMAX';
      2: strDesMax := 'ITE_DESMVM';
      3: strDesMax := 'ITE_DESMSU';
      4: strDesMax := 'ITE_DESMSM';
      5: strDesMax := 'ITE_DESMGE';
      6: strDesMax := 'ITE_DESMGM';
    End;

    If fCfgSis('ITETBP', VarBoolean) Then
    Begin
      Result := fGetDesMaxTabPre(dataSetItem.FieldByName( 'ITE_CODITE' ).AsString,
                                 fRetEmpresaUnitarioTrava,
                                 IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte),
                                 intNivel);
    End
    Else If fCfgSis('DMVFQV', VarBoolean) Then
    Begin
      Result := GetDesMaxFaixaQtde(dataSetItem.FieldByName( 'ITE_CODITE' ).AsString,
                                   fRetEmpresaUnitarioTrava,
                                   intNivel,
                                   fltQtdIte);
    End
    Else
      Result := dataSetItem.FieldByName(strDesMax).AsFloat;

  End;

  function fFormataUnitar(fltValor: Double): Double;
  begin
    Result := fFormataFloat(fltValor, VS_intDecUni);
  end;

  procedure pVerTravaProdutoEmCampanha(Var fltUniTrava: Double);
  var
    strCodCam,
    strIte: String;
    fltVlr: Double;
    fltPreClq: Double;
  begin
    If (Self.strOriF11 = 'S') And (Not Self.blnExisteCampanha) Then
      Exit;

    strIte := IIF((strOpcao = '1'), qryConIte.FieldByName( 'ITE_CODITE').AsString,
                  cdsItens.FieldByName( 'ITE_CODITE').AsString);

    blnEmCamp := objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                              strIte, Self.strIdePro, Self.strIteTin,
                                                              fltVolPro,
                                                              fltVlr,
                                                              strCodCam,
                                                              fltPreClq);

    If (Not blnEmCamp) And (Not fCfgSis('SIMCAM', varBoolean)) Then
    Begin
      If objCamGer.objCamGen.fUsaCampanhaGenerica Then
      Begin

        blnEmCamp := objCamGer.objCamGen.fVerificaProdutoCampGenerica(strCodCli,
                                                                      fRetornaGrupoItem(strIte),
                                                                      fRetMarcaItem(strIte),
                                                                      fRetCodFornecedor(strIte));
      End;
    End;

    If blnEmCamp And (fltVlr > 0) Then
      fltUniTrava := Min(fltUniTrava, fltVlr);
  end;

  procedure pVerTravaUnitarioEmbFechada(Var fltUniTrava: Double);
  begin
    If (fCfgSis('TRPEMB') = '4') Then
    Begin
      If (strIdeProIte = 'NOR') And fCfgSis('TPREMF', VarBoolean) And (Not fEhItemVendaVidro(strCodIte)) Then
      Begin
        If fEmptyStr(strLocTabPreIte) Then
          strLocTabPreIte := strLocTabPre;

        If (strOpcao = '1') Then
        Begin
          fltUnitarEmbFechada := fGetUnitarioEmbalagemFechada( qryConIte.FieldByName( 'ITE_CODITE').AsString,
                                                               strLocTabPreIte,
                                                               fltQtdIte,
                                                               fltUnitOrig );
        End
        Else
        Begin
          fltUnitarEmbFechada := fGetUnitarioEmbalagemFechada( cdsItens.FieldByName( 'ITE_CODITE').AsString,
                                                               strLocTabPreIte,
                                                               cdsItens.FieldByName('ITE_QTDITE').AsFloat,
                                                               IIF(fTemQuantEmbalagemFechada(cdsItens.FieldByName('ITE_CODITE').AsString),
                                                                                             cdsItens.FieldByName('ITE_UNIVIS').AsFloat,
                                                                                             cdsItens.FieldByName('ITE_UNIORI').AsFloat) );
        End;

        {*******************************************}
        {* CASO ABATE O DESCONTO AUTOMATICAMENTE,  *}
        {* APLICA O PERCENTUAL DE DESCONTO         *}
        {****************************************MV*}
        If (strCAbDes = 'S') And (fCfgSis('CNDVEN') = 'I') And (Not fAplicarTaxaJurosPrecoDigitado) Then
        Begin
          If (strCodFpg = '007') Then
          Begin
            If (strAbDeCc = 'S') Then
              fltUnitarEmbFechada :=  fltUnitarEmbFechada - fRetornaVrDesconto(2, fltUnitarEmbFechada, fltDesMax);
          End
          Else
            fltUnitarEmbFechada := fltUnitarEmbFechada - fRetornaVrDesconto(2, fltUnitarEmbFechada, fltDesMax);
        End;

        If fltUnitarEmbFechada > 0 Then
        Begin
          If (fCfgSis('EMBMLH', varString) = 'S') Then
            fltUniTrava := Min(fltUniTrava, fltUnitarEmbFechada)
          Else
            fltUniTrava := fltUnitarEmbFechada;
        End;

        fltUniTrava := fStrToFloat(FormatFloat(fMskDigitos(VS_intDecUni), fltUniTrava));
      End
    End;

  end;

  function fRetornaPrecoVendaComDescontoRessarcimentoCAT(fltPreVen: Double): Double;
    Var
      strTabelaPreco: String;
      strAbreviacao: String;
  begin
    Result := fltPreVen;

    If (strIdeProIte <> 'NOR') Then
      Exit;

    strTabelaPreco := IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte);
    strAbreviacao  := fGetCodAbf(strCodIte, fRetEmpresaUnitarioTrava);

    Result := Self.fRetornaPrecoVendaComDescontoRessarcimentoCAT(strCodIte, strEmpresaItem, strAbreviacao, strTabelaPreco, Result);
  end;

  function fEhItemEstrutura(strCodIte: String): Boolean;
  Begin
    Result := (stlItensNaoEhEstrutura.IndexOf(strCodIte) = -1) And fItemEstrutura(strCodIte);
  End;

  function fItemTintaOuItemVidroOuItemAcabado: Boolean;
  begin
    Result := ((strIdeProIte <> 'NOR') Or fEhItemVendaVidro(strCodIte) Or (blnProAcaIte));
  end;

  function fAplicaDescontoCondicao: Boolean;
    Var
      blnEmPromocao: Boolean;
  Begin
    Result := True;

    blnEmPromocao := (blnPromo) And (Not blnParticiona);

    If blnEmPromocao Then
    Begin
      If (fCfgSis('PRODES', varString) = 'N') Then
      Begin
        Exit(False);
      End
      Else If fAplicaDescontoCondicaoItensEmPromocao(strCodCnd) Then
      Begin
        //ITEM JÁ VEIO LÍQUIDO DA CADPRO ENTÃO NÃO PODE APLICAR DESCONTO DA CONDIÇÃO NOVAMENTE
        Exit(False);
      End;
    End;
  End;

  function fRetItem : String;
  begin
    Result := IIF(strOpcao.Equals('1'), qryConIte.FieldByName('ITE_CODITE').AsString,
                                        cdsItens.FieldByName('ITE_CODITE').AsString);
  end;

  function fItemPromocao(tpPrecoSugestao: TRegraPrecoSugestao): Boolean;
  begin
    Result := False;

    If (cdsItens.FieldByName('ITE_PROMOC').AsString = 'S') And
       ((strIdeProIte = 'NOR') Or ((strIdeProIte <> 'NOR') And
                                   (fCfgSis('TRADES') = 2) and
                                   (fRegraPrecoSugestaoAtiva = tpPrecoSugestao)
                                  )) Then
      Result := True;
  end;

begin
  //Req: 141791 Utilizar o preco do sub-item da estrutura para trava de preco
  If fUtilizarPrecoSubItemEstruturaTravaPreco() Then
    If (fltPrecoSubItemEstrutura > 0) Then
      Exit(fltPrecoSubItemEstrutura);

  pCarregaValoresCusto(fRetItem,
                       fRetEmpresaUnitarioTrava,
                       IIF(strTabPreIte.IsEmpty, Self.strTabPre, strTabPreIte));

  fltTraFat       := 0.0;
  fltPreVenGer    := 0.0;
  fltPreCusItem   := 0.0;
  fltPreMedItem   := 0.0;
  fltPreVenIte    := 0.0;
  fltPreVenTraCam := 0.0;

  Result      := 0.0;

  LfltCustoItem := 0;
  If (strOpcao = '1') Then
  Begin
    LfltCustoItem := fRetPreCus(qryConIte.FieldByName('ITE_PRECUS').AsFloat);
    If (fCfgSis('MCAT17') = 'M') Then
    Begin
      LfltCustoItem := fRetornaPrecoCustoDeduzindoRessarcimentoCAT(qryConIte.FieldByName('ITE_CODITE').AsString,
                                                                  strEmpresaItem,
                                                                  fGetCodAbf(strCodIte, fRetEmpresaUnitarioTrava),
                                                                  '',
                                                                  fCampoTabela('ITE_PRECUS',
                                                                               'ITEGER',
                                                                               ['ITE_CODITE', 'ITE_CODEMP'],
                                                                               [qryConIte.FieldByName('ITE_CODITE').AsString, fRetEmpresaUnitarioTrava],
                                                                               False),
                                                                  LstrUltDocumento);
    end;
  End;

  blnRecPrvVenDin := (fCfgSis('CLPVDI', varBoolean)) And (Self.fUFDestTrib(strEmpresaItem) <> Self.fGetUFEmpresa(strEmpresaItem));

  blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco := False;

  blnTravarPeloPrecoPromocao := fTravarPeloPrecoPromocao('', tapcdePromocaoCorrente);

  strLocTabPre := Self.strTabPre;
  strLocTabPreIte := strTabPreIte;

  If Not fItemTintaOuItemVidroOuItemAcabado Then
  Begin
    blnTabelaPrecoZerada := False;

    If (strOpcao = '1') Then
    Begin
      If Not qryConIte.IsEmpty Then
        blnTabelaPrecoZerada := (qryConIte.FieldByName('ITE_PREVE' + strLocTabPre).AsFloat = 0.00) And
                                (qryConIte.FieldByName('ITE_PREVE' + strLocTabPreIte).AsFloat = 0.00);
    End
    Else
    Begin
      blnTabelaPrecoZerada := (cdsItens.FieldByName('ITE_PREVE' + strLocTabPre).AsFloat = 0.00) And
                              (cdsItens.FieldByName('ITE_PREVE' + strLocTabPreIte).AsFloat = 0.00);
    End;

    If blnTabelaPrecoZerada Then
    Begin
      strLocTabPre    := '1';
      strLocTabPreIte := '1';
    End;
  End;

  If fEmptyStr(strTraCam) Then
  Begin

    If fEmptyStr(strLocTabPreIte) Then
      strTraCam := fCfgSis('CAMTB' + strLocTabPre)
    Else
      strTraCam := fCfgSis('CAMTB' + strLocTabPreIte);

  End;

  If (strOpcao = '1') Then
    strCodIte := qryConIte.FieldByName('ITE_CODITE').AsString
  Else
    strCodIte := cdsItens.FieldByName('ITE_CODITE').AsString;

  If (stlItensNaoTemQtdeEmbFec.IndexOf(strCodIte) = -1) And
     (Not fTemQuantEmbalagemFechada(strCodIte)) Then
  Begin
    stlItensNaoTemQtdeEmbFec.Add(strCodIte);
  End;

  blnTemEmbFec  := (stlItensNaoTemQtdeEmbFec.IndexOf(strCodIte) = -1) And
                   (fQuantEmbalagemFechadaItem(strCodIte, IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte),
                                                          IIF((strOpcao = '1'), fltQtdIte, cdsItens.FieldByName('ITE_QTDITE').AsFloat)) > 0);

  If (fCfgSis('TRPEMB') = '2') And blnTemEmbFec then
  Begin
    If strIdeProIte = 'NOR' Then
    Begin
      If (fCfgSis('CLPVDI', varBoolean, GetEmpCfg(cdsItens.FieldByName('ITE_EMPITE').AsString))) Then
      Begin
        If fCfgSis('IMPCF4') = 'S' Then
          fltAlqIcms := fCalculaAliquota(strCodIte,
                                         strEmpresaItem,
                                         GetImpDir(strCodIte, strEmpresaItem))
        Else
          fltAlqIcms := cdsItens.FieldByName('ITE_ICMSAI').AsFloat;

        fltValorDeduzido := 0;
        If Not fEmptyStr(strLocTabPre) Then
          fltValorDeduzido := objIcStPv.fPegaPrecoVenda(strCodIte,
                                                        fGetEmpCalculoItem(strEmpresaItem),
                                                        strCodCli,
                                                        strLocTabPre,
                                                        Self.fUFDestTrib(strEmpresaItem),
                                                        fltAlqIcms,
                                                        0,
                                                        fltPreCusItem);

        If (strOpcao = '1') Then
          fltUnitarEmbFechada := fGetUnitarioEmbalagemFechada( qryConIte.FieldByName( 'ITE_CODITE').AsString, strTabPreIte, fltQtdIte, fltValorDeduzido, fltValorDeduzido > 0)
        Else
          fltUnitarEmbFechada := fGetUnitarioEmbalagemFechada( strCodIte, strTabPreIte, cdsItens.FieldByName('ITE_QTDITE').AsFloat, fltValorDeduzido, fltValorDeduzido > 0);
      End
      Else
      Begin

        If (strOpcao = '1') Then
          fltUnitarEmbFechada := fGetUnitarioEmbalagemFechada( qryConIte.FieldByName( 'ITE_CODITE').AsString, strTabPreIte, fltQtdIte, 0 )
        Else
          fltUnitarEmbFechada := fGetUnitarioEmbalagemFechada( strCodIte, strTabPreIte, cdsItens.FieldByName('ITE_QTDITE').AsFloat, 0 );
      End;

      If (strOpcao = '1') Then
        fltPreVenIte := fFormataUnitar(qryConIte.FieldByName( 'ITE_PREVE' + strTabPreIte).AsFloat)
      Else
        fltPreVenIte := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strTabPreIte ).AsFloat);

      If (Not fEmptyStr(strTraCam)) Then
      Begin
        If strTraCam = TRAVA_CUSTO_REAL Then
        Begin
          If (strOpcao = '1') Then
            fltPreVenTraCam := fCustoRealTravaPreco(opCalcular, fltUnitar)
          Else
            fltPreVenTraCam := fCustoRealTravaPreco(opClientItens, fltUnitar, cdsItens);
        End
        Else
        Begin
          If (strOpcao = '1') Then
            fltPreVenTraCam := fFormataUnitar(qryConIte.FieldByName( 'ITE_PRE' + strTraCam).AsFloat)
          Else
            fltPreVenTraCam := fFormataUnitar(cdsItens.FieldByName( 'ITE_PRE' + strTraCam ).AsFloat);
        End;
      End
      Else
        fltPreVenTraCam := 0.0;

      If (strOpcao = '1') Then
      Begin
        fltPreCusItem := LfltCustoItem;
        fltPreMedItem := fGetPrecoMedioOperacao(qryConIte.FieldByName('ITE_PREMED'), strCodIte, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem));
      End
      Else
      Begin
        fltPreCusItem := cdsItens.FieldByName('ITE_CUSITE').AsFloat;
        fltPreMedItem := fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), strCodIte, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem));
      End;

      If (fltUnitarEmbFechada > 0) Then
      Begin
        fltPreVenIte    := fltUnitarEmbFechada;
        fltPreVenTraCam := fltUnitarEmbFechada;
      End;
    End
    Else
    Begin
      If (strOpcao = '1') Then
        fltPreVenIte := GetPropValue(Self, 'fltPreVe' + strTabPreIte)
      Else
        fltPreVenIte := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strTabPreIte ).AsFloat);

      If (Not fEmptyStr(strTraCam)) Then
      Begin
        If strTraCam = TRAVA_CUSTO_REAL Then
        Begin
          If (strOpcao = '1') Then
            fltPreVenTraCam := fCustoRealTravaPreco(opVariaveis)
          Else
            fltPreVenTraCam := fCustoRealTravaPreco(opClientItens, fltUnitar, cdsItens);
        End
        Else
        Begin
          If (strOpcao = '1') Then
            fltPreVenTraCam := GetPropValue(Self, 'fltPre' + strTraCam)
          Else
            fltPreVenTraCam := fFormataUnitar(cdsItens.FieldByName( 'ITE_PRE' + strTraCam ).AsFloat);
        End;
      End
      Else
        fltPreVenTraCam := 0.0;

      If (strOpcao = '1') Then
      Begin
        fltPreCusItem  := fltPreCus;
        fltPreMedItem := Self.fltPreMed;
      End
      Else
      Begin
        fltPreCusItem := cdsItens.FieldByName('ITE_CUSITE').AsFloat;
        fltPreMedItem := fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), strCodIte, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem));
      End;
    End;

    blnDescontoCliente := False;

    If (Self.fUsaDescontoProfissional) And
       (fAbateDescProfissionalNaTravaPreco) And
       (fltDescProfissional > 0)  Then
    Begin
      Result := fFormataFloat(fltPreVenIte * (100 - fltDescProfissional) / 100, fMaxDecUni);
      blnDescontoCliente := True;
    End;
  End
  Else
  Begin
    If (fItemTintaOuItemVidroOuItemAcabado) Then
    Begin
      fltPreVenGer    := GetPropValue(Self, 'fltPreVe' + strLocTabPre);
      fltPreVenIte    := GetPropValue(Self, 'fltPreVe' + strLocTabPreIte);

      If blnProAcaIte And (fltPreVenGer = 0) Then
      Begin
        fltPreVenGer    := cdsItens.FieldByName('ITE_PREVE' + strLocTabPre).AsFloat;
        fltPreVenIte    := cdsItens.FieldByName('ITE_PREVE' + strLocTabPreIte).AsFloat;
      End;

      If (Not fEmptyStr(strTraCam)) Then
      Begin
        If strTraCam = TRAVA_CUSTO_REAL Then
        Begin
          fltPreVenTraCam := fCustoRealTravaPreco(opVariaveis);
        End
        Else
        Begin
          fltPreVenTraCam := GetPropValue(Self, 'fltPre' + strTraCam);

          If blnProAcaIte And (fltPreVenTraCam = 0) Then
            fltPreVenTraCam := cdsItens.FieldByName('ITE_PRE' + strTraCam).AsFloat;
        End;
      End
      Else
        fltPreVenTraCam := 0.0;

      fltPreCusItem := fltPreCus;
      fltPreMedItem := Self.fltPreMed;
    End
    Else
    Begin
      If (Not qryConIte.IsEmpty) And (strOpcao = '1') Then
      Begin
        If fEhItemEstrutura(qryConIte.FieldByName('ITE_CODITE').AsString) And
           fUtilizaPrecoSubItensEstrutura(fIsItemEspecial(qryConIte.FieldByName('ITE_CODITE').AsString), qryConIte.FieldByName('ITE_CODITE').AsString) Then
        Begin
          fltPreVenGer := fCalculaPrecoEstrutura(False,
                                                 Preco_de_Venda,
                                                 qryConIte.FieldByName('ITE_CODITE').AsString,
                                                 strEmpresaItem,
                                                 'S',
                                                 strLocTabPre,
                                                 fltMargem);

          If (strLocTabPre = strLocTabPreIte) Then {<- Caso seja a mesma tabela não precisa executar novamente à fCalculaPrecoEstrutura! Req: 202045}
            fltPreVenIte := fltPreVenGer
          Else
            fltPreVenIte := fCalculaPrecoEstrutura(False,
                                                   Preco_de_Venda,
                                                   qryConIte.FieldByName('ITE_CODITE').AsString,
                                                   strEmpresaItem,
                                                   'S',
                                                   strLocTabPreIte,
                                                   fltMargem);
        End
        Else
        Begin
          fltPreVenGer := qryConIte.FieldByName( 'ITE_PREVE' + strLocTabPre).AsFloat;
          fltPreVenIte := qryConIte.FieldByName( 'ITE_PREVE' + strLocTabPreIte).AsFloat;

          If (blnRecPrvVenDin) Then
          Begin

            pCarregaValoresCusto(fRetItem,
                                 fRetEmpresaUnitarioTrava,
                                 IIF(strLocTabPre.IsEmpty, Self.strTabPre, strLocTabPre));

            strCodSit := '';
            strCodAbf := fGetCodAbf(qryConIte.FieldByName('ITE_CODITE').AsString, fRetEmpresaUnitarioTrava);
            If (Not fEmptyStr(Self.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString))) And (fBuscaAbfIcm(qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString, strCodAbf, fTrocaUFEndEntrega)) Then
              strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(qryConIte.FieldByName('ITE_CODEMP').AsString)).AsString;

            If fCfgSis('IMPCF4') = 'S' Then
              fltAlqIcms := fCalculaAliquota(qryConIte.FieldByName('ITE_CODITE').AsString,
                                             qryConIte.FieldByName('ITE_CODEMP').AsString,
                                             GetImpDir(qryConCit.FieldByName('ITE_CODITE').AsString, strEmpresaItem))
            Else
              fltAlqIcms := fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat);

            fltComliq := 0;
            If (blnEmCampanha) And
               (fCfgSis('MARMKP') = '4') Then
            Begin
              objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                           qryConIte.FieldByName('ITE_CODITE').AsString,
                                                           EmptyStr,
                                                           EmptyStr,
                                                           0,
                                                           fltVlrCam,
                                                           strCodCmg,
                                                           fltComliq);
            End;

            objIcStPv.pAdd(qryConIte.FieldByName('ITE_CODITE').AsString,
                           fGetEmpCalculoItem(strEmpresaItem),
                           Self.GetTipAbf(strEmpresaItem),
                           Self.fUFDestTrib(strEmpresaItem),
                           strCodSit,
                           fltImcSTPV,
                           blnCalcST,
                           0,
                           fltComliq);

            fltPreVenGer := fCalculaPrecoVenda(1,
                                               LfltCustoItem,
                                               qryConIte.FieldByName('ITE_PREVE' + strLocTabPre).AsFloat,
                                               qryConIte.FieldByName('ITE_MARBR' + strLocTabPre).AsFloat,
                                               fltAlqIcms + fAlqDifIcmsPrecoDinamico(qryConIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, strCodSit, fltAlqIcms) +
                                                            fAlqFcpIcmsPrecoDinamico(qryConIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, strCodSit, fltAlqIcms, qryConIte.FieldByName('ITE_PREVE' + strLocTabPre).AsFloat),
                                               fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat),
                                               fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat)),
                                               qryConIte.FieldByName('ITE_COMTB' + strLocTabPre).AsFloat,
                                               fMarMpkParaVenda,
                                               '',
                                               -1,
                                               fltImcSTPV,
                                               blnCalcST,
                                               0,
                                               0,
                                               fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat),
                                               fRestringirElementosMargem);

            If (strLocTabPre <> strLocTabPreIte) Then
            Begin

              pCarregaValoresCusto(fRetItem,
                                   fRetEmpresaUnitarioTrava,
                                   IIF(strLocTabPreIte.IsEmpty, Self.strTabPre, strLocTabPreIte));

              fltPreVenIte := fCalculaPrecoVenda(1,
                                                 LfltCustoItem,
                                                 qryConIte.FieldByName('ITE_PREVE' + strLocTabPreIte).AsFloat,
                                                 qryConIte.FieldByName('ITE_MARBR' + strLocTabPreIte).AsFloat,
                                                 fltAlqIcms + fAlqDifIcmsPrecoDinamico(qryConIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, strCodSit, fltAlqIcms) +
                                                              fAlqFcpIcmsPrecoDinamico(qryConIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, strCodSit, fltAlqIcms, qryConIte.FieldByName('ITE_PREVE' + strLocTabPreIte).AsFloat),
                                                 fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat),
                                                 fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat)),
                                                 qryConIte.FieldByName('ITE_COMTB' + strLocTabPreIte).AsFloat,
                                                 fMarMpkParaVenda,
                                                 '',
                                                 -1,
                                                 fltImcSTPV,
                                                 blnCalcST,
                                                 0,
                                                 0,
                                                 fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat),
                                                 fRestringirElementosMargem)
            End
            Else
              fltPreVenIte := fltPreVenGer;
          End;
        End;

        If (Not fEmptyStr(strTraCam)) Then
        Begin
          If strTraCam = TRAVA_CUSTO_REAL Then
          Begin
            fltPreVenTraCam := fCustoRealTravaPreco(opCalcular, fltUnitar, Nil, IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte));
          End
          Else
          Begin
            fltPreVenTraCam := fRetornaPrecoCusto(IIF(SameText(strTraCam, 'CUS'), Preco_de_Custo, Preco_de_Venda),
                                                  qryConIte.FieldByName('ITE_CODITE').AsString,
                                                  qryConIte.FieldByName('ITE_CODEMP').AsString,
                                                  qryConIte.FieldByName('ITE_PRE' + strTraCam).AsFloat,
                                                  IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte),
                                                  Nil,
                                                  (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));
          End;
        End
        Else
          fltPreVenTraCam := 0.0;

        fltPreCusItem := fRetornaPrecoCusto(Preco_de_Custo,
                                            qryConIte.FieldByName('ITE_CODITE').AsString,
                                            qryConIte.FieldByName('ITE_CODEMP').AsString,
                                            LfltCustoItem,
                                            '',
                                            Nil,
                                            (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));
        fltPreMedItem := fGetPrecoMedioOperacao(qryConIte.FieldByName('ITE_PREMED'), qryConIte.FieldByName('ITE_CODITE').AsString, qryConIte.FieldByName('ITE_CODEMP').AsString);
      End
      Else
      Begin
        If fCfgSis('IMPCF4') = 'S' Then
          fltAlqIcms := fCalculaAliquota(cdsItens.FieldByName('ITE_CODITE').AsString,
                                         cdsItens.FieldByName('ITE_EMPITE').AsString,
                                         cdsItens.FieldByName('ITE_IMPDIR').AsString)
        Else
          fltAlqIcms := cdsItens.FieldByName('ITE_ICMSAI').AsFloat;

        If Not fEmptyStr(strLocTabPre) Then
        Begin
          fltPreVenGer := objIcStPv.fPegaPrecoVenda(cdsItens.FieldByName('ITE_CODITE').AsString,
                                                    fGetEmpCalculoItem(strEmpresaItem),
                                                    strCodCli,
                                                    strLocTabPre,
                                                    Self.fUFDestTrib(strEmpresaItem),
                                                    fltAlqIcms,
                                                    0,
                                                    fltPreCusItem);
          fltPreMedItem := fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), cdsItens.FieldByName('ITE_CODITE').AsString, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem));
        End;

        If Not fEmptyStr(strLocTabPreIte) Then
        Begin
          If (strLocTabPreIte = strLocTabPre) Then
            fltPreVenIte := fltPreVenGer
          Else
          Begin
            fltPreVenIte := objIcStPv.fPegaPrecoVenda(cdsItens.FieldByName('ITE_CODITE').AsString,
                                                      fGetEmpCalculoItem(strEmpresaItem),
                                                      strCodCli,
                                                      strLocTabPreIte,
                                                      Self.fUFDestTrib(strEmpresaItem),
                                                      fltAlqIcms,
                                                      0,
                                                      fltPreCusItem);
            fltPreMedItem := fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), cdsItens.FieldByName('ITE_CODITE').AsString, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem));
          End;
        End;
      End;
    End;

    blnDescontoCliente := False;

    If (fCfgSis('CLIDES') = 'S') And
       (fAbateDescProfissionalNaTravaPreco) And
       (fltDescProfissional > 0) Then
    Begin
      If (strOpcao = '1') Or (blnRecPrvVenDin) Then
        Result := fFormataUnitar(fltPreVenGer)
      Else
        Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPre ).AsFloat);

      Result := fFormataFloat(Result * (100 - fltDescProfissional) / 100, fMaxDecUni);

      If (fCfgSis('DMXACP') = 'S') Then
      Begin
        If (fCfgSis('TRADES') = '2') And (fCfgSis('LIGUCN',varBoolean)) And (Not fEmptyStr(fRetornaGrupoItem(strCodIte))) Then
          fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdVendedor)
        Else
        Begin
          Case intNivel Of
            1: fltDesMax := fltDMVCnd;
            2: fltDesMax := fltDVMCnd;
            3: fltDesMax := fltDMSCnd;
            4: fltDesMax := fltDSMCnd;
            5: fltDesMax := fltDMGCnd;
            6: fltDesMax := fltDGMCnd;
          End;
        End;

        If (fltDesMax > 0) Then
          Result := fFormataFloat(Result  * ( 1 - ( fltDesMax / 100.0) ), fMaxDecUni);
      End;
    
      blnDescontoCliente := True;
    End;
  End;

  If (fCfgSis('DDESFD', varInteger) > 0) And (fCfgSis('TDESFD') = 'L') And (strPromoc = 'N') And (Not blnIteCom) Then
  Begin
    If ((Self.VS_Date - fCampoTabela('CLI_ULTCOM', 'CADCLI', ['CLI_CODCLI'], [strCodCli])) <= fCfgSis('DDESFD', varInteger)) Then
      Result := fFormataFloat(Result * (100 - fltDescFidelidade) / 100, fMaxDecUni);
  End;

  If blnVerPromocao Then
  Begin
    If (strOpcao = '1') Then
    Begin
      strCodIte := qryConIte.FieldByName( 'ITE_CODITE').AsString;
      fltQuanti := fltQtdIte;
    End
    Else
    Begin
      strCodIte := cdsItens.FieldByName('ITE_CODITE').AsString;
      fltQuanti := cdsItens.FieldByName('ITE_QTDITE').AsFloat;
    End;

    If (Self.fFilialPromocao) Then
    Begin
      blnParticiona := False;
      blnPromo      := False;

      If (strOpcao = '1') Then
      Begin
        If (fItemPassivelDeVerificacaoPromo(strCodIte, fGetEmpPrecoPromoItem(strEmpresaItem))) And
           (Self.fFilialPromocao) And fRetornaPrecosPromocao(strCodIte,
                                                             strCodCli,
                                                             Self.VS_Date,
                                                             fltQuanti,
                                                             fltQtdJaDig,
                                                             fltQtdJaEmPromoc,
                                                             intPraMed,
                                                             fltProPreCus,
                                                             fltProPreVen,
                                                             fltProComVar,
                                                             fltProComAta,
                                                             fltProComDis,
                                                             fltQtdDis,
                                                             fltProDesF07,
                                                             strComPro,
                                                             strCodPro,
                                                             blnParticiona,
                                                             blnPromo,
                                                             IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte),
                                                             strCodCnd,
                                                             '',
                                                             '',
                                                             True,
                                                             False,
                                                             '-1',
                                                             blnEntIme,
                                                             blnEntFut,
                                                             strMotFut,
                                                             fGetEmpPrecoPromoItem(strEmpresaItem),
                                                             strNumOrc,
                                                             strEspOrc,
                                                             Nil,
                                                             False,
                                                             '',
                                                             Nil,
                                                             '',
                                                             fltSomatorioColorantes) Then
        Begin
          If Not blnParticiona Then
          Begin
            Result := fFormataFloat( fltProPreVen, fMaxDecUni );

            blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco := fCfgSis('TRAPRP') = '2';

            If blnTravarPeloPrecoPromocao Then
            Begin
              If (strIdeProIte <> 'NOR') Then
              Begin
                If fEmptyStr(strLocTabPreIte) Then
                  Result := fFormataUnitar(fltPreVenGer)
                Else
                  Result := fFormataUnitar(fltPreVenIte);
              End;

              Exit;
            End;
          End;
        End;

        //If (cdsItens.FieldByName('ITE_SEQCOM').AsInteger > 0) And (cdsItens.FieldByName('ITE_ATIVAC').AsString <> 'S') Then
        //  Result := cdsItens.FieldByName('ITE_UNIORI').AsFloat;

      End
      Else
      Begin
        If fItemPromocao(TRegraPrecoSugestao.PrecoDeTabela) Then
        Begin
          fRetornaPrecosPromocao(strCodIte,
                                 strCodCli,
                                 Self.VS_Date,
                                 fltQuanti,
                                 fltQtdJaDig,
                                 fltQtdJaEmPromoc,
                                 intPraMed,
                                 fltProPreCus,
                                 fltProPreVen,
                                 fltProComVar,
                                 fltProComAta,
                                 fltProComDis,
                                 fltQtdDis,
                                 fltProDesF07,
                                 strComPro,
                                 strCodPro,
                                 blnParticiona,
                                 blnPromo,
                                 IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte),
                                 strCodCnd,
                                 '',
                                 '',
                                 True,
                                 False,
                                 '-1',
                                 blnEntIme,
                                 blnEntFut,
                                 strMotFut,
                                 fGetEmpPrecoPromoItem(cdsItens.FieldByName('ITE_EMPITE').AsString),
                                 strNumOrc,
                                 strEspOrc,
                                 Nil,
                                 False,
                                 '',
                                 Nil,
                                 '',
                                 fltSomatorioColorantes);

          blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco := fCfgSis('TRAPRP') = '2';

          If (blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco) And
            (strOpcDoc = 'CF') And
            (fFormataFloat(fltProPreVen, fMaxDecUni) = 0) Then
          Begin
            fltProPreVen := cdsItens.FieldByName('ITE_UNIORI').AsFloat;
          End;

          If (blnDescontoCliente) Then
            Result := fFormataFloat( Min(fltProPreVen, Result), fMaxDecUni )
          Else
            Result := fFormataFloat( fltProPreVen, fMaxDecUni );

          If blnTravarPeloPrecoPromocao Then
          Begin
            Case intNivel Of
              1: If fAplicaDescontoCondPagamento(fltDMVCnd, 'S', IIF(blnIteCom, 'S', 'N'), False, False, 0, fCfgSis('PROCND', varString) = 'M') Then
                   Result := fFormataFloat( Result - fRetornaVrDesconto(2, Result, fltDMVCnd) , fMaxDecUni );

              2: If fAplicaDescontoCondPagamento(fltDVMCnd, 'S', IIF(blnIteCom, 'S', 'N'), False, False, 0, fCfgSis('PROCND', varString) = 'M') Then
                   Result := fFormataFloat( Result - fRetornaVrDesconto(2, Result, fltDMSCnd) , fMaxDecUni );

              3: If fAplicaDescontoCondPagamento(fltDMSCnd, 'S', IIF(blnIteCom, 'S', 'N'), False, False, 0, fCfgSis('PROCND', varString) = 'M') Then
                   Result := fFormataFloat( Result - fRetornaVrDesconto(2, Result, fltDMGCnd) , fMaxDecUni );

              4: If fAplicaDescontoCondPagamento(fltDSMCnd, 'S', IIF(blnIteCom, 'S', 'N'), False, False, 0, fCfgSis('PROCND', varString) = 'M') Then
                   Result := fFormataFloat( Result - fRetornaVrDesconto(2, Result, fltDMGCnd) , fMaxDecUni );

              5: If fAplicaDescontoCondPagamento(fltDMGCnd, 'S', IIF(blnIteCom, 'S', 'N'), False, False, 0, fCfgSis('PROCND', varString) = 'M') Then
                   Result := fFormataFloat( Result - fRetornaVrDesconto(2, Result, fltDMGCnd) , fMaxDecUni );

              6: If fAplicaDescontoCondPagamento(fltDGMCnd, 'S', IIF(blnIteCom, 'S', 'N'), False, False, 0, fCfgSis('PROCND', varString) = 'M') Then
                   Result := fFormataFloat( Result - fRetornaVrDesconto(2, Result, fltDMGCnd) , fMaxDecUni );
            End;

            If (cdsItens.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
            Begin
              If (fCfgSis('TRADES') = 2) and
                 (fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela) then
              begin
                Result := fFormataUnitar(cdsItens.FieldByName('ITE_PREVE' + strTabPreIte).AsFloat)
              end
              Else
                Result := cdsItens.FieldByName('ITE_UNIORI').AsFloat;
            End;

            Exit;
          End;
        End
        Else If fItemPromocao(TRegraPrecoSugestao.PrecoDePromocao) Then
        Begin
          blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco := (fCfgSis('TRAPRP') = '2') Or (blnTravarPeloPrecoPromocao);

          If (blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco) Then
          Begin
            If (cdsItens.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
            Begin
              fltProPreVen := IIF((cdsItens.FieldByName('ITE_PRVTIN').AsFloat > 0),
                                   cdsItens.FieldByName('ITE_PRVTIN').AsFloat,
                                   cdsItens.FieldByName('ITE_UNIORI').AsFloat);
            End
            Else
            Begin
              fltProPreVen := IIF((cdsItens.FieldByName('ITE_PROVEN').AsFloat > 0),
                                   cdsItens.FieldByName('ITE_PROVEN').AsFloat,
                                   cdsItens.FieldByName('ITE_UNIORI').AsFloat);
            End;
          End;

          blnPromo := True;
        End

        //If (cdsItens.FieldByName('ITE_SEQCOM').AsInteger > 0) And (cdsItens.FieldByName('ITE_ATIVAC').AsString <> 'S') Then
        //  Result := cdsItens.FieldByName('ITE_UNIORI').AsFloat;

      End;

    End;
  End;

  If (blnDescontoCliente) Then
  Begin
    pVerTravaUnitarioEmbFechada(Result);

    If (Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0) And (Result > fltUniDev) Then
      Result := fltUniDev;

    {********************************************}
    {* JÁ CALCULOU O VALOR MÍNIMO DE ACORDO COM *}
    {* O DESCONTO DO CLIENTE.                   *}
    {*****************************************MV*}
    Exit;
  End;

  If (strIdeProIte = 'NOR') Or (fTravaUnitarioDeTintaComoProdutoNormal) Then
  Begin
    blnPerDesCliReg := fPercDescComissClienteRegiao(strCodCli, strCodIte, 'PERDES', fltPerDesCliReg);

    {********************************************************************}
    {* CASO ESTEJA CONFIGURADO PARA UTILIZAR DESC. MÁX POR LINHA/GRUPO  *}
    {* DO PRODUTO E CONDIÇÃO INFORMADOS, ALTERA fltDMGCnd               *}
    {****************************************************************MM**}
    If (VS_strTRADES = '2') And
       (fCfgSis('LIGUCN',varBoolean)) And
       (Not fEmptyStr(fRetornaGrupoItem(strCodIte))) Then
    Begin
      Case intNivel Of
        1: fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdVendedor);
        2: fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdVendedorMaster);
        3: fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdSubGerenteJunior);
        4: fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdSubGerenteMaster);
        5: fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdGerenteJunior);
        6: fltDesMax := fRetDescMaxLinGru(fRetornaGrupoItem(strCodIte), Self.strCodCnd, mdGerenteMaster);
      End;
    End
    Else
    Begin
      Case intNivel Of
        1: fltDesMax := fltDMVCnd;
        2: fltDesMax := fltDVMCnd;
        3: fltDesMax := fltDMSCnd;
        4: fltDesMax := fltDSMCnd;
        5: fltDesMax := fltDMGCnd;
        6: fltDesMax := fltDGMCnd;
      End;
    End;

    {********************************************}
    {* CASO A VARIAVEL DE DESCONTO MAXIMO DA    *}
    {* FORMA DE PAGAMENTO SEJA MAIOR QUE ZERO,  *}
    {* IGNORA TODOS AS OUTRAS REGRAS DE DESCONTO*}
    {*****************************************MV*}
    {* CASO O DESCONTO MAXIMO SEJA SUBSTITUTIVO *}
    {*****************************************JC*}
    If (VS_strTRADES = '2') And (fCfgSis('TRPEMB') = '4') And (fCfgSis('TPDMAX') = '4') Then
    Begin
      If fEmptyStr(strLocTabPreIte) Then
      Begin
        If (strOpcao = '1') Or (blnRecPrvVenDin) Then
          Result := fFormataUnitar(fltPreVenGer)
        Else
          Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPre ).AsFloat);
      End
      Else
      Begin
        If (strOpcao = '1') Or (blnRecPrvVenDin) Then
          Result := fFormataUnitar(fltPreVenIte)
        Else
          Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPreIte ).AsFloat);
      End;

      If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco And (fltProPreVen > 0) Then
        Result := fltProPreVen;

      If (fAplicaDescontoCondicao) Then
      Begin
        fltDesPro := fDescontoMaximoItem;
        Result := Result - ((Result * fltDesPro) / 100.0);
      End;

      Result := fRetornaPrecoVendaComDescontoRessarcimentoCAT(Result);
    End
    Else If (fltDesMax > 0.0) And (fCfgSis('TPDMAX') = '1') And (VS_strTRADES = '2') Then
    Begin
      If (fCfgSis('TRPEMB') = '2') And blnTemEmbFec then
      Begin
        Result := fltPreVenIte;
      End
      Else
      Begin
        If fEmptyStr(strLocTabPreIte) Then
        Begin
          If (strOpcao = '1') Or (blnRecPrvVenDin) Then
            Result := fFormataUnitar(fltPreVenGer)
          Else
            Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPre ).AsFloat);
        End
        Else
        Begin
          If (strOpcao = '1') Or (blnRecPrvVenDin) Then
            Result := fFormataUnitar(fltPreVenIte)
          Else
            Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPreIte ).AsFloat);
        End;
      End;

      If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco And (fltProPreVen > 0) Then
        Result := fltProPreVen;

      If (fAplicaDescontoCondicao) Then
        Result := Result - ((Result * fltDesMax) / 100.0);

      Result := fRetornaPrecoVendaComDescontoRessarcimentoCAT(Result);
    End
    Else
    Begin
      If (fCfgSis('TRPEMB') = '2') And blnTemEmbFec then
      Begin

        If (fCfgSis('TRADES') = '1') Then
        Begin

          If (strToInt(strTabPreIte) In [1..Length(VS_STRTABPRC)]) Then
          Begin
            If strTabPreIte = '1' Then
              fltTraFat := fCfgSis('TRAFAT', varDouble)
            Else
              fltTraFat := fCfgSis('TRAFA' + strTabPreIte, varDouble);
          End;

          Result := fFormataUnitar(fltPreVenTraCam) * fltTraFat;

          If Not qryConCit.IsEmpty Then
          Begin
            If Pos( 'ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0 Then
              Result := fltUniOri;
          End;

          If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco Then
            Result := fltProPreVen * fltTraFat;

        End
        Else If (fCfgSis('TRADES') = '2') Then
        Begin

          If (strOpcao = '1') Then
          Begin
            blnIteEsp := Pos( 'ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0;
            If blnIteEsp Then
              Result := fltUniOri;
          End
          Else
          Begin
            blnIteEsp := Pos( 'ITEM ESPECIAL', cdsItens.FieldByName('ITE_DESITE').AsString) > 0;
            If blnIteEsp Then
              Result := fCalculaPrecoVenda(1, cdsItens.FieldByName('ITE_PRECUS').AsFloat, 0.0, fCfgSis('MMIIES', varDouble), 0.0, 0.0, 0.0, 0.0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
          End;

          If Not blnIteEsp Then
          Begin
            Result := fltPreVenIte;

            If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco Then
              Result := fFormataUnitar(fltProPreVen);

            {*******************************************}
            {* DESCONTO MAXIMO DA CONDICAO DE PAGAMENTO*}
            {* PASSOU A SER UM DESC. COMPLEMENTAR      *}
            {****************************************JC*}
            {********************************************************************************}
            {* TROQUEI A POSIÇÃO DOS DESCONTOS PARA PODE BATER COM A APRESENTAÇÃO DOS DADOS *}
            {* DUVIDAS FALAR COM RENAN, VEJA OS EXEMPLOS:                                   *}
            {* 91.05  -3%  88.32  -5%  83.90                                                *}
            {* 91.05  -5%  86.50  -3%  89.91                                                *}
            {*****************************************************************************RN*}
            If (fCfgSis('CNDVEN') = 'I') Then
            Begin
              If (fCfgSis('TPDMAX') = '2') And (fltDesMax > 0) And (fAplicaDescontoCondicao)  Then
                Result := Result  * ( 1 - ( fltDesMax / 100.0) );

              Result := fFormataUnitar(Result);

              Result := fFormataUnitar(Result) - fRetornaVrDesconto( 2, fFormataUnitar(Result), fDescontoMaximoItem );
            End
            Else
            Begin
              Result := fFormataUnitar(Result) - fRetornaVrDesconto( 2, fFormataUnitar(Result), fDescontoMaximoItem );

              Result := fFormataUnitar(Result);

              If (fCfgSis('TPDMAX') = '2') And (fltDesMax > 0) Then
                Result := Result  * ( 1 - ( fltDesMax / 100.0) );
            End;

            Result := fRetornaPrecoVendaComDescontoRessarcimentoCAT(Result);
          End;
        End
        Else
        Begin

          Case intNivel Of
            2:   strMarMin := 'ITE_MARMMV'; //Vendedor Master
            3:   strMarMin := 'ITE_MARMSG'; //Sub-Gerente Júnior
            4:   strMarMin := 'ITE_MARMMS'; //Sub-Gerente Master
            5:   strMarMin := 'ITE_MARMGE'; //Gerente Júnior
            6:   strMarMin := 'ITE_MARMMG'; //Gerente Master
            Else strMarMin := 'ITE_MARMIN'; //Vendedor
          End;

          If (strOpcao = '1') Then
          Begin

            pCarregaValoresCusto(fRetItem,
                                 fRetEmpresaUnitarioTrava,
                                 IIF(strTabPreIte.IsEmpty, Self.strTabPre, strTabPreIte));

            fltIcmSai := fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat);
            fltImpFed := fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat);
            fltDesOpe := fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat));
            fltComTab := qryConIte.FieldByName('ITE_COMTB' + strTabPreIte).AsFloat;
            fltMarMin := qryConIte.FieldByName(strMarMin).AsFloat;

          End
          Else
          Begin
            fltIcmSai := cdsItens.FieldByName('ITE_ICMSAI').AsFloat;
            fltImpFed := cdsItens.FieldByName('ITE_IMPFED').AsFloat;
            fltDesOpe := fProcessarDespesasOperacionaisComplementar(cdsItens.FieldByName('ITE_DESOPE').AsFloat);
            fltComTab := cdsItens.FieldByName('ITE_COMTBL').AsFloat;
            fltMarMin := cdsItens.FieldByName(strMarMin).AsFloat;
          End;

          If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco Then
            Result := fltProPreCus

          // CONFIGURADO PARA MARGEM BRUTA - CALCULA COM BASE NO PRECO DE CUSTO
          Else If (fCfgSis('MMPOPM') = 'B') Then
          Begin
            If (TMargemMinima.UsaPrecoMedio) Then
            Begin
              If (strOpcao = '1') Then
                Result := fltPreMedItem
              Else
                Result := fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), cdsItens.FieldByName('ITE_CODITE').AsString, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem));
            End
            Else
            Begin
              If (strOpcao = '1') Then
                Result := fltPreCusItem + fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat)
              Else
                Result := cdsItens.FieldByName('ITE_CUSITE').AsFloat;
            End;
          End

          // CONFIGURADO PARA MARGEM LIQUIDA - CALCULA COM BASE NO CUSTO REAL
          Else
          Begin
            // ZERA OS IMPOSTOS POIS JÁ ESTÃO CALCULADOS NO CUSTO REAL
            fltIcmSai := 0;
            fltImpFed := 0;
            fltDesOpe := 0;
            fltComTab := 0;

            If (strOpcao = '1') Then
            Begin
              If strIdePro = 'NOR' Then
                Result := fCustoRealTravaPreco(opCalcular, fltUnitar)
              Else
                Result := fCustoRealTravaPreco(opVariaveis);
            End
            Else
              Result := fCustoRealTravaPreco(opClientItens, fltUnitar, cdsItens);
          End;

          Result := fCalculaPrecoVenda(1, Result,
                                          0,
                                          fltMarMin,
                                          fltIcmSai,
                                          fltImpFed,
                                          fltDesOpe,
                                          fltComTab,
                                          fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem); //COMISSAO DA TABELA DE PRECO
        End;

      End
      Else
      Begin
        If (VS_strTRADES = '1') Then
        Begin

          If fEmptyStr(strLocTabPreIte) Then
          Begin
            If fEmptyStr(strLocTabPre) Then strLocTabPre := '1'; //PADRAO

            If (strToInt(strLocTabPre) In [1..Length(VS_strTabVen)]) Then
            Begin
              strTraCam := fCfgSis('CAMTB' + strLocTabPre);

              If strLocTabPre = '1' Then
                fltTraFat := fCfgSis('TRAFAT', varDouble)
              Else
                fltTraFat := fCfgSis('TRAFA' + strLocTabPre, varDouble);

            End;

          End
          Else
          Begin

            If (strToInt(strLocTabPreIte) In [1..Length(VS_strTabVen)]) Then
            Begin
              strTraCam := fCfgSis('CAMTB' + strLocTabPreIte);

              If strLocTabPreIte = '1' Then
                fltTraFat := fCfgSis('TRAFAT', varDouble)
              Else
                fltTraFat := fCfgSis('TRAFA' + strLocTabPreIte, varDouble);

            End;

          End;

          If (strOpcao = '1') Then
          Begin
            Result := fFormataUnitar(fltPreVenTraCam) * fltTraFat;
          End
          Else
          Begin
            If strTraCam = TRAVA_CUSTO_REAL Then
              Result := fCustoRealTravaPreco(opClientItens, fltUnitar, cdsItens) * fltTraFat
            Else If (blnRecPrvVenDin) And (CharInSet(strTraCam[Length(strTraCam)], ['1'..'7'])) Then
            Begin
              fltAlqIcms := 0;

              If (fCfgSis('IMPCF4') = 'S') And (cdsItens.FindField('ITE_IMPDIR') <> Nil) Then
                fltAlqIcms := fCalculaAliquota(cdsItens.FieldByName('ITE_CODITE').AsString,
                                               cdsItens.FieldByName('ITE_EMPITE').AsString,
                                               cdsItens.FieldByName('ITE_IMPDIR').AsString)
              Else If (fCfgSis('IMPCF4') = 'N') And (cdsItens.FindField('ITE_ICMSAI') <> Nil) Then
                fltAlqIcms := cdsItens.FieldByName('ITE_ICMSAI').AsFloat;

              Result := fFormataUnitar(objIcStPv.fPegaPrecoVenda(cdsItens.FieldByName('ITE_CODITE').AsString,
                                                                 fGetEmpCalculoItem(strEmpresaItem),
                                                                 strCodCli,
                                                                 RightStr(strTraCam, 1),
                                                                 Self.fUFDestTrib(strEmpresaItem),
                                                                 fltAlqIcms,
                                                                 0,
                                                                 fltPreCusItem )) * fltTraFat;
            End
            Else
              Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PRE' + strTraCam ).AsFloat) * fltTraFat;
          End;

          If Not qryConCit.IsEmpty Then
          Begin
            If Pos( 'ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0 Then
              Result := fltUnitOrig;
          End;

          If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco Then
            Result := fltProPreVen * fltTraFat;

        End
        Else If (VS_strTRADES = '2') Or (TipoOpcaoDeTrava = totDescontoMaximoPorAtividade) Then
        Begin

          If (strOpcao = '1') Then
          Begin
            blnIteEsp := Pos( 'ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0;
            If blnIteEsp Then
              Result := fltUniOri;
          End
          Else
          Begin
            blnIteEsp := Pos( 'ITEM ESPECIAL', cdsItens.FieldByName('ITE_DESORI').AsString) > 0;
            If blnIteEsp Then
              Result := fCalculaPrecoVenda(1, cdsItens.FieldByName('ITE_PRECUS').AsFloat, 0.0, fCfgSis('MMIIES', varDouble), 0.0, 0.0, 0.0, 0.0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
          End;

          If Not blnIteEsp Then
          Begin
            If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco Then
            Begin
              Result := fFormataUnitar(fltProPreVen);
              If fAplicaDescontoCondicao Then
                Result := fFormataUnitar(fltProPreVen) -
                          fRetornaVrDesconto( 2, fFormataUnitar(fltProPreVen), fDescontoMaximoItem );
            End
            Else If (fCfgSis('PEPFIM', varString) = 'S') And (fItemPromocionalComPrecoFixoParaTintaDeMaquinaImobiliaria(strCodIte, strCodPro)) Then
            Begin
              If (Not fEmptyStr(strLocTabPreIte)) Then
                strTabPrecoTrava := strLocTabPreIte
              Else If (Not fEmptyStr(strLocTabPre)) Then
                strTabPrecoTrava := strLocTabPre
              Else
                strTabPrecoTrava := '1';
              fltPrecoVendaTrava := fCampoTabela('ITE_PREVE' + strTabPrecoTrava, 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, fRetEmpresaUnitarioTrava], False);
              fltPrecoVendaTrava := fltPrecoVendaTrava + fltSomatorioColorantes;
              Result := fFormataUnitar(fltPrecoVendaTrava) - fRetornaVrDesconto(2, fFormataUnitar(fltPrecoVendaTrava), fDescontoMaximoItem);
            End
            Else If fEmptyStr(strLocTabPreIte) Then
            Begin
              If (strOpcao = '1') Or (blnRecPrvVenDin) Then
                Result := fFormataUnitar(fltPreVenGer) -
                          fRetornaVrDesconto( 2, fFormataUnitar(fltPreVenGer), fDescontoMaximoItem )
              Else
                Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPre ).AsFloat) -
                          fRetornaVrDesconto( 2, fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPre ).AsFloat), fDescontoMaximoItem );
            End
            Else
            Begin
              If (strOpcao = '1') Or (blnRecPrvVenDin) Then
                Result := fFormataUnitar(fltPreVenIte) -
                          fRetornaVrDesconto( 2, fFormataUnitar(fltPreVenIte), fDescontoMaximoItem )
              Else
                Result := fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPreIte ).AsFloat) -
                          fRetornaVrDesconto( 2, fFormataUnitar(cdsItens.FieldByName( 'ITE_PREVE' + strLocTabPreIte ).AsFloat), fDescontoMaximoItem );
            End;

            {*******************************************}
            {* DESCONTO MAXIMO DA CONDICAO DE PAGAMENTO*}
            {* PASSOU A SER UM DESC. COMPLEMENTAR      *}
            {****************************************JC*}
            If (fCfgSis('TPDMAX') = '2') And (fltDesMax > 0) And (fAplicaDescontoCondicao) Then
            Begin
              Result := Result  * ( 1 - ( fltDesMax / 100.0) );
            End;

            Result := fRetornaPrecoVendaComDescontoRessarcimentoCAT(Result);

          End;
        End
        Else
        Begin

          If (strOpcao = '1') Then
            blnIteEsp := Pos( 'ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0
          Else
            blnIteEsp := Pos( 'ITEM ESPECIAL', cdsItens.FieldByName('ITE_DESORI').AsString) > 0;

          If (TipoOpcaoDeTrava = totMargemMinimaPorAtividade) Then
            fltMarMin := fRetornaMargemMinimaPorAtividade(fRetEmpresaUnitarioTrava, FCodCli, intNivel)
          Else
          Begin

            Case intNivel Of
              2:   strMarMin := 'ITE_MARMMV'; //Vendedor Master
              3:   strMarMin := 'ITE_MARMSG'; //Sub-Gerente Júnior
              4:   strMarMin := 'ITE_MARMMS'; //Sub-Gerente Master
              5:   strMarMin := 'ITE_MARMGE'; //Gerente Júnior
              6:   strMarMin := 'ITE_MARMMG'; //Gerente Master
              Else strMarMin := 'ITE_MARMIN'; //Vendedor
            End;

            If (strOpcao = '1') Then
              fltMarMin := qryConIte.FieldByName(strMarMin).AsFloat
            Else
              fltMarMin := cdsItens.FieldByName(strMarMin).AsFloat;

          End;

          // PRECO DE PROMOCAO UTILIZADO NA TRAVA
          If blnUsaPrecoPromocaoComoBaseParaCalcularTravaPreco Then
          Begin
            Result := fCalculaPrecoVenda(1, fltProPreCus, 0, fltMarMin, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
          End
          // CONFIGURADO PARA MARGEM BRUTA - CALCULA COM BASE NO PRECO DE CUSTO
          Else If (fCfgSis('MMPOPM') = 'B') Then
          Begin
            If (TMargemMinima.UsaPrecoMedio) Then
            Begin
              If (strOpcao = '1') Then
                Result := fCalculaPrecoVenda(1, fltPreMedItem, 0, fltMarMin, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem)
              Else
                Result := fCalculaPrecoVenda(1, fGetPrecoMedioOperacao(cdsItens.FieldByName('ITE_PREMED'), cdsItens.FieldByName('ITE_CODITE').AsString, IIF(fEmptyStr(strEmpresaItem), VS_strCodEmp, strEmpresaItem)), 0, fltMarMin, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
            End
            Else
            Begin
              If (strOpcao = '1') Then
                Result := fCalculaPrecoVenda(1, fltPreCusItem, 0, fltMarMin, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem)
              Else
                Result := fCalculaPrecoVenda(1, cdsItens.FieldByName('ITE_CUSITE').AsFloat, 0, fltMarMin, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
            End;
          End
          // CONFIGURADO PARA MARGEM LIQUIDA - CALCULA COM BASE NO CUSTO REAL
          Else
          Begin
            //PRECO DE VENDA MINIMO DO ITEM ESTRUTURA - MARGEM LIQUIDA
            If fUtilizaPrecoSubItensEstrutura(blnIteEsp, strCodIte) Then
            Begin
              Result := fCalculaPrecoEstrutura(False,
                                               Trava_Preco_Margem_Minima_Liquida,
                                               strCodIte,
                                               strEmpresaItem,
                                               'S',
                                               IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte),
                                               fltMarMin,
                                               1,
                                               Nil,
                                               blnIteEsp);
            End
            Else
            Begin
              If (strOpcao = '1') Then
              Begin
                If (strIdeProIte = 'NOR') And (Not fEhItemVendaVidro(strCodIte)) Then
                  Result := fPrecoMinimoMargemLiquida(omCalcular, strCodIte, IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte), fltMarMin, nil, cdsIteTin, strMarMin)
                Else
                  Result := fPrecoMinimoMargemLiquida(omVariaveis, strCodIte, IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte), fltMarMin, nil, cdsIteTin, strMarMin);
              End
              Else
                Result := fPrecoMinimoMargemLiquida(omClientItens, strCodIte, IIF(fEmptyStr(strLocTabPreIte), strLocTabPre, strLocTabPreIte), fltMarMin, cdsItens, cdsIteTin, strMarMin);
            End;
          End;
        End;
      End;

    End;

    {***************************************************}
    {* O DESCONTO POR CLIENTE OU REGIAO É COMPLEMENTAR *}
    {***********************************************JC**}
    If blnPerDesCliReg Then
    Begin
      Result := Result * ( 1 - ( fltPerDesCliReg / 100.0 ) );
    End;

  End;

  pVerTravaUnitarioEmbFechada(Result);
  pVerTravaProdutoEmCampanha(Result);

  If (fltPreLot > 0) And (fltPreLot < Result) then
    Result := fltPreLot;

  If (Pos(strOpcDoc, 'PI_') > 0) Then
    Result := fltUniOri;

  If (Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0) And (Result > fltUniDev) Then
    Result := fltUniDev;

  If (fEhDevolucaoEspelhoOuParaFornecedor) And (Result > fltUniDev) Then
    Result := fltUniDev;

  If blnMeiaNota And (fltFatNot > 0) Then
  Begin
    If strOpcao = '1' Then
      Result := fltPreCusItem
    Else
      Result := cdsItens.FieldByName('ITE_PRECUS').AsFloat;

    If strTipFatNEs <> 'Q' Then //Caso seja fator por Valor (qualquer coisa <> Q)
      Result := Result / fltFatNot;
  End;

  blnPrvEmb := fCfgSis('PRVEMB', VarBoolean);
  intPreEmb := fCfgSis('PREEMB', VarInteger);

  If (Not fEmptyStr(strBarEmb)) And
      blnPrvEmb                 And
     (intPreEmb = 1)            Then
    fltPreVenBar := fCampoTabela('BAR_PREVEN', 'ITEBAR', ['BAR_CODBAR'], [strBarEmb])
  Else
  Begin
    If (intPreEmb = 2) And (Not fEmptyStr(strBarEmb)) Then
      strTabEmb := fCampoTabela('BAR_TABPRE', 'ITEBAR', ['BAR_CODBAR'], [strBarEmb], False)
    Else
      strTabEmb := '';

    If (blnPrvEmb)                    And
       (intPreEmb = 2)                And
       (Not SameText(strTabEmb, 'F')) And
       (Not fEmptyStr(strTabEmb))     Then
    Begin
      If cdsItens <> Nil Then
        fltPreVenBar := cdsItens.FieldByName('ITE_PREVE' + strTabEmb).AsFloat
      Else
        fltPreVenBar := qryConIte.FieldByName('ITE_PREVE' + strTabEmb).AsFloat;
    End
    Else
      fltPreVenBar := 0;
  End;

  If SameText(strIdeProIte, 'NOR')        And
     fCfgSis('TPREMF', VarBoolean)        And
     (Not fEhItemVendaVidro(strCodIte))   And
     (Not fEmptyStr(strBarEmb))           And
     fCfgSis('PRVEMB', VarBoolean)        And
     (Pos(VS_strTRADES, '1_2_') > 0)      And
     (fltPreVenBar > 0)                   Then
  Begin
    Result := fltPreVenBar;
  End;

  If (blnIteCom) Then
    Result := fltUnitOrig;

  Result := fFormataFloat( Result, fMaxDecUni );
end;

procedure TFatVenda.pMontaMensagem(cdsItensVen                  : TUniClientDataSet;
                                   objMsg                       : TMensagemLiberacao;
                                   itemCalcMar                  : TItemCalcMargem   = Nil; //Item que tambem deve entrar na margem(Adicionando ou Alterando)
                                   blnIdentificarItensPromocMSG : Boolean           = False;
                                   blnMostraCndMsgLiberacao     : Boolean           = True;
                                   pgbStatus                    : TcxProgressBar    = Nil;
                                   pNotificarProgresso          : TGenericProcedure = Nil;
                                   AblnAplicaDescontos          : Boolean           = True;
                                   const cdsMargF4: TUniClientDataSet               = Nil;
                                   blnVerificarTodosItens       : Boolean           = True;
                                   strTiposEntrega              : String            = '';
                                   blnOcultaMsgParaQuemRecebe   : Boolean           = False);
  Var
    cdsVendaTmp,
    cdsItensTmp: TUniClientDataSet;

    recTotMarLuc : TRecTotaisMargemLucro;

    fltPerDesIte,
    fltMarkup: Double;

    blnAplicaDescontos: Boolean;
    fltTotalProdutosRateio: Double;
    blnItemPromocaoEntraNoRateio: Boolean;

    strTitVen,
    strDesVen,
    strTitCliFor,
    strNomCliFor,
    strMarMkp,
    strTipEnt: String;

    strCpfCnpjConsumidor: String;

    strMsgTabPre: String;
    blnTabDif: Boolean;

    objTabela : TRegistroMsgLiberaTabela;
    objLinha  : TLinhaMsgLibera;

    objTabelaPreAlt : TRegistroMsgLiberaTabela;
    objLinhaPreAlt  : TLinhaMsgLibera;

    intAgrupador : Integer;

    strExMaF4: string;

    blnTemEmbalagemFechada: Boolean;
    fltPerDescEmbFech: Double;

    fltPratEmb: Double;
    fltTotEmb:Double;
    fltDescTotEmb:Double;
    fltTotUnitar:Double;

    intIndSerInc : Integer;
    strIndSerInc : String;
    strCodSer    : String;
    fltUniSer    : Double;
    fltUniSerOri : Double;
    fltUniSerTot    : Double;
    fltUniSerTotOri : Double;
    fltQtdSer    : Double;
    fltDesSer    : Double;
    strDesSer    : String;
    blnExisteTabelaPrecoDiferenteNosItens: Boolean;
    blnTemItensEmPromocao: Boolean;
    dadosPromocao: TDadosPromocao;

  procedure pIdentificaSituacaoesGerais;
  Var
    strTabTmp: String;
  Begin
    blnExisteTabelaPrecoDiferenteNosItens := False;
    blnTemItensEmPromocao := False;

    With cdsItensTmp Do
    Begin
      First;

      strTabTmp := FieldByName('ITE_TABPRE').AsString;

      While Not Eof Do
      Begin
        If (strTabTmp <> FieldByName('ITE_TABPRE').AsString) Then
          blnExisteTabelaPrecoDiferenteNosItens := True;

        If (FieldByName('ITE_PROMOC').AsString = 'S') Then
          blnTemItensEmPromocao := True;

        Next;
      End;

      First;
    End;
  End;

  function fTemServicoNormal: Boolean;
    Var
      intIndIdx: Integer;
      strIndIdx: String;
  begin
    Result := False;

    For intIndIdx := 1 To 30 Do
    Begin
      strIndIdx := fStrZero(intIndIdx.ToString, 2);
      If (Not fEhServicoTerceirizado(GetPropValue(Self, 'strCodS' + strIndIdx))) Then
      Begin
        If (Not fEmptyStr(GetPropValue(Self, 'strDesS' + strIndIdx))) Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  end;

  function fTemServicoTercer: Boolean;
    Var
      intIndIdx: Integer;
      strIndIdx: String;
  begin
    Result := False;

    For intIndIdx := 1 To 30 Do
    Begin
      strIndIdx := fStrZero(intIndIdx.ToString, 2);
      If (fEhServicoTerceirizado(GetPropValue(Self, 'strCodS' + strIndIdx))) Then
      Begin
        If (Not fEmptyStr(GetPropValue(Self, 'strDesS' + strIndIdx))) Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  end;

  function fLarguraTabela : integer;
  begin
    Result := 136 + IIF(strMarMkp = '99', 9, 0) + IIF(fSolicitaEmpresaNoItemMultLoja, 4, 0);
  end;

  function fItemCarregadoJuntoPDouOR: Boolean;
  begin
    Result := (Length(cdsItensTmp.FieldByName('ITE_SEQDET').AsString) = 20) And
              (Not fEmptyStr(cdsItensTmp.FieldByName('ITE_NUMORC').AsString)) And
              (Not fEmptyStr(cdsItensTmp.FieldByName('ITE_ESPORC').AsString)) And
              (Not fEmptyStr(cdsItensTmp.FieldByName('ITE_EMPORC').AsString));
  end;

begin
  blnTemEmbalagemFechada := False;
  strMarMkp := fMarMpkParaVenda(fCfgSis('MARMKP'));

  If blnOcultaMsgParaQuemRecebe Then
    blnOcultaMsgParaQuemRecebe := fExisteAlgumDestinatarioSemEsseDireitoAcesso('PVPMLR');

  cdsVendaTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsVendaTmp, cdsItensVen);
  cdsVendaTmp.LogChanges := False;

  cdsItensTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsItensTmp, objMargemLucro.cdsItensMargem);
  cdsItensTmp.LogChanges := False;

  fltTotEmb := 0;
  fltDescTotEmb := 0;
  fltTotUnitar := 0;

  If (objMsg.strDirAce = 'EMIFUTNL') Then
  Begin
    cdsItensTmp.Filtered := False;
    cdsItensTmp.Filter   := cdsItensVen.Filter;
    cdsItensTmp.Filtered := True;
  End;

  {**********************************************************************}
  {** Remove os "itens serviços" sem cobrança dos cds's que irão       **}
  {** montar a mensagem, pois no fechamento da venda esses serviços    **}
  {** serão removidos do pedido e, portanto, não devem ser adicionados **}
  {** na mensagem de liberação.                                        **}
  {******************************************************************BL**}
  if (not FRecSer.fTemCobranca) and
     (not fPossuiServico) then
  begin
    
    while cdsVendaTmp.Locate('ITE_CODITE', fCfgSis('ITESER'), []) do
      cdsVendaTmp.Delete;
    while cdsVendaTmp.Locate('ITE_CODITE', fCfgSis('SERTER'), []) do
      cdsVendaTmp.Delete;

    while cdsItensTmp.Locate('ITE_CODITE', fCfgSis('ITESER'), []) do
      cdsItensTmp.Delete;
    while cdsItensTmp.Locate('ITE_CODITE', fCfgSis('SERTER'), []) do
      cdsItensTmp.Delete;

  end;

  pInformacao('Processando mensagem de liberação preços, Aguarde...', pgbStatus);

  If Assigned(pNotificarProgresso) Then
    pNotificarProgresso;

  With cdsVendaTmp Do
  Begin
    If Assigned(itemCalcMar) Then
    Begin
      Append;
      FieldByName('ITE_EMPITE').AsString := itemCalcMar.ITE_EMPITE;
      FieldByName('ITE_CODITE').AsString := itemCalcMar.ITE_CODITE;
      FieldByName('ITE_DESITE').AsString := itemCalcMar.ITE_DESITE;
      FieldByName('ITE_IMPDIR').AsString := itemCalcMar.ITE_IMPDIR;
      FieldByName('ITE_IDEPRO').AsString := itemCalcMar.ITE_IDEPRO;
      FieldByName('ITE_PROMOC').AsString := itemCalcMar.ITE_PROMOC;
      FieldByName('ITE_TABPRE').AsString := itemCalcMar.ITE_TABPRE;
      FieldByName('ITE_NUMLOT').AsString := itemCalcMar.ITE_NUMLOT;

      FieldByName('ITE_CODFAB').AsString := fRetCodFabrica(itemCalcMar.ITE_CODITE);
      FieldByName('ITE_SIGUNI').AsString := fRetSiglaUnidadePorCodIte(itemCalcMar.ITE_CODITE);
      FieldByName('ITE_DESMAR').AsString := fRetNomMarcaItem(itemCalcMar.ITE_CODITE);

      FieldByName('ITE_QTDITE').AsFloat  := itemCalcMar.ITE_QTDITE;
      FieldByName('ITE_CUSITE').AsFloat  := itemCalcMar.ITE_CUSITE;
      FieldByName('ITE_UNITAR').AsFloat  := itemCalcMar.ITE_UNITAR;
      FieldByName('ITE_UNIORI').AsFloat  := itemCalcMar.ITE_UNIORI;
      FieldByName('ITE_PREMED').AsFloat  := itemCalcMar.ITE_PREMED;
      FieldByName('ITE_IMPULT').AsFloat  := itemCalcMar.ITE_IMPULT;
      FieldByName('ITE_PREULT').AsFloat  := itemCalcMar.ITE_PREULT;
      FieldByName('ITE_TOTITE').AsFloat  := fFormataFloat(itemCalcMar.ITE_UNITAR * itemCalcMar.ITE_QTDITE, 2);

      FieldByName('ITE_COMTBL').AsFloat  := itemCalcMar.ITE_COMTBL;
      FieldByName('ITE_IMPFED').AsFloat  := itemCalcMar.ITE_IMPFED;
      FieldByName('ITE_OUTVAL').AsFloat  := itemCalcMar.ITE_OUTVAL;
      FieldByName('ITE_DESOPE').AsFloat  := itemCalcMar.ITE_DESOPE;
      FieldByName('ITE_TAXJUR').AsFloat  := ItemCalcMar.ITE_TAXJUR;

      FieldByName('ITE_VAL_ST').AsFloat  := ItemCalcMar.ITE_VAL_ST;
      FieldByName('ITE_VALFCP').AsFloat  := ItemCalcMar.ITE_VALFCP;
      FieldByName('ITE_VALIPI').AsFloat  := ItemCalcMar.ITE_VALIPI;
      FieldByName('ITE_IPISAI').AsFloat  := ItemCalcMar.ITE_IPISAI;
      FieldByName('ITE_ALQICM').AsFloat  := ItemCalcMar.ITE_ALQICM;
      FieldByName('ITE_BASICM').AsFloat  := ItemCalcMar.ITE_BASICM;
      FieldByName('ITE_VALICM').AsFloat  := ItemCalcMar.ITE_VALICM;
      FieldByName('ITE_TOTCU2').AsFloat  := ItemCalcMar.ITE_TOTCU2;
      FieldByName('ITE_BASRET').AsFloat  := ItemCalcMar.ITE_BASRET;
      FieldByName('ITE_VALRET').AsFloat  := ItemCalcMar.ITE_VALRET;
      FieldByName('ABF_CODFIS').AsString := ItemCalcMar.ABF_CODFIS;
      FieldByName('ITE_VDIFAL').AsFloat  := ItemCalcMar.ITE_VDIFAL;
      FieldByName('ITE_ICMCAL').AsFloat  := ItemCalcMar.ITE_ICMCAL;
      FieldByName('ITE_ICMSAI').AsFloat  := ItemCalcMar.ITE_ICMSAI;
      FieldByName('ITE_RICMPR').AsString := ItemCalcMar.ITE_RICMPR;
      FieldByName('ITE_PERRIC').AsFloat  := ItemCalcMar.ITE_PERRIC;

      FieldByName('ITE_VDIFAL_MARGEM').Value                 := ItemCalcMar.ITE_VDIFAL_MARGEM;
      FieldByName('ITE_ALQDIF_ICMS_MARGEM').Value            := ItemCalcMar.ITE_ALQDIF_ICMS_MARGEM;
      FieldByName('ITE_ALQDIF_ICMS_MARGEM_IMPOSTOS').Value   := ItemCalcMar.ITE_ALQDIF_ICMS_MARGEM_IMPOSTOS;
      FieldByName('ITE_CODFIS_MARGEM').Value                 := ItemCalcMar.ITE_CODFIS_MARGEM;
      FieldByName('ITE_CODABF_MARGEM').Value                 := ItemCalcMar.ITE_CODABF_MARGEM;
      FieldByName('ITE_VALFCP_MARGEM').Value                 := ItemCalcMar.ITE_VALFCP_MARGEM;
      FieldByName('ITE_CALMAR_PREDIN_MAR_MARGEM').Value      := ItemCalcMar.ITE_CALMAR_PREDIN_MAR_MARGEM;
      FieldByName('ITE_CALMAR_PREDIN_MARLIQ_MARGEM').Value   := ItemCalcMar.ITE_CALMAR_PREDIN_MARLIQ_MARGEM;
      FieldByName('ITE_UTILIZA_PRECO_EM_DOLAR_MARGEM').Value := ItemCalcMar.ITE_UTILIZA_PRECO_EM_DOLAR_MARGEM;
      Post;
    End;

    blnAplicaDescontos := Not Assigned(itemCalcMar); // Validacao no final da venda

    If (Not AblnAplicaDescontos) Then
      blnAplicaDescontos := False;

    blnItemPromocaoEntraNoRateio := True;
    fltTotalProdutosRateio := 0;

    If blnAplicaDescontos Then
    Begin
      blnItemPromocaoEntraNoRateio := (fPermiteDescontoPromocao('', tapcdeOlhandoTodosItens)) Or
                                      (fSomenteItensEmPromocaoNaVenda) Or
                                      (fRegraPrecoSugestaoAtiva <> TRegraPrecoSugestao.PrecoDePromocao);

      fltTotalProdutosRateio := fGetTotalProdutosRateio(cdsVenda, blnItemPromocaoEntraNoRateio);
    End;

    //Caso esteja alterando um item e o mesmo ja esteja inserido no client de margem dos itens
    //deve remover o mesmo para inserir novamente com os novos valores
    If Assigned(itemCalcMar) And (itemCalcMar.AUTOINCREM <> 0) And
       cdsItensTmp.Locate('AUTOINCREM', itemCalcMar.AUTOINCREM, []) Then
         cdsItensTmp.Delete;

    First;
    While (Not Eof) Do
    Begin
      pProgresso(RecNo, RecordCount, pgbStatus);

      If Assigned(pNotificarProgresso) Then
        pNotificarProgresso;

      If (Not blnVerificarTodosItens) And (Not(SameValue(itemCalcMar.AUTOINCREM, FieldByName('AUTOINCREM').AsInteger))) Then
      Begin
        Next;
        Continue;
      End;

      //Ignora o item sendo alterado
      If Assigned(itemCalcMar) And (itemCalcMar.AUTOINCREM <> 0) And
         SameValue(itemCalcMar.AUTOINCREM, FieldByName('AUTOINCREM').AsInteger) Then
      Begin
        Next;
        Continue;
      End;

      If fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
      Begin
        If (Not fPossuiServico) Then
        Begin
          Next;
          Continue;
        End
        Else
        Begin
          If (FieldByName('ITE_CODITE').AsString = fCfgSis('ITESER')) Then
          Begin
            If (Not fTemServicoNormal) Then
            Begin
              Next;
              Continue;
            End;
          End;

          If (FieldByName('ITE_CODITE').AsString = fCfgSis('SERTER')) Then
          Begin
            If (Not fTemServicoTercer) Then
            Begin
              Next;
              Continue;
            End;
          End;
        End;
      End;

      If (FieldByName('ITE_PROMOC').AsString = 'S') And
         ((VS_strTRADES = '4') And (Not fConsiderarItemPromocionalMargemMinimaDocumento)) Then
      Begin
        Next;
        Continue;
      End;

      If (fEhMargemMinimaDocumentoDesconsiderandoBrinde) And (fItemCdsBrinde(cdsVendaTmp)) Then
      Begin
        Next;
        Continue;
      End;

      //Caso esteja inserindo ou alterando um produto e o item sendo processado
      //ja esteja inserido no client de margem dos itens deve igonorar os mesmos
      If Assigned(itemCalcMar) And (itemCalcMar.AUTOINCREM <> 0) And
         cdsItensTmp.Locate('AUTOINCREM', cdsVendaTmp.FieldByName('AUTOINCREM').AsInteger, []) Then
      Begin
        Next;
        Continue;
      End;

      //Ignora registros que não são itens. Totais, por exemplo.
      If Assigned(itemCalcMar) And (fEmptyStr(FieldByName('ITE_CODITE').AsString)) Then
      Begin
        Next;
        Continue;
      End;

      If (fIgnoraProdutoCortadoSemSaldo(FieldByName('AUTOINCREM').AsString)) Then
      Begin
        Next;
        Continue;
      End;

      If (Not fEmptyStr(strTiposEntrega)) Then
      Begin
        If Pos(FieldByName('ITE_ENTRET').AsString, strTiposEntrega) <= 0 Then
        Begin
          Next;
          Continue;
        End;
      End;

      If cdsItensTmp.Locate('AUTOINCREM', cdsVendaTmp.FieldByName('AUTOINCREM').AsInteger, []) Then
        cdsItensTmp.Edit
      Else
        cdsItensTmp.Append;


      cdsItensTmp.FieldByName('ITE_SEQUEN').AsInteger := RecNo;

      pPrepararDataSetParaCalculoDaMargem( cdsItensTmp,
                                           cdsVendaTmp,
                                           True,
                                           True,
                                           blnAplicaDescontos,
                                           fltTotalProdutosRateio,
                                           blnItemPromocaoEntraNoRateio);
      cdsItensTmp.Post;

      If (Not blnTemEmbalagemFechada) Then
        blnTemEmbalagemFechada := FieldByName('ITE_EHEMBA').AsBoolean;

      Next;
    End;
  End;

  pCalcularEPreencherMargemDataSet(cdsItensTmp);

  pCalculaTotaisMargemLucro( cdsItensTmp.Data,
                             recTotMarLuc,
                             fltMarkup,
                             0,
                             IIF(blnVerificarTodosItens, False, True),
                             0,
                             0,
                             True);

  blnTabDif    := True;
  strMsgTabPre := '';

  pIdentificaSituacaoesGerais;

  If (Not blnExisteTabelaPrecoDiferenteNosItens) Then
  Begin
    blnTabDif := False;
    cdsItensTmp.First;
    strMsgTabPre := ' - Tabela de Preço: ' + cdsItensTmp.FieldByName('ITE_TABPRE').AsString;
  End;

  {**********************************************************}
  {* VERIFICA SE IRÁ BUSCAR O NOME DO CLIENTE OU FORNECEDOR *}
  {*******************************************************PZ*}
  If (strOpcDoc = 'OF') Then
  Begin
    strTitCliFor := 'Fornecedor:';
    strNomCliFor := Copy(fRetNomFornecedor(strCodCli),1,60) + strMsgTabPre;
  End
  Else
  Begin
    strTitCliFor := 'Cliente:';
    strCpfCnpjConsumidor := '';
    If fClienteConsumidor(fRetNomCliente(strCodCli), True, True) Then
    Begin
      strCpfCnpjConsumidor := Self.strCliCgc;
      strNomCliFor := Self.strCliNom;
      strNomCliFor := IIF(fEmptyStr(strNomCliFor), fRetNomCliente(strCodCli, strCpfCnpjConsumidor), strNomCliFor);
      strNomCliFor := Copy(Self.strCliNom,1,60)  + strMsgTabPre;
    End
    Else
      strNomCliFor := Copy(fRetNomCliente(strCodCli, strCpfCnpjConsumidor),1,60) + strMsgTabPre;
  end;

  If Not fEmptyStr(strCodVen) Then
  Begin
    strTitVen := 'Vendedor:';
    strDesVen := Copy(strNomVen,1,60);
  End;


  objMsg.pAddQuebra;

  If (Not fEmptyStr(strConPag)) And (blnMostraCndMsgLiberacao) Then
  Begin
    if fCfgSis('USACND', varBoolean) then
    begin
      objMsg.pAddTextoCaption('Condição de Pagamento', strCodCnd + '-' + fRetDesConPag(strCodCnd), 0);
      objMsg.pAddTextoCaption('                       ', fFormataCondPag(strConPag), 0);
    end
    else
      objMsg.pAddTextoCaption('Condição de Pagamento', fFormataCondPag(strConPag), 0);

    If (fCfgSis('USAFPG', varBoolean)) And (Not fEmptyStr(strCodFpg)) Then
      objMsg.pAddTextoCaption('Forma de Pagamento', (strCodFpg+'-'+fRetDescFpg(strCodFpg)), 0);

    If ((Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (blnLiberacaoRemotaNoFinalVenda)) And
       (
        ( ( ((Pos(strOpcDoc, 'PD_OR_') > 0) And fCfgSis('TFPF11', varBoolean)) Or fCfgSis('SFPGPD', varBoolean) ) And (strCodFpg = '009')) Or
        ((fCfgSis('SOLCAR', varBoolean)) And (strCodFpg = '007'))
       ) Then
    Begin
      If fCfgSis('USAFPG', varBoolean) Then
        objMsg.pAddTextoCaption('                    ', STRING_FORMAS_PAGTO_NEGOCIADAS, 0)
      Else
        objMsg.pAddTextoCaption('Forma de Pagamento', STRING_FORMAS_PAGTO_NEGOCIADAS, 0);
    End;

    If ((Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (blnLiberacaoRemotaNoFinalVenda)) Then
    Begin
      objMsg.pAddQuebra;
      objMsg.pAddTextoCaption('Frete à Cobrar ', STRING_VALOR_FRETE, 0);
      objMsg.pAddQuebra;
      objMsg.pAddTextoCaption('Frete Cotado   ',   STRING_VALOR_FRETE_COTADO, 0);
    End;

    objMsg.pAddQuebra;
  End;

  objMsg.pAddTexto(STRING_JUSTIFICATIVA);

  objMsg.pAddSeparador(fLarguraTabela);

  If (Not fEmptyStr(strNumOrc)) And (Not fOrcamentoComoPedido) Then
    objMsg.pAddTexto('Documento:' + strNumOrc + '-' + strEspOrc + '-' + VS_strCodEmp);

  objMsg.pAddTexto(strTitCliFor +  strCodCli + ' - ' + strNomCliFor);

  If Not fEmptyStr(strCodVen) Then
    objMsg.pAddTexto(strTitVen +  strCodVen + ' - ' + strDesVen);

  objTabelaPreAlt := TRegistroMsgLiberaTabela.Create;
  objLinhaPreAlt  := TLinhaMsgLibera.Create;
  objLinhaPreAlt.enuTipoLinha := tlCabecalho;
  objLinhaPreAlt.pAddColuna(''  , 'Cod.'        , fTamCodIte, alEsquerda, teAutcom);
  objLinhaPreAlt.pAddColuna(''  , 'Vl.Orig.Doc.', 12 , alCentro  , teAutcom);
  objLinhaPreAlt.pAddColuna(''  , 'Vl.Tab.Atual', 12 , alCentro  , teAutcom);
  objTabelaPreAlt.lstLinhas.Add(objLinhaPreAlt);

  objTabela := TRegistroMsgLiberaTabela.Create;
  objLinha  := TLinhaMsgLibera.Create;
  objLinha.enuTipoLinha := tlCabecalho;
  objLinha.pAddColuna(''  , 'Ent.'      , 4  , alCentro  , teAutcom);
  objLinha.pAddColuna(''  , 'Mot.'      , 4  , alCentro  , teAutcom);
  objLinha.pAddColuna(''  , 'UN'        , 4  , alEsquerda, teAutcom);
  objLinha.pAddColuna(''  , 'Qtd.',        9 , alEsquerda, teAutcom);
  objLinha.pAddColuna(''  , 'Vl.Origi'  , 12 , alCentro  , teAutcom);
  objLinha.pAddColuna(''  , '(%)Desc'   , 7  , alCentro  , teAutcom);

  If (blnTemEmbalagemFechada) Then
  Begin
    objLinha.pAddColuna('', 'Vl.Embal.' , 12, alCentro, teAutcom);
    objLinha.pAddColuna('', '(%)D.Emb'  ,  8, alCentro, teAutcom);
  End;

  objLinha.pAddColuna(''  , 'Vl.Unit'   , 12 , alCentro  , teAutcom);

  If (TMargemMinima.UsaPrecoMedio) Then
  Begin
    objLinha.pAddColuna(''  , 'Pr.Medio'  , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alCentro, teAutcom);
    objLinha.pAddColuna(''  , '%M.PMed'   , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alCentro, teAutcom);
  End
  Else
  Begin
    objLinha.pAddColuna(''  , 'Pr.Custo'  , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alCentro, teAutcom);
    objLinha.pAddColuna(''  , '%M.Prop'   , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alCentro, teAutcom);
    objLinha.pAddColuna(''  , '%M.Prat'   , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alCentro, teAutcom);
  End;

  strExMaF4 := fPadR(fCfgSis('EXMAF4'), 10);
  If strExMaF4[5] = 'S' Then
  begin
    objLinha.pAddColuna('', 'Pr.Ult+Imp', 12 , alCentro  , teAutcom);
    objLinha.pAddColuna('', '%M.Ult+I'  ,  8 , alCentro  , teAutcom);
  end
  else if (TMargemMinima.UsaPrecoCusto) Then
  begin
    objLinha.pAddColuna('', 'Pr.Medio'  , 12 , alCentro  , teAutcom);
    objLinha.pAddColuna('', '%M.PMed'   , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alCentro, teAutcom);
  end;

  if strMarMkp = '99' then
    objLinha.pAddColuna('', '%Markup'   , 8  , alCentro  , teAutcom);

  if fSolicitaEmpresaNoItemMultLoja then
    objLinha.pAddColuna('', 'Emp'       , 3  , alCentro  , teAutcom);

  If (Pos(objMsg.strDirAce, 'EMIFUT_EMIFUTNL_') > 0) Then
  Begin
    objLinha.pAddColuna('', 'Pr.Compra',       15, alCentro, teAutcom);
    objLinha.pAddColuna('', 'Pr.Compra Liq.',  15, alCentro, teAutcom);
    objLinha.pAddColuna('', 'Mult.Compra',     15, alCentro, teAutcom);
  End;

  objLinha.pAddColuna('', 'Val.Promoc.' , 10  , alCentro  , teAutcom);

  objTabela.lstLinhas.Add(objLinha);

  intAgrupador := -1;
  fltUniSerTot    := 0;
  fltUniSerTotOri := 0;

  With cdsItensTmp Do
  Begin
    First;
    While Not Eof Do
    Begin
      pProgresso(RecNo, RecordCount, pgbStatus);

      If Assigned(pNotificarProgresso) Then
        pNotificarProgresso;

      inc(IntAgrupador);

      If FieldByName('ITE_UNIORI').AsFloat = 0 Then
        fltPerDesIte := 0.00
      Else
      Begin
        If fPermiteDescontoEspecialNaConfirmacaoDeDocumentos Then
          fltPerDesIte := (1 - (FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_UNIORI').AsFloat)) * 100
        Else
          fltPerDesIte := (1 - (FieldByName('ITE_UNITAR').AsFloat / FieldByName('ITE_PREORI').AsFloat)) * 100
      End;

      strMsgTabPre := '';

      If (blnTabDif) Then
        strMsgTabPre := ' - Tabela de Preço: ' + FieldByName('ITE_TABPRE').AsString;

      objLinha  := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlValor;
      objLinha.intAgrupador := intAgrupador;

      If fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
      Begin
        If FieldByName('ITE_CODITE').AsString = fCfgSis('ITESER') Then
          objLinha.pAddColuna('Item', 'SERVIÇOS:', objTabela.fGetTamanhoFinalCabecalho - 3)
        Else
          objLinha.pAddColuna('Item', 'SERVIÇOS TERCERIZADOS:', objTabela.fGetTamanhoFinalCabecalho - 3);
      End
      Else
      Begin
        If (blnIdentificarItensPromocMSG) Then
        Begin
          If (FieldByName('ITE_PROMOC').AsString = 'S') Then
            objLinha.pAddColuna('Item', '*' + FieldByName('ITE_CODITE').AsString + ' - ' + Copy(FieldByName('ITE_DESITE').AsString,1,109), objTabela.fGetTamanhoFinalCabecalho - 3)
          Else
            objLinha.pAddColuna('Item', FieldByName('ITE_CODITE').AsString + ' - ' + Copy(FieldByName('ITE_DESITE').AsString,1,109), objTabela.fGetTamanhoFinalCabecalho - 3);
        End
        Else
          objLinha.pAddColuna('Item', FieldByName('ITE_CODITE').AsString + ' - ' + Copy(FieldByName('ITE_DESITE').AsString,1,109), objTabela.fGetTamanhoFinalCabecalho - 3);
      End;

      objTabela.lstLinhas.Add(objLinha);

      If fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
      Begin
        For intIndSerInc := 1 To 30 Do
        Begin
          strIndSerInc := fStrZero(intIndSerInc.ToString, 2);
          strCodSer    := GetPropValue(Self, 'strCodS' + strIndSerInc);
          strDesSer    := GetPropValue(Self, 'strDesS' + strIndSerInc);
          fltQtdSer    := GetPropValue(Self, 'fltQtdS' + strIndSerInc);
          fltUniSer    := GetPropValue(Self, 'fltUniS' + strIndSerInc);
          fltUniSerOri := fRetornaValorServico(strCodSer);
          If (fltUniSerOri = 0) Then
            fltUniSerOri := fltUniSer;
          fltDesSer    := ((1 - (fltUniSer / fltUniSerOri)) * 100);

          If FieldByName('ITE_CODITE').AsString = fCfgSis('ITESER') Then
            If fEhServicoTerceirizado(strCodSer) Then
              Continue;

          If FieldByName('ITE_CODITE').AsString = fCfgSis('SERTER') Then
            If Not fEhServicoTerceirizado(strCodSer) Then
              Continue;

          If Not strDesSer.IsEmpty Then
          Begin
            fltUniSerTot    := fltUniSerTot + (fltUniSer * fltQtdSer);
            fltUniSerTotOri := fltUniSerTotOri + (fltUniSerOri * fltQtdSer);

            objLinha  := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.intAgrupador := intAgrupador;
            objLinha.pAddColuna('Serviço', strCodSer + ' - ' + Copy(strDesSer, 1, 109), objTabela.fGetTamanhoFinalCabecalho - 3);
            objTabela.lstLinhas.Add(objLinha);

            objLinha  := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.intAgrupador := intAgrupador;

            objLinha.pAddColuna('Ent.'      , '', 4, alEsquerda, teAutcom);
            objLinha.pAddColuna('Mot.'      , '', 4, alEsquerda, teAutcom);
            objLinha.pAddColuna('UN'        , '', 4, alEsquerda, teAmbos);
            objLinha.pAddColuna('Qtd.'      , FloatToStrf(fltQtdSer, ffFixed, 11, fCfgSis('DECQTD', varInteger)) , 9, alEsquerda, teAmbos);
            objLinha.pAddColuna('Vl.Origi'  , FloatToStrf(fltUniSerOri, ffFixed, 10, VS_intDecUni)               , 12, alDireita , teAmbos);
            objLinha.pAddColuna('(%)Desc'   , FloatToStrf(fltDesSer, ffFixed, 10, VS_intDecUni)                  , 7,  alDireita , teAmbos);

            If (blnTemEmbalagemFechada) Then
            Begin
              objLinha.pAddColuna('Vl.Embal.', '', 12, alDireita, teAmbos);
              objLinha.pAddColuna('(%)D.Emb' , '',  8, alDireita, teAmbos);
            End;

            objLinha.pAddColuna('Vl.Unit'   , FloatToStrf(fltUniSer, ffFixed, 10, VS_intDecUni), 12 , alDireita, teAmbos);

            objLinha.pAddColuna('Pr.Custo'  , '', fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
            objLinha.pAddColuna('%M.Prop'   , '', fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
            objLinha.pAddColuna('%M.Prat'   , '', fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);

            If strExMaF4[5] = 'S' Then
            begin
              objLinha.pAddColuna('Pr.Ult+Imp', '', 12, alDireita, teAmbos);
              objLinha.pAddColuna('%M.Ult+I'  , '',  8, alDireita, teAmbos);
            end
            else
            begin
              objLinha.pAddColuna('Pr.Medio'  , '', fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
              objLinha.pAddColuna('%M.PMed'   , '', 10, alDireita, teAmbos);
            end;

            if strMarMkp = '99' then
              objLinha.pAddColuna('%Markup'   , '', 8, alDireita, teAmbos);

            if fSolicitaEmpresaNoItemMultLoja then
              objLinha.pAddColuna('Emp'       , '', 3, alCentro, teAmbos);

            If (Pos(objMsg.strDirAce, 'EMIFUT_EMIFUTNL_') > 0) Then
            Begin
              objLinha.pAddColuna('Pr.Compra'       , '', 15, alCentro, teAmbos);
              objLinha.pAddColuna('Pr.Compra Liq.'  , '', 15, alCentro, teAmbos);
              objLinha.pAddColuna('Mult.Compra'     , '', 15, alCentro, teAmbos);
            End;

            objLinha.pAddColuna('Val.Promoc.'       , '', 10, alCentro, teAutcom);

            objTabela.lstLinhas.Add(objLinha);
          End;
        End;

        Next;
        Continue;
      End
      Else
      Begin
        objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.intAgrupador := intAgrupador;
        objLinha.pAddColuna('Marca', Copy(FieldByName('ITE_DESMAR').AsString,1,100) + strMsgTabPre , objTabela.fGetTamanhoFinalCabecalho - 3, alEsquerda, teAmbos, True);
        objTabela.lstLinhas.Add(objLinha);

        objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.intAgrupador := intAgrupador;
      End;

      if FieldByName('ITE_ENTRET').AsString = 'E' then
      begin
        If FieldByName('ITE_ENTFUT').AsString = 'S' Then
          strTipEnt := 'E.F'
        Else
          strTipEnt := 'E.I';
      end
      else
      begin
        If FieldByName('ITE_LOCRET').AsString = '' then
          strTipEnt := 'R';

        If FieldByName('ITE_LOCRET').AsString = 'C' Then
          strTipEnt := 'R.C';

        If FieldByName('ITE_LOCRET').AsString = 'E' Then
          strTipEnt := 'R.E';

        If FieldByName('ITE_LOCRET').AsString = 'B' Then
          strTipEnt := 'R.B';

        If FieldByName('ITE_LOCRET').AsString = 'B2' Then
          strTipEnt := 'R.B2';
      end;

      objLinha.pAddColuna('Ent.'      , strTipEnt                         , 4  , alEsquerda , teAutcom);
      objLinha.pAddColuna('Mot.'      , FieldByName('ITE_MOTFUT').AsString, 4  , alEsquerda , teAutcom);

      objLinha.pAddColuna('UN'        , Copy(FieldByName('ITE_SIGUNI').AsString,1,4)                                               , 4  , alEsquerda , teAmbos);
      objLinha.pAddColuna('Qtd.', FloatToStrf(FieldByName('ITE_QTDITE').AsFloat, ffFixed, 11, fCfgSis('DECQTD', varInteger))       , 9 , alEsquerda , teAmbos);

      If fPermiteDescontoEspecialNaConfirmacaoDeDocumentos Then
        objLinha.pAddColuna('Vl.Origi', FloatToStrf(FieldByName('ITE_UNIORI').AsFloat, ffFixed, 10, VS_intDecUni)                  , 12 , alDireita  , teAmbos)
      Else
        objLinha.pAddColuna('Vl.Origi', FloatToStrf(FieldByName('ITE_PREORI').AsFloat, ffFixed, 10, VS_intDecUni)                  , 12 , alDireita  , teAmbos);

      objLinha.pAddColuna('(%)Desc'   , FloatToStrf(fltPerDesIte                     , ffFixed, 10, VS_intDecUni)                  , 7 , alDireita  , teAmbos);

      If (blnTemEmbalagemFechada) Then
      Begin
        fltPratEmb        := 0;
        fltPerDescEmbFech := 0;

        If FieldByName('ITE_EHEMBA').AsBoolean Then
        Begin
          fltPratEmb        := FieldByName('ITE_VLPEMB').AsFloat;
          fltPerDescEmbFech := FieldByName('ITE_PEREMB').AsFloat;
          fltTotEmb         := fltTotEmb + (FieldByName('ITE_VLPEMB').AsFloat * FieldByName('ITE_QTDITE').AsFloat);
          fltTotUnitar      := fltTotUnitar + (FieldByName('ITE_UNITAR').AsFloat * FieldByName('ITE_QTDITE').AsFloat);
        End;

        objLinha.pAddColuna('Vl.Embal.',    FloatToStrf(fltPratEmb, ffFixed, 10, VS_intDecUni),        12 , alDireita, teAmbos);
        objLinha.pAddColuna('(%)D.Emb' , FloatToStrf(fltPerDescEmbFech, ffFixed, 10, VS_intDecUni),     8 , alDireita, teAmbos);
      End;

      objLinha.pAddColuna('Vl.Unit'   , FloatToStrf(FieldByName('ITE_UNITAR').AsFloat, ffFixed, 10, VS_intDecUni)                  , 12 , alDireita  , teAmbos);

      If (TMargemMinima.PorPrecoCustoPreCus) Then
      Begin
        objLinha.pAddColuna('Pr.Custo'  , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_CUSITE').AsFloat, ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
