function TFatVenda.fValidaQuantidadeEmDevolucaoConformeOriginal: String;
  Var
    itemGer: TDadosFechamento;
    itemAux: TDadosFechamento;
    fltQtdDev: Double;
    fltQtdOri: Double;
    fltQtdRest: Double;
    intDecQtd: Integer;
    strSeqGerAux: String;
begin
  Result := '';

  If (Not fCfgSis('RVQDDV', VarBoolean)) Then
    Exit;

  If (blnEhDevolucaoAbastecimentoDeposito) Then
    Exit;

  if blnEnvioClienteGarantia then
    Exit;

  If fEhDevolucaoOriginadaDeNotaAbastecimentoDeposito(arrMatItens[0].strDocDev, arrMatItens[0].strEspDev, arrMatItens[0].strEmpDev) Then
    Exit;

  intDecQtd := fCfgSis('DECQTD', varInteger);

  For itemGer In arrMatItens Do
  Begin
    If (Pos(itemGer.strTabDev, 'MOVDET_NOTDET_') > 0) And (Not fEmptyStr(itemGer.strAiDvOr)) Then
    Begin
      fltQtdDev := 0;
      For itemAux In arrMatItens Do
      Begin
        If (itemGer.strAiDvOr = itemAux.strAiDvOr) Then
          fltQtdDev := fltQtdDev + itemAux.fltQtdIte;
      End;

      If (fltQtdDev > 0) Then
      Begin
        fltQtdOri := 0;

        If VS_strHabilitarCRM And (Not fEmptyStr(strCodAde)) Then
        Begin
          strSeqGerAux := fCampoTabela('DET_SEQGER', itemGer.strTabDev, ['AUTOINCREM'], [itemGer.strAiDvOr]);
          fltQtdOri := fCampoTabela('SUM(DET_QTDITE)', itemGer.strTabDev, ['DET_SEQGER', 'DET_CODITE'], [strSeqGerAux, itemGer.strCodIte]);
        End
        Else
        Begin
          For itemAux In arrMatItens Do
          Begin
            If (itemGer.strAiDvOr = itemAux.strAiDvOr) Then
              fltQtdOri := fltQtdOri + fCampoTabela('DET_QTDITE', itemGer.strTabDev, ['AUTOINCREM'], [itemGer.strAiDvOr]);
          End;
        End;

        fltQtdRest := fFormataFloat(fltQtdOri - fRetornaQuantidadeJaDevolvida(itemGer.strAiDvOr, itemGer.strDocDev, itemGer.strEspDev), intDecQtd);

        If (fFormataFloat(fltQtdDev, intDecQtd) > fFormataFloat(fltQtdRest, intDecQtd)) Then
        Begin
          pIncrementaListaStr(itemGer.strCodIte+
                              ' - QTD.DEV.: '+FloatToStrf(fltQtdDev, ffFixed, 11, intDecQtd)+
                              ' - QTD.ORI.: '+FloatToStrf(fltQtdOri, ffFixed, 11, intDecQtd)+
                              ' - QTD.RES.: '+FloatToStrf(fltQtdRest, ffFixed, 11, intDecQtd)+
                              ' - AUTINC.: '+itemGer.strAiDvOr, Result);
          Break;
        End;

      End;  
    End;
  End;
end;

function TFatVenda.fEhDevolucaoOriginadaDeNotaAbastecimentoDeposito(strDocDev, strEspDev, strEmpDev: String): Boolean;
begin
  Result := fCampoTabela('AUXMOV.AUX_ABADEP','MOVGER INNER JOIN AUXMOV ON(MOVGER.AUTOINCREM = AUXMOV.AUX_SEQGER)',['GER_NUMDOC','GER_ESPDOC','GER_CODEMP'],[strDocDev,strEspDev,strEmpDev]) = 'S';
