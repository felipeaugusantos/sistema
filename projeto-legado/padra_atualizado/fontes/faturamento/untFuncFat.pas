function TFatVenda.fEhVendaNormalNegociadaUtilizandoCreditoComBaixaDeDuplicataAVista: Boolean;
begin
  Result := False;

  If (Pos(Self.strOpcDoc, 'VN_CF_') > 0) Then
  Begin
    If Not (Pos(strEspDoc, 'NF_IF_FF_') > 0) Then
      Exit;

    If Not ((Self.VS_blnUsaFpg) And (Self.strCodFpg = '009'))  Then
      Exit;

    If blnUtilizacaoCreditoEDinheiroOriF11 Then
      Exit;

    If Not ((Abs(fFormataFloat(fltValCre, 2)) > 0) And (fFormataFloat(fltValDin, 2) - fFormataFloat(Abs(fltValCre), 2) = 0)) Then
      Exit;

    If Not fBaixaDuplicataAVista(strEmpLog) Then
      Exit;

    Result := True;
  End;
end;

