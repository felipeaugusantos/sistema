      Begin
        objLinha.pAddColuna('Pr.Medio'  , FloatToStrf(recTotMarLuc.fltTotMedLiq, ffFixed, 10, VS_intDecUni) , 12 , alDireita  , teAmbos);
        objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarMedio, ffFixed, 8, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      End;
    end;

    if strMarMkp = '99' then
      objLinha.pAddColuna('%Markup'   , FloatToStrf(fltMarkup, ffFixed, 8, 2), 8  , alDireita  , teAmbos);

    {Mostra empresa do item quando utiliza Multiloja!}
    if fSolicitaEmpresaNoItemMultLoja then
      objLinha.pAddColuna('Emp'       , '', 3  , alCentro  , teAutcom);

    objLinha.pAddColuna('Val.Promoc.'       , '', 10  , alCentro  , teAutcom);

    objTabela.lstLinhas.Add(objLinha);

    objMsg.lstRegistros.Add(objTabela);

    objMsg.pAddSeparador(fLarguraTabela);
    objMsg.pAddTexto('(*) Os valores dos totalizadores consideram a quantidade dos itens.');
    objMsg.pAddSeparador(fLarguraTabela);

    If (blnIdentificarItensPromocMSG And blnTemItensEmPromocao) Then
    Begin
      objMsg.pAddSeparador(fLarguraTabela);
      objMsg.pAddTexto('(*) Produtos em promoção.');
      objMsg.pAddSeparador(fLarguraTabela);
    End;

    blnMensagemItePreAltPdOr := False;
    If (objTabelaPreAlt.lstLinhas.Count > 1) Then
    Begin
      blnMensagemItePreAltPdOr := True;
      objMsg.pAddTexto(' ');
      objMsg.pAddSeparador(fLarguraTabela);
      objMsg.pAddTexto('(**) ITENS QUE TIVERAM PREÇO DE TABELA ALTERADO DEPOIS DA CRIAÇÃO DESTE DOCUMENTO');
      objMsg.lstRegistros.Add(objTabelaPreAlt);
      objMsg.pAddSeparador(fLarguraTabela);
    End;

    pMostraMensagemFechamentoEhOrcemPed(objMsg);
  End;

  If Assigned(cdsMargF4) Then
    cdsMargF4.Data := cdsItensTmp.Data;

  FreeAndNil(cdsVendaTmp);
  FreeAndNil(cdsItensTmp);
end;

procedure TFatVenda.pMontaMensagemItensDetalhe(cdsItensVen         : TUniClientDataSet;
                                                 objMsg              : TMensagemLiberacao;
                                                 pgbStatus           : TcxProgressBar    = Nil;
                                                 pNotificarProgresso : TGenericProcedure = Nil);
  Var
    cdsClone: TUniClientDataSet;

    strIteEmi,
    strDesEmi,
    strCodUni,
    strQtdEmi,
    strValUni,
    strTotIte: String;

    objTabela : TRegistroMsgLiberaTabela;
    objLinha  : TLinhaMsgLibera;

begin

  cdsClone := TUniClientDataSet.Create(Self);

  Try

    pCloneDataSet(cdsClone, cdsVenda);

    while cdsClone.Locate('ITE_CODITE', fCfgSis('ITESER'), []) do
      cdsClone.Delete;
    while cdsClone.Locate('ITE_CODITE', fCfgSis('SERTER'), []) do
      cdsClone.Delete;

    objTabela := TRegistroMsgLiberaTabela.Create;
    objLinha  := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlCabecalho;
    objLinha.pAddColuna(''  , 'Item'       , 6  , alCentro   , teAutcom);
    objLinha.pAddColuna(''  , 'Descrição'  , 50 , alEsquerda , teAutcom);
    objLinha.pAddColuna(''  , 'Unidade'    , 7  , alEsquerda , teAutcom);
    objLinha.pAddColuna(''  , 'Quantidade' , 12 , alDireita  , teAutcom);
    objLinha.pAddColuna(''  , 'Vr.Unitário', 11 , alDireita  , teAutcom);
    objLinha.pAddColuna(''  , 'Vr.Total'   , 16 , alDireita  , teAutcom);
    objTabela.lstLinhas.Add(objLinha);

    With cdsClone Do
    Begin
      First;

      While Not Eof Do
      Begin
        strIteEmi := FieldByName('ITE_CODITE').AsString;
        strDesEmi := FieldByName('ITE_DESITE').AsString;
        strCodUni := FieldByName('ITE_CODUNI').AsString;
        strQtdEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), FieldByName('ITE_QTDITE').AsFloat);
        strValUni := FormatFloat(fMskDigitos(VS_intDecUni), FieldByName('ITE_UNITAR').AsFloat);
        strTotIte := FormatFloat(fMskDigitos(VS_intDecUni), FieldByName('ITE_TOTITE').AsFloat);

        objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.pAddColuna('Item'       , strIteEmi , 6  , alCentro  );
        objLinha.pAddColuna('Descrição'  , strDesEmi , 50 , alEsquerda);
        objLinha.pAddColuna('Unidade'    , strCodUni , 7  , alEsquerda);
        objLinha.pAddColuna('Quantidade' , strQtdEmi , 12 , alDireita );
        objLinha.pAddColuna('Vr.Unitário', strValUni , 11 , alDireita );
        objLinha.pAddColuna('Vr.Total'   , strTotIte , 16 , alDireita );
        objTabela.lstLinhas.Add(objLinha);

        Next;

      End;

    End;

    objMsg.pAddQuebra;
    objMsg.lstRegistros.Add(objTabela);

  Finally

    FreeAndNil(cdsClone);

  End;

end;

procedure TFatVenda.pAtualizaPrecosParaTrava(Var cdsDados: TUniClientDataSet; blnUnitarioLiquido: Boolean = False);
  Var
   intContador: Integer;
   fltTotIte : Double;
begin
  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    If cdsDados.Locate('AUTOINCREM', arrMatItens[intContador].intAutInc, []) Then
    Begin
      cdsDados.Edit;
        cdsDados.FieldByName('ITE_PRECUS').AsFloat := arrMatItens[intContador].fltPreCus;

        If (fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto) Then
          cdsDados.FieldByName('ITE_PRECU2').AsFloat :=  arrMatItens[intContador].fltPreCus  * (1 + fGetTaxVprItem(arrMatItens[intContador].strCodIte, arrMatItens[intContador].strEmpIte) / 100) +
                                                         arrMatItens[intContador].fltOutVal  + fSomaComissaoAoOutrosValores(arrMatItens[intContador]) +
                                                         (arrMatItens[intContador].fltICMSai * arrMatItens[intContador].fltUniTar/100) +
                                                         (arrMatItens[intContador].fltImpFed * arrMatItens[intContador].fltUniTar/100) +
                                                       (arrMatItens[intContador].fltDesOpe * arrMatItens[intContador].fltUniTar/100)
      Else
        cdsDados.FieldByName('ITE_PRECU2').AsFloat := arrMatItens[intContador].fltPreCu2;

      cdsDados.FieldByName('ITE_TOTCUS').AsFloat := arrMatItens[intContador].fltTotCus;
      cdsDados.FieldByName('ITE_TOTCU2').AsFloat := arrMatItens[intContador].fltTotCu2;

      If blnUnitarioLiquido Then
      Begin

        fltTotIte := IIF(blnImpSfa, cdsDados.FieldByName('ITE_TOTITE').AsFloat, arrMatItens[intContador].fltTotIte);

        cdsDados.FieldByName('ITE_UNITAR').AsFloat := fFormataFloat((fltTotIte - arrMatItens[intContador].fltDesEsp) / arrMatItens[intContador].fltQtdIte, VS_intDecUni);
        cdsDados.FieldByName('ITE_TOTITE').AsFloat := (fltTotIte - arrMatItens[intContador].fltDesEsp);

      End;

      cdsDados.Post;
    End;
  End;

  If cdsVenda.Filtered Then
  Begin
    cdsDados.Filter   := cdsVenda.Filter;
    cdsDados.Filtered := True;
  End;
end;

function TFatVenda.fVerificaVrMinimo(fltTotAnt, fltTotGer: Double; intPraMed: Integer; strEspVer: String = '';
  blnPedeSenha: Boolean = True; blnMsgLib: Boolean = True; pgbStatus: TcxProgressBar = Nil;
  pNotificarProgresso: TGenericProcedure = nil; blnEhPedidoItemCortado: Boolean = False): Boolean;
  Var
    strTabelaPreco: String;
    fltQtdJaDig: Double;
    fltQtdJaEmPromoc: Double;
    recTotTrv : TrecTotaisTravaMinima;
    cdsDados  : TUniClientDataSet;
    fltUniOriTmp: Double;
    blnEmCamp: Boolean;
    strPromocSav: String;
    strNTrava: String;
    blnValidarCustoJuntoComMargemMinima : Boolean;

  function fCustoMinimoTrava: Double;
  begin
    Result := 0;

    If fCfgSis('MINCUS') = TRAVA_MINIMO_PRECO_CUSTO Then
      Result := cdsDados.FieldByName('ITE_TOTCUS').AsFloat

    Else If fCfgSis('MINCUS') = TRAVA_MINIMO_CUSTO_REAL Then
      Result := cdsDados.FieldByName('ITE_TOTCU2').AsFloat;
  end;

  function fPegaUnitarioTrava(intNivel: Integer): Double;
    Var
      fltValTaxAux: Double;
  begin
    Result := fFormataFloat(fRetornaUnitarioTrava(cdsDados.FieldByName('ITE_IDEPRO').AsString,
                                                  cdsDados.FieldByName('ITE_UNITAR').AsFloat,
                                                  IIF(fTemQuantEmbalagemFechada(cdsDados.FieldByName('ITE_CODITE').AsString),
                                                                                cdsDados.FieldByName('ITE_UNIVIS').AsFloat,
                                                                                cdsDados.FieldByName('ITE_UNIORI').AsFloat),
                                                  cdsDados.FieldByName('ITE_UNIDEV').AsFloat,
                                                  cdsDados.FieldByName('ITE_QTDITE').AsFloat,
                                                  fltQtdJaDig,
                                                  fltQtdJaEmPromoc,
                                                  cdsDados.FieldByName('ITE_EMPITE').AsString,
                                                  '2',
                                                  True,
                                                  blnEmCamp,
                                                  cdsDados.FieldByName('ITE_TABPRE').AsString,
                                                  intPraMed,
                                                  cdsDados,
                                                  cdsDados.FieldByName('ITE_PRELOT').AsFloat,
                                                  intNivel,
                                                  ((cdsDados.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsDados.FieldByName('ITE_ENTFUT').AsString = 'N')),
                                                  ((cdsDados.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsDados.FieldByName('ITE_ENTFUT').AsString = 'S')),
                                                  cdsDados.FieldByName('ITE_MOTFUT').AsString,
                                                  cdsDados.FieldByName('ITE_BAREMB').AsString,
                                                  cdsDados.FieldByName('ITE_PROACA').AsInteger = 1,
                                                  ((cdsDados.FieldByName('ITE_SEQCOM').AsInteger > 0) And (cdsDados.FieldByName('ITE_ATIVAC').AsString <> 'S')),
                                                  cdsDados.FieldByName('ITE_UNISBI').AsFloat,
                                                  0,
                                                  Nil,
                                                  cdsDados.FieldByName('ITE_SOMCOL').AsFloat),
                                                  VS_intDecUni);

    If (Not fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto) And (Not blnEmCamp) Then
    Begin
      fltValTaxAux := fGetTaxVprItem(cdsDados.FieldByName('ITE_CODITE').AsString, cdsDados.FieldByName('ITE_EMPITE').AsString);
      If (fltValTaxAux > 0) Then
      Begin
        If fPermiteAplicarJurosNaPromocao(cdsDados.FieldByName('ITE_PROMOC').AsString) Then
          Result := fCalculaPrecoVendaConformeTaxaJurosOuJurosRemanescentePromoc(cdsDados.FieldByName('ITE_CODITE').AsString, Result, fltValTaxAux);
      End;
    End;
  end;

  procedure pCalculaQtdJaDigitada;
  begin
    fltQtdJaDig := 0;
    fltQtdJaEmPromoc := 0;

    With cdsDados Do
    Begin
      If (fItemPassivelDeVerificacaoPromo(FieldByName('ITE_CODITE').AsString, fGetEmpPrecoPromoItem(FieldByName('ITE_EMPITE').AsString))) Then
      Begin
        fltQtdJaDig := fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,
                                       FieldByName('ITE_NUMLOT').AsString,
                                       FieldByName('AUTOINCREM').AsString,
                                       FieldByName('ITE_CODACA').AsString,
                                       FieldByName('ITE_EMPACA').AsString,
                                       fGetEmpPrecoPromoItem(FieldByName('ITE_EMPITE').AsString),
                                       False);

        fltQtdJaEmPromoc := fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,
                                            FieldByName('ITE_NUMLOT').AsString,
                                            FieldByName('AUTOINCREM').AsString,
                                            FieldByName('ITE_CODACA').AsString,
                                            FieldByName('ITE_EMPACA').AsString,
                                            FieldByName('ITE_EMPITE').AsString,
                                            False,
                                            False,
                                            fDesconsiderarNaQtdLimDaPromoItensUnitarMaior,
                                            True {Somente em promocao});
      End;
    End;

  end;

  function fItemCarregadoJuntoPDouOR: Boolean;
  begin
    Result := (Length(cdsDados.FieldByName('ITE_SEQDET').AsString) = 20) And
              (Not fEmptyStr(cdsDados.FieldByName('ITE_NUMORC').AsString)) And
              (Not fEmptyStr(cdsDados.FieldByName('ITE_ESPORC').AsString)) And
              (Not fEmptyStr(cdsDados.FieldByName('ITE_EMPORC').AsString));
  end;

  procedure pProcessaTotaisParaTrava;
    Var
     qryTinta: TUniQuery;
     blnTravarPeloPrecoPromocaoCodIte : Boolean;
  begin
    blnTravarPeloPrecoPromocaoCodIte := False;
    pAtualizaPrecosParaTrava(cdsDados);
    pAtualizaItensCortados(cdsDados, blnEhPedidoItemCortado);

    If TMostraTravaMinimaHelper.fExibeTravaMinima Then
      TMostraTravaMinimaHelper.pVerificaItensDeletados(cdsDados, cdsTravaMinima);

    qryTinta := fCriaQuery(Self);
    With cdsDados, recTotTrv Do
    Begin
      fltValMin       := 0;
      fltEntTra       := 0;
      fltMinCus       := 0;
      fltPreTab       := 0;
      fltUniTraPro    := 0;
      fltValMinNv2    := 0;
      fltValMinNv3    := 0;
      fltValMinNv4    := 0;
      fltValMinNv5    := 0;
      fltValMinNv6    := 0;
      fltUniTraProNv2 := 0;
      fltUniTraProNv3 := 0;
      fltUniTraProNv4 := 0;
      fltUniTraProNv5 := 0;
      fltUniTraProNv6 := 0;
      fltTinMaq       := 0;
      fltTotTin       := 0;
      fltValMinPromoc := 0;
      fltPreTabPromoc := 0;
      fltTotGerPromoc := 0;

      First;

      While (Not Eof) Do
      Begin
        pProgresso(RecNo, RecordCount, pgbStatus);

        If (FieldByName('ITE_PROMOC').AsString = 'S') Or ((FieldByName('ITE_SEQCOM').AsInteger > 0) And (FieldByName('ITE_ATIVAC').AsString <> 'S')) Then
        Begin
          blnTravarPeloPrecoPromocaoCodIte := fTravarPeloPrecoPromocao(FieldByName('ITE_CODPRO').AsString);
        End;

        If Assigned(pNotificarProgresso) Then
          pNotificarProgresso;

        If (FieldByName('ITE_BRINDE').AsString <> 'S') And
           (Not fEhItemServico(FieldByName('ITE_CODITE').AsString)) Then
        Begin
          TProQtdColetiva.strRshTinAtual := FieldByName('ITE_ITETIN').AsString;

          {**************************************}
          {* PRODUTOS <NORMAIS>                 *}
          {***********************************WI*}
          If (FieldByName('ITE_IDEPRO').AsString = 'NOR') Or (fTravaUnitarioDeTintaComoProdutoNormal) Then
          Begin
            pCalculaQtdJaDigitada;

            {**************************************}
            {* PEGA VALOR UNITARIO "TRAVA"        *}
            {********************************WI,JB*}
            fltUniTraPro := fPegaUnitarioTrava(1);//Nivel 1

            If FieldByName('ITE_ENTSAI').AsString = 'E' Then
              fltEntTra := fltEntTra + FieldByName('ITE_TOTITE').AsFloat
            Else
            Begin
              If fEmptyStr(FieldByName('ITE_TABPRE').AsString) Then
                strTabelaPreco := Self.strTabPre
              Else
                strTabelaPreco := FieldByName('ITE_TABPRE').AsString;

              If fUtilizaPrecoEmbalagemFechadaComoMinimo(FieldByName('ITE_IDEPRO').AsString,
                                                         FieldByName('ITE_CODITE').AsString,
                                                         FieldByName('ITE_TABPRE').AsString,
                                                         FieldByName('ITE_PROMOC').AsString,
                                                         FieldByName('ITE_QTDITE').AsFloat) Then
              Begin
                fltUniOriTmp := fGetUnitarioEmbalagemFechada(FieldByName('ITE_CODITE').AsString,
                                                             FieldByName('ITE_TABPRE').AsString,
                                                             FieldByName('ITE_QTDITE').AsFloat,
                                                             FieldByName('ITE_UNIORI').AsFloat);
              End
              Else If fUtilizaPrecoTabelaTravaProdutoEmbalagem(FieldByName('ITE_IDEPRO').AsString,
                                                               FieldByName('ITE_CODITE').AsString,
                                                               FieldByName('ITE_BAREMB').AsString) Then
              Begin
                strPromocSav := Self.strPromoc;
                Self.strPromoc := FieldByName('ITE_PROMOC').AsString;
                fltUniOriTmp := fPegaPrecoVenda(cdsDados,
                                                FieldByName('ITE_EMPITE').AsString,
                                                FieldByName('ITE_ENTSAI').AsString,
                                                fltMargem,
                                                (Pos('ITEM ESPECIAL', FieldByName('ITE_DESITE').AsString) > 0),
                                                'NOR',
                                                FieldByName('ITE_TABPRE').AsString);
                Self.strPromoc := strPromocSav;
              End
              Else
              Begin
                If (FieldByName('ITE_PROMOC').AsString = 'S') Then
                  fltUniOriTmp := FieldByName('ITE_UNIORI').AsFloat
                Else If fPermiteDescontoEspecialNaConfirmacaoDeDocumentos Then
                  fltUniOriTmp := FieldByName('ITE_UNIORI').AsFloat
                Else If fPrecoEmbalagemFechadaEhPrecoTabela(FieldByName('ITE_IDEPRO').AsString,
                                                            FieldByName('ITE_CODITE').AsString,
                                                            FieldByName('ITE_TABPRE').AsString,
                                                            FieldByName('ITE_PROMOC').AsString,
                                                            FieldByName('ITE_QTDITE').AsFloat,
                                                            ((FieldByName('ITE_SEQCOM').AsInteger > 0) And (FieldByName('ITE_ATIVAC').AsString <> 'S'))) Then
                Begin
                  fltUniOriTmp := fGetUnitarioEmbalagemFechada(FieldByName('ITE_CODITE').AsString,
                                                               FieldByName('ITE_TABPRE').AsString,
                                                               FieldByName('ITE_QTDITE').AsFloat,
                                                               FieldByName('ITE_UNIORI').AsFloat,
                                                               fCfgSis('CLPVDI', varBoolean, GetEmpCfg(FieldByName('ITE_EMPITE').AsString)));
                End
                Else If fItemCarregadoJuntoPDouOR Then
                Begin
                  If (FindField('ITE_PRETAB') <> Nil) And (FieldByName('ITE_PRETAB').AsFloat > 0) Then
                    fltUniOriTmp := FieldByName('ITE_PRETAB').AsFloat
                  Else
                    fltUniOriTmp := FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat
                End
                Else
                  fltUniOriTmp := FieldByName('ITE_UNIORI').AsFloat
              End;

              fltValMin := fltValMin + fFormataFloat((fltUniTraPro * FieldByName('ITE_QTDITE').AsFloat), 2);
              fltMinCus := fltMinCus + fCustoMinimoTrava;

              If (FieldByName('ITE_PROMOC').AsString = 'S') Or ((FieldByName('ITE_SEQCOM').AsInteger > 0) And (FieldByName('ITE_ATIVAC').AsString <> 'S')) Then
              Begin
                //Utilizados apenas para exibir mensagem do itens em promocao
                If (Not blnTravarPeloPrecoPromocaoCodIte) And (fCfgSis('TRAPRP') = '1') Then
                Begin
                  fltPreTabPromoc := fltPreTabPromoc + fFormataFloat((FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                  fltPreTab := fltPreTab + fFormataFloat((FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                End
                Else
                Begin
                  fltPreTabPromoc := fltPreTabPromoc + fFormataFloat((FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                  fltPreTab := fltPreTab + fFormataFloat((fltUniOriTmp * FieldByName('ITE_QTDITE').AsFloat), 2);
                End;

                fltValMinPromoc := fltValMinPromoc + fFormataFloat((fltUniTraPro * FieldByName('ITE_QTDITE').AsFloat), 2);
              End
              Else
              Begin
                fltPreTab := fltPreTab + fFormataFloat((fltUniOriTmp * FieldByName('ITE_QTDITE').AsFloat), 2);
              End;

              If Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0 Then
                fltUniTraProNv2 := FieldByName('ITE_UNIDEV').AsFloat
              Else
              Begin
                If (VS_strTRADES = '2') Or //CONFIGURADO PARA TRAVAR POR DESCONTO MAXIMO
                   (VS_strTRADES = '3') Or //CONFIGURADO PARA TRAVAR POR MARGEM MINIMA
                   (TipoOpcaoDeTrava.fOpcaoDeTravaEhPorAtividade) Then
                Begin
                  fltUniTraProNv2 := fPegaUnitarioTrava(2);//Nivel 2
                  fltUniTraProNv3 := fPegaUnitarioTrava(3);//Nivel 3
                  fltUniTraProNv4 := fPegaUnitarioTrava(4);//Nivel 4
                  fltUniTraProNv5 := fPegaUnitarioTrava(5);//Nivel 5
                  fltUniTraProNv6 := fPegaUnitarioTrava(6);//Nivel 6
                End
                Else
                Begin
                  If fUtilizaPrecoEmbalagemFechadaComoMinimo(FieldByName('ITE_IDEPRO').AsString,
                                                             FieldByName('ITE_CODITE').AsString,
                                                             FieldByName('ITE_TABPRE').AsString,
                                                             FieldByName('ITE_PROMOC').AsString,
                                                             FieldByName('ITE_QTDITE').AsFloat) Then
                  Begin
                    fltUniTraProNv2 := fGetUnitarioEmbalagemFechada(FieldByName('ITE_CODITE').AsString,
                                                                    FieldByName('ITE_TABPRE').AsString,
                                                                    FieldByName('ITE_QTDITE').AsFloat,
                                                                    FieldByName('ITE_UNIORI').AsFloat);

                    fltUniTraProNv3 := fltUniTraProNv2;
                  End
                  Else If fUtilizaPrecoTabelaTravaProdutoEmbalagem(FieldByName('ITE_IDEPRO').AsString,
                                                                   FieldByName('ITE_CODITE').AsString,
                                                                   FieldByName('ITE_BAREMB').AsString) Then
                  Begin
                    strPromocSav := Self.strPromoc;
                    Self.strPromoc := FieldByName('ITE_PROMOC').AsString;
                    fltUniTraProNv2 := fPegaPrecoVenda(cdsDados,
                                                       FieldByName('ITE_EMPITE').AsString,
                                                       FieldByName('ITE_ENTSAI').AsString,
                                                       fltMargem,
                                                       (Pos('ITEM ESPECIAL', FieldByName('ITE_DESITE').AsString) > 0),
                                                       FieldByName('ITE_IDEPRO').AsString,
                                                       FieldByName('ITE_TABPRE').AsString,
                                                       True,
                                                       FTaxJur,
                                                       FUniVis);

                    fltUniTraProNv3 := fltUniTraProNv2;
                    Self.strPromoc := strPromocSav;                                
                  End
                  Else If (Not (VS_strTRADES = '1')) Then
                  Begin
                    fltUniTraProNv2 := FieldByName('ITE_UNIORI').AsFloat;//Nivel 2
                    fltUniTraProNv3 := FieldByName('ITE_UNIORI').AsFloat;//Nivel 3
                  End;
                End;
              End;

              fltValMinNv2    := fltValMinNv2 + fFormataFloat((fltUniTraProNv2 * FieldByName('ITE_QTDITE').AsFloat), 2);

              If (TipoOpcaoDeTrava.fOpcaoDeTravaEhPorAtividade) Or
                 (VS_strTRADES = '2') Or   //CONFIGURADO PARA TRAVAR POR MARGEM MINIMA OU DESCONTO MAXIMO
                 (VS_strTRADES = '3') Then
              Begin
                fltValMinNv3  := fltValMinNv3 + fFormataFloat((fltUniTraProNv3 * FieldByName('ITE_QTDITE').AsFloat), 2);
                fltValMinNv4  := fltValMinNv4 + fFormataFloat((fltUniTraProNv4 * FieldByName('ITE_QTDITE').AsFloat), 2);
                fltValMinNv5  := fltValMinNv5 + fFormataFloat((fltUniTraProNv5 * FieldByName('ITE_QTDITE').AsFloat), 2);
                fltValMinNv6  := fltValMinNv6 + fFormataFloat((fltUniTraProNv6 * FieldByName('ITE_QTDITE').AsFloat), 2);
              End;
            End;

          {**************************************}
          {* PRODUTOS <TINTA DE MAQUINA>        *}
          {***********************************WI*}
          End
          Else
          Begin
            fltTotTin := fFormataFloat(fRetornaUniTraProTinta(FieldByName('ITE_IDEPRO').AsString,
                                                                          qryTinta,
                                                                          FieldByName('ITE_EMBALA').AsFloat,
                                                                          FieldByName('ITE_QTDITE').AsFloat,
                                                                          FieldByName('ITE_TIPPRE').AsString,
                                                                          FieldByName('ITE_ITETIN').AsString,
                                                                          FieldByName('ITE_CODITE').AsString,
                                                                          strTabPre,
                                                                          FieldByName('ITE_CATALI').AsString,
                                                                          FieldByName('ITE_PRCTIN').AsFloat,
                                                                          FieldByName('ITE_PRVTIN').AsFloat) * FieldByName('ITE_QTDITE').AsFloat,
                                                                          04);

            If FieldByName('ITE_ENTSAI').AsString = 'E' Then
              fltEntTra := fltEntTra + FieldByName('ITE_TOTITE').AsFloat
            Else
            Begin
              fltMinCus    := fltMinCus + fCustoMinimoTrava;
              fltValMin    := fltValMin + fltTotTin;
              fltValMinNv2 := fltValMinNv2 + fltTotTin;

              If fEmptyStr(FieldByName('ITE_TABPRE').AsString) Then
                strTabelaPreco := Self.strTabPre
              Else
                strTabelaPreco := FieldByName('ITE_TABPRE').AsString;

              If (FieldByName('ITE_PROMOC').AsString = 'S') Or ((FieldByName('ITE_SEQCOM').AsInteger > 0) And (FieldByName('ITE_ATIVAC').AsString <> 'S')) Then
              Begin
                //Utilizados apenas para exibir mensagem do itens em promocao
                If (Not blnTravarPeloPrecoPromocaoCodIte) And (fCfgSis('TRAPRP') = '1') Then
                Begin
                  fltPreTabPromoc := fltPreTabPromoc + fFormataFloat((FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                  fltPreTab := fltPreTab + fFormataFloat((FieldByName('ITE_PREVE' + strTabelaPreco).AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                End
                Else
                Begin
                  fltPreTabPromoc := fltPreTabPromoc + fFormataFloat((FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                  fltPreTab := fltPreTab + fFormataFloat((FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
                End;

                fltValMinPromoc := fltValMinPromoc + fltTotTin;
              End
              Else
              Begin
                fltPreTab := fltPreTab + fFormataFloat((FieldByName('ITE_UNIORI').AsFloat * FieldByName('ITE_QTDITE').AsFloat), 2);
              End;

              If (TipoOpcaoDeTrava.fOpcaoDeTravaEhPorAtividade) Or
                 (VS_strTRADES = '2') Or
                 (VS_strTRADES = '3') Then //CONFIGURADO PARA TRAVAR POR MARGEM MINIMA OU DESCONTO MAXIMO
              Begin
                fltValMinNv3 := fltValMinNv3 + fltTotTin;
                fltValMinNv4 := fltValMinNv4 + fltTotTin;
                fltValMinNv5 := fltValMinNv5 + fltTotTin;
                fltValMinNv6 := fltValMinNv6 + fltTotTin;
              End;
            End;

            fltUniTraPro    := fltTotTin / FieldByName('ITE_QTDITE').AsFloat;
            fltUniTraProNv2 := fltTotTin / FieldByName('ITE_QTDITE').AsFloat;
            fltUniTraProNv3 := fltTotTin / FieldByName('ITE_QTDITE').AsFloat;
            fltUniTraProNv4 := fltTotTin / FieldByName('ITE_QTDITE').AsFloat;
            fltUniTraProNv5 := fltTotTin / FieldByName('ITE_QTDITE').AsFloat;
            fltUniTraProNv6 := fltTotTin / FieldByName('ITE_QTDITE').AsFloat;
          End;

          If TMostraTravaMinimaHelper.fExibeTravaMinima Then
            TMostraTravaMinimaHelper.pAddItemTravaMinima(cdsTravaMinima,
                                                         cdsDados,
                                                         fltUniTraPro,
                                                         fltUniTraProNv2,
                                                         fltUniTraProNv3,
                                                         fltUniTraProNv4,
                                                         fltUniTraProNv5,
                                                         fltUniTraProNv6,
                                                         Self.strOpcDoc,
                                                         Nil,
                                                         Self);
        End;

        Next;
      End;

    End;

    FreeAndNil(qryTinta);
  end;

  function fAbortarValidacaoDeVlrMinimo : Boolean;
    var
      blnCFGSLigadas,
      blnValidaNoFinal : Boolean;
  begin

    blnCFGSLigadas := fConsiderarComissaoDoProfissionalNaTravaDePreco(Self.strOpcDoc) Or
                      fConsiderarFreteNaTravaDePreco(Self.strOpcDoc);

    blnValidaNoFinal := blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
                        blnConsiderarValorDoFreteNaTravaDePreco;

    Result := (blnCFGSLigadas) And (Not blnValidaNoFinal) And (Not blnEhPedidoItemCortado);

  end;

begin

  Result := True;
  blnValidarCustoJuntoComMargemMinima := False;

  pRemoverTravaLogAvi('VEMIN', strNTrava);

  If fAbortarValidacaoDeVlrMinimo Then
    Exit(True);

  blnEmCamp := False;

  pInformacao('Calculando trava de preço dos produtos, Aguarde...', pgbStatus);

  If Assigned(pNotificarProgresso) Then
    pNotificarProgresso;

  Try
    If (blnCliFil) Or (Pos(strOpcDoc, 'OU_OV_NC_BR_TE_OE_EF_OF_CI_UC_PI_') > 0) Then
      Exit(True);

    if not blnAvisaTravaAtualizaPreco then
    begin
      If (fCfgSis('MINCUS') <> 'N') Then
      Begin
        If (VS_strTRVEPR = '2') Or (fltDesEsp > 0) Or (fltPorDes > 0) Then
        Begin
          If (VS_strTRADES = '4') And (fCfgSis('TMMITE', VarBoolean)) Then
            blnValidarCustoJuntoComMargemMinima := True
          Else If Not fValidarCustoMinimoPorProduto(blnPedeSenha) Then
            Exit(False);
        End;
      End;
    end;

    cdsDados := TUniClientDataSet.Create(Self);
    Try
      pCloneDataSet(cdsDados, cdsVenda);

      pProcessaTotaisParaTrava; //CARREGA A VARIÁVEL recTotTrv e cdsDados

      Self.fltTotMinSPro := 0.00;
      Self.fltTotMinCPro := 0.00;
      Self.fltTotMinProd := 0.00;

      If (VS_strTRADES = '4') Then
      Begin
        Result := fVerificaVrMinimoMargemDocumento(blnPedeSenha, blnMsgLib, pgbStatus, pNotificarProgresso);
        If Result And fCfgSis('TMMITE', VarBoolean) Then
          Result := fValidarMargemMinimaPorProduto(blnPedeSenha, blnValidarCustoJuntoComMargemMinima);
      End
      Else
        Result := fVerificaVrMinimoInterna(cdsDados, recTotTrv, fltTotAnt, fltTotger,
          intPraMed, strEspVer, blnPedeSenha, blnMsgLib, pgbStatus, pNotificarProgresso);
    Finally
      FreeAndNil(cdsDados);
    End;
  Finally
    If Not Result Then
      blnVlrMin := False;
  End;
end;

function TFatVenda.fVerificaVrMinimoMargemDocumento(blnPedeSenha: Boolean = True;
        blnMsgLib: Boolean = True; pgbStatus: TcxProgressBar = Nil;
        pNotificarProgresso: TGenericProcedure = nil): Boolean;
  Var
    objLiberacao : TLiberacao;
    blnNivel2: Boolean;
    strOpcTravaVMin, strEspTmp: string;
    cdsData: OleVariant;
    recTotMarLuc : TRecTotaisMargemLucro;
    fltMargemParaTrava : Double;
    blnMarcar : Boolean;
    blnRestringirElementosMargemOriginal : Boolean;

    procedure pMensagem(strNivel: String);
    begin
      objLiberacao.objMsgLibera.pAddTexto('Margem do documento menor que o permitido - Nível ' + strNivel);

      blnMarcar := (fCfgSis('INTRMN', varInteger) = 2);

      objLiberacao.objMsgLibera.pAddTextoCaption('Margem do documento      ', fMsgLiberaToMsgOculta(FloatToStrF(fltMargemParaTrava, ffNumber, 12, 2), blnMarcar));
      objLiberacao.objMsgLibera.pAddTextoCaption('Margem inferior permitida', fMsgLiberaToMsgOculta(FloatToStrF(fCfgSis('MMDNV' + strNivel      , varDouble), ffNumber, 12, 2), blnMarcar));
      objLiberacao.objMsgLibera.pAddTextoCaption('Margem superior permitida', fMsgLiberaToMsgOculta(FloatToStrF(fCfgSis('MMDN'  + strNivel + 'S', varDouble), ffNumber, 12, 2), blnMarcar));

      If (Not fEmptyStr(strCodVen)) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor', strCodVen + '-' + fRetNomVendRep(strCodVen));
    end;
begin
  Result    := True;
  objLiberacao := TLiberacao.Create;
  blnNivel2 := False;

  try
    strEspTmp := strEspDoc;

    if (fEmptyStr(strEspTmp)) Then
      strEspTmp := strOpcDoc;

    if strOriF11 = 'S' then
      strOpcTravaVMin := fCfgSis('TRMNRC')
    else if strEspTmp = 'OR' then
      strOpcTravaVMin := fCfgSis('TRVMIN')
    else if strEspTmp = 'PD' then
      strOpcTravaVMin := fCfgSis('TRMNPD')
    Else If (strEspTmp = 'VN') Or ((strOpcDoc = 'VN') And (Pos(strEspTmp, 'FF_IF_NF_') > 0)) Then
      strOpcTravaVMin := fCfgSis('TRMNVN')
    else if strEspTmp = 'CP' then
      strOpcTravaVMin := fCfgSis('TRMNCP')
    else
      strOpcTravaVMin := fCfgSis('TRVMIN');

    If (Pos(strOpcTravaVMin, 'T_A_') <= 0) Then
      Exit;

    If fSomenteItensEmPromocaoNaVenda And ((VS_strTRADES = '4') And (Not fConsiderarItemPromocionalMargemMinimaDocumento)) Then
      Exit;

    If (VS_strTRADES = '4') And (fCfgSis('MMCBRI', varString) = 'N') And (Not fTemItemPraValidarMargemMinimaPorDocumento(fConsiderarItemPromocionalMargemMinimaDocumento, fCfgSis('MMCBRI', varString) = 'S')) Then
      Exit;

    blnRestringirElementosMargemOriginal := Self.blnRestringirElementosMargem;
    Try
      Self.blnRestringirElementosMargem := True;
      cdsData := Self.fCalculaMargemLucro(True);

      Self.pCalculaTotaisMargemLucro(cdsData,
                                     recTotMarLuc);
    Finally
      Self.blnRestringirElementosMargem := blnRestringirElementosMargemOriginal;
    End;

    fltMargemParaTrava := TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True);

    If fltMargemParaTrava < fCfgSis('MMDNV2', varDouble) And (Not recTotMarLuc.blnSomenteItemEntrada) Then
    Begin

      If Not blnPedeSenha Then
        pRegistraUltimoBloqueio('A margem do documento está menor que o mínimo permitido.');

      If blnPedeSenha Then
        fMensagem('ATENÇÃO!', 'A margem do documento está menor que o mínimo permitido.', ['&Ok']);

      Result := False;

    End
    Else
    Begin
      If (fltMargemParaTrava >= fCfgSis('MMDNV2', varDouble)) And (fltMargemParaTrava < fCfgSis('MMDN2S', varDouble)) And (Not recTotMarLuc.blnSomenteItemEntrada) Then
      Begin
        pMensagem('2');
        blnNivel2 := True;
        Result := False;
      End
      Else If (fltMargemParaTrava >= fCfgSis('MMDNV1', varDouble)) And (fltMargemParaTrava < fCfgSis('MMDN1S', varDouble)) And (Not recTotMarLuc.blnSomenteItemEntrada) Then
      Begin
        pMensagem('1');
        blnNivel2 := False;
        Result := False;
      End;

      If (Not Result) And (blnMsgLib) Then
        pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, nil, False, True, pgbStatus, pNotificarProgresso);

      If (Not Result) And (Not blnPedeSenha) Then
        pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem,
                                objLiberacao.objMsgRemota.fGetMensagem, blnNivel2, false);

      If (Not Result) And blnPedeSenha Then
      Begin
        objLiberacao.strDirAce := 'VEMIN';
        objLiberacao.blnTraTel := (strOpcTravaVMin = 'T');
        objLiberacao.strSenLib := fCfgSis('SENLBD');
        objLiberacao.strMsgSen := 'Liberação de Venda';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strDirAceNv2 := 'VEMIN2';
        objLiberacao.strSenLibNv2 := fCfgSis('SENLN2');
        objLiberacao.blnNivel2 := blnNivel2;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom + IIF(strCliOrg = 'S', ' ( *** ÓRGÃO PÚBLICO *** )', '');
        objLiberacao.strCpfCnpj := strCliCgc;
        objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

        Result := fFatMensagemLiberacao(objLiberacao);

        blnVlrMin := Result;
      End;
    End;
  finally
    FreeAndNil(objLiberacao);
  end;
end;

function TFatVenda.fVerificaIntervaloMargemDocumento(fltMarMin, fltMarMax: Double; strTraSen, strCodCnd: String): Boolean;
  Var
    fltMarDoc     : Double;
    objLiberacao  : TLiberacao;
    cdsData       : OleVariant;
    recTotMarLuc  : TRecTotaisMargemLucro;
    blnIgnoraTravaPeloF11: Boolean;
    blnRestringirElementosMargemOriginal: Boolean;
    blnMarcar     : Boolean;
begin
  Result := True;

  If Not fPermiteValidarMargemAndValorCodCnd Then
    Exit;

  If Not fExecutarValidacaoMargemCondPagto_Documento Then
    Exit;

  If fPermitirIgnorarTravaMargemDoCliente(Self.strCodCli) Then
    Exit;

  blnRestringirElementosMargemOriginal := Self.blnRestringirElementosMargem;
  Try
    Self.blnRestringirElementosMargem := True;
    cdsData := Self.fCalculaMargemLucro(True);

    Self.pCalculaTotaisMargemLucro(cdsData, recTotMarLuc, 0, True);

    fltMarDoc := TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True);

    If (recTotMarLuc.strTemItensVenda = 'S') And ((fltMarDoc < fltMarMin) Or (fltMardoc > fltMarMax)) Then
    Begin
      Result := False;
    End;

    If fJaFoiLiberadoAvisado('INTMAR', 'INTMAR'+strCodCnd+fltMarDoc.ToString) Then
      Result := True;

    If (Not Result) Then
    Begin
      blnIgnoraTravaPeloF11 := (Self.strOriF11 = 'S') and (not fCfgSis('TRAF11', varBoolean)) and (Pos(Self.strOpcDOc, 'VN_PD_OR_') > 0);

      if blnIgnoraTravaPeloF11 then
      begin
        Result := True;
      end
      else
      begin
        objLiberacao := TLiberacao.Create;
        Try
          pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, Nil, False, False);
          objLiberacao.objMsgLibera.pAddTexto('Margem do documento Fora do Intervalo Permitido');

          blnMarcar := (fCfgSis('PFTRMN', varInteger) = 2);

          objLiberacao.objMsgLibera.pAddTextoCaption('Margem mínima permitida', fMsgLiberaToMsgOculta(FloatToStrF(fltMarMin, ffNumber, 12, 2), blnMarcar), 24);
          objLiberacao.objMsgLibera.pAddTextoCaption('Margem máxima permitida', fMsgLiberaToMsgOculta(FloatToStrF(fltMarMax, ffNumber, 12, 2), blnMarcar), 24);
          objLiberacao.objMsgLibera.pAddTextoCaption('Margem praticada       ', fMsgLiberaToMsgOculta(FloatToStrF(fltMarDoc, ffNumber, 12, 2), blnMarcar), 24);

          If fCfgSis('USACND', varBoolean) then
          Begin
            objLiberacao.objMsgLibera.pAddTextoCaption('Condição de Pagamento', strCodCnd + '-' + fRetDesConPag(strCodCnd), 24);
            objLiberacao.objMsgLibera.pAddTextoCaption(''                     , fFormataCondPag(strConPag), 24);
          End
          Else
            objLiberacao.objMsgLibera.pAddTextoCaption('Condição de Pagamento', fFormataCondPag(strConPag), 24);

          If fCfgSis('USAFPG', varBoolean) Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagamento', (strCodFpg + '-' + fRetDescFpg(strCodFpg)), 24);

          If ((Pos(strOpcDoc, 'PD_OR_VN_') > 0) And
             (blnLiberacaoRemotaNoFinalVenda)) And
             (((((Pos(strOpcDoc, 'PD_OR_') > 0) And
             fCfgSis('TFPF11', varBoolean)) Or
             fCfgSis('SFPGPD', varBoolean)) And (strCodFpg = '009')) Or
            ((fCfgSis('SOLCAR', varBoolean)) And
            (strCodFpg = '007'))) Then
          Begin
            If fCfgSis('USAFPG', varBoolean) Then
              objLiberacao.objMsgLibera.pAddTextoCaption('                    ', STRING_FORMAS_PAGTO_NEGOCIADAS, 0)
            Else
              objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagamento', STRING_FORMAS_PAGTO_NEGOCIADAS, 0);
          End;

          If strTraSen = 'S' Then
          Begin
            objLiberacao.strDirAce := 'INTMAR';
            objLiberacao.strDirAceAuxiliar := 'INTMAR'+strCodCnd+fltMarDoc.ToString;
            objLiberacao.strSenLib := fCfgSis('SENLBD');
            objLiberacao.strMsgSen := 'Liberação de Venda';
            objLiberacao.blnMosMen := True;
            objLiberacao.strCodOpe := strCodVen;
            objLiberacao.strCodDig := strCodDig;
            objLiberacao.strCliente := strCodCli + '-' + strCliNom;
            objLiberacao.strCpfCnpj := strCliCgc;

            Result := fFatMensagemLiberacao(objLiberacao);
          End
          Else
          Begin
            objLiberacao.strDirAce := 'NENHUM';
            objLiberacao.blnTraTel := False;
            fFatMensagemLiberacao(objLiberacao);
          End;
        Finally
          FreeAndNil(objLiberacao);
        End;
      end;

    End;
  Finally
    Self.blnRestringirElementosMargem := blnRestringirElementosMargemOriginal;
  End;
end;

function TFatVenda.fVerificaIntervaloValorDocumento(fltFatMin, fltFatMax: Double; strTraSen, strCodCnd: String): Boolean;
  Var
    cdsDados     : TUniClientDataSet;
    objLiberacao : TLiberacao;
    blnIgnoraTravaPeloF11: Boolean;
    strTpTrava: String;
    strDesCndAux : String;
    strPflCndAux : String;
    fltTotGerLocal: Double;
begin
  Result := True;

  fltTotGerLocal := IIF(fltTotGerPDCortado > 0, fltTotGerPDCortado, fltTotGer);

  if ((Self.blnOriF3) Or (Self.strOriF11 = 'S')) And fCfgSis('TRAF11', varBoolean) And fJaTravouNoPedido(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri, 'INTFAT') then
    Exit;

  If Not fPermiteValidarMargemAndValorCodCnd Then
    Exit;

  strTpTrava := fRetornaTipoTravaSeOrcamentoComPerfilCondicao('CND_TRORFI');

  objLiberacao := TLiberacao.Create;
  cdsDados := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  If ((fltTotGerLocal < fltFatMin) Or (fltTotGerLocal > fltFatMax)) Then
  Begin
    Result := False;
  End;

  If fJaFoiLiberadoAvisado('INTFAT', 'INTFAT'+strCodCnd+fltTotGerLocal.ToString) Then
    Result := True;

  If (Self.blnDesmembrarOrPd) And (Self.fEfetivarValidacaoDoPerfilDaCondicaoNosDocumentosDesmembrados) Then
    Result := True;

  pRemoverTravaLogAvi('NENHUM', strTpTrava);

  If (Not Result) Then
  Begin
    blnIgnoraTravaPeloF11 := (Self.strOriF11 = 'S') and (not fCfgSis('TRAF11', varBoolean)) and (Pos(Self.strOpcDoc, 'VN_PD_OR_') > 0);

    If ((blnIgnoraTravaPeloF11) or (strTpTrava = 'N')) Then
    Begin
      Result := True;
    End
    Else
    Begin
      objLiberacao.objMsgLibera.pAddTexto('Valor do documento Fora do Intervalo Permitido');
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor mínimo permitido' , FloatToStrF(fltFatMin, ffNumber, 12, 2), 22);
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor máximo permitido' , FloatToStrF(fltFatMax, ffNumber, 12, 2), 22);
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor praticado'        , FloatToStrF(fltTotGerLocal, ffNumber, 12, 2), 22);

      If (Not fEmptyStr(strCodCnd)) Then
      Begin
        strDesCndAux := fRetDesConPag(strCodCnd);
        If (Not fEmptyStr(strDesCndAux)) Then
          objLiberacao.objMsgLibera.pAddTextoCaption('Descrição da Condição', strDesCndAux, 22);

        strPflCndAux := fRetPflConPag(strCodCnd);
        If (Not fEmptyStr(strPflCndAux)) Then
          objLiberacao.objMsgLibera.pAddTextoCaption('Perfil da Condição', strPflCndAux, 22);
      End;

      If strTraSen = 'S' Then
      Begin
        objLiberacao.strDirAce := 'INTFAT';
        objLiberacao.strDirAceAuxiliar := 'INTFAT'+strCodCnd+fltTotGerLocal.ToString;
        objLiberacao.strSenLib := fCfgSis('SENLBD');
        objLiberacao.strMsgSen := 'Liberação de Venda';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom;
        objLiberacao.strCpfCnpj := strCliCgc;

        objLiberacao.blnTraTel := (strTpTrava = 'T');

        Result := fFatMensagemLiberacao(objLiberacao);
      End
      Else
      Begin
        objLiberacao.strDirAce := 'NENHUM';
        objLiberacao.blnTraTel := False;
        fFatMensagemLiberacao(objLiberacao);
      End;
    end;
  End;

  FreeAndNil(cdsDados);
  FreeAndNil(objLiberacao);
end;

function TFatVenda.fRetornaMargemDocumento: Double;
  Var
    cdsDados  : TUniClientDataSet;
    fltTotCus : Double;
begin
  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    fltTotCus := 0;

    While (Not cdsDados.Eof) Do
    Begin
      fltTotCus := fltTotCus + cdsDados.FieldByName('ITE_TOTCUS').AsFloat;
      cdsDados.Next;
    End;

    Result := fCalculaPrecoVenda(2, fltTotCus, fltTotGer, 0, 0, 0, 0, 0, fMarMpkParaVenda, '', -1, 0, False, 0, 0, 0, fRestringirElementosMargem);
  Finally
    FreeAndNil(cdsDados);
  End;
end;

function TFatVenda.fRetornaMargemPraticadaDocumento(out blnIgnMar: Boolean): Double;
  Var
    cdsData       : OleVariant;
    recTotMarLuc  : TRecTotaisMargemLucro;
    blnRestringirElementosMargemOriginal: Boolean;
begin
  blnRestringirElementosMargemOriginal := Self.blnRestringirElementosMargem;
  Try
    Self.blnRestringirElementosMargem := True;
    cdsData := Self.fCalculaMargemLucro(True);

    Self.pCalculaTotaisMargemLucro(cdsData, recTotMarLuc);

    Result := TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True);

    blnIgnMar := recTotMarLuc.strTemItensVenda = '';
  Finally
    Self.blnRestringirElementosMargem := blnRestringirElementosMargemOriginal;
  End;
end;

function TFatVenda.fRetornaMatrizFormulacaoTintasAcumulada(blnPorEmpPrd: Boolean=False): TClassMatrizSaldosColorantes;
var
  strEmpPrdAux,
  strAutInc: String;
  intCount : Integer;
  intFormul: Integer;
  matrizSaldosAux,
  matrizSaldosColorantes: TClassMatrizSaldosColorantes;
  objRetorno: TObject;
begin
  matrizSaldosColorantes := TClassMatrizSaldosColorantes.Create();

  For intFormul := 0 To dicFormulas.Chaves.Count -1 Do
  Begin
    strAutInc := dicFormulas.Chaves[intFormul];
    objRetorno := dicFormulas.RetornaObjeto(strAutInc);

    if Assigned(objRetorno) and (objRetorno.ClassName = TClassMatrizSaldosColorantes.ClassName) then
    Begin
      matrizSaldosAux  := TClassMatrizSaldosColorantes(objRetorno);

      if Assigned(matrizSaldosAux) then
      begin
        strEmpPrdAux := '';
        If blnPorEmpPrd Then
          strEmpPrdAux := matrizSaldosAux.strCodEmp;

        For intCount := 0 To matrizSaldosAux.Count - 1 Do
          matrizSaldosColorantes.fAdicionar(matrizSaldosAux[intCount], strEmpPrdAux);
      end;
    End;
  End;

  Result := matrizSaldosColorantes;
end;

function TFatVenda.fRetornaMatrizFormulacaoTintasAcumuladaParaSolicitarTE(): TClassMatrizSaldosColorantes;
var
  strAutInc: String;
  intCount : Integer;
  intFormul: Integer;
  matrizSaldosAux: TClassMatrizSaldosColorantes;
  objRetorno: TObject;

  function fItemProduzidoNaEmpresa: Boolean;
    Var
      item: TDadosFechamento;
  begin
    Result := False;
    For item In Self.ArrMatItens Do
      If item.intAutInc = strAutInc.ToInteger Then
        If item.strEmpPrd = VS_strCodEmp Then
          Result := True;
  end;

  function fIgnorarItemEntregaFutura: Boolean;
    Var
      item: TDadosFechamento;
  begin
    Result := False;
    For item In Self.ArrMatItens Do
      If item.intAutInc = strAutInc.ToInteger Then
        If item.strEntFut = 'S' Then
          If fTravaSaldoEntFut(strOpcDoc, Item.strMotFut) <> 'T' Then
            Result := True;
  end;

  function fJaSolicitouEmpresa(): Boolean;
    Var
      item: TDadosFechamento;
  begin
    Result := False;
    For item In Self.ArrMatItens Do
      If item.intAutInc = strAutInc.ToInteger Then
        If Not fEmptyStr(item.strEmpSol) Then
          Result := True;
  end;

begin
  Result := TClassMatrizSaldosColorantes.Create();
  For intFormul := 0 To dicFormulas.Chaves.Count -1 Do
  Begin
    strAutInc := dicFormulas.Chaves[intFormul];
    objRetorno := dicFormulas.RetornaObjeto(strAutInc);

    If Not Assigned(objRetorno) Then
      Continue;

    If (objRetorno.ClassName <> TClassMatrizSaldosColorantes.ClassName) Then
      Continue;

    If Not fItemProduzidoNaEmpresa Then
      Continue;

    If fIgnorarItemEntregaFutura Then
      Continue;

    If fJaSolicitouEmpresa Then
      Continue;

    matrizSaldosAux := TClassMatrizSaldosColorantes(objRetorno);

    For intCount := 0 To matrizSaldosAux.Count - 1 Do
      Result.fAdicionar(strAutInc.ToInteger, matrizSaldosAux[intCount]);
  End;
end;

function TFatVenda.fVerificaVrMinimoInterna(cdsDados: TUniClientDataSet;
                                            recTotTrv: TrecTotaisTravaMinima;
                                            fltTotAnt: Double;
                                            fltTotGer: Double;
                                            intPraMed: Integer;
                                            strEspVer: String = '';
                                            blnPedeSenha: Boolean = True;
                                            blnMsgLib: Boolean = True;
                                            pgbStatus: TcxProgressBar = Nil;
                                            pNotificarProgresso: TGenericProcedure = nil): Boolean;

  function fTotalGeralLiquido(blnIncluiFrete: Boolean = True): Double;
  begin
    Result := (fltTotGer - recTotTrv.fltTinMaq - (fltTotProBri - fltTotIpiProBri - fltTotRetProBri - fltTotRefProBri) + recTotTrv.fltEntTra);

    If Not blnIncluiFrete Then
      Result := Result - fltValFre;
  end;

  function fTotalEmbalagemLiquido(strPromocao:String = ''): Double;
  var
    intRecNo: Integer;
    fltValor: Double;
  begin
    fltValor := 0;

    intRecNo := cdsDados.RecNo;
    cdsDados.DisableControls;

    Try
      cdsDados.First;
      While (Not cdsDados.Eof) Do
      Begin
        If cdsDados.FieldByName('ITE_EHEMBA').AsBoolean Then
        Begin
          If (strPromocao = cdsDados.FieldByName('ITE_PROMOC').AsString) Or (strPromocao = '') Then
            fltValor := fltValor + cdsDados.FieldByName('ITE_VLBEMB').AsFloat;
        End;

        cdsDados.Next;
      End;
    Finally
      cdsDados.RecNo := intRecNo;
      cdsDados.EnableControls;
    End;


    Result := (fltValor - recTotTrv.fltTinMaq - (fltTotProBri - fltTotIpiProBri - fltTotRetProBri - fltTotRefProBri) + recTotTrv.fltEntTra);
  end;

  function fRetCidadeCliente(strCodCli : String) : String;
  var
    strCodCid : String;
  begin
    strCodCid := fRetCidCliente(strCodCli);
    If Not fEmptyStr(strCodCid) Then
      Result := fRetNomCidade(strCodCid) + '-' + fRetNomCidade(strCodCid, 1)
    Else
      Result := '';
  end;

  Const
    TAMANHO_CAPTION = 40;

  Var
    fltDesConcedido: Double;
    fltPerDesConced: Double;
    fltDesMaximoPer: Double;
    objLiberacao   : TLiberacao;
    blnNivel2      : Boolean;
    blnNivel3      : Boolean;
    blnNivel4      : Boolean;
    blnNivel5      : Boolean;
    blnNivel6      : Boolean;
    strOpcTravaVMin: String;
    blnValorMenorQueMinimo: Boolean;
    blnOcultarMsgParaQuemEnvia: Boolean;

    //Utilizados apenas para exibir mensagem dos itens em promocao
    fltValMinNaoPromoc: Double;
    fltPreTabNaoPromoc: Double;
    fltTotGerNaoPromoc: Double;
    strEspTmp      : String;
    fltSaldoFlex   : Double;
    fltPercUltr    : Double;
    fltDifFle      : Double;
    blnIgnMar      : Boolean;

    fltDesMax_Geral,
    fltValMin_Geral,
    fltDesCon_Geral,
    fltDesPer_Geral : Double;
    objCdsXmlF4: TUniClientDataSet;

    blnRestringirElementosMargemOriginal: Boolean;
    fltTotalGeralLiquido : Double;
    fltDescoConcedidoTot : Double;
    fltDescoConcedidoEmb : Double;
    fltPerDesConcedidoEmb: Double;
    fltValorEmbalagem: Double;

    function fRetVlrComDig : Double;
    begin
      Result := IIF(fltVlrComDig > 0, fltVlrComDig, 0);
    end;

    function fValidaSeDesconsideraFreteEmTotGer(const fltVlrTotGer : Double) : Double;
      var
        blnDesconsiderarFrete : Boolean;
    begin
      blnDesconsiderarFrete := (blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
                                blnConsiderarValorDoFreteNaTravaDePreco) And (fltValFre > 0);
      Result := IIF(blnDesconsiderarFrete, (fltVlrTotGer - fltValFre), fltVlrTotGer);
    end;

    function fRetTituloVlrMinimoPermitido : String;
      const
        VLR_MIN_PERMITIDO         = 'Valor mínimo permitido';
        VLR_MIN_PERMITIDO_PRODUTO = 'Valor mínimo permitido no produto';
    begin
      Result := IIF(blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
                    blnConsiderarValorDoFreteNaTravaDePreco, VLR_MIN_PERMITIDO_PRODUTO, VLR_MIN_PERMITIDO);
    end;

    function fRetTituloTotalDosProdutos(blnTotalProduto: Boolean = True) : String;
      const
        TOTAL = 'Total dos produtos';
        FRETE = 'Frete à cobrar';
    begin
      Result := IIF(blnTotalProduto, TOTAL, FRETE);
    end;

    function fRetVlrTotalDosProdutos(blnTotalProduto: Boolean = True) : Double;
    begin
      Result := IIF(blnTotalProduto, (fltPreTabNaoPromoc-fltDesConcedido), fltValFre);
    end;

    function fTravaFinalOuItemAItemConsiderandoComissaoEOuFrete : Boolean;
      var
        blnConsideraComissaoEOuFrete : Boolean;
    begin

      Result := True;

      blnConsideraComissaoEOuFrete := blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
                                      blnConsiderarValorDoFreteNaTravaDePreco;

      If (VS_strTRVEPR = '1') And (blnConsideraComissaoEOuFrete) Then
        Exit;

      If (VS_strTRVEPR = '2') Then
        Exit;

      Result := False;

    end;

Begin

  Result := True;

  If (strOpcDoc = 'NE') And (fDocumentoParaFornecedor) Then
    Exit;

  If fPermitirIgnorarTravaMargemDoCliente(Self.strCodCli) Then
    Exit;

  fltDesMax_Geral := 0;
  fltValMin_Geral := 0;
  fltDesCon_Geral := 0;
  blnOcultarMsgParaQuemEnvia := (fCfgSis('TRMPES') = '2');

  If Not fTravaValorMinimo(strEspVer) Then
    Exit;

  objCdsXmlF4 := TUniClientDataSet.Create(nil);
  objLiberacao := TLiberacao.Create;
  objLiberacao.blnSuprimirNivel := blnOcultarMsgParaQuemEnvia;

  objLiberacao.blnConsiderarAComissaoDoProfissionalEOValorDoFreteNaTravaDePreco := blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
                                                                                   blnConsiderarValorDoFreteNaTravaDePreco;

  blnRestringirElementosMargemOriginal := Self.blnRestringirElementosMargem;
  try
    Self.blnRestringirElementosMargem := True;

    blnNivel3 := False;
    blnNivel4 := False;
    blnNivel5 := False;
    blnNivel6 := False;

    With recTotTrv Do
    Begin

      If (fCfgSis('PERDES', varDouble) > 0) And (Not blnMeiaNota) Then
      Begin
        //Utilizado apenas para exibir mensagem do itens em promocao
        If fltValMin <> 0.00 Then
          fltValMinPromoc := fltValMinPromoc * (1 - fCfgSis('PERDES', varDouble) / fltValMin);

        fltValMin := fltValMin - fCfgSis('PERDES', varDouble);
      End;

      If fFormataFloat(fTotalGeralLiquido, VS_intDecUni) < 0.0 Then
      Begin
        If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Self.fltDesEsp > 0) Then
          fMensagem('Atenção!', 'O valor do Desconto Especial: '+FormatFloat('#,##0.00', fFormataFloat(Self.fltDesEsp,2))+', supera o valor da venda!'+#10#13+
                                'Utilize o "[Ctrl + F10] Fechamento com Desconto" ajustar o desconto!', ['&O k']);

        Result := False;
        Exit;
      End;

      fltTotalGeralLiquido := fTotalGeralLiquido;

      If (blnConsiderarAComissaoDoProfissionalNaTravaDePreco) Then
        fltTotalGeralLiquido := (fltTotalGeralLiquido - fRetVlrComDig);

      If (blnConsiderarValorDoFreteNaTravaDePreco) Then
        fltTotalGeralLiquido := (fltTotalGeralLiquido - fltFreCot);

      blnValorMenorQueMinimo := (fFormataFloat(fltTotalGeralLiquido, 2) < fFormataFloat(fltValMin, 2));

      strEspTmp := strEspDoc;

      if (fEmptyStr(strEspTmp)) Then
        strEspTmp := strOpcDoc;

      if strOriF11 = 'S' then
        strOpcTravaVMin := fCfgSis('TRMNRC')
      else if strEspTmp = 'OR' then
        strOpcTravaVMin := fCfgSis('TRVMIN')
      else if strEspTmp = 'PD' then
        strOpcTravaVMin := fCfgSis('TRMNPD')
      Else If (strEspTmp = 'VN') Or ((strOpcDoc = 'VN') And (Pos(strEspTmp, 'FF_IF_NF_') > 0)) Then
        strOpcTravaVMin := fCfgSis('TRMNVN')
      else if strEspTmp = 'CP' then
        strOpcTravaVMin := fCfgSis('TRMNCP')
      else
        strOpcTravaVMin := fCfgSis('TRVMIN');

      fltSaldoFlex := TMovFlex.fSaldoFlexDisponivelVendedor(strCodVen,
        IIF(Not fEmptyStr(strNumOrc), strNumOrc, ''),
        IIF(Not fEmptyStr(strNumOrc), VS_strCodEmp, ''));

      If (Pos(strOpcTravaVMin, 'T_A_') > 0) And (blnValorMenorQueMinimo) And
         (fEmptyStr(strNumLib)) And
         (Not fPermiteDescontoMaximoFlex(fFormataFloat(fTotalGeralLiquido, 2),
                                         fFormataFloat(fltValMin, 2),
                                         fltSaldoFlex,
                                         fltPercUltr,
                                         fltDifFle)) Then
      Begin
        If blnMsgLib Then
          pMontaMensagem(cdsDados, objLiberacao.objMsgRemota, Nil, True, True, pgbStatus, pNotificarProgresso, True, Nil, True, '', True);

        {**************************************}
        {* CALCULA VALORES PARA TRAVA         *}
        {***********************************WI*}
        If (Not blnHerancaOrcamentoPedido) Then
          fltPorDesTmp := fltPorDes;

        blnNivel2 := fFormataFloat(fTotalGeralLiquido, 2) < fFormataFloat(fltValMinNv2, 2);

        If (TipoOpcaoDeTrava.fOpcaoDeTravaEhPorAtividade) Or (VS_strTRADES = '2') Or  (VS_strTRADES = '3') Then //CONFIGURADO PARA TRAVAR POR MARGEM MINIMA / DESCONTO MAXIMO
        Begin
          blnNivel3 := fFormataFloat(fTotalGeralLiquido, 2) < fFormataFloat(fltValMinNv3, 2);
          blnNivel4 := fFormataFloat(fTotalGeralLiquido, 2) < fFormataFloat(fltValMinNv4, 2);
          blnNivel5 := fFormataFloat(fTotalGeralLiquido, 2) < fFormataFloat(fltValMinNv5, 2);
          blnNivel6 := fFormataFloat(fTotalGeralLiquido, 2) < fFormataFloat(fltValMinNv6, 2);
        End;

        {**************************************}
        {* TRATAMENTO DE SENHA FIXA, VARIAVEL *}
        {* OU USUARIO                         *}
        {***********************************WI*}

        If (fltPreTabPromoc > 0) And ((Self.fltTotCPro + Self.fltTotSPro) <> 0.00) Then
          If (fRateiaDesEspPromocao) Then
            fltTotGerPromoc := fltTotGer * (Self.fltTotCPro / (Self.fltTotCPro + Self.fltTotSPro))
          Else
            fltTotGerPromoc := Self.fltTotCPro;

        fltValMinNaoPromoc := fltValMin - fltValMinPromoc;
        fltPreTabNaoPromoc := fltPreTab - fltPreTabPromoc;
        fltTotGerNaoPromoc := fltTotGer - fltTotGerPromoc;

        objLiberacao.objMsgLibera.pAddTexto('Valor da Venda Menor que o Valor Mínimo' + IIF(fltPreTabPromoc > 0,
                                                                                            ' - (ESTE DOCUMENTO POSSUI ITENS EM PROMOÇÃO)', '.'));
        If fAtualizaCdsVerficacaoVlrMin Then
        begin
          objCdsXmlF4.Data := Self.fCalculaMargemLucro(False, -1, Nil, True);
          TfrmFatMostraMargemNovo.pCalcularTotaisPublico(objCdsXmlF4, Self, Self.fltDesEsp);
        end
        else
        begin
          objCdsXmlF4.Data := cdsDados.Data;
        end;

        objLiberacao.cdsXmlF4 := objCdsXmlF4;

        If (VS_strTRVEPR = '2') Then
        Begin
          strEspTmp := strEspDoc;

          If (fEmptyStr(strEspTmp)) Then
            strEspTmp := strOpcDoc;

          If (Pos(strEspTmp, 'PD_OR_') > 0) Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Tipo de Documento a ser liberado', IfThen(strEspTmp = 'OR', 'Orçamento', 'Pedido'));
        End;

        objLiberacao.objMsgLibera.pAddSeparador(95);

        Self.fltTotMinSPro := fltValMin - fltValMinPromoc;
        Self.fltTotMinCPro := fltValMinPromoc;
        Self.fltTotMinProd := fltValMin;

        {Sem Promoção}
        If fltPreTabNaoPromoc > 0 Then
        Begin
          fltDesConcedido := fltPreTabNaoPromoc - (fValidaSeDesconsideraFreteEmTotGer(fltTotGerNaoPromoc) - fltTinMaq - fltTotProBri + fltEntTra);

          fltPerDesConced := (fltDesConcedido / fltPreTabNaoPromoc) * 100;
          fltDesMaximoPer := (fltPreTabNaoPromoc - fltValMinNaoPromoc);
          Self.fltTotMinSPro := (fltPreTabNaoPromoc - fltDesMaximoPer);

          if (VS_strTRADES = '2') And (fCfgSis('TPDMAX') = '2') And (fCfgSis('TVMPDD', varBoolean)) then
          Begin
            fltDesConcedido := fRetornaDescontoConcedido(fltPreTabNaoPromoc, fltTotalGeralLiquido, fltPerDesConced);
            fltPreTabNaoPromoc := fltPreTabNaoPromoc - ((fltPreTabNaoPromoc * fltDMVCnd) / 100.0);
            fltDesMaximoPer := (fltPreTabNaoPromoc - fltValMinNaoPromoc);
          End;

          fltValorEmbalagem := fTotalEmbalagemLiquido('N');
          If (fltValorEmbalagem = 0) Then
          Begin
            fltDescoConcedidoEmb := 0;
            fltPerDesConcedidoEmb := 0;
          End
          Else
          Begin
            fltDescoConcedidoEmb  := fltValorEmbalagem - fltTotGerNaoPromoc;
            fltPerDesConcedidoEmb := ((1 - (fltTotGerNaoPromoc / fltValorEmbalagem)) * 100);
          End;

          objLiberacao.objMsgLibera.pAddTexto('ITENS SEM PROMOÇÃO:');
          objLiberacao.objMsgLibera.pAddTextoCaption('Preço de Tabela'               , FormatFloat('#,##0.00', fltPreTabNaoPromoc)      , TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('Desc.Máx. Permitido (em Valor)', fMsgLiberaToMsgOculta(FormatFloat('#,##0.00', fltDesMaximoPer), blnOcultarMsgParaQuemEnvia), TAMANHO_CAPTION, alEsquerda, teAmbos, 'Este desconto refere-se ao desconto do Cadastro de Produtos');

          If (fTravaFinalOuItemAItemConsiderandoComissaoEOuFrete) Then
            objLiberacao.objMsgLibera.pAddTextoCaption(fRetTituloVlrMinimoPermitido, fMsgLiberaToMsgOculta(FormatFloat('#,##0.00', (Self.fltTotMinSPro)), blnOcultarMsgParaQuemEnvia), TAMANHO_CAPTION, alEsquerda, teAmbos, 'Valor de tabela - % de desconto do cadastro de Produtos');

          objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido'             , FormatFloat('#,##0.00', fltDesConcedido)       , TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Concedido'           , FormatFloat('#,##0.00', fltPerDesConced) + '%' , TAMANHO_CAPTION);

          If (fltDescoConcedidoEmb > 0) Then
          Begin
            objLiberacao.objMsgLibera.pAddTextoCaption('Preço de Embalagem', FormatFloat('#,##0.00', fltValorEmbalagem), TAMANHO_CAPTION);
            objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido Embalagem', FormatFloat('#,##0.00', fltDescoConcedidoEmb), TAMANHO_CAPTION);
            objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Concedido Embalagem', FormatFloat('#,##0.00', fltPerDesConcedidoEmb) + '%' + IIF(Self.blnMensagemItePreAltPdOr,' (**)',''), TAMANHO_CAPTION);
          End;

          If (fTravaFinalOuItemAItemConsiderandoComissaoEOuFrete) Then
          Begin
            If (fFormataFloat(fltTotProBri, 2) > 0) Then
              objLiberacao.objMsgLibera.pAddTextoCaption('Valor dos brindes', FormatFloat('#,##0.00', fltTotProBri), TAMANHO_CAPTION);

            objLiberacao.objMsgLibera.pAddTextoCaption(fRetTituloTotalDosProdutos, FormatFloat('#,##0.00', fRetVlrTotalDosProdutos), TAMANHO_CAPTION);

            If blnConsiderarValorDoFreteNaTravaDePreco Then
              objLiberacao.objMsgLibera.pAddTextoCaption(fRetTituloTotalDosProdutos(False), FormatFloat('#,##0.00', fRetVlrTotalDosProdutos(False)), TAMANHO_CAPTION);
          End;

          If (blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
              blnConsiderarValorDoFreteNaTravaDePreco) Then
          Begin

            fltDescoConcedidoTot := fltDesConcedido +
                                    IIF(blnConsiderarAComissaoDoProfissionalNaTravaDePreco, fRetVlrComDig, 0) +
                                    IIF(blnConsiderarValorDoFreteNaTravaDePreco, fltFreCot - fltValFre, 0);

            If blnConsiderarAComissaoDoProfissionalNaTravaDePreco And (fRetVlrComDig() > 0) Then
              objLiberacao.objMsgLibera.pAddTextoCaption('Comissão do Profissional', FormatFloat('#,##0.00', fRetVlrComDig), TAMANHO_CAPTION);

            If blnConsiderarValorDoFreteNaTravaDePreco Then
              objLiberacao.objMsgLibera.pAddTextoCaption('Frete Cotado', FormatFloat('#,##0.00', fltFreCot), TAMANHO_CAPTION);

            objLiberacao.objMsgLibera.pAddTextoCaption('Total Geral Líquido', FormatFloat('#,##0.00', fltTotalGeralLiquido), TAMANHO_CAPTION);
            objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido Total', FormatFloat('#,##0.00', fltDescoConcedidoTot), TAMANHO_CAPTION);
            objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Condedido Total' , FormatFloat('#,##0.00', (fltDescoConcedidoTot / fltPreTabNaoPromoc) * 100), TAMANHO_CAPTION);

          End;

          objLiberacao.objMsgLibera.pAddSeparador(95);

          fltDesMax_Geral := fltDesMax_Geral + fltDesMaximoPer;
          fltValMin_Geral := fltValMin_Geral + Self.fltTotMinSPro;
          fltDesCon_Geral := fltDesCon_Geral + fltDesConcedido;

        End;

        {Com Promoção}
        If fltPreTabPromoc > 0 Then
        Begin

          fltDesConcedido := fltPreTabPromoc - fltTotGerPromoc;
          fltPerDesConced := (fltDesConcedido / fltPreTabPromoc) * 100;
          fltDesMaximoPer := (fltPreTabPromoc - fltValMinPromoc);

          if (VS_strTRADES = '2') And (fCfgSis('TPDMAX') = '2') And (fCfgSis('TVMPDD', varBoolean)) then
          Begin
            fltDesConcedido := fRetornaDescontoConcedido(fltPreTabNaoPromoc, fltTotalGeralLiquido, fltPerDesConced);
            fltPreTabPromoc := fltPreTabPromoc - ((fltPreTabPromoc * fltDMVCnd) / 100.0);
            fltDesMaximoPer := (fltPreTabPromoc - fltValMinPromoc);
          End;

          fltValorEmbalagem := fTotalEmbalagemLiquido('S');
          If (fltValorEmbalagem = 0) Then
          Begin
            fltDescoConcedidoEmb := 0;
            fltPerDesConcedidoEmb := 0;
          End
          Else
          Begin
            fltDescoConcedidoEmb  := fltValorEmbalagem - fltTotGerPromoc;
            fltPerDesConcedidoEmb := ((1 - (fltTotGerPromoc / fltValorEmbalagem)) * 100);
          End;

          objLiberacao.objMsgLibera.pAddTexto('ITENS COM PROMOÇÃO:');
          objLiberacao.objMsgLibera.pAddTextoCaption('Preço de Tabela'               , FormatFloat('#,##0.00', fltPreTabPromoc)      , TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('Desc.Máx. Permitido (em Valor)', FormatFloat('#,##0.00', fltDesMaximoPer)      , TAMANHO_CAPTION, alEsquerda, teAmbos, 'Este desconto refere-se ao desconto do Cadastro de Produtos');

          If (VS_strTRVEPR = '2') Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Valor mínimo permitido'      , FormatFloat('#,##0.00', (Self.fltTotMinCPro)), TAMANHO_CAPTION, alEsquerda, teAmbos, 'Valor de tabela - % de desconto do cadastro de Produtos');

          objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido'            , FormatFloat('#,##0.00', fltDesConcedido)      , TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Concedido'          , FormatFloat('#,##0.00', fltPerDesConced) + '%', TAMANHO_CAPTION);

          If (fltDescoConcedidoEmb > 0) Then
          Begin
            objLiberacao.objMsgLibera.pAddTextoCaption('Preço de Embalagem', FormatFloat('#,##0.00', fltValorEmbalagem), TAMANHO_CAPTION);
            objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido Embalagem', FormatFloat('#,##0.00', fltDescoConcedidoEmb), TAMANHO_CAPTION);
            objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Concedido Embalagem', FormatFloat('#,##0.00', fltPerDesConcedidoEmb) + '%' + IIF(Self.blnMensagemItePreAltPdOr,' (**)',''), TAMANHO_CAPTION);
          End;

          If (VS_strTRVEPR = '2') Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Total dos produtos'          , FormatFloat('#,##0.00', (fltPreTabPromoc-fltDesConcedido))   , TAMANHO_CAPTION);

          objLiberacao.objMsgLibera.pAddSeparador(95);

          fltDesMax_Geral := fltDesMax_Geral + fltDesMaximoPer;
          fltValMin_Geral := fltValMin_Geral + Self.fltTotMinCPro;
          fltDesCon_Geral := fltDesCon_Geral + fltDesConcedido;

        End;

        {Geral}
        fltDesPer_Geral := (fltDesCon_Geral / (fltPreTabNaoPromoc + fltPreTabPromoc)) * 100;

        fltValorEmbalagem := fTotalEmbalagemLiquido();
        If (fltValorEmbalagem = 0) Then
        Begin
          fltDescoConcedidoEmb := 0;
          fltPerDesConcedidoEmb := 0;
        End
        Else
        Begin
          fltDescoConcedidoEmb  := fltValorEmbalagem - fltTotGer;
          fltPerDesConcedidoEmb := ((1 - (fltTotGer / fltValorEmbalagem)) * 100);
        End;

        objLiberacao.objMsgLibera.pAddTexto('GERAL:');
        objLiberacao.objMsgLibera.pAddTextoCaption('Preço de Tabela', FormatFloat('#,##0.00', fltPreTabNaoPromoc + fltPreTabPromoc), TAMANHO_CAPTION);
        objLiberacao.objMsgLibera.pAddTextoCaption('Desc.Máx. Permitido (em Valor)', fMsgLiberaToMsgOculta(FormatFloat('#,##0.00', fltDesMax_Geral), blnOcultarMsgParaQuemEnvia), TAMANHO_CAPTION, alEsquerda, teAmbos, 'Este desconto refere-se ao desconto do Cadastro de Produtos');

        If (fTravaFinalOuItemAItemConsiderandoComissaoEOuFrete) Then
          objLiberacao.objMsgLibera.pAddTextoCaption(fRetTituloVlrMinimoPermitido, fMsgLiberaToMsgOculta(FormatFloat('#,##0.00', fltValMin_Geral), blnOcultarMsgParaQuemEnvia), TAMANHO_CAPTION, alEsquerda, teAmbos, 'Valor de tabela - % de desconto do cadastro de Produtos');

        objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido', FormatFloat('#,##0.00', fltDesCon_Geral), TAMANHO_CAPTION);
        objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Concedido', FormatFloat('#,##0.00', fltDesPer_Geral) + '%' + IIF(Self.blnMensagemItePreAltPdOr,' (**)',''), TAMANHO_CAPTION);

        If (fltDescoConcedidoEmb > 0) Then
        Begin
          objLiberacao.objMsgLibera.pAddTextoCaption('Preço de Embalagem', FormatFloat('#,##0.00', fltValorEmbalagem), TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido Embalagem', FormatFloat('#,##0.00', fltDescoConcedidoEmb), TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('% Desconto Concedido Embalagem', FormatFloat('#,##0.00', fltPerDesConcedidoEmb) + '%' + IIF(Self.blnMensagemItePreAltPdOr,' (**)',''), TAMANHO_CAPTION);
        End;

        If (fTravaFinalOuItemAItemConsiderandoComissaoEOuFrete) Then
        Begin
          objLiberacao.objMsgLibera.pAddTextoCaption(fRetTituloTotalDosProdutos, FormatFloat('#,##0.00', fTotalGeralLiquido(False)), TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption(fRetTituloTotalDosProdutos(False), FormatFloat('#,##0.00', fltValFre), TAMANHO_CAPTION);
        End;

        If (blnConsiderarAComissaoDoProfissionalNaTravaDePreco Or
            blnConsiderarValorDoFreteNaTravaDePreco) Then
        Begin

          fltDescoConcedidoTot := fltDesCon_Geral +
                                  IIF(blnConsiderarAComissaoDoProfissionalNaTravaDePreco, fRetVlrComDig, 0) +
                                  IIF(blnConsiderarValorDoFreteNaTravaDePreco, fltFreCot - fltValFre, 0);

          If blnConsiderarAComissaoDoProfissionalNaTravaDePreco And (fRetVlrComDig() > 0) Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Comissão do Profissional', FormatFloat('#,##0.00', fRetVlrComDig), TAMANHO_CAPTION);

          If blnConsiderarValorDoFreteNaTravaDePreco Then
            objLiberacao.objMsgLibera.pAddTextoCaption('Frete Cotado', FormatFloat('#,##0.00', fltFreCot), TAMANHO_CAPTION);

          objLiberacao.objMsgLibera.pAddTextoCaption('Total Geral Líquido', FormatFloat('#,##0.00', fltTotalGeralLiquido), TAMANHO_CAPTION);
          objLiberacao.objMsgLibera.pAddTextoCaption('Desconto Concedido Total', FormatFloat('#,##0.00', fltDescoConcedidoTot), TAMANHO_CAPTION);
