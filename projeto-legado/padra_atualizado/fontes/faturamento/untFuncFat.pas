  strChave := Concat(strCodIte, strCodEmp, strTabPre, strCampo);

  If dicDesMaxTabPre[strChave] = Null Then
    dicDesMaxTabPre[strChave] := fCampoTabela(strCampo,
                                              'ITETBP',
                                             ['ITE_CODITE', 'ITE_CODEMP', 'ITE_TABPRE'],
                                             [strCodIte, strCodEmp, strTabPre], False);
  Result := dicDesMaxTabPre[strChave];
end;

function TFatVenda.GetDesMaxFaixaQtde(ACodIte, ACodEmp: String; ANivel: Integer; AQtde: Double): Double;
Var LChave: String;
    LCampo: String;
      LSQL: String;
    LQuery: TUniQuery;
begin

  Case ANivel Of
    1: LCampo := 'DFQ_DESVEN';
    2: LCampo := 'DFQ_DESVEM';
    3: LCampo := 'DFQ_DESSUB';
    4: LCampo := 'DFQ_DESSUM';
    5: LCampo := 'DFQ_DESGER';
    6: LCampo := 'DFQ_DESGEM';
  End;

  LChave := Concat(ACodIte, ACodEmp, LCampo, FloatToStr(AQtde));

  Try
    LQuery := fCriaQuery;

    If dicDesMaxFaixaQtde[LChave] = Null Then
    Begin
      LSQL := '';
      LSQL := LSQL + 'SELECT ' + LCampo + ' FROM ITEDFQ ';
      LSQL := LSQL + 'WHERE DFQ_CODITE = :CODITE ';
      LSQL := LSQL + '  AND DFQ_CODEMP = :CODEMP ';
      LSQL := LSQL + '  AND :QTDITE BETWEEN DFQ_QTDINI AND DFQ_QTDFIN ';

      With LQuery Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(LSQL);
        ParamByName('CODITE').AsString := ACodIte;
        ParamByName('CODEMP').AsString := ACodEmp;
        ParamByName('QTDITE').AsFloat  := AQtde;
        Open;

        If not isEmpty Then
          dicDesMaxFaixaQtde[LChave] := Fields[0].Value
        Else
          dicDesMaxFaixaQtde[LChave] := 0;

      End;
    End;

  Finally
    FreeAndNil(LQuery);
    Result := dicDesMaxFaixaQtde[LChave];
  End;
end;

procedure TFatVenda.pCarregaCondicaoPagamentoPedido(qryFatGor: TUniQuery);
Var
  strConAux: String;
begin
  strConPagOri := qryFatGor.FieldByName('FGO_CONPAG').AsString;
  strCodPagOri := qryFatGor.FieldByName('FGO_CODCND').AsString;
  dtaUltDtaAlt := qryFatGor.FieldByName('FGO_ULTALT').AsDateTime;

  strTipFor := fRetTipoForaConPag(strCodCnd);

  strConPag := qryFatGor.FieldByName('FGO_CONPAG').AsString;
  strConAux := '';

  blnCndBasDtaPre := (Pos(strOpcDoc, 'OR_PD_') > 0);

  If (fConPagFora(strTipFor)) Then
  Begin
    strConAux := fRetConPagCodCnd(strCodCnd);

    strConPag := fRetCondicao(Self.fRetConPagRef,
                              Self.dtaUltDtaAlt,
                              strCodCnd,
                              strTipFor,
                              strConAux,
                              IIF(blnCndBasDtaPre, qryFatGor.FieldByName('FGO_PREVIS').AsDateTime, 0),
                              IIF(blnCndBasDtaPre, qryFatGor.FieldByName('FGO_ESPDOC').AsString, ''),
                              strCodCid);
  End;

  If Not fDocumentoParaFornecedor Then
  Begin
    If (fEmptyStr(strConAux)) And (Pos(strTipFor, 'OUTROS_') <= 0) And (Not fEmptyStr(fRetConPagCodCnd(strCodCnd))) Then
      strConAux := fRetConPagCodCnd(strCodCnd)
    Else
      strConAux := strConPag;

    strConPag := fRetCondicaoDiaFixoCliente(Self.fRetConPagRef,
                                            Self.dtaUltDtaAlt,
                                            strCodCli,
                                            strConAux,
                                            IIF(blnCndBasDtaPre, qryFatGor.FieldByName('FGO_PREVIS').AsDateTime, 0),
                                            IIF(blnCndBasDtaPre, qryFatGor.FieldByName('FGO_ESPDOC').AsString, ''),
                                            strCodCid);
  End;
end;

