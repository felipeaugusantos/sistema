function fValidarPedidoComPromocaoDeTintaVencidaExpedicao(fatVenda: TFatVenda): Boolean;
var
  strDoc: String;
  stlDocs: TStringList;
  fltPrecoVenda: Double;
  objLiberacao: TLiberacao;
Begin
  Result := True;

  stlDocs := TStringList.Create;

  Try
    If fatVenda.fExisteTintaComPromocaoVencidaNoPedido(fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                                       fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                                       fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CODEMP').AsString,
                                                       fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CODCLI').AsString,
                                                       '',
                                                       fltPrecoVenda,
                                                       stlDocs) Then
    Begin
      objLiberacao := TLiberacao.Create;

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('O Pedido [ '+fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_NUMDOC').AsString+' ] contém itens de tinta com divergências na promoção!');
      objLiberacao.objMsgLibera.pAddTexto('');

      if stlDocs.Count > 0 then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Produtos:');

        For strDoc In stlDocs Do
          objLiberacao.objMsgLibera.pAddTexto(strDoc);
      end;

      objLiberacao.strDirAce := 'PROVEN';
      objLiberacao.strMsgSen := 'Produtos com divergência na promoção';
      objLiberacao.blnMosMen := True;
      objLiberacao.strCodOpe := strLoginUsuarioLogado;

      objLiberacao.pInformaNumDocEspDocCodEmp(
                          fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                          fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                          fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_CODEMP').AsString);

      Result := objLiberacao.fLibera;

      objLiberacao.Free;
    End;
  Finally
    FreeAndNil(stlDocs);
  End;
End;

function fValidarPedidoOrigemAkzoNobelExpedicao(fatVenda: TFatVenda): Boolean;
begin
  Result := True;
  If fatVenda.objExpedicao.blnUsaRotinaWMS And (fatVenda.objExpedicao.qryFatGor.FieldByName('FGO_ORIGEM').AsString = 'AKZO NOBEL') Then
  Begin
    If fAtualizarPrecoVendaPedidoAkzoNobelExpedicao(fatVenda) then
      fatVenda.strCodTra := fCfgSis('AKZTRA')
    Else
      Result := False;
  End;
end;

function fAtualizarPrecoVendaPedidoAkzoNobelExpedicao(fatVenda: TFatVenda): Boolean;

  function fPrecoPraticado(strCodIte, strCodEmp, strNumLot: String): Double;
  var strTabPre, strPreCam: String;
  Begin
   strTabPre := fCfgSis('AKZPRE');

   If strTabPre = 'CUS' Then
      strPreCam := 'ITE_PRECUS'
   Else If LeftStr(strTabPre, 2) = 'VE' Then
      strPreCam := 'ITE_PRE' + strTabPre
   Else If strTabPre = 'ULT' Then
      strPreCam := 'ITE_PREULT'
   Else If strTabPre = 'MED' Then
      strPreCam := 'ITE_PREMED'
   Else If strTabPre = 'COM' Then
      strPreCam := 'ITE_PRECOM'
   Else If strTabPre = 'IMP' Then
      strPreCam := 'ITE_IMPULT'
   Else If strTabPre = 'SIC' Then
      strPreCam := 'ITE_MEDSIC'
   Else If strTabPre = 'LOTULT' Then
      strPreCam := IIF( not fEmptyStr(strNumLot), 'LOT_PREULT', 'ITE_PREULT')
   Else If strTabPre = 'LOTIMP' Then
      strPreCam := IIF( not fEmptyStr(strNumLot), 'LOT_IMPULT', 'ITE_IMPULT');

    If LeftStr(strPreCam, 3) = 'ITE' Then
      Result := fCampoTabela(strPreCam, 'ITEGER', ['ITE_CODITE','ITE_CODEMP'], [strCodIte, strCodEmp])
    Else
    Begin
      Result := fCampoTabela(strPreCam, 'CADLOT', ['LOT_CODITE','LOT_CODEMP','LOT_NUMLOT'], [strCodIte, strCodEmp, strNumLot]);
      If Result <= 0 Then
        Result := fCampoTabela('LOT_PRECUS', 'CADLOT', ['LOT_CODITE','LOT_CODEMP','LOT_NUMLOT'], [strCodIte, strCodEmp, strNumLot]);
    End;
  End;

  procedure pAKZGravaDEL_LOTDOR;
  var qryAux: TUniQuery;
  begin
    Try
      qryAux := fCriaQuery;

      With fatVenda.objExpedicao.cdsItens do
      Begin
        DisableControls;
        First;
        While not eof do
        Begin
          With qryAux, Sql Do
          Begin
            Close;
            Clear;
            Add('SELECT * FROM LOTDOR WHERE LDO_SEQFDO = :AUTINC');
            ParamByName('AUTINC').AsString := fatVenda.objExpedicao.cdsItens.FieldByName('AUTOINCREM').AsString;
            Open;

            If Not IsEmpty Then
              fVerificaIntegridade('fAtualizarPrecoVendaPedidoAkzoNobelExpedicao', 'LOTDOR', qryAux, True, False, '');
          End;

          Next;
        End;
        EnableControls;
      End;

    Finally
      FreeAndNil(qryAux);
    End;
  End;


Begin
  Result := True;

  With cdsVenda do
  Begin
    First;
    DisableControls;

    While Not cdsVenda.Eof Do
    Begin
      If FieldByName('ITE_UNITAR').AsFloat > 0 Then
      Begin
        Edit;
        FieldByName('ITE_UNIORI').AsFloat := fPrecoPraticado(FieldByName('ITE_CODITE').AsString,
                                                             IIF( Not FieldByName('ITE_EMPITE').IsNull,
                                                                  FieldByName('ITE_EMPITE').AsString,
                                                                  FieldByName('ITE_CODEMP').AsString),
                                                                  FieldByName('ITE_LOTSEP').AsString);
        FieldByName('ITE_UNITAR').AsFloat := FieldByName('ITE_UNIORI').AsFloat;

        If FieldByName('ITE_UNITAR').AsFloat <= 0 Then
