function TFatVenda.fExisteTintaComPromocaoVencidaNoPedido(strNumDoc, strEspDoc, strCodEmp, strCodCli, strCodIte: String; var fltPrecoVenda: Double): Boolean;
var
  stlDocs: TStringList;
begin

  stlDocs := TStringList.Create;

  Try
    Result := fExisteTintaComPromocaoVencidaNoPedido(strNumDoc, strEspDoc, strCodEmp, strCodCli, strCodIte, fltPrecoVenda, stlDocs);
  Finally
    FreeAndNil(stlDocs);
  End;
