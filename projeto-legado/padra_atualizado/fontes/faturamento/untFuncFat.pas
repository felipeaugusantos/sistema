function TFatVenda.fRegravaLotDor(const strAutIncOld,
  strAutIncNew: String; fltQtdAtu: Double): Boolean;
 Var
   LQryLotDor: TUniQuery;
   intContador: Integer;
   blnQuantidadeAtualMenorQueSeparada: Boolean;
   fltQtdTotLdo,
   fltQtdIteLdo,
   fltQtdItePed: Double;

   function fPedidoEmPedido: Boolean;
   begin
     Result := False;

     If (Self.strOriF11 = 'S') Then
       Result := (Self.strEspOrc = 'PD') And (Self.strEspDoc = 'PD') And ((Not fEmptyStr(Self.strNumOrc)) And (Self.strNumOrc <> Self.strNumDoc));
   end;

begin
  Result := True;

  If not Assigned(FCdsLotDor) Then
    Exit;

  Try
    FCdsLotDor.Filtered := False;
    FCdsLotDor.Filter := 'LDO_SEQFDO = ' + QuotedStr(strAutIncOld) ;
    FCdsLotDor.Filtered := True;

    fltQtdItePed := fltQtdAtu;

    fltQtdTotLdo := 0;
    FCdsLotDor.First;
    While Not FCdsLotDor.Eof Do
    begin
      fltQtdTotLdo := fltQtdTotLdo + FCdsLotDor.FieldByName('LDO_QTDITE').AsFloat;

      If FCdsLotDor.FindField('SEQNEW') <> nil Then
      Begin
        FCdsLotDor.Edit;
        FCdsLotDor.FieldByName('SEQNEW').AsString := strAutIncNew;
        FCdsLotDor.Post;
      End;

      FCdsLotDor.Next;
    End;
    FCdsLotDor.First;

    blnQuantidadeAtualMenorQueSeparada := (fFormataFloat(fltQtdItePed, 4)) < (fFormataFloat(fltQtdTotLdo, 4));

    If (FblnEmGeracaoVendasPerdidas And blnQuantidadeAtualMenorQueSeparada) Then
      FCdsLotDor.IndexFieldNames := 'LDO_QTDITE';

    LQryLotDor := fCriaQuery;
    LQryLotDor.SQL.Add('SELECT * FROM LOTDOR WHERE FALSE');
    LQryLotDor.Open;
    Try
      While Not FCdsLotDor.Eof Do
      begin
        If (fFormataFloat(fltQtdItePed, 4) > 0) Then
        Begin
          fltQtdIteLdo := FCdsLotDor.FieldByName('LDO_QTDITE').AsFloat;

          If FblnEmGeracaoVendasPerdidas Then
          Begin
            If blnQuantidadeAtualMenorQueSeparada Then
            Begin
              If fFormataFloat(fltQtdIteLdo, 4) > fFormataFloat(fltQtdItePed, 4) Then
                fltQtdIteLdo := fltQtdItePed;

              fltQtdItePed := fltQtdItePed - fltQtdIteLdo;
            End;
          End;

          LQryLotDor.Append;

          For intContador := 0 To Pred(LQryLotDor.Fields.Count) Do
            If (LQryLotDor.Fields[intContador].FieldName <> 'LDO_QTDITE') Then
              LQryLotDor.Fields[intContador].Value := FCdsLotDor.FieldByName(LQryLotDor.Fields[intContador].FieldName).Value;

          LQryLotDor.FieldByName('LDO_QTDITE').AsFloat  := fltQtdIteLdo;
          LQryLotDor.FieldByName('LDO_SEQFDO').AsString := strAutIncNew;

          If Self.blnDesmembrarOrPd Or TPickingCheckOut.fWMSUtilizaPickingCheckOut Then
          Begin
            LQryLotDor.FieldByName('AUTOINCREM').AsString := fRetAutoIncrem('LOTDOR', VS_strCodEmp)
          End
          Else If fPedidoEmPedido Then
          Begin
            untFuncoesSimples.fExecutaSQL('DELETE FROM LOTDOR WHERE AUTOINCREM = ' + QuotedStr(LQryLotDor.FieldByName('AUTOINCREM').AsString));
            LQryLotDor.FieldByName('AUTOINCREM').AsString := fRetAutoIncrem('LOTDOR', VS_strCodEmp)
          End;

          LQryLotDor.Post;
        End;

        FCdsLotDor.Next;
      End;
    Finally
      FreeAndNil(LQryLotDor);
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fRegravaLotDor]');
    End;
  End;
end;

function TFatVenda.fRegravarCdsFgoCaiExp(Const strAutIncFgo, strAutIncFdo: String; Const item: TDadosFechamento): Boolean;
  Var
    qryFgoCai : TUniQuery;
    LAutInc: String;
    LQtdIns: Integer;
begin
  Result := True;

  If fCfgSis('MONCAI', varBoolean) And (Pos(VS_strTipExp, '3_4') > 0) And Assigned(cdsFgoCaiExp) Then
  Begin
    If (Not cdsFgoCaiExp.IsEmpty) Then
    Begin
      qryFgoCai := fCriaQuery;
      Try
        With qryFgoCai Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(' REPLACE INTO FGOCAI ( ');
          SQL.Add('         AUTOINCREM, ');
          SQL.Add('         FGC_FGOINC, ');
          SQL.Add('         FGC_FDOINC, ');
          SQL.Add('         FGC_CAI_ID, ');
          SQL.Add('         FGC_CODBAR, ');
          SQL.Add('         FGC_QUANTD, ');
          SQL.Add('         FGC_EMPFAT, ');
          SQL.Add('         FGC_NUMFAT, ');
          SQL.Add('         FGC_TIPFAT, ');
          SQL.Add('         FGC_DETINC) ');
          SQL.Add(' VALUES (:AUTINC,    ');
          SQL.Add('         :FGOINC,    ');
          SQL.Add('         :FDOINC,    ');
          SQL.Add('         :CAI_ID,    ');
          SQL.Add('         :CODBAR,    ');
          SQL.Add('         :QUANTD,    ');
          SQL.Add('         :EMPFAT,    ');
          SQL.Add('         :NUMFAT,    ');
          SQL.Add('         :TIPFAT,    ');
          SQL.Add('         :DETINC)    ');

          Try
            LQtdIns := 0;
            cdsFgoCaiExp.First;
            While Not cdsFgoCaiExp.Eof Do
            begin
              If (cdsFgoCaiExp.FieldByName('FGC_FDOINC').AsString = item.strSeqDet) Then
                LQtdIns := LQtdIns + 1;

              cdsFgoCaiExp.Next;
            end;
            cdsFgoCaiExp.First;

            If LQtdIns > 0 Then
            Begin
              LAutInc := fRetAutoIncrem('FGOCAI', VS_strCodEmp, LQtdIns);
              While Not cdsFgoCaiExp.Eof Do
              Begin
                If (cdsFgoCaiExp.FieldByName('FGC_FDOINC').AsString = item.strSeqDet) Then
                Begin
                  ParamByName('AUTINC').AsString := LAutInc;
                  ParamByName('FGOINC').AsString := strAutIncFgo;
                  ParamByName('FDOINC').AsString := strAutIncFdo;
                  ParamByName('CAI_ID').Value    := cdsFgoCaiExp.FieldByName('FGC_CAI_ID').Value;
                  ParamByName('CODBAR').Value    := cdsFgoCaiExp.FieldByName('FGC_CODBAR').Value;
                  ParamByName('QUANTD').Value    := cdsFgoCaiExp.FieldByName('FGC_QUANTD').Value;
                  ParamByName('EMPFAT').Value    := cdsFgoCaiExp.FieldByName('FGC_EMPFAT').Value;
                  ParamByName('NUMFAT').Value    := cdsFgoCaiExp.FieldByName('FGC_NUMFAT').Value;
                  ParamByName('TIPFAT').Value    := cdsFgoCaiExp.FieldByName('FGC_TIPFAT').Value;
                  ParamByName('DETINC').Value    := cdsFgoCaiExp.FieldByName('FGC_DETINC').Value;

                  ExecSQL;

                  LAutInc := fNextAutoIncrem(LAutInc)
                End;
                cdsFgoCaiExp.Next;
              End;
            End;
            Result := True;
          Except
            On E: Exception Do
            Begin
              Result := False;
              pMensagensErro(E.Message, '[fRegravarCdsFgoCaiExp]');
            End;
          End;
        End;
      Finally
        FreeAndNil(qryFgoCai);
      End;
    End;
  End;
end;

function TFatVenda.fRetValItemFrete: Double;
  Var
    Item: TDadosFechamento;
