function TFatVenda.fExisteCilindroVasilhameFaturamentoArrMatrizFechamento: Boolean;
var
  intContador : Integer;
begin
  If (Not fCfgSis('CDTCLV',varBoolean)) Or
     (Pos(strEspDoc, 'PD_FF_IF_NF_') = 0) Then
    Exit(False);

  Result := False;
  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (arrMatItens[intContador].strCilVas = 'S') Then
    Begin
      Result := True;
      Exit;
    End;
  End;
end;

procedure TFatVenda.pCarregaSepDor(const ASeqFgo, ATabela: String; var ASepDor: TMatrizSepDor);
var
  LSQL: String;
  LPosition: integer;
  LQry: TUniQuery;
begin
  SetLength(ASepDor, 0);

  LQry := fCriaQuery;
  try
    LSQL := '';
    LSQL := LSQL + 'SELECT ' + ATabela + '.AUTOINCREM AS SEP_AUTINC, SEP_SEQFDO, SEP_QTDCON, SEP_OPECON, SEP_CONFIN, SEP_DTAINI, SEP_DTAFIN ';
    LSQL := LSQL + 'FROM ' + ATabela + ' ';
    LSQL := LSQL + 'INNER JOIN FATDOR ON SEP_SEQFDO = FATDOR.AUTOINCREM ';
    LSQL := LSQL + 'WHERE FDO_SEQGER = :SEQGER ';

    LQry.SQL.Text := LSQL;
    LQry.ParamByName('SEQGER').AsString := ASeqFgo;
    LQry.Open;
    LQry.First;

    while not LQry.Eof do
    begin
      LPosition := Length(ASepDor);

      SetLength(ASepDor, LPosition + 1);

      ASepDor[LPosition].strAutInc := LQry.FieldByName('SEP_AUTINC').AsString;
      ASepDor[LPosition].strSeqFdo := LQry.FieldByName('SEP_SEQFDO').AsString;
      ASepDor[LPosition].fltQtdCon := LQry.FieldByName('SEP_QTDCON').AsFloat;
      ASepDor[LPosition].strOpeCon := LQry.FieldByName('SEP_OPECON').AsString;
      ASepDor[LPosition].strConFin := LQry.FieldByName('SEP_CONFIN').AsString;
      ASepDor[LPosition].dtaDtaIni := LQry.FieldByName('SEP_DTAINI').AsDateTime;
      ASepDor[LPosition].dtaDtaFin := LQry.FieldByName('SEP_DTAFIN').AsDateTime;

      LQry.Next;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

