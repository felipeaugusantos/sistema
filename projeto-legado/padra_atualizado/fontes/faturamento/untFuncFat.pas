function TFatVenda.fCarregaDescontoEmbFechada(Const strCodIte, strTabPre: String; cdsIteDesEmb: TUniClientDataSet): Boolean;
  Var
    qryDesEmb: TUniQuery;
begin
  cdsIteDesEmb.Filtered := False;
  cdsIteDesEmb.Filter   := 'ITE_CODITE = '+ QuotedStr(strCodIte);
  cdsIteDesEmb.Filtered := True;

  If Not cdsIteDesEmb.IsEmpty Then
    Exit(True);

  qryDesEmb := fCriaQuery;
  Try
    qryDesEmb.SQL.Add('SELECT ITB_QTDEMB ');
    qryDesEmb.SQL.Add('FROM ITEEMB ');
    qryDesEmb.SQL.Add('WHERE ITB_CODITE = :CODITE ');
    qryDesEmb.SQL.Add('  AND ITB_CODEMP = :CODEMP ');
    qryDesEmb.SQL.Add('  AND (ITB_TABPRE IS NULL OR ITB_TABPRE = :TABPRE) ');
    qryDesEmb.SQL.Add('ORDER BY ITB_QTDEMB DESC');

    qryDesEmb.ParamByName('CODITE').AsString := strCodIte;
    qryDesEmb.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDesEmb.ParamByName('TABPRE').AsString := strTabPre;
    qryDesEmb.Open;

    qryDesEmb.First;
    While Not qryDesEmb.Eof Do
    Begin
      cdsIteDesEmb.Append;
      cdsIteDesEmb.FieldByName('ITE_CODITE').AsString := strCodIte;
      cdsIteDesEmb.FieldByName('ITB_QTDEMB').AsFloat  := qryDesEmb.FieldByName('ITB_QTDEMB').AsFloat;
      cdsIteDesEmb.Post;

      qryDesEmb.Next;
    End;

    Result := (qryDesEmb.RecordCount > 0);
  Finally
    FreeAndNil(qryDesEmb);
  End;
end;

