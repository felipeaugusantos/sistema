begin

  Result := False;

  If (fEmptyStr(fCfgSis('SENCOR'))) Then
  Begin
    fMensagem('','Este produto não possui saldo suficiente para esta venda!',['&OK']);
    Exit;
  End;

  objLiberacao := TLiberacao.Create;
  try
    objLiberacao.objMsgLibera.lstRegistros.OwnsObjects := False; //seta para false para não matar os itens da lista, pois eles ainda possuem referência no objMsg e serão liberados por ele.

    objLiberacao.objMsgLibera.pAddTexto('Este(s) produto(s) não possui saldo suficiente para esta venda!');

