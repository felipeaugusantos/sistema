                                 'ALTERAÇÃO DE BAIXA - RET. CONSIGNAÇÃO', strNomeForm);
                  End;
                end
                else
                begin
                  Result := fBaixaTotal(qryConsignacao.FieldByName('CTR_NUMDUP').AsString,                   // Duplicata
