function TFatVenda.fTemSubItemSemEstoque: Boolean;
  Var
    objItensEstrutura: TItensEstrutura;
    subItem: TSubItemEstrutura;
    intCont: Integer;
    intIndIte: Integer;
    fltSaldo: Double;
begin
  Result := False;

  If fCfgSis('CAREST', varString) = 'P' Then
    Exit;

  If Not fTemItemEstruturaBaixandoEstoqueDosSubProdutos Then
    Exit;

  objItensEstrutura := TItensEstrutura.Create;
  Try
    For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If fItemEstrutura(arrMatItens[intIndIte].strCodIte) Then
      Begin
        objItensEstrutura.pCarregarEstrutura(arrMatItens[intIndIte].strCodIte, arrMatItens[intIndIte].fltQtdIte);
        For intCont := 0 To objItensEstrutura.ItemsCount -1 Do
        Begin
          subItem := objItensEstrutura[intCont];

          fltSaldo := fRetornaSaldoDisponivel(subItem.strCodigo, False, True, '', True, VS_strCodEmp, strNumDoc);

          If (fltSaldo < subItem.fltQtdTot) Then
          Begin
            Result := True;
            Break;
          End;
        End;
      End;
    End;
  Finally
    FreeAndNil(objItensEstrutura);
  End;
end;

function TFatVenda.fAdicionarSubItensParaRequisicaoCompras(cdsDados: TUniClientDataSet): OleVariant;
  Var
    objItensEstrutura: TItensEstrutura;
    subItem: TSubItemEstrutura;
    intCont: Integer;
    cdsDadosComSubItens: TUniClientDataSet;
    fltSaldo: Double;
begin
  cdsDadosComSubItens := TUniClientDataSet.Create(Self);
  objItensEstrutura := TItensEstrutura.Create;
  Try
    cdsDadosComSubItens.Data := cdsDados.Data;

    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      If fItemEstrutura(cdsDados.FieldByName('ITE_CODITE').AsString) Then
      Begin
        objItensEstrutura.pCarregarEstrutura(cdsDados.FieldByName('ITE_CODITE').AsString,
                                             cdsDados.FieldByName('ITE_QTDITE').AsFloat,
                                             VS_strCodEmp,
                                             cdsDados.FieldByName('ITE_ENTRET').AsString = 'E');

        For intCont := 0 To objItensEstrutura.ItemsCount -1 Do
        Begin
          subItem := objItensEstrutura[intCont];

          fltSaldo := fRetornaSaldoDisponivel(subItem.strCodigo, False, True, '', True, VS_strCodEmp, strNumDoc);

          If (fltSaldo < subItem.fltQtdTot) Then
          Begin
            cdsDadosComSubItens.Append;
            cdsDadosComSubItens.FieldByName('ITE_CODITE').AsString := subItem.strCodigo;
            cdsDadosComSubItens.FieldByName('ITE_DESITE').AsString := fCampoTabela('ITE_DESITE', 'CADITE', ['ITE_CODITE'], [subItem.strCodigo], False);
            cdsDadosComSubItens.FieldByName('ITE_QTDITE').AsFloat  := subItem.fltQtdTot;
            cdsDadosComSubItens.FieldByName('ITE_SEMEST').AsString := 'S';
            cdsDadosComSubItens.FieldByName('ITE_ENTFUT').AsString := cdsDados.FieldByName('ITE_ENTFUT').AsString;
            cdsDadosComSubItens.FieldByName('ITE_MOTFUT').AsString := cdsDados.FieldByName('ITE_MOTFUT').AsString;
            cdsDadosComSubItens.FieldByName('ITE_OPCABS').AsString := cdsDados.FieldByName('ITE_OPCABS').AsString;
            cdsDadosComSubItens.FieldByName('ITE_PEGOU_').AsString := cdsDados.FieldByName('ITE_PEGOU_').AsString;
            cdsDadosComSubItens.FieldByName('ITE_ENTRET').AsString := cdsDados.FieldByName('ITE_ENTRET').AsString;
            cdsDadosComSubItens.FieldByName('ITE_LOCRET').AsString := cdsDados.FieldByName('ITE_LOCRET').AsString;
            cdsDadosComSubItens.FieldByName('ITE_EMPITE').AsString := cdsDados.FieldByName('ITE_EMPITE').AsString;
            cdsDadosComSubItens.Post;
          End;
        End;
      End;

      cdsDados.Next;
    End;

    Result := cdsDadosComSubItens.Data;
  Finally
    FreeAndNil(cdsDadosComSubItens);
    FreeAndNil(objItensEstrutura);
  End;
end;

function TFatVenda.fUniDigDescontada(const fltUniDig, fltTaxJur, fltDescon, fltDesCnd: Double; const strItemPromocao: String): Double;
begin
  Result := fltUniDig;

  If fPermiteAplicarJurosNaPromocao(strItemPromocao) Then
  Begin
    If fAplicarTaxaJurosPrecoDigitado Then
    Begin
      Result := Result + (Result * fltTaxJur / 100.0);
    End;
  End;

  Result := fFormataFloat(Result, VS_intDecUni);
  Result := Result - fRetornaVrDesconto(2, Result, fltDescon);
  Result := fFormataFloat(Result, fMaxDecUni);
  Result := fFormataFloat(Result, VS_intDecUni);

  pAplicaRegrasCondicoesDePagamentoOrigemF11(Result, fltTaxJur, fltDesCnd, strItemPromocao);
end;

procedure TFatVenda.pAplicaRegrasCondicoesDePagamentoOrigemF11(var fltUniDigDescontada: Double; const fltTaxJur, fltDesCnd: Double; const strItemPromocao: String);

  procedure pAplicaJurosCondicoesDePagamento;
  begin
    pAtualizaInformacoesCondPagamento;

    If fPermiteAplicarJurosNaPromocao(strItemPromocao) And (fAplicarTaxaJurosPrecoDigitado) then
      Exit;

    If fZerarTaxaDeJurosValorAPrazo() Then
      Exit;

    if (fltTaxJur = 0) then
      Exit;

    fltUniDigDescontada := fltUniDigDescontada + (fltUniDigDescontada * (fltTaxJur / 100.0));
  end;

  procedure pAplicaDescontoCondicoesDePagamento;
  begin
    if (fltDesCnd = 0) then
      Exit;

    fltUniDigDescontada := fltUniDigDescontada - (fltUniDigDescontada * (fltDesCnd / 100.0));
  end;

begin
  if not VS_AutoatendimentoPagueFacil then
  begin
    if (strOriF11 <> 'S') then
      Exit;

    if (fCfgSis('CNDVEN') = 'I') then
      Exit;
  end ;

  pAplicaJurosCondicoesDePagamento;
  pAplicaDescontoCondicoesDePagamento;
end;

procedure TFatVenda.pCarregaCdsImpostos(strIncPed: String);
  var
    qryGen: TUniQuery;
    strLisCodIte: String;
Begin
  qryGen := fCriaQuery;
  Try
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Text := 'SELECT FDO_CODITE, FDO_EMPITE, FDO_CODEMP, FDO_TABPRE FROM FATDOR WHERE FDO_SEQGER = '+QuotedStr(strIncPed);
    qryGen.Open;

    qryGen.First;

    If fHabilitouCustoPorTabelaDePreco Then
    Begin
      While Not qryGen.Eof Do
      Begin
        pCarregaCdsImpostosItem(qryGen.FieldByName('FDO_CODITE').AsString,
                                IIF(fEmptyStr(qryGen.FieldByName('FDO_EMPITE').AsString), qryGen.FieldByName('FDO_CODEMP').AsString, qryGen.FieldByName('FDO_EMPITE').AsString),
                                qryGen.FieldByName('FDO_TABPRE').AsString);
        qryGen.Next;
      End;
    End
    Else
    Begin

      If Not qryGen.IsEmpty Then
      Begin
        While Not qryGen.Eof Do
        Begin
          pIncrementaListaStr(qryGen.FieldByName('FDO_CODITE').AsString, strLisCodIte, True, True, ',', False);

          qryGen.Next;
        End;
      End;

      If Not fEmptyStr(strLisCodIte) Then
        pCarregaCdsImpostosItem(strLisCodIte, cdsIteGer);
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

