procedure TFatVenda.pCarregaResumoCodFiscal(fatVenda: TFatVenda);
Var
    blnEncontrou : Boolean;
    intContador  : Integer;
    intContador2 : Integer;
    arrCodFiscais: Array Of TCodFiscais;
Begin

  SetLength(arrCodFiscais,0);

  For intContador := 0 To Length(fatVenda.arrMatItens) -1 Do
  Begin
    blnEncontrou := False;

    {**************************************}
    {* PROCURA O CODIGO                   *}
    {***********************************AF*}
    For intContador2 := 0 To Length(arrCodFiscais) -1 Do
    Begin
      If arrCodFiscais[intContador2].strCodFis = fatVenda.arrMatItens[intContador].strCodFis Then
      Begin
        blnEncontrou := True;
        Break;
      End;
    End;

    {**************************************}
    {* SE ENCONTROU O CODIGO              *}
    {***********************************AF*}
    If blnEncontrou Then
    Begin
      arrCodFiscais[intContador2].strCodFis := fatVenda.arrMatItens[intContador].strCodFis;
      arrCodFiscais[intContador2].fltTotIte := arrCodFiscais[intContador2].fltTotIte + (fatVenda.arrMatItens[intContador].fltTotIte - fatVenda.arrMatItens[intContador].fltDesEsp);
    End
    Else
    Begin

      SetLength(arrCodFiscais,Length(arrCodFiscais)+1);
      arrCodFiscais[Length(arrCodFiscais) -1].strCodFis := fatVenda.arrMatItens[intContador].strCodFis;
      arrCodFiscais[Length(arrCodFiscais) -1].fltTotIte := fatVenda.arrMatItens[intContador].fltTotIte - fatVenda.arrMatItens[intContador].fltDesEsp;

    End;
  End;

  fatVenda.strResFi1 := '';
  fatVenda.strResFi2 := '';
  fatVenda.strResFi3 := '';
  fatVenda.strResFi4 := '';

  If Length(arrCodFiscais) >= 1 Then
    fatVenda.strResFi1 := arrCodFiscais[0].strCodFis + '-' + FloatToStrF(arrCodFiscais[0].fltTotIte, ffFixed, 12, 2);

  If Length(arrCodFiscais) >= 2 Then
    fatVenda.strResFi2 := ' / ' + arrCodFiscais[1].strCodFis + '-' + FloatToStrF(arrCodFiscais[1].fltTotIte, ffFixed, 12, 2);

  If Length(arrCodFiscais) >= 3 Then
    fatVenda.strResFi3 := ' / ' + arrCodFiscais[2].strCodFis + '-' + FloatToStrF(arrCodFiscais[2].fltTotIte, ffFixed, 12, 2);

  If Length(arrCodFiscais) >= 4 Then
    fatVenda.strResFi4 := ' / ' + arrCodFiscais[3].strCodFis + '-' + FloatToStrF(arrCodFiscais[3].fltTotIte, ffFixed, 12, 2);

End;

procedure TFatVenda.pCarregaResumoCfop(fatVenda: TFatVenda);
  Var
    blnEncontrou : Boolean;
    intContador2 : Integer;
    arrResCfop   : Array Of TResCfop;
    fltAlqCfo    : Double;
    cdsDados     : TUniClientDataSet;
Begin
  pAtualizaTemporariaItens(cdsVenda);

  cdsDados := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  {************************************************}
  {* PEGA O VALOR DA ALQICM P\ O CALCULO DAS CFOP *}
  {*********************************************JB*}
  fltAlqCfo := 17;
  fltAlqCfo := IIF(Pos(strCliEst, 'MG_PR_SP_') > 0, 18, fltAlqCfo);
  fltAlqCfo := IIF(SameText(strCliEst, 'RJ'),       19, fltAlqCfo);

  cdsDados.IndexFieldNames := 'ITE_CLAFIS';
  With cdsDados Do
  Begin
    First;

    SetLength(arrResCfop,0);

    While (Not Eof) Do
    Begin

      If FieldByName('ITE_BASICM').AsFloat <= 0 Then
        fltAlqCfo := 0;

      blnEncontrou := False;

      {**************************************}
      {* PROCURA O CODIGO                   *}
      {***********************************JB*}
      For intContador2 := 0 To Length(arrResCfop) -1 Do
      Begin
        If arrResCfop[intContador2].strClaFis = FieldByName('ITE_CLAFIS').AsString Then
        Begin
          blnEncontrou := True;
          Break;
        End;
      End;

      {**************************************}
      {* SE ENCONTROU O CODIGO              *}
      {***********************************JB*}
      If blnEncontrou Then
      Begin
        arrResCfop[intContador2].strClaFis := FieldByName('ITE_CLAFIS').AsString;
        arrResCfop[intContador2].fltTotBas := arrResCfop[intContador2].fltTotBas + FieldByName('ITE_BASICM').AsFloat;
        arrResCfop[intContador2].fltTotPro := arrResCfop[intContador2].fltTotPro + (FieldByName('ITE_TOTITE').AsFloat - FieldByName('ITE_DESESP').AsFloat);

        If (Pos(RightStr(FieldByName('ITE_CLAFIS').AsString, 3), '_403_404_405_411') > 0) Then
          arrResCfop[intContador2].fltTotVal := arrResCfop[intContador2].fltTotVal                                       +
                                                ((FieldByName('ITE_TOTITE').AsFloat - FieldByName('ITE_DESESP').AsFloat) *
                                                 (fltAlqCfo / 100))
        Else
          arrResCfop[intContador2].fltTotVal := arrResCfop[intContador2].fltTotVal                                       +
                                                ((FieldByName('ITE_TOTITE').AsFloat - FieldByName('ITE_DESESP').AsFloat) *
                                                 (FieldByName('ITE_ALQICM').AsFloat / 100));

      End
      Else
      Begin
        SetLength(arrResCfop,Length(arrResCfop)+1);
        arrResCfop[Length(arrResCfop) -1].strClaFis := FieldByName('ITE_CLAFIS').AsString;
        arrResCfop[Length(arrResCfop) -1].fltTotBas := FieldByName('ITE_BASICM').AsFloat;
        arrResCfop[Length(arrResCfop) -1].fltTotPro := (FieldByName('ITE_TOTITE').AsFloat - FieldByName('ITE_DESESP').AsFloat);

        If (Pos(RightStr(FieldByName('ITE_CLAFIS').AsString, 3), '_403_404_405_411') > 0) Then
          arrResCfop[Length(arrResCfop) -1].fltTotVal := ((FieldByName('ITE_TOTITE').AsFloat - FieldByName('ITE_DESESP').AsFloat) *
                                                          (fltAlqCfo / 100))
        Else
          arrResCfop[Length(arrResCfop) -1].fltTotVal := ((FieldByName('ITE_TOTITE').AsFloat - FieldByName('ITE_DESESP').AsFloat) *
                                                          (FieldByName('ITE_ALQICM').AsFloat / 100));

      End;

      Next;
    End;

    fatVenda.strResCf1 := '';
    fatVenda.strResCf2 := '';
    fatVenda.strResCf3 := '';

    fatVenda.strReTCf1 := '';
    fatVenda.strReTCf2 := '';
    fatVenda.strReTCf3 := '';

    fatVenda.strReTCfD1 := '';
    fatVenda.strReTCfD2 := '';
    fatVenda.strReTCfD3 := '';

    If Length(arrResCfop) >= 1 Then
    Begin
      fatVenda.strResCf1  := arrResCfop[0].strClaFis + ' =' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotBas, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotVal, ffFixed, 12, 2), 9);
      fatVenda.strReTCf1  := arrResCfop[0].strClaFis + ' =' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotVal, ffFixed, 12, 2), 9);

      fatVenda.strReTCfD1 := arrResCfop[0].strClaFis + ' - ' +
                             fPadR(fRetDesCla(arrResCfop[0].strClaFis), 50) +
                                                       ' =' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotVal, ffFixed, 12, 2), 9);

      {**********************************}
      {* RESUMO DA AGUIA TINTAS 000/060 *}
      {*******************************JB*}
      If (Pos(RightStr(arrResCfop[0].strClaFis, 3), '_403_404_405_411') > 0) Then
        fatVenda.strCla060 := RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotVal, ffFixed, 12, 2), 9)
      Else
        fatVenda.strCla000 := RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[0].fltTotVal, ffFixed, 12, 2), 9);

    End;

    If Length(arrResCfop) >= 2 Then
    Begin
      fatVenda.strResCf2  := arrResCfop[1].strClaFis + ' =' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotBas, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotVal, ffFixed, 12, 2), 9);
      fatVenda.strReTCf2  := arrResCfop[1].strClaFis + ' =' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotVal, ffFixed, 12, 2), 9);

      fatVenda.strReTCfD2 := arrResCfop[1].strClaFis + ' - ' +
                             fPadR(fRetDesCla(arrResCfop[1].strClaFis), 50) +
                                                       ' =' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotVal, ffFixed, 12, 2), 9);

      {**********************************}
      {* RESUMO DA AGUIA TINTAS 000/060 *}
      {*******************************JB*}
      If (Pos(RightStr(arrResCfop[1].strClaFis, 3), '_403_404_405_411') > 0) Then
        fatVenda.strCla060 := RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[1].fltTotVal, ffFixed, 12, 2), 9)
      Else
