function fValidarControleRotasRegioesCidades(fatVenda: TFatVenda): Boolean;
begin
  Result := True;

  If Not fCfgSis('REGCID', varBoolean) Then
    Exit;

  //Se for expedicao entao valida a lista de pedidos
  If fatVenda.blnExpedi And Assigned(fatVenda.objExpedicao) Then
  Begin
    If (VS_strTipExp = TIPEXP_POR_PEDIDO_E_PEDIDO_SERA_FATURADO) Or (VS_strTipExp = TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO) Then
    Begin
      If Not fHorarioDoFaturamentoDaCargaDaRotaOk(fatVenda.objExpedicao.stlPedidos) Then
        Exit(False);
      If Not fDataDoFaturamentoNoDiaDaEntrega(fatVenda.objExpedicao.stlPedidos) Then
        Exit(False);
    End;
  End
  //Se nao for expedicao entao valida pelo numero do pedido
  Else If Not fatVenda.strNumOrc.IsEmpty Then
  Begin
    If Not fHorarioDoFaturamentoDaCargaDaRotaOk(fatVenda.strNumOrc, fatVenda.strEspOrc, fatVenda.strEmpOri) Then
      Exit(False);
    If Not fDataDoFaturamentoNoDiaDaEntrega(fatVenda.strNumOrc, fatVenda.strEspOrc, fatVenda.strEmpOri) Then
      Exit(False);
  End;
end;

function fExistemProdutosComLotesDiferentesParaClienteFilialExpedicao(AParams: TExpedicaoParams): Boolean;
  Var
    strAux: String;
    qryGen : TUniQuery;
    blnTransferenciaEntreEmpresasWMS : boolean;
    strEmpDes : String;
begin
  Result := False;

  If Not Assigned(AParams) Then
    Exit;

  If (fCfgSis('LOTDIF', VarBoolean)) Or (Not fUsaRotinaWMS) Then
    Exit;

  blnTransferenciaEntreEmpresasWMS := false;
  if fClienteFilial(AParams.strCodCli, strEmpDes) then
    blnTransferenciaEntreEmpresasWMS := fUsaRotinaWMS(strEmpDes);

  If not blnTransferenciaEntreEmpresasWMS Then
    Exit;

  If (fCfgSis('TIPEXP') = TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO) And (Not AParams.blnApenasFaturarJaExpedidos) Then
    Exit;

  qryGen := fCriaQuery;
  Try
    AParams.cdsItens.First;
    While (Not AParams.cdsItens.Eof) Do
    Begin
      If (fEmptyStr(AParams.cdsItens.FieldByName('CODACA').AsString)) And
         (fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger)) > 0) Then
      Begin
        strAux := strAux + IIF(strAux.IsEmpty,'',',') + AParams.cdsItens.FieldByName('AUTOINCREM').AsString.QuotedString;
      End;
      AParams.cdsItens.Next;
    End;

    If (Not strAux.IsEmpty) Then
    Begin
      qryGen.SQL.Text :=
          ' SELECT '+
          '   FDO_CODITE, '+
          '   GROUP_CONCAT(DISTINCT LDO_NUMLOT) AS LDO_NUMLOT '+
          ' FROM '+
          '  FATDOR INNER JOIN LOTDOR ON FATDOR.AUTOINCREM=LOTDOR.LDO_SEQFDO '+
          '         INNER JOIN CADITE ON ITE_CODITE = FDO_CODITE ' +
          ' WHERE FATDOR.AUTOINCREM IN ('+strAux+') '+
          '   AND ITE_RASTRE = "S" ' +
          ' GROUP BY FDO_CODITE '+
          ' HAVING COUNT(DISTINCT LDO_NUMLOT) > 1 ';

      strAux := '';
      qryGen.Open;
      If (Not qryGen.IsEmpty) Then
      Begin
        strAux := '';

        qryGen.First;
        While (Not qryGen.Eof) Do
        Begin
          strAux := strAux + qryGen.FieldByName('FDO_CODITE').AsString + ' - ' + qryGen.FieldByName('LDO_NUMLOT').AsString + #10#13;

          qryGen.Next;
        End;
      End;

      If (Not strAux.IsEmpty) Then
      Begin
        fMensagem('Atenção!', 'Não é permitido envolver em uma mesma operação, itens com mesmo código porém com lotes diferentes para cliente filial!' +#10#13+
                              'Limpe a separação do mesmo e redefina os lotes na rotina de separação.' +#10#13+
                              strAux, ['&Ok']);
        Result := True;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
    AParams.cdsItens.First;
  End;
end;

procedure pRetornaQuantidadeExpedidaTotal(AParams: TExpedicaoParams; var fltQtdExp: Double);
begin
  fltQtdExp := 0;
  AParams.cdsItens.First;
  while (not AParams.cdsItens.Eof) do
  begin
    fltQtdExp := fltQtdExp + AParams.cdsItens.FieldByName('QTDEXP').AsFloat;
    AParams.cdsItens.Next;
  end;
end;

procedure pListarPedidosDescontoFinanceiroEmValorExpedicao(AParams: TExpedicaoParams; stlPedVal: TStringList);
var
  intIndice: Integer;
begin
  stlPedVal.Clear;
  stlPedVal.Sorted := True;
  AParams.cdsItens.First;
  While (Not AParams.cdsItens.Eof) Do
  Begin
    if (AParams.cdsItens.FieldByName('DESFIN').AsFloat > 0) and (AParams.cdsItens.FieldByName('TIPFIN').AsString = 'V') and
       (fFormataFloat(AParams.cdsItens.FieldByName('QTDITE').AsFloat, fCfgSis('DECQTD', varInteger)) <> fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger))) and
       (not stlPedVal.Find(AParams.cdsItens.FieldByName('NUMDOC').AsString, intIndice)) then
    begin
      stlPedVal.Add(AParams.cdsItens.FieldByName('NUMDOC').AsString);
    end;
    AParams.cdsItens.Next;
  End;
end;

function fValidarExpedicaoParcial(AParams: TExpedicaoParams): Boolean;
var
  LDocumentos: TStringList;
  LItens: TStringList;
  LWhereDoc: String;
  LWhereIte: String;
  LIndex: Integer;
  LQry: TUniQuery;
  LPedFatTot: String;
  LPedidoTransfGarant: String;
  stlPedVal: TStringList;
  blnFatTot: Boolean;
  fltQtdExp: Double;

  function fEhFatAutDocVenda():Boolean;
  begin
    Result := False;

    If (Not AParams.blnFatAut) then
      Exit;

    If (Not (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA)) Then
      Exit;

    Result := True;
  end;

begin
  Result := True;
  LPedFatTot := EmptyStr;
  AParams.blnExpParcial := False;
  blnFatTot := False;
  stlPedVal := TStringList.Create;
  Try
    pRetornaQuantidadeExpedidaTotal(AParams, fltQtdExp);
    pListarPedidosDescontoFinanceiroEmValorExpedicao(AParams, stlPedVal);

    AParams.cdsItens.First;
    While (Not AParams.cdsItens.Eof) Do
    Begin
      If (fFormataFloat(AParams.cdsItens.FieldByName('QTDITE').AsFloat, fCfgSis('DECQTD', varInteger))  <>
          fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger))) Then
      Begin
        Result := False;
        AParams.blnExpParcial := True;
        blnFatTot := (AParams.cdsItens.FieldByName('FATTOT').AsString = 'S');
        LPedFatTot := LPedFatTot + AParams.cdsItens.FieldByName('NUMDOC').AsString + ', ';
        Break;
      End;

      AParams.cdsItens.Next;
    End;

    if Result then
    begin
      If (fCfgExpedicaoParcialHabilitada) And
         (fCfgSis('FTEXPC', varBoolean))  And
         (Not fEhFatAutDocVenda()) Then
      Begin
        If (AParams.cdsItens.IsEmpty) Then
        Begin
          fMensagem('', 'O documento não está completo! Por favor, verifique.', ['&Ok']);
          Result := False;
          Exit;
        End;

        LDocumentos := TStringList.Create();
        LItens := TStringList.Create();
        try
          AParams.cdsItens.First;
          While (Not AParams.cdsItens.Eof) Do
          Begin
            if LDocumentos.IndexOf(AParams.cdsItens.FieldByName('SEQGER').AsString) = -1 then
              LDocumentos.Add(AParams.cdsItens.FieldByName('SEQGER').AsString);

            LItens.Add(AParams.cdsItens.FieldByName('AUTOINCREM').AsString);

            AParams.cdsItens.Next;
          End;

          for LIndex := 0 to Pred(LDocumentos.Count) do
            LWhereDoc := LWhereDoc + ',' + LDocumentos[LIndex].QuotedString;

          for LIndex := 0 to Pred(LItens.Count) do
            LWhereIte := LWhereIte + ',' + LItens[LIndex].QuotedString;

          Delete(LWhereDoc, 1, 1);
          Delete(LWhereIte, 1, 1);
        finally
          FreeAndNil(LDocumentos);
          FreeAndNil(LItens);
        end;

        LQry := fCriaQuery;
        try
          LQry.SQl.Add('SELECT FGO_NUMDOC,');
          LQry.SQl.Add('       FGO_ESPDOC,');
          LQry.SQl.Add('       FGO_CODEMP,');
          LQry.SQl.Add('       FDO_CODITE,');
          LQry.SQl.Add('       SUM(FDO_QTDITE) AS QTDITE,');
          LQry.SQl.Add('       SUM(FDO_QTDEXP) AS QTDEXP,');
          LQry.SQl.Add('       FGO_FATTOT');
          LQry.SQl.Add('FROM FATDOR');
          LQry.SQl.Add('INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO');
          LQry.SQl.Add('INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FDO_SEQGER');
          LQry.SQl.Add('INNER JOIN EXTGOR ON FATGOR.AUTOINCREM = FGO_SEQFGO');
          LQry.SQl.Add('WHERE FDO_SEQGER IN (' + LWhereDoc + ')');
          LQry.SQl.Add('  AND FATDOR.AUTOINCREM NOT IN (' + LWhereIte + ')');
          LQry.SQl.Add('GROUP BY FGO_NUMDOC, FGO_ESPDOC, FGO_CODEMP, FATDOR.AUTOINCREM');
          LQry.Open;

          while not LQry.Eof do
          begin
            If (fFormataFloat(LQry.FieldByName('QTDITE').AsFloat, 2)  <>
                fFormataFloat(LQry.FieldByName('QTDEXP').AsFloat, 2)) and
               (LQry.FieldByName('FGO_FATTOT').AsString = 'S') Then
            Begin
              Result := False;
              AParams.blnExpParcial := True;
              blnFatTot := (LQry.FieldByName('FGO_FATTOT').AsString = 'S');
              LPedFatTot := LPedFatTot + LQry.FieldByName('FGO_NUMDOC').AsString + ', ';
              Break;
            End;

            LQry.Next;
          end;
        finally
          FreeAndNil(LQry);
        end;
      End;

    end;

    LPedFatTot := Copy(LPedFatTot, 1, Length(LPedFatTot) - 2);

    If (Not Result) Then
    Begin
      If fEhPedidoTransferenciaGarantiaGarMat(AParams.stlPedidos, LPedFatTot, LPedidoTransfGarant) then
      Begin
        fMensagem('', 'O(s) pedido(s) de transferência de garantia (TE) '+LPedidoTransfGarant+' não pode(m) ser expedido(s) parcialmente!', ['&Ok']);
      End
      Else If AParams.blnFaturandoTodosAutomaticamente Then
      Begin
        fMensagem('', 'Faturamento automático de todos os pedidos não permite faturamento parcial!', ['&Ok']);
      End
      Else If (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA) Then
      Begin
        If (Not fCfgExpedicaoParcialHabilitada) Or AParams.blnExpedicaoDocumentoFaturadoAutomaticamente Then
           fMensagem('', 'O documento não está completo! Por favor, verifique.', ['&Ok'])
        Else
        Begin
          Result := (fMensagem('ATENÇÃO!', 'O documento não está completo! Deseja continuar?', ['&Sim', '&Não']) = 1);
          AParams.blnExpPar := Result;
        End;

      End
      Else
      Begin
        If (Not fCfgExpedicaoParcialHabilitada) Or (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA) Or
           (AParams.blnTemRec And Not AParams.blnSimplesRemessaConcreto) Then
        Begin

          If (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA) Then
            fMensagem('', 'O documento não está completo! Por favor, verifique.', ['&Ok'])
          Else
          Begin
            If AParams.blnApenasFaturarJaExpedidos Or (AParams.VS_strTipExpInterna <> TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO) Then
            Begin
              If (AParams.blnTemRec And Not AParams.blnSimplesRemessaConcreto) Then
                fMensagem('', 'O pedido possui duplicatas recebidas, portanto deve ser expedido totalmente.', ['&Ok'])
              Else If AParams.blnBolAdt Then
                fMensagem('', 'O pedido possui boletos de adiantamento, portanto deve ser expedido totalmente.', ['&Ok'])
              Else
                fMensagem('', 'O pedido não está completo! Por favor, verifique.', ['&Ok']);
            End
            Else
              Result := True;
          End;

        End
        Else
        Begin
          If stlPedVal.Count > 0 Then
          Begin
            Result := False;
            fMensagem('', 'Há pedido(s) (' + stlPedVal.CommaText + ') com Desconto Financeiro em Valor e não pode(m) ser faturado(s) parcialmente!', ['&Ok']);
          End

          Else
          Begin
            Result := (fMensagem('ATENÇÃO!', IIF(fltQtdExp=0,'Nenhum item expedido!','O pedido não está completo!')+' Deseja continuar?', ['&Sim', '&Não']) = 1);

            if (fltQtdExp > 0) then
              Result := fPermiteExpedicaoParcial(
                               Result,
                               Format('_%s_%s_', [TIPEXP_POR_PEDIDO_E_PEDIDO_SERA_FATURADO, TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO]),
                              TPedidoVenda(AParams.stlPedidos.Objects[0]).strNumDoc,
                              TPedidoVenda(AParams.stlPedidos.Objects[0]).strEspDoc,
                              TPedidoVenda(AParams.stlPedidos.Objects[0]).strCodEmp);
          End;
        End;
      End;
    End;

    If (fCfgExpedicaoParcialHabilitada) And
       (fCfgSis('FTEXPC', varBoolean)) And
       (not AParams.blnPermiteExpParcial) And
       (Result) And (AParams.blnExpParcial) And (blnFatTot) And (Not fEmptyStr(LPedFatTot)) Then
    Begin
      Result := False;
      fMensagem('ATENÇÃO', 'O(s) Pedido(s) [' + LPedFatTot + '] não permite(m) faturamento parcial. Verifique!', ['&OK']);
    End;

  Finally
    FreeAndNil(stlPedVal);
  End;
end;

function fValidaQuantidadeSeparadaWMSF10(AParams: TExpedicaoParams; var strIteErroSep: String): Boolean;
  var
    blnF10_ExpItens : Boolean;

  function fItemNormalOuItemTintaPassivelValidacaoSeparacao: Boolean;
  begin
    Result := True;

    If (AParams.cdsItens.FieldByName('IDEPRO').AsString <> 'NOR') Then
    Begin
      If (Not fCfgSis('TINWMS', varBoolean)) Then
        Exit(False);

      If (fTipoTinta(AParams.cdsItens.FieldByName('IDEPRO').AsString) <> ttImobiliaria) Then
        Exit(False);
    End
    Else
    Begin
      If (AParams.cdsItens.FieldByName('PROACA').AsString = 'S') Then
        Exit(False);
    End;
  end;

begin
  Result := True;
  AParams.cdsItens.First;
  strIteErroSep := '';

  blnF10_ExpItens := (Not AParams.blnApenasFaturarJaExpedidos);

  If Not blnF10_ExpItens Then
    Exit;

  If (fCfgSis('TIPEXP') <> TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO) Then
    Exit;

  While (Not AParams.cdsItens.Eof) Do
  Begin
    If (fUsaRotinaExpedicaoConferenciaRetiraCaixa) And (AParams.cdsItens.FieldByName('PEGOU_').AsString = 'S') And
       (AParams.cdsItens.FieldByName('FDO_NUMLOT').AsString <> 'A DEFINIR') And (fCfgSis('TIPEXP') = TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO) Then
    Begin
      AParams.cdsItens.Next;
      Continue;
    End;

    If (fItemNormalOuItemTintaPassivelValidacaoSeparacao) And
       (AParams.cdsItens.FieldByName('PEGOU_').AsString <> 'S') And
       (fFormataFloat(AParams.cdsItens.FieldByName(IIF(fCfgSis('EXPQTD', varString) = COMPARAR_QTDSEP_AUTCOM, 'QTDSEP', 'QTDCOL')).AsFloat, fCfgSis('DECQTD', varInteger)) <>
        fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger))) Then
    Begin
      Result := False;

      If Not fEmptyStr(strIteErroSep) Then
            strIteErroSep := strIteErroSep + ', ';

      strIteErroSep := strIteErroSep + AParams.cdsItens.FieldByName('CODITE').AsString+' '+
                       'SEP-'+FloatToStr(fFormataFloat(AParams.cdsItens.FieldByName(IIF(fCfgSis('EXPQTD', varString) = COMPARAR_QTDSEP_AUTCOM, 'QTDSEP', 'QTDCOL')).AsFloat, fCfgSis('DECQTD', varInteger)))+' '+
                       'EXP-'+FloatToStr(fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger)));

    End;

    AParams.cdsItens.Next;
  End;

  AParams.cdsItens.First;
end;

