            IIF(Not fEmptyStr(strNumOrc), VS_strCodEmp, ''));
        End;

        If cdsVenda.FieldByName('ITE_DESMAX').AsFloat <> 0 Then
          fltDesMaxIte := cdsVenda.FieldByName('ITE_DESMAX').AsFloat
        Else
          fltDesMaxIte := fCampoTabela('ITE_DESMAX', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, fGetEmpCalculoItem(strEmpresaItem)], False);

        If (fCfgSis('USAFLE',varBoolean)) Then
        Begin
          If (VS_strTRVEPR = '1') Then
            fAddCalcFlex(IntToStr(cdsVenda.FieldByName('AUTOINCREM').AsInteger),
