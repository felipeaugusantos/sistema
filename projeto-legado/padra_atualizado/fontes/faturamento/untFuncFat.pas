function TFatVenda.fItensComSaldoEmProcessamento(strCodIte: String=''; strEmpIte: String=''): Boolean;
  Var
    item: TDadosFechamento;
    strInformacao: String;
    intQtdLinha: Integer;
begin
  strInformacao := '';
  intQtdLinha := 0;
  Try
    If (fCfgSis('TRVREP', varBoolean)) Then
    Begin
      If (Not Self.fValidarEstoqueNoFinal) Then
      Begin
        If (fEmptyStr(strCodIte+strEmpIte)) Then
        Begin
          For item in Self.arrMatItens Do
          Begin
            If (item.strIdePro = 'NOR') And (fCampoTabela('ITE_REPAUD', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [item.strCodIte, item.strEmpIte]) = 'S') Then
            Begin
              Inc(intQtdLinha);
              pIncrementaListaStr(item.strCodIte+'-'+item.strEmpIte, strInformacao);
            End;
          End;
        End
        Else
        Begin
          If (fCampoTabela('ITE_REPAUD', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, strEmpIte]) = 'S') Then
          Begin
            Inc(intQtdLinha);
            strInformacao := strCodIte+'-'+strEmpIte;
          End;
        End;
      End;
    End;
  Finally
    Result := (Not fEmptyStr(strInformacao));

    If (Result) Then
    Begin
      fMensagem('Atenção!', 'Os produtos a seguir estão aguardando a atualização do saldo reservado '+
                            'e do disponível. Aguarde alguns instantes e depois, tente confirmar novamente! (CFG_TRVREP)' + #10#13 + strInformacao, ['&Ok'],
                            1, False, 1, 0, False, 0, False, False, False, 0, 0, intQtdLinha);
    End;
  End;
end;

