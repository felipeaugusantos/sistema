procedure TFatVenda.pCarregaVariaveisDuplicatas;
  Var
    intParc: Integer;
    strNumD,
    strDtaV: String;
    fltValD: Double;
begin
  // Feito dessa maneira por se tratar de nota fiscal formulário contínuo, vai ficar limitado a 12 parcelas.
  For intParc := 0 To 11 Do
  Begin
    With arrDuplicata[intParc] Do
    Begin

      strNumD := '';
      strDtaV := '';
      fltValD := 0;

      If dtaDtaVen <> '' Then
      Begin
        strNumD := strNumDoc + strSequen;
        strDtaV := dtaDtaVen;
        fltValD := curValor;
      End;

      SetPropValue(Self, 'strNumD' + fPadL(intToStr(Succ(intParc)), 2, '0'), strNumD);
      SetPropValue(Self, 'strDtaV' + fPadL(intToStr(Succ(intParc)), 2, '0'), strDtaV);
      SetPropValue(Self, 'fltValD' + fPadL(intToStr(Succ(intParc)), 2, '0'), fltValD);
    End;

  End;

end;

procedure TFatVenda.pAtribuiValoresServico(intSer: Integer;
                                           strCodSer,
                                           strDesSer,
                                           strIdeSer,
                                           strBrinde,
                                           strCodPar,
                                           strTipBri,
                                           strVenSer,
                                           strVe2Ser: String;
                                           fltQtdSer,
                                           fltUniSer,
                                           fltValSer,
                                           fltCusSer,
                                           fltDecSer: Double);
begin

  If intSer In [1..30] Then
  Begin
    SetPropValue(Self, 'strCodS' + fStrZero(intSer.ToString, 2), strCodSer);
    SetPropValue(Self, 'strDesS' + fStrZero(intSer.ToString, 2), strDesSer);
    SetPropValue(Self, 'strIdeS' + fStrZero(intSer.ToString, 2), strIdeSer);
    SetPropValue(Self, 'fltQtdS' + fStrZero(intSer.ToString, 2), fltQtdSer);
    SetPropValue(Self, 'fltUniS' + fStrZero(intSer.ToString, 2), fltUniSer);
    SetPropValue(Self, 'fltValS' + fStrZero(intSer.ToString, 2), fltValSer);
    SetPropValue(Self, 'fltCusS' + fStrZero(intSer.ToString, 2), fltCusSer);
    SetPropValue(Self, 'fltDecS' + fStrZero(intSer.ToString, 2), fltDecSer);
    SetPropValue(Self, 'strBriS' + fStrZero(intSer.ToString, 2), strBrinde);
    SetPropValue(Self, 'strParS' + fStrZero(intSer.ToString, 2), strCodPar);
    SetPropValue(Self, 'strTBrS' + fStrZero(intSer.ToString, 2), strTipBri);
    SetPropValue(Self, 'strVenS' + fStrZero(intSer.ToString, 2), strVenSer);
    SetPropValue(Self, 'strVe2S' + fStrZero(intSer.ToString, 2), strVe2Ser);
  End
  Else
  Begin
    Self.fltQtdS01 := Self.fltQtdS01 + fltQtdSer;
    Self.fltValS01 := Self.fltValS01 + IIF(fltDecSer <> 0, fltValSer - (fltValSer * (fltDecSer / 100)), fltValSer);

    If Self.fltQtdS01 <> 0.00 Then
      Self.fltUniS01 := Self.fltValS01 / Self.fltQtdS01;
  End;

  Self.fltTotSer := Self.fltTotSer + IIF(fltDecSer <> 0, fltValSer - (fltValSer * (fltDecSer / 100)), fltValSer);
end;

procedure TFatVenda.pAcertaValorServicos;
Var
  fltSerRat: Double;
Begin

  If (fUsaRateioDeServicos) Then
