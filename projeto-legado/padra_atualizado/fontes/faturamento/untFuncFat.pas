function fTravaSubProduto(strCodIte: string=''): Boolean;
begin
  Result := False;

  if not fCfgSis('VESPRO',varBoolean) then
    Exit;

  if fCfgSis('CAREST',varString) <> 'N' then
    Exit;

  if fCfgSis('BXSBIT',varString) <> '1' then
    Exit;

  if not fCfgSis('ORDPRO',varBoolean) then
    Exit;

  if not fEmptyStr(strCodIte) then
  begin
