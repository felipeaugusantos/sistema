  if not (Self.objNfeComplemento.tncTipoNota = tncCreditoICMS) then
    Exit;

  If not (Pos(Self.strClaFis, fTransform(fCfgSis('CLAIMO'), 4)) > 0) Then
    Exit;

  Result := True;
end;

function TFatVenda.fTemItemRequisicaoCompraDesmembramento: Boolean;
var
  intContador,
  intIndex: Integer;
  objItensEstrutura: TItensEstrutura;
  objItem: TDadosFechamento;
  objSubItem: TSubItemEstrutura;

  function fExisteItemMovRcd(Const strCodIte, strEmpIte: String):Boolean;
  begin
    Result := cdsMovRcd.Locate('RCD_CODITE;RCD_EMPITE',VarArrayOf([strCodIte, strEmpIte]),[]);
  end;
begin
  Result := False;

  if not cdsMovRcd.Active then
    Exit;

  if cdsMovRcd.IsEmpty then
    Exit;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  begin
    objItem := arrMatItens[intContador];

    If fEhItemEstruturaBaixandoEstoqueDosSubProdutos(objItem) Then
    Begin
      objItensEstrutura := TItensEstrutura.Create;
      Try
        objItensEstrutura.pCarregarEstrutura(objItem.strCodIte, objItem.fltQtdIte);
        For intIndex := 0 To PRed(objItensEstrutura.ItemsCount) Do
        Begin
          objSubItem := objItensEstrutura[intIndex];

          If (fExisteItemMovRcd(objSubItem.strCodigo, objItem.strEmpIte)) Then
          Begin
            Result := True;
            Break;
          End;
        End;
      Finally
        FreeAndNil(objItensEstrutura);
      End;

      If Result Then
        Break;
    End
    Else
    Begin
      If (fExisteItemMovRcd(objItem.strCodIte, objItem.strEmpIte)) Then
      Begin
        Result := True;
        Break;
      End;
    End;
  End;
end;

function TFatVenda.fPedidoJaFaturado: Boolean;
var
  strNumFat: string;
  strMensagem: string;
  frmObservacao: TfrmObservacao;
begin
  if (strOpcDoc <> 'PD') Or (fEmptyStr(strNumOrc)) Then
    Exit(False);

  strNumFat := fCampoTabela('CONCAT(FGO_NUMFAT, "-", FGO_TIPFAT, "-", FGO_EMPFAT)',
    'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP', 'FGO_JAFATU'], [strNumOrc, 'PD', strEmpDoc, 1]);

  Result := Not fEmptyStr(strNumFat);

  if Result then
  begin
    strMensagem := 'Ocorreu um problema de integridade com este Pedido de Venda '+strNumFat+'' + sLineBreak +
                   'Ele foi faturado por outro operador enquanto a alteração está ocorrendo aqui.' + sLineBreak +
                   'Isso somente é causado quando LCKATC é liberado por usuário administrador.' + sLineBreak +
                   'Não será possivel finalizar esta operação.' + sLineBreak +
                   'É preciso sair totalmente do pedido sem gravar as informações.';

    pCriarFormularios(TfrmObservacao, frmObservacao);

    try
      frmObservacao.Width := 630;
      frmObservacao.memObs.CharCase := ecNormal;
      frmObservacao.Caption := 'Pedido já faturado';
      frmObservacao.lblMensagem.Caption := 'Pedido já faturado';
      frmObservacao.memObs.Clear;
      frmObservacao.memObs.Lines.Add(strMensagem);
      frmObservacao.ShowModal;
    finally
      pFreeAndNil(frmObservacao);
    end;
  end;

end;

procedure TFatVenda.pGravarNesTin;
var
  qryInsert   : TUniQuery;
  qryDados    : TUniQuery;
  strTipoItem : String;
begin
  if (not fTabelaExiste('NESTIN', True)) or
     (opcItensNFespTinta = opcVazio) then
    Exit;

  qryDados  := fCriaQuery(Nil);
  qryInsert := fCriaQuery(Nil);
  try
    case opcItensNFespTinta of
      opcProdutoAcabado : strTipoItem := 'A';
    else
      strTipoItem := 'B';
    end;

    qryInsert.Close;
    qryInsert.SQL.Text := 'SELECT * FROM NESTIN '
                        + ' WHERE FALSE ';
    qryInsert.Open;

    qryDados.Close;
    qryDados.SQL.Text := 'SELECT * FROM NOTDET '
                       + ' WHERE DET_NUMDOC = :NUMDOC '
                       + '   AND DET_ESPDOC = :ESPDOC '
                       + '   AND DET_CODEMP = :CODEMP ';
    qryDados.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDados.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDados.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDados.Open;

    qryDados.First;
    while not qryDados.Eof do
    begin
      qryInsert.Insert;
      qryInsert.FieldByName('AUTOINCREM').AsString   := fRetAutoIncrem('NESTIN', VS_strCodEmp);
      qryInsert.FieldByName('TIN_SEQDET').AsString   := qryDados.FieldByName('AUTOINCREM').AsString;
      qryInsert.FieldByName('TIN_CODEMP').AsString   := qryDados.FieldByName('DET_CODEMP').AsString;
      qryInsert.FieldByName('TIN_NUMDOC').AsString   := qryDados.FieldByName('DET_NUMDOC').AsString;
      qryInsert.FieldByName('TIN_ESPDOC').AsString   := qryDados.FieldByName('DET_ESPDOC').AsString;
      qryInsert.FieldByName('TIN_DTAENT').AsDateTime := dtaDtaIniNestin;
      qryInsert.FieldByName('TIN_TIPITE').AsString   := strTipoItem;
      qryInsert.Post;

      qryDados.Next;
    end;
  finally
    FreeAndNil(qryDados);
    FreeAndNil(qryInsert);
  end;
end;

procedure TFatVenda.SetOpcNesTinSel(const Value: TOpcItensNFespTinta);
begin
  opcItensNFespTinta := Value;
end;

