function TFatVenda.fPedidoTotalmenteDevolvido(strNumPD, strEmpPD: String): Boolean;
  Var
    objGetSQLStatus: TGetSQLStatus;
    qryStatus: TUniQuery;
begin
  Result := False;
  objGetSQLStatus := TGetSQLStatus.Create;
  qryStatus := fCriaQuery;

  Try
    Try
      qryStatus.Close;
      qryStatus.SQL.Clear;
      qryStatus.SQL.Text := objGetSQLStatus.sqlFaturadoDevTotal;
      qryStatus.ParamByName('NUMDOC').AsString := strNumPD;
      qryStatus.ParamByName('ESPDOC').AsString := 'PD';
      qryStatus.ParamByName('CODEMP').AsString := strEmpPD;
