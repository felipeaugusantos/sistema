    Result := IIF(fEmptyStr(Result), '', Result + '-') + qryFatGor.FieldByName('FGO_OBSL02').AsString;

  If Not fEmptyStr(qryFatGor.FieldByName('FGO_OBSLC1').AsString) Then
    Result := IIF(fEmptyStr(Result), '', Result + '-') + qryFatGor.FieldByName('FGO_OBSLC1').AsString;

  If Not fEmptyStr(qryFatGor.FieldByName('FGO_OBSLC2').AsString) Then
    Result := IIF(fEmptyStr(Result), '', Result + '-') + qryFatGor.FieldByName('FGO_OBSLC2').AsString;
end;

procedure TFatVenda.pAddPedidoHistCadRec(qryFatGor: TUniQuery);
  Var
    strNumDoc : String;
    strEspDoc : String;
    strCodEmp : String;
begin
  strNumDoc := qryFatGor.FieldByName('FGO_NUMDOC').AsString;
  strEspDoc := qryFatGor.FieldByName('FGO_ESPDOC').AsString;
  strCodEmp := qryFatGor.FieldByName('FGO_CODEMP').AsString;

  if strPedidoHistCadRec.Contains(strNumDoc + '-' + strEspDoc + '-' + strCodEmp) then
    Exit;

  if (not fEmptyStr(strPedidoHistCadRec)) then
    strPedidoHistCadRec := strPedidoHistCadRec + ' / ';

  strPedidoHistCadRec := strPedidoHistCadRec +
                           strNumDoc + '-' +
                           strEspDoc + '-' +
                           strCodEmp;

  If fCfgSis('GROBCR', varBoolean) Then
  Begin
    strPedidoHistCadRec := strPedidoHistCadRec + '-' +
                            fObservacoesLiberacaoPedido(qryFatGor);
  End;
end;

function TFatVenda.fValidarEstoqueAoCarregarPedido: Boolean;
begin
  Result := False;

  If (Not Self.blnVerEstOrc) Then
    Exit;

  If (Self.strOriF11 = 'S') And (fCfgSis('SLD_RC', varString) = 'N') Then
    Exit;

  If (fCfgSis('TRAEST', varString) = '2') And (Self.strOriF11 <> 'S') Then
    Exit;

  If (Self.blnAplicouFatorServico) Then
    Exit;

  Result := True;
end;

procedure TFatVenda.pCarregaPedidoOrcamento(qryFatGor: TUniQuery;
