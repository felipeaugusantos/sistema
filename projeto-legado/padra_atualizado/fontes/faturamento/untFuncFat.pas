function TFatVenda.fTemItensRetira(filtroEmpresa: TFiltroEmpresa = opTodasEmpresas;
  filtroLocal: TFiltroLocalRetira = opLocalRetiraTodas): Boolean;
  Var
    strEmpresaLogada: String;
    cdsDados: TUniClientDataSet;
    stlLogErros: TStringList;
    intContador: Integer;
Begin
  Result := False;

  stlLogErros := TStringList.Create;

  strEmpresaLogada := IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog);
  cdsDados := TUniClientDataSet.Create(Self);
  Try
    Try
      pCloneDataSet(cdsDados, cdsVenda);

      cdsDados.Filtered := False;
      cdsDados.Filter := cdsVenda.Filter;

      If Not fEmptyStr(cdsDados.Filter) Then
        cdsDados.Filter := cdsDados.Filter + ' AND ';

      cdsDados.Filter := cdsDados.Filter  + fGetFiltroRetira;

      If filtroEmpresa = opOutraEmpresa Then
        cdsDados.Filter := cdsDados.Filter + ' AND ITE_EMPITE <> ' + QuotedStr(strEmpresaLogada);

      If filtroEmpresa = opPropriaEmpresa Then
        cdsDados.Filter := cdsDados.Filter + ' AND ITE_EMPITE = ' + QuotedStr(strEmpresaLogada);

      If filtroLocal = opLocalRetiraCaixa Then
        cdsDados.Filter := cdsDados.Filter + ' AND ITE_LOCRET = ' + QuotedStr('C');

      If filtroLocal = opLocalRetiraExpedicao Then
        cdsDados.Filter := cdsDados.Filter + ' AND ITE_LOCRET = ' + QuotedStr('E');

      If filtroLocal = opLocalRetiraBalcao Then
        cdsDados.Filter := cdsDados.Filter + ' AND ITE_LOCRET = ' + QuotedStr('B');

      If filtroLocal = opLocalRetiraBalcao2 Then
        cdsDados.Filter := cdsDados.Filter + ' AND ITE_LOCRET = ' + QuotedStr('B2');

      cdsDados.Filter := cdsDados.Filter + ' AND (ITE_CODITE <> ('+fQuotedStr(fCfgSis('SERTER'))+')) '+
                                           ' AND (ITE_CODITE <> ('+fQuotedStr(fCfgSis('ITESER'))+')) ';

      stlLogErros.Add('cdsDados.Filter = ' + cdsDados.Filter);

      stlLogErros.Add('cdsDados.AggregatesActive = ' + IIF(cdsDados.AggregatesActive, 'True','False'));

      For intContador := 0 To cdsDados.AggFields.Count -1 Do
      Begin
        stlLogErros.Add('AggregateField.FieldName  = '+ TAggregateField( cdsDados.AggFields.Fields[intContador] ).FieldName);
        stlLogErros.Add('AggregateField.Expression = '+ TAggregateField( cdsDados.AggFields.Fields[intContador] ).Expression);
      End;

      cdsDados.Filtered := True;

      Result := Not cdsDados.IsEmpty;

      If filtroEmpresa = opOutraEmpresa Then
        Result := Result And fCfgSis('EMPFAT', VarBoolean, strEmpresaLogada);

    Except
      On E: Exception Do
      Begin
        {*** Req: 275446 - Operation cannot mix aggregate value with record-varying value. ***}
        stlLogErros.Add('Mensagem de erro: ' + E.message);
        stlLogErros.SaveToFile('Erro_fTemItensRetira.txt');
        pMensagensErro(E.Message,'[TFatVenda.fTemItensRetira]')
      End;
    End;
  Finally
    FreeAndNil(stlLogErros);
    FreeAndNil(cdsDados);
  End;
end;

procedure TFatVenda.pApagaItensEntFutN;
  Var
    prcScroll: TprcScroll;
Begin
  Try
    With cdsVenda Do
    Begin
      pDisableControls(cdsVenda, prcScroll);

      First;

      While Not Eof Do
      Begin
        If FieldByName('ITE_ENTFUT').AsString = 'N' Then
          Delete
        Else
          Next;
      End;

    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message,'');
  End;

  cdsVenda.EnableControls;
  pEnableControls(cdsVenda, prcScroll);
End;

function TFatVenda.fRetTotRev: Double;
  Var
    intContador: Integer;
Begin

  Result := 0;

  For intContador := 0 To Length(arrMatItens)-1 Do
  Begin
    If (fItemRevInd(arrMatItens[intcontador].strCodIte, arrMatItens[intContador].strEmpIte) = 'R') And
       (Pos(arrMatItens[intcontador].strCodFis, CST_SUBSTITUICAO) <= 0) Then
      Result := Result + (arrMatItens[intcontador].fltTotIte - arrMatItens[intcontador].fltDesEsp);
  End;

End;

