function TFatVenda.fDadosClienteNFe(var stlValidacoes: TStringList): Boolean;
Var
  strEndCliTmp: String;
  strEndEntTmp: String;
  strBaiEntTmp: String;
  strRefereTmp: String;
  objDadosNFe : TValidacaoDadosNFe;
Begin
  strEndCliTmp := fCampoTabela('CLI_ENDERE', 'CADCLI', ['CLI_CODCLI'], [strCodCli]);

  If ((Not fClienteConsumidor(fRetNomCliente(strCodCli), True, True))) And
     (Assigned(objEndEnt))                                             And
     (Not fEmptyStr(objEndEnt.recEndere.strEndEnt))                    Then
  Begin
    strEndEntTmp := Trim(objEndEnt.recEndere.strEndEnt);
    strBaiEntTmp := Trim(objEndEnt.recEndere.strBaiEnt);
    strRefereTmp := Trim(objEndEnt.recEndere.strRefEnt);
  End
  Else
  Begin
    If fClienteConsumidor(fRetNomCliente(strCodCli), True, True) Then
    Begin
      strEndCliTmp := Trim(strCliEnd);
      strEndEntTmp := Trim(strCliEnd);
    End
    Else
      strEndEntTmp := Trim(strEndCliTmp);

    strBaiEntTmp := Trim(strCliBai);
  End;

  objDadosNFe := TValidacaoDadosNFe.Create(Nil);
  Try
    objDadosNFe.strEndere  := Trim(strEndCliTmp);
    objDadosNFe.strBairro  := Trim(strCliBai);
    objDadosNFe.strEndEnt  := Trim(strEndEntTmp);
    objDadosNFe.strBaiEnt  := Trim(strBaiEntTmp);
    objDadosNFe.strEmaNfe  := Trim(strCliEma);
    objDadosNFe.strRefere  := Trim(strRefereTmp);
    objDadosNFe.strEspDoc  := strEspDoc;
    objDadosNFe.ovOrigem   := ovFaturamento;
    objDadosNFe.blnCliCons := fClienteConsumidor(fRetNomCliente(strCodCli), True, True);
    objDadosNFe.blnSomenteItensRetira := (fCfgSis('ENDRET', varString) = 'N') And
                                         (Not fTemItensEntrega) And
                                         fTemItensRetira;

    Result := fValidaDadosClienteNFe(objDadosNFe);

    stlValidacoes := TStringList.Create;

    If objDadosNFe.stlMensagens.Count > 0 Then
      stlValidacoes.Add(objDadosNFe.stlMensagens.Text);
  Finally
    FreeAndNil(objDadosNFe);
  End;
End;

function TfatVenda.fDadosCorretosParaClienteConsumidor(strEspDocSel: String): Boolean;
begin
