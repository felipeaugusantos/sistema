procedure pCarregaQueryEmpresa(Var qryCadEmp : TUniQuery);
  Var
    strSQL: String;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  CADEMP.*, ';
  strSQL := strSQL + '  CADCID.CID_CODCID AS EMP_CODCID, ';
  strSQL := strSQL + '  CADCID.CID_NOMCID AS EMP_NOMCID, ';
  strSQL := strSQL + '  CADCID.CID_ESTADO AS EMP_ESTADO ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADEMP, ';
  strSQL := strSQL + '  CADCID ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  EMP_CODCID = CID_CODCID AND ';
  strSQL := strSQL + '  EMP_CODEMP = :CODEMP ';

  With qryCadEmp Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;
  End;
end;

