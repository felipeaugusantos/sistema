    If (fFormataFloat(arrDupl[intCnt].curValor, 2) > 0) Then
    Begin
      SetLength(arrValDuplicCarrPedido, Length(arrValDuplicCarrPedido) + 1);
      arrValDuplicCarrPedido[ Length(arrValDuplicCarrPedido)-1 ] := arrDupl[intCnt].curValor;
    End;
  End;
end;

