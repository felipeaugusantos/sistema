procedure TFatVenda.pGravaMovimentoNumSer(strCodIte, strCodEmp, strNumDoc, strAutInc: string);
var
  qryNumSer: TUniQuery;
  strSQL: string;
begin
  try
    if fEmptyStr(strNumDoc) then
    begin
      strNumDoc := strOpcDoc;
    end;

    strSQL := '';
    strSQL := strSQL + 'SELECT SER_NUMSER FROM PROSER ';
    strSQL := strSQL + 'WHERE SER_CODITE = :CODITE ';
    strSQL := strSQL + 'AND SER_CODEMP = :CODEMP ';
    strSQL := strSQL + 'AND SER_NUMDOC = :NUMDOC ';

    qryNumSer := fCriaQuery(nil);
    qryNumSer.Close;
    qryNumSer.SQL.Clear;
    qryNumSer.SQL.Add(strSQL);
    qryNumSer.ParamByName('CODITE').AsString := strCodIte;
    qryNumSer.ParamByName('CODEMP').AsString := strCodEmp;
    qryNumSer.ParamByName('NUMDOC').AsString := strNumDoc;
    qryNumSer.Open;

    while not qryNumSer.Eof do
    begin
      pGravaDetSer(strAutInc, qryNumSer.FieldByName('SER_NUMSER').AsString, strCodEmp);
      pDeletaProser(strCodIte, strCodEmp, strNumDoc, qryNumSer.FieldByName('SER_NUMSER').AsString);
      qryNumSer.Next;
    end;

  finally
    FreeAndNil(qryNumSer);
  end;
end;

procedure TFatVenda.pGravaMovimentoNumSerMod2(strAutInc: String; item: TDadosFechamento);
  Var
    recDadosSerie: TDadosSerie;
begin
  For recDadosSerie In item.arrSeriesItem Do
  Begin
    If Not fEmptyStr(recDadosSerie.strNumSer) And (recDadosSerie.fltQtdSer > 0) Then
    Begin
      pGravaDetSer(strAutInc, recDadosSerie.strNumSer, VS_strCodEmp);
      pDeletaProser(item.strCodIte, VS_strCodEmp, '', recDadosSerie.strNumSer);
    End;
  End;
end;

