function TFatVenda.fRetDescontoFinanceiroItem: Double;
  Var
    intContador,
    intPosIte: Integer;
    stlLisPed: TStringList;
Begin
  Result := 0;

  stlLisPed := TStringList.Create;
  stlLisPed.Clear;
  stlLisPed.Sorted := True;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin

    If arrMatItens[intContador].strTipFin = 'P' Then
    Begin

      Result := Result + RoundTo((arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp) * arrMatItens[intContador].fltDesFin / 100, -2);

    End

    Else If (arrMatItens[intContador].fltDesFin > 0) And
            (Not stlLisPed.Find(arrMatItens[intContador].strNumOrc + arrMatItens[intContador].strEmpOrc, intPosIte)) Then
    Begin

      stlLisPed.Add(arrMatItens[intContador].strNumOrc + arrMatItens[intContador].strEmpOrc);

      Result := Result + arrMatItens[intContador].fltDesFin;

    End;

  End;

  stlLisPed.Clear;
  FreeAndNil(stlLisPed);
End;

function TFatVenda.fRetDevolucaoQuantidadeTotal(strNumDoc, strEspDoc, strCodEmp,
  strCodAca, strEmpAca: String): Double;
    Var
      qryDev: TUniQuery;
      strSQL: String;
begin
  Try
    qryDev := fCriaQuery;
    With qryDev, SQL Do
    Begin
      Add('SELECT');
      Add('  DET_QTDITE');
      Add('FROM');
      Add('  MOVDET');
      Add('WHERE');
      Add('  DET_NUMDOC = :NUMDOC AND');
      Add('  DET_ESPDOC = :ESPDOC AND');
      Add('  DET_CODEMP = :CODEMP AND');
      Add('  DET_CODACA = :CODACA AND');
      Add('  DET_EMPACA = :EMPACA AND');
      Add('  DET_PROEMB <> "S" ');

      strSQL := Text;
      Add('UNION ALL');
      Add(AnsiReplaceStr(strSQL, 'MOVDET', 'NOTDET'));

      strSQL := Text;

      Close;
      Clear;
      Add('SELECT');
      Add('  SUM(DET_QTDITE) AS QTDITE');
      Add('FROM');
      Add('  (' + strSQL +') TAB');

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODACA').AsString := strCodAca;
      ParamByName('EMPACA').AsString := strEmpAca;

      Open;

      Result := FieldByName('QTDITE').AsFloat;
    End;
  Finally
    FreeAndNil(qryDev);
  End;
end;

