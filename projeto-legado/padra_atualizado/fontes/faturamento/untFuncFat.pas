              strNumCmp := strNumCmp + ', ' + arrMatItens[intContador].strNumCmp;
          End;
        End;

        arrMatItens[intContador].stlDetMls := Nil;

        {**************************************************************}
        {* VERIFICA SE EXISTE ALGUM ITEM COM CST 000, 060, 030 OU 040 *}
        {* SE HOUVER SETA AS VARIAVEIS PARA TRUE PARA                 *}
        {* IMPRIMIR A MENSAGEM NA CNF_NFE                             *}
        {************************************************************FC}
        If (arrMatItens[intContador].strCodFis = '000') Then
          blnMsg000 := True;

        If (arrMatItens[intContador].strCodFis = '030') Then
          blnMsg030 := True;

        If (arrMatItens[intContador].strCodFis = '040') Then
          blnMsg040 := True;

        If (arrMatItens[intContador].strCodFis = '060') Then
        Begin
          blnMsg060 := True;
          fltBasIcm060 := fltBasIcm060 + arrMatItens[intContador].fltBasIcm;
          fltValIcm060 := fltValIcm060 + arrMatItens[intContador].fltValIcm;
        End;

        If (arrMatItens[intContador].strCodFis = '010') Then
        Begin
          blnMsg010 := True;
          fltBasIcm010 := fltBasIcm010 + arrMatItens[intContador].fltBasIcm;
          fltValIcm010 := fltValIcm010 + arrMatItens[intContador].fltValIcm;
        End;

        {**************************************************}
        {* MONTA O RESUMO DA TOTALIZAÇÃO DO VALOR POR     *}
        {* CFOP SE CASO HOUVER MAIS DE UMA CFOP DIFERENTE *}
        {* NA NOTA PARA IMPRIMIR NO CNF_NFE               *}
        {***********************************************FC*}
        If cdsResTotCfop.Locate('CFOP', arrMatItens[intContador].strClaFis, []) Then
        Begin
          cdsResTotCfop.Edit;
          cdsResTotCfop.FieldByName('VALOR').AsFloat := cdsResTotCfop.FieldByName('VALOR').AsFloat +
                                                        (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp);
        End
        Else
        Begin
          cdsResTotCfop.Append;
          cdsResTotCfop.FieldByName('CFOP').AsString  := arrMatItens[intContador].strClaFis;
          cdsResTotCfop.FieldByName('VALOR').AsFloat := (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp);
        End;

        cdsResTotCfop.Post;
      End;

      cdsResTotCfop.First;
      While Not cdsResTotCfop.Eof Do
      Begin
        strResTotCfop := strResTotCfop + cdsResTotCfop.FieldByName('CFOP').AsString +
                         ' - R$' + FormatFloat('#,##0.00', cdsResTotCfop.FieldByName('VALOR').AsFloat) + fReplicatorStr(' ', 5);

        cdsResTotCfop.Next;
      End;

      FreeAndNil(cdsResTotCfop);

      {*************************************************}
      {* SALVA O VALOR NA CSHBCK DO CASHBACK UTILIZADO *}
      {***********************************************BL}
      if (blnSalGry) and
         (fCfgSis('USAGRY') = 'S') then
      begin
        objGryncash := TGryncash.Create(Self);
        try
          if not objGryncash.fSalvaCashBack(VS_strCodEmp,
                                            IIF((not fEmptyStr(strNumOrc)), strEspOrc, strEspDoc),
                                            IIF((not fEmptyStr(strNumOrc)), strNumOrc, strNumDoc),
                                            fltCshGry) then
          begin
            fCancelaTransac;
            Result := False;
            Exit;
          end;
        finally
          FreeAndNil(objGryncash);
        end;
      end;

      {*****************************************}
      {* NF - Nota Fiscal                      *}
      {**************************************MV*}
      If Pos(strEspDoc, 'NF_EL_NS_') > 0 Then
      Begin
        If (Not fEmptyStr(strCodCnd)) And
           (fCfgSis('ALPKNK', varBoolean)) And
           (Pos(strCodCnd, fCfgSis('CNDBOL', varString)) > 0) then
        Begin
          If Not fTemLimiteDisponivelBoletoAlpe then
          Begin
            fCancelaTransac;
            fMensagem('','Cliente não possui limite Alpe suficiente!',['&OK']);
            Result := False;
            Exit;
          End;
        End;

        If strEspDoc = 'NF' Then
          pCarregaConfImpr(qryCfgRel, strNomeForm + '_NOTA')
        Else
          pCarregaConfImpr(qryCfgRel, strNomeForm + '_NOTASERVICO');

        strNomImp := qryCfgRel.FieldByName('REL_NOMFIL').AsString;

        {*******************************************}
        {* NÃO VERIFICAR CONFIGURAÇÃO DE IMPRESSÃO *}
        {****************************************PH*}
        If ((Not fCfgSis('NFEUSA', varBoolean)) Or (strEspDoc = 'NS')) Then
        Begin
          If (Not blnGerNFE) And Not ((fCfgSis('NFESER', varBoolean)) And (strEspDoc = 'NS')) And (Not blnEspelhoDevolucaoCliente) Then
          Begin
            If (Not fVerificaImpressora(strNomImp)) Then
            Begin
              fCancelaTransac;
              fMensagem('','Impressora de nota configurada incorretamente!',['&OK']);
              Result := False;
              Exit;
            End;
          End;
        End;

        {*****************************************}
        {* SE NÃO FOR TESTE DE NOTA FISCAL       *}
        {**************************************MV*}
        If (Not blnLibCnf) Then
        Begin

          {*****************************************}
          {* SE FOR CONFIRMAÇÃO DE DOCUMENTOS      *}
          {**************************************MV*}
          If (Pos(strOpcDoc, 'CF_CI_CT_FC_') > 0) Then
          Begin

            If Not (Pos(strOpcDoc, 'FC_') > 0) Then
            Begin
              pInfoStatusGravacao('Aguarde... Confirmando Documentos');

              // Marcar registros como ja faturados (confirmação)
              If (Not fFaturarDocumentos(strOpcDoc)) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;

              pStepStatusGravacao;
            End;

            pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

            {*****************************************}
            {* GRAVA NOTGER                          *}
            {**************************************MV*}
            If strOpcDoc = 'FC' Then
            Begin
              If (Not fGMovGer) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;
            End
            Else
            Begin
              If (Not fGNotGer) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;
            End;

            pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
            pStepStatusGravacao;

            {*****************************************}
            {* GRAVA NOTDET                          *}
            {**************************************MV*}
            If strOpcDoc = 'FC' Then
            Begin
              If (Not fGMovDet) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;
            End
            Else
            Begin
              If (Not fGNotDet) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;
            End;

            pStepStatusGravacao;
            pStepStatusGravacao;

            If (strOpcDoc = 'CF') And (fCfgSis('TCOPRO') = '2') And (fCfgSis('PREFEC',varBoolean)) Then
            Begin
              pInfoStatusGravacao('Aguarde... Calculando Comissão Profissional');

              If (Not fGComProDifCtr) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;

              pStepStatusGravacao;
            End;
          End
          Else
          Begin

            //Prestcon
            If (strOpcDoc = 'CN') Then
            Begin

              pInfoStatusGravacao('Aguarde... Confirmando Notas de Remessa de Concreto');

              If (Not fFaturarDocumentos(strOpcDoc)) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;

              {***************************************************************************}
              {* QUANDO FOR CONFIRMACAO DE NOTA DE CONCRETO DA SECOL, DEVE VERIFICAR SE  *}
              {* O PEDIDO DE VENDA POSSUI CONTAS A RECEBER EM ABERTO E APAGAR OS MESMOS  *}
              {************************************************************************JC*}
              If (fCfgSis('TPNFCR') = SECOL) And
                 (Not fEmptyStr(qryTemporariaConfirmacao.FieldByName('TMP_NUM_PD').AsString)) Then
              Begin
                pDeletaCadRec(qryTemporariaConfirmacao.FieldByName('TMP_NUM_PD').AsString,
                              qryTemporariaConfirmacao.FieldByName('TMP_ESP_PD').AsString,
                              qryTemporariaConfirmacao.FieldByName('TMP_EMP_PD').AsString,
                              '');
              End;

            End;

            {******************************************}
            {* SE NÃO FOR NOTA DE COMPLEMENTO DE ICMS *}
            {***************************************MV*}
            If (strOpcDoc <> 'NC') Then
            Begin

              {*****************************************}
              {* SE FOR NOTA ESPECIAL                  *}
              {**************************************MV*}
              If (blnNotEsp) Or (blnMeiaNota)  Then
              Begin
                pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

                If (Not fGNotGer) Then
                Begin
                  fCancelaTransac;
                  Result := False;
                  Exit;
                End;

                pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
                pStepStatusGravacao;

                If (Not fGNotDet) Then
                Begin
                  fCancelaTransac;
                  Result := False;
                  Exit;
                End;

                If ((strEspDoc = 'NF') and blnTranferenciaDepositoFechado) And (fRetornaClienteFilial(VS_strCodEmp) <> strCodCli) Then
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Pedido de Compra para Transferência');

                  If (Not fGPedCompraTransferencia) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;
                End;
                {********************************************************************}
                {* QUANDO FOR CONFIRMACAO DE AJUSTE DE ESTOQUE COM CLIENTE FILIAL   *}
                {* SERA GERADO UM PEDIDO DE COMPRA NA EMPRESA FILIAL PARA QUE POSSA *}
                {* DAR ENTRADA NO ESTOQUE (IGUAL A TRANSFERENCIA DE ESTOQUE).       *}
                {* OBS: ALTERACAO REALIZADA PARA MATIZ 18/02/2014                   *}
                {*****************************************************************RN*}
                If (blnCliFil) And (strOpcDoc = 'CA') And
                   ((fRetornaClienteFilial(VS_strCodEmp) <> strCodCli)) And (strClaFis > '5000') Then
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Pedido Transferência');

                  {********************************}
                  {* GRAVA PEDIDO DE COMPRA       *}
                  {*****************************LB*}
                  If (Not fGPedCompraTransferencia) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;
                End;

                pStepStatusGravacao;
                pStepStatusGravacao;
                pStepStatusGravacao;
              End
              Else
              Begin
                If (Pos(strOpcDoc,'DV_') > 0) And (blnEspelhoDevolucaoCliente) Then
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-ES');
                  pStepStatusGravacao;

                  {*****************************************}
                  {* GRAVA ESPGER                          *}
                  {**************************************MV*}
                  If (Not fGEspGer) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                  pGravaChaveReferenciadaEspelho(strAutInc);

                  pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
                  pStepStatusGravacao;

                  {*****************************************}
                  {* GRAVA ESPDET                          *}
                  {**************************************MV*}
                  If (Not fGEspDet) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                End
                Else If (Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') And (not blnConfirmacaoEspelho) Then
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-ES');
                  pStepStatusGravacao;

                  {*****************************************}
                  {* GRAVA ESPGER                          *}
                  {**************************************MV*}
                  If (Not fGEspGer) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                  pGravaChaveReferenciadaEspelho(strAutInc);

                  pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
                  pStepStatusGravacao;

                  {*****************************************}
                  {* GRAVA ESPDET                          *}
                  {**************************************MV*}
                  If (Not fGEspDet) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                End
                Else
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Tinta de Máquina');

                  {*****************************************}
                  {* GRAVA TINGER E TINDET                 *}
                  {**************************************MV*}
                  If (VS_strUsaTmq = 'S') Then
                  Begin
                    pInfoStatusGravacao('Aguarde... Gravando Tinta de Máquina');

                    If (Not fGArqTin()) Then
                    Begin
                      fCancelaTransac;
                      Result := False;
                      Exit;
                    End;
                  End;

                  pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);
                  pStepStatusGravacao;

                  {***********************************}
                  {* GRAVA PEDIDO DE COMPRA PARA     *}
                  {* ENVIO DE GARANTIA P/ FORNECEDOR *}
                  {********************************MM*}
                  If {(fCfgSis('GARMAT',varBoolean)) And} (strOpcDoc = 'GF') Then
                  begin

                    if ( not fFinalizaGarantiaNoEnvio(enuTipoEnvioFornecedorGarantia)  ) then
                    begin

                      pInfoStatusGravacao('Aguarde... Gravando Pedido de Compra para Envio de Garantia');

                      If (Not fGPedCompraTransferencia) Then
                      Begin
                        fCancelaTransac;
                        Result := False;
                        Exit;
                      End;

                      pStepStatusGravacao;
                    end;

                  end;

                  {*****************************************}
                  {* GRAVA MOVGER                          *}
                  {**************************************MV*}
                  If (Not fGMovGer) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                  pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
                  pStepStatusGravacao;

                  {*****************************************}
                  {* GRAVA MOVDET                          *}
                  {**************************************MV*}
                  If (Not fGMovDet) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                  pStepStatusGravacao;

                  If (strOpcDocTrue = 'OF') And Assigned(fLiberaReservaDeEstoqueDevolucaoWMS) Then
                  Begin
                    If not(fLiberaReservaDeEstoqueDevolucaoWMS(strAutInc)) Then
                    Begin
                      fCancelaTransac;
                      Result := False;
                      Exit;
                    End;

                  End;

                  If Assigned(fBaixaEspelho) Then
                  Begin
                    If not (fBaixaEspelho) Then
                    Begin
                      fCancelaTransac;
                      Result := False;
                      Exit;
                    End;

                  End;

                  {********************************}
                  {* GRAVA PEDIDO DE COMPRA PARA  *}
                  {* NOTA DE TRANSFERENCIA        *}
                  {*****************************LB*}
                  If (Not blnCliFil) And
                     (blnForFil) And
                     (Pos(strOpcDoc, 'UC_NP_OE_') <= 0) And
                     (fRetornaClienteFilial(VS_strCodEmp, 'F') <> strCodCli) And
                     (Pos(strCodCli, fRetForFilialTodos) > 0)  Then
                  Begin
                    blnCliFil := True;
                    strCodForTe := strCodCli;
                  End;

                  If (blnCliFil)                        And
                     (Pos(strOpcDoc, 'UC_NP_OE_') <= 0) And
                     ((fRetornaClienteFilial(VS_strCodEmp) <> strCodCli)) Then
                  Begin
                    pInfoStatusGravacao('Aguarde... Gravando Pedido de Compra para Transferência');
                    {********************************}
                    {* GRAVA PEDIDO DE COMPRA       *}
                    {*****************************LB*}
                    If (Not fGPedCompraTransferencia) Then
                    Begin
                      fCancelaTransac;
                      Result := False;
                      Exit;
                    End;

                  End;

                  pStepStatusGravacao;
                End;
              End;

            End;

          End;

          If (strOpcDoc = 'DD') Then
          Begin
            If (Not fMarcaDocDemonstracaoDevolvido(strNumDoc,
                                                   strEspDoc,
                                                   VS_strCodEmp,
                                                   strCodVen,
                                                   strConPag,
                                                   strCodCli,
                                                   fltTotGer)) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Livro Fiscal');

          {*****************************************}
          {* GRAVAÇÃO DO LIVRO FISCAL              *}
          {**************************************MV*}
          If (Not ((Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') And (not blnConfirmacaoEspelho) )) And
             (Not blnEspelhoDevolucaoCliente) Then
          Begin
            If (Not fGCadFisRe(arrLivFis)) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End
            Else
            if (fCfgSis('GIPCAT') = 'S') And (Pos(strEspDoc,'IF_NF_') > 0) then
            begin
              if not fGravaPortariaCAT(VS_strCodEmp, strCodVen, strEspDoc, strNumDoc) then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;
            End;
          End;

          pStepStatusGravacao;

          {**************************************************}
          {* SE FOR BRINDE E O CLIENTE FOR UM PROFISSIONAL, *}
          {* GRAVA UM DÉBITO PARA O PROFISSIONAL.           *}
          {***********************************************RV*}
          {************************************************************************}
          {* RONALDO SOLICITOU COMENTAR O And fClienteProfissional DIA 15/10/2014 *}
          {*********************************************************************FC*}
          If blnGraComPro And fCfgSis('DEBBRP', VarBoolean) {And fClienteProfissional(strCodCli)} Then
          Begin
            pInfoStatusGravacao('Aguarde... Gravando Débito Profissional');

            If (Not fGComProBrinde) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;

          {************************************************************}
          {* SE NÃO FOR NOTA DE COMPLEMENTO E NÃO FOR NOTA ESPECIAL E *}
          {* GRAVA CONTAS A PAGAR DE OUTRAS SAIDAS OU CREDITO DE ICMS *}
          {* PARA FORNECEDOR                                          *}
          {*********************************************************JC*}
          If (Not blnNotEsp) And (Not blnMeiaNota) And (blnOFGCTP Or (SameText(strOpcDoc, 'EF'))) Then
          Begin

            If ( ( SameText(strOpcDoc,'OF') And ((fCfgSis('OUSAFO', varString) = '1') or blnConfirmacaoEspelho) ) Or (SameText(strOpcDoc,'EF')And blnCtpOutEnt))
               Or
               ( SameText(strOpcDoc,'NC') And
                 blnNCFornecedor And (objNfeComplemento.tncTipoNota In [tncCreditoICMS, tncEstornoDeCredito])
               ) Then
            Begin
              pInfoStatusGravacao('Aguarde... Gravando Contas a Pagar');

              {*****************************************}
              {* GRAVA CADPAG                          *}
              {**************************************JB*}
              blnGeradoCadPag := fGCadPag;
              If (Not blnGeradoCadPag) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;

              If (Not fGCadPagFunrural) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;

            End;

            pStepStatusGravacao;
          End;

          {*****************************************}
          {* SE NÃO FOR NOTA DE COMPLEMENTO E NÃO  *}
          {* NÃO FOR NOTA ESPECIAL                 *}
          {**************************************MV*}
          If (strOpcDoc <> 'NC') And (Not blnNotEsp) And (Not blnMeiaNota) And (Not blnEspelhoDevolucaoCliente) Then
          Begin

            {*****************************************}
            {* GRAVAÇÃO DO CONTAS A RECEBER / MOVBAN *}
            {**************************************MV*}
            If blnGravarCadRec Then
            Begin
              If Pos(strOpcDoc, IIF(blnCliFil And blnGravaCtrTe,'','_CT') + '_OF_EF_') <= 0 Then
              Begin

                {*****************************************}
                {* GRAVA CADREC DE CRÉDITO               *}
                {**************************************MM*}
                If (Pos(strOpcDoc, 'FC_') > 0) Then
                Begin

                  If (Not fGravaCredito(fltTotGer,'CRÉDITO CONSIG - ' + strNumDoc + '-' + strEspDoc, fCfgSis('PORCON', varString))) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                End;

                pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

                {*****************************************}
                {* GRAVA CADREC                          *}
                {**************************************MV*}
                If (Not fGCadRec) Then
                Begin
                  fCancelaTransac;
                  Result := False;
                  Exit;
                End;

                {**************************************}
                {* GRAVA CLUBE DE FIDELIDADE :-)      *}
                {***********************************AF*}
                If (Pos(strOpcDoc, 'CF_CI_CT_') <= 0) Then
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Clube de Fidelidade');

                  If (Not fGCluFid) Then
                  Begin
                    fCancelaTransac;
                    Result := False;
                    Exit;
                  End;

                  pStepStatusGravacao;
                end;

                {**************************************}
                {* GRAVA COMISSÃO DO PROFISSIONAL     *}
                {***********************************LU*}
                If (Pos(strOpcDoc, 'CF_CI_CT_CS_') <= 0) Then
                Begin
                  pInfoStatusGravacao('Aguarde... Gravando Comissão do Profissional');

                  If Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0 Then
                  Begin

                    If (Not fGComProDev) Then
                    Begin
                      fCancelaTransac;
                      Result := False;
                      Exit;
                    End;

                    If fDeveGravarComProCTR Then
                    Begin
                      pInfoStatusGravacao('Aguarde... Gravando Contas a Receber do Profissional');

                      If (Not fGComProDevCtr) Then
                      Begin
                        fCancelaTransac;
                        Result := False;
                        Exit;
                      End;
                    End;
                  End
                  Else
                  Begin
                    If (Not fGComPro(fltBasComiss, fltVlrComiss)) Then
                    Begin
                      fCancelaTransac;
                      Result := False;
                      Exit;
                    End;

                    If fDeveGravarComProCTR Then
                    Begin
                      pInfoStatusGravacao('Aguarde... Gravando Contas a Receber do Profissional');

                      If (Not fGComProCtr) Then
                      Begin
                        fCancelaTransac;
                        Result := False;
                        Exit;
                      End;
                    End;
                  End;

                End;

                pStepStatusGravacao;

              End
              Else
              Begin
                For intContador := 1 To 3 Do
                  pStepStatusGravacao;
              End;

            End
            Else
            Begin
              For intContador := 1 To 3 Do
                pStepStatusGravacao;
            End;

          End
          Else If blnGravarCadRec And (Not blnEspelhoDevolucaoCliente) And
                  ((blnNotEsp And blnComVal) Or
                   (not blnNCFornecedor And (objNfeComplemento.tncTipoNota in [tncComplementoValor, tncComplementoIPI, tncComplementoFrete]))) Then
          Begin
            pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

            {*****************************************}
            {* GRAVA CADREC                          *}
            {**************************************MV*}
            If (Not fGCadRec) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;

            For intContador := 1 To 4 Do
              pStepStatusGravacao;

          End
          Else
          Begin
            For intContador := 1 To 4 Do
              pStepStatusGravacao;
          End;

        End
        {*****************************************}
        {* CASO ESTEJA TESTANDO, NÃO CONFIRMA    *}
        {**************************************MV*}
        Else
        Begin

          fCancelaTransac;
          Result := False;

          strCliCgc := AnsiReplaceStr(strCliCgc,'.','');
          strCliCgc := AnsiReplaceStr(strCliCgc,'-','');
          strCliCgc := AnsiReplaceStr(strCliCgc,'/','');

          reiReimpressao := TReimpressao.Create(strNumDoc, strEspDoc, 0, 0, strCodCli, IIF(Not fOrcamentoOutraLojaF11, VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc),VS_strCodEmp, strEmpOri))),
                                                strCodVen,  True, IIF(fDocumentoParaFornecedor,'F','C'), False, True, False, '', '', False, 0, False, 'V');

          If strOpcDoc = 'NC' Then
          Begin
            reiReimpressao.fatVenda := Self;
            reiReimpressao.pImprimeNotaComp;
          End
          Else
