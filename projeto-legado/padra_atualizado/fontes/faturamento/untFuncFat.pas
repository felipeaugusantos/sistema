          end;
        end;
        //Zerado o valdoc para que não lance o valor dobrado em caso de desmembramento
        Self.arrDocConsignacao[intIndice].fltValDoc := 0;
      end;
      FreeAndNil(qryConsignacao);
    End;

    If Not Result Then
      Exit;

    If (strOpcDoc <> 'FC') and (strEspDoc <> 'RB') Then
    Begin
      pInfoStatusGravacao('Aguarde... Gravando Resumo de Caixa');

