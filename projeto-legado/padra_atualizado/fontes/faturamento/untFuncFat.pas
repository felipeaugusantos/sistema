procedure TFatVenda.pBaixaFormulacaoPedidoAgrupado(strNumDoc, strEspDoc, strCodEmp: String);

  function fGetSQL: String;
  begin
    Result := '';
    Result := Result + 'UPDATE TINDOR A, TINDOR B ';
    Result := Result + '   SET A.FDO_BAIXAD = B.FDO_BAIXAD ';
    Result := Result + '     , A.FDO_OPEBAI = B.FDO_OPEBAI ';
    Result := Result + '     , A.FDO_HORBAI = B.FDO_HORBAI ';
    Result := Result + '     , A.FDO_DTABAI = B.FDO_DTABAI ';
    Result := Result + 'WHERE A.FDO_CODITE  = B.FDO_CODITE ';
    Result := Result + '  AND A.FDO_ITETIN  = B.FDO_ITETIN ';
    Result := Result + '  AND A.FDO_ESPDOC  = B.FDO_ESPDOC ';
    Result := Result + '  AND A.FDO_CODEMP  = B.FDO_CODEMP ';
    Result := Result + '  AND A.FDO_NUMDOC  = :NUMDOC ';
    Result := Result + '  AND A.FDO_ESPDOC  = :ESPDOC ';
    Result := Result + '  AND A.FDO_CODEMP  = :CODEMP ';
    Result := Result + '  AND LOCATE(IFNULL(B.FDO_NUMDOC,""), :DOCSPD) ';
  end;

var
  qryUpd: TUniQuery;
begin
  Try
    qryUpd := fCriaQuery;

    With qryUpd Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fGetSQL);

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('DOCSPD').AsString := strNumDocsPD;
      ExecSQL;
    End;
  Finally
    FreeAndNil(qryUpd);
  End;
end;

