    strNumFin: String;
begin
  Try
    Result := True;

    If ((blnRealizandoAdiantamentoPedidoPeloF11) or (blnRealizandoAdiantamentoPedidoPeloVN)) And (fltValFin <= 0) Then
      Exit;

    //Se já possui adiantamento realizado com a modalidade Financiamento
    If (recValAdt.fltValFin > 0) Then
      Exit;

    With objFinanc.cdsMovFin Do
    Begin

      strPortador := fDecidePortador;

      dtaDtaRec := 0;
      fltValRec := 0.0;
      strPorBai := '';
      strCtaBai := '';
      strOpeBai := '';
      strSeqLan := '';
