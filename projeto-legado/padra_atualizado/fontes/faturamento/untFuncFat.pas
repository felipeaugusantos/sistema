        {*************************************************************RN*}
    //    If (fltDesCon < 0)                                                         And
    //       (fFormataFloat(fltDesCon, intDecUni) <> fFormataFloat(fltDesAnt, intDecUni)) Then
    //    Begin
    //      blnTraIteTmp := False;
    //    End;

        If ((strOpcDoc = 'TR') And (strEntSai = 'E')) Or
