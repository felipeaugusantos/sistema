End;


procedure pCarregaEstoqueMatrizAux(objCadLot: TCadLot;
  strCodIte, strNumLot, strEmpMat: String; Var fltSaldoMatriz: Double);

  Var
    strSQL   : String;
    qryGenIte: TUniQuery;

begin
  If Not fEmptyStr(strNumLot) Then
  Begin
    fltSaldoMatriz := objCadLot.fSaldoLote(strCodIte, strEmpMat, strNumLot);
    Exit;
  End;

  Try

    qryGenIte := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  ITE_SALDOS ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ITEGER ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  ITE_CODITE = :CODITE AND ';
    strSQL := strSQL + '  ITE_CODEMP = :CODEMP ';

    With qryGenIte Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := strEmpMat;
      Open;
      fltSaldoMatriz := FieldByName('ITE_SALDOS').AsFloat;
      Close;
    End;

  Finally
    FreeAndNil(qryGenIte);
  End;

end;

procedure TFatVenda.pAdicionaDesEspOri(strCodIte: String; intAutInc: Integer; fltDesEsp, fltQtdIte: Double);
begin
  If Assigned(cdsDesEspOri) And (cdsDesEspOri.Active) Then
  Begin
    If cdsDesEspOri.FindKey([strCodIte, intAutInc]) Then
      cdsDesEspOri.Edit
    Else
    Begin
      cdsDesEspOri.Append;
      cdsDesEspOri.FieldByName('ITE_CODITE').AsString := strCodIte;
      cdsDesEspOri.FieldByName('AUTOINCREM').AsInteger := intAutInc;
    End;
    cdsDesEspOri.FieldByName('ITE_DESESP').AsFloat := fltDesEsp;
    cdsDesEspOri.FieldByName('ITE_QTDITE').AsFloat := fltQtdIte;
    cdsDesEspOri.Post;
  End;
end;

function TFatVenda.fGetDesEspOri: Double;
begin
  Result := 0;
  cdsVenda.First;
  While Not cdsVenda.Eof Do
  Begin
    If (cdsDesEspOri.FindKey([cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('AUTOINCREM').AsInteger])) And
       (fFormataFloat(cdsDesEspOri.FieldByName('ITE_DESESP').AsFloat, 2) > 0) Then
    Begin
      If (cdsDesEspOri.FieldByName('ITE_QTDITE').AsFloat = cdsVenda.FieldByName('ITE_QTDITE').AsFloat) Then
        Result := Result + cdsDesEspOri.FieldByName('ITE_DESESP').AsFloat
      Else
        Result := Result + fFormataFloat(((cdsDesEspOri.FieldByName('ITE_DESESP').AsFloat/cdsDesEspOri.FieldByName('ITE_QTDITE').AsFloat)*cdsVenda.FieldByName('ITE_QTDITE').AsFloat), 2);
    End;
    cdsVenda.Next;
  End;
end;

