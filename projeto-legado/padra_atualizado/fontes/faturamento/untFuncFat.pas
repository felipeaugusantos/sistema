  Result := '';

  //Prestcon
  If MatchStr(strOpcDoc,['VN','CP']) And fEhVendaConcreto And MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL]) Then
  Begin
    Result := 'Materiais adquiridos de terceiros para preparo e aplicação DE ' +
              FormatFloat('#,##0.00', fltQtdItC) + ' M3 de concreto ' + strDesItC  + ' ' +
              'C/ ABATIMENTO DE ' + strAbatim + ', ' + IIF(strConBom = 'C', 'CONVENCIONAL, ', 'BOMBEADO, ') +
              'LACRE: ' + strLacre_ + ', CHEGADA NA OBRA ___:___HS INICIO/DESCARGA ___:___HS ' +
              'TERMINO/DESCARGA ___:___HS SAIDA DA OBRA: ___:___HS CHEGADA CENTRAL: ___:___HS ' +
              'PECA CONCRETADA: _________________________________ Motorista: ' + strNomMot + ' ' +
              'Betoneira: ' + strBetone + ', PLACA: ' + LeftStr(strPlaVei, 3) + '-'  + RightStr(strPlaVei, 4) +
              '. ATENCAO: O documento habil para lancamento contabil e fiscal sera nossa nota fiscal de servicos, ' +
              'a ser emitida posteriormente. Verifique com maxima atencao antes de proceder a descarga do concreto, ' +
