function TFatVenda.fTemEntregaFutura(strMotFut: String = ''): Boolean;
  Var
    cdsDados: TUniClientDataSet;
Begin
  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.Filtered := False;
    cdsDados.Filter := cdsVenda.Filter;

    If Not fEmptyStr(cdsDados.Filter) Then
      cdsDados.Filter := cdsDados.Filter + ' AND ';

    cdsDados.Filter := cdsDados.Filter +
                       fGetFiltroEntregaFutura(strMotFut) +
                       ' AND (ITE_CODITE <> ('+fQuotedStr(fCfgSis('SERTER'))+')) '+
                       ' AND (ITE_CODITE <> ('+fQuotedStr(fCfgSis('ITESER'))+')) ';

    cdsDados.Filtered := True;

    Result := Not cdsDados.IsEmpty;
  Finally
    FreeAndNil(cdsDados);
  End;
End;

