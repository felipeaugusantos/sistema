class function TFatVenda.fFiltroFormasPagamentoF11(strCodCli, strFpgOrc,
  strConPag, strCodOpe: String; objFormasPagtoNegociada: TFormaPagtoNegociada;
  blnRealizandoAdiantamento: Boolean; blnPermitePix: Boolean = False): String;
  Var
    strSQL   : String;
    intCont  : Integer;
    stlForPag: TStringList;
    stlCndPag: TStringList;
    blnRecebimentoFormasPagtoNegociadas: Boolean;
begin
  Result := '';

  blnRecebimentoFormasPagtoNegociadas := Assigned(objFormasPagtoNegociada) And
    (strFpgOrc = '009') And (Not fEmptyStr(objFormasPagtoNegociada.fGetFormasPagtoSelecionadas));

  stlForPag := TStringList.Create;
  stlForPag.Sorted := True;
  stlForPag.Duplicates := dupIgnore;

  stlCndPag := TStringList.Create;
  stlCndPag.Sorted := True;
  stlCndPag.Duplicates := dupIgnore;

  pCarregaFormasPagto(strCodCli, stlForPag, stlCndPag);

  If (Not fEmptyStr(strCodCli)) And
     (fRetornaStatusCliente(strCodCli) = 'I') And
     (fPermiteVenderApenasDinheiroECartaoParaInativo('11')) Then
  Begin
    Result := Result + ' AND F.FPG_CODIGO IN ("001", "007", "013", "012") ';
  End
  Else
  Begin
    {**********************************************************************************}
    {* SE NAO PERMITE SELECIONAR UMA FORMA DE PAGAMENTO NAO PERMITIDA MEDIANTE SENHA, *}
    {* ENTAO CARREGA SOMENTE AS FORMAS DE PAGAMENTO QUE O CLIENTE POSSUI PERMISSAO    *}
    {**********************************************************************************}
    {* OBS: ESTA LISTA SOMENTE VAI ESTAR PREENCHIDA QUANDO UTILIZAR TIPO DE CLIENTE.  *}
    {*****************************************************************************JC***}
    If (Not fCfgSis('FPGCLI', varBoolean)) And (stlForPag.Count > 0) Then
    Begin
      strSQL := '';
      For intCont := 0 To stlForPag.Count-1 Do
        strSQL := strSQL + QuotedStr(stlForPag[intCont]) + ', ';

      strSQL := LeftStr(strSQL, Length(strSQL) - 2);

      Result := Result + ' AND F.FPG_CODIGO IN (' + strSQL + ')';
    End;

    {***************************************************************}
    {* CASO CONFIGURADO PARA TRAVAR A FORMA DE PAGAMENTO NEGOCIADA *}
    {***********************************************************JC**}
    If fCfgSis('TFPF11', varBoolean) And (Not fEmptyStr(strFpgOrc)) Then
    Begin
      {*************************************************************}
      {* CARREGA AS FORMAS DE PAGAMENTO NEGOCIADAS (009-PARCELADO) *}
      {*********************************************************JC**}
      If blnRecebimentoFormasPagtoNegociadas Then
      Begin
        Result := Result + ' AND LOCATE(F.FPG_CODIGO, "' +
          objFormasPagtoNegociada.fGetFormasPagtoSelecionadas + '") > 0 ';
      End
      {*************************************************************************}
      {* CASO TENHA NEGOCIADO DINHEIRO, PERMITE SOMENTE DINHEIRO OU CREDITOS   *}
      {**********************************************************************JC*}
      Else If fCfgSis('CF11DI', varBoolean) And (strFpgOrc = '001') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End
      {*************************************************************************}
      {* CASO TENHA NEGOCIADO CARTAO, PERMITE SOMENTE DINHEIRO OU CARTAO       *}
      {**********************************************************************JC*}
      Else If fCfgSis('CF11CA', varBoolean) And (strFpgOrc = '007') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "007", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End
      {***************************************************************************}
      {* CASO TENHA NEGOCIADO CHEQUE, PERMITE SOMENTE DINHEIRO, CARTAO OU CHEQUE *}
      {************************************************************************JC*}
      Else If fCfgSis('CF11CH', varBoolean) And (Pos(strFpgOrc, '002_006_') > 0) Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "002", "006", "007", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End
      {**************************************************************************************}
      {* CASO TENHA NEGOCIADO FATURADO PERMITE SOMENTE DINHEIRO, CARTAO, CHEQUE OU FATURADO *}
      {***********************************************************************************JC*}
      Else If fCfgSis('CF11FA', varBoolean) And (strFpgOrc = '008') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "002", "006", "007", "008", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End
      {******************************************************************}
      {* CARREGA A FORMA DE PAGAMENTO DO PEDIDO E ALGUMAS ADICIONAIS,   *}
      {* LEMBRANDO QUE O CLIENTE DEVE POSSUIR PERMISSAO PARA AS MESMAS. *}
      {******************************************************************}
      {* OBS: FINANCEIRA NAO PERMITE FORMAS ADICIONAIS, SOMENTE 016.    *}
      {**************************************************************JC**}
      Else If fCfgSisL('PFAF11', varBoolean) And (strFpgOrc <> '016') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("' + strFpgOrc + '", "001", "012", "013", "014", "015") ';
      End
      {**************************************************}
      {* CARREGA SOMENTE A FORMA DE PAGAMENTO DO PEDIDO *}
      {**********************************************JC**}
      Else If Not (blnRealizandoAdiantamento And (Pos(strFpgOrc, strFormasPagtoAdiantamento) <= 0)) Then
        Result := Result + ' AND F.FPG_CODIGO IN ("' + strFpgOrc + '"' + IIF(fCfgSis('UTICRE', varBoolean), ',"013"', '') +')';
    End
    Else
    Begin
      {************************************************************************************************}
      {* SE A CONDICAO DE PAGAMENTO DO PEDIDO FOR A VISTA CARREGA SOMENTE FORMAS DE PAGAMENTO A VISTA *}
      {********************************************************************************************JC**}
      If fCfgSis('CF11AV', varBoolean) Then
      Begin
        If (fStatusCndPag(strConPag) = A_VISTA) Then
        Begin                                          // DINHEIRO - CHEQUE PRE -  CHEQUE A VISTA - CARTAO
          Result := Result + ' AND F.FPG_CODIGO IN ("001", "002", "006", "007", "012", "013", "014", "015" ' + IIF(strFpgOrc = '016', ', "016"', '') + ')';
        End;
      End;

      {********************************************}
      {* NAO DEIXA ALTERAR PARA FINANCEIRA NO F11 *}
      {****************************************JC**}
      If strFpgOrc <> '016' Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO <> "016"';
      End;

      {*************************************************************************}
      {* CASO TENHA NEGOCIADO DINHEIRO, PERMITE SOMENTE DINHEIRO OU CREDITOS   *}
      {**********************************************************************JC*}
      If fCfgSis('CF11DI', varBoolean) And (strFpgOrc = '001') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End;

      {*************************************************************************}
      {* CASO TENHA NEGOCIADO CARTAO, PERMITE SOMENTE DINHEIRO OU CARTAO       *}
      {**********************************************************************JC*}
      If fCfgSis('CF11CA', varBoolean) And (strFpgOrc = '007') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "007", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End;

      {***************************************************************************}
      {* CASO TENHA NEGOCIADO CHEQUE, PERMITE SOMENTE DINHEIRO, CARTAO OU CHEQUE *}
      {************************************************************************JC*}
      If fCfgSis('CF11CH', varBoolean) And (Pos(strFpgOrc, '002_006_') > 0) Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "002", "006", "007", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End;

      {**************************************************************************************}
      {* CASO TENHA NEGOCIADO FATURADO PERMITE SOMENTE DINHEIRO, CARTAO, CHEQUE OU FATURADO *}
      {***********************************************************************************JC*}
      If fCfgSis('CF11FA', varBoolean) And (strFpgOrc = '008') Then
      Begin
        Result := Result + ' AND F.FPG_CODIGO IN ("001", "002", "006", "007", "008", "013"'+ IIF(blnPermitePix, ',"012"', '') +')';
      End

    End;
  End;

  If Not fVerificaAcessoSistema('PEREXICRED', strCodOpe) And
     Not blnRecebimentoFormasPagtoNegociadas And
     Not (fCfgSis('TFPF11', varBoolean) And (strFpgOrc = '013')) Then
  Begin
    Result := Result + ' AND F.FPG_CODIGO <> "013" ';
  End

  Else If (fCfgSis('TFPF11', varBoolean) And (fCfgSis('UTICRE') = 'N')) Then
  Begin
    If (blnRecebimentoFormasPagtoNegociadas And (Not (Pos(objFormasPagtoNegociada.fGetFormasPagtoSelecionadas, '_013') > 0) )) Or
       ((Not blnRecebimentoFormasPagtoNegociadas) And (strFpgOrc <> '013') And (Not fEmptyStr(strFpgOrc))) Then
    Begin
      Result := Result + ' AND F.FPG_CODIGO <> "013" ';
    End;
  End;

  If blnRealizandoAdiantamento Then
    Result := Result + ' AND LOCATE(F.FPG_CODIGO, "' + strFormasPagtoAdiantamento + '")';

  stlForPag.Free;
  stlCndPag.Free;
end;

class function TFatVenda.fPermiteVenderApenasDinheiroECartaoParaInativo(strOpcDoc: String): Boolean;
begin
  Result := (fCfgSisTraScl(strOpcDoc)) And
            (fCfgSis('INVNDC', varBoolean));
end;

procedure TFatVenda.pAtualizaLoteItensWMS;
  Var
    prcScroll: TprcScroll;
    strEmpresa : String;
    strLoteDaCarga : String;
begin
  If (Not fAlgumaEmpresaUtilizaWms) Then
    Exit;
  Try
    With cdsVenda, objCadLot Do
    Begin
      pDisableControls(cdsVenda, prcScroll);

      First;

      While Not Eof Do
      Begin
        //strEmpresa := IIF(FieldByName('ITE_EMPITE').AsString <> '', FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD);
        strEmpresa :=  IIF(blnEmpFat And (Not FieldByName('ITE_EMPITE').IsNull), FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD);

        If fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis(strEmpresa) Then
        Begin
          Next;
          Continue;
        End;

        If fEhItemRetiraCaixaELotePickingCheckOut(cdsVenda) Then
        Begin
          Next;
          Continue;
        End;

        strLoteDaCarga := EmptyStr;

        {*************************************************************}
        {* SOMENTE PERMITIDO LOTE "A DEFINIR" UTILIZANDO ROTINAS WMS *}
        {**********************************************************JC*}
        If fEhEmissaoDocumentoWMS Or
           fEmpresaParaFaturamentoUsaWMS(strEmpresa) Then
        Begin
          strLoteDaCarga := FieldByName('ITE_NUMLOT').AsString;

          Edit;

          If fCfgSis('WMSLOT', varBoolean) Then
          Begin
            If (fCampoTabela('ITE_LOTEPD', 'CADITE', ['ITE_CODITE'], [FieldByName('ITE_CODITE').AsString]) = 'N') And
               (FieldByName('ITE_PEGOU_').AsString = 'N') Then
              FieldByName('ITE_NUMLOT').AsString := 'A DEFINIR';
          End
          Else
            FieldByName('ITE_NUMLOT').AsString := 'A DEFINIR';

          Post;
        End;

        {***********************************************************************************}
        {* SOMENTE PERMITIDO LOTE "Principal para tinta de maquina" UTILIZANDO ROTINAS WMS *}
        {********************************************************************************JC*}
        If fUsaRotinaWMS(strEmpresa) And
           fExisteLotePrincipalTintaMaquina(FieldByName('ITE_CODITE').AsString, strEmpresa) And
           ((FieldByName('ITE_IDEPRO').AsString <> 'NOR') Or (FieldByName('ITE_PROACA').AsInteger = 1)) Then
        Begin
          Edit;
          If (fTipoTinta(FieldByName('ITE_IDEPRO').AsString) In [ttImobiliaria]) And fCfgSis('TINWMS', varBoolean, strEmpresa) Then
            FieldByName('ITE_NUMLOT').AsString := 'A DEFINIR'
          Else
            FieldByName('ITE_NUMLOT').AsString := fRetLotePrincipalTintaMaquina(FieldByName('ITE_CODITE').AsString, strEmpresa);
          Post;
        End
        Else If (Not fEmptyStr(FieldByName('ITE_NUMLOT').AsString)) And
                (strLoteDaCarga <> FieldByName('ITE_NUMLOT').AsString) And
                (Not fExisteLote(FieldByName('ITE_CODITE').AsString, strEmpresa, FieldByName('ITE_NUMLOT').AsString)) Then
        Begin
          Edit;
          FieldByName('ITE_NUMLOT').AsString := '';
          Post;
        End;

        Next;
      End;

      First;
    End;
  Finally
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

function TFatVenda.fAcertaValoresFinanceiraDesmembramento(fltTotGerAtu, fltTotGerAnt: Double; blnUltReg: Boolean): Boolean;
Var
  fltFator : Double;
  fltValTmp: Double;
  fltValDif: Double;
Begin

  If (Not Assigned(objFinanc)) Then
  Begin
    Result := True;
    Exit;
  End;

  If (fltTotGerAnt = 0) Then
    fltFator := 1
  Else
    fltFator := fltTotGerAtu / fltTotGerAnt;

  objFinanc.pAtualizaClient(fltFator);

  fltValTmp := fFormataFloat(objFinanc.fRetTotalFinanciado, 2);
  fltValDif := fFormataFloat(fltTotGerAtu, 2) - fFormataFloat(fltValTmp, 2);

  If (fFormataFloat(Abs(fltValTmp), 2) > 0) And
     (fFormataFloat(Abs(fltValDif), 2) = fFormataFloat(0.01, 2)) Then
  Begin
    objFinanc.pAtualizaDiferencaDocumento(fltValDif);
  End;

  objFinanc.pSalvaValoresDesmembrados;

  If blnUltReg Then
  Begin
    objFinanc.pAtualizaDiferencaDesmembramento;
  End;

  Self.fltValFin := objFinanc.fRetValFin;

  Result := True;

End;

function TFatVenda.fFaturandoPedido: Boolean;
Var
  strTipExp: String;
Begin
  strTipExp := fCfgSis('TIPEXP', VarString);

  Result := ((Pos(strOpcDoc, 'VN_CP_') > 0) And (strEspOrc = 'PD') And (strEspDoc <> 'PD')) Or     // FATURANDO UM PEDIDO PELA VENDA NORMAL, F11 OU PELA CONFIRMAÇÃO DE PEDIDOS
            ((blnExpedi) And (Pos(strTipExp, '_3_4_5_') > 0));                                     // FATURANDO UM PEDIDO PELA EXPEDIÇÃO
End;

procedure TFatVenda.pGravaDetSer(strAutInc, strNumSer, strCodEmp: string);
var
  qryDetser: TUniQuery;
  strSQL: string;
begin
  try
    strSQL := '';
    strSQL := strSQL + 'INSERT INTO DETSER(SER_SEQGER, AUTOINCREM, SER_NUMSER) ';
    strSQL := strSQL + 'VALUES(:SEQGER, :AUTOINCREM, :NUMSER)';

    qryDetser := fCriaQuery(nil);
    qryDetser.Close;
    qryDetser.SQL.Clear;
    qryDetser.SQL.Add(strSQL);
    qryDetser.ParamByName('SEQGER').AsString := strAutInc;
    qryDetser.ParamByName('NUMSER').AsString := strNumSer;
    qryDetser.ParamByName('AUTOINCREM').AsString := fRetAutoIncrem('DETSER', strCodEmp);
    qryDetser.ExecSQL;
  finally
    FreeAndNil(qryDetser);
  end;
end;

procedure TFatVenda.pGravaFisAju(strCodCAT, strCFOP, strNumDoc,
  strTipDoc: string; intTipGra: integer; fltValor: Double);
var
  qryFisAju: TUniQuery;
  strSQL, strAutInc: string;
begin
  //intTipGra
  //1 -> SAÍDA CFOP x20, x30, x40, x41
  //2 -> SAÍDA CFOP x10, x60, x70, x90
  //3 -> ENTRADA CFOP x20, x30, x40, x41
  //4 -> ENTRADA CFOP x10

  try
    strAutInc := fBuscaAutoIncCADFIS(strNumDoc, strTipDoc);

    strSQL := '';
    strSQL := strSQL + 'INSERT INTO FISAJU(AJU_SEQGER, AJU_CD_AJU, AJU_DESAJU, AJU_BASICM, AJU_ALQICM, AJU_VALICM, AJU_OUTROS, AUTOINCREM) ';
    strSQL := strSQL + 'VALUES(:SEQGER, :CDAJU, :DESAJU, :BASICM, :ALQICM, :VALICM, :OUTROS, :AUTOINCREM) ';

    qryFisAju  := fCriaQuery(nil);
    qryFisAju.Close;
    qryFisAju.SQL.Clear;
    qryFisAju.SQL.Add(strSQL);
    qryFisAju.ParamByName('SEQGER').AsString := strAutInc;
    qryFisAju.ParamByName('CDAJU').AsString  := strCodCAT;
    qryFisAju.ParamByName('DESAJU').AsString := strCFOP;
    qryFisAju.ParamByName('AUTOINCREM').AsString := fRetAutoIncrem('FISAJU', VS_strCodEmp);
    //qryFisAju.ParamByName('BASICM').Value    := ' ';
    //qryFisAju.ParamByName('ALQICM').Value    := ' ';


    case intTipGra of
      1,3:begin
        qryFisAju.ParamByName('VALICM').Value := fltValor;
        //qryFisAju.ParamByName('OUTROS').Value := ' ';
      end;
      2,4:begin
        //qryFisAju.ParamByName('VALICM').Value := ' ';
        qryFisAju.ParamByName('OUTROS').Value := fltValor;
      end;
    end;

    qryFisAju.ExecSQL;
  finally
    FreeAndNil(qryFisAju);
  end;
end;

procedure TFatVenda.pGravarContasReceberBoletoAdiantamentoPedido;
  Var
    fltValorRestante: Double;
    strPortador: String;
    strParcela: String;
begin
  //Trava de segurança, não pode ser informado um valor de boletos de
  //adiantamento menor que o valor já enviado para o banco
  If fltBolAdt < fltTotalBoletosAdiantamentoJaEnviados Then
    Raise Exception.Create('O valor de boleto de adiantamento já enviado '+
      'para o banco é maior que o valor informado no documento!');

  fltValorRestante := fltBolAdt - fltTotalBoletosAdiantamentoJaEnviados;

  If fFormataFloat(fltValorRestante, 2) = 0.00 Then
    Exit;

  strPortador := fDecidePortador;

  If fEmptyStr(strPortador) Then
    strPortador := fCfgSis('PORAVI');

  {*REQ*145940**********RP*}
  If Not fEmpresaTemAcessoPortador(strPortador) Then
  Begin
    fRollback;
    fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strPortador +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
    Exit;
  End
  Else If fCfgSis('DACPOR', varBoolean) Then
    If Pos(strPortador, strPortadoresOperador) <= 0 Then
    Begin
      fRollBack;
      fMensagem('', 'Portador ' + strPortador + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
      Exit;
    End;

  strParcela := TAdiantamentoGenerico.fRetornaUltimaParcelaBoletosAdiantamento(
    strNumOrc, strEspOrc, strEmpOri, strCliAnt);

  If fEmptyStr(strParcela) Then
    strParcela := 'A'
  Else
    strParcela := fIncAlfaNumerico(strParcela);

  If Not untCadRec.fGravaCadRec( strNomeForm,
                                 'INCLUSÃO',
                                 strNumDoc,
                                 strParcela,
                                 0,
                                 strEspDoc,
                                 strCodCli,
                                 VS_strCodEmp,
                                 strCodVen,
                                 strCodDig,
                                 strPortador,
                                 Self.VS_Date,
                                 Self.VS_Date + fCfgSis('DIABAD', VarInteger),
                                 fltValorRestante,
                                 fltValorRestante,
                                 0.0,
                                 '',
                                 'BOLETO DE ADIANTAMENTO REF. DOC: '
                                   + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp,
                                 '',
                                 '',
                                 '',
                                 '',
                                 '',
                                 0,
                                 0,
                                 'S',
                                 '',
                                 '',
                                 '',
                                 '',
                                 False,
                                 '',
                                 0,
                                 fltValorRestante ) Then
    Raise Exception.Create('Não foi possível gerar as duplicatas '+
      'de boleto de adiantamento!');
end;

procedure TFatVenda.pGravarContasReceberParaTodosVencimentosPedido;
Var
  fltValorRestante: Double;
  strPortador: String;
  strParcela: String;
  arrDuplicataBkp: TDigDuplicArray; // COPIA DA MATRIZ DE DUPLICATAS ORIGINAL
  intContador: Integer;
  blnMostraDigDuplic: Boolean;
  arrDatas: TDateArray;

  fltPerDPo: Double;
  intQtdDAV: Integer;

  fltParValCom: Double;
  fltParFatCom: Double;
  fltParFatRep: Double;
  fltParComRep: Double;

  fltParIpi: Double;
  fltParRet: Double;
  fltParAce: Double;
  fltParFre: Double;
  fltParFCP: Double;
  fltParCbs: Double;
  fltParIbs: Double;
  fltPar_Is: Double;

  arrDuplicVend: TarrDuplicata;
  arrDuplicRepr: TarrDuplicata;
  arrDuplicIPI : TarrDuplicata;
  arrDuplicRet : TarrDuplicata;
  arrDuplicAce : TarrDuplicata;
  arrDuplicFre : TarrDuplicata;
  arrDuplicFCP : TarrDuplicata;
  arrDuplicCbs : TarrDuplicata;
  arrDuplicIbs : TarrDuplicata;
  arrDuplicIs  : TarrDuplicata;
begin
  For intContador := 0 To 23 Do
    arrDuplicataBkp[intContador] := arrDuplicata[intContador];

  fltValorRestante := fltTotCadRec + fltTotalFaturadoParcialmente - fltValAdt - fltTotalBoletosAdiantamentoJaEnviados;

  If fltValorRestante <= 0 Then
    Exit;

  strPortador := fDecidePortador;

  If fEmptyStr(strPortador) Then
    strPortador := fCfgSis('PORAVI');

  {*REQ*145940**********RP*}
  If Not fEmpresaTemAcessoPortador(strPortador) Then
  Begin
    fRollback;
    fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strPortador +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
    Exit;
  End
  Else If fCfgSis('DACPOR', varBoolean) Then
    If Pos(strPortador, strPortadoresOperador) <= 0 Then
    Begin
      fRollBack;
      fMensagem('', 'Portador ' + strPortador + ' não permitido para o operador ' +
        strLoginUsuarioLogado, ['&OK']);
      Exit;
    End;

  Try
    blnMostraDigDuplic := False;

    If (Not fPermiteInformarVencimentosParaBoletoDeAdiantamento(blnBolVen)) And
       (Not fPermiteInformarVencimentosParaBoletoDeAdiantamento(Not blnBolVen)) Then
    Begin
      If Not fDigitaDuplicata(blnMostraDigDuplic, arrDatas, dtaPreVis, True,
        arrDuplicCop, fltValorRestante) Then
          Raise Exception.Create('Não foi possível gerar as duplicatas '+
            'de boleto de adiantamento!');
    End;

    strParcela := TAdiantamentoGenerico.fRetornaUltimaParcelaBoletosAdiantamento(
      strNumOrc, strEspOrc, strEmpOri, strCliAnt);

    pCarregarDescontoPontualidade(fltPerDPo, intQtdDAV);

    For intContador := 0 To 23 Do
    Begin
      If (ArrDuplicata[intContador].dtaDtaVen = '') Then
        Break;

      If fFormataFloat(arrDuplicata[intContador].curValor,2) = 0.00 Then
        Break;

      If fPermiteInformarVencimentosParaBoletoDeAdiantamento(Not blnBolVen) Then
      Begin
        If intContador = intSeqDupBaiAdtCli Then
          Break;
      End;

      If intContador = 0 Then
      Begin
        pMontaDuplicatasProporcional(Self.fltVlrCom,  arrDuplicVend , arrDuplicata, False, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltVlrExt,  arrDuplicRepr , arrDuplicata, False, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltDesAce,  arrDuplicAce  , arrDuplicata, False, intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);// Despesa acessória não tem configuração sempre rateia.
        pMontaDuplicatasProporcional(Self.fltTotIpi,  arrDuplicIPI  , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPIPI', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltTotRet,  arrDuplicRet  , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPSUB', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltValFre,  arrDuplicFre  , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPFRE', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltTotFcpST,arrDuplicFCP  , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPSUB', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltTotCBS,  arrDuplicCbs  , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPCBS', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltTotIBS,  arrDuplicIbs  , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPCBS', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
        pMontaDuplicatasProporcional(Self.fltTotIS,   arrDuplicIs   , arrDuplicata, blnImpostosNaPrimeiraParcela And fCfgSis('IMPCBS', varBoolean), intSeqDupBaiAdtCli, intSeqDupBaiUtiCred, FFoiGravacaoPorDesmembramento);
      End;

      fltParValCom := arrDuplicVend[intContador].curValor;
      fltParFatCom := arrDuplicVend[intContador].curValor;
      If arrDuplicata[intContador].curValor <> 0 Then
        fltParFatCom := fltParFatCom / arrDuplicata[intContador].curValor;

      fltParComRep := arrDuplicRepr[intContador].curValor;
      fltParFatRep := arrDuplicRepr[intContador].curValor;
      If arrDuplicata[intContador].curValor <> 0 Then
        fltParFatRep := fltParFatRep / arrDuplicata[intContador].curValor;

      fltParIpi := arrDuplicIPI[intContador].curValor;
      fltParFre := arrDuplicFre[intContador].curValor;
      fltParRet := arrDuplicRet[intContador].curValor;
      fltParAce := arrDuplicAce[intContador].curValor;
      fltParFCP := arrDuplicFCP[intContador].curValor;
      fltParCbs := arrDuplicCbs[intContador].curValor;
      fltParIbs := arrDuplicIbs[intContador].curValor;
      fltPar_Is := arrDuplicIs[intContador].curValor;

      If fEmptyStr(strParcela) Then
        strParcela := 'A'
      Else
        strParcela := fIncAlfaNumerico(strParcela);

      If Not untCadRec.fGravaCadRec( strNomeForm,
                                     'INCLUSÃO',
                                     strNumDoc,
                                     strParcela,
                                     0,
                                     strEspDoc,
                                     strCodCli,
                                     VS_strCodEmp,
                                     strCodVen,
                                     strCodDig,
                                     strPortador,
                                     Self.VS_Date,
                                     StrToDate(arrDuplicata[intContador].dtaDtaVen),
                                     arrDuplicata[intContador].curValor,
                                     arrDuplicata[intContador].curValor,
                                     0.0,
                                     '',
                                     'BOLETO DE ADIANTAMENTO REF. DOC: '
                                       + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp,
                                     '',
                                     '',
                                     '',
                                     '',
                                     '',
                                     0,
                                     0,
                                     'S',
                                     '',
                                     '',
                                     '',
                                     '',
                                     False,
                                     '',
                                     0,
                                     arrDuplicata[intContador].curValor,
                                     '',
                                     '',
                                     '',
                                     '',
                                     0,
                                     0,
                                     fltParValCom,
                                     fltParFatCom,
                                     '',
                                     strEmpRec, // Empresa de Origem
                                     '',
                                     '',
                                     '',
                                     '',
                                     fltParComRep,
                                     fltParFatRep,
                                     strCodRep,
                                     fltParIpi,
                                     fltParRet,
                                     'N',
                                     0,
                                     0,
                                     0,
                                     0,
                                     0,
                                     0,
                                     0,
                                     0,
                                     '',
                                     fltPerDPo,
                                     intQtdDAV,
                                     0,
                                     '',
                                     fltParAce,
                                     fltParFre,
                                     0,
                                     0,
                                     0,
                                     0,
                                     '',
                                     fltParFCP,
                                     'INCLUSÃO',
                                     '',
                                     '',
                                     '',
                                     'N',
                                     'N',
                                     '',
                                     '',
                                     '',
