procedure TFatVenda.pTratarDiferencaVolumeCalculadoComDigitado;
var LOpcaoEscolhida : Integer;
    LIdx : integer;
    LQuantidadeFator,
    LVolumeItem,
    LVolumeTotal,
    LMultiploVenda : double;
    LMensagem : TStrings;
begin
  repeat
    LOpcaoEscolhida := fMensagem('', 'A Quantidade de volumes informada anteriormente no pedido é diferente da quantidade calculada agora no sistema!'+ #13#10 +
    'Quantidade informada no pedido : '+FloatToStrF(intQtdTra, ffFixed, 12, 0)+#13#10+
    'Quantidade calculada no sistema: '+FloatToStrF(fRetVolumes, ffFixed, 12, 0)+#13#10+
    'Deseja atualizar a quantidade de volumes?',['Sim','Não','Exibir Cálculo']);

    if LOpcaoEscolhida = 1 then
    begin
      intQtdTra := Floor(fRetVolumes);
      If fCfgSis('SEPEXC', varBoolean) Then
      Begin
        intQtdTraSepExc  := Floor(fRetVolumesSepExc);
        intQtdTraSepNExc := (intQtdTra - intQtdTraSepExc);
      End;
    end
    else if LOpcaoEscolhida = 3 then
    begin
      LMensagem := TStringList.Create;

      if fCfgSis('TIPVOL') = '1' then
        LMensagem.Add('Tipo de cálculo: efetuado por embalagem')
      else
      if fCfgSis('TIPVOL') = '2' then
      LMensagem.Add('Tipo de cálculo: efetuado por múltiplo de venda')
      else
      if fCfgSis('TIPVOL') = '3' then
        LMensagem.Add('Tipo de cálculo: efetuado por primeiro múltiplo de compra e diferença pelo múltiplo de venda');
      LMensagem.Add('');
      LMensagem.Add('Produto |      Descrição      | UN | '+
        IIF(fCfgSis('TIPVOL') = '1', '  Embalagem   ', '   Múltiplo   ')+' |   Quantidade   | Vol. Calculado ');

      LVolumeTotal := 0;
      For LIdx := Low(arrMatItens) To High(arrMatItens) Do
      begin
        LMultiploVenda := fRetMltVenItem(arrMatItens[LIdx].strCodIte);

        LQuantidadeFator := IIF(fCfgSis('TIPVOL') = '1',
                                IIF(arrMatItens[LIdx].fltEmbala = 0, 1, arrMatItens[LIdx].fltEmbala),
                                IIF(LMultiploVenda = 0, 1, LMultiploVenda));

        LVolumeItem := fGetVolumeCalculadoItem(arrMatItens[LIdx].strCodIte);
        LVolumeTotal := LVolumeTotal + LVolumeItem;

        LMensagem.add(fPadC(arrMatItens[LIdx].strCodIte, 7,' ') +' | '+
                      fPadC(arrMatItens[LIdx].strDesIte,19,' ') +' | '+
                      fPadC(arrMatItens[LIdx].strUnidad,2 ,' ') +' | '+
                      fPadC(FloatToStrf(LQuantidadeFator, ffFixed, 12, 2), 14, ' ') +' | '+
                      fPadC(FloatToStrf(arrMatItens[LIdx].fltQtdIte, ffFixed, 12, 2), 14, ' ') +' | '+
                      fPadC(FloatToStrf(LVolumeItem , ffFixed, 12, 2), 14, ' '));
      end;
      LMensagem.Add('');
      LMensagem.add(fPadL('Volume Total: ', 71, ' ')+ fPadC(FloatToStrf(LVolumeTotal, ffFixed, 12, 2), 14, ' '));

      TfrmMemo.pShowMessage(LMensagem);

      FreeAndNil(LMensagem);
    end;

  until (LOpcaoEscolhida = 1) or (LOpcaoEscolhida = 2);
end;

function TFatVenda.fGetVolumeCalculadoItem(ACodigoItem: String): Double;
Var
  LIdx : Integer;
Begin
  Result := 0;

  For LIdx := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    if ACodigoItem <> arrMatItens[LIdx].strCodIte then
      continue;

    If not arrMatItens[LIdx].blnExp_CX Then
      Result := Result + fCalcVolumes(ACodigoItem, arrMatItens[LIdx].fltQtdIte, arrMatItens[LIdx].fltEmbala);

    Break;
  End;
end;

