procedure TFatVenda.pTotalizaDescontoEspecialDoPedidoBxEntFutura(const strAutInc: String; const fltDescontoEspecial: Double);
begin
  If (Not Assigned(Self.dicDesEspItens)) Then
    Exit;

  If (Not Self.blnExpedi) Then
    Exit;

  If (Not Self.blnBaiEntFut) Then
    Exit;

  Self.dicDesEspItens[strAutInc] := fltDescontoEspecial;
  Self.fltDesEsp := Self.fltDesEsp + dicDesEspItens[strAutInc];
