function TFatVenda.fAtualizaTipoBusca(strAutInc,
  strTipBus: String): Boolean;
  Var
    qryAux: TUniQuery;
begin

  Result := True;
  qryAux := fCriaQuery;
  Try
    qryAux.SQL.Add('UPDATE ');
    qryAux.SQL.Add('  FATDOR ');
    qryAux.SQL.Add('SET ');
    qryAux.SQL.Add('  FDO_TIPBUS = :TIPBUS ');
    qryAux.SQL.Add('WHERE ');
    qryAux.SQL.Add('  AUTOINCREM = :AUTINC ');

    qryAux.ParamByName('TIPBUS').AsString := strTipBus;
    qryAux.ParamByName('AUTINC').AsString := strAutInc;
    qryAux.ExecSQL;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fAtualizaTipoBusca]');
    End;
  End;

  FreeAndNil(qryAux);

end;

function TFatVenda.fAumentouDesconto: Boolean;
begin
  Result := (fltPorDes > fltPorDesAnt) Or
            (fltDesEsp > fltDesEspAnt);
end;

