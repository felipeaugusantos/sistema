        Begin
          Result := False;
          Break;
        End;

        arrMatItens[intContador].strAutIncTdt := strAutIncTdt;

        If Assigned(fTipoTinta) Then
        Begin
          If (fTipoTinta(arrMatItens[intContador].strIdePro) in [ttAutomotiva, ttIndustrial]) Then
          Begin
            arrMatItens[intContador].fltPesoIt := 0;
            arrMatItens[intContador].fltPesLiq := 0;
          End;
        End;

        For intContador2 := 0 To Length(arrBaixaPigmentos) -1 Do
        Begin

          If Assigned(fTipoTinta) Then
          Begin
            If (fTipoTinta(arrMatItens[intContador].strIdePro) in [ttAutomotiva, ttIndustrial]) Then
            Begin
              arrMatItens[intContador].fltPesoIt := arrMatItens[intContador].fltPesoIt + arrBaixaPigmentos[intContador2].fltQtdBaixa;
              arrMatItens[intContador].fltPesLiq := arrMatItens[intContador].fltPesLiq + arrBaixaPigmentos[intContador2].fltQtdBaixa;
            End;
          End;

        End;

        If Assigned(fTipoTinta) Then
        Begin
          If (fTipoTinta(arrMatItens[intContador].strIdePro) in [ttAutomotiva, ttIndustrial]) Then
          Begin
            arrMatItens[intContador].fltPesoIt := fFormataFloat((arrMatItens[intContador].fltPesoIt / 1000) + IfNull(fRetPesBru(arrMatItens[intContador].strIteEmb), 0), 4);
            arrMatItens[intContador].fltPesLiq := fFormataFloat((arrMatItens[intContador].fltPesLiq / 1000) + IfNull(fRetPesBru(arrMatItens[intContador].strIteEmb), 0), 4);
          End;
        End;

        (**********************************************************************************************************)
        {* SOMENTE SERÁ BAIXA DE ESTOQUE DE TINTA DE MAQUINA QUANDO A CONFIGURACAO DA TINTA "USAFOR" ESTIVER = S. *}
        {* QUANDO A CONFIGURACAO "USAFOR" ESTIVER = N ENTAO NAO BAIXA A FORMULACAO.                               *}
        {* TINDET SERÁ SEMPRE GRAVADO NORMALMENTE PARA PODER GERAR ORDEM DE PRODUCAO E IMPRESSAO DE ETIQUETA      *}
        {* DE TINTA DE MAQUINA.                                                                                   *}
        (*******************************************************************************************************AC*)
        If ((Assigned(fTintaGeraFormulacao)) Or (fCfgSis('MODFOR') = '1')) And (Not blnBaiEntFut) Then
        Begin
          If (fTintaGeraFormulacao(arrMatItens[intContador].strIdePro)) Or (fCfgSis('MODFOR') = '1') Then
          Begin

            For intContador2 := 0 To Length(arrBaixaPigmentos) -1 Do
            Begin
              If (strOprFlj <> 'S') And ((Not blnImpPafEcf) or (fCfgSis('ESTSOC') = 'S')) Then
              Begin
                strNumLot := '';

                If fUsaRotinaWMS(VS_strCodEmp) Or fCfgSis('TMQLOT', varBoolean) Then
                  strNumLot := objCadLot.fRetLotePrincipalTintaMaquina(arrBaixaPigmentos[intContador2].strCodIte, VS_strCodEmp);

                If (Not fAtualizaEstoqueML(arrBaixaPigmentos[intContador2].strCodIte,
                                           arrBaixaPigmentos[intContador2].fltQtdBaixa*arrMatItens[intContador].fltQtdIte,
                                           strNumLot)) Then
                Begin
                  Result := False;
                  Break;
                End;
              End;
            End;

            If (Result) And (strOprFlj <> 'S') Then
            Begin
              Result := fGTraIte(arrBaixaPigmentos, arrMatItens[intContador].strIdePro,
                arrMatItens[intContador].fltQtdIte, arrMatItens[intContador].strClaFis,
                arrMatItens[intContador].stlDetMls);

              If Not Result Then
                Break;
            End;

            If Not Result Then
              Break;

          End;
        End;

      End;

      FreeAndNil(stlItensTraMl);

      (******************************************)
      (* PARA SALVAR O PESO DO ITEM DAS TINTAS  *)
      (***************************************LA*)
      pAtualizaTemporariaItens(cdsVenda);
      (***************************************************************************************************)
      {* FOI COMENTADO PORQUE NA CONFIRMACAO EM NOTA DE UMA VENDA, O SISTEMA ABRE A TELA PARA EDITAR DOS *}
      {* DADOS FISCAIS. SE O CLIENTE INFORMAR NESTE MOMENTO O PESO LIQUIDO E PESO BRUTO                  *}
      {* ESTAS INFORMACOES NAO APARECEM NA NF.                                                           *}
      (***********************************************************************************2012-05-17***PE*)
      //pCalculaPesBruLiq;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message,'[fGArqTin]');
      End;
    End;
  Finally
    If Not fEmptyStr(strEmpSav) Then
      pSetaEmpresaLogada(strEmpSav);
    FreeAndNil(stlItensTraMl);
  End;
end;

