function TFatVenda.fValidaQuantSerieItens(): Boolean;
begin
  Result := True;

  If Not fCfgSis('NSERQT', varBoolean) Then
    Exit;

  If strNumOrc.IsEmpty Then
    Exit;

  If Not fPedidoUsaNumeroDeSerie(strNumOrc, strEspOrc, strEmpOri) Then
    Exit;

  cdsVenda.DisableControls;
  Try
    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      If (IfEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString, VS_strCodEmp) = VS_strCodEmp) Then
      Begin
        If fProdutoUsaNumeroDeSerie(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
        Begin
          Self.objFatSerieItem.AutoincItem := IIF(fEmptyStr(cdsVenda.FieldByName('ITE_SEQDET').AsString),cdsVenda.FieldByName('AUTOINCREM').AsString,cdsVenda.FieldByName('ITE_SEQDET').AsString);
          Self.objFatSerieItem.pFiltraDataSet;

          If Not SameValue(fFormataFloat(Self.objFatSerieItem.fGetTotQuant, fCfgSis('DECQTD', varInteger)),
                           fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fCfgSis('DECQTD', varInteger))) Then
          Begin
            pMensagemOk('A quantidade total das séries está divergente da quantidade do item "'+ cdsVenda.FieldByName('ITE_CODITE').AsString +'-'+ cdsVenda.FieldByName('ITE_DESITE').AsString +'".'+
              sLineBreak + '-Quantidade informada: '+ FloatToStrF(Self.objFatSerieItem.fGetTotQuant, ffFixed, 12, fCfgSis('DECQTD', varInteger)) +
              sLineBreak + '-Quantidade do Pedido: '+ FloatToStrF(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)));

            Result := False;
            Break;
          End;
        End;
      End;
      cdsVenda.Next;
    End;
  Finally
    cdsVenda.EnableControls;
  End;
end;

function TFatVenda.fVerificaQuantidadeItensCupom(): Boolean;
  Var
    strItensTravarIF: String;
begin
  Result := True;
  strItensTravarIF := '';

  If Self.strEspDoc <> 'IF' Then
    Exit;

  if not fCfgSis('USNFCE', varBoolean) then
  begin
    cdsVenda.First;
    While (Not cdsVenda.Eof) Do
    Begin
      If fFormataFloat(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, 3) > fFormataFloat(MAX_QUANTIDADE_CUPOM,3) Then
      Begin
        strItensTravarIF := strItensTravarIF + cdsVenda.FieldByName('ITE_DESITE').AsString + #13#10;
      End;

      cdsVenda.Next;
    End;
  end;

  If Not fEmptyStr(strItensTravarIF) Then
  Begin
    Result := False;
    TfrmObservacao.fObservacao('Itens com quantidade acima de ' + FloatToStrF(MAX_QUANTIDADE_CUPOM, ffFixed, 15, 3) + ':', strItensTravarIF);
  End;

end;

