function fValidarQuantidadeSeparadaVsExpedidaWMS(AParams: TExpedicaoParams): Boolean;
var
  strIteErroSep: String;
  objLiberacao: TLiberacao;

  function fPedeLiberacao : Boolean;
  begin

    Result := False;
    objLiberacao := TLiberacao.Create;

    Try

      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Permitir expedição de produtos com quantidade diferente da quantidade separada WMS');
      objLiberacao.objMsgLibera.pAddTextoCaption('Produtos: ',strIteErroSep + '.');

      objLiberacao.strDirAce := 'EXDFSE';
      objLiberacao.strMsgSen := 'Permitir expedição de produtos com quantidade diferente da quantidade separada WMS';
      objLiberacao.blnMosMen := True;
      objLiberacao.strCodOpe := strLoginUsuarioLogado;

      If objLiberacao.fLibera Then
      Begin
        Result := True;
        AParams.blnPermitiuLiberouExpedirQuantidadeDiferenteSeparadaWMS := True;
      End;

    Finally
      objLiberacao.Free;
    End;

  end;

  function fTrava : Boolean;
  begin
    Result := False;
    fMensagem('', 'Há produtos com a quantidade conferida diferente da ' +
                  'quantidade definida na impressão da separação! ' + #13#10 +
                  'Por favor, verifique os produtos: ' + strIteErroSep + '.' + #13#10 +
                  'Caso a quantidade fisica não foi suficiente para atender o pedido, reimprima a separaçao e informe a quantidade separada igual ao estoque físico.', ['&Ok']);

  end;

begin
  Result := True;
  AParams.blnPermitiuLiberouExpedirQuantidadeDiferenteSeparadaWMS := False;

  //Somente deve expedir a quantidade que foi separada quando rotina WMS

  If Not AParams.blnUsaRotinaWMS Then
    Exit;

  If AParams.blnExpedicaoDocumentoFaturadoAutomaticamente Then
    Exit;

  {** F11 - Faturar Expedidos **}
  If (Not fValidaQuantidadeSeparadaWMS(AParams, strIteErroSep)) Then
  Begin
    If (fPermiteExpedirQuantidadeDiferenteSeparadaWMS) Then
      Exit(fPedeLiberacao)
    Else
      Exit(fTrava);
  End;

  {** F10 - Expedição Itens **}
  If (Not fPermiteExpedirQuantidadeDiferenteSeparadaWMSF10) Then
    If (Not fValidaQuantidadeSeparadaWMSF10(AParams, strIteErroSep)) Then
      Exit(fPedeLiberacao)

end;

function fAlteraQuantidadeSeparadaWMS(AParams: TExpedicaoParams): Boolean;
  Var
    qryLotDor: TUniQuery;
    fltQtdSep: Double;
    fltQtdExp: Double;
    intDecQtd: Integer;

    function CompararQtdSepColetor : Boolean;
    begin
      Result := (fCfgSis('CPQTCF', varString) = COMPARAR_QTDSEP_COLETOR);
    end;

begin
  Result := True;
  intDecQtd := fCfgSis('DECQTD', varInteger);

  Try
    AParams.cdsItens.First;
    AParams.cdsItens.DisableControls;
    qryLotDor := fCriaQuery(nil);

    While (Not AParams.cdsItens.Eof) Do
    Begin
      if (CompararQtdSepColetor) and (AParams.cdsItens.FieldByName('QTDCOL').AsFloat > 0) then
        fltQtdSep := AParams.cdsItens.FieldByName('QTDCOL').AsFloat
      else
        fltQtdSep := AParams.cdsItens.FieldByName('QTDSEP').AsFloat;

      fltQtdExp := AParams.cdsItens.FieldByName('QTDEXP').AsFloat;

      If (fUsaRotinaWMS) And
         (AParams.cdsItens.FieldByName('PROACA').AsString = 'S') Then
      Begin
        If (fFormataFloat(fltQtdSep, intDecQtd) < fFormataFloat(fltQtdExp, intDecQtd)) Then
          fltQtdSep := fltQtdExp;
      End
      Else
      Begin
        qryLotDor.Close;
        qryLotDor.SQL.Text := 'SELECT * FROM LOTDOR WHERE LDO_SEQFDO = :AUTINC';

        //Se for conferencia depois da entrada (utiliza o coletor)
        //então ordena para remover primeiro os itens que não foram coletados(LDO_SEPCOL)
        if fConferenciaDepoisDaEntrada  And fUsaRotinaWMS Then
          qryLotDor.SQL.Text := qryLotDor.SQL.Text + ' ORDER BY IF(LDO_SEPCOL="N",0,1) ';

        qryLotDor.ParamByName('AUTINC').AsString := AParams.cdsItens.FieldByName('AUTOINCREM').AsString;
        qryLotDor.Open;

        If qryLotDor.IsEmpty Then
        Begin
          Result := False;
          Break;
        End;

        If (fFormataFloat(fltQtdSep, fCfgSis('DECQTD', varInteger)) < fFormataFloat(fltQtdExp, fCfgSis('DECQTD', varInteger))) Then
        Begin

          If CompararQtdSepColetor Then
          Begin

            qryLotDor.First;
            While Not qryLotDor.Eof Do
            Begin
              qryLotDor.Edit;
              qryLotDor.FieldByName('LDO_QTDSEP').AsFloat := fFormataFloat(qryLotDor.FieldByName('LDO_QTDITE').AsFloat, fCfgSis('DECQTD', varInteger));
              qryLotDor.Post;
              qryLotDor.Next;
            End;

          End Else
          Begin

            qryLotDor.Edit;
            If fCfgSis('BPUNSP', varBoolean) Then
            Begin
              If (fltQtdSep = 0.00) Then
                qryLotDor.FieldByName('LDO_QTDITE').AsFloat := fFormataFloat(fltQtdExp, fCfgSis('DECQTD', varInteger))
              Else If (qryLotDor.FieldByName('LDO_QTDITE').AsFloat < fFormataFloat(fltQtdExp, fCfgSis('DECQTD', varInteger))) Then
                qryLotDor.FieldByName('LDO_QTDITE').AsFloat := qryLotDor.FieldByName('LDO_QTDITE').AsFloat + fFormataFloat((fltQtdExp - fltQtdSep), fCfgSis('DECQTD', varInteger));
            End
            Else
            Begin
              qryLotDor.FieldByName('LDO_QTDITE').AsFloat := qryLotDor.FieldByName('LDO_QTDITE').AsFloat + fFormataFloat((fltQtdExp - fltQtdSep), fCfgSis('DECQTD', varInteger));
            End;
            qryLotDor.Post;

          End;

          fltQtdSep := fltQtdExp;

        End
        Else If (fFormataFloat(fltQtdSep, fCfgSis('DECQTD', varInteger)) >= fFormataFloat(fltQtdExp, fCfgSis('DECQTD', varInteger))) Then
        Begin
          fltQtdSep := 0;
          qryLotDor.First;

          While Not qryLotDor.Eof Do
          Begin
            If fFormataFloat((fltQtdExp - fltQtdSep), fCfgSis('DECQTD', varInteger)) <
               fFormataFloat(qryLotDor.FieldByName('LDO_QTDITE').AsFloat, fCfgSis('DECQTD', varInteger)) Then
            Begin
              qryLotDor.Edit;
              qryLotDor.FieldByName('LDO_QTDITE').AsFloat := fFormataFloat((fltQtdExp - fltQtdSep), fCfgSis('DECQTD', varInteger));
              qryLotDor.Post;
            End;
            fltQtdSep := fltQtdSep + qryLotDor.FieldByName('LDO_QTDITE').AsFloat;
            qryLotDor.Next;
          End;

          qryLotDor.Close;
          qryLotDor.SQL.Text := 'DELETE FROM LOTDOR WHERE LDO_SEQFDO = :AUTINC AND LDO_QTDITE = 0.0000';
          qryLotDor.ParamByName('AUTINC').AsString := AParams.cdsItens.FieldByName('AUTOINCREM').AsString;
          qryLotDor.ExecSQL;
        End;
      End;

      AParams.cdsItens.Edit;
      AParams.cdsItens.FieldByName('QTDSEP').AsFloat := fltQtdSep;

      if CompararQtdSepColetor then
        AParams.cdsItens.FieldByName('QTDCOL').AsFloat := fltQtdSep;

      AParams.cdsItens.Post;

      AParams.cdsItens.Next;
    End;

  Finally
    AParams.cdsItens.EnableControls;
    AParams.cdsItens.First;
    FreeAndNil(qryLotDor);
  End;
end;

function fRevalidarQuantidadeSeparadaVsExpedidaWMS(AParams: TExpedicaoParams): Boolean;
var
  strIteErroSep : String;
  strErroLotDor : String;

  function fRetIteSemLotDor: String;
  begin
    Result := '';
    AParams.cdsItens.First;
    While (Not AParams.cdsItens.Eof) Do
    Begin
      If (AParams.cdsItens.FieldByName('QTDEXP').AsFloat > 0) And (fCampoTabela('COUNT(*)', 'LOTDOR', ['LDO_SEQFDO'], [AParams.cdsItens.FieldByName('AUTOINCREM').AsString]) = 0) Then
      Begin
        If Not fEmptyStr(Result) Then
          Result := Result + ', ';

        Result := Result + AParams.cdsItens.FieldByName('CODITE').AsString+' '+
                           'EXP-'+FloatToStr(fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger)));
      End;
      AParams.cdsItens.Next;
    End;
    AParams.cdsItens.First;
  end;

begin
  Result := True;
  If AParams.blnPermitiuLiberouExpedirQuantidadeDiferenteSeparadaWMS Then
  Begin
    Result := fAlteraQuantidadeSeparadaWMS(AParams) And fValidaQuantidadeSeparadaWMS(AParams, strIteErroSep);
    If Not Result Then
    Begin
      fValidaQuantidadeSeparadaWMS(AParams, strIteErroSep);

      strErroLotDor := fRetIteSemLotDor;

      If fEmptyStr(strIteErroSep) And fEmptyStr(strErroLotDor) Then
      Begin
        Result := True;
      End
      Else
      Begin
        fMensagem('', 'Ocorreram divergências mesmo após o ajuste para expedição de itens com quantidade expedida diferente da separada.' + #13#10 +
                      IIF(Not fEmptyStr(strIteErroSep), 'Produtos Com LotDor: ' + strIteErroSep + '.'+ #13#10,'')+
                      IIF(Not fEmptyStr(strErroLotDor), 'Produtos Sem LotDor: ' + strErroLotDor + '.'+ #13#10,''), ['&Ok']);
      End;
    End;
  End;
end;

