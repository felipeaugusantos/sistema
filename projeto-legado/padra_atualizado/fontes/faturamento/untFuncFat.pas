    Begin
      Result := intIndAtual;
      For intIndice := Low(arrLivFis) To High(arrLivFis) Do
        If (arrLivFis[intIndice].strClaFis = strClaAtu) Then
        Begin
          Result := intIndice;
          Exit;
        End;
    End;
begin
  {*****************************************}
  {* INICIO DOS CÁLCULOS ESPECIAIS (QUE    *}
  {* FICAM FORA DA SINTETIZAÇÃO).          *}
  {**************************************MV*}
  If StrToInt(LeftStr(strClaFis, 1)) >= 5 Then
    strEntSai := 'S'
  Else
    strEntSai := 'E';

  If fEhVendaItemConcreto And blnDesmembrarNotaProdutosServicos And
     ((Not MatchStr(fCfgSis('TPNFCR'),[PRESTCON,SECOL])) Or (strOpcDoc = 'CN')) Then
    arrLivFis[fRetIndiceLivroClafis(1, strClaFis[1] + '933')].fltValIss := fltValIss
