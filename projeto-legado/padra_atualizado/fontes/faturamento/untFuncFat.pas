function TFatVenda.fGetInformacoesDoRecebimentoEmCartao : String;
  Var
    strDescricaoCartao : String;
    intContador : Integer;
    strSQL: String;
    qryTemp: TUniQuery;
begin

  strDescricaoCartao := EmptyStr;

  strSQL :=          'SELECT DISTINCT                    ';
  strSQL := strSQL + '  A.ADT_ADTORI,                    ';
  strSQL := strSQL + '  R.CAR_DESCAR,                    ';
  strSQL := strSQL + '  C.MCA_NUMCCD,                    ';
  strSQL := strSQL + '  C.MCA_NUMNSU                     ';
  strSQL := strSQL + 'FROM                               ';
  strSQL := strSQL + '  ADTCLI A                         ';
  strSQL := strSQL + '  LEFT JOIN MOVCAR C               ';
  strSQL := strSQL + '    ON C.MCA_SEQADT = A.ADT_ADTORI ';
  strSQL := strSQL + '  LEFT JOIN CADCAR R               ';
  strSQL := strSQL + '    ON C.MCA_CODCAR = R.CAR_CODCAR ';
  strSQL := strSQL + 'WHERE ADT_NUMDOC = ' + QuotedStr(arrMatItens[0].strNumOrc) + '';
  strSQL := strSQL + '  AND ADT_ESPDOC = ' + QuotedStr(arrMatItens[0].strEspOrc) + '';
  strSQL := strSQL + '  AND ADT_CODEMP = ' + QuotedStr(arrMatItens[0].strEmpOrc) + '';
  strSQL := strSQL + '  AND ADT_TIPLAN = "C" ';

  qryTemp := fCriaQuery(nil);

  Try
    qryTemp.Close();
    qryTemp.SQL.Clear();
    qryTemp.SQL.Text := strSQL;
    qryTemp.Open;

    while not qryTemp.Eof do
    begin
      if not fEmptyStr(strDescricaoCartao) then
        strDescricaoCartao := strDescricaoCartao + ', ';
      strDescricaoCartao := strDescricaoCartao + qryTemp.FieldByName('CAR_DESCAR').asString +
                                                 ' - NSU: ' + qryTemp.FieldByName('MCA_NUMNSU').asString +
                                                 ' - AUT: ' + qryTemp.FieldByName('MCA_NUMCCD').asString ;
      qryTemp.Next;
    end;

  Finally
    FreeAndNil(qryTemp);
  End;

  for intContador := 0 To Length(arrCartoes)-1 Do
  begin
    if fEmptyStr(arrCartoes[intContador].strCodCar) Then
      Continue;
    if not fEmptyStr(strDescricaoCartao) then
      strDescricaoCartao := strDescricaoCartao + ', ';
    strDescricaoCartao := strDescricaoCartao + arrCartoes[intContador].strDesCar +
                                               ' - NSU: ' + arrCartoes[intContador].strNumNsu +
                                               ' - AUT: ' + arrCartoes[intContador].strNumCcd;
  end;

  Result := strDescricaoCartao;

end;

function TFatVenda.fGetInformacoesDoRecebimentoEmCartaoDeCredito : String;
  Var
    strNumeroAutorizacao : String;
    intContador : Integer;
    intParcelas : Integer;
begin
  Result := EmptyStr;
  If (Length(arrCartoes) = 0) Then
    Exit;
  For intContador := 0 To Length(arrCartoes)-1 Do
  Begin
    If fEmptyStr(arrCartoes[intContador].strCodCar) Then
      Continue;
    If (fRetTipoCartao(arrCartoes[intContador].strCodCar) <> 'C') Then
      Continue;
    If (fCfgSis('TPNUAU', varString) = '1') Then
      strNumeroAutorizacao := arrCartoes[intContador].strNumCcd
    Else
      strNumeroAutorizacao := arrCartoes[intContador].strNumNsu;
    If (Not fEmptyStr(Result)) Then
      Result := Result + sLineBreak;
    intParcelas := StrToIntDef(LeftStr(arrCartoes[intContador].strCndPag, 2), 0);
    If (intParcelas > 1) Then
      Result := Result + Format('CARTÃO DE CRÉDITO PARCELADO EM %d VEZES. AUTORIZAÇÃO: %s', [intParcelas, strNumeroAutorizacao])
    Else
      Result := Result + Format('CARTÃO DE CRÉDITO PARCELADO EM 1 VEZ. AUTORIZAÇÃO: %s', [strNumeroAutorizacao]);
  End;
end;

function TFatVenda.fGetInformacoesDoRecebimentoEmCartaoDeDebito : String;
  Var
    strNumeroAutorizacao : String;
    intContador : Integer;
begin
  Result := EmptyStr;
  If (Length(arrCartoes) = 0) Then
    Exit;
  For intContador := 0 To Length(arrCartoes)-1 Do
  Begin
    If fEmptyStr(arrCartoes[intContador].strCodCar) Then
      Continue;
    If (fRetTipoCartao(arrCartoes[intContador].strCodCar) <> 'D') Then
