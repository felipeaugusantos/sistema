function TFatVenda.fItensObrNfe(blnMostraItens: Boolean; blnForcaVerificacao: Boolean): Boolean;
  Var
    qryTmp: TUniQuery;
    strProdutos: String;
    intIndex: Integer;
begin

  Result:=False;

  If blnForcaVerificacao Or (strEspDoc = 'IF') Or (fCfgSis('PAFECF', varBoolean) And (Self.blnGravarDavPv)) Then
  Begin

    Try

      qryTmp := fCriaQuery;

      Try

        For intIndex := 0 to Length(arrMatItens) -1 Do
        Begin
          If (Pos(arrMatItens[intIndex].strCodIte, strProdutos) <= 0) Then
            strProdutos := strProdutos + IIF(fEmptyStr(strProdutos),'',', ') + quotedStr(arrMatItens[intIndex].strCodIte);
        End;

        If Not fEmptyStr(strProdutos) Then
        Begin
          if fCfgSis('NFEPEP', varBoolean) then
          begin
            qryTmp.Close;
            qryTmp.SQL.Clear;
            qryTmp.SQL.Add(' SELECT       ');
            qryTmp.SQL.Add('  ITE_CODITE  ');
            qryTmp.SQL.Add(' FROM ITEGER  ');
            qryTmp.SQL.Add(' WHERE ');
            qryTmp.SQL.Add(' ITE_CODITE IN (' + strProdutos + ')');
            qryTmp.SQL.Add(' AND ITE_OBRNFE = "S" ');
            qryTmp.SQL.Add(' AND ITE_CODEMP = ' + quotedStr(VS_strCodEmp));
            qryTmp.Open;
          end
          else
          begin
            qryTmp.Close;
            qryTmp.SQL.Clear;
            qryTmp.SQL.Add(' SELECT       ');
            qryTmp.SQL.Add('  ITE_CODITE ');
            qryTmp.SQL.Add(' FROM CADITE  ');
            qryTmp.SQL.Add(' WHERE ');
            qryTmp.SQL.Add(' ITE_CODITE IN (' + strProdutos + ')');
            qryTmp.SQL.Add(' AND ITE_OBRNFE = "S" ');
            qryTmp.Open;
          end
        End;

        Result := ((qryTmp.Active) And (qryTmp.RecordCount > 0));

        If (Result) And (blnMostraItens) Then
        Begin

          fMensagem('', 'Existem itens com obrigatoriedade de NFe. Verifique!', ['&OK']);

          If Assigned(prcExecutaRelatorio) Then
          begin
            prcExecutaRelatorio(139, 6464, [],
                                ['STRITE'],
                                [strProdutos],
                                nil,
                                nil,
                                True);

          End;

        End;

      Except

        On E: Exception Do
          pMensagensErro(E.Message, '[TFatVenda.fItensObrNfe]');

      End;

    Finally
      FreeAndNil(qryTmp);
    End;

  End;

end;

