procedure TFatVenda.pCarregaEstruturaVidrosPedOrc;
  Var
    strTabPed: String;
    prcScroll: TprcScroll;
begin
  If Not Assigned(objEstruturaVidros) Then
    Exit;

  Try
    pDisableControls(cdsVenda, prcScroll);

    If Assigned(pgbStatusGravacao) Then
    Begin
      pgbStatusGravacao.Position := 0;
      pgbStatusGravacao.Properties.Max := cdsVenda.RecordCount;
    End;

    //Salva a tabela de preco do pedido
    strTabPed := Self.strTabPre;

    //Carrega os dados do cliente - necessario para definir a aliquota de icms
    pCarregarClientePedidoOrcamento(Self);

    //Restaura a tabela de preco do pedido
    Self.strTabPre := strTabPed;

    //Define a aliquota de icms e o cfop do estado do cliente
    pPegaDadosFiscais(fTrocaUFEndEntrega, strCliIes, strMicEmp, fGetUFEmpresa(''), True);

    cdsVenda.First;

    While (Not cdsVenda.Eof) Do
    Begin
      pStepStatusGravacao;
      pInfoStatusGravacao('Aguarde... Calculando Tabelas de Preços Vidros...' +
        intToStr(cdsVenda.RecNo) + '/' + intToStr(cdsVenda.RecordCount));

      pCarregaEstruturaItemVidroPedOrc(cdsVenda.FieldByName('ITE_SEQDET').AsString);

      cdsVenda.Next;
    End;

    cdsVenda.First;

  Finally
    pEnableControls(cdsVenda, prcScroll);
  End;

end;

