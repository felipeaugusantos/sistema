function TFatVenda.fCopiarLocaisArmColetor(strNumPed, strEspPed,
  strEmpPed: String): Boolean;
var
  LQryExtLar: TUniQuery;
  LQryMovLar: TUniQuery;
  LAutIncremPed: String;
begin
  Result := True;
  if fEmptyStr(strAutInc) then
    Exit;

  LAutIncremPed := fCampoTabela('AUTOINCREM', 'FATGOR', ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'], [strNumPed, strEspPed, strEmpPed]);

  if fEmptyStr(LAutIncremPed) then
    Exit;

  LQryExtLar := fCriaQuery;
  LQryMovLar := fCriaQuery;
  try
    LQryExtLar.SQL.Add('SELECT SEQ_CODLAR FROM EXTLAR WHERE COD_FATGOR = :FATGOR');
    LQryExtLar.ParamByName('FATGOR').AsString := LAutIncremPed;
    LQryExtLar.Open;

    LQryMovLar.SQL.Add('SELECT * FROM MOVLAR');
    LQryMovLar.SQL.Add('WHERE LAM_SEQGER = :SEQGER');
    LQryMovLar.SQL.Add('  AND LAM_CODLAR = :CODLAR');

    while not LQryExtLar.Eof do
    begin
      LQryMovLar.Close;
      LQryMovLar.ParamByName('SEQGER').AsString := strAutInc;
      LQryMovLar.ParamByName('CODLAR').AsString := LQryExtLar.FieldByName('SEQ_CODLAR').AsString;
      LQryMovLar.Open;

      if LQryMovLar.IsEmpty then
      begin
        LQryMovLar.Append;
        LQryMovLar.FieldByName('AUTOINCREM').AsString := fRetAutoIncrem('MOVLAR', strEmpDoc);
        LQryMovLar.FieldByName('LAM_SEQGER').AsString := strAutInc;
        LQryMovLar.FieldByName('LAM_CODLAR').AsString := LQryExtLar.FieldByName('SEQ_CODLAR').AsString;
        LQryMovLar.Post;
      end;

      LQryExtLar.Next;
    end;
  finally
    FreeAndNil(LQryMovLar);
    FreeAndNil(LQryExtLar);
  end;
end;

