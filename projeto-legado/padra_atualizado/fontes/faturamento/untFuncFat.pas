function TFatVenda.fGetProfissionaisVenda: TProfissionaisVenda;
begin
  SetLength(Result, 0);

  //1 profissional
  If (fCfgSis('NROPRO') = '2') Then
  Begin
    SetLength(Result, Length(Result) + 1);
    Result[Length(Result) - 1].strCodDiv := strCodDiv;

   //Comissão do profissional por quantidade de pontos do cadastro de produtos
    If (VS_strTCoPro = '3') Then
      Result[Length(Result) - 1].fltQtdPon := fCalcTotPontosProfiss(strCodDiv);
  End

  //Mais de um profissional
  Else If (fCfgSis('NROPRO') = '3') Then
  Begin

    With cdsProfiss Do
    Begin
      If Assigned(cdsProfiss) And Active And (Not IsEmpty) Then
      Begin
        First;

        While Not Eof Do
        Begin
          SetLength(Result, Length(Result) + 1);
          Result[Length(Result) - 1].strCodDiv := Fieldbyname('DIV_CODDIV').AsString;

          //Comissão do profissional por quantidade de pontos do cadastro de produtos
          If (VS_strTCoPro = '3') Then
            Result[Length(Result) - 1].fltQtdPon := fCalcTotPontosProfiss(Fieldbyname('DIV_CODDIV').AsString);

          Next;
        End;

      End;
    End;

  End;

end;

