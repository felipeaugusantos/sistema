function TFatVenda.fAtualizaEstoqueDevBasePigmento(strEntSai,
                                                   strCodAca,
                                                   strEmpAca,
                                                   strDocDev,
                                                   strEspDev,
                                                   strEmpDev: String;
                                                   fltQtdIte,
                                                   fltQtdDet: Double;
                                                   strTabDev: String): Boolean;
  Var
    qryGen: TUniQuery;
    strAutIncML, strNumDocML: String;
    fltQtdDev: Double;
    strDocFut: string;
    strEspFut: string;
    strEmpFut: string;

    //Quantidade Total doc. de venda
    fltQtdTot: Double;
Begin
  Try
    Result := True;

    fltQtdTot := 0;

    qryGen := fCriaQuery;
    With qryGen, SQL Do
    Begin
      If SameText(strTabDev, 'NOTDET') Then
      begin
        Text :=
          ' SELECT                            ' +
          '   D.*                             ' +
          ' FROM                              ' +
          '   MOVDET D                        ' +
          '   INNER JOIN MOVGER G             ' +
          '     ON G.GER_JAFATU = 1           ' +
          '     AND G.GER_NUMFAT = :NUMFAT    ' +
          '     AND G.GER_TIPFAT = :TIPFAT    ' +
          '     AND G.GER_EMPFAT = :EMPFAT    ' +
          ' WHERE D.DET_NUMFAT = G.GER_NUMDOC ' +
          '   AND D.DET_TIPFAT = G.GER_ESPDOC ' +
          '   AND D.DET_EMPFAT = G.GER_CODEMP ' +
          '   AND D.DET_JAFATU = 1            ' +
          '   AND D.DET_ESPDOC = "ML"         ' +
          '   AND D.DET_CODACA = :CODACA      ' +
          '   AND D.DET_EMPACA = :EMPACA      ';
      end
      else
      begin
        Text :=
          ' SELECT                       ' +
          '   D.*                        ' +
          ' FROM                         ' +
          '   MOVDET D                   ' +
          ' WHERE D.DET_JAFATU = 1       ' +
          '   AND D.DET_ESPDOC = "ML"    ' +
          '   AND D.DET_NUMFAT = :NUMFAT ' +
          '   AND D.DET_TIPFAT = :TIPFAT ' +
          '   AND D.DET_EMPFAT = :EMPFAT ' +
          '   AND D.DET_CODACA = :CODACA ' +
          '   AND D.DET_EMPACA = :EMPACA ';
      end;

      pPegaDocumentoEntregaFutura(strDocDev, strEspDev, strEmpDev, strDocFut, strEspFut, strEmpFut, strCodAca, strEmpAca);

      ParamByName('EMPACA').AsString := strEmpAca;
      ParamByName('CODACA').AsString := strCodAca;

      if fEmptyStr(strDocFut) then
      begin
        ParamByName('NUMFAT').AsString := strDocDev;
        ParamByName('TIPFAT').AsString := strEspDev;
        ParamByName('EMPFAT').AsString := strEmpDev;
      end
      else
      begin
        ParamByName('NUMFAT').AsString := strDocFut;
        ParamByName('TIPFAT').AsString := strEspFut;
        ParamByName('EMPFAT').AsString := strEmpFut;
      end;

      Open;

      If Not IsEmpty Then
        Result := fGravaMovGerDevML(strAutIncML, strNumDocML);

      If (Not blnDevolucaoCompleta) Or (Not fEmptyStr(strDocFut)) Then
      Begin
        If fEmptyStr(strDocFut) Then
          fltQtdTot := fRetDevolucaoQuantidadeTotal(strDocDev, strEspDev, strEmpDev, strCodAca, strEmpAca)
        Else
          fltQtdTot := fRetDevolucaoQuantidadeTotal(strDocFut, strEspFut, strEmpFut, strCodAca, strEmpAca);
      End;

      While Not Eof Do
      Begin

        If Not Result Then
          Break;

        If fltQtdTot = 0 Then
          fltQtdTot := fltQtdDet;

        fltQtdDev := (fltQtdIte / fltQtdTot) * FieldByName('DET_QTDITE').AsFloat;

        Result := fAtualizaEstoqueML(FieldByName('DET_CODITE').AsString,
                                     IIF(strEntSai = 'E', -1, 1) * fltQtdDev,
                                     FieldByName('DET_NUMLOT').AsString) And
                  fGravaMovGDetDevML(strAutIncML, strNumDocML, fltQtdDev, qryGen);

        Next;

      End;

      Close;

    End;

    FreeAndNil(qryGen);

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fAtualizaEstoqueDevBasePigmento]');
    End;
  End;
End;

function TFatVenda.fAtualizaPedidoComoJaExpedido(strAutGor: String): Boolean;
  Var
    strSQL: String;
    qryUpd: TUniQuery;
    blnExpedido: Boolean;
begin
  Result := True;
  Try

    blnExpedido := fPedidoExpedido(strAutGor);

    strSQL := '';
    strSQL := strSQL + 'UPDATE   ';
    strSQL := strSQL + '  EXTGOR ';
    strSQL := strSQL + 'SET      ';
    strSQL := strSQL + '  FGO_OPEEXP = :OPEEXP, ';
    strSQL := strSQL + '  FGO_SEPEXP = :SEPEXP  ';
//    strSQL := strSQL + '  FGO_OBSEXP = :OBSEXP  ';

    If blnExpedido Then
    Begin
      strSQL := strSQL + '  ,FGO_DTLBEX = :DTLBEX  ';
      strSQL := strSQL + '  ,FGO_HRLBEX = :HRLBEX  ';
    End;

    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  FGO_SEQFGO = :AUTINC ';

    Try
      qryUpd := fCriaQuery(Self);

      With qryUpd Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('OPEEXP').AsString := strCodVen;
        ParamByName('SEPEXP').AsString := strCodVe2;
//        ParamByName('OBSEXP').AsString := strObsExp;

        If blnExpedido Then
        Begin
          ParamByName('DTLBEX').AsDate := VS_Date;
          ParamByName('HRLBEX').AsTime := fRetHoraServidor;
        End;

        ParamByName('AUTINC').AsString := strAutGor;

        ExecSQL;
      End;
    Finally
      FreeAndNil(qryUpd);
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, 'fAtualizaPedidoComoJaExpedido');
    End;
  End;
end;

function TFatVenda.fIsTintaDisponivelEmpresa(const strIdePro: string; const strCodEmp: string): Boolean;
var
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Result := false;
  Try
    Try
      qryGen := fCriaQuery();
      qryGen.SQL.Text :=
        ' SELECT                                ' +
        '   COUNT(0) AS QTD                     ' +
        ' FROM                                  ' +
        '   CADEMP                              ' +
        ' WHERE LOCATE(:IDEPRO, EMP_TINDIS) > 0 ' +
        '   AND EMP_CODEMP = :CODEMP            ';
      qryGen.ParamByName('IDEPRO').AsString := strIdePro;
      qryGen.ParamByName('CODEMP').AsString := strCodEmp;
      qryGen.Open;

      Result := qryGen.FieldByName('QTD').AsInteger > 0;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

function TFatVenda.fGMovDet: Boolean;
  Var
    strEntSai: String;
    strIdePro: String;
    intContador: Integer;
    strEmpSel: String;
    strEmpAtu: String;
    strNumLot: String;
    intQtdEmp: Integer;
    blnBaixarEmbDev: Boolean;
    objCadLot: TCadLot;
    strTabela: String;
    intCnt : Integer;
    objOrdenarItensParaGravacao: TOrdenarItensParaGravacao;
    blnAtualizarTipBus : boolean;
    strProdutos : String;
    strMsgOcorr : String;
    objMovDetOcoCrm : TAtuOcoCrm;
    strEmpSav: String;
    blnUsaChapinhaTinta: Boolean;
    strCodChapinha: String;
    blnDvChapinha: Boolean;
    AUsarBatchSaldos: Boolean;
    AUsarBatchSaldosItem: Boolean;
    strAutIncMovDet : String;
begin

  Try
    Result := False;

    blnBaixarEmbDev := False;
    strCodChapinha := '';
    FstrTabelaReformaGravada := 'MOVREF';

    AUsarBatchSaldos := (Not VS_blnNotificaSaldoAbaixMinimo) And (Not FblnTravarSeSaldoFicarNegativo);
    If AUsarBatchSaldos Then
      AUsarBatchSaldos := (Not fMatrizTemCodIteRepetidos);

    fltVlrCom := 0;
    fltFatCom := 0;
    fltVlrExt := 0;
    fltFatExt := 0;
    strEmpSel := '';
    intQtdEmp := 0;

  {****************************************************}
  {* PESQUISA SE EXISTEM MAIS DE UMA EMPRESA DENTRE   *}
  {* OS PEDIDOS DOS ITENS FATURADOS PARA SETAR A EM-  *}
  {* PRESA ORIGEM DA DUPLICATA                        *}
  {*************************************************IV*}
    For intContador := 0 To Length(arrMatItens) -1 Do
    Begin
      //Retorna o autoincremento dos itens para gravacao da tabela MOVDET
      If (intContador = 0) Then
        strAutIncMovDet := fRetAutoIncrem('MOVDET', VS_strCodEmp, Length(arrMatItens))
      Else
        strAutIncMovDet := fNextAutoIncrem(strAutIncMovDet);
      arrMatItens[intContador].strAutoincrementoGravacao := strAutIncMovDet;

      If Pos(arrMatItens[intContador].strEmpOrc, strEmpSel) <= 0 Then
      Begin
        strEmpAtu := arrMatItens[intContador].strEmpOrc;
        strEmpSel := strEmpSel + arrMatItens[intContador].strEmpOrc + '_';
        Inc(intQtdEmp);
      End;
    End;

    If intQtdEmp > 1 Then
      strEmpRec := VS_strCodEmp
    Else
      If intQtdEmp = 1 Then
        strEmpRec := strEmpAtu
      Else
        strEmpRec := '';

    strDocDevOF := '';
    strEspDevOF := '';

    If (Pos(strClaFis, VS_strClaVen) > 0) And (Pos(strOpcDoc, 'VN_CP_DV_') > 0) Then
      TPromocaoBrindes.pCalculaPontosGeradosVenda(arrMatItens, strOpcDoc);


    Try
      untMovGer.objReprocessarSaldoItens := TReprocessarSaldoItem.New();

      objOrdenarItensParaGravacao := TOrdenarItensParaGravacao.Create;

      objOrdenarItensParaGravacao.pSalvarOrdemMatrizItens(arrMatItens);
      objOrdenarItensParaGravacao.pOrdenarItensPorCodigo(arrMatItens);

      //Atualiza a matriz de itens ja ordenada por codigo de produto
      For intContador := 0 To Length(arrMatItens) -1 Do
        arrMatItens[intContador] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intContador];

      if fEhRecGarantia then
      begin
        TControleChavesGarantia.strOpcDoc := strOpcDoc;
        TControleChavesGarantia.strTipMod := 'F';
        TControleChavesGarantia.pReiniciarProcessoGarantia;
      end;

      For intContador := 0 To Length(arrMatItens) -1 Do
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Produto ' + intToStr(Succ(intContador)) + '/' + intToStr(Length(arrMatItens)), True);
        blnDvChapinha := False;

        {*********************************************************************************************}
        {* QD PERMITIR MAIS DE UM PROFISSIONAL PEGA O PRIMEIRO PROFISS INCLUSO PARA SALVAR NA MOVDET *}
        {******************************************************************************************LU*}
        If (fCfgSis('NROPRO') = '3') And (Assigned(cdsProfiss)) And (cdsProfiss.Active) Then
        Begin
          If (cdsProfiss.IsEmpty) Then
            strCodDiv := ''
          Else
          Begin
            cdsProfiss.First;
            strCodDiv := cdsProfiss.fieldbyname('DIV_CODDIV').AsString;
          End;
        End;

        intContMat := intContador;

        Result := fGDadMovDet(OPC_GRAVAMOVDET_PROD_NORMAL);

        //Quando for entrega futura e o configurado para emitir entrega futura dos sub itens nao vamos gerar a ordem de producao
        If Result And (arrMatItens[intContador].strBxSbIt = 'S') And (arrMatItens[intContador].strEntFut = 'S') And (fCfgSis('EFTEST') = '2') Then
        Begin
          Result := fGravaSubItensEntFutItemEstrutura(arrMatItens[intContador]);
        End;

        If (Result) And (strEntreg = 'S') Then
        Begin
          Result := fGEntDet(intContMat);
        End;

        If Not Result Then
          Break;

        If Self.Fulfillment.EhOperacaoFulfillment And (Not fEmptyStr(strFilKar_EntSai)) Then
          strEntSai := strFilKar_EntSai
        Else
          strEntSai := IIF(StrToInt(LeftStr(arrMatItens[intContador].strClaFis, 1)) < 5, 'E', 'S');

        strIdePro := arrMatItens[intContador].strIdePro;

        if not fMantemLoteInformadoEmCasoDeAbastecimentoDeposito(blnAbastecimentoDeposito) then
        begin
          if fAjustaLoteAbastecimentoDeposito(blnEhDevolucaoAbastecimentoDeposito) then
            arrMatItens[intContador].strNumLot := IfEmptyStr(arrMatItens[intContador].strNumLot, 'A DEFINIR')
          else if blnAbastecimentoDeposito or blnRegimeEspecialPorEmpresaComFaturamentoDuplo then
            arrMatItens[intContador].strNumLot := EmptyStr;
        end;

        AUsarBatchSaldosItem := AUsarBatchSaldos And (strIdePro = 'NOR');

        If ((Not blnImpPafEcf) or (fCfgSis('ESTSOC') = 'S')) and blnAtualizaEstoqueCadIte Then
        Begin
             {CASO NAO SEJA BAIXA DE ENTREGA FUTURA, NEM UTILIZE BAIXA DE SUB.ITENS DO ITEM ESTRUTURA}
          If ((
               (Not blnBaiEntFut)
               Or
               (
                (blnBaiEntFut And (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') And
                (arrMatItens[intContador].strEntSai = 'E') And (arrMatItens[intContador].strProEmb = 'S'))
               )
             ) And

             {CASO NAO SEJA FATURAMENTO DE REMESSA}
             (strOpcDoc <> 'EM') And

             { CASO NAO SEJA BAIXA DE SUB ITENS OU SEJA BAIXA DE SUB ITENS E IRA GERAR MOVIMENTO DE ESTOQUE (ENTRADA) DO ITEM PRINCIPAL }
             (
              (arrMatItens[intContador].strBxSbIt <> 'S') Or

              ((arrMatItens[intContador].strEntFut = 'S') And (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1')) Or

              fGeraEstoqueBaixaOrdProEstrutura(arrMatItens[intContador])
             )
             And

             {QUANDO FOR VENDA DE VIDRO E CONFIGURADO PARA BAIXAR ESTOQUE POR REQUISICAO NAO DEVE BAIXAR ESTOQUE DO PRODUTO}
             (Not (Assigned(objEstruturaVidros) And fEhItemVendaVidro(arrMatItens[intContador].strCodIte) And fUsaRequisicaoEnvioMateriais)) And

             {CASO NAO SEJA SIMPLES REMESSA DE CONCRETO, NEM NOTA DE SERVICO DE CONCRETO}
             (Not blnSimplesRemessaConcretoDadosCliente) And (Not blnNotaServicoConcreto)) Or

             {CASO SEJA FATURAMENTO DE REMESSA E MODELO 2}
             ((strOpcDoc = 'EM') And (fCfgSis('MDLVFE', varString) = '2')) Then
          Begin
            If (strIdePro = 'NOR') Then
            Begin

              {*****************************************}
              {* ATUALIZA ESTOQUE                      *}
              {**************************************MV*}
              If (Pos('ITEM ESPECIAL', arrMatItens[intContador].strDesOri) <= 0) And
                 Not fEhItemServico(arrMatItens[intContador].strCodIte)          And
                 (arrMatItens[intContador].strCodIte <> fCfgSis('ITEFRE'))       And
                 (arrMatItens[intContador].strCodIte <> fCfgSis('ITETAX'))       And
                 (arrMatItens[intContador].strCodIte <> fCfgSis('ITEBOM'))       And
                 (arrMatItens[intContador].strCodIte <> fCfgSis('ITEMAN'))       And
                 (arrMatItens[intContador].strCodIte <> fCfgSis('ITELAN'))       Then
              Begin

                If (Pos(strOpcDoc, 'DV_PR_CR_DD_') > 0) And (arrMatItens[intContador].strPigBas = 'S')
                   And (arrMatItens[intContador].strIdeDev <> 'NOR')
                   And (not TinGer.fProducaoForaLoja(arrMatItens[intContador].strDocDev,
                    arrMatItens[intContador].strEmpDev,
                    arrMatItens[intContador].strEspDev,
                    arrMatItens[intContador].strCodAca,
                    arrMatItens[intContador].strEmpAca)) Then
                Begin
                  {*************************************************************}
                  {* ATUALIZA O SALDO DOS PIGMENTOS                            *}
                  {**********************************************************JC*}
                  Result := fAtualizaEstoqueDevBasePigmento(strEntSai,
                                                            arrMatItens[intContador].strCodAca,
                                                            arrMatItens[intContador].strEmpAca,
                                                            arrMatItens[intContador].strDocDev,
                                                            arrMatItens[intContador].strEspDev,
                                                            arrMatItens[intContador].strEmpDev,
                                                            arrMatItens[intContador].fltQtdIte,
                                                            arrMatItens[intContador].fltQtdDet,
                                                            arrMatItens[intContador].strTabDev);

                  {*************************************************************}
                  {* CASO A TINTA FOR IMOBILIARIA, ENTAO ATUALIZA O SALDO      *}
                  {* DA BASE, QUE NO CASO E' O PROPRIO ITEM DA VENDA...        *}
                  {**********************************************************JC*}
                  If Result And Assigned(fTipoTinta) And (fTipoTinta(arrMatItens[intContador].strIdeDev) in [ttImobiliaria, ttIndustrial]) Then
                  Begin
                    if (fEmptyStr(arrMatItens[intContador].strIteEmb)) then //se nao tiver embalagem
                    begin
                      Result := fAtualizaEstoqueCadIte(arrMatItens[intContador].strCodIte,
                                                       strEntSai,
                                                       arrMatItens[intContador].fltQtdIte,
                                                       arrMatItens[intContador].fltUnitar,
                                                       arrMatItens[intContador].strNumLot,
                                                       FblnAtualizaUltimaVenda,
                                                       True,
                                                       nil,
                                                       strOpcDoc,
                                                       fTravarSeSaldoFicarNegativo(arrMatItens[intContador].strMotFut));
                    end;
                  End;

                  {************************************************}
                  {* CASO A TINTA DEVOLVIDA BAIXA EMBALAGEM ENTAO *}
                  {* IRA FAZER A DEVOLUCAO DA MESMA               *}
                  {*********************************************JC*}
                  If (Result) And (Not fEmptyStr(arrMatItens[intContador].strIteEmb)) Then
                  Begin
                    strCodEmb := arrMatItens[intContador].strIteEmb;
                    blnBaixarEmbDev := True;
                    blnDvChapinha := True;
                  End;

                End
                Else
                Begin
                  If (Not fFaturamentoConsignacao) And
                     (Not ((strOpcDoc = 'DD') And (Self.fEhDevolucaoDemonstracaoNotaEspecial(arrMatItens[intContador].strDocDev, arrMatItens[intContador].strEspDev, arrMatItens[intContador].strEmpDev)))) And
                     (Not fEhDevolucaoPigmentoBaseComProducaoForaLoja(arrMatItens[intContador])) Then
                  Begin
                    If (Not arrMatItens[intContador].blnProAca) Then
                    Begin
                      If Not fEhConsertoEquipamento Then
                      Begin
                        Result := fAtualizaEstoqueCadIte(arrMatItens[intContador].strCodIte,
                                                         strEntSai,
                                                         arrMatItens[intContador].fltQtdIte,
                                                         arrMatItens[intContador].fltUnitar,
                                                         arrMatItens[intContador].strNumLot,
                                                         FblnAtualizaUltimaVenda,
                                                         True,
                                                         nil,
                                                         strOpcDoc,
                                                         fTravarSeSaldoFicarNegativo(arrMatItens[intContador].strMotFut),
                                                         IIF(arrMatItens[intContador].strUpseml = 'S' , arrMatItens[intContador].strEmpIte, ''),
                                                         AUsarBatchSaldosItem);
                      End;
                    End
                    Else If (strOprFlj <> 'S') Then
                    Begin
                      Result := TProdAcabado.fAtualizaEstoque(arrMatItens[intContador].strCodAca,
                                                              arrMatItens[intContador].strEmpAca,
                                                              VS_strCodEmp,
                                                              strEntSai,
                                                              arrMatItens[intContador].fltQtdIte);
                    End;
                  End;
                End;
              End;

            End
            Else If (strOprFlj <> 'S') And (Not fFaturamentoConsignacao) Then
            Begin

              If (Assigned(fTintaBaixaProduto)) Then
              Begin

                If (fTintaBaixaProduto(strIdePro)) Then
                Begin

                  {*****************************************}
                  {* ATUALIZA ESTOQUE                      *}
                  {**************************************MV*}
                  If (Pos('ITEM ESPECIAL', arrMatItens[intContador].strDesOri) <= 0) And
                     Not fEhItemServico(arrMatItens[intContador].strCodIte)          And
                     (arrMatItens[intContador].strCodIte <> fCfgSis('ITEFRE'))       And
                     (arrMatItens[intContador].strCodIte <> fCfgSis('ITETAX'))       And
                     (arrMatItens[intContador].strCodIte <> fCfgSis('ITEBOM'))       And
                     (arrMatItens[intContador].strCodIte <> fCfgSis('ITEMAN'))       And
                     (arrMatItens[intContador].strCodIte <> fCfgSis('ITELAN'))       Then
                  Begin

                    If (Pos(strOpcDoc, 'DV_PR_CR_DD_') > 0) And (arrMatItens[intContador].strPigBas = 'S')
                       And (arrMatItens[intContador].strIdeDev <> 'NOR')
                       And (not TinGer.fProducaoForaLoja(arrMatItens[intContador].strDocDev,
                        arrMatItens[intContador].strEmpDev,
                        arrMatItens[intContador].strEspDev,
                        arrMatItens[intContador].strCodAca,
                        arrMatItens[intContador].strEmpAca)) Then
                    Begin
                      {*************************************************************}
                      {* ATUALIZA O SALDO DOS PIGMENTOS                            *}
                      {**********************************************************JC*}
                      Result := fAtualizaEstoqueDevBasePigmento(strEntSai,
                                                                arrMatItens[intContador].strCodAca,
                                                                arrMatItens[intContador].strEmpAca,
                                                                arrMatItens[intContador].strDocDev,
                                                                arrMatItens[intContador].strEspDev,
                                                                arrMatItens[intContador].strEmpDev,
                                                                arrMatItens[intContador].fltQtdIte,
                                                                arrMatItens[intContador].fltQtdDet,
                                                                arrMatItens[intContador].strTabDev);
                    end;
                  end;

                  If Pos('ITEM ESPECIAL', arrMatItens[intContador].strDesOri) <= 0 Then
                  Begin

                    Result := fAtualizaEstoqueCadIte(arrMatItens[intContador].strCodIte,
                                                     strEntSai,
                                                     arrMatItens[intContador].fltQtdIte,
                                                     arrMatItens[intContador].fltUnitar,
                                                     arrMatItens[intContador].strNumLot,
                                                     FblnAtualizaUltimaVenda,
                                                     True,
                                                     nil,
                                                     strOpcDoc,
                                                     fTravarSeSaldoFicarNegativo(arrMatItens[intContador].strMotFut));

                  End;

                End;

              End;

            End;

          End
          Else
          Begin

            If (Not fEmptyStr(arrMatItens[intContador].strLotAnt)) And
               (SameText(arrMatItens[intContador].strLotAnt, 'A DEFINIR')) Then
            Begin
              If fCfgSis('TLEFBA', VarBoolean) Then
              Begin
                Result := Result And TGerarTL.Execute(arrMatItens[intContador].strCodIte,
                                                      arrMatItens[intContador].strNumLot,
                                                      arrMatItens[intContador].strLotAnt,
                                                      arrMatItens[intContador].fltQtdIte,
                                                      strNumDoc,
                                                      strEspDoc,
                                                      strEmpDoc,
                                                      strCodCli,
                                                      arrMatItens[intContador].strAutoincrementoGravacao);
              End
              Else
              Begin
                objCadLot := TCadLot.Create(Self);
                Try
                  Result := Result And objCadLot.fAtualizaEstoqueLote(arrMatItens[intContador].strCodIte, 'E',
                                                                      arrMatItens[intContador].strLotAnt,
                                                                      arrMatItens[intContador].fltQtdIte);

                  Result := Result And objCadLot.fAtualizaEstoqueLote(arrMatItens[intContador].strCodIte, 'S',
                                                                      arrMatItens[intContador].strNumLot,
                                                                      arrMatItens[intContador].fltQtdIte);
                Finally
                  FreeAndNil(objCadLot);
                End;

                For intCnt := 1 To 2 Do
                Begin
                  If (Result) Then
                  Begin
                    If intCnt = 1 Then Result := fGDadMovDet(OPC_GRAVAMOVDET_PROD_NORMAL, 'E');
                    If intCnt = 2 Then Result := fGDadMovDet(OPC_GRAVAMOVDET_PROD_NORMAL, 'S');
                  End;
                End;
              End;
            End;

          End; {If (Not blnBaiEntFut) And (arrMatItens[intContador].strBxSbIt <> 'S')  Then}
        End; // End blnImpPafEcf

        If Not Result Then
          Break;

        If (Not fFaturamentoConsignacao) Then
        Begin
          If (arrMatItens[intContador].strIdePro <> 'NOR') Then
          Begin
            strEmpSav := '';
            If Not fEmptyStr(strEmpOriRegEsp) Then
            Begin
              strEmpSav    := VS_strCodEmp;
              pSetaEmpresaLogada(strEmpOriRegEsp);
            End;

            Try
              Result := fGDadMovDet(OPC_GRAVAMOVDET_REGISTRO_PR);
            Finally
              If Not fEmptyStr(strEmpSav) Then
                pSetaEmpresaLogada(strEmpSav);
            End;
          End;
        End;

        If Not Result Then
          Break;

        {***************************************}
        {* ATUALIZA O TIPO DE BUSCA UTILIZADO  *}
        {* NA EXPEDIÇÃO (CÓDIGO DE BARRAS OU DO*}
        {* ITEM)                               *}
        {************************************MV*}
        If Not fEmptyStr(strOpeExp) Then
        Begin

          blnAtualizarTipBus := True;

          if (strOriF11 = 'S') and (fEmptyStr(arrMatItens[intContador].strTipBus)) then
            blnAtualizarTipBus := False;

          if (blnAtualizarTipBus) then
            Result := fAtualizaTipoBusca(arrMatItens[intContador].strSeqDet,
                                         arrMatItens[intContador].strTipBus);

        End;

        If Not Result Then
          Break;

        {*****************************************}
        {* ATUALIZA ESTOQUE DA CHAPINHA          *}
        {**************************************RG*}
        If (Assigned(fUsaChapinhaTinta)) And (Not blnBaiEntFut) And (strOprFlj <> 'S') Then
        Begin
            blnUsaChapinhaTinta := fUsaChapinhaTinta(IIF(blnDvChapinha, arrMatItens[intContador].strIdeDev, strIdePro),
              IIF(blnDvChapinha, arrMatItens[intContador].strITinDv, arrMatItens[intContador].strIteTin));

          If blnUsaChapinhaTinta Then
          Begin
            If Assigned(fRetornaCodigoChapinha) Then
              strCodChapinha := fRetornaCodigoChapinha(IIF(blnDvChapinha, arrMatItens[intContador].strIdeDev, strIdePro));

            If fEmptyStr(strCodChapinha) Then
            Begin
              fMensagem('ATENÇÃO!', 'A fórmula ' + arrMatItens[intContador].strDesIte + ', está sem o produto chapinha configurado.' + #13#10 +
                                  'Favor entrar em contato com a Citel.', ['&OK']);
              Result := False;
              Break;
            End;
          End;

          If (blnUsaChapinhaTinta) And (Not fEmptyStr(strCodChapinha)) Then
          Begin
            strCodEmb := strCodChapinha;

            If (Not Assigned(qryConCit)) Then
            qryConCit := fCriarQuery('SELECT * FROM CADITE WHERE FALSE');

            pPesquisaCadIte(qryConCit, qryConCit, strCodEmb, '',
                            False, False, True, Not blnEmpFat);

            Result := fGDadMovDet(2);

            If Not Result Then
              Break;

            If (Not blnBaiEntFut) And ((Not blnImpPafEcf) or (fCfgSis('ESTSOC') = 'S')) Then
            Begin
              strNumLot := arrMatItens[intContador].strNumLot;

              If fUsaRotinaWMS(VS_strCodEmp) Or fCfgSis('TMQLOT', varBoolean) Then
                strNumLot := objCadLot.fRetLotePrincipalTintaMaquina(strCodEmb, VS_strCodEmp);

              Result := fAtualizaEstoqueCadIte(strCodEmb,
                                               strEntSai,
                                               arrMatItens[intContador].fltQtdEmb,
                                               0.0,
                                               strNumLot,
                                               FblnAtualizaUltimaVenda,
                                               True,
                                               nil,
                                               strOpcDoc,
                                               fTravarSeSaldoFicarNegativo(arrMatItens[intContador].strMotFut));
            End;

            If Not Result Then
              Break;
          End;
        End;

        {*****************************************}
        {* ATUALIZA ESTOQUE DA EMBALAGEM         *}
        {**************************************MV*}
        If (Assigned(fTintaBaixaEmbalagem)) And (Not blnBaiEntFut) And (strOprFlj <> 'S') Then
        Begin

          {**********************************************************}
          {* ATUALIZA ESTOQUE DA EMBALAGEM                          *}
          {* ALGUMAS TINTAS COMO LAZZUMIX E BRASIMIX AUTOMOTIVA,    *}
          {* ESCOLHEM A EMBALAGEM NA HORA DA ESCOLHA DA TINTA, E    *}
          {* OUTRAS BAIXAM SEMPRE A MESMA EMBALAGEM, DE ACORDO COM  *}
          {* AS CONFIGURAÇÕES DO AUTTIN.                            *}
          {* O 'IF' É PARA OS PRODUTOS QUE BAIXAM DE ACORDO COM A   *}
          {* CONFIGURAÇÃO, E 'ELSE' É PARA OS PRODUTOS QUE ESCOLHEM *}
          {* A EMBALAGEM NA HORA DA ESCOLHA DA TINTA                *}
          {*******************************************************MV*}

          {**********************************************************}
          {* OBS: NÃO COLOCAR MAIS FUNÇÕES DAQUI PRA BAIXO, POR     *}
          {* CONTA DO "CONTINUE".                                   *}
          {*******************************************************MV*}
          If (fTintaBaixaEmbalagem(strIdePro, arrMatItens[intContador].strTipEmb, strCodEmb)) Then
          Begin

            If (fEmptyStr(strCodEmb)) Then
              Continue;

            If (Not Assigned(qryConCit)) Then
              qryConCit := fCriarQuery('SELECT * FROM CADITE WHERE FALSE');

            pPesquisaCadIte(qryConCit, qryConCit, strCodEmb, '',
                            False, False, True, Not blnEmpFat);

            Result := fGDadMovDet(OPC_GRAVAMOVDET_EMBALAGEM);

            If Not Result Then
              Break;

            If (Not blnBaiEntFut) And ((Not blnImpPafEcf) or (fCfgSis('ESTSOC') = 'S')) Then
            Begin
              strNumLot := arrMatItens[intContador].strNumLot;

              If fUsaRotinaWMS(VS_strCodEmp) Or fCfgSis('TMQLOT', varBoolean) Then
                strNumLot := objCadLot.fRetLotePrincipalTintaMaquina(strCodEmb, VS_strCodEmp);

              Result := fAtualizaEstoqueCadIte(strCodEmb,
                                               strEntSai,
                                               arrMatItens[intContador].fltQtdEmb,
                                               0.0,
                                               strNumLot,
                                               FblnAtualizaUltimaVenda,
                                               True,
                                               nil,
                                               strOpcDoc,
                                               fTravarSeSaldoFicarNegativo(arrMatItens[intContador].strMotFut));
            End;

            If Not Result Then
              Break;

          End
          Else If (arrMatItens[intContador].strIdePro <> 'NOR') Or (blnBaixarEmbDev) Then
          Begin

            strCodEmb := arrMatItens[intContador].strIteEmb;

            If (fEmptyStr(strCodEmb))Then
              Continue;

            If (Not Assigned(qryConCit)) Then
              qryConCit := fCriarQuery('SELECT * FROM CADITE WHERE FALSE', Self);

            pPesquisaCadIte(qryConCit, qryConCit, strCodEmb, '',
                            False, False, True, Not blnEmpFat);

            Result := fGDadMovDet(OPC_GRAVAMOVDET_EMBALAGEM);

            If Not Result Then
              Break;

            If (Not blnBaiEntFut) And ((Not blnImpPafEcf) or (fCfgSis('ESTSOC') = 'S')) Then
            Begin
              strNumLot := arrMatItens[intContador].strNumLot;

              If fUsaRotinaWMS(VS_strCodEmp) Or fCfgSis('TMQLOT', varBoolean) Then
                strNumLot := objCadLot.fRetLotePrincipalTintaMaquina(strCodEmb, VS_strCodEmp);

              Result := fAtualizaEstoqueCadIte(strCodEmb,
                                               strEntSai,
                                               arrMatItens[intContador].fltQtdEmb,
                                               0.0,
                                               strNumLot,
                                               FblnAtualizaUltimaVenda,
                                               True,
                                               nil,
                                               strOpcDoc,
                                               fTravarSeSaldoFicarNegativo(arrMatItens[intContador].strMotFut));
            End;

            If Not Result Then
              Break;

          End;

        End;

        If Not Result Then
          Break;

      End;

      if Result And fEhRecGarantia then
      begin
        Result := TControleChavesGarantia.fGerarVinculosMOVGRC;
      end;

      pAtualizaIndiceNFEConformeOrdenacao(strAutInc, 'MOVDET');

    Finally
      untMovGer.objReprocessarSaldoItens.NotificarRoboParaReprocessarSaldos;
      untMovGer.objReprocessarSaldoItens := nil;

      //Restaura a ordenacao original dos itens
      objOrdenarItensParaGravacao.pRestaurarOrdemMatrizItens(arrMatItens);

      //Atualiza a matriz de itens com a ordem original de inclusao dos itens
      For intContador := 0 To Length(arrMatItens) -1 Do
        arrMatItens[intContador] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intContador];

      FreeAndNil(objOrdenarItensParaGravacao);
    End;

    If (Result) And (Pos(strOpcDoc,'DV_') > 0) And VS_strHabilitarCRM And (Not blnBaiPedDev) And (pos(strOpcDocTrue,'_NW_GC_') = 0) Then
    Begin
      If not fEmptyStr(strCodAde) Then
      Begin
        strTabela := 'MOVDET';

        Result := fAtualizaOcorrenciaDevolucaoCRM(strCodAde,
                                                  dtaDtaEnt,
                                                  strNumDoc,
                                                  strEspDoc,
                                                  VS_strCodEmp,
                                                  strCodCli,
                                                  strSerFsc,
                                                  strCodVen,
                                                  fltTotGer,
                                                  strTabela,
                                                  False);

        Result := Result And
          fEnviaMensagemDevolucaoParaOperadorAD(strCodAde, strCodCli,
                  strNumDoc + '-' + strEspDoc + '-' + strSerFsc + '-' + VS_strCodEmp);

        If Result Then
          pMarcaDocumentoDevAD(strCodAde, VS_strCodEmp, strNumDoc, strEspDoc, VS_strCodEmp);

      End

      Else
      If (Not fEmptyStr(fCfgSis('VENDEV', varString))) Then
      Begin
        If (Not fValidaConfigVenDev) Then
        Begin
          Result := False;
          Exit;
        End;

        Try
          objMovDetOcoCrm := TAtuOcoCrm.Create(Nil);
          objMovDetOcoCrm.strNomFrm := '[TFatVenda.fGMovDet]';
          objMovDetOcoCrm.strCodCli := strCodCli;
          objMovDetOcoCrm.strDtaInc := VS_Date;
          objMovDetOcoCrm.strHorInc := fNow();
          objMovDetOcoCrm.strDtaAge := objMovDetOcoCrm.strDtaInc;
          objMovDetOcoCrm.strHorAge := objMovDetOcoCrm.strHorInc;
          objMovDetOcoCrm.strDtaCon := VS_Date;
          objMovDetOcoCrm.strHorCon := fNow();
          objMovDetOcoCrm.strOpeHis := strLoginUsuarioLogado;
          objMovDetOcoCrm.strCodOpe := strLoginUsuarioLogado;
          objMovDetOcoCrm.strDescri := 'Devolução número: ' + strNumDoc + '-' + strEspDoc + '-' + strSerFsc + '-' + VS_strCodEmp +
                                      '<<csq>><<csq>>Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                      FormatDateTime('dd/mm/yyyy', VS_Date) + ' ' + FormatDateTime('hh:nn:ss', fNow) + ' - ' +
                                      strLoginUsuarioLogado + ' - ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                      TListarProdutosDevolvidos.New(strNumDoc, strEspDoc, VS_strCodEmp,
                                        strSerFsc, strCodCli).fGetProdutos;
          objMovDetOcoCrm.strCodEmp := VS_strCodEmp;
          objMovDetOcoCrm.strCodToc := fCfgSis('VENDEV', varString);
          objMovDetOcoCrm.strCpfCli := strCliCgc;
          objMovDetOcoCrm.pInsereNovaOcorrencia;
          objMovDetOcoCrm.pInsereHistoricoOcorrencia;
        Finally
          FreeAndNil(objMovDetOcoCrm);
        End;
      End;
    End;

    If (Result) And (Pos(strOpcDoc,'DV_') > 0) And VS_strHabilitarCRM and blnBaiPedDev And (Not fEmptyStr(fCfgSis('VENDEV', varString))) And (pos(strOpcDocTrue,'_NW_GC_') = 0) Then
    Begin
      If (Not fValidaConfigVenDev) Then
      Begin
        Result := False;
        Exit;
      End;

      For intContador := Low(arrPedidosDev) To High(arrPedidosDev) Do
      Begin
        Try
          objMovDetOcoCrm := TAtuOcoCrm.Create(Nil);
          objMovDetOcoCrm.strNomFrm := '[TFatVenda.fGMovDet]';
          objMovDetOcoCrm.strCodOco := fRetornaCodigoOcorrencia(arrPedidosDev[intContador].strNumPed,
                                                                arrPedidosDev[intContador].strEspPed,
                                                                '',
                                                                arrPedidosDev[intContador].strEmpPed,
                                                                '');

          objMovDetOcoCrm.strCodCli := strCodCli;
          objMovDetOcoCrm.strDtaInc := VS_Date;
          objMovDetOcoCrm.strHorInc := fNow();
          objMovDetOcoCrm.strDtaAge := objMovDetOcoCrm.strDtaInc;
          objMovDetOcoCrm.strHorAge := objMovDetOcoCrm.strHorInc;
          objMovDetOcoCrm.strDtaCon := VS_Date;
          objMovDetOcoCrm.strHorCon := fNow();
          objMovDetOcoCrm.strOpeHis := strLoginUsuarioLogado;
          objMovDetOcoCrm.strCodOpe := strLoginUsuarioLogado;
          objMovDetOcoCrm.strDescri := 'Devolução número: ' + strNumDoc + '-' + strEspDoc + '-' + strSerFsc + '-' + VS_strCodEmp +
                                      '<<csq>><<csq>>Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                      FormatDateTime('dd/mm/yyyy', VS_Date) + ' ' + FormatDateTime('hh:nn:ss', fNow) + ' - ' +
                                      strLoginUsuarioLogado + ' - ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                      TListarProdutosDevolvidos.New(strNumDoc, strEspDoc, VS_strCodEmp,
                                        strSerFsc, strCodCli).fGetProdutos;
          objMovDetOcoCrm.strCodEmp := VS_strCodEmp;
          objMovDetOcoCrm.strCodToc := fCfgSis('VENDEV', varString);
          objMovDetOcoCrm.strCpfCli := strCliCgc;

          If (fEmptyStr(objMovDetOcoCrm.strCodOco)) Then
          Begin
            objMovDetOcoCrm.strNumDoc := strNumDoc;
            objMovDetOcoCrm.strEspDoc := strEspDoc;
            objMovDetOcoCrm.pInsereNovaOcorrencia;
          End
          Else
            objMovDetOcoCrm.pAtualizaOcorrencia;

          objMovDetOcoCrm.pInsereHistoricoOcorrencia;
        Finally
          FreeAndNil(objMovDetOcoCrm);
        End;

      End;

    End;

    If (Result) And (VS_strHabilitarCRM) And (Pos(strEspDoc, 'NF_IF_FF_') > 0) And (strOpcDoc = 'VN') And (fEmptyStr(strNumOrc)) And (Not fEmptyStr(fCfgSis('VENVN_'))) Then
    Begin
      Try
        strProdutos := fGetModificacoesItensPedido(strNumDoc, strEspDoc, VS_strCodEmp, arrMatItens);

        strMsgOcorr := iif(blnNovoSequencial, 'Novo', 'Alteração');

        if strEspDoc = 'FF' then
          strMsgOcorr := strMsgOcorr + ' Faturamento Futuro'
        else
        if strEspDoc = 'NF' then
          strMsgOcorr := strMsgOcorr + ' Nota Fiscal'
        else
        if strEspDoc = 'IF' then
          strMsgOcorr := strMsgOcorr + ' Cupom Fiscal';

        strMsgOcorr := strMsgOcorr + iif(blnNovoSequencial, ' CRIADO.', '.');

        objMovDetOcoCrm := TAtuOcoCrm.Create(Nil);
        objMovDetOcoCrm.strNomFrm := '[TFatVenda.fGMovDet]';
        objMovDetOcoCrm.strCodCli := strCodCli;
        objMovDetOcoCrm.strDtaInc := VS_Date;
        objMovDetOcoCrm.strCodEmp := VS_strCodEmp;
        objMovDetOcoCrm.strNumDoc := strNumDoc;
        objMovDetOcoCrm.strEspDoc := strEspDoc;
        objMovDetOcoCrm.strEspOrc := strEspOrc;
        objMovDetOcoCrm.strNumOrc := strNumOrc;
        objMovDetOcoCrm.strCodToc := fCfgSis('VENVN_', varString);
        objMovDetOcoCrm.strHorInc := fRetHoraServidor();
        objMovDetOcoCrm.strDtaCon := objMovDetOcoCrm.strDtaInc;
        objMovDetOcoCrm.strCodOpe := strLoginUsuarioLogado;
        objMovDetOcoCrm.strHorCon := objMovDetOcoCrm.strHorInc;
        objMovDetOcoCrm.strDescri := strMsgOcorr + '<<csq>>Número Documento : ' + strNumDoc + '<<csq>>Espécie : ' + strEspDoc + '<<csq>>Empresa : ' + VS_strCodEmp +
                                    '<<csq>>' + objMovDetOcoCrm.fDadosConsumidor +
                                    IIF((fCfgSis('CADFAZ', varBoolean)) And (Not fEmptyStr(strCodFaz)), 'Fazenda : ' + strCodFaz + '-' + fRetNomFazenda(strCodFaz) + '<<csq>>', '')+
                                    '<<csq>><<csq>>Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                    FormatDateTime('dd/mm/yyyy', VS_Date) + ' ' + FormatDateTime('hh:nn:ss', fNow) + ' - ' +
                                    strLoginUsuarioLogado + ' - ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>><<csq>>' + strProdutos ;
        objMovDetOcoCrm.strCpfCli := strCliCgc;
        objMovDetOcoCrm.pInsereNovaOcorrencia;
        objMovDetOcoCrm.pInsereHistoricoOcorrencia;
      Finally
        FreeAndNil(objMovDetOcoCrm);
      End;
    End;

    {Monta informações do corpo da NS de concreto!}
    If (Result) Then
      If ((fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) And blnConfirmandoNotaFiscalConcreto) Then
        Result := fAtualizaCampo_MOVOBS_MOV_DISSER(strAutInc);

  Except
    On E: EBaixaOrdemProducao Do
      Raise EBaixaOrdemProducao.Create(E.Message);
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGMovDet]');
    End;
  End;

end;

Function TFatVenda.fRetNomeMovRes(strNomArq: String): String;
Begin
  If SameText(strNomArq, 'MOVGER') Then
      Result := 'MOVRES'

  Else If SameText(strNomArq, 'NOTGER') Then
    Result := 'NOTRES'

  Else Result := '';
End;

Function TFatVenda.fGMovRes(strAutInc, strNomArq: String): Boolean;
  Var
    qryGen: TUniQuery;
    strMovRes: String;
    intContador: Integer;
Begin

  Try
    strMovRes := fRetNomeMovRes(strNomArq);

    qryGen := fCriaQuery;

    With qryGen, SQL Do
    Begin
      Clear;
      Add('INSERT INTO ');
      Add(strMovRes);
      Add('(AUTOINCREM, ');
      Add(' RES_SEQGER, ');
      Add(' RES_CLAFIS, ');
      Add(' RES_BASRET, ');
      Add(' RES_VALRET) VALUES ');
      Add('(:AUTINC, ');
      Add(' :SEQGER, ');
      Add(' :CLAFIS, ');
      Add(' :BASRET, ');
      Add(' :VALRET) ');

      For intContador := Low(arrIpiRet) To High(arrIpiRet) Do
      With arrIpiRet[intContador] Do
      If Not fEmptyStr(strIpiRet) Then
      Begin
         Close;

         ParamByName('AUTINC').AsString := fRetAutoIncrem(strMovRes, VS_strCodEmp);
         ParamByName('SEQGER').AsString := strAutInc;
         ParamByName('CLAFIS').AsString := strIpiRet;
         ParamByName('BASRET').AsFloat  := fltBaIRet;
         ParamByName('VALRET').AsFloat  := fltVaIRet;

         ExecSQL;
      End;

    End;

    Result := True;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGMovRes]');
    End;
  End;

  FreeAndNil(qryGen);

End;

function TFatVenda.fGMovGer: Boolean;
  Var
    strMsgAux: String;
    strValCnfNfeCom: String;
    strValCnfNfeFis: String;
    blnIpDpNf,
    blnBaiExp: Boolean;
    valorDuplicatas: TValoresDuplicatas;
    arrDupGer : TarrDuplicata;
    strCodDivOri: String;
    strCliTelTmp: String;
    intContador: integer;
    strEmpTmp: String;
    strEmpSav: String;
    strCodFpgBkp: String;
    LObjDocumentosAbastecimentoDeposito: TDocumentosAbastecimentoDeposito;

  function fValidaDocumentoExistente: Boolean;
  begin
    Result := True;
    If (strOriDoc = '') Then
    Begin
      If blnAbastecimentoDeposito Or
         blnRegimeEspecialPorEmpresaComFaturamentoDuplo Or
         blnRegimeEspecialPorProdutoComFaturamentoDuplo Or
         blnDevRegimeEspecial Then
      Result := False;
    End;
  end;

  function fRetornaNumeroGuicheEP: String;
  Const
    strSQLRetornaUlt : String = '(SELECT MAX(AUX_SEQGER) FROM MOVGER INNER JOIN AUXMOV ON (AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM) WHERE GER_CODEMP = :CODEMP AND IFNULL(AUX_NUMGUI, "") <> "")';
  Var
    qryAux: TUniQuery;
  begin
    qryAux := fCriaQuery();

    qryAux.SQL.Clear;
    qryAux.SQL.Add(' SELECT ');
    qryAux.SQL.Add('   CASE WHEN (CONVERT(IFNULL(AUX_NUMGUI,""),SIGNED) = 0) THEN 1 ');
    qryAux.SQL.Add('        WHEN (CONVERT(IFNULL(AUX_NUMGUI,""),SIGNED) = (SELECT SIS_VALCFG ');
    qryAux.SQL.Add('                                                       FROM   CFGSIS ');
    qryAux.SQL.Add('                                                       WHERE  SIS_CODCFG = "CFG_QTDGUI" ');
    qryAux.SQL.Add('                                                       AND    SIS_CODEMP = :CODEMP)) THEN 1 ');
    qryAux.SQL.Add('        ELSE (CONVERT(IFNULL(AUX_NUMGUI,""),SIGNED) + 1) END PRONUM ');
    qryAux.SQL.Add(' FROM ');
    qryAux.SQL.Add('   AUXMOV ');
    qryAux.SQL.Add(' WHERE ');
    qryAux.SQL.Add('   AUX_SEQGER = ' + strSQLRetornaUlt);
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.Open;

    Result := FormatFloat('000',qryAux.FieldByName('PRONUM').AsInteger);

    FreeAndNil(qryAux);
  End;

begin
  FillChar(arrDupGer, Sizeof(arrDupGer) , #0);
  If Not ((strConfSer = 'S') And (Pos(strOpcDoc, 'CP_OV_') > 0)) Then
    SetLength(arrPedidos, 0);

  blnTEGarantia := (strMen001 = 'GARANTIA(TE)');

  If npcNumCmp = Nil Then
    npcNumCmp := fBuscaNumsCmp(strNumOrc,
                               strEspOrc,
                               strCodCli,
                               strEmpOri);

  Result := True;

  If (blnTemTinta)
    and (strOprFlj <> 'S')
    and (blnGravaMovDet2_3)
    and (not blnBaixaFFEmprestimo)
    and (not blnBaiEntFut)
    and (not fFaturamentoConsignacao) Then
  Begin
    strEmpSav := '';
    If Not fEmptyStr(strEmpOriRegEsp) Then
    Begin
      strEmpSav := VS_strCodEmp;
      pSetaEmpresaLogada(strEmpOriRegEsp);
    End;

    Try
      Result := fGMovGerPR;
    Finally
      If Not fEmptyStr(strEmpSav) Then
        pSetaEmpresaLogada(strEmpSav);
    End;
  End;

  pCarregaVariaveisDuplicatas;

  strValCnfNfeCom := '';
  strValCnfNfeFis := '';
  strSeriesFornecedor := '';

  blnipDpNf := True;

  If fEspGui(strEspDoc) And fCfgSis('USAGUI',varBoolean) And fEmptyStr(strNumGui) then
    strNumGui := fRetornaNumeroGuicheEP;

  If (fCfgSis('ABADEP',varBoolean)) And (Self.strOpcDoc = 'DV') And (Length(Self.arrMatItens) > 0) And (Self.blnDevolucaoEmpresaAbastecimento) Then
  Begin
    LObjDocumentosAbastecimentoDeposito := TDocumentosAbastecimentoDeposito.Create(Self.arrMatItens[0].strDocDev, Self.arrMatItens[0].strEspDev, Self.arrMatItens[0].strEmpDev, self.strCodCli);

    Try
      LObjDocumentosAbastecimentoDeposito.pCarregaDocumentosDeAbastecimentoDeposito;

      If (LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList.Count = 1) And
         (LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList[0].CodEmp <> VS_strCodEmp) Then
      Begin
        strEmpOriPed := LObjDocumentosAbastecimentoDeposito.ObjInformacaoDocumentoAbastecimentoDepositoList[0].CodEmp;
        FstrEmpresaAbastecimentoDeposito := Self.arrMatItens[0].strEmpDev;
        blnAbastecimentoDeposito := True;
        Self.blnEhDevolucaoAbastecimentoDeposito := True;
        strCodFpgBkp := Self.strCodFpg;
        Self.strCodFpg := fCampoTabela('CND_CODFPG', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd], False);
      End;
    Finally
      FreeAndNil(LObjDocumentosAbastecimentoDeposito);
    End;
  End;

  If (fCfgSis('ABADEP',varBoolean)) And (Self.strOpcDoc = 'OF') And (Not fEmptyStr(strEmpresaAbastecimentoOutrasSaidas)) Then
  Begin
    blnAbastecimentoDeposito := True;
    Self.blnEhDevolucaoAbastecimentoDeposito := fEhDevolucaoDeFornecedorComAbastecimentoDeposito();
    strEmpOriPed := VS_strCodEmp;
  End;

  if ((blnAbastecimentoDeposito and (not fTemEntregaFutura(arrMatItens))) or blnRegimeEspecialPorEmpresaComFaturamentoDuplo) and (not fEmptyStr(strEmpOriPed))  then
  begin
    pAtualizaClassTransferencias;

    strEmpTmp := '';
    if Not fEmptyStr(strEmpresaAbastecimentoOutrasSaidas) then
      strEmpTmp := strEmpresaAbastecimentoOutrasSaidas
    else if blnAbastecimentoDeposito then
      strEmpTmp := FstrEmpresaAbastecimentoDeposito
    Else If blnRegimeEspecialPorEmpresaComFaturamentoDuplo Then
      strEmpTmp := FEmpresaRegimeEspecialPorEmpresa;

    Result := TFatTransfEstoqueParaEmpresaFaturamentoPedido.
      New(Self, strEmpTmp, strEmpOriPed, False, Self.strEspDoc).
      fTransferirEstoqueParaEmpresaFaturamento;

    if (not fEmptyStr(fCfgSis('CFOPVE'))) And (not fEmptyStr(strClaFis)) then
    begin
      strClaFis := strClaFis[1] + fCfgSis('CFOPVE');

      for intContador := Low(Self.arrMatItens) to High(Self.arrMatItens) do
      begin
        if not fEmptyStr(Self.arrMatItens[intContador].strClaFis) then
          Self.arrMatItens[intContador].strClaFis := Self.arrMatItens[intContador].strClaFis[1] + fCfgSis('CFOPVE');
      end;
    end;

    if Self.blnEhDevolucaoAbastecimentoDeposito then
    begin
      FstrEmpresaAbastecimentoDeposito := EmptyStr;
      blnAbastecimentoDeposito := False;
      Self.strCodFpg := strCodFpgBkp;
    end;
  end;

  If (Result) And (fDeveSerGeradoPedidoDeReservaEstoqueParaEnderecamento_RotinaAbastecimentoDeposito) Then
  Begin
    Result := fGerarPedidoReservaEstoqueParaEnderecamento;
  End;

  if (fEmpresaUtilizaRegimeEspecial) and (not Self.blnCliFil) And (Not blnDesmembrouSaindoDoRegime) then
  begin
    Result := TFatTransfEstoqueParaEmpresaFaturamentoPedido.
      New(Self, strEmpOriRegEsp, VS_strCodEmp, True, Self.strEspDoc).
      fTransferirEstoqueParaEmpresaFaturamento;

    strNumDocPR := '';
    strEmpDocPR := '';
  end;

  if (strOpcDoc = 'DV') and fDevolucaoDocRegimeEspecial then
  begin
    Result := TFatDevolucaoRegimeEspecial
      .New(Self, arrMatItens[0].strEmpDev, fRetEmpOriRegimeEspecial,
           Self.strEmpLogDevRegEsp, fRetTipoRegimeEspecialDev, fRetEspOriRegimeEspecial)
      .fDevolucaoRegimeEspecial;
  end;

  If (fZerarDadosAproveitamentoCreditoICMSAntesCNF_NFeParaFornecedor()) Then
    pZerarDadosAproveitamentoCreditoICMS();

  If (fProcessaCNF_NFE) Then
  Begin
    pCalculaPontosClubeFidelidade;

    strCliTelTmp := strCliTel;
    strCodDivOri := strCodDiv;

    If Not fEmptyStr(strCliTel) Then
      strCliTel  := fFormataFonePais(strCliTel);

    If fEmptyStr(strCodDiv) And (fCfgSis('NROPRO') = '3') And (Assigned(cdsProfiss)) And (cdsProfiss.Active) Then
    Begin
      cdsProfiss.First;
      strCodDiv := cdsProfiss.fieldbyname('DIV_CODDIV').AsString;
    End;

    blnIpDpNf := fImprimeDuplicatasCnfe;

    {*REQ.169209**********RP*}
    If fCfgSis('NUMSER', varBoolean) And Not fCfgSis('DETSER', varBoolean) Then
      strSeriesFornecedor := fBuscaNumerosSeriesTodosItens(VS_strCodEmp);

    pRetDadosCNF_NFE_ITE;

    strValCnfNfeCom := fRetDadosCNF_NFE('C');
    strValCnfNfeFis := fRetDadosCNF_NFE('F');
    Self.strPonImp  := fRetPontoImpressaoDocumento(False);

    If (fCfgSis('ENVOBF', varBoolean)) And (Not fEmptyStr(Self.strCodEmbarcacao))  Then
      If fEmptyStr(strValCnfNfeFis) Then
        strValCnfNfeFis := ' Obs. Embarc.:' + fCampoTabela('EMB_OBSERV', 'CADEMB', ['AUTOINCREM'], [Self.strCodEmbarcacao])
      Else
        strValCnfNfeFis := strValCnfNfeFis + ' Obs. Embarc.:' + fCampoTabela('EMB_OBSERV', 'CADEMB', ['AUTOINCREM'], [Self.strCodEmbarcacao]);

    If Not fEmptyStr(fMensagemAdicionalConcreto) Then
    Begin
      blnIpDpNf := False;
      strValCnfNfeCom := fMensagemAdicionalConcreto + strValCnfNfeCom;
    End;

    strValCnfNfeCom := strValCnfNfeCom + fRetornaInformacoesDaUltimaCompra;

    strCliTel := strCliTelTmp;
    strCodDiv := strCodDivOri;
  End;

  If (fZerarDadosAproveitamentoCreditoICMSAntesCNF_NFeParaFornecedor()) Then
    pRestaurarDadosAproveitamentoCreditoICMS();

  If Result Then
  Begin

    If fEmptyStr(strEntreg) Then
      strEntreg := 'N';

    if fConPagComEntrada(strConPag) then
    begin
      valorDuplicatas := TValoresDuplicatas.Create(arrDuplicata, -1);
      valorDuplicParaF11 := TValoresDuplicatas.Create(arrDuplicata, -1);
    end
    else
    begin
      valorDuplicatas := TValoresDuplicatas.Create(arrDuplicata, intSeqDupBaiUtiCred);
      valorDuplicParaF11 := TValoresDuplicatas.Create(arrDuplicata, intSeqDupBaiUtiCred);
    end;

    arrDupGer := valorDuplicatas.fGetDuplicatas;

    If blnBaiEntFut Then
      blnBaiExp := Not fCfgSis('BEFEXP', varBoolean)
    Else
      blnBaiExp := False;

    If ((Not (strOpcDoc = 'CR')) And (Not Self.Fulfillment.EhOperacaoFulfillment)) Then
    Begin
      dtaDtaEnt := Self.VS_Date;
      dtaDtaOri := Self.VS_Date;
      If (blnAbastecimentoDeposito Or
          blnRegimeEspecialPorEmpresaComFaturamentoDuplo Or
          blnRegimeEspecialPorProdutoComFaturamentoDuplo Or
          blnDevRegimeEspecial) And (strOpcDoc = 'EF') Then
        strOriDoc := ''
      else
        strOriDoc := 'V';
    End;

    If Not Self.Fulfillment.EhOperacaoFulfillment Then
      dtaHorEnt := fRetHoraServidor;

    If (FdtaDtEsNf+FtmrHrEsNf > 0) And (FdtaDtEsNf+FtmrHrEsNf < dtaDtaEnt+dtaHorEnt) Then
    Begin
      FdtaDtEsNf := dtaDtaEnt;
      FtmrHrEsNf := dtaHorEnt;
    End;

    fZeraIrpjPisCofCsl;

    If fValidaDocumentoExistente Then
    Begin
      If fDocumentoFiscalJaExiste(strNumDoc, strEspDoc, VS_strCodEmp,
                                  IIF(fDocumentoParaFornecedor,'F','C'),
                                  strSerFsc, strOriDoc,
                                  IIF(blnAbastecimentoDeposito, strCodCli, '')) Then
      Begin
        strMsgCancelamento := 'O documento: '+strNumDoc+'-'+strEspDoc+'-'+VS_strCodEmp+'-'+strSerFsc+' já existe!'+#10+#13 +
                              'Feche o AutCom e tente emitir o documento novamente e se mesmo assim a mensagem persistir, '+
                              'entre em contato com a Citel para ajustar o sequêncial referente a esse documento!';
        Result := False;
      End;
    End;

    If (Self.strEspDoc = 'IF') And (fltValFre > 0) Then
    Begin
      fltDesAce := fltDesAce + fltValFre;
      fltValFre := 0;
    End;

    FfltTotIpiEntFut   := 0.00;
    FfltTotRetEntFut   := 0.00;
    FfltTotFcpSTEntFut := 0.00;

    {*REQ.144458**********RP*}
    If Not blnBaiEntFut And (strEntFut = 'S') And (fCfgSis('ENFUOP') = '2') Then
    Begin
      FfltTotIpiEntFut   := fltTotIpi;
      FfltTotRetEntFut   := fltTotRet;
