function TFatVenda.fPedidoGeradoAosMoldesDaPrepTE: Boolean;
var  qryConsulta: TUniQuery;
     item: TDadosFechamento;
     strAutInc: String;

begin
  Result := False;
  If not fClienteFilial(Self.strCodCli) Then
    Exit;

  If Self.strOpcDocTrue <> 'EI' Then
    Exit;

  qryConsulta := fCriaQuery;
  Try

    strAutInc := '';
    For item in Self.arrMatItens Do
    begin
      If item.strSeqDet <> '' Then
        strAutInc := strAutInc + '"' + item.strSeqDet + '",';
    End;

    If strAutInc = '' Then
      Exit;

    strAutInc := strAutInc.Remove(Length(strAutInc) -1);
    qryConsulta.SQL.Add('SELECT COUNT(1) AS QTD FROM FATGOR');
    qryConsulta.SQL.Add(' INNER JOIN AUXGOR ON AUX_SEQGER = FATGOR.AUTOINCREM');
    qryConsulta.SQL.Add(' WHERE AUTOINCREM = (SELECT FDO_SEQGER FROM FATDOR');
    qryConsulta.SQL.Add('                      WHERE FATDOR.AUTOINCREM IN(' + strAutInc + ')');
    qryConsulta.SQL.Add('                      LIMIT 1)');
    qryConsulta.SQL.Add('  AND AUXGOR.AUX_MEN005 <> "GERACAO TE"');

    qryConsulta.Open;
    Result := qryConsulta.FieldByName('QTD').AsInteger = 0;

    qryConsulta.Close;
  Finally
    FreeAndNil(qryConsulta);
  End;

end;

function TFatVenda.fCarregaLiberacaoPedido(strNumPD,
                                           strEspPD,
                                           strEmpPD: String;
                                           blnChamadaExterna : Boolean = False): Boolean;
  Var
    qryLibPed: TUniQuery;
    blnCarregarLibPed: Boolean;

  function fField(strField: String): TField;
  begin
    Result := qryLibPed.FieldByName('LPD_' + strField);
  end;

begin
  Result := True;

  If strEspPD <> 'PD' Then
    Exit;

  If Pos(strOpcDoc, 'OR_PD_') <= 0 Then
    Exit;

  qryLibPed := fCriaQuery;

  With qryLibPed, SQL Do
  Begin
    Close;
    Clear;

    Add('SELECT * FROM ');
    Add('  LIBPED ');
    Add('WHERE LPD_OPELIB IS NULL   ');
    Add('  AND LPD_NUMDOC = :NUMDOC ');
    Add('  AND LPD_ESPDOC = :ESPDOC ');
    Add('  AND LPD_CODEMP = :CODEMP ');

    ParamByName('NUMDOC').AsString := strNumPD;
    ParamByName('ESPDOC').AsString := strEspPD;
    ParamByName('CODEMP').AsString := strEmpPD;

    Open;

    First;

    While Not Eof Do
    Begin
      If (fSomenteAvisaPoisVaiTravarNoFinalVenda(fField('DIRACE').AsString, blnCarregarLibPed) And blnCarregarLibPed) Or blnChamadaExterna Then
      Begin

        pRemoverTravaLogAvi(FieldByName('LPD_DIRACE').AsString, strNTrava);

        SetLength(arrLogAvi, Length(arrLogAvi) + 1);
        arrLogAvi[High(arrLogAvi)].strDirAce := fField('DIRACE').AsString;
        arrLogAvi[High(arrLogAvi)].strInfBlo := fField('INFBLO').AsString;
        arrLogAvi[High(arrLogAvi)].strInfLib := fField('INFLIB').AsString;
        arrLogAvi[High(arrLogAvi)].strMenObs := fField('INFBLO').AsString;
        arrLogAvi[High(arrLogAvi)].strCodOpe := fField('CODVEN').AsString;
        arrLogAvi[High(arrLogAvi)].strCodDig := fField('CODDIG').AsString;

        If blnChamadaExterna Then
          pAdicionarDirAceStringNTrava(fField('DIRACE').AsString, Self.strNTrava);

      End;
      qryLibPed.Next;
    End;

  End;

  FreeAndNil(qryLibPed);
end;

function TFatVenda.fGravaLiberacaoPedido(strNumPD, strEspPD, strEmpPD: String): Boolean;
  Var
    qryLibPed: TUniQuery;
    intBloqueio: Integer;

    function fLimpaTags(const strMsg: string): string;
    begin
      Result := fLimpaTagMsgOculta(fLimpaTagMsgOculta(strMsg), omlMsgParaQuemReceb)
    end;
begin
  Result := True;

  {Retirado conforme req.: 119227
  If Not blnLiberacaoRemotaNoFinalVenda Then
    Exit;

  If Not fCfgSis('LIBPED', varBoolean) Then
    Exit;

  If (Not blnRealizandoLiberacaoPedido) Then
    If (Not blnUsaLiberacaoPedidosConformeEscolhaDoOperador) Then
    Exit;}

  If strEspPD <> 'PD' Then
    Exit;

  If Pos(strOpcDoc, 'OR_PD_') <= 0 Then
    Exit;

  qryLibPed := fCriaQuery;

  With qryLibPed, SQL Do
  Begin
    Close;
    Clear;

    Add('DELETE FROM ');
    Add('  LIBPED ');
    Add('WHERE LPD_OPELIB IS NULL   ');
    Add('  AND LPD_NUMDOC = :NUMDOC ');
    Add('  AND LPD_ESPDOC = :ESPDOC ');
    Add('  AND LPD_CODEMP = :CODEMP ');

    ParamByName('NUMDOC').AsString := strNumPD;
    ParamByName('ESPDOC').AsString := strEspPD;
    ParamByName('CODEMP').AsString := strEmpPD;

    ExecSQL;

    Close;
    Clear;

    Add('SELECT * FROM LIBPED WHERE FALSE ');

    Open;

    For intBloqueio := 0 To Length(arrLogAvi) -1 Do
    Begin
      qryLibPed.Append;

      FieldByName('AUTOINCREM').AsString   := fRetAutoIncrem('LIBPED', VS_strCodEmp);
      FieldByName('LPD_NUMDOC').AsString   := strNumPD;
      FieldByName('LPD_ESPDOC').AsString   := strEspPD;
      FieldByName('LPD_CODEMP').AsString   := strEmpPD;
      FieldByName('LPD_CODCLI').AsString   := strCodCli;
      FieldByName('LPD_CONPAG').AsString   := strConPag;
      FieldByName('LPD_CODVEN').AsString   := strCodVen;
      FieldByName('LPD_CODDIG').AsString   := IIF(fEmptyStr(strCodDig), strLoginUsuarioLogado, strCodDig);
      FieldByName('LPD_DTACAD').AsDateTime := VS_date;
      FieldByName('LPD_HORCAD').AsDateTime := fRetHoraServidor;
      FieldByName('LPD_VLRCON').AsFloat    := fltTotGer;
      FieldByName('LPD_DIRACE').AsString   := arrLogAvi[intBloqueio].strDirAce;
      FieldByName('LPD_DESACE').AsString   := arrLogAvi[intBloqueio].strMsgSen;

      FieldByName('LPD_INFBLO').AsString   :=
        fLimpaTags(fMesclaMensagemMaisJustificativa(fDefinirMsgFormasPagamentoNegociada(arrLogAvi[intBloqueio].strInfBlo),''));

      FieldByName('LPD_INFLIB').AsString   :=
        fLimpaTags(fMesclaMensagemMaisJustificativa(fDefinirMsgFormasPagamentoNegociada(arrLogAvi[intBloqueio].strInfLib),''));

      qryLibPed.Post;
    End;

    For intBloqueio := 0 To Length(arrLogLib) -1 Do
    Begin
      If qryLibPed.Locate('LPD_DIRACE', arrLogLib[intBloqueio].strDirAce, []) Then
        Continue;

      qryLibPed.Append;

      FieldByName('AUTOINCREM').AsString   := fRetAutoIncrem('LIBPED', VS_strCodEmp);
      FieldByName('LPD_NUMDOC').AsString   := strNumPD;
      FieldByName('LPD_ESPDOC').AsString   := strEspPD;
      FieldByName('LPD_CODEMP').AsString   := strEmpPD;
      FieldByName('LPD_CODCLI').AsString   := strCodCli;
      FieldByName('LPD_CONPAG').AsString   := strConPag;
      FieldByName('LPD_CODVEN').AsString   := strCodVen;
      FieldByName('LPD_CODDIG').AsString   := IIF(fEmptyStr(strCodDig), strLoginUsuarioLogado, strCodDig);
      FieldByName('LPD_DTACAD').AsDateTime := VS_date;
      FieldByName('LPD_HORCAD').AsDateTime := fRetHoraServidor;
      FieldByName('LPD_VLRCON').AsFloat    := fltTotGer;
      FieldByName('LPD_DIRACE').AsString   := arrLogLib[intBloqueio].strDirAce;
      FieldByName('LPD_DESACE').AsString   := arrLogLib[intBloqueio].strMsgSen;
      If fCfgSis('VPALPD', VarBoolean) Then
        FieldByName('LPD_OPELIB').AsString   := arrLogLib[intBloqueio].strOpeLib;

      FieldByName('LPD_INFBLO').AsString   :=
        fLimpaTags(fMesclaMensagemMaisJustificativa(fDefinirMsgFormasPagamentoNegociada(arrLogLib[intBloqueio].strInfBlo),''));

      FieldByName('LPD_INFLIB').AsString   :=
        fLimpaTags(fMesclaMensagemMaisJustificativa(fDefinirMsgFormasPagamentoNegociada(arrLogLib[intBloqueio].strInfBlo),''));

      qryLibPed.Post;
    End;

  End;

  FreeAndNil(qryLibPed);
end;

function TFatVenda.fGetQtdItensCdsVenda(strFiltro: String = ''): Integer;
  Var
    cdsDados: TUniClientDataSet;
begin
  If fEmptyStr(strFiltro) Then
    Result := cdsVenda.RecordCount
  Else
  Begin
    cdsDados := TUniClientDataSet.Create(nil);
    Try
      pCloneDataSet(cdsDados, cdsVenda);

      cdsDados.Filtered := False;
      cdsDados.Filter := cdsVenda.Filter;

      If Not fEmptyStr(cdsDados.Filter) Then
        cdsDados.Filter := cdsDados.Filter + ' AND ';

      cdsDados.Filter := cdsDados.Filter + strFiltro;

      cdsDados.Filtered := True;

      Result := cdsDados.RecordCount;
    Finally
      FreeAndNil(cdsDados);
    End;
  End;
end;

function TFatVenda.fGetQtdParPedOri: Integer;
  Var
    qryTemp: TUniQuery;

  function fVerificarParc: Boolean; begin
    Result := (Self.strEspDoc = 'NF') Or (Self.strEspDoc = 'FF') Or
              (Self.strEspDoc = 'IF');
  end;

  function fQtdeParcs: Integer; begin
    qryTemp.Close();
    qryTemp.SQL.Clear();
    qryTemp.SQL.Text := fSQLVarQtdParPedOri(False, ':NUMDOC', ':ESPDOC', ':EMPDOC', ':CODCLI');
    qryTemp.ParamByName('NUMDOC').AsString := strNumOrc;
    qryTemp.ParamByName('ESPDOC').AsString := strEspOrc;
    qryTemp.ParamByName('EMPDOC').AsString := strEmpDoc;
    qryTemp.ParamByName('CODCLI').AsString := strCodCli;
    qryTemp.Open();

    Result := qryTemp.FieldByName('QTDPAR').AsInteger;
  end;

begin
  Try
    Result  := 0;
    qryTemp := fCriaQuery();

    Try
      If fVerificarParc() Then
        Result := fQtdeParcs();
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TFatVenda.fGetQtdParPedOri]');
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

