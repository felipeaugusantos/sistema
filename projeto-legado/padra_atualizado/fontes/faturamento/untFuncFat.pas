function TValidarAbastecimentoEstoqueDoPedido.fJaFoiEmitidoDocumentoTransferencia(
  strID: String): Boolean;
  Var
    strNumPed: String;
begin
  Result := Not fEmptyStr(fCampoTabela('FGO_NUMFAT', 'FATGOR', ['AUTOINCREM'], [strID]));

  If Not Result Then
  Begin
    strNumPed := fCampoTabela('CONCAT(FGO_NUMDOC,"-",FGO_ESPDOC,"-",FGO_CODEMP)',
      'FATGOR', ['AUTOINCREM'], [strID]);

    FInconsistencia := 'Pedido para abastecimento de estoque ' +
      strNumPed  + ' ainda pendente de emissão da transferência de estoque!';
  End;
end;

{$IFNDEF LINUX}
function TValidarAbastecimentoEstoqueDoPedido.fLiberarComSenha: Boolean;
Var
  objLiberacao : TLiberacao;
  strTexto: String;
  intContador: Integer;
begin
  objLiberacao := TLiberacao.Create;
  try
    if FInconsistencia.Length < 140 then
      objLiberacao.objMsgLibera.pAddTexto(FInconsistencia)
    else
    begin
      strTexto := FInconsistencia;
      intContador := 0;
      while not fEmptyStr(strTexto) do
      begin
        strTexto := Copy(FInconsistencia, (intContador * 140) + 1, 140);
        objLiberacao.objMsgLibera.pAddTexto(strTexto);
        inc(intContador);
      end;
    end;

    objLiberacao.strDirAce := 'PASARC';
    objLiberacao.blnTraTel := True;
    objLiberacao.strSenLib := '';
    objLiberacao.strMsgSen := FInconsistencia;
    objLiberacao.strCodOpe := strLoginUsuarioLogado;
    objLiberacao.strCodDig := '';

    Result := objLiberacao.fLibera;
  finally
    FreeAndNil(objLiberacao);
  end;
end;
{$ENDIF}

function TValidarAbastecimentoEstoqueDoPedido.fJaFoiEmitidoPedidoDeCompraRequisicao(
  strID: String): Boolean;
  Var
    strNumReq: String;
begin
  Result := Not fEmptyStr(fCampoTabela('RCD_SEQPCD', 'MOVRCD', ['AUTOINCREM'], [strID]));

  If Not Result Then
  Begin
    strNumReq := fCampoTabela('CONCAT(RCD_CODIGO,"-",RCD_CODEMP)',
      'MOVRCD', ['AUTOINCREM'], [strID]);

    FInconsistencia := 'Ainda não foi emitido pedido de compra para a requisição ' +
      strNumReq + ' emitida para abastecimento de estoque do pedido de venda!';

    if fCfgSis('PASARC', varBoolean) then
    begin
     {$IFDEF LINUX}
      Result := False;
     {$ELSE}
      Result := fLiberarComSenha;
     {$ENDIF}
      FInconsistencia := '';
    end;
  End;
end;

