function TFatVenda.fGerarComissaoDeBocaDeCaixa(blnPermitirNotaGarantia: Boolean = True): Boolean;
begin
  Result := True;

  If (Not blnCliFil) And (Pos(strClaFis, VS_strClaVen) > 0) Then
    Exit;

  If (blnCliFil) And (blnGravaCtrTe) And (Not blnEhOperacaoDeTransferencia) Then
    Exit;

  If (blnPermitirNotaGarantia) And (FOpcDocTrue = 'NW') Then
    Exit;

  Result := False;
end;

function TFatVenda.fValidaConfigVenDev: Boolean;
  Var
    strDescricao: String;
begin
  Result := False;

  If (Not fEmptyStr(fCfgSis('VENDEV'))) Then
  Begin
    strDescricao := fRetDescTipoOcorrencia(fCfgSis('VENDEV'));

    If (fEmptyStr(strDescricao)) Then
    Begin
      fMensagem('ATENÇÃO!','O Tipo de Ocorrência informado na configuração "CFG_VENDEV" '+
                           'não existe. Para prosseguir, ajuste a configuração!', ['&Ok']);
      Exit;
    End;
  End;

  Result := True;
end;



