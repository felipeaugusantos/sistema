function TFatVenda.fTemItensEntregaImediata(strNumDoc, strEspDoc,
  strCodEmp: String): Boolean;
var
  strSQL: String;
  qryConta: TUniQuery;
begin
  strSQL := '';
  strSQL := strSQL + 'SELECT                           ';
  strSQL := strSQL + '  COUNT(D.AUTOINCREM) AS CNTEIM  ';
  strSQL := strSQL + 'FROM                             ';
  strSQL := strSQL + '  FATDOR D                       ';
  strSQL := strSQL + 'INNER JOIN EXTDOR E              ';
  strSQL := strSQL + '  ON E.FDO_SEQFDO = D.AUTOINCREM ';
  strSQL := strSQL + 'INNER JOIN FATGOR G              ';
  strSQL := strSQL + '  ON G.AUTOINCREM = D.FDO_SEQGER ';
  strSQL := strSQL + 'WHERE FDO_NUMDOC = :NUMDOC       ';
  strSQL := strSQL + '  AND FDO_ESPDOC = :ESPDOC       ';
  strSQL := strSQL + '  AND FDO_CODEMP = :CODEMP       ';
  strSQL := strSQL + '  AND FDO_ENTRET = ''E''         ';
  strSQL := strSQL + '  AND FDO_ENTFUT = ''N''         ';

  qryConta := fCriaQuery();
  Try
    With qryConta do
    Begin
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      Result := FieldByName('CNTEIM').AsInteger > 0;
    end;
  Finally
    FreeAndNil(qryConta);
  End;
end;

