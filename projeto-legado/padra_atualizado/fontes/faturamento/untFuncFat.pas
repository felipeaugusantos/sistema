function TFatVenda.fTemComboComItemBrindeEntregaFutura(AMostraMsg: Boolean = False): Boolean;
  Var
    item: TDadosFechamento;
begin
  Result := False;

  If (Length(arrMatItens) > 0) Then
  Begin
    For item In arrMatItens Do
    Begin
      If (item.strEntFut = 'S') And (item.strBrinde = 'S') Then
