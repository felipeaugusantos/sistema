procedure TFatVenda.pCalculaValUniRateioServico;
  Var
    i: Integer;
    intUltIte: Integer;
    fltTotIte: Double;
    fltTotRat: Double;

   function fItemEntraNoRateio(item: TDadosFechamento): Boolean;
   begin
     Result := (item.strCodIte <> fCfgSis('ITEFRE')) And
               (item.strCodIte <> fCfgSis('ITEMAN')) And
               (item.strCodIte <> fCfgSis('ITELAN')) And
               (item.strCodIte <> fCfgSis('ITEBOM')) And
               (item.strCodIte <> fCfgSis('ITESER')) And
               (item.strCodIte <> fCfgSis('SERTER')) And
               (item.strCodIte <> fCfgSis('ITETAX'));
   end;

begin
  fltTotIte := 0;
  fltTotRat := 0;
  intUltIte := 0;

  For i := 0 To Length(arrMatItens) -1 Do
    If fItemEntraNoRateio(arrMatItens[i]) Then
      fltTotIte := fltTotIte + arrMatItens[i].fltTotIte;

  For i := 0 To Length(arrMatItens) -1 Do
  Begin
    If fItemEntraNoRateio(arrMatItens[i]) Then
    Begin
      arrMatItens[i].fltFatRat := arrMatItens[i].fltTotIte / fltTotIte;
      arrMatItens[i].fltSerRat := fFormataFloat(fGetTotalServNaoTerc('R') * arrMatItens[i].fltFatRat, 2);
      fltTotRat := fltTotRat + arrMatItens[i].fltSerRat;
      intUltIte := i;
    End;
  End;

  If fFormataFloat(fGetTotalServNaoTerc('R'), 2) <> fFormataFloat(fltTotRat, 2) Then
    arrMatItens[intUltIte].fltSerRat := arrMatItens[intUltIte].fltSerRat +
                                       (fFormataFloat(fGetTotalServNaoTerc('R'), 2) -
                                        fFormataFloat(fltTotRat, 2));
end;

