procedure TFatVenda.pCarregaContrato;
  Var
    strSQL: String;
    qryAux: TUniQuery;
    blnOk: Boolean;
    strCodCon: String;
begin

  qryAux := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  CON_CODCON, ';
  strSQL := strSQL + '  CON_DESCON, ';
  strSQL := strSQL + '  SUM(CON_VALSER) AS CON_TOTCON ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADCON ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  CON_CODCLI = :CODCLI ';
  strSQL := strSQL + 'GROUP BY ';
  strSQL := strSQL + '  CON_CODCON ';

  With qryAux Do
  Begin

    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString := strCodCli;
    Open;
    TFloatField(FieldByname('CON_TOTCON')).DisplayFormat := '#,##0.00';
    blnOk := (Not IsEmpty);

  End;

  If (blnOk) Then
  Begin

    If (qryAux.RecordCount > 1) Then
    Begin
      Try
        pCriarFormularios(TfrmFatSelContratos, frmFatSelContratos);

        frmFatSelContratos.dtsContratos.DataSet := qryAux;

        If (frmFatSelContratos.ShowModal = mrOk) Then
          strCodCon := qryAux.FieldByName('CON_CODCON').AsString
        Else
          strCodCon := '';

      Except
        On E: Exception Do
        Begin
          strCodCon := '';
          pMensagensErro(E.Message, '[TFatVenda.pCarregaContrato]');
        End;
      End;

      pFreeAndNil(frmFatSelContratos);

    End
    Else
    Begin
      strCodCon := qryAux.FieldByName('CON_CODCON').AsString;
    End;

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  * ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADCON ';
    strSQL := strSQL + 'WHERE ';
