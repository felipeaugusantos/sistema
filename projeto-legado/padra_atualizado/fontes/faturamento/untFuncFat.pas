  Begin
    strPromocSav := Self.strPromoc;
    Self.strPromoc := strPromocIte;
    fltUniOriIte := fPegaPrecoVenda(qryConIte,
                                    strEmpresaItem,
                                    strEntSai,
                                    fltMargem,
                                    (Pos('ITEM ESPECIAL', strDesIte) > 0),
                                    strIdeProIte,
                                    strTabPreIte,
                                    True,
                                    FTaxJur,
                                    FUniVis);
    Self.strPromoc := strPromocSav;                                
  End;                                  

  With recInfoTravaUnitario Do
  Begin
    strOpcTrvUnit := '';
    strLibUniComSenha := 'N';
    fltUniLiqCal := fltUniLiqTmp;
    fltMargMin := 0;
    fltMargPra := 0;
    blnNivel2 := False;
    blnNivel3 := False;
    blnNivel4 := False;
    blnNivel5 := False;
    blnNivel6 := False;
  End;

  objLiberacao := TLiberacao.Create;
  try
    try

      If (Not blnCliFil) And (Pos(strOpcDoc, 'BR_TE_EF_CI_UC_'+IIF(fCfgSis('DESICF', varBoolean),'','CF_')) <= 0) And (Not blnComVal) And (strBrinde <> 'S') Then
      Begin
        fltUniLiqTmp := fltUnitarTmp;

        if Pos(strOpcDoc, 'OE_') > 0 then
        begin
          fltUniLiqTmp := fltUniLiqTmp - fRetornaVrDesconto(2, fltUniLiqTmp, fltDesCon);
