{$IFNDEF LINUX}
function TGeraArquivoAnexoEmailAutomatico.fGeraAnexoBoleto: TArray<TRecArquivosGatilhos>;
var
  qry: TUniQuery;
  strPath,
  strPathBoleto : String;

  blnBoletoViaUnica: Boolean;
begin
  blnBoletoViaUnica := ((fCfgSis('NOVLAY') = 'C') or (fCfgSis('NOVLAY') = 'U'));
  strPath := ExtractFilePath(Application.ExeName) + IIF(fCfgSis('GRVBOL') = '1', 'Boletos\', 'Boletos_'+ FCodEmp +'\');

  qry := fCriaQuery;
  Try
    qry.Close;
    qry.SQL.Clear;
    qry.SQL.Add('SELECT AUTOINCREM, CTR_NUMDUP, CTR_PARCEL, CTR_ESPDOC ');
    qry.SQL.Add('FROM CADREC');
    qry.SQL.Add('WHERE ');
    qry.SQL.Add('      CTR_DTAREC IS NULL');
    qry.SQL.Add('  AND CTR_VALDUP > 0');
    qry.SQL.Add('  AND CTR_NUMDUP = :NUMDOC');
    qry.SQL.Add('  AND CTR_CODCLI = :CODCLI');
    qry.SQL.Add('  AND CTR_CODEMP = :CODEMP');
    qry.SQL.Add('  AND CTR_ESPDOC = :ESPDOC');
    qry.SQL.Add(IIF(blnBoletoViaUnica, 'LIMIT 1 ', ''));

    qry.ParamByName('NUMDOC').AsString := FNumDoc;
    qry.ParamByName('CODCLI').AsString := FCodCli;
    qry.ParamByName('CODEMP').AsString := FCodEmp;
    qry.ParamByName('ESPDOC').AsString := FEspDoc;
    qry.Open;

    If (qry.IsEmpty) Then
      Exit;

    qry.First;
    While not qry.Eof do
    Begin
      strPathBoleto := strPath +
                         qry.FieldByName('CTR_NUMDUP').AsString +
                           IIF(not blnBoletoViaUnica, qry.FieldByName('CTR_PARCEL').AsString, '')+'.pdf';

      If (FileExists(strPathBoleto)) Then
      begin
        SetLength(Result, Length(Result)+1);
        Result[High(Result)] := TRecArquivosGatilhos.Create('BOLETO_'+ExtractFileName(strPathBoleto).Replace(ExtractFileExt(ExtractFileName(strPathBoleto)), EmptyStr)+'-'+qry.FieldByName('CTR_ESPDOC').AsString,
                                                            strPathBoleto,
                                                            EmptyStr);
      end;

      if blnBoletoViaUnica then
        Break;

      qry.Next;
    End;
  Finally
    qry.Close;
    FreeAndNil(qry);
  End;
end;
{$ENDIF}

