        objLinha.pAddColuna('%M.Prop'   , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_MARITE').AsFloat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
        objLinha.pAddColuna('%M.Prat'   , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_MARLUC').AsFloat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      End
      Else If (TMargemMinima.PorPrecoCustoPreMed) Then
      Begin
        objLinha.pAddColuna('Pr.Medio'  , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_PREMED').AsFloat, ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
        objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_MARBRU_PREMED').AsFloat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      End
      Else If (TMargemMinima.PorCustoRealPreMed) Then
      Begin
        objLinha.pAddColuna('Pr.Medio'  , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_PREMED_LIQ').AsFloat, ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
        objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_MARLIQ_PREMED').AsFloat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      End;

      If strExMaF4[5] = 'S' Then
      begin
        objLinha.pAddColuna('Pr.Ult+Imp', FloatToStrf(FieldByName('ITE_CUSIMP').AsFloat, ffFixed, 12, VS_intDecUni)                , 12 , alDireita  , teAmbos);
        objLinha.pAddColuna('%M.Ult+I'  , FloatToStrf(FieldByName('ITE_MARIMP').AsFloat, ffFixed, 10, 2)                           ,  8 , alDireita  , teAmbos);
      end
      else
      begin
        If (TMargemMinima.PorPrecoCustoPreCus) Then
        Begin
          objLinha.pAddColuna('Pr.Medio'  , FloatToStrf(FieldByName('ITE_PREMED').AsFloat, ffFixed, 12, VS_intDecUni), 12 , alDireita  , teAmbos);
          objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_MARBRU_PREMED').AsFloat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) ,fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos)
        End
        Else If (TMargemMinima.PorCustoRealPreCus) Then
        Begin
          objLinha.pAddColuna('Pr.Medio'  , FloatToStrf(FieldByName('ITE_PREMED_LIQ').AsFloat, ffFixed, 12, VS_intDecUni), 12 , alDireita  , teAmbos);
          objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(FieldByName('ITE_MARMED').AsFloat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)        ,fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
        End;
      end;

      if strMarMkp = '99' then
        objLinha.pAddColuna('%Markup'   , FloatToStrf(FieldByName('ITE_MARKUP').AsFloat, ffFixed, 8, 2), 8  , alDireita  , teAmbos);

      {Mostra empresa do item quando utiliza Multiloja!}
      if fSolicitaEmpresaNoItemMultLoja then
        objLinha.pAddColuna('Emp'       , FieldByName('ITE_EMPITE').AsString, 3  , alCentro  , teAmbos);

      If (Pos(objMsg.strDirAce, 'EMIFUT_EMIFUTNL_') > 0) Then
      Begin
        objLinha.pAddColuna('Pr.Compra'       , FloatToStrf(fRetPrecoCompra(cdsItensTmp.FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString), ffFixed, 15, VS_intDecUni), 15  , alCentro  , teAmbos);
        objLinha.pAddColuna('Pr.Compra Liq.'  , FloatToStrf(untFuncoesSimples.fCalculaPrecoCompraLiq(cdsItensTmp.FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, Nil), ffFixed, 15, VS_intDecUni), 15  , alCentro  , teAmbos);
