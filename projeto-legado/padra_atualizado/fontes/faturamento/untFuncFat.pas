  function fCustoMinimoTrava: Double;
    Var
      fltPrecoCusto,
      fltCustoReal: Double;
      calcCustoReal: TCalcCustoReal;
  begin
    Result := 0;

    fltPrecoCusto := fltCusIte; // Custo Cadastro

    calcCustoReal := TCalcCustoReal.Create;

    With dtsDadIte Do
    Begin

      pCarregaValoresCusto(FieldByName('ITE_CODITE').AsString,
                           fGetEmpCalculoItem(strEmpresaItem),
                           IIF(strTabPreIte.IsEmpty, strTabPre, strTabPreIte));

      calcCustoReal.fltUnitar := fltUnitar;
      calcCustoReal.fltPreCus := fltCusIte;
      calcCustoReal.fltOutVal := fRetOutVal(FieldByName('ITE_OUTVAL').AsFloat);
      calcCustoReal.fltIcmSai := fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat);
      calcCustoReal.fltImpFed := fRetImpFed(FieldByName('ITE_IMPFED').AsFloat);
      calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(fRetDesOpe(FieldByName('ITE_DESOPE').AsFloat));

      strCodSit := '';
      strCodAbf := fGetCodAbf(FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(strEmpresaItem));
      If (Not fEmptyStr(Self.GetTipAbf(strEmpresaItem))) And (fBuscaAbfIcm(FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, fTrocaUFEndEntrega)) Then
        strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpresaItem)).AsString;

      calcCustoReal.fltDifal := fGetAlqDifal(FieldByName('ITE_CODITE').AsString,
                                             strEmpresaItem,
                                             strCodAbf,
                                             strCodSit);

      calcCustoReal.fltFcp   := fGetAlqFcpIcms(FieldByName('ITE_CODITE').AsString,
                                               strEmpresaItem,
                                               strCodAbf,
                                               strCodSit,
                                               fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat),
                                               calcCustoReal.fltUnitar);

      fltCustoReal := fRetornaPrecoCusto(Preco_de_Custo_Real,
                                         FieldByName('ITE_CODITE').AsString,
                                         strEmpresaItem,
                                         fRetPreCus(FieldByName('ITE_PRECUS').AsFloat),
                                         '',
                                         calcCustoReal,
                                         (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));

      FreeAndNil(calcCustoReal);
    End;

    If fCfgSis('MINCUS') = TRAVA_MINIMO_PRECO_CUSTO Then
      Result := fltPrecoCusto

    Else If fCfgSis('MINCUS') = TRAVA_MINIMO_CUSTO_REAL Then
      Result := fltCustoReal;
  end;

