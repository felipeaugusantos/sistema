  If Self.strCodTra <> Self.strCodTraOrc Then
  Begin
    If fMensagem('ATENÇÃO', 'A transp. do end. de entrega é diferente da transp. informada no docto.' + #13#10 +
                            Copy('Transp. Docto..: ' + Self.strCodTraOrc + '-' + fRetNomTransportadora(Self.strCodTraOrc), 1, 71) + #13#10 +
                            Copy('Transp. End.Ent: ' + Self.strCodTra + '-' + fRetNomTransportadora(Self.strCodTra), 1, 71) + #13#10 +
                            'Deseja manter a transportadora do: ', ['&Documento', '&End.Entrega']) = 1 Then
      Result := Self.strCodTraOrc;
  End;
end;

procedure TFatVenda.pAtualizaDataHoraCadRecDocsConf();
  Var
    intIdx: Integer;
    strNumDoc,
    strEspDoc,
    strCodEmp,
    strCodCli: String;
begin
  For intIdx:=0 To PRed(Self.stlCadRecDtaLogDocsConf.Count) Do
  Begin
    Try
      strNumDoc := Copy(stlCadRecDtaLogDocsConf[intIdx],01,12);
      strEspDoc := Copy(stlCadRecDtaLogDocsConf[intIdx],13,02);
      strCodEmp := Copy(stlCadRecDtaLogDocsConf[intIdx],15,03);
      strCodCli := Copy(stlCadRecDtaLogDocsConf[intIdx],18,08);

      stlCadRecDtaLogDocsConf[intIdx] := strNumDoc +
                                         strEspDoc +
                                         strCodEmp +
                                         strCodCli + '-' +
                                         DateTimeToStr(fRetUltimaAlteracaoCadRecGeral(strNumDoc, strEspDoc, strCodEmp, strCodCli));
    Except
    End;
  End;
end;

function TFatVenda.fValidouDataHoraCadRecDocsConf: Boolean;
  Var
    intIdx: Integer;
    strNumDoc,
    strEspDoc,
    strCodEmp,
    strCodCli: String;
    dtaLogCtrLoad_,
    dtaLogCtrAtual: TDateTime;
begin
  Result := True;

  For intIdx:=0 To Self.stlCadRecDtaLogDocsConf.Count-1 Do
  Begin
    Try
      strNumDoc := Copy(stlCadRecDtaLogDocsConf[intIdx],01,12);
      strEspDoc := Copy(stlCadRecDtaLogDocsConf[intIdx],13,02);
      strCodEmp := Copy(stlCadRecDtaLogDocsConf[intIdx],15,03);
      strCodCli := Copy(stlCadRecDtaLogDocsConf[intIdx],18,08);
      dtaLogCtrLoad_ := StrToDateTime(Copy(stlCadRecDtaLogDocsConf[intIdx],27,Length(stlCadRecDtaLogDocsConf[intIdx])));
      dtaLogCtrAtual := fRetUltimaAlteracaoCadRecGeral(strNumDoc,strEspDoc,strCodEmp,strCodCli);

      If (dtaLogCtrAtual <> dtaLogCtrLoad_) Then
      Begin
        pMensagemOK('Documento ' + strNumDoc + '-' +
                                   strEspDoc + '-' +
                                   strCodEmp + ' ' +
                     'sofreu alguma uma alteração!' + #13#10 +
                     'Verifique se as duplicatas foram recebidas por outra estação. ' + #13#10 +
                     'É necessário carregar novamente o documento para confirmar o mesmo!');
        Result := False;             
      End;
    Except
      //
    End;
  End;
end;

