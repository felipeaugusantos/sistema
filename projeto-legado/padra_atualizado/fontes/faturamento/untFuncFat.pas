function TFatVenda.fExisteDivergenciaBrutaRETOuIPI(out strTipIteDiv: String): Boolean;
  Var
    item: TDadosFechamento;
    qryGen: TUniQuery;

    function fTemDivergenciaRET:Boolean;
    begin
      Result := False;

      If ((fFormataFloat(item.fltValRet, 2) = 0.00) And (fFormataFloat(qryGen.FieldByName('FDO_VALRET').Value, 2) > 0.00)) Or
         ((fFormataFloat(item.fltValRet, 2) > 0.00) And (fFormataFloat(qryGen.FieldByName('FDO_VALRET').Value, 2) = 0.00)) Then
      Begin   
        Result := True;
        strTipIteDiv := 'Substituição Tributária';
      End;
    end;

    function fTemDivergenciaIPI:Boolean;
    begin
      Result := False;
      
      If ((fFormataFloat(item.fltValIpi, 2) = 0.00) And (fFormataFloat(qryGen.FieldByName('FDO_VALIPI').Value, 2) > 0.00)) Or
         ((fFormataFloat(item.fltValIpi, 2) > 0.00) And (fFormataFloat(qryGen.FieldByName('FDO_VALIPI').Value, 2) = 0.00)) Then
      Begin   
        Result := True;
        strTipIteDiv := 'IPI';
      End;
    end;
    
begin
  Result := False;

  If fEhClienteFilialSimplesNacional Then
    Exit;


  If fPedidoGeradoAosMoldesDaPrepTE Then
    Exit;

  If fEhExpedicaoDeAbastecimento Then
    Exit;

  qryGen := fCriaQuery;
  Try
    With qryGen Do
    Begin
      Close;
      SQL.Text := 'SELECT FDO_VALRET, FDO_VALIPI FROM FATDOR WHERE AUTOINCREM = :AUTINC';

      For item in Self.arrMatItens Do
      Begin
        Close;
        ParamByName('AUTINC').Value := item.strSeqDet;
        Open;

        If (fTemDivergenciaRET) Or (fTemDivergenciaIPI) Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

