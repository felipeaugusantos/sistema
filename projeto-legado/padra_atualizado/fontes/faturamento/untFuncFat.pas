    Exit;

  try
    strSQL := '';
    strSQL := strSQL + 'INSERT INTO EXTLAR ';
    strSQL := strSQL + '  (AUTOINCREM, COD_FATGOR, SEQ_CODLAR) ';
    strSQL := strSQL + 'VALUES ';
    strSQL := strSQL + '  (:AUTINC, :SEQFGO, :CODLAR) ';

    qryExtLar := fCriaQuery;

    try
      qryExtLar.SQL.Text := strSQL;

      for intCont := 0 to Length(arrExtLar) - 1 do
      begin
        qryExtLar.Close;
        qryExtLar.ParamByName('AUTINC').AsString := fRetAutoIncrem('EXTLAR', VS_strCodEmp);
        qryExtLar.ParamByName('SEQFGO').AsString := strAutIncFatGor;
        qryExtLar.ParamByName('CODLAR').AsString := arrExtLar[intCont];
        qryExtLar.ExecSQL;
      end;
    finally
      FreeAndNil(qryExtLar);
    end;
  except
    on E: Exception do
    begin
      Result := False;
      pMensagensErro(E.Message, '[fRegravaSepDor]');
    end;
  end;
end;

