function TFatVenda.fRetornaTotFreProporcionalConformeOriginal: Double;
  Var
    item: TDadosFechamento;
begin
  Result := 0;

  For item in Self.arrMatItens Do
  Begin
    If (fCampoTabela('IFNULL(FDO_QTDBAI, 0)', 'FATDOR', ['AUTOINCREM'], [item.strSeqDet]) > 0) Then
    Begin
      Result := Result + fFormataFloat(fCampoTabela('IF(IFNULL(FDO_FRERAT,0)>0, FDO_FRERAT, FDO_TOTFRE)',
                                       'FATDOR INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO',
                                       ['FATDOR.AUTOINCREM'],
                                       [item.strSeqDet]), 2);
    End
    Else
    Begin
      Result := Result + fFormataFloat((fCampoTabela('(IF(IFNULL(FDO_FRERAT,0)>0, FDO_FRERAT, FDO_TOTFRE)/FDO_QTDITE)',
                                                     'FATDOR INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO',
                                                     ['FATDOR.AUTOINCREM'],
                                                     [item.strSeqDet]) * item.fltQtdIte), 2); 
    End;
  End;

  Result := fFormataFloat(Result, 2);
end;

function TFatVenda.fRetornaTotalCashBackProfissional(
  const strCodCliProfissional: String): Double;
const
  TEXT_HIST01 = 'REF. CASH BACK PROFISSIONAIS - GERADO AUTOMATICAMENTE';
var
  qryDados : TUniQuery;
begin
  qryDados := fCriaQuery;
  Try
    qryDados.SQL.Text := 'SELECT '
                       + '       SUM(CTR_VALORI) as TOTAL_CASHBACK '
                       + '  FROM CADREC '
                       + ' WHERE CTR_CODCLI = :CODCLI '
                       + '   AND CTR_CODEMP = :CODEMP '
                       + '   AND CTR_HIST01 LIKE "%' + TEXT_HIST01 + '%"  '
                       + '   AND CTR_DTAREC IS NULL ';

    qryDados.ParamByName('CODCLI').AsString := strCodCliProfissional;
    qryDados.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDados.Open;

    Result := Abs(qryDados.FieldByName('TOTAL_CASHBACK').AsFloat);
  Finally
    FreeAndNil(qryDados);
  End;
end;

function TFatVenda.fRetornaTotFreJaBaixado: Double;
  Var
    item: TDadosFechamento;
begin
  Result := 0;

  For item in Self.arrMatItens Do
  Begin
    Result := Result + fCampoTabela('(IF(IFNULL(FDO_FRERAT,0)>0, FDO_FRERAT, FDO_TOTFRE)/FDO_QTDITE) * IFNULL(FDO_QTDBAI,0)',
                                    'FATDOR INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = FDO_SEQFDO',
                                    ['FATDOR.AUTOINCREM'],
                                    [item.strSeqDet]);
  End;
    
  Result := fFormataFloat(Result, 2);
end;

function TFatVenda.fRetornaDesEspJaBaixado: Double;
  Var
    item: TDadosFechamento;
    Sl: TStringList;
begin
  Result := 0;
  SL := TStringList.Create;
  Try
    For item in Self.arrMatItens Do
    Begin
      Result := Result + fFormataFloat(fCampoTabela('IFNULL(FDO_DESBAI, 0)', 'FATDOR', ['AUTOINCREM'], [item.strSeqDet]), 2); 
      SL.Add(item.strSeqDet);
    End;

    If Assigned(cdsDadosPedBaixados) Then
    Begin
      If cdsDadosPedBaixados.Active Then
      Begin
        cdsDadosPedBaixados.First;
        While Not cdsDadosPedBaixados.Eof Do
        Begin
          If (SL.IndexOf(cdsDadosPedBaixados.FieldByName('ITE_SEQDET').AsString) = -1) Then
          Begin
            Result := Result + fFormataFloat(fCampoTabela('IFNULL(FDO_DESBAI, 0)', 'FATDOR', ['AUTOINCREM'], [cdsDadosPedBaixados.FieldByName('ITE_SEQDET').AsString]), 2);
            SL.Add(cdsDadosPedBaixados.FieldByName('ITE_SEQDET').AsString);
          End;
      
          cdsDadosPedBaixados.Next;
        End;
        cdsDadosPedBaixados.First;
      End;
    End;
  Finally
    Result := fFormataFloat(Result, 2);
  End;
end;

procedure TFatVenda.pCarregaDesBaiNaMatrizItens;
  Var
    intContador: Integer;
begin
  For intContador := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
