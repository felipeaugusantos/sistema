function TFatVenda.fValidarMargemMinimaPorProduto(const blnPedeSenha: Boolean; const blnValidarCusto: Boolean): Boolean;
  Var
    objValDoc : TValidarPedido;
    objLiberacao : TLiberacao;
    strTRADESBkp: String;
    strTRVEPRBkp: String;
    blnResultValidaUnitario : Boolean;
    cdsCdsXmlF4 : TUniClientDataSet;
begin
  strTRADESBkp := VS_strTRADES;
  strTRVEPRBkp := VS_strTRVEPR;
  objValDoc := TValidarPedido.Create(Self);
  cdsCdsXmlF4 := TUniClientDataSet.Create(nil);
  Try
    VS_strTRADES := '3';//Altera para validar como se estivesse configurado por Margem Minima por produto
    VS_strTRVEPR := '1';//Altera para validar como se estivesse configurado para travar item a item

    cdsCdsXmlF4.Data := cdsVenda.Data;
    cdsCdsXmlF4.LogChanges := False;
    objValDoc.onProgresso := nil;
    objValDoc.onIgnorarCondicao := nil;
    objValDoc.onAtualizaPrecos := pAtualizaPrecosParaTrava;
    objValDoc.blnPedirSenha := False;
    objValDoc.blnValidarUnitarioIndividual := False;
    objValDoc.blnExecMontaMsgInterna := False;

    blnResultValidaUnitario := objValDoc.fValidaUnitario;

    Result := blnResultValidaUnitario and objValDoc.objMsgMenMin.isEmpty;

    If objValDoc.objMsgMenCus.isEmpty Then
      blnResultValidaUnitario := True;

    If (blnValidarCusto) And (Not blnResultValidaUnitario) And (blnPedeSenha) Then
    Begin
      If (Not fLiberouVendaAbaixoDoCusto(objValDoc.objMsgMenCus.fGetJsonObject.ToJson, cdsCdsXmlF4)) Then
        Exit(False);
    End;

    If (Not Result) And blnPedeSenha Then
    Begin
      objLiberacao := TLiberacao.Create;
      try
        objLiberacao.objMsgLibera.fGetObjectFromJson(objValDoc.objMsgMenMin.fGetJsonObject.ToJSON);
        objLiberacao.strDirAce := 'PRMIN';
        objLiberacao.strSenLib := fCfgSis('SENLBD');
        objLiberacao.strMsgSen := 'Trava de Preço';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := Self.strCodVen;
        objLiberacao.strCodDig := Self.strCodDig;
        objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliNom + IIF(strCliOrg = 'S', ' ( *** ÓRGÃO PÚBLICO *** )', '');
        objLiberacao.strCpfCnpj := Self.strCliCgc;
        objLiberacao.tipCliFor := IIF(Self.strOpcDoc = 'OF', cfFornecedor, cfCliente);
        Result := fFatMensagemLiberacao(objLiberacao);
      finally
        FreeAndNil(objLiberacao);
      end;
    End;

  Finally
    VS_strTRADES := strTRADESBkp;//Restaura a trava configurada originalmente
    VS_strTRVEPR := strTRVEPRBkp;//Restaura a trava configurada originalmente
    FreeAndNil(objValDoc);
    FreeAndNil(cdsCdsXmlF4);
  End;
end;

function TFatVenda.fValidarPermissaoEmitirDocumentoComServicos: Boolean;
begin
  Result := True;

  If (Self.fltTotSer > 0) Then
  Begin
    If (Not fHaveraDesmembramentoVenda(arrMatItens)) And (Self.strEspDoc = 'IF') Then
    Begin
      fMensagem('ATENÇÃO', 'Não é permitido faturar orçamentos/pedidos com serviço em cupom fiscal.', ['&O k']);
      Result := False;
    End;

    If (Pos(Self.strEspDoc, 'NF_EL_NS_IF_IV_') <= 0) And
       (Not Self.blnTaxaBombeamentoPedOrc) And
       (Self.fltValIss > 0) And (Self.strRetIss = 'S') Then
    Begin
      fMensagem('ATENÇÃO', 'Cliente configurado para Reter ISS, assim o valor do ' +
                           'ISS foi descontado do valor total do documento. ' +
                           'Somente será permitido emitir Nota Fiscal para esta Venda!', ['&O k']);
      Result := False;
    End;
  End;

end;

function TFatVenda.fVerificaItensCupomAbf(): Boolean;
  Var
    strCupFisAlq: String;
    intIndex: Integer;

    procedure pVerificaAlqReg(strCodEcf: String);
      Var
        qryGen: TUniQuery;
    Begin
      qryGen := fCriaQuery(Nil);
      qryGen.SQL.Add('SELECT * FROM ECFALQ WHERE ECF_CODECF = :CODECF AND ECF_PERALQ = :PERALQ');
      qryGen.ParamByName('CODECF').AsString := strCodEcf;
      qryGen.ParamByName('PERALQ').AsFloat  := Self.arrMatItens[intIndex].fltAlqIcm;
      qryGen.Open;

      If qryGen.IsEmpty Then
        strCupFisAlq := strCupFisAlq + Self.arrMatItens[intIndex].strCodIte + ', ';

      FreeAndNil(qryGen);
    End;

begin
  Result := True;

  If Self.strEspDoc <> 'IF' Then
    Exit;

  If fUsaSat Or (fCfgSis('USNFCE', varBoolean)) Then
  Begin
    Exit;
  End;

  strCupFisAlq := '';
  For intIndex := 0 To Length(Self.arrMatItens) - 1 Do
  Begin
    If fEhItemServico(Self.arrMatItens[intIndex].strCodIte) Then
      Continue;

    If (Not fEmptyStr(fArqIniLocal(0, 'IMPRESSORA_FISCAL', 'IMPRESSORA'   , '', fCfgSis('DIRINI') + '/opcoes_fiscal.ini' ))) And
       (fCfgSis('SIMPAU', varString, GetEmpCfg(Self.arrMatItens[intIndex].strEmpIte)) <> 'S') And
       (Pos( Self.arrMatItens[intIndex].strCodFis, CST_ANTECIPACAO_ICMS + CST_ISENTO + CST_NAO_TRIBUTADO + CST_SUBSTITUICAO + '_SSS_' ) <= 0) Then
    Begin
      pVerificaAlqReg(fArqIniLocal(0, 'IMPRESSORA_FISCAL', 'IMPRESSORA'   , '', fCfgSis('DIRINI') + '/opcoes_fiscal.ini' ));
    End;
  End;

  If Not fEmptyStr(strCupFisAlq) Then
  Begin
    Result := False;
    strCupFisAlq := LeftStr(strCupFisAlq, Length(strCupFisAlq) - 2);
    fMensagem('ATENÇÃO', 'As alíquotas dos itens ' + strCupFisAlq + ' não estão no cadastro de ECF.' + #13#10 +'Favor cadastrar conforme Leitura X, ou corrigir a alíquota no item.',['&OK']);
  End;

end;

function TFatVenda.fValidarQuantidadeEstoqueMinimoParaClienteFilial: Boolean;
  Var
    LQuery                : TUniquery;
    LobjLiberacao         : TLiberacao;
    LfltEstoqueDisponivel : Double;
    LblnSolicitaLiberacao : Boolean;
begin
  Result := True;

  LblnSolicitaLiberacao := False;

  LQuery        := fCriaQuery;
  LobjLiberacao := TLiberacao.Create;

  Try
    cdsVenda.DisableControls;
    cdsVenda.First;

    LobjLiberacao.objMsgLibera.pAddTexto('Solicitação de Abastecimento acima do Estoque Mínimo ');
    LobjLiberacao.objMsgLibera.pAddTexto('--------------------------------------------------------------------------------------------------------------------');
    LobjLiberacao.objMsgLibera.pAddTexto('Empresa Solicitante : '+VS_strCodEmp+' - '+Copy(fRetNomeEmpresaSelec(VS_strCodEmp),1,30));
    LobjLiberacao.objMsgLibera.pAddTexto('Empresa Abastecedora: '+cdsVenda.FieldByName('ITE_EMPITE').AsString+' - '+
                                                                  Copy(fRetNomeEmpresaSelec(cdsVenda.FieldByName('ITE_EMPITE').AsString),1,30));
    LobjLiberacao.objMsgLibera.pAddTexto('--------------------------------------------------------------------------------------------------------------------');
    LobjLiberacao.objMsgLibera.pAddTexto('Vendedor            : '+strCodVen+' - '+Copy(fRetNomeOperador(strCodVen),1,30));
    LobjLiberacao.objMsgLibera.pAddTexto('--------------------------------------------------------------------------------------------------------------------');
    LobjLiberacao.objMsgLibera.pAddTexto('                                                       PRODUTOS                                                     ');
    LobjLiberacao.objMsgLibera.pAddTexto('--------------------------------------------------------------------------------------------------------------------');
    LobjLiberacao.objMsgLibera.pAddTexto('COD   | DESCRICAO                               | UN | SALDO DISPON. | QTD.SOLICIT.  |    EST.MIN.   | QTD.EXCEDENTE');
    LobjLiberacao.objMsgLibera.pAddTexto('--------------------------------------------------------------------------------------------------------------------');

    LQuery.Sql.Text := 'SELECT * FROM ITEGER WHERE ITE_CODITE = :CODITE AND ITE_CODEMP = :CODEMP ';

    while not (cdsVenda.Eof) do
    Begin
      LQuery.ParamByName('CODITE').AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;
      LQuery.ParamByName('CODEMP').AsString := VS_strCodEmp;
      LQuery.Open;
      LfltEstoqueDisponivel := fRetornaSaldoDisponivel(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                                       False,
                                                       False,
                                                       '',
                                                       True,
                                                       VS_strCodEmp);
      if LfltEstoqueDisponivel + cdsVenda.FieldByName('ITE_QTDITE').AsFloat > LQuery.FieldByName('ITE_ESTMIN').AsFloat then
      Begin
        LblnSolicitaLiberacao := True;
        LobjLiberacao.objMsgLibera.pAddTexto(fPadR(cdsVenda.FieldByName('ITE_CODITE').AsString, 6)+'|'+
                                             fPadR(cdsVenda.FieldByName('ITE_DESITE').AsString, 41)+'|'+
                                             fPadC(cdsVenda.FieldByName('ITE_UNIDAD').AsString, 4)+'|'+
                                             fPadC(FloatToStr(LfltEstoqueDisponivel), 15)+'|'+
                                             fPadC(FloatToStr(cdsVenda.FieldByName('ITE_QTDITE').AsFloat), 15)+'|'+
                                             fPadC(FloatToStr(LQuery.FieldByName('ITE_ESTMIN').AsFloat), 15)+'|'+
                                             fPadC(FloatToStr((LQuery.FieldByName('ITE_ESTMIN').AsFloat-(LfltEstoqueDisponivel + cdsVenda.FieldByName('ITE_QTDITE').AsFloat))* -1),15));
      End;

      LQuery.Close;

      cdsVenda.Next;
    End;
    cdsVenda.EnableControls;

    if LblnSolicitaLiberacao then
    Begin
      LobjLiberacao.strDirAce := 'LTESMI';
      LobjLiberacao.strCodOpe := strLoginUsuarioLogado;
      LobjLiberacao.blnSempreVariavelUsuario := True;
      LobjLiberacao.strSequencialUnicoDtaHra := FSequencialUnicoDtaHrLogVar;
      Result := LobjLiberacao.fLibera;
    End;

  Finally
    FreeAndNil(LQuery);
    FreeAndNil(LobjLiberacao);
  End;

end;

class function TFatVenda.fValidaLoteEmbalagemColorantes(strCodIte, strIdePro, strCodEmb, strEmpLot: String;
  matrizSaldosColorantes: TClassMatrizSaldosColorantes; objCadLot: TCadLot; Var stlBasesColorantes: TStringList): Boolean;
  Var
    intContador: Integer;
begin
  Result := True;

  For intContador := 0 To matrizSaldosColorantes.Count - 1 Do
  Begin
    If (Not objCadLot.fExisteLotePrincipalTintaMaquina(matrizSaldosColorantes[intContador].strCodIte, strEmpLot)) Then
    Begin
      stlBasesColorantes.Add(matrizSaldosColorantes[intContador].strCodIte);
      Result := False;
    End;
  End;

  If fEmptyStr(strCodEmb) And Assigned(fTipoTinta) And (fTipoTinta(strIdePro) In [ttImobiliaria, ttIndustrial]) Then
  Begin
    strCodEmb := strCodIte;
  End;

  If Not fEmptyStr(strCodEmb) And
     Not objCadLot.fExisteLotePrincipalTintaMaquina(strCodEmb, strEmpLot) And
     (stlBasesColorantes.IndexOf(strCodEmb) = -1) Then
  Begin
    stlBasesColorantes.Add(strCodEmb);
  End;
end;

function TFatVenda.fCalcDescEspecialItemConfPed(fltQtdOri, fltQtdBai, fltQtdIte, fltDesEsp, fltDesBai: Double): Double;
begin
  If (fltQtdBai + fltQtdIte) >= fltQtdOri Then
  Begin
    Result := (fltDesEsp - fltDesBai);
  End
  Else
  Begin
    Result := (fltDesEsp / fltQtdOri * fltQtdIte);
  End;

  If (Result < 0) Then
  Begin
    Result := 0;
  End;
end;

