function fFaturamentoDentroDaDataDaRota(strNumero, strEspecie, strEmpresa: String;
  var strVendedor, strDigitador, strCodCli: String; var fltTotPro: Double; var strCodReg: String;
  var horHorMax, horHorCar: TTime; var dtaDtaEnt: TDateTime): Boolean;

  function fRetSQL: String;
  Begin
    Result := '';
    Result := Result + ' SELECT ENT_DTAENT, ';
    Result := Result + '        ENT_CODREG, ';
    Result := Result + '        ROT_HORCAR, ';
    Result := Result + '        ROT_HOREMI, ';
    Result := Result + '        FGO_CODVEN, ';
    Result := Result + '        FGO_CODDIG, ';
    Result := Result + '        FGO_CODCLI, ';
    Result := Result + '        FGO_TOTPRO  ';
    Result := Result + '  FROM EXTGOR       ';
    Result := Result + '  INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FGO_SEQFGO ';
    Result := Result + '  INNER JOIN ENTREG ON ENT_CODIGO = FGO_CODROT        ';
    Result := Result + '  INNER JOIN ROTREG ON ROT_CODREG = ENT_CODREG        ';
    Result := Result + '  WHERE FGO_NUMDOC = :NUMDOC ';
    Result := Result + '    AND FGO_ESPDOC = :ESPDOC ';
    Result := Result + '    AND FGO_CODEMP = :CODEMP ';
  End;

var
  qryCons: TUniQuery;
begin
  Result := True;
  Try
    qryCons := fCriaQuery(Nil);
    With qryCons Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fRetSQL);
      ParamByName('NUMDOC').AsString := strNumero;
      ParamByName('ESPDOC').AsString := strEspecie;
      ParamByName('CODEMP').AsString := strEmpresa;
      Open;

      If Not IsEmpty Then
      Begin
        If VS_Date < FieldByName('ENT_DTAENT').AsDateTime Then
        Begin
          strVendedor  := FieldByName('FGO_CODVEN').AsString;
          strDigitador := FieldByName('FGO_CODDIG').AsString;
          strCodCli    := FieldByName('FGO_CODCLI').AsString;
          fltTotPro    := FieldByName('FGO_TOTPRO').AsFloat;
          strCodReg    := FieldByName('ENT_CODREG').AsString;
          horHorMax    := FieldByName('ROT_HOREMI').AsDateTime;
          horHorCar    := FieldByName('ROT_HORCAR').AsDateTime;
          dtaDtaEnt    := FieldByName('ENT_DTAENT').AsDateTime;

          Result := False;
        End;
      End;
    End
  Finally
    FreeAndNil(qryCons);
  End;
end;

