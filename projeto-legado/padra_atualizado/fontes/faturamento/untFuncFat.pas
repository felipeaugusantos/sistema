function TFatVenda.GetNumDocRerenciado: String;
  Var
    qryCupom : TUniQuery;
begin
  If not fEmptyStr(strChaveNFeRefDevolucao) Then
    Result := fCampoTabela('CONCAT(FIS_NUMDOC, "-", FIS_ESPDOC, "-", FIS_CODEMP)', 'CADFIS', ['FIS_ACESSO'], [strChaveNFeRefDevolucao])
  Else
  If (not fEmptyStr(strNumCOONFeRefDevolucao)) And (not fEmptyStr(strNumSerNFeRefDevolucao)) And (not fEmptyStr(strNumUSUNFeRefDevolucao)) Then
  Begin
    qryCupom := fCriaQuery;
    With qryCupom, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT GER_NUMDOC,                             ');
      Add('        GER_ESPDOC,                             ');
      Add('        GER_CODEMP                              ');
      Add(' FROM MOVGER                                    ');
      Add('   INNER JOIN AUXMOV ON AUX_SEQGER = AUTOINCREM ');
      Add(' WHERE AUX_NUMCOO = :NUMCOO                     ');
      Add('   AND AUX_NUMSER = :NUMSER                     ');
      Add('   AND AUX_NUMUSU = :NUMUSU                     ');

      ParamByName('NUMCOO').AsString := strNumCOONFeRefDevolucao;
      ParamByName('NUMSER').AsString := strNumSerNFeRefDevolucao;
      ParamByName('NUMUSU').AsString := strNumUSUNFeRefDevolucao;

      Open;
      Result := FieldByName('GER_NUMDOC').AsString + '-' + FieldByName('GER_ESPDOC').AsString + '-' + FieldByName('GER_CODEMP').AsString;
      Close;
    End;
    FreeAndNil(qryCupom);
  End;

end;

function TFatVenda.getPercentualDeDescontoTotal: Double;
  Var
    intIndex : Integer;
    fltTotOri: Double;
    fltTotPra: Double;
    fltDescon: Double;
begin
  fltTotOri := 0.00;
  fltTotPra := 0.00;

  For intIndex := Low(arrMatItens) to High(arrMatItens) Do
  Begin
    fltTotOri := fltTotOri + ( arrMatItens[intIndex].fltUniOri * arrMatItens[intIndex].fltQtdIte );
    fltTotPra := fltTotPra + ( arrMatItens[intIndex].fltTotIte - arrMatItens[intIndex].fltDesEsp );
  End;

  If (fltTotPra > fltTotOri) Then
    Result := 0.00
  Else
  Begin
    fltDescon := fltTotOri - fltTotPra;
    Result := (fltDescon / fltTotOri) * 100;
  End;

end;

