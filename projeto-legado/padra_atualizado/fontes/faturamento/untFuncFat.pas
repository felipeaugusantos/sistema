function TFatVenda.fAlterouItensPedido(const blnVerificarTotalItem: Boolean): Boolean;
  Var
    qryFatDor: TUniQuery;
begin
  Result := False;
  qryFatDor := fCriaQuery;

  Try
    pCarregaItensOriginais(qryFatDor);

    If (qryFatDor.IsEmpty) Then
      Exit;

    If (Not fDivergenciaNosItens(qryFatDor,
              blnVerificarTotalItem)) Then
      Exit;

    Result := True;
  Finally
