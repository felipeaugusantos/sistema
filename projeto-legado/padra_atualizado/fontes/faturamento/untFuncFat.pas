function TFatVenda.fInformarDrawbackPorItem(blnMostraTelaDraw: Boolean=False): Boolean;
var
  frmVinculacaoNotaCompra: TfrmVinculacaoNotaCompra;
  intIdx: Integer;
  prcScroll: TprcScroll;
begin
  Result := True;

  if (Self.strCliEst = 'EX') Or (blnMostraTelaDraw) then
  begin
    pCriarFormularios(TfrmVinculacaoNotaCompra, frmVinculacaoNotaCompra);
    pDisableControls(cdsVenda, prcScroll);
    try
      frmVinculacaoNotaCompra.objVenda := Self;
      frmVinculacaoNotaCompra.cdsProdutos.DisableControls;
      for intIdx := 0 to Length(Self.arrMatItens) - 1 do
      begin
        frmVinculacaoNotaCompra.cdsProdutos.Append;
        frmVinculacaoNotaCompra.cdsProdutosINDICE.AsInteger := intIdx;
        frmVinculacaoNotaCompra.cdsProdutosCODITE.AsString  := Self.arrMatItens[intIdx].strCodIte;
        frmVinculacaoNotaCompra.cdsProdutosDESITE.AsString  := Self.arrMatItens[intIdx].strDesIte;
        frmVinculacaoNotaCompra.cdsProdutosCODUNI.AsString  := Self.arrMatItens[intIdx].strCodUni;
        frmVinculacaoNotaCompra.cdsProdutosQTDITE.AsFloat   := Self.arrMatItens[intIdx].fltQtdIte;
        frmVinculacaoNotaCompra.cdsProdutosVLRUNI.AsFloat   := Self.arrMatItens[intIdx].fltUniTar;
        frmVinculacaoNotaCompra.cdsProdutosVLRTOT.AsFloat   := Self.arrMatItens[intIdx].fltTotIte;
        frmVinculacaoNotaCompra.cdsProdutosNUMDRW.AsString  := IIF((not fEmptyStr(Self.arrMatItens[intIdx].strNumDrw)),
          Self.arrMatItens[intIdx].strNumDrw, Self.strNumeroDrawback);

        if (not fEmptyStr(frmVinculacaoNotaCompra.cdsProdutosNUMDRW.AsString)) then
          frmVinculacaoNotaCompra.cdsProdutosCLAFIS.AsString := CLAFIS_DRAWBACK
        else
          frmVinculacaoNotaCompra.cdsProdutosCLAFIS.AsString := Self.arrMatItens[intIdx].strClaFis;
        frmVinculacaoNotaCompra.cdsProdutosAUTINC.AsInteger  := Self.arrMatItens[intIdx].intAutInc;
        frmVinculacaoNotaCompra.cdsProdutos.Post;
      end;
      frmVinculacaoNotaCompra.cdsProdutos.First;
      frmVinculacaoNotaCompra.cdsProdutos.EnableControls;

      Result := frmVinculacaoNotaCompra.ShowModal = mrOK;

      if Result then
      begin
        frmVinculacaoNotaCompra.cdsProdutos.DisableControls;
        frmVinculacaoNotaCompra.cdsProdutos.First;
        while not frmVinculacaoNotaCompra.cdsProdutos.Eof do
        begin
          intIdx := frmVinculacaoNotaCompra.cdsProdutosINDICE.AsInteger;

          Self.arrMatItens[intIdx].strChaveAcesso := frmVinculacaoNotaCompra.cdsProdutosCHACES.AsString;
          Self.arrMatItens[intIdx].fltQtItCo := frmVinculacaoNotaCompra.cdsProdutosQTDITE.AsFloat;
          Self.arrMatItens[intIdx].strClaFis := frmVinculacaoNotaCompra.cdsProdutosCLAFIS.AsString;
          Self.arrMatItens[intIdx].strCodFis := '041';
          Self.arrMatItens[intIdx].fltBasIpi := 0.0;
          Self.arrMatItens[intIdx].fltValIpi := 0.0;
          Self.arrMatItens[intIdx].fltAlqIcm := 0.0;
          Self.arrMatItens[intIdx].fltBasIcm := 0.0;
          Self.arrMatItens[intIdx].fltValIcm := 0.0;
          Self.arrMatItens[intIdx].fltBasRet := 0.0;
          Self.arrMatItens[intIdx].fltValRet := 0.0;
          Self.arrMatItens[intIdx].strNumDrw := frmVinculacaoNotaCompra.cdsProdutosNUMDRW.AsString;

          If cdsVenda.Locate('AUTOINCREM', Self.arrMatItens[intIdx].intAutInc, []) Then
          Begin
            cdsVenda.Edit;
            cdsVenda.FieldByName('ITE_NUMDRW').AsString := Self.arrMatItens[intIdx].strNumDrw;
            cdsVenda.Post;
          End;

          frmVinculacaoNotaCompra.cdsProdutos.Next;
        end;
      end;
    finally
      pEnableControls(cdsVenda, prcScroll);
      pFreeAndNil(frmVinculacaoNotaCompra);
    end;
  end;
end;

