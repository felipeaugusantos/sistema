function TFatVenda.fChamaRequisicaoCompraPeloVendaNormal: Boolean;
begin
  Result := False;

  If Not (fCfgSis('FALVEN', varBoolean)) Then
    Exit;

  If Not (Self.fEhFaltaDeProduto) Then
    Exit;

  If (Self.strOpcDoc <> 'VN') Then
    Exit;

  If (Pos(Self.strEspDoc, 'NF_FF_IF_') <= 0) Then
    Exit;

  If fExisteRequisicaoDeCompraParaPedidoDeVenda(Self.strNumOrc, Self.strEmpOri, Self.strEspOrc) Then
    Exit;

  Result := True;
end;

function TFatVenda.fApenasRegistrarQuantidadeRequisicao: Boolean;
begin
  Result := (Not fChamaRequisicaoCompraPeloVendaNormal);

  If Result Then
  Begin
    If (fUsaRotinaExpedicaoConferenciaRetiraCaixa And fTemItensNaoLiberadosParaExibirBaixaSeparacao) Then
      Exit;

    If fGravarQuantidadeComprarNaEmissaoPedido Then
      Exit;

    Result := False;
  End;
end;

function TFatVenda.fGravarQuantidadeComprarNaEmissaoPedido: Boolean;
begin
  Result := False;

  If (Not fCfgSis('FALPRO', varBoolean)) And ((strOpcDoc = 'PD') or (strEspDoc = 'PD')) Then
    Exit;

  If (Not fCfgSis('FALVEN', varBoolean)) And (strOpcDoc = 'VN') Then
    Exit;

  If fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
    Exit;

  If Not blnMulLoj Then
    Exit;

  If blnFinali Then
    Exit;

  If (strOriF11 = 'S') Then
    Exit;

  If Not Assigned(cdsMovRcd) Then
    Exit;

  If Not cdsMovRcd.Active Then
    Exit;

  If cdsMovRcd.IsEmpty Then
    Exit;

  Result := True;
end;

function TFatVenda.fAplicaFreteComoAcrescimoNFCe: Boolean;
begin
  if fGeraNovoPedidoEntregaCD(strOriF11, strEmpOri) or
     fGeraNovoPedidoEntregaImediata(strOriF11, strEmpOri) or
     fGeraNovoPedidoRetiraOutraLoja(strOriF11, strEmpOri) or
     fGeraNovoPedidoRetiraExpedicao(strOriF11, strEmpOri) then
    Exit(False);

  Result := (Self.strEspDoc = 'IF') And (fCfgSis('USNFCE', varBoolean)) And
            (
              ((Not Self.fValidaCPFConsumidor) And (fCfgSis('FRENFC', varBoolean))) Or
              ((Self.fValidaCPFConsumidor) And (fCfgSis('FR2NFC', varBoolean)))
            );
end;

procedure TFatVenda.pAplicarFreteComoAcrescimoNFCe;
begin
  If fAplicaFreteComoAcrescimoNFCe Then
  Begin
    Self.fltValFreAntesAcrescimoNFCe := Self.fltValFre;
    Self.fltDesAceAntesAcrescimoNFCe := Self.fltDesAce;

    Self.fltDesAce := Self.fltDesAce + Self.fltValFre;
    Self.fltValFre := 0.00;
  End;
end;

