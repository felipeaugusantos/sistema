  function fRetQtdIteSubItens(AItemPai : TDadosFechamento) : Integer;
  var
    LItemEst  : TItensEstrutura;
    LSubItem  : TSubItemEstrutura;
    LEmpresa  : String;
    LidxItem  : Integer;
  begin

    Result   := 0;

    If AItemPai.fltQtdSol <= 0 Then
      Exit;

    LItemEst := TItensEstrutura.Create;

    Try

      LEmpresa := IIF(AItemPai.strEmpIte.IsEmpty, VS_strCodEmp, AItemPai.strEmpIte);
      LItemEst.pCarregarEstrutura(AItemPai.strCodIte, AItemPai.fltQtdSol, LEmpresa);

      If (LItemEst.ItemsCount <= 0) Then
        Exit;

      For LidxItem := 0 To LItemEst.ItemsCount -1 Do
      Begin
        LSubItem := LItemEst[LidxItem];
        Result   := Result + Floor(LSubItem.fltQtdTot);
      End;

    Finally
      If Assigned(LItemEst) Then
        FreeAndNil(LItemEst);
    End;

  End;

  function fRetTotCusSubItens(AItemPai : TDadosFechamento) : Double;
  var
    LItemEst  : TItensEstrutura;
    LSubItem  : TSubItemEstrutura;
    LEmpresa  : String;
    LidxItem  : Integer;
    LPreSug   : Double;
    LCamSug   : String;
  begin

    Result   := 0;

    If AItemPai.fltQtdSol <= 0 Then
      Exit;

    LItemEst := TItensEstrutura.Create;

    Try

      LEmpresa := IIF(AItemPai.strEmpIte.IsEmpty, VS_strCodEmp, AItemPai.strEmpIte);
      LItemEst.pCarregarEstrutura(AItemPai.strCodIte, AItemPai.fltQtdSol, LEmpresa);

      If (LItemEst.ItemsCount <= 0) Then
        Exit;

      LCamSug := fGetTEPREV(strCodEmpLj, strCodCliLj);

      For LidxItem := 0 To LItemEst.ItemsCount -1 Do
      Begin
        LSubItem := LItemEst[LidxItem];
        LPreSug  := fRetPrecoSugestaoTransferencia(LSubItem.strCodigo, strCodEmpLj, LCamSug);
        Result   := Result + (AItemPai.fltQtdSol * LPreSug);
      End;

    Finally

      If Assigned(LItemEst) Then
        FreeAndNil(LItemEst);

    End;

  End;

  function fMontarSubItens(const AItemPai : TDadosFechamento; out AArrSubItens : TMatrizFechamento) : Boolean;
  var
    LItemEst  : TItensEstrutura;
    LSubItem  : TSubItemEstrutura;
    LEmpresa  : String;
    LidxItem  : Integer;
    LItem     : TDadosFechamento;
    LQryItem  : TUniQuery;
    LCamSug   : String;
    LPreSug   : Double;
  begin

    Result   := False;
    SetLength(AArrSubItens, 0);
    LItemEst := TItensEstrutura.Create;

    LQryItem := fCriaQuery;
    LQryItem.SQL.Add(fRetSQLItem);

    Try

      LEmpresa := IIF(AItemPai.strEmpIte.IsEmpty, VS_strCodEmp, AItemPai.strEmpIte);
      LItemEst.pCarregarEstrutura(AItemPai.strCodIte, AItemPai.fltQtdIte, LEmpresa);

      If (LItemEst.ItemsCount <= 0) Then
        Exit;

      objSoliTE.blnCarregandoSubItensDaEstrutura := True;

      LCamSug := fGetTEPREV(strCodEmpLj, strCodCliLj);

      For LidxItem := 0 To LItemEst.ItemsCount -1 Do
      Begin

        LSubItem := LItemEst[LidxItem];

        FillChar(LItem, SizeOf(LItem), #0);

        LItem.strAutoincrementoGravacao := fRetAutoIncrem('FATDOR', LEmpresa);

        LItem.strCodIte := LSubItem.strCodigo;
        LItem.strDesIte := fRetNomProduto(LItem.strCodIte);
        LItem.fltQtdIte := AItemPai.fltQtdSol;

        LPreSug  := fRetPrecoSugestaoTransferencia(LSubItem.strCodigo, strCodEmpLj, LCamSug);

        LItem.fltPreCus := LPreSug;
        LItem.fltTotCus := LItem.fltPreCus * LItem.fltQtdIte;
        LItem.fltOutVal := fRetOutVal(LSubItem.fltOutVal);
        LItem.fltICMSai := fRetIcmSai(LSubItem.fltIcmSai);
        LItem.fltDesOpe := fRetDesOpe(LSubItem.fltDesOpe);
        LItem.fltImpFed := fRetImpfed(LSubItem.fltImpFed);
        LItem.fltImpUlt := LSubItem.fltImpUlt;
        LItem.fltPreUlt := LSubItem.fltPreUlt;

        LQryItem.Close;
        LQryItem.ParamByName('CODEMP').AsString := LEmpresa;
        LQryItem.ParamByName('CODITE').AsString := LItem.strCodIte;
        LQryItem.Open;

        If LQryItem.IsEmpty Then
          Continue;

        LItem.strIdePro := 'NOR';
        LItem.strCodGru := LQryItem.FieldByName('ITE_CODGRU').AsString;
        LItem.strDesFab := LQryItem.FieldByName('ITE_DESFAB').AsString;
        LItem.strCodMar := LQryItem.FieldByName('ITE_CODMAR').AsString;
        LItem.strCodFor := LQryItem.FieldByName('ITE_CODFOR').AsString;
        LItem.strEntSai := 'S';
        LItem.strComLub := LQryItem.FieldByName('ITE_COMLUB').AsString;
        LItem.fltIpiSai := LQryItem.FieldByName('ITE_IPISAI').AsFloat;
        LItem.fltDesCnd := LQryItem.FieldByName('ITE_DESMAX').AsFloat;
        LItem.fltPreVe1 := LQryItem.FieldByName('ITE_PREVE1').AsFloat;
        LItem.fltPreVe2 := LQryItem.FieldByName('ITE_PREVE2').AsFloat;
        LItem.fltPreVe3 := LQryItem.FieldByName('ITE_PREVE3').AsFloat;
        LItem.fltPreVe4 := LQryItem.FieldByName('ITE_PREVE4').AsFloat;
        LItem.fltPreVe5 := LQryItem.FieldByName('ITE_PREVE5').AsFloat;
        LItem.fltPreVe6 := LQryItem.FieldByName('ITE_PREVE6').AsFloat;
        LItem.fltPreVe7 := LQryItem.FieldByName('ITE_PREVE7').AsFloat;
        LItem.fltSaldos := LQryItem.FieldByName('ITE_SALDOS').AsFloat;
        LItem.strIncPis := LQryItem.FieldByName('ITE_INCPIS').AsString;
        LItem.fltComInt := LQryItem.FieldByName('ITE_COMVAR').AsFloat;
        LItem.fltComExt := LQryItem.FieldByName('ITE_COMATA').AsFloat;
        LItem.fltComDis := LQryItem.FieldByName('ITE_COMDIS').AsFloat;
        LItem.fltTotUlt := LQryItem.FieldByName('ITE_PREULT').AsFloat * LItem.fltQtdIte;
        LItem.strClaIpi := LQryItem.FieldByName('ITE_CLAIPI').AsString;
        LItem.strCodAbf := LQryItem.FieldByName('ITE_CODABF').AsString;
        LItem.fltPesoIt := LQryItem.FieldByName('ITE_PESOIT').AsFloat;
        LItem.fltPesLiq := LQryItem.FieldByName('ITE_PESLIQ').AsFloat;
        LItem.strPromoc := 'N';
        LItem.strCodFab := LQryItem.FieldByName('ITE_CODFAB').AsString;
        LItem.strCodUni := LQryItem.FieldByName('ITE_CODUNI').AsString;
        LItem.strSigUni := fRetSiglaUnidade(LQryItem.FieldByName('ITE_CODUNI').AsString);
        LItem.strTabPre := AItemPai.strTabPre;
        LItem.fltComTbl := LQryItem.FieldByName('ITE_COMTB' + AItemPai.strTabPre).AsFloat;
        LItem.fltIpiEnt := LQryItem.FieldByName('ITE_IPIENT').AsFloat;
        LItem.fltFreEnt := LQryItem.FieldByName('ITE_FREENT').AsFloat;
        LItem.strImpDir := LQryItem.FieldByName('ITE_IMPDIR').AsString;
        LItem.strBxSbIt := 'N';
        LItem.strClaFis := AItemPai.strClaFis;
        LItem.fltTaxJur := 0;
        LItem.fltDesCon := 0;
        LItem.fltDesEsp := 0;

        LItem.fltPreMed := 0;
        LItem.fltTotMed := 0;

        LItem.fltBasIcm := 0;
        LItem.fltValIcm := 0;

        LItem.fltBasRet := 0;
        LItem.fltValRet := 0;

        LItem.fltBasIpi := 0;
        LItem.fltValIpi := 0;

        LItem.fltTotIte := fFormataFloat(LItem.fltTotCus, 2);
        LItem.fltUniTar := fFormataFloat(LItem.fltPreCus, 2);
        LItem.fltUniOri := fFormataFloat(LItem.fltPreCus, 2);
        LItem.fltUniVis := fFormataFloat(LItem.fltPreCus, 2);
        LItem.fltUniDig := fFormataFloat(LItem.fltPreCus, 2);

        If (fCfgSis('EMPABS', varBoolean)) And (Not blnEmpFat) Then
          LItem.strEmpIte := strEmpFor;

        SetLength(AArrSubItens, Length(AArrSubItens) + 1);
        AArrSubItens[High(AArrSubItens)] := LItem;

      End;

      Result := True;

    Finally

      If Assigned(LQryItem) Then
        FreeAndNil(LQryItem);

      If Assigned(LItemEst) Then
        FreeAndNil(LItemEst);

    End;

  End;

  function fGravarSubItens(const AItemPai : TDadosFechamento) : Boolean;
  var
    LArrSubItens : TMatrizFechamento;
    LidxItem     : Integer;
    LItem        : TDadosFechamento;
  begin
    Result := False;

    If Not LDicSubItens.TryGetValue(AItemPai.intAutInc, LArrSubItens) Then
      Exit;

    For LidxItem := Low(LArrSubItens) To High(LArrSubItens) Do
    Begin
      LItem := LArrSubItens[LidxItem];
      LItem.fltVlrCon := fRetValorContabilItem(LItem);

      Result := fGravaFatDorItem(LItem,
                                 strCodEmpLj,
                                 strCodCliLj,
                                 'PD',
                                 strNumDocLj,
                                 blnEntFut,
                                 strEmpFor,
                                 True);
    End;
  end;

  procedure pPrepararItemTransferenciaLoja(var AItem: TDadosFechamento);
  var
    LFatorQtd: Double;
  begin
    LFatorQtd := AItem.fltQtdSol / AItem.fltQtdIte;

    AItem.fltTotCus := fFormataFloat(AItem.fltTotCus * LFatorQtd, 2);
    AItem.fltTotMed := fFormataFloat(AItem.fltTotMed * LFatorQtd, 2);

    AItem.fltBasIcm := fFormataFloat(AItem.fltBasIcm * LFatorQtd, 2);
    AItem.fltValIcm := fFormataFloat(AItem.fltValIcm * LFatorQtd, 2);

    AItem.fltBasRet := fFormataFloat(AItem.fltBasRet * LFatorQtd, 2);
    AItem.fltValRet := fFormataFloat(AItem.fltValRet * LFatorQtd, 2);

    AItem.fltBasIpi := fFormataFloat(AItem.fltBasIpi * LFatorQtd, 2);
    AItem.fltValIpi := fFormataFloat(AItem.fltValIpi * LFatorQtd, 2);

    AItem.fltQtdIte := AItem.fltQtdSol;
    AItem.fltTotIte := fFormataFloat(AItem.fltTotCus, 2);
    AItem.fltUniTar := fFormataFloat(AItem.fltTotCus, 2) / AItem.fltQtdIte;
    AItem.fltUniOri := AItem.fltUniTar;
    AItem.fltUniVis := AItem.fltUniTar;
    AItem.fltTaxJur := 0;
    AItem.fltUniDig := AItem.fltUniTar;
    AItem.fltDesCon := 0;
    AItem.fltDesEsp := 0;

    If (fCfgSis('EMPABS', varBoolean)) And (Not blnEmpFat) Then
      AItem.strEmpIte := strEmpFor;

    pCalcularPisCofinsItemDerivado(AItem, strCodEmpLj, strCodCliLj, 'C', True, False);
  end;

begin
  SetLength(arrMatItensBkp, 0);
  SetLength(arrMatItensBkp, Length(arrMatItens));

  For intContIte := Low(arrMatItens) To High(arrMatItens) Do
    arrMatItensBkp[intContIte] := arrMatItens[intContIte];

  LDicSubItens := TDictionary<Integer, TMatrizFechamento>.Create;
  Try
    pPreencheMatrizComColorantesParaTransferencia;

    strCodEmpLj := IIF(blnFinali, strPedEmp, IIF(Not fOrcamentoOutraLojaF11, strPedEmp, IIF(fEmptyStr(strEmpOri), strPedEmp, IIF((strEspDoc <> strEspOrc), strPedEmp, strEmpOri))));

    If fEmptyStr(strCodEmpLj) Then
      strCodEmpLj := VS_strCodEmp;

    strEmp_TEAux := Self.strEmp_TE;
    If Assigned(Self.objSoliTE) Then
    Begin
      If (objSoliTE.blnReq) And (strEmpFor <> strCodEmpLj) Then
       Self.strEmp_TE := strEmpFor;
    End;

    FstrCodCndPedidoTransf := '';
    FstrConPagPedidoTransf := '';
    FstrCodFpgPedidoTransf := '';
    If (fCfgSis('CNPDAB', varBoolean)) Then
    Begin
      FstrCodFpgPedidoTransf := fCfgSis('FPORPD',varString);
      If (fCfgSis('USACND', varBoolean)) Then
      Begin
        FstrCodCndPedidoTransf := fCfgSis('CCONPG',varString);
        FstrConPagPedidoTransf := fCampoTabela('CND_CNDPAG', 'CADCND', ['CND_CODIGO'], [FstrCodCndPedidoTransf]);
      End
      Else
      Begin
        FstrConPagPedidoTransf := fCfgSis('CNDORP',varString);
      End;
    End;

    qryCliFil := fCriaQuery(Nil);
    recServicosAux := Self.FRecSer;
    FillChar(Self.FRecSer, SizeOf(Self.FRecSer), #0);
    Try
      blnEntFut := False;

      SetLength(arrDuplicatasBkp, Length(arrDuplicata));
      For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
      Begin
        arrDuplicatasBkp[intContador] := arrDuplicata[intContador];
      End;

      fltDesEspLj := 0;
      fltTotProLj := 0;
      fltTotCusLj := 0;
      fltTotMedLj := 0;
      fltPesBruLj := 0;
      fltPesLiqLj := 0;

      fltBasIcmLj := 0;
      fltValIcmLj := 0;
      fltBasRetLj := 0;
      fltValRetLj := 0;
      fltBasIpiLj := 0;
      fltValIpiLj := 0;
      fltTotCbsLj := 0;
      fltTotIbsLj := 0;
      fltTotIsLj  := 0;
      fltTotGerLj := 0;

      Try

        strCodCliLj := fCadEmpDes('CLIFIL', strCodEmpLj);
        strNumDocLj := fRetSequencialPedido(strCodEmpLj);

        stlRequisocoesPD.Add(strNumDocLj);

        qryCliFil.SQL.Add('SELECT * FROM CADCLI JOIN CADCID ON CID_CODCID = CLI_CODCID WHERE CLI_CODCLI = :CODCLI');
        qryCliFil.ParamByName('CODCLI').AsString := strCodCliLj;
        qryCliFil.Open;

        If (Pos(strEspDoc, 'NF_IF_IV_D1_') > 0) Or (fCfgSis('SLTFRC', varBoolean)) Then
          strTipPedLj := 'A'
        Else
          strTipPedLj := 'B';

        blnTemItemEstruturaBaixandoEstoqueDosSubProdutos := fTemItemEstruturaBaixandoEstoqueDosSubProdutos;

        If blnTemItemEstruturaBaixandoEstoqueDosSubProdutos Then
          intQtdTra := 0;

        For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
        Begin
          If (arrMatItens[intIndIte].strEmpSol = strEmpFor) And
             (arrMatItens[intIndIte].blnPodAlt) And
             (arrMatItens[intIndIte].fltQtdSol > 0) Then
          Begin
            If (Not blnGravandoColorante) Or ((blnGravandoColorante) And (arrMatItens[intIndIte].strIdePro = 'NOR')) Then
            Begin

              fltDesEspLj := fltDesEspLj + 0;

              If fEhItemEstruturaBaixandoEstoqueDosSubProdutos(arrMatItens[intIndIte]) Then
              Begin

                If fMontarSubItens(arrMatItens[intIndIte], LArrSubItensItem) Then
                  LDicSubItens.AddOrSetValue(arrMatItens[intIndIte].intAutInc, LArrSubItensItem);

                fltTotProLj := fltTotProLj + fFormataFloat(fRetTotCusSubItens(arrMatItens[intIndIte]), 2);
                fltTotCusLj := fltTotCusLj + fFormataFloat(fRetTotCusSubItens(arrMatItens[intIndIte]), 2);
                intQtdTra   := intQtdTra   + fRetQtdIteSubItens(arrMatItens[intIndIte]);

                fltTotMedLj := 0;
                fltBasIcmLj := 0;
                fltValIcmLj := 0;
                fltBasRetLj := 0;
                fltValRetLj := 0;
                fltBasIpiLj := 0;
                fltValIpiLj := 0;

              End
              Else
              Begin

                fltFatorQtd := arrMatItens[intIndIte].fltQtdSol / arrMatItens[intIndIte].fltQtdIte;

                fltTotProLj := fltTotProLj + fFormataFloat(arrMatItens[intIndIte].fltTotCus * fltFatorQtd, 2);
                fltTotCusLj := fltTotCusLj + fFormataFloat(arrMatItens[intIndIte].fltTotCus * fltFatorQtd, 2);

                If blnTemItemEstruturaBaixandoEstoqueDosSubProdutos Then
                  intQtdTra := intQtdTra + Floor(fGetVolumeCalculadoItem(arrMatItens[intIndIte].strCodIte));

                fltTotMedLj := fltTotMedLj + fFormataFloat(arrMatItens[intIndIte].fltTotMed * fltFatorQtd, 2);

                fltBasIcmLj := fltBasIcmLj + fFormataFloat(arrMatItens[intIndIte].fltBasIcm * fltFatorQtd, 2);
                fltValIcmLj := fltValIcmLj + fFormataFloat(arrMatItens[intIndIte].fltValIcm * fltFatorQtd, 2);

                fltBasRetLj := fltBasRetLj + fFormataFloat(arrMatItens[intIndIte].fltBasRet * fltFatorQtd, 2);
                fltValRetLj := fltValRetLj + fFormataFloat(arrMatItens[intIndIte].fltValRet * fltFatorQtd, 2);

                fltBasIpiLj := fltBasIpiLj + fFormataFloat(arrMatItens[intIndIte].fltBasIpi * fltFatorQtd, 2);
                fltValIpiLj := fltValIpiLj + fFormataFloat(arrMatItens[intIndIte].fltValIpi * fltFatorQtd, 2);

                SetLength(LArrItensPD, Length(LArrItensPD) + 1);
                LArrItensPD[High(LArrItensPD)] := arrMatItens[intIndIte];
                pPrepararItemTransferenciaLoja(LArrItensPD[High(LArrItensPD)]);

              End;

              fltTotGerLj := fltTotProLj + fltValRetLj + fltValIpiLj + fltValFre + fltDesAce;

              fltPesBruLj := fltPesBruLj + fFormataFloat(arrMatItens[intIndIte].fltQtdSol *
                                                         arrMatItens[intIndIte].fltPesoIt, 3);

              fltPesLiqLj := fltPesLiqLj + fFormataFloat(arrMatItens[intIndIte].fltQtdSol *
                                                         arrMatItens[intIndIte].fltPesLiq, 3);
            End;
          End;

          If fCfgSis('PESLIQ') = 'FATOR' Then
            fltPesLiqLj := fFormataFloat(fltPesBruLj * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);
        End;

        SetLength(LArrCalculo, 0);
        For intPosicao := Low(LArrItensPD) To High(LArrItensPD) Do
        Begin
          SetLength(LArrCalculo, Length(LArrCalculo) + 1);
          LArrCalculo[High(LArrCalculo)] := LArrItensPD[intPosicao];
        End;
        For intChave In LDicSubItens.Keys Do
        Begin
          LArrSubItensItem := LDicSubItens[intChave];
          For intPosicao := Low(LArrSubItensItem) To High(LArrSubItensItem) Do
          Begin
            SetLength(LArrCalculo, Length(LArrCalculo) + 1);
            LArrCalculo[High(LArrCalculo)] := LArrSubItensItem[intPosicao];
          End;
        End;

        pCalcularImpostosReformaTributariaItens(LArrCalculo,
                                                'PD',
                                                strTipPedLj,
                                                strCodCliLj,
                                                '',
                                                False,
                                                fltTotCbsLj,
                                                fltTotIbsLj,
                                                fltTotIsLj,
                                                fltBasCbsLj,
                                                fltBasIbsLj,
                                                fltBasIsLj);

        // Devolve o calculo na mesma ordem em que foi montado
        intContador := 0;
        For intPosicao := Low(LArrItensPD) To High(LArrItensPD) Do
        Begin
          LArrItensPD[intPosicao] := LArrCalculo[intContador];
          Inc(intContador);
        End;
        For intChave In LDicSubItens.Keys Do
        Begin
          LArrSubItensItem := LDicSubItens[intChave];
          For intPosicao := Low(LArrSubItensItem) To High(LArrSubItensItem) Do
          Begin
            LArrSubItensItem[intPosicao] := LArrCalculo[intContador];
            Inc(intContador);
          End;
        End;

        fltTotGerLj := fltTotGerLj + fltTotCbsLj + fltTotIbsLj + fltTotIsLj;

        fDigDuplic(arrDuplicata, strConPag, 0, fltTotGerLj, False, False, False, Self.VS_Date, False);

        If (VS_strHabilitarCRM) And (Not Assigned(objOcoCrm)) And (Not fEmptyStr(fCfgSis('VENORC', varString))) And (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
        Begin
          If blnGravandoPedidoCorteFaltaEstoque Then
            objOcoCrm := fAtualizaInformacoesCRM(strNumDocLj,
                                                 'PD',
                                                 VS_strCodEmp,
                                                 strCodCliLj,
                                                 '','',
                                                 strCodVen,
                                                 afcPedidoCorte,
                                                 '',
                                                 strCliCgc)
          Else
            objOcoCrm := fAtualizaInformacoesCRM(strNumDocLj,
                                                 'PD',
                                                 strCodEmpLj,
                                                 strCodCliLj,
                                                 '','',
                                                 strCodVen,
                                                 afcPedido,
                                                 '',
                                                 strCliCgc);

          objOcoCrm.strInfAdc := fGetModificacoesItensPedido(strNumDocLj, 'PD', VS_strCodEmp, arrMatItens);

          If fDeveGerarOcorrenciaCRMParaProspecto Then
          Begin
            objOcoCrm.strCodPro := strProspe;
            objOcoCrm.strTip_FC := 'P';
          End;
          objOcoCrm.strNomFrm := '[TFatVenda.fGFatGorLoja]';
        End;

        strMen001Local := 'Para Abastecimento do Documento de Venda: ' + strNumDoc + '-' + strEspDoc + '-' + strCodEmpLj;
        strMen002Local := 'Cliente: ' + strCodCli + '-' + strCliNom + ' / ' + 'Vendedor: ' + strCodVen + '-' +strNomVen;

        Result := fGFatGor(0,
                           fltDesEspLj,
                           fltTotGerLj,
                           fltTotProLj,
                           fltTotCusLj,
                           fltTotMedLj,
                           fltPesBruLj,
                           fltPesLiqLj,
                           fltBasIcmLj,
                           fltValIcmLj,
                           fltBasRetLj,
                           fltValRetLj,
                           fltBasIpiLj,
                           fltValIpiLj,
                           fltTotCbsLj,
                           fltTotIbsLj,
                           fltTotIsLj,
                           strTipPedLj,
                           strCodCliLj,
                           strCodEmpLj,
                           'PD',
                           strNumDocLj,
                           strEmpFor,
                           strEmpFor,
                           qryCliFil.FieldByName('CLI_NOMCLI').AsString,
                           qryCliFil.FieldByName('CLI_ENDERE').AsString,
                           qryCliFil.FieldByName('CLI_BAIRRO').AsString,
                           qryCliFil.FieldByName('CLI_C_E_P_').AsString,
                           qryCliFil.FieldByName('CLI_CODCID').AsString,
                           qryCliFil.FieldByName('CID_ESTADO').AsString,
                           qryCliFil.FieldByName('CLI_CODATI').AsString,
                           qryCliFil.FieldByName('CLI_FONE01').AsString,
                           qryCliFil.FieldByName('CLI_NASCIM').AsDateTime,
                           qryCliFil.FieldByName('CLI_CGCCPF').AsInteger,
                           qryCliFil.FieldByName('CLI_C_G_C_').AsString,
                           qryCliFil.FieldByName('CLI_I_E_S_').AsString,
                           qryCliFil.FieldByName('CLI_NUMR_G').AsString,
                           fltFatNot,
                           IfThen(Not fPermitirFreteNoFaturamento, '9', strTipFre),
                           fltValFre,
                           fltDesAce,
                           strMen001Local,
                           strMen002Local,
                           'N',
                           '',
                           strNumDoc,
                           strEspDoc,
                           strCodEmpLj,
                           True,
                           'N',
                           '',
                           '',
                           '',
                           '',
                           False,
                           False,
                           '',
                           AblnGerarPix);

        If Assigned(objOcoCrm) Then
          FreeAndNil(objOcoCrm);

        If Result Then
        Begin

          //Retorna o autoincremento dos itens para gravacao da tabela FATDOR
          For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
            If Not fEhItemEstruturaBaixandoEstoqueDosSubProdutos(arrMatItens[intIndIte]) Then
              arrMatItens[intIndIte].strAutoincrementoGravacao := fRetAutoIncrem('FATDOR', strCodEmpLj);

          Try
            objOrdenarItensParaGravacao := TOrdenarItensParaGravacao.Create;

            objOrdenarItensParaGravacao.pSalvarOrdemMatrizItens(arrMatItens);
            objOrdenarItensParaGravacao.pOrdenarItensPorCodigo(arrMatItens);

            //Atualiza a matriz de itens ja ordenada por codigo de produto
            For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
              arrMatItens[intIndIte] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intIndIte];

            For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
            Begin
              If (arrMatItens[intIndIte].strEmpSol = strEmpFor) And
                 (arrMatItens[intIndIte].blnPodAlt) And
                 (arrMatItens[intIndIte].fltQtdSol > 0) Then
              Begin
                If (Not blnGravandoColorante) Or ((blnGravandoColorante) And (arrMatItens[intIndIte].strIdePro = 'NOR')) Then
                Begin

                  If fEhItemEstruturaBaixandoEstoqueDosSubProdutos(arrMatItens[intIndIte]) Then
                    Result := fGravarSubItens(arrMatItens[intIndIte])
                  Else
                  Begin

                    item := arrMatItens[intIndIte];

                    pPrepararItemTransferenciaLoja(item);
                    pCopiarImpostosReformaTributaria(item, LArrItensPD);

                    item.fltVlrCon := fRetValorContabilItem(item);

                    Result := fGravaFatDorItem(item,
                                               strCodEmpLj,
                                               strCodCliLj,
                                               'PD',
                                               strNumDocLj,
                                               blnEntFut,
                                               strEmpFor,
                                               True);

                  End;

                  If (Not Result) Then
                    Break;

                End;
              End;
            End;
          Finally
            //Restaura a ordenacao original dos itens
            objOrdenarItensParaGravacao.pRestaurarOrdemMatrizItens(arrMatItens);

            //Atualiza a matriz de itens com a ordem original de inclusao dos itens
            For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
              arrMatItens[intIndIte] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intIndIte];

            FreeAndNil(objOrdenarItensParaGravacao);
          End;

        End;

        {*********************************************}
        {* SE FOR PEDIDO E SE CFG_ENTFUT='S'         *}
        {* AO GERAR O DOCUMENTO, OS ITENS QUE        *}
        {* ESTIVEREM COMO "ENTREGA FUTURA",          *}
        {* DEVERAO SER GRAVADOS COMO "JA EXPEDIDOS"  *}
        {******************************************AC*}
        If Result And blnEntFut Then
          Result := fAtualizaPedidoComoJaExpedido(strAutIncFatGor);

      Except
        On E: Exception Do
        Begin
          Result := False;
          pMensagensErro(E.Message, '[fGEntGerLoja]');
        End;
      End;

      For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
      Begin
        arrDuplicata[intContador] := arrDuplicatasBkp[intContador];
      End;

    Finally
      FstrCodCndPedidoTransf := '';
      FstrConPagPedidoTransf := '';
      FstrCodFpgPedidoTransf := '';
      Self.strEmp_TE := strEmp_TEAux;
      Self.FRecSer   := recServicosAux;
      FreeAndNil(qryCliFil);
    End;
  Finally
    FreeAndNil(LDicSubItens);
    SetLength(arrMatItens, 0);
    SetLength(arrMatItens, Length(arrMatItensBkp));
    For intContIte := Low(arrMatItensBkp) To High(arrMatItensBkp) Do
      arrMatItens[intContIte] := arrMatItensBkp[intContIte];
  End;
end;

function TFatVenda.fRetPrecoSugestaoTransferencia(ACodIte, ACodEmp, ACamSug : String) : Double;
var
  LIteSQL : String;
  LIteGer : TUniQuery;
begin

  Result := 0;

  If ACodIte.IsEmpty Then
    Exit;

  If ACodEmp.IsEmpty Then
    Exit;

  If ACamSug.IsEmpty Then
    Exit;

  LIteSQL := '';
  LIteSQL := LIteSQL + ' SELECT        ';
  LIteSQL := LIteSQL + '   ITE_PRECUS, ';
  LIteSQL := LIteSQL + '   ITE_PREVE1, ';
  LIteSQL := LIteSQL + '   ITE_PREVE2, ';
  LIteSQL := LIteSQL + '   ITE_PREVE3, ';
  LIteSQL := LIteSQL + '   ITE_PREVE4, ';
  LIteSQL := LIteSQL + '   ITE_PREVE5, ';
  LIteSQL := LIteSQL + '   ITE_PREVE6, ';
  LIteSQL := LIteSQL + '   ITE_PREVE7, ';
  LIteSQL := LIteSQL + '   ITE_PREULT, ';
  LIteSQL := LIteSQL + '   ITE_IMPULT, ';
  LIteSQL := LIteSQL + '   ITE_PREMED  ';
  LIteSQL := LIteSQL + ' FROM     ';
  LIteSQL := LIteSQL + '   ITEGER ';
  LIteSQL := LIteSQL + ' WHERE    ';
  LIteSQL := LIteSQL + '   ITE_CODITE = :CODITE AND ';
  LIteSQL := LIteSQL + '   ITE_CODEMP = :CODEMP     ';

  LIteGer := fCriaQuery(Self);

  Try

    LIteGer.Close;
    LIteGer.SQL.Clear;
    LIteGer.SQL.Add(LIteSQL);
    LIteGer.ParamByName('CODITE').AsString := ACodIte;
    LIteGer.ParamByName('CODEMP').AsString := ACodEmp;
    LIteGer.Open;

    If Not LIteGer.IsEmpty Then
    Begin

      If ACamSug = 'IMP' Then
        Result := LIteGer.FieldByName('ITE_IMPULT').AsFloat
      Else If ACamSug = 'SIC' Then
        Result := LIteGer.FieldByName('ITE_MEDSIC').AsFloat
      Else
        Result := LIteGer.FieldByName('ITE_PRE' + ACamSug).AsFloat;

      If ACamSug = 'CUS' Then
      Begin
        pCarregaValoresCusto(ACodIte, ACodEmp, strTabPre);
        Result := fRetPreCus(Result);
      End;

    End;

  Finally
    FreeAndNil(LIteGer);
  End;

end;

function TFatVenda.fGerarTransferenciaAjusteEstoqueDevolucaoAutomatizada : Boolean;
Var
  strCodCliLj,
  strCodEmpLj  : String;
  objTransfere : IGerarTE;
  arrDuplicataSave : TDigDuplicArray;
  blnNotaFiscal : Boolean;
begin

  pSalvaDuplicatas(arrDuplicata, arrDuplicataSave);

  Try

    If strEmpDocDev.IsEmpty Then
      Exit(False);

    objTransfere := TGerarTe.Create(True);

    strCodEmpLj := Self.strEmpLogDev;
    strCodCliLj := fCadEmpDes('CLIFIL', strCodEmpLj);

    objTransfere.pSetaDadosIniciais;
    objTransfere.pSetaDadosCliente(strCodCliLj, Self.strCodVen);

    objTransfere.pSetaProdutos(Self.arrMatItens);

    blnNotaFiscal := (Pos(arrMatItens[0].strEspDev, 'NF_IF_') > 0);
    Result := objTransfere.fGeraTransferencia(IIF(blnNotaFiscal, 'NF', 'TE'));

    If (Result) And (blnNotaFiscal) Then
    Begin
      pGravarLogNfe(objTransfere.fGetNumeroTE, 'NF', Self.strEmpDoc, Self.strSerFsc, strCodCliLj, 'C', 'EE', 'Utilize F1 do Painel para Reenviar...');
      Self.pAddDocumentosParaEnvioNaLibNfe(objTransfere.fGetNumeroTE, 'NF', Self.strEmpDoc, strCodCliLj, Self.strSerFsc, 'C');
    End;

  Finally
    pRestauraDuplicatas(arrDuplicata, arrDuplicataSave);
  End;

end;

function TFatVenda.fFaturandoPedidoComAdiantamentoParcial: Boolean;
begin
  Result := False;

  If strOpcDoc <> 'CP' Then
    Exit;

  If Not fSolicitaDigDuplicAdiantamentoPedido Then
    Exit;

  If Not blnExpedi Then
    Exit;

  If fltBolAdt = 0 Then
    Exit;

  If blnBolVen Then
    Exit;

  Result := True;
end;

function TFatVenda.fGerouBoletoAdiantamentoParcialPedido: Boolean;
begin
  Result := False;

  If Not fSolicitaDigDuplicAdiantamentoPedido Then
    Exit;

  If blnBolVen Then
    Exit;

  If fltBolAdt = 0 Then
    Exit;

  If fltBolAdt >= fltTotGer Then
    Exit;

  Result := True;
end;

function TFatVenda.fGFdoSep(blnUsaCdsVenda    : Boolean = False;
                            blnDesmembramento : Boolean = False): Boolean;
Var
  qryFdoSep        : TUniQuery;
  strEntSai        : String;
  fltQtd           : Double;
  cdsIte           : TUniClientDataSet;
  endItem          : TEndItem;
  endDocumento     : TEndDocumento;
  objEnderecamento : TEnderecamentoProduto;
begin

  qryFdoSep := fCriaQuery;

  Try
    If fCfgSis('PEDEND', varBoolean) Then
    Begin
      objEnderecamento := TEnderecamentoProduto.Create;

      endDocumento.strNumDoc := strNumDoc;
      endDocumento.strEspDoc := strEspDoc;
      endDocumento.strSerie_ := strSerFsc;
      endDocumento.strCodEmp := VS_strCodEmp;
      endDocumento.strCliFor := IIF(fEmptyStr(strCodCli), strCodFor, strCodCli);
      endDocumento.strTip_FC := IIF(fEmptyStr(strCodCli), 'F', 'C');

      objEnderecamento.endDocumento := endDocumento;
    End;

    qryFdoSep.SQL.Clear;
    qryFdoSep.SQL.Add('INSERT INTO FDOSEP(');
    qryFdoSep.SQL.Add('  AUTOINCREM,');
    qryFdoSep.SQL.Add('  FDO_CODEMP,');
    qryFdoSep.SQL.Add('  FDO_NUMDOC,');
    qryFdoSep.SQL.Add('  FDO_CODCLI,');
    qryFdoSep.SQL.Add('  FDO_SEQINC,');
    qryFdoSep.SQL.Add('  FDO_CODITE,');
    qryFdoSep.SQL.Add('  FDO_QTDITE,');
    qryFdoSep.SQL.Add('  FDO_ENTSAI,');
    qryFdoSep.SQL.Add('  FDO_PENDEN');
    qryFdoSep.SQL.Add(') VALUES (');
    qryFdoSep.SQL.Add('  :AUTINC,');
    qryFdoSep.SQL.Add('  :CODEMP,');
    qryFdoSep.SQL.Add('  :NUMDOC,');
    qryFdoSep.SQL.Add('  :CODCLI,');
    qryFdoSep.SQL.Add('  :SEQINC,');
    qryFdoSep.SQL.Add('  :CODITE,');
    qryFdoSep.SQL.Add('  :QTDITE,');
    qryFdoSep.SQL.Add('  :ENTSAI,');
    qryFdoSep.SQL.Add('  :PENDEN');
    qryFdoSep.SQL.Add(');');

    If blnUsaCdsVenda Then
      cdsIte := cdsVenda
    Else
      cdsIte := cdsLogItensSep;

    cdsIte.First;
    While Not cdsIte.Eof Do
    Begin

      If (blnDesmembramento) Then
      Begin
        If (cdsIte.FieldByName('ITE_EMPITE').AsString <> VS_strCodEmp) Then
        Begin
          cdsIte.Next;
          Continue;
        End;
      End;

      If fEhItemServico(cdsIte.FieldByName('ITE_CODITE').AsString) Then
      Begin
        cdsIte.Next;
        Continue;
      End;

      qryFdoSep.ParamByName('AUTINC').AsString := fRetAutoIncrem('FDOSEP', vs_strCodEmp);
      qryFdoSep.ParamByName('CODEMP').AsString := IIF(blnDesmembramento, cdsIte.FieldByName('ITE_EMPITE').AsString, VS_strCodEmp);
      qryFdoSep.ParamByName('NUMDOC').AsString := strNumDoc;
      qryFdoSep.ParamByName('CODCLI').AsString := strCodCli;
      qryFdoSep.ParamByName('SEQINC').AsString := cdsIte.FieldByName('ITE_SEQINC').AsString;
      qryFdoSep.ParamByName('CODITE').AsString := cdsIte.FieldByName('ITE_CODITE').AsString;

      If blnUsaCdsVenda Then
      Begin
        fltQtd := cdsIte.FieldByName('ITE_QTDITE').AsFloat;
        strEntSai := 'S';
      End
      Else
      Begin
        If cdsIte.FieldByName('ITE_STALOG').AsString = 'I' Then
        Begin
          strEntSai := 'S';
          fltQtd := cdsIte.FieldByName('ITE_QTDITE').AsFloat;
        End
        Else If cdsIte.FieldByName('ITE_STALOG').AsString = 'E' Then
        Begin
          strEntSai := 'E';
          fltQtd := cdsIte.FieldByName('ITE_QTDANT').AsFloat;
        End
        Else
        Begin
          fltQtd := cdsIte.FieldByName('ITE_QTDANT').AsFloat - cdsIte.FieldByName('ITE_QTDITE').AsFloat;
          If fltQtd < 0 Then
            strEntSai := 'S'
          Else
            strEntSai := 'E';
          fltQtd := Abs(fltQtd);
        End;
      End;

      If fFormataFloat(fltQtd, 2) = 0.00 Then
      Begin
        cdsIte.Next;
        Continue;
      End;

      qryFdoSep.ParamByName('ENTSAI').AsString := strEntSai;
      qryFdoSep.ParamByName('QTDITE').AsFloat  := fltQtd;

      qryFdoSep.ParamByName('PENDEN').AsString := '1';
      qryFdoSep.ExecSQL;

      If (strEntSai = 'E') And Assigned(objEnderecamento) Then
      Begin
        endItem.strCodIte := cdsIte.FieldByName('ITE_CODITE').AsString;
        endItem.strCodMar := cdsIte.FieldByName('ITE_CODMAR').AsString;
        endItem.strDesIte := cdsIte.FieldByName('ITE_DESITE').AsString;
        endItem.strRefere := cdsIte.FieldByName('ITE_REFERE').AsString;
        endItem.strCodUni := cdsIte.FieldByName('ITE_CODUNI').AsString;
        endItem.strCodFor := cdsIte.FieldByName('ITE_CODFOR').AsString;
        endItem.strCodAmz := cdsIte.FieldByName('ITE_NUMLOT').AsString;
        endItem.fltQtdIte := fltQtd;
        endItem.blnRefugo := False;

        objEnderecamento.pAddItem(endItem);
      End;

      cdsIte.Next;
    End;

    Result := True;

    If Result And Assigned(objEnderecamento) And (objEnderecamento.fGetQtdItens > 0) Then
      Result := objEnderecamento.fGerarPedidoParaReservarEstoque;
  Finally
    FreeAndNil(qryFdoSep);

    If Assigned(objEnderecamento) Then
      FreeAndNil(objEnderecamento);
  End;
end;

procedure TFatVenda.pLimpaFdoSep;
  Var
    qryDel: TUniQuery;
begin
  qryDel := fCriaQuery;
  Try

    qryDel.SQL.Add('DELETE FROM FDOSEP');
    qryDel.SQL.Add(' WHERE FDO_CODEMP = :CODEMP');
    qryDel.SQL.Add('   AND FDO_NUMDOC = :NUMDOC');

    qryDel.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDel.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDel.ExecSQL;
  Finally
    FreeAndNil(qryDel);
  End;
end;

function TFatVenda.fGravaVendasPerdidas: Boolean;
  Var
    blnGravouGer: Boolean;
    strCodigo: String;
begin
  Try
    blnGravouGer := False;
    While (Not cdsItensCorte.Eof) Do
    Begin
      If (Not cdsItensCorte.FieldByName('TEMSALDOS').AsBoolean) And
         (Not cdsItensCorte.FieldByName('LIBERADO').AsBoolean) Then
      Begin
        If Not blnGravouGer Then
        Begin
          strCodigo := fAtualizaProCod('MOVVPG', 'VPG_CODIGO');
          pIncluiMovVpg(strCodigo,
                        strCodCli,
                        strCodVen,
                        '',
                        Self.VS_Date,
                        strNumDoc,
                        strEspDoc,
                        strSerFsc,
                        strOrigemVendaPerdida);
          blnGravouGer := True;
        End;

        pIncluiMovVpd(strCodigo,
                      cdsItensCorte.FieldByName('CODITE').AsString,
                      cdsItensCorte.FieldByName('DESITE').AsString,
                      fCfgSis('MOTCOR'),
                      cdsItensCorte.FieldByName('QTDITE').AsFloat,
                      cdsItensCorte.FieldByName('UNIORI').AsFloat,
                      cdsItensCorte.FieldByName('UNITAR').AsFloat,
                      cdsItensCorte.FieldByName('TOTITE').AsFloat,
                      '',
                      '',
                      0,
                      cdsItensCorte.FieldByName('NUMCMP').AsString);

      End;

      cdsItensCorte.Next;
    End;

    If blnGravouGer And (Length(arrMatItens) = 0) And fOrcamentoComoPedido Then
      pBaixaPedido(strNumOrc,
                   strEspOrc,
                   strEmpOri,
                   fCfgSis('OCCOPD', varString));

    Result := True;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGravaVendasPerdidas]');
    End;
  End;
end;

function TFatVenda.fTemItensDeCorteSemSaldoLiberado(strCodIte: String = ''): Boolean;
  Var
    strFilter : String;
    blnFiltered : Boolean;
begin
  Result := (Assigned(cdsItensCorte)) And (cdsItensCorte.Active);

  If (Result) Then
  Begin
    strFilter := cdsItensCorte.Filter;
    blnFiltered := cdsItensCorte.Filtered;
    Try
      cdsItensCorte.Filtered := False;
      cdsItensCorte.Filter := 'TEMSALDOS = FALSE AND LIBERADO = TRUE';

      If (Not fEmptyStr(strCodIte)) Then
        cdsItensCorte.Filter := cdsItensCorte.Filter + ' AND CODITE = ' + QuotedStr(strCodIte);

      cdsItensCorte.Filtered := True;
      Result := (Not cdsItensCorte.IsEmpty);
      cdsItensCorte.Filtered := False;
    Finally
      cdsItensCorte.Filter := strFilter;
      cdsItensCorte.Filtered := blnFiltered;
    End;
  End;
end;

function TFatVenda.fTemItensDescNegativo: Boolean;
var
  cdsItens: TUniClientDataSet;
begin
  Result := False;

  if (fCfgSis('DESNEG',varBoolean)) then
    Exit;

  try
    cdsItens := TUniClientDataSet.Create(Self);
    pCloneDataSet(cdsItens, cdsVenda);

    cdsItens.First;

    while not cdsItens.Eof do
    begin
      if (cdsItens.FieldByName('ITE_DESCON').AsFloat < 0) then
      begin
        Result := True;
        fMensagem('Atenção!', 'Não é permitido aplicar um desconto negativo (acréscimo) no faturamento! (CFG_DESNEG)'
                  + #13 + 'Item: ' + cdsItens.FieldByName('ITE_CODITE').AsString + ' - ' + cdsItens.FieldByName('ITE_DESITE').AsString, ['&Ok']);
        Break;
      end;

      cdsItens.Next;
    end;
  finally
    FreeAndNil(cdsItens);
  end;
end;

function TFatVenda.fGFatDor: Boolean;
  Var
    intDiaPcd, intContador: Integer;
    qryGen     : TUniQuery;
    strSQL, strCtaPcd: String;
    strCodEmpFatDor: String;
    blnEntFut, blnTemItensCrosDock, blnGerarOrcCompraCrosDock: Boolean;
    objGeraOrc: TGeraOrc;
    itemOrc: TItem;
    objOrdenarItensParaGravacao: TOrdenarItensParaGravacao;
    strINC_PD_Antigo : String;
    strAutFdo : String;
    strAutLog : String;
begin

  Try
    Result := True;

    blnEntFut := False;

    blnGerarOrcCompraCrosDock := fCfgSis('UTIPCD', varBoolean);
    blnTemItensCrosDock := False;
    intDiaPcd := fCfgSis('DIAPCD');
    strCtaPcd := fCfgSis('CTAPCD');
    FstrTabelaReformaGravada := 'FDOREF';

    strCodEmpFatDor := IIF(blnFinali, strPedEmp, IIF((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos), strPedEmp, IIF(fEmptyStr(strEmpOri), strPedEmp, strEmpOri)));

    strAutFdo := fRetAutoIncrem('FATDOR', strCodEmpFatDor, Length(arrMatItens));

    strAutLog := '';
    If (Self.strNumDoc <> Self.strNumOrc) Then
      strAutLog := fRetAutoIncrem('LOGDOR', VS_strCodEmp, Length(arrMatItens));

    //Retorna o autoincremento dos itens para gravacao da tabela FATDOR
    For intContador := 0 To Length(arrMatItens) -1 Do
    begin
      arrMatItens[intContador].strAutoincrementoGravacao := strAutFdo;
      strAutFdo := fNextAutoIncrem(strAutFdo);

      arrMatItens[intContador].strAutoincrementoDaLogDor := strAutLog;
      If (strAutLog <> '') Then
        strAutLog := fNextAutoIncrem(strAutLog);

      If (blnGerarOrcCompraCrosDock) And (Self.strOpcDocTrue = 'MO') Then
      Begin
        If Not blnTemItensCrosDock Then
          blnTemItensCrosDock := fCampoTabela('ITE_CRODOC', 'DESSIT', ['ITE_CODITE'], [arrMatItens[intContador].strCodIte]) = 'S';
      End;
    end;

    Try
      untFatGor.objReprocessarSaldoItens := TReprocessarSaldoItem.New();

      objOrdenarItensParaGravacao := TOrdenarItensParaGravacao.Create;

      objOrdenarItensParaGravacao.pSalvarOrdemMatrizItens(arrMatItens);
      objOrdenarItensParaGravacao.pOrdenarItensPorCodigo(arrMatItens);

      //Atualiza a matriz de itens ja ordenada por codigo de produto
      For intContador := 0 To Length(arrMatItens) -1 Do
        arrMatItens[intContador] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intContador];

      //Realiza a gravacao dos itens na tabela FATDOR
      For intContador := 0 To Length(arrMatItens) -1 Do
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Produto ' + intToStr(Succ(intContador)) + '/' + intToStr(Length(arrMatItens)), True);

        If (arrMatItens[intContador].strCodIte = fCfgSis('SERTER')) And
           (arrMatItens[intContador].fltTotIte = 0) And (Length(arrMatItens) > 1) Then
        Begin
          If Not fTemBrindeServicoTerc Then
            Continue;
        End;

        If (arrMatItens[intContador].strCodIte = fCfgSis('ITESER')) And
           (arrMatItens[intContador].fltTotIte = 0) And (Length(arrMatItens) > 1) Then
        Begin
          If Not fTemBrindeServicoNaoTerc Then
            Continue;
        End;

        intContMat := intContador;

        strINC_PD_Antigo := arrMatItens[intContador].strSeqDet;

        Result := fGravaFatDorItem(arrMatItens[intContador],
                                   strCodEmpFatDor,
                                   strCodCli,
                                   strEspDoc,
                                   strNumDoc,
                                   blnEntFut);

        If (Result) Then
          pAjustarINC_PD_Na_MOVAUX(strINC_PD_Antigo,
                                   arrMatItens[intContador].strAutoincrementoGravacao);

        {*****************************************}
        {* CASO DEU ERRO, SAI DO LOOP            *}
        {**************************************MV*}
        If (Not Result) Then
          Break;

      End;

      If (Result) And (blnTemItensCrosDock) Then
      Begin
        objGeraOrc := TGeraOrc.Create;
        objGeraOrc.strNumPok := Self.strNumPok ;
        Try
          For intContador := 0 To Length(arrMatItens) -1 Do
          Begin
            If (fCampoTabela('ITE_CRODOC', 'DESSIT', ['ITE_CODITE'], [arrMatItens[intContador].strCodIte]) = 'S') Then
            Begin
              itemOrc.strCtaPcd := strCtaPcd;
              itemOrc.dtaDtaPed := arrMatItens[intContador].dtaDtEntr;
              itemOrc.dtaDtaEnt := itemOrc.dtaDtaPed + intDiaPcd;
              itemOrc.strCodEmp := VS_strCodEmp;
              itemOrc.strCodFor := arrMatItens[intContador].strCodFor ;
              itemOrc.strCodIte := arrMatItens[intContador].strCodIte;
              itemOrc.strCodMar := arrMatItens[intContador].strCodMar;
              itemOrc.strCodUni := arrMatItens[intContador].strCodUni;
              itemOrc.strDesIte := arrMatItens[intContador].strDesIte;
              itemOrc.fltQtdIte := arrMatItens[intContador].fltQtdIte;

              itemOrc.fltPreCus := fRetUnitarioSugestaoCompra(itemOrc.strCodIte, itemOrc.strCodEmp, itemOrc.strCodFor);
              If itemOrc.fltPreCus = 0 Then
                itemOrc.fltPreCus := arrMatItens[intContador].fltPreCus;

              objGeraOrc.pAddItem(itemOrc, 0);
            End;
          End;

          objGeraOrc.pGerarOrcamentos;
          If objGeraOrc.intQtdOrcamentoGerado = 0 Then
          Begin
            Result := False;
          End
          Else
            Self.strLisOrcCrosDock := objGeraOrc.strListaOrcamentos;
        Finally
          objGeraOrc.Free;
        End;
      End;

    Finally
      untFatGor.objReprocessarSaldoItens.NotificarRoboParaReprocessarSaldos;
      untFatGor.objReprocessarSaldoItens := nil;

      //Restaura a ordenacao original dos itens
      objOrdenarItensParaGravacao.pRestaurarOrdemMatrizItens(arrMatItens);

      //Atualiza a matriz de itens com a ordem original de inclusao dos itens
      For intContador := 0 To Length(arrMatItens) -1 Do
        arrMatItens[intContador] := objOrdenarItensParaGravacao.arrMatrizItensOrdenados[intContador];

      FreeAndNil(objOrdenarItensParaGravacao);
    End;

    {*************************************************************}
    {* SE UTILIZAR PRÉ-ROMANEIO E ALGUM ITEM FOR EXCLUIDO DO PD, *}
    {* DEVE-SE EXCLUIR O MESMO ITEM DO PRÉ-ROMANEIO.             *}
    {**********************************************************MM*}
    If (fCfgSis('USPRRO',VarBoolean)) And
       (Length(arrAutIncIteDel) > 0) Then
    Begin
      qryGen := fCriaQuery;

      strSQL := '';
      strSQL := strSQL + ' DELETE FROM ROMDETX         ';
      strSQL := strSQL + ' WHERE  DET_NUMDOC = :NUMDOC ';
      strSQL := strSQL + ' AND    DET_ESPDOC = :ESPDOC ';
      strSQL := strSQL + ' AND    DET_CODEMP = :CODEMP ';
      strSQL := strSQL + ' AND    DET_CODCLI = :CODCLI ';
      strSQL := strSQL + ' AND    DET_AUTINC = :AUTINC ';

      For intContador := 0 To Length(arrAutIncIteDel) -1 Do
      Begin
        qryGen.Close;
        qryGen.SQL.Clear;
        qryGen.SQL.Add(strSQL);
        qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
        qryGen.ParamByName('ESPDOC').AsString := strEspDoc;
        qryGen.ParamByName('CODEMP').AsString := strCodEmpFatDor;
        qryGen.ParamByName('CODCLI').AsString := strCodCLi;
        qryGen.ParamByName('AUTINC').AsString := arrAutIncIteDel[intContador];
        qryGen.ExecSQL;
      End;

      FreeAndNil(qryGen);
    End;

    {*********************************************}
    {* SE FOR PEDIDO E SE CFG_ENTFUT='S'         *}
    {* AO GERAR O DOCUMENTO, OS ITENS QUE        *}
    {* ESTIVEREM COMO "ENTREGA FUTURA",          *}
    {* DEVERAO SER GRAVADOS COMO "JA EXPEDIDOS"  *}
    {******************************************AC*}
    If Result And blnEntFut Then
      Result := fAtualizaPedidoComoJaExpedido(strAutIncFatGor);

    {*********************************************}
    {* GRAVANDO OS PROFISSIONAIS - TABELA DIVFAT *}
    {******************************************LU*}
    If (fCfgSis('NROPRO') = '3') And (Assigned(cdsProfiss)) And (Not cdsProfiss.IsEmpty) And (cdsProfiss.Active) Then
    Begin
      qryGen := fCriaQuery;

      strSQL := '';
      strSQL := strSQL + ' DELETE FROM DIVFAT WHERE DIV_SEQGER = :SEQGER ';
      qryGen.Close;
      qryGen.SQL.Clear;
      qryGen.SQL.Add(strSQL);
      qryGen.ParamByName('SEQGER').AsString := strSeqAntFgo;
      qryGen.ExecSQL;

      cdsProfiss.First;
      While Not cdsProfiss.Eof Do
      Begin
        strSQL := '';
        strSQL := strSQL + ' INSERT INTO DIVFAT ( ' ;
        strSQL := strSQL + ' DIV_SEQGER, ' ;
        strSQL := strSQL + ' DIV_CODDIV )' ;
        strSQL := strSQL + ' VALUES ( ' ;
        strSQL := strSQL + ' :SEQGER, ' ;
        strSQL := strSQL + ' :CODDIV )' ;
        qryGen.Close;
        qryGen.SQL.Clear;
        qryGen.SQL.Add(strSQL);
        qryGen.ParamByName('SEQGER').AsString := strAutIncFatGor;
        qryGen.ParamByName('CODDIV').AsString := cdsProfiss.fieldbyname('DIV_CODDIV').AsString;
        qryGen.ExecSQL;

        cdsProfiss.Next;
      End;

      FreeAndNil(qryGen);
    End;

  Except
    On E: EBaixaOrdemProducao Do
      raise EBaixaOrdemProducao.Create(E.Message);
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[fGFatDor]');
    End;
  End;
end;

function TFatVenda.fItemFoiCompletamenteSeparado(const item: TDadosFechamento): Boolean;
begin
  If (Self.blnDesmembrarOrPd) Then
    Result := fCamposDeSeparacaoDaCapaEstaoPreenchidos
  Else
    Result := (item.fltQtdIte = item.fltQtdOri);
end;

function TFatVenda.fGravaFatDorItem(Var item: TDadosFechamento;
                                    strCodEmpFatDor,
                                    strCodCliLj,
                                    strEspDocLj,
                                    strNumDocLj: String;
                                    Var blnEntFut: Boolean;
                                    strEmpFor: String = '';
                                    blnPedidoTransf: Boolean = False): Boolean;
  Var
    fltUniDol: Double;
