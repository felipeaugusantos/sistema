function TFatVenda.fSelecionarFazendaCliente(strCodCliente: String; strCodFazenda: String = ''): Boolean;
begin
  Result := True;

  If objFazenda.strCodCli <> strCodCliente Then
    FEndOri := '';

  objFazenda.strCodCli := strCodCliente;

  If objFazenda.fClientePossuiFazendas And fCfgSis('CADFAZ', VarBoolean) And Not fDocumentoParaFornecedor Then
  Begin
    If Not fEmptyStr(strCodFazenda) Then
    Begin
      objFazenda.strCodFaz := strCodFazenda;
      objFazenda.pCarregarDadosFazenda;

      Result := Not fEmptyStr(objFazenda.strNomFaz);
    End
    Else
      Result := objFazenda.fSelecionarFazenda;

    If Result Then
    Begin
      If fEmptyStr(FEndOri) Then
      Begin
        FEndOri := strCliEnd;

        If Not fEmptyStr(strCliNum) And (Pos(strCliNum, strCliEnd) <= 0) Then
          FEndOri := FEndOri + ', ' + strCliNum;

        If Not fEmptyStr(strCliCom) And (Pos(strCliCom, strCliEnd) <= 0) Then
          FEndOri := FEndOri + ' - ' + strCliCom;

        FEndOri := FEndOri + ' - ' + strCliBai + ' - ' + strCliCid + ' - ' + strCliEst;
      End;

      Self.strCliNom := fRetNomCliente(objFazenda.strCodCli) +
                                 '(' + objFazenda.strNomFaz + ')';

      Self.strCliEnd := objFazenda.strEndere + ', ' +
                        objFazenda.strEndNum + '  ' +
                        objFazenda.strEndCom;

      Self.strCliNum := objFazenda.strEndNum;
      Self.strCliCom := objFazenda.strEndCom;
      Self.strCliBai := objFazenda.strBairro;
      Self.strCliCep := objFazenda.strEndCep;
      Self.strCodCid := objFazenda.strCodCid;

      Self.strCliCid := objFazenda.strNomCid;
      Self.strCliEst := objFazenda.strEstado;

      Self.strCliCgc := objFazenda.strNuCnpj;
      Self.intCgcCpf := objFazenda.intCgcCpf;
      Self.strCliIes := objFazenda.strNumIes;
      Self.strCli_Rg := '';
    End
    Else
      objFazenda.pLimparDadosFazenda;
  End
  Else
    objFazenda.pLimparDadosFazenda;
end;

