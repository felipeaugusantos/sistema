function TFatVenda.fTemItensRetira(Itens: TMatrizFechamento;
  filtroEmpresa: TFiltroEmpresa = opTodasEmpresas;
  filtroLocal: TFiltroLocalRetira = opLocalRetiraTodas): Boolean;
  Var
    strEmpresaLogada: String;
    item: TDadosFechamento;
    objFilterMat: TFilterMatrizItens;
    objFiltersItem: TFiltersItem;
begin
  strEmpresaLogada := IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog);
  objFilterMat     := TFilterMatrizItens.Create(Itens);
  objFiltersItem   := TFiltersItem.Create;

  With objFilterMat, objFiltersItem Do
  Begin
    pDesfazerFiltros;
    fFiltrar(fFiltraRetira);

    If filtroLocal = opLocalRetiraCaixa Then
      fFiltrar(fFiltraRetiraCaixa);

    If filtroLocal = opLocalRetiraExpedicao Then
      fFiltrar(fFiltraRetiraExpedicao);

    If filtroLocal = opLocalRetiraBalcao Then
      fFiltrar(fFiltraRetiraBalcao);

    If filtroLocal = opLocalRetiraBalcao2 Then
      fFiltrar(fFiltraRetiraBalcao2);

    Result := Length(MatrizItens) > 0;

    If Result And (filtroEmpresa = opOutraEmpresa) Then
    Begin
      Result := False;
      If fCfgSis('EMPFAT', VarBoolean, strEmpresaLogada) Then
        For item In MatrizItens Do
          If (item.strEmpIte <> strEmpresaLogada) Then
            Result := True;
    End;

    If Result And (filtroEmpresa = opPropriaEmpresa) Then
    Begin
      Result := False;
      For item In MatrizItens Do
        If (item.strEmpIte = strEmpresaLogada) Then
          Result := True;
    End;
  End;

  objFilterMat.Destroy;
  objFiltersItem.Destroy;
end;

