    strMsgBai := strHistoricoUsoConsumo+fRetDocRef(False);
  End;

  strNumDup := fRetSequencialCadPag;

  if fCfgSis('PPLBAI', varBoolean)  then
  Begin
    strCodPorBaixa         := strCodPorUso;
    strCodCentroCustoBaixa := strCentroCustoUsoConsumo;
  End
  Else
  Begin
    strCodPorBaixa         := strCodPorAvi;
    strCodCentroCustoBaixa := fCfgSis('CTAAVI');
