      pAtualizaTinDorBaixado;

      If (fPedidoEmPedido) And (fCfgSis('F11PGR', varBoolean)) Then
        pAtualizaTinDorBaixadoOrigem(strNumDoc, strEspDoc, strCodEmpTinDor);
    End;

    pAtualizaTinDorEtiImpressa;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[fGArqTinOR]');
    End;
  End;

  If Assigned(stlDadosBaixaFormulacao) Then
    FreeAndNil(stlDadosBaixaFormulacao);
end;

function TFatVenda.fGMovMod: Boolean;
  Var
    fltTotal: Double;
    fltValMod: Double;
    strDocume: String;
    strCodMod: String;
    qryMovCar: TUniQuery;
    qryAux: TUniQuery;
    qryMod: TUniQuery;
    strSerie: String;
    blnGravarPeloFaturamento: Boolean;
    blnExpedicaoComAdiantamento: Boolean;

    fltAuxDin,
    fltAuxCqP,
    fltAuxCqV,
    fltAuxCar,
    fltAuxOrd,
    fltAuxCre: Double;

    fltFatorValDinDesmembramento: Double;

    strTipCar : String;
    strCodRed : String;
    strPixS_N : String;
    strNumOri : String;
    strEspOri : String;
    strNumOrcOri : String;
    strEspOrcOri : String;
    strEmpOrcOri : String;
    fltPixMovMod : Double;
    LDadosPix: TDadosRetornoPixConsulta;

    function fGravaMovMod: Boolean;
    begin
      Result := untMovGer.fGravaMovMod(strNumDoc,
                                       strEspDoc,
                                       fRetornaEmpresaMovCarMovModAoDesmembrarPedido('MOVMOD'),
                                       strCodCli,
                                       strSerFsc,
                                       strCodMod,
                                       fltValMod,
                                       strDocume,
                                       fltValMod,
                                       strTipCar,
                                       strCodRed,
                                       strPixS_N);
    end;

    function fUsarSomenteOTotalSeModalidadeForMaior(fltValModAux: Double): Double;
    begin
      Result := fltValModAux;
      
      If Not FFoiGravacaoPorDesmembramento Then
        Result := IIF(fltValModAux > fltTotal, fltTotal, fltValModAux); 
    end;
    
    function fAjustarModalidadeSeTotalNegativo(fltValModAux: Double): Double;
    begin
      Result := fltValModAux;

      If Not FFoiGravacaoPorDesmembramento Then
        If blnExpedicaoComAdiantamento Then
          Result := IIF(fltTotal < 0, fltValModAux - Abs(fltTotal), fltValModAux); 
    end;

    procedure pRetornaPedidoOriginal;
    var
      qryOrcOri: TUniQuery;
    begin
      qryOrcOri := fCriaQuery;

      Try
        qryOrcOri.SQL.Clear;
        qryOrcOri.SQL.Add('SELECT FDO_NUMDOC, FDO_ESPDOC, FDO_CODEMP FROM FATDOR ');
        qryOrcOri.SQL.Add('WHERE FDO_NUMFAT = :NUMFAT ');
        qryOrcOri.SQL.Add('  AND FDO_TIPFAT = :TIPFAT ');
        qryOrcOri.SQL.Add('  AND FDO_CODCLI = :CODCLI ');
        qryOrcOri.SQL.Add('  AND FDO_EMPFAT = :EMPFAT ');

        qryOrcOri.ParamByName('NUMFAT').AsString := strNumOrc;
        qryOrcOri.ParamByName('TIPFAT').AsString := strEspOrc;
        qryOrcOri.ParamByName('CODCLI').AsString := strCodCli;
        qryOrcOri.ParamByName('EMPFAT').AsString := IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido),
                                                         VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri)));

        qryOrcOri.Open;

        If not qryOrcOri.IsEmpty Then
        Begin
          strNumOrcOri := qryOrcOri.FieldByName('FDO_NUMDOC').AsString;
          strEspOrcOri := qryOrcOri.FieldByName('FDO_ESPDOC').AsString;
          strEmpOrcOri := qryOrcOri.FieldByName('FDO_CODEMP').AsString;
        End;

      Finally
        FreeAndNil(qryOrcOri);
      End;
    end;

    function fRetornaDocumento(intModelo: Integer): String;
    begin
      Case intModelo Of
        1: Result := strNumDoc + '-A-' + strEspDoc + '-' + IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido),
                                                               VS_strCodEmp,
                                                               IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri))) + '-000-%';

        2: Result := '%'+strNumDoc + '%A-' + strEspDoc + '-' + IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido),
                                                               VS_strCodEmp,
                                                               IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri))) + '%';

        3: Result := strNumOrc + '-A-' + strEspOrc + '-' + IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido),
                                                               VS_strCodEmp,
                                                               IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri))) + '-000%';

        4: Result := '%'+strNumOrc + '%A-' + strEspOrc + '-' + IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido),
                                                               VS_strCodEmp,
                                                               IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri))) + '%';

        5: Result := strNumOrcOri + '-A-' + strEspOrcOri + '-' + strEmpOrcOri + '-000%';

        6: Result := '%'+strNumOrcOri + '%A-' + strEspOrcOri + '-' + strEmpOrcOri + '%';
      End;
    end;

    function fCarregaMovCar(intModelo: Integer): Boolean;
    begin
      If Assigned(qryMovCar) Then
        FreeAndNil(qryMovCar);

      qryMovCar := fCriaQuery(Self);
      qryMovCar.SQL.Add('SELECT ');
      qryMovCar.SQL.Add('  * ');
      qryMovCar.SQL.Add('FROM ');
      qryMovCar.SQL.Add('  MOVCAR ');
      qryMovCar.SQL.Add('WHERE ');
      qryMovCar.SQL.Add('  (MCA_CODFIN IS NULL) ');

      Case intModelo Of
        1,3,5: qryMovCar.SQL.Add('  AND (MCA_DOCUME LIKE :DOCUME) ');
        2,4,6: qryMovCar.SQL.Add('  AND (MCA_HIST02 LIKE :DOCUME) ');
      End;

      qryMovCar.SQL.Add('  AND MCA_CODCLI = :CODCLI ');

      if (not blnImpPafEcf) then
        qryMovCar.SQL.Add('  AND MCA_DTACAD = :DTACAD');

      qryMovCar.ParamByName('DOCUME').AsString := fRetornaDocumento(intModelo);
      qryMovCar.ParamByName('CODCLI').AsString := strCodCli;

      if (not blnImpPafEcf) then
        qryMovCar.ParamByName('DTACAD').AsDate := Self.VS_Date;

      qryMovCar.Open;

      Result := (qryMovCar.RecordCount > 0);
    end;

    procedure pCarregaMovimentacaoDeCartoes;
    begin
      If fCarregaMovCar(1) Then
        Exit;

      If fCarregaMovCar(2) Then
        Exit;

      If fEmptyStr(Self.strNumOrc) Then
        Exit;

      If fCarregaMovCar(3) Then
        Exit;

      If fCarregaMovCar(4) Then
        Exit;

      pRetornaPedidoOriginal;

      If fEmptyStr(strNumOrcOri) Then
        Exit;

      If fCarregaMovCar(5) Then
        Exit;

      If fCarregaMovCar(6) Then
        Exit;

    end;
  
begin

  Try
    Result   := True;
//    fltTotal := fltTotGer;

    strNumOrcOri := '';
    strEspOrcOri := '';
    strEmpOrcOri := '';

    fltTotal := IIF(fltTotCadRec <> 0, fltTotCadRec, fltTotGer);
    qryAux   := fCriaQuery(Self);

    strSerie := strSerFsc;

    blnGravarPeloFaturamento := True;

    blnExpedicaoComAdiantamento := (blnExpedi Or (strOpcDocTrue = 'EF')) And
                                   (recValAdt.fltValLan > 0);

    if (strOpcDocTrue = 'EF') and (strCodFpg = '009') and (fltFatura = 0) then
      fltFatura := fRetornaValorFaturadoEntregaFuturaMultiplasFormasPagamento(Self.strIncOrc);

    If blnExpedi And (fCfgSis('TIPEXP') <> '2') And
      fSomaFormasPedido(fltAuxDin, fltAuxCqP, fltAuxCqV, fltAuxCar,
                        fltAuxOrd, fltAuxCre, arrPedidos) Then
    Begin
      fltValDin := fltAuxDin;
      fltValCqP := fltAuxCqP;
      fltValCqV := fltAuxCqV;
      fltValCar := fltAuxCar;
      fltValOrd := fltAuxOrd;
      fltValCre := fltAuxCre;

      blnGravarPeloFaturamento := False;
    End
    Else If blnExpedicaoComAdiantamento Then
    Begin
      fltValDin := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValDin);
      fltValCqP := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValChP);
      fltValCqV := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValChV);
      fltValCar := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValCar);
      fltValOrd := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValOrd);
      fltValFin := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValFin);
      fltValCre := fUsarSomenteOTotalSeModalidadeForMaior(recValAdt.fltValCre);

      blnGravarPeloFaturamento := False;
    End;

    fltFatorValDinDesmembramento := 1;
    If blnGravandoVariosDocumentos Then
    Begin
      If blnGravarPeloFaturamento Then
      Begin
        If (Self.recModOriDesmembramento.fltValDin > fltValDin) Then
          fltFatorValDinDesmembramento := (fltValDin / Self.recModOriDesmembramento.fltValDin);
      End;
    
      blnGravarPeloFaturamento := False;

      If (blnExpedi) And (cdsModalidade.IsEmpty) Then
      Begin
        If ((fltValDin + fltValCqP + fltValCqV + fltValCar + fltValOrd + fltValFin + fltValCre) = 0.00) Then
          blnGravarPeloFaturamento := True;
      End;                          
    End;

    qryAux.SQL.add('DELETE FROM MOVMOD ');
    qryAux.SQL.add('WHERE ');
    qryAux.SQL.add('  MOD_NUMDOC = :NUMDOC AND ');
    qryAux.SQL.add('  MOD_ESPDOC = :ESPDOC AND ');
    qryAux.SQL.add('  MOD_CODEMP = :CODEMP AND ');
    qryAux.SQL.add('  MOD_CODCLI = :CODCLI AND ');

    If fEmptyStr(strSerie) Then
      qryAux.SQL.add('  ((MOD_SERIE_ IS NULL) OR (MOD_SERIE_ = ""))')
    Else
      qryAux.SQL.add('  MOD_SERIE_ = :SERIE_ ');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido('MOVMOD')),
                                                 VS_strCodEmp, 
                                                 IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri)));
    qryAux.ParamByName('CODCLI').AsString := strCodCli;

    If Not fEmptyStr(strSerie) Then
      qryAux.ParamByName('SERIE_').AsString := strSerie;

    qryAux.ExecSQL;

    FreeAndNil(qryAux);

    If (Not VS_blnUsaFpg) Then
      Exit;

    // 001 - Dinheiro
    If (fltValDin <> 0.0) And (Result) Then
    Begin
      fltValMod := fltValDin;

      if (optTrocoDinheiro = otCredito) And (fltValorTrocoDinheiro > 0) then
        fltValMod := fltValMod + fltValorTrocoDinheiro;

      fltTotal  := fltTotal - fltValDin;
      strDocume := '';
      strCodMod := '001';
      Result := fGravaMovMod;

      //Valor de credito gerado para recebimento com dinheiro
      If (optTrocoDinheiro = otCredito) And (fltValorTrocoDinheiro > 0) Then
      Begin
        fltValMod := - fltValorTrocoDinheiro;
        strDocume := '';
        strCodMod := '013';
        Result := fGravaMovMod;
      End;
    End;

    // 002 - Cheque Pré
    If (fltValCqP <> 0.0) And (Result) Then
    Begin
      strCodMod := '002';
      fltTotal  := fltTotal - fltValCqP;

      If blnGravarPeloFaturamento Then
        strDocume := fDocumeCheque(CHQ_PRE)
      Else
        strDocume := '';

      If blnGravarPeloFaturamento And (fCfgSis('CHQRCX', varBoolean)) Then
      Begin
        cdsChequePre.First;
        While (Not cdsChequePre.Eof) And (Result) Do
        Begin
          fltValMod := cdsChequePre.FieldByName('CHQ_VALCHQ').AsFloat;
          Result := fGravaMovMod;

          cdsChequePre.Next;
        End;

        //Valor de credito gerado para recebimento com cheque pré
        If (optTrocoPre = otCredito) And (fltValorTrocoPre > 0) Then
        Begin
          fltValMod := - fltValorTrocoPre;
          strDocume := '';
          strCodMod := '013';
          Result := fGravaMovMod;
        End;
      End
      Else
      Begin
        strDocume := '';
        fltValMod := fAjustarModalidadeSeTotalNegativo(fltValCqP);
        Result := fGravaMovMod;
      End;
    End;

    // 006 - Cheque a vista
    If (fltValCqV <> 0.0) And (Result) Then
    Begin
      strCodMod := '006';
      fltTotal  := fltTotal - fltValCqV;

      If blnGravarPeloFaturamento Then
        strDocume := fDocumeCheque(CHQ_VISTA)
      Else
        strDocume := '';

      If blnGravarPeloFaturamento And
         (fCfgSis('CHQRCX', varBoolean)) And
         (fCfgSis('CHQVIS', varBoolean)) Then
      Begin
        cdsChequeVis.First;
        While (Not cdsChequeVis.Eof) And (Result) Do
        Begin
          fltValMod := cdsChequeVis.FieldByName('CHQ_VALCHQ').AsFloat;
          Result := fGravaMovMod;

          cdsChequeVis.Next;
        End;

        //Valor de credito gerado para recebimento com cheque vista
        If (optTroco = otCredito) And (fltValorTroco > 0) Then
        Begin
          fltValMod := - fltValorTroco;
          strDocume := '';
          strCodMod := '013';
          Result := fGravaMovMod;
        End;

      End
      Else
      Begin
        strDocume := '';
        fltValMod := fAjustarModalidadeSeTotalNegativo(fltValCqV);
        Result := fGravaMovMod;
      End;
    End;

    // 007 - Cartão
    If (fltValCar <> 0.0) And (Result) Then
    Begin
      strCodMod := '007';
      fltTotal  := fltTotal - fltValCar;

      If blnGravarPeloFaturamento Then
      Begin
       pCarregaMovimentacaoDeCartoes;

        While (Not qryMovCar.Eof) And (Result) Do
        Begin
          strDocume := qryMovCar.FieldByName('MCA_DOCUME').AsString;
          fltValMod := qryMovCar.FieldByName('MCA_VALSTA').AsFloat;
          strPixS_N := qryMovCar.FieldByName('MCA_PIXS_N').AsString;
          strCodRed := fRetOperadoraCartao(qryMovCar.FieldByName('MCA_CODCAR').AsString);
          strTipCar := fRetTipoCartao(qryMovCar.FieldByName('MCA_CODCAR').AsString);

          Result    := fGravaMovMod;

          qryMovCar.Next;
        End;

        //Valor de credito gerado para recebimento com cartao
        If (optTrocoCar = otCredito) And (fltValorTrocoCar > 0) Then
        Begin
          fltValMod := - fltValorTrocoCar;
          strDocume := '';
          strCodMod := '013';
          Result := fGravaMovMod;
        End;

      End Else
      Begin

        Try
          If Self.blnExpedi And (Self.intQtdePedidosExpedicao = 1) And fEmptyStr(strNumOrc)  Then
          Begin
            strNumOrc := arrMatItens[0].strNumOrc;
            strEspOrc := arrMatItens[0].strEspOrc;
            strEmpOri := arrMatItens[0].strEmpOrc;
          End;

          pCarregaMovimentacaoDeCartoes;

          If (qryMovCar.RecordCount > 0) Then
          begin
            strPixS_N := qryMovCar.FieldByName('MCA_PIXS_N').AsString;
            strCodRed := fRetOperadoraCartao(qryMovCar.FieldByName('MCA_CODCAR').AsString);
            strTipCar := fRetTipoCartao(qryMovCar.FieldByName('MCA_CODCAR').AsString);
          end;

          if blnGravandoVariosDocumentos then
          begin
            fltValMod := fAjustarModalidadeSeTotalNegativo(fltValCar);

            If fEmptyStr(strTipCar) Then
              strTipCar := fGetTipCarPorProporcionalidadeCredDeb(fltValMod, strTipCar);

            Result    := fGravaMovMod;
          end
          else
          begin
            strDocume := '';
            fltValMod := fAjustarModalidadeSeTotalNegativo(fltValCar);
            Result    := fGravaMovMod;
          end;
        Finally
          If Self.blnExpedi And (Self.intQtdePedidosExpedicao = 1) And (not fEmptyStr(arrMatItens[0].strNumOrc)) Then
          Begin
            strNumOrc := '';
            strEspOrc := '';
            strEmpOri := '';
          End;
        End;
      End;

    End;

    // 016 - FINANCIAMENTO
    If (fltValFin <> 0.0) And (Result) Then
    Begin
      strCodMod := '016';
      fltTotal  := fltTotal - fltValFin;

      If blnGravarPeloFaturamento Then
      Begin
        qryMovCar := fCriaQuery(Self);
        qryMovCar.SQL.Add('SELECT ');
        qryMovCar.SQL.Add('  * ');
        qryMovCar.SQL.Add('FROM ');
        qryMovCar.SQL.Add('  MOVCAR ');
        qryMovCar.SQL.Add('WHERE ');
        qryMovCar.SQL.Add('  (MCA_CODFIN IS NOT NULL) ');
        qryMovCar.SQL.Add('  AND MCA_DOCUME LIKE :DOCUME ');
        qryMovCar.SQL.Add('  AND MCA_CODCLI = :CODCLI ');
        if (not blnImpPafEcf) then
          qryMovCar.SQL.Add('  AND MCA_DTACAD = :DTACAD');
        qryMovCar.ParamByName('DOCUME').AsString := strNumDoc + '-A-' + strEspDoc + '-' + IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido), 
                                                                                              VS_strCodEmp, 
                                                                                              IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri)) + '-000-%';
        qryMovCar.ParamByName('CODCLI').AsString := strCodCli;
        if (not blnImpPafEcf) then
          qryMovCar.ParamByName('DTACAD').AsDate := Self.VS_Date;
        qryMovCar.Open;

        While (Not qryMovCar.Eof) And (Result) Do
        Begin
          strDocume := qryMovCar.FieldByName('MCA_DOCUME').AsString;
          fltValMod := qryMovCar.FieldByName('MCA_VALSTA').AsFloat;
          Result    := fGravaMovMod;

          qryMovCar.Next;
        End;

      End Else
      Begin
        strDocume := '';
        fltValMod := fAjustarModalidadeSeTotalNegativo(fltValFin);
        Result    := fGravaMovMod;
      End;

    End;

    // 008 - Faturado
    If (fltFatura <> 0.0) And (Result) Then
    Begin
      fltValMod := fltFatura;
      fltTotal  := fltTotal - fltFatura;
      strDocume := '';
      strCodMod := '008';
      Result := fGravaMovMod;
    End;

    // 010 - VALE
    If (fltValVle <> 0.0) And (Result) Then
    Begin
      fltValMod := fltValVle;
      fltTotal  := fltTotal - fltValVle;
      strDocume := '';
      strCodMod := '010';
      Result    := fGravaMovMod;
    End;

    // 012 - Ordem Pagamento
    If (fltValOrd <> 0.0) And (Result) Then
    Begin
      If (blnGravarPeloFaturamento) And
         (Self.DadosPixDaVenda.RecebidoPorPix = 'S') And
         (Assigned(Self.DadosPixDaVenda.LstPixPago)) And
         (Self.DadosPixDaVenda.LstPixPago.Count > 0) Then
      Begin
        fltPixMovMod := 0;
        For LDadosPix In Self.DadosPixDaVenda.LstPixPago Do
        Begin
          fltPixMovMod := fltPixMovMod + LDadosPix.ValorPago;
          fltValMod := LDadosPix.ValorPago;
          fltTotal := fltTotal - fltValMod;
          strDocume := EmptyStr;
          strCodMod := '012';
          Result := fGravaMovMod;
          If (Not Result) Then
            Break;
        End;
        If (Result) And (fFormataFloat(fltValOrd - fltPixMovMod, 2) > 0) Then
        Begin
          strDocume := EmptyStr;
          strCodMod := '012';
          fltValMod := fFormataFloat(fltValOrd - fltPixMovMod, 2);
          fltTotal := fltTotal - fltValMod;
          Result := fGravaMovMod;
        End;
      End
      Else
      Begin
        fltValMod := fltValOrd;
        fltTotal  := fltTotal - fltValOrd;
        strDocume := '';
        strCodMod := '012';
        Result := fGravaMovMod;
      End;
    End;

    // 013 - Utilização de Créditos
    If (fltValCre <> 0.0) And (Result) Then
    Begin
      fltValMod := Abs(fltValCre);
      fltTotal  := fltTotal - Abs(fltValCre);
      strDocume := '';
      strCodMod := '013';
      Result := fGravaMovMod;
    End;

    // 014 - CARTEIRA
    If (strCodFpg  = '014') And (Result) Then
    Begin
      fltValMod := Abs(fltTotal);
      fltTotal  := 0.00;
      strDocume := '';
      strCodMod := '014';
      Result := fGravaMovMod;
    End;

    // 015 - A RECEBER
    If fTemFormaPagtoAReceber And Result Then
    Begin
      fltValMod := Abs(fltTotal);//Ja descontou credito acima caso tenha sido informado em conjunto
      fltTotal  := 0.00;         //assim o valor restante somente pode ser o valor a receber
      strDocume := '';
      strCodMod := '015';
      Result := fGravaMovMod;
    End;

    {*****************************************}
    {* ATENÇÃO: SE FOR COLOCAR ALGUMA OUTRA  *}
    {* MODALIDADE, COLOCAR ACIM DESSA CONDI- *}
    {* ÇÃO.                                  *}
    {**10/11/2008 - 11:25******************MV*}
    // Restante das Modalidades
    If (fFormataFloat(fltTotal, 2) <> 0.00) And (Result) And blnGravarPeloFaturamento Then
    Begin
      fltValMod := fltTotal;
      strDocume := '';

      If (fEmptyStr(strCodFpg)) And (Pos(strClaFis, VS_strClaDev) > 0) Then
        strCodMod := '001'
      Else
        strCodMod := strCodFpg;

       If (Pos(strOpcDoc, 'CF_CI_') > 0) And (strCodMod = '007') And Assigned(qryTemporariaConfirmacao) Then
       Begin
         If (qryTemporariaConfirmacao.RecordCount = 1) Then
         Begin
           strNumOri := strNumDoc;
           strEspOri := strEspDoc;

           strNumDoc := qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString;
           strEspDoc := qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString;

           Try
             pCarregaMovimentacaoDeCartoes;

             strPixS_N := qryMovCar.FieldByName('MCA_PIXS_N').AsString;
             strCodRed := fRetOperadoraCartao(qryMovCar.FieldByName('MCA_CODCAR').AsString);
             strTipCar := fRetTipoCartao(qryMovCar.FieldByName('MCA_CODCAR').AsString);
           Finally
             strNumDoc := strNumOri;
             strEspDoc := strEspOri;
           End;
         End;
       End;

      Result := fGravaMovMod;
    End;

    If cdsModalidade.Active Then
    Begin
      qryMod := fCriaQuery;
      Try
        cdsModalidade.First;
        While Not cdsModalidade.Eof Do
        Begin
          If Pos(cdsModalidade.FieldByName('CODFPG').AsString, '001_') > 0 Then
          Begin
            qryMod.Close;
            qryMod.SQL.Clear;
            qryMod.SQL.add('UPDATE MOVMOD SET ');
            qryMod.SQL.add('  MOD_VALPAG = :VALPAG ');
            qryMod.SQL.add('WHERE ');
            qryMod.SQL.add('  MOD_NUMDOC = :NUMDOC AND ');
            qryMod.SQL.add('  MOD_ESPDOC = :ESPDOC AND ');
            qryMod.SQL.add('  MOD_CODEMP = :CODEMP AND ');
            qryMod.SQL.add('  MOD_CODCLI = :CODCLI AND ');
            qryMod.SQL.add('  MOD_CODMOD = :CODMOD AND ');

            If fEmptyStr(strSerie) Then
              qryMod.SQL.add('  ((MOD_SERIE_ IS NULL) OR (MOD_SERIE_ = ""))')
            Else
              qryMod.SQL.add('  MOD_SERIE_ = :SERIE_ ');

            qryMod.ParamByName('NUMDOC').AsString := strNumDoc;
            qryMod.ParamByName('ESPDOC').AsString := strEspDoc;
            qryMod.ParamByName('CODEMP').AsString := IIF(((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos)) And (Not fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido('MOVMOD')),
                                                         VS_strCodEmp, 
                                                         IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc), VS_strCodEmp, strEmpOri)));
            qryMod.ParamByName('CODCLI').AsString := strCodCli;
            qryMod.ParamByName('CODMOD').AsString := cdsModalidade.FieldByName('CODFPG').AsString;
            qryMod.ParamByName('VALPAG').AsFloat  := cdsModalidade.FieldByName('VALOR').AsFloat * fltFatorValDinDesmembramento;

            If Not fEmptyStr(strSerie) Then
              qryMod.ParamByName('SERIE_').AsString := strSerie;

            qryMod.ExecSQL;
          End;

          cdsModalidade.Next;
        End;
      Finally
        FreeAndNil(qryMod);
      End;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGMovMod]');
    End;
  End;

end;

