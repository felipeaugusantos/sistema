  function fCarregaItens(strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
  Var
    qryIteTmp  : TUniQuery;
    blnConfirma: Boolean;
  Begin
    Try

      qryIteTmp   := fCriaQuery(Nil);
      blnConfirma := True;

      With qryIteTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL(False));
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODCLI').AsString := strCodCli;
        Open;
        First;

        While Not Eof Do
        Begin
          If (Not fInsereItens(qryIteTmp)) Then
          Begin
            blnConfirma := False;
            Break;
          End;

          Next;
        End;

      End;

      Result := blnConfirma;

    Finally
      FreeAndNil(qryIteTmp);
    End;
  End;

  procedure pCriaClientDev;
  Begin

    With qryIteDev Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(fGetSQL(True));
      Open;
      pSetaClient(qryIteDev);

      cdsIteDev.Open;
      pSetaClient(cdsIteDev);
    End;

  End;

Begin

  Try
    blnConfirma := True;

    qryIteDev := fCriaQuery(Nil);
    cdsIteDev := TUniClientDataSet.Create(Nil);
    dspIteDev := TUniDataSetProvider.Create(Nil);

    dspIteDev.DataSet := qryIteDev;
    cdsIteDev.SetProvider(dspIteDev);

    pCriaClientDev;

    cdsDocDem.Filter   := 'MARDES = ''M''';
    cdsDocDem.Filtered := True;

    With cdsDocDem Do
    Begin
      First;

      While Not Eof Do
      Begin
        If (Not fCarregaItens(FieldByName('NUMDOC').AsString,
                              FieldByName('ESPDOC').AsString,
                              FieldByName('CODEMP').AsString,
                              FieldByName('CODCLI').AsString)) Then
        Begin
          blnConfirma := False;
          Break;
        End;

        Next;

      End;

    End;

    If (blnConfirma) Then
      Result := cdsIteDev.Data;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[TFatVenda.fCarregaItensDevDemonstracao]');
  End;

  FreeAndNil(cdsIteDev);
  FreeAndNil(dspIteDev);
  FreeAndNil(qryIteDev);

  cdsDocDem.Filter   := '';
  cdsDocDem.Filtered := False;

End;

function TFatVenda.fMarcaDocDemonstracaoDevolvido(strNumFat,
                                                  strTipFat,
                                                  strEmpFat,
                                                  strVenFat,
                                                  strCndFat,
                                                  strCliFat: String;
                                                  fltValFat: Double): Boolean;
Var
  blnConfirma: Boolean;

  function fGetSQL(strTabela, strSigTab: String): String;
  Var
    strSQL: String;
  Begin
    strSQL := '';
    strSQL := strSQL + '/* untFuncFat(fMarcaDocDemonstracaoDevolvido) */ ';
    strSQL := strSQL + 'UPDATE   ';
    strSQL := strSQL +    strTabela + ' ';
    strSQL := strSQL + 'SET      ';
    strSQL := strSQL +    strSigTab + 'JAFATU = :JAFATU, ';
    strSQL := strSQL +    strSigTab + 'NUMFAT = :NUMFAT, ';
    strSQL := strSQL +    strSigTab + 'TIPFAT = :TIPFAT, ';
    strSQL := strSQL +    strSigTab + 'EMPFAT = :EMPFAT, ';
    strSQL := strSQL +    strSigTab + 'DTAFAT = ' + fCurrentDate(Self.VS_Date) + ', ';
    strSQL := strSQL +    strSigTab + 'VENFAT = :VENFAT, ';
    strSQL := strSQL +    strSigTab + 'CNDFAT = :CNDFAT, ';
    strSQL := strSQL +    strSigTab + 'VALFAT = :VALFAT, ';
    strSQL := strSQL +    strSigTab + 'CLIFAT = :CLIFAT ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL +    strSigTab + 'NUMDOC = :NUMDOC AND ';
    strSQL := strSQL +    strSigTab + 'ESPDOC = :ESPDOC AND ';
    strSQL := strSQL +    strSigTab + 'CODEMP = :CODEMP AND ';
    strSQL := strSQL +    strSigTab + 'CODCLI = :CODCLI     ';

    Result := strSQL;
  End;

  procedure pSetaParametros(qryDoc: TUniQuery;
                            strNumDoc,
                            strEspDoc,
                            strCodEmp,
                            strCodCli,
                            strNumFat,
                            strTipFat,
                            strEmpFat,
                            strVenFat,
                            strCndFat,
                            strCliFat: String;
                            fltValFat: Double);
  Begin
    With qryDoc Do
    Begin
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;

      //ParamByName('JAFATU').AsString := '1';
      If ParamByName('JAFATU').DataType = ftInteger Then
        ParamByName('JAFATU').AsInteger :=  1
      else if ParamByName('JAFATU').DataType = ftString Then
        ParamByName('JAFATU').AsString  :=  '1'
      else
        ParamByName('JAFATU').AsBoolean :=  true;

      ParamByName('NUMFAT').AsString := strNumFat;
      ParamByName('TIPFAT').AsString := strTipFat;

      If fEmptyStr(strEmpFat) Then
        ParamByName('EMPFAT').Value    := Null
      Else
        ParamByName('EMPFAT').AsString := strEmpFat;

      ParamByName('VENFAT').AsString := strVenFat;
      ParamByName('CNDFAT').AsString := strCndFat;
      ParamByName('VALFAT').AsFloat  := fltValFat;
      ParamByName('CLIFAT').AsString := strCliFat;
    End;
  End;

  function fMarcaDevolvido(strNumDoc,
                           strEspDoc,
                           strCodEmp,
                           strCodCli,
                           strNumFat,
                           strTipFat,
                           strEmpFat,
                           strVenFat,
                           strCndFat,
                           strCliFat: String;
                           fltValFat: Double): Boolean;
  Var
    qryDoc: TUniQuery;
  Begin

    Try
      qryDoc := fCriaQuery(Nil);

      With qryDoc Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL('MOVGER', 'GER_'));
        pSetaParametros(qryDoc, strNumDoc, strEspDoc, strCodEmp, strCodCli, strNumFat, strTipFat, strEmpFat, strVenFat, strCndFat, strCliFat, fltValFat);
        ExecSQL;
      End;

      With qryDoc Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL('MOVDET', 'DET_'));
        pSetaParametros(qryDoc, strNumDoc, strEspDoc, strCodEmp, strCodCli, strNumFat, strTipFat, strEmpFat, strVenFat, strCndFat, strCliFat, fltValFat);
        ExecSQL;
      End;

      With qryDoc Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL('NOTGER', 'GER_'));
        pSetaParametros(qryDoc, strNumDoc, strEspDoc, strCodEmp, strCodCli, strNumFat, strTipFat, strEmpFat, strVenFat, strCndFat, strCliFat, fltValFat);
        ExecSQL;
      End;

      With qryDoc Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL('NOTDET', 'DET_'));
        pSetaParametros(qryDoc, strNumDoc, strEspDoc, strCodEmp, strCodCli, strNumFat, strTipFat, strEmpFat, strVenFat, strCndFat, strCliFat, fltValFat);
        ExecSQL;
      End;

      Result := True;

    Except
      On E: Exception Do
        Raise Exception.create('TFatVenda.fMarcaDocDemonstracaoDevolvido - fMarcaDevolvido' + E.message);
    End;

    FreeAndNil(qryDoc);

  End;

Begin

  blnConfirma := False;

  Try

    With cdsDocDem Do
    Begin
      Filter   := 'MARDES = ''M''';
      Filtered := True;
      First;

      While Not Eof Do
      Begin
        blnConfirma := fMarcaDevolvido(FieldByName('NUMDOC').AsString,
                                       FieldByName('ESPDOC').AsString,
                                       FieldByName('CODEMP').AsString,
                                       FieldByName('CODCLI').AsString,
                                       strNumFat,
                                       strTipFat,
                                       strEmpFat,
                                       strVenFat,
                                       strCndFat,
                                       strCliFat,
                                       fltValFat);

        If (Not blnConfirma) Then
          Break;

        Next;
      End;

      Filter   := '';
      Filtered := False;

    End;

    Result := blnConfirma;

  Except
    On E: Exception Do
      Raise Exception.create('TFatVenda.fMarcaDocDemonstracaoDevolvido' + E.message);
  End;

End;

function TFatVenda.fMarcaProdutoComoJaExpedido(strAutFdo: String; fltQtdIte: Double): Boolean;
  var
    qryAux: TUniQuery;
begin
  Result := True;
  Try
    Try
      qryAux := fCriaQuery(Self);

      With qryAux Do
      Begin
        SQL.Add('UPDATE ');
        SQL.Add('  EXTDOR ');
        SQL.Add('SET ');
        SQL.Add('  FDO_QTDEXP = :QTDEXP ');
        SQL.Add('WHERE ');
        SQL.Add('  FDO_SEQFDO = :SEQFDO ');

        ParamByName('QTDEXP').AsFloat  := fltQtdIte;
        ParamByName('SEQFDO').AsString := strAutFdo;

        ExecSQL;
        Close;
      End;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, 'fMarcaProdutoComoJaExpedido');
      End;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

function TFatVenda.fGravaNumsCmp(fstrAutIncFatGor: String): Boolean;
  Var
    intCnt: Integer;
    qryTmp: TUniQuery;
Begin
  Result := True;
  qryTmp := fCriaQuery;
  Try
    Try
      qryTmp.SQL.Text := 'SELECT * FROM NUMCMP WHERE 0';
      qryTmp.Open;

      For intCnt := Low(npcNumCmp) To High(npcNumCmp) Do
      Begin
        qryTmp.Insert;
        qryTmp.FieldByName('AUTOINCREM').AsString := fRetAutoIncrem('NUMCMP', strEmpFatGor);
        qryTmp.FieldByName('CMP_NUMDOC').AsString := strNumDoc;
        qryTmp.FieldByName('CMP_ESPDOC').AsString := strEspDoc;
        qryTmp.FieldByName('CMP_CODEMP').AsString := strEmpFatGor;
        qryTmp.FieldByName('CMP_CODCLI').AsString := strCodCli;
        qryTmp.FieldByName('CMP_NUMCMP').AsString := String(npcNumCmp[intCnt].NumCmp);
        qryTmp.FieldByName('CMP_SEQGER').AsString := fstrAutIncFatGor;

        if (npcNumCmp[intCnt].DtaCmp = 0) then
          qryTmp.FieldByName('CMP_DTACMP').Value := Null
        else
          qryTmp.FieldByName('CMP_DTACMP').AsDateTime := npcNumCmp[intCnt].DtaCmp;

        qryTmp.Post;
      End;

      qryTmp.Close;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TFatVenda.fGravaNumsCmp]');
      End;
    End;
  Finally
    FreeAndNil(qryTmp);
  End;
End;

function TFatVenda.fBuscaNumsCmp(strNumDoc, strEspDoc, strCodCli, strCodEmp: String): TNumerosPedidoCompras;
  Var
    intCnt : Integer;
    qryTmp : TUniQuery;
Begin
  Result := Nil;

  qryTmp := fCriaQuery(Nil);

  Try
    With qryTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('   SELECT                        ');
      SQL.Add('     CMP_NUMCMP,                 ');
      SQL.Add('     CMP_DTACMP                  ');
      SQL.Add('   FROM                          ');
      SQL.Add('     NUMCMP                      ');
      SQL.Add('   WHERE CMP_NUMDOC = :NUMDOC    ');
      SQL.Add('     AND CMP_ESPDOC = :ESPDOC    ');
      SQL.Add('     AND CMP_CODCLI = :CODCLI    ');
      SQL.Add('     AND CMP_CODEMP = :CODEMP    ');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      intCnt := 0;

      If RecordCount > 0 Then
      Begin
        strNumCmp := '';
        SetLength(Result, RecordCount);

        First;
        While Not Eof Do
        Begin
          Result[intCnt].NumCmp := ShortString(FieldByName('CMP_NUMCMP').AsString);
          Result[intCnt].DtaCmp := FieldByName('CMP_DTACMP').AsDateTime;
          Inc(intCnt);

          If (Not strNumCmp.Contains(FieldByName('CMP_NUMCMP').AsString)) Then
          Begin
            If (fEmptyStr(strNumCmp)) Then
              strNumCmp := FieldByName('CMP_NUMCMP').AsString
            Else
              strNumCmp := strNumCmp + ', ' + FieldByName('CMP_NUMCMP').AsString;
          End;

          Next;
        End;

      End;

      Close;
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[TFatVenda.fBuscaNumsCmp]');
  End;

  FreeAndNil(qryTmp);
End;

function TFatVenda.fBuscaTipPed(strNumDoc, strEspDoc,
  strCodEmp: string): string;
var
  qryConsulta: TUniQuery;
begin
  qryConsulta := fCriaQuery;
  try
    Result := '';

    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add('SELECT FGO_TIPPED');
    qryConsulta.SQL.Add('FROM FATGOR');
    qryConsulta.SQL.Add('WHERE FGO_CODEMP = :CODEMP');
    qryConsulta.SQL.Add('AND FGO_NUMDOC = :NUMDOC');
    qryConsulta.SQL.Add('AND FGO_ESPDOC = :ESPDOC');

    qryConsulta.ParamByName('CODEMP').AsString := strCodEmp;
    qryConsulta.ParamByName('NUMDOC').AsString := strNumDoc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspDoc;

    qryConsulta.Open;

    if not qryConsulta.IsEmpty then
    begin
      Result := qryConsulta.FieldByName('FGO_TIPPED').AsString;
    end;
  finally
    FreeAndNil(qryConsulta);
  end;
end;

{*************************************************************************}
{* Esta função verifica de tem algum produto com a margem em dinheiro    *}
{* negativa (igual a tela de liberacao pedidos "frmCtrLiberaPedidosConf")*}
{**********************************************************************JC*}
function TFatVenda.fTemProdutosComMargemEmDinheiroNegativa: Boolean;
  var
    intIndex: Integer;

  function fMargemDinheiro(const item: TDadosFechamento): Double;
  begin
    Result := item.fltTotIte - item.fltDesEsp - (item.fltQtdIte * item.fltCusIte) - item.fltValIcm;
  end;

begin
  Result := False;
  For intIndex := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If fMargemDinheiro(arrMatItens[intIndex]) < 0 Then
    Begin
      Result := True;
      Break;
    End;
  End;
end;

function TFatVenda.fTemRegistroFdoSep: Boolean;
  Var
    qryFdo: TUniQuery;
begin
  qryFdo := fCriaQuery;
  Try
    qryFdo.SQL.Add('SELECT COUNT(1)');
    qryFdo.SQL.Add('  FROM FDOSEP');
    qryFdo.SQL.Add(' WHERE FDO_CODEMP = :CODEMP');
    qryFdo.SQL.Add('   AND FDO_NUMDOC = :NUMDOC');

    qryFdo.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryFdo.ParamByName('NUMDOC').AsString := strNumDoc;
    qryFdo.Open;

    Result := qryFdo.Fields[0].AsInteger > 0;
  Finally
    FreeAndNil(qryFdo);
  End;
end;

function TFatVenda.fSomenteItensDeEmpresasCD: Boolean;
begin
  With cdsVenda Do
  Begin
    DisableControls;

    Result := Not IsEmpty;

    First;

    While Not EOF Do
    Begin
      If (Not fEhEmpresaCD(FieldByName('ITE_EMPITE').AsString)) Then
      Begin
        Result := False;
        Break;
      End;
      Next;
    End;

    First;

    EnableControls;
  End;
end;

function TFatVenda.fSomenteItensDeServico(Itens: TMatrizFechamento): Boolean;
  Var
    item: TDadosFechamento;
begin
  Result := Length(Itens) > 0;
  For item In Itens Do
    If Not fEhItemServico(item.strCodIte) Then
    Begin
      Result := False;
      Break;
    End;
end;

procedure TFatVenda.pDeletaItemServicoMatriz;
Var
  arrMatIteTmp: TMatrizFechamento;
  intContador : Integer;
Begin

  Try

    If (Length(arrMatItens) = 0) Then
      Exit;

    If (fPossuiBrindeServico()) Then
      Exit;

    SetLength(arrMatIteTmp, 0);

    For intContador := 0 To (Length(arrMatItens) - 1) Do
    Begin
      If Not fEhItemServico(arrMatItens[intContador].strCodIte) Then
      Begin
        SetLength(arrMatIteTmp, (Length(arrMatIteTmp) + 1));
        arrMatIteTmp[Length(arrMatIteTmp) - 1] := arrMatItens[intContador];
      End;
    End;

    SetLength(arrMatItens, 0);

    For intContador := 0 To (Length(arrMatIteTmp) - 1) Do
    Begin
      SetLength(arrMatItens, (Length(arrMatItens) + 1));
      arrMatItens[Length(arrMatItens) - 1] := arrMatIteTmp[intContador];
    End;

  Except
    On E: Exception Do
      pMensagensErro(e.message, '[pDeletaItemServicoMatriz]');
  End;

End;

procedure TFatVenda.pDeletaProser(strCodIte, strCodEmp, strNumDoc,
  strNumSer: string);
var
  qryProser: TUniQuery;
  strSQL: string;
begin
  try
    strSQL := '';
    strSQL := strSQL + 'DELETE FROM PROSER ';
    strSQL := strSQL + 'WHERE SER_CODITE = :CODITE ';
    strSQL := strSQL + 'AND SER_NUMSER = :NUMSER ';
    strSQL := strSQL + 'AND SER_CODEMP = :CODEMP ';
    If Not fEmptyStr(strNumDoc) Then
      strSQL := strSQL + 'AND SER_NUMDOC = :NUMDOC ';

    qryProser := fCriaQuery(nil);
    qryProser.Close;
    qryProser.SQL.Clear;
    qryProser.SQL.Add(strSQL);
    qryProser.ParamByName('CODITE').AsString := strCodIte;
    qryProser.ParamByName('NUMSER').AsString := strNumSer;
    qryProser.ParamByName('CODEMP').AsString := strCodEmp;
    If Not fEmptyStr(strNumDoc) Then
      qryProser.ParamByName('NUMDOC').AsString := strNumDoc;
    qryProser.ExecSQL;
  finally
    FreeAndNil(qryProser);
  end;
end;

function fPermiteEditarDesconto(strOpcDoc, strPromoc: String; blnCliFil, blnItemVidro,
  blnEhDevFor, blnProCnd: Boolean; blnCondicaoEspecial : Boolean = False): Boolean;
begin
  Result := False;

  If blnItemVidro Then
    Exit

  Else If Not (fCfgSis('FATUDE', varBoolean)) Then
    Exit

  Else If Pos(strOpcDoc, 'BR_UC_') > 0 Then
    Exit

  Else If (strOpcDoc = 'EP') Then
    Exit

  Else If blnCliFil Then
    Exit

  Else If (strPromoc = 'S') And (Not fCfgSis('EDIUNP', VarBoolean)) Then
    Exit

  Else If blnEhDevFor Then
    Exit

  Else If fCfgSis('DESCND',varBoolean) And (Pos(strOpcDoc, 'OR_PD_VN_CP_CF_CI_') > 0) Then
    Exit

  Else If (strPromoc = 'S') And (blnProCnd) And (fDestacarDescontoDaCondicaoPagamentoNoCampoDescontoDosItensEmPromocao) Then
    Exit

  Else if (blnCondicaoEspecial) then
    Exit;

  Result := True;
end;

function fPermiteEditarPrecoUnitario(strOpcDoc, strCodCnd, strCodCli, strPromoc,
  strTabPre: String; blnEdUnF4, blnItemVidro, blnEhDevFor: Boolean; var blnApenasUnitarioAcimaDoSugerido: Boolean; blnCampanha : Boolean = False;
  blnCondicaoEspecial : Boolean = False; blnCarregandoEstruturaRateandoValorSugeridoSubItens: Boolean = False;
  blnNEFornecedor: Boolean = False): Boolean;
  Var
    blnPflCli: Boolean;
    blnCndVenFim: Boolean;
begin
  blnApenasUnitarioAcimaDoSugerido := False;

  If Not fValidaEscala(strTabPre, 1, 7) Then
    strTabPre := '1';

  Result := False;

  blnPflCli := fCfgSis('PFLCLI', varBoolean);
  blnCndVenFim := fCfgSis('CNDVEN', VarString) = 'F';

  If blnItemVidro Then
    Exit

  Else If ((fClienteFilial(strCodCli)) And (Pos(strOpcDoc, 'OR_PD_VN_OU_OV_TE_') > 0)) Then
  Begin
    If (fCfgSis('EDUNFI', varBoolean)) Then
      Exit
  End

  Else If (Pos(strOpcDoc, 'BR_UC_') > 0) Then
  Begin
    If (Not fCfgSis('UNIBRI', varBoolean)) Then
      Exit
  End

  Else If (Pos(strOpcDoc,'DV_PR') > 0) Then
  Begin
    If (Not fCfgSis('PREDEV', varBoolean)) Then
      Exit;

    If (fCfgSis('ESPDEV', varBoolean)) Then
      Exit;
  End

  Else If (Not blnEdUnF4) And ((VS_strEdUnTb[strToInt(strTabPre)] = 'N') And (Not blnNEFornecedor)) And ((Not blnPflCli) Or (blnCndVenFim)) Then
    Exit

  Else If (Not blnEdUnF4) And (blnPflCli) And ((Not fRetCampoCndPagto(strCodCnd, 'CND_ALTPRE')) And (Not blnCndVenFim)) Then
  Begin
    If (strPromoc = 'S') then
    Begin
      if not((fCampoTabela('CND_ALTPRE','CADCND', ['CND_CODIGO'], [strCodCnd], False) = 'P') and
             (fCfgSis('EDIUNP', VarBoolean))) then
        Exit;
    end
    Else
      Exit;
  End

  Else If (strPromoc = 'S') And ((Not fCfgSis('EDIUNP', VarBoolean)) and (Not blnNEFornecedor)) Then
    Exit

  Else If (blnEdUnF4) And (Not fCfgSis('EDUNF4', varBoolean)) Then
    Exit

  Else If blnEhDevFor Then
    Exit

  Else If (strOpcDoc = 'MF') Then
    Exit

  Else If fCfgSis('DESCND',varBoolean) And (Pos(strOpcDoc, 'OR_PD_VN_CP_CF_CI_') > 0) Then
    Exit

  Else If blnCampanha Then
    Exit

  Else If (Not fCfgSis('DESICF', varBoolean)) And (strOpcDoc = 'CF') Then
    Exit

  Else if (blnCondicaoEspecial) Then
    Exit;


  Result := True;

  If (Not blnCarregandoEstruturaRateandoValorSugeridoSubItens) Then
    blnApenasUnitarioAcimaDoSugerido := (Result) And (blnPflCli) And (Not blnCndVenFim) And (fCampoTabela('CND_ALTPRE','CADCND', ['CND_CODIGO'], [strCodCnd], False) = 'C');
end;

function TFatVenda.fBloqueiaCupomComFreteQuandoSATouNFCE: Boolean;
begin
  Result := False;

  If fUsaSat Then
    Result := True;
      
  If (Not Result) Then
    If (fCfgSis('USNFCE', varBoolean)) Then
      If (Not Self.fPermiteFreteNoCupomFiscal) Then
        Result := True;
end;

function TFatVenda.fPermiteFreteNoCupomFiscal: Boolean;

  function fVaiEmitirNotaFiscalParaTodosItensDeEntrega: Boolean;
    var
      item: TDadosFechamento;
  begin

    Result := True;

    For item In arrMatItens Do
    Begin

      {
       Obs: Aqui não é validado "frete > 0" essa validação fica
       por conta de quem invoca essa função. Por isso consideramos aqui
       a existência do valor do frete.
      }

      {Exceção 01 - Não é permitido emitir cupom de entrega para mesma loja com frete}
      If (fCfgSis('CUPENT', varInteger) = 2) And
         (item.strEntFut = 'N') And
         (item.strEntRet = 'E') And
         (item.strEmpIte = VS_strCodEmp) Then
      Begin
        Result := False;
      End;

      {Exceção 02 - Não é permitido emitir cupom de entrega futura para mesma loja com frete}
      If (fCfgSis('CUPNOT', varInteger) = 2) And
         (item.strEntFut = 'S') And
         (item.strEntRet = 'E') And
         (item.strEmpIte = VS_strCodEmp) Then
      Begin
        Result := False;
      End;

    End;

  end;

begin

  Result := False;

  If fCfgSis('USNFCE', varBoolean) Then
  Begin
    If Not fCfgSis('FRECUP', VarBoolean) Then
      Result := fCfgSis('FRENFC', varBoolean) or fCfgSis('FR2NFC', varBoolean);

    If Not Result and fCfgSis('FREDES', varBoolean) Then
      Result := True;
  End
  Else
    Result := (Not fUsaSat) And
              (((VS_strSimPau = 'S') And fCfgSis('IF_FRE', VarBoolean)) Or fCfgSis('FRECUP', VarBoolean));

  If (Self.strEspDoc = 'IF') And fTemItensEntrega(Self.arrMatItens) And fVaiEmitirNotaFiscalParaTodosItensDeEntrega Then
    Result := True;

end;

function TFatVenda.fGetProximaNF: String;
begin
  Result := untFuncoesSimples.fCfgSisL('PRO_NF');
