function TFatVenda.fUnitarioMinimo(strCodIte, strTabelaPreco: String; fltQtdIte: Double; fltUnitarioOriginal: Double = 0): Double;
  Var
    fltDesMax : Double;
begin
  If (fltUnitarioOriginal = 0) Then
    Result := Self.fltUniOri
  Else
    Result := fltUnitarioOriginal;

  If (Self.strCAbDes = 'S') And
     (fCfgSis('CNDVEN') = 'I') And
     ((Self.strPromoc <> 'S') Or
      (fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) Then
  Begin
    fltDesMax := Self.fRetornaDescLinGru(strCodIte, Self.strCodCnd);

    If (Self.strCodFpg = '007') Then
    Begin
      If (Self.strAbDeCc = 'S') Then
        Result :=  Result - Self.fRetornaVrDesconto(2, Result, fltDesMax);
    End
    Else
      Result := Result - Self.fRetornaVrDesconto(2, Result, fltDesMax);
  End;

  If fEhEmbalagemFechadaItem(strCodIte, strTabelaPreco, fltQtdIte) And (Self.strPromoc <> 'S') Then
    Result := ( Result * ( 1 - ( fPercDescEmbalagemFechadaItem(strCodIte, strTabelaPreco, fltQtdIte, '') / 100 ) ) );
end;

procedure TFatVenda.pAtualizaDataLanctoAdiantamento(const intSeqConAdiant: Integer; const strCodEmp : String; const dtDataMovBancaria : TDatetime; const strSeqBan : String);
var
  qryUpdDtMov : TUniQuery;
begin
  qryUpdDtMov := fCriaQuery;
  try
    qryUpdDtMov.Close;
    qryUpdDtMov.SQL.Add(' UPDATE ADTCLI ');
    qryUpdDtMov.SQL.Add('    SET ADT_DTABAN = :DTAMOV ');
    If (Not fEmptyStr(strSeqBan)) Then
    Begin
      qryUpdDtMov.SQL.Add('     ,ADT_SEQBAN = :SEQBAN ');
      qryUpdDtMov.ParamByName('SEQBAN').AsString := strSeqBan;
    End;
    qryUpdDtMov.SQL.Add(' WHERE '+
                        '   ADT_SEQCON = :SEQCON AND '+
                        '   ADT_CODEMP = :CODEMP ');
    qryUpdDtMov.ParamByName('DTAMOV').AsDatetime := dtDataMovBancaria;
    qryUpdDtMov.ParamByName('SEQCON').AsInteger  := intSeqConAdiant;
    qryUpdDtMov.ParamByName('CODEMP').AsString   := strCodEmp;
    qryUpdDtMov.ExecSql;
  finally
    FreeAndNil(qryUpdDtMov);
  end;
end;

function TFatVenda.fGravarAdiantamentoPedidoPeloF11(pgbStatus: TcxProgressBar): Boolean;
  Var
    intContador: Integer;
    objGryncash: TGryncash;
    strMSGTravaCaixa : String;
    LlstPixPago: TList<TDadosRetornoPixConsulta> ;
    LPixPago: TDadosRetornoPixConsulta ;

  function fAtualizaDadosConsumidor: Boolean;
  begin
    Result := True;

    Try
      pAtualizaDadosConsumidor(strNumDoc, strEspDoc, strEmpDoc, strCodCli,
        strCliCgc, strCliNom, strCliEnd, strCliBai, strCliCep, strCodCid,
        strCliEst, strCliTel, IntToStr(intCgcCpf), strCliIes, strCli_Rg,
        strCliEma, strCodAti, dtaNasCon);
    Except
      Result := False;
    End;
  end;
begin
  Result := True;

  fAjustaDataSistema;

  Self.pgbStatusGravacao := pgbStatus;

  Self.strNumDoc := strNumOrc;

  pInfoStatusGravacao('Aguarde... Iniciando Gravação');

  If not (Length(strNumOrc) = 12) Then
  Begin
    If fInTransaction Then
      fRollBack;

    Result := False;

    fMensagem('', 'Número do pedido inválido ['+strNumOrc+'], verifique e tente novamente !', ['&OK']);
    Exit;
  End;

  If fCaixaJaFoiFechado(strMSGTravaCaixa) Then
  Begin
    If fInTransaction Then
      fRollBack;;

    Result := False;

    fMensagem('', strMSGTravaCaixa, ['&OK']);
    Exit;
  End;

  intSeqConRcx := StrToInt(fRetRcxCon(strEmpLog));
  fRetSequencialMovCar('MOVCAR', VS_strCodEmp, arrCartoes);

  pDefineVariaveisSeGravaCaixa;

  If blnCfgGravaResCai And blnValGravaResCai Then
  Begin
    If Not objResumoDeCaixa.fVerificaSaldoMaximo(fltValDin, fGetOperadorDaBaixa, strCodigoCaixa, False) Then
    Begin
      If fInTransaction Then
        fRollBack;

      Result := False;

      Exit;
    End;
  End;

  If (blnComTansacao) Then
  Begin
    VS_strAllErrorsMessages := '';
    fStartTransaction;
  End;

  pInfoStatusGravacao('Aguarde... Gravando Adiantamento do Pedido');

  {*****************************************}
  {* PD - Pedido (Somente adiantamento)    *}
  {**************************************JC*}
  If (Not fGCadRec) Then
  Begin
    If fInTransaction Then
      fRollBack;

    Result := False;

    Exit;
  End;

  If Not fGravarResumoDeCaixa Then
  Begin
    If fInTransaction Then
      fRollBack;

    Result := False;

    Exit;
  End;

  {******************************************}
  {* GRAVANDO/BAIXANDO O PIX DO RECEBIMENTO *}
  {***************************************AJ*}
  If DadosPixDaVenda.RecebidoPorPix = 'S' Then
  Begin
    pInfoStatusGravacao('Aguarde... Gravando Pix do Recebimento');

    Try
      LlstPixPago := fRetornaLstPixPago ;
      for LPixPago in LlstPixPago do
      begin
        LPixPago.SeqConRecebimento := intSeqConRcx;

        If DadosPixDaVenda.PixJaLancadoMOVPIX <> 'S' Then
        Begin
          If blnCfgGravaResCai And blnValGravaResCai Then
            LPixPago.SeqConTransferencia := StrToInt(fRetRcxCon(strEmpLog));

          If Not DadosPixDaVenda.TxIdPix.IsEmpty Then
          Begin
            If MatchStr(TPixDao.RetornaStatusSePedidoPossuirPix(DadosPixDaVenda.EmpresaDoPix, DadosPixDaVenda.TxIdPix), STATUS_PIX_PAGO) Then
              Raise ExceptionAutCom.Create('A cobrança Pix QRCode desse pedido já foi recebida pelo Autcom.' + #13 +
                                           'Recarregue-o para atualizar os dados.');
          End;

          TFuncoesPixAutcom.GravarRegistroPixBaixadoFaturamento(LPixPago,
                                                                DadosPixDaVenda.TxIdPix.IsEmpty,
                                                                blnCfgGravaResCai And blnValGravaResCai,
                                                                blnCfgGravaResCai And blnValGravaResCai,
                                                                fGetOperadorDaBaixa,
                                                                strNomeForm,
                                                                IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog));

          If (blnRealizandoAdiantamentoPedidoPeloF11) Then
            pAtualizaDataLanctoAdiantamento(
              LPixPago.SeqConRecebimento,
              IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
              LPixPago.DataGravacaoMovBan, LPixPago.SeqLanTransferencia);

        End ;
      End;
      DadosPixDaVenda.PixJaLancadoMOVPIX := 'S';
    Except
      On E: Exception Do
      Begin
        If fInTransaction Then
        Begin
          fRollBack;
          DadosPixDaVenda.PixJaLancadoMOVPIX := 'N';
        End;

        If E Is ExceptionAutCom Then
          fMensagem('ATENÇÃO', E.Message, ['&Ok'])
        Else
          pMensagensErro(E.Message, '[TFatVenda.fGravarAdiantamentoPedidoPeloF11]');

        Exit(False);
      End;
    End;
  End;

  {*******************************************}
  {* RESTAURA A DIGDUPLIC                    *}
  {****************************************MV*}
  For intContador := 0 To 11 Do
    arrDuplicata[intContador] := arrDuplicCop[intContador];

  {*******************************}
  {* ANALISA GRAVAÇÃO DO CAIXA   *}
  { *26/02/2015*REQ:22285*******AF* }
  If Not fAnalisaGravacaoCaixa Then
  Begin
    If fInTransaction Then
      fRollBack;

    Result := False;

    Exit;
  End;

  {*******************************************}
  {* GRAVA OS DADOS DO CONSUMIDOR FINAL      *}
  {****************************************FS*}
  If Not fAtualizaDadosConsumidor Then
  Begin
    If fInTransaction Then
      fRollBack;

    Result := False;
    Exit;
  End;

  {*************************************************}
  {* SALVA O VALOR NA CSHBCK DO CASHBACK UTILIZADO *}
  {***********************************************BL}
  if (blnSalGry) and
     (fCfgSis('USAGRY') = 'S') then
  begin
    objGryncash := TGryncash.Create(Self);
    try
      if not objGryncash.fSalvaCashBack(VS_strCodEmp, strEspOrc, strNumOrc, fltCshGry) then
      begin
        If fInTransaction Then
          fRollBack;

        Exit(False);
      end;
    finally
      FreeAndNil(objGryncash);
    end;
  end;

  { COMITA }
  If (blnComTansacao) Then
  Begin
    fCommit;
    Self.blnGravouDocumentos := True;
  End;
end;

function TFatVenda.fGravarPreparacaoRQ: Boolean;
  Var
    objRequisicoes: TPreparaRequisicaoCompra;
begin
  Result := True;

  If (cdsMovRcd.IsEmpty) Then
    Exit;

  If Not fRealizaGeracao_TE_RQ_MultiLoja Then
    Exit;

  Try
    cdsMovRcd.DisableControls();
    cdsMovRcd.Filtered := False;
    cdsMovRcd.Filter   := ' (RCD_EMPITE = ' + QuotedStr(arrMatItens[0].strEmpIte) + ') ';
    cdsMovRcd.Filtered := True;

    objRequisicoes := TPreparaRequisicaoCompra.Create();

    Try
      cdsMovRcd.First();

      While (Not cdsMovRcd.Eof) Do
      Begin
        objRequisicoes.pAdicionarItemRequisicao(
                TItemRequisicaoCompra.Create('',
                                             cdsMovRcd.FieldByName('RCD_EMPITE').AsString,
                                             strLoginUsuarioLogado,
                                             cdsMovRcd.FieldByName('RCD_CODITE').AsString,
                                             '',
                                             strNumDoc,
                                             strEspDoc,
                                             IIF(blnFinali, strPedEmp, IIF(Not fOrcamentoOutraLojaF11, strPedEmp, IIF(fEmptyStr(strEmpOri), strPedEmp, IIF((strEspDoc <> strEspOrc), strPedEmp, strEmpOri)))),
                                             cdsMovRcd.FieldByName('RCD_OBSERV').AsString,
                                             cdsMovRcd.FieldByName('RCD_QTDITE').AsFloat,
                                             VS_Date,
                                             fTime())
              );

        cdsMovRcd.Next();
      End;

      Result := objRequisicoes.fGravarRequisicao();
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TFatVenda.fGravarPreparacaoRQ]');
      End;
    End;
  Finally
    FreeAndNil(objRequisicoes);

    cdsMovRcd.EnableControls();
    cdsMovRcd.Filtered := False;
    cdsMovRcd.Filter   := '';
  End;
end;

function TFatVenda.fGravarPreparacaoTE: Boolean;
  Var
    intIndLoj: Integer;
    strAutIncTe: String;
begin
  Result := True;

  If (Not Assigned(objSoliTE)) Or (objSoliTE.cdsItens.IsEmpty) Then
    Exit;

  If Not fRealizaGeracao_TE_RQ_MultiLoja Then
    Exit;

  Try
    With objSoliTE Do
    Begin
      For intIndLoj := 0 To Length(arrMatItens) - 1 Do
      Begin
        If (arrMatItens[intIndLoj].opcTipAbs = oaSolicitTransf) And
           (arrMatItens[intIndLoj].blnPodAlt) Then
        Begin
          arrMatItens[intIndLoj].strEmpSol := fGetEmpresa(arrMatItens[intIndLoj].intAutInc);
          arrMatItens[intIndLoj].fltQtdSol := fGetQtdSolicitada(arrMatItens[intIndLoj].intAutInc);
          arrMatItens[intIndLoj].strLotAba := fGetLote(arrMatItens[intIndLoj].intAutInc);

          Result := TPreparaGeracaoTE.fGravarPreparaGeracaoTE_MultiLoja(strNumDoc,
                                                                        strEspDoc,
                                                                        strEmpDoc,
                                                                        arrMatItens[intIndLoj].strCodIte,
                                                                        arrMatItens[intIndLoj].strEmpSol, //Empresa Origem
                                                                        arrMatItens[intIndLoj].strEmpIte, //Empresa Destino
                                                                        arrMatItens[intIndLoj].strLotAba,
                                                                        arrMatItens[intIndLoj].fltQtdSol,
                                                                        strAutIncTe);

          If (Not Result) Then
            Break;
        End;
      End;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[TFatVenda.fGravarPreparacaoTE]');
    End;
  End;
end;

procedure TFatVenda.LancarTFAutomaticaOrdemPagamento(ASeqConBaixa: Integer;
  AAutoIncremRecebimento, ARecebidoPorPix: String);
  Var
    LRealizadaGravacao: Boolean;
    LDataMovimentacaoBancaria : TDateTime;
    LResumoDeCaixa: TResumoDeCaixa;
Begin
  LResumoDeCaixa := TResumoDeCaixa.Create;

  Try
    If Not LResumoDeCaixa.TransferenciaOrdemPagamentoAutomaticaFaturamento Then
      Exit;

    If fFormataFloat(Self.FValorTFAutomatica, 2) = 0 Then
      Exit;

    If Self.FPortadorTFAutomatica.IsEmpty Then
      Exit;

    If Self.FSeqconTFAutomatica = 0 Then
      Self.FSeqconTFAutomatica := StrToInt(fRetRcxCon(strEmpLog));

    LRealizadaGravacao := LResumoDeCaixa.InserirRegistroTFOrdemPagtoCaixa(fGetOperadorDaBaixa,
                                                                          IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
                                                                          Self.VS_Date,
                                                                          Self.FValorTFAutomatica,
                                                                          Self.strCodigoCaixa,
                                                                          Self.FSeqconTFAutomatica,
                                                                          ASeqConBaixa,
                                                                          ARecebidoPorPix,
                                                                          Self.FPortadorTFAutomatica);
    If LRealizadaGravacao Then
      LRealizadaGravacao := LResumoDeCaixa.InserirRegistroTFOrdemPagtoNaMOVBAN(fGetOperadorDaBaixa,
                                                                               IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
                                                                               Self.VS_Date,
                                                                               Self.FValorTFAutomatica,
                                                                               Self.strCodigoCaixa,
                                                                               IIF(Self.blnCliConF11, EmptyStr, Self.strCodCli),
                                                                               Self.FSeqconTFAutomatica,
                                                                               Self.FPortadorTFAutomatica,
                                                                               Self.strNomeForm,
                                                                               AAutoIncremRecebimento,
                                                                               Self.FstrAutoIncCadRec);

    If (LRealizadaGravacao) And (blnRealizandoAdiantamentoPedidoPeloF11) Then
    Begin
      LDataMovimentacaoBancaria := LResumoDeCaixa.RetornaDataMovimentacaoBancariaTransferenciaAutomatica(Self.FPortadorTFAutomatica, Self.VS_Date);
      TAdiantamento.pAtualizaDataLanctoAdiantamento(ASeqConBaixa, IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog), LDataMovimentacaoBancaria, LResumoDeCaixa.SeqLanTransferencia, True);
    End;

    If Not LRealizadaGravacao Then
      Raise Exception.Create('Não foi possível realizar a gravação da transferência automática de ordem de pagamento.');

    Self.FValorTFAutomatica := 0;
  Finally
    FreeAndNil(LResumoDeCaixa);
  End;
End;

function TFatVenda.RecebidoPorPixOuPixAvulso(ADataRecebimento: TDateTime;
  AValidaAdiantamento: Boolean = False): String;
Begin
  Result := 'N';

  If ADataRecebimento = 0 Then
    Exit;

  Result := Self.DadosPixDaVenda.RecebidoPorPix;
  If Not Result.Equals('S') Then
    Result := Self.FPixAvulso;

  If Result.Equals('S') Then
    Exit;

  If Not AValidaAdiantamento Then
    Exit;

  If Self.fltValAdt > 0 Then
    Result := AdiantamentoDoPedidoRecebidoPorPix;
End;

function TFatVenda.fVaiBaixarParcelaAVista: Boolean;
begin
  Result := (fConPagComEntrada(strConPag)) And
            (fBaixaDuplicataAVista(strEmpLog));
end;

function TFatVenda.fVaiBaixarOrdemPagamento: Boolean;
begin
  Result := (strCodFpg = '012') And
            ((fStatusCndPag(strConPag) = A_VISTA) Or 
             ((fStatusCndPag(strConPag) = A_PRAZO) And (fCfgSis('BAIOPG', varBoolean))) Or
             (Self.DadosPixDaVenda.RecebidoPorPix.Equals('S'))
            );
end;

function TFatVenda.fGravarResumoDeCaixa: Boolean;
  Var
    intContador: Integer;
    intContCopia: Integer;
    intContador2: Integer;

    fltTotalCaixa: Double;

    fltCarIpi,
    fltCarRet,
    fltCarAce,
    fltCarFre,
    fltCarCbs,
    fltCarIbs,
    fltCar_Is,
    fltFaturado,
    fltValCreUti: Double;

    strHisCar: String;
    strSeqRcx: String;

    strCodOpeCar : String;
    dtaDtaCadCar : TDateTime;

    objArredondaParcela: IArredondaParcela;

    arrDupFin,
    arrDupFat: TArrDigDuplicArray;

    arrDigFat,
    arrDigDup: TArrDigDuplic;

    arrDupCar,
    arrCopCar: TArrDigDuplicArray;

    arrDuplicCarIpi,
    arrDuplicCarRet,
    arrDuplicCarAce,
    arrDuplicCarFre,
    arrDuplicCarCbs,
    arrDuplicCarIbs,
    arrDuplicCar_Is: TArrDigDuplicArray;

    LDataBaseCartao: TDateTime;

    LRecebidoPorPix,
    LTipoParcelamento: String;

    function fTotGerRcx: Double;
    begin
      Result := Self.fltTotGer;

      If (Self.strEspDoc = 'NS') And
         (Self.fltValIss > 0.00) And (Self.strRetIss = 'S') And
         (fFormataFloat(Abs(Self.fltValCre), 2) > 0.00) Then
      Begin
        Result := Result - Self.fltValIss;
      End;
    End;

begin
  Result := True;

  {************************************}
  {* SE USA FORMA DE PAGAMENTO GRAVA  *}
  {* OS CHEQUES E CARTOES SE FOI      *}
  {* DIGITADO                         *}
  {*********************************AF*}
  If blnCfgGravaResCai Or blnNaoUsaResumoCaixaMasGravaChequeOuCartao Then
  Begin

    pInfoStatusGravacao('Aguarde... Gravando Resumo de Caixa');
    {***************************************}
    {* REALIZA GRAVAÇÃO DO RESUMO DE CAIXA *}
    {************************************AF*}
    If blnValGravaResCai Then
    Begin
      {******************************************************}
      {* ZERA O VALOR DO DINHEIRO, POIS O VALOR DA VARIÁVEL *}
      {* DINHEIRO É O VALOR DO CRÉDITO UTILIZADO.           *}
      {***************************************************PZ*}
      If (blnZerDin) And (Abs(fFormataFloat(fltValCre, 2)) > 0) And (fFormataFloat(fltValDin, 2) - fFormataFloat(Abs(fltValCre), 2) = 0) Then
      Begin
        fltValDin := 0;
      End;

      {***************************************}
      {* CASO ESCOLHEU TROCO, GRAVA NA MODA- *}
      {* LIDADE DINHEIRO.                    *}
      {************************************MV*}
      If (optTroco = otTroco) And (fltValorTroco > 0) Then
        fltValDin := fltValDin - fltValorTroco;

      If (optTrocoPre = otTroco) And (fltValorTrocoPre > 0) Then
        fltValDin := fltValDin - fltValorTrocoPre;

      If (optTrocoCar = otTroco) And (fltValorTrocoCar > 0) Then
        fltValDin := fltValDin - fltValorTrocoCar;

      If (optTrocoDinheiro = otTroco) And (fltValorTrocoDinheiro > 0) Then
        fltValDin := fltValDin - fltValorTrocoDinheiro;

      fltTotalCaixa := fltValCqP + fltValCqV + fltValDin + fltValCar + fltValOrd + fltValFin;

      If fEhVendaNormalNegociadaUtilizandoCreditoComBaixaDeDuplicataAVista Then
      Begin
        fltValDin := 0;
        fltValCre := 0;
      End;

      {*****************************************}
      {* CASO TENHA ALGUM VALOR INFORMADO, SI- *}
      {* GNIFICA QUE O CRÉDITO NÃO ULTRAPASSOU *}
      {* O VALOR DA COMPRA.                    *}
      {**************************************MV*}
      If (fFormataFloat(fTotGerRcx,2) > fFormataFloat(Abs(fltValCre),2)) Then
        fltTotalCaixa := fltTotalCaixa - fltValCre

      Else If (fFormataFloat(fTotGerRcx,2) <= fFormataFloat(Abs(fltValCre),2)) Then
      Begin
        If Not ((strEspDoc = 'TR') And (fTotGerRcx <= 0)) Then
        Begin
          fltValDin := 0;
          fltValCqV := 0;
          fltValCqP := 0;
          fltValCar := 0;
          fltValOrd := 0;
          fltValFin := 0;
        End;
      End;

      {*******************************************}
      {* QUANDO FOR CLASSIFICAÇÃO DE ENTRADA,    *}
      {* GRAVA NEGAVITO.                         *}
      {****************************************MV*}
      If (LeftStr(strClaFis, 1) < '5') And (strEspDoc <> 'TR') Then
      Begin
        fltTotalCaixa := -Abs(fltTotalCaixa);
        fltValDin := -Abs(fltValDin);
        fltValCqV := -Abs(fltValCqV);
        fltValCqP := -Abs(fltValCqP);
        fltValCar := -Abs(fltValCar);
        fltValOrd := -Abs(fltValOrd);
        fltValFin := -Abs(fltValFin);
        fltFatura := -Abs(fltFatura);
        fltVlARec := -Abs(fltVlARec);
      End;

      fltFaturado := fltFatura;
      {*********************************************}
      {* AJUSTA O VALOR A PRAZO NO RESUMO DE CAIXA *}
      {*********************************REQ 119439**}
      If (fVaiBaixarParcelaAVista) And (strCodFpg = '008') Then
        fltFaturado := fltFatura - fltValDin;

      If (fFormataFloat(fltTotalCaixa,2) = 0.00) And (fFormataFloat(Abs(fltValCre),2) > 0) Then
        fltTotalCaixa := Abs(fltValCre);

      fltValCreUti := fltValCre;
      If (fltCredUtilizados > 0) And (fltCredUtilizados < Abs(fltValCre)) Then
      Begin
        fltValCreUti := fltCredUtilizados * -1;

        If (strCodFpg = '009') And (Abs(fltValCre) > fltCredUtilizados) Then
          fltTotalCaixa := fltTotalCaixa - (Abs(fltValCre) - fltCredUtilizados);
      End;

      pInfoStatusGravacao('Aguarde... Gravando Resumo de Caixa');
      LRecebidoPorPix := RecebidoPorPixOuPixAvulso(Self.VS_Date);

      Result := fGravaCadRcx(strSeqRcx,
                             strCodCli,                                                         //Código do Cliente
                             fGetOperadorDaBaixa,                                               //Operador
                             strNumDoc,                                                         //Documento
                             strEspDoc,                                                         //Espécie
                             IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),                //Empresa
                             Self.VS_Date,                                                      //Data de Cadastro
                             fRetHoraServidor,                                                              //Hora de Cadastro
                             strNumDoc,                                                         //Duplicata
                             'A',                                                               //Parcela
                             strInfErro + strCodCli + '-' + IIF(fEmptyStr(strCliNom), strCliOri, strCliNom), //Descrição
                             '',                                                                //Juros / Dessconto
                             '',                                                                //Identificação de Fechamento
                             strCodFpg,                                                         //Forma de Pagamento
                             fltTotalCaixa,                                                     //Valor do Documento
                             0,                                                                 //Desconto Recebido
                             0,                                                                 //Juros Recebido
                             fltValDin,                                                         //Valor em dinheiro
                             fltValCqV,                                                         //Valor em Cheque à Vista
                             fltValCqP,                                                         //Valor em Cheque Pré
                             fltValCar,                                                         //Valor em Cartão
                             fltValOrd,
                             fltValCreUti,                                                      //Valor de Crédito de Cliente
                             fltValFin,                                                         //Valor da Ordem de Pagamento
                             0,                                                                 //Valor em outras modalidades
                             fltFaturado,                                                       //Valor de venda a prazo
                             '',                                                                //Num. do Romaneio
                             intSeqConRcx,                                                      //Sequencial de Controle
                             0,                                                                 //Sequencial de Baixa (Duplicata)
                             fCfgSisL('SQFCRX'),                                                 //Sequencial de Fechamento parcial de caixa
                             VS_strCodEmp,                                                      //Empresa da duplicata
                             '',                                                                //MotDes
                             IIF(Pos(strEspDoc, 'NF_EL_IF_IV_D1_') > 0, 1, 2),                     //Identificação do Caixa
                             0,0,0,0,0,
                             'N',
                             '',
                             strCodigoCaixa,
                             '',
                             0.00,
                             False,
                             0.00,
                             '',
                             0,
                             LRecebidoPorPix);

      FAuditoriaResumoCaixa.Adicionar(strSeqRcx, 'CADRCXX');

      If (Not Result) Then
        Exit;

      LancarTFAutomaticaOrdemPagamento(intSeqConRcx,
                                       strSeqRcx,
                                       LRecebidoPorPix);
    End;

    If (Not blnNaoUsaResumoCaixaMasGravaChequeOuCartao) Then
    Begin
      {***************************************}
      {* CASO ESCOLHEU CRÉDITO, GRAVA UM CRÉ-*}
      {* DITO NO RESUMO DE CAIXA.            *}
      {************************************MV*}
      If (optTroco = otCredito) And (fltValorTroco > 0)Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Crédito do Cliente');

        Result := fGravaCreditoCliente(foCheque, fltValorTroco, Self.blnTrocoComoCredito);

        If (Not Result) Then
          Exit;
      End;

      If (optTrocoPre = otCredito) And (fltValorTrocoPre > 0)Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Crédito do Cliente');

        Result := fGravaCreditoCliente(foChequePre, fltValorTrocoPre, Self.blnTrocoComoCredito);

        If (Not Result) Then
          Exit;
      End;

      If (optTrocoCar = otCredito) And (fltValorTrocoCar > 0)Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Crédito do Cliente');

        Result := fGravaCreditoCliente(foCartao, fltValorTrocoCar, Self.blnTrocoComoCredito);

        If (Not Result) Then
          Exit;
      End;

      If (optTrocoDinheiro = otCredito) And (fltValorTrocoDinheiro > 0)Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Crédito do Cliente');

        Result := fGravaCreditoCliente(foDinheiro, fltValorTrocoDinheiro, Self.blnTrocoComoCredito);

        If (Not Result) Then
          Exit;
      End;
    End;

    {*******************************************}
    {* REALIZA GRAVAÇÃO DO CARTÃO              *}
    {****************************************AF*}
    If (fCfgSis('USACTC', varBoolean)) And (Length(arrCartoes) > 0) Then
    Begin
      pInfoStatusGravacao('Aguarde... Gravando Cartões');

      FillChar(recTipCarMovMod,SizeOf(recTipCarMovMod),#0);

      For intContador := 0 To Length(arrCartoes) -1 Do
      Begin

        LTipoParcelamento := '';

        {$IFNDEF LINUX}
          LTipoParcelamento := fCampoTabela('CAR_ARRPAR', 'CADCAR', ['CAR_CODCAR'], [arrCartoes[intContador].strCodCar]);

          If (arrCartoes[intContador].strTipCar = 'POS') And (LTipoParcelamento <> 'N') Then
            objArredondaParcela := TArredondaParCartaoPos.fArredondamentoParcelas(arrCartoes[intContador].strCodCar)
          Else
            objArredondaParcela := fArredondamentoParcelas(arrCartoes[intContador].strCodCar);
        {$ELSE}
          objArredondaParcela := fArredondamentoParcelas(arrCartoes[intContador].strCodCar);
        {$ENDIF LINUX}

        If fEmptyStr(arrCartoes[intContador].strCodFin) Then
        Begin
          LDataBaseCartao := RetornaDataBaseCartao(VS_Date, arrCartoes[intContador].dtaDtaTra);

          fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, arrCartoes[intContador].fltValDig, False, False, False, LDataBaseCartao, False, arrDupCar, 0, 'N', False, False, 0, objArredondaParcela);

          SetLength(arrCopCar, Length(arrDupCar));
          For intContCopia := 0 To Length(arrDupCar) - 1 Do
            arrCopCar[intContCopia] := arrDupCar[intContCopia];

          fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, arrCartoes[intContador].fltValDes, False, False, False, LDataBaseCartao, False, arrDupCar, 0, 'N', False, False, 0, objArredondaParcela);
        End
        Else
        Begin
          LDataBaseCartao := RetornaDataBaseCartao(Self.VS_Date, arrCartoes[intContador].dtaDtaTra);

          fDigDuplicFinanceira(arrDupFat, arrCartoes[intContador].strCndPag, 0, arrCartoes[intContador].fltValDig, False, False, False, LDataBaseCartao, False, 0, 'N', False, False, 0, False, Nil, '', True, objArredondaParcela);
          fDigDuplicFinanceira(arrDupFin, arrCartoes[intContador].strCndPag, 0, arrCartoes[intContador].fltValDes, False, False, False, LDataBaseCartao, False, 0, 'N', False, False, 0, False, Nil, '', True, objArredondaParcela);
        End;

        Try
          fltCarIpi := fltTotIpi * (arrCartoes[intContador].fltValDig / fltTotCadRec);
          fltCarRet := fltTotRet * (arrCartoes[intContador].fltValDig / fltTotCadRec);
          fltCarAce := fltDesAce * (arrCartoes[intContador].fltValDig / fltTotCadRec);
          fltCarFre := fltValFre * (arrCartoes[intContador].fltValDig / fltTotCadRec);
          fltCarCbs := fltTotCBS * (arrCartoes[intContador].fltValDig / fltTotCadRec);
          fltCarIbs := fltTotIBS * (arrCartoes[intContador].fltValDig / fltTotCadRec);
          fltCar_Is := fltTotIS * (arrCartoes[intContador].fltValDig / fltTotCadRec);
        Except
          fltCarIpi := 0;
          fltCarRet := 0;
          fltCarAce := 0;
          fltCarFre := 0;
          fltCarCbs := 0;
          fltCarIbs := 0;
          fltCar_Is := 0;
        End;

        // Impostos
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCarIpi, False, False, False, LDataBaseCartao, False, arrDuplicCarIpi, 0, 'N', False, False, 0, objArredondaParcela);
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCarRet, False, False, False, LDataBaseCartao, False, arrDuplicCarRet, 0, 'N', False, False, 0, objArredondaParcela);
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCarAce, False, False, False, LDataBaseCartao, False, arrDuplicCarAce, 0, 'N', False, False, 0, objArredondaParcela);
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCarFre, False, False, False, LDataBaseCartao, False, arrDuplicCarFre, 0, 'N', False, False, 0, objArredondaParcela);
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCarCbs, False, False, False, LDataBaseCartao, False, arrDuplicCarCbs, 0, 'N', False, False, 0, objArredondaParcela);
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCarIbs, False, False, False, LDataBaseCartao, False, arrDuplicCarIbs, 0, 'N', False, False, 0, objArredondaParcela);
        fDigDuplicVar(arrCartoes[intContador].strCndPag, 0, fltCar_Is, False, False, False, LDataBaseCartao, False, arrDuplicCar_Is, 0, 'N', False, False, 0, objArredondaParcela);

        intContador2 := 0;

        While (fEmptyStr(arrCartoes[intContador].strCodFin) And (intContador2 < Length(arrDupCar)) And
               (Not fEmptyStr(arrDupCar[intContador2].strSequen))) Or
              ((Not fEmptyStr(arrCartoes[intContador].strCodFin)) And (intContador2 <= High(arrDupFin)) And
               (Not fEmptyStr(arrDupFin[intContador2].strSequen))) Do
        Begin

          If fEmptyStr(arrCartoes[intContador].strCodFin) Then
          Begin
            arrDigDup := arrDupCar[intContador2];
            arrDigFat := arrCopCar[intContador2];
          End
          Else
          Begin
            arrDigDup := arrDupFin[intContador2];
            arrDigFat := arrDupFat[intContador2];
          End;

          pSomaValoresPorTipoDeCartao(fRetTipoCartao(arrCartoes[intContador].strCodCar), arrDigFat.curValor);

          strHisCar := '';
          If Pos('DIVERSOS', fDocumeCartao(intContador)) <= 0 Then
            strHisCar := 'REF. AO DOC. ' + strNumDoc +  'A-' + strEspDoc + '-' + VS_strCodEmp;

          pInfoStatusGravacao('Aguarde... Gravando Movimentação de Cartões');

          strCodOpeCar := Self.strCodOpe;
          dtaDtaCadCar := Self.VS_Date;

          If (blnImpPafEcf) And (Not fEmptyStr(arrCartoes[intContador].strCodOpe)) Then
            strCodOpeCar := arrCartoes[intContador].strCodOpe;

          If (blnImpPafEcf) And (arrCartoes[intContador].dtaDtaCad <> 0) Then
            dtaDtaCadCar := arrCartoes[intContador].dtaDtaCad;

          Result := fGravaMovCar(IIF(blnNaoUsaResumoCaixaMasGravaChequeOuCartao, Self.strNomeForm, 'frmFatConfOrcamentos'),
                                 'INCLUSÃO',
                                 arrCartoes[intContador].strNumDup,
                                 strCodCli,
                                 arrDigDup.strSequen,
                                 fRetornaEmpresaMovCarMovModAoDesmembrarPedido(),
                                 arrCartoes[intContador].strCodCar,
                                 dtaDtaCadCar,
                                 StrToDate(arrDigDup.dtaDtaVen),
                                 arrDigDup.curValor,
                                 arrDigDup.curValor,
                                 arrCartoes[intContador].strObsCar,
                                 strHisCar,
                                 arrCartoes[intContador].strCndPag,
                                 0,
                                 0.0,
                                 '',
                                 '',
                                 '',
                                 '',
                                 '',
                                 '',
                                 '',
                                 '',
                                 arrCartoes[intContador].fltPerDes,
                                 arrDigFat.curValor,
                                 arrDigFat.curValor - arrDigDup.curValor,
                                 arrCartoes[intContador].strNumCcd,
                                 fDocumeCartao(intContador),
                                 '',
                                 intSeqConRcx,
                                 IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
                                 strCodOpeCar,
                                 IIF(blnCfgGravaResCai And blnValGravaResCai, 1, 0),
                                 strEmpRec,
                                 'F',
                                 arrCartoes[intContador].strCodFin,
                                 arrCartoes[intContador].strTipCar,
                                 arrDuplicCarIpi[intContador2].curValor,
                                 arrDuplicCarRet[intContador2].curValor,
                                 arrDuplicCarAce[intContador2].curValor,
                                 arrDuplicCarFre[intContador2].curValor,
                                 arrCartoes[intContador].strNumNsu,
                                 '',
                                 arrCartoes[intContador].dtaDtaTra,
                                 0,
                                 0,
                                 IIF(self.strCodFpg = '016', IIF(blnCfgGravaResCai And blnValGravaResCai, dtaDtaCadCar, 0), 0),
                                 IIF(blnCfgGravaResCai And blnValGravaResCai, strCodigoCaixa, ''),
                                 false,
                                 '',
                                 arrCartoes[intContador].strChaPix,
                                 arrCartoes[intContador].strPixS_N,
                                 0,
                                 False,
                                 arrCartoes[intContador].strCodigoCarteiraDigital,
                                 arrCartoes[intContador].strControle,
                                 '',
                                 0,
                                 '',
                                 '',
                                 '',
                                 arrDuplicCarCbs[intContador2].curValor,
                                 arrDuplicCarIbs[intContador2].curValor,
                                 arrDuplicCar_Is[intContador2].curValor);

          Inc(intContador2);

          If (Not Result) Then
            Exit;

        End; {While}

        Result := fGravaMovTef(intSeqConRcx, 
                               fRetornaEmpresaMovCarMovModAoDesmembrarPedido(),
                               arrCartoes[intContador].strNumDup,
                               fRetornaEmpresaMovCarMovModAoDesmembrarPedido(),
                               strCodCli, 
                               arrCartoes[intContador].strConteudoArquivo);

        If (Not Result) Then
          Exit;
      End;

      If Result Then
        Self.blnGravouMovCar := True;

      SetLength(arrCartoes,0);
      SetLength(arrDupCar,0);
    End;

    {********************************}
    {* REALIZA GRAVAÇÃO DOS CHEQUES *}
    {*****************************AF*}
    If (fFormataFloat(fltValCqP,2) <> 0.00) Or (fFormataFloat(fltValCqV,2) <> 0.00) Then
    Begin
      pInfoStatusGravacao('Aguarde... Gravando Cheques');

      Result := fGravaCheques;

      If (Not Result) Then
        Exit;
    End;

  End;
end;

function TFatVenda.fGravarCartoesFulfillment(ACartoes: TCartoesResumoCaixaArray; ADadosAdicionais: untTypesSistema.TDadosAdicCartao): Boolean;
  Var
    LIdxCartao: Integer;
    LIdxParcela: Integer;
    LValorOriginal: Double;
    LValorDuplicata: Double;
    LValorFaturamento: Double;
    LValorTaxaCartao: Double;
    LFreteMarketplace: Double;
    LCupomMarketplace: Double;
    LDupFatArray: TArrDigDuplicArray;
    LDupTaxArray: TArrDigDuplicArray;
    LDupFreArray: TArrDigDuplicArray;
    LDupCupArray: TArrDigDuplicArray;
    LArredondaParcela: IArredondaParcela;
    LDuplicataCartao: String;
    LHistorico: String;
    LTipoParcelamento: String;
begin
  Result := True;

  For LIdxCartao := 0 To Length(ACartoes) -1 Do
  Begin
    If (Not Result) Then
      Break;

    If Not fEmptyStr(ACartoes[LIdxCartao].strCodFin) Then
      Continue;

    LTipoParcelamento := '';

    {$IFNDEF LINUX}
      LTipoParcelamento := fCampoTabela('CAR_ARRPAR', 'CADCAR', ['CAR_CODCAR'], [ACartoes[LIdxCartao].strCodCar]);

      If (ACartoes[LIdxCartao].strTipCar = 'POS') And (LTipoParcelamento <> 'N') Then
        LArredondaParcela := TArredondaParCartaoPos.fArredondamentoParcelas(ACartoes[LIdxCartao].strCodCar)
      Else
        LArredondaParcela := fArredondamentoParcelas(ACartoes[LIdxCartao].strCodCar);
    {$ELSE}
      LArredondaParcela := fArredondamentoParcelas(ACartoes[LIdxCartao].strCodCar);
    {$ENDIF LINUX}

    fDigDuplicVar(ACartoes[LIdxCartao].strCndPag, 0, ACartoes[LIdxCartao].fltValDig, False, False, False, ADadosAdicionais.dtaDtaCar, False, LDupFatArray, 0, 'N', False, False, 0, LArredondaParcela);
    fDigDuplicVar(ACartoes[LIdxCartao].strCndPag, 0, ACartoes[LIdxCartao].fltTaxMkt, False, False, False, ADadosAdicionais.dtaDtaCar, False, LDupTaxArray, 0, 'N', False, False, 0, LArredondaParcela);
    fDigDuplicVar(ACartoes[LIdxCartao].strCndPag, 0, ACartoes[LIdxCartao].fltFreMkt, False, False, False, ADadosAdicionais.dtaDtaCar, False, LDupFreArray, 0, 'N', False, False, 0, LArredondaParcela);
    fDigDuplicVar(ACartoes[LIdxCartao].strCndPag, 0, ACartoes[LIdxCartao].fltCupMkt, False, False, False, ADadosAdicionais.dtaDtaCar, False, LDupCupArray, 0, 'N', False, False, 0, LArredondaParcela);

    LDuplicataCartao := fRetSequencialMovCar('MOVCAR', VS_strCodEmp);

    LIdxParcela := 0;

    While (LIdxParcela < Length(LDupFatArray)) And
          (Not fEmptyStr(LDupFatArray[LIdxParcela].strSequen)) Do
    Begin
      LValorOriginal    := LDupFatArray[LIdxParcela].curValor - LDupTaxArray[LIdxParcela].curValor - LDupFreArray[LIdxParcela].curValor + LDupCupArray[LIdxParcela].curValor;
      LValorDuplicata   := LDupFatArray[LIdxParcela].curValor - LDupTaxArray[LIdxParcela].curValor - LDupFreArray[LIdxParcela].curValor + LDupCupArray[LIdxParcela].curValor;
      LValorFaturamento := LDupFatArray[LIdxParcela].curValor;
      LValorTaxaCartao  := LDupTaxArray[LIdxParcela].curValor;
      LFreteMarketplace := LDupFreArray[LIdxParcela].curValor;
      LCupomMarketplace := LDupCupArray[LIdxParcela].curValor;

      LHistorico := 'REF. AO DOC. FULFILLMENT: ' + ADadosAdicionais.strNumDoc;

      If fMovCarJaExiste(ADadosAdicionais.strCodCli, LDupFatArray[LIdxParcela].strSequen, ADadosAdicionais.strCodEmp,
        ADadosAdicionais.strNumDoc, ADadosAdicionais.strEspDoc, LIdxParcela) Then
          Raise Exception.Create('Documento já foi importado na MOVCAR');

      Result := Result And fGravaMovCar(Self.Name,
                                        'INCLUSÃO',
                                        LDuplicataCartao,
                                        ADadosAdicionais.strCodCli,
                                        LDupFatArray[LIdxParcela].strSequen,
                                        ADadosAdicionais.strCodEmp,
                                        ACartoes[LIdxCartao].strCodCar,
                                        ADadosAdicionais.dtaDtaCar,
                                        StrToDate(LDupFatArray[LIdxParcela].dtaDtaVen),
                                        LValorOriginal, // fltValOri
                                        LValorDuplicata, // fltValDup
                                        ACartoes[LIdxCartao].strObsCar,
                                        LHistorico,
                                        ACartoes[LIdxCartao].strCndPag,
                                        0,
                                        0.0,
                                        '',
                                        '',
                                        '',
                                        '',
                                        '',
                                        '',
                                        '',
                                        '',
                                        ACartoes[LIdxCartao].fltPerDes,
                                        LValorFaturamento,//fltValSta
                                        LValorTaxaCartao, //fltValTax
                                        ACartoes[LIdxCartao].strNumCcd,
                                        fDocumeCar(ADadosAdicionais.strNumDoc, ADadosAdicionais.strEspDoc, ADadosAdicionais.strCodEmp, LIdxParcela),
                                        '',
                                        intSeqCon,
                                        VS_strCodEmp,
                                        strLoginUsuarioLogado,
                                        False,
                                        '',
                                        'F',
                                        ACartoes[LIdxCartao].strCodFin,
                                        ACartoes[LIdxCartao].strTipCar,
                                        0,
                                        0,
                                        0,
                                        0,
                                        ACartoes[LIdxCartao].strNumNsu,
                                        ADadosAdicionais.strNumPok,
                                        ADadosAdicionais.dtaDtaCup,
                                        0,
                                        0,
                                        ADadosAdicionais.dtaDtaCar,
                                        '',
                                        False,
                                        '',
                                        ACartoes[LIdxCartao].strChaPix,
                                        ACartoes[LIdxCartao].strPixS_N,
                                        LFreteMarketplace, //fltFreMkt
                                        Self.Fulfillment.EhOperacaoFulfillment,
                                        ACartoes[LIdxCartao].strCodigoCarteiraDigital,
                                        ACartoes[LIdxCartao].strControle,
                                        '',
                                        LCupomMarketplace);

      Inc(LIdxParcela);

      If (Not Result) Then
        Break;
    End;

    If (Not Result) Then
      Break;
  End;
end;

procedure TFatVenda.pNFeInfAdicionaisFCP_AMPARA;
  Var
    intContador: Integer;
    fltFCP: Double;
Begin
  fltFCP := 0;
  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (Not fAtendeRegrasDIFAL(False, arrMatItens[intContador].strEmpIte)) Then
      If (Self.fUtilizaAmpara(arrMatItens[intContador].strCodIte)) Then
        If (arrMatItens[intContador].recDifalFCP.fltValFcp > 0) Then
          fltFCP := fltFCP + arrMatItens[intContador].recDifalFCP.fltValFcp;
  End;
  If fltFCP > 0 Then
    fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, VS_strCodEmp,'Valor do Fundo de Combate a Pobreza: R$' + FloatToStrF(fltFCP, ffNumber, 12, 2),'');
End;

function TFatVenda.fRetDuplicatasExtenso: String;
var strParcelas: String;
    intContador: Integer;
Begin

  strParcelas := '';
  For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
    If arrDuplicata[intContador].curValor > 0 Then
    Begin
      strParcelas := strParcelas + ' ('+ arrDuplicata[intContador].strSequen +') ' +
                                         arrDuplicata[intContador].dtaDtaVen + ' - ' +
                                         FloatToStrF(arrDuplicata[intContador].curValor, ffNumber, 12, 2);
    End;

  Result := strParcelas;
End;

procedure TFatVenda.pNfeInfAdicionaisMOVMOD( strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
var
  qryFormas,
  qryUsaMovMod: TUniQuery;
  strFormas: string;
begin

  qryFormas := fCriaQuery(Self);
  qryUsaMovMod := fCriaQuery(Self);

  try
    pSomaFormasPagamento(strNumDoc, strEspDoc, strCodEmp, strCodCli, qryFormas);

    if not qryFormas.isEmpty then
      strFormas := 'Formas pagto: ';

    while not qryFormas.Eof do
    begin
      strFormas := strFormas +
                   Trim(qryFormas.FieldByName('DESCRI').AsString) + ':' +
                   Trim(FormatFloat('#0.00', qryFormas.FieldByName('VALMOD').AsFloat)) + '; ';
      qryFormas.Next;
    end;

    qryUsaMovMod.SQL.Clear;
    qryUsaMovMod.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaMovMod.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaMovMod.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strFormasPagamento%'));
    qryUsaMovMod.Open;

    if qryUsaMovMod.FieldByName('USAMOVMOD').AsInteger > 0 then
      fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strFormas, '');

  finally
    FreeAndNil(qryFormas);
    FreeAndNil(qryUsaMovMod);
  end;

end;

procedure TFatVenda.pNfeInfAdicChaveNFeReferenciada( strNumDoc, strEspDoc, strCodEmp: String);
var
  qryUsaChaveNFeRef: TUniQuery;
  qryChaveNFeReferenciada: TUniQuery;
begin

  qryUsaChaveNFeRef := fCriaQuery(Self);
  qryChaveNFeReferenciada := fCriaQuery(Self);

  try

    qryUsaChaveNFeRef.SQL.Clear;
    qryUsaChaveNFeRef.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaChaveNFeRef.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaChaveNFeRef.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strChaveNFeReferenciada%'));
    qryUsaChaveNFeRef.Open;

    if qryUsaChaveNFeRef.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin

      qryChaveNFeReferenciada.SQL.Clear;
      qryChaveNFeReferenciada.SQL.Add('SELECT                              ');
      qryChaveNFeReferenciada.SQL.Add('  A1.AUX_CHVNFE AS CHVNFE           ');
      qryChaveNFeReferenciada.SQL.Add('FROM                                ');
      qryChaveNFeReferenciada.SQL.Add('  AUXMOV A1                         ');
      qryChaveNFeReferenciada.SQL.Add('  LEFT JOIN MOVGER G                ');
      qryChaveNFeReferenciada.SQL.Add('    ON G.AUTOINCREM = A1.AUX_SEQGER ');
      qryChaveNFeReferenciada.SQL.Add('WHERE G.GER_NUMDOC = :NUMDOC        ');
      qryChaveNFeReferenciada.SQL.Add('  AND G.GER_ESPDOC = :ESPDOC        ');
      qryChaveNFeReferenciada.SQL.Add('  AND G.GER_CODEMP = :CODEMP        ');
      qryChaveNFeReferenciada.SQL.Add('UNION                               ');
      qryChaveNFeReferenciada.SQL.Add('ALL                                 ');
      qryChaveNFeReferenciada.SQL.Add('SELECT                              ');
      qryChaveNFeReferenciada.SQL.Add('  A2.AUX_CHVNFE AS CHVNFE           ');
      qryChaveNFeReferenciada.SQL.Add('FROM                                ');
      qryChaveNFeReferenciada.SQL.Add('  AUXMOV A2                         ');
      qryChaveNFeReferenciada.SQL.Add('  LEFT JOIN NOTGER N                ');
      qryChaveNFeReferenciada.SQL.Add('    ON N.AUTOINCREM = A2.AUX_SEQGER ');
      qryChaveNFeReferenciada.SQL.Add('WHERE N.GER_NUMDOC = :NUMDOC        ');
      qryChaveNFeReferenciada.SQL.Add('  AND N.GER_ESPDOC = :ESPDOC        ');
      qryChaveNFeReferenciada.SQL.Add('  AND N.GER_CODEMP = :CODEMP        ');

      qryChaveNFeReferenciada.ParamByName('CODEMP').asString := strCodEmp;
      qryChaveNFeReferenciada.ParamByName('NUMDOC').asString := strNumDoc;
      qryChaveNFeReferenciada.ParamByName('ESPDOC').asString := strEspDoc;
      qryChaveNFeReferenciada.Open;

      if fEmptyStr(qryChaveNFeReferenciada.FieldByName('CHVNFE').asString) then
      begin

        qryChaveNFeReferenciada.Close;
        qryChaveNFeReferenciada.SQL.Clear;
        qryChaveNFeReferenciada.SQL.Add('SELECT                                                      ');
        qryChaveNFeReferenciada.SQL.Add('  F.FIS_ACESSO AS CHVNFE                                    ');
        qryChaveNFeReferenciada.SQL.Add('FROM                                                        ');
        qryChaveNFeReferenciada.SQL.Add('  CADFIS F                                                  ');
        qryChaveNFeReferenciada.SQL.Add('  INNER JOIN MOVDET D                                       ');
        qryChaveNFeReferenciada.SQL.Add('     ON F.FIS_CODEMP = D.DET_EMPDEV                         ');
        qryChaveNFeReferenciada.SQL.Add('    AND F.FIS_NUMDOC = D.DET_DOCDEV                         ');
        qryChaveNFeReferenciada.SQL.Add('    AND F.FIS_ESPDOC = D.DET_ESPDEV                         ');
        qryChaveNFeReferenciada.SQL.Add('    AND F.FIS_TIP_FC = D.DET_TIP_FC                         ');
        qryChaveNFeReferenciada.SQL.Add('  WHERE D.DET_CODEMP = :CODEMP                              ');
        qryChaveNFeReferenciada.SQL.Add('    AND D.DET_NUMDOC = :NUMDOC                              ');
        qryChaveNFeReferenciada.SQL.Add('    AND D.DET_ESPDOC = :ESPDOC                              ');
        qryChaveNFeReferenciada.ParamByName('CODEMP').asString := strCodEmp;
        qryChaveNFeReferenciada.ParamByName('NUMDOC').asString := strNumDoc;
        qryChaveNFeReferenciada.ParamByName('ESPDOC').asString := strEspDoc;
        qryChaveNFeReferenciada.Open;

      end;

      If not qryChaveNFeReferenciada.isEmpty then
        fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, qryChaveNFeReferenciada.FieldByName('CHVNFE').asString, '');

    end;

  finally
    FreeAndNil(qryUsaChaveNFeRef);
    FreeAndNil(qryChaveNFeReferenciada);
  end;

end;

procedure TFatVenda.pNfeInfAdicNumPedidoCompraNFRemessa( strNumDoc, strEspDoc, strCodEmp: String);
var
  qryUsaChavePedCom: TUniQuery;
  qryChavePedCom: TUniQuery;
begin

  qryUsaChavePedCom := fCriaQuery;
  qryChavePedCom := fCriaQuery;

  try

    qryUsaChavePedCom.SQL.Clear;
    qryUsaChavePedCom.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaChavePedCom.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaChavePedCom.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strNumPedidoCompraNFRemessa%'));
    qryUsaChavePedCom.Open;

    if qryUsaChavePedCom.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin

      qryChavePedCom.SQL.Clear;
      qryChavePedCom.SQL.Add('SELECT DISTINCT                        ');
      qryChavePedCom.SQL.Add('  F.FGO_MEN001 AS MEN001               ');
      qryChavePedCom.SQL.Add('FROM                                   ');
      qryChavePedCom.SQL.Add('  MOVDET D                             ');
      qryChavePedCom.SQL.Add('  LEFT JOIN MOVDET D1                  ');
      qryChavePedCom.SQL.Add('    ON D1.DET_NUMDOC = D.DET_DOCFUT    ');
      qryChavePedCom.SQL.Add('    AND D1.DET_CODEMP = D.DET_EMPFUT   ');
      qryChavePedCom.SQL.Add('    AND D1.DET_ESPDOC = D.DET_ESPFUT   ');
      qryChavePedCom.SQL.Add('  LEFT JOIN FATGOR F                   ');
      qryChavePedCom.SQL.Add('    ON F.FGO_NUMDOC = D1.DET_NUM_PD    ');
      qryChavePedCom.SQL.Add('    AND F.FGO_CODEMP = D1.DET_EMP_PD   ');
      qryChavePedCom.SQL.Add('    AND F.FGO_ESPDOC = D1.DET_ESP_PD   ');
      qryChavePedCom.SQL.Add('WHERE D.DET_NUMDOC = :NUMDOC           ');
      qryChavePedCom.SQL.Add('  AND D.DET_CODEMP = :CODEMP           ');
      qryChavePedCom.SQL.Add('  AND D.DET_ESPDOC = :ESPDOC           ');
      qryChavePedCom.SQL.Add('  AND D.DET_TIP_FC = "C"               ');

      qryChavePedCom.ParamByName('CODEMP').asString := strCodEmp;
      qryChavePedCom.ParamByName('NUMDOC').asString := strNumDoc;
      qryChavePedCom.ParamByName('ESPDOC').asString := strEspDoc;
      qryChavePedCom.Open;

      If not qryChavePedCom.isEmpty then
        fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, qryChavePedCom.FieldByName('MEN001').asString, '');

    end;

  finally
    FreeAndNil(qryUsaChavePedCom);
    FreeAndNil(qryChavePedCom);
  end;

end;

procedure TFatVenda.pNfeInfAdicDocumentosOriginaisBaixaEntFutura( strNumDoc, strEspDoc, strCodEmp: String);
var
  qryDocumentosOrigem: TUniQuery;
  qryUsaDocumentosOrigem: TUniQuery;
  qryFormasPagtoDocumentoOrigem: TUniQuery;
  strDocumentos: string;
begin

  strDocumentos := EmptyStr;
  qryDocumentosOrigem := fCriaQuery(Self);
  qryUsaDocumentosOrigem := fCriaQuery(Self);
  qryFormasPagtoDocumentoOrigem := fCriaQuery(Self);

  try

    qryUsaDocumentosOrigem.SQL.Clear;
    qryUsaDocumentosOrigem.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaDocumentosOrigem.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaDocumentosOrigem.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strDocumentosOriginaisBaixaEntFutura%'));
    qryUsaDocumentosOrigem.Open;

    if qryUsaDocumentosOrigem.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin

      qryDocumentosOrigem.SQL.Clear;
      qryDocumentosOrigem.SQL.Add('SELECT DISTINCT                                     ');
      qryDocumentosOrigem.SQL.Add('  D.DET_DOCFUT AS DOCFUT,                           ');
      qryDocumentosOrigem.SQL.Add('  D.DET_ESPFUT AS ESPFUT,                           ');
      qryDocumentosOrigem.SQL.Add('  D.DET_EMPFUT AS EMPFUT                            ');
      qryDocumentosOrigem.SQL.Add('FROM                                                ');
      qryDocumentosOrigem.SQL.Add('  MOVDET D                                          ');
      qryDocumentosOrigem.SQL.Add('  LEFT JOIN MOVGER G ON G.AUTOINCREM = D.DET_SEQGER ');
      qryDocumentosOrigem.SQL.Add('  LEFT JOIN CADFPG F ON F.FPG_CODIGO = G.GER_CODFPG ');
      qryDocumentosOrigem.SQL.Add('  LEFT JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM ');
      qryDocumentosOrigem.SQL.Add('WHERE D.DET_CODEMP = :CODEMP                        ');
      qryDocumentosOrigem.SQL.Add('  AND D.DET_NUMDOC = :NUMDOC                        ');
      qryDocumentosOrigem.SQL.Add('  AND D.DET_ESPDOC = :ESPDOC                        ');
      qryDocumentosOrigem.SQL.Add('  AND D.DET_TIP_FC = "C"                            ');
      qryDocumentosOrigem.SQL.Add('  AND D.DET_DOCFUT IS NOT NULL                      ');
      qryDocumentosOrigem.ParamByName('CODEMP').asString := strCodEmp;
      qryDocumentosOrigem.ParamByName('NUMDOC').asString := strNumDoc;
      qryDocumentosOrigem.ParamByName('ESPDOC').asString := strEspDoc;
      qryDocumentosOrigem.Open;

      while not qryDocumentosOrigem.eof do
      begin

        qryFormasPagtoDocumentoOrigem.SQL.Clear;
        qryFormasPagtoDocumentoOrigem.SQL.Add('SELECT DISTINCT                                     ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  G.GER_NUMDOC AS NUMDOC,                           ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  G.GER_ESPDOC AS ESPDOC,                           ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  G.GER_CODEMP AS CODEMP,                           ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  G.GER_CODFPG AS CODFPG,                           ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  F.FPG_DESCRI AS DESCRI                            ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('FROM                                                ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  MOVDET D                                          ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  LEFT JOIN MOVGER G ON G.AUTOINCREM = D.DET_SEQGER ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  LEFT JOIN CADFPG F ON F.FPG_CODIGO = G.GER_CODFPG ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('  LEFT JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('WHERE D.DET_CODEMP = :CODEMP                        ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('AND D.DET_NUMDOC = :NUMDOC                          ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('AND D.DET_ESPDOC = :ESPDOC                          ');
        qryFormasPagtoDocumentoOrigem.SQL.Add('AND D.DET_TIP_FC = "C"                              ');
        qryFormasPagtoDocumentoOrigem.ParamByName('CODEMP').asString := qryDocumentosOrigem.FieldByName('EMPFUT').asString;
        qryFormasPagtoDocumentoOrigem.ParamByName('NUMDOC').asString := qryDocumentosOrigem.FieldByName('DOCFUT').asString;
        qryFormasPagtoDocumentoOrigem.ParamByName('ESPDOC').asString := qryDocumentosOrigem.FieldByName('ESPFUT').asString;
        qryFormasPagtoDocumentoOrigem.Open;
        while not qryFormasPagtoDocumentoOrigem.eof do
        begin
          strDocumentos := strDocumentos + qryFormasPagtoDocumentoOrigem.FieldByName('ESPDOC').asString + '-' +
                                           qryFormasPagtoDocumentoOrigem.FieldByName('NUMDOC').asString + '-' +
                                           qryFormasPagtoDocumentoOrigem.FieldByName('CODEMP').asString + ': ' +
                                           qryFormasPagtoDocumentoOrigem.FieldByName('DESCRI').asString + slinebreak;
          qryFormasPagtoDocumentoOrigem.next;

        end;
        qryDocumentosOrigem.Next;
      end;

      If not fEmptyStr(strDocumentos) then
        fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strDocumentos, '');

    end;

  finally
    FreeAndNil(qryDocumentosOrigem);
    FreeAndNil(qryUsaDocumentosOrigem);
    FreeAndNil(qryFormasPagtoDocumentoOrigem);
  end;

end;

procedure TFatVenda.pPreencherMsgCondPgtoBaixaEntFutNF;
var
  objQry : TUniQuery;
  strListAutInc, strCondPag : string;
  intIndice : integer;
begin
  strListAutInc := '';
  strCondPag := '';

  objQry := fCriaQuery(nil);
  try
    try
      for intIndice := Low(Self.arrMatItens) to High(Self.arrMatItens) do
        pIncrementaListaStr(
          IIF(strOpcDocTrue = 'BF',Self.arrMatItens[intIndice].strIncFut, Self.arrMatItens[intIndice].strSeqDet),
          strListAutInc, True, True, ',', False, False);

      if not strListAutInc.IsEmpty then
      begin
        objQry.Close;
        objQry.SQL.Clear;

        objQry.SQL.Add('SELECT DISTINCT ');
        objQry.SQL.Add(' G.GER_NUMDOC AS NUMDOC,');
        objQry.SQL.Add(' G.GER_ESPDOC AS ESPDOC,');
        objQry.SQL.Add(' G.GER_CODEMP AS CODEMP,');
        objQry.SQL.Add(' G.GER_CONPAG AS CONPAG,');
        objQry.SQL.Add(' C.CND_DESCRI AS DESCRI ');
        objQry.SQL.Add(' FROM MOVGER G');
        objQry.SQL.Add(' JOIN MOVDET D ON D.DET_SEQGER = G.AUTOINCREM');
        objQry.SQL.Add(' LEFT JOIN CADCND C ON C.CND_CODIGO = G.GER_CODCND');
        objQry.SQL.Add(' WHERE D.AUTOINCREM IN ('+strListAutInc+')');
        objQry.Open;

        objQry.First;
        while not objQry.Eof do
        begin
          strCondPag := strCondPag + Format('%s-%s-%s-%s%s%s%s', [
            objQry.FieldByName('NUMDOC').AsString,
            objQry.FieldByName('ESPDOC').AsString,
            objQry.FieldByName('CODEMP').AsString,
            fFormataCondPag(objQry.FieldByName('CONPAG').AsString),
            '  ',
            objQry.FieldByName('DESCRI').AsString,
            ', '
            ]);

          objQry.Next;
        end;

        if Copy(strCondPag, Length(strCondPag) -1, Length(strCondPag)) = ', ' then
          strCondPag := Copy(strCondPag, 1, Length(strCondPag) -2);

        Self.strMsgCondPgtoNosDadosAdicDaBaixaEntFutNF := strCondPag;
      end;
    except on E: Exception do
      raise
    end;
  finally
    FreeAndNil(objQry);
  end;
end;

function TFatVenda.fPermiteTrocarClienteNaDevolucao(blnBaixaDev: Boolean = False): String;
  Var
    cdsDados: TUniClientDataSet;
    strDocumentosComCpfCpnj: String;
    strTabelaDev: String;
    strCodCfg: String;
begin
  Result := 'N';

  strCodCfg := IIF(blnBaixaDev, 'TRCLD2', 'TRCLDV');

  If Not blnBaixaDev Then
  Begin
    If blnDevEsp Then
      Exit;

    If (Pos(strOpcDoc, 'DV_PR_DD_') > 0) And (fClienteConsumidor(strCliOri, True, True)) Then
      Exit('S');

    If strOpcDoc <> 'DV' Then
      Exit;
  End;

  If fCfgSis(strCodCfg, varString) = 'N' Then
    Exit;

  If fCfgSis(strCodCfg, varString) = 'S' Then
    Exit('S');

  strDocumentosComCpfCpnj := '';
  cdsDados := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      If cdsDados.FieldByName('ITE_TABDEV').AsString = 'NOTDET' Then
        strTabelaDev := 'NOTGER'
      Else
        strTabelaDev := 'MOVGER';

      If Not fEmptyStr(fCampoTabela('GER_CGCCON', strTabelaDev, ['GER_NUMDOC', 'GER_ESPDOC', 'GER_CODEMP'], [cdsDados.FieldByName('ITE_DOCDEV').AsString, cdsDados.FieldByName('ITE_ESPDEV').AsString, cdsDados.FieldByName('ITE_EMPDEV').AsString])) Then
        strDocumentosComCpfCpnj := strDocumentosComCpfCpnj + IIF(fEmptyStr(strDocumentosComCpfCpnj), ' ', ', ') + cdsDados.FieldByName('ITE_DOCDEV').AsString + ' - ' + cdsDados.FieldByName('ITE_ESPDEV').AsString + ' - ' + cdsDados.FieldByName('ITE_EMPDEV').AsString;

      cdsDados.Next;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;

  If Not fEmptyStr(strDocumentosComCpfCpnj) Then
  Begin
    If fMensagem('', 'O sistema está configurado para permitir trocar o cliente na devolução somente quando o ' +
                     'documento não possui CPF/CNPJ informado. - [CFG_' + strCodCfg + ']' + #10#13 +
                     'O(s) documento(s) relacionado(s) possui(em) CPF/CNPJ informado: ' + #10#13 + strDocumentosComCpfCpnj + #10#13 +
                     'Não será permitido trocar o cliente. Deseja continuar com a devolução?', ['&Sim', '&Não'], 1) = 2 Then
      Exit('T');
  End
  Else
    Result := 'S';
end;

procedure TFatVenda.pNfeInfAdicOcoHisComplementar(strNumDoc, strEspDoc,
  strCodEmp: String);
var
  qryUsaChave: TUniQuery;
  qryOcoHis: TUniQuery;
  strOcoHis: String;
begin

  qryUsaChave := fCriaQuery;
  qryOcoHis := fCriaQuery;

  try

    qryUsaChave.SQL.Clear;
    qryUsaChave.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaChave.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaChave.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strOcoHisComplementar%'));
    qryUsaChave.Open;

    if qryUsaChave.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin

      qryOcoHis.SQL.Clear;
      qryOcoHis.SQL.Add('SELECT                                               ');
      qryOcoHis.SQL.Add('  EX.FGO_CODOCO AS CODOCO,                           ');
      qryOcoHis.SQL.Add('  EX.FGO_HISCOM AS HISCOM,                           ');
      qryOcoHis.SQL.Add('  OC.OCO_DESOCO AS DESOCO                            ');
      qryOcoHis.SQL.Add('FROM                                                 ');
      qryOcoHis.SQL.Add('  FATGOR FG                                          ');
      qryOcoHis.SQL.Add('LEFT JOIN EXTGOR EX ON EX.FGO_SEQFGO = FG.AUTOINCREM ');
      qryOcoHis.SQL.Add('LEFT JOIN CADOCO OC ON OC.OCO_CODOCO = EX.FGO_CODOCO ');
      qryOcoHis.SQL.Add('WHERE FG.FGO_NUMFAT = :NUMDOC                        ');
      qryOcoHis.SQL.Add('  AND FG.FGO_CODEMP = :CODEMP                        ');
      qryOcoHis.SQL.Add('  AND FG.FGO_TIPFAT = :ESPDOC                        ');

      qryOcoHis.ParamByName('CODEMP').asString := strCodEmp;
      qryOcoHis.ParamByName('NUMDOC').asString := strNumDoc;
      qryOcoHis.ParamByName('ESPDOC').asString := strEspDoc;
      qryOcoHis.Open;

      If Not fEmptyStr(qryOcoHis.FieldByName('CODOCO').AsString) Then
      Begin
        strOcoHis := qryOcoHis.FieldByName('HISCOM').asString + ' - CÓD. OCORRÊNCIA:' + qryOcoHis.FieldByName('CODOCO').asString + ' - ' + qryOcoHis.FieldByName('DESOCO').asString;
        fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strOcoHis, '');
      End;
    end;

  finally
    FreeAndNil(qryUsaChave);
    FreeAndNil(qryOcoHis);
  end;

End;

procedure TFatVenda.pNfeInfAdicRestanteAPagar( strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
var
  qryCredito: TUniQuery;
  qryValorNF: TUniQuery;
  qrySenCon: TUniQuery;
  qryUsaDocsCred: TUniQuery;
  strMensagem: string;
begin

  qryCredito := fCriaQuery(Self);
  qrySenCon := fCriaQuery(Self);
  qryUsaDocsCred := fCriaQuery(Self);
  qryValorNF := fCriaQuery(Self);

  try

    qryUsaDocsCred.SQL.Clear;
    qryUsaDocsCred.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaDocsCred.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaDocsCred.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strRestanteAPagar%'));
    qryUsaDocsCred.Open;

    if qryUsaDocsCred.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin
      qrySenCon.SQL.Clear;
      qrySenCon.SQL.Add('SELECT DISTINCT               ');
      qrySenCon.SQL.Add('  C1.CTR_SEQCON,              ');
      qrySenCon.SQL.Add('  C1.CTR_EMPBAI               ');
      qrySenCon.SQL.Add('FROM                          ');
      qrySenCon.SQL.Add('  CADREC C1                   ');
      qrySenCon.SQL.Add('WHERE C1.CTR_NUMDUP = :NUMDOC ');
      qrySenCon.SQL.Add('  AND C1.CTR_ESPDOC = :ESPDOC ');
      qrySenCon.SQL.Add('  AND C1.CTR_CODEMP = :CODEMP ');
      qrySenCon.SQL.Add('  AND C1.CTR_CODCLI = :CODCLI ');
      qrySenCon.SQL.Add('ORDER BY C1.CTR_DTABAI DESC;  ');

      qrySenCon.ParamByName('NUMDOC').asString := strNumDoc;
      qrySenCon.ParamByName('ESPDOC').asString := strEspDoc;
      qrySenCon.ParamByName('CODEMP').asString := strCodEmp;
      qrySenCon.ParamByName('CODCLI').asString := strCodCli;

      qrySenCon.Open;

      if not(qrySenCon.isEmpty) and not(qrySenCon.FieldByName('CTR_SEQCON').asString = '0') then
      begin

        qryValorNF.SQL.Clear;
        qryValorNF.SQL.Add('SELECT GER_VLRCON AS VLRCON       ');
        qryValorNF.SQL.Add('FROM                              ');
        qryValorNF.SQL.Add('  MOVGER                          ');
        qryValorNF.SQL.Add('WHERE MOVGER.GER_NUMDOC = :NUMDOC ');
        qryValorNF.SQL.Add('  AND MOVGER.GER_ESPDOC = :ESPDOC ');
        qryValorNF.SQL.Add('  AND MOVGER.GER_CODEMP = :CODEMP ');
        qryValorNF.SQL.Add('  AND MOVGER.GER_CODCLI = :CODCLI ');

        qryValorNF.ParamByName('NUMDOC').asString := strNumDoc;
        qryValorNF.ParamByName('ESPDOC').asString := strEspDoc;
        qryValorNF.ParamByName('CODEMP').asString := strCodEmp;
        qryValorNF.ParamByName('CODCLI').asString := strCodCli;
        qryValorNF.Open;

        If not qryValorNF.isEmpty then
        begin

          qryCredito.SQL.Clear;
          qryCredito.SQL.Add('SELECT                     ');
          qryCredito.SQL.Add('  SUM(CTR_VALORI * - 1)    ');
          qryCredito.SQL.Add('    AS DOCSCRED            ');
          qryCredito.SQL.Add('FROM                       ');
          qryCredito.SQL.Add('  CADREC                   ');
          qryCredito.SQL.Add('WHERE CTR_SEQCON = :SEQCON ');
          qryCredito.SQL.Add('  AND CTR_EMPBAI = :EMPBAI ');
          qryCredito.SQL.Add('  AND CTR_VALORI < 0;      ');
          qryCredito.ParamByName('SEQCON').asString := qrySenCon.FieldByName('CTR_SEQCON').asString;
          qryCredito.ParamByName('EMPBAI').asString := qrySenCon.FieldByName('CTR_EMPBAI').asString;
          qryCredito.Open;

          If not qryCredito.isEmpty then
          begin
            strMensagem := 'VALOR TOTAL DA NF: '+
                           FormatFloat('##0.00', qryValorNF.FieldByName('VLRCON').asFloat)+
                           ' - '+
                           FormatFloat('##0.00', qryCredito.FieldByName('DOCSCRED').asFloat)+
                           ' = '+
                           FormatFloat('##0.00', qryValorNF.FieldByName('VLRCON').asFloat - qryCredito.FieldByName('DOCSCRED').asFloat);

            fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strMensagem, '');
          end;
        end;

      end;
    end;
  finally
    FreeAndNil(qrySenCon);
    FreeAndNil(qryCredito);
    FreeAndNil(qryUsaDocsCred);
    FreeAndNil(qryValorNF);
  end;

end;

procedure TFatVenda.pNfeInfAdicDocumentosCreditoUsados( strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
var
  qryDocumentosCredito: TUniQuery;
  qrySenCon: TUniQuery;
  qryUsaDocsCred: TUniQuery;
begin

  qryDocumentosCredito := fCriaQuery(Self);
  qrySenCon := fCriaQuery(Self);
  qryUsaDocsCred := fCriaQuery(Self);

  try

    qryUsaDocsCred.SQL.Clear;
    qryUsaDocsCred.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaDocsCred.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaDocsCred.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strDocumentosCreditoUsados%'));
    qryUsaDocsCred.Open;

    if qryUsaDocsCred.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin
      qrySenCon.SQL.Clear;
      qrySenCon.SQL.Add('SELECT DISTINCT               ');
      qrySenCon.SQL.Add('  C1.CTR_SEQCON,              ');
      qrySenCon.SQL.Add('  C1.CTR_EMPBAI               ');
      qrySenCon.SQL.Add('FROM                          ');
      qrySenCon.SQL.Add('  CADREC C1                   ');
      qrySenCon.SQL.Add('WHERE C1.CTR_NUMDUP = :NUMDOC ');
      qrySenCon.SQL.Add('  AND C1.CTR_ESPDOC = :ESPDOC ');
      qrySenCon.SQL.Add('  AND C1.CTR_CODEMP = :CODEMP ');
      qrySenCon.SQL.Add('  AND C1.CTR_CODCLI = :CODCLI ');

      qrySenCon.ParamByName('NUMDOC').asString := strNumDoc;
      qrySenCon.ParamByName('ESPDOC').asString := strEspDoc;
      qrySenCon.ParamByName('CODEMP').asString := strCodEmp;
      qrySenCon.ParamByName('CODCLI').asString := strCodCli;

      qrySenCon.Open;

      if not(qrySenCon.isEmpty) and not(qrySenCon.FieldByName('CTR_SEQCON').asString = '0') then
      begin

        qryDocumentosCredito.SQL.Clear;
        qryDocumentosCredito.SQL.Add('SELECT                     ');
        qryDocumentosCredito.SQL.Add('  CONCAT(                  ');
        qryDocumentosCredito.SQL.Add('    "DOCS DE CRED: ",      ');
        qryDocumentosCredito.SQL.Add('    GROUP_CONCAT(          ');
        qryDocumentosCredito.SQL.Add('      CTR_NUMDUP,          ');
        qryDocumentosCredito.SQL.Add('      "-",                 ');
        qryDocumentosCredito.SQL.Add('      CTR_ESPDOC,          ');
        qryDocumentosCredito.SQL.Add('      "-",                 ');
        qryDocumentosCredito.SQL.Add('      CTR_CODEMP,          ');
        qryDocumentosCredito.SQL.Add('      "-VLR R$ ",          ');
        qryDocumentosCredito.SQL.Add('      (CTR_VALORI * - 1)   ');
        qryDocumentosCredito.SQL.Add('    )                      ');
        qryDocumentosCredito.SQL.Add('  ) AS DOCSCRED            ');
        qryDocumentosCredito.SQL.Add('FROM                       ');
        qryDocumentosCredito.SQL.Add('  CADREC                   ');
        qryDocumentosCredito.SQL.Add('WHERE CTR_SEQCON = :SEQCON ');
        qryDocumentosCredito.SQL.Add('  AND CTR_EMPBAI = :EMPBAI ');
        qryDocumentosCredito.SQL.Add('  AND CTR_VALORI < 0;      ');
        qryDocumentosCredito.ParamByName('SEQCON').asString := qrySenCon.FieldByName('CTR_SEQCON').asString;
        qryDocumentosCredito.ParamByName('EMPBAI').asString := qrySenCon.FieldByName('CTR_EMPBAI').asString;
        qryDocumentosCredito.Open;

        If not qryDocumentosCredito.isEmpty then
          fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, qryDocumentosCredito.FieldByName('DOCSCRED').asString, '');

      end;
    end;
  finally
    FreeAndNil(qrySenCon);
    FreeAndNil(qryDocumentosCredito);
    FreeAndNil(qryUsaDocsCred);
  end;

end;

procedure TFatVenda.pNFeInfAdicionaisAKZ(strNumDoc, strEspDoc, strCodEmp: String);
  Var
    strInfCom: String;
    qryInfCom: TUniQuery;
    stlAdicionadas : TStringList;
    strChvAce : String;
Begin
  qryInfCom := fCriaQuery(Self);
  stlAdicionadas := TStringList.Create;
  Try
    strInfCom := '';

    If fEmptyStr(fCfgSis('AKZCLI')) Then
      Exit;

    With qryInfCom, SQL Do
    Begin
      Clear;
      Add('SELECT DISTINCT SUBSTR(LOT_NOTULT,1,12) AS LOT_NOTULT, LOT_DTAULT, ');
      Add('                LOT_CHVULT, FIS_NUMDOC, FIS_DTAENT, FIS_ACESSO     ');
      Add('FROM MOVDET                                                        ');
      Add('INNER JOIN FATDOR ON FDO_NUMDOC = DET_NUM_PD AND                   ');
      Add('                     FDO_ESPDOC = DET_ESP_PD AND                   ');
      Add('                     FDO_CODEMP = DET_EMP_PD AND                   ');
      Add('                     FDO_CODITE = DET_CODITE AND                   ');
      Add('                     FDO_SEQIND = DET_IND_PD                       ');
      Add('INNER JOIN DEL_LOTDOR ON LDO_SEQFDO = FATDOR.AUTOINCREM            ');
      Add('INNER JOIN CADLOT ON LOT_NUMLOT = LDO_NUMLOT AND                   ');
      Add('                     LOT_CODEMP = FDO_CODEMP AND                   ');
      Add('                     LOT_CODITE = FDO_CODITE                       ');
      Add('LEFT  JOIN CADFIS ON FIS_NUMDOC = SUBSTR(LOT_NOTULT,1,12) AND      ');
      Add('                     FIS_FORCLI = LOT_FORULT  AND                  ');
      Add('                     FIS_TIP_FC = "F" AND                          ');
      Add('                     FIS_ENTSAI = "E"                              ');
      Add('WHERE LOT_NOTULT IS NOT NULL                                       ');
      Add('  AND DET_NUMDOC = :NUMDOC                                         ');
      Add('  AND DET_ESPDOC = :ESPDOC                                         ');
      Add('  AND DET_CODEMP = :CODEMP                                         ');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      First;
      While Not Eof do
      Begin
        strChvAce := IIF(Not fEmptyStr(FieldByName('FIS_NUMDOC').AsString), FieldByName('FIS_ACESSO').AsString, FieldByName('LOT_CHVULT').AsString);

        If (stlAdicionadas.IndexOf(strChvAce) < 0) Then
        Begin
          If Not fEmptyStr( FieldByName('FIS_NUMDOC').AsString ) Then
          Begin
            strInfCom := strInfCom + ' Nfe Original: '+FieldByName('FIS_NUMDOC').AsString+
                                     ' Dt.Emissão: '+FormatDateTime('dd-mm-yyyy',FieldByName('FIS_DTAENT').AsDateTime)+
                                     ' Chave de Acesso: '+FieldByName('FIS_ACESSO').AsString
          End
          Else
          Begin
            strInfCom := strInfCom + ' Nfe Original: '+FieldByName('LOT_NOTULT').AsString+
                                     ' Dt.Emissão: '+FormatDateTime('dd-mm-yyyy',FieldByName('LOT_DTAULT').AsDateTime)+
                                     ' Chave de Acesso: '+FieldByName('LOT_CHVULT').AsString;
          End;
          stlAdicionadas.Add(strChvAce);
        End;

        Next;
      End;

      fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strInfCom, '');

    End;
  Finally
    FreeAndNil(qryInfCom);
    FreeAndNil(stlAdicionadas);
  End;
End;

class function TFatVenda.fLiberaAlteracaoPedidoComAdiantamento(qryFatGor: TUniQuery; const fltValAdt: Double): Boolean;
var
  objLiberacao: TLiberacao;
begin
