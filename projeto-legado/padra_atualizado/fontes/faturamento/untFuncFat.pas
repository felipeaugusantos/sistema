function TFatVenda.fGravaCadPagServTerc: Boolean;
  Var
    strCodSer,
    strNumDup,
    strCodPorAvi: String;
    fltQtdSer: Double;
    intCont,
    intDupl  : Integer;
    qryAux: TUniQuery;

begin
  strCodPorAvi := fCfgSis('PORAVI');
  If fEmptyStr(fRetNomPortador(strCodPorAvi)) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração Lançamento bancário à vista - Portador do grupo Faturamento está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End
  {*REQ*145940**********RP*}
  Else If Not fEmpresaTemAcessoPortador(strCodPorAvi) Then
  Begin
    fRollback;
    fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador da configuração "Lançamento bancário à vista - Portador do grupo Faturamento" ('+ strCodPorAvi +'). Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
    Result := False;
    Exit;
  End;

  qryAux := fCriaQuery(Self);
  qryAux.SQL.Clear;
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  SER_DESSER, ');
  qryAux.SQL.Add('  SER_VALCUS * :QTDSER AS SER_VALCUS, ');
  qryAux.SQL.Add('  SER_CODCTA, ');
  qryAux.SQL.Add('  SER_CODFOR, ');
  qryAux.SQL.Add('  SER_CODCND, ');
  qryAux.SQL.Add('  CND_CNDPAG  ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADSER INNER JOIN CADCND ON CADSER.SER_CODCND = CADCND.CND_CODIGO ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  SER_TERCER = "S" AND    ');
  qryAux.SQL.Add('  SER_CODSER IN (:CODSER) ');

  Result := True;

  For intCont := 1 To 30 Do
  Begin
    If Not Result Then
      Break;

    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intToStr(intCont), 2));
    fltQtdSer := GetPropValue(Self, 'fltQtdS' + fStrZero(intToStr(intCont), 2));

    qryAux.Close;
    qryAux.ParamByName('CODSER').AsString := strCodSer;
    qryAux.ParamByName('QTDSER').AsFloat  := fltQtdSer;
    qryAux.Open;

    If Not (qryAux.IsEmpty) then
    Begin
      fDigDuplic(arrDuplicata,
                 qryAux.FieldByName('CND_CNDPAG').AsString,
                 0,
                 qryAux.FieldByName('SER_VALCUS').AsFloat,
                 False,
                 False,
                 False,
                 Self.VS_Date+1,
                 False);

      intDupl := 0;

      strNumDup := fRetSequencialCadPag;

      While (ArrDuplicata[intDupl].dtaDtaVen <> '') And
            (intDupl < Length(arrDuplicata)) Do
      Begin
        If Not Result Then
          Break;

        pInfoStatusGravacao('Aguarde... Gravando Contas a Pagar de Serviço E');

        Result  := fGravaCadPag(strNomeForm,    //Nome Form LOGCTP
                                'INCLUSAO CONTAS A PAGAR DE SERVICO E', //Descrição LOGCTP
                                qryAux.FieldByName('SER_CODFOR').AsString,
                                strNumDup,
                                arrDuplicata[intDupl].strSequen,
                                VS_strCodEmp,
                                qryAux.FieldByName('SER_CODCTA').AsString,
                                '',
                                0,
                                Self.VS_Date,
                                StrToDate(arrDuplicata[intDupl].dtaDtaVen),
                                arrDuplicata[intDupl].curValor,
                                arrDuplicata[intDupl].curValor,
                                'N',
                                'N',
                                'N',
                                'REF.SERV.TERCEIRIZADO - ' + qryAux.FieldByName('SER_DESSER').AsString +
                                STRING_QUEBRA + 'DOC.VENDA: '+ Self.strNumDoc +'-'+ Self.strEspDoc + '-' +
                                VS_strCodEmp + ' / ' +'PLACA: ' + LeftStr(strPlaVei, 3) +'-'+ RightStr(strPlaVei, 4)+
                                ' / CLIENTE: ' +Self.strCodCli + '-' + fRetNomCliente(Self.strCodCli),
                                '',
                                'REF.SERV.TERCEIRIZADO - ' + qryAux.FieldByName('SER_DESSER').AsString,
                                '',
                                '',
                                '',
                                '',
                                0,
                                0,
                                0,
                                0,
                                VS_strCodEmp,
                                '',
                                'N',
                                strCodPorAvi,
                                '',
                                0,
                                0,
                                0,
                                False,
                                0,
                                '',
                                0,
                                '',
                                '',
                                '',
                                '',
                                '',
                                Self.strNumDoc,
                                Self.strEspDoc,
                                VS_strCodEmp,
                                Self.strCodCli,
                                '',
                                '',
                                '',
                                '',
                                '',
                                '',
                                0,
                                0,
                                0,
                                0,
                                '',
                                0,
                                0,
                                '',
                                '',
                                '',
                                '',
                                '',
                                '0',
                                '',
                                '',
                                '',
                                '',
                                'N');

        If Result Then
          Inc(intDupl);
      End;
    End;
  End;

  {*******************************************}
  {* RESTAURA A DIGDUPLIC                    *}
  {****************************************MV*}
  For intCont := 0 To 23 Do
  Begin
    arrDuplicata[intCont] := arrDuplicCop[intCont];
  End;
End;

function TFatVenda.fGravaCadPagUC: Boolean;
  Var
    strNumDup,
    strMsgHis,
    strMsgBai,
    strCodPorAvi,
    strCodPorBaixa,
    strCodCentroCustoBaixa,
    strCodPorUso: String;

    function fRetDocRef(blnInsereQuebra: Boolean): String;
    begin
      Result := IIF(blnInsereQuebra, STRING_QUEBRA, ' ')+'REF. DOC.: '+strNumDoc+'-'+strEspDoc+'-'+VS_strCodEmp;
    end;

begin

  {*******************************************}
  {* TRAVA SE QUALQUER UMA DAS CONFIGURAÇÕES *}
  {* ABAIXO ESTIVER VAZIA OU INCORRETA       *}
  {****************************************JU*}
  If fEmptyStr(fRetDescCentroCusto(fCfgSis('CTAAVI'))) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração Lançamento bancário à vista - Plano de Contas do grupo Faturamento está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End;

  strCodPorAvi := fCfgSis('PORAVI');
  If fEmptyStr(fRetNomPortador(strCodPorAvi)) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração Lançamento bancário à vista - Portador do grupo Faturamento está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End
  {*REQ*145940**********RP*}
  Else If Not fEmpresaTemAcessoPortador(strCodPorAvi) Then
  Begin
    fRollback;
    fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador da configuração "Lançamento bancário à vista - Portador do grupo Faturamento" ('+ strCodPorAvi +'). Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
    Result := False;
    Exit;
  End;

  strCodPorUso := fCfgSis('PORUSO');
  If fEmptyStr(fRetNomPortador(strCodPorUso)) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração "Portador para contas a pagar Uso/Consumo" está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End
  {*REQ*145940**********RP*}
