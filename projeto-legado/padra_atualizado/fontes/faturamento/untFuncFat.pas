function fExistemInconsistenciasPedidoExpedicao(AParams: TExpedicaoParams): Boolean;
  Var
    LMensagemErroExpedicao: String;
begin
  Result := False;

  If Not Assigned(AParams) Then
    Exit;

  If (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA) Then
    Exit;

  If Not MatchStr(VS_strTipExp, [TIPEXP_POR_PEDIDO_E_PEDIDO_SERA_FATURADO, TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO]) Then
    Exit;

  Try
    If (Not Assigned(AParams.stlPedidos)) Or (AParams.stlPedidos.Count = 0) Then
    Begin
      LMensagemErroExpedicao := 'Não foi possível recuperar a lista de pedidos. '+
        'Feche essa tela, atualize os documentos a serem expedidos e informe a Citel sobre essa notificação!';

      If (Not Assigned(AParams.stlPedidos)) Then
        LMensagemErroExpedicao := LMensagemErroExpedicao + ' > SL = Nil'

      Else If (AParams.stlPedidos.Count = 0) Then
        LMensagemErroExpedicao := LMensagemErroExpedicao + ' > SL = 0';

      Raise Exception.Create(LMensagemErroExpedicao);
    End;
  Except
    On E: Exception Do
    Begin
      pMensagemOk(E.Message);
      pGravarErro(True, E.Message);
      Exit(True);
    End;
  End;
end;

function fExistemInconsistenciasClienteExpedicao(AParams: TExpedicaoParams; const ADocumentos: TDocumentos): Boolean;
  Var
    strCodCliAux: String;
    intCnt : Integer;
begin
  {************************************************************************}
  {* COLOCADA ESSA VERIFICAÇÃO PARA TENTAR IDENTIFICAR EM QUE SISTUAÇÃO O *}
  {* CLIENTE CONSEGUIU MARCAR DOCUMENTO DE CLIENTES DIFERENTE REQ 66519   *}
  {*********************************************************************VA*}
  Result := False;

  If Not Assigned(AParams) Then
    Exit;

  If (Length(ADocumentos) = 0) Then
    Exit;

  If (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA) Then
    Exit;

  If Not MatchStr(VS_strTipExp, [TIPEXP_POR_PEDIDO_E_PEDIDO_SERA_FATURADO, TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO]) Then
    Exit;

  strCodCliAux := ADocumentos[0].strCodCli;
  For intCnt := Low(ADocumentos) To High(ADocumentos) Do
  Begin
    Try
      If (strCodCliAux <> ADocumentos[intCnt].strCodCli) And (not fPermitirMarcarPedidosDeClientesDiferentesNaExpedicao)  Then
      Begin
        Raise Exception.Create('Inconsistência de cliente na expedição! '+ #10#13 +
                               'Para prosseguir a expedição de itens com clientes diferentes, é necessário ativar a CFG_CLIXCP. '+ #10#13 +
                               ' Clientes diferentes: ' + strCodCliAux + ' / ' + ADocumentos[intCnt].strCodCli + '.');
      End;
    Except
      On E: Exception Do
      Begin
        pMensagemOk(E.Message);
        pGravarErro(True, E.Message);
        Exit(True);
      End;
    End;
  End;
end;

function fExistemInconsistenciasProdutosExpedicao(AParams: TExpedicaoParams): Boolean;
begin
  Result := False;

  If Not Assigned(AParams) Then
    Exit;

  If (AParams.VS_strTipExpInterna = TIPEXP_POR_DOCUMENTO_DE_VENDA) Then
    Exit;

  If Not MatchStr(VS_strTipExp, [TIPEXP_POR_PEDIDO_E_PEDIDO_SERA_FATURADO, TIPEXP_POR_PEDIDO_E_PEDIDO_NAO_SERA_FATURADO]) Then
    Exit;

  AParams.cdsItens.First;
  While (Not AParams.cdsItens.Eof) Do
  Begin
    Try
      If fFormataFloat(AParams.cdsItens.FieldByName('QTDEXP').AsFloat, fCfgSis('DECQTD', varInteger)) >
         fFormataFloat(AParams.cdsItens.FieldByName('QTDITE').AsFloat, fCfgSis('DECQTD', varInteger)) Then
      Begin
        Raise Exception.Create('Inconsistência de quantidade na expedição! Qtde.expedida: '+ AParams.cdsItens.FieldByName('QTDEXP').AsString +
                               ' / Qtde.item: '+ AParams.cdsItens.FieldByName('QTDITE').AsString +
                               '. Feche essa tela, atualize os documentos a serem expedidos e informe a Citel sobre essa notificação!');
      End;
    Except
      On E: Exception Do
      Begin
        pMensagemOk(E.Message);
        pGravarErro(True, E.Message);
        Exit(True);
      End;
    End;
    AParams.cdsItens.Next;
  End;
end;

function fTravaEmissaoDeCupomParaEcommerce(fatVenda: TFatVenda): Boolean;
begin
  Result := fatVenda.fTravaEmissaoDeCupomParaEcommerce;
end;

function fPermiteEmitirCupom(fatVenda: TFatVenda; blnComplementaInformandoQueSoPodeEmitirComoNf: Boolean=False): Boolean;
  Var
    strMotivo: String;
    intContador: Integer;
    docPedidos : TDocumentos;
    intCnt : Integer;
    blnCfgUsaSat: Boolean;
    strAuxMsg: String;
begin

  Result := True;
  strMotivo := '';

  If fatVenda.fObrigaCpfClientePedidoTipoFaturamentoCupom Then
  Begin
     If Not MatchStr(fatVenda.strTipPed,['C']) Then
       Exit;
  End
  Else If fatVenda.strEspDoc <> 'IF' Then
    Exit;

  If fatVenda.fPermiteIPISemDadosConsumidor Then
    Exit;

  blnCfgUsaSat := fUsaSat;

  If fatVenda.fPossuiBrindeProduto Then
    strMotivo := strMotivo + 'Não é permitido emitir cupom fiscal para itens de brinde.' + #13#10;

  If fatVenda.fltTotIpi > 0.0 Then
    strMotivo := strMotivo + 'Há produtos com IPI.' + #13#10;

  If fatVenda.blnEnt_CD And (Not fCfgSis('ENCDIF', varBoolean)) Then
    strMotivo := strMotivo + 'Não é permitido emitir cupom fiscal quando for entrega pelo CD.' + #13#10;

  If ((fatVenda.fltValFre > 0.0) Or (fatVenda.fRetValItemFrete > 0.0))
     And (Not fatVenda.fPermiteFreteNoCupomFiscal) Then
    strMotivo := strMotivo + 'Foi informado um valor de frete.' + #13#10;

  If (fatVenda.blnCliFil) Then
    strMotivo := strMotivo + 'Não é permitido cupom fiscal para cliente filial.' + #13#10;

  If fCfgSis('CF_CPF', varBoolean) And (fatVenda.fltTotGer >= fCfgSis('VLMCPF', varDouble)) Then
  Begin
    If (fEmptyStr(fatVenda.strCliCgc)) Then
      strMotivo := strMotivo + 'Cliente não possui CPF / CNPJ. Não será permitido emitir Cupom Fiscal no valor de ' + FormatFloat('0.00', fCfgSis('VLMCPF', varDouble)) + ' ou superior.' + #13#10
    Else If (fReplicatorStr(fatVenda.strCliCgc[1], Length(fatVenda.strCliCgc)) = fatVenda.strCliCgc) And
            (fatVenda.fTrocaUFEndEntrega <> 'EX') Then
      strMotivo := strMotivo + 'O CPF / CNPJ do cliente não é válido para emitir Cupom Fiscal no valor de ' + FormatFloat('0.00', fCfgSis('VLMCPF', varDouble)) + ' ou superior.' + #13#10;
  End;

  If Not fCfgSis('USNFCE', varBoolean) Then
  Begin
    If fatVenda.fltTotRet > 0.0 Then
      strMotivo := strMotivo + 'Há substituição tributária.' + #13#10;

    If fatVenda.fltDesAce > 0.0 Then
      strMotivo := strMotivo +  'Foi informado um valor de despesas acessórias.' + #13#10;

    If (Not fCfgSis('EMIFPJ', varBoolean)) And (Length(fatVenda.strCliCgc) > 11) Then
      strMotivo := strMotivo + 'Não é permitido emitir cupom fiscal para pessoa jurídica.' + #13#10;

    For intContador := Low(fatVenda.arrMatItens) To High(fatVenda.arrMatItens) Do
    Begin
      If (fTruncaFloat(fatVenda.arrMatItens[intContador].fltQtdIte * fatVenda.arrMatItens[intContador].fltUnitar, 2) < fFormataFloat(0.01, 2))
        And (Not fatVenda.fEmissaoPedidoBrinde()) Then
      Begin
        strMotivo := strMotivo + 'Item ' + fatVenda.arrMatItens[intContador].strCodIte + ' está com total no ECF menor que 0,01.';
      End;

      If (blnCfgUsaSat) And (fatVenda.arrMatItens[intContador].fltTotIte > 10000.00) Then
      Begin
        strMotivo := strMotivo + 'Item ' + fatVenda.arrMatItens[intContador].strCodIte + ' tem total maior que 10.000,00.';
      End;

      If (blnCfgUsaSat) And (Pos(RightStr(fatVenda.arrMatItens[intContador].strCodSit, 2), '10_70_') > 0) Then
      Begin
        strMotivo := strMotivo + 'Item ' + fatVenda.arrMatItens[intContador].strCodIte + ' com CST inválida para CFe ' +
          fatVenda.arrMatItens[intContador].strCodSit;
      End;
    End;
  End
  Else
  Begin
    If (Not fCfgSis('NFCEPJ', varBoolean)) And (Length(fatVenda.strCliCgc) > 11) And (not fEmptyStr(fatVenda.strCliIes)) Then
      strMotivo := strMotivo + 'Não é permitido emitir NFCe para pessoa jurídica contribuinte.' + #13#10;
  End;

  If (fatVenda.strOpcDoc = 'CP') Or (fatVenda.blnExpedi) Then
  Begin
    docPedidos := fatVenda.fRetPedidosDosItens(fatVenda.arrMatItens);
    If Length(docPedidos) > 0 Then
    Begin
      For intCnt := Low(docPedidos) To High(docPedidos) Do
      Begin
        If fPedidoTemIpi(docPedidos[intCnt].strNumDoc,
                         docPedidos[intCnt].strEspDoc,
                         docPedidos[intCnt].strCodEmp,
                         docPedidos[intCnt].strCodCli) Then
          strMotivo := strMotivo + Format('O pedido [%s] que está ' + IIF(fatVenda.blnExpedi, 'expedindo', 'confirmando') +
                                          ' possui produtos com IPI.', [docPedidos[intCnt].strNumDoc + '-' +
                                                                        docPedidos[intCnt].strEspDoc + '-' +
                                                                        docPedidos[intCnt].strCodEmp]) + #13#10;
      End;
    End;
  End
  Else
  Begin
    If (Not fEmptyStr(fatVenda.strNumOrc)) Then
    Begin
      If fPedidoTemIpi(fatVenda.strNumOrc, fatVenda.strEspOrc, fatVenda.strEmpOri, fatVenda.strCodCli) Then
        strMotivo := strMotivo + 'O ' + IIF(fatVenda.strEspOrc = 'PD', 'pedido', 'orçamento') + ' que está confirmando possui produtos com IPI.' + #13#10;
    End;
  End;

  If Not fEmptyStr(strMotivo) Then
  Begin
    strAuxMsg := '';
    If blnComplementaInformandoQueSoPodeEmitirComoNf Then
      strAuxMsg := #10#13+'A confirmação terá que ser em nota fiscal!';

    Result := False;
    fMensagem('ATENÇÃO!', 'Não será possível emitir cupom fiscal. Motivo(s): ' + #13#10 + strMotivo + strAuxMsg, ['&Ok']);
  End;

end;

{***************************************************************************************}
{* NAO SERA PERMITIDO EMITIR CUPOM PARA CLIENTES FORA DO ESTADO COM INSCRICAO ESTADUAL *}
{*********************************************************************************JC,RN*}
function fPermiteEmitirCupomParaForaDoEstado(fatVenda: TFatVenda; blnComplementaInformandoQueSoPodeEmitirComoNf: Boolean=False): Boolean;
begin
  Result := fPermiteEmitirCupomParaForaDoEstado(fatVenda.strEspDoc, fatVenda, blnComplementaInformandoQueSoPodeEmitirComoNf);
end;

function fPermiteEmitirCupomParaForaDoEstado(strEspDoc: string; fatVenda: TFatVenda; blnComplementaInformandoQueSoPodeEmitirComoNf: Boolean=False): Boolean; overload;
var
  LItem: TDadosFechamento;
begin
  Result := True;
  for LItem in fatVenda.arrMatItens do
    if not fPermiteEmitirCupomParaForaDoEstado(strEspDoc, fatVenda.fTrocaUFEndEntrega, fatVenda.fGetUFEmpresa(LItem.strEmpIte), fatVenda.strCliIes, fatVenda.blnVendaPresencial, blnComplementaInformandoQueSoPodeEmitirComoNf) then
      Exit(False);
end;

function fPermiteEmitirCupomParaForaDoEstado(strEspDoc, strCliEst, strEmpEst, strCliIes: String; blnVendaPresencial: Boolean; blnComplementaInformandoQueSoPodeEmitirComoNf: Boolean=False): Boolean;
Var
  blnCupFor: Boolean;
  blnForEst: Boolean;
  strAuxMsg: String;
begin
  Result := True;

  If (Not MatchStr(strEspDoc, ['IF', 'IV'])) Then
    Exit;

  blnCupFor := fCfgSis('CUPFOR', varBoolean);
  blnForEst := (Not blnVendaPresencial) And (strCliEst <> strEmpEst);

  strAuxMsg := '';
  If blnComplementaInformandoQueSoPodeEmitirComoNf Then
    strAuxMsg := #10#13+'A confirmação terá que ser em nota fiscal!';
    
  If (blnForEst) Then
  Begin
    If (Not blnCupFor) Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido emitir cupom fiscal para clientes fora do estado!'+strAuxMsg, ['&OK']);
      Result := False;
    End
    Else If (Not fEmptyStr(strCliIes)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido emitir cupom fiscal para clientes fora do estado com inscrição estadual!'+strAuxMsg, ['&OK']);
      Result := False;
    End;
  End;
end;

function TFatVenda.fCalculaValorBruto: Double;
  Var
    intContador: Integer;
Begin
  Result := 0;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin

    With arrMatItens[intContador] Do
      Result := Result + (fltUniOri * fltQtdIte);

  End;


End;

procedure TFatVenda.pMensagemPedidoAlterado(strNumDoc, strEspDoc, strCodEmp: String);
Var
  msgMensagem : TMsgInterna;
  qryCadOpe,
  qryFatGor   : TUniQuery;
  stlMensagem : TStringList;
Begin

  if strEspDoc <> 'PD' then
    Exit;

  try

    qryCadOpe := fCriaQuery;
    qryFatGor := fCriaQuery;

    qryCadOpe.Close;
    qryCadOpe.SQL.Clear;
    qryCadOpe.SQL.Add('SELECT');
    qryCadOpe.SQL.Add('  OPE_CODOPE AS CODOPE');
    qryCadOpe.SQL.Add('FROM');
    qryCadOpe.SQL.Add('  CADOPE');
    qryCadOpe.SQL.Add('WHERE');

    {Somente para operadores que tenham direitos de acesso a empresa}
    qryCadOpe.SQL.Add('  LOCATE(:CODEMP, OPE_EMPACE) > 0 AND ');
    qryCadOpe.SQL.Add('  OPE_MSGPAL = "S"');

    qryCadOpe.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryCadOpe.Open;

    if not qryCadOpe.IsEmpty Then
    begin

      {Busca informações do pedido}
      qryFatGor.Close;
      qryFatGor.SQL.Clear;
      qryFatGor.SQL.Add('SELECT');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODCLI,');
      qryFatGor.SQL.Add('  CADCLI.CLI_NOMCLI,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODVEN,');
      qryFatGor.SQL.Add('  CADOPE.OPE_NOMOPE,');
      qryFatGor.SQL.Add('  FATGOR.FGO_NUMDOC,');
      qryFatGor.SQL.Add('  FATGOR.FGO_DTAENT,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CONPAG,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODCND,');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODFPG,');
      qryFatGor.SQL.Add('  FATGOR.FGO_VLRCON');
      qryFatGor.SQL.Add('FROM');
      qryFatGor.SQL.Add('  FATGOR');
      qryFatGor.SQL.Add('  INNER JOIN CADCLI ON (CADCLI.CLI_CODCLI = FATGOR.FGO_CODCLI)');
      qryFatGor.SQL.Add('  INNER JOIN CADOPE ON (CADOPE.OPE_CODOPE = FATGOR.FGO_CODVEN)');
      qryFatGor.SQL.Add('WHERE');
      qryFatGor.SQL.Add('  FATGOR.FGO_NUMDOC = :NUMDOC AND');
      qryFatGor.SQL.Add('  FATGOR.FGO_ESPDOC = :ESPDOC AND');
      qryFatGor.SQL.Add('  FATGOR.FGO_CODEMP = :CODEMP');

      qryFatGor.ParamByName('NUMDOC').AsString := strNumDoc;
      qryFatGor.ParamByName('ESPDOC').AsString := strEspDoc;
      qryFatGor.ParamByName('CODEMP').AsString := strCodEmp;
      qryFatGor.Open;

      if not qryFatGor.IsEmpty then
      begin

        msgMensagem := TMsgInterna.Create(Self);
        stlMensagem := TStringList.Create;
        stlMensagem.Clear;

        stlMensagem.Add('ALTERADO: ' + DateToStr(untFuncoesSimples.VS_Date));
        stlMensagem.Add('DOCUMENTO: ' + strNumDoc + '-' + strEspDoc + '-' + strCodEmp);
        stlMensagem.Add('CLIENTE: ' + qryFatGor.FieldByName('FGO_CODCLI').AsString + '-' + qryFatGor.FieldByName('CLI_NOMCLI').AsString);

        if fCfgSis('USACND', varBoolean) then
        begin
          stlMensagem.Add('CONDIÇÃO DE PAGAMENTO: ' + qryFatGor.FieldByName('FGO_CODCND').AsString + '-' + fRetDesConPag(qryFatGor.FieldByName('FGO_CODCND').AsString));
          stlMensagem.Add('                       (' + qryFatGor.FieldByName('FGO_CODCND').AsString + ')' + fFormataCondPag(qryFatGor.FieldByName('FGO_CONPAG').AsString));
        end
        else
        begin
          stlMensagem.Add('CONDIÇÃO DE PAGAMENTO: (' + qryFatGor.FieldByName('FGO_CODCND').AsString + ')' + fFormataCondPag(qryFatGor.FieldByName('FGO_CONPAG').AsString));
        end;

        stlMensagem.Add('VENDEDOR: ' + qryFatGor.FieldByName('FGO_CODVEN').AsString + '-' + qryFatGor.FieldByName('OPE_NOMOPE').AsString);
        stlMensagem.Add('TOTAL DO DOCUMENTO: ' + FormatFloat('###,#0.00', qryFatGor.FieldByName('FGO_VLRCON').AsFloat));

        qryCadOpe.First;
        While Not qryCadOpe.Eof Do
        Begin
          msgMensagem.fEnviaMensagem('PEDIDO ALTERADO: ' + strNumDoc,
                                     stlMensagem.Text,
                                     qryFatGor.FieldByName('FGO_CODVEN').AsString,
                                     qryCadOpe.FieldByName('CODOPE').AsString,
                                     'N',
                                     '');
          qryCadOpe.Next;
        End;

        FreeAndNil(msgMensagem);
        FreeAndNil(stlMensagem);

      end;

    end;

  finally
    FreeAndNil(qryCadOpe);
    FreeAndNil(qryFatGor);
  end;

End;

class procedure TFatVenda.pMensagemGarantiaEnvioCliente(strCodCli: String);
var
  objMovGag: TMovGag;
begin
  if not(fCfgSis('GARAVI', varBoolean)) then
    Exit;

  objMovGag := TMovGag.Create(nil);
  Try
    objMovGag.objMovGad.pCarregaProdutosDevolucao(strCodCli);
    If Not objMovGag.objMovGad.qryCliente.IsEmpty Then
      pMensagemOk('Cliente com garantia finalizada - ' + '(' + strCodCli + ') - ' +
        'Aguardando envio para o cliente!');
  Finally
    FreeAndNil(objMovGag);
  End;
end;

procedure TFatVenda.pMensagemOrcamentoPedido(blnImpSfa: Boolean = False);
  Var
    msgMensagem: TMsgInterna;
    qryCadOpe  : TUniQuery;
    stlMensagem: TStringList;
    blnEnvia : Boolean;
Begin
  qryCadOpe   := fCriaQuery;

  With qryCadOpe, SQL Do
  Begin
    Clear;
    Add('SELECT OPE_CODOPE AS CODOPE FROM CADOPE');
    Add('WHERE LOCATE(:CODEMP, OPE_EMPACE) > 0 AND '); //Somente para operadores que tenham direitos de acesso a empresa

    If not blnImpSfa Then
    Begin
      If strEspDoc = 'OR' Then
        Add(' OPE_MSGORC = "S"')
      Else
        Add(' OPE_MSGPED = "S"');
    End
    Else
      Add(' OPE_MSGTAB = "S"');

    ParamByName('CODEMP').AsString := VS_strCodEmp;
    Open;

    If Not IsEmpty Then
    Begin
      msgMensagem := TMsgInterna.Create(Self);
      stlMensagem := TStringList.Create;
      stlMensagem.Clear;
      stlMensagem.Add('EMISSÃO: ' + DateToStr(Self.VS_Date));
      stlMensagem.Add('DOCUMENTO: ' + FNumDoc + '-' + FEspDoc + '-' + VS_strCodEmp);
      If (FTipOpe = 'V') Then
        stlMensagem.Add('TIPO: ' + 'VENDA')
      Else If (FTipOpe = 'B') Then
        stlMensagem.Add('TIPO: ' + 'BONIFICAÇÃO')
      Else If (FTipOpe = 'C') Then
        stlMensagem.Add('TIPO: ' + 'CONTA E ORDEM');
      stlMensagem.Add('CLIENTE: ' + strCodCli + '-' + strCliNom);
      stlMensagem.Add('CONDIÇÃO DE PAGAMENTO: ' + fFormataCondPag(strConPag)+ '-' + fRetDesConPag(strConPag) );
      stlMensagem.Add('VENDEDOR: ' + strCodVen + '-' + fRetNomVendRep(strCodVen));
      stlMensagem.Add('TOTAL DO DOCUMENTO: ' + FormatFloat('#,##0.00', fltTotGer));

      First;
      While Not Eof Do
      Begin
        blnEnvia := True;
        If (blnImpSfa) Then
        Begin
          blnEnvia := (fVerificaAcessoSistema('frmCtrLiberacaoFiltros', FieldByName('CODOPE').AsString));
          If (Not blnEnvia) And (fCfgSis('AGDLBT', VarBoolean) Or (fCfgSis('AGDLIB', varBoolean) And fCfgSis('LPPDBL', varBoolean))) Then
            blnEnvia := (fVerificaAcessoSistema('frmCtrLiberacaoFiltrosComercial', FieldByName('CODOPE').AsString));
        End;

        If (blnEnvia) Then
        Begin
          msgMensagem.fEnviaMensagem('NOVO ' + IIF(strEspDoc = 'PD', 'PEDIDO ', 'ORÇAMENTO ') + IIF(blnImpSfa,' TABLET/SITE ','')  + FNumDoc,
                                     stlMensagem.Text,
                                     strCodVen,
                                     FieldByName('CODOPE').AsString, 'N', '');
        End;

        Next;
      End;

      FreeAndNil(msgMensagem);
      FreeAndNil(stlMensagem);

    End;

    Close;
  End;

  FreeAndNil(qryCadOpe);
End;

Function TFatVenda.fCalculaTotalItem(strIdeProIte: String; fltUnitar, fltQtdIte, fltPreEmb, fltQtdEmb: Double): Double;
  Var
    fltPrecoEmb: Double;
Begin
  fltPrecoEmb := 0.0;

  Result := fFormataFloat((fltQtdIte * fltUnitar) + fltPrecoEmb, 02);
End;

