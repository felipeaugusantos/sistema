{*************************************}
{* VERIFICA NAO COMPRA DO CLIENTE    *}
{**********************************WI*}
function TFatVenda.fVerificaNaoCompra(Var blnExecutouTrava: Boolean; strSenVen: String = ''; strOpcDocumento: String = ''; blnPedeSenha: Boolean = True;
  blnExecutaTrava: Boolean = True): Boolean;
  Var
    fltDataCadastro : Double;
    fltUltimaComp   : Double;
    fltMaxNCompra   : Double;
    strTraNCompra   : String;
    strSenNCompra   : String;
    strAux          : String;
    blnNuncaComprou : Boolean;
    objLiberacao    : TLiberacao;

Begin

  Result := True;
  blnExecutouTrava := False;

  If Not blnExecutaTrava Then
    Exit;

  If fEmptyStr(strOpcDocumento) Then
    strOpcDocumento := strOpcDoc;

  If (strOpcDocumento = 'VN') And (Pos(Self.strEspDoc, 'PD_OR_') > 0) Then
    strOpcDocumento := Self.strEspDoc;

  If (Pos(strOpcDocumento, 'OU_OV_NC_BR_TE_OE_EF_OF_CF_CI_UC_') <= 0) And (Not blnComVal) Then
  Begin

    If True                   Then strAux := 'V'; //vendas
    If strOpcDocumento = 'OR' Then strAux := 'O'; //orçamentos
    If strOpcDocumento = 'PD' Then strAux := 'P'; //pedidos
    If strOpcDocumento = 'PR' Then strAux := 'P'; //pedidos de devolucao

    fltMaxNCompra := fCfgSis('DIANC' + strAux, varInteger);
    strTraNCompra := fCfgSis('TRANC' + strAux, varString );
    strSenNCompra := fCfgSis('SENNC' + strAux, varString );

    fltDataCadastro := fMaxDataCliRede('CLI_DTACAD');

    fltUltimaComp := fMaxDataCliRede('CLI_ULTCOM');
    If (fltUltimaComp = 0) Then
    Begin
      blnNuncaComprou := True;
      fltUltimaComp   := fltDataCadastro;
    End
    Else
      blnNuncaComprou := False;

    pRemoverTravaLogAvi('COMPR', strNTrava);

    If (Pos(strTraNCompra, 'A_T_') > 0) And ((Self.VS_Date - fltUltimaComp) >= fltMaxNCompra) Then
    Begin
      {**************************************}
      {* TRATAMENTO DE SENHA FIXA, VARIAVEL *}
      {* OU USUARIO                         *}
      {***********************************WI*}
      objLiberacao := TLiberacao.Create;
      try
        If (blnNuncaComprou) Then
          objLiberacao.objMsgLibera.pAddTexto('Este Cliente Nunca Comprou.')
        Else
          objLiberacao.objMsgLibera.pAddTexto('Este Cliente Não Compra a ' + Trim(FloatToStr(Self.VS_Date - fltUltimaComp)) + ' dia(s).');

        objLiberacao.objMsgLibera.pAddQuebra;

        objLiberacao.objMsgLibera.pAddTextoCaption('Cliente', strCodCli + ' - ' + strCliNom);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cidade', strCliCid + ' - ' + strCliEst);
        objLiberacao.objMsgLibera.pAddTextoCaption('CPF/CNPJ', strCliCgc);
        objLiberacao.objMsgLibera.pAddTextoCaption('Data do Cadastro', FormatDateTime('dd/mm/yyyy', fltDataCadastro));

        if not blnNuncaComprou then
          objLiberacao.objMsgLibera.pAddTextoCaption('Data da Última Compra', FormatDateTime('dd/mm/yyyy', fltUltimaComp));

        objLiberacao.objMsgLibera.pAddQuebra;

        if not fEmptyStr(strNomVen) then
          objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor', strNomVen);

        if not fEmptyStr(strNomRep) then
          objLiberacao.objMsgLibera.pAddTextoCaption('Representante', strNomRep);

        If (Not blnPedeSenha) Then
          pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem);

        objLiberacao.strDirAce := 'COMPR';
        objLiberacao.blnTraTel := (strTraNCompra = 'T');
        objLiberacao.strSenLib := strSenNCompra;
        objLiberacao.strMsgSen := 'Senha Nao Compra';
        objLiberacao.strCodOpe := IIF(fEmptyStr(strCodVen), strSenVen, strCodVen);
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);


        Result := blnPedeSenha And fFatMensagemLiberacao(objLiberacao);
        blnExecutouTrava := Result;
      finally
        FreeAndNil(objLiberacao);
      end;
    End;

  End;

End;

{*******************************************}
{* VERIFICA CONSULTA DE CREDITO DO CLIENTE *}
{****************************************JC*}
function TFatVenda.fVerificaConsultaDadosCobranca(const strCndPag, strForPag: String; strSenVen: String = ''; blnPedeSenha: Boolean = True): Boolean;
  var
    intTVCLQD: Integer;
    strTravaSemConsultaDeCredito: string;
    strTravaSemConsultaDeDadosDeCobranca: string;
    strTVCLCP: string;
    dteDataConsDadosCob: TDateTime;
    strCondicaoPag: String;
    objLiberacao : TLiberacao;
    strTipoDocReferencia: string;
begin
  Result := True;

  strTVCLCP := fCfgSis('TVCLCP', varString);
  intTVCLQD := fCfgSis('TVCLQD', varInteger);

  if ((strOpcDoc = 'OR') And (strEspDoc = 'PD')) Or
     ((strOpcDoc = 'VN') And (strEspDoc = 'OR')) then
    strTipoDocReferencia := strEspDoc
  else
    strTipoDocReferencia := strOpcDoc;

  If fCfgSis('USACND', varBoolean) And
     fCfgSis('PFLCLI', varBoolean) Then
  begin
    if strTipoDocReferencia = 'OR' then
    begin
      strTravaSemConsultaDeCredito := fCampoTabela('CND_TRORCR', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);
      strTravaSemConsultaDeDadosDeCobranca := fCampoTabela('CND_TRORCB', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);
    end
    else
    begin
      strTravaSemConsultaDeCredito := fCampoTabela('CND_TRCLCR', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);
      strTravaSemConsultaDeDadosDeCobranca := fCampoTabela('CND_TRCLCB', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);
    end;
  end
  Else
  begin
    strTravaSemConsultaDeCredito := fCfgSis('TVCLOP', varString);
    strTravaSemConsultaDeDadosDeCobranca := fCfgSis('TVCLOP', varString);
  end;

  If ((strTravaSemConsultaDeCredito = 'N') Or (intTVCLQD = 0)) and
     (strTravaSemConsultaDeDadosDeCobranca = 'N') Then
  begin
    Exit;
  end;

  dteDataConsDadosCob := fCampoTabela('CLI_DTCOCB', 'CADCLI', ['CLI_CODCLI'], [Self.strCodCli]);

  strCondicaoPag := strCndPag;

  {************************************************}
  {* CARTAO DEVE SER CONSIDERADO A VISTA NA TRAVA *}
  {*********************************************JC*}
  If strForPag = '007' Then
    strCondicaoPag := '01000';

  If (Pos(strTVCLCP, 'P_V_') > 0) And (Not fEmptyStr(strCondicaoPag)) Then
  Begin
     If ((strTVCLCP = 'P') And (fStatusCndPag(strCondicaoPag) <> A_PRAZO)) Or
        ((strTVCLCP = 'V') And (fStatusCndPag(strCondicaoPag) <> A_VISTA)) Then
     begin
       Exit;
     end;
  End;

  pRemoverTravaLogAvi('CLCDCB', strNTrava);

  If ((Pos(strTravaSemConsultaDeCredito, 'A_T_') > 0) or (Pos(strTravaSemConsultaDeDadosDeCobranca, 'A_T_') > 0)) And
     ((dteDataConsDadosCob + intTVCLQD) <= Self.VS_Date) And
     (Pos(strOpcDoc, 'DV_PR_') <= 0) And
     (Not fDocumentoParaFornecedor) Then
  Begin
    objLiberacao := TLiberacao.Create;
    try
      If dteDataConsDadosCob = 0 Then
        objLiberacao.objMsgLibera.pAddTexto('É necessário atualizar os dados de cobrança do cliente.')
      Else
      Begin
        objLiberacao.objMsgLibera.pAddTexto('É necessário atualizar os dados de cobrança do cliente.');
        objLiberacao.objMsgLibera.pAddTexto('Expirou o prazo da última consulta, ' + Trim(FloatToStr(Self.VS_Date - (dteDataConsDadosCob + intTVCLQD))) + ' dia(s).');
        objLiberacao.objMsgLibera.pAddQuebra;
        objLiberacao.objMsgLibera.pAddTextoCaption('Data da última consulta', FormatDateTime('dd/mm/yyyy', dteDataConsDadosCob));
      End;

      objLiberacao.strDirAce := 'CLCDCB';
      objLiberacao.blnTraTel := (strTravaSemConsultaDeCredito = 'T') or (strTravaSemConsultaDeDadosDeCobranca = 'T');
      objLiberacao.strMsgSen := 'Senha consulta de dados de cobrança';
      objLiberacao.strCodOpe := IIF(fEmptyStr(Self.strCodVen), strSenVen, Self.strCodVen);
      objLiberacao.strCodDig := Self.strCodDig;
      objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliOri;
      objLiberacao.strCpfCnpj := strCliCgc;
      objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

      If (Not fEmptyStr(Self.strCodCnd)) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Condição de Pagamento', Self.strCodCnd + '-' + fRetDesConPag(Self.strCodCnd));

      If (Not fEmptyStr(Self.strCodFpg)) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagamento', Self.strCodFpg + '-' + fRetDesForPag(Self.strCodFpg));

      If (Self.fltTotGer > 0) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor desta Venda',FormatFloat('#,##0.00', Self.fltTotGer)) ;

      Result := fFatMensagemLiberacao(objLiberacao);
    finally
      FreeAndNil(objLiberacao);
    end;
  end;

end;

function TFatVenda.fVerificaConsultaDeCredito(const strCndPag, strForPag, strOpcDoc: String; strSenVen: String = ''; blnPedeSenha: Boolean = True): Boolean;
  Var
    fltUltConsulta: Double;
    fltMaxCCredito: Double;
    strTravaSemConsultaDeCredito: String;
    strSenCCredito: String;
    strCndCCredito: String;
    strCondicaoPag: String;
    objLiberacao  : TLiberacao;
    strTipoDocReferencia: string;
Begin

  Result := True;

  fltMaxCCredito := fCfgSis('QTEXCC', varInteger);
  strSenCCredito := fCfgSis('SENSCC', varString );
  strCndCCredito := fCfgSis('CDCSCC', varString );

  if ((strOpcDoc = 'OR') And (strEspDoc = 'PD')) Or
     ((strOpcDoc = 'VN') And (strEspDoc = 'OR')) then
    strTipoDocReferencia := strEspDoc
  else
    strTipoDocReferencia := strOpcDoc;

  If fCfgSis('USACND', varBoolean) And
     fCfgSis('PFLCLI', varBoolean) Then
  begin
    if strTipoDocReferencia = 'OR' then
      strTravaSemConsultaDeCredito := fCampoTabela('CND_TRORCR', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd])
    else
      strTravaSemConsultaDeCredito := fCampoTabela('CND_TRCLCR', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);
  end
  Else
  begin
    if strTipoDocReferencia = 'OR' then
      strTravaSemConsultaDeCredito := fCfgSis('TCSCCO', varString)
    else
      strTravaSemConsultaDeCredito := fCfgSis('TRCSCC', varString);
  end;

  strCondicaoPag := strCndPag;

  {************************************************}
  {* CARTAO DEVE SER CONSIDERADO A VISTA NA TRAVA *}
  {*********************************************JC*}
  If strForPag = '007' Then
    strCondicaoPag := '01000';

  If (Pos(strCndCCredito, 'P_V_') > 0) And (Not fEmptyStr(strCondicaoPag)) Then
  Begin
     If ((strCndCCredito = 'P') And (fStatusCndPag(strCondicaoPag) <> A_PRAZO)) Or
        ((strCndCCredito = 'V') And (fStatusCndPag(strCondicaoPag) <> A_VISTA)) Then
       Exit;
  End;

  fltUltConsulta := fCampoTabela('CLI_DTACON', 'CADCLI', ['CLI_CODCLI'], [Self.strCodCli]);

  pRemoverTravaLogAvi('CONCC', strNTrava);

  If (Pos(strTravaSemConsultaDeCredito, 'A_T_') > 0) And
     ((Self.VS_Date - fltUltConsulta) >= fltMaxCCredito) And
     (Pos(strOpcDoc, 'DV_PR_') <= 0) And
     (Not fDocumentoParaFornecedor) Then
  Begin

    objLiberacao := TLiberacao.Create;
    try
      {**************************************}
      {* TRATAMENTO DE SENHA FIXA, VARIAVEL *}
      {* OU USUARIO                         *}
      {***********************************JC*}
      If fltUltConsulta = 0 Then
        objLiberacao.objMsgLibera.pAddTexto('É necessário atualizar os dados da consulta de crédito do cliente.')
      Else
      Begin
        objLiberacao.objMsgLibera.pAddTexto('É necessário atualizar os dados da consulta de crédito do cliente.');
        objLiberacao.objMsgLibera.pAddTexto('Expirou o prazo da última consulta, ' + Trim(FloatToStr(Self.VS_Date - fltUltConsulta)) + ' dia(s).');
        objLiberacao.objMsgLibera.pAddQuebra;
        objLiberacao.objMsgLibera.pAddTextoCaption('Data da última consulta', FormatDateTime('dd/mm/yyyy', fltUltConsulta));
      End;

      If (Not blnPedeSenha) Then
        pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem);

      objLiberacao.strDirAce := 'CONCC';
      objLiberacao.blnTraTel := strTravaSemConsultaDeCredito = 'T';
      objLiberacao.strSenLib := strSenCCredito;
      objLiberacao.strMsgSen := 'Senha consulta de crédito';
      objLiberacao.strCodOpe := IIF(fEmptyStr(Self.strCodVen), strSenVen, Self.strCodVen);
      objLiberacao.strCodDig := Self.strCodDig;
      objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliOri;
      objLiberacao.strCpfCnpj := strCliCgc;
      objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

      If (Not fEmptyStr(Self.strCodCnd)) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Condição de Pagamento', Self.strCodCnd + '-' + fRetDesConPag(Self.strCodCnd));

      If (Not fEmptyStr(Self.strCodFpg)) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagamento', Self.strCodFpg + '-' + fRetDesForPag(Self.strCodFpg));

      If (Self.fltTotGer > 0) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor desta Venda',FormatFloat('#,##0.00', Self.fltTotGer)) ;

      pMostraMensagemFechamentoEhOrcemPed(objLiberacao.objMsgLibera);

      Result := blnPedeSenha And fFatMensagemLiberacao(objLiberacao);

    finally
      FreeAndNil(objLiberacao);
    end;
  End;

End;

{*******************************************}
{* VERIFICA VALOR PERMITIDO PARA CREDIARIO *}
{****************************************JC*}
function TFatVenda.fVerificaValorCrediario(strSenVen: String = ''; blnPedeSenha: Boolean = True): Boolean;
  Var
    fltValorTrava : Double;
    strTravaValCre: String;
    strSenhaValCre: String;
    objLiberacao : TLiberacao;
Begin
  Result := True;

  If Not fCfgSis('SISCRE',varBoolean) Then
    Exit;

  fltValorTrava  := fCfgSis('VLRCRE', varDouble);
  strTravaValCre := fCfgSis('TRVLCR', varString);
  strSenhaValCre := fCfgSis('SENVCR', varString);

  If (Pos(strTravaValCre, 'A_T_') > 0) And (fltValorTrava > 0) And (Self.fltTotGer > fltValorTrava) Then
  Begin
    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('O valor da venda ultrapassou o valor permitido para crediário.');
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor da venda', FloatToStrF(Self.fltTotGer, ffNumber, 12, 2));
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor permitido', FloatToStrF(fltValorTrava,  ffNumber, 12, 2));

      pMostraMensagemFechamentoEhOrcemPed(objLiberacao.objMsgLibera);

      If (Not blnPedeSenha) Then
        pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem);

      objLiberacao.strDirAce := 'VLCRE';
      objLiberacao.blnTraTel := strTravaValCre = 'T';
      objLiberacao.strSenLib := strSenhaValCre;
      objLiberacao.strMsgSen := 'Senha valor de Crediário';
      objLiberacao.strCodOpe := IIF(fEmptyStr(Self.strCodVen), strSenVen, Self.strCodVen);
      objLiberacao.strCodDig := Self.strCodDig;
      objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliOri;
      objLiberacao.strCpfCnpj := strCliCgc;
      objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

      Result := blnPedeSenha And fFatMensagemLiberacao(objLiberacao);
    finally
      FreeAndNil(objLiberacao);
    end;
  End;

End;

function TFatVenda.fImprimeListaItem(strCodEmp, strCodIte: String): Boolean;
  Var qryIteger: TUniQuery;
Begin

  qryIteger := fCriaQuery;

  With qryIteger, SQL Do
  Begin
    Clear;
    Add('SELECT ITE_CODEMP, EMP_CODEMP AS CODEMP, EMP_NOMEMP AS NOMEMP FROM ITEGER');
    Add('INNER JOIN CADEMP ON ITE_CODEMP = EMP_CODEMP');
    Add('WHERE');
    Add('  ITE_CODITE = :CODITE AND ');
    Add('  ITE_IMPLIS = "S"');
    Add('ORDER BY EMP_CODEMP');

    ParamByName('CODITE').AsString := strCodIte;

    Open;

    Result := Locate('ITE_CODEMP', strCodEmp, []);

    If (Not Result) Then
    Begin

      If (Not IsEmpty) Then
      Begin

        If Assigned(prcExecutaRelatorio) Then
        begin
          prcExecutaRelatorio(186, 7461, [],
                            ['CODITE'],
                            [strCodIte],
                            nil,
                            nil,
                            True);
        End;

      End

      Else

        fMensagem('ATENÇÃO!', 'Item inativo para essa empresa!', ['&Ok']);

    End;

    Close;
  End;

  FreeAndNil(qryIteger);
End;

function TFatVenda.fValidaImprimeListaTodosItens(cdsItensVenda: TUniClientDataSet): Boolean;
  Var
    cdsDados: TUniClientDataSet;
begin
  Result := True;

  If (Not fCfgSis('EXILIS', varBoolean)) Then
  Begin
    cdsDados := TUniClientDataSet.Create(Self);
    pCloneDataSet(cdsDados, cdsItensVenda);

    cdsDados.First;

    While Not cdsDados.Eof Do
    Begin
      If (Not fImprimeListaItem(cdsDados.FieldByName('ITE_EMPITE').AsString,
                                cdsDados.FieldByName('ITE_CODITE').AsString)) Then
      Begin
        Result := False;
      End;
      cdsDados.Next;
    End;

    FreeAndNil(cdsDados);
  End;
end;

procedure TFatVenda.pMsgPodeTrocarEmpresaItensPREPTE(Const stlItens: TStringList);
begin
  If (stlItens.Count > 0) Then
  Begin
    fMensagem('ATENÇÃO!', 'O pedido ' + Self.strNumOrc + '-' + Self.strEspOrc + ' não pode sofrer alteração na empresa responsável ' +
                          'pela entrega do item porque ele possui solicitação de transferência ' +
                          'gerada anteriormente (PREPTE) e este pedido pode até já estar sendo separado na filial.' + #10+#13+
                          'Para alterar a empresa que vai entregar este produto, é necessário efetuar o ' +
                          'cancelamento dessa solicitação de transferência ou, cancelar e refazer o pedido.' + #10+#13+
                          'Veja abaixo a lista dos itens que possuem solicitação de transferência:' + #10+#13 +
                          stlItens.Text, ['&OK']);
  End;
end;


function TFatVenda.fPodeTrocarEmpresaItensPREPTE():Boolean;
var
  stlItens: TStringList;
begin
  stlItens := TStringList.Create;
  Try
    Result := fPodeTrocarEmpresaItensPREPTE(True, stlItens);
  Finally
    FreeAndNil(stlItens);
  End;
end;

function TFatVenda.fPodeTrocarEmpresaItensPREPTE(blnItemPosicionado: Boolean; Var stlItens: TStringList):Boolean;
begin
  Result := True;

  If fEmptyStr(Self.strNumOrc) Then
    Exit;

  If fExisteRegistroPREPTEDocumento(Self.strNumOrc, Self.strEspOrc, VS_strCodEmp, cdsVenda.FieldByName('ITE_CODITE').AsString) Then
  Begin
    stlItens.Add(cdsVenda.FieldByName('ITE_CODITE').AsString + ' - ' + cdsVenda.FieldByName('ITE_DESITE').AsString);

    If blnItemPosicionado Then
      pMsgPodeTrocarEmpresaItensPREPTE(stlItens);

    Result := False;
  End;
end;


function TFatVenda.fAtualizaEmpresaItens(strEmpIte: String; blnItemPosicionado: Boolean = False;pgbProgresso: TcxProgressBar = Nil): Boolean;
  Var
    fltSaldoIte: Double;
    strSemEst: String;
    blnSaldoIteGer: Boolean;
    blnPedSen: Boolean;
    blnSemEst: Boolean;
    intAutInc: Integer;
    blnCancel: Boolean;
    prcScroll: TprcScroll;
    recForTin: TForTin;
    intAutIncValidar: Integer;
    oleItensOriginal: OleVariant;
    matrizSaldosAux : TClassMatrizSaldosColorantes;
    tipTipMov: TTipMov;
    intEntRet: Integer;
    intTipEnt: Integer;
    stlItens: TStringList;
    strLoteNaoEncontrado: String;

  Function fSaldoDoItemIteger: Double;
  begin
    Result := fCampoTabela('ITE_SALDOS','ITEGER',
                          ['ITE_CODITE','ITE_CODEMP'],
                          [cdsVenda.FieldByName('ITE_CODITE').AsString,
                           cdsVenda.FieldByName('ITE_EMPITE').AsString]);
  end;

begin
  Result := False;
  intAutInc := -1;
  strLoteNaoEncontrado := '';

  stlItens := TStringList.Create;

  Try

    If (Self.strOprFlj = 'S') Then
    Begin
      fMensagem('','Não é possível alterar a empresa dos itens ' +
                   'quando estiver utilizando "Gerar ordem de produção fora da loja"!', ['&Ok']);
      Exit;
    End;

    If (Self.blnEnt_CD) Then
    Begin
      fMensagem('','Não é possível alterar a empresa dos itens ' +
                   'quando estiver utilizando "Entrega através do CD"!', ['&Ok']);
      Exit;
    End;

    If blnItemPosicionado And (Not fPodeTrocarEmpresaItensPREPTE(blnItemPosicionado, stlItens)) Then
      Exit;

    Try
      pDisableControls(cdsVenda, prcScroll);
      oleItensOriginal := cdsVenda.Data;//Caso nao valide o estoque restaura os produtos originais

      If (Not blnItemPosicionado) Then
        cdsVenda.First;

      If (pgbProgresso <> Nil) And (Not blnItemPosicionado) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
      Begin
        pgbProgresso.Properties.Max      := cdsVenda.RecordCount;
        pgbProgresso.Position            := 0;
      End;

      While (Not cdsVenda.Eof) Or blnItemPosicionado Do
      Begin

        If (pgbProgresso <> Nil) And (Not blnItemPosicionado) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
        Begin
          pgbProgresso.Position := cdsVenda.RecNo;
          pProcessMessages;
        End;

        If (Not blnItemPosicionado) And (Not fPodeTrocarEmpresaItensPREPTE(blnItemPosicionado, stlItens)) Then
        Begin
          cdsVenda.Next;
          Continue;
        End;

        If blnItemPosicionado Then
          intAutInc := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

        strSemEst := 'N';

        Self.strIdePro := cdsVenda.FieldByName('ITE_IDEPRO').AsString;

        If (Self.strIdePro <> 'NOR') And
           (Pos(Self.strIdePro, fCadEmpDes('TINDIS', strEmpIte)) <= 0) Then
        Begin
          fMensagem('','Empresa não tem permissão para produzir esta Tinta ' +
                       '(' + Self.strIdePro + ')!', ['&Ok']);

          If blnItemPosicionado Then
            Break
          Else
          Begin
            cdsVenda.Next;
            Continue;
          End;
        End;

        intEntRet := IDX_RETIRA;
        intTipEnt := IDX_ENTREGA_IMEDIATA;

        If (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E') Then
          intEntRet := IDX_ENTREGA;

        If (cdsVenda.FieldByName('ITE_ENTFUT').AsString = 'S') Then
          intTipEnt := IDX_ENTREGA_FUTURA;

        If (fCfgSis('SUJROM', varBoolean, strEmpIte)) And (Not fCfgSis('ENTFAT', varBoolean, strEmpIte)) Then
        Begin
          intEntRet := IDX_ENTREGA;
        End;

        tipTipMov := fRetornaTipoMovimento(intEntRet, intTipEnt);

        If (Not fLiberaTravaTipoMovimento(tipTipMov,
                                          strEmpIte,
                                          cdsVenda.FieldByName('ITE_CODITE').AsString,
                                          cdsVenda.FieldByName('ITE_DESITE').AsString,
                                          cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                          cdsVenda.FieldByName('AUTOINCREM').AsInteger)) Then
        Begin
          If blnItemPosicionado Then
            Break
          Else
          Begin
            cdsVenda.Next;
            Continue;
          End;
        End;

        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_EMPITE').AsString := strEmpIte;

        If (fCfgSis('SUJROM', varBoolean, strEmpIte)) And (Not fCfgSis('ENTFAT', varBoolean, strEmpIte)) Then
        Begin
          cdsVenda.FieldByName('ITE_ENTRET').AsString := 'E';
          cdsVenda.FieldByName('ITE_ENTFUT').AsString := IIF(intTipEnt = IDX_ENTREGA_IMEDIATA, 'N','S');
        End;

        If fEmpresaParaFaturamentoUsaWMS(strEmpIte) Then
        Begin
          If (strEmpIte = VS_strCodEmp) Then
          Begin
            If (Not fLoteDefinidoNoPedido(cdsVenda.FieldByName('ITE_CODITE').AsString)) And (cdsVenda.FieldByName('ITE_PEGOU_').AsString = 'N') Then
              cdsVenda.FieldByName('ITE_NUMLOT').AsString := 'A DEFINIR';
          End
          Else
            cdsVenda.FieldByName('ITE_NUMLOT').AsString := 'A DEFINIR';
        End
        Else
        If cdsVenda.FieldByName('ITE_NUMLOT').AsString = 'A DEFINIR' Then
          cdsVenda.FieldByName('ITE_NUMLOT').AsString := '';

        cdsVenda.Post;

        blnSaldoIteGer := False;

        If (Self.strIdePro = 'NOR') Then
        Begin
          If (Not fEmptyStr(cdsVenda.FieldByName('ITE_NUMLOT').AsString)) And
             (Not objCadLot.fExisteLote(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                        cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                        cdsVenda.FieldByName('ITE_NUMLOT').AsString)) Then
          Begin
            If fEmptyStr(strLoteNaoEncontrado) Then
              strLoteNaoEncontrado:= 'O '+ objCadLot.strTitLab +' '+cdsVenda.FieldByName('ITE_NUMLOT').AsString + ' ' +
                                     ' não foi encontrado para o item: ' +
                                     cdsVenda.FieldByName('ITE_CODITE').AsString + '-' +
                                     cdsVenda.FieldByName('ITE_DESITE').AsString
            Else
              strLoteNaoEncontrado:= strLoteNaoEncontrado + #13 +
                                     'O '+ objCadLot.strTitLab +' '+cdsVenda.FieldByName('ITE_NUMLOT').AsString + ' ' +
                                     ' não foi encontrado para o item: ' +
                                     cdsVenda.FieldByName('ITE_CODITE').AsString + '-' +
                                     cdsVenda.FieldByName('ITE_DESITE').AsString;
          End;

          If (stlItensNaoTemLote.IndexOf(cdsVenda.FieldByName('ITE_CODITE').AsString) = -1) And
             (objCadLot.fItemSemNenhumLote(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
          Begin
            stlItensNaoTemLote.Add(cdsVenda.FieldByName('ITE_CODITE').AsString);
          End;

          If (cdsVenda.FieldByName('ITE_PROACA').AsInteger = 1) Then
          Begin
            fltSaldoIte := TProdAcabado.fRetornaSaldo(cdsVenda.FieldByName('ITE_CODACA').AsString,
                                                      cdsVenda.FieldByName('ITE_EMPACA').AsString,
                                                      cdsVenda.FieldByName('ITE_EMPITE').AsString);
          End
          Else If (Not fEmptyStr(cdsVenda.FieldByName('ITE_NUMLOT').AsString)) And
                  (Not fEhEmissaoDocumentoWMS) And
                  (Not fEmpresaParaFaturamentoUsaWMS(cdsVenda.FieldByName('ITE_EMPITE').AsString)) And
                  (stlItensNaoTemLote.IndexOf(cdsVenda.FieldByName('ITE_CODITE').AsString) = -1) And
                   objCadLot.fExisteLote(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                         cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                         cdsVenda.FieldByName('ITE_NUMLOT').AsString) Then
          Begin
            fltSaldoIte := objCadLot.qryCadLot.FieldByName('LOT_SALDOS').AsFloat;
          End
          Else
          Begin
            fltSaldoIte := fSaldoDoItemIteger;
            blnSaldoIteGer := True;
          End;

          If fUsaQtdPendenteEntregaFutura(True, cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
          Begin
            fltSaldoIte := fltSaldoIte + TEntregaFutura.New(
                                           TParamEF.New()
                                             .CodIte(cdsVenda.FieldByName('ITE_CODITE').AsString)
                                             .CodEmp(cdsVenda.FieldByName('ITE_EMPITE').AsString)
                                             .Lote(IfThen(blnSaldoIteGer, '', cdsVenda.FieldByName('ITE_NUMLOT').AsString))
                                             .Faturamento(True)
                                           ).Total();
          End;

          fVerificaQtdEstoque(cdsVenda.FieldByName('ITE_EMPITE').AsString,
                              strOpcDoc,
                              cdsVenda.FieldByName('ITE_ENTSAI').AsString,
                              IIF(strEspOrc = 'OR', '', strNumOrc),
                              cdsVenda.FieldByName('AUTOINCREM').AsString,
                              cdsVenda.FieldByName('ITE_CODITE').AsString,
                              cdsVenda.FieldByName('ITE_CODACA').AsString,
                              cdsVenda.FieldByName('ITE_EMPACA').AsString,
                              cdsVenda.FieldByName('ITE_DESORI').AsString,
                              cdsVenda.FieldByName('ITE_ENTRET').AsString,
                              cdsVenda.FieldByName('ITE_ENTFUT').AsString,
                              cdsVenda.FieldByName('ITE_MOTFUT').AsString,
                              cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                              fRetQtdDigitada(cdsVenda.FieldByName('ITE_CODITE').AsString,
                                              cdsVenda.FieldByName('ITE_NUMLOT').AsString, '',
                                              cdsVenda.FieldByName('ITE_CODACA').AsString,
                                              cdsVenda.FieldByName('ITE_EMPACA').AsString,
                                              cdsVenda.FieldByName('ITE_EMPITE').AsString),
                              cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                              fltSaldoIte,
                              True,
                              strSemEst,
                              False,
                              blnPedSen,
                              blnSemEst,
                              recForTin,
                              False,
                              cdsVenda.FieldByName('ITE_NUMLOT').AsString,
                              False);
        End
        Else
        Begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_EMPPRD').AsString  := cdsVenda.FieldByName('ITE_EMPITE').AsString;
          cdsVenda.FieldByName('ITE_ESCPRD').AsInteger := 0;
          cdsVenda.Post;

          fltSaldoIte := fSaldoDoItemIteger;

          matrizSaldosAux := TClassMatrizSaldosColorantes(dicFormulas.RetornaObjeto(cdsVenda.FieldByName('AUTOINCREM').AsString));
          matrizSaldosAux.RecalcularFormulacao(strEmpIte, TIdentificadorTintaFactory.GetIdentificadorFatVendas(cdsVenda, fGTinForGeral));
          matrizSaldosAux.fRecalculaSaldos( cdsVenda.FieldByName('ITE_EMPPRD').AsString,
                                            cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                            strNumOrc );

          If Not fVerificaEstoqueTintaDeMaquina(matrizSaldosAux, cdsVenda.FieldByName('AUTOINCREM').AsString) Then
          Begin
            strSemEst := 'S';
          End;
        End;

        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_SALDOS').AsFloat  := fltSaldoIte;
        cdsVenda.FieldByName('ITE_SEMEST').AsString := strSemEst;
        cdsVenda.FieldByName('ITE_LIBEST').AsString := 'N';//Liberou sem estoque mediante senha
        cdsVenda.Post;

        If (Not blnItemPosicionado) Then
          cdsVenda.Next
        Else
          Break;

      End;

      If (Not blnItemPosicionado) Then
        cdsVenda.First;

      If (pgbProgresso <> Nil) And (Not blnItemPosicionado) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
        pgbProgresso.Visible := False;

      If (Not blnItemPosicionado) Then
        pMsgPodeTrocarEmpresaItensPREPTE(stlItens);

    Except
      On E: Exception Do
      Begin
        cdsVenda.Data := oleItensOriginal;
        cdsVenda.LogChanges := False;
        pMensagensErro(E.Message, '[]');
      End;
    End;
  Finally
    FreeAndNil(stlItens);
  End;

  pEnableControls(cdsVenda, prcScroll);

  blnCancel := False;

  intAutIncValidar := -1;

  If blnItemPosicionado Then
    intAutIncValidar := cdsVenda.FieldByName('AUTOINCREM').AsInteger;

  //Na Darka quando altera a empresa dos itens não valida o estoque,
  //porém em outros cliente que "explodem" o pedido tem que validar
  If ((Pos(strOpcDoc, 'OR_PD') > 0) And fCfgSis('EMPFAT', varBoolean)) Then
  Begin
    If (Not fVerificaEstoqueItens(strOpcDoc, '', True, False, True, intAutIncValidar)) Then
    Begin
      blnCancel := True;
    End;
  End;

  If (Not fValidaImprimeListaTodosItens(cdsVenda)) Then
  Begin
    blnCancel := True;
  End;

  If Not fEmptyStr(strLoteNaoEncontrado) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não foi possivel alterar a empresa do item!'+ #13+ strLoteNaoEncontrado, ['&Ok']);
    blnCancel := True;
  End;

  If blnCancel Then
  Begin
    cdsVenda.Data := oleItensOriginal;
    cdsVenda.LogChanges := False;
    pFormataDecimaisGrid;

    If intAutIncValidar <> -1 Then
      cdsVenda.Locate('AUTOINCREM', intAutIncValidar, []);
  End;

  If Not blnCancel Then
    Result := True;

  pAcertaPrecosTinta(intAutInc);
  pAcertaPrecosItemNormal(intAutInc);
end;

procedure TFatVenda.pAtualizaSaldoItens;
  Var
    fltSaldoIte: Double;
    prcScroll: TprcScroll;
    strEmpSal: string;
    strEmpIte: string;
    blnSaldoIteGer: Boolean;
begin
  strEmpSal := fEmpresaSaldoMatriz_CD;

  With cdsVenda Do
  Begin
    Try
      pDisableControls(cdsVenda, prcScroll);
      First;

      If (pgbProgresso <> Nil) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
      Begin
        pgbProgresso.Visible  := True;
        pgbProgresso.Max      := RecordCount;
        pgbProgresso.Position := 0;
      End;

      While Not Eof Do
      Begin

        If (pgbProgresso <> Nil) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
        Begin
          pgbProgresso.Position := RecNo;
          pProcessMessages;
        End;

        strEmpIte := IIF(blnEmpFat And (Not FieldByName('ITE_EMPITE').IsNull), FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD);

        blnSaldoIteGer := False;

        If (FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
        Begin
          If (stlItensNaoTemLote.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
             (objCadLot.fItemSemNenhumLote(FieldByName('ITE_CODITE').AsString)) Then
          Begin
            stlItensNaoTemLote.Add(FieldByName('ITE_CODITE').AsString);
          End;

          If (FieldByName('ITE_PROACA').AsInteger = 1) Then
          Begin
            fltSaldoIte := TProdAcabado.fRetornaSaldo(FieldByName('ITE_CODACA').AsString,
                                                      FieldByName('ITE_EMPACA').AsString,
                                                      fEmpresaSaldoMatriz_CD);
          End
          Else If blnSaldoMatriz Then
          Begin
            pCarregaEstoqueMatriz(FieldByName('ITE_CODITE').AsString,
                                  IIF(fEhEmissaoDocumentoWMS Or
                                      fEmpresaParaFaturamentoUsaWMS(FieldByName('ITE_EMPITE').AsString),
                                      IIF(FieldByName('ITE_NUMLOT').AsString = 'A DEFINIR', '', FieldByName('ITE_NUMLOT').AsString), FieldByName('ITE_NUMLOT').AsString));
            fltSaldoIte := fltSaldoMatriz;
          End
          Else If (Not fEmptyStr(FieldByName('ITE_NUMLOT').AsString)) And
                  (Not fEhEmissaoDocumentoWMS) And
                  (Not fEmpresaParaFaturamentoUsaWMS(FieldByName('ITE_EMPITE').AsString)) And
                  (stlItensNaoTemLote.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
                   objCadLot.fExisteLote(FieldByName('ITE_CODITE').AsString,
                                         strEmpIte,
                                         FieldByName('ITE_NUMLOT').AsString) Then
          Begin
            If (FieldByName('ITE_NUMLOT').AsString = 'A DEFINIR') Then
            Begin
              fltSaldoIte := fRetornaSaldoDisponivel(FieldByName('ITE_CODITE').AsString,
                                                     False,
                                                     False,
                                                     FieldByName('ITE_NUMLOT').AsString,
                                                     True,
                                                     FieldByName('ITE_EMPITE').AsString,
                                                     '',
                                                     False,
                                                     True,
                                                     True,
                                                     fUtilizaDefinicaoLoteSeparacaoSemWMS(FieldByName('ITE_CODITE').AsString,
                                                                                          FieldByName('ITE_EMPITE').AsString,
                                                                                          Self.strOpcDoc));
            End
            Else
              fltSaldoIte := objCadLot.qryCadLot.FieldByName('LOT_SALDOS').AsFloat;
          End
          Else
          Begin
            fltSaldoIte := fCampoTabela('ITE_SALDOS','ITEGER',['ITE_CODITE','ITE_CODEMP'], [FieldByName('ITE_CODITE').AsString, strEmpIte]);
            blnSaldoIteGer := True;
          End;

          If fUsaQtdPendenteEntregaFutura(True, IIF(blnSaldoMatriz, strEmpSal, strEmpIte)) Then
          Begin
            fltSaldoIte := fltSaldoIte + TEntregaFutura.New(
                                           TParamEF.New()
                                             .CodIte(FieldByName('ITE_CODITE').AsString)
                                             .CodEmp(IfThen(blnSaldoMatriz, strEmpSal, strEmpIte))
                                             .Lote(IfThen(blnSaldoIteGer, '', FieldByName('ITE_NUMLOT').AsString))
                                             .Faturamento(True)
                                           ).Total();
          End;
        End
        Else
          fltSaldoIte := fCampoTabela( 'ITE_SALDOS',
                                       'ITEGER',
                                      ['ITE_CODITE','ITE_CODEMP'],
                                      [FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPPRD').AsString]);

        if (Pos(strOpcDoc, 'OR_PD_VN') > 0) and (fEhProdutoPgimento(FieldByName('ITE_CODITE').AsString)) then
            fltSaldoIte := fltSaldoIte + fCampoTabela( 'ITE_SAL_ML',
                                                       'ITEGER',
                                                      ['ITE_CODITE','ITE_CODEMP'],
                                                      [FieldByName('ITE_CODITE').AsString,
                                                      IIF(FieldByName('ITE_IDEPRO').AsString = 'NOR', strEmpIte, FieldByName('ITE_IDEPRO').AsString = 'NOR')]);


        Edit;
        FieldByName('ITE_SALDOS').AsFloat := fltSaldoIte;
        Post;

        Next;

      End;

      First;

      If (pgbProgresso <> Nil) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
        pgbProgresso.Visible := False;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[pAtualizaSaldoItens]');
      End;
    End;

    pEnableControls(cdsVenda, prcScroll);

  End;

end;

function TFatVenda.fTravaSaldoEntFut(strOpcao, strMotFut: String): String;
begin
  If Pos(strOpcao, 'PD_OR_') > 0 Then
    Result := fCfgSis(fCfgTravaSaldoEntFut(strOpcao, strMotFut))
  Else
    Result := fTravaSaldoVN(blnExpedi, True, strMotFut);
End;

function TFatVenda.fTravaSaldoEntFutColorante(strOpcao: String): String;
begin
  If (strOpcao = 'PD') Then
    Result := fCfgSis('COLFPD')
  Else If (strOpcao = 'OR') Then
    Result := fCfgSis('COLFOR')
  Else
    Result := fCfgSis('COLFVN');
End;

function TFatVenda.fTravaSaldoItemNormal(strOpcao: String): String;
begin
  If (strOpcao = 'PD') Then
    Result := fCfgSis('SLDPED')
  Else If (strOpcao = 'OR') Then
    Result := fCfgSis('SLD_OP')
  Else
    Result := fTravaSaldoVN(blnExpedi, False, '', strOriF11);
end;

function TFatVenda.fTravaSaldoItemColorante(strOpcao: String): String;
begin
  If (strOpcao = 'PD') Then
    Result := fCfgSis('COL_PD')
  Else If (strOpcao = 'OR') Then
    Result := fCfgSis('COL_OR')
  Else
    Result := fCfgSis('COL_VN');
end;

function TFatVenda.fVerificaEstoqueItens( strOpcao                          : String;
                                          strEntSai                         : String  = '';
                                          blnTelaSaldoTintas                : Boolean = True;
                                          blnApenasExibir                   : Boolean = False;
                                          blnCalcularSaldos                 : Boolean = True;
                                          intAutIncValidar                  : Integer = -1;
                                          blnApenasResultado                : Boolean = False;
                                          blnVerificaSubProduto             : Boolean = False;
                                          blnValidaComSenhaFechamentoOREmPD : Boolean = False;
                                          blnExibirAviso                    : Boolean = True): Boolean;

  Var
    fltSalAtu,
    fltSalRes,
    fltSalDis: Double;
    blnPediuSenhaItemNormal: Boolean;
    blnPediuSenhaItemTinta: Boolean;
    blnPedSen: Boolean;
    blnSemEst: Boolean;
    blnSemEstNormal: Boolean;
    strEmpSal: String;
    blnUsaEstExt: Boolean;
    strEmpSalTin: String;
    strIteEmpPrd: String;
    strSemEst: String;
    strSemEstNormal: String;
    strEntFut: String;
    strMotFut: String;
    stlMsgEst: TStringList;
    strItensNormalSemEst: String;
    prcScroll: TprcScroll;
    intContador: Integer;
    recForTin: TFortin;
    matrizSaldosColorantes: TClassMatrizSaldosColorantes;
    matrizSaldosAux : TClassMatrizSaldosColorantes;
    blnTintaSemEstoque: Boolean;
    strNumLotAux: String;
    fltQtdPedCompraAberto : Double;

    stlAutIncItensSemEstoque: TStringList;

    blnVendaNormalFechandoComoOrcamento: Boolean;

    // Produto NOR
    blnTravarItemNormal,
    blnTravarItemEntFut: Boolean;

    // Colorantes
    blnTravarItemNormalCol,
    blnTravarItemEntFutCol: Boolean;
    blnAvisarItemNormalCol,
    blnAvisarItemEntFutCol: Boolean;

    blnBaixaSubItemEstrutura: Boolean;
    blnOrdemProducaoBaixada: Boolean;

    blnSolicitouDeOutraEmpresa: Boolean;
    saldosColorantes: TSaldosColorantes;
    strEstoqueComponente: string;
    //fltSaldoDisponivelBaseImobiliaria: Double;

    objMsgSubItensSemEst: TMensagemLiberacao;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha : TLinhaMsgLibera;
    objMsg : TMensagemLiberacao;

    objMsgItensNormalSemEst: TMensagemLiberacao;

    fltSalResPD,
    fltSalResGA,
    fltSalResExterno,
    fltSalResOP,
    fltSalEntFut_AG,
    fltSalEntFut_PR,
    fltSalEntFut_FA,
    fltSaldoDisponivel,
    fltSaldos,
    fltCnvML,
    fltSalMl : Double;

    objSalLoj : TSaldoLojas;

    recSaldos,
    recSaldosML: TRecSaldos;

    blnEntFut, blnOrdPro : Boolean;
    intCalSal : Integer;

    intTamCol, intTamGer : Integer;

    frmFatMostraProdSemSaldo: TfrmFatMostraProdSemSaldo;


    LblnVerificaSubProduto: boolean ;

    function fRetEmpIte(aStrEmpIte: String): String;
    begin
      Result := IIF(blnEmpFat, aStrEmpIte, strEmpSal);
    end;

    function fRetNumLot(aStrNumLot, aStrEmpIte: String): String;
    begin
      Result := aStrNumLot;
      If fEhEmissaoDocumentoWMS Or fEmpresaParaFaturamentoUsaWMS(aStrEmpIte) Then
        Result := IIF(aStrNumLot = 'A DEFINIR', '', aStrNumLot);
    end;

    function fRetQtdColCALSAL : Integer;
    begin
      Result := 0;
      If fCfgSis('CALSAL') = '1' Then
        Result := 3
      Else If fCfgSis('CALSAL') = '3' Then
        Result := 1
      Else If (fCfgSis('CALSAL') = '4') Or (fCfgSis('CALSAL') = '5') Then
        Result := 2;
    end;

  function fRetornaSaldoVerificaoEstoqueBaseImobiliaria(strEmpPrdBase: String; fltSaldoBase: Double; strCodIteBase: String): Double;
      function fRetornaSaldoEstoqueEmpresa(strCodEmpBase: String): Double;
      begin
        Result := fCampoTabela('ITE_SALDOS',
                               'ITEGER',
                               ['ITE_CODITE', 'ITE_CODEMP'],
                               [strCodIteBase, strCodEmpBase]);
      end;
  begin
    Result := fltSaldoBase;

    If ((strOprFlj <> 'S') And blnEnt_CD) Then
      Result := fRetornaSaldoEstoqueEmpresa(strEmp_CD)
    Else If (strOprFlj = 'S') Then
      Result := fRetornaSaldoEstoqueEmpresa(strEmpPrdBase);
  end;

begin
  Result := True;

  If fPermitePassarItemSemEstoquePoisIraGerarVendasPerdidas(True) Then
  Begin
    Exit;
  End;

  blnVendaNormalFechandoComoOrcamento := fCfgSis('VSEORC', varBoolean) And (strOpcao = 'VN') And (fEmptyStr(strEspDoc) Or (strEspDoc = 'OR'));

  blnTintaSemEstoque := False;
  LblnVerificaSubProduto := False ;

  matrizSaldosColorantes := TClassMatrizSaldosColorantes.Create();

  If blnCalcularSaldos Then
    pAtualizaSaldoItens;

  pDisableControls(cdsVenda, prcScroll);
  blnVerificandoEstoqueLiberadoParaCorte := True;

  objMsgSubItensSemEst := TMensagemLiberacao.Create(Self);
  objMsgItensNormalSemEst := TMensagemLiberacao.Create(Self);
  Try
    pCriarFormularios(TfrmFatMostraProdSemSaldo, frmFatMostraProdSemSaldo);
    frmFatMostraProdSemSaldo.pAbreClientItens;

    stlAutIncItensSemEstoque := TStringList.Create;

    With cdsVenda Do
    Begin
      First;

      If (pgbProgresso <> Nil) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
      Begin
        pgbProgresso.Visible  := True;
        pgbProgresso.Max      := RecordCount;
        pgbProgresso.Position := 0;
      End;

      If Assigned(pgbStatusGravacao) Then
      Begin
        pgbStatusGravacao.Position := 0;
        pgbStatusGravacao.Properties.Max := RecordCount;
      End;

      blnTravarItemNormal := False;
      blnTravarItemEntFut := False;

      blnTravarItemNormalCol := False;
      blnTravarItemEntFutCol := False;

      blnAvisarItemNormalCol := False;
      blnAvisarItemEntFutCol := False;

      strItensNormalSemEst := '';

      objTabela := TRegistroMsgLiberaTabela.Create;

      While Not Eof Do
      Begin
        pStepStatusGravacao;
        pInfoStatusGravacao('Aguarde... Verificando Saldos... ' + intToStr(RecNo) + '/' + intToStr(RecordCount));

        If (pgbProgresso <> Nil) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
        Begin
          pgbProgresso.Position := RecNo;
          pProcessMessages;
        End;

        If (fPermitePassarItemSemEstoquePoisIraGerarVendasPerdidas(False)) And
           (Not fTemItensDeCorteSemSaldoLiberado(FieldByName('ITE_CODITE').AsString)) Then
        Begin
          Next;
          Continue;
        End;

        If fEhProdutoAcabado(cdsVenda) Then
        Begin
          Next;
          Continue;
        End;

        If (intAutIncValidar <> -1) And (FieldByName('AUTOINCREM').AsInteger <> intAutIncValidar) Then
        Begin
          Next;
          Continue;
        End;

        If fEhItemServico(FieldByName('ITE_CODITE').AsString) Then
        Begin
          Next;
          Continue;
        End;

        //Caso já Liberou sem estoque mediante senha, não pede a senha novamente...
        If FieldByName('ITE_LIBEST').AsString = 'S' Then
        Begin
          Next;
          Continue;
        End;

        if blnVerificaSubProduto then
        begin
          LblnVerificaSubProduto := fTravaSubProduto(FieldByName('ITE_CODITE').AsString) ;
        end ;

        strSemEst := 'N';
        strSemEstNormal := 'N';
        blnSemEst := False;
        blnSemEstNormal := False;
        strIdePro := FieldByName('ITE_IDEPRO').AsString;
        strEntFut := FieldByName('ITE_ENTFUT').AsString;
        strMotFut := FieldByName('ITE_MOTFUT').AsString;

        blnSolicitouDeOutraEmpresa := (Not FieldByName('ITE_PODALT').AsBoolean) And
                                      (Not fEmptyStr(FieldByName('ITE_EMPSOL').AsString)) And
                                      (FieldByName('ITE_EMPSOL').AsString <> VS_strCodEmp);

        If (strIdePro = 'NOR') And (Not blnSolicitouDeOutraEmpresa) Then
        Begin
          blnOrdemProducaoBaixada  := False;
          blnBaixaSubItemEstrutura := FieldByName('ITE_BXSBIT').AsString = 'S';

          {****************************************************************}
          {* QUANDO O SISTEMA ESTIVER CONFIGURADO PARA BAIXAR ESTOQUE DOS *}
          {* SUB-PRODUTOS SOMENTE QUANDO NAO HOUVER ESTOQUE DO PRODUTO    *}
          {* ESTRUTURA, VERIFICA SE OS SUB-PRODUTOS POSSUEM ESTOQUE NECES-*}
          {* SARIO PARA REALIZAR A VENDA...                               *}
          {************************************************************JC**}
          If (blnBaixaSubItemEstrutura And ((fCfgSis('BXSBIT') = '2') Or (fCfgSis('BXSBIT') = '3'))) Or
             ((LblnVerificaSubProduto) And (fCfgSis('BXSBIT') = '1')) Then
          Begin
            blnOrdemProducaoBaixada := (Not fEmptyStr(FieldByName('ITE_ORDPRO').AsString)) And
                                       (TOrdPro.fOrdemProducaoBaixada(FieldByName('ITE_ORDPRO').AsString, VS_strCodEmp));

            {**************************************************}
            {* VALIDA O ESTOQUE DOS SUB-PRODUTOS DA ESTRUTURA *}
            {***********************************************JC*}
            If (blnBaixaSubItemEstrutura Or LblnVerificaSubProduto) And (Not blnOrdemProducaoBaixada) And
              (Not fVerificaQtdEstoqueSubItensEstrutura(strOpcao,
                                                        FieldByName('ITE_CODITE').AsString,
                                                        FieldByName('AUTOINCREM').AsString,
                                                        FieldByName('ITE_QTDITE').AsFloat,
                                                        blnValidaComSenhaFechamentoOREmPD,
                                                        objMsgSubItensSemEst,
                                                        blnPedSen,
                                                        True,
                                                        FieldByName('ITE_EMPITE').AsString,
                                                        FieldByName('ITE_ENTRET').AsString,
                                                        FieldByName('ITE_ENTFUT').AsString,
                                                        FieldByName('ITE_MOTFUT').AsString,
                                                        (FieldByName('ITE_ALTEST').AsString = 'S'),
                                                        FieldByName('ITE_SEQPER').AsInteger)) Then
            Begin

              If (blnValidaComSenhaFechamentoOREmPD) Then
              Begin

                If (pgbProgresso <> Nil) Then
                  pgbProgresso.Visible  := False;

                Exit(False);

              End;

              blnSemEst := True;
              strSemEst := 'S';

            End;
          End

          Else If (fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString) And Assigned(objEstruturaVidros)) Then
          Begin
            If (Not fVerificaQtdEstoqueEstruturaVidro(strOpcao,
                                                      FieldByName('ITE_CODITE').AsString,
                                                      FieldByName('AUTOINCREM').AsString,
                                                      FieldByName('ITE_QTDITE').AsFloat,
                                                      False,
                                                      objMsgSubItensSemEst,
                                                      blnPedSen)) Then
            Begin
              blnSemEst := True;
              strSemEst := 'S';
            End;
          End;

          {*******************************************************************************************}
          {* CASO NAO BAIXE O ESTOQUE DOS SUB-PRODUTOS ENTAO VALIDA O ESTOQUE DO PRODUTO "ESTRUTURA" *}
          {****************************************************************************************JC*}
          If (((Not blnBaixaSubItemEstrutura) And (Not LblnVerificaSubProduto)) Or blnOrdemProducaoBaixada) And
             (Not (fEhItemVendaVidro(FieldByName('ITE_CODITE').AsString) And Assigned(objEstruturaVidros))) Then
          Begin
            fltSalDis := IIF(fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString),
                             FieldByName('ITE_SALCAR').AsFloat, 
                             FieldByName('ITE_SALDOS').AsFloat);

            fVerificaQtdEstoque(FieldByName('ITE_EMPITE').AsString,
                                strOpcao,
                                IIF(Not fEmptyStr(strEntSai), strEntSai, FieldByName('ITE_ENTSAI').AsString),
                                IIF(strEspOrc = 'OR', '', strNumOrc),
                                FieldByName('AUTOINCREM').AsString,
                                FieldByName('ITE_CODITE').AsString,
                                FieldByName('ITE_CODACA').AsString,
                                FieldByName('ITE_EMPACA').AsString,
                                FieldByName('ITE_DESORI').AsString,
                                FieldByName('ITE_ENTRET').AsString,
                                FieldByName('ITE_ENTFUT').AsString,
                                FieldByName('ITE_MOTFUT').AsString,
                                FieldByName('ITE_QTDITE').AsFloat,
                                fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,
                                                FieldByName('ITE_NUMLOT').AsString, '',
                                                FieldByName('ITE_CODACA').AsString,
                                                FieldByName('ITE_EMPACA').AsString,
                                                FieldByName('ITE_EMPITE').AsString,
                                                True,
                                                False,
                                                False,
                                                False,
                                                False, //blnDesconsideraEntFut
                                                IIF((blnSolicitouFecharOREmPD) And (Self.strEspDoc = 'PD'), 'PD', '')),
                                FieldByName('ITE_QTDITE').AsFloat,
                                fltSalDis,
                                True,
                                strSemEst,
                                False,
                                blnPedSen,
                                blnSemEst,
                                recForTin,
                                False,
                                FieldByName('ITE_NUMLOT').AsString,
                                False,
                                '',
                                IIF(fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString),
                                    FieldByName('ITE_EMPCAR').AsString, ''));

            {***************************************************************}
            {* verifica estoque entrega imediata/retira para usar na trava *}
            {*REQ.171576*************************************************RP*}
            If blnSemEst Then
            fVerificaQtdEstoque(FieldByName('ITE_EMPITE').AsString,
                                strOpcao,
                                IIF(Not fEmptyStr(strEntSai), strEntSai, FieldByName('ITE_ENTSAI').AsString),
                                IIF(strEspOrc = 'OR', '', strNumOrc),
                                FieldByName('AUTOINCREM').AsString,
                                FieldByName('ITE_CODITE').AsString,
                                FieldByName('ITE_CODACA').AsString,
                                FieldByName('ITE_EMPACA').AsString,
                                FieldByName('ITE_DESORI').AsString,
                                FieldByName('ITE_ENTRET').AsString,
                                FieldByName('ITE_ENTFUT').AsString,
                                FieldByName('ITE_MOTFUT').AsString,
                                FieldByName('ITE_QTDITE').AsFloat,
                                fRetQtdDigitada(FieldByName('ITE_CODITE').AsString,
                                                FieldByName('ITE_NUMLOT').AsString, '',
                                                FieldByName('ITE_CODACA').AsString,
                                                FieldByName('ITE_EMPACA').AsString,
                                                FieldByName('ITE_EMPITE').AsString,
                                                True,
                                                False,
                                                False,
                                                False,
                                                True, //blnDesconsideraEntFut
                                                IIF((blnSolicitouFecharOREmPD) And (Self.strEspDoc = 'PD'), 'PD', '')),
                                FieldByName('ITE_QTDITE').AsFloat,
                                fltSalDis,
                                True,
                                strSemEstNormal,
                                False,
                                blnPedSen,
                                blnSemEstNormal,
                                recForTin,
                                False,
                                FieldByName('ITE_NUMLOT').AsString,
                                False,
                                '',
                                IIF(fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString),
                                    FieldByName('ITE_EMPCAR').AsString, ''));
          End;

          If blnSemEst Then
          Begin
            strEmpSal := fEmpresaSaldoMatriz_CD;

            If blnEmpFat And Not fEmptyStr(FieldByName('ITE_EMPITE').AsString) Then
              strEmpSal := FieldByName('ITE_EMPITE').AsString
            Else If fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString) Then
              strEmpSal := FieldByName('ITE_EMPCAR').AsString;

            blnUsaEstExt := fCfgSis('ESTEXT', varBoolean, strEmpSal);

            If (Assigned(objMsgSubItensSemEst)) And
               (Not fEmptyStr(objMsgSubItensSemEst.fGetMensagem)) Then
            Begin
              frmFatMostraProdSemSaldo.pnlMensagemItem.Visible := True;
              frmFatMostraProdSemSaldo.splMensagemItem.Visible := True;
            End;

            If (strEntFut = 'N') And (fTravaSaldoItemNormal(strOpcao) = 'T') Then
              blnTravarItemNormal := True;

            If (strEntFut = 'S') And (fTravaSaldoEntFut(strOpcao, strMotFut) = 'T') Then
              blnTravarItemEntFut := True;

            {*************************************************************}
            {* CASO CONFIGURADO PARA TRAVAR OU AVISAR DEVE EXIBIR O ITEM *}
            {**********************************************************JC*}
            If ((strEntFut = 'N') And (fTravaSaldoItemNormal(strOpcao) <> 'N')) Or
               ((strEntFut = 'S') And (fTravaSaldoEntFut(strOpcao, strMotFut) <> 'N')) Then
            Begin
              fltSalAtu := IIF(fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString),
                               FieldByName('ITE_SALCAR').AsFloat, 
                               FieldByName('ITE_SALDOS').AsFloat);

              fltSalRes := TSaldoReservado.New(
                             TReservaParametros.New()
                               .EmpresaItem(fRetEmpIte(FieldByName('ITE_EMPITE').AsString))
                               .CodigoItem(FieldByName('ITE_CODITE').AsString)
                               .CodEmpresa(VS_strCodEmp)
                               .NumeroLote(fRetNumLot(FieldByName('ITE_NUMLOT').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString)))
                               .DesconsideraPedidosCorte(Not blnPedCorte)
                             ).fGetQuantidade();

              fltSalDis := (fltSalAtu - fltSalRes);

              frmFatMostraProdSemSaldo.pIncluiItem(IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, strEmpSal),
                                                   FieldByName('ITE_CODITE').AsString,
                                                   FieldByName('ITE_DESITE').AsString,
                                                   fltSalAtu,
                                                   FieldByName('ITE_QTDITE').AsFloat,
                                                   FieldByName('ITE_NUMLOT').AsString,
                                                   '',
                                                   objMsgSubItensSemEst.fGetMensagem,
                                                   fltSalDis,
                                                   True);

              If (fValidarEstoqueNoFinal) Then
              Begin

                fltSalEntFut_PR := 0;
                fltSalEntFut_FA := 0;
                fltSalEntFut_AG := 0;

                fltSalResPD := 0;
                fltSalResOP := 0;
                fltSalResGA := 0;
                fltSalResExterno := 0;

                blnEntFut := fCfgSis('ENTFUT', varBoolean);
                blnOrdPro := fCfgSis('ORDPRO', varBoolean);
                intCalSal := fCfgSis('CALSAL', varInteger);

                objSalLoj := TSaldoLojas.Create(Self);

                Try

                  fltSaldos := IIF(fEmpCarPreenchidaEmpDif(FieldByName('ITE_EMPCAR').AsString, FieldByName('ITE_EMPITE').AsString),
                                   FieldByName('ITE_SALCAR').AsFloat, FieldByName('ITE_SALDOS').AsFloat);
                  fltCnvML  := fCampoTabela('ITE_CNV_ML', 'CADITE', ['ITE_CODITE'], [FieldByName('ITE_CODITE').AsString], False);
                  fltSalMl  := fCampoTabela('ITE_SAL_ML', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [FieldByName('ITE_CODITE').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString)]);

                  If fltCnvML > 0 Then
                    fltSaldos := fltSaldos + fltSalMl / fltCnvML;

                  objSalLoj.pCalculaSaldos(Nil,
                                           recSaldos,
                                           recSaldosML,
                                           fltSaldos,
                                           fRetEmpIte(FieldByName('ITE_EMPITE').AsString),
                                           fRetEmpIte(FieldByName('ITE_EMPITE').AsString),
                                           FieldByName('ITE_CODITE').AsString,
                                           fltCnvML,
                                           blnEntFut,
                                           blnPedCorte,
                                           blnOrdPro,
                                           intCalSal,
                                           fRetNumLot(FieldByName('ITE_NUMLOT').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString)));

                  With recSaldos Do
                  Begin
                    fltSalEntFut_PR    := fltEntPre;
                    fltSalEntFut_FA    := fltEntFal;
                    fltSalEntFut_AG    := fltEntAgu;
                    fltSalResPD        := fltSalPed;
                    fltSalResOP        := fltSalOrd;
                    fltSalResGA        := fltSalGar;
                    fltSalResExterno   := fltSalExt;
                    fltSaldoDisponivel := fltSalDis;
                  End;

                Finally
                  FreeAndNil(objSalLoj);
                End;

                intTamCol := 15;
                intTamGer := 83 + ((fRetQtdColCALSAL * intTamCol) + (fRetQtdColCALSAL * 2));
                if blnUsaEstExt then
                  intTamGer := intTamGer + intTamCol + 2;

                {*REQ.171576**********RP*}
                If ((strEntFut = 'N') And blnTravarItemNormal And blnSemEstNormal) Or
                   ((strEntFut = 'S') And blnTravarItemEntFut) Then
                Begin
                  objLinha := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlValor;
                  objLinha.pAddColuna('', FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' - Unidade: ' + fRetUnidadeItem(FieldByName('ITE_CODITE').AsString), intTamGer, alEsquerda);
                  objTabela.lstLinhas.Add(objLinha);

                  objLinha := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlValor;
                  objLinha.pAddColuna('', 'Qtd. Digitada'  , intTamCol, alDireita);
                  objLinha.pAddColuna('', 'Sal. Atual'     , intTamCol, alDireita);
                  if blnUsaEstExt then
                    objLinha.pAddColuna('', 'Sal. Reser. Ext.' , intTamCol, alDireita);
                  objLinha.pAddColuna('', 'Sal. Reser. PD' , intTamCol, alDireita);
                  objLinha.pAddColuna('', 'Sal. Reser. GA' , intTamCol, alDireita);
                  objLinha.pAddColuna('', 'Sal. Reser. OP' , intTamCol, alDireita);

                  If fCfgSis('CALSAL') = '1' Then
                  Begin
                    objLinha.pAddColuna('', 'Sal. Ent.F. AG' , intTamCol, alDireita);
                    objLinha.pAddColuna('', 'Sal. Ent.F. PR' , intTamCol, alDireita);
                    objLinha.pAddColuna('', 'Sal. Ent.F. FA' , intTamCol, alDireita);
                  End
                  Else If fCfgSis('CALSAL') = '3' Then
                  Begin
                    objLinha.pAddColuna('', 'Sal. Ent.F. FA' , intTamCol, alDireita);
                  End
                  Else If fCfgSis('CALSAL') = '4' Then
                  Begin
                    objLinha.pAddColuna('', 'Sal. Ent.F. AG' , intTamCol, alDireita);
                    objLinha.pAddColuna('', 'Sal. Ent.F. PR' , intTamCol, alDireita);
                  End
                  Else If fCfgSis('CALSAL') = '5' Then
                  Begin
                    objLinha.pAddColuna('', 'Sal. Ent.F. AG' , intTamCol, alDireita);
                    objLinha.pAddColuna('', 'Sal. Ent.F. FA' , intTamCol, alDireita);
                  End;

                  objTabela.lstLinhas.Add(objLinha);

                  objLinha := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlValor;
                  objLinha.pAddColuna('Qtd. Digitada' , FormatFloat('#,##0.00', FieldByName('ITE_QTDITE').AsFloat), intTamCol, alDireita);

                  if (fVerificaAcessoSistema('PVISPF')) then
                  begin
                    objLinha.pAddColuna('Sal. Atual'    , FormatFloat('#,##0.00', fltSalDis)  , intTamCol, alDireita);
                    if blnUsaEstExt then
                      objLinha.pAddColuna('Sal. Reser. Ext.', FormatFloat('#,##0.00', fltSalResExterno), intTamCol, alDireita);
                    objLinha.pAddColuna('Sal. Reser. PD', FormatFloat('#,##0.00', fltSalResPD), intTamCol, alDireita);
                    objLinha.pAddColuna('Sal. Reser. GA', FormatFloat('#,##0.00', fltSalResGA), intTamCol, alDireita);
                    objLinha.pAddColuna('Sal. Reser. OP', FormatFloat('#,##0.00', fltSalResOP), intTamCol, alDireita);

                    If fCfgSis('CALSAL') = '1' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. AG', FormatFloat('#,##0.00', fltSalEntFut_AG), intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. PR', FormatFloat('#,##0.00', fltSalEntFut_PR), intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. FA', FormatFloat('#,##0.00', fltSalEntFut_FA), intTamCol, alDireita);
                    End
                    Else If fCfgSis('CALSAL') = '3' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. FA', FormatFloat('#,##0.00', fltSalEntFut_FA), intTamCol, alDireita);
                    End
                    Else If fCfgSis('CALSAL') = '4' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. AG', FormatFloat('#,##0.00', fltSalEntFut_AG), intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. PR', FormatFloat('#,##0.00', fltSalEntFut_PR), intTamCol, alDireita);
                    End
                    Else If fCfgSis('CALSAL') = '5' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. AG', FormatFloat('#,##0.00', fltSalEntFut_AG), intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. FA', FormatFloat('#,##0.00', fltSalEntFut_FA), intTamCol, alDireita);
                    End;
                  end
                  else
                  begin
                    objLinha.pAddColuna('Sal. Atual'    , '@('+FormatFloat('#,##0.00', fltSalDis)+')@'  , intTamCol, alDireita);
                    if blnUsaEstExt then
                      objLinha.pAddColuna('Sal. Reser. Ext.', '@('+FormatFloat('#,##0.00', fltSalResExterno)+')@', intTamCol, alDireita);
                    objLinha.pAddColuna('Sal. Reser. PD', '@('+FormatFloat('#,##0.00', fltSalResPD)+')@', intTamCol, alDireita);
                    objLinha.pAddColuna('Sal. Reser. GA', '@('+FormatFloat('#,##0.00', fltSalResGA)+')@', intTamCol, alDireita);
                    objLinha.pAddColuna('Sal. Reser. OP', '@('+FormatFloat('#,##0.00', fltSalResOP)+')@', intTamCol, alDireita);

                    If fCfgSis('CALSAL') = '1' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. AG', '@('+FormatFloat('#,##0.00', fltSalEntFut_AG)+')@', intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. PR', '@('+FormatFloat('#,##0.00', fltSalEntFut_PR)+')@', intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. FA', '@('+FormatFloat('#,##0.00', fltSalEntFut_FA)+')@', intTamCol, alDireita);
                    End
                    Else If fCfgSis('CALSAL') = '3' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. FA', '@('+FormatFloat('#,##0.00', fltSalEntFut_FA)+')@', intTamCol, alDireita);
                    End
                    Else If fCfgSis('CALSAL') = '4' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. AG', '@('+FormatFloat('#,##0.00', fltSalEntFut_AG)+')@', intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. PR', '@('+FormatFloat('#,##0.00', fltSalEntFut_PR)+')@', intTamCol, alDireita);
                    End
                    Else If fCfgSis('CALSAL') = '5' Then
                    Begin
                      objLinha.pAddColuna('Sal. Ent.F. AG', '@('+FormatFloat('#,##0.00', fltSalEntFut_AG)+')@', intTamCol, alDireita);
                      objLinha.pAddColuna('Sal. Ent.F. FA', '@('+FormatFloat('#,##0.00', fltSalEntFut_FA)+')@', intTamCol, alDireita);
                    End;
                  end;

                  strNumLotAux := fRetNumLot(FieldByName('ITE_NUMLOT').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString));
                  If Not fEmptyStr(strNumLotAux) Then
                  Begin
                    objTabela.lstLinhas.Add(objLinha);
                    objLinha := TLinhaMsgLibera.Create;
                    objLinha.enuTipoLinha := tlValor;

                    If (fCfgSis('CTLEST') = '2') Then
                      objLinha.pAddColuna('', 'Armazém: '+strNumLotAux, intTamGer, alEsquerda)
                    Else
                      objLinha.pAddColuna('', 'Lote: '+strNumLotAux, intTamGer, alEsquerda);
                  End;

                  objTabela.lstLinhas.Add(objLinha);
                  objLinha := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlValor;

                  if (fVerificaAcessoSistema('PVISPF')) then
                    objLinha.pAddColuna('', 'Saldo Disponível: ' + FormatFloat('#,##0.00', fltSaldoDisponivel), intTamGer, alEsquerda)
                  else
                    objLinha.pAddColuna('', 'Saldo Disponível: ' + '@('+FormatFloat('#,##0.00', fltSaldoDisponivel)+')@', intTamGer, alEsquerda);

                  objTabela.lstLinhas.Add(objLinha);

                  fltQtdPedCompraAberto := fRetornaQtdPedCompraAberto(FieldByName('ITE_CODITE').AsString, VS_strCodEmp);
                  objLinha := TLinhaMsgLibera.Create;
                  objLinha.pAddColuna('', 'Qtd. Pedido de Compra em Aberto: ' + FormatFloat('#,##0.00', fltQtdPedCompraAberto), intTamGer, alEsquerda);
                  objTabela.lstLinhas.Add(objLinha);
                End;
              End
              Else
              Begin

                {*REQ.171576**********RP*}
                If ((strEntFut = 'N') And blnTravarItemNormal And blnSemEstNormal) Or
                   ((strEntFut = 'S') And blnTravarItemEntFut) Then
                Begin
                  fltSaldos := FieldByName('ITE_SALDOS').AsFloat;
                  fltCnvML  := fCampoTabela('ITE_CNV_ML', 'CADITE', ['ITE_CODITE'], [FieldByName('ITE_CODITE').AsString], False);
                  fltSalMl  := fCampoTabela('ITE_SAL_ML', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [FieldByName('ITE_CODITE').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString)]);

                  If fltCnvML > 0 Then
                    fltSaldos := fltSaldos + fltSalMl / fltCnvML;

                  objSalLoj := TSaldoLojas.Create(Self);

                  objSalLoj.pCalculaSaldos(Nil,
                                           recSaldos,
                                           recSaldosML,
                                           fltSaldos,
                                           fRetEmpIte(FieldByName('ITE_EMPITE').AsString),
                                           fRetEmpIte(FieldByName('ITE_EMPITE').AsString),
                                           FieldByName('ITE_CODITE').AsString,
                                           fltCnvML,
                                           fCfgSis('ENTFUT', varBoolean),
                                           blnPedCorte,
                                           fCfgSis('ORDPRO', varBoolean),
                                           intCalSal,
                                           fRetNumLot(FieldByName('ITE_NUMLOT').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString)));

                  FreeAndNil(objSalLoj);

                  If objTabela.isEmpty then
                  Begin
                    objLinha := TLinhaMsgLibera.Create;
                    objLinha.enuTipoLinha := tlCabecalho;
                    objLinha.pAddColuna('', 'Código'           , 7 , alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Descrição'        , 47, alEsquerda, teAutcom);
                    objLinha.pAddColuna('', 'Ent'              , 3 , alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Mot'              , 3 , alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Un'               , 2 , alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Marca'            , 15, alEsquerda, teAutcom);
                    objLinha.pAddColuna('', 'Quantidade'       , 11, alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Saldo Físico'     , 15, alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Saldo Disp.'      , 15, alCentro  , teAutcom);
                    objLinha.pAddColuna('', 'Emp'              , 3 , alCentro  , teAutcom);
                    objTabela.lstLinhas.Add(objLinha);
                  End;

                  objLinha := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlValor;
                  objLinha.pAddColuna('Código'           , FieldByName('ITE_CODITE').AsString                            , 7 , alCentro  , teAmbos);
                  objLinha.pAddColuna('Descrição'        , FieldByName('ITE_DESITE').AsString                            , 47, alEsquerda, teAmbos);
                  objLinha.pAddColuna('Ent'              , FieldByName('ITE_ENTRET').AsString +
                                                           IIF(FieldByName('ITE_ENTRET').AsString = 'E',
                                                           IIF(FieldByName('ITE_ENTFUT').AsString = 'S', '.F', '.I'), ''), 3 , alCentro  , teAmbos);
                  objLinha.pAddColuna('Mot'              , FieldByName('ITE_MOTFUT').AsString                            , 3 , alCentro  , teAmbos);
                  objLinha.pAddColuna('Un'               , fRetSiglaUnidadePorCodIte(FieldByName('ITE_CODITE').AsString) , 2 , alCentro  , teAmbos);
                  objLinha.pAddColuna('Marca'            , fRetNomMarcaItem(FieldByName('ITE_CODITE').AsString)          , 15, alEsquerda, teAmbos);
                  objLinha.pAddColuna('Quantidade'       , FormatFloat('#,##0.00', FieldByName('ITE_QTDITE').AsFloat)    , 11, alDireita , teAmbos);

                  if (fVerificaAcessoSistema('PVISPF')) then
                  begin
                    objLinha.pAddColuna('Saldo Físico'     , FormatFloat('#,##0.00',recSaldos.fltEstFis), 15, alDireita , teAmbos);
                    objLinha.pAddColuna('Saldo Disp.'      , FormatFloat('#,##0.00', fltSalDis)         , 15, alDireita , teAmbos);
                  end
                  else
                  begin
                    objLinha.pAddColuna('Saldo Físico'     , '@('+FormatFloat('#,##0.00',recSaldos.fltEstFis)+')@', 15, alDireita , teAmbos);
                    objLinha.pAddColuna('Saldo Disp.'      , '@('+FormatFloat('#,##0.00', fltSalDis)+')@'         , 15, alDireita , teAmbos);
                  end;

                  objLinha.pAddColuna('Emp'              , strEmpSal                                              , 3 , alCentro  , teAmbos);

                  strNumLotAux := fRetNumLot(FieldByName('ITE_NUMLOT').AsString, fRetEmpIte(FieldByName('ITE_EMPITE').AsString));
                  If (Not fEmptyStr(strNumLotAux)) Then
                  Begin
                    objTabela.lstLinhas.Add(objLinha);
                    objLinha := TLinhaMsgLibera.Create;
                    objLinha.enuTipoLinha := tlValor;

                    If (fCfgSis('CTLEST') = '2') Then
                      objLinha.pAddColuna('', 'Armazém: '+strNumLotAux, objTabela.fGetTamanhoFinalCabecalho-3, alEsquerda)
                    Else
                      objLinha.pAddColuna('', 'Lote: '+strNumLotAux, objTabela.fGetTamanhoFinalCabecalho-3, alEsquerda);
                  End;

                  objTabela.lstLinhas.Add(objLinha);
                End;
              End;
            End;
          End;
        End
        Else If (Not blnSolicitouDeOutraEmpresa) Then
        Begin
          if Not ((cdsVenda.FieldByName('ITE_ENTFUT').AsString = 'S') And (fTravaSaldoEntFutColorante(strOpcao) = 'N') And (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR'))Then
          begin
            strIteEmpPrd := FieldByName('ITE_EMPPRD').AsString;
            If (fF11ProducaoForaLojaEstoqueLogada) Then
              strIteEmpPrd := VS_strCodEmp;

            strEmpSalTin := IIF(((strOprFlj <> 'S') And blnEnt_CD), strEmp_CD, strIteEmpPrd);
            
            matrizSaldosAux := TClassMatrizSaldosColorantes(dicFormulas.RetornaObjeto(cdsVenda.FieldByName('AUTOINCREM').AsString));
            matrizSaldosAux.RecalcularFormulacao(strEmpSalTin, TIdentificadorTintaFactory.GetIdentificadorFatVendas(cdsVenda, fGTinForGeral));
            matrizSaldosAux.fRecalculaSaldos(strEmpSalTin, 
                                             cdsVenda.FieldByName('ITE_QTDITE').AsFloat,
                                             strNumOrc);

            If Not fVerificaEstoqueTintaDeMaquina(matrizSaldosAux, FieldByName('AUTOINCREM').AsString) Then
            Begin

              If (FieldByName('ITE_ENTFUT').AsString = 'S') Then
              Begin
                If (fTravaSaldoEntFutColorante(strOpcao) = 'T') Then
                  blnTravarItemEntFutCol := True
                Else If (fTravaSaldoEntFutColorante(strOpcao) = 'A') Then
                  blnAvisarItemEntFutCol := True;
              End
              Else If (FieldByName('ITE_ENTFUT').AsString = 'N') Then
              Begin
                If (fTravaSaldoItemColorante(strOpcao) = 'T') Then
                  blnTravarItemNormalCol := True
                Else If (fTravaSaldoItemColorante(strOpcao) = 'A') Then
                  blnAvisarItemNormalCol := True;
              End;  

              blnTintaSemEstoque := True;
              strSemEst := 'S';

              For intContador := 0 To matrizSaldosAux.Count - 1 Do
              Begin
                saldosColorantes := matrizSaldosAux[intContador];
                saldosColorantes.strDescTinta := saldosColorantes.strDescTinta + ' (' + strEmpSalTin + ')';
                saldosColorantes.strEmpPrd := strEmpSalTin;
                matrizSaldosColorantes.fAdicionar(saldosColorantes);
              End;
              matrizSaldosColorantes.RecalcularAcumulados(nil, IIF(blnEmpFat, True, False));
            End;
          end;
        End;

        Edit;
        FieldByName('ITE_SEMEST').AsString := strSemEst;
        Post;

        If strSemEst = 'S' Then
          stlAutIncItensSemEstoque.Add(FieldByName('AUTOINCREM').AsString);

        Next;
      End;

      if not objTabela.isEmpty then
        objMsgItensNormalSemEst.lstRegistros.Add(objTabela)
      else
        FreeAndNil(objTabela);

      First;

      If (intAutIncValidar <> -1) Then
         (Locate('AUTOINCREM', intAutIncValidar, []));

      If (pgbProgresso <> Nil) And (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
        pgbProgresso.Visible  := False;

    End;

    blnPediuSenhaItemNormal := False;
    blnPediuSenhaItemTinta  := False;

    If (Assigned(frmFatMostraProdSemSaldo.cdsItens)) And (Not frmFatMostraProdSemSaldo.cdsItens.IsEmpty) Then
    Begin

      If (Not blnApenasResultado) And (blnExibirAviso Or blnTravarItemNormal Or blnTravarItemEntFut) Then
        If VS_ExibirMensagemAoUsuario Then
          frmFatMostraProdSemSaldo.ShowModal;

      If (Not blnApenasExibir) And (blnTravarItemNormal Or blnTravarItemEntFut) Then
      Begin
        if fCfgSis('SENFVU') = 'F' then
          objMsgItensNormalSemEst.Clear;

        If (Pos(strOpcao, 'OR_PD_') > 0) Then
        Begin

          If (strOpcao = 'OR') Then
          Begin
            blnPediuSenhaItemNormal := True;

            If blnApenasResultado Then
              Result := False
            Else
            begin
              If Not objMsgItensNormalSemEst.isEmpty Then
              Begin
                objMsgItensNormalSemEst.pInsertTexto(0, 'Liberação de produto(s) sem saldo - Orçamento!');
                Result := fSenhaLiberacaoSemSaldoOP(strCodVen,
                                                    strCodDig,
                                                    strNtrava,
                                                    stlNumLib,
                                                    objMsgItensNormalSemEst,
                                                    True,
                                                    strCodCli + '-' + strCliNom,
                                                    '',
                                                    FSequencialUnicoDtaHrLogVar,
                                                    fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp),
                                                    IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp), VS_strCodEmp, EmptyStr),
                                                    pMostraMensagem);
              End;
            end;
          End

          Else If (strOpcao = 'PD') Then
          Begin
            blnPediuSenhaItemNormal := True;

            If blnApenasResultado Then
              Result := False
            Else
            begin
              If Not objMsgItensNormalSemEst.isEmpty Then
              Begin
                objMsgItensNormalSemEst.pInsertTexto(0, 'Liberação de produto(s) sem saldo - Pedido!');
                Result := fSenhaLiberacaoSemSaldoPE(strCodVen,
                                                    strCodDig,
                                                    strNtrava,
                                                    stlNumLib,
                                                    objMsgItensNormalSemEst,
                                                    True,
                                                    strOpcao,
                                                    False,
                                                    True,
                                                    blnEnt_CD,
                                                    strCodCli + '-' + strCliNom,
                                                    '',
                                                    FSequencialUnicoDtaHrLogVar,
                                                    (fExibeMensagemTransferenciaEstoqueItemAItem) And (Not (fInformouEmpresaTEParaClienteFilial)),
                                                    fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp),
                                                    IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp), VS_strCodEmp, EmptyStr),
                                                    pMostraMensagem);

              End;
            end;
          End;

        End
        Else
        Begin
          If (Not blnVendaNormalFechandoComoOrcamento) Or
             (fVendaMultiLoja) Or (blnExpedi) Or (strOriF11 = 'S') Then
          Begin
            blnPediuSenhaItemNormal := True;

            If blnApenasResultado Then
              Result := False
            Else
            begin
              if (fCfgSis('SENFVU') = 'F') then
                objMsgItensNormalSemEst.Clear;

              objMsgItensNormalSemEst.pInsertTexto(0, 'Liberação de produto(s) sem saldo - '+IIF(strOriF11='S','Resumo de Caixa!', 'Venda Normal!'));
              Result := fSenhaLiberacaoSemSaldoVN(strCodVen, strCodDig, strNtrava, stlNumLib, objMsgItensNormalSemEst, '', True, strOpcao, False,
                blnExpedi, '', False, blnBaiEntFut, blnEnt_CD, strCodCli + '-' + strCliNom, '', strOriF11, FSequencialUnicoDtaHrLogVar, fExibeMensagemTransferenciaEstoqueItemAItem);
            end;
          End;
        End;

      End;

    End;

    {******************************************************}
    {* NAO DIGITOU SENHA, ENTAO NAO PEDE SENHA PARA TINTA *}
    {***************************************************PH*}
    If (Assigned(frmFatMostraProdSemSaldo.cdsItens)) And (Not frmFatMostraProdSemSaldo.cdsItens.IsEmpty) And (Not Result) Then
    Begin
      blnTintaSemEstoque := False;
    End;

    frmFatMostraProdSemSaldo.pFechaClientItens;

    If blnTintaSemEstoque And (blnTravarItemNormalCol Or blnTravarItemEntFutCol Or blnAvisarItemNormalCol Or blnAvisarItemEntFutCol) And (blnVerEstOrc) Then
    Begin
      If blnTelaSaldoTintas And Not blnApenasResultado And VS_ExibirMensagemAoUsuario Then
      begin
        matrizSaldosColorantes := fRetornaMatrizFormulacaoTintasAcumulada(True);
        matrizSaldosColorantes.RecalcularAcumulados(nil, IIF(blnEmpFat, True, False));
        fVisualizarSaldoTintas(matrizSaldosColorantes);
      end;

      If (blnTravarItemNormalCol Or blnTravarItemEntFutCol) Then
      Begin
        objMsg := TMensagemLiberacao.Create(Self);
        Try
          objTabela := TRegistroMsgLiberaTabela.Create;

          objLinha := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'PRODUTO' , 50, alEsquerda , teAutcom);
          objLinha.pAddColuna('', 'SALDO'   , 10, alCentro   , teAutcom);
          objLinha.pAddColuna('', 'QTD.DIG.', 10, alCentro   , teAutcom);
          objTabela.lstLinhas.Add(objLinha);

          For intContador := 0 To matrizSaldosColorantes.Count -1 Do
          Begin
            blnTintaSemEstoque := false;

            if (matrizSaldosColorantes[intContador].strBasCol = EMBALAGEM) Then
            begin
              If (matrizSaldosColorantes[intContador].fltSaldoML < 0) Then
                blnTintaSemEstoque := true;
            end
            else
            If ((matrizSaldosColorantes[intContador].fltSaldoML <= 0)
             Or (matrizSaldosColorantes[intContador].fltSaldoML < matrizSaldosColorantes[intContador].fltQtdFormAcu)) Then
              blnTintaSemEstoque := true;

            if blnTintaSemEstoque Then
            begin
              objLinha := TLinhaMsgLibera.Create;
              objLinha.enuTipoLinha := tlValor;
              objLinha.pAddColuna('PRODUTO'  , matrizSaldosColorantes[intContador].strCodIte +'-'+ matrizSaldosColorantes[intContador].strDesIte , 50, alEsquerda , teAmbos);
              objLinha.pAddColuna('SALDO'    , FormatFloat('#,##0.00', matrizSaldosColorantes[intContador].fltSaldoML)                           , 10, alDireita  , teAmbos);
              objLinha.pAddColuna('QTD.DIG.' , FormatFloat('#,##0.00', matrizSaldosColorantes[intContador].fltQtdFormAcu)                        , 10, alDireita   , teAmbos);
              objTabela.lstLinhas.Add(objLinha);
            end;

          End;

          objMsg.lstRegistros.Add(objTabela);

          If (Not blnApenasExibir) Then
          Begin
            If (strOpcao = 'OR') And (blnTelaSaldoTintas) Then
            Begin
              blnPediuSenhaItemTinta := True;

              If blnApenasResultado Then
                Result := False
              Else
                Result := fSenhaLiberacaoTintaSemSaldoOP(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg, True, blnExpedi, strOriF11, strCodCli + '-' + strCliNom, '', FSequencialUnicoDtaHrLogVar);
            End

            Else If (strOpcao = 'PD') And (blnTelaSaldoTintas) Then
            Begin
              blnPediuSenhaItemTinta := True;

            If blnApenasResultado Then
              Result := False
            Else
              Result := fSenhaLiberacaoTintaSemSaldoPE(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg, strOpcao, False, blnEnt_CD, True, blnExpedi, strOriF11, strCodCli + '-' + strCliNom, '', FSequencialUnicoDtaHrLogVar, fExibeMensagemTransferenciaEstoqueItemAItem);
          End

          Else If {(Pos(strOpcao, 'VN_CS_') > 0) And} (blnTelaSaldoTintas) Then
            Begin
              blnPediuSenhaItemTinta := True;

              If blnApenasResultado Then
                Result := False
              Else
                Result := fSenhaLiberacaoTintaSemSaldoVN(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg, '', TRUE, strOpcao, False, blnExpedi, strOriF11, strCodCli + '-' + strCliNom, '', FSequencialUnicoDtaHrLogVar);
            End;
          End;

        Finally
          FreeAndNil(objMsg);
        End;
      End;
    End;

    If (Not blnApenasExibir) And Result Then
    Begin
      //Marca todos os produtos que nao possuem estoque mas que foram liberados mediante senha
      //para que nao seja solicitada novamente a senha de liberacao de estoque, a menos que a quantidade seja alterada.
      For intContador := 0 To stlAutIncItensSemEstoque.Count -1 Do
      Begin
        If cdsVenda.Locate('AUTOINCREM', stlAutIncItensSemEstoque[intContador], []) Then
        Begin
          If ((cdsVenda.FieldByName('ITE_IDEPRO').AsString  = 'NOR') And blnPediuSenhaItemNormal) Or
             ((cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') And blnPediuSenhaItemTinta ) Then
          Begin
            cdsVenda.Edit;
            cdsVenda.FieldByName('ITE_LIBEST').AsString := 'S';
            cdsVenda.Post;
          End;
        End;
      End;
    End;

    FreeAndNil(stlAutIncItensSemEstoque);

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fVerificaEstoqueItens]');
    End;
  End;
  blnVerificandoEstoqueLiberadoParaCorte := False;
  pEnableControls(cdsVenda, prcScroll);

  pFreeAndNil(frmFatMostraProdSemSaldo);
  FreeAndNil(matrizSaldosColorantes);
  FreeAndNil(objMsgSubItensSemEst);
  FreeAndNil(objMsgItensNormalSemEst);
End;

function TFatVenda.fPermitePassarItemSemEstoquePoisIraGerarVendasPerdidas(blnVerificarLiberados: Boolean): Boolean;
begin
  Result := (fCfgSis('CTESPV', varBoolean)) And
            ( ((strOpcDoc = 'PD') Or  (strEspDoc = 'PD')) Or
              ((strOpcDoc = 'VN') And (fCfgSis('PRCTPV') = '1')) );

  If (Result) And (blnVerificarLiberados) Then
    Result := Not fTemItensDeCorteSemSaldoLiberado;
end;

function TFatVenda.fEhProdutoAcabado(cdsVenda: TUniClientDataSet): Boolean;
Begin
  Result := False;


  If (cdsVenda.FieldByName('ITE_IDEPRO').AsString = 'NOR') And
    (cdsVenda.FieldByName('ITE_PROACA').AsString = '1') Then
    Exit(True);
End;

function TFatVenda.fPermitePontosClubeFidelidade: Boolean;
begin
  Result := (not blnLibCnf) and (Pos(strOpcDoc, 'CF_CI_CT_OF_EF_NC_') <= 0)
       and (not blnNotEsp) and (not blnMeiaNota) and (blnGravarCadRec);
end;

function TFatVenda.fExibirItensSemEstoqueParaCorte: Boolean;
begin
  pCriarFormularios(TfrmFatResumoEstoqueParaCorte, frmFatResumoEstoqueParaCorte);
  Try
    frmFatResumoEstoqueParaCorte.fatVenda := Self;
    Result := (frmFatResumoEstoqueParaCorte.ShowModal = mrOk);
  Finally
    pFreeAndNil(frmFatResumoEstoqueParaCorte);
  End;
end;

function fPermiteEmissaoEspecieMIFF(fatVenda: TFatVenda): Boolean;
begin
  Result := True;

  If Pos(fatVenda.strEspDoc, 'MI_FF_') > 0 Then
    If (Not fatVenda.fPermiteEmissaoFFPeloTipoDePedido) Then
      Exit(False);

  If fatVenda.blnExpedi And Assigned(fatVenda.objExpedicao) And (fatVenda.objExpedicao.VS_strTipExpInterna <> '3') Then
    Exit(True);

  If (Not fCfgSis('MIFEST', varBoolean)) And (Pos(fatVenda.strEspDoc, 'MI_FF') > 0) Then
    If (fatVenda.fTrocaUFEndEntrega <> fCadEmp('ESTADO')) And
       (fVerificaSituacaoTributaria(fatVenda)) And
       (Not fatVenda.blnVendaPresencial) Then
    Begin
      fMensagem('ATENÇÃO!', 'Não é permitido confirmar ' + fatVenda.strEspDoc + ' com produto que ' +
                            'tenha substituição tributária para cliente fora do estado!', ['&O k']);
      Exit(False);
    End;
end;

function fVerificaLimiteCreditoExpedicao(fatVenda: TFatVenda): Boolean;
begin
  Result := True;

  if (fCfgSis('ALPKNK', varBoolean)) and
     (Pos(fatVenda.strCodCnd, fCfgSis('CNDBOL', varString)) > 0) then
    Exit;

  If (fCfgSis('LMCREP') = 'N') then
    Exit;

  If (Pos(VS_strTipExp, '_3_4') = 0) Then
    Exit;

  Result := fatVenda.fDebitoCliente(fatVenda.strCodFpg, fatVenda.strConPag, 9);

  If Result Then
    Result := fatVenda.fVerificaLimiteCredito(fatVenda.strConPag,
                                              fLimiteCreditoCliente(fatVenda.strCodCli),
                                              fatVenda.fValorTotalExpedido, True, True, 'LMCREP');
end;

function fVerificaLimiteCreditoPadrao(fatVenda: TFatVenda): Boolean;
const
  MSG_CLIENTE_SEM_LIMITE_CREDITO = 'Cliente sem limite de crédito.';
var
  fltLimiteCredito: Double;
begin
  Result := True;

  fltLimiteCredito := fLimiteCreditoCliente(fatVenda.strCodCli);

  If Not fatVenda.fVerificaLimiteCredito(fatVenda.strConPag, fltLimiteCredito, fatVenda.fltTotGer) Then
  Begin
    If fCfgSis('SISCRE', varBoolean) And Not fatVenda.blnExecutandoFaturadorAutomatico Then
      pMensagemOk(MENSAG_CREDIARIO)
    Else
      pMensagemOk(MSG_CLIENTE_SEM_LIMITE_CREDITO);
    Exit(False);
  End;
end;

