procedure TFatVenda.pPreencherMsgDadosAdicBaixaEntFutNF;
var
    intIdx: Integer;
    stlLisMsg: TStringList;
    strMsgTmp,
    strLisAutInc: String;
    qryGen: TUniQuery;
begin
  //Este procedimento deve ser chamado somente após a rotina que o usará chamar o método pPreencheMatrizFechamento
  //para preencher o Self.arrMatItens com os itens referentes à operação e após a rotina calcular os dados de impostos
  //e o campo Self.strClaFis estiver preenchido.

  //Verifica se trata-se de uma nota de baixa de entrega futura
  If (Pos(Self.strClaFis, CLAFIS_ENTFUT_VEN) > 0) Then
  Begin
    qryGen := fCriaQuery(Nil);
    stlLisMsg := TStringList.Create;
    Try
      strLisAutInc := '';
      For intIdx := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
        pIncrementaListaStr(Self.arrMatItens[intIdx].strIncFut, strLisAutInc, True, True, ',', False, False);

      If (Not strLisAutInc.IsEmpty) Then
      Begin
        //Alimenta Self.strMsgDadosAdicBaixaEntFutNF
        stlLisMsg.Clear;
          
        qryGen.Close;
        qryGen.SQL.Text := 
                  ' SELECT ' +
                '   D.DET_NUMDOC, ' +
                '   D.DET_ESPDOC, ' +
                '   D.DET_SERIE_, ' +
                '   D.DET_DTAENT, ' +
                '   G.GER_VLRCON ' +
                ' FROM ' +
                  '   MOVDET D INNER JOIN MOVGER G ON D.DET_SEQGER = G.AUTOINCREM ' +
                ' WHERE ' +
                  '   D.AUTOINCREM IN ('+strLisAutInc+'); ';

        qryGen.Open;

        qryGen.First;
        While Not qryGen.Eof Do
        Begin
          If Pos(qryGen.FieldByName('DET_ESPDOC').AsString, 'NF_') > 0 Then
          Begin
            strMsgTmp := 'Nº ' + qryGen.FieldByName('DET_NUMDOC').AsString +
                         ' - SÉRIE ' + qryGen.FieldByName('DET_SERIE_').AsString +
                         ' - DE ' + FormatDateTime('dd/mm/yyyy', qryGen.FieldByName('DET_DTAENT').AsDateTime)  +
                         ' - NO VALOR DE R$ '+ FormatFloat(',0.00', qryGen.FieldByName('GER_VLRCON').AsFloat);

            If stlLisMsg.IndexOf(strMsgTmp) = -1 Then
              stlLisMsg.Add(strMsgTmp);
          End;

          qryGen.Next;
        End;

        If (stlLisMsg.Count > 0) Then
        Begin
          Self.strMsgDadosAdicBaixaEntFutNF := 'REFERENTE AS NOTAS FISCAIS DE SIMPLES FATURAMENTO:' + #13#10;

          For intIdx := 0 To stlLisMsg.Count-1 Do
            Self.strMsgDadosAdicBaixaEntFutNF := Self.strMsgDadosAdicBaixaEntFutNF + stlLisMsg[intIdx] + #13#10;
        End;

        //Alimenta Self.MsgDosPedidosNosDadosAdicDaBaixaEntFutNF
        stlLisMsg.Clear;

        qryGen.Close;
        qryGen.SQL.Text := 
                  ' SELECT FGO_MEN001, FGO_MEN002, AUX_MEN003, AUX_MEN004, AUX_MEN005 '+
                  '       FROM MOVDET D '+
                  '       INNER JOIN MOVAUX A ON D.AUTOINCREM = A.DET_SEQGER '+
                  '       INNER JOIN FATDOR F ON F.AUTOINCREM = A.DET_INC_PD '+
                  '       INNER JOIN FATGOR G ON F.FDO_SEQGER = G.AUTOINCREM '+
                  '        LEFT JOIN AUXGOR H ON G.AUTOINCREM = H.AUX_SEQGER '+
                  ' WHERE ' +
                  '   D.AUTOINCREM IN ('+strLisAutInc+'); ';
        qryGen.Open;

        qryGen.First;
        While Not qryGen.Eof Do
        Begin
          strMsgTmp := qryGen.FieldByName('FGO_MEN001').AsString;
          If (Not fEmptyStr(strMsgTmp)) And (stlLisMsg.IndexOf(strMsgTmp) = -1) Then
          Begin
            stlLisMsg.Add(strMsgTmp);
          End;

          strMsgTmp := qryGen.FieldByName('FGO_MEN002').AsString;
          If (Not fEmptyStr(strMsgTmp)) And (stlLisMsg.IndexOf(strMsgTmp) = -1) Then
          Begin
            stlLisMsg.Add(strMsgTmp);
          End;

          strMsgTmp := qryGen.FieldByName('AUX_MEN003').AsString;
          If (Not fEmptyStr(strMsgTmp)) And (stlLisMsg.IndexOf(strMsgTmp) = -1) Then
          Begin
            stlLisMsg.Add(strMsgTmp);
          End;

          strMsgTmp := qryGen.FieldByName('AUX_MEN004').AsString;
          If (Not fEmptyStr(strMsgTmp)) And (stlLisMsg.IndexOf(strMsgTmp) = -1) Then
          Begin
            stlLisMsg.Add(strMsgTmp);
          End;

          strMsgTmp := qryGen.FieldByName('AUX_MEN005').AsString;
          If (Not fEmptyStr(strMsgTmp)) And (stlLisMsg.IndexOf(strMsgTmp) = -1) Then
          Begin
            stlLisMsg.Add(strMsgTmp);
          End;

          qryGen.Next;
        End;

        Self.strMsgDosPedidosNosDadosAdicDaBaixaEntFutNF := EmptyStr;

        If (stlLisMsg.Count > 0) Then
        Begin
          strMsgTmp := '';
          For intIdx := 0 To stlLisMsg.Count-1 Do
            strMsgTmp := strMsgTmp + IIF(strMsgTmp.IsEmpty, '', ', ') + stlLisMsg[intIdx];

          Self.strMsgDosPedidosNosDadosAdicDaBaixaEntFutNF := strMsgTmp;
        End;
      End;
    Finally
      FreeAndNil(stlLisMsg);
      FreeAndNil(qryGen);
    End;
  End;
end;

procedure TFatVenda.pProcessarInfAdProdSchaeffler;

  function fGetOrdemDetEle(strSeqGerEle: String; strCodIte: String): Integer;
    Var
      qryDetEle : TUniQuery;
  begin
    Result := 0;

    If fEmptyStr(strSeqGerEle) Then
      Exit;

    qryDetEle := fCriaQuery(Self);
    Try
      With qryDetEle Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT AUTOINCREM, DET_CODITE ');
        SQL.Add('   FROM DETELE ');
        SQL.Add('  WHERE DET_SEQGER = :SEQGER ');
        SQL.Add('  ORDER BY AUTOINCREM ');
        ParamByName('SEQGER').AsString := strSeqGerEle;
        Open;

        First;
        While Not Eof Do
        Begin
          If (FieldByName('DET_CODITE').AsString = strCodIte) Then
          Begin
            Result := recNo;
            Break;
          End;
          Next;
        End;

        Close;
      End;
    Finally
      FreeAndNil(qryDetEle);
    End;
  end;

  function fGetSQLFisEle: String;
  begin
    Result := '';
    Result := Result + ' SELECT FIS_NUMDOC, FIS_SERIE_, DET_CODITE, I02_CPROD, GERELE.AUTOINCREM AS GERINC ';
    Result := Result + '   FROM CADFIS ';
    Result := Result + '   LEFT JOIN GERELE ON GER_DOCENT = FIS_NUMDOC ';
    Result := Result + '                   AND GER_ESPENT = FIS_ESPDOC ';
    Result := Result + '                   AND GER_EMPENT = FIS_CODEMP ';
    Result := Result + '                   AND GER_CODFOR = FIS_FORCLI ';
    Result := Result + '                   AND IFNULL(B07_SERIE, "") = IFNULL(FIS_SERIE_, "") ';
    Result := Result + '   LEFT JOIN DETELE ON DET_SEQGER = GERELE.AUTOINCREM ';
  end;

  Var
    intCnt : Integer;
    qryCadFis : TUniQuery;
    strValue : String;
begin
  If ((strOpcDoc = 'OF') And (fCfgSis('FORSCH') = strCodCli)) Or
     ((Not fDocumentoParaFornecedor) And (fCfgSis('CLISCH') = strCodCli))  Then
  Begin
    qryCadFis := fCriaQuery(Self);
    Try
      If Not fEmptyStr(strChaveNFeRefDevolucao) Then
      Begin
        qryCadFis.Close;
        qryCadFis.SQL.Clear;
        qryCadFis.SQL.Add(fGetSQLFisEle);
        qryCadFis.SQL.Add('  WHERE FIS_ACESSO = :ACESSO ');
        qryCadFis.ParamByName('ACESSO').AsString := strChaveNFeRefDevolucao;
        qryCadFis.Open;
      End
      Else
      Begin
        For intCnt := 0 To Length(arrMatItens) -1 Do
        Begin
          If Not fEmptyStr(arrMatItens[intCnt].strDocDev) Then
          Begin
            qryCadFis.Close;
            qryCadFis.SQL.Clear;
            qryCadFis.SQL.Add(fGetSQLFisEle);
            qryCadFis.SQL.Add('  WHERE FIS_NUMDOC = :NUMDOC ');
            qryCadFis.SQL.Add('    AND FIS_ESPDOC = :ESPDOC ');
            qryCadFis.SQL.Add('    AND FIS_CODEMP = :CODEMP ');
            qryCadFis.SQL.Add('    AND FIS_FORCLI = :FORCLI ');
            qryCadFis.SQL.Add('    AND IFNULL(FIS_ACESSO, "") <> "" ');
            qryCadFis.ParamByName('NUMDOC').AsString := arrMatItens[intCnt].strDocDev;
            qryCadFis.ParamByName('ESPDOC').AsString := arrMatItens[intCnt].strEspDev;
            qryCadFis.ParamByName('CODEMP').AsString := arrMatItens[intCnt].strEmpDev;
            qryCadFis.ParamByName('FORCLI').AsString := strCodCli;
            qryCadFis.Open;

            If (Not qryCadFis.IsEmpty) Then
              Break;
          End;
        End;
      End;

      If (qryCadFis.Active) And (Not qryCadFis.IsEmpty) And (CFOP_DEVOLUCAO.Contains(strClafis)) Then
      Begin
        For intCnt := 0 To Length(arrMatItens) -1 Do
        Begin
          If qryCadFis.Locate('DET_CODITE', arrMatItens[intCnt].strCodIte, []) Then
          Begin
            // NFeSCH=NNNNNNNNNNNN-SSS-IT-II;xMatnr=CCCCCCCCCCC;
            arrMatItens[intCnt].strDesNes := 'NFeSCH=' + qryCadFis.FieldByName('FIS_NUMDOC').AsString + '-' + qryCadFis.FieldByName('FIS_SERIE_').AsString + '-IT-' + fStrZero(fGetOrdemDetEle(qryCadFis.FieldByName('GERINC').AsString, arrMatItens[intCnt].strCodIte), 2) + ';xMatnr=' + qryCadFis.FieldByName('I02_CPROD').AsString + ';';
          End;
        End;
      End
      Else
      Begin
        For intCnt := 0 To Length(arrMatItens) -1 Do
        Begin
          strValue := '';

          If (Not fDocumentoParaFornecedor) And (fCfgSis('CLIPRO', varBoolean)) Then
            strValue := fCampoTabela('CLI_COD_NF', 'CLIPRO', ['CLI_CODITE', 'CLI_CODCLI'], [arrMatItens[intCnt].strCodIte, strCodCli], False);

          If (fEmptyStr(strValue)) And (fDocumentoParaFornecedor) Then
            strValue := fCampoTabela('ITE_CODFAB', 'ITEFOR', ['ITE_CODITE', 'ITE_CODFOR'], [arrMatItens[intCnt].strCodIte, strCodCli], False);

          If fEmptyStr(strValue) Then
            strValue := fRetCodFabrica(arrMatItens[intCnt].strCodIte);

          If Not fEmptyStr(strValue) Then
          Begin
            // xMatnr=CCCCCCCCCCC
            arrMatItens[intCnt].strDesNes := 'xMatnr=' + strValue + ';';
          End;
        End;
      End;
    Finally
      FreeAndNil(qryCadFis);
    End;
  End;
end;

procedure TFatVenda.pAtualizarReformaTributariaNoCdsVenda;
  Var
    intContador  : Integer;
    blnLocalizou : Boolean;
    prcScroll    : TprcScroll;
    bkm          : TBookmark;
begin
  bkm := cdsVenda.Bookmark;
  pDisableControls(cdsVenda, prcScroll);
  Try
    For intContador := 0 To Length(arrMatItens) -1 Do
    Begin
      blnLocalizou := False;
      If (Self.blnExpedicaoTeveQuebraDeItensRastreaveis) And (Length(arrMatItens[intContador].strSeqDet) = 20) Then
        blnLocalizou := cdsVenda.Locate('ITE_SEQDET', arrMatItens[intContador].strSeqDet, []);

      If (Not blnLocalizou) Then
        blnLocalizou := cdsVenda.Locate('AUTOINCREM;ITE_CODITE', VarArrayOf([arrMatItens[intContador].intAutInc,
                                                                             arrMatItens[intContador].strCodIte]), []);
      If (Not blnLocalizou) Then
        Continue;

      cdsVenda.Edit;
      cdsVenda.FieldByName('ITE_VALCBS').AsFloat := arrMatItens[intContador].fltValCBS;
      cdsVenda.FieldByName('ITE_VALIBS').AsFloat := arrMatItens[intContador].fltValIBS;
      cdsVenda.FieldByName('ITE_VAL_IS').AsFloat := arrMatItens[intContador].fltVal_IS;
      cdsVenda.FieldByName('ITE_VLRCON').AsFloat := cdsVenda.FieldByName('ITE_TOTITE').AsFloat + cdsVenda.FieldByName('ITE_VAL_ST').AsFloat +
                                                    cdsVenda.FieldByName('ITE_VALIPI').AsFloat + cdsVenda.FieldByName('ITE_VFCPST').AsFloat +
                                                    cdsVenda.FieldByName('ITE_VALCBS').AsFloat + cdsVenda.FieldByName('ITE_VALIBS').AsFloat +
                                                    cdsVenda.FieldByName('ITE_VAL_IS').AsFloat;
      If (cdsVenda.FieldByName('ITE_QTDITE').AsFloat <> 0) Then
        cdsVenda.FieldByName('ITE_UNICON').AsFloat := fFormataFloat(((cdsVenda.FieldByName('ITE_UNITAR').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat) +
                                                                     cdsVenda.FieldByName('ITE_VAL_ST').AsFloat + cdsVenda.FieldByName('ITE_VALIPI').AsFloat +
                                                                     cdsVenda.FieldByName('ITE_VFCPST').AsFloat + cdsVenda.FieldByName('ITE_VALCBS').AsFloat +
                                                                     cdsVenda.FieldByName('ITE_VALIBS').AsFloat + cdsVenda.FieldByName('ITE_VAL_IS').AsFloat) /
                                                                    cdsVenda.FieldByName('ITE_QTDITE').AsFloat, 2);
      cdsVenda.Post;
    End;
  Finally
    If cdsVenda.BookmarkValid(bkm) Then
      cdsVenda.GotoBookmark(bkm);
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

