function TFatVenda.fNumeroDeGuicheJahUtilizado(intNumGui : Integer; strEntRet : String): Boolean;
var
  qryNumGui : TUniQuery;

const
  SQL = 'SELECT         ' +
        '  B.FGO_NUMGUI ' +
        'FROM           ' +
        '  FATGOR A     ' +
        '  INNER JOIN EXTGOR B ON A.AUTOINCREM = B.FGO_SEQFGO ' +
        '  INNER JOIN FATDOR C ON A.AUTOINCREM = C.FDO_SEQGER ' +
        '  INNER JOIN EXTDOR D ON C.AUTOINCREM = D.FDO_SEQFDO ' +
        'WHERE                          ' +
        '  B.FGO_NUMGUI IS NOT NULL AND ' +
        '  B.FGO_NUMGUI <> ""       AND ' +
        '  A.FGO_ESPDOC = "PD"      AND ' +
        '  D.FDO_ENTRET = :ENTRET   AND ' +
        '  A.FGO_JAFATU = "0"       AND ' +
        '  B.FGO_NUMGUI = :NUMGUI   AND ' +
        '  A.FGO_CODEMP = :CODEMP       ' +
        'GROUP BY                       ' +
        '  A.AUTOINCREM ';
begin

  Result := False;

  If (intNumGui < 0) Then
    Exit;

  If (strEntRet.IsEmpty) Then
    Exit;

  qryNumGui := fCriaQuery;

  Try

    qryNumGui.Close;
    qryNumGui.SQL.Clear;
    qryNumGui.SQL.Add(SQL);
    qryNumGui.ParamByName('ENTRET').AsString := strEntRet;
    qryNumGui.ParamByName('NUMGUI').AsString := FormatFloat('000', intNumGui);
    qryNumGui.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryNumGui.Open;

    Result := Not qryNumGui.IsEmpty;

  Finally
    FreeAndNil(qryNumGui);
  End;

end;

function TFatVenda.fNUMPOK_Em_Duplicidade(var strNum_PD : String): Boolean;
var
  qryNumPok : TUniQuery;
const
  SQL = 'SELECT                                                           ' +
        '  CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC, "-", FGO_CODEMP) AS PEDIDO ' +
        'FROM     ' +
        '  FATGOR ' +
        'WHERE    ' +
        '  FGO_NUMPOK = :NUMPOK AND ((FGO_NUMDOC <> :NUMDOC) OR (FGO_ESPDOC <> :ESPDOC) OR (FGO_CODEMP <> :CODEMP)) ';
Begin

  Result := False;

  qryNumPok := fCriaQuery;

  Try

    qryNumPok.Close;
    qryNumPok.SQL.Clear;
    qryNumPok.SQL.Add(SQL);
    qryNumPok.ParamByName('NUMPOK').AsString := Self.strNumPok;
    qryNumPok.ParamByName('NUMDOC').AsString := Self.strNumOrc;
    qryNumPok.ParamByName('ESPDOC').AsString := Self.strEspOrc;
    qryNumPok.ParamByName('CODEMP').AsString := Self.strEmpOri;
    qryNumPok.Open;

    If Not qryNumPok.IsEmpty Then
    Begin
      strNum_PD := qryNumPok.FieldByName('PEDIDO').AsString;
      Exit(True);
    End;

  Finally
    FreeAndNil(qryNumPok);
  End;

End;

