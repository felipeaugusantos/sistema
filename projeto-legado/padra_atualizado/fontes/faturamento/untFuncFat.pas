              arrMatItens[intPosMat].strCodVe2 := qryFut.FieldByName('DET_CODVE2').AsString;

              fltTot_RT := arrMatItens[intPosMat].fltRT_Ori * fltQtdIte;

              fltTotCom := (fltTotIte - fltDesEspIte - fltTaxEntIte - fltTot_RT) * (fltPerCom/100);

              fltPerExt := qryFut.FieldByName('DET_PERREP').AsFloat;
              fltTotExt := fltPerExt * (fltTotIte - fltDesEspIte - fltTaxEntIte - fltTot_RT) / 100;

              If fCfgSis('USADIG',varBoolean) And (fCfgSis('OPCCOM') = 'P') Then
              Begin
                fltPerDig := qryFut.FieldByName('DET_PERDIG').AsFloat;
                fltTotDig := fltPerDig * (fltTotIte - fltDesEspIte - fltTaxEntIte - fltTot_RT) / 100;
              End;

              If (fCfgSis('REPVEN', varBoolean)) And (Not fEmptyStr(strCodVe2)) Then
              Begin
                fltTotCo2 := (fltTotCom * fCfgSis('TAXREP', varDouble)) / 100;
                fltTotCom := fltTotCom - fltTotCo2;
              End
              Else
                fltTotCo2 := 0;

              fltBcaCom := ((qryFut.fieldbyname('DET_BCACOM').AsFloat / qryFut.fieldbyname('DET_QTDITE').AsFloat) * fltQtdIte);
              fltBcaMin := qryFut.FieldByName('DET_BCAMIN').AsFloat;
            End
            Else
            Begin
              fltBcaMin := 0;
              fltBcaCom := 0;
            End;
          End;

        End
        Else
        Begin
          fltBcaMin := 0;
          fltBcaCom := 0;
        End;

      End;

    End;

    If (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) Then
    Begin
      {*************************************************************************}
      {* O SISTEMA DEVE FORMATAR OS VALORES DE COMISSAO COM A MESMA PRECISAO   *}
      {* DO CAMPO GRAVADO NO MOVDET, POIS LOGO ABAIXO OS MESMOS VAO SER        *}
      {* ACUMULADOS PARA GRAVACAO DE COMISSAO NO CADREC/CADPAG E ESTAVA        *}
      {* OCORRENDO DIVERGENCIA ENTRE O SOMATORIO DOS ITENS (MOVDET) CONTRA     *}
      {* OS VALORES GRAVADOS NO CADREC/CADPAG (VER UTILIZACAO DAS VARIAVEIS)   *}
      {******************************************************************RO,JC**}
      fltTotCom := fFormataFloat(fltTotCom, 2);
      fltTotExt := fFormataFloat(fltTotExt, 2);
      fltTotCo2 := fFormataFloat(fltTotCo2, 2);

      {************************************************************************}
      {* VARIAVEIS UTILIZADAS PARA GRAVACAO DE COMISSAO DO VENDEDOR NO CADREC *}
      {* ESTA ROTINA DEVE FICAR APOS DEFINIR COMISSAO PARA DEVOLUCAO          *}
      {*****************************************************************RO,JC**}
      If (Pos(strOpcDoc, 'TR_CA_') > 0) And (arrMatItens[intPosMat].strClaFis < '5000') Then
      Begin
        fltVlrCom := fltVlrCom - fltTotCom;
        fltVlrExt := fltVlrExt - fltTotExt;
      End
      Else
      Begin
        fltVlrCom := fltVlrCom + fltTotCom;
        fltVlrExt := fltVlrExt + fltTotExt;
      End;

      {*******************************************************************************}
      {* VARIAVEIS UTILIZADAS PARA GRAVACAO DE COMISSAO DO VENDEDOR (CONTAS A PAGAR) *}
      {************************************************************************RO,JC**}
      If (Pos(strClaFis, VS_strClaVen) > 0) And
         (Pos(strOpcDoc, 'CF_CI_') <= 0)    And
         (Pos(strEspDoc, 'IF_IV_NF_EL_NS_MI_FF_EP_DV_') > 0) Then
      Begin
        If fltTotCom > 0 Then
        Begin
          If cdsComDev.Locate('CODVEN', arrMatItens[intPosMat].strCodVen, []) Then
            cdsComDev.Edit
          Else
            cdsComDev.Insert;

          cdsComDev.FieldByName('CODVEN').AsString := arrMatItens[intPosMat].strCodVen;
          cdsComDev.FieldByName('VALCOM').AsFloat := cdsComDev.FieldByName('VALCOM').AsFloat + fltTotCom;
          cdsComDev.Post;
        End;

        If fltTotCo2 > 0 Then
        Begin
          If cdsComDev.Locate('CODVEN', arrMatItens[intPosMat].strCodVe2, []) Then
            cdsComDev.Edit
          Else
            cdsComDev.Insert;

          cdsComDev.FieldByName('CODVEN').AsString := arrMatItens[intPosMat].strCodVe2;
          cdsComDev.FieldByName('VALCO2').AsFloat := cdsComDev.FieldByName('VALCO2').AsFloat + fltTotCo2;
          cdsComDev.Post;
        End;
      End;
    End;

    If blnBaiEntFut Then
      blnFilKar := True;

    Result := True;

    //Para zerar o estoque do produto estrutura
    If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') And
       (blnBaiEntFut And (arrMatItens[intPosMat].strEntSai = 'E') And (arrMatItens[intPosMat].strProEmb = 'S')) Then
    Begin
      blnFilKar := False;
    End
       {Concremassa}
    Else If blnSimplesRemessaConcretoDadosCliente Or blnNotaServicoConcreto Then
    Begin
      blnFilKar := True;
    End

    Else If fEhItemServico(strCodIte) Or (strCodIte = fCfgSis('ITEFRE')) Or (strCodIte = fCfgSis('ITEBOM')) Or (strCodIte = fCfgSis('ITETAX')) Or
                                                                            (strCodIte = fCfgSis('ITEMAN')) Or (strCodIte = fCfgSis('ITELAN')) Then
    Begin
      blnFilKar := True;
    End

    Else If Assigned(objEstruturaVidros) And fEhItemVendaVidro(strCodIte) And (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) Then
