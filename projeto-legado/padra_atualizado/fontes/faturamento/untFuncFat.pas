function TFatVenda.fGeraRelacaoCodigoONU: String;
  var
    intCont: integer;
    strCodIte : string;
    qryCodONU : TUniQuery;
begin

  Result := EmptyStr;

  If (Not fCfgSis('CLAONU', varBoolean)) Then
    Exit;

  for intCont := Low(arrMatItens) to High(arrMatItens) do
    strCodIte := strCodIte +
                 iif(fEmptyStr(strCodIte), '', ', ')+
                 '"'+arrMatItens[intCont].strCodIte+'"';

  If fEmptyStr(strCodIte) Then
    Exit;

  qryCodONU := fCriaQuery;

  Try

    qryCodONU.SQL.Clear;
    qryCodONU.SQL.Add('SELECT                                     ');
    qryCodONU.SQL.Add('  GROUP_CONCAT(                            ');
    qryCodONU.SQL.Add('    IFNULL(                                ');
    qryCodONU.SQL.Add('      CONCAT("Código ONU:", O.ONU_CODIGO), ');
    qryCodONU.SQL.Add('      ""                                   ');
    qryCodONU.SQL.Add('    ),                                     ');
    qryCodONU.SQL.Add('    IFNULL(                                ');
    qryCodONU.SQL.Add('      CONCAT(                              ');
    qryCodONU.SQL.Add('        "-Classif. de Risco:",             ');
    qryCodONU.SQL.Add('        O.ONU_CLARIS                       ');
    qryCodONU.SQL.Add('      ),                                   ');
    qryCodONU.SQL.Add('      ""                                   ');
    qryCodONU.SQL.Add('    ),                                     ');
    qryCodONU.SQL.Add('    IFNULL(                                ');
    qryCodONU.SQL.Add('      CONCAT(                              ');
    qryCodONU.SQL.Add('        "-Grupo de Embalag.:",             ');
    qryCodONU.SQL.Add('        O.ONU_GRUEMB                       ');
    qryCodONU.SQL.Add('      ),                                   ');
    qryCodONU.SQL.Add('      ""                                   ');
    qryCodONU.SQL.Add('    )                                      ');
    qryCodONU.SQL.Add('  ) AS RELONU                              ');
    qryCodONU.SQL.Add('FROM                                       ');
    qryCodONU.SQL.Add('  CADITE I                                 ');
    qryCodONU.SQL.Add('  LEFT JOIN CADONU O                       ');
    qryCodONU.SQL.Add('    ON O.ONU_CODONU = I.ITE_CODONU         ');
    qryCodONU.SQL.Add('WHERE I.ITE_CODITE IN ('+strCodIte+')      ');
    qryCodONU.SQL.Add('  AND I.ITE_CODONU IS NOT NULL             ');
    qryCodONU.Open;

    if not qryCodONU.isEmpty then
      Result := qryCodONU.FieldByName('RELONU').asString;

  finally
    FreeAndNil(qryCodONU);
  end;

end;

