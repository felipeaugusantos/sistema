function TFatVenda.fPedeDadosCartao: Boolean;
begin
  Try
    pCriarFormularios(TfrmFatDigCartoes, frmfatDigCartoes);

    frmfatDigCartoes.edtCodCar.Text := strCodCar;
    frmfatDigCartoes.pCarregaCartao;
    frmfatDigCartoes.edtQtdPar.Text := intToStr(intQtdPaC);
    frmfatDigCartoes.strCondicaoPagamentoVenda := Self.strConPag;

    Repeat
      frmfatDigCartoes.ShowModal;
      Result := frmfatDigCartoes.blnConfirma;
    Until
      (Not Result) Or
      fVerificaParMinCartao(StrToIntDef(frmfatDigCartoes.edtQtdPar.Text, 0),
                            frmfatDigCartoes.qryCadCar.FieldByName('CAR_PARMIN').AsFloat);

    If Result Then
    Begin
      strCodCar := frmfatDigCartoes.edtCodCar.Text;
      intQtdPaC := strToIntDef(frmfatDigCartoes.edtQtdPar.Text, 0);
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '');
    End;
  End;

  pFreeAndNil(frmfatDigCartoes);
end;

function TFatVenda.fPedeDadosEmissaoPedidoVenda(qryFatGor: TUniQuery; blnPedeEnderecoEntrega: Boolean = True): Boolean;
var
    frmFatDigMensagem : TfrmFatDigMensagem;
begin
  Result := True;

  {*****************************************}
  {* PEDE DIGITAÇÃO DE MENSAGEM PARA PD    *}
  {**************************************MV*}
  If (fExibirTelaDadosDoPedido) Then
  {*************************************************************************************************************************}
  { (Self.fltTotGer = 0) And fTemAlgumServicoDigitadoComOuSemValor) FOI PRA COMPLEMENTAR O QUE FOI FEITO NO REQ.: 56225 }
  { POIS ESTAVA GERANDO PEDIDO DE CORTE SÓ COM VALOR DE FRETE DE SUGESTÃO, EM CLIENTES QUE NÃO SÃO AUTOCENTER               }
  {***********************************************************************************************************************VA}
  Begin

    Try
      pCriarFormularios(TfrmFatDigMensagem, frmFatDigMensagem);

      frmFatDigMensagem.fatVenda  := Self;
      frmFatDigMensagem.qryFatGor := qryFatGor;

      If blnPedeEnderecoEntrega Then
        Result := Self.blnPediuEnderecoEntrega Or fPedeEnderecoEntrega;

      If Result And (Not fEmptyStr(strNumOrc)) Then
        Self.strCodTra := Self.fVerificaTranspDoctoDifEndEntrega;

      If Result Then
      Begin

        frmFatDigMensagem.fraTransportadora.strCodTra := Self.strCodTra;

        {Não exibe a tela}
        If Self.fEhVendaRapida(Self.strCodCli) and (not fCfgSis('VRAMSG', varBoolean)) Then
        Begin

          frmFatDigMensagem.FormShow(frmFatDigMensagem);
          frmFatDigMensagem.btnConfirmaDados.Click;


          If Not frmFatDigMensagem.blnConfirma Then
          begin
            frmFatDigMensagem.blnJaChamouOnShow := True;
            frmFatDigMensagem.showModal;
          End;
        End
        Else
          frmFatDigMensagem.showModal;

        Result := frmFatDigMensagem.blnConfirma;

        if (Result) then
          Result := fInformarDrawbackPorItem;
      End;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[fConfirmaVenda_5]');
    End;

    pFreeAndNil(frmFatDigMensagem);
  End;
end;

procedure TFatVenda.pInsereVendasPerdidas(blnNovos: boolean=false);
Var
  strCodigo: String;
  objItem: TItemVendasPerdidas;
  blnCapa: Boolean;
begin
  If FItensVendaPerdida.Count > 0 Then
  Begin
    blnCapa := false;
    For objItem In FItensVendaPerdida Do
      if ( not blnNovos ) or ( blnNovos and ( objItem.strIteNov = 'S' ) ) then
      Begin
        if not blnCapa then
        Begin
          blnCapa   := true;
          strCodigo := fAtualizaProCod('MOVVPG', 'VPG_CODIGO');

          pIncluiMovVpg(strCodigo,
                        strCodCli,
                        strCodVen,
                        strCliCgc,
                        VS_Date,
                        strNumDoc,
                        strEspDoc,
                        strSerFsc,
                        strOrigemVendaPerdida);
        End;

        pIncluiMovVpd(strCodigo,
                      objItem.strCodIte,
                      objItem.strDesIte,
                      objItem.strCodMot,
                      objItem.fltQtdIte,
                      objItem.fltUniOri,
                      objItem.fltUnitar,
                      objItem.fltTotIte,
                      objItem.strObserv,
                      objItem.strCodCon,
                      objItem.fltVlrCon,
                      objItem.strNumCmp,
                      objItem.intNItCmp,
                      objItem.dtaDtaCmp);
      End;

    if ( not blnNovos ) then
      FItensVendaPerdida.Clear;

  End;
end;

function TFatVenda.fVerificaValorMinimoEmitirNF(blnPedeSenha: Boolean = True): Boolean;
  Var
    objFilterMat: TFilterMatrizItens;
    objFiltersItem: TFiltersItem;
    strCodCliPar : String;

  function fGetTotalItens(Itens: TMatrizFechamento): Double;
    Var
      item: TDadosFechamento;
  begin
    Result := 0;
    For item In Itens Do
      Result := Result + (item.fltTotIte - item.fltDesEsp);
  end;

  function fLiberaValorMinimo(strTipoNF: String; fltValTot, fltValMin: Double): Boolean;
  Var
    objLiberacao : TLiberacao;
  begin
    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('Valor Total dos produtos menor que o valor mínimo para faturamento em Nota Fiscal!');
      objLiberacao.objMsgLibera.pAddTexto(' *** ' + strTipoNF + ' *** ');
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor Total'  , FormatFloat('##,#0.00', fltValTot), 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor Mínimo' , FormatFloat('##,#0.00', fltValMin), 12);

      If Not blnPedeSenha Then
      Begin

        pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem);

        pMensagemOk(
          TRegistroMsgLiberaTexto(objLiberacao.objMsgLibera.lstRegistros[0]).strTexto+#13#10+#13#10+
          TRegistroMsgLiberaTexto(objLiberacao.objMsgLibera.lstRegistros[1]).strTexto+#13#10+
          TRegistroMsgLiberaTextoCaption(objLiberacao.objMsgLibera.lstRegistros[2]).strCaption+'.:   '+
          TRegistroMsgLiberaTexto(objLiberacao.objMsgLibera.lstRegistros[2]).strTexto+#13#10+
          TRegistroMsgLiberaTextoCaption(objLiberacao.objMsgLibera.lstRegistros[3]).strCaption+': '+
          TRegistroMsgLiberaTexto(objLiberacao.objMsgLibera.lstRegistros[3]).strTexto,540);

        Result := True;
      End
      Else
      Begin
        Result := False;

        If Not fEmptyStr(fCfgSis('SENMNF')) Then
        Begin
          objLiberacao.strDirAce := 'SENMNF';
          objLiberacao.strSenLib := fCfgSis('SENMNF');
          objLiberacao.strMsgSen := 'Senha liberação Valor Mínimo NF - ' + strTipoNF;
          objLiberacao.strCodOpe := strLoginUsuarioLogado;
          objLiberacao.strCliente := strCodCli + '-' + strCliNom;
          Result := fFatMensagemLiberacao(objLiberacao);
        End;

      End;
    finally
      FreeAndNil(objLiberacao);
    end;
  End;

begin
  Result := True;

  If (Pos(strOpcDoc, 'DV_PR_DD_') > 0) Then
    Exit;

  {*********************************************************************}
  {* SE UTILIZAR LIBERAÇÃO DE PEDIDO E NÃO PERMITIR EXPEDIÇÃO PARCIAL, *}
  {* NÃO DEVE TRAVAR VALOR MÍNIMO NF, POIS ESTA VERIFICAÇÃO TERÁ SIDO  *}
  {* FEITA NA LIBERAÇÃO DO PEDIDO                                      *}
  {******************************************************************MM*}
  If Self.blnExpedi And fCfgSis('LIBPED',varBoolean) And (Not fCfgExpedicaoParcialHabilitada) Then
    Exit;

  If Self.blnExpedi And (Self.strTipPed <> 'A') Then
    Exit;

  strCodCliPar := '';

  If (Not fDocumentoParaFornecedor) Then
    strCodCliPar := Self.strCodCli;

  objFilterMat := TFilterMatrizItens.Create(arrMatItens);
  objFiltersItem := TFiltersItem.Create;

  With objFilterMat, objFiltersItem Do
  Begin
    pDesfazerFiltros;
    fFiltrar(fFiltraEntregaFutura);

    If (Result) And
       (fGetTotalItens(MatrizItens) <> 0.00) And
       (fGetTotalItens(MatrizItens) <  fValorMinimoNotaFiscalEntrega(strCodCliPar) ) Then
    Begin
      Result := fLiberaValorMinimo('Entrega Futura', fGetTotalItens(MatrizItens), fValorMinimoNotaFiscalEntrega(strCodCliPar));
    End;

    pDesfazerFiltros;
    fFiltrar(fFiltraEntregaImediata);

    If (Result) And
       (fGetTotalItens(MatrizItens) <> 0.00) And
       (fGetTotalItens(MatrizItens) <  fValorMinimoNotaFiscalEntrega(strCodCliPar)) Then
    Begin
      Result := fLiberaValorMinimo('Entrega Imediata', fGetTotalItens(MatrizItens), fValorMinimoNotaFiscalEntrega(strCodCliPar));
    End;

    pDesfazerFiltros;
    fFiltrar(fFiltraRetira);

    If (Result) And
       (fGetTotalItens(MatrizItens) <> 0.00) And
       (fGetTotalItens(MatrizItens) <  fValorMinimoNotaFiscalRetira(strCodCliPar)) Then
    Begin
      Result := fLiberaValorMinimo('Retira', fGetTotalItens(MatrizItens), fValorMinimoNotaFiscalRetira(strCodCliPar));
    End;

  End;

  objFilterMat.Destroy;
  objFiltersItem.Destroy;
End;

function TFatVenda.fVerificaPrazoMedio(strConPag: String; strEspPra: String = ''): Boolean;
  Var
    objLiberacao : TLiberacao;
    fltPrzMed  : Double;

    function fRetPrzMed: Double;
    begin
      Result := fCampoTabela('CND_PRZMED', 'CADCND',
                            ['CND_CODIGO'],
                            [strCodCnd], False);
    end;

begin

  Result := True;

  If fEmptyStr(strEspPra) Then
  Begin
    If (strOpcDoc = 'OR') And (strEspDoc = 'PD') Then
      strEspPra := 'PD'
    Else
      strEspPra := strOpcDoc;
  End;

  If fDocumentoParaFornecedor Then
    Exit;

  If SameText(strEspPra,'PD') And (Not fCfgSis('PRAMPD', varBoolean)) Then
    Exit;

  If SameText(strEspPra,'OR') And (Not fCfgSis('PRAMOR', varBoolean)) Then
    Exit;

  If SameText(strEspPra,'VN') And (Not fCfgSis('PRAMVN', varBoolean)) Then
    Exit;

  If SameText(strEspPra,'CS') And (Not fCfgSis('PRAMVN', varBoolean)) Then
    Exit;

  If (strOpcDoc = 'OR') And (strEspPra = 'PD') And (fLogLibExists('LBPRME', arrLogLib) Or fLogAviExists('LBPRME')) Then
    Exit;

  fltPrzMed := fCfgSis('PRAMED', varDouble);

  If (fCfgSis('USACND', varBoolean) And (fRetPrzMed > 0)) Then
    fltPrzMed := fRetPrzMed;

  pRemoverTravaLogAvi('LBPRME', strNTrava);

  If (fCalcMediaPagto(strConPag) > fltPrzMed) And (strConPag <> '01999') Then
  Begin
    objLiberacao := TLiberacao.Create;
    try

      If (fCfgSis('CNDVEN', varString) <> 'I') Then
        pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);

      fMensagem('', 'O prazo médio da condição de pagamento ultrapassou o ' +
                    'prazo permitido: ' + FloatToStrF(fltPrzMed, ffFixed, 12, 2 ), ['&O k']);
      If fEmptyStr(fCfgSis('SENLPM')) Then
      Begin
        Result := False;
      End
      Else
      Begin
        objLiberacao.objMsgLibera.pAddTexto('Senha para liberação do Prazo Médio');

        If (fCfgSis('CNDVEN', varString) <> 'I') Then
          objLiberacao.objMsgLibera.pAddTextoCaption('Valor Documento', FormatFloat('#,##0.00', fltTotGer), 15);

        objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto'    , fFormataCondPag(strConPag)        , 15);

        If Not fEmptyStr(strCodFpg) Then
          objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pagto'  , strCodFpg + '-' + fRetDescFpg(strCodFpg) , 15);

        objLiberacao.strDirAce := 'LBPRME';
        objLiberacao.strSenLib := fCfgSis('SENLPM');
        objLiberacao.strMsgSen := 'Prazo Médio';
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom;
        objLiberacao.strCpfCnpj := strCliCgc;

        If (Not fFatMensagemLiberacao(objLiberacao))Then
          Result := False
        Else
        Begin
          Result := True;
          blnVerPrzMed := True;
          If Not fSomenteAvisaPoisVaiTravarNoFinalVenda('LBPRME') Then
            blnVerPrzMed := True;
        End;
      End;
    finally
      FreeAndNil(objLiberacao);
    end;
  End;

end;

function TFatVenda.fCalculaPrazoMedioVenda: Integer;

  Const
    CHEQUE_PRE     = '002';
    CARTAO         = '007';
    PARCELADO      = '009';

  Var
    arrDias: Array Of Double;

  function fAssignedAndNotEmptyDataSet(dataset: TDataSet): Boolean;
  begin
    Result := Assigned(dataset) And dataset.Active And Not dataset.IsEmpty;
  end;

  procedure pAddDias(dias: integer);
    var
      i: Double;
  begin
    For i In arrDias Do
      If i = dias Then
        Exit;

    SetLength(arrDias, Length(arrDias) + 1);
    arrDias[Length(arrDias) -1] := dias;
  end;

  procedure pAddDiasCondicao(strCondicao: String; blnAVista: Boolean = True);
    Var
      intCont, intQtd, intDia: Integer;
  Begin
    intQtd := StrToIntDef(LeftStr(strCondicao, 02), 0);

    For intCont := 1 To intQtd Do
    Begin
      intDia := StrToIntDef(Copy(strCondicao, 3 * intCont, 03), 0);

      If blnAVista Or (intDia > 0) Then
        pAddDias(intDia);
    End;
  end;

  procedure pAddDiasCartoes(cartoes: TCartoesResumoCaixaArray);
    Var
      cartao: TCartoesResumoCaixa;
  begin
    For cartao In cartoes Do
    Begin
      pAddDiasCondicao(cartao.strCndPag);
    End;
  end;

  procedure pAddDiasCheque(dsCheques: TDataSet);
  begin
    With dsCheques Do
    Begin
      First;
      While Not Eof Do
      Begin
        pAddDias(DaysBetween(Self.VS_Date,
                             FieldByName('CHQ_DTAVEN').AsDateTime));
        Next;
      End;
    End;
  end;

begin
  SetLength(arrDias, 0);

  //Caso nao utilize cadastro de formas de pagamento
  If Not fCfgSis('USAFPG', VarBoolean) Then
  Begin
    pAddDiasCondicao(strConPag);
  End

  //Caso utilizado forma de pagamento cartao
  Else If (strCodFpg = CARTAO) Then
  Begin
    If (Length(arrCartoes) > 0) And (fltValCar > 0) Then
      pAddDiasCartoes(arrCartoes)
    Else
      pAddDiasCondicao(strConPag);
  End

  //Caso utilizado forma de pagamento Cheque Pre
  Else If (strCodFpg = CHEQUE_PRE) Then
  Begin
    If fAssignedAndNotEmptyDataSet(cdsChequePre) And (fltValCqP > 0) Then
      pAddDiasCheque(cdsChequePre)
    Else
      pAddDiasCondicao(strConPag);
  End

  //Caso utilizado forma de pagamento Parcelado (Pode ter cheque, cartao, dinheiro, faturado ...)
  Else If (strCodFpg = PARCELADO) Then
  Begin
    //Adiciona os vencimentos dos cartoes
    If (Length(arrCartoes) > 0) And (fltValCar > 0) Then
      pAddDiasCartoes(arrCartoes);

    //Adiciona os vencimentos dos Cheques Pre
    If fAssignedAndNotEmptyDataSet(cdsChequePre) And (fltValCqP > 0) Then
      pAddDiasCheque(cdsChequePre);

    //Adiciona os vencimentos venda a Prazo (Faturado, Vale)
    If (fltFatura + fltValVle) > 0 Then
      pAddDiasCondicao(strConPag, False);

    //Adiciona a vista para calculo do prazo medio
    If (fltValDin + fltValOrd + fltValCre + fltValFin + fltValCqV) > 0 Then
      pAddDiasCondicao('01000');
  End

  //Outras Formas de Pagamento
  Else
    pAddDiasCondicao(strConPag);

  //Calculo do Prazo Medio
  If Length(arrDias) = 0 Then
    Result := fFloatToInt(fCalcMediaPagto(strConPag))
  Else
    Result := fFloatToInt(Sum(arrDias) / Length(arrDias));
end;

procedure TFatVenda.pRemoveItemFreteDoCupomFiscal;
  Var
    Item: TDadosFechamento;
    arrMatNov: TMatrizFechamento;

  procedure pAddItem(Var arrItens: TMatrizFechamento);
  begin
    SetLength(arrItens, Length(arrItens) + 1);
    arrItens[Length(arrItens) -1] := item;
  end;

begin
  SetLength(arrMatNov, 0);

  For Item In arrMatItens Do
    If item.strCodIte <> fCfgSis('ITEFRE') Then
      pAddItem(arrMatNov);

  SetLength(arrMatItens, 0);

  For Item In arrMatNov Do
    pAddItem(arrMatItens);
end;

procedure TFatVenda.pInsereItemFreteNoCupomFiscal;
  Var
    qryItemFrete: TUniQuery;
    itemFrete: TDadosFechamento;
    strTipAbf: String;
    ValorAliquotaIBPT : TValorAliquotaIBPT;
begin
  If Self.strEspDoc <> 'IF' Then
    Exit;

  If Self.fltValFre <= 0 Then
    Exit;

  If Not fCfgSis('FRECUP', VarBoolean) Then
    Exit;

  strTipAbf := Self.GetTipAbf('', OpcItensNFespTinta);

  qryItemFrete := fCriaQuery;

  With qryItemFrete, SQL Do
  Begin
    Close;
    Clear;

    Add(' SELECT SQL_NO_CACHE ');
    Add('   A.*, ');
    Add('   C.ITE_CODGRU, ');
    Add('   C.ITE_CODITE, ');
    Add('   C.ITE_DESITE, ');
    Add('   C.ITE_REFERE, ');
    Add('   C.ITE_CODMAR, ');
    Add('   C.ITE_CODUNI, ');
    Add('   U.UNI_SIGUNI, ');
    Add('   C.ITE_CODFOR, ');
    Add('   C.ITE_CLAIPI, ');
    Add('   C.ITE_EXCIPI, ');
    Add('   C.ITE_MENFIS  ');
    Add(' FROM ');
    Add('   CADITE C ');
    Add('   INNER JOIN ITEGER I ON I.ITE_CODITE = C.ITE_CODITE AND I.ITE_CODEMP = :CODEMP ');
    Add('   INNER JOIN CADUNI U ON U.UNI_CODUNI = C.ITE_CODUNI');

    If fCfgSis('TIPABF') = '1' Then
      Add('   INNER JOIN ABFICM A ON A.ABF_CODABF = C.ITE_CODABF AND A.ABF_ESTADO = :ESTADO ')
    Else
      Add('   INNER JOIN ABFICM A ON A.ABF_CODABF = I.ITE_CODABF AND A.ABF_ESTADO = :ESTADO ');

    Add(' WHERE ');
    Add('   C.ITE_CODITE = :CODITE ');

    ParamByName('CODITE').AsString := fCfgSis('ITEFRE');
    ParamByName('CODEMP').AsString := fGetEmpCalculoItem('');

    If fDentroDoEstado('') Then
      ParamByName('ESTADO').AsString := fGetUFEmpresa('')
    Else
      ParamByName('ESTADO').AsString := strCliEst;

    Open;

    If Not IsEmpty Then
    Begin
      pRemoveItemFreteDoCupomFiscal;

      itemFrete.intAutInc := -1;

      itemFrete.strCodIte := FieldByName('ITE_CODITE').AsString;
      itemFrete.strCodGru := FieldByName('ITE_CODGRU').AsString;
      itemFrete.strCodMar := FieldByName('ITE_CODMAR').AsString;
      itemFrete.strDesIte := FieldByName('ITE_DESITE').AsString;
      itemFrete.strDesOri := FieldByName('ITE_DESITE').AsString;
