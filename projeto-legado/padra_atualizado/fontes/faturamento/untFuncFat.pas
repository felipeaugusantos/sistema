function TFatVenda.fValidaCestItens(AListaItens : String) : string;
var
  qryCest : TUniQuery;
  LstrAuxiliar : string;
begin
  Result := '';

  if fEmptyStr(AListaItens) then
    exit;

  qryCest := fCriaQuery(nil);
  try
    qryCest.Close;
    qryCest.SQL.Clear;
    qryCest.SQL.Add(' SELECT ITE_CODITE, ITE_CDCEST '+
                    '   FROM CADITE '+
                    '  WHERE ITE_CODITE IN( ' + AListaItens + ' ) ');
    qryCest.Open;
    qryCest.First;

    LstrAuxiliar := '';
    while not qryCest.Eof do
    begin
      if (Length(Trim(qryCest.FieldByName('ITE_CDCEST').AsString)) <> 7) then
      begin
        if fEmptyStr(LstrAuxiliar) then
          LstrAuxiliar := qryCest.FieldByName('ITE_CODITE').AsString
        else
          LstrAuxiliar := LstrAuxiliar + ',' + qryCest.FieldByName('ITE_CODITE').AsString;
      end;
      qryCest.Next;
    end;
  finally
    FreeAndNil(qryCest);
  end;

  if Trim(LstrAuxiliar) <> '' then
    Result := 'Se continuar a nota fiscal eletrônica será rejeitada pela Receita. '+
              'Será necessário corrigir o(s) cest(s) dos seguintes itens ('+LstrAuxiliar+') e reenviar a nota novamente pelo PainelNFe. '+
              'Deseja continuar?';
end;

function TFatVenda.fValidaCoerenciaEntreOItemOriginalEOItemDevolvido(blnValidaPelaMatriz:Boolean=True;strCodIteDev:String='';strTabDev:String='';strAutIncOri:String='';blnMostraMsg:Boolean=True): Boolean;
  Var
    strMsg,
    strCodItemNoDocFat,
    strCodItemNoDocDev: String;
    intIdx: Integer;
begin
  If (Pos(strOpcDoc,'DV_') <= 0) Then
    Exit(True);
  strMsg:='';
  Try
    If blnValidaPelaMatriz Then
    Begin
      For intIdx := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
      Begin
        If (Pos(Self.arrMatItens[intIdx].strTabDev, 'MOVDET_NOTDET_') > 0) Then
        Begin
          strCodItemNoDocFat := fCampoTabela('DET_CODITE', Self.arrMatItens[intIdx].strTabDev, ['AUTOINCREM'], [Self.arrMatItens[intIdx].strAiDvOr]);
          strCodItemNoDocDev := Self.arrMatItens[intIdx].strCodIte;

          If (Not fEmptyStr(strCodItemNoDocFat)) And (Not fEmptyStr(strCodItemNoDocDev)) And (strCodItemNoDocFat<>strCodItemNoDocDev) Then
            pIncrementaListaStr(strCodItemNoDocDev + '->' + strCodItemNoDocFat, strMsg, True);
        End;
      End;
    End
    Else
    Begin
      If (Not fEmptyStr(strCodIteDev)) And (Not fEmptyStr(strTabDev)) And (Not fEmptyStr(strAutIncOri)) Then
      Begin
        If (Pos(strTabDev, 'MOVDET_NOTDET_') > 0) Then
        Begin
          strCodItemNoDocFat := fCampoTabela('DET_CODITE', strTabDev, ['AUTOINCREM'], [strAutIncOri]);
          strCodItemNoDocDev := strCodIteDev;

          If (Not fEmptyStr(strCodItemNoDocFat)) And (Not fEmptyStr(strCodItemNoDocDev)) And (strCodItemNoDocFat<>strCodItemNoDocDev) Then
            pIncrementaListaStr(strCodItemNoDocDev + '->' + strCodItemNoDocFat, strMsg, True);
        End;
      End;
    End;
  Finally
    Result := fEmptyStr(strMsg);
    If (Not Result) And (blnMostraMsg) Then
    Begin
      If blnValidaPelaMatriz Then
        fMensagem('Atenção','Os itens devolvidos a seguir estão com referência incorreta ao documento original: '+strMsg+'. '+
                            'Exclua-os e repita o processo de devolução dos mesmos. Se persistir, feche esse modo e repita toda operação!',['&OK'])
      Else
        fMensagem('Atenção','O item devolvido a seguir está com referência incorreta ao documento original: '+strMsg+'. '+
                            'Repita o processo de devolução do mesmo, usando os procedimentos de inclusão para essa operação!',['&OK'])
    End;
  End;
end;

