function TGeraArquivoAnexoEmailAutomatico.fGeraAnexoDanfeNfe_Nfce_Nfse: TArray<TRecArquivosGatilhos>;
var
  strDanfeBase64: String;
begin
  if fGetEnviaArquivoPdf then
  begin
    SetLength(Result, 1);

    strDanfeBase64 := fRetDanfeBase64(FAcesso);
    if FTipoArquivoAnexo = arqBase64 then
      Result[0] := TRecArquivosGatilhos.Create('DANFE_'+FNumDoc+'-'+FEspDoc, strDanfeBase64, EmptyStr);

    if (not fEmptyStr(strDanfeBase64)) and
       (FTipoArquivoAnexo <> arqBase64) then
      Result[0] := TRecArquivosGatilhos.Create('DANFE_'+FNumDoc+'-'+FEspDoc, fGerarPDFDanfe(FAcesso, FCodEmp, FGerandoParaDisparoDeGatilho), EmptyStr);

    if fEmptyStr(Result[0].Arquivo) then
      Result[0] := TRecArquivosGatilhos.Create('DANFE_'+FNumDoc+'-'+FEspDoc, fGerarPDFDanfe(FAcesso,
                                                                                            FCodEmp,
                                                                                            FEspDoc,
                                                                                            FNumDoc,
                                                                                            FCodCli,
                                                                                            FSerie_,
                                                                                            FGerandoParaDisparoDeGatilho),
                                                                             EmptyStr);
  end;

  if fGetEnviaArquivoXml then
  begin
    SetLength(Result, Length(Result)+1);
    Result[High(Result)] := TRecArquivosGatilhos.Create('XML_'+FNumDoc+'-'+FEspDoc,
                                                        fMontaArquivosXML(FNumDoc,
                                                                          FEspDoc,
                                                                          FCodEmp,
                                                                          FCodCli,
                                                                          FSerie_,
                                                                          'C',
                                                                          '',
                                                                          nil,
                                                                          (FTipoArquivoAnexo = arqBase64)),
                                                        EmptyStr,
                                                        tpaXml);
  end;
end;

