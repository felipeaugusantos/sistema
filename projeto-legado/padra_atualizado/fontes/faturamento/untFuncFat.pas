function fExistemProblemasNaEstruturaPedidoALPEExpedicao(const ADocumentos: TDocumentos): Boolean;
  Var
    objPedidoAlpe : TAlpe;
    intCnt : Integer;
begin
  Result := False;

  If (Length(ADocumentos) = 0) Then
    Exit;

  For intCnt := Low(ADocumentos) To High(ADocumentos) Do
  Begin
    objPedidoAlpe := TAlpe.Create;
    try
      objPedidoAlpe.pCarregaPedidoAlpe(ADocumentos[intCnt].strNumDoc,
                                       ADocumentos[intCnt].strEspDoc,
                                       ADocumentos[intCnt].strCodEmp);
