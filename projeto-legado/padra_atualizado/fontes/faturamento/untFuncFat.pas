          pAtualizaTotalUnitario;
          Exit;
        End;

        If fPermiteAplicarJurosNaPromocao(strPromocIte) Then
        Begin
          If fAplicarTaxaJurosPrecoDigitado And fAplicaTaxaJuros Then
          Begin
            Self.fltTaxJur := Self.fGetTaxVprItem(strCodIte, strEmpresaItem);
            fltUniLiqTmp   := fltUniLiqTmp + (fltUniLiqTmp * Self.fltTaxJur / 100.0);
            fltUniLiqTmp   := fFormataFloat(fltUniLiqTmp, VS_intDecUni);
          End;
        End;

        fltUniLiqTmp := fltUniLiqTmp - fRetornaVrDesconto(2, fltUniLiqTmp, fltDesCon);
        fltUniLiqTmp := fFormataFloat(fltUniLiqTmp, fMaxDecUni);

        If (strIdeProIte = 'NOR') Or (fTravaUnitarioDeTintaComoProdutoNormal And (Not fAnalisaTodosCompomentesAoTravarUnitarioDeTintaComoProdutoNormal)) Then
