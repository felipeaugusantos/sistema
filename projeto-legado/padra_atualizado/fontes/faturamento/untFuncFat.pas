function TFatVenda.fQtdJaDevolvidaLotesEstoqueExterno(strDocDev, strEspDev, strEmpDev, strCodIte, strNumLot: String): Double;
var
  LQryTL: TUniQuery;
begin
  LQryTL := fCriaQuery;
  Try
    LQryTL.SQL.Add('SELECT');
    LQryTL.SQL.Add('  SUM(TL.DET_QTDITE) AS QTDITE');
    LQryTL.SQL.Add('FROM');
    LQryTL.SQL.Add('  MOVDET DV');
    LQryTL.SQL.Add('  INNER JOIN MOVDET TL');
    LQryTL.SQL.Add('    ON TL.DET_NUMFAT = DV.DET_NUMDOC');
    LQryTL.SQL.Add('    AND TL.DET_TIPFAT = DV.DET_ESPDOC');
    LQryTL.SQL.Add('    AND TL.DET_EMPFAT = DV.DET_CODEMP');
    LQryTL.SQL.Add('    AND TL.DET_CODITE = DV.DET_CODITE');
    LQryTL.SQL.Add('    AND TL.DET_ESPDOC = "TL"');
    LQryTL.SQL.Add('    AND TL.DET_CLAFIS < "5000"');
    LQryTL.SQL.Add('    AND TL.DET_NUMLOT = :NUMLOT');
    LQryTL.SQL.Add('WHERE TRUE');
    LQryTL.SQL.Add('  AND DV.DET_DOCDEV = :DOCDEV');
    LQryTL.SQL.Add('  AND DV.DET_ESPDEV = :ESPDEV');
    LQryTL.SQL.Add('  AND DV.DET_EMPDEV = :EMPDEV');
    LQryTL.SQL.Add('  AND DV.DET_CODITE = :CODITE');
    LQryTL.SQL.Add('GROUP BY TL.DET_NUMLOT');

    LQryTL.ParamByName('DOCDEV').AsString := strDocDev;
    LQryTL.ParamByName('ESPDEV').AsString := strEspDev;
    LQryTL.ParamByName('EMPDEV').AsString := strEmpDev;
    LQryTL.ParamByName('CODITE').AsString := strCodIte;
    LQryTL.ParamByName('NUMLOT').AsString := strNumLot;

    LQryTL.Open;

    Result := LQryTL.FieldByName('QTDITE').AsFloat;
  Finally
    FreeAndNil(LQryTL);
  End;
end;

function TFatVenda.fDevolverLotesEstoqueExterno(pgbProgresso: TCxProgressBar = nil): Boolean;
var
  LItem: TDadosFechamento;
  LQryLotes: TUniQuery;
  LQuantidadeDevolverItem: Double;
  LQuantidadePendenteLote: Double;
  LQuantidadeDevolverLote: Double;
begin
  Result := True;
  For LItem In arrMatItens Do
  Begin
    LQryLotes := fCriaQuery;
    Try
      LQryLotes.SQL.Add('');
      LQryLotes.SQL.Add('SELECT');
      LQryLotes.SQL.Add('  DET_NUMLOT AS NUMLOT,');
      LQryLotes.SQL.Add('  SUM(DET_QTDITE) AS QTDITE');
      LQryLotes.SQL.Add('FROM');
      LQryLotes.SQL.Add('  MOVDET');
      LQryLotes.SQL.Add('WHERE TRUE');
      LQryLotes.SQL.Add('  AND DET_ESPDOC = "TL"');
      LQryLotes.SQL.Add('  AND DET_CLAFIS > "5000"');
      LQryLotes.SQL.Add('  AND DET_NUMFAT = :DOCDEV');
      LQryLotes.SQL.Add('  AND DET_TIPFAT = :ESPDEV');
      LQryLotes.SQL.Add('  AND DET_EMPFAT = :EMPDEV');
      LQryLotes.SQL.Add('  AND DET_CODITE = :CODITE');
      LQryLotes.SQL.Add('GROUP BY DET_NUMLOT');

      LQryLotes.ParamByName('DOCDEV').AsString := LItem.strDocDev;
      LQryLotes.ParamByName('ESPDEV').AsString := LItem.strEspDev;
      LQryLotes.ParamByName('EMPDEV').AsString := LItem.strEmpDev;
      LQryLotes.ParamByName('CODITE').AsString := LItem.strCodIte;

      LQryLotes.Open;

      LQuantidadeDevolverItem := LItem.fltQtdIte;

      LQryLotes.First;
      While Not LQryLotes.Eof Do
      Begin
        LQuantidadePendenteLote := LQryLotes.FieldByName('QTDITE').AsFloat -
          fQtdJaDevolvidaLotesEstoqueExterno(LItem.strDocDev, LItem.strEspDev, LItem.strEmpDev,
            LItem.strCodIte, LQryLotes.FieldByName('NUMLOT').AsString);

        If LQuantidadePendenteLote >= LQuantidadeDevolverItem Then
          LQuantidadeDevolverLote := LQuantidadeDevolverItem
        Else
          LQuantidadeDevolverLote := LQuantidadePendenteLote;

        If fFormataFloat(LQuantidadeDevolverLote, 4) > 0 Then
        Begin
          Result := Result And TGerarTL.Execute(LItem.strCodIte,
                                                GetLoteEstoqueExterno(LItem.strCodIte),
                                                LQryLotes.FieldByName('NUMLOT').AsString,
                                                LQuantidadeDevolverLote,
                                                strNumDoc,
                                                strEspDoc,
                                                strEmpDoc,
                                                strCodCli);

          LQuantidadeDevolverItem := LQuantidadeDevolverItem - LQuantidadeDevolverLote;
        End;

        If fFormataFloat(LQuantidadeDevolverItem, 4) = 0 Then
          Break;

        LQryLotes.Next;
      End;
    Finally
      FreeAndNil(LQryLotes);
    End;
  End;
end;

function TFatVenda.fBaixarLotesWMS(pgbProgresso: TCxProgressBar = nil): Boolean;
  Var
    item: TDadosFechamento;
    fltQtdSep: Double;
    fltQtdExp: Double;
    intDecQtd: Integer;
    objBaixaLotesWMS: TBaixaLotesWMS;
    strSeqDet: String;
    strAutGrv: String;
    dicSeqDet: TDictionary<String, Double>;
    dicAutGrv: TDictionary<String, String>;

    stlLotUti: TStringList;

    function fProdRastreavelBaiEntFut: Boolean;
    begin
      Result := blnBaiEntFut and fProdutoRastreavel(item.strCodIte);
    end;
begin
  Result := True;
  intDecQtd := fCfgSis('DECQTD', varInteger);

  objBaixaLotesWMS := TBaixaLotesWMS.Create(Self);

  pCarregarDadosFulfillment;
  objBaixaLotesWMS.Fulfillment.CopyFrom(Self.Fulfillment);

  objBaixaLotesWMS.strDocFat := strNumDoc;
  objBaixaLotesWMS.strEspFat := strEspDoc;
  objBaixaLotesWMS.strEmpFat := strEmpDoc;
  objBaixaLotesWMS.strCliFat := strCodCli;
  objBaixaLotesWMS.cdsExpIte := cdsExpIte;
  objBaixaLotesWMS.blnValidaLoteDefPD := (not Self.GetEnviandoMercadoriaParaLoteEstoqueExterno);

  dicSeqDet := TDictionary<String, Double>.Create;
  dicAutGrv := TDictionary<String, String>.Create;
  Try
    For item In arrMatItens Do
    Begin
      If (item.strNumLot = 'A DEFINIR') or
         fProdRastreavelBaiEntFut or
         fLoteDefinidoEmissaoPDUtilizandoLocTransitoriaVagao(item.strCodIte) Then
      Begin
        If dicSeqDet.ContainsKey(item.strSeqDet) Then
        Begin
          dicSeqDet[item.strSeqDet] := dicSeqDet[item.strSeqDet] + item.fltQtdIte
        End
        Else
        Begin
          dicSeqDet.Add(item.strSeqDet, item.fltQtdIte);
          dicAutGrv.Add(item.strSeqDet, item.strAutoincrementoGravacao);
        End;
      End;
    End;

    For strSeqDet In dicSeqDet.Keys Do
    Begin
      strAutGrv := '';
      dicAutGrv.TryGetValue(strSeqDet, strAutGrv);
      fltQtdSep := objBaixaLotesWMS.fCarregaLotesDigitados(strSeqDet, strAutGrv);
          //Verificacao por seguranca para caso ocorra alguma falha no processo
          //ainda assim nao permita baixar com quantidades diferentes entre o
          //separado e a quantidade sendo baixada no faturamento (Expedicao)
      If (fltQtdSep > 0) Then
      Begin
        fltQtdSep := fFormataFloat(fltQtdSep, intDecQtd);
        fltQtdExp := fFormataFloat(dicSeqDet[strSeqDet], intDecQtd);

        If (fltQtdSep <> fltQtdExp) And (Not Self.GetEnviandoMercadoriaParaLoteEstoqueExterno) Then
        Begin
          Raise ExceptionAutCom.Create('A quantidade sendo baixada é diferente da quantidade ' +
            'digitada na separação, não é possível definir os lotes (localização) de onde ' +
            'serão baixados os estoques! ' + #13 +
            'LOTDOR>SEQFDO.: ' + strSeqDet + ' QTD.: ' + FloatToStr(fltQtdSep) + #13 +
            'FATDOR>AUTINC.: ' + strSeqDet + ' QTD.: ' + FloatToStr(fltQtdExp));
        End;
      End;
    End;

    If objBaixaLotesWMS.blnTemLotes Then
    Begin
      {Envio de mercadorias para B2W, MGL, VRJ}
      If Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Then
        Result := objBaixaLotesWMS.fTransferirParaEstoqueExterno(pgbProgresso)
      Else
        Result := objBaixaLotesWMS.fBaixarEstoqueLotes(pgbProgresso);

      If (Not Result) And (Not fEmptyStr(objBaixaLotesWMS.strAuditoriaGravacaoFaturamentoMSGErro)) Then
      begin
        if Self.Fulfillment.EhOperacaoFulfillment then
          raise Exception.Create(objBaixaLotesWMS.strAuditoriaGravacaoFaturamentoMSGErro)
        else
          raise ExceptionAuditoria.Create(objBaixaLotesWMS.strCodErroAuditoria);
      end;

    End;

    If Result And fCfgSis('WMSLOT', varBoolean) Then
    Begin
      objBaixaLotesWMS.pLimparLotes;

      stlLotUti := TStringList.Create;

      Try
        For item In arrMatItens Do
        Begin
          If (stlLotUti.IndexOf(item.strSeqDet) <> -1) Then
            Continue;

          If (item.strNumLot <> 'A DEFINIR') Then
          Begin
            stlLotUti.Add(item.strSeqDet);
            objBaixaLotesWMS.fCarregaLotesDigitados(item.strSeqDet);
          End;
        End;
      Finally
        FreeAndNil(stlLotUti);
      End;

      If objBaixaLotesWMS.blnTemLotes Then
        Result := objBaixaLotesWMS.fApagaDigitacaoLotes_RemoverLocalizacaoFisicaLotes(pgbProgresso);
    End;

  Finally
    FreeAndNil(objBaixaLotesWMS);
    FreeAndNil(dicSeqDet);
    FreeAndNil(dicAutGrv);
  End;
end;

function TFatVenda.fBloquearVendaLimiteDiasCanhoto(strCodigo: String;
  var stlDocs : TStringList): Boolean;
var
  limite : Integer;
  dataLimite,
  dataCanhotoPendente: TDateTime;
begin
  limite := fCfgSis('LIMCNH', varInteger);
  Result := False;

  If (limite > 0) Then
  Begin

    dataLimite          := (Self.VS_Date - limite);
    dataCanhotoPendente := fDataUltimoCanhotoPendente(IIF(Self.fDocumentoParaFornecedor, 'F', 'C'), strCodigo, stlDocs);

    Result := (Not (dataCanhotoPendente = 0)) And
              (Not (dataCanhotoPendente >= dataLimite));
  End;
end;

class function TFatVenda.fValidaLoteEmbalagemColorantesWMS(strCodIte, strIdePro, strCodEmb, strEmpLot: String;
  matrizSaldosColorantes: TClassMatrizSaldosColorantes; objCadLot: TCadLot; Var stlBasesColorantes: TStringList): Boolean;
  Var
    intContador: Integer;
begin
  Result := True;

  If Not fUsaRotinaWMS(strEmpLot) Then
    Exit;

  For intContador := 0 To matrizSaldosColorantes.Count - 1 Do
  Begin
    If (Not objCadLot.fExisteLotePrincipalTintaMaquina(matrizSaldosColorantes[intContador].strCodIte, strEmpLot)) Then
    Begin
      stlBasesColorantes.Add(matrizSaldosColorantes[intContador].strCodIte);
      Result := False;
    End;
  End;

  If fEmptyStr(strCodEmb) And Assigned(fTipoTinta) And (fTipoTinta(strIdePro) In [ttImobiliaria, ttIndustrial]) Then
  Begin
    strCodEmb := strCodIte;
  End;

  If Not fEmptyStr(strCodEmb) And
     Not objCadLot.fExisteLotePrincipalTintaMaquina(strCodEmb, strEmpLot) Then
  Begin
    stlBasesColorantes.Add(strCodEmb);
  End;

end;

