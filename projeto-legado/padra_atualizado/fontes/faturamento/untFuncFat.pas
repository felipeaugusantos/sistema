                         blnCortPD,
                         FAutIcv,
                         True,
                         FCdcOpo,
                         FCdcSta)) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        If (Not fEmptyStr(strAutIncFatGor)) And (Length(arrAnexosPedido) > 0) Then
        Begin
          If Not fInsereArrayAnexosPedidosNoBanco(strAutIncFatGor, arrAnexosPedido) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        If Assigned(objOcoCrm) Then
          FreeAndNil(objOcoCrm);

        pStepStatusGravacao;
        pInfoStatusGravacao('Aguarde... Gravando Produto(s)');

        {*****************************************}
        {* GRAVA FATDOR                          *}
        {**************************************MV*}
        If (Not fGFatDor) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        If fEmptyStr(strEspOrc) Or (strEspOrc = 'OR') Then
        Begin
          If (Not fGOrdSer) Then
          Begin
            fRollBack;
            Result := False;
            Exit;
          End;
        End;

        If (FAplicouFatorDeServico) Then
        Begin
          If (Not fGravaBackUpPedidoAoAplicarFatorServico(Self.FPedidoFatorServico)) Then
          Begin
            fRollBack;
            Result := False;
            Exit;
          End;
        End;

        If fEhAutocenter Then
        Begin
          pLiberaLockedPrismas;
          // Se não houver serviço limpa a lista de produtos para separação.
          // Req: 124735 - Se for demembramento, limpa FDOSEP caso não houver Produto e Serviço no mesmo documento!
          If (Not blnDocumentoTemServicos) Or (blnDesmembramentoDePedidos And ((Not fTemItensVenda) Or (Not fTemItemServico))) Then
            pLimpaFdoSep

          // Se houver serviço
          Else
          Begin
            // Se tem registro na fdosep, grava de acordo com cdsItens
            If Not fTemRegistroFdoSep Then
              Result := fGFdoSep(True, blnDesmembramentoDePedidos)
            // Se não tem registro na fdosep, grava FDOSEP de acordo com o log de alterações
            Else If Assigned(cdsLogItensSep) And Not cdsLogItensSep.IsEmpty Then
              Result := fGFdoSep(False, blnDesmembramentoDePedidos)
            Else
              Result := True;

            If Not Result Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;
        End;

        If (VS_strUsaTmq = 'S') Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Tinta de Máquina');

          If (Not fGArqTinOR) Then
          Begin
            fRollBack;
            Result := False;
            Exit;
          End;
        End;

        pStepStatusGravacao;

        pInfoStatusGravacao('Aguarde... Apagando Contas a Receber ' + strEspDoc);

        If (strEspDoc = 'PD') And (fltBolAdt > 0) Then
        Begin
          pDeletaCadRec(strNumDoc, strEspDoc, VS_strCodEmp, fRetClienteOriginal, (fltBolAdt > 0) Or blnBolVen {blnBcoEnvIsNull});

          If blnBolVen Or fPermiteInformarVencimentosParaBoletoDeAdiantamento(Not blnBolVen) Then
            pGravarContasReceberParaTodosVencimentosPedido
          Else If fltBolAdt > 0 Then
            pGravarContasReceberBoletoAdiantamentoPedido;
        End
        Else
          pDeletaCadRec(strNumDoc, strEspDoc, VS_strCodEmp, fRetClienteOriginal);

        {*******************************************************************}
        {* Chama a funcao fGCadRec para gravar o debito de adiantamento ou *}
  	  	{* para gerar um novo adiantamento caso seja necessario            *}
  	  	{****************************************************************JC*}
        If blnDesmembramentoDePedidosComAdiantamento Or
           blnEntregaImediataEmNovoPedido Or
           blnEmitirNovoPedidoEntregaCD   Or
           blnRetiraOutraLojaEmNovoPedido Or
           blnRetiraMesmaLojaEmNovoPedido Or
           blnRetiraExpedicaoEmNovoPedido Or
           blnAbastecTransfReqEmNovoPedido Or
          (fCfgSis('GERCRE', varBoolean) And (fltTotCadRec < 0)) Then
        Begin

          //Deve gerar um credito na alteracao de pedido com valor menor que o quitado
          If fCfgSis('GERCRE', varBoolean) And (fltTotCadRec < 0) Then
          Begin
            pInfoStatusGravacao('Aguarde... Gerando Crédito Alteração Pedido!');

            fDigDuplic(arrDuplicata, '01000', 0, fltTotCadRec, False, False, False, Self.VS_Date, False);

            strUltPar := fRetornaUltimaParcela(strNumOrc, 'PD');

            If (Not fEmptyStr(strUltPar)) Then
            Begin

              For intContUltPar := Low(arrDuplicata) To High(arrDuplicata) Do
              Begin

                If (fEmptyStr(ArrDuplicata[intContUltPar].strSequen)) Then
                  Break;

                strUltPar := Chr(Ord(strUltPar[1])+1);
                ArrDuplicata[intContUltPar].strSequen := strUltPar;

              End;

            End;

          End;

          pStepStatusGravacao;

          pInfoStatusGravacao('Aguarde... Gravando Adiantamento do Pedido');

          If (Not fGCadRec) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

        End;

        If Not fGerarCreditoValorRemovidoAposAlteracaoPedido Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        If blnBaixaAdiantamentoAutomatico And (fltCredUtilizados>0) Then
        Begin
          pStepStatusGravacao;
          pInfoStatusGravacao('Aguarde... Gravando Adiantamento Automático do Pedido');

          If (Not fGCadRec) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        if blnRealizandoAdiantamentoPedidoPeloVN then
        begin
          if (Not fGravarAdiantamentoPedidoPeloVN) then
          begin
            fCancelaTransac;
            Result := False;
            Exit;
          end;
        end;

        For intContador := 1 To 5 Do
          pStepStatusGravacao;

        For intContador := 1 To 3 Do
          pStepStatusGravacao;
      End;

      If (strOpcDoc = 'VN') And (strEspDoc <> 'PD') Then
      Begin

        If fCfgSis('PRCTPV') = '1' Then //Gravar Vendas Perdidas
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Vendas Perdidas');
          If Not fGravaVendasPerdidas Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

      End
      Else
      Begin

        If (strEspDoc = 'PD') Then
        Begin
          //Procedimento adotado quando utiliza corte no pedido de venda
          If fCfgSis('PRCTPV') = '1' Then //Gravar Vendas Perdidas
          Begin
            pInfoStatusGravacao('Aguarde... Gravando Vendas Perdidas');
            strOrigemVendaPerdida := 'PEDIDO DE VENDA';
            If Not fGravaVendasPerdidas Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End

          Else If fCfgSis('PRCTPV') = '2' Then //Gravar Novo Pedido de Venda
          Begin
            pInfoStatusGravacao('Aguarde... Gravando Pedidos de Itens Cortados');
            If Not fGravaPedidoItensCortados Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Ordem de Serviço');
          If Not fGerarOrdemDeServico Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

        End;

      End;

      {*****************************************}
      {* BR - Brinde / Uso/Consumo             *}
      {**************************************MV*}
      If Pos(strEspDoc, 'BR_UC_PA_') > 0 Then
      Begin
        {*****************************************}
        {* GRAVA TINGER E TINDET                 *}
        {**************************************MV*}
        If (VS_strUsaTmq = 'S') Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Tinta de Máquina');

          If (Not fGArqTin) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        pStepStatusGravacao;
        pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

        {*****************************************}
        {* GRAVA MOVGER                          *}
        {**************************************MV*}
        If (Not fGMovGer) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA MOVDET                          *}
        {**************************************MV*}
        If (Not fGMovDet) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        {**************************************************}
        {* SE FOR BRINDE E O CLIENTE FOR UM PROFISSIONAL, *}
        {* GRAVA UM DÉBITO PARA O PROFISSIONAL.           *}
        {***********************************************RV*}
        {************************************************************************}
        {* RONALDO SOLICITOU COMENTAR O And fClienteProfissional DIA 15/10/2014 *}
        {*********************************************************************FC*}
        If blnGraComPro And fCfgSis('DEBBRP', VarBoolean) {And fClienteProfissional(strCodCli)} Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Débito Profissional');

          If (Not fGComProBrinde) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        For intContador := 1 To 7 Do
          pStepStatusGravacao;

