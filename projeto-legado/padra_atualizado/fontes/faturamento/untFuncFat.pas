function TFatVenda.fPossuiPrecoVendaDiferenteTabela(strNumDoc, strEspDoc,
  strEmpDoc, strCodCli: String): Boolean;
Var
  qryTemp: TUniQuery;
begin
  Result := False;

  If fEmptyStr(strNumDoc) Then
    Exit;

  Try
    qryTemp := fCriaQuery(nil);

    Try
      qryTemp.Close();
      qryTemp.SQL.Clear();
      qryTemp.SQL.Add('SELECT COUNT(FATDOR.AUTOINCREM) AS QTDE ');
      qryTemp.SQL.Add('  FROM FATDOR ');
      qryTemp.SQL.Add(' INNER JOIN CADITE ON FDO_CODITE = ITE_CODITE ');
      qryTemp.SQL.Add(' INNER JOIN ITEGER ON FDO_CODITE = ITEGER.ITE_CODITE ');
      qryTemp.SQL.Add('   AND ITEGER.ITE_CODEMP = FDO_CODEMP ');
      qryTemp.SQL.Add(' WHERE FDO_NUMDOC = :NUMDOC ');
      qryTemp.SQL.Add('   AND FDO_ESPDOC = :ESPDOC ');
      qryTemp.SQL.Add('   AND FDO_CODEMP = :CODEMP ');
      qryTemp.SQL.Add('   AND FDO_CODCLI = :CODCLI ');
      qryTemp.SQL.Add('   AND FDO_DESCON > 0 ');
      qryTemp.SQL.Add('   AND FDO_UNIORI <> (CASE WHEN (FDO_TABPRE = "1") THEN ITE_PREVE1 ');
      qryTemp.SQL.Add('                           WHEN (FDO_TABPRE = "2") THEN ITE_PREVE2 ');
      qryTemp.SQL.Add('                           WHEN (FDO_TABPRE = "3") THEN ITE_PREVE3 ');
      qryTemp.SQL.Add('                           WHEN (FDO_TABPRE = "4") THEN ITE_PREVE4 ');
      qryTemp.SQL.Add('                           WHEN (FDO_TABPRE = "5") THEN ITE_PREVE5 ');
      qryTemp.SQL.Add('                           WHEN (FDO_TABPRE = "6") THEN ITE_PREVE6 ');
      qryTemp.SQL.Add('                           WHEN (FDO_TABPRE = "7") THEN ITE_PREVE7 ');
      qryTemp.SQL.Add('                           ELSE 0 END) ');
      qryTemp.ParamByName('NUMDOC').AsString := strNumDoc;
      qryTemp.ParamByName('ESPDOC').AsString := strEspDoc;
      qryTemp.ParamByName('CODEMP').AsString := strEmpDoc;
      qryTemp.ParamByName('CODCLI').AsString := strCodCli;
      qryTemp.Open();

      Result := (qryTemp.FieldByName('QTDE').AsInteger > 0);
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TFatVenda.fPrecoVendaDiferenteTabela]');
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

