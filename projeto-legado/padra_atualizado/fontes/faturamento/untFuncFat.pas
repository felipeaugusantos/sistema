         (not fItemNoRomaneio(qryGenDor.FieldByName('AUTOINCREM').AsString, strNumRom, VS_strCodEmp)) then
      begin
        qryGenDor.Next;
        Continue;
      end;

      pConcatenaInformacoesItemConcreto(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                        qryGenDor.FieldByName('FDO_DESCRI').AsString,
                                        qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                        qryGenDor.FieldByName('FDO_VLRCON').AsFloat);

      pInfoStatusGravacao('Aguarde... Carregando Produtos ' + intToStr(qryGenDor.RecNo) + '/' + intToStr(qryGenDor.RecordCount));
      pStepStatusGravacao;

      If fEmptyStr(qryGenDor.FieldByName('TABPRE').AsString) then
        strTabPreIte := strTabPre
      Else
        strTabPreIte := qryGenDor.FieldByName('TABPRE').AsString;

      If (Not blnPedRemGar) And (RightStr(qryGenDor.FieldByName('FDO_CLAFIS').AsString, 3) = fCfgSis('CLARGA')) Then
        blnPedRemGar := True;

      fltProPreCus := 0;
      fltProPreVen := 0;
      fltProComVar := 0;
      fltProComAta := 0;
      fltProComDis := 0;
      fltProDesF07 := 0;

      {*************************************************************************}
      {* Somente deve carregar os dados da promocao, caso o produto estava em  *}
      {* promocao quando o pedido foi feito. Pois ocorre de o produto nao      *}
      {* estar mais em promocao no momento em que vai faturar o mesmo (ex: F11)*}
      {* porem o desconto que nao se aplica a um produto em promocao, sera     *}
      {* aplicado alterando o preco combinado no balcao com o cliente. O mesmo *}
      {* vale para produtos que nao estavam em promocao e agora estao, nao deve*}
      {* retirar o desconto que foi concedido ao cliente.                      *}
      {**********************************************************************JC*}
      If (Self.fFilialPromocao) And (qryGenDor.FieldByName('PROMOC').AsString = 'S') Then
      Begin
        If Not (fRetornaPrecosPromocao(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                       strCodCli,
                                       dtaDtaOri,
                                       qryGenDor.FieldByName('FDO_QTDITE').AsFloat,
                                       0,
                                       0,
                                       intPraMedio,
                                       fltProPreCus,
                                       fltProPreVen,
                                       fltProComVar,
                                       fltProComAta,
                                       fltProComDis,
                                       fltQtdDis,
                                       fltProDesF07,
                                       strComPro,
                                       strCodPro,
                                       blnParticiona,
                                       blnPromo,
                                       strTabPreIte,
                                       strCodCnd,
                                       '',
                                       '',
                                       True,
                                       False,
                                       '-1',
                                       ((qryGenDor.FieldByName('ITE_ENTRET').AsString = 'E') And (qryGenDor.FieldByName('FDO_ENTFUT').AsString = 'N')),
                                       ((qryGenDor.FieldByName('ITE_ENTRET').AsString = 'E') And (qryGenDor.FieldByName('FDO_ENTFUT').AsString = 'S')),
                                       qryGenDor.FieldByName('FDO_MOTFUT').AsString,
                                       fGetEmpPrecoPromoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString, qryGenDor.FieldByName('FDO_EMPDMP').AsString),
                                       strNumOrc,
                                       strEspOrc,
                                       Nil,
                                       False,
                                       '',
                                       Nil,
                                       '',
                                       qryGenDor.FieldByName('FDO_SOMCOL').AsFloat)) Then
        Begin
          fltProPreCus := qryGenDor.FieldByName('FDO_TOTCUS').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat;
          fltProPreVen := qryGenDor.FieldByName('FDO_UNIORI').AsFloat;
          fltProComVar := qryGenDor.FieldByName('FDO_PERCOM').AsFloat;
          fltProComAta := qryGenDor.FieldByName('FDO_PERREP').AsFloat;
          fltProComDis := qryGenDor.FieldByName('FDO_PERCOM').AsFloat;
          strComPro    := 'P';
          strCodPro    := qryGenDor.FieldByName('FDO_CODPRO').AsString;
          IDKitPromocao:= qryGenDor.FieldByName('FDO_PROKIT').AsString;
          fltProDesF07 := 0;
        End;
      End;

      fltQtdIte := qryGenDor.FieldByName('ITE_QTDITE').AsFloat;
      fltQtdIteCalPes := qryGenDor.FieldByName('FDO_QTDITE').AsFloat;

      If fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean) and (not fEmptyStr(strNumRom)) Then
        fltQtdIteCalPes := fltQtdIte;

      fltQtdPec := 0;
      If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
      Begin
        fltQtdPec := fCalculaQuantidadePecas(fltQtdIte,
                                             qryGenDor.FieldByName('FDO_COMPEC').AsFloat,
                                             qryGenDor.FieldByName('FDO_LARPEC').AsFloat,
                                             qryGenDor.FieldByName('FDO_ESPPEC').AsFloat,
                                             qryGenDor.FieldByName('UNI_SIGUNI').AsString);
      end;

      fltUniDigDescontada := fUniDigDescontada(qryGenDor.FieldByName('FDO_UNIDIG').AsFloat,
                                               qryGenDor.FieldByName('FDO_TAXJUR').AsFloat,
                                               qryGenDor.FieldByName('FDO_DESCON').AsFloat,
                                               qryGenDor.FieldByName('FDO_DESCND').AsFloat,
                                               qryGenDor.FieldByName('PROMOC').AsString);

      fltValorOriginalItemEstrutura := fltUniDigDescontada;
      If (Not fEmptyStr(qryGenDor.FieldByName('FDO_ITEEST').AsString)) Then
        fltValorOriginalItemEstrutura := qryGenDor.FieldByName('FDO_UNIVIS').AsFloat;

      pCarregaValoresCusto(qryGenDor.FieldByName('FDO_CODITE').AsString,
                           fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                           IIF(strTabPreIte.IsEmpty, Self.strTabPre, strTabPreIte));

      fltIcmsSaiIte := fRetIcmSai(qryGenDor.FieldByName('ITE_ICMSAI').AsFloat);

      If (fCfgSis('IMPCF4') = 'S') And
         (qryGenDor.FieldByName('FDO_IDEPRO').AsString = 'NOR') And
         (qryGenDor.FieldByName('FDO_PROACA').AsString <> 'S')  Then
      Begin
        fltIcmsSaiIte := fCalculaAliquota(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                          qryGenDor.FieldByName('FDO_EMPITE').AsString,
                                          qryGenDor.FieldByName('ITE_IMPDIR').AsString);
      End;

      strCodAbf := fGetCodAbf(qryGenDor.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString));
      strCodAbf := IfEmptyStr(strCodAbf, qryGenDor.FieldByName('ABF_CODABF').AsString);

      If (qryGenDor.FieldByName('FDO_IDEPRO').AsString = 'NOR') Then
      Begin

        If (Pos('ITEM ESPECIAL', qryGenDor.FieldByName('ITE_DESITE').AsString) > 0) Then
        Begin
          fltCusIte := qryGenDor.FieldByName('FDO_TOTCUS').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat;
          fltTotCus := qryGenDor.FieldByName('FDO_TOTCUS').AsFloat;
          fltTotCu2 := qryGenDor.FieldByName('FDO_TOTCU2').AsFloat;
        End

        Else If (qryGenDor.FieldByName('FDO_PROACA').AsString = 'S') Then
        Begin
          fltCusIte := qryGenDor.FieldByName('FDO_PRCTIN').AsFloat;
          fltTotCus := (qryGenDor.FieldByName('FDO_PRCTIN').AsFloat * fltQtdIte);
          fltTotCu2 := (qryGenDor.FieldByName('FDO_PRCTIN').AsFloat * fltQtdIte);
        End

        Else
        Begin
          If qryGenDor.FieldByName('LOT_PRECUS').AsFloat > 0 then
          Begin
            fltCusIte := qryGenDor.FieldByName('LOT_PRECUS').AsFloat;
            fltOutVal := 0;
          End
          Else
          Begin
            fltCusIte := fRetPreCus(qryGenDor.FieldByName('ITE_PRECUS').AsFloat);
            fltOutVal := fRetOutVal(qryGenDor.FieldByName('ITE_OUTVAL').AsFloat);
          End;

          strNotC17 := '';
          fltDedCus := 0;
          If (Pos(fCfgSis('MCAT17'),'D_A_C_M_V_') > 0) Then
            fltDedCus := fRetornaPrecoCustoDeduzindoRessarcimentoCAT(
                                          qryGenDor.FieldByName('ITE_CODITE').AsString,
                                          fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                                          fGetCodAbf(qryGenDor.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString)),
                                          qryGenDor.FieldByName('ITE_CODFOR').AsString,

                                          IIF(((qryGenDor.FieldByName('PROMOC').AsString = 'S') And
                                               (fltProPreCus > 0) and
                                               (fRegraPrecoSugestaoAtiva(True) = TRegraPrecoSugestao.PrecoDePromocao)),
                                             fltProPreCus, fltCusIte),

                                          strNotC17);

          If (qryGenDor.FieldByName('PROMOC').AsString = 'S') And
             (fltProPreCus > 0) and
             (fRegraPrecoSugestaoAtiva(True) = TRegraPrecoSugestao.PrecoDePromocao) then
          begin
            fltCusIte := IIF((fltDedCus > 0), fltDedCus, fltProPreCus)
          end
          Else
            fltCusIte := fRetornaPrecoCusto(Preco_de_Custo,
                                            qryGenDor.FieldByName('ITE_CODITE').AsString,
                                            qryGenDor.FieldByName('FDO_EMPITE').AsString,
                                            IIF((fltDedCus > 0), fltDedCus, fltCusIte));

          fltTotCus := fltCusIte * fltQtdIte;

          fltComLiq := 0;
          If (blnEmCampanha) And
             (fCfgSis('MARMKP') = '4') Then
          Begin
            objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                         qryGenDor.FieldByName('ITE_CODITE').AsString,
                                                         EmptyStr,
                                                         EmptyStr,
                                                         0,
                                                         fltVlrCam,
                                                         strCodCmg,
                                                         fltComLiq);
          End;

          objIcStPv.pAdd(qryGenDor.FieldByName('ITE_CODITE').AsString,
                         fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                         Self.GetTipAbf(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                         Self.fUFDestTrib(qryGenDor.FieldByName('FDO_EMPITE').AsString),
                         qryGenDor.FieldByName('FDO_CODFIS').AsString,
                         fltImcSTPV,
                         blnCalcST,
                         0,
                         fltComLiq);

          calcCustoReal := TCalcCustoReal.Create;
          calcCustoReal.fltUnitar := fltUniDigDescontada;
          calcCustoReal.fltPreCus := fltCusIte;
          calcCustoReal.fltOutVal := fltOutVal;
          calcCustoReal.fltIcmSai := fltIcmsSaiIte;
          calcCustoReal.fltIcmPav := fltImcSTPV;
          calcCustoReal.blnCalcST := blnCalcSt;
          calcCustoReal.fltImpFed := fRetImpFed(qryGenDor.FieldByName('ITE_IMPFED').AsFloat);
          calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(fRetDesOpe(qryGenDor.FieldByName('ITE_DESOPE').AsFloat));

          strCodSit := '';
          If (Not fEmptyStr(Self.GetTipAbf(qryGenDor.FieldByName('FDO_EMPITE').AsString))) And (fBuscaAbfIcm(qryGenDor.FieldByName('ITE_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, strCodAbf, fTrocaUFEndEntrega)) Then
            strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(qryGenDor.FieldByName('FDO_EMPITE').AsString)).AsString;

          calcCustoReal.fltDifal := fGetAlqDifal(qryGenDor.FieldByName('ITE_CODITE').AsString,
                                                 qryGenDor.FieldByName('FDO_EMPITE').AsString,
                                                 strCodAbf,
                                                 strCodSit);

          If ((qryGenDor.FieldByName('FDO_VALRET').AsFloat = 0) and (qryGenDor.FieldByName('FDO_BASICM').AsFloat <> 0)) Or
             ((qryGenDor.FieldByName('FDO_VALRET').AsFloat = 0) and blnCarregaPedidoOrcamentoEntFut) Then
            calcCustoReal.fltFcp := fGetAlqFcpIcms(qryGenDor.FieldByName('ITE_CODITE').AsString,
                                                   qryGenDor.FieldByName('FDO_EMPITE').AsString,
                                                   strCodAbf,
                                                   strCodSit,
                                                   fltIcmsSaiIte,
                                                   calcCustoReal.fltUnitar);

          fltTotCu2 := fRetornaPrecoCusto(Preco_de_Custo_Real,
                                          qryGenDor.FieldByName('ITE_CODITE').AsString,
                                          qryGenDor.FieldByName('FDO_EMPITE').AsString,
                                          fltCusIte,
                                          '',
                                          calcCustoReal) * fltQtdIte;

          FreeAndNil(calcCustoReal);
        End;

      End
      Else
      Begin
        fltCusIte := qryGenDor.FieldByName('FDO_TOTCUS').AsFloat / qryGenDor.FieldByName('FDO_QTDITE').AsFloat;
        fltTotCus := qryGenDor.FieldByName('FDO_TOTCUS').AsFloat;
        fltTotCu2 := qryGenDor.FieldByName('FDO_TOTCU2').AsFloat;
      End;

      If (stlItensNaoTemLote.IndexOf(qryGenDor.FieldByName('FDO_CODITE').AsString) = -1) And
         (objCadLot.fItemSemNenhumLote(qryGenDor.FieldByName('FDO_CODITE').AsString)) Then
      Begin
        stlItensNaoTemLote.Add(qryGenDor.FieldByName('FDO_CODITE').AsString);
      End;

      strEmpresaConsultaSaldo := '';
      If blnEmpFat And (Not qryGenDor.FieldByName('FDO_EMPITE').IsNull) Then
        strEmpresaConsultaSaldo := qryGenDor.FieldByName('FDO_EMPITE').AsString
      Else If Not fEmptyStr(strEmp_TE) Then
        strEmpresaConsultaSaldo := strEmp_TE
      Else
        strEmpresaConsultaSaldo := qryGenDor.FieldByName('FDO_CODEMP').AsString;

      If (qryGenDor.FieldByName('LOT_NUMLOT').AsString = 'A DEFINIR') And fCfgSis('DLSWMS', varBoolean) And (Not fUsaRotinaWMS) Then
      Begin
        fltSaldoVer := fRetSaldosEmpresa(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                         strEmpresaConsultaSaldo,
                                         qryGenDor.FieldByName('LOT_NUMLOT').AsString,
                                         True);
      End
      Else If (Not fEmptyStr(qryGenDor.FieldByName('LOT_NUMLOT').AsString)) And
         (stlItensNaoTemLote.IndexOf(qryGenDor.FieldByName('FDO_CODITE').AsString) = -1) And
         ((Not fEhEmissaoWms) Or (fTelaVendas And (qryGenDor.FieldByName('LOT_NUMLOT').AsString <> 'A DEFINIR'))) And
         objCadLot.fExisteLote(qryGenDor.FieldByName('FDO_CODITE').AsString,
                               strEmpresaConsultaSaldo,
                               qryGenDor.FieldByName('LOT_NUMLOT').AsString) Then
        fltSaldoVer := objCadLot.qryCadLot.FieldByName('LOT_SALDOS').AsFloat
      Else
      Begin
        If (blnEmpFat And (Not qryGenDor.FieldByName('FDO_EMPITE').IsNull)) or
           (Not fEmptyStr(strEmp_TE)) Then
          fltSaldoVer := fRetSaldosEmpresa(qryGenDor.FieldByName('FDO_CODITE').AsString, strEmpresaConsultaSaldo)
        Else
          fltSaldoVer := qryGenDor.FieldByName('ITE_SALDOS').AsFloat;
      End;

      if (qryGenDor.FieldByName('FDO_IDEPRO').AsString = 'NOR') then
      begin
        If (blnSaldoMatriz) Then
        Begin
          pCarregaEstoqueMatriz(qryGenDor.FieldByName('FDO_CODITE').AsString,
                                IIF(fIgnorarLote(qryGenDor.FieldByName('ITE_EMPITE').AsString, qryGenDor.FieldByName('FDO_CODITE').AsString), '', qryGenDor.FieldByName('LOT_NUMLOT').AsString));
          fltSaldoVer := fltSaldoMatriz;
        End;
      end;

      If (qryGenDor.FieldByName('FDO_PROACA').AsString <> 'S') Then
      Begin
        If (fEmptyStr(qryGenDor.FieldByName('LOT_NUMLOT').AsString)) Then
          fltSaldoVer := fltSaldoVer + qryGenDor.FieldByName('QTDPEN_ENTFUT').AsFloat
        Else If fUsaQtdPendenteEntregaFutura(True, IIF(blnSaldoMatriz, fEmpresaSaldoMatriz_CD, qryGenDor.FieldByName('ITE_EMPITE').AsString)) Then
        Begin
          fltSaldoVer := fltSaldoVer + TEntregaFutura.New(
                                         TParamEF.New()
                                           .CodIte(qryGenDor.FieldByName('FDO_CODITE').AsString)
                                           .CodEmp(IIF(blnSaldoMatriz, fEmpresaSaldoMatriz_CD, qryGenDor.FieldByName('ITE_EMPITE').AsString))
                                           .Lotes(IIF(fIgnorarLote(IIF(blnSaldoMatriz, fEmpresaSaldoMatriz_CD, qryGenDor.FieldByName('ITE_EMPITE').AsString), qryGenDor.FieldByName('FDO_CODITE').AsString), '', QuotedStr(qryGenDor.FieldByName('LOT_NUMLOT').AsString)))
                                           .Faturamento(True)
                                         ).Total();
        End;
      End;

      If (qryGenDor.FieldByName('FDO_PROACA').AsString = 'S') Then
      Begin
        FillChar(recValoresProdutoAcabado, SizeOf(recValoresProdutoAcabado), #0);
        recValoresProdutoAcabado := TProdAcabado.fValoresAcabado(qryGenDor.FieldByName('FDO_CODACA').AsString,
                                                                 qryGenDor.FieldByName('FDO_EMPACA').AsString,
                                                                 fEmpresaSaldoMatriz_CD,
                                                                 qryGenDor.FieldByName('FDO_PRVTIN').AsFloat);
        fltPreVe1 := recValoresProdutoAcabado.fltPreVe1;
        fltPreVe2 := recValoresProdutoAcabado.fltPreVe2;
        fltPreVe3 := recValoresProdutoAcabado.fltPreVe3;
        fltPreVe4 := recValoresProdutoAcabado.fltPreVe4;
        fltPreVe5 := recValoresProdutoAcabado.fltPreVe5;
        fltPreVe6 := recValoresProdutoAcabado.fltPreVe6;
        fltPreVe7 := recValoresProdutoAcabado.fltPreVe7;
        fltSaldoVer := recValoresProdutoAcabado.fltSaldo;
      End
      Else
      Begin
        If fUtilizaPrecoSubItensEstrutura((Pos('ITEM ESPECIAL', qryGenDor.FieldByName('ITE_DESITE').AsString) > 0),
                                          qryGenDor.FieldByName('FDO_CODITE').AsString) Then
        Begin
          fltPreVe1 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '1', fltMargem);
          fltPreVe2 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '2', fltMargem);
          fltPreVe3 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '3', fltMargem);
          fltPreVe4 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '4', fltMargem);
          fltPreVe5 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '5', fltMargem);
          fltPreVe6 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '6', fltMargem);
          fltPreVe7 := fCalculaPrecoEstrutura(False, Preco_de_Venda, qryGenDor.FieldByName('FDO_CODITE').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, 'S', '7', fltMargem);
        End
        Else
        Begin
          fltPreVe1 := qryGenDor.FieldByName('ITE_PREVE1').AsFloat;
          fltPreVe2 := qryGenDor.FieldByName('ITE_PREVE2').AsFloat;
          fltPreVe3 := qryGenDor.FieldByName('ITE_PREVE3').AsFloat;
          fltPreVe4 := qryGenDor.FieldByName('ITE_PREVE4').AsFloat;
          fltPreVe5 := qryGenDor.FieldByName('ITE_PREVE5').AsFloat;
          fltPreVe6 := qryGenDor.FieldByName('ITE_PREVE6').AsFloat;
          fltPreVe7 := qryGenDor.FieldByName('ITE_PREVE7').AsFloat;
        End;
      End;

      If (qryGenDor.FieldByName('FDO_IDEPRO').AsString <> 'NOR') Then
      Begin
        If Not IsTintaExistente(qryGenDor.FieldByName('FDO_IDEPRO').AsString) Then
        Begin
          blnFecharForm := True;
          Exit;
        End;

        pRetInfColorista(qryGenDor.FieldByName('FDO_CODEMP').AsString,
                         qryGenDor.FieldByName('FDO_NUMDOC').AsString,
                         qryGenDor.FieldByName('FDO_ESPDOC').AsString,
                         qryGenDor.FieldByName('FDO_ITETIN').AsString,
                         qryGenDor.FieldByName('FDO_CODACA').AsString,
                         intTipFor,
                         strObsCol);
      End;

      fltPesBruTmp := qryGenDor.FieldByName('FDO_TOTPES').AsFloat / fltQtdIteCalPes;
      fltPesLiqTmp := qryGenDor.FieldByName('ITE_PESLIQ').AsFloat;

      If (strEdiPes = 'E') And (blnPesPed) Then
      Begin
        fltPesBruTmp := fFormataFloat(qryGenDor.FieldByName('FDO_TOTPES').AsFloat / fltQtdIteCalPes, 2);
        fltPesLiqTmp := fFormataFloat(qryGenDor.FieldByName('FDO_PESLIQ').AsFloat / fltQtdIteCalPes, 2);
      End;

      If (intSeqCom < qryGenDor.FieldByName('FDO_SEQCOM').AsInteger) Then
        intSeqCom := qryGenDor.FieldByName('FDO_SEQCOM').AsInteger;

      fltFdoItePerDesEmbFec := FFdoIte.fRetornarPercentualDescontoEmbalagemFechada(qryGenDor.FieldByName('AUTOINCREM').AsString);
      If (fltFdoItePerDesEmbFec > 0) Then
        FAuditoriaEmbFechada.GravarClientDataSetItemAuditoriaEmbFechada(qryGenDor.FieldByName('FDO_CODEMP').AsString, qryGenDor.FieldByName('FDO_CODITE').AsString,
          strTabPreIte, '', qryGenDor.FieldByName('FDO_QTDITE').AsFloat, fltFdoItePerDesEmbFec);

      If (fFormataFloat(qryGenDor.FieldByName('ITE_QTDBAI').AsFloat, 2) > 0) And (Not blnHerancaOrcamentoPedido) And (Not blnOrigemTelaDesmembrarPedidoConfiguracaoDPDAFPLigada) Then
      Begin
        impSubIteEst := fGetImpostosDoCustoRealPedido(qryGenDor, qryGenDor.FieldByName('ITE_QTDBAI').AsFloat, fltUniDigDescontada, fltIcmsSaiIte);
        fltMarLuc := fGetMargemLucroPedido(qryGenDor, impSubIteEst, fltCusIte, fltUniDigDescontada, strCodAbf);

        pAlteraRegistroTemporaria(cdsDadosPedBaixados,
                                  objCalculaImpostoPedido,
                                  qryGenDor.FieldByName('ITE_CHVUNI').AsString,
                                  fltUniDigDescontada,
                                  qryGenDor.FieldByName('ITE_QTDBAI').AsFloat,
                                  fFormataFloat(fltUniDigDescontada * qryGenDor.FieldByName('ITE_QTDBAI').AsFloat, 2),
                                  fltTotCus / qryGenDor.FieldByName('ITE_QTDBAI').AsFloat,
                                  fltTotCus,
                                  fltTotCu2 / qryGenDor.FieldByName('ITE_QTDBAI').AsFloat,
                                  fltTotCu2,
                                  fltPreVe1,
                                  fltPreVe2,
                                  fltPreVe3,
                                  fltPreVe4,
                                  fltPreVe5,
                                  fltPreVe6,
                                  fltPreVe7,
                                  fltMarLuc,
                                  fltSaldoVer,
                                  '',
                                  '',
                                  '',
                                  strCodAbf,
                                  fltPesBruTmp,
                                  fltPesLiqTmp,
                                  fltProPreCus,
                                  fltProPreVen,
                                  fltProComVar,
                                  fltProDesF07,
                                  qryGenDor.FieldByName('FDO_SEQIND').AsInteger,
                                  IIF(Pos(strOpcDoc,'VN_CS_PD_OR_') > 0, 0, qryGenDor.FieldByName('ITE_QTDBAI').AsFloat),
                                  strStatus,
                                  IIF(fltQtdIte > fltSaldoVer, 'S', 'N'),
                                  impSubIteEst.fltOutVal,
                                  impSubIteEst.fltDesOpe,
                                  impSubIteEst.fltIcmSai,
                                  impSubIteEst.fltImpFed,
                                  strTabPreIte,
                                  qryGenDor.FieldByName('FDO_DTENTR').AsDateTime,
                                  fltProComAta,
                                  fltProComDis,
                                  IIF(qryGenDor.FieldByName('FDO_PODALT').AsInteger=1, True, False),
                                  fltCusIte,
                                  fltQtdPec,
                                  qryGenDor.FieldByName('FDO_SEQINC').AsInteger,
                                  strObsCol,
                                  intTipFor,
                                  strNotC17,
                                  fltValorOriginalItemEstrutura,
                                  qryGenDor.FieldByName('FDO_BASTRO').AsString,
                                  qryGenDor.FieldByName('FDO_CODDIG').AsString);
      End;

      If (fltQtdIte <= 0.0) And (Not blnOrigemTelaDesmembrarPedidoConfiguracaoDPDAFPLigada) Then
      Begin
        qryGenDor.Next;
        Continue;
      End;

      If (Not blnInsPri) Then
      Begin
        pSetaIndiceDestino(qryGenDor.FieldByName('ITE_ENTRET').asString);
        blnInsPri := True;
      End;

      If (qryGenDor.FieldByName('FDO_JAFATU').AsFloat = 0) Or (blnHerancaOrcamentoPedido) Or (blnOrigemTelaDesmembrarPedidoConfiguracaoDPDAFPLigada) Then
      Begin
        impSubIteEst := fGetImpostosDoCustoRealPedido(qryGenDor, fltQtdIte, fltUniDigDescontada, fltIcmsSaiIte);
        fltMarLuc := fGetMargemLucroPedido(qryGenDor, impSubIteEst, fltCusIte, fltUniDigDescontada, strCodAbf);

        pIncrementaListaStr(qryGenDor.FieldByName('FDO_CODITE').AsString, strCodIteLisOrc, True, True, ',', False);
        stlCodIteCodEmp.Add(qryGenDor.FieldByName('FDO_CODITE').AsString + qryGenDor.FieldByName('ITE_EMPITE').AsString);

        if fEhPedidoReposicaoClienteGarantia then
        Begin
          Self.strOpcDocTrue := 'GC';
          Self.strOpcDoc := 'CP';
        End;

        pObterDocumentoDevolucaoItemPedido(qryGenDor.FieldByName('AUTOINCREM').AsString, recDocumentoDevolucao, arrRecDocumentoDevolucaoPedidoGarantia, Self.strMen001);

        pAlteraRegistroTemporaria(cdsVenda,
                                  objCalculaImpostoPedido,
                                  qryGenDor.FieldByName('ITE_CHVUNI').AsString,
                                  fltUniDigDescontada,
                                  fltQtdIte,
                                  fFormataFloat(fltUniDigDescontada * fltQtdIte, 2),
                                  fltTotCus / fltQtdIte,
                                  fltTotCus,
                                  fltTotCu2 / fltQtdIte,
                                  fltTotCu2,
                                  fltPreVe1,
                                  fltPreVe2,
                                  fltPreVe3,
                                  fltPreVe4,
                                  fltPreVe5,
                                  fltPreVe6,
                                  fltPreVe7,
                                  fltMarLuc,
                                  fltSaldoVer,
                                  recDocumentoDevolucao.strDocDev,
                                  recDocumentoDevolucao.strEspDev,
                                  recDocumentoDevolucao.strEmpDev,
                                  strCodAbf,
                                  fltPesBruTmp,
                                  fltPesLiqTmp,
                                  fltProPreCus,
                                  fltProPreVen,
                                  fltProComVar,
                                  fltProDesF07,
                                  qryGenDor.FieldByName('FDO_SEQIND').AsInteger,
                                  IIF(blnOrigemTelaDesmembrarPedidoConfiguracaoDPDAFPLigada, qryGenDor.FieldByName('ITE_QTDBAI').AsFloat, IIF(Pos(strOpcDoc,'VN_CS_PD_OR_') > 0, 0, qryGenDor.FieldByName('ITE_QTDBAI').AsFloat)),
                                  strStatus,
                                  IIF(fltQtdIte > fltSaldoVer, 'S', 'N'),
                                  impSubIteEst.fltOutVal,
                                  impSubIteEst.fltDesOpe,
                                  impSubIteEst.fltIcmSai,
                                  impSubIteEst.fltImpFed,
                                  strTabPreIte,
                                  qryGenDor.FieldByName('FDO_DTENTR').AsDateTime,
                                  fltProComAta,
                                  fltProComDis,
                                  IIF(qryGenDor.FieldByName('FDO_PODALT').AsInteger=1, True, False),
                                  fltCusIte,
                                  fltQtdPec,
                                  IIF(blnHerancaOrcamentoPedido, 0, qryGenDor.FieldByName('FDO_SEQINC').AsInteger),
                                  strObsCol,
                                  intTipFor,
                                  strNotC17,
                                  fltValorOriginalItemEstrutura,
                                  qryGenDor.FieldByName('FDO_BASTRO').AsString,
                                  qryGenDor.FieldByName('FDO_CODDIG').AsString);

        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_ITENOV').AsString := 'N';
        cdsVenda.FieldByName('ITE_COMVEN').AsFloat  := qryGenDor.FieldByName('FDO_TOTCOM').AsFloat;
        cdsVenda.Post;

        strCodDiv := qryGenDor.FieldByName('FDO_CODDIV').AsString;

        If qryGenDor.FieldByName('FDO_IDEPRO').AsString <> 'NOR' Then
        Begin
          matrizSaldosAux := fDesfragmentaTintaSaldosOR(qryGenDor, blnLocFor, Not blnValidarEstoqueAoCarregarPedido);

          If (Not blnLocFor) Then
          Begin
            If (strOpcDocTrue = 'EF') Then
            Begin
              //Trava para EF - Entrega Futura pelo CD. Caso REQ.: 192089;
              Raise Exception.Create('Fórmula não encontrada durante a carga do pedido/orçamento!');
            End;

            cdsVenda.Delete;
            blnDeletouItens := True;
            blnDeletouTinta := True;
          End
          Else
          Begin
            pCarregardicFormulasOrcamento(matrizSaldosAux, cdsVenda.FieldByName('AUTOINCREM').AsString);
            pSetaCampoPromocaoPorCnd(cdsVenda, matrizSaldosAux, True);
          End;
        End;

        If Assigned(FOnAdicionouItemDoPedido) And (Not blnDeletouTinta) Then
          FOnAdicionouItemDoPedido;

        blnDeletouTinta := False;
      End;

      pCarregarSerieDoItem(qryGenDor.FieldByName('FDO_TEMNSE').AsString,
                           qryGenDor.FieldByName('AUTOINCREM').AsString,
                           qryGenDor.FieldByName('FDO_CODITE').AsString,
                           qryGenDor.FieldByName('FDO_EMPITE').AsString,
                           cdsVenda.FieldByName('AUTOINCREM').AsInteger,
                           FIncOrc);

      pTotalizaDescontoEspecialDoPedidoBxEntFutura(cdsVenda.FieldByName('AUTOINCREM').AsString, qryGenDor.FieldByName('FDO_DESESP').AsFloat);

      qryGenDor.Next;
    End;

    Try
      pInfoStatusGravacao('Aguarde... Calculando Tabelas de Preços Tintas...');

      pAcertaTabelaPrecoTinta(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                              qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                              qryFatGor.FieldByName('FGO_CODEMP').AsString,
                              True);
    Except
      On E: Exception do
      Begin
        blnFecharForm := True;
        fMensagem('ATENÇÃO!', E.Message, ['OK']);
        Exit;
      End;
    End;

    pInfoStatusGravacao('Aguarde... Calculando Tabelas de Preços Vidros...');
    pCarregaEstruturaVidrosPedOrc;

    pInfoStatusGravacao('Aguarde... Calculando Preços Produto Acabado...');
    pAcertaProdutoAcabado;

    pInfoStatusGravacao('Aguarde... Carregando profissionais...');
    pInicializaDadosDeProfissionais(qryFatGor.FieldByName('AUTOINCREM').AsString);

    pInfoStatusGravacao('Aguarde... Atualizando lote dos produtos...');
    pAtualizaLoteItensWMS;

    If (blnValidarEstoqueAoCarregarPedido) Then
    Begin
      pInfoStatusGravacao('Aguarde... Verificando Saldos...');
      blnApenasExibirEst := blnEmpFat And
                            SameText(strOpcDoc, 'VN') And
                            (Not SameText(strOriF11, 'S'));
      blnFecharForm := Not fVerificaEstoqueItens( strOpcDoc,
                                                  '',
                                                  True,
                                                  blnApenasExibirEst,
                                                  False );
    End;

    pSintetizaPedidosPagAnt;
    pCarregaStringListExcecoes(strCodIteLisOrc, '', stlCodIteCodEmp);

    {*Req.202377**********RP*}
    If (fCfgSis('CNDVEN') = 'I') Or (Pos(strOpcDoc, 'OR_PD_VN_') <= 0) Or (strOriF11 = 'S') Or (blnEmissaoEntFutPorFatPedEntCd) Then
      pAtualizaInformacoesCondPagamento;

    intSeqCom := intSeqCom + 1;

    Self.FSeqIndUlt := fRetornaUltimoSeqInd(qryFatGor.FieldByName('FGO_NUMDOC').AsString, qryFatGor.FieldByName('FGO_ESPDOC').AsString, qryFatGor.FieldByName('FGO_CODEMP').AsString);
    FChaveUltimoDocSeqInd := '';
    If (Self.FSeqIndUlt > 0) Then 
    Begin
      Self.FChaveUltimoDocSeqInd := qryFatGor.FieldByName('FGO_NUMDOC').AsString+
                                    qryFatGor.FieldByName('FGO_ESPDOC').AsString+
                                    qryFatGor.FieldByName('FGO_CODEMP').AsString;
    End;

    FblnEmSeparacao := (fDocumentoEmSeparacao) And (Not blnHerancaOrcamentoPedido);
    if FblnEmSeparacao then
      pCarregaLotDor;

    FblnPedidoOS := (qryFatGor.FieldByName('FGO_ESPDOC').AsString = 'PD')
      and (not fEmptyStr(fRetornaOrdemServicoPedido(qryFatGor.FieldByName('FGO_NUMDOC').AsString,qryFatGor.FieldByName('FGO_CODEMP').AsString)));
    FblnCSTCEQ := fCfgSis('CSTCEQ', varBoolean);

    strCodEqu := fRetornaCodEquOSPedido(qryFatGor.FieldByName('FGO_NUMDOC').AsString, qryFatGor.FieldByName('FGO_ESPDOC').AsString,
      qryFatGor.FieldByName('FGO_CODEMP').AsString);

    if not fEmptyStr(strCodEqu) then
    begin
      FstrEquDescri := fCampoTabela('EQU_DESCRI', 'CADEQU', ['EQU_CODIGO'], [strCodEqu]);
      FstrEquModelo := fCampoTabela('EQU_MODELO', 'CADEQU', ['EQU_CODIGO'], [strCodEqu]);
    end;

    FAutIcv   := qryFatGor.FieldByName('FGO_AUTICV').AsString;
    strCliTop := qryFatGor.FieldByName('FGO_CLITOP').AsString;
    FAutRco   := qryFatGor.FieldByName('FGO_AUTRCO').AsString;
    strSupGer := qryFatGor.FieldByName('FGO_SUPGER').AsString;
    strSupReg := qryFatGor.FieldByName('FGO_SUPREG').AsString;
    FCdcOpo   := qryFatGor.FieldByName('FGO_CDCOPO').AsInteger;
    FCdcSta   := qryFatGor.FieldByName('FGO_CDCSTA').AsString;

    pInfoStatusGravacao('Aguarde... Calculando comissão...');
    pRecalculaComissao(EmptyStr);

    pInfoStatusGravacao('Aguarde... Carregando consultas de frete...');
    pCarregaConsultasDeFrete(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                             qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                             qryFatGor.FieldByName('FGO_CODEMP').AsString);

    pInfoStatusGravacao('Aguarde... Carregando dados do documento...');
  Finally
    Self.strPromoc    := 'N';
    Self.fltProPreCus := 0;
    Self.fltProPreVen := 0;
    Self.fltProComVar := 0;
    Self.fltProComAta := 0;
    Self.fltProComDis := 0;
    Self.fltProDesF07 := 0;

    Self.blnGerarExcecaoSeNaoAcharAliquotaICMS := False;
    Self.pgbStatusGravacao := Nil;

    If Assigned(stlCodIteCodEmp) Then
      FreeAndNil(stlCodIteCodEmp);
    
    If Assigned(qryGenDor) Then
      FreeAndNil(qryGenDor);

    If Assigned(qryGen) Then
      FreeAndNil(qryGen);

    If (Assigned(objCalculaImpostoPedido)) Then
      FreeAndNil(objCalculaImpostoPedido);
  End;
end;

function TFatVenda.fEhItemRetiraCaixaELotePickingCheckOut(ADataSet : TDataSet) : Boolean;
begin

  Result := False;

  If Not TPickingCheckOut.fWMSUtilizaPickingCheckOut Then
    Exit;

  If Not Assigned(ADataSet) Then
    Exit;

  If (ADataSet.FindField('FDO_ENTRET') <> Nil) Then
    If Not ADataSet.FieldByName('FDO_ENTRET').AsString.Equals('R') Then
      Exit;

  If (ADataSet.FindField('FDO_LOCRET') <> Nil) Then
    If Not ADataSet.FieldByName('FDO_LOCRET').AsString.Equals('C') Then
      Exit;

  Result := True;

end;

procedure TFatVenda.pCarregaLotDor;
  Var
    strSQL: String;
begin
  strSQL := ' SELECT CAST("" AS CHAR(20)) AS SEQNEW, LOTDOR.* '+
            '   FROM LOTDOR INNER JOIN FATDOR ON LOTDOR.LDO_SEQFDO = FATDOR.AUTOINCREM '+
            '   WHERE FATDOR.FDO_NUMDOC = '+QuotedStr(strNumOrc)+
            '     AND FATDOR.FDO_ESPDOC = '+QuotedStr(strEspOrc)+
            '     AND FATDOR.FDO_CODEMP = '+QuotedStr(strEmpOri);

  If Assigned(FCdsLotDor) Then
    FreeAndNil(FCdsLotDor);

  FCdsLotDor := fCriaClientDataset(strSQL, Self);
end;

function TFatVenda.fDocumentoEmSeparacao: Boolean;
var
  qryConsulta: TUniQuery;
begin
  Result := False;

  if fEmptyStr(strNumOrc) then
    Exit;

  if not fUsaRotinaWMS then
    Exit;

  qryConsulta := fCriaQuery;
  try
    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add('SELECT FGO_SEPIMP ');
    qryConsulta.SQL.Add('FROM FATGOR ');
    qryConsulta.SQL.Add('WHERE FGO_NUMDOC = :NUMDOC ');
    qryConsulta.SQL.Add('  AND FGO_ESPDOC = :ESPDOC ');
    qryConsulta.SQL.Add('  AND FGO_CODEMP = :CODEMP ');

    qryConsulta.ParamByName('NUMDOC').AsString := strNumOrc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspOrc;
    qryConsulta.ParamByName('CODEMP').AsString := strEmpOri;

    qryConsulta.Open;
    Result := (StrToIntDef(qryConsulta.FieldByName('FGO_SEPIMP').AsString, 0) > 0);

    if Result then
      Exit;

    qryConsulta.Close;
    qryConsulta.SQL.Clear;
    qryConsulta.SQL.Add('SELECT FD.AUTOINCREM ');
    qryConsulta.SQL.Add('FROM FATDOR FD');
    qryConsulta.SQL.Add('INNER JOIN LOTDOR ON LDO_SEQFDO = FD.AUTOINCREM');
    qryConsulta.SQL.Add('WHERE FDO_NUMDOC = :NUMDOC ');
    qryConsulta.SQL.Add('  AND FDO_ESPDOC = :ESPDOC ');
    qryConsulta.SQL.Add('  AND FDO_CODEMP = :CODEMP ');

    qryConsulta.ParamByName('NUMDOC').AsString := strNumOrc;
    qryConsulta.ParamByName('ESPDOC').AsString := strEspOrc;
    qryConsulta.ParamByName('CODEMP').AsString := strEmpOri;

    qryConsulta.Open;
    Result := not qryConsulta.IsEmpty;
  finally
    FreeAndNil(qryConsulta);
  end;
end;

procedure TFatVenda.pCarregaProdutoAmostra(strSeqGer: String);
var
  qryTabela: TUniQuery;
begin
  If (VS_strUsaTmq <> 'S') Then
    Exit;

  qryTabela := fCriaQuery;

  qryTabela.Close;
  qryTabela.SQL.Clear;
  qryTabela.SQL.Add('SELECT PRD_DESAMO, PRD_NOMCLI FROM PRDAMO');
  qryTabela.SQL.Add('WHERE PRD_SEQGER = :SEQGER');
  qryTabela.ParamByName('SEQGER').AsString := strSeqGer;
  qryTabela.Open;

  If Not qryTabela.isEmpty Then
  Begin
    strNomCli := qryTabela.FieldByName('PRD_NOMCLI').AsString;
    strDesAmo := qryTabela.FieldByName('PRD_DESAMO').AsString;
  End
  Else
  Begin
    strNomCli := '';
    strDesAmo := '';
  End;

  FreeAndNil(qryTabela);
end;

function TFatVenda.fRetPedidoBaixadoFormulacao(strCodAca, strEmpAca, strNumDoc, strEspDoc,
  strCodEmp: String): Boolean;
var
  qryGen: TUniQuery;
begin
  Result := False;
  If fCfgSis('EXIDOC') <> 'V' Then
  Begin
    Try
      qryGen := fCriaQuery;
      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT FDO_BAIXAD           ');
        SQL.Add('   FROM TINDOR               ');
        SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC ');
        SQL.Add('    AND FDO_ESPDOC = :ESPDOC ');
        SQL.Add('    AND FDO_CODEMP = :CODEMP ');
        SQL.Add('    AND FDO_CODACA = :CODACA ');
        SQL.Add('    AND FDO_EMPACA = :EMPACA ');
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODACA').AsString := strCodAca;
        ParamByName('EMPACA').AsString := strEmpAca;
        Open;

        Result := (FieldByName('FDO_BAIXAD').AsString = 'S') Or (FieldByName('FDO_BAIXAD').AsString = '1');
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

function TFatVenda.fRetPedidosDosItens(arrItens: TMatrizFechamento): TDocumentos;
  Var
    intCnt : Integer;
    strChave : String;
    lstChave : TStringList;
begin
  lstChave := TStringList.Create;
  SetLength(Result, 0);
  For intCnt := Low(arrItens) To High(arrItens) Do
  Begin
    strChave := arrItens[intCnt].strNumOrc +
                arrItens[intCnt].strEspOrc +
                arrItens[intCnt].strEmpOrc;

    If (Not fEmptyStr(strChave)) And (lstChave.IndexOf(strChave) < 0) And (arrItens[intCnt].strEspOrc = 'PD') Then
    Begin
      lstChave.Add(strChave);
      SetLength(Result, Length(Result) + 1);
      Result[Length(Result) - 1].strNumDoc := arrItens[intCnt].strNumOrc;
      Result[Length(Result) - 1].strEspDoc := arrItens[intCnt].strEspOrc;
      Result[Length(Result) - 1].strCodEmp := arrItens[intCnt].strEmpOrc;
      Result[Length(Result) - 1].strCodCli := strCodCli;
    End;
  End;
  FreeAndNil(lstChave);
end;

