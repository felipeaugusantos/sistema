{***************************************}
{* ABRE UM LISTA DE OPERADORES DA LOJA *}
{* DO CLIENTE FILIAL                   *}
{************************************AF*}
function TFatVenda.fSelecionaOperadorFilial: String;
  Var
    strCodEmp  : String;
    strSQL     : String;
    qryGen     : TUniQuery;
    arrOpcoes  : Array Of String;
Begin
  Result := '';
  qryGen := fCriaQuery;

  {****************************}
  {* PEGA O CODIGO DA EMPRESA *}
  {*************************AF*}
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  EMP_CODEMP ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADEMP ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  EMP_CLIFIL = :CLIFIL ';

  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CLIFIL').AsString := strCodCli;
    Open;

    strCodEmp := FieldByName('EMP_CODEMP').AsString;

    Close;
  End;

  {**************************************}
  {* MONTA A LISTA DE OPERADORES        *}
  {***********************************AF*}
  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  OPE_CODOPE, ';
  strSQL := strSQL + '  OPE_NOMOPE ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  CADOPE ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  OPE_CODEMP = :CODEMP  AND ';
  strSQL := strSQL + '  OPE_CODOPE <> :CODOPE AND ';
  strSQL := strSQL + '  OPE_STATUS = "A"  ';

  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODOPE').AsString := strCodVen;
    Open;

    If Not IsEmpty Then
    Begin
      SetLength(arrOpcoes, RecordCount);

      First;
      While Not Eof Do
      Begin
        arrOpcoes[Pred(recNo)] := FieldByName('OPE_CODOPE').AsString + ' - ' + FieldByName('OPE_NOMOPE').AsString;
        Next;
      End;

      Result := LeftStr(arrOpcoes[Pred(fGetMenu('Selecione o Solicitante', arrOpcoes, 1, False, True))],3);
    End;

    Close;
  End;

  FreeAndNil(qryGen);
End;

