  Result := True;

  If (Not fCfgSis('OSPDVN', varBoolean)) Then Exit;

  Result := objOrdSer.fGravaOrdSerOrc(strAutIncFatGor, strNumDoc, strEspDoc);
end;

function TFatVenda.fGNotDet: Boolean;
  Var
    fltPerCom: Double;
    fltTotCom: Double;
    fltTotCo2: Double;
    fltTotPes: Double;
    strMovDet: String;
    intContador: Integer;
    fltBcaMin : Double;
    fltBcaCom : Double;
    qryGen : TUniQuery;
    strSQL : String;
    fltTot_RT,
    fltPerExt,
    fltTotExt: Double;
    strEmpSel: String;
    strEmpAtu: String;
    intQtdEmp: Integer;

    strCodDivVenda: String;
    strAutIncVenda: String;
    strVendedor: String;
    strVendedor2: String;

    fltQtdCha: Double;
    fltMedB_L: Double;
    fltMedB_A: Double;
    fltMedL_L: Double;
    fltMedL_A: Double;
    fltEspess: Double;
    blnGravaNdtCha: Boolean;
    blnIteEsp: Boolean;

    objCalcComissaoVend: TCalculoComissaoVendedor;
    LRefGravacao: TRefTribValoresGravacao;
begin

  fltBcaMin := 0;
  fltBcaCom := 0;
  fltImpUlt := 0;

  FstrTabelaReformaGravada := 'NOTREF';

  Try
    Result := True;

    strEmpSel := '';
    intQtdEmp := 0;

    {****************************************************}
    {* PESQUISA SE EXISTEM MAIS DE UMA EMPRESA DENTRE   *}
    {* OS PEDIDOS DOS ITENS FATURADOS PARA SETAR A EM-  *}
    {* PRESA ORIGEM DA DUPLICATA                        *}
    {*************************************************IV*}
    For intContador := 0 To Length(arrMatItens) -1 Do
    Begin
      If Pos(arrMatItens[intContador].strEmpOrc, strEmpSel) <= 0 Then
      Begin
        strEmpAtu := arrMatItens[intContador].strEmpOrc;
        strEmpSel := strEmpSel + arrMatItens[intContador].strEmpOrc + '_';
        Inc(intQtdEmp);
      End;
    End;

    If intQtdEmp > 1 Then
      strEmpRec := VS_strCodEmp
    Else
      If intQtdEmp = 1 Then
        strEmpRec := strEmpAtu
      Else
        strEmpRec := '';

    If (Pos(strOpcDoc, 'CF_CI_') > 0) Then
      TPromocaoBrindes.pCalculaPontosGeradosVenda(arrMatItens, strOpcDoc);

    strMovDet  := 'MOVDET';

    For intContador := 0 To Length(arrMatItens) -1 Do
    Begin
      pInfoStatusGravacao('Aguarde... Gravando Produto ' + intToStr(Succ(intContador)) + '/' + intToStr(Length(arrMatItens)), True);

      intContMat := intContador;

      strVendedor := arrMatItens[intContador].strVenCnf;

      blnIteEsp := (Pos('ITEM ESPECIAL', arrMatItens[intContador].strDesOri) > 0);

      If fEmptyStr(strVendedor) Then
      Begin
        If Not fUsaVendedorDoItemParaComissao(arrMatItens[intContador].strCodVen) Then
          strVendedor := Self.strCodVen
        Else
          strVendedor := arrMatItens[intContador].strCodVen;
      End;

      If Not fUsaVendedorDoItemParaComissao(arrMatItens[intContador].strCodVe2) Then
        strVendedor2 := Self.strCodVe2
      Else
        strVendedor2 := arrMatItens[intContador].strCodVe2;

      If (strNotImp <> 'S') Then
      Begin
        objCalcComissaoVend := fCriaCalculoComissaoVendedor(strVendedor);

        fltPerCom := objCalcComissaoVend.fRetPerComissao(arrMatItens[intContador], strTipVen);

        fltTot_RT := arrMatItens[intContador].fltRT_Ori * arrMatItens[intContador].fltQtdIte;

        fltTotCom := fltPerCom * (arrMatItens[intContador].fltTotIte -
                                  arrMatItens[intContador].fltTaxEnt -
                                  arrMatItens[intContador].fltDesEsp - fltTot_RT) / 100;

        fltPerExt := objCalcComissaoVend.fRetPerComissao(arrMatItens[intContador], 'E', True);

        fltTotExt := fltPerExt * (arrMatItens[intContador].fltTotIte -
                                  arrMatItens[intContador].fltTaxEnt -
                                  arrMatItens[intContador].fltDesEsp - fltTot_RT) / 100;

        FreeAndNil(objCalcComissaoVend);

        If (fCfgSis('REPVEN', varBoolean)) And (Not fEmptyStr(strCodVe2)) Then {02/05/2007}
        Begin
          fltTotCo2 := (fltTotCom * fCfgSis('TAXREP', varDouble)) / 100;
          fltTotCom := fltTotCom - fltTotCo2;
        End
        Else
          fltTotCo2 := 0;
            End
      Else
      Begin
        fltPerCom := 0;
        fltTotCom := 0;
        fltPerExt := 0;
        fltTotExt := 0;
        fltTotCo2 := 0;
      End;

      fltTotPes := (arrMatItens[intContador].fltPesoIt *
                    arrMatItens[intContador].fltQtdIte);

      If (fGerarComissaoDeBocaDeCaixa(False)) Then
      Begin
        {*****************************}
        {* VERIFICAÇÃO BOCA DE CAIXA *}
        {**************************LU*}
        qryGen := fCriaQuery(Self);
        strSQL := '';
        strSQL := strSQL + ' SELECT ';
        strSQL := strSQL + '   CADBCA.*, ';
        strSQL := strSQL + '   ITE_CODGRU "BCA_CODGRU"';
        strSQL := strSQL + ' FROM CADBCA ';
        strSQL := strSQL + '   INNER JOIN CADITE ';
        strSQL := strSQL + '     ON BCA_CODITE = ITE_CODITE ';
        strSQL := strSQL + ' WHERE ';
        strSQL := strSQL + '   BCA_CODITE = :CODITE AND ';
        strSQL := strSQL + '   BCA_CODEMP = :CODEMP ';

        qryGen.Close;
        qryGen.SQL.Clear;
        qryGen.SQL.Add(strSQL);
        qryGen.ParamByName('CODITE').AsString := arrMatItens[intContador].strCodIte;
        qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
        qryGen.Open;

        If Not qryGen.IsEmpty Then
        Begin
          If fFormataFloat(((arrMatItens[intContador].fltTotIte -
                             arrMatItens[intContador].fltDesEsp -
                             arrMatItens[intContador].fltTaxEnt) / arrMatItens[intContador].fltQtdIte), 2)
           < fFormataFloat(qryGen.Fieldbyname('BCA_PREMIN').AsFloat, 2) Then
          Begin
            fltBcaMin := qryGen.Fieldbyname('BCA_PREMIN').AsFloat;
            fltBcaCom := 0;
          End
          Else
          Begin
            fltBcaMin := qryGen.Fieldbyname('BCA_PREMIN').AsFloat;

            If (fCfgSis('COMBCA', varString) = '$') Then
              fltBcaCom := (qryGen.Fieldbyname('BCA_COMVAR').AsFloat * arrMatItens[intContador].fltQtdIte)
            Else
              fltBcaCom := (arrMatItens[intContador].fltTotIte -
                            arrMatItens[intContador].fltDesEsp -
                            arrMatItens[intContador].fltTaxEnt) * (qryGen.Fieldbyname('BCA_COMVAR').AsFloat / 100);
          End;
        End
        Else
        Begin
          fltBcaMin := 0;
          fltBcaCom := 0;
        End;
      End;

      strCodDivVenda := '';
      strAutIncVenda := '';

      If (Pos(strOpcDoc, 'CF_CT_') > 0) And (Not fConfirmacaoCFeCIComFator) Then
      Begin
        strAutIncVenda := arrMatItens[intContador].strSeqDet;

        If (strOpcDoc = 'CF') Then
          strCodDivVenda := fCampoTabela('DET_CODDIV', 'MOVDET', ['AUTOINCREM'], [strAutIncVenda]);
      End;

      If (Self.strEspDoc = 'IF') And (arrMatItens[intContador].fltValFre > 0) Then
      Begin
        arrMatItens[intContador].fltDesAce := arrMatItens[intContador].fltDesAce +
                                              arrMatItens[intContador].fltValFre;

        arrMatItens[intContador].fltValFre := 0;
      End;

      arrMatItens[intContador].fltValIpiEntFut   := 0.00;
      arrMatItens[intContador].fltValRetEntFut   := 0.00;
      arrMatItens[intContador].fltValFcpSTEntFut := 0.00;

      {*REQ.144458**********RP*}
      If (strOpcDoc <> 'CF') And (arrMatItens[intContador].strEntFutDocOri = 'S') And (fCfgSis('ENFUOP') = '2') Then
      Begin
        arrMatItens[intContador].fltValIpiEntFut   := arrMatItens[intContador].fltValIpi;
        arrMatItens[intContador].fltValRetEntFut   := arrMatItens[intContador].fltValRet;
        arrMatItens[intContador].fltValFcpSTEntFut := arrMatItens[intContador].recDifalFCP.fltValFcp;

        arrMatItens[intContador].fltDesAce := arrMatItens[intContador].fltDesAce +
                                              arrMatItens[intContador].fltValIpi +
                                              arrMatItens[intContador].fltValRet +
