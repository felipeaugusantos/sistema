function TFatVenda.fGNotGer: Boolean;
  Var
    strValCnfNfeCom: String;
    strValCnfNfeFis: String;
    intIpDpConfCi : Integer;

    arrDuplicOri: Array [0..23] Of TArrDigDuplic;
    intContCopia: Integer;
    intQtdDup   : Integer;
    curTotalRes : Currency;

    strCodDivOri: String;
    strCliTelTmp: String;
    strEntFutDocOri: String;
    intCnt: Integer;
begin
  Try
    Result := True;

    intIpDpConfCi := 0;
    {*******************************************}
    {* SE FOR CONFIRMAÇÃO DE CUPOM             *}
    {****************************************MV*}
    If (strOpcDoc = 'CI') Then
    Begin
      strClaFis := LeftStr(strClaFis, 1) + fCfgSis('CLACIF');
      intIpDpConfCi := IIF((fltTotCadRec <= 0 ) And (fltDupRec > 0), 1, 0 );
    End;

    pCarregaVariaveisDuplicatas;

    strValCnfNfeCom := '';
    strValCnfNfeFis := '';

    If (fProcessaCNF_NFE) Then
    Begin
      pCalculaPontosClubeFidelidade;

      If ((Pos(Self.strOpcDoc,'CF_CI_CP_') > 0) And (strCliOrg = 'S') And (strCalIcm = 'N') And (fltNotIcmOrg > 0)) Then
      Begin
        fltBasOrg := fltNotBasOrg;
        fltIcmOrg := fltNotIcmOrg;
      End;

      strCliTelTmp := strCliTel;
      strCodDivOri := strCodDiv;

      If Not fEmptyStr(strCliTel) Then
        strCliTel  := fFormataFonePais(strCliTel);

      If fEmptyStr(strCodDiv) And (fCfgSis('NROPRO') = '3') And (Assigned(cdsProfiss)) And (cdsProfiss.Active) Then
      Begin
        cdsProfiss.First;
        strCodDiv := cdsProfiss.fieldbyname('DIV_CODDIV').AsString;
      End;

      If fCfgSis('NUMSER', varBoolean) And Not fCfgSis('DETSER', varBoolean) Then
        strSeriesFornecedor := fBuscaNumerosSeriesConfirmacaoDocumento(arrMatItens);

      pRetDadosCNF_NFE_ITE;

      strValCnfNfeCom := fRetDadosCNF_NFE('C');
      strValCnfNfeFis := fRetDadosCNF_NFE('F');
      Self.strPonImp  := fRetPontoImpressaoDocumento(False);

      If (fCfgSis('ENVOBF', varBoolean)) And (Not fEmptyStr(Self.strCodEmbarcacao))  Then
        If fEmptyStr(strValCnfNfeFis) Then
          strValCnfNfeFis := ' Obs. Embarc.:' + fCampoTabela('EMB_OBSERV', 'CADEMB', ['AUTOINCREM'], [Self.strCodEmbarcacao])
        Else
          strValCnfNfeFis := strValCnfNfeFis + ' Obs. Embarc.:' + fCampoTabela('EMB_OBSERV', 'CADEMB', ['AUTOINCREM'], [Self.strCodEmbarcacao]);

      strCliTel := strCliTelTmp;
      strCodDiv := strCodDivOri;

      If ((Pos(Self.strOpcDoc,'CF_CI_CP_') > 0) And (strCliOrg = 'S') And (strCalIcm = 'N') And (fltNotIcmOrg > 0)) Then
      Begin
        fltBasOrg := 0;
        fltIcmOrg := 0;
      End;
    End;

    If (blnNotEsp Or blnCupEsp) And (Not blnMostrouDigDuplic) Then
    Begin

      For intContCopia := 0 To 23 Do
        arrDuplicOri[intContCopia] := arrDuplicata[intContCopia];

      fDigDuplicSemTela(arrDuplicata, intQtdDup, curTotalRes, strConPag, 123, fltTotGer, False, False, Self.VS_Date, False);

    End;

    valorDuplicParaF11 := TValoresDuplicatas.Create(arrDuplicata, -1);

    {*****************************}
    {* VERIFICA SE ZERA OS PESOS *}
    {**************************PZ*}
    If (fZerarPeso) Then
    Begin
      fltPesLiq := 0.0;
      fltPesBru := 0.0;
    End;

    If Not Self.Fulfillment.EhOperacaoFulfillment Then
      dtaHorEnt := fRetHoraServidor;

    If (FdtaDtEsNf+FtmrHrEsNf > 0) And (FdtaDtEsNf+FtmrHrEsNf < Self.VS_Date+dtaHorEnt) Then
    Begin
      FdtaDtEsNf := Self.VS_Date;
      FtmrHrEsNf := dtaHorEnt;
    End;

    fZeraIrpjPisCofCsl;

    If fDocumentoFiscalJaExiste(strNumDoc, strEspDoc, VS_strCodEmp, IIF(fDocumentoParaFornecedor,'F','C'), strSerFsc, 'V') Then
    Begin
      strMsgCancelamento := 'O documento: '+strNumDoc+'-'+strEspDoc+'-'+VS_strCodEmp+'-'+strSerFsc+' já existe!'+#10+#13 + 
                            'Feche o AutCom e tente emitir o documento novamente e se mesmo assim a mensagem persistir, '+
                            'entre em contato com a Citel para ajustar o sequêncial referente a esse documento!'; 
      Result := False;
    End;

    If (Self.strEspDoc = 'IF') And (fltValFre > 0) Then
    Begin
      fltDesAce := fltDesAce + fltValFre;
      fltValFre := 0;
    End;

    FfltTotIpiEntFut   := 0.00;
    FfltTotRetEntFut   := 0.00;
    FfltTotFcpSTEntFut := 0.00;
    strEntFutDocOri    := IIF(fTemItensEntregaFuturaDocOri(arrMatItens), 'S', 'N');

    {*REQ.144458**********RP*}
    If (strOpcDoc <> 'CF') And (strEntFutDocOri = 'S') And (fCfgSis('ENFUOP') = '2') Then
    Begin
      FfltTotIpiEntFut   := fltTotIpi;
      FfltTotRetEntFut   := fltTotRet;
      FfltTotFcpSTEntFut := fltTotFcpST;

      fltDesAce := fltDesAce + fltTotIpi + fltTotRet + fltTotFcpST;

      fltBasIpi := 0.00;
      fltAlqIpi := 0.00;
      fltTotIpi := 0.00;

      fltBasRet := 0.00;
      fltAlqRet := 0.00;
      fltTotRet := 0.00;

      fltBasFcpST := 0.00;
      fltAlqFcpST := 0.00;
      fltTotFcpST := 0.00;
    End;

    Result := Result And
              fGravaNotGer(strAutInc,                                                  // Auto incremento (Retorno)
                           VS_strCodEmp,                                               // Empresa
                           strNumDoc,                                                  // Documento
                           strEspDoc,                                                  // Especie
                           IIF(fEhConfirmacaoDeDocumentoParaFornecedor, '', strCodCli), // Cliente
                           strCodTra,                                                  // Transportadora
                           strCodVen,                                                  // Vendedor
                           strSerFsc,                                                  // Série
                           IIF(Self.Fulfillment.EhOperacaoFulfillment, dtaDtaEnt, Self.VS_Date),               // Data de Entrada
                           dtaHorEnt,                                                  // Hora de Entrada
                           strConPag,                                                  // Condição de Pagamento
                           strCliEst,                                                  // Estado
                           IIF(fEmptyStr(strCliNom), '', strCliNom),                   // Nome Consumidor
                           strCliEnd,                                                  // Endereço Consumidor
                           strCliBai,                                                  // Bairro Consumidor
                           strCliCep,                                                  // Cep Consumidor
                           strCodCid,                                                  // Cidade Consumidor
                           strCliEst,                                                  // Estado Consumidor
                           strCliTel,                                                  // Telefone Consumidor
                           dtaNasCon,                                                  // Data de nascimento do consumidor
                           IntToStr(intCgcCpf),                                        // CNPJ / CPF Consumidor
                           strCliCgc,                                                  // Número CNPJ Consumidor
                           strCliIes,                                                  // IES Consumidor
                           strCli_Rg,                                                  // Rg
                           fltBasSim,                                                  // Base Simples Paulista
                           fltBasIpi,                                                  // Base IPI
                           fltAlqIpi,                                                  // Alíquota IPI
                           fltTotIpi,                                                  // Total IPI
                           fltBasIcm,                                                  // Base ICMS
                           fltAlqIcm,                                                  // Alíquota ICMS
                           fltTotIcm,                                                  // Total ICMS
                           fltTotRet,                                                  // Total Retido
                           fltAlqRet,                                                  // Alíquota Retido
                           fltBasRet,                                                  // Base Retido
                           fltRet_SP,                                                  // Base Retido Simulado
                           fltDesEsp,                                                  // Desconto Especial
                           fltTotGer,                                                  // Valor Contábil
                           fltTotPro,                                                  // Total Produtos
                           fltTotCus,                                                  // Total de Custo
                           fltTotMed,                                                  // Total Médio
                           IfThen(Not fPermitirFreteNoFaturamento, '9', strTipFre), // Tipo de Frete
                           fltValFre,                                                  // Total de Frete
                           fltPesBru,                                                  // Peso bruto
                           fltPesLiq,                                                  // Peso líquido
                           intQtdTra,                                                  // Volume
                           strEspTra,                                                  // Espécie
                           strMarTra,                                                  // Marca
                           strMen001,                                                  // Mensagem 1
                           strMen002,                                                  // Mensagem 2
                           strMen003,                                                  // Mensagem 3
                           strMen004,                                                  // Mensagem 4
                           strMen005,                                                  // Mensagem 5
                           False,                                                      // Ja Faturado
                           strTipFatFFEsp,                                             // Tipo Faturamento
                           strNumFatFFEsp,                                             // Número Faturamento
                           strEmpFatFFEsp,                                             // Empresa do Faturamento
                           0,                                                          // Data Faturamento
                           '',                                                         // Vendedor do Faturamento
                           '',                                                         // Condição de Pagamento
                           0.0,                                                        // Valor do Faturamento
                           IIF(blnNotEsp Or blnCupEsp, 'S', 'N'),                      // Nota Especial
                           arrDuplicata[00].curValor,                                  // Valor da 01a Parcela
                           arrDuplicata[01].curValor,                                  // Valor da 02a Parcela
                           arrDuplicata[02].curValor,                                  // Valor da 03a Parcela
                           arrDuplicata[03].curValor,                                  // Valor da 04a Parcela
                           arrDuplicata[04].curValor,                                  // Valor da 05a Parcela
                           arrDuplicata[05].curValor,                                  // Valor da 06a Parcela
                           arrDuplicata[06].curValor,                                  // Valor da 07a Parcela
                           arrDuplicata[07].curValor,                                  // Valor da 08a Parcela
                           arrDuplicata[08].curValor,                                  // Valor da 09a Parcela
                           arrDuplicata[09].curValor,                                  // Valor da 10a Parcela
                           arrDuplicata[10].curValor,                                  // Valor da 11a Parcela
                           arrDuplicata[11].curValor,                                  // Valor da 12a Parcela
                           arrDuplicata,                                               // arrDuplic
                           strClaFis,                                                  // Classificação Fiscal
                           strClaFi2,                                                  // Classificação Fiscal 2
                           strClaFi3,                                                  // Classificação Fiscal 3
                           strDesCla,                                                  // Natureza da Operação
                           fltPorDes,                                                  // Percentual de Desconto
                           strCodDig,                                                  // Código do Digitador
                           strCodCnd,                                                  // Código da Condicao
                           strCodFpg,                                                  // Código da Forma de Pagamento
                           fltFatNot,                                                  // Fator Para meia nota
                           FRecSer,
                           fltDesAce,                                                  // Despesa Acessória
                           'V',                                                        // Origem do Documento
                           IIF(fDocumentoParaFornecedor,'F','C'),
                           IIF(fEhConfirmacaoDeDocumentoParaFornecedor, strCodCli, strCodFor),// Código do Fornecedor
                           fltAlqIrf,                                                  // Aliquota do IRPF (SERVIÇO)
                           fltValIrf,                                                  // Valor do IRPF (SERVIÇO + PRODUTO)
                           fltAlqPis,                                                  // Aliquota do Pis (SERVIÇO)
                           fltValPis,                                                  // Valor do Pis (SERVIÇO + PRODUTO)
                           fltAlqCof,                                                  // Aliquota do Cofins (SERVIÇO)
                           fltValCof,                                                  // Valor do Cofins (SERVIÇO + PRODUTO)
                           fltAlqCsl,                                                  // Aliquota do CSLL (SERVIÇO)
                           fltValCsL,                                                  // Valor do CSLL (SERVIÇO + PRODUTO)
                           fltRetIrf,                                                  // Valor de IRPF que foi retido
                           fltRetPis,                                                  // Valor de PIS que foi retido
                           fltRetCof,                                                  // Valor de COFINS que foi retido
                           fltRetCsl,                                                  // Valor de CSLL que foi retido
                           strNotRet,                                                  // Notas de Documentos Acumulados
                           fltAlIrfP,                                                  // Aliquota do IRPF (PRODUTOS)
                           fltAlPisP,                                                  // Aliquota do PIS (PRODUTOS)
                           fltAlCofP,                                                  // Aliquota do COFINS (PRODUTOS)
                           fltAlCslP,                                                  // Aliquota do CSLL (PRODUTOS)
                           fltRetSer,                                                  // Valor de SERVIÇO que foi retido
                           strNoReSe,                                                  // Notas de documentos acumulados (SERVIÇO)
                           fltPeSgSo,                                                  // Percentual da Seguridade Social
                           fltVlSgSo,                                                  // Valor da Seguridade Social
                           fltIrPrRt,                                                  // Valor do IRPF Retido (Produto)
                           fltIrPrDv,                                                  // Valor do IRPF Devido (Produto)
                           fltIrSeRt,                                                  // Valor do IRPF Retido (Serviço)
                           fltIrSeDv,                                                  // Valor do IRPF Devido (Serviço)
                           fltPiPrRt,                                                  // Valor do PIS Retido (Produto)
                           fltPiPrDv,                                                  // Valor do PIS Devido (Produto)
                           fltPiSeRt,                                                  // Valor do PIS Retido (Serviço)
                           fltPiSeDv,                                                  // Valor do PIS Devido (Serviço)
                           fltCoPrRt,                                                  // Valor do COFINS Retido (Produto)
                           fltCoPrDv,                                                  // Valor do COFINS Devido (Produto)
                           fltCoSeRt,                                                  // Valor do COFINS Retido (Serviço)
                           fltCoSeDv,                                                  // Valor do COFINS Devido (Serviço)
                           fltCsPrRt,                                                  // Valor do CSLL Retido (Produto)
                           fltCsPrDv,                                                  // Valor do CSLL Devido (Produto)
                           fltCsSeRt,                                                  // Valor do CSLL Retido (Serviço)
                           fltCsSeDv,                                                  // Valor do CSLL Devido (Serviço)
                           fltDupRec,                                                  // Valor ja recebido na confirmação
                           fltValAdt,                                                  // Valor de adiantamento de cliente
                           IIF(fltNotBasOrg > 0, fltNotBasOrg, fltBasOrg),             // Base Orgão Público
                           IIF(fltNotIcmOrg > 0, fltNotIcmOrg, fltIcmOrg),             // ICMS Orgão Publico
                           intNConhe,                                                  // Número do Conhecimento de Frete
                           strEntFat,                                                  // Entrega no faturamento
                           strCliFatFFEsp,                                             // Cliente de Faturamento
                           strOpeExp,                                                  // Operador da Expedição
                           fltBasRet_Sp,                                               // Base do retido (caso tivesse) com ipi e frete de entrada
                           fltValRet_Sp,                                               // Valor do retido considerando a base acima.
                           strNumReg,                                                  // Numero do Registro - Correios ou transportadora
                           intGrpNot,                                                  // Sequencial para identificação de grupos de notas
                           strClaFi4,                                                  // Classificação fiscal 4
                           strCodEve,                                                  // Evento
                           strAutEnt,                                                  // AUTINC DO ENDEREÇO DE ENTREGA
                           strValCnfNfeCom,                                             // Conteúdo do CNFNFE
                           strCliCon,                                                  // Consumidor Final
                           dtaDtEntr,
                           fltCreNot,
                           FdtaDtEsNf,                                                 // Data de Saida da Nota Fiscal (Eletronica)
                           FtmrHrEsNf,                                                 // Hora de Saida da Nota Fiscal (Eletronica)
                           objFinanc,                                                  // Codigo da Financeira
                           intIpDpConfCi,                                              // Imprime Duplicatas Confirmidas em Cupom Fiscal
                           strCodObr,
                           strCodArt,
                           strRetIss,                                                  // Retem ISS
                           IfThen(fEmptyStr(strOpcDocTrue), strOpcDoc, strOpcDoc),    // opcdoc, opcdoctrue - variaveis de ratreio
                           0,
                           0,
                           strEntUrg,                                                  // Urgencia na entrega
                           fltDeDVCf,                                                 // Desconto de devolução na Confirmação
                           fltImpPag,
                           strChaveNFeRefDevolucao,
                           strNumCOONFeRefDevolucao,
                           strNumSerNFeRefDevolucao,
                           strNumUSUNFeRefDevolucao,
                           strTipDocNfeRefDevolucao,
                           fltTotDif,
                           objFazenda,
                           fltFedImp,
                           fltEstImp,
                           fltMunImp,
                           fltTroco_,
                           strValCnfNfeFis,
                           strCliEma,
                           IfThen(blnComVal, 'S', 'N'),
                           strPlaVei,
                           strKm_Vei,
                           IfThen(blnVendaPresencial, 'S', 'N'),
                           strNumera,
                           IfThen((strEdiPes = 'E') Or (strEdiPesGer = 'S'), 'S', 'N'),
                           fltVrdIcm,
                           fltBasVrd,
                           blnImpPafEcf,
                           strCodEmbarcacao,
                           strNotPau,
                           Self.fltTotProBri,
                           strCliCtt,
                           '',
                           strPlaFat,
                           IIF(strEntFutDocOri = 'S', fCfgSis('ENFUOP'), ''),
                           FfltTotIpiEntFut,
                           FfltTotRetEntFut,
                           FfltTotFcpSTEntFut,
                           '',
                           strNumeroDrawback,
                           fltFreCot,
                           blnRegimeEspecialPorEmpresaComFaturamentoDuplo,
                           FAutIcv,
                           strNumDocAbastecimento,
                           strEspDocAbastecimento,
                           strCodEmpAbastecimento,
                           strCliCEO,
                           intQtdTraSepExc,
                           intQtdTraSepNExc,
                           strCodPrj,
                           fRetornaEstadoDaAbreviacaoFiscal,
                           strCliCel,
                           strVchCdp,
                           strCodCno,
                           Self.fltTotIBS,
                           Self.fltTotCBS,
                           Self.fltTotIS,
                           0,
                           0,
                           strInsImo,
                           strCodCib
                           );

    If Result And (strNotImp = 'S') then
      If Assigned(procGravaDI) then
         procGravaDI(strAutInc);
    if (Result) and (Self.objDadosCte.blnGrava) then
    begin
      Self.objDadosCte.strSeqGer := strAutInc;
      Result := Self.objDadosCte.fGravaNotCte;
    end;

    If (blnNotEsp Or blnCupEsp) And (Not blnMostrouDigDuplic) Then
    Begin

      For intContCopia := 0 To 23 Do
        arrDuplicata[intContCopia] := arrDuplicOri[intContCopia];

    End;

    if (Result) and (strEspDoc = 'IF') and (fUsaSat) and (fGravarSessaoSat) then
    begin
      TGravaSatSes.New
        .GravaSatSes(
          TSatSes.New
            .NumDoc(strNumDoc)
            .EspDoc(strEspDoc)
            .CodEmp(VS_strCodEmp)
            .CodCli(strCodCli)
            .Serie(strSerFsc)
            .Sessao(fGeraNumeroSessao)
        );
    end;

    if (Result) then
      FAuditFaturamento.Adicionar(strAutInc, 'NOTGER');

    If Not blnImportacaoSpedPisCofins Then
      Result := Result And fGMovRes(strAutInc, 'NOTGER');

    If (Result) Then
      If (DigImp.blnOperadorDigitouImpostos) Then
        Result := DigImp.fGravarNOTIMP(strAutInc);

    If (Result) And (blnMeiaNota) Then
    Begin
      If Assigned(FarrDocMeiaNota) Then
      Begin
        For intCnt := 0 to Length(FarrDocMeiaNota)-1 Do
        Begin
          If not fGravarConfirmacaoMeiaNota(strAutInc,
                                            FarrDocMeiaNota[intCnt].strNumDoc,
                                            FarrDocMeiaNota[intCnt].strEspDoc,
                                            FarrDocMeiaNota[intCnt].strEmpDoc) Then
          Begin
            Result := False;
            Break;
		      End
        End;
      End
      Else If (not fEmptyStr(strNumFatFFEsp)) Then
         Result := fGravarConfirmacaoMeiaNota(strAutInc,
                                              strNumFatFFEsp,
                                              strTipFatFFEsp,
                                              strEmpFatFFEsp);
    End;

    If Result And (Pos(Self.strOpcDoc, 'NE_CA_') > 0) And recInconsistenciaEFD.blnGravar Then
    Begin
      Result := fGravaIncEfd(strAutInc,
                             recInconsistenciaEFD.strRefNfe,
                             recInconsistenciaEFD.strInfAdc,
                             recInconsistenciaEFD.strIdenti,
                             recInconsistenciaEFD.strPeriod);
    End;

    If Result Then
    Begin
      If Pos(strClaFis, VS_strClaVen) > 0 Then
        blnAlteraCliente := True;
    End;

    If fCfgSis('CDTCLV', varBoolean) Then
    Begin
      If Result And
         (Pos(strEspDoc, 'PD_FF_IF_NF_') > 0) Then
      Begin
        pGravarVinculacaoDocumentoComodatoCilindroVasilhameNotGer(strAutInc, strEspDoc);

        If (fExisteCilindroVasilhameFaturamento) Then
          FAutIcv := strAutInc;
      End;
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGNotGer]');
    End;
  End;

End;

function TFatVenda.fGOrdSer: Boolean;
begin
  Result := True;

  If (Not fCfgSis('OSPDVN', varBoolean)) Then Exit;

  Result := objOrdSer.fSalvarDados(strNumDoc, strEspDoc, strNumOrc, strEspOrc, strCodCli);
end;

function TFatVenda.fGOrdSerOrc: Boolean;
