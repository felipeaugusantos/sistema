  end;

  function fComparaValor(fltValor1, fltValor2: Double): Boolean;
  begin
    Result := fFormataFloat(fltValor1, 5) = fFormataFloat(fltValor2, 5);
  end;

  function fComparaMetragem(DataSet1, DataSet2: TDataSet): Boolean;
  begin
    Result := fComparaValor(DataSet1.FieldByName('DET_COMPEC').AsFloat, DataSet2.FieldByName('DET_COMPEC').AsFloat) And
              fComparaValor(DataSet1.FieldByName('DET_LARPEC').AsFloat, DataSet2.FieldByName('DET_LARPEC').AsFloat) And
              fComparaValor(DataSet1.FieldByName('DET_ESPPEC').AsFloat, DataSet2.FieldByName('DET_ESPPEC').AsFloat);
  end;

  function fGetFiltroEhConfirmacaoEmNotaEspecial: String;
  begin
    Result := '';
    Result := Result + ' ( SELECT ';
    Result := Result + '     COUNT(*) ';
    Result := Result + '   FROM ';
    Result := Result + '     NOTGER NG ';
    Result := Result + '   WHERE ';
    Result := Result + '     NG.GER_NUMDOC = DET_NUMFAT AND ';
    Result := Result + '     NG.GER_ESPDOC = DET_TIPFAT AND ';
    Result := Result + '     NG.GER_CODEMP = DET_EMPFAT AND ';
    Result := Result + '     NG.GER_TIP_FC = DET_TIP_FC AND ';
    Result := Result + '     NG.GER_NOTESP = "S" ) > 0 ';
  end;

  function fDevolucaoParcial(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
    Var
      qryDev: TUniQuery;
      strSQL: String;
  begin

    qryDev := fCriaQuery;
    Try
      With qryDev, SQL Do
      Begin
        Add('SELECT');
        Add('  DET_NUMDOC');
        Add('FROM');
        Add('  MOVDET ');
        Add('WHERE');
        Add('  DET_DOCDEV = :NUMDOC AND');
        Add('  DET_ESPDEV = :ESPDOC AND');
        Add('  DET_EMPDEV = :CODEMP');

        strSQL := Text;

        Add('UNION ALL');
        Add(AnsiReplaceStr(strSQL, 'MOVDET', 'NOTDET'));

        strSQL := Text;

        Clear;
        Add('SELECT');
        Add('  COUNT(1)');
        Add('FROM');
        Add('  (' + strSQL +') TAB');

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;

        Open;

        Result := Fields[0].AsInteger > 0;
      End;
    Finally
      FreeAndNil(qryDev);
    End;
  end;

  function fEhBaixaEntFutAndDocOriginalFoiConfirmado(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
    Var
      qryTmp: TUniQuery;
      strSQL: String;
  Begin
    Result := False;

    If fEmptyStr(strNumDoc) Then
      Exit;

    Try
      qryTmp := fCriaQuery(Self);

      strSQL := '';
      strSQL := strSQL + ' SELECT ';
      strSQL := strSQL + '   GER_JAFATU ';
      strSQL := strSQL + ' FROM ';
      strSQL := strSQL + '   MOVGER ';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '   GER_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '   GER_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '   GER_CODEMP = :EMPDOC ';

      With qryTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('EMPDOC').AsString := strCodEmp;
        Open;

        If Not IsEmpty Then
        Begin
          If FieldByName('GER_JAFATU').DataType = ftInteger Then
            Result := FieldByName('GER_JAFATU').AsInteger = 1
          Else
            Result := FieldByName('GER_JAFATU').AsBoolean;
        End;
      End;

      FreeAndNil(qryTmp);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fEhBaixaEntFutAndDocOriginalFoiConfirmado]');
        FreeAndNil(qryTmp);
      End;
    End;
  End;

  function fRetornaQuantidadeDevolvidaEmGarantia(strAutDet : String): Double;
  Var
    qryQuery : TUniQuery;
  Begin
    Result := 0;
    qryQuery := fCriaQuery;
    Try
      qryQuery.Close;
      qryQuery.SQL.Clear;
      qryQuery.SQL.Add(' SELECT   ');
      qryQuery.SQL.Add('   SUM(IFNULL(GAD_QTDREQ, 0) - IF(LOCATE(GAD_SCREDI, "1_2_"), 0, IFNULL(GAD_QTDDEV, 0))) AS QTDITE');
      qryQuery.SQL.Add(' FROM MOVGAD                                 ');
      qryQuery.SQL.Add(' WHERE GAD_SEQDOC = :SEQDET                  ');

      qryQuery.ParamByName('SEQDET').AsString := strAutDet;

      qryQuery.Open;

      if not qryQuery.IsEmpty then
        Result := qryQuery.FieldByName('QTDITE').AsFloat;

      qryQuery.Close;
    Finally
      FreeAndNil(qryQuery);
    End;
  End;

  function fRetornaQuantidadeDisponivelParaDevolucaoDoDocumentoEntregaFutura(strAutIncDocAtu, strAutIncDocFut, strCodIte, strEspDoc, strEntFut: String): Double;
    Var
      qryTmp: TUniQuery;
  Begin
    Result := 0;

    If (fCfgSis('HEFCOE', varString) = 'S') Then
      If (fEmptyStr(strAutIncDocFut)) And (strEspDoc = 'IF') And (strEntFut = 'S') Then
        strAutIncDocFut := strAutIncDocAtu;

    qryTmp := fCriaQuery;
    Try
      With qryTmp.SQL Do
      Begin
        Add('SELECT SUM(QTDDIS) AS QTDDIS FROM (                                            ');
        //SOMA TODAS EVENTUAIS BAIXAS DE ENTREGA FUTURA
        Add('       SELECT IFNULL(SUM(IFNULL(DET_QTDITE, 0)), 0) AS QTDDIS                  ');
        Add('              FROM MOVDET D INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER ');
        Add('        WHERE T.DET_INCFUT = :INCFUT                                           ');
        Add('          AND D.DET_CODITE = :CODITE                                           ');
        Add('          AND (LOCATE(RIGHT(D.DET_CLAFIS, 3), '+CLAFIS_ENTFUT_VEN_ABR+') > 0)  ');
        Add('          AND D.DET_PROEMB = "N"                                               ');
        Add(' UNION ALL                                                                     ');
        //SUBT TODAS EVENTUAIS DEVOLUÇÕES DAS BAIXAS DE ENTREGA FUTURA
        Add('       SELECT IFNULL(SUM(IFNULL(DET_QTDITE, 0)), 0) * (-1) AS QTDDIS           ');
        Add('         FROM MOVDET D INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER      ');
        Add('        WHERE T.DET_INCDEV IN (SELECT E.AUTOINCREM                             ');
        Add('                                 FROM MOVDET E INNER JOIN MOVTRI F ON E.AUTOINCREM = F.DET_SEQGER ');
        Add('                                WHERE F.DET_INCFUT = :INCFUT                   ');
        Add('                                  AND E.DET_CODITE = :CODITE                   ');
        Add('                                  AND (LOCATE(RIGHT(E.DET_CLAFIS, 3), '+CLAFIS_ENTFUT_VEN_ABR+') > 0) ');
        Add('                                  AND D.DET_PROEMB = "N")                      ');
        Add(' UNION ALL                                                                     ');
        //SUBT TODAS EVENTUAIS DEVOLUÇÕES DO PRÓPRIO QUE ESTA SENDO DEVOLVIDO
        Add('       SELECT IFNULL(SUM(IFNULL(DET_QTDITE, 0)), 0) * (-1) AS QTDDIS           ');
        Add('         FROM MOVDET D INNER JOIN MOVTRI T ON D.AUTOINCREM = T.DET_SEQGER      ');
        Add('        WHERE T.DET_INCDEV = :INCDOC                                           ');
        Add('          AND D.DET_CODITE = :CODITE                                           ');
        Add('          AND D.DET_PROEMB = "N"                                               ');
        Add(') AS VW_QTDDIS                                                                 ');
      End;

      qryTmp.ParamByName('INCDOC').AsString := strAutIncDocAtu;
      qryTmp.ParamByName('INCFUT').AsString := strAutIncDocFut;
      qryTmp.ParamByName('CODITE').AsString := strCodIte;

      qryTmp.Open;

      If (Not qryTmp.IsEmpty) Then
        Result := qryTmp.Fields[0].AsFloat;
    Finally
      FreeAndNil(qryTmp)
    End;
  End;

  function fConsultaQuantidadeDisponivelParaDevolucaoDoDocumentoEntregaFutura(strSeqOri, strEspDoc, strEntFut: String): Boolean;
  begin
    Result := False;

    If (Length(strSeqOri) = 20) Or
       ((strEspDoc = 'IF') And (strEntFut = 'S') And (fCfgSis('HEFCOE', varString) = 'S')) Then
    Begin
      If (Length(strSeqOri) = 20) Then
        Result := (fCampoTabela('DET_ENTFUT', 'MOVDET', ['AUTOINCREM'], [strSeqOri]) = 'S')
      Else
        Result := True;
    End;
  end;

  function fPermiteDevolucaoOutrasLojas: Boolean;
  begin
    Result := True;

    If (strOpcDoc = 'PR') Then
    Begin
      If (blnDevRetiradaCfgDVPDOLAtiva) Then
        Exit;
    End
    Else
    Begin
      If (fCfgSis('DVOULJ', varString) = 'S') Then
        Exit;

      If (fCfgSis('DVOULJ', varString) = 'B') And
         (fEhMesmaBaseCNPJ(VS_strCodEmp, strEmpDocDev)) Then
        Exit;
    End;

    Result := False;
  end;

begin
  pInformacao('Aguarde, Carregando itens para devolução ...', pgbStatus);
  pProgresso(0, 0, pgbStatus);

  blnDevolucaoParcialAnterior := False;
  blnDevRetiradaCfgDVPDOLAtiva := fCfgSis('DVPDOL', varBoolean) And SameText(strOpcDoc, 'PR');

  qryGenDet := fCriaQuery(Self);
  qryGenNot := fCriaQuery(Self);

  qryGenDet.Options.SetFieldsReadOnly := False;
  qryGenNot.Options.SetFieldsReadOnly := False;

  cdsGenSin := TUniClientDataSet.Create(Self);

  With cdsGenSin.FieldDefs.AddFieldDef Do
  Begin
    Name := 'DET_CODEMP';
    DataType := ftString;
    Size := 003;
    Required := False;
  End;

  With cdsGenSin.FieldDefs.AddFieldDef Do
  Begin
    Name := 'DET_NUMDOC';
    DataType := ftString;
    Size := 012;
    Required := False;
  End;

  With cdsGenSin.FieldDefs.AddFieldDef Do
  Begin
    Name := 'DET_ESPDOC';
    DataType := ftString;
    Size := 002;
    Required := False;
  End;

  With cdsGenSin.FieldDefs.AddFieldDef Do
  Begin
    Name := 'AUX_OPCDOC';
    DataType := ftString;
    Size := 002;
    Required := False;
  End;

  cdsGenSin.CreateDataSet;
  cdsGenSin.LogChanges := False;

  cdsGenNot := TUniClientDataSet.Create(Self);
  dspGenNot := TUniDataSetProvider.Create(Self);

  cdsGenDet := nil;

  intAutInc := 1;

  FblnCSTCEQ := fCfgSis('CSTCEQ', varBoolean);
  FblnPedidoOS := False;

  {*****************************************}
  { LIMPA A TAB.TEMP DOS ITENS DE DEVOLUCAO }
  {**************************************JB*}
  With qryTemporaria Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('DELETE FROM ' + Self.strTmpIteDev);
    ExecSQL;

    Close;
    SQL.Clear;
    SQL.Add('SELECT * FROM ' + Self.strTmpIteDev);
    Open;
  End;

  If Pos(strOpcDoc,'DV_PR_') > 0 Then
  Begin

    strSQLDet := '';

    strSQLDet := strSQLDet + 'SELECT ';
    strSQLDet := strSQLDet + '  "  " AS AUX_OPCDOC, ';
    strSQLDet := strSQLDet + '  "C" AS DET_TIP_FC, ';
    strSQLDet := strSQLDet + '  FDO_CLAFIS AS DET_CLAFIS, ';
    strSQLDet := strSQLDet + '  FDO_INCDEV AS DET_INCDEV, ';
    strSQLDet := strSQLDet + '  FDO_DOCDEV AS DET_DOCDEV, ';
    strSQLDet := strSQLDet + '  FDO_CODITE AS DET_CODITE, ';
    strSQLDet := strSQLDet + '  FDO_DESCRI AS DET_DESCRI, ';
    strSQLDet := strSQLDet + '  FDO_CODACA AS DET_CODACA, ';
    strSQLDet := strSQLDet + '  FDO_PROACA AS DET_PROACA, ';
    strSQLDet := strSQLDet + '  FDO_EMPACA AS DET_EMPACA, ';

    {************************************************}
    {* CAMPO UTILIZADO PARA COMPARAÇÃO NA DEVOLUÇÃO *}
    {*********************************************RV*}
    strSQLDet := strSQLDet + '  ROUND(IF(FDO_DESESP > 0, ((FDO_TOTITE - FDO_DESESP) / FDO_QTDITE), FDO_UNITAR), ' + fCfgSis('DECUNI') + ') AS DET_COMPAR, ';
    strSQLDet := strSQLDet + '  FDO_UNITAR AS DET_UNITAR, ';
    strSQLDet := strSQLDet + '  FDO_QTDITE AS DET_QTDITE, ';
    strSQLDet := strSQLDet + '  FDO_QTDITE AS DET_QTDORI, ';

    If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
    Begin
      strSQLDet := strSQLDet + '  FDO_COMPEC AS DET_COMPEC, ';
      strSQLDet := strSQLDet + '  FDO_LARPEC AS DET_LARPEC, ';
      strSQLDet := strSQLDet + '  FDO_ESPPEC AS DET_ESPPEC, ';
    End;

    strSQLDet := strSQLDet + '  FDO_VDESST AS DET_VDESST, ';
    strSQLDet := strSQLDet + '  FDO_MDESST AS DET_MDESST, ';

    strSQLDet := strSQLDet + '  FDO_CODVEN AS DET_CODVEN,  ';
    strSQLDet := strSQLDet + '  FDO_CODVE2 AS DET_CODVE2,  ';
    strSQLDet := strSQLDet + '  "            " AS DET_DOCFUT, ';
    strSQLDet := strSQLDet + '  "  "     AS DET_ESPFUT, ';
    strSQLDet := strSQLDet + '  "   "    AS DET_EMPFUT, ';
    strSQLDet := strSQLDet + '  0.00 AS DET_BFCPST, ';
    strSQLDet := strSQLDet + '  0.00 AS DET_PFCPST, ';
    strSQLDet := strSQLDet + '  0.00 AS DET_VFCPST, ';
