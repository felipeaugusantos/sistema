                                       strMotFut: String = '';
                                       fltDesMSu: Double = 0.00;
                                       strBarEmb: String = '';
                                       fltPrecoSubItemEstrutura: Double = 0;
                                       stlIteLib: TStringList = Nil;
                                       blnProAcaIte: Boolean = False;
                                       blnIteCom : Boolean = False;
                                       strOpcao : String = '1';
                                       fltVolPro: Double = 0;
                                       blnTelaMargem : Boolean = False;
                                       cdsIteTin: TUniClientDataSet = Nil): Boolean;
    Var
    fltUnitarTmp : Double;
    fltUniAntTmp : Double;
    fltUniLiqTmp : Double;
    fltUniTraPro : Double;
    fltUniTabela : Double;
    fltMarPra    : Double;
    cdsCadIte    : TUniClientDataset;
    cdsVendaTmp  : TUniClientDataset;
    intDecUni    : Integer;
    itemCalcMar: TItemCalcMargem;
    objLiberacao : TLiberacao;
    blnEmCamp: Boolean;
    strPromocSav,
    strCodSit,
    strCodAbf : String;

    fltImcSTPV  : Double;
    blnCalcST   : Boolean;
    fltIcmSaiTmp: Double;
    fltImpFedTmp: Double;
    fltDesOpeTmp: Double;
    fltComTblTmp: Double;
    fltAlqDifalTmp : Double;
    fltAlqFCPTmp   : Double;
    fltPreCusTmp   : Double;
    strFilter      : String;
    fltOutValTmp   : Double;
    impSubIteEst   : TImpostosSubItensEstrutura;
    cpcParams: TParCalculaPrecoCusto;
    arrMatItensCom : TMatrizFechamento;
    fltComLiq,
    fltVlrCam: Double;

  function fGetComissaoTabelaItem: Double;
  begin
    Result := fCampoTabela('ITE_COMTB' + IIF(fEmptyStr(strTabPreIte), strTabPre,strTabPreIte),
                           'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, VS_StrCodEmp], False);
  End;

  function fUsaValoresItem: Boolean;
  begin
    If strOpcDoc = 'DV' Then
      Result := False
    Else
      Result := (Self.strIdePro = 'NOR') and (not blnProAcaIte) And
                (Not fEhItemVendaVidro(strCodIte));
  end;

Begin

  Result := True;

  If Not fExecutarValidacaoMargemCondPagto_ItemAItem(strCodIte, fGetEmpPrecoPromoItem(strEmpresaItem)) Then
    Exit;

  If (strIdePro <> 'NOR') And (Not fEmptyStr(strIdePro)) Then
    strTabPreIte := fTabelaPrecoTinta(Self.strCodCli, strOpcDoc, strTabPreIte, False, False, False);

  If Assigned(recInfoTravaUnitario) Then
    FreeAndNil(recInfoTravaUnitario);

  recInfoTravaUnitario := TInfoTravaUnitario.Create;

  If (Pos(strOpcDoc,'DV_') > 0) Then
    intDecUni := fMaxDecUni
  Else
    intDecUni := VS_intDecUni;

  fltUniAntTmp := fFormataFloat(fltUnitar, intDecUni);
  fltUnitarTmp := fltUniAntTmp;
  fltUniLiqTmp := fltUniAntTmp;

  With recInfoTravaUnitario Do
  Begin
    strOpcTrvUnit := '';
    strLibUniComSenha := 'N';
    fltUniLiqCal := fltUniLiqTmp;
    fltMargMin := 0;
    fltMargPra := 0;
  End;

  objLiberacao := TLiberacao.Create;
  try
    try
      If (Not blnCliFil) And (Pos(strOpcDoc, 'BR_TE_OE_EF_CF_CI_UC_') <= 0) And (Not blnComVal) And (strBrinde <> 'S') Then
      Begin
        fltUniLiqTmp := fltUnitarTmp;

        If fPermiteAplicarJurosNaPromocao(strPromocIte) Then
        Begin
          If fAplicarTaxaJurosPrecoDigitado And fAplicaTaxaJuros Then
          Begin
            Self.fltTaxJur := Self.fGetTaxVprItem(strCodIte, strEmpresaItem);
            fltUniLiqTmp   := fltUniLiqTmp + (fltUniLiqTmp * Self.fltTaxJur / 100.0);
            fltUniLiqTmp   := fFormataFloat(fltUniLiqTmp, VS_intDecUni);
          End;
        End;

        fltUniLiqTmp := fltUniLiqTmp - fRetornaVrDesconto(2, fltUniLiqTmp, fltDesCon);
        fltUniLiqTmp := fFormataFloat(fltUniLiqTmp, fMaxDecUni);

        {CALCULANDO O CUSTO DE ITENS ESPECIAIS}
        If (Not fCfgSis('CUSESP', varBoolean))                                      And
           (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0) And
           (not blnTelaMargem) And (strIdeProIte = 'NOR')  Then
        Begin
          Try
            cpcParams := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);
            fltPreCusTmp := fRetornaPrecoCusto(Preco_de_Custo,
                                               qryConIte.FieldByName('ITE_CODITE').AsString,
                                               strEmpresaItem,
                                               cpcParams.fCalculaPrecoCusto(fltUniLiqTmp, fCfgSis('MMIIES', varDouble)),
                                               '',
                                               Nil,
                                               True);
          Finally
            FreeAndNil(cpcParams);
          End;
        End
        Else
          fltPreCusTmp := fltCusIte;

        {CALCULO DE JUROS NO PRECO DE CUSTO}
        If (not blnTelaMargem) Then
        Begin
          If (fCfgSis('JURCUS', varBoolean))  Then
            fltPreCusTmp := fltPreCusTmp * (1 + Self.fltTaxJur / 100);
        End;

        If (TMargemMinima.UsaPrecoMedio) Then
          fltPreCusTmp := fltPreMed;

        If (Not cdsVenda.IsEmpty) And (cdsVenda.FieldByName('ITE_CODITE').AsString = dtsDadIte.FieldByName('ITE_CODITE').AsString) Then
          cdsCadIte := cdsVenda
        Else
          cdsCadIte := fCriaClientDataset(qryConIte.SQL.Text);

        strCodAbf := fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpresaItem));
        strCodSit := '';

        If (Not fEmptyStr(Self.GetTipAbf(strEmpresaItem))) And (fBuscaAbfIcm(strCodIte, strEmpresaItem, strCodAbf, fTrocaUFEndEntrega)) Then
          strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpresaItem)).AsString;

        fltComLiq := 0;
        If (blnEmCampanha) And
           (fCfgSis('MARMKP') = '4') Then
        Begin
          objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                       strCodIte,
                                                       EmptyStr,
                                                       EmptyStr,
                                                       0,
                                                       fltVlrCam,
                                                       strCodCmg,
                                                       fltComLiq);
        End;

        objIcStPv.pAdd(strCodIte,
                       fGetEmpCalculoItem(strEmpresaItem),
                       Self.GetTipAbf(strEmpresaItem),
                       Self.fUFDestTrib(strEmpresaItem),
                       strCodSit,
                       fltImcSTPV,
                       blnCalcST,
                       0,
                       fltComLiq);

        fltIcmSaiTmp    := 0;
        fltImpFedTmp    := 0;
        fltDesOpeTmp    := 0;
        fltComTblTmp    := 0;
        fltAlqDifalTmp  := 0;
        fltAlqFCPTmp    := 0;
        fltOutValTmp    := 0;

        {IMPOSTOS , OUTROS VALORES E DESPESAS SÓ ENTRAM QUANDO O CALCULO DA MARGEM É POR CUSTO REAL}
        If (TMargemMinima.UsaPrecoLiquido) Then
        Begin
          If (Pos(strOpcDoc, 'DV_PR_DD_') <= 0) And (Not Self.fEhDevolucaoEspelhoOuParaFornecedor) And (not blnTelaMargem) Then
          Begin
            If Self.fUtilizaPrecoSubItensEstrutura(Pos('ITEM ESPECIAL', strDesIte) > 0,qryConIte.FieldByName('ITE_CODITE').AsString) Then
            Begin
              impSubIteEst.strCodIte := qryConIte.FieldByName('ITE_CODITE').AsString;
              impSubIteEst.strEmpIte := strEmpresaItem;
              impSubIteEst.fltUniPai := fltUnitar;
              impSubIteEst.fltQtdPai := fltQtdIte;

              Self.pRetImpostosSubItensEstrutura(impSubIteEst);

              fltOutValTmp := impSubIteEst.fltOutVal;
              fltDesOpeTmp := impSubIteEst.fltDesOpe;
              fltImpFedTmp := impSubIteEst.fltImpFed;
              fltIcmSaiTmp := impSubIteEst.fltIcmSai;
            End
            Else
            Begin

              pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                   IIF(Self.blnPraticarPrecosEmpresaFaturamento, fGetEmpCalculoItem(strEmpresaItem), qryConIte.FieldByName('ITE_CODEMP').AsString),
                                   IIF(strTabPre.IsEmpty, Self.strTabPre, strTabPre));

              {Produto Acabado}
              If blnProAcaIte Then
              Begin
                fltOutValTmp := Self.fltOutVal;
                fltDesOpeTmp := Self.fltDesOpe;
                fltImpFedTmp := Self.fltImpFed;
                fltIcmSaiTmp := Self.fltIcmSai;
              End
              Else
              Begin
                If (strIdeProIte = 'NOR') Then
                  fltOutValTmp := IIF(fUsaValoresItem, fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat), Self.fltOutVal)
                Else
                  fltOutValTmp := fRetOutVal(qryConIte.FieldByName('ITE_OUTVAL').AsFloat);

                fltDesOpeTmp := IIF((fUsaValoresItem) And (not blnTelaMargem), fRetDesOpe(qryConIte.FieldByName('ITE_DESOPE').AsFloat), Self.fltDesOpe);
                fltImpFedTmp := IIF((fUsaValoresItem) And (not blnTelaMargem), fRetImpFed(qryConIte.FieldByName('ITE_IMPFED').AsFloat), Self.fltImpFed);
                fltIcmSaiTmp := IIF((fUsaValoresItem) And (not blnTelaMargem), IIF(fCfgSis('IMPCF4') = 'S', Self.fCalculaAliquota(qryConCit.FieldByName('ITE_CODITE').AsString,
                                                                                                                                  IIF(Self.blnPraticarPrecosEmpresaFaturamento, fGetEmpCalculoItem(strEmpresaItem), qryConIte.FieldByName('ITE_CODEMP').AsString),
                                                                                                                                  GetImpDir(qryConIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem)),
                                                                                                                                  fRetIcmSai(qryConIte.FieldByName('ITE_ICMSAI').AsFloat)),
                                                                                                                                  Self.fltIcmSai);
              End;
              fltComTblTmp := fGetComissaoTabelaItem;
            End
          End
          Else
          Begin
            fltOutValTmp := IIF(not blnAlteracao, Self.fltOutVal, cdsCadIte.FieldByName('ITE_OUTVAL').AsFloat);
            fltIcmSaiTmp := IIF(not blnAlteracao, Self.fltIcmSai, cdsCadIte.FieldByName('ITE_ICMSAI').AsFloat);
            fltImpFedTmp := IIF(not blnAlteracao, Self.fltImpFed, cdsCadIte.FieldByName('ITE_IMPFED').AsFloat);
            fltDesOpeTmp := IIF(not blnAlteracao, Self.fltDesOpe, cdsCadIte.FieldByName('ITE_DESOPE').AsFloat);
            fltComTblTmp := fGetComissaoTabelaItem;
          End;
          (************************************************************************)
          (* NAO VAI MAIS MOSTRAR A MARGEM CALCULADA COM O PERCENTUAL DE COMISSAO *)
          (* APENAS PARA QUANDO PCMPRO <> 3 - QUANDO UTILIZA O CAMPO PARA         *)
          (* COMISSAO OU NÃO UTILIZA O CAMPO (KM)                                 *)
          (*********************************************************************LA*)
          If fCfgSis('PCMPRO') <> '3' Then
            fltComTblTmp := 0;

          If (strIdeProIte = 'NOR') Then
          Begin
            fltAlqDifalTmp := fGetAlqDifal(qryConIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, strCodSit);

            fltAlqFCPTmp := fGetAlqFcpIcms(qryConIte.FieldByName('ITE_CODITE').AsString,
                                           strEmpresaItem,
                                           strCodAbf,
                                           strCodSit,
                                           fltIcmSaiTmp,
                                           fltUniLiqTmp);

          End;

          {CALCULA COMISSAO E APLICA EM OUTROS VALORES
          * NA TELA DE MARGEM ELE USA OS VALORES JÁ CALCULADOS
          * ITENS PROMOCIONAIS NÃO RECEBEM VALOR DE COMISSAO - KM}
          If  (fConsiderarComissaoNoCalculoCustoRealMargem) And (not blnTelaMargem) And (strPromocIte = 'N') then
          Begin
            {CRIANDO A ESTRUTURA DO CDSVENDAS}
            Try
              cdsVendaTmp := fCriaClientDatset(cdsVenda, True);
              cdsVendaTmp.Append;
              cdsVendaTmp.FieldByName('ITE_EMPITE').AsString  := strEmpresaItem;
              cdsVendaTmp.FieldByName('ITE_CODITE').AsString  := strCodIte;
              cdsVendaTmp.FieldByName('ITE_DESITE') .AsString := strDesIte;
              cdsVendaTmp.FieldByName('ITE_IMPDIR').AsString  := GetImpDir(strCodIte, strEmpresaItem);
              cdsVendaTmp.FieldByName('ITE_IDEPRO').AsString  := strIdeProIte;
              cdsVendaTmp.FieldByName('ITE_PROMOC').AsString  := strPromocIte;
              cdsVendaTmp.FieldByName('ITE_TABPRE').AsString  := IIF(fEmptyStr(strTabPreIte), strTabPre,strTabPreIte);
              If (cdsVendaTmp.FindField('ABF_CODABF') <> Nil) Then
                cdsVendaTmp.FieldByName('ABF_CODABF').AsString  := strCodAbf;

              cdsVendaTmp.FieldByName('ITE_SIGUNI').AsString := fRetSiglaUnidadePorCodIte(strCodIte);
              cdsVendaTmp.FieldByName('ITE_DESMAR').AsString := fRetNomMarcaItem(strCodIte);

              cdsVendaTmp.FieldByName('ITE_QTDITE').AsFloat  := fltQtdIte;
              cdsVendaTmp.FieldByName('ITE_CUSITE').AsFloat  := fltCusIte;
              cdsVendaTmp.FieldByName('ITE_UNITAR').AsFloat  := fltUniLiqTmp;
              cdsVendaTmp.FieldByName('ITE_TOTITE').AsFloat  := fFormataFloat(fltUniLiqTmp * fltQtdIte, 2);
              cdsVendaTmp.FieldByName('ITE_UNIORI').AsFloat  := fltUniOri;
              cdsVendaTmp.FieldByName('ITE_COMTBL').AsFloat  := fGetComissaoTabelaItem;;
              cdsVendaTmp.FieldByName('ITE_PRECUS').AsFloat  := fltPreCusTmp;

              //Tinta de Maquina quando inserindo
              If (strIdeProIte <> 'NOR') Then
              Begin
                cdsVendaTmp.FieldByName('ITE_PREMED').AsFloat  := Self.fltPreMed;
                cdsVendaTmp.FieldByName('ITE_IMPULT').AsFloat  := Self.fltImpUlt;
              End
              Else
              Begin
                cdsVendaTmp.FieldByName('ITE_PREMED').AsFloat  := fltPreMed;
                cdsVendaTmp.FieldByName('ITE_IMPULT').AsFloat  := fltImpUlt;
              End;
              cdsVendaTmp.FieldByName('ITE_IMPFED').AsFloat  := fltImpFedTmp;
              cdsVendaTmp.FieldByName('ITE_OUTVAL').AsFloat  := fltOutValTmp;
              cdsVendaTmp.FieldByName('ITE_DESOPE').AsFloat  := fltDesOpeTmp;
              cdsVendaTmp.FieldByName('ITE_ICMSAI').AsFloat  := fltIcmSaiTmp;
              cdsVendaTmp.FieldByName('ITE_TAXJUR').AsFloat  := Self.fltTaxJur;
              cdsVendaTmp.Post;

              {APLICANDO A COMISSÃO EM OUTROS VALORES}
              arrMatItensCom := fRecalculaComissao(cdsVendaTmp);
              fltOutValTmp   := fFormataFloat(fltOutValTmp + IIF(fltQtdIte <> 0,(arrMatItensCom[0].fltTotCom / fltQtdIte),0),2);
            Finally
              FreeAndNil(cdsVendaTmp);
            End;
          End;
        End;

        fltMarPra := fCalculaPrecoVenda(2,
                                        fltPreCusTmp,
                                        fltUniLiqTmp,
                                        0,
                                        fltIcmSaiTmp + Self.fAlqDifIcmsPrecoDinamico(qryConCit.FieldByName('ITE_CODITE').AsString,
                                                       strEmpresaItem, strCodAbf, strCodSit, fltIcmSaiTmp),
                                        fltImpFedTmp,
                                        fltDesOpeTmp + Self.fltDesOpeCli,
                                        fRetornaValCom(fltComTblTmp),
                                        fMarMpkParaVenda,
                                        fCfgSis('PCMPRO'),
                                        fCfgSis('DECUNI'),
                                        fltImcSTPV,
                                        blnCalcST,
                                        IIF(Not fCfgSis('CLPVDI', varBoolean), fltAlqDifalTmp, 0),
                                        IIF(Not fCfgSis('CLPVDI', varBoolean) And (not CST_SUBSTITUICAO.Contains(strCodSit)), fltAlqFCPTmp, 0),
                                        fltOutValTmp,
                                        fRestringirElementosMargem );

        Result := fVerificaIntervaloMargemProduto(objLiberacao, fltMarPra, strCodIte + ' - ' + strDesIte,
                                                  FloatToStrf(fltQtdIte, ffFixed, 10, VS_intDecUni), blnPedeSenha);
      End;
    except
      On E: Exception Do
        pMensagensErro(E.Message, '[fValidaMargemCondPagto]');
    end;
  finally
    FreeAndNil(objLiberacao);
  end;
End;

function TFatVenda.fUsaValidaMargemCondPerfilItem : Boolean;
Begin
  Result := ((fCfgSis('TRVMKP') = 'I') And (fUsaPerfilECadCnd) And (Pos(strOpcDoc, 'PD_OR_VN_') > 0));
End;

function TFatVenda.fPermiteEditarDescricaoProdutoFaturamento: Boolean;
begin
  If (Self.blnTintaMaquinaEmExecussao) Then
    Result := fCfgSis('EDITIN', varBoolean)
  Else
    Result := fCfgSis('EDIFAT', varBoolean);
end;

function TFatVenda.fAcionarTravaVendasMaximoDiasNaoCompra(const blnCondicaoNPermite: Boolean; intTipoCnd: Integer;
                                                           blnCondPagto: Boolean): Boolean;
{ FUNCÃO QUE IRÁ DETERMINAR QUANDO A TRAVA DE VENDAS PARA CLIENTES QUE ULTRAPASSARAM
  O MAXIMO DIAS QUE NÃO COMPRA, SERÁ EXECUTADA:
  blnCondPagto - INDICA QUE A TRAVA ESTÁ SENDO ACIONADA NA CONDIÇÃO DE PAGAMENTO.
  HOJE, QUANDO VENDIA = "NÃO", NÃO HÁ VALIDAÇÃO NA CONDIÇÃO DE PAGAMENTO, A TRAVA SÓ ACONTECE AO INFORMAR O CLIENTE - KM }
begin
  If fCfgSis('PFLCLI', varBoolean) Then
    Result := blnCondicaoNPermite
  Else
  Begin
    Result := ((fCfgSis('VENDIA', varBoolean)) And (intTipoCnd <> A_VISTA) And (blnCondPagto)) Or
              ((fCfgSis('VENDIA', varBoolean)) And (not blnCondPagto));
  End;
end;

function TFatVenda.fValidaAliquotaInternaEstadoDestino: Boolean;
var
  strTipAbf: String;
  intContador: Integer;
  arrMatItensTmp: TMatrizFechamento;

  function fCalculaRecDifalFCP: Boolean;
  begin
    Result := True;

    If blnEspelhouFcpFcpSTDev Then
      Exit(False);

    If Self.Fulfillment.EhOperacaoFulfillment Then
      Exit(False);

    If blnConfirmacaoEspelho Then
      Exit(False);

    If fGravaEspelhoFundoCombateIMCeFundoCombateST(arrMatItensTmp[intContador].strClaFis, arrMatItensTmp[intContador].strEmpIte) Then
      Exit(False);

    If ((strOpcDoc = 'DV') And (arrMatItensTmp[intContador].fltValRet <= 0)) Then
      Exit(False);
  end;

begin

  Result := True;

  If (Self.strCliEst = 'EX') Then
    Exit;

  If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) Then
  Begin

    pCopiarMatrizItens(Self.ArrMatItens, arrMatItensTmp);

    For intContador := 0 To Length(arrMatItensTmp) -1 Do
    Begin
      If fAtendeRegrasDifal(False, arrMatItensTmp[intContador].strEmpIte) And fCalculaRecDifalFCP Then
      Begin
        pCalculaGravaICMSUFDestino('', '', arrMatItensTmp[intContador]);

        If FExibirMensagemAliquotaInternaEstadoDestino Then
        Begin
          Result := False;
          strTipAbf := Self.GetTipAbf(arrMatItensTmp[intContador]);

          fMensagem('','Abreviação de ICMS não configurada.'+ #13+#10 +
                       'Favor verificar o cadastro de abreviação e produto.'+ #13+#10 +
                       'Alíquota interna do estado de destino inválida'+ #13+#10 +
                       'Cliente: ' + Self.strCodCli + '  UF.Entrega: '+ strEstEnt + '  Produto: ' + arrMatItensTmp[intContador].strIteAbf +  #13+#10 +
                       'Cod.Abrev.: ' + arrMatItensTmp[intContador].strCodAbf + '  Tp.Abrev.: ' + AnsiReplaceStr(AnsiReplaceStr(strTipAbf,'_ENT_',''),'_SAI_',''),['&OK']);
        End;
      End;
    End;
  End;

end;

function TFatVenda.fValidaMinimoAntesDaCondicaoNoFinal(const blnUsaCondicaoDePagamentoNoFinal: Boolean): Boolean;
begin
  Result := True;
  If (blnUsaCondicaoDePagamentoNoFinal) Then
    Result := (Self.strOpcDoc = 'CO');
End;

function TFatVenda.fValidacoesPerfilCndExpedicao(strNumDoc : String; fltValorExpedido, fltValorMargem : Double )  : Boolean;
{Executa as validações relacionadas a configuração CFG_CNDEXP, quando utiliza
o perfil da condição de pagamento - KM}

Var
  qryTmp             : TUniQuery;
  objLiberacao       : TLiberacao;
  fltValorParcMinima : Double;
  blnParcelaMenor    : Boolean;
  intContador        : Integer;
  strCndExp          : String;
  intParcela         : Integer;

begin
  Result    := True;
  strCndExp := fCfgSis('CNDEXP');

  If not fUsaPerfilECadCnd Then
    Exit;

  if (Length(strCndExp) <> 3) Then
    Exit;

  If strCndExp = 'NNN' Then
    Exit;

  blnParcelaMenor := False;
  Try
    objLiberacao := TLiberacao.Create;

    qryTmp := fCriaQuery(Self);
    qryTmp.SQL.Add(' SELECT CND_MARMIN, CND_TRAMAR, CND_FATMIN, CND_TRAFAT, ');
    qryTmp.SQL.Add('        CND_PARMIN, CND_TRAPAR, CND_CNDPAG ');
    qryTmp.SQL.Add('  FROM CADCND ');
    qryTmp.SQL.Add('  WHERE CND_CODIGO = ' + QuotedStr(strCodCnd));
    qryTmp.Open;

    If strCndExp[1] = 'S' Then     {Validando Faturamento Minimo}
    Begin

      If (fFormataFloat(fltValorExpedido, VS_intDecUni) < fFormataFloat(qryTmp.FieldByName('CND_FATMIN').AsFloat, VS_intDecUni)) Then
      Begin
        objLiberacao.objMsgLibera.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Valor de Faturamento do Documento é menor que o Valor de Faturamento Mínimo permitido pelo perfil da condição de pagamento');
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Documento' , strNumDoc, 10);
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto', strCodCnd + '-' + fRetDesConPag(strCodCnd) , 10);
        objLiberacao.objMsgLibera.pAddTextoCaption('          ', fFormataCondPag(qryTmp.FieldByName('CND_CNDPAG').AsString), 10);
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Faturamento Mínimo Permitido' , FormatFloat('#,##0.00', qryTmp.FieldByName('CND_FATMIN').AsFloat), 28);
        objLiberacao.objMsgLibera.pAddTextoCaption('Faturamento deste documento'  , FormatFloat('#,##0.00', fltValorExpedido)                        , 28);
        objLiberacao.objMsgLibera.pAddSeparador(100);

        If qryTmp.FieldByName('CND_TRAFAT').asString = 'S' Then
        Begin
          objLiberacao.strDirAce := 'LIBSEN';
          objLiberacao.strSenLib := fCfgSis('LIBSEN');
          objLiberacao.strMsgSen := 'Liberação de Venda';
          objLiberacao.strCodOpe := strCodVen;
          objLiberacao.strCodDig := strCodDig;
          Result := fFatMensagemLiberacao(objLiberacao);
        End
        Else
        Begin
          objLiberacao.strDirAce := 'NENHUM';
          objLiberacao.blnTraTel := False;
          fFatMensagemLiberacao(objLiberacao);
        End;
      End;
    End;
    If (Result) And (strCndExp[2] = 'S') Then {Validando Margem/Markup Minimo}
    Begin
      If (fFormataFloat(fltValorMargem, VS_intDecUni) < fFormataFloat(qryTmp.FieldByName('CND_MARMIN').AsFloat, VS_intDecUni)) Then
      Begin
        objLiberacao.objMsgLibera.Clear;
        objLiberacao.objMsgLibera.pAddTexto(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' do documento é menor que a ' + IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' mínima permitido pelo perfil da condição de pagamento');
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Documento' , strNumDoc, 10);
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto', strCodCnd + '-' + fRetDesConPag(strCodCnd) , 10);
        objLiberacao.objMsgLibera.pAddTextoCaption('          ', fFormataCondPag(qryTmp.FieldByName('CND_CNDPAG').AsString), 10);
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' mínima permitida' , FloatToStrF(qryTmp.FieldByName('CND_MARMIN').AsFloat, ffNumber, 12, 2), 24);
        objLiberacao.objMsgLibera.pAddTextoCaption(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' praticada'        , FloatToStrF(fltValorMargem, ffNumber, 12, 2), 24);

        If qryTmp.FieldByName('CND_TRAMAR').asString = 'S' Then
        Begin
          objLiberacao.strDirAce := 'LIBSEN';
          objLiberacao.strSenLib := fCfgSis('LIBSEN');
          objLiberacao.strMsgSen := 'Liberação de Venda';
          objLiberacao.blnMosMen := True;
          objLiberacao.strCodOpe := strCodVen;
          objLiberacao.strCodDig := strCodDig;
          Result := fFatMensagemLiberacao(objLiberacao);
        End
        Else
        Begin
          objLiberacao.strDirAce := 'NENHUM';
          objLiberacao.blnTraTel := False;
          fFatMensagemLiberacao(objLiberacao);
        End;
      End;
    End;

    If (Result) And (strCndExp[3] = 'S') Then {Validando Valor Parcela Minima}
    Begin
      fltValorParcMinima := 0;
      intParcela         := 0;

      For intContador := 0 To 23 Do
      Begin
        If (arrDuplicataCND[intContador].curValor > 0) And
           (fFormataFloat(arrDuplicataCND[intContador].curValor, VS_intDecUni) < fFormataFloat(qryTmp.FieldByName('CND_PARMIN').AsFloat, VS_intDecUni)) Then
        Begin
          fltValorParcMinima := arrDuplicataCND[intContador].curValor;
          blnParcelaMenor    := True;
          intParcela         := intContador;
          Break;
        End;
      End;

      if (Not(fCfgSis('CPOVMP', varBoolean))) and
         (intParcela <= 1) and
         (fRetTipoForaConPag(strCodCnd) = 'OUTROS') then
        Exit;

      If blnParcelaMenor Then
      Begin
        objLiberacao.objMsgLibera.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Valor de Parcela é menor que o Valor de Parcela Mínimo permitido pelo perfil da condição de pagamento');
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Documento' , strNumDoc, 10);
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto', strCodCnd + '-' + fRetDesConPag(strCodCnd) , 10);
        objLiberacao.objMsgLibera.pAddTextoCaption('          ', fFormataCondPag(qryTmp.FieldByName('CND_CNDPAG').AsString), 10);
        objLiberacao.objMsgLibera.pAddSeparador(100);
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor de Parcela mínima permitida' , FloatToStrF(qryTmp.FieldByName('CND_PARMIN').AsFloat, ffNumber, 12, 2), 40);
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor de Parcela do documento'     , FloatToStrF(fltValorParcMinima, ffNumber, 12, 2), 40);

        If qryTmp.FieldByName('CND_TRAMAR').asString = 'S' Then
        Begin
          objLiberacao.strDirAce := 'LIBSEN';
          objLiberacao.strSenLib := fCfgSis('LIBSEN');
          objLiberacao.strMsgSen := 'Liberação de Venda';
          objLiberacao.blnMosMen := True;
          objLiberacao.strCodOpe := strCodVen;
          objLiberacao.strCodDig := strCodDig;
          Result := fFatMensagemLiberacao(objLiberacao);
        End
        Else
        Begin
          objLiberacao.strDirAce := 'NENHUM';
          objLiberacao.blnTraTel := False;
          fFatMensagemLiberacao(objLiberacao);
        End;
      End;
    End;
  Finally
    FreeAndNil(qryTmp);
  End;
End;

procedure TFatVenda.pLimpaInvoice;
begin
  strInvoiceIncTer := '';
  strInvoicePorDes := '';
  strInvoicePorEmb := '';
  strInvoiceAeropo := '';
  fltInvoiceTarifa := 0;
  fltInvoiceSeguro := 0;
  fltInvoiceFrete_ := 0;
  strInvoiceNotify := '';
  strInvoiceEWorks := '';
  strInvoiceContai := '';
  strInvoicePackin := 'S';
  intInvoiceSeqInv := 0;
end;

procedure TFatVenda.pCarregaInvoice(strSeqGer: String);
var
  qryAux: TUniQuery;
begin

  qryAux := fCriaQuery;

  Try
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT * FROM INVOIC');
    qryAux.SQL.Add('WHERE INV_SEQFGO = :SEQGER');
    qryAux.ParamByName('SEQGER').AsString := strSeqGer;
    qryAux.Open;

    If Not qryAux.isEmpty Then
    Begin
      strInvoiceIncTer := qryAux.FieldByName('INV_INCTER').AsString;
      strInvoicePorDes := qryAux.FieldByName('INV_PORDES').AsString;
      strInvoicePorEmb := qryAux.FieldByName('INV_POREMB').AsString;
      strInvoiceAeropo := qryAux.FieldByName('INV_AEROPO').AsString;
      fltInvoiceTarifa := qryAux.FieldByName('INV_TARIFA').AsFloat;
      fltInvoiceSeguro := qryAux.FieldByName('INV_SEGURO').AsFloat;
      fltInvoiceFrete_ := qryAux.FieldByName('INV_FRETE_').AsFloat;
      strInvoiceNotify := qryAux.FieldByName('INV_NOTIFY').AsString;
      strInvoiceEWorks := qryAux.FieldByName('INV_EWORKS').AsString;
      strInvoiceContai := qryAux.FieldByName('INV_CONTAI').AsString;
      strInvoicePackin := qryAux.FieldByName('INV_PACKIN').AsString;
      intInvoiceSeqInv := StrToIntDef(fCampoTabela('IFNULL(MAX(FDO_SEQINV),0)',
                                                   'FATDOR INNER JOIN EXTDOR ON EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM',
                                                   ['FDO_SEQGER'], [strSeqGer], False),0);
    End
    Else
    Begin
      pLimpaInvoice;
    End;

  Finally
    FreeAndNil(qryAux);
  End;
end;

function TFatVenda.fRetornaSequencialItemInvoice(blnInserindo: Boolean; cdsDocumento: TUniClientDataSet): Integer;
begin

  If blnInserindo Then
  Begin
    intInvoiceSeqInv := intInvoiceSeqInv + 1;
    Result := intInvoiceSeqInv;
  End
  Else
  Begin
    Result := cdsVenda.FieldByName('ITE_SEQINV').AsInteger;
  End;

end;

function TFatVenda.fValidaSaldoDaMatriz: Boolean;
begin
  Result := False;

  if blnAbastecimentoDeposito then
    Exit;

  if blnOrcConEnt then
    Exit(True);

  if blnEnt_CD then
    Exit(True);
end;

procedure TFatVenda.pAtualizaDocFatRegimeEspecial_ML;
  Var
    qryAux: TUniQuery;
    strDocTra, strTipTra, strEmpTra: String;
begin
  qryAux := fCriaQuery;
  Try
    //busca o documento de transferência
    qryAux.SQL.Add('SELECT GER_NUMDOC, GER_ESPDOC, GER_CODEMP');
    qryAux.SQL.Add('FROM MOVGER');
    qryAux.SQL.Add('JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM');
    qryAux.SQL.Add('WHERE AUX_DOC_RE = :NUMDOC');
    qryAux.SQL.Add('  AND AUX_ESP_RE = :ESPDOC');
    qryAux.SQL.Add('  AND AUX_EMP_RE = :CODEMP');
    qryAux.SQL.Add('  AND GER_TIP_FC = "C"');

    qryAux.ParamByName('NUMDOC').AsString := Self.strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := Self.strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.Open;

    strDocTra := qryAux.FieldByName('GER_NUMDOC').AsString;
    strTipTra := qryAux.FieldByName('GER_ESPDOC').AsString;
    strEmpTra := qryAux.FieldByName('GER_CODEMP').AsString;

    //atualiza MOVGER/MOVDET
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('UPDATE MOVGER');
    qryAux.SQL.Add('  SET GER_NUMFAT = :DOCTRA');
    qryAux.SQL.Add('     ,GER_TIPFAT = :TIPTRA');
    qryAux.SQL.Add('     ,GER_EMPFAT = :EMPTRA');
    qryAux.SQL.Add('WHERE GER_NUMFAT = :NUMDOC');
    qryAux.SQL.Add('  AND GER_TIPFAT = :ESPDOC');
    qryAux.SQL.Add('  AND GER_EMPFAT = :CODEMP');
    qryAux.SQL.Add('  AND GER_ESPDOC = "ML"');
    qryAux.SQL.Add('  AND GER_TIP_FC = "C"');

    qryAux.ParamByName('DOCTRA').AsString := strDocTra;
    qryAux.ParamByName('TIPTRA').AsString := strTipTra;
    qryAux.ParamByName('EMPTRA').AsString := strEmpTra;
    qryAux.ParamByName('NUMDOC').AsString := Self.strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := Self.strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := Self.strEmpOriRegEsp;
    qryAux.ExecSQL;

    qryAux.Close;
    qryAux.SQL.Text := AnsiReplaceStr(qryAux.SQL.Text, 'GER', 'DET');
    qryAux.ExecSQL;

    //atualiza TINGER/TINDET
    If Not fEmptyStr(Self.strIncTinGer) Then
    Begin
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('UPDATE TINGER');
      qryAux.SQL.Add('  SET GER_NUMDOC = :DOCTRA');
      qryAux.SQL.Add('     ,GER_ESPDOC = :TIPTRA');
      qryAux.SQL.Add('     ,GER_CODEMP = :EMPTRA');
      qryAux.SQL.Add('WHERE AUTOINCREM = :INCGER');

      qryAux.ParamByName('DOCTRA').AsString := strDocTra;
      qryAux.ParamByName('TIPTRA').AsString := strTipTra;
      qryAux.ParamByName('EMPTRA').AsString := strEmpTra;
      qryAux.ParamByName('INCGER').AsString := Self.strIncTinGer;
      qryAux.ExecSQL;

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('UPDATE TINDET');
      qryAux.SQL.Add('  SET DET_NUMDOC = :DOCTRA');
      qryAux.SQL.Add('     ,DET_ESPDOC = :TIPTRA');
      qryAux.SQL.Add('     ,DET_CODEMP = :EMPTRA');
      qryAux.SQL.Add('     ,DET_OPEBAI = :OPEBAI');
      qryAux.SQL.Add('     ,DET_DTABAI = :DTABAI');
      qryAux.SQL.Add('     ,DET_HORBAI = :HORBAI');
      qryAux.SQL.Add('     ,DET_BAIXAD = "1"');
      qryAux.SQL.Add('WHERE DET_SEQGER = :INCGER');

      qryAux.ParamByName('DOCTRA').AsString := strDocTra;
      qryAux.ParamByName('TIPTRA').AsString := strTipTra;
      qryAux.ParamByName('EMPTRA').AsString := strEmpTra;
      qryAux.ParamByName('OPEBAI').AsString := strLoginUsuarioLogado;
      qryAux.ParamByName('DTABAI').AsDate   := Self.VS_Date;
      qryAux.ParamByName('HORBAI').AsTime   := fRetHoraServidor;
      qryAux.ParamByName('INCGER').AsString := Self.strIncTinGer;
      qryAux.ExecSQL;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

procedure TFatVenda.pAtualizaStatusPedidoDevolucao;
  Var
    stlPeds: TStringList;
    intCont: Integer;
    arrNumPed: TArray<String>;
    prcScroll: TprcScroll;
    strNumPed, strEmpPed: String;
begin
  stlPeds := TStringList.Create;
  stlPeds.Sorted     := True;
  stlPeds.Duplicates := dupIgnore;

  Try
    pDisableControls(cdsVenda, prcScroll);

    cdsVenda.First;
    While Not cdsVenda.Eof Do
    Begin
      If Not fEmptyStr(cdsVenda.FieldByName('ITE_DOCDEV').AsString) Then
      Begin
        pRetNumeroPedidoVenda(cdsVenda.FieldByName('ITE_DOCDEV').AsString,
                              cdsVenda.FieldByName('ITE_ESPDEV').AsString,
                              cdsVenda.FieldByName('ITE_EMPDEV').AsString,
                              Self.strCodCli, strNumPed, strEmpPed);

        If Not fEmptyStr(strNumPed) Then
          stlPeds.Add(strNumPed +'-PD-'+ strEmpPed);
      End;

      cdsVenda.Next;
    End;

    For intCont := 0 To stlPeds.Count -1 Do
    Begin
      arrNumPed := stlPeds[intCont].Split(['-']);

      TUpdateStatus.New(
        TParamStatus.New()
          .NumDoc(arrNumPed[0])
          .EspDoc(arrNumPed[1])
          .CodEmp(arrNumPed[2])
          .CodCli(Self.strCodCli)
      ).pExecute;
    End;
  Finally
    stlPeds.Free;
    pEnableControls(cdsVenda, prcScroll);
  End;
end;

