  function fRetLisDetSer: TFdoSeqGerServicos;
    Var
      intIndMat: Integer;
      intCont: Integer;
      intIndMatSer: Integer;
  begin
     Result.strLisCodIteSer := '';
     Result.strLisFdoSeqGer := '';
     intIndMatSer := -1;

     //Indentifica o indice da matriz onde estão os itens de serviço
     For intCont := 0 To Length(objDesmembrar.MatrizInfItens) -1 Do
     Begin
       If Pos('Ser', objDesmembrar.MatrizInfItens[intCont]) > 0 Then
       Begin
         intIndMatSer := intCont;
         Break;
       End;
     End;

     If (intIndMatSer <> -1) Then
     Begin
       //Lista todos os FDO_CODITE de itens serviço envolvidos na confirmação
       For intCont := 0 To Length(objDesmembrar.MatrizesItens[intIndMatSer]) -1 Do
       Begin
         If fEhItemServico(objDesmembrar.MatrizesItens[intIndMatSer][intCont].strCodIte) Then
           pIncrementaListaStr(objDesmembrar.MatrizesItens[intIndMatSer][intCont].strCodIte, Result.strLisCodIteSer, True);
       End;

       If Not fEmptyStr(Result.strLisCodIteSer) Then
       Begin
         //Lista todos os FDO_SEQGER de itens de serviço envolvidos na confirmação

         For intCont := Low(arrPedidos) To High(arrPedidos) Do
         Begin
           pIncrementaListaStr(fCampoTabela('FDO_SEQGER', 'FATDOR',
                               ['FDO_NUMDOC',
                                'FDO_ESPDOC',
                                'FDO_CODEMP'],
                               [arrPedidos[intCont].strNumPed,
                                arrPedidos[intCont].strEspPed,
                                arrPedidos[intCont].strEmpPed]), Result.strLisFdoSeqGer, True);
         End;

         For intCont := Low(arrPedidosConf) To High(arrPedidosConf) Do
         Begin
           pIncrementaListaStr(fCampoTabela('FDO_SEQGER', 'FATDOR',
                               ['FDO_NUMDOC',
                                'FDO_ESPDOC',
                                'FDO_CODEMP'],
                               [arrPedidosConf[intCont].strNumPed,
                                arrPedidosConf[intCont].strEspPed,
                                arrPedidosConf[intCont].strEmpPed]), Result.strLisFdoSeqGer, True);
         End;

         For intIndMat := 0 To Length(objDesmembrar.MatrizesItens) -1 Do
         Begin
           If (intIndMat <> intIndMatSer) Then
           Begin
             For intCont := 0 To Length(objDesmembrar.MatrizesItens[intIndMat]) -1 Do
               pIncrementaListaStr(objDesmembrar.MatrizesItens[intIndMat][intCont].strSeqGer, Result.strLisFdoSeqGer, True);
           End
         End;
       End
     End;
  End;

  procedure pBackupLogLibOriginal;
  Var
    intContador: Integer;
  Begin
    SetLength(arrLogLibSav, 0);

    For intContador := Low(arrLogLib) To High(arrLogLib) Do
    Begin
      SetLength(arrLogLibSav, intContador + 1);
      arrLogLibSav[intContador] := arrLogLib[intContador];
    End;
  End;

  Procedure pRestauraLogLibOriginal;
  Var
    intContador: Integer;
  Begin
    SetLength(arrLogLib, 0);

    For intContador := Low(arrLogLibSav) To High(arrLogLibSav) Do
    Begin
      SetLength(arrLogLib, intContador + 1);
      arrLogLib[intContador] := arrLogLibSav[intContador];
    End;
  End;

  function fGetEmpConfigEntrega(const item: TDadosFechamento): String;
  begin
    //Caso utilizando definicao de Empresa de Faturamento
    If (Pos(strOpcDoc, 'PD_OR_VN_') > 0) And Self.blnEmpFat Then
    Begin
      //Controlar sistema de entrega por
      Case fCfgSis('EMCFEN', VarInteger) Of
        1: Result := VS_strCodEmp;  //Pela empresa Logada
        2: Result := item.strEmpIte;//pela empresa do produto
      End;
    End;

    If fEmptyStr(fRetNomeEmpresa(Result)) Then
      Result := VS_strCodEmp;
  end;

  function fRecalculaVolumes : Boolean;
  begin
    Result := ((fCfgSis('CALVOL', varString) = 'S') And
               (blnExpedi) And
               (Length(objDesmembrar.MatrizesItens) > 1) And
               (Floor(fRetVolumes) <> intQtdTra)
              );
  end;

Begin
  fAjustaDataSistema;
  FAutIcv := EmptyStr;
  blnAlterouEmpresaLogada := False;
  LstrDocumentosMensagemGravacao := EmptyStr;

  {****************************************************************}
  {* CASO NãO FOR VENDA NORMAL,                                   *}
  {* EMISSãO DE ORÇAMENTO/PEDIDO, CONFIRMAÇÃO DE PEDIDO           *}
  {* HAJA SOMENTE UM TIPO DE DOCUMENTO E NAO SEJA MULTILOJA ENTãO *}
  {* GRAVA O DOCUMENTOS DE FORMA SIMPLIFICADA (FGRAVAARQUIVOS)    *}
  {*************************************************************JC*}
  If (fEhGravacaoSimplesVenda) Then
  Begin
    If fApenasSimulandoVenda Then
    Begin
      Result := False;
      Exit;
    End;

    strSepExpSav := Self.strSepExp;

    blnDevAutomatizadaDocOutraEmpresa := fEhDevAutomatizadaDocOutraEmpresa;

    If blnDevAutomatizadaDocOutraEmpresa Then
    Begin
      pAlterarEmpresaLogada(Self.strEmpDocDev);
      pCarregarLotesItensDevolucaoAutomatizada;
    End;

    Try
      If fNecessitaVerificarChkEntCD() Then
      Begin
        If fEhEmpresaCD(Self.arrMatItens[0].strEmpIte) And
           Not SameText(Self.arrMatItens[0].strEmpIte, VS_strCodEmp) Then
        Begin
          blnEnt_CD := True;
          strEmp_CD := Self.arrMatItens[0].strEmpIte;
        End
        Else
        Begin
          blnEnt_CD := False;
          strEmp_CD := VS_strCodEmp;
        End;
      End;

      if (blnAbastecimentoDeposito or blnRegimeEspecialPorEmpresaComFaturamentoDuplo) and (not fEmptyStr(strEmpOriPed)) then
      begin
        strEmpSav := VS_strCodEmp;
        pSetarEmpresaLogada(strEmpOriPed, strEmpOriPed);
        blnAlterouEmpresaLogada := True;
      end
      else if (strOpcDoc = 'DV') and fDevolucaoDocRegimeEspecial then
      begin
        strEmpSav := VS_strCodEmp;
        If Not blnDevolvendoRegEsp Then
          Self.strEmpLogDevRegEsp := VS_strCodEmp;
        pSetarEmpresaLogada(arrMatItens[0].strEmpDev, arrMatItens[0].strEmpDev);
        blnAlterouEmpresaLogada := True;
      end
      else if (strOpcDoc = 'CP') and (not blnExpedi) and fCfgSis('UTI_RE', varBoolean) and blnDesmembraPedRegEsp then
      begin
        strEmpSav := VS_strCodEmp;
        If fPossuiSomenteItensRegimeEspecial Then
          pSetarEmpresaLogada(fCfgSis('EMPRES'), fCfgSis('EMPRES'))
        Else
          pSetarEmpresaLogada(fCfgSis('EMPREN'), fCfgSis('EMPREN'));
        blnAlterouEmpresaLogada := True;
      end
      else if fFatEmpresaSemSaldoEstoque then
      begin
        strEmpSav := VS_strCodEmp;
        pSetarEmpresaLogada(strEmpFatSemSaldo, strEmpFatSemSaldo);
        blnAlterouEmpresaLogada := True;
      end;

      {******************************************************************}
      {* define as variavies de entrega no faturamento e entrega futura *}
      {**************************************************************JC**}
      If (Length(arrMatItens) > 0) Then
      Begin
        Self.strEntFut := IIF(fTemEntregaFutura(arrMatItens), 'S', 'N');
        // Se for confirmação segue a configuração fCfgSis('SUJROM') (vide fatVenda.CreateInstance -> pCarregaCfgSis)
        If (Not fConfirmacaoComEntregaRetiraDefinidaPelaSujRom) And (strOpcDoc <> 'DV') Then
          Self.strEntFat := IIF(fExisteItensEntrega(arrMatItens), 'S', 'N');
      End;

      {*************************************************************}
      {* Caso for nota fiscal de servicos altera a especie para NS *}
      {*********************************************************JC**}
      If (fltTotSer > 0) And (fltTotPro <= 0) And (Pos(strEspDoc, 'NF_EL_IF_IV_') > 0) And (fCfgSis('EMPSER') <> 'PREFEITURA DE BRASILIA') Then
      Begin
        strEspDoc := 'NS';
      End
      Else If (fltTotSer > 0) And (fltTotPro <= 0) And (strOpcDoc = 'VS') And (fCfgSis('EMPSER') = 'PREFEITURA DE BRASILIA') Then
      Begin
        strEspDoc := 'NF';
      End;

      {**********************************************************}
      {* Define se deve gerar um novo pedido de entrega pelo CD *}
      {******************************************************JC**}
      pDefineSeGeraNovoPedidoEntregaCD(strEmpSav);

      {***************************************************************************}
      {* Sistema configurado para "Gerar novo Pedido de Venda com itens de       *}
      {* entrega imediata ou retira em outra loja quando faturar um pedido       *}
      {* pelo F11 do Resumo de Caixa?"                                           *}
      {************************************************************************JC*}
      pDefineSeGeraNovoPedidoEntregaImediata(strEmpSav);
      pDefineSeGeraNovoPedidoRetiraOutraLoja(strEmpSav);
      pDefineSeGeraNovoPedidoRetiraMesmaLoja(strEmpSav);
      pDefineSeGeraNovoPedidoRetiraExpedicao(strEmpSav);
      pDefineSeGeraNovoPedidoRetiraMesmaLoja(strEmpSav);
      pDefineSeGeraNovoPedidoAbastecimentoItens(strEmpSav);

      {**********************************************************************************************}
      {* Caso estiver faturando um PD/OR que tem separação de retira ajusta a variável de separação *}
      {******************************************************************************************VA**}
      pSetaSeparadorExpedicao;

      If blnTaxaBombeamentoPedOrc And (Self.fltTotBom > 0) Then
      Begin

        If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
        Begin

          fltQtdBom_bck := Self.fltQtdBom;
          fltPrcBom_bck := Self.fltPrcBom;
          fltTotBom_bck := Self.fltTotBom;

          Try
            pInsereItemTaxaBombeamento(tbIteBom);
            pCalculaTotGer;
          Finally
            Self.fltQtdBom := fltQtdBom_bck;
            Self.fltPrcBom := fltPrcBom_bck;
            Self.fltTotBom := fltTotBom_bck;
          End;

        End
        Else
        Begin
          pInsereItemTaxaBombeamento(tbIteBom);
          pCalculaTotGer;
        End;

      End;

      If (fTipoOperacaoRemessaContaOrdemSelecionada) Then
      Begin
        Try
          VS_strAllErrorsMessages := '';
          blnComTansacao := False;
          fStartTransaction;

          strTipOpe := 'C';
          pPreencheMatrizFechamento;
          pCalculaTotGerInterna;
          Result  := fGravaArquivos(pgbStatus);
          FAutRco := strAutIncFatGor;

          If Result Then
          Begin
            pReajustaValoresPedidoRemessaContaOrdem;
            Result  := fGravaArquivos(pgbStatus);
            FAutRco := EmptyStr;

            fCommit;
          End
          Else
            fRollBack;
        Except
          On E: Exception Do
          Begin
            Result := False;
            fRollBack;
          End;
        End;
      End
      Else
        Result := fGravaArquivos(pgbStatus);

      if Result and Assigned(objRomFusTarefas) then
        objRomFusTarefas.pProcessarTarefas;
    Finally
      Self.strSepExp := strSepExpSav;

      If blnDevAutomatizadaDocOutraEmpresa Then
        pAlterarEmpresaLogada(Self.strEmpLogDev);

      If blnAlterouEmpresaLogada Then
        pSetarEmpresaLogada(strEmpSav, strEmpSav);

    End;
    Exit;
  End;

  Result    := False;

  fltTotCad := 0.0;
  fltTotRec := 0.0;

  LSafeCommitID := RandomRange(1, MaxInt);

  FFoiGravacaoPorDesmembramento := True;
  FAuditaGravacaoConfirmacao := False;
  FErroCarregarPonImp := '';

  Try
    Self.pgbStatusGravacao := pgbStatus;

    strClaFisSav := Self.strClaFis;
    strSepExpSav := Self.strSepExp;

    {*********************************************************************}
    {* Caso for multi-empresa altera a variavel global de empresa logada,*}
    {* carrega as configuracoes e verifica se permite emitir documento   *}
    {*****************************************************************JC**}
    Self.blnMulLoj := fVendaMultiloja Or fPedidoMultiLoja;

    pInformacao('Aguarde, Preparando itens para o desmembramento...', pgbStatusGravacao);
    pProgresso(0, 0, pgbStatusGravacao);

    {****************************************************}
    {* Realiza o desmembramento da matriz de itens para *}
    {* emissão de cada tipo de documento                *}
    {*************************************************JC*}
    if (strOpcDoc = 'FC') or (strOpcDoc = 'CR') then
    begin
      objDesmembrar := TDesmembrarMatrizItens.Create(arrMatItens, FRecSer,
        False, False, False, True, blnDesmembraPedRegEsp, strOpcDoc,
        fDesmembrarPorCFG_ITEDOC);
    end
    else
    begin
      objDesmembrar := TDesmembrarMatrizItens.Create(arrMatItens, FRecSer,
        fEntregaImediataPorGrupoProdutos, fEntregaImediataPorDataDeEntrega,
        fEntregaImediataPorDataDeEntregaComRotaPorPedido,
        False, blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC);
    end;

    objDesmembrar.blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    objDesmembrar.pDesmembrarMatrizItens;

    {************************************************************************************}
    {* Limpa as informacoes de documentos ja emitidos, pois vai iniciar novas gravacoes *}
    {********************************************************************************JC**}
    objFatVendaImp.pLimparDocumentos;

    If blnValidarDadosNotaEletronica Then
      If Not fValidaDadosNotaEletronica(objDesmembrar.MatrizesItens) Then
        Exit;

    If Self.blnMulLoj Then
      If Not fValidaConfiguracoesIguaisEntreAsEmpresasItens(objDesmembrar) Then
        Exit;

    Self.pSetaViaNfe;
      
    Try

      {***************************************}
      {* Salva a especie e a empresa logada  *}
      {************************************JC*}
      strEspSav    := strEspDoc;
      strCndSav    := strConPag;
      strEmpSav    := VS_strCodEmp;
      strPedEmpSav := strPedEmp;
      strTipPedSav := strTipPed;
      strEmp_CDSav := strEmp_CD;
      blnEnt_CDSav := blnEnt_CD;
      blnVendaPresencialSav := blnVendaPresencial;

      {*******************************************}
      {* Define a empresa original do documento  *}
      {****************************************JC*}
      If fEmptyStr(strEmpOri) Then
        strEmpOri  := VS_strCodEmp;

      {******************************}
      {* Salva os valores Originais *}
      {***************************JC*}
      fltTaxEntSav := fltTaxEnt;
      fltFreRatSav := fltFreRat;
      fltFreSugSav := fltFreSug;
      fltFreCotSav := fltFreCot;
      fltFreSav    := fltValFre;
      fltAceSav    := fltDesAce;
      fltDesSav    := fltDesEsp;
      fltRecSav    := fltDupRec;
      fltPorDesSav := fltPorDes;

      {*******************************************}
      {* Salva o endereco de entrega selecionado *}
      {****************************************JC*}
      recEndEntSav := Self.enderecoEntrega;

      {*********************************}
      {* Salva os servicos digitados   *}
      {******************************JC*}
      recServicos  := Self.FRecSer;

      {****************************************************}
      {* Calcula o Total do contas a receber dos serviços *}
      {*************************************************JC*}
      fltTotCadRecSer := fltTotSer;
      If (Pos(strEspDoc,'NF_EL_NS_IF_IV_') > 0) And (fltTotCadRecSer > 0) Then
      Begin
        fltTotCadRecSer := fltTotCadRecSer - fTotalRetencoesServicos;

        If (strRetIss = 'S') Then
          fltTotCadRecSer := fltTotCadRecSer - fltValIss;
      End;

      {****************************************************************}
      {* Desconta o valor dos Servicos e Iss, pois venda de serviço   *}
      {* não vai gravar frete, despesas acessória e desconto especial *}
      {************************************************************JC**}
      fltTotSavComDesconto := Self.fltTotGer - Self.fltTotSer;
      {****************************************************************}
      {* Se itens de brinde não forem faturados juntos com o documento*}
      {* de origem, desconta-se o total de brinde do total geral      *}
      {************************************************************VA**}
      If ((fCfgSis('VENBRI') = 'N') And (objDesmembrar.fTemMatrizDoTipo(matDesProdutoDeBrinde))) Or
         objDesmembrar.fTemMatrizSomenteItensBrinde() Then
        fltTotSavComDesconto := fltTotSavComDesconto - Self.fltTotProBri;

      fltTotCadRecIte := Self.fltTotCadRec - fltTotCadRecSer;

      {****************************}
      {* Inicia os Totalizadores  *}
      {************************JC**}
      fltTotDes    := 0;
      fltTotFre    := 0;
      fltTotFreRat := 0;
      fltTotFreSug := 0;
      fltTotFreCot := 0;
      fltTotTaxEnt := 0;
      fltTotAce    := 0;

      {*****************************************}
      {* Faz uma copia dos dados da Financeira *}
      {**************************************JC*}
      If Assigned(objFinanc) Then
      Begin
        objFinanc.pCopiaSeguranca;
        objFinanc.pLimpaValoresDesmembrados;
      End;

      {*************************************************}
      {* Faz uma copia dos dados dos Cheques a Vista   *}
      {*********************************************JC**}
      If Assigned(cdsChequeVis) Then
        oleChqAviSav := cdsChequeVis.Data;

      {*************************************************}
      {* Faz uma copia dos dados dos Cheques a Prazo   *}
      {*********************************************JC**}
      If Assigned(cdsChequePre) Then
        oleChqPreSav := cdsChequePre.Data;

      {*************************************************}
      {* Faz uma copia dos dados dos Cartoes           *}
      {*********************************************JC**}
      arrCartoesSav := arrCartoes;

      {*************************************************}
      {* Faz uma copia dos dados dos Creditos          *}
      {*********************************************JC**}
      If Assigned(stlDupCreditos) Then
        strDupCreditosSav := stlDupCreditos.Text;

      {*************************************************}
      {* Faz uma copia das Modalidades de Pagamento    *}
      {*********************************************JC**}
      recModOri := Self.FRecMod;
      Self.recModOriDesmembramento := recModOri;
      
      {********************************************************************}
      {* Faz uma copia da Matriz de Duplicatas (vencimentos do documento) *}
      {****************************************************************JC**}
      For intIndDoc := Low(arrDuplicata) To High(arrDuplicata) Do
      Begin
        arrDuplicOri[intIndDoc] := arrDuplicata[intIndDoc];
        arrDuplicTot[intIndDoc] := arrDuplicata[intIndDoc];
        arrDuplicTot[intIndDoc].curValor := 0.00;
      End;

      {***************************************}
      {* Inicia o acumulador das modalidades *}
      {***********************************JC**}
      Fillchar(recModTot, SizeOf(recModTot), #0);
      Fillchar(recModRcx, SizeOf(recModRcx), #0);

      cdsDocGer.EmptyDataSet;

      {***********************************************}
      {* seta variaveis para nao gerar transacoes,   *}
      {* imprimir e gerar Nfe automaticamente e      *}
      {* se retorna um novo sequencial de controle   *}
      {* (seqcon) - Muito cuidado com esta variavel  *}
      {*******************************************JC**}
      blnComTansacao := False;
      blnImprimeDocs := False;
      blnGerarNfePainel := False;
      blnCarregaSeqConRcx := False;
      blnCarregarSeqMovCar := False;
      blnGravandoVariosDocumentos := True;

      {*********************************************}
      {* Calcula o prazo médio antes de desmembrar *}
      {*****************************************JC**}
      intPrzMed := fCalculaPrazoMedioVenda;

      {***************************************}
      {* total geral com desconto            *}
      {***********************************PZ**}
      fltTotGerTmp := fltTotGer;

      If Assigned(objFinanc) Then
        fltTotGerTmp := fltTotGerTmp - objFinanc.fRetDespesasAcessorias;

      fltTotProBriSav := fltTotProBri;

      {***************************************}
      {* Calcula o total geral sem desconto  *}
      {***********************************JC**}
      pCalculaTotGer(True);
      fltTotSav := fltTotGer;

      {***********************************************}
      {* Servicos não vão entrar no rateio de Frete, *}
      {* despesas acessorias e descontos             *}
      {*******************************************JC**}
      If fltTotSer > 0 Then
        fltTotSav := fltTotSav - fltTotSer;
      {****************************************************************}
      {* Se itens de brinde não forem faturados juntos com o documento*}
      {* de origem, desconta-se o total de brinde do total geral      *}
      {************************************************************VA**}
      If ((fCfgSis('VENBRI') = 'N') And (objDesmembrar.fTemMatrizDoTipo(matDesProdutoDeBrinde))) Or
         objDesmembrar.fTemMatrizSomenteItensBrinde() Then
        fltTotSav := fltTotSav - fltTotProBri;

      {************************************************}
      {* FAZ BACKUP DO ARRAY DE LIBERAÇÕES DAS TRAVAS *}
      {********************************************PZ*}
      pBackupLogLibOriginal;

      strEmpAnt := '';

      {*************************************************}
      {* DEVE SER CHAMADO ANTES DA TRANSACAO PRINCIPAL *}
      {*************************************************}
      {* Grava o mesmo seqcon para todos os documentos *}
      {*********************************************JC**}
      If Not blnCarregaSeqConRcx Then
      Begin
        intSeqConRcx := StrToInt(fRetRcxCon(strEmpLog));
        If blnExpedi And (Pos(VS_strTipExp,  '3_4_5_') > 0) And fCfgSis('USABAC', varBoolean) Then
        Begin
          intSeqConRcxCredito := StrToInt(fRetRcxCon);
        End;
      End;

      {*************************************************}
      {* DEVE SER CHAMADO ANTES DA TRANSACAO PRINCIPAL *}
      {*********************************************JC**}
      If Not blnCarregarSeqMovCar Then
        fRetSequencialMovCar('MOVCAR', VS_strCodEmp, arrCartoes);

      if (Length(objDesmembrar.MatrizesItens) > 1) and fEmptyStr(strSeqDmp) then
      begin
        strSeqDmp := VS_strCodEmp + fRetSequencial('SEQDMP');
        strEmpDmp := VS_strCodEmp;
        blnDesmembramentoDePedidos := True;
      end;

      if (not Self.blnComTansacao) then
      begin
        if not fVerificaFlexNegativo(objDesmembrar.MatrizesItens) and (fCfgSis('TRAREM') = '1') then
        begin
          Result := False;
          Exit;
        end;
      end;

      if (Not fApenasSimulandoVenda) and (fPedidoJaFaturado) then
      begin
        Exit(False);
      end;

      {***************************************************}
      {* Inicia transacao unica para todos os documentos *}
      {***********************************************JC**}
      If Not fApenasSimulandoVenda Then
      begin
        VS_strAllErrorsMessages := '';
        FAuditFaturamento.Limpar;
        FAuditoriaSaldo.Limpar;
        FAuditoriaResumoCaixa.Limpar;
        fStartTransaction(frmModulo.GetCurrentConnection, LSafeCommitID);
      end;

      If (Self.strOpcDocTrue='11') And (Length(objDesmembrar.MatrizesItens) > 1) Then
      Begin
        blnTemDocBrindeSemValor := False;
        blnTemDocNormalComValor := False;
      
        For intIndDoc := 0 To Length(objDesmembrar.MatrizesItens) -1 Do
        Begin
          arrMatItens := objDesmembrar.MatrizesItens[intIndDoc];
          fltAuxDesm  := 0;
          For intItens := Low(arrMatItens) To High(arrMatItens) Do
            fltAuxDesm := fltAuxDesm + fFormataFloat(arrMatItens[intItens].fltTotIte, 2);

          If (blnTemDocBrindeSemValor=False) And (fltAuxDesm=0.00) Then
            blnTemDocBrindeSemValor := True;

          If (blnTemDocNormalComValor=False) And (fltAuxDesm<>0.00) Then
            blnTemDocNormalComValor := True;
        End;

        If (blnTemDocBrindeSemValor Or objDesmembrar.fTemMatrizSomenteItensBrinde()) And blnTemDocNormalComValor Then
        Begin
          blnGravouMovCar := False;
          blnGravouCadChq := False;
        End;
      End;

      strPortadoresOperadorOri := strPortadoresOperador;
      {*********************************************************}
      {* Processa todos os tipos de documentos a serem gerados *}
      {*****************************************************JC**}
      For intIndDoc := 0 To Length(objDesmembrar.MatrizesItens) -1 Do
      Begin
        blnUltimoDocumento := (intIndDoc = Length(objDesmembrar.MatrizesItens) - 1);
        
        strDocExp := '';

        pInformacao('Aguarde, Realizando o desmembramento...', pgbStatusGravacao);

        {***************************************************************}
        {* Carrega a matriz de itens ja filtrada para emissão da venda *}
        {***********************************************************JC**}
        arrMatItens := objDesmembrar.MatrizesItens[intIndDoc];

        {******************************************************************}
        {* Carrega a matriz de serviços ja filtrada para emissão da venda *}
        {**************************************************************MM**}
        Self.FRecSer := objDesmembrar.MatrizServicos[intIndDoc];

        {***************************************************************}
        {* Vai utilizar o desconto especial já rateado nos itens, pois *}
        {* ocorre de promocao não possuir desconto especial no rateio  *}
        {***********************************************************JC**}
        fltDesEspSomaItens := 0.00;
        For intItens := Low(arrMatItens) To High(arrMatItens) Do
        Begin
          fltDesEspSomaItens := fltDesEspSomaItens + arrMatItens[intItens].fltDesEsp;

          if (strOpcDoc = 'FC') or (strOpcDoc = 'CR') then
          Begin
            Self.strCodVen := arrMatItens[intItens].strCodVen;
          End;
        End;

        {**********************************************************************************}
        {* Vai utilizar o Frete já rateado nos itens, pois quando possui itens de entrega *}
        {* o frete somente é rateado nos mesmos, ou seja, só grava frete para entrega.    *}
        {******************************************************************************JC**}
        fltValFreSomaItens    := 0.00;
        fltValFreRatSomaItens := 0.00;
        fltValFreSugSomaItens := 0.00;
        fltValFreCotSomaItens := 0.00;
        fltValTaxEntSomaItens := 0.00;

        For intItens := Low(arrMatItens) To High(arrMatItens) Do
        Begin
          fltValFreSomaItens    := fltValFreSomaItens    + arrMatItens[intItens].fltValFre;
          fltValFreRatSomaItens := fltValFreRatSomaItens + arrMatItens[intItens].fltFreRat;
          fltValFreSugSomaItens := fltValFreSugSomaItens + arrMatItens[intItens].fltFreSug;
          fltValFreCotSomaItens := fltValFreCotSomaItens + arrMatItens[intItens].fltFreCot;
          fltValTaxEntSomaItens := fltValTaxEntSomaItens + arrMatItens[intItens].fltTaxEnt;
        End;

        {**********************************************************************************}
        {* Vai utilizar o valor já rateado nos itens, pois quando possui meia nota e nota *}
        {* normal o valor somente é rateado na Nota Fiscal.                               *}
        {******************************************************************************JC**}
        fltDesAceSomaItens := 0.00;
        For intItens := Low(arrMatItens) To High(arrMatItens) Do
        Begin
          fltDesAceSomaItens := fltDesAceSomaItens + arrMatItens[intItens].fltDesAce;
        End;

        {****************************************************}
        {* restaura a especie selecionada para faturamento  *}
        {************************************************JC**}
        strEspDoc := strEspSav;
        strConPag := strCndSav;

        strTipPed := strTipPedSav;
        strEmp_CD := strEmp_CDSav;
        blnEnt_CD := blnEnt_CDSav;
        blnVendaPresencial := blnVendaPresencialSav;

     {*REQ.164501**********RP*}

        pSetaVendaPresencialParaClienteForaDoEstadoMedianteCFG;

        If blnVendaPresencial Then
        Begin
          If Not fValidaEspecieVendaPresencial(strEspDoc, strEspeciesPermitidas) Then
            Raise Exception.CreateFmt(MSG_ESPECIES_PERMITIDAS_VENDA_PRESENCIAL, [strEspeciesPermitidas]);
        End;

        {*****************************}
        {* Restaura a empresa logada *}
        {*************************JC**}
        pSetarEmpresaLogada(strEmpSav, strPedEmpSav);

        {**********************************************************}
        {* Define se deve gerar um novo pedido de entrega pelo CD *}
        {******************************************************JC**}
        pDefineSeGeraNovoPedidoEntregaCD(strEmpSav);

        If blnEmitirNovoPedidoEntregaCD Then
        Begin
          If Not fValidaConfiguracoesIguaisEntreAsEmpresasItens(objDesmembrar, True) Then
          Begin
            //Função já gera Raise Exception se houver inconsistência
          End;
        End;

        {*********************************************************************}
        {* Caso for multi-empresa altera a variavel global de empresa logada,*}
        {* carrega as configuracoes e verifica se permite emitir documento   *}
        {*****************************************************************JC**}
        Self.blnMulLoj := (Not fEmptyStr(arrMatItens[0].strEmpIte)) And
                          (Not SameText (arrMatItens[0].strEmpIte, VS_strCodEmp)) And
                          (Not blnEmitirNovoPedidoEntregaCD);

        strPortadoresOperador := strPortadoresOperadorOri;

        {**********************************************************************}
        {* QUANDO FAZ ENTREGA PELO CD, ONDE HAVERÁ DESMEMBRAMENTO, NÃO PODE   *}
        {* DESMEMBRAR MULTI-LOJA (POR CAUSA DA REPLICAÇÃO), SÓ PODE HAVER     *}
        {* DESMEMBRAMENTO DE TIPOS, EX: ENTREGA/RETIRA                        *}
        {* REQUISITO ( 128250, HORUS )                                        *}
        {*******************************************************************RN*}
        if (Self.blnMulLoj) And
           ((blnEnt_CD) And (Not fSolicitaEmpresaNoItemMultLoja)) And
           ((fEmpresaUsaReplicacao(strEmpSav)) Or fEmpresaUsaReplicacao(arrMatItens[0].strEmpIte)) then
        begin
          Self.blnMulLoj := False;
        end;

        If (Self.blnMulLoj) And (Not SameText (arrMatItens[0].strEmpIte, VS_strCodEmp)) Then
        Begin
          If fCfgSis('DACPOR', varBoolean, arrMatItens[0].strEmpIte) Then
          Begin
            strPortadoresOperador := fRetPortadoresOperador(strLoginUsuarioLogado);
          End;
        End;

        If Not fApenasSimulandoVenda Then
          If (fltBolAdt > 0) Or blnBolVen Then
            Raise Exception.Create('Documento sendo desmembrado possui boleto de '+
              'adiantamento ainda não quitado, não é possível desmembrar o mesmo!') ;

        {*********************************************************************}
        {* Caso for multi-empresa altera a variavel global de empresa logada,*}
        {* carrega as configuracoes e verifica se permite emitir documento   *}
        {*****************************************************************JC**}
        If Self.blnMulLoj Or fEmitirNotaServicoOutraEmpresaF11 Then
        Begin
          {***********************************************************}
          {* Define a empresa para emissao do Nota de servico no F11 *}
          {*******************************************************JC**}
          If fEmitirNotaServicoOutraEmpresaF11 Then
          Begin
            pSetarEmpresaLogada(strEmpEmissaoNotaServicoF11, strEmpEmissaoNotaServicoF11);
          End
          Else
          Begin
            If Not fEmptyStr(arrMatItens[0].strEmpIte) Then
              pSetarEmpresaLogada(arrMatItens[0].strEmpIte, arrMatItens[0].strEmpIte);
          End;

          {*****************************************************}
          {* Quando for multiloja não pode utilizar Replicacao *}
          {*************************************************JC**}
          If fCampoEmpresasNoServidorPreenchido(strEmpSav, VS_strCodEmp) Then
          Begin
            If Not fEmpresasNoMesmoServidor(strEmpSav, VS_strCodEmp) Then
            Begin
              Raise Exception.Create('Não é possível faturar este documento da ' +
                                     'empresa ' + VS_strCodEmp + ' na empresa ' +
                                     strEmpSav + ', pois as mesmas não estão ' +
                                     'no mesmo servidor.');
            End;
          End
          Else If fEmpresaUsaReplicacao(strEmpSav) Then
          Begin
            Raise Exception.Create('Não é possível emitir a venda multiloja, ' +
                                   'pois a empresa ' + strEmpSav + ' está ' +
                                   'configurada para utilizar Replicação.');
          End
          Else If fEmpresaUsaReplicacao(VS_strCodEmp) Then
          Begin
            Raise Exception.Create('Não é possível emitir a venda multiloja, ' +
                                   'pois a empresa ' + VS_strCodEmp + ' está ' +
                                   'configurada para utilizar Replicação.') ;
          End;

          {**********************************************************************}
          {* Quando for multiloja não pode baixar as duplicatas automaticamente *}
          {******************************************************************JC**}
          If fBaixaDuplicataAVista(VS_strCodEmp) And fEmptyStr(strEmpLog) Then
          Begin
            Raise Exception.Create('Não é possível emitir a venda multiloja, ' +
                                   'pois a empresa ' + VS_strCodEmp + ' está ' +
                                   'configurada para "Baixar duplicata caso seja ' +
                                   'à vista pela Venda Normal". ' +
                                   'Favor verificar a configuração nesta empresa ' +
                                   'antes de prosseguir com a venda!');
          End;

          {******************************************************************}
          {* Quando for multiloja somente permite emitir NFe, pois não tem  *}
          {* como imprimir uma nota de formulario de outra loja.            *}
          {* Outra observação: somente pode ser utilizada quando tem um     *}
          {* único servidor, Replicação nem pensar                          *}
          {***************************************************************JC*}
          If Not fCfgSis('NFEUSA', varBoolean, VS_strCodEmp) And (Pos(strEspDoc, 'NF_EL_IF_NS_') > 0) Then
          Begin
            Raise Exception.Create('Não é possível emitir a venda multiloja, ' +
                                   'pois a empresa ' + VS_strCodEmp + ' não está ' +
                                   'configurada para "Utilizar Nota Fiscal Eletronica". ' +
                                   'Favor verificar a configuração nesta empresa ' +
                                   'antes de prosseguir com a venda!');
          End;
        End;

        {***************************************************}
        {* Seta a empresa de origem para gravar o contas   *}
        {* a receber e movdet (CTR_EMP_PD, DET_EMP_PD).    *}
        {* Tambem define quais produtos devem ser baixados *}
        {* no pedido referente a venda emitida             *}
        {************************************************JC*}
        strLisDet := '';
        For intItens := Low(arrMatItens) To High(arrMatItens) Do
        Begin
          If fEmptyStr(arrMatItens[intItens].strEmpOrc) Then
            arrMatItens[intItens].strEmpOrc := strEmpOri;

          If fEmptyStr(arrMatItens[intItens].strSeqDet) And fEhItemServico(arrMatItens[intItens].strCodIte) Then
          Begin
            pIncrementaListaStr(fCampoTabela('AUTOINCREM','FATDOR', ['FDO_NUMDOC', 'FDO_ESPDOC', 'FDO_CODEMP', 'FDO_CODITE'],
                                            [arrMatItens[intItens].strNumOrc,
                                             arrMatItens[intItens].strEspOrc,
                                             arrMatItens[intItens].strEmpOrc,
                                             arrMatItens[intItens].strCodIte]), strLisDet, True);
          End
          Else
            pIncrementaListaStr(arrMatItens[intItens].strSeqDet, strLisDet, True);
        End;

        {******************************************************************}
        {* define as variavies de entrega no faturamento e entrega futura *}
        {**************************************************************JC**}
        Self.strEntFut := IIF(arrMatItens[0].strEntFut = 'S', 'S', 'N');
        // Se for confirmação segue a configuração fCfgSis('SUJROM') (vide fatVenda.CreateInstance -> pCarregaCfgSis)
        If (Not fConfirmacaoComEntregaRetiraDefinidaPelaSujRom) And (strOpcDoc <> 'DV') Then
          Self.strEntFat := IIF(arrMatItens[0].strEntRet = 'E', 'S', 'N');

        {**********************************************************}
        {* Se for gerar Romaneio de entrega (Self.strEntFat = 'S')*}
        {******************************************************JC**}
        If (Self.strEntFat = 'S') Then
        Begin
          If (Self.strEntFut = 'N') Then
            Self.dtaDtEntr := arrMatItens[0].dtaDtEntr;

          If (Self.dtaDtEntr < VS_Date) Then
            Self.dtaDtEntr := VS_Date + fCfgSis('QMDPEI', varInteger, fGetEmpConfigEntrega(arrMatItens[0]));

          If Assigned(objConEnt) Then
          Begin
            If (Self.strEntFut = 'N') Then
              objConEnt.pSetDataEntrega(dtaDtEntr);

            If (Self.strEntFut = 'S') Then
              dtaDtEntr := objConEnt.fGetDataEntrega;
          End;

          {**************************************************}
          {* restaura as informacoes do endereco de entrega *}
          {**********************************************JC**}
          Self.enderecoEntrega := recEndEntSav;
        End
        Else
        Begin
          If (Not fCfgSis('ENDRET', VarBoolean)) Then
          Begin
            {*********************************************************}
            {* Limpa o endereco de entrega quando nao gerar romaneio *}
            {*****************************************************JC**}
            Self.dtaDtEntr := 0;
            FillChar(Self.enderecoEntrega, SizeOf(Self.enderecoEntrega), #0);
          End;
        End;

        {**********************************************************************}
        {* NAO SEI PORQUE MOTIVO A ESPECIE DO DOCUMENTO ESTA SENDO REMOVIDA   *}
        {* DENTRO DA PCALCULATOGER, ENTAO ESTOU SALVANDO E DEPOIS RESTAURANDO *}
        {*******************************************************************JC*}
        pSetBackupVar(['strEspDoc']);
        pCalculaTotGer(True);
        pGetBackupVar(['strEspDoc']);

        {*************************************************************}
        {* Caso for nota fiscal de servicos altera a especie para NS *}
        {*********************************************************JC**}
        If (fltTotSer > 0) And (Pos(strEspDoc, 'NF_EL_IF_IV_') > 0) And
           (fCfgSis('EMPSER') <> 'PREFEITURA DE BRASILIA')Then
        Begin
          strEspDoc := 'NS';
        End
        Else If (fltTotSer > 0) And (strOpcDoc = 'VS') And (fCfgSis('EMPSER') = 'PREFEITURA DE BRASILIA')Then
          strEspDoc := 'NF';

        strLisDetSer.strLisCodIteSer := '';
        strLisDetSer.strLisFdoSeqGer := '';
        If (Self.fltTotSer > 0) And (Self.fltTotPro <= 0) Then
        Begin
          strLisDetSer := fRetLisDetSer;
        End;

        {***************************************************************}
        {* Caso for nota fiscal de servicos e pede endereco de entrega *}
        {**********************************************************JC***}
        If (strEspDoc = 'NS') And (blnPedeEndEntregaServicos Or blnUsaEndEntregaServicosPedidoOrcamento) Then
        Begin
          Self.enderecoEntrega := recEndEntSav;
        End;

        {**************************************************************************}
        {* CASO SEJA CUPOM, MUDA PARA NOTA POIS ENTREGA FUTURA NÃO PODE SER CUPOM *}
        {***********************************************************************AF*}
        If (fCfgSis('CUPNOT', varInteger) = 1) And (strEntFut = 'S') And (strEspDoc = 'IF') And (Not fCfgSis('HEFCOE', varBoolean)) Then
          strEspDoc := 'NF';

        {****************************************************************************}
        {* CASO SEJA CUPOM, MUDA PARA NOTA POIS ENTREGA IMEDIATA NÃO PODE SER CUPOM *}
        {*************************************************************************PZ*}
        If (fCfgSis('CUPENT', varInteger) = 1) And (strEntFut = 'N') And (strEntFat = 'S') And (strEspDoc = 'IF') Then
          strEspDoc := 'NF';

        {*********************************************************************************}
        {* CASO SEJA CUPOM, POREM NAO SEJA A EMPRESA LOGADA, DEVE EMITIR UMA NOTA FISCAL *}
        {******************************************************************************JC*}
        If fEmiteNotaFiscalParaCupomOutraLoja Then
        Begin
          If (Not fPermiteEmitirDuasNFCesMultLoja(strEspDoc)) Then
            strEspDoc := 'NF';
        End;

        {****************************************************************************************}
        {* CASO SEJA EMISSAO DE MEIA NOTA COM NOTA NORMAL, E SEJA A EMISSAO DOS ITENS COM NOTA  *}
        {*************************************************************************************JC*}
        If fMeiaNotaComNotaNormalGerandoApenasNF(blnDesmembrarMeiaNotaComNotaNormal, arrMatItens[0].blnMeiaNotaFatorExpedicao) Then
          strEspDoc := 'NF';

        {***************************************************************************}
        {* Sistema configurado para "Gerar novo Pedido de Venda com itens de       *}
        {* entrega imediata ou retira em outra loja quando faturar um pedido       *}
        {* pelo F11 do Resumo de Caixa?"                                           *}
        {************************************************************************JC*}
        pDefineSeGeraNovoPedidoEntregaImediata(strEmpSav);
        pDefineSeGeraNovoPedidoRetiraOutraLoja(strEmpSav);
        pDefineSeGeraNovoPedidoRetiraMesmaLoja(strEmpSav);
        pDefineSeGeraNovoPedidoRetiraExpedicao(strEmpSav);
        pDefineSeGeraNovoPedidoAbastecimentoItens(strEmpSav);

        If fFatEmpresaSemSaldoEstoque Then
        Begin
          pSetarEmpresaLogada(strEmpFatSemSaldo, strEmpFatSemSaldo);
          blnAlterouEmpresaLogada := True;
        End;

        {**********************************************************************************************}
        {* Caso estiver faturando um PD/OR que tem separação de retira ajusta a variável de separação *}
        {******************************************************************************************VA**}
        pSetaSeparadorExpedicao;

        {***************************************************************************}
        {* Quando for servico nao ira gravar desconto, frete e despesas acessorias *}
        {***********************************************************************JC**}
        If (fltTotSer > 0) Then
        Begin
          fltDesEsp := 0;
          fltValFre := 0;
          fltDesAce := 0;
          fltFreRat := 0;
          fltFreSug := 0;
          fltFreCot := 0;
        End

        {**********************************************************}
        {* Calcula o valor do Frete, desconto especial e          *}
        {* despesas acessorias proporcional ao valor do documento *}
        {******************************************************JC**}
        Else If Length(objDesmembrar.MatrizesItens) > 1 Then
        Begin

          If intIndDoc = Length(objDesmembrar.MatrizesItens) -1 Then
          Begin
            fltDesEsp := fFormataFloat(fltDesSav, 4) - fFormataFloat(fltTotDes, 4);
            fltValFre := fFormataFloat(fltFreSav, 4) - fFormataFloat(fltTotFre, 4);
            fltFreRat := fFormataFloat(fltFreRatSav, 4) - fFormataFloat(fltTotFreRat, 4);
            fltFreSug := fFormataFloat(fltFreSugSav, 4) - fFormataFloat(fltTotFreSug, 4);
            fltFreCot := fFormataFloat(fltFreCotSav, 4) - fFormataFloat(fltTotFreCot, 4);
            fltTaxEnt := fFormataFloat(fltTaxEntSav, 4) - fFormataFloat(fltTotTaxEnt, 4);
            fltDesAce := fFormataFloat(fltAceSav, 4) - fFormataFloat(fltTotAce, 4);
          End Else
          Begin
            fltDesEsp := fltDesEspSomaItens;
            fltValFre := fltValFreSomaItens;
            fltFreRat := fltValFreRatSomaItens;
            fltFreSug := fltValFreSugSomaItens;
            fltFreCot := fltValFreCotSomaItens;
            fltTaxEnt := fltValTaxEntSomaItens;
            fltDesAce := fltDesAceSomaItens;
          End;

        End

        Else
        Begin
          fltDesEsp := fltDesSav;
          fltValFre := fltFreSav;
          fltFreRat := fltFreRatSav;
          fltFreSug := fltFreSugSav;
          fltFreCot := fltFreCotSav;
          fltTaxEnt := fltTaxEntSav;
          fltDesAce := fltAceSav;
        End;

        {*************************************************************************}
        {* Acumula o valor do Frete, desconto especial e despesas ja utilizados  *}
        {*********************************************************************JC**}
        fltTotDes    := fltTotDes    + fltDesEsp;
        fltTotFre    := fltTotFre    + fltValFre;
        fltTotFreRat := fltTotFreRat + fltFreRat;
        fltTotFreSug := fltTotFreSug + fltFreSug;
        fltTotFreCot := fltTotFreCot + fltFreCot;
        fltTotTaxEnt := fltTotTaxEnt + fltTaxEnt;
        fltTotAce    := fltTotAce    + fltDesAce;

        fltPorDes := fltPorDesSav;

        {***************************************************************************}
        {* Insere um produto com o valor do frete e zera o valor do frete do cupom *}
        {*********************************************************************JC****}
        If (strEspDoc = 'IF') And fCfgSis('FRECUP', VarBoolean) Then
        Begin
          pInsereItemFreteNoCupomFiscal;
        End;

        pAplicarFreteComoAcrescimoNFCe();

        pCalculaTotGer;

        {***************************************************************}
        {* Calcula o valor do contas a receber para nota de servicos e *}
        {* nota(s) de produtos (retira, entrega...)                    *}
        {************************************************************JC*}
        If fltTotSer > 0 Then
        Begin
          {*******************************************************************}
          {* Como nota de servico nao entra no rateio grava o valor original *}
          {***************************************************************JC**}
          fltTotCadRec := fltTotCadRecSer;
          fltDupRec    := 0;
        End

        Else If Length(objDesmembrar.MatrizesItens) > 1 Then
        Begin

          If intIndDoc = Length(objDesmembrar.MatrizesItens) -1 Then
          Begin
            fltTotCadRec := fltTotCadRecIte - fltTotCad;
            fltDupRec    := fltRecSav - fltTotRec;

            If (fFormataFloat(fltTotGer - fltTotCadRec, 2) = TOLERANCIA_DIFERENCA_DESMEMBRAMENTO) Then
              fltTotCadRec := fltTotCadRec + TOLERANCIA_DIFERENCA_DESMEMBRAMENTO;
          End Else
          Begin
            {*******************************************************************************}
            {* TOTAL DO DOCUMENTO COM DESCONTO / TOTAL DO DOCUMENTO ORIGINAL COM DESCONTO  *}
            {* TEM QUE PEGAR OS VALORES JA COM DESCONTO                                    *}
            {* POIS O DESCONTO É DADO SOMENTE PARA OS ITENS FORA DE PROMOCAO               *}
            {***************************************************************************LA**}
            If (fltTotSavComDesconto > 0) Then 
            Begin
              {*******************************************************************************}
              {* Se tiver gravando Produtos de Brinde e Serviço de Brinde na mesma operação  *}
              {* e esses não forem faturados juntos com o documento de origem trata nesse    *}
              {* ponto os respectivos CADREC                                                 *}
              {***************************************************************************VA**}
              If (fCfgSis('VENBRI') = 'N') And 
                 (objDesmembrar.fTemMatrizDoTipo(matDesProdutoDeBrinde) And objDesmembrar.fTemMatrizDoTipo(matDesServicoDeBrinde)) And 
                 ((objDesmembrar.MatrizTipoMatriz[intIndDoc] In [matDesProdutoDeBrinde, matDesServicoDeBrinde])) Then
              Begin
                fltTotCadRec := 0;
                fltDupRec    := 0;
              End
              Else  
              Begin
                If ((fCfgSis('VENBRI') = 'N') And (objDesmembrar.fTemMatrizDoTipo(matDesProdutoDeBrinde))) Or
                   objDesmembrar.fTemMatrizSomenteItensBrinde() Then
                Begin
                  fltTotCadRec := RoundTo(fltTotCadRecIte * (fltTotGer / fltTotSavComDesconto), -2);
                  fltDupRec    := RoundTo(fltRecSav * (fltTotGer / fltTotSavComDesconto), -2);
                End
                Else
                Begin
                  fltTotCadRec := RoundTo(fltTotCadRecIte * ((fltTotGer - fltTotProBri) / (fltTotSavComDesconto - fltTotProBriSav)), -2);
                  fltDupRec    := RoundTo(fltRecSav * ((fltTotGer - fltTotProBri) / (fltTotSavComDesconto - fltTotProBriSav)), -2);
                End;

                If IsNan(fltDupRec) Then
                  fltDupRec := 0;

                If IsNan(fltTotCadRec) Then
                  fltTotCadRec := 0;
              End;
            End 
            Else 
            Begin
              fltTotCadRec := 0;
              fltDupRec    := 0;
            End;
          End;

          fltTotCad := fltTotCad + fltTotCadRec;
          fltTotRec := fltTotRec + fltDupRec;
        End
        Else
        Begin
          fltTotCadRec := fltTotCadRecIte;
          fltDupRec    := fltRecSav;
        End;

        If (Not blnInformouPeso) Then
          pCalculaPesBruLiq;

        pDestacaRetencoes;
        pCalculaTotGer;

        pRateiaValores;

        If Assigned(pgbStatus) Then
          pgbStatus.Position := 0;

        {*************************************************************************************************}
        {* Precisamos Montar as Duplicatas de Forma Proporcional aos Vencimentos digitados originalmente *}
        {* Ex: 100,00 seria em 02.030.060 -> 50,00 e 50,00                                               *}
        {*     Porém pode ter sido digitado manualmente 20,00 e 80,00                                    *}
        {*     Assim a primeira representa 20% do valor total e a segunda 80% do mesmo valor             *}
        {*********************************************************************************************JC**}
        Result := fMontaArrDuplicatasProporcionalAoOriginal(Self.fltImpFre);

        If fApenasSimulandoVenda Then
        Begin
          Continue;
        End;

        pSetBackupVar(['blnResCaiAdt']);
        FillChar(Self.FRecMod, SizeOf(Self.FRecMod), #0);
        pGetBackupVar(['blnResCaiAdt']);

        {******************************************************}
        {* CARREGA O VALOR DA PARCELA DOS CREDITOS UTILIZADOS *}
        {***************************************************JC*}
        If (intSeqDupBaiUtiCred > -1) Then
        Begin
          fltValCre         := arrDuplicata[intSeqDupBaiUtiCred].curValor * (-1);
          fltCredUtilizados := arrDuplicata[intSeqDupBaiUtiCred].curValor;
        End
        Else
          fltValCre := fCalculaValorModalidade( recModOri.fltValCre, recModTot.fltValCre );

        {***********************************************************}
        {* CARREGA O VALOR DA PARCELA DOS ADIANTAMENTOS DO CLIENTE *}
        {********************************************************JC*}
        If (intSeqDupBaiAdtCli > -1) Then
          fltValAdt := arrDuplicata[intSeqDupBaiAdtCli].curValor
        Else
          fltValAdt := fCalculaValorModalidade( recModOri.fltValAdt, recModTot.fltValAdt );

        {**************************************************************************************************************}
        {* Calcula os valores do Troco de cheque a vista/pre, de cartão e dinheiro Proporcional ao valor do documento *}
        {*******************************************************************************************************JC\GD**}
        optTroco         := recModOri.optTroco;
        optTrocoPre      := recModOri.optTrocoPre;
        optTrocoCar      := recModOri.optTrocoCar;
        optTrocoDinheiro := recModOri.optTrocoDinheiro;

        fltValorTroco         := fCalculaValorModalidade( recModOri.fltValorTroco    , recModTot.fltValorTroco     );
        fltValorTrocoPre      := fCalculaValorModalidade( recModOri.fltValorTrocoPre , recModTot.fltValorTrocoPre  );
        fltValorTrocoCar      := fCalculaValorModalidade( recModOri.fltValorTrocoCar , recModTot.fltValorTrocoCar  );
        fltValorTrocoDinheiro := fCalculaValorModalidade( recModOri.fltValorTrocoDinheiro , recModTot.fltValorTrocoDinheiro  );

        {***********************************************************************************}
        {* Calcula os valores das modalidades (A Vista) Proporcional ao valor do documento *}
        {*******************************************************************************JC**}
        fltValDin := fCalculaValorModalidade( recModOri.fltValDin, recModTot.fltValDin );
        fltValCqV := fCalculaValorModalidade( recModOri.fltValCqV, recModTot.fltValCqV );
        fltValCqP := fCalculaValorModalidade( recModOri.fltValCqP, recModTot.fltValCqP );
        fltValCar := fCalculaValorModalidade( recModOri.fltValCar, recModTot.fltValCar );
        fltValOrd := fCalculaValorModalidade( recModOri.fltValOrd, recModTot.fltValOrd );
        fltValFin := fCalculaValorModalidade( recModOri.fltValFin, recModTot.fltValFin );
        fltVlARec := fCalculaValorModalidade( recModOri.fltVlARec, recModTot.fltVlARec );//A receber (grava a vista em aberto)

        {***********************************************************************************}
        {* Calcula os valores das modalidades (A Prazo) Proporcional ao valor do documento *}
        {*******************************************************************************JC**}
        fltFatura := fCalculaValorModalidade( recModOri.fltFatura, recModTot.fltFatura );
        fltValVle := fCalculaValorModalidade( recModOri.fltValVle, recModTot.fltValVle );

        If blnExpedi Then
        Begin
          stlPedTmp := TStringList.Create;

          For intItens := Low(arrMatItens) To High(arrMatItens) Do
          Begin
            strDocExpTmp := arrMatItens[intItens].strNumOrc + '-' +
                            arrMatItens[intItens].strEspOrc + '-' +
                            arrMatItens[intItens].strEmpOrc + ' / ';

            If (stlPedTmp.IndexOf(strDocExpTmp) = -1) Then
            Begin
              strDocExp := strDocExp + strDocExpTmp;
              stlPedTmp.Add(strDocExpTmp);
            End;
          End;

          FreeAndNil(stlPedTmp);

          If Not fEmptyStr(strDocExp) Then
            strDocExp := LeftStr(strDocExp, Length(strDocExp) -3);
        End;

        If ((strOriF11 = 'S') And (fCfgSis('RCXVOL', varBoolean))) Or
           (fRecalculaVolumes) Then
          intQtdTra := Floor(fRetVolumes);

        pAcertaDescricaoCfop;

        Result := Result And fAcertaValoresFinanceiraDesmembramento(fltTotGer - fltDesAce, fltTotGerTmp, (intIndDoc = Length(objDesmembrar.MatrizesItens) - 1));

        {********************************************}
        {* RESTAURA O LOG DAS LIBERAÇÕES DAS TRAVAS *}
        {*****************************************PZ*}
        pRestauraLogLibOriginal;

        {***********************************}
        {* Realiza a gravacao do documento *}
        {*******************************JC**}
        Result := Result And fGravaArquivos(pgbStatus);

        {*****************************************************************************}
        {* Acumula o valor das modalidades Gravadas para acertar o resumo de caixa   *}
        {* é necessario acumular apos a gravacao do documento pois o valor do troco  *}
        {* é gravado na modalidade dinheiro/cartão.                                  *}
        {*************************************************************************JC**}
        recModRcx.fltValCqP := recModRcx.fltValCqP + Self.FRecMod.fltValCqP;
        recModRcx.fltValCqV := recModRcx.fltValCqV + Self.FRecMod.fltValCqV;
        recModRcx.fltValDin := recModRcx.fltValDin + Self.FRecMod.fltValDin;
        recModRcx.fltValCar := recModRcx.fltValCar + Self.FRecMod.fltValCar;
        recModRcx.fltValOrd := recModRcx.fltValOrd + Self.FRecMod.fltValOrd;
        recModRcx.fltFatura := recModRcx.fltFatura + Self.FRecMod.fltFatura;
        recModRcx.fltValCre := recModRcx.fltValCre + Self.FRecMod.fltValCre;
        recModRcx.fltValVle := recModRcx.fltValVle + Self.FRecMod.fltValVle;
        recModRcx.fltValFin := recModRcx.fltValFin + Self.FRecMod.fltValFin;
        recModRcx.fltVlARec := recModRcx.fltVlARec + Self.FRecMod.fltVlARec;

        {***********************************************************}
        {* ACUMULA OS CRÉDITOS GERADOS NAS RESPECTIVAS MODALIDADES *}
        {********************************************************RN*}
        If (Self.FRecMod.optTroco = otCredito) And (Self.FRecMod.fltValorTroco > 0) Then
          recModRcx.fltValCqV := recModRcx.fltValCqV + Self.FRecMod.fltValorTroco;

        If (Self.FRecMod.optTrocoPre = otCredito) And (Self.FRecMod.fltValorTrocoPre > 0) Then
          recModRcx.fltValCqP := recModRcx.fltValCqP + Self.FRecMod.fltValorTrocoPre;

        If (Self.FRecMod.optTrocoCar = otCredito) And (Self.FRecMod.fltValorTrocoCar > 0) Then
          recModRcx.fltValCar := recModRcx.fltValCar + Self.FRecMod.fltValorTrocoCar;

        If (Self.FRecMod.optTrocoDinheiro = otCredito) And (Self.FRecMod.fltValorTrocoDinheiro > 0) Then
          recModRcx.fltValDin := recModRcx.fltValDin + Self.FRecMod.fltValorTrocoDinheiro;

        {***********************************************************************}
        {* Limpa as informacoes da Financeira para nao gravar em duplicidade   *}
        {*******************************************************************JC**}
        If Assigned(objFinanc) Then
        Begin
          objFinanc.pLimpaDados;
          objFinanc.pRestaurarCopiaSeguranca;
        End;

        If (blnUltimoDocumento Or Self.blnGravouCadChq) Then
        Begin
          {***********************************************************************}
          {* Limpa as informacoes do Cheques a Vista nao gravar em duplicidade   *}
          {*******************************************************************JC**}
          If Assigned(cdsChequeVis) Then
            cdsChequeVis.EmptyDataSet;

          {******************************************************************}
          {* Limpa as informacoes do Cheques Pre nao gravar em duplicidade  *}
          {**************************************************************JC**}
          If Assigned(cdsChequePre) Then
            cdsChequePre.EmptyDataSet;
        End;
        
        {*******************************************************************}
        {* Limpa as informacoes dos cartoes para nao gravar em duplicidade *}
        {***************************************************************JC**}
        Self.blnGravouMovCar := fGravouMovCarConformeVariaveisDoCaixa(Self.blnGravouMovCar) ;
        If (blnUltimoDocumento Or Self.blnGravouMovCar) Then
        Begin
          SetLength(arrCartoes, 0);
        End;  

        {************************************************}
        {* SETA A ULTIMA EMPRESA QUE GRAVOU O DOCUMENTO *}
        {********************************************JC**}
        strEmpAnt := VS_strCodEmp;

        If Not Result Then
          Break;

      End;

      strPortadoresOperador := strPortadoresOperadorOri;

      If fApenasSimulandoVenda Then
      Begin
        pCancelandoGravacao;
        Exit;
      End;

      {*****************************}
      {* Restaura a empresa logada *}
      {*************************JC**}
      If Self.blnMulLoj Or blnAlterouEmpresaLogada Then
      Begin
        pSetarEmpresaLogada(strEmpSav, strPedEmpSav);
      End;

      {******************************************************************}
      {* Sintetiza as modalidades de pagamento no primeiro documento    *}
      {* e zera nos demais, todos estao com o mesmo seqcon, inclusive   *}
      {* cheques e cartões utilizados no recebimento da venda.          *}
      {* Isto é feito para ficar gravado como se estivesse recebendo    *}
      {* varias duplicatas no caixa.                                    *}
      {**************************************************************JC**}
      Result := Result And fAcertaModalidadesCadRcx(intSeqConRcx, recModRcx);

      If (blnGravandoVariosDocumentos) Then Begin
        If (fFormataFloat(recModRcx.fltValCar, 2) <> 0.00) Then
          Result := Result And fAcertaHistoricoMovCar(arrCartoesSav, strCodCli, VS_strCodEmp, objFatVendaImp);

        If (fFormataFloat(recModRcx.fltValCqV, 2) <> 0.00) Or (fFormataFloat(recModRcx.fltValCqP, 2) <> 0.00) Then
          Result := Result And fAcertaHistoricoCheque();
      End;

      {*******************************}
      {* ANALISA GRAVAÇÃO DO CAIXA   *}
      {*26/02/2015*REQ:22285*******AF*}
      If Result And blnCfgGravaResCai And blnValGravaResCai And (Not fVerificaGrvCaixa(strDifVal, intSeqConRcx)) Then
      Begin
        Raise ExceptionAutcom.Create('Ocorreu uma inconsistência na gravação dos valores do caixa!' + #13#10 + strDifVal + #13#10 +
                                     'Tente realizar a gravação novamente! Se o problema persistir entre em contato com a Citel!');
      End;

      If Result Then
      Begin
        {**********************************************************************}
        {* Antes mesmo de emitir a nfe ja vai gravar o lognfe para caso       *}
        {* ocorra qualquer erro ja estaja gravado e o usuario possa executar  *}
        {* o envio pelo f1 no painel...                                       *}
        {*******************************************************************JC*}
        For intIndDoc := 0 To objFatVendaImp.ItemsCount -1 Do
        Begin
          documento := objFatVendaImp[intIndDoc];

          Self.blnGerNfe := documento.blnGerNfe;
          Self.strPonImp := documento.strPonImp;

          If fDeveEmitirNotaEletronica(documento.strEspDoc, documento.strEmpDoc, blnPainelNfe) And blnPainelNfe Then
            pGravarLogNfe(documento.strNumDoc, documento.strEspDoc, documento.strEmpDoc,
                          documento.strSerFsc, documento.strCodCli, 'C', 'EE', 'Utilize F1 do Painel para Reenviar...',
                          '',
                          0,
                          '',
                          Self.intViaNfe);

          {********************************************************************************}
          {* SE O PEDIDO POSSUIR CREDITO DE ADIANTAMENTOS DEVE BAIXAR ESTA SALDO E LANCAR *}
          {* NO CONTAS A RECEBER DO CLIENTE ATRAVES DE DOCUMENTO DE CREDITO "CC"          *}
          {*****************************************************************************JC*}
          Result := Result And fGerarCreditoSaldoAdiantamento(fRetPedidosDosItens(documento.arrMatItens));

          If Not Result Then
            Break;
        End;

        If (Result) And (strEspDoc = 'PD') And (fCfgSis('USAVBT', varString) = 'S') Then
        Begin
          If fGravarPenRecDesmembramento  Then
          Begin
            If fCfgSis('GFPVBT', varBoolean) Then
            Begin
              pCarregaTrocaRecebimento(Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, Self.strCodCli, True);
            End;
          End;
        End;
      End;

      Result := Result And fVerificaCartaoCheque;

      If (Result) Then
      begin
        if not FAuditFaturamento.fValidouTodas(strCodErrosAuditoria) then
        begin
          Result := False;
          fRollBack;
          pCancelandoGravacao;
          pMostraErrosAuditoria(strCodErrosAuditoria);
          Exit;
        end;

        if not FAuditoriaSaldo.fValidouTodas(strCodErrosAuditoria) then
        begin
          Result := False;
          fRollBack;
          pCancelandoGravacao;
          pMostraErrosAuditoria(strCodErrosAuditoria);
          Exit;
        end;

        If (Not FAuditoriaResumoCaixa.ValidouTodas(strCodErrosAuditoria)) Then
        Begin
          Result := False;
          fRollBack;
          pCancelandoGravacao;
          pMostraErrosAuditoria(strCodErrosAuditoria);
          Exit;
        End;

        If FAuditaGravacaoConfirmacao Then
        Begin
          If (fCampoTabela('COUNT(AUTOINCREM)', strTabelaConfMi, ['TMP_REGFAT'], ['N']) > 0) Then
          Begin
            Result := False;
            fRollBack;
            pCancelandoGravacao;
            fMensagem('ATENÇÃO!','Ocorreu uma inconsistência na marcação dos documentos faturados!' + #13#10 +
                                 'Tente realizar a gravação novamente! Se o problema persistir entre em contato com a Citel!', ['&OK']);
            Exit;
          End;
        End;
      end;

      {************************************************************}
      {* caso gravou todos os documento entao comita a transacao  *}
      {* uma unica transacao, senao ira cancelar a transacao      *}
      {********************************************************JC**}
      If Result Then
      Begin
        fCommit(frmModulo.GetCurrentConnection, LSafeCommitID);

        pExibeMensagemErroAoCarregarPonImp;

        if Assigned(objRomFusTarefas) then
          objRomFusTarefas.pProcessarTarefas;

        Self.blnGravouDocumentos := True;

        objNotificacoes.pGravaNotificacoes(blnExecutandoFaturadorAutomatico);

        pGravaNotificacaoPesquisaOpiniOne;

        pGravaBoschFun;
      End
      Else
        fRollBack;

      pAtualizarDadosUltimaCompra;

      {*************************************************************}
      {* Caso gravou todos os documentos, processa os mesmos       *}
      {* para gerar a impressao e o envio das Nfe(s) quando houver *}
      {*********************************************************JC**}
      If Result Then
      Begin
        Self.pgbStatusGravacao := pgbStatus;

        {***************************************************************}
        {* Caso houver mais de um documento para imprimir boleto       *}
        {* nao deve imprimir ainda, pois vai agrupar e depois imprimir *}
        {*********************************************************JC****}
        If (fCfgSis('BOLFAT') = 'L') And //Boleto Laser
           (objFatVendaImp.fQtdeDocsEmitidosImprimemBoleto > 1) And
           (Pos(fCfgSis('AGRBOL'), '_S_P') > 0 ) And
           (fVerificaAcessoSistema('frmAgrupDuplicatas')) Then
        Begin
          If fCfgSis('AGRBOL') = 'S' Then
            objFatVendaImp.blnImpBol := False
          Else
          Begin
            blnNaoAgrupar := fMensagem('', 'Deseja realizar o agrupamento financeiro dos documentos desmembrados?', ['&Sim', '&Não'], 2) = 2;
            objFatVendaImp.blnImpBol := blnNaoAgrupar;
          End;
        End;

        {**************************************************************}
        {* OBJETO CONTENDO TODOS OS DOCUMENTOS DE VENDA EMITIDOS E AS *}
        {* VARIAVEIS NECESSARIAS PARA A IMPRESSAO DOS MESMOS.         *}
        {* TAMBEM É O RESPONSAVEL PELAS IMPRESSOES DO FATURAMENTO     *}
        {**********************************************************JC**}
        With objFatVendaImp Do
        Begin

          If Assigned(pgbStatus) Then
          Begin
            pgbStatus.Position := 0;
            pgbStatus.Properties.Max := objFatVendaImp.ItemsCount;
            pProcessMessages;
          End;

          For intIndDoc := 0 To objFatVendaImp.ItemsCount -1 Do
          Begin
            {********************************************}
            {* Restaura as variaveis necessarias para   *}
            {* realizar o envio das Nfe(s)              *}
            {****************************************JC**}
            Self.strNumDoc := objFatVendaImp[intIndDoc].strNumDoc;
            Self.strEspDoc := objFatVendaImp[intIndDoc].strEspDoc;
            Self.strEmpDoc := objFatVendaImp[intIndDoc].strEmpDoc;
            Self.strSerFsc := objFatVendaImp[intIndDoc].strSerFsc;
            Self.strCodCli := objFatVendaImp[intIndDoc].strCodCli;
            Self.blnGerNfe := objFatVendaImp[intIndDoc].blnGerNfe;
            Self.strPonImp := objFatVendaImp[intIndDoc].strPonImp;

            {********************************************}
            {* restaura a empresa do documento para     *}
            {* pegar as configuracoes corretamente      *}
            {****************************************JC**}
            pSetarEmpresaLogada(Self.strEmpDoc, Self.strEmpDoc);

            {*********************************************}
            {* Executa o envio da nota fiscal eletronica *}
            {*****************************************JC**}
            Try
              fExecutarModal(fEnviarNotaEletronicaPainel, 'Aguarde ...', '');
            Except
              On E: Exception Do
              Begin
                pMensagensErro(E.Message, '');
              End;
            End;

            If ((Not fDocumentoParaFornecedor) And (objNetpoints.fDesejaNetpoints(strEspDoc)) And
                (Not ((strOpcDoc = 'CI') And (blnConfirmandoUtiNps)))) Or
               (fDevolucaoComNetpoints) Then
            Begin
              objNetpoints.pTransmitirNetpoints(strNumDoc,
                                                strEspDoc,
                                                strEmpDoc,
                                                strCodCli,
                                                strSerFsc);
            End;

            If (Self.strEspDoc = 'NF') Then
              pMensagemDocumentoGNRE(Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, Self.strCodCli);


            If Not fEmptyStr(LstrDocumentosMensagemGravacao) Then
              LstrDocumentosMensagemGravacao := LstrDocumentosMensagemGravacao
                                              + ', ';

            LstrDocumentosMensagemGravacao := LstrDocumentosMensagemGravacao
                                            + Concat(Self.strNumDoc,'-',Self.strEspDoc,'-',Self.strEmpDoc);

            pStepStatusGravacao;
          End;

          {*****************************}
          {* Restaura a empresa logada *}
          {*************************JC**}
          If Self.blnMulLoj Then
          Begin
            pSetarEmpresaLogada(strEmpSav, strPedEmpSav);
          End;

          objFatVendaImp.blnPDORMultiLoja := Self.blnMulLoj;

          pColetarAssinaturaEmissaoDocumento;

          {*******************************************************}
          {* REALIZA A IMPRESSAO DE TODOS OS DOCUMENTOS EMITIDOS *}
          {***************************************************JC**}
          If VS_ExibirMensagemAoUsuario Then
          Begin
            If Not Assigned(pgbStatus) Then
              objFatVendaImp.pImprimirDocumentos(nil, nil, Self.objPerguntasImpressaoDocumento, Self.objPerguntasImpressaoSeparacao)
            Else
              objFatVendaImp.pImprimirDocumentos(pgbStatus, TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')), Self.objPerguntasImpressaoDocumento, Self.objPerguntasImpressaoSeparacao);
          End;
        End;

        If fConfirmacaoCupomAgrupandoCadRecCupons Then
        Begin
          If Not fExisteBaixaBoletosDocumentos Then
            pAgruparDuplicatasEmitemBoleto;
        End
        Else
        Begin
          {************************************************************}
          {* Caso houver mais de um documento para imprimir boleto    *}
          {* vai agrupar os mesmos e depois imprimir os boletos       *}
          {********************************************************JC**}
          If (fCfgSis('BOLFAT') = 'L') And //Boleto Laser
             (objFatVendaImp.fQtdeDocsEmitidosImprimemBoleto > 1) And
             ((Pos(fCfgSis('AGRBOL'),'_S_P') > 0) And
             (Not blnNaoAgrupar)) And
             (fVerificaAcessoSistema('frmAgrupDuplicatas')) Then
          Begin
            pAgruparDuplicatasEmitemBoleto;
          End;
        End;

        If VS_ExibirMensagemAoUsuario Then
          pMostraDocumentosGerados;


        pRestaurarVariaveisVenda;
      End
      Else
      Begin
        pCancelandoGravacao;
      End;

    Except
      On E: ExceptionAutcom Do
      Begin
        Result := False;
        fRollBack;
        pCancelandoGravacao;
        pMensagemOk(E.Message);
      End;

      On E: Exception Do
      Begin
        Result := False;
        fRollBack;
        pCancelandoGravacao;
        pMensagensErro(E.Message, '[fGravaArquivosDesmembrando]');
      End;
    End;

    If (fDesmembrarPorCFG_ITEDOC) And
       (Not fEmptyStr(LstrDocumentosMensagemGravacao)) Then
    Begin
      fMensagem('OPERAÇÃO REALIZADA COM SUCESSO!',
                'Foram gerada(s) a(s) seguinte(s) Nota(s) Fiscal(is):' + #13#10 +
                LstrDocumentosMensagemGravacao, ['&Ok']);
    End;
  Finally
    FFoiGravacaoPorDesmembramento := False;
    FAuditaGravacaoConfirmacao := False;
    FreeAndNil(objDesmembrar);
    Self.pgbStatusGravacao := nil;
    Self.strSepExp := strSepExpSav;
    FillChar(Self.recModOriDesmembramento, SizeOf(Self.recModOriDesmembramento), #0);
  End;

end;

function TFatVenda.fRetornaLstPixPago: TList<TDadosRetornoPixConsulta>;
begin
  if Assigned(DadosPixDaVenda.ObjetoPixPago) and (DadosPixDaVenda.LstPixPago.Count = 0) then
    DadosPixDaVenda.LstPixPago.Add(DadosPixDaVenda.ObjetoPixPago) ;

  Result := DadosPixDaVenda.LstPixPago ;
end ;

procedure TFatVenda.pAtribuiCodigoPromocional;
var
  I: Integer;
begin

  For I := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
  begin
    If Self.arrMatItens[I].strPromoc <> 'S'  then
      Self.arrMatItens[I].strCodPro := ''
    Else If fEmptyStr(Self.arrMatItens[I].strCodPro) Then
      Self.arrMatItens[I].strCodPro :=
        fDadosPromocao(Self.arrMatItens[I].strCodIte,
                       fGetEmpPrecoPromoItem(Self.arrMatItens[I].strEmpIte),
                       Self.strCodCli,
                       Self.arrMatItens[I].strTabPre,
                       '',
                       Self.strNumOrc,
                       Self.strEspOrc).strCodPro;
  end;

end;

{*****************************************}
{* EFETUA GRAVAÇÃO E IMPRESSÃO DE DOCU-  *}
{* MENTOS                                *}
{**************************************MV*}
function TFatVenda.fGravaAgeTel(strCodCli, strCodVen: String;
  dtaDtaAge: TDateTime; var strAutInc: string): Boolean;
  Var
    qryAux: TUniQuery;
    strAutoIn: String;
begin
  If (fDocumentoParaFornecedor) Then
  Begin
    Result := True;
    Exit;
  End;

  Result := False;

  Try
    qryAux := fCriaQuery(Self);

    With qryAux,SQL Do
    Begin
      Close;
      Clear;

      Add('INSERT INTO AGETEL                                                                               ');
      Add('(AUTOINCREM, AGE_CODEMP, AGE_CODVEN, AGE_CODCLI, AGE_DTAAGE, AGE_DTABAI, AGE_HORBAI, AGE_OBSERV) ');
      Add('VALUES                                                                                           ');
      Add('(:AUTOIN, :CODEMP, :CODVEN, :CODCLI, :DTAAGE, NULL, NULL, NULL)                                  ');

      strAutoIn := fRetAutoIncrem('AGETEL', VS_strCodEmp);
      strAutInc := strAutoIn;

      ParamByName('AUTOIN').AsString := strAutoIn;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODVEN').AsString := strCodVen;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('DTAAGE').AsDate := dtaDtaAge;

      ExecSQL;
    End;

    Result := True;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;

  FreeAndNil(qryAux);
end;

function TFatVenda.fGravaArquivos(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    strSeqFgoAux: String;
    intContador : Integer;

    LSafeCommitID: Integer;

    blnGraComPro: Boolean;

    reiReimpressao: TReimpressao;

    intContUltPar: Integer;
    strUltPar: String;

    strProdSemLote: String;

    strNumDup: String;

    blnConfirma  : Boolean;


    fltBasComiss,
    fltVlrComiss: Double;

    blnCliConExiste : Boolean;

    arrLivFis : TArrLivFis;

    blnPainelNfe: Boolean;

    blnPrcNumCmp: Boolean;

    strMsgAux: String;
    stlValidacoesNFe: TStringList;

