      {*****************************************}
      {* TE - Transferência de Estoque         *}
      {**************************************MV*}
      If (strEspDoc = 'TE') Then
      Begin

        {***************************************************************************}
        {* CASO A OPCAO ESCOLHIDA NO MENU SEJA TRANSFERENCIA DE ESTOQUE,           *}
        {* EDITANDO UM ORÇAMENTO E CONFIRMANDO  MARCA O ORÇAMENTO COMO JA FATURADO *}
        {************************************************************************LU*}
        If (strOpcDoc = 'TE') And (Pos(strEspOrc, 'OR_PD_') > 0) Then
        Begin
