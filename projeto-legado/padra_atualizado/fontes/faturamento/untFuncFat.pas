    strEntUrg    := qryFatGor.FieldByName('FGO_ENTURG').AsString;
    strPD_Exp    := qryFatGor.FieldByName('FGO_PD_EXP').AsString;

    strEmp_TE    := qryFatGor.FieldByName('FGO_EMP_TE').AsString;
    If (Not fEmptyStr(strEmp_TE)) And (Pos(strOpcDoc,'OR_PD_') > 0) Then
    Begin
      recDadCli.fltFat_TE := fRetClienteFilialFatorTE(strEmp_TE, qryFatGor.FieldByName('FGO_CODCLI').AsString);
      recDadCli.fltFatTE2 := fRetClienteFilialFatorTE_ST(strEmp_TE, qryFatGor.FieldByName('FGO_CODCLI').AsString);
      recDadCli.strTEPREV := fGetTEPREV(strEmp_TE, qryFatGor.FieldByName('FGO_CODCLI').AsString);
      recDadCli.strTEPPRO := fGetTEPPRO(strEmp_TE, qryFatGor.FieldByName('FGO_CODCLI').AsString);
    End;

    strObsL01    := qryFatGor.FieldByName('FGO_OBSL01').AsString;
