      Result := fGravaCadPag(strNomeForm,                                     // Nome Form LOGCTP
                             strDesCtp,                                       // Descrição LOGCTP
                             strCodCli,                                       // Fornecedor
                             strNumDup,                                       // strNumDup
                             arrDuplicata[intContador].strSequen,             // strParcel
                             VS_strCodEmp,                                    // strCodEmp
