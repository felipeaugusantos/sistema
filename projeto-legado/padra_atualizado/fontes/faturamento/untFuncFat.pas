                                 0,
                                 '',
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0);

        End;

        If Not Result Then
          Break;

        Next;
      End; {While}

    End; {With...}

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGRecFin]');
    End;
  End;

