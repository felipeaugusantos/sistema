function TFatVenda.fGravaSepDor(const AAutIncOld, AAutIncNew, ATabela: String; const ASepDor: TMatrizSepDor): Boolean;
var
  LSQL: String;
  LCont: integer;
  LQry: TUniQuery;
begin
  Result := True;

  if (Length(ASepDor) = 0) then
    Exit;

  try
    //Req. 443110/459000 - REPLACE INTO (em vez de INSERT): garantia adicional caso o cascade da FK FDO_SEQGER não tenha removido o registro antigo.
    LSQL := '';
    LSQL := LSQL + ' REPLACE INTO ' + ATabela;
    LSQL := LSQL + '   (AUTOINCREM, SEP_SEQFDO, SEP_QTDCON, SEP_OPECON, SEP_CONFIN, SEP_DTAINI, SEP_DTAFIN) ';
    LSQL := LSQL + ' VALUES ';
    LSQL := LSQL + '   (:AUTINC, :SEQFDO, :QTDCON, :OPECON, :CONFIN, :DTAINI, :DTAFIN) ';

    LQry := fCriaQuery;

    try
      LQry.SQL.Text := LSQL;

      for LCont := 0 to Length(ASepDor) - 1 do
      begin
        if (ASepDor[LCont].strSeqFdo = AAutIncOld) then
        begin
          LQry.Close;
          LQry.ParamByName('AUTINC').AsString   := ASepDor[LCont].strAutInc;
          LQry.ParamByName('SEQFDO').AsString   := AAutIncNew;
          LQry.ParamByName('QTDCON').AsFloat    := ASepDor[LCont].fltQtdCon;
          LQry.ParamByName('OPECON').AsString   := ASepDor[LCont].strOpeCon;
          LQry.ParamByName('CONFIN').AsString   := ASepDor[LCont].strConFin;
          LQry.ParamByName('DTAINI').AsDateTime := ASepDor[LCont].dtaDtaIni;
          LQry.ParamByName('DTAFIN').AsDateTime := ASepDor[LCont].dtaDtaFin;
          LQry.ExecSQL;
        end;
      end;
    finally
      FreeAndNil(LQry);
    end;
  except
    on E: Exception do
    begin
      Result := False;
      pMensagensErro(E.Message, '[fRegravaSepDor]');
    end;
  end;
end;

