function TFatVenda.fConcatRef(strDescri, strRefere: String): String;
begin
  {********************************************************************}
  {* CFG_MONDES - Forma de montagem da descrição do produto na venda: *}
  {*    1 - Descrição + Referencia                                    *}
  {*    2 - Referencia + Descrição                                    *}
  {*****************************************************************RN*}
  If (fCfgSis('MONDES', varString) = '1') Then
    Result := strDescri + IIF(Not fEmptyStr(strRefere), ' ' + strRefere, '')
  Else
    Result := IIF(Not fEmptyStr(strRefere), strRefere + ' ', '') + strDescri;
end;

function TFatVenda.fCondicaoPagamentoValidaLimiteCredito: Boolean;
  Var
    strFormasNaoValida: String;
begin
  Result := fRetCampoCndPagto(strCodCnd, 'CND_LIMCRE');

  If (Not Result) Or (strCodFpg <> '009') Then
    Exit;

  If Not (fCfgSis('TFPF11', varBoolean) Or fCfgSis('SFPGPD', varBoolean)) Then
    Exit;

  If objFormasPagtoNegociada.cdsFormasNegociadas.IsEmpty Then
    Exit;

  strFormasNaoValida := fCampoTabela('CND_FPGNVL', 'CADCND', ['CND_CODIGO'], [strCodCnd]);

  Result := False;

  With objFormasPagtoNegociada.cdsFormasNegociadas Do
  Begin
    First;

    While Not Eof Do
    Begin
      If (FieldByName('CODFPG').AsString = '001') And (Pos('001', strFormasNaoValida) = 0) Then
        Result := True;

      If (FieldByName('CODFPG').AsString = '002') And (Pos('002', strFormasNaoValida) = 0) Then
        Result := True;

      If (FieldByName('CODFPG').AsString = '006') And (Pos('006', strFormasNaoValida) = 0) Then
        Result := True;

      If (FieldByName('CODFPG').AsString = '007') And (Pos('007', strFormasNaoValida) = 0) Then
        Result := True;

      If Pos(FieldByName('CODFPG').AsString, '001_002_006_007_') = 0 Then
        Result := True;

      If Result Then
        Break;

      Next;
    End;

    First;
  End;

end;
{*************************************}
{* VERIFICA / VALIDA LIMITE DE CRE-  *}
{* DITO                              *}
{*************************************}
Function TFatVenda.fVerificaLimiteCredito(strConPag: String; fltLimCli, fltTotalG: Double; blnPedeSenha: Boolean=True; AblnAplicaDescontos: Boolean=True; strCfgSis: string = 'LIMISN'):Boolean;
  Var
    fltTotDis : Double;
    fltSldNes : Double;
    strLimIsn : String;
    strSenLim : String;
    strSenLi2 : String;
    blnNivel2 : Boolean;
    fltLimCre : Double;
    strMsgOco : String;
    objLiberacao : TLiberacao;

    cdsData      : OleVariant;
    recTotMarLuc : TRecTotaisMargemLucro;

    LMensagemLiberacao : TMensagemLiberacao;
    strUltimaAlteracaoCreditoCliente : String;
    strMargemDescricao : String;
Begin

  Result := True;

  FstrCodOcoLimCr := EmptyStr;
  If (fEmptyStr(strConPag)) Then
    Exit;

  {*REQ.185947**********RP*}
  If (strCodFpg = '007') And Not blnLibCre Then
    pRemoverTravaLogAvi('LIMCR', strNTrava);

  If (Pos(strOpcDoc, 'OU_OV_NC_BR_TE_OE_EF_OF_CF_CI_UC_CO_') > 0) Or
     (strCodFpg = '007')                                    Or
     (blnComVal)                                            Then
    Exit;

  If StrTipOpe = 'U' Then
    Exit;

  {**********************************}
  {* PEGA O LIMITE DE CREDITO       *}
  {*******************************JB*}
  fltLimCre := fltLimCli -
               fltTotDeb;

  If Not blnLibCre Then
    pRemoverTravaLogAvi('LIMCR', strNTrava);

  If (fltTotalG > (fltLimCre))  And
     ((fStatusCndPag(strConPag) = A_PRAZO) Or fUsaPerfilECadCnd) Then
  Begin

    {*************************************}
    {* LIBERA A TRAVA DE LIMITE DE CRE-  *}
    {* DITO DEPOIS DE TER SIDO DIGITADO  *}
    {* A SENHA PELA PRIMEIRA VEZ.        *}
    {**********************************WI*}
    If (Not blnLibCre And fCfgSis('PFLCLI', varBoolean) And fCondicaoPagamentoValidaLimiteCredito) Or
       (Not blnLibCre And (Pos(fCfgSis(strCfgSis), 'T_A_') > 0) And (Not fCfgSis('PFLCLI', varBoolean))) Then
    Begin

      fltTotDis := fltLimCre;
      fltSldNes := fltLimCre - fltTotalG;

      If ((Pos(strOpcDoc, 'OR_') > 0) And
         ((strEspDoc = 'OR') Or fEmptyStr(strEspDoc))) Or
         ((Pos(strOpcDoc, 'OR_VN_') > 0) And (strEspDoc = 'OR')) Then
      Begin
        strLimIsn := fCfgSis('LIMCOR');
        strSenLim := fCfgSis('SENLOR');
        strSenLi2 := fCfgSis('SENLO2');
      End
      Else
      Begin
        strLimIsn := fCfgSis(strCfgSis);
        strSenLim := fCfgSis('SENLIM');
        strSenLi2 := fCfgSis('SENLI2');
      End;

      {***********************************}
      {* SE NÃO É PARA AVISAR NEM TRAVAR *}
      {********************************AL*}
      If strLimIsn = 'N' Then
        Exit;

      objLiberacao := TLiberacao.Create;
      try

        {**************************************}
        {* TRATAMENTO DE SENHA FIXA, VARIAVEL *}
        {* OU USUARIO                         *}
        {***********************************WI*}
        objLiberacao.objMsgLibera.pAddTexto('A T E N Ç Ã O - Valor Total Maior Que o Limite de Crédito.');

        strUltimaAlteracaoCreditoCliente := fDataUltimaAlteracaoCreditoCliente(strCodCli);
        if (not fEmptyStr(strUltimaAlteracaoCreditoCliente)) then
          objLiberacao.objMsgLibera.pAddTextoCaption('Data Última Alteração', strUltimaAlteracaoCreditoCliente, 25, alDireita, teAmbos, '', 10);

        objLiberacao.objMsgLibera.pAddTextoCaption('Limite de Crédito', FormatFloat('#,##0.00', fltLimCli), 25, alDireita, teAmbos, '', 10);
        objLiberacao.objMsgLibera.pAddTextoCaption('Débitos Pendentes', FormatFloat('#,##0.00', fltTotDeb), 25, alDireita, teAmbos, '', 10);
        objLiberacao.objMsgLibera.pAddTextoCaption('Disponível'       , FormatFloat('#,##0.00', fltTotDis), 25, alDireita, teAmbos, '', 10);

        If fCfgSis('LIMISN') <> 'A' Then
        Begin
          objLiberacao.objMsgLibera.pAddTextoCaption('Valor desta Venda' , FormatFloat('#,##0.00', fltTotalG), 25, alDireita, teAmbos, '', 10);
          objLiberacao.objMsgLibera.pAddTextoCaption('Diferença'         , FormatFloat('#,##0.00', fltSldNes), 25, alDireita, teAmbos, '', 10);
        End;

        objLiberacao.objMsgLibera.pAddTextoCaption('Condição Pagto'   , IIF(fCfgSis('USACND', varBoolean), strCodCnd+'-'+fRetDesConPag(strCodCnd)+' ', '') + fFormataCondPag(strConPag), 25);
        If fCfgSis('USAFPG', varBoolean) Then
          objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagto' , (strCodFpg+'-'+fRetDescFpg(strCodFpg))                                                          , 25);

        If ((Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (blnLiberacaoRemotaNoFinalVenda)) And
           (
            ( ( ((Pos(strOpcDoc, 'PD_OR_') > 0) And fCfgSis('TFPF11', varBoolean)) Or fCfgSis('SFPGPD', varBoolean) ) And (strCodFpg = '009')) Or
            ((fCfgSis('SOLCAR', varBoolean)) And (strCodFpg = '007'))
           ) Then
        Begin
          If fCfgSis('USAFPG', varBoolean) Then
            objLiberacao.objMsgLibera.pAddTextoCaption('                   ' ,  STRING_FORMAS_PAGTO_NEGOCIADAS , 25)
          Else
            objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagto' ,  STRING_FORMAS_PAGTO_NEGOCIADAS , 25);
        End;

        {Margem de Lucro}
        cdsData := Self.fCalculaMargemLucro(AblnAplicaDescontos);
        Self.pCalculaTotaisMargemLucro(cdsData, recTotMarLuc, 0, False, -1, 0, True);

        if fCfgSis('INTRCC', varInteger) = 1 then
          LMensagemLiberacao := objLiberacao.objMsgLibera
        else
        Begin
          LMensagemLiberacao := objLiberacao.objMsgRemota;
          LMensagemLiberacao.pAddQuebra;
          LMensagemLiberacao.pAddTexto('Conteúdo de acesso ao usuário para liberação:');
          LMensagemLiberacao.pAddQuebra;
        End;

        If (TMargemMinima.UsaPrecoBruto) Then
          strMargemDescricao := 'Margem Bruta da Venda:'
        Else
          strMargemDescricao := 'Margem Líq. da Venda:';

        LMensagemLiberacao.pAddTextoCaption(strMargemDescricao, FormatFloat('#,##0.00', TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, False)), 25);

        objLiberacao.objMsgLibera.pAddQuebra;
        objLiberacao.objMsgRemota.pAddQuebra;

        blnNivel2 := fltTotalG > fStrToFloat(fCfgSis('VLRLCR',varDouble));

        If (Not blnPedeSenha) Then
          pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem,'', blnNivel2, false);

        objLiberacao.strDirAce := 'LIMCR';
        objLiberacao.blnTraTel := (strLimIsn = 'T');
        objLiberacao.strSenLib := strSenLim;
        objLiberacao.strMsgSen := 'Limite de Crédito';
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strDirAceNv2 := 'LIMCR2';
        objLiberacao.strSenLibNv2 := strSenLi2;
        objLiberacao.blnNivel2 := blnNivel2;
        objLiberacao.strCliente := (strCodCli + '-' + strCliOri);
        objLiberacao.strCpfCnpj := strCliCgc;
        objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);
                               
        pMontaMensagem(cdsVenda, LMensagemLiberacao, Nil, False, True, Nil, Nil, AblnAplicaDescontos);

        If blnPedeSenha And fFatMensagemLiberacao(objLiberacao) Then
        Begin
          Result := True;
          blnLibCre := True;
          fltTotGerAntLC := fltTotalG;

          If (VS_strHabilitarCRM) And
            (Not fEmptyStr(fCfgSis('TOCLCR', varString))) And
            (Not fCfgSis('LIBPED', varBoolean)) Then
          Begin
            Try
              strMsgOco := objLiberacao.objMsgLibera.fGetMensagem;

              objOcoCrm := TAtuOcoCrm.Create(Nil);
              objOcoCrm.strNomFrm := '[TFatVenda.fVerificaLimiteCredito]';
              objOcoCrm.strCodCli := strCodCli;
              objOcoCrm.strDtaInc := VS_Date;
              objOcoCrm.strHorInc := fRetHoraServidor();
              objOcoCrm.strDtaAge := objOcoCrm.strDtaInc;
              objOcoCrm.strHorAge := objOcoCrm.strHorInc;
              objOcoCrm.strDtaCon := objOcoCrm.strDtaInc;
              objOcoCrm.strHorCon := objOcoCrm.strHorInc;
              objOcoCrm.strOpeHis := strLoginUsuarioLogado;
              objOcoCrm.strCodOpe := strLoginUsuarioLogado;
              objOcoCrm.strDescri := 'Solicitação de Liberação de Limite de Crédito<<csq>><<csq>>'+
                                     strMsgOco + 'Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                     FormatDateTime('dd/mm/yyyy', VS_Date) + ' ' + FormatDateTime('hh:nn:ss', fNow) + ' - ' +
                                     strLoginUsuarioLogado + ' - ' + fRetNomeOperador(strLoginUsuarioLogado);

              objOcoCrm.strCodEmp := VS_strCodEmp;
              objOcoCrm.strCodToc := fCfgSis('TOCLCR', varString);
              objOcoCrm.strCpfCli := strCliCgc;
              objOcoCrm.pInsereNovaOcorrencia;
              objOcoCrm.pInsereHistoricoOcorrencia;

              If not (objOcoCrm.fGravouNovaOcorrencia And objOcoCrm.fGravouHistoricoOcorrencia) Then
              Begin
                Result := False;
                blnLibCre := False;
              End;

              FstrCodOcoLimCr := objOcoCrm.strCodOco;
              FHraSolLibLimCr := objOcoCrm.strHorInc;
            Finally
              FreeAndNil(objOcoCrm);
            End;
          End;

        End
        Else
        Begin
          blnLibCre := False;
          Result := False;
        End;
      finally
        FreeAndNil(objLiberacao);
      end;
    End;

  End;

End;

