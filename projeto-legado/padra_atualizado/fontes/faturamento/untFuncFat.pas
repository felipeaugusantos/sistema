procedure TFatVenda.pAtualizarNumeroDuplicataBoletoAdiantamento(strNumDocPar, strEspDocPar, strCodEmpPar: String; strCodCliPar: String = '');
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT * FROM CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');

  If (Not fEmptyStr(strCodCliPar)) Then
    qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');

  qryAux.SQL.Add('  CTR_DTAREC IS NULL       ');

  qryAux.ParamByName('NUMDUP').AsString := strNumDocPar;
  qryAux.ParamByName('ESPDOC').AsString := strEspDocPar;
  qryAux.ParamByName('CODEMP').AsString := strCodEmpPar;

  If (Not fEmptyStr(strCodCliPar)) Then
    qryAux.ParamByName('CODCLI').AsString := strCodCliPar;

  qryAux.Open;

  qryAux.First;
  While Not qryAux.Eof Do
  Begin
    pGravaLogCtr(qryAux.FieldByName('CTR_NUMDUP').AsString,
                 qryAux.FieldByName('CTR_ESPDOC').AsString,
                 qryAux.FieldByName('CTR_CODCLI').AsString,
                 qryAux.FieldByName('CTR_CODEMP').AsString,
                 qryAux.FieldByName('CTR_PARCEL').AsString, 0,
                 'NUMERO DUPLICATA ALTERADO PARA ' +
                 Self.strNumDoc + '-' + Self.strEspDoc + '-' + Self.strEmpDoc, strNomeForm);

    qryAux.Edit;
    qryAux.FieldByName('CTR_NUMDUP').AsString := Self.strNumDoc;
    qryAux.FieldByName('CTR_ESPDOC').AsString := Self.strEspDoc;
    qryAux.FieldByName('CTR_CODEMP').AsString := Self.strEmpDoc;
    qryAux.Post;

    pGravaLogCtr(qryAux.FieldByName('CTR_NUMDUP').AsString,
                 qryAux.FieldByName('CTR_ESPDOC').AsString,
                 qryAux.FieldByName('CTR_CODCLI').AsString,
                 qryAux.FieldByName('CTR_CODEMP').AsString,
                 qryAux.FieldByName('CTR_PARCEL').AsString, 0,
                 'ALTERACAO NUMERO DA DUPLICATA ' +
                 strNumDocPar + '-' + strEspDocPar + '-' + strCodEmpPar, strNomeForm);

    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

class procedure TFatVenda.pAtualizarHistoricoDuplicataBoletoAdiantamento(strNumDocPar, strEspDocPar, strCodEmpPar, strHistorico: String);
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(nil);
  qryAux.SQL.Add('SELECT * FROM CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP     ');

  qryAux.ParamByName('NUMDUP').AsString := strNumDocPar;
  qryAux.ParamByName('ESPDOC').AsString := strEspDocPar;
  qryAux.ParamByName('CODEMP').AsString := strCodEmpPar;

  qryAux.Open;

  qryAux.First;
  While Not qryAux.Eof Do
  Begin
    qryAux.Edit;
    qryAux.FieldByName('CTR_HIST01').AsString :=
      qryAux.FieldByName('CTR_HIST01').AsString + STRING_QUEBRA +
        FormatDateTime('dd/MM/yyyy hh:mm:ss', untFuncoesSimples.VS_Date + fTime()) +
          ' - ' + strHistorico;
    qryAux.Post;
    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

procedure TFatVenda.pDeletaCadRec(strNumDoc, strEspDoc, strCodEmp: String; strCodCli: String = ''; blnBcoEnvIsNull: Boolean = False);
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('DELETE FROM CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');

  If (Not fEmptyStr(strCodCli)) Then
    qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');

  qryAux.SQL.Add('  ((CTR_DTAREC IS NULL) '+IIF(fConfirmacaoComFFComBol,' AND NOT '+fRetSQLCadRecFFComBol,'')+') ');

  //Nao deve apagar os creditos gerados na alteracao de pedido com valor menor que o quitado
  If (strEspDoc = 'PD') And fCfgSis('GERCRE', varBoolean) Then
    qryAux.SQL.Add('  AND CTR_VALORI > 0 ');

  If blnBcoEnvIsNull Then
    qryAux.SQL.Add('  AND CTR_BCOENV IS NULL ');

  qryAux.ParamByName('NUMDUP').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCodEmp;

  If (Not fEmptyStr(strCodCli)) Then
    qryAux.ParamByName('CODCLI').AsString := strCodCli;

  qryAux.ExecSQL;

  FreeAndNil(qryAux);

end;

class function TFatVenda.fPedidoAPrazoComEntradaQuitada(strNumPed, strEspPed, strEmpPed, strConPag: String): Boolean;
begin
  Result := (fStatusCndPag(strConPag) = A_PRAZO); //Pedido A Prazo

  If Result Then
  Begin
    Result := (TFatVenda.fTotalDuplicataQuitada(strNumPed, strEspPed, strEmpPed) +
               TAdiantamento.fGetTotaisAdiantamento(strNumPed, strEspPed, strEmpPed).fltValLan) > 0;//Entrada quitada

    If (Not Result) And (fConPagComEntrada(strConPag)) Then
      Result := fJaUsouCreditoDeAdiantamento(strNumPed, strEspPed, strEmpPed);
  End;
end;

class procedure TFatVenda.pAlteraCondicaoPagamentoRemovendoEntrada(Var strConPag: String);
  Var
    intParcela: Integer;
begin
  If (Copy(strConPag, 3, 3) = '000') And (fStatusCndPag(strConPag) = A_PRAZO) Then
  Begin
    intParcela  := StrToIntDef(LeftStr(strConPag, 2), 1);
    System.Delete(strConPag, 1, 5);
    strConPag := fStrZero(IntToStr(intParcela -1), 2) + strConPag;
  End;
end;

procedure TFatVenda.pAlterarEmpresaLogada(strCodEmp: String);
begin

  Self.strEmpLogDev := VS_strCodEmp;

  If fRetNomeEmpresa(strCodEmp).IsEmpty Then
    Exit;

  pSetaEmpresaLogada(IIF(not strCodEmp.IsEmpty, strCodEmp, VS_strCodEmp));

end;

class function TFatVenda.fTotalDuplicataQuitada(strCtrNumDup, strCtrEspDoc,
  strCtrCodEmp: String; strCtrCodCli: String = ''): Double;
  Var
    qryAux: TUniQuery;
begin

  Result := 0;

  If (fEmptyStr(strCtrNumDup) And fEmptyStr(strCtrCodEmp)) Then
    Exit;

  qryAux := fCriaQuery(nil);

  Try

    qryAux.SQL.Add('SELECT SUM(CTR_VALREC - IFNULL(CTR_VALJUR, 0) - IFNULL(CTR_VALCOB, 0) + IFNULL(CTR_VALDES, 0)) AS VALREC FROM CADREC ');
    qryAux.SQL.Add('WHERE ');
    qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
    qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
    qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');

    If (Not fEmptyStr(strCtrCodCli)) Then
      qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');

    qryAux.SQL.Add('  CTR_DTAREC IS NOT NULL ');

    If (strCtrEspDoc = 'PD') And fCfgSis('GERCRE', varBoolean) Then
      qryAux.SQL.Add('  AND CTR_VALORI > 0 ');//Nao deve considerar os creditos gerados para o pedido

    qryAux.ParamByName('NUMDUP').AsString := strCtrNumDup;
    qryAux.ParamByName('ESPDOC').AsString := strCtrEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCtrCodEmp;

    If (Not fEmptyStr(strCtrCodCli)) Then
      qryAux.ParamByName('CODCLI').AsString := strCtrCodCli;

    qryAux.Open;

    Result := qryAux.FieldByName('VALREC').AsFloat;

    //Desconta do valor recebido os creditos gerados para o pedido
    If (strCtrEspDoc = 'PD') And fCfgSis('GERCRE', varBoolean) Then
      Result := Result - fTotalCreditosGeradosPedido(strCtrNumDup,
                                                     strCtrEspDoc,
                                                     strCtrCodEmp,
                                                     strCtrCodCli);

  Finally
    FreeAndNil(qryAux);
  End;

end;

class function TFatVenda.fTotalCreditosGeradosPedido(strCtrNumDup, strCtrEspDoc,
  strCtrCodEmp: String; strCtrCodCli: String = ''): Double;
  Var
    qryAux: TUniQuery;
begin
  Result := 0.00;

  If fEmptyStr(strCtrNumDup) And fEmptyStr(strCtrEspDoc) And fEmptyStr(strCtrCodEmp) Then
    Exit;

  If strCtrEspDoc <> 'PD' Then
    Exit;

  If Not fCfgSis('GERCRE', varBoolean) Then
    Exit;

  qryAux := fCriaQuery(nil);

  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('   SUM(IF(CTR_DTAREC IS NULL,  ');//Se nao foi recebido pega
  qryAux.SQL.Add('          CTR_VALDUP,          ');//o valor da duplicata
  qryAux.SQL.Add('          CTR_VALREC - IFNULL(CTR_VALJUR, 0) - IFNULL(CTR_VALCOB, 0) + IFNULL(CTR_VALDES, 0)) ');//senao calcula o valor da duplicata
  qryAux.SQL.Add('      ) AS TOTCRE ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');
  qryAux.SQL.Add('  CTR_VALORI < 0           ');

  If (Not fEmptyStr(strCtrCodCli)) Then
    qryAux.SQL.Add('  AND CTR_CODCLI = :CODCLI ');

  qryAux.ParamByName('NUMDUP').AsString := strCtrNumDup;
  qryAux.ParamByName('ESPDOC').AsString := strCtrEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCtrCodEmp;

  If (Not fEmptyStr(strCtrCodCli)) Then
    qryAux.ParamByName('CODCLI').AsString := strCtrCodCli;

  qryAux.Open;

  Result := Abs(qryAux.FieldByName('TOTCRE').AsFloat);

  FreeAndNil(qryAux);
end;

function TFatVenda.fValidaFreteDigitado(fltValorFreteAnt: Double): Boolean;
  Var
    objLiberacao  : TLiberacao;
    cdsData: OleVariant;
    recTotMarLuc : TRecTotaisMargemLucro;
    fltValFreOri : Double;
    strCfgTraFre : String;
begin
  Result := True;

  If (fltValorFreteAnt >= 0) Then
  Begin

    strCfgTraFre := fCfgSis('TRAFRE', varString);
    If ((strCfgTraFre = 'H') And (fltValorFreteAnt >= fltValFre)) Or
       ((strCfgTraFre = 'L') And (fltValorFreteAnt <= fltValFre)) Then
       Exit;

    cdsData := Self.fCalculaMargemLucro(False);

    Self.pCalculaTotaisMargemLucro(cdsData,
                                   recTotMarLuc);

    fltValFreOri := fCampoTabela('TRA_VALFRE', 'CADTRA', ['TRA_CODTRA'], [strCodTra]);
    objLiberacao := TLiberacao.Create;
    try
      If strCfgTraFre = 'H' Then
      Begin
        objLiberacao.strDirAce := 'FREMAI';
        objLiberacao.strMsgSen := 'Alterar valor do frete de sugestão com valor Maior.';
        objLiberacao.objMsgLibera.pAddTexto('Alteração valor do frete de sugestão com valor Maior.');
      End
      Else If strCfgTraFre = 'L' Then
      Begin
        objLiberacao.strDirAce := 'FREMEN';
        objLiberacao.strMsgSen := 'Alterar valor do frete de sugestão com valor Menor.';
        objLiberacao.objMsgLibera.pAddTexto('Alteração valor do frete de sugestão com valor Menor.');
      End
      Else
      Begin
        objLiberacao.strDirAce := 'FRETRA';
        objLiberacao.strMsgSen := 'Alteração do valor do frete sugestão.';
        objLiberacao.objMsgLibera.pAddTexto('Valor do frete sugestão foi alterado.');
      End;

      objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
      objLiberacao.objMsgLibera.pAddTexto('Nome da transportadora original: '+strNomTra);

      objLiberacao.objMsgLibera.pAddTexto('Valor do frete original: '+FloatToStrF(fltValorFreteAnt, ffNumber, 12, 2));

      objLiberacao.objMsgLibera.pAddTexto('Valor do frete do cadastro da transportadora original: '+FloatToStrF(fltValFreOri, ffNumber, 12, 2));

      objLiberacao.objMsgLibera.pAddTexto('Nome da Transportadora alterado: '+strNomTra);
      objLiberacao.objMsgLibera.pAddTexto('Valor do frete alterado: '+FloatToStrF(fltValFre, ffNumber, 12, 2));
      objLiberacao.objMsgLibera.pAddTexto('Valor do frete do cadastro da transportadora alterado: '+FloatToStrF(fltValFreOri, ffNumber, 12, 2));
      objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');

      if (fCfgSis('EMLTFA', varBoolean)) then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Margem de lucro: '+FloatToStrF(TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, False), ffNumber, 12, 2));
        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
      end;

      objLiberacao.objMsgLibera.pAddTexto('Valor total do documento: '+FloatToStrF(fltTotGer, ffNumber, 12, 2));
      objLiberacao.objMsgLibera.pAddTexto('Vendedor: ('+strCodVen+') - '+strNomVen);
      objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');

      If Not fEmptyStr(strEndEnt) Then
      Begin
        objLiberacao.objMsgLibera.pAddTexto('Endereço de entrega');
        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
        objLiberacao.objMsgLibera.pAddTexto('Endereço: '+strEndEnt +', Bairro: '+ strBaiEnt +', CEP: '+strCepEnt);

        If Not fEmptyStr(strRefEnt) Then
          objLiberacao.objMsgLibera.pAddTexto('Referência: '+ strRefEnt);

        objLiberacao.objMsgLibera.pAddTexto('Cidade: '+ strNomCidEnt +', Estado: '+ strEstEnt);
        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
      End;

      objLiberacao.objMsgLibera.pAddTexto('Peso Total do Pedido: '+FloatToStrF(fltPesBru, ffNumber, 12, 2));
      objLiberacao.objMsgLibera.pAddTexto('Previsão de Entrega: ' +FormatDateTime('dd/mm/yyyy', dtaPreVis));
      objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');

      objLiberacao.strCodOpe := strCodVen;
      objLiberacao.strCodDig := strCodDig;
      objLiberacao.strCliente := strCodCli + '-' + strCliNom;
      objLiberacao.blnUsarSenhaFixa := False;
      objLiberacao.blnSempreVariavelUsuario := True;

      Result := fFatMensagemLiberacao(objLiberacao);

    finally
      FreeAndNil(objLiberacao);
    end;

  End;
end;


function TFatVenda.fTravaAoZerarFrete(fltValorAnterior, fltValorDigitado: Double) :Boolean;
begin
  Result := False;
  If (fCfgSis('FRETRA') = FRETRA_NAO_UTILIZA_CALC_FRETE) And
     (fCfgSis('SENAZF') = 'S') And
     (fltValorDigitado = 0) And
     (fltValorAnterior > 0.0) And
     (Pos(Self.strOpcDoc, 'PD_OR_VN_') > 0) Then
     Result := True;
end;

function TFatVenda.fTotalProdutosOriginal: Double;
  Var
    item: TDadosFechamento;
begin
  Result := 0;
  For item In arrMatItens Do
  Begin
    If Assigned(VS_ObjFiscal) Then
      Result := Result + VS_objFiscal.fCalculaTotalSistema(item.fltUniOri, item.fltQtdIte)
    Else
      Result := Result + fFormataFloat(item.fltUniOri * item.fltQtdIte, 2);
  End;
end;

procedure TFatVenda.pDefinirDocumentoBrindeProduto;
  Var
    intItens: Integer;
    lstrPromocaoOriginal: String;
    fltProPreVenOriginal: Double;
begin
  If (Not fCfgSis('USABRI', VarBoolean)) Then Exit;

  If (strEspDoc = 'FF') Then
    strEspDoc := 'BR';

  If (strEspDoc = 'IF') Then
    strEspDoc := 'NF';

  strTipFat := 'Brinde';

  If (Assigned(qryConIte)) Then
    FreeAndNil(qryConIte);

  lstrPromocaoOriginal := self.strPromoc;
  fltProPreVenOriginal := self.fltProPreVen;

  qryConIte := fCriarQueryIteGer(Self);

  For intItens := Low(arrMatItens) To High(arrMatItens) Do Begin
    With arrMatItens[intItens] Do
    Begin
      If (strIdePro = 'NOR') Then
      Begin
        With qryConIte Do Begin
          Close;
          ParamByName('CODITE').AsString := strCodIte;
          ParamByName('CODEMP').AsString := IIF(fEmptyStr(strEmp_TE), VS_strCodEmp, strEmp_TE);
          Open;
        End;

        self.strPromoc    := arrMatItens[intItens].strPromoc;
        self.fltProPreVen := arrMatItens[intItens].fltProVen;

        fltPreCus := fPegaPrecoVenda(qryConIte,
                                     arrMatItens[intItens].strEmpIte,
                                     strEntSai,
                                     fltMargem,
                                     (Pos('ITEM ESPECIAL', strDesIte) > 0),
                                     strIdePro,
                                     strTabPre,
                                     True,
                                     FTaxJur,
                                     FUniVis);

        If(fltUniTar = 0) And (not fPermiteBrindeComValorZero) Then
        Begin
          fltUniTar := fltPreCus;
          fltUniDig := fltPreCus;
          fltUniTmp := fltPreCus;
          fltTotIte := fFormataFloat(fltPreCus * fltQtdIte, 2);
        End;

      End;
    End;
  End;

  self.strPromoc    := lstrPromocaoOriginal;
  self.fltProPreVen := fltProPreVenOriginal;

  If (qryConIte.Active) Then
    qryConIte.Close();

  pCalculaPesBruLiq;

  pDestacaRetencoes;
  pRetemImpostosNoDescontoEspecial;

  pSetBackupVar(['strEspDoc']);
  pCalculaTotGer(False, True, nil, False);
  pGetBackupVar(['strEspDoc']);

  strDesCla := fRetDesCla(strClaFis);

  fltTotCadRec := 0.00;
  pZeraDigDuplic(arrDuplicata);

  pRateiaValores;
end;

procedure TFatVenda.pDefinirDocumentoBrindeServico;
  Var
    intServico: Integer;
    fltUniSer : Double;
    fltQtdSer : Double;
    fltValSer : Double;
begin
  If (Not fCfgSis('USABRI', VarBoolean)) Then Exit;

  strEspDoc := 'BR';
  strTipFat := 'Brinde';

  For intServico := 1 To 30 Do
  Begin
    fltQtdSer := GetPropValue(Self, 'fltQtdS' + fStrZero(intServico.ToString, 2));
    fltUniSer := GetPropValue(Self, 'fltCusS' + fStrZero(intServico.ToString, 2));

    fltValSer := fFormataFloat(fltQtdSer * fltUniSer, 2);

    SetPropValue(Self, 'fltUniS' + fStrZero(intServico.ToString, 2), fltUniSer);
    SetPropValue(Self, 'fltValS' + fStrZero(intServico.ToString, 2), fltValSer);

    Self.fltTotSer := Self.fltTotSer + fltValSer;
  End;
end;

{*****************************************}
{* INSERE PEDIDOS PENDENTES QUE ESTAVAM  *}
{* NO CLIENT DATASET                     *}
{**************************************AF*}
procedure TFatVenda.pInserePedidosPendentes;
  Var
    blnAch: Boolean;
    recForTin: TForTin;
    recMadeira: untTypesSistema.TDadosMadeira;

  function fCompararItem: Boolean;
  begin
    Result := cdsDadosPedBaixados.FieldByName('ITE_SEQDET').AsString = cdsVenda.FieldByName('ITE_SEQDET').AsString;
  end;

begin

  Try

    cdsDadosPedBaixados.First;
    With cdsVenda Do
    Begin
      DisableControls;

      While Not cdsDadosPedBaixados.Eof Do
      Begin
        blnAch := False;

        First;
        While Not Eof Do
        Begin

          If fCompararItem Then
          Begin
            Edit;
            FieldByName('ITE_QTDITE').AsFloat := FieldByName('ITE_QTDITE').AsFloat + cdsDadosPedBaixados.FieldByName('ITE_QTDITE').AsFloat;
            FieldByName('ITE_TOTITE').AsFloat := fFormataFloat(FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNITAR').AsFloat,2);
            FieldByName('ITE_QTDBAI').AsFloat := FieldByName('ITE_QTDBAI').AsFloat + cdsDadosPedBaixados.FieldByName('ITE_QTDITE').AsFloat;
            FieldByName('ITE_TOTCUS').AsFloat := FieldByName('ITE_PRECUS').AsFloat * FieldByName('ITE_QTDITE').AsFloat;
            FieldByName('ITE_TOTCU2').AsFloat := FieldByName('ITE_PRECU2').AsFloat * FieldByName('ITE_QTDITE').AsFloat;

            If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
              FieldByName('ITE_QTDPEC').AsFloat := fCalculaQuantidadePecas(FieldByName('ITE_QTDITE').AsFloat,
                                                                           FieldByName('ITE_COMPEC').AsFloat,
                                                                           FieldByName('ITE_LARPEC').AsFloat,
                                                                           FieldByName('ITE_ESPPEC').AsFloat,
                                                                           fRetSiglaUnidade(FieldByName('ITE_CODUNI').AsString));
            Post;

            blnAch := True;
            Break;
          End;

          Next;
        End;

        If Not blnAch Then
        Begin
          If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
          Begin
            recMadeira.fltQtdPec := cdsDadosPedBaixados.FieldByName('ITE_QTDPEC').AsFloat;
            recMadeira.fltComPec := cdsDadosPedBaixados.FieldByName('ITE_COMPEC').AsFloat;
            recMadeira.fltLarPec := cdsDadosPedBaixados.FieldByName('ITE_LARPEC').AsFloat;
            recMadeira.fltEspPec := cdsDadosPedBaixados.FieldByName('ITE_ESPPEC').AsFloat;

            recMadeira.strAparel := cdsDadosPedBaixados.FieldByName('ITE_APAREL').AsString;
            recMadeira.fltPerApa := cdsDadosPedBaixados.FieldByName('ITE_PERAPA').AsFloat;
            recMadeira.strBenefi := cdsDadosPedBaixados.FieldByName('ITE_BENEFI').AsString;
            recMadeira.fltPerBen := cdsDadosPedBaixados.FieldByName('ITE_PERBEN').AsFloat;
          end;

          pAdicionaRegistroTemporaria(cdsVenda,
                                      Nil,
                                      cdsDadosPedBaixados.FieldByName('ITE_IDEPRO').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_CODGRU').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_CODITE').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_DESORI').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_DESITE').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_DESFAB').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_UNIDAD').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_CODUNI').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_CODMAR').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_CODFOR').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_REFERE').AsString,
                                      cdsDadosPedBaixados.FieldByName('ITE_UNIORI').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_UNIVIS').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_UNITAR').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_UNITMP').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_DESCON').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_QTDITE').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_TOTITE').AsFloat,
                                      cdsDadosPedBaixados.FieldByName('ITE_ENTSAI').AsString,
