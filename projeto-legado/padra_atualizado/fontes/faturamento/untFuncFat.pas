          objLiberacao.objMsgLibera.pAddTexto('Valor Unitário Menor que o Preço de Mínimo.');
          objLiberacao.objMsgLibera.pAddTextoCaption('Produto'    ,  strDesIte                                                         , 22);
          objLiberacao.objMsgLibera.pAddTextoCaption('Marca'      ,  fRetNomMarcaItem(strCodIte)                                       , 22);
          objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade' ,  FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), fltQtdIte), 22, alDireita, teAmbos, '', 16);

          strTabPreIteLocal := IIF(fEmptyStr(strTabPreIte), strTabPre, strTabPreIte);
