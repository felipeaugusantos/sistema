  function fTravaVendaPresencial(var strMensagem : String) : Boolean;
  Var
    strEmpresas: String;
    strUFEmpItem: String;
    blnNaoAtendeRegra: Boolean;
    strEmpNaoAtendeRegras: String;
    strEmpAtendeRegras: String;
    Item: TDadosFechamento;
  begin
    Result := False;

    strEmpresas := '';
    strEmpUF := '';
    blnNaoAtendeRegra := False;
    strEmpNaoAtendeRegras := '';
    strEmpAtendeRegras := '';

    If (Self.blnVendaPresencial) And
       (Not fEmptyStr(Self.strEstEnt)) And
       (fTemEntregaDesconsiderandoEntregaFuturaClienteVaiRetirar(Self.arrMatItens)) And
       ((Pos(strOpcDoc, 'OR_PD_VN_') > 0) Or (Self.blnBaiEntFut)) Then
    Begin
      If (fCfgSis('EMPFAT', VarString) = 'S') Then
      Begin
        strEmpUF := '';
        For Item in Self.arrMatItens Do
        Begin
          If (Pos(Item.strEmpIte, strEmpresas) > 0) Then
            Continue;

          strUFEmpItem := Self.fGetUFEmpresa(Item.strEmpIte);

          If (strUFEmpItem <> Self.strEstEnt) Then
          Begin
            Result := True;
            blnNaoAtendeRegra := True;
            strEmpNaoAtendeRegras := strEmpNaoAtendeRegras + 'Empresa: ' + Item.strEmpIte + ' UF: ' + strUFEmpItem + sLineBreak;
          End
          Else
          Begin
            strEmpAtendeRegras := strEmpAtendeRegras + 'Empresa: ' + Item.strEmpIte + ' UF: ' + strUFEmpItem + sLineBreak;
          End;

          strEmpresas := strEmpresas + Item.strEmpIte + '_';
        End;
      End
      Else
      Begin
        strEmpUF := fCadEmp('ESTADO');
        Result := (Self.strEstEnt <> strEmpUF);
      End;
    End;

    If Result Then
    Begin
      strMensagem := 'Não é permitido venda presencial com UF de destino diferente da UF da origem! '+ sLineBreak +
                     'Favor verificar o endereço de entrega.' + sLineBreak +
                     'UF Destino: ' + Self.strEstEnt + sLineBreak +
                     'UF Origem : ' + strEmpUF;

      If blnNaoAtendeRegra Then
      Begin
        strMensagem := 'Não é permitido venda presencial com UF de destino (' + Self.strEstEnt + ') diferente da UF da origem! '+ sLineBreak +
                       'Existem empresas que não atendem às regras para venda presencial.' + sLineBreak +
                       'Por favor, realize a digitação dos documentos separadamente.' + sLineBreak + sLineBreak;

        If (Not fEmptyStr(strEmpAtendeRegras)) Then
          strMensagem := strMensagem + 'Empresas que atendem às regras:' + sLineBreak + strEmpAtendeRegras + sLineBreak;

        If (Not fEmptyStr(strEmpNaoAtendeRegras)) Then
          strMensagem := strMensagem + 'Empresas que não atendem às regras:' + sLineBreak + strEmpNaoAtendeRegras;
      End;
    End;
  end;

