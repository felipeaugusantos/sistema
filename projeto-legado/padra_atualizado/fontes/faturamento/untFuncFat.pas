function TFatVenda.fVerificaQtdEstoqueEstruturaVidro( strOpcao,
                                                      strIteEst,
                                                      strAutInc: String;
                                                      fltQtdIte: Double;
                                                      blnComSenha: Boolean;
                                                      objMsgSubItensSemEst: TMensagemLiberacao;
                                                      Var blnPediuSenha: Boolean;
                                                      blnVerQtdDig: Boolean = True ): Boolean;
  Var
    subItem: TSubItemVidro;

    fltQtdDigitada,
    fltSaldoReservado,
    fltSalDisponivelSubItem: Double;
    objMsg : TMensagemLiberacao;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha : TLinhaMsgLibera;

begin
  objEstruturaVidros.pCarregarEstrutura(strToIntDef(strAutInc,-1));
  objMsg := TMensagemLiberacao.Create(Self);

  blnPediuSenha     := False;
  fltQtdDigitada    := 0.0;

  Result := objEstruturaVidros.blnTemSubItensDigitados;

  If Result Then
  Begin
    objTabela := TRegistroMsgLiberaTabela.Create;
    For subItem In objEstruturaVidros.subItensEstrutura.Items Do
    Begin
      If (blnVerQtdDig) Then
      Begin
        fltQtdDigitada := fRetQtdDigitada(subItem.strCodigo,
                                          '',
                                          strAutInc,
                                          '',
                                          '',
                                          VS_strCodEmp,
                                          True,
                                          False,
                                          False,
                                          False,
                                          False,
                                          strOpcao);
      End;

      {***************************************************}
      {* RETORNA O SALDO RESERVADO DO SUB-ITEM ESTRUTURA *}
      {************************************************JC*}
      fltSaldoReservado := TSaldoReservado.New(
                             TReservaParametros.New()
                               .EmpresaItem(VS_strCodEmp)
                               .CodigoItem(subItem.strCodigo)
                               .CodEmpresa(VS_strCodEmp)
                               .NumeroDocumento(strNumOrc)
                               .TipoFiltroDocumento(tfdIgnorarDocumento)
                               .DesconsideraPedidosCorte(Not blnPedCorte)
                             ).fGetQuantidade();

      fltSalDisponivelSubItem := ( fRetSaldosEmpresa(subItem.strCodigo, VS_strCodEmp) -
                                   fltQtdDigitada -
                                   fltSaldoReservado );

      If (subItem.fltQuantidadeVenda * fltQtdIte) > fltSalDisponivelSubItem Then
      Begin
        If objTabela.isEmpty then
        Begin
          objMsg.pAddTexto('********* Sub.Produtos não possuem estoque disponível *********');

          objLinha := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'Código'      , 7 , alCentro  , teAutcom);
          objLinha.pAddColuna('', 'Descrição'   , 29, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Marca'       , 15, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Quantidade'  , 12, alCentro  , teAutcom);
          objLinha.pAddColuna('', 'Saldos Disp.', 12, alCentro  , teAutcom);
          objTabela.lstLinhas.Add(objLinha);
        End;

        objLinha := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.pAddColuna('Código'      , subItem.strCodigo                                , 7 , alCentro  , teAmbos);
        objLinha.pAddColuna('Descrição'   , fRetNomProduto(subItem.strCodigo)                , 29, alEsquerda, teAmbos);
        objLinha.pAddColuna('Marca'       , fRetNomMarcaItem(subItem.strCodigo)              , 15, alEsquerda, teAmbos);
        objLinha.pAddColuna('Quantidade'  , FormatFloat('#,##0.00', subItem.fltQuantidadeVenda * fltQtdIte)       , 12, alDireita , teAmbos);
        objLinha.pAddColuna('Saldos Disp.', FormatFloat('#,##0.00', fltSalDisponivelSubItem) , 12, alDireita , teAmbos);
        objTabela.lstLinhas.Add(objLinha);
      End;

    End;

    if not objTabela.isEmpty then
      objMsg.lstRegistros.Add(objTabela)
    else
      FreeAndNil(objTabela);

    if not objMsg.isEmpty then
    Begin
      if Assigned(objMsgSubItensSemEst) then
        objMsgSubItensSemEst.fGetObjectFromJson(objMsg.fGetJsonObject.ToJSON);

      if (fCfgSis('SENFVU') = 'F') then
        objMsg.Clear;

      If Not blnComSenha Then
      Begin
        Result := False;
      End

      Else If (Pos(strOpcao, 'OR_PD_') > 0) Then
      Begin

        If (strOpcao = 'OR') And (fCfgSis('SLD_OP') = 'T') Then
        Begin
          blnPediuSenha := True;
          objMsg.pInsertTexto(0, 'Liberação de produto(s) sem saldo - Orçamento!');
          Result := fSenhaLiberacaoSemSaldoOP(strCodVen,
                                              strCodDig,
                                              strNtrava,
                                              stlNumLib,
                                              objMsg,
                                              True,
                                              strCodCli + '-' + strCliNom,
                                              '',
                                              FSequencialUnicoDtaHrLogVar,
                                              fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp),
                                              IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp), VS_strCodEmp, EmptyStr),
                                              pMostraMensagem);
        End

        Else If (strOpcao = 'PD') And (fCfgSis('SLDPED') = 'T') Then
        Begin
          blnPediuSenha := True;
          objMsg.pInsertTexto(0, 'Liberação de produto(s) sem saldo - Pedido!');
          Result := fSenhaLiberacaoSemSaldoPE(strCodVen,
                                              strCodDig,
                                              strNtrava,
                                              stlNumLib,
                                              objMsg,
                                              True,
                                              strOpcao,
                                              False,
                                              True,
                                              blnEnt_CD,
                                              strCodCli + '-' + strCliNom,
                                              '',
                                              FSequencialUnicoDtaHrLogVar,
                                              fExibeMensagemTransferenciaEstoqueItemAItem,
                                              fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp),
                                              IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(VS_strCodEmp), VS_strCodEmp, EmptyStr),
                                              pMostraMensagem);
        End;

      End
      Else If (fTravaSaldoVN(blnExpedi,False,'',strOriF11) = 'T') Then
      Begin

        If (Not (fCfgSis('VSEORC', varBoolean) And (strOpcao = 'VN'))) Or (fVendaMultiLoja) Or (blnExpedi) Or (strOriF11 = 'S') Then
        Begin
          objMsg.pInsertTexto(0, 'Liberação de produto(s) sem saldo - '+IIF(strOriF11='S','Resumo de Caixa!', 'Venda Normal!'));

          blnPediuSenha := True;
          Result := fSenhaLiberacaoSemSaldoVN(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg,
            '', True, strOpcao, False, blnExpedi, '', False, blnBaiEntFut, blnEnt_CD, strCodCli + '-' + strCliNom, '', strOriF11, FSequencialUnicoDtaHrLogVar, fExibeMensagemTransferenciaEstoqueItemAItem);
        End;

        dtaNasCon := strToDateDef(frmFatDadosCliConsumidor.mskDtaNas.Text, 0);

      End;
    End;

  End
  Else
    pMensagemOk('Não foram encontrados sub. produtos para o vidro informado!');

end;

Function TFatVenda.fBaixaItem(strTabela,
                              strAutInc: String;
                              fltQtdEnt: Double): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  Try
    qryGen := fCriaQuery;
    With qryGen, SQL Do
    Begin
      Clear;

      Add('UPDATE ' + strTabela);
      Add('SET DET_QTDENT = :QTDENT ');

      If fCampoExiste(strTabela, 'DET_EFBAIX', True) Then
        Add(', DET_EFBAIX = IF(DET_QTDENT >= DET_QTDITE, "S", "N") ');

      Add('WHERE AUTOINCREM = :AUTINC');

      ParamByName('QTDENT').AsFloat  := RoundTo(fltQtdEnt,-4);
      ParamByName('AUTINC').AsString := strAutInc;
      ExecSQL;
      Close;
    End;
    FreeAndNil(qryGen);
    Result := TRUE;
  Except
    Result := FALSE;
  End;
End;

Function TFatVenda.fBaixaEntregaFutura: Boolean;
  var
    LfltQuantidadeEntregada : Double;
    LfltQuantidadeDevolvida : Double;
    LblnSintetiza: Boolean;
    LstrFilter: String;
    LblnFiltered: Boolean;
    LcdsClone: TUniClientDataSet;
    LfltQtdEnt: Double;
    blnBaixaItem:Boolean;
begin
  Result := TRUE;

  LcdsClone := Nil;
  LblnSintetiza := False;

  If (Not Assigned(cdsBaiEntFut)) Then
    Exit;

  Try

    if cdsBaiEntFut.FindField('SINTET') <> nil then
    begin
      cdsBaiEntFut.DisableControls;
      LstrFilter := cdsBaiEntFut.Filter;
      LblnFiltered := cdsBaiEntFut.Filtered;
      try
        cdsBaiEntFut.Filtered := False;
        cdsBaiEntFut.Filter := 'SINTET = '+ QuotedStr('S');
        cdsBaiEntFut.Filtered := True;

        LblnSintetiza := not cdsBaiEntFut.IsEmpty;
      finally
        LstrFilter := cdsBaiEntFut.Filter;
        cdsBaiEntFut.Filtered := LblnFiltered;
        cdsBaiEntFut.EnableControls;
      end;
    end;

    if LblnSintetiza then
    begin
      LcdsClone := TUniClientDataSet.Create(Nil);
      pCloneDataSet(LcdsClone, cdsBaiEntFut);
    end;

    cdsBaiEntFut.DisableControls;
    cdsBaiEntFut.First;

    While Not cdsBaiEntFut.Eof Do
    Begin

      if cdsBaiEntFut.FindField('QTDDEV') <> nil then
        LfltQuantidadeDevolvida := cdsBaiEntFut.FieldByName('QTDDEV').AsFloat
      else
        LfltQuantidadeDevolvida := 0;

      if LblnSintetiza then
      begin
        LfltQtdEnt := 0;
        LcdsClone.Filtered := False;
        LcdsClone.Filter := 'AUTOINCREM = ' + QuotedStr(cdsBaiEntFut.FieldByName('AUTOINCREM').AsString);
        LcdsClone.Filtered := True;

        LcdsClone.First;
        while not LcdsClone.Eof do
        begin
          LfltQuantidadeEntregada := LcdsClone.FieldByName('DET_QTDENT').AsFloat;
          if (Self.blnExpedi) and (Self.intQtdePedidosExpedicao > 1) and (LcdsClone.FieldByName('DET_QTDAEN').AsFloat = 0) then
            LfltQuantidadeEntregada := 0;

          LfltQtdEnt := LfltQtdEnt + LfltQuantidadeEntregada + LcdsClone.FieldByName('DET_QTDAEN').AsFloat;

          LcdsClone.Next;
        end;
      end
      else
        LfltQtdEnt := cdsBaiEntFut.FieldByName('DET_QTDENT').AsFloat + cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat;

      If (fUsaPedidoBaixaEntregaFutura And (blnBaiFutDev)) Then
      Begin
        blnBaixaItem := ((cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat = 0) And (LfltQuantidadeDevolvida > 0))
      End
      Else
      Begin
        blnBaixaItem := (cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat + LfltQuantidadeDevolvida > 0);
      End;

      If blnBaixaItem Then
        Result := fBaixaItem(cdsBaiEntFut.FieldByName('TABELA').AsString,
                             cdsBaiEntFut.FieldByName('AUTOINCREM').AsString,
                             LfltQtdEnt +
                             LfltQuantidadeDevolvida);

      If Not Result Then
        Break;

      cdsBaiEntFut.Next;

    End; {While}

    cdsBaiEntFut.EnableControls;


    if Assigned(LcdsClone) then
      FreeAndNil(LcdsClone)

  Except

    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message,'[fBaixaEntregaFutura]');
    End;

  End;

End;

