End;}

function TFatVenda.fRetornaDescricaoTipoMovimento(tmvTipMov: TTipMov): String;
Begin
  Result := '';

  If (tmvTipMov = tmvRetira) Then
    Result := 'Retira'
  Else If (tmvTipMov = tmvEntregaImediata) Then
    Result := 'Entrega Imediata'
  Else
    Result := 'Entrega Futura';

End;

function TFatVenda.fDevolucaoComNetpoints: Boolean;
begin
  Result := (strOpcDoc = 'DV') And ((blnDevolvendoUtiNps) And (Not fEmptyStr(strCpfNpsDevolucoes))) And (Not blnEspelhoDevolucaoCliente);
end;

function TFatVenda.fLiberaTravaTipoMovimento(tmvTipMov: TTipMov; strCodEmp, strCodIte, strDesIte: String; fltQtdIte: Double; intAutInc: Integer): Boolean;
Var
  objLiberacao : TLiberacao;
  blnTravar: Boolean;
Begin

  blnTravar := False;

  If (Pos(strOpcDoc, 'OR_PD_VN_') <= 0) Then
  Begin
    Result := True;
    Exit;
  End;

  If (Self.fClienteFilialVenda(Self.strCodCli)) And (fRetCodEmpClienteFilial(Self.strCodCli) = VS_strCodEmp) And (fPermiteTransferenciaEstoque(VS_strCodEmp, strCodEmp)) Then
  Begin
    Result := True;
    Exit;
  End;

  If (Not fEmpresaComPermissaoParaTipoDeMovimento(strCodEmp, tmvTipMov)) Then
    blnTravar := True;

  If (blnTravar) Then
  Begin
    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('Liberação de Tipo de Movimento do Item.');
      objLiberacao.objMsgLibera.pAddTexto('A Empresa ' + VS_strCodEmp + ' não tem permissão para vender itens com o tipo de movimento "'+ fRetornaDescricaoTipoMovimento(tmvTipMov) + '" na Empresa ' + strCodEmp + '.');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTextoCaption('Item'      , strCodite + ' - ' + strDesIte                                    , 10);
      objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade', formatFloat(fMskDigitos(fCfgSis('DECQTD',VarInteger)), fltQtdIte), 10);
      objLiberacao.objMsgLibera.pAddQuebra;

      objLiberacao.strDirAce := 'LIBMOV';
      objLiberacao.strSenLib := fCfgSis('SENMOV');
      objLiberacao.strMsgSen := 'Senha para liberação do Tipo de Movimento do item';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCodIte := strCodIte;
      objLiberacao.intAutInc := intAutInc;
      objLiberacao.strCliente := strCodCli + ' - ' + strCliNom;
      objLiberacao.blnIgnInc := True;


      Result := fFatMensagemLiberacao(objLiberacao);
    finally
      FreeAndNil(objLiberacao);
    end;
  End
  Else
    Result := True;
End;

function EnviarEmailPedOrc(AOwner: TComponent;
                           ACodOperador,
                           AAutInc,
                           ANumDoc,
                           AEspDoc,
                           ACodEmp,
                           ACodCli : String;
                           var objParametrosEnvio : TParametrosEnvio): Boolean;
Var
  strTexto    : String;
  strAssunto  : String;
  blnConfirma : Boolean;
  qryFatDor   : TUniQuery;

  LDadosAutenticacao: TDadosLoginEmail;
  strCaminhoImagem: String;
begin
  Result := False;

  if OperadorCitelLogado then
    Exit;

  If (fEmptyStr(ACodOperador)) And objParametrosEnvio.blnShowMessages then
  Begin
    untFuncoesSimples.fMensagem('ATENÇÃO', 'Operador não informado!', ['&OK']);
    Exit;
  End;

  If (fEmptyStr(ANumDoc)) Or (fEmptyStr(AEspDoc)) Or
     (fEmptyStr(ACodEmp)) Or (fEmptyStr(ACodCli))  And objParametrosEnvio.blnShowMessages Then
  Begin
    untFuncoesSimples.fMensagem('ATENÇÃO', 'Dados do documento não foram informados, envio de e-mail cancelado!', ['&OK']);
    Exit;
  End;

  // VERIFICA PERMISSÃO PARA ENVIAR POR EMAIL
  If Not fVerificaAcessoSistema('PEMAIL', strLoginUsuarioLogado) Then
  Begin
    untFuncoesSimples.fMensagem('ATENÇÃO!', 'Esse usuário não tem direitos para executar essa operação!', ['&Ok']);
    Exit;
  End;

  strAssunto := '';

  If fLayoutAtivo(ANumDoc, AEspDoc, ACodEmp, 'C', False, False) Then
  Begin
    If objParametrosEnvio.blnShowDialog Then
    Begin
      Try
        pCriarFormularios(TfrmDigEmailPedOrcEditor, frmDigEmailPedOrcEditor);
        Try

          frmDigEmailPedOrcEditor.strNumDoc := ANumDoc;
          frmDigEmailPedOrcEditor.strCodEmp := ACodEmp;
          frmDigEmailPedOrcEditor.strEspDoc := AEspDoc;
          frmDigEmailPedOrcEditor.strCodCli := ACodCli;

          blnConfirma := (frmDigEmailPedOrcEditor.ShowModal = mrOk);

          objParametrosEnvio.strOrdem  := '1';
          objParametrosEnvio.strNomEmp := 'R';
          objParametrosEnvio.opcComSemPreco := impComPrecoGeral;
          objParametrosEnvio.blnComMar := True;
          objParametrosEnvio.blnLocFis := False;
          objParametrosEnvio.strModo   := frmDigEmailPedOrcEditor.edtModo.Text;
          objParametrosEnvio.blnCabCD  := False;

          If (blnConfirma) Then
          Begin

            if (frmDigEmailPedOrcEditor.edtTipExp.Text = 'P') then
              begin
                if (AEspDoc='OR') then
                  objParametrosEnvio.strOrdem := fCfgSis('ORDORC', VarString)
                else
                  objParametrosEnvio.strOrdem := fCfgSis('ORDPDV', VarString);
              end
            else
              objParametrosEnvio.strOrdem := frmDigEmailPedOrcEditor.edtOrdem.Text;

            {E-mails selecionados}
            objParametrosEnvio.strEmailDestinatario := frmDigEmailPedOrcEditor.strEmails;

            objParametrosEnvio.blnAnexar            := frmDigEMailPedOrcEditor.chkAnexar.Checked;
            objParametrosEnvio.strTipExp            := frmDigEmailPedOrcEditor.strTipExp;
            objParametrosEnvio.opcComSemPreco       := frmDigEmailPedOrcEditor.opcComSemPreco;
            objParametrosEnvio.blnComMar            := frmDigEmailPedOrcEditor.chkMarca.Checked;
            objParametrosEnvio.strNomEmp            := IIF(frmDigEmailPedOrcEditor.rdgNomEmp.ItemIndex = 0, 'R', 'F');
            objParametrosEnvio.blnCabCD             := (frmDigEmailPedOrcEditor.edtEmpCab.Text = '2');
            objParametrosEnvio.blnLocFis            := false;
          End;
        Except
          On E: Exception Do
          Begin
            blnConfirma := False;
            pMensagensErro(E.Message, '[TEnvioEmail.EnviarEmailPedOrc]');
          End;
        End;
      Finally
        pFreeAndNil(frmDigEmailPedOrcEditor);
      End;
    End
    Else
      blnConfirma := True;
  End
  Else
  Begin
    If objParametrosEnvio.blnShowMessages Then
      fMensagem('ATENÇÃO', 'Não existe layout disponível para continuar!', ['&O k']);
    blnConfirma := False;
  End;

  If (Not blnConfirma) Then
    Exit;

  Try
    if objParametrosEnvio.blnCabCD then
      TEditorFastImpressao.strEmpresaLayout := fCfgSis('EMP_CD');

    TLeDocumentoPDOR.blnOcultarMarca := (not objParametrosEnvio.blnComMar);

    pCriarFormularios(TfrmFatGorEmail, frmFatGorEmail);
    objParametrosEnvio.strArqHtml := objParametrosEnvio.strArqHtml +
                  IIf(fEmptyStr(objParametrosEnvio.strArqHtml) , '', ',') +
                  frmFatGorEmail.fGeraEmail(ANumDoc,
                                            AEspDoc,
                                            objParametrosEnvio.opcComSemPreco,
                                            objParametrosEnvio.blnComMar,
                                            objParametrosEnvio.strTipExp,
                                            objParametrosEnvio.strModo,
                                            objParametrosEnvio.strOrdem,
                                            ACodEmp,
                                            objParametrosEnvio.blnLocFis,
                                            objParametrosEnvio.strNomEmp,
                                            ACodCli,
                                            objParametrosEnvio.blnCabCD);
  Finally
    TLeDocumentoPDOR.blnOcultarMarca := false;
    TEditorFastImpressao.strEmpresaLayout := '';
    pDestroiModulo(frmFatGorEmail);
  End;

  If (Not fEmptyStr(objParametrosEnvio.strArqHtml)) Then
  Begin
    objParametrosEnvio.strNumOse := objParametrosEnvio.strNumOse +
                                    IIf(fEmptyStr(objParametrosEnvio.strNumOse), '', ', ') +
                                    fCampoTabela('CONCAT(EQU_NUMOSE, "-", EQU_CODEMP)',
                                    'EQUGER',
                                    ['EQU_NUMPED', 'EQU_TIPPED', 'EQU_EMPPED'],
                                    [ANumDoc, AEspDoc, ACodEmp]);

     objParametrosEnvio.strDocumentos := objParametrosEnvio.strDocumentos +
                                        IIf(fEmptyStr(objParametrosEnvio.strDocumentos), '', ', ') + ANumDoc;

    If objParametrosEnvio.blnEnviar Then
    Begin
      If (AEspDoc = 'PD') Then
      Begin
       strAssunto := fRetNomeEmpresa + ' - ' + IIf(objParametrosEnvio.blnVariosDocumentos, 'Pedido(s): ', 'Pedido Nº: ');
       strTexto   := IIf(objParametrosEnvio.blnVariosDocumentos, 'Segue em anexo Pedido(s): ', 'Segue em anexo Pedido: ');
      End
      Else
      Begin
        strAssunto := fRetNomeEmpresa + ' - ' + IIf(objParametrosEnvio.blnVariosDocumentos, 'Orçamento(s): ', 'Orçamento Nº: ');
        strTexto   := 'Segue em anexo ' + IIf(objParametrosEnvio.blnVariosDocumentos, 'Orçamento(s): ', 'Orçamento: ');
      End;

      strTexto := strTexto + objParametrosEnvio.strDocumentos + '.';
      strAssunto := strAssunto + objParametrosEnvio.strDocumentos+ '.';

      If (Not fEmptyStr(objParametrosEnvio.strNumOse)) Then
      Begin
        If Not objParametrosEnvio.blnVariosDocumentos Then
          strTexto := strTexto + #13#10 + #13#10 + 'Referente a Ordem(ns) de Serviço(s): ' + objParametrosEnvio.strNumOse + #13#10 + #13#10
        Else
          strTexto := strTexto + #13#10 + #13#10 + 'Referente a Ordem de Serviço: ' + objParametrosEnvio.strNumOse + #13#10 + #13#10;
      End;

      If (objParametrosEnvio.strTipExp = 'P') Then
      Begin
        strTexto := strTexto + #13#10 + #13#10;
        strTexto := strTexto + 'Caso não possua o programa Acrobat Reader para visualizar o arquivo anexo, ';
        strTexto := strTexto + 'acesse o link e faça o download: <a href="https://www.adobe.com">www.adobe.com</a>';
      End;

    End;

    If (AEspDoc = 'OR') Or (AEspDoc = 'PD') Then
      pRetornarModeloEmailAutomatico(objParametrosEnvio.strEmailDestinatario,
                                     ANumDoc,
                                     AEspDoc,
                                     AEspDoc,
                                     '',
                                     'CR',
                                     ACodEmp,
                                     ACodCli,
                                     strTexto,
                                     strAssunto,
                                     LDadosAutenticacao,
                                     False,
                                     objParametrosEnvio.QRCodePix,
                                     objParametrosEnvio.LinkCitel);

    If (Not objParametrosEnvio.blnAnexar) Then
    Begin
      If (objParametrosEnvio.blnEnviar) Then
      Begin
        pCriarArrayAnexosEDestinatarios(objParametrosEnvio.strArqHtml, objParametrosEnvio.strEmailDestinatario, objParametrosEnvio.arrDestinatarios, objParametrosEnvio.arrArquivos);
        TEnvioEmail.EnviarEmail(AOwner,
                                ACodOperador,
                                strAssunto,
                                objParametrosEnvio.arrDestinatarios,
                                [], [],
                                TEnvioEmail.ContruirArrayMensagem(strTexto),
                                objParametrosEnvio.arrArquivos,
                                True, False, '', '', 0, False,
                                LDadosAutenticacao.Senha,
                                LDadosAutenticacao.Email,
                                LDadosAutenticacao.Login,
                                LDadosAutenticacao.Remetente,
                                LDadosAutenticacao.Provedor,
                                LDadosAutenticacao.PortaSMTP,
                                LDadosAutenticacao.PortaIMAP,
                                LDadosAutenticacao.ServidorSMTP,
                                LDadosAutenticacao.ServidorImap,
                                LDadosAutenticacao.LimiteArquivos,
                                LDadosAutenticacao.ImagemAssinatura,
                                LDadosAutenticacao.TextoAssinatura,
                                LDadosAutenticacao.ImagemAssinaturaStream,
                                '', '',
                                LDadosAutenticacao.AutenticacaoSSL,
                                LDadosAutenticacao.AutenticacaoSSLImap,
                                LDadosAutenticacao.GravaPastaEnviados);
      End;
    End
    Else
    Begin

      qryFatDor := fCriaQuery(AOwner);

      Try

        With qryFatDor, SQL Do Begin
          Close;
          Clear;
          Add(' SELECT SQL_NO_CACHE FDO_CODITE, ITE_IMGB64 FROM FATDOR ');
          Add(' INNER JOIN ITEIMG ON FDO_CODITE = ITE_CODITE AND ITE_PRINCI = "S" ');
          Add(' WHERE FDO_SEQGER = :SEQGER ');
          ParamByName('SEQGER').AsString := AAutInc;
          Open;

          While Not Eof Do
          Begin
            if not fEmptyStr(FieldByName('ITE_IMGB64').AsString) then
            begin
              strCaminhoImagem := fCfgSis('PATIMG') +'\'+ FieldByName('FDO_CODITE').AsString;
              pFileImagemFromBase64(FieldByName('ITE_IMGB64').AsString, strCaminhoImagem);
              If FileExists(strCaminhoImagem) Then
                objParametrosEnvio.strArqHtml := objParametrosEnvio.strArqHtml + ',' + strCaminhoImagem;
            end;

            Next;
          End;
        End;

        If (objParametrosEnvio.blnEnviar) Then
        Begin
          pCriarArrayAnexosEDestinatarios(objParametrosEnvio.strArqHtml, objParametrosEnvio.strEmailDestinatario, objParametrosEnvio.arrDestinatarios, objParametrosEnvio.arrArquivos);

          Result := TEnvioEmail.EnviarEmail(AOwner, ACodOperador, strAssunto, objParametrosEnvio.arrDestinatarios, [], [],
             TEnvioEmail.ContruirArrayMensagem(strTexto), objParametrosEnvio.arrArquivos);
        End;
      Finally
        FreeAndNil(qryFatDor);
      End;
    End;
  End
  Else
    untFuncoesSimples.fMensagem('ATENÇÃO!', 'Não foi possível exportar o arquivo PDF !', ['&Ok']);
end;

function TFatVenda.fReabreOcorrenciaCRMPedidosDevolvido : Boolean;
  Var
    stlDocDev : TStringList;
    stlPedidos: TStringList;
    intIndex  : Integer;
    strDocDev : String;
    qryConsul : TUniQuery;
Begin
  Try
    Result    := True;
    qryConsul := fCriaQuery;
    stlDocDev := TStringList.Create;
    stlPedidos:= TStringList.Create;

    For intIndex := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      strDocDev := arrMatItens[intIndex].strDocDev +
                   arrMatItens[intIndex].strEspDev +
                   arrMatItens[intIndex].strEmpDev +
                   arrMatItens[intIndex].strCodIte;

      If stlDocDev.IndexOf(strDocDev) < 0 Then
        stlDocDev.Add(strDocDev);
    End;

    With qryConsul, SQL Do
    Begin
      Close;
      Clear;
      Add(' SELECT DET_NUM_PD,         ');
      Add('        DET_ESP_PD,         ');
      Add('        DET_EMP_PD          ');
      Add(' FROM MOVDET                ');
      Add(' WHERE DET_NUMDOC = :NUMDOC ');
      Add('   AND DET_ESPDOC = :ESPDOC ');
      Add('   AND DET_CODEMP = :CODEMP ');
      Add('   AND DET_CODITE = :CODITE ');

      For intIndex := 0 To stlDocDev.Count-1 Do
      Begin
        ParamByName('NUMDOC').AsString := Copy(stlDocDev[intIndex], 01, 12);
        ParamByName('ESPDOC').AsString := Copy(stlDocDev[intIndex], 13, 02);
        ParamByName('CODEMP').AsString := Copy(stlDocDev[intIndex], 15, 03);
        ParamByName('CODITE').AsString := Copy(stlDocDev[intIndex], 18, fTamCodIte);

        Open;

        strDocDev := FieldByName('DET_NUM_PD').AsString +
                     FieldByName('DET_ESP_PD').AsString +
                     FieldByName('DET_EMP_PD').AsString;

        If stlPedidos.IndexOf(strDocDev) < 0 Then
          stlPedidos.Add(strDocDev);

      End;

      For intIndex := 0 To stlPedidos.Count-1 Do
      Begin
        Try
          objOcoCrm := fAtualizaInformacoesCRM(strNumDoc,    //Copy(stlPedidos[intIndex], 01, 12),
                                               strEspDoc,    //Copy(stlPedidos[intIndex], 13, 02),
                                               VS_strCodEmp, //Copy(stlPedidos[intIndex], 15, 03),
                                               strCodCli,
                                               Copy(stlPedidos[intIndex], 01, 12),
                                               Copy(stlPedidos[intIndex], 13, 02),
                                               strCodVen,
                                               afcDevolucao,
                                               '',
                                               strCliCgc);
          objOcoCrm.strNomFrm := '[TFatVenda.fReabreOcorrenciaCRMPedidosDevolvido]';
          TAtuOcoCrm(objOcoCrm).pProcessaFatOcorrenciasCRM;
          FreeAndNil(objOcoCrm);
        Except
          On E : Exception Do
          Begin
            Result := False;
            pMensagensErro(E.Message, 'TFatVenda.fReabreOcorrenciaCRMPedidosDevolvido');
          End;
        End;

      End;

    End;
  Finally
    FreeAndNil(stlDocDev);
    FreeAndNil(stlPedidos);
    FreeAndNil(qryConsul);
    If Assigned(objOcoCrm) Then
      FreeAndNil(objOcoCrm);
  End;

End;

class function TFatVenda.fReabrirPedidoOrcamentoBaixado(strNumDoc, strEspDoc,
  strCodEmp, strCodCli: String): Boolean;
var
  qryGen: TUniQuery;
begin
  Try
    qryGen := fCriaQuery;
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT 1 FIRST                       ');
      SQL.Add('   FROM TINDOR                        ');
      SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC          ');
      SQL.Add('    AND FDO_ESPDOC = :ESPDOC          ');
      SQL.Add('    AND FDO_CODEMP = :CODEMP          ');
      SQL.Add('    AND FDO_CODCLI = :CODCLI          ');
      SQL.Add('    AND TINDOR.FDO_BAIXAD = "1"       ');
      SQL.Add('    AND TINDOR.FDO_OPEBAI IS NOT NULL ');
      SQL.Add('    AND TINDOR.FDO_DTABAI IS NOT NULL ');
      SQL.Add('    AND TINDOR.FDO_HORBAI IS NOT NULL ');
      SQL.Add('    LIMIT 1                           ');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      Result := IsEmpty;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

