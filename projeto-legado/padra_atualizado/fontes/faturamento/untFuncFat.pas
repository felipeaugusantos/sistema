function TFatVenda.fRetLocalArmazenamentoColetor: String;
var
  LQry: TUniQuery;
  dicVistos: TDictionary<String, Boolean>;
  item: TDadosFechamento;
  strChvDoc: String;
begin
  LQry := fCriaQuery;
  dicVistos := TDictionary<String, Boolean>.Create;
  try
    LQry.SQL.Add('SELECT LAR_DESLAR');
    LQry.SQL.Add('FROM EXTLAR');
    LQry.SQL.Add('INNER JOIN CADLAR ON SEQ_CODLAR = CADLAR.AUTOINCREM');
    LQry.SQL.Add('INNER JOIN FATGOR ON COD_FATGOR = FATGOR.AUTOINCREM');
    LQry.SQL.Add('WHERE FATGOR.FGO_NUMDOC = :NUMDOC');
    LQry.SQL.Add('  AND FATGOR.FGO_ESPDOC = :ESPDOC');
    LQry.SQL.Add('  AND FATGOR.FGO_CODEMP = :CODEMP');

    For item In Self.ArrMatItens Do
    Begin
      if fEmptyStr(item.strNumOrc) then
        Continue;

      strChvDoc := Concat(item.strNumOrc,'-',item.strEspOrc,'-',item.strEmpOrc);

      If Not dicVistos.ContainsKey(strChvDoc) Then
      Begin
        LQry.Close;
        LQry.ParamByName('NUMDOC').AsString := item.strNumOrc;
        LQry.ParamByName('ESPDOC').AsString := item.strEspOrc;
        LQry.ParamByName('CODEMP').AsString := item.strEmpOrc;
        LQry.Open;
        LQry.First;

        while not LQry.Eof do
        begin
          pIncrementaListaStr(LQry.FieldByName('LAR_DESLAR').AsString, Result, False);

          LQry.Next;
        end;

        dicVistos.Add(strChvDoc, True);
      End;
    End;
  finally
    FreeAndNil(LQry);
    FreeAndNil(dicVistos);
  end;
end;

