function fFazConferenciaEFaturamentoDeItensRetiraBalcaoSemDesmembrar(const blnTemRetiraBalcao: Boolean): Boolean;
begin
  Result := False;

  If (Not blnTemRetiraBalcao) Then
    Exit;

  If (Not fCfgSis('NOTDES', varBoolean)) Then
    Exit;

  Result := True;
end;

function fVerificaTipFatPerfilCondicaoF11(strEspDoc, strDigCodCnd: String; qryFatGor: TUniQuery): Boolean;
  Var
    strTipFat: String;
    strCodCnd: String;
begin
  If qryFatGor.Active And Not qryFatGor.IsEmpty Then
    strCodCnd := qryFatGor.FieldByName('FGO_CODCND').AsString
  Else
    strCodCnd := strDigCodCnd;

  Result := True;

  If fEmptyStr(strCodCnd) Then
    Exit;

  strTipFat := fCampoTabela('CND_TIPFAT', 'CADCND', ['CND_CODIGO'], [strCodCnd]);

  If Pos(strEspDoc, 'NF_EL_NS_') > 0 Then
    Result := Pos('A', strTipFat) > 0

  Else If Pos(strEspDoc, 'MI_FF_') > 0 Then
    Result := Pos('B', strTipFat) > 0

  Else If Pos(strEspDoc, 'IF_IV_') > 0 Then
    Result := Pos('C', strTipFat) > 0;
end;

function fDeveSetarEspeciePedidoFechamentoF11(strNumDoc: String;
                                              strEspDoc: String;
                                              strEmpDoc: String;
                                              qryFatGor: TUniQuery;
                                              blnDesmembrarVenda: Boolean;
                                              blnTemEntregaFutura: Boolean;
                                              blnTemEntregaImediata: Boolean;
                                              blnTemRetiraOutraLoja: Boolean;
                                              blnVendaOrigOutraLoja: Boolean;
                                              blnTemRetiraMesmaLoja: Boolean;
                                              blnTemRetiraBalcao: Boolean;
                                              blnTemRetiraExpedicao: Boolean;
                                              blnTemItensEmpresaCD: Boolean;
                                              cdsItensCheckout: TUniClientDataSet = nil;
                                              blnVaiGerarPedidoParaTodosOsDesmembramentos : Boolean = False): Boolean;
begin
  Result := False;
  If (Not blnDesmembrarVenda) And (fCfgSis('TOLF11', varBoolean)) Then
  Begin
    If (blnTemEntregaImediata ) And (fCfgSis('NPDF11', varBoolean)) Then
      Exit(True);

    If (blnTemRetiraOutraLoja ) And (fCfgSis('NPRF11', varBoolean)) Then
      Exit(True);

    If (blnTemRetiraMesmaLoja ) And
       (Not fFazConferenciaEFaturamentoDeItensRetiraBalcaoSemDesmembrar(blnTemRetiraBalcao)) And
       (fCfgSis('NPLF11', varBoolean)) Then
    Begin
      Exit(True);
    End;
  End

  Else If (Not blnDesmembrarVenda) And
          (Not blnVendaOrigOutraLoja) And
          (Not fCfgSis('TOLF11', varBoolean)) Then
  Begin
    If ((blnTemEntregaImediata ) And
       (fCfgSis('NPDF11', varBoolean))) Or
       ((blnTemRetiraOutraLoja ) And
       (fCfgSis('NPRF11', varBoolean))) Or
       ((blnTemRetiraMesmaLoja ) And
       (fCfgSis('NPLF11', varBoolean))) Then
    Begin
      Exit(True);
    End;
  End;

  If (Not blnDesmembrarVenda) Then
  Begin
    If (blnTemRetiraExpedicao ) And (fCfgSis('LOCRET', varString) = 'S') Then
      Exit(True);

    If (blnTemRetiraBalcao) And (fCfgSis('LOCRET', varString) = 'S') And (fCfgSis('NOTDES', varString) = 'N') Then
      Exit(True);

    If (blnTemItensEmpresaCD) And (fCfgSis('ENT_CD', varString) = 'S') Then
      Exit(True);
  End;

  If fEhAbastecimentoPorDepositoComEntrega_e_Retira(qryFatGor) Then
    Exit(True);

  If (blnDesmembrarVenda) Then
  Begin
    If TValidaEntRecDocF11.fVaiGerarSomentePedidosF11(strNumDoc, strEspDoc, strEmpDoc, blnVendaOrigOutraLoja, cdsItensCheckout) Then
      Exit(True);
    If blnVaiGerarPedidoParaTodosOsDesmembramentos Then
      Exit(True);
  End;
end;

function fValidarTipoFaturamentoSelecionadoF11(strTipFatSel, strDigCodCnd, strConPag, strCodOpe: string; fatVenda: TFatVenda; qryFatGor: TUniQuery;
  blnDesmembrarVenda, blnTemEntregaFutura, blnTemEntregaImediata, blnTemRetiraOutraLoja, blnVendaOrigOutraLoja, blnTemRetiraMesmaLoja,
  blnTemRetiraBalcao, blnTemRetiraExpedicao, blnTemItensEmpresaCD: Boolean; var blnJaValidouDocs: Boolean): Boolean;
Var
  strEspeciesPermitidas: String;
begin
  Result := True;

  If (fEmptyStr(strTipFatSel)) Then
  Begin
    fMensagem('ATENÇÃO!', 'É necessário escolher uma espécie para fechamento!', ['&Ok']);
    Result := False;
  End
  Else If (strTipFatSel = 'IF') And (fCfgSisL('IF_PRZ') = 'N') And (strConPag <> '01000') Then
  Begin
    pMensagemOk('Não é permitido Cupom Fiscal com condição de pagamento a Prazo,'+#13#10+
                'pois nas Configurações de Faturamento não há permissão!');
    Result := False;
  End
  Else If (strTipFatSel = 'IF') And
          (Not blnDesmembrarVenda) And blnTemEntregaFutura And (fCfgSis('CUPNOT') = '1') And (Not fCfgSis('HEFCOE', varBoolean)) Then
  Begin
    pMensagemOk('Não é permitido Cupom Fiscal para Entrega Futura!');
    Result := False;
  End
  Else If (strTipFatSel = 'IF') And
          (Not blnDesmembrarVenda) And blnTemEntregaImediata And (fCfgSis('CUPENT') = '1') Then
  Begin
    pMensagemOk('Não é permitido Cupom Fiscal para Entrega Imediata!');
    Result := False;
  End
  Else If (strTipFatSel <> 'PD') And
          (Not blnDesmembrarVenda) And
          (blnTemEntregaImediata) And
          (fCfgSis('NPDF11', varBoolean)) And
          (fCfgSis('TOLF11', varBoolean)) Then
  Begin
    pMensagemOk('Apenas é permitido espécie Pedido para documento que possui somente itens de entrega imediata' + IIF(fCfgSis('EMPFAT', VarBoolean), '/Retira em outra Loja','')+ '!');
    Result := False;
  End
  Else If (strTipFatSel <> 'PD') And
          (Not blnDesmembrarVenda) And
          (blnTemRetiraOutraLoja) And
          (fCfgSis('NPRF11', varBoolean)) And
          (fCfgSis('TOLF11', varBoolean)) Then
  Begin
    pMensagemOk('Apenas é permitido espécie Pedido para documento que possui somente itens de entrega imediata' + IIF(fCfgSis('EMPFAT', VarBoolean), '/Retira em outra Loja','')+ '!');
    Result := False;
  End
  Else If (blnVendaOrigOutraLoja) And
          (blnTemRetiraOutraLoja) And
          (fCfgSis('NPRF11', varBoolean)) And (Not fCfgSis('TOLF11', varBoolean)) Then
  Begin
    If (strTipFatSel = 'PD') Then
    Begin
      pMensagemOk('Não permitido espécie Pedido para documento originado em outra Loja!');
      Result := False;
    End
    Else If fEmptyStr(strTipFatSel) Then
    Begin
      pMensagemOk('Selecione o tipo de faturamento!');
      Result := False;
    End
  End
  Else If (blnVendaOrigOutraLoja) And
          (blnTemEntregaImediata) And
          (fCfgSis('NPDF11', varBoolean)) And (Not fCfgSis('TOLF11', varBoolean)) Then
  Begin
    If (strTipFatSel = 'PD') Then
    Begin
      pMensagemOk('Não permitido espécie Pedido para documento originado em outra Loja!');
      Result := False;
    End
    Else If fEmptyStr(strTipFatSel) Then
    Begin
      pMensagemOk('Selecione o tipo de faturamento!');
      Result := False;
    End
  End
  Else If (strTipFatSel <> 'PD') And
          (Not blnDesmembrarVenda) And
          (blnTemRetiraMesmaLoja) And
          (Not fFazConferenciaEFaturamentoDeItensRetiraBalcaoSemDesmembrar(blnTemRetiraBalcao)) And
          (fCfgSis('NPLF11', varBoolean)) And
          (fCfgSis('TOLF11', varBoolean)) Then
  Begin
    pMensagemOk('Apenas é permitido espécie Pedido para documento que possui somente itens de entrega imediata' + IIF(fCfgSis('EMPFAT', VarBoolean), '/Retira em outra Loja','')+ '!');
    Result := False;
  End

  Else If (blnVendaOrigOutraLoja) And
          (blnTemRetiraMesmaLoja) And
          (fCfgSis('NPLF11', varBoolean)) And (Not fCfgSis('TOLF11', varBoolean)) Then
  Begin
    If (strTipFatSel = 'PD') Then
    Begin
      pMensagemOk('Não permitido espécie Pedido para documento originado na mesma loja!');
      Result := False;
    End
    Else If fEmptyStr(strTipFatSel) Then
    Begin
      pMensagemOk('Selecione o tipo de faturamento!');
      Result := False;
    End
  End
  Else If (strTipFatSel <> 'PD') And
          (Not blnDesmembrarVenda) And (blnTemRetiraExpedicao) And (fCfgSis('LOCRET', varBoolean))  Then
  Begin
    pMensagemOk('Apenas é permitido espécie Pedido para documento que possui somente itens de retira na expedição!');
    Result := False;
  End
  Else If (strTipFatSel <> 'PD') And (fCfgSis('NOTDES', varString) = 'N') And
          (Not blnDesmembrarVenda) And (blnTemRetiraBalcao) And (fCfgSis('LOCRET', varString) = 'S') Then
  Begin
    pMensagemOk('Apenas é permitido espécie Pedido para documento que possui somente itens de retira balcão!');
    Result := False;
  End
  Else If (strTipFatSel <> 'PD') And
          (Not blnDesmembrarVenda) And (blnTemItensEmpresaCD) And (fCfgSis('ENT_CD', VarString) = 'S') Then
  Begin
    pMensagemOk('Apenas é permitido espécie Pedido para documento que possui somente itens para faturamento em outra empresa!');
    Result := False;
  End
  Else If (fCfgSis('PFLCLI', varBoolean)) And
          (Not fVerificaTipFatPerfilCondicaoF11(strTipFatSel, strDigCodCnd, qryFatGor)) Then
  Begin
    fMensagem('ATENÇÃO!', 'Esse Tipo de Faturamento não é permitido pelo tipo de perfil da condição de pagamento!', ['&Ok']);
    Result := False;
  End
  Else If (Pos(strTipFatSel, 'MI_FF') > 0) Then
  Begin
    {*****************************************}
    {* SE NÃO FOR ACEITO MI FORA DO ESTADO   *}
    {**************************************PZ*}
    If (Not fCfgSis('MIFEST', varBoolean)) Then
    Begin

      If (fatVenda.fTrocaUFEndEntrega <> fCadEmp('ESTADO')) And (fVerificaSituacaoTributaria(fatVenda)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é permitido confirmar ' + strTipFatSel + ' com produto que ' +
                              'tenha substituição tributária para cliente fora do estado!', ['&O k']);
        Result := False;
      End;

    End;

  End;

  If Result And fatVenda.blnVendaPresencial Then
  Begin
    If Not fatVenda.fValidaEspecieVendaPresencial(strTipFatSel, strEspeciesPermitidas) Then
    Begin
      pMensagemOk(Format(MSG_ESPECIES_PERMITIDAS_VENDA_PRESENCIAL, [strEspeciesPermitidas]));
      Result := False;
    End;
  End;

  If (Result) And (Not blnJaValidouDocs) Then
  Begin
    If Not fatVenda.fTemPermissaoEspecieDocumento(strTipFatSel, strCodOpe) Then
      Result := False;

    If (fCfgSis('CUPNOT', varInteger) = 1) And
       (fatVenda.strEntFat = 'S') And
       (strTipFatSel = 'IF') And
       (fatVenda.strEntFut = 'S') Then
    Begin
      If Not fatVenda.fTemPermissaoEspecieDocumento('NF', strCodOpe, 'Entrega Futura') Then
        Result := False;
    End;

    If fatVenda.fTemItensEntregaImediata Then
    Begin
      If (fCfgSis('CUPENT', varInteger) = 1)      And
         (strTipFatSel = 'IF') Then
      Begin
        If Not fatVenda.fTemPermissaoEspecieDocumento('NF', strCodOpe, 'Entrega Imediata') Then
          Result := False;
      End;

      If Not fatVenda.fTemPermissaoEspecieDocumento('PD', strCodOpe) Then
        Result := False;
    End;

    blnJaValidouDocs := Result;
  End;
end;

function fFaturamentoVaiGerarSomenteNovosPedidosF11(fatVenda: TFatVenda): Boolean;
const
  ESPECIE_PD = 'PD';
var
  blnJaValidouDocs     : Boolean;
  blnDesmembrarVenda   : Boolean;
  blnTemRetiraBalcao   : Boolean;
  blnTemEntregaFutura  : Boolean;
  blnTemItensEmpresaCD : Boolean;
  blnTemEntregaImediata: Boolean;
  blnTemRetiraOutraLoja: Boolean;
  blnTemRetiraExpedicao: Boolean;
  blnVendaOrigOutraLoja: Boolean;
  blnTemRetiraMesmaLoja: Boolean;
begin
  blnJaValidouDocs := False;

  blnVendaOrigOutraLoja := fatVenda.qryFatGor.FieldByName('FGO_CODEMP').AsString <> VS_strCodEmp;

  blnDesmembrarVenda    := fatVenda.fHaveraDesmembramentoVenda(fatVenda.arrMatItens);
  blnTemEntregaFutura   := fatVenda.fTemEntregaFutura(fatVenda.arrMatItens);
  blnTemEntregaImediata := fatVenda.fTemItensEntregaImediata(fatVenda.arrMatItens);
  blnTemRetiraOutraLoja := fatVenda.fTemItensRetira(fatVenda.arrMatItens, opOutraEmpresa);
  blnTemRetiraExpedicao := fatVenda.fTemItensRetira(fatVenda.arrMatItens, opTodasEmpresas, opLocalRetiraExpedicao);
  blnTemItensEmpresaCD  := fatVenda.fTemItensEmpresaCD(fatVenda.arrMatItens);

  blnTemRetiraMesmaLoja := fatVenda.fTemItensRetira(fatVenda.arrMatItens, opPropriaEmpresa) And
                           not fatVenda.fTemItensRetira(fatVenda.arrMatItens, opPropriaEmpresa, opLocalRetiraCaixa);

  blnTemRetiraBalcao    := fatVenda.fTemItensRetira(fatVenda.arrMatItens, opTodasEmpresas, opLocalRetiraBalcao) Or
                           fatVenda.fTemItensRetira(fatVenda.arrMatItens, opTodasEmpresas, opLocalRetiraBalcao2);

  If Not fDeveSetarEspeciePedidoFechamentoF11(fatVenda.strNumOrc,
                                              fatVenda.strEspOrc,
                                              fatVenda.strEmpOri,
                                              fatVenda.qryFatGor,
                                              blnDesmembrarVenda,
                                              blnTemEntregaFutura,
                                              blnTemEntregaImediata,
                                              blnTemRetiraOutraLoja,
                                              blnVendaOrigOutraLoja,
                                              blnTemRetiraMesmaLoja,
                                              blnTemRetiraBalcao,
                                              blnTemRetiraExpedicao,
                                              blnTemItensEmpresaCD,
                                              nil) Then
  Begin
    Exit(False);
  End;

  If Not fValidarTipoFaturamentoSelecionadoF11(ESPECIE_PD, fatVenda.strCodCnd, fatVenda.strConPag,
                                               fatVenda.strCodVen, fatVenda, fatVenda.qryFatGor, blnDesmembrarVenda,
                                               blnTemEntregaFutura, blnTemEntregaImediata, blnTemRetiraOutraLoja,
                                               blnVendaOrigOutraLoja, blnTemRetiraMesmaLoja, blnTemRetiraBalcao,
                                               blnTemRetiraExpedicao, blnTemItensEmpresaCD,
                                               blnJaValidouDocs) Then
  Begin
    Exit(False);
  End;

  Result := True;
end;

function fValidarEmissaoNotaEspecialExpedicao(fatVenda: TFatVenda): Boolean;
begin
  Result := True;

  If Not fatVenda.blnExpedi Then
    Exit;

  If Not Assigned(fatVenda.objExpedicao) Then
    Exit;

  If (fatVenda.blnEmitindoFFDaNotaEspecialFatorPorValor) And
     (fatVenda.fHaveraDesmembramentoVenda(fatVenda.arrMatItens)) And
     (Assigned(fatVenda.objExpedicao.stlPedidos)) And
     (fatVenda.objExpedicao.stlPedidos.Count > 1) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido gerar nota especial por fator quando tem desmembramento de venda com mais de um pedido selecionado.' + #13 +
                          'Fature os pedidos separadamente.', ['&Ok']);
    Exit(False);
  End;

  {$IFDEF TESTABILIDADE_AUTCOM}
    // Não testa se o painel está aberto
  {$ELSE}
  If (fatVenda.fEmiteNotaEspecial(fatVenda.strEspDoc)) And
     (fCfgSis('NFEUSA', varString) = 'S') And
     (fCfgSis('PNLNFE', varString) = 'S') And
     (Not fPainelEstaAberto) Then
  Begin
    fMensagem('ATENÇÃO!', 'Atenção: o PainelNFe da loja (' + VS_strCodEmp + ') não está aberto. Por favor verifique e feche a venda novamente.', ['&Ok']);
    Exit(False);
  End;

  If fEmitenteComRestricaoFiscal(VS_strCodEmp, fatVenda.strEspDoc) Then
  Begin
    fMensagem('ATENÇÃO!', 'Atenção: O Emitente não está habilitado para emissão de documento fiscal, verifique o cadastro junto a SEFAZ!', ['&OK']);
    Exit(False);
  End;
  {$ENDIF}
end;

function fValidarPerfilCondicaoPagamentoExpedicao(fatVenda: TFatVenda): Boolean;
var
  fltValorTotalExp : Double;

  function fCalcularMargemLucro: Double;
  Var
    cdsData      : OleVariant;
    recTotMarLuc : TRecTotaisMargemLucro;
  begin
    cdsData := fatVenda.fCalculaMargemLucro(True);

    fatVenda.pCalculaTotaisMargemLucro(cdsData,
                                   recTotMarLuc);

    Result := TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, True);
  End;

begin
  Result := True;
  If fatVenda.objExpedicao.blnExpParcial Then
  Begin
    fltValorTotalExp := fatVenda.fValorTotalExpedido;
    If fltValorTotalExp > 0 Then
      If not fatVenda.fValidacoesPerfilCndExpedicao(fatVenda.strPedExp, fltValorTotalExp, fCalcularMargemLucro)  Then
        Result := False;
  End;
end;

