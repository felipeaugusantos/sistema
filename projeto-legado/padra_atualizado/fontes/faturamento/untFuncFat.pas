class function TFatVenda.fExisteNovaCotacaoDolarVenda(ANumDoc, AEspDoc, AEmpDoc: String): Boolean;
Const
  SQL_FATGOR = 'FATGOR INNER JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM';
Var
  LDataUltimaCotacao: TDateTime;
  LValorUltimaCotacao: Double;
  LDataCotacaoDocumento: TDateTime;
  LValorCotacaoDocumento: Double;
begin
  LDataCotacaoDocumento  := fCampoTabela('FGO_DTCTVN', SQL_FATGOR, ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'], [ANumDoc, AEspDoc, AEmpDoc]);
  LValorCotacaoDocumento := fCampoTabela('FGO_VLCTVN', SQL_FATGOR, ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'], [ANumDoc, AEspDoc, AEmpDoc]);

  LDataUltimaCotacao  := fCampoTabela('MAX(MOE_DTAMOE)','CADMOE',[],[]);
  LValorUltimaCotacao := fCampoTabela('MOE_DOLVEN','CADMOE',['MOE_DTAMOE'],[FormatDateTime('yyyy-mm-dd', LDataUltimaCotacao)]);
  
  Result := (LDataUltimaCotacao <> LDataCotacaoDocumento) Or (fFormataFloat(LValorCotacaoDocumento,6) <> fFormataFloat(LValorUltimaCotacao,6));
end;

function TFatVenda.fExisteNovaCotacaoDolarVenda: Boolean;
