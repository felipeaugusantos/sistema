function TfatVenda.fDigitaDuplicata(Var blnMostraDigDuplic: Boolean;
                                    Var arrDatas: TDateArray;
                                        dtaPreVis: TDate;
                                        blnPediuTipFat: Boolean;
                                    Var arrDuplicCopVenda: TDigDuplicArray;
                                        fltTotDup: Double = 0;
                                        fltCreAut: Double = 0): Boolean;
  Var
    blnEditavel: Boolean;
    intContador: Integer;
    blnSabDomFeriadosComoDiaUtil: Boolean;
    fltDescPrimeraParcela: Double;
    LblnUtilizarDataEmissaoCalcularDiaVencimento: boolean ;
    blnAbreTelaComCreditoAutomatico: Boolean;
Begin
  Result := True;
  fltDescPrimeraParcela := 0;

  blnSabDomFeriadosComoDiaUtil := fCfgSis('FSDUDP', varBoolean);
  blnAbreTelaComCreditoAutomatico := True;

  If fPedeDuplicata Then
  Begin
    LblnUtilizarDataEmissaoCalcularDiaVencimento := fUtilizarDataEmissaoCalcularDiaVencimento ;
    {********************************************}
    {* LIMPA A MATRIZ USADA NA FUNÇÃO DIGDUPLIC *}
    {*****************************************MV*}
    pZeraDigDuplic(arrDuplicata);

    blnMostraDigDuplic := (fStatusCndPag(strConPag) = A_PRAZO) And
                          (Not blnMeiaNota) And
                          (Not (blnCupEsp And (strOpcDoc = 'CF'))) And
                          (strConPag <> '01999') And
                          IIF(strOpcDoc = 'CI', fGerarCTR_CI, True) And
                          (Not ((strCodFpg = '016') And (Pos(strOpcDoc, 'CP_OV_') > 0)));

    If (strEspDoc = 'PD') Then
    Begin
      blnMostraDigDuplic := (fStatusCndPag(strConPag) = A_PRAZO);

      If (fFormataFloat(fltTotCadRec - fltValAdt - fltBolAdt, 2) <= 0.0) Then
        blnMostraDigDuplic := False;

      If fPermiteInformarVencimentosParaBoletoDeAdiantamento(blnBolVen) Or
         fPermiteInformarVencimentosParaBoletoDeAdiantamento(Not blnBolVen) Then
        blnMostraDigDuplic := True;
    End;

    If (Pos(strOpcDoc, 'VN_CP_OV_') > 0) Then
    Begin
      If (fFormataFloat(fltTotCadRec - fltValAdt - fltBolAdt, 2) <= 0.0) Then
        blnMostraDigDuplic := False;
    End;

    If (strOpcDoc = 'CN') And (strEspDoc = 'NS') Then
    Begin
      If (fFormataFloat(fltTotCadRec - fltValAdt - fltBolAdt, 2) <= 0.0) Then
        blnMostraDigDuplic := False;
    End;

    If (Pos(strEspDoc, 'OR_PD') > 0) And (strCodFpg = '009') Then
      blnMostraDigDuplic := False;

    If (strOpcDoc = 'CI') And (fCfgSis('PROCTR') = '1') Then
      blnMostraDigDuplic := False;

    If IIF((Pos(strOpcDocUntFuncFat, 'OR_PD_VN') > 0), False, blnMulLoj Or blnFinali) Or blnGravandoVariosDocumentos Then
      blnMostraDigDuplic := False;

    If blnMostraDigDuplic And (Pos(strOpcDoc, 'VN_') > 0) Then
      blnMostraDigDuplic := fCfgSis('DUPVEN', varBoolean);

    If blnMostraDigDuplic And (Pos(strEspDoc, 'OR_PD_') > 0) Then
      blnMostraDigDuplic := fCfgSis('DUPORP', varBoolean);

    If blnMostraDigDuplic And (Pos(strOpcDoc, 'CF_') > 0) Then
      blnMostraDigDuplic := fCfgSis('TDUPCD', varBoolean);

    {*******************************************}
    {* QUANDO É PEDIDO, NÃO USA "DATE" NA DIG- *}
    {* DUPLIC, E SIM A DATA DA PREVISÃO        *}
    {****************************************MV*}
    dtaDigDup := Self.VS_Date;

    {***************************************************************************************}
    {* UTILIZA A DATA DA EMISSÃO DO PEDIDO COMO BASE PARA CALCULO DA CONDIÇÃO DE PAGAMENTO *}
    {************************************************************************************PZ*}
    If (fUtilizarComoDataBaseCtrDataEmissaoPedido(fFaturandoPedido, LblnUtilizarDataEmissaoCalcularDiaVencimento)) Then
    Begin
      {********************************************************************************************************}
      {* CASO O PEDIDO ESTEJA SENDO FATURADO ANTECIPADAMENTE À DATA DE PREVISÃO, UTILIZAR ESSA DATA           *}
      {* AQUI TRATO PARA BUSCAR DA Self.dtaPreVis(Global), POIS O PARAMETRO SOFRE UMA VERIFICAÇÃO QUE NÃO USO *}
      {*****************************************************************************************************KM*}
      If (fUtilizarComoDataBaseCtrDataPrevisaoPedido(fFaturandoPedido)) And (Self.dtaPreVis <> 0) And (Self.VS_Date < Self.dtaPreVis) Then
        dtaDigDup := Self.dtaPreVis
      Else
        dtaDigDup := dtaDtaEntOri
    End
    Else If Self.fUtilizarDataPrvDataFatComoDataBaseParaCalculoVencimento Then
    Begin
      dtaDigDup := fRetDataBaseCalculoCondicaoPagto(Self.dtaPreVis, Self.fFaturandoPedido, Self.dtaDtaEntOri, LblnUtilizarDataEmissaoCalcularDiaVencimento);
    End
    Else If (Pos(strOpcDoc, 'OR_PD_') > 0) Then
    Begin
      dtaDigDup := dtaPreVis;
      If (fCfgSis('AJPZDF', VarBoolean)) and
         (not fCfgSis('SEGCND', VarBoolean)) Then
        dtaDigDup :=  Self.VS_Date;
    End;

    {*********************************************************}
    {*   *******************************************         *}
    {*   * NAO EDITAR QUANDO FOR PEDIDO            *         *}
    {*   ****************************************PH*         *}
    {*   blnEditavel := strOpcDoc <> 'PD';                   *}
    {*                                                       *}
    {*  ESSA CONDIÇÃO FOI TIRADA POR NÃO ESTAR ESPECIFICADO  *}
    {*  CORRETAMENTE A SUA FUNÇÃO. RONALDO AUTORIZOU....     *}
    {*  FOI TROCADA PELA CONFIGURAÇÃO CFG_ALTVNC             *}
    {*                                                       *}
    {******************************************PE-2012-01-19**}
    blnEditavel := fCfgSis('ALTVNC', varBoolean);

    If (Not fPermiteAlterarCondFormaPagtoConfNFConcreto) Then
      blnEditavel := False;

    {***********************************************************}
    {* NÃO PODE EDITAR O VENCIMENTO QUANDO O TIPO DE FORA FOR  *}
    {* DIFERENTE DE OUTROS. AUTORIZADO PELO RONALDO 29/03/2016 *}
    {********************************************************PZ*}
    If (fCfgSis('USACND', VarBoolean)) Then
    Begin
      If blnEditavel And (fRetTipoForaConPag(strCodCnd) <> 'OUTROS') Then
        blnEditavel := False;
    End;

    {*********************************************}
    {* CASO SEJA MEIA NOTA, NÃO MOSTRA DIGDUPLIC *}
    {******************************************MV*}
    If (blnCliFil) And (fEmptyStr(strConPag)) Then
      strConPag := '01000';

    If fltTotDup = 0 Then
    Begin
      If fPermiteInformarVencimentosParaBoletoDeAdiantamento(Not blnBolVen) Then
        fltTotDup := fltBolAdt
      Else
      Begin
        fltTotDup := fltTotCadRec - fltValAdt - IIF(blnBolVen, 0, fltBolAdt) - fltCreAut;

        If (fltCreAut > 0) And (fltTotDup <= 0) then
        Begin
          fltTotDup := fltTotDup + fltCreAut;
          blnAbreTelaComCreditoAutomatico := False;
        End;
      End;
    End;

    If fEhComplementoDeFrete Then
    Begin
      blnEditavel := True;
      blnMostraDigDuplic := True;
    End;

    If (fltTotDup < 0) And ((fltValAdt + IIF(blnBolVen, 0, fltBolAdt)) <> 0) Then
      fltTotDup := 0;

    If fCfgSis('RISS1P', VarBoolean) And (Pos(strEspDoc,'NF_EL_NS_IF_IV_') > 0) And (strRetIss = 'S') And (fltTotDup > 0) And (fltValIss > 0) Then
      fltDescPrimeraParcela := fltValIss;

    If (Not fDigDuplic(arrDuplicata, strConPag, 0, fltTotDup,
       blnMostraDigDuplic And (Not blnPediuTipFat), blnEditavel, False, dtaDigDup, False,
       fltImpFre, 'N', fCfgSis('DUPRED', varBoolean), True,
       fltValAdt + IIF(blnBolVen, 0, fltBolAdt), True, arrValDuplicCarrPedido, strEspDoc, blnSabDomFeriadosComoDiaUtil, True, pMostraContaCorrenteCliente,
       strCodCli, False, True, strCodCnd, strCodVen, fSenVar, fFaturandoPedido, False, nil, False, False, fltDescPrimeraParcela, '', strCodCid, strOpcDoc,
       False, LblnUtilizarDataEmissaoCalcularDiaVencimento, False, blnAbreTelaComCreditoAutomatico)) Then
    Begin
      Result := False;
      Exit;
    End;

    If (Assigned(arrValDuplicCarrPedido)) Then
      pSalvarDuplicCarrPedido(arrDuplicata);

    If (strConPag = '01999') Then
    Begin
      arrDuplicata[0].dtaDtaVen := DateToStr(Self.VS_Date + 1);
    End;

    LblnUtilizarDataEmissaoCalcularDiaVencimento := fCfgSis('DTPDCR',varBoolean) ;
    If (fUtilizarComoDataBaseCtrDataEmissaoPedido(fFaturandoPedido, LblnUtilizarDataEmissaoCalcularDiaVencimento)) Then
    Begin
      {****************************************************************************************************}
      {* MESMO QUE  O PEDIDO ESTEJA SENDO FATURADO ANTECIPADAMENTE À DATA DE PREVISÃO,  MANTENHO A VS_DATE*}
      {* POIS NESTE PONTO ELE USA A dtaDigDup PARA MONTAR A CONDIÇÃO DE PAGAMENTO E NÃO OS VENCIMENTOS    *}
      {*************************************************************************************************KM*}
      dtaDigDup := VS_DATE;
    End;

    For intContador := 0 To 23 Do
    Begin
      arrDuplicCopVenda[intContador] := arrDuplicata[intContador];
    End;

    intContador := 0;
    {*****************************************}
    {* REFAZ A CONDIÇÃO DE PAGAMENTO         *}
    {**************************************MV*}
    While (ArrDuplicata[intContador].dtaDtaVen <> '') And
          (intContador < 24)                          Do
    Begin

      SetLength(arrDatas, intContador+1);
      arrDatas[intContador] := StrToDate(ArrDuplicata[intContador].dtaDtaVen);
      Inc(intContador);

    End;


  End;

End; {fDigitaDuplicata}

Function TfatVenda.fGetItem(qryGenIte: TUniQuery; strCodIte, strEmpIte: String): Boolean;
  Var
    strSQL: String;
Begin
  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  I.ITE_CODGRU, ';
    strSQL := strSQL + '  I.ITE_PESOIT, ';
    strSQL := strSQL + '  I.ITE_PESLIQ, ';
    strSQL := strSQL + '  I.ITE_DESITE, ';
    strSQL := strSQL + '  I.ITE_DESSIM, ';
    strSQL := strSQL + '  I.ITE_DESFAB, ';
    strSQL := strSQL + '  I.ITE_COMLUB, ';
    strSQL := strSQL + '  I.ITE_CLAIPI, ';
    strSQL := strSQL + '  I.ITE_EXCIPI, ';
    strSQL := strSQL + '  I.ITE_CODFAB, ';
    strSQL := strSQL + '  I.ITE_CODBAR, ';
    strSQL := strSQL + '  G.ITE_PRECOM, ';
    strSQL := strSQL + '  G.ITE_PREVE1, ';
    strSQL := strSQL + '  G.ITE_PREVE2, ';
    strSQL := strSQL + '  G.ITE_PREVE3, ';
    strSQL := strSQL + '  G.ITE_PREVE4, ';
    strSQL := strSQL + '  G.ITE_PREVE5, ';
    strSQL := strSQL + '  G.ITE_PREVE6, ';
    strSQL := strSQL + '  G.ITE_PREVE7, ';
    strSQL := strSQL + '  G.ITE_PREULT, ';
    strSQL := strSQL + '  G.ITE_IMPULT, ';
    strSQL := strSQL + '  G.ITE_QTDUCO, ';
    strSQL := strSQL + '  G.ITE_IPISAI, ';
    strSQL := strSQL + '  G.ITE_DESMAX, ';
    strSQL := strSQL + '  G.ITE_SALDOS, ';
    strSQL := strSQL + '  G.ITE_PREMED, ';
    strSQL := strSQL + '  G.ITE_COMVAR, ';
    strSQL := strSQL + '  G.ITE_COMATA, ';
    strSQL := strSQL + '  G.ITE_COMDIS, ';
    strSQL := strSQL + '  G.ITE_COMDIG, ';
    strSQL := strSQL + '  G.ITE_MARMIN, ';
    strSQL := strSQL + '  G.ITE_MARMSG, ';
    strSQL := strSQL + '  G.ITE_MARMGE, ';
    strSQL := strSQL + '  G.ITE_IPIENT, ';
    strSQL := strSQL + '  G.ITE_FREENT, ';
    strSQL := strSQL + '  G.ITE_QTPPRO, ';
    strSQL := strSQL + '  G.ITE_PRECUS, ';
    strSQL := strSQL + '  A.ABF_CODABF, ';
    strSQL := strSQL + '  M.MAR_DESMAR, ';
    strSQL := strSQL + '  I.ITE_OBRCPF,  ';

    strSQL := strSQL + '  G.ITE_DESMVM, ';
    strSQL := strSQL + '  G.ITE_DESMSM, ';
    strSQL := strSQL + '  G.ITE_DESMGM, ';

    strSQL := strSQL + '  G.ITE_MARMMV, ';
    strSQL := strSQL + '  G.ITE_MARMMS, ';
    strSQL := strSQL + '  G.ITE_MARMMG, ';

    If fCfgSis('IMPDIG') = '1' Then
      strSQL := strSQL + '  I.ITE_IMPDIR  '
    Else
      strSQL := strSQL + '  G.ITE_IMPDIR  ';

    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  CADITE I, ';
    strSQL := strSQL + '  ITEGER G, ';
    strSQL := strSQL + '  ABFICM A, ';
    strSQL := strSQL + '  CADMAR M  ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  I.ITE_CODMAR = M.MAR_CODMAR AND ';
    strSQL := strSQL + '  I.ITE_CODITE = G.ITE_CODITE AND ';

    If fCfgSIs('TIPABF') = '1' Then
      strSQL := strSQL + '  I.ITE_CODABF = A.ABF_CODABF AND '
    Else
      strSQL := strSQL + '  G.ITE_CODABF = A.ABF_CODABF AND ';

    strSQL := strSQL + '  I.ITE_CODITE = :CODITE AND ';
    strSQL := strSQL + '  G.ITE_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  A.ABF_ESTADO = :ESTADO ';

    With qryGenIte Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := fGetEmpCalculoItem(strEmpIte);
      ParamByName('ESTADO').AsString := fGetUFEmpresa(strEmpIte);
      Open;
    End;

    Result := TRUE;

  Except

    On E: Exception Do
    Begin
      Result := False;
			pMensagensErro(E.Message,'[TfatVenda.fGetItem]');
    End;

  End;
End;

function TFatVenda.fGetItensParaValidacaoCestItens(AMatrizFechamento: TMatrizFechamento): String;
var intContadorCest : integer;
Const
  ENVIA_CEST_PARA_SUBSTITUIDOS : String = '1';

  function fIgnoraConfiguracaoCestST: Boolean;
  Begin
    Result := fCfgSis('EVCEST', varBoolean) And (Pos(AMatrizFechamento[intContadorCest].strClaFis, '5905_6905_') > 0);
  End;

begin
  Result := '';

  For intContadorCest := Low(AMatrizFechamento) To High(AMatrizFechamento) Do
  Begin
    if fEmptyStr(AMatrizFechamento[intContadorCest].strCodIte) then
      Continue;

    if (not fIgnoraConfiguracaoCestST) And (fCfgSis('CESTST', varString) = ENVIA_CEST_PARA_SUBSTITUIDOS) then
    begin
      If Pos(AMatrizFechamento[intContadorCest].strCodSit, CST_SUBSTITUICAO) > 0 Then
      Begin
        if fEmptyStr(Result) then
          Result := QuotedStr(AMatrizFechamento[intContadorCest].strCodIte)
        else
          Result := Result + ', ' + QuotedStr(AMatrizFechamento[intContadorCest].strCodIte);
      End;
    end
    else
    begin
      if fEmptyStr(Result) then
        Result := QuotedStr(AMatrizFechamento[intContadorCest].strCodIte)
      else
        Result := Result + ', ' + QuotedStr(AMatrizFechamento[intContadorCest].strCodIte);
    end;
  End;
end;

function fDocumentoEhProvenienteDeExpedicao(
  strEspSel, strNumDoc, strCliFor: String; strCodEmp: String=''): Boolean;
  Var
    qryAux: TUniQuery;
begin
  Result := False;

  If fCfgSis('TIPEXP') <> '2' Then
    Exit;

  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add('SELECT ');
  qryAux.SQL.Add('  GER_OPLBEX ');
  qryAux.SQL.Add('FROM ');
  qryAux.SQL.Add('  MOVGER ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  GER_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  GER_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  GER_CODEMP = :CODEMP AND ');
  qryAux.SQL.Add('  GER_CODCLI = :CODCLI ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := strEspSel;
  qryAux.ParamByName('CODEMP').AsString := IIF(fEmptyStr(strCodEmp), VS_strCodEmp, strCodEmp);
  qryAux.ParamByName('CODCLI').AsString := strCliFor;
  qryAux.Open;

  If (Not qryAux.IsEmpty) Then
  Begin
    Result := (Not fEmptyStr(qryAux.FieldByName('GER_OPLBEX').AsString));
  End;

  FreeAndNil(qryAux);
end;


