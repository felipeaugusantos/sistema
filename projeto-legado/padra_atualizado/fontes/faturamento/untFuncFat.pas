                                    0,
                                    0,
                                    Self.arrDocConsignacao[intIndice].fltValDoc,
                                    0,
                                    1.000000,
                                    0,
                                    0,
                                    qryConsignacao.FieldByName('CTR_VALORI').AsFloat,
                                    qryConsignacao.FieldByName('CTR_RECAUT').AsString,
                                    '',
                                    fGetValOriDuplicata(qryConsignacao.FieldByName('CTR_NUMDUP').AsString,
