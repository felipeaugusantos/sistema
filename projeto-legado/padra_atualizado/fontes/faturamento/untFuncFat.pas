                             strSerFsc,                                       // strSerie
                             0,                                               // intSeqBai
                             Self.VS_Date,                                    // dtaDtaCad
                             StrToDate(arrDuplicata[intContador].dtaDtaVen),  // dtaVen
                             fRetornaValorCadPag,                             // ValDup
                             fRetornaValorCadPag,                             // ValOri
                             'N',                                             // strPrevis
                             'N',                                             // strVeioBo
                             'N',                                             // strDeposi
                             strHisCtr,                                       // strHist01
                             arrDuplicata[intContador].strHist02,             // strHist2
                             '',                                              // strHistBai
                             strPorBai,                                       // strPorBai
                             strCtaBai,                                       // strCtaBai
                             strSeqLan,                                       // strDocBai
                             strOpeBai,                                       // strOpeBai
                             dtaDtaRec,                                       //  DtaPag
                             fltValRec,                                       //  ValPag
                             0,                                               //  ValJur
                             0,                                               //  ValDes
                             '',                                              //  strEmpGer
                             '',                                              //  CodEve
                             'N',                                             // strUsaChq
                             '',                                              // Codigo do Portador
                             fStrZero(strNumDoc, 12),                         // strNumDoc
                             0,
                             0,
                             intCtpCon,
                             False,
                             0,
                             '',
                             0,
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             '',
                             fltValRec,
                             0,
                             0,
                             0,
                             '',
                             0,
                             0,
                             '',
                             '',
                             '',
                             '',
                             '',
                             '0',
                             '',
                             '',
                             '',
                             '',
                             'N');

      If (Not Result) Then
        Break;

      Inc(intContador);

    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGCadPag]');
    End;
  End;

end;

function TFatVenda.fRetornaSaldoDisponivelItemNormal(strEmpIte,
                                                     strCodIte,
                                                     strNumLot,
                                                     strAutInc,
                                                     strCodAca,
                                                     strEmpAca: String;
                                                     fltSaldos: Double;
                                                     blnVerQtdDig : Boolean = True;
                                                     blnConsiderarTodosTiposEntFut: Boolean = False;
                                                     strEmpSalIte: String=''): Double;
  Var
    fltQtdDig,
    fltSalRes: Double;
    strEmpSal: String;
begin
  strEmpSal := IIF(Not fEmptyStr(strEmpSalIte), strEmpSalIte, fEmpresaSaldoMatriz_CD);

  fltQtdDig := 0.0;

  If (blnVerQtdDig) Then
  Begin
    fltQtdDig := fRetQtdDigitada(strCodIte,
                                 strNumLot,
                                 strAutInc,
                                 strCodAca,
                                 strEmpAca,
                                 strEmpIte,
                                 True,
                                 blnConsiderarTodosTiposEntFut);
  End;

  {****************************************}
  {* RETORNA O SALDO RESERVADO DO PRODUTO *}
  {*************************************JC*}
  fltSalRes := TSaldoReservado.New(
                 TReservaParametros.New()
                   .EmpresaItem(IIF(blnEmpFat Or (strOprFlj = 'S'), strEmpIte, ''))
                   .CodigoItem(strCodIte)
                   .NumeroDocumento(strNumOrc)
                   .TipoFiltroDocumento(tfdIgnorarDocumento)
                   .CodEmpresa(IIF(blnEmpFat Or (strOprFlj = 'S'), strEmpIte, strEmpSal))
                   .CodItemAcabado(strCodAca)
                   .EmpItemAcabado(strEmpAca)
                   .NumeroLote(IIF(fEhEmissaoDocumentoWMS Or
                                   fEmpresaParaFaturamentoUsaWMS(strEmpIte),
                                   IIF(strNumLot = 'A DEFINIR', '', strNumLot), strNumLot))
                   .DesconsideraPedidosCorte(Not blnPedCorte)
                 ).fGetQuantidade();

  fltSaldoDisponivelItem := (fltSaldos - fltQtdDig - fltSalRes);

  Result := fltSaldoDisponivelItem;
end;

function TFatVenda.fRetornaQtdPedCompraAberto(strCodIte: String; strCodEmp: String) : Double;
  Var
    qryGen : TUniQuery;
begin
  Result := 0;

  qryGen := fCriaQuery(Nil);
  Try
    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add('SELECT SQL_NO_CACHE ROUND(SUM(PCD_QTDITE - PCD_QTDBAI), 2) AS PCD_QTDITE ');
    qryGen.SQL.Add('FROM PCMDET D ');
    qryGen.SQL.Add('INNER JOIN PCMGER ON PCG_NUMPED = PCD_NUMPED ');
    qryGen.SQL.Add('  AND PCG_ESPDOC = PCD_ESPDOC ');
    qryGen.SQL.Add('  AND PCG_CODEMP = PCD_CODEMP ');
    qryGen.SQL.Add('WHERE PCG_BAIXAD = 0 ');
    qryGen.SQL.Add('  AND PCD_BAIXAD = 0 ');
    qryGen.SQL.Add('  AND PCD_ESPDOC = "PD" ');
    qryGen.SQL.Add('  AND PCD_NUMCTN = 0 ');
    qryGen.SQL.Add('  AND PCD_NUMCTN = 0 ');
    qryGen.SQL.Add('  AND PCG_NUMCTN = 0 ');
    qryGen.SQL.Add('  AND PCD_CODITE = :CODITE ');
    qryGen.SQL.Add('  AND IF(IFNULL(PCG_EMPDES, "") = "", PCD_CODEMP, PCG_EMPDES) = :CODEMP ');
    qryGen.ParamByName('CODITE').AsString := strCodIte;
    qryGen.ParamByName('CODEMP').AsString := strCodEmp;
    qryGen.Open;

    If Not qryGen.IsEmpty Then
      Result := qryGen.FieldByName('PCD_QTDITE').AsFloat;
  Finally
    FreeAndNil(qryGen);
  End;
end;

{*****************************************}
{* VERIFICA SE HÁ ESTOQUE SUFICIENTE     *}
{**************************************MV*}
function TFatVenda.fVerificaQtdEstoque(strEmpIte,
                                       strOpcDoc,
                                       strEntSai,
                                       strNumOrc,
                                       strAutInc,
                                       strCodIte,
                                       strCodAca,
                                       strEmpAca,
                                       strDesIte,
                                       strIteRet,
                                       strIteFut,
                                       strMotFut: String;
                                       fltQuantidade,
                                       fltQtdDig,
                                       fltQtdAnt,
                                       fltSaldoItemAtu: Double;
                                       blnAlterando: Boolean;
                                       Var strSemEst: String;
                                           blnComSen: Boolean;
                                       Var blnPedSen: Boolean;
                                       Var blnSemEst: Boolean;
                                           ForTin: TForTin;
                                           blnSoliTE: Boolean = FALSE;
                                           strNumLot: String = '';
                                           blnMosMsg: Boolean = True;
                                       strDescrCompleta : String = '';
                                       strEmpCar: String = '';
                                       strMotFutAConsiderar: String = '';
                                       EhDocumentoEmpresaPrioridade: Boolean = False): Boolean;
  Var
    fltFiltro: Double;
    fltGarant: Double;
    fltEstExt: Double;
    fltOrdPro: Double;
    fltBaiFut: Double;
    fltQtdPedCompraAberto : Double;
    fltDigita: Double;
    strMsgIte: String;
    strEmpSal: String;
    blnUsaEstExt: Boolean;
    blnIteEntFut: Boolean;
    intIndex: Integer;
    objMsg : TMensagemLiberacao;
    objTabela        : TRegistroMsgLiberaTabela;
    objLinha         : TLinhaMsgLibera;
    fltSaldoFisico: Double;
    fltSaldoEntFut: Double;
    blnProdutoEspecialAltoGiro: Boolean;
    fltQtdReqAbe: Double;
    strCodRcd,
    strEmpRcd: String;
    blnTravaReq: Boolean;
    blnSobEncomenda: Boolean;
    strComplMsgIte: String;

  function fRetNumLot(aStrNumLot, aStrEmpIte: String): String;
  begin
    Result := aStrNumLot;
    If fEhEmissaoDocumentoWMS Or fEmpresaParaFaturamentoUsaWMS(aStrEmpIte) Then
      Result := IIF(aStrNumLot = 'A DEFINIR', '', aStrNumLot);
  end;

  function fEmissaoPedido: Boolean;
  begin
    Result := (Pos(strOpcDoc, 'PD_') > 0) Or
              ((strOpcDoc = 'OR') And (strEspDoc = 'PD'));
  end;

  procedure pAddMsg(strMensagem : String);
  begin
    objMsg.pAddTexto(strMensagem);

    if not fEmptyStr(strMsgIte) then
      strMsgIte := strMsgIte + #13#10;

    strMsgIte := strMsgIte + strMensagem;
  end;

  procedure pAddComplMsg(strMensagem : String);
  begin
    If (Not fEmptyStr(strComplMsgIte)) Then
      strComplMsgIte := strComplMsgIte + #13#10;

    strComplMsgIte := strComplMsgIte + strMensagem;
  end;

  procedure pPreencheInformacoesComplementaresEstoqueItem;
  var
    fltTotalSaldoReservado : Double;
  begin
    strComplMsgIte := EmptyStr;

    If (fVerificaAcessoSistema('PVISPF')) Then
    begin
      If blnProdutoEspecialAltoGiro Then
        pAddComplMsg('Saldo Físico: '+FloatToStrF(fltSaldoFisico, ffNumber, 12, fCfgSis('DECQTD', varInteger)));

      fltTotalSaldoReservado := 0;
      If blnUsaEstExt Then
        fltTotalSaldoReservado := fltTotalSaldoReservado
                                + fltEstExt;

      If fReservaSaldoPedidosBaixaEntregaFutura Then
        fltTotalSaldoReservado := fltTotalSaldoReservado
                                + fltBaiFut;

      fltTotalSaldoReservado := fltTotalSaldoReservado
                              + fltFiltro
                              + fltGarant
                              + fltOrdPro;

      pAddComplMsg('Saldo Reservado Total: '+FloatToStrF(fltTotalSaldoReservado, ffNumber, 12, fCfgSis('DECQTD', varInteger)));
      pAddComplMsg('Saldo Disponível: '+FloatToStrF(fltSaldoDisponivelItem, ffNumber, 12, fCfgSis('DECQTD', varInteger)));
    End;
  end;
begin

  blnSemEst := False;
  blnPedSen := False;
  Result    := True;

  strEmpSal := fEmpresaSaldoMatriz_CD;

  If EhDocumentoEmpresaPrioridade Then
    strEmpSal := strEmpIte
  Else If blnEmpFat And Not fEmptyStr(strEmpIte) Then
    strEmpSal := strEmpIte
  Else If Not fEmptyStr(strEmpCar) Then
    strEmpSal := strEmpCar;

  blnUsaEstExt := fCfgSis('ESTEXT', varBoolean, strEmpSal);

  {*************************************************************}
  {* OPCOES EM NAO SE DEVE VERIFICAR A TRAVA DE ESTOQUE        *}
  {**********************************************************JC*}
  If (strIteFut = 'S') And (strMotFut = 'F') And (fCfgSis('ENTFUT', varBoolean)) Then
  Begin
    If (strIdePro <> 'NOR') Or (fCfgSis(fCfgTravaSaldoEntFut(strOpcDoc, 'F', Self.OperacaoOrigemFaturamento)) = 'N') Then
    Begin
      If (fltQuantidade <= 0.0) Then
        Result := False;
      Exit;
    End;
  End;

  {*************************************************************}
  {* OPCOES EM NAO SE DEVE VERIFICAR A TRAVA DE ESTOQUE        *}
  {**********************************************************JC*}
  If (Pos(strOpcDoc, 'OE_EF_NE_CE_') > 0) Or
     ((strOpcDoc = 'EP') And (strTipEmp = 'E')) Or
     ((strIdePro = 'NOR') And (Pos('ITEM ESPECIAL', strDesIte) > 0)) Or
     (fEhItemVendaVidro(strCodIte)) Or
     (strEntSai = 'E') Or
     (fltQuantidade <= 0.0) Then
  Begin
    If (fltQuantidade <= 0.0) Then
      Result := False;
    Exit;
  End;

  if (Pos(strOpcDoc, 'OF_OU_') > 0) and
     (SameText(fCfgSis('PROMAT', varString), strCodIte)) then
    Exit;

  blnIteEntFut := (strIteFut = 'S');

  fltDigita := fltQuantidade;

  If fCfgSis('ALTGIR', varBoolean) Then
    blnProdutoEspecialAltoGiro := ProdutoEspecialAltoGiro(strCodIte, strEmpSal)
  Else
    blnProdutoEspecialAltoGiro := False;

  If blnProdutoEspecialAltoGiro Then
  Begin
    fltSaldoFisico := fRetornaSaldoDisponivel(strCodIte,
                                              False,
                                              False,
                                              IIF(strNumLot = 'A DEFINIR', '', strNumLot),
                                              False,
                                              strEmpSal,
                                              '',
                                              False,
                                              False,
                                              True,
                                              (fUtilizaDefinicaoLoteSeparacaoSemWMS(strCodIte, strEmpSal, Self.strOpcDoc) And (strNumLot = 'A DEFINIR')));

    fltSaldoEntFut := TEntregaFutura.New(
                         TParamEF.New()
                           .CodIte(strCodIte)
                           .CodEmp(strEmpSal)
                           .Lote(IIF(strNumLot = 'A DEFINIR', '', strNumLot))
                           .Faturamento(True)
                         ).Total();
  End
  Else
  Begin
    fltSaldoFisico := fltSaldoItemAtu;
    fltSaldoEntFut := 0;
  End;

  If (blnExpedi) And (VS_strTipExp = '4') And (fCfgSis('EXPATE', varBoolean)) Then
    fltFiltro := fGetQtdSomaExpedidos(strCodIte, strEmpSal, strNumOrc)
  Else
    {****************************************}
    {* RETORNA O SALDO RESERVADO DE PEDIDOS *}
    {*************************************JC*}
    fltFiltro := TSaldoReservado.New(
                   TReservaParametros.New()
                     .EmpresaItem(IIF(blnEmpFat, strEmpIte, ''))
                     .CodigoItem(strCodIte)
                     .CodEmpresa(strEmpSal)
                     .CodItemAcabado(strCodAca)
                     .EmpItemAcabado(strEmpAca)
                     .NumeroLote(IIF(fEhEmissaoDocumentoWMS Or
                                     fEmpresaParaFaturamentoUsaWMS(strEmpIte),
                                     IIF(strNumLot = 'A DEFINIR', '', strNumLot), strNumLot))
                     .NumeroDocumento(strNumOrc)
                     .TipoFiltroDocumento(tfdIgnorarDocumento)
                     .TipoReserva(trsPedidoVenda)
                     .DesconsideraPedidosCorte(Not blnPedCorte)
                   ).fGetQuantidade();

    {*****************************************}
    {* RETORNA O SALDO RESERVADO DE GARANTIA *}
    {**************************************TS*}
    fltGarant := TSaldoReservado.New(
                   TReservaParametros.New()
                     .EmpresaItem(IIF(blnEmpFat, strEmpIte, ''))
                     .CodigoItem(strCodIte)
                     .CodEmpresa(strEmpSal)
                     .CodItemAcabado(strCodAca)
                     .EmpItemAcabado(strEmpAca)
                     .NumeroLote(IIF(fEhEmissaoDocumentoWMS Or
                                     fEmpresaParaFaturamentoUsaWMS(strEmpIte),
                                     IIF(strNumLot = 'A DEFINIR', '', strNumLot), strNumLot))
                     .NumeroDocumento(strNumOrc)
                     .TipoFiltroDocumento(tfdIgnorarDocumento)
                     .TipoReserva(trsGarantia)
                     .DesconsideraPedidosCorte(Not blnPedCorte)
                   ).fGetQuantidade();

    {*****************************************}
    {* RETORNA O SALDO RESERVADO EXTERNO     *}
    {**************************************TS*}
    fltEstExt := TSaldoReservado.New(
                   TReservaParametros.New()
                     .EmpresaItem(IIF(blnEmpFat, strEmpIte, ''))
                     .CodigoItem(strCodIte)
                     .CodEmpresa(strEmpSal)
                     .CodItemAcabado(strCodAca)
                     .EmpItemAcabado(strEmpAca)
                     .NumeroLote(IIF(fEhEmissaoDocumentoWMS Or
                                     fEmpresaParaFaturamentoUsaWMS(strEmpIte),
                                     IIF(strNumLot = 'A DEFINIR', '', strNumLot), strNumLot))
                     .NumeroDocumento(strNumOrc)
                     .TipoFiltroDocumento(tfdIgnorarDocumento)
                     .TipoReserva(trsExterno)
                     .DesconsideraPedidosCorte(Not blnPedCorte)
                   ).fGetQuantidade();

  If (fltEstExt < 0) Then
    fltEstExt := 0;

    {**************************************************}
    {* RETORNA O SALDO RESERVADO DE ORDEM DE PRODUCAO *}
    {***********************************************TS*}
    fltOrdPro := TSaldoReservado.New(
                   TReservaParametros.New()
                     .EmpresaItem(IIF(blnEmpFat, strEmpIte, ''))
                     .CodigoItem(strCodIte)
                     .CodEmpresa(strEmpSal)
                     .CodItemAcabado(strCodAca)
                     .EmpItemAcabado(strEmpAca)
                     .NumeroLote(IIF(fEhEmissaoDocumentoWMS Or
                                     fEmpresaParaFaturamentoUsaWMS(strEmpIte),
                                     IIF(strNumLot = 'A DEFINIR', '', strNumLot), strNumLot))
                     .NumeroDocumento(strNumOrc)
                     .TipoFiltroDocumento(tfdIgnorarDocumento)
                     .TipoReserva(trsOrdemProducao)
                     .DesconsideraPedidosCorte(Not blnPedCorte)
                   ).fGetQuantidade();

  fltBaiFut := 0;
  If (fEmpresaUsaEntregaFutura([VS_strCodEmp, strEmpIte, strEmpSal, strEmpAca])) Then
  Begin
    fltBaiFut := TSaldoReservado.New(
                   TReservaParametros.New()
                     .EmpresaItem(IIF(blnEmpFat, strEmpIte, ''))
                     .CodigoItem(strCodIte)
                     .CodEmpresa(strEmpSal)
                     .CodItemAcabado(strCodAca)
                     .EmpItemAcabado(strEmpAca)
                     .NumeroLote(IIF(fEhEmissaoDocumentoWMS Or
                                     fEmpresaParaFaturamentoUsaWMS(strEmpIte),
                                     IIF(strNumLot = 'A DEFINIR', '', strNumLot), strNumLot))
                     .NumeroDocumento(strNumOrc)
                     .TipoFiltroDocumento(tfdIgnorarDocumento)
                     .TipoReserva(trsPedidoBaixaEntregaFuturaReservSaldo)
                     .DesconsideraPedidosCorte(Not blnPedCorte)
                     .MotFutAConsiderar(strMotFutAConsiderar)
                   ).fGetQuantidade();
  End;
   
  {********************************************}
  {* CALCULA A QUANTIDADE DA TRAVA DE ESTOQUE *}
  {*****************************************JC*}
  If blnProdutoEspecialAltoGiro Then
    fltQuantidade := fltQuantidade + fltQtdDig
  Else
    fltQuantidade := fltQuantidade + fltQtdDig + fltFiltro + fltGarant + fltOrdPro + fltEstExt + fltBaiFut;

  strSemEst := 'N';

  {*****************************************}
  {* CASO ESTEJA ALTERANDO UM ITEM, NAO    *}
  {* CONSIDERA A QUANTIDADE JA CADASTRADA  *}
  {**************************************MV*}
  If blnAlterando Then
    fltQuantidade := fltQuantidade - fltQtdAnt;

  If (fPermitePassarItemSemEstoquePoisIraGerarVendasPerdidas(False)) And (Not blnVerificandoEstoqueLiberadoParaCorte) Then
  Begin
    If strIdePro = 'NOR' Then
      blnSemEst := (fFormataFloat(fltQuantidade, fCfgSis('DECQTD', VarInteger)) > fFormataFloat(fltSaldoFisico, fCfgSis('DECQTD', VarInteger)))
    Else
    Begin
      If (Assigned(ForTin.Formulas)) And (Not ForTin.Formulas.blnTemSaldo) Then
        blnSemEst := True;
    End;

    strSemEst := IIF(blnSemEst, 'S', 'N');

    Exit;
  End;

  fltQtdReqAbe := 0;

  if ((strOriF11 = 'S') or (strOpcDoc = 'CP')) and (strEspOrc = 'PD') and (not fEmptyStr(fRetornaOrdemServicoPedido(strNumOrc, strEmpOri))) then
  begin
    if (not TConEqu.VerificaPedidoComRequisicaoEmAbertoComPedidoDeCompra(strNumOrc, 'PD', strEmpOri, strCodRcd, strEmpRcd, blnTravaReq, False, strCodIte) and
      not TConEqu.VerificaPedidoComRequisicaoEmAbertoSemPedidoDeCompra(strNumOrc, 'PD', strEmpOri, strCodRcd, strEmpRcd, strCodIte)) then
      fltQtdReqAbe := fQtdeItemReqAberta(strCodIte, IIF(blnEmpFat, strEmpIte, VS_strCodEmp));
  end;

  {******************************}
  {* CASO FOR UM PRODUTO NORMAL *}
  {***************************JC*}
  objMsg := TMensagemLiberacao.Create(Self);
  try
    try
      If strIdePro = 'NOR' Then
      Begin
        fltSaldoDisponivelItem := (fltSaldoItemAtu - fltQtdDig - fltFiltro - fltGarant - fltOrdPro - fltEstExt - fltBaiFut);

        {******************************************************}
        {* CASO A QUANTIDADE FOR MAIOR QUE O SALDO DO PRODUTO *}
        {***************************************************JC*}
        If fFormataFloat(fltQuantidade, fCfgSis('DECQTD', VarInteger)) > fFormataFloat(fltSaldoFisico + fltQtdReqAbe, fCfgSis('DECQTD', VarInteger)) Then
        Begin
          blnSemEst := True;

          blnSobEncomenda := (fCampoTabela('ITE_SOBENC', 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [strCodIte, IIF(blnEmpFat, strEmpIte, VS_strCodEmp)]) = 'S');

          {******************************}
          {* MONTA A STRING DA MENSAGEM *}
          {***************************JC*}
          pAddMsg('Produto ' + strCodIte + '-' + strDesIte + ' não possui saldo suficiente!');

          if (blnSobEncomenda and blnExpedi) then
            pAddMsg('Produto "sob encomenda" que ainda não chegou na loja.');

          {******************************************}
          {* MOSTRA A MENSAGEM DE ORIENTAÇÃO QUANDO *}
          {* O ITEM TIVER SOMENTE SALDO EM GRAMAS.  *}
          {***************************************PZ*}
          If (VS_strUsaTmq = 'S') Then
          Begin
            If (fRetornaSaldoGramas(strCodIte, fEmpresaSaldoMatriz_CD) > 0) Then
              pAddMsg('Saldo apenas em gramas! Neste caso, utilize a rotina de venda de tinta de máquina(F8).');
          End;

          If (Not fEmptyStr(fRetNumLot(strNumLot, strEmpIte))) Then
            objMsg.pAddTextoCaption('Lote'                        , strNumLot                                                                        , 29);

          If Not fEmptyStr(strIteRet) then
            objMsg.pAddTextoCaption('Destino', strIteRet + IIF(strIteRet = 'E', IIF(strIteFut = 'S', '.F' + '.'+ strMotFut, '.I'), ''), 29);

          objMsg.pAddTextoCaption('Marca'                         , fRetNomMarcaItem(strCodIte)                                                      , 29);
          objMsg.pAddTextoCaption('Qtd. Digitada'                 , FloatToStrF(fltDigita, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);
          objMsg.pAddTextoCaption('Qtd. Inserida'                 , FloatToStrF(fltQtdDig, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);

          fltQtdPedCompraAberto := fRetornaQtdPedCompraAberto(strCodIte, Vs_strCodEmp);
          if (fVerificaAcessoSistema('PVISPF')) then
          begin
            If blnProdutoEspecialAltoGiro Then
            Begin
              objMsg.pAddTextoCaption('Saldo Físico'                , FloatToStrF(fltSaldoFisico, ffNumber, 12, fCfgSis('DECQTD', varInteger))         , 29);
              objMsg.pAddTextoCaption('Saldo Entrega Futura'        , FloatToStrF(fltSaldoEntFut, ffNumber, 12, fCfgSis('DECQTD', varInteger))         , 29);
            End;

            objMsg.pAddTextoCaption('Saldo Atual'                   , FloatToStrF(fltSaldoItemAtu, ffNumber, 12, fCfgSis('DECQTD', varInteger))        , 29);
            if blnUsaEstExt then
              objMsg.pAddTextoCaption('Saldo Reserv. Estoque Externo',FloatToStrF(fltEstExt, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);
            objMsg.pAddTextoCaption('Saldo Reserv. Pedido de Venda' , FloatToStrF(fltFiltro, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);
            objMsg.pAddTextoCaption('Saldo Reserv. Garantia'        , FloatToStrF(fltGarant, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);
            objMsg.pAddTextoCaption('Saldo Reserv. Ord. Produção'   , FloatToStrF(fltOrdPro, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);
            If fReservaSaldoPedidosBaixaEntregaFutura Then
              objMsg.pAddTextoCaption('Saldo Reserv. Ped.Bai.Ent.Fut.', FloatToStrF(fltBaiFut, ffNumber, 12, fCfgSis('DECQTD', varInteger))              , 29);
            objMsg.pAddTextoCaption('Saldo Disponível'              , FloatToStrF(fltSaldoDisponivelItem, ffNumber, 12, fCfgSis('DECQTD', varInteger)) , 29);
            objMsg.pAddTextoCaption('Qtd. Pedido de Compra em Aberto', FloatToStrF(fltQtdPedCompraAberto, ffNumber, 12, fCfgSis('DECQTD', varInteger)) , 29);
          end
          else
          begin
            If blnProdutoEspecialAltoGiro Then
            Begin
              objMsg.pAddTextoCaption('Saldo Físico'                , '@('+FloatToStrF(fltSaldoFisico, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'         , 29);
              objMsg.pAddTextoCaption('Saldo Entrega Futura'        , '@('+FloatToStrF(fltSaldoEntFut, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'         , 29);
            End;

            objMsg.pAddTextoCaption('Saldo Atual'                   , '@('+FloatToStrF(fltSaldoItemAtu, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'        , 29);
            if blnUsaEstExt then
              objMsg.pAddTextoCaption('Saldo Reserv. Estoque Externo','@('+FloatToStrF(fltEstExt, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'              , 29);
            objMsg.pAddTextoCaption('Saldo Reserv. Pedido de Venda' , '@('+FloatToStrF(fltFiltro, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'              , 29);
            objMsg.pAddTextoCaption('Saldo Reserv. Garantia'        , '@('+FloatToStrF(fltGarant, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'              , 29);
            objMsg.pAddTextoCaption('Saldo Reserv. Ord. Produção'   , '@('+FloatToStrF(fltOrdPro, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'              , 29);
            If fReservaSaldoPedidosBaixaEntregaFutura Then
              objMsg.pAddTextoCaption('Saldo Reserv. Ped.Bai.Ent.Fut.', '@('+FloatToStrF(fltBaiFut, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@'              , 29);
            objMsg.pAddTextoCaption('Saldo Disponível'              , '@('+FloatToStrF(fltSaldoDisponivelItem, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@' , 29);
            objMsg.pAddTextoCaption('Qtd. Pedido de Compra em Aberto' , '@('+FloatToStrF(fltQtdPedCompraAberto, ffNumber, 12, fCfgSis('DECQTD', varInteger))+')@' , 29);
          end;

          objMsg.pAddTextoCaption('Empresa'                       , strEmpSal +' - '+Copy(fRetNomeEmpresaSelec(strEmpSal),1,50)                      , 29);

          {*************************************************************}
          {* CASO NAO FOR PEDIDO NEM ORCAMENTO VERIFICA A TRAVA DE     *}
          {* ESTOQUE PARA VENDA (SE TRAVA OU SOMENTE AVISA)            *}
          {**********************************************************JC*}
          If (Pos(fTravaSaldoVN(blnExpedi, strIteFut = 'S', strMotFut, strOriF11, Self.OperacaoOrigemFaturamento), 'AT') > 0) And (Pos(strOpcDoc, 'OR_PD_') <= 0) Then
          Begin
            strSemEst := 'S';

            {*****************************************************************}
            {* CASO NA VENDA NORMAL, SEM ESTOQUE, PERMITIR SOMENTE ORCAMENTO *}
            {**************************************************************JC*}
            If (fCfgSis('VSEORC', varBoolean) And (strOpcDoc = 'VN')) And (Pos(strOpcDoc, 'BR_') <= 0) And (Not blnExpedi) And (strOriF11 <> 'S') Then
            Begin
              pAddMsg('Será permitido apenas fechamento em Orçamento!');
            End;

            {*************************************************************}
            {* CASO ESTEJA CONFIGURADO PARA TRAVAR E A VARIAVEL QUE      *}
            {* QUE VERIFICA SE PEDE SENHA ESTEJA VERDADEIRA, ENTAO SOLI- *}
            {* CITA SENHA DE LIBERACAO PARA VENDA NORMAL...              *}
            {**********************************************************JC*}
            If (fTravaSaldoVN(blnExpedi, strIteFut = 'S', strMotFut, strOriF11, Self.OperacaoOrigemFaturamento) = 'T') And ( (Not (fCfgSis('VSEORC', varBoolean) And (strOpcDoc = 'VN')) Or (blnBaiEntFut) Or (Pos(strOpcDoc, 'BR_') > 0) Or (blnExpedi) Or (strOriF11 = 'S')) ) Then
            Begin
              blnPedSen := TRUE;

              If blnComSen And (Not fSenhaLiberacaoSemSaldoVN(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg, strCodIte + '-' + strDesIte,
                                                              TRUE, strOpcDoc, blnSoliTE, blnExpedi, IIF(Self.OperacaoOrigemFaturamento = ofBaixaDeEntregaFutura, strMotFut, ''), IIF(Self.OperacaoOrigemFaturamento = ofBaixaDeEntregaFutura, fCfgSis('ENTFUT', varBoolean), False), blnBaiEntFut,
                                                              blnEnt_CD, strCodCli + '-' + strCliNom, strCodIte, strOriF11, FSequencialUnicoDtaHrLogVar, fExibeMensagemTransferenciaEstoqueItemAItem)) Then
              Begin
                Result := False;
                Exit;
              End;

            End
            {*************************************************************}
            {* CASO ESTEJA CONFIGURADO PARA AVISAR E A VARIAVEL QUE      *}
            {* QUE VERIFICA SE EXIBE MENSAGEM ESTEJA VERDADEIRA          *}
            {**********************************************************JC*}
            Else If blnMosMsg Then
              pMostraMensagem('', strMsgIte, strCodIte);

          End
          {*************************************************************}
          {* CASO FOR PEDIDO OU ORCAMENTO VERIFICA SE TRAVA OU AVISA   *}
          {**********************************************************JC*}
          Else If ((Pos(fCfgSis(IIF(blnIteEntFut, fCfgTravaSaldoEntFut('OR', strMotFut), 'SLD_OP')), 'AT') > 0) And (Pos(strOpcDoc, 'OR_') > 0)) Or
                  ((Pos(fCfgSis(IIF(blnIteEntFut, fCfgTravaSaldoEntFut('PD', strMotFut), 'SLDPED')), 'AT') > 0) And fEmissaoPedido) Then
          Begin
            strSemEst := 'S';

            {**********************}
            {* CASO FOR ORCAMENTO *}
            {*******************JC*}
            If (strOpcDoc = 'OR') And (strEspDoc <> 'PD') Then
            Begin

              {*************************************************************}
              {* CASO ESTEJA CONFIGURADO PARA TRAVAR E A VARIAVEL QUE      *}
              {* QUE VERIFICA SE PEDE SENHA ESTEJA VERDADEIRA, ENTAO SOLI- *}
              {* CITA SENHA DE LIBERACAO PARA ORCAMENTO...                 *}
              {**********************************************************JC*}
              If (fCfgSis(IIF(blnIteEntFut, fCfgTravaSaldoEntFut('OR', strMotFut), 'SLD_OP')) = 'T') Then
              Begin
                blnPedSen := TRUE;

                If blnComSen And (Not fSenhaLiberacaoSemSaldoOP(strCodVen,
                                                                strCodDig,
                                                                strNtrava,
                                                                stlNumLib,
                                                                objMsg,
                                                                True,
                                                                strCodCli + '-' + strCliNom,
                                                                strCodIte,
                                                                FSequencialUnicoDtaHrLogVar,
                                                                fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpSal),
                                                                IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpSal), strEmpSal, EmptyStr),
                                                                pMostraMensagem)) Then
                Begin
                  Result := False;
                  Exit;
                End;

              End
              {*************************************************************}
              {* CASO ESTEJA CONFIGURADO PARA AVISAR E A VARIAVEL QUE      *}
              {* QUE VERIFICA SE EXIBE MENSAGEM ESTEJA VERDADEIRA          *}
              {**********************************************************JC*}
              Else If blnMosMsg Then
              Begin
                pPreencheInformacoesComplementaresEstoqueItem;
                If (Not fEmptyStr(strComplMsgIte)) Then
                  strComplMsgIte := strMsgIte + #13#10
                                  + strComplMsgIte
                Else
                  strComplMsgIte := strMsgIte;

                pMostraMensagem('', strComplMsgIte, strCodIte);
              End;
            End
            Else
            {**********************}
            {* CASO FOR PEDIDO    *}
            {*******************JC*}
            Begin
              {*****************************************************************}
              {* CASO NA VENDA NORMAL, SEM ESTOQUE, PERMITIR SOMENTE ORCAMENTO *}
              {**************************************************************JC*}
              If (fCfgSis('VSEORC', varBoolean) And (strOpcDoc = 'VN')) Then
              Begin
                pAddMsg('Será permitido apenas fechamento em Orçamento!');
              End;

              {*************************************************************}
              {* CASO ESTEJA CONFIGURADO PARA TRAVAR E A VARIAVEL QUE      *}
              {* QUE VERIFICA SE PEDE SENHA ESTEJA VERDADEIRA, ENTAO SOLI- *}
              {* CITA SENHA DE LIBERACAO PARA PEDIDO...                    *}
              {**********************************************************JC*}
              If (fCfgSis(IIF(blnIteEntFut, fCfgTravaSaldoEntFut('PD', strMotFut), 'SLDPED')) = 'T') Then
              Begin
                blnPedSen := TRUE;

                If blnComSen And (Not fSenhaLiberacaoSemSaldoPE(strCodVen,
                                                                strCodDig,
                                                                strNtrava,
                                                                stlNumLib,
                                                                objMsg,
                                                                True,
                                                                'PD',
                                                                blnSoliTE,
                                                                True,
                                                                blnEnt_CD,
                                                                strCodCli + '-' + strCliNom,
                                                                strCodIte,
                                                                FSequencialUnicoDtaHrLogVar,
                                                                fExibeMensagemTransferenciaEstoqueItemAItem,
                                                                fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpSal),
                                                                IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpSal), strEmpSal, EmptyStr),
                                                                pMostraMensagem,
                                                                fInformouEmpresaTEParaClienteFilial)) Then
                Begin
                  Result := False;
                  Exit;
                End;
              End
              {*************************************************************}
              {* CASO ESTEJA CONFIGURADO PARA AVISAR E A VARIAVEL QUE      *}
              {* QUE VERIFICA SE EXIBE MENSAGEM ESTEJA VERDADEIRA          *}
              {**********************************************************JC*}
              Else If blnMosMsg Then
                pMostraMensagem('', strMsgIte, strCodIte);
            End;

          End;

        End
      End
      {******************************}
      {* CASO FOR TINTA DE MAQUINA  *}
      {***************************JC*}
      Else
      Begin
        If (Assigned(ForTin.Formulas)) Then
        Begin
          {**************************************************}
          {* CASO POSSUA COLORANTES SEM SALDO NA FORMULACAO *}
          {***********************************************JC*}
          If Not fVerificaEstoqueTintaDeMaquina(ForTin.Formulas, strAutInc) Then
          Begin
            strSemEst := 'S';

            {********************************************************************}
            {* CASO ESTEJA CONFIGURADO PARA TRAVAR OU AVISAR SALDO DE COLORANTE *}
            {*****************************************************************JC*}
            If fCfgSis(IIF(blnIteEntFut, 'COLF', 'COL_') + IfThen(Pos(strOpcDoc, '_OR_PD_') > 0, strOpcDoc, 'VN')) <> 'N' Then
            Begin

              {*******************************************************************}
              {* EXIBE COLORANTES/EMBALAGENS DA FORMULACAO QUE ESTEJAM SEM SALDO *}
              {****************************************************************JC*}
              If Not blnSoliTE Then
                fVisualizarSaldoTintas(ForTin.Formulas, strDescrCompleta );

              objTabela := TRegistroMsgLiberaTabela.Create;

              objLinha := TLinhaMsgLibera.Create;
              objLinha.enuTipoLinha := tlCabecalho;
              objLinha.pAddColuna('', 'PRODUTO' , 50, alEsquerda , teAutcom);
              objLinha.pAddColuna('', 'SALDO'   , 10, alCentro   , teAutcom);
              objLinha.pAddColuna('', 'QTD.SOL.', 10, alCentro   , teAutcom);
              objTabela.lstLinhas.Add(objLinha);

              For intIndex := 0 To ForTin.Formulas.Count -1 Do
              Begin
                If (ForTin.Formulas[intIndex].fltSaldoML >= ForTin.Formulas[intIndex].fltQtdFormAcu) Then
                  Continue;

                objLinha := TLinhaMsgLibera.Create;
                objLinha.enuTipoLinha := tlValor;
                objLinha.pAddColuna('PRODUTO'  , ForTin.Formulas[intIndex].strCodIte +'-'+ ForTin.Formulas[intIndex].strDesIte , 50, alEsquerda , teAmbos);
                objLinha.pAddColuna('SALDO'    , FormatFloat('#,##0.00', ForTin.Formulas[intIndex].fltSaldoML)                 , 10, alDireita  , teAmbos);
                objLinha.pAddColuna('QTD.SOL.' , FormatFloat('#,##0.00', ForTin.Formulas[intIndex].fltQtdFormAcu)              , 10, alDireita  , teAmbos);
                objTabela.lstLinhas.Add(objLinha);
              End;

              objMsg.lstRegistros.Add(objTabela);

              {********************************}
              {* CASO CONFIGURADO PARA TRAVAR *}
              {*****************************JC*}
              If fCfgSis(IIF(blnIteEntFut, 'COLF', 'COL_') + IfThen(Pos(strOpcDoc, '_OR_PD_') > 0, strOpcDoc, 'VN')) = 'T' Then
              Begin
                blnPedSen := TRUE;

                {*************************************}
                {* SOLICITA LIBERACAO PARA ORCAMENTO *}
                {**********************************JC*}
                If blnComSen And (strOpcDoc = 'OR') Then
                  Result := fSenhaLiberacaoTintaSemSaldoOP(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg, True, blnExpedi, strOriF11, strCodCli + '-' + strCliNom, strCodIte, FSequencialUnicoDtaHrLogVar)

                {*************************************}
                {* SOLICITA LIBERACAO PARA PEDIDO    *}
                {**********************************JC*}
                Else If blnComSen And (strOpcDoc = 'PD') Then
                  Result := fSenhaLiberacaoTintaSemSaldoPE(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg, strOpcDoc, blnSolIte, blnEnt_CD, True, blnExpedi, strOriF11, strCodCli + '-' + strCliNom, strCodIte, FSequencialUnicoDtaHrLogVar, fExibeMensagemTransferenciaEstoqueItemAItem, Self.strOprFlj = 'S')

                {*************************************}
                {* SOLICITA LIBERACAO PARA VENDA     *}
                {**********************************JC*}
                Else If blnComSen {And (strOpcDoc = 'VN')} Then
                  Result := fSenhaLiberacaoTintaSemSaldoVN(strCodVen, strCodDig, strNtrava, stlNumLib, objMsg,'', TRUE, strOpcDoc, blnSoliTE, blnExpedi, strOriF11, strCodCli + '-' + strCliNom, strCodIte, FSequencialUnicoDtaHrLogVar);

              End;

            End;

          End;

        End;

      End;
    except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fVerificaQtdEstoque]');
      End;
    end;
  finally
    FreeAndNil(objMsg);
  end;

end;

function TFatVenda.fVerificaQtdEstoqueSubItensEstrutura(strOpcao,
                                                        strIteEst,
                                                        strAutInc: String;
                                                        fltQtdIte: Double;
                                                        blnComSenha: Boolean;
                                                        objMsgSubItensSemEst: TMensagemLiberacao;
                                                        Var blnPediuSenha: Boolean;
                                                        blnVerQtdDig: Boolean = True;
                                                        strEmpIte: String = '';
                                                        strIteRet: String = '';
                                                        strIteFut: String = '';
                                                        strMotFut: String = '';
                                                        blnAltEstOri: Boolean = False;
                                                        intSeqPer: Integer = -1): Boolean;
  Var
    objItensEstrutura: TItensEstrutura;
    subItem: TSubItemEstrutura;
    intItem: Integer;
    fltQtdDigitada,
    fltSaldoReservado,
    fltSalDisponivelSubItem: Double;
    objMsg : TMensagemLiberacao;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha : TLinhaMsgLibera;

begin
  objItensEstrutura := TItensEstrutura.Create;
  objMsg := TMensagemLiberacao.Create(Self);

  If (strEmpIte.IsEmpty) Then
    strEmpIte := VS_strCodEmp;

  objItensEstrutura.pCarregarEstrutura(strIteEst, fltQtdIte, IIF(blnEmpFat, strEmpIte, VS_strCodEmp), strIteRet = 'E');


  If (blnAltEstOri) And (intSeqPer > -1) Then
  Begin
    objItensEstrutura.pCarregaItensEstruturaPersonalizada(Self.strTabTmpDETPER,
                                                          intSeqPer,
                                                          strIteEst,
                                                          fltQtdIte,
                                                          IIF(blnEmpFat, strEmpIte, VS_strCodEmp),
                                                          (strIteRet = 'E'));
  End;

  blnPediuSenha     := False;
  fltQtdDigitada    := 0.0;

  Result := objItensEstrutura.ItemsCount > 0;

  If Result Then
  Begin
    objTabela := TRegistroMsgLiberaTabela.Create;

    For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
    Begin
      subItem := objItensEstrutura[intItem];

      If (blnVerQtdDig) Then
      Begin
        fltQtdDigitada := fRetQtdDigitada(subItem.strCodigo,
                                          '',
                                          strAutInc,
                                          '',
                                          '',
                                          VS_strCodEmp,
                                          True,
                                          False,
                                          False,
                                          False,
                                          False,
                                          strOpcao);
      End;

      {***************************************************}
      {* RETORNA O SALDO RESERVADO DO SUB-ITEM ESTRUTURA *}
      {************************************************JC*}
      fltSaldoReservado := TSaldoReservado.New(
                               TReservaParametros.New()
                                 .EmpresaItem(IIF(blnEmpFat, strEmpIte, VS_strCodEmp))
                                 .CodigoItem(subItem.strCodigo)
                                 .CodEmpresa(IIF(Not subItem.strEmpCar.IsEmpty, subItem.strEmpCar, VS_strCodEmp))
                                 .NumeroDocumento(strNumOrc)
                                 .TipoFiltroDocumento(tfdIgnorarDocumento)
                                 .DesconsideraPedidosCorte(Not blnPedCorte)
                             ).fGetQuantidade();

      fltSalDisponivelSubItem := ( subItem.fltSaldos -
                                   fltQtdDigitada -
                                   fltSaldoReservado );

      If subItem.fltQtdTot > fltSalDisponivelSubItem Then
      Begin
        If objTabela.isEmpty then
        Begin
          objMsg.pAddTexto('********* Sub.Produtos não possuem estoque disponível *********');

          objLinha := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'Código'      , 7 , alCentro  , teAutcom);
          objLinha.pAddColuna('', 'Descrição'   , 29, alEsquerda, teAutcom);
          If Not fEmptyStr(strIteRet) Then
          Begin
            objLinha.pAddColuna('', 'Ent'         , 3, alCentro, teAutcom);
            objLinha.pAddColuna('', 'Mot'         , 3, alCentro, teAutcom);
          End;
          objLinha.pAddColuna('', 'Marca'       , 15, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Quantidade'  , 12, alCentro  , teAutcom);
          objLinha.pAddColuna('', 'Emp'         , 3 , alCentro  , teAutcom);
          objLinha.pAddColuna('', 'Saldos Disp.', 12, alCentro  , teAutcom);
          objTabela.lstLinhas.Add(objLinha);
        End;

        objLinha := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.pAddColuna('Código'      , subItem.strCodigo                                , 7 , alCentro  , teAmbos);
        objLinha.pAddColuna('Descrição'   , fRetNomProduto(subItem.strCodigo)                , 29, alEsquerda, teAmbos);
        If Not fEmptyStr(strIteRet) Then
        Begin
          objLinha.pAddColuna('Ent', strIteRet + IIF(strIteRet = 'E', IIF(strIteFut = 'S', '.F', '.I'), ''), 3, alCentro, teAmbos);
          objLinha.pAddColuna('Mot', strMotFut                                                             , 3, alCentro, teAmbos);
        End;
        objLinha.pAddColuna('Marca'       , fRetNomMarcaItem(subItem.strCodigo)              , 15, alEsquerda, teAmbos);
        objLinha.pAddColuna('Quantidade'  , FormatFloat('#,##0.00', subItem.fltQtdTot)       , 12, alDireita , teAmbos);
        objLinha.pAddColuna('Emp'         , IIF(Not subItem.strEmpCar.IsEmpty, subItem.strEmpCar, IIF(blnEmpFat, strEmpIte, VS_strCodEmp)), 3, alCentro, teAmbos);
        objLinha.pAddColuna('Saldos Disp.', FormatFloat('#,##0.00', fltSalDisponivelSubItem) , 12, alDireita , teAmbos);
        objTabela.lstLinhas.Add(objLinha);
      End;

    End;

    if not objTabela.isEmpty then
      objMsg.lstRegistros.Add(objTabela)
    else
      FreeAndNil(objTabela);

    if not objMsg.isEmpty then
    Begin
      if Assigned(objMsgSubItensSemEst) then
        objMsgSubItensSemEst.fGetObjectFromJson(objMsg.fGetJsonObject.ToJSON);

      if fCfgSis('SENFVU') = 'F' then
        objMsg.Clear;

      If Not blnComSenha Then
      Begin
        Result := False;
      End

      Else If (Pos(strOpcao, 'OR_PD_') > 0) Then
      Begin

        If (strOpcao = 'OR') And (fCfgSis('SLD_OP') = 'T') Then
        Begin
          blnPediuSenha := True;
          objMsg.pInsertTexto(0,'Liberação de produto(s) sem saldo - Orçamento!');
          Result := fSenhaLiberacaoSemSaldoOP(strCodVen,
                                              strCodDig,
                                              strNtrava,
                                              stlNumLib,
                                              objMsg,
                                              True,
                                              strCodCli + '-' + strCliNom,
                                              '',
                                              FSequencialUnicoDtaHrLogVar,
                                              fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpIte),
                                              IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpIte), strEmpIte, EmptyStr),
                                              pMostraMensagem);
        End

        Else If (strOpcao = 'PD') And (fCfgSis('SLDPED') = 'T') Then
        Begin
          blnPediuSenha := True;
          objMsg.pInsertTexto(0,'Liberação de produto(s) sem saldo - Pedido!');
          Result := fSenhaLiberacaoSemSaldoPE(strCodVen,
                                              strCodDig,
                                              strNtrava,
                                              stlNumLib,
                                              objMsg,
                                              True,
                                              strOpcao,
                                              False,
                                              True,
                                              blnEnt_CD,
                                              strCodCli + '-' + strCliNom,
                                              '',
                                              FSequencialUnicoDtaHrLogVar,
                                              fExibeMensagemTransferenciaEstoqueItemAItem,
                                              fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpIte),
                                              IIF(fTravaEstoqueItemAItemOperacaoMultiLoja(strEmpIte), strEmpIte, EmptyStr),
                                              pMostraMensagem);

        End;

      End
      Else If (fTravaSaldoVN(blnExpedi,False,'',strOriF11) = 'T') Then
      Begin

        If (Not (fCfgSis('VSEORC', varBoolean) And (strOpcao = 'VN'))) Or (fVendaMultiLoja) Or (blnExpedi) Or (strOriF11 = 'S') Then
        Begin
          objMsg.pInsertTexto(0, 'Liberação de produto(s) sem saldo - '+IIF(strOriF11='S','Resumo de Caixa!', 'Venda Normal!'));
          blnPediuSenha := True;

          Result := fSenhaLiberacaoSemSaldoVN(strCodVen, strCodDig, strNtrava, stlNumLib,
            objMsg, '', True, strOpcao, False, blnExpedi, '', False, blnBaiEntFut, blnEnt_CD, strCodCli + '-' + strCliNom, '', strOriF11, FSequencialUnicoDtaHrLogVar, fExibeMensagemTransferenciaEstoqueItemAItem);
        End;

      End;
    End;

  End
  Else
    pMensagemOk('Não foram encontrados sub. produtos para a estrutura informada!');

  objItensEstrutura.Destroy;
  if Assigned(objMsg) then
    FreeAndNil(objMsg);
end;

function TFatVenda.fVerificaQtdMaxParcelas(strConPag,
  strEspPra: String): Boolean;
  Var
    objLiberacao: TLiberacao;
    intQtdMax   : Integer;
begin
  Result := True;

  If fEmptyStr(strEspPra) Then
  Begin
    If (strOpcDoc = 'OR') And (strEspDoc = 'PD') Then
      strEspPra := 'PD'
    Else
      strEspPra := strOpcDoc;
  End;

  If fDocumentoParaFornecedor Then
    Exit;

  If SameText(strEspPra,'PD') And (Not fCfgSis('PRAMPD', varBoolean)) Then
    Exit;

  If SameText(strEspPra,'OR') And (Not fCfgSis('PRAMOR', varBoolean)) Then
    Exit;

  If SameText(strEspPra,'VN') And (Not fCfgSis('PRAMVN', varBoolean)) Then
    Exit;

  If SameText(strEspPra,'CS') And (Not fCfgSis('PRAMVN', varBoolean)) Then
    Exit;

  intQtdMax := fCampoTabela('CND_QTDMAX', 'CADCND', ['CND_CODIGO'], [strCodCnd], False);

  If (Not fCfgSis('USACND', varBoolean)) Or (intQtdMax = 0) Then
    Exit;

  pRemoverTravaLogAvi('LBQTMX', strNTrava);

  If (StrToIntDef(Copy(strConPag, 1, 2), 0) > intQtdMax) Then
  Begin
    objLiberacao := TLiberacao.Create;

    Try
      pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);

      If fEmptyStr(fCfgSis('SENQMX')) Then
        Exit
      Else
      Begin
        objLiberacao.objMsgLibera.pAddTexto('Número de parcelas superior à quantidade máxima permitida.');
        objLiberacao.objMsgLibera.pAddTexto('----------------------------------------------------------');
        objLiberacao.objMsgLibera.pAddTextoCaption('Cliente', strCodCli + '-' + strCliNom, 15);
        objLiberacao.objMsgLibera.pAddTexto('----------------------------------------------------------');
        objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto', strCodCnd + '-' + fRetDesConPag(strCodCnd), 15);
        objLiberacao.objMsgLibera.pAddTexto(fPadL('', 17) + fFormataCondPag(strConPag));
        objLiberacao.objMsgLibera.pAddTexto('----------------------------------------------------------');
        objLiberacao.objMsgLibera.pAddTextoCaption('Máx. Parcelas', IntToStr(intQtdMax), 15);

        objLiberacao.strDirAce := 'LBQTMX';
        objLiberacao.strSenLib := fCfgSis('SENQMX');
        objLiberacao.strMsgSen := 'Quantidade Máxima de Parcelas';
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCpfCnpj := strCliCgc;

        If (Not fFatMensagemLiberacao(objLiberacao))Then
          Result := False
        Else
        Begin
          Result := True;
          If Not fSomenteAvisaPoisVaiTravarNoFinalVenda('LBQTMX') Then
            blnVerMaxPar := True;
        End;
      End;
    Finally
      FreeAndNil(objLiberacao);
    End;
  End;
end;

procedure TFatVenda.pSalvarDuplicCarrPedido(arrDupl: TarrDuplicata);
  Var
    intCnt : Integer;
begin
  arrValDuplicCarrPedido := Nil;

  For intCnt := 0 To Length(arrDupl)-1 Do
