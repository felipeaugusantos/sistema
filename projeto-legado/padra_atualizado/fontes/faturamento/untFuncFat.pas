function TFatVenda.fPedeEnderecoEntrega: Boolean;
  Var
    strIncEndEntAnt: String;

  function frecEndereComCodCliDifDoFat: Boolean;
  begin
    Result := (Not fEmptyStr(Self.objEndEnt.recEndere.strCodCli)) And
              (Not fEmptyStr(Self.strCodCli)) And
              (Self.objEndEnt.recEndere.strCodCli <> Self.strCodCli);
  end;

begin
  Result := True;

  If (Self.blnDecidiuEndereco) Then
    Exit;

  If Self.blnUsaEndEntregaServicosPedidoOrcamento Then
    Exit;

  If (Not Self.fTemItensEntrega)           And
     (Not Self.fSalvaEnderecoEntrega('N')) And
     (Not (Self.blnPedeEndEntregaServicos And Self.blnDocumentoTemServicos)) And
     (Not fEmptyStr(Self.objEndEnt.recEndere.strIncrem)) And
     (Not Self.fImprimeEndEntregaItensRetira) Then
  Begin
    Self.pLimparEnderecoEntrega;
  End
  Else
  Begin
    strIncEndEntAnt := Self.objEndEnt.recEndere.strIncrem;

    If (Not fClienteConsumidor(Self.strCliOri, False, True)) And
       (fPermiteEnderecoEntrega) And ((strOpcDoc <> 'PR') And (strOpcDoc <> 'DV')) Then
    Begin
      If ((Pos(strOpcDoc, 'PD_OR_') > 0) Or ((strOpcDoc = 'VN') And frecEndereComCodCliDifDoFat)) And
         (Not fEmptyStr(Self.objEndEnt.recEndere.strIncrem)) And
         (Self.fPossuiSoEnderecoPadrao) Then
      Begin
        Self.pLimparEnderecoEntrega;
        strIncEndEntAnt := '';
      End;

      If fEmptyStr(strIncEndEntAnt) Then
        Result := Self.fSelecionaEnderecoEntrega
      Else
        Result := Self.fAlteraEnderecoEntrega(False, (Pos(strOpcDoc, 'PD_OR_VN_') > 0));
    End;

    If (Result) And
       (strIncEndEntAnt <> Self.objEndEnt.recEndere.strIncrem) And
       (Not fEmptyStr(Self.objEndEnt.recEndere.strCodTra)) Then
    Begin
      Self.strCodTra := Self.objEndEnt.recEndere.strCodTra;
    End;

  End;

  Self.blnPediuEnderecoEntrega := Result;
end;

