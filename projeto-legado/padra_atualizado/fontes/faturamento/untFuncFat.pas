                                 '',
                                 strTipFor,
                                 strCodCnd,
                                 blnConApr,
                                 strCodCta,
                                 0,
                                 FieldByName('FIN_VALTAX').AsFloat,
                                 '',
                                 '',
                                 '',
                                 '',
                                 0,
                                 0,
                                 FieldByName('FIN_VALTAX').AsFloat,
                                 0,
                                 VS_strCodEmp,
                                 strEmpRec, // Empresa de Origem
                                 strNumDoc, // strDocDiv
                                 strEspDoc, // strEspDiv
                                 VS_strCodEmp, // strEmpDiv
                                 strCodCli, // strCliDiv
                                 0,
                                 0,
                                 strCodRep,
                                 0,
                                 0,
                                 '',
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0);
        End; {If FieldByName('FIN_VALTAX').AsFloat <> 0 Then}

        If Not Result Then
          Break;

        If FieldByName('FIN_TIPRET').AsString = 'D' Then
        Begin
          strHisCtr := 'REF. DOCUMENTO ' + strNumDoc + '-' + strEspDoc;

          strNumFin := fRetSequencial('PRO_FI', VS_strCodEmp, fTamDocCadRec);

          Result := fGravaCadRec(strNomeForm,
