procedure TFatVenda.pMostraMargemComFrete;
  Var
    frmMosMar : TfrmFatMostraMargemNovo;
    objLiberacao  : TLiberacao;
    blnSomaFreteSugestaoAoCusto,
    blnSomaFreteCobradoAoUnitario,
    blnSomaFreteHabilitaCheckBox: Boolean;

    procedure pPreparaApresentacao;
    begin
      blnSomaFreteHabilitaCheckBox  := IIF((fCfgSis('MARFRE') = '0'), True, False);
      blnSomaFreteCobradoAoUnitario := IIF((fCfgSis('MARFRE') = '1'), True, False);
      blnSomaFreteSugestaoAoCusto   := IIF((fCfgSis('MARFRE') = '2'), True, False);
    end;
begin
  {*****************************************}
  {* TRATAMENTO DE SENHA FIXA, VARIAVEL OU *}
  {* POR USUÁRIO                           *}
  {**************************************WI*}
  If (Not fEmptyStr(fCfgSis('SENMAR'))) Then
  Begin

    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('Visualizar Margem de Lucro');

      objLiberacao.strDirAce := 'MRGLU';
      objLiberacao.strSenLib := fCfgSis('SENMAR');
      objLiberacao.strMsgSen := 'Margem de Lucro';
      objLiberacao.strCodOpe := strCodVen;
      objLiberacao.strCodDig := strCodDig;
      objLiberacao.strCliente := strCodCli + '-' + strCliNom;
      objLiberacao.strCpfCnpj := strCliCgc;

      if not (fFatMensagemLiberacao(objLiberacao)) then
        Exit;
    finally
      FreeAndNil(objLiberacao);
    end;
  End;

  frmMosMar := TfrmFatMostraMargemNovo.Create(Nil,
                                              Self,
                                              Nil,
                                              strCodVen,
                                              False,
                                              0,
                                              True,
                                              False,
                                              Nil,
                                              Nil,
                                              0
                                             );

  Try
    pPreparaApresentacao;
    frmMosMar.pCalculaMargemLucro := pCalcularMargemLucroComFrete;
    frmMosMar.pCalculaMargemLucro(blnSomaFreteSugestaoAoCusto, blnSomaFreteCobradoAoUnitario, frmMosMar.cdsItens);

    frmMosMar.chkAcuFreteSugPrecoCus.Checked := blnSomaFreteSugestaoAoCusto;
    frmMosMar.chkAcuFreteCobPrecoUni.Checked := blnSomaFreteCobradoAoUnitario;

    frmMosMar.chkAcuFreteSugPrecoCus.Enabled := blnSomaFreteHabilitaCheckBox;
    frmMosMar.chkAcuFreteCobPrecoUni.Enabled := blnSomaFreteHabilitaCheckBox;

    frmMosMar.ShowModal;
  Except
    On E: Exception Do
    Begin
      cdsVenda.EnableControls;
      pMensagensErro(E.Message, '[pMostraMargemComFrete]');
    End;
  End;

  pFreeAndNil(frmMosMar);
end;

procedure TFatVenda.pCalcularMargemLucroComFrete( blnSomaFreteAoPrecoParaCustoReal,
                                                  blnSomaFreteCobradoAoUnitario: Boolean;
                                                  var cdsItens: TUniClientDataSet);
  Var
    cdsVendaTmp: TUniClientDataSet;
    cdsItensTmp: TUniClientDataSet;
begin
  //Rateia o desconto especial, frete cobrado e frete sugerido nos produtos da venda
  pRateiaValores;

  cdsVendaTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsVendaTmp, cdsVenda);

  pAtualizaTemporariaItens(cdsVendaTmp);

  cdsItensTmp := TMargemLucro.fCriaEstruturaDadosMargemLucro;

  cdsVendaTmp.First;
  While (Not cdsVendaTmp.Eof) Do
  Begin
    If (cdsVendaTmp.FieldByName('ITE_PROMOC').AsString = 'S') And
       ((VS_strTRADES = '4') And (Not fConsiderarItemPromocionalMargemMinimaDocumento)) Then
    Begin
      cdsVendaTmp.Next;
      Continue;
    End;

    If (fEhMargemMinimaDocumentoDesconsiderandoBrinde) And (fItemCdsBrinde(cdsVendaTmp)) Then
    Begin
      cdsVendaTmp.Next;
      Continue;
    End;

    If (fIgnoraProdutoCortadoSemSaldo(cdsVendaTmp.FieldByName('AUTOINCREM').AsString)) Then
    Begin
      cdsVendaTmp.Next;
      Continue;
    End;

    cdsItensTmp.Append;

    cdsItensTmp.FieldByName('ITE_SEQUEN').AsInteger := cdsVendaTmp.RecNo;

    cdsItensTmp.FieldByName('ITE_TOTITE').AsFloat := cdsVendaTmp.FieldByName('ITE_TOTITE').AsFloat -
                                                     cdsVendaTmp.FieldByName('ITE_DESESP').AsFloat +
                                                     IIF(blnSomaFreteCobradoAoUnitario, cdsVendaTmp.FieldByName('ITE_VALFRE').AsFloat, 0);

    cdsItensTmp.FieldByName('ITE_UNITAR').AsFloat := fFormataFloat(cdsItensTmp.FieldByName('ITE_TOTITE').AsFloat / cdsVendaTmp.FieldByName('ITE_QTDITE').AsFloat, VS_intDecUni);

    If blnSomaFreteAoPrecoParaCustoReal Then
      cdsItensTmp.FieldByName('ITE_UNIFRE').AsFloat := fFormataFloat(cdsVendaTmp.FieldByName('ITE_VALFRE').AsFloat / cdsVendaTmp.FieldByName('ITE_QTDITE').AsFloat, 2);


    pPrepararDataSetParaCalculoDaMargem( cdsItensTmp,
                                         cdsVendaTmp,
                                         False,  //Não pega o unitário pois já calculou
                                         True,   //Calcula o Preco de Custo
                                         False,  //Não aplica o desconto pois já aplicou no unitario
                                         0,
                                         False);

    cdsItensTmp.Post;
    cdsVendaTmp.Next;
  End;

  pCalcularEPreencherMargemDataSet(cdsItensTmp);

  cdsItens.Data := cdsItensTmp.Data;
  cdsItens.LogChanges := False;

  FreeAndNil(cdsVendaTmp);
  FreeAndNil(cdsItensTmp);

end;

