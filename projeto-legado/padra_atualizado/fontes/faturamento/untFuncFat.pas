procedure TFatVenda.pSetaVendaPresencialParaClienteForaDoEstadoMedianteCFG(blnRecalculaTotGer: Boolean = True;
                                                                           blnValidaPeloCdsVenda: Boolean = False);
  Var
    blnVendaPresencialAnt: Boolean;

  function fPossuiSomenteEntrega():Boolean;
  begin
    If blnValidaPeloCdsVenda Then
      Result := fPossuiSomenteItensEntregaNoCdsVenda()
    Else
      Result := fPossuiSomenteItensEntrega();
  end;

  function fPossuiSomenteRetira():Boolean;
  begin
    If blnValidaPeloCdsVenda Then
      Result := fPossuiSomenteItensRetiraNoCdsVenda()
    Else
      Result := fPossuiSomenteItensRetira();
  end;
begin
  If Not fAtendeRegrasDifal(True) Then
    Exit;

  blnVendaPresencialAnt := blnVendaPresencial;

  If (strCliEst <> fGetUFEmpresa('')) And Not blnVendaPresencial Then
  Begin
    If fCfgSis('VPRFEE', varBoolean) And (objEndEnt.recEndere.strEstEnt = fGetUFEmpresa('')) And fPossuiSomenteEntrega() Then
      blnVendaPresencial := True
    Else If (Pos(Self.strOpcDoc, 'OE_OU_NC_') <= 0) And fCfgSis('VPRFER', varBoolean) And fPossuiSomenteRetira() Then
      blnVendaPresencial := True;
  End;

  If blnRecalculaTotGer And (blnVendaPresencialAnt <> blnVendaPresencial) Then
    pCalculaTotGer;
end;

function TFatVenda.GetDocsAdiantamento: String;
Var
  LQuery: TUniQuery;
begin
  result := '';
  LQuery := fCriaQuery;

  Try
    LQuery.SQL.Add(' SELECT DISTINCT ');
    LQuery.SQL.Add('       CONCAT( ');
    LQuery.SQL.Add('               IF( R1.RCX_NUMDOC IS NOT NULL, CONCAT("ADIANTAMENTO DE CLIENTE REF. PEDIDOS(S):", ');
    LQuery.SQL.Add('                                              CONCAT(R1.RCX_NUMDOC,"-",R1.RCX_ESPDOC,"-",R1.RCX_CODEMP,"-","VALOR R$",R1.RCX_VALDOC,"-",R1.RCX_DTACAD)), ""), ');
    LQuery.SQL.Add('               IF( R2.RCX_NUMDOC IS NOT NULL, CONCAT(" - FEITO RECEBIMENTO JUNTO AO DOCUMENTO ", ');
    LQuery.SQL.Add('                                              CONCAT(R2.RCX_NUMDOC,"-",R2.RCX_ESPDOC,"-",R2.RCX_CODEMP,"-","VALOR R$",R2.RCX_VALDOC)), "") ');
    LQuery.SQL.Add('              ) AS DOCSADT ');
    LQuery.SQL.Add(' FROM ');
    LQuery.SQL.Add('  ADTCLI A ');
    LQuery.SQL.Add('  LEFT JOIN CADRCXX R1 ');
    LQuery.SQL.Add('    ON R1.RCX_NUMDOC = A.ADT_NUMDOC ');
    LQuery.SQL.Add('    AND R1.RCX_ESPDOC IN ("PD") ');
    LQuery.SQL.Add('    AND R1.RCX_CODEMP = A.ADT_EMPLAN ');
    LQuery.SQL.Add('  LEFT JOIN CADRCXX R2 ');
    LQuery.SQL.Add('    ON R2.RCX_SEQCON = R1.RCX_SEQCON ');
    LQuery.SQL.Add('    AND R2.RCX_ESPDOC IN ("CC","DV") ');
    LQuery.SQL.Add('WHERE A.ADT_NUMDOC = '+QuotedStr( iif ( fEmptyStr(strNumOrc) , strPedExp, strNumOrc) ) );
    LQuery.SQL.Add('  AND A.ADT_ESPDOC = '+QuotedStr( iif ( fEmptyStr(strEspOrc), 'PD'      , strEspOrc) ) );
    LQuery.SQL.Add('  AND A.ADT_EMPLAN = '+QuotedStr(VS_strCodEmp));
    LQuery.Open;

    if not fEmptyStr(LQuery.FieldByName('DOCSADT').asstring) then
      result := LQuery.FieldByName('DOCSADT').asstring;

  Finally
    FreeAndNil(LQuery);
  End;
end;

