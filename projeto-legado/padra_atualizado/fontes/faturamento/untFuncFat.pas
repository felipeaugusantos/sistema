function TFatVenda.fEhNotaOuCupomEspecialComCartao: Boolean;
begin
  Result := False;

  If (Not Self.blnNotEsp) And (Not (Pos(strOpcDoc, 'CE_') > 0)) Then
    Exit;

  If (Self.strCodFpg <> '007') Then
    Exit;

  Result := True;
end;

function TFatVenda.fCndTemQueSerAVista: Boolean;
begin
  {*********************************************************************}
  {* TEM QUE ALTERAR A CONDICAO DE PAGAMENTO PARA A VISTA, POIS ESTAVA *}
  {* GRAVANDO RECEBIMENTO NO CAIXA E CONTAS A RECEBER EM ABERTO        *}
  {***************************************************************JC,RN*}
  {******************************************************************VA*}
  Result := (Pos(Self.strEspDoc, 'PD_OR_') <= 0)  And
            (Pos(Self.strOpcDoc, 'DV_') <= 0)     And
            (Pos(Self.strCodFpg, '002_007_') > 0) And
            (fCfgSis('PRACHC',varBoolean))        And
            (Not Self.blnMeiaNota) And
            (Not fEhNotaOuCupomEspecialComCartao);
end;

procedure TFatVenda.pGeraStringCuponsDevolucao;
  var
    intCont: Integer;
begin
  strCupConDev := '';

  for intCont := Low(arrMatItens) to High(arrMatItens) do
    If (arrMatItens[intCont].strEspDev = 'IF') And
       (Pos(arrMatItens[intCont].strDocDev, strCupConDev) <= 0) Then
   Begin
      strCupConDev := strCupConDev + arrMatItens[intCont].strDocDev + '-' +
                                     arrMatItens[intCont].strEspDev + ', ';
   End;

