    function fItemJaFatu(strSeqDet : String) : Boolean;
    begin

      Result := False;

      If fPedidoPendente Then
        If (cdsDadosPedBaixados.Locate('ITE_SEQDET', strSeqDet, [])) Then
          Result := cdsDadosPedBaixados.FieldByName('ITE_JAFATU').AsBoolean;

    end;

    function fRetItemEntRet():String;
    begin
      Result := item.strEntRet;
      If blnPedidoTransf Then
      Begin
        If fCfgSis('SUG_TE', varBoolean) Then
          Result := 'E'
        Else
          Result := 'R';
      End;
    end;

    function fRetItemLocRet():String;
    var
      strEntRet: String;
      strOPLORE: String;
    begin
      Result := item.strLocRet;

      If blnPedidoTransf Then
      Begin
        strEntRet := fRetItemEntRet();

        If (strEntRet = 'R') Then
        Begin
          strOPLORE := fCfgSis('OPLORE', VarString);
          If (fCfgSis('LOCRET', varString) = 'S') And (Length(strOPLORE) >= 2) And (strOPLORE[2] = 'S') Then
            Result := 'E'
          Else
            Result := '-';
        End
        Else If (strEntRet = 'E') Then
          Result := '-';
      End;
    end;

begin
  strTabelaTinta := '';

  If (fCfgSis('NROPRO') = '3') And (Assigned(cdsProfiss)) And (cdsProfiss.Active) Then
  Begin
    If (cdsProfiss.IsEmpty) Then
      strCodDiv := ''
    Else
    Begin
      cdsProfiss.First;
      strCodDiv := cdsProfiss.fieldbyname('DIV_CODDIV').AsString;
    End;
  End;

  if fEmptyStr(strCodDiv) and (not fEmptyStr(item.strDivDev)) then
  begin
    strCodDiv := item.strDivDev;
  end;

  If Not fUsaVendedorDoItemParaComissao(item.strCodVen) Then
    strVendedor := Self.strCodVen
  Else
    strVendedor := item.strCodVen;

  objCalcComissaoVend := Self.fCriaCalculoComissaoVendedor(strVendedor);

  fltPerCom := objCalcComissaoVend.fRetPerComissao(item, strTipVen);

  fltTot_RT := item.fltRT_Ori * item.fltQtdIte;

  fltTotCom := fltPerCom * (item.fltTotIte - item.fltDesEsp - item.fltTaxEnt - fltTot_RT) / 100;

  fltPerExt := objCalcComissaoVend.fRetPerComissao(item, 'E',True);

  fltTotExt := fltPerExt * (item.fltTotIte - item.fltDesEsp - item.fltTaxEnt - fltTot_RT) / 100;

  FreeAndNil(objCalcComissaoVend);

  fltTotPes := (item.fltPesoIt * item.fltQtdIte);

  If (fCfgSis('PESLIQ') = 'FATOR') Then
    fltTotPesLiq := fFormataFloat(fltTotPes * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3)
  Else
    fltTotPesLiq := (item.fltPesLiq * item.fltQtdIte);

  If (fCfgSis('REPVEN', varBoolean)) And (Not fEmptyStr(strCodVe2)) Then
  Begin
    fltTotCo2 := (fltTotCom * fCfgSis('TAXREP', varDouble)) / 100;
    fltTotCom := fltTotCom - fltTotCo2;
  End
  Else
  Begin
    fltTotCo2 := 0;
  End;

  fltVlrCom := fltVlrCom + fltTotCom;
  fltVlrExt := fltVlrExt + fltTotExt;

  strCodAca := item.strCodAca;
  strEmpAca := item.strEmpAca;

  //QUANDO FOR HERANCA DE ORÇAMENTO E FOR GRAVADO UM NOVO ORÇAMENTO OU UM NOVO PEDIDO
  //ENTAO TEM QUE SER GERADO UM NOVO PRODUTO ACABADO
  If (blnHerancaOrcamentoPedido) And (Not fEmptyStr(strCodAca)) And
     (item.strIdePro <> 'NOR') And (Pos(strEspDoc, 'OR_PD_') > 0) Then
  Begin
    strCodAca := '';
    item.strChaFor := item.strDesIte + ' ' + item.strRefere;
  End;

  If (fEmptyStr(strCodAca)) And (Not fEmptyStr(item.strChaFor)) Then
  Begin
    objProdAcabado := TProdAcabado.Create(item.fltPreCus,
                                          fRetornaPreVenProdAcabado(item));
    objProdAcabado.strDescri := item.strDesIte;
    objProdAcabado.strIdePro := item.strIdePro;
    objProdAcabado.strCodIte := item.strCodIte;
    objProdAcabado.strOprFlj := 'N';
    objProdAcabado.strBrinde := Item.strBrinde;

    dicRetorno := TDicionario.Create;
    SetLength(arrBaixaPigmentos, 0);
    stlItensTraMl := TStringList.Create;

    strTabelaTinta := fTabelaPrecoTinta(strCodCliLj, '', '', False, False, False);

    dicRetorno['itebas'] := item.strCodIte;
    dicRetorno['iteemb'] := item.strIteEmb;
    dicRetorno['coddil'] := item.strCodDil;
    dicRetorno['pordil'] := item.fltPorDil;
    dicRetorno['complementob'] := item.recForTin.strCompB;
    dicRetorno['fatace'] := item.fltFatAce;

    dicRetorno['empite'] := item.strEmpIte;
    if fEmptyStr(dicRetorno['empite']) then
      dicRetorno['empite'] := item.strEmpPrd;
    if fEmptyStr(dicRetorno['empite']) then
      dicRetorno['empite'] := VS_strCodEmp;

    dicRetorno['descri'] := item.strDesIte;
    dicRetorno['tabpre'] := strTabelaTinta; //IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);
    dicRetorno.AdicionarObjeto('calculadorFatVendas', FFatVendasCalculador);

    Try
      If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
        pSetaEmpresaLogadaTinta(VS_strCodEmp)
      Else If Not fEmptyStr(item.strEmpPrd) Then
        pSetaEmpresaLogadaTinta(item.strEmpPrd)
      Else If Not fEmptyStr(item.strEmpIte) Then
        pSetaEmpresaLogadaTinta(item.strEmpIte);
      
      fCalcularTabelasdePreco(  item.strIdePro, // Tipo de Produto
                                item.strIteTin, // Item da Tinta
                                item.strTipPre, // Tipo de Preço
                                item.strLinTin, // Linha da Tinta
                                item.strCatali, // Catalizador Utilizado
                                item.intLazQua, // Quarto (Lazzumix)
                                item.fltQtdEmb, // Quantidade de Embalagem
                                item.fltQtdIte, // Quantidade do Item
                                item.strDesIte, // Descrição do Item
                                qryTintaAux,                        // Arquivo de Formulas!
                                item.fltVolPro, // Volume a ser produzido (Tinta c/ Venda Dinamica)
                                arrFormul,                          // Retorno da Formulação
                                arrBaixaPigmentos,                  // Retorno dos Pigmentos a serem baixados
                                stlItensTraMl,
                                item.strCodDil,
                                item.fltPorDil,
                                item.strDilCon,
                                item.fltPorCat,
                                item.recForTin.strTipCor,
                                item.recForTin.strTextBase,
                                item.recForTin.intModDil,
                                dicRetorno,
                                Item.strPorPer);
    Finally
      pSetaEmpresaLogadaTinta(VS_strCodEmp);
    End;

    dicRetorno['impult'] := IfNull(dicRetorno['impult'], 0);
    dicRetorno['preult'] := IfNull(dicRetorno['preult'], 0) / item.fltQtdIte;
    objProdAcabado.pImportarTabelasPreco(dicRetorno);

    objProdAcabado.pSalvar(True);

    strCodAca := objProdAcabado.strCodAca;
    strEmpAca := VS_strCodEmp;
    stlCodAca.Add(strCodAca);

    FreeAndNil(stlItensTraMl);
    FreeAndNil(dicRetorno);
    FreeAndNil(objProdAcabado);
  End;

  item.strCodAcaOr := strCodAca;
  item.strEmpAcaOr := strEmpAca;

  Result := True;

  If (strEspDoc = 'PD') And //Caso for Pedido de Venda
     (blnEmitirOrdemProdSubItensNoPedido) And //Configurado para emitir ordem de producao no pedido
     (item.strBxSbIt = 'S') Then //Seja um produto estrutura baixando os sub-produtos
  Begin
    If (blnHerancaOrcamentoPedido) And (Not fEmptyStr(item.strOrdPro)) Then
      item.strOrdPro := EmptyStr;

    Result := fGerarOrdProItensEstrutura(item, False); //Grava a ordem de producao mas nao baixa
  End;

  If Not fUsaVendedorDoItemParaComissao(item.strCodVen) Then
    item.strCodVen := Self.strCodVen;

  If Not fUsaVendedorDoItemParaComissao(item.strCodVe2) Then
    item.strCodVe2 := Self.strCodVe2;

  strAutIncFdo := item.strAutoincrementoGravacao;
  strAutIncLdg := item.strAutoincrementoDaLogDor;

  If (blnOrigemTelaDesmembrarPedidoConfiguracaoDPDAFPLigada) And (item.fltQtdIte = item.fltQtdBai) Then
    item.blnJaFatu := True
  Else If ((blnImpSfa) And (blnSfaPag) And (sfaStsPagto = sspPagamentoReprovado)) Or (fItemJaFatu(item.strSeqDet)) Then
    item.blnJafatu := true
  else
    item.blnJafatu := false;

  fltUniDol := 0;
  fltTotDol := 0;

  If fCfgSis('COTDOR', VarBoolean) Then
  Begin
    If (fltVlCtVn > 0) And fItemUtilizaPrecoEmDolar(item.strCodIte) Then
    Begin
      fltUniDol := item.fltUnitar / fltVlCtVn;
      fltTotDol := item.fltTotIte / fltVlCtVn;
    End;
  End;

  strTemNumSerie := 'N';
  If fCfgSis('NSERQT', varBoolean) Then
    strTemNumSerie := IIF(Length(item.arrSeriesItem) > 0, 'S', 'N');

  If (Self.strEspDoc = 'PD') And
     (fCfgSis('F11FPD', varBoolean)) Then
  Begin
    item.fltQtdExp := 0;
    item.fltQtdRet := 0;

    If (item.strEntRet = 'R') And (item.strLocRet = 'C') Then
    Begin
      If (item.strLctBar = 'S') Or
         ((fCampoTabela('ITE_BAREXP','CADITE',['ITE_CODITE'],[item.strCodIte], False) = 'N') And
          (item.strLctBar = 'N')) Then
      Begin
        item.fltQtdExp := item.fltQtdIte;
        item.fltQtdRet := item.fltQtdIte;
      End;
    End;
  End;

  Result := Result And
            fGravaFatDor(strAutIncFdo,
                         strAutIncFatGor,
                         strCodEmpFatDor,
                         strCodCliLj,
                         item.strCodVen,
                         item.strCodIte,
                         item.strCodMar,
                         strCodDiv,
                         strNumDocLj,
                         strEspDocLj,
                         '',
                         dtaGraPed,
                         IIF((dtaHorPed > 0), dtaHorPed, fRetHoraServidor),
                         IIF(FstrConPagPedidoTransf.IsEmpty, strConPag, FstrConPagPedidoTransf),
                         strCliEst,
                         item.strDesIte,
                         item.strRefere,
                         item.strCodUni,
                         item.strCodFor,
                         item.fltQtdIte,
                         item.fltUniTar,
                         item.fltUniOri,
                         item.fltUniVis,
                         item.fltTotIte,
                         (item.fltTotIte-item.fltDesEsp) + item.fltValFre + item.fltValIpi + item.fltValRet + item.fltDesAce + IIF((item.fltValRet > 0), item.recDifalFCP.fltValFcp, 0) + item.fltValCbs + item.fltValIbs + item.fltVal_IS, // fltVlrCon
                         item.fltTotCus,
                         item.fltTotMed,
                         item.fltDesCon,
                         item.fltValFre,
                         item.fltDesEsp,
                         item.fltDesAce,
                         strCodRep,
                         item.strCodVe2,
                         fltPerCom,
                         fltTotCom,
                         fltTotCo2,
                         item.strClaFis,
                         item.strCodFis,
                         item.fltValIpi,
                         item.fltAlqIpi,
                         item.fltBasIpi,
                         item.fltValIcm,
                         item.fltAlqIcm,
                         item.fltBasIcm,
                         item.fltValRet,
                         item.fltAlqRet,
                         item.fltBasRet,
                         fltTotPes,
                         item.fltPerBas,
                         item.fltPerRed,
                         item.blnJafatu,
                         item.strTipFat,
                         item.strNumFat,
                         item.strEmpFat,
                         item.dtaDtaFat,
                         item.strVenFat,
                         item.strCndFat,
                         item.fltValFat,
                         item.strIdePro,
                         item.strIncPis,
                         strCodDig,
                         IIF(FstrCodCndPedidoTransf.IsEmpty, strCodCnd, FstrCodCndPedidoTransf),
                         item.strProEmb,
                         IIF(FstrCodFpgPedidoTransf.IsEmpty, strCodFpg, FstrCodFpgPedidoTransf),
                         item.strIteCha,
                         item.strIteTin,
                         item.strDesCor,
                         item.strTipEmb,
                         item.fltQtdEmb,
                         item.fltQtdEmb * item.fltUniEmb,
                         item.strTipPre,
                         item.fltPrvTin,
                         item.fltPrcTin,
                         item.fltFatTin,
                         item.strIteEmb,
                         fRetornaGrupoItem(item.strIteEmb),
                         item.intLazQua,
                         item.strPromoc,
                         '',
                         0.0,
                         item.intSeqInd,
                         item.fltQtdBai,
                         item.fltUniDig,
                         item.strComple,
                         item.fltVolPro,
                         strCodAca,
                         strEmpAca,
                         item.blnProAca,
                         item.strTabPre,
                         item.strLinTin,
                         item.strCatali,
                         item.strCodDil,
                         item.fltPorDil,
                         item.strDilCon,
                         item.fltPorCat,
                         fRetItemEntRet,
                         fRetItemLocRet,
                         IIF(blnPedidoTransf,'N',item.strEntFut),
                         item.strMotFut,
                         item.dtaDtEntr,
                         item.fltTotCu2,
                         fltTotExt,
                         fltPerExt,
                         '',
                         IIF(Not fEmptyStr(strEmpFor), item.strLotAba, item.strNumLot),
                         item.strEmpPrd,
                         item.strBxSbIt = 'S', //BAIXA DO SUB.ITEM DO PRODUTO ESTRUTURA
                         item.strEmpIte,     //EMPRESA POR ITEM
                         item.strDocDev,
                         item.strEspDev,
                         item.strEmpDev,
                         item.strEmpSol,
                         item.strOrdPro,
                         item.fltFreSug,
                         item.fltQtdExp,
                         item.strBarEmb,
                         item.strNumCmp,
                         item.intNItCmp,
                         item.strCodMec,
                         item.strSeqRcd,
                         item.intSeqInc,
                         item.intOrdIte,
                         fltTotPesLiq,
                         item.strAltPCo,
                         item.strCliBus,
                         item.strTurEnt,
                         item.fltRT_Ori,
                         item.fltTaxJur,
                        (item.strInsere = 'S') Or (item.strAltera = 'S'),
                         IIF(Not fEmptyStr(strEmpFor), item.strNumLot, ''),
                         item.strLotAnt,
                         item.strIncFut,
                         item.fltSerRat,
                         item.strSepExp,
                         item.fltFreRat,
                         item.strPigBas,
                         item.strAiDvOr,
                         item.strSeqOpI,
                         item.strBrinde,
                         item.strCodPar,
                         item.strTipBri,
                         item.strBaqtze,
                         item.fltMaxPed,
                         fCalculaValorFlex(item, strCreDeb),
                         item.strPegou_,
                         item.fltTaxEnt,
                         item.strAtivac,
                         item.intSeqCom,
                         item.fltQtdAti,
                         item.fltQtdCom,
                         item.strTabCom,
                         item.strDesNes,
                         item.blnIcmSai,
                         item.fltIcmPav,
                         item.fltIcmSai,
                         fCalcCurImpFed(item.fltImpFed, item.fltIcmSai, item.recDifalFCP.fltAlDifa, item.recDifalFCP.fltPerFcp),
                         fProcessarDespesasOperacionaisComplementar(item.fltDesOpe),
                         fAlqDifIcmsPrecoDinamico(item.strCodIte, item.strEmpIte, item.strCodAbf, item.strCodFis, item.fltIcmSai),
                         '',
                         IIF((item.fltValRet > 0), item.recDifalFCP.fltValFcp, 0),
                         (item.fltPesoIt * item.fltQtdIte),
                         FSeqIndUlt,
                         item.intQdeNtr,
                         item.strNcmTin,
                         item.strNotC17,
                         fGetIcmsEntregaFutura(item),
                         item.strCodCmg,
                         item.fltQtdSep,
                         item.fltDesCnd,
                         item.intSeqEst,
                         item.strIteEst,
                         item.fltUniEst,
                         item.fltQtdSbi,
                         item.fltUniSbi,
                         item.fltFreMkp,
                         item.fltComMkp,
                         item.strProEsp,
                         IIF(item.intSeqCom > 0, 'S', 'N'),
                         item.strCodPro,
                         fltUniDol,
                         fltTotDol,
                         item.fltQtdRco,
                         fItemLiberadoParaExibirBaixaSeparacao(item),
                         item.strAIdKitPromocao,
                         IIF(fItemFoiCompletamenteSeparado(item), item.strOpBxSe, ''),
                         IIF(fItemFoiCompletamenteSeparado(item), item.dtaDtBxSe, 0),
                         IIF(fItemFoiCompletamenteSeparado(item), item.dtaHrBxSe, 0),
                         item.strEmpCar,
                         item.fltDesBai,
                         strTemNumSerie,
                         item.fltVDesST,
                         item.strMDesST,
                         item.strReserv,
                         item.intSeqInv,
                         item.strSeqEql,
                         item.strNumDrw,
                         item.blnMntPrc,
                         item.fltQtdRet,
                         item.strNumPla,
                         item.strParNum,
                         item.strReqCom,
                         '',
                         item.strRegEsp,
                         item.fltFreCot,
                         item.blnAltEst,
                         item.intSeqPer,
                         item.blnRatEst,
                         item.strObsRco,
                         strNumPok,
                         IIF(blnVaiApagarPdOriginalNoDesmembramentoRegEsp, Self.strNumOrigem, ''),
                         IIF(blnVaiApagarPdOriginalNoDesmembramentoRegEsp, Self.strEspOrigem, ''),
                         IIF(fGravarEmpresaOrigemItemPedido, Self.strEmpOrigem, ''),
                         IIF(fItemFoiCompletamenteSeparado(item), item.strOpeSep, ''),
                         IIF(item.fltQtdIte = item.fltQtdOri, item.strOpeExp, ''),
                         IfThen(blnDesmembramentoDePedidos, strEmpDmp, ''),
                         fUniDigDescontada(item.fltUniDig, item.fltTaxJur, item.fltDesCon, item.fltDesCnd, item.strPromoc),
                         IIF(fGravarPendenciaDeRecebimento(item), 'S', 'N'),
                         item.dtaDtaCmp,
                         item.fltOutValPD,
                         item.fltFreEntPD,
                         item.fltAcpProPD,
                         item.fltAcpTxcPD,
                         item.fltAcpVctPD,
                         item.fltAcpResPD,
                         item.fltAcpMarPD,
                         item.strTckQbt,
                         '',
                         item.fltSomaColorantes,
                         item.strAutoincrementoDaLogDor,
                         item.fltIcmPrd,
                         item.fltValPis,
                         item.fltValCof);


   If fRetornaMedidasLoteChapa(strOpcDoc,
                               item.strCodIte,
                               VS_strCodEmp,
                               item.strNumLot,
                               item.fltQtdIte,
                               fltQtdCha,
                               fltMedB_L,
                               fltMedB_A,
                               fltMedL_L,
                               fltMedL_A,
                               fltEspess) Then
   Begin
     Result := Result And fGravaFdoCha(strAutIncFdo,
                                       fltQtdCha,
                                       fltMedB_L,
                                       fltMedB_A,
                                       fltMedL_L,
                                       fltMedL_A,
                                       fltEspess);
   End;

   If strTemNumSerie = 'S' Then
   Begin
     pLimpaNseDor(strAutIncFdo);
     For recDadosSerie In item.arrSeriesItem Do
       Result := Result And fGravaNseDor(strAutIncFdo, recDadosSerie.strNumSer, recDadosSerie.fltQtdSer);
   End;

   If (Result) Then
     pCalculaGravaICMSUFDestino(strAutIncFdo, 'DORICD', item);

   If (Result) Then
     Result := fRegravarCdsFgoCaiExp(strAutIncFatGor, strAutIncFdo, item);

   If (Result) Then
   Begin
     FFdoIte.pGravaFdoIte(strAutIncFdo, item, Self);
   End;

   blnRegravaLotDor := True;
   if Result and FblnEmSeparacao then
   begin
     Result := fRegravaLotDor(item.strSeqDet, strAutIncFdo, item.fltQtdIte);
     If Result Then
       blnRegravaLotDor := False;
   end;

   Result := Result and fGravaSepDor(item.strSeqDet, strAutIncFdo, 'SEPDOR', arrSepDor);
   Result := Result and fGravaSepDor(item.strSeqDet, strAutIncFdo, 'SEPDOR_AUTCOM', arrSepDor_AutCom);

   Result := Result and fGravaConDor(item.strSeqDet, strAutIncFdo, 'CONDOR', arrConDor);
   Result := Result and fGravaConDor(item.strSeqDet, strAutIncFdo, 'CONDOR_AUTCOM', arrConDor_AutCom);

  {****************************************************************************}
  {* ESTA FUNCAO DEVE FICAR LOGO APOS A GRAVACAO DO PEDIDO, POIS ELA PRECISA  *}
  {* DO AUTOINCREM ANTIGO DO ITEM (CAMPO item.strSeqDet) PARA ATUALIZAR NO    *}
  {* ROMANEIO DO PEDIDO (CFG_TIPROM = 1).                                     *}
  {*************************************************************************JC*}
  If (fCfgSis('USPRRO', varBoolean)) Then
  Begin
    Result := Result And fAtualizaQtdRom(strNumDocLj, strEspDocLj, strCodEmpFatDor,
      strCodCliLj, item.strCodIte, item.strSeqDet, strAutIncFdo, item.fltQtdIte);
  End;

  If (strEspDocLj = 'PD') And Assigned(objRegravarLotesPedidoWMS) And (blnRegravaLotDor) Then
  Begin
    objRegravarLotesPedidoWMS.pRegravarLotesItem(item.strSeqDet, strAutIncFdo);
  End;

  If (strEspDocLj = 'PD') And Assigned(objAbastecimentoItensPedido) And (Not blnOrigemTelaDesmembrarPedidoConfiguracaoDPDAFPLigada) Then
  Begin
    objAbastecimentoItensPedido.pAtualizarAbastecimentosAnteriores(item.strSeqDet,
      strAutIncFdo, strNumDocLj, strEspDocLj, strCodEmpFatDor, item.opcTipAbs, item.strCodIte);

    objAbastecimentoItensPedido.pGerarPreparaRequisicoes(item, strAutIncFdo,
      strNumDocLj, strEspDocLj, strCodEmpFatDor, item.opcTipAbs);

    Result := Result And objAbastecimentoItensPedido.fGerarPreparaTransferencias(item,
                                                                                 strAutIncFdo,
                                                                                 strNumDocLj,
                                                                                 strEspDocLj,
                                                                                 strCodEmpFatDor,
                                                                                 item.opcTipAbs);
  End;

  pRegravaSepFdo(strAutIncFdo, item.strSeqDet);

  If (blnImpSfa) Then
  Begin
    TMovFlex.pAdicionarVerbaFlex(strNumPok,
                                 strNumDocLj,
                                 strCodVen,
                                 strCodSup,
                                 dtaGraPed);
  End;

  {********************************************************}
  {* SE UTILIZA FLEX, OS PEDIDOS IMPORTADOS PELA FAITH    *}
  {* DEVEM SER RECALCULADOS E SALVOS NOVAMENTE NA MOVFLEX *}
  {*****************************************************MM*}
  If (Not fDocumentoParaFornecedor()) And
     (Result) And
     (fGeraFlexOpe) And
     (fUsaFlex(item.strCodIte)) Then
  Begin
    pGravarMovFlex(item);
  End;

  If (Result) Then
    item.strSeqDet := strAutIncFdo;

  If (Result) Then
    Result := fGravaForTin(strCodAca, item.recForTin.strTextBase,
      item.recForTin.strTipCor, item.recForTin.intModDil,
      item.strEmpAcaOr, item.recForTin.strCompB,
      item.recForTin.strUniver, item.fltFatAce,
      item.recForTin.strCatali);

  If Result And fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
    Result := fGravaVendaMadeira(strAutIncFdo, 'ORCMAD', item.recMadeira);

  If Result And Assigned(objEstruturaVidros) And fEhItemVendaVidro(item.strCodIte) Then
  Begin
    objEstruturaVidros.pCarregarEstrutura(item.intAutInc);
    objEstruturaVidros.pGravarEstruturaPedOrc(strAutIncFdo);
  End;

  {*********************************************}
  {* SE FOR PEDIDO E SE CFG_ENTFUT='S'         *}
  {* AO GERAR O DOCUMENTO, OS ITENS QUE        *}
  {* ESTIVEREM COMO "ENTREGA FUTURA",          *}
  {* DEVERAO SER GRAVADOS COMO "JA EXPEDIDOS"  *}
  {******************************************AC*}
  If Result And (strEspDoc = 'PD') And fProdutoSempreMarcaComoJaExpedido(item.strEntRet, item.strEntFut) Then
  Begin
    Result := fMarcaProdutoComoJaExpedido(strAutIncFdo, item.fltQtdIte);
    blnEntFut := True;
  End;
end;

{************************************}
{* GRAVA CHEQUES CARREGADOS NA TEMP *}
{*********************************AF*}
function TFatVenda.fGravaCheques: Boolean;
  Var
    strTabela: String;
    fltChqValIpi, fltChqValRet, fltChqValAce, fltChqValFre, fltChqValCbs, fltChqValIbs, fltChqVal_Is: Double;
Begin
  Try
    Result := True;

    strTabela := 'CADCHQ';

    With cdsChequePre Do
    Begin

      If Assigned(cdsChequePre) And (Active) And (Not IsEmpty) And (fFormataFloat(fltValCqP,2) <> 0.00) Then
      Begin

        First;

        While (Not Eof) Do
        Begin
          pProcessMessages;

          Try
            fltChqValIpi := fltTotIpi  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValRet := fltTotRet  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValAce := fltDesAce  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValFre := fltValFre  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValCbs := fltTotCBS  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValIbs := fltTotIBS  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqVal_Is := fltTotIS   * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
          Except
            fltChqValIpi := 0;
            fltChqValRet := 0;
            fltChqValAce := 0;
            fltChqValFre := 0;
            fltChqValCbs := 0;
            fltChqValIbs := 0;
            fltChqVal_Is := 0;
          End;

          Result := Result And
                    fGravaCheque(FieldByName('CHQ_CODBCO').AsString,
                                 FieldByName('CHQ_NUMAGE').AsString,
                                 FieldByName('CHQ_CONCOR').AsString,
                                 FieldByName('CHQ_NUMCHQ').AsString,
                                 FieldByName('CHQ_CODCLI').AsString,
                                 FieldByName('CHQ_NOMEMI').AsString,
                                 FieldByName('CHQ_ENDERE').AsString,
                                 FieldByName('CHQ_TELEMI').AsString,
                                 FieldByName('CHQ_CGCCPF').AsString,
                                 FieldByName('CHQ_C_G_C_').AsString,
                                 FieldByName('CHQ_HIST01').AsString,
                                 FieldByName('CHQ_HIST02').AsString,
                                 FieldByName('CHQ_CTADEP').AsString,
                                 FieldByName('CHQ_DOCDEP').AsString,
                                 FieldByName('CHQ_CODPOR').AsString,
                                 FieldByName('CHQ_CODCTA').AsString,
                                 FieldByName('CHQ_MOTDEV').AsString,
                                 FieldByName('CHQ_FORREP').AsString,
                                 FieldByName('CHQ_OBSREP').AsString,
                                 FieldByName('CHQ_CODEMP').AsString,
                                 FieldByName('CHQ_NUMNOT').AsString,
                                 FieldByName('CHQ_PORCUS').AsString,
                                 fDocumeCheque(CHQ_PRE),
                                 'N',
                                 FieldByName('CHQ_DTACAD').AsDateTime,
                                 FieldByName('CHQ_DTAVEN').AsDateTime,
                                 FieldByName('CHQ_DTADEP').AsDateTime,
                                 FieldByName('CHQ_DTADEV').AsDateTime,
                                 FieldByName('CHQ_DTARDP').AsDateTime,
                                 FieldByName('CHQ_DTAREP').AsDateTime,
                                 FieldByName('CHQ_DTACUS').AsDateTime,
                                 FieldByName('CHQ_VALCHQ').AsFloat,
                                 '',
                                 intSeqConRcx,
                                 IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
                                 IIF(blnConfOrcamento,1,IIF(blnCfgGravaResCai And blnValGravaResCai, 1, 0)),
                                 FieldByName('CHQ_TELCHE').AsString,
                                 FieldByName('CHQ_TELNUM').AsString,
                                 FieldByName('CHQ_CODOPE').AsString,
                                 FieldByName('CHQ_CODCMC').AsString,
                                 fltChqValIpi,
                                 fltChqValRet,
                                 fltChqValAce,
                                 fltChqValFre,
                                 FieldByName('CHQ_PORCHQ').AsString,
                                 'untFuncFat',
                                 FieldByName('CHQ_NAODEP').AsString,
                                 FieldByName('CHQ_CODCID').AsString,
                                 IIF(blnConfOrcamento,strCodigoCaixa,IIF(blnCfgGravaResCai And blnValGravaResCai, strCodigoCaixa, '')),
                                 '',
                                 '',
                                 fltChqValCbs,
                                 fltChqValIbs,
                                 fltChqVal_Is);

          If Result Then
            Result := fGravaLogChqFuncFat(2, cdsChequePre);

          SetLength(FDadosCheques, Length(FDadosCheques) + 1);
          FDadosCheques[Length(FDadosCheques) - 1].strCodBco := FieldByName('CHQ_CODBCO').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strNumAge := FieldByName('CHQ_NUMAGE').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strConCor := FieldByName('CHQ_CONCOR').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strNumChq := FieldByName('CHQ_NUMCHQ').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strHistor := fDocumeCheque(CHQ_PRE);

          Next;
        End;

      End;

    End;

   {************************************}
   {* CHEQUE A VISTA                   *}
   {*********************************AF*}
    With cdsChequeVis Do
    Begin

      If Assigned(cdsChequeVis) And (Active) And (Not IsEmpty) And (fFormataFloat(fltValCqV,2) <> 0.00) Then
      Begin

        First;

        While Not Eof Do
        Begin
          pProcessMessages;

          Try
            fltChqValIpi := fltTotIpi  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValRet := fltTotRet  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValAce := fltDesAce  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValFre := fltValFre  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValCbs := fltTotCBS  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqValIbs := fltTotIBS  * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
            fltChqVal_Is := fltTotIS   * (FieldByName('CHQ_VALCHQ').AsFloat / fltTotCadRec);
          Except
            fltChqValIpi := 0;
            fltChqValRet := 0;
            fltChqValAce := 0;
            fltChqValFre := 0;
            fltChqValCbs := 0;
            fltChqValIbs := 0;
            fltChqVal_Is := 0;
          End;

          Result := Result And
                    fGravaCheque(FieldByName('CHQ_CODBCO').AsString,
                                 FieldByName('CHQ_NUMAGE').AsString,
                                 FieldByName('CHQ_CONCOR').AsString,
                                 FieldByName('CHQ_NUMCHQ').AsString,
                                 FieldByName('CHQ_CODCLI').AsString,
                                 FieldByName('CHQ_NOMEMI').AsString,
                                 FieldByName('CHQ_ENDERE').AsString,
                                 FieldByName('CHQ_TELEMI').AsString,
                                 FieldByName('CHQ_CGCCPF').AsString,
                                 FieldByName('CHQ_C_G_C_').AsString,
                                 FieldByName('CHQ_HIST01').AsString,
                                 FieldByName('CHQ_HIST02').AsString,
                                 FieldByName('CHQ_CTADEP').AsString,
                                 FieldByName('CHQ_DOCDEP').AsString,
                                 FieldByName('CHQ_CODPOR').AsString,
                                 FieldByName('CHQ_CODCTA').AsString,
                                 FieldByName('CHQ_MOTDEV').AsString,
                                 FieldByName('CHQ_FORREP').AsString,
                                 FieldByName('CHQ_OBSREP').AsString,
                                 FieldByName('CHQ_CODEMP').AsString,
                                 FieldByName('CHQ_NUMNOT').AsString,
                                 FieldByName('CHQ_PORCUS').AsString,
                                 fDocumeCheque(CHQ_VISTA),
                                 'N',
                                 FieldByName('CHQ_DTACAD').AsDateTime,
                                 FieldByName('CHQ_DTAVEN').AsDateTime,
                                 FieldByName('CHQ_DTADEP').AsDateTime,
                                 FieldByName('CHQ_DTADEV').AsDateTime,
                                 FieldByName('CHQ_DTARDP').AsDateTime,
                                 FieldByName('CHQ_DTAREP').AsDateTime,
                                 FieldByName('CHQ_DTACUS').AsDateTime,
                                 FieldByName('CHQ_VALCHQ').AsFloat,
                                 '',
                                 intSeqConRcx,
                                 IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),
                                 IIF(blnConfOrcamento,1,IIF(blnCfgGravaResCai And blnValGravaResCai, 1, 0)),
                                 FieldByName('CHQ_TELCHE').AsString,
                                 FieldByName('CHQ_TELNUM').AsString,
                                 FieldByName('CHQ_CODOPE').AsString,
                                 FieldByName('CHQ_CODCMC').AsString,
                                 fltChqValIpi,
                                 fltChqValRet,
                                 fltChqValAce,
                                 fltChqValFre,
                                 FieldByName('CHQ_PORCHQ').AsString,
                                 'untFuncFat',
                                 FieldByName('CHQ_NAODEP').AsString,
                                 FieldByName('CHQ_CODCID').AsString,
                                 IIF(blnConfOrcamento,strCodigoCaixa,IIF(blnCfgGravaResCai And blnValGravaResCai, strCodigoCaixa, '')),
                                 '',
                                 '',
                                 fltChqValCbs,
                                 fltChqValIbs,
                                 fltChqVal_Is);

          If Result Then
            Result := fGravaLogChqFuncFat(1, cdsChequeVis);

          SetLength(FDadosCheques, Length(FDadosCheques) + 1);
          FDadosCheques[Length(FDadosCheques) - 1].strCodBco := FieldByName('CHQ_CODBCO').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strNumAge := FieldByName('CHQ_NUMAGE').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strConCor := FieldByName('CHQ_CONCOR').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strNumChq := FieldByName('CHQ_NUMCHQ').AsString;
          FDadosCheques[Length(FDadosCheques) - 1].strHistor := fDocumeCheque(CHQ_VISTA);

          Next;
        End;
      End;
    End;

    If Result Then
      Self.blnGravouCadChq := True;
    
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[fGravaChequesFaturamento]');
      Result := False;
    End;
  End;
End;

function TFatVenda.fGravaMovCon(intAutIncMat: Integer;
                                strAutIncDet, strEspDocDet, strTabela : String): Boolean;
  Var
    objConsig : TConsignacoes;
    qryMovCon : TUniQuery;
    strNomeTabela : String;
    intContador : integer;
    strAutIncCon : String;
    blnGravouMovNotCon: Boolean;
    strMensagem : String;
Begin
  Result := True;

  If (Self.strOpcDoc = 'EM') And (strEspDocDet = 'PR') Then
    Exit;

  blnGravouMovNotCon := False;
  Try
    If Assigned(dicDocs) Then
    Begin
      If (dicDocs.RetornaObjeto(intToStr(intAutIncMat)) <> Nil) Then
      Begin  
        objConsig := TConsignacoes(dicDocs.RetornaObjeto(intToStr(intAutIncMat)));

        if not objConsig.blnDeveGravar then
          Exit;

        If (strTabela = 'M') Then
          strNomeTabela := 'MOVCON'
        Else If (strTabela = 'N') Then
          strNomeTabela := 'NOTCON';

        qryMovCon := fCriaQuery;
        Try
          qryMovCon.SQL.Text := 'SELECT * FROM ' + strNomeTabela + ' WHERE FALSE';
          qryMovCon.Open;
          For intContador := Low(objConsig.arrConsignacoes) To High(objConsig.arrConsignacoes) Do
          Begin
            strAutIncCon := fRetAutoIncrem(strNomeTabela, VS_strCodEmp);

            With qryMovCon Do
            Begin
              Insert;
              FieldByName('CON_SEQGER').AsString := strAutIncDet;
              FieldByName('AUTOINCREM').AsString := strAutIncCon;
              FieldByName('CON_NUMDOC').AsString := objConsig.arrConsignacoes[intContador].strNumDoc;
              FieldByName('CON_ESPDOC').AsString := objConsig.arrConsignacoes[intContador].strEspDoc;
              FieldByName('CON_CODITE').AsString := objConsig.arrConsignacoes[intContador].strCodIte;
              FieldByName('CON_CODEMP').AsString := objConsig.arrConsignacoes[intContador].strCodEmp;
              FieldByName('CON_QTDITE').AsFloat  := objConsig.arrConsignacoes[intContador].fltQtdIte;
              FieldByName('CON_DESESP').AsFloat  := objConsig.arrConsignacoes[intContador].fltDesEsp;
              If Not fEmptyStr(objConsig.arrConsignacoes[intContador].strCodAca) Then
                FieldByName('CON_CODACA').AsString := objConsig.arrConsignacoes[intContador].strCodAca;
              FieldByName('CON_AUTICS').AsString := objConsig.arrConsignacoes[intContador].strAutInc;
              FieldByName('CON_TIPMOV').AsString := IIF(objConsig.arrConsignacoes[intContador].tmTipoDeMovimento = tmFaturamento, 'F', 'D');

              Post;

              if not TRetornoConsignacaoBuilder.fAtualizaCONDEV(objConsig.arrConsignacoes[intContador].strAutInc,
                                                                objConsig.arrConsignacoes[intContador].fltQtdIte,
                                                                strMensagem) then
              Begin                                                    
                pMensagensErro(strMensagem, '[fGravaMovCon]');
                Exit(False);
              End; 

              blnGravouMovNotCon := True;
            End;
          End;
        Finally
          FreeAndNil(qryMovCon);
        End;
      End;
    End;

    If (fFaturamentoConsignacao Or fRetornoConsignacao) Then
    Begin
      If (Not blnGravouMovNotCon) Then
      Begin
        Raise Exception.Create('Atenção! Houve uma inconsistência ao gerar os dados de movimentação de consignação, por favor, entre em contato com a Citel');
      End;
    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGravaMovCon]');
    End;
  End;
End;

{*****************************************}
{* VERIFICA DEBITOS DO CLIENTE           *}
{* - CADREC / CADCHQ                     *}
{* intOpcao = 9 (obter fltTotDeb)        *}
{**************************************MV*}
function TFatVenda.fDebitoCliente(strForPag, strCndPag: String;
  intOpcao: Integer; strOpcTra: String = ''; blnPedeSenha: Boolean = True; blnCamuflarMsgSeConfigurado: Boolean = True): Boolean;
  Var
    blnPosAtr: Boolean;
    strSQL   : String;
    qryGenTmp: TUniQuery;
    strPedidos : String;
    blnFilPed  : Boolean;
    objLiberacao  : TLiberacao;
    dtaDtaVenc : TDateTime;
begin
  fltTotDeb := 0.0;
  fltCtrAbe := 0.0;
  fltCtrVen := 0.0;
  fltChqAbe := 0.0;
  fltChqVen := 0.0;
  dtaMaiAtr := Self.VS_Date;
  blnPosAtr := False;
  Result    := True;

  If (Pos(strOpcDoc, 'OU_OV_NC_BR_TE_OE_OF_EF_CF_CI_CO_MF_UC_DV_PR_') > 0) Or (blnComVal) Then
    Exit;

  If strTipOpe = 'U' Then
    Exit;

  If fEmptyStr(strOpcTra) Then
    strOpcTra := IIF(fEmptyStr(strEspDoc), strOpcDoc, strEspDoc);

  {*****************************************}
  {* SE O CLIENTE FOR CONSUMIDOR           *}
  {**************************************WI*}
  If fClienteConsumidor(strCliOri,True, True) Then
  Begin
    Result := True;
    Exit;
  End;

  If Self.blnNEFornecedor Then
  Begin
    Result := True;
    Exit;
  End;

  {*********************************************}
  {* CONFIGURAÇÃO PARA LIBERAR CLIENTE COMPRAR *}
  {* A VISTA EM DINHEIRO OU CARTÃO MESMO COM   *}
  {* DEBITOS                                   *}
  {******************************************MV*}
  If fCfgSis('LIBAVI', varBoolean) And
     ((Not fUsaPerfilECadCnd) Or (fUsaPerfilECadCnd And (Not fVerificaTravaAtrasoMax))) And
     ((intOpcao = 2) Or (intOpcao = 3) Or (intOpcao = 4) or (intOpcao = 9)) Then
  Begin
    If (fEmptyStr(strForPag)) And (VS_blnUsaFpg) Then
      strForPag := '001';

    If (fStatusCndPag(strCndPag) = A_VISTA) And
       ((Pos(strForPag, '001_007_') > 0) Or (Not VS_blnUsaFpg)) Then
    Begin
      Result := True;
      pRemoverTravaLogAvi('DEATR', strNTrava);
      Exit;
    End;
  End;

  qryGenTmp := fCriaQuery(Self);
  strPedidos := strNumOrc;

  {*****************************************************************}
  {* CASO ESTEJA CONFIRMANDO PEDIDOS, PEGA OS PEDIDOS SELECIONADOS *}
  {**************************************************************PZ*}
  If (Not fEmptyStr(strNumDocsPD)) Then
    strPedidos := strNumDocsPD;

  {*****************************************************************************}
  {* CASO ESTEJA CARREGANDO UM PEDIDO DE VENDA PARA ALTERAÇÃO OU PARA FATURAR, *}
  {* OU ESTIVER CONFIRMANDO PEDIDOS PELA CONFIRMAÇÃO DE PEDIDOS, DESCONSIDERA  *}
  {* OS PEDIDOS SELECIONADOS PARA CALCULO DOS DÉBITOS DO CLIENTE               *}
  {**************************************************************************PZ*}
  blnFilPed := ((Pos(strOpcDoc, 'PD_VN_') > 0) And (strEspOrc = 'PD')) Or (Not fEmptyStr(strNumDocsPD));

  {*****************************************}
  {* SE ENTRA PEDIDOS EM ABERTO NO LIMITE  *}
  {***************************************LA}
  If fCfgSis('PDVLIM', varBoolean) Then
    fltTotDeb := fltTotDeb + fRetTotalPedidoVendaAberto(strCodCli, IIF(blnFilPed, strPedidos, ''));

  {*********************************************}
  {* SE ENTRA EMPRÉSTIMOS EM ABERTO NO LIMITE  *}
  {*******************************************BL}
  If fCfgSis('LMCEMP', varBoolean) Then
    fltTotDeb := fltTotDeb + fRetTotalEmprestimosAberto(strCodCli);

  {*****************************************}
  {* DEBITOS (CHEQUE PRE) -> CADCHQ(X)     *}
  {**************************************WI*}
  If fCfgSis('CHQCCO', varBoolean) Then
  Begin

    strSQL := '';
    strSQL := strSQL + 'SELECT                               ';
    strSQL := strSQL + '  CHQ_VALCHQ,                        ';
    strSQL := strSQL + '  CHQ_DTAVEN,                        ';
    strSQL := strSQL + '  CLI_ATRMAX                         ';
    strSQL := strSQL + 'FROM                                 ';
    strSQL := strSQL + '  CADCHQ                             ';
    strSQL := strSQL + '  INNER JOIN CADCLI                  ';
    strSQL := strSQL + '    ON CLI_CODCLI = CHQ_CODCLI       ';
    strSQL := strSQL + 'WHERE (                              ';
    strSQL := strSQL + '    CLI_CODCLI = :CODCLI             ';
    If fCfgSis('TRFTCR', varString) = '2' Then
    Begin
      strSQL := strSQL + '    OR CLI_CODRED =                  ';
      strSQL := strSQL + '    (SELECT                          ';
      strSQL := strSQL + '       CLI_CODRED                    ';
      strSQL := strSQL + '     FROM                            ';
      strSQL := strSQL + '       CADCLI                        ';
      strSQL := strSQL + '     WHERE CLI_CODCLI = :CODCLI)     ';
    End;
    strSQL := strSQL + '  )                                  ';
    strSQL := strSQL + '  AND ((                              ';
    strSQL := strSQL + '    (CHQ_DTADEP IS NULL)             ';
    strSQL := strSQL + '    OR (                             ';
    strSQL := strSQL + '      (CHQ_DTADP2 IS NULL)           ';
    strSQL := strSQL + '      AND (CHQ_DTADEV IS NOT NULL)   ';
    strSQL := strSQL + '    )                                ';
    strSQL := strSQL + '  )                                  ';

    if (fCfgSis('CHQNVT', varBoolean)) then
    begin
      strSQL := strSQL + '    OR (CHQ_CTADEP = "REPASSE" AND   ';
      strSQL := strSQL + '        CHQ_DTAVEN >= CURDATE())     ';
    end;

    strSQL := strSQL + '  )                                  ';
    strSQL := strSQL + '  AND CHQ_INCCTR = "N"               ';
    strSQL := strSQL + '  AND IFNULL(CHQ_TELCHE, "N") <> "S" ';

    With qryGenTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      While Not Eof Do
      Begin

        dtaDtaVenc := FieldByName('CHQ_DTAVEN').AsDateTime;
        dtaDtaVenc := fAjustaDataParaDiaUtilCfgCSDFTA(dtaDtaVenc);

        fltTotDeb := fltTotDeb + FieldByName('CHQ_VALCHQ').AsFloat;
        If fCfgSis('CLIATR', varBoolean) Then
        Begin
          If (dtaDtaVenc + FieldByName('CLI_ATRMAX').AsInteger) < Self.VS_Date Then
            blnPosAtr := True;
        End
        Else
        Begin
          If (dtaDtaVenc + fCfgSis('ATRMAX', varInteger)) < Self.VS_Date Then
            blnPosAtr := True;
        End;

        {*************************************}
        {* VARIÁVEIS UTILIZADAS NO RELATORIO *}
        {* DE POSITIVAÇÃO DE CLIENTES.       *}
        {**********************************PZ*}
        If (dtaDtaVenc < Self.VS_Date) Then
        Begin
           fltChqVen := fltChqVen + FieldByName('CHQ_VALCHQ').AsFloat;
        End
        Else If (dtaDtaVenc >= Self.VS_Date) Then
        Begin
           fltChqAbe := fltChqAbe + FieldByName('CHQ_VALCHQ').AsFloat;
        End;

        If (dtaDtaVenc < Self.VS_Date)   And
           (dtaDtaVenc < dtaMaiAtr) Then
          dtaMaiAtr := dtaDtaVenc;

        Next;

      End;

      Close;
    End;

  End;

  {*****************************************}
  {* DEBITOS (CONTAS A REC.) -> CADREC(X)  *}
  {**************************************WI*}
  strSQL := '';
  strSQL := strSQL + 'SELECT                               ';
  strSQL := strSQL + '  CTR_VALDUP,                        ';
  strSQL := strSQL + '  CTR_JURSUJ,                        ';
  strSQL := strSQL + '  CTR_DESSUJ,                        ';
  strSQL := strSQL + '  CTR_DESCOB,                        ';
  strSQL := strSQL + '  CTR_DTAVEN,                        ';
  strSQL := strSQL + '  CLI_ATRMAX                         ';
  strSQL := strSQL + 'FROM                                 ';
  strSQL := strSQL + '  CADREC                             ';
  strSQL := strSQL + '  INNER JOIN CADCLI                  ';
  strSQL := strSQL + '    ON CLI_CODCLI = CTR_CODCLI       ';

  If fCfgSis('EXIPOR', varBoolean) Then
    strSQL := strSQL + '  LEFT JOIN CADPOR ON POR_CODPOR = CTR_CODPOR ';

  strSQL := strSQL + 'WHERE (                              ';
  strSQL := strSQL + '    CLI_CODCLI = :CODCLI             ';
  If fCfgSis('TRFTCR', varString) = '2' Then
  Begin
    strSQL := strSQL + '    OR CLI_CODRED =                  ';
    strSQL := strSQL + '    (SELECT                          ';
    strSQL := strSQL + '       CLI_CODRED                    ';
    strSQL := strSQL + '     FROM                            ';
    strSQL := strSQL + '       CADCLI                        ';
    strSQL := strSQL + '     WHERE CLI_CODCLI = :CODCLI)     ';
  End;
  strSQL := strSQL + '  )                                  ';
  strSQL := strSQL + '  AND CTR_DTAREC IS NULL             ';

  If fCfgSis('EXIPOR', varBoolean) Then
    strSQL := strSQL + ' AND ((IFNULL(POR_CONPOR, "") = "") OR (POR_CONPOR = "S"))  ';

  if fCfgSis('ALPKNK', varBoolean) then
    strSQL := strSQL + ' AND LOCATE(CTR_CODCND, :CNDBOL) = 0 ';

  With qryGenTmp Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('CODCLI').AsString := strCodCli;

    if fCfgSis('ALPKNK', varBoolean) then
      ParamByName('CNDBOL').AsString := fCfgSis('CNDBOL', varString);

    Open;

    While Not Eof Do
    Begin
      If (FieldByName('CTR_VALDUP').AsFloat > 0) Or fCfgSis('DEDCRE', varBoolean) Then
        fltTotDeb := fltTotDeb + (FieldByName('CTR_VALDUP').AsFloat
                                  + FieldByName('CTR_JURSUJ').AsFloat
                                  + FieldByName('CTR_DESCOB').AsFloat
                                  - FieldByName('CTR_DESSUJ').AsFloat);

      dtaDtaVenc := FieldByName('CTR_DTAVEN').AsDateTime;
      dtaDtaVenc := fAjustaDataParaDiaUtilCfgCSDFTA(dtaDtaVenc);

      If fCfgSis('CLIATR', varBoolean) Then
      Begin
        If (FieldByName('CTR_VALDUP').AsFloat > 0) And
           ((dtaDtaVenc + FieldByName('CLI_ATRMAX').AsInteger) < Self.VS_Date) Then
          blnPosAtr := True;
      End
      Else
      Begin
        If (FieldByName('CTR_VALDUP').AsFloat > 0) And
           ((dtaDtaVenc + fCfgSis('ATRMAX', varInteger)) < Self.VS_Date) Then
          blnPosAtr := True;
      End;

      {*************************************}
      {* VARIÁVEIS UTILIZADAS NO RELATORIO *}
      {* DE POSITIVAÇÃO DE CLIENTES.       *}
      {**********************************PZ*}
      If (dtaDtaVenc < Self.VS_Date) Then
      Begin
        If (FieldByName('CTR_VALDUP').AsFloat > 0) Or fCfgSis('DEDCRE', varBoolean) Then
          fltCtrVen := fltCtrVen + FieldByName('CTR_VALDUP').AsFloat;
      End
      Else If (dtaDtaVenc >= Self.VS_Date) Then
      Begin
        If (FieldByName('CTR_VALDUP').AsFloat > 0) Or fCfgSis('DEDCRE', varBoolean) Then
          fltCtrAbe := fltCtrAbe + FieldByName('CTR_VALDUP').AsFloat;
      End;

      If (FieldByName('CTR_VALDUP').AsFloat > 0) And
         (dtaDtaVenc < Self.VS_Date) And
         (dtaDtaVenc < dtaMaiAtr) Then
        dtaMaiAtr := dtaDtaVenc;

      Next;

    End;

    Close;
  End;

  if (intOpcao = 9) then
    Exit(True);

  objLiberacao := TLiberacao.Create;

  blnPosAtr := blnPosAtr And (fltTotDeb > 0);

  {*****************************************}
  {* CASO O CLIENTE POSSUIR DEBITOS,       *}
  {* (CADREC OU CADCHQ) MOSTRA AVISO PARA  *}
  {* O CLIENTE                             *}
  {**************************************MV*}
  If (intOpcao = 2) or (intOpcao = 4) Then
    pRemoverTravaLogAvi('DEATR', strNTrava);

  If ((blnPosAtr) And (intOpcao = 2) And (fCfgSisTraMax(strOpcTra) <> 'N') And fVerificaTravaAtrasoMax) Then
  Begin

    If fCfgSis('CLIATR', varBoolean) Then
    Begin
      If (fCfgSis('TRFTCR', varString) = '2') And (fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [strCodCli]) <> '') Then
        objLiberacao.objMsgLibera.pAddTexto('A rede de lojas desse cliente possui débito(s) em atraso!')
      Else If fRetAtrasoMaxCliente(strCodCli) > 0 Then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Esse cliente possui débito(s) em atraso há mais de ' + IntToStr(fRetAtrasoMaxCliente(strCodCli)) + ' dias!');
        TDuplicataAtrasoFaturamento.fCarregaMensagemLiberacao(strCodCli, objLiberacao.objMsgLibera);
      end
      Else
        objLiberacao.objMsgLibera.pAddTexto('Este cliente possui débitos em atraso!');
    End
    Else
    Begin
      If (fCfgSis('TRFTCR', varString) = '2') And (fCampoTabela('CLI_CODRED', 'CADCLI', ['CLI_CODCLI'], [strCodCli]) <> '') Then
        objLiberacao.objMsgLibera.pAddTexto('A rede de lojas desse cliente possui débito(s) em atraso!')
      Else If fCfgSis('ATRMAX', varInteger) > 0 Then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Esse cliente possui débito(s) em atraso há mais de ' + IntToStr(fCfgSis('ATRMAX', varInteger)) + ' dias!');
        TDuplicataAtrasoFaturamento.fCarregaMensagemLiberacao(strCodCli, objLiberacao.objMsgLibera);
      end
      Else
        objLiberacao.objMsgLibera.pAddTexto('Este cliente possui débitos em atraso!');
    End;

    objLiberacao.objMsgLibera.pAddTextoCaption('Total de Débito(s) Vencido(s) do Cliente', 'R$ '+ FormatFloat('#,##0.00', fltCtrVen + fltChqVen), 41);

    objLiberacao.objMsgLibera.pAddTextoCaption('Total Geral de Débito(s) do Cliente'     , 'R$ '+ FormatFloat('#,##0.00', fltTotDeb), 41);

    objLiberacao.objMsgLibera.pAddTexto('A data do vencimento mais antigo é ' + FormatDateTime('dd/mm/yyyy', dtaMaiAtr) + ', ' +
                                        'sendo ' + IntToStr(DaysBetween(Self.VS_Date, dtaMaiAtr)) + ' dias em atraso!');

    If (strOriF11 = 'S') Then
      objLiberacao.objMsgLibera.pAddTextoCaption('Condição Pagto'  , fFormataCondPag(strCndPag), 18)
    Else
    Begin
      objLiberacao.objMsgLibera.pAddTextoCaption('Condição Pagto'  , IIF(fCfgSis('USACND', varBoolean), strCodCnd+'-'+fRetDesConPag(strCodCnd)+' ', '') + fFormataCondPag(strConPag), 18);
      If fCfgSis('USAFPG', varBoolean) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagto', (strCodFpg+'-'+fRetDescFpg(strCodFpg)), 18);

      If ((Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (blnLiberacaoRemotaNoFinalVenda)) And
         (
          ( ( ((Pos(strOpcDoc, 'PD_OR_') > 0) And fCfgSis('TFPF11', varBoolean)) Or fCfgSis('SFPGPD', varBoolean) ) And (strCodFpg = '009')) Or
          ((fCfgSis('SOLCAR', varBoolean)) And (strCodFpg = '007'))
         ) Then
      Begin
        If fCfgSis('USAFPG', varBoolean) Then
          objLiberacao.objMsgLibera.pAddTextoCaption('                   ', STRING_FORMAS_PAGTO_NEGOCIADAS)
        Else
          objLiberacao.objMsgLibera.pAddTextoCaption('Forma de Pagto'     , STRING_FORMAS_PAGTO_NEGOCIADAS, 18)
      End;
      objLiberacao.objMsgLibera.pAddQuebra;
    End;

    If (fltTotGer <> 0) Then
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor da Venda', 'R$ ' + FormatFloat('#,##0.00', fltTotGer), 18);

    pMostraMensagemFechamentoEhOrcemPed(objLiberacao.objMsgLibera);

    {*****************************************}
    {* TRATAMENTO DE SENHA FIXA, VARIAVEL OU *}
    {* USUÁRIO                               *}
    {**************************************MV*}
    If (Not blnPedeSenha) Then
      pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem);

    objLiberacao.strDirAce := 'DEATR';
    objLiberacao.blnTraTel := (fCfgSisTraMax(strOpcTra) = 'T');
    objLiberacao.strSenLib := fCfgSis('SENMAX');
    objLiberacao.strMsgSen := 'Débito em Atraso';
    objLiberacao.strCodOpe := strCodVen;
    objLiberacao.strCodDig := strCodDig;
    objLiberacao.strCliente := (strCodCli + '-' + strCliOri);
    objLiberacao.strCpfCnpj := strCliCgc;
    objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);
    objLiberacao.blnCamuflarMsgSeConfigurado := blnCamuflarMsgSeConfigurado;

    If Not (blnPedeSenha And fFatMensagemLiberacao(objLiberacao)) Then
    Begin
      blnVerDebAtr := True;
      Result := False;
      If Assigned(qryGenTmp) Then
        FreeAndNil(qryGenTmp);

      if Assigned(objLiberacao) then
        FreeAndNil(objLiberacao);

      Exit;
    End
    Else
    Begin
      {******************************************************************************}
      {* ESTAVA MOSTRANDO A TRAVA TODA HORA PARA O CLIENTE, A CADA PRODUTO INSERIDO *}
      {***************************************************************************RN*}
      //If Not (fSomenteAvisaPoisVaiTravarNoFinalVenda('DEATR') And (fCfgSisTraMax(strOpcTra) = 'T')) Then
        blnVerDebAtr := False;
    End;

  End;

  If (intOpcao = 1) Then
  Begin

    {*****************************************}
    {* MOSTRA CONTA CORRENTE                 *}
    {**************************************WI*}
    If fCfgSis('EXICCC', varBoolean) Then
      pMostraDebitosReceber;

    If fCfgSis('CHQCCO', varBoolean) And fCfgSis('EXICCC', varBoolean) Then
    Begin
      {*****************************************}
      {* MOSTRA CHEQUES                        *}
      {**************************************WI*}
      pMostraDebitosCheques;
    End;

    If fltTotDeb > 0.0 Then
    Begin

      blnVerDebAtr := True;

      If fCfgSis('EXICCC', varBoolean) Then
        fMensagem('', 'Total Geral de Débito(s) do Cliente' + #13#10 +
                      'Cliente: ' + strCodCli +
                      ' - ' + strCliOri + #13#10 +
                      'Valor: ' + FormatFloat('#,##0.00', fltTotDeb), ['&O k']);
    End;

  End;

  If ((blnPosAtr) And (intOpcao = 4) And (fCfgSisTraMax(strOpcTra) <> 'N') And fVerificaTravaAtrasoMax) Then
    Result := False;

  FreeAndNil(qryGenTmp);
  FreeAndNil(objLiberacao);
end;

function TFatVenda.fBuscaAutoIncCADFIS(strNumDoc, strTipoDoc: string): string;
var
  qryAutoInc: TUniQuery;
  strSQL: string;
begin
  try
    strSQL := '';
    strSQL := strSQL + 'SELECT AUTOINCREM FROM CADFIS WHERE FIS_NUMDOC = :NUMDOC AND FIS_ESPDOC = :ESPDOC ';

    qryAutoInc := fCriaQuery(nil);
    qryAutoInc.Close;
    qryAutoInc.SQL.Clear;
    qryAutoInc.SQL.Add(strSQL);
    qryAutoInc.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAutoInc.ParamByName('ESPDOC').AsString := strTipoDoc;
    qryAutoInc.Open;

    Result := qryAutoInc.FieldByName('AUTOINCREM').AsString;
  finally
    FreeAndNil(qryAutoInc);
  end;
end;

function TFatVenda.fBuscaNumerosSeries(strCodIte, strCodEmp,
  strNumDoc: string): string;
var
  qryNumSer: TUniQuery;
  strSQL: string;
  strSeries: string;
begin
  try
    if fEmptyStr(strNumDoc) then
    begin
      strNumDoc := strOpcDoc;
    end;

    Result := 'Series ';
    strSeries := '';

    strSQL := '';
    strSQL := strSQL + 'SELECT CONCAT('+iif(fCfgSis('ITENRS', varBoolean), ' SER_CODITE, " - ", ', '');
    strSQL := strSQL + '              GROUP_CONCAT(SER_NUMSER SEPARATOR ", ")) AS SER_NUMSER ';
    strSQL := strSQL + '  FROM PROSER ';
    strSQL := strSQL + ' WHERE SER_CODITE = :CODITE ';
    strSQL := strSQL + '   AND SER_CODEMP = :CODEMP ';
    strSQL := strSQL + '   AND SER_NUMDOC = :NUMDOC ';

    qryNumSer := fCriaQuery(nil);
    qryNumSer.Close;
    qryNumSer.SQL.Clear;
    qryNumSer.SQL.Add(strSQL);
    qryNumSer.ParamByName('CODITE').AsString := strCodIte;
    qryNumSer.ParamByName('CODEMP').AsString := strCodEmp;
    qryNumSer.ParamByName('NUMDOC').AsString := strNumDoc;
    qryNumSer.Open;

    strSeries := strSeries + ', ' + qryNumSer.FieldByName('SER_NUMSER').AsString;

    Delete(strSeries,1,2);
    Result := Result + strSeries;
  finally
    FreeAndNil(qryNumSer);
  end;
end;

function TFatVenda.fBuscaNumerosSeriesConfirmacaoDocumento(
  Itens: TMatrizFechamento): String;
var
  qryNumeroSerie: TUniQuery;
  item: TDadosFechamento;
  strSeriesDoItem: String;
begin
  qryNumeroSerie := fCriaQuery;

  try
    qryNumeroSerie.Close;
    qryNumeroSerie.SQL.Clear;
    qryNumeroSerie.SQL.Add('SELECT SER_NUMSER');
    qryNumeroSerie.SQL.Add('FROM DETSER');
    qryNumeroSerie.SQL.Add('WHERE SER_SEQGER = :SEQGER');

    Result := EmptyStr;

    for item in Itens do
    begin
      strSeriesDoItem := EmptyStr;
      qryNumeroSerie.Close;
      qryNumeroSerie.ParamByName('SEQGER').AsString := item.strSeqDet;
      qryNumeroSerie.Open;

      while not qryNumeroSerie.Eof do
      begin
        if not fEmptyStr(strSeriesDoItem) then
          strSeriesDoItem := strSeriesDoItem + ', ';

        strSeriesDoItem := strSeriesDoItem + qryNumeroSerie.FieldByName('SER_NUMSER').AsString;

        qryNumeroSerie.Next;
      end;

      if not fEmptyStr(strSeriesDoItem) then
      begin
        strSeriesDoItem := strSeriesDoItem;

        if not fEmptyStr(Result) then
          Result := Result + ': ';

        Result := Result + strSeriesDoItem;
      end;


    end;
  finally
    FreeAndNil(qryNumeroSerie);
  end;
end;

function TFatVenda.fBuscaNumerosSeriesMod2(item: TDadosFechamento): String;
  Var
    recDadosSerie: TDadosSerie;
    strSeries: String;
begin
  strSeries := '';
  For recDadosSerie In item.arrSeriesItem Do
  Begin
    If Not fEmptyStr(recDadosSerie.strNumSer) And (recDadosSerie.fltQtdSer > 0) Then
    begin
      If (strSeries = '') and fCfgSis('ITENRS', varBoolean) then
        strSeries := item.strCodIte+'-';
      strSeries := strSeries + recDadosSerie.strNumSer + ', ';
    end;
  End;

  Result := '';
  If Not fEmptyStr(strSeries) Then
    Result := 'Series '+ Copy(strSeries, 1, Length(strSeries) -2);
end;

function TFatVenda.fBuscaNumerosSeriesTodosItens(strCodEmp: String): String;
  Var
    item: TDadosFechamento;
    strSeries: String;
begin
  Result := '';

  For item In arrMatItens Do
  Begin
    If StrToIntDef(item.strClaFis,0) > 5000 Then
    Begin
      If fCfgSis('NSERQT', varBoolean) And (Pos(strOpcDoc, 'OU_OF_') <= 0) Then
        strSeries := fBuscaNumerosSeriesMod2(item)
      Else
        strSeries := fBuscaNumerosSeries(item.strCodIte, strCodEmp, item.strNumOrc);

      strSeries := strSeries.Replace('Series','').Trim;

      If Not fEmptyStr(strSeries) Then
        Result := Result + strSeries + ', ';
    End;
  End;

  Result := Copy(Result, 1, Length(Result) -2);
end;

function TFatVenda.fValidarTipoFaturamentoEmail: Boolean;
begin
  Result := True;
  If (Self.strEspDoc = 'NF') Or
     ((Self.strEspDoc = 'IF') And ((fCfgSis('CUPNOT', varInteger) = 1) Or (fCfgSis('CUPENT', varInteger) = 1)) And fHaveraDesmembramentoVenda(arrMatItens)) Then
  Begin
    If (Not Self.fValidaAtualizaEmailNFE('NF')) Then
    Begin
      Result := False;
      pMensagemOk('É necessário um e-mail válido para essa venda!');
    End;
  End;
end;

function TFatVenda.fVerificaInfoIntegradorSatCitel(): Boolean ;
begin
  Result := True ;
  If (self.strEspDoc = 'IF') and (fUsaIntegradorSatCitel) Then
  begin
    if fEmptyStr(VS_NumSerSat) then
    begin
      fMensagem('','Número de Série do SAT-CFE não informado!'+#13+'Verifique as configurações na CFG_CFGSAT',['&OK']);
      Exit(False) ;
    end ;
  end ;
end ;

function TFatVenda.fValidarTipoFaturamentoRetencoes(blnEstaNoF11: Boolean = False): Boolean;

  function fVaiValidarIRPJPISCOFINS():Boolean;
  begin
    Result := True;

    If (Not blnEstaNoF11) And (Pos(strOpcDoc, 'VN_CP_EI_') > 0) Then
      Result := fCfgSis('SNFIPC', VarBoolean);
  end;
begin
  Result := True;

  If (Self.strEspDoc <> 'NF') And fVaiValidarIRPJPISCOFINS() Then
  Begin
    IF (Self.fltIrPrRt > 0) And (Self.strRetIrf = 'S') Then
    Begin
      fMensagem('ATENÇÃO', 'Cliente configurado para Reter IRPJ, assim o valor do ' +
                           'IRPJ foi descontado do valor total do documento. ' +
                           'Somente será permitido emitir Nota Fiscal para esta Venda!', ['&O k']);
      Result := False;
    End
    Else IF ((Self.fltPiPrRt > 0) Or (Self.fltCoPrRt > 0)) And (Self.strRetPco = 'S') Then
    Begin
      fMensagem('ATENÇÃO', 'Cliente configurado para Reter PIS/COFINS, assim o valor do ' +
                           'PIS/COFINS foi descontado do valor total do documento. ' +
                           'Somente será permitido emitir Nota Fiscal para esta Venda!', ['&O k']);
      Result := False;
    End;
  End;

  If (Pos(Self.strEspDoc, 'NF_EL_') <= 0) And
     (Self.fltDesEsp > 0) And (Self.strBenRei = 'S') Then
  Begin
    fMensagem('ATENÇÃO', 'Cliente configurado com Benefício REIDI, assim o valor do ' +
                         'PIS/COFINS foi descontado do valor total do documento. ' +
                         'Somente será permitido emitir Nota Fiscal para esta Venda!', ['&O k']);
    Result := False;
  End;
end;

