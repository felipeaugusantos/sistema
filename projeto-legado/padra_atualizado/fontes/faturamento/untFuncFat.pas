{* NO CLIENT DATASET                     *}
{**************************************AF*}
procedure TFatVenda.pRemovePedidosPendentes;

  function fCompararItem: Boolean;
  begin
    Result := cdsDadosPedBaixados.FieldByName('ITE_SEQDET').AsString = cdsVenda.FieldByName('ITE_SEQDET').AsString;
  end;

begin

  Try
    cdsDadosPedBaixados.First;
    With cdsVenda Do
    Begin
      DisableControls;

      While Not cdsDadosPedBaixados.Eof Do
      Begin

        First;
        While Not Eof Do
        Begin

          If fCompararItem Then
          Begin

            If fFormataFloat(FieldByName('ITE_QTDITE').AsFloat,2) = fFormataFloat(cdsDadosPedBaixados.FieldByName('ITE_QTDITE').AsFloat,2) Then
              Delete
            Else
            Begin
              Edit;
              FieldByName('ITE_QTDITE').AsFloat := FieldByName('ITE_QTDITE').AsFloat - cdsDadosPedBaixados.FieldByName('ITE_QTDITE').AsFloat;
              FieldByName('ITE_TOTITE').AsFloat := fFormataFloat(FieldByName('ITE_QTDITE').AsFloat * FieldByName('ITE_UNITAR').AsFloat,2);
              FieldByName('ITE_QTDBAI').AsFloat := 0;
              FieldByName('ITE_PRECUS').AsFloat := FieldByName('ITE_PRECUS').AsFloat * FieldByName('ITE_QTDITE').AsFloat;

              If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
                FieldByName('ITE_QTDPEC').AsFloat := fCalculaQuantidadePecas(FieldByName('ITE_QTDITE').AsFloat,
                                                                             FieldByName('ITE_COMPEC').AsFloat,
                                                                             FieldByName('ITE_LARPEC').AsFloat,
                                                                             FieldByName('ITE_ESPPEC').AsFloat,
                                                                             fRetSiglaUnidade(FieldByName('ITE_CODUNI').AsString));
              Post;
            End;

            Break;
          End;

          Next;
        End;

        cdsDadosPedBaixados.Next;
      End;

    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message,'[pInserePedidosPendentes]');
  End;
  cdsVenda.EnableControls;

end;

procedure TFatVenda.pLiberaLockedPrismas;
  Var
    strPrisma: String;
begin
  If stlLockedPrismas.Count = 0 Then
    Exit;

  For strPrisma In stlLockedPrismas Do
    fLock_Unlock('PRISMA_'+ strPrisma, False, False);
end;

procedure TFatVenda.pCarregarDadosFulfillment;
begin

  If Not Assigned(Self.Fulfillment) Then
    Exit;

  Self.Fulfillment.EhOperacaoDeRemessa := Self.GetEnviandoMercadoriaParaLoteEstoqueExterno;
  Self.Fulfillment.ClassificacaoFiscal := Self.strClaFis;
  Self.Fulfillment.ChaveDeAcesso       := Self.strChaveAcesso;
  Self.Fulfillment.NumeroPedido        := Self.strNumOrc;
  Self.Fulfillment.EmpresaPedido       := Self.strEmpDoc;

end;

procedure TFatVenda.pCarregarDadosParaPromocaoPorKit;
  var
    LtintaDeMaquina     : ITintaDeMaquina;
    LintCont            : Integer;
    LstrCodigoPromocao  : String;
    LstrCodigoItem      : String;
    LstrPromocBackup    : String;
    LblnTemItemLinhaGrupoUnidadeEmPromo: Boolean;
    LQueryIteger        : TUniQuery;
    LintIndicePromocao  : Integer;
    bmkMarca            : TBookmark;
    dicInfEmp: TDicionario;
begin
  FcdsDadosPromocaoKit.EmptyDataset;

  cdsVenda.DisableControls;
  bmkMarca := cdsVenda.GetBookmark;
  cdsVenda.First;

  LstrPromocBackup := strPromoc;
  strPromoc := 'N';

  LQueryIteger := fCriarQueryIteGer(Self);

  while not cdsVenda.Eof do
  Begin
    if cdsVenda.FieldByName('ITE_BRINDE').AsString = 'S' then
    Begin
      cdsVenda.Next;
      Continue;
    End;

    if (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') then
      LstrCodigoItem := cdsVenda.FieldByName('ITE_ITETIN').AsString
    else
      LstrCodigoItem := cdsVenda.FieldByName('ITE_CODITE').AsString;

    if (stlItensNaoTemPromocaoKit.IndexOf(LstrCodigoItem) >= 0) then
    begin
      cdsVenda.Next;
      Continue;
    end;

    if cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR' then
    Begin
      Try
        If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
          pSetaEmpresaLogadaTinta(VS_strCodEmp)
        Else If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPPRD').AsString) Then
          pSetaEmpresaLogadaTinta(cdsVenda.FieldByName('ITE_EMPPRD').AsString)
        Else If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
          pSetaEmpresaLogadaTinta(cdsVenda.FieldByName('ITE_EMPITE').AsString);

        dicInfEmp := TDicionario.Create;
        dicInfEmp['oprflj'] := strOprFlj;
        dicInfEmp['empprd'] := fCfgSis('EMPPRD');
        dicInfEmp['emp_cd'] := fCfgSis('EMP_CD');
        dicInfEmp['Cd_S_N'] := IIF(blnEnt_CD, 'S', 'N');
        dicInfEmp['empfat'] := IIF(blnEmpFat, VS_strCodEmp, '');
        dicInfEmp['FatS_N'] := IIF(blnEmpFat, 'S', 'N');

        LtintaDeMaquina := fGetITintadeMaquina(cdsVenda, dicInfEmp);
        RecalcularTintadeMaquina(LtintaDeMaquina,
                                 cdsVenda.FieldByName('ITE_UNIORI').AsFloat,
                                 cdsVenda.FieldByName('ITE_PRECUS').AsFloat);

        LblnTemItemLinhaGrupoUnidadeEmPromo := False;
        for LintCont := 0 to LtintaDeMaquina.Count - 1 do
        Begin
          FcdsDadosPromocaoKit.Append;

          FcdsDadosPromocaoKit.FieldByName('KIT_DESCRI').AsString := LtintaDeMaquina.Descricao;
          case LtintaDeMaquina[LintCont].Tipo of
            tmctColoranteImobiliario : FcdsDadosPromocaoKit.FieldByName('KIT_TIPITE').AsString  := 'Colorantes';
            tmctBaseAutomotiva       : FcdsDadosPromocaoKit.FieldByName('KIT_TIPITE').AsString  := 'Bases Automotivas';
            tmctEmbalagemAutomotiva  : FcdsDadosPromocaoKit.FieldByName('KIT_TIPITE').AsString  := 'Embalagens Automotivas';
            tmctBaseImobiliaria      : FcdsDadosPromocaoKit.FieldByName('KIT_TIPITE').AsString  := 'Bases Imobiliárias';
          end;

          FcdsDadosPromocaoKit.FieldByName('KIT_CODITE').AsString  := LtintaDeMaquina[LintCont].CodIte;
          FcdsDadosPromocaoKit.FieldByName('KIT_GRUPO_').AsString  := fRetornaGrupoItem(LtintaDeMaquina[LintCont].CodIte);
          FcdsDadosPromocaoKit.FieldByName('KIT_UNIDAD').AsString  := fCampoTabela('ITE_CODUNI','CADITE',['ITE_CODITE'],[LtintaDeMaquina[LintCont].CodIte], False);
          FcdsDadosPromocaoKit.FieldByName('KIT_PREVEN').AsFloat   := LtintaDeMaquina[LintCont].PrecoVenda;
          FcdsDadosPromocaoKit.FieldByName('KIT_QTDGRU').AsFloat   := LtintaDeMaquina[LintCont].Quantidade * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          FcdsDadosPromocaoKit.FieldByName('KIT_ITETIN').AsString  := cdsVenda.FieldByName('ITE_ITETIN').AsString;
          FcdsDadosPromocaoKit.FieldByName('KIT_PROMOC').AsString  := 'N';

          If (fLinhaGrupoUnidadeEmPromocaoKit(FcdsDadosPromocaoKit.FieldByName('KIT_GRUPO_').AsString,
                                              FcdsDadosPromocaoKit.FieldByName('KIT_UNIDAD').AsString)) Then
          Begin
            LblnTemItemLinhaGrupoUnidadeEmPromo := True;
          End;

          LstrCodigoPromocao := fGetCodigoPromocao(cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                   LtintaDeMaquina[LintCont].CodIte,
                                                   self.Vs_Date,
                                                   LintIndicePromocao);

          if not fEmptyStr(LstrCodigoPromocao) then
          Begin
            if LintIndicePromocao = IDX_TIPO_DESCONTO_PROMOCAO[tdpPromocaoCompostaPorKit] then
              FcdsDadosPromocaoKit.FieldByName('KIT_PROKIT').AsString  := LstrCodigoPromocao
            else
              FcdsDadosPromocaoKit.FieldByName('KIT_PRONOR').AsString  := LstrCodigoPromocao;
          End;

          FcdsDadosPromocaoKit.Post;
        End;
      Finally
        pSetaEmpresaLogadaTinta(VS_strCodEmp);
      End;

      If Not LblnTemItemLinhaGrupoUnidadeEmPromo Then
        If (stlItensNaoTemPromocaoKit.IndexOf(FcdsDadosPromocaoKit.FieldByName('KIT_ITETIN').AsString) = -1) Then
          stlItensNaoTemPromocaoKit.Add(FcdsDadosPromocaoKit.FieldByName('KIT_ITETIN').AsString);
    End
    Else
    Begin
      LQueryIteger.Close;
      LQueryIteger.ParamByName('CODITE').AsString := cdsVenda.FieldByName('ITE_CODITE').AsString;
      LQueryIteger.ParamByName('CODEMP').AsString := VS_strCodEmp;
      LQueryIteger.Open;

      FcdsDadosPromocaoKit.Append;
      FcdsDadosPromocaoKit.FieldByName('KIT_CODITE').AsString  := cdsVenda.FieldByName('ITE_CODITE').AsString;
      FcdsDadosPromocaoKit.FieldByName('KIT_GRUPO_').AsString  := fRetornaGrupoItem(cdsVenda.FieldByName('ITE_CODITE').AsString);
      FcdsDadosPromocaoKit.FieldByName('KIT_UNIDAD').AsString  := cdsVenda.FieldByName('ITE_CODUNI').AsString;
      FcdsDadosPromocaoKit.FieldByName('KIT_PREVEN').AsFloat   := fPegaPrecoVenda(LQueryIteger,
                                                                                  cdsVenda.FieldByName('ITE_EMPITE').AsString,
                                                                                  cdsVenda.FieldByName('ITE_ENTSAI').AsString,
                                                                                  fltMargem,
                                                                                  (Pos('ITEM ESPECIAL', cdsVenda.FieldByName('ITE_DESITE').AsString) > 0),
                                                                                   'NOR',
                                                                                   cdsVenda.FieldByName('ITE_TABPRE').AsString);

      FcdsDadosPromocaoKit.FieldByName('KIT_QTDGRU').AsFloat   := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
      FcdsDadosPromocaoKit.FieldByName('KIT_ITETIN').AsString  := '';
      FcdsDadosPromocaoKit.FieldByName('KIT_PROMOC').AsString := 'N';

      LstrCodigoPromocao := fGetCodigoPromocao(fGetEmpPrecoPromoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString),
                                               cdsVenda.FieldByName('ITE_CODITE').AsString,
                                               self.Vs_Date,
                                               LintIndicePromocao);

      if not fEmptyStr(LstrCodigoPromocao) then
      Begin
        if LintIndicePromocao = IDX_TIPO_DESCONTO_PROMOCAO[tdpPromocaoCompostaPorKit] then
          FcdsDadosPromocaoKit.FieldByName('KIT_PROKIT').AsString  := LstrCodigoPromocao
        else
          FcdsDadosPromocaoKit.FieldByName('KIT_PRONOR').AsString  := LstrCodigoPromocao;
      End;

      If (Not fLinhaGrupoUnidadeEmPromocaoKit(FcdsDadosPromocaoKit.FieldByName('KIT_GRUPO_').AsString,
                                              FcdsDadosPromocaoKit.FieldByName('KIT_UNIDAD').AsString)) Then
      Begin
        If stlItensNaoTemPromocaoKit.IndexOf(FcdsDadosPromocaoKit.FieldByName('KIT_CODITE').AsString) = -1 Then
          stlItensNaoTemPromocaoKit.Add(FcdsDadosPromocaoKit.FieldByName('KIT_CODITE').AsString);
      End;

      FcdsDadosPromocaoKit.Post;
    End;

    cdsVenda.Next;
  End;

  cdsVenda.GotoBookmark(bmkMarca);
  cdsVenda.FreeBookmark(bmkMarca);
  cdsVenda.EnableControls;

  strPromoc := LstrPromocBackup;

  FreeAndNil(LQueryIteger);

  If Assigned(dicInfEmp) Then
    FreeAndNil(dicInfEmp);
end;

