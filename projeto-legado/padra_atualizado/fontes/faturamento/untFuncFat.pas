procedure TFatVenda.pAtualizaTemporariaItens(cdsVendaItens: TUniClientDataSet; blnUsarUniTmp: Boolean = False; blnLimparLiberacaoEstoque: Boolean = False; const blnAtualizacaoCompleta : Boolean = False;
  const blnEhCalculoParaCashback: Boolean = False);
  Var
    intContador: Integer;
    prcScroll: TprcScroll;
    intDecUni: Integer;
    fltImcSTPV : Double;
    blnCalcST : Boolean;
    fltComLiq,
    fltVlrCam: Double;
    fltTotalItem : Double;
    fltTot_RT : Double;
    objCalcComissaoVend : TCalculoComissaoVendedor;

    procedure pUniTmp;
      Var
        fltTotIteTmp : Double;
    Begin
      fltTotIteTmp := fFormataFloat(arrMatItens[intContador].fltQtdIte * arrMatItens[intContador].fltUniTmp, 2);

      {***************************************************************************}
      {* COMENTADO PORQUE ESTAVA SOMANDO O VALOR DA EMBALAGEM NO TOTAL DOS ITENS *}
      {* DEIXANDO O VALOR ERRADO. SEGUNDO RONALDO NÃO DEVERIA.                   *}
      {************************************************************************PZ*}
      //fltTotIteTmp := fFormataFloat(fltTotIteTmp + (arrMatItens[intContador].fltUniEmb * arrMatItens[intContador].fltQtdEmb), 2);

      cdsVendaItens.FieldByName('ITE_UNITAR').AsFloat  := fFormataFloat(arrMatItens[intContador].fltUniTmp, intDecUni);
      cdsVendaItens.FieldByName('ITE_TOTITE').AsFloat  := fltTotIteTmp;
    End;

    function fLocalizouItem: Boolean;
    begin
      Result := False;

      If (Self.blnExpedicaoTeveQuebraDeItensRastreaveis) And (Length(arrMatItens[intContador].strSeqDet)=20) Then
        Result := (cdsVendaItens.Locate('ITE_SEQDET', arrMatItens[intContador].strSeqDet, []));   

      If (Not Result) Then
        Result := (cdsVendaItens.Locate('AUTOINCREM;ITE_CODITE', VarArrayOf([arrMatItens[intContador].intAutInc,
                                                                             arrMatItens[intContador].strCodIte]), []));
    end;

    procedure pCalcularUNICON(const cdsCalculo: TUniClientDataSet);
    begin
      fltTotalItem := (cdsCalculo.FieldByName('ITE_UNITAR').AsFloat * cdsCalculo.FieldByName('ITE_QTDITE').AsFloat) + cdsVendaItens.FieldByName('ITE_VAL_ST').AsFloat + cdsVendaItens.FieldByName('ITE_VALIPI').AsFloat + cdsVendaItens.FieldByName('ITE_VFCPST').AsFloat + arrMatItens[intContador].fltValCBS + arrMatItens[intContador].fltValIBS + arrMatItens[intContador].fltVal_IS;
      cdsCalculo.FieldByName('ITE_UNICON').AsFloat := fFormataFloat(fltTotalItem / cdsCalculo.FieldByName('ITE_QTDITE').AsFloat, 2);
    end;

begin
  If Self.FAgrIteAplicado Then
    Exit;

  If (blnAtualizacaoCompleta) Then
    objCalcComissaoVend := Self.fCriaCalculoComissaoVendedor(strLoginUsuarioLogado);
  Try
    Try

      If (Pos(strOpcDoc,'DV_NE_') > 0) Then
        intDecUni := fMaxDecUni
      Else
        intDecUni := VS_intDecUni;

      With cdsVendaItens Do
      Begin

        pDisableControls(cdsVendaItens, prcScroll);
        First;

        For intContador := 0 To Length(arrMatItens) -1 Do
        Begin

          If fFormataFloat(arrMatItens[intContador].fltTotIte, 2) = 0 Then
            Continue;

          (***********************************************************************)
          (* EM DETERMINADO MOMENTO SAO INCLUIDOS NOVOS REGISTROS NA TEMPORARIA, *)
          (* QUANDO HA MAIS DE UMA LINHA POR ITEM PARA SER IMPRESSA.             *)
          (* NESSE MOMENTO A TEMPORARIA TEM MAIS ITENS QUE O ARRAYMATITENS       *)
          (*******************************************************************LA**)
          If fLocalizouItem Then
          Begin

            Edit;

            If (blnUsarUniTmp) Then
              pUniTmp
            Else
            Begin
              FieldByName('ITE_UNITAR').AsFloat  := fFormataFloat(arrMatItens[intContador].fltUniTar, intDecUni);
              FieldByName('ITE_TOTITE').AsFloat  := arrMatItens[intContador].fltTotIte;
            End;

            FieldByName('ITE_TOTMED').AsFloat  := arrMatItens[intContador].fltTotMed;
            FieldByName('ITE_ALQIPI').AsFloat  := arrMatItens[intContador].fltAlqIpi;
            FieldByName('ITE_BASIPI').AsFloat  := arrMatItens[intContador].fltBasIpi;
            FieldByName('ITE_VALIPI').AsFloat  := arrMatItens[intContador].fltValIpi;
            FieldByName('ABF_CODFIS').AsString := arrMatItens[intContador].strCodFis;
            FieldByName('ABF_CODMEN').AsString := arrMatItens[intContador].strCodMen;
            FieldByName('ABF_CODSIT').AsString := arrMatItens[intContador].strCodFis;
            FieldByName('ITE_PERBAS').AsFloat  := arrMatItens[intContador].fltPerBas;
            FieldByName('ITE_PEBAST').AsFloat  := arrMatItens[intContador].fltPeBaST;
            FieldByName('ITE_ALQICM').AsFloat  := arrMatItens[intContador].fltAlqIcm;
            FieldByName('ITE_BASICM').AsFloat  := arrMatItens[intContador].fltBasIcm;
            FieldByName('ITE_VALICM').AsFloat  := arrMatItens[intContador].fltValIcm;
            FieldByName('ITE_VALRET').AsFloat  := arrMatItens[intContador].fltValRet;
            FieldByName('ITE_BASRET').AsFloat  := arrMatItens[intContador].fltBasRet;
            FieldByName('ITE_ALQRET').AsFloat  := arrMatItens[intContador].fltAlqRet;
            FieldByName('ITE_PERRED').AsFloat  := arrMatItens[intContador].fltPerRed;
            FieldByName('ITE_CLAIPI').AsString := arrMatItens[intContador].strClaIpi;
            FieldByName('ITE_EXCIPI').AsString := arrMatItens[intContador].strExcIpi;
            FieldByName('ITE_LETIPI').AsString := arrMatItens[intContador].strLetIpi;
            FieldByName('ITE_ALQITE').AsString := arrMatItens[intContador].strAlqIte;
            FieldByName('ITE_DOCCNF').AsString := arrMatItens[intContador].strDocCnf;
