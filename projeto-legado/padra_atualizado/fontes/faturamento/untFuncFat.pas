                             LRefGravacao.strSelCla,
                             LRefGravacao.fltSelBas,
                             LRefGravacao.fltSelAlq,
                             LRefGravacao.fltSelVal,
                             LRefGravacao.strTriReg,
                             IIF(fEmptyStr(LRefGravacao.strCrePre), 'N', LRefGravacao.strCrePre),
                             IIF(fEmptyStr(LRefGravacao.strMonofa), 'N', LRefGravacao.strMonofa),
                             LRefGravacao.fltValIbs,
                             '',
                             LRefGravacao.strCstReg,
                             LRefGravacao.strClaReg,
                             LRefGravacao.fltAiuReg,
                             LRefGravacao.fltTiuReg,
                             LRefGravacao.fltAimReg,
                             LRefGravacao.fltTimReg,
                             LRefGravacao.fltCbsReg,
                             LRefGravacao.fltTcbReg,
                             arrMatItens[intPosMat].fltIcmPrd,
                             0,
                             arrMatItens[intPosMat].strChvRef,
                             arrMatItens[intPosMat].strIteRef,
                             nil,
                             arrMatItens[intPosMat].fltBimRet,
                             arrMatItens[intPosMat].fltAimRet,
                             LRefGravacao.blnPreenchido);

        blnGravaDetCha := False;
        strAutIncOriginal := fRetornaAutIncPedidoOrcamento(arrMatItens[intPosMat].strNumOrc,
                                                           arrMatItens[intPosMat].strEspOrc,
                                                           arrMatItens[intPosMat].strEmpOrc,
                                                           IIF(SameText(strEspDoc, 'EP'), Succ(intPosMat), arrMatItens[intPosMat].intSeqInd));

        blnGravaDetCha := fRetornaDadosFdoCha(strAutIncOriginal,
                                              arrMatItens[intPosMat].fltQtdIte,
                                              fltQtdCha,
                                              fltMedB_L,
                                              fltMedB_A,
                                              fltMedL_L,
                                              fltMedL_A,
                                              fltEspess);
        If (Not blnGravaDetCha) Then
          blnGravaDetCha := fRetornaMedidasLoteChapa(strOpcDoc,
                                                     arrMatItens[intPosMat].strCodIte,
                                                     VS_strCodEmp,
                                                     arrMatItens[intPosMat].strNumLot,
                                                     arrMatItens[intPosMat].fltQtdIte,
                                                     fltQtdCha,
                                                     fltMedB_L,
                                                     fltMedB_A,
                                                     fltMedL_L,
                                                     fltMedL_A,
                                                     fltEspess);


        If blnGravaDetCha Then
        Begin
          Result := Result And fGravaDetCha(strAutIncRet,
                                            fltQtdCha,
                                            fltMedB_L,
                                            fltMedB_A,
                                            fltMedL_L,
                                            fltMedL_A,
                                            fltEspess);
        End;

        {Envio de mercadorias para B2W, MGL, VRJ}
        If Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Then
        Begin

          If fGeraTranferenciasLT(arrMatItens[intPosMat]) Then
          Begin
            Result := Result And fGerarTLLotes(arrMatItens[intPosMat]);
          End
          Else If (Not strNumLot.IsEmpty) And (Not strNumLot.Equals('A DEFINIR')) And (Not strNumLot.Equals(GetLoteEstoqueExterno(strCodIte))) Then
          Begin
            Result := Result And TGerarTL.Execute(strCodIte,
                                                  strNumLot,
                                                  GetLoteEstoqueExterno(strCodIte),
                                                  fltQtdIte,
                                                  strNumDoc,
                                                  strEspDoc,
                                                  strEmpDoc,
                                                  strCodCli,
                                                  '',
                                                  Self.Fulfillment);
          End;

        End;

        If (Result) Then
        Begin
          If Self.Fulfillment.EhOperacaoFulfillment Then
            pGravaICMSUFDestino(strAutIncRet, 'MOVICD', arrMatItens[intPosMat])
          Else If fGravaEspelhoFundoCombateIMCeFundoCombateST(arrMatItens[intPosMat].strClaFis, arrMatItens[intPosMat].strEmpIte) Then
            pGravaICMSUFDestinoEspelho(strAutIncRet, 'MOVICD', arrMatItens[intPosMat])
          Else
          Begin
            Try
              pSetaProdutoEmbalagemNaMatriz(arrMatItens[intPosMat]);
              pCalculaGravaICMSUFDestino(strAutIncRet, 'MOVICD', arrMatItens[intPosMat]);
            Finally
              pRestauraProdutoEmbalagemNaMatriz(arrMatItens[intPosMat]);
            End;
          End;
        End;

        if (Result) and (fCfgSis('NUMSER', varBoolean)) and (StrToIntDef(strClaFis,0) > 5000) then
        begin
          If fCfgSis('NSERQT', varBoolean) And (Pos(strOpcDoc, 'OU_OF_') <= 0) Then
            pGravaMovimentoNumSerMod2(strAutIncRet, arrMatItens[intPosMat])
          Else
            pGravaMovimentoNumSer(strCodIte, VS_strCodEmp, arrMatItens[intPosMat].strNumOrc, strAutIncRet);
        end;

        If Result And (Pos(strOpcDoc, 'VN_NF_CP_') > 0) And fCfgSis('EMPCAR', varBoolean) And (strEspDocGra <> 'PR') Then
        Begin
          If ((arrMatItens[intPosMat].strEntRet = 'E') And (arrMatItens[intPosMat].strEntFut = 'N')) Or blnBaiEntFut Then
          Begin
            If arrMatItens[intPosMat].strBxSbIt = 'S' Then
            Begin
              arrEmpCarSubIte := fGetEmpCarregamentoSubIte(arrMatItens[intPosMat].strCodIte, VS_strCodEmp);

              If Length(arrEmpCarSubIte) > 0 Then
              Begin
                Result := fValidaEmpCarregamento(arrEmpCarSubIte);

                If Result Then
                Begin
                  For strEmpCarSubIte In arrEmpCarSubIte Do
                    Result := Result And fProcessaEmpCarregamento(strEmpCarSubIte, True);
                End;
              End;
            End
            Else
            Begin
              If fEmpCarPreenchidaEmpDif(arrMatItens[intPosMat].strEmpCar, VS_strCodEmp) Then
                Result := fValidaEmpCarregamento([arrMatItens[intPosMat].strEmpCar]) And
                          fProcessaEmpCarregamento(arrMatItens[intPosMat].strEmpCar, False);
            End;
          End
        End;

      End;

      If (Pos(strOpcDoc, 'DV') > 0) then
        pAtualizarDevolucaoTindorTindet( arrMatItens[intPosMat].strEspDev
                                       , IIF(fEmptyStr(strCodCliTrocadoDev), FCodCli, strCodCliTrocadoDev)
                                       , arrMatItens[intPosMat].strDocDev
                                       , arrMatItens[intPosMat].strEmpDev
                                       , arrMatItens[intPosMat].strCodIte
                                       , arrMatItens[intPosMat].strCodAca
                                       , arrMatItens[intPosMat].strEmpAca
                                       , arrMatItens[intPosMat].strCodVen
                                       , TinGer.fProducaoForaLoja(arrMatItens[intPosMat].strDocDev,
                                                                  arrMatItens[intPosMat].strEmpDev,
                                                                  arrMatItens[intPosMat].strEspDev,
                                                                  arrMatItens[intPosMat].strCodAca,
                                                                  arrMatItens[intPosMat].strEmpAca));

      If (Result) And (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) Then
      Begin
        arrMatItens[intPosMat].strAutIncDet := strAutIncRet;

        If (Pos(strOpcDoc, 'DV_PR_DD_CR_') <= 0) Then
        Begin
          objMovIte := TMovIte.Create(Self, FAuditoriaCat17, FFdoIte);
          objMovIte.pGravaMovIte(strAutIncRet, arrMatItens[intPosMat], Self.GetTipAbf(arrMatItens[intPosMat]), fTrocaUFEndEntrega);
          objMovIte.Destroy;
        End;
      End;

      {Req: 108603 - Grava "MOVCDB" somente se gravou "MOVDET", pois ocorreu erro de FK na replicação
       quando ocorre a gravação da "MOVCDB" mesmo mediante erro da "MOVDET".}
      If (Result) Then
      Begin
        If (Assigned(objCodBar)) And (objCodBar.fCodBarPreenchido) Then
        Begin
          objCodBar.pGravaMovCdb(strCodIte, strAutIncRet);
        End;
      End;

      {************************************************************************}
      {* INSERE DADOS DEPARA PARA QUANDO FOR EMITIR UMA NF DE OUTRAS ENTRADAS *}
      {* OU OUTRAS SAIDAS PARA RECEBIMENTO DE CLIENTE (GARANTIA)              *}
      {**********************************************************************FC}
      If fEhRecGarantia Then
      Begin
        TControleChavesGarantia.pInserirMovDet(arrMatItens[intPosMat].strCodIte,
                                               strAutIncRet,
                                               arrMatItens[intPosMat].fltQtdIte);
      End
      else if fEhPedidoReposicaoClienteGarantia then
      begin
          TMovGag.fInsereMovGrc(arrMatItens[intPosMat].strSeqGad, strAutIncRet, strOpcDoc, 'F', '');
      end;

      if fEhEnvioFornecedor And (Not ((fCfgSis('OUSAFO', varString) = '2') And (strEspDoc = 'NF'))) Then
      begin
        if Not TMovGad.fAtualizaAutIncEnvioGaeTemporaria(IntToStr(arrMatItens[intPosMat].intOrdIte), strAutIncRet) then
          Result := False;
      end;

      If (Result) And (blnPedGarTE) Then
      Begin
        objGarant := TMovGag.Create(Nil);
        Try
          Try
            Result := objGarant.objMovGad.fAtualizaSeqGarantia('SEQ_DET_TE', strAutIncRet, 'SEQ_FDO_TE', arrMatItens[intPosMat].strSeqDet);
          Except
            Result := False;
          End;
        Finally
          FreeAndNil(objGarant);
        End;
      End;

      If intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL Then
      Begin
        strAutIncDet := strAutIncRet;

        If Result And fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
          Result := fGravaVendaMadeira(strAutIncDet,
                                       'MOVMAD',
                                       arrMatItens[intPosMat].recMadeira);
      End;

      {*************************************************}
      {* Salva os documentos do retorno de consignação *}
      {**********************************************MM*}
      If Result And (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) Then
      Begin
        Result := fGravaMovCon(arrMatItens[intPosMat].intAutInc,
                               strAutIncRet,
                               strEspDocGra,
                               'M');
      End;

      {********************************************************}
      {* SE UTILIZA FLEX, OS PEDIDOS IMPORTADOS PELA FAITH    *}
      {* DEVEM SER RECALCULADOS E SALVOS NOVAMENTE NA MOVFLEX *}
      {*****************************************************MM*}
      If (Not fDocumentoParaFornecedor()) And
         ((fGeraFlexOpe) Or (blnDevNota) Or (strOpcDoc = 'DV')) And
         fUsaFlex(arrMatItens[intPosMat].strCodIte) Then
      Begin
        pGravarMovFlex(arrMatItens[intPosMat]);
      End;
    End;

    If (Result) And fEmptyStr(strMovLot) And 
       ((Pos(strOpcDoc, 'CP_OV_BR_VN_') > 0) or ((Pos(strOpcDoc, 'CS_') > 0) and (blnExpedi))) 
       And (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) Then
    Begin
      If (strOpcDoc = 'OV') And Assigned(objItensPedidos) Then
      Begin
        arrItemPedidos := objItensPedidos[arrMatItens[intPosMat].intAutInc];

        For recItemPedido In arrItemPedidos Do
        Begin
          If recItemPedido.fltQtdIte = 0 Then
            Continue;

          fltDesEspCalc := fCalcDescEspecialItemConfPed( recItemPedido.fltQtdOri,
                                                         recItemPedido.fltQtdBai,
                                                         recItemPedido.fltQtdIte,
                                                         recItemPedido.fltDesEsp,
                                                         recItemPedido.fltDesBai );

          Result := fAtualizaQtdBaiFatDor(recItemPedido.strNumOrc,
                                          recItemPedido.strEspOrc,
                                          recItemPedido.strEmpOrc,
                                          recItemPedido.strCodIte,
                                          recItemPedido.intSeqInd,
                                          recItemPedido.fltQtdIte,
                                          fltDesEspCalc,
                                          recItemPedido.blnEntpCD,
                                          IfThen(fUsaPedidoBaixaEntregaFutura, recItemPedido.strIncFut, ''),
                                          recItemPedido.strSeqDet);
          If Not Result Then
            Break;
        End;
      End
      Else
      Begin
        Result := fAtualizaQtdBaiFatDor(arrMatItens[intPosMat].strNumOrc,
                                        arrMatItens[intPosMat].strEspOrc,
                                        arrMatItens[intPosMat].strEmpOrc,
                                        arrMatItens[intPosMat].strCodIte,
                                        arrMatItens[intPosMat].intSeqInd,
                                        arrMatItens[intPosMat].fltQtdIte,
                                        arrMatItens[intPosMat].fltDesEsp,
                                        arrMatItens[intPosMat].blnEntpCD,
                                        IfThen(fUsaPedidoBaixaEntregaFutura, arrMatItens[intPosMat].strIncFut, ''),
                                        arrMatItens[intPosMat].strSeqDet);
      End;
    End;

  Except
    On E: EBaixaOrdemProducao Do
      Raise EBaixaOrdemProducao.Create(E.Message);
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGDadMovDet]');
    End;
  End;

  If Assigned(qryGen) Then
    FreeAndNil(qryGen);

  If Assigned(qryFut) Then
    FreeAndNil(qryFut);

  If Assigned(dicInfEmp) Then
    FreeAndNil(dicInfEmp);

end;

