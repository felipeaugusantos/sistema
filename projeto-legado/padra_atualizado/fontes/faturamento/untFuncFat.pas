function fCriaTempSepFdo(Owner: TComponent): TUniClientDataSet;
begin

  Result := TUniClientDataSet.Create(Owner);

  With Result.FieldDefs.AddFieldDef Do Begin Name := 'AUTOINCREM'; DataType := ftString; Size := 020;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_SEQFDO'; DataType := ftString; Size := 020;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_QTDITE'; DataType := ftFloat;                End; //(12, 02)
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_QTDSEP'; DataType := ftFloat;                End; //(12, 02)
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_CODSEP'; DataType := ftString; Size := 003;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_CODCON'; DataType := ftString; Size := 003;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_OPELOG'; DataType := ftString; Size := 003;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_DTASEP'; DataType := ftDate;                 End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FDO_HORSEP'; DataType := ftTime;                 End;

  Result.CreateDataSet;
end;

procedure TFatVenda.pRegravaSepFdo(strAutIncFdo, strSeqDet: String);
var
  qrySepFdo: TUniQuery;
begin
 try

    qrySepFdo := fCriaQuery(Nil);

    qrySepFdo.close;
    qrySepFdo.SQL.Clear;
    qrySepFdo.SQL.Add('SELECT * FROM SEPFDO WHERE FALSE;');
    qrySepFdo.Open;

    if Assigned(cdsSepFdo) then
    begin
      if cdsSepFdo.Locate('FDO_SEQFDO', strSeqDet, []) then
      begin
        qrySepFdo.Insert;
        qrySepFdo.fieldByName('AUTOINCREM').AsString   := fRetAutoIncrem('SEPFDO', VS_strCodEmp);
        qrySepFdo.fieldByName('FDO_SEQFDO').AsString   := strAutIncFdo;
        qrySepFdo.fieldByName('FDO_QTDITE').AsFloat    := cdsSepFdo.fieldByName('FDO_QTDITE').AsFloat;
        qrySepFdo.fieldByName('FDO_QTDSEP').AsFloat    := cdsSepFdo.fieldByName('FDO_QTDSEP').AsFloat;
        qrySepFdo.fieldByName('FDO_CODSEP').AsString   := cdsSepFdo.fieldByName('FDO_CODSEP').AsString;
        qrySepFdo.fieldByName('FDO_CODCON').AsString   := cdsSepFdo.fieldByName('FDO_CODCON').AsString;
        qrySepFdo.fieldByName('FDO_OPELOG').AsString   := cdsSepFdo.fieldByName('FDO_OPELOG').AsString;
        qrySepFdo.fieldByName('FDO_DTASEP').AsDateTime := cdsSepFdo.fieldByName('FDO_DTASEP').AsDateTime;
        qrySepFdo.fieldByName('FDO_HORSEP').AsDateTime := cdsSepFdo.fieldByName('FDO_HORSEP').AsDateTime;
        qrySepFdo.Post;
      end;
    end;
  finally
    FreeAndNil(qrySepFdo);
  end;
end;

procedure TFatVenda.pPopulaSepFdoTemp(qryGenDor: TDataSet);
var
  qrySepFdo: TUniQuery;
  strAutIncGenDor : String;
begin
  strAutIncGenDor := '';
  if Assigned(cdsSepFdo) and (qryGenDor.RecordCount <> 0) then
  begin
    qrySepFdo := fCriaQuery(Self);
    try
      qryGenDor.first;
      while not qryGenDor.Eof do
      begin
        if fEmptyStr(strAutIncGenDor) Then
          strAutIncGenDor := QuotedStr(qryGenDor.FieldByName('AUTOINCREM').AsString)
        else
          strAutIncGenDor := strAutIncGenDor + ', ' + QuotedStr(qryGenDor.FieldByName('AUTOINCREM').AsString);

        qryGenDor.next;
      end;

      if not fEmptyStr(strAutIncGenDor) then
      begin

        qrySepFdo.Close;
        qrySepFdo.SQL.Clear;
        qrySepFdo.SQL.Add('SELECT * FROM SEPFDO WHERE FDO_SEQFDO IN ( '+ strAutIncGenDor +')');
        qrySepFdo.Open;

        qrySepFdo.first;
        while not qrySepFdo.Eof do
        begin
          cdsSepFdo.Append;
          cdsSepFdo.fieldByName('AUTOINCREM').AsString   := qrySepFdo.fieldByName('AUTOINCREM').AsString;
          cdsSepFdo.fieldByName('FDO_SEQFDO').AsString   := qrySepFdo.fieldByName('FDO_SEQFDO').AsString;
          cdsSepFdo.fieldByName('FDO_QTDITE').AsFloat    := qrySepFdo.fieldByName('FDO_QTDITE').AsFloat;
          cdsSepFdo.fieldByName('FDO_QTDSEP').AsFloat    := qrySepFdo.fieldByName('FDO_QTDSEP').AsFloat;
          cdsSepFdo.fieldByName('FDO_CODSEP').AsString   := qrySepFdo.fieldByName('FDO_CODSEP').AsString;
          cdsSepFdo.fieldByName('FDO_CODCON').AsString   := qrySepFdo.fieldByName('FDO_CODCON').AsString;
          cdsSepFdo.fieldByName('FDO_OPELOG').AsString   := qrySepFdo.fieldByName('FDO_OPELOG').AsString;
          cdsSepFdo.fieldByName('FDO_DTASEP').AsDateTime := qrySepFdo.fieldByName('FDO_DTASEP').AsDateTime;
          cdsSepFdo.fieldByName('FDO_HORSEP').AsDateTime := qrySepFdo.fieldByName('FDO_HORSEP').AsDateTime;
          cdsSepFdo.Post;
          qrySepFdo.Next;
        end;
      end;
    finally
      FreeAndNil(qrySepFdo);
    end;
  end;
end;

function TFatVenda.fDevolucaoDocRegimeEspecial: Boolean;
var
  qrySelect: TUniQuery;
begin
  Result := False;

  if (Length(arrMatItens) = 0) then
    Exit;

  if (fCfgSis('EMPRES', varString) <> arrMatItens[0].strEmpDev) then
    Exit;

  qrySelect := fCriaQuery;
  try
    qrySelect.SQL.Add('SELECT COUNT(*) AS QTD');
    qrySelect.SQL.Add('FROM MOVGER');
    qrySelect.SQL.Add('LEFT JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM');
    qrySelect.SQL.Add('WHERE AUX_DOC_RE = :DOC_RE');
    qrySelect.SQL.Add('  AND AUX_ESP_RE = :ESP_RE');
    qrySelect.SQL.Add('  AND AUX_EMP_RE = :EMP_RE');

    qrySelect.ParamByName('DOC_RE').AsString := arrMatItens[0].strDocDev;
    qrySelect.ParamByName('ESP_RE').AsString := arrMatItens[0].strEspDev;
    qrySelect.ParamByName('EMP_RE').AsString := arrMatItens[0].strEmpDev;

    qrySelect.Open;

    Result := qrySelect.FieldByName('QTD').AsInteger > 0;

  finally
    FreeAndNil(qrySelect);
  end;

end;

