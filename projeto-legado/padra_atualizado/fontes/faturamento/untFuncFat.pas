begin
  Result := (Self.strPromoc = 'S') And
            (Self.blnProCnd) And
            (fDestacarDescontoDaCondicaoPagamentoNoCampoDescontoDosItensEmPromocao);
end;

function TFatVenda.fNaoPossuiLoteADefinirCadastrado(const AItem, AEmpresa: String; AProdutoAcabado: Boolean): Boolean;
begin

  If fDefiniuLoteADefinirAutomaticamente(AItem, AEmpresa) Then
    Exit(False);

  Result := ((Self.fEhEmissaoDocumentoWMS And Self.fConsiderarLoteWMS(AEmpresa)) Or Self.fEmpresaParaFaturamentoUsaWMS(AEmpresa));
  Result := Result And (Self.strIdePro = 'NOR');
  Result := Result And (Not AProdutoAcabado);
  Result := Result And (Not Self.objCadLot.fExisteLote(AItem,
                                                       IIF(Self.blnEmpFat, AEmpresa, Self.fEmpresaSaldoMatriz_CD),
                                                       'A DEFINIR',
                                                       False));

end;

function TFatVenda.fEnvioRealizadoViaNfeStatus(const strTipFC: String; const blnDefinirPontoImpressao : Boolean): Boolean;
  Var
    LPathExe : String;
    LParams : String;
    LPontoImpressao : String;
begin
  Result := False;

  If (blnExecutandoFaturadorAutomatico) And (Pos(Self.strEspDoc, 'NF_IF_') > 0) Then
  Begin
    If (Self.strEspDoc = 'IF') Then
    Begin
      If fCfgSis('PRNFCE', varBoolean) Then
        Exit;
    End
    Else
    Begin
      If VS_blnUsaPonImp then
        Exit;
    End;

    Exit(True);
  End;

  If (Not fCfgSis('EVNFES', varBoolean)) Then
    Exit;

  If (Not FileExists(ExtractFilePath(Application.ExeName) + 'NFeStatus.exe')) Then
    Exit;

  If (Not fUsaNfeImpressao(Self.strEspDoc)) Then
    Exit;

  If (strTipFC <> 'C') Then
    Exit;

  If Not Self.blnExpedi Then
    Exit;

  If (blnDefinirPontoImpressao) Then
  Begin
    LPontoImpressao := TLibNfe.fDefinirPontoDeImpressao(Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, Self.strSerFsc, Self.strCodCli);
    pAtualizaPontoImpressao(LPontoImpressao, Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, Self.strSerFsc, Self.strCodCli, 'C');
  End;

  Result := True;

  LParams := fTagComValorToParam('NFE_PROCESSAR_STATUS', consTagParamsTrf) +
             fTagComValorToParam(Self.strNumDoc,         consTagParamsDoc) +
             fTagComValorToParam(Self.strEspDoc,         consTagParamsEsp) +
             fTagComValorToParam(Self.strEmpDoc,         consTagParamsEmp) +
             fTagComValorToParam(Self.strSerFsc,         consTagParamsSer) +
             fTagComValorToParam(Self.strCodCli,         consTagParamsCli) +
             fTagComValorToParam('C',                    consTagParamsTfc) +
             fTagComValorToParam('EP',                   consTagParamsSta) +
             fTagComValorToParam(VS_PidMD5DicSis,        consTagParamsPid, mpiNaoIncluirTagSeValorVazio);

  LPathExe := ExtractFilePath(Application.ExeName) + 'NFeStatus.exe';
  LPathExe := LPathExe + LParams;
  WinExec(PAnsiChar(AnsiString(LPathExe)), SW_HIDE);
end;

function TFatVenda.fNotaEletronicaPainel(pgbProgresso: TCxProgressBar = nil): Boolean;
  Var
    blnPonImpDoc: Boolean;
    strImpressoraNFCe: String;
    strTipFC : String;
    blnEnvioRealizadoViaNfeStatus : Boolean;
    lblProgresso: TLabel;
begin
  lblProgresso := nil;
  if Assigned(pgbProgresso) then
    lblProgresso := TLabel(GetParentForm(pgbProgresso).FindComponent('lblGravando'));

  pProgresso(0, 0, pgbProgresso);

  blnPonImpDoc := False;

  pInformacao('Aguarde... Gerando Arquivo ' + fDescricaoDocumentoFiscal(strEspDoc) + ' - ' + strNumDoc + '-' + strEspDoc, pgbProgresso);

  If strEspDoc = 'IF' Then
  Begin
    If (Not fUsaIntegradorSatCitel) Then
    Begin
      blnEnvioRealizadoViaNfeStatus := fEnvioRealizadoViaNfeStatus('C', False);
      If (blnEnvioRealizadoViaNfeStatus) Then
      Begin
        Result := True;
        Exit;
      End;

      strImpressoraNFCe := '';
      //Se configurado que vai imprimir pelo "painel" entao precisa enviar o nome da impressora para a libnfe
      If fCfgSis('PRNFCE', varBoolean) Then
        strImpressoraNFCe := TLibNfe.fRetImpressoraNFCe;

      Result := fEnviarNFCeLibNfe( strNumDoc, strEspDoc, strEmpDoc, strSerFsc,
                                   strCodCli, 'C', strImpressoraNFCe, lblProgresso);

      If Result Then
      Begin
        Try
          //So deve chamar a impressao de NFCe pelo autcom caso nao esteja configurado para imprimir pelo "painel"
          If Not fCfgSis('PRNFCE', varBoolean) Then
            pImprimirNFCe(strNumDoc,
                          strEspDoc,
                          strEmpDoc,
                          strCodCli,
                          strSerFsc,
                          'C',
                          '',
                          (strOpcDoc='NC'),
                          False,
                          False,
                          Self.intViaNfe);
        Except
          fMensagem('ATENÇÃO!', 'Ocorreu um problema ao tentar imprimir o DANFE-' + fDescricaoDocumentoFiscal(strEspDoc) + '. ' + #13#10 +
                                'Por favor vá até a reimpressão de documentos, selecione o documento e com o botão direito, selecione a opção "Reimprimir DANFE".', ['&Ok']);
          Result := True;
        End;
      End;
    End
    Else
      Result := True;
  End
  Else
  Begin
    Try
      blnPonImpDoc := Not fEmptyStr(Self.strPonImp) And fEmptyStr(VS_strPonImp);

      If blnPonImpDoc Then
      Begin
        VS_blnUsaPonImp := True;
        VS_strPonImp    := Self.strPonImp;
      End;

      strTipFC := IIF(fDocumentoParaFornecedor Or (strNotImp = 'S'),'F','C');
      blnEnvioRealizadoViaNfeStatus := fEnvioRealizadoViaNfeStatus(strTipFC, True);

      If (blnEnvioRealizadoViaNfeStatus) Then
      Begin
        Result := True;
        Exit;
      End;

      Result := fEnviarNotaLibNfe( strNumDoc, strEspDoc, strEmpDoc, strSerFsc,
                                   IIF(strNotImp = 'S', strCodFor, strCodCli),
                                   strTipFC, lblProgresso);
    Finally
      If blnPonImpDoc Then
      Begin
        VS_blnUsaPonImp := False;
        VS_strPonImp    := '';
      End;
    End;

  End;
end;

function TFatVenda.fEnviarNotaEletronicaPainel(pgbProgresso: TCxProgressBar = nil): Boolean;
  Var
    blnPainel: Boolean;
begin
  pProgresso(0, 0, pgbProgresso);

  If fDeveEmitirNotaEletronica(strEspDoc, strEmpDoc, blnPainel) Then
  Begin
    If (Self.strEspDoc = 'NS') Then
    Begin
      pInformacao('Aguarde... Enviando Arquivos NFSe', pgbProgresso);
      If blnPainel Then
      Begin
        //Somente faz o envio caso nao tenha uma nota de servico anterior pendente no painel
        If Not fTemNotaServicoAnteriorPendente(strNumDoc, strEmpDoc) Then
          fNotaEletronicaPainel(pgbProgresso);
      End
      //Prestcon
      Else If fCfgSis('EMPSER') = 'SIAM' Then
        fGerarNotaServicoSIAM(strNumDoc, strEspDoc, strEmpDoc, strCodCli)
      Else
        pEnviarNotaDeServicoEletronica(strNumDoc, strEspDoc, strEmpDoc, strCodCli,
                                       strSerFsc, IIF(SameText(strOpcDoc,'OF'),'F','C'));
    End
    Else If (Self.strEspDoc = 'IF') Then
    Begin
      pInformacao('Aguarde... Enviando Arquivos NFCe', pgbProgresso);
      fNotaEletronicaPainel(pgbProgresso);
    End
    Else
    Begin
      pInformacao('Aguarde... Enviando Arquivos NFe', pgbProgresso);
      fNotaEletronicaPainel(pgbProgresso);
    End;
  End;

  If not fEmptyStr(strEntregaNumDoc) Then
  begin
    pInformacao('Aguarde... Enviando Arquivos NFe', pgbProgresso);
    pEnviarNotaEletronicaControleEntrega(pgbProgresso);
  end;

  Result := True;
end;

procedure TFatVenda.pExibirMensagemDocumentoGravado;
  Var
    dtaCaiAbe: TDateTime;
    fltSalFec: Double;
    dtaDtaFec: TDateTime;
begin
  If Self.blnFinali Then
    Exit;

  If (Pos(Self.strEspDoc, 'PD_OR') > 0) And (fEmptyStr(Self.strNumOrc) Or Self.fOrcamentoComoPedido) Then
    Self.pMensagemOrcamentoPedido;

  If (Pos(Self.strEspDoc, 'PD_OR') > 0) And (blnApenasVista) And (Copy(Self.strConPagGrav,3,3) = '000') Then
  Begin
    objResumoDeCaixa.fRetornaUltimoFechamento(fltSalFec, dtaDtaFec, strCodigoCaixa);
    If (objResumoDeCaixa.strTipoFechamento <> 'C') And (dtaDtaFec = VS_Date) Then
      pNotificacaoSistemaProblema('Atenção', 'O fechamento de caixa referente ao dia ' + FormatDateTime('dd/mm/yyyy',VS_Date) + ' já foi efetuado. Somente será permitido faturar este documento se o caixa for reaberto ou no dia seguinte.', Self.strOpcDoc)
    Else If Not objResumoDeCaixa.fNecessitaFecharCaixa(False, dtaCaiAbe, strCodigoCaixa, False) Then
      pNotificacaoSistemaProblema('Atenção', 'O caixa do dia ' + DateToStr(dtaCaiAbe) + ' ainda não foi fechado. Somente será permitido faturar este documento quando esta situação for regularizada.', Self.strOpcDoc);
  End;

  If (Self.strEspDoc = 'OR') Then
    pNotificacaoSistemaSucesso('', 'Orçamento Nº ' + Self.strNumDoc + ' gravado com sucesso!', Self.strOpcDoc)

  Else If (Self.strEspDoc = 'PD') Then
  Begin
    If (Self.fltTotGer > 0) Or (Self.fEmissaoPedidoBrinde()) Then
      pNotificacaoSistemaSucesso('', 'Pedido Nº ' + Self.strNumDoc + ' gravado com sucesso!', Self.strOpcDoc);

    If Not fEmptyStr(Self.strNumDocPDCorte) Then
      pNotificacaoSistemaSucesso('', 'Pedido de Corte de Produtos Nº ' + Self.strNumDocPDCorte + ' gravado com sucesso!', Self.strOpcDoc);

    If Not fEmptyStr(Self.strNumOS) And Self.blnGerOS Then
      pNotificacaoSistemaSucesso('', 'Ordem de Serviço Nº ' + Self.strNumOS + ' gravado com sucesso!', Self.strOpcDoc);
  End

  Else If (Self.strEspDoc = 'PR') Then
  Begin
    pNotificacaoSistemaSucesso('', 'Pedido de Devolução Nº ' + Self.strNumDoc + ' gravado com sucesso!', Self.strOpcDoc);
  End

  Else If (Self.strEspDoc = 'IF') Then
    pNotificacaoSistemaSucesso('', 'Cupom Fiscal Nº ' + Self.strNumDoc + ' gravado com sucesso!', Self.strOpcDoc)

  Else If (Self.strEspDoc = 'TE') Then
    pNotificacaoSistemaSucesso('', 'Transf. Estoque Nº ' + Self.strNumDoc + ' gravada com sucesso!', Self.strOpcDoc)

  Else If (Pos(Self.strEspDoc,fCfgSis('MGGRSU')) > 0) And (Not blnConfirmandoNotaFiscalConcreto) Then
  Begin
    If strOpcDoc = 'VS' Then
      pNotificacaoSistemaSucesso('', 'Nota de serviço ' + Self.strNumDoc + ' - ' + Self.strEspDoc + ' gravada com sucesso!' + #13#10 +
                    'Valor Total: ' + FormatFloat('#,##0.00', Self.fltTotGer), Self.strOpcDoc)
    Else
      pNotificacaoSistemaSucesso('', 'Documento: ' + Self.strNumDoc + ' - ' + Self.strEspDoc + ' gravado com sucesso!', Self.strOpcDoc);
  End;
end;

procedure TFatVenda.pExibirMensagemExpedicao;
  Var
    strMensagem : String;
begin
  If fCfgSis('EXMSPD', varBoolean) Then
  Begin
    strMensagem := '';

    If Not fEmptyStr(Self.strMenExp) Then
      strMensagem := strMensagem + Self.strMenExp + #13#10;

    If Not fEmptyStr(Self.strMenEx2) Then
      strMensagem := strMensagem + Self.strMenEx2 + #13#10;

    If Not fEmptyStr(Self.strMenEx3) Then
      strMensagem := strMensagem + Self.strMenEx3 + #13#10;

    If Not fEmptyStr(Self.strMenEx4) Then
      strMensagem := strMensagem + Self.strMenEx4 + #13#10;

    If (Not fEmptyStr(strMensagem)) Then
    Begin
      Try
        pCriarFormularios(TfrmObservacao, frmObservacao);
        frmObservacao.lblMensagem.Caption := '';
        frmObservacao.memObs.Texto := strMensagem;
        frmObservacao.ShowModal;
      Except
        On E: Exception Do
          pMensagensErro(E.Message, '[TFatVenda.pExibirMensagemExpedicao]');
      End;
      pFreeAndNil(frmObservacao);
    End;
  End;
end;

function TFatVenda.fValidaAtualizaEmailNFE(strEspDocAux: String): Boolean;

Var
  strTab,
  strCam,
  strChv,
  strRef,
  strEmailAux: String;
  chrTipCli: Char;

   Procedure pSetaVarTabela(strOpc: Char);
   Begin
     Case strOpc Of
       'C':Begin
             strTab:='CADCLI';
             strCam:='CLI_EMAIL3';
             strChv:='CLI_CODCLI';
             strRef:=Self.strCodCli;
           End;

       'F':Begin
             strTab:='CADFOR';
             strCam:='FOR_EMAIL3';
             strChv:='FOR_CODFOR';
             strRef:=Self.strCodCli;
           End;

       'S':Begin
             strTab:='CLICON';
             strCam:='CON_EMLCON';
             strChv:='CON_C_P_F_';
             strRef:=Self.strCliCgc;
           End;
     End;
   End;

   Procedure pAtualizarEmailCad(strOpc: Char; strEmail: String);
     Var
       qryUpd: TUniQuery;
   Begin
     pSetaVarTabela(strOpc);

     qryUpd := fCriaQuery;
     Try
       Try
         fStartTransaction;
         With qryUpd Do
         Begin
           SQL.Clear;
           SQL.Add('UPDATE                ');
           SQL.Add(' '+strTab+'           ');
           SQL.Add('SET                   ');
           SQL.Add(' '+strCam+' = :EMAIL3 ');
           SQL.Add('WHERE                 ');
           SQL.Add(' '+strChv+' = :CHAVE  ');
           ParamByName('CHAVE').AsString  := strRef;
           ParamByName('EMAIL3').AsString := strEmail;
           ExecSQL;
           fCommit;
         End;
       Except
         On E: Exception Do
         Begin
           fRollBack;
         End;
       End;
     Finally
       FreeAndNil(qryUpd);
     End;
   End;

begin
  Result := True;

  chrTipCli := '*';
  If fDocumentoParaFornecedor Then
  Begin
    If (strNotImp <> 'S') Then
      chrTipCli := 'F';
  End
  Else If fClienteConsumidor(fRetNomCliente(strCodCli), True, True) Then
    chrTipCli := 'S'
  Else
    chrTipCli := 'C';

  If (chrTipCli <> '*') And fEhNFE310(strEspDocAux) Then
  Begin
    strEmailAux := Self.strCliEma;

    If fEmptyStr(strEmailAux) Then
    Begin
      pSetaVarTabela(chrTipCli);
      strEmailAux := fCampoTabela(strCam, strTab, [strChv], [strRef]);
      If (chrTipCli = 'S') Then
        Self.strCliEma := strEmailAux;
    End;

    If Not fEmailValido(strEmailAux, False) Then
    Begin
      Result := False;
      If (fMensagem('ATENÇÃO!', 'Para emissão de nota fiscal é necessário um e-mail válido!' + #13#10 +
                                'Deseja informar agora?', ['&Sim', '&Não']) = 1) Then
      Begin
         Repeat
           fInputQueryTipo('', 'E-mail para emissão da NFe:', strEmailAux, ttAlfanumerico);
         Until fEmailValido(strEmailAux, False) Or ((fMensagem('ATENÇÃO!', 'E-mail inválido ou não informado!' + #13#10 + 'Deseja cancelar operação?', ['&Sim', '&Não']) = 1));

         If fEmailValido(strEmailAux, False) Then
         Begin
           Result := True;
           Self.strCliEma := strEmailAux;
           pAtualizarEmailCad(chrTipCli, strEmailAux);
         End;
      End
    End;

  End;

end;

function TFatVenda.fUltrapassouLimiteItensNFe(var strInformacao: String): Boolean;
  Var
    intIndice: Integer;
    objDesmembrar: TDesmembrarMatrizItens;
    blnEhConfirmacaoDeTeEDesmembraPorIteDoc : Boolean;
begin
  Result := False;

  If (Not fCfgSis('NFEUSA', varBoolean)) Then
    Exit;

  If (Not fCfgSis('PNLNFE', varBoolean)) Then
    Exit;

  If (Length(Self.arrMatItens) <  fCfgSis('ITEDOC', varInteger)) Then
    Exit;

  blnEhConfirmacaoDeTeEDesmembraPorIteDoc := fDesmembrarPorCFG_ITEDOC;

  If (blnEhConfirmacaoDeTeEDesmembraPorIteDoc) Then
    Exit;

  objDesmembrar := TDesmembrarMatrizItens.Create(arrMatItens, FRecSer,
    fEntregaImediataPorGrupoProdutos, fEntregaImediataPorDataDeEntrega,
    fEntregaImediataPorDataDeEntregaComRotaPorPedido,
    False, blnDesmembraPedRegEsp, EmptyStr, blnEhConfirmacaoDeTeEDesmembraPorIteDoc);
  Try
    objDesmembrar.blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    objDesmembrar.pDesmembrarMatrizItens;

    For intIndice := 0 To Length(objDesmembrar.MatrizesItens) -1 Do
    Begin
      Result := fUltrapassouLimiteItensNFe(Length(objDesmembrar.MatrizesItens[intIndice]),
                                           objDesmembrar.MatrizInfItens[intIndice],
                                           strInformacao);
      If Result Then
        Break;
    End;
  Finally
    FreeAndNil(objDesmembrar);
  End;
end;

class function TFatVenda.fUltrapassouLimiteItensNFe(intQtdItens: Integer; strTipoItens: String; var strInformacao: String): Boolean;
begin
  Result := False;

  If (fCfgSis('NFEUSA', varString) = 'S') And (fCfgSis('PNLNFE', varString) = 'S') Then
  Begin
    If (intQtdItens > fCfgSis('ITEDOC', varInteger)) Then
    Begin
      Result := True;
      strInformacao := 'A quantidade de ' + intToStr(intQtdItens) + ' itens ' +
                       IIF(fEmptyStr(strTipoItens), '', 'para "' + strTipoItens + '" ') +
                       'ultrapassou o limite para emitir NFe que é de ' + fCfgSis('ITEDOC') + ' itens!' + #13#10+
                       'Há um limite no SEFAZ referente ao tamanho do arquivo enviado. Se o arquivo passa de 500 kbytes, ' +
                       'a nota não autoriza e o painel apresenta a seguinte mensagem: "lote de nf-e maior que 500kb".';
    End;
  End;

end;

function TFatVenda.fDeveEmitirNotaEletronica(strEspecie, strEmpresa: String; Var blnPainel: Boolean): Boolean;
begin

  Result := False;
  blnPainel := False;

  {*****************************************}
  {* NOTA ELETRONICA DE SERVIÇOS.          *}
  {**************************************MV*}
  If (fCfgSis('NFESER', varBoolean, strEmpresa)) And (strEspecie = 'NS') Then
  Begin
    Result := True;
    {*****************************************}
    {* NOTA ELETRONICA DE SERVIÇOS.          *}
    {**************************************MV*}
    If (fCfgSis('NFESER', varBoolean, strEmpresa)) And
       (Pos(fCfgSis('EMPSER', varString, strEmpresa), fCfgSis('ENPAIN', varString, strEmpresa)) > 0) Then
    Begin
      blnPainel := True;
    End;
  End;

  {*****************************************}
  {* NOTA ELETRONICA ATRAVEZ DO PAINEL.    *}
  {**************************************MV*}
  If (fCfgSis('NFEUSA', varBoolean, strEmpresa)) And
     (fCfgSis('PNLNFE', varBoolean, strEmpresa)) And
     (Pos(strEspecie, 'NF_EL_') > 0)             And
     (blnGerNFE)                                 And
     (Not blnImportacaoSpedPisCofins)            Then
  Begin
    Result := True;
    blnPainel := True;
  End;

  {*****************************************}
  {* NOTA ELETRONICA CONSUMIDOR            *}
  {**************************************MV*}
  If (fCfgSis('NFEUSA', varBoolean, strEmpresa)) And
     (fCfgSis('USNFCE', varBoolean, strEmpresa)) And
     (Pos(strEspecie, 'IF_IV_') > 0)                And
     (Not blnImportacaoSpedPisCofins)            Then
  Begin
    Result := True;
    blnPainel := True;
  End;

  {*****************************************}
  {* NOTA ELETRONICA CONSUMIDOR            *}
  {**************************************MV*}
  If fUsaSat(strEmpresa) And
     (Pos(strEspecie, 'IF_IV_') > 0)             And
     (Not blnImportacaoSpedPisCofins)            Then
  Begin
    Result := True;
    blnPainel := True;
  End;
end;

