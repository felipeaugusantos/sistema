                                        intSeqConRcx,
                                        strNomeForm,
                                        strCredito_Id_Loc,
                                        strCredito_Id_Doc,
                                        strPorBaiAut,
                                        strCtaBaiAut,
                                        strHisBaiAut,
                                        strCodigoCaixa,  //Codigo do Caixa
                                        Self.fltTotCredAutomatico,
                                        Self.strAutIncFatGor,
                                        fEhVendaNormalNegociadaUtilizandoCreditoComBaixaDeDuplicataAVista,
                                        LPortadorCreditoPix);
    End;

  Except
    On E: Exception Do
    Begin
      fltValDin := fltBkpDin;
      fltValCqP := fltBkpCqP;
      fltValCqV := fltBkpCqV;
      fltValCar := fltBkpCar;
      fltValOrd := fltBkpOrd;
      fltValFin := fltBkpFin;

      Result := False;
      pMensagensErro(E.Message, '[fGCadRec]');
    End;
  End;

  fltValDin := fltBkpDin;
  fltValCqP := fltBkpCqP;
  fltValCqV := fltBkpCqV;
  fltValCar := fltBkpCar;
  fltValOrd := fltBkpOrd;
  fltValFin := fltBkpFin;
end;

procedure TFatVenda.pDesmembrarRecebimentoPorModalidade(const strAutIncCadRec, strRecebidoPorPix : String; const dtaDtaRec: TDateTime; var strAutoIncrensCadRec : String; const APortadorAdtCredito : String = ''; const AValorAdtCredito : Double = 0);
  Var
    arrCadRecs : TStringArray;
    strCadRec : String;
    strPortadorTfDesmembCadRec : String;
    strAutoIncremChavePix : String;
    LPixDao : TPixDao;
begin
  If (fCfgSis('DESMRC', varString) = 'N') Then
    Exit;
  If (dtaDtaRec = 0) Then
    Exit;
  strPortadorTfDesmembCadRec := Self.FPortadorTFAutomatica;
  If strRecebidoPorPix = 'S' Then
  Begin
    strAutoIncremChavePix := EmptyStr;
    If (Assigned(Self.DadosPixDaVenda.ObjetoPixPago)) Then
      strAutoIncremChavePix := Self.DadosPixDaVenda.ObjetoPixPago.AutoIncremChavePix;
    If (Not fEmptyStr(strAutoIncremChavePix)) Then
    Begin
      LPixDao := TPixDao.Create;
      Try
        strPortadorTfDesmembCadRec := LPixDao.RetornaPortadorChavePix(strAutoIncremChavePix);
      Finally
        FreeAndNil(LPixDao);
      End;
    End;
  End;
  arrCadRecs := DesmembraDuplicatasPorEspecie(strAutIncCadRec, strPortadorTfDesmembCadRec, 0, 0, APortadorAdtCredito, AValorAdtCredito);
  For strCadRec In arrCadRecs Do
  Begin
    If fEmptyStr(strCadRec) Then
      Continue;
    If fEmptyStr(strAutoIncrensCadRec) Then
      strAutoIncrensCadRec := '"' + strCadRec + '"'
    Else
      strAutoIncrensCadRec := strAutoIncrensCadRec + ',' +  '"' + strCadRec + '"';
  End;
end;

procedure TFatVenda.pGravaNumeroSerieConfirmacaoDocumento(strAutIncMovDet, strAutIncNotDet: String);
var
  qryNumeroSerie: TUniQuery;
begin
  if fEmptyStr(strAutIncMovDet) then
    Exit;

  if fEmptyStr(strAutIncNotDet) then
    Exit;

  qryNumeroSerie := fCriaQuery;

  try
    qryNumeroSerie.Close;
    qryNumeroSerie.SQL.Clear;
    qryNumeroSerie.SQL.Add('UPDATE DETSER');
    qryNumeroSerie.SQL.Add('SET SER_SEQNOT = :SEQNOT');
    qryNumeroSerie.SQL.Add('WHERE SER_SEQGER = :SEQGER');

    qryNumeroSerie.ParamByName('SEQNOT').AsString := strAutIncNotDet;
    qryNumeroSerie.ParamByName('SEQGER').AsString := strAutIncMovDet;

    qryNumeroSerie.ExecSQL;
  finally
    FreeAndNil(qryNumeroSerie);
  end;
end;

function TFatVenda.fMontaHistoricoDupsCredito: String;
  Var
    qryAux: TUniQuery;
    stlDupl: TStringList;
begin

  qryAux := fCriaQuery();
  stlDupl:= TStringList.Create;
  try

    If (stlDupCreditos.Count <= 0) Then
    Begin
      Result := '';
      Exit;
    End;

    stlDupl.Text := StringReplace(stlDupCreditos.Text, Chr(39), '', [rfReplaceAll]);

    if fCfgSis('BXADSN', varBoolean) then
    begin
      Result := 'TOTAL DOS CRÉDITOS UTILIZADOS: ' + FormatFloat('###,###,##0.00', fltTotCredAutomatico);
    end
    else
    begin
      Result := 'DOCS DE CRED: ';
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT                                                           ');
      qryAux.SQL.Add('  CONCAT(DUPLICATA, " R$ ", VALOR) AS DUPLICATA                  ');
      qryAux.SQL.Add('FROM                                                             ');
      qryAux.SQL.Add('  (SELECT                                                        ');
      qryAux.SQL.Add('    CONCAT(                                                      ');
      qryAux.SQL.Add('      CTR_NUMDUP,                                                ');
      qryAux.SQL.Add('      "-",                                                       ');
      qryAux.SQL.Add('      CTR_ESPDOC,                                                ');
      qryAux.SQL.Add('      "-",                                                       ');
      qryAux.SQL.Add('      CTR_CODEMP                                                 ');
      qryAux.SQL.Add('    ) AS DUPLICATA,                                              ');
      qryAux.SQL.Add('    CAST(                                                        ');
      qryAux.SQL.Add('      FORMAT(CTR_VALORI, 2, "de_DE") AS CHAR(20)                 ');
      qryAux.SQL.Add('    ) AS VALOR                                                   ');
      qryAux.SQL.Add('  FROM                                                           ');
      qryAux.SQL.Add('    CADREC                                                       ');
      qryAux.SQL.Add('  WHERE AUTOINCREM IN (' + fCommaText(stlDupl, True) + ')) AS TMP ');
      qryAux.SQL.Add('LIMIT 2;                                                         ');
      qryAux.Open;

      While (Not qryAux.Eof) Do
      Begin
        Result := Result + qryAux.FieldByName('DUPLICATA').AsString + ' / ';
        qryAux.Next;
      End;
      Result := Copy(Result, 1, Length(Result)-1);

    end;

  finally
    FreeAndNil(qryAux);
    FreeAndNil(stlDupl);
  end;

end;

