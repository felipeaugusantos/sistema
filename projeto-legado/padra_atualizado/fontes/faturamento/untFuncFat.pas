function TFatVenda.fImprimeDuplicatasCnfe: Boolean;
  Var
    qryCnf: TUniQuery;
    strRetorno: String;
begin
  {*********************************************************************}
  {* CASO CFOP '5917','6917', NÃO IMPRIME INFORMAÇÕES DAS DUPLICATAS   *}
  {******************************************************************RN*}
  If MatchStr(strClaFis, ['5917', '6917']) Then
  Begin
    Result := False;
    Exit;
  End;

  Result := True;

  qryCnf := fCriaQuery(Self);
  qryCnf.SQL.Text := 'SELECT * FROM CNF_NFE WHERE CNF_SETOR_ = "02" AND CNF_CODEMP = ' + QuotedStr(VS_strCodEmp) + ' ORDER BY CNF_IDENTI ';
  qryCnf.Open;

  If Not qryCnf.IsEmpty Then
  Begin
    { FUNC MACRO }
    pInicializaVariaveis;

    lstVariaveis.Clear;

    Try
      strRetorno := fProcessaMacro(Self, nil, qryCnf.FieldByName('CNF_DESCAM').AsString);
    Except
      On E: Exception Do
      Begin
        strRetorno := '0';
        pGravaErroCNF(E);
      End;
    End;

    Result := (StrToIntDef(strRetorno, 0) = 1);

    lstVariaveis.Clear;
  End;

  FreeAndNil(qryCnf);
end;

function TFatVenda.fVerificaTranspDoctoDifEndEntrega: String;
begin
  If blnNovoFechamentoOrcamentoPedido And Self.strCodTra.IsEmpty Then
    Self.strCodTra := Self.strCodTraOrc;

  Result := Self.strCodTra;

  if Self.fRecebidoPorPix then
