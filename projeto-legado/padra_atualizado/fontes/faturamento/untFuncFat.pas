procedure TFatVenda.pExecutaAtualizaQtdBaiFatDor(strSQL: String;
                                                 blnConfPed: Boolean;
                                                 strNumOrc,
                                                 strEspOrc,
                                                 strEmpOrc,
                                                 strCodIte: String;
                                                 intSeqInd: Integer;
                                                 fltQtdBai: Double;
                                                 fltDesBai: Double;
                                                 blnEntpCD: Boolean;
                                                 strIncFut: String;
                                                 strAutInc: String);
Var
  intContador: Integer;
  qryGenDor  : TUniQuery;
begin
  qryGenDor := fCriaQuery(Self);
  try
    qryGenDor.Close;
    qryGenDor.SQL.Clear;
    qryGenDor.SQL.Add(strSQL);

    If (strConfSer = 'S') Then
    Begin

      For intContador := Low(arrPedidos) To High(arrPedidos) Do
      Begin
        qryGenDor.ParamByName('QTDBAI').AsFloat   := 1;
        if Assigned(qryGenDor.FindParam('DESBAI')) then
          qryGenDor.ParamByName('DESBAI').AsFloat   := 0;
        qryGenDor.ParamByName('NUMDOC').AsString  := arrPedidos[intContador].strNumPed;
        qryGenDor.ParamByName('ESPDOC').AsString  := arrPedidos[intContador].strEspPed;
        qryGenDor.ParamByName('CODEMP').AsString  := arrPedidos[intContador].strEmpPed;
        qryGenDor.ParamByName('CODITE').AsString  := strCodIte;

        If (fUsaPedidoBaixaEntregaFutura) And (Not fEmptyStr(strIncFut)) Then
          qryGenDor.ParamByName('INCFUT').AsString  := strIncFut;

        qryGenDor.ParamByName('SEQIND').AsInteger := -1;

        qryGenDor.ExecSQL;
      End;

    End
    Else If (blnConfPed) Then
    Begin

      For intContador := Low(arrPedidosConf) To High(arrPedidosConf) Do
      Begin
        qryGenDor.ParamByName('QTDBAI').AsFloat   := 1;
        if Assigned(qryGenDor.FindParam('DESBAI')) then
          qryGenDor.ParamByName('DESBAI').AsFloat   := 0;
        qryGenDor.ParamByName('NUMDOC').AsString  := arrPedidosConf[intContador].strNumPed;
        qryGenDor.ParamByName('ESPDOC').AsString  := arrPedidosConf[intContador].strEspPed;
        qryGenDor.ParamByName('CODEMP').AsString  := arrPedidosConf[intContador].strEmpPed;
        qryGenDor.ParamByName('CODITE').AsString  := strCodIte;

        If (fUsaPedidoBaixaEntregaFutura) And (Not fEmptyStr(strIncFut)) Then
          qryGenDor.ParamByName('INCFUT').AsString  := strIncFut;

        qryGenDor.ParamByName('SEQIND').AsInteger := -1;

        qryGenDor.ExecSQL;
      End;

    End
    Else
    Begin
      qryGenDor.ParamByName('QTDBAI').AsFloat   := fltQtdBai;
      if Assigned(qryGenDor.FindParam('DESBAI')) then
        qryGenDor.ParamByName('DESBAI').AsFloat   := fltDesBai;
      qryGenDor.ParamByName('NUMDOC').AsString  := strNumOrc;
      qryGenDor.ParamByName('ESPDOC').AsString  := strEspOrc;
      qryGenDor.ParamByName('CODEMP').AsString  := strEmpOrc;
      qryGenDor.ParamByName('CODITE').AsString  := strCodIte;

      If (fUsaPedidoBaixaEntregaFutura) And (Not fEmptyStr(strIncFut)) Then
        qryGenDor.ParamByName('INCFUT').AsString  := strIncFut;

      If (Not fEmptyStr(strAutInc)) Then
        qryGenDor.ParamByName('AUTINC').AsString := strAutInc;

      qryGenDor.ParamByName('SEQIND').AsInteger := intSeqInd;

      qryGenDor.ExecSQL;
    End;
  finally
    FreeAndNil(qryGenDor);
  end;
end;

function TFatVenda.fAtualizaQtdBaiFatDor(strNumOrc,
                                         strEspOrc,
                                         strEmpOrc,
                                         strCodIte: String;
                                         intSeqInd: Integer;
                                         fltQtdBai: Double;
                                         fltDesBai: Double;
                                         blnEntpCD: Boolean;
                                         strIncFut: String = '';
                                         strSeqDet: String = ''): Boolean;
  Var
    intContador: Integer;
    blnNovo    : Boolean;
    blnConfPed : Boolean;
    strSQL     : String;
    strLisSeqIndDup : String;
    strAutInc  : String;
    qryGen     : TUniQuery;

    function fVerificaSeqIndDuplicado: Boolean;
    begin
      Result := (strConfSer <> 'S') And (Not blnConfPed) And (Length(strSeqDet) = 20);
    end;

Begin
  Try
    If (Self.blnReutilizarOrcamento) Then
      Exit(True);

    blnConfPed := ((Length(arrPedidosConf) > 0) And (strEspDoc = 'NS') And (strOpcDoc = 'CP') And (strConfSer <> 'S'));

    strAutInc := '';

    {*******************************************}
    {* GERA RESUMO DOS PEDIDOS                 *}
    {****************************************MV*}
    If (Length(arrPedidos) = 0) And (Not blnConfPed) Then
      blnNovo := True
    Else
      blnNovo := False;

    For intContador := Low(arrPedidos) To High(arrPedidos) Do
    Begin
      blnNovo := True;

      If (arrPedidos[intContador].strNumPed = strNumOrc) And
         (arrPedidos[intContador].strEspPed = strEspOrc) And
         (arrPedidos[intContador].strEmpPed = strEmpOrc) Then
      Begin
        blnNovo := False;

        Break;
      End;
    End;

    If (blnNovo) Then
    Begin
      strLisSeqIndDup := '';

      If (fVerificaSeqIndDuplicado) Then
      Begin
        qryGen := fCriaQuery(Nil);
        Try
          qryGen.SQL.Text :=
              ' SELECT CONCAT(FDO_CODITE, FDO_SEQIND) FROM FATDOR '+
              ' WHERE FDO_NUMDOC = :NUMDOC                        '+
              '   AND FDO_ESPDOC = :ESPDOC                        '+
              '   AND FDO_CODEMP = :CODEMP                        '+
              '   AND FDO_SEQIND >= 1                             '+
              ' GROUP BY FDO_SEQGER, FDO_CODITE, FDO_SEQIND       '+
              ' HAVING COUNT(*) > 1                               ';
          qryGen.ParamByName('NUMDOC').AsString := strNumOrc;
          qryGen.ParamByName('ESPDOC').AsString := strEspOrc;
          qryGen.ParamByName('CODEMP').AsString := strEmpOrc;
          qryGen.Open;

          qryGen.First;
          While Not qryGen.Eof Do
          Begin
            pIncrementaListaStr(qryGen.Fields[0].AsString, strLisSeqIndDup);
            qryGen.Next;
          End;
        Finally
          FreeAndNil(qryGen);
        End;
      End;

      pIncluirNaMatrizDePedidos(arrPedidos, strNumOrc, strEspOrc, strEmpOrc, blnEntpCD, strLisSeqIndDup);
    End;

    If (fVerificaSeqIndDuplicado) Then
    Begin
      For intContador := Low(arrPedidos) To High(arrPedidos) Do
      Begin
        If (arrPedidos[intContador].strNumPed = strNumOrc) And
           (arrPedidos[intContador].strEspPed = strEspOrc) And
           (arrPedidos[intContador].strEmpPed = strEmpOrc) And
           (Pos(Concat(strCodIte, intSeqInd.ToString), arrPedidos[intContador].strLisSeqIndDup) > 0) Then
        Begin
          strAutInc := strSeqDet;

          Break;
        End;
      End;
    End;

    strSQL := '';
    strSQL := strSQL + 'UPDATE ';
    strSQL := strSQL + '  FATDOR FD INNER JOIN EXTDOR ED ON FD.AUTOINCREM = ED.FDO_SEQFDO ';
    strSQL := strSQL + 'SET ';
    strSQL := strSQL + '  FD.FDO_QTDBAI = IFNULL(FD.FDO_QTDBAI, 0) + :QTDBAI, ';
    strSQL := strSQL + '  FD.FDO_DESBAI = IFNULL(FD.FDO_DESBAI, 0) + :DESBAI  ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FD.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  FD.FDO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  FD.FDO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  FD.FDO_CODITE = :CODITE AND ';

    If (fUsaPedidoBaixaEntregaFutura) And (Not fEmptyStr(strIncFut)) Then
      strSQL := strSQL + '  ED.FDO_INCFUT = :INCFUT AND ';

    If (Not fEmptyStr(strAutInc)) Then
      strSQL := strSQL + '  FD.AUTOINCREM = :AUTINC AND ';

    strSQL := strSQL + '  FD.FDO_SEQIND = :SEQIND ';

    pExecutaAtualizaQtdBaiFatDor(strSQL,
                                 blnConfPed,
                                 strNumOrc,
                                 strEspOrc,
                                 strEmpOrc,
                                 strCodIte,
                                 intSeqInd,
                                 fltQtdBai,
                                 fltDesBai,
                                 blnEntpCD,
                                 strIncFut,
                                 strAutInc);

    if not fEmptyStr(strNumLotSep) then
    begin
      strSQL := '';
      strSQL := strSQL + 'UPDATE ROMLIT RI ';
      strSQL := strSQL + 'INNER JOIN ROMLDE ON RLI_SEQRLD = ROMLDE.AUTOINCREM ';
      strSQL := strSQL + 'INNER JOIN ROMLGE ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
      strSQL := strSQL + 'INNER JOIN FATDOR FD ON FD.AUTOINCREM = RI.RLI_SEQFDO ';
      strSQL := strSQL + 'INNER JOIN EXTDOR ED ON FD.AUTOINCREM = ED.FDO_SEQFDO ';
      strSQL := strSQL + 'SET RLI_QTDBAI = IFNULL(RLI_QTDBAI, 0) + :QTDBAI, ';
      strSQL := strSQL + '    RLI_JAFATU = IF(IFNULL(RLI_QTDBAI, 0) + :QTDBAI = RLI_QTDSEP, 1, 0) ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  RLG_NUMLOT IN("' + (StringReplace(strNumLotSep, ',', '","', [rfReplaceAll])) +'") AND ';
      strSQL := strSQL + '  RLG_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  FD.FDO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  FD.FDO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  FD.FDO_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  FD.FDO_CODITE = :CODITE AND ';

      If (fUsaPedidoBaixaEntregaFutura) And (Not fEmptyStr(strIncFut)) Then
        strSQL := strSQL + '  ED.FDO_INCFUT = :INCFUT AND ';

      If (Not fEmptyStr(strAutInc)) Then
        strSQL := strSQL + '  FD.AUTOINCREM = :AUTINC AND ';

      strSQL := strSQL + '  FD.FDO_SEQIND = :SEQIND ';

      pExecutaAtualizaQtdBaiFatDor(strSQL,
                                   blnConfPed,
                                   strNumOrc,
                                   strEspOrc,
                                   strEmpOrc,
                                   strCodIte,
                                   intSeqInd,
                                   fltQtdBai,
                                   fltDesBai,
                                   blnEntpCD,
                                   strIncFut,
                                   strAutInc);
    end;

    Result := True;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[fAtualizaQtdBaiFatDor]');
      Result := False;
    End;
  End;

end;

