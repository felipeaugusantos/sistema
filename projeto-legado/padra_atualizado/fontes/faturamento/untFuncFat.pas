              fltTot_RT := arrMatItens[intContador].fltRT_Ori * arrMatItens[intContador].fltQtdIte;
              arrMatItens[intContador].fltTotCom := ((arrMatItens[intContador].fltPerCom * (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp - fltTot_RT)) / 100);
              FieldByName('GRU_PERCOM').AsFloat := arrMatItens[intContador].fltPerCom;
              FieldByName('ITE_COMVEN').AsFloat := arrMatItens[intContador].fltTotCom;
              FieldByName('ITE_PRECU2').AsFloat := arrMatItens[intContador].fltTotCu2 / FieldByName('ITE_QTDITE').AsFloat;
              FieldByName('ITE_TOTCU2').AsFloat := arrMatItens[intContador].fltTotCu2;
              FieldByName('ITE_BFCPST').AsFloat := arrMatItens[intContador].VisualizarFcpIcmsST.fltBase;
              FieldByName('ITE_PFCPST').AsFloat := arrMatItens[intContador].VisualizarFcpIcmsST.fltAliquota;
              FieldByName('ITE_VFCPST').AsFloat := arrMatItens[intContador].VisualizarFcpIcmsST.fltValor;
              FieldByName('ITE_VAL_ST').AsFloat := arrMatItens[intContador].fltValRet;
              FieldByName('ITE_VALCBS').AsFloat := arrMatItens[intContador].fltValCBS;
              FieldByName('ITE_VALIBS').AsFloat := arrMatItens[intContador].fltValIBS;
              FieldByName('ITE_VAL_IS').AsFloat := arrMatItens[intContador].fltVal_IS;
              FieldByName('ITE_VLRCON').AsFloat := FieldByName('ITE_TOTITE').AsFloat + FieldByName('ITE_VAL_ST').AsFloat + FieldByName('ITE_VALIPI').AsFloat + FieldByName('ITE_VFCPST').AsFloat + FieldByName('ITE_VALCBS').AsFloat + FieldByName('ITE_VALIBS').AsFloat + FieldByName('ITE_VAL_IS').AsFloat;

              If blnEhCalculoParaCashback Then
                pCalcularUNICON(cdsVendaItens)
              Else
                pCalcularUNICON(cdsVenda);
            End;

            Post;
          End;

          Next;
        End;

        pEnableControls(cdsVendaItens, prcScroll);

      End;

    Except
      On E: Exception Do
      Begin
        pEnableControls(cdsVendaItens, prcScroll);
        Raise Exception.create('pAtualizaTemporariaItens ' + E.message);
      End;
    End;
  Finally
    If (blnAtualizacaoCompleta) Then
      FreeAndNil(objCalcComissaoVend);
  End;
end;

