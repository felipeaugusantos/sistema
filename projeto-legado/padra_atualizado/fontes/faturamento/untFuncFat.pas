procedure pRemoverTravaLogAviPRMIN(strCodIte: String; intAutInc: Integer; var strNTrava: String);
  Const
    arrTraPrm: Array Of String = ['PRMIN','PRMIN2','PRMIN3','PRMIN4','PRMIN5','PRMIN6'];
  Var
    intArr: Integer;
    intLog: Integer;
    arrLogAviNovo: TArrLogAvi;
    stlTravaRemov: TStringList;
    blnRemoveStrNTrava: Boolean;

  procedure pAddTrava(recLogAvi: TLogAvi);
  begin
    SetLength(arrLogAviNovo, Length(arrLogAviNovo) + 1);
    arrLogAviNovo[Length(arrLogAviNovo) - 1] := recLogAvi;
  end;

begin
  If (Length(arrLogAvi) = 0) Then
    Exit;

  stlTravaRemov := TStringList.Create;
  stlTravaRemov.Sorted := True;
  stlTravaRemov.Duplicates := dupIgnore;
  Try
    SetLength(arrLogAviNovo, 0);

    For intLog := Low(arrLogAvi) To High(arrLogAvi) Do
    Begin
      If (MatchStr(arrLogAvi[intLog].strDirAce, arrTraPrm)) And
         (Not fSomenteAvisaPoisVaiTravarNoFinalVenda(arrLogAvi[intLog].strDirAce)) And
         (arrLogAvi[intLog].strCodIte = strCodIte) And
         (arrLogAvi[intLog].intAutInc = intAutInc) Then
      Begin
        stlTravaRemov.Add(arrLogAvi[intLog].strDirAce);
      End
      Else
      Begin
        pAddTrava(arrLogAvi[intLog]);
      End;
    End;
  Finally
    arrLogAvi := arrLogAviNovo;

    For intLog := 0 To stlTravaRemov.Count-1 Do
    Begin
      If (MatchStr(stlTravaRemov[intLog], arrTraPrm)) Then
      Begin
        blnRemoveStrNTrava := True;

        For intArr := Low(arrTraPrm) To High(arrTraPrm) Do
        Begin
          blnRemoveStrNTrava := blnRemoveStrNTrava And (Not fLogAviExists(arrTraPrm[intArr]));
          If (Not blnRemoveStrNTrava) Then
            Break
        End;

        If blnRemoveStrNTrava Then
        Begin
          For intArr := Low(arrTraPrm) To High(arrTraPrm) Do
          Begin
            pRemoverDirAceStringNTrava(arrTraPrm[intArr], strNTrava);
          End;
        End;
      End;
    End;

    FreeAndNil(stlTravaRemov);
  End;
end;

procedure pRemoverTravaLogAvi(strDirAce: String; Var strNTrava: String);
  Var
    intCont: Integer;
    arrLogAviNovo: TArrLogAvi;

  procedure pAddTrava(recLogAvi: TLogAvi);
  begin
    SetLength(arrLogAviNovo, Length(arrLogAviNovo) + 1);
    arrLogAviNovo[Length(arrLogAviNovo) - 1] := recLogAvi;
  end;

begin
  SetLength(arrLogAviNovo, 0);

  For intCont := Low(arrLogAvi) To High(arrLogAvi) Do
  Begin
    if Pos(strDirAce, arrLogAvi[intCont].strDirAce) = 0 then
      pAddTrava(arrLogAvi[intCont]);
  End;

  arrLogAvi := arrLogAviNovo;

  pRemoverDirAceStringNTrava(strDirAce, strNTrava);
end;

