    strNomCidEnt := fRetNomCidade(strCidEnt);

    If fEmptyStr(strNomCidEnt) Then
      strNomCidEnt := strCidEnt;

    Result := strEndEnt + ' - ' + strBaiEnt + ' - ' + strNomCidEnt + ' - ' + strEstEnt;
  End;
end;

