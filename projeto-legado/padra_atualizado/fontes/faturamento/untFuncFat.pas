    procedure pSetaProdutoEmbalagemNaMatriz(Var AItemFechamento: TDadosFechamento);
    begin
      strProEmbSav := '';

      If (strProEmb <> 'S') Then
        Exit;

      strProEmbSav := AItemFechamento.strProEmb;
      AItemFechamento.strProEmb := strProEmb;
    end;

    procedure pRestauraProdutoEmbalagemNaMatriz(Var AItemFechamento: TDadosFechamento);
    begin
      If (strProEmb <> 'S') Then
        Exit;

      If fEmptyStr(strProEmbSav) Then
        Exit;

      AItemFechamento.strProEmb := strProEmbSav;
    end;

    procedure pAtualizaCodAcaTinDet(strAutIncTdt, strCodAca, strEmpAca: String);
      Var
        qryAux: TUniQuery;
    begin
      If Not fEmptyStr(strAutIncTdt) Then
      Begin
        qryAux := fCriaQuery(Nil);
        qryAux.SQL.Add('UPDATE ');
        qryAux.SQL.Add('  TINDET ');
        qryAux.SQL.Add('SET ');
        qryAux.SQL.Add('  DET_CODACA = :CODACA, ');
        qryAux.SQL.Add('  DET_EMPACA = :EMPACA ');
        qryAux.SQL.Add('WHERE ');
        qryAux.SQL.Add('  AUTOINCREM = :AUTINC ');

        qryAux.ParamByName('CODACA').AsString := strCodAca;
        qryAux.ParamByName('EMPACA').AsString := strEmpAca;
        qryAux.ParamByName('AUTINC').AsString := strAutIncTdt;
        qryAux.ExecSQL;

        FreeAndNil(qryAux);
      End;
    end;

