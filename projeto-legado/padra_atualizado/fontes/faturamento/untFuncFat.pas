function TFatVenda.fExisteTintaComPromocaoVencidaNoPedido(strNumDoc, strEspDoc, strCodEmp, strCodCli, strCodIte: String; var fltPrecoVenda: Double; var stlDocs: TStringList): Boolean;
var
  qryAux: TUniQuery;
  dicRetorno: TDicionario;
  strCodAca: String;
  strEmpAca: String;
  strTabPed : String;
  strTabelaTinta: String;
  intContador: Integer;
  blnExisteItemVencido: Boolean;
begin
  Result := False;
  blnExisteItemVencido := False;

  If Not (Pos(strEspDoc, 'PD_OR_') > 0) Then
    Exit;

  If Not Assigned(pTintaRetornaTabelaPreco) Then
    Exit;

  dicRetorno := TDicionario.Create;
  qryAux := fCriaQuery(Self);

  Try
    qryAux.SQL.Clear;
    qryAux.SQL.Add('  SELECT                                                            ');
    qryAux.SQL.Add('  FATDOR.FDO_PROMOC, FATDOR.FDO_CODACA, FATDOR.FDO_EMPACA, FORTIN.FOR_FATACE, TINDOR.*, FORTIN.*  ');
    qryAux.SQL.Add('  FROM FATDOR                                                       ');
    qryAux.SQL.Add('    INNER JOIN TINDOR ON TINDOR.FDO_SEQGER = FATDOR.FDO_SEQGER AND  ');
    qryAux.SQL.Add('                         TINDOR.FDO_CODITE = FATDOR.FDO_CODITE AND  ');
    qryAux.SQL.Add('                         FATDOR.FDO_CODEMP = TINDOR.FDO_CODEMP AND  ');
    qryAux.SQL.Add('                         FATDOR.FDO_CODACA = TINDOR.FDO_CODACA AND  ');
    qryAux.SQL.Add('                         FATDOR.FDO_EMPACA = TINDOR.FDO_EMPACA      ');
    qryAux.SQL.Add('    INNER JOIN FORTIN ON FORTIN.FOR_CODACA = TINDOR.FDO_CODACA AND  ');
    qryAux.SQL.Add('                         FORTIN.FOR_EMPACA = TINDOR.FDO_EMPACA      ');
    qryAux.SQL.Add('  WHERE FATDOR.FDO_NUMDOC = :NUMDOC                                 ');
    qryAux.SQL.Add('    AND FATDOR.FDO_ESPDOC = :ESPDOC                                 ');
    qryAux.SQL.Add('    AND FATDOR.FDO_CODEMP = :CODEMP                                 ');
    qryAux.SQL.Add('    AND FATDOR.FDO_CODCLI = :CODCLI                                 ');
    qryAux.SQL.Add('    AND FATDOR.FDO_PROMOC = "S"                                     ');

    If not fEmptyStr(strCodIte) Then
      qryAux.SQL.Add('  AND FATDOR.FDO_CODITE = :CODITE ');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;

    If not fEmptyStr(strCodIte) Then
      qryAux.ParamByName('CODITE').AsString := strCodIte;

    qryAux.Open;

    If not qryAux.IsEmpty Then
    Begin
      stlDocs.Clear;

      strTabelaTinta := fTabelaPrecoTinta(strCodCli, '', '', False, False, False);

      strTabPed := Self.strTabPre;
      dicRetorno['tabpre'] := strTabelaTinta;

      pCarregarClientePedidoOrcamento(Self, strCodEmp);

      Self.strTabPre := strTabPed;

      pPegaDadosFiscais(fTrocaUFEndEntrega, strCliIes, strMicEmp, fGetUFEmpresa(''), True);

      While (Not qryAux.Eof) Do
      Begin
        strCodAca := qryAux.FieldByName('FDO_CODACA').AsString;
        strEmpAca := qryAux.FieldByName('FDO_EMPACA').AsString;

        dicRetorno.Limpar;

        If cdsVenda.Locate('ITE_CODACA;ITE_EMPACA', VarArrayOf([strCodAca, strEmpAca]), []) Then
        Begin
          dicRetorno['idepro'] := qryAux.FieldByName('FDO_IDEPRO').AsString;
          dicRetorno['montad'] := qryAux.FieldByName('FDO_MONTAD').AsString;
          dicRetorno['a_n_o_'] := qryAux.FieldByName('FDO_A_N_O_').AsString;
          dicRetorno['itetin'] := qryAux.FieldByName('FDO_ITETIN').AsString;
          dicRetorno['tippre'] := qryAux.FieldByName('FDO_TIPPRE').AsString;
          dicRetorno['itebas'] := qryAux.FieldByName('FDO_CODITE').AsString;
          dicRetorno['coddil'] := qryAux.FieldByName('FDO_CODDIL').AsString;
          dicRetorno['pordil'] := qryAux.FieldByName('FDO_PORDIL').AsFloat;
          dicRetorno['iteemb'] := cdsVenda.FieldByName('ITE_ITEEMB').AsString;
          dicRetorno['empite'] := cdsVenda.FieldByName('ITE_EMPITE').AsString;

          If fEmptyStr(dicRetorno['empite']) then
            dicRetorno['empite'] := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

          If fEmptyStr(dicRetorno['empite']) then
            dicRetorno['empite'] := qryAux.FieldByName('FDO_CODEMP').AsString;

          dicRetorno['codemp'] := dicRetorno['empite'];

          If cdsVenda.FieldByName('ITE_VOLPRO').AsFloat = 0 Then
            dicRetorno['volpro'] := 1
          Else
            dicRetorno['volpro'] := cdsVenda.FieldByName('ITE_VOLPRO').AsFloat;
          If qryAux.FindField('FDO_LINLIN') <> Nil Then
            dicRetorno['linha_'] := qryAux.FieldByName('FDO_LINLIN').AsString
          Else If qryAux.FindField('FDO_LINTIN') <> Nil Then
            dicRetorno['linha_'] := qryAux.FieldByName('FDO_LINTIN').AsString
          Else
            dicRetorno['linha_'] := '';

          dicRetorno['qtdemb'] := qryAux.FieldByName('FDO_QTDITE').AsFloat;
          dicRetorno['descri'] := qryAux.FieldByName('FDO_DESCRI').AsString;
          dicRetorno['complementob'] := qryAux.FieldByName('FOR_ITECOB').AsString;
          dicRetorno['tipcor'] := qryAux.FieldByName('FOR_TIPCOR').AsString;
          dicRetorno['catali'] := qryAux.FieldByName('FDO_CATALI').AsString;
          dicRetorno['oprflj'] := strOprFlj;
          dicRetorno['empprd'] := fCfgSis('EMPPRD');
          dicRetorno['emp_cd'] := fCfgSis('EMP_CD');
          dicRetorno['Cd_S_N'] := IIF(blnEnt_CD, 'S', 'N');
          dicRetorno['empfat'] := IIF(blnEmpFat, VS_strCodEmp, '');
          dicRetorno['FatS_N'] := IIF(blnEmpFat, 'S', 'N');

          For intContador := 1 To 20 Do
          Begin
            If fEmptyStr(qryAux.FieldByName('FDO_FORM' + fStrZero(intContador, 2)).AsString) Then
              Break;

            dicRetorno['base' + fStrZero(intContador, 2)] := qryAux.FieldByName('FDO_FORM' + fStrZero(intContador, 2)).AsString;
            dicRetorno['qtdb' + fStrZero(intContador, 2)] := qryAux.FieldByName('FDO_QTDB' + fStrZero(intContador, 2)).AsFloat /
                                                             qryAux.FieldByName('FDO_QTDITE').AsFloat;
          End;

          dicRetorno['tabpre'] := strTabelaTinta;
          dicRetorno.AdicionarObjeto('calculadorFatVendas', TFatVendasCalculadorWrapper.Create(Self));

          If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
            pSetaEmpresaLogadaTinta(VS_strCodEmp)
          Else If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPPRD').AsString) Then
            pSetaEmpresaLogadaTinta(cdsVenda.FieldByName('ITE_EMPPRD').AsString)
          Else If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
            pSetaEmpresaLogadaTinta(cdsVenda.FieldByName('ITE_EMPITE').AsString);

          Try
            try
              pTintaRetornaTabelaPreco(dicRetorno, qryAux.FieldByName('FOR_FATACE').AsFloat);
            except
              on E: EAbort do
              begin
                blnFecharForm := True;
                raise Exception.CreateFmt('Não foi possível determinar a formulação para a tinta: [%s]', [qryAux.FieldByName('FDO_DESCRI').AsString]);
              end;

              on E: Exception do
              begin
                blnFecharForm := True;
                raise Exception.CreateFmt(E.Message,[]);
              end;
            end;
          Finally
            pSetaEmpresaLogadaTinta(VS_strCodEmp);
          End;

          If not fEmptyStr(strTabelaTinta) Then
            fltPrecoVenda := IfNull(dicRetorno['preve' + strTabelaTinta], 0.0);

          Result := IIF(fEmptyStr(qryAux.FieldByName('FDO_PROMOC').AsString), 'N', qryAux.FieldByName('FDO_PROMOC').AsString) <>
                    IIF(fEmptyStr(IfNull(dicRetorno['promoc'], 'N')), 'N', IfNull(dicRetorno['promoc'], 'N'));

          If Result Then
          Begin
            If not blnExisteItemVencido Then
            Begin
              blnExisteItemVencido := True;
            End;

            stlDocs.Add(qryAux.FieldByName('FDO_CODITE').AsString + ' - ' +  qryAux.FieldByName('FDO_DESCRI').AsString);
          End;
        End;

        qryAux.Next;
      End;
    End;

  Finally
    Result := blnExisteItemVencido;
    FreeAndNil(dicRetorno);
    FreeAndNil(qryAux);
  End;
end;

procedure TFatVenda.pMontaMensagemUsoConsumo(cdsItensVen: TUniClientDataSet;
                                             objMsg     : TMensagemLiberacao);
var
  objTabela : TRegistroMsgLiberaTabela;
  objLinha  : TLinhaMsgLibera;
begin
  objTabela := TRegistroMsgLiberaTabela.Create;
  objLinha  := TLinhaMsgLibera.Create;
  objLinha.enuTipoLinha := tlCabecalho;
  objLinha.pAddColuna(''  , 'Cod.'      , fTamCodIte, alEsquerda, teAutcom);
  objLinha.pAddColuna(''  , 'Descrição' , 50        , alEsquerda, teAutcom);
  objLinha.pAddColuna(''  , 'Unidade'   , 7         , alEsquerda, teAutcom);
  objLinha.pAddColuna(''  , 'Quantidade', 10        , alDireita , teAutcom);
  objLinha.pAddColuna(''  , 'Vl.Unit'   , 12        , alDireita , teAutcom);
  objLinha.pAddColuna(''  , 'Vl.Total'  , 12        , alDireita , teAutcom);

  objTabela.lstLinhas.Add(objLinha);

  cdsItensVen.First;
  while not cdsItensVen.Eof do
  begin
    objLinha  := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlValor;
    objLinha.pAddColuna('Cod.'       , cdsItensVen.FieldByName('ITE_CODITE').AsString                                                         , fTamCodIte, alEsquerda );
    objLinha.pAddColuna('Descrição'  , cdsItensVen.FieldByName('ITE_DESITE').AsString                                                         , 50        , alEsquerda );
    objLinha.pAddColuna('Unidade'    , Copy(cdsItensVen.FieldByName('ITE_SIGUNI').AsString,1,4)                                               , 7         , alEsquerda );
    objLinha.pAddColuna('Quantidade' , FloatToStrf(cdsItensVen.FieldByName('ITE_QTDITE').AsFloat, ffFixed, 11, fCfgSis('DECQTD', varInteger)) , 10        , alDireita  );
    objLinha.pAddColuna('Vl.Unit'    , FloatToStrf(cdsItensVen.FieldByName('ITE_UNIDIG').AsFloat, ffFixed, 11, 2)                             , 12        , alDireita  );
    objLinha.pAddColuna('Vl.Total'   , FloatToStrf(cdsItensVen.FieldByName('ITE_TOTITE').AsFloat, ffFixed, 11, 2)                             , 12        , alDireita  );
    objTabela.lstLinhas.Add(objLinha);

    cdsItensVen.Next;
  End;

  objMsg.pAddQuebra;
  objMsg.lstRegistros.Add(objTabela);

end;

function TFatVenda.fBloqueiaTrocaDeEnderecoParaPrecoDeVendaComDifal: Boolean;
Begin
  Result := False;

  If not assigned(objEndEnt) Then
    Exit;

  If not fUsaPrecoDeVendaComDifal Then
    Exit;

  If not fAtendeRegrasDifal(False) Then
    Exit;

  If not objEndEnt.recEndere.blnAltera Then
    Exit;

  If fEmptyStr(Self.enderecoEntrega.strEstEnt) Then
    Exit;

  If fEmptyStr(objEndEnt.recEndere.strEstEnt) Then
    Exit;

  Result := (Self.enderecoEntrega.strEstEnt <> objEndEnt.recEndere.strEstEnt);
End;

function TFatVenda.fRecalcularDIFAL: TAlterouUFEntrega;
Begin
  If (fMensagem('ATENÇÃO!', 'O sistema está configurado para embutir o valor do difal ao valor dos produtos (CFG_EMBDFL)' +#13+
                            'e o estado foi alterado ao escolher o endereço de entrega.' +#13+#13+
                            'Estado do endereço principal cliente: ' + Self.enderecoEntrega.strEstEnt +#13+
                            'Estado do endereço de entrega escolhido: ' + objEndEnt.recEndere.strEstEnt +#13+#13+
                            'Com a mudança do estado, o difal deve ser recalculado e por consequência, o preço de venda.' +#13+
                            'O que deseja fazer?',
                           ['&Recalcular os preços e finalizar',
                            '&Abortar e escolher outro endereço'],
                            2,
                            False,
                            1,
                            300,
                            False,
                            0,
                            False,
                            False,
                            False,
                            150,
                            650,
                            8) = 1) Then
    Result := opRecalcularDifal
  Else
    Result := opAbortarOperacao;
End;

function TFatVenda.fRetornaTipFre:string;
  Var
    qryGen: TUniQuery;
    strTabGer: String;
begin
  If fTabelaExiste(Self.strTmpIteDev) Then
  Begin
    Try
      qryGen := fCriaQuery;

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(' SELECT ');
        SQL.Add('  DET_SEQGER, ');
        SQL.Add('  DET_TABELA, ');
        SQL.Add('  DET_TOTFRE, ');
        SQL.Add('  DET_TIPFRE  ');
        SQL.Add(' FROM ');
        SQL.Add('  ' + Self.strTmpIteDev + ' ');
        Open;

        First;
        While Not Eof Do
        Begin
          strTabGer := '';
          If (Pos(FieldByName('DET_TABELA').Text, 'MOVDET_NOTDET_') > 0) Then
            strTabGer := IIF((FieldByName('DET_TABELA').Text = 'MOVDET'), 'MOVGER', 'NOTGER');

          If (FieldByName('DET_TOTFRE').Value > 0) Then
          Begin
            Result := FieldByName('DET_TIPFRE').Text;
            Break;
          End
          Else If (strTabGer<>'') Then
          Begin
            If (fCampoTabela('GER_TOTFRE', strTabGer, ['AUTOINCREM'], [FieldByName('DET_SEQGER').Text]) > 0) Then
            Begin
              Result := fCampoTabela('GER_TIPFRE', strTabGer, ['AUTOINCREM'], [FieldByName('DET_SEQGER').Text]);
              Break;
            End;
          End;
          Next;
        End;

      End;

    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;


function TFatVenda.fRetCreditoPedido: String;
var
  qryCreditos: TUniQuery;
  intContador: integer;
  strAutInc: string;
  strPedidos: string;
begin
  qryCreditos := fCriaQuery;

  try
    Result := EmptyStr;
    strPedidos := EmptyStr;

    if Self.strEspDoc <> 'NF' Then
      Exit;

    for intContador := Low(arrMatItens) to High(arrMatItens) do
    begin
      if fEmptyStr(arrMatItens[intContador].strNumOrc) then
        Continue;

      strAutInc := fCampoTabela('AUTOINCREM','FATGOR',['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'],[arrMatItens[intContador].strNumOrc, arrMatItens[intContador].strEspOrc, arrMatItens[intContador].strEmpOrc]);
      pIncrementaListaStr(strAutInc, strPedidos, True, True, ',', False, True);
    end;

    if fEmptyStr(strPedidos) then
      Exit;

    qryCreditos.Close;
    qryCreditos.SQL.Clear;
    qryCreditos.SQL.Add('SELECT C.CTR_NUMDUP, C.CTR_ESPDOC, C.CTR_CODEMP, V.ADT_VALADT');
    qryCreditos.SQL.Add('FROM CADREC C');
    qryCreditos.SQL.Add('INNER JOIN VALADT V');
    qryCreditos.SQL.Add('ON(C.AUTOINCREM = V.ADT_SEQCTR)');
    qryCreditos.SQL.Add('WHERE V.ADT_SEQFGO IN ('+strPedidos+')');
    qryCreditos.Open;

    if qryCreditos.IsEmpty then
      Exit;

    while not qryCreditos.Eof do
    begin
      Result := Result + qryCreditos.FieldByName('CTR_NUMDUP').AsString + '-' +
                         qryCreditos.FieldByName('CTR_ESPDOC').AsString + '-' +
                         qryCreditos.FieldByName('CTR_CODEMP').AsString + '-' +
                         FormatFloat('#,##0.00', qryCreditos.FieldByName('ADT_VALADT').AsFloat);

      if qryCreditos.RecNo < qryCreditos.RecordCount then
        Result := Result + ' \ ';

      qryCreditos.Next;
    end;
  finally
    FreeAndNil(qryCreditos);
  end;
end;

procedure TFatVenda.pAdicionaItensLiberacaoBrinde(const AObjMsg: TMensagemLiberacao;
  const ACdsItens: TUniClientDataSet);
Var
  prcScrollItens : TprcScroll;
  LStrLinha      : String;
Begin
  Try
