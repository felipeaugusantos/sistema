  fltTotalCof := 0;
  fltTotalBasPis := 0;
  fltTotalBasCof := 0;

  fltTotIMPRetSer := 0;
  fltTotPISRetSer := 0;
  fltTotCOFRetSer := 0;
  fltTotCSSRetSer := 0;

  For intCont := Low(arrLivFis) To High(arrLivFis) Do
  Begin
    fltTotIMPRetSer := fltTotIMPRetSer + arrLivFis[intCont].fltIrSeRt;
    fltTotPISRetSer := fltTotPISRetSer + arrLivFis[intCont].fltPiSeRt;
    fltTotCOFRetSer := fltTotCOFRetSer + arrLivFis[intCont].fltCoSeRt;
