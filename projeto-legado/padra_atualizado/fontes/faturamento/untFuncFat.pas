procedure TFatVenda.pPreencheMatrizComColorantesParaTransferencia;
 Var
   intIndiceColorante: integer;
   qryCadIte: TUniQuery;
   qryIteger: TUniQuery;
   strTabPreLocal: string;
   strClaFisLocal: string;
   strTabPreLocalSecundaria : String;
   strClaFisLocalSecundaria : String;
   intIndIte: Integer;
   fltValor: Double;
begin
  qryCadIte := fCriaQuery;
  qryIteger := fCriaQuery;
  strTabPreLocalSecundaria := '';
  strClaFisLocalSecundaria := '';

  Try
    For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
    begin
      If (fEmptyStr(strTabPreLocalSecundaria)) Then
      Begin
        strTabPreLocalSecundaria := arrMatItens[intIndIte].strTabPre;
        strClaFisLocalSecundaria := arrMatItens[intIndIte].strClaFis;
      End;

      if (arrMatItens[intIndIte].strIdePro <> 'NOR') and (fEmptyStr(arrMatItens[intIndIte].strCodAca)) then
      begin
        strTabPreLocal := arrMatItens[intIndIte].strTabPre;
        strClaFisLocal := arrMatItens[intIndIte].strClaFis;
        Break;
      end;
    end;

    If fEmptyStr(strTabPreLocal) Then
      strTabPreLocal := strTabPreLocalSecundaria;

    If fEmptyStr(strClaFisLocal) Then
      strClaFisLocal := strClaFisLocalSecundaria;

    qryCadIte.Close;
    qryCadIte.SQL.Clear;
    qryCadIte.SQL.Add('SELECT * FROM CADITE WHERE ITE_CODITE = :CODITE');

    qryIteger.Close;
    qryIteger.SQL.Clear;
    qryIteger.SQL.Add('SELECT * FROM ITEGER WHERE ITE_CODITE = :CODITE AND ITE_CODEMP = :CODEMP');


    objSolColorantesTE.cdsItens.First;
    stlColorante.Sort;
    while not objSolColorantesTE.cdsItens.Eof do
    begin
      if stlColorante.Find(objSolColorantesTE.cdsItens.FieldByName('CODITE').AsString,intIndiceColorante) then
      begin
        qryCadIte.Close;
        qryCadIte.ParamByName('CODITE').AsString := objSolColorantesTE.cdsItens.FieldByName('CODITE').AsString;
        qryCadIte.Open;

        qryIteger.Close;
        qryIteger.ParamByName('CODITE').AsString := objSolColorantesTE.cdsItens.FieldByName('CODITE').AsString;
        qryIteger.ParamByName('CODEMP').AsString := objSolColorantesTE.cdsItens.FieldByName('CODEMP').AsString;
        qryIteger.Open;

        If fEmptyStr(strTabPreLocal) Then
          strTabPreLocal := '1';

        fltValor := qryIteger.FieldByName('ITE_PREVE'+strTabPreLocal).AsFloat;

        SetLength(arrMatItens, Length(arrMatItens) + 1);
        arrMatItens[Length(arrMatItens) - 1].intAutInc := Length(arrMatItens);

        arrMatItens[Length(arrMatItens) - 1].strCodIte := objSolColorantesTE.cdsItens.FieldByName('CODITE').AsString;
        arrMatItens[Length(arrMatItens) - 1].strDesIte := objSolColorantesTE.cdsItens.FieldByName('DESCRI').AsString;
        arrMatItens[Length(arrMatItens) - 1].fltTotCus := qryIteger.FieldByName('ITE_PRECUS').AsFloat * objSolColorantesTE.cdsItens.FieldByName('QTDITE').AsFloat;
        arrMatItens[Length(arrMatItens) - 1].fltQtdIte := objSolColorantesTE.cdsItens.FieldByName('QTDITE').AsFloat;
        arrMatItens[Length(arrMatItens) - 1].fltPesoIt := qryCadIte.FieldByName('ITE_PESOIT').AsFloat;
        arrMatItens[Length(arrMatItens) - 1].fltPesLiq := qryCadIte.FieldByName('ITE_PESLIQ').AsFloat;
        arrMatItens[Length(arrMatItens) - 1].strIdePro := 'NOR';
        arrMatItens[Length(arrMatItens) - 1].fltUniOri := fltValor;
        arrMatItens[Length(arrMatItens) - 1].fltUnitar := fltValor;
        arrMatItens[Length(arrMatItens) - 1].strCodGru := qryCadIte.FieldByName('ITE_CODGRU').AsString;
        arrMatItens[Length(arrMatItens) - 1].strRefere := qryCadIte.FieldByName('ITE_REFERE').AsString;
        arrMatItens[Length(arrMatItens) - 1].strCodMar := qryCadIte.FieldByName('ITE_CODMAR').AsString;
        arrMatItens[Length(arrMatItens) - 1].strCodUni := qryCadIte.FieldByName('ITE_CODUNI').AsString;
        arrMatItens[Length(arrMatItens) - 1].fltUniDig := fltValor;
        arrMatItens[Length(arrMatItens) - 1].fltUniVis := fltValor;
        arrMatItens[Length(arrMatItens) - 1].fltTotIte := fltValor * objSolColorantesTE.cdsItens.FieldByName('QTDITE').AsFloat;
        arrMatItens[Length(arrMatItens) - 1].strClaFis := arrMatItens[Length(arrMatItens) - 2].strClaFis;
        arrMatItens[Length(arrMatItens) - 1].strCodFor := qryCadIte.FieldByName('ITE_CODFOR').AsString;
        arrMatItens[Length(arrMatItens) - 1].strEmpSol := objSolColorantesTE.cdsItens.FieldByName('CODEMP').AsString;
        arrMatItens[Length(arrMatItens) - 1].blnPodAlt := True;
        arrMatItens[Length(arrMatItens) - 1].fltQtdSol := objSolColorantesTE.cdsItens.FieldByName('QTDITE').AsFloat;
        arrMatItens[Length(arrMatItens) - 1].strClaFis := strClaFisLocal;
      end;
      objSolColorantesTE.cdsItens.Next;
    end;
  Finally
    FreeAndNil(qryCadIte);
    FreeAndNil(qryIteger);
  End;
end;

