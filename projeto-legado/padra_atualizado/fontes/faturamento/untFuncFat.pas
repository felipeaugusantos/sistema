function TFatVenda.fDeveGravarXMLCNF : Boolean;
begin
  Result := False;
  If (Self.strOpcDoc = 'NC') Then
    Exit;
  If (Assigned(Self.FFulfillment)) Then
  Begin
    If (Self.FFulfillment.EhOperacaoFulfillment) Then
      Exit;
  End;
  Result := True;
end;

function TFatVenda.fGravaNotFicDocumentoFiscal: Boolean;
begin
  Result := True;

  if Pos(strEspDoc, 'NF_IF_NS_') = 0 then
    Exit(False);

  if Pos(strOpcDoc, 'EM_FE_NG_OF_DV_GF_') > 0 then
    Exit(False);

  if (strOpcDoc = 'NE') and (fDocumentoParaFornecedor) then
    Exit(False);
end;

function TFatVenda.fGravaNotFicPesquisaDeSatisfacao: Boolean;
begin
  Result := True;

  if Pos(strEspDoc, 'NF_IF_NS_FF_') = 0 then
    Exit(False);

  if Pos(strOpcDoc, 'EM_FE_NG_OF_DV_GF_') > 0 then
    Exit(False);

  if (strOpcDoc = 'NE') and (fDocumentoParaFornecedor) then
    Exit(False);
end;

function TFatVenda.fAjustaDataParaDiaUtilCfgCSDFTA(dtaDataAjuste: TDateTime): TDateTime;
begin
  Result := dtaDataAjuste;

  If (Not fCfgSis('CSDFTA', varBoolean)) Then
    Exit;

  While fEhSabadoDomingoFeriado(dtaDataAjuste, strCodCid) Do
    dtaDataAjuste := IncDay(dtaDataAjuste, 1);

  Result := dtaDataAjuste;
end;

procedure TFatVenda.pAddNotificacao(objNotificacoes: TCriarNotificacoes);
var
  objNotificacao: TNotificacao;
  strAutInc,
  strGrupoGatilho,
  strGatilho: String;

  arrGrupoGatilhos: TArray<String>;
  arrGatilhos: TArray<String>;

  intCountGrupo: Integer;
  intCount: Integer;
begin
  strGatilho := EmptyStr;
  strGrupoGatilho := EmptyStr;

  if (fGravaNotFicDocumentoFiscal) and (not fEmptyStr(FAutIncCadFis)) then
  begin
    strAutInc := Self.FAutIncCadFis;
    strGrupoGatilho := 'AN_BN_';
  end
  else if (strEspDoc = 'FF') then
  begin
    strAutInc := Self.strAutInc;
    strGrupoGatilho := 'FF_';
  end
  else if (strEspDoc = 'OR') then
  begin
    strAutInc := Self.strAutIncFatGor;
    strGrupoGatilho := 'OR_';
  end;

  if fGravaNotFicPesquisaDeSatisfacao then
    strGrupoGatilho := strGrupoGatilho + 'CL_';

  if (FobjControleCashback.fPermiteUtilizarRotinaCashback) And (MatchStr(strEspDoc, ARR_DOCUMENTOS_GERACAO_CASHBACK)) And
     (Not fClienteFilial(Self.strCodCli)) And (fValorCashGeradoVenda(strNumDoc, strEspDoc, strEmpDoc) > 0) then
    strGrupoGatilho := strGrupoGatilho + 'CH_';

  if fEmptyStr(strGrupoGatilho) then
    Exit;

  arrGrupoGatilhos := strGrupoGatilho.Split(['_']);

  for intCountGrupo:=0 to Length(arrGrupoGatilhos)-1 do
  begin
    strGatilho := EmptyStr;

    if arrGrupoGatilhos[intCountGrupo] = 'AN' then
      strGatilho := 'AT_EF_XE_ET_';

    if arrGrupoGatilhos[intCountGrupo] = 'BN' then
    begin
      if not fDocumentoImprimeBoleto then
        Continue;

      strGatilho := EmptyStr;
      SetLength(arrGatilhos, 0);
    end;

    if arrGrupoGatilhos[intCountGrupo] = 'CL' then
      strGatilho := 'PS_';

    if arrGrupoGatilhos[intCountGrupo] = 'OR' then
      strGatilho := 'EA_A1_A2_A3_';


    if arrGrupoGatilhos[intCountGrupo] = 'CH' then
    begin
      if fEmptyStr(fVencimentoCashGeradoVenda(strNumDoc, strEspDoc, strEmpDoc)) then
        Continue;

      strGatilho := '7A_';
    end;

    arrGatilhos := strGatilho.Split(['_']);
    if Length(arrGatilhos) = 0 then
    begin
      SetLength(arrGatilhos, 1);
      arrGatilhos[0] := EmptyStr;
    end;

    for intCount:=0 to Length(arrGatilhos)-1 do
    begin
      objNotificacao := TNotificacao.Create;
      objNotificacao.strAutInc := IIF((arrGrupoGatilhos[intCountGrupo] = 'CL') and (strGatilho = 'PS_'), Self.strAutInc, strAutInc);
      objNotificacao.strGrupoGatilho := arrGrupoGatilhos[intCountGrupo];
      objNotificacao.strGatilh := arrGatilhos[intCount];
      objNotificacao.strCodCli := strCodCli;
      objNotificacao.strCliNom := strCliNom;
      objNotificacao.strCliOri := strCliOri;
      objNotificacao.strCliCel := strCliCel;
      objNotificacao.strEspDoc := strEspDoc;

      If (arrGatilhos[intCount] = '7A') Then
      Begin
        objNotificacao.strAutInc := fCampoTabela('AUTOINCREM', 'VENCSH', ['VCB_NUMDOC', 'VCB_ESPDOC', 'VCB_CODEMP'], [strNumDoc, strEspDoc, strEmpDoc]);
        objNotificacao.dtaAgeDta := fCampoTabela('DATE_ADD(VCB_DTAVAL, INTERVAL -7 DAY)',
                                                  'VENCSH',
                                                  ['VCB_NUMDOC', 'VCB_ESPDOC', 'VCB_CODEMP'],
                                                  [strNumDoc, strEspDoc, strEmpDoc]);
        If (objNotificacao.dtaAgeDta < Date) Then
          objNotificacao.dtaAgeDta := Date;

        objNotificacao.timAgeHor := StrToTime('08:00:00');
      End;

      objNotificacoes.pAddNotificacao(objNotificacao);
    end;
  end;
end;

function TFatVenda.fDocumentoImprimeBoleto: Boolean;
var
  intContador: Integer;
  objDocumento: TDadosImpressaoVenda;
begin
  Result := False;

  for intContador := 0 to objFatVendaImp.ItemsCount -1 do
  begin
    objDocumento := objFatVendaImp[intContador];

    if (objDocumento.strNumDoc <> Self.strNumDoc) then
      Continue;

    if (objDocumento.strEspDoc <> Self.strEspDoc) then
      Continue;

    if (objDocumento.strEmpDoc <> Self.strEmpDoc) then
      Continue;

    if (objDocumento.strCodCli <> Self.strCodCli) then
      Continue;

    Result := TFatVendaImp.fVerificaSeImprimeBoleto(objDocumento);

    if Result then
      Break;
  end;
end;

procedure TFatVenda.pGravaNotificacaoPesquisaOpiniOne;
var
  intIndIte: Integer;
  blnTemItemEntrega: Boolean;
begin
  if not fCfgSis('UTIOPI', varBoolean) then
    Exit;

  blnTemItemEntrega := False;
  if (fGravaNotFicDocumentoFiscal) or (strEspDoc = 'FF') then
  begin
    for intIndIte := Low(arrMatItens) to High(arrMatItens) do
    begin
      blnTemItemEntrega := fItemEntrega(arrMatItens[intIndIte]);
      if blnTemItemEntrega then
        Break;
    end;

    TControllerOpiniOneCadastroDestinatario.pGravaNotificacaoPesquisa(Self.strAutInc, Self.strCodCli, blnTemItemEntrega);
  end;
end;

procedure TFatVenda.pGeraAlqIcmAnt;
  Var
    intPosAtual : Integer;
    intContador : Integer;
    intContador2: Integer;
    intContador3: Integer;
    intTamMat   : Integer;
    stlOrdena   : TStringList;
    arrAlqIcmNov: Array Of TResumoIcmAnt;
begin

  If (Pos(strClaFis, VS_strClaVen) <= 0) Then
    Exit;

  Try
    stlOrdena := TStringList.Create;
    stlOrdena.Sorted := True;
    stlOrdena.Duplicates := dupIgnore;

    For intContador2 := 0 To Length(arrMatItens) -1 Do
    Begin

      intTamMat := Length(arrAlqIcmAnt);
      intPosAtual := -1;

      If strCliOrg = 'S' Then
      Begin

        For intContador := 0 To intTamMat -1 Do
        Begin

          If (arrAlqIcmAnt[intContador].fltAlqIcm = arrMatItens[intContador2].fltAlqAnt) Then
          Begin
            intPosAtual := intContador;
            Break;
          End;

        End;

        If intPosAtual < 0 Then
        Begin
          SetLength(arrAlqIcmAnt, intTamMat + 1);
          intPosAtual := intTamMat;
        End;

        stlOrdena.Add(fStrZero(FloatToStr(arrMatItens[intContador2].fltAlqAnt),2));
        arrAlqIcmAnt[intPosAtual].fltAlqIcm := arrMatItens[intContador2].fltAlqAnt;
        arrAlqIcmAnt[intPosAtual].fltBasIcm := fFormataFloat(arrAlqIcmAnt[intPosAtual].fltBasIcm + arrMatItens[intContador2].fltBIcAnt, 2);
        arrAlqIcmAnt[intPosAtual].fltValIcm := fFormataFloat(arrAlqIcmAnt[intPosAtual].fltValIcm + arrMatItens[intContador2].fltIcmAnt, 2);

      End
      Else
      Begin

        For intContador := 0 To intTamMat -1 Do
        Begin

          If (arrAlqIcmAnt[intContador].fltAlqIcm = arrMatItens[intContador2].fltAlqIcm) Then
          Begin
            intPosAtual := intContador;
            Break;
          End;

        End;

        If intPosAtual < 0 Then
        Begin
          SetLength(arrAlqIcmAnt, intTamMat + 1);
          intPosAtual := intTamMat;
        End;

        stlOrdena.Add(fStrZero(FloatToStr(arrMatItens[intContador2].fltAlqIcm),2));
        arrAlqIcmAnt[intPosAtual].fltAlqIcm := arrMatItens[intContador2].fltAlqIcm;
        arrAlqIcmAnt[intPosAtual].fltBasIcm := fFormataFloat(arrAlqIcmAnt[intPosAtual].fltBasIcm + arrMatItens[intContador2].fltBasIcm, 2);
        arrAlqIcmAnt[intPosAtual].fltValIcm := fFormataFloat(arrAlqIcmAnt[intPosAtual].fltValIcm + arrMatItens[intContador2].fltValIcm, 2);

      End;

    End;

    stlOrdena.Sort;
    SetLength(arrAlqIcmNov,Length(arrAlqIcmAnt));

    {**************************************}
    {* MONTA A MATRIZ NOVA ORDENADA       *}
    {***********************************AF*}
    For intContador := 0 To stlOrdena.Count-1 Do
    Begin

      For intContador3 := 0 To Length(arrAlqIcmAnt)-1 Do
      Begin

        If fStrZero(FloatToStr(arrAlqIcmAnt[intContador3].fltAlqIcm),2) = stlOrdena[intContador] Then
        Begin
          arrAlqIcmNov[intContador].fltAlqIcm := arrAlqIcmAnt[intContador3].fltAlqIcm;
          arrAlqIcmNov[intContador].fltBasIcm := arrAlqIcmAnt[intContador3].fltBasIcm;
          arrAlqIcmNov[intContador].fltValIcm := arrAlqIcmAnt[intContador3].fltValIcm;
          Break;
        End;

      End;

    End;

    fltResIcA := 0.0;
    fltResBsA := 0.0;
    fltResVlA := 0.0;

    fltResIcB := 0.0;
    fltResBsB := 0.0;
    fltResVlB := 0.0;

    fltResIcC := 0.0;
    fltResBsC := 0.0;
    fltResVlC := 0.0;

    If (Length(arrMatItens)-1) > 0 Then
    Begin

      For intContador := 0 To Length(arrAlqIcmNov)-1 Do
      Begin

        If arrAlqIcmNov[intContador].fltBasIcm <> 0 Then
        Begin

          If fltResIcA = 0 Then
            fltResIcA := arrAlqIcmNov[intContador].fltAlqIcm
          Else If fltResIcB = 0 Then
            fltResIcB := arrAlqIcmNov[intContador].fltAlqIcm
          Else If fltResIcC = 0 Then
            fltResIcC := arrAlqIcmNov[intContador].fltAlqIcm;

          If fltResBsA = 0 Then
            fltResBsA := fFormataFloat(arrAlqIcmNov[intContador].fltBasIcm,2)

          Else If fltResBsB = 0 Then
            fltResBsB := fFormataFloat(arrAlqIcmNov[intContador].fltBasIcm,2)
          Else If fltResBsC = 0 Then
            fltResBsC := fFormataFloat(arrAlqIcmNov[intContador].fltBasIcm,2);

          If fltResVlA = 0 Then
            fltResVlA := fFormataFloat(arrAlqIcmNov[intContador].fltValIcm,2)
          Else If fltResVlB = 0 Then
            fltResVlB := fFormataFloat(arrAlqIcmNov[intContador].fltValIcm,2)
          Else If fltResVlC = 0 Then
            fltResVlC := fFormataFloat(arrAlqIcmNov[intContador].fltValIcm,2);

        End;

      End;

    End;

  Finally
    If Assigned(stlOrdena) Then
      FreeAndNil(stlOrdena);
  End;

End;

Procedure TFatVenda.pApagaLogsDeletados;
  Var
    IntIndMat,
    intIndLog,
    intIndDel: Integer;
    bnlAchouItem: Boolean;
Begin

  intIndLog := 0;
  While intIndLog <= High(arrLogLib) Do
  Begin
    If Not fEmptyStr(arrLogLib[intIndLog].strCodIte) Then
    Begin
      bnlAchouItem := FALSE;

      For intIndMat := Low(arrMatItens) To High(arrMatItens) Do
        If SameText(arrLogLib[intIndLog].strCodIte,arrMatItens[intIndMat].strCodIte) And
           ((arrLogLib[intIndLog].intAutInc = arrMatItens[intIndMat].intAutInc) Or (arrLogLib[intIndLog].blnIgnInc)) Then
        Begin
          bnlAchouItem := TRUE;
          break;
        End;

      If Not bnlAchouItem Then
      Begin
        (******************************************)
        (* EXCLUI O LOG SE O ITEM NAO EXISTE MAIS *)
        (***************************************LA*)
        For intIndDel := intIndLog To Pred(High(arrLogLib)) Do
          arrLogLib[intIndDel] := arrLogLib[Succ(intIndDel)];

        SetLength(arrLogLib,Pred(Length(arrLogLib)));

      End

      Else inc(intIndLog);

    End

    Else inc(intIndLog);

  End;
End;

