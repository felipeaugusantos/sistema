function TFatVenda.fGetCodigoPromocao(AstrCodigoEmpresa, AstrCodigoItem : String; AdtaDataLancamento : TDateTime; var AIdxPromocao : integer) : String;
  var
    LQueryPromocao   : TUniquery;
    LintIdx          : Integer;
    LblnTabloid      : Boolean;
begin

  If (Not fItemPassivelDeVerificacaoPromo(AstrCodigoItem, AstrCodigoEmpresa)) Then
  Begin
    Result := '';
    AIdxPromocao := 0;

    Exit;
  End;

  LQueryPromocao := fCriaQuery(Nil);
  Try
    Result := '';

    for LintIdx := 1 to 2 do
    Begin
      LblnTabloid := IIF(LintIDx = 1, True, False);

      LQueryPromocao.Sql.Text := fSqlPromocaoCliente('', '', Self.GetStrCodCli, cdsVenda.FieldByName('ITE_TABPRE').AsString, LblnTabloid);
      LQueryPromocao.ParamByName('CODEMP').AsString   := AstrCodigoEmpresa;
      LQueryPromocao.ParamByName('CODITE').AsString   := AstrCodigoItem;
      LQueryPromocao.ParamByName('DTAPRO').AsDateTime := AdtaDataLancamento;

      If fCfgSis('PRZPRO', varBoolean) Then
        LQueryPromocao.ParamByName('PRZMED').AsInteger  := intPrzMed;

      LQueryPromocao.Open;
      if not(LQueryPromocao.IsEmpty) then
      Begin
        Result       := LQueryPromocao.FieldByName('PRO_CODPRO').AsString;
        AIdxPromocao := LQueryPromocao.FieldByName('PRO_IDXPRO').AsInteger;
        Exit;
      End;
      LQueryPromocao.Close;

      if fEmptyStr(Result) then
      Begin
        LQueryPromocao.Sql.Text  := fSqlPromocaoTodosClientes('', '', cdsVenda.FieldByName('ITE_TABPRE').AsString, self.GetStrCodCli, LblnTabloid);
        LQueryPromocao.ParamByName('CODEMP').AsString   := AstrCodigoEmpresa;
        LQueryPromocao.ParamByName('CODITE').AsString   := AstrCodigoItem;
        LQueryPromocao.ParamByName('DTAPRO').AsDateTime := AdtaDataLancamento;

        If fCfgSis('PRZPRO', varBoolean) Then
          LQueryPromocao.ParamByName('PRZMED').AsInteger  := intPrzMed;

        LQueryPromocao.Open;
        if not(LQueryPromocao.IsEmpty) then
        Begin
          Result       := LQueryPromocao.FieldByName('PRO_CODPRO').AsString;
          AIdxPromocao := LQueryPromocao.FieldByName('PRO_IDXPRO').AsInteger;
          Exit;
        End;
        LQueryPromocao.Close;
      End;
    End;
  Finally
    FreeAndNil(LQueryPromocao);
  End;

end;

