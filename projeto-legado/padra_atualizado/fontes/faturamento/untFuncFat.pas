function TFatVenda.fAbrirTelaDefinirLoteDevBaixa: Boolean;
var
  strProdSemLote: String;
  frmFatDefinirLoteBaixaDevRetirada: TfrmFatDefinirLoteBaixaDevRetirada;
  intIndMat : Integer;
  intRecNo  : Integer;
begin
  Result := False;

  try
    pCriarFormularios(TfrmFatDefinirLoteBaixaDevRetirada, frmFatDefinirLoteBaixaDevRetirada);
    frmFatDefinirLoteBaixaDevRetirada.cdsVenda := cdsVenda;
    frmFatDefinirLoteBaixaDevRetirada.fatVenda := Self;
    frmFatDefinirLoteBaixaDevRetirada.ShowModal();

    if (frmFatDefinirLoteBaixaDevRetirada.ModalResult <> mrOk) then
      Exit;

    cdsVenda.DisableControls;
    intRecNo := cdsVenda.RecNo;

    Try
      For intIndMat := Low(arrMatItens) To High(arrMatItens) Do
      Begin

        If cdsVenda.Locate('AUTOINCREM', arrMatItens[intIndMat].intAutInc, []) Then
          arrMatItens[intIndMat].strNumLot := cdsVenda.FieldByName('ITE_NUMLOT').AsString;

      End;
    Finally
      cdsVenda.RecNo := intRecNo;
      cdsVenda.EnableControls;
    End;

    if (not fTodosLotesInformados(strProdSemLote)) then
    begin
      TfrmMemo.pShowMessage('Os seguintes itens estão sem LOTE preenchido, preencha para prosseguir!' + #13#10 + strProdSemLote);
      Exit;
    end;

    Result := True;
  finally
    pFreeAndNil(frmFatDefinirLoteBaixaDevRetirada);
  end;
end;

