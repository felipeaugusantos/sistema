      If blnAbastecimentoDeposito or blnRegimeEspecialPorEmpresaComFaturamentoDuplo then
        strNumLot := EmptyStr;
    end;

    If (Pos(strOpcDoc, 'OF_OU_') > 0) and
       (SameText(fCfgSis('PROMAT', varString), strCodIte)) then
      blnFilKar := True;

    If strOpcDoc = 'RL' Then
      blnFilKar := True;

    If strOpcDoc = 'DD' Then
      blnFilKar := Self.fEhDevolucaoDemonstracaoNotaEspecial(arrMatItens[intPosMat].strDocDev, arrMatItens[intPosMat].strEspDev, arrMatItens[intPosMat].strEmpDev);

    If (Not fEmptyStr(strEmpresaAbastecimentoOutrasSaidas)) And (Pos(strOpcDoc, 'OF_EF_') > 0) Then
      blnFilKar := True;

    If fEhMovimentaDeAbastecimentoComTinta(arrMatItens[intPosMat]) Then
    Begin
      blnFilKar := True;
      blnAtualizaEstoqueCadIte := False;
    End;

    If (MatchStr(strOpcDoc, ['CO','CP','CF'])) And
       (strTipOpe = 'R') Then
    Begin
      blnFilKar := True;
      blnAtualizaEstoqueCadIte := False;
    End;

    If strOpcDoc = 'RB' Then
      blnAtualizaEstoqueCadIte := True;

    If (Not blnFilKar) And
       (Not arrMatItens[intPosMat].blnProAca) And
       (Not fEhMovimentaDeAbastecimentoComTinta(arrMatItens[intPosMat])) And
       ((blnAbastecimentoDepositoComTintaSaida) Or (blnAbastecimentoDepositoComTintaEntrada))Then
    Begin
      blnAtualizaEstoqueCadIte := True;
    End;

    If (fEhProducaoAvulsaComTintaImobiliaria(arrMatItens[intPosMat])) And (intOpcao <> OPC_GRAVAMOVDET_REGISTRO_PR) Then
      blnFilKar := False;


    {CASO ESTEJA TUDO OK, REALIZA GRAVACAO DO REGISTRO DETELHADO (MOVDET/X)}
    If Result Then
    Begin
      If Not fDocumentoParaFornecedor Then
        pGravarLogFutEndereco(Self.Name,
                              arrMatItens[intPosMat].strDocFut,
                              arrMatItens[intPosMat].strEspFut,
                              arrMatItens[intPosMat].strEmpFut,
                              strCodCli,
                              '',
                              arrMatItens[intPosMat].strCodIte,
                              strLoginUsuarioLogado,
                              arrMatItens[intPosMat].strEntGer,
                              strAutEnt);

      If (Not fUsaVendedorDoItemParaComissao(arrMatItens[intPosMat].strCodVen)) And  ((strOpcDoc <> 'FC') and (strOpcDoc <> 'CR')) Then
        arrMatItens[intPosMat].strCodVen := Self.strCodVen;

      If ((Not fUsaVendedorDoItemParaComissao(arrMatItens[intPosMat].strCodVe2)))And ((strOpcDoc <> 'FC') and (strOpcDoc <> 'CR'))  Then
        arrMatItens[intPosMat].strCodVe2 := Self.strCodVe2;

      If not ((strEspDocGra = 'PR') and (blnBaixaFFEmprestimo or blnBaiEntFut)) then
      Begin
        fZeraIrpjPisCofCsl;

        If (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) And fEmptyStr(strMovLot) Then
          strAutIncRet := arrMatItens[intPosMat].strAutoincrementoGravacao;

        if (fCfgSis('NUMSER', varBoolean)) and (StrToIntDef(strClaFis,0) > 5000) then
        begin
          {*REQ.169209**********RP*}
          If fCfgSis('DETSER', varBoolean) Then
          Begin
            If fCfgSis('NSERQT', varBoolean) And (Pos(strOpcDoc, 'OU_OF_') <= 0) Then
              strDesNes := strDesNes + fBuscaNumerosSeriesMod2(arrMatItens[intPosMat])
            Else
              strDesNes := strDesNes + fBuscaNumerosSeries(strCodIte, VS_strCodEmp, arrMatItens[intPosMat].strNumOrc);
          End;
        end;

        If Not Self.Fulfillment.EhOperacaoFulfillment Then
          dtaHorEnt := fRetHoraServidor;

        fltVaERet := 0.00;
        fltAlERet := 0.00;
        fltBaERet := 0.00;
        If (fGravaValorRetidoEntradaNosCamposProprios) Then
        Begin
          fltVaERet := arrMatItens[intPosMat].fltVaERet;
          fltAlERet := arrMatItens[intPosMat].fltAlERet;
          fltBaERet := arrMatItens[intPosMat].fltBaERet;
        End;

        strCplIncPed := '';
        If (blnGravaIncPedFuncoesDiarias) Then
          strCplIncPed := CNS_TAG_FAT_DUP;

        strClaIte := IIF(((strEspDocGra = 'PR') And (strEspDoc = 'PA')), '1888', strClaFis);
        strDesClaIte := IIF(strClaIte = Self.strClaFis, Self.strDesCla, '');

        LRefGravacao := fReformaTributariaParaGravacao(arrMatItens[intPosMat]);
        If (strOpcDoc = 'CR') Then
