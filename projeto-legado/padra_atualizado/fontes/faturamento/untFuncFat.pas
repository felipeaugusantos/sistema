  Else
    Result := strEmpDoc;
end;

function TFatVenda.fFaturaPedidoEnderecamentoRemessaDevolucao(const strNumeroRemessa: String): Boolean;
var
  qryPedidoEnderecamento: TUniQuery;
begin
  qryPedidoEnderecamento := fCriaQuery;

  try
    Result := False;

    qryPedidoEnderecamento.Close;
    qryPedidoEnderecamento.SQL.Clear;
    qryPedidoEnderecamento.SQL.Add('SELECT G.FGO_NUMDOC, G.FGO_ESPDOC, G.FGO_CODEMP');
    qryPedidoEnderecamento.SQL.Add('FROM REMDEV R');
    qryPedidoEnderecamento.SQL.Add('INNER JOIN FATDOR D');
    qryPedidoEnderecamento.SQL.Add('ON(R.RMV_AUTFDE = D.AUTOINCREM)');
    qryPedidoEnderecamento.SQL.Add('INNER JOIN FATGOR G');
    qryPedidoEnderecamento.SQL.Add('ON(D.FDO_SEQGER = G.AUTOINCREM)');
    qryPedidoEnderecamento.SQL.Add('WHERE R.RMV_NUMREM = :NUMREM');
    qryPedidoEnderecamento.SQL.Add('GROUP BY G.FGO_NUMDOC, G.FGO_ESPDOC, G.FGO_CODEMP');

    qryPedidoEnderecamento.ParamByName('NUMREM').AsString := strNumeroRemessa;

    qryPedidoEnderecamento.Open;

    if qryPedidoEnderecamento.IsEmpty then
      Exit;

    while not qryPedidoEnderecamento.Eof do
    begin
      pBaixaPedido(qryPedidoEnderecamento.FieldByName('FGO_NUMDOC').AsString,
                   qryPedidoEnderecamento.FieldByName('FGO_ESPDOC').AsString,
                   qryPedidoEnderecamento.FieldByName('FGO_CODEMP').AsString,
                   '');

      qryPedidoEnderecamento.Next;
    end;

    Result := True;
  finally
    FreeAndNil(qryPedidoEnderecamento);
  end;
end;

function TFatVenda.fFaturaPedidosAgrupados: Boolean;
  Var 
    strSQL     : String;
    qryGenDor  : TUniQuery;
    intContador: Integer;
Begin
  Result := True;

  qryGenDor := fCriaQuery(Self);
  Try 
    strSQL := '';
    strSQL := strSQL + 'UPDATE ';
    strSQL := strSQL + '  FATDOR FD ';
    strSQL := strSQL + 'SET ';
    strSQL := strSQL + '  FD.FDO_QTDBAI = FD.FDO_QTDBAI + :QTDBAI ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FD.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  FD.FDO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  FD.FDO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  FD.FDO_CODITE = :CODITE AND ';
    strSQL := strSQL + '  FD.FDO_SEQIND = :SEQIND     ';

    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If (arrMatItens[intContador].intSeqInd <> -1) Then
      Begin
        With qryGenDor Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('NUMDOC').AsString  := arrMatItens[intContador].strNumOrc;
          ParamByName('ESPDOC').AsString  := arrMatItens[intContador].strEspOrc;
          ParamByName('CODEMP').AsString  := arrMatItens[intContador].strEmpOrc;
          ParamByName('CODITE').AsString  := arrMatItens[intContador].strCodIte;
          ParamByName('SEQIND').AsInteger := arrMatItens[intContador].intSeqInd;
          ParamByName('QTDBAI').AsFloat   := arrMatItens[intContador].fltQtdIte;

          ExecSQL;
        End;

        Result := fMarcaOrcPed(strNumDoc,
                               strEspDoc,
                               arrMatItens[intContador].strNumOrc,
                               arrMatItens[intContador].strEspOrc,
                               strCodVen,
                               strConPag,
                               fltTotGer,
                               arrMatItens[intContador].strEmpOrc,
                               True,
                               '',
                               '',
                               '',
                               '',
                               '',
                               False,
                               blnGravarCadRec,
                               strCodCli,
                               IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                               blnExecutandoFaturadorAutomatico);

        If (VS_strHabilitarCRM) Then
        Begin
          TUpdateOccurrenceCRM.New()
            .NumDoc(strNumDoc)
            .EspDoc(strEspDoc)
            .NumOrc(arrMatItens[intContador].strNumOrc)
            .EspOrc(arrMatItens[intContador].strEspOrc)
            .CodEmp(arrMatItens[intContador].strEmpOrc)
            .AcaFat(afcFaturaPedidoAgrupado)
            .strNomFrm('[TFatVenda.fFaturaPedidosAgrupados - finalização]')
            .pRun();
        End;

        If Not Result Then
          Break;
      End;
    End;

    strSQL := '';
    strSQL := strSQL + 'UPDATE ';
    strSQL := strSQL + '  FATDOR FD ';
    strSQL := strSQL + 'SET ';
    strSQL := strSQL + '  FD.FDO_QTDBAI = FD.FDO_QTDBAI + :QTDBAI ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  FD.FDO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  FD.FDO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  FD.FDO_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  FD.FDO_SEQIND = :SEQIND     ';

    For intContador := Low(arrPedidosServAgrupados) To High(arrPedidosServAgrupados) Do
    Begin
      With qryGenDor Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString  := arrPedidosServAgrupados[intContador].strNumPed;
        ParamByName('ESPDOC').AsString  := arrPedidosServAgrupados[intContador].strEspPed;
        ParamByName('CODEMP').AsString  := arrPedidosServAgrupados[intContador].strEmpPed;
        ParamByName('SEQIND').AsInteger := -1;
        ParamByName('QTDBAI').AsFloat   :=  1;

        ExecSQL;
      End;

      Result := fMarcaOrcPed(strNumDoc,
                             strEspDoc,
                             arrPedidosServAgrupados[intContador].strNumPed,
                             arrPedidosServAgrupados[intContador].strEspPed,
                             strCodVen,
                             strConPag,
                             fltTotGer,
                             arrPedidosServAgrupados[intContador].strEmpPed,
                             True,
                             '',
                             '',
                             '',
                             '',
                             '',
                             False,
                             blnGravarCadRec,
                             strCodCli,
                             IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                             blnExecutandoFaturadorAutomatico);

      If Not Result Then
        Break;
    End;

  Finally
    FreeAndNil(qryGenDor);
  End;

End;

Function TFatVenda.fGEspGer : Boolean;
  Var
    objEspelhoCapa : TEspelhoCapa;
    valorDuplicatas: TValoresDuplicatas;
Begin

  Try
    valorDuplicatas := TValoresDuplicatas.Create(arrDuplicata, intSeqDupBaiUtiCred);

    objEspelhoCapa := TEspelhoCapa.Create;
    objEspelhoCapa.strCodEmp := VS_strCodEmp;
    objEspelhoCapa.strNumEsp := strNumDoc;

    If strOpcDoc = 'DV' Then
    Begin
      objEspelhoCapa.strCodCli := strCodCli;
      objEspelhoCapa.strTip_FC := 'C';
      objEspelhoCapa.strCodAde := strCodAde;
      objEspelhoCapa.strClaFis := strClaFis;

      If strClaFis <> '' Then
      Begin
        Case strClaFis[1] Of
          '1': objEspelhoCapa.strClaFis := '5' + RightStr(strClaFis, 3);
          '2': objEspelhoCapa.strClaFis := '6' + RightStr(strClaFis, 3);
          '3': objEspelhoCapa.strClaFis := '7' + RightStr(strClaFis, 3);
        End;
        If (fEhDevolucaoSubstituidaConsumidorFinal) Then
          objEspelhoCapa.strClaFis := LeftStr(objEspelhoCapa.strClaFis, 1) + '413';
      End;
    End
    Else
    Begin
      objEspelhoCapa.strCodFor := strCodCli;
      objEspelhoCapa.strTip_FC := 'F';
      objEspelhoCapa.strClaFis := strClaFis;
    End;

    objEspelhoCapa.fltTotPro := fltTotPro;
    objEspelhoCapa.fltTotIpi := fltTotIpi;
    objEspelhoCapa.fltTotRet := fltTotRet;
    objEspelhoCapa.fltTotCBS := fltTotCBS;
    objEspelhoCapa.fltTotIBS := fltTotIBS;
    objEspelhoCapa.fltTotIS  := fltTotIS;
    objEspelhoCapa.fltTotFre := fltValFre;
    objEspelhoCapa.fltDesAce := fltDesAce;
    objEspelhoCapa.fltVlrCon := fltTotGer;
    objEspelhoCapa.intQtdIte := Length(arrMatItens);
    objEspelhoCapa.strMovGer := '';
    objEspelhoCapa.strConPag := strConPag;
    objEspelhoCapa.strCodCnd := strCodCnd;
    objEspelhoCapa.strCodFpg := strCodFpg;
    objEspelhoCapa.fltVPar01 := valorDuplicatas.fltValor01;
    objEspelhoCapa.fltVPar02 := valorDuplicatas.fltValor02;
    objEspelhoCapa.fltVPar03 := valorDuplicatas.fltValor03;
    objEspelhoCapa.fltVPar04 := valorDuplicatas.fltValor04;
    objEspelhoCapa.fltVPar05 := valorDuplicatas.fltValor05;
    objEspelhoCapa.fltVPar06 := valorDuplicatas.fltValor06;
    objEspelhoCapa.fltVPar07 := valorDuplicatas.fltValor07;
    objEspelhoCapa.fltVPar08 := valorDuplicatas.fltValor08;
    objEspelhoCapa.fltVPar09 := valorDuplicatas.fltValor09;
    objEspelhoCapa.fltVPar10 := valorDuplicatas.fltValor10;
    objEspelhoCapa.fltVPar11 := valorDuplicatas.fltValor11;
    objEspelhoCapa.fltVPar12 := valorDuplicatas.fltValor12;

    If strOpcDoc = 'DV' Then
      objEspelhoCapa.strCnfNfe := fRetDadosCNF_NFE('F')
    Else
      objEspelhoCapa.strCnfNfe := fRetDadosCNF_NFE('C');

    objEspelhoCapa.strChvNFE := strChaveNFeRefDevolucao;

    objEspelhoCapa.strCodTra := strCodTra;
    objEspelhoCapa.strPlaFat := strPlaFat;

    objEspelhoCapa.fltBasIPI := fltBasIPI;
    objEspelhoCapa.fltAlqIPI := fltAlqIPI;
    objEspelhoCapa.fltBasIcm := fltBasIcm;
    objEspelhoCapa.fltAlqICM := fltAlqICM;
    objEspelhoCapa.fltTotICM := fltTotICM;
    objEspelhoCapa.fltAlqRet := fltAlqRet;
    objEspelhoCapa.fltBasRet := fltBasRet;
    objEspelhoCapa.fltDesEsp := fltDesEsp;
    objEspelhoCapa.strTipFre := strTipFre;
    objEspelhoCapa.fltPesBru := fltPesBru;
    objEspelhoCapa.fltPesLiq := fltPesLiq;
    objEspelhoCapa.fltVolume := intQtdTra;
    objEspelhoCapa.strEspeci := strEspTra;
    objEspelhoCapa.strMarca_ := strMarTra;
    objEspelhoCapa.strNumera := strNumera;
    objEspelhoCapa.strMen001 := strMen001;
    objEspelhoCapa.strMen002 := strMen002;
    objEspelhoCapa.strMen003 := strMen003;
    objEspelhoCapa.strMen004 := strMen004;
    objEspelhoCapa.strMen005 := strMen005;
    objEspelhoCapa.fltBasFcpST := fltBasFcpST;
    objEspelhoCapa.fltAlqFcpST := fltAlqFcpST;
    objEspelhoCapa.fltTotFcpST := fltTotFcpST;
    objEspelhoCapa.strNatOpe := strDesCla;
    objEspelhoCapa.strNumRem := strNumRemessaDevolucao;

    Result := objEspelhoCapa.fSalva;

    If Result Then
      strAutInc := objEspelhoCapa.strAutInc;

  Finally
    FreeAndNil(objEspelhoCapa);
    FreeAndNil(valorDuplicatas);
  End;

End;

function TFatVenda.fEhDevolucaoSubstituidaConsumidorFinal: Boolean;
  Var
    intContador : Integer;
begin
  Result := False;
  If (strOpcDoc <> 'DV') Then
    Exit;
  If (strCliCon <> 'S') Then
    Exit;
  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    If (Pos(arrMatItens[intContador].strCodFis, CST_SUBSTITUICAO) > 0) Then
    Begin
      Result := True;
      Exit;
    End;
  End;
end;

Function TFatVenda.fGEspDet : Boolean;
  Var
    objEspelhoDetalhe : TEspelhoDetalhe;
    intContador : Integer;
Begin
  Result := True;
  For intContador := 0 To Length(arrMatItens) -1 Do
  Begin
    If Not Result Then
      Break;

    pInfoStatusGravacao('Aguarde... Gravando Produto ' + intToStr(Succ(intContador)) + '/' + intToStr(Length(arrMatItens)));
    pStepStatusGravacao;

    objEspelhoDetalhe := TEspelhoDetalhe.Create;
    objEspelhoDetalhe.strSeqGer := strAutInc;

    objEspelhoDetalhe.strCodIte := arrMatItens[intContador].strCodIte;
    objEspelhoDetalhe.strDesIte := arrMatItens[intContador].strDesIte;
    objEspelhoDetalhe.strDesNes := arrMatItens[intContador].strDesNes;
    objEspelhoDetalhe.fltQtdIte := arrMatItens[intContador].fltQtdIte;
    objEspelhoDetalhe.fltUnitar := arrMatItens[intContador].fltUnitar;
    objEspelhoDetalhe.strCodFis := arrMatItens[intContador].strCodFis;
    objEspelhoDetalhe.strCodAbf := arrMatItens[intContador].strCodAbf;
    objEspelhoDetalhe.fltTotIte := arrMatItens[intContador].fltTotIte;
    objEspelhoDetalhe.fltBasIcm := arrMatItens[intContador].fltBasIcm;
    objEspelhoDetalhe.fltAlqIcm := arrMatItens[intContador].fltAlqIcm;
    objEspelhoDetalhe.fltValIcm := arrMatItens[intContador].fltValIcm;
    objEspelhoDetalhe.fltBasIpi := arrMatItens[intContador].fltBasIpi;
    objEspelhoDetalhe.fltAlqIpi := arrMatItens[intContador].fltAlqIpi;
    objEspelhoDetalhe.fltValIpi := arrMatItens[intContador].fltValIpi;
    objEspelhoDetalhe.fltBasRet := arrMatItens[intContador].fltBasRet;
    objEspelhoDetalhe.fltValRet := arrMatItens[intContador].fltValRet;
    objEspelhoDetalhe.fltAlqRet := arrMatItens[intContador].fltAlqRet;
    objEspelhoDetalhe.fltValIva := arrMatItens[intContador].fltValIva;
    objEspelhoDetalhe.fltPerRed := arrMatItens[intContador].fltPerRed;
    objEspelhoDetalhe.fltValCBS := arrMatItens[intContador].fltValCBS;
    objEspelhoDetalhe.fltValIBS := arrMatItens[intContador].fltValIBS;
    objEspelhoDetalhe.fltVal_IS := arrMatItens[intContador].fltVal_IS;
    objEspelhoDetalhe.fltBasPis := arrMatItens[intContador].fltBasPis;
    objEspelhoDetalhe.fltAlqPis := arrMatItens[intContador].fltAlqPis;
    objEspelhoDetalhe.fltValPis := arrMatItens[intContador].fltValPis;
    objEspelhoDetalhe.strCstPis := arrMatItens[intContador].strCstPis;
    objEspelhoDetalhe.fltBasCoF := arrMatItens[intContador].fltBasCoF;
    objEspelhoDetalhe.fltAlqCof := arrMatItens[intContador].fltAlqCof;
    objEspelhoDetalhe.fltValCof := arrMatItens[intContador].fltValCof;
    objEspelhoDetalhe.strCstCof := arrMatItens[intContador].strCstCof;
    objEspelhoDetalhe.strClaFis := arrMatItens[intContador].strClaFis;
    objEspelhoDetalhe.strDocDev := arrMatItens[intContador].strDocDev;
    objEspelhoDetalhe.strEspDev := arrMatItens[intContador].strEspDev;
    objEspelhoDetalhe.strEmpDev := arrMatItens[intContador].strEmpDev;

    If strOpcDoc = 'DV' Then
    Begin
      If objEspelhoDetalhe.strClaFis <> '' Then
      Begin
        Case strClaFis[1] Of
          '1': objEspelhoDetalhe.strClaFis := '5' + RightStr(objEspelhoDetalhe.strClaFis, 3);
          '2': objEspelhoDetalhe.strClaFis := '6' + RightStr(objEspelhoDetalhe.strClaFis, 3);
          '3': objEspelhoDetalhe.strClaFis := '7' + RightStr(objEspelhoDetalhe.strClaFis, 3);
        End;
        If (RightStr(objEspelhoDetalhe.strClaFis, 3) = '411') And
           (Pos(objEspelhoDetalhe.strCodFis, CST_SUBSTITUICAO) > 0) And
           (strCliCon = 'S') Then
          objEspelhoDetalhe.strClaFis := LeftStr(objEspelhoDetalhe.strClaFis, 1) + '413';
      End;
    End;

    objEspelhoDetalhe.fltBasVrd := arrMatItens[intContador].fltBasVrd;
    objEspelhoDetalhe.fltVrdIcm := arrMatItens[intContador].fltVrdIcm;
    objEspelhoDetalhe.strMtdIcm := arrMatItens[intContador].strMtdIcm;
    objEspelhoDetalhe.fltDescon := arrMatItens[intContador].fltDescon;
    objEspelhoDetalhe.fltDesEsp := arrMatItens[intContador].fltDesEsp;
    objEspelhoDetalhe.fltUniOri := arrMatItens[intContador].fltUniOri;
    objEspelhoDetalhe.fltUniDig := arrMatItens[intContador].fltUniDig;
    objEspelhoDetalhe.strIncPis := arrMatItens[intContador].strIncPis;

    If fEhGarantiaFornecedorComDocumentoVinculado Then
    Begin
      objEspelhoDetalhe.fltBasFcp := arrMatItens[intContador].EspelhoFcpIcms.fltBase;
      objEspelhoDetalhe.fltPerFcp := arrMatItens[intContador].EspelhoFcpIcms.fltAliquota;
      objEspelhoDetalhe.fltValFcp := arrMatItens[intContador].EspelhoFcpIcms.fltValor;

      objEspelhoDetalhe.fltBFcpST := arrMatItens[intContador].EspelhoFcpIcmsST.fltBase;
      objEspelhoDetalhe.fltPFcpST := arrMatItens[intContador].EspelhoFcpIcmsST.fltAliquota;
      objEspelhoDetalhe.fltVFcpST := arrMatItens[intContador].EspelhoFcpIcmsST.fltValor;
    End
    Else
    Begin
      objEspelhoDetalhe.fltBasFcp := arrMatItens[intContador].VisualizarFcpIcms.fltBase;
      objEspelhoDetalhe.fltPerFcp := arrMatItens[intContador].VisualizarFcpIcms.fltAliquota;
      objEspelhoDetalhe.fltValFcp := arrMatItens[intContador].VisualizarFcpIcms.fltValor;

      objEspelhoDetalhe.fltBFcpST := arrMatItens[intContador].VisualizarFcpIcmsST.fltBase;
      objEspelhoDetalhe.fltPFcpST := arrMatItens[intContador].VisualizarFcpIcmsST.fltAliquota;
      objEspelhoDetalhe.fltVFcpST := arrMatItens[intContador].VisualizarFcpIcmsST.fltValor;
    End;

    objEspelhoDetalhe.fltDesAce := arrMatItens[intContador].fltDesAce;
    objEspelhoDetalhe.fltVlrCon := arrMatItens[intContador].fltVlrCon;
    objEspelhoDetalhe.fltTotFre := arrMatItens[intContador].fltValFre;
    objEspelhoDetalhe.fltVal_Rt := arrMatItens[intContador].fltVal_RT;
    objEspelhoDetalhe.fltPebaST := arrMatItens[intContador].fltPeBaST;
    objEspelhoDetalhe.strNr_Pis := arrMatItens[intContador].strNatPis;
    objEspelhoDetalhe.strNr_Cof := arrMatItens[intContador].strNatCof;

    //Se for Garantia o Vinculo do AutInc do doc. de garantia é feito pelo strIncDev, ja em outras saidas é feito pelo strAiDvOr
    if not fEmptyStr(arrMatItens[intContador].strSeqGad) then
      objEspelhoDetalhe.strSeqDet := arrMatItens[intContador].strIncDev
    Else
      objEspelhoDetalhe.strSeqDet := arrMatItens[intContador].strAiDvOr;

    if strOpcDoc = 'OF' then
      objEspelhoDetalhe.strNumeroDoLote := arrMatItens[intContador].strNumLot;

    Result := objEspelhoDetalhe.fSalva;

    FreeAndNil(objEspelhoDetalhe);

  End;

End;

function TFatVenda.fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos: Boolean;
begin
  Result := (blnPdOutraLojaEmPdComEntCDOndeCDEhLojaAtual);
  If (Not Result) And (Pos(strEspDoc, 'PD_OR_') > 0) And (Length(Self.arrMatItens) > 0) Then
    Result := (Not fEmptyStr(Self.arrMatItens[0].strEmpIte)) And (VS_strCodEmp = Self.arrMatItens[0].strEmpIte);
end;

function TFatVenda.fGravaFulfillCartoes(var AMensagem : string) : boolean;
  Var
    arrCartoes: TCartoesResumoCaixaArray;
    recDadAdCar: untTypesSistema.TDadosAdicCartao;
    intPosCar : Integer;
    strMSG: String;
    frmRcxDigCartoes : TfrmRcxDigCartoes;
begin
  Result := True;

  Try
    strMsg := '';

    pCriarFormularios(TfrmRcxDigCartoes, frmRcxDigCartoes);
    Try
      frmRcxDigCartoes.edtTotCar.ReadOnly := True;
      frmRcxDigCartoes.edtTotCar.TabStop := False;

      frmRcxDigCartoes.edtCodCar.ReadOnly := True;
      frmRcxDigCartoes.edtCodCar.TabStop := False;

      frmRcxDigCartoes.edtQtdPar.ReadOnly := True;

      frmRcxDigCartoes.fltTotDig := 0.0;
      frmRcxDigCartoes.fltTotGer := fltTotGer;
      frmRcxDigCartoes.fltMaxDig := fltTotGer;
      frmRcxDigCartoes.strNumNsu := IIF(fEmptyStr(strFullNumNsu),'.',strFullNumNsu);
      frmRcxDigCartoes.strCodCar := CfgFulFillment('CODCAR', Self.Fulfillment.SiglaHubMarketPlace);
      frmRcxDigCartoes.intQtdPar := 1;
      frmRcxDigCartoes.intQtdNeg := 1;
      frmRcxDigCartoes.strNumCcd := IIF(fEmptyStr(strFullNumCCD),'.',strFullNumCCD);
      frmRcxDigCartoes.blnTraVal := True;
      frmRcxDigCartoes.blnFulfillment := Self.Fulfillment.EhOperacaoFulfillment;
      frmRcxDigCartoes.blnSairComEsc := True;
      frmRcxDigCartoes.blnSemMensagem := True;
      frmRcxDigCartoes.OnShow(frmRcxDigCartoes);

      If Not fEmptyStr(frmRcxDigCartoes.strUltMsgCamposCartao) Then
      Begin
        AMensagem := 'Ocorreu um erro na validação do cartão do pedido: ' + frmRcxDigCartoes.strUltMsgCamposCartao;
        Exit(False);
      End
      Else If (Not frmRcxDigCartoes.fVerificaCamposCartao) Then
      begin
        AMensagem := 'Ocorreu um erro na validação do cartão do pedido: ' + frmRcxDigCartoes.strUltMsgCamposCartao;
        Exit(False);
      end
      Else
        frmRcxDigCartoes.btnConfirma.Click;

      If (frmRcxDigCartoes.blnConfirma) Then
      Begin
        SetLength(arrCartoes, 1);
        intPosCar := 0;

        FillChar(arrCartoes[intPosCar], SizeOf(arrCartoes[intPosCar]), #0);

        arrCartoes[intPosCar].intCodSeq := intPosCar;
        arrCartoes[intPosCar].strCodCar := frmRcxDigCartoes.edtCodCar.Text;
        arrCartoes[intPosCar].strDesCar := frmRcxDigCartoes.edtDesCar.Text;
        arrCartoes[intPosCar].fltValDig := frmRcxDigCartoes.fltValDig;
        arrCartoes[intPosCar].strCndPag := frmRcxDigCartoes.mskCndPag.Text;
        arrCartoes[intPosCar].fltValDes := frmRcxDigCartoes.fltValDes;
        arrCartoes[intPosCar].fltPerDes := frmRcxDigCartoes.fltPerDes;
        arrCartoes[intPosCar].fltTaxMkt := frmRcxDigCartoes.fltValDig - frmRcxDigCartoes.fltValDes;
        arrCartoes[intPosCar].fltFreMkt := 0.00;
        arrCartoes[intPosCar].fltCupMkt := 0.00;
        arrCartoes[intPosCar].strNumCcd := frmRcxDigCartoes.edtNumCcd.Text;
        arrCartoes[intPosCar].strObsCar := 'FULFILLMENT';
        arrCartoes[intPosCar].strCodFin := '';
        arrCartoes[intPosCar].strTipCar := 'TEF';
        arrCartoes[intPosCar].strNumNsu := frmRcxDigCartoes.strNumNsu;
        arrCartoes[intPosCar].strConteudoArquivo := '';

        If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') And (fltFullValTax + fltFullFreMkt > 0) Then
        Begin
          arrCartoes[intPosCar].fltTaxMkt := fltFullValTax;
          arrCartoes[intPosCar].fltValDes := arrCartoes[intPosCar].fltValDig - arrCartoes[intPosCar].fltTaxMkt;
          arrCartoes[intPosCar].fltPerDes := fFormataFloat((1 - arrCartoes[intPosCar].fltValDes / arrCartoes[intPosCar].fltValDig) * 100, 2);
          arrCartoes[intPosCar].fltFreMkt := fltFullFreMkt;
          arrCartoes[intPosCar].fltValDes := arrCartoes[intPosCar].fltValDes - fltFullFreMkt;
        End;

        If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') And (fltFullCupMkt > 0) Then
          arrCartoes[intPosCar].fltCupMkt := fltFullCupMkt;

        If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') And (fltFullFreCli > 0) Then
        Begin
          arrCartoes[intPosCar].fltValDig := arrCartoes[intPosCar].fltValDig + fltFullFreCli;
          arrCartoes[intPosCar].fltFreMkt := arrCartoes[intPosCar].fltFreMkt + fltFullFreCli;
        End;

        FillChar(recDadAdCar, SizeOf(recDadAdCar), #0);

        recDadAdCar.strNumDoc := strNumDoc;
        recDadAdCar.strEspDoc := strEspDoc;
        recDadAdCar.strCodEmp := strEmpDoc;
        recDadAdCar.strCodCli := strCodCli;
        recDadAdCar.dtaDtaCar := dtaDtaEnt;
        recDadAdCar.dtaDtaCup := dtaDtaEnt;
        recDadAdCar.fltTotVen := fltTotGer;
        recDadAdCar.strNumPok := strFullNumPOK;
        recDadAdCar.fltTxDsGe := 0;
        recDadAdCar.fltTxDsPa := 0;
        recDadAdCar.strTxDsGe := '';
        recDadAdCar.strTxDsPa := '';
        recDadAdCar.intQtdPar := 1;

        If Not fGravarCartoesFulfillment(arrCartoes, recDadAdCar) Then
        begin
          AMensagem := 'Ocorreu um erro ao gravar o cartão do pedido';
          Exit(False);
        end;
      End;

    Except
      On E: Exception Do
      begin
        Result:= false;
        AMensagem := 'Ocorreu um erro ao gravar o cartão do pedido  ' + sLineBreak + 'Erro: ' + E.Message;
      end;
    End;

  Finally
    pFreeAndNil(frmRcxDigCartoes);
  End;
end;

