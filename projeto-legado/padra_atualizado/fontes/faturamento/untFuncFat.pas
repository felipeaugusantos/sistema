          FAutIcv := strAutInc;
      End;
    End;

    If (Result) And (fCfgSis('ALTVMT', varString) = 'S') And (Not fEmptyStr(strNumLib)) And (Assigned(cdsTravaProdMin)) And (cdsTravaProdMin.Active) And (cdsTravaProdMin.RecordCount > 0) Then
