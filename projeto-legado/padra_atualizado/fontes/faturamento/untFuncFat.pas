            objLiberacao.objMsgLibera.pAddTextoCaption(IIF(strPromocIte = 'S', 'Pr.Promoção', 'Pr.Tabela'), FormatFloat(fMskDigitos(fMaxDecUni), fltPrecoTabela) , 22, alDireita, teAmbos, '', 16);
          End;

          If (Not fEmptyStr(strConPag)) And
             (fCfgSis('SENFVU') <> 'V') Then // SE FOR = V JA SAIRA EM pMontaMensagem
            objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagamento', fFormataCondPag(strConPag)               , 22);

          objLiberacao.objMsgLibera.pAddTextoCaption('Pr.Digitado'     , FormatFloat(fMskDigitos(fMaxDecUni), fltUniLiqTmp), 22, alDireita, teAmbos, '', 16);

          If (fFormataFloat(fltPrecoTabela, fMaxDecUni) > fFormataFloat(fltUniLiqTmp, fMaxDecUni)) Then
          Begin
            objLiberacao.objMsgLibera.pAddTextoCaption('Desconto', FormatFloat(fMskDigitos(2), (1 - (fltUniLiqTmp / fltPrecoTabela)) * 100)+'%', 22, alDireita, teAmbos, '', 16);
          End;

          If (strPromocIte = 'S') Then
          Begin
            objLiberacao.objMsgLibera.pAddTexto('');
            objLiberacao.objMsgLibera.pAddTexto('** PRODUTO EM PROMOÇÃO');
            objLiberacao.objMsgLibera.pAddTexto('');
          End;

          {**************************************************************}
          {* CASO CONFIGURADO PARA TRAVAR POR MARGEM MINIMA POR PRODUTO *}
          {* E CONFIGURADO PARA TRAVAR POR MARGEM LIQUIDA (CUSTO REAL)  *}
          {* EXIBE AS INFORMACOES DE MARGEM MINIMA DO PRODUTO E MARGEM  *}
          {* PRATICADA NA VENDA...                                      *}
          {***********************************************************JC*}
          If (fUsaTravaPorMargemMinimaLiquida) Then
          Begin
            With qryConIte Do
            Begin
              fltMargemMinimaLiquida := qryConIte.FieldByName('ITE_MARMIN').AsFloat;
              strMascaraMargemMinima := fMskDigitos(2)+'%';
              If (Self.strIdePro <> 'NOR') And (fAnalisaTodosCompomentesAoTravarUnitarioDeTintaComoProdutoNormal) Then
              Begin
                If (Self.fltPreCu2 <> 0) Then
                Begin
                  fltMargemMinimaLiquida := fFormataFloat((((fltUniTraPro / Self.fltPreCu2) - 1) * 100), 4);
                  strMascaraMargemMinima := fMskDigitos(4)+'%';
                End;
              End;

              objLiberacao.objMsgLibera.pAddTextoCaption('Margem Mínima', FormatFloat(strMascaraMargemMinima, fltMargemMinimaLiquida), 22, alDireita, teAmbos, '', 10);

              strCodAbf := fGetCodAbf(strCodIte, fGetEmpCalculoItem(strEmpresaItem));

              strCodSit := '';
              If (Not fEmptyStr(Self.GetTipAbf(strEmpresaItem))) And (fBuscaAbfIcm(strCodIte, strEmpresaItem, strCodAbf, fTrocaUFEndEntrega)) Then
                strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpresaItem)).AsString;

              fltComLiq := 0;
              If (blnEmCampanha) And
                 (fCfgSis('MARMKP') = '4') Then
              Begin
                objCamGer.objCamDet.fVerificaProdutoCampanha(strCodCli,
                                                             strCodIte,
                                                             EmptyStr,
                                                             EmptyStr,
                                                             0,
                                                             fltVlrCam,
                                                             strCodCmg,
                                                             fltComLiq);
              End;

              objIcStPv.pAdd(strCodIte,
                             fGetEmpCalculoItem(strEmpresaItem),
                             Self.GetTipAbf(strEmpresaItem),
                             Self.fUFDestTrib(strEmpresaItem),
                             strCodSit,
                             fltImcSTPV,
                             blnCalcST,
                             0,
                             fltComLiq);

              fltIcmSaiTmp := 0;
              fltImpFedTmp := 0;
              fltDesOpeTmp := 0;
              fltComTblTmp := 0;
              fltAlqDifal  := 0;
              fltAlqFCP    := 0;

              pCarregaValoresCusto(qryConIte.FieldByName('ITE_CODITE').AsString,
                                   fGetEmpCalculoItem(strEmpresaItem),
                                   IIF(strTabPreIte.IsEmpty, strTabPre, strTabPreIte));

              If (TMargemMinima.UsaPrecoLiquido) Then
              Begin

                fltIcmSaiTmp := fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat) + fAlqDifIcmsPrecoDinamico(FieldByName('ITE_CODITE').AsString, strEmpresaItem,
                                                                    strCodAbf, strCodSit, fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat));
                fltImpFedTmp := fRetImpFed(FieldByName('ITE_IMPFED').AsFloat);
                fltDesOpeTmp := fProcessarDespesasOperacionaisComplementar(fRetDesOpe(FieldByName('ITE_DESOPE').AsFloat));
                fltComTblTmp := FieldByName('ITE_COMTB' + IIF(fEmptyStr(strTabPreIte), strTabPre, strTabPreIte)).AsFloat;


                fltAlqDifal := fGetAlqDifal(qryConIte.FieldByName('ITE_CODITE').AsString,
                                            strEmpresaItem,
                                            strCodAbf,
                                            strCodSit);

                fltAlqFCP := fGetAlqFcpIcms(qryConIte.FieldByName('ITE_CODITE').AsString,
                                            strEmpresaItem,
                                            strCodAbf,
                                            strCodSit,
                                            fRetIcmSai(FieldByName('ITE_ICMSAI').AsFloat),
                                            fltUniLiqTmp);
              End;

              If (TMargemMinima.UsaPrecoCusto) Then
              Begin
                fltPreCusTmp := fltCusIte;
                If fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto Then
                Begin
                  If (strIdeProIte = 'NOR') Then
                    fltPreCusTmp := fRetPreCus(FieldByName('ITE_PRECUS').AsFloat) * (1 + (fltTaxVpr / 100))
                  Else
                    fltPreCusTmp := fltCusIte * (1 + (fltTaxVpr / 100));
                End;
              End
              Else
                fltPreCusTmp := fltPreMed;

              recInfoTravaUnitario.fltMargPra := fCalculaPrecoVenda(2,
                                                                    fltPreCusTmp,
                                                                    fltUniLiqTmp,
                                                                    0,
                                                                    fltIcmSaiTmp,
                                                                    fltImpFedTmp,
                                                                    fltDesOpeTmp,
                                                                    fRetornaValCom(fltComTblTmp),
                                                                    fMarMpkParaVenda,
                                                                    '',
                                                                    -1,
                                                                    fltImcSTPV,
                                                                    blnCalcST,
                                                                    IIF(Not fCfgSis('CLPVDI', varBoolean), fltAlqDifal, 0),
                                                                    IIF(Not fCfgSis('CLPVDI', varBoolean), fltAlqFCP, 0),
                                                                    fRetOutVal(FieldByName('ITE_OUTVAL').AsFloat),
                                                                    fRestringirElementosMargem );

              objLiberacao.objMsgLibera.pAddTextoCaption('Margem Praticada' , FormatFloat(strMascaraMargemMinima, recInfoTravaUnitario.fltMargPra) , 22, alDireita, teAmbos, '', 10);
            End;
          End;

          If (fGeraFlexOpe) And fCfgSis('USAFLE',varBoolean) And (fCfgSis('PERFLE', varDouble) > 0) Then
          Begin
            objLiberacao.objMsgLibera.pAddSeparador(80);
            objLiberacao.objMsgLibera.pAddTextoCaption('Saldo Flex do Vendedor', FormatFloat('#,##0.00', fltSaldoFlex)                       , 22);
            objLiberacao.objMsgLibera.pAddTextoCaption('Valor Flex Diferença'  , FormatFloat('#,##0.00', fltDifFle)                          , 22);
            objLiberacao.objMsgLibera.pAddTextoCaption('% Flex Concedido'      , FormatFloat('#,##0.00', fltPercUltr) + '%'                  , 22);
            objLiberacao.objMsgLibera.pAddTextoCaption('% Flex Permitido'      , FormatFloat('#,##0.00', fCfgSis('PERFLE', varDouble)) + '%' , 22, alEsquerda, teAmbos, 'Definido através da configuração CFG_PERFLE');
            objLiberacao.objMsgLibera.pAddSeparador(80);
          End;

          If TMostraTravaMinimaHelper.fExibeTravaMinima Then
            pAdicionaItensTravaMinina;

          cdsMargF4 := TUniClientDataSet.Create(nil);
          Try
            If (fCfgSis('SENFVU') = 'V') Then
            Begin
              itemCalcMar := fGetItemCalcularMargem;
              try
                If blnExecMontaMsgInterna Then
                  pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, itemCalcMar, False, True, Nil, Nil, True, cdsMargF4);
              finally
                FreeAndNil(itemCalcMar);
              end;
            End;

            If (Not blnPedeSenha) Then
              pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem,
                                      objLiberacao.objMsgRemota.fGetMensagem, blnNivel2, blnNivel3);

            objLiberacao.cdsXmlF4 := cdsMargF4;
            objLiberacao.strDirAce := 'PRMIN4';
            objLiberacao.strSenLib := fCfgSis('SENLBD');
            objLiberacao.strMsgSen := 'Trava de Preço';
            objLiberacao.blnMosMen := True;
            objLiberacao.strCodOpe := strCodVen;
            objLiberacao.strCodDig := strCodDig;
            objLiberacao.strCodIte := strCodIte;
            objLiberacao.intAutInc := intAutInc;
            objLiberacao.strCliente := strCodCli + '-' + strCliNom + IIF(strCliOrg = 'S', ' ( *** ÓRGÃO PÚBLICO *** )', '');
            objLiberacao.strCpfCnpj := strCliCgc;

            objLiberacao.blnNivel2 := blnNivel2;
            objLiberacao.strDirAceNv2 := 'PRMIN';

            objLiberacao.blnNivel3 := blnNivel3;
            objLiberacao.strDirAceNv3 := 'PRMIN5';

            objLiberacao.blnNivel4    := blnNivel4;
            objLiberacao.strDirAceNv4 := 'PRMIN2';
            objLiberacao.strSenLibNv4 := fCfgSis('SENLN2');

            objLiberacao.blnNivel5    := blnNivel5;
            objLiberacao.strDirAceNv5 := 'PRMIN6';
            objLiberacao.strSenLibNv5 := fCfgSis('SENLN2');

            objLiberacao.blnNivel6    := blnNivel6;
            objLiberacao.strDirAceNv6 := 'PRMIN3';
            objLiberacao.strSenLibNv6 := fCfgSis('SENLN3');

            objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);
            objLiberacao.cdsXmlTra := cdsTravaMinima;

            objLiberacao.blnEhTravaItemAItemFinalVenda := Self.blnEhTravaItemAItemFinalVenda;

            If Not (blnPedeSenha And fFatMensagemLiberacao(objLiberacao)) Then
            Begin
              With recInfoTravaUnitario Do
              Begin
                strOpcTrvUnit := 'PRMIN4';
                strLibUniComSenha := 'N';
                fltUniLiqCal := fltUniLiqTmp;
                fltMargMin := qryConIte.FieldByName('ITE_MARMIN').AsFloat;
                blnNvl2   := blnNivel2;
                blnNvl3   := blnNivel3;
                blnNvl4   := blnNivel4;
                blnNvl5   := blnNivel5;
                blnNvl6   := blnNivel6;
                fltPreMin := fltUniTraPro;
              End;

              Result := False;
              Exit;
            End
            Else
            Begin
              If Assigned(stlIteLib) And (Not blnEhTravaItemAItemFinalVenda) Then
                stlIteLib.Add(cdsVenda.FieldByName('AUTOINCREM').AsString);

              With recInfoTravaUnitario Do
              Begin
                strOpcTrvUnit := 'PRMIN4';
                strLibUniComSenha := IIF(Self.blnLiberacaoRemotaNoFinalVenda And Self.blnEhTravaItemAItemFinalVenda, 'N', 'S');
                fltUniLiqCal := fltUniLiqTmp;
                fltMargMin := qryConIte.FieldByName('ITE_MARMIN').AsFloat;
                blnNvl2 := blnNivel2;
                blnNvl3 := blnNivel3;
                blnNvl4 := blnNivel4;
                blnNvl5 := blnNivel5;
                blnNvl6 := blnNivel6;
                fltPreMin := fltUniTraPro;
              End;
            End;
          Finally
            FreeAndNil(cdsMargF4);
          End;
        End
        Else
        Begin
          If TMostraTravaMinimaHelper.fExibeTravaMinima Then
          Begin
            pCalculaValoresNiveisDeTrava;
            pAdicionaItensTravaMinina;
          End;
        End;

      End;
    except
      On E: Exception Do
        pMensagensErro(E.Message, '[fValidaUnitario]');
    end;
  finally
    FreeAndNil(objLiberacao);
  end;

  pAtualizaTotalUnitario;
End;

class procedure TFatVenda.pAlterarQuantidadeItensPedido(qryFatGor: TUniQuery);
begin
  Try
    pCriarFormularios(TfrmFatAltQtdeItensPedido, frmFatAltQtdeItensPedido);
    frmFatAltQtdeItensPedido.edtNumDoc.Text := qryFatGor.FieldByName('FGO_NUMDOC').AsString;
    frmFatAltQtdeItensPedido.edtEspDoc.Text := qryFatGor.FieldByName('FGO_ESPDOC').AsString;
    frmFatAltQtdeItensPedido.edtCodEmp.Text := qryFatGor.FieldByName('FGO_CODEMP').AsString;
    frmFatAltQtdeItensPedido.edtDesEmp.Text := fRetNomeEmpresa;
    frmFatAltQtdeItensPedido.blnExpedicao   := False;
    frmFatAltQtdeItensPedido.strNumRom      := fDocumentoEmRomaneio(qryFatGor.FieldByName('FGO_NUMDOC').AsString, qryFatGor.FieldByName('FGO_ESPDOC').AsString);
    frmFatAltQtdeItensPedido.ShowModal;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;
  pFreeAndNil(frmFatAltQtdeItensPedido);
end;

class function TFatVenda.fPedidoPossuiLinkPagamento(strNumDoc, strEspDoc, strCodEmp : String): Boolean;
  var
