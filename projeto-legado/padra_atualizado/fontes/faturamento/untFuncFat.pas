function TFatVenda.fVerificaTransportadoraVinculadaFreteFaixaFaturamento(
  const strCodTransp: String): Boolean;
  Var
    qryGen: TUniQuery;
begin
  qryGen := fCriaQuery;

  Try
    qryGen.SQL.Clear();
    qryGen.SQL.Add(' SELECT T.* ');
    qryGen.SQL.Add(' FROM CADTRA T ');
    qryGen.SQL.Add(' LEFT JOIN CADCID C ON T.TRA_CODCID = C.CID_CODCID ');
    qryGen.SQL.Add(' INNER JOIN CADFRG G ON T.TRA_CODFRG = G.FRG_CODFRG ');
    qryGen.SQL.Add(' INNER JOIN CADFRD D ON G.AUTOINCREM = D.FRD_SEQGER ');
    qryGen.SQL.Add(' WHERE :VLRVEN >= FRD_VALINI  AND :VLRVEN <=  FRD_VALFIN ');
    qryGen.SQL.Add('   AND T.TRA_CODTRA = :CODTRA ');
    qryGen.SQL.Add(' ORDER BY TRA_CODTRA, T.AUTOINCREM; ');

    qryGen.ParamByName('CODTRA').AsString := strCodTransp;
    qryGen.ParamByName('VLRVEN').AsFloat  := fltTotGer;
    qryGen.Open();

    Result := Not qryGen.IsEmpty;
  Finally
    FreeAndNil(qryGen);
  End;
end;

function TFatVenda.fCalculaSugestaoFreteFaixaFaturamento(
  const strCodTransp, strTipFre: String): Double;
  Var
    qryGen: TUniQuery;
begin
  Result := 0;
  qryGen := fCriaQuery;

  Try
    qryGen.SQL.Clear();
    qryGen.SQL.Add('SELECT FRD_VALFRE, FRG_TIPFRE                          ');
    qryGen.SQL.Add('FROM CADFRD D                                          ');
    qryGen.SQL.Add('INNER JOIN CADFRG G ON G.AUTOINCREM = D.FRD_SEQGER     ');
    qryGen.SQL.Add('INNER JOIN CADTRA T ON T.TRA_CODFRG = G.FRG_CODFRG AND ');
    qryGen.SQL.Add('                       T.TRA_CODTRA = :CODTRA          ');
    qryGen.SQL.Add('WHERE                                                  ');
    qryGen.SQL.Add('  :VALTOT >= FRD_VALINI  AND                           ');
    qryGen.SQL.Add('  :VALTOT <=  FRD_VALFIN                               ');

    qryGen.ParamByName('CODTRA').AsString := strCodTransp;
    qryGen.ParamByName('VALTOT').AsFloat  := (fltTotGer - fltFreAnt - IIF(fRetSomaValFrete > 0, fltValFre, 0));
    qryGen.Open();

    If Not qryGen.IsEmpty Then
    begin
      if fCalculaFrete(strTipFre, qryGen.FieldByName('FRG_TIPFRE').AsString) then
        Result := fFormataFloat(qryGen.FieldByName('FRD_VALFRE').AsFloat,2);
    end;

    If (Not Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
      fltFreSug := Result;
  Finally
    FreeAndNil(qryGen);
  End;

  fltFreSugCal := 0;
  If Self.fPossuiSomenteItensRetira() Then
  Begin
    fltFreSugCal := fltFreSug;
    fltFreSug := 0;
    Exit(fltFreSug);
  End;
end;

function TFatVenda.fCalculaSugestaoFreteProdutos(strCodTransp: String; blnCalcPeso: Boolean = False): Double;
  Var
    qryInfIte: TUniQuery;
    intIndMat: Integer;
    strTipFre: String;
    fltVlCFre: Double;
begin
  Result := 0;

  qryInfIte := fCriaQuery;

  With qryInfIte Do
  Begin
    SQL.Add('SELECT ITE_TIPFRE, ITE_VLCFRE FROM CADITE WHERE ITE_CODITE = :CODITE');

    For intIndMat := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If (fItemEntrega(arrMatItens[intIndMat])) Then
      Begin
        With arrMatItens[intIndMat] Do
        Begin
          Close;
          ParamByName('CODITE').AsString := strCodIte;
          Open;

          strTipFre := FieldByName('ITE_TIPFRE').AsString;
          fltVlCFre := FieldByName('ITE_VLCFRE').AsFloat;

          If Not fEmptyStr(strTipFre) Then
          Begin
            Case strTipFre[1] Of
              'P': Result := Result + fFormataFloat((fltTotIte - fltDesEsp) * fltVlCFre / 100, 2);//Percentual
              'F': Result := Result + fFormataFloat(fltVlCFre, 2);                                //Fixo
              'U': Result := Result + fFormataFloat(fltQtdIte * fltVlCFre, 2);                    //Unitário
            End;
          End;
        End;
      End;
    End;

  End;

  If (Not Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
  Begin
    fltFreSug := 0;

    If (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_CIDADE) Then
      fCalculaSugestaoFreteTransportadora(strCodTransp, blnCalcPeso)
    Else If (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_REGIAO) Then
      fCalculaSugestaoFreteTransportadora(strCodTransp, blnCalcPeso, True);

    fltFreSug := fltFreSug + Result;

    If (Not fEmptyStr(strCodTransp)) And (fCfgSis('FRETRA') = FRETRA_POR_PRODUTOS_ADICIONAL_TRANSPORTADORA) Then
      fltFreSug := fltFreSug + fCampoTabela('TRA_VALFRE', 'CADTRA', ['TRA_CODTRA'], [strCodTransp]);
  End;

  FreeAndNil(qryInfIte);

  fltFreSugCal := 0;
  If Self.fPossuiSomenteItensRetira() Then
  Begin
    fltFreSugCal := fltFreSug;
    fltFreSug := 0;
    Exit(fltFreSug);
  End;
end;

function TFatVenda.fCalculaSugestaoFreteTransportadora(strCodTransp: String;
                                                       blnCalcPeso : Boolean = False;
                                                       blnRegiao   : Boolean = False): Double;
Var
  qryFrete    : TUniQuery;
  qryFaixaPeso: TUniQuery;
  fltValorGris: Double;
  fltValorFrete: Double;
  fltPesBruLocal,
  fltPesLiqLocal,
  fltTotProLocal,
  fltDesEspLocal: Double;
  intIndMat: Integer;
  blnCalculaValorFreteSomenteSobreItensEntrega: Boolean;
  fltPerDescFreteFaixa: Double;
  fltValIsencaoFreteFaixa: Double;
  fltValCalculoPercentualValorNota: Double;
begin
  Result := 0;

  fltTotProLocal := Self.fltTotPro;
  fltDesEspLocal := Self.fltDesEsp;
  fltPesBruLocal := Self.fltPesBru;

  blnCalculaValorFreteSomenteSobreItensEntrega := ((fCfgSis('CLPSEN', varBoolean))) And
                                                  ((fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_REGIAO) Or
                                                   (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_CIDADE)) And
                                                  (Not ((blnNotaTintaES) And (fCfgSis('NFTIES') = '1')));

  If blnCalculaValorFreteSomenteSobreItensEntrega Then
  Begin
    fltTotProLocal := 0;
    fltDesEspLocal := 0;
    fltPesBruLocal := 0;

    For intIndMat := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If (Not fItemEntrega(arrMatItens[intIndMat])) Then
        Continue;

      fltTotProLocal := fltTotProLocal + (arrMatItens[intIndMat].fltTotIte);
      fltDesEspLocal := fltDesEspLocal + (arrMatItens[intIndMat].fltDesEsp);
    End;
  End;

  {Transportadora/Cidade}
  If (Not blnRegiao) Then
  Begin

    If blnCalcPeso Then
    Begin
      pCalculaPesBruLiq;
      If (Not blnCalculaValorFreteSomenteSobreItensEntrega) Then
        fltPesBruLocal := Self.fltPesBru;
    End;

    If blnCalculaValorFreteSomenteSobreItensEntrega Then
      pCalculaPesBruLiq(fltPesBruLocal, fltPesLiqLocal);  

    qryFrete := fCriaQuery;
    qryFrete.SQL.Add('SELECT * FROM FRETRA WHERE FRE_CODTRA = :CODTRA AND FRE_CODCID = :CODCID');
    qryFrete.ParamByName('CODTRA').AsString := strCodTransp;
    qryFrete.ParamByName('CODCID').AsString := IIF(fEmptyStr(enderecoEntrega.strCodCid), strCodCid, enderecoEntrega.strCodCid);
    qryFrete.Open;

    fltVlMinF := fCfgSis('VLMINF', varDouble);

    If (Not qryFrete.IsEmpty) Then
    Begin
      {*REQ.159829**********RP*}
      If fCfgSis('ISETRC') = '1' Then
      Begin
        fltPerDescFreteFaixa := 0;
        If (qryFrete.FieldByName('FRE_VALISE').AsFloat > 0) Then
          fltVlMinF := Min(qryFrete.FieldByName('FRE_VALISE').AsFloat, fCfgSis('VLMINF', varDouble));
      End
      Else
      Begin
        fltPerDescFreteFaixa := fRetPerDescFreteFaixaFat(strCodTransp,
                                                         IIF(fEmptyStr(enderecoEntrega.strCodCid), strCodCid, enderecoEntrega.strCodCid),
                                                         fltTotProLocal - fltDesEspLocal);
        fltValIsencaoFreteFaixa := fRetValIsencaoFreteFaixaFat(strCodTransp, IIF(fEmptyStr(enderecoEntrega.strCodCid), strCodCid, enderecoEntrega.strCodCid));
        fltVlMinF := IIF(fltValIsencaoFreteFaixa > 0, fltValIsencaoFreteFaixa, 999999999.99);
      End;

      fltValorGris := fFormataFloat((fltTotProLocal * qryFrete.FieldByName('FRE_PERGRI').AsFloat / 100), 2);
      If fltValorGris < qryFrete.FieldByName('FRE_MINGRI').AsFloat Then
        fltValorGris := fFormataFloat(qryFrete.FieldByName('FRE_MINGRI').AsFloat, 2);

      fltValorFrete := 0;
      If (Not fCfgSis('FREFXP', varBoolean)) And
         (fltPesBruLocal > qryFrete.FieldByName('FRE_COBVAL').AsFloat) Then
        fltValorFrete := fltPesBruLocal * qryFrete.FieldByName('FRE_VALKIL').AsFloat;

      If (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_CIDADE) And
         (fCfgSis('FREFXP', varBoolean)) Then
      Begin
        qryFaixaPeso := fCriaQuery();
        Try
          qryFaixaPeso.SQL.Text := 'SELECT '
                                 + '       X.FAI_PESINI '
                                 + '     , X.FAI_PESFIN '
                                 + '     , X.FAI_VALFRE '
                                 + '  FROM FREFXP X '
                                 + ' INNER JOIN FRETRA F ON X.FAI_SEQFRE = F.AUTOINCREM '
                                 + ' WHERE F.FRE_CODTRA = :CODTRA '
                                 + '   AND F.FRE_CODCID = :CODCID '
                                 + '   AND X.FAI_PESINI = (SELECT max(P.FAI_PESINI) FROM FREFXP P '
                                 + '                        WHERE P.FAI_SEQFRE = F.AUTOINCREM '
                                 + '                          AND P.FAI_PESINI <= :PESBRU) ';

          qryFaixaPeso.ParamByName('CODTRA').AsString := strCodTransp;
          qryFaixaPeso.ParamByName('CODCID').AsString := IIF(fEmptyStr(enderecoEntrega.strCodCid), strCodCid, enderecoEntrega.strCodCid);
          qryFaixaPeso.ParamByName('PESBRU').AsFloat  := fltPesBruLocal;
          qryFaixaPeso.Open;

          fltValorFrete := qryFaixaPeso.FieldByName('FAI_VALFRE').AsFloat;
          If fltPesBruLocal > qryFaixaPeso.FieldByName('FAI_PESFIN').AsFloat Then
          Begin
            fltValorFrete := fltPesBruLocal
                           * qryFrete.FieldByName('FRE_VALKIL').AsFloat;
          End;
        Finally
          FreeAndNil(qryFaixaPeso);
        End;
      End;

      fltValorFrete := fFormataFloat(fltValorFrete, 2);

      fltValCalculoPercentualValorNota := fFormataFloat(fltTotProLocal * qryFrete.FieldByName('FRE_PERTOT').AsFloat / 100, 2);
      If (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_CIDADE) And
         (fltValCalculoPercentualValorNota < qryFrete.FieldByName('FRE_MINNFI').AsFloat) Then
        fltValCalculoPercentualValorNota := qryFrete.FieldByName('FRE_MINNFI').AsFloat;

      Result := fltValCalculoPercentualValorNota +
                fltValorFrete +
                fFormataFloat(fltPesBruLocal / 100 * qryFrete.FieldByName('FRE_PD100K').AsFloat, 2) +
                fltValorGris +
                fFormataFloat(qryFrete.FieldByName('FRE_VALTAS').AsFloat, 2);

      Result := fFormataFloat(Result, 2);

      If Result < qryFrete.FieldByName('FRE_MINFRE').AsFloat Then
        Result := qryFrete.FieldByName('FRE_MINFRE').AsFloat;

      If fltPerDescFreteFaixa > 0 Then
        Result := Result - (Result * (fltPerDescFreteFaixa / 100));

      If (Not Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
        fltFreSug := Result;

      If (fltTotProLocal - fltDesEspLocal >= fltVlMinF) Then
        Result := 0;
    End;

    FreeAndNil(qryFrete);

  End
  Else
  {Transportadora/Região}
  Begin

    If blnCalcPeso Then
    Begin
      pCalculaPesBruLiq;
      If (Not blnCalculaValorFreteSomenteSobreItensEntrega) Then
        fltPesBruLocal := Self.fltPesBru;
    End;

    If blnCalculaValorFreteSomenteSobreItensEntrega Then
      pCalculaPesBruLiq(fltPesBruLocal, fltPesLiqLocal);  

    qryFrete := fCriaQuery;
    qryFrete.SQL.Add('SELECT * FROM TRAREG WHERE TRE_CODTRA = :CODTRA AND TRE_CODREG = :CODREG');
    qryFrete.ParamByName('CODTRA').AsString := strCodTransp;
    qryFrete.ParamByName('CODREG').AsString := IIF(fEmptyStr(enderecoEntrega.strCodReg), strCodReg, enderecoEntrega.strCodReg);
    qryFrete.Open;

    fltVlMinF := fCfgSis('VLMINF', varDouble);

    If (Not qryFrete.IsEmpty) Then
    Begin
      If (qryFrete.FieldByName('TRE_VALISE').AsFloat > 0) Then
        fltVlMinF := Min(qryFrete.FieldByName('TRE_VALISE').AsFloat, fCfgSis('VLMINF', varDouble));

      fltValorGris := fFormataFloat((fltTotProLocal * qryFrete.FieldByName('TRE_PERGRI').AsFloat / 100), 2);
      If fltValorGris < qryFrete.FieldByName('TRE_MINGRI').AsFloat Then
        fltValorGris := fFormataFloat(qryFrete.FieldByName('TRE_MINGRI').AsFloat, 2);

      Result := fFormataFloat(fltTotProLocal * qryFrete.FieldByName('TRE_PERTOT').AsFloat / 100, 2) +
                fFormataFloat(fltPesBruLocal * qryFrete.FieldByName('TRE_VALKIL').AsFloat, 2) +
                fFormataFloat(fltPesBruLocal / 100 * qryFrete.FieldByName('TRE_PD100K').AsFloat, 2) +
                fltValorGris +
                fFormataFloat(qryFrete.FieldByName('TRE_VALTAS').AsFloat, 2);

      Result := fFormataFloat(Result, 2);

      If Result < qryFrete.FieldByName('TRE_MINFRE').AsFloat Then
        Result := qryFrete.FieldByName('TRE_MINFRE').AsFloat;

      If (Not Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
        fltFreSug := Result;

      If (fltTotProLocal - fltDesEspLocal >= fltVlMinF) Then
        Result := 0;
    End;

    FreeAndNil(qryFrete);

  End;

  fltFreSugCal := 0;
  If Self.fPossuiSomenteItensRetira() Then
  Begin
    fltFreSugCal := fltFreSug;
    fltFreSug := 0;
    Exit(fltFreSug);
  End;
end;

function TFatVenda.fValidaFreteSugestao(fltValorFreteSugestao: Double): Boolean;
  Var
    objLiberacao  : TLiberacao;
    cdsData: OleVariant;
    recTotMarLuc : TRecTotaisMargemLucro;
    LblnAlterouFrete : Boolean;
    blnPedeTravaFreteDevolucao: Boolean;
    fltValFreOri, fltValFreOriAnt: Double;
    strCfgTraFre: String;
begin
  Result := True;

  blnPedeTravaFreteDevolucao := (strOpcDoc = 'DV') And (fCfgSis('SENZER', varBoolean));

  If (strOpcDoc = 'DV') And (fFormataFloat(fltValFre, 2) = 0.00) And (fCfgSis('ZVFDEV', varBoolean)) Then
    Exit;

  If (fCfgSis('FRETRA') = FRETRA_NAO_UTILIZA_CALC_FRETE) And (Not blnPedeTravaFreteDevolucao) Then
    Exit;

  If (Pos(strOpcDoc, 'CF_CI_CT_CP_') > 0) Then
    Exit;

  If Pos(strEspDoc, 'PD_OR_NF_EL_NS_MI_FF_DV_') <= 0 Then
    Exit;

  If (fFormataFloat(fltValFre, 2) = 0.00) And
     (fltTotPro - fltDesEsp >= fltVlMinF) Then
    Exit;

  If fltValorFreteSugestao >= 0 Then
  Begin

    If strOpcDoc = 'DV' then
      LblnAlterouFrete := fFormataFloat(FValorFreteOriginalParaDevolucao, 2) <> fFormataFloat(fltValFre, 2)
    Else
      LblnAlterouFrete := fFormataFloat(fltValFre, 2) <> fFormataFloat(fltValorFreteSugestao, 2);

    If LblnAlterouFrete and (Not blnZerouFrete_CFG_ZERFRE) Then
    Begin
      objLiberacao := TLiberacao.Create;
      try

      finally
        FreeAndNil(objLiberacao);
      end;

      cdsData := Self.fCalculaMargemLucro(False);

      Self.pCalculaTotaisMargemLucro(cdsData,
                                     recTotMarLuc);

      fltValFreOri    := fCalculaSugestaoFreteTransportadora(strCodTra, False, (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_REGIAO));
      fltValFreOriAnt := fCalculaSugestaoFreteTransportadora(strCodTraAnt, False, (fCfgSis('FRETRA') = FRETRA_POR_TRANSPORTADORA_REGIAO));

      strCfgTraFre := fCfgSis('TRAFRE', varString);
      If ((strCfgTraFre = 'H') And (fltValorFreteSugestao >= fltValFre)) Or
         ((strCfgTraFre = 'L') And (fltValorFreteSugestao <= fltValFre)) Then
         Exit;

      objLiberacao := TLiberacao.Create;
      try
        If strCfgTraFre = 'H' Then
        Begin
          objLiberacao.strDirAce := 'FREMAI';
          objLiberacao.strMsgSen := 'Alterar valor do frete de sugestão com valor Maior.';
          objLiberacao.objMsgLibera.pAddTexto('Alteração valor do frete de sugestão com valor Maior.');
        End
        Else If strCfgTraFre = 'L' Then
        Begin
          objLiberacao.strDirAce := 'FREMEN';
          objLiberacao.strMsgSen := 'Alterar valor do frete de sugestão com valor Menor.';
          objLiberacao.objMsgLibera.pAddTexto('Alteração valor do frete de sugestão com valor Menor.');
        End
        Else
        Begin
          objLiberacao.strDirAce := 'FRETRA';
          objLiberacao.strMsgSen := 'Alteração do valor do frete sugestão.';
          objLiberacao.objMsgLibera.pAddTexto('Valor do frete sugestão foi alterado.');
        End;

        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
        objLiberacao.objMsgLibera.pAddTexto('Nome da transportadora original: '+strNomTraAnt);

        If strOpcDoc = 'DV' then
          objLiberacao.objMsgLibera.pAddTexto('Valor do frete original: '+FloatToStrF(FValorFreteOriginalParaDevolucao, ffNumber, 12, 2))
        Else
          objLiberacao.objMsgLibera.pAddTexto('Valor do frete original: '+FloatToStrF(fltValFreAnt, ffNumber, 12, 2));

        objLiberacao.objMsgLibera.pAddTexto('Valor do frete do cadastro da transportadora original: '+FloatToStrF(fltValFreOriAnt, ffNumber, 12, 2));

        objLiberacao.objMsgLibera.pAddTexto('Nome da Transportadora alterado: '+strNomTra);
        objLiberacao.objMsgLibera.pAddTexto('Valor do frete alterado: '+FloatToStrF(fltValFre, ffNumber, 12, 2));
        objLiberacao.objMsgLibera.pAddTexto('Valor do frete do cadastro da transportadora alterado: '+FloatToStrF(fltValFreOri, ffNumber, 12, 2));
        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');

        if (fCfgSis('EMLTFA', varBoolean)) then
        begin
          objLiberacao.objMsgLibera.pAddTexto('Margem de lucro: '+FloatToStrF(TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, False), ffNumber, 12, 2));
          objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
        end;

        objLiberacao.objMsgLibera.pAddTexto('Valor total do documento: '+FloatToStrF(fltTotGer, ffNumber, 12, 2));
        objLiberacao.objMsgLibera.pAddTexto('Vendedor: ('+strCodVen+') - '+strNomVen);
        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');

        If Not fEmptyStr(strEndEnt) Then
        Begin
          objLiberacao.objMsgLibera.pAddTexto('Endereço de entrega');
          objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
          objLiberacao.objMsgLibera.pAddTexto('Endereço: '+strEndEnt +', Bairro: '+ strBaiEnt +', CEP: '+strCepEnt);

          If Not fEmptyStr(strRefEnt) Then
            objLiberacao.objMsgLibera.pAddTexto('Referência: '+ strRefEnt);

          objLiberacao.objMsgLibera.pAddTexto('Cidade: '+ strNomCidEnt +', Estado: '+ strEstEnt);
          objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');
        End;

        objLiberacao.objMsgLibera.pAddTexto('Peso Total do Pedido: '+FloatToStrF(fltPesBru, ffNumber, 12, 2));
        objLiberacao.objMsgLibera.pAddTexto('Previsão de Entrega: ' +FormatDateTime('dd/mm/yyyy', dtaPreVis));
        objLiberacao.objMsgLibera.pAddTexto('---------------------------------------------------');

        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom;
        objLiberacao.blnUsarSenhaFixa := False;
        objLiberacao.blnSempreVariavelUsuario := True;

        Result := fFatMensagemLiberacao(objLiberacao);

        if (Result) and (strOpcDoc = 'DV') then
          FValorFreteOriginalParaDevolucao := fFormataFloat(fltValFre, 2);

      finally
        FreeAndNil(objLiberacao);
      end;

    End;
  End;
end;

function TFatVenda.fRetornaPreVenProdAcabado(Var item: TDadosFechamento): Double;
  Var
    strTabela: String;
begin
  strTabela := strTabPre;

  If Not fEmptyStr(strTabTin) Then
    strTabela := strTabTin;

  If (blnCliFil) Then
  Begin
    If (strTabela = '1') Then
      Result := item.fltPreVe1
    Else If (strTabela = '2') Then
      Result := item.fltPreVe2
    Else If (strTabela = '3') Then
      Result := item.fltPreVe3
    Else If (strTabela = '4') Then
      Result := item.fltPreVe4
    Else If (strTabela = '5') Then
      Result := item.fltPreVe5
    Else If (strTabela = '6') Then
      Result := item.fltPreVe6
    Else If (strTabela = '7') Then
      Result := item.fltPreVe7
    Else
      Result := item.fltPreVe1;
  End
  Else
    Result := item.fltUniTar;
end;

