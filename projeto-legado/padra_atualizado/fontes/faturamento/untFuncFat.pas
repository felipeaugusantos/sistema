function TFatVenda.fVerificarLarguraItem(strCodIte: String;
  intLargura: Integer; out strLargurasPermitidas: String; out fltQtdPermit: Double; out fltQtdLargAcima: Double; out intLamAvi: integer): Boolean;
  Var
    i: Integer;
    qryTemp: TUniQuery;
    intLarMin: Integer;
begin
  Result := True;

  If (Not fCfgSis('VENVID', varBoolean)) Then Exit;

  strLargurasPermitidas := '';

  Try
    qryTemp := fCriaQuery();

    Try
      qryTemp.Close();
      qryTemp.SQL.Clear();
      qryTemp.SQL.Text := 'SELECT ITE_LARMIN, ITE_LAMAVI FROM CADITE WHERE ITE_CODITE = :CODITE';
      qryTemp.ParamByName('CODITE').AsString := strCodIte;
      qryTemp.Open();

      intLarMin := qryTemp.FieldByName('ITE_LARMIN').AsInteger;
      intLamAvi := qryTemp.FieldByName('ITE_LAMAVI').AsInteger;

      If (intLarMin > 0) And (intLamAvi > 0) And (intLargura > 0) Then Begin
        If (Not ((intLamAvi mod intLargura) = 0)) Then Begin
          For i := intLarMin To intLamAvi Do
            If ((intLamAvi mod i) = 0) And (i > intLargura) Then Begin
              If (fEmptyStr(strLargurasPermitidas)) Then
                fltQtdLargAcima := i;
              strLargurasPermitidas := strLargurasPermitidas + IntToStr(i) + ', ';
            End;
        End;
      End;

      If (Not fEmptyStr(strLargurasPermitidas)) Then Begin
        strLargurasPermitidas := Copy(strLargurasPermitidas, 1, Length(strLargurasPermitidas) - 2);
        Result := False;
      End;

      If (Result) Then Begin
        fltQtdPermit := (intLamAvi / intLargura);
        Exit;
      End;
    Except
      On E: Exception Do Begin
        Result := False;
        pMensagensErro(E.Message, '[TFatVenda.fVerificarLarguraItem]');
      End;
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

