      objCopyDataSet.AddSequenceFields('ITE_ORDITE');
      objCopyDataSet.AddSequenceFields('PED_SEQENC');
      objSQLItensPedido := TSQLItensPedido.Create(fGetInputSQLItens(EmptyStr, EmptyStr, strNumRom, blnCarregarItens, blnAlteraOrcamentoOutraLoja));
      Try
        qryGen.Close;
        qryGen.SQL.Clear;
        qryGen.SQL.Add(objSQLItensPedido.fGetSQL);
        qryGen.ParamByName('CODEMP').AsString := IIF(fEmptyStr(strEmp_TE), VS_strCodEmp, strEmp_TE);
        qryGen.ParamByName('NUMDOC').AsString := strNumOrc;
        qryGen.ParamByName('ESPDOC').AsString := strEspOrc;
        qryGen.ParamByName('EMPDOC').AsString := IIF((strOpcDoc = 'OR') And (Not (fOrcamentoOutraLojaF11 Or fOrcamentoOutraLojaORVN)) , VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri));
        qryGen.Open;
      Finally
        FreeANdNil(objSQLItensPedido);
      End;

      objMapperProcessValue := TMapperProcessValuePedidoVenda.GetMapperProcessValue(VS_intDecUni);
      Try
        objMapperFields := TMapperFieldsPedidoVenda.GetMapperFields(False);
