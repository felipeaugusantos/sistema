procedure TFatVenda.pMostraDebitosCheques;
begin

  If fEmptyStr(strCodCli) Then
    Exit;

  If Assigned(prcExecutaRelatorio) Then
  begin
    prcExecutaRelatorio(141, 6600, [],
                        ['CODCLI','TRFTCR'],
                        [strCodCli,
                        fCfgSis('TRFTCR', varString)],
                        nil,
                        nil,
                        True,
                        False);
  End;

end;

function TFatVenda.fRetConPagRef(strCodCndExterno: String=''): String;
begin
  Result := Self.strConPagOri;

  If Not fEmptyStr(Result) Then
  Begin
    If ((Not fEmptyStr(Self.strCodCnd)) And (Self.strCodPagOri<>Self.strCodCnd)) Or
       ((Not fEmptyStr(strCodCndExterno)) And (Self.strCodPagOri<>strCodCndExterno)) Then
    Begin
      Result := '';
    End;
  End;
end;

procedure TFatVenda.pMostraDebitosReceber;
begin

  If fEmptyStr(strCodCli) Then
    Exit;

  If Assigned(prcExecutaRelatorio) Then
  begin
    prcExecutaRelatorio(142, 6617, [],
                        ['CODCLI','TRFTCR','PDVLIM','EXIPOR','CODEMP'],
                        [strCodCli,
                        fCfgSis('TRFTCR', varString),
                        IIf(fCfgSis('PDVLIM', varBoolean),'S','N'),
                        IIf(fCfgSis('EXIPOR', varBoolean),'S','N'),
                        VS_strCodEmp],
                        nil,
                        nil,
                        True,
                        False);
  End;

end;

function TFatVenda.fAtualizaCampo_MOVOBS_MOV_DISSER(strAutInc: String): Boolean;
Var
  qryAux    : TUniQuery;
  strInfCCR : String;
  strEndEnt : String;

  strDocSer : String;
  strEspSer : String;
  strEmpSer : String;

  strPedido : String;
  strNFeRem : String;

  cdsEstruturas     : TUniClientDataSet;
  cdsItensEstrutura : TUniClientDataSet;

Const

  Pula_uma_Linha = '#';

  SQL_ITENS = 'SELECT * FROM MOVDET WHERE DET_SEQGER = :AUTINC';

  SQL_ESTRUTURA = 'SELECT          ' +
                  '  D.DMT_ITESUB, ' +
                  '  D.DMT_QTDITE, ' +
                  '  I.ITE_DESITE, ' +
                  '  U.UNI_SIGUNI  ' +
                  'FROM            ' +
                  '  GERMAT G      ' +
                  '  INNER JOIN DETMAT D ON (D.DMT_SEQGER = G.AUTOINCREM) ' +
                  '  INNER JOIN CADITE I ON (I.ITE_CODITE = D.DMT_ITESUB) ' +
                  '  INNER JOIN CADUNI U ON (U.UNI_CODUNI = I.ITE_CODUNI) ' +
                  'WHERE                                                  ' +
                  '  G.GMT_CODITE = :CODITE';

  SQL_PEDIDOS = 'SELECT                                                                        ' +
                '  CONCAT(PED.FGO_NUMDOC, "-", PED.FGO_ESPDOC, "-", PED.FGO_CODEMP) AS DOCUME, ' +
                '  PED.FGO_NUMDOC, ' +
                '  PED.FGO_ESPDOC, ' +
                '  PED.FGO_CODEMP, ' +
                '  NFE.GER_NUMDOC  ' +
                'FROM              ' +
                '  MOVGER NFS      ' +
                '  INNER JOIN MOVGER NFE ON (NFE.GER_NUMFAT = NFS.GER_NUMDOC AND ' +
                '                            NFE.GER_TIPFAT = NFS.GER_ESPDOC AND ' +
                '                            NFE.GER_EMPFAT = NFS.GER_CODEMP)    ' +
                '  INNER JOIN FATGOR PED ON (PED.FGO_NUMFAT = NFE.GER_NUMDOC AND ' +
                '                            PED.FGO_TIPFAT = NFE.GER_ESPDOC AND ' +
                '                            PED.FGO_EMPFAT = NFE.GER_CODEMP)    ' +
                'WHERE NFS.GER_NUMDOC = :NUMDOC ' +
                '  AND NFS.GER_ESPDOC = :ESPDOC ' +
                '  AND NFS.GER_CODEMP = :EMPDOC ';

begin

  If strAutInc.IsEmpty Then
    Exit(True);

  Try

    qryAux := fCriaQuery(Self);

    strInfCCR := '';
    strEndEnt := '';

    strDocSer := '';
    strEspSer := '';
    strEmpSer := '';

    strPedido := '';
    strNFeRem := '';

    Try

      cdsEstruturas := TUniClientDataSet.Create(Nil);

      With cdsEstruturas.FieldDefs.AddFieldDef Do
      Begin
        Name     := 'ITEM';
        DataType := ftString;
        Size     := 100;
        Required := False;
      End;

      With cdsEstruturas.FieldDefs.AddFieldDef Do
      Begin
        Name     := 'QTDE';
        DataType := ftFloat;
        Required := False;
      End;

      cdsEstruturas.CreateDataSet;
      cdsEstruturas.EmptyDataSet;

      cdsItensEstrutura := TUniClientDataSet.Create(Nil);

      With cdsItensEstrutura.FieldDefs.AddFieldDef Do
      Begin
        Name     := 'ITEM';
        DataType := ftString;
        Size     := fTamCodIte;
        Required := False;
      End;

      With cdsItensEstrutura.FieldDefs.AddFieldDef Do
      Begin
        Name     := 'DESC';
        DataType := ftString;
        Size     := 100;
        Required := False;
      End;

      With cdsItensEstrutura.FieldDefs.AddFieldDef Do
      Begin
        Name     := 'UNID';
        DataType := ftString;
        Size     := 4;
        Required := False;
      End;

      With cdsItensEstrutura.FieldDefs.AddFieldDef Do
      Begin
        Name     := 'QTDE';
        DataType := ftFloat;
        Required := False;
      End;

      cdsItensEstrutura.CreateDataSet;
      cdsItensEstrutura.EmptyDataSet;

      {Identifica item(ns) de concreto}
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(SQL_ITENS);
      qryAux.ParamByName('AUTINC').AsString := strAutInc;
      qryAux.Open;

      If Not qryAux.IsEmpty Then
      Begin

        qryAux.First;
        While Not qryAux.Eof Do
        Begin

          If fItemConcreto(qryAux.FieldByName('DET_CODITE').AsString) Then
          Begin

            If cdsEstruturas.Locate('ITEM', qryAux.FieldByName('DET_CODITE').AsString, []) Then
            Begin
              cdsEstruturas.Edit;
              cdsEstruturas.FieldByName('QTDE').AsFloat := cdsEstruturas.FieldByName('QTDE').AsFloat + qryAux.FieldByName('DET_QTDITE').AsFloat;
              cdsEstruturas.Post;
            End
            Else
            Begin
              cdsEstruturas.Append;
              cdsEstruturas.FieldByName('ITEM').AsString := qryAux.FieldByName('DET_CODITE').AsString;
              cdsEstruturas.FieldByName('QTDE').AsFloat  := qryAux.FieldByName('DET_QTDITE').AsFloat;
              cdsEstruturas.Post;
            End;

            {NFS-e}
            strDocSer := qryAux.FieldByName('DET_NUMDOC').AsString;
            strEspSer := qryAux.FieldByName('DET_ESPDOC').AsString;
            strEmpSer := qryAux.FieldByName('DET_CODEMP').AsString;

          End;

          qryAux.Next;

        End;

      End;

      {Consolida SUB-ITENS de estruturas, pois pode ser confirmado N notas de remessa juntamente!}
      If Not cdsEstruturas.IsEmpty Then
      Begin

        cdsEstruturas.First;
        While Not cdsEstruturas.Eof Do
        Begin

          qryAux.Close;
          qryAux.SQL.Clear;
          qryAux.SQL.Add(SQL_ESTRUTURA);
          qryAux.ParamByName('CODITE').AsString := cdsEstruturas.FieldByName('ITEM').AsString;
          qryAux.Open;

          If Not qryAux.IsEmpty Then
          Begin

            qryAux.First;
            While Not qryAux.Eof Do
            Begin

              If cdsItensEstrutura.Locate('ITEM', qryAux.FieldByName('DMT_ITESUB').AsString, []) Then
              Begin
                cdsItensEstrutura.Edit;
                cdsItensEstrutura.FieldByName('QTDE').AsFloat  := cdsItensEstrutura.FieldByName('QTDE').AsFloat + (cdsEstruturas.FieldByName('QTDE').AsFloat * qryAux.FieldByName('DMT_QTDITE').AsFloat);
                cdsItensEstrutura.Post;
              End
              Else
              Begin
                cdsItensEstrutura.Append;
                cdsItensEstrutura.FieldByName('ITEM').AsString := qryAux.FieldByName('DMT_ITESUB').AsString;
                cdsItensEstrutura.FieldByName('DESC').AsString := qryAux.FieldByName('ITE_DESITE').AsString;
                cdsItensEstrutura.FieldByName('QTDE').AsFloat  := (cdsEstruturas.FieldByName('QTDE').AsFloat * qryAux.FieldByName('DMT_QTDITE').AsFloat);
                cdsItensEstrutura.FieldByName('UNID').AsString := qryAux.FieldByName('UNI_SIGUNI').AsString;
                cdsItensEstrutura.Post;
              End;

              qryAux.Next;

            End;

          End;

          cdsEstruturas.Next;

        End;

        {Imprime aqui sub-itens consolidados das estruturas}
        If Not cdsItensEstrutura.IsEmpty Then
        Begin

          strInfCCR := 'Qtd.: Agregados' + Pula_uma_Linha + Pula_uma_Linha;

          cdsItensEstrutura.First;
          While Not cdsItensEstrutura.Eof Do
          Begin

            strInfCCR := strInfCCR + cdsItensEstrutura.FieldByName('DESC').AsString + ': ' + FormatFloat('###,###,##0.00', cdsItensEstrutura.FieldByName('QTDE').AsFloat) + ' ' +
                                                                                                                           cdsItensEstrutura.FieldByName('UNID').AsString + Pula_uma_Linha;
            cdsItensEstrutura.Next;

          End;

          strInfCCR := strInfCCR + Pula_uma_Linha;

        End;

        {Endereço de entrega}
        strEndEnt := fDescricaoEnderecoEntrega;
        If Not strEndEnt.IsEmpty Then
          strInfCCR := strInfCCR + 'Entrega: ' + strEndEnt + Pula_uma_Linha;

        {Pedido(s)}
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(SQL_PEDIDOS);
        qryAux.ParamByName('NUMDOC').AsString := strDocSer;
        qryAux.ParamByName('ESPDOC').AsString := strEspSer;
        qryAux.ParamByName('EMPDOC').AsString := strEmpSer;
        qryAux.Open;

        If Not qryAux.IsEmpty Then
        Begin

          strPedido := '';
          strNFeRem := '';

          qryAux.First;
          While Not qryAux.Eof Do
          Begin

            If Not strPedido.IsEmpty Then
            Begin
              strPedido := strPedido + ', ' + qryAux.FieldByName('FGO_NUMDOC').AsString;
              strNFeRem := strNFeRem + ', ' + qryAux.FieldByName('GER_NUMDOC').AsString;
            End
            Else
            Begin
              strPedido := strPedido + qryAux.FieldByName('FGO_NUMDOC').AsString;
              strNFeRem := strNFeRem + qryAux.FieldByName('GER_NUMDOC').AsString;
            End;

            qryAux.Next;

          End;

        End;

        If Not strPedido.IsEmpty Then
          strInfCCR := strInfCCR + 'Pedido(s): ' + strPedido + Pula_uma_Linha;

        {NFe de remessa}
        If Not strNFeRem.IsEmpty Then
          strInfCCR := strInfCCR + 'NFe: Simples remessa de nº: ' + strNFeRem + Pula_uma_Linha + Pula_uma_Linha;

        {Valor dos tributos aproximados}
        If fltMunImp > 0 Then
          strInfCCR := strInfCCR + 'Valor aproximado dos tributos: R$ ' + FormatFloat('###,###,##0.00', fltMunImp);

        {Atualiza MOVOBS}
        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add('SELECT * FROM MOVOBS WHERE MOV_SEQGER = :SEQGER');
        qryAux.ParamByName('SEQGER').AsString := strAutInc;
        qryAux.Open;

        If (Not qryAux.IsEmpty) And (Not strInfCCR.IsEmpty) Then
        Begin
          qryAux.Edit;
          If (Not qryAux.FieldByName('MOV_DISSER').IsNull) Then
            qryAux.FieldByName('MOV_DISSER').AsString := qryAux.FieldByName('MOV_DISSER').AsString + Pula_uma_Linha + strInfCCR
          Else
            qryAux.FieldByName('MOV_DISSER').AsString := strInfCCR;
          qryAux.Post;
        End;

      End;

    Finally

      If Assigned(cdsEstruturas) Then
        FreeAndNil(cdsEstruturas);

      If Assigned(cdsItensEstrutura) Then
        FreeAndNil(cdsItensEstrutura);

      If Assigned(qryAux) Then
        FreeAndNil(qryAux);

    End;

    Result := True;

  Except
    Result := False;
  End;

end;

function TFatVenda.fAtualizaDesCff(strMovDet: String; intIncMat: Integer): Boolean;
  Var
    qryAux: TUniQuery;
    intContador: Integer;
begin
  Try
    If blnNotEsp Or blnCupEsp Or (strOpcDoc = 'CN') Then
    Begin
      Result := True;
      Exit;
    End;

    qryAux := fCriaQuery(Self);
    qryAux.SQL.Add('UPDATE ' + strMovDet + ' SET DET_DESCFF = :DESCFF WHERE AUTOINCREM = :AUTINC');
    Try
      For intContador := 0 To Length(arrDesCffDet)-1 Do
      Begin
        If (arrDesCffDet[intContador].intIncMat = intIncMat) Then
        Begin
          qryAux.Close;
          qryAux.ParamByName('DESCFF').AsFloat  := arrDesCffDet[intContador].fltValCff;
          qryAux.ParamByName('AUTINC').AsString := arrDesCffDet[intContador].strSeqDet;
          qryAux.ExecSQL;
        End;
      End;
    Finally
      FreeAndNil(qryAux);
    End;

    Result := True;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fAtualizaDesCff]');
    End;
  End;
end;

