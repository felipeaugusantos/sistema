                                  'REF. Duplicata ' + Self.arrDocConsignacao[intIndice].strNumDup, // Histórico Baixa
                                  strCtaBai,                                            // Centro de Custo Baixa
                                  fCfgSis('PORRCX'),                                    // Portador Baixa
