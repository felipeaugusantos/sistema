function TFatVenda.fAgruparItensMesmasCaracteristicasPedido: Boolean;
  Var
    itemPedido: TDadosFechamento;
    itensNovos: TMatrizFechamento;
    intIdxItem: Integer;

  function fItemPodeAgrupar(item: TDadosFechamento): Boolean;
  begin
    Result := True;
    //Nao pode ser tinta
    Result := Result And (item.strIdePro = 'NOR');
    //Nao pode ser servicos, frete, bombeamento ou taxa (concreto)
    Result := Result And (item.strCodIte <> fCfgSis('ITESER'));
    Result := Result And (item.strCodIte <> fCfgSis('SERTER'));
    Result := Result And (item.strCodIte <> fCfgSis('ITEFRE'));
    Result := Result And (item.strCodIte <> fCfgSis('ITEBOM'));
    Result := Result And (item.strCodIte <> fCfgSis('ITEMAN'));
    Result := Result And (item.strCodIte <> fCfgSis('ITELAN'));
    Result := Result And (item.strCodIte <> fCfgSis('ITETAX'));
    //Nao pode ser item especial
    Result := Result And (Pos('ITEM ESPECIAL', item.strDesOri) <= 0);
    //Nao pode ser item concreto
    Result := Result And (Not fEhItemConcreto(item.strCodIte));
    //Nao pode ser item vidro
    Result := Result And (Not fEhItemVendaVidro(item.strCodIte));
    //O item pode ser alterado
    Result := Result And (item.blnPodAlt);
    //Nao pode possuir baixa parcial
    Result := Result And (item.fltQtdBai = 0);
    //Nao pode possuir servico ratiado
    Result := Result And (item.fltFatRat = 0);
    Result := Result And (item.fltSerRat = 0);
    //Nao pode ser produto acabado
    Result := Result And (Not item.blnProAca);
    Result := Result And (fEmptyStr(item.strCodAca));
    Result := Result And (fEmptyStr(item.strEmpAca));
    //Nao pode possuir ordem de producao
    Result := Result And (fEmptyStr(item.strOrdPro));
  end;

  function fMesmoPreco(fltValorA, fltValorB: Double): Boolean;
  begin
    Result := fFormataFloat(fltValorA, VS_intDecUni) =
              fFormataFloat(fltValorB, VS_intDecUni);
  end;

  function fEhMesmoItem(itemA, itemB: TDadosFechamento): Boolean;
  begin
    Result := True;
    Result := Result And (itemA.strCodIte = itemB.strCodIte);
    Result := Result And (itemA.strIdePro = itemB.strIdePro);
    Result := Result And (itemA.strDesIte = itemB.strDesIte);
    Result := Result And (itemA.strNumLot = itemB.strNumLot);
    Result := Result And (itemA.strEntSai = itemB.strEntSai);
    Result := Result And (itemA.strCodUni = itemB.strCodUni);
    Result := Result And (itemA.blnProAca = itemB.blnProAca);
    Result := Result And (itemA.strCodAca = itemB.strCodAca);
    Result := Result And (itemA.strEmpAca = itemB.strEmpAca);
    Result := Result And (itemA.strEmpIte = itemB.strEmpIte);
    Result := Result And (itemA.strEmpPrd = itemB.strEmpPrd);
    Result := Result And (itemA.strEmpSol = itemB.strEmpSol);
    Result := Result And (itemA.strBxSbIt = itemB.strBxSbIt);
    Result := Result And (itemA.strEntRet = itemB.strEntRet);
    Result := Result And (itemA.strLocRet = itemB.strLocRet);
    Result := Result And (itemA.strEntFut = itemB.strEntFut);
    Result := Result And (itemA.strMotFut = itemB.strMotFut);
    Result := Result And (itemA.strTurEnt = itemB.strTurEnt);
    Result := Result And (itemA.dtaDtEntr = itemB.dtaDtEntr);
    Result := Result And (itemA.strCliBus = itemB.strCliBus);
    Result := Result And (itemA.strMotFut = itemB.strMotFut);
    Result := Result And (itemA.strTabPre = itemB.strTabPre);
    Result := Result And (itemA.strCodMec = itemB.strCodMec);

    //Compara os vendedores dos produtos
    If fUsaVendedorDoItemParaComissao(itemA.strCodVen) Or
       fUsaVendedorDoItemParaComissao(itemB.strCodVen) Then
    Begin
      Result := Result And (itemA.strCodVen = itemB.strCodVen);
    End;

    //Compara os vendedores 2 dos produtos
    If fUsaVendedorDoItemParaComissao(itemA.strCodVe2) Or
       fUsaVendedorDoItemParaComissao(itemB.strCodVe2) Then
    Begin
      Result := Result And (itemA.strCodVe2 = itemB.strCodVe2);
    End;

    //Compara os precos unitarios dos produtos inclusive o preco de custo
    Result := Result And fMesmoPreco(itemA.fltUniTar, itemB.fltUniTar);
    Result := Result And fMesmoPreco(itemA.fltUniOri, itemB.fltUniOri);
    Result := Result And fMesmoPreco(itemA.fltUniDig, itemB.fltUniDig);
    Result := Result And fMesmoPreco(itemA.fltUniVis, itemB.fltUniVis);
    Result := Result And fMesmoPreco(itemA.fltUniTmp, itemB.fltUniTmp);
    Result := Result And fMesmoPreco(itemA.fltDesCon, itemB.fltDesCon);
    Result := Result And fMesmoPreco(itemA.fltCusIte, itemB.fltCusIte);
    Result := Result And fMesmoPreco(itemA.fltPreCus, itemB.fltPreCus);
  end;

  function fGetIdMesmoItem(item: TDadosFechamento): Integer;
    Var
      intIndex: Integer;
  begin
    Result := -1;

    If Not fItemPodeAgrupar(item) Then
      Exit;

    For intIndex := Low(itensNovos) to High(itensNovos) do
    Begin
      If fItemPodeAgrupar(itensNovos[intIndex]) And
         fEhMesmoItem(item, itensNovos[intIndex]) Then
      Begin
        Result := intIndex;
        Break;
      End;
    End;

  end;

begin
  Result := True;

  If Not Self.FAgrIte Then
    Exit;

  If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
    Exit;

  If fEhVendaItemConcreto Then
    Exit;

  Try
    SetLength(itensNovos, 0);
    Self.FAgrIteAplicado := False;

    For itemPedido In arrMatItens Do
    Begin
      intIdxItem := fGetIdMesmoItem(itemPedido);
      //Se nao encontrou nenhum item com mesmas caracteristicas
      If intIdxItem = -1 Then
      Begin
        SetLength(itensNovos, Length(itensNovos) + 1);
        itensNovos[Length(itensNovos) - 1] := itemPedido;
      End
      //se encontrou um item com mesmas caracteristicas
      Else
      Begin
        itensNovos[intIdxItem].fltQtdIte := itensNovos[intIdxItem].fltQtdIte + itemPedido.fltQtdIte;
        itensNovos[intIdxItem].fltTotIte := itensNovos[intIdxItem].fltTotIte + itemPedido.fltTotIte;
        itensNovos[intIdxItem].fltTotCus := itensNovos[intIdxItem].fltTotCus + itemPedido.fltTotCus;
        itensNovos[intIdxItem].fltTotCu2 := itensNovos[intIdxItem].fltTotCu2 + itemPedido.fltTotCu2;
        itensNovos[intIdxItem].fltTotMed := itensNovos[intIdxItem].fltTotMed + itemPedido.fltTotMed;
        itensNovos[intIdxItem].fltTotUlt := itensNovos[intIdxItem].fltTotUlt + itemPedido.fltTotUlt;
        itensNovos[intIdxItem].fltTotImp := itensNovos[intIdxItem].fltTotImp + itemPedido.fltTotImp;
        Self.FAgrIteAplicado := True;
      End;
    End;

    SetLength(arrMatItens, Length(itensNovos));

    For intIdxItem := Low(itensNovos) to High(itensNovos) Do
    Begin
      arrMatItens[intIdxItem] := itensNovos[intIdxItem];
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      Self.FAgrIteAplicado := True;
      pMensagensErro(E.Message, '');
    End;
  End;
end;

procedure TFatVenda.pAjustarINC_PD_Na_MOVAUX(strINC_PD_Antigo, strINC_PD_Novo: String);
var
  qryAux        : TUniQuery;
  strDet_SeqGer : String;
const
  SQL_MOVAUX = 'SELECT DET_SEQGER FROM MOVAUX WHERE DET_INC_PD = :INC_PD';
  SQL_UPDATE = 'UPDATE MOVAUX SET DET_INC_PD = :INC_PD WHERE DET_SEQGER = :SEQGER';
begin

  strDet_SeqGer := '';

  If strINC_PD_Antigo.IsEmpty Then
    Exit;

  If strINC_PD_Novo.IsEmpty Then
    Exit;

  qryAux := fCriaQuery;

  Try

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(SQL_MOVAUX);
    qryAux.ParamByName('INC_PD').AsString := strINC_PD_Antigo;
    qryAux.Open;

    If Not qryAux.IsEmpty Then
    Begin

      strDet_SeqGer := qryAux.FieldByName('DET_SEQGER').AsString;

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add(SQL_UPDATE);
      qryAux.ParamByName('SEQGER').AsString := strDet_SeqGer;
      qryAux.ParamByName('INC_PD').AsString := strINC_PD_Novo;
      qryAux.ExecSQL;

    End;

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TFatVenda.fAjustaBarCom: Boolean;
var
  qryUpdate: TUniQuery;
begin
  Result := True;

  if fEmptyStr(strNumOrc) or fEmptyStr(strEspOrc) or fEmptyStr(strEmpOri) then
    Exit;

  if not fCfgSis('COMAND', VarBoolean) then
    Exit;

  try
    qryUpdate := fCriaQuery;
    try
      qryUpdate.SQL.Add('UPDATE EXTGOR');
      qryUpdate.SQL.Add('INNER JOIN FATGOR ON AUTOINCREM = FGO_SEQFGO');
      qryUpdate.SQL.Add('SET FGO_BARCOM = NULL');
      qryUpdate.SQL.Add('WHERE FGO_NUMDOC = :NUMDOC');
      qryUpdate.SQL.Add('  AND FGO_ESPDOC = :ESPDOC');
      qryUpdate.SQL.Add('  AND FGO_CODEMP = :CODEMP');

      qryUpdate.ParamByName('NUMDOC').AsString := strNumOrc;
      qryUpdate.ParamByName('ESPDOC').AsString := strEspOrc;
      qryUpdate.ParamByName('CODEMP').AsString := strEmpOri;

      qryUpdate.ExecSQL;

    finally
      FreeAndNil(qryUpdate);
    end;
  except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '');
    End;
  end;
end;

