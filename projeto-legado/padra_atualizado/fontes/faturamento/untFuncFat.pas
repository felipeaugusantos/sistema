      Begin
        blnFilKar := fGeraEstoqueBaixaOrdProEstrutura(arrMatItens[intPosMat]).ToFilKar;
      End
      Else
        Result := False;

    End;

    blnGravarCodAca  := True;

    If (Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0) Then
