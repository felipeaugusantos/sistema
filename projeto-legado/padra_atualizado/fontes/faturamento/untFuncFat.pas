function fValidarEmitirCTe(fatVenda: TFatVenda): Boolean;
begin
  Result := True;
  {$IFDEF TESTABILIDADE_AUTCOM}
    // Não testa se o painel está aberto
  {$ELSE}
  if fSeForEmitirCTePainelNaoEstaAberto(fatVenda.objDadosCte.blnGrava, fatVenda.objDadosCte.strCodEmp) then
  begin
    fMensagem('ATENÇÃO!', 'Atenção: o PainelNFe da loja (' + fatVenda.objDadosCte.strCodEmp + ') não está aberto. Por favor verifique e feche a venda novamente.', ['&Ok']);
    Result := False;
  end;

  if fSeForEmitirCTEAutcomNaoEstaAberto(fatVenda.objDadosCte.blnGrava, fatVenda.objDadosCte.strCodEmp) then
  begin
    fMensagem('ATENÇÃO!', 'Atenção: o Autcom da loja (' + fatVenda.objDadosCte.strCodEmp + ') não está aberto.' + #13 +
                          'Pelo menos um Autcom logado nesta loja precisa estar aberto para Importar os CTes emitidos.' + #13 +
                          'Por favor verifique e feche a venda novamente.', ['&Ok']);
    Result := False;
  end;
  {$ENDIF}
end;

function fExisteDivergenciaImpostosItensExpedidos(fatVenda: TFatVenda): Boolean;
var
  strInformacao: String;
begin
  Result := False;

  If Not fatVenda.blnExpedi Then
    Exit;

  If Not fCfgSis('TRSTIP', varBoolean) Then
    Exit;

  If fatVenda.fZerarImpostosDaRemessaDeEstoqueExterno Then
    Exit;

  If fatVenda.fExisteDivergenciaBrutaRETOuIPI(strInformacao) Then
  begin
    If fatVenda.fAtendeRegraFiscalEndEntrega Then
      fMensagem('ATENÇÃO!', 'O valor de '+strInformacao+' está divergente entre o Pedido e o Documento a ser gerado!' + sLineBreak +
                            'Esse cliente é construtora e esta configurado para calcular impostos usando endereço de entrega.' + sLineBreak +
                            'Verifique a necessidade de regravar o pedido de venda para atualizar o endereço de entrega e os valores!', ['&OK'])
    Else
      fMensagem('ATENÇÃO!', 'O valor de '+strInformacao+' está divergente entre o Pedido e o Documento a ser gerado!' + sLineBreak +
                            'Verifique se há a necessidade de regravar o pedido de venda para atualizar os valores!', ['&OK']);
    Result := True;
  End;
end;

function fEhAbastecimentoPorDepositoComEntrega_e_Retira(qryFatGor: TUniQuery): Boolean;
Begin
  Result := False;

  If not fEhAbastecimentoPorDeposito(qryFatGor) Then
    Exit;

  If not fTemItensEntrega_e_Retira(qryFatGor) Then
    Exit;

  Result := True;
End;

function fEhAbastecimentoPorDeposito(qryFatGor: TUniQuery): Boolean;
Begin
  Result := False;

  If not Assigned(qryFatGor) Then
    Exit;

  If not qryFatGor.Active Then
    Exit;

  If not (fCfgSis('ABADEP') = 'S') Then
    Exit;

  If not (qryFatGor.FieldByName('FGO_ABADEP').AsString = 'S') Then
    Exit;

  Result := True;
End;

function fTemItensEntrega_e_Retira(qryFatGor: TUniQuery): Boolean;
Begin
  Result := fPedidoPossuiItensEntrega_e_Retira(qryFatGor.FieldByName('FGO_NUMDOC').AsString,
                                               qryFatGor.FieldByName('FGO_ESPDOC').AsString,
                                               qryFatGor.FieldByName('FGO_CODEMP').AsString);
End;

function fValidarCanhotoNotaFiscalPendente(fatVenda: TFatVenda): Boolean;
var
  stlDocs: TStringList;
  strDoc: String;
  strNomCli: String;
  objLiberacao: TLiberacao;
begin
  Result := True;
  stlDocs := nil;
  Try
    If (fCfgSis('LIMCNH', varInteger) <= 0) Then
      Exit;

    If (Not fatVenda.fBloquearVendaLimiteDiasCanhoto(fatVenda.strCodCli, stlDocs)) Then
      Exit;

    strNomCli := fCampoTabela('CLI_NOMCLI', 'CADCLI', ['CLI_CODCLI'], [fatVenda.strCodCli], False);

    If (fClienteConsumidor(strNomCli, False, True)) Then
      Exit;

    objLiberacao := TLiberacao.Create;
    Try
      objLiberacao.Clear;
      objLiberacao.objMsgLibera.pAddTexto('Liberação de venda com canhoto de nota fiscal pendente a mais de ' + IntToStr(fCfgSis('LIMCNH', varInteger)) + ' dia(s).');

      if stlDocs.Count > 0 then
      begin
        objLiberacao.objMsgLibera.pAddTexto('Documentos:');

        For strDoc In stlDocs Do
          objLiberacao.objMsgLibera.pAddTexto(strDoc);
      end;

      objLiberacao.strDirAce := 'LIBCHT';
      objLiberacao.strMsgSen := 'Canhotos de Notas Fiscais';
      objLiberacao.strCodOpe := FatVenda.strCodVen;
      objLiberacao.strCodDig := fatVenda.strCodDig;
      objLiberacao.strCliente := fatVenda.strCodCli + '-' + strNomCli;
      objLiberacao.strCpfCnpj := fatVenda.strCliCgc;

      Result := fatVenda.fFatMensagemLiberacao(objLiberacao);
    Finally
      FreeAndNil(objLiberacao);
    End;
  Finally
    If Assigned(stlDocs) Then
      FreeAndNil(stlDocs);
  End;
end;

function fVerificaCondicaoPagamento(fatVenda: TFatVenda): Boolean;
begin
