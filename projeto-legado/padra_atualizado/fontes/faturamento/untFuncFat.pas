      Self.strTipFatNEs := fCampoTabela('CLI_TFTNES', 'CADCLI', ['CLI_CODCLI'], [Self.strCodCli], False);
    End;

    strCodPorNfMeiaNota := qryFatGor.FieldByName('FGO_PTNFMN').AsString;

    blnSaldoMatriz := fValidaSaldoDaMatriz;

