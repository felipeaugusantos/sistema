End;

function fTravaSaldoVN(blnExpedi, blnEntFut: Boolean; strMotFut: String = ''; strOriF11: String = 'N'; OperacaoOrigemFaturamento: TOperacaoFaturamento = ofIndefinido): String;
Begin
  If blnExpedi Then
    Result := fCfgSis('SLD_EX')

  Else If blnEntFut Then
  Begin
    If strMotFut <> 'F' Then
      Result := fCfgSis('SLF_VN')
    Else If OperacaoOrigemFaturamento = ofBaixaDeEntregaFutura Then
      Result := fCfgSis('SFPBEF')
    Else
      Result := fCfgSis('SFP_VN');
  End
  Else If (strOriF11='S') Then
    Result := fCfgSis('SLD_RC')
  Else
    Result := fCfgSis('SLD_VN');
End;

function fCfgTravaSaldoEntFut(strOpcao: String; strMotFut: String = ''; OperacaoOrigemFaturamento: TOperacaoFaturamento = ofIndefinido): String;
begin
  If Pos(strOpcao, 'PD_OR_') <= 0 Then
    strOpcao := 'VN';

  If strMotFut = 'F' Then
  Begin
    If OperacaoOrigemFaturamento = ofBaixaDeEntregaFutura Then
      Result := 'SFPBEF'
    Else
      Result := 'SFP_' + strOpcao;
  End
  Else
  Begin
    If strOpcao = 'OR' Then Result := 'SLF_OP';
    If strOpcao = 'PD' Then Result := 'SLFPED';
    If strOpcao = 'VN' Then Result := 'SLF_VN';
  End;
end;

function fMensagemLiberacao(objLiberacao: TLiberacao; Var strNTrava : String; stlNumLib : TStringList): Boolean;
var
  blnRemoverTravaLogAvi : Boolean;
  blnUsaLiberacaoPedidosConformeEscolhaDoOperador: Boolean;
  strNTravaNv2 : string;
  frmFatLiberacaoCliente : TfrmFatLiberacaoCliente;
begin
  Result := False;

  //REQ.: 193279 NÃO EXIBE OS ALERTAS DAS TRAVAS QUE SERÃO EXIBIDAS NO FINAL.
  If (Not untFuncFat.blnExibeTravas) Then
  begin
    //REQ.: 206549 SOMENTE AS TRAVAS QUE SÃO EXIBIDAS NO FINAL PODEM TER O AVISO OCULTADO DURANTE A OPERAÇÃO. (NÃO SE ATREVA A BURLAR ISSO!!!)
    If fSomenteAvisaPoisVaiTravarNoFinalVenda(objLiberacao.strDirAce) Then
    Begin
      Try
        //REQ.: 205788 AS TRAVAS QUE SÃO SOMENTE AVISO SERÃO MOSTRADAS JÁ LIBERADAS NA TRAVA COLETIVA.
        objLiberacao.blnAviso_ := Not objLiberacao.blnTraTel;

        objLiberacao.blnTraTel := False;
        pCriarFormularios(TfrmFatLiberacaoCliente, frmFatLiberacaoCliente);
        frmFatLiberacaoCliente.objLiberacao := objLiberacao;
        frmFatLiberacaoCliente.pPreparaDados;
      Finally
        Result := True;
        pFreeAndNil(frmFatLiberacaoCliente);
      End;
    End;
  End;

  if Assigned(stlNumLib) then
    objLiberacao.stlNumLib.Text := stlNumLib.Text;

  blnRemoverTravaLogAvi := False;
  blnUsaLiberacaoPedidosConformeEscolhaDoOperador := fCfgSis('LIBPED', VarBoolean) And fCfgSis('LBPDSN', VarBoolean);

  If (Not Result) And (fSomenteAvisaPoisVaiTravarNoFinalVenda(objLiberacao.strDirAce)) Then
  Begin
    blnRemoverTravaLogAvi := Not objLiberacao.blnTraTel; //Caso estava configurado para avisar, deve remover da lista de bloqueios

    //Requisito 100237 Menil
    If blnUsaLiberacaoPedidosConformeEscolhaDoOperador Then
    Begin
      blnRemoverTravaLogAvi := False;

      //REQ.: 205788 AS TRAVAS QUE SÃO SOMENTE AVISO SERÃO MOSTRADAS JÁ LIBERADAS NA TRAVA COLETIVA.
      //REQ.: 241196 (INCLUÍDO) E REQ.: 242325 (RESTRINGIDO À blnUsaLiberacaoPedidosConformeEscolhaDoOperador)
      objLiberacao.blnAviso_ := Not objLiberacao.blnTraTel;
    End;

    objLiberacao.blnTraTel := False;
  End;

  If (Not Result) Then
    Result := objLiberacao.fLibera;

  pAdicionarDirAceStringNTrava(objLiberacao.strDirAce, strNTrava);

  If blnRemoverTravaLogAvi Then
  begin
    pRemoverTravaLogAvi(objLiberacao.strDirAce, strNTrava);
    if not fEmptyStr(objLiberacao.strDirAceNv2) then
      pRemoverTravaLogAvi(objLiberacao.strDirAceNv2, strNTravaNv2);
  end;

  if Result and Assigned(stlNumLib) then
    stlNumLib.Text := objLiberacao.stlNumLib.Text;
end;


function fSenhaLiberacaoSemSaldoVN(strCodOpe,
                                   strCodDig: String;
                                   Var strNTrava: String;
                                   stlNumLib: TStringList;
                                   objMsg: TMensagemLiberacao;
                                   strProduto: String = '';
                                   blnMostraMen: Boolean = TRUE;
                                   strOpcDoc: String = '';
                                   blnSoliTE: Boolean = FALSE;
                                   blnExpedi: Boolean = False;
                                   strMotFut: String = '';
                                   blnEntFut: Boolean = False;
                                   blnBaiEntFut: Boolean = False;
                                   blnEnt_CD: Boolean = FALSE;
                                   strCodCli: String = '';
                                   strCodIte: String = '';
                                   strOriF11: String = 'N';
                                   strSeqDtaHrLogVar: String = '';
                                   blnExibeMensagemTransEstoq: Boolean=True;
                                   OperacaoOrigemFaturamento: TOperacaoFaturamento = ofIndefinido): Boolean;
  Const
    STRAVISOTE = 'Será exibida tela no final para Transferência de Estoque.';

  Var
    strMensag: String;
    objLiberacao : TLiberacao;

  function fSenhaSaldo: String;
  Begin
    If blnExpedi Then
      Result := fCfgSis('SESDEX')
    Else
      Result := fCfgSis('SESDVN');
  End;

  function fExibiraTelaParaTransferencia: Boolean;
  begin
    Result := (Pos(strOpcDoc, 'VN_CS_TR_') > 0) And (Not blnBaiEntFut) And (Not blnEnt_CD) And
              fCfgSis('SOLITE', VarBoolean) And (fTravaSaldoVN(blnExpedi, blnEntFut, strMotFut, strOriF11) = 'T') And (fCfgSis('OPSOAB') = '2');
  end;

begin

  Result := False;

  If (fEmptyStr(fSenhaSaldo)) Or
     (fExibiraTelaParaTransferencia) Then
  Begin
    strMensag := '';

    If fEmptyStr(strProduto) Then
      strMensag := 'Este produto não possui saldo suficiente para ' +
               IIF(strOpcDoc = 'RQ', 'a requisição!', IIF(strOpcDoc = 'AJ', 'o ajuste!', ' esta venda!'))
    Else
      strMensag := 'Produto ' + strProduto + ' não possui saldo suficiente para ' +
               IIF(strOpcDoc = 'RQ', 'a requisição!', IIF(strOpcDoc = 'AJ', 'o ajuste!', ' esta venda!'));

    If (Not blnSoliTe) And (Pos(strOpcDoc, 'VN_CS_TR_') > 0) And
       (Not blnBaiEntFut) And fCfgSis('SOLITE', VarBoolean) And (fTravaSaldoVN(blnExpedi, blnEntFut, strMotFut, 'N', OperacaoOrigemFaturamento) = 'T') Then
    Begin
      If (blnExibeMensagemTransEstoq) Then
        strMensag := strMensag + #13#10 + STRAVISOTE;

      Result := True;
    End;

    If (Not blnSoliTe) And (Not fEmptyStr(strMensag)) Then
      fMensagem('', strMensag, ['&OK']);

    Exit;
  End;

  objLiberacao := TLiberacao.Create;
  try
    objLiberacao.objMsgLibera := objMsg;

    objLiberacao.strDirAce := 'LBSDVN';
    objLiberacao.strSenLib := fSenhaSaldo;
    objLiberacao.strMsgSen := 'Liberação de produto sem saldo - '+IIF(strOriF11='S','Resumo de Caixa!', 'Venda Normal!');
    objLiberacao.blnMosMen := blnMostraMen;
    objLiberacao.strCodOpe := strCodOpe;
    objLiberacao.strCodDig := strCodDig;
    objLiberacao.strCodIte := strCodIte;
    objLiberacao.strCliente := strCodCli;
    objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);
    objLiberacao.blnIgnInc := True;
    objLiberacao.strSequencialUnicoDtaHra := strSeqDtaHrLogVar;

    If (fCfgSis('TRAEST', varString) = '2') Then
    Begin
      objLiberacao.objMsgLibera.pAddTextoCaption('Empresa', VS_strCodEmp + '-' + fRetNomeEmpresa);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor', strCodOpe   + '-' + fRetNomeOperador(strCodOpe));
    End;

    Result := fMensagemLiberacao(objLiberacao, strNTrava, stlNumLib);
  finally
    FreeAndNil(objLiberacao);
  end;
end;

