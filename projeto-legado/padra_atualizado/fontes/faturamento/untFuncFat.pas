      If Not fEmpresaTemAcessoPortador(strCodPor) Then
      Begin
        fRollback;
        fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
        Result := False;
        Exit;
      End;

      If fCfgSis('DACPOR', varBoolean) Then
      Begin
        If Pos(strCodPor, strPortadoresOperador) <= 0 Then
        Begin
          fRollBack;
          fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
          Result := False;
          Exit;
        End;
      End;

      If (Not fEmptyStr(strPortador)) Then
      Begin
        strCodPor := strPortador;

        {*REQ*145940**********RP*}
        If Not fEmpresaTemAcessoPortador(strCodPor) Then
        Begin
          fRollback;
          fMensagem('ATENÇÃO!', 'Empresa sem acesso para utilizar o portador '+ strCodPor +'. Verifique o Cadastro de Portadores - Aba "Empresas Acesso".', ['&Ok']);
          Result := False;
          Exit;
        End;

        If fCfgSis('DACPOR', varBoolean) Then
        Begin
          If Pos(strCodPor, strPortadoresOperador) <= 0 Then
          Begin
            fRollBack;
            fMensagem('', 'Portador ' + strCodPor + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
            Result := False;
            Exit;
          End;
        End;
      End;

      strNomPor := fRetNomPortador(strCodPor);

      First;
      While Not Eof Do
      Begin

        If RoundTo(FieldByName('FIN_VALTAX').AsFloat, -2) <> 0 Then
        Begin

          strHisCtr := 'REF. DOCUMENTO ' + strNumDoc + '-' + strEspDoc + ' (TAXA DE RETORNO) ';

