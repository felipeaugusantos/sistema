class function TFatVenda.fUtilizarDataEmissaoCalcularDiaVencimentoBD(const AstrNumDoc: String; AstrEspDoc: String; AstrCodEmp: String): TMovProdCalcVencDuplOpcoes ;
var
  LqryDados: TUniQuery ;
begin
  result := [] ;
  LqryDados := fCriaQuery() ;
  try
    LqryDados.Close ;
    LqryDados.SQL.Clear ;
    LqryDados.SQL.Add('  SELECT DISTINCT ') ;
    LqryDados.SQL.Add('     E.FDO_ENTRET, ') ;
    LqryDados.SQL.Add('     D.FDO_ENTFUT ') ;
    LqryDados.SQL.Add('  FROM ') ;
    LqryDados.SQL.Add('    FATDOR D ') ;
    LqryDados.SQL.Add('  INNER JOIN EXTDOR E ') ;
    LqryDados.SQL.Add('    ON E.FDO_SEQFDO = D.AUTOINCREM ') ;
    LqryDados.SQL.Add('  INNER JOIN FATGOR G ') ;
    LqryDados.SQL.Add('    ON G.AUTOINCREM = D.FDO_SEQGER ') ;
    LqryDados.SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC ') ;
    LqryDados.SQL.Add('    AND FDO_ESPDOC = :ESPDOC ') ;
    LqryDados.SQL.Add('    AND FDO_CODEMP = :CODEMP ') ;
    LqryDados.SQL.Add('    AND D.FDO_CODITE NOT IN (' + QuotedStr(fCfgSis('ITESER')) + ',' + QuotedStr(fCfgSis('SERTER')) + ') ') ;
    LqryDados.ParamByName('NUMDOC').AsString := AstrNumDoc ;
    LqryDados.ParamByName('ESPDOC').AsString := AstrEspDoc ;
    LqryDados.ParamByName('CODEMP').AsString := AstrCodEmp ;
    LqryDados.Open ;
    LqryDados.First ;
    while not LqryDados.Eof do
    begin
      if LqryDados.FieldByName('FDO_ENTRET').AsString = 'R' then
      begin
        result := result + [mpRetira] ;
      end
      else if (LqryDados.FieldByName('FDO_ENTRET').AsString = 'E') and (LqryDados.FieldByName('FDO_ENTFUT').AsString = 'N') then
      begin
        result := result + [mpEntrega] ;
      end
      else if LqryDados.FieldByName('FDO_ENTFUT').AsString = 'S' then
      begin
        result := result + [mpEntregaFutura] ;
      end ;
      LqryDados.Next ;
    end ;
  finally
    FreeAndNil(LqryDados) ;
  end ;
end ;

class function TFatVenda.fUtilizarDataEmissaoCalcularDiaVencimento(const AstrNumDoc: String; AstrEspDoc: String; AstrCodEmp: String): Boolean ;
var
  LTipoMovimentoItens: TMovProdCalcVencDuplOpcoes ;
begin
  result := False ;
  if fCfgSis('DTPDCR',varBoolean) then
  begin
    LTipoMovimentoItens := fUtilizarDataEmissaoCalcularDiaVencimentoBD(AstrNumDoc, AstrEspDoc, AstrCodEmp) ;
    result := fEstaEmMovimentoProdutoCFG(LTipoMovimentoItens) ;
  end ;
end ;

function TFatVenda.fUtilizarDataEmissaoCalcularDiaVencimento(): Boolean ;
var
  LTipoMovimentoItens: TMovProdCalcVencDuplOpcoes ;
begin
  result := False ;
  if fCfgSis('DTPDCR',varBoolean) then
  begin
    //quando tem cdsVendas
    LTipoMovimentoItens := [] ;
    if fTemItensRetira then
    begin
      LTipoMovimentoItens := LTipoMovimentoItens + [mpRetira] ;
    end ;
    if fTemEntregaFutura then
    begin
      LTipoMovimentoItens := LTipoMovimentoItens + [mpEntregaFutura] ;
    end ;
    if fTemItensEntregaImediata then
    begin
      LTipoMovimentoItens := LTipoMovimentoItens + [mpEntrega] ;
    end ;
    ///analisa se as opções dos itens estão na CFG
    result := fEstaEmMovimentoProdutoCFG(LTipoMovimentoItens) ;
  end ;
end ;

