function TFatVenda.fGComProDifCtr: Boolean;
  Var
    qryGen    : TUniQuery;

    strHisto,
    strNumDup: String;
    strCliDiv: String;
    strCodDivAux: String;

    fltComSel,
    fltBasNov,
    fltComNov,
    fltComDif : Double;

  function fRetornaProfissional(strCodCli: String): String;
    Var
      qryAux: TUniQuery;
  begin
    Result := '';

    If (fEmptyStr(strCodCli)) Then
      Exit;

    qryAux := fCriaQuery(Self);
    qryAux.SQL.Add('SELECT DISTINCT COM_CODPRO ');
    qryAux.SQL.Add('FROM   COMPRO ');
    qryAux.SQL.Add('WHERE  CONCAT(COM_NUMDOC, ');
    qryAux.SQL.Add('              COM_ESPDOC, ');
    qryAux.SQL.Add('              COM_CODEMP, ');
    qryAux.SQL.Add('              COM_CODCLI) IN (SELECT SQL_NO_CACHE ');
    qryAux.SQL.Add('                              DISTINCT CONCAT(TMP_NUMDOC, ');
    qryAux.SQL.Add('                                              TMP_ESPDOC, ');
    qryAux.SQL.Add('                                              TMP_CODEMP, ');
    qryAux.SQL.Add('                                              TMP_CODCLI) AS DOCUME ');
    qryAux.SQL.Add('                              FROM   ' + strTabelaConfMi    );
    qryAux.SQL.Add('                              WHERE  TMP_ESPDOC = "FF")    ');
    qryAux.Open;

    Result := qryAux.FieldByName('COM_CODPRO').AsString;

    FreeAndNil(qryAux);
  End;

begin
  Result    := False;
  qryGen    := fCriaQuery();

  Try
    With qryGen Do
    Begin
      {*********************************************}
      {* RETORNA TOTAL DE COMISSÃO DE PROFISSIONAL *}
      {* GERADO NOS DOCUMENTOS SELECIONADOS        *}
      {******************************************MM*}
      SQL.Clear;
      SQL.Add('SELECT ');
      SQL.Add('  SUM(IF(IFNULL(CTR_DTAREC,0) <> 0,                       ');
      SQL.Add('         IFNULL(CTR_VALREC - IFNULL(CTR_VALJUR, 0) - IFNULL(CTR_VALCOB, 0) + IFNULL(CTR_VALDES, 0), 0), ');
      SQL.Add('         IFNULL(CTR_VALDUP,0))) AS VALCOM                 ');
      SQL.Add('FROM   CADREC ');
      SQL.Add('WHERE  CTR_ESPDOC = "CC"  ');
      SQL.Add('AND    CONCAT(CTR_DOCDIV, ');
      SQL.Add('              CTR_ESPDIV, ');
      SQL.Add('              CTR_EMPDIV, ');
      SQL.Add('              CTR_CLIDIV) IN (SELECT SQL_NO_CACHE ');
      SQL.Add('                                DISTINCT CONCAT(TMP_NUMDOC, ');
      SQL.Add('                                                TMP_ESPDOC, ');
      SQL.Add('                                                TMP_CODEMP, ');
      SQL.Add('                                                TMP_CODCLI) AS DOCUME ');
      SQL.Add('                              FROM   ' + strTabelaConfMi    );
      SQL.Add('                              WHERE  TMP_ESPDOC = "FF")    ');
      Open;

      strCodDivAux := fRetornaProfissional(strCodCli);
      strCliDiv := fRetProfissionalCliente(strCodDivAux);

      If (FieldByName('VALCOM').AsFloat <> 0) And (fClienteProfissional(strCliDiv)) Then
      Begin
        fltComSel := fFormataFloat(FieldByName('VALCOM').AsFloat,2);

        strCodDiv := strCodDivAux;

        {*********************************************}
        {* RETORNA TOTAL DE COMISSÃO DE PROFISSIONAL *}
        {* GERADO NO DOCUMENTO DE CONFIRMAÇÃO        *}
        {******************************************MM*}
        pComProFaixaFat(strCodDiv, fltBasNov, fltComNov);

        fltComNov := fFormataFloat(fltComNov, 2);

        {*********************************************}
        {* SE A DIFERENÇA ENTRE AS COMISSÕES <> 0,   *}
        {* SALVAR NO CADREC PARA CORRIGIR A COMISSÃO *}
        {******************************************MM*}
        fltComDif := (fltComNov + fltComSel) * -1;

        If (fFormataFloat(fltComDif,2)  <> 0.00) Then
        Begin
          strCodPor  := fDecidePortador;

          If fCfgSis('DACPOR', varBoolean) Then
          Begin
            If Pos(fRetornaCodPorComProfCadRec(strCodPor), strPortadoresOperador) <= 0 Then
            Begin
              fRollBack;
              fMensagem('', 'Portador ' + fRetornaCodPorComProfCadRec(strCodPor) + ' não permitido para o operador ' + strLoginUsuarioLogado, ['&OK']);
              Result := False;
              Exit;
            End;
          End;

          strHisto   := strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp + '-' + strCliDiv + '-REF. COMISSAO PROFISSIONAIS';
          strNumDup  := fRetSequencial('PROCCO', VS_strCodEmp, fTamDocCadRec);

          Result := fGravaCadRec(strNomeForm,
                                 'INCLUSÃO',
                                 strNumDup,                                 // Duplicata
                                 'A',                                       // Parcela
                                 0,                                         // Seq. Baixa
                                 'CC',                                      // Especie
                                 strCliDiv,                                 // Cliente
                                 VS_strCodEmp,                              // Empresa
                                 strCodVen,                                 // Vendedor
                                 strCodDig,                                 // Digitador
                                 fRetornaCodPorComProfCadRec(strCodPor),    // Portador
                                 Self.VS_Date,                              // Data de cadastro
                                 Self.VS_Date,                              // Data de Vencimento
                                 fltComDif,                                 // Valor da Duplicata
                                 fltComDif,                                 // Valor Original
                                 0.0,                                       // Despesa de Cobrança
                                 'N',                                       // Desconto
                                 strInfErro + strHisto,                     // Histórico 1
                                 '',                                        // Histórico 2
                                 '',                                        // Portador da Baixa
                                 '',                                        // Centro de Custo da Baixa
                                 '',                                        // Operador da Baixa
                                 '',                                        // Documento da Baixa
                                 0.0,                                       // Valor do Recebimento
                                 0,                                         // Data do Recebimento
                                 'N',
                                 '',                                        // Código do Evento
                                 strPedSit,                                 // Código Velho (CONVERSÃO)
                                 '',                                        // Tipo de Fora (Condição de Pagamento)
                                 '',                                        // Código da Condição de Pagamento
                                 False,
                                 '',                                        // Codigo do Centro de Custo
                                 0,                                         // Sequencial de Controle
                                 0,
                                 '',                                        // Observação de Agrupamento 1
                                 '',                                        // Observação de Agrupamento 2
                                 '',                                        // Observação de Agrupamento 3
                                 '',
                                 0,
                                 0,
                                 0,
                                 0,
                                 '',
                                 '',                                        // Empresa de Origem
                                 strNumDoc,
                                 strEspDoc,
                                 VS_strCodEmp,
                                 strCodCli,
                                 0,
                                 0,
                                 '',
                                 0,
                                 0,
                                 'N',
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0,
                                 0);
        End
        Else
          Result := True;
      End
      Else
        Result := True;
    End;

    FreeAndNil(qryGen);

  Except

    on E: Exception do
    begin
      pMensagensErro(E.Message, '[fGComProDifCtr]');
    end;

  End;
end;

function TFatVenda.fGetAutoIncMovDet(const strCodAca, strEmpAca, strIteTin, strCodIte, strNumDoc, strEspDoc, strCodEmp: string): string;
var
  qryGen: TUniQuery;
begin
  qryGen := nil;
  Result := '';
  Try
    Try
      qryGen := fCriaQuery();
      qryGen.SQL.Text :=
        ' SELECT                      ' +
        '   AUTOINCREM                ' +
        ' FROM                        ' +
        '   MOVDET                    ' +
        ' WHERE DET_CODACA = :CODACA  ' +
        '   AND DET_EMPACA = :EMPACA  ' +
        '   AND DET_ITETIN = :ITETIN  ' +
        '   AND DET_CODITE = :CODITE  ' +
        '   AND DET_NUMDOC = :NUMDOC  ' +
        '   AND DET_ESPDOC = :ESPDOC  ' +
        '   AND DET_CODEMP = :CODEMP  ';

      qryGen.ParamByName('CODACA').AsString := strCodAca;
      qryGen.ParamByName('EMPACA').AsString := strEmpAca;
      qryGen.ParamByName('ITETIN').AsString := strIteTin;
      qryGen.ParamByName('CODITE').AsString := strCodIte;
      qryGen.ParamByName('NUMDOC').AsString := strNumDoc;
      qryGen.ParamByName('ESPDOC').AsString := strEspDoc;
      qryGen.ParamByName('CODEMP').AsString := strCodEmp;
      qryGen.Open;

      if not qryGen.IsEmpty then
        Result := qryGen.FieldByName('AUTOINCREM').AsString;

    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(qryGen) then FreeAndNil(qryGen);
  End;
end;

function TFatVenda.fGArqTin(): Boolean;
var
  blnGravaTinGer: Boolean;
  strSeqGer: String;
  strNumLot: String;

  intContador : Integer;
  intContador2: Integer;
  arrFormul: TForMulTinDetArray;
  arrBaixaPigmentos: TBaixaPigmentosArray;

  stlItensTraMl: TStringList;
  intContFormul: Integer;
  strAutIncTdt: String;
  intCont: Integer;
  strGTinForEmp: String;
  strEmpSav: String;
  blnBaixad: Boolean;
  strCodCliGra: String;
begin
  strEmpSav := '';
  If Not fEmptyStr(strEmpOriRegEsp) Then
  Begin
    strEmpSav := VS_strCodEmp;
    pSetaEmpresaLogada(strEmpOriRegEsp);
  End;

  strCodCliGra := Self.strCodCli;

  If fEmpresaUtilizaRegimeEspecial And blnTemTinta Then
  Begin
    If fPossuiSomenteItensRegimeEspecial Then
      strCodCliGra := fRetornaClienteFilial(fCfgSis('EMPRES'))
    Else
      strCodCliGra := fRetornaClienteFilial(fCfgSis('EMPREN'));
  End;

  Try
    Try
      Result := True;

      If (blnBaiEntFut) And (Not blnExpedi) Then
        Exit;

      If blnIgnorarGravarTinDet Then
        Exit;

      If (Not Assigned(fGTinForGeral)) Then
      Begin
        Exit;
      End;

      if blnBaixaFFEmprestimo then
        Exit;

      stlItensTraMl := TStringList.Create;

      {*******************************************}
      {* NÃO PERMITE ITENS DUPLICATADOS          *}
      {****************************************MV*}
      stlItensTraMl.Duplicates := dupIgnore;
      stlItensTraMl.Sorted     := True;

      blnGravaTinGer  := False;
      For intContador := 0 To Length(arrMatItens) -1 Do
      Begin
         If (arrMatItens[intContador].strEntSai = 'S')    And
           (arrMatItens[intContador].strIdePro <> 'NOR') Then
        Begin

          If (Not Assigned(fTintaGeraFormulacao)) Then
          Begin
            blnGravaTinGer := True;
            Break;
          End
          Else
          Begin
            blnGravaTinGer := True;
            Break;
          End;

        End;
      End;

      If (Not blnGravaTinGer) Then
      Begin
        Exit;
      End;

      Result := fGravaTinGer(strSeqGer,
                             VS_strCodEmp,
                             strCodVen,
                             strNumDoc,
                             strEspDoc,
                             Self.VS_Date,
                             fRetHoraServidor,
                             strConPag,
                             strCodCliGra,
                             strCliEst,
                             IIF(fEmptyStr(strCliNom), '', strCliNom),
                             strCliEnd,
                             strCliBai,
                             strCliCep,
                             strCodCid,
                             strCliEst,
                             strCliTel,
                             intCgcCpf,
                             strCliCgc,
                             strCliIes,
                             strCli_Rg,
                             'N');

      If (Not Result) Then
        Exit;

      Self.strIncTinGer := strSeqGer;

      For intContador := 0 To Length(arrMatItens) -1 Do
      Begin

        If (arrMatItens[intContador].strIdePro = 'NOR') Or
           (arrMatItens[intContador].strEntSai <> 'S')  Then
          Continue;

        SetLength(arrBaixaPigmentos, 0);
        For intCont := Low(arrFormul) To High(arrFormul) Do
        Begin
          arrFormul[intCont].strFormul := '';
          arrFormul[intCont].fltQtdbas := 0.0;
        End;
        stlItensTraMl.Clear;

        If (Assigned(fTintaGeraFormulacao)) Or (fCfgSis('MODFOR') = '1') Then
        Begin

          SetLength(arrBaixaPigmentos, 0);
          strGTinForEmp := arrMatItens[intContador].strEmpIte;
          if fEmptyStr(strGTinForEmp) then
            strGTinForEmp := arrMatItens[intContador].strEmpPrd;
          if fEmptyStr(strGTinForEmp) then
            strGTinForEmp := VS_strCodEmp;

          If Not (fGTinForGeral(arrMatItens[intContador].strIdePro, // Tipo de Produto
                                arrMatItens[intContador].strIteTin, // Item da Tinta
                                arrMatItens[intContador].strTipPre, // Tipo de Preço
                                arrMatItens[intContador].strLinTin, // Linha da Tinta
                                arrMatItens[intContador].strCatali, // Catalizador Utilizado
                                arrMatItens[intContador].intLazQua, // Quarto (Lazzumix)
                                arrMatItens[intContador].fltQtdEmb, // Quantidade de Embalagem
                                arrMatItens[intContador].fltQtdIte, // Quantidade do Item
                                arrMatItens[intContador].strDesIte, // Descrição do Item
                                qryTintaAux,                        // Arquivo de Formulas!
                                arrMatItens[intContador].fltVolPro, // Volume a ser produzido (Tinta c/ Venda Dinamica)
                                arrFormul,                          // Retorno da Formulação
                                arrBaixaPigmentos,                  // Retorno dos Pigmentos a serem baixados
                                stlItensTraMl,                      // Retorno dos Itens para Transferencia de ML
                                arrMatItens[intContador].strCodDil,
                                arrMatItens[intContador].fltPorDil,
                                arrMatItens[intcontador].strDilCon,
                                arrMatItens[intContador].fltPorCat,
                                arrMatItens[intContador].recForTin.strTipCor,
                                arrMatItens[intContador].recForTin.strTextBase,
                                arrMatItens[intContador].recForTin.intModDil,
                                arrMatItens[intContador].recForTin.strCompB,
                                strGTinForEmp,
                                arrMatItens[intContador].strPorPer)) Then
          Begin
            pAddMsgErroAdicional('Não foi possível gravar a formulação da tinta: ');
            pAddMsgErroAdicional('IDEPRO = "' + arrMatItens[intContador].strIdePro + '"');
            pAddMsgErroAdicional('ITETIN = "' + arrMatItens[intContador].strIteTin + '"');
            pAddMsgErroAdicional('LINTIN = "' + arrMatItens[intContador].strLinTin + '"');

            If Not blnBaixaEmprestimos Then
            Begin
              fRollBack;
              fMensagem('ATENÇÃO!', 'A fórmula ' + arrMatItens[intContador].strDesIte + ', está sem a chave MD5KEY.' + #13#10 +
                                    'Favor entrar em contato com a Citel.', ['&OK']);
            End;

            Result := False;
            Break;
          End;

          For intContFormul := Low(arrFormul) To High(arrFormul) Do
          Begin
            arrFormul[intContFormul].fltQtdbas := arrFormul[intContFormul].fltQtdbas *
                                                  arrMatItens[intContador].fltQtdIte;
          End;

        End;

        pInfoStatusGravacao(Format('Gravando Tinta de Máquina [%d / %d][%s]',
          [intContador + 1, Length(arrMatItens), LeftStr(arrMatItens[intContador].strDesIte, 25) + '...']));

        {************************************************************}
        {* BAIXA O TINDET CASO O PEDIDO JA ESTEJA BAIXADO, PARA QUE *}
        {* CONSIGA FAZER A DEVOLUCAO POSTERIORMENTE                 *}
        {*********************************************************AC*}
        blnBaixad := fRetPedidoBaixadoFormulacao(arrMatItens[intContador].strCodAca, arrMatItens[intContador].strEmpAca,
                                                 arrMatItens[intContador].strNumOrc, arrMatItens[intContador].strEspOrc,
                                                 arrMatItens[intContador].strEmpOrc);

        If (Not fGravaTinDet(strAutIncTdt,
                             strSeqGer,
                             VS_strCodEmp,
                             strCodDiv,
                             arrMatItens[intContador].strCodMar,
                             arrMatItens[intContador].strCodIte,
                             strCodVen,
                             strCodCliGra,
                             strNumDoc,
                             strEspDoc,
                             Self.VS_Date,
                             fRetHoraServidor,
                             strConPag,
                             strCliEst,
                             arrMatItens[intContador].strDesIte +
                              IIF((Not fEmptyStr(arrMatItens[intContador].strComple)) And
