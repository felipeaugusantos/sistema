    function fItemDaNFExcedenteEmRelacaoAoPD(AChaAce, AHubMkp, ACodIte : String; Out AQtdPed : Double) : Boolean;
    begin

      Result := False;

      If Not (ModeloDeMovimentacaoDeSaldo = fmmGerarPedidoParaGuardarAsDiferencas) Then
        Exit;

      If Not Self.Fulfillment.EhOperacaoFulfillment Then
        Exit;

      If Not Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Then
        Exit;

      LItemDaNFExcedenteEmRelacaoAoPD := TNotaRemessaVsPedidoVenda.ItemDaNFExcedenteEmRelacaoAoPD(AChaAce, AHubMkp, ACodIte, AQtdPed);

      Result := LItemDaNFExcedenteEmRelacaoAoPD;

    end;

    function fRetornaDescricaoItemComComplemento(Const strDescIt: String; Const strCompIt: String): String;
    begin
      Result := strDescIt;

      If fEmptyStr(strCompIt) Then
        Exit;

      If fCfgSis('UTIDEF', VarBoolean) Then
        Exit;

      If fCfgSis('CINFAD', varBoolean) Then
        Exit;

      If strDescIt.Contains(strCompIt) Then
        Exit;

      Result := Result + ' ' + strCompIt;
    end;

    function fEhOperacaoFulfillmentNotaDeTransferenciaParaFilialItemEstruturaBaixandoFilhos(item : TDadosFechamento) : Boolean;
    begin

      Result := False;

      If Not (Self.Fulfillment.EhOperacaoFulfillment) Then
        Exit;

      If Not (strOpcDoc.Equals('TE')) Then
        Exit;

      If Not (item.strBxSbIt.Equals('S')) Then
        Exit;

      If Not (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) Then
        Exit;

      Result := True;

    end;

    function fGeraOrdemDeProducao(item : TDadosFechamento) : Boolean;
    begin

      If fEhOperacaoFulfillmentNotaDeTransferenciaParaFilialItemEstruturaBaixandoFilhos(item) Then
        Exit(True);

      Result := (item.strBxSbIt = 'S')                       And
                (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL)     And
                (Pos(strOpcDoc, 'EF') <= 0)                  And
                (Not blnBaiEntFut)                           And
                (fDeveGerarOrdProItemEstruturaProdutoNormal);

      If Result And GetEnviandoMercadoriaParaLoteEstoqueExterno Then
        Result := (Not fSubItensDaEstruturaTemLotes(item));

    end;

    function fGeraTranferenciasLT(item : TDadosFechamento) : Boolean;
    begin
      Result := (item.strBxSbIt = 'S')                       And
                (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL)     And
                (Pos(strOpcDoc, 'EF') <= 0)                  And
                (Not blnBaiEntFut)                           And
                (fDeveGerarOrdProItemEstruturaProdutoNormal) And
                (fSubItensDaEstruturaTemLotes(item))         And
                (Not fVaiGerarAjusteDeEstoqueFulfillment);
    end;

    function NaoMovimentarSaldosPoisVaiMovimentarViaTL_ViaOrdemDeProducao(AFulfillmentRegrasMovimentacaoEstoque : FulfillmentRegrasMovimentacaoEstoque) : Boolean;
    begin

      Result := False;

      //Case - GUARDAR
      If fItemDaNFExcedenteEmRelacaoAoPD(Self.strChaveAcesso, Self.Fulfillment.SiglaHubMarketPlace, strCodIte, LQtdPed) Then
        Exit(True);

      //Case - Vai gerar OP
      If fGeraOrdemDeProducao(arrMatItens[intPosMat]) Then
        Exit(True);

      If GetEnviandoMercadoriaParaLoteEstoqueExterno And fItemEstrutura(arrMatItens[intPosMat].strCodIte) And fSubItensDaEstruturaTemLotes(arrMatItens[intPosMat]) And MatchStr(fCfgSis('BXSBIT'), ['2','3']) Then
        Exit(True);

      //Case - Vai gerar TL
      If GetEnviandoMercadoriaParaLoteEstoqueExterno And fUsaRotinaWMS Then
        Exit(True);

      If (Not fEmptyStr(arrMatItens[intPosMat].strNumLot)) Then
      Begin

        If GetEnviandoMercadoriaParaLoteEstoqueExterno Then
          Exit(True);

        If MercadoLivre.GeraTL(Self.Fulfillment.SiglaHubMarketPlace, AFulfillmentRegrasMovimentacaoEstoque.InformacaoAdicional) Then
          Exit(True);

        If MagazineLuiza.GeraTL(Self.Fulfillment.SiglaHubMarketPlace, AFulfillmentRegrasMovimentacaoEstoque.InformacaoAdicional) Then
          Exit(True);

      End;

      //Case - Vai gerar ajuste de estoque (AF)
      If fVaiGerarAjusteDeEstoqueFulfillment Then
        Exit(True);

    end;

    procedure ProcessarRegrasFulfillment;
      var
        LFulfillmentRegrasMovimentacaoEstoque : FulfillmentRegrasMovimentacaoEstoque;
    begin

      If (Not Self.Fulfillment.EhOperacaoFulfillment) And (Not GetEnviandoMercadoriaEstoqueExternoPeloAutcom(False)) Then
        Exit;

      If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') and TFaturamentoMercadoLivre.NFeEmitidaPeloFaturador(Self.strChaveAcesso, Self.strFullNumPOK) Then
      Begin
        blnAtualizaEstoqueCadIte := False;
        blnFilKar := False;
        Exit;
      End;

      LFulfillmentRegrasMovimentacaoEstoque := FulfillmentMovimentacaoEstoque(Self.strClaFis, Self.strChaveAcesso, Self.Fulfillment.SiglaHubMarketPlace);

      If NaoMovimentarSaldosPoisVaiMovimentarViaTL_ViaOrdemDeProducao(LFulfillmentRegrasMovimentacaoEstoque) Then
      Begin
        strFilFul_EntSai         := EmptyStr;
        blnAtualizaEstoqueCadIte := False;
        blnFilKar := True;
        blnFilFul := True;
        Exit;
      End;

      If LFulfillmentRegrasMovimentacaoEstoque.MovimentaEstoqueFisico Then
        strFilKar_EntSai := LFulfillmentRegrasMovimentacaoEstoque.EntradaSaida;

      If LFulfillmentRegrasMovimentacaoEstoque.MovimentaEstoqueExterno Then
        strFilFul_EntSai := LFulfillmentRegrasMovimentacaoEstoque.EntradaSaida;

      blnFilKar := LFulfillmentRegrasMovimentacaoEstoque.MovimentaEstoqueFisico.ToFilKar;
      blnFilFul := LFulfillmentRegrasMovimentacaoEstoque.MovimentaEstoqueExterno.ToFilFul;

      blnAtualizaEstoqueCadIte := LFulfillmentRegrasMovimentacaoEstoque.MovimentaEstoqueFisico;

    end;

