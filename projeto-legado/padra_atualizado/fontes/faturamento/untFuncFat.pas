function TFatVenda.fRetornaSGFTED(strNumLot: String = ''; strEmpCfg: String = ''): String;
begin
  If (Pos(strOpcDoc,'DV_PR_DD_OU_TR_OF_') > 0) Or
     ( Not fCfgSis('ENTFUT', varBoolean, strEmpCfg) ) Then
    Result := 'N'
  Else If (SameText(strNumLot, 'A DEFINIR')) And (Not fEmpresaParaFaturamentoUsaWMS(strEmpCfg)) Then
    Result := 'S'
  Else
    Result := fCfgSis('SGFTED', varString, strEmpCfg);
end;

function TFatVenda.fAcertaHistoricoCheque: Boolean;
  Var
    i: Integer;
    qryUpdCadChq: TUniQuery;
    strSQL, strHistorico: String;

  function fRetHistorico: String;
  begin
    Result := ' | REF. AOS DOCS.: ' + fRetDocsOrigem();
  end;

begin
  Try
    Result       := True;
    qryUpdCadChq := fCriaQuery(nil);

    If (Length(FDadosCheques) > 0) Then Begin
      Result       := False;
      strHistorico := fRetHistorico();

      Try
        strSQL := strSQL + 'UPDATE ';
        strSQL := strSQL + '  CADCHQ ';
        strSQL := strSQL + 'SET ';
        strSQL := strSQL + '  CHQ_DOCUME = :DOCUME ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  CHQ_CODBCO = :CODBCO AND ';
        strSQL := strSQL + '  CHQ_NUMAGE = :NUMAGE AND ';
        strSQL := strSQL + '  CHQ_CONCOR = :CONCOR AND ';
        strSQL := strSQL + '  CHQ_NUMCHQ = :NUMCHQ     ';

        For i := 0 To Length(FDadosCheques) - 1 Do Begin
          With qryUpdCadChq Do Begin
            Close();
            SQL.Clear();
            SQL.Add(strSQL);
            ParamByName('CODBCO').AsString := FDadosCheques[i].strCodBco;
            ParamByName('NUMAGE').AsString := FDadosCheques[i].strNumAge;
            ParamByName('CONCOR').AsString := FDadosCheques[i].strConCor;
            ParamByName('NUMCHQ').AsString := FDadosCheques[i].strNumChq;
            ParamByName('DOCUME').AsString := FDadosCheques[i].strHistor + strHistorico;
            ExecSQL();
          End;
        End;

        Result := True;
      Except
        On E: Exception Do Begin
          Result := False;
          pMensagensErro('Erro ao atualizar o histórico de Movimento de Cheque: ' + E.Message,
            '[fAcertaHistoricoCheque]');
        End;
      End;
    End;
  Finally
    FreeAndNil(qryUpdCadChq);
    SetLength(FDadosCheques, 0);
  End;
end;

function TFatVenda.fAcertaModalidadesCadRcx(intSeqCon: Integer; recModalidades: TDadosModalidades):Boolean;
  Var
    strSQL,
    strAutInc: String;
    qryUpd: TUniQuery;
begin
  Result := True;

  Try
    strSQL := '';
    strSQL := strSQL + 'UPDATE ';
    strSQL := strSQL + '  CADRCXX X ';
    strSQL := strSQL + 'SET ';
    strSQL := strSQL + '  RCX_DINREC = :DINREC, ';
    strSQL := strSQL + '  RCX_CHQAVI = :CHQAVI, ';
    strSQL := strSQL + '  RCX_CHQPRE = :CHQPRE, ';
    strSQL := strSQL + '  RCX_CARREC = :CARREC, ';
    strSQL := strSQL + '  RCX_VALFIN = :VALFIN, ';
    strSQL := strSQL + '  RCX_ORDREC = :ORDREC, ';
    strSQL := strSQL + '  RCX_VENPRZ = :VENPRZ, ';
    strSQL := strSQL + '  RCX_VALCRE = :VALCRE  ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  RCX_CODEMP = :CODEMP AND ';
    strSQL := strSQL + '  RCX_SEQCON = :SEQCON ';

    strAutInc := fGetMinAutIncRcx(intSeqCon, IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog));

    qryUpd := fCriaQuery;

    With qryUpd, SQL Do
    Begin
      Close;
      Clear;
      Add(strSQL);

      ParamByName('CODEMP').AsString  := IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog);
      ParamByName('SEQCON').AsInteger := intSeqCon;

      ParamByName('DINREC').AsFloat  := 0.0;
      ParamByName('CHQAVI').AsFloat  := 0.0;
      ParamByName('CHQPRE').AsFloat  := 0.0;
      ParamByName('CARREC').AsFloat  := 0.0;
      ParamByName('VALFIN').AsFloat  := 0.0;
      ParamByName('ORDREC').AsFloat  := 0.0;
      ParamByName('VENPRZ').AsFloat  := 0.0;
      ParamByName('VALCRE').AsFloat  := 0.0;

      ExecSQL;

      Add('AND AUTOINCREM = :AUTINC');

      ParamByName('AUTINC').AsString := strAutInc;
      ParamByName('DINREC').AsFloat  := recModalidades.fltValDin;
      ParamByName('CHQAVI').AsFloat  := recModalidades.fltValCqV;
      ParamByName('CHQPRE').AsFloat  := recModalidades.fltValCqP;
      ParamByName('CARREC').AsFloat  := recModalidades.fltValCar;
      ParamByName('VALFIN').AsFloat  := recModalidades.fltValFin;
      ParamByName('ORDREC').AsFloat  := recModalidades.fltValOrd;
      ParamByName('VENPRZ').AsFloat  := recModalidades.fltFatura;
      ParamByName('VALCRE').AsFloat  := recModalidades.fltValCre;

      ExecSql;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '');
    End;
  End;

  FreeAndNil(qryUpd);
end;

