function TFatVenda.fDecidePortador: String;
  Var
    qryAux: TUniQuery;
    strCodPor: String;
begin
  strPorNotaEspFator := EmptyStr;

  qryAux := fCriaQuery(Self);

  With qryAux Do
  Begin
    SQL.Add(' SELECT CLI_CODPOR, CLI_CODPO2 FROM CADCLI WHERE CLI_CODCLI = :CODCLI ');
    ParamByName('CODCLI').AsString := strCodCli;
    Open;
    Result := FieldByName(IIF( Pos(strEspDoc, 'NF_IF_IV_EL_NS_D1') > 0, 'CLI_CODPOR', 'CLI_CODPO2')).AsString;
    Close;
  End;

  FreeAndNil(qryAux);

  If (Not fEmptyStr(strCodCnd)) Then
  Begin

    strCodPor := fCampoTabela('CND_CODPOR', 'CADCND', ['CND_CODIGO'], [strCodCnd], False);
    If Not fEmptyStr(strCodPor) Then
      Result := strCodPor;

  End;

  If (Not fEmptyStr(strCodFpg)) Then
  Begin

    strCodPor := fCampoTabela('FPG_CODPOR', 'CADFPG', ['FPG_CODIGO'], [strCodFpg], False);
    If Not fEmptyStr(strCodPor) Then
      Result := strCodPor;

  End;

  If fEmptyStr(Result)                                           And
    ( (Not fEmptyStr(strNumPok)) Or (Not fEmptyStr(strPedSit)) ) Then
  Begin
    Result := fCfgSis('PORPOK');
  End;

  //Portador selecionado no Pedido de Venda
  If Not fEmptyStr(strPorPed) Then
    Result := strPorPed;

  If blnMeiaNotaComNotaNormal Then
  Begin
    If strEspDoc = 'NF' Then
    Begin
      Result := strCodPorNfMeiaNota;
    End
    Else
    Begin
      Result := fCfgSis('POCAS2');
    End;
  End;

  strCodPor := fRetornaPortadorEmpresa(Self.strEmpDoc);
  if not fEmptyStr(strCodPor) then
    Result := strCodPor;

  If (Self.blnEmitindoNotaEspecialAposFaturamento) And (strEspDoc = 'FF') And (Not fEmptyStr(fCfgSis('PORESP'))) Then
  Begin
    strPorNotaEspFator := fCfgSis('PORESP');
    Result := strPorNotaEspFator;
  End;
End;

function TFatVenda.fSomaTotalDocsConfirmados(strTabela: String; strAutIncLisIn: String=''):Double;
  Var
    strSQL: String;
    qryTotal: TUniQuery;
Begin

  qryTotal := fCriaQuery;

  Try

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '     SUM(TMP_VLRCON) AS TOTAL';
    strSQL := strSQL + '   FROM ';
    strSQL := strSQL + strTabela;
    If (strAutIncLisIn <> '') Then
      strSQL := strSQL + ' WHERE TMP_AUTINC IN ('+strAutIncLisIn+') ';

    With qryTotal Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      Open;

      Result := FieldByName('TOTAL').AsFloat;
      Close;
    End;

  Finally
    FreeAndNil(qryTotal);
  End;

End;

function TFatVenda.fVerificaPesoItensRateioFrete: Boolean;
  Var
    strItens: String;
    cdsDados: TUniClientDataSet;

  procedure pAdd(strTexto: String);
  begin
    strItens := strItens + strTexto + #13#10;;
  end;

begin
  Result  := True;

  If Pos(strOpcDoc, 'PD_OR_') > 0 Then
    Exit;

  {**********************************************************************}
  {* Sistema nao configurado para rateio de frete proporcional ao peso  *}
  {*******************************************************************JC*}
  If (fCfgSis('RATFRV') <> '2') Then
    Exit;

  cdsDados  := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  cdsDados.Filter   := cdsVenda.Filter;
  cdsDados.Filtered := cdsVenda.Filtered;

  strItens := '';

  pAdd('.-----------------------------------------------------------.');
  pAdd('| Não será permitido carregar este documento para faturar,  |');
  pAdd('| pois existe(m) produto(s) sem peso.                       |');
  pAdd('.-----------------------------------------------------------.');
  pAdd('| PRODUTO                                           |  UN   |');
  pAdd('.-----------------------------------------------------------.');

  With cdsDados Do
  Begin
    First;
    While Not Eof Do
    Begin
      If fItemEntraRateio(cdsDados) And (FieldByName('ITE_PESOIT').AsFloat = 0) Then
      Begin
        Result  := False;
        pAdd('| ' + fPadR(FieldByName('ITE_CODITE').AsString      + ' - ' +
                          FieldByName('ITE_DESITE').AsString, 49) + ' '   +
             '| ' + fPadC(FieldByName('ITE_SIGUNI').AsString, 05) + ' |'  );
      End;
      cdsDados.Next;
    End;
  End;

  pAdd('.-----------------------------------------------------------.');
  pAdd('Pressione ESC para sair.');

  FreeAndNil(cdsDados);

  If Not Result Then
    TfrmMemo.pShowMessage(strItens, 12);
end;

function TFatVenda.fValidouItensBonificados(strOpcDocLoc: String=''; blnShoMsg: Boolean=True):  Boolean;
  Var
    cdsDados: TUniClientDataSet;
    strIteBon: String;
Begin
  Result := True;

  If fEmptyStr(strOpcDocLoc) Then
    strOpcDocLoc :=  Self.strOpcDoc;

  If (Pos(strOpcDocLoc, 'BR_') > 0) Or (Self.strTipOpe = 'B') Or (Self.fTemClafisBrindeEntreAsClafis) Then
  Begin
    cdsDados := TUniClientDataSet.Create(Nil);
    strIteBon := '';
    Try
      Try
        pCloneDataSet(cdsDados, cdsVenda);

        cdsDados.Filtered := False;
        If ((Pos(strOpcDocLoc, 'BR_') > 0) Or (Self.strTipOpe = 'B') Or (Self.fClafisUnicaBrinde)) Then
        Begin
          cdsDados.Filter := ' (ITE_USABON = ''N'') ';
        End
        Else
        Begin
          cdsDados.Filter := ' (ITE_USABON = ''N'') AND ((ITE_BRINDE = ''S'') OR (ITE_CLAFIS = ''5910'') OR (ITE_CLAFIS = ''6910'')) ';
        End;
        cdsDados.Filtered := True;

        If Not (cdsDados.IsEmpty) Then
        Begin
          cdsDados.First;
          While Not cdsDados.Eof do
          Begin
            pIncrementaListaStr(cdsDados.FieldByName('ITE_CODITE').AsString, strIteBon);
            cdsDados.Next;
          End;
        End;

      Except
        On E: Exception Do
        Begin
          Result := False;;
          pMensagensErro(E.Message, '[fVerificaItensBonificados]');
        End;
      End;
    Finally
      FreeAndNil(cdsDados);
      If (Not fEmptyStr(strIteBon)) And (blnShoMsg) Then
      Begin
        Result := False;
        fMensagem('ATENÇÃO!','Alguns itens não podem ser bonificados!' + #13 +
                             'Código dos Itens : ' + strIteBon, ['&O k']);
      End;
    End;
  End
End;

function TFatVenda.fLocalizaItem(strCodIte,
                                 strDescri  : String;
                                 fltUniTar,
                                 fltQtdIte  : Double;
                                 strNumLot  : String;
                                 recMadeira : untTypesSistema.TDadosMadeira;
                                 strNumCmp  : String = '';
                                 strNitCmp  : String = '';
                                 blnObrigaNumLot : Boolean = False;
                                 blnUsarMesmasPreCondicoes: Boolean = False): Boolean;
  Var
    cdsDados: TUniClientDataSet;
    fltTotIns: Double;
    fltTotAdc: Double;
    fltQtdAdc: Double;
    fltTotEsp: Double;
Begin
  cdsDados := TUniClientDataSet.Create(Nil);
  pCloneDataSet(cdsDados, cdsVenda);
  Try
    Try
      fltTotAdc := 0;
      fltQtdAdc := 0;
      // total do item que está sendo inserido
      fltTotIns := fFormataFloat(fltUniTar * fltQtdIte, 2);

      cdsDados.Filter := ' ITE_DESORI <> ' + QuotedStr('ITEM ESPECIAL') +
                         ' AND ITE_CODITE =  ' + QuotedStr(strCodIte)   +
                         ' AND ITE_UNITAR =  ' + FloatToStr(fltUniTar);

      If (Not fEmptyStr(strNumLot)) Or blnObrigaNumLot Then
        cdsDados.Filter := cdsDados.Filter +
                           '  AND ITE_NUMLOT =  ' + QuotedStr(strNumLot) ;

      If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
        cdsDados.Filter := cdsDados.Filter +
                           ' AND ITE_COMPEC = ' + FloatToStr(recMadeira.fltComPec) +
                           ' AND ITE_LARPEC = ' + FloatToStr(recMadeira.fltLarPec) +
                           ' AND ITE_ESPPEC = ' + FloatToStr(recMadeira.fltEspPec);

      If fConsiderarPedidoDeCompraNaSintetizacaoDeItensNaConfirmacaoDeDocumentos Then
        cdsDados.Filter := cdsDados.Filter +
                           ' AND ITE_NUMCMP = ' + strNumCmp.QuotedString +
                           ' AND ITE_NITCMP = ' + strNitCmp.QuotedString;

      If blnUsarMesmasPreCondicoes Then
      Begin
        cdsDados.Filter := cdsDados.Filter +
                           ' AND ITE_IDEPRO = ''NOR'' ' +
                           ' AND ITE_ENFUDO <> ''S'' ' +
                           ' AND ITE_TEMNSE <> ''S'' ';
      End;

      cdsDados.Filtered := True;

      Result := False;

      {**********************************************************************}
      {* INCLUIDO O FILTRO DA DESCRIÇÃO DESTA MANEIRA POIS NO FILTER DO     *}
      {* CLIENT AO COMPARAR POR EXEMPLO "TESTE" COM "TESTE*" RESULTAVA TRUE *}
      {*******************************************************************PZ*}
      cdsDados.First;
      While Not cdsDados.Eof Do
      Begin
        If (cdsDados.FieldByName('ITE_DESITE').AsString = strDescri) Then
        Begin
          Result := True;
          Break;
        End;

        cdsDados.Next;
      End;

      If (Result) And (Self.strOpcDoc = 'CF') And (not fEhVendaConcreto) Then
      Begin
        {*********************************************************************************}
        {* VERIFICAÇÃO PARA VER SE VAI SINTETIZAR O ITEM NA CONFIRMAÇÃO!                 *}
        {* EM ALGUNS CASOS ACONTECE UMA DIFERENÇA DE CENTAVOS NA COMPARAÇÃO DOS ITENS    *}
        {* CASO DE EXEMPLO:                                                              *}
        {*  O MESMO ITEM EM DOCUMENTOS DIFERENTES, EM QUE OS 2 CONTÉM O MESMO UNIT E QTD *}
        {*                    UNIT: 16.90  QTD: 6.84                                     *}
        {*        16.90 *  6.84  = 115,60 (valor de cada docto)                          *}
        {*        16,90 * 13,68  = 231,19 (somando as qtds)                              *}
        {*                                                                               *}
        {*    115,60 + 115,60 = 231,20                                                   *}
        {*    16,90  * 13,68  = 231,19                                                   *}
        {******************************************************************************RN*}

        cdsDados.First;
        While Not cdsDados.Eof Do
        Begin
          If blnUsarMesmasPreCondicoes Then
          Begin
            If (fCampoTabela('IFNULL(DET_DESESP, 0)', 'MOVDET', ['AUTOINCREM'], [cdsDados.FieldByName('ITE_SEQDET').AsString]) <> 0) Then
            Begin
              Result := False;
              Exit;
            End;
          End;

          // soma dos totite dos itens que já estão na temporária.
          fltTotAdc := fltTotAdc + (cdsDados.FieldByName('ITE_TOTITE').AsFloat);
          // soma das quantidades dos itens que já estão na temporária
          fltQtdAdc := fltQtdAdc + (cdsDados.FieldByName('ITE_QTDITE').AsFloat);
          cdsDados.Next;
        End;

        // total esperado: unitário do item que está sendo inserido multiplicado pela soma das quantidades.
        fltTotEsp := fFormataFloat((fltUniTar * (fltQtdAdc + fltQtdIte)), 2);

        // se a comparação for diferente, significa que vai dar diferença na pCalculaTotGerInterna pois o cálculo do totite é refeito na função.
        If (fFormataFloat(fltTotAdc + fltTotIns, 2) <> fltTotEsp) Then
          Result := False;
      End;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[TFatVenda.fLocalizaItem]');
      End;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
End;

function TFatVenda.fSomaNaTemporaria(strCodIte,
                                     strDescri,
                                     strNumLot: String;
                                     fltUniTar: Double;
                                     fltQtdIte,
                                     fltTotIte,
                                     fltTotCus,
                                     fltTotCu2,
                                     fltQtdEmb,
                                     fltPreEmb,
                                     fltIpiSai: Double;
                                     recMadeira: untTypesSistema.TDadosMadeira;
                                     strCodVen: String='';
                                     strEmpOrc: String='';
                                     fltTotImp: Double=0;
                                     strDocCnf: String='';
                                     strEspCnf: String='';
                                     strEmpCnf: String='';
                                     strIncCnf: String='';
                                     strNumCmp: String='';
                                     strNitCmp: String=''): Boolean;

  Var
    blnAchou: Boolean;
    recParametrosCalculoValorIpi : TParametrosCalculoValorIpi;

  procedure pPreencheClientDataSetDesCff;
  begin  
    If Assigned(cdsIteSin) Then
    Begin
      If (Not fEmptyStr(strIncCnf)) Then
      Begin
        cdsIteSin.Filtered:=False;
        cdsIteSin.Filter := 'AUTINC = ' + IntToStr(cdsVenda.FieldByName('AUTOINCREM').AsInteger);  
        cdsIteSin.Filtered:=True;

        If cdsIteSin.IsEmpty Then
        Begin
          cdsIteSin.Append;
          cdsIteSin.FieldByName('AUTINC').AsInteger := cdsVenda.FieldByName('AUTOINCREM').AsInteger;
          cdsIteSin.FieldByName('INCCNF').AsString  := cdsVenda.FieldByName('ITE_SEQDET').AsString;
          cdsIteSin.FieldByName('ITECNF').AsString  := cdsVenda.FieldByName('ITE_CODITE').AsString;
          cdsIteSin.FieldByName('DOCCNF').AsString  := cdsVenda.FieldByName('ITE_DOCCNF').AsString;
          cdsIteSin.FieldByName('ESPCNF').AsString  := cdsVenda.FieldByName('ITE_ESPCNF').AsString;
          cdsIteSin.FieldByName('EMPCNF').AsString  := cdsVenda.FieldByName('ITE_EMPCNF').AsString;
          cdsIteSin.FieldByName('TOTITE').AsFloat   := cdsVenda.FieldByName('ITE_UNITAR').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          cdsIteSin.Post;
        End;

        If cdsIteSin.Locate('INCCNF', strIncCnf, []) Then
        Begin
          cdsIteSin.Edit;
          cdsIteSin.FieldByName('TOTITE').AsFloat := cdsIteSin.FieldByName('TOTITE').AsFloat + (fltUniTar * fltQtdIte);
        End
        Else
        Begin
          cdsIteSin.Append;
          cdsIteSin.FieldByName('TOTITE').AsFloat := (fltUniTar * fltQtdIte);
        End;
        cdsIteSin.FieldByName('AUTINC').AsInteger := cdsVenda.FieldByName('AUTOINCREM').AsInteger;
        cdsIteSin.FieldByName('ITECNF').AsString  := strCodIte;
        cdsIteSin.FieldByName('INCCNF').AsString  := strIncCnf;
        cdsIteSin.FieldByName('DOCCNF').AsString  := strDocCnf;
        cdsIteSin.FieldByName('ESPCNF').AsString  := strEspCnf;
        cdsIteSin.FieldByName('EMPCNF').AsString  := strEmpCnf;
        cdsIteSin.Post;
      End;
    End;
  end;

  function fLocalizou : Boolean;
    const
      CAMPOS     = 'ITE_CODITE;ITE_DESITE;ITE_UNITAR;ITE_NUMLOT';
      CAMPOS_MAD = 'ITE_CODITE;ITE_DESITE;ITE_UNITAR;ITE_COMPEC;ITE_LARPEC;ITE_ESPPEC';
      CAMPOS_CMP = 'ITE_NUMCMP;ITE_NITCMP';
    VAR
      LCampos : String;
      LVarArr : Variant;
  begin

    LCampos := IIF(fUtilizaVendaMadeiraOuVidroOuMetroLinear, CAMPOS_MAD, CAMPOS) +
               IIF(fConsiderarPedidoDeCompraNaSintetizacaoDeItensNaConfirmacaoDeDocumentos, ';' + CAMPOS_CMP, '');

    If fConsiderarPedidoDeCompraNaSintetizacaoDeItensNaConfirmacaoDeDocumentos Then
    Begin
      LVarArr := IIF(fUtilizaVendaMadeiraOuVidroOuMetroLinear, VarArrayOf([strCodIte, strDescri, fltUniTar, recMadeira.fltComPec, recMadeira.fltLarPec, recMadeira.fltEspPec, strNumCmp, strNitCmp]),
                                                               VarArrayOf([strCodIte, strDescri, fltUniTar, strNumLot, strNumCmp, strNitCmp]));
    End
    Else
    Begin
      LVarArr := IIF(fUtilizaVendaMadeiraOuVidroOuMetroLinear, VarArrayOf([strCodIte, strDescri, fltUniTar, recMadeira.fltComPec, recMadeira.fltLarPec, recMadeira.fltEspPec]),
                                                               VarArrayOf([strCodIte, strDescri, fltUniTar, strNumLot]));
    End;

    Result := cdsVenda.Locate(LCampos, LVarArr, []);

  end;

Begin
  Result := False;

  Try
    With cdsVenda Do
    Begin

      blnAchou := fLocalizou;

      If blnAchou And (strOpcDoc = 'OV') And Not fEmptyStr(strEmpOrc) Then
        blnAchou := (FieldByName('ITE_EMPORC').AsString = strEmpOrc);

      If blnAchou Then
      Begin
        pPreencheClientDataSetDesCff;

        Edit;

        If (Not fEmptyStr(strCodVen)) And (fltTotIte > FieldByName('ITE_TOTITE').AsFloat) Then
          FieldByName('ITE_VENCNF').AsString := strCodVen;

        FieldByName('ITE_QTDITE').AsFloat := FieldByName('ITE_QTDITE').AsFloat + fltQtdIte;
        FieldByName('ITE_TOTITE').AsFloat := FieldByName('ITE_TOTITE').AsFloat + fltTotIte;
        FieldByName('ITE_TOTCUS').AsFloat := FieldByName('ITE_TOTCUS').AsFloat + fltTotCus;
        FieldByName('ITE_TOTCU2').AsFloat := FieldByName('ITE_TOTCU2').AsFloat + fltTotCu2;
        FieldByName('ITE_QTDEMB').AsFloat := FieldByName('ITE_QTDEMB').AsFloat + fltQtdEmb;
        FieldByName('ITE_PREEMB').AsFloat := FieldByName('ITE_PREEMB').AsFloat + fltPreEmb;

        If (fltTotImp <> 0) Then
          FieldByName('ITE_TOTIMP').AsFloat := FieldByName('ITE_TOTIMP').AsFloat + fltTotImp;

        FillChar(recParametrosCalculoValorIpi, SizeOf(recParametrosCalculoValorIpi), #0);
        recParametrosCalculoValorIpi.CodigoDoCliente := strCodCli;
        recParametrosCalculoValorIpi.CodigoDoProduto := strCodIte;
        recParametrosCalculoValorIpi.CodigoDaEmpresa := fGetEmpCalculoItem(FieldByName('ITE_EMPITE').AsString);
        recParametrosCalculoValorIpi.TotalGeralDoItem := fltTotIte;
        recParametrosCalculoValorIpi.BaixaDeEntregaFutura := blnBaiEntFut;
        recParametrosCalculoValorIpi.ClienteConsumidorFinal := (strCliCon = 'S');
        recParametrosCalculoValorIpi.TipoDeBaixaEntregaFutura := strCfgENFUOP;

        FieldByName('ITE_VALIPI').AsFloat :=
          FieldByName('ITE_VALIPI').AsFloat + objCalculoImpostoIPI.CalcularValorIpi(recParametrosCalculoValorIpi).ValorCalculadoIPI;


        If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
          FieldByName('ITE_QTDPEC').AsFloat := fCalculaQuantidadePecas(FieldByName('ITE_QTDITE').AsFloat,
                                                                       FieldByName('ITE_COMPEC').AsFloat,
                                                                       FieldByName('ITE_LARPEC').AsFloat,
                                                                       FieldByName('ITE_ESPPEC').AsFloat,
                                                                       fRetSiglaUnidade(FieldByName('ITE_CODUNI').AsString));

        Post;

        Result := True;
      End;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fSomaNaTemporaria]');
    End;
  End;

end;

{**************************************}
{* APAGA CUPONS CONFIRMADOS           *}
{***********************************AF*}
function TFatVenda.fApagaCupons: Boolean;
  Var
    strSQL: String;
    strFis: String;
    qryGen: TUniQuery;
Begin

  Try
    Result := True;

    qryGen := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'DELETE FROM ';
    strSQL := strSQL + '  MOVGER    ';
    strSQL := strSQL + 'WHERE       ';
    strSQL := strSQL + '  GER_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  GER_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  GER_CODEMP = :CODEMP     ';

    strFis := '';
    strFis := strFis + 'DELETE FROM ';
    strFis := strFis + '  CADFIS    ';
    strFis := strFis + 'WHERE       ';
    strFis := strFis + '  FIS_NUMDOC = :NUMDOC AND ';
    strFis := strFis + '  FIS_ESPDOC = :ESPDOC AND ';
    strFis := strFis + '  FIS_CODEMP = :CODEMP     ';

    qryTemporariaConfirmacao.First;
    While Not qryTemporariaConfirmacao.Eof Do
    Begin

      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NUMDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString;
        ParamByName('ESPDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString;
        ParamByName('CODEMP').AsString := qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString;
        ExecSQL;

        Close;
        SQL.Clear;
        SQL.Add(strFis);
        ParamByName('NUMDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString;
        ParamByName('ESPDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString;
        ParamByName('CODEMP').AsString := qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString;
        ExecSQL;
      End;

      qryTemporariaConfirmacao.Next;
    End;

    FreeAndNil(qryGen);
  Except

    On E: Exception Do
    Begin
      Result := False;
      FreeAndNil(qryGen);
      pMensagensErro('Erro ao tentar apagar os cupons!' + #13 + E.Message,'[fApagaCupons]');
    End;

  End;

End;

function TFatVenda.fGCadPag: Boolean;
  Var
    intContador: Integer;

    strOpeBai: String;
    strPorBai: String;
    strSeqLan: String;
    fltValRec: Double;
    dtaDtaRec: TDateTime;
    strCtaBai: String;
    strHisBan: String;
    strHisCtr: String;
    intCtpCon: LongInt;
    strNumDup: String;
    lstBanCtp: TBanCtpRepository;
    strDesCtp: String;

    function fEhEstornoDeCredito: Boolean;
    Begin
      Result := SameText(strOpcDoc,'NC') And blnNCFornecedor And (objNfeComplemento.tncTipoNota = tncEstornoDeCredito);
    End;

    function fRetornaPlanoDeContasCadPag: String;
    Begin
      Result := IIF(fEhEstornoDeCredito, fCfgSis('CTAEOF'), fCfgSis('CTADOF'));
    End;

    function fRetornaValorCadPag: Double;
    Begin
      Result := IIF(fEhEstornoDeCredito, arrDuplicata[intContador].curValor, - arrDuplicata[intContador].curValor);
    End;

begin {fGCadPag}

  {*******************************************}
  {* TRAVA SE ESTA CONFIGURAÇÃO              *}
  {* ABAIXO ESTIVER VAZIA OU INCORRETA       *}
  {****************************************JU*}
  If fEmptyStr(fRetDescCentroCusto(fCfgSis('CTAAVI'))) Then
  Begin
    fRollBack;
    fMensagem('', 'A configuração Lançamento bancário à vista - Plano de Contas do grupo Faturamento está vazia ou preenchida incorretamente, corrija!', ['&Ok']);
    Result := False;
    Exit;
  End;

  Try
    Result := True;
    lstBanCtp := Nil;

    strHisCtr := 'REFERENTE A FATURAMENTO';

    intCtpCon := fRetCtpCon(strEmpLog, IIF(strOpcDoc='OF',False,True));

    intContador := 0;
    While (intContador < Length(arrDuplicata))                 And
          (Not fEmptyStr(arrDuplicata[intContador].dtaDtaVen)) Do
    Begin

      If (LeftStr(strClaFis, 1) < '5') Then
      Begin
        arrDuplicata[intContador].curValor := -arrDuplicata[intContador].curValor;
      End;

      If (arrDuplicata[intContador].curValor < 0.0) Or (strOpcDoc = 'OF') Then
      Begin
        If fEmptyStr(strDocDevOF) Then
          strHisCtr := 'DEVOLUCAO - ' + strNumDoc + '-' + strEspDoc
        Else strHisCtr := 'DEVOLUCAO REF NOTA FISCAL DE ENTRADA NRO. ' + strDocDevOF + '-' + strEspDevOF;
      End;

      If SameText(strOpcDoc,'NC') And blnNCFornecedor And (objNfeComplemento.tncTipoNota In [tncCreditoICMS]) Then
      Begin
        strHisCtr := 'CREDITO DE ICMS REF. NF ' + objNfeComplemento.notaReferenciada.strNumDoc +
                     '-' + objNfeComplemento.notaReferenciada.strSerie;
      End;

      If fEhEstornoDeCredito Then
      Begin
        strHisCtr := 'ESTORNO DE CREDITO';
      End;

      if (not fEmptyStr(strHisCtr)) and (not fEmptyStr(arrDuplicata[intContador].strHisFRF)) then
        strHisCtr := strHisCtr + sLineBreak;

      strHisCtr := strHisCtr + arrDuplicata[intContador].strHisFRF;

      dtaDtaRec := 0;
      fltValRec := 0.0;
      strPorBai := '';
      strCtaBai := '';
      strOpeBai := '';

      If (StrToDate(arrDuplicata[intContador].dtaDtaVen) = Self.VS_Date) Then
      Begin

        If (Pos(strCodFpg,'014_015_') <= 0)                                                           And
           (Not fTemFormaPagtoAReceber)                                                               And
           (fBaixaDuplicataAVista)                                                                    And
           (IIF(strEspDoc = 'TR', fCfgSis('TROQUI', varBoolean), True))                               And
           ( Not ( ((Pos(strEspDoc, 'NF_EL_') > 0)) And ( Pos(strClaFis, fCfgSis('CLADEV')) > 0 ) ) ) And
           (Not fDocumentoParaFornecedor)                                                             Then
        Begin

          dtaDtaRec := Self.VS_Date;

          strCtaBai := fCfgSis('CTAAVI');
          strPorBai := strCodPor;
          strOpeBai := strCodVen;
          fltValRec := arrDuplicata[intContador].curValor;

          If strEspDoc = 'TR' Then
          Begin
            strHisBan := 'TROCA MERCADORIA - ' + strNumDoc;
          End
          Else If strEspDoc = 'DV' Then
          Begin
            strHisBan := 'DEVOLUCAO - ' + strNumDoc;
          End
          Else If strEspDoc = 'CR' Then
          Begin
            strHisBan := 'RET. DE CONSIGNAÇÃO - ' + strNumDoc;
          End
          Else If strEspDoc = 'DD' Then
          Begin
            strHisBan := 'DEVOLUCAO DE DEMONSTRACAO - ' + strNumDoc;
          End
          Else If (strEspDoc = 'PD') Then
          Begin
            strHisBan := 'REF. PAGTO. ANTECIPADO - ' + strNumDoc + '-' + strEspDoc;
          End
          Else If (fltValRec < 0.0) Then
          Begin
            strHisBan := 'DEVOLUCAO - ' + strNumDoc + '-' + strEspDoc;
          End
          Else
          Begin
            strHisBan := 'VENDA A VISTA - ' + strNumDoc;
          End;

          lstBanCtp := TBanCtpRepository.Create;
          lstBanCtp.fAdd(strNumDoc,
                         'A',
                         strSerFsc,
                         VS_strCodEmp,
                         strCodCli, // Fornecedor
                         strHisCtr,
                         arrDuplicata[intContador].strHist02,
                         fCfgSis('CTADOF'),
                         VS_strCodEmp,
                         0,
                         IIF(fltValRec < 0.0, (-1) * fltValRec, fltValRec),
                         0,
                         0,
                         0,
                         0);

          strSeqLan := fGravaMovBan(fCfgSis('CTAAVI'),
                                    strCodPor,
                                    strCodVen,
                                    Self.VS_Date,
                                    fRetHoraServidor,
                                    strNumDoc,
                                    IIF(fltValRec < 0.0, 'D', 'C'),
                                    VS_strCodEmp,
                                    IIF(fltValRec < 0.0, (-1) * fltValRec, fltValRec),
                                    strHisBan,
                                    '',
                                    '',
                                    strCodCli, // Fornecedor
                                    strNumDoc,
                                    0,
                                    'A',
                                    VS_strCodEmp,
                                    '',
                                    '',
                                    '',
                                    lstBanCtp.fGetList,
                                    0,
                                    intCtpCon);

          FreeAndNil(lstBanCtp);

          Result := (Not fEmptyStr(strSeqLan));

        End;
      End;

      If (Not Result) Then
        Break;

      if fltValRec > 0 Then
        fltValRec := - fltValRec;

      strNumDup := fStrZero(strNumDoc, 12);

      If fRetornaValorCadPag > 0 Then
        strDesCtp := 'OUTRAS ENTRADAS FORNECEDOR'
      Else
