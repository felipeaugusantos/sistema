end;

procedure TFatVenda.pTotalizaItensNaoRateiaFreteVendaPresencial(arrMatrizesFechamentoParam: TMatrizesFechamento;
                                                                var fltTotItensNaoRateiaFreteVendaPresencial : Double);
var
  intIndice : Integer;
  intContador : Integer;
  arrMatItensLocal: TMatrizFechamento;
begin

  if Assigned(arrMatrizesFechamentoParam) then
  begin
    for intIndice := 0 to Length(arrMatrizesFechamentoParam) - 1 do
    begin
      arrMatItensLocal := arrMatrizesFechamentoParam[intIndice];

      for intContador := 0 to Length(arrMatItensLocal) -1 do
      begin
        if not fVerificaItemRateiaFreteVendaPresencial(arrMatItensLocal[intContador].strEntRet,
                                                       arrMatItensLocal[intContador].strEmpIte) then
        begin
          fltTotItensNaoRateiaFreteVendaPresencial := fltTotItensNaoRateiaFreteVendaPresencial +
                                                      arrMatItensLocal[intContador].fltTotIte;
        end;
      end;
    end;
  end;

end;

function TFatVenda.fBaseRateioFreteVendaPresencial(arrMatrizItensParam: TMatrizFechamento) : Double;
var
  intContador : Integer;
begin
  Result := 0;

  for intContador := 0 to Length(arrMatrizItensParam) -1 do
  begin
    if fVerificaItemRateiaFreteVendaPresencial(arrMatrizItensParam[intContador].strEntRet,
                                               arrMatrizItensParam[intContador].strEmpIte) then
    begin
      Result := Result + arrMatrizItensParam[intContador].fltTotIte;
    end;
  end;
end;

function TFatVenda.fMensagemTratamentoTribDif: String;
  var
    item: TDadosFechamento;

begin
  result := '';
  for item in self.arrMatItens do
  begin
    if ( self.strDentroDoEstado = 'N') and
       ( Pos(self.strClaFis, '_6107_6108_') > 0 ) and
       (( Pos('NCO', self.strTpAbre) > 0 ) or ( Pos('CTA', self.strTpAbre) > 0 )) and
       ( Pos(item.strCodAbf, '_224_225_226_') > 0 ) then
    begin
      result := 'Empresa beneficiada com o Tratamento Tributário Diferenciado 478 nº 245000003616005, conforme art.21, XV, do Anexo 2 do decreto 2.870/01 (RICMS/SC)';
      exit;
    end;
  end;
end;

function TFatVenda.fExisteDiferencaNoValorDoFrete: Boolean;
Var
  intContador: Integer;
  fltFreteItens: Double;
begin

  fltFreteItens := 0;

  For intContador := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
  Begin
    fltFreteItens := fltFreteItens + Self.arrMatItens[intContador].fltValFre;
  End;

  Result := (abs(fFormataFloat(Self.fltValFre, 2) - fFormataFloat(fltFreteItens, 2)) > 0.05);

end;

function fGerarPedidoReservaEstoqueParaEnderecamentoProdutosSeparados(strNumDoc,
                                                                      strEspDoc,
                                                                      strEmpDoc                     : String;
                                                                      blnBaixaPedidoNaoSeraEntregue : Boolean = False;
                                                                      blnCancelamentoDocumentos     : Boolean = False;
                                                                      strNumFat                     : String = '';
                                                                      strEspFat                     : String = ''): Boolean;
var
  qryItens: TUniQuery;
  endItem: TEndItem;
  endDocumento: TEndDocumento;
  objEnderecamento: TEnderecamentoProduto;
  strCodEmpBkp: String;
  LConsiderarQtdMOVDET: Boolean;
begin
  Result := True;
  if not fUsaEnderecamento then
    Exit;

  if not fCfgSis('CANEND', varBoolean) then
    Exit;

  LConsiderarQtdMOVDET := blnCancelamentoDocumentos and fCfgSis('EXDFSE', varBoolean) and (not fEmptyStr(strNumFat));

  qryItens := fCriaQuery;
  try
    qryItens.SQL.Add('SELECT');
    qryItens.SQL.Add('  FDO_CODITE, FDO_DESCRI, FDO_CODMAR,');
    qryItens.SQL.Add('  FDO_REFERE, FDO_UNIDAD, FGO_CODCLI, ');
    qryItens.SQL.Add('  FGO_EMPEXP, ');
    qryItens.SQL.Add('  FATDOR.AUTOINCREM, ');
    qryItens.SQL.Add(IIF(LConsiderarQtdMOVDET, ' DET_QTDITE ', 'FDO_QTDSEP - FDO_QTDBAI') + ' AS QTDEND, ');
    qryItens.SQL.Add('  COALESCE(LDO_NUMLOT, FDO_NUMLOT) AS FDO_NUMLOT');
    qryItens.SQL.Add('FROM FATDOR');
    qryItens.SQL.Add('INNER JOIN EXTDOR ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO');
    qryItens.SQL.Add('INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER');
    qryItens.SQL.Add('INNER JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM');
    qryItens.SQL.Add('LEFT JOIN LOTDOR ON LDO_SEQFDO = FATDOR.AUTOINCREM');

    if LConsiderarQtdMOVDET then
    begin
      qryItens.SQL.Add('LEFT JOIN MOVAUX A ON FATDOR.AUTOINCREM = A.DET_INC_PD');
      qryItens.SQL.Add('LEFT JOIN MOVDET D ON A.DET_SEQGER = D.AUTOINCREM');
    end;

    qryItens.SQL.Add('WHERE FDO_NUMDOC = :NUMDOC');
    qryItens.SQL.Add('  AND FDO_ESPDOC = :ESPDOC');
    qryItens.SQL.Add('  AND FDO_CODEMP = :CODEMP');
    qryItens.SQL.Add('  AND FDO_JAFATU = 0');

    if (not LConsiderarQtdMOVDET) then
      qryItens.SQL.Add('  AND FDO_QTDSEP - FDO_QTDBAI > 0 ')
    else
    begin
      qryItens.SQL.Add('  AND DET_NUMDOC = :NUMFAT');
      qryItens.SQL.Add('  AND DET_ESPDOC = :ESPFAT');
      qryItens.SQL.Add('  AND DET_CODEMP = :EMPFAT');

      qryItens.ParamByName('NUMFAT').AsString := strNumFat;
      qryItens.ParamByName('ESPFAT').AsString := strEspFat;
      qryItens.ParamByName('EMPFAT').AsString := VS_strCodEmp;
    end;

    qryItens.ParamByName('NUMDOC').AsString := strNumDoc;
    qryItens.ParamByName('ESPDOC').AsString := strEspDoc;
    qryItens.ParamByName('CODEMP').AsString := strEmpDoc;

    qryItens.Open;

    if qryItens.IsEmpty then
      Exit;

    objEnderecamento := TEnderecamentoProduto.Create(blnCancelamentoDocumentos);
    objEnderecamento.blnBaixaPedidoNaoSeraEntregue := blnBaixaPedidoNaoSeraEntregue;

    try
      strCodEmpBkp := '';
      if (not fEmptyStr(qryItens.FieldByName('FGO_EMPEXP').AsString)) and (VS_strCodEmp <> qryItens.FieldByName('FGO_EMPEXP').AsString) then
      begin
        strCodEmpBkp := VS_strCodEmp;
        pSetaEmpresaLogada(qryItens.FieldByName('FGO_EMPEXP').AsString);
      end;

      endDocumento.strNumDoc := strNumDoc;
      endDocumento.strEspDoc := strEspDoc;
      endDocumento.strSerie_ := fCfgSis('SERFSC');
      endDocumento.strCodEmp := strEmpDoc;

      endDocumento.strCliFor := qryItens.FieldByName('FGO_CODCLI').AsString;
      endDocumento.strTip_FC := 'C';

      objEnderecamento.endDocumento := endDocumento;

      while not qryItens.Eof do
      begin
        If fEhItemServico(qryItens.FieldByName('FDO_CODITE').AsString) Then
        begin
          qryItens.Next;
          Continue;
        end;

        If qryItens.FieldByName('FDO_CODITE').AsString = fCfgSis('ITEFRE') Then
        begin
          qryItens.Next;
          Continue;
        end;

        If qryItens.FieldByName('FDO_CODITE').AsString = fCfgSis('ITEBOM') Then
        begin
          qryItens.Next;
          Continue;
        end;

        If qryItens.FieldByName('FDO_CODITE').AsString = fCfgSis('ITETAX') Then
        begin
          qryItens.Next;
          Continue;
        end;

        If Not fItemRealizaEnderecamento(qryItens.FieldByName('FDO_CODITE').AsString) Then
        begin
          qryItens.Next;
          Continue;
        end;

        If fItemJaRealizadoEnderecamento(qryItens.FieldByName('AUTOINCREM').AsString) Then
        begin
          qryItens.Next;
          Continue;
        end;

        endItem.strCodIte := qryItens.FieldByName('FDO_CODITE').AsString;
        endItem.strCodMar := qryItens.FieldByName('FDO_CODMAR').AsString;
        endItem.strDesIte := qryItens.FieldByName('FDO_DESCRI').AsString;
        endItem.strRefere := qryItens.FieldByName('FDO_REFERE').AsString;
        endItem.strCodUni := qryItens.FieldByName('FDO_UNIDAD').AsString;
//          endItem.strCodFor := arrMatItens[intAux].strCodFor;
        endItem.fltQtdIte := qryItens.FieldByName('QTDEND').AsFloat;
        endItem.strCodAmz := qryItens.FieldByName('FDO_NUMLOT').AsString;
        endItem.strAutEnd := qryItens.FieldByName('AUTOINCREM').AsString;
        endItem.blnRefugo := False;

        objEnderecamento.pAddItem(endItem);

        qryItens.Next;
      end;

      If objEnderecamento.fQtdItens > 0 Then
        Result := objEnderecamento.fGerarPedidoParaReservarEstoque;
    finally
      if (not fEmptyStr(strCodEmpBkp)) then
        pSetaEmpresaLogada(strCodEmpBkp);

      FreeAndNil(objEnderecamento);
    end;

  finally
    FreeAndNil(qryItens);
  end;

end;

procedure TFatVenda.pEnviarNotaEletronicaControleEntrega(pgbProgresso: TCxProgressBar);
Var
  blnPonImpDoc: Boolean;
  lblProgresso: TLabel;
begin
  lblProgresso := nil;
  if Assigned(pgbProgresso) then
    lblProgresso := TLabel(GetParentForm(pgbProgresso).FindComponent('lblGravando'));

  pProgresso(0, 0, pgbProgresso);

  If fEmptyStr(strEntregaNumDoc) Then
    Exit;

  blnPonImpDoc := False;

  Try
    blnPonImpDoc := Not fEmptyStr(Self.strPonImp) And fEmptyStr(VS_strPonImp);

    If blnPonImpDoc Then
    Begin
      VS_blnUsaPonImp := True;
      VS_strPonImp    := Self.strPonImp;
    End;

    fEnviarNotaLibNfe(strEntregaNumDoc, strEntregaEspDoc, strEntregaCodEmp, strEntregaSerie_, strEntregaCodCli, strEntregaTip_FC, lblProgresso);
  Finally
    If blnPonImpDoc Then
    Begin
      VS_blnUsaPonImp := False;
      VS_strPonImp    := '';
    End;
  End;

End;

function TFatVenda.fPermiteDescontoEspecialNaConfirmacaoDeDocumentos: Boolean;
begin
  Result := fCfgSis('DESCFF', varBoolean) And (Self.strOpcDoc = 'CF');
end;

function TFatVenda.fItemCondicaoEspecial(strCodIte, strCondPag : String) : Boolean;
{******************************************************************}
{ VERIFICAR REGRA DE CONDIÇÃO ESPECIAL DE PAGAMENTO PARA O PRODUTO }
{****************************************************************KM}
var
  qryProdCondPag : TUniQuery;
begin
  qryProdCondPag := fCriaQuery();
  Try
    qryProdCondPag.Close;
    qryProdCondPag.SQL.Clear;
    qryProdCondPag.SQL.Add(' SELECT CC.AUTOINCREM  ');
    qryProdCondPag.SQL.Add(' FROM CADCES CC ');
    qryProdCondPag.SQL.Add(' INNER JOIN ITECES IC ON IC.ICE_SEQGER = CC.AUTOINCREM ');
    qryProdCondPag.SQL.Add(' INNER JOIN CESEMP CE ON CE.CES_SEQGER = CC.AUTOINCREM ');
    qryProdCondPag.SQL.Add('                     AND CE.CES_CODEMP = ' + QuotedStr(VS_strCodEmp)); {Empresa logada}
    qryProdCondPag.SQL.Add(' INNER JOIN CNDCES CD ON CD.CES_SEQGER = CC.AUTOINCREM ');
    qryProdCondPag.SQL.Add(' WHERE CD.CES_CODCND  = :CNDPAG');
    qryProdCondPag.SQL.Add('   AND IC.ICE_CODITE  = :CODITE  ');
    qryProdCondPag.SQL.Add('   AND CURRENT_DATE BETWEEN CC.CES_DTAINI AND CC.CES_DTAFIM '); {Dentro da validade}
    qryProdCondPag.ParambyName('CNDPAG').AsString := strCondPag;
    qryProdCondPag.ParambyName('CODITE').AsString := strCodIte;
    qryProdCondPag.Open;

    Result := (not qryProdCondPag.IsEmpty);
  Finally
    FreeAndNil(qryProdCondPag);
  End;
end;


function TFatVenda.fProdutoForaCondEsp(strCondPag : String; cdsVenda: TUniClientDataSet) : Boolean;
{*****************************************************************************************}
{VERIFICA SE ALGUM PRODUTO DA LISTA DE PRODUTOS, ESTÁ FORA DA CONDIÇÃO ESPECIAL INFORMADA }
{***************************************************************************************KM}
Var
  cdsDados : TUniClientDataSet;
begin
  Result   := False;
  if cdsVenda.IsEmpty then
    Exit;

  cdsDados := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.First;
    while not cdsDados.EOF do
    begin
      If (Not fEhItemServico(cdsDados.FieldByname('ITE_CODITE').AsString)) And
         (Not fItemCondicaoEspecial(cdsDados.FieldByname('ITE_CODITE').AsString, strCondPag)) Then
      Begin
        Result := True;
        Break;
      End;
      cdsDados.Next;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
End;

function TFatVenda.fProdutoForaCondEsp(strCondPag : String) : Boolean;
{*****************************************************************************************}
{VERIFICA SE ALGUM PRODUTO DA LISTA DE PRODUTOS, ESTÁ FORA DA CONDIÇÃO ESPECIAL INFORMADA }
{ UTILIZANDO A MATRIZ DE FECHAMENTO                                                       }
{***************************************************************************************KM}
Var
  Itens, ItensCorte: TMatrizFechamento;
  intCont : Integer;
begin
  Result   := False;

  pPreencheMatrizFechamento(Itens, ItensCorte);
  For intCont := 0 To Length(Itens) -1 Do
  Begin
    If (Not fEhItemServico(Itens[intCont].strCodIte)) And
       (Not fItemCondicaoEspecial(Itens[intCont].strCodIte, strCondPag)) Then
    Begin
      Result := True;
      Break;
    End;
  End;
End;

procedure TFatVenda.pCalculaFunrural(fltVarCon: Double);
var
  qrySelect: TUniQuery;
  intContador: Integer;
  fltValDup: Double;
  fltTotValDup: Double;
begin
  fltFunruralBase := 0;
  fltFunruralAliquota := 0;
  fltFunruralValor := 0;

  if strOpcDoc <> 'EF' then
    Exit;

  if fDocumentoParaFornecedor Or fEmptyStr(strCodCli) then
  begin
    qrySelect := fCriaQuery;
    try
      qrySelect.SQL.Text :=
        'SELECT FOR_USARFR, FOR_RFRALI, FOR_RFRFOR, FOR_RFRCTA, FOR_RFREVE, FOR_RFRTVE, FOR_RFRDVE ' +
        'FROM CADFOR ' +
        'WHERE FOR_CODFOR = :CODFOR';

      qrySelect.ParamByName('CODFOR').AsString := strCodCli;
      if fEmptyStr(strCodCli) then
        qrySelect.ParamByName('CODFOR').AsString := strCodFor;

      qrySelect.Open;

      if qrySelect.FieldByName('FOR_USARFR').AsString = 'S' then
      begin
        fltFunruralBase     := fltVarCon;
        fltFunruralAliquota := qrySelect.FieldByName('FOR_RFRALI').AsFloat;
        fltFunruralValor    := RoundTo(fltFunruralBase * fltFunruralAliquota / 100, -2);

        strFunruralFornecedor := qrySelect.FieldByName('FOR_RFRFOR').AsString;
        strFunruralCodCta     := qrySelect.FieldByName('FOR_RFRCTA').AsString;
        strFunruralCodEve     := qrySelect.FieldByName('FOR_RFREVE').AsString;
        strFunruralTipoVenc   := qrySelect.FieldByName('FOR_RFRTVE').AsString;
        intFunruralDiaVenc    := qrySelect.FieldByName('FOR_RFRDVE').AsInteger;

        fltValDup := RoundTo(fltFunruralValor / fRetQtdDuplicatas(arrDuplicata), -2);
        fltTotValDup := 0;
        intContador := 0;

        While (intContador < Length(arrDuplicata))                 And
              (Not fEmptyStr(arrDuplicata[intContador].dtaDtaVen)) Do
        Begin
          arrDuplicata[intContador].curValor := arrDuplicata[intContador].curValor - fltValDup;
          arrDuplicata[intContador].strHisFRF := 'Duplicata com abatimento da retenção de Funrural no valor de R$ ' + FormatFloat('#,##0.00', fltValDup);

          fltTotValDup := fltTotValDup + fltValDup;

          Inc(intContador);
        end;

        // caso tenha quebra, joga diferença na ultima parcela
        if fltFunruralValor > fltTotValDup then
        begin
          Dec(intContador);
          arrDuplicata[intContador].curValor := arrDuplicata[intContador].curValor - (fltFunruralValor - fltTotValDup);
          arrDuplicata[intContador].strHisFRF := 'Duplicata com abatimento da retenção de Funrural no valor de R$ ' + FormatFloat('#,##0.00', fltValDup + (fltFunruralValor - fltTotValDup));
        end;
      end;
    finally
      FreeAndNil(qrySelect);
    end;
  end;
end;

function TFatVenda.fGCadPagFunrural: Boolean;

  function fCalcularDataVencimento: TDateTime;
  var
    wrdAno, wrdMes, wrdDia : Word;
    dteVencto, dteUltDiaMes: TDateTime;
  begin
    dteVencto := Self.VS_Date;
    DecodeDate(dteVencto, wrdAno, wrdMes, wrdDia);

    If wrdMes = 12 Then
      dteUltDiaMes := EndOfAMonth(wrdAno + 1, 1)
    Else
      dteUltDiaMes := EndOfAMonth(wrdAno, wrdMes +1);

    DecodeDate(dteUltDiaMes, wrdAno, wrdMes, wrdDia);

    Case StrToIntDef(strFunruralTipoVenc, 0) Of
      //VENCIMENTO EM DIA FIXO
      0: Result := EncodeDate(wrdAno,
                              wrdMes,
                              IIF(intFunruralDiaVenc > wrdDia,
                                  wrdDia,
                                  intFunruralDiaVenc));
      //VENCIMENTO NO ÚLTIMO DIA DO MÊS
      1: Result := EncodeDate(wrdAno,
                              wrdMes,
                              wrdDia);
      Else
        Result := 0;
    End;
  end;

  Var
    strHisCtr: String;
    intCtpCon: LongInt;
    strNumDup: String;
