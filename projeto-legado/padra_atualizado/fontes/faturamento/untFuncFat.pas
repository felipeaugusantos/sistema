function TFatVenda.fGravaLogConfirmacao : Boolean;
  Var
    qryLogConfir : TUniQuery;
    qryConfMI    : TUniQuery;
    strSitFin : String;
    strSQL : String;
begin
  Result := True;
  qryLogConfir := fCriaQuery;
  qryConfMI    := fCriaQuery;

  strSQL := '';
  strSQL := strSQL + 'SELECT ';
  strSQL := strSQL + '  * ';
  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + strTabelaConfMi;

  qryConfMI.Close;
  qryConfMI.SQL.Text := strSQL;
  qryConfMI.Open;


  Try
    Try
      qryLogConfir.Close;
      qryLogConfir.SQL.Clear;
      qryLogConfir.SQL.Add('INSERT INTO LOG_CONFIR                                                       ');
      qryLogConfir.SQL.Add('(LOG_DATA, LOG_HORA, LOG_NUMDOC, LOG_ESPDOC, LOG_CODEMP, LOG_SINCNF, LOG_FILDOC, ');
      qryLogConfir.SQL.Add(' LOG_FILESP, LOG_DTAINI, LOG_DTAFIN, LOG_NOVCLI, LOG_ENDERE, LOG_SITFIN, LOG_DOCUME, LOG_DOCESP, ');
      qryLogConfir.SQL.Add(' LOG_DOCEMP, LOG_VLRTOT, LOG_DOCPAG, LOG_DOCITE, LOG_DOCSIN, LOG_DOCDEV )');
      qryLogConfir.SQL.Add('VALUES                                                                   ');
      qryLogConfir.SQL.Add('(:DATA, :HORA, :NUMDOC, :ESPDOC, :CODEMP, :SINCNF, :FILDOC, ');
      qryLogConfir.SQL.Add(' :FILESP, :DTAINI, :DTAFIN, :NOVCLI, :ENDERE, :SITFIN, :DOCUME, :DOCESP, ');
      qryLogConfir.SQL.Add(' :DOCEMP, :VLRTOT, :DOCPAG, :DOCITE, :DOCSIN, :DOCDEV )');

      qryConfMI.First;

      While (Not qryConfMI.Eof) Do
      Begin
        qryLogConfir.ParamByName('DATA').AsDate      := fRetDataServidor;
        qryLogConfir.ParamByName('HORA').AsTime      := fRetHoraServidor;
        qryLogConfir.ParamByName('NUMDOC').AsString  := strNumDoc;
        qryLogConfir.ParamByName('ESPDOC').AsString  := strEspDoc;
        qryLogConfir.ParamByName('CODEMP').AsString  := VS_strCodEmp;
        qryLogConfir.ParamByName('SINCNF').AsString  := fCfgSis('SINCNF', VarString);
        qryLogConfir.ParamByName('FILDOC').AsString  := objLogConfir.FilDoc;
        qryLogConfir.ParamByName('FILESP').AsString  := objLogConfir.FilEsp;
        qryLogConfir.ParamByName('DTAINI').AsString  := objLogConfir.DtaFin;
        qryLogConfir.ParamByName('DTAFIN').AsString  := objLogConfir.DtaFin;
        qryLogConfir.ParamByName('NOVCLI').AsString  := objLogConfir.NovCli;
        qryLogConfir.ParamByName('ENDERE').AsString  := objLogConfir.Endere;

        case AnsiIndexStr(UpperCase(objLogConfir.SitFin), ['TODOS', 'QUITADO','EM ABERTO']) of
          0 : strSitFin := 'T';
          1 : strSitFin := 'Q';
          2 : strSitFin := 'A';
        end;

        qryLogConfir.ParamByName('SITFIN').AsString  := strSitFin;
        qryLogConfir.ParamByName('DOCUME').AsString  := qryConfMI.FieldByName('TMP_NUMDOC').AsString;
        qryLogConfir.ParamByName('DOCESP').AsString  := qryConfMI.FieldByName('TMP_ESPDOC').AsString;
        qryLogConfir.ParamByName('DOCEMP').AsString  := qryConfMI.FieldByName('TMP_CODEMP').AsString;
        qryLogConfir.ParamByName('VLRTOT').AsFloat   := qryConfMI.FieldByName('TMP_VLRCON').AsFloat;
        qryLogConfir.ParamByName('DOCPAG').AsFloat   := qryConfMI.FieldByName('TMP_DUPREC').AsFloat;
        qryLogConfir.ParamByName('DOCITE').AsFloat   := qryConfMI.FieldByName('TMP_ITEDOC').AsFloat;
        qryLogConfir.ParamByName('DOCSIN').AsString  := qryConfMI.FieldByName('SAV_SINTET').AsString;
        qryLogConfir.ParamByName('DOCDEV').AsString  := qryConfMI.FieldByName('TMP_DDEVOL').AsString;
        qryLogConfir.ExecSQL;
        qryConfMI.Next;
      End;
    Except
    on E: Exception do
      begin
        Result := False;
        Raise Exception.create('fGravaLogConfirmacao ' + E.message);
      end;
    End;
  finally
    qryConfMI.EnableControls;
    FreeAndNil(qryLogConfir);
  end;

end;

procedure TFatVenda.pIniciaRomaneioTarefasFusion(strNumDoc, strEspDoc, strCodEmp: String);
begin
  if (not Assigned(objRomFusTarefas)) then
    Exit;

  objRomFusTarefas.pLogAdd('FATGOR', ['FGO_CODCLI', 'FGO_LIBERA', 'FGO_LIBCOM', 'FGO_ENTFUT', 'FGO_CODTRA'],
        'FGO_NUMDOC = ' + QuotedStr(strNumDoc) +
        ' AND FGO_ESPDOC = ' + QuotedStr(strEspDoc) +
        ' AND FGO_CODEMP = ' + QuotedStr(strCodEmp),
        'INNER JOIN EXTGOR ON FATGOR.AUTOINCREM = FGO_SEQFGO AND FGO_INTFUS <> "N" ');

  objRomFusTarefas.pLogAdd('AUXGOR', ['AUX_ENTGER'],
        'FGO_NUMDOC = ' + QuotedStr(strNumDoc) +
        ' AND FGO_ESPDOC = ' + QuotedStr(strEspDoc) +
        ' AND FGO_CODEMP = ' + QuotedStr(strCodEmp),
        'INNER JOIN FATGOR F ON F.AUTOINCREM = AUX_SEQGER ' +
        'INNER JOIN EXTGOR E ON F.AUTOINCREM = FGO_SEQFGO AND FGO_INTFUS <> "N" ');

  objRomFusTarefas.pLogAdd('FATDOR', ['FDO_CODITE', 'FDO_QTDITE'],
        'FDO_NUMDOC = ' + QuotedStr(strNumDoc) +
        ' AND FDO_ESPDOC = ' + QuotedStr(strEspDoc) +
        ' AND FDO_CODEMP = ' + QuotedStr(strCodEmp),
        'INNER JOIN FATGOR F ON FDO_SEQGER = F.AUTOINCREM ' +
        'INNER JOIN EXTGOR E ON F.AUTOINCREM = FGO_SEQFGO AND FGO_INTFUS <> "N" ');
end;

procedure TFatVenda.pConcatenaInformacoesItemConcreto(const strCodIte, strDescri: String; const fltQtdIte, fltVlrCon: Double);
Begin
  If (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO) Then
    Exit;

  If (Not fEhItemConcreto(strCodIte)) Then
    Exit;

  {Informação:
   Verifica se concatena/soma pois na expedição podemos selecionar mais de um PD!}
  If fEmptyStr(strVolCCR) Then
    Self.strVolCCR := FormatFloat('###,###,##0.00', fltQtdIte)
  Else
    Self.strVolCCR := FormatFloat('###,###,##0.00', fltQtdIte + Self.strVolCCR.ToDouble());

  If fEmptyStr(Self.strIteCCR) Then
    Self.strIteCCR := strDescri + ' - R$ ' + FormatFloat('###,###,##0.00', fltVlrCon)
  Else
    Self.strIteCCR := Self.strIteCCR + #13#10 + strDescri + ' - R$ ' + FormatFloat('###,###,##0.00', fltVlrCon);
End;

procedure TFatVenda.pCarregaConsultasDeFrete(const strNumDoc, strEspDoc, strCodEmp: String);
  var
    LQryDados : TUniQuery;
begin
  LQryDados := fCriaQuery(nil);
  try
    LQryDados.SQL.Text := ' SELECT FRE_TIPAPI, FRE_DISTAN, FRE_VLRPED, FRE_VLRCMB, '
                        + '        FRE_TOTFRE, FRE_CODTAB, FRE_COTID_, FRE_AIENPA, FRE_DIAENT  '
                        + '   FROM FREFAT '
                        + '  WHERE FRE_NUMDOC = :NUMDOC '
                        + '    AND FRE_ESPDOC = :ESPDOC '
                        + '    AND FRE_CODEMP = :CODEMP ';

    LQryDados.ParamByName('NUMDOC').AsString := strNumDoc;
    LQryDados.ParamByName('ESPDOC').AsString := strEspDoc;
    LQryDados.ParamByName('CODEMP').AsString := strCodEmp;
    LQryDados.Open;

    if LQryDados.IsEmpty then
      Exit;

    Self.strFreTipApi := LQryDados.FieldByName('FRE_TIPAPI').AsString;
    Self.fltQlpDist   := LQryDados.FieldByName('FRE_DISTAN').AsFloat;
    Self.fltQlpVlrPed := LQryDados.FieldByName('FRE_VLRPED').AsFloat;
    Self.fltQlpVlrCmb := LQryDados.FieldByName('FRE_VLRCMB').AsFloat;
    Self.fltVlrFreFat := LQryDados.FieldByName('FRE_TOTFRE').AsFloat;
    Self.intCodTab    := LQryDados.FieldByName('FRE_CODTAB').AsInteger;
    Self.strCotId_    := LQryDados.FieldByName('FRE_COTID_').AsString;
    Self.strAutIncEndPartida := LQryDados.FieldByName('FRE_AIENPA').AsString;
    Self.IntDiasEnt   := LQryDados.FieldByName('FRE_DIAENT').AsInteger;
  finally
    FreeAndNil(LQryDados);
  end;
end;

procedure TFatVenda.pCarregarSerieDoItem(const strTemNse, strAutIncDor, strCodIte, strEmpIte: String; intAutIncCds: Integer; const strAutIncPedido : String);
begin
  If (Not fCfgSis('NSERQT', varBoolean)) Then
