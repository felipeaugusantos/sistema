function TValidarAbastecimentoEstoqueDoPedido.fValidarTransferenciasDeEstoque: Boolean;
  Var
    strID: String;
begin
  FInconsistencia := '';
  Result := True;

  For strId In FIdPreparacaoTE Do
    If Not fJaFoiEmitidoPedidosTransferencia(strID) Then
      Exit(False);

  For strId In FIdPedidosTransf Do
    If Not fJaFoiEmitidoDocumentoTransferencia(strID) Then
      Exit(False);

  For strId In FIdPedidosTransf Do
    If Not fJaFoiRealizadaEntradaMercadoriaTransferencia(strID) Then
      Exit(False);
end;

function TValidarAbastecimentoEstoqueDoPedido.fValidarRequisicoesDeCompra: Boolean;
  Var
    strID: String;
begin
  FInconsistencia := '';
  Result := True;

  if not (FVerificaSeImprimeSeparacao) Then
    For strId In FIdPreparacaoRQ Do
      If Not fJaFoiEmitidoRequisicoesCompra(strID) Then
        Exit(False);

  For strId In FIdRequisicoes Do
    If Not fJaFoiEmitidoPedidoDeCompraRequisicao(strID) Then
      Exit(False);

  For strId In FIdRequisicoes Do
    If Not fJaFoiRealizadaEntradaMercadoriaRequisicao(strID) Then
      Exit(False);
end;

