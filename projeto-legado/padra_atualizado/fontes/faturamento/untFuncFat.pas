procedure TFatVenda.pGravarMovFlex(arrProduto: TDadosFechamento);
  Var
    strCreDeb : String;
    objMovFlex : TMovFlex;
    blnGerarFlex : Boolean;
    blnItemEmbalagemFechada : Boolean;
begin
  If fCfgSis('UTIFNS', varBoolean) Then
    Exit;

  objMovFlex           := TMovFlex.Create(Nil);
  objMovFlex.fltValLan := fFormataFloat(fCalculaValorFlex(arrProduto, strCreDeb), 2);
  objMovFlex.strCreDeb := strCreDeb;
  objMovFlex.strOrigem := 'F';
  objMovFlex.strCodVba := '';

  If (blnDevNota) Or (strOpcDoc = 'DV') Then
    objMovFlex.strCreDeb := IIF(strCreDeb = 'D','C','D');

  blnGerarFlex := True;

  If ((blnDevNota) Or (strOpcDoc = 'DV')) And
     (Not objMovFlex.fExisteDocumento(arrProduto.strDocDev, arrProduto.strEspDev, arrProduto.strEmpDev, arrProduto.strCodIte)) Then
  Begin
    blnGerarFlex := False;
  End;

  blnItemEmbalagemFechada := fEhEmbalagemFechadaItem(arrProduto.strCodIte, arrProduto.strTabPre, arrProduto.fltQtdIte);

  If (blnGerarFlex) And
     ((fFormataFloat(objMovFlex.fltValLan,2) <> 0) And ((arrProduto.strPromoc = 'N') Or ((arrProduto.strPromoc = 'S') And (fCfgSis('PROFLE', varBoolean)))) And ((Not blnItemEmbalagemFechada) Or ((blnItemEmbalagemFechada) And (fCfgSis('EMFFLE', varBoolean))))) Or
     fBrindeBonificacao                                                              Then
  Begin
    If (fBrindeBonificacao) And (Not fCfgSis('BONFLE', VarBoolean)) Then
    Begin
      objMovFlex.pExcluir(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, arrProduto.strCodIte, arrProduto.strSeqDet);
    End
    Else
    Begin
      objMovFlex.strNumDoc := strNumDoc;
      objMovFlex.dtaDtaLan := IIF(SameText(strEspDoc,'PD'), dtaGraPed, dtaDtaEnt);
      objMovFlex.strCodVen := strCodVen;
      objMovFlex.strCodRep := strCodRep;
      objMovFlex.strCodCli := strCodCli;
      objMovFlex.strCodIte := arrProduto.strCodIte;
      objMovFlex.strCodEmp := VS_strCodEmp;
      objMovFlex.strNumPok := strNumPok;
      objMovFlex.strEspDoc := strEspDoc;

      If SameText(strEspDoc,'PD') Then
        objMovFlex.strSeqDor := strAutIncFdo
      Else
        objMovFlex.strSeqDor := strAutIncDet;

      {**************************}
      {* VENDA COM/SEM DESCONTO *}
      {***********************MM*}

      {**************************}
      {* BONIFICAÇÃO            *}
      {***********************MM*}
      If fBrindeBonificacao Then
        objMovFlex.strHistor := 'BRINDE/BONIFICACAO: ' + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp
      Else If (SameText(strTipOpe,'V')) Or (SameText(strTipOpe,'C')) Then
      Begin
        If SameText(strEspDoc,'PD') Then
          objMovFlex.strHistor := 'PEDIDO: ' + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp + '-' + arrProduto.strCodIte
        Else
        Begin
          If (blnDevNota) Or (strOpcDoc = 'DV') Then
            objMovFlex.strHistor := 'DEVOLUÇÃO: ' + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp + '-' + arrProduto.strCodIte
          Else
            objMovFlex.strHistor := 'VENDA: ' + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp + '-' + arrProduto.strCodIte;
        End;
      End;

      If SameText(strEspDoc,'PD') Then
      Begin
        objMovFlex.pExcluir(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, arrProduto.strCodIte, arrProduto.strSeqDet);

        If (blnEntregaImediataEmNovoPedido Or blnRetiraOutraLojaEmNovoPedido Or
            blnRetiraExpedicaoEmNovoPedido Or blnDesmembramentoDePedidosComAdiantamento Or
            blnRetiraMesmaLojaEmNovoPedido Or blnAbastecTransfReqEmNovoPedido) And (Not fEmptyStr(arrProduto.strSeqDet)) Then
          objMovFlex.pExcluirItemDoPedido(arrProduto.strSeqDet);
      End
      Else
      Begin
        If Not ((blnDevNota) Or (strOpcDoc = 'DV')) Then
        Begin
          If (blnExpedi) Or (strOpcDoc = 'CP') Then
            objMovFlex.pAtualiza(arrProduto.strNumOrc, arrProduto.strEspOrc, IIF(arrProduto.strEmpOrc.IsEmpty, VS_strCodEmp, arrProduto.strEmpOrc), strCodCli, arrProduto.strCodIte, objMovFlex.fltValLan, 'FATURANDO PEDIDO', arrProduto.strSeqDet)
          Else
            objMovFlex.pExcluir(strNumOrc, strEspOrc, VS_strCodEmp, strCodCli, arrProduto.strCodIte, arrProduto.strSeqDet, True, 'FATURANDO PEDIDO');
        End;
      End;

      objMovFlex.pAdiciona;
      objMovFlex.fGravar;
    End;
  End;

  FreeAndNil(objMovFlex);
end;

procedure TFatVenda.pHabilitarPortadorPedido(pnlPorPed: TPanel;
  edtPorPed, edtNomPorPed: TEditFocus);
begin
  If pnlPorPed.Visible Then
  Begin
    If fFormaPagtoPermiteDefinirPortadorPD(Self.strCodFpg) Then
    Begin
      If Not fEmptyStr(Self.strPorPed) Then
        edtPorPed.Text := Self.strPorPed
      Else
        edtPorPed.Text := Self.strCodPorDef;
    End
    Else
    Begin
      edtPorPed.Text := Self.strCodPorDef;
      edtPorPed.Enabled := False;
    End;

    edtNomPorPed.Text := fRetNomPortador(edtPorPed.Text);
  End;
end;

{**************************************************************}
{* ATENÇÃO! DEIXAR ESSA FUNÇÃO SEMPRE ALINHADA COM A FUNÇÃO:  *}
{* TfrmImportacaoSfaMobAndroid.fCalculaValorFlex              *}
{***********************************************************RN*}
function TFatVenda.fCalculaValorFlex(arrProduto: TDadosFechamento;
                                     Var strCreDeb: String): Double;
  Var
    fltUniTarPra,
    fltUniOriMax,
    fltValFlex   : Double;
    fltDesMaxCnd : Double;
    fltUniOriIte : Double;
    fltFlexVenda : Double;
    fltQtdOri    : Double;
    fltValEmbFec : Double;
    blnItemEmbalagemFechada: Boolean;
begin
  Result := 0.00;

  If Not fUsaFlex(arrProduto.strCodIte) Then
    Exit;

  If (Pos(strEspDoc, 'OR_PR_') > 0) Then
    Exit;

  If (Pos(strClaFis, CLAFIS_ENTFUT_VEN) > 0) Then
    Exit;

  If ((blnDevNota) Or (strOpcDoc = 'DV')) And
     (Not fEmptyStr(arrProduto.strTabDev)) And (Not fEmptyStr(arrProduto.strIncDev)) Then
  Begin
    fltQtdOri := fCampoTabela('DET_QTDITE', arrProduto.strTabDev,
                              ['AUTOINCREM'], [arrProduto.strIncDev]);

    fltFlexVenda := TMovFlex.fRetornaValorFlexDoDocumento(arrProduto.strTabDev,
                                                          arrProduto.strDocDev,
                                                          arrProduto.strEspDev,
                                                          arrProduto.strEmpDev,
                                                          strCodCli,
                                                          arrProduto.strCodIte,
                                                          arrProduto.strIncDev,
                                                          strCreDeb,
                                                          False);

    Result := fFormataFloat((fltFlexVenda / fltQtdOri) * arrProduto.fltQtdIte, VS_intDecUni);
  End
  Else
  Begin
    fltUniOriIte := arrProduto.fltUniOri;

    If (fCfgSis('CNDVEN') = 'I') And
       ((arrProduto.strPromoc <> 'S') Or
        (fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela)) And
       (Not fAplicarTaxaJurosPrecoDigitado) Then
    Begin
      fltDesMaxCnd := fRetornaDescLinGru(arrProduto.strCodIte, Self.strCodCnd);
      If (fFormataFloat(fltDesMaxCnd, 2) <> 0) Then
      Begin
        fltUniOriIte := fltUniOriIte - fRetornaVrDesconto(2, fltUniOriIte, fltDesMaxCnd);

        fltUniOriIte := fFormataFloat(fltUniOriIte, VS_intDecUni);
      End;
    End;

    //Desconto embalagem fechada
    fltValEmbFec := fGetUnitarioEmbalagemFechada(arrProduto.strCodIte,
                                                 arrProduto.strTabPre,
                                                 arrProduto.fltQtdIte,
                                                 fltUniOriIte);

    If (fltValEmbFec > 0) Then
      fltUniOriIte := fltValEmbFec;

    fltUniTarPra := (arrProduto.fltTotIte - arrProduto.fltDesEsp) / arrProduto.fltQtdIte;

    If fCfgSis('ITETBP', VarBoolean) Then
      fltUniOriMax :=  fltUniOriIte * (1 - fRetornaDesMaxTabPre(IIF(arrProduto.strEmpOrc.IsEmpty, VS_strCodEmp, arrProduto.strEmpOrc), arrProduto.strCodIte, arrProduto.strTabPre) / 100)
    else
      fltUniOriMax :=  fltUniOriIte * (1 - arrProduto.fltMaxPed / 100);

    fltUniTarPra := fFormataFloat(fltUniTarPra, VS_intDecUni);
    fltUniOriMax := fFormataFloat(fltUniOriMax, VS_intDecUni);

    fltValFlex   :=  arrProduto.fltQtdIte * (fltUniOriMax - fltUniTarPra);

    blnItemEmbalagemFechada := fEhEmbalagemFechadaItem(arrProduto.strCodIte, arrProduto.strTabPre, arrProduto.fltQtdIte);

    If ((fltValFlex <> 0) And ((arrProduto.strPromoc = 'N') Or ((arrProduto.strPromoc = 'S') And (fCfgSis('PROFLE', varBoolean)))) And ((Not blnItemEmbalagemFechada) Or ((blnItemEmbalagemFechada) And (fCfgSis('EMFFLE', varBoolean))))) Or
       (fBrindeBonificacao)                                 Then
    Begin
      If (fBrindeBonificacao) Then
      Begin
        strCreDeb := 'D';
        Result    := arrProduto.fltTotIte;
      End

      Else If (SameText(strTipOpe,'V')) Or (SameText(strTipOpe,'C')) Then
      Begin
        strCreDeb := IIF(fltValFlex < 0, 'C', 'D');
        Result    := IIF(fltValFlex < 0, fltValFlex * -1, fltValFlex);
      End;
    End;
  End;
End;

function TFatVenda.fGeraFlexOpe: Boolean;
begin
  Result := (fEmptyStr(strCodVe2)) Or
            ((strCodVen) = (strCodVe2));
end;

function TFatVenda.fBrindeBonificacao: Boolean;
Begin
  Result := (SameText(strTipOpe,'B') Or (Pos(RightStr(strClafis, 3), fCfgSis('CLABRI', VarString) + '910') > 0));
End;

function TFatVenda.fPermiteDescontoMaximoFlex(fltTotal, fltMinimo, fltSldFlex: Double; var fltPercen, fltDifere: Double): Boolean;
  Var
    fltPerFle : Double;
begin
  Result := False;

  fltPercen := 0;
  fltDifere := 0;
  fltPerFle := fCfgSis('PERFLE', varDouble);

  If (fltPerFle <= 0) Then
    Exit;

  If Not fGeraFlexOpe Then
    Exit;

  fltDifere := fltMinimo - fltTotal;

  If (fFormataFloat(fltDifere,2) > 0) Then
  Begin
    fltPercen := (fFormataFloat(fltDifere / fltMinimo, 2)) * 100;
    // O percentual a mais que foi efetuado é permitido pela configuração "cfg_perfle"
    Result := (fFormataFloat(fltPercen, 2) <= fFormataFloat(fltPerFle,  2));

    If (VS_strTRVEPR = '1') Then
      // (E) O vendedor não está negativo em seu saldo flex!
      Result := Result And (fFormataFloat(fltSldFlex, 2) > 0)
    Else
      // (E) O vendedor possui a diferença em seu saldo flex!
      Result := Result And (fFormataFloat(fltDifere, 2) <= fFormataFloat(fltSldFlex, 2));
  End;
end;

function TFatVenda.fAddCalcFlex(strAutInc, strCodIte: String; fltTotIte, fltDesEsp,
  fltQtdIte, fltUniOri, fltDesMax : Double): Integer;
  Var
    intCnt : Integer;
    blnAdicionou : Boolean;
begin
  Result := -1;
  blnAdicionou := False;

  For intCnt := Low(objMatrizCalcFlex.Items) To High(objMatrizCalcFlex.Items) Do
  Begin
    If (objMatrizCalcFlex.Items[intCnt].strAutInc = strAutInc) Then
    Begin
      objMatrizCalcFlex.Items[intCnt].strCodIte := strCodIte;
      objMatrizCalcFlex.Items[intCnt].fltTotIte := fltTotIte;
      objMatrizCalcFlex.Items[intCnt].fltDesEsp := fltDesEsp;
      objMatrizCalcFlex.Items[intCnt].fltQtdIte := fltQtdIte;
      objMatrizCalcFlex.Items[intCnt].fltUniOri := fltUniOri;
      objMatrizCalcFlex.Items[intCnt].fltDesMax := fltDesMax;
      Result := intCnt;
      blnAdicionou := True;
      Break;
    End;
  End;

  If (Not blnAdicionou) Then
  Begin
    SetLength(objMatrizCalcFlex.FItems, Length(objMatrizCalcFlex.Items) + 1);
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].strAutInc := strAutInc;
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].strCodIte := strCodIte;
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].fltTotIte := fltTotIte;
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].fltDesEsp := fltDesEsp;
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].fltQtdIte := fltQtdIte;
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].fltUniOri := fltUniOri;
    objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1].fltDesMax := fltDesMax;
    Result := Length(objMatrizCalcFlex.Items)-1;
  End;
end;

procedure TFatVenda.pDelCalcFlex(strAutInc: String);
  Var
    arrCopy : TMatrizCalcFlex;
    intCnt : Integer;
begin
  If Length(objMatrizCalcFlex.Items) = 0 Then
    Exit;

  arrCopy := objMatrizCalcFlex.Items;

  FillChar(objMatrizCalcFlex.FItems, SizeOf(objMatrizCalcFlex.Items), #0);

  For intCnt := Low(arrCopy) To High(arrCopy) Do
  Begin
    If (strAutInc <> arrCopy[intCnt].strAutInc) Then
    Begin
      SetLength(objMatrizCalcFlex.FItems, Length(objMatrizCalcFlex.Items) + 1);
      objMatrizCalcFlex.Items[Length(objMatrizCalcFlex.Items)-1] := arrCopy[intCnt];
    End;
  End;
end;

function TFatVenda.fGetValFleCalc(fltSldFle: Double): Double;
  Var
    intCnt : Integer;
    fltSaldoTemp : Double;
    fltUniTarPra : Double;
    fltUniOriMax : Double;
    fltValFleCal : Double;
    strDebiCredi : String;
    fltUniOriIte : Double;
    fltDesMaxCnd : Double;
begin
  fltSaldoTemp := fltSldFle;

  For intCnt := Low(objMatrizCalcFlex.Items) To High(objMatrizCalcFlex.Items) Do
  Begin
    fltUniTarPra := (objMatrizCalcFlex.Items[intCnt].fltTotIte - objMatrizCalcFlex.Items[intCnt].fltDesEsp) / objMatrizCalcFlex.Items[intCnt].fltQtdIte;

    fltUniOriIte := objMatrizCalcFlex.Items[intCnt].fltUniOri;

    If (Self.strCAbDes = 'S') And (fCfgSis('CNDVEN') = 'I') And (Not fAplicarTaxaJurosPrecoDigitado) Then
    Begin
      fltDesMaxCnd := fRetornaDescLinGru(objMatrizCalcFlex.Items[intCnt].strCodIte, Self.strCodCnd);
      If (fFormataFloat(fltDesMaxCnd, 2) <> 0) Then
      Begin
        If (Self.strCodFpg = '007') Then
        Begin
          If (Self.strAbDeCc = 'S') Then
            fltUniOriIte := fltUniOriIte - fRetornaVrDesconto(2, fltUniOriIte, fltDesMaxCnd);
        End
        Else
          fltUniOriIte := fltUniOriIte - fRetornaVrDesconto(2, fltUniOriIte, fltDesMaxCnd);

        fltUniOriIte := fFormataFloat(fltUniOriIte, VS_intDecUni);
      End;
    End;

    fltUniOriMax :=  fltUniOriIte * (1 - objMatrizCalcFlex.Items[intCnt].fltDesMax / 100);

    fltValFleCal := (objMatrizCalcFlex.Items[intCnt].fltQtdIte * (fltUniOriMax - fltUniTarPra));
    strDebiCredi := IIF(fltValFleCal < 0, 'C', 'D');

    If (strDebiCredi = 'C') Then
      fltSaldoTemp := fltSaldoTemp + fFormataFloat(Abs(fltValFleCal), 2)
    Else
      fltSaldoTemp := fltSaldoTemp - fFormataFloat(Abs(fltValFleCal), 2);
  End;

  Result := fltSaldoTemp;
end;

{****************************************************}
{* SOMENTE APLICADO NAS SEGUINTES CONFIGURAÇÕES:    *}
{* [CFG_TIPEXP] = 2     E [CFG_CXAEXP] = 2          *}
{* UTILIZADA NA RCXSELDOCUMENTOS                    *}
{REQ-48201****************************************LE*}
function fTemPermissaoFaturarSemExpedicao(cdsInfoDoc:TUniClientDataSet): Boolean;
  Var
    objLiberacao : TLiberacao;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha : TLinhaMsgLibera;
    cdsClone:TUniClientDataSet;
    blnDocSemExp:Boolean;
    blnListouDocumentos: Boolean;
Begin
  cdsClone := TUniClientDataSet.Create(Nil);
  objLiberacao := TLiberacao.Create;
  pCloneDataSet(cdsClone, cdsInfoDoc);

  try
    With cdsClone Do
    Begin
      objLiberacao.objMsgLibera.pAddTexto('RECEBIMENTO DE DOCUMENTO COM EXPEDIÇÃO PENDENTE');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddSeparador(105, teAutcom);
      objLiberacao.objMsgLibera.pAddTexto('RECEBIMENTO DE DOCUMENTO COM EXPEDIÇÃO PENDENTE',alCentro, teAmbos, '', 105);

      objTabela := TRegistroMsgLiberaTabela.Create;

      objLinha := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlCabecalho;
      objLinha.pAddColuna('', 'DOCUMENTO'    , 17 , alEsquerda , teAutcom);
      objLinha.pAddColuna('', 'EMP'          , 3  , alCentro   , teAutcom);
      objLinha.pAddColuna('', 'CLIENTE'      , 41 , alEsquerda , teAutcom);
      objLinha.pAddColuna('', 'DT.VENC.'     , 9  , alCentro   , teAutcom);
      objLinha.pAddColuna('', 'DT.CAD.'      , 9  , alCentro   , teAutcom);
      objLinha.pAddColuna('', 'VR.DUPLICATA' , 13 , alDireita  , teAutcom);
      objTabela.lstLinhas.Add(objLinha);

      Filtered     := False;
      Filter       := '';
      Filter       := 'CTR_MARDES = ''M''';
      Filtered     := True;
      blnDocSemExp := False;
      blnListouDocumentos := False;

      While Not Eof Do
      Begin
        If ((FieldByName('CTR_DTLBEX').IsNull) And
           (Pos(FieldByName('CTR_ESPDOC').AsString, ESPCTR_TRAVA) > 0)) And
           (FieldByName('CTR_ENTFUT').AsString = 'N') And
           (FieldByName('CTR_VALDUP').AsFloat >= 0) Then
        Begin
          If fVerificaCtrManual(FieldByName('CTR_NUMDUP').AsString,
                                FieldByName('CTR_ESPDOC').AsString,
                                FieldByName('CTR_CODEMP').AsString,
                                FieldByName('CTR_CODCLI').AsString) Then
          Begin
            {**********************************************}
            { SOMENTE LISTAR OS DOCUMENTOS QUE ESTEJAM EM  }
            { MOVGER OU NOTGER.                            }
            {**********************************************}

            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.pAddColuna('DOCUMENTO'    , FieldByName('CTR_NUMDUP').AsString +
                                                 FieldByName('CTR_PARCEL').AsString +
                                                 FieldByName('CTR_ESPDOC').AsString                              , 17 , alEsquerda );
            objLinha.pAddColuna('EMP'          , FieldByName('CTR_CODEMP').AsString                              , 3  , alCentro   );
            objLinha.pAddColuna('CLIENTE'      , FieldByName('CTR_NOMCLI').AsString                              , 41 , alEsquerda );
            objLinha.pAddColuna('DT.VENC.'     , FormatDateTime('dd/mm/yy',FieldByName('CTR_DTAVEN').AsDateTime) , 9  , alCentro   );
            objLinha.pAddColuna('DT.CAD.'      , FormatDateTime('dd/mm/yy',FieldByName('CTR_DTACAD').AsDateTime) , 9  , alCentro   );
            objLinha.pAddColuna('VR.DUPLICATA' , FloatToStrF(FieldByName('CTR_VALDUP').AsFloat, ffNumber, 9, 2)  , 13 , alDireita  );
            objTabela.lstLinhas.Add(objLinha);
            blnDocSemExp := True;

            if not blnListouDocumentos then
              blnListouDocumentos := True;
          End;
        End;

        Next;
      End;

      if blnListouDocumentos then
      Begin
        First;

        While Not Eof Do
        Begin
          {******************************************************}
          { CASO FOR UTILIZADO CRÉDITO, LISTAR INCLUSIVE O DOCTO }
          { DO CRÉDITO JUNTO COM OS DOCUMENTOS PAGOS             }
          {*REQ.102525***************************************CH**}

          If (Pos(FieldByName('CTR_ESPDOC').AsString, 'CC') > 0) Then
          Begin
            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;
            objLinha.pAddColuna('DOCUMENTO'    , FieldByName('CTR_NUMDUP').AsString +
                                                 FieldByName('CTR_PARCEL').AsString +
                                                 FieldByName('CTR_ESPDOC').AsString                              , 17 , alEsquerda );
            objLinha.pAddColuna('EMP'          , FieldByName('CTR_CODEMP').AsString                              , 3  , alCentro   );
            objLinha.pAddColuna('CLIENTE'      , fRetNomCliente(FieldByName('CTR_CODCLI').AsString)              , 41 , alEsquerda );
            objLinha.pAddColuna('DT.VENC.'     , FormatDateTime('dd/mm/yy',FieldByName('CTR_DTAVEN').AsDateTime) , 9  , alCentro   );
            objLinha.pAddColuna('DT.CAD.'      , FormatDateTime('dd/mm/yy',FieldByName('CTR_DTACAD').AsDateTime) , 9  , alCentro   );
            objLinha.pAddColuna('VR.DUPLICATA' , FloatToStrF(FieldByName('CTR_VALDUP').AsFloat, ffNumber, 9, 2)  , 13 , alDireita  );
            objTabela.lstLinhas.Add(objLinha);

            blnDocSemExp := True;
          End;

          Next;
        End;
      End;

      objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);
    End;

    If blnDocSemExp Then
    begin
      objLiberacao.strDirAce := 'FATSXP';
      objLiberacao.strMsgSen := 'Faturamento sem efetuar Expedição';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      Result := objLiberacao.fLibera;
    end
    Else
      Result := True;
  finally
    FreeAndNil(cdsClone);
    FreeAndNil(objLiberacao);
  end;
End;

function TFatVenda.fHouveAlteracaoRegraTributariaItensAposCalculaTotger: Boolean;
Var
  item: TDadosFechamento;
begin
  Result := False;
  For item In arrMatItens Do
    If TFunctionFuncoesFaturamento.ItemTributado(item.strCstAnt) <>
       TFunctionFuncoesFaturamento.ItemTributado(item.strCodFis) Then
    Begin
      Exit(True);
    End;
end;

function TFatVenda.fHouveAlteracaoPeso: Boolean;
Var
  intContador: Integer;
Begin

  Result := False;

  For intContador := 0 To Length(arrMatItens) - 1 Do
  Begin
    If (arrMatItens[intContador].blnEdiPes) Then
    Begin
      Result := True;
      Break;
    End;
  End;

End;

function TFatVenda.fEmpresaComPermissaoParaTipoDeMovimento(strEmpDes: String; tmvTipMov: TTipMov): Boolean;
Var
  strNomCam: String;
Begin
  Result := True;

  If (fEmptyStr(strEmpDes))                         Or
     (Not fPermiteInformarEmpresaNoItem(strOpcDoc)) Then
    Exit;

  Try
    If (tmvTipMov = tmvRetira) Then
      strNomCam := 'VEN_PERRET'
    Else If (tmvTipMov = tmvEntregaImediata) Then
      strNomCam := 'VEN_PERENT'
    Else
      strNomCam := 'VEN_PERFUT';

    Result := (fCampoTabela(strNomCam, 'VENEMP', ['VEN_EMPORI', 'VEN_EMPDES'], [VS_strCodEmp, strEmpDes]) <> 'N');

  Except
    On E: Exception Do
    Begin
      pMensagensErro(e.Message, '[TFatVenda.fEmpresaComPermissaoParaTipoDeMovimento]');
    End;
  End;

End;

function TFatVenda.fRetornaTipoMovimento(intIdxEnt, intIdxTip: Integer): TTipMov;
Begin
  Result := tmvRetira;

  If (intIdxEnt = IDX_ENTREGA) Then
  Begin
    If (intIdxTip = IDX_ENTREGA_IMEDIATA) Then
      Result := tmvEntregaImediata
    Else
      Result := tmvEntregaFutura;
  End;
End;

