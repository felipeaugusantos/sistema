function TFatVenda.fPermiteEmitirDuasNFCesMultLoja(const strEspDoc : String): Boolean;
begin
  Result := False;

  If (Not Self.blnMulLoj) Then
    Exit;

  If (fEmptyStr(Self.strEmpLog)) Then
    Exit;

  If (VS_strCodEmp = Self.strEmpLog) Then
    Exit;

  If (strEspDoc <> 'IF') Then
    Exit;

  If fCampoEmpresasNoServidorPreenchido(Self.strEmpLog, VS_strCodEmp) Then
  Begin
    If (Not fEmpresasNoMesmoServidor(Self.strEmpLog, VS_strCodEmp)) Then
      Exit;
  End;

  If (fCfgSis('NFCMLT', varString, Self.strEmpLog) = '1') Then
    Exit;

  If (fCfgSis('USNFCE', varString, Self.strEmpLog) = 'N')  Then
    Exit;

  If (fCfgSis('USNFCE', varString, VS_strCodEmp) = 'N')  Then
    Exit;

  Result := True;
end;

