procedure pBaixarFormulacaoPedidosNaoSeraoEntregues(
  strNumPed, strEspPed, strEmpPed: String);

  //Verifica se existe tinta de maquina no pedido
  function fPedidoComTintadeMaquina: Boolean;

    function fGetSQL: String;
    begin
      Result := '';
      Result := Result + 'SELECT TRUE   ';
      Result := Result + '  FROM TINDOR ';
      Result := Result + ' WHERE FDO_NUMDOC = :NUMDOC ';
      Result := Result + '   AND FDO_ESPDOC = :ESPDOC ';
      Result := Result + '   AND FDO_CODEMP = :CODEMP ';
      Result := Result + ' LIMIT 1 ';
    end;

  var
    qrySel: TUniQuery;
  begin

    Try
      qrySel := fCriaQuery;

      With qrySel Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL);
        ParamByName('NUMDOC').AsString := strNumPed;
        ParamByName('ESPDOC').AsString := strEspPed;
        ParamByName('CODEMP').AsString := strEmpPed;
        Open;

        Result := Not IsEmpty;
      End;
    Finally
      FreeAndNil(qrySel);
    End;
  end;

  //Baixa a tinta de maquina do pedido
  procedure pBaixaFormulacaoPedido;

    function fGetSQL: String;
    begin
      Result := '';
      Result := Result + 'UPDATE TINDOR               ';
      Result := Result + '   SET FDO_BAIXAD = TRUE    ';
      Result := Result + '     , FDO_OPEBAI = :OPEBAI ';
      Result := Result + '     , FDO_HORBAI = ' + fCurrentTime;
      Result := Result + '     , FDO_DTABAI = ' + fCurrentDate;
      Result := Result + ' WHERE FDO_NUMDOC = :NUMDOC ';
      Result := Result + '   AND FDO_ESPDOC = :ESPDOC ';
      Result := Result + '   AND FDO_CODEMP = :CODEMP ';
    end;

  var
    qryUpd: TUniQuery;
  begin
    Try
      qryUpd := fCriaQuery;

      With qryUpd Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(fGetSQL);
        ParamByName('OPEBAI').AsString := strLoginUsuarioLogado;
        ParamByName('NUMDOC').AsString := strNumPed;
        ParamByName('ESPDOC').AsString := strEspPed;
        ParamByName('CODEMP').AsString := strEmpPed;
        ExecSQL;
      End;
    Finally
      FreeAndNil(qryUpd);
    End;
  end;

begin
  If fPedidoComTintadeMaquina Then
    pBaixaFormulacaoPedido;
end;

procedure pExcluiPENREC(strNumDoc, strCodEmp, strEspDoc, strCodCli: String);
var
  qryPENREC: TUniQuery;
  qryITEREC: TUniQuery;

  procedure pTrocaSQL(Var qryTroca: TUniQuery; Const strSQL:String);
  begin
    qryTroca.Close;
    qryTroca.SQL.Clear;
    qryTroca.SQL.Add(strSQL);
  end;

  procedure pPreencheParametrosPENREC();
  begin
    qryPENREC.ParamByName('NUMDOC').AsString := strNumDoc;
    qryPENREC.ParamByName('ESPDOC').AsString := strEspDoc;
    qryPENREC.ParamByName('CODEMP').AsString := strCodEmp;
    qryPENREC.ParamByName('CODCLI').AsString := strCodCli;
  end;

  function fRetSQLPENREC():String;
  begin
    Result := '';
    Result := Result + '  SELECT * FROM              ';
    Result := Result + '    PENREC                   ';
    Result := Result + '  WHERE                      ';
    Result := Result + '        PEN_NUMDOC =:NUMDOC  ';
    Result := Result + '    AND PEN_ESPDOC =:ESPDOC  ';
    Result := Result + '    AND PEN_CODEMP =:CODEMP  ';
    Result := Result + '    AND PEN_CODCLI =:CODCLI  ';
  end;

  function fRetSQLDelPENREC():String;
  begin
    Result := '';
    Result := Result + '  DELETE FROM                ';
    Result := Result + '    PENREC                   ';
    Result := Result + '  WHERE                      ';
    Result := Result + '        PEN_NUMDOC =:NUMDOC  ';
    Result := Result + '    AND PEN_ESPDOC =:ESPDOC  ';
    Result := Result + '    AND PEN_CODEMP =:CODEMP  ';
    Result := Result + '    AND PEN_CODCLI =:CODCLI  ';
  end;

  function fRetSQLITEREC():String;
  begin
    Result := '';
    Result := Result + '  SELECT * FROM          ';
    Result := Result + '    ITEREC               ';
    Result := Result + '  WHERE                  ';
    Result := Result + '    IRC_SEQGER =:AUTINC  ';
  end;

  function fRetSQLDelITEREC():String;
  begin
    Result := '';
    Result := Result + '  DELETE FROM            ';
    Result := Result + '    ITEREC               ';
    Result := Result + '  WHERE                  ';
    Result := Result + '    IRC_SEQGER =:AUTINC  ';
  end;
begin
  qryPENREC := fCriaQuery;
  qryITEREC := fCriaQuery;

  Try
    pTrocaSQL(qryPENREC, fRetSQLPENREC);
    pPreencheParametrosPENREC();
    qryPENREC.Open;

    If (Not qryPENREC.IsEmpty) Then
    Begin
      qryPENREC.First;
      While (Not qryPENREC.Eof) Do
      Begin
        pTrocaSQL(qryITEREC, fRetSQLITEREC);
        qryITEREC.ParamByName('AUTINC').AsString := qryPENREC.FieldByName('AUTOINCREM').AsString;
        qryITEREC.Open;

        If (Not qryITEREC.IsEmpty) Then
        Begin
          qryITEREC.First;
          While (Not qryITEREC.Eof) Do
          Begin
            fVerificaIntegridade('', 'ITEREC', qryITEREC);
            qryITEREC.Next;
          End;

          pTrocaSQL(qryITEREC, fRetSQLDelITEREC);
          qryITEREC.ParamByName('AUTINC').AsString := qryPENREC.FieldByName('AUTOINCREM').AsString;
          qryITEREC.ExecSQL;
        End;

        fVerificaIntegridade('', 'PENREC', qryPENREC);

        qryPENREC.Next;
      End;


      pTrocaSQL(qryPENREC, fRetSQLDelPENREC);
      pPreencheParametrosPENREC();

      qryPENREC.ExecSQL();
    End;
  Finally
    FreeAndNil(qryPENREC);
    FreeAndNil(qryITEREC);
  End;
end;

procedure pExcluiRequisicaoCompra(strCodigo, strCodEmp, strNomFrm: String);
  Var
    qryGen: TUniQuery;
    qryDados: TUniQuery;
    blnContinue: Boolean;
    stlLckAtc: TStringList;
    intLck: Integer;
Begin
  qryGen := fCriaQuery;
  qryDados := fCriaQuery;
  stlLckAtc := TStringList.Create();
  blnContinue := True;

  Try
    qryDados.Close();
    qryDados.SQL.Clear();
    qryDados.SQL.Add('SELECT * FROM MOVRCD ');
    qryDados.SQL.Add('WHERE RCD_CODIGO = :CODIGO AND RCD_CODEMP = :CODEMP');
    qryDados.ParamByName('CODIGO').AsString := strCodigo;
    qryDados.ParamByName('CODEMP').AsString := strCodEmp;
    qryDados.Open();

    While Not qryDados.Eof Do
    Begin
      If (fGetConnectionID() <> fGetIdConnectionLock('REQUISICAO_' + qryDados.FieldByName('AUTOINCREM').AsString)) Then
      Begin
        If (fLock_Unlock('REQUISICAO_' + qryDados.FieldByName('AUTOINCREM').AsString, True, False)) Then
          stlLckAtc.Add('REQUISICAO_' + qryDados.FieldByName('AUTOINCREM').AsString)
        Else
        Begin
          fMensagem('ATENÇÃO!', 'Há item(ns) dessa requisição sendo utilizado(s) por outra estação: ' +
                    fGetHostLock('REQUISICAO_' + qryDados.FieldByName('AUTOINCREM').AsString), ['&Ok']);
          blnContinue := False;
          Break;
        End;
      End;

      fVerificaIntegridade(strNomFrm, 'MOVRCD', qryDados);
      qryDados.Next;
    End;

    If (Not blnContinue) Then
      Exit;

    qryDados.Close();
    qryDados.SQL.Clear();
    qryDados.SQL.Add('SELECT * FROM MOVRCG ');
    qryDados.SQL.Add('WHERE RCG_CODIGO = :CODIGO AND RCG_CODEMP = :CODEMP');
    qryDados.ParamByName('CODIGO').AsString := strCodigo;
    qryDados.ParamByName('CODEMP').AsString := strCodEmp;
    qryDados.Open();

    fVerificaIntegridade(strNomFrm, 'MOVRCG', qryDados);

    With qryGen, SQL Do
    Begin

      Clear;
      Add('DELETE FROM PREPRQ');
      Add('WHERE PRQ_CODREQ = :CODIGO AND PRQ_EMPREQ = :CODEMP');

      ParamByName('CODIGO').AsString := strCodigo;
      ParamByName('CODEMP').AsString := strCodEmp;

      ExecSQL;

      Clear;
      Add('DELETE FROM REQVEN');
      Add('WHERE SEQ_MOVRCD IN (SELECT AUTOINCREM FROM MOVRCD WHERE RCD_CODIGO = :CODIGO AND RCD_CODEMP = :CODEMP)');

      ParamByName('CODIGO').AsString := strCodigo;
      ParamByName('CODEMP').AsString := strCodEmp;

      ExecSQL;

      Clear;
      Add('DELETE FROM MOVRCG');
      Add('WHERE RCG_CODIGO = :CODIGO AND RCG_CODEMP = :CODEMP');

      ParamByName('CODIGO').AsString := strCodigo;
      ParamByName('CODEMP').AsString := strCodEmp;

      ExecSQL;
    End;
  Finally
    For intLck := 0 To Pred(stlLckAtc.Count) Do
      fLock_Unlock(stlLckAtc[intLck], False, False);

    FreeAndNIl(qryDados);
    FreeAndNil(qryGen);
    stlLckAtc.Free();
  End;
end;

function fGetItensRemovidos(const strNumDoc, strEspDoc, strCodEmp: String;
  arrMatItens: TMatrizFechamento; tirOpc: TItemRemovido = tirTodos): String;
  Var
    LQry: TUniQuery;
    LAchou: Boolean;
    LItem: TDadosFechamento;
    LResult: TStringList;
begin
  LQry := fCriaQuery(nil);
  LResult := TStringList.Create();

  Try
    LQry.SQL.Add('SELECT SQL_NO_CACHE');
    LQry.SQL.Add('  F.AUTOINCREM AS SEQDET,');

    Case tirOpc Of
      tirTodos:
        LQry.SQL.Add('F.FDO_CODITE AS SEQUEN');
      tirRequisicao:
        LQry.SQL.Add('Q.AUTOINCREM AS SEQUEN');
      tirTransferencia:
        LQry.SQL.Add('T.AUTOINCREM AS SEQUEN');
    End;

    LQry.SQL.Add('FROM FATDOR F');

    If (tirOpc in [tirRequisicao, tirTransferencia]) Then
      LQry.SQL.Add('JOIN FDOABS A ON A.ABS_SEQFDO = F.AUTOINCREM');

    Case tirOpc Of
      tirRequisicao:
        LQry.SQL.Add('JOIN PREPRQ Q ON Q.AUTOINCREM = A.ABS_SEQPRQ');
      tirTransferencia:
        LQry.SQL.Add('JOIN PREPTE T ON T.AUTOINCREM = A.ABS_SEQPTE');
    End;

    LQry.SQL.Add('WHERE FDO_NUMDOC = :NUMDOC');
    LQry.SQL.Add('  AND FDO_ESPDOC = :ESPDOC');
    LQry.SQL.Add('  AND FDO_CODEMP = :CODEMP');

    LQry.ParamByName('NUMDOC').AsString := strNumDoc;
    LQry.ParamByName('ESPDOC').AsString := strEspDoc;
    LQry.ParamByName('CODEMP').AsString := strCodEmp;

    LQry.Open;

    While Not LQry.Eof Do
    Begin
      LAchou := False;
      For LItem In arrMatItens Do
        If LItem.strSeqDet = LQry.FieldByName('SEQDET').AsString Then
        Begin
          LAchou := True;
          Break;
        End;

      If (Not LAchou) And (Not (LResult.IndexOf(LQry.FieldByName('SEQUEN').AsString) > -1)) Then
        LResult.Add(LQry.FieldByName('SEQUEN').AsString);

      LQry.Next;
    End;
  Finally
    Result := LResult.CommaText;
    LResult.Free();
    FreeAndNil(LQry);
  End;
end;

procedure pRemoveVinculoTransferencias(const AAutoIncs: String; strNomFrm: String = '');
var
  LPrepTE: TUniQuery;
  LQry: TUniQuery;
  LQryCheck: TUniQuery;
begin
  LQry := fCriaQuery();
  LPrepTE := fCriaQuery();
  LQryCheck := fCriaQuery();

  Try
    LPrepTE.SQL.Add('SELECT                                              ');
    LPrepTE.SQL.Add('  T.AUTOINCREM AS SEQPTE,                           ');
    LPrepTE.SQL.Add('  F.AUTOINCREM AS SEQFGO                            ');
    LPrepTE.SQL.Add('FROM PREPTE T                                       ');
    LPrepTE.SQL.Add('LEFT JOIN FATGOR F ON F.FGO_NUMDOC = T.PRE_NUMDOC   ');
    LPrepTE.SQL.Add('                  AND F.FGO_ESPDOC = T.PRE_ESPDOC   ');
    LPrepTE.SQL.Add('                  AND F.FGO_CODEMP = T.PRE_EMPDOC   ');
    LPrepTE.SQL.Add('WHERE T.AUTOINCREM IN (' + AAutoIncs + ')           ');

    LPrepTE.Open();

    While (Not LPrepTE.Eof) Do
    Begin
      LQryCheck.Close();
      LQryCheck.SQL.Clear();
      LQryCheck.SQL.Add('SELECT * FROM PREPTE WHERE AUTOINCREM = ' + LPrepTE.FieldByName('SEQPTE').AsString.QuotedString);
      LQryCheck.Open();

      fVerificaIntegridade(strNomFrm, 'PREPTE', LQryCheck);
      LQry.SQL.Add('DELETE FROM PREPTE WHERE AUTOINCREM = ' + LPrepTE.FieldByName('SEQPTE').AsString.QuotedString + ';');

      If (Not (LPrepTE.FieldByName('SEQFGO').IsNull)) Then
      Begin
        LQry.SQL.Add('UPDATE EXTGOR SET FGO_NMPDAB = NULL, FGO_ESPDAB = NULL,');
        LQry.SQL.Add('  FGO_EMPDAB = NULL WHERE FGO_SEQFGO = ' + LPrepTE.FieldByName('SEQFGO').AsString.QuotedString + ';');
      End;

      LPrepTE.Next();
    End;

    If (LQry.SQL.Count > 0) Then
      LQry.ExecSQL();
  Finally
    FreeAndNil(LQry);
    FreeAndNil(LPrepTE);
    FreeAndNil(LQryCheck);
  End;
end;

procedure pRemoveRequisicoes(const AAutoIncs: String; ARemoverSomentePreparacaoRQ: Boolean = False; strNomFrm: String = '');
var
  LPrepRQ: TUniQuery;
  LQry: TUniQuery;
  LQryCheck: TUniQuery;
  stlLckRcd: TStringList;
  idxLck: Integer;
begin
  LQry := fCriaQuery();
  LPrepRQ := fCriaQuery();
  LQryCheck := fCriaQuery();
  stlLckRcd := TStringList.Create();

  Try
    LPrepRQ.SQL.Add('SELECT                                              ');
    LPrepRQ.SQL.Add('  Q.AUTOINCREM AS SEQPRQ,                           ');
    LPrepRQ.SQL.Add('  D.AUTOINCREM AS SEQRCD,                           ');
    LPrepRQ.SQL.Add('  G.AUTOINCREM AS SEQRCG,                           ');
    LPrepRQ.SQL.Add('  CONCAT(C.ITE_CODITE, " - ", C.ITE_DESITE) AS ITEM,');
    LPrepRQ.SQL.Add('  (SELECT COUNT(0) FROM MOVRCD                      ');
    LPrepRQ.SQL.Add('    WHERE RCD_CODIGO = G.RCG_CODIGO                 ');
    LPrepRQ.SQL.Add('      AND RCD_CODEMP = G.RCG_CODEMP) AS QTDITENS    ');
    LPrepRQ.SQL.Add('FROM PREPRQ Q                                       ');
    LPrepRQ.SQL.Add('JOIN CADITE C ON C.ITE_CODITE = Q.PRQ_CODITE        ');
    LPrepRQ.SQL.Add('LEFT JOIN MOVRCD D ON D.AUTOINCREM = Q.PRQ_SEQRCD   ');
    LPrepRQ.SQL.Add('LEFT JOIN MOVRCG G ON G.RCG_CODIGO = D.RCD_CODIGO   ');
    LPrepRQ.SQL.Add('                  AND G.RCG_CODEMP = D.RCD_CODEMP   ');
    LPrepRQ.SQL.Add('WHERE Q.AUTOINCREM IN (' + AAutoIncs + ')           ');

    LPrepRQ.Open();

    While (Not LPrepRQ.Eof) Do
    Begin
      LQryCheck.Close();
      LQryCheck.SQL.Clear();
      LQryCheck.SQL.Add('SELECT * FROM PREPRQ WHERE AUTOINCREM = ' + LPrepRQ.FieldByName('SEQPRQ').AsString.QuotedString);
      LQryCheck.Open();

      fVerificaIntegridade(strNomFrm, 'PREPRQ', LQryCheck);

      If (LPrepRQ.FieldByName('SEQRCD').IsNull) Or ARemoverSomentePreparacaoRQ Then
        LQry.SQL.Add('DELETE FROM PREPRQ WHERE AUTOINCREM = ' + LPrepRQ.FieldByName('SEQPRQ').AsString.QuotedString + ';')
      Else
      Begin
        If (fGetConnectionID() <> fGetIdConnectionLock('REQUISICAO_' + LPrepRQ.FieldByName('SEQRCD').AsString)) Then
        Begin
          If (fLock_Unlock('REQUISICAO_' + LPrepRQ.FieldByName('SEQRCD').AsString, True, False)) Then
            stlLckRcd.Add('REQUISICAO_' + LPrepRQ.FieldByName('SEQRCD').AsString)
          Else
          Begin
            raise ExceptionAutCom.Create('A requisição referente ao item ' + LPrepRQ.FieldByName('ITEM').AsString +
                                         ' está sendo utilizada por outra estação: ' +
                                         fGetHostLock('REQUISICAO_' + LPrepRQ.FieldByName('SEQRCD').AsString));
          End;
        End;

        LQryCheck.Close();
        LQryCheck.SQL.Clear();
        LQryCheck.SQL.Add('SELECT * FROM MOVRCD WHERE AUTOINCREM = ' + LPrepRQ.FieldByName('SEQRCD').AsString.QuotedString);
        LQryCheck.Open();

        fVerificaIntegridade(strNomFrm, 'MOVRCD', LQryCheck);

        If (LPrepRQ.FieldByName('QTDITENS').AsInteger > 1) Then
          LQry.SQL.Add('DELETE FROM MOVRCD WHERE AUTOINCREM = ' + LPrepRQ.FieldByName('SEQRCD').AsString.QuotedString + ';')
        Else
        Begin
          LQryCheck.Close();
          LQryCheck.SQL.Clear();
          LQryCheck.SQL.Add('SELECT * FROM MOVRCG WHERE AUTOINCREM = ' + LPrepRQ.FieldByName('SEQRCG').AsString.QuotedString);
          LQryCheck.Open();

          fVerificaIntegridade(strNomFrm, 'MOVRCG', LQryCheck);

          LQry.SQL.Add('DELETE FROM MOVRCG WHERE AUTOINCREM = ' + LPrepRQ.FieldByName('SEQRCG').AsString.QuotedString + ';');
        End;
      End;

      LPrepRQ.Next();
    End;

    If (LQry.SQL.Count > 0) Then
      LQry.ExecSQL();
  Finally
    FreeAndNil(LQry);
    FreeAndNil(LPrepRQ);
    FreeAndNil(LQryCheck);

    For idxLck := 0 To Pred(stlLckRcd.Count) Do
      fLock_Unlock('REQUISICAO_' + stlLckRcd[idxLck], False, False);

    stlLckRcd.Free();
  End;
end;

function RetornaProspectoDocumento(const ANumDoc, AEspDoc, ACodEmp, ACodCli: String): String;
var
 LQry: TUniQuery;
Begin
  Result := EmptyStr;

  LQry := fCriaQuery();
  Try
    LQry.Close();
    LQry.SQL.Clear();
    LQry.SQL.Add('SELECT FGO_PROSPE FROM FATGOR ' +
                 ' INNER JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM ' +
                 ' WHERE FGO_CODEMP = :FGO_CODEMP ' +
                 '   AND FGO_ESPDOC = :FGO_ESPDOC ' +
                 '   AND FGO_NUMDOC = :FGO_NUMDOC ' +
                 '   AND FGO_CODCLI = :FGO_CODCLI '
                 );
    LQry.ParamByName('FGO_CODEMP').AsString := ACodEmp;
    LQry.ParamByName('FGO_ESPDOC').AsString := AEspDoc;
    LQry.ParamByName('FGO_NUMDOC').AsString := ANumDoc;
    LQry.ParamByName('FGO_CODCLI').AsString := ACodCli;

    LQry.Open();
    If Not LQry.IsEmpty Then
      Result := LQry.FieldByName('FGO_PROSPE').AsString;
  Finally
    FreeAndNil(LQry);
  End;
End;

procedure pBaixaPedido(strNumDoc, strEspDoc, strCodEmp, strCodOco: String; strHisBai : String = '';
                       strNumFat: String = ''; strTipFat: String = ''; strEmpFat: String = '';
                       blnBaixaPedNaoEntregue: Boolean = False; blnAtualizaNumFatItens: Boolean = False; strMotBai: String = '';
                       strCodComplementoOcorrencia : String = '');
  Var
    qryUpdate: TUniQuery;
    strMotAju: String;
    objAtuOcoCrm: TAtuOcoCrm;
    objMovFlex : TMovFlex;
    objPromocaoLimitePorClienteOuVenda : TPromocaoLimitePorClienteOuVenda;
    strCodCli,
    strProspe: string;

    function fAjustaMotivoBaixa: String;
    Begin
      Result := '';
      Result := Result + 'DADOS BAIXA: ' + FormatDateTime('DD/MM/YYYY', VS_Date) + ' - ' +
                                           FormatDateTime('HH:MM:SS', fRetHoraServidor)      + ' '   +
                                           'OPE: ' + strLoginUsuarioLogado       + ' - ' +
                                           fRetNomeOperador(strLoginUsuarioLogado);

      If Not fEmptyStr(strMotBai) Then
        Result := Result + ' - ' + strMotBai;
    End;

    procedure pAtualizaInformacoesItens;
    Var
      qryAux: TUniQuery;
      LEmpresa: String;
      LEmpresas: TArray<String>;
      LSubItem: String;
      LSubItens: TArray<String>;
      LobjReprocessarSaldoItens: IReprocessarSaldoItem;
    Begin
      LobjReprocessarSaldoItens := TReprocessarSaldoItem.New();
      qryAux := fCriaQuery(Nil);
      Try
        qryAux.SQL.Clear;
        qryAux.SQL.Add('SELECT FATDOR.AUTOINCREM AS SEQFDO, FATDOR.FDO_NUMLOT, FATDOR.FDO_EMPITE,  ');
        qryAux.SQL.Add('       FATDOR.FDO_CODITE, FATDOR.FDO_CODCLI, FATDOR.FDO_CODEMP, FATDOR.FDO_PROMOC, ');
        qryAux.SQL.Add('       FATDOR.FDO_QTDITE, EXTDOR.FDO_CODPRO ');
        qryAux.SQL.Add('  FROM FATDOR ');
        qryAux.SQL.Add('  JOIN EXTDOR ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ');
        qryAux.SQL.Add(' WHERE FATDOR.FDO_NUMDOC = :NUMDOC ');
        qryAux.SQL.Add('   AND FATDOR.FDO_ESPDOC = :ESPDOC ');
        qryAux.SQL.Add('   AND FATDOR.FDO_CODEMP = :CODEMP ');
        qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
        qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
        qryAux.ParamByName('CODEMP').AsString := strCodEmp;

        qryAux.Open;

        While Not qryAux.Eof Do
        Begin

          If (qryAux.FieldByName('FDO_PROMOC').AsString = 'S') And ((strEspDoc <> 'OR') Or(fCfgSis('DOCPRO', varString) = '1')) Then
          Begin
            TUpdatePromo.New(
              TParametrosPromocao.New()
                .CodIte(qryAux.FieldByName('FDO_CODITE').AsString)
                .CodEmp(qryAux.FieldByName('FDO_CODEMP').AsString)
                .CodCli(qryAux.FieldByName('FDO_CODCLI').AsString)
                .LevantarExcecao(True)
              ).fAtualizaQtdDisponivel();
          End;

          TUpdateReservaItem.New(
            qryAux.FieldByName('SEQFDO').AsString,
            True
          ).pExecute();

          {***************************************}
          {* MARCA ITEM PARA REPROCESSO DE SALDO *}
          {***************************************}
          LEmpresas := untFuncoesSimples.fGetEmpresasReprocessarItemPedido(qryAux.FieldByName('SEQFDO').AsString);

          For LEmpresa In LEmpresas Do
          Begin
            LobjReprocessarSaldoItens.AddItem(TItemReprocessarSaldo.New.
                                                 Codigo(qryAux.FieldByName('FDO_CODITE').AsString).
                                                 Empresa(LEmpresa).
                                                 EhItemEntregaFutura(True));

            If (fCfgSis('BXSBIT') = '2') And (fCfgSis('EMOPPD') = 'N') Then
            Begin
              LSubItens := fGetSubItensEstrutura(qryAux.FieldByName('FDO_CODITE').AsString);
              For LSubItem In LSubItens Do
                 LobjReprocessarSaldoItens.AddItem(TItemReprocessarSaldo.New.
                                                      Codigo(LSubItem).
                                                      Empresa(LEmpresa).
                                                      EhItemEntregaFutura(True));
            End;
          End;

          qryAux.Next;
        End;
      Finally
        LobjReprocessarSaldoItens.NotificarRoboParaReprocessarSaldos;
        FreeAndNil(qryAux);
      End;
    End;

    function fAtualizarLotDor: Boolean;
    begin
      Result := False;

      if (not blnBaixaPedNaoEntregue) then
        Exit;

      if (not fUsaOndaSeparacaoAgrupamento) then
        Exit;

      Result := True;
    end;

    procedure pRetornaCashbackUtilizadoVenda;
    var
      objControle : TControleCashback;
    begin
      objControle := TControleCashback.Create;
      Try
        objControle.pLimparObjeto;
        objControle.strNumDoc := strNumDoc;
        objControle.strEspDoc := strEspDoc;
        objControle.strCodEmp := strCodEmp;

        objControle.fRemoveUtilizacaoCashbackVenda;
      Finally
        FreeAndNil(objControle);
      End;
    end;

begin

  strCodCli := fCampoTabela('FGO_CODCLI', 'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'],
                            [strNumDoc, strEspDoc, strCodEmp]);

  strProspe := RetornaProspectoDocumento(strNumDoc, strEspDoc, strCodEmp, strCodCli);

  strMotAju := fAjustaMotivoBaixa;

  If fCfgSis('USAFLE',varBoolean) Then
  Begin
    objMovFlex := TMovFlex.Create(Nil);
    Try
      objMovFlex.pExcluir(strNumDoc,
                          strEspDoc,
                          strCodEmp,
                          EmptyStr, // strCodCli
                          EmptyStr, // strCodIte
                          EmptyStr  // strAutInc
                          );
    Finally
      FreeAndNil(objMovFlex);
    End;
  End;

  pDesvincularPedidoDeBrindeDoDocumentoDeVenda(strNumDoc, strEspDoc, strCodEmp);

  qryUpdate := fCriaQuery(Nil);
  qryUpdate.SQL.Add('UPDATE                     ');
  qryUpdate.SQL.Add('  FATGOR                   ');
  qryUpdate.SQL.Add('SET                        ');
  qryUpdate.SQL.Add('  FGO_JAFATU = 1,          ');
  qryUpdate.SQL.Add('  FGO_MOTBAI = :MOTBAI     ');

  If Not fEmptyStr(strNumFat) Then
  Begin
    qryUpdate.SQL.Add('  ,FGO_NUMFAT = :NUMFAT  ');
    qryUpdate.SQL.Add('  ,FGO_TIPFAT = :TIPFAT  ');
    qryUpdate.SQL.Add('  ,FGO_EMPFAT = :EMPFAT  ');
  End;

  qryUpdate.SQL.Add('WHERE                      ');
  qryUpdate.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
  qryUpdate.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
  qryUpdate.SQL.Add('  FGO_CODEMP = :CODEMP     ');
  qryUpdate.ParamByName('MOTBAI').AsString := strMotAju;
  qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
  qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
  qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;

  If Not fEmptyStr(strNumFat) Then
  Begin
    qryUpdate.ParamByName('NUMFAT').AsString := strNumFat;
    qryUpdate.ParamByName('TIPFAT').AsString := strTipFat;
    qryUpdate.ParamByName('EMPFAT').AsString := strEmpFat;
  End;

  qryUpdate.ExecSQL;

  If Not fEmptyStr(strCodOco) Then
  Begin
    qryUpdate.SQL.Clear;
    qryUpdate.SQL.Add('UPDATE                     ');
    qryUpdate.SQL.Add('  EXTGOR                   ');
    qryUpdate.SQL.Add('    INNER JOIN FATGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ');
    qryUpdate.SQL.Add('SET                        ');
    qryUpdate.SQL.Add('  FGO_CODOCO = :CODOCO     ');
    qryUpdate.SQL.Add(' ,FGO_UTIPEN = :UTIPEN     ');
    qryUpdate.SQL.Add(' ,FGO_NMPDAB = NULL        ');
    qryUpdate.SQL.Add(' ,FGO_ESPDAB = NULL        ');
    qryUpdate.SQL.Add(' ,FGO_EMPDAB = NULL        ');

    If (strHisBai <> '') Then
      qryUpdate.SQL.Add('  , FGO_HISBAI = :HISBAI ');

    qryUpdate.SQL.Add('WHERE                      ');
    qryUpdate.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
    qryUpdate.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
    qryUpdate.SQL.Add('  FGO_CODEMP = :CODEMP     ');
    qryUpdate.ParamByName('CODOCO').AsString := strCodOco;
    qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
    qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
    qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;

    if (fCfgSis('UTIPEN', VarBoolean) And (Pos(fCfgSis('TIPEXP'), '3_4_') > 0) And (strCodOco = fCfgSis('OCCOPD', varString))) Then
      qryUpdate.ParamByName('UTIPEN').AsString := 'S'
    else
      qryUpdate.ParamByName('UTIPEN').AsString := 'N';

    If (strHisBai <> '') Then
      qryUpdate.ParamByName('HISBAI').AsString := strHisBai;

    qryUpdate.ExecSQL;
  End;

  qryUpdate.SQL.Clear;
  qryUpdate.SQL.Add('UPDATE                     ');
  qryUpdate.SQL.Add('  FATDOR                   ');
  qryUpdate.SQL.Add('SET                        ');
  qryUpdate.SQL.Add('  FDO_JAFATU = 1           ');

  If blnAtualizaNumFatItens And (Not fEmptyStr(strNumFat)) Then
  Begin
    qryUpdate.SQL.Add('  ,FDO_NUMFAT = :NUMFAT  ');
    qryUpdate.SQL.Add('  ,FDO_TIPFAT = :TIPFAT  ');
    qryUpdate.SQL.Add('  ,FDO_EMPFAT = :EMPFAT  ');
  End;

  qryUpdate.SQL.Add('WHERE                      ');
  qryUpdate.SQL.Add('  FDO_NUMDOC = :NUMDOC AND ');
  qryUpdate.SQL.Add('  FDO_ESPDOC = :ESPDOC AND ');
  qryUpdate.SQL.Add('  FDO_CODEMP = :CODEMP     ');
  qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
  qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
  qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;

  If blnAtualizaNumFatItens And (Not fEmptyStr(strNumFat)) Then
  Begin
    qryUpdate.ParamByName('NUMFAT').AsString := strNumFat;
    qryUpdate.ParamByName('TIPFAT').AsString := strTipFat;
    qryUpdate.ParamByName('EMPFAT').AsString := strEmpFat;
  End;

  qryUpdate.ExecSQL;

  qryUpdate.SQL.Clear;
  qryUpdate.SQL.Add('UPDATE                     ');
  qryUpdate.SQL.Add('  TINDOR                   ');
  qryUpdate.SQL.Add('SET                        ');
  qryUpdate.SQL.Add('  FDO_BAIXAD = 1           ');
  qryUpdate.SQL.Add('WHERE                      ');
  qryUpdate.SQL.Add('  FDO_NUMDOC = :NUMDOC AND ');
  qryUpdate.SQL.Add('  FDO_ESPDOC = :ESPDOC AND ');
  qryUpdate.SQL.Add('  FDO_CODEMP = :CODEMP     ');
  qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
  qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
  qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;
  qryUpdate.ExecSQL;

  If (VS_strTipExp = '5') And (fCfgSis('USPRRO',varBoolean)) Then
  Begin
    qryUpdate.SQL.Clear;
    qryUpdate.SQL.Add('DELETE FROM                ');
    qryUpdate.SQL.Add('  ROMGERX                  ');
    qryUpdate.SQL.Add('WHERE                      ');
    qryUpdate.SQL.Add('  GER_NUMDOC = :NUMDOC AND ');
    qryUpdate.SQL.Add('  GER_ESPDOC = :ESPDOC AND ');
    qryUpdate.SQL.Add('  GER_CODEMP = :CODEMP     ');
    qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
    qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
    qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;
    qryUpdate.ExecSQL;
  End;

  if fAtualizarLotDor Or fUsaOndaSeparacaoAgrupamento then
  begin
    qryUpdate.SQL.Clear;
    qryUpdate.SQL.Add(' UPDATE LOTDOR ');
    qryUpdate.SQL.Add(' INNER JOIN FATDOR ON LOTDOR.LDO_SEQFDO = FATDOR.AUTOINCREM ');
    qryUpdate.SQL.Add(' INNER JOIN EXTDOR ON FDO_SEQFDO = FATDOR.AUTOINCREM ');
    qryUpdate.SQL.Add(' SET LDO_PEDCAN = "S" ');
    qryUpdate.SQL.Add(' WHERE FDO_NUMDOC = :NUMDOC ');
    qryUpdate.SQL.Add('   AND FDO_ESPDOC = :ESPDOC ');
    qryUpdate.SQL.Add('   AND FDO_CODEMP = :CODEMP ');

    qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
    qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
    qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;
    qryUpdate.ExecSQL;
  end
  Else If fUsaRotinaWMS and fCfgSis('UTIPEN', varBoolean) Then
  Begin
    qryUpdate.SQL.Clear;
    qryUpdate.SQL.Add(' DELETE FROM LOTDOR USING LOTDOR, FATDOR, EXTDOR ');
    qryUpdate.SQL.Add(' WHERE LOTDOR.LDO_SEQFDO = FATDOR.AUTOINCREM ');
    qryUpdate.SQL.Add('   AND FDO_SEQFDO = FATDOR.AUTOINCREM ');
    qryUpdate.SQL.Add('   AND FDO_QTDEXP = 0 ');
    qryUpdate.SQL.Add('   AND FDO_NUMDOC = :NUMDOC ');
    qryUpdate.SQL.Add('   AND FDO_ESPDOC = :ESPDOC ');
    qryUpdate.SQL.Add('   AND FDO_CODEMP = :CODEMP ');

    qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
    qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
    qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;
    qryUpdate.ExecSQL;
  End;

  pBaixaPedidoNaoEntegue(strNumDoc, strCodEmp, strEspDoc);

  If Not fPedComRequisicaoEmAberto(strNumDoc, strEspDoc, strCodEmp) Then
  Begin
    qryUpdate.SQL.Clear;
    qryUpdate.SQL.Add('SELECT DISTINCT RCD_CODIGO, RCD_CODEMP ');
    qryUpdate.SQL.Add('FROM MOVRCD                ');
    qryUpdate.SQL.Add('WHERE                      ');
    qryUpdate.SQL.Add('  RCD_DOCPDV = :NUMDOC AND ');
    qryUpdate.SQL.Add('  RCD_ESPPDV = :ESPDOC AND ');
    qryUpdate.SQL.Add('  RCD_EMPPDV = :CODEMP     ');

    qryUpdate.ParamByName('NUMDOC').AsString := strNumDoc;
    qryUpdate.ParamByName('ESPDOC').AsString := strEspDoc;
    qryUpdate.ParamByName('CODEMP').AsString := strCodEmp;

    qryUpdate.Open;

    While Not qryUpdate.Eof Do
    Begin
      pExcluiRequisicaoCompra(qryUpdate.FieldByName('RCD_CODIGO').AsString,
                              qryUpdate.FieldByName('RCD_CODEMP').AsString,
                              'pBaixaPedido');
      qryUpdate.Next;
    End;
  End;

  objAtuOcoCrm := TAtuOcoCrm.Create(Application);

  Try
    With qryUpdate, SQL Do
    Begin
      Close;
      Clear;

      Add(' SELECT OCO_CODOCO,         ');
      Add('        OCO_CODEMP,         ');
      Add('        OCO_AGECOM,         ');
      Add('        OCO_CODTOC,         ');
      Add('        OCO_CODCOC          ');
      Add(' FROM MOVOCO                ');
      Add(' WHERE OCO_NUMDOC = :NUMDOC ');
      Add('   AND OCO_ESPDOC = :ESPDOC ');
      Add('   AND OCO_CODEMP = :CODEMP ');
      Add('   AND OCO_CODCLI = :CODCLI ');

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := IIF(Not fEmptyStr(strProspe), strProspe, strCodCli) ;

      Open;
    End;

    If Not qryUpdate.IsEmpty Then
    Begin
      strMotAju := 'Baixa pedido/orçamento que não será faturado<<csq>>Ocorrência:'+
                   strCodOco + '-' + fRetDescOcorrencia(strCodOco) + '<<csq>>' + strMotAju;

      objAtuOcoCrm.strCodOco := qryUpdate.FieldByName('OCO_CODOCO').AsString;
      objAtuOcoCrm.strDtaInc := VS_Date;
      objAtuOcoCrm.strHorInc := fRetHoraServidor();
      objAtuOcoCrm.strDtaAge := objAtuOcoCrm.strDtaInc;
      objAtuOcoCrm.strHorAge := objAtuOcoCrm.strHorInc;
      objAtuOcoCrm.strDtaCon := objAtuOcoCrm.strDtaInc;
      objAtuOcoCrm.strHorCon := objAtuOcoCrm.strHorInc;
      objAtuOcoCrm.strOpeHis := strLoginUsuarioLogado;
      objAtuOcoCrm.strCodOpe := strLoginUsuarioLogado;
      objAtuOcoCrm.strDescri := 'Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) +
                                '<<csq>>' +
                                DateToStr(VS_Date) + ' ' + TimeToStr(fRetHoraServidor) + ' - ' + fRetNomeOperador(strLoginUsuarioLogado) +
                                '<<csq>>' + IfThen(Not fEmptyStr(strMotAju), strMotAju + '<<csq>>', '') + 'Finalizando a Ocorrência.';
      objAtuOcoCrm.strCodEmp := qryUpdate.FieldByName('OCO_CODEMP').AsString;
      objAtuOcoCrm.strCodCoc := IIF(fEmptyStr(strCodComplementoOcorrencia), qryUpdate.FieldByName('OCO_CODCOC').AsString, strCodComplementoOcorrencia);
      objAtuOcoCrm.strCodToc := qryUpdate.FieldByName('OCO_CODTOC').AsString;
      objAtuOcoCrm.strCodSit := IfThen( strEspDoc = 'PD', tciPedidoBaixado.fGetSituacao(), tciOrcamentoBaixado.fGetSituacao());


      objAtuOcoCrm.afcAcaFat := afcBaixaPedidoNaoEntregue;
      objAtuOcoCrm.pProcessaFatOcorrenciasCRM;
    End;
  Finally
    FreeAndNil(objAtuOcoCrm);
  End;

  FreeAndNil(qryUpdate);

  objPromocaoLimitePorClienteOuVenda := TPromocaoLimitePorClienteOuVenda.Create('');

  Try

    objPromocaoLimitePorClienteOuVenda.pSetNumDoc(strNumDoc);
    objPromocaoLimitePorClienteOuVenda.pSetEspDoc(strEspDoc);
    objPromocaoLimitePorClienteOuVenda.pSetEmpDoc(strCodEmp);

    If (objPromocaoLimitePorClienteOuVenda.fExisteLancamentos) Then
      objPromocaoLimitePorClienteOuVenda.pDeletar;

  Finally
    FreeAndNil(objPromocaoLimitePorClienteOuVenda);
  End;

  If (strEspDoc = 'PD') Then
    TUpdateStatus.New(TParamStatus.New()
                        .NumDoc(strNumDoc)
                        .EspDoc(strEspDoc)
                        .CodEmp(strCodEmp)).pExecute();

  pRetornaCashbackUtilizadoVenda;

  TFacadeCobrancaEletronica.pCancelaLinkBaixaPedidoNaoEntregue(strNumDoc, strEspDoc, strCodEmp, tcPagarMe);

  pAtualizaInformacoesItens;

end;


function TFatVenda.fPermiteAlterarCondFormaPagtoConfNFConcreto: Boolean;
begin
  Result := True;

  If (strOpcDoc = 'CN')                     And
     (fCfgSis('TPNFCR', varString) = SECOL) Then
    Result := False;

end;

function TFatVenda.fPermiteAlterarCondFormaPagtoPedido: Boolean;
begin
  Result := True;

  If strNumOrc.IsEmpty Then
    Exit;

  If fltBolAdt <= 0 Then
    Exit;

  If Not blnBolVen Then
    Exit;

  If (strOpcDoc <> 'PD') Then
    Exit;

  If fltTotalFaturadoParcialmente > 0 Then
    Exit(False);

  If fltTotalBoletosAdiantamentoJaEnviados > 0 Then
    Exit(False);
end;

function TFatVenda.fPermiteAplicarJurosNaPromocao(strPromocao: String): Boolean;
begin
  Result := (Not ((Self.strJurPro = 'N') And (strPromocao = 'S')));
end;

function TFatVenda.fPermiteFpgParceladoCI(strCodFpg: String): Boolean;
begin
  Result := ( (Self.strOpcDoc = 'CI') And
              (strCodFpg = '009')     And
              (fCfgSis('PROCTR') = '1') );
end;

function TFatVenda.fVerificaCartaoCheque: Boolean;
  Var
    strDifVal: String;
Begin
  Result := True;

  If blnCfgGravaResCai And blnValGravaResCai And (Not fVerificaGrvCartaoCheque(strDifVal, intSeqCon, IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog))) Then
  Begin
    Result := False;
    fRollBack;

    If blnImpPafEcf Then
    Begin
      pAddMsgErroAdicional('Ocorreu uma inconsistência na gravação dos valores do caixa com cartões/cheques!' + #13#10 +
                  strDifVal + #13#10 + 'Tente realizar a gravação novamente! Se o problema persistir entre em contato com a Citel!');
    End
    Else
    Begin
      pMensagemOk('Ocorreu uma inconsistência na gravação dos valores do caixa com cartões/cheques!' + #13#10 +
                  strDifVal + #13#10 + 'Tente realizar a gravação novamente! Se o problema persistir entre em contato com a Citel!');
    End;

  End;

End;

function TFatVenda.fCarregaCondicaoPedido: Boolean;
Begin

  Result := False;

