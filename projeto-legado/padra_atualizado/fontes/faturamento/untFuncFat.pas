procedure TFatVenda.pGravarAssinatura(ASignature : TSignature; ADocumento : TDadosImpressaoVenda);
var
  LAutInc : String;
  LQuery  : TUniQuery;
begin
  LAutInc := fRetornaInformacaoVenda(ADocumento.strNumDoc,
                                     ADocumento.strEspDoc,
                                     ADocumento.strEmpDoc, 'AUTOINCREM');

  LQuery := fCriaQuery();
  Try
    LQuery.SQL.Text := 'SELECT * FROM ASSGER WHERE FALSE';
    LQuery.Open;
    LQuery.Append;
    LQuery.FieldByName('ASS_SEQGER').AsString := LAutInc;
    LQuery.FieldByName('ASS_VALASS').AsString := ASignature.SignText;
    LQuery.FieldByName('ASS_NOMASS').AsString := ASignature.WhoSign;
    LQuery.FieldByName('ASS_MOTASS').AsString := ASignature.WhySign;
    LQuery.FieldByName('ASS_IMGASS').AsString := ASignature.ImgSignB64;
    LQuery.FieldByName('ASS_DTAASS').AsDateTime := StrToDateTimeDef(ASignature.WhenSign, VS_Date + fTime());
    LQuery.Post;
  Finally
    FreeAndNil(LQuery);
  End;

end;

function fRetQtdeMinimaPorTabelaPreco(strCodIte, strTabPre, strCodEmp: String): Double;
Var
  strSQL: String;
  qryIte: TUniQuery;
Begin

  Try

    qryIte := fCriaQuery(Nil);

    strSQL := '';
    strSQL := '/*untFuncFat(fRetQtdeMinimaPorTabelaPreco)*/';
    strSQL := strSQL + 'SELECT   ';
    strSQL := strSQL + '  ITE_MINTB' + strTabPre + ' AS QTDMIN ';
    strSQL := strSQL + 'FROM     ';
    strSQL := strSQL + '  ITEGER ';
    strSQL := strSQL + 'WHERE    ';
    strSQL := strSQL + '  ITE_CODITE = :CODITE AND  ';
    strSQL := strSQL + '  ITE_CODEMP = :CODEMP      ';

    With qryIte Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODITE').AsString := strCodIte;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;
      Result := FieldByName('QTDMIN').AsFloat;
    End;

  Finally
    FreeAndNil(qryIte);
  End;
End;

function fValidaQtdeMinimaPorTabelaPreco(objMsg : TMensagemLiberacao): Boolean;
Var
  cdsIteTmp    : TUniClientDataSet;
  cdsIteSom    : TUniClientDataSet;
  fltQtdTot    : Double;
  fltQtdMin    : Double;
  stlCodIte    : TStringList;
  objTabela    : TRegistroMsgLiberaTabela;
  objLinha     : TLinhaMsgLibera;
  intAgrupador : Integer;
Begin
  Result := True;
  Try
   stlCodIte := TStringList.Create;
   cdsIteTmp := TUniClientDataSet.Create(Nil);
   cdsIteSom := TUniClientDataSet.Create(Nil);
   objTabela := TRegistroMsgLiberaTabela.Create;

    Try
      cdsIteTmp.Data := cdsVenda.Data;
      cdsIteTmp.LogChanges := False;

      cdsIteSom.Data := cdsVenda.Data;
      cdsIteSom.LogChanges := False;

      cdsIteTmp.Open;
      cdsIteSom.Open;

      cdsIteTmp.First;
      cdsIteSom.First;

      objLinha  := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlCabecalho;
      objLinha.pAddColuna(''  , 'COD.'           , fTamCodIte  , alEsquerda , teAutcom);
      objLinha.pAddColuna(''  , 'PRODUTO'        , 20 , alEsquerda , teAutcom);
      objLinha.pAddColuna(''  , 'UN'             , 2  , alCentro   , teAutcom);
      objLinha.pAddColuna(''  , 'MARCA'          , 12 , alEsquerda , teAutcom);
      objLinha.pAddColuna(''  , 'TP'             , 2  , alCentro   , teAutcom);
      objLinha.pAddColuna(''  , 'QTD.VENDA'      , 14 , alDireita  , teAutcom);
      objLinha.pAddColuna(''  , 'QTD.MIN.TABELA' , 14 , alDireita  , teAutcom);
      objTabela.lstLinhas.Add(objLinha);

      {****************************************************************}
      {* PERCORRE OS ITENS PARA CALCULAR A QUANTIDADE TOTAL DOS ITENS *}
      {*************************************************************PZ*}

      intAgrupador := -1;
      While Not cdsIteTmp.Eof Do
      Begin
        If (stlCodIte.IndexOf(cdsIteTmp.FieldByName('ITE_CODITE').AsString + cdsIteTmp.FieldByName('ITE_TABPRE').AsString) = -1) Then
        Begin
          stlCodIte.Add(cdsIteTmp.FieldByName('ITE_CODITE').AsString + cdsIteTmp.FieldByName('ITE_TABPRE').AsString);

          cdsIteSom.Filter   := 'ITE_CODITE = ' + QuotedStr(cdsIteTmp.FieldByName('ITE_CODITE').AsString) + ' AND ' +
                                'ITE_TABPRE = ' + QuotedStr(cdsIteTmp.FieldByName('ITE_TABPRE').AsString);
          cdsIteSom.Filtered := True;
          cdsIteSom.First;
          fltQtdTot := 0;

          {******************************}
          {* SOMA A QUANTIDADE DO ITENS *}
          {***************************PZ*}
          While Not cdsIteSom.Eof Do
          Begin
            fltQtdTot := fltQtdTot + cdsIteSom.FieldByName('ITE_QTDITE').AsFloat;
            cdsIteSom.Next;
          End;

          {************************************************************}
          {* RETORNA A QUANTIDADE MÍNIMA DO ITENS POR TABELA DE PREÇO *}
          {*********************************************************PZ*}
          fltQtdMin := fRetQtdeMinimaPorTabelaPreco(cdsIteSom.FieldByName('ITE_CODITE').AsString, cdsIteSom.FieldByName('ITE_TABPRE').AsString, VS_strCodEmp);

          {*******************************************************}
          {* MONTA A LINHA COM O PRODUTO CASO A QUANTIDADE DE    *}
          {* VENDA SEJA MENOR QUE A ESTIPULADA NA TABELA E JÁ    *}
          {* RETORNA FALSO INDICANDO PARA A ROTINA ABRIR O PEDIDO*}
          {* LIBERAÇÃO                                           *}
          {***************************************************VA *}
          If (fltQtdTot < fltQtdMin) Then
          Begin
            inc(intAgrupador);
            With cdsIteSom Do
            Begin
              objLinha  := TLinhaMsgLibera.Create;
              objLinha.enuTipoLinha := tlValor;
              objLinha.intAgrupador := intAgrupador;
              objLinha.pAddColuna('COD.'           , FieldByName('ITE_CODITE').AsString                                , fTamCodIte  , alEsquerda );
              objLinha.pAddColuna('PRODUTO'        , Copy(FieldByName('ITE_DESITE').AsString,1,75)                     , 74 , alEsquerda );
              objTabela.lstLinhas.Add(objLinha);

              objLinha  := TLinhaMsgLibera.Create;
              objLinha.enuTipoLinha := tlValor;
              objLinha.intAgrupador := intAgrupador;
              objLinha.pAddColuna(''               , ''                                                                , 27 , alEsquerda, teAutcom );
              objLinha.pAddColuna('UN'             , Copy(FieldByName('ITE_SIGUNI').AsString,1,2)                      , 2  , alCentro   );
              objLinha.pAddColuna('MARCA'          , Copy(FieldByName('ITE_DESMAR').AsString,1,12)                     , 12 , alEsquerda );
              objLinha.pAddColuna('TP'             , FieldByName('ITE_TABPRE').AsString                                , 2  , alCentro   );
              objLinha.pAddColuna('QTD.VENDA'      , FloatToStrF(fltQtdTot, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 14 , alDireita  );
              objLinha.pAddColuna('QTD.MIN.TABELA' , FloatToStrF(fltQtdMin, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 14 , alDireita  );
              objTabela.lstLinhas.Add(objLinha);

            End;
            Result:=False;
          End;
        End;

        cdsIteTmp.Next;
      End;

      if not Result then
        objMsg.lstRegistros.Add(objTabela);

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[fValidaQtdeMinimaPorTabelaPreco]');
      end;
    End;

  Finally
    FreeAndNil(cdsIteTmp);
    FreeAndNil(cdsIteSom);
    FreeAndNil(stlCodIte);

    // se o result for true, então não tem itens para adicionar, se for false, a tabela será adicionada no objMsg e não pode ser destruída
    If Result and Assigned(objTabela) then
      FreeAndNil(objTabela);
  End;
End;

function fTemProdutoNaoRelacionadoCondPagto(objMsg : TMensagemLiberacao;
                                            var fltTotPro: Double;
                                            strCodCnd:String): Boolean;
  Var
    strSQL,
    strCodIte,
    strCodGru,
    strCodGruTmp,
    strCodGruPes : String;
    qryAux   : TUniQuery;
    cdsTmp   : TUniClientDataSet;
    blnTemProdutosInvalidos:Boolean;
    objTabela : TRegistroMsgLiberaTabela;
    objLinha  : TLinhaMsgLibera;
begin

  Try
    Result := False;
    qryAux := fCriaQuery;
    cdsTmp := TUniClientDataSet.Create(Nil);

    cdsTmp.Data := cdsVenda.Data;
    cdsTmp.LogChanges := False;

    fltTotPro := 0.00;

    {************************************}
    {* LISTA TODOS OS GRUPOS DE PRODUTO *}
    {* SELECIONADOS NA VENDA            *}
    {************************************}
    With cdsVenda Do
    Begin
      strCodGru := '';
      strCodGruPes := '';
      First;
      While Not EOF Do
      Begin
        If Not fEmptyStr(FieldByName('ITE_CODITE').AsString) Then
        Begin
          strCodGruTmp := '';

          If (fCfgSis('ITESER') <> FieldByName('ITE_CODITE').AsString) Then
          begin
            strCodGruTmp := fRetGrupoItem(FieldByName('ITE_CODITE').AsString);
            strCodGru := strCodGru + strCodGruTmp + ',';

            If (Not fEmptyStr(strCodGruTmp)) Then
            Begin
              If Not fEmptyStr(strCodGruPes) Then
                strCodGruPes := strCodGruPes + ', ';
              strCodGruPes := strCodGruPes + '"' + strCodGruTmp + '"';
            End;
          End;
        End;

        Next;
      End;
    End;

    // Remove última vírgula
    strCodGru := Copy(strCodGru,1,Length(strCodGru)-1);

    {***********************************************}
    {* VERIFICA SE ALGUM DOS PRODUTOS SELECIONADOS *}
    {* NA VENDA TEM RESTRIÇÃO DE COND. PAGTO       *}
    {********************************************MM*}

    If (Not fEmptyStr(strCodGruPes)) Then
    Begin
      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  SQL_NO_CACHE G.AUTOINCREM, ';
      strSQL := strSQL + '  GROUP_CONCAT(C.CND_CODCND) AS CODCND ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  CRUGRU G INNER JOIN CRUCND C ON G.GRU_SEQCRU = C.CND_SEQCRU ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  GRU_CODGRU IN (' + strCodGruPes + ') ';
      strSQL := strSQL + 'GROUP BY ';
      strSQL := strSQL + '  G.GRU_CODGRU ';
      With qryAux Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        Open;
      End;
    End;

    {************************************************************}
    {* SE NENHUM ITEM TIVER RESTRIÇÃO, NEM VERIFICA COND. PAGTO *}
    {*********************************************************MM*}
    If (fEmptyStr(strCodGruPes)) Or (qryAux.IsEmpty) Then

      Result := False

    Else
    Begin
      blnTemProdutosInvalidos := False;

      {**************************************************************}
      {* SE ALGUM ITEM TIVER RESTRIÇÃO, TESTA CONDIÇÃO DE PAGAMENTO *}
      {***********************************************************MM*}
      qryAux.First;
      While Not qryAux.EOF Do
      Begin
        If (Pos(strCodCnd, qryAux.FieldByName('CODCND').AsString) <= 0) Then
        Begin
          blnTemProdutosInvalidos := True;
          qryAux.Last;
        End;

        qryAux.Next;
      End;

      If blnTemProdutosInvalidos Then
      Begin
        {**********************************************}
        {* LISTA TODOS OS ITENS SELECIONADOS NA VENDA *}
        {**********************************************}
        With cdsVenda Do
        Begin
          strCodIte := '';
          First;
          While Not EOF Do
          Begin
            strCodIte := strCodIte + FieldByName('ITE_CODITE').AsString + ',';
            Next;
          End;
        End;

        // Remove última vírgula
        strCodIte := Copy(strCodIte,1,Length(strCodIte)-1);

        strSQL := '';
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  I.ITE_CODITE, ';
        strSQL := strSQL + '  C.CND_CODCND, ';
        strSQL := strSQL + '  G.GRU_CODGRU  ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL + '  CADITE I LEFT JOIN CRUGRU G ON (I.ITE_CODGRU = G.GRU_CODGRU) ';
        strSQL := strSQL + '           LEFT JOIN CRUCND C ON (C.CND_SEQCRU = G.GRU_SEQCRU) ';
        strSQL := strSQL + '                             AND (C.CND_CODCND = :CODCND)      ';
        strSQL := strSQL + 'WHERE ';

        If (Not fEmptyStr(fCfgSis('ITESER', varString))) Then
          strSQL := strSQL + '  I.ITE_CODITE <>  ' + fCfgSis('ITESER', varString) + ' AND ';

        strSQL := strSQL + '  I.ITE_CODITE IN (' + strCodIte + ') ';

        With qryAux Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQL);
          ParamByName('CODCND').AsString := strCodCnd;
          Open;

          objTabela := TRegistroMsgLiberaTabela.Create;

          First;
          While Not EOF Do
          Begin
            If (FieldByName('CND_CODCND').AsString = EmptyStr) Or
               (FieldByName('GRU_CODGRU').AsString = EmptyStr) Then
            Begin
              cdsTmp.Filtered := False;
              cdsTmp.Filter   := ' ITE_CODITE = ' + FieldByName('ITE_CODITE').AsString;
              cdsTmp.Filtered := True;

              If ((FieldByName('CND_CODCND').AsString = EmptyStr) and (FieldByName('GRU_CODGRU').AsString = EmptyStr)) Then
              else
              begin
                if objTabela.isEmpty then
                begin
                  objLinha  := TLinhaMsgLibera.Create;
                  objLinha.enuTipoLinha := tlCabecalho;
                  objLinha.pAddColuna(''  , 'COD.'       , fTamCodIte  , alEsquerda , teAutcom);
                  objLinha.pAddColuna(''  , 'DESCRICAO'  , 37 , alEsquerda , teAutcom);
                  objLinha.pAddColuna(''  , 'UN'         , 2  , alCentro   , teAutcom);
                  objLinha.pAddColuna(''  , 'QUANTIDADE' , 10 , alDireita  , teAutcom);
                  objLinha.pAddColuna(''  , 'VR.UNITARIO', 13 , alDireita  , teAutcom);
                  objLinha.pAddColuna(''  , 'VR.LIQUIDO' , 13 , alDireita  , teAutcom);
                  objLinha.pAddColuna(''  , 'VR.TOTAL'   , 13 , alDireita  , teAutcom);
                  objLinha.pAddColuna(''  , 'VR.TOT.C/.IMP.', 16 , alDireita  , teAutcom);
                  objTabela.lstLinhas.Add(objLinha);
                end;

                objLinha  := TLinhaMsgLibera.Create;
                objLinha.enuTipoLinha := tlValor;
                objLinha.pAddColuna('COD.'       , cdsTmp.FieldByName('ITE_CODITE').AsString                                                        , fTamCodIte  , alEsquerda );
                objLinha.pAddColuna('DESCRICAO'  , Copy(cdsTmp.FieldByName('ITE_DESITE').AsString,1,37)                                             , 37 , alEsquerda );
                objLinha.pAddColuna('UN'         , Copy(cdsTmp.FieldByName('ITE_SIGUNI').AsString,1,2)                                              , 2  , alCentro   );
                objLinha.pAddColuna('QUANTIDADE' , FloatToStrF(cdsTmp.FieldByName('ITE_QTDITE').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 10 , alDireita  );
                objLinha.pAddColuna('VR.UNITARIO', FloatToStrF(cdsTmp.FieldByName('ITE_UNIDIG').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 13 , alDireita  );
                objLinha.pAddColuna('VR.LIQUIDO', FloatToStrF(cdsTmp.FieldByName('ITE_UNITAR').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 13 , alDireita  );
                objLinha.pAddColuna('VR.TOTAL'   , FloatToStrF(cdsTmp.FieldByName('ITE_TOTITE').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 13 , alDireita  );
                objLinha.pAddColuna('VR.TOT.C/.IMP.', FloatToStrF(cdsTmp.FieldByName('ITE_VLRCON').AsFloat, ffFixed, 12, fCfgSis('DECQTD', varInteger)), 16 , alDireita  );
                objTabela.lstLinhas.Add(objLinha);

                fltTotPro := fltTotPro + cdsTmp.FieldByName('ITE_TOTITE').AsFloat;
              end;
            End;

            Next;
          End;

          Result := Not objTabela.isEmpty;
          if Result then
            objMsg.lstRegistros.add(objTabela)
          else
            FreeAndNil(objTabela);

        End;
      End;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[ TFatVenda.fCondPagtoProdutoRelacionados ]');
    End;
  End;
End;

function fGetSqlPedido: String;
begin
  Result := '';
  Result := Result + fSelectFromFatgorLeftAuxiliares(False);
  Result := Result + 'WHERE ';
  Result := Result + '  F.FGO_NUMDOC = :NUMDOC AND ';
  Result := Result + '  F.FGO_ESPDOC = :ESPDOC AND ';
  Result := Result + '  F.FGO_CODEMP = :CODEMP ';
end;

function fPedidoOrcamentoFormulacaoJaBaixada(strNumDoc, strEspDoc,
  strCodEmp, strCodCli: String): Boolean;
var
  qryGen: TUniQuery;
begin
  Try
    qryGen := fCriaQuery;
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT FDO_BAIXAD           ');
      SQL.Add('   FROM TINDOR               ');
      SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC ');
      SQL.Add('    AND FDO_ESPDOC = :ESPDOC ');
      SQL.Add('    AND FDO_CODEMP = :CODEMP ');
      SQL.Add('    AND FDO_CODCLI = :CODCLI ');
      SQL.Add('    AND (FDO_BAIXAD = "1" OR ');
      SQL.Add('         FDO_BAIXAD = "S")   ');
      SQL.Add('    LIMIT 1                  ');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('CODCLI').AsString := strCodCli;
      Open;

      Result := Not IsEmpty;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

function fFormulacaoEmProcessamento(qryPedOrc: TUniQuery): Boolean;
var
  qryGen: TUniQuery;
begin
  Try
    qryGen := fCriaQuery;
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(' SELECT TRUE                 ');
      SQL.Add('   FROM TINDOR               ');
      SQL.Add('  WHERE FDO_NUMDOC = :NUMDOC ');
      SQL.Add('    AND FDO_ESPDOC = :ESPDOC ');
      SQL.Add('    AND FDO_CODEMP = :CODEMP ');
      SQL.Add('    AND FDO_CODCLI = :CODCLI ');
      SQL.Add('    AND FDO_PROCES = "1"     ');
      SQL.Add('    LIMIT 1                  ');
      ParamByName('NUMDOC').AsString := qryPedOrc.FieldByName('FGO_NUMDOC').AsString;
      ParamByName('ESPDOC').AsString := qryPedOrc.FieldByName('FGO_ESPDOC').AsString;
      ParamByName('CODEMP').AsString := qryPedOrc.FieldByName('FGO_CODEMP').AsString;
      ParamByName('CODCLI').AsString := qryPedOrc.FieldByName('FGO_CODCLI').AsString;
      Open;

      Result := Not IsEmpty;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
End;


function fTravarCondicaoPagamento(strCodCnd, strConPag, strCodCli, strCodVen, strCodDig, strNTrava, strCodIte: String; stlNumLib: TStringList; cdsVenda: TUniClientDataSet = Nil; objVenda: TFatVenda = Nil): Boolean;
Var
  objLiberacao : TLiberacao;
  objLinha : TLinhaMsgLibera;
  objTabela: TRegistroMsgLiberaTabela;
  strCndTmp: String;
  strCliTmp: String;
  strCgcTmp: String;
  qryAux   : TUniQuery;
  strCpfCnpjConsumidor: String;

  function fClienteTemDuplicatasDeCredito: Boolean;
  begin
    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT ');
    qryAux.SQL.Add('   AUTOINCREM, ');
    qryAux.SQL.Add('   CTR_NUMDUP AS NUMDUP, ');
    qryAux.SQL.Add('   CTR_DTACAD AS DTACAD, ');
    qryAux.SQL.Add('   CTR_DTAVEN AS DTAVEN, ');
    qryAux.SQL.Add('   CTR_VALDUP AS VALDUP  ');
    qryAux.SQL.Add('FROM ');
    qryAux.SQL.Add('  CADREC ');
    qryAux.SQL.Add('WHERE ');

    qryAux.SQL.Add('  CTR_DTAREC IS NULL AND ');
    qryAux.SQL.Add('  CTR_VALDUP < 0.0   AND ');
    qryAux.SQL.Add('  CTR_CODCLI = :CODCLI   ');

    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.Open;

    Result := Not qryAux.isEmpty;
  end;

  procedure pMontaMensagemCnd(objMsg: TMensagemLiberacao);
    var
        fltTotVlAberto: Double;
  begin
    qryAux    := fCriaQuery(nil);
    fltTotVlAberto := 0.00;
    try
      If fClienteTemDuplicatasDeCredito Then
      Begin
        qryAux.First;

        objMsg.pAddSeparador(67);
        objMsg.pAddTexto('|      CREDITOS EXISTENTES PARA O CLIENTE        |');

          objTabela := TRegistroMsgLiberaTabela.Create;
          objLinha  := TLinhaMsgLibera.Create;

          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'Documento'   , 21 , alCentro , teAutcom);
          objLinha.pAddColuna('', 'Dt. Cad'     , 12, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Dt. Vencto'  , 12, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Vr. Aberto'  , 13, alCentro  , teAutcom);
          objTabela.lstLinhas.Add(objLinha);

        While Not qryAux.Eof Do
        Begin

          objLinha := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlValor;
          objLinha.pAddColuna('Documento',  qryAux.FieldByName('NUMDUP').AsString  , 21 , alCentro , teAmbos);
          objLinha.pAddColuna('Dt. Cad',    qryAux.FieldByName('DTACAD').AsString  , 12, alEsquerda, teAmbos);
          objLinha.pAddColuna('Dt. Vencto', qryAux.FieldByName('DTAVEN').AsString  , 12, alEsquerda, teAutcom);
          objLinha.pAddColuna('Vr. Aberto', FormatFloat('###,###,##0.00',qryAux.FieldByName('VALDUP').AsFloat)  , 13, alCentro  , teAutcom);
          objTabela.lstLinhas.Add(objLinha);

          fltTotVlAberto := fltTotVlAberto + qryAux.FieldByName('VALDUP').AsFloat;
          qryAux.Next;
        End;

            objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlTotal;
        objLinha.pAddColuna(''          , 'TOTAIS'                                     , 49, alEsquerda , teAutcom);
        objLinha.pAddColuna('Vr. Aberto', FormatFloat('###,###,##0.00',fltTotVlAberto) , 13, alCentro   , teAutcom);
            objTabela.lstLinhas.Add(objLinha);
            objMsg.lstRegistros.Add(objTabela);
        objMsg.pAddQuebra;

        If (cdsVenda <> nil) And (Not cdsVenda.isEmpty) Then
          objVenda.pMontaMensagem(cdsVenda, objMsg, Nil, False, False);
      End;
    Finally
      FreeAndNil(qryAux);
    End;

  end;

Begin
  Result := False;

  If Assigned(objVenda) Then
  Begin
    If (Pos(objVenda.strOpcDoc, 'OF_EF_') > 0) Then
      Exit;

    If objVenda.blnNEFornecedor Then
      Exit;
  End;

  If (fCfgSis('PFLCLI', VarString) = 'S') And
     (fCfgSis('USACND', VarString) = 'S') Then
  Begin
    pRemoverTravaLogAvi('SETCND', strNTrava);

    strCpfCnpjConsumidor := '';
    If fClienteConsumidor(fRetNomCliente(strCodCli), True, True) Then
    Begin
      If Assigned(objVenda) Then
      Begin
        strCpfCnpjConsumidor := objVenda.strCliCgc;
      End;
    End;

    If (fRetSenhaTravaConPag(strCodCnd)) Then
    Begin
      strCndTmp := fTiraCaracEspeciais(strConPag, True, True, True);
      strCliTmp := fRetNomCliente(strCodCli, strCpfCnpjConsumidor);
      strCgcTmp := IfEmptyStr(strCpfCnpjConsumidor, fRetCgcCpf(strCodCli));

      If (fEmptyStr(strCndTmp)) Then
        strCndTmp := fRetConPag(strCodCnd);

      objLiberacao := TLiberacao.Create;
      try
        objLiberacao.objMsgLibera.pAddTexto('Liberação da Condição de Pagamento - Conforme definido no perfil, é preciso liberar com senha o uso dessa condição');
        objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto' , strCodCnd + '-' + fFormataCondPag(strCndTmp) + '-' + fRetDesConPag(strCodCnd));
        objLiberacao.objMsgLibera.pAddQuebra;
        objLiberacao.objMsgLibera.pAddQuebra;

        objLiberacao.strDirAce := 'SETCND';
        objLiberacao.strSenLib := fCfgSis('SETCND');
        objLiberacao.strMsgSen := 'Liberação da Condição de Pagamento - Conforme definido no perfil, é preciso liberar com senha o uso dessa condição';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCodIte := strCodIte;
        objLiberacao.strCliente := strCodCli + '-' + fRetNomCliente(strCodCli, strCpfCnpjConsumidor);
        objLiberacao.strCpfCnpj := fFormataCpfCgc(strCgcTmp, fSetaPais);
        If Assigned(objVenda) Then
          objLiberacao.strSequencialUnicoDtaHra := objVenda.FSequencialUnicoDtaHrLogVar;

        If Assigned(objVenda) Then
          objLiberacao.objMsgRemota.pAddTextoCaption('Valor desta Venda' , FloatToStrF(objVenda.fltTotGer, ffNumber, 12, fCfgSis('DECQTD', varInteger)));

        If Assigned(objVenda) And (String('PD_OR_').Contains(objVenda.strOpcDoc)) And (Not fEmptyStr(objVenda.strNumOrc)) Then
          objLiberacao.objMsgRemota.pAddTexto('Documento: ' + objVenda.strNumOrc + '-' + objVenda.strEspOrc + '-' + objVenda.strEmpDoc);

        If fRetForPagCodCnd(strCodCnd) = '013' Then
          pMontaMensagemCnd(objLiberacao.objMsgLibera)
        Else If ((cdsVenda <> nil)) And (Not cdsVenda.IsEmpty) And Assigned(objVenda) Then
          objVenda.pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);

        Result := (Not fMensagemLiberacao(objLiberacao, strNTrava, stlNumLib));
      finally
        FreeAndNil(objLiberacao);
      end;
    End;
  End;
End;

