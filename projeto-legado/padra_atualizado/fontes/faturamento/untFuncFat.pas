      strSQL := strSQL + '  WHERE ';
      strSQL := strSQL + '  CON_C_P_F_ = :C_P_F_ ';
    End
    Else
    Begin
      strSQL := '';
      strSQL := strSQL + 'REPLACE INTO CLICON (';
      strSQL := strSQL + '  CON_CODCON, ';
      strSQL := strSQL + '  CON_CODEMP, ';
      strSQL := strSQL + '  CON_NOMCON, ';
      strSQL := strSQL + '  CON_ENDERE, ';
      strSQL := strSQL + '  CON_BAIRRO, ';
      strSQL := strSQL + '  CON_C_E_P_, ';
      strSQL := strSQL + '  CON_CODCID, ';
      strSQL := strSQL + '  CON_FONE01, ';
      strSQL := strSQL + '  CON_C_P_F_, ';
      strSQL := strSQL + '  CON_NUMR_G, ';
      strSQL := strSQL + '  CON_I_E_S_, ';
      strSQL := strSQL + '  CON_EMLCON, ';
      strSQL := strSQL + '  CON_CGCCPF, ';
      strSQL := strSQL + '  CON_CODATI, ';
      strSQL := strSQL + '  CON_CODCAC, ';
      strSQL := strSQL + '  CON_NASCON, ';
      strSQL := strSQL + '  AUTOINCREM) ';
      strSQL := strSQL + 'VALUES ( ';
      strSQL := strSQL + '  :CODCON, ';
      strSQL := strSQL + '  :CODEMP, ';
      strSQL := strSQL + '  :NOMCON, ';
      strSQL := strSQL + '  :ENDERE, ';
      strSQL := strSQL + '  :BAIRRO, ';
      strSQL := strSQL + '  :C_E_P_, ';
      strSQL := strSQL + '  :CODCID, ';
      strSQL := strSQL + '  :FONE01, ';
      strSQL := strSQL + '  :C_P_F_, ';
      strSQL := strSQL + '  :NUMR_G, ';
      strSQL := strSQL + '  :I_E_S_, ';
      strSQL := strSQL + '  :EMAIL_, ';
      strSQL := strSQL + '  :CGCCPF, ';
      strSQL := strSQL + '  :CODATI, ';
      strSQL := strSQL + '  :CODCAC, ';
      strSQL := strSQL + '  :NASCON, ';
      strSQL := strSQL + '  :AUTOINCREM) ';
    End;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      If Not blnCliConExiste Then
      Begin
        ParamByName('CODCON').AsString      := fProximoCodigo('CON_CODCON');
        ParamByName('AUTOINCREM').AsString  := fRetAutoIncrem('CLICON', VS_strCodEmp);
      End;

      ParamByName('CODEMP').AsString      := VS_strCodEmp;

      If fValidaCPFConsumidor Then
      Begin
        ParamByName('NOMCON').AsString      := strCliNom;
        ParamByName('ENDERE').AsString      := Copy(strCliEnd,1,60);
        ParamByName('BAIRRO').AsString      := Copy(strCliBai, 1, 30);
        ParamByName('C_E_P_').AsString      := strCliCep;

        If (fEmptyStr(strCodCid)) Then
          ParamByName('CODCID').Value       := Null
        Else
          ParamByName('CODCID').AsString    := strCodCid;

        ParamByName('FONE01').AsString      := strCliTel;
        ParamByName('C_P_F_').AsString      := Self.strCliCgc;

        If (intCgcCpf = 2) Then
        Begin
          ParamByName('NUMR_G').AsString      := strCli_Rg;
          ParamByName('I_E_S_').AsString      := '';
        End
        Else
        Begin
          ParamByName('NUMR_G').AsString      := '';
          ParamByName('I_E_S_').AsString      := strCliIes;
        End;

        ParamByName('CGCCPF').AsString      := IntToStr(intCgcCpf);
        ParamByName('EMAIL_').AsString      := Copy(AnsiLowerCase(strCliEma),1,50);
        ParamByName('CODATI').AsString      := strCodAti;
        ParamByName('CODCAC').AsString      := strCodCac;

        If dtaNasCon > 0 Then
          ParamByName('NASCON').AsDateTime  := dtaNasCon;
      End
      Else//Req: 77695
      Begin
        qryCli := fCriaQuery();

        qryCli.SQL.Add('SELECT  ');
        qryCli.SQL.Add('  CLI_NOMCLI, ');
        qryCli.SQL.Add('  CLI_ENDERE, ');
        qryCli.SQL.Add('  CLI_BAIRRO, ');
        qryCli.SQL.Add('  CLI_C_E_P_, ');
        qryCli.SQL.Add('  CLI_CODCID, ');
        qryCli.SQL.Add('  CLI_FONE01, ');
        qryCli.SQL.Add('  CLI_C_G_C_, ');
        qryCli.SQL.Add('  CLI_NUMR_G, ');
        qryCli.SQL.Add('  CLI_I_E_S_, ');
        qryCli.SQL.Add('  CLI_CGCCPF, ');
        qryCli.SQL.Add('  CLI_EMAIL_, ');
        qryCli.SQL.Add('  CLI_CODATI, ');
        qryCli.SQL.Add('  CLI_CODCAC  ');
        qryCli.SQL.Add('FROM CADCLI   ');
        qryCli.SQL.Add('WHERE CLI_CODCLI = ' +  QuotedStr(Self.strCodCli));

        qryCli.Open;

        ParamByName('NOMCON').AsString      := qryCli.FieldByName('CLI_NOMCLI').AsString;
        ParamByName('ENDERE').AsString      := qryCli.FieldByName('CLI_ENDERE').AsString;
        ParamByName('BAIRRO').AsString      := qryCli.FieldByName('CLI_BAIRRO').AsString;
        ParamByName('C_E_P_').AsString      := qryCli.FieldByName('CLI_C_E_P_').AsString;
        ParamByName('CODCID').AsString      := qryCli.FieldByName('CLI_CODCID').AsString;
        ParamByName('FONE01').AsString      := qryCli.FieldByName('CLI_FONE01').AsString;
        ParamByName('C_P_F_').AsString      := qryCli.FieldByName('CLI_C_G_C_').AsString;

        If (qryCli.FieldByName('CLI_CGCCPF').AsInteger = 2) Then
        Begin
          ParamByName('NUMR_G').AsString      := qryCli.FieldByName('CLI_NUMR_G').AsString;
          ParamByName('I_E_S_').AsString      := '';
        End
        Else
        Begin
          ParamByName('NUMR_G').AsString      := '';
          ParamByName('I_E_S_').AsString      := qryCli.FieldByName('CLI_I_E_S_').AsString;
        End;

        ParamByName('CGCCPF').AsString      := qryCli.FieldByName('CLI_CGCCPF').AsString;
        ParamByName('EMAIL_').AsString      := qryCli.FieldByName('CLI_EMAIL_').AsString;
        ParamByName('CODATI').AsString      := qryCli.FieldByName('CLI_CODATI').AsString;
        ParamByName('CODCAC').AsString      := qryCli.FieldByName('CLI_CODCAC').AsString;

        FreeAndNil(qryCli);
      End;

      ExecSQL;

    End;
  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[ TFatVenda.fGravaAtualizaConsumidor ]');
    End;
  End;

  FreeAndNil(qryGen);
end;

