procedure pI_LinhasNota(Sender: TFatVenda; cpuCampos: TCamposUso; Var intLinAtu: Integer;
  Var intLinha: Integer; strNomImp: String; qryCnfGen: TUniQuery; intColuna: Integer = 0);
  Var
    _intColuna : Integer;
    intLinTmp  : Integer;
    intContador: Integer;

    blnUltimoReg: Boolean;

    strMacro: String;
    strLinha: String;

    strProcessado: String;
begin

  strLinha := '';
  blnUltimoReg := (qryCnfGen.RecNo = qryCnfGen.RecordCount);

  pInicializaVariaveis;

  If ((qryCnfGen.FieldByName('CNF_LINIMP').AsInteger = 0)  And
      (qryCnfGen.FieldByName('CNF_COLIMP').AsInteger = 0)) Then
  Begin

    If (qryCnfGen.FieldByName('CNF_IDENTI').AsString <> '00') Then
    Begin
      qryCnfGen.Next;
      Exit;
    End

    Else If (qryCnfGen.FieldByName('CNF_CHRANT').AsString = '') And
            (qryCnfGen.FieldByName('CNF_DESCAM').AsString = '') And
            (qryCnfGen.FieldByName('CNF_CHRDEP').AsString = '') Then
    Begin
      qryCnfGen.Next;
      Exit;
    End;

  End;

  For intContador := 1 To intLiTopo Do
  Begin
    intLiTopo := intLiTopo - 1;
    pEscreveLinha(strArqTxt, '', False);
  End;


  For intContador := 1 To ((qryCnfGen.FieldByName('CNF_LINIMP').AsInteger) - intLinAtu - 1) Do
  Begin
    pEscreveLinha(strArqTxt, '', False);
  End;


  If intLinha = 0 Then
  Begin
    intLinAtu := qryCnfGen.FieldByName('CNF_LINIMP').AsInteger;

    If (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '02') Or
       (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '03') Then
      intLinha := intLinAtu;

  End
  Else
  Begin
    intLinAtu := intLinha + intLiTopo;

    If (qryCnfGen.FieldByName('CNF_IDENTI').AsString <> '02') And
       (qryCnfGen.FieldByName('CNF_IDENTI').AsString <> '03') Then
      intLinha := 0
    Else
    Begin
      Inc(intLinha);
      Inc(intLinAtu);
    End;
  End;

  If (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '01') Or
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '02') Or
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '03') Or
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '04') Or
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '05') Or
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '06') Or
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString = '99') Then
  Begin
    intLinTmp := qryCnfGen.FieldByName('CNF_LINIMP').AsInteger;
  End
  Else
    intLinTmp := intLinAtu;

  If (qryCnfGen.FieldByName('CNF_IDENTI').AsString <> '02') And
     (qryCnfGen.FieldByName('CNF_IDENTI').AsString <> '03') Then
    intLinAtu := intLinTmp;

  While (intLinTmp = qryCnfGen.FieldByName('CNF_LINIMP').AsInteger) And
        (Not qryCnfGen.Eof)                                         Do
  Begin

    If (intLiTopo < qryCnfGen.FieldByName('CNF_LITOPO').AsInteger) Then
    Begin
      intLiTopo := qryCnfGen.FieldByName('CNF_LITOPO').AsInteger;
    End;

    If intColuna = 0 Then
    Begin
      _intColuna := qryCnfGen.FieldByName('CNF_COLIMP').AsInteger;
    End
    Else
    Begin
      _intColuna := intColuna;
    End;

    strMacro := qryCnfGen.FieldByName('CNF_CHRANT').AsString;
    If Trim(strMacro) <> '' Then
    Begin
      pMontaLinha(strLinha, fProcessaMacro(Sender, cpuCampos, strMacro), _intColuna);
    End;

    strMacro := qryCnfGen.FieldByName('CNF_DESCAM').AsString;
    If Trim(strMacro) <> '' Then
    Begin

      strProcessado := fProcessaMacro(Sender, cpuCampos, strMacro);

      If (qryCnfGen.FieldByName('CNF_DESDOB').AsString = 'S') And
         (Sender.intNotAtu < Sender.intQtdNot)                             Then
      Begin
        strProcessado := fReplicatorStr('*', Length(strProcessado));
      End;

      pMontaLinha(strLinha, strProcessado, _intColuna);
    End;

    strMacro := qryCnfGen.FieldByName('CNF_CHRDEP').AsString;
    If Trim(strMacro) <> '' Then
    Begin
      pMontaLinha(strLinha, fProcessaMacro(Sender, cpuCampos, strMacro), _intColuna);
    End;

    qryCnfGen.Next;
    lstVariaveis.Clear;
  End;

  pEscreveLinha(strArqTxt, AnsiString(strLinha), blnUltimoReg, strNomImp);
end;

function fDavPreVendaImpressoOuFaturado(strNumDoc, strEspDoc: String): Boolean;
  Var
    qryAux: TUniQuery;
    strNomeDoc: String;
begin
  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add('SELECT DPG_COODAV, DPG_JAFATU FROM DAVPVG ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  DPG_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  DPG_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  DPG_CODEMP = :CODEMP ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
  qryAux.Open;

  Result := False;
  If Not qryAux.IsEmpty Then
  Begin
    strNomeDoc := IIF(strEspDoc='PD', 'sua Pré-venda', 'seu DAV');
    If Not fEmptyStr(qryAux.FieldByName('DPG_COODAV').AsString) Then
    Begin
      pMensagemOk('Este documento já teve ' + strNomeDoc + ' impresso(a), portanto não é permitido alterá-lo.');
      Result := True;
    End
    Else If qryAux.FieldByName('DPG_JAFATU').AsInteger = 1 Then
    Begin
      pMensagemOk('Este documento já teve ' + strNomeDoc + ' faturado(a), portanto não é permitido alterá-lo.');
      Result := True;
    End;
  End;

  FreeAndNil(qryAux);
end;

function fDavPreVendaCadastrado(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
  Var
    qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Nil);
  qryAux.SQL.Add('SELECT COUNT(*) AS QTD FROM DAVPVG ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  DPG_NUMDOC = :NUMDOC AND ');
  qryAux.SQL.Add('  DPG_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  DPG_CODEMP = :CODEMP ');

  qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
  qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
  qryAux.ParamByName('CODEMP').AsString := strCodEmp;
  qryAux.Open;

  Result := (qryAux.FieldByName('QTD').AsInteger > 0);

  FreeAndNil(qryAux);
end;

function fGetDescricaoEspecie(strEspecie: String): String;
begin
  Result := '';

  If strEspecie = 'PD' Then
    Result := 'Pedido'

  Else If strEspecie = 'OR' Then
    Result := 'Orçamento'

  Else If strEspecie = 'NF' Then
    Result := 'Nota Fiscal'

  Else If strEspecie = 'NS' Then
    Result := 'Nota Serviço'

  Else If strEspecie = 'TE' Then
    Result := 'Transferência de Estoque'

  Else If strEspecie = 'BR' Then
    Result := 'Brinde'

  Else If strEspecie = 'FF' Then
    Result := 'Faturamento Futuro'

  Else If strEspecie = 'IF' Then
    Result := 'Cupom Fiscal';
end;

function fValidaSePodeEmitirDAVPV(fatVenda: TFatVenda; fltValFre: Double; tipFinDoc: TFinalidadeDocumento; blnExibeAlerta: Boolean=True): Boolean;
  Var
    strTip,
    strMsg: String ;

   procedure pIncrementaMensagem(strTexto: string);
   begin
     strMsg := strMsg + IIF(Not fEmptyStr(strMsg),', ','') + strTexto;
   end;

begin
  Result := True;

  If fCfgSis('PAFECF', varBoolean) And (tipFinDoc = tfdCupomFiscal) Then
  Begin
    strMsg := '';

    If (fatVenda.blnCliFil) Then
      pIncrementaMensagem('CLIENTE FILIAL');

    If fatVenda.fTemEntregaFutura(fatVenda.arrMatItens) Then
      pIncrementaMensagem('DOCUMENTO COM ITENS DE ENTREGA FUTURA');

    If (fatVenda.blnEnt_CD) Then
      pIncrementaMensagem('ENTREGA PELO CD');

    If (fatVenda.fltValS01 > 0) Then
      pIncrementaMensagem('DOCUMENTO COM SERVIÇOS');

    If (Not fEmptyStr(fatVenda.strNumPok)) And (Not fCfgSis('PMCPTB', varBoolean)) Then
      pIncrementaMensagem('DOCUMENTO DE POCKET');

    If (Not fEmptyStr(fatVenda.strPedSit)) Then
      pIncrementaMensagem('DOCUMENTO DE SITE');

    If (fltValFre > 0) Then
      pIncrementaMensagem('DOCUMENTO COM FRETE');

    If (fatVenda.fltTotIpi > 0) Then
      pIncrementaMensagem('DOCUMENTO COM IPI');

    If (fatVenda.fltTotRet > 0) Then
      pIncrementaMensagem('DOCUMENTO COM ST');

    If (fatVenda.fltDesAce > 0) Then
      pIncrementaMensagem('DOCUMENTO COM DESP. ACESSÓRIA');

    If (Not fatVenda.blnVendaPresencial) And
       (Not fatVenda.fUFsDestTribItems.Contains(fatVenda.fTrocaUFEndEntrega)) Then
      pIncrementaMensagem('CLIENTE FORA DO ESTADO');

    If (fatVenda.fltValAdt > 0) Then
      pIncrementaMensagem('DOCUMENTO COM ADIANTAMENTO');

    If (fatVenda.fltBolAdt > 0) Or fatVenda.blnBolVen Then
      pIncrementaMensagem('DOCUMENTO COM BOLETO DE ADIANTAMENTO');

    If (fatVenda.fTemLoteADefinir) Then
      pIncrementaMensagem('DOCUMENTO COM ITENS DE LOTE "A DEFINIR"');

    If (Not fEmptyStr(strMsg)) And (blnExibeAlerta) Then
    Begin
      strTip := IIF(fatVenda.strEspDoc='PD','Pedido','Orçamento');
      If fEmptyStr(strTip) Then
        strTip := 'documento';

      fMensagem('ATENÇÃO!', 'Não é permitido prosseguir este '+strTip+' com a finalidade "Cupom Fiscal". Motivos: ('+strMsg+'), '+
                            'o que impossibilita o mesmo ser faturado pelo PDV (CFG_PAFECF)!'+#10#13+
                            'Analise o motivo e se for preciso, altere a finalidade do '+strTip+' para faturá-lo através do Autcom.', ['&Ok']);
    End;

    Result := fEmptyStr(strMsg);
  End;
end;

