                                          qryConsignacao.FieldByName('CTR_CODEMP').AsString,                      // Empresa
                                          qryConsignacao.FieldByName('CTR_ESPDOC').AsString,                      // Espécie
                                          qryConsignacao.FieldByName('CTR_CODCLI').AsString,                      // Cliente
                                          Self.arrDocConsignacao[intIndice].fltValDoc,                       // Valor Recebido
                                          qryConsignacao.FieldByName('CTR_VALJUR').AsFloat,                       // Valor Juros
                                          qryConsignacao.FieldByName('CTR_VALDES').AsFloat,                       // Valor do Desconto
                                          fRetDataServidor,                                               // Data do Recebimento
                                          fRetDataServidor,                                               // Data do Vencimento
