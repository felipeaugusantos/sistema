class function TFatVenda.fPedidoRecebidoModalidadesCreditoeAReceberF11(
  strNumPed, strEspPed, strEmpPed: String): Boolean;
  Var
    qryInfPed: TUniQuery;
begin
  Result := False;

  If fEmptyStr(strNumPed) Then
    Exit;

  qryInfPed := fCriaQuery;

  qryInfPed.SQL.Add('SELECT SQL_NO_CACHE    ');
  qryInfPed.SQL.Add('  FGO_CODCLI AS CODCLI,');
  qryInfPed.SQL.Add('  FGO_ESPDOC AS ESPDOC,');
  qryInfPed.SQL.Add('  FGO_CODFPG AS CODFPG,');
  qryInfPed.SQL.Add('  FGO_CONPAG AS CONPAG,');
  qryInfPed.SQL.Add('  FGO_VLRCON AS VLRCON,');
  qryInfPed.SQL.Add('                       ');
  qryInfPed.SQL.Add('  (SELECT              ');
  qryInfPed.SQL.Add('     SUM(CTR_VALREC - IFNULL(CTR_VALJUR, 0) - IFNULL(CTR_VALCOB, 0) + IFNULL(CTR_VALDES, 0)) ');
  qryInfPed.SQL.Add('   FROM ');
  qryInfPed.SQL.Add('     CADREC ');
  qryInfPed.SQL.Add('   WHERE ');
  qryInfPed.SQL.Add('     CTR_NUMDUP = FGO_NUMDOC AND ');
  qryInfPed.SQL.Add('     CTR_ESPDOC = FGO_ESPDOC AND ');
  qryInfPed.SQL.Add('     CTR_CODEMP = FGO_CODEMP AND ');
  qryInfPed.SQL.Add('     CTR_CODCLI = FGO_CODCLI AND ');
  qryInfPed.SQL.Add('     CTR_DTAREC IS NOT NULL) AS VALREC, ');
  qryInfPed.SQL.Add('            ');
  qryInfPed.SQL.Add('  (SELECT   ');
  qryInfPed.SQL.Add('     SUM(IF(ADT_TIPLAN = "C", ADT_VALLAN, -ADT_VALLAN)) ');
  qryInfPed.SQL.Add('   FROM     ');
  qryInfPed.SQL.Add('     ADTCLI ');
  qryInfPed.SQL.Add('   WHERE    ');
  qryInfPed.SQL.Add('     ADT_NUMDOC = FGO_NUMDOC AND ');
  qryInfPed.SQL.Add('     ADT_ESPDOC = FGO_ESPDOC AND ');
  qryInfPed.SQL.Add('     ADT_CODEMP = FGO_CODEMP AND ');
  qryInfPed.SQL.Add('     ADT_CODCLI = FGO_CODCLI) AS VALADT, ');

  If (Not fCfgSis('NPDF11', VarBoolean)) And (Not fCfgSis('NPRF11', VarBoolean)) And
     (Not fCfgSis('NPLF11', VarBoolean))And (Not fCfgSis('LOCRET', VarBoolean)) Then
  Begin
    qryInfPed.SQL.Add('  "N" AS ORIF11,');
  End
  Else
  Begin
    qryInfPed.SQL.Add('  (SELECT ');
    qryInfPed.SQL.Add('     IF(COUNT(*) > 0, "S", "N") ');
    qryInfPed.SQL.Add('   FROM ');
    qryInfPed.SQL.Add('     FATDOR AS PEDORI ');
    qryInfPed.SQL.Add('   WHERE ');
    qryInfPed.SQL.Add('     PEDORI.FDO_NUMFAT = FATGOR.FGO_NUMDOC AND ');
    qryInfPed.SQL.Add('     PEDORI.FDO_TIPFAT = FATGOR.FGO_ESPDOC AND ');
    qryInfPed.SQL.Add('     PEDORI.FDO_EMPFAT = FATGOR.FGO_CODEMP) AS ORIF11, ');
  End;

  qryInfPed.SQL.Add('  (SELECT ');
  qryInfPed.SQL.Add('     GROUP_CONCAT(FPN_CODFPG) ');
  qryInfPed.SQL.Add('   FROM ');
  qryInfPed.SQL.Add('     FPGNEG ');
  qryInfPed.SQL.Add('   WHERE ');
  qryInfPed.SQL.Add('     FPGNEG.FPN_SEQFGO = FATGOR.AUTOINCREM) AS FPGNEG ');

  qryInfPed.SQL.Add('FROM     ');
  qryInfPed.SQL.Add('  FATGOR ');
  qryInfPed.SQL.Add('  INNER JOIN FATDOR ON FATDOR.FDO_SEQGER = FATGOR.AUTOINCREM ');
  qryInfPed.SQL.Add('  INNER JOIN EXTDOR ON EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM ');
  qryInfPed.SQL.Add('WHERE    ');
  qryInfPed.SQL.Add(' FGO_NUMDOC = :NUMDOC AND ');
  qryInfPed.SQL.Add(' FGO_ESPDOC = :ESPDOC AND ');
  qryInfPed.SQL.Add(' FGO_CODEMP = :CODEMP     ');

  qryInfPed.ParamByName('NUMDOC').AsString := strNumPed;
  qryInfPed.ParamByName('ESPDOC').AsString := strEspPed;
  qryInfPed.ParamByName('CODEMP').AsString := strEmpPed;

  qryInfPed.Open;

  Result := (qryInfPed.FieldByName('ORIF11').AsString = 'S'  ) And
            (qryInfPed.FieldByName('CODFPG').AsString = '009') And
            (qryInfPed.FieldByName('VALADT').AsFloat  > 0    ) And
            (Pos('013', qryInfPed.FieldByName('FPGNEG').AsString) > 0) And
            (Pos('015', qryInfPed.FieldByName('FPGNEG').AsString) > 0) ;

  FreeAndNil(qryInfPed);
end;

{***********************************************************}
{* GRAVA OU ATUALIZA O CLICON CASO SEJA CLIENTE CONSUMIDOR *}
{*******************************************************PE**}
function TFatVenda.fGravaAtualizaConsumidor: Boolean;
  Var
    strSQL : String;
    strNomeTabela : String;
    qryGen: TUniQuery;
    qryCli: TUniQuery;
    blnCliConExiste : Boolean;
    strCgcDoCadastro : String;

    function fProximoCodigo(const strCampoBusca : String): String;
    begin
      Result := fAtualizaProCod(strNomeTabela, strCampoBusca);
    end;

begin
  blnCliConExiste := fExisteConsumidor(fTiraCaracEspeciais(Self.strCliCgc));

  Result := True;

  strNomeTabela := 'CLICON';

  qryGen := fCriaQuery;

  Try
    If (Not blnCliConExiste) Then
    Begin
      If (Not fValidaCPFConsumidor) Then
      Begin
        strCgcDoCadastro := fCampoTabela('CLI_C_G_C_', 'CADCLI', ['CLI_CODCLI'], [Self.strCodCli]);
        blnCliConExiste := fExisteConsumidor(fTiraCaracEspeciais(strCgcDoCadastro));
      End;
    End;

    If blnCliConExiste Then
    Begin
      //ESSA LINHA FOI INCLUIDA POIS TODA BAIXA DE ENTREGA FUTURA DE CLIENTE CONSUMIDIDOR ELE ESTAVA APAGANDO E-MAIL
      If (blnBaiEntFut) And
         (fEmptyStr(Self.strCliEma)) And
         (fClienteConsumidor(fRetNomCliente(Self.strCodCli), True, True)) Then
      Begin
