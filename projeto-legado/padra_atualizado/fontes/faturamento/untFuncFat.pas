Function TFatVenda.fTemLoteVazio(cdsItens: TUniClientDataSet): Boolean;
  Var
    cdsTmp: TUniClientDataSet;
    intFormulacao: Integer;
    matrizFormulacao: TClassMatrizSaldosColorantes;
    stlColorantes : TStringList;
    strLisMsg: String;

    function fEhRetiraCaixa : Boolean;
    begin

      Result := False;

      If Not cdsTmp.FieldByName('ITE_ENTRET').AsString.Equals('R') Then
        Exit;

      If Not cdsTmp.FieldByName('ITE_LOCRET').AsString.Equals('C') Then
        Exit;

      Result := True;

    end;

    function fTravaLoteADefinir : Boolean;
    begin

      Result := False;

      //Quando usando rotina de expedicao e conferencia de Retira Caixa nao deve travar o lote
      If fUsaRotinaWMS(VS_strCodEmp) And fUsaRotinaExpedicaoConferenciaRetiraCaixa And (strOriF11 = 'S') And Assigned(objRegravarLotesPedidoWMS) Then
        Exit;

      If TPickingCheckOut.fWMSUtilizaPickingCheckOut And
         TPickingCheckOut.fDocumentoTemAlgumItemRetiraCaixa(Self.strNumOrc, Self.strEspOrc, Self.strEmpDoc) Then
        Exit;

      Result := True;

    end;

    function fDeveValidarLoteVazio():Boolean;
    begin
      Result := ((Pos(Self.strOpcDoc, OPC_LOTE) > 0) Or
                 (Self.strEspDoc = 'PD') Or
                 ((Self.strOpcDoc = 'CP') And
                  blnExpedi And
                  (fCfgSis('EVLVFE', VarString) = 'S') And
                  (Not fUsaRotinaWMS))) And
                (Not Self.blnConEqu);
    end;
Begin
  Result := False;

  if fDefinirLoteDevolucaoNaBaixa then
    Exit;

  cdsTmp := TUniClientDataSet.Create(Self);
  stlColorantes := TStringList.Create;
  Try
    pCloneDataSet(cdsTmp, cdsItens);

    matrizFormulacao := Nil;

    If fDeveValidarLoteVazio() Then
    With cdsTmp Do
    Begin
      First;
      While Not Eof Do
      Begin

        {Não realiza validações de lote para serviço Req: 94682}
        If (fEhItemServico(FieldByName('ITE_CODITE').AsString)) Then
        Begin
          Next;
          Continue;
        End;

        If (Self.fEhDevolucaoDemonstracaoNotaEspecial(FieldByName('ITE_DOCDEV').AsString, FieldByName('ITE_ESPDEV').AsString, FieldByName('ITE_EMPDEV').AsString)) Then
        Begin
          Next;
          Continue;
        End;

        If Self.fDefiniuLoteADefinirAutomaticamente(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString) Then
        Begin
          Next;
          Continue;
        End;

        If FieldByName('ITE_IDEPRO').AsString = 'NOR' Then
        Begin
          If (stlItensNaoTemLote.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
             (objCadLot.fItemSemNenhumLote(FieldByName('ITE_CODITE').AsString)) Then
          Begin
            stlItensNaoTemLote.Add(FieldByName('ITE_CODITE').AsString);
          End;

          If fEmptyStr(FieldByName('ITE_NUMLOT').AsString) And
            (stlItensNaoTemLote.IndexOf(FieldByName('ITE_CODITE').AsString) = -1) And
             objCadLot.fExisteLote(FieldByName('ITE_CODITE').AsString,
                                   IIF(blnEmpFat,
                                          FieldByName('ITE_EMPITE').AsString,
                                            fEmpresaSaldoMatriz_CD)) And
             (FieldByName('ITE_PROACA').AsInteger <> 1) Then
          Begin
            fMensagem('ATENÇÃO!', 'Informe o ' + objCadLot.strTitLab + ' para o produto ' + FieldByName('ITE_CODITE').AsString + ' !', ['&Ok']);
            Result := True;
            Break;
          End;
        End
        Else
        Begin
          If Assigned(dicFormulas.RetornaObjeto(FieldByName('AUTOINCREM').AsString)) Then
            matrizFormulacao := TClassMatrizSaldosColorantes(dicFormulas.RetornaObjeto(FieldByName('AUTOINCREM').AsString));

          If Assigned(matrizFormulacao) Then
          Begin
            For intFormulacao := 0 To matrizFormulacao.Count -1 Do
            Begin
              If (stlItensNaoTemLote.IndexOf(matrizFormulacao[intFormulacao].strCodIte) = -1) And
                 (objCadLot.fItemSemNenhumLote(matrizFormulacao[intFormulacao].strCodIte)) Then
              Begin
                stlItensNaoTemLote.Add(matrizFormulacao[intFormulacao].strCodIte);
              End;

              If (fEmptyStr(FieldByName('ITE_NUMLOT').AsString)) And
                 (fPodeTerInformadoLoteParaTinta(FieldByName('ITE_IDEPRO').AsString, IIF(blnEmpFat,
                                                                                         FieldByName('ITE_EMPITE').AsString,
                                                                                         fEmpresaSaldoMatriz_CD))) And
                 (stlItensNaoTemLote.IndexOf(matrizFormulacao[intFormulacao].strCodIte) = -1) And
                 (objCadLot.fExisteLote(matrizFormulacao[intFormulacao].strCodIte,
                                            IIF(blnEmpFat,
                                                 FieldByName('ITE_EMPITE').AsString,
                                                   fEmpresaSaldoMatriz_CD))) Then
              Begin
                fMensagem('ATENÇÃO!', 'Informe o ' + objCadLot.strTitLab + ' para o produto ' + matrizFormulacao[intFormulacao].strCodIte + ' !', ['&Ok']);
                Result := True;
                Break;
              End;
            End;
          End;
        End;

        If (strOpcDoc <> 'DV') Or fEmpresaParaFaturamentoUsaWMS(IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD))  Then
        Begin
          If FieldByName('ITE_IDEPRO').AsString = 'NOR' Then
          Begin
            If (Not fEmptyStr(FieldByName('ITE_NUMLOT').AsString)) And
               (Not objCadLot.fExisteLote(FieldByName('ITE_CODITE').AsString,
                                          IIF(blnEmpFat,
                                               FieldByName('ITE_EMPITE').AsString,
                                                 fEmpresaSaldoMatriz_CD))) Then
            Begin
              If Not (fCfgSis('DEVIGN', varBoolean) And
                      fUsaRotinaWMS(strEmpDocDev)) Then
              Begin
                fMensagem('ATENÇÃO!', 'O ' + objCadLot.strTitLab + ' "' + FieldByName('ITE_NUMLOT').AsString + '" ' +
                                      'informado no produto ' + FieldByName('ITE_CODITE').AsString + ' ' +
                                      'não existe. Favor verificar este produto!', ['&Ok']);
                Result := True;
                Break;
              End;
            End;
          End
          Else
          Begin
            If Assigned(dicFormulas.RetornaObjeto(FieldByName('AUTOINCREM').AsString)) Then
              matrizFormulacao := TClassMatrizSaldosColorantes(dicFormulas.RetornaObjeto(FieldByName('AUTOINCREM').AsString));

            If Assigned(matrizFormulacao) Then
            Begin
              For intFormulacao := 0 To matrizFormulacao.Count -1 Do
              Begin
                If (Not fEmptyStr(FieldByName('ITE_NUMLOT').AsString)) And
                   (Not objCadLot.fExisteLote(matrizFormulacao[intFormulacao].strCodIte, IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD))) And
                   (IIF(fCfgSis('LOTBAS', varBoolean), matrizFormulacao[intFormulacao].strBasCol = BASE_IMOBILIARIA, True)) Then
                Begin
                  fMensagem('ATENÇÃO!', 'O ' + objCadLot.strTitLab + ' "' + FieldByName('ITE_NUMLOT').AsString + '" ' +
                                        'informado no produto ' + matrizFormulacao[intFormulacao].strCodIte + ' ' +
                                        'não existe. Favor verificar este produto!', ['&Ok']);
                  Result := True;
                  Break;
                End;
              End;
            End;
          End;
        End;

        If (Not fEhEmissaoDocumentoWMS) And
           (Not fEmpresaParaFaturamentoUsaWMS(FieldByName('ITE_EMPITE').AsString)) And
           (Not MatchStr(strOpcDoc, ['DV','DD','PR'])) And
           (FieldByName('ITE_ENTFUT').AsString <> 'S') And
           (Not fUtilizaDefinicaoLoteSeparacaoSemWMS(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString, strOpcDoc, strOriF11)) And
           (SameText(FieldByName('ITE_NUMLOT').AsString,'A DEFINIR')) Then
        Begin
          If fTravaLoteADefinir Then
          Begin
            If strOpcDoc = 'OF' Then
              fMensagem('ATENÇÃO!', objCadLot.strTitLab + ' "A DEFINIR" não pode ser utilizado em outras saidas, informe o ' + objCadLot.strTitLab +' do ' + #13#10 +
                                    'Produto: ' + FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' !', ['&Ok'])
            Else
              fMensagem('ATENÇÃO!', objCadLot.strTitLab + ' "A DEFINIR" somente pode ser utilizado com entrega Futura!' + #13#10 +
                                    'Produto: ' + FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' !', ['&Ok']);
            Result := True;
            Break;
          End;
        End;

        If (fEhEmissaoDocumentoWMS And fConsiderarLoteWMS(FieldByName('ITE_EMPITE').AsString)) Or
           fEmpresaParaFaturamentoUsaWMS(FieldByName('ITE_EMPITE').AsString) Then
        Begin
          If fEmptyStr(FieldByName('ITE_NUMLOT').AsString) And (FieldByName('ITE_PROACA').AsInteger <> 1) Then
          Begin
            fMensagem('ATENÇÃO!', 'Somente é permitido vender produtos que possuem Lote cadastrado. ' +
                                  'Verifique o Cadastro de Lotes para o produto ' +
                                  FieldByName('ITE_CODITE').AsString + ' - ' +  FieldByName('ITE_DESITE').AsString + ' !', ['&Ok']);
            Result := True;
            Break;
          End

          Else If (FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
          Begin
            If (not blnOriF3) And (FieldByName('ITE_PROACA').AsInteger <> 1) Then
            Begin
              If Not objCadLot.fExisteLote(FieldByName('ITE_CODITE').AsString, IIF(blnEmpFat,
                                                                                   FieldByName('ITE_EMPITE').AsString,
                                                                                   fEmpresaSaldoMatriz_CD),
                                                                                   'A DEFINIR', False) Then
              Begin
                pMensagemOk('Produto ' + FieldByName('ITE_CODITE').AsString + '-' +
                  FieldByName('ITE_DESITE').AsString + ' não possui o Lote A DEFINIR cadastrado!');
                Result := True;
                break;
              End

              Else If (FieldByName('ITE_NUMLOT').AsString <> 'A DEFINIR') And (FieldByName('ITE_PEGOU_').AsString <> 'S') Then
              Begin

                If TPickingCheckOut.fWMSUtilizaPickingCheckOut And fEhRetiraCaixa Then
                Begin
                  Next;
                  Continue;
                End;

                If fCfgSis('WMSLOT', varBoolean) Then
                Begin
                  If Not objCadLot.fItemTeraLoteDefinidoPeloVendedor(FieldByName('ITE_CODITE').AsString) Then
                  Begin
                    fMensagem('ATENÇÃO!', 'Somente é permitido realizar venda com o Lote A DEFINIR. Verifique o Lote ' +
                                          'do produto ' + FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' !', ['&Ok']);
                    Result := True;
                    Break;
                  End;
                End
                Else
                Begin
                  If Not objCadLot.fItemTeraLoteDefinidoPeloVendedor(FieldByName('ITE_CODITE').AsString, IIF(fEmptyStr(FieldByName('ITE_EMPITE').AsString), VS_strCodEmp,FieldByName('ITE_EMPITE').AsString), True) Then
                  Begin
                    fMensagem('ATENÇÃO!', 'Somente é permitido realizar venda com o Lote A DEFINIR. Verifique o Lote ' +
                                          'do produto ' + FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' !', ['&Ok']);
                    Result := True;
                    Break;
                  End;
                End;

              End;
            End;
          End
          Else
          Begin
            If Not objCadLot.fExisteLotePrincipalTintaMaquina(FieldByName('ITE_CODITE').AsString, IIF(blnEmpFat,
                                                                                                      FieldByName('ITE_EMPITE').AsString,
                                                                                                      fEmpresaSaldoMatriz_CD)) Then
            Begin
              pMensagemOk('Produto ' + FieldByName('ITE_CODITE').AsString + '-' +
                FieldByName('ITE_DESITE').AsString + ' não possui o Lote "Principal para tinta de máquina" cadastrado!');
              Result := True;
              break;
            End
            Else If (FieldByName('ITE_NUMLOT').AsString <> objCadLot.fRetLotePrincipalTintaMaquina(FieldByName('ITE_CODITE').AsString,
                                                                                                   IIF(blnEmpFat,
                                                                                                       FieldByName('ITE_EMPITE').AsString,
                                                                                                       fEmpresaSaldoMatriz_CD))) And (not fCfgSis('TINWMS', varBoolean, IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD) )) Then
            Begin
              fMensagem('ATENÇÃO!', 'Somente é permitido realizar venda com o Lote "Principal para tinta de máquina". Verifique o Lote ' +
                                    'do produto ' + FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + ' !', ['&Ok']);
              Result := True;
              Break;
            End;
          End;
        End
        Else If fCfgSis('TMQLOT', varBoolean, IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD)) And (FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
        Begin
          If Assigned(matrizFormulacao) Then
          Begin
            If fEmptyStr(FieldByName('ITE_NUMLOT').AsString) Then
            Begin
              fMensagem('ATENÇÃO!', 'Somente é permitido vender uma tinta que possua '+Self.objCadLot.strDescri+' cadastrado. '+
                                    'Verifique o '+Self.objCadLot.strTitCad+' para o produto Base ' +
                                    FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString + '!', ['&Ok']);
              Result := True;
              Break;
            End;

            If Not Result Then
            Begin
              If Not fValidaLoteEmbalagemColorantes(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_IDEPRO').AsString,
                                                    FieldByName('ITE_ITEEMB').AsString, IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD),
                                                    matrizFormulacao, Self.objCadLot, stlColorantes) Then
              Begin
                pMensagemSonora('Para vender uma tinta é necessário que todos os Colorantes/Embalagens possuam o ' +
                                '"Lote principal para Tinta Máquina" "'+FieldByName('ITE_NUMLOT').AsString+'" informado corretamente no '+Self.objCadLot.strTitCad+'. Favor verificar o '+Self.objCadLot.strTitCad+' dos produtos: ' +
                                AnsiReplaceStr(stlColorantes.CommaText, ',', ', '));
                Result := True;
                Break;
              End;
            End;

            If Not Result Then
            Begin
              strLisMsg := ''; 
              
              For intFormulacao := 0 To matrizFormulacao.Count -1 Do
              Begin
                If (FieldByName('ITE_NUMLOT').AsString <> objCadLot.fRetLotePrincipalTintaMaquina(matrizFormulacao[intFormulacao].strCodIte, IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD))) Then
                Begin
                  pIncrementaListaStr(matrizFormulacao[intFormulacao].strCodIte+'-'+
                                      objCadLot.fRetLotePrincipalTintaMaquina(matrizFormulacao[intFormulacao].strCodIte, IIF(blnEmpFat, FieldByName('ITE_EMPITE').AsString, fEmpresaSaldoMatriz_CD)), strLisMsg);
                End;
              End;

              If Not strLisMsg.IsEmpty Then
              Begin
                fMensagem('ATENÇÃO!', 'Os itens de tinta precisam ter o mesmo '+Self.objCadLot.strDescri+' com "Lotes principal para Tinta Máquina" iguais entre o item base e os colorantes: '+#10#13+
                                      'Item Base-"Lotes principal para Tinta Máquina": ' + FieldByName('ITE_CODITE').AsString + '-' + FieldByName('ITE_NUMLOT').AsString + #10#13+
                                      'Itens Colorantes-"Lotes principal para Tinta Máquina": ' + strLisMsg+'!', ['&Ok']);
                Result := True;
                Break;
              End;
            End;
          End;
        End;

        Next;
      End;

    End;
  Finally
    FreeAndNil(cdsTmp);
    FreeAndNil(stlColorantes);
  End;
End;

function TFatVenda.fSomenteItensEntregaFutura(Itens: TMatrizFechamento): Boolean;
  Var
    objFilterMat: TFilterMatrizItens;
    objFiltersItem: TFiltersItem;
begin
  objFilterMat := TFilterMatrizItens.Create(Itens);
  objFiltersItem := TFiltersItem.Create;

  With objFilterMat, objFiltersItem Do
  Begin
    pDesfazerFiltros;
    fFiltrar(fFiltraEntregaFutura);
    Result := (Length(MatrizItens) > 0) And
              (Length(MatrizItens) = Length(Itens));
  End;

  objFilterMat.Destroy;
  objFiltersItem.Destroy;
end;

function TFatVenda.fHaveraDesmembramentoVenda: Boolean;
  Var
    Itens, ItensCorte: TMatrizFechamento;
begin
  pPreencheMatrizFechamento(Itens, ItensCorte);

  With TDesmembrarMatrizItens.Create(Itens, FRecSer,
    fEntregaImediataPorGrupoProdutos, fEntregaImediataPorDataDeEntrega,
    fEntregaImediataPorDataDeEntregaComRotaPorPedido,
    False, blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC) Do
  Begin
    blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    pDesmembrarMatrizItens;
    Result := (Length(MatrizesItens) > 1);
    Destroy;
  End;

end;

function TFatVenda.fHaveraDesmembramentoVenda(Itens: TMatrizFechamento): Boolean;
begin

  With TDesmembrarMatrizItens.Create(Itens, FRecSer,
    fEntregaImediataPorGrupoProdutos, fEntregaImediataPorDataDeEntrega,
    fEntregaImediataPorDataDeEntregaComRotaPorPedido,
    False, blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC) Do
  Begin
    blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    pDesmembrarMatrizItens;
    Result := (Length(MatrizesItens) > 1);
    Destroy;
  End;

end;

function TFatVenda.fHaveraDesmembramentoVenda(Itens: TMatrizFechamento; out AMatrizesFechamento : TMatrizesFechamento): Boolean;
  Var
    LDesmembrarMatrizItens : TDesmembrarMatrizItens;
begin
  LDesmembrarMatrizItens := TDesmembrarMatrizItens.Create(Itens, FRecSer,
    fEntregaImediataPorGrupoProdutos, fEntregaImediataPorDataDeEntrega,
    fEntregaImediataPorDataDeEntregaComRotaPorPedido,
    False, blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC);
  Try
    LDesmembrarMatrizItens.blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    LDesmembrarMatrizItens.pDesmembrarMatrizItens;
    AMatrizesFechamento := LDesmembrarMatrizItens.MatrizesItens;
    Result := (Length(LDesmembrarMatrizItens.MatrizesItens) > 1);
  Finally
    FreeAndNil(LDesmembrarMatrizItens);
  End;
end;

function TFatVenda.fHaveraDesmembramentoPedidoPorDataDeEntrega: Boolean;
  Var
    Itens, ItensCorte: TMatrizFechamento;
begin
  pPreencheMatrizFechamento(Itens, ItensCorte);

  With TDesmembrarMatrizItens.Create(Itens, FRecSer, False, True, True, False,
         blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC) Do
