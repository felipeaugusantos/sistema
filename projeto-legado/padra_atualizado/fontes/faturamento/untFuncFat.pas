function TFatVenda.fRetornaNumeroGuiche: String;
Var
  intNumGui : Integer;
  intQtdGui : Integer;
  intQtdTen : Integer;
  blnValido : Boolean;
Const
  QUANTIDADE_TENTATIVAS = 3;

  procedure pVerificaFinalEReiniciaFilaDeGuiches;
  begin
    If (intNumGui > intQtdGui) Or (intNumGui <= 0) Then
      intNumGui := 1;
  end;

  procedure pProximoGuiche;
  begin
    Inc(intNumGui);
    pVerificaFinalEReiniciaFilaDeGuiches;
  end;

begin

  If fCfgSis('USAGUI', varBoolean) Then
  Begin

    If (Not fEmptyStr(strNumGui)) Then
      Exit(strNumGui);

    intNumGui := fCfgSis('NUMGUI', varInteger);
    intQtdGui := fCfgSis('QTDGUI', varInteger);

    pVerificaFinalEReiniciaFilaDeGuiches;

    Result := FormatFloat('000', intNumGui);

    pProximoGuiche;
    fAtuCfgSis('NUMGUI', IntToStr(intNumGui));

  End
  Else If fCfgSis('USGURE', varBoolean) Then
  Begin

    If (Not fEmptyStr(strNumGui)) Then
      Exit(strNumGui);

    intNumGui := IIF(fTemItensEntrega(), fCfgSisL('NRGUEN', varInteger), fCfgSisL('NRGURE', varInteger));
    intQtdGui := IIF(fTemItensEntrega(),  fCfgSis('GUIENT', varInteger), fCfgSis('GUIRET', varInteger));

    pVerificaFinalEReiniciaFilaDeGuiches;

    If Not (fCfgSis('GUISEQ', varBoolean)) Then
    Begin
      for intQtdTen := 1 to QUANTIDADE_TENTATIVAS do
      begin
        blnValido := Not fNumeroDeGuicheJahUtilizado(intNumGui, IIF(fTemItensEntrega(), 'E', 'R'));
        If blnValido Then
          Break
        Else
          pProximoGuiche;
      end;
      If Not blnValido Then
        Raise Exception.Create('Não foi possível identificar um guichê disponível!');
    End;

    Result := FormatFloat('000', intNumGui);
    pProximoGuiche;

    If (fTemItensEntrega()) Then
      fAtuCfgSis('NRGUEN', IntToStr(intNumGui))
    Else
      fAtuCfgSis('NRGURE', IntToStr(intNumGui));

  End;

End;

