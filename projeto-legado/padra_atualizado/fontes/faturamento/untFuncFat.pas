    If (recModOri.fltValCqV <> 0) Then Result := Result + 'Cheque à Vista: '     + FloatToStrf(recModOri.fltValCqV, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltValDin <> 0) Then Result := Result + 'Dinheiro: '           + FloatToStrf(recModOri.fltValDin, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltValCar <> 0) Then Result := Result + 'Cartão: '             + FloatToStrf(recModOri.fltValCar, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltValOrd <> 0) Then Result := Result + 'Ordem de Pagamento: ' + FloatToStrf(recModOri.fltValOrd, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltFatura <> 0) Then Result := Result + 'Faturado: '           + FloatToStrf(recModOri.fltFatura, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltValCre <> 0) Then Result := Result + 'Crédito: '            + FloatToStrf(recModOri.fltValCre, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltValVle <> 0) Then Result := Result + 'Vale: '               + FloatToStrf(recModOri.fltValVle, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltValFin <> 0) Then Result := Result + 'Financiamento: '      + FloatToStrf(recModOri.fltValFin, ffFixed, 12, 2) + Chr(13);
    If (recModOri.fltVlARec <> 0) Then Result := Result + 'A Receber: '          + FloatToStrf(recModOri.fltVlARec, ffFixed, 12, 2) + Chr(13);
  end;

  function fMontaArrDuplicatasProporcionalAoOriginal(fltImpostos: Double): Boolean;
    Var
      fltTotDupOri: Double;
      intDuplic: Integer;
      intDupDif: Integer;
      fltCentavTot: Double;
      fltCentavPar: Double;
      fltTotCadRecSemImp: Double;
      fltTotDupOriSemImp: Double;
      fltDupDif: Double;

      function fParcelaQuePodeReceberDiferenca: Boolean;
      begin
        Result := (intSeqDupBaiAdtCli <> intDuplic) And (intSeqDupBaiUtiCred <> intDuplic);
      end;

      function fTemImpostoPrimeiraParcela():Boolean;
      begin
        Result := (fltImpostos > 0) And (Self.blnImpostosNaPrimeiraParcela);
      end;

  begin
    Result := True;

    {**************************************************************}
    {* CALCULA O VALOR TOTAL DAS DUPLICATAS DO DOCUMENTO ORIGINAL *}
    {***********************************************************JC*}
    fltTotDupOri := fGetTotalDuplicatas(arrDuplicOri, dupTodas);

    fltTotDupOriSemImp := 0;
    fltTotCadRecSemImp := 0;
    If fTemImpostoPrimeiraParcela() Then
    Begin
      fltTotDupOriSemImp := fltTotDupOri - fltImpostos;
      fltTotCadRecSemImp := fltTotCadRec - fltImpostos;
    End;

    {******************************************************************************}
    {* CALCULA O VALOR DAS DUPLICATAS PROPORCIONALMENTE AOS VENCIMENTOS ORIGINAIS *}
    {***************************************************************************JC*}
    intDupDif    := -1;
    fltCentavTot := 0;

    For intDuplic := Low(arrDuplicata) To High(arrDuplicata) Do
    Begin
      arrDuplicata[intDuplic] := arrDuplicOri[intDuplic];

      If Not fEmptyStr(arrDuplicata[intDuplic].dtaDtaVen) Then
      Begin
        If (fParcelaQuePodeReceberDiferenca) Then
          If (intDupDif = -1) Then
            intDupDif := intDuplic;

        fltCentavPar := 0;

        If fFormataFloat(fltTotDupOri, 2) > 0.00 Then
        Begin
          If fTemImpostoPrimeiraParcela And blnUltimoDocumento Then
          Begin
            arrDuplicata[intDuplic].curValor := fFormataFloat(fltTotCadRecSemImp * (arrDuplicOri[intDuplic].curValor / fltTotDupOriSemImp), 2);

            If (intDupDif = intDuplic) then
              arrDuplicata[intDuplic].curValor := fFormataFloat(arrDuplicata[intDuplic].curValor + fltImpostos, 2);
          End
          Else
          Begin
            If blnUltimoDocumento Then
              arrDuplicata[intDuplic].curValor := fFormataFloat(arrDuplicOri[intDuplic].curValor - arrDuplicTot[intDuplic].curValor, 2)
            Else
              arrDuplicata[intDuplic].curValor := fFormataFloat(Self.fltTotCadRec * (arrDuplicOri[intDuplic].curValor / fltTotDupOri), 2);
          End;

          If Self.FFoiGravacaoPorDesmembramento And fCfgSis('DUPRED', varBoolean) Then
          Begin
            If (fParcelaQuePodeReceberDiferenca) And (intDuplic <> intDupDif) Then
            Begin
              fltCentavPar := Frac(arrDuplicata[intDuplic].curValor);
              fltCentavTot := fltCentavTot + fltCentavPar;
              arrDuplicata[intDuplic].curValor := Int(arrDuplicata[intDuplic].curValor);
            End;
          End;
        End
        Else
          arrDuplicata[intDuplic].curValor := 0;

        arrDuplicTot[intDuplic].curValor := arrDuplicTot[intDuplic].curValor + arrDuplicata[intDuplic].curValor + fltCentavPar;
      End;
    End;

    If intDupDif = -1 Then
      intDupDif := 0;

    If fltCentavTot <> 0 Then
    Begin
      arrDuplicata[intDupDif].curValor := arrDuplicata[intDupDif].curValor + fltCentavTot;
      arrDuplicata[intDupDif].curArred := fltCentavTot;
    End;

    {******************************************************************}
    {* ACERTA A DIFERENCA NA PRIMEIRA DUPLICATA (CASO HAJA DIFERENCA) *}
    {***************************************************************JC*}
    fltDupDif := fFormataFloat(Self.fltTotCadRec - fGetTotalDuplicatas(arrDuplicata, dupTodas), 2);
    If fltDupDif <> 0.00 Then
    Begin
      arrDuplicata[intDupDif].curValor := arrDuplicata[intDupDif].curValor + fltDupDif;
      arrDuplicata[intDupDif].curArred := arrDuplicata[intDupDif].curArred + fltDupDif;
    End;

    {**************************************************************************}
    {* PARA TRATAR SITUACOES ONDE O VALOR DA PARCELA É MUITO PEQUENO EX: 0,01 *}
    {***********************************************************************JC*}
    If (arrDuplicata[0].curValor = 0) And ((Not blnClifil) Or (blnclifil And blnGravaCtrTe)) And (Not fPossuiSomenteBrinde()) Then
    Begin
      Result := False;
      fRollBack;
      pMensagemSonora('O pedido/orçamento está sendo desmembrado em mais de um documento.' + Chr(13) +
                      'O valor calculado para o contas a receber de um documento, ficou zerado.' + Chr(13) +
                      'Isso acontece porque foi informado um valor muito baixo nas modalidades.' + Chr(13) +
       	              'Favor redistribuir os valores das modalidades.' + Chr(13) +
                      'Modalidade(s) Informadas: ' + Chr(13) +
                      fGetModalidades);
    End;

    {************************************************************************************}
    {* CASO ESTEJA UTILIZANDO CONTAS A RECEBER INTELIGENTE PARA MEIA NOTA E NOTA NORMAL *}
    {********************************************************************************JC**}
    If Assigned(objAcertaVencimentos) Then
    With objAcertaVencimentos Do
    Begin
      Case StatusGravacaoVenda Of
        stgSimulandoGravacao : pAdicionarInformacoesVenda(intIndDoc, FEspDoc, objDesmembrar.MatrizInfItens[intIndDoc], arrDuplicata, fltTotGer, arrMatItens);
        stgRealizandoGravacao: pCarregarNovosVencimentos(intIndDoc, FConPag, arrDuplicata);
      End;
    End;

    {*****************************************************************************************}
    {* COPIA DAS DUPLICATAS UTILIZADA PARA RESTAURAR A MESMA EM ALGUNS PONTOS DO FATURAMENTO *}
    {*************************************************************************************JC**}
    For intDuplic := Low(arrDuplicata) To High(arrDuplicata) Do
      arrDuplicCop[intDuplic] := arrDuplicata[intDuplic];
  end;

