  function fAtualizaClienteADTCLI_MOVCAR : Boolean;
  var
    qryAux    : TUniQuery;
  begin

    qryAux := fCriaQuery(Self);

    try

      Result := False;

      {ADTCLI - Adiantamento(s)}
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('UPDATE');
      qryAux.SQL.Add('  ADTCLI');
      qryAux.SQL.Add('SET');
      qryAux.SQL.Add('  ADT_CODCLI = ' + QuotedStr(strCodCli));
      qryAux.SQL.Add('WHERE');
      qryAux.SQL.Add('  ADT_NUMDOC = ' + QuotedStr(strNumDoc) + ' AND ');
      qryAux.SQL.Add('  ADT_ESPDOC = ' + QuotedStr(strEspDoc) + ' AND ');
      qryAux.SQL.Add('  ADT_CODEMP = ' + QuotedStr(strEmpDoc));
      qryAux.ExecSQL;

      {MOVCAR - Cartões}
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('UPDATE');
      qryAux.SQL.Add('  MOVCAR');
      qryAux.SQL.Add('SET');
      qryAux.SQL.Add('  MCA_CODCLI = ' + QuotedStr(strCodCli));
      qryAux.SQL.Add('WHERE');
      qryAux.SQL.Add('  MCA_NUMPOK = ' + QuotedStr(strNumPok));
      qryAux.ExecSQL;

      Result := True;

    finally
      FreeAndNil(qryAux);
    end;

