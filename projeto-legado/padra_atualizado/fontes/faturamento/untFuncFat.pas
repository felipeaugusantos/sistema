function fPedeProfissional(fatVenda: TFatVenda): Boolean;
begin
  Result := False;

  If fCfgSis('TCOPRO') = '4' Then
  Begin
    Result := True;
    Exit;
  End;

  If (fCfgSis('NROPRO') = '2') And fEmptyStr(fCfgSis('PROFIS')) Then
  Begin
    fatVenda.strCodDiv := '';
    Result := True;
    Exit
  End;

  If (Pos(fatVenda.strOpcDoc, 'NC_TE_CF_DV_PR_CI_CT_VS_EP_UC_DD_CR_NP_') > 0) Then
  Begin
    Result := True;
    Exit;
  End;

  If fIsentarDigitacaoDeProfissionalQuandoPedidoOrcamento(fatVenda.strOpcDoc, fatVenda.strEspDoc) Then
  Begin
    Result := True;
    Exit;
  End;

  fatVenda.fltVlrComDig := 0;

  {*****************************************}
  {* SELECIONA O PROFISSIONAL              *}
  {**************************************MV*}
  If (fCfgSis('NROPRO') = '2') Then
  Begin
    Try
      pCriarFormularios(TfrmFatDigProfissional, frmFatDigProfissional);
      frmFatDigProfissional.objVenda := fatVenda;
      frmFatDigProfissional.ShowModal;
      Result := frmFatDigProfissional.blnConfirma;

      If (Result) And (frmFatDigProfissional.fraDigProfisssional.edtComissao.Visible) Then
        fatVenda.fltVlrComDig := fStrToFloat(frmFatDigProfissional.fraDigProfisssional.edtComissao.Text, -1);
    Finally
      pFreeAndNil(frmFatDigProfissional);
    End;
    Exit;
  End;

  If (fCfgSis('NROPRO') = '3') Then
  Begin
    pCriarFormularios(TfrmFatDigProfissionalVarios, frmFatDigProfissionalVarios);
    Try
      frmFatDigProfissionalVarios.objVenda := fatVenda;
      frmFatDigProfissionalVarios.ShowModal;
      Result := frmFatDigProfissionalVarios.blnConfirma;

      If (Result) Then
      Begin

        If (frmFatDigProfissionalVarios.fraDigProfisssionalVarios.edtComissao.Visible) Then
        Begin

          If Assigned(fatVenda.cdsProfiss) And (Not fatVenda.cdsProfiss.IsEmpty) Then
          Begin

            fatVenda.cdsProfiss.First;
            While Not fatVenda.cdsProfiss.Eof Do
            Begin
              fatVenda.fltVlrComDig := fatVenda.fltVlrComDig + fatVenda.cdsProfiss.FieldByName('COM_VRCOMI').AsFloat;
              fatVenda.cdsProfiss.Next;
            End;

            If (fatVenda.fltVlrComDig < 0) Then
              fatVenda.fltVlrComDig := 0;

          End;
        End;
      End;
    Finally
      pFreeAndNil(frmFatDigProfissionalVarios);
    End;

    Exit;
  End;
end;

function fIsentarDigitacaoDeProfissionalQuandoPedidoOrcamento(strOpcDoc, strEspDoc: String): Boolean;
begin
  Result :=  (fCfgSis('ALTCOM', varBoolean)) And
             ((Pos(strEspDoc, 'PD_OR_') > 0) Or
             (Pos(strOpcDoc, 'PD_OR_') > 0));
end;

function fTotalCreditosProfissional(strCodigo: String; blnProfiss: Boolean = False; intOpcCom: Integer = 0): Double;
  Var
    qryTmp: TUniQuery;
Begin
  Result := 0;
  qryTmp := fCriaQuery(Nil);
  Try
    qryTmp.SQL.Add(' SELECT                                                        ');
    qryTmp.SQL.Add('   SUM(IF(COM_CREDEB = "C", COM_VRCOMI, -COM_VRCOMI)) AS TOTAL ');
    qryTmp.SQL.Add('   FROM COMPRO                                                 ');
    qryTmp.SQL.Add('  WHERE COM_DTABAI IS NULL      ');
    qryTmp.SQL.Add('    AND COM_CODPRO = :CODPRO    ');

    If (intOpcCom <> 0) Then
    Begin
      If (intOpcCom = 1) Then
        qryTmp.SQL.Add(' AND IFNULL(COM_TCOPRO, "1") = "1" ')  // VALOR
      Else If (intOpcCom = 2) Then
        qryTmp.SQL.Add(' AND IFNULL(COM_TCOPRO, "3") = "3" '); // PONTOS
    End;

    If (Not blnProfiss) Then
      qryTmp.ParamByName('CODPRO').AsString := fCampoTabela('DIV_CODDIV', 'CADDIV', ['DIV_CODCLI'], [strCodigo])
    Else
      qryTmp.ParamByName('CODPRO').AsString := strCodigo;

    qryTmp.Open;
    Result := qryTmp.FieldByName('TOTAL').AsFloat;
    qryTmp.Close;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[untFuncFat.fProfissionalTemCredito]');
  End;
  FreeAndNil(qryTmp);
End;

function fProfissionalTemCredito(strCodCli: String; fltNovoDebito: Double): Boolean;
Begin
  Result := (fTotalCreditosProfissional(strCodCli) - fltNovoDebito) >= 0;
End;

Function TfatVenda.fDigCartoes(Var arrValCartoes: TCartoesResumoCaixaArray;
                                   fltTotMod: Double;
                                   strCodCar: String = '';
                                   strCodFnc: String = '';
                             const AintQuantidadeParcelas: Integer = 0): Boolean;
  Var
    intContador: Integer;
    frmFatFormasPagamento : TfrmFatFormasPagamento;
    LintQuantidadeParcela : Integer;
    LstrCodigoCartao      : String;
Begin {fDigCartoes}
  Result := True;

  Try
    pCriarFormularios(TfrmFatFormasPagamento,frmFatFormasPagamento);
    frmFatFormasPagamento.strCodOpe := fGetOperadorDaBaixa;//Operador;
    frmFatFormasPagamento.strCodCnd := strCodCnd;
    frmFatFormasPagamento.strMskCnd := strConPag;
    frmFatFormasPagamento.fltValTot := fltTotMod;
    frmFatFormasPagamento.cdsChqPre := cdsChequePre;
    frmFatFormasPagamento.cdsChqVis := cdsChequeVis;
    frmFatFormasPagamento.blnTroCar := fEmptyStr(strCodFnc) And fCfgSis('TROCAR', varBoolean); // Troco para cartao;

    if fInstanciaObjTefRecebimentoVendaServico(FobjTefRecebimento) then
       FobjTefRecebimento := TTefRecebimentoVazio.Create;

    if Assigned(FobjTefRecebimento) then //'TEFVN_'
    Begin
      frmFatFormasPagamento.objTefRecebimento            := FobjTefRecebimento;
      frmFatFormasPagamento.strSessaoTef                 := FSessaoTef;
      frmFatFormasPagamento.blnExecutandoPeloFaturamento := True;
    End;

    LintQuantidadeParcela := 0;
    LstrCodigoCartao      := EmptyStr;
    if fCfgSis('SOLCAR', varBoolean) then
    begin
      LintQuantidadeParcela := AintQuantidadeParcelas;
      LstrCodigoCartao      := strCodCar;
    end;

    Result := frmFatFormasPagamento.fDigitacaoCartoes(fltTotMod,
                   frmFatFormasPagamento.arrCartoes, LstrCodigoCartao,
                   strCodFnc, LintQuantidadeParcela);

    If Result Then
    Begin
      If Not fEmptyStr(strCodFnc) Then
        fltValFin := fltTotMod
      Else
        fltValCar := fltTotMod;

      SetLength(arrValCartoes,Length(frmFatFormasPagamento.arrCartoes));

      For intContador := 0 To Length(frmFatFormasPagamento.arrCartoes)-1 Do
        arrValCartoes[intContador] := frmFatFormasPagamento.arrCartoes[intContador];

      optTrocoCar      := frmFatFormasPagamento.optTroco;
      fltValorTrocoCar := frmFatFormasPagamento.fltValorTroco;

      If Not fEmptyStr(strCodFnc) Then
        fltValFin := fltTotMod
      Else
        fltValCar := fltTotMod;

      If optTrocoCar = otTroco Then
      Begin
        fltValCar := fltValCar + fltValorTrocoCar;
      End;

      if Length(frmFatFormasPagamento.arrCartoes) <> 0 then
        FstrArquivoTef := arrValCartoes[Length(arrValCartoes)-1].strArqTef;

    End Else
    Begin
      optTrocoCar      := otNada;
      fltValorTrocoCar := 0.0;
      SetLength(arrValCartoes,0);
    End;

  Except
    On E: Exception Do
    Begin
      SetLength(arrValCartoes,0);
      pMensagensErro(E.Message, '[TfatVenda.fDigCartoes]');
    End;
  End;

  pFreeAndNil(frmFatFormasPagamento);

End; {fDigCartoes}

