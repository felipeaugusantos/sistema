    strSQL := strSQL + '                  AND NPS_CODEMP = G.GER_CODEMP ';
    strSQL := strSQL + '                  AND NPS_CODCLI = G.GER_CODCLI ';
    strSQL := strSQL + '                  AND NPS_SERIE_ = G.GER_SERIE_ ';

    strSQL := strSQL + '  INNER JOIN CADITE ON ITE_CODITE = DET_CODITE ';

    {*************************************}
    {* FILTRA AS NOTAS FISCAIS COM FATOR *}
    { QUANDO FOR PEDIDO DE RETIRA.       *}
    {* ********************************PZ*}
    If (strOpcDoc = 'PR') Then
      strSQL := strSQL + '  AND (IFNULL(G.GER_FATNOT, 0) = 0) ';

    If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
      strSQL := strSQL + ' LEFT JOIN NOTMAD M ON M.DET_SEQGER = NOTDET.AUTOINCREM  ';

    If Not fEmptyStr(strNumCoo) Then
    Begin
      strSQL := strSQL + '  INNER JOIN CADFIS F ON (F.FIS_NUMDOC = DET_NUMDOC) AND ';
      strSQL := strSQL + '                         (F.FIS_ESPDOC = DET_ESPDOC) AND ';
      strSQL := strSQL + '                         (F.FIS_CODEMP = DET_CODEMP) AND ';
      strSQL := strSQL + '                         (F.FIS_FORCLI = DET_CODCLI) AND ';
      strSQL := strSQL + '                         (IFNULL(F.FIS_SERIE_, "") = IFNULL(DET_SERIE_, "")) ';
    End;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  CM.MNO_SEQGER IS NULL AND  ';

    (***************************************************************************)
    (* "NF" CUJA ORIGEM É A "CONFIRMAÇÃO DE CUPOM", NÃO DEVE APARECER PARA     *)
    (* DEVOLUÇÃO                                                               *)
    (************************************************************************VA*)
    strSQL := strSQL + '  ((SELECT COUNT(*) FROM MOVDET ORI ';
    strSQL := strSQL + '     WHERE NOTDET.DET_NUMDOC = ORI.DET_NUMFAT AND ';
    strSQL := strSQL + '           NOTDET.DET_ESPDOC = ORI.DET_TIPFAT AND ';
    strSQL := strSQL + '           NOTDET.DET_CODEMP = ORI.DET_EMPFAT AND ';
    strSQL := strSQL + '           NOTDET.DET_ESPDOC = "NF" AND ';
    strSQL := strSQL + '              ORI.DET_ESPDOC = "IF") = 0) AND ';

   (********************************************************************************************)
   (* CASO PERMITA DEVOLVER O DOCUMENTO DE VENDA ORIGINAL CONFIRMADO EM NOTA OU CUPOM ESPECIAL *)
   (* NAO DEVE PERMITIR DEVOLVER O DOCUMENTO DA CONFIRMACAO                                    *)
   (*****************************************************************************************JC*)
    If (fCfgSis('DVFTNE', varBoolean)) Then
      strSQL := strSQL + '  IFNULL(DET_NOTESP, "N") <> "S"    AND ';

    {**************************************************************************************}
    {* SOMENTE DOCUMENTOS DE BAIXA DE ENTREGA FUTURA QUE NAO SEJAM ORIGINADOS EM PEDIDOS, *}
    {* OU SEJA, SOMENTE "DOCUMENTO FINAL DE ENTREGA FUTURA". VER BAIXA DE ENTREGA FUTURA. *}
    {***********************************************************************************JC*}
    If blnDevBaiEntFut Then
      strSQL := strSQL + '  A.AUX_OPCDOC = "BF" AND IFNULL(DET_NUM_PD,"") = "" AND ';

    strSQL := strSQL + '  IFNULL(DET_ENTFUT, "N") <> "S"    AND ';
    strSQL := strSQL + '  IFNULL(DET_PROEMB, "N") <> "S"    AND ';
    strSQL := strSQL + '  DET_TIP_FC = "C"                  AND ';
    strSQL := strSQL + '  DET_ESPDOC IN ("NF", "IF", "IV", "EL", "NV")  AND ';
    strSQL := strSQL + '  ((LOCATE(DET_CLAFIS, :CLAFIS) > 0) OR ';

    If (fCfgSis('VENBRI', VarString) = 'S') Or ((fCfgSis('DVBRAD', VarString) = 'S') And (Not fEmptyStr(strAutDev))) Then
      strSQL := strSQL + ' (LOCATE(RIGHT(DET_CLAFIS,3), ' + QuotedStr(CLAFIS_BR) + ') > 0) OR ';

    strSQL := strSQL + '   (RIGHT(DET_CLAFIS,3) = "929")     OR ';

    If Self.GetDevolvendoMercadoriaDoEstoqueExterno Then
    Begin
      strSQL := strSQL + '   (DET_CLAFIS IN (' + FulfillmentSelectClassificacao(opRemessa, 'AMZ') + ')) OR ';
      strSQL := strSQL + '   (DET_CLAFIS IN (' + FulfillmentSelectClassificacao(opRemessa, 'B2W') + ')) OR ';
      strSQL := strSQL + '   (DET_CLAFIS IN (' + FulfillmentSelectClassificacao(opRemessa, 'VRJ') + ')) OR ';
      strSQL := strSQL + '   (DET_CLAFIS IN (' + FulfillmentSelectClassificacao(opRemessa, 'OLI') + ')) OR ';
      strSQL := strSQL + '   (DET_CLAFIS IN (' + FulfillmentSelectClassificacao(opRemessa, 'MGL') + ')) OR ';
      strSQL := strSQL + '   (DET_CLAFIS IN (' + FulfillmentSelectClassificacao(opRemessa, 'MLB') + ')) OR ';
    End;

    strSQL := strSQL + '   (LOCATE(RIGHT(DET_CLAFIS, 3), '+CLAFIS_ENTFUT_VEN_ABR+') > 0))   AND ';
    strSQL := strSQL + '  IFNULL(DET_DOCDEV,"") = ""        AND ';

    If (Not fPermiteDevolucaoOutrasLojas) Then
      strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';

    If (Not fEmptyStr(strNumDoc) And Not fEmptyStr(strEspDoc) And Not fEmptyStr(strEmpDoc))
      Or (fPermiteDevolucaoOutrasLojas And (Not fEmptyStr(strEmpDoc))) Then
      strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';

    If (fClienteConsumidor(fRetNomCliente(strCodCli), True, True) And (Not fCfgSis('DOCDEV', varBoolean))) Or (fCfgSis('DOCDEV', varBoolean) And (fEmptyStr(strNumDoc))) Then
    Begin
      If (fCfgSis('DIADDC', varInteger) > 0) And (FblnFiltrarDiaDev) Then
        strSQL := strSQL + ' DET_DTAENT > DATE_SUB(' + fCurrentDate + ', INTERVAL ' + IntToStr(fCfgSis('DIADDC', varInteger)) + ' DAY) AND ';
    End;

    If fEmptyStr(strAutDev) Then
      strSQL := strSQL + '  DET_CODCLI = :CODCLI       AND ';

    If fEmptyStr(strNumDoc) And fEmptyStr(strNumCoo) Then
    Begin
      strSQL := strSQL + '  DET_DTAENT BETWEEN :DTAINI AND :DTAFIN '
    End Else
    Begin
      If Not fEmptyStr(strNumDoc) Then
      Begin
        strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  DET_ESPDOC = :ESPDOC     ';
      End;

      If Not fEmptyStr(strNumCoo) Then
      Begin
        If Not fEmptyStr(strNumDoc) Then
          strSQL := strSQL + '  AND ';

        strSQL := strSQL + '  FIS_NUMCOO = :NUMCOO ';
      End;
    End;

    If Not fEmptyStr(Self.objFazenda.strCodFaz) And fCfgSis('CADFAZ', VarBoolean) Then
      strSQL := strSQL + '  AND AUX_CODFAZ = :CODFAZ ';

    If Not fEmptyStr(strAutDev) Then
      strSQL := strSQL + fGetExisteDocumentoAD('NOTDET');

  End
  Else
  Begin

    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  D.DET_SEQGER, ';
    strSQL := strSQL + '  DET_NUMDOC, ';
    strSQL := strSQL + '  DET_ESPDOC, ';
    strSQL := strSQL + '  DET_CODEMP, ';
    strSQL := strSQL + '  IF(DET_TIP_FC="C", DET_CODCLI, DET_CODFOR) AS DET_FORCLI, ';
    strSQL := strSQL + '  DET_SERIE_, ';
    strSQL := strSQL + '  DET_CODVEN, ';
    strSQL := strSQL + '  DET_CODVE2, ';
    strSQL := strSQL + '  DET_CODDIV, ';
    strSQL := strSQL + '  ITE_CODGRU, ';
    strSQL := strSQL + '  DET_CODITE, ';
    strSQL := strSQL + '  DET_DTAENT, ';
    strSQL := strSQL + '  DET_DESCRI, ';
    strSQL := strSQL + '  DET_REFERE, ';
    strSQL := strSQL + '  DET_PERCOM, ';
    strSQL := strSQL + '  DET_PERREP, ';
    strSQL := strSQL + '  DET_QTDPON, ';
    strSQL := strSQL + '  DET_TABPRE, ';
    strSQL := strSQL + '  DET_UNIDAD, ';
    strSQL := strSQL + '  DET_CODMAR, ';
    strSQL := strSQL + '  DET_QTDITE, ';
    strSQL := strSQL + '  DET_QTDITE AS DET_QTDORI, ';

    If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
    Begin
      strSQL := strSQL + '  DET_COMPEC, ';
      strSQL := strSQL + '  DET_LARPEC, ';
      strSQL := strSQL + '  DET_ESPPEC, ';

      strSQL := strSQL + '  DET_APAREL, ';
      strSQL := strSQL + '  DET_PERAPA, ';
      strSQL := strSQL + '  DET_BENEFI, ';
      strSQL := strSQL + '  DET_PERBEN, ';
    End;

    strSQL := strSQL + '  DET_VDESST, ';
    strSQL := strSQL + '  DET_MDESST, ';

    strSQL := strSQL + '  DET_TOTITE, ';
    strSQL := strSQL + '  DET_DESESP, ';
    strSQL := strSQL + '  DET_TOTFRE, ';
    strSQL := strSQL + '  DET_DESACE, ';
    strSQL := strSQL + '  DET_DEDVCF, ';
    strSQL := strSQL + '  DET_TOTCUS, ';
    strSQL := strSQL + '  DET_TOTCU2, ';
    strSQL := strSQL + ' (DET_TOTCUS/DET_QTDITE) AS DET_PRECUS, ';
    strSQL := strSQL + ' (DET_TOTCU2/DET_QTDITE) AS DET_PRECU2, ';
    strSQL := strSQL + ' (DET_OUTVAL/DET_QTDITE)     AS DET_OUTVAL, ';
    strSQL := strSQL + ' (DET_ICMSAI/(DET_TOTITE - DET_DESESP) * 100) AS DET_ICMSAI, ';
    strSQL := strSQL + ' (DET_IMPFED/(DET_TOTITE - DET_DESESP) * 100) AS DET_IMPFED, ';
    strSQL := strSQL + ' (DET_DESOPE/(DET_TOTITE - DET_DESESP) * 100) AS DET_DESOPE, ';
    strSQL := strSQL + ' (DET_TOTMED / DET_QTDITE) AS DET_PREMED, ';
    strSQL := strSQL + ' (DET_IMPULT / DET_QTDITE) AS DET_IMPULT, ';
    strSQL := strSQL + ' (DET_TOTULT / DET_QTDITE) AS DET_PREULT, ';
    {************************************************}
    {* CAMPO UTILIZADO PARA COMPARAÇÃO NA DEVOLUÇÃO *}
    {*********************************************RV*}
    strSQL := strSQL + '  ROUND(IF(DET_DESESP > 0, ((DET_TOTITE - DET_DESESP) / DET_QTDITE), DET_UNITAR), ' + fCfgSis('DECUNI') + ') AS DET_COMPAR, ';
    strSQL := strSQL + '  DET_UNITAR, ';
    strSQL := strSQL + '  DET_UNIORI, ';
    strSQL := strSQL + '  DET_UNIVIS, ';
    strSQL := strSQL + '  DET_TAXJUR, ';
    strSQL := strSQL + '  DET_VAL_RT, ';
    strSQL := strSQL + '  DET_CODACA, ';
    strSQL := strSQL + '  DET_PROACA, ';
    strSQL := strSQL + '  DET_EMPACA, ';
    strSQL := strSQL + '  DET_PROACA, ';
    strSQL := strSQL + '  DET_NUMLOT, ';
    strSQL := strSQL + '  DET_IDEPRO, ';
    strSQL := strSQL + '  DET_TIPEMB, ';
    strSQL := strSQL + '  DET_ITEEMB, ';
    strSQL := strSQL + '  DET_QTDEMB, ';
    strSQL := strSQL + '  DET_PREEMB, ';
    strSQL := strSQL + '  DET_NOTESP, ';
    strSQL := strSQL + '  D.DET_SEQGER, ';
    strSQL := strSQL + '  DET_CLAFIS, ';
    strSQL := strSQL + '  DET_CONPAG, ';
    strSQL := strSQL + '  DET_CODFIS, ';
    strSQL := strSQL + '  DET_CODCND, ';
    strSQL := strSQL + '  D.AUTOINCREM AS DET_AUTOIN, ';
    strSQL := strSQL + '  A.AUX_VENPRE, ';
    strSQL := strSQL + '  IF(CADNPS.NPS_NUMDOC IS NULL, "N", "S") AS AUX_UTINPS, ';
    strSQL := strSQL + '  "MOVDET" AS DET_TABELA, ';
    strSQL := strSQL + '  DET_DOCFUT, ';
    strSQL := strSQL + '  DET_ESPFUT, ';
    strSQL := strSQL + '  DET_EMPFUT, ';
    strSQL := strSQL + '  T.DET_EMPORI, ';
    strSQL := strSQL + '  D.DET_TIP_FC, ';
    strSQL := strSQL + '  D.DET_ORDPRO, ';
    strSQL := strSQL + '  G.GER_TIPFRE, ';
    strSQL := strSQL + '  T.DET_ATIVAC, ';
    strSQL := strSQL + '  T.DET_SEQCOM, ';
    strSQL := strSQL + '  G.GER_ENTFAT, ';
    strSQL := strSQL + '  D.DET_ENTFUT, ';
    strSQL := strSQL + '  A.AUX_OPCDOC, ';
    strSQL := strSQL + '  T.DET_BFCPST, ';
    strSQL := strSQL + '  T.DET_PFCPST, ';
    strSQL := strSQL + '  T.DET_VFCPST, ';
    strSQL := strSQL + '  DET_EMPCAR, ';
    strSQL := strSQL + '  A.AUX_NUMDRW, ';
    strSQL := strSQL + '  T.DET_NUMDRW, ';
    strSQL := strSQL + '  DET_NUM_PD, ';
    strSQL := strSQL + '  DET_ESP_PD, ';
    strSQL := strSQL + '  DET_EMP_PD, ';
    strSQL := strSQL + '  " " AS DET_SEQDET, ';
    strSQL := strSQL + '  (DET_FRECOT / DET_QTDITE) AS DET_FRECOT, ';
    strSQL := strSQL + '  T.DET_NITEM_, ';
    strSQL := strSQL + '  A.AUX_ESTNFE, ';
    strSQL := strSQL + '  A.AUX_CODPRJ, ';
    strSQL := strSQL + '  G.GER_CODTRA  ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  MOVDET D ';
    strSQL := strSQL + '  INNER JOIN MOVGER G ON (G.AUTOINCREM = D.DET_SEQGER) ';
    strSQL := strSQL + '  LEFT  JOIN AUXMOV A ON (G.AUTOINCREM = A.AUX_SEQGER) ';
    strSQL := strSQL + '  INNER JOIN CADITE ON ITE_CODITE = DET_CODITE ';
    strSQL := strSQL + '  LEFT JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM ';
    strSQL := strSQL + '  LEFT JOIN MOVAUX ON D.AUTOINCREM = MOVAUX.DET_SEQGER ';

    strSQL := strSQL + '  LEFT JOIN CADNPS ON NPS_NUMDOC = G.GER_NUMDOC ';
    strSQL := strSQL + '                  AND NPS_ESPDOC = G.GER_ESPDOC ';
    strSQL := strSQL + '                  AND NPS_CODEMP = G.GER_CODEMP ';
    strSQL := strSQL + '                  AND NPS_CODCLI = G.GER_CODCLI ';
    strSQL := strSQL + '                  AND NPS_SERIE_ = G.GER_SERIE_ ';

    If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
      strSQL := strSQL + ' LEFT JOIN MOVMAD M ON M.DET_SEQGER = D.AUTOINCREM  ';

    If Not fEmptyStr(strNumCoo) Then
    Begin
      strSQL := strSQL + '  INNER JOIN CADFIS F ON (F.FIS_NUMDOC = DET_NUMDOC) AND ';
      strSQL := strSQL + '                         (F.FIS_ESPDOC = DET_ESPDOC) AND ';
      strSQL := strSQL + '                         (F.FIS_CODEMP = DET_CODEMP) AND ';
      strSQL := strSQL + '                         (F.FIS_FORCLI = DET_CODCLI) AND ';
      strSQL := strSQL + '                         (IFNULL(F.FIS_SERIE_, "") = IFNULL(DET_SERIE_, "")) ';
    End;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  DET_JAFATU = 0       AND ';
    strSQL := strSQL + '  DET_TIP_FC = "F"     AND ';
    If (strOpcDoc = 'EF') Then
    Begin
      strSQL := strSQL + ' IFNULL(AUX_OPCDOC, "") <> "FE" AND '
    End
    Else
    Begin
      If (strOpcDoc = 'OF') Then
        strSQL := strSQL + ' ((IFNULL(DET_ORIDOC, "") = "") OR (IFNULL(AUX_OPCDOC, "") = "FE")) AND '
      Else
        strSQL := strSQL + ' IFNULL(DET_ORIDOC, "") = "" AND ';
    End;
    strSQL := strSQL + '  DET_CODFOR = :CODCLI AND ';
    strSQL := strSQL + '  DET_CODEMP = :CODEMP AND ';

    {**************************************************************************************}
    {* SOMENTE DOCUMENTOS DE BAIXA DE ENTREGA FUTURA QUE NAO SEJAM ORIGINADOS EM PEDIDOS, *}
    {* OU SEJA, SOMENTE "DOCUMENTO FINAL DE ENTREGA FUTURA". VER BAIXA DE ENTREGA FUTURA. *}
    {***********************************************************************************JC*}
    If blnDevBaiEntFut Then
      strSQL := strSQL + '  A.AUX_OPCDOC = "BF" AND IFNULL(DET_NUM_PD,"") = "" AND ';

    If fEmptyStr(strNumDoc) And fEmptyStr(strNumCoo) Then
    Begin
      strSQL := strSQL + '  DET_DTAENT BETWEEN :DTAINI AND :DTAFIN '
    End Else
    Begin
      If Not fEmptyStr(strNumDoc) Then
      Begin
        strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  DET_ESPDOC = :ESPDOC     ';
      End;

      If Not fEmptyStr(strNumCoo) Then
      Begin
        If Not fEmptyStr(strNumDoc) Then
          strSQL := strSQL + '  AND ';

        strSQL := strSQL + '  FIS_NUMCOO = :NUMCOO ';
      End;
    End;

    If Not fEmptyStr(Self.objFazenda.strCodFaz) And fCfgSis('CADFAZ', VarBoolean) Then
      strSQL := strSQL + '  AND AUX_CODFAZ = :CODFAZ ';

    If Not fEmptyStr(strAutDev) Then
      strSQL := strSQL + fGetExisteDocumentoAD;

  End;

  strSQL := strSQL + ' ORDER BY DET_NUMDOC, DET_CODITE, DET_QTDITE ';

  With qryGenNot Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);

    If (qryGenNot.FindParam('CODCLI') <> Nil) Then
      ParamByName('CODCLI').AsString   := strCodCli;

    If (fEmptyStr(strNumDoc) And fEmptyStr(strNumCoo)) Then
    Begin
      ParamByName('DTAINI').AsDateTime := dtaDtaIni;
      ParamByName('DTAFIN').AsDateTime := dtaDtaFin;
    End Else
    Begin
      If Not fEmptyStr(strNumDoc) Then
      Begin
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
      End;

      If Not fEmptyStr(strNumCoo) Then
      Begin
        ParamByName('NUMCOO').AsString := strNumCoo;
      End;
    End;

    If Not fEmptyStr(Self.objFazenda.strCodFaz) And fCfgSis('CADFAZ', VarBoolean) Then
      ParamByName('CODFAZ').AsString := Self.objFazenda.strCodFaz;

    If Pos(strOpcDoc,'DV_PR_') > 0 Then
    Begin
      If Not fEmptyStr(strCliCn2) Then
        ParamByName('CONSUM').AsString := strCliCn2;

      If (Not fPermiteDevolucaoOutrasLojas) Then
        ParamByName('CODEMP').AsString := VS_strCodEmp;

      If (Not fEmptyStr(strNumDoc) And Not fEmptyStr(strEspDoc) And Not fEmptyStr(strEmpDoc))
        Or (fPermiteDevolucaoOutrasLojas And (Not fEmptyStr(strEmpDoc))) Then
        ParamByName('CODEMP').AsString := strEmpDoc;

      ParamByName('CLAFIS').AsString   := VS_strClaVen;
    End
    Else
    Begin
      ParamByName('CODEMP').AsString := VS_strCodEmp;
    End;

    Open;
  End;

  If Not qryGenNot.FieldByName('GER_CODTRA').AsString.IsEmpty Then
    Self.strCodTra := qryGenNot.FieldByName('GER_CODTRA').AsString;

  dspGenNot.DataSet := qryGenNot;
  cdsGenNot.Close;
  cdsGenNot.SetProvider(dspGenNot);

  With cdsGenNot.IndexDefs.AddIndexDef Do
  Begin
    Name   := 'IDX_001';
    Fields := 'DET_NUMDOC;DET_ESPDOC;DET_CODEMP;DET_QTDITE';
  End;
  cdsGenNot.IndexName := 'IDX_001';

  {*********************************************}
  { CRIADO AGREGATE SÓ PARA SINTETIZAR A QUERY  }
  {******************************************JB*}
  cdsGenNot.AggregatesActive := True;
  With TAggregateField.Create(Self) Do
  Begin
    FieldName     := 'TOT_QTDITE';
    DataSet       := cdsGenNot;
    Expression    := 'SUM(DET_QTDITE)';
    IndexName     := 'IDX_001';
    GroupingLevel := 3;
    Active        := True;
  End;
  cdsGenNot.Open;

  If fCfgSis('DVSMNE', varBoolean) Then
  Begin
    cdsGenNot.First;

    While Not cdsGenNot.Eof Do
    Begin
      If Not fEhNotaEspecial(cdsGenNot.FieldByName('DET_SEQGER').AsString,
                             cdsGenNot.FieldByName('DET_TABELA').AsString) Then
        cdsGenNot.Delete
      Else
        cdsGenNot.Next;
    End;

    cdsGenNot.First;
  End;

  With cdsGenNot Do
  Begin

    cdsGenSin.Open;
    First;

    If (strOpcDoc = 'OF') And (FieldByName('DET_TIP_FC').AsString = 'F') Then
      Self.blnDifFCPST := fExisteMovICD(FieldByName('DET_NUMDOC').AsString,
                                        FieldByName('DET_ESPDOC').AsString,
                                        FieldByName('DET_CODEMP').AsString);

    While Not Eof Do
    Begin

      If gbFirst in cdsGenNot.GetGroupState(3) Then
      Begin
        cdsGenSin.Append;
        cdsGenSin.FieldByName('DET_CODEMP').AsString := FieldByName('DET_CODEMP').AsString;
        cdsGenSin.FieldByName('DET_NUMDOC').AsString := FieldByName('DET_NUMDOC').AsString;
        cdsGenSin.FieldByName('DET_ESPDOC').AsString := FieldByName('DET_ESPDOC').AsString;
        cdsGenSin.FieldByName('AUX_OPCDOC').AsString := FieldByName('AUX_OPCDOC').AsString;
        cdsGenSin.Post;
      End;

      Next;
    End;

    qryGenDet.Close;
    qryGenDet.SQL.Clear;
    qryGenDet.SQL.Text := strSQLDet;
    qryGenDet.SQL.Text := AnsiReplaceStr(qryGenDet.SQL.Text, 'FILTRODOCUMENTOS',  ' AND (FALSE) ');
    qryGenDet.SQL.Text := AnsiReplaceStr(qryGenDet.SQL.Text, 'FILTRODOCS_FATDOR', ' AND (FALSE) ');

    If Pos(strOpcDoc,'DV_PR_') <= 0 Then
      qryGenDet.ParamByName('CODEMP').AsString := VS_strCodEmp;

    qryGenDet.Open;

    cdsGenDet := fCriaClientDatSet(qryGenDet, True);

    cdsGenSin.First;
    While Not cdsGenSin.Eof Do
    Begin
      pProgresso(cdsGenSin.RecNo, cdsGenSin.RecordCount, pgbStatus);

      strSQLAux := '';
      strSQLAux := strSQLAux + ' AND DET_DOCDEV = ' + QuotedStr(cdsGenSin.FieldByName('DET_NUMDOC').AsString);
      strSQLAux := strSQLAux + ' AND DET_ESPDEV = ' + QuotedStr(cdsGenSin.FieldByName('DET_ESPDOC').AsString);
      strSQLAux := strSQLAux + ' AND DET_EMPDEV = ' + QuotedStr(cdsGenSin.FieldByName('DET_CODEMP').AsString);

      qryGenDet.Close;
      qryGenDet.SQL.Clear;
      qryGenDet.SQL.Text := strSQLDet;
      qryGenDet.SQL.Text := AnsiReplaceStr(qryGenDet.SQL.Text, 'FILTRODOCUMENTOS', strSQLAux);
      qryGenDet.SQL.Text := AnsiReplaceStr(qryGenDet.SQL.Text, 'FILTRODOCS_FATDOR', AnsiReplaceStr(strSQLAux, 'DET_', 'FDO_'));

      If Pos(strOpcDoc,'DV_PR_') <= 0 Then
        qryGenDet.ParamByName('CODEMP').AsString := VS_strCodEmp;

      qryGenDet.Open;

      qryGenDet.First;
      While Not qryGenDet.Eof Do
      Begin
        pCopiaRegistroDataSet(qryGenDet, cdsGenDet);
        qryGenDet.Next;
      End;

      cdsGenSin.Next;
    End;

    FreeAndNil(cdsGenSin);

    IndexFieldNames := 'DET_NUMDOC;DET_ESPDOC;DET_CODEMP;DET_QTDITE';
    First;

    While (Not Eof) Do
    Begin
      pProgresso(RecNo, RecordCount, pgbStatus);

      If fEmptyStr(FieldByName('DET_CODACA').AsString) Then
      Begin

        If Pos('ITEM ESPECIAL', FieldByName('DET_DESCRI').AsString) <= 0 Then
        Begin
          If Not fEmptyStr(cdsGenDet.FieldByName('DET_INCDEV').AsString) Then
            cdsGenDet.Filter   := 'DET_INCDEV = ' + QuotedStr(FieldByName('DET_AUTOIN').AsString)
          Else
            cdsGenDet.Filter   := 'DET_DOCDEV = ' + QuotedStr(FieldByName('DET_NUMDOC').AsString) + ' AND ' +
                                  'DET_CODITE = ' + QuotedStr(FieldByName('DET_CODITE').AsString);
                                  {***********************************************}
                                  {* RETIRADO A PEDIDO DO RONALDO DIA 25/05/2012 *}
                                  {* *AUTCOM_CASAT DO DIA 23/05/2012             *}
                                  {********************************************AF*}
//                                IIF(fCfgSis('PREDEV', varBoolean), '', ' AND ' +
//                                'DET_UNITAR = ' + FloatToStr(fFormataFloat(FieldByName('DET_COMPAR').AsFloat, Self.VS_intDecUni)));
        End
        Else
        Begin
          If Not fEmptyStr(cdsGenDet.FieldByName('DET_INCDEV').AsString) Then
            cdsGenDet.Filter   := 'DET_INCDEV = ' + QuotedStr(FieldByName('DET_AUTOIN').AsString)
          Else
            cdsGenDet.Filter   := 'DET_DOCDEV = ' + QuotedStr(FieldByName('DET_NUMDOC').AsString) + ' AND ' +
                                  'DET_CODITE = ' + QuotedStr(FieldByName('DET_CODITE').AsString) + ' AND ' +
                                  {***********************************************}
                                  {* RETIRADO A PEDIDO DO RONALDO DIA 25/05/2012 *}
                                  {* *AUTCOM_CASAT DO DIA 23/05/2012             *}
                                  {********************************************AF*}
//                                IIF(fCfgSis('PREDEV', varBoolean), '', ' AND ' +
//                                'DET_UNITAR = ' + FloatToStr(fFormataFloat(FieldByName('DET_COMPAR').AsFloat, Self.VS_intDecUni)) +
                                  'DET_DESCRI = ' + QuotedStr(FieldByName('DET_DESCRI').AsString);
        End;

      End
      Else
      Begin
        If Not fEmptyStr(cdsGenDet.FieldByName('DET_INCDEV').AsString) Then
          cdsGenDet.Filter   := 'DET_INCDEV = ' + QuotedStr(FieldByName('DET_AUTOIN').AsString)
        Else
          cdsGenDet.Filter   := 'DET_DOCDEV = ' + QuotedStr(FieldByName('DET_NUMDOC').AsString) + ' AND ' +
                                'DET_CODITE = ' + QuotedStr(FieldByName('DET_CODITE').AsString) + ' AND ' +
                                {***********************************************}
                                {* RETIRADO A PEDIDO DO RONALDO DIA 25/05/2012 *}
                                {* *AUTCOM_CASAT DO DIA 23/05/2012             *}
                                {********************************************AF*}
//                              IIF(fCfgSis('PREDEV', varBoolean), '', ' AND ' +
//                              'DET_UNITAR = ' + FloatToStr(fFormataFloat(FieldByName('DET_COMPAR').AsFloat, Self.VS_intDecUni)) + ' AND ' +
                                'DET_CODACA = ' + QuotedStr(FieldByName('DET_CODACA').AsString) + ' AND ' +
                                'DET_EMPACA = ' + QuotedStr(FieldByName('DET_EMPACA').AsString);

      End;

      cdsGenDet.Filtered := True;
      cdsGenDet.First;

      fltQtdDevolvidaEmGarantia := fRetornaQuantidadeDevolvidaEmGarantia(FieldByName('DET_AUTOIN').AsString);
      
      While (Not cdsGenDet.Eof) Do
      Begin
        fltQtdJaDevolvida := cdsGenDet.FieldByName('DET_QTDITE').AsFloat -
                             IIF(cdsGenDet.FieldByName('AUX_OPCDOC').AsString='NW', fltQtdDevolvidaEmGarantia, 0);

        If (FieldByName('DET_QTDITE').AsFloat >= fltQtdJaDevolvida) Or (cdsGenDet.FieldByName('AUX_ESTNFE').AsString = 'S') Then
        Begin

          If (Not fUtilizaVendaMadeiraOuVidroOuMetroLinear) Or fComparaMetragem(cdsGenDet, cdsGenNot) Then
          Begin
            Edit;

            If (cdsGenDet.FieldByName('AUX_ESTNFE').AsString = 'S') Or (blnEstornoNotaFiscal) Then
            Begin
              If (cdsGenDet.FieldByName('DET_CLAFIS').AsString < '5000') Then
                FieldByName('DET_QTDITE').AsFloat := FieldByName('DET_QTDITE').AsFloat - fltQtdJaDevolvida
              Else
                FieldByName('DET_QTDITE').AsFloat := FieldByName('DET_QTDITE').AsFloat + fltQtdJaDevolvida;
            End
            Else
            Begin
              FieldByName('DET_QTDITE').AsFloat := FieldByName('DET_QTDITE').AsFloat - fltQtdJaDevolvida;
            End;

            Post;

            cdsGenDet.Delete;
            Continue;
          End;

        End;

        cdsGenDet.Next;
      End;

      cdsGenDet.Filtered := False;

      Next;
    End;

    First;

    dicFulfillCache := TDictionary<String, Boolean>.Create;

    Try
      While (Not Eof) Do
      Begin
        pProgresso(RecNo, RecordCount, pgbStatus);

        {********************************************************************}
        {* SE FOR CONFIRMACAO DE ENTREGA FUTURA E A VARIAVEL fltQtdTmp VIER *}
        {* ZERADO, É PORQUE HOUVE DEVOLUÇÃO TOTAL DE TODAS AS BAIXAS        *}
        {* PARCIAIS/TOTAIS DO DOCUMENTO ORIGINAL CONFIRMADO                 *}
        {*****************************************************************FC*}
        fltQtdTmp := 0;
        If fConsultaQuantidadeDisponivelParaDevolucaoDoDocumentoEntregaFutura(FieldByName('DET_SEQDET').AsString,
                                                                              FieldByName('DET_ESPDOC').AsString,
                                                                              FieldByName('DET_ENTFUT').AsString) Then
        Begin
          fltQtdTmp := fRetornaQuantidadeDisponivelParaDevolucaoDoDocumentoEntregaFutura(FieldByName('DET_AUTOIN').AsString,
                                                                                         FieldByName('DET_SEQDET').AsString,
                                                                                         FieldByName('DET_CODITE').AsString,
                                                                                         FieldByName('DET_ESPDOC').AsString,
                                                                                         FieldByName('DET_ENTFUT').AsString);
          If fltQtdTmp <= 0 Then
          Begin
            Next;
            Continue;
          End;
        End;

        {********************************************}
        {* CASO JA TENHA BAIXADO TUDO, NÃO FAZ NADA *}
        {*****************************************MV*}
        If RoundTo(FieldByName('DET_QTDITE').AsFloat, -fCfgSis('DECQTD', varInteger)) <= 0 Then
        Begin
          Next;
          Continue;
        End;

        If fEhBaixaEntFutAndDocOriginalFoiConfirmado(FieldByName('DET_DOCFUT').AsString,
                                                     FieldByName('DET_ESPFUT').AsString,
                                                     FieldByName('DET_EMPFUT').AsString) then
        Begin
          Next;
          Continue;
        End;

        if (not fEmptyStr(FieldByName('AUX_NUMDRW').AsString)) then
          strNumeroDrawback := FieldByName('AUX_NUMDRW').AsString;

        {***************************************************}
        {* SÓ VERIFICA SE HOUVE DEVOLUÇÃO PARCIAL SE FOR   *}
        {* DEVOLUÇÃO COMPLETA, POIS CASO CONTRARIO NÃO VAI *}
        {* UTILIZAR DESESP DE QUALQUER FORMA               *}
        {***************************************************}
        If blnDevolucaoCompleta Then
          blnDevolucaoParcialAnterior := fDevolucaoParcial(FieldByName('DET_NUMDOC').AsString, FieldByName('DET_ESPDOC').AsString, FieldByName('DET_CODEMP').AsString);

        qryTemporaria.Insert;
        qryTemporaria.FieldByName('DET_CODFIS').AsString   := FieldByName('DET_CODFIS').AsString;
        qryTemporaria.FieldByName('DET_CONPAG').AsString   := FieldByName('DET_CONPAG').AsString;
        qryTemporaria.FieldByName('DET_CODCND').AsString   := FieldByName('DET_CODCND').AsString;
        qryTemporaria.FieldByName('DET_SEQGER').AsString   := FieldByName('DET_SEQGER').AsString;
        qryTemporaria.FieldByName('DET_TABELA').AsString   := FieldByName('DET_TABELA').AsString;
        qryTemporaria.FieldByName('DET_IDEPRO').AsString   := FieldByName('DET_IDEPRO').AsString;
        qryTemporaria.FieldByName('DET_NUMLOT').AsString   := FieldByName('DET_NUMLOT').AsString;

        {Caso o produto possua lote informado na venda}
        If Not fEmptyStr(FieldByName('DET_NUMLOT').AsString) Then
        Begin
          LChaveDocAtu :=
            FieldByName('DET_NUMDOC').AsString + '|' +
            FieldByName('DET_ESPDOC').AsString + '|' +
            FieldByName('DET_FORCLI').AsString + '|' +
            FieldByName('DET_CODEMP').AsString + '|' +
            FieldByName('DET_SERIE_').AsString + '|' +
            FieldByName('DET_TIP_FC').AsString;

          If Not dicFulfillCache.TryGetValue(LChaveDocAtu, LNFFulfillment) Then
          Begin
            LNFFulfillment := False;
            LChaveAceOri   := fRetChaveAcesso(
                                FieldByName('DET_NUMDOC').AsString,
                                FieldByName('DET_ESPDOC').AsString,
                                FieldByName('DET_FORCLI').AsString,
                                FieldByName('DET_CODEMP').AsString,
                                FieldByName('DET_SERIE_').AsString,
                                FieldByName('DET_TIP_FC').AsString);

            If Not fEmptyStr(LChaveAceOri) Then
              LNFFulfillment := fCampoTabela('NFE_IMPORT', 'NFEIMP',
                                             ['NFE_ACESSO', 'NFE_STATUS'],
                                             [LChaveAceOri, 'AT']) = 'S';

            dicFulfillCache.Add(LChaveDocAtu, LNFFulfillment);
          End;

          { Caso gere pedido de reserva de estoque para enderecamento dos produtos na rotina de devolucao
            e o produto realiza enderecamento entao define o lote do mesmo como 'A DEFINIR' }
          If fCfgSis('DEVEND', VarBoolean) Then
            If fItemRealizaEnderecamento(FieldByName('DET_CODITE').AsString) Then
              If Self.objCadLot.fExisteLote(FieldByName('DET_CODITE').AsString, VS_StrCodEmp, 'A DEFINIR', False) Then
                If ((Not fCfgSis('MANEND', VarBoolean))  Or ((fCfgSis('FULLAD', VarString) = 'S') And (LNFFulfillment))) And
                   Not Self.GetDevolvendoMercadoriaDoEstoqueExterno Then
                  qryTemporaria.FieldByName('DET_NUMLOT').AsString := 'A DEFINIR';
        End;

        qryTemporaria.FieldByName('DET_NUMDOC').AsString   := FieldByName('DET_NUMDOC').AsString;
        qryTemporaria.FieldByName('DET_ESPDOC').AsString   := FieldByName('DET_ESPDOC').AsString;
        qryTemporaria.FieldByName('DET_CODEMP').AsString   := FieldByName('DET_CODEMP').AsString;
        qryTemporaria.FieldByName('DET_FORCLI').AsString   := FieldByName('DET_FORCLI').AsString;
        qryTemporaria.FieldByName('DET_SERIE_').AsString   := FieldByName('DET_SERIE_').AsString;
        qryTemporaria.FieldByName('DET_VENDED').AsString   := FieldByName('DET_CODVEN').AsString + '-' +
                                                              fRetNomVendRep(FieldByName('DET_CODVEN').AsString) + '  ';
        qryTemporaria.FieldByName('DET_CODVEN').AsString   := FieldByName('DET_CODVEN').AsString;
        qryTemporaria.FieldByName('DET_CODVE2').AsString   := FieldByName('DET_CODVE2').AsString;
        qryTemporaria.FieldByName('DET_CODDIV').AsString   := FieldByName('DET_CODDIV').AsString;
        qryTemporaria.FieldByName('DET_CODGRU').AsString   := FieldByName('ITE_CODGRU').AsString;
        qryTemporaria.FieldByName('DET_CODITE').AsString   := FieldByName('DET_CODITE').AsString;
        qryTemporaria.FieldByName('DET_DTAENT').AsDateTime := FieldByName('DET_DTAENT').AsDateTime;
        qryTemporaria.FieldByName('DET_DESCRI').AsString   := FieldByName('DET_DESCRI').AsString;
        qryTemporaria.FieldByName('DET_REFERE').AsString   := FieldByName('DET_REFERE').AsString;
        qryTemporaria.FieldByName('DET_PERCOM').AsFloat    := FieldByName('DET_PERCOM').AsFloat;
        qryTemporaria.FieldByName('DET_PERREP').AsFloat    := FieldByName('DET_PERREP').AsFloat;
        qryTemporaria.FieldByName('DET_QTDPON').AsFloat    := FieldByName('DET_QTDPON').AsFloat;
        qryTemporaria.FieldByName('DET_TABPRE').AsString   := FieldByName('DET_TABPRE').AsString;
        qryTemporaria.FieldByName('DET_UNIDAD').AsString   := FieldByName('DET_UNIDAD').AsString;
        qryTemporaria.FieldByName('DET_CODMAR').AsString   := FieldByName('DET_CODMAR').AsString;
        qryTemporaria.FieldByName('DET_ENTRET').AsString   := IIF((FieldByName('GER_ENTFAT').AsString = 'S') Or (FieldByName('DET_ENTFUT').AsString = 'S'), 'E', 'R');
        qryTemporaria.FieldByName('DET_QTDITE').AsFloat    := IIF(fltQtdTmp > 0, fltQtdTmp, FieldByName('DET_QTDITE').AsFloat);
        qryTemporaria.FieldByName('DET_QTDDET').AsFloat    := IIF(fltQtdTmp > 0, fltQtdTmp, FieldByName('DET_QTDITE').AsFloat);
        qryTemporaria.FieldByName('DET_QTDORI').AsFloat    := FieldByName('DET_QTDORI').AsFloat;

        //Remove a quantidade que esta no espelho pendente
        If (Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2')  Then
        Begin
          fltQtdEmAbertoEspelho := fRetornaQuantidadeDevolucaoEmAbertoNoEspelho(FieldByName('DET_AUTOIN').AsString);
          qryTemporaria.FieldByName('DET_QTDITE').AsFloat := qryTemporaria.FieldByName('DET_QTDITE').AsFloat - fltQtdEmAbertoEspelho;
          qryTemporaria.FieldByName('DET_QTDDET').AsFloat := qryTemporaria.FieldByName('DET_QTDDET').AsFloat - fltQtdEmAbertoEspelho;

          if (qryTemporaria.FieldByName('DET_QTDITE').AsFloat <= 0) Then
          Begin
            qryTemporaria.Cancel;
            Next;
            Continue;
          End;

        End;

        //subtrai a quantidade devolvida em garantia
        If fRetornaQuantidadeDevolvidaEmGarantia(FieldByName('DET_AUTOIN').AsString) > 0 Then
        Begin
          qryTemporaria.FieldByName('DET_QTDITE').AsFloat := qryTemporaria.FieldByName('DET_QTDITE').AsFloat - fRetornaQuantidadeDevolvidaEmGarantia(FieldByName('DET_AUTOIN').AsString);
          qryTemporaria.FieldByName('DET_QTDDET').AsFloat := qryTemporaria.FieldByName('DET_QTDDET').AsFloat - fRetornaQuantidadeDevolvidaEmGarantia(FieldByName('DET_AUTOIN').AsString);

          if (qryTemporaria.FieldByName('DET_QTDITE').AsFloat <= 0) Then
          Begin
            qryTemporaria.Cancel;
            Next;
            Continue;
          End;
        End;

        qryTemporaria.FieldByName('DET_TIPEMB').AsString   := FieldByName('DET_TIPEMB').AsString;
        qryTemporaria.FieldByName('DET_ITEEMB').AsString   := FieldByName('DET_ITEEMB').AsString;
        qryTemporaria.FieldByName('DET_QTDEMB').AsFloat    := FieldByName('DET_QTDEMB').AsFloat;
        qryTemporaria.FieldByName('DET_PREEMB').AsFloat    := FieldByName('DET_PREEMB').AsFloat;
        qryTemporaria.FieldByName('DET_BFCPST').AsFloat    := FieldByName('DET_BFCPST').AsFloat;
        qryTemporaria.FieldByName('DET_PFCPST').AsFloat    := FieldByName('DET_PFCPST').AsFloat;
        qryTemporaria.FieldByName('DET_VFCPST').AsFloat    := FieldByName('DET_VFCPST').AsFloat;
        qryTemporaria.FieldByName('DET_EMPCAR').AsString   := FieldByName('DET_EMPCAR').AsString;

        If fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
        Begin
          qryTemporaria.FieldByName('DET_COMPEC').AsFloat  := FieldByName('DET_COMPEC').AsFloat;
          qryTemporaria.FieldByName('DET_LARPEC').AsFloat  := FieldByName('DET_LARPEC').AsFloat;
          qryTemporaria.FieldByName('DET_ESPPEC').AsFloat  := FieldByName('DET_ESPPEC').AsFloat;

          qryTemporaria.FieldByName('DET_QTDPEC').AsFloat  := fCalculaQuantidadePecas(qryTemporaria.FieldByName('DET_QTDITE').AsFloat,
                                                                                      FieldByName('DET_COMPEC').AsFloat,
                                                                                      FieldByName('DET_LARPEC').AsFloat,
                                                                                      FieldByName('DET_ESPPEC').AsFloat,
                                                                                      fRetSiglaUnidade(FieldByName('DET_UNIDAD').AsString));

          blnDocAntACfgVidOuMadOuMtL := ((fFormataFloat((FieldByName('DET_PERAPA').AsFloat + FieldByName('DET_PERBEN').AsFloat), 4) = 0) And
                                         (fEmptyStr(FieldByName('DET_APAREL').AsString + FieldByName('DET_BENEFI').AsString)));

          qryTemporaria.FieldByName('DET_APAREL').AsString := IIF(blnDocAntACfgVidOuMadOuMtL, 'N', FieldByName('DET_APAREL').AsString);
          qryTemporaria.FieldByName('DET_PERAPA').AsFloat  := FieldByName('DET_PERAPA').AsFloat;
          qryTemporaria.FieldByName('DET_BENEFI').AsString := IIF(blnDocAntACfgVidOuMadOuMtL, 'N', FieldByName('DET_BENEFI').AsString);
          qryTemporaria.FieldByName('DET_PERBEN').AsFloat  := FieldByName('DET_PERBEN').AsFloat;
        End;

        qryTemporaria.FieldByName('DET_UNIORI').AsFloat    := FieldByName('DET_UNIORI').AsFloat;
        qryTemporaria.FieldByName('DET_UNIVIS').AsFloat    := FieldByName('DET_UNIVIS').AsFloat;
        qryTemporaria.FieldByName('DET_TAXJUR').AsFloat    := FieldByName('DET_TAXJUR').AsFloat;
        qryTemporaria.FieldByName('DET_VAL_RT').AsFloat    := FieldByName('DET_VAL_RT').AsFloat;

        qryTemporaria.FieldByName('DET_VDESST').AsFloat    := FieldByName('DET_VDESST').AsFloat;
        qryTemporaria.FieldByName('DET_MDESST').AsString   := FieldByName('DET_MDESST').AsString;

        {**************************************************}
        {* QUANDO NAO EXISTIR DESESP PEGA O UNITAR DIRETO *}
        {* P\ EVITAR PROBLEMA DE ARREDONDAMENTO           *}
        {* QUANDO ESCOLHER DEVOLVER DOCUMENTOS COMPLETA-  *}
        {* MENTE E NÃO TEVE NENHUMA DEVOLUÇÃO PARCIAL,    *}
        {* USA UNITARIO DIRETO, E IRÁ DAR DESCONTO DEPOIS *}
        {********************************************MV,JB*}

        If (Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
        Begin
          qryTemporaria.FieldByName('DET_UNITAR').AsFloat := FieldByName('DET_UNITAR').AsFloat;
        End
        {***********************************************************************************}
        {* O CAMPO "DET_DEDVCF" FOI INCLUIDO INICIALMENTE NA REVISÃO "70039" PARA TAVARES. *}
        {* O CAMPO VAI CONTINUAR GRAVANDO, PORÉM, NÃO VAI MAIS SER UTILIZADO NO UNITÁRIO   *}
        {* DA DEVOLUÇÃO, ESTÁ CAUSANDO PROBLEMAS NA HIDROMAR, REQUISITO: "41598".          *}
        {* A ALTERAÇÃO SERÁ FEITA DESSA FORMA CASO HAJA A NECESSIDADE DE UTILIZAR ESSE     *}
        {* CAMPO NO FUTURO.                                                                *}
        {********************************************************************************RN*}
        Else If fCfgSis('SUGPDV') = '1' Then //Configurado para trazer como sugestao o preco praticado na venda
        Begin
          If (FieldByName('DET_DESESP').AsFloat > 0) And ((Not blnDevolucaoCompleta) Or (blnDevolucaoParcialAnterior)) Then
            qryTemporaria.FieldByName('DET_UNITAR').AsFloat  := (FieldByName('DET_TOTITE').AsFloat - FieldByName('DET_DESESP').AsFloat) / FieldByName('DET_QTDORI').AsFloat
          Else
            qryTemporaria.FieldByName('DET_UNITAR').AsFloat := FieldByName('DET_UNITAR').AsFloat;
        End
        Else
        Begin
          //Sempre trazer o preco liquido independente de devolucao completa ou parcial
          If (FieldByName('DET_DESESP').AsFloat > 0) Then
            qryTemporaria.FieldByName('DET_UNITAR').AsFloat  := (FieldByName('DET_TOTITE').AsFloat - FieldByName('DET_DESESP').AsFloat) / FieldByName('DET_QTDORI').AsFloat
          Else
            qryTemporaria.FieldByName('DET_UNITAR').AsFloat := FieldByName('DET_UNITAR').AsFloat;

          //Se preco praticado na venda (liquido) for maior que o preco a vista deve trazer como sugestao o preco a vista
          If fCfgSis('SUGPDV') = '2' Then
          Begin
            fltMenorValorAVis := fFormataFloat(qryTemporaria.FieldByName('DET_UNIVIS').AsFloat, fMaxDecUni);
          End
          Else
          Begin
           fltMenorValorAVis := fFormataFloat(fRetPrecoVenda(qryTemporaria.FieldByName('DET_CODITE').AsString, qryTemporaria.FieldByName('DET_TABPRE').AsString), fMaxDecUni);
           fltValPromocAtual := fFormataFloat(fRetornaValorPromocional(qryTemporaria.FieldByName('DET_CODITE').AsString, strCodCli, qryTemporaria.FieldByName('DET_TABPRE').AsString), fMaxDecUni);

           If (fltValPromocAtual <> 0) Then
             fltMenorValorAVis := fFormataFloat(Min(fltMenorValorAVis, fltValPromocAtual), fMaxDecUni);
          End;

          If (fltMenorValorAVis <> 0) And (fFormataFloat(qryTemporaria.FieldByName('DET_UNITAR').AsFloat, fMaxDecUni) > fltMenorValorAVis) Then
            qryTemporaria.FieldByName('DET_UNITAR').AsFloat := fltMenorValorAVis;
        End;

        qryTemporaria.FieldByName('DET_PRECUS').AsFloat    := FieldByName('DET_PRECUS').AsFloat;
        qryTemporaria.FieldByName('DET_PRECU2').AsFloat    := FieldByName('DET_PRECU2').AsFloat;
        qryTemporaria.FieldByName('DET_OUTVAL').AsFloat    := FieldByName('DET_OUTVAL').AsFloat;
        qryTemporaria.FieldByName('DET_ICMSAI').AsFloat    := FieldByName('DET_ICMSAI').AsFloat;
        qryTemporaria.FieldByName('DET_IMPFED').AsFloat    := FieldByName('DET_IMPFED').AsFloat;
        qryTemporaria.FieldByName('DET_DESOPE').AsFloat    := FieldByName('DET_DESOPE').AsFloat;

        qryTemporaria.FieldByName('DET_PREMED').AsFloat    := FieldByName('DET_PREMED').AsFloat;
        qryTemporaria.FieldByName('DET_IMPULT').AsFloat    := FieldByName('DET_IMPULT').AsFloat;
        qryTemporaria.FieldByName('DET_PREULT').AsFloat    := FieldByName('DET_PREULT').AsFloat;

        qryTemporaria.FieldByName('DET_TOTCUS').AsFloat    := FieldByName('DET_PRECUS').AsFloat * qryTemporaria.FieldByName('DET_QTDITE').AsFloat;
        qryTemporaria.FieldByName('DET_TOTCU2').AsFloat    := FieldByName('DET_PRECU2').AsFloat * qryTemporaria.FieldByName('DET_QTDITE').AsFloat;
        qryTemporaria.FieldByName('DET_TOTITE').AsFloat    := qryTemporaria.FieldByName('DET_UNITAR').AsFloat * qryTemporaria.FieldByName('DET_QTDITE').AsFloat;

        {******************************************************}
        {* SE JÁ HOUVE DEVOLUÇÃO PARCIAL, NÃO UTILIZA DESESP. *}
        {******************************************************}

        If (Not Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
        Begin
          If Not blnDevolucaoParcialAnterior Then
          Begin
            If fCfgSis('SUGPDV') = '1' Then //Configurado para trazer como sugestao o preco praticado na venda
              qryTemporaria.FieldByName('DET_DESESP').AsFloat  := FieldByName('DET_DESESP').AsFloat;

            qryTemporaria.FieldByName('DET_TOTFRE').AsFloat    := FieldByName('DET_TOTFRE').AsFloat;
            qryTemporaria.FieldByName('DET_DESACE').AsFloat    := FieldByName('DET_DESACE').AsFloat;
          End;
        End;

        qryTemporaria.FieldByName('DET_CODACA').AsString   := FieldByName('DET_CODACA').AsString;
        qryTemporaria.FieldByName('DET_EMPACA').AsString   := FieldByName('DET_EMPACA').AsString;
        qryTemporaria.FieldByName('DET_PROACA').AsString   := FieldByName('DET_PROACA').AsString;
        qryTemporaria.FieldByName('DET_NOTESP').AsString   := FieldByName('DET_NOTESP').AsString;
        qryTemporaria.FieldByName('DET_CLAFIS').AsString   := FieldByName('DET_CLAFIS').AsString;
        qryTemporaria.FieldByName('DET_EMPORI').AsString   := FieldByName('DET_EMPORI').AsString;
        qryTemporaria.FieldByName('DET_TIP_FC').AsString   := FieldByName('DET_TIP_FC').AsString;
        qryTemporaria.FieldByName('DET_TIPFRE').AsString   := FieldByName('GER_TIPFRE').AsString;
        qryTemporaria.FieldByName('DET_ORDPRO').AsString   := FieldByName('DET_ORDPRO').AsString;
        qryTemporaria.FieldByName('AUTOINCREM').AsInteger  := intAutInc;
        qryTemporaria.FieldByName('DET_AUTOIN').AsString   := FieldByName('DET_AUTOIN').AsString;
        qryTemporaria.FieldByName('AUX_VENPRE').AsString   := IIF(LeftStr(FieldByName('AUX_VENPRE').AsString, 1) = 'S', 'SIM', 'NÃO');
        qryTemporaria.FieldByName('AUX_UTINPS').AsString   := FieldByName('AUX_UTINPS').AsString;
        qryTemporaria.FieldByName('DET_ATIVAC').AsString   := FieldByName('DET_ATIVAC').AsString;
        qryTemporaria.FieldByName('DET_SEQCOM').AsString   := FieldByName('DET_SEQCOM').AsString;
        qryTemporaria.FieldByName('AUX_OPCDOC').AsString   := FieldByName('AUX_OPCDOC').AsString;
        qryTemporaria.FieldByName('DET_QTDCAR').AsFloat    := fRetSomaQuantidadesJaDevolvidasComEsseAutInc(FieldByName('DET_AUTOIN').AsString);
        qryTemporaria.FieldByName('AUX_NUMDRW').AsString   := FieldByName('AUX_NUMDRW').AsString;
        qryTemporaria.FieldByName('DET_NUMDRW').AsString   := FieldByName('DET_NUMDRW').AsString;
        qryTemporaria.FieldByName('DET_NUM_PD').AsString   := FieldByName('DET_NUM_PD').AsString;
        qryTemporaria.FieldByName('DET_ESP_PD').AsString   := FieldByName('DET_ESP_PD').AsString;
        qryTemporaria.FieldByName('DET_EMP_PD').AsString   := FieldByName('DET_EMP_PD').AsString;
        qryTemporaria.FieldByName('DET_FRECOT').AsString   := FieldByName('DET_FRECOT').AsString;
        qryTemporaria.FieldByName('AUX_CODPRJ').AsString   := FieldByName('AUX_CODPRJ').AsString;
        qryTemporaria.FieldByName('GER_CODTRA').AsString   := FieldByName('GER_CODTRA').AsString;
        qryTemporaria.FieldByName('DET_ITEREF').AsString   := FieldByName('DET_NITEM_').AsString;
        qryTemporaria.FieldByName('DET_CHVREF').AsString   := fRetChaveAcesso(FieldByName('DET_NUMDOC').AsString,
                                                                              FieldByName('DET_ESPDOC').AsString,
                                                                              FieldByName('DET_FORCLI').AsString,
                                                                              FieldByName('DET_CODEMP').AsString,
                                                                              '',
                                                                              FieldByName('DET_TIP_FC').AsString);

        If Pos(strOpcDoc,'OF_') > 0 Then
        Begin
          traTranferencia := fGetTransfEstoque(FieldByName('DET_NUMDOC').AsString, FieldByName('DET_FORCLI').AsString);
          If Not fEmptyStr(traTranferencia.NumDoc) Then
          Begin
            qryTemporaria.FieldByName('GER_TIPFAT').AsString   := traTranferencia.TipDoc;
            qryTemporaria.FieldByName('GER_NUMFAT').AsString   := traTranferencia.NumDoc;
            qryTemporaria.FieldByName('GER_EMPFAT').AsString   := traTranferencia.EmpDoc;
          End;
        End;

        qryTemporaria.Post;
        Inc(intAutInc);

        Next;

      End;
    Finally
      dicFulfillCache.Free;
    End;

  End;

  If Assigned(cdsGenDet) Then
    FreeAndNil(cdsGenDet);

  FreeAndNil(cdsGenNot);
  FreeAndNil(dspGenNot);

  FreeAndNil(qryGenDet);
  FreeAndNil(qryGenNot);
end;

procedure TFatVenda.pCarregaItensMovRcd(strInRqCpParam: String = '');
  Var
    frmFatRequisicaoCompras : TfrmFatRequisicaoCompras;
begin
  If fEmptyStr(strInRqCpParam) Then
    strInRqCpParam := strInRqCp;

  If fEmptyStr(strInRqCpParam) Then
    Exit;

  pCriarFormularios(TfrmFatRequisicaoCompras, frmFatRequisicaoCompras);
  Try
    frmFatRequisicaoCompras.strCodigo := fCampoTabela('RCG_CODIGO', 'MOVRCG', ['AUTOINCREM'], [strInRqCpParam]);
    frmFatRequisicaoCompras.fAbreConsulta;
    pCloneDataSet(cdsMovRcd, frmFatRequisicaoCompras.cdsConsulta);
  Finally
    pFreeAndNil(frmFatRequisicaoCompras);
  End;
end;

procedure TFatVenda.pCarregaEstruturaItemVidroPedOrc(strAutIncFatDor: String);
begin
  If Not Assigned(objEstruturaVidros) Then
    Exit;

  If fCfgSis('CNDVEN') = 'I' Then
  Begin
    pAtualizaInformacoesCondPagamento;
    pCalculaTaxVpr;
  End;

  If (fEhItemVendaVidro(cdsVenda.FieldByName('ITE_CODITE').AsString)) Then
  Begin
    objEstruturaVidros.pCarregarEstruturaPedOrc(strAutIncFatDor);
    objEstruturaVidros.strTabelaPreco := cdsVenda.FieldByName('ITE_TABPRE').AsString;
    objEstruturaVidros.strEntregaFutura := cdsVenda.FieldByName('ITE_ENTFUT').AsString;
    objEstruturaVidros.strEmpresaItem := cdsVenda.FieldByName('ITE_EMPITE').AsString;
    objEstruturaVidros.pRecalcularPrecos(fCalculaAliquota);

    If objEstruturaVidros.blnTemSubItensDigitados Then
    Begin
      With TSubItensVidroManager.fCalcularTotais(objEstruturaVidros.subItensEstrutura), cdsVenda Do
      Begin
        Edit;

        FUniVis := fltPrecoTabelaTotal;
        FUniOri := fltPrecoTabelaTotal;
        FTaxJur := 0.00;

        If (fAplicaTaxaJuros And fAplicarTaxaJurosPrecoSugestao) Then
        Begin
          FTaxJur := fGetTaxVprItem(FieldByName('ITE_CODITE').AsString, FieldByName('ITE_EMPITE').AsString);
          FUniOri := FUniOri + fFormataFloat(FUniOri * (FTaxJur / 100.0), 04);
        End;

        pCalculaValorRT(FUniOri, FVal_RT);

        FieldByName('ITE_TAXJUR').AsFloat := FTaxJur;
        FieldByName('ITE_UNIVIS').AsFloat := FUniVis;
        FieldByName('ITE_UNIORI').AsFloat := FUniOri;
        FieldByName('ITE_VAL_RT').AsFloat := FVal_RT;

        FieldByName('ITE_CUSITE').AsFloat := fltPrecoCustoTotal;
        FieldByName('ITE_PRECUS').AsFloat := fltPrecoCustoTotal;
        FieldByName('ITE_PRECU2').AsFloat := fltPrecoCustoRealTotal;

        FieldByName('ITE_TOTCUS').AsFloat := fltPrecoCustoTotal * FieldByName('ITE_QTDITE').AsFloat;
        FieldByName('ITE_TOTCU2').AsFloat := fltPrecoCustoRealTotal * FieldByName('ITE_QTDITE').AsFloat;

        FieldByName('ITE_PREVE1').AsFloat := fltPrecoVenda1Total;
        FieldByName('ITE_PREVE2').AsFloat := fltPrecoVenda2Total;
        FieldByName('ITE_PREVE3').AsFloat := fltPrecoVenda3Total;
        FieldByName('ITE_PREVE4').AsFloat := fltPrecoVenda4Total;
        FieldByName('ITE_PREVE5').AsFloat := fltPrecoVenda5Total;
        FieldByName('ITE_PREVE6').AsFloat := fltPrecoVenda6Total;
        FieldByName('ITE_PREVE7').AsFloat := fltPrecoVenda7Total;

        If fltPrecoVendaTotal <> 0 Then
        Begin
          FieldByName('ITE_ICMSAI').AsFloat := fltIcmsSaidaTotal / fltPrecoVendaTotal * 100;
          FieldByName('ITE_IMPFED').AsFloat := fltImpostosFederaisTotal / fltPrecoVendaTotal * 100;
          FieldByName('ITE_DESOPE').AsFloat := fltDespesasOperacionaisTotal / fltPrecoVendaTotal * 100;
        End
        Else
        Begin
          FieldByName('ITE_ICMSAI').AsFloat := 0;
          FieldByName('ITE_IMPFED').AsFloat := 0;
          FieldByName('ITE_DESOPE').AsFloat := 0;
        End;

        FieldByName('ITE_OUTVAL').AsFloat := fltOutrosValoresTotal;
        FieldByName('ITE_PREMED').AsFloat := fltPrecoMedioTotal;
        FieldByName('ITE_PREULT').AsFloat := fltPrecoUltimaCompraTotal;
        FieldByName('ITE_IMPULT').AsFloat := fltPrecoUltimaComImpostosTotal;
        FieldByName('ITE_TOTULT').AsFloat := fltPrecoUltimaCompraTotal * FieldByName('ITE_QTDITE').AsFloat;
        FieldByName('ITE_TOTIMP').AsFloat := fltPrecoUltimaComImpostosTotal * FieldByName('ITE_QTDITE').AsFloat;

        Post;

        objEstruturaVidros.pSalvarEstrutura(FieldByName('AUTOINCREM').AsInteger);
      End;
    End;
  End;
end;

procedure TFatVenda.pAcertaPrecosItemNormal(intAutInc: Integer = -1);
  var
    item: TDadosFechamento;
    qryIteger: TUniQuery;
    strFilter: String;
begin
  qryIteger := fCriaQuery;

  strFilter := 'ITE_IDEPRO = ' + QuotedStr('NOR') + ' AND ITE_CODACA = ' + QuotedStr('');

  If intAutInc > -1 Then
    strFilter := strFilter + ' AND AUTOINCREM = ' + IntToStr(intAutInc);

  pPreencheMatrizFechamento(strFilter);

  If Assigned(pgbStatusGravacao) Then
  Begin
    pgbStatusGravacao.Position := 0;
    pgbStatusGravacao.Properties.Max := Length(arrMatItens);
  End;

  For item In arrMatItens Do
  Begin
    If Assigned(pgbStatusGravacao) Then
    Begin
      pStepStatusGravacao;
      pInfoStatusGravacao('Aguarde... Calculando Preços dos ' +
        'Produtos...' + FloatToStr(pgbStatusGravacao.Position) + '/' + FloatToStr(pgbStatusGravacao.Properties.Max));
    End;

    If (item.strIdePro = 'NOR') And (fEmptyStr(item.strCodAca)) Then
    Begin
      With qryIteger, SQL Do
      Begin
        Close;
        Clear;

        Add('SELECT ');
        Add('  ITE_PREVE1, ');
        Add('  ITE_PREVE2, ');
        Add('  ITE_PREVE3, ');
        Add('  ITE_PREVE4, ');
        Add('  ITE_PREVE5, ');
        Add('  ITE_PREVE6, ');
        Add('  ITE_PREVE7, ');
        Add('  ITE_PRECUS, ');
        Add('  ITE_OUTVAL, ');
        Add('  ITE_ICMSAI, ');
        Add('  ITE_IMPFED, ');
        Add('  ITE_DESOPE, ');
        Add('  ITE_PREMED, ');
        Add('  ITE_IMPULT, ');
        Add('  ITE_PREULT  ');
        Add('FROM ');
        Add('  ITEGER ');
        Add('WHERE ');
        Add('  ITE_CODITE = :CODITE AND ');
        Add('  ITE_CODEMP = :EMPITE ');

        ParamByName('CODITE').AsString := item.strCodIte;

        If Not fEmptyStr(item.strEmpIte) Then
          ParamByName('EMPITE').AsString := item.strEmpIte
        Else
          ParamByName('EMPITE').AsString := VS_strCodEmp;

        Open;

        If Not IsEmpty And cdsVenda.Locate('AUTOINCREM', item.intAutInc, []) Then
        Begin
          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_PREMED').AsFloat := FieldByName('ITE_PREMED').AsFloat;
          cdsVenda.FieldByName('ITE_IMPULT').AsFloat := FieldByName('ITE_IMPULT').AsFloat;
          cdsVenda.FieldByName('ITE_PREULT').AsFloat := FieldByName('ITE_PREULT').AsFloat;
          cdsVenda.FieldByName('ITE_TOTMED').AsFloat := FieldByName('ITE_PREMED').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          cdsVenda.FieldByName('ITE_TOTULT').AsFloat := FieldByName('ITE_PREULT').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          cdsVenda.FieldByName('ITE_TOTIMP').AsFloat := FieldByName('ITE_IMPULT').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;
          cdsVenda.Post;
        End;
      End;
    End;
  End;

  FreeAndNil(qryIteger);
end;

procedure TFatVenda.pAcertaTabelaPrecoTinta(strNumDoc, strEspDoc, strCodEmp: String; blnAtribuiCusIte: Boolean = False);
  var
    qryAux: TUniQuery;
    strCodAca: String;
    strEmpAca: String;
    intContador: Integer;
    dicRetorno: TDicionario;
    fltPreCusTin: Double;
    fltPreVe1Tin: Double;
    fltPreVe2Tin: Double;
    fltPreVe3Tin: Double;
    fltPreVe4Tin: Double;
    fltPreVe5Tin: Double;
    fltPreVe6Tin: Double;
    fltPreVe7Tin: Double;
    strAbrDet : String;
    strTabTin : String;
    strTabPed : String;
    strTabelaTinta: String;
    blnExisteItemVencidoTmp: Boolean;
    blnExisteItemVencido: Boolean;
begin
  blnExisteItemVencido := False;

  If Not Assigned(pTintaRetornaTabelaPreco) Then
    Exit;

  If (Pos(strEspDoc, 'OR_PD_PR_') > 0) Then
  Begin
    strAbrDet := 'FDO_';
    strTabTin := 'TINDOR';
  End
  Else
  Begin
    strAbrDet := 'DET_';
    strTabTin := 'TINDET';
  End;

  dicRetorno := TDicionario.Create;
  qryAux := fCriaQuery(Self);

  With qryAux Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add('SELECT ');
    If (Pos(strEspDoc, 'OR_PD_PR_') > 0) Then
      SQL.Add('  IFNULL(FATDOR.FDO_PROMOC,"N") AS FDO_PROMOC,   ');
    SQL.Add('  ' + strTabTin + '.*, ');
    SQL.Add('  FOR_FATACE, ');
    SQL.Add('  FORTIN.* ');
    SQL.Add('FROM ');
    SQL.Add('  ' + strTabTin + ' ');
    SQL.Add('  JOIN FORTIN ON FOR_CODACA = ' + strAbrDet + 'CODACA AND ');
    SQL.Add('                 FOR_EMPACA = ' + strAbrDet + 'EMPACA ');
    If (Pos(strEspDoc, 'OR_PD_PR_') > 0) Then
    Begin
      SQL.Add('    LEFT JOIN FATDOR ON FATDOR.FDO_SEQGER = '+ strTabTin + '.FDO_SEQGER AND  ');
      SQL.Add('                        FATDOR.FDO_CODITE = '+ strTabTin + '.FDO_CODITE AND  ');
      SQL.Add('                        FATDOR.FDO_CODEMP = '+ strTabTin + '.FDO_CODEMP AND  ');
      SQL.Add('                        FATDOR.FDO_CODACA = '+ strTabTin + '.FDO_CODACA AND  ');
      SQL.Add('                        FATDOR.FDO_EMPACA = '+ strTabTin + '.FDO_EMPACA      ');
    End;
    SQL.Add('WHERE ');
    SQL.Add('  ' + strTabTin + '.' + strAbrDet + 'NUMDOC = :NUMDOC AND ');
    SQL.Add('  ' + strTabTin + '.' + strAbrDet + 'ESPDOC = :ESPDOC AND ');
    SQL.Add('  ' + strTabTin + '.' + strAbrDet + 'CODEMP = :CODEMP AND ');
    SQL.Add('  ' + strTabTin + '.' + strAbrDet + 'CODCLI = :CODCLI ');
    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODCLI').AsString := Self.strCodCli;
    Open;
  End;

  If Assigned(pgbStatusGravacao) Then
  Begin
    pgbStatusGravacao.Position := 0;
    pgbStatusGravacao.Properties.Max := qryAux.RecordCount;
  End;

  strTabelaTinta := fTabelaPrecoTinta(Self.strCodCli, '', '', False, False, False);

  strTabPed := Self.strTabPre;
  dicRetorno['tabpre'] := strTabelaTinta; //IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);

  If (Pos(strEspDoc, 'OR_PD_PR_') > 0) And (Not blnAlterouClienteConfirmacaoPedidos) Then
    pCarregarClientePedidoOrcamento(Self, strCodEmp);

  Self.strTabPre := strTabPed;

  pPegaDadosFiscais(fTrocaUFEndEntrega, strCliIes, strMicEmp, fGetUFEmpresa(''), True);

  Try

    While (Not qryAux.Eof) Do
    Begin
      pStepStatusGravacao;
      pInfoStatusGravacao('Aguarde... Calculando Tabelas de Preços Tintas...' + intToStr(qryAux.RecNo) + '/' + intToStr(qryAux.RecordCount));


      strCodAca := qryAux.FieldByName(strAbrDet + 'CODACA').AsString;
      strEmpAca := qryAux.FieldByName(strAbrDet + 'EMPACA').AsString;

      dicRetorno.Limpar;

      If cdsVenda.Locate('ITE_CODACA;ITE_EMPACA', VarArrayOf([strCodAca, strEmpAca]), []) Then
      Begin
        dicRetorno['idepro'] := qryAux.FieldByName(strAbrDet + 'IDEPRO').AsString;
        dicRetorno['montad'] := qryAux.FieldByName(strAbrDet + 'MONTAD').AsString;
        dicRetorno['a_n_o_'] := qryAux.FieldByName(strAbrDet + 'A_N_O_').AsString;
        dicRetorno['itetin'] := qryAux.FieldByName(strAbrDet + 'ITETIN').AsString;
        dicRetorno['tippre'] := qryAux.FieldByName(strAbrDet + 'TIPPRE').AsString;
        dicRetorno['itebas'] := qryAux.FieldByName(strAbrDet + 'CODITE').AsString;
        dicRetorno['coddil'] := qryAux.FieldByName(strAbrDet + 'CODDIL').AsString;
        dicRetorno['pordil'] := qryAux.FieldByName(strAbrDet + 'PORDIL').AsFloat;
        dicRetorno['iteemb'] := cdsVenda.FieldByName('ITE_ITEEMB').AsString;

        dicRetorno['empite'] := cdsVenda.FieldByName('ITE_EMPITE').AsString;

        If fEmptyStr(dicRetorno['empite']) then
          dicRetorno['empite'] := cdsVenda.FieldByName('ITE_EMPPRD').AsString;

        If fEmptyStr(dicRetorno['empite']) then
          dicRetorno['empite'] := qryAux.FieldByName(strAbrDet + 'CODEMP').AsString;

        dicRetorno['codemp'] := dicRetorno['empite'];

        If cdsVenda.FieldByName('ITE_VOLPRO').AsFloat = 0 Then
          dicRetorno['volpro'] := 1
        Else
          dicRetorno['volpro'] := cdsVenda.FieldByName('ITE_VOLPRO').AsFloat;
        If qryAux.FindField(strAbrDet + 'LINLIN') <> Nil Then
          dicRetorno['linha_'] := qryAux.FieldByName(strAbrDet + 'LINLIN').AsString
        Else If qryAux.FindField(strAbrDet + 'LINTIN') <> Nil Then
          dicRetorno['linha_'] := qryAux.FieldByName(strAbrDet + 'LINTIN').AsString
        Else
          dicRetorno['linha_'] := '';
        dicRetorno['qtdemb'] := qryAux.FieldByName(strAbrDet + 'QTDITE').AsFloat;
        dicRetorno['descri'] := qryAux.FieldByName(strAbrDet + 'DESCRI').AsString;
        dicRetorno['complementob'] := qryAux.FieldByName('FOR_ITECOB').AsString;
        dicRetorno['tipcor'] := qryAux.FieldByName('FOR_TIPCOR').AsString;
        dicRetorno['catali'] := qryAux.FieldByName(strAbrDet + 'CATALI').AsString;
        dicRetorno['oprflj'] := strOprFlj;
        dicRetorno['empprd'] := fCfgSis('EMPPRD');
        dicRetorno['emp_cd'] := fCfgSis('EMP_CD');
        dicRetorno['Cd_S_N'] := IIF(blnEnt_CD, 'S', 'N');
        dicRetorno['empfat'] := IIF(blnEmpFat, VS_strCodEmp, '');
        dicRetorno['FatS_N'] := IIF(blnEmpFat, 'S', 'N');

        For intContador := 1 To 20 Do
        Begin
          If fEmptyStr(qryAux.FieldByName(strAbrDet + 'FORM' + fStrZero(intContador, 2)).AsString) Then
            Break;

          dicRetorno['base' + fStrZero(intContador, 2)] := qryAux.FieldByName(strAbrDet + 'FORM' + fStrZero(intContador, 2)).AsString;
          dicRetorno['qtdb' + fStrZero(intContador, 2)] := qryAux.FieldByName(strAbrDet + 'QTDB' + fStrZero(intContador, 2)).AsFloat /
                                                           qryAux.FieldByName(strAbrDet + 'QTDITE').AsFloat;
        End;

        dicRetorno['tabpre'] := strTabelaTinta; //IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);
        dicRetorno.AdicionarObjeto('calculadorFatVendas', FFatVendasCalculador);

        If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
        Begin
          pSetaEmpresaLogadaTinta(VS_strCodEmp);
          dicRetorno['empprd'] := VS_strCodEmp;
        End
        Else If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPPRD').AsString) Then
          pSetaEmpresaLogadaTinta(cdsVenda.FieldByName('ITE_EMPPRD').AsString)
        Else If Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPITE').AsString) Then
          pSetaEmpresaLogadaTinta(cdsVenda.FieldByName('ITE_EMPITE').AsString);

        Try
          try
            pTintaRetornaTabelaPreco(dicRetorno, qryAux.FieldByName('FOR_FATACE').AsFloat);
          except
            on E: EAbort do
            begin
              blnFecharForm := True;

              raise Exception.CreateFmt('Não foi possível determinar a formulação para a tinta: [%s]'
                , [qryAux.FieldByName(strAbrDet + 'DESCRI').AsString]);
            end;

            on E: Exception do
            begin
              blnFecharForm := True;
              raise Exception.CreateFmt(E.Message,[]);
            end;
          end;
        Finally
          pSetaEmpresaLogadaTinta(VS_strCodEmp);
        End;

        If (IfNull(dicRetorno['formula_nao_encontrada'], '') = 'S') And (strOpcDoc = 'CF') Then
        Begin
          pAcertaTabelaPrecoTintaFormulacaoNaoEncontradaConfirmacaoDocumentos(cdsVenda.FieldByName('AUTOINCREM').AsInteger);
        End
        Else
        Begin
          fltPreCusTin := IfNull(dicRetorno['precus'], 0.0);
          fltPreVe1Tin := IfNull(dicRetorno['preve1'], 0.0);
          fltPreVe2Tin := IfNull(dicRetorno['preve2'], 0.0);
          fltPreVe3Tin := IfNull(dicRetorno['preve3'], 0.0);
          fltPreVe4Tin := IfNull(dicRetorno['preve4'], 0.0);
          fltPreVe5Tin := IfNull(dicRetorno['preve5'], 0.0);
          fltPreVe6Tin := IfNull(dicRetorno['preve6'], 0.0);
          fltPreVe7Tin := IfNull(dicRetorno['preve7'], 0.0);

          cdsVenda.Edit;

          If (blnAtribuiCusIte) Then
            cdsVenda.FieldByName('ITE_CUSITE').AsFloat := fltPreCusTin;

          cdsVenda.FieldByName('ITE_PRECUS').AsFloat := fltPreCusTin;
          cdsVenda.FieldByName('ITE_PREVE1').AsFloat := fltPreVe1Tin;
          cdsVenda.FieldByName('ITE_PREVE2').AsFloat := fltPreVe2Tin;
          cdsVenda.FieldByName('ITE_PREVE3').AsFloat := fltPreVe3Tin;
          cdsVenda.FieldByName('ITE_PREVE4').AsFloat := fltPreVe4Tin;
          cdsVenda.FieldByName('ITE_PREVE5').AsFloat := fltPreVe5Tin;
          cdsVenda.FieldByName('ITE_PREVE6').AsFloat := fltPreVe6Tin;
          cdsVenda.FieldByName('ITE_PREVE7').AsFloat := fltPreVe7Tin;
          cdsVenda.FieldByName('ITE_MONTAD').AsString := dicRetorno['montad'];
          cdsVenda.FieldByName('ITE_A_N_O_').AsString := dicRetorno['a_n_o_'];

          cdsVenda.FieldByName('ITE_OUTVAL').AsFloat := IfNull(dicRetorno['outval'], 0);
          cdsVenda.FieldByName('SAV_OUTVAL').AsFloat := IfNull(dicRetorno['outval'], 0);

          If IfNull(dicRetorno['acerto'], 'N') = 'S' Then
          Begin
            cdsVenda.FieldByName('ITE_ICMSAI').AsFloat := IfNull(dicRetorno['icmsai'] / dicRetorno['preve' + strTabelaTinta + '_original'] * 100, 0);  //dicRetorno['preve' + IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin)] * 100, 0);
            cdsVenda.FieldByName('ITE_IMPFED').AsFloat := IfNull(dicRetorno['impfed'] / dicRetorno['preve' + strTabelaTinta + '_original'] * 100, 0);  //dicRetorno['preve' + IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin)] * 100, 0);
            cdsVenda.FieldByName('ITE_DESOPE').AsFloat := IfNull(dicRetorno['desope'] / dicRetorno['preve' + strTabelaTinta + '_original'] * 100, 0);  //dicRetorno['preve' + IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin)] * 100, 0);
          End
          Else
          Begin
            cdsVenda.FieldByName('ITE_ICMSAI').AsFloat := IfNull(dicRetorno['icmsai'] / dicRetorno['preve' + strTabelaTinta] * 100, 0);  //dicRetorno['preve' + IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin)] * 100, 0);
            cdsVenda.FieldByName('ITE_IMPFED').AsFloat := IfNull(dicRetorno['impfed'] / dicRetorno['preve' + strTabelaTinta] * 100, 0);  //dicRetorno['preve' + IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin)] * 100, 0);
            cdsVenda.FieldByName('ITE_DESOPE').AsFloat := IfNull(dicRetorno['desope'] / dicRetorno['preve' + strTabelaTinta] * 100, 0);  //dicRetorno['preve' + IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin)] * 100, 0);
          End;

          cdsVenda.FieldByName('ITE_PREMED').AsFloat := IfNull(dicRetorno['premed'], 0.0);
          cdsVenda.FieldByName('ITE_IMPULT').AsFloat := IfNull(dicRetorno['impult'], 0.0);
          cdsVenda.FieldByName('ITE_PREULT').AsFloat := IfNull(dicRetorno['preult'], 0.0);
          cdsVenda.FieldByName('ITE_PRCTIN').AsFloat := IfNull(dicRetorno['prctin'], 0.0);
          cdsVenda.FieldByName('ITE_TOTULT').AsFloat := cdsVenda.FieldByName('ITE_PREULT').AsFloat * qryAux.FieldByName(strAbrDet + 'QTDITE').AsFloat;
          cdsVenda.FieldByName('ITE_TOTIMP').AsFloat := cdsVenda.FieldByName('ITE_IMPULT').AsFloat * cdsVenda.FieldByName('ITE_QTDITE').AsFloat;

          cdsVenda.FieldByName('ITE_DOPTIN').AsFloat := IfNull(dicRetorno['desopetinta'], 0.0);

          if Not((cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') And
                 (not fEmptyStr(cdsVenda.FieldByName('ITE_PROKIT').AsString)) And
                 (fCfgSis('PROKIT', varBoolean))) And
             (Not ((strOpcDoc = 'CP') And blnBaiEntFut)) then
          cdsVenda.FieldByName('ITE_PROMOC').AsString := IIF(fEmptyStr(IfNull(dicRetorno['promoc'], 'N')), 'N', IfNull(dicRetorno['promoc'], 'N'));

          cdsVenda.Post;
        End;

        cdsVenda.Edit;
        //Variacao da tabela de preco
        If fEmptyStr(strTabelaTinta) Or (cdsVenda.FieldByName('ITE_PREVE' + strTabelaTinta).AsFloat = 0) Then
          cdsVenda.FieldByName('ITE_PRETAB').AsFloat := cdsVenda.FieldByName('ITE_UNIORI').AsFloat
        Else
          cdsVenda.FieldByName('ITE_PRETAB').AsFloat := cdsVenda.FieldByName('ITE_PREVE' + strTabelaTinta).AsFloat +
                                 fFormataFloat(cdsVenda.FieldByName('ITE_PREVE' + strTabelaTinta).AsFloat *
                                              (cdsVenda.FieldByName('ITE_TAXJUR').AsFloat / 100.0), VS_intDecUni);

        cdsVenda.FieldByName('ITE_PRETAB').AsFloat := fFormataFloat(cdsVenda.FieldByName('ITE_PRETAB').AsFloat, VS_intDecUni);

        If fCfgSis('PRETAB', varBoolean) Then
        Begin
          If cdsVenda.FieldByName('ITE_PRETAB').AsFloat <> 0 Then
            cdsVenda.FieldByName('ITE_VARTAB').AsFloat := ((cdsVenda.FieldByName('ITE_UNITAR').AsFloat / cdsVenda.FieldByName('ITE_PRETAB').AsFloat) - 1) * 100;
        End
        Else
        Begin
          If cdsVenda.FieldByName('ITE_UNIORI').AsFloat <> 0 Then
            cdsVenda.FieldByName('ITE_VARTAB').AsFloat := ((cdsVenda.FieldByName('ITE_UNITAR').AsFloat / cdsVenda.FieldByName('ITE_UNIORI').AsFloat) - 1) * 100;
        End;

        If (Pos(strEspDoc, 'OR_PD_PR_') > 0) Then
        Begin
          blnExisteItemVencidoTmp := IIF(fEmptyStr(qryAux.FieldByName('FDO_PROMOC').AsString), 'N', qryAux.FieldByName('FDO_PROMOC').AsString) <>
                                     IIF(fEmptyStr(IfNull(dicRetorno['promoc'], 'N')), 'N', IfNull(dicRetorno['promoc'], 'N'));

          cdsVenda.FieldByName('ITE_DIVPRM').AsString := IIF(blnExisteItemVencidoTmp, 'S', 'N');

          If blnExisteItemVencidoTmp Then
          Begin
            If Not blnExisteItemVencido Then
            Begin
              blnExisteItemVencido := True;
            End;
          End;
        End;

        cdsVenda.Post;

        { ACERTAR ITE_PREMED, ITE_IMPULT, ITE_PREULT CONFORME EMPPRD OU EMPITE }
        If (cdsVenda.FieldByName('ITE_IDEPRO').AsString <> 'NOR') Then
          If (Self.fAcertarCustoTintaMaquina(cdsVenda.FieldByName('ITE_EMPITE').AsString, cdsVenda.FieldByName('ITE_EMPPRD').AsString)) Then
            Self.pAcertaPrecosTinta(cdsVenda.FieldByName('AUTOINCREM').AsInteger, True);
      End;
      qryAux.Next;
    End;
  Finally
    Self.blnCalculouDivergenciaPromo := blnExisteItemVencido;
    FreeAndNil(dicRetorno);
    FreeAndNil(qryAux);
  End;
end;

procedure TFatVenda.pRecalculaTabelasPrecoTinta(blnAlterarStatusPromoSeRecalculaTabelaTintasPrecos: Boolean = True;
                                                blnConsiderarCfgPrecoSugestaoRecalculaTabelaTintasPrecos: Boolean = True;
                                                blnRecalculandoPrecosAbaDep: Boolean = False);
  var
    item: TDadosFechamento;
    dicRetorno: TDicionario;
    stlItensTraMl: TStringList;
    arrBaixaPigmentos: TBaixaPigmentosArray;
    arrFormul: TForMulTinDetArray;
    strTabelaTinta: String;
    strPromocDic: String;
    blnSomenteVerificacao: Boolean;
    intIdx: Integer;
    arrMatItensCop : Array Of TDadosFechamento;
begin

  blnSomenteVerificacao := Self.strAutIncAltPromocTin = 'S';
  Self.strAutIncAltPromocTin := '';

  If Not Assigned(fCalcularTabelasdePreco) Then
    Exit;

  If Not fTemItemTintaNoCdsVenda Then
    Exit;

  SetLength(arrMatItensCop, 0);
  SetLength(arrMatItensCop, Length(Self.arrMatItens));
  For intIdx := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
    arrMatItensCop[intIdx] := Self.arrMatItens[intIdx];

  Try
    dicRetorno := TDicionario.Create;
    stlItensTraMl := TStringList.Create;
    strTabelaTinta := '';

    pPreencheMatrizFechamento;

    For item In arrMatItens Do
    Begin
      dicRetorno.Limpar;
      stlItensTraMl.Clear;
      SetLength(arrBaixaPigmentos, 0);

      If (item.strIdePro <> 'NOR') Then
      Begin
        dicRetorno := TDicionario.Create;
        SetLength(arrBaixaPigmentos, 0);
        stlItensTraMl := TStringList.Create;

        strTabelaTinta := fTabelaPrecoTinta(Self.strCodCli, '', '', False, False, False);

        dicRetorno['itebas'] := item.strCodIte;
        dicRetorno['iteemb'] := item.strIteEmb;
        dicRetorno['coddil'] := item.strCodDil;
        dicRetorno['pordil'] := item.fltPorDil;
        dicRetorno['complementob'] := item.recForTin.strCompB;
        dicRetorno['fatace'] := item.fltFatAce;
        dicRetorno['oprflj'] := strOprFlj;
        dicRetorno['empprd'] := fCfgSis('EMPPRD');
        dicRetorno['emp_cd'] := fCfgSis('EMP_CD');
        dicRetorno['Cd_S_N'] := IIF(blnEnt_CD, 'S', 'N');
        dicRetorno['empfat'] := IIF(blnEmpFat, VS_strCodEmp, '');
        dicRetorno['FatS_N'] := IIF(blnEmpFat, 'S', 'N');

        dicRetorno['empite'] := item.strEmpIte;
        if fEmptyStr(dicRetorno['empite']) then
          dicRetorno['empite'] := item.strEmpPrd;
        if fEmptyStr(dicRetorno['empite']) then
          dicRetorno['empite'] := VS_strCodEmp;

        If blnRecalculandoPrecosAbaDep Then
          dicRetorno['empfat'] := fGetEmpPrecoVendaItemTinta(dicRetorno['empite']);

        dicRetorno['codemp'] := dicRetorno['empite'];
        If blnConsiderarCfgPrecoSugestaoRecalculaTabelaTintasPrecos Then
          If fRegraPrecoSugestaoAtiva = TRegraPrecoSugestao.PrecoDeTabela Then
            dicRetorno['propre'] := True;

        {*******************************************************************}
        {* É NECESSARIO QUE ALTERE A EMPRESA DA DLL DE TINTA DE MAQUINA    *}
        {* PARA QUE CALCULE CORRETAMENTE OS PRECOS DE ACORDO COM A EMPRESA *}
        {* QUE IRA FATURAR O PRODUTO (DARKA).                              *}
        {***************************************************************JC**}
        If fEhDocumentoAbastecimentoPorDepositoUsandoPrecoLocal() Then
          pSetaEmpresaLogadaTinta(VS_strCodEmp)
        Else
          pSetaEmpresaLogadaTinta(dicRetorno['codemp']);

        dicRetorno['descri'] := item.strDesIte;
        dicRetorno['tabpre'] := strTabelaTinta; //IIF(fEmptyStr(Self.strTabTin), Self.strTabPre, Self.strTabTin);
        dicRetorno.AdicionarObjeto('calculadorFatVendas', FFatVendasCalculador);

        If fCalcularTabelasdePreco( item.strIdePro,   // Tipo de Produto
                                    item.strIteTin,   // Item da Tinta
                                    item.strTipPre,   // Tipo de Preço
                                    item.strLinTin,   // Linha da Tinta
                                    item.strCatali,   // Catalizador Utilizado
                                    item.intLazQua,   // Quarto (Lazzumix)
                                    item.fltQtdEmb,   // Quantidade de Embalagem
                                    item.fltQtdIte,   // Quantidade do Item
                                    item.strDesIte,   // Descrição do Item
                                    qryTintaAux,      // Arquivo de Formulas!
                                    item.fltVolPro,   // Volume a ser produzido (Tinta c/ Venda Dinamica)
                                    arrFormul,        // Retorno da Formulação
                                    arrBaixaPigmentos,// Retorno dos Pigmentos a serem baixados
                                    stlItensTraMl,
                                    item.strCodDil,
                                    item.fltPorDil,
                                    item.strDilCon,
                                    item.fltPorCat,
                                    item.recForTin.strTipCor,
                                    item.recForTin.strTextBase,
                                    item.recForTin.intModDil,
                                    dicRetorno ) And cdsVenda.Locate('AUTOINCREM', item.intAutInc, []) Then
        Begin
          strPromocDic := IIF(fEmptyStr(IfNull(dicRetorno['promoc'], 'N')), 'N', IfNull(dicRetorno['promoc'], 'N'));
          If (IfEmptyStr(cdsVenda.FieldByName('ITE_PROMOC').AsString, 'N') <> strPromocDic) Then
            strAutIncAltPromocTin := strAutIncAltPromocTin + cdsVenda.FieldByName('AUTOINCREM').AsString;

          If blnSomenteVerificacao Then
            Continue;

          cdsVenda.Edit;
          cdsVenda.FieldByName('ITE_PREVE1').AsFloat  := IfNull(dicRetorno['preve1'], 0.0);
          cdsVenda.FieldByName('ITE_PREVE2').AsFloat  := IfNull(dicRetorno['preve2'], 0.0);
          cdsVenda.FieldByName('ITE_PREVE3').AsFloat  := IfNull(dicRetorno['preve3'], 0.0);
          cdsVenda.FieldByName('ITE_PREVE4').AsFloat  := IfNull(dicRetorno['preve4'], 0.0);
          cdsVenda.FieldByName('ITE_PREVE5').AsFloat  := IfNull(dicRetorno['preve5'], 0.0);
          cdsVenda.FieldByName('ITE_PREVE6').AsFloat  := IfNull(dicRetorno['preve6'], 0.0);
          cdsVenda.FieldByName('ITE_PREVE7').AsFloat  := IfNull(dicRetorno['preve7'], 0.0);

          If blnAlterarStatusPromoSeRecalculaTabelaTintasPrecos Then
          Begin
            if Not((cdsVenda.FieldByName('ITE_PROMOC').AsString = 'S') And
                   (not fEmptyStr(cdsVenda.FieldByName('ITE_PROKIT').AsString)) And
                   (fCfgSis('PROKIT', varBoolean))) then
            Begin
              cdsVenda.FieldByName('ITE_PROMOC').AsString := strPromocDic;
            End;
          End;

          cdsVenda.Post;
        End;
      End;
    End;

  Finally
    For intIdx := Low(arrMatItensCop) To High(arrMatItensCop) Do
      Self.arrMatItens[intIdx] := arrMatItensCop[intIdx];
    {**********************************************************}
    {* DEVE VOLTAR A EMPRESA LOGADA NOVAMENTE NA DLL DA TINTA *}
    {*  >>> ATENCAO: NAO REMOVER ESTA FUNCAO DO FINNALY <<<   *}
    {******************************************************JC**}
    pSetaEmpresaLogadaTinta(VS_strCodEmp);
    FreeAndNil(stlItensTraMl);
    FreeAndNil(dicRetorno);
  End;
end;

function TFatVenda.fVerificaParMinCartao(intQtdPar: Integer; fltParMin: Double): Boolean;
  Var
    objLiberacao  : TLiberacao;

begin
  Result := True;

  If (fltTotGer <> 0) And ((fltTotGer / intQtdPar) < fltParMin) Then
  Begin
    objLiberacao := TLiberacao.Create;
    try
      strCodOpe := strLoginUsuarioLogado;

      objLiberacao.objMsgLibera.pAddTexto('Valor da Parcela Menor que o Valor Mínimo');
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor do documento'    , FormatFloat('#,##0.00', fltTotGer)              , 23);
      objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade de parcelas', IntToStr(intQtdPar)                             , 23);
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor da parcela'      , FormatFloat('#,##0.00', (fltTotGer / intQtdPar)), 23);
      objLiberacao.objMsgLibera.pAddTextoCaption('Valor mínimo permitido', FormatFloat('#,##0.00', fltParMin)              , 23);

      objLiberacao.strDirAce := 'PARMIN';
      objLiberacao.strMsgSen := 'Valor da Parcela Menor que o Valor Mínimo';
      objLiberacao.strCodOpe := strLoginUsuarioLogado;
      objLiberacao.strCodDig := strLoginUsuarioLogado;
      objLiberacao.strOperador := strCodOpe;

      Result := fFatMensagemLiberacao(objLiberacao);

      strCodOpe := objLiberacao.strOperador;

    finally
      FreeAndNil(objLiberacao);
    end;
  End;
end;

function TFatVenda.fVerificaPodeUtilizarTinta: Boolean;
  Var
    stlNaoUti: TStringList;
    cdsDados: TUniClientDataSet;
begin

  Result := True;
  cdsDados := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  stlNaoUti := TStringList.Create;
  stlNaoUti.Duplicates := dupIgnore;

  With cdsDados Do
  Begin

    DisableControls;

    Try

      First;
      While (Not Eof) Do
      Begin
        If Not fPodeUtilizarTinta(FieldByName('ITE_IDEPRO').AsString) Then
        Begin
          stlNaoUti.Add(FieldByName('ITE_CODITE').AsString + ' - ' + FieldByName('ITE_DESITE').AsString);
        End;

        Next;
      End;

      First;

    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[TFatVenda.fVerificaPodeUtilizarTinta]');
      End;
    End;

    EnableControls;

  End;

  If stlNaoUti.Count > 0 Then
  Begin
    stlNaoUti.Insert(0, 'Os produtos tintométricos abaixo só podem ser vendidos caso a opção ' +
                        '"Gerar produção fora da loja" esteja SIM.');
    stlNaoUti.Insert(1, '');

    Result := False;
    Try
      pCriarFormularios(TfrmObservacao, frmObservacao);
    Except
      On E: Exception Do
      Begin
        pMensagensErro(E.Message, '[TFatVenda.fVerificaPodeUtilizarTinta_1]');
        Exit;
      End;
    End;

    frmObservacao.Caption := 'Itens não permitidos';
    frmObservacao.lblMensagem.Caption := 'Itens não permitidos';
    frmObservacao.memObs.Lines.Assign(stlNaoUti);
    frmObservacao.ShowModal;
    pFreeAndNil(frmObservacao);

  End;

  FreeAndNil(stlNaoUti);
  FreeAndNil(cdsDados);

end;

procedure TFatVenda.SetstrNumeroProtocolo(const Value: String);
begin
  FstrNumeroProtocolo := Value;
end;

procedure TFatVenda.pAtualizaFreBai(strNumDoc, strEspDoc, strCodEmp: String);
  Var
    qryUpd: TUniQuery;
begin

  qryUpd := fCriaQuery(Self);
  qryUpd.SQL.Add('UPDATE ');
  qryUpd.SQL.Add('  FATGOR ');
  qryUpd.SQL.Add('SET ');
  qryUpd.SQL.Add('  FGO_FREBAI = FGO_TOTFRE ');
  qryUpd.SQL.Add('WHERE ');
  qryUpd.SQL.Add('  FGO_NUMDOC = :NUMDOC AND ');
  qryUpd.SQL.Add('  FGO_ESPDOC = :ESPDOC AND ');
  qryUpd.SQL.Add('  FGO_CODEMP = :CODEMP ');

  qryUpd.ParamByName('NUMDOC').AsString := strNumDoc;
  qryUpd.ParamByName('ESPDOC').AsString := strEspDoc;
  qryUpd.ParamByName('CODEMP').AsString := strCodEmp;

  qryUpd.ExecSQL;

  FreeAndNil(qryUpd);

end;

