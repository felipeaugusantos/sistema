                             LRefGravacao.fltIbsUfv,
                             LRefGravacao.fltIbsMna,
                             LRefGravacao.fltIbsMnd,
                             LRefGravacao.fltIbsMvd,
                             LRefGravacao.fltIbsMnr,
                             LRefGravacao.fltIbsMnt,
                             LRefGravacao.fltIbsMne,
                             LRefGravacao.fltIbsMnv,
                             LRefGravacao.strSelCst,
                             LRefGravacao.strSelCla,
                             LRefGravacao.fltSelBas,
                             LRefGravacao.fltSelAlq,
                             LRefGravacao.fltSelVal,
                             LRefGravacao.strTriReg,
                             IIF(fEmptyStr(LRefGravacao.strCrePre), 'N', LRefGravacao.strCrePre),
                             IIF(fEmptyStr(LRefGravacao.strMonofa), 'N', LRefGravacao.strMonofa),
                             LRefGravacao.fltValIbs,
                             '',
                             LRefGravacao.strCstReg,
                             LRefGravacao.strClaReg,
                             LRefGravacao.fltAiuReg,
                             LRefGravacao.fltTiuReg,
                             LRefGravacao.fltAimReg,
                             LRefGravacao.fltTimReg,
                             LRefGravacao.fltCbsReg,
                             LRefGravacao.fltTcbReg,
                             arrMatItens[intContador].fltIcmPrd,
                             arrMatItens[intContador].fltBimRet,
                             arrMatItens[intContador].fltAimRet,
                             LRefGravacao.blnPreenchido);

      blnGravaNdtCha := fRetornaDadosDetCha(strAutIncVenda,
                                            arrMatItens[intContador].fltQtdIte,
                                            fltQtdCha,
                                            fltMedB_L,
                                            fltMedB_A,
                                            fltMedL_L,
                                            fltMedL_A,
                                            fltEspess);
      If (Not blnGravaNdtCha) Then
        blnGravaNdtCha := fRetornaMedidasLoteChapa(strOpcDoc,
                                                   arrMatItens[intContador].strCodIte,
                                                   VS_strCodEmp,
                                                   arrMatItens[intContador].strNumLot,
                                                   arrMatItens[intContador].fltQtdIte,
                                                   fltQtdCha,
                                                   fltMedB_L,
                                                   fltMedB_A,
                                                   fltMedL_L,
                                                   fltMedL_A,
                                                   fltEspess);


      If blnGravaNdtCha Then
      Begin
        Result := Result And fGravaNdtCha(strAutIncCnf,
                                          fltQtdCha,
                                          fltMedB_L,
                                          fltMedB_A,
                                          fltMedL_L,
                                          fltMedL_A,
                                          fltEspess);
      End;

      If (Result) Then
        arrMatItens[intContador].strAutoincrementoGravacaoNotDet := strAutIncCnf;

      If (Result) Then
      Begin
        If Self.Fulfillment.EhOperacaoFulfillment Then
          pGravaICMSUFDestino(strAutIncCnf, 'NOTICD', arrMatItens[intContador])
        Else If fGravaEspelhoFundoCombateIMCeFundoCombateST(arrMatItens[intContador].strClaFis, arrMatItens[intContador].strEmpIte) Then
          pGravaICMSUFDestinoEspelho(strAutIncCnf, 'NOTICD', arrMatItens[intContador])
        Else
          pCalculaGravaICMSUFDestino(strAutIncCnf, 'NOTICD', arrMatItens[intContador]);
      End;

      If (Result) And (strOpcDoc = 'CF') Then
      Begin
        Result := fAtualizaDesCff(strMovDet, arrMatItens[intContador].intAutInc);

        if (Result) And fCfgSis('NUMSER', varBoolean) then
          pGravaNumeroSerieConfirmacaoDocumento(arrMatItens[intContador].strSeqDet, strAutIncCnf);
      End;

      If (Result) And (LeftStr(strClaFis, 1) = '3') Then
      Begin
        Result := fGravaDocImp(arrMatItens[intContador]);
      End;

      If Result And fUtilizaVendaMadeiraOuVidroOuMetroLinear Then
        Result := fGravaVendaMadeira(strAutIncCnf,
                                     'NOTMAD',
                                     arrMatItens[intContador].recMadeira);

      If Result Then
        Result := fGravaMovCon(arrMatItens[intContador].intAutInc,
                               strAutIncCnf,
                               strEspDoc,
                               'N');

      If Not Result Then
        Break;
    End;

    pAtualizaIndiceNFEConformeOrdenacao(strAutInc, 'NOTDET');

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGNotDet]');
    End;
  End;

end;

function TFatVenda.fGCadFisRe(Var arrLivFis : TArrLivFis): Boolean;
