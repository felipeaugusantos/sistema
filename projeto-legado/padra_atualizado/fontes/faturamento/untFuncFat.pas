procedure TFatVenda.pRetInfColorista(strCodEmp, strNumDoc, strEspDoc, strItetin, strCodAca: String;
Var intTipFor : Integer; Var strObsCol: String);
Var
  qryAux : TUniQuery;
begin
  qryAux := Nil;

  Try
    qryAux := fCriaQuery(nil);
    qryAux.SQL.Text := 'SELECT FDO_OBSCOL '+
                       '     , FDO_TIPFOR '+
                       '  FROM TINDOR '+
                       ' WHERE FDO_CODEMP =:CODEMP '+
                       '   AND FDO_NUMDOC =:NUMDOC '+
                       '   AND FDO_ESPDOC =:ESPDOC '+
                       '   AND FDO_ITETIN =:ITETIN '+
                       '   AND FDO_CODACA =:CODACA '+
                       ' UNION '+
                       'SELECT DET_OBSCOL '+
                       '     , DET_TIPFOR '+
                       '  FROM TINDET '+
                       ' WHERE DET_CODEMP =:CODEMP '+
                       '   AND DET_NUMDOC =:NUMDOC '+
                       '   AND DET_ESPDOC =:ESPDOC '+
                       '   AND DET_ITETIN =:ITETIN '+
                       '   AND DET_CODACA =:CODACA ';
    qryAux.ParamByName('CODEMP').AsString := strCodemp;
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('ITETIN').AsString := strItetin;
    qryAux.ParamByName('CODACA').AsString := strCodAca;
    qryAux.Open;

    intTipFor := qryAux.FieldByName('FDO_TIPFOR').AsInteger;
    strObsCol := qryAux.FieldByName('FDO_OBSCOL').AsString;

  Finally
    FreeAndNil(qryAux);
  End;

end;

