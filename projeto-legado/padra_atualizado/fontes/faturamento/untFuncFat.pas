class function TFatVenda.fValidaItemAtivoCompra(cdsDados: TUniClientDataSet; blnValidaOPCABS: Boolean): Boolean;
var
  lstItens: TStringList;
begin
  Result := True;
  lstItens := TStringList.Create;
  cdsDados.DisableControls;
  try
    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      if blnValidaOPCABS then
      begin
        If (cdsDados.FieldByName('ATICOM').AsString <> 'S') and (cdsDados.FieldByName('OPCABS').AsInteger = Integer(oaReqCompra)) Then
        begin
          lstItens.Append(Format('%s - %s' + sLineBreak, [cdsDados.FieldByName('CODITE').AsString, cdsDados.FieldByName('DESITE').AsString]));
          Result := False;
        end;
      end
      else
      begin
        If cdsDados.FieldByName('RCD_ATICOM').AsString <> 'S' Then
        begin
          lstItens.Append(Format('%s - %s' + sLineBreak, [cdsDados.FieldByName('RCD_CODITE').AsString, cdsDados.FieldByName('RCD_DESITE').AsString]));
          Result := False;
        end;
      end;
      cdsDados.Next;
    End;

    if not Result then
      pMensagemSonora('Este(s) Item(ns) ' + sLineBreak + lstItens.Text + ' não esta(ão) ativo(s) para compras!', False, 12, 780);
  finally
    cdsDados.EnableControls;
    lstItens.Free;
  end;

end;

function TFatVenda.fEmpresaDocumentoGravaArquivos: String;
begin
  If (Pos(strEspDoc, 'PD_OR_') > 0) Then
