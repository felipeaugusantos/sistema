                                       fltEmbala,
                                       fltDesCon,
                                       fltPrcTin,
                                       fltPrvTin,
                                       fltCusIte,
                                       fltQtdEmb,
                                       fltTotIteAnt: Double;
                                       strEmpresaItem,
                                       strTabPreIte,
                                       strCodIte,
                                       strDesIte,
                                       strIdeProIte,
                                       strTipPre,
                                       strIteTin,
                                       strCatalize,
                                       strPromocIte,
                                       strEntSai,
                                       strBrinde: string;
                                       blnAlteracao: Boolean;
                                       cdsVenda: TUniClientDataSet;
                                       qryConCit,
                                       qryTinta: TUniQuery;
                                       dtsDadIte: TDataSet;
                                       fltPreLot: Double;
                                       strUnidad: String;
                                       fltPreMed: Double;
                                       fltImpUlt: Double = 0;
                                       blnPedeSenha: Boolean = True;
                                       blnEntIme: Boolean = False;
