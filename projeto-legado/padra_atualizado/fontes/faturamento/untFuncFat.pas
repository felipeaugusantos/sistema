function TFatVenda.fValidaBeneficioFiscal(Out strProdSemCodBeneficio: String): Boolean;
var
  item: TDadosFechamento;
  strCodBen: String;
  strEstado: String;

  function fUsaBeneficioFiscal: Boolean;
  Begin
    result := False;

    If (strEstado = 'PR') Then
      Result := (Pos(RightStr(item.strCodSit, 2), '20_30_40_41_50_51_70_') > 0) ;

    If (strEstado = 'RJ') Then
      Result := (Pos(RightStr(item.strCodSit, 2), '20_30_40_51_70_') > 0) ;

    If (strEstado = 'RS') Then
      Result := (Pos(RightStr(item.strCodSit, 2), '20_30_40_41_50_51_60_70_90_') > 0) ;
  End;

begin
  Result := True;

  if fCfgSis('TRABEN', varBoolean) And fCfgSis('OBRBEN', varBoolean) And (Pos(strOpcDoc, 'VN_CP_OU_OF_OV_CF_') > 0) And (Pos(strEspDoc,'IF_NF_') > 0) then
  begin
    For item In arrMatItens Do
    Begin
      strEstado := fGetUFEmpresa(item.strEmpIte);
      If (Not fEhItemServico(item.strCodIte)) And fUsaBeneficioFiscal Then
      Begin
        If fBuscaAbfIcm(item.strIteAbf,
                        item.strEmpIte,
                        item.strCodAbf,
                        strEstado) Then
        Begin
          strCodBen := cdsAbfIcm.FieldByName('ABF_CODBEN' + Self.GetTipAbf(item)).AsString;

          If fEmptyStr(strCodBen) then
            strProdSemCodBeneficio := strProdSemCodBeneficio + item.strCodIte + ' - ' + item.strDesIte + #13#10;
        End;
      End;
    End;

    Result := fEmptyStr(strProdSemCodBeneficio);
  end;

end;

function TFatVenda.fEhPedidoMultiLoja(AItens: TMatrizFechamento): Boolean;
Var
  LItem: TDadosFechamento;
Begin
  Result := False;

  If not (Self.strEspDoc = 'PD') Then
    Exit;

  For LItem In AItens Do
  Begin
    If (IIF(fEmptyStr(LItem.strEmpIte), VS_strCodEmp, LItem.strEmpIte) <> VS_strCodEmp) Then
    Begin
      Result := True;
      Break;
    End;
  End;

End;

function TFatVenda.fGravouDocumentoComDifal: Boolean;
var
  strCampo: String;
  strTabela: String;
  intContador: Integer;
  strAutIncRet: String;
Begin
  Result := True;

  If fCfgSis('VALDIF', varBoolean) Then
  Begin
    If fAtendeRegrasDIFAL(False) And (Not blnVendaPresencial) Then
    Begin
      If fEhPedidoMultiLoja(Self.arrMatItens) Then
        Exit;

      strTabela := IIF((Pos(strEspDoc, 'OR_PD_PR_') > 0), 'DORICD', 'MOVICD');
      strCampo  := IIF(strTabela = 'DORICD', 'ICD_SEQFDO', 'ICD_SEQGER');

      If (fEhGravacaoDeNotGer) Then
        strTabela := 'NOTICD';

      For intContador := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
      Begin
        If fEhItemServico(arrMatItens[intContador].strCodIte) Then
          Continue;

        If not arrMatItens[intContador].blnGravaMovIcd Then
          Continue;

        strAutIncRet := arrMatItens[intContador].strAutoincrementoGravacaoDifal ;

        If fEmptyStr(strAutIncRet) Then
          Continue;

        Result := not fEmptyStr(fCampoTabela(strCampo, strTabela, [strCampo], [strAutIncRet]));

        If not Result Then
          Break;
      End;

      If not Result Then
      Begin
        strMsgCancelamento := 'O documento: '+strNumDoc+'-'+strEspDoc+'-'+VS_strCodEmp+' não gravou DIFAL!'+#13+
                              'Aguarde alguns minutos e tente novamente.';
      End;

    End;
  End;

End;

function TFatVenda.fGravouMovCarConformeVariaveisDoCaixa(const AblnValorInicial: Boolean): Boolean;
begin
  Result := AblnValorInicial ;

  if Self.strOpcDocTrue <> '11' then
    Exit ;

  if (not blnCfgGravaResCai) and (not blnNaoUsaResumoCaixaMasGravaChequeOuCartao) then
    Result := False ;
end;

function TFatVenda.fRetornaCstDiferimento(fltBasIcm:Double; strCodSit: String):String;
Begin
  if (Pos(strOpcDoc, 'UC') > 0) and
     (Pos(strEspDoc, 'NF') > 0) and
     (Self.strCliCon = 'N' ) and
     fCfgSis('CST90C', varBoolean) then
    Result := LeftStr(strCodSit, 1) + '90'
  else
  If Self.strDiferi = 'S' Then
  Begin
    If (fFormataFloat(fltBasIcm, 2) = 0.00) Then
      Result := LeftStr(strCodSit, 1) + '51'
    Else
      Result := LeftStr(strCodSit, 1) + '90';
  End
  Else
    Result := strCodSit;
End;

procedure TFatVenda.pMensagemDocumentoGNRE(strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
Var
  msgMensagem           : TMsgInterna;
  stlMensagem           : TStringList;
  qryCadOpe             : TUniQuery;
  qryMovGer             : TUniQuery;
  blnEnviar             : Boolean;
  strCodigoUsuarioEnvio : String;
  strSQL                : String;
Begin

  strCodigoUsuarioEnvio := strLoginUsuarioLogado;

  if blnExecutandoFaturadorAutomatico then
    strCodigoUsuarioEnvio := fRetCodigoUsuarioAutomatico;

  Try

    qryCadOpe := fCriaQuery;
    qryMovGer := fCriaQuery;

    qryCadOpe.Close;
    qryCadOpe.SQL.Clear;
    qryCadOpe.SQL.Add('SELECT ');
    qryCadOpe.SQL.Add('  OPE_CODOPE ');
    qryCadOpe.SQL.Add('FROM CADOPE');
    qryCadOpe.SQL.Add('WHERE LOCATE(:CODEMP, OPE_EMPACE) > 0 ');
    qryCadOpe.SQL.Add('  AND OPE_MSGGNR = "S"');
    qryCadOpe.ParamByName('CODEMP').AsString := strCodEmp;
    qryCadOpe.Open;

    if not qryCadOpe.IsEmpty Then
    begin
      strSQL := '';
      strSQL := strSQL + 'SELECT';
      strSQL := strSQL + '  GER_DTAENT, ';
      strSQL := strSQL + '  GER_NUMDOC, ';
      strSQL := strSQL + '  GER_ESPDOC, ';
      strSQL := strSQL + '  GER_CODEMP, ';
      strSQL := strSQL + '  CLI_CODCLI, ';
      strSQL := strSQL + '  CLI_NOMCLI, ';
      strSQL := strSQL + '  GER_VLRCON, ';
      strSQL := strSQL + '  GER_TOTRET, ';
      strSQL := strSQL + '  (SELECT SUM(ICD_VALFCP) FROM MOVICD ';
      strSQL := strSQL + '   INNER JOIN MOVDET ON ICD_SEQGER = MOVDET.AUTOINCREM ';
      strSQL := strSQL + '   WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM) AS GER_VALFCP, ';
      strSQL := strSQL + '  (SELECT SUM(ICD_VALDES) FROM MOVICD ';
      strSQL := strSQL + '   INNER JOIN MOVDET ON ICD_SEQGER = MOVDET.AUTOINCREM ';
      strSQL := strSQL + '   WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM) AS GER_VALDIF ';
      strSQL := strSQL + 'FROM MOVGER ';
      strSQL := strSQL + 'INNER JOIN CADCLI ON GER_CODCLI = CLI_CODCLI ';
      strSQL := strSQL + 'WHERE GER_TIP_FC = "C" ';
      strSQL := strSQL + '  AND GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '  AND GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '  AND GER_CODEMP = :CODEMP ';
      strSQL := strSQL + '  AND GER_CODCLI = :CODCLI ';
      strSQL := strSQL + ' AND LOCATE(GER_CLAFIS, '+ QuotedStr(VS_strClaVen) +') > 0 ';
      strSQL := strSQL + ' AND LOCATE(GER_CLAFIS, '+ QuotedStr(VS_strClaDev) +') = 0 ';
      strSQL := strSQL + ' AND (SELECT COUNT(EMP_INSSUB) FROM EMPISB ';
      strSQL := strSQL + '      WHERE TRIM(EMPISB.EMP_INSSUB) <> "" ';
      strSQL := strSQL + '        AND EMPISB.EMP_CODEMP = MOVGER.GER_CODEMP ';
      strSQL := strSQL + '        AND EMPISB.EMP_ESTADO = MOVGER.GER_ESTADO) = 0 ';

      strSQL := strSQL + ' UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(strSQL, 'MOVGER', 'NOTGER'), 'AUXMOV', 'AUXNOT'), 'MOVDET', 'NOTDET'), 'MOVICD', 'NOTICD');

      qryMovGer.Close;
      qryMovGer.SQL.Clear;
      qryMovGer.SQL.Text := strSQL;
      qryMovGer.ParamByName('NUMDOC').AsString := strNumDoc;
      qryMovGer.ParamByName('ESPDOC').AsString := strEspDoc;
      qryMovGer.ParamByName('CODEMP').AsString := strCodEmp;
      qryMovGer.ParamByName('CODCLI').AsString := strCodCli;
      qryMovGer.Open;

      blnEnviar := ((qryMovGer.FieldByName('GER_TOTRET').AsFloat +
                     qryMovGer.FieldByName('GER_VALDIF').AsFloat +
                     qryMovGer.FieldByName('GER_VALFCP').AsFloat) > 0);

      if blnEnviar then
      begin
        Try
          msgMensagem := TMsgInterna.Create(Self);
          stlMensagem := TStringList.Create;
          stlMensagem.Clear;

          stlMensagem.Add('--------------------------------------------------------------------------------------------------------');
          stlMensagem.Add('EMISSÃO DE NOTA FISCAL DE SAÍDA COM INCIDÊNCIA DE ST/DIFAL/FCP                                          ');
          stlMensagem.Add('--------------------------------------------------------------------------------------------------------');
          stlMensagem.Add('Acessar: > RELATÓRIOS DE LIVROS FISCAIS > EXPORTAÇÃO DE GNRE PE - ST/DIFAL/FCP - SAIDA                  ');
          stlMensagem.Add('--------------------------------------------------------------------------------------------------------');
          stlMensagem.Add('Dt.Emissão   : ' + qryMovGer.FieldByName('GER_DTAENT').AsString);
          stlMensagem.Add('Documento    : ' + strNumDoc + '-' + strEspDoc + '-' + strCodEmp);
          stlMensagem.Add('Cliente      : ' + qryMovGer.FieldByName('CLI_CODCLI').AsString + '-' + qryMovGer.FieldByName('CLI_NOMCLI').AsString);
          stlMensagem.Add('Vr.Documento : ' + FormatFloat('###,#0.00', qryMovGer.FieldByName('GER_VLRCON').AsFloat));
          stlMensagem.Add('Vr.ST        : ' + FormatFloat('###,#0.00', qryMovGer.FieldByName('GER_TOTRET').AsFloat));
          stlMensagem.Add('Vr.Difal     : ' + FormatFloat('###,#0.00', qryMovGer.FieldByName('GER_VALDIF').AsFloat));
          stlMensagem.Add('Vr.FCP       : ' + FormatFloat('###,#0.00', qryMovGer.FieldByName('GER_VALFCP').AsFloat));
          stlMensagem.Add('--------------------------------------------------------------------------------------------------------');

          qryCadOpe.First;
          While Not qryCadOpe.Eof Do
          Begin
            msgMensagem.fEnviaMensagem('Emitir guia GNRE/GARE - NF: ' + strNumDoc,
                                       stlMensagem.Text,
                                       strCodigoUsuarioEnvio,
                                       qryCadOpe.FieldByName('OPE_CODOPE').AsString,
                                       'N',
                                       '');
            qryCadOpe.Next;
          End;

        Finally
          FreeAndNil(msgMensagem);
          FreeAndNil(stlMensagem);
        End;
      end;

    end;

  finally
    FreeAndNil(qryCadOpe);
    FreeAndNil(qryMovGer);
  end;

end;

function TFatVenda.fEhClienteFilialSimplesNacional: Boolean;
begin
  Result := False;

  If (Self.strEmpOriPed = VS_strCodEmp) Then
    Exit;

  If not fClienteFilial(Self.strCodCli) Then
    Exit;

  If not fCfgSis('SIMPAU', varBoolean, Self.strEmpOriPed) Then
    Exit;

  Result := True;
end;

function TFatVenda.fValoresReformaTributariaGravadosConferem: Boolean;
  Const
    TOLERANCIA_REFORMA = 0.01;
    MAXIMO_ITENS_MENSAGEM = 3;

  function fDivergiu(const AValorCalculado, AValorGravado: Double): Boolean;
  begin
    Result := (Abs(AValorCalculado - AValorGravado) - TOLERANCIA_REFORMA) > 0.0001;
  end;

  function fDescricaoImposto(const ASigla: String; const AValorCalculado, AValorGravado: Double): String;
  begin
    Result := ' ' + ASigla + ' calculado ' + FormatFloat('#,##0.00', AValorCalculado) +
              ' / gravado ' + FormatFloat('#,##0.00', AValorGravado) + ';';
  end;

  Var
    qryRef: TUniQuery;
    dicIndiceItem: TDictionary<String, Integer>;
    strTabelaDetalhe: String;
    strAutInc: String;
    strIdentificadores: String;
    strDivergencias: String;
    strDivergenciaItem: String;
    intContador: Integer;
    intIndice: Integer;
    intQtdDivergencias: Integer;
    fltCbsGravado: Double;
    fltIbsGravado: Double;
    fltIsGravado: Double;
Begin
  Result := True;
  strDivergencias := '';
  intQtdDivergencias := 0;

  If Not fSomarNovosImpostosDaReformaAoValorContabil Then
    Exit;

  // REF gravada com os valores do proprio documento (ou do envio, no retorno), nao ha o que conferir
  If Self.blnReformaDefinidaPeloDocumento Or (Self.strOpcDoc = 'CR') Then
    Exit;

  If fEmptyStr(FstrTabelaReformaGravada) Then
    Exit;

  If fCfgSisL('RFTRVA', varString) = 'N' Then
    Exit;

  If FstrTabelaReformaGravada = 'FDOREF' Then
    strTabelaDetalhe := 'FATDOR'
  Else If FstrTabelaReformaGravada = 'NOTREF' Then
    strTabelaDetalhe := 'NOTDET'
  Else
    strTabelaDetalhe := 'MOVDET';

  dicIndiceItem := TDictionary<String, Integer>.Create;
  Try
    strIdentificadores := '';
    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If fEhItemServico(arrMatItens[intContador].strCodIte) Then
        Continue;

      If (arrMatItens[intContador].strProEmb = 'S') Then
        Continue;

      If fZerarReformaTributariaEspeciesMIFF(arrMatItens[intContador].strEspDev) Then
        Continue;

      If FstrTabelaReformaGravada = 'NOTREF' Then
        strAutInc := arrMatItens[intContador].strAutoincrementoGravacaoNotDet
      Else
        strAutInc := arrMatItens[intContador].strAutoincrementoGravacao;

      If fEmptyStr(strAutInc) Or dicIndiceItem.ContainsKey(strAutInc) Then
        Continue;

      dicIndiceItem.Add(strAutInc, intContador);
      strIdentificadores := strIdentificadores + IIF(fEmptyStr(strIdentificadores), '', ',') + QuotedStr(strAutInc);
    End;

    If fEmptyStr(strIdentificadores) Then
      Exit;

    // Item sem linha na tabela REF (status diferente de CALCULADO) conta como zero
    qryRef := fCriaQuery;
    Try
      qryRef.SQL.Add('SELECT D.AUTOINCREM, ');
      qryRef.SQL.Add('       IFNULL(SUM(R.REF_CBSVAL), 0) AS REF_CBSVAL, ');
      qryRef.SQL.Add('       IFNULL(SUM(R.REF_VALIBS), 0) AS REF_VALIBS, ');
      qryRef.SQL.Add('       IFNULL(SUM(R.REF_SELVAL), 0) AS REF_SELVAL ');
      qryRef.SQL.Add('  FROM ' + strTabelaDetalhe + ' D ');
      qryRef.SQL.Add('  LEFT JOIN ' + FstrTabelaReformaGravada + ' R ON R.' + fCampoSeqReformaRef(FstrTabelaReformaGravada) + ' = D.AUTOINCREM ');
      qryRef.SQL.Add(' WHERE D.AUTOINCREM IN (' + strIdentificadores + ') ');
      qryRef.SQL.Add(' GROUP BY D.AUTOINCREM ');
      qryRef.Open;

      While Not qryRef.Eof Do
      Begin
        If dicIndiceItem.TryGetValue(qryRef.FieldByName('AUTOINCREM').AsString, intIndice) Then
        Begin
          fltCbsGravado := qryRef.FieldByName('REF_CBSVAL').AsFloat;
          fltIbsGravado := qryRef.FieldByName('REF_VALIBS').AsFloat;
          fltIsGravado  := qryRef.FieldByName('REF_SELVAL').AsFloat;

          strDivergenciaItem := '';
          If fDivergiu(arrMatItens[intIndice].fltValCBS, fltCbsGravado) Then
            strDivergenciaItem := strDivergenciaItem + fDescricaoImposto('CBS', arrMatItens[intIndice].fltValCBS, fltCbsGravado);
          If fDivergiu(arrMatItens[intIndice].fltValIBS, fltIbsGravado) Then
            strDivergenciaItem := strDivergenciaItem + fDescricaoImposto('IBS', arrMatItens[intIndice].fltValIBS, fltIbsGravado);
          If fDivergiu(arrMatItens[intIndice].fltVal_IS, fltIsGravado) Then
            strDivergenciaItem := strDivergenciaItem + fDescricaoImposto('IS', arrMatItens[intIndice].fltVal_IS, fltIsGravado);

          If Not fEmptyStr(strDivergenciaItem) Then
          Begin
            Inc(intQtdDivergencias);
            If intQtdDivergencias <= MAXIMO_ITENS_MENSAGEM Then
              strDivergencias := strDivergencias + sLineBreak + 'Item ' + arrMatItens[intIndice].strCodIte + ':' + strDivergenciaItem;
          End;
        End;

        qryRef.Next;
      End;
    Finally
      FreeAndNil(qryRef);
    End;
  Finally
    FreeAndNil(dicIndiceItem);
  End;

  If intQtdDivergencias = 0 Then
    Exit;

  If intQtdDivergencias > MAXIMO_ITENS_MENSAGEM Then
    strDivergencias := strDivergencias + sLineBreak + '... e mais ' + IntToStr(intQtdDivergencias - MAXIMO_ITENS_MENSAGEM) + ' item(ns).';

  Result := False;
  strMsgCancelamento := 'O documento: ' + strNumDoc + '-' + strEspDoc + '-' + VS_strCodEmp + ' gravou valores de CBS/IBS/IS ' +
                        'diferentes dos calculados nos itens!' + sLineBreak +
                        strDivergencias + sLineBreak + sLineBreak +
                        'A gravação foi cancelada [CFG_RFTRVA].';
end;

function TFatVenda.fMarcaSeExisteGNRE(strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
var
  qryAux: TUniQuery;
Begin
  Result := True;

  If strEspDoc <> 'NF' Then
    Exit;

  Try
    qryAux := fCriaQuery(Self);
    Try
      // TEM FUNDO DE COMBATE
      qryAux.SQL.Add('UPDATE MOVGER, AUXMOV SET AUX_TEMFCP = "S" ');
      qryAux.SQL.Add('WHERE AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM ');
      qryAux.SQL.Add('  AND MOVGER.GER_NUMDOC = :NUMDOC ');
      qryAux.SQL.Add('  AND MOVGER.GER_ESPDOC = :ESPDOC ');
      qryAux.SQL.Add('  AND MOVGER.GER_CODEMP = :CODEMP ');
      qryAux.SQL.Add('  AND MOVGER.GER_CODCLI = :CODCLI ');
      qryAux.SQL.Add('  AND EXISTS (SELECT ICD_SEQGER FROM MOVDET ');
      qryAux.SQL.Add('              INNER JOIN MOVICD ON MOVICD.ICD_SEQGER = MOVDET.AUTOINCREM ');
      qryAux.SQL.Add('              WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ');
      qryAux.SQL.Add('                AND ICD_VALFCP > 0) ');

      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.ParamByName('CODCLI').AsString := strCodCli;

      qryAux.ExecSQL;

      qryAux.SQL.Text := AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(qryAux.SQL.Text, 'MOVGER', 'NOTGER'), 'MOVDET', 'NOTDET'), 'AUXMOV', 'AUXNOT'), 'MOVICD', 'NOTICD');

      qryAux.ExecSQL;

      // TEM DIFAL
      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('UPDATE MOVGER, AUXMOV SET AUX_TEMDFL = "S" ');
      qryAux.SQL.Add('WHERE AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM ');
      qryAux.SQL.Add('  AND MOVGER.GER_NUMDOC = :NUMDOC ');
      qryAux.SQL.Add('  AND MOVGER.GER_ESPDOC = :ESPDOC ');
      qryAux.SQL.Add('  AND MOVGER.GER_CODEMP = :CODEMP ');
      qryAux.SQL.Add('  AND MOVGER.GER_CODCLI = :CODCLI ');
      qryAux.SQL.Add('  AND EXISTS (SELECT ICD_SEQGER FROM MOVDET ');
      qryAux.SQL.Add('              INNER JOIN MOVICD ON MOVICD.ICD_SEQGER = MOVDET.AUTOINCREM ');
      qryAux.SQL.Add('              WHERE MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ');
      qryAux.SQL.Add('                AND ICD_VALDES > 0) ');

      qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
      qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
      qryAux.ParamByName('CODEMP').AsString := strCodEmp;
      qryAux.ParamByName('CODCLI').AsString := strCodCli;

      qryAux.ExecSQL;

      qryAux.SQL.Text := AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(qryAux.SQL.Text, 'MOVGER', 'NOTGER'), 'MOVDET', 'NOTDET'), 'AUXMOV', 'AUXNOT'), 'MOVICD', 'NOTICD');

      qryAux.ExecSQL;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fMarcaSeExisteGNRE]');
      End;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

function TFatVenda.fEnviarParaLiberacaoPedidoSemEstoque: Boolean;
begin
  Result := (Self.strEspDoc = 'PD') And fCfgSis('LIBPSE', varBoolean);
end;

procedure TFatVenda.pRemovLIBPSE;
begin
  If (fEnviarParaLiberacaoPedidoSemEstoque) Then
  Begin
    If fLogAviExists('LIBPSE') Then
      pRemoverTravaLogAvi('LIBPSE', strNTrava);
  End;
end;

procedure TFatVenda.pTravaLIBPSE(var blnPedLib: Boolean);
var
  intIndexTrava: Integer;
begin
  if fEnviarParaLiberacaoPedidoSemEstoque And fTemItemSemEstoqueMatriz then
  begin
    blnPedLib := False;
    blnPedBlo := True;

    pAdicionarDirAceStringNTrava('LIBPSE', strNTrava);

    SetLength(arrLogAvi, Succ(Length(arrLogAvi)));
    intIndexTrava := High(arrLogAvi);
    arrLogAvi[intIndexTrava].strMsgSen := '';
    arrLogAvi[intIndexTrava].strDirAce := 'LIBPSE';
    arrLogAvi[intIndexTrava].strNumLib := '';
    arrLogAvi[intIndexTrava].strInfBlo := 'PEDIDO POSSUI ITENS SEM ESTOQUE';
    arrLogAvi[intIndexTrava].strInfLib := 'PEDIDO POSSUI ITENS SEM ESTOQUE';
    arrLogAvi[intIndexTrava].strMenObs := '';
    arrLogAvi[intIndexTrava].strCodIte := '';
    arrLogAvi[intIndexTrava].intAutInc := 0;
    arrLogAvi[intIndexTrava].strCodOpe := strCodOpe;
    arrLogAvi[intIndexTrava].strCodDig := strCodDig;
    arrLogAvi[intIndexTrava].blnIgnInc := False;
  end;
end;

function TFatVenda.fGravarAdiantamentoPedidoPeloVN : Boolean;
  Var
    documento: TDocAdiantamento;
    dadosAdiantamento: TDadosAdiantamento;
    totModalidades: TTotaisAdiantamento;
begin
  FillChar(dadosAdiantamento, SizeOf(dadosAdiantamento), #0);
  FillChar(totModalidades, SizeOf(totModalidades), #0);

  documento.strNumDoc := strNumDoc;
  documento.strEspDoc := strEspDoc;
  documento.strCodEmp := VS_strCodEmp;
  documento.strCodCli := strCodCli;
  documento.fltValLan := fltValCar+fltValOrd;

  dadosAdiantamento.AddDocumento(documento);

  dadosAdiantamento.strTipLan := 'C';
  dadosAdiantamento.dtaDtaLan := VS_Date;
  dadosAdiantamento.horHorLan := fTime();
  dadosAdiantamento.strOpeLan := strLoginUsuarioLogado;
  dadosAdiantamento.strEmpLan := VS_strCodEmp;
  dadosAdiantamento.intSeqCon := intSeqConRcx;
  dadosAdiantamento.strDescri := 'CREDITO ADIANTAMENTO PEDIDO: ' + strNumDoc + '-' + strEspDoc;
  dadosAdiantamento.fltValDin := 0.00;
  dadosAdiantamento.fltValChV := 0.00;
  dadosAdiantamento.fltValChP := 0.00;
  dadosAdiantamento.fltValOrd := fltValOrd;
  dadosAdiantamento.fltValFin := 0.00;
  dadosAdiantamento.fltValCre := 0.00;
  dadosAdiantamento.fltValCar := fltValCar;
  dadosAdiantamento.fltValLan := fltValCar+fltValOrd;

  dadosAdiantamento.RecebidoPorPix := False;

  if Self.blnCfgGravaResCai And Self.blnValGravaResCai then
    dadosAdiantamento.strOrigem := 'RCX';

  Result := TAdiantamentoGenerico.fGravaAdiantamentoCliente(dadosAdiantamento);
end;

function TFatVenda.fProdutoSempreMarcaComoJaExpedido(const strEntRet, strEntFut: string): Boolean;
begin
  Result := (fCfgSis('ENTFUT') = 'S') And (strEntRet = 'E') And (strEntFut = 'S');
end;

function TFatVenda.fVerificaRateiaFreteVendaPresencial(Itens: TMatrizFechamento) : Boolean;
var
  intItem : Integer;
begin
  Result := False;

  if not blnVendaPresencial then
  begin
    Result := True;
    Exit;
  end;

  For intItem := 0 To Length(Itens) -1 Do
  Begin
    if ((fCfgSis('FREPRE', varBoolean, Itens[intItem].strEmpIte)) or (Itens[intItem].strEntRet = 'R')) then
    begin
      Result := True;
      Break;
    end;
  End;
end;

function TFatVenda.fLiberouSenhaParaImprimirDocumentoComPreco: Boolean;
  Var
    objTabela : TRegistroMsgLiberaTabela;
    objLinha : TLinhaMsgLibera;
    objLiberacao : TLiberacao;
    intCnt : Integer;
    strCodEmi : String;
    strDesEmi : String;
    strMarEmi : String;
    strUndEmi : String;
    strQtdEmi : String;
    strUniTar : String;
    strTotIte : String;
    strUniOri : String;
Begin
  objLiberacao := TLiberacao.Create;
  Try
    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Senha para imprimir documento com preço');
    objLiberacao.objMsgLibera.pAddSeparador(75);
    objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'                   , Self.strCliNom                                                 , 24);
    objLiberacao.objMsgLibera.pAddTextoCaption('Valor Total do Documento   ', FormatFloat('#,##0.00', Self.fltTotGer)                       , 24);

    objTabela := TRegistroMsgLiberaTabela.Create;

    objLinha  := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlCabecalho;
    objLinha.pAddColuna(''  , 'Código/Descrição' , 24 , alEsquerda , teAutcom);
    objLinha.pAddColuna(''  , 'Marca'            , 7  , alEsquerda , teAutcom);
    objLinha.pAddColuna(''  , 'Und.'             , 4  , alCentro   , teAutcom);
    objLinha.pAddColuna(''  , 'Quantidade'       , 12 , alDireita  , teAutcom);
    objLinha.pAddColuna(''  , 'Pr. Unitário'     , 13 , alDireita  , teAutcom);
    objLinha.pAddColuna(''  , 'Valor Total'      , 14 , alDireita  , teAutcom);
    objLinha.pAddColuna(''  , 'Pr. Tabela'       , 13 , alDireita  , teAutcom);
    objTabela.lstLinhas.Add(objLinha);

    For intCnt := 0 to Pred(Length(Self.arrMatItens)) Do
    Begin
      strCodEmi := Self.arrMatItens[intCnt].strCodIte;
      strDesEmi := Self.arrMatItens[intCnt].strDesIte;
      strMarEmi := fCampoTabela('MAR_DESMAR', 'CADMAR', ['MAR_CODMAR'], [Self.arrMatItens[intCnt].strCodMar], False);
      strUndEmi := Self.arrMatItens[intCnt].strUnidad;
      strQtdEmi := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), Self.arrMatItens[intCnt].fltQtdIte);
      strUniTar := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), Self.arrMatItens[intCnt].fltUniTar);
      strTotIte := FormatFloat(fMskDigitos(2), Self.arrMatItens[intCnt].fltTotIte);
      strUniOri := FormatFloat(fMskDigitos(fCfgSis('DECQTD', VarInteger)), Self.arrMatItens[intCnt].fltUniOri);

      objLinha  := TLinhaMsgLibera.Create;
      objLinha.enuTipoLinha := tlValor;
      objLinha.pAddColuna('Código/Descrição' , strCodEmi + '-' + strDesEmi  , 24 , alEsquerda );
      objLinha.pAddColuna('Marca'            , strMarEmi                    , 7  , alEsquerda );
      objLinha.pAddColuna('Und.'             , strUndEmi                    , 4  , alCentro   );
      objLinha.pAddColuna('Quantidade'       , strQtdEmi                    , 12 , alDireita  );
      objLinha.pAddColuna('Pr. Unitário'     , strUniTar                    , 13 , alDireita  );
      objLinha.pAddColuna('Valor Total'      , strTotIte                    , 14 , alDireita  );
      objLinha.pAddColuna('Pr. Tabela'       , strUniOri                    , 13 , alDireita  );
      objTabela.lstLinhas.Add(objLinha);
    End;

    objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);
    objLiberacao.strDirAce := 'IMPDCP';
    objLiberacao.strMsgSen := 'Senha para imprimir documento com preço';
    objLiberacao.strCodOpe := strLoginUsuarioLogado;
    objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliNom;
    objLiberacao.strCpfCnpj := Self.strCliCgc;

    Result := objLiberacao.fLibera;
  Finally
    FreeAndNil(objLiberacao);
  End;
end;

function TFatVenda.fEhEmissaoDePedido: Boolean;
begin
  Result := True;

  If (Self.strOpcDoc = 'PD') Then
    Exit;

  If (Self.strOpcDoc = 'OR') And (Self.strEspDoc = 'PD') Then
    Exit;

  If (Self.strOpcDoc = 'VN') And (Self.strEspDoc = 'PD') Then
    Exit;

  Result := False;
end;

