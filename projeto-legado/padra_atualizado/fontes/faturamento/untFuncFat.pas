function TFatVenda.fEmiteNotaEspecial(const strEspecie: String): Boolean;
begin
  Result := False;
  If Pos(strEspecie, 'MI_FF_') > 0 Then
  Begin
    Result := ((fltFatNot > 0) And fCfgSis('FTNFES', varBoolean));

    If (Self.strTipPed = 'D') Then
      Result := (fltFatNot > 0) And (fltFatNot <> 1);
  End;
end;

function TFatVenda.fEmiteNotaFiscalParaCupomOutraLoja: Boolean;
begin
  Result := False;

  If Self.strEspDoc <> 'IF' Then
    Exit;

  If Not Self.blnMulLoj Then
    Exit;

  If fEmptyStr(Self.strEmpLog) Then
    Exit;

  If VS_strCodEmp = Self.strEmpLog Then
    Exit;

  If fCfgSis('USNFCE', varBoolean) And (fPossuiSomenteItensRetira) Then
    Exit;

  Result := True;
end;

function TFatVenda.fEhCondicaoAVistaParaDesmembramento: Boolean;
begin
  Result := True;

  If (fStatusCndPag(Self.strConPag) = A_VISTA) Then
    Exit;

  If ((Pos(Self.strCodFpg, '002_006_007_') > 0) and fCfgSis('PRACHC', VarBoolean)) Then
    Exit;

  Result := False;
end;

function TFatVenda.fValorTotalExpedido: Double;
var
  intRecNo: Integer;
  blnDisabledControl: Boolean;
begin
  Result := 0.0;
  If Not Assigned(objExpedicao) Then
    Exit;
  intRecNo := objExpedicao.cdsItens.RecNo;
  blnDisabledControl := objExpedicao.cdsItens.ControlsDisabled;
  if not blnDisabledControl then
    objExpedicao.cdsItens.DisableControls;

  objExpedicao.cdsItens.First;
  while not objExpedicao.cdsItens.Eof do
  begin
    if (objExpedicao.cdsItens.FieldByName('QTDEXP').AsFloat > 0) then
      Result := Result + (objExpedicao.cdsItens.FieldByName('QTDEXP').AsFloat *
        objExpedicao.cdsItens.FieldByName('FDO_UNITAR').AsFloat);

    objExpedicao.cdsItens.Next;
  end;

  objExpedicao.cdsItens.RecNo := intRecNo;
  if not blnDisabledControl then
    objExpedicao.cdsItens.EnableControls;
end;

function TFatVenda.fFatorParaNotaEspecialTipoD: Double;
  Var
    item: TDadosFechamento;
    fltTotalItens: Double;
    fltTotalItensNotEsp: Double;
begin
  fltTotalItens := 0;
  For item In Self.arrMatItens Do
    fltTotalItens := fltTotalItens + fFormataFloat(item.fltQtdIte * item.fltUnitar, 2);

  fltTotalItensNotEsp := 0;
  For item In Self.arrMatItens Do
    If item.strNotEsp <> 'S' Then //Nao pode emitir MI/FF
      fltTotalItensNotEsp := fltTotalItensNotEsp + fFormataFloat(item.fltQtdIte * item.fltUnitar, 2);

  Result := 0;
  If fltTotalItens <> 0.00 Then
    Result := fltTotalItensNotEsp / fltTotalItens;
end;

procedure TFatVenda.pDefineTipoFaturamentoExpedicao(AEhFaturamentoDePedidoOriundoDeConsignacao : Boolean = False);
begin
  If fEmptyStr(Self.strTipPed) Then
    Exit;


  If (Self.strTipPed = 'A') Then
  Begin
    Self.strEspDoc := 'NF';
    Self.strTipFat := 'Nota Fiscal';
  End

  Else If (Self.strTipPed = 'B') Then
  Begin

    If (AEhFaturamentoDePedidoOriundoDeConsignacao) Then
    Begin
      Self.strEspDoc := 'CS';
      Self.strTipFat := 'Consignação';
    End
    Else If (Self.blnCliFil) Then
    Begin
      Self.strEspDoc := 'TE';
      Self.strTipFat := 'Transferência de Estoque';
    End
    Else If Self.strTipOpe = 'B' Then
    Begin
      Self.strEspDoc := 'BR';
      Self.strTipFat := 'Brinde';
    End
    Else If Self.strTipOpe = 'U' Then
    Begin
      Self.strEspDoc := 'UC';
      Self.strTipFat := 'Uso e Consumo';
    End
    Else
    Begin
      Self.strEspDoc := 'FF';
      Self.strTipFat := 'Faturamento Futuro';
    End;
  End

  Else If (Self.strTipPed = 'C') Then
  Begin
    Self.strEspDoc := 'IF';
    Self.strTipFat := 'Cupom Fiscal';
  End

  Else If (Self.strTipPed = 'D') Then
  Begin
    If (Self.blnCliFil) Then
    Begin
      Self.strEspDoc := 'TE';
      Self.strTipFat := 'Transferência de Estoque';
    End
    Else
    Begin
      //Somente itens que nao permitem MI/FF
      If fFatorParaNotaEspecialTipoD = 1 Then
      Begin
        Self.strEspDoc := 'NF';
        Self.strTipFat := 'Nota Fiscal';
      End
      Else
      Begin
        Self.strEspDoc := 'FF';
        Self.strTipFat := 'Faturamento Futuro';
      End;
    End;
  End;
end;

function TFatVenda.fEmiteNotaEspecialAposFaturamento(const strEspecie: String): Boolean;
begin
  Result := fEmiteNotaEspecial(strEspecie) And (Not Self.blnMeiaNotaComNotaNormal);
end;

procedure TFatVenda.pPreparaParaEmitirMeiaNotaNotaNormal();
  Var
    item: TDadosFechamento;
    objDividirMeiaNota: TDividirItensMeiaNota;
begin
  Self.blnEmitindoFFDaNotaEspecialFatorPorValor := False;
  Self.blnGerarEtiquetaDespachoNFEspecialFatorSemDUPREC := False;
  Self.blnEmitindoNotaEspecialAposFaturamento := fEmiteNotaEspecialAposFaturamento(Self.strEspDoc);

  If Self.blnEmitindoNotaEspecialAposFaturamento Then
  Begin
    If (Self.strEspDoc = 'FF') And (fCfgSis('FTNFES', varBoolean)) And (Self.strTipFatNEs = 'V') Then
    Begin
      if (fCfgSis('DUPREC', varBoolean)) then
        Self.blnEmitindoFFDaNotaEspecialFatorPorValor := True
      else if (fCfgSis('ETIDUP', varBoolean)) then
        Self.blnGerarEtiquetaDespachoNFEspecialFatorSemDUPREC := True;
    End;
  End;

  If Self.strTipPed = 'D' Then
  Begin
    strTipFatNEs := 'Q';
    fltFatNot := fFatorParaNotaEspecialTipoD;
  End;

  If fEmiteNotaEspecial(Self.strEspDoc) Then
  Begin
    Self.blnMeiaNotaComNotaNormal := fMeiaNotaComNotaNormal(strTipFatNEs, fltFatNot);
    Self.fltFatorQtdeMeiaNotaNotaNormal := (1 - fltFatNot);

    objDividirMeiaNota := TDividirItensMeiaNota.Create(Self.arrMatItens, Self.strEspDoc,
      Self.strTipPed, Self.blnMeiaNotaComNotaNormal, Self.fltFatorQtdeMeiaNotaNotaNormal);

    objDividirMeiaNota.pDividirMatrizItens;

    If (Length(objDividirMeiaNota.arrItensMeiaNota)   > 0) Or
       (Length(objDividirMeiaNota.arrItensNotaNormal) > 0) Then
    Begin
      SetLength(Self.arrMatItens, 0);

      For item In objDividirMeiaNota.arrItensMeiaNota Do
      Begin
        SetLength(Self.arrMatItens, Length(Self.arrMatItens) + 1);
        Self.arrMatItens[Length(Self.arrMatItens) - 1] := item;
      End;

      For item In objDividirMeiaNota.arrItensNotaNormal Do
      Begin
        SetLength(Self.arrMatItens, Length(Self.arrMatItens) + 1);
        Self.arrMatItens[Length(Self.arrMatItens) - 1] := item;
      End;

      Self.blnDesmembrarMeiaNotaComNotaNormal := True;
    End;

    FreeAndNil(objDividirMeiaNota);
  End;
end;

function TFatVenda.fGerarContasReceberInteligenteMeiaNotaComNotaNormal: Boolean;
begin
  Result := (fCfgSis('RECINT', VarString) = 'S')       And //Recebimento inteligente
            (Not fConPagComEntrada(strConPag))         And //Nao pode ter entrada
            (strToIntDef(LeftStr(strConPag,2), 0) > 1) And //A prazo com mais de uma parcela
            (blnDesmembrarMeiaNotaComNotaNormal)       And //Desmembramento nota fator expedicao
            (fHaveraDesmembramentoVenda(arrMatItens));     //Havera desmembramento dos documentos
end;

