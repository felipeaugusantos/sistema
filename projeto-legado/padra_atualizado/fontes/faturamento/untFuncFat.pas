    strSQL := strSQL + '  FGO_OPEEXP AS OPEEXP, ';
    strSQL := strSQL + '  FGO_SEPEXP AS SEPEXP, ';
    strSQL := strSQL + '  FGO_CODFAZ AS CODFAZ, ';
    strSQL := strSQL + '  FGO_FORUCO AS FORUCO, ';
    strSQL := strSQL + '  FGO_CTAUCO AS CTAUCO, ';
    strSQL := strSQL + '  FGO_HISUCO AS HISUCO, ';
    strSQL := strSQL + '  FGO_EVEUCO AS EVEUCO, ';
    strSQL := strSQL + '  FGO_CODCAR AS CODCAR, ';
    strSQL := strSQL + '  FGO_QTDPAC AS QTDPAC, ';
    strSQL := strSQL + '  FGO_FASOBR AS FASOBR, ';
    strSQL := strSQL + '  CLI_FANSOB AS FANSOB, ';
    strSQL := strSQL + '  OPE_INTEXT, ';
    strSQL := strSQL + '  CLI_STREES AS STREES, ';
    strSQL := strSQL + '  CLI_PRSTRE AS PRSTRE, ';
    strSQL := strSQL + '  FGO_CODEMB AS CODEMB, ';
    strSQL := strSQL + '  CLI_REGFIS AS REGFIS, ';
    strSQL := strSQL + '  CLI_DESOST AS DESOST, ';
    strSQL := strSQL + '  CLI_DESOMT AS DESOMT, ';
    strSQL := strSQL + '  CLI_NATSER AS NATSER, ';
    strSQL := strSQL + '  FGO_CLICEO AS CLICEO, ';
    strSQL := strSQL + '  FGO_CLITOP AS CLITOP, ';
    strSQL := strSQL + '  FGO_TIPOPE AS TIPOPE, ';
    strSQL := strSQL + '  FGO_SUPGER AS SUPGER, ';
    strSQL := strSQL + '  FGO_SUPREG AS SUPREG  ';
    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  FATGOR ';
    strSQL := strSQL + '  JOIN CADCLI ON FGO_CODCLI = CLI_CODCLI ';
    strSQL := strSQL + '  JOIN CADOPE ON OPE_CODOPE = FGO_CODVEN ';
    strSQL := strSQL + '  LEFT JOIN CADREG ON CADCLI.CLI_CODREG = REG_CODREG ';

    strSQL := strSQL + '  LEFT JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';
    strSQL := strSQL + '  LEFT JOIN SERGOR ON SERGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';

    strSQL := strSQL + '  LEFT JOIN AUXGOR ON FATGOR.AUTOINCREM = AUX_SEQGER                                    ';
    strSQL := strSQL + '  LEFT JOIN ENTCLI ON ETC_CODCLI = FGO_CODCLI AND                                       ';
    strSQL := strSQL + '    IF(AUX_ENTGER IS NOT NULL, ENTCLI.AUTOINCREM = AUX_ENTGER,                              ';
    strSQL := strSQL + '       ETC_SEQIND = (SELECT MIN(ETC_SEQIND) FROM ENTCLI WHERE ETC_CODCLI = CLI_CODCLI)) ';

    strSQL := strSQL + 'WHERE ';
    //strSQL := strSQL + '  FGO_CODCLI = CLI_CODCLI AND ';
    strSQL := strSQL + '  FGO_NUMDOC = :NUMDOC AND ';
    strSQL := strSQL + '  FGO_ESPDOC = :ESPDOC AND ';
    strSQL := strSQL + '  FGO_CODEMP = :CODEMP ';

    With qryGeral Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMDOC').AsString := fatVenda.strNumOrc;
      ParamByName('ESPDOC').AsString := fatVenda.strEspOrc;

      If fatVenda.blnAlteraFormaPagamentoLiberacaoPedidoMultiEmp Or fatVenda.blnEmGeracaoVendasPerdidas Then
        ParamByName('CODEMP').AsString := fatVenda.fEmpresaDocumentoGravaArquivos()
      Else If fatVenda.fEhDesmembramentoExpedicaoRegimeEspecial And (Not fEmptyStr(fatVenda.strEmpOri)) Then
        ParamByName('CODEMP').AsString := fatVenda.strEmpOri
      Else
        ParamByName('CODEMP').AsString := IIF((fCfgSis('ALTLOJ') <> 'S') and (Not fatVenda.blnOrigemCRM) and (Not blnPedidoEntCd), strCodEmpSel, IIF(fEmptyStr(fatVenda.strEmpOri), strCodEmpSel, fatVenda.strEmpOri));

      Open;
    End;

    If blnCarregaSomenteEstadoCliente Then
    Begin
      fatVenda.strCliEst := fRetNomCidade(qryGeral.FieldByName('CODCID').AsString,1); //         - Estado
    End
    Else
    Begin
      fatVenda.strCliEma := qryGeral.FieldByName('EMAIL_').AsString;                 // Email
      fatVenda.strCliEm2 := qryGeral.FieldByName('EMAIL2').AsString;                 // Email 2
      fatVenda.strTipFre := qryGeral.FieldByName('TIPFRE').AsString;                 // TIPFRE
      fatVenda.strInRqCp := qryGeral.FieldByName('INRQCP').AsString;                  // Incremento da Requisição de Compras
      fatVenda.strTraRdp := qryGeral.FieldByName('TRARDP').AsString;                  // Cód. Tra. Redespacho
      fatVenda.strCndFor := fFormataCondPag(qryGeral.FieldByName('CONPAG').AsString); // Condição de pagamento formatada
      fatVenda.strCodCli := qryGeral.FieldByName('CODCLI').AsString;                  // Cliente - Codigo
      fatVenda.strCliNom := qryGeral.FieldByName('CLINOM').AsString;                  //         - Nome
      fatVenda.strCliOri := qryGeral.FieldByName('CLIORI').AsString;                  //         - Nome Original
      fatVenda.strCliNum := qryGeral.FieldByName('ENDNUM').AsString;                  //         - Numero
      fatVenda.strCliCom := qryGeral.FieldByName('ENDCOM').AsString;                  //         - Complemento

      fatVenda.strCliEnd := qryGeral.FieldByName('ENDERE').AsString;                  //         - Endereco

      If Not fEmptyStr(qryGeral.FieldByName('ENDNUM').AsString) Then
        fatVenda.strCliEnd := fatVenda.strCliEnd + ', '+ qryGeral.FieldByName('ENDNUM').AsString;

      If Not fEmptyStr(qryGeral.FieldByName('ENDCOM').AsString) Then
        fatVenda.strCliEnd := fatVenda.strCliEnd + '  '+ qryGeral.FieldByName('ENDCOM').AsString;

      If Trim(fatVenda.strCliEnd) = ',' then
        fatVenda.strCliEnd := '';

      fatVenda.strCliBai := qryGeral.FieldByName('BAIRRO').AsString;                  //         - Bairro
      fatVenda.strCliCep := qryGeral.FieldByName('C_E_P_').AsString;                  //         - Cep
      fatVenda.strCodCid := qryGeral.FieldByName('CODCID').AsString;                  //         - Cód. Cidade
      fatVenda.strCliCid := fRetNomCidade(qryGeral.FieldByName('CODCID').AsString,0); //         - Cidade
      fatVenda.strCliEst := fRetNomCidade(qryGeral.FieldByName('CODCID').AsString,1); //         - Estado
      fatVenda.strCodAti := qryGeral.FieldByName('CONATI').AsString;                  // Consumidor - Codigo da Atividade
      fatVenda.strCliAti := qryGeral.FieldByName('CODATI').AsString;
      fatVenda.blnConstr := fAtividadeConstrutora(qryGeral.FieldByName('CODATI').AsString); // Cliente Construtora?
      fatVenda.strCliTel := qryGeral.FieldByName('FONE01').AsString;                  //         - Telefone
      fatVenda.dtaNasCon := qryGeral.FieldByName('NASCON').AsDateTime;                //         - Nascimento
      fatVenda.strCli_Rg := qryGeral.FieldByName('NUM_RG').AsString;                  //         - RG
      fatVenda.strCliCgc := fTiraCaracEspeciais(qryGeral.FieldByName('C_G_C_').AsString);//      - CNPJ
      fatVenda.strCliCgc := AnsiReplaceStr(fatVenda.strCliCgc, '.', '');
      fatVenda.intCgcCpf := qryGeral.FieldByName('CGCCPF').AsInteger;                 //         - CGC/CPF
      fatVenda.strCliIes := qryGeral.FieldByName('I_E_S_').AsString;                  //         - Ins.Estadual
      fatVenda.strCliImp := qryGeral.FieldByName('I_M_P_').AsString;                  //         - Insc. Municipal Produtor
      fatVenda.strProRur := qryGeral.FieldByName('PRORUR').AsString;                  //         - Produtor Rural
      fatVenda.strMicEmp := qryGeral.FieldByName('MICEMP').AsString;                  //         - MEI-Micro Empreendedor Individual
      fatVenda.strRetPCo := qryGeral.FieldbyName('RETPCO').AsString;                  //         - Retenção de Pis e Cofins
      fatVenda.strRetIrf := qryGeral.FieldbyName('RETIRF').AsString;                  //         - Retenção de IRPF
      fatVenda.strCDesPI := qryGeral.FieldbyName('CDESPI').AsString;                  //         - Calcula desconto de PIS/COFINS/IRPJ/CSLL
      fatVenda.strCluFid := qryGeral.FieldByName('CLUFID').AsString;                  //         - Clube Fidelidade
      fatVenda.strCliFid := qryGeral.FieldByName('CLIFID').AsString;                  //         - Cliente Fidelidade
      fatVenda.strSitIPI := qryGeral.FieldByName('SITIPI').AsString;                  //         - Situacao do IPI
      fatVenda.strEnqIPI := qryGeral.FieldByName('ENQIPI').AsString;                  //         - Enquadramento do IPI
      fatVenda.strMenIPI := qryGeral.FieldByName('MENIPI').AsString;                  //         - Mensagem do IPI
      fatVenda.strSitP_C := qryGeral.FieldByName('SITP_C').AsString;                  //         - Situacao do Pis e Cofins
      fatVenda.strSitPCP := qryGeral.FieldByName('SITPCP').AsString;                  //         - Situacao do Pis e Cofins
      fatVenda.strMenP_C := qryGeral.FieldByName('MENP_C').AsString;                  //         - Mensagem do Pis e Cofins
      fatVenda.strRetIss := qryGeral.FieldbyName('RETISS').AsString;                  //         - Retenção de ISS
      fatVenda.strCliOrg := qryGeral.FieldByName('ORGPUB').AsString;                  //         - Orgao Publico
      fatVenda.strOrgFde := qryGeral.FieldByName('ORGFDE').AsString;                  //         - Orgao Publico fora do estado
      fatVenda.strDesPis := qryGeral.FieldByName('DESPIS').AsString;                  //         - Orgao Publico
      fatVenda.strOrPuRD := qryGeral.FieldbyName('ORPURD').AsString;                  //         - Tipo de Desconto (Rateio / Desconto)
      fatVenda.strCalIcm := qryGeral.FieldbyName('CALICM').AsString;                  //         - Calcula Desconto de ICMS (Orgão Public)
      fatVenda.strPerEmp := qryGeral.FieldByName('PEREMP').AsString;                  //         - Permite Emprestimo
      fatVenda.strCliPer := qryGeral.FieldByName('PERMUT').AsString;
      fatVenda.strSegSoc := qryGeral.FieldByName('SEGSOC').AsString;                  //         - Seguridade Social
      fatVenda.strZonFra := qryGeral.FieldByName('ZONFRA').AsString;                  //         - Zona Francade Manaus
      fatVenda.strDesZon := qryGeral.FieldByName('DESZON').AsString;                  //         - Desconto Especial Cliente Zona Franca
      fatVenda.strCodReg := qryGeral.FieldByName('CODREG').AsString;                  //         - Código Da Região
      fatVenda.strDesReg := fRetDesRegiao(qryGeral.FieldByName('CODREG').AsString);   //         - Descrição da Região
      fatVenda.strCodZfm := qryGeral.FieldByName('CODZFM').AsString;                  //         - Cód. Cliente p/ Zona Francade Manaus
      fatVenda.strTipOpe := qryGeral.FieldByName('TIPOPE').AsString;
      fatVenda.blnCliExportacaoIndireta := fEhExportacaoIndireta(qryGeral.FieldByName('EXPIND').AsString, fatVenda.strTipOpe); //     - Cliente Exportação Indireta
      fatVenda.strCliCon := qryGeral.FieldByName('CONSUM').AsString;                  //         - Consumidor Final (S/N)
      fatVenda.strTpOper := qryGeral.FieldByName('TPOPER').AsString;
      fatVenda.strIndCom := qryGeral.FieldByName('INDCOM').AsString;                  //         - Comercializacao/industrializacao
      fatVenda.blnCliFil := fatVenda.fClienteFilialVenda(qryGeral.FieldByName('CODCLI').AsString);  //         - Cliente Filial
      fatVenda.fltFat_TE := fatVenda.recDadCli.fltFat_TE;
      fatVenda.fltFatTE2 := fatVenda.recDadCli.fltFatTE2;
      fatVenda.strTEPREV := fatVenda.recDadCli.strTEPREV;
      fatVenda.strTEPPRO := fatVenda.recDadCli.strTEPPRO;
      fatVenda.blnPermFF := ((qryGeral.FieldByName('PERMFF').AsString = 'S') Or (qryGeral.FieldByName('PERMFV').AsString = 'S'));//         - Permite FF
      fatVenda.npcNumCmp := fatVenda.fBuscaNumsCmp(qryGeral.FieldByName('NUMDOC').AsString,
                                                   qryGeral.FieldByName('ESPDOC').AsString,
                                                   qryGeral.FieldByName('CODCLI').AsString,
                                                   qryGeral.FieldByName('CODEMP').AsString);
      fatVenda.strCodVen := qryGeral.FieldByName('CODVEN').AsString;                  // Vendedor      - Codigo
      fatVenda.strNomVen := fRetNomVendRep(qryGeral.FieldByName('CODVEN').AsString);  // Vendedor      - Nome
      fatVenda.strCodDig := qryGeral.FieldByName('CODDIG').AsString;                  // Digitador     - Codigo
      fatVenda.strNomDig := fRetNomVendRep(qryGeral.FieldByName('CODDIG').AsString);  // Digitador     - Nome
      fatVenda.strCodRep := qryGeral.FieldByName('CODREP').AsString;                  // Representante - Codigo
      fatVenda.strNomRep := fRetNomVendRep(qryGeral.FieldByName('CODREP').AsString);  // Representante - Nome
      fatVenda.strCodDiv := fRetCodDiv('FATDOR',qryGeral.FieldByName('AUTINC').AsString);  // Codigo Profissional (CADDIV)

      fatVenda.strTabPre := qryGeral.FieldByName('TABPRE').AsString;                  //         - Tabela de Preco

      If fEmptyStr(fatVenda.strTabPre) And fCfgSis('HIETAB', VarBoolean) Then
        fatVenda.strTabPre := fCampoTabela('OPE_TABPRE', 'CADOPE', ['OPE_CODOPE'], [fatVenda.strCodVen], False);

      fatVenda.fltTotGer := qryGeral.FieldByName('VLRCON').AsFloat;                  // Total Geral
      fatVenda.fltTotPro := qryGeral.FieldByName('TOTPRO').AsFloat;                  // Total dos Produtos
      fatVenda.fltTotCus := qryGeral.FieldByName('TOTCUS').AsFloat;                  // Total do Custo
      fatVenda.fltDesEsp := qryGeral.FieldByName('DESESP').AsFloat;                  // Desconto Especial
      fatVenda.fltPorDes := qryGeral.FieldByName('PORDES').AsFloat;                  // % de Desconto Geral
      fatVenda.fltBasRet := qryGeral.FieldByName('BASRET').AsFloat;                  // Total da Base - ICMS RETIDO
      fatVenda.fltAlqRet := qryGeral.FieldByName('ALQRET').AsFloat;                  // Alíquota de ICMS Retido
      fatVenda.fltTotRet := qryGeral.FieldByName('TOTRET').AsFloat;                  // Total - ICMS RET
      fatVenda.fltBasIcm := qryGeral.FieldByName('BASICM').AsFloat;                  // ICMS - Base
      fatVenda.fltTotIcm := qryGeral.FieldByName('TOTICM').AsFloat;                  //      - Total
      fatVenda.fltBasIpi := qryGeral.FieldByName('BASIPI').AsFloat;                  // IPI  - Base
      fatVenda.fltAlqIpi := qryGeral.FieldByName('ALQIPI').AsFloat;                  // IPI  - Alíquota
      fatVenda.fltTotIpi := qryGeral.FieldByName('TOTIPI').AsFloat;                  //      - Total
      fatVenda.fltAlqIcm := qryGeral.FieldByName('ALQICM').AsFloat;                  // Aliquota de Icms

      If ((fatVenda.strOriF11 <> 'S') And (fatVenda.strOpcDoc <> 'CP')) Then
        fatVenda.strConPag := qryGeral.FieldByName('CONPAG').AsString; // Condição de Pagamento

      If (fatVenda.strOpcDoc <> 'CP') Then
      Begin
        fatVenda.strCodCnd := qryGeral.FieldByName('CODCND').AsString;                  // Condicao      - Codigo
        fatVenda.strCodFpg := qryGeral.FieldByName('CODFPG').AsString;                  // Código da Forma de Pagamento
      End;

      fatVenda.strDesCnd      := fRetDesConPag(fatVenda.strCodCnd);   // Condicao      - Descricao
      fatVenda.strDesFpg      := fRetDesFpg(fatVenda.strCodFpg);      // Descrição da Forma de Pagamento
      fatVenda.blnCndEsp      := (fRetEspConPag(fatVenda.strCodCnd) = 'S');
      fatVenda.blnCndTravaCli := (fRetTraCliConPag(fatVenda.strCodCnd) = 'S');

      fatVenda.strEndEnt := qryGeral.FieldByName('ENDENT').AsString;
      fatVenda.strBaiEnt := qryGeral.FieldByName('BAIENT').AsString;
      fatVenda.strCepEnt := FormatMaskText('99999-999;0;_', qryGeral.FieldByName('CEPENT').AsString);
      fatVenda.strCidEnt := qryGeral.FieldByName('CIDENT').AsString;
      fatVenda.strNomCidEnt := fRetNomCidade(qryGeral.FieldByName('CIDENT').AsString);
      fatVenda.strEstEnt := fRetNomCidade(qryGeral.FieldByName('CIDENT').AsString, 1);
      fatVenda.strRefEnt := qryGeral.FieldByName('REFENT').AsString;
      fatVenda.strRegEnt := qryGeral.FieldByName('REGENT').AsString;
      fatVenda.strCobIss := qryGeral.FieldByName('COBISS').AsString;

      {Quando J_A_MASSA_CONCRETO, será informado Obra e ART na tela de "frmFatDigDadosConcreto"}
      If (fCfgSis('USACCR', varBoolean) And (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO)) Or fatVenda.blnExpedi Then
      Begin
        fatVenda.strCodObr := qryGeral.FieldByName('CODOBR').AsString;
        fatVenda.strCodArt := qryGeral.FieldByName('CODART').AsString;
        fatVenda.strCodCno := qryGeral.FieldByName('CODCNO').AsString;
        fatVenda.strInsImo := qryGeral.FieldByName('INSIMO').AsString;
        fatVenda.strCodCib := qryGeral.FieldByName('CODCIB').AsString;
      End;

      fatVenda.strFasObr := qryGeral.FieldByName('FASOBR').AsString;

      fatVenda.strEndCob := qryGeral.FieldByName('ENDCOB').AsString;
      fatVenda.strBaiCob := qryGeral.FieldByName('BAICOB').AsString;
      fatVenda.strCepCob := FormatMaskText('99999-999;0;_', qryGeral.FieldByName('CEPCOB').AsString);
      fatVenda.strCidCob := fRetNomCidade(qryGeral.FieldByName('CIDCOB').AsString);
      fatVenda.strEstCob := fRetNomCidade(qryGeral.FieldByName('CIDCOB').AsString, 1);

      fatVenda.strCndFor := fFormataCondPag(fatVenda.strConPag); // Condição de Pagamento
      fatVenda.fltTotCre := fGetTotalCreditosCliente(fatVenda.strCodCli);

      fatVenda.strTipVen := qryGeral.FieldByName('OPE_INTEXT').AsString;

      fatVenda.strDiferi := qryGeral.FieldByName('DIFERI').AsString;
      fatVenda.strDif_ST := qryGeral.FieldByName('DIF_ST').AsString;
      fatVenda.strSitP_C := qryGeral.FieldByName('SITP_C').AsString;
      fatVenda.strSitPCP := qryGeral.FieldByName('SITPCP').AsString;
      fatVenda.strMenP_C := qryGeral.FieldByName('MENP_C').AsString;

      fatVenda.strEntreg := qryGeral.FieldByName('CONENT').AsString;

      fatVenda.fltRedIcmsCli := qryGeral.FieldByName('REDICM').AsFloat;

      fatVenda.strCodCac := qryGeral.FieldByName('CODCAC').AsString;
      fatVenda.strCliDAc := qryGeral.FieldByName('CODEAC').AsString;

      fatVenda.strObserv := qryGeral.FieldByName('OBSERV').AsString;                   //         - Observações

      fatVenda.strCliOrgDifal := qryGeral.FieldByName('ORPUDF').AsString;

      fatVenda.strNumPok    := qryGeral.FieldByName('NUMPOK').AsString;
      fatVenda.fltDesOpeGor := qryGeral.FieldByName('DESOPD').AsFloat;

      fatVenda.pProcessarDespesasOperacionaisComplementar(qryGeral.FieldByName('DESOPE').AsFloat);

      fatVenda.strCodCar := qryGeral.FieldByName('CODCAR').AsString;
      fatVenda.intQtdPaC := qryGeral.FieldByName('QTDPAC').AsInteger;

      fatVenda.strStReEs := qryGeral.FieldByName('STREES').AsString;
      fatVenda.strPrStRe := qryGeral.FieldByName('PRSTRE').AsString;
      fatVenda.strRegFis := qryGeral.FieldByName('REGFIS').AsString;
      fatVenda.fltRedIss := qryGeral.FieldByName('REDISS').AsFloat;
      fatVenda.fltDescProfissional := qryGeral.FieldByName('DESCON').AsFloat;

      fatVenda.strDesoST := qryGeral.FieldByName('DESOST').AsString;
      fatVenda.strDesoMT := qryGeral.FieldByName('DESOMT').AsString;

      fatVenda.strNatSer := qryGeral.FieldByName('NATSER').AsString;

      If fCfgSis('UTTRDP', VarBoolean)  Then
        fatVenda.strTraRdp := qryGeral.FieldByName('TRARED').AsString;

      fatVenda.pAtualizaClassTransferencias;

      If fCfgSis('CADFAZ', VarBoolean) And
         Not fEmptyStr(qryGeral.FieldByName('CODFAZ').AsString) Then
      Begin
        fatVenda.fSelecionarFazendaCliente(qryGeral.FieldByName('CODCLI').AsString,
                                           qryGeral.FieldByName('CODFAZ').AsString);
      End;

      If fCfgSis('CADEMB', VarBoolean) And Not fEmptyStr(qryGeral.FieldByName('CODEMB').AsString) Then
      Begin
        fatVenda.strCodEmbarcacao := qryGeral.FieldByName('CODEMB').AsString;
      End;

      fatVenda.strFornecedorUsoConsumo  := qryGeral.FieldByName('FORUCO').AsString;
      fatVenda.strCentroCustoUsoConsumo := qryGeral.FieldByName('CTAUCO').AsString;
      fatVenda.strHistoricoUsoConsumo   := qryGeral.FieldByName('HISUCO').AsString;
      fatVenda.strEventoUsoConsumo      := qryGeral.FieldByName('EVEUCO').AsString;
      fatVenda.strCliCEO                := qryGeral.FieldByName('CLICEO').AsString;
      fatVenda.strCliTop                := qryGeral.FieldByName('CLITOP').AsString;
      fatVenda.strTipOpe                := qryGeral.FieldByName('TIPOPE').AsString;
      fatVenda.strSupGer                := qryGeral.FieldByName('SUPGER').AsString;
      fatVenda.strSupReg                := qryGeral.FieldByName('SUPREG').AsString;
    End;
  Finally
    qryGeral.Close;
    FreeAndNil(qryGeral);
  End;
end;

procedure TFatVenda.pCarregaEnderecoEntrega(fatVenda        : TFatVenda;
                                            strTabela,
                                            strAutInc       : String;
                                            blnAltEnd       : Boolean = False;
                                            blnDevolucaoFul : Boolean = False);
  Var
    qryEntCli: TUniQuery;
    blnEndFat: Boolean;
Begin
  blnEndFat := ( fCfgSis('NVORPD',varBoolean) And (Pos(strOpcDoc, 'PD_OR') > 0) And fEmptyStr(strAutInc) And blnAltEnd );
  qryEntCli := fCriaQuery(Self);
  With qryEntCli Do
  Begin
    SQL.Text := fatVenda.objEndEnt.fCarregaEnderecoEntrega(strTabela, blnEndFat);

    ParamByName('CODCLI').AsString := fatVenda.strCodCli;

    If Params.FindParam('AUTINC') <> Nil Then
      ParamByName('AUTINC').AsString := strAutInc;

    Open;

    If IsEmpty Then
    Begin
      fatVenda.strEndEnt := '';
      fatVenda.strBaiEnt := '';
      fatVenda.strCepEnt := '';
      fatVenda.strCidEnt := '';
      fatVenda.strNomCidEnt := '';
      fatVenda.strEstEnt := '';
      fatVenda.strRefEnt := '';
      fatVenda.strConCli := '';
      fatVenda.strFonCli := '';
      fatVenda.strTraEnt := '';
      fatVenda.strTipFre := '';
      fatVenda.strLocArm := '';

      If blnAltEnd Then
      Begin
        fatVenda.strAutEnt := '';
        FillChar(fatVenda.objEndEnt.recEndere, SizeOf(fatVenda.objEndEnt.recEndere), #0);
      End;

    End Else
    Begin

      If blnDevolucaoFul Then
      Begin
        fatVenda.strCliTel := FieldByName('ETC_TELENT').AsString;
        fatVenda.strCliCom := FieldByName('ETC_ENDENT').AsString;
