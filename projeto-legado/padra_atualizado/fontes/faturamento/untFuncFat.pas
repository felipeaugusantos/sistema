function TFatVenda.fBaixaDocumentosPromocaoBrindes(pgbStatus: TcxProgressBar): Boolean;
  Var
    qryGen: TUniQuery;

  function fItem(strField: String): TField;
  begin
    Result := cdsItensPromocaoBrindes.FieldByName(strField);
  end;

begin
  If Not Assigned(cdsItensPromocaoBrindes) Then
  Begin
    Result := True;
    Exit;
  End;

  Try
    qryGen := fCriaQuery;
    cdsItensPromocaoBrindes.DisableControls;

    cdsItensPromocaoBrindes.First;
    While Not cdsItensPromocaoBrindes.Eof Do
    Begin
      pInformacao('Baixando documentos de venda selecionados.', pgbStatus);
      pProgresso(cdsItensPromocaoBrindes.RecNo, cdsItensPromocaoBrindes.RecordCount, pgbStatus);

      If (fItem('ITESEL').AsString = 'S') Then
      Begin
        With qryGen, SQL Do
        Begin
          Close;
          Clear;

          Add('  UPDATE    ');
          Add('    ' + fItem('TABDET').AsString + ', ');
          Add('    ' + fItem('TABTRI').AsString + '  ');
          Add('  SET       ');
          Add('    DET_DOCBRI = "' + Concat(strNumDoc, '-', strEspDoc, '-', strEmpDoc) + '" ');
          Add('  WHERE ');
          Add('    ' + fItem('TABDET').AsString + '.AUTOINCREM = '  + fItem('TABTRI').AsString + '.DET_SEQGER AND ');
          Add('    ' + fItem('TABDET').AsString + '.AUTOINCREM = "' + fItem('AUTINC').AsString + '" ');

          ExecSQL;
        End;
      End;

      cdsItensPromocaoBrindes.Next;
    End;

    Result := True;
  Finally
    FreeAndNil(qryGen);
    cdsItensPromocaoBrindes.EnableControls;
  End;
end;

