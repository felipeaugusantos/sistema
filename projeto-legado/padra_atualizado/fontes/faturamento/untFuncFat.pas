function TFatVenda.fMostraDocDevDemonstracao: Boolean;
Begin
  Result := False;

  Try

    pCriarFormularios(TfrmFatMostraDocDevDemonst, frmFatMostraDocDevDemonst);
    frmFatMostraDocDevDemonst.fatVenda  := Self;
    frmFatMostraDocDevDemonst.strCodCli := strCodCli;
    frmFatMostraDocDevDemonst.ShowModal;
    Result := frmFatMostraDocDevDemonst.blnConfirma;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[TFatVenda.fMostraDocDevDemonstracao]');
  End;

  pFreeAndNil(frmFatMostraDocDevDemonst);
End;

function TFatVenda.fMovCarJaExiste(strCodCli, strSequen, strCodEmp, strNumDoc,
  strEspDoc: String; intCnt2: Integer): Boolean;
var
  qryMovCar: TUniQuery;
begin
  qryMovCar := fCriaQuery(Nil);

  Try
    With qryMovCar Do
    Begin
      SQL.Add('SELECT AUTOINCREM ');
      SQL.Add('FROM MOVCAR ');
      SQL.Add('WHERE MCA_CODCLI = :CODCLI AND ');
      SQL.Add('      MCA_PARCEL = :PARCEL AND ');
      SQL.Add('      MCA_CODEMP = :CODEMP AND ');
      SQL.Add('      MCA_DOCUME = :DOCUME AND ');
      SQL.Add('      MCA_HIST01 = "FULFILLMENT" ');

      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('PARCEL').AsString := strSequen;
      ParamByName('CODEMP').AsString := strCodEmp;
      ParamByName('DOCUME').AsString := fDocumeCar(strNumDoc, strEspDoc, strCodEmp, intCnt2);
      Open;

      Result := Not IsEmpty;
    End;

  Finally
    qryMovCar.Close;
    FreeAndNil(qryMovCar);
  End;
end;

function TFatVenda.fMudouCliDoPedOrcComSugCndPagDiferente: Boolean;
   Var
     strSugCndCliOri,
     strSugCndCliAtu: String;
begin
  Result := (Not fEmptyStr(Self.strNumOrc)) And (Self.strCodCli <> Self.strCliAnt);

  If Result Then
  Begin
    strSugCndCliOri := fCampoTabela('CND_CODCND', 'CLICND', ['CND_CODCLI', 'CND_SUGEST'], [Self.strCliAnt, 'S']);
    strSugCndCliAtu := fCampoTabela('CND_CODCND', 'CLICND', ['CND_CODCLI', 'CND_SUGEST'], [Self.strCodCli, 'S']);

    Result := (Not fEmptyStr(strSugCndCliOri + strSugCndCliAtu)) And (strSugCndCliOri <> strSugCndCliAtu);
  End;
end;

function TFatVenda.fCarregaItensDevDemonstracao(blnUtilizaVendaMadOuVid: Boolean): Variant;
Var
  cdsIteDev  : TUniClientDataSet;
  dspIteDev  : TUniDataSetProvider;
  qryIteDev  : TUniQuery;
  blnConfirma: Boolean;

  function fGetSQL(blnVazio: Boolean): String;
  Begin
    Result := '';
    Result := Result + '/* untFuncFat(fCarregaItensDevDemonstracao) */';
    Result := Result + 'SELECT ';
    Result := Result + '  "MOVDET"     AS DET_TABELA, ';
    Result := Result + '  D.AUTOINCREM AS AUTOINCREM, ';
    Result := Result + '  DET_NUMDOC,  ';
    Result := Result + '  DET_ESPDOC,  ';
    Result := Result + '  DET_CODEMP,  ';
    Result := Result + '  DET_CODCLI,  ';
    Result := Result + '  DET_CODITE,  ';
    Result := Result + '  DET_DESCRI,  ';
    Result := Result + '  DET_QTDITE,  ';
    Result := Result + '  DET_UNITAR,  ';
    Result := Result + '  DET_DESESP,  ';
    Result := Result + '  DET_TOTITE,  ';
    Result := Result + '  DET_ESTADO,  ';
    Result := Result + '  DET_CODACA,  ';
    Result := Result + '  DET_EMPACA,  ';
    Result := Result + '  DET_CLAFIS,  ';
    Result := Result + '  DET_QTDEMB,  ';
    Result := Result + '  DET_PREEMB,  ';
    Result := Result + '  DET_ITEEMB,  ';
    Result := Result + '  DET_TIPEMB,  ';
    Result := Result + '  DET_PROEMB,  ';
    Result := Result + '  DET_IDEPRO,  ';
    Result := Result + '  DET_TOTCU2,  ';
    Result := Result + '  DET_TOTCUS,  ';

    Result := Result + '  DET_UNIDAD,  ';
    Result := Result + '  DET_CODMAR,  ';
    Result := Result + '  DET_FORITE,  ';
    Result := Result + '  DET_REFERE,  ';
    Result := Result + '  DET_VAL_RT,  ';
    Result := Result + '  DET_UNIORI,  ';
    Result := Result + '  DET_UNIVIS,  ';
    Result := Result + '  DET_TAXJUR,  ';
    Result := Result + '  DET_DESCON,  ';
    Result := Result + '  DET_TABPRE,  ';
    Result := Result + '  DET_INCPIS,  ';
    Result := Result + '  DET_TOTPES,  ';
    Result := Result + '  DET_PROMOC,  ';
    Result := Result + '  DET_SEQTIN,  ';
    Result := Result + '  DET_NUM_PD,  ';
    Result := Result + '  DET_ESP_PD,  ';
    Result := Result + '  DET_EMP_PD,  ';
    Result := Result + '  DET_QTDPON,  ';
    Result := Result + '  DET_CODACA,  ';
    Result := Result + '  DET_EMPACA,  ';
    Result := Result + '  DET_PROACA,  ';
    Result := Result + '  DET_NUMLOT,  ';
    Result := Result + '  DET_CODVEN,   ';

    {************************************************}
    {* CAMPO UTILIZADO PARA COMPARAÇÃO NA DEVOLUÇÃO *}
    {*********************************************RV*}
    Result := Result + '  ROUND(IF(DET_DESESP > 0, ((DET_TOTITE - DET_DESESP) / DET_QTDITE), DET_UNITAR), ' + fCfgSis('DECUNI') + ') AS DET_COMPAR, ';
    Result := Result + '  DET_UNITAR, ';
    Result := Result + '  DET_QTDITE, ';
    Result := Result + '  DET_QTDITE AS DET_QTDORI, ';

    If blnUtilizaVendaMadOuVid Then
    Begin
      Result := Result + '  DET_COMPEC, ';
      Result := Result + '  DET_LARPEC, ';
      Result := Result + '  DET_ESPPEC, ';

      Result := Result + '  DET_APAREL, ';
      Result := Result + '  DET_PERAPA, ';
      Result := Result + '  DET_BENEFI, ';
      Result := Result + '  DET_PERBEN, ';
    End;

    Result := Result + '  DET_CODVEN,  ';
    Result := Result + '  DET_DTAENT,  ';
    Result := Result + '  DET_CODFIS,  ';
    Result := Result + '  DET_CODDIV   ';

    Result := Result + 'FROM ';
    Result := Result + '  MOVDET D ';
    Result := Result + '  INNER JOIN CADITE C ON C.ITE_CODITE = D.DET_CODITE ';
    Result := Result + '  INNER JOIN MOVTRI T ON T.DET_SEQGER = D.AUTOINCREM ';

    If blnUtilizaVendaMadOuVid Then
      Result := Result + ' LEFT JOIN MOVMAD M ON M.DET_SEQGER = D.AUTOINCREM  ';

    Result := Result + 'WHERE ';

    If (blnVazio) Then
      Result := Result + '  FALSE '
    Else
    Begin
      Result := Result + '  IFNULL(DET_ENTFUT, "N") <> "S"  AND ';
      Result := Result + '  IFNULL(DET_PROEMB, "N") <> "S"  AND ';
      Result := Result + '  DET_TIP_FC = "C"                AND ';
      Result := Result + '  DET_JAFATU = 0                  AND ';
      Result := Result + '  DET_ESPDOC IN ("NF", "EL")      AND ';
      Result := Result + '  DET_NUMDOC = :NUMDOC            AND ';
      Result := Result + '  DET_ESPDOC = :ESPDOC            AND ';
      Result := Result + '  DET_CODEMP = :CODEMP            AND ';
      Result := Result + '  DET_CODCLI = :CODCLI                ';

      Result := Result + '  UNION ALL ' + AnsiReplaceStr(AnsiReplaceStr(Result, 'MOVDET', 'NOTDET'), 'MOVTRI', 'NOTTRI');
    End;
  End;

