function TFatVenda.fRetornaHistoricoDeContasAReceber: String;
  Const
    MSG_REFAFAT   = 1;
    MSG_CLIENTE   = 2;
    MSG_DOCUMENTO = 3;
    MSG_PAGAMENTO = 4;
  Var
    intOpMsgCtr: Integer;
    intContador: Integer;
    strHisCtr: String;
begin
  intOpMsgCtr := fCfgSis('HISCTR', varInteger);
  strHisCtr := '';

  If (Pos(strClaFis, VS_strClaVen) > 0) Then
  Begin
    Case (intOpMsgCtr) of
      MSG_REFAFAT:
      Begin
        strHisCtr := 'REFERENTE A FATURAMENTO';
      End;

      MSG_CLIENTE:
      Begin
        strHisCtr := fRetNomCliente(strCodCli) + '-' + strCodCli;
      End;

      MSG_DOCUMENTO:
      Begin
        strHisCtr := '';
        For intContador := 1 To 5 Do
          If Not fEmptyStr(fMensagemDocumento(intContador)) Then
            strHisCtr := strHisCtr + fMensagemDocumento(intContador) + STRING_QUEBRA;
      End;

      MSG_PAGAMENTO:
      Begin
        strHisCtr :=
          'REFERENTE A FATURAMENTO - PARC. X' + STRING_QUEBRA +
          'CONDIÇÃO PAGTO: '+ strCodCnd + ' - ' + strDesCnd + STRING_QUEBRA +
          'FORMA DE PAGTO: '+ strCodFpg + ' - ' + strDesFpg;
      End;
    end;
  End;

  Result := strHisCtr;
end;

function TFatVenda.fRetornaHistoricoComParcela(strHisCtr: String; intCont: integer): String;
  Var
    strParcelaDup: String;
begin
  If (Not fEmptyStr(strProdutosAlterados)) Then
    strProdutosAlterados := STRING_QUEBRA + strProdutosAlterados;

  strParcelaDup := ' - PARC. ' + IntToStr(intCont+1) + '/' +
    IntToStr(fRetQtdDuplicatas(arrDuplicata)) + strProdutosAlterados;

  If pos(' - PARC. X', strHisCtr) = 0 Then
    strHisCtr := strHisCtr + ' - PARC. X';

  Result := StringReplace(strHisCtr, ' - PARC. X', strParcelaDup, [rfReplaceAll, rfIgnoreCase]);
end;

