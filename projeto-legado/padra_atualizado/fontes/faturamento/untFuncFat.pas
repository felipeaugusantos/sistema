    LFnsDor.SQL.Add(', DOR_BASIPI');
    LFnsDor.SQL.Add(', DOR_VALIPI');
    LFnsDor.SQL.Add(', DOR_BASICM');
    LFnsDor.SQL.Add(', DOR_VALICM');
    LFnsDor.SQL.Add(', DOR_BASRET');
    LFnsDor.SQL.Add(', DOR_VALRET)');

    LFnsDor.SQL.Add('VALUES(:AUTINC');
    LFnsDor.SQL.Add(', :SEQGOR');
    LFnsDor.SQL.Add(', :NUMDOC');
    LFnsDor.SQL.Add(', :ESPDOC');
    LFnsDor.SQL.Add(', :CODEMP');
    LFnsDor.SQL.Add(', :CODCLI');
    LFnsDor.SQL.Add(', :CODITE');
    LFnsDor.SQL.Add(', :SEQIND');
    LFnsDor.SQL.Add(', :UNITAR');
    LFnsDor.SQL.Add(', :TOTITE');
    LFnsDor.SQL.Add(', :VLRCON');
    LFnsDor.SQL.Add(', :COMREP');
