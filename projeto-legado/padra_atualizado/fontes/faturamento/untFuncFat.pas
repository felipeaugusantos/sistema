  Result := True;
  For intCount := 0 To Length(AMatrizesDesmembramento)-1 Do
  Begin
    If (Not fGeraNovoPedidoEntregaCD(strOriF11_, VS_strCodEmp, AMatrizesDesmembramento[intCount])) Then
    Begin
      Result := False;
      Exit;
    End;
  End;
end;

procedure TFatVenda.pDefineSeClienteEmiteEnvioEstoqueExternoPeloAutcom;
  var
    LCodigoEstoqueExterno : String;
begin
  If Self.Fulfillment.EhOperacaoFulfillment Then
    Exit;

  Self.Fulfillment.CodigoDoEstoqueExterno := EmptyStr;
  Self.Fulfillment.EhEstoqueExterno       := False;
  Self.Fulfillment.SiglaHubMarketPlace    := EmptyStr;

  If Self.GetEnviandoMercadoriaEstoqueExternoPeloAutcom Then
  Begin

    LCodigoEstoqueExterno := fCampoTabela('EEE_CODEEE', 'CADEEE', ['EEE_CODCLI'], [Self.strCodCli], False);

    Self.Fulfillment.CodigoDoEstoqueExterno := LCodigoEstoqueExterno;
    Self.Fulfillment.EhEstoqueExterno       := (Not LCodigoEstoqueExterno.IsEmpty);
  End
  Else If Self.GetDevolvendoMercadoriaDoEstoqueExterno Then
  Begin

    Self.GetClienteRemessaEstoqueExternoMercadoLivre(LCodigoEstoqueExterno);

    If (Not LCodigoEstoqueExterno.IsEmpty) Then
    Begin
      Self.Fulfillment.CodigoDoEstoqueExterno := LCodigoEstoqueExterno;
      Self.Fulfillment.EhEstoqueExterno       := (Not Self.Fulfillment.CodigoDoEstoqueExterno.IsEmpty);
    End
    Else
    Begin

      LCodigoEstoqueExterno := fCampoTabela('EEE_CODEEE', 'CADEEE', ['EEE_CODCLI'], [Self.strCodCli], False);

      Self.Fulfillment.CodigoDoEstoqueExterno := LCodigoEstoqueExterno;
      Self.Fulfillment.EhEstoqueExterno       := (Not LCodigoEstoqueExterno.IsEmpty);
    End;
  End;

  If Self.Fulfillment.EhEstoqueExterno Then
    Self.Fulfillment.SiglaHubMarketPlace := (fCampoTabela('SIS_HUBMKP', 'FULL_CFGSIS', ['SIS_CODCFG', 'SIS_CODEMP', 'SIS_VALCFG'],
                                                                                       ['CFG_CODEEE', VS_strCodEmp, Self.Fulfillment.CodigoDoEstoqueExterno], False));
end;

function TFatVenda.fRetornaValorFreteRateado(
  cdsDados: TUniClientDataSet): Double;
var
  fltTotFre,
  fltQtdIteDoc: Double;
begin
  Result := 0;
  cdsDados.First;

  while not cdsDados.Eof do
  begin
    fltTotFre := fCampoTabela('DET_TOTFRE','MOVDET',['AUTOINCREM'],[cdsDados.FieldByName('ITE_INCDEV').AsString],False);
    if fltTotFre > 0 then
    begin
      fltQtdIteDoc := fCampoTabela('DET_QTDITE','MOVDET',['AUTOINCREM'],[cdsDados.FieldByName('ITE_INCDEV').AsString],False);
      Result := Result + ((fltTotFre /fltQtdIteDoc) * cdsDados.FieldByName('ITE_QTDITE').AsFloat);
    end;
    cdsDados.Next;
  end;

  Result := fFormataFloat(Result, 2);
end;


class function TFatVenda.fValidarSeClienteEstoqueExternoPermiteFaturamento(strCodigoCliente: String; Var strEstoqueExterno: String): Boolean;
begin
  Result := True;

  If Not fCfgSis('ESTEXT', VarBoolean) Then
    Exit;

  If strCodigoCliente.IsEmpty Then
    Exit;

  strEstoqueExterno := fCampoTabela('EEE_DESEEE', 'CADEEE', ['EEE_CODCLI'], [strCodigoCliente], False);

  If strEstoqueExterno.IsEmpty Then
    Exit;

  Result := fCampoTabela('EEE_PERFAT', 'CADEEE', ['EEE_CODCLI'], [strCodigoCliente], False) <> 'N';
end;

function TFatVenda.fValidaConfiguracoesIguaisEntreAsEmpresasItens(Const objDesmembrar: TDesmembrarMatrizItens; blnRaise:Boolean=False): Boolean;
  Var
    stlCfg,
    stlMsg: TStringList;
    arrMatItensPri: TMatrizFechamento;
    intLin,
    intLst: Integer;
    strCodCfg,
    strMsgErr: String;
    blnAlgumaEmpresaUsaSat: Boolean;

    procedure pIncrementaMensagem;
      Var
        intIdx: Integer;
    begin
      strMsgErr := strMsgErr + IIF(strMsgErr='','',#10#13) + 'CFG_' + strCodCfg + #10#13;
      For intIdx := 0 To stlMsg.Count-1 Do
      Begin
        strMsgErr := strMsgErr + stlMsg[intIdx] + #10#13;
        Inc(intLin);
      End;
    end;

    function fAlgumaEmpresaUsaSat: Boolean;
      Var
        arrMatItensPri: TMatrizFechamento;
    begin
      Result := False;

      If blnEmitirNovoPedidoEntregaCD Then
      Begin
        If (fCfgSis('USASAT', varString, VS_strCodEmp) = 'S') Then
          Result := True
      End;

      If (Not Result) Then
      Begin
        For arrMatItensPri In objDesmembrar.MatrizesItens Do
        Begin
          If Not fEmptyStr(arrMatItensPri[0].strEmpIte) Then
          Begin
            If (fCfgSis('USASAT', varString, arrMatItensPri[0].strEmpIte) = 'S') Then
            Begin
              Result := True;
              Break
            End;
          End;
        End;
      End;
    end;

    function fTemInconsistencia: Boolean;
      Var
       arrMatItensAux,
       arrMatItensPri: TMatrizFechamento;
       strValCfg: String;
    begin
      Result := False;

      If blnEmitirNovoPedidoEntregaCD Then
        strValCfg := fCfgSis(strCodCfg, varString, VS_strCodEmp);

      For arrMatItensPri In objDesmembrar.MatrizesItens Do
      Begin
        If Not fEmptyStr(arrMatItensPri[0].strEmpIte) Then
        Begin
          If (strValCfg = '') Then
            strValCfg := fCfgSis(strCodCfg, varString, arrMatItensPri[0].strEmpIte);

          If Pos(strCodCfg, 'USASAT_RAABNT_') > 0 Then
          Begin
            For arrMatItensAux In objDesmembrar.MatrizesItens Do
            Begin
              If Not fEmptyStr(arrMatItensAux[0].strEmpIte) Then
              Begin
                If ((fCfgSis('USASAT', varString, arrMatItensAux[0].strEmpIte) <> strValCfg) And (fCfgSis('RAABNT', varString, arrMatItensAux[0].strEmpIte) <> strValCfg)) Then
                  Result := True;
              End;
            End;
          End
          Else
          Begin
            If (strValCfg <> fCfgSis(strCodCfg, varString, arrMatItensPri[0].strEmpIte)) Then
              Result := True;
          End;
        End;

        If Result Then
          Break;
      End;
    end;

    function fComplemento(strCodEmp: String): String;
    begin
      Result := '';

      If blnAlgumaEmpresaUsaSat Then
      Begin
        If Pos(strCodCfg, 'USASAT_RAABNT_') > 0 Then
        Begin
          If (strCodCfg = 'USASAT') Then
          Begin
            If (fCfgSis('USASAT', varString, strCodEmp) = 'S') Then
              Result := ' [OK]'
            Else If (fCfgSis('RAABNT', varString, strCodEmp) = 'S') Then
              Result := ' [OK] POIS CFG_RAABNT=SIM'
            Else
              Result := ' [ATIVAR CFG_RAABNT=SIM]';
          End
          Else
          Begin
            If (fCfgSis('RAABNT', varString, strCodEmp) = 'S') Then
              Result := ' [OK]'
            Else If (fCfgSis('USASAT', varString, strCodEmp) = 'S') Then
              Result := ' [OK] POIS CFG_USASAT=SIM'
            Else
              Result := ' [ATIVAR CFG_RAABNT=SIM]';
          End;
        End;
      End;
    end;

begin
  Result := True;

  stlMsg := TStringList.Create;
  stlMsg.Duplicates := dupIgnore;
  stlMsg.Sorted := True;

  stlCfg := TStringList.Create;
  stlCfg.Duplicates := dupIgnore;
  stlCfg.Sorted := True;

  //VALIDAR AS CFGS...
  stlCfg.Add('DECUNI');
  stlCfg.Add('RAABNT');
  stlCfg.Add('USASAT');
  //...VALIDAR AS CFGS

  intLin := 0;
  Try
    blnAlgumaEmpresaUsaSat := fAlgumaEmpresaUsaSat;

    If blnEmitirNovoPedidoEntregaCD Then
    Begin
      For intLst := 0 To stlCfg.Count-1 Do
      Begin
        strCodCfg := stlCfg[intLst];
        stlMsg.Clear;

        If fTemInconsistencia Then
        Begin
          stlMsg.Add('CFG_'+strCodCfg+' - EMP. LOCAL: '+VS_strCodEmp+' VAL.: '+fCfgSis(strCodCfg, varString, VS_strCodEmp) + fComplemento(VS_strCodEmp));
          For arrMatItensPri In objDesmembrar.MatrizesItens Do
            stlMsg.Add('CFG_'+strCodCfg+' - EMP. C.D.: '+arrMatItensPri[0].strEmpIte+' VAL.: '+fCfgSis(strCodCfg, varString, arrMatItensPri[0].strEmpIte) + fComplemento(arrMatItensPri[0].strEmpIte));

          pIncrementaMensagem;
        End;
      End;

      If (intLin > 0) Then
      Begin
        strMsgErr := 'Você irá emitir um pedido para faturamento pelo C.D. ' +
                     'Porém, há configurações que influenciam no valor unitário definidas de maneira diferente entre as empresas, o que pode ' +
                     'gerar divergências no valor contábil e contas a receber dos documentos faturados. É necessário que todas ' +
                     'as empresas envolvidas estejam com o mesmo valor das configurações a seguir:' + #10#13#10#13 + strMsgErr +
                     IIF(blnAlgumaEmpresaUsaSat And ((Pos('CFG_USASAT', strMsgErr) > 0) Or (Pos('CFG_RAABNT', strMsgErr) > 0)), #10#13 +
                         'Nota.: CFG_USASAT e CFG_RAABNT tem o mesmo efeito no que se refere a arrendodamento de valor unitário. '+
                         'Por isso nas empresas que NÃO usam SAT, a CFG_RAABNT pode ser ativada para que mantenha o mesmo padrão de ' +
                         'arredondamento. Feito isso, essa mensagem não será mais exibida e o faturamento poderá ser concluído!','');
      End;
    End
    Else If (Length(objDesmembrar.MatrizesItens) > 1) Then
    Begin
      For intLst := 0 To stlCfg.Count-1 Do
      Begin
        strCodCfg := stlCfg[intLst];
        stlMsg.Clear;

        If fTemInconsistencia Then
        Begin
          For arrMatItensPri In objDesmembrar.MatrizesItens Do
            stlMsg.Add('CFG_'+strCodCfg+' - EMP.: '+arrMatItensPri[0].strEmpIte+' VAL.: '+fCfgSis(strCodCfg, varString, arrMatItensPri[0].strEmpIte) + fComplemento(arrMatItensPri[0].strEmpIte));

          pIncrementaMensagem;
        End;
      End;

      If (intLin > 0) Then
      Begin
        strMsgErr := 'Você irá desmembrar um documento entre várias empresas. ' +
                     'Porém, há configurações que influenciam no valor unitário definidas de maneira diferente entre elas, o que pode ' +
                     'gerar divergências no valor contábil e contas a receber dos documentos faturados. É necessário que todas ' +
                     'as empresas envolvidas estejam com o mesmo valor das configurações a seguir:' + #10#13#10#13 + strMsgErr +
                     IIF(blnAlgumaEmpresaUsaSat And ((Pos('USASAT', strMsgErr) > 0) Or (Pos('RAABNT', strMsgErr) > 0)), #10#13 +
                         'Nota.: CFG_USASAT e CFG_RAABNT tem o mesmo efeito no que se refere a arrendodamento de valor unitário. '+
                         'Por isso nas empresas que NÃO usam SAT, a CFG_RAABNT pode ser ativada para que mantenha o mesmo padrão de ' +
                         'arredondamento. Feito isso, essa mensagem não será mais exibida e o faturamento poderá ser concluído!', '');
      End;
    End;
  Finally
    FreeAndNil(stlMsg);
    FreeAndNil(stlCfg);

    If (intLin > 0) Then
    Begin
      Result := False;

      If blnRaise Then
        Raise Exception.Create(strMsgErr)
      Else
        fMensagem('Atenção!', strMsgErr, ['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 400, 0, intLin);
    End;
  End;
end;

procedure TFatVenda.pDefineSeGeraNovoPedidoEntregaCD(strEmpCfg: String);
begin
  blnEmitirNovoPedidoEntregaCD := fGeraNovoPedidoEntregaCD(strOriF11, strEmpCfg);

  If blnEmitirNovoPedidoEntregaCD Then
  Begin
    Self.blnEnt_CD := True;
    Self.strEspDoc := 'PD';
    Self.blnPedBlo := False;//Novo pedido ja deve gravar liberado
    Self.strEmp_CD := arrMatItens[0].strEmpIte;
    Self.blnResCaiAdt := True;

    If not fCfgSis('TPFPED', varBoolean) then
    Begin
      If (Self.strTipPed = 'C') And Not fCfgSis('TPPDCX', VarBoolean, strEmpCfg) Then
        Self.strTipPed := 'A';

      If fLimparTipoDePedidoPoisSeraDefinidoNaExpedicao(strEmpCfg) Then
        Self.strTipPed := '';
    End
    Else
    Begin
      Self.strTipPed := fBuscaTipPed(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri);
    End;
  End;
end;

function TFatVenda.fEhGravacaoSimplesVenda: Boolean;
begin
  Result := False;

  //Se nao for venda normal nem confirmacao de pedido deve apenas gravar simples
  If (Pos(strOpcDoc, 'VN_CP_') <= 0) Then
    Result := True;

  //Se for emissao de pedido ou orcamento desde que nao venha do f11 deve apenas gravar simples
  If (Pos(strEspDoc, 'OR_PD_') > 0) And (strOriF11 <> 'S') Then
    Result := True;

  If (fDesmembrarPorCFG_ITEDOC) And (Length(arrMatItens) > fCfgSis('ITEDOC', varInteger)) Then
    Exit(False);

    //Se nao ha itens para desmembramento, nem seja itens de outra loja e nem gravar NS outra empresa deve apenas gravar simples
  If Not (
          fHaveraDesmembramentoVenda(arrMatItens) Or
          fVendaMultiloja Or
          fEmitirNotaServicoOutraEmpresaF11 Or
          blnDesmembrarMeiaNotaComNotaNormal
         ) Then
    Result := True;

  If (fDesmembrarPorCFG_ITEDOC) And (fHaveraDesmembramentoVenda(arrMatItens)) Then
    Result := False;

  If (Result) And (fPermiteDesmembramentoLimiteExcedidoLivro) And (TDesmembrarMatrizItens.fExcedeuLimiteClassificacoesLivroFiscal(arrMatItens)) Then
    Result := False;

  If (((strOpcDoc = 'FC') or (strOpcDoc = 'CR')) And (fHaveraDesmembramentoProVendedor(strOpcDoc))) Then
    Result := False;
end;

function TFatVenda.fPodeInformarLoteADefinir(const strEspecie: String): Boolean;

  function fDocumentoTemItensComLoteADefinir: Boolean;
    Var
      intIdx: Integer;
  begin
    Result := False;

    For intIdx := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
    Begin
      If (Self.arrMatItens[intIdx].strNumLot = 'A DEFINIR') Then
      Begin
        If (TCadLot.ProdutoTemLote(Self.arrMatItens[intIdx].strCodIte)) Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  End;

begin
  Result := True;

  If (fCfgSis('DLSWMS', varString) = 'S') Then
  Begin
    If (Pos(strEspecie, 'NF_IF_FF_TE_') > 0) And
       (Not fUsaRotinaWMS)                   And
       (fDocumentoTemItensComLoteADefinir) And
       (Not fObrigatorioVenderEntregaFuturaComLoteADefinir) Then
    Begin
      Result := False;
    End;
  End;
end;

function TFatVenda.fObrigatorioVenderEntregaFuturaComLoteADefinir : Boolean;
begin
  Result := False;
  If (fCfgSis('ENTDEF', varString) <> 'S') Then
    Exit;
  If (Self.strEntFut <> 'S') Then
    Exit;
  Result := True;
end;

function TFatVenda.fGravaArquivosDesmembrandoVenda(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    objAcertaVencimentos: TAcertaVencimentosMeiaNotaComNotaNormal;
begin
  If fGerarContasReceberInteligenteMeiaNotaComNotaNormal Then
  Begin
    objAcertaVencimentos := TAcertaVencimentosMeiaNotaComNotaNormal.Create;

    Result := fDesmembrarVenda(pgbStatus, objAcertaVencimentos.fSetarStatus(stgSimulandoGravacao )) And
              fDesmembrarVenda(pgbStatus, objAcertaVencimentos.fSetarStatus(stgRealizandoGravacao));

    FreeAndNil(objAcertaVencimentos);
  End
  Else
    Result := fDesmembrarVenda(pgbStatus);
end;

