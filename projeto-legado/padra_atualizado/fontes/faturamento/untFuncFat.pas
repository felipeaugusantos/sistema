      End;

      dadosPromocao := fDadosPromocao(cdsItensTmp.FieldByName('ITE_CODITE').AsString,
                                      cdsItensTmp.FieldByName('ITE_EMPITE').AsString,
                                      '',
                                      '',
                                      '',
                                      '',
                                      '',
                                      '');

      objLinha.pAddColuna('Val.Promoc.'       , IIF(dadosPromocao.dtaDtaFin<>0, FormatDateTime('dd/mm/yyyy', dadosPromocao.dtaDtaFin), ''), 10  , alCentro  , teAutcom);

      objTabela.lstLinhas.Add(objLinha);

      If (cdsItensTmp.FindField('ITE_PRETAB') <> Nil) And (fItemCarregadoJuntoPDouOR) Then
      Begin
        If (cdsItensTmp.FieldByName('ITE_PROMOC').AsString <> 'S') Then
        Begin
          If (cdsItensTmp.FieldByName('ITE_UNIORI').AsFloat <> cdsItensTmp.FieldByName('ITE_PRETAB').AsFloat) Then
          Begin
            objLinhaPreAlt  := TLinhaMsgLibera.Create;
            objLinhaPreAlt.enuTipoLinha := tlValor;

            objLinhaPreAlt.pAddColuna('Cod.'        , FieldByName('ITE_CODITE').AsString                                       , fTamCodIte, alEsquerda , teAutcom);
            objLinhaPreAlt.pAddColuna('Vl.Orig.Doc.', FloatToStrf(FieldByName('ITE_UNIORI').AsFloat, ffFixed, 10, VS_intDecUni), 12 , alDireita  , teAmbos);
            objLinhaPreAlt.pAddColuna('Vl.Tab.Atual', FloatToStrf(FieldByName('ITE_PRETAB').AsFloat, ffFixed, 10, VS_intDecUni), 12 , alDireita  , teAmbos);
            objTabelaPreAlt.lstLinhas.Add(objLinhaPreAlt);
          End;
        End;
      End;

      Next;
    End;

    If (blnTemEmbalagemFechada) Then
      fltDescTotEmb := ((1 - (fltTotUnitar / fltTotEmb)) * 100);

    If (fltTotUniOri + fltUniSerTotOri) = 0 Then
      fltPerDesIte := 0.00
    Else
    Begin
      If fPermiteDescontoEspecialNaConfirmacaoDeDocumentos Then
        fltPerDesIte := (1 - ((recTotMarLuc.fltTotUnitar + fltUniSerTot) / (fltTotUniOri + fltUniSerTotOri))) * 100
      Else
        fltPerDesIte := (1 - ((recTotMarLuc.fltTotUnitar + fltUniSerTot) / (recTotMarLuc.fltTotPreOri + fltUniSerTotOri))) * 100
    End;

    objLinha  := TLinhaMsgLibera.Create;
    objLinha.enuTipoLinha := tlTotal;
    objLinha.intAgrupador := intAgrupador;
    objLinha.pAddColuna(''          , 'TOTAIS'                                                            , 27 , alDireita  , teAutcom);

    If fPermiteDescontoEspecialNaConfirmacaoDeDocumentos Then
      objLinha.pAddColuna('Vl.Origi'  , FloatToStrf(recTotMarLuc.fltTotUniOri + fltUniSerTotOri, ffFixed, 10, VS_intDecUni)  , 12 , alDireita  , teAmbos)
    Else
      objLinha.pAddColuna('Vl.Origi'  , FloatToStrf(recTotMarLuc.fltTotPreOri + fltUniSerTotOri, ffFixed, 10, VS_intDecUni)  , 12 , alDireita  , teAmbos);

    objLinha.pAddColuna('(%)Desc'   , FloatToStrf(fltPerDesIte              , ffFixed, 10, VS_intDecUni)    ,  7 , alDireita  , teAmbos);

    If (blnTemEmbalagemFechada) Then
    Begin
      objLinha.pAddColuna('Vl.Embal.', FloatToStrf(fltTotEmb, ffFixed, 10, VS_intDecUni),     12 , alDireita, teAmbos);
      objLinha.pAddColuna('(%)D.Emb' , FloatToStrf(fltDescTotEmb, ffFixed, 10, VS_intDecUni),     8 , alDireita, teAmbos);
    End;

    objLinha.pAddColuna('Vl.Unit'   , FloatToStrf(recTotMarLuc.fltTotUnitar + fltUniSerTot, ffFixed, 10, VS_intDecUni)  , 12 , alDireita  , teAmbos);

    If (TMargemMinima.PorPrecoCustoPreCus) Then
    Begin
      objLinha.pAddColuna('Pr.Custo'  , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotCusIte       , ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) ,  fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      objLinha.pAddColuna('%M.Prop'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarPro_CUSITE, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            ,  fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      objLinha.pAddColuna('%M.Prat'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarPra_CUSITE, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            ,  fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
    End
    Else If (TMargemMinima.PorCustoRealPreCus) Then
    Begin
      objLinha.pAddColuna('Pr.Custo'  , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotCusto  , ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      objLinha.pAddColuna('%M.Prop'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarItem, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      objLinha.pAddColuna('%M.Prat'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarPrat, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
    End
    Else If (TMargemMinima.PorPrecoCustoPreMed) Then
    Begin
      objLinha.pAddColuna('Pr.Medio'  , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMedio  , ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarBru_PREMED, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
    End
    Else If (TMargemMinima.PorCustoRealPreMed) Then
    Begin
      objLinha.pAddColuna('Pr.Medio'  , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMedLiq  , ffFixed, 10, VS_intDecUni), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb) , fTamanhoMaisTamanhoTagOculta(12, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarLiq_PREMED, ffFixed, 10, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb)            , fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
    End;

    If strExMaF4[5] = 'S' Then
    begin
      objLinha.pAddColuna('Pr.Ult+Imp', FloatToStrf(recTotMarLuc.fltTotCusImp   , ffFixed, 10, VS_intDecUni)                , 12 , alDireita  , teAmbos);
      objLinha.pAddColuna('%M.Ult+I'  , FloatToStrf(recTotMarLuc.fltTotMarImpUlt, ffFixed, 8, 2)                            ,  8 , alDireita  , teAmbos);
    end
    else
    begin
      If (TMargemMinima.PorPrecoCustoPreCus) Then
      Begin
        objLinha.pAddColuna('Pr.Medio'  , FloatToStrf(recTotMarLuc.fltTotMedio, ffFixed, 10, VS_intDecUni) , 12 , alDireita  , teAmbos);
        objLinha.pAddColuna('%M.PMed'   , fMsgLiberaToMsgOculta(FloatToStrf(recTotMarLuc.fltTotMarBru_PREMED, ffFixed, 8, 2), blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), fTamanhoMaisTamanhoTagOculta(10, blnOcultaMsgParaQuemRecebe, omlMsgParaQuemReceb), alDireita, teAmbos);
      End
