Procedure pEstornaAdiantamentoAutomatico(strNumOri, strEspOri, strEmpOri: String);
var
  qryAux : TUniQuery;
  strNumDup,
  strParcel,
  strEspDoc,
  strCodCli,
  strCodEmp,
  strAutInc: String;
  frmEstornoReceber : TfrmEstornoReceber;
begin
  qryAux := fCriaQuery;

  Try
    With qryAux Do
    Begin
      SQL.Add('SELECT F.AUTOINCREM, CTR_NUMDUP, CTR_PARCEL, CTR_ESPDOC, ');
      SQL.Add('CTR_CODCLI, CTR_CODEMP FROM FATGOR F ');
      SQL.Add('INNER JOIN FPNCRE A ON A.FPN_SEQFGO = F.AUTOINCREM ');
      SQL.Add('INNER JOIN CADREC C ON C.AUTOINCREM = A.FPN_SEQCTR ');
      SQL.Add('WHERE F.FGO_NUMDOC = :NUMDOC AND ');
      SQL.Add('      F.FGO_ESPDOC = :ESPDOC AND ');
      SQL.Add('      F.FGO_CODEMP = :CODEMP ');
      ParamByName('NUMDOC').AsString := strNumOri;
      ParamByName('ESPDOC').AsString := strEspOri;
      ParamByName('CODEMP').AsString := strEmpOri;
      Open;
      strNumDup := FieldByName('CTR_NUMDUP').AsString;
      strParcel := FieldByName('CTR_PARCEL').AsString;
      strEspDoc := FieldByName('CTR_ESPDOC').AsString;
      strCodCli := FieldByName('CTR_CODCLI').AsString;
      strCodEmp := FieldByName('CTR_CODEMP').AsString;
      strAutInc := FieldByName('AUTOINCREM').AsString;
      Close;

      SQL.Clear;
      SQL.Add('DELETE FROM FPGNEG WHERE FPN_CODFPG = "013" AND FPN_SEQFGO = :AUTINC');
      ParamByName('AUTINC').AsString := strAutInc;
      ExecSQL;

      SQL.Clear;
      SQL.Add('DELETE FROM FPNCRE WHERE FPN_SEQFGO = :AUTINC');
      ParamByName('AUTINC').AsString := strAutInc;
      ExecSQL;
    End;

  Finally
    FreeAndNil(qryAux);
  End;

  If fEmptyStr(strNumDup) Then
    Exit;

  Try
    pCriarFormularios(TfrmEstornoReceber, frmEstornoReceber);
    frmEstornoReceber.blnResCai := False;
    frmEstornoReceber.blnEstornoAutomatico := True;
    frmEstornoReceber.strEstRec := '(Estorno de Adiantamento Automático)';
    frmEstornoReceber.edtNumDup.Text := strNumDup;
    frmEstornoReceber.edtParcel.Text := strParcel;
    frmEstornoReceber.edtEspDoc.Text := strEspDoc;
    frmEstornoReceber.edtCodCli.Text := strCodCli;
    frmEstornoReceber.edtCodEmp.Text := strCodEmp;

    frmEstornoReceber.pFormShow;
    frmEstornoReceber.pCriaTemporaria;

    If Not frmEstornoReceber.cdsDados.IsEmpty Then
    Begin
      frmEstornoReceber.pSelecionaDuplicata;
      frmEstornoReceber.pConfirmaEstorno;
    End;

    pFreeAndNil(frmEstornoReceber);

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[untFuncFat.pEstornaAdiantamentoAutomatico]');
  End;

end;

