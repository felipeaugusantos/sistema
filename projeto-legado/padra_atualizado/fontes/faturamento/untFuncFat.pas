            (fCfgSis('LFP012') = 'L') And
            (Self.fltValAdt = 0);
end;

procedure TFatVenda.pDefineVariaveisSeGravaCaixa;
begin
  blnCfgGravaResCai := False;
  blnValGravaResCai := False;
  blnNaoUsaResumoCaixaMasGravaChequeOuCartao := False;

  {***********************************************}
  {* NÃO GRAVA CADRCXX CASO NÃO BAIXE DUPLICATAS *}
  {* A VISTA                                     *}
  {********************************************JB*}
  If (VS_blnUsaFpg)                                                                             And
     (Pos(strEspDoc, 'OR_PR_' + IIF(Not blnDesmembramentoDePedidosComAdiantamento And
                                    Not blnEntregaImediataEmNovoPedido And
                                    Not blnEmitirNovoPedidoEntregaCD And
                                    Not blnRetiraOutraLojaEmNovoPedido And
                                    Not blnRetiraExpedicaoEmNovoPedido And
                                    Not blnRetiraMesmaLojaEmNovoPedido And
                                    Not blnAbastecTransfReqEmNovoPedido And
                                    Not blnRealizandoAdiantamentoPedidoPeloF11 And
                                    Not blnRealizandoAdiantamentoPedidoPeloVN, 'PD_', '')) <= 0) And
     (Not (blnExpedi And (Pos(strEspDoc, 'BR_') > 0)))                                          And
     (Pos(strOpcDoc, 'TE_NC_BR_OU_OV_OF_EF_UC_CS_CR_GF_ER_') <= 0)                              And
     fBaixaDuplicataAVista(strEmpLog)                                                           And
     (Pos(strCodFpg,'003_014_015_' + IIF(fVaiBaixarParcelaAVista, '', '008_')) <= 0)            And
     (IIF(strCodFpg = '012', fVaiBaixarOrdemPagamento, True))                                   And
     (IIF(Pos(strEspDoc,  'TR_DV_PR_DD_') > 0, fCfgSis('TROQUI', varBoolean, IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog)), True)) And
     (fltTotCadRec <> 0)                                                                        And
     (Not blnNotEsp)                                                                            And
     (Not blnCupEsp)                                                                            And
     ( Not ( ((Pos(strEspDoc, 'NF_EL_') > 0)) And ( Pos(strClaFis, fCfgSis('CLADEV')) > 0 ) ) ) Then
  Begin
    If (fCfgSis('USARCX', varBoolean, IIF(blnGravandoVariosDocumentos, IIF(fEmptyStr(strEmpLog), VS_strCodEmp, strEmpLog),''))) Then
    Begin
      If ((strCodFpg = '009') And (Not fConPagComEntrada(strConPag))) Or
         ((blnCliFil) And (Not blnGravaCtrTe)) Then
      Begin
        blnCfgGravaResCai := False;
        blnValGravaResCai := False;
      End
      Else If Self.fEhExpedicaoEDeveGravarCaixaOrdemPagamento Then
      Begin
        blnCfgGravaResCai := True;
        blnValGravaResCai := True;
      End
      Else
      Begin
        blnCfgGravaResCai := True;

        If ((fltValCqP + fltValCqV + fltValDin + fltValCar + fltValOrd + fltFatura + fltValFin + Abs(fltValCre)) <> 0) And
           (
             (Pos(strClaFis, VS_strClaVen) > 0) Or
             ( (Self.fConfirmacaoCupomGerandoNovoCadRec) And (Not blnBaiEntFut) And (fGerarCTR_CI) )
           ) Then
        Begin
          blnValGravaResCai := True;
        End;
      End;
    End
    Else
    Begin
      blnNaoUsaResumoCaixaMasGravaChequeOuCartao := ((strCodFpg = '002') And fCfgSis('CHQRCX', varBoolean)) //CHEQUE A PRAZO
                                                 Or ((strCodFpg = '006') And (fCfgSis('CHQRCX', varBoolean) And fCfgSis('CHQVIS', varBoolean))) //CHEQUE À VISTA
                                                 Or ((Pos(strCodFpg, '007_016_') > 0) And fCfgSis('DIGCAR', varBoolean)); //CARTÃO OU FINANCIAMENTO COM CARTÃO
    End;
  End;

  {***********************************}
  {* SE FOR POKET E CONFIGURADO PARA *}
  {* NÃO GRAVAR SETA VARIAVEIS       *}
  {********************************AF*}
  If ( (Not fEmptyStr(strNumPok)) Or (Not fEmptyStr(strPedSit)) ) And
     (Not fCfgSis('RCXPOK',varBoolean))                           Then
  Begin
    blnCfgGravaResCai := False;
    blnValGravaResCai := False;
    blnNaoUsaResumoCaixaMasGravaChequeOuCartao := False;
  End;

  If (Self.strOriF11 = 'S') And (Self.fltValAdt > 0) And
     fPedidoPossuiCorte(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri, Self.strCodCli) Then
  Begin
    blnCfgGravaResCai := False;
    blnValGravaResCai := False;
  End;

  If blnExecutandoFaturadorAutomatico And blnSmartPOS Then
  Begin
    blnCfgGravaResCai := False;
    blnValGravaResCai := False;
  End;

end;

function TFatVenda.fVerificaValorMinimoParcela: Boolean;
  Var
    intContador: Integer;

    recTotMarLuc : TRecTotaisMargemLucro;

    fltVrmPnf : Double;
    objLiberacao : TLiberacao;
    cdsData   : OleVariant;
    blnMarcar : Boolean;
    strMsgMrg : String;
begin
  Result := True;
  fltVrmPnf := fCfgSis('VRMPNF', varDouble);
  If (Pos(strEspDoc, 'NF_EL_') > 0) And (fltVrmPnf > 0) And (fStatusCndPag(strConPag) = A_PRAZO) Then
  Begin
    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.strDirAce := 'VRMPNF';
      objLiberacao.strSenLib := fCfgSis('SVRMPN');
      objLiberacao.strMsgSen := 'Parcelas com valor menor que o mínimo permitido.';
      objLiberacao.blnMosMen := True;
      objLiberacao.strCodOpe := strCodVen;
      objLiberacao.strCodDig := strCodDig;
      objLiberacao.strCliente := strCodCli + '-' + strCliNom;
      objLiberacao.strCpfCnpj := strCliCgc;
      objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

      For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
      Begin
        If (Not fEmptyStr(arrDuplicata[intContador].strSequen)) And
           (arrDuplicata[intContador].curValor < fltVrmPnf)     Then
        Begin
          cdsData := Self.fCalculaMargemLucro(True);

          pCalculaTotaisMargemLucro(cdsData,
                                    recTotMarLuc);

          objLiberacao.objMsgLibera.Clear;

          objLiberacao.objMsgLibera.pAddTexto('Há parcelas com valor menor que o mínimo permitido (' + FloatToStrF(fltVrmPnf, ffNumber, 12, 2) + ')');
          objLiberacao.objMsgLibera.pAddQuebra;
          objLiberacao.objMsgLibera.pAddSeparador(52);
          objLiberacao.objMsgLibera.pAddTextoCaption('Valor Total do Faturamento'             , 'R$ ' + FloatToStrF(fltTotGer, ffNumber, 12, 2)                                      , 38, alDireita, teAmbos, '', 12);
          objLiberacao.objMsgLibera.pAddSeparador(52);
          objLiberacao.objMsgLibera.pAddTextoCaption('Valor Mínimo da Parcela p/ Faturamento' , 'R$ ' + FloatToStrF(fltVrmPnf, ffNumber, 12, 2)                                      , 38, alDireita, teAmbos, '', 12);
          objLiberacao.objMsgLibera.pAddTextoCaption('Valor da Parcela a ser Faturado'        , 'R$ ' + FloatToStrF(arrDuplicata[intContador].curValor, ffNumber, 12, 2)             , 38, alDireita, teAmbos, '', 12);
          objLiberacao.objMsgLibera.pAddTextoCaption('Diferença para a Parcela Mínima'        , 'R$ ' + FloatToStrF(fltVrmPnf - arrDuplicata[intContador].curValor, ffNumber, 12, 2) , 38, alDireita, teAmbos, '', 12);
          objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade de Parcelas'                 , IntToStr(fRetQtdDuplicatas(arrDuplicata))                                            , 38, alDireita, teAmbos, '', 12);
          objLiberacao.objMsgLibera.pAddSeparador(52);

          blnMarcar := (fCfgSis('PFTRMN', varInteger) = 2);

          strMsgMrg := fMsgLiberaToMsgOculta(fPadL(FloatToStrF(TMargemMinima.TotalParaTravaDePreco(recTotMarLuc, False), ffNumber, 12, 2) + '%', 12), blnMarcar);

          objLiberacao.objMsgLibera.pAddTextoCaption('Margem Praticada no Documento.........: ', strMsgMrg, 38, alDireita, teAmbos, '', fTamanhoMaisTamanhoTagOculta(12, blnMarcar));

          objLiberacao.objMsgLibera.pAddSeparador(52);
          objLiberacao.objMsgLibera.pAddQuebra;

          Result := fFatMensagemLiberacao(objLiberacao);

          If Not Result Then
            Exit
          Else
            Break;

        End;
      End;

    finally
      FreeAndNil(objLiberacao);
    end;
  End;
end;

