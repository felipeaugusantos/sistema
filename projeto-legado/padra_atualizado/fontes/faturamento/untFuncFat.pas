function TGeraArquivoAnexoEmailAutomatico.fGeraArquivoAnexo(blnGerandoParaDisparoDeGatilho: Boolean) : TList<TRecArquivosGatilhos>;
begin
  Result := TList<TRecArquivosGatilhos>.Create;
  FGerandoParaDisparoDeGatilho := blnGerandoParaDisparoDeGatilho;

  if FOpcDoc = 'CF' then
    Result.AddRange(Self.fGeraArquivoAnexoEmailConfirmacaoDocumento)

  else if FOpcDoc = 'RC' then
    Result.AddRange(Self.fGeraAnexoRC)

  else If Pos(FEspDoc, 'PD_OR_') > 0 Then
    Result.AddRange(Self.fGeraArquivoAnexoEmailFatGor)

  else If (Pos(FEspDoc, 'NF_IF_NS_') > 0) And (not fEmptyStr(FAcesso)) And (not fEmptyStr(FSerie_)) Then
  Begin
    if (FOpcDoc = 'EF') and (FEspDoc = 'NF') then
      Result.AddRange(Self.fGeraAnexoXML_NFe)

    else
    begin
      Result.AddRange(Self.fGeraAnexoDanfeNfe_Nfce_Nfse);

      If (FOpcDoc = 'BN') and (FEspDoc = 'NF') Then
      Begin
        Result.AddRange(Self.fGeraAnexoXML_NFe);
        Result.AddRange(Self.fGeraAnexoBoleto);
      End

      Else If (FOpcDoc = 'BN') and (FEspDoc = 'NS') Then
      Begin
        Result.AddRange(Self.fGeraAnexoXML_NFe);
        Result.AddRange(Self.fGeraAnexoBoleto);
      End

      Else If (FEspDoc = 'NS') And fCfgSis('ENSXML', varBoolean) Then
        Result.AddRange(Self.fGeraAnexoXML_NFe)

      Else If (FOpcDoc = 'ET') And (FEspDoc = 'NF') Then
        Result.AddRange(Self.fGeraAnexoXML_NFe);
    end;

  End

  else If FEspDoc = 'FF' then
    Result.AddRange(Self.fGeraAnexoOutrosDocs)

  else if FOpcDoc = 'LP' then
  begin
    if FEspDoc = 'AGR' then
      Result.Add(TRecArquivosGatilhos.Create('DUPLICATAS AGR_'+ExtractFileName(FPathArquivos).Replace(ExtractFileExt(ExtractFileName(FPathArquivos)), EmptyStr),
                                             FPathArquivos,
                                             EmptyStr));
  end ;
end;

function TGeraArquivoAnexoEmailAutomatico.fGeraArquivoAnexoEmailConfirmacaoDocumento: TArray<TRecArquivosGatilhos>;
begin
  SetLength(Result, 1);
  Result[0] := TRecArquivosGatilhos.Create('DOCS. CONFIRMA._'+FNumDoc+'-'+FEspDoc,
                                           untFatImpressao.fGeraArquivoAnexoEmailConfirmacaoDocumento(FNumDoc, FEspDoc, IIF(fEmptyStr(FCodEmp), VS_strCodEmp, FCodEmp)),
                                           EmptyStr);
end;

function TGeraArquivoAnexoEmailAutomatico.fGeraArquivoAnexoEmailFatGor: TArray<TRecArquivosGatilhos>;
var
  strOrdem  : String;
  blnComMar,
  blnLocFis : Boolean;
  strModo   : String;
  strNomEmp : String;
  blnCabCD  : Boolean;
begin
  pCriarFormularios(TfrmFatGorEmail, frmFatGorEmail);

  Try

    strOrdem  := IIF(FEspDoc = 'OR', fCfgSis('ORDORC'), fCfgSis('ORDPDV'));
