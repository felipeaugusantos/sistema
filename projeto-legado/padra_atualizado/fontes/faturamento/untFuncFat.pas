procedure TFatVenda.pDetalharDescontosDeImpostosDeOrgaoPublico;
var
  intContador: Integer;
  strDetImp: String;
begin
  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (arrMatItens[intContador].fltOrgPubPis > 0) Or (arrMatItens[intContador].fltOrgPubCof > 0) Or (arrMatItens[intContador].fltOrgPubIcm > 0) Then
    Begin
      strDetImp := 'Desconto: ';

      If arrMatItens[intContador].fltOrgPubPis > 0 Then
        strDetImp := strDetImp + 'PIS='    + FormatFloat('0.00', arrMatItens[intContador].fltOrgPubPis) + '('+ FormatFloat('0.000', arrMatItens[intContador].fltOrgPubAlqPis) +'%) ';

      If arrMatItens[intContador].fltOrgPubCof > 0 Then
        strDetImp := strDetImp + 'COFINS=' + FormatFloat('0.00', arrMatItens[intContador].fltOrgPubCof) + '('+ FormatFloat('0.000', arrMatItens[intContador].fltOrgPubAlqCof) +'%) ';

      If arrMatItens[intContador].fltOrgPubIcm > 0 Then
        strDetImp := strDetImp + 'ICMS='   + FormatFloat('0.00', arrMatItens[intContador].fltOrgPubIcm) + '('+ FormatFloat('0.000', arrMatItens[intContador].fltOrgPubAlqIcm) +'%) ';

      strDetImp := strDetImp + 'TOTAL='  + FormatFloat('0.00', IIF(arrMatItens[intContador].fltOrgPubPis > 0, arrMatItens[intContador].fltOrgPubPis, 0) +
                                                               IIF(arrMatItens[intContador].fltOrgPubCof > 0, arrMatItens[intContador].fltOrgPubCof, 0) +
                                                               IIF(arrMatItens[intContador].fltOrgPubIcm > 0, arrMatItens[intContador].fltOrgPubIcm, 0));

      arrMatItens[intContador].strDesNes := strDetImp;
    End;
  End;
end;

procedure TFatVenda.pProcessarOcorrenciaLimiteCredito;
var
  strDescriAux: String;
  objOcoCrm : TAtuOcoCrm;
  qrySelect : TUniQuery;
  strSQL: String;
  blnOcorrenciaLib: Boolean;
Begin
  If fEmptyStr(FstrCodOcoLimCr) Then
    Exit;

  If (VS_strHabilitarCRM) And
     (Not fEmptyStr(fCfgSis('TOCLCR', varString))) And
     (Not fCfgSis('LIBPED', varBoolean)) Then
  Begin
    objOcoCrm := TAtuOcoCrm.Create(Nil);
    objOcoCrm.strNomFrm := '[TFatVenda.pProcessarOcorrenciaLimiteCredito]';
    qrySelect := fCriaQuery;
    Try

      strSQL := '';
      strSQL := strSQL + ' SELECT TEMP.*,';
      strSQL := strSQL + '        CONCAT(CODCLI, "-", CLI_NOMCLI) AS NOMCLI,';
      strSQL := strSQL + '        CONCAT(OPECAD, "-", CADOPEC.OPE_NOMOPE) NOMOPECAD,';
      strSQL := strSQL + '        CONCAT(CODVEN, "-", CADOPEV.OPE_NOMOPE) AS NOMVEN,';
      strSQL := strSQL + '        CONCAT(OPELIB, "-", CADOPEL.OPE_NOMOPE) AS NOMOPELIB,';
      strSQL := strSQL + '        CONCAT(NUMDOC, "-", ESPDOC) AS DOCUME,';
      strSQL := strSQL + '        CONCAT(CODEMP, "-", EMP_NOMEMP) AS EMPRES,';
      strSQL := strSQL + '        ESPDOC,';
      strSQL := strSQL + '        NUMDOC,';
      strSQL := strSQL + '        CODEMP,';
      strSQL := strSQL + '        NROLIB,';
      strSQL := strSQL + '        DIRACE';
      strSQL := strSQL + ' FROM (';
      strSQL := strSQL + '   SELECT "Liberado" AS STATUS,';
      strSQL := strSQL + '          LOG_DTACAD AS DTACAD,';
      strSQL := strSQL + '          LOG_HRACAD AS HRACAD,';
      strSQL := strSQL + '          COALESCE(COALESCE(FG.FGO_CODDIG, MG.GER_CODDIG), NG.GER_CODDIG) AS OPECAD,';
      strSQL := strSQL + '          LOG_NUMDOC AS NUMDOC,';
      strSQL := strSQL + '          LOG_ESPDOC AS ESPDOC,';
      strSQL := strSQL + '          LOG_CODEMP AS CODEMP,';
      strSQL := strSQL + '          COALESCE(COALESCE(FG.FGO_CODCLI, MG.GER_CODCLI), NG.GER_CODCLI) AS CODCLI,';
      strSQL := strSQL + '          LOG_TITULO AS TITULO,';
      strSQL := strSQL + '          LOG_CODVEN AS CODVEN,';
      strSQL := strSQL + '          LOG_CODOPE AS OPELIB,';
      strSQL := strSQL + '          LOG_OBSERV AS OBSERV,';
      strSQL := strSQL + '          LOG_DIRACE AS DIRACE,';
      strSQL := strSQL + '          LOG_NROLIB as NROLIB';
      strSQL := strSQL + '                              ';
      strSQL := strSQL + '   FROM LOGLIB';
      strSQL := strSQL + '   LEFT JOIN FATGOR FG ON FG.FGO_NUMDOC = LOG_NUMDOC AND FG.FGO_ESPDOC = LOG_ESPDOC AND FG.FGO_CODEMP = LOG_CODEMP';
      strSQL := strSQL + '   LEFT JOIN MOVGER MG ON MG.GER_NUMDOC = LOG_NUMDOC AND MG.GER_ESPDOC = LOG_ESPDOC AND MG.GER_CODEMP = LOG_CODEMP';
      strSQL := strSQL + '   LEFT JOIN NOTGER NG ON NG.GER_NUMDOC = LOG_NUMDOC AND NG.GER_ESPDOC = LOG_ESPDOC AND NG.GER_CODEMP = LOG_CODEMP';
      strSQL := strSQL + '   WHERE LOG_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '         LOG_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '         LOG_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '         LOG_DIRACE LIKE :DIRACE  ';
      strSQL := strSQL + '   ';
      strSQL := strSQL + '   UNION ALL';
      strSQL := strSQL + '   ';
      strSQL := strSQL + '   SELECT "Negado" AS STATUS,';
      strSQL := strSQL + '          NEG_DTAENV,';
      strSQL := strSQL + '          NEG_HORENV,';
      strSQL := strSQL + '          NEG_OPEENV,';
      strSQL := strSQL + '          NULL,';
      strSQL := strSQL + '          NULL,';
      strSQL := strSQL + '          NEG_CODEMP,';
      strSQL := strSQL + '          NEG_CODCLI,';
      strSQL := strSQL + '          NEG_TITULO as TITULO,';
      strSQL := strSQL + '          NULL,';
      strSQL := strSQL + '          NEG_OPENEG,';
      strSQL := strSQL + '          NEG_MSGENV,';
      strSQL := strSQL + '          "",';
      strSQL := strSQL + '          ""';
      strSQL := strSQL + '   FROM MSGNEG   ';
      strSQL := strSQL + '   WHERE         ';
      strSQL := strSQL + '     NEG_CODEMP = :CODEMP   AND   ';
      strSQL := strSQL + '     NEG_CODCLI = :CODCLI   AND   ';
      strSQL := strSQL + '     NEG_TITULO LIKE "%LIMITE DE CRÉDITO%" AND';
      strSQL := strSQL + '     NEG_OPEENV = :OPECAD AND     ';
      strSQL := strSQL + '     NEG_DTAENV = :DTACAD AND     ';
      strSQL := strSQL + '     NEG_HORENV <=:HRACAD         ';
      strSQL := strSQL + '   ORDER BY 2, 3 DESC             ';
      strSQL := strSQL + ' ) AS TEMP';
      strSQL := strSQL + ' LEFT JOIN CADEMP ON CODEMP = EMP_CODEMP';
      strSQL := strSQL + ' LEFT JOIN CADCLI ON CODCLI = CLI_CODCLI';
      strSQL := strSQL + ' LEFT JOIN CADOPE AS CADOPEC ON OPECAD = CADOPEC.OPE_CODOPE';
      strSQL := strSQL + ' LEFT JOIN CADOPE AS CADOPEV ON OPECAD = CADOPEV.OPE_CODOPE';
      strSQL := strSQL + ' LEFT JOIN CADOPE AS CADOPEL ON OPELIB = CADOPEL.OPE_CODOPE';
      strSQL := strSQL + ' WHERE ';
      strSQL := strSQL + '  STATUS = "Negado"        ';
      strSQL := strSQL + '    OR                     ';
      strSQL := strSQL + '  STATUS = "Liberado"      ';
      strSQL := strSQL + '  ORDER BY DTACAD, HRACAD ASC   ';

      qrySelect.DisableControls;
      qrySelect.SQL.Add(strSQL);
      qrySelect.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qrySelect.ParamByName('ESPDOC').AsString := strEspDoc;
      qrySelect.ParamByName('NUMDOC').AsString := strNumDoc;
      qrySelect.ParamByName('DIRACE').AsString := '%LIMCR' ;
      qrySelect.ParamByName('CODCLI').AsString := strCodCli;
      qrySelect.ParamByName('OPECAD').AsString := strCodDig;
      qrySelect.ParamByName('DTACAD').AsDateTime := VS_Date;
      qrySelect.ParamByName('HRACAD').AsDateTime := FHraSolLibLimCr;

      qrySelect.Open;

      If Not qrySelect.IsEmpty Then
      Begin

        While Not(qrySelect.EOF) Do
        Begin
          blnOcorrenciaLib := (qrySelect.FieldByName('STATUS').AsString = 'Liberado');

          objOcoCrm.strCodOco := FstrCodOcoLimCr;
          objOcoCrm.strCodCli := strCodCli;
          objOcoCrm.strDtaInc := VS_Date;
          objOcoCrm.strHorInc := fRetHoraServidor();
          objOcoCrm.strDtaAge := objOcoCrm.strDtaInc;
          objOcoCrm.strHorAge := objOcoCrm.strHorInc;
          objOcoCrm.strDtaCon := objOcoCrm.strDtaInc;
          objOcoCrm.strHorCon := objOcoCrm.strHorInc;
          objOcoCrm.strOpeHis := strLoginUsuarioLogado;
          objOcoCrm.strCodOpe := strLoginUsuarioLogado;

          If blnOcorrenciaLib Then
          Begin
            strDescriAux := 'Liberação de Limite de Crédito<<csq>><<csq>>';
            strDescriAux := strDescriAux + 'Operador Liberação:  ' + qrySelect.FieldByName('NOMOPELIB').AsString +  '<<csq>>';
            strDescriAux := strDescriAux + 'Operador Solicitante:  ' + qrySelect.FieldByName('NOMOPECAD').AsString +  '<<csq>>';
          End
          Else
          Begin
            strDescriAux := 'Negada Liberação de Limite de Crédito<<csq>><<csq>>';
            strDescriAux := strDescriAux + 'Operador Negou Liberação:  ' + qrySelect.FieldByName('NOMOPELIB').AsString +  '<<csq>>';
            strDescriAux := strDescriAux + 'Operador Solicitante:  ' + qrySelect.FieldByName('NOMOPECAD').AsString +  '<<csq>>';
          End;

          objOcoCrm.strDescri := strDescriAux +  '<<csq>>' +
                                 FormatDateTime('dd/mm/yyyy', VS_Date) + ' ' + FormatDateTime('hh:nn:ss', fNow) + ' - ' +
                                 strLoginUsuarioLogado + ' - ' + fRetNomeOperador(strLoginUsuarioLogado);

          objOcoCrm.strCodEmp := VS_strCodEmp;
          objOcoCrm.strCodToc := fCfgSis('TOCLCR', varString);
          objOcoCrm.strCpfCli := strCliCgc;
          objOcoCrm.pInsereHistoricoOcorrencia;

          qrySelect.Next;
        End;
      End;
    Finally
      FreeAndNil(objOcoCrm);
      FreeAndNil(qrySelect);
    End;
  End;
End;

function TFatVenda.fEhNotaDeComplementoCIAP: Boolean;
begin
  Result := False;

  If not (strOpcDoc = 'NC') Then
