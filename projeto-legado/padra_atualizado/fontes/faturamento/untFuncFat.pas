procedure TFatVenda.pDestravaELimpaStlDocDevLck(strTabela, strNumDoc, strEspDoc, strCodEmp, strCodCli: String; blnZerar: Boolean);
  Var
    strDoc,
    strAux: String;
    intIdx: Integer;
    stlAuxLisDoc: TStringList;
begin
  stlAuxLisDoc := TStringList.Create;
  Try
    strAux := 'DEV_'+ strNumDoc + strEspDoc + strCodEmp + strCodCli;

    If (blnZerar) Then
    Begin
      For intIdx:=0 To stlDocDevLck.Count-1 Do
        fLock_Unlock(stlDocDevLck[intIdx], False, False);

      stlDocDevLck.Clear;
      stlDocDevTry.Clear;
    End

    Else If (Pos(strOpcDoc, 'DV_PR_' ) > 0) And (Not fEmptyStr(strNumDoc+strEspDoc+strCodEmp+strCodCli)) And (stlDocDevLck.IndexOf(strAux) <> -1) Then
    Begin
      fLock_Unlock(strAux, False, False);
      stlDocDevLck.Delete(stlDocDevLck.IndexOf(strAux));

      strDoc := AnsiReplaceStr(strAux,'DEV_', '');

      For intIdx:=0 To stlDocDevLck.Count-1 Do
      Begin
        If Pos(strDoc, stlDocDevLck[intIdx]) > 0 Then
          fLock_Unlock(stlDocDevLck[intIdx], False, False)
        Else
          stlAuxLisDoc.Add(stlDocDevLck[intIdx])
      End;

      stlDocDevLck.Clear;
      For intIdx:=0 To stlAuxLisDoc.Count-1 Do
        stlDocDevLck.Add(stlAuxLisDoc[intIdx]);

      If (stlDocDevTry.IndexOf(strAux) <> - 1) Then
        stlDocDevTry.Delete(stlDocDevTry.IndexOf(strAux));
    End;
  Finally
    FreeAndNil(stlAuxLisDoc)
  End;
end;

