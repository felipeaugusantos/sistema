              Result := False;
              Exit;
            End;

            If (VS_strHabilitarCRM) And (Not fEmptyStr(fCfgSis('VENORC', varString))) And (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
            Begin
              objOcoCrm := fAtualizaInformacoesCRM(strNumDoc,
                                                   strEspDoc,
                                                   strEmpOri,
                                                   strCodCli,
                                                   strNumOrc,
                                                   strEspOrc,
                                                   strCodVen,
                                                   afcOrcamentoFaturado,
                                                   '',
                                                   strCliCgc,
                                                   strCliAnt);
              If fDeveGerarOcorrenciaCRMParaProspecto Then
              Begin
                objOcoCrm.strCodPro := strProspe;
                objOcoCrm.strTip_FC := 'P';
              End;
              objOcoCrm.strEmpOri := strEmpOri;
              objOcoCrm.strNomFrm := '[TFatVenda.fGravaArquivos 9]';
            End;
          End;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA TINGER E TINDET                 *}
        {**************************************MV*}
        If (VS_strUsaTmq = 'S') Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Tinta de Máquina');

          If (Not fGArqTin) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        pStepStatusGravacao;
        pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

        {*****************************************}
        {* GRAVA MOVGER                          *}
        {**************************************MV*}
        If (Not fGMovGer) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA MOVDET                          *}
        {**************************************MV*}
        If (Not fGMovDet) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {********************************}
        {* GRAVA PEDIDO DE COMPRA       *}
        {*****************************LB*}
        If (fRetornaClienteFilial(VS_strCodEmp) <> strCodCli) Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Pedido de Compra para Transferência');

          If (Not fGPedCompraTransferencia) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        pStepStatusGravacao;

        {*******************************************}
        {* GRAVA CONTAS A RECEBER                  *}
        {****************************************MV*}
        If (((Not blnCliFil) And (Pos(strClaFis, VS_strClaVen) > 0)) Or
           ((blnCliFil) And (blnGravaCtrTe))) And (Not blnBaiEntFut) Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

          If (Not fGCadRec) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Clube de Fidelidade');
          pStepStatusGravacao;

          {**************************************}
          {* GRAVA CLUBE DE FIDELIDADE :-)      *}
          {***********************************AF*}
          If (Not fGCluFid) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pStepStatusGravacao;
          pInfoStatusGravacao('Aguarde... Gravando Comissão do Profissional');

          {**************************************}
          {* GRAVA COMISSÃO DO PROFISSIONAL     *}
          {***********************************LU*}
          If (Not fGComPro(fltBasComiss, fltVlrComiss)) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pStepStatusGravacao;

          If fDeveGravarComProCTR Then
          Begin
            pInfoStatusGravacao('Aguarde... Gravando Contas a Receber do Profissional');

            If (Not fGComProCtr) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;

          pStepStatusGravacao;

        End
        Else
        Begin
          For intContador := 1 To 4 Do
            pStepStatusGravacao;
        End;

        If Assigned(fLiberaReservaDeEstoqueDevolucaoWMS) Then
        Begin
          If not(fLiberaReservaDeEstoqueDevolucaoWMS(strAutInc)) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

        End;

      End;

      {*****************************************}
      {* TR - Troca de Mercadorias             *}
      {**************************************MV*}
      If (strEspDoc = 'TR') Then
      Begin
        {*****************************************}
        {* GRAVA TINGER E TINDET                 *}
        {**************************************MV*}
        If (VS_strUsaTmq = 'S') Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Tinta de Máquina');

          If (Not fGArqTin) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;

        pStepStatusGravacao;
        pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

        {*****************************************}
        {* GRAVA MOVGER                          *}
        {**************************************MV*}
        If (Not fGMovGer) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA MOVDET                          *}
        {**************************************MV*}
        If (Not fGMovDet) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA CADREC                          *}
        {**************************************MV*}
        If (Pos(strClaFis, VS_strClaVen) > 0) And (Not blnBaiEntFut) Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

          If (Not fGCadRec) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Clube de Fidelidade');
          pStepStatusGravacao;

          {**************************************}
          {* GRAVA CLUBE DE FIDELIDADE :-)      *}
          {***********************************AF*}
          If (Not fGCluFid) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pStepStatusGravacao;
          pInfoStatusGravacao('Aguarde... Gravando Comissão do Profissional');

          {**************************************}
          {* GRAVA COMISSÃO DO PROFISSIONAL     *}
          {***********************************LU*}
          If (Not fGComPro(fltBasComiss, fltVlrComiss)) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pStepStatusGravacao;

          If fDeveGravarComProCTR Then
          Begin
            pInfoStatusGravacao('Aguarde... Gravando Contas a Receber do Profissional');

            If (Not fGComProCtr) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;

          For intContador := 1 To 3 Do
            pStepStatusGravacao;

        End
        Else
        Begin
          For intContador := 1 To 6 Do
            pStepStatusGravacao;
        End;

        If (VS_strHabilitarCRM) And (Not fEmptyStr(fCfgSis('TOC_TR', varString))) Then
        Begin
          Try
            strProdutos := fPadR('Código', 7)     + '|' +
                           fPadR('Descrição', 35) + '|' +
                           fPadR('Qtde.', 12)     + '|' +
                           fPadR('Tipo(E/S)', 10) + '|' + #13;

            For intContador := 0 To Length(arrMatItens) -1 Do
            Begin
              With arrMatItens[intContador] Do
                strProdutos := strProdutos +
                               fPadR(strCodIte, 7)                                                + '|' +
                               fPadR(strDesIte, 35)                                               + '|' +
                               fPadL(FormatFloat('#,##0.00', fltQtdIte), 12)                      + '|' +
                               fPadR(IfThen( StrToInt(LeftStr(strClaFis,1)) < 4, 'E', 'S' ) , 10) + '|' + #13;
            End;

            objOcoCrm := TAtuOcoCrm.Create(Nil);
            objOcoCrm.strNomFrm := '[TFatVenda.fGravaArquivos 10]';
            objOcoCrm.strCodCli := strCodCli;
            objOcoCrm.strDtaInc := VS_Date;
            objOcoCrm.strHorInc := fRetHoraServidor();
            objOcoCrm.strDtaAge := objOcoCrm.strDtaInc;
            objOcoCrm.strHorAge := objOcoCrm.strHorInc;
            objOcoCrm.strDtaCon := objOcoCrm.strDtaInc;
            objOcoCrm.strHorCon := objOcoCrm.strHorInc;
            objOcoCrm.strOpeHis := strLoginUsuarioLogado;
            objOcoCrm.strCodOpe := strLoginUsuarioLogado;
            objOcoCrm.strEspDoc := strEspDoc;
            objOcoCrm.strNumDoc := strNumDoc;
            objOcoCrm.strDescri := 'Troca número: ' + strNumDoc + '-' + strEspDoc + '-' + strSerFsc + '-' + VS_strCodEmp +
                                        '<<csq>><<csq>>' + strProdutos +
                                        '<<csq>><<csq>>Operador Origem : ' + fRetNomeOperador(strLoginUsuarioLogado) + '<<csq>>' +
                                        FormatDateTime('dd/mm/yyyy', VS_Date) + ' ' + FormatDateTime('hh:nn:ss', fNow) + ' - ' +
                                        strLoginUsuarioLogado + ' - ' + fRetNomeOperador(strLoginUsuarioLogado);

            objOcoCrm.strCodEmp := VS_strCodEmp;
            objOcoCrm.strCodToc := fCfgSis('TOC_TR', varString);
            objOcoCrm.strCpfCli := strCliCgc;
            objOcoCrm.pInsereNovaOcorrencia;
            objOcoCrm.pInsereHistoricoOcorrencia;
          Finally
            FreeAndNil(objOcoCrm);
          End;
        End;

      End;

      {*****************************************}
      {* DV - Devolução de Mercadorias         *}
      {**************************************MV*}
      If (strEspDoc = 'DV') And (Not blnEspelhoDevolucaoCliente) Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

        {*****************************************}
        {* GRAVA MOVGER                          *}
        {**************************************MV*}
        If (Not fGMovGer) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA MOVDET                          *}
        {**************************************MV*}
        If (Not fGMovDet) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA CADREC                          *}
        {**************************************MV*}
        If (Pos(strClaFis, VS_strClaVen) > 0) And (Not blnBaiEntFut) Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

          If (Not fGCadRec) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Clube de Fidelidade');
          pStepStatusGravacao;

          {**************************************}
          {* GRAVA CLUBE DE FIDELIDADE :-)      *}
          {***********************************AF*}
          If (Not fGCluFid) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pStepStatusGravacao;
          pInfoStatusGravacao('Aguarde... Gravando Comissão do Profissional');

          {**************************************}
          {* GRAVA COMISSÃO DO PROFISSIONAL     *}
          {***********************************LU*}
          If (Not fGComProDev) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pStepStatusGravacao;

          If fDeveGravarComProCTR Then
