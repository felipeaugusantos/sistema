function TFatVenda.fTemBrindeServicoNaoTerc: Boolean;
  Var
    intIndSer: Integer;
    strCodSer: String;
    strBriSer: String;
begin
  Result := False;

  For intIndSer := 1 To 30 Do
  Begin
    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intToStr(intIndSer), 2));
    strBriSer := GetPropValue(Self, 'strBriS' + fStrZero(intToStr(intIndSer), 2));

    If fEmptyStr(strCodSer) Then
      Continue;

    If strBriSer <> 'S' Then
      Continue;

    If Not fEhServicoTerceirizado(strCodSer) Then
    Begin
      Result := True;
      Break;
    End;
  End;

end;

