procedure TFatVenda.pRetornaNotaUltimaCompra(strCodIte: String; var strNumDoc, strEspDoc, strCodEmp, strSerie_, strCodFor: String);
Var
  qryDoc: TUniQuery;
  strSQL,
  strForFil: String;
begin
  strNumDoc := '';
  strEspDoc := '';
  strCodEmp := '';
  strSerie_ := '';
  strCodFor := '';

  strForFil := fRetForFilialTodos(True);

  strSQL := 'SELECT ITE_NOTULT FROM ITEGER  '+
            'WHERE ITE_CODITE = :CODITE '+
            '  AND ITE_DTAULT IS NOT NULL '+
            '  AND LOCATE("NF", ITE_NOTULT) > 0 ';

  If not fEmptyStr(strForFil) Then
    strSQL := strSQL + '  AND (ITE_FORULT NOT IN (' + strForFil + ')) ';

  strSQL := strSQL + ' ORDER BY ITE_DTAULT DESC, ITE_NOTULT DESC LIMIT 1 ';

  qryDoc := fCriaQuery(Nil);

  Try
    qryDoc.Close;
    qryDoc.SQL.Clear;
    qryDoc.SQL.Text := strSQL;
    qryDoc.ParamByName('CODITE').AsString := strCodIte;
    qryDoc.Open;

    If qryDoc.RecordCount > 0 Then
      pDecodificaChaveNota(qryDoc.FieldByName('ITE_NOTULT').AsString, strNumDoc, strEspDoc, strCodEmp, strSerie_, strCodFor);

  Finally
    FreeAndNil(qryDoc);
  End;
end;

procedure TFatVenda.pCalcularIcmsMonofasicoRetidoAnteriormente(var item: TDadosFechamento);
var
  qryDoc: TUniQuery;
  strSQL,
  strNumDoc,
  strEspDoc,
  strCodEmp,
  strSerie_,
  strCodFor: String;
  fltBasIcmMonofasicoVenda,
  fltAlqIcmMonofasicoVenda,
  fltValIcmMonofasicoVenda,
  fltBasIcmMonofasicoCompra,
  fltAlqIcmMonofasicoCompra,
  fltValIcmMonofasicoCompra: Double;

begin

  item.fltBimRet := 0;
  item.fltAimRet := 0;
  item.fltVimRet := 0;

  If Self.blnCliFil Then
    Exit;

  If not (Pos(item.strClaFis, VS_strClaVen) > 0) Then
    Exit;

  if not (RightStr(item.strCodFis, 2) = '61') then
    Exit;

  pRetornaNotaUltimaCompra(item.strCodIte, strNumDoc, strEspDoc, strCodEmp, strSerie_, strCodFor);

  If fEmptyStr(strNumDoc) Then
    Exit;

  strSQL :=          'SELECT ';
  strSQL := strSQL + '  MOVDET.DET_CODITE, ';
  strSQL := strSQL + '  SUM(DET_QTDITE) AS DET_QTDITE, ';
  strSQL := strSQL + '  SUM(N28_QICMSMONORET) AS N28_QICMSMONORET, ';
  strSQL := strSQL + '  AVG(N28_ADBCMONORET)  AS N28_ADBCMONORET, ';
  strSQL := strSQL + '  SUM(N28_VREMICMSRET)  AS N28_VREMICMSRET ';
  strSQL := strSQL + 'FROM MOVDET ';
  strSQL := strSQL + '  INNER JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
  strSQL := strSQL + '  INNER JOIN GERELE ON GERELE.GER_DOCENT = MOVDET.DET_NUMDOC ';
  strSQL := strSQL + '                   AND GERELE.GER_ESPENT = MOVDET.DET_ESPDOC ';
  strSQL := strSQL + '                   AND GERELE.GER_EMPENT = MOVDET.DET_CODEMP ';
  strSQL := strSQL + '                   AND GERELE.GER_CODFOR = MOVDET.DET_CODFOR ';
  strSQL := strSQL + '                   AND IFNULL(GERELE.B07_SERIE, "") = IFNULL(MOVDET.DET_SERIE_, "") ';
  strSQL := strSQL + '  INNER JOIN DETELE ON DETELE.DET_SEQGER = GERELE.AUTOINCREM ';
  strSQL := strSQL + '                   AND DETELE.DET_CODITE = MOVDET.DET_CODITE ';
  strSQL := strSQL + ' WHERE MOVDET.DET_PROEMB <> "S" ';
  strSQL := strSQL + '   AND MOVDET.DET_NUMDOC = :NUMDOC ';
  strSQL := strSQL + '   AND MOVDET.DET_ESPDOC = :ESPDOC ';
  strSQL := strSQL + '   AND MOVDET.DET_CODEMP = :CODEMP ';
  strSQL := strSQL + '   AND MOVDET.DET_SERIE_ = :SERIE_ ';
  strSQL := strSQL + '   AND MOVDET.DET_CODFOR = :CODFOR ';
  strSQL := strSQL + '   AND MOVDET.DET_CODITE = :CODITE ';
  strSQL := strSQL + '   AND DETELE.N28_VREMICMSRET > 0 ';
  strSQL := strSQL + '   AND (LOCATE(MOVDET.DET_CLAFIS, ' + QuotedStr(VS_strClaCom) + ') > 0) ';
  strSQL := strSQL + 'GROUP BY MOVDET.DET_CODITE ';

  qryDoc := fCriaQuery(Nil);

  Try
    qryDoc.Close;
    qryDoc.SQL.Clear;
    qryDoc.SQL.Text := strSQL;
    qryDoc.ParamByName('NUMDOC').AsString := strNumDoc;
    qryDoc.ParamByName('ESPDOC').AsString := strEspDoc;
    qryDoc.ParamByName('CODEMP').AsString := strCodEmp;
    qryDoc.ParamByName('SERIE_').AsString := strSerie_;
    qryDoc.ParamByName('CODFOR').AsString := strCodFor;
    qryDoc.ParamByName('CODITE').AsString := item.strCodIte;
    qryDoc.Open;

    If not (qryDoc.RecordCount > 0) Then
      Exit;

    fltBasIcmMonofasicoCompra := (qryDoc.FieldByName('N28_QICMSMONORET').AsFloat / qryDoc.FieldByName('DET_QTDITE').AsFloat);
    fltAlqIcmMonofasicoCompra := (qryDoc.FieldByName('N28_ADBCMONORET').AsFloat);
    fltValIcmMonofasicoCompra := (qryDoc.FieldByName('N28_VREMICMSRET').AsFloat / qryDoc.FieldByName('DET_QTDITE').AsFloat);

    fltBasIcmMonofasicoVenda := fFormataFloat((fltBasIcmMonofasicoCompra * item.fltQtdIte), 4);
    fltAlqIcmMonofasicoVenda := fFormataFloat(fltAlqIcmMonofasicoCompra, 4);
    fltValIcmMonofasicoVenda := fFormataFloat((fltValIcmMonofasicoCompra * item.fltQtdIte), 2);

    If fltBasIcmMonofasicoVenda > 0 Then
        item.fltBimRet := fltBasIcmMonofasicoVenda;

    If fltAlqIcmMonofasicoVenda > 0 Then
        item.fltAimRet := fltAlqIcmMonofasicoVenda;

    If fltValIcmMonofasicoVenda > 0 Then
        item.fltVimRet := fltValIcmMonofasicoVenda;

  Finally
    FreeAndNil(qryDoc);
  End;

end;

