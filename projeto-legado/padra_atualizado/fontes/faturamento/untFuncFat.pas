  objLiberacao.strCodDig := Self.strCodDig;
  objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

  Result := fFatMensagemLiberacao(objLiberacao);

  FreeAndNil(objLiberacao);
end;

function TFatVenda.fValidarTrocaClienteTEPedeSenha(strCliAnt, strCliNov: String; strSenVen: String = ''): Boolean;
  Var
    objLiberacao  : TLiberacao;
begin

  objLiberacao := TLiberacao.Create;

  objLiberacao.objMsgLibera.pAddSeparador(80);
  objLiberacao.objMsgLibera.pAddTextoCaption('Documento'        , Self.strNumOrc + '-' + Self.strEspoRC + '-' + Self.strEmpOri, 16);
  objLiberacao.objMsgLibera.pAddSeparador(80);
  objLiberacao.objMsgLibera.pAddTexto('Alteração de cliente em transferência de estoque');
  objLiberacao.objMsgLibera.pAddSeparador(80);
