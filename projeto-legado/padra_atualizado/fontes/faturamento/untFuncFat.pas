function TFatVenda.fRetornaDescontoConcedido(fltValorOriginal, fltDesconto: Double; var fltPercDesconto: Double): Double;
begin
  Result := fltDesconto;

  if fEmptyStr(strCodCnd) then
    Exit;

  if fCampoTabela('CND_ABADES', 'CADCND', ['CND_CODIGO'], [strCodCnd], False) <> 'S' then
    Exit;

  if fltDMVCnd <= 0 then
    Exit;

  Result := fltValorOriginal - ((fltValorOriginal * fltDMVCnd) / 100.0);

  fltPercDesconto := 100 - ((fltDesconto * 100) / Result);

  Result := Result - fltDesconto;
end;

function TFatVenda.fItemFoiAlterado(strCodIte: String; fltQtdIte, fltTotIte: Double): Boolean;
begin
  Result := False;

  If (cdsVenda.Locate('ITE_CODITE', strCodIte, [])) Then
  Begin
    If (CompareValue(cdsVenda.FieldByName('ITE_QTDITE').AsFloat, fltQtdIte) = EqualsValue) And
       (CompareValue(cdsVenda.FieldByName('ITE_TOTITE').AsFloat, fltTotIte) = EqualsValue) Then
      Exit;
  End;

  Result := True;
end;

function TFatVenda.fInsereEnderecoProfissionalComoEndEnt(ACodDiv: String = ''; ACdsPro: TUniClientDataSet = nil): Boolean;
const
  SQL = 'SELECT DIV_CODCID, DIV_ENDERE, DIV_BAIRRO, DIV_C_E_P_, DIV_FONE01 ' +
        'FROM CADDIV ' +
        'WHERE DIV_CODDIV = :CODDIV';
var
  LEndere: TrecEnderecoEntrega;
  LQry: TUniQuery;
begin
  Result := True;

  if (not fCfgSis('CAENPR', varBoolean)) then
    Exit;

  LQry := fCriaQuery;

  try
    try
      LQry.SQL.Text := SQL;

      if (fCfgSis('NROPRO') = '2') then
      begin
        if fEmptyStr(ACodDiv) then
          Exit;

        LQry.Close;
        LQry.ParamByName('CODDIV').AsString := ACodDiv;
        LQry.Open;

        if LQry.IsEmpty then
          Exit;

        LEndere.strCodCli := Self.strCodCli;
        LEndere.strCidEnt := LQry.FieldByName('DIV_CODCID').AsString;
        LEndere.strEndEnt := LQry.FieldByName('DIV_ENDERE').AsString;
        LEndere.strBaiEnt := LQry.FieldByName('DIV_BAIRRO').AsString;
        LEndere.strCepEnt := LQry.FieldByName('DIV_C_E_P_').AsString;

        if (not fEnderecoJaExiste(LEndere)) then
          fIncluirEnderecoEntrega(LEndere);
      end
      else if (fCfgSis('NROPRO') = '3') then
      begin
        if (not Assigned(ACdsPro)) or (ACdsPro.IsEmpty) then
          Exit;

        ACdsPro.First;

        while not ACdsPro.Eof do
        begin
          LQry.Close;
          LQry.ParamByName('CODDIV').AsString := ACdsPro.FieldByName('DIV_CODDIV').AsString;
          LQry.Open;

          if (not LQry.IsEmpty) then
          begin
            LEndere.strCodCli := Self.strCodCli;
            LEndere.strCidEnt := LQry.FieldByName('DIV_CODCID').AsString;
            LEndere.strEndEnt := LQry.FieldByName('DIV_ENDERE').AsString;
            LEndere.strBaiEnt := LQry.FieldByName('DIV_BAIRRO').AsString;
            LEndere.strCepEnt := LQry.FieldByName('DIV_C_E_P_').AsString;

            if (not fEnderecoJaExiste(LEndere)) then
              fIncluirEnderecoEntrega(LEndere);
          end;

          ACdsPro.Next;
        end;
      end;
    except
      on E: Exception do
      begin
        Result := False;
        pMensagensErro(E.Message, '[fInsereEnderecoProfissionalComoEndEnt]');
      end;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

function TFatVenda.fPedidoComFalhaNaRetencaoDoImpostoDeRenda: Boolean;

  function fRetornaTotalDuplicatas: Double;
  var
    intContador: Integer;
  begin
    Result := 0;

    For intContador := 0 to 11 do
    Begin
      Result := Result + arrDuplicata[intContador].curValor;
    End;
  end;

begin
  Result := False;

  If not fCfgSis('VERIRF', varBoolean) Then
    Exit;

  If not (Self.strOpcDocTrue = '11') Then
    Exit;

  If not (Pos(Self.strEspDoc, 'NF_IF_') > 0) Then
    Exit;

  If fTemQueZeraIprjPisCofCsl Then
    Exit;

  If not (strCliOrg = 'S') Then
    Exit;

  If not (Self.strRetIrf = 'S') Then
    Exit;

  If not (Self.fltValIrf > 0) Then
    Exit;

  If fRetemImpostosNoDescontoEspecial Then
    Exit;

  If not (fTotalRetencoesProdutos + fTotalRetencoesServicos > 0) Then
    Exit;

  If (CompareValue(Self.fltTotCadRec, fRetornaTotalDuplicatas, 0.05) = EqualsValue) Then
    Exit;

  Result := True;
end;

procedure TFatVenda.pCarregaCodigoPortadorPix(const AstrNumDoc, AstrEspDoc, AstrCodEmp,
  AstrCodCli: String; var AstrCodPor: String; var AblnEhAdtPix: Boolean);
var
  qryDados : TUniQuery;
begin
  If (Not fCfgSis('USAPIX', varBoolean)) Or
     (fEmptyStr(AstrNumDoc)) Or
     (fEmptyStr(AstrEspDoc)) Or
     (fEmptyStr(AstrCodEmp)) Or
     (fEmptyStr(AstrCodCli)) Then
    Exit;

  qryDados := fCriaQuery;
  Try
    qryDados.SQL.Text := 'SELECT ADT_CODPOR FROM ADTCLI '
                       + ' WHERE ADT_NUMDOC = :NUMDOC '
                       + '   AND ADT_ESPDOC = :ESPDOC '
                       + '   AND ADT_EMPLAN = :CODEMP '
                       + '   AND ADT_CODCLI = :CODCLI '
                       + '   AND ADT_TIPLAN = "C" '
                       + '   AND ADT_RECPIX = "S" ';

     qryDados.ParamByName('NUMDOC').AsString := AstrNumDoc;
     qryDados.ParamByName('ESPDOC').AsString := AstrEspDoc;
     qryDados.ParamByName('CODEMP').AsString := AstrCodEmp;
     qryDados.ParamByName('CODCLI').AsString := AstrCodCli;
     qryDados.Open;

     If (Not qryDados.IsEmpty) And
        (Not fEmptyStr(qryDados.FieldByName('ADT_CODPOR').AsString)) Then
     Begin
       AstrCodPor   := qryDados.FieldByName('ADT_CODPOR').AsString;
       AblnEhAdtPix := True;
     End;
  Finally
    FreeAndNil(qryDados);
  End;
end;

{ TGerarTL }

{$IFNDEF LINUX}
constructor TGerarTL.Create;
begin
  FItensTL := TUniClientDataSet.Create(nil);

  With FItensTL.FieldDefs.AddFieldDef Do
  Begin
    Name     := 'CODITE';
    DataType := ftString;
    Size     := fTamCodIte;
    Required := False;
  End;

  With FItensTL.FieldDefs.AddFieldDef Do
  Begin
    Name     := 'ARMDES';
    DataType := ftString;
    Size     := VS_Size_NumLot;
    Required := False;
  End;

  With FItensTL.FieldDefs.AddFieldDef Do
  Begin
    Name     := 'ARMORI';
    DataType := ftString;
    Size     := VS_Size_NumLot;
    Required := False;
  End;

  With FItensTL.FieldDefs.AddFieldDef Do
  Begin
    Name     := 'QTDITE';
    DataType := ftFloat;
    Size     := 0;
    Required := False;
  End;

  FItensTL.CreateDataSet;
  FItensTL.Open;

  FTransf := TTransferenciaArmazens.Create(nil, FItensTL, Nil, nil);
end;

destructor TGerarTL.Destroy;
begin
  If Assigned(FTransf) Then
    FreeAndNil(FTransf);
  If Assigned(FItensTL) Then
    FreeAndNil(FItensTL);
  inherited;
end;

class function TGerarTL.Execute(const
                                ACodIte,
                                ALotOri,
                                ALotDes : String;
                                AQtdIte : Double;
                                ADocFat,
                                AEspFat,
                                AEmpFat,
                                ACliFat : String;
                                ASeqOri : String = '';
                                AFulfillment : TFulfillment = Nil): Boolean;
Var
  LGerarTL     : TGerarTL;
begin

  LGerarTL := TGerarTL.Create;

  If (Not fEmptyStr(ASeqOri)) Then
    LGerarTL.FTransf.strSeqOri := ASeqOri;

  Try
    LGerarTL.FItensTL.Append;
    LGerarTL.FItensTL.FieldByName('CODITE').AsString := ACodIte;
    LGerarTL.FItensTL.FieldByName('ARMDES').AsString := ALotDes;
    LGerarTL.FItensTL.FieldByName('ARMORI').AsString := ALotOri;
    LGerarTL.FItensTL.FieldByName('QTDITE').AsFloat  := AQtdIte;
    LGerarTL.FItensTL.Post;

    LGerarTL.FTransf.strDocFat := ADocFat;
    LGerarTL.FTransf.strEspFat := AEspFat;
    LGerarTL.FTransf.strEmpFat := AEmpFat;
    LGerarTL.FTransf.strCliFat := ACliFat;

    If Assigned(AFulfillment) Then
      LGerarTL.FTransf.Fulfillment.CopyFrom(AFulfillment);

    Result := LGerarTL.FTransf.fGeraTransferencia(True, False);

  Finally
    FreeAndNil(LGerarTL);
  End;

end;
{$ENDIF}

function TFatVenda.fExiteChaveReferenciada(strChvRef: String): Boolean;
Var
  intContador: Integer;
begin
  Result := False;

  For intContador := Low(Self.arrChaveReferenciada) To High(Self.arrChaveReferenciada) Do
  Begin
    If (Self.arrChaveReferenciada[intContador].strChvRef = strChvRef) Then
    Begin
      Result := True;
      Break;
    End;
  End;
end;

procedure TFatVenda.pCarregaChaveReferenciada(cdsDocs: TUniClientDataSet; blnRegistroUnico: Boolean=False);
var
  intPosicao: integer;
begin
  If not Assigned(cdsDocs.FindField('FIS_ACESSO')) Then
    Exit;

  If blnRegistroUnico Then
  Begin
    If fEmptyStr(cdsDocs.FieldByName('FIS_ACESSO').AsString) Then
      Exit;

    If not fExiteChaveReferenciada(cdsDocs.FieldByName('FIS_ACESSO').AsString) Then
    Begin
      SetLength(Self.arrChaveReferenciada, Length(Self.arrChaveReferenciada) + 1);
      intPosicao := Length(Self.arrChaveReferenciada) - 1;
      Self.arrChaveReferenciada[intPosicao].strChvRef := cdsDocs.FieldByName('FIS_ACESSO').AsString;
    End;

    Exit;
  End;

  cdsDocs.DisableControls;

  Try
    cdsDocs.First;

    While not cdsDocs.eof Do
    Begin
      If fEmptyStr(cdsDocs.FieldByName('FIS_ACESSO').AsString) Then
      Begin
        cdsDocs.Next;
        Continue;
      End;

      If not fExiteChaveReferenciada(cdsDocs.FieldByName('FIS_ACESSO').AsString) Then
      Begin
        SetLength(Self.arrChaveReferenciada, Length(Self.arrChaveReferenciada) + 1);
        intPosicao := Length(Self.arrChaveReferenciada) - 1;
        Self.arrChaveReferenciada[intPosicao].strChvRef := cdsDocs.FieldByName('FIS_ACESSO').AsString;
      End;

      cdsDocs.Next;
    End;

  Finally
    cdsDocs.EnableControls;
  End;
end;

function TFatVenda.fGravaChaveReferenciada: Boolean;
var
  strUFEmpresa: string;
begin
  Result := False;

  strUFEmpresa := fRetUFEmpresa;

  If (Self.strOpcDoc = 'DD') Then
    Exit(True);

  If (Self.strOpcDoc = 'FC') Then
    Exit(True);

  If (Self.strOpcDoc = 'CO') And (strUFEmpresa = 'SP') Then
    Exit(True);

  If (Self.strOpcDocTrue = 'BF') And (strUFEmpresa = 'SP') Then
    Exit(True);

end;

function TFatVenda.fGravaChvRef(strAutoIncremCadFis: String): Boolean;
Var
  qryAux: TUniQuery;
  intContador: Integer;
begin
  qryAux := fCriaQuery(Self);
  Try
    Try
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT * FROM CHVREF WHERE FALSE');
      qryAux.Open;

      For intContador := Low(Self.arrChaveReferenciada) To High(Self.arrChaveReferenciada) Do
      Begin
        qryAux.Insert;
        qryAux.FieldByName('FIS_SEQFIS').AsString := strAutoIncremCadFis;
        qryAux.FieldByName('FIS_CHVREF').AsString := Self.arrChaveReferenciada[intContador].strChvRef;
        qryAux.Post;
      End;

      Result := True;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '[fGravaChvRef]');
      End;
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

