    If (Self.strOpcDocTrue = '11') Then
      fltFreSug := qryFatGor.FieldByName('FGO_FRESUG').AsFloat;

    blnDesmembraPedRegEsp := (qryFatGor.FieldByName('FGO_REGDES').AsString = 'S');

    If (Assigned(qryFatGor.FindField('FGO_DESREN'))) Then
      blnDesmembrouSaindoDoRegime := (qryFatGor.FieldByName('FGO_DESREN').AsString = 'S')
    Else
      blnDesmembrouSaindoDoRegime := False;

    If (qryFatGor.FindField('FGO_CLICEO') <> Nil) Then
