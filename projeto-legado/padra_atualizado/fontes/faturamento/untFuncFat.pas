      objLiberacao.objMsgLibera.pAddTextoCaption('Horário da Carga'   , TimeToStr(horHorCar)                         , 20);
      objLiberacao.objMsgLibera.pAddTextoCaption('Data de Entrega'    , FormatDateTime('dd/mm/yyyy',dtaDtaEnt)       , 20);

