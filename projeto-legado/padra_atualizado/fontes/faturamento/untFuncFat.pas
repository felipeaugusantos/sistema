function TFatVenda.fComponenteDaTintaComPrecoDeVendaZerado(
  cdsTintaInf: TUniClientDataSet): Boolean;
var
  tinta: ITintaDeMaquina;
  intCont: Integer;
  dicInfEmp: TDicionario;
begin
  Result := False;

  dicInfEmp := TDicionario.Create;
  dicInfEmp['oprflj'] := strOprFlj;
  dicInfEmp['empprd'] := fCfgSis('EMPPRD');
  dicInfEmp['emp_cd'] := fCfgSis('EMP_CD');
  dicInfEmp['Cd_S_N'] := IIF(blnEnt_CD, 'S', 'N');
  dicInfEmp['empfat'] := IIF(blnEmpFat, VS_strCodEmp, '');
  dicInfEmp['FatS_N'] := IIF(blnEmpFat, 'S', 'N');
  tinta := fGetITintadeMaquina(cdsTintaInf, dicInfEmp);


  If Assigned(tinta) Then
  begin
    {*************************************************************************}
    {* IF ADICIONADO POIS AGORA PERMITE VENDER COM PREÇO DE VENDA ZERADO     *}
    {* DOS COLORANTES  SE A CONFIGURAÇÃO DA TINTA ZERCOL = 'S' (CFGTIN)      *}
    {*                        APARTIR DO REQUESITO 144204 - 18/09/2019       *}
    {**********************************************************************RG*}
    If fGetConfTinta(cdsTintaInf.FieldByName('ITE_IDEPRO').AsString).fGet('ZERCOL') <> 'S' Then
    Begin
      For intCont := 0 To tinta.Count - 1 Do
      Begin
        If (tinta[intCont].Quantidade > 0) And
           (fFormataFloat(tinta[intCont].PrecoVenda, 4) <= 0) And
           (tinta[intCont].Tipo <> tmctEmbalagemAutomotiva) Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  End;

  If Assigned(dicInfEmp) Then
    FreeAndNil(dicInfEmp);
end;

procedure TFatVenda.pComProFaixaFat(strCodDiv: String; Var fltBaseComissao, fltValorComissao: Double; fltTotalGeral: Double = 0; strSomenteOsAutIncDet: String = '');
  Var
    item: TDadosfechamento;
    qryAux: TUniQuery;
    strSQL: String;
    fltFatorFF,
    fltPerCop,
    fltPerCom: Double;
begin
  Try
    qryAux := fCriaQuery;
    Try
      If fltTotGer <> 0 Then
        fltTotalGeral := fltTotGer;

      strSQL := '';
      strSQL := strSQL + ' SELECT FAI_PERCOM ';
      strSQL := strSQL + ' FROM   FAIDIV ';
      strSQL := strSQL + ' WHERE  FAI_CODDIV = :CODDIV ';
      strSQL := strSQL + ' AND    :VALFAT BETWEEN FAI_VLRINI AND FAI_VLRFIN ';

      With qryAux Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('CODDIV').AsString := strCodDiv;
        ParamByName('VALFAT').AsFloat  := fltTotalGeral;
        Open;

        If Not IsEmpty Then
          fltPerCom := FieldByName('FAI_PERCOM').AsFloat
        Else
          fltPerCom := fCampoTabela('DIV_PERCOM', 'CADDIV', ['DIV_CODDIV'], [strCodDiv]);

        fltPerCop := fCampoTabela('DIV_PERCOP', 'CADDIV', ['DIV_CODDIV'], [strCodDiv]);

        fltFatorFF := fCfgSis('PCBCFF', varDouble);

        pPreencheComissaoItens(fltPerCom, fltPerCop, IIF(strEspDoc = 'FF', fltFatorFF, 0.00));

        fltBaseComissao  := 0;
        fltValorComissao := 0;

        For item In arrMatItens Do
        Begin
           If ((Not strSomenteOsAutIncDet.IsEmpty) And (Pos(item.strAutIncDet, strSomenteOsAutIncDet) = 0)) Then
             Continue;

          fltBaseComissao  := fltBaseComissao  + (IIF(SameText(Self.strEspDoc, 'TR') And SameText(item.strEntSai, 'E'), -1, 1) * item.fltBasComPro);
          fltValorComissao := fltValorComissao + (IIF(SameText(Self.strEspDoc, 'TR') And SameText(item.strEntSai, 'E'), -1, 1) * item.fltVlrComPro);
        End;
      End;

    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[ TFatVenda.fComProFaixaFat ]');
    End;
  Finally
    FreeAndNil(qryAux);
  End;
end;

procedure TFatVenda.pCalcComissaoProfissCadCliente(Var fltBaseComissao, fltValorComissao: Double; strSomenteOsAutIncDet: String = '');
  Var
    intCont: Integer;
    fltComProCadCli: Double;
begin
  fltBaseComissao  := 0;
  fltValorComissao := 0;

  fltComProCadCli := Self.fltPer_RT;

  For intCont := Low(ArrMatItens) To High(ArrMatItens) Do
  Begin
    With ArrMatItens[IntCont] Do
    Begin
      If ((Not strSomenteOsAutIncDet.IsEmpty) And (Pos(ArrMatItens[intCont].strAutIncDet, strSomenteOsAutIncDet) = 0)) Then
         Continue;

      fltBasComPro := (fltTotIte - fltDesEsp);
      fltVlrComPro := (fltTotIte - fltDesEsp) * fltComProCadCli / 100;
      fltPerComPro := fltComProCadCli;

      fltBaseComissao  := fltBaseComissao  + (IIF(SameText(Self.strEspDoc, 'TR') And SameText(ArrMatItens[IntCont].strEntSai, 'E'), -1, 1) * fltBasComPro);
      fltValorComissao := fltValorComissao + (IIF(SameText(Self.strEspDoc, 'TR') And SameText(ArrMatItens[IntCont].strEntSai, 'E'), -1, 1) * fltVlrComPro);
    End;
  End;
end;

procedure TFatVenda.pCalcComissaoProfissRT(Var fltBaseComissao, fltValorComissao: Double; strSomenteOsAutIncDet: String = '');
 Var
  intContador  :Integer;
  fltRTFat     :Double;
  fltRTCli     :Double;
  fltItePrePra :Double;
  fltQtdIte    :Double;
  fltValPreVis :Double;
  fltValOrigin :Double;
begin
  fltBaseComissao  := 0;
  fltValorComissao := 0;

  fltRTCli := Self.fltPer_RT;

  If fltRTCli > 0 Then
  Begin
    fltRTFat := (fltRTCli / 100);

    For intContador := 0 To Length(arrMatItens) - 1 Do
    Begin
      If ((Not strSomenteOsAutIncDet.IsEmpty) And (Pos(ArrMatItens[intContador].strAutIncDet, strSomenteOsAutIncDet) = 0)) Then
         Continue;

      fltQtdIte    := arrMatItens[intContador].fltQtdIte;

      fltItePrePra := (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp) / fltQtdIte;  //VALOR PRATICADO PELO VENDEDOR
      fltValPreVis := (arrMatItens[intContador].fltUniVis - arrMatItens[intContador].fltDesEsp  / fltQtdIte); //VALOR UNITÁRIO DE TABELA
      fltValOrigin := (arrMatItens[intContador].fltUniOri - arrMatItens[intContador].fltDesEsp  / fltQtdIte); //VALOR SUGERIDO PELO AUTCOM (TABELA+ACRÉSSIMOS FINANCEIROS)

      {*************************************************************************}
      {* SE O VALOR PRATICADO FOR MAIOR/IGUAL QUE O VALOR SUGERIDO PELO AUTCOM *}
      {* CASO CONTRÁRIO O CÁLCULO É FEITO TOMANDO POR BASE O VALOR PRATICADO   *}
      {***********************************************************************VA}
      If fltItePrePra >= fltValOrigin Then
      Begin
        ArrMatItens[intContador].fltBasComPro := (fltValPreVis * fltQtdIte);
        ArrMatItens[intContador].fltVlrComPro := (fltValPreVis * fltRTFat) * fltQtdIte;
      End
      Else
      Begin
        ArrMatItens[intContador].fltBasComPro := fltValPreVis * fltQtdIte;
        ArrMatItens[intContador].fltVlrComPro := arrMatItens[intContador].fltVal_RT * fltQtdIte;
      End;

      If ArrMatItens[intContador].fltBasComPro <> 0.00 Then
        ArrMatItens[intContador].fltPerComPro := ArrMatItens[intContador].fltVlrComPro / ArrMatItens[intContador].fltBasComPro * 100;

      fltBaseComissao  := fltBaseComissao  + (IIF(SameText(Self.strEspDoc, 'TR') And SameText(ArrMatItens[intContador].strEntSai, 'E'), -1, 1) * ArrMatItens[intContador].fltBasComPro);
      fltValorComissao := fltValorComissao + (IIF(SameText(Self.strEspDoc, 'TR') And SameText(ArrMatItens[intContador].strEntSai, 'E'), -1, 1) * ArrMatItens[intContador].fltVlrComPro);
    End;

  End;

end;

procedure TFatVenda.pRateiaValorRT;
Var
  fltTotProOri: Double;
  fltTot_RT   : Double;
  fltTotSRt   : Double;
  fltValDif   : Double;
  fltValBas   : Double;
  fltUniSRt   : Double;

  intContador : Integer;
begin

  For intContador := 0 To Length(arrMatItens) - 1 Do
  Begin
    fltTotProOri := (arrMatItens[intContador].fltUniOri * arrMatItens[intContador].fltQtdIte);
    fltTot_RT    := (arrMatItens[intContador].fltVal_RT * arrMatItens[intContador].fltQtdIte);
    fltTotSRt    := (arrMatItens[intContador].fltUniOri * arrMatItens[intContador].fltQtdIte) - (arrMatItens[intContador].fltVal_RT * arrMatItens[intContador].fltQtdIte);
    fltUniSRt    := (fltTotSRt / arrMatItens[intContador].fltQtdIte);

    arrMatItens[intContador].fltRT_Ori := arrMatItens[intContador].fltVal_RT;

    {*******************************************************************}
    {* SE O TOTAL DOS PRODUTOS FOR O MESMO CALCULADO NA VENDA OU TEVE  *}
    {* ACRESCIMO, IRÁ PAGAR A COMISSÃO REFERENTE AO VALOR CHEIO DO RT. *}
    {****************************************************************PZ*}
    If (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp) >= fltTotProOri Then
    Begin
      {******************************************}
      {* CALCULA O VALOR DA COMISSÃO BASEADO NO *}
      {* VALOR TOTAL DOS PRODUTOS MENOS O RT.   *}
      {***************************************PZ*}
      arrMatItens[intContador].fltVal_RT := ( fltUniSRt /  ( 1 - ( fltPer_RT / 100 ) ) )  - fltUniSRt;
    End
    Else
    Begin
      {******************************************************}
      {* SE TEVE DESCONTO NO ITEM, IRÁ PAGAR A COMISSÃO     *}
      {* PROPORCIONAL AO DESCONTO. SE O VALOR COM DESCONTO  *}
      {* FOR MENOR QUE O TOTAL SEM O RT, NÃO TERÁ COMISSÃO. *}
      {***************************************************PZ*}
      If (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp) > (fltTotProOri - fltTot_RT) Then
      Begin
        {*************************************************************}
        {* CALCULA A COMISSÃO SOBRE O TOTAL DOS PRODUTOS SEM RT  E   *}
        {* CALCULA A COMISSÃO SOBRE O A DIFERENÇA ENTRE OS TOTAL DOS *}
        {* PRODUTOS MENOS O TOTAL DOS PRODUTOS SEM RT.               *}
        {**********************************************************PZ*}
        fltValDif := ((arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp) - (fltTotProOri - fltTot_RT)) / arrMatItens[intContador].fltQtdIte;
        fltValBas := ( fltUniSRt /  ( 1 - ( fltPer_RT / 100 ) ) )  - fltUniSRt;

        {************************************************************************}
        {* SE O VALOR CALCULADO REFERENTE AO TOTAL DOS PRODUTOS                 *}
        {* SEM RT FOR MAIOR QUE O VALOR CALCULADO SOBRE A DIFERENÇA             *}
        {* ENTRE O TOTAL DOS PRODUTOS MENOS O TOTAL DOS PRODUTOS SEM RT,        *}
        {* CONSIDERA O VALOR SOBRE A DIFERENÇA, CASO CONTRÁRIO CONSIDERA        *}
        {* O VALOR CALCULADO SOBRE O TOTAL DOS PRODUTOS SEM RT.                 *}
        {* OBS. ESSA ALTERAÇÃO FOI FEITA A PEDIDO DO MILTON DA COFERT, POIS     *}
        {* SEGUNDO ELE, ESTAVA PAGANDO RT SOBRE RT. MÁRIO AUTORIZOU 07/10/2011. *}
        {*********************************************************************PZ*}
        If (fltValBas > fltValDif) Then
          arrMatItens[intContador].fltVal_RT := fltValDif
        Else
          arrMatItens[intContador].fltVal_RT := fltValBas;
      End
      Else
        arrMatItens[intContador].fltVal_RT := 0;
    End;

  End;

end;

