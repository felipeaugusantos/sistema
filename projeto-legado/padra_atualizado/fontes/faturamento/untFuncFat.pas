function fSenhaLiberacaoTintaSemSaldoVN(strCodOpe,
                                        strCodDig: String;
                                        Var strNTrava: String;
                                        stlNumLib : TStringList;
                                        objMsg: TMensagemLiberacao;
                                        strProduto: String = '';
                                        blnMostraMen: Boolean = TRUE;
                                        strOpcDoc: String = '';
                                        blnSoliTE: Boolean = FALSE;
                                        blnExpedi: Boolean = False;
                                        strOriF11: String  = 'N';
                                        strCodCli: String = '';
                                        strCodIte: String = '';
                                        strSeqDtaHrLogVar: String = ''): Boolean;
  Const
    STRAVISOTE = 'Mesmo estando configurado para realizar solicitação de transferência de estoque, ' +
                 'não será permitido utilizar esta rotina para produtos tinta de máquina. ' +
                 'Uma opção é utilizar produção fora da loja!';
  Var
    strMensag: String;
    objLiberacao : TLiberacao;
begin
  Result := false;
  If (fEmptyStr(fCfgSis('SENCVN'))) Or
     ((Pos(strOpcDoc, 'VN_CS_') > 0) And fCfgSis('SOLITE', VarBoolean) And (fCfgSis('COL_VN') = 'T')) Then
  Begin
    strMensag := '';

    If fEmptyStr(strProduto) Then
      strMensag := 'Este produto (base) ou um de seus componentes (colorantes/embalagem) não possui saldo suficiente para esta venda!'
    Else
      strMensag := 'Produto ' + strProduto + ' não possui saldo suficiente para esta venda!';

    If (Not blnSoliTe) And (Pos(strOpcDoc, 'VN_CS_') > 0) And fCfgSis('SOLITE', VarBoolean) And (fCfgSis('COL_VN') = 'T') Then
    Begin
      strMensag := strMensag + #13#10 + STRAVISOTE;
      fMensagem('', strMensag, ['&OK']);
    End
    Else
    Begin
      If Not blnSoliTe Then
        fMensagem('', strMensag, ['&OK'])
      Else
        Result := True;
      Exit;
    End;
  End;

  //como faz o insert, a ordem de inclusão é invertida, ou seja a primeira linha ficará por último.
  If (fCfgSis('VSEORC', varBoolean) And (strOpcDoc = 'VN')) And (Not blnExpedi) And (strOriF11 <> 'S') Then
    objMsg.pInsertTexto(0, 'Será permitido apenas fechamento em Orçamento!');

  If fEmptyStr(strProduto) Then
    objMsg.pInsertTexto(0, 'Este produto não possui saldo suficiente para esta venda!')
  Else
    objMsg.pInsertTexto(0, 'Produto ' + strProduto + ' não possui saldo suficiente para esta venda!');


  objLiberacao := TLiberacao.Create;
  try
    objLiberacao.objMsgLibera := objMsg;
    objLiberacao.strDirAce := 'LBSDVN';
    objLiberacao.strSenLib := fCfgSis('SENCVN');
    objLiberacao.strMsgSen := 'Liberação de produto sem saldo - '+IIF(strOriF11='S','Resumo de Caixa!', 'Venda Normal!');
    objLiberacao.blnMosMen := blnMostraMen;
    objLiberacao.strCodOpe := strCodOpe;
    objLiberacao.strCodDig := strCodDig;
    objLiberacao.strCodIte := strCodIte;
    objLiberacao.strCliente := strCodCli;
    objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);
    objLiberacao.blnIgnInc := True;
    objLiberacao.strSequencialUnicoDtaHra := strSeqDtaHrLogVar;

    Result := fMensagemLiberacao(objLiberacao, strNTrava, stlNumLib);
  finally
    FreeAndNil(objLiberacao);
  end;
end;

function fSenhaLiberacaoTintaSemSaldoOP(strCodOpe,
                                        strCodDig: String;
                                        Var strNTrava: String;
                                        stlNumLib : TStringList;
                                        objMsg: TMensagemLiberacao;
                                        blnMostraMen: Boolean = TRUE;
                                        blnExpedi: Boolean = False;
                                        strOriF11: String  = 'N';
                                        strCodCli: String = '';
                                        strCodIte: String = '';
