          objCopyDataSet.Sequence := fGetMaxAutIncClient(cdsVenda);
          objCopyDataSet.CopyData(qryGen, cdsVenda, objMapperFields, objMapperProcessValue, 'ITE_CDSVENDA = 1', pgbStatus);
        Finally
          FreeAndNil(objMapperFields);
        End;
        objMapperFields := TMapperFieldsPedidoVenda.GetMapperFields(True);
        Try
          objCopyDataSet.Sequence := fGetMaxAutIncClient(cdsDadosPedBaixados);
          objCopyDataSet.CopyData(qryGen, cdsDadosPedBaixados, objMapperFields, objMapperProcessValue, '(ITE_BAIXADOS = 1) AND (ITE_QTDBAI > 0)', pgbStatus);
        Finally
          FreeAndNil(objMapperFields);
        End;
      Finally
        FreeAndNil(objMapperProcessValue);
      End;

      qryGenDor := fCriaClientDatset(qryGen);
    finally
      FreeAndNil(objCopyDataSet);
      FreeAndNil(qryGen);
    end;

    objCalculaImpostoPedido := TCalculaImpostoPedido.Create(qryGenDor,
                                                            fGetInputCalculaImpostoPedido(qryGenDor.FieldByName('CLI_INDUST').AsString),
                                                            Self.GetTipAbf
                                                           );

    if blnPraticarPrecosEmpresaFaturamento then
    begin
      qryGenDor.First;
      while not qryGenDor.Eof do
      begin
        qryGen := fCriaQuery;
        objSQLItensPedido := TSQLItensPedido.Create(fGetInputSQLItens(qryGenDor.FieldByName('AUTOINCREM').AsString, qryGenDor.FieldByName('FDO_EMPITE').AsString, strNumRom, blnCarregarItens, blnAlteraOrcamentoOutraLoja));
        try
          qryGen.Close;
          qryGen.SQL.Clear;
          qryGen.SQL.Add(objSQLItensPedido.fGetSQL);
          qryGen.ParamByName('CODEMP').AsString := fGetEmpCalculoItem(qryGenDor.FieldByName('FDO_EMPITE').AsString);
          qryGen.ParamByName('NUMDOC').AsString := strNumOrc;
          qryGen.ParamByName('ESPDOC').AsString := strEspOrc;
          qryGen.ParamByName('EMPDOC').AsString := IIF((strOpcDoc = 'OR') And (Not (fOrcamentoOutraLojaF11 Or fOrcamentoOutraLojaORVN)) , VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri));

          qryGen.Open;

          qryGenDor.Edit;

          for intField := 0 to qryGenDor.Fields.Count -1 do
            qryGenDor.Fields[intField].Value := qryGen.Fields[intField].Value;

          qryGenDor.Post;
        finally
          FreeAndNil(qryGen);
          FreeAndNil(objSQLItensPedido);
        end;
        qryGenDor.Next;
      end;
    end;

    pPopulaSepFdoTemp(qryGenDor);

    qryGenDor.First;

    If Assigned(pgbStatus) Then
    Begin
      pgbStatus.Position := 0;
      pgbStatus.Properties.Max := qryGenDor.RecordCount;
    End;

    pPegaDadosFiscais( IIF( fAtendeRegraFiscalEndEntrega, fTrocaUFEndEntrega,
                            fRetEstadoCliente(qryFatGor.FieldByName('FGO_CODCLI').AsString) ),
                       strCliIes,
                       strMicEmp,
                       fGetUFEmpresa(''),
                       True );

    intPraMedio := fFloatToInt(fCalcMediaPagto(qryFatGor.FieldByName('FGO_CONPAG').AsString));

