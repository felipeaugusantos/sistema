procedure TFatVenda.pSetaTipOpeDocumento(const stlDocSel: TStrings);
var
  qryDados: TUniQuery;
begin
  If (stlDocSel.Count = 0) Or
     (Copy(stlDocSel[0],13,2) <> 'FF') Or
     (Not qryTemporariaConfirmacao.Active) Or
     (qryTemporariaConfirmacao.RecordCount = 0) Then
    Exit;

  qryDados := fCriaQuery;
  Try
    qryTemporariaConfirmacao.First;

    qryDados.Close;
    qryDados.SQL.Text := 'SELECT '
                       + '       G.GER_NUMDOC '
                       + '     , G.GER_ESPDOC '
                       + '     , G.GER_CODEMP '
                       + '     , E.FGO_AUTRCO '
                       + '     , F.AUTOINCREM '
                       + '     , F.FGO_TIPOPE as TIPOPE_DOCUMENTO '
                       + '     , T.FGO_TIPOPE AS TIPOPE_REMESSA '
                       + '  FROM AUXMOV A '
                       + ' INNER JOIN MOVGER G ON G.AUTOINCREM = A.AUX_SEQGER '
                       + '  LEFT JOIN FATGOR F ON F.FGO_NUMFAT = G.GER_NUMDOC '
                       + '                    AND F.FGO_TIPFAT = G.GER_ESPDOC '
                       + '                    AND F.FGO_EMPFAT = G.GER_CODEMP '
                       + '  left JOIN EXTGOR E ON E.FGO_SEQFGO = F.AUTOINCREM '
                       + '  LEFT JOIN EXTGOR X ON X.FGO_AUTRCO = F.AUTOINCREM '
                       + '  LEFT JOIN FATGOR T ON T.AUTOINCREM = X.FGO_SEQFGO '
                       + ' WHERE G.GER_NUMDOC = :NUMDOC '
                       + '   AND G.GER_ESPDOC = :ESPDOC '
                       + '   AND G.GER_CODEMP = :CODEMP ';

    qryDados.ParamByName('NUMDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString;
    qryDados.ParamByName('ESPDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString;
    qryDados.ParamByName('CODEMP').AsString := qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString;
    qryDados.Open;

    qryDados.First;

    If (qryDados.FieldByName('TIPOPE_DOCUMENTO').AsString = 'R') Then
      strTipOpe := 'R'
    Else If (qryDados.FieldByName('TIPOPE_DOCUMENTO').AsString = 'C') And
            (qryDados.FieldByName('TIPOPE_REMESSA').AsString = 'R') Then
      strTipOpe := 'C';

  Finally
    FreeAndNil(qryDados);
  End;
end;

function TFatVenda.fDefinirTipoAbastecimentoPedidoAVista: Boolean;
begin
  Result := False;

  if (blnFinali) then
    Exit;

  if (not blnReqAut) then
    Exit;

  if (fStatusCndPag(strConPag) <> A_VISTA) then
    Exit;

  if (strOriF11 = 'S') then
    Exit;

  Result := True;
end;

function TFatVenda.fDefineAbastecimentoItensSemEstoqueSuficiente: Boolean;
begin
  Result := True;

  If fDefinirAbastecimentoItens Then
  Begin
    If (Not Self.fDefineAbastecimentoItens(oeExibirSeTranfOuCompra)) Then
      Exit(False);

    If (Not Assigned(objAbastecimentoItensPedido)) Then
      Exit;

    If (Not objAbastecimentoItensPedido.fTemSolicitacaoDeTransferenciaOuCompra) Then
      Exit;

    If (Not Self.blnFinali) And (Not Self.blnMulLoj) Then
      Self.blnFinali := Self.fHaveraDesmembramentoVenda(Self.arrMatItens);

    If Not Self.blnFinali And (Length(Self.arrMatItens) > 0) Then
      Self.strFatTot := IIF(Self.arrMatItens[0].blnFatPar, 'N', 'S');

    If (Self.blnFinali) And
       (Self.fEfetivarValidacaoDoPerfilDaCondicaoNosDocumentosDesmembrados) Then
    Begin
      If (Not Self.fValidouValorMinimoNosDocumentosDesmembrados(True)) Then
        Exit(False);
    End;
  End;
end;

procedure TFatVenda.pDefineSeGeraNovoPedidoAbastecimentoItens(strEmpCfg: String);
begin
  blnAbastecTransfReqEmNovoPedido := fTemItensAbastecimentoTransReq(Self.arrMatItens);

  if (not blnAbastecTransfReqEmNovoPedido) then
    Exit;

  Self.strEspDoc := 'PD';
  Self.blnPedBlo := False;//Novo pedido ja deve gravar liberado

  if (not fCfgSis('TPFPED', varBoolean)) then
  begin
    if (Self.strTipPed = 'C') and (not fCfgSis('TPPDCX', VarBoolean, strEmpCfg)) then
      Self.strTipPed := 'A';

    if fLimparTipoDePedidoPoisSeraDefinidoNaExpedicao(strEmpCfg) Then
      Self.strTipPed := '';
  end
  else
    Self.strTipPed := fBuscaTipPed(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri);
end;

function TFatVenda.fTemItensAbastecimentoTransReq(Itens: TMatrizFechamento): Boolean;
var
  item: TDadosFechamento;
Begin
  Result := False;

  if (strOriF11 <> 'S') then
    Exit;

  for item in Itens do
  begin
    if (item.opcTipAbs in [oaSolicitTransf, oaReqCompra]) Then
    begin
      Result := True;
      Break;
    end;
  end;
end;

procedure TFatVenda.pExibeMensagemNovoPedidoItensAbastecimentoTransReq(Itens: TMatrizFechamento);
var
  item: TDadosFechamento;
  strItens: String;
Begin
  If (strEspDoc <> 'PD') Then
    Exit;

  If (strOriF11 <> 'S') Then
    Exit;

  If (Not blnAbastecTransfReqEmNovoPedido) Then
    Exit;

  strItens := '';

  For item In Itens Do
  Begin
    If (item.opcTipAbs In [oaSolicitTransf, oaReqCompra]) Then
    Begin
      If (Not fEmptyStr(strItens)) Then
        strItens := strItens + ', ';
      strItens := strItens + item.strCodIte + ' - ' + item.strDesIte;
    End;
  End;

  If (Not fEmptyStr(strItens)) Then
  Begin
    fMensagem('Atenção!', 'O pedido não foi faturado na espécie escolhida pois ele possui ' +
                          'abastecimento gerado. Sendo assim, foi gerado um novo pedido que vai ficar '+
                          'na expedição até a filial abastecer e depois o faturamento deve ser feito pela expedição.' +#10+#13+
                          'Pedido: ' + strNumDoc + '-' + strEspDoc +#10+#13 + 'Itens: ' + strItens, ['&Ok']);
  End;
end;


function TFatVenda.fDefinirAbastecimentoItens: Boolean;
begin
  Result := True;

  if (not fCfgSis('SLTFRC', varBoolean)) then
    Exit(False);

  if (strEspDoc = 'PD') then
    Exit;

  if (strOriF11 = 'S') then
    Exit;

  Result := False;
