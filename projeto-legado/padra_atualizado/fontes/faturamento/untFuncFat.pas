function TFatVenda.fGetTotalVinculado(AStrCodIte: String; ABlnEmPedCompra: Boolean; strSeqFDO: String = ''): Double;
var
  cdsAux: TUniClientDataSet;
begin
  If (Not Assigned(Self.CdsVinculos)) Then
    Exit(0);

  cdsAux := TUniClientDataSet.Create(Nil);
  cdsAux.Data := Self.CdsVinculos.Data;
  Try
    cdsAux.Filter := 'ITE_CODITE = ' + QuotedStr(AStrCodIte) + IIF(not fEmptyStr(strSeqFDO), ' AND SEQFDO=' + QuotedStr(strSeqFDO), '');
    cdsAux.Filtered := True;
    cdsAux.First;
    Result := 0;
    While Not cdsAux.Eof Do
    Begin
      If ABlnEmPedCompra Then
      Begin
        If Not fEmptyStr(cdsAux.FieldByName('AUTINC').AsString) Then
          Result := Result + cdsAux.FieldByName('QTDITE').AsFloat;
      End
      Else
      Begin
        Result := Result + cdsAux.FieldByName('QTDITE').AsFloat;
      End;
      cdsAux.Next;
    End;

  Finally
    FreeAndNil(cdsAux);
  End;
end;

function TFatVenda.fVerificarQuantidadesVinculos(ACdsVinculos, ACdsItens: TUniClientDataSet): Boolean;
var
  strFiltroBkp,
  strMsg,
  strItemAtual: String;
  blnFiltered,
  blnMostrarMsg: Boolean;
  fltTotVinc,
  fltTotVincComPedCompra,
  fltQtdParaGerar: Double;
  stlItens,
  stlRequisicoesParaGerar: TStringList;
  I: Integer;
begin
  if fCfgSis('SLTFRC', varBoolean) Or fVaiDefinirAbastecimentoItens then
    Exit(True);

  blnFiltered := ACdsItens.Filtered;
  If blnFiltered Then
    strFiltroBkp := ACdsItens.Filter;

  ACdsVinculos.DisableControls;

  stlItens := TStringList.Create;
  stlRequisicoesParaGerar := TStringList.Create;
  Try
    ACdsItens.Filtered := False;
    ACdsItens.First;
    blnMostrarMsg := False;

    While Not ACdsItens.Eof Do
    Begin

      If ACdsVinculos.isEmpty Then
      Begin
        stlRequisicoesParaGerar.Add(ACdsItens.FieldByName('ITE_CODITE').AsString
            + '|' + ACdsItens.FieldByName('ITE_QTDITE').AsString
            + '|' + ACdsItens.FieldByName('ITE_DESITE').AsString);

        Result := True;

        ACdsItens.Next;
        Continue;
      End;

      If Not ACdsVinculos.Locate('ITE_CODITE;DESITE',
                                  VarArrayOf([ACdsItens.FieldByName('ITE_CODITE').AsString,
                                              ACdsItens.FieldByName('ITE_DESITE').AsString]),
                                  []) Then
      Begin
        if (ACdsItens.FieldByName('ITE_SEMEST').AsString = 'S') then
        begin
          stlRequisicoesParaGerar.Add(ACdsItens.FieldByName('ITE_CODITE').AsString
                                       + '|' + ACdsItens.FieldByName('ITE_QTDITE').AsString
                                       + '|' + ACdsItens.FieldByName('ITE_DESITE').AsString);
          Result := True;
        end;

        ACdsItens.Next;
        Continue;
      End;

      fltTotVinc := fGetTotalVinculado(ACdsItens.FieldByName('ITE_CODITE').AsString, False);
      fltTotVincComPedCompra := fGetTotalVinculado(ACdsItens.FieldByName('ITE_CODITE').AsString, True);

      If (ACdsItens.FieldByName('ITE_QTDITE').AsFloat <> (fltTotVinc + fltTotVincComPedCompra)) Then
      Begin
        If fltTotVincComPedCompra = 0 Then
        Begin
          If ACdsItens.FieldByName('ITE_QTDITE').AsFloat > fltTotVinc Then
            fltQtdParaGerar := ACdsItens.FieldByName('ITE_QTDITE').AsFloat
          Else
            fltQtdParaGerar := fltTotVinc;

          blnMostrarMsg := True;

          stlItens.Add(ACdsItens.FieldByName('ITE_CODITE').AsString +
                      ': Requisitada: ' + FloatToStr(fltTotVinc) +
                      ' | No pedido: ' + ACdsItens.FieldByName('ITE_QTDITE').AsString +
                      ' | Com pd. de compra: ' + FloatToStr(fltTotVincComPedCompra) +
                      ' | A gerar: ' + FloatToStr(fltQtdParaGerar));
        End
        Else
        Begin
          If fltTotVinc = fltTotVincComPedCompra Then
          Begin
            If fltTotVinc < ACdsItens.FieldByName('ITE_QTDITE').AsFloat Then
              fltQtdParaGerar := ACdsItens.FieldByName('ITE_QTDITE').AsFloat - fltTotVinc
            Else
              fltQtdParaGerar := fltTotVinc - fltTotVincComPedCompra;
          End
          Else
          Begin
            fltQtdParaGerar := fltTotVinc - fltTotVincComPedCompra;
          End;
        End;
      End
      Else
      Begin
        fltQtdParaGerar := fltTotVinc;
      End;

      If fltQtdParaGerar > 0 Then
        stlRequisicoesParaGerar.Add(ACdsItens.FieldByName('ITE_CODITE').AsString
                                    + '|' + FloatToStr(fltQtdParaGerar)
                                    + '|' + ACdsItens.FieldByName('ITE_DESITE').AsString);

      ACdsItens.Next;
    End;

    Result := True;
    If blnMostrarMsg Then
    Begin
      strMsg := 'Há itens aonde a quantidade requisitada não é a quantidade total do item no pedido de venda: ' + #13#10 ;
      For I := 0 To Pred(stlItens.Count) Do
        strMsg := strMsg + stlItens[I] + #13#10;
      strMsg := strMsg + 'Para essas diferenças serão geradas requisições avulsas!' + #13#10 + 'Confirma essas requisições avulsas?';

      Result := fMensagem('', strMsg, ['&Sim', '&Não']) = 1;
    End;

    If Result Then
    Begin
      //Limpa na primeira vez as requisições avulsas que possam ter sido geradas na tela dos vinculos
      For I := 0 To Pred(stlRequisicoesParaGerar.Count) Do
      Begin
        If strItemAtual <> SplitString(stlRequisicoesParaGerar[I],'|')[0] Then
        Begin
          ACdsVinculos.Filter := 'ITE_CODITE = ' + SplitString(stlRequisicoesParaGerar[I],'|')[0]
              + ' AND DESITE = '+ QuotedStr(SplitString(stlRequisicoesParaGerar[I],'|')[2]);

          ACdsVinculos.Filtered := True;
          ACdsVinculos.First;
          While Not ACdsVinculos.Eof Do
          Begin
            If ACdsVinculos.FieldByName('AVULSA').AsString = 'S' Then
              ACdsVinculos.Delete
            Else
              ACdsVinculos.Next;
          End;

          ACdsVinculos.Filtered := False;
          strItemAtual := SplitString(stlRequisicoesParaGerar[I],'|')[0];
        End;

        ACdsVinculos.Insert;
        ACdsVinculos.FieldByName('AVULSA').AsString := 'S';
        ACdsVinculos.FieldByName('AUTINC').AsString := '';
        ACdsVinculos.FieldByname('ITE_CODITE').AsString := SplitString(stlRequisicoesParaGerar[I],'|')[0];
        ACdsVinculos.FieldByName('QTDITE').AsFloat := StrToFloat(SplitString(stlRequisicoesParaGerar[I],'|')[1]);
        ACdsVinculos.FieldByName('DESITE').AsString := SplitString(stlRequisicoesParaGerar[I],'|')[2];
        ACdsVinculos.Post;
      End;
    End;

  Finally
    ACdsItens.Filtered := blnFiltered;
    If ACdsItens.Filtered Then
      ACdsItens.Filter := strFiltroBkp;
    FreeAndNil(stlItens);
    FreeAndNil(stlRequisicoesParaGerar);

    ACdsVinculos.EnableControls;
  End;
end;

function TFatVenda.fHaPedidosInvalidosNasRequisicoes(ACdsVinculos: TUniClientDataSet): Boolean;
  var
    blnPedidoCancelado,
    blnSemSaldoNoPedido,
    blnPedidoBaixado: Boolean;
    fltQtdBai: Double;
    strAutIncPcmGer, StrAutIncPcmDet: String;
    fltQtdVinc: Double;
  begin
    Result := False;

    ACdsVinculos.First;

    While Not ACdsVinculos.Eof Do
    Begin
      strAutIncPcmGer := ACdsVinculos.FieldByName('AUTGER').AsString;
      strAutIncPcmDet := ACdsVinculos.FieldByName('AUTINC').AsString;
      fltQtdVinc := ACdsVinculos.FieldByName('QTDITE').AsFloat;

      If fEmptyStr(strAutIncPcmGer) Then
      Begin
        blnPedidoCancelado := False;
        blnPedidoBaixado := False;
      End
      Else
      Begin
        blnPedidoCancelado := fEmptyStr(fCampoTabela('AUTOINCREM', 'PCMGER', ['AUTOINCREM'], [strAutIncPcmGer]));
        blnPedidoBaixado := fCampoTabela('PCG_BAIXAD', 'PCMGER', ['AUTOINCREM'], [strAutIncPcmGer]) = 1;
      End;

      If (blnPedidoCancelado Or blnPedidoBaixado) Then
        Exit(True);

      if Not fEmptyStr(strAutIncPcmDet) Then
      Begin
        fltQtdBai := fCampoTabela('PCD_QTDBAI', 'PCMDET', ['AUTOINCREM'], [strAutIncPcmDet]);

        blnSemSaldoNoPedido := fltQtdBai >= fltQtdVinc;

        If blnSemSaldoNoPedido Then
          Exit(True);
      End;

      ACdsVinculos.Next;
    End;

  end;

procedure TFatVenda.pRemoverVinculosDeItensForaPedido(ACdsVinculos, ACdsItensPedido: TUniClientDataSet);
