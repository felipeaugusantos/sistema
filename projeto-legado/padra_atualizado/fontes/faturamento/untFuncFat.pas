      If (Pos(strCFOPDv, '1917_2917_') > 0) Then
        strClaFis := strCFOPDv;
    End;

    fltVolPro := 0.0;

    {*****************************************}
    {* A OPCAO 3 É IGUAL A OPCAO 1, POREM    *}
    {* ALGUNS VALORES SERÃO SOBRESCRITOS MAIS*}
    {* À FRENTE.                             *}
    {**************************************MV*}
