function TFatVenda.fTodasAsEmpresasUsamWMS: Boolean;
  Var
    cdsDados : TUniClientDataSet;
    stlEmpresas : TStringList;
    strEmpIte : String;
begin
  cdsDados := TUniClientDataSet.Create(Nil);
  stlEmpresas := TStringList.Create;
  Try
    Result := False;
    pCloneDataSet(cdsDados, cdsVenda);
    cdsDados.Filtered := False;
    cdsDados.Filter := EmptyStr;
    cdsDados.Filtered := True;
    If cdsDados.IsEmpty Then
      Exit;
    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      strEmpIte := cdsDados.FieldByName('ITE_EMPITE').AsString;
      If fEmptyStr(strEmpIte) Then
        strEmpIte := cdsDados.FieldByName('ITE_CODEMP').AsString;
      If fEhItemServico(cdsDados.FieldByName('ITE_CODITE').AsString) Then
      Begin
        cdsDados.Next;
        Continue;
      End;
      If (fEmptyStr(strEmpIte)) Then
      Begin
        cdsDados.Next;
        Continue;
      End;
      If stlEmpresas.IndexOf(strEmpIte) >= 0 Then
      Begin
        cdsDados.Next;
        Continue;
      End;
      If (Not fUsaRotinaWMS(strEmpIte)) Then
        Exit(False);
      Result := True;
      stlEmpresas.Add(strEmpIte);
      cdsDados.Next;
    End;
  Finally
    FreeAndNil(cdsDados);
    FreeAndNil(stlEmpresas);
  End;
end;

function TFatVenda.fPedidoSemRestricoesDeLiberacao: Boolean;
begin
  Result := ((fCfgSis('LIBPED', varString) = 'N') Or
             ((fCfgSis('LPPDBL', varString) = 'S') And (Not Self.blnPedBlo)) Or
             ((fCfgSis('LPSTER', varString) = 'S') And fEmptyStr(strNumPok)));
end;

function TFatVenda.fPoderaImprimirSeparacaoDePedido: Boolean;
begin
  If Self.strEspDoc <> 'PD' Then
    Exit(False);

  If (fTodasAsEmpresasUsamWMS) Then
    Exit(False);

  If (Self.blnEnt_CD) Then
    Exit(True);

  Result := (fCfgSis('PEDSEP') = 'S') And (fPedidoSemRestricoesDeLiberacao);
End;

