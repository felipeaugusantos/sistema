function TFatVenda.fPossuiItensMultiLojaComDestinoEntrega: Boolean;
Var
  cdsItens                              : TUniClientDataSet;
  blnPossuiItensMultiLojaDestinoEntrega : Boolean;
Begin
  cdsItens := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsItens, cdsVenda);
    cdsItens.First;

    blnPossuiItensMultiLojaDestinoEntrega := False;

    While Not cdsItens.Eof Do
    Begin
      If (cdsItens.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITESER')) And
         (cdsItens.FieldByName('ITE_CODITE').AsString <> fCfgSis('SERTER')) Then
      Begin
        If (Not blnPossuiItensMultiLojaDestinoEntrega) And
           (cdsItens.FieldByName('ITE_ENTRET').AsString = 'E') And
           (cdsItens.FieldByName('ITE_EMPITE').AsString <> VS_strCodEmp) Then
          blnPossuiItensMultiLojaDestinoEntrega := True;
      End;

      If (blnPossuiItensMultiLojaDestinoEntrega) Then
        Break;

      cdsItens.Next;
    End;

    Result := blnPossuiItensMultiLojaDestinoEntrega;
  Finally
    FreeAndNil(cdsItens);
  End;
End;

function TFatVenda.fPossuiItensEmpresaLogadaEMultiLojaApenasRetira: Boolean;
Var
  cdsItens                            : TUniClientDataSet;
  blnPossuiItensEmpresaLogada,
  blnPossuiItensMultiLojaApenasRetira : Boolean;
Begin
  cdsItens := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsItens, cdsVenda);
    cdsItens.First;

    blnPossuiItensEmpresaLogada         := False;
    blnPossuiItensMultiLojaApenasRetira := True;

    While Not cdsItens.Eof Do
    Begin
      If (cdsItens.FieldByName('ITE_CODITE').AsString <> fCfgSis('ITESER')) And
         (cdsItens.FieldByName('ITE_CODITE').AsString <> fCfgSis('SERTER')) Then
      Begin
        If (Not blnPossuiItensEmpresaLogada) And
           (cdsItens.FieldByName('ITE_EMPITE').AsString = VS_strCodEmp) Then
          blnPossuiItensEmpresaLogada := True;

        If (blnPossuiItensMultiLojaApenasRetira) And
           (cdsItens.FieldByName('ITE_ENTRET').AsString = 'E') And
           (cdsItens.FieldByName('ITE_EMPITE').AsString = VS_strCodEmp) Then
          blnPossuiItensMultiLojaApenasRetira := False;
      End;

      If Not blnPossuiItensMultiLojaApenasRetira Then
        Break;

      cdsItens.Next;
    End;

    Result := blnPossuiItensEmpresaLogada And
              blnPossuiItensMultiLojaApenasRetira;
  Finally
    FreeAndNil(cdsItens);
  End;
End;

