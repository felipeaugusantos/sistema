function TFatVenda.fGerarOrdemDeServico: Boolean;
  Var
    objConEqu: TConEqu;
    intCodSer: Integer;
    strNumOse: String;
begin
  Result := True;

  If Not ((strEspDoc = 'PD') And
          (fltTotSer > 0) And
          fCfgSis('CONEQU', VarBoolean) And
          fCfgSis('GER_OS', VarBoolean)) Then
  Begin
    pServicoRemovidoDoPedidoDeletaOrdemServico;
    Exit;
  End;

  objConEqu := TConEqu.Create(Self);

  strNumOse := fRetornaOrdemServicoPedido(strNumDoc, strEmpDoc);

  If Not fEmptyStr(strNumOse) Then
  Begin
    If fCfgSis('GER_OS', varBoolean) Then
    Begin
      objConEqu.strNumero := strNumOse;
      objConEqu.strCodEmp := VS_strCodEmp;
      If Not objConEqu.fCancelaOrdServico(strNomeForm) Then
      Begin
        objConEqu.Destroy;
        Exit(False);
      End;
    End
    Else
    Begin
      objConEqu.Destroy;
      Exit;
    End;
  End;

  objConEqu.strOperac := 'I';//Inclusao
  objConEqu.strStatus := 'A';//Aprovada
  objConEqu.strSubSta := 'C';//Pelo Cliente
  objConEqu.strTemPed := 'S';//Tem Pedido
  objConEqu.strObserv := '';
  objConEqu.strCliGar := '';
  objConEqu.strGarant := 'N';//Sem Garantia
  objConEqu.strCodVe2 := strCodVe2;
  objConEqu.strCodRep := strCodRep;
  objConEqu.strCodDig := strCodDig;
  objConEqu.strDisSer := Self.strDisSer;

  objConEqu.strCodTec := '';
  objConEqu.strCodEmp := VS_strCodEmp;
  objConEqu.strEmpSer := VS_strCodEmp;
  objConEqu.strEmpApr := VS_strCodEmp;
  objConEqu.strDescri := '';
  objConEqu.strMarEqu := '';

  objConEqu.strDtaEnt := DateToStr(Self.VS_Date);
  objConEqu.strHorEnt := TimeToStr(fRetHoraServidor);

  If dtaPreVis > 0 Then
    objConEqu.strPrevis := DateToStr(dtaPreVis);

  objConEqu.strTabPre := strTabPre;

  objConEqu.strCodVen := strCodVen;
  objConEqu.strCodCli := strCodCli;
  objConEqu.pCarregarCliente(nil, strCodCli, True);

  If fClienteConsumidor(objConEqu.strCliNom) Then
  Begin
    objConEqu.strCliNom := strCliNom; // - Nome
    objConEqu.strCliEnd := strCliEnd; // - Endereco
    objConEqu.strCliBai := strCliBai; // - Bairro
    objConEqu.strCliCep := strCliCep; // - Cep
    objConEqu.strCodCid := strCodCid; // - Cód. Cidade
    objConEqu.strCliCid := strCliCid; // - Cidade
    objConEqu.strCliEst := strCliEst; // - Estado
    objConEqu.strCliTel := strCliTel; // - Telefone
    objConEqu.dtaNasCon := dtaNasCon; // - Nascimento
    objConEqu.strCliCgc := strCliCgc; // - CNPJ
    objConEqu.strCli_Rg := strCli_Rg; // - RG
    objConEqu.intCgcCpf := intCgcCpf; // - CGC/CPF
    objConEqu.strCliIes := strCliIes; // - Ins.Estadual
    objConEqu.strCodAti := strCodAti; // - Codigo Atividade
  End
  Else
  Begin
    If (objConEqu.strCliEnd <> Self.strEndEnt) Then
    Begin
      objConEqu.strCliEnd := Self.strEndEnt; // - Endereco
      objConEqu.strCliBai := Self.strBaiEnt; // - Bairro
      objConEqu.strCliCep := Self.strCepEnt; // - Cep
      objConEqu.strCodCid := Self.strCidEnt; // - Cód. Cidade
      objConEqu.strCliCid := Self.strNomCidEnt; // - Cód. Cidade
      objConEqu.strCliTel := Self.strCliTel; // - Telefone
      objConEqu.dtaNasCon := Self.dtaNasCon; // - Nascimento
      objConEqu.strEntGer := Self.strAutEnt; // - AUTOINCREMENT END. ENTREGA
    end;
  End;

  objConEqu.strFlxFas := 'M';
  objConEqu.strFlxSit := 'EM';
  objConEqu.strFlxCom := 'AM';

  objConEqu.strOri_PD := 'S';

  objConEqu.cdsIteEqu.EmptyDataSet;
  objConEqu.cdsSerEqu.EmptyDataSet;

  objConEqu.fltVlrSer := 0.00;
  objConEqu.fltVlrCon := 0.00;
  objConEqu.fltVlrPro := 0.00;

  objConEqu.strDescri := 'OS gerada pelo documento ' + strNumDoc + '-' + strEspDoc;

  If (Not fEmptyStr(Self.strMen001)) Then
    objConEqu.strDescri := objConEqu.strDescri + #13#10 + Self.strMen001;

  If (Not fEmptyStr(Self.strMen002)) Then
    objConEqu.strDescri := objConEqu.strDescri + #13#10 + Self.strMen002;

  For intCodSer := 1 To 30 Do
  Begin
    objConEqu.strTecSer := '';
    objConEqu.strCodSer := '';
    objConEqu.strDesSer := '';
    objConEqu.fltValSer := 0.00;

    If Not fEmptyStr(GetPropValue(Self, 'strCodS' + fStrZero(intCodSer, 2))) Then
    Begin
      objConEqu.strTecSer := '';
      objConEqu.strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intCodSer, 2));
      objConEqu.strDesSer := GetPropValue(Self, 'strDesS' + fStrZero(intCodSer, 2));
      objConEqu.fltValSer := GetPropValue(Self, 'fltValS' + fStrZero(intCodSer, 2)) *
        (1 - (GetPropValue(Self, 'fltDecS' + fStrZero(intCodSer, 2)) / 100))  ;

      objConEqu.pIncluiServicoGrid;

      objConEqu.fltVlrSer := objConEqu.fltVlrSer + objConEqu.fltValSer;
      objConEqu.fltVlrCon := objConEqu.fltVlrCon + objConEqu.fltValSer;
    End;
  End;

  Result := objConEqu.fGravaEquGer;

  If Result Then
  Begin
    blnGerOS := True;
    strNumOS := objConEqu.strNumero;
    objConEqu.pMarcaNumeroPedidoVenda(strNumDoc, False);
  End;

  objConEqu.Destroy;
end;

