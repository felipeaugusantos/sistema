    (FieldByName('ITE_LARPEC') As TFloatField).DisplayFormat := fMskDigitos(5);
    (FieldByName('ITE_QTDITE') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', varInteger));
    (FieldByName('ITE_ESTQTD') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', varInteger));
    (FieldByName('ITE_PRETAB') As TFloatField).DisplayFormat := fMskDigitos(VS_intDecUni);
    (FieldByName('ITE_UNITAR') As TFloatField).DisplayFormat := fMskDigitos(VS_intDecUni);
