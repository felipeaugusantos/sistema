function TFatVenda.fGravarEmpresaLogadaMovCarMovModAoDesmembrarPedido(strTabela: String = ''): Boolean;
  function fEhFaturamentoAVistaOuComEntrada():Boolean;
  begin
    Result := False;

    If (fStatusCndPag(Self.strConPag) = A_VISTA) Then
      Result := True;

    If ((Pos(Self.strCodFpg, '002_006_007_') > 0) And fCfgSis('PRACHC', VarBoolean)) Then
      Result := True;

    If fConPagComEntrada(strConPag) Then
      Result := True;
  end;
begin
  Result := False;

  if (fCfgSis('EPMCMD', varString, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri))= 'N') then
    Exit;

  if (fCfgSis('EPMCMD', varString, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri))= 'M') And (strTabela = 'MOVMOD') then
    Exit;

  Result := (strOriF11 = 'S')                And
            (strEmpOri <> VS_strCodEmp)      And
            (Not fEmptyStr(strNumOrc)) And
            fEhFaturamentoAVistaOuComEntrada();
end;

