  end;

  if (Result) and (Self.strOpcDoc = 'FC') then
  begin
    strAutincMovGerFC := strAutInc;
  end;

  if (Result) then
    FAuditFaturamento.Adicionar(strAutInc, 'MOVGER');

  If Result Then
    FAuditoriaSaldo.Adicionar(strAutInc, 'MOVGER');

  If Result And fEhConsertoEquipamento Then
    FAutIncConEqu := strAutInc;

  Result := Result And fGMovRes(strAutInc, 'MOVGER');

  If Result And Assigned(objDespesasFaturamento) Then
    Result := objDespesasFaturamento.fGravarDespesas(strAutInc, 'MOVGER');

  If (Result) And (strEntreg = 'S') Then
  Begin
    Result := fGEntGer;
  End;

  If (fCfgSis('OPSOAB') = '2') And (Not blnEnt_CD) Then
  Begin
    Result := Result And fGravaLojasTE;
    Result := Result And fGravaPedidosTransferencia;
    Result := Result And fGerarSolicitaoTransferenciasColorantes();
  End;

  if (Result) and (strEspDoc = 'IF') and (fUsaSat) and (fGravarSessaoSat) then
  begin
    TGravaSatSes.New
      .GravaSatSes(
        TSatSes.New
          .NumDoc(strNumDoc)
          .EspDoc(strEspDoc)
          .CodEmp(VS_strCodEmp)
          .CodCli(strCodCli)
          .Serie(strSerFsc)
          .Sessao(fGeraNumeroSessao)
      );
  end;

  {*******************************************}
  {* GRAVA PEDIDO DE TRANSFERENCIA DOS ITENS *}
  {* DE ENTREGA FUTURA FATURADOS PELO F11    *}
  {****************************************FC*}
  If (Result) And (fGeraPDAbastecimentoCDVendaEntregaFutura) Then
    Result := fGravaPDTransfEntFutF11;

  If (Result) Then
    If (DigImp.blnOperadorDigitouImpostos) Then
      Result := DigImp.fGravarDIGIMP(strAutInc);

  If Result Then
  Begin
    If Pos(strClaFis, VS_strClaVen) > 0 Then
      blnAlteraCliente := True;
  End;

end;

Procedure TFatVenda.pAtualizaMovDetMls(Var stlDetMLs: TStringList; strCodAca, strEmpAca: String);
  Var
    qryAux: TUniQuery;
    intIndice: Integer;
begin
  If Assigned(stlDetMLs) And (stlDetMLs.Count > 0) Then
  Begin
    qryAux := fCriaQuery(Nil);
    qryAux.SQL.Add('UPDATE ');
    qryAux.SQL.Add('MOVDET ');
    qryAux.SQL.Add('SET ');
    qryAux.SQL.Add('  DET_CODACA = :CODACA,');
    qryAux.SQL.Add('  DET_EMPACA = :EMPACA ');
    qryAux.SQL.Add('WHERE ');
    qryAux.SQL.Add('  AUTOINCREM = :AUTINC ');

    For intIndice := 0 To stlDetMLs.Count - 1 Do
    Begin
      qryAux.Close;
      qryAux.ParamByName('CODACA').AsString := strCodAca;
      qryAux.ParamByName('EMPACA').AsString := strEmpAca;
      qryAux.ParamByName('AUTINC').AsString := stlDetMLs[intIndice];
      qryAux.ExecSQL;
    End;

    stlDetMLs.Clear;
    stlDetMLs := Nil;

    FreeAndNil(qryAux);
  End;
End;

