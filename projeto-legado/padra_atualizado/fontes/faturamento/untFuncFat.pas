function TFatVenda.fPedidoMultiLoja(parBlnCliFil: Boolean=False; parBlnSetaBlnFinali: Boolean=True): Boolean;
  Var
    blnFiltered: Boolean;
    strFilter  : String;
Begin
  If parBlnSetaBlnFinali Then
    blnFinali := False;

  If (Not parBlnCliFil) Then
    If (Not blnEmpFat) Then
      Exit(False);

  If (Pos(strOpcDoc, 'PD_OR_VN_') <= 0) Then
    Exit(False);

  If (strOpcDoc = 'VN') And (Pos(strEspDoc, 'PD_OR_') <= 0) Then
    Exit(False);

  With cdsVenda Do
  Begin
    DisableControls;
    blnFiltered := Filtered;
    strFilter   := Filter;

    If (Filter <> '') Then
      Filter := Filter + ' AND ITE_EMPITE <> ' + QuotedStr(VS_strCodEmp)
    Else
      Filter := 'ITE_EMPITE <> ' + QuotedStr(VS_strCodEmp);

    Filtered := True;

    Result := Not IsEmpty;

    blnMulLoj := Result;

    Filtered := blnFiltered;
    Filter   := strFilter;
    EnableControls;
  End;
End;

