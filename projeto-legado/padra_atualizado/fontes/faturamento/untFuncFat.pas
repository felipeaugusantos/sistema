function TFatVenda.fValidarDivergenciaST(blnExiMsg: Boolean=True): Boolean;
Var
  strTipoTitulo: String;
  fltTotRetOri: Double;
begin
  Result := True;

  If (Not strNumOrc.IsEmpty) Then
  Begin
    strTipoTitulo := IIF(strEspOrc = 'PD', 'Pedido', 'Orçamento');
    fltTotRetOri  := fCampoTabela('FGO_TOTRET', 'FATGOR', ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'], [strNumOrc, strEspOrc, strEmpOri]);

    If (fFormataFloat(fltTotRetOri, 2)) <> (fFormataFloat(Self.fltTotRet, 2)) Then
    Begin
      Result := False;

      If (Not blnExiMsg) Then
        Exit;

      If Self.fAtendeRegraFiscalEndEntrega Then
        fMensagem('ATENÇÃO!', 'O valor da substituição tributária está divergente entre o ' + strTipoTitulo + ' e o Documento a ser gerado!' + sLineBreak +
                              'Esse cliente é construtora e esta configurado para calcular impostos usando endereço de entrega.' + sLineBreak +
                              'Verifique a necessidade de regravar o pedido de venda para atualizar o endereço de entrega e os valores!', ['&OK'])
      Else
        fMensagem('ATENÇÃO!', 'O valor da substituição tributária está divergente entre o ' + strTipoTitulo + ' e o Documento a ser gerado!' + sLineBreak +
                              'Verifique se há a necessidade de regravar o pedido de venda para atualizar os valores!', ['&OK']);
    End;
  End;

end;

