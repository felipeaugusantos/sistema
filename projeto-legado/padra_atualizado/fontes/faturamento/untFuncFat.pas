function TFatVenda.fExcedeValorLimiteBrindesMes(strOpcDoc: String): Boolean;
  Var
    fltTotBrinde: Double;
    fltTotBrindeMes: Double;
    fltPreIteTab: Double;
    intCont: Integer;
    qryTotBrindeM: TUniQuery;
    strSQL: String;
    fltDifBrinde: Double;
    objLiberacao  : TLiberacao;
    strMinData: String;
    strMaxData: String;
begin
  Result := False;

  strMinData := QuotedStr(FormatDateTime('yyyy-mm-dd', StartOfAMonth(YearOf(VS_Date), MonthOf(VS_Date))));
  strMaxData := QuotedStr(FormatDateTime('yyyy-mm-dd', EndOfAMonth(YearOf(VS_Date), MonthOf(VS_Date))));

  fltTotBrinde := 0;
  Try
    If strOpcDoc = 'BR' Then
      fltTotBrinde := Self.fltTotGer
    Else
    Begin
      For intCont := 0 To Length(arrMatItens) -1 Do
      Begin
        If (arrMatItens[intCont].strBrinde = 'S') Then
        Begin
          If arrMatItens[intCont].fltTotIte > 0 Then
            fltTotBrinde := fltTotBrinde + (arrMatItens[intCont].fltTotIte - arrMatItens[intCont].fltDesEsp)
          Else
          case fCfgSis('SUG_BR', varInteger) of
            1:fltTotBrinde := fltTotBrinde + arrMatItens[intCont].fltTotCus;
            2:Begin
                fltPreIteTab := 0;
                Case StrToInt(arrMatItens[intCont].strTabPre) Of
                  1: fltPreIteTab := arrMatItens[intCont].fltPreVe1;
                  2: fltPreIteTab := arrMatItens[intCont].fltPreVe2;
                  3: fltPreIteTab := arrMatItens[intCont].fltPreVe3;
                  4: fltPreIteTab := arrMatItens[intCont].fltPreVe4;
                  5: fltPreIteTab := arrMatItens[intCont].fltPreVe5;
                  6: fltPreIteTab := arrMatItens[intCont].fltPreVe6;
                  7: fltPreIteTab := arrMatItens[intCont].fltPreVe7;
                End;

                fltTotBrinde := fltTotBrinde +
                                ((fltPreIteTab * arrMatItens[intCont].fltQtdIte) -
                                  arrMatItens[intCont].fltDesEsp);
              End;
            3:fltTotBrinde := fltTotBrinde + arrMatItens[intCont].fltTotUlt;
            4:fltTotBrinde := fltTotBrinde + arrMatItens[intCont].fltTotImp;
          else
            fltTotBrinde := fltTotBrinde + arrMatItens[intCont].fltTotCus;
          end;
        End;
      End;
    End;

    If fltTotBrinde = 0 Then
      Exit;

    qryTotBrindeM := fCriaQuery;

    strSQL := '';
    strSQL := strSQL + 'SELECT SQL_NO_CACHE ';
    strSQL := strSQL + '  SUM(TOTITE) AS TOTGER ';
    strSQL := strSQL + 'FROM (';
    strSQL := strSQL + '  SELECT ';
    strSQL := strSQL + '    SUM(IF(DET_ESPDOC = "BR", IFNULL(DET_TOTITE, 0) - IFNULL(DET_DESESP, 0), ';
    strSQL := strSQL + '           IF(IFNULL(DET_TOTITE, 0) > 0, IFNULL(DET_TOTITE, 0) - IFNULL(DET_DESESP, 0), ';

    case fCfgSis('SUG_BR', varInteger) of
      1:strSQL := strSQL + '            IFNULL(DET_TOTCUS, 0)';
      2:Begin
          strSQL := strSQL + '            IFNULL((CASE DET_TABPRE ';
          strSQL := strSQL + '                      WHEN "1" THEN ITE_PREVE1 ';
          strSQL := strSQL + '                      WHEN "2" THEN ITE_PREVE2 ';
          strSQL := strSQL + '                      WHEN "3" THEN ITE_PREVE3 ';
          strSQL := strSQL + '                      WHEN "4" THEN ITE_PREVE4 ';
          strSQL := strSQL + '                      WHEN "5" THEN ITE_PREVE5 ';
          strSQL := strSQL + '                      WHEN "6" THEN ITE_PREVE6 ';
          strSQL := strSQL + '                      WHEN "7" THEN ITE_PREVE7 ';
          strSQL := strSQL + '                    END * DET_QTDITE) - DET_DESESP, 0)';
        End;
      3:strSQL := strSQL + '            IFNULL((ITE_PREULT * DET_QTDITE) - DET_DESESP, 0)';
      4:strSQL := strSQL + '            IFNULL((ITE_IMPULT * DET_QTDITE) - DET_DESESP, 0)';
    else
      strSQL := strSQL + '            IFNULL(DET_TOTCUS, 0)';
    end;

    strSQL := strSQL + '    ))) AS TOTITE ';
    strSQL := strSQL + '  FROM ';
    strSQL := strSQL + '    MOVDET ';
    strSQL := strSQL + '    INNER JOIN ITEGER ON ITE_CODITE = DET_CODITE AND ITE_CODEMP = DET_CODEMP ';
    strSQL := strSQL + '  WHERE ';
    strSQL := strSQL + '    DET_CODEMP = :CODEMP AND ( ';
    strSQL := strSQL + '    DET_ESPDOC = "BR" OR LOCATE(DET_CLAFIS, :CLAFIS) > 0) AND ';
    strSQL := strSQL + '    (DET_DTAENT BETWEEN ' + strMinData + ' AND ' + strMaxData + ') ';
    strSQL := strSQL + '  UNION ALL ';
    strSQL := strSQL + '  SELECT ';
    strSQL := strSQL + '    SUM(IF(FDO_ESPDOC = "BR", IFNULL(FDO_TOTITE, 0) - IFNULL(FDO_DESESP, 0), ';
    strSQL := strSQL + '           IF(IFNULL(FDO_TOTITE, 0) > 0, IFNULL(FDO_TOTITE, 0) - IFNULL(FDO_DESESP, 0), ';

    case fCfgSis('SUG_BR', varInteger) of
      1:strSQL := strSQL + '            IFNULL(FDO_TOTCUS, 0)';
      2:Begin
          strSQL := strSQL + '            IFNULL((CASE FDO_TABPRE ';
          strSQL := strSQL + '                      WHEN "1" THEN ITE_PREVE1 ';
          strSQL := strSQL + '                      WHEN "2" THEN ITE_PREVE2 ';
          strSQL := strSQL + '                      WHEN "3" THEN ITE_PREVE3 ';
          strSQL := strSQL + '                      WHEN "4" THEN ITE_PREVE4 ';
          strSQL := strSQL + '                      WHEN "5" THEN ITE_PREVE5 ';
          strSQL := strSQL + '                      WHEN "6" THEN ITE_PREVE6 ';
          strSQL := strSQL + '                      WHEN "7" THEN ITE_PREVE7 ';
          strSQL := strSQL + '                    END * FDO_QTDITE) - FDO_DESESP, 0)';
        End;
      3:strSQL := strSQL + '            IFNULL((ITE_PREULT * FDO_QTDITE) - FDO_DESESP, 0)';
      4:strSQL := strSQL + '            IFNULL((ITE_IMPULT * FDO_QTDITE) - FDO_DESESP, 0)';
    else
      strSQL := strSQL + '            IFNULL(FDO_TOTCUS, 0)';
    end;

    strSQL := strSQL + '    ))) AS TOTITE ';
    strSQL := strSQL + '  FROM ';
    strSQL := strSQL + '    FATDOR ';
    strSQL := strSQL + '    INNER JOIN ITEGER ON ITE_CODITE = FDO_CODITE AND ITE_CODEMP = FDO_CODEMP ';
    strSQL := strSQL + '  WHERE ';
    strSQL := strSQL + '    FDO_CODEMP = :CODEMP AND (';
    strSQL := strSQL + '    FDO_ESPDOC = "BR" OR LOCATE(FDO_CLAFIS, :CLAFIS) > 0) AND ';
    strSQL := strSQL + '    (FDO_DTAENT BETWEEN ' + strMinData + ' AND ' + strMaxData + ') ';


    If (Not fEmptyStr(Self.strNumOrc)) Then
      strSQL := strSQL + ' AND NOT (FDO_NUMDOC = :NUMDOC AND FDO_ESPDOC = :ESPDOC) ';

    strSQL := strSQL + ') AS TMP';

    qryTotBrindeM.Sql.Text := strSQL;

    qryTotBrindeM.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryTotBrindeM.ParamByName('CLAFIS').AsString := CLAFIS_BR;

    If (Not fEmptyStr(Self.strNumOrc)) Then
    Begin
      qryTotBrindeM.ParamByName('NUMDOC').AsString := Self.strNumOrc;
      qryTotBrindeM.ParamByName('ESPDOC').AsString := Self.strEspOrc;
    End;

    qryTotBrindeM.Open;

    fltTotBrindeMes := qryTotBrindeM.FieldByName('TOTGER').AsFloat;

    FreeAndNil(qryTotBrindeM);

    fltDifBrinde := (fltTotBrindeMes + fltTotBrinde) - fCfgSis('LIMBRN', varDouble);

    If (fltDifBrinde > 0) Then
    Begin
      objLiberacao := TLiberacao.Create;
      try
        objLiberacao.objMsgLibera.pAddTexto('Limite para emissão de brindes ultrapassado', alCentro, teAmbos, '', 85);
        objLiberacao.objMsgLibera.pAddSeparador(85);
        objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  , strCodCli + '-' + Copy(strCliNom,1,65), 8);
        objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor' , strCodVen + '-' + Copy(strNomVen,1,70), 8);
        objLiberacao.objMsgLibera.pAddSeparador(85);
        objLiberacao.objMsgLibera.pAddTextoCaption('Brindes emitidos este mês'              , FormatFloat('###,###,##0.00', fltTotBrindeMes), 40, alDireita, teAmbos, '', 14);
        objLiberacao.objMsgLibera.pAddTextoCaption('Este Brinde'                            , FormatFloat('###,###,##0.00', fltTotBrinde)   , 40, alDireita, teAmbos, '', 14);
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor que ultrapassará o limite máximo' , FormatFloat('###,###,##0.00', fltDifBrinde)   , 40, alDireita, teAmbos, '', 14);
        objLiberacao.objMsgLibera.pAddSeparador(85);

        objLiberacao.strDirAce := 'SELMBR';
        objLiberacao.strSenLib := fCfgSis('SELMBR');
        objLiberacao.strMsgSen := 'Liberação do(s) Brinde(s)';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom;


        Result := (Not fFatMensagemLiberacao(objLiberacao));

      finally
        FreeAndNil(objLiberacao);
      end;

    End;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[fExcedeValorLimiteBrindesMes]');
      Result := True;
    End;
  End;
end;

