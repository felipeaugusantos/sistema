      pLiberaDoctoParaExpedicaoAutomatico(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, arrDuplicata[intContador].strSequen);

      If (Not fEmptyStr(arrDuplicata[intContador].strAutIncGra)) Then
