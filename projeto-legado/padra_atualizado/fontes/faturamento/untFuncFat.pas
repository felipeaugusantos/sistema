    pCalculaPrecoCustoConcreto;
end;

procedure pBaixaPedidoNaoEntegue(strNumDoc, strCodEmp, strEspDoc: string);
var
  qryFatdor, qryExtdor: TUniQuery;
  strSQL: string;
begin
  try
    qryFatdor := fCriaQuery;
    qryExtdor := fCriaQuery;

    strSQL := 'UPDATE EXTDOR SET FDO_INCFUT = NULL WHERE FDO_SEQFDO = :AUTOINCREM';

    qryFatdor.Close;
    qryFatdor.SQL.Clear;
    qryFatdor.SQL.Add('SELECT D.AUTOINCREM FROM FATGOR G');
    qryFatdor.SQL.Add('INNER JOIN FATDOR D');
    qryFatdor.SQL.Add('ON(G.AUTOINCREM = D.FDO_SEQGER)');
    qryFatdor.SQL.Add('WHERE G.FGO_NUMDOC = :NUMDOC');
    qryFatdor.SQL.Add('AND G.FGO_CODEMP = :CODEMP');
    qryFatdor.SQL.Add('AND G.FGO_ESPDOC = :ESPDOC');

    qryFatdor.ParamByName('NUMDOC').AsString := strNumDoc;
    qryFatdor.ParamByName('CODEMP').AsString := strCodEmp;
    qryFatdor.ParamByName('ESPDOC').AsString := strEspDoc;

    qryFatdor.Open;

    qryExtdor.Close;
    qryExtdor.SQL.Clear;
    qryExtdor.SQL.Add(strSQL);

    while not qryFatdor.Eof do
    begin
      qryExtdor.Close;
      qryExtdor.ParamByName('AUTOINCREM').AsString := qryFatdor.FieldByName('AUTOINCREM').AsString;
      qryExtdor.ExecSQL;

      qryFatdor.Next;
    end;
  finally
    FreeAndNil(qryFatdor);
    FreeAndNil(qryExtdor);
  end;
end;

