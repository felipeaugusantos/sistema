procedure pAdicionarDirAceStringNTrava(strDirAce: String; Var strNTrava: String);
  Var
    strNTravaAux: String;
    i           : Integer;
    stlTravas   : TStrings;
begin
  //***************************************//
  // TRATAMENTO DAS TRAVAS CONFIGURADAS    //
  //************************************RL*//
  Try
    stlTravas := TStringList.Create;
    stlTravas.Add('LIMCR');
    stlTravas.Add('COMPR');
    stlTravas.Add('PRMIN4');
    stlTravas.Add('VEMIN4');
    stlTravas.Add('DEATR');
    stlTravas.Add('MARGE');
    stlTravas.Add('CONCC');
    stlTravas.Add('VLCRE');
    stlTravas.Add('VLCRE');
    stlTravas.Add('AGLIB');
    stlTravas.Add('BOFIN');
    stlTravas.Add('AGBOM');
    stlTravas.Add('CLCDCB');
    stlTravas.Add('LIBCHT');
    stlTravas.Add('LIBPSE');

    //***************************************//
    // VERIFICA SE A TRAVA QUE ESTÁ SENDO    //
    // PASSADA NO PARÂMETRO strDirAce        //
    // ESTÁ NA LISTA DE TRAVAS stlTravas.    //
    // SE SIM, ENTÃO, GRAVA O CARACTER "S"   //
    // NA VARIÁVEL strNTravaAux, SENÃO,      //
    // GRAVA "N"                             //
    //************************************RL*//
    For i := 0 to Length(strNTrava) - 1 Do
      If i <= stlTravas.Count - 1 Then
      Begin
        If strNTrava[i+1] = 'S' Then
          strNTravaAux := strNTravaAux + 'S'
        Else
          If stlTravas.Strings[i] = strDirAce Then
            strNTravaAux := strNTravaAux + 'S'
          Else
            strNTravaAux := strNTravaAux + 'N';
      End
      Else
        strNTravaAux := strNTravaAux + 'N';

    strNTrava := strNTravaAux;
  Finally
    FreeAndNil(stlTravas);
  End;
end;

procedure pRemoverDirAceStringNTrava(strDirAce: String; Var strNTrava: String);
  Var
    i: Integer;
    stlTravas: TStringList;
    strNTravaAux: String;
begin
  Try
    stlTravas := TStringList.Create;
    stlTravas.Add('LIMCR');
    stlTravas.Add('COMPR');
    stlTravas.Add('PRMIN4');
    stlTravas.Add('VEMIN4');
    stlTravas.Add('DEATR');
    stlTravas.Add('MARGE');
    stlTravas.Add('CONCC');
    stlTravas.Add('VLCRE');
    stlTravas.Add('VLCRE');
    stlTravas.Add('AGLIB');
    stlTravas.Add('BOFIN');
    stlTravas.Add('AGBOM');
    stlTravas.Add('CLCDCB');
    stlTravas.Add('LIBCHT');
    stlTravas.Add('LIBPSE');

    For i := 0 to Length(strNTrava) - 1 Do
      If i <= stlTravas.Count - 1 Then
      Begin
        If stlTravas.Strings[i] = strDirAce Then
          strNTravaAux := strNTravaAux + 'N'
        Else
          strNTravaAux := strNTravaAux + strNTrava[i+1]
      End
      Else
        strNTravaAux := strNTravaAux + 'N';

    strNTrava := strNTravaAux;
  Finally
    FreeAndNil(stlTravas);
  End;
end;

