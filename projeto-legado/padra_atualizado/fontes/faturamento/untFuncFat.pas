      itemFrete.fltAlqOrS := FieldByName('ABF_ALQICM' + strTipAbf).AsFloat;
      itemFrete.fltAlq__S := FieldByName('ABF_ALQICM' + strTipAbf).AsFloat;
      itemFrete.fltAlIStS := FieldByName('ABF_ALQRET' + strTipAbf).AsFloat;
      itemFrete.strMenFis := FieldByName('ITE_MENFIS').AsString;
      itemFrete.fltAlq__E := FieldByName('ABF_ALQICM_ENT_PEJ').AsFloat;

      If fCfgSis('IMPPAG', varInteger) = 1 Then
        itemFrete.fltPeImPg := FieldByName('ABF_PEIMPG').AsFloat
      Else
      Begin

        ValorAliquotaIBPT := TCadIBPT.fBuscaAlqIBPT(fTiraCaracEspeciais(FieldByName('ITE_CLAIPI').AsString), FieldByName('ITE_EXCIPI').AsString);

        itemFrete.fltPeImFd := IIF((LeftStr(FieldByName('ABF_CODSIT' + strTipAbf).AsString,1) <> '0'), ValorAliquotaIBPT.fltImportado, ValorAliquotaIBPT.fltNacional);
        itemFrete.fltPeImEs := ValorAliquotaIBPT.fltEstadual;
        itemFrete.fltPeImMn := ValorAliquotaIBPT.fltMunicipal;

      End;

      itemFrete.strCodSit := FieldByName('ABF_CODSIT' + strTipAbf).AsString;
      itemFrete.fltBas__S := FieldByName('ABF_BASICM' + strTipAbf).AsFloat;
      itemFrete.fltBasSTS := FieldByName('ABF_BASRET' + strTipAbf).AsFloat;

      If (strZonFra = 'S') Or fDocumentoParaFornecedor Then
      Begin
        itemFrete.strMen__S := '';
      End
      Else
      Begin
        if (FieldByName('ABF_IMPMSG').AsInteger = 0) OR (fTemMensagemParaCFOP(FieldByName('AUTOINCREM').AsString, strClaFis)) then
        begin
          If Not fEmptyStr(strCliImp) Then
            itemFrete.strMen__S := FieldByName('ABF_MENPR1' + strTipAbf).AsString + ' ' + FieldByName('ABF_MENPR2' + strTipAbf).AsString
          Else
            itemFrete.strMen__S := FieldByName('ABF_MENS01' + strTipAbf).AsString + ' ' + FieldByName('ABF_MENS02' + strTipAbf).AsString;
        end;
      End;

      itemFrete.strClaIpi := FieldByName('ITE_CLAIPI').AsString;

      itemFrete.strTabPre := strTabPre;
      itemFrete.fltPreVe1 := fltValFre;
      itemFrete.fltPreVe2 := fltValFre;
      itemFrete.fltPreVe3 := fltValFre;
      itemFrete.fltPreVe4 := fltValFre;
      itemFrete.fltPreVe5 := fltValFre;
      itemFrete.fltPreVe6 := fltValFre;
      itemFrete.fltPreVe7 := fltValFre;

      itemFrete.strEmpPrd := VS_strCodEmp;
      itemFrete.strEmpIte := VS_strCodEmp;

      itemFrete.opcTipAbs := oaTodos;
      
      {*******************************************************************************}
      {* CASO NAO HAJA DESMEMBRAMENTO ENTAO DEFINE O MESMO TIPO DE ENTREGA/RETIRA DO *}
      {* PRIMEIRO PRODUTO ENCONTRADO NO CUPOM FISCAL...                              *}
      {****************************************************************************JC*}
      If (Not fHaveraDesmembramentoVenda(arrMatItens)) And (Length(arrMatItens) > 0) Then
      Begin
        itemFrete.strEntRet := arrMatItens[0].strEntRet;
        itemFrete.strLocRet := arrMatItens[0].strLocRet;
        itemFrete.strEntFut := arrMatItens[0].strEntFut;
      End;

      SetLength(arrMatItens, Length(arrMatItens) + 1);
      arrMatItens[Length(arrMatItens) - 1] := itemFrete;

      Self.fltValFre := 0.00;
    End;

  End;

  FreeAndNil(qryItemFrete);

end;

procedure TFatVenda.pRemoveItemTaxaBombeamento;
  Var
    Item: TDadosFechamento;
    arrMatNov: TMatrizFechamento;

  procedure pAddItem(Var arrItens: TMatrizFechamento);
  begin
    SetLength(arrItens, Length(arrItens) + 1);
    arrItens[Length(arrItens) -1] := item;
  end;

begin
  SetLength(arrMatNov, 0);

  For Item In arrMatItens Do
    If (item.strCodIte <> fCfgSis('ITEBOM')) And
       (item.strCodIte <> fCfgSis('ITEMAN')) And
       (item.strCodIte <> fCfgSis('ITELAN')) And
       (item.strCodIte <> fCfgSis('ITETAX')) Then
    Begin
      pAddItem(arrMatNov);
    End;

  SetLength(arrMatItens, 0);

  For Item In arrMatNov Do
    pAddItem(arrMatItens);
end;

procedure TFatVenda.pCarregaTaxaBombeamentoPedOrc;
  Var
    qryItem: TUniQuery;
begin
  If Not (blnTaxaBombeamentoPedOrc Or (strOpcDoc = 'CN')) Then
    Exit;

  qryItem := fCriaQuery;

  With qryItem, SQL Do
  Begin
    Close;
    Clear;

    Add('SELECT FDO_CODITE, FDO_QTDITE, FDO_UNITAR, FDO_TOTITE, EXTGOR.FGO_CCROBR, EXTGOR.FGO_CCRART, EXTGOR.FGO_CODCNO, EXTGOR.FGO_INSIMO, EXTGOR.FGO_CODCIB ');
    Add('FROM FATDOR');
    Add('INNER JOIN FATGOR ON (FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER)');
    Add('INNER JOIN EXTGOR ON (EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM)');
    Add('WHERE FDO_NUMDOC = :NUMDOC AND');
    Add('      FDO_ESPDOC = :ESPDOC AND');
    Add('      FDO_CODEMP = :CODEMP AND');
    Add('      FDO_CODITE IN (:ITEBOM, :ITETAX, :ITEMAN, :ITELAN)');

    If (strOpcDoc = 'CN') Then
    Begin
      ParamByName('NUMDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_NUM_PD').AsString;
      ParamByName('ESPDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_ESP_PD').AsString;
      ParamByName('CODEMP').AsString := qryTemporariaConfirmacao.FieldByName('TMP_EMP_PD').AsString;
    End
    Else
    Begin
      ParamByName('NUMDOC').AsString := strNumOrc;
      ParamByName('ESPDOC').AsString := strEspOrc;
      ParamByName('CODEMP').AsString := strEmpOri;
    End;

    ParamByName('ITEBOM').AsString := fCfgSis('ITEBOM');
    ParamByName('ITETAX').AsString := fCfgSis('ITETAX');
    ParamByName('ITEMAN').AsString := fCfgSis('ITEMAN');
    ParamByName('ITELAN').AsString := fCfgSis('ITELAN');

    Open;

    If Not IsEmpty Then
    Begin

      Self.fltQtdBom := FieldByName('FDO_QTDITE').AsFloat;
      Self.fltPrcBom := FieldByName('FDO_UNITAR').AsFloat;
      Self.fltTotBom := FieldByName('FDO_TOTITE').AsFloat;

      If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      Begin

        If (FieldByName('FDO_CODITE').AsString = fCfgSis('ITEMAN')) Or (FieldByName('FDO_CODITE').AsString = fCfgSis('ITELAN')) Then
          Self.tbIteBom := tbItemBombeamento
        Else
          Self.tbIteBom := tbTaxaMinima;

        If Not FieldByName('FGO_CCROBR').AsString.IsEmpty Then
          Self.strCodObr := FieldByName('FGO_CCROBR').AsString;

        If Not FieldByName('FGO_CCRART').AsString.IsEmpty Then
          Self.strCodArt := FieldByName('FGO_CCRART').AsString;

        If Not FieldByName('FGO_CODCNO').AsString.IsEmpty Then
          Self.strCodCno := FieldByName('FGO_CODCNO').AsString;

        If Not FieldByName('FGO_INSIMO').AsString.IsEmpty Then
          Self.strInsImo := FieldByName('FGO_INSIMO').AsString;

        If Not FieldByName('FGO_CODCIB').AsString.IsEmpty Then
          Self.strCodCib := FieldByName('FGO_CODCIB').AsString;

      End
      Else
      Begin

        If (FieldByName('FDO_CODITE').AsString = fCfgSis('ITEBOM')) Then
          Self.tbIteBom := tbItemBombeamento
        Else
          Self.tbIteBom := tbTaxaMinima;

      End;

    End;

  End;

  FreeAndNil(qryItem);
end;

procedure TFatVenda.pInsereItemTaxaBombeamento(item: TTipItemBombeamento);
  Var
    qryItemBombeamento: TUniQuery;
    itemBombeamento: TDadosFechamento;
    strTipAbf: String;
    ValorAliquotaIBPT: TValorAliquotaIBPT;
begin

  If Self.fltTotBom <= 0 Then
    Exit;

  strTipAbf := Self.GetTipAbf('', OpcItensNFespTinta);

  qryItemBombeamento := fCriaQuery;

  With qryItemBombeamento, SQL Do
  Begin
    Close;
    Clear;

    Add(' SELECT SQL_NO_CACHE ');
    Add('   A.*, ');
    Add('   C.ITE_CODGRU, ');
    Add('   C.ITE_CODITE, ');
    Add('   C.ITE_DESITE, ');
    Add('   C.ITE_REFERE, ');
    Add('   C.ITE_CODMAR, ');
    Add('   C.ITE_CODUNI, ');
    Add('   U.UNI_SIGUNI, ');
    Add('   C.ITE_CODFOR, ');
    Add('   C.ITE_CLAIPI, ');
    Add('   C.ITE_EXCIPI, ');
    Add('   C.ITE_MENFIS  ');
    Add(' FROM ');
    Add('   CADITE C ');
    Add('   INNER JOIN ITEGER I ON I.ITE_CODITE = C.ITE_CODITE AND I.ITE_CODEMP = :CODEMP ');
    Add('   INNER JOIN CADUNI U ON U.UNI_CODUNI = C.ITE_CODUNI');

    If fCfgSis('TIPABF') = '1' Then
      Add('   INNER JOIN ABFICM A ON A.ABF_CODABF = C.ITE_CODABF AND A.ABF_ESTADO = :ESTADO ')
    Else
      Add('   INNER JOIN ABFICM A ON A.ABF_CODABF = I.ITE_CODABF AND A.ABF_ESTADO = :ESTADO ');

    Add(' WHERE ');
    Add('   C.ITE_CODITE = :CODITE ');

    If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
    Begin

      If (item = tbItemBombeamento) Then
      Begin

        {Bomba Mangote}
        If (strTipBom = 'M') Then
          ParamByName('CODITE').AsString := fCfgSis('ITEMAN')
        Else
        {Bomba Lança}
        If (strTipBom = 'L') Then
          ParamByName('CODITE').AsString := fCfgSis('ITELAN');

      End Else
        ParamByName('CODITE').AsString := fCfgSis('ITETAX');

    End
    Else
    Begin

      If (item = tbItemBombeamento) Then
        ParamByName('CODITE').AsString := fCfgSis('ITEBOM')
      Else
        ParamByName('CODITE').AsString := fCfgSis('ITETAX');

    End;

    ParamByName('CODEMP').AsString := fGetEmpCalculoItem('');

    If fDentroDoEstado('') Then
      ParamByName('ESTADO').AsString := fGetUFEmpresa('')
    Else
      ParamByName('ESTADO').AsString := strCliEst;

    Open;

    If Not IsEmpty Then
    Begin
      pRemoveItemTaxaBombeamento;

      itemBombeamento.intAutInc := -1;

      itemBombeamento.strCodIte := FieldByName('ITE_CODITE').AsString;
      itemBombeamento.strCodGru := FieldByName('ITE_CODGRU').AsString;
      itemBombeamento.strCodMar := FieldByName('ITE_CODMAR').AsString;
      itemBombeamento.strDesIte := FieldByName('ITE_DESITE').AsString;
      itemBombeamento.strDesOri := FieldByName('ITE_DESITE').AsString;
      itemBombeamento.strRefere := '';
      itemBombeamento.strCodUni := FieldByName('ITE_CODUNI').AsString;
      itemBombeamento.strUnidad := FieldByName('ITE_CODUNI').AsString;
      itemBombeamento.strSigUni := FieldByName('UNI_SIGUNI').AsString;
      itemBombeamento.strCodFor := FieldByName('ITE_CODFOR').AsString;
      itemBombeamento.strIdePro := 'NOR';

      itemBombeamento.fltUniTar := fltPrcBom;
      itemBombeamento.fltUniOri := fltPrcBom;
      itemBombeamento.fltUniVis := fltPrcBom;
      itemBombeamento.fltTaxJur := 0;
      itemBombeamento.fltUniTmp := fltPrcBom;
      itemBombeamento.fltUniDig := fltPrcBom;

      itemBombeamento.fltQtdIte := fltQtdBom;
      itemBombeamento.fltTotIte := fltTotBom;
      itemBombeamento.strEntSai := 'S';

      itemBombeamento.fltCusIte := 0;
      itemBombeamento.fltPreCus := 0;
      itemBombeamento.fltTotCus := 0;
      itemBombeamento.fltPreCu2 := 0;
      itemBombeamento.fltTotCu2 := 0;

      itemBombeamento.fltPreMed := 0;
      itemBombeamento.fltTotMed := 0;

      itemBombeamento.fltTotUlt := 0;
      itemBombeamento.fltImpUlt := 0;
      itemBombeamento.fltTotImp := 0;

      itemBombeamento.strClaFis := strClaFis;

      itemBombeamento.strCodMen := FieldByName('ABF_CODABF').AsString;
      itemBombeamento.strCodAbf := FieldByName('ABF_CODABF').AsString;
      itemBombeamento.strCodFis := FieldByName('ABF_CODSIT' + strTipAbf).AsString;
      itemBombeamento.fltAlqOrS := FieldByName('ABF_ALQICM' + strTipAbf).AsFloat;
      itemBombeamento.fltAlq__S := FieldByName('ABF_ALQICM' + strTipAbf).AsFloat;
      itemBombeamento.fltAlIStS := FieldByName('ABF_ALQRET' + strTipAbf).AsFloat;
      itemBombeamento.strMenFis := FieldByName('ITE_MENFIS').AsString;
      itemBombeamento.fltAlq__E := FieldByName('ABF_ALQICM_ENT_PEJ').AsFloat;

      If fCfgSis('IMPPAG', varInteger) = 1 Then
        itemBombeamento.fltPeImPg := FieldByName('ABF_PEIMPG').AsFloat
      Else
      Begin

        ValorAliquotaIBPT := TCadIBPT.fBuscaAlqIBPT(fTiraCaracEspeciais(FieldByName('ITE_CLAIPI').AsString), FieldByName('ITE_EXCIPI').AsString);

        itemBombeamento.fltPeImFd := IIF((LeftStr(FieldByName('ABF_CODSIT' + strTipAbf).AsString,1) <> '0'), ValorAliquotaIBPT.fltImportado, ValorAliquotaIBPT.fltNacional);
        itemBombeamento.fltPeImEs := ValorAliquotaIBPT.fltEstadual;
        itemBombeamento.fltPeImMn := ValorAliquotaIBPT.fltMunicipal;

      End;

      itemBombeamento.strCodSit := FieldByName('ABF_CODSIT' + strTipAbf).AsString;
      itemBombeamento.fltBas__S := FieldByName('ABF_BASICM' + strTipAbf).AsFloat;
      itemBombeamento.fltBasSTS := FieldByName('ABF_BASRET' + strTipAbf).AsFloat;

      If (strZonFra = 'S') Or fDocumentoParaFornecedor Then
      Begin
        itemBombeamento.strMen__S := '';
      End
      Else
      Begin
        if (FieldByName('ABF_IMPMSG').AsInteger = 0) OR (fTemMensagemParaCFOP(FieldByName('AUTOINCREM').AsString, strClaFis)) then
        begin
          If Not fEmptyStr(strCliImp) Then
            itemBombeamento.strMen__S := FieldByName('ABF_MENPR1' + strTipAbf).AsString + ' ' + FieldByName('ABF_MENPR2' + strTipAbf).AsString
          Else
            itemBombeamento.strMen__S := FieldByName('ABF_MENS01' + strTipAbf).AsString + ' ' + FieldByName('ABF_MENS02' + strTipAbf).AsString;
        end;
      End;

      itemBombeamento.strClaIpi := FieldByName('ITE_CLAIPI').AsString;

      itemBombeamento.strTabPre := strTabPre;
      itemBombeamento.fltPreVe1 := fltPrcBom;
      itemBombeamento.fltPreVe2 := fltPrcBom;
      itemBombeamento.fltPreVe3 := fltPrcBom;
      itemBombeamento.fltPreVe4 := fltPrcBom;
      itemBombeamento.fltPreVe5 := fltPrcBom;
      itemBombeamento.fltPreVe6 := fltPrcBom;
      itemBombeamento.fltPreVe7 := fltPrcBom;

      itemBombeamento.strEmpPrd := VS_strCodEmp;
      itemBombeamento.strEmpIte := VS_strCodEmp;

      {*******************************************************************************}
      {* CASO NAO HAJA DESMEMBRAMENTO ENTAO DEFINE O MESMO TIPO DE ENTREGA/RETIRA DO *}
      {* PRIMEIRO PRODUTO ENCONTRADO NO DOCUMENTO...                                 *}
      {****************************************************************************JC*}
      If (Not fHaveraDesmembramentoVenda(arrMatItens)) And (Length(arrMatItens) > 0) Then
      Begin
        itemBombeamento.strEntRet := arrMatItens[0].strEntRet;
        itemBombeamento.strLocRet := arrMatItens[0].strLocRet;
        itemBombeamento.strEntFut := arrMatItens[0].strEntFut;
      End;

      SetLength(arrMatItens, Length(arrMatItens) + 1);
      arrMatItens[Length(arrMatItens) - 1] := itemBombeamento;

      Self.fltQtdBom := 0.00;
      Self.fltPrcBom := 0.00;
      Self.fltTotBom := 0.00;

    End;

  End;

  FreeAndNil(qryItemBombeamento);

end;

function TFatVenda.fExisteBaixaBoletosDocumentos: Boolean;
var
  qryDados: TUniQuery;
  strSalvaFiltroDocumentosCuponsMarcados: String;
begin
  Result := False;
  qryDados := fCriaQuery;
  Try
    qryDados.Close;
    qryDados.SQL.Text := 'SELECT CADREC.AUTOINCREM FROM CADREC '
                       + ' INNER JOIN MOVGER ON GER_CODCLI = CTR_CODCLI '
                       + '                  AND GER_NUMDOC = CTR_NUMDUP '
                       + '                  AND GER_ESPDOC = CTR_ESPDOC '
                       + '                  AND GER_CODEMP = CTR_CODEMP '
                       + '                  AND GER_ORIDOC = "V" '
                       + '                  AND GER_TIP_FC = "C" '
                       + ' WHERE CTR_DTAREC IS NOT NULL '
                       + '   AND CTR_NUMDUP = :NUMDUP '
                       + '   AND CTR_ESPDOC = :ESPDOC '
                       + '   AND CTR_CODEMP = :CODEMP '
                       + '   AND CTR_CODCLI = :CODCLI ';

    strSalvaFiltroDocumentosCuponsMarcados := qryTemporariaConfirmacao.Filter;
    qryTemporariaConfirmacao.Close;
    qryTemporariaConfirmacao.Filter := 'MARDES = '+QuotedStr('M');
    qryTemporariaConfirmacao.Open;

    qryTemporariaConfirmacao.First;
    While Not qryTemporariaConfirmacao.Eof Do
    Begin
      qryDados.Close;
      qryDados.ParamByName('NUMDUP').AsString := qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString;
      qryDados.ParamByName('ESPDOC').AsString := qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString;
      qryDados.ParamByName('CODEMP').AsString := qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString;
      qryDados.ParamByName('CODCLI').AsString := qryTemporariaConfirmacao.FieldByName('TMP_CODCLI').AsString;
      qryDados.Open;

      If Not qryDados.IsEmpty Then
        Exit(True);

      qryTemporariaConfirmacao.Next;
    End;
  Finally
    FreeAndNil(qryDados);

    qryTemporariaConfirmacao.Close;
    qryTemporariaConfirmacao.Filter := strSalvaFiltroDocumentosCuponsMarcados;
    qryTemporariaConfirmacao.Open;
    qryTemporariaConfirmacao.First;
  End;
end;

procedure TFatVenda.pAgruparDuplicatasEmitemBoleto;
  Var
    intContador: Integer;
    documento  : TDadosImpressaoVenda;
    frmAgrupDuplicatas : TfrmAgrupDuplicatas;
    strChaLck,
    strSalvaFiltroDocumentosCuponsMarcados: String;

  function fGetCondicaoPagamentoAgrupamento: String;
    Var
      intParc: Integer;
  begin
    Result := Self.strConPag;

    If (Copy(Result, 3, 3) = '000') And (fStatusCndPag(Result) = A_PRAZO) Then
    Begin
      intParc := StrToIntDef(LeftStr(Result, 2), 1);
      System.Delete(Result, 1, 5);
      Result := fStrZero(IntToStr(intParc -1), 2) + Result;
    End;

  end;

  Function fMesmoCliente(arr: Array Of TDocAgrupamento): Boolean;
    Var
      intCont  : Integer;
      strCodCli: String;
  Begin
    Result := True;

    If Length(arr) > 0 Then
      strCodCli := arr[0].strCodCli;

    For intCont := Low(arr) To High(arr) Do
    Begin
      If strCodCli <> arr[intCont].strCodCli Then
      Begin
        Result := False;
        Break;
      End;
    End;
  End;
begin

  Try
    pCriarFormularios(TfrmAgrupDuplicatas, frmAgrupDuplicatas);

    With frmAgrupDuplicatas Do
    Begin
      strCondicaoNotaAvulsa := fGetCondicaoPagamentoAgrupamento;
      strPortadorNotaAvulsa := Self.strCodPor;

      SetLength(arrDocsAgrupar, 0);

      If fConfirmacaoCupomAgrupandoCadRecCupons Then
      Begin
        Try
          strSalvaFiltroDocumentosCuponsMarcados := qryTemporariaConfirmacao.Filter;
          qryTemporariaConfirmacao.Close;
          qryTemporariaConfirmacao.Filter := 'MARDES = '+QuotedStr('M');
          qryTemporariaConfirmacao.Open;

          qryTemporariaConfirmacao.First;
          While Not qryTemporariaConfirmacao.Eof Do
          Begin
            SetLength(arrDocsAgrupar, Length(arrDocsAgrupar) + 1);
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strNumDoc := qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString;
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strEspDoc := qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString;
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strCodEmp := qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString;
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strCodCli := qryTemporariaConfirmacao.FieldByName('TMP_CODCLI').AsString;

            strChaLck := 'CADREC' +
                         qryTemporariaConfirmacao.FieldByName('TMP_NUMDOC').AsString +
                         qryTemporariaConfirmacao.FieldByName('TMP_ESPDOC').AsString +
                         qryTemporariaConfirmacao.FieldByName('TMP_CODEMP').AsString +
                         qryTemporariaConfirmacao.FieldByName('TMP_CODCLI').AsString;

            If Not fEmptyStr(fGetHostLock(strChaLck + '%')) Then
              objLock.fLock_Unlock(strChaLck, False);

            qryTemporariaConfirmacao.Next;
          End;
        Finally
          qryTemporariaConfirmacao.Close;
          qryTemporariaConfirmacao.Filter := strSalvaFiltroDocumentosCuponsMarcados;
          qryTemporariaConfirmacao.Open;
          qryTemporariaConfirmacao.First;
        End;
      End
      Else
      Begin
        For intContador := 0 To objFatVendaImp.ItemsCount -1 Do
        Begin
          documento := objFatVendaImp[intContador];

          If objFatVendaImp.fVerificaSeImprimeBoleto(documento) Then
          Begin
            SetLength(arrDocsAgrupar, Length(arrDocsAgrupar) + 1);
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strNumDoc := documento.strNumDoc;
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strEspDoc := documento.strESpDoc;
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strCodEmp := documento.strEmpDoc;
            arrDocsAgrupar[Length(arrDocsAgrupar) - 1].strCodCli := documento.strCodCli;
          End;
        End;
      End;

      If Length(arrDocsAgrupar) > 1 Then
      Begin
        frmAgrupDuplicatas.blnAtivarTransacaoNaGravacaoAgrupamento := False;
        frmAgrupDuplicatas.blnUsouValDupOriComDesmembramento := Self.blnUsouValDupOriComDesmembramento;
        frmAgrupDuplicatas.blnFatVen := True;
        frmAgrupDuplicatas.ShowModal;
      End;
    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;

  pFreeAndNil(frmAgrupDuplicatas);

end;

function TFatVenda.fPermiteDevolverTintaMaquina(strCodAca : String = '';
                                                strEmpAca : String = '';
                                                strNumDoc : String = '';
                                                strEspDoc : String = '';
                                                strEmpDoc : String = '';
                                                fltQtdIte : Double = 0) : Boolean;
Var
  objLiberacao      : TLiberacao;
  blnInformacoes,
  blnProdutoAcabado : Boolean;
  qryAux            : TUniQuery;

  objMsg    : TMensagemLiberacao;
  objTabela : TRegistroMsgLiberaTabela;
  objLinha  : TLinhaMsgLibera;

  function fGetSQL(blnAcabado : Boolean = False) : String;
  begin

    Result := 'SELECT                  ' +
              '  DET_CODACA AS CODACA, ' +
              '  DET_EMPACA AS EMPACA, ' +
              '  DET_DESCRI AS DESCRI, ' +
              '  DET_IDEPRO AS IDEPRO, ' +
              '  DET_QTDITE AS QTDITE, ' +
              '  DET_UNITAR AS UNITAR, ' +
              '  DET_TOTITE AS TOTITE  ' +
              'FROM     ' +
              '  TABELA ' +
              'WHERE DET_CODACA IS NOT NULL ' +
              '  AND DET_NUMDOC = :NUMDOC   ' +
              '  AND DET_ESPDOC = :ESPDOC   ' +
              '  AND DET_CODEMP = :CODEMP   ';

    If (blnAcabado) Then
      Result := Result +
              '  AND DET_CODACA = :CODACA   ' +
              '  AND DET_EMPACA = :EMPACA   ';

  end;

begin

  Result := False;

  If Not fCfgSis('DEVTIN', varBoolean) Then
    Exit;

  blnInformacoes := Not fEmptyStr(strNumDoc) And
                    Not fEmptyStr(strEspDoc) And
                    Not fEmptyStr(strEmpDoc);

  blnProdutoAcabado := Not fEmptyStr(strCodAca) And
                       Not fEmptyStr(strEmpAca);

  objLiberacao := TLiberacao.Create;
  objTabela    := Nil;

  Try

    objLiberacao.Clear;

    If (blnInformacoes) Then
    Begin

      qryAux := fCriaQuery();

      Try

        qryAux.Close;
        qryAux.SQL.Clear;
        qryAux.SQL.Add(StringReplace(fGetSQL(blnProdutoAcabado), 'TABELA', 'MOVDET', [rfReplaceAll]));
        qryAux.SQL.Add('UNION ALL');
        qryAux.SQL.Add(StringReplace(fGetSQL(blnProdutoAcabado), 'TABELA', 'NOTDET', [rfReplaceAll]));

        qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
        qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
        qryAux.ParamByName('CODEMP').AsString := strEmpDoc;

        If (blnProdutoAcabado) Then
        Begin
          qryAux.ParamByName('CODACA').AsString := strCodAca;
          qryAux.ParamByName('EMPACA').AsString := strEmpAca;
        End;

        qryAux.Open;

        If Not qryAux.IsEmpty Then
        Begin

          objTabela := TRegistroMsgLiberaTabela.Create;
          objLinha  := TLinhaMsgLibera.Create;

          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'Código'       , 10, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Descrição'    , 60, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Tinta'        , 10, alEsquerda, teAutcom);
          objLinha.pAddColuna('', 'Quantidade'   , 10, alDireita , teAutcom);
          objLinha.pAddColuna('', 'Vlr. Unitário', 15, alDireita , teAutcom);
          objLinha.pAddColuna('', 'Vlr. Total'   , 15, alDireita , teAutcom);
          objTabela.lstLinhas.Add(objLinha);

          qryAux.First;
          while not qryAux.Eof do
          begin

            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlValor;

            objLinha.pAddColuna('Código'    , qryAux.FieldByName('CODACA').AsString + '-' + qryAux.FieldByName('EMPACA').AsString, 10, alEsquerda);
            objLinha.pAddColuna('Descrição' , qryAux.FieldByName('DESCRI').AsString, 60, alEsquerda);
            objLinha.pAddColuna('Tinta'     , qryAux.FieldByName('IDEPRO').AsString, 10, alEsquerda);

            If (blnDevolucaoCompleta) Then
            Begin
              objLinha.pAddColuna('Quantidade'   , FloatToStrf(qryAux.FieldByName('QTDITE').AsFloat, ffFixed, 11, fCfgSis('DECQTD', varInteger)), 10, alDireita);
              objLinha.pAddColuna('Vlr. Unitário', FloatToStrf(qryAux.FieldByName('UNITAR').AsFloat, ffFixed, 11, 2), 15, alDireita);
              objLinha.pAddColuna('Vlr. Total'   , FloatToStrf(qryAux.FieldByName('TOTITE').AsFloat, ffFixed, 11, 2), 15, alDireita);
            End Else
            Begin
              objLinha.pAddColuna('Quantidade'   , FloatToStrf(fltQtdIte, ffFixed, 11, fCfgSis('DECQTD', varInteger)), 10, alDireita);
              objLinha.pAddColuna('Vlr. Unitário', FloatToStrf(qryAux.FieldByName('UNITAR').AsFloat, ffFixed, 11, 2),  15, alDireita);
              objLinha.pAddColuna('Vlr. Total'   , FloatToStrf(fltQtdIte * qryAux.FieldByName('UNITAR').AsFloat, ffFixed, 11, 2), 15, alDireita);
            End;

            objTabela.lstLinhas.Add(objLinha);
            qryAux.Next;
          end;

        End;

      Finally
        FreeAndNil(qryAux);
      End;

    End;

    objMsg := TMensagemLiberacao.Create(Self);
    objMsg.pAddTexto('Devolução de Tinta de Máquina.');
    objMsg.pAddTexto('Produto bloqueado por se tratar de Tinta de Máquina.');

    If Assigned(objTabela) Then
      objMsg.lstRegistros.Add(objTabela);

    objMsg.pAddQuebra(teAmbos);

    objLiberacao.objMsgLibera := objMsg;
    objLiberacao.strDirAce    := 'PDTINT';
    objLiberacao.strSenLib    := fCfgSis('SDVTIN');
    objLiberacao.strMsgSen    := 'Liberação para devolução de Tinta de Máquina(Devolução)';
    objLiberacao.strCodOpe    := strLoginUsuarioLogado;
    objLiberacao.strCodDig    := strLoginUsuarioLogado;
    objLiberacao.strCliente   := Self.strCodCli + '-' + Self.strCliNom;
    objLiberacao.strSequencialUnicoDtaHra := FSequencialUnicoDtaHrLogVar;

    Result := objLiberacao.fLibera;

  Finally
    FreeAndNil(objLiberacao);
  End;

end;

function TFatVenda.fTravaERegistraStlDocDevLck(strTabela, strNumDoc, strEspDoc, strCodEmp, strCodCli, strIncDev: String): Boolean;
  Var
    strAux: String;
    strTabLck: String;
    fltQtdJaDevolvidaAoCarre,
    fltQtdJaDevolvidaAoAgora: Double;
    stlCadRecLck: TStringList;
    strEstacao: String;
    intIdx: Integer;
begin
  Result := True;

  stlCadRecLck := TStringList.Create;
  Try
    strAux := 'DEV_'+ strNumDoc + strEspDoc + strCodEmp + strCodCli;
    strTabLck := fRetNomTabGer(strTabela);

    If (Pos(strOpcDoc, 'DV_PR_' ) > 0) And (Not fEmptyStr(strNumDoc+strEspDoc+strCodEmp+strCodCli)) And (stlDocDevLck.IndexOf(strAux) = -1) Then
    Begin
      If (stlDocDevTry.IndexOf(strAux) <> -1) Then
      Begin
        strEstacao := fGetHostLock(strAux);
        If fEmptyStr(strEstacao) Then
          strEstacao := 'outra estação';

        fMensagem('Atenção', 'Este documento ('+strNumDoc+'-'+strEspDoc+'-'+strCodEmp+') estava ou está sendo utilizado por '+strEstacao+'. '+
                             'Por favor, recarregue os documentos para verificar se o mesmo já foi devolvido, cancelado ou liberado.', ['&Ok']);
        Result := False;
      End
      Else If (Not fLock_Unlock(strAux, True, False)) Then
      Begin
        stlDocDevTry.Add(strAux);

        fMensagem('Atenção', 'Esse documento está sendo utilizado em outra estação por ' + fGetHostLock(strAux) + '!', ['&Ok']);
        Result := False;
      End
      Else If objLock.fDocumentoTravado(strTabLck, strNumDoc, strEspDoc, strCodEmp, strCodCli, stlCadRecLck) Then
      Begin
        fLock_Unlock(strAux, False, False); //NÃO CONSEGUIU TRAVAR AS CADREC ENTÃO DESTRAVA O LCK FEITO NA LINHA ACIMA
        stlDocDevTry.Add(strAux);

        Result := False;
      End
      Else
      Begin
        fltQtdJaDevolvidaAoCarre := fCampoTabela('IFNULL(SUM(DET_QTDCAR), 0)', Self.strTmpIteDev, ['DET_AUTOIN'], [strIncDev]); //quantidade ao carregar
        fltQtdJaDevolvidaAoAgora := fRetSomaQuantidadesJaDevolvidasComEsseAutInc(strIncDev);                                    //quantidade agora

        If (fltQtdJaDevolvidaAoCarre <> fltQtdJaDevolvidaAoAgora) Then
        Begin
          fMensagem('Atenção', 'Este documento ('+strNumDoc+'-'+strEspDoc+'-'+strCodEmp+') sofreu manipulação enquanto você fazia essa operação. '+
                               'Por favor, recarregue os documentos para verificar se o mesmo já foi devolvido ou liberado.', ['&Ok']);
          Result := False;

          stlDocDevLck.Add(strAux);
          For intIdx:=0 To stlCadRecLck.Count-1 Do
            stlDocDevLck.Add(stlCadRecLck[intIdx]);

          pDestravaELimpaStlDocDevLck(strTabela, strNumDoc, strEspDoc, strCodEmp, strCodCli);
        End
        Else
        Begin
          stlDocDevLck.Add(strAux);
          For intIdx:=0 To stlCadRecLck.Count-1 Do
            stlDocDevLck.Add(stlCadRecLck[intIdx]);
        End;
      End;
    End;
  Finally
    FreeAndNil(stlCadRecLck);
  End;
end;

