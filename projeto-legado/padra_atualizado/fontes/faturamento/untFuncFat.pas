    procedure pAtualizaTinDorBaixadoOrigem(strNumDoc, strEspDoc, strCodEmp: String);
      Var
        qryAux: TUniQuery;
        qryUpd: TUniQuery;
    begin
      qryAux := fCriaQuery;
      qryUpd := fCriaQuery;
      Try
        qryUpd.SQL.Text :=
             'UPDATE TINDOR ' +
                '   SET FDO_BAIXAD = :BAIXAD ' +
                '      ,FDO_IMPRES = :IMPRES ' +
                '      ,FDO_OPEBAI = :OPEBAI ' +
                '      ,FDO_HORBAI = :HORBAI ' +
                '      ,FDO_DTABAI = :DTABAI ' +
                ' WHERE AUTOINCREM = :AUTINC';

        qryAux.SQL.Text :=
             'SELECT TIN_ORI.FDO_BAIXAD, ' +
             '       TIN_ORI.FDO_IMPRES, ' +
             '       TIN_ORI.FDO_OPEBAI, ' +
             '       TIN_ORI.FDO_HORBAI, ' +
             '       TIN_ORI.FDO_DTABAI, ' +
             '                           ' +
             '       TIN_FAT.AUTOINCREM  ' +
             '                           ' +
             ' FROM FATDOR FDO_ORI       ' +
             '                           ' +
             '         INNER JOIN FATDOR FDO_AGP ON FDO_ORI.FDO_NUMFAT = FDO_AGP.FDO_NUMDOC ' +
             '                                  AND FDO_ORI.FDO_TIPFAT = FDO_AGP.FDO_ESPDOC ' +
             '                                  AND FDO_ORI.FDO_EMPFAT = FDO_AGP.FDO_CODEMP ' +
             '                                  AND FDO_ORI.FDO_CODACA = FDO_AGP.FDO_CODACA ' +
             '                                                                              ' +
             '         INNER JOIN FATDOR FDO_FAT ON FDO_AGP.FDO_NUMFAT = FDO_FAT.FDO_NUMDOC ' +
             '                                  AND FDO_AGP.FDO_TIPFAT = FDO_FAT.FDO_ESPDOC ' +
             '                                  AND FDO_AGP.FDO_EMPFAT = FDO_FAT.FDO_CODEMP ' +
             '                                  AND FDO_AGP.FDO_CODACA = FDO_FAT.FDO_CODACA ' +
             '                                                                              ' +
             '         INNER JOIN TINDOR TIN_ORI ON FDO_ORI.FDO_NUMDOC = TIN_ORI.FDO_NUMDOC ' +
             '                                  AND FDO_ORI.FDO_ESPDOC = TIN_ORI.FDO_ESPDOC ' +
             '                                  AND FDO_ORI.FDO_CODEMP = TIN_ORI.FDO_CODEMP ' +
             '                                  AND FDO_ORI.FDO_CODACA = TIN_ORI.FDO_CODACA ' +
             '                                  AND FDO_ORI.FDO_EMPACA = TIN_ORI.FDO_EMPACA ' +
             '                                                                              ' +
             '         INNER JOIN TINDOR TIN_FAT ON FDO_FAT.FDO_NUMDOC = TIN_FAT.FDO_NUMDOC ' +
             '                                  AND FDO_FAT.FDO_ESPDOC = TIN_FAT.FDO_ESPDOC ' +
             '                                  AND FDO_FAT.FDO_CODEMP = TIN_FAT.FDO_CODEMP ' +
             '                                  AND FDO_FAT.FDO_CODACA = TIN_FAT.FDO_CODACA ' +
             '                                  AND FDO_FAT.FDO_EMPACA = TIN_FAT.FDO_EMPACA ' +
             '                                                                              ' +
             ' WHERE FDO_FAT.FDO_NUMDOC = :NUMDOC                                           ' +
             '   AND FDO_FAT.FDO_ESPDOC = :ESPDOC                                           ' +
             '   AND FDO_FAT.FDO_CODEMP = :CODEMP                                           ' +
             '   AND TIN_ORI.FDO_BAIXAD = 1                                                 ' +
             '   AND TIN_FAT.FDO_BAIXAD <> 1                                                ';

        qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
        qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
        qryAux.ParamByName('CODEMP').AsString := strCodEmp;
        qryAux.Open;

        If Not qryAux.IsEmpty Then
        Begin
          qryAux.First;
          While Not qryAux.Eof Do
          Begin
            qryUpd.ParamByName('BAIXAD').Value := qryAux.FieldByName('FDO_BAIXAD').Value;
            qryUpd.ParamByName('IMPRES').Value := qryAux.FieldByName('FDO_IMPRES').Value;
            qryUpd.ParamByName('OPEBAI').Value := qryAux.FieldByName('FDO_OPEBAI').Value;
            qryUpd.ParamByName('HORBAI').Value := qryAux.FieldByName('FDO_HORBAI').Value;
            qryUpd.ParamByName('DTABAI').Value := qryAux.FieldByName('FDO_DTABAI').Value;
            qryUpd.ParamByName('AUTINC').Value := qryAux.FieldByName('AUTOINCREM').Value;
            qryUpd.ExecSQL;

            qryAux.Next;
          End;
        End;
      Finally
        FreeAndNil(qryAux);
        FreeAndNil(qryUpd);
      End;
    end;

    procedure pAtualizaTinDorBaixado;
      Var
        qryAux: TUniQuery;
        intCont: Integer;
        strOpeBai: String;
        dtaDtaBai: TDate;
        strHorBai: String;
    begin

      If (Assigned(stlFormulacaoBaixada)) And
         (stlFormulacaoBaixada.Count > 0) Then
      Begin
        qryAux := fCriaQuery(Self);

        Try

          qryAux.SQL.Add('  UPDATE                                         ');
          qryAux.SQL.Add('    TINDOR                                       ');
          qryAux.SQL.Add('  SET                                            ');
          qryAux.SQL.Add('    FDO_BAIXAD = 1,                              ');
          qryAux.SQL.Add('    FDO_OPEBAI =:OPEBAI,                         ');
          qryAux.SQL.Add('    FDO_DTABAI =:DTABAI,                         ');
          qryAux.SQL.Add('    FDO_HORBAI =:HORBAI                          ');
          qryAux.SQL.Add('  WHERE CONCAT(FDO_CODACA, FDO_EMPACA) =:FORMUL  ');

          For intCont := 0 To stlFormulacaoBaixada.Count -1 Do
          Begin
            pRetornaDadosBaixaTindor(stlFormulacaoBaixada[intCont],
                                     strOpeBai,
                                     dtaDtaBai,
                                     strHorBai);

            qryAux.ParamByName('FORMUL').AsString := stlFormulacaoBaixada[intCont];
            qryAux.ParamByName('OPEBAI').AsString := strOpeBai;
            qryAux.ParamByName('DTABAI').AsDate   := dtaDtaBai;
            qryAux.ParamByName('HORBAI').AsString := strHorBai;

            qryAux.ExecSQL;
          End;

        Finally
          FreeAndNil(qryAux);
        End;

      End;
    end;

    procedure pAtualizaTinDorBaixadoPedidoOriginal;
      Var
        qryAux: TUniQuery;
        intCont: Integer;
        arrDadosBaixa: TStringDynArray;
    begin

      If (Assigned(stlDadosBaixaFormulacao)) And
         (stlDadosBaixaFormulacao.Count > 0) Then
      Begin
        qryAux := fCriaQuery(Self);

        Try

          qryAux.SQL.Add('  UPDATE                                         ');
          qryAux.SQL.Add('    TINDOR                                       ');
          qryAux.SQL.Add('  SET                                            ');
          qryAux.SQL.Add('    FDO_BAIXAD =:BAIXAD,                              ');
          qryAux.SQL.Add('    FDO_OPEBAI =:OPEBAI,                         ');
          qryAux.SQL.Add('    FDO_DTABAI =:DTABAI,                         ');
          qryAux.SQL.Add('    FDO_HORBAI =:HORBAI                          ');
          qryAux.SQL.Add('  WHERE CONCAT(FDO_CODACA, FDO_EMPACA) =:FORMUL  ');

          For intCont := 0 To stlFormulacaoBaixada.Count -1 Do
          Begin
            arrDadosBaixa := SplitString(stlDadosBaixaFormulacao[intCont], ';');

            qryAux.ParamByName('FORMUL').AsString := arrDadosBaixa[0];
            qryAux.ParamByName('OPEBAI').AsString := arrDadosBaixa[1];
            qryAux.ParamByName('DTABAI').AsDate   := StrToDate(arrDadosBaixa[2]);
            qryAux.ParamByName('HORBAI').AsString := arrDadosBaixa[3];
            qryAux.ParamByName('BAIXAD').AsString := arrDadosBaixa[4];

            qryAux.ExecSQL;
          End;

        Finally
          FreeAndNil(qryAux);
        End;

      End;
    end;

    procedure pAtualizaTinDorEtiImpressa;
    Var
      LQryAux: TUniQuery;
      LCont: Integer;
      LSql: String;
    Begin
      If (Assigned(stlFormulacaoEtiImpressa)) And
         (stlFormulacaoEtiImpressa.Count > 0) Then
      Begin
        Try
          LSql := '';
          LSql := LSql + ' UPDATE                     ';
          LSql := LSql + '   TINDOR                   ';
          LSql := LSql + ' SET                        ';
          LSql := LSql + '   FDO_IMPRES = :IMPRES     ';
          LSql := LSql + ' WHERE                      ';
          LSql := LSql + '  FDO_CODACA = :CODACA AND  ';
          LSql := LSql + '  FDO_EMPACA = :EMPACA      ';

          LQryAux := fCriaQuery(Self);
          LQryAux.Close;
          LQryAux.SQL.Clear;
          LQryAux.SQL.Add(LSql);

          For LCont := 0 To stlFormulacaoEtiImpressa.Count -1 Do
          Begin
            LQryAux.ParamByName('IMPRES').AsInteger := 1;
            LQryAux.ParamByName('CODACA').AsString := Copy(stlFormulacaoEtiImpressa[LCont], 1, Length(stlFormulacaoEtiImpressa[LCont]) - 3);
            LQryAux.ParamByName('EMPACA').AsString := Copy(stlFormulacaoEtiImpressa[LCont], (Length(stlFormulacaoEtiImpressa[LCont]) - 3) + 1, 3);
            LQryAux.ExecSQL;
          End;
        Finally
          If Assigned(LQryAux) Then
            FreeAndNil(LQryAux);
        End;
      End;
    End;

