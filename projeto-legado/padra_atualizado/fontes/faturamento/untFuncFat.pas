function TFatVenda.fValidaDadosNotaEletronica(AobjMatrizesFechamento : TMatrizesFechamento): Boolean;
var  LstlValidacaoDadosNFE : TStringList;
     LstrMensagemCestItens : string;
     LstrListaItens : string;
     SIdx : Integer;
     LstrCestItens : string;
begin
  Result := True;

  If (Not fDocumentoParaFornecedor) and (Not blnEspelhoDevolucaoCliente) Then
  Begin
    Try
      If Not fDadosClienteNFe(LstlValidacaoDadosNFE) Then
      Begin
        If (LstlValidacaoDadosNFE.Count > 0) Then
        Begin
          if not TfrmMultiConfirmacao.fMultiConfirmacao('Inconsistências nos dados para gerar a NFe', LstlValidacaoDadosNFE.Text) then
          begin
            FRespMsg := True;
            Result := False;
            Exit;
          end;
        End
        Else
        Begin
          FRespMsg := True;
          Result := False;
          Exit;
        End;
      End;

      LstrListaItens := '';
      For SIdx := Low(AobjMatrizesFechamento) To High(AobjMatrizesFechamento) Do
      begin
        LstrCestItens := fGetItensParaValidacaoCestItens(AobjMatrizesFechamento[SIdx]);

        if not fEmptystr(LstrCestItens) then
        begin
          if fEmptyStr(LstrListaItens) then
            LstrListaItens := LstrCestItens
          else
            LstrListaItens := LstrListaItens + ', ' + LstrCestItens;
        end;
      end;

      LstrMensagemCestItens := fValidaCestItens(LstrListaItens);
      if Trim(LstrMensagemCestItens) <> '' then
      begin
        if not TfrmMultiConfirmacao.fMultiConfirmacao('Inconsistências nos dados para gerar a NFe', LstrMensagemCestItens) then
        begin
          FRespMsg := True;
          Result := False;
          Exit;
        end;
      end;

    Finally
      If Assigned(LstlValidacaoDadosNFE) Then
        FreeAndNil(LstlValidacaoDadosNFE);
    End;
  End;
end;

function TFatVenda.fValidaDevolucaoComFreteSuperiorAoDocumentoOriginal: Boolean;
  Var
    LcdsClone              : TUniClientDataSet;
    LfltTotalFreteNosItens : Double;
    LfltTotalNosItens      : Double;
    LobjTabela             : TRegistroMsgLiberaTabela;
    LobjLinha              : TLinhaMsgLibera;
    LfltFreteCalculado,
    LfltFreteOriginal,
    LfltQuantidadeOriginal : Double;
    objLiberacao           : TLiberacao;
    LQuery                 : TUniquery;
begin
  Result := True;

  objLiberacao := TLiberacao.Create;
  LQuery       := fCriaQuery;

  Try
    LQuery.Sql.Text := ' SELECT D.DET_TOTFRE, D.DET_QTDITE, D.DET_DTAENT  '+
                       '   FROM MOVDET D '+
                       '  WHERE D.DET_NUMDOC = :NUMDOC '+
                       '    AND D.DET_ESPDOC = :ESPDOC '+
                       '    AND D.DET_CODEMP = :CODEMP '+
                       '    AND D.AUTOINCREM = :AUTINC '+
                       '   UNION                       '+
                       ' SELECT D.DET_TOTFRE, D.DET_QTDITE, D.DET_DTAENT '+
                       '   FROM NOTDET D '+
                       '  WHERE D.DET_NUMDOC = :NUMDOC '+
                       '    AND D.DET_ESPDOC = :ESPDOC '+
                       '    AND D.DET_CODEMP = :CODEMP '+
                       '    AND D.AUTOINCREM = :AUTINC ';

    objLiberacao.Clear;
    objLiberacao.objMsgLibera.pAddTexto('DEVOLUÇÃO COM FRETE SUPERIOR AO INFORMADO NOS DOCUMENTOS DE ORIGEM', alCentro, teAmbos, '', 105);
    objLiberacao.objMsgLibera.pAddSeparador(105);
    objLiberacao.objMsgLibera.pAddTexto('Isso vai gerar crédito no contas a receber superior ao valor da venda.', alEsquerda, teAmbos, '', 105);
    objLiberacao.objMsgLibera.pAddSeparador(105);
    objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  , Self.strCodCli + '-' + Self.strCliNom, 9);
    objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor' , Self.strCodVen + '-' + fRetNomVendRep(Self.strCodVen));
    objLiberacao.objMsgLibera.pAddSeparador(105);
    objLiberacao.objMsgLibera.pAddTextoCaption('Valor do Frete digitado nesta devolucao' , FormatFloat(fMskDigitos(Self.VS_intDecUni), Self.fltValFre));
    objLiberacao.objMsgLibera.pAddSeparador(105);
    objLiberacao.objMsgLibera.pAddTexto('', alEsquerda, teAmbos, '', 105);
    objLiberacao.objMsgLibera.pAddTexto('Documentos de origem:', alEsquerda, teAmbos, '', 105);

    LobjTabela := TRegistroMsgLiberaTabela.Create;

    LobjLinha  := TLinhaMsgLibera.Create;
    LobjLinha.enuTipoLinha := tlCabecalho;
    LobjLinha.pAddColuna(''  , 'Documento'  , 21 , alEsquerda , teAutcom);
    LobjLinha.pAddColuna(''  , 'Dt.Emissão' , 12 , alCentro   , teAutcom);
    LobjLinha.pAddColuna(''  , 'Produto'    , 40 , alEsquerda , teAutcom);
    LobjLinha.pAddColuna(''  , 'Vr.Produto' , 16 , alDireita  , teAutcom);
    LobjLinha.pAddColuna(''  , 'Vr.Frete'   , 16 , alDireita  , teAutcom);
    LobjTabela.lstLinhas.Add(LobjLinha);

    LcdsClone := TUniClientDataSet.Create(Self);
    pCloneDataSet(LcdsClone, cdsVenda);

    LfltTotalFreteNosItens := 0;
    LfltTotalNosItens      := 0;

    LcdsClone.First;
    While Not LcdsClone.Eof Do
    Begin
      LQuery.ParamByName('NUMDOC').AsString := LcdsClone.FieldByName('ITE_DOCDEV').AsString;
      LQuery.ParamByName('ESPDOC').AsString := LcdsClone.FieldByName('ITE_ESPDEV').AsString;
      LQuery.ParamByName('CODEMP').AsString := LcdsClone.FieldByName('ITE_EMPDEV').AsString;
      LQuery.ParamByName('AUTINC').AsString := LcdsClone.FieldByName('ITE_AIDVOR').AsString;
      LQuery.Open;

      LfltFreteOriginal      := Lquery.FieldByName('DET_TOTFRE').AsFloat;
      LfltQuantidadeOriginal := Lquery.FieldByName('DET_QTDITE').AsFloat;

      LfltFreteCalculado := (LfltFreteOriginal * LcdsClone.FieldByName('ITE_QTDITE').AsFloat)/LfltQuantidadeOriginal;

      LfltTotalFreteNosItens := LfltTotalFreteNosItens + LfltFreteCalculado;
      LfltTotalNosItens      := LfltTotalNosItens + LcdsClone.FieldByName('ITE_TOTITE').AsFloat;

      LobjLinha  := TLinhaMsgLibera.Create;
      LobjLinha.enuTipoLinha := tlValor;
      LobjLinha.pAddColuna('Documento'  , LcdsClone.FieldByName('ITE_DOCDEV').AsString + '-' +
                                          LcdsClone.FieldByName('ITE_ESPDEV').AsString + '-' +
                                          LcdsClone.FieldByName('ITE_EMPDEV').AsString , 21 , alEsquerda);
      LobjLinha.pAddColuna('Dt.Emissão' , FormatDateTime('dd/mm/yyyy', Lquery.FieldByName('DET_DTAENT').AsDateTime) , 12 , alCentro  );
      LobjLinha.pAddColuna('Produto'    , LcdsClone.FieldByName('ITE_CODITE').AsString + '-' +
                                          LcdsClone.FieldByName('ITE_DESITE').AsString   , 40 , alEsquerda);
      LobjLinha.pAddColuna('Vr.Produto',  FormatFloat(fMskDigitos(Self.VS_intDecUni), LcdsClone.FieldByName('ITE_TOTITE').AsFloat) , 16 , alDireita );
      LobjLinha.pAddColuna('Vr.Frete'   , FormatFloat(fMskDigitos(Self.VS_intDecUni), LfltFreteCalculado) , 16 , alDireita );

      LobjTabela.lstLinhas.Add(LobjLinha);

      LQuery.Close;

      LcdsClone.Next;
    End;

    LobjLinha  := TLinhaMsgLibera.Create;
    LobjLinha.enuTipoLinha := tlValor;
    LobjLinha.pAddColuna('', fReplicatorStr('-',113) , 113 , alCentro);
    LobjTabela.lstLinhas.Add(LobjLinha);

    LobjLinha  := TLinhaMsgLibera.Create;
    LobjLinha.enuTipoLinha := tlValor;
    LobjLinha.pAddColuna('Documento'  , 'TOTAL' , 21 , alCentro);
    LobjLinha.pAddColuna('Dt.Emissão' , '' , 12 , alCentro  );
    LobjLinha.pAddColuna('Produto'    , '' , 40 , alEsquerda);
    LobjLinha.pAddColuna('Vr.Produto',  FormatFloat(fMskDigitos(Self.VS_intDecUni), LfltTotalNosItens) , 16 , alDireita );
    LobjLinha.pAddColuna('Vr.Frete'   , FormatFloat(fMskDigitos(Self.VS_intDecUni), LfltTotalFreteNosItens) , 16 , alDireita );
    LobjTabela.lstLinhas.Add(LobjLinha);

    objLiberacao.objMsgLibera.lstRegistros.Add(LobjTabela);

    If fFormataFloat(Self.fltValFre,2) > fFormataFloat(LfltTotalFreteNosItens,2) Then
    begin
      objLiberacao.strDirAce := 'PERFRESUP';
      objLiberacao.strMsgSen := 'Devolução de Documentos';
      objLiberacao.strCodOpe := Self.strCodVen;
      objLiberacao.strCodDig := Self.strCodDig;
      objLiberacao.objMsgLibera.strTitulo := 'Devolução com Frete Superior ao Informado nos Documentos de Origem';

      If (Pos(strOpcDoc, 'DV_') > 0) And (fCfgSis('TRAZFR', varString) = '2') Then
      Begin
        fMensagem('', 'Devolução com frete superior ao informado nos documentos de origem não é permitido pois' +sLineBreak+
                      'esta operação vai gerar crédito no contas a receber superior ao valor da venda (CFG_TRAZFR).', ['&Ok']);
        Result := False;
      End
      Else
      Begin
        Result := Self.fFatMensagemLiberacao(objLiberacao);
      End;
    end;

  Finally
    FreeAndNil(LcdsClone);
    FreeAndNil(objLiberacao);
    FreeAndNil(LQuery);
  End;

end;

function TFatVenda.fValidaEspecieVendaPresencial(const strEspDoc: String; out strEspeciesPermitidas: String): Boolean;
begin
  Result := True;

  If Not blnVendaPresencial Then
    Exit;

  If Self.strOpcDoc = 'DV' Then
    Exit;

  strEspeciesPermitidas := fCfgSis('ESPVPR');

  If fEmptyStr(strEspeciesPermitidas) Then
    Exit;

  strEspeciesPermitidas := fTransform(strEspeciesPermitidas, 2, ',').TrimRight([',']);
  Result := strEspeciesPermitidas.Contains(strEspDoc);
end;

function TFatVenda.fValidaEmpCarregamento(const arrEmpCar: TArray<String>): Boolean;
  Var
    strEmpCar: String;
begin
  Result := False;

  For strEmpCar In arrEmpCar Do
  Begin
    If Not fPermiteEmissaoEspecie('TE', strEmpCar) Then
    Begin
      fRollBack;
      pMensagemOK('A empresa de carregamento '+ strEmpCar +' não permite emissão de TE [CFG_PREMTE].'+
                  sLineBreak +'Transferência automática abortada!');
      Exit;
    End

    Else If fEmptyStr(fRetornaClienteFilial(strEmpCar, 'F', True)) Then
    Begin
      fRollBack;
      pMensagemOK('Fornecedor não preenchido no cadastro da empresa de carregamento '+ strEmpCar +
                  ' (necessário para a geração de transferência automática).'+ sLineBreak +'Favor verificar o cadastro da empresa!');
      Exit;
    End;
  End;

  Result := True;
end;

function TFatVenda.fPermiteEmissaoFFPeloCadastrosDoCliente(blnMostraMsg: Boolean=True): Boolean;
  Var
    strMsg: String;
begin
  If Self.blnVaiFaturarParcialEmFF Then
    Exit(True);

  strMsg:='';
  Try
    If (fCfgSis('PEMIFF') = '2') Then
    Begin
      If (Not Self.blnPermFF) Then
      Begin
        strMsg:='Espécie "FF" não permitida para emissão de faturamento para esse cliente conforme seu cadastro!';
      End 
      
      Else If (fStatusCndPag(Self.strConPag) = A_PRAZO) And (fCampoTabela('CLI_PERMFF','CADCLI',['CLI_CODCLI'],[Self.strCodCli]) = 'N') Then
      Begin
        strMsg:='Esse cliente só tem permissão para emissão de FF "À Vista"!';
      End 

      Else If (fStatusCndPag(Self.strConPag) = A_VISTA) And (fCampoTabela('CLI_PERMFV','CADCLI',['CLI_CODCLI'],[Self.strCodCli]) = 'N') Then
      Begin
        strMsg:='Esse cliente só tem permissão para emissão de FF "A Prazo"!';
      End;
    End;
  Finally
    Result := fEmptyStr(strMsg);
    If (Not Result) And (blnMostraMsg) Then
      fMensagem('Atenção!', strMsg, ['&OK']);
  End;
end;

function TFatVenda.fPermiteEmissaoFFPeloTipoDePedido(strTipPed: String=''): Boolean;
begin
  Result := True;

  If fEmptyStr(strTipPed) Then
    strTipPed := Self.strTipPed;

  If (Pos(strTipPed, 'B_D_') > 0) Then
  Begin
    If (fCfgSis('PEMIFF') = '1') Then
    Begin
      Result := fCfgSis('PERMFF', varBoolean);
      If (Not Result) Then
        fMensagem('Atenção', 'Espécie "FF" não permitida para emissão de faturamento!', ['&Ok']);
    End
    Else
    Begin
      Result := Self.fPermiteEmissaoFFPeloCadastrosDoCliente(True);
    End;
  End;
end;

function TFatVenda.fPermiteTipoFaturamentoConformeCondicao(strTipFatSelecionada: String): Boolean;

   function fVerificaTipFatPerfilCondicao: Boolean;
     Var
       strTipFatCnd: String;
   begin
     Result := True;

     If Not fEmptyStr(Self.strCodCnd) Then
     Begin
       strTipFatCnd := fCampoTabela('CND_TIPFAT', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);

       If Pos(strTipFatSelecionada, 'NF_EL_NS_') > 0 Then
         Result := Pos('A', strTipFatCnd) > 0

       Else If Pos(strTipFatSelecionada, 'MI_FF_') > 0 Then
         Result := Pos('B', strTipFatCnd) > 0

       Else If Pos(strTipFatSelecionada, 'IF_') > 0 Then
         Result := Pos('C', strTipFatCnd) > 0;
     End;
   end;

begin
  Result := True;

  If (fCfgSis('PFLCLI', varBoolean)) And
          (Pos(Self.strOpcDoc, 'VN_CP_') > 0) And
          (Not fVerificaTipFatPerfilCondicao) Then
  Begin
    fMensagem('ATENÇÃO!', 'Tipo de faturamento "'+strTipFatSelecionada+'" não é permitido pelo tipo de perfil da condição de pagamento!', ['&Ok']);
    Result := False;
  End

  Else If (fCfgSis('PFLCLI', varBoolean)) And
          (fCfgSis('VALDOC', varBoolean)) And
          (Self.strOpcDoc = 'CF') And
          (Not fVerificaTipFatPerfilCondicao) Then
  Begin
    fMensagem('ATENÇÃO!', 'Tipo de Faturamento "'+strTipFatSelecionada+'" não é permitido pelo tipo de perfil da condição de pagamento!', ['&Ok']);
    Result := False;
  End

  Else If (strTipFatSelecionada = 'FF') And (Self.strOpcDoc = 'VN') And
          (not fCfgSis('VNFFAV', VarBoolean)) And ((fStatusCndPag(Self.strConPag) = A_VISTA) Or (Pos(Self.strCodFpg, '001_007_003_004_') > 0)) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido "FF" à vista na venda normal! [CFG_VNFFAV]', ['&Ok']);
    Result := False;
  End

  Else If(Pos(strTipFatSelecionada, 'NF_EL_NS_IF_IV_D1_NE_') > 0) And
         (Self.strOpcDoc = 'VN') And
         (Not fCfgSis('NFIFAV', VarBoolean)) And
         (((fStatusCndPag(Self.strConPag) = A_VISTA)) Or ((Pos(Self.strCodFpg,'001_007_002_006_') > 0))) Then
  Begin
    fMensagem('ATENÇÃO!', 'Não é permitido "'+strTipFatSelecionada+'" à vista na venda normal! [CFG_NFIFAV]', ['&Ok']);
    Result := False;
  End

  Else If (strTipFatSelecionada = 'FF') And (fCfgSis('PEMIFF') = '2') Then
  Begin
    If (Not Self.fPermiteEmissaoFFPeloCadastrosDoCliente(True)) Then
    Begin
      Result := False;
    End;
  End;
end;

