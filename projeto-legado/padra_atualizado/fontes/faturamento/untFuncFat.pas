function TFatVenda.fTemPermissaoEspecieDocumento(strEspDocPar: String = ''; strCodOpe: String = ''; strComple: String = ''): Boolean;
  Var
    objLiberacao : TLiberacao;
    strComTmp: String;
    strEspMsg: String;
begin
  Result := True;

  If fEmptyStr(strEspDocPar) Then
    strEspDocPar := strEspDoc;

  strComTmp := '';

  If (Not fEmptyStr(strComple)) Then
    strComTmp := ' - ' + Trim(strComple);

  //Nota especial
  If strEspDocPar = 'NE' Then
    strEspDocPar := 'NF';

  //Caso for uma especie que tenha verificacao de direito de acesso
  If Pos(strEspDocPar, 'NS_NF_OR_PD_IF_IV_TE_MI_BR_TR_DV_FF_PI_EP_UC_PR_CS') > 0 Then
  Begin
    If (fSolicitarLiberacaoDeAcessoEmissaoDeDocumento(strOpcDoc, strEspDocPar, strCodOpe)) Then
    Begin
      strEspMsg := IfThen(strOpcDoc = 'BR', 'Brinde/Bonificação - '+strEspDocPar, strEspDocPar);

      objLiberacao := TLiberacao.Create;
      try
        objLiberacao.objMsgLibera.pAddTexto('Emissão de Faturamento - ' + strEspMsg + strComTmp);

        if ( strOpcDoc= 'BR' ) or ( strEspDoc= 'BR' ) then
          pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, nil);

        if strEspDocPar = 'UC' then
          pMontaMensagemUsoConsumo(cdsVenda, objLiberacao.objMsgRemota);

        objLiberacao.strDirAce := 'EMIFAT_' + strEspDocPar;
        objLiberacao.strMsgSen := 'Emissão de Faturamento - ' + strEspMsg;
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom;
        objLiberacao.strCpfCnpj := strCliCgc;
        objLiberacao.tipCliFor := IIF(fDocumentoParaFornecedor,cfFornecedor,cfCliente);

        If (Pos(strEspMsg,'DV_NF_') > 0) Then
          pMontaMensagemItensDetalhe(cdsVenda, objLiberacao.objMsgRemota);

        Result := fFatMensagemLiberacao(objLiberacao);
      finally
        FreeAndNil(objLiberacao);
      end;
    End;
  End;

end;

function TFatVenda.fGetEmpCarregamentoSubIte(const strCodIte: String; const strCodEmp: String = ''): TArray<String>;
  Var
    qryDetMat: TUniQuery;
begin
  qryDetMat := fCriaQuery;
  Try
    qryDetMat.SQL.Add('SELECT GROUP_CONCAT(DISTINCT ITE_EMPCAR) AS EMPCAR');
    qryDetMat.SQL.Add('FROM GERMAT');
    qryDetMat.SQL.Add('JOIN DETMAT ON DMT_SEQGER = GERMAT.AUTOINCREM');
    qryDetMat.SQL.Add('JOIN CADITE ON ITE_CODITE = DMT_ITESUB');
    qryDetMat.SQL.Add('WHERE GMT_CODITE = :CODITE');

    If Not fEmptyStr(strCodEmp) Then
    Begin
      qryDetMat.SQL.Add('AND ITE_EMPCAR <> :CODEMP');
      qryDetMat.ParamByName('CODEMP').AsString := strCodEmp;
    End;

    qryDetMat.ParamByName('CODITE').AsString := strCodIte;
    qryDetMat.Open;

    Result := qryDetMat.FieldByName('EMPCAR').AsString.Split([',']);
  Finally
    FreeAndNil(qryDetMat);
  End;
end;

function TFatVenda.fGetExisteDocumentoAD(strAlias: String): String;
begin
  Result := Result + ' AND EXISTS ';
  Result := Result + '    (SELECT AD.DET_CODITE ';
  Result := Result + '       FROM ADEDET AD ';
  Result := Result + '       WHERE AD.DET_TIP_FC = '+strAlias+'.DET_TIP_FC AND ';
  Result := Result + '             AD.DET_NUMDOC = '+strAlias+'.DET_NUMDOC AND ';
  Result := Result + '             AD.DET_ESPDOC = '+strAlias+'.DET_ESPDOC AND ';
  Result := Result + '             AD.DET_CODEMP = '+strAlias+'.DET_CODEMP AND ';
  Result := Result + '             AD.DET_SERIE_ = '+strAlias+'.DET_SERIE_ AND ';
  Result := Result + '             AD.DET_CODITE = '+strAlias+'.DET_CODITE AND ';
  Result := Result + '             AD.DET_CODADE = ' + QuotedStr(Self.strCodAde) + ' AND ';
  Result := Result + '             AD.DET_CODEMP = ' + QuotedStr(VS_strCodEmp) + ') ';
end;

function TFatVenda.fGetDadosEmbarcacao(strAutInc: String): String;
  Var
    strSQL: String;
    qryTemp: TUniQuery;
begin
  strSQL := 'SELECT ';
  strSQL := strSQL + '  CONCAT(EMB_CODEMB, "-", EMB_NOMEMB) AS NOMEMB, ';
  strSQL := strSQL + '  CONCAT(" / Inscr.: ", EMB_INSCRI) AS INSCRI, ';
  strSQL := strSQL + '  CONCAT(" / Nro IMO: ", EMB_NUMIMO) AS NUMIMO, ';
  strSQL := strSQL + '  CONCAT(" / Indtvo: ", EMB_INDEMB) AS INDEMB, ';
  strSQL := strSQL + '  CONCAT(" / Porto: ", EMB_PORTOI) AS PORTOI, ';
  strSQL := strSQL + '  CONCAT("Local: ", EMB_LOCEMB) AS LOCEMB, ';
  strSQL := strSQL + '  " / Porte: " AS PORTE1, ';
  strSQL := strSQL + '  IF(EMB_PORTE_ = "0", "PEQUENO", IF(EMB_PORTE_ = "1", "MÉDIO", IF(EMB_PORTE_ = "2", "GRANDE", "NÃO INFORMADO"))) AS PORTE2, ';
  strSQL := strSQL + '  CONCAT(" / Compr.:", ROUND(EMB_COMPRI, 2)) AS COMPRI, ';
  strSQL := strSQL + '  CONCAT(" / Arq.: ", EMB_ARQBRU) AS ARQBRU, ';
  strSQL := strSQL + '  CONCAT(" / Obs.: ", EMB_OBSERV) AS OBSERV, ';
  strSQL := strSQL + '  IF(EMB_DRABCK = "S", "SIM", "NÃO") AS DRABCK ';
  strSQL := strSQL + 'FROM CADEMB ';
  strSQL := strSQL + 'WHERE AUTOINCREM = :AUTINC ';

  Try
    qryTemp := fCriaQuery(nil);

    Try
      qryTemp.Close();
      qryTemp.SQL.Clear();
      qryTemp.SQL.Text := strSQL;
      qryTemp.ParamByName('AUTINC').AsString := strAutInc;
      qryTemp.Open;

      If (Not qryTemp.IsEmpty) Then Begin
        Result := 'Embarc.: ' + qryTemp.FieldByName('NOMEMB').AsString +
                                qryTemp.FieldByName('INSCRI').AsString +
                                qryTemp.FieldByName('NUMIMO').AsString +
                                qryTemp.FieldByName('INDEMB').AsString +
                                qryTemp.FieldByName('PORTOI').AsString + #13#10 +
                                qryTemp.FieldByName('LOCEMB').AsString +
                                qryTemp.FieldByName('PORTE1').AsString +
                                qryTemp.FieldByName('PORTE2').AsString +
                                qryTemp.FieldByName('COMPRI').AsString +
                                qryTemp.FieldByName('ARQBRU').AsString +
                                Copy(qryTemp.FieldByName('OBSERV').AsString, 1, 30) +
                                ' / Oper. Drawback: ' + qryTemp.FieldByName('DRABCK').AsString;
      End Else
        Result := '';
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmFatVendas.pMostrarDadosEmbarcacaoRodape]');
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;

function TFatVenda.fGetDadosEmbObsDrawback(strAutInc: String): String;
  Var
    strSQL: String;
    qryTemp: TUniQuery;
begin
  strSQL := 'SELECT EMB_DRABCK AS DRABCK, EMB_OBSDBK AS OBSDBK ';
  strSQL := strSQL + 'FROM CADEMB ';
  strSQL := strSQL + 'WHERE AUTOINCREM = :AUTINC ';

  Try
    qryTemp := fCriaQuery(nil);

    Try
      qryTemp.Close();
      qryTemp.SQL.Clear();
      qryTemp.SQL.Text := strSQL;
      qryTemp.ParamByName('AUTINC').AsString := strAutInc;
      qryTemp.Open;

      If (Not qryTemp.IsEmpty) And (qryTemp.FieldByName('DRABCK').AsString = 'S') Then
        Result := qryTemp.FieldByName('OBSDBK').AsString
      Else
        Result := '';
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmFatVendas.fGetDadosEmbObsDrawback]');
    End;
  Finally
    FreeAndNil(qryTemp);
  End;
end;


Function TFatVenda.fGetResumoUnidades: String;//Cofert
  Var
    item: TDadosFechamento;
    strSig: String;
    fltQtd: Double;
    dicSiglas: TDictionary<String, Double>;
begin
  dicSiglas := TDictionary<String, Double>.Create;

  For item In arrMatItens Do
  Begin
    If Not dicSiglas.ContainsKey(item.strSigUni) Then
      fltQtd := item.fltQtdIte
    Else
      fltQtd := dicSiglas[item.strSigUni] + item.fltQtdIte;
    dicSiglas.AddOrSetValue(item.strSigUni, fltQtd);
  End;

  Result := '';
  For strSig In dicSiglas.Keys Do
    Result := Result + strSig + ':' + FormatFloat(',0.00', dicSiglas[strSig]) + '  ';

  FreeAndNil(dicSiglas);
end;

