function TFatVenda.fVerificaFornedorMarcaNaoPermitidosParaCliente: Boolean;
var
  cdsDados : TUniClientDataSet;
  stlForNaoPer: TStringList;
  stlMarNaoPer: TStringList;
  frmObservacao: TfrmObservacao;
  objTabela  : TRegistroMsgLiberaTabela;
  objLinha   : TLinhaMsgLibera;
  objMensagem: TMensagemLiberacao;
  intCnt: Integer;
begin
  Result := True;

  If Self.blnExpedi And Assigned(Self.objExpedicao) Then
    If (Self.objExpedicao.VS_strTipExpInterna <> TIPEXP_POR_PEDIDO_E_PEDIDO_SERA_FATURADO) And (Not Self.objExpedicao.blnFaturarExpedidos) Then
      Exit;

  If Not (fCfgSis('UTIFMP', varBoolean)) Then
    Exit;

  If (Pos(strOpcDoc, 'OR_PD_VN_CP_CF_CI_') = 0) Then
    Exit;

  cdsDados := TUniClientDataSet.Create(Self);
  try
    cdsDados.Data := cdsVenda.Data;
    cdsDados.LogChanges := False;
    cdsDados.First;

    stlForNaoPer := TStringList.Create;
    stlMarNaoPer := TStringList.Create;
    try

      cdsDados.First;
      While (Not cdsDados.Eof) Do
      Begin
        If (fFornecedorNaoPermitidoParaCliente(strCodCli, cdsDados.FieldByName('ITE_CODFOR').AsString)) Then
          stlForNaoPer.Add(cdsDados.FieldByName('AUTOINCREM').AsString);

        If (fMarcaNaoPermitidoParaCliente(strCodCli, cdsDados.FieldByName('ITE_CODMAR').AsString)) Then
          stlMarNaoPer.Add(cdsDados.FieldByName('AUTOINCREM').AsString);

        cdsDados.Next;
      End;

      If (stlForNaoPer.Count = 0) And (stlMarNaoPer.Count = 0) Then
        Exit(True)
      Else
        Result := False;

      pCriarFormularios(TfrmObservacao, frmObservacao);
      try
        frmObservacao.lblMensagem.Caption := 'Itens com Fornecedor ou Marca não permitidos para o Cliente!';
        frmObservacao.memObs.Clear;
        frmObservacao.Height := 500;
        frmObservacao.Width := 768;

        If (stlMarNaoPer.Count > 0) Then
        Begin
          objMensagem := TMensagemLiberacao.Create(Nil);
          try
            objTabela := TRegistroMsgLiberaTabela.Create;
            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlCabecalho;
            objLinha.pAddColuna('', 'Nº'       , 03, alDireita,  teAmbos);
            objLinha.pAddColuna('', 'Código'   , fTamCodIte + 1, alDireita,  teAmbos);
            objLinha.pAddColuna('', 'Descrição', 30, alEsquerda, teAmbos);
            objLinha.pAddColuna('', 'Cód.Marca', 06, alDireita,  teAmbos);
            objLinha.pAddColuna('', 'Marca'    , 30, alEsquerda,  teAmbos);
            objTabela.lstLinhas.Add(objLinha);

            For intCnt := 0 To Pred(stlMarNaoPer.Count) Do
            Begin
              If cdsDados.Locate('AUTOINCREM', stlMarNaoPer[intCnt], []) Then
              Begin
                objLinha  := TLinhaMsgLibera.Create;
                objLinha.enuTipoLinha := tlValor;
                objLinha.pAddColuna('Nº'       , cdsDados.FieldByName('ITE_ORDITE').AsString, 03, alDireita,  teAmbos);
                objLinha.pAddColuna('Código'   , cdsDados.FieldByName('ITE_CODITE').AsString, fTamCodIte + 1, alDireita,  teAmbos);
                objLinha.pAddColuna('Descrição', cdsDados.FieldByName('ITE_DESITE').AsString, 30, alEsquerda, teAmbos);
                objLinha.pAddColuna('Cód.Marca', cdsDados.FieldByName('ITE_CODMAR').AsString, 06, alDireita,  teAmbos);
                objLinha.pAddColuna('Marca'    , fRetNomMarca(cdsDados.FieldByName('ITE_CODMAR').AsString), 30, alEsquerda,  teAmbos);
                objTabela.lstLinhas.Add(objLinha);
              End;
            End;

            objMensagem.lstRegistros.Add(objTabela);
            frmObservacao.memObs.Lines.Add('Itens com Marcas não permitidas para o Cliente:');
            frmObservacao.memObs.Lines.Add(objMensagem.fGetMensagem);
            frmObservacao.memObs.Lines.Add('');
          finally
            FreeAndNil(objMensagem);
          end;

        End;

        If (stlForNaoPer.Count > 0) Then
        Begin
          objMensagem := TMensagemLiberacao.Create(Nil);
          try
            objTabela := TRegistroMsgLiberaTabela.Create;
            objLinha := TLinhaMsgLibera.Create;
            objLinha.enuTipoLinha := tlCabecalho;

            objLinha.pAddColuna('', 'Nº'        , 03, alDireita,  teAmbos);
            objLinha.pAddColuna('', 'Código'    , fTamCodIte + 1, alDireita,  teAmbos);
            objLinha.pAddColuna('', 'Descrição' , 30, alEsquerda, teAmbos);
            objLinha.pAddColuna('', 'Cód.For'   , 08, alDireita,  teAmbos);
            objLinha.pAddColuna('', 'Fornecedor', 30, alEsquerda,  teAmbos);
            objTabela.lstLinhas.Add(objLinha);

            For intCnt := 0 To Pred(stlForNaoPer.Count) Do
            Begin
              If cdsDados.Locate('AUTOINCREM', stlForNaoPer[intCnt], []) Then
              Begin
                objLinha  := TLinhaMsgLibera.Create;
                objLinha.enuTipoLinha := tlValor;
                objLinha.pAddColuna('Nº'        , cdsDados.FieldByName('ITE_ORDITE').AsString, 03, alDireita,  teAmbos);
                objLinha.pAddColuna('Código'    , cdsDados.FieldByName('ITE_CODITE').AsString, fTamCodIte + 1, alDireita,  teAmbos);
                objLinha.pAddColuna('Descrição' , cdsDados.FieldByName('ITE_DESITE').AsString, 30, alEsquerda, teAmbos);
                objLinha.pAddColuna('Cód.For'   , cdsDados.FieldByName('ITE_CODFOR').AsString, 08, alDireita,  teAmbos);
                objLinha.pAddColuna('Fornecedor', fRetNomFornecedor(cdsDados.FieldByName('ITE_CODFOR').AsString), 30, alEsquerda,  teAmbos);
                objTabela.lstLinhas.Add(objLinha);
              End;
            End;

            objMensagem.lstRegistros.Add(objTabela);
            frmObservacao.memObs.Lines.Add('Itens com Fornecedores não permitidos para o Cliente:');
            frmObservacao.memObs.Lines.Add(objMensagem.fGetMensagem);
            frmObservacao.memObs.Lines.Add('');
          finally
            FreeAndNil(objMensagem);
          end;

        End;

        frmObservacao.ShowModal;
      finally
        pFreeAndNil(frmObservacao);
        FreeAndNil(objMensagem);
      end;
    finally
      FreeAndNil(stlForNaoPer);
      FreeAndNil(stlMarNaoPer);
    end;
  finally
    FreeAndNil(cdsDados);
  end;
end;

function TFatVenda.fVerificaIntervaloMargemProduto(objLiberacao: TLiberacao; ftlMargemPrat : Double; strProduto, strQuantidade : String; blnPedeSenha: Boolean = True): Boolean;
  Var
    LfltMarMin, LfltMarMax  : Double;
    blnIgnoraTravaPeloF11: Boolean;
    LstrTraSen : String;
    qryTmp : TUniQuery;
begin
  Result := True;

  If Not fPermiteValidarMargemAndValorCodCnd Then
    Exit;

  If fPermitirIgnorarTravaMargemDoCliente(Self.strCodCli) Then
    Exit;

  Try
    qryTmp := fCriaQuery(Self);
    qryTmp.SQL.Add(' SELECT CND_MARMAX, CND_MARMIN, CND_TRAMAR ');
    qryTmp.SQL.Add('   FROM CADCND ');
    qryTmp.SQL.Add('  WHERE CND_CODIGO = ' + QuotedStr(strCodCnd));
    qryTmp.Open;

    If (qryTmp.FieldByName('CND_MARMIN').AsFloat > 0) Or (qryTmp.FieldByName('CND_MARMAX'). AsFloat > 0) Then
    Begin
      LfltMarMin := qryTmp.FieldByName('CND_MARMIN').AsFloat;
      LfltMarMax := qryTmp.FieldByName('CND_MARMAX').AsFloat;
      LstrTraSen := qryTmp.FieldByName('CND_TRAMAR').asString;

      If ((ftlMargemPrat < LfltMarMin) Or (ftlMargemPrat > LfltMarMax)) Then
      Begin
        Result := False;
      End;

      If (Not Result) Then
      Begin
        blnIgnoraTravaPeloF11 := (Self.strOriF11 = 'S') and (not fCfgSis('TRAF11', varBoolean)) and (Pos(Self.strOpcDOc, 'VN_PD_OR_') > 0);

        if blnIgnoraTravaPeloF11 then
        begin
          Result := True;
        end
        else
        begin
          objLiberacao.objMsgLibera.pAddTexto(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' do produto fora do intervalo permitido pelo perfil da condição de pagamento');
          objLiberacao.objMsgLibera.pAddSeparador(100);
          objLiberacao.objMsgLibera.pAddTextoCaption('Produto', strProduto);
          objLiberacao.objMsgLibera.pAddTextoCaption('Quantidade', strQuantidade);
          objLiberacao.objMsgLibera.pAddSeparador(100);
          objLiberacao.objMsgLibera.pAddTextoCaption(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' mínima permitida' , FloatToStrF(LfltMarMin, ffNumber, 12, 2), 24);
          objLiberacao.objMsgLibera.pAddTextoCaption(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' máxima permitida' , FloatToStrF(LfltMarMax, ffNumber, 12, 2), 24);
          objLiberacao.objMsgLibera.pAddTextoCaption(IIF(fMargem_ou_Markup='MARGEM','Margem','Markup') + ' praticada'        , FloatToStrF(ftlMargemPrat, ffNumber, 12, 2), 24);

          If LstrTraSen = 'S' Then
          Begin
            objLiberacao.strDirAce := 'LBMKIT';
            objLiberacao.strSenLib := fCfgSis('SENLBD');
            objLiberacao.strMsgSen := 'Liberacao de Venda Item a Item';
            objLiberacao.blnMosMen := True;
            objLiberacao.strCodOpe := strCodVen;
            objLiberacao.strCodDig := strCodDig;
            objLiberacao.strCliente := strCodCli + '-' + strCliNom;
            objLiberacao.strCpfCnpj := strCliCgc;
            objLiberacao.blnUsarSenhaFixa := False;
            objLiberacao.blnSempreVariavelUsuario := True;
            objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);
            Result := fFatMensagemLiberacao(objLiberacao);
          End
          Else
          Begin
            objLiberacao.strDirAce := 'NENHUM';
            objLiberacao.blnTraTel := False;
            fFatMensagemLiberacao(objLiberacao);
          End;

          With recInfoTravaUnitario Do
          Begin
            strOpcTrvUnit := 'LBMKIT';
            strLibUniComSenha := IIF(Result, 'S', 'N');
          End;
        end;
      End;
    End;
  Finally
    FreeAndNil(qryTmp);
  End;
end;

