          {* PEGA PREÇO DE CUSTO CASO ESTEJA CONFIGURADO   *}
          {* PARA UTILIZAR PREÇO DE CUSTO EM OUTRAS SAIDAS *}
          {**********************************************AL*}
          If (Pos(strOpcDoc, 'OU_OF_') > 0) And (fCfgSis('PROSOE') = 'C') Then
            fltUniTraPro := fltPreCus
          Else
            fltUniTraPro := fPegaUnitarioTrava(1);//Nivel 1
          fltMinCus := fltMinCus + fCustoMinimoTrava;
        End
        Else
        Begin
          {*******************************************}
          {* PEGA UNITARIO DE TRAVA DAS TINTAS DE    *}
          {* MAQUINA                                 *}
          {****************************************MV*}
          If (Assigned(fRetornaUniTraProTinta)) Then
          Begin
            fltUniTraPro := fFormataFloat(fRetornaUniTraProTinta(strIdeProIte, qryTinta,
              fltEmbala, fltQtdIte, strTipPre, strIteTin,
              strCodIte, strTabPreIte, strCatalize, fltPrcTin, fltPrvTin), 04);

            fltMinCus := fltMinCus + fCustoMinimoTrava;

          End Else
            fltUniTraPro := 0;

        End;

        {*******************************************}
        {* CASO FOR PROMOÇÃO, TRAVA SOMENTE SE FOR *}
        {* QUE O PREÇO DA PROMOÇÃO                 *}
        {****************************************MV*}
        If (strOpcDoc <> 'OF') And (fCfgSis('MINCUS') <> 'N') And (VS_strTRVEPR = '1') And
           (Pos('ITEM ESPECIAL', strDesIte) <= 0) And
           (fFormataFloat(fltMinCus, intDecUni) > fFormataFloat(fltUniLiqTmp, intDecUni)) Then
        Begin
          cdsMargF4 := TUniClientDataSet.Create(nil);
          Try
            objLiberacao.objMsgLibera.pAddTexto('Valor menor que o preço de custo não é permitido!');

            itemCalcMar := fGetItemCalcularMargem;
            try
              If blnExecMontaMsgInterna Then
                pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, itemCalcMar, False, True, Nil, Nil, True, cdsMargF4);

              If Not blnPedeSenha Then
                pRegistraUltimoBloqueio(objLiberacao.objMsgLibera.fGetMensagem,
                                        objLiberacao.objMsgRemota.fGetMensagem);
            finally
              FreeAndNil(itemCalcMar);
            end;

            objLiberacao.cdsXmlF4 := cdsMargF4;
            objLiberacao.strDirAce := 'VECUS';
            objLiberacao.strMsgSen := 'Liberacao de Venda abaixo do preço de custo';
            objLiberacao.strCodOpe := strCodVen;
            objLiberacao.strCodDig := strCodDig;
            objLiberacao.strCliente := strCodCli + '-' + strCliNom;
            objLiberacao.strCpfCnpj := strCliCgc;
            objLiberacao.blnUsarSenhaFixa := False;
            objLiberacao.blnSempreVariavelUsuario := True;
            objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

            Result := blnPedeSenha And fFatMensagemLiberacao(objLiberacao);

            With recInfoTravaUnitario Do
            Begin
              strOpcTrvUnit := 'VECUS';
              strLibUniComSenha := IIF(Result, 'S', 'N');
            End;

            If (Result) Then
              pAtualizaTotalUnitario;

            Exit;
          Finally
            FreeAndNil(cdsMargF4);
          End;
        End;

        If (VS_strTRADES = '1')                                                 And
           (fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraPro, intDecUni)) Then
        Begin
          blnTraIteTmp := True;
        End;

        If (VS_strTRADES = '2')                                                 And
           (fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraPro, intDecUni)) Then
        Begin
          blnTraIteTmp := True;
        End;

        If (VS_strTRADES = '3')                                                 And
           (fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraPro, intDecUni)) Then
        Begin
          blnTraIteTmp := True;
        End;

        If (TipoOpcaoDeTrava.fOpcaoDeTravaEhPorAtividade)                       And
