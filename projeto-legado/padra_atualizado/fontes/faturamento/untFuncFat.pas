function TFatVenda.fRealizarLiberacaoRemotaFinalVenda: Boolean;
  Var 
    item: TDadosFechamento;
    blnRemoverTravaTrocaTabelaPrecoItens: Boolean;
    strTabPreSenha: String;

    procedure pChamaTelaBloqueios;
    begin
      If (Length(arrLogAvi) > 0) Then
      Begin
        pCriarFormularios(TfrmFatLiberacaoBloqueios, frmFatLiberacaoBloqueios);
        Try
          Try
            frmFatLiberacaoBloqueios.fatVenda := Self;
            frmFatLiberacaoBloqueios.blnSenLib := (fCampoTabela('OPE_SENLIB', 'CADOPE', ['OPE_CODOPE'], [strLoginUsuarioLogado]) = 'N');

            if ((cdsVenda <> nil)) and (not cdsVenda.IsEmpty) then
              frmFatLiberacaoBloqueios.cdsXmlF4 := cdsVenda;

            Result := frmFatLiberacaoBloqueios.ShowModal = mrOk;

          Except
            On E: Exception Do
            Begin
              Result := False;
              pMensagensErro(E.Message,'');
            End;
          End;
        Finally
          pFreeAndNil(frmFatLiberacaoBloqueios);
        End;
      End;
    end;
    
begin
  Result := True;

  If Self.blnLiberacaoRemotaNoFinalVenda Then
  Begin
    If (Self.blnRealizandoLiberacaoPedido) Or
       (Not fPos(Self.strEspDoc, 'PD_OR_')) Or
       (Not Self.blnUsaLiberacaoPedidosConformeEscolhaDoOperador) Or
       (fCfgSis('LPSTER', VarBoolean) And strNumPok.IsEmpty) Then
    Begin
      strTabPreSenha := fCfgSis('SETBPR');
      If (Not strTabPreSenha.IsEmpty) And (Not blnTeveTravaTrocaTabelaPrecoGeral) And (blnTeveTravaTrocaTabelaPrecoItens) Then
      Begin
        blnRemoverTravaTrocaTabelaPrecoItens := True;
        For item in Self.arrMatItens Do
        Begin
          If (strTabPreSenha[StrToInt(item.strTabPre)] = 'S') Then
            blnRemoverTravaTrocaTabelaPrecoItens := False;
        End;    

        If blnRemoverTravaTrocaTabelaPrecoItens Then
        Begin
          pRemoverTravaLogAvi('TABCLI', Self.strNTrava);
          blnTeveTravaTrocaTabelaPrecoItens := False;  
        End;  
      End;

      pChamaTelaBloqueios;
    End
    Else
    Begin
      If fPos(Self.strEspDoc, 'PD_OR_') Then
      Begin
        pChamaTelaBloqueios;
      End;
    End;

    If Not Result Then
    Begin
      Self.strUltCndVenLib:= '';
      Self.strUltCodVenLib:= '';
    End;
  End;
end;

function TFatVenda.fDefinirMsgFormasPagamentoNegociada(strMensagem: String; blnJson: Boolean=False): String;
  Var
    stlMsg: TStringList;
    strMsg: String;
    intPos: Integer;
begin
  Result      := '';

  If blnJson Then
  Begin
    If Pos(STRING_FORMAS_PAGTO_NEGOCIADAS, strMensagem) > 0 Then
    Begin
      strMsg := #13;

      If Self.strCodFpg = '009' Then
      With Self.objFormasPagtoNegociada.cdsFormasNegociadas Do
      Begin
        First;
        While Not Eof Do
        Begin
          strMsg := strMsg + fPadR(FieldByName('DESFPG').AsString + ' ', 47, '.') + ' ' +
                             fPadL(FormatFloat('#,##0.00', FieldByName('VALFPG').AsFloat), 9) + #13;
          Next;
        End;
        First;
      End;

      If Self.strCodFpg = '007' Then
      Begin
        strMsg := strMsg + fPadR('CARTAO DE ' + IIF(fRetTipoCartao(Self.strCodCar) = 'D', 'DEBITO','CREDITO') +
                                 ' em ' + Self.intQtdPaC.ToString + 'X (' + Self.strCodCar + '-' +
                                 fRetNomeCartao(Self.strCodCar) + ') ', 47, '.') + ' ' +
                                 fPadL(FormatFloat('#,##0.00', Self.fltTotCadRec), 9) + #13;
      End;
    End;

    Result := AnsiReplaceStr(strMensagem, STRING_FORMAS_PAGTO_NEGOCIADAS, strMsg);
  End
  Else
  Begin
    stlMsg      := TStringList.Create;
    stlMsg.Text := strMensagem;

    For strMsg In stlMsg Do
    Begin
      intPos := Pos(STRING_FORMAS_PAGTO_NEGOCIADAS, strMsg);
      If intPos > 0 Then
      Begin
        Result := Result + fReplicatorStr(' ', intPos -1) +
                           fReplicatorStr('-', 60) + #13#10;

        If Self.strCodFpg = '009' Then
        With Self.objFormasPagtoNegociada.cdsFormasNegociadas Do
        Begin
          First;
          While Not Eof Do
          Begin
            Result := Result + fReplicatorStr(' ', intPos -1) +
              fPadR(FieldByName('DESFPG').AsString + ' ', 47, '.') + ' ' +
              fPadL(FormatFloat('#,##0.00', FieldByName('VALFPG').AsFloat), 12) + #13#10;
            Next;
          End;
          First;
        End;

        If Self.strCodFpg = '007' Then
        Begin
          Result := Result + fReplicatorStr(' ', intPos -1) +
            fPadR('CARTAO DE ' + IIF(fRetTipoCartao(Self.strCodCar) = 'D', 'DEBITO','CREDITO') +
                  ' em ' + Self.intQtdPaC.ToString + 'X (' + Self.strCodCar + '-' +
                  fRetNomeCartao(Self.strCodCar) + ') ', 47, '.') + ' ' +
            fPadL(FormatFloat('#,##0.00', Self.fltTotCadRec), 12) + #13#10;
        End;
      End
      Else
        Result := Result + strMsg + #13#10;
    End;

    FreeAndNil(stlMsg);
  End;
end;

