procedure TFatVenda.pGerarLotesEstoqueExterno;
var
  item: TDadosFechamento;
begin
  if Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Or Self.GetDevolvendoMercadoriaDoEstoqueExterno then
    for item In arrMatItens do
      GetLoteEstoqueExterno(item.strCodIte);
end;

function TFatVenda.GetLoteEstoqueExterno(ACodIte: String): String;
Var
  LNumLot: String;
  LMsgErr: String;
begin
  LNumLot := '';
  Try

    if Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Or Self.GetDevolvendoMercadoriaDoEstoqueExterno then
    begin

      If fUsaRotinaWMS(VS_strCodEmp) Or TCadLot.ProdutoTemLote(ACodIte) Then
      Begin

        if not TCadLot.ExisteLoteEstoqueExterno(ACodIte, Self.Fulfillment.CodigoDoEstoqueExterno, LNumLot) then
          TCadLot.GeraLoteEstoqueExterno(ACodIte, Self.Fulfillment.CodigoDoEstoqueExterno, LNumLot);

        if not TCadLot.ValidaLoteEstoqueExterno(ACodIte, Self.Fulfillment.CodigoDoEstoqueExterno, LMsgErr) then
          raise ExceptionAutcom.Create(LMsgErr);

      End;

    end;

  Finally
    Result := LNumLot;
  End;
end;

