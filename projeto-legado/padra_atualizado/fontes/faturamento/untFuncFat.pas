function TFatVenda.fValidarClientePermiteFaturamentoDiaSemana(ACodCli: String; AObjLib: TLiberacao = nil): Boolean;
var
  intContador: Integer;
  strMsgDiasPermitidos: String;
  stlMsgDiasPermitidos: TStringList;
begin
  If (Not fPermiteFaturamento(ACodCli, strMsgDiasPermitidos)) Then
  Begin
    If Not Assigned(AObjLib) Then
    Begin
      pMensagemOk('Cliente não permite faturamento no dia/semana.');
      Exit(False);
    End;
    AObjLib.Clear;
    AObjLib.objMsgLibera.pAddTexto('Cliente não permite faturamento no dia/semana.');
    AObjLib.objMsgLibera.pAddTexto('Verifique em > Cadastro de Clientes > ABA "Datas de Controle" (CFG_UTDTFE).');

    If (Not fEmptyStr(strMsgDiasPermitidos)) Then
    Begin
      AObjLib.objMsgLibera.pAddQuebra;

      stlMsgDiasPermitidos := TStringList.Create;
      try
        stlMsgDiasPermitidos.Text := strMsgDiasPermitidos;

        for intContador := 0 to stlMsgDiasPermitidos.count - 1 do
          AObjLib.objMsgLibera.pAddTexto(stlMsgDiasPermitidos[intContador]);

      finally
        FreeAndNil(stlMsgDiasPermitidos);
      end;

    End;

    AObjLib.strDirAce  := 'UTDTFA';
    AObjLib.strMsgSen  := 'Cliente não permite faturamento no dia/semana.';
    AObjLib.strCodOpe  := Self.strCodVen;
    AObjLib.strCodDig  := Self.strCodDig;
    AObjLib.strCliente := ACodCli + '-' + fRetNomCliente(ACodCli);

    If (Not Self.fFatMensagemLiberacao(AObjLib)) Then
      Exit(False);
  End;
  Result := True;
end;

function TFatVenda.fValidarCpfObrigatorio(blnValidaSeVaiSerCupomMaisNota: Boolean=False): Boolean;
  Var 
    strTipPedLoc,
    strEntFatLoc,
    strEntFutLoc: String;
    blnEhPedOrcMultiLoja,
    blnTemItensEntrega: Boolean;
    blnCupomMaisNota: Boolean;
begin
  Result := True;

  blnCupomMaisNota := False;
  blnEhPedOrcMultiLoja := False;

  If (blnValidaSeVaiSerCupomMaisNota) And (Self.strEspDoc = 'IF') Then
  Begin
    If fHaveraDesmembramentoVenda(Self.arrMatItens) Then
    Begin
      strEntFatLoc := IIF(fTemItensEntrega(Self.arrMatItens), 'S', 'N');
      strEntFutLoc := IIF(fTemEntregaFutura(Self.arrMatItens), 'S', 'N');

      blnTemItensEntrega := (strEntFutLoc = 'S') Or (strEntFatLoc = 'S');

      If blnTemItensEntrega Then
      Begin
        If (Not blnCupomMaisNota) And (fCfgSis('CUPNOT', varInteger) = 1) And (strEntFutLoc = 'S') Then
          blnCupomMaisNota := True

        Else If (Not blnCupomMaisNota) And (fCfgSis('CUPENT', varInteger) = 1) And (strEntFatLoc = 'S') Then
          blnCupomMaisNota := True

        Else If (Not blnCupomMaisNota) And (fEhPedOrcMultiloja(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri)) And (fCfgSis('CPOBMT', varBoolean)) Then
        Begin
          strTipPedLoc := fBuscaTipPed(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri);

          If (IfEmptyStr(strTipPedLoc, 'A') = 'A') Then
          Begin
            blnCupomMaisNota := True;
            blnEhPedOrcMultiLoja := True;
          End;
        End;
      End;
    End;
  End;

  If (((Pos(Self.strEspDoc,'NF_EL_NS_') > 0) Or blnCupomMaisNota) And (fCfgSis('CPFOBR', varBoolean))) Or
     ((Self.strEspDoc = 'FF') And (fCfgSis('CPFOFF', varBoolean))) Then
  Begin
    If (fEmptyStr(Self.strCliCgc)) Then
    Begin
      fMensagem('ATENÇÃO!', 'Cliente não possui CPF / CNPJ. Não será permitido emitir '+fDescricaoDocFat(Self.strEspDoc)+'.', ['&Ok']);
      Result := False;
    End
    Else If (fReplicatorStr(Self.strCliCgc[1], Length(Self.strCliCgc)) = Self.strCliCgc) And
            (Self.fTrocaUFEndEntrega <> 'EX')Then
    Begin
      If Not Self.fPermiteNotaServicoSemCpf Then
      Begin
        If blnEhPedOrcMultiLoja Then
          fMensagem('ATENÇÃO!', 'O CPF / CNPJ do cliente não é válido para emitir nota fiscal ou pedido de desmembramento com itens de entrega.', ['&Ok'])
        Else
          fMensagem('ATENÇÃO!', 'O CPF / CNPJ do cliente não é válido para emitir nota fiscal.', ['&Ok']);
        Result := False;
      End;
    End;
  End;
end;

procedure TFatVenda.pInicializaDadosDeProfissionais(strIncrementoFatGor: String);
  Var
    qryGen : TUniQuery;
    dspProfiss: TUniDataSetProvider;
    strProfis : String;
begin
  qryGen := fCriaQuery(Self);
  dspProfiss := TUniDataSetProvider.Create(Self);
  Try
    dspProfiss.DataSet := qryGen;

    If Assigned(cdsProfiss) Then
      FreeAndNil(cdsProfiss);

    cdsProfiss := TUniClientDataSet.Create(Self);
    cdsProfiss.SetProvider(dspProfiss);

    strProfis := '';
    strProfis := strProfis + ' SELECT ';
    strProfis := strProfis + '   F.DIV_CODDIV, ';
    strProfis := strProfis + '   D.DIV_NOMDIV, ';
    strProfis := strProfis + '   D.DIV_CODATI, ';
    strProfis := strProfis + '   A.ATI_DESATI ';
    strProfis := strProfis + ' FROM ';
    strProfis := strProfis + '   DIVFAT F, ';
    strProfis := strProfis + '   CADDIV D, ';
    strProfis := strProfis + '   CADATI A  ';
    strProfis := strProfis + ' WHERE  ';
    strProfis := strProfis + '   F.DIV_CODDIV = D.DIV_CODDIV AND ';
    strProfis := strProfis + '   D.DIV_CODATI = A.ATI_CODATI AND  ';
    strProfis := strProfis + '   F.DIV_SEQGER = :AUTINC ';

    qryGen.Close;
    qryGen.SQL.Clear;
    qryGen.SQL.Add(strProfis);
    qryGen.ParamByName('AUTINC').AsString := strIncrementoFatGor;
    qryGen.Open;

    pSetaClient(qryGen);

    If Not qryGen.IsEmpty Then
      cdsProfiss.Open;
  Finally
    FreeAndNil(qryGen);
    FreeAndNil(dspProfiss);
  End;
End;

function TFatVenda.fLiberouVendaAbaixoDoCusto(strJson : String; cdCdsXmlF4: TUniClientDataSet): Boolean;
  Var
    objLiberacao : TLiberacao;
begin
  objLiberacao := TLiberacao.Create;
  Try
    pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota);
    objLiberacao.objMsgLibera.fGetObjectFromJson(strJson);
    objLiberacao.strDirAce := 'VECUS';
    objLiberacao.strMsgSen := 'Liberacao de Venda abaixo do preço de custo';
    objLiberacao.blnMosMen := True;
    objLiberacao.strCodOpe := Self.strCodVen;
    objLiberacao.strCodDig := Self.strCodDig;
    objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliNom;
    objLiberacao.strCpfCnpj := Self.strCliCgc;
    objLiberacao.tipCliFor := IIF(Self.strOpcDoc = 'OF', cfFornecedor, cfCliente);
    objLiberacao.blnAnAnalitica := True;
    objLiberacao.cdsXmlF4 := cdCdsXmlF4;
