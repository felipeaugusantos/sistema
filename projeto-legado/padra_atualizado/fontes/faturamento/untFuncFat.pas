function TFatVenda.fVaiGerarPedidoParaTodosOsDesmembramentos(const strOriF11_: String; const AMatrizesDesmembramento : TMatrizesFechamento) : Boolean;
  Var
    intCount : Integer;
begin
  If (Length(AMatrizesDesmembramento) <= 0) Then
