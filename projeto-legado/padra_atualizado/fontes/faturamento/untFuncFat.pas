function TFatVenda.fPdOrFoiIntegralmenteFaturado(out strMsg: String): Boolean;
  Var
    i: Integer;
    qryGen: TUniQuery;
begin
  qryGen := fCriaQuery(Nil);
  strMsg := '';
  Try
    qryGen.SQL.Text := 
              ' SELECT MOVDET.AUTOINCREM FROM MOVDET ' +
              '   INNER JOIN MOVAUX ON MOVAUX.DET_SEQGER = MOVDET.AUTOINCREM ' +
              '  WHERE DET_NUMDOC = :NUMDOC ' +
              '    AND DET_ESPDOC = :ESPDOC ' +
              '    AND DET_CODEMP = :CODEMP ' +
              '    AND DET_INC_PD = :INC_PD ';
   
    For i := 0 To Length(arrMatItens) - 1 Do
    Begin
      qryGen.Close;
      qryGen.ParamByName('NUMDOC').AsString := Self.strNumDoc;
      qryGen.ParamByName('ESPDOC').AsString := Self.strEspDoc;
      qryGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
      qryGen.ParamByName('INC_PD').AsString := arrMatItens[i].strSeqDet;
      qryGen.Open;

      If qryGen.IsEmpty Then
      Begin
        strMsg := strMsg + #13#10 + arrMatItens[i].strCodIte+' '+arrMatItens[i].strDesIte;
      End;
    End;
  Finally
    qryGen.Close;
    Result := fEmptyStr(strMsg);
    FreeAndNil(qryGen);
  End;
end;

function TFatVenda.fFaturaPedidosVenda(blnAtuExp: Boolean): Boolean;
  Var
    intContador: Integer;
    qryAux001: TUniQuery;
    blnFaturar: Boolean;
    blnBaixou: Boolean;
    blnApagaCadRec: Boolean;
    strSQL: String;
    strGerPenTmp: String;
    qryCtrCnf: TUniQuery;
    strLisDetAux: String;
    strLisFdoSeqGer: String;
    blnLisDetAuxVazia: Boolean;
    i: Integer;
    strAutIncNumLead: string;
    objLead: ILeads;

  function fDocumentoEstaNaMatrizDePedidos(strNumDoc, strEspDoc, strCodEmp: String): Boolean;
    Var
      i: Integer;
  begin
    Result := False;

    For i := 0 To Length(arrPedidos) - 1 Do
      If (strNumDoc = arrPedidos[i].strNumPed) And
         (strEspDoc = arrPedidos[i].strEspPed) And
         (strCodEmp = arrPedidos[i].strEmpPed) Then
    Begin
      Result := True;
      Break
    End;
  end;

  function fFaturandoPedidosDiferentes: Boolean;
    Var
      i: Integer;
      strAux: String;
  begin
    Result := False;

    If (blnExpedi) Then
    Begin
      Result := True
    End
    Else
    Begin
      For i := 0 To Length(arrPedidos) - 1 Do
      Begin
        If (Not fEmptyStr(strAux)) And
           (strAux <> arrPedidos[i].strNumPed+
                      arrPedidos[i].strEspPed+
                      arrPedidos[i].strEmpPed) Then
        Begin
          Result := True;
          Break
        End;

        strAux := arrPedidos[i].strNumPed+
                  arrPedidos[i].strEspPed+
                  arrPedidos[i].strEmpPed;
      End;

      If (Result) Then
      Begin
        For i := 0 To Length(arrMatItens) - 1 Do
        Begin
          If Not fDocumentoEstaNaMatrizDePedidos(arrMatItens[i].strNumOrc,
                                                 arrMatItens[i].strEspOrc,
                                                 arrMatItens[i].strEmpOrc) Then
          Begin
            Result := False;
            Break;
          End;
        End;
      End;
    End;
  end;

  function fRetCodMatItens: String;
    Var
      i: Integer;
  begin
    Result := '';

    If fFaturandoPedidosDiferentes Then
    Begin
      For i := 0 To Length(arrMatItens) - 1 Do
        If (arrMatItens[i].strNumOrc = arrPedidos[intContador].strNumPed) And
           (arrMatItens[i].strEspOrc = arrPedidos[intContador].strEspPed) And
           (arrMatItens[i].strEmpOrc = arrPedidos[intContador].strEmpPed) Then
        Begin
          pIncrementaListaStr(arrMatItens[i].strCodIte, Result, True);
        End;
    End
    Else
    Begin
      For i := 0 To Length(arrMatItens) - 1 Do
        pIncrementaListaStr(arrMatItens[i].strCodIte, Result, True);
    End
  end;

  function fRetSeqGerPedido: String;
    Var
      i: Integer;
  begin
    Result := '';

    If fFaturandoPedidosDiferentes Then
    Begin
      For i := 0 To Length(arrMatItens) - 1 Do
        If (arrMatItens[i].strNumOrc = arrPedidos[intContador].strNumPed) And
           (arrMatItens[i].strEspOrc = arrPedidos[intContador].strEspPed) And
           (arrMatItens[i].strEmpOrc = arrPedidos[intContador].strEmpPed) Then
        Begin
          pIncrementaListaStr(fCampoTabela('FDO_SEQGER', 'FATDOR', ['AUTOINCREM'], [arrMatItens[i].strSeqDet]), Result, True);
          Break;
        End;
    End
    Else
    Begin
      If (Length(arrMatItens) > 0) Then
        pIncrementaListaStr(fCampoTabela('FDO_SEQGER', 'FATDOR', ['AUTOINCREM'], [arrMatItens[0].strSeqDet]), Result, True);
    End;
  end;

  function fManterFinanceiroBoletosAdiantamentoPedido(): Boolean;
  begin
    Result := False;

    If Not blnExpedi Then
      Exit;

    If fltBolAdt = 0 Then
      Exit;

    If fltTotalBoletosAdiantamentoJaImpressos > 0 Then
      Exit(True);

    If fltTotalBoletosAdiantamentoJaEnviados > 0 Then
      Exit(True);
  end;

  function fApagarFinanceiroBoletosAdiantamentoPedido(): Boolean;
  begin
    Result := True;

    If Not blnExpedi Then
      Exit(False);

    If fltBolAdt = 0 Then
      Exit(False);

    If fltTotalBoletosAdiantamentoJaImpressos > 0 Then
      Exit(False);

    If fltTotalBoletosAdiantamentoJaEnviados > 0 Then
      Exit(False);
  end;

  function fRetSeqIndMatItens: String;
    Var
      i: Integer;
  begin
    Result := '';

    If fFaturandoPedidosDiferentes Then
    Begin
      For i := 0 To Length(arrMatItens) - 1 Do
        If (arrMatItens[i].strNumOrc = arrPedidos[intContador].strNumPed) And
           (arrMatItens[i].strEspOrc = arrPedidos[intContador].strEspPed) And
           (arrMatItens[i].strEmpOrc = arrPedidos[intContador].strEmpPed) Then
        Begin
          pIncrementaListaStr(IntToStr(arrMatItens[i].intSeqInd), Result);
        End;
    End
    Else
    Begin
      For i := 0 To Length(arrMatItens) - 1 Do
        pIncrementaListaStr(IntToStr(arrMatItens[i].intSeqInd), Result);
    End;
  end;

begin
  qryCtrCnf := fCriaQuery(Self);
  qryAux001 := fCriaQuery(Self);
  objLead   := TLeads.New();
  Try
    Try
      strLisDetAux := IIf((Not fEmptyStr(fRetSomenteNumeros(strLisDet))) And (Pos(strOpcDoc, 'CP_') > 0), strLisDet, '');

      With qryCtrCnf Do
      Begin
        Close;
        SQL.clear;
        SQL.Add('SELECT * FROM CTRCNF WHERE FALSE');
        Open;
      End;

      strSQL := '';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  COUNT(*) AS QTD ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  FATDOR ';
      strSQL := strSQL + 'WHERE ';

      {Teremos casos de quantidade maior quando envio de mercadoria,
       esses casos precisam baixar o pedido normalmente, pois será feito TA
       da quantidade do pedido depois!}
      If Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Then
        strSQL := strSQL + '  (FDO_QTDBAI < FDO_QTDITE AND FDO_JAFATU = 0) AND '
      Else
        strSQL := strSQL + '  (FDO_QTDBAI <> FDO_QTDITE AND FDO_JAFATU = 0) AND ';

      strSQL := strSQL + '  FDO_PROEMB <> "S" AND ';
      strSQL := strSQL + '  FDO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  FDO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  FDO_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '  FDO_CODITE <> ' + QuotedStr(fCfgSis('ITEMAN')) + ' AND ';
      strSQL := strSQL + '  FDO_CODITE <> ' + QuotedStr(fCfgSis('ITELAN')) + ' AND ';
      strSQL := strSQL + '  FDO_CODITE <> ' + QuotedStr(fCfgSis('ITEBOM')) + ' AND ';
      strSQL := strSQL + '  FDO_CODITE <> ' + QuotedStr(fCfgSis('ITETAX'));

      If (Length(arrMatItens) > 0) And (((blnExpedi) And Assigned(objExpedicao) And (Not objExpedicao.blnExpParcial)) Or (Not fEmptyStr(strNumDocsPD))) And
         (Not blnDeletouItenCp) And (Not fEmptyStr(fRetCodMatItens)) Then
        strSQL := strSQL + '  AND FDO_CODITE IN (' + fRetCodMatItens + ') ';

      With qryAux001 Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
      End;

      For intContador := Low(arrPedidos) To High(arrPedidos) Do
      Begin

        {*****************************************}
        {* ATUALIZA O FRETE BAIXADO.             *}
        {**************************************MV*}
        If Pos(strOpcDoc, 'CP_OV_') > 0 Then
        Begin
          pAtualizaFreBai(arrPedidos[intContador].strNumPed,
                          arrPedidos[intContador].strEspPed,
                          arrPedidos[intContador].strEmpPed);
        End;

        {*******************************************}
        {* VERIFICA SE TEM ALGUM ITEM EM ABERTO    *}
        {****************************************MV*}
        With qryAux001 Do
        Begin
          Close;
          ParamByName('NUMDOC').AsString := arrPedidos[intContador].strNumPed;
          ParamByName('ESPDOC').AsString := arrPedidos[intContador].strEspPed;
          ParamByName('CODEMP').AsString := arrPedidos[intContador].strEmpPed;
          Open;
          blnFaturar := (FieldByName('QTD').AsInteger = 0);
          Close;
        End;

        blnBaixou := False;

        If (blnFaturar) Then
        Begin
          {*******************************************}
          {* CASO ESTEJA ALTERANDO UM PEDIDO E AS    *}
          {* QUANTIDADES DE TODOS OS ITENS FORAM DI- *}
          {* MINUÍDAS PARA A QUANTIDADE BAIXADA, BUS-*}
          {* CA PELO ÚLTIMO DOCUMENTO QUE FOI FATURA-*}
          {* DO E MARCA O PEDIDO.                    *}
          {****************************************MV*}

          If (strNumDoc = arrPedidos[intContador].strNumPed) And
             (strEspDoc = arrPedidos[intContador].strEspPed) Then
          Begin

            strSQL := '';
            strSQL := strSQL + 'SELECT ';
            strSQL := strSQL + '  DET_DTAENT, ';
            strSQL := strSQL + '  DET_NUMDOC, ';
            strSQL := strSQL + '  DET_ESPDOC, ';
            strSQL := strSQL + '  DET_CODVEN, ';
            strSQL := strSQL + '  DET_CONPAG, ';
            strSQL := strSQL + '  DET_CODCLI, ';
            strSQL := strSQL + '  DET_SERIE_, ';
            strSQL := strSQL + '  GER_VLRCON ';
            strSQL := strSQL + 'FROM ';
            strSQL := strSQL + '  MOVGER, ';
            strSQL := strSQL + '  MOVDET ';
            strSQL := strSQL + 'WHERE ';
            strSQL := strSQL + '  MOVGER.AUTOINCREM = DET_SEQGER AND ';
            strSQL := strSQL + '  DET_NUM_PD = :NUMPED AND ';
            strSQL := strSQL + '  DET_ESP_PD = :ESPPED AND ';
            strSQL := strSQL + '  DET_CODEMP = :CODEMP ';
            strSQL := strSQL + 'ORDER BY ';
            strSQL := strSQL + '  1 DESC ';

            strSQL := strSQL + 'LIMIT 1 ';

            With qryAux001 Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add(strSQL);
              ParamByName('NUMPED').AsString := strNumDoc;
              ParamByName('ESPPED').AsString := strEspDoc;
              ParamByName('CODEMP').AsString := VS_strCodEmp;
              Open;

              If Not blnReutilizarOrcamento Then
              Begin
                blnBaixou := fMarcaOrcPed(FieldByName('DET_NUMDOC').AsString,
                                          FieldByName('DET_ESPDOC').AsString,
                                          arrPedidos[intContador].strNumPed,
                                          arrPedidos[intContador].strEspPed,
                                          FieldByName('DET_CODVEN').AsString,
                                          FieldByName('DET_CONPAG').AsString,
                                          FieldByName('GER_VLRCON').AsFloat,
                                          arrPedidos[intContador].strEmpPed,
                                          blnAtuExp,
                                          '',
                                          '',
                                          '',
                                          '',
                                          '',
                                          False,
                                          blnGravarCadRec,
                                          FieldByName('DET_CODCLI').AsString,
                                          FieldByName('DET_SERIE_').AsString,
                                          blnExecutandoFaturadorAutomatico);

                if (not blnBaixou) then
                begin
                  Result := False;
                  Exit;
                end;

                If (VS_strHabilitarCRM) And (Not fEmptyStr(fCfgSis('VENORC', varString))) And (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
                begin
                  objOcoCrm := fAtualizaInformacoesCRM(FieldByName('DET_NUMDOC').AsString,
                                                       FieldByName('DET_ESPDOC').AsString,
                                                       arrPedidos[intContador].strEmpPed,
                                                       strCodCli,
                                                       arrPedidos[intContador].strNumPed,
                                                       arrPedidos[intContador].strEspPed,
                                                       FieldByName('DET_CODVEN').AsString,
                                                       afcPedidoFaturado,
                                                       VS_strCodEmp,
                                                       strCliCgc,
                                                       strCliAnt);
                  If fDeveGerarOcorrenciaCRMParaProspecto Then
                  Begin
                    objOcoCrm.strCodPro := strProspe;
                    objOcoCrm.strTip_FC := 'P';
                  End;
                  objOcoCrm.strNomFrm := '[TFatVenda.fFaturaPedidosVenda 1]';
                end;
              End;

              Close;
            End;

          End
          Else
          Begin

            If Not blnReutilizarOrcamento Then
            Begin
              If (fCfgSis('UTICRM', varBoolean, IIF(fEmptyStr(arrPedidos[intContador].strEmpPed), VS_strCodEmp, arrPedidos[intContador].strEmpPed))) And
                 (Not fEmptyStr(fCfgSis('VENORC', varString, IIF(fEmptyStr(arrPedidos[intContador].strEmpPed), VS_strCodEmp, arrPedidos[intContador].strEmpPed)))) And
                 (Not fEmptyStr(fCfgSis('VENPED', varString, IIF(fEmptyStr(arrPedidos[intContador].strEmpPed), VS_strCodEmp, arrPedidos[intContador].strEmpPed)))) Then
              begin
                objOcoCrm := fAtualizaInformacoesCRM(strNumDoc,
                                                     strEspDoc,
                                                     arrPedidos[intContador].strEmpPed,
                                                     strCodCli,
                                                     arrPedidos[intContador].strNumPed,
                                                     arrPedidos[intContador].strEspPed,
                                                     strCodVen,
                                                     IIF(arrPedidos[intContador].strEspPed = 'OR',afcOrcamentoFaturado,afcPedidoFaturado),
                                                     VS_strCodEmp,
                                                     strCliCgc,
                                                     strCliAnt);

                If blnEntregaImediataEmNovoPedido Then
                  objOcoCrm.SetFinalizaOcorrenciaPdOriginal(True);

                If fDeveGerarOcorrenciaCRMParaProspecto Then
                Begin
                  objOcoCrm.strCodPro := strProspe;
                  objOcoCrm.strTip_FC := 'P';
                End;

                objOcoCrm.strEmpOri := strEmpOri;
                objOcoCrm.strNomFrm := '[TFatVenda.fFaturaPedidosVenda 2]';

                If Pos(strOpcDoc, 'PD_OR_') = 0 Then
                  TAtuOcoCrm(objOcoCrm).pProcessaFatOcorrenciasCRM;
              end;

              strLisFdoSeqGer := '';
              blnLisDetAuxVazia := strLisDetAux = '';
              if (strOpcDoc = 'CP') and fCfgSis('RMPDPA', varBoolean) then
              begin
                For i := 0 To Length(arrMatItens) - 1 Do
                begin
                  pIncrementaListaStr(fCampoTabela('FDO_SEQGER', 'FATDOR', ['AUTOINCREM'], [arrMatItens[i].strSeqDet]), strLisFdoSeqGer, True);
                  if blnLisDetAuxVazia then
                    pIncrementaListaStr(arrMatItens[i].strSeqDet, strLisDetAux, True);
                end;
              end;

              blnBaixou := fMarcaOrcPed(strNumDoc,
                                        strEspDoc,
                                        arrPedidos[intContador].strNumPed,
                                        arrPedidos[intContador].strEspPed,
                                        strCodVen,
                                        strConPag,
                                        fltTotGer,
                                        arrPedidos[intContador].strEmpPed,
                                        blnAtuExp,
                                        strLisDetAux,
                                        '',
                                        '',
                                        strLisFdoSeqGer,
                                        '',
                                        False,
                                        blnGravarCadRec,
                                        strCodCli,
                                        IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                                        blnExecutandoFaturadorAutomatico);

              if blnBaixou And fEhPedidoReposicaoClienteGarantia then
                 blnBaixou := fBaixaGarantiaReprovada(arrPedidos[intContador].strNumPed,
                                                    arrPedidos[intContador].strEspPed,
                                                    arrPedidos[intContador].strEmpPed);

              if (not blnBaixou) then
              begin
                Result := False;
                Exit;
              end;
            End;

          End;

        End

        Else If (Pos(strOpcDoc, 'CO_') = 0) Then
          pAtualizarOcorrenciaFaturadoParcial(arrPedidos[intContador].strEmpPed,
                                              arrPedidos[intContador].strNumPed,
                                              arrPedidos[intContador].strEspPed,
                                              False);

        fCopiarLocaisArmColetor(
          arrPedidos[intContador].strNumPed,
          arrPedidos[intContador].strEspPed,
          arrPedidos[intContador].strEmpPed);

        strGerPenTmp := fRetGerarPendencia(arrPedidos[intContador].strNumPed,
                                           arrPedidos[intContador].strEspPed,
                                           arrPedidos[intContador].strEmpPed);

        If (Not blnBaixou) And (blnExpedi) And Assigned(objExpedicao) And (objExpedicao.blnExpParcial) Then
        Begin
          if not fMarcaOrcPed(strNumDoc,
                              strEspDoc,
                              Copy(strDocExp, 01, 12),
                              Copy(strDocExp, 14, 02),
                              strCodVen,
                              strConPag,
                              fltTotGer,
                              Copy(strDocExp, 17, 03),
                              blnAtuExp,
                              '',
                              '',
                              fRetCodMatItens(),
                              fRetSeqGerPedido(),
                              fRetSeqIndMatItens(),
                              False,
                              blnGravarCadRec,
                              strCodCli,
                              IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                              blnExecutandoFaturadorAutomatico) then
          begin
            Result := False;
            Exit;
          end;
        End
        Else If (Not blnBaixou) And (strOpcDoc = 'CO') Then
        Begin
          If Not fMarcaOrcPed(strNumDoc,
                              strEspDoc,
                              strNumOrc,
                              strEspOrc,
                              strCodVen,
                              strConPag,
                              fltTotGer,
                              strEmpOri,
                              blnAtuExp,
                              EmptyStr,
                              EmptyStr,
                              EmptyStr,
                              EmptyStr,
                              EmptyStr,
                              False,
                              blnGravarCadRec,
                              strCodCli,
                              IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                              blnExecutandoFaturadorAutomatico) Then
          Begin
            Result := False;
            Exit;
          End;
        End;

        strAutIncNumLead := TLeads.fObterNumLead(arrPedidos[intContador].strEmpPed, arrPedidos[intContador].strEspPed, arrPedidos[intContador].strNumPed);
        If Not fEmptyStr(strAutIncNumLead) then
        Begin
          objLead.strNomeFrmOrigem := FstrNomFrm;
          objLead.pCarregarDadosLead(strAutIncNumLead);
          If Assigned(objExpedicao) And objExpedicao.blnExpParcial then
            objLead.fAlterarStatusLeadBancoDados(slFaturamentoParcial, strAutIncNumLead)
          Else
          Begin
            If Not fPedidoFaturadoParcialmente(arrPedidos[intContador].strNumPed, arrPedidos[intContador].strEspPed, arrPedidos[intContador].strEmpPed) Then
              objLead.fAlterarStatusLeadBancoDados(slAndamento, strAutIncNumLead);
          End;
        End;


        {************************************************}
        {* CASO DELETOU ALGUM ITEN NA CONFIRMACAO DO PD *}
        {59467*****************************************LE}
        If (blnDeletouItenCp) Then
        Begin
          if not fMarcaOrcPed(strNumDoc,
                              strEspDoc,
                              strNumOrc,
                              strEspOrc,
                              strCodVen,
                              strConPag,
                              fltTotGer,
                              strEmpOri,
                              blnAtuExp,
                              '',
                              '',
                              fRetCodMatItens(),
                              fRetSeqGerPedido(),
                              fRetSeqIndMatItens(),
                              False,
                              blnGravarCadRec,
                              strCodCli,
                              IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                              blnExecutandoFaturadorAutomatico) then
          begin
            Result := False;
            Exit;
          end;
        End;

        //SEMPRE MANTER pBaixaPedido APÓS A CHAMADA DA FUNÇÃO fMarcaOrcPed
        If (Not blnBaixou)                     And
           (blnExpedi)                         And
           ((fCfgSis('UTIPEN', VarBoolean) And (Pos(fCfgSis('TIPEXP'), '3_4_') > 0) And (strGerPenTmp = 'N')) OR
            (blnCliFil And (Not fCfgSis('PENTRA', varBoolean)))) Then
        Begin
          pBaixaPedido(arrPedidos[intContador].strNumPed,
                       arrPedidos[intContador].strEspPed,
                       arrPedidos[intContador].strEmpPed,
                       fCfgSis('OCCOPD', varString),
                       '',
                       strNumDoc,
                       strEspDoc,
                       VS_strCodEmp);
        End;

        blnApagaCadRec := False;

        If ((Pos(strOpcDoc, 'CP_OV_') > 0) Or
            (blnConfOrcamento And (arrPedidos[intContador].strEspPed = 'PD')) Or
            ((strEspOrc = 'PD') And (strEspDoc <> 'PD'))) Then
        Begin
          blnApagaCadRec := True;
        End;

        {************************************************************************}
        {* SE FOR APENAS A EMISSAO DA SIMPLES REMESSA DE CONCRETO DA SECOL, NAO *}
        {* DEVE APAGAR O CONTAS A RECEBER DO PEDIDO                             *}
        {*********************************************************************JC*}
        If (fCfgSis('TPNFCR') = SECOL) Then
        Begin
          If (Length(arrMatItens) > 0) And
             (fEhItemSimplesRemessaConcreto(arrMatItens[0])) Then
          Begin
            blnApagaCadRec := False;
          End;
        End;

        If blnApagaCadRec And fGerouBoletoAdiantamentoParcialPedido Then
          blnApagaCadRec := False;

        If blnApagaCadRec Then
        Begin
          If fManterFinanceiroBoletosAdiantamentoPedido Then
          Begin
            If Assigned(objExpedicao) And objExpedicao.blnEhUmaExpedicaoParcialOuTemPedidosFaturadosParcialmente Then
            Begin
              pAtualizarHistoricoDuplicataBoletoAdiantamento(arrPedidos[intContador].strNumPed,
                                                             arrPedidos[intContador].strEspPed,
                                                             arrPedidos[intContador].strEmpPed,
                                                             'Faturamento - ' + Self.strNumDoc + '-' +
                                                                                Self.strEspDoc + '-' +
                                                                                Self.strEmpDoc + ' - '+
                                                             'Valor Total ' + FormatFloat('#,##0.00', Self.fltTotGer));
            End
            Else
            Begin
              pCopiaParaCtrCnf(arrPedidos[intContador].strNumPed,
                               arrPedidos[intContador].strEspPed,
                               arrPedidos[intContador].strEmpPed,
                               fltTotGer,
                               fltTotGer,
                               qryCtrCnf);

              pAtualizarNumeroDuplicataBoletoAdiantamento(arrPedidos[intContador].strNumPed,
                                                          arrPedidos[intContador].strEspPed,
                                                          arrPedidos[intContador].strEmpPed);
            End;
          End
          Else If fApagarFinanceiroBoletosAdiantamentoPedido Then
          Begin
            pDeletaCadRec(arrPedidos[intContador].strNumPed,
                          arrPedidos[intContador].strEspPed,
                          arrPedidos[intContador].strEmpPed);

            TAdiantamentoGenerico.pAtualizaValorBoletosAdiantamentoDoPedido(
              arrPedidos[intContador].strNumPed,
              arrPedidos[intContador].strEspPed,
              arrPedidos[intContador].strEmpPed,
              strCodCli);
          End
          Else
          Begin
            pCopiaParaCtrCnf(arrPedidos[intContador].strNumPed,
                             arrPedidos[intContador].strEspPed,
                             arrPedidos[intContador].strEmpPed,
                             fltTotGer,
                             fltTotGer,
                             qryCtrCnf);

            pDeletaCadRec(arrPedidos[intContador].strNumPed,
                          arrPedidos[intContador].strEspPed,
                          arrPedidos[intContador].strEmpPed);
          End;
        End;

        {*******************************************}
        {* VERIFICA SE TEM ALGUM ITEM EM ABERTO    *}
        {****************************************MV*}
        With qryAux001 Do
        Begin
          Close;
          ParamByName('NUMDOC').AsString := arrPedidos[intContador].strNumPed;
          ParamByName('ESPDOC').AsString := arrPedidos[intContador].strEspPed;
          ParamByName('CODEMP').AsString := arrPedidos[intContador].strEmpPed;
          Open;

          pAtivaDisparoDeEmailSmsWhatsappDePedidosFaturados((FieldByName('QTD').AsInteger <> 0), arrPedidos[intContador].strEspPed);

          If (Pos(strOpcDoc, 'CO_') > 0) Then
            pAtualizarOcorrenciaFaturadoParcial(arrPedidos[intContador].strEmpPed,
                                                arrPedidos[intContador].strNumPed,
                                                arrPedidos[intContador].strEspPed,
                                                qryAux001.FieldByName('QTD').AsInteger = 0);

          Close;
        End;

      End;

      If ((Self.fltTotSer > 0) And (Self.fltTotPro <= 0)) And
         (Pos(strOpcDoc, 'CP_') > 0) And
         ((Not fEmptyStr(fRetSomenteNumeros(Self.strLisDetSer.strLisCodIteSer))) And (Not fEmptyStr(fRetSomenteNumeros(Self.strLisDetSer.strLisFdoSeqGer)))) Then
      begin
        if not fMarcaOrcPed(strNumDoc,
                            strEspDoc,
                            strNumOrc,
                            strEspOrc,
                            strCodVen,
                            strConPag,
                            fltTotGer,
                            strEmpOri,
                            blnAtuExp,
                            '',
                            '',
                            Self.strLisDetSer.strLisCodIteSer,
                            Self.strLisDetSer.strLisFdoSeqGer,
                            fRetSeqIndMatItens(),
                            False,
                            blnGravarCadRec,
                            strCodCli,
                            IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                            blnExecutandoFaturadorAutomatico) then
        begin
          Result := False;
          Exit;
        end;
      end;

      pVinculaFaturamentoContaOrdemNaRemessa;

      Result := True;
    Except
      On E: Exception Do
      Begin
        Result := False;
        Raise Exception.Create('[fFaturaPedidosVenda] ' + E.Message);
      End;
    End;
  Finally
    qryAux001.Close;
    FreeAndNil(qryAux001);
    FreeAndNil(qryCtrCnf);
  End;
end;

procedure TFatVenda.pAtualizarOcorrenciaFaturadoParcial(const strEmpParam, strNumParam, strEspParam: String;
  blnFinalizar: Boolean);
var
  objOcoCrm: TAtuOcoCrm;
Begin
  If Not (VS_strHabilitarCRM) Then
    Exit;

  If (Not fEmptyStr(fCfgSis('VENORC', varString))) And
     (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
  Begin
    objOcoCrm := fAtualizaInformacoesCRM(strNumDoc,
                                         strEspDoc,
                                         strEmpParam,
                                         IIF(blnAlterouClienteConfirmacaoPedidos And (strCliFat <> ''), strCliFat, strCodCli),
                                         strNumParam,
                                         strEspParam,
                                         strCodVen,
                                         afcPedidoFaturadoParcial,
                                         VS_strCodEmp,
                                         strCliCgc,
                                         strCliAnt);
    Try
      objOcoCrm.SetFulFillment(Self.Fulfillment.EhOperacaoFulfillment);

      If fDeveGerarOcorrenciaCRMParaProspecto Then
      Begin
        objOcoCrm.strCodPro := strProspe;
        objOcoCrm.strTip_FC := 'P';
      End;
      objOcoCrm.blnFinalizarOcoParcial := (Pos(strOpcDoc, 'CO_') > 0) And blnFinalizar;
      objOcoCrm.strNomFrm := '[TFatVenda.pAtualizarOcorrenciaFaturadoParcial]';
      TAtuOcoCrm(objOcoCrm).pProcessaFatOcorrenciasCRM;
    Finally
      FreeAndNil(objOcoCrm);
    End;
  End;
End;

