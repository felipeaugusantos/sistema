    End;

    If Length(arrResCfop) >= 3 Then
    Begin
      fatVenda.strResCf3  := arrResCfop[2].strClaFis + ' =' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotBas, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotVal, ffFixed, 12, 2), 9);
      fatVenda.strReTCf3  := arrResCfop[2].strClaFis + ' =' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotVal, ffFixed, 12, 2), 9);

      fatVenda.strReTCfD3 := arrResCfop[2].strClaFis + ' - ' +
                             fPadR(fRetDesCla(arrResCfop[2].strClaFis), 50) +
                                                       ' =' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotVal, ffFixed, 12, 2), 9);

      {**********************************}
      {* RESUMO DA AGUIA TINTAS 000/060 *}
      {*******************************JB*}
      If (Pos(RightStr(arrResCfop[2].strClaFis, 3), '_403_404_405_411') > 0) Then
        fatVenda.strCla060 := RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotVal, ffFixed, 12, 2), 9)
      Else
        fatVenda.strCla000 := RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotPro, ffFixed, 12, 2), 9) + ' ' + RightStr('       ' + FloatToStrF(arrResCfop[2].fltTotVal, ffFixed, 12, 2), 9);

    End;

  End;

