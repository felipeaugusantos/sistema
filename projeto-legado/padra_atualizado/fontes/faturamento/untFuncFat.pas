function TFatVenda.fGComProBrinde: Boolean;
  Var
    objComPro: TComPro;
    fltComiss: Double;
    strCodCom: String;
begin
  If VS_strTCoPro = '4' Then
  Begin
    Result := True;
    Exit;
  End;

  If fEmptyStr(strCodDiv) Then
  Begin
    Result := True;
    Exit;
  End;

  Try
    objComPro := TComPro.Create(Nil);
    objComPro.VS_strTCoProInterna := VS_strTCoPro;

    {************************************}
    {* RONALDO SOLICITOU DIA 15/10/2014 *}
    {*********************************FC*}
    //strCodDiv := fRetClienteProfissional(strCodCli);

    Result := True;

    If (VS_strTCoPro = '3') Then
    Begin

      If Not fEmptyStr(strCodDiv) Then
        fltComiss := fCalcTotPontosProfiss('')
      Else
        fltComiss := 0.0;

    End
    Else
    Begin

//      If (fVerificaTipoComissao(strCodDiv) <> '2') Then
//      Begin
//
//        fltComiss := fCalcTotalItensComissaoProfiss('');
//
//      End
//      Else
//      Begin

        fltComiss := fCalcComissaoProfissItemBrinde

//      End;

    End;

    {*****************************************************************}
    {* SE FOR VARIOS PROFISSONAIS, IRÁ GERAR O DEBITO PARA TODOS COM *}
    {* O VALOR TOTAL DA VENDA. SOLICITADO PELO RONALDO 15/10/2014    *}
    {**************************************************************FC*}
    If (fCfgSis('NROPRO') = '3') And (Assigned(cdsProfiss)) And (cdsProfiss.Active) Then
    Begin
      cdsProfiss.First;

      While Not cdsProfiss.Eof Do
      Begin
        If (fltComiss <> 0.0) Then
        Begin
          Result := objComPro.fGravaComPro(strCodCom,
                                           strNumDoc,
                                           strEspDoc,
                                           strCodCli,
                                           cdsProfiss.FieldByName('DIV_CODDIV').AsString,
                                           'D',
                                           'REFERENTE A FATURAMENTO',
                                           Abs(fltTotPro) - fltDesEsp,
                                           Abs(fltComiss),
                                           strNomeForm);
        End;

        cdsProfiss.Next;
      End;
    End
    Else
    Begin
      If (fltComiss <> 0.0) Then
      Begin
        Result := objComPro.fGravaComPro(strCodCom,
                                         strNumDoc,
                                         strEspDoc,
                                         strCodCli,
                                         strCodDiv,
                                         'D',
                                         'REFERENTE A FATURAMENTO',
                                         Abs(fltTotPro) - fltDesEsp,
                                         Abs(fltComiss),
                                         strNomeForm);
      End;
    End;

    FreeAndNil(objComPro);

  Except
    On E: Exception Do
    Begin
      Result := False;
      FreeAndNil(objComPro);
      pMensagensErro(E.Message,'[]');
    End;

  End;
end;

function TFatVenda.fCalcTotPontosProfiss(strCodDiv: String): Double;
  Var
    intCont: Integer;
    objAtiGru: TAtiGru;
begin
  objAtiGru := TAtiGru.Create(Self);
  objAtiGru.fCarregaAtiGru(fRetAtividadeProfissional(strCodDiv));

  Result := 0;

  For intCont := Low(ArrMatItens) To High(ArrMatItens) Do
  Begin
    With ArrMatItens[IntCont], objAtiGru Do
    Begin
      If IsEmpty Or //Caso nao tenha linhas/grupos informados para a atividade
         fLinhaGrupoJaInformado(strCodGru) Or //Caso o grupo permita comissao
         fLinhaGrupoJaInformado(LeftStr(strCodGru, 3) + '000') Then //Caso a Linha permita comissao
      Begin
        {**********************************************************************}
        {* QUANDO INFORMADO PONTOS E OPÇÃO CONFIG = 4, CALCULAR XX PONTOS     *}
        {* POR REAL VENDIDO                                                   *}
        {*******************************************************************RN*}
        If SameText(Self.strEspDoc, 'TR') Then
        Begin
          If SameText(ArrMatItens[IntCont].strEntSai, 'E') Then
          Begin
            If (fCfgSis('TCOPRO') = '4') Then
              Result := Result - ((fltTotIte - fltDesEsp) * fltQtdPon)
            Else
              Result := Result - ( fltQtdIte * fltQtdPon );
          End
          Else
          Begin
            If (fCfgSis('TCOPRO') = '4') Then
              Result := Result + ((fltTotIte - fltDesEsp) * fltQtdPon)
            Else
              Result := Result + ( fltQtdIte * fltQtdPon );
          End;
        End
        Else
        Begin
          If (fCfgSis('TCOPRO') = '4') Then
            Result := Result + ((fltTotIte - fltDesEsp) * fltQtdPon)
          Else
            Result := Result + ( fltQtdIte * fltQtdPon );
        End;
      End;

      fltBasComPro := fltTotIte - fltDesEsp;

      If (fCfgSis('TCOPRO') = '4') Then
        fltVlrComPro := ((fltTotIte - fltDesEsp) * fltQtdPon)
      Else
        fltVlrComPro := (fltQtdIte * fltQtdPon);

      fltPerComPro := fltQtdPon;
    End;
  End;

  objAtiGru.Destroy;
end;

procedure TFatVenda.pCalcComissaoProfissItem(objComPro: TComPro; strCodDiv: String;
  Var fltBaseComissao, fltValorComissao: Double; fltPerIteDef: Double = 0; strSomenteOsAutIncDet: String = '');
  Var
    intCont: Integer;
    fltPerIte: Double;
    objAtiGru: TAtiGru;
    fltCalTr_: Double;
begin
  objAtiGru := TAtiGru.Create(Self);
  objAtiGru.fCarregaAtiGru(fRetAtividadeProfissional(strCodDiv));

  fltBaseComissao := 0;
  fltValorComissao := 0;
  Try
    For intCont := Low(ArrMatItens) To High(ArrMatItens) Do
  Begin
    With ArrMatItens[IntCont], objAtiGru, objComPro Do
    Begin
      If ((Not strSomenteOsAutIncDet.IsEmpty) And (Pos(ArrMatItens[intCont].strAutIncDet, strSomenteOsAutIncDet) = 0)) Then
         Continue;

      If IsEmpty Or //Caso nao tenha linhas/grupos informados para a atividade
         fLinhaGrupoJaInformado(strCodGru) Or //Caso o grupo permita comissao
         fLinhaGrupoJaInformado(LeftStr(strCodGru, 3) + '000') Then //Caso a Linha permita comissao
        Begin
          fltPerIte := fRetComissaoProfissionalItem(strCodIte);

          If fltPerIte <= 0.00 Then
            fltPerIte := fltPerIteDef;

          ArrMatItens[IntCont].fltBasComPro := (fltTotIte - fltDesEsp);
          ArrMatItens[IntCont].fltVlrComPro := ((fltTotIte - fltDesEsp) * fltPerIte / 100);
          ArrMatItens[IntCont].fltPerComPro := fltPerIte;

          If (Self.strEspDoc = 'TR') And (ArrMatItens[IntCont].strEntSai = 'E') Then
            fltCalTr_ := -1
          Else
            fltCalTr_ := 1;

          fltBaseComissao  := fltBaseComissao  + (fltCalTr_ * ArrMatItens[IntCont].fltBasComPro);
          fltValorComissao := fltValorComissao + (fltCalTr_ * ArrMatItens[IntCont].fltVlrComPro);
        End;
      End;
    End;
  Finally
    objAtiGru.Destroy;
  End;
End;

function TFatVenda.fCalcComissaoProfissItemBrinde: Double;
  Var
    intCont: Integer;
Begin
  Result := 0;
  For intCont := Low(ArrMatItens) To High(ArrMatItens) Do
    Result := Result + (ArrMatItens[IntCont].fltTotIte - ArrMatItens[IntCont].fltDesEsp);
End;

function TFatVenda.fCalcTotalItensComissaoProfiss(strCodDiv: String;
                                                  blnEmPromoc: Boolean;
                                                  strSomenteOsAutIncDet: String = '';
                                                  blnSomenteCodDiv: Boolean = False): Double;
  Var
    intCont: Integer;
    objAtiGru: TAtiGru;
Begin
  objAtiGru := TAtiGru.Create(Self);
  objAtiGru.fCarregaAtiGru(fRetAtividadeProfissional(strCodDiv));

  Result := 0;

  For intCont := Low(ArrMatItens) To High(ArrMatItens) Do
  Begin
    With ArrMatItens[IntCont], objAtiGru Do
    Begin
      If (blnSomenteCodDiv) And (ArrMatItens[IntCont].strDivDev <> strCodDiv) Then
        Continue;

      If ((Not strSomenteOsAutIncDet.IsEmpty) And (Pos(ArrMatItens[intCont].strAutIncDet, strSomenteOsAutIncDet) = 0)) Then
         Continue;

      If IsEmpty Or //Caso nao tenha linhas/grupos informados para a atividade
         fLinhaGrupoJaInformado(strCodGru) Or //Caso o grupo permita comissao
         fLinhaGrupoJaInformado(LeftStr(strCodGru, 3) + '000') Then //Caso a Linha permita comissao
      Begin
        If (blnEmPromoc) Then
        Begin
          If SameText(Self.strEspDoc, 'TR') Then
          Begin
            If SameText(ArrMatItens[IntCont].strEntSai, 'E') Then
            Begin
              If (ArrMatItens[IntCont].strPromoc = 'S') Then
                Result := Result - (fltTotIte - fltDesEsp);
            End
            Else
            Begin
              If (ArrMatItens[IntCont].strPromoc = 'S') Then
                Result := Result + (fltTotIte - fltDesEsp);
            End;
          End
          Else
          Begin
            If (ArrMatItens[IntCont].strPromoc = 'S') Then
              Result := Result + (fltTotIte - fltDesEsp);
          End;
        End
        Else
        Begin
          If SameText(Self.strEspDoc, 'TR') Then
          Begin
            If SameText(ArrMatItens[IntCont].strEntSai, 'E') Then
            Begin
              If (ArrMatItens[IntCont].strPromoc = 'N') Then
                Result := Result - (fltTotIte - fltDesEsp);
            End
            Else
            Begin
              If (ArrMatItens[IntCont].strPromoc = 'N') Then
                Result := Result + (fltTotIte - fltDesEsp);
            End;
          End
          Else
          Begin
            If (ArrMatItens[IntCont].strPromoc = 'N') Then
              Result := Result + (fltTotIte - fltDesEsp);
          End;
        End;
      End;
    End;
  End;

  objAtiGru.Destroy;
End;

function TFatVenda.fUsaDocFutdoDocDev(itemDev: TDadosFechamento): TDadosDocDev;
  Var
    qryGen: TUniQuery;
    qryAux: TUniQuery;
    strTabDet,
    strTabTri,
    strDesIte: String;
begin
  Result.blnUsa := False;

  If (Not fEmptyStr(itemDev.strAiDvOr)) And (Pos(itemDev.strTabDev, 'MOVDET_') > 0) Then
  Begin
    strTabDet := itemDev.strTabDev;
    strTabTri := 'MOVTRI';

    qryGen := fCriaQuery;
    qryAux := fCriaQuery;
    Try
      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT ');
        SQL.Add('  DET_DOCFUT, DET_ESPFUT, DET_EMPFUT, DET_CLAFIS, DET_DESCRI, DET_INCFUT ');
        SQL.Add('FROM '+strTabDet+' INNER JOIN '+strTabTri+' ON '+strTabTri+'.DET_SEQGER='+strTabDet+'.AUTOINCREM');
        SQL.Add('WHERE AUTOINCREM = :AUTINC');
        ParamByName('AUTINC').AsString := itemDev.strAiDvOr;
        Open;

        If (Not IsEmpty) And (Not fEmptyStr(FieldByName('DET_DOCFUT').AsString))
          And (Pos(FieldByName('DET_CLAFIS').AsString, CLAFIS_ENTFUT_VEN) > 0) Then
        Begin
          Result.blnUsa := True;
          Result.strNumDoc := FieldByName('DET_DOCFUT').AsString;
          Result.strEspDoc := FieldByName('DET_ESPFUT').AsString;
          Result.strCodEmp := FieldByName('DET_EMPFUT').AsString;
          Result.strAutInc := FieldByName('DET_INCFUT').AsString;

          {********************************************************************************************************************************}
          {* CASO ESTEJA FAZENDO UMA DEVOLUÇÃO DE BAIXA DE ENTREGA FUTURA E CAMPO DET_INCFUT ESTEJA VAZIO (PERÍODO DE TRANSIÇÃO DE CÓPIA) *}
          {* E EXISTAM ITENS COM CÓDIGO REPETIDOS TENTA-SE ABAIXO DIFERENCIAR E PEGAR O AUTOINCREM CORRETO                                *}
          {*****************************************************************************************************************************VA*}
          strDesIte := FieldByName('DET_DESCRI').AsString;
          If fEmptyStr(Result.strAutInc) Then
          Begin
            With qryAux Do
            Begin
              Close;
              SQL.Clear;
              SQL.Add('SELECT ');
              SQL.Add('  AUTOINCREM, DET_DESCRI ');
              SQL.Add('FROM '+ strTabDet);
              SQL.Add('WHERE DET_NUMDOC = :NUMDOC');
              SQL.Add('  AND DET_ESPDOC = :ESPDOC');
              SQL.Add('  AND DET_CODEMP = :CODEMP');
              SQL.Add('  AND DET_CODITE = :CODITE');
              ParamByName('NUMDOC').AsString := Result.strNumDoc;
              ParamByName('ESPDOC').AsString := Result.strEspDoc;
              ParamByName('CODEMP').AsString := Result.strCodEmp;
              ParamByName('CODITE').AsString := itemDev.strCodIte;
              Open;

              If Not IsEmpty Then
              Begin
                If RecordCount = 1 Then
                Begin
                  Result.strAutInc := FieldByName('AUTOINCREM').AsString
                End
                Else
                Begin
                  qryAux.Locate('DET_DESCRI', strDesIte, []);
                  Result.strAutInc := FieldByName('AUTOINCREM').AsString
                End;
              End;
            End;
          End;
        End;
      End;
    Finally
      FreeAndNil(qryAux);
      FreeAndNil(qryGen);
    End;
  End;
end;

function TFatVenda.fUsaDocVendaConfDocDev(itemDev: TDadosFechamento): TDadosDocDev;
  Var
    qryGen: TUniQuery;

  procedure pBuscarRegistroVenda;
  begin
    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT ');
      SQL.Add('  AUTOINCREM, DET_NUMDOC, DET_ESPDOC, DET_CODEMP, DET_CLAFIS, DET_DESCRI ');
      SQL.Add('FROM ');
      SQL.Add('  MOVDET ');
      SQL.Add('WHERE ');
      SQL.Add('  DET_CODITE = :CODITE AND ');
      SQL.Add('  DET_NUMFAT = :NUMFAT AND ');
      SQL.Add('  DET_TIPFAT = :TIPFAT AND ');
      SQL.Add('  DET_EMPFAT = :EMPFAT ');

      If Not fEmptyStr(Result.strAutInc) Then
        SQL.Add('  AND AUTOINCREM = :AUTINC ');

      ParamByName('CODITE').AsString := itemDev.strCodIte;
      ParamByName('NUMFAT').AsString := itemDev.strDocDev;
      ParamByName('TIPFAT').AsString := itemDev.strEspDev;
      ParamByName('EMPFAT').AsString := itemDev.strEmpDev;

      If Not fEmptyStr(Result.strAutInc) Then
        ParamByName('AUTINC').AsString := Result.strAutInc;

      Open;
    end;
  end;

begin
  Result.blnUsa := False;
  //Verifica se é devolucao de um documento de confirmacao
  If (Not fEmptyStr(itemDev.strAiDvOr)) And (Pos(itemDev.strTabDev, 'NOTDET_') > 0) Then
  Begin
    //Retorna o autoincremento do documento de venda
    Result.strAutInc := fCampoTabela('DET_SEQDET', 'NOTTRI', ['DET_SEQGER'], [itemDev.strAiDvOr]);

    Try
      qryGen := fCriaQuery;

      With qryGen Do
      Begin
        pBuscarRegistroVenda;

        If IsEmpty And Not fEmptyStr(Result.strAutInc) Then
        Begin
          Result.strAutInc := '';
          pBuscarRegistroVenda;
        End;

        //Caso tenha encontrado mais de um registro (periodo de transicao NOTTRI -> DET_SEQDET IS NULL)
        If fEmptyStr(Result.strAutInc) And (RecordCount > 1) Then
        Begin
          //Retorna a descricao do produto gravada para tentar diferenciar pela mesma
          Filter := 'DET_DESCRI = ' +
            QuotedStr(fCampoTabela('DET_DESCRI', 'NOTDET', ['AUTOINCREM'], [itemDev.strAiDvOr]));
          Filtered := True;
        End;

        //Caso tenha encontrado exatamente um registro de produto confirmado
        If (RecordCount = 1) Then
        Begin
          Result.blnUsa := True;
          Result.strNumDoc := FieldByName('DET_NUMDOC').AsString;
          Result.strEspDoc := FieldByName('DET_ESPDOC').AsString;
          Result.strCodEmp := FieldByName('DET_CODEMP').AsString;
          Result.strAutInc := FieldByName('AUTOINCREM').AsString;
        End;
      End;

    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

function TFatVenda.fVerificaItemObrigCpfCnpj: Boolean;
  Var
    strMsg: String;
    cdsDados: TUniClientDataSet;
    frmObservacao : TfrmObservacao;
    blnCpfCnpjComProblema : Boolean;
begin
  blnCpfCnpjComProblema := ((fEmptyStr(strCliCgc)) Or (fStringRepetida(strCliCgc))) Or
                           (Not fValidaCnpjCpf(IntToStr(intCgcCpf), strCliCgc, False));

  If (Not blnCpfCnpjComProblema) Then
  Begin
    Result := True;
    Exit;
  End;

  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.Filtered := False;
    cdsDados.Filter := 'ITE_OBRCPF = ' + QuotedStr('S');
    cdsDados.Filtered := True;

    If (cdsDados.IsEmpty) Then
    Begin
      Result := True;
      Exit;
    End;

    Result := False;
    strMsg := EmptyStr;
    cdsDados.First;
    While Not cdsDados.Eof Do
    Begin
      strMsg := strMsg + cdsDados.FieldByName('ITE_CODITE').AsString + ' - ' + cdsDados.FieldByName('ITE_DESITE').AsString + sLineBreak;
      cdsDados.Next;
    End;

    pCriarFormularios(TfrmObservacao, frmObservacao);
    Try
      frmObservacao.lblMensagem.Caption := 'Itens que possuem obrigatoriedade de Cpf/Cnpj:';
      frmObservacao.memObs.Texto := strMsg;
      frmObservacao.ShowModal;
    Finally
      pFreeAndNil(frmObservacao);
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
end;

function TFatVenda.fVerificaItemObrigCodIbama: Boolean;
  Var
    strMsg: String;
    cdsDados: TUniClientDataSet;
begin

  cdsDados := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsDados, cdsVenda);

  Result := True;

  With cdsDados Do
  Begin
    First;
    strMsg := EmptyStr;
    While Not Eof Do
    Begin
      If FieldByName('ITE_OBRIBA').AsString = 'S' Then
      Begin
        strMsg := strMsg + fieldbyname('ITE_CODITE').AsString + ' - ' + fieldbyname('ITE_DESITE').AsString + #13#10;
        Result := False;
      End;
      Next;
    End;

    If Not fEmptyStr(strMsg) Then
    Begin

      If fEmptyStr(strCodIbama) And (Pos(strOpcDoc, 'VN_CP_PD_OR_') > 0) Then
      Begin
        Try
          pCriarFormularios(TfrmObservacao, frmObservacao);
          frmObservacao.lblMensagem.Caption := 'Itens que possuem obrigatoriedade de código IBAMA no cliente:';
          frmObservacao.memObs.Texto := strMsg;
          frmObservacao.ShowModal;
        Except
          On E: Exception Do
            pMensagensErro(E.Message, '[fVerificaItemObrigCodIbama]');
        End;

        pFreeAndNil(frmObservacao);

      End
      Else
        Result := True;
    End;

  End;

  FreeAndNil(cdsDados);
end;

function TFatVenda.fRetornaMatrizFormulacaoTintasAcumulada(FormulacaoIgnorar: TClassMatrizSaldosColorantes): TClassMatrizSaldosColorantes;
var
  strAutInc: String;
  intCount : Integer;
  intFormul: Integer;
  matrizSaldosAux,
  matrizSaldosColorantes: TClassMatrizSaldosColorantes;
  objRetorno: TObject;
begin
  matrizSaldosColorantes := TClassMatrizSaldosColorantes.Create();

  For intFormul := 0 To dicFormulas.Chaves.Count -1 Do
  Begin
    strAutInc := dicFormulas.Chaves[intFormul];
    objRetorno := dicFormulas.RetornaObjeto(strAutInc);

    if (Assigned(objRetorno) and (objRetorno.ClassName = TClassMatrizSaldosColorantes.ClassName)
      and (objRetorno <> FormulacaoIgnorar)) then
    Begin
      matrizSaldosAux  := TClassMatrizSaldosColorantes(objRetorno);

      if Assigned(matrizSaldosAux) then
      begin
        If (matrizSaldosAux.strCodEmp = FormulacaoIgnorar.strCodEmp) Then //Mesma Empresa de Producao
          For intCount := 0 To matrizSaldosAux.Count - 1 Do
            matrizSaldosColorantes.fAdicionar(matrizSaldosAux[intCount]);
      end;
    End;
  End;

  Result := matrizSaldosColorantes;
end;

function TFatVenda.fVerificaEstoqueTintaDeMaquina(Formulacao: TClassMatrizSaldosColorantes; strAutIncAlt: String): Boolean;
  Var
    intContador : Integer;
    matrizFormulacoesAcumulada: TClassMatrizSaldosColorantes;
begin
  Result := True;
  matrizFormulacoesAcumulada := nil;
  Try
    Try
      matrizFormulacoesAcumulada := fRetornaMatrizFormulacaoTintasAcumulada(Formulacao);

      For intContador := 0 To Formulacao.Count - 1 Do
        matrizFormulacoesAcumulada.fAdicionar(Formulacao[intContador]);

      matrizFormulacoesAcumulada.RecalcularAcumulados(Formulacao);

      For intContador := 0 To Formulacao.Count - 1 Do
      Begin
        Result := Result And Formulacao.GetBaseColoranteTemSaldo(intContador);
      End;
    Except
      on E: Exception do
      begin
        raise;
      end;
    End;
  Finally
    if Assigned(matrizFormulacoesAcumulada) then FreeAndNil(matrizFormulacoesAcumulada);
  End;
end;

function TFatVenda.fEhNecessarioValidarFlexNegativo : Boolean;
begin
  Result := False;

  If (fCfgSis('UTIFNS', varBoolean)) And ((blnAplicouFatorServico) Or (fTemFatorServico(strNumOrc, strEspOrc, strEmpOri))) Then
    Exit;

  Result := (Not fDocumentoParaFornecedor()) and (fGeraFlexOpe) and ((Pos(strOpcDoc, 'PD_VN_') > 0) or ((strOpcDoc = 'OR') and (strEspDoc = 'PD'))) and (not fTravouFlexNegativoPedido);
end;

function TFatVenda.fVerificaFlexNegativo(
  arrMatrizesFechamentoParam: TMatrizesFechamento): Boolean;
var
  blnTemItemFlex: Boolean;
  fltVlrFlexTot,
  fltVlrFlexVen,
  fltVlrFlexPed,
  fltVlrFlexItem: Double;
  intIndice,
  I: Integer;
  strCreDebFle: string;
  arrMatItensLocal: TMatrizFechamento;
begin
  Result := True;

  If (Not fEhNecessarioValidarFlexNegativo) Then
    Exit;

  blnTemItemFlex := False;

  if Assigned(arrMatrizesFechamentoParam) then
  begin
    for intIndice := 0 to Length(arrMatrizesFechamentoParam) - 1 do
    begin
      arrMatItensLocal := arrMatrizesFechamentoParam[intIndice];

      for I := 0 to Length(arrMatItensLocal) -1 do
      begin
        if fUsaFlex(arrMatItensLocal[I].strCodIte) then
        begin
          blnTemItemFlex := True;
          Break;
        end;
      end;
    end;


    if blnTemItemFlex then
    begin
      fltVlrFlexPed := 0;
      for intIndice := 0 to Length(arrMatrizesFechamentoParam) - 1 do
      begin
        arrMatItensLocal := arrMatrizesFechamentoParam[intIndice];

        for I := 0 to Length(arrMatItensLocal) -1 do
        begin
          fltVlrFlexItem := fCalculaValorFlex(arrMatItensLocal[I], strCreDebFle);

          If strCreDebFle = 'C' Then
            fltVlrFlexPed := fltVlrFlexPed + fltVlrFlexItem
          Else
            fltVlrFlexPed := fltVlrFlexPed - fltVlrFlexItem;
        end;
      end;
      fltVlrFlexVen := TMovFlex.fSaldoFlexDisponivelVendedor(strCodVen);
      fltVlrFlexTot := fltVlrFlexVen + fltVlrFlexPed;

      if fltVlrFlexTot < 0 then
      begin
        Result := fTravaFlexNegativo(fltVlrFlexVen, fltVlrFlexTot);
      end;
    end;
  end
  else
  begin
    for I := 0 to Length(arrMatItens) -1 do
    begin
      if fUsaFlex(arrMatItens[I].strCodIte) then
      begin
        blnTemItemFlex := True;
        Break;
      end;
    end;

    if blnTemItemFlex then
    begin
      fltVlrFlexPed := 0;
      for I := 0 to Length(arrMatItens) -1 do
      begin
        fltVlrFlexItem := fCalculaValorFlex(arrMatItens[I], strCreDebFle);

        If strCreDebFle = 'C' Then
          fltVlrFlexPed := fltVlrFlexPed + fltVlrFlexItem
        Else
          fltVlrFlexPed := fltVlrFlexPed - fltVlrFlexItem;
      end;
      fltVlrFlexVen := TMovFlex.fSaldoFlexDisponivelVendedor(strCodVen);
      fltVlrFlexTot := fltVlrFlexVen + fltVlrFlexPed;

      if fltVlrFlexTot < 0 then
      begin
        Result := fTravaFlexNegativo(fltVlrFlexVen, fltVlrFlexTot);
      end;
    end;
  end;
end;

function TFatVenda.fCaixaJaFoiFechado(Out AMensagem : String): Boolean;
  Var
    objTravaCaixa : TTravaCaixa;
begin

  Result := False;

  If Self.Fulfillment.EhOperacaoFulfillment Then
    Exit;

  If blnImpPafEcf Then
    Exit;

  objTravaCaixa := TTravaCaixa.New(strOpcDoc, True, 0, Self.strCodigoCaixa);

  Try

    If (objTravaCaixa.blnTravar) Then
    Begin
      AMensagem := objTravaCaixa.strMensagemDaTrava;
      Exit(True);
    End;

    If (objTravaCaixa.fCaixaDoDiaFechadoOuCaixaDoDiaAnteriorAindaNaoFechado) Then
    Begin

      If (fStatusCndPag(strConPag) = A_VISTA) Then
        If Not objTravaCaixa.blnApenasEmissaoDePD_OR_AVista Then
        Begin
          AMensagem := MSG_SOMENTE_A_PRAZO;
          Exit(True);
        End;

      If (fStatusCndPag(strConPag) = A_PRAZO) Then
        If Not objTravaCaixa.blnApenasEmissaoDeDocumentosAPrazo Then
        Begin
          AMensagem := MSG_SOMENTE_A_VISTA;
          Exit(True);
        End;

      If (fStatusCndPag(strConPag) = A_VISTA) And
         (Not (Pos(strEspDoc, 'PD_OR_') > 0) And (objTravaCaixa.blnApenasEmissaoDePD_OR_AVista)) And
         (objTravaCaixa.blnApenasEmissaoDeDocumentosAPrazo) Then
      Begin
        AMensagem := MSG_SOMENTE_A_PRAZO;
        Exit(True);
      End;
    End;

  Finally
    FreeAndNil(objTravaCaixa);
  End;

end;

function TFatVenda.fRetQtdDigitada(strCodIte,
                                   strNumLot,
                                   strAutInc,
                                   strCodAca,
                                   strEmpAca,
                                   strEmpIte                         : String;
                                   blnVerSeTravaEstoque              : Boolean = True;
                                   blnConsiderarTodosTiposEntFut     : Boolean = False;
                                   blnNaoConsNoCalcQtdLimUnitarMaior : Boolean = False;
                                   blnSomenteItensEmPromocao         : Boolean = False;
                                   blnDesconsideraEntFut             : Boolean = False;
                                   strOpcao                          : String = '';
                                   strAutIncExclu                    : String = '';
                                   strEntSai                         : String = '';
                                   cdsDadosPar                       : TUniClientDataSet = Nil;
                                   strLocRet                         : String = ''): Double;
  Var
    cdsDados: TUniClientDataSet;
    blnTrava: Boolean;
begin

  If fEmptyStr(strOpcao) Then
    strOpcao := strOpcDoc;

  Try
    If Assigned(cdsDadosPar) Then
    Begin
      cdsDados := cdsDadosPar;
      cdsDados.Filter := '';
    End
    Else
    Begin
      cdsDados := TUniClientDataSet.Create(Self);
      pCloneDataSet(cdsDados, cdsVenda);
    End;

    Result := 0.0;

    With cdsDados Do
    Begin

      If Not fEmptyStr(strCodAca) then
        Filter := 'ITE_CODACA = ' + QuotedStr(strCodAca) + ' AND ITE_EMPACA = ' + QuotedStr(strEmpAca)
      Else
        Filter := 'ITE_CODITE = ' + QuotedStr(strCodIte) + ' AND ITE_PROACA <> 1';

      If blnNaoConsNoCalcQtdLimUnitarMaior Then
        Filter := Filter + ' AND (ITE_PROMOC = ''S'') AND (ITE_UNITAR <= ITE_UNIORI) ';

      If blnSomenteItensEmPromocao Then
        Filter := Filter + ' AND (ITE_PROMOC = ''S'') ';

      If blnDesconsideraEntFut Then
        Filter := Filter + ' AND (ITE_ENTFUT <> ''S'') ';

      If Not fEmptyStr(strEntSai) Then
        Filter := Filter + ' AND (ITE_ENTSAI = ' + QuotedStr(strEntSai) +') ';
      
      If Not fEmptyStr(strLocRet) Then
        Filter := Filter + ' AND (ITE_LOCRET = ' + QuotedStr(strLocRet) +') ';

      Filtered := True;
      DisableControls;

      First;
      While Not Eof Do
      Begin
        If ((fEmptyStr(strAutIncExclu)) Or (Pos('_' + FieldByName('AUTOINCREM').AsString + '_', strAutIncExclu) <= 0)) And
           ((fEmptyStr(strEmpIte)) Or (Not blnEmpFat) Or (FieldByName('ITE_EMPITE').AsString = strEmpIte)) Then
        Begin
          If (FieldByName('ITE_ENTFUT').AsString <> 'S') Then
            blnTrava := True
          Else
          Begin
            If (FieldByName('ITE_MOTFUT').AsString = 'F') And (FieldByName('ITE_IDEPRO').AsString = 'NOR') Then
            Begin
               blnTrava := (Pos(fCfgSis(fCfgTravaSaldoEntFut(strOpcao, 'F')), 'A_T_') > 0);
            End
            Else
              blnTrava := (FieldByName('ITE_MOTFUT').AsString <> 'F') And
                          ((Pos(fCfgSis(fCfgTravaSaldoEntFut(strOpcao)), 'A_T_') > 0) Or
                           blnConsiderarTodosTiposEntFut);
          End;

          If (fCfgSis('BXSBIT') = '2') Or (fCfgSis('BXSBIT') = '3') Then
          Begin
            If (FieldByName('ITE_BXSBIT').AsString = 'S') Then
            Begin
              {********************************************************************}
              {* CASO A ORDEM DE PRODUCAO NAO TENHA SIDO EMITIDA OU AINDA NAO FOI *}
              {* BAIXADA, NAO DEVE CONSIDERAR O PRODUTO ESTRUTURA NA TRAVA JA QUE *}
              {* ESTA RESERVANDO O ESTOQUE DOS SUB.PRODUTOS. QUANDO A MESMA FOR   *}
              {* BAIXADA ENTAO PASSARA A RESERVAR O ESTOQUE DO ITEM ESTRUTURA POIS*}
              {* OS SUB.PRODUTOS JA FORAM BAIXADOS DO ESTOQUE                     *}
              {*****************************************************************JC*}
              If fEmptyStr(FieldByName('ITE_ORDPRO').AsString) Or
                 (Not TOrdPro.fOrdemProducaoBaixada(FieldByName('ITE_ORDPRO').AsString, VS_strCodEmp)) Then
              Begin
                blnTrava := False;
              End;
            End;
          End;

          If fEmptyStr(strAutInc) Then
          Begin
            If (FieldByName('ITE_CODITE').AsString = strCodIte) And
               (blnTrava Or (Not blnVerSeTravaEstoque))And
               (fEmptyStr(strNumLot) Or
                SameText(FieldByName('ITE_NUMLOT').AsString, strNumLot)) Then
              Result := Result + FieldByName('ITE_QTDITE').AsFloat;
          End
          Else
          Begin
            If (FieldByName('ITE_CODITE').AsString = strCodIte) And
               (FieldByName('AUTOINCREM').AsString <> strAutInc) And
               (blnTrava Or (Not blnVerSeTravaEstoque)) And
               (fEmptyStr(strNumLot) Or
                SameText(FieldByName('ITE_NUMLOT').AsString, strNumLot)) Then
              Result := Result + FieldByName('ITE_QTDITE').AsFloat;
          End;

        End;

        Next;
      End;

      EnableControls;
    End;

    {*****************************************************************************}
    {* SOMA COM A QUANTIDADE QUE ESTA DENTRO DE UM PRODUTO ESTRUTURA JA INSERIDO.*}
    {* POIS ENQUANTO NAO FOR BAIXADA A ORDEM DE PRODUCAO DEVE RESERVAR ESTOQUE...*}
    {*************************************************************************JC**}
    If (fCfgSis('BXSBIT') = '2') Or (fCfgSis('BXSBIT') = '3') Then
    Begin
      Result := Result + fRetQtdDigitadaSubItemEstrutura(cdsDados, strCodIte, strAutInc);
    End;

    {*******************************************************************************}
    {* SOMA COM A QUANTIDADE QUE ESTA DENTRO DE UMA ESTRUTURA DE VIDRO JA INSERIDO.*}
    {***************************************************************************JC**}
    If Assigned(objEstruturaVidros) Then
    Begin
      Result := Result + fRetQtdDigitadaSubItemVidro(cdsDados, strCodIte, strAutInc);
    End;

  Except
    On E: Exception Do
    Begin
      Result := 0;
      pMensagensErro(E.Message,'');
    End;
  End;

  If Not Assigned(cdsDadosPar) Then
    FreeAndNil(cdsDados);
  
end;

function TFatVenda.fRetQtdDigitadaSubItemEstrutura(cdsDados: TUniClientDataSet; strSubItem: String; strAutIncAlt: String = ''): Double;
  Var
    objItensEstrutura: TItensEstrutura;
    subItem: TSubItemEstrutura;
    intItem: Integer;
begin

  Try
    objItensEstrutura := TItensEstrutura.Create;

    Result := 0.0;

    With cdsDados Do
    Begin
      {*****************************************************************************}
      {* FILTRA OS PRODUTOS DO DOCUMENTO QUE IRAO BAIXAR ESTOQUE DOS SUB-PRODUTOS  *}
      {**************************************************************************JC*}
      Filter := 'ITE_BXSBIT = ' + QuotedStr('S');
      Filtered := True;
      DisableControls;

      First;
      While Not Eof Do
      Begin
        {*********************************************************************}
        {* CASO A ORDEM DE PRODUCAO NAO TENHA SIDO EMITIDA OU AINDA NAO FOI  *}
        {* BAIXADA, DEVE RESERVAR O ESTOQUE PARA OS SUB.PRODUTOS.            *}
        {* QUANDO A ORDEM DE PRODUCAO FOR BAIXADA ENTAO PASSARA A RESERVAR   *}
        {* O ESTOQUE DO ITEM ESTRUTURA POIS OS SUB.PRODUTOS JA FORAM BAIXADOS*}
        {* DO ESTOQUE....                                                    *}
        {*****************************************************************JC**}
        If MatchStr(strSubItem, fGetSubItensEstrutura(FieldByName('ITE_CODITE').AsString, VS_strCodEmp)) Then
          If fEmptyStr(FieldByName('ITE_ORDPRO').AsString) Or
             (Not TOrdPro.fOrdemProducaoBaixada(FieldByName('ITE_ORDPRO').AsString, VS_strCodEmp)) Then
        Begin
          {************************************}
          {* IGNORA O PRODUTO SENDO ALTERADO  *}
          {*********************************JC*}
          If FieldByName('AUTOINCREM').AsString <> strAutIncAlt Then
          Begin
            {****************************************}
            {* CARREGA OS SUB.PRODUTOS DA ESTRUTURA *}
            {*************************************JC*}
            objItensEstrutura.pCarregarEstrutura(FieldByName('ITE_CODITE').AsString,
                                                 FieldByName('ITE_QTDITE').AsFloat);

            {*************************************************}
            {* PROCURA PELO SUB.PRODUTO DENTRO DA ESTRUTURA  *}
            {**********************************************JC*}
            For intItem := 0 To objItensEstrutura.ItemsCount -1 Do
            Begin
              subItem := objItensEstrutura[intItem];

              If subItem.strCodigo = strSubItem Then
                Result := Result + subItem.fltQtdTot;
            End;
          End;
        End;

        Next;
      End;

      EnableControls;
    End;

  Except
    On E: Exception Do
    Begin
      Result := 0;
      pMensagensErro(E.Message,'');
    End;
  End;

  If Assigned(objItensEstrutura) Then
    FreeAndNil(objItensEstrutura);
end;

function TFatVenda.fRetQtdDigitadaSubItemVidro(cdsDados: TUniClientDataSet; strSubItem: String; strAutIncAlt: String = ''): Double;
  Var
    subItem : TSubItemVidro;
begin

  Try
    Result := 0.0;

    With cdsDados Do
    Begin
      {*****************************************************************************}
      {* FILTRA OS PRODUTOS DO DOCUMENTO QUE IRAO BAIXAR ESTOQUE DOS SUB-PRODUTOS  *}
      {**************************************************************************JC*}
      Filter := 'ITE_CODITE = ' + QuotedStr(fCfgSis('ITEVID'));
      Filtered := True;
      DisableControls;

      First;
      While Not Eof Do
      Begin
        {************************************}
        {* IGNORA O PRODUTO SENDO ALTERADO  *}
        {*********************************JC*}
        If (FieldByName('AUTOINCREM').AsString <> strAutIncAlt) And
           objEstruturaVidros.dicEstruturasSalvas.ContainsKey(FieldByName('AUTOINCREM').AsInteger) Then
        Begin
          {*************************************************}
          {* PROCURA PELO SUB.PRODUTO DENTRO DA ESTRUTURA  *}
          {**********************************************JC*}
          For subItem In objEstruturaVidros.dicEstruturasSalvas[FieldByName('AUTOINCREM').AsInteger].Items Do
          Begin
            If subItem.strCodigo = strSubItem Then
              Result := Result + subItem.fltQuantidadeVenda * FieldByName('ITE_QTDITE').AsFloat;
          End;
        End;

        Next;
      End;

      EnableControls;
    End;

  Except
    On E: Exception Do
    Begin
      Result := 0;
      pMensagensErro(E.Message,'');
    End;
  End;
end;

function TFatVenda.fObterClafisPedidoReposicaoClienteGarantia: String;
CONST
  SQL: String = ' SELECT DISTINCT FDO_CLAFIS FROM FATDOR WHERE FDO_NUMDOC = :NUMDOC AND FDO_ESPDOC = :ESPDOC AND FDO_CODEMP = :CODEMP ';
Var
  Qry: TUniQuery;
begin
  Result := EmptyStr;
  Qry := Nil;
  Try
    Qry := fCriaQuery;
    Qry.Close;
    Qry.Sql.Clear;
    Qry.Sql.Add(SQL);
    Qry.ParamByName('NUMDOC').AsString := strNumOrc;
    Qry.ParamByName('ESPDOC').AsString := strEspOrc;
    Qry.ParamByName('CODEMP').AsString := strEmpOri;
    Qry.Open;
    if Not Qry.IsEmpty then
    begin
      Qry.First;
      Result := Qry.FieldByName('FDO_CLAFIS').AsString;
    end;
  Finally
    if Assigned(Qry) then
      FreeAndNil(Qry);
  End;
end;

function TFatVenda.fGravaChaveReferenciadaExportacao(strAutInc: String): Boolean;
var
  qryChave: TUniQuery;
  intIndice: integer;
begin
  qryChave := fCriaQuery;

  try
    Result := False;

    qryChave.Close;
    qryChave.SQL.Clear;
    qryChave.SQL.Add('INSERT INTO REFFIS(FIS_SEQFIS, FIS_ACESSO) VALUES(:SEQFIS, :ACESSO)');

    for intIndice := 0 to Length(Self.arrChaveNFReferenciaDocumentos) - 1 do
    begin
      qryChave.Close;
      qryChave.ParamByName('SEQFIS').AsString := strAutInc;
      qryChave.ParamByName('ACESSO').AsString := Self.arrChaveNFReferenciaDocumentos[intIndice];
      qryChave.ExecSQL;
    end;

    Result := True;
  finally
    FreeAndNil(qryChave);
  end
end;

function TFatVenda.fOpcaoFaturamentoPermitidaSoliTE: Boolean;
begin
  Result := (Pos(strOpcDoc, 'VN_CS_TR_') > 0) And (fCfgSis('OPSOAB') = '2') And (Not blnEnt_CD);

  If (Not Result) Then
  Begin
    Result := ( fCfgSis('OPSOAB') = '1' ) And (Not blnEnt_CD) And
              ((strOpcDoc = 'PD') Or (strOriF11 = 'S') Or ((strOpcDoc = 'OR') And (strEspDoc = 'PD')));
  End;
end;

procedure TFatVenda.pProcessarItensParaSolicitacaoTransferencia;
  Var
    intIdx: Integer;
    fltSalAtu,
    fltQtdDig,
    fltQtdAnt: Double;
    blnPedSen: Boolean;
    blnSemEst: Boolean;
    blnSaiTsl: Boolean;
    strAutIncExclu: String;

  procedure pCarregarSubItensSemSaldo(AItemPai : TDadosFechamento);
  var
    LItemEst : TItensEstrutura;
    LSubItem : TSubItemEstrutura;
    LEmpresa : String;
    LidxItem : Integer;
    LQtdeDig : Double;
    LSaldAtu : Double;
    LQtedAnt : Double;
    LSemEstq : Boolean;
    LPedeSen : Boolean;
  begin

    LItemEst := TItensEstrutura.Create;

    Try

      LEmpresa := IIF(AItemPai.strEmpIte.IsEmpty, VS_strCodEmp, AItemPai.strEmpIte);
      LItemEst.pCarregarEstrutura(AItemPai.strCodIte, AItemPai.fltQtdIte, LEmpresa);

      If (LItemEst.ItemsCount <= 0) Then
        Exit;

      objSoliTE.blnCarregandoSubItensDaEstrutura := True;

      For LidxItem := 0 To LItemEst.ItemsCount -1 Do
      Begin

        LSubItem := LItemEst[LidxItem];

        LQtdeDig := fRetQtdDigitada(LSubItem.strCodigo,
                                    AItemPai.strNumLot,
                                    '',
                                    '',
                                    '',
                                    '',
                                    True,
                                    False,
                                    False,
                                    False,
                                    False,
                                    IIF(Pos(strEspDoc, 'PD_OR_') > 0, strEspDoc, strOpcDoc));

        LSaldAtu := (LSubItem.fltSaldos - objSoliTE.fJaUtilizado(LSubItem.strCodigo, VS_strCodEmp, AItemPai.strNumLot));

        If (LSaldAtu <= AItemPai.fltQtdIte) Then
          LQtdeDig := 0;

        LQtedAnt := IIF(LQtdeDig = 0, 0, AItemPai.fltQtdIte);

        If fVerificaQtdEstoque(LEmpresa,
                               strOpcDoc,
                               AItemPai.strEntSai,
                               AItemPai.strNumOrc,
                               IntToStr(AItemPai.intAutInc),
                               LSubItem.strCodigo,
                               '',
                               '',
                               fRetNomProduto(LSubItem.strCodigo),
                               AItemPai.strEntRet,
                               AItemPai.strEntFut,
                               AItemPai.strMotFut,
                               LSubItem.fltQtdTot,
                               LQtdeDig,
                               LQtedAnt,
                               LSaldAtu,
                               True,
                               AItemPai.strSemEst,
                               True,
                               LPedeSen,
                               LSemEstq,
                               AItemPai.recForTin,
                               True) Then
        Begin

          objSoliTE.pSomaUtilizado(LSubItem.strCodigo,
                                   LEmpresa,
                                   '',
                                   LSubItem.fltQtdTot,
                                   True);

          If blnSaiTsl Then
            objSoliTE.fIncluiItem(LSubItem.strCodigo,
                                  fRetGrupoItem(LSubItem.strCodigo),
                                  fRetNomProduto(LSubItem.strCodigo),
                                  '',
                                  AItemPai.intAutInc,
                                  LSubItem.fltQtdTot,
                                  True);

        End
        Else
          objSoliTE.fIncluiItem(LSubItem.strCodigo,
                                fRetGrupoItem(LSubItem.strCodigo),
                                fRetNomProduto(LSubItem.strCodigo),
                                '',
                                AItemPai.intAutInc,
                                LSubItem.fltQtdTot);

      End;

    Finally

      If Assigned(LItemEst) Then
        FreeAndNil(LItemEst);

      objSoliTE.blnCarregandoSubItensDaEstrutura := False;

    End;

  End;

begin
  //(*) NÃO EXISTIA, VARIÁVEL PARA TRATAR O CASO DO ITEM 00001 E SER USADA NA fRetQtdDigitada (VIDE CONCLUSÃO REQ:64330)
  strAutIncExclu := '';

  blnSaiTsl := (fCfgSis('SAITSL') = '2') And (Not fCfgSis('SLTFRC', varBoolean));

  For intIdx := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If arrMatItens[intIdx].strIdePro <> 'NOR' Then
      Continue;

    If arrMatItens[intIdx].strCodAca <> '' Then
      Continue;

    If fEhItemServico(arrMatItens[intIdx].strCodIte) Then
      Continue;

    If arrMatItens[intIdx].strCodIte = fCfgSis('ITEVID') Then
      Continue;

    If arrMatItens[intIdx].strCodIte = fCfgSis('ITEBOM') Then
      Continue;

    If arrMatItens[intIdx].strCodIte = fCfgSis('ITEMAN') Then
      Continue;

    If arrMatItens[intIdx].strCodIte = fCfgSis('ITELAN') Then
      Continue;

    If arrMatItens[intIdx].strCodIte = fCfgSis('ITETAX') Then
      Continue;

    If arrMatItens[intIdx].strCodIte = fCfgSis('ITEFRE') Then
      Continue;

    {Req.: 135671 - Item Estrutura}
    //If fItemEstrutura(arrMatItens[intIdx].strCodIte) And (fCfgSis('BXSBIT') = '2') Then
    //  Continue;

    {Req: 126003 - Estava perdendo o "strEmpSol" na regravação do PD, por isso comentei!}
    //arrMatItens[intIdx].strEmpSol := '';

    arrMatItens[intIdx].strLotAba := '';

    If (arrMatItens[intIdx].strEntFut <> 'S') Or
       ((arrMatItens[intIdx].strEntFut = 'S') And (arrMatItens[intIdx].strMotFut <> 'F')) Then
    Begin
      If (Not fEmptyStr(arrMatItens[intIdx].strEmpSol)) Then
      Begin
        objSoliTE.pSomaUtilizado(arrMatItens[intIdx].strCodIte,
                                 VS_strCodEmp,
                                 arrMatItens[intIdx].strNumLot,
                                 arrMatItens[intIdx].fltQtdIte,
                                 True);
        Continue;
      End;

      Self.strIdePro := arrMatItens[intIdx].strIdePro;

      If fEhItemEstruturaBaixandoEstoqueDosSubProdutos(arrMatItens[intIdx]) Then
      Begin
        pCarregarSubItensSemSaldo(arrMatItens[intIdx]);
        Continue;
      End;

      fltQtdDig := fRetQtdDigitada(arrMatItens[intIdx].strCodIte,
                                   arrMatItens[intIdx].strNumLot,
                                   IntToStr(arrMatItens[intIdx].intAutInc),//(*) ORIGINAL ERA VAZIO '' INCLUI PARA TRATAR O CASO DO 00001 (VIDE CONCLUSÃO REQ:64330)
                                   arrMatItens[intIdx].strCodAca,
                                   arrMatItens[intIdx].strEmpAca,
                                   arrMatItens[intIdx].strEmpIte,
                                   True,
                                   False,
                                   False,
                                   False,
                                   False,
                                   IIF(Pos(strEspDoc, 'PD_OR_') > 0, strEspDoc, strOpcDoc),
                                   strAutIncExclu);

      fltSalAtu := (arrMatItens[intIdx].fltSaldos - objSoliTE.fJaUtilizado(arrMatItens[intIdx].strCodIte, VS_strCodEmp, arrMatItens[intIdx].strNumLot));

      //(*) NÃO EXISTIA, FIZ PARA TRATAR CASO DO ITEM 00002 (VIDE CONCLUSÃO DO REQUISITO)
      If (fltSalAtu <= arrMatItens[intIdx].fltQtdIte) Then
        fltQtdDig := 0;

      //(*) NÃO EXISTIA, ERA arrMatItens[intIdx].fltQtdIte SEMPRE, FIZ PARA TRATAR CASO DO ITEM 00002 (VIDE CONCLUSÃO REQ:64330)
      fltQtdAnt := IIF(fltQtdDig = 0, 0, arrMatItens[intIdx].fltQtdIte);

      If fVerificaQtdEstoque(arrMatItens[intIdx].strEmpIte,
                             strOpcDoc,
                             arrMatItens[intIdx].strEntSai,
                             arrMatItens[intIdx].strNumOrc,
                             IntToStr(arrMatItens[intIdx].intAutInc),
                             arrMatItens[intIdx].strCodIte,
                             arrMatItens[intIdx].strCodAca,
                             arrMatItens[intIdx].strEmpAca,
                             arrMatItens[intIdx].strDesIte,
                             arrMatItens[intIdx].strEntRet,
                             arrMatItens[intIdx].strEntFut,
                             arrMatItens[intIdx].strMotFut,
                             arrMatItens[intIdx].fltQtdIte,
                             fltQtdDig,
                             fltQtdAnt,
                             fltSalAtu,
                             True,
                             arrMatItens[intIdx].strSemEst,
                             True,
                             blnPedSen,
                             blnSemEst,
                             arrMatItens[intIdx].recForTin,
                             True,
                             arrMatItens[intIdx].strNumLot) Then
      Begin
        strAutIncExclu := strAutIncExclu + '_' + IntToStr(arrMatItens[intIdx].intAutInc) + '_';

        objSoliTE.pSomaUtilizado(arrMatItens[intIdx].strCodIte,
                                 VS_strCodEmp,
                                 arrMatItens[intIdx].strNumLot,
                                 arrMatItens[intIdx].fltQtdIte,
                                 True);

        If (blnSaiTsl) Then
          objSoliTE.fIncluiItem(arrMatItens[intIdx].strCodIte,
                                arrMatItens[intIdx].strCodGru,
                                arrMatItens[intIdx].strDesIte,
                                arrMatItens[intIdx].strNumLot,
                                arrMatItens[intIdx].intAutInc,
                                arrMatItens[intIdx].fltQtdIte,
                                True);
      End
      Else If (Not objSoliTE.fIncluiItem(arrMatItens[intIdx].strCodIte,
                                         arrMatItens[intIdx].strCodGru,
                                         arrMatItens[intIdx].strDesIte,
                                         arrMatItens[intIdx].strNumLot,
                                         arrMatItens[intIdx].intAutInc,
                                         arrMatItens[intIdx].fltQtdIte)) Then
        Break;

    End;
  End;

end;

procedure TFatVenda.pProcessarColorantesParaSolicitacaoTransferencia;
Var
  LColorantes: TClassMatrizSaldosColorantes;
  LColorante : TSaldosColorantes;
  LOpcao: String;
  I: Integer;
begin
  LOpcao := strOpcDoc;
  If (strOpcDoc = 'OR') And (strEspDoc = 'PD') Then LOpcao := 'PD';
  If fTravaSaldoItemColorante(LOpcao) <> 'T' Then Exit;
  LColorantes := fRetornaMatrizFormulacaoTintasAcumuladaParaSolicitarTE();
  LColorantes.RecalcularAcumulados(nil);
  stlColorante.Clear;
  For I := 0 To LColorantes.Count -1 Do
  Begin
    If LColorantes.GetBaseColoranteTemSaldo(I) Then
      Continue;

    LColorante := LColorantes[I];

    objSolColorantesTE.fIncluiItem(LColorante.strCodIte,
                                   LColorante.strDesIte,
                                   LColorante.fltQtdFormula,
                                   LColorante.fltQtdFormAcu,
                                   LColorante.intIDTinta);

    stlColorante.Add(LColorante.strCodIte);


  End;
end;

function TFatVenda.fEhItemEstruturaBaixandoEstoqueDosSubProdutos(AItem: TDadosFechamento): Boolean;
begin

  Result := False;

  If Not fItemEstrutura(AItem.strCodIte) Then
    Exit;

  If Not AItem.strBxSbIt.Equals('S') Then
    Exit;

  Result := True;

end;

function TFatVenda.fTemItemEstruturaBaixandoEstoqueDosSubProdutos: Boolean;
var
  intIndIte : Integer;
begin

  Result := False;

  For intIndIte := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    Result := fEhItemEstruturaBaixandoEstoqueDosSubProdutos(arrMatItens[intIndIte]);
    If (Result) Then
      Break;
  End;

end;

Function TFatVenda.fVaiDefinirAbastecimentoItens: Boolean;
begin
  Result := (fOpcaoFaturamentoPermitidaSoliTE) And (strEntreg <> 'S') And
     (Not blnEnt_CD) And (fCfgSis('SOLITE', VarString) = 'S') And
     ((Pos(fTravaSaldoVN(blnExpedi, False),'TA') > 0) Or (Pos(fTravaSaldoVN(blnExpedi, True),'TA') > 0)) And
     (fCfgSis('CONENT', varString) = 'S') And (fCfgSis('SLTFRC', varString) = 'S');
end;

Function TFatVenda.fVaiLiberarPREPTEPedido(strDocLib, strEspLib, strEmpLib: String):Boolean;
Var
  strSitPed: String;
begin
  Result := False;

  If (Not (fCfgSis('LIBETE', VarInteger) = 1)) Then
    Exit;

  If (Not blnRealizandoAdiantamentoPedidoPeloF11) And
     (Not fVaiDefinirAbastecimentoItens) Then
    Exit;

  strSitPed := TSituacaoPedidoVenda.fRetornaSituacaoAdiantamento(strEmpLib, strDocLib, strEspLib);

  If (Not (strSitPed = apRealizado.fGetLegendaTexto)) then
    Exit;

  Result := True;
end;

Function TFatVenda.fLiberaPREPTEPedido():Boolean;
var
  strDocLib: String;
  strEspLib: String;
  strEmpLib: String;
begin
  Result := True;

  strDocLib := fTiraCaracEspeciais(Self.strNumDoc);
  strEspLib := Self.strEspDoc;
  strEmpLib := fRetornaEmpresaParaAdiantamentoPedido();

  If fVaiLiberarPREPTEPedido(strDocLib, strEspLib, strEmpLib) Then
    Result := TPreparaGeracaoTE.fLiberaItensDocumento(strDocLib, strEspLib, strEmpLib);
end;

Function TFatVenda.fDefineAbastecimentoItens(OpcaoExibir: TOpcaoExibirTelaAbastecimento;
  AExibirProdutoEmEstoque: Boolean = False): Boolean;
begin
  Result := True;
  If fVaiDefinirAbastecimentoItens Then
  Begin
    If Assigned(objAbastecimentoItensPedido) Then
      FreeAndNil(objAbastecimentoItensPedido);

    objAbastecimentoItensPedido := TAbastecimentoItensPedido.Create(Self);
    objAbastecimentoItensPedido.ExibirProdutoEmEstoque := AExibirProdutoEmEstoque;

    If ((Not blnEmpFat) Or (Not blnMulLoj) Or blnFinali Or fDefinirTipoAbastecimentoPedidoAVista) Then
      Result := objAbastecimentoItensPedido.fDefinirTipoAbastecimento(OpcaoExibir)
    Else
      objAbastecimentoItensPedido.pCarregarAbastecimentosAnterior();
  End;
end;

function TFatVenda.fExibirTelaDadosDoPedido: Boolean;
begin
  Result := (Self.strEspDoc = 'PD') And
            (
             (Self.fltTotGer > 0) Or
             (((Self.fltTotGer = 0) And Self.fTemAlgumServicoDigitadoComOuSemValor)) Or
             ((Self.fltTotGer = 0) and (Self.fEmissaoPedidoBrinde) and (fCfgSis('TPDCEX') = '1'))
            );
end;

function TFatVenda.fCalculaDescontoConfirmacao(fltDesMinConf: Double): Double;
begin
  If Self.fCarregaValorBrutoParaAplicarDescontoProfissional Then
  Begin
    {**********************************************************************************}
    {* Desconto da confirmacao (fltDesCff) sera dado pela diferenca entre o           *}
    {* Total Liquido Original e o Total Liquido Atual,                                *}
    {* pois o valor unitario dos produtos esta Bruto (sem o desconto do profissional) *}
    {***************************************************************************RO,JC**}
    Result := (Self.fltTotalLiqItensConf - fltDesMinConf) - (Self.fltTotPro - (Self.fltDesEsp + Self.fltDesEspDifeF4));
  End
  Else
    Result := (Self.fltDesEsp + Self.fltDesEspDifeF4) - fltDesMinConf;
end;

function TFatVenda.fInformouEmpresaTEParaClienteFilial: Boolean;
begin
  Result := (Pos(Self.strOpcDoc,'OR_PD_') > 0) And (Self.blnCliFil) And (Not fEmptyStr(Self.strEmp_TE));
end;

function TFatVenda.fExibirTelaLojasTE: Boolean;
begin
  Result := (fOpcaoFaturamentoPermitidaSoliTE) And (strEntreg <> 'S') And {(strEntFut <> 'S') And}
            (Not blnEnt_CD) And fCfgSis('SOLITE', VarBoolean) And
            ((Pos(fTravaSaldoVN(blnExpedi, False),'TA') > 0) Or (Pos(fTravaSaldoVN(blnExpedi, True),'TA') > 0)) And
            fCfgSis('CONENT', varBoolean) And (Not fCfgSis('SLTFRC', varBoolean)) And
            (Not fInformouEmpresaTEParaClienteFilial);
end;

Function TFatVenda.fPedeLojasTE: Boolean;
Begin
  {****************************************************************************}
  {* AS MARCAÇÕES COM (*) SÃO REFERENTES AO REQUISITO 64330, QUE FIZ PARA NÃO *}
  {* ALTERAR A JÁ TENSA fVerificaQtdEstoque.                                  *}
  {* O PROBLEMA RELACIONADO COM O REQUISTO ERA A SOLICITAÇÃO DE ITENS ERRADA  *}
  {* NOS CASOS DE ITENS INSERIDOS DE FORMA REPETIDA CUJO LIMIAR DE SALDO      *}
  {* ESTAVA PRÓXIMO DE ZERO OU DE SEU LIMITE. SINTA-SE A VONTADE PARA MELHORAR*}
  {* E/OU AO PROMOVER UMA ALTERAÇÃO A MESMA CONTEMPLE OS CASOS QUE RELATO NA  *}
  {* CONCLUSÃO DESTE REQUISITO (VIDE DIÁRIO)                                  *}
  {*************************************************************************VA*}
  Try
    Result := True;

    blnSolicitouEmpresasTE := False;

    If fExibirTelaLojasTE Then
    Begin
      If Assigned(objSoliTE) Then
        FreeAndNil(objSoliTE);

      objSoliTE := TSolicitacaoTE.Create;
      objSoliTE.blnExibeMensagemTransferenciaEstoque := Not fExibeMensagemTransferenciaEstoqueItemAItem; 

      pProcessarItensParaSolicitacaoTransferencia;

      if (fSolicitacaoTransferenciaMultiLoja) then
        Result := objSoliTE.fInformaMultiLojas
      else
        Result := objSoliTE.fInformaLojas;

      blnImpReq := objSoliTE.blnReq;

      blnSolicitouEmpresasTE := Result;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fPedeLojasTE]');
    End;
  End;

End;

Function TFatVenda.fPedeLojasColorantesTE: Boolean;
Var
  strCodEmp: string;
  intIndice: integer;
Begin
  Try
    Result := True;

    blnSolicitouEmpresasColTE := False;

    If fExibirTelaLojasTE Then
    Begin
      If Assigned(objSolColorantesTE) Then
        FreeAndNil(objSolColorantesTE);

      objSolColorantesTE := TSolicitacaoColorantesTE.Create;
      objSolColorantesTE.blnExibeMensagemTransferenciaEstoque := Not fExibeMensagemTransferenciaEstoqueItemAItem; 

      pProcessarColorantesParaSolicitacaoTransferencia;

      Result := objSolColorantesTE.fInformaLojas;

      if Result then
      begin
        objSolColorantesTE.stlLojas.Clear;
        objSolColorantesTE.cdsItens.First;
        while not objSolColorantesTE.cdsItens.Eof do
        begin
          strCodEmp := objSolColorantesTE.cdsItens.FieldByName('CODEMP').AsString;
          if not fEmptyStr(strCodEmp) then
            if not objSolColorantesTE.stlLojas.Find(strCodEmp, intIndice) then
              objSolColorantesTE.stlLojas.Add(strCodEmp);
          objSolColorantesTE.cdsItens.Next;
        end;
      end;

      blnSolicitouEmpresasColTE := Result;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fPedeLojasColorantesTE]');
    End;
  End;
End;

