function TFatVenda.fTotalCustoSubItensEst: Double;
  Var
    intRecNo: Integer;
begin
  Result := 0;
  With cdsDadosSubItensEst Do
  Begin
    intRecNo := RecNo;
    First;
    While Not Eof Do
    Begin
      //o sub item entra no grid com preco de custo por isso o total do item = total do custo
      Result := Result + FieldByName('ITE_TOTITE').AsFloat;
      Next;
    End;
    RecNo := intRecNo;
  End;
end;

procedure TFatVenda.pCalculaPrecoCustoConcreto;
  Var
    parPreCus: TParCalculaPrecoCusto;
    strCodAbf,
    strCodSit: String;
    fltDifal,
    fltFcp: Double;
Begin
  parPreCus := TParCalculaPrecoCusto.Create(Self, TConfiguracao.fGetConfiguracao);

  Self.fltPreCus := 0;
  fltFcp := 0;

  If cdsVenda.FieldByName('ITE_QTDITE').AsFloat <> 0.00 Then
    Self.fltPreCus := Self.fTotalCustoSubItensEst / cdsVenda.FieldByName('ITE_QTDITE').AsFloat;

  strCodSit := '';
  strCodAbf := fGetCodAbf(cdsVenda.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(cdsVenda.FieldByName('ITE_EMPITE').AsString));
  If (Not fEmptyStr(Self.GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString))) And (fBuscaAbfIcm(cdsVenda.FieldByName('ITE_CODITE').AsString, cdsVenda.FieldByName('ITE_EMPITE').AsString, strCodAbf, fTrocaUFEndEntrega)) Then
    strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(cdsVenda.FieldByName('ITE_EMPITE').AsString)).AsString;

  fltDifal := fGetAlqDifal(cdsVenda.FieldByName('ITE_CODITE').AsString,
                           cdsVenda.FieldByName('ITE_EMPITE').AsString,
                           strCodAbf,
                           strCodSit);

  If (cdsVenda.FieldByName('ITE_VAL_ST').AsFloat = 0) And
     ((cdsVenda.FieldByName('ITE_BASICM').AsFloat <> 0) Or (Pos(AnsiRightStr(strClaFis, 3),'117_922_') > 0) Or blnCarregaPedidoOrcamentoEntFut) Then
    fltFcp := fGetAlqFcpIcms(cdsVenda.FieldByName('ITE_CODITE').AsString,
                             cdsVenda.FieldByName('ITE_EMPITE').AsString,
                             strCodAbf,
                             strCodSit,
                             cdsVenda.FieldByName('ITE_ICMSAI').AsFloat,
                             cdsVenda.FieldByName('ITE_UNITAR').AsFloat);

  Self.fltPreCu2 := parPreCus.fCalculaPrecoCustoRealVenda(cdsVenda.FieldByName('ITE_UNITAR').AsFloat,
                                                          Self.fltPreCus,
                                                          cdsVenda.FieldByName('ITE_OUTVAL').AsFloat,
                                                          cdsVenda.FieldByName('ITE_ICMSAI').AsFloat,
                                                          cdsVenda.FieldByName('ITE_IMPFED').AsFloat,
                                                          cdsVenda.FieldByName('ITE_DESOPE').AsFloat + Self.fltDesOpeCli,
                                                          fltDifal,
                                                          fltFcp);
  FreeAndNil(parPreCus);

  cdsVenda.Edit;

  cdsVenda.FieldByName('ITE_CUSITE').AsFloat := Self.fltPreCus;
  cdsVenda.FieldByName('ITE_PRECUS').AsFloat := Self.fltPreCus;
  cdsVenda.FieldByName('ITE_PRECU2').AsFloat := Self.fltPreCu2;

  cdsVenda.Post;
end;

procedure TFatVenda.pDefineQtdSubItemConcreto(const strCodSubIte: String; Var fltQtdSubIte: Double);
  Var
    fltQtdProduzir: Double;
    fltQtdBaixarSubItem: Double;
begin
  fltQtdProduzir := cdsVenda.FieldByName('ITE_QTDITE').AsFloat;

  If cdsDadosSubItensEst.Locate('ITE_CODITE', strCodSubIte, []) Then
  Begin
    fltQtdBaixarSubItem := cdsDadosSubItensEst.FieldByName('ITE_QTDITE').AsFloat;

   If (fltQtdProduzir <> 0) Then
     fltQtdSubIte := fltQtdBaixarSubItem / fltQtdProduzir;
  End;
end;

function TFatVenda.fCodigoItemConcretoVenda: String;
  var
    cdsDados: TUniClientDataSet;
begin
  Result  := '';
  FDesItC := '';
  FQtdItC := 0;

  If (cdsVenda <> nil) Then
  Begin
    cdsDados := TUniClientDataSet.Create(Self);
    pCloneDataSet(cdsDados, cdsVenda);

    With cdsDados Do
    Begin
      First;

      While (Not Eof) And fEmptyStr(Result) Do
      Begin
        If Not fEhItemConcreto(FieldByName('ITE_CODITE').AsString) Then
          Next
        Else
        Begin
          Result  := FieldByName('ITE_CODITE').AsString;
          FDesItC := FieldByName('ITE_DESITE').AsString;
          FQtdItC := FieldByName('ITE_QTDITE').AsFloat;
        End;
      End;

    End;

    FreeAndNil(cdsDados);
  End;

end;

procedure TFatVenda.pIniciaVariaveisVendaConcreto(blnSomVei: Boolean = False);
  var
    strSql: String;
    qryInf: TUniQuery;
begin

  qryInf := fCriaQuery(Self);

  If Not blnSomVei Then
  Begin
    strSql := '';
    strSql := strSql + ' SELECT SQL_NO_CACHE     ';
    strSql := strSql + '   ITE_CONBOM,           ';
    strSql := strSql + '   ITE_FCKDIA,           ';
    strSql := strSql + '   ITE_ABATIM,           ';
    strSql := strSql + '   ITE_TIPMPS,           ';
    strSql := strSql + '   ITE_BRITA_            ';
    strSql := strSql + ' FROM                    ';
    strSql := strSql + '   CADITE                ';
    strSql := strSql + ' WHERE                   ';
    strSql := strSql + '   ITE_CODITE = "' + fCodigoItemConcretoVenda + '" ';

    With qryInf, SQL Do
    Begin
      Clear;
      Add(strSql);
      Open;

      If (fCfgSis('TPNFCR') = J_A_MASSA_CONCRETO) Then
      Begin
        If FTipMps.IsEmpty Then
          FTipMps := FieldByName('ITE_TIPMPS').AsString;
        If FAbatim.IsEmpty Then
          FAbatim := FieldByName('ITE_ABATIM').AsString;
        If FBrita_.IsEmpty Then
          FBrita_ := FieldByName('ITE_BRITA_').AsString;
        If FConBom.IsEmpty Then
          FConBom := FieldByName('ITE_CONBOM').AsString;
        If FFckDia.IsEmpty Then
          FFckDia := FieldByName('ITE_FCKDIA').AsString;
      End
      Else
      Begin
        FTipMps := FieldByName('ITE_TIPMPS').AsString;
        FAbatim := FieldByName('ITE_ABATIM').AsString;
        FBrita_ := FieldByName('ITE_BRITA_').AsString;
        FConBom := FieldByName('ITE_CONBOM').AsString;
        FFckDia := FieldByName('ITE_FCKDIA').AsString;
      End;

    End;
  End;

  strSql := '';
  strSql := strSql + ' SELECT SQL_NO_CACHE         ';
  strSql := strSql + '   VEI_BETONE,               ';
  strSql := strSql + '   VEI_CODMOT,               ';
  strSql := strSql + '   MOT_NOMMOT                ';
  strSql := strSql + ' FROM                        ';
  strSql := strSql + '   CADVEI                    ';
  strSql := strSql + '   LEFT JOIN CADMOT ON       ';
  strSql := strSql + '     MOT_CODMOT = VEI_CODMOT ';
  strSql := strSql + ' WHERE                       ';
  strSql := strSql + '   VEI_PLAVEI = "' + FPlaVei + '" ';

  If (fCfgSis('TPNFCR') <> J_A_MASSA_CONCRETO) Then
  Begin

    With qryInf, SQL Do
    Begin
      Clear;
      Add(strSql);
      Open;

      FCodMot := FieldByName('VEI_CODMOT').AsString;
      FNomMot := FieldByName('MOT_NOMMOT').AsString;
      FBetone := FieldByName('VEI_BETONE').AsString;
    End;

  End;

  FreeAndNil(qryInf);

end;

