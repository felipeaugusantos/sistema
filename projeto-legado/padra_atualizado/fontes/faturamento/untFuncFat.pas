procedure TFatVenda.pNfeInfAdicListaVendedorNF(strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
var
  qryUsaChave: TUniQuery;
  qryLstVen: TUniQuery;
  strLstVen: String;
begin

  qryUsaChave := fCriaQuery;
  qryLstVen := fCriaQuery;

  try

    qryUsaChave.SQL.Clear;
    qryUsaChave.SQL.Add('SELECT COUNT(*) AS USAMOVMOD FROM CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E'));
    qryUsaChave.SQL.Add(' WHERE CNF_CODEMP = '+QuotedStr(VS_strCodEmp)+' AND CNF_SETOR_ = '+QuotedStr('06'));
    qryUsaChave.SQL.Add('   AND CNF_DESCAM LIKE '+QuotedStr('%strListaVendedorNF%'));
    qryUsaChave.Open;

    if qryUsaChave.FieldByName('USAMOVMOD').AsInteger > 0 then
    begin

      qryLstVen.SQL.Clear;
      qryLstVen.SQL.Add('SELECT                                                                        ');
      qryLstVen.SQL.Add('  GROUP_CONCAT(DISTINCT DET_CODVEN, "-",                                      ');
      qryLstVen.SQL.Add('    (SELECT OPE_NOMOPE FROM CADOPE WHERE OPE_CODOPE = DET_CODVEN) ) AS LSTVEN ');
      qryLstVen.SQL.Add('FROM                                                                          ');
      qryLstVen.SQL.Add('  MOVDET                                                                      ');
      qryLstVen.SQL.Add('WHERE DET_NUMDOC = :NUMDOC                                                    ');
      qryLstVen.SQL.Add('  AND DET_ESPDOC = :ESPDOC                                                    ');
      qryLstVen.SQL.Add('  AND DET_CODEMP = :CODEMP                                                    ');
      qryLstVen.SQL.Add('  AND DET_TIP_FC = "C"                                                        ');
      qryLstVen.SQL.Add('  AND DET_CODCLI = :CODCLI                                                    ');
      qryLstVen.SQL.Add('UNION ALL                                                                     ');
      qryLstVen.SQL.Add('SELECT                                                                        ');
      qryLstVen.SQL.Add('  GROUP_CONCAT(DISTINCT DET_CODVEN, "-",                                      ');
      qryLstVen.SQL.Add('    (SELECT OPE_NOMOPE FROM CADOPE WHERE OPE_CODOPE = DET_CODVEN) ) AS LSTVEN ');
      qryLstVen.SQL.Add('FROM                                                                          ');
      qryLstVen.SQL.Add('  NOTDET                                                                      ');
      qryLstVen.SQL.Add('WHERE DET_NUMDOC = :NUMDOC                                                    ');
      qryLstVen.SQL.Add('  AND DET_ESPDOC = :ESPDOC                                                    ');
      qryLstVen.SQL.Add('  AND DET_CODEMP = :CODEMP                                                    ');
      qryLstVen.SQL.Add('  AND DET_TIP_FC = "C"                                                        ');
      qryLstVen.SQL.Add('  AND DET_CODCLI = :CODCLI                                                    ');

      qryLstVen.ParamByName('CODEMP').asString := strCodEmp;
      qryLstVen.ParamByName('NUMDOC').asString := strNumDoc;
      qryLstVen.ParamByName('ESPDOC').asString := strEspDoc;
      qryLstVen.ParamByName('CODCLI').asString := strCodCli;
      qryLstVen.Open;

      qryLstVen.First;
      while not qryLstVen.Eof do
      begin
        If Not fEmptyStr(qryLstVen.FieldByName('LSTVEN').AsString) Then
        begin
          strLstVen := 'Vendedores: '+qryLstVen.FieldByName('LSTVEN').asString;
          fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strLstVen, '');
        end;
        qryLstVen.Next;
      end;

    end;

  finally
    FreeAndNil(qryUsaChave);
    FreeAndNil(qryLstVen);
  end;

End;

procedure TFatVenda.pNfeInfAdicPontosClubeFidelidade(strNumDoc, strEspDoc, strCodEmp, strCodCli: String);

  function fRetSqlPontosFidelidade: String;
  begin
    Result := ' SELECT ';
    Result := Result + ' @PTOVEN := COALESCE((SELECT CLU2.FID_QTDPTO FROM CLUFID CLU2 ';
    Result := Result + ' JOIN CADCLI CLI2 ON CLI2.CLI_CODCLI = CLU2.FID_CODCLI ';
    Result := Result + ' WHERE CLU2.FID_CODCLI = G.GER_CODCLI ';
    Result := Result + ' AND   CLU2.FID_CODEMP = G.GER_CODEMP ';
    Result := Result + ' AND   CLU2.FID_ESPDOC = G.GER_ESPDOC ';
    Result := Result + ' AND   CLU2.FID_NUMDOC = G.GER_NUMDOC ';
    Result := Result + ' AND   CLU2.FID_CREDEB = "C" ';
    Result := Result + ' AND   CLI2.CLI_CLUFID = "S"  ';
    Result := Result + ' ),0)- ';
    Result := Result + ' COALESCE((SELECT CLU2.FID_QTDPTO FROM CLUFID CLU2 ';
    Result := Result + ' JOIN CADCLI CLI2 ON CLI2.CLI_CODCLI = CLU2.FID_CODCLI ';
    Result := Result + ' WHERE CLU2.FID_CODCLI = G.GER_CODCLI ';
    Result := Result + ' AND   CLU2.FID_CODEMP = G.GER_CODEMP ';
    Result := Result + ' AND   CLU2.FID_ESPDOC = G.GER_ESPDOC ';
    Result := Result + ' AND   CLU2.FID_NUMDOC = G.GER_NUMDOC ';
    Result := Result + ' AND   CLU2.FID_CREDEB = "D" ';
    Result := Result + ' AND   CLI2.CLI_CLUFID = "S"  ';
    Result := Result + ' ),0) AS PTOVEN, ';

    Result := Result + ' @PTOANT := COALESCE((SELECT SUM(IF(CLU1.FID_CREDEB = "C", CLU1.FID_QTDPTO, -CLU1.FID_QTDPTO)) FROM CLUFID CLU1 ';
    Result := Result + ' JOIN CADCLI CLI2 ON CLI2.CLI_CODCLI = CLU1.FID_CODCLI ';
    Result := Result + '  WHERE CLU1.FID_CODCLI = G.GER_CODCLI ';
    Result := Result + '  AND   CLU1.FID_DTACAD <= G.GER_DTAENT ';
    Result := Result + '  AND   CLI2.CLI_CLUFID = "S"  ';
    Result := Result + '  AND   CLU1.FID_DTABAI IS NULL ';
    Result := Result + '  AND   CLU1.FID_HRABAI IS NULL ';
    Result := Result + '  AND CLU1.AUTOINCREM <> CF.AUTOINCREM ';
    Result := Result + ' ),0) AS PTOANT,  ';
    Result := Result + ' CONCAT ("Total de pontos do clube fidelidade: ", (@PTOVEN + @PTOANT)) AS TOTAL_CLUFID ';
    Result := Result + ' FROM MOVGER G ';
    Result := Result + ' JOIN CLUFID CF ON ';
    Result := Result + '      CF.FID_CODEMP = G.GER_CODEMP AND ';
    Result := Result + '      CF.FID_ESPDOC = G.GER_ESPDOC AND ';
    Result := Result + '      CF.FID_NUMDOC = G.GER_NUMDOC AND ';
    Result := Result + '      CF.FID_CODCLI = G.GER_CODCLI ';
    Result := Result + ' WHERE ';
    Result := Result + ' G.GER_CODEMP = :CODEMP ';
    Result := Result + ' AND G.GER_ESPDOC = :ESPDOC ';
    Result := Result + ' AND G.GER_NUMDOC = :NUMDOC ';
    Result := Result + ' AND G.GER_CODCLI = :CODCLI ';
  end;

var
  qryCnfNfe: TUniQuery;
  strCNfNfe: String;
begin
  qryCnfNfe := fCriaQuery;
  Try
    qryCnfNfe.Close;
    qryCnfNfe.SQL.Text := fRetSQlCNF_NFE('06', strEspDoc, 'strPontoClubeFidelidadeNF');
    qryCnfNfe.Open;

    If qryCnfNfe.FieldByName('USAMOVMOD').AsInteger <= 0 Then
      Exit;

    qryCnfNfe.Close;
    qryCnfNfe.SQL.Text := fRetSqlPontosFidelidade;
    qryCnfNfe.ParamByName('NUMDOC').asString := strNumDoc;
    qryCnfNfe.ParamByName('ESPDOC').asString := strEspDoc;
    qryCnfNfe.ParamByName('CODEMP').asString := strCodEmp;
    qryCnfNfe.ParamByName('CODCLI').asString := strCodCli;
    qryCnfNfe.Open;

    If qryCnfNfe.IsEmpty Then
      Exit;

    strCNfNfe :=  qryCnfNfe.FieldByName('TOTAL_CLUFID').AsString;
    fAtualizaCnfNfeMovNotObs(strNumDoc, strEspDoc, strEmpDoc, strCNfNfe,'');
  Finally
    FreeAndNil(qryCnfNfe);
  End;
end;

function TFatVenda.fRetSQlCNF_NFE(strSetor, strEspDoc, strDesCam: String): String;
begin
  Result := '            SELECT                                                      ';
  Result := Result + '      COUNT(*) AS USAMOVMOD                                    ';
  Result := Result + '   FROM                                                        ';
  Result := Result + '      CNF_NF' + IIF(strEspDoc = 'NS', 'S', 'E')                 ;
  Result := Result + '   WHERE CNF_CODEMP = '   +QuotedStr(VS_strCodEmp)              ;
  Result := Result + '     AND CNF_SETOR_ = '   +QuotedStr(strSetor)                  ;
  Result := Result + '     AND CNF_DESCAM LIKE '+QuotedStr('%'+strDesCam+'%');
end;

function TFatVenda.fLiberaCondicaoNaoPermitidaNoTipoDeCliente(strCodCnd: String; strTotGer: String = ''): Boolean;
  Var
    objLiberacao : TLiberacao;
    strTipCli: String;
begin
  Result := False;

  If Not fCfgSis('CNDCLI', varBoolean) Then
    Exit;

  If Not fCfgSis('USATPC', varBoolean) Then
    Exit;

  If (strOriF11 = 'S') And (fCfgSis('TVPGRC') = 'N') Then //Não avisa
    Exit(True);

  strTipCli := fCampoTabela('CLI_TIPCLI','CADCLI', ['CLI_CODCLI'], [Self.strCodCli]);
  
  objLiberacao := TLiberacao.Create;
  try
    objLiberacao.objMsgLibera.pAddTexto('Condição de pagamento não permitida conforme o tipo do cliente');
    objLiberacao.objMsgLibera.pAddTextoCaption('Condição Pagamento',IIF(fCfgSis('USACND', varBoolean), strCodCnd + '-' + fRetDesConPag(strCodCnd) + ' ', '') + fFormataCondPag(fRetConPag(strCodCnd)), 18);
    objLiberacao.objMsgLibera.pAddTextoCaption('Tipo de Cliente   ',strTipCli + '-' + fRetDescTipoCli(strTipCli), 18);

    if not fEmptyStr(Self.strNumOrc) then
    begin
      objLiberacao.objMsgLibera.pAddTextoCaption('Documento ', Self.strNumOrc + ' - ' + Self.strEspOrc, 18);
      If (fCfgSis('CNDVEN') = 'I') And (fCfgSis('TRAREM') = '2') Then
      Begin
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor do Documento ', STRING_VALOR_DOCUMENTO, 18);
        objLiberacao.strTotGer  := strTotGer;
      End
      Else
        objLiberacao.objMsgLibera.pAddTextoCaption('Valor do Documento ', FloatToStrF(self.fltTotGer, ffNumber, 12, 2), 18);
    end;

    objLiberacao.strDirAce := 'CNDSEN';
    objLiberacao.strSenLib := fCfgSis('CNDSEN');
    If (strOriF11 = 'S') And (fCfgSis('TVPGRC') = 'A') Then //Avisa
      objLiberacao.blnTraTel := False;
    objLiberacao.strMsgSen := 'Condição de pagamento não permitida conforme o tipo do cliente';
    objLiberacao.strCodOpe := IIF(fEmptyStr(Self.strCodVen), strLoginUsuarioLogado, Self.strCodVen);
    objLiberacao.strCliente := Self.strCodCli + '-' + Self.strCliOri;

    Result := fFatMensagemLiberacao(objLiberacao);

    If (Result) And (not fSomenteAvisaPoisVaiTravarNoFinalVenda(objLiberacao.strDirAce)) Then
      Self.strCndLib := strCodCnd
    Else
      Self.strCndLib := '';
  finally
    FreeAndNil(objLiberacao);
  end;
end;

procedure TFatVenda.pAtualizaDocumentoEntregaFutura;
begin
  If (Self.blnBaiEntFut) And (Assigned(Self.cdsBaiEntFut)) Then
  Begin
    Self.cdsBaiEntFut.First;
    While Not Self.cdsBaiEntFut.EOF Do
    Begin
      If cdsVenda.Locate('ITE_SEQDET', Self.cdsBaiEntFut.FieldByName('ITE_SEQDET').AsString, []) Then
      Begin
        cdsVenda.Edit;
        cdsVenda.FieldByName('ITE_DOCFUT').AsString := Self.cdsBaiEntFut.FieldByName('ITE_DOCFUT').AsString;
        cdsVenda.FieldByName('ITE_ESPFUT').AsString := Self.cdsBaiEntFut.FieldByName('ITE_ESPFUT').AsString;
        cdsVenda.FieldByName('ITE_EMPFUT').AsString := Self.cdsBaiEntFut.FieldByName('ITE_EMPFUT').AsString;
        cdsVenda.Post;
      End;
      Self.cdsBaiEntFut.Next;
    End;
    Self.cdsBaiEntFut.First;
  End;
end;

procedure TFatVenda.pAdicionaItensDaBaixaDeEntregaFutura(strSeqFgo: String);
  Var
    cdsBaiFut : TZClient;
    blnSintetizado : Boolean;
begin
  cdsBaiFut := TZClient.Create(Self);
  With cdsBaiFut.qryQuery, SQL Do
  Begin
    cdsBaiFut.Close;
    Close;
    Clear;
    Add(fRetSQLItensBaixaEntFut);
    ParamByName('SEQFGO').AsString := strSeqFgo;
    cdsBaiFut.pSetProvider;
    Open;
    pSetaClient(cdsBaiFut.qryQuery);
    cdsBaiFut.Open;
    If (Not cdsBaiFut.IsEmpty) Then
    Begin
      If (Not Assigned(Self.cdsBaiEntFut)) Then
        Self.cdsBaiEntFut := fCriaClientDatset(cdsBaiFut, True);

      cdsBaiFut.First;
      While Not cdsBaiFut.Eof Do
      Begin
        blnSintetizado := False;
        If (Self.cdsBaiEntFut.Locate('AUTOINCREM;TABELA;SINTET', VarArrayOf([cdsBaiFut.FieldByName('AUTOINCREM').AsString, cdsBaiFut.FieldByName('TABELA').AsString, 'N']), [])) Then
        Begin
          Self.cdsBaiEntFut.Edit;
          blnSintetizado := True;
        End
        Else
        Begin
          Self.cdsBaiEntFut.Append;
          Self.cdsBaiEntFut.FieldByName('AUTOINCREM').AsString := cdsBaiFut.FieldByName('AUTOINCREM').AsString;
          Self.cdsBaiEntFut.FieldByName('TABELA').AsString := cdsBaiFut.FieldByName('TABELA').AsString;
          Self.cdsBaiEntFut.FieldByName('ITE_DOCFUT').AsString := cdsBaiFut.FieldByName('ITE_DOCFUT').AsString;
          Self.cdsBaiEntFut.FieldByName('ITE_ESPFUT').AsString := cdsBaiFut.FieldByName('ITE_ESPFUT').AsString;
          Self.cdsBaiEntFut.FieldByName('ITE_EMPFUT').AsString := cdsBaiFut.FieldByName('ITE_EMPFUT').AsString;
          Self.cdsBaiEntFut.FieldByName('DET_QTDENT').AsFloat  := cdsBaiFut.FieldByName('DET_QTDENT').AsFloat;
          Self.cdsBaiEntFut.FieldByName('ITE_SEQDET').AsString := cdsBaiFut.FieldByName('ITE_SEQDET').AsString;
          Self.cdsBaiEntFut.FieldByName('FDO_CODITE').AsString := cdsBaiFut.FieldByName('FDO_CODITE').AsString;
          Self.cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat  := 0;
          Self.cdsBaiEntFut.FieldByName('SINTET').AsString := 'N';
        End;

        Self.cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat := Self.cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat + cdsBaiFut.FieldByName('DET_QTDAEN').AsFloat;
        Self.cdsBaiEntFut.Post;

        If (blnSintetizado) Then
        Begin
          Self.cdsBaiEntFut.Append;
          Self.cdsBaiEntFut.FieldByName('AUTOINCREM').AsString := cdsBaiFut.FieldByName('AUTOINCREM').AsString;
          Self.cdsBaiEntFut.FieldByName('TABELA').AsString := cdsBaiFut.FieldByName('TABELA').AsString;
          Self.cdsBaiEntFut.FieldByName('ITE_DOCFUT').AsString := cdsBaiFut.FieldByName('ITE_DOCFUT').AsString;
          Self.cdsBaiEntFut.FieldByName('ITE_ESPFUT').AsString := cdsBaiFut.FieldByName('ITE_ESPFUT').AsString;
          Self.cdsBaiEntFut.FieldByName('ITE_EMPFUT').AsString := cdsBaiFut.FieldByName('ITE_EMPFUT').AsString;
          Self.cdsBaiEntFut.FieldByName('DET_QTDENT').AsFloat  := cdsBaiFut.FieldByName('DET_QTDENT').AsFloat;
          Self.cdsBaiEntFut.FieldByName('ITE_SEQDET').AsString := cdsBaiFut.FieldByName('ITE_SEQDET').AsString;
          Self.cdsBaiEntFut.FieldByName('FDO_CODITE').AsString := cdsBaiFut.FieldByName('FDO_CODITE').AsString;
          Self.cdsBaiEntFut.FieldByName('DET_QTDAEN').AsFloat  := 0;
          Self.cdsBaiEntFut.FieldByName('SINTET').AsString := 'S';
          Self.cdsBaiEntFut.Post;
        End;

        cdsBaiFut.Next;
      End;
    End;
  End;
end;

function TFatVenda.fVerificaCondPagtoParcelaMinima(fltParMin, fltParMax: Double; strTraSen, strCodCnd: String): Boolean;
  Var
    objLiberacao : TLiberacao;
    intContador : Integer;
    strParcelas: String;
    strCondPag: String;
    fltEntrada: Double;
    arrDupBkp: TDigDuplicArray;
    strTpTrava: String;
    intParcelas : Integer;
begin
  Result := True;
  fltEntrada := 0;

  pRemoverTravaLogAvi('INTPAR', strNTrava);

  If Not fPermiteValidarMargemAndValorCodCnd Then
    Exit;

  For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
    arrDupBkp[intContador] := arrDuplicata[intContador];

  Try
    strCondPag := strConPag;

    If strOriF11 <> 'S' Then
    Begin
      If strCodFpg = '009' Then
      Begin
        objFormasPagtoNegociada.cdsformasnegociadas.First;
        While not objFormasPagtoNegociada.cdsformasnegociadas.Eof Do
        Begin
          If (objFormasPagtoNegociada.cdsformasnegociadas.Fieldbyname('CONPAG').AsString  = '01000') And
             (objFormasPagtoNegociada.cdsformasnegociadas.Fieldbyname('QTDPAR').AsInteger = 0) Then
            fltEntrada := fltEntrada + objFormasPagtoNegociada.cdsformasnegociadas.Fieldbyname('VALFPG').AsFloat;

          objFormasPagtoNegociada.cdsformasnegociadas.Next;
        End;
      End;

      If fltEntrada > 0 then
      Begin
        pAlteraCondicaoPagamentoRemovendoEntrada(strCondPag);
        strCondPag := fTiraCaracEspeciaisParenteses(strCondPag);
      End;

      fDigDuplic(arrDuplicata, strCondPag, 0, fltTotGer-fltEntrada, False, False, False, Self.VS_Date, False,0,'N',true,false,0,false,[],'',true,true,nil,'',false,true,'','',nil,false,false,nil,false,false,0);
    End;

    strParcelas := '';
    intParcelas := 0;

    For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
      If arrDuplicata[intContador].curValor > 0 Then
      Begin
        strParcelas := strParcelas + ' ('+ arrDuplicata[intContador].strSequen +') ' +
                                           arrDuplicata[intContador].dtaDtaVen + ' - ' +
                                           FloatToStrF(arrDuplicata[intContador].curValor, ffNumber, 12, 2);
       Inc(intParcelas);

        If ((arrDuplicata[intContador].curValor < fltParMin) Or
            (arrDuplicata[intContador].curValor > fltParMax))And
           (strOriF11 <> 'S')  Then
          Result := False;

      End;
  Finally
    For intContador := Low(arrDuplicata) To High(arrDuplicata) Do
      arrDuplicata[intContador] := arrDupBkp[intContador];
  End;

  If (fStatusCndPag(strCondPag) <> A_PRAZO) then
  Begin
    Result := True;
    Exit;
  End;

  strTpTrava := fRetornaTipoTravaSeOrcamentoComPerfilCondicao('CND_TRORPF');

  If (strTpTrava = 'N') Then
  Begin
    Result := True;
    Exit;
  End;


  if (Not(fCfgSis('CPOVMP', varBoolean))) and
     (intParcelas <= 1) and
     (fRetTipoForaConPag(strCodCnd) = 'OUTROS') then
    Result := True;

  If fJaFoiLiberadoAvisado('INTPAR', 'INTPAR'+strCodCnd+strParcelas) Then
    Result := True;

  If (Not Result) Then
  Begin
    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('Liberação de valor da parcela fora do intervalo permitido');
      objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'  , strCodCli + '-' + strCliNom                                    , 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vendedor' , IIF(fEmptyStr(strCodVen), strCodDig + '-' + fRetNomVendRep(strCodDig),
                                                                  strCodVen + '-' + fRetNomVendRep(strCodVen))               , 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Cond.Pagto', strCodCnd + '-' + fRetDesConPag(strCodCnd) + ' ' + fFormataCondPag(strConPag), 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pagto', strCodFpg + '-' + fRetDescFpg(strCodFpg)                     , 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Total Doc', FloatToStrF(fltTotGer, ffNumber, 12, 2)                     , 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Parcelas', strParcelas                                                     , 12);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Mínimo por Parcela', FloatToStrF(fltParMin, ffNumber, 12, 2), 21);
      objLiberacao.objMsgLibera.pAddTextoCaption('Vr.Máximo por Parcela', FloatToStrF(fltParMax, ffNumber, 12, 2), 21);

      If strTraSen = 'S' Then
      Begin
        objLiberacao.strDirAce := 'INTPAR';
        objLiberacao.strDirAceAuxiliar := 'INTPAR'+strCodCnd+strParcelas;
        objLiberacao.strSenLib := fCfgSis('SENLBD');
        objLiberacao.strMsgSen := 'Liberação de Venda';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strCodVen;
        objLiberacao.strCodDig := strCodDig;
        objLiberacao.strCliente := strCodCli + '-' + strCliNom;
        objLiberacao.strCpfCnpj := strCliCgc;
        objLiberacao.blnTraTel := (strTpTrava = 'T');

        Result := fFatMensagemLiberacao(objLiberacao);
      End
      Else
      Begin
        objLiberacao.strDirAce := 'NENHUM';
        objLiberacao.blnTraTel := False;
        fFatMensagemLiberacao(objLiberacao);
      End;

    finally
      FreeAndNil(objLiberacao);
    end;
  End;

end;

