function TFatVenda.fEhSubItemEmPromoc(strCodIte: String): Boolean;
  var
    intCont: Integer;
    recIteEst: TItemEstru;

begin
  Result := False;

  If Length(arrEstruAtual) > 0 Then
  Begin
    For intCont := Low(arrEstruAtual) To High(arrEstruAtual) Do
    Begin
      If (arrEstruAtual[intCont].strCodigo = strCodIte) And (arrEstruAtual[intCont].strPromoc = 'S') Then
      Begin
        Result := True;
        Break;
      End;
    End;

    //TENTA IDENTIFICAR SE É UM ITEM PAI COM FILHO EM PROMOÇÃO
    If Not Result Then
    Begin
      recIteEst := fEhOuCompoeEstrutura(strCodIte);
      If (recIteEst.blnEstrutura) And (recIteEst.blnPrincipal) Then
      Begin
        For intCont := Low(arrEstruAtual) To High(arrEstruAtual) Do
        Begin
          If (arrEstruAtual[intCont].strPromoc = 'S') Then
          Begin
            Result := True;
            Break;
          End;
        End;
      End;
    End;
  End;
end;

procedure TFatVenda.pItensNFEspecialTinta(dtaDtaIni, dtaDtaFin: TDate;
  opcItens: TOpcItensNFespTinta; pAddItem: TPAdicionaItem; pgbProgresso: TProgressBar;
  pCancNFEspecial: TPCancNFEspecial);
var
  executor     : ITelaGravandoExecucao;
  qryTinMovDet : TUniQuery;
begin
  try
    opcItensNFespTinta := opcItens;
    qryTinMovDet := fCriaQuery();

    dtaDtaIniNestin := dtaDtaIni;
    opcItensNestin  := opcItens;

    If opcItens = opcProdutoAcabado Then
      executor := TCalculadorNotaFiscalEspecialTintometricoProdutoAcabado
                    .Create(Self, dtaDtaIni, dtaDtaFin, pAddItem, pgbProgresso, pCancNFEspecial)
                    .SetQryTinMovDet(qryTinMovDet)
    else if opcItens in [opcBasesColorantesSemDestaqueImpostos, opcBasesColorantesComDestaqueImpostos, opcColorantesTributados, opcColorantesNaoTributados] then
      executor := TCalculadorNotaFiscalEspecialTintometricoBasesColorantes
                    .Create(Self, dtaDtaIni, dtaDtaFin, pAddItem, pgbProgresso, pCancNFEspecial)
                    .SetQryTinMovDet(qryTinMovDet);

    TGravandoFactory.Executar(executor);
  finally
    FreeAndNil(qryTinMovDet);
  end;
end;

function TFatVenda.fVendedorComCondicaoPagto(strCodCnd: String; strPagCnd: String): Boolean;
  Var
    qryVenCnd: TUniQuery;
    objLiberacao : TLiberacao;
Begin
  Result := True;

  If fUtilizaCondicaoPagtoPorVendedor(False, '', '')                    And
     ((strUltCndVenLib <> strCodCnd) Or (strCodVen <> strUltCodVenLib)) Then
  Begin
    strUltCndVenLib := '';
    strUltCodVenLib := '';

    qryVenCnd := fCriaQuery;

    With qryVenCnd, SQL Do
    Begin
      Add('SELECT *');
      Add('FROM VENCND');
      Add('WHERE');
      Add('  CND_CODVEN = :CODVEN AND ');
      Add('  CND_CODCND = :CODCND     ');

      ParamByName('CODVEN').AsString := strCodVen;
      ParamByName('CODCND').AsString := strCodCnd;

      Open;
      Result := Not IsEmpty;
      Close;
    End;

    FreeAndNil(qryVenCnd);

    objLiberacao := TLiberacao.Create;
    try
      objLiberacao.objMsgLibera.pAddTexto('Liberação de Condição de Pagamento');
      objLiberacao.objMsgLibera.pAddQuebra;
      objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'       , strCodCli + ' - ' + strCliNom                , 13);
      objLiberacao.objMsgLibera.pAddTextoCaption('Cód/Descrição' , strCodCnd + ' - ' + fRetDesConPag(strCodCnd) , 13);
      If Not fEmptyStr(strPagCnd) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Condição'    , fFormataCondPag(strPagCnd)                   , 13)
      ELse If not fEmptyStr(strConPag) Then
        objLiberacao.objMsgLibera.pAddTextoCaption('Condição'    , fFormataCondPag(strConPag)                   , 13)
      Else
        objLiberacao.objMsgLibera.pAddTextoCaption('Condição'    , fFormataCondPag(fRetConPag(strCodCnd))       , 13);

      pMontaMsgCndPag(cdsVenda, objLiberacao.objMsgRemota, strCodCnd);

      objLiberacao.strDirAce := 'VENCND';
      objLiberacao.strSenLib := fCfgSis('VENCND');
      objLiberacao.strMsgSen := 'Liberação de Condição de Pagamento';
      objLiberacao.blnMosMen := True;
      objLiberacao.strCodOpe := strCodVen;
      objLiberacao.strCodDig := strCodDig;
      objLiberacao.strCliente := strCodCli + '-' + strCliNom;
      objLiberacao.tipCliFor := IIF(strOpcDoc = 'OF', cfFornecedor, cfCliente);

      Result := Result Or fFatMensagemLiberacao(objLiberacao);

    finally
      FreeAndNil(objLiberacao);
    end;

  End;

  If Result Then
  Begin
    strUltCndVenLib := strCodCnd;
    strUltCodVenLib := strCodVen;
  End;

End;

function fItemPendenteSeparacaoAutoCenter(strCodEmp,
  strNumDoc, strEspCfo: String): Boolean;
  Var
    qryPed: TUniQuery;
begin
  Result := False;

  If Not fCfgSis('AUTCEN', varBoolean) Then
    Exit;

  If Not fCfgSis('USAEXS', varBoolean) Then
    Exit;

  If strEspCfo <> 'PD' Then
    Exit;

  qryPed := fCriaQuery;
  Try
    qryPed.SQL.Add('SELECT COUNT(1)');
    qryPed.SQL.Add('  FROM (SELECT FDO_CODITE AS CODITE,');
    qryPed.SQL.Add('               SUM(FDO_QTDITE * IF(FDO_ENTSAI = "S", 1, -1)) AS QTDITE');
    qryPed.SQL.Add('          FROM FDOSEP');
    qryPed.SQL.Add('         WHERE FDO_CODEMP = :CODEMP');
    qryPed.SQL.Add('           AND FDO_NUMDOC = :NUMDOC');
    qryPed.SQL.Add('           AND FDO_PENDEN = 1');
    qryPed.SQL.Add('         GROUP BY FDO_CODITE,FDO_SEQINC) TAB');
    qryPed.SQL.Add(' WHERE QTDITE <> 0');

    qryPed.ParamByName('CODEMP').AsString := strCodEmp;
    qryPed.ParamByName('NUMDOC').AsString := strNumDoc;
    qryPed.Open;

    Result := qryPed.Fields[0].AsInteger > 0;
  Finally
    FreeAndNil(qryPed);
  End;
end;

