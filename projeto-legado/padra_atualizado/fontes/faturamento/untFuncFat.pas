    FobjControleCashback.strCodEmp           := ACodEmp;
    FobjControleCashback.strCodCli           := ACodCli;
    FobjControleCashback.strCodCnd           := ACodCnd;
    FobjControleCashback.strCodVen           := ACodVen;
    FobjControleCashback.strCodOpe           := strLoginUsuarioLogado;
    FobjControleCashback.strOrigem           := 'V';
    FobjControleCashback.cdsItens            := cdsItensVenda;
    FobjControleCashback.blnUtilizouCashback := FblnUtilizouCashback;
    FobjControleCashback.pExecutarMensagemSimulacaoCashback;
  Finally
    FreeAndNil(cdsItensVenda);
  End;
End;

function TFatVenda.fEfetivarValidacaoDoPerfilDaCondicaoNosDocumentosDesmembrados: Boolean;
  Var
    fltFatMin : Double;
begin
  Result := False;
  If (Not (('OR_PD_').Contains(Self.fGetEspecieDocumento))) Then
    Exit;
  If (fCfgSis('DESMIN', varString) <> 'S') Then
    Exit;
  If (fCfgSis('USACND', varString) <> 'S') Then
    Exit;
  If (fCfgSis('PFLCLI', varString) <> 'S') Then
    Exit;
  If (Self.fDocumentoParaFornecedor) Then
    Exit;
  If fEmptyStr(Self.strCodCnd) Then
    Exit;
  fltFatMin := fCampoTabela('CND_FATMIN', 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);
  If (fFormataFloat(fltFatMin, 2) <= 0) Then
    Exit;
  Result := True;
end;

function TFatVenda.fFechandoOREmPD : Boolean;
begin
  Result := Self.strOpcDoc.Equals('OR') And
            Self.strEspDoc.Equals('PD');
end;

function TFatVenda.fValidouValorMinimoNosDocumentosDesmembrados(const blnCalcularTotGerNoFinal : Boolean): Boolean;
  Var
    intCnt : Integer;
    fltFatMin : Double;
    fltFatMax : Double;
    objLiberacao : TLiberacao;
    objCampoTabela : IMyCampoTabela;
    blnTravar : Boolean;
    arrTotais : TDoubleArray;
begin
  Result := True;

  If (Not fEfetivarValidacaoDoPerfilDaCondicaoNosDocumentosDesmembrados) Then
    Exit;

  objCampoTabela := fCampoTabela(['CND_FATMIN', 'CND_FATMAX'], 'CADCND', ['CND_CODIGO'], [Self.strCodCnd]);

  fltFatMin := objCampoTabela.FieldByName('CND_FATMIN').AsFloat;
  fltFatMax := objCampoTabela.FieldByName('CND_FATMAX').AsFloat;

  pDesmembraMatrizesParaValidarTotalMinimo(fltFatMin, blnTravar, arrTotais, blnCalcularTotGerNoFinal);

  If (Not blnTravar) Then
    Exit;

  objLiberacao := TLiberacao.Create;
  Try
    objLiberacao.objMsgLibera.Clear;
    objLiberacao.objMsgLibera.pAddTexto('Valor do Documento Fora do Intervalo Permitido:');
    objLiberacao.objMsgLibera.pAddSeparador(100);
    objLiberacao.objMsgLibera.pAddTextoCaption('Valor mínimo permitido ', FormatFloat('#,##0.00', fFormataFloat(fltFatMin, 2)), 35);
    objLiberacao.objMsgLibera.pAddTextoCaption('Valor máximo permitido ', FormatFloat('#,##0.00', fFormataFloat(fltFatMax, 2)), 35);
    objLiberacao.objMsgLibera.pAddTextoCaption('Valores dos pedidos desmembrados ', EmptyStr, 35);
    For intCnt := Low(arrTotais) To High(arrTotais) Do
      objLiberacao.objMsgLibera.pAddTextoCaption( 'Documento (' + fStrZero(Succ(intCnt), 2) + ') ', FormatFloat('#,##0.00', arrTotais[intCnt]), 35);

    pMostraMensagemFechamentoEhOrcemPed(objLiberacao.objMsgLibera);

    objLiberacao.strDirAce := 'INTFAT';
    objLiberacao.strDirAceAuxiliar := 'INTFAT' + Self.strCodCnd + fltTotGer.ToString;
    objLiberacao.strSenLib := fCfgSis('SENLBD');
    objLiberacao.strMsgSen := 'Liberação de Venda';
    objLiberacao.strCodOpe := Self.strCodVen;
    objLiberacao.strCodDig := Self.strCodDig;
    Result := fFatMensagemLiberacao(objLiberacao);
  Finally
    FreeAndNil(objLiberacao);
  End;
end;

procedure TFatVenda.pDesmembraMatrizesParaValidarTotalMinimo(const fltFatMin : Double; out blnTravar : Boolean; out arrTotais : TDoubleArray; const blnCalcularTotGerNoFinal : Boolean);
  Const
    SEM_DESCONTO : Boolean = True;
  Var
    arrMatrizesFechamento : TMatrizesFechamento;
    intCnt : Integer;
    recAcumuladores : TCalculoTotalMatrizAcumuladores;
    recInputCalculoMatriz : TCalculoTotalMatrizInput;
    objCalculoTotalMatriz : TCalculoTotalMatriz;
    arrMatItensSav : TMatrizFechamento;
    recServicosSav : TDadosServicos;
    fltTotGerSav : Double;
    fltTotDesSav : Double;
    fltFreDigSav : Double;
    fltValFreSav : Double;
    fltFreRatSav : Double;
    strEspSav : String;
    strDocSav : String;
    strEmpSav : String;
    blnMatrizComProdutoDeBrinde : Boolean;
begin
  fltTotGerSav := Self.fltTotGer;
  fltTotDesSav := Self.fltTotDes;
  fltFreDigSav := Self.fltFreDig;
  fltValFreSav := Self.fltValFre;
  fltFreRatSav := Self.fltFreRat;
  strEspSav := Self.strEspOrc;
  strDocSav := Self.strNumOrc;
  strEmpSav := Self.strEmpOri;
  FillChar(recInputCalculoMatriz, SizeOf(recInputCalculoMatriz), #0);
  recInputCalculoMatriz.fltPorDesSav := Self.fltPorDes;
  recInputCalculoMatriz.strEspDocSav := Self.strEspDoc;
  recInputCalculoMatriz.fltDesSav := Self.fltDesEsp;
  recInputCalculoMatriz.fltFreSav := Self.fltValFre;
  recInputCalculoMatriz.fltAdtSav := Self.fltValAdt;
  recInputCalculoMatriz.fltAceSav := Self.fltDesAce;
  recInputCalculoMatriz.fltFreRatSav := Self.fltFreRat;
  recInputCalculoMatriz.fltTaxEntSav := Self.fltTaxEnt;
  recInputCalculoMatriz.fltFreSugSav := Self.fltFreSug;
  recInputCalculoMatriz.fltFreCotSav := Self.fltFreCot;
  recServicosSav := Self.FRecSer;
  pCopiarMatrizItens(Self.arrMatItens, arrMatItensSav);
  Try
    blnTravar := False;
    SetLength(arrTotais, 0);

    For intCnt := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      FillChar(arrMatItens[intCnt].recBackup, SizeOf(arrMatItens[intCnt].recBackup), #0);
      arrMatItens[intCnt].recBackup.fltDesEsp := arrMatItens[intCnt].fltDesEsp;
      arrMatItens[intCnt].recBackup.fltDesAce := arrMatItens[intCnt].fltDesAce;
      arrMatItens[intCnt].recBackup.fltValFre := arrMatItens[intCnt].fltValFre;
      arrMatItens[intCnt].recBackup.fltFreRat := arrMatItens[intCnt].fltFreRat;
      arrMatItens[intCnt].recBackup.fltFreSug := arrMatItens[intCnt].fltFreSug;
      arrMatItens[intCnt].recBackup.fltFreCot := arrMatItens[intCnt].fltFreCot;
      arrMatItens[intCnt].recBackup.fltTaxEnt := arrMatItens[intCnt].fltTaxEnt;
    End;

    If fRateiaFreteItensTransportadora(Self.strCodTra, Self.strTipFre) And (Self.fltValFre > 0) Then
    Begin
      Self.fltFreRat := Self.fltValFre;
      Self.fltValFre := 0.00;
      Self.fltFreDig := 0.00;
      recInputCalculoMatriz.fltFreSav := 0;
      recInputCalculoMatriz.fltFreRatSav := Self.fltFreRat;
    End;

    Self.pCalculaTotGer(SEM_DESCONTO);
    recInputCalculoMatriz.fltTotSav := Self.fltTotGer;
    If Self.fRetTotSer > 0 Then
      recInputCalculoMatriz.fltTotSav := recInputCalculoMatriz.fltTotSav - Self.fRetTotSer;

    pGerarMatrizesPDOR(arrMatrizesFechamento, blnMatrizComProdutoDeBrinde, recInputCalculoMatriz.strEspDocSav);

    If (Length(arrMatrizesFechamento) <= 1) Then
      Exit;

    recInputCalculoMatriz.fltTotItensNaoRateiaFreteVendaPresencial := 0;
    If (Self.blnVendaPresencial) Then
      pTotalizaItensNaoRateiaFreteVendaPresencial(arrMatrizesFechamento, recInputCalculoMatriz.fltTotItensNaoRateiaFreteVendaPresencial);

    FillChar(recAcumuladores, SizeOf(recAcumuladores), #0);

    objCalculoTotalMatriz := TCalculoTotalMatriz.Create(recInputCalculoMatriz);
    Try
      For intCnt := 0 To Pred(Length(arrMatrizesFechamento)) Do
      Begin
        Self.arrMatItens := arrMatrizesFechamento[intCnt];

        If fTemItemServico Then
          Self.FRecSer := recServicosSav
        Else
          FillChar(Self.FRecSer, SizeOf(Self.FRecSer), #0);

        objCalculoTotalMatriz.CalcularMatriz(Self, arrMatrizesFechamento, intCnt, recAcumuladores);

        SetLength(arrTotais, Succ(Length(arrTotais)));
        arrTotais[Pred(Length(arrTotais))] := Self.fltTotGer;

        If (Not blnTravar) Then
          blnTravar := (fFormataFloat(Self.fltTotGer, 2) < fFormataFloat(fltFatMin, 2));
      End;
    Finally
      FreeAndNil(objCalculoTotalMatriz);
    End;
  Finally
    Self.fltTotGer := fltTotGerSav;
    Self.fltTotDes := fltTotDesSav;
    Self.fltFreDig := fltFreDigSav;
    Self.fltPorDes := recInputCalculoMatriz.fltPorDesSav;
    Self.strEspDoc := recInputCalculoMatriz.strEspDocSav;
    Self.fltDesEsp := recInputCalculoMatriz.fltDesSav;
    Self.fltValFre := fltValFreSav;
    Self.fltFreRat := fltFreRatSav;
    Self.fltValAdt := recInputCalculoMatriz.fltAdtSav;
    Self.fltDesAce := recInputCalculoMatriz.fltAceSav;
    Self.fltTaxEnt := recInputCalculoMatriz.fltTaxEntSav;
    Self.fltFreSug := recInputCalculoMatriz.fltFreSugSav;
    Self.fltFreCot := recInputCalculoMatriz.fltFreCotSav;
    Self.FRecSer := recServicosSav;
    Self.strEspOrc := strEspSav;
    Self.strNumOrc := strDocSav;
    Self.strEmpOri := strEmpSav;
    pCopiarMatrizItens(arrMatItensSav, Self.arrMatItens);
    If (blnCalcularTotGerNoFinal) Then
      Self.pCalculaTotGer;
  End;
end;

