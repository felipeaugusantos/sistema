{*         CALCULANDO PROPROCIONALMENTE AOS ITENS DEVOLVIDOS.                                                *}
{*       - NAO DEVE SER UTILIZADO O CALCULO DAS ABREVIACOES FISCAIS                                          *}
{*       - TEMOS QUE ENQUADRAR NESTA SITUACAO:                                                               *}
{*         * CST ( ICMS, IPI, PIS e COFINS )                                                                 *}
{*         * BASE DE ICMS                                                                                    *}
{*         * VALOR DE ICMS                                                                                   *}
{*         * BASE DE IPI                                                                                     *}
{*         * VALOR DE IPI                                                                                    *}
{*         * BASE DE ST                                                                                      *}
{*         * VALOR DE ST                                                                                     *}
{*                                                                                                           *}
{*       - O OBJETIVO DESTA ALTERACAO E´ DEIXAR A NOTA DE DEVOLUCAO FIEL A NOTA DE ENTRADA.                  *}
{*************************************************************************************************************}
procedure TFatVenda.pCalculaFreteDespAcessDevolucaoFornecedor;
  Var
    item: TDadosFechamento;
begin
  If Not fEhDevolucaoEspelhoOuParaFornecedor Then
    Exit;

  If fEhDevolucaoEspelhoPorAD Then
    Exit;

  Self.fltValFre := 0;
  Self.fltDesAce := 0;
  Self.fltFreSug := 0;
  Self.fltFreCot := 0;

  For item In ArrMatItens Do
  Begin
    If Assigned(objItensNotaEspelho[item.strIncDev]) Then
    Begin
      objItensNotaEspelho[item.strIncDev].pCalculaImpostosProporcional(item.fltQtdIte);
      Self.fltValFre := Self.fltValFre + objItensNotaEspelho[item.strIncDev].itemCalc.fltValFre;
      Self.fltDesAce := Self.fltDesAce + objItensNotaEspelho[item.strIncDev].itemCalc.fltDesAce;
      Self.fltFreSug := Self.fltFreSug + objItensNotaEspelho[item.strIncDev].itemCalc.fltFreSug;
      Self.fltFreCot := Self.fltFreCot + objItensNotaEspelho[item.strIncDev].itemCalc.fltFreCot;
    End;
  End;

  Self.fltValFreDevEspApurado := Self.fltValFre;
  Self.fltDesAceDevEspApurado := Self.fltDesAce;

  Self.blnApurouValFreDesAceDevolucaoEspelho := True;
End;

procedure TFatVenda.pCalculaFreteDespAcessDevolucaoEspelhoPorAD;
  Var
    item: TDadosFechamento;
begin

  If not fEhDevolucaoEspelhoPorAD Then
    Exit;

  Self.fltValFre := 0;
  Self.fltDesAce := 0;

  For item In ArrMatItens Do
  Begin
    Self.fltValFre := Self.fltValFre + item.fltValFre;
    Self.fltDesAce := Self.fltDesAce + item.fltDesAce;
  End;
End;

procedure TFatVenda.pCalculaDescontoEspecialDevolucaoFornecedor;
  Var
    item: TDadosFechamento;
begin
  If Not fEhDevolucaoEspelhoOuParaFornecedor Then
    Exit;

  Self.fltDesEsp := 0;

  For item In ArrMatItens Do
  Begin
    If Assigned(objItensNotaEspelho[item.strIncDev]) Then
    Begin
      objItensNotaEspelho[item.strIncDev].pCalculaImpostosProporcional(item.fltQtdIte);
      Self.fltDesEsp := Self.fltDesEsp + objItensNotaEspelho[item.strIncDev].itemCalc.fltDesEsp;
    End;
  End;

End;

procedure TFatVenda.pAjustarDescontoEspecialDevolucaoFornecedorConformeNotasOriginais;
  Var 
    intIdx: Integer;
begin
  If (Self.fltDesEsp > 0) And (Self.fEhDevolucaoEspelhoOuParaFornecedor) Then
  Begin   
    For intIdx := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If Assigned(objItensNotaEspelho[arrMatItens[intIdx].strIncDev]) Then
      Begin
        objItensNotaEspelho[arrMatItens[intIdx].strIncDev].pCalculaImpostosProporcional(arrMatItens[intIdx].fltQtdIte);
        arrMatItens[intIdx].fltDesEsp := objItensNotaEspelho[arrMatItens[intIdx].strIncDev].itemCalc.fltDesEsp;
      End;
    End;
  End;
end;

