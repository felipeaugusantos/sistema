function TFatVenda.fGeraNovoPedidoEntregaCD(strOriF11_: String; strEmpCfg: String; AMatrizFechamento : TMatrizFechamento): Boolean;
begin
  Result := (strOriF11_ = 'S') And
            (fCfgSis('EMPFAT', VarBoolean, strEmpCfg)) And
