      calcCustoReal.fltPreCus := APrecoMedio;
      calcCustoReal.fltOutVal := fRetOutVal(dtsDadIte.FieldByName('ITE_OUTVAL').AsFloat);
      calcCustoReal.fltIcmSai := fRetIcmSai(dtsDadIte.FieldByName('ITE_ICMSAI').AsFloat);
      calcCustoReal.fltImpFed := fRetImpFed(dtsDadIte.FieldByName('ITE_IMPFED').AsFloat);
      calcCustoReal.fltDesOpe := fProcessarDespesasOperacionaisComplementar(fRetDesOpe(dtsDadIte.FieldByName('ITE_DESOPE').AsFloat));

      strCodSit := '';
      strCodAbf := fGetCodAbf(dtsDadIte.FieldByName('ITE_CODITE').AsString, fGetEmpCalculoItem(strEmpresaItem));
      If (Not fEmptyStr(Self.GetTipAbf(strEmpresaItem))) And (fBuscaAbfIcm(dtsDadIte.FieldByName('ITE_CODITE').AsString, strEmpresaItem, strCodAbf, fTrocaUFEndEntrega)) Then
        strCodSit := cdsAbfIcm.FieldByName('ABF_CODSIT' + Self.GetTipAbf(strEmpresaItem)).AsString;

      calcCustoReal.fltDifal := fGetAlqDifal(dtsDadIte.FieldByName('ITE_CODITE').AsString,
                                             strEmpresaItem,
                                             strCodAbf,
                                             strCodSit);

      calcCustoReal.fltFcp   := fGetAlqFcpIcms(dtsDadIte.FieldByName('ITE_CODITE').AsString,
                                               strEmpresaItem,
                                               strCodAbf,
                                               strCodSit,
                                               fRetIcmSai(dtsDadIte.FieldByName('ITE_ICMSAI').AsFloat),
                                               calcCustoReal.fltUnitar);

      Result := fRetornaPrecoCusto(Preco_de_Custo_Real,
                                   dtsDadIte.FieldByName('ITE_CODITE').AsString,
                                   strEmpresaItem,
                                   0,
                                   '',
                                   calcCustoReal,
                                   (Pos('ITEM ESPECIAL', qryConCit.FieldByName('ITE_DESITE').AsString) > 0));
    Finally
      FreeAndNil(calcCustoReal);
    End;
  end;

  function fPegaUnitarioTrava(intNivel: Integer): Double;
    Var
      fltValTaxAux: Double;
  begin
    Result := fFormataFloat(fRetornaUnitarioTrava( strIdeProIte, fltUniLiqTmp,
                                                   IIF(fTemQuantEmbalagemFechada(strCodIte),fltUniVis,fltUniOriIte),
                                                   fltUniDev, fltQtdIte,
                                                   fltQtdJaDig, fltQtdJaEmPromoc, strEmpresaItem, strOpcao,
                                                   blnConsideraPromocao, blnEmCamp, strTabPreIte, intPrzMed, cdsVenda,
                                                   fltPreLot, intNivel, blnEntIme, blnEntFut, strMotFut, strBarEmb, blnProAcaIte,
                                                   blnIteCom, fltPrecoSubItemEstrutura, fltVolPro, cdsIteTin, Self.fltSomaColorantes), intDecUni);

    If (Not fAplicarTaxaDeJurosDaCondicaoNaFormacaoDoCusto) And (Not blnEmCamp) Then
    Begin
      fltValTaxAux := fGetTaxVprItem(strCodIte, strEmpresaItem);
      If (fltValTaxAux > 0) Then
      Begin
        If fPermiteAplicarJurosNaPromocao(strPromocIte) Then
          Result := fCalculaPrecoVendaConformeTaxaJurosOuJurosRemanescentePromoc(strCodIte, Result, fltValTaxAux);
      End;
    End;
  end;

  function fEhItemEstrutura(strCodIte: String): Boolean;
  Begin
    Result := (stlItensNaoEhEstrutura.IndexOf(strCodIte) = -1) And fItemEstrutura(strCodIte);
  End;

  function fGetPreVenIte(strTabIte: String): Double;
  begin
    Result := fltUniOriIte;

    If strPromocIte <> 'S' Then
      Exit;

    If fEmptyStr(strTabIte) Then
      strTabIte := Self.strTabPre;

    If (strIdeProIte <> 'NOR') Or fEhItemVendaVidro(strCodIte) Or (blnProAcaIte) Then
    Begin
      Result := GetPropValue(Self, 'fltPreVe' + strTabIte);
    End
    Else
    Begin
      If fEhItemEstrutura(strCodIte) And
         fUtilizaPrecoSubItensEstrutura(fIsItemEspecial(strCodIte), strCodIte) Then
      Begin
        Result := fCalculaPrecoEstrutura(False, Preco_de_Venda, strCodIte, strEmpresaItem, 'S', strTabIte, fltMargem)
      End
      Else If (qryConIte.Active) Then
        Result := qryConIte.FieldByName( 'ITE_PREVE' + strTabIte).AsFloat;
    End;

    If Result = 0.00 Then
      Result := fltUniOriIte;
  end;

  procedure pAdicionaItensTravaMinina;
    var
      objTravaMinima: TMostraTravaMinima;
  Begin
    objTravaMinima := TMostraTravaMinima.Create;
    Try
      objTravaMinima.strCodIte  := strCodIte;
      objTravaMinima.strEmpIte  := strEmpresaItem;
      objTravaMinima.strDesIte  := strDesIte;
      objTravaMinima.strUnidad  := strUnidad;
      objTravaMinima.fltQtdIte  := fltQtdIte;
      objTravaMinima.strIdePro  := strIdeProIte;
      If (fCfgSis('MMPOPM') = 'B') Then
      Begin
        If (TMargemMinima.UsaPrecoMedio) Then
          objTravaMinima.fltPreCus := Self.fltPreMed
        Else
          objTravaMinima.fltPreCus := Self.fltPreCus;
      End
      Else
      Begin
        If (TMargemMinima.UsaPrecoMedio) Then
          objTravaMinima.fltPreCus := fPrecoMedioReal(Self.fltPreMed)
        Else
          objTravaMinima.fltPreCus := Self.fltPreCu2;
      End;

      If (Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0) Then
        objTravaMinima.fltVlrTab := fltUniDev
      Else
        objTravaMinima.fltVlrTab := fltUniOriIte;

      If blnAlteracao Then
        objTravaMinima.strAutInc := cdsVenda.FieldByName('AUTOINCREM').AsString;

      If (blnExecMontaMsgInterna) Then
        TMostraTravaMinimaHelper.pVerificaItensDeletados(cdsVenda, cdsTravaMinima);

      TMostraTravaMinimaHelper.pAddItemTravaMinima(cdsTravaMinima,
                                                   cdsVenda,
                                                   fltUniTraPro,
                                                   fltUniTraProNv2,
                                                   fltUniTraProNv3,
                                                   fltUniTraProNv4,
                                                   fltUniTraProNv5,
                                                   fltUniTraProNv6,
                                                   Self.strOpcDoc,
                                                   objTravaMinima,
                                                   Self);
    Finally
      FreeAndNil(objTravaMinima);
    End;
  End;

  procedure pCalculaValoresNiveisDeTrava;
  Begin
    {**************************************}
    {* TRATAMENTO DE SENHA FIXA, VARIAVEL *}
    {* OU POR USUARIO                     *}
    {***********************************WI*}
    fltUniTabela := IIF(Pos(strOpcDoc, 'DV_PR_DD_CR_') > 0, fltUniDev, fGetPreVenIte(strTabPreIte));

    If (VS_strTRADES = '2') Or //CONFIGURADO TRAVA POR DESCONTO MAXIMO
       (VS_strTRADES = '3') Or //CONFIGURADO PARA TRAVAR POR MARGEM MINIMA
       (TipoOpcaoDeTrava.fOpcaoDeTravaEhPorAtividade) Then
    Begin
      fltUniTraProNv2 := fPegaUnitarioTrava(2);//Nivel 2
      fltUniTraProNv3 := fPegaUnitarioTrava(3);//Nivel 3
      fltUniTraProNv4 := fPegaUnitarioTrava(4);//Nivel 4
      fltUniTraProNv5 := fPegaUnitarioTrava(5);//Nivel 5
      fltUniTraProNv6 := fPegaUnitarioTrava(6);//Nivel 6

      blnNiVel2 := fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraProNv2, intDecUni);
      blnNiVel3 := fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraProNv3, intDecUni);
      blnNiVel4 := fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraProNv4, intDecUni);
      blnNiVel5 := fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraProNv5, intDecUni);
      blnNiVel6 := fFormataFloat(fltUniLiqTmp, intDecUni) < fFormataFloat(fltUniTraProNv6, intDecUni);

      {****************************************************************}
      {* SE CASO FOR TINTA DE MAQUINA E A MESMO NÃO É CONSIDERADA     *}
      {* COMO PRODUTO NORMAL O NIVEL 2 E 3 É O MESMO VALOR DO NIVEL 1 *}
      {*************************************************************FC*}
      If (strIdePro <> 'NOR') And
         (Not fTravaUnitarioDeTintaComoProdutoNormal) Then
      Begin
        If fltUniTraProNv2 = 0 Then
          fltUniTraProNv2 := fltUniTraPro;

        If fltUniTraProNv3 = 0 Then
          fltUniTraProNv3 := fltUniTraPro;

        If fltUniTraProNv4 = 0 Then
          fltUniTraProNv4 := fltUniTraPro;

        If fltUniTraProNv5 = 0 Then
          fltUniTraProNv5 := fltUniTraPro;

        If fltUniTraProNv6 = 0 Then
          fltUniTraProNv6 := fltUniTraPro;
      End;
    End;
  End;

  procedure pAtualizaTotalUnitario;
  begin
    fltUnitar := fFormataFloat(fltUniLiqTmp, intDecUni);

    fltTotIte := fCalculaTotalItem(strIdeProIte, fltUnitar, fltQtdIte, fltPreEmb, fltQtdEmb);

    {**************************************}
    {* CASO NAO SEJA ORCAMENTO, VALIDA    *}
    {* LIMITE DE CREDITO                  *}
    {***********************************WI*}
    fltTotalG := fltTotalG + fltTotIte;

    If blnAlteracao Then
    Begin
      fltTotalG := fltTotalG - fltTotIteAnt;
    End;
  end;

  function fItemCarregadoJuntoPDouOR: Boolean;
  begin
    Result := (Length(cdsVenda.FieldByName('ITE_SEQDET').AsString) = 20) And
              (Not fEmptyStr(cdsVenda.FieldByName('ITE_NUMORC').AsString)) And
              (Not fEmptyStr(cdsVenda.FieldByName('ITE_ESPORC').AsString)) And
              (Not fEmptyStr(cdsVenda.FieldByName('ITE_EMPORC').AsString));
  end;

  function fGetItemCalcularMargem: TItemCalcMargem;
  begin
    If (Not cdsVenda.IsEmpty) And (cdsVenda.FieldByName('ITE_CODITE').AsString = dtsDadIte.FieldByName('ITE_CODITE').AsString) Then
      cdsCadIte := cdsVenda
    Else
      cdsCadIte := dtsDadIte;

    Result := TItemCalcMargem.Create;

    Result.ITE_IDEPRO := strIdeProIte;
    Result.ITE_CODITE := strCodIte;
    Result.ITE_DESITE := strDesIte;
    Result.ITE_PROMOC := strPromocIte;
    Result.ITE_EMPITE := strEmpresaItem;
    Result.ITE_TABPRE := IIF(fEmptyStr(strTabPreIte), strTabPre,strTabPreIte);
    Result.ITE_IMPDIR := GetImpDir(strCodIte, strEmpresaItem);
    Result.ITE_QTDITE := fltQtdIte;
    Result.ITE_CUSITE := fltCusIte;
    Result.ITE_UNITAR := fltUniLiqTmp;
    Result.ITE_UNIORI := fltUniOriIte;
    Result.ITE_PREMED := fltPreMed;
    Result.ITE_IMPULT := fltImpUlt;
    Result.ITE_PREULT := fltPreUlt;
    Result.ITE_COMTBL := fGetComissaoTabelaItem;

    pCarregaValoresCusto(cdsCadIte.FieldByName('ITE_CODITE').AsString,
                         fGetEmpCalculoItem(strEmpresaItem),
                         IIF(strTabPreIte.IsEmpty, strTabPre, strTabPreIte));

    Result.ITE_IMPFED := fRetImpFed(cdsCadIte.FieldByName('ITE_IMPFED').AsFloat);
    Result.ITE_OUTVAL := fRetOutVal(cdsCadIte.FieldByName('ITE_OUTVAL').AsFloat);
    Result.ITE_DESOPE := fRetDesOpe(cdsCadIte.FieldByName('ITE_DESOPE').AsFloat);
    Result.ITE_ICMSAI := fRetIcmSai(cdsCadIte.FieldByName('ITE_ICMSAI').AsFloat);

    If cdsCadIte.FindField('ITE_NUMLOT') <> Nil Then
      Result.ITE_NUMLOT := cdsCadIte.FieldByName('ITE_NUMLOT').AsString;

    If cdsCadIte.FindField('ITE_VAL_ST') <> Nil Then
      Result.ITE_VAL_ST := cdsCadIte.FieldByName('ITE_VAL_ST').AsFloat;

    If cdsCadIte.FindField('ITE_VALIPI') <> Nil Then
