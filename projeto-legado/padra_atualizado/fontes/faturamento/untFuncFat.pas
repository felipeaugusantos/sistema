function TFatVenda.fCarregaItensDevolucaoAD(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    qryIteDev: TUniQuery;
    qryItens: TUniQuery;
    intOrdIte: Integer;
    blnDevTin: Boolean;

    recMadeira: untTypesSistema.TDadosMadeira;

    recForTin: TForTin;

    strTmpDoc,
    strTmpEsp,
    strTmpEmp: String;
    blnImpRef: Boolean;

    strTipEmb: String;  // Tipo de Embalagem (Litro / Galão )
    intQtdEmb: Double;  // Quantidade de Embalagem
    fltPreEmb: Double;  // Preço da Embalagem

    blnInseriu: Boolean;

    blnBaixaSubItemEstrutura: Boolean;

    fltImcSTPV : Double;
    blnCalcST : Boolean;
    strClaFis : String;
    frmFatDigDadosGarantia : TfrmFatDigDadosGarantia;

    function f(dtsDataset: TDataSet; strNomCam: String): TField;
    begin
      Result := dtsDataset.FieldByName(strNomCam);
    end;
begin
  Result := True;

  pInformacao('Aguarde, Carregando itens devolução...', pgbStatus);

  strTmpDoc := '';
  strTmpEsp := '';
  strTmpEmp := '';
  strClaFis := '';
  blnImpRef := (fCfgSis('IMPREF', varBoolean));

  Self.strEntFat := 'S';
  Self.dtaDtEntr := VS_Date;

  cdsVenda.EmptyDataSet;

  blnInseriu := False;
  Try
    intOrdIte := 1;

    // Req. 450881: no fluxo SEM AD a fonte de itens e injetada externamente (temporaria sem ADEDET)
    if Assigned(qryIteDevExterno) then
      qryIteDev := qryIteDevExterno
    else
      qryIteDev := fCriaQuery(nil);
    qryItens  := fCriaQuery(nil);

    qryItens.SQL.Add('SELECT ');
    qryItens.SQL.Add('  CADITE.*, ');
    qryItens.SQL.Add('  ITEGER.*, ');

    IF(fCfgSis('IMPDIG', varString) = '1') Then
      qryItens.SQL.Add('CADITE.ITE_IMPDIR AS IMPDIR, ')
    Else
      qryItens.SQL.Add('ITEGER.ITE_IMPDIR AS IMPDIR, ');

    If fCfgSis('TIPABF') = '1' Then
      qryItens.SQL.Add('CADITE.ITE_CODABF AS CODABF ')
    Else
      qryItens.SQL.Add('ITEGER.ITE_CODABF AS CODABF ');

    qryItens.SQL.Add('FROM ');
    qryItens.SQL.Add('  CADITE ');
    qryItens.SQL.Add('JOIN ITEGER ON ITEGER.ITE_CODITE = CADITE.ITE_CODITE AND ');
    qryItens.SQL.Add('               ITEGER.ITE_CODEMP = :CODEMP ');
    qryItens.SQL.Add('WHERE ');
    qryItens.SQL.Add('  CADITE.ITE_CODITE = :CODITE ');

    Screen.Cursor := crHourGlass;

    Try
      // Req. 450881: fonte externa (SEM AD) ja vem pronta e aberta; nao remonta o SELECT ADEDET
      if not Assigned(qryIteDevExterno) then
      begin
        qryIteDev.SQL.Clear;
        qryIteDev.SQL.Add('SELECT ');
        qryIteDev.SQL.Add('  AD.DET_QTDDEV AS DET_QTDITE, ');
        If Not fEhDevolucaoEspelhoOuParaFornecedor Then
        Begin
          qryIteDev.SQL.Add('  AD.DET_UNIDEV AS DET_UNITAR, ');
          qryIteDev.SQL.Add('  ROUND(AD.DET_QTDDEV * AD.DET_UNIDEV, 2) AS DET_TOTITE, ');
        End
        Else
        Begin
          qryIteDev.SQL.Add('  D.DET_UNITAR AS DET_UNITAR, ');
          qryIteDev.SQL.Add('  ROUND(AD.DET_QTDDEV * D.DET_UNITAR, 2) AS DET_TOTITE, ');
        End;

        If fEhDevolucaoEspelhoPorAD Then
        Begin
          qryIteDev.SQL.Add('    F.DET_TOTFRE, ');
          qryIteDev.SQL.Add('    F.DET_DESACE, ');
          qryIteDev.SQL.Add('    E.AUTOINCREM AS INCESPGER, ');
        End;

        qryIteDev.SQL.Add('  D.* ');
        qryIteDev.SQL.Add('FROM ');
        qryIteDev.SQL.Add('  ADEDET AD  ');
        qryIteDev.SQL.Add('  INNER JOIN ' + strTmpIteDev + ' D ON AD.DET_TIP_FC = D.DET_TIP_FC ');
        qryIteDev.SQL.Add('                                   AND AD.DET_NUMDOC = D.DET_NUMDOC ');
        qryIteDev.SQL.Add('                                   AND AD.DET_ESPDOC = D.DET_ESPDOC ');
        qryIteDev.SQL.Add('                                   AND AD.DET_CODEMP = D.DET_CODEMP ');
        qryIteDev.SQL.Add('                                   AND AD.DET_SERIE_ = D.DET_SERIE_ ');
        qryIteDev.SQL.Add('                                   AND AD.DET_CODITE = D.DET_CODITE ');
        qryIteDev.SQL.Add('                                   AND AD.DET_SEQORI = D.DET_AUTOIN ');
        qryIteDev.SQL.Add('                                   AND AD.DET_QTDORI <= D.DET_QTDORI');

        If fEhDevolucaoEspelhoPorAD Then
        Begin
          qryIteDev.SQL.Add('  LEFT JOIN ESPGER E ON E.GER_CODADE = AD.DET_CODADE     ');
          qryIteDev.SQL.Add('  LEFT JOIN ESPDET F ON F.DET_SEQGER = E.AUTOINCREM AND  ');
          qryIteDev.SQL.Add('                        F.DET_SEQDET = D.DET_AUTOIN      ');
        End;

        qryIteDev.SQL.Add('WHERE ');
        qryIteDev.SQL.Add('      AD.DET_CODADE = ' + QuotedStr(Self.strCodAde));
        qryIteDev.SQL.Add('  AND AD.DET_CODEMP = ' + QuotedStr(VS_strCodEmp));

        qryIteDev.SQL.Add('  AND AD.DET_TIP_FC = "C" ');
        qryIteDev.SQL.Add('GROUP BY ');
        qryIteDev.SQL.Add('   D.DET_TIP_FC, ');
        qryIteDev.SQL.Add('   D.DET_NUMDOC, ');
        qryIteDev.SQL.Add('   D.DET_ESPDOC, ');
        qryIteDev.SQL.Add('   D.DET_CODEMP, ');
        qryIteDev.SQL.Add('   D.DET_SERIE_, ');
        qryIteDev.SQL.Add('   D.DET_CODITE, ');
        qryIteDev.SQL.Add('  AD.AUTOINCREM  ');
        qryIteDev.Open;
      end; // Req. 450881: fim do guard "sem fonte externa"
      Result := Not qryIteDev.IsEmpty;

      If Result Then
      Begin
        If Assigned(qryIteDev.FindField('INCESPGER')) Then
        Begin
          //Se o operador cancelou a tela de dados fiscais na geração de AD. O sistema não gerou o espelho
          //então deve ser calculado o frete e despesas acessórias normalmente.
          Self.blnEspelhoADNaoEncontrado := fEmptyStr(qryIteDev.FieldByName('INCESPGER').AsString);
        End;
      End;

      blnDevTin := True;

      //Verifica se existe a dll da tinta especifica no diretorio tintas
      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        pProgresso(qryIteDev.RecNo, qryIteDev.RecordCount, pgbStatus);

        If Not fTravaERegistraStlDocDevLck(qryIteDev.FieldByName('DET_TABELA').AsString,
                                           qryIteDev.FieldByName('DET_NUMDOC').AsString,
                                           qryIteDev.FieldByName('DET_ESPDOC').AsString,
                                           qryIteDev.FieldByName('DET_CODEMP').AsString,
                                           qryIteDev.FieldByName('DET_FORCLI').AsString,
                                           qryIteDev.FieldByName('DET_AUTOIN').AsString) Then
        Begin
          Result := False;
          Exit;
        End;

        If (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
        Begin
          If (Not IsTintaExistente(qryIteDev.FieldByName('DET_IDEPRO').AsString)) Then
          Begin
            Result := False;
            Exit;
          End;
        End;
        qryIteDev.Next;
      End;

      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        If qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR' Then
        Begin
          blnDevTin := fPermiteDevolverTintaMaquina('',
                                                    '',
                                                    qryIteDev.FieldByName('DET_NUMDOC').AsString,
                                                    qryIteDev.FieldByName('DET_ESPDOC').AsString,
                                                    qryIteDev.FieldByName('DET_CODEMP').AsString,
                                                    qryIteDev.FieldByName('DET_QTDITE').AsFloat);
          Break;
        End;
        qryIteDev.Next;
      End;

      If Not blnDevTin Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é permitida a devolução de Tinta de Máquina!', ['&O k']);
        Result := False;
        Exit;
      End;

      qryIteDev.First;
      While (Not qryIteDev.Eof) Do
      Begin
        blnInseriu := False;

        if (not fEmptyStr(qryIteDev.FieldByName('AUX_NUMDRW').AsString)) then
          strNumeroDrawback := qryIteDev.FieldByName('AUX_NUMDRW').AsString;

        pProgresso(qryIteDev.RecNo, qryIteDev.RecordCount, pgbStatus);

        pPegaDocumentoEntregaFutura(qryIteDev.FieldByName('DET_NUMDOC').AsString,
                                    qryIteDev.FieldByName('DET_ESPDOC').AsString,
                                    qryIteDev.FieldByName('DET_CODEMP').AsString,
                                    strTmpDoc, strTmpEsp, strTmpEmp,
                                    qryIteDev.FieldByName('DET_CODACA').AsString,
                                    qryIteDev.FieldByName('DET_EMPACA').AsString);

        If fEmptyStr(strTmpDoc) Then
        Begin
          strTmpDoc := qryIteDev.FieldByName('DET_NUMDOC').AsString;
          strTmpEsp := qryIteDev.FieldByName('DET_ESPDOC').AsString;
          strTmpEmp := qryIteDev.FieldByName('DET_CODEMP').AsString;
        End;

        If (qryIteDev.FieldByName('DET_IDEPRO').AsString <> 'NOR') Then
        Begin
          If (TinGer.fVerificaTinDetExiste(strTmpDoc, strTmpEmp, strTmpEsp)) And
