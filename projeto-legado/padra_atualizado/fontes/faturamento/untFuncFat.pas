function TFatVenda.fGerarPedidoReservaEstoqueParaEnderecamento(blnRotinaDeTrocaDeMercadoria : Boolean = False): Boolean;
  Var
    intAux: Integer;
    endItem: TEndItem;
    endDocumento: TEndDocumento;
    objEnderecamento: TEnderecamentoProduto;
begin
  Result := True;

  If (fUsaRotinaWMS) And (strOpcDocTrue = 'DV') And
     (blnDevBaiEntFut) Then
    Exit;

  objEnderecamento := TEnderecamentoProduto.Create;
  Try
    Try
      endDocumento.strNumDoc := strNumDoc;
      endDocumento.strEspDoc := strEspDoc;
      endDocumento.strSerie_ := strSerFsc;
      endDocumento.strCodEmp := VS_strCodEmp;

      endDocumento.strCliFor := IIF(fEmptyStr(strCodCli), strCodFor, strCodCli);
      endDocumento.strTip_FC := IIF(fDocumentoParaFornecedor, 'F', 'C');

      objEnderecamento.endDocumento := endDocumento;

      For intAux := 0 To Length(arrMatItens) -1 Do
      Begin

        If fEhItemServico(arrMatItens[intAux].strCodIte) Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITEFRE') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITEMAN') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITELAN') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITEBOM') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITETAX') Then
          Continue;

        If Not fItemRealizaEnderecamento(arrMatItens[intAux].strCodIte) Then
          Continue;

        If (blnRotinaDeTrocaDeMercadoria) And (arrMatItens[intAux].strEntSai <> 'E') Then
          Continue;

        If (arrMatItens[intAux].blnProAca) And (Not fUsaRotinaWMS) Then
          Continue;

        endItem.strCodIte := arrMatItens[intAux].strCodIte;
        endItem.strCodMar := arrMatItens[intAux].strCodMar;
        endItem.strDesIte := arrMatItens[intAux].strDesIte;
        endItem.strRefere := arrMatItens[intAux].strRefere;
        endItem.strCodUni := arrMatItens[intAux].strCodUni;
        endItem.strCodFor := arrMatItens[intAux].strCodFor;
        endItem.fltQtdIte := arrMatItens[intAux].fltQtdIte;

        If (Not fEmptyStr(arrMatItens[intAux].strAiDvOr)) And (arrMatItens[intAux].strTabDev = 'MOVDET') then
          If (Not fEmptyStr(arrMatItens[intAux].strAutoincrementoGravacao)) Then
            endItem.strAutDet := arrMatItens[intAux].strAutoincrementoGravacao;

        If (blnRotinaDeTrocaDeMercadoria) Then
          endItem.strCodAmz := IIF(fCfgSis('MANEND', VarBoolean), arrMatItens[intAux].strNumLot, 'A DEFINIR')
        Else
          endItem.strCodAmz := arrMatItens[intAux].strNumLot;

        endItem.blnRefugo := False;

        endItem.blnIteAca := False;
        endItem.strCodAca := '';
        endItem.strEmpAca := '';

        If arrMatItens[intAux].blnProAca Then
        Begin
          endItem.blnIteAca := arrMatItens[intAux].blnProAca;
          endItem.strCodAca := arrMatItens[intAux].strCodAca;
          endItem.strEmpAca := arrMatItens[intAux].strEmpAca;
        End;

        objEnderecamento.pAddItem(endItem);
      End;

      If objEnderecamento.fQtdItens > 0 Then
        Result := objEnderecamento.fGerarPedidoParaReservarEstoque;

    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message, '');
      End;
    End;
  Finally
    FreeAndNil(objEnderecamento);
  End;
end;

function TFatVenda.fGerarPedidoReservaEstoqueParaEnderecamentoFulfillment: Boolean;
  Var
    intAux: Integer;
    endItem: TEndItem;
    endDocumento: TEndDocumento;
    objEnderecamento: TEnderecamentoProduto;
    LFulfillmentOpcGeracaoPDEndereca : TFulfillmentOpcGeracaoPDEndereca;
begin

  Result := True;

  objEnderecamento := TEnderecamentoProduto.Create;
  objEnderecamento.blnPedidoDeEnderecamentoFulfillment := True;

  LFulfillmentOpcGeracaoPDEndereca := fCfgSis('OPCFUL', varInteger);

  Try

    Try

      endDocumento.strNumDoc := strNumDoc;
      endDocumento.strEspDoc := strEspDoc;
      endDocumento.strSerie_ := strSerFsc;
      endDocumento.strCodEmp := VS_strCodEmp;

      endDocumento.strCliFor := IIF(fEmptyStr(strCodCli), strCodFor, strCodCli);
      endDocumento.strTip_FC := IIF(fDocumentoParaFornecedor, 'F', 'C');

      objEnderecamento.blnRetornoRemessaOutEnt := blnRcOutEnt;
      objEnderecamento.endDocumento := endDocumento;

      For intAux := 0 To Length(arrMatItens) -1 Do
      Begin

        If (LFulfillmentOpcGeracaoPDEndereca = opcComLote) Then
          If Not fLoteExiste(arrMatItens[intAux].strCodIte, VS_strCodEmp) Then
            Continue;

        If (LFulfillmentOpcGeracaoPDEndereca = opcSemLote) Then
          If Not fItemRealizaEnderecamento(arrMatItens[intAux].strCodIte) And
             Not fLoteExiste(arrMatItens[intAux].strCodIte, VS_strCodEmp) Then

        If fEhItemServico(arrMatItens[intAux].strCodIte) Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITEFRE') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITEMAN') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITELAN') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITEBOM') Then
          Continue;

        If arrMatItens[intAux].strCodIte = fCfgSis('ITETAX') Then
          Continue;

        endItem.strCodIte := arrMatItens[intAux].strCodIte;
        endItem.strCodMar := arrMatItens[intAux].strCodMar;
        endItem.strDesIte := arrMatItens[intAux].strDesIte;
        endItem.strRefere := arrMatItens[intAux].strRefere;
        endItem.strCodUni := arrMatItens[intAux].strCodUni;
        endItem.strCodFor := arrMatItens[intAux].strCodFor;
        endItem.fltQtdIte := arrMatItens[intAux].fltQtdIte;
        endItem.strCodAmz := 'A DEFINIR';
        endItem.blnRefugo := False;

        objEnderecamento.pAddItem(endItem);

      End;

      If objEnderecamento.fQtdItens > 0 Then
        Result := objEnderecamento.fGerarPedidoParaReservarEstoque;

    Except
      On E: Exception Do
      Begin
        Result := False;
        Raise;
      End;
    End;

  Finally
    If Assigned(objEnderecamento) Then
      FreeAndNil(objEnderecamento);
  End;

end;

function TFatVenda.fVaiGerarAjusteDeEstoqueFulfillment : Boolean;
begin

  If Self.strChaveAcesso.IsEmpty then
    Exit(False);

  Result := (fCampoTabela('NFE_GERAJU', 'NFEIMP', ['NFE_ACESSO', 'NFE_STATUS'], [Self.strChaveAcesso, 'AT']) = 'S');

end;

function TFatVenda.fGerarAjusteDeEstoqueFulfillment: Boolean;
  var
    LAjusteDeEstoque : TAjusteDeEstoque;
    LItemAjuste      : TItemAjuste;
    LItemGer         : TDadosFechamento;

  function RetornaLote(ACodIte : String) : String;
  begin

    Result := EmptyStr;

    If (Fulfillment.CodigoDoEstoqueExterno.IsEmpty) Then
      Exit;

    If fUsaRotinaWMS Or (TCadLot.ProdutoTemLote(ACodIte)) Then
      Result := TCadLot.GeraNumeroLoteEstoqueExterno(Fulfillment.CodigoDoEstoqueExterno);

  end;

begin

  Try

    LAjusteDeEstoque := TAjusteDeEstoque.New;
    LAjusteDeEstoque.Fulfillment.CopyFrom(Self.Fulfillment);

    LItemAjuste := TItemAjuste.New;

    Try

      For LItemGer In Self.arrMatItens Do
      Begin

        LItemAjuste.Limpar;
        LItemAjuste.setCodIte(LItemGer.strCodIte);
        LItemAjuste.setDesIte(LItemGer.strDesIte);
        LItemAjuste.setRefere(LItemGer.strRefere);
        LItemAjuste.setCodMar(LItemGer.strCodMar);

        LItemAjuste.setEntSai(FulfillmentMovimentacaoEstoque(Self.Fulfillment.ClassificacaoFiscal,
                                                             Self.Fulfillment.ChaveDeAcesso,
                                                             Self.Fulfillment.SiglaHubMarketPlace).EntradaSaida);

        LItemAjuste.setCodUni(LItemGer.strCodUni);
        LItemAjuste.setNumLot(RetornaLote(LItemGer.strCodIte));
        LItemAjuste.setCodAca(LItemGer.strCodAca);
        LItemAjuste.setEmpAca(LItemGer.strEmpAca);
        LItemAjuste.setCusLot(LItemGer.fltCusLot);
        LItemAjuste.setQtdPla(0.00);
        LItemAjuste.setQtdIte(LItemGer.fltQtdIte);
        LItemAjuste.setUnitar(LItemGer.fltUniTar);
        LItemAjuste.setTotIte(LItemGer.fltTotIte);

        LAjusteDeEstoque.Add(LItemAjuste);

      End;

      LAjusteDeEstoque.Fulfillment.CopyFrom(Self.Fulfillment);
      LAjusteDeEstoque.NumeroDoDocumento  := Self.strNumDoc;
      LAjusteDeEstoque.EspecieDoDocumento := Self.strEspDoc;
      LAjusteDeEstoque.CodigoDoCliente    := Self.strCodCli;
      LAjusteDeEstoque.CodigoDoVendedor   := Self.strCodVen;

      Result := LAjusteDeEstoque.Gravar;

    Finally
      FreeAndNil(LItemAjuste);
      FreeAndNil(LAjusteDeEstoque);
    End;

  Except
    Raise;
  End;

end;

function TFatVenda.fGerarSolicitaoTransferenciasColorantes: Boolean;
Var
  I: Integer;
  strEmpresaTE: String;
begin
  Result := True;
  If Not Assigned(objSolColorantesTE) Then
