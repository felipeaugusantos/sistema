  function fTemAlgumItemComQuantidadeComprarJaPreenchida: Boolean;
    Var
      item: TDadosFechamento;
      fltQtdRco: Double;
  begin
    Result := False;

    If Not fCfgSis('FALPRO', varBoolean) Then
      Exit;

    If fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
      Exit;

    If (strOriF11 <> 'S') Then
      Exit;

    If (strEspOrc <> 'PD') Then
      Exit;

    If strNumOrc.IsEmpty Then
      Exit;

    If fOrcamentoOutraLojaF11 Then
      Exit;

    For item In arrMatItens Do
    Begin
      If Not fEmptyStr(item.strSeqDet) Then
      Begin
        fltQtdRco := fCampoTabela('FDO_QTDRCO', 'EXTDOR', ['FDO_SEQFDO'], [item.strSeqDet]);

        If fltQtdRco > 0 Then
        Begin
          Result := True;
          Break;
        End;
      End;
    End;
  end;

  function fGravarRequisicaoCompraFaltaProdutoNaEmissaoPedido: Boolean;
  begin
    Result := False;

    If Not fCfgSis('FALPRO', varBoolean) Then
      Exit;

    If Not blnFinali Then
      Exit;

    If fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
      Exit;
      
    If (strOriF11 = 'S') Then  
      Exit;

    If Not Assigned(cdsMovRcd) Then
      Exit;

    If Not cdsMovRcd.Active Then
      Exit;

    If cdsMovRcd.IsEmpty Then
      Exit;

    Result := True;   
  end;

  function fAtribuirQuantidadeComprarItensParaDesmembramentoCaixa(): Boolean;
    Var
      fltQtdRes: Double;
      strEmpIte: String;
      I: Integer;
  begin
    Result := True;

    If Not Assigned(cdsMovRcd) Then
      Exit;

    If Not cdsMovRcd.Active Then
      Exit;

    cdsMovRcd.First;
    While Not cdsMovRcd.Eof Do
    Begin
      fltQtdRes := cdsMovRcd.FieldByName('RCD_QTDITE').AsFloat;

      For I := Low(arrMatItens) To High(arrMatItens) Do
      Begin
        strEmpIte := arrMatItens[I].strEmpIte;

        If blnEnt_CD Then
          strEmpIte := strEmp_CD;

        If strEmpIte <> cdsMovRcd.FieldByName('RCD_EMPITE').AsString Then
          Continue;

        If arrMatItens[I].strCodIte <> cdsMovRcd.FieldByName('RCD_CODITE').AsString Then
          Continue;

        If (arrMatItens[I].strEntRet = 'R') And (arrMatItens[I].strLocRet = 'C') Then
          Continue;

        If (arrMatItens[I].strPegou_ = 'S') Then
          Continue;

        If (Not arrMatItens[I].blnPodAlt) Then
          Continue;

        If fltQtdRes <= 0 Then
          Break;

        If fltQtdRes >= arrMatItens[I].fltQtdIte Then
          arrMatItens[I].fltQtdRco := arrMatItens[I].fltQtdIte
        Else
          arrMatItens[I].fltQtdRco := fltQtdRes;

        arrMatItens[I].strObsRco := cdsMovRcd.fieldByName('RCD_OBSERV').AsString;

        fltQtdRes := fltQtdRes - arrMatItens[I].fltQtdRco;
      End;

      cdsMovRcd.Next;
    End;
  end;

  procedure pCarregarQuantidadeComprarItensParaDesmembramentoCaixa();
    Const
      SEQ_TRAZER_VAZIO = '9999999999999999999';
    Var
      item: TDadosFechamento;
      fltQtdRco: Double;
  begin
    If Not Assigned(cdsMovRcd) Then
      Exit;

    If Not fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
      If Not blnTemAlgumItemComQuantidadeComprarJaPreenchida Then
        Exit;

    If (Self.strOriF11 <> 'S') Then
      Exit;

    pCarregaItensMovRcd(SEQ_TRAZER_VAZIO);

    Self.strInRqCp := '';
    cdsMovRcd.EmptyDataSet;

    For item In arrMatItens Do
    Begin
      fltQtdRco := fCampoTabela('FDO_QTDRCO', 'EXTDOR', ['FDO_SEQFDO'], [item.strSeqDet]);

      If fltQtdRco <= 0 Then
        Continue;

      cdsMovRcd.Insert;
      cdsMovRcd.FieldByName('RCD_CODITE').AsString := item.strCodIte;
      cdsMovRcd.FieldByName('RCD_DESITE').AsString := item.strDesIte;
      cdsMovRcd.FieldByName('RCD_OBSERV').AsString := fCampoTabela('FDO_OBSRCO', 'EXTDOR', ['FDO_SEQFDO'], [item.strSeqDet]);
      cdsMovRcd.FieldByName('RCD_DOCPDV').AsString := strNumDoc;
      cdsMovRcd.FieldByName('RCD_ESPPDV').AsString := strEspDoc;
      cdsMovRcd.FieldByName('RCD_EMPPDV').AsString := strEmpDoc;
      cdsMovRcd.FieldByName('RCD_EMPITE').AsString := item.strEmpIte;
      cdsMovRcd.FieldByName('RCD_QTDITE').AsFloat  := fltQtdRco;
      cdsMovRcd.FieldByName('RCD_ATICOM').AsString := fRetAtiComItem(item.strCodIte);
      cdsMovRcd.Post;
    End;
  end;

  function fDeveGravarReqCompraEntFuturaFaltaProdutoF11Caixa(): Boolean;
  Var
    item: TDadosFechamento;
    blnTemEntregaFuturaFaltaProduto: Boolean;
  begin
    Result := False;

    If blnTemAlgumItemComQuantidadeComprarJaPreenchida Then
      Exit(True);
        
    blnTemEntregaFuturaFaltaProduto := False;

    For item In arrMatItens Do
      If item.strEntFut.Equals('S') And item.strMotFut.Equals('F') Then
        blnTemEntregaFuturaFaltaProduto := True;

    If Not blnTemEntregaFuturaFaltaProduto Then
      Exit;

    If Not fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
      Exit;

    If Not fCfgSis('FALPRO', varBoolean) Then
      Exit;

    If strEspDoc = 'PD' Then
      Exit;

    If strEspOrc <> 'PD' Then
      Exit;

    If strNumOrc.IsEmpty Then
      Exit;

    If (strOriF11 <> 'S') Then
      Exit;

    Result := True;
  end;

  function fGravarMesmoCodEmpDoPedidoNaRequisicaoCompra: Boolean;
  begin
    Result := blnFinali And (Not blnDeveGravarReqCompraEntFuturaFaltaProdutoF11Caixa);
  end;

  function fGravarRequisicaoCompra(): Boolean;
  begin
    Result := True;

    If Not Assigned(cdsMovRcd) Then
      Exit;

    If Not cdsMovRcd.Active Then
      Exit;

    If (fGravarMesmoCodEmpDoPedidoNaRequisicaoCompra) Then
    Begin
      strSeqRqCmp := '';
      strInRqCp   := '';
    End;

    Try
      If blnFinali Then
      Begin
        cdsMovRcd.Filtered := False;
        cdsMovRcd.Filter   := ' (RCD_EMPITE = ' + QuotedStr(arrMatItens[0].strEmpIte) + ') ';
        cdsMovRcd.Filtered := True;
      End;

      If (cdsMovRcd.Active) And (Not cdsMovRcd.IsEmpty) Then
      begin
        cdsMovRcd.First;
        While Not cdsMovRcd.Eof Do
        Begin
          cdsMovRcd.Edit;

          If (blnDeveGravarReqCompraEntFuturaFaltaProdutoF11Caixa) Or
             (fChamaRequisicaoCompraPeloVendaNormal) Then
          Begin
            If (strEspDoc <> 'PD') And (blnTemAlgumItemComQuantidadeComprarJaPreenchida) Then
            Begin
              cdsMovRcd.FieldByName('RCD_DOCPDV').AsString := strNumOrc;
              cdsMovRcd.FieldByName('RCD_ESPPDV').AsString := strEspOrc;
              cdsMovRcd.FieldByName('RCD_EMPPDV').AsString := IIF(fEmptyStr(strEmpOri), VS_strCodEmp, strEmpOri);
            End
            Else
            Begin
              cdsMovRcd.FieldByName('RCD_DOCPDV').AsString := strNumDoc;
              cdsMovRcd.FieldByName('RCD_ESPPDV').AsString := strEspDoc;
              cdsMovRcd.FieldByName('RCD_EMPPDV').AsString := strEmpDoc;
            End;
          End
          Else
          Begin
            cdsMovRcd.FieldByName('RCD_DOCPDV').AsString := strNumDoc;
            cdsMovRcd.FieldByName('RCD_ESPPDV').AsString := 'PD';
            cdsMovRcd.FieldByName('RCD_EMPPDV').AsString := IIF(blnFinali, strPedEmp, IIF(Not fOrcamentoOutraLojaF11, strPedEmp, IIF(fEmptyStr(strEmpOri), strPedEmp, IIF((strEspDoc <> strEspOrc), strPedEmp, strEmpOri))));
          End;

          cdsMovRcd.Post;

          cdsMovRcd.Next;
        End;

        strEmpRqCmp := VS_strCodEmp;
        strSeqRqCmp := fCampoTabela('RCG_CODIGO', 'MOVRCG', ['AUTOINCREM'], [strInRqCp]);

        If Self.blnReqAut Then
        Begin
          If (Not TfrmFatRequisicaoCompras.fProcessarRequisicoesAvulsas(strSeqRqCmp,
                                                                        cdsVinculos,
                                                                        cdsVenda,
                                                                        Self.strCodVen,
                                                                        Self.strCodCli,
                                                                        Self.strCliCgc,
                                                                        Self.strNumDoc,
                                                                        Self.strEspDoc,
                                                                        Self.strEmpDoc,
                                                                        IIF(fCfgSis('SOLDIG', varString)='S',Self.strCodDig,''),
                                                                        False)) Then
          Begin
            fCancelaTransac;
            Result := False;
            pMensagemOk('Não foi possível gravar os vínculos de requisição de compras, [AUTINC]: ' + strInRqCp);
            Exit;
          End;

          strInRqCp := fCampoTabela('AUTOINCREM', 'MOVRCG', ['RCG_CODIGO', 'RCG_CODEMP'], [strSeqRqCmp, strEmpRqCmp]);
        End
        Else
        Begin
          If fRegravarRequisicoesDeCompra Then
          Begin
            fPedidoTemRequisicaoDeCompras(strInRqCp, strSeqRqCmp, strEmpRqCmp);
            strEmpRqCmp := IIF(fGravarMesmoCodEmpDoPedidoNaRequisicaoCompra, Self.strPedEmp, strEmpRqCmp);
            If fEmptyStr(strEmpRqCmp) Then
              strEmpRqCmp := VS_strCodEmp;
          End;

          strSeqRqCmp := fCampoTabela('RCG_CODIGO', 'MOVRCG', ['AUTOINCREM'], [strInRqCp]);

          If (Not TfrmFatRequisicaoCompras.fGravaRequisicaoCompra(strSeqRqCmp,
                                                                  strCodCli,
                                                                  strCodVen,
                                                                  strCliCgc,
                                                                  cdsMovRcd,
                                                                  False,
                                                                  strEmpRqCmp,
                                                                  IIF(fCfgSis('SOLDIG', varString)='S',strCodDig,'') )) Then
          Begin
            fCancelaTransac;
            Result := False;
            pMensagemOk('Não foi possível gravar a requisição de compras, [AUTINC]: ' + strInRqCp);
            Exit;
          End;

          strInRqCp := fCampoTabela('AUTOINCREM', 'MOVRCG', ['RCG_CODIGO', 'RCG_CODEMP'], [strSeqRqCmp, strEmpRqCmp]);
        end
      end
      Else If (Not fEmptyStr(strInRqCp)) Then
      Begin
        strSeqRqCmp := fCampoTabela('RCG_CODIGO', 'MOVRCG', ['AUTOINCREM'], [strInRqCp]);
        strEmpRqCmp := fCampoTabela('RCG_CODEMP', 'MOVRCG', ['AUTOINCREM'], [strInRqCp]);

        If (Not fReqTemCotacaoOuPcmDet(strSeqRqCmp, strEmpRqCmp)) And
           (Not untFuncoesSimples.fExecutaSQL('DELETE ' +
                                              '  FROM MOVRCG ' +
                                              ' WHERE AUTOINCREM = ' + QuotedStr(strInRqCp))) Then
        Begin
          fCancelaTransac;
          Result := False;
          pMensagemOk('Não foi possível deletar a requisição de compras, [AUTINC]: ' + strInRqCp);
          Exit;
        End;

        strInRqCp := '';
      End;
    Finally
      If blnFinali Then
        cdsMovRcd.Filtered := False;
    End;
  end;

