                                     '',
                                     '',
                                     '',
                                     '0',
                                     '',
                                     '',
                                     '',
                                     '',
                                     'N');

              If (Not Result) Then
              Begin
                fCancelaTransac;
                Exit;
              End;

              Inc(intContador);

            End;

            If (Not Result) Then
            Begin
              fCancelaTransac;
              Exit;
            End;

          End;

          cdsComDev.Next;
        End;
      End;

      pInfoStatusGravacao('Aguarde... Gravando Movimentação de Modalidades');

      If (Not fDocumentoParaFornecedor) And (Not blnEspelhoDevolucaoCliente) Then
      Begin
        If (Not fGMovMod) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;
      End;

      If Not blnEspelhoDevolucaoCliente Then
        If ((Not fDocumentoParaFornecedor) And (objNetpoints.fDesejaNetpoints(strEspDoc)) And
            (Not ((strOpcDoc = 'CI') And (blnConfirmandoUtiNps)))) Or (fDevolucaoComNetpoints) Then
      Begin
        If fDevolucaoComNetpoints Then
        Begin
          objNetpoints.strCpfCli := strCpfNpsDevolucoes;
          objNetpoints.blnCpfCad := True;
        End;

        objNetpoints.strNumDoc := strNumDoc;
        objNetpoints.strEspDoc := strEspDoc;
        objNetpoints.strCodEmp := IIF(Pos(strEspDoc, 'OR_PD_') > 0, strEmpFatGor, Vs_strCodEmp);
        objNetpoints.strCodCli := strCodCli;
        objNetpoints.strSerie_ := IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc);
        objNetpoints.fltTotPro := fltTotPro;
        objNetpoints.strCodVen := strCodVen;
        objNetpoints.dtaDtaEnt := IIF(Pos(strEspDoc, 'OR_PD_') > 0, dtaGraPed, dtaDtaEnt);

        If (Not objNetpoints.fGravaNetpointsPendencia((blnDevNota) Or (strOpcDoc = 'DV'))) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;
      End;

      {*******************************************}
      {* RESTAURA A DIGDUPLIC                    *}
      {****************************************MV*}
      For intContador := 0 To 23 Do
      Begin
        arrDuplicata[intContador] := arrDuplicCop[intContador];
      End;

      pInfoStatusGravacao('Aguarde... Gravando Log de Liberações');
      pApagaLogsDeletados;
      pGeraLogLiberacao(strNumDoc, strEspDoc, strEmpDoc);

      pProcessarOcorrenciaLimiteCredito;


      {*******************************************}
      {* CASO SEJA CONFIRMAÇÃO DE PEDIDOS, VERI- *}
      {* FICA SE É NECESSÁRIO FATURAR O PEDIDO   *}
      {****************************************MV*}
      If (Pos(strOpcDoc, 'CP_OV_') > 0) Or
         ((Not fEmptyStr(strNumOrc)) and (Not MatchStr(strOpcDoc, ['PD', 'OR']))) Or
         ((strOpcDoc = 'BR') And (blnExpedi)) Or
         ((Pos(strOpcDoc, 'CS_') > 0) and (blnExpedi)) Then
      Begin

        If (Pos(strOpcDoc, 'CP_OV_CS_') <= 0) And (Not ((strOpcDoc = 'BR') And (blnExpedi))) Then
        Begin
          SetLength(arrPedidos, 1);
          arrPedidos[Length(arrPedidos)-1].strNumPed := strNumOrc;
          arrPedidos[Length(arrPedidos)-1].strEspPed := strEspOrc;
          If Self.blnEmissaoEntFutPorFatPedEntCd Or Self.blnEmissaoPorFatPedEntCdOutLoj Or fConfPedF11ComDesmembramentoMultiLoja Or fPedTEOriginadoNaEmpresaDestino() Then
            arrPedidos[Length(arrPedidos)-1].strEmpPed := strEmpOri
          Else
            arrPedidos[Length(arrPedidos)-1].strEmpPed := IIF((Not (fOrcamentoOutraLojaF11 Or fOrcamentoOutraLojaORVN)), VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc) And (Not blnConfOrcamento), VS_strCodEmp, strEmpOri)));
          arrPedidos[Length(arrPedidos)-1].blnEntpCD := blnEnt_CD;
        End;

        pInfoStatusGravacao('Aguarde... Faturando Pedidos/Orçamentos de Venda');

        {
          Se estiver alterando o documento nao deve tentar faturar ele proprio.

          Motivo:
          Sempre que altera o pedido esta gerando uma ocorrencia no crm informando
          faturamento parcial do pedido.
        }

        If (Not ( (strNumOrc = strNumDoc) And (strEspOrc = strEspDoc))) And (Not ((blnAgrupamentoPedidos) And (fCfgSis('F11PGR', varBoolean)))) Then
        Begin
          If (Not fFaturaPedidosVenda(blnAtuExp)) Then
          Begin
            Result := False;
            fCancelaTransac;
            Exit;
          End;
        End;

        If fCfgSis('F11PGR', varBoolean) And (strOpcDoc = 'CP') And (strEspDoc = 'PD') And blnAgrupamentoPedidos Then
        Begin
          If (Not fFaturaPedidosAgrupados) Then
          Begin
            Result := False;
            fCancelaTransac;
            Exit;
          End;
        End;

      End;

      If (fCfgSis('CDTCLV', varBoolean)) And
         (Pos(strEspDoc, 'FF_IF_NF_') > 0) Then
        pGravarVinculacaoDocumentoComodatoCilindroVasilhameMovGer(strAutInc, strEspDoc);

      If blnBaiPedDev Then
      Begin

        If (Not fFaturaPedidosDevolucao) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;

      End;

      If (Self.blnEstornoNotaFiscal) And (Assigned(fBaixarEstorno)) Then
      Begin
        If (Not fBaixarEstorno) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;
      End;

      If (strOpcDocTrue = 'EF') Then
      Begin
        //Trava para EF - Entrega Futura pelo CD. Caso REQ.: 192089;
        If (Not fPdOrFoiIntegralmenteFaturado(LMensagem)) Then
        Begin
          Result := False;
          fCancelaTransac;
          fMensagem('ATENÇÃO!', 'Os itens a seguir não puderam ser faturados. Tente repetir o processo ' +
                                'e se não conseguir faturar, entre em contato com a Citel!' + LMensagem, ['&OK']);
          Exit;
        End;
      End;

      If (Pos(strOpcDoc, 'TE_OF_') > 0) And (Not fEmptyStr(strNumRemessaDevolucao)) Then
      Begin
        If (Not fFaturaPedidoEnderecamentoRemessaDevolucao(strNumRemessaDevolucao)) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;
      End;

      {****************************************************************}
      {* Grava registros de vendas perdidas inseridos pelo atalho     *}
      {* [Shift + Ctrl + F6] - Incluir Vendas Perdidas                *}
      {*************************************************************RS*}
      if strOpcDoc = 'PD' then
        strOrigemVendaPerdida := 'PEDIDO'
      else if strOpcDoc = 'VN' then
        strOrigemVendaPerdida := 'VENDA NORMAL'
      else if strOpcDoc = 'OR' then
      begin
        if strEspDoc = 'OR' Then
          strOrigemVendaPerdida := 'ORÇAMENTO'
        else if strEspDoc = 'PD' then
          strOrigemVendaPerdida := 'PEDIDO';
      End;

      if (pos(strOpcDoc, 'OE_DV') > 0) And Assigned(fAntesEmitirNotaFiscal) then
      begin
        if Not fAntesEmitirNotaFiscal(Self, strAutInc) then
        begin
          Result := False;
          fCancelaTransac;
          Exit;
        end;
      end;

      pInsereVendasPerdidas;

      {****************************************************************}
      {* ESSE BLOCO NÃO FOI REMOVIDO POR QUE NESSE MOMENTO O RESULT   *}
      {* DA ROTINA PRECISA RECEBER TRUE PARA PROSSEGUIR COM AS        *}
      {* VALIDAÇÕES, COMO É INICIALIZADO FALSE SEM CHAMAR A ROTINA    *}
      {* DA RCXCOMISSAO SEMPRE SAIA E NUMCA CONCLUIA A GRAVAÇÃO       *}
      {* ANTES DE FAZER ISSO CONVERSEI COM O JC PARA VER SE REALMENTE *}
      {* ESTAVA CORRETO                                               *}
      {*REQ. 32831 31/07/2015***************************************JU*}
      Result := True;
//      pInfoStatusGravacao('Aguarde... Gravando Controle de Comissão');
//      Result := rcxComissao.fGravaArquivos;

//      If Not Result Then
//      Begin
//        fCancelaTransac;
//        FreeAndNil(rcxComissao);
//        Exit;
//      End;

      If (Result) And Assigned(objConEnt) And (Not blnBaiEntFut) And (Not FFoiGravacaoPorDesmembramento) Then
      Begin
        If (Pos(strEspDoc, 'OR') <= 0) Then
        Begin
          objConEnt.fSetNumDoc(Self.strNumDoc,
                               Self.strEspDoc,
                               Self.strEmpDoc,
                               Self.strCodCli);

          If (strEspDoc = 'PD') Then
          Begin

            If (objConEnt.fEhControleDeEntregaRomaneioMultiloja) Then
            Begin
              objConEnt.pCarregaArrayDatasPeloPedOrc(objConEnt.arrDtaEmpEnt);
              Result := objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;
            End
            Else
            Begin
              objConEnt.pCarregaArrayDatasPeloPedOrc(objConEnt.arrDtaEnt);
              Result := objConEnt.fProcessaArrayDatasControleEntregaRomaneio;
            End;

          End 
          Else If fEmptyStr(Self.strNumOrc) Then
          Begin

            If (objConEnt.fEhControleDeEntregaRomaneioMultiloja) Then
            Begin
              objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEmpEnt);
              Result := objConEnt.fProcessaArrayDatasControleEntregaRomaneioEmpresas;
            End
            Else
            Begin
              objConEnt.pCarregaArrayDatasPeloDocFat(objConEnt.arrDtaEnt);
              Result := objConEnt.fProcessaArrayDatasControleEntregaRomaneio;
            End;

          End;
        End;

        If (Not Result) Then
        Begin
          fCancelaTransac;
          pMensagemOk('Não consegui checar a tabela de datas disponíveis na empresa '+VS_strCodEmp+'. Tente novamente!');
          Exit;
        End;  
      End;

      If Result And blnBaixaEmprestimos And Assigned(fBaixaEmprestimoFF) Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando Empréstimos');
        Result := fBaixaEmprestimoFF;
      End;

      If Result And (strOpcDoc = 'CA') And Assigned(fFaturarAjustes) Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando Ajustes');
        Result := fFaturarAjustes;
      End;

      //Se for entrada de mercadorias pelo recebimento de garantia, nao deve endereçar pois o movimento já é gravado para o lote principal de garantia.
      //Varejo car req. 81052
      If (Result) then
      Begin
        If (fGerarPedidoDeReservaDeEstoqueParaEnderecamento) Then
        Begin
          pInfoStatusGravacao('Aguarde... Gerando Pedido de Reserva para Endereçamento');
          Result := fGerarPedidoReservaEstoqueParaEnderecamento(fDeveSerGeradoPedidoDeReservaEstoqueParaEnderecamento_RotinaTrocaDeMercadorias);
        End;
      End;

      If Result and
         (not fEmptyStr(strDocExp)) and
         (not fGerarPedidoReservaEstoqueParaEnderecamentoProdutosSeparados(
                Copy(strDocExp, 01, 12),
                Copy(strDocExp, 14, 02),
                Copy(strDocExp, 17, 03))) then
      begin
        Result := False;
        fCancelaTransac;
        Exit;
      end;

      If Result And Self.GetTemProdutoComLoteCadastrado And Self.GetDevolvendoMercadoriaDoEstoqueExterno Then
      Begin
        pInfoStatusGravacao('Aguarde... Retornando estoque dos lotes');
        Result := fDevolverLotesEstoqueExterno(pgbStatus);
      End
      Else If Result And fUsaRotinaWMS(VS_strCodEmp) And Self.blnExecutandoFaturadorAutomatico Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando estoque dos lotes');
        Result := fBaixarLotesWMS(pgbStatus);
      End
      Else If Result And fUsaRotinaWMS(VS_strCodEmp) And Self.GetEnviandoMercadoriaParaLoteEstoqueExterno Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando estoque dos lotes');
        Result := fBaixarLotesWMS(pgbStatus);
      End
      Else If Result And fUsaRotinaWMS(VS_strCodEmp) And (Pos(strOpcDoc,'CP_CS_') > 0) And blnExpedi And
              ((Not blnAbastecimentoDeposito) And (Not blnRegimeEspecialPorEmpresaComFaturamentoDuplo)) Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando estoque dos lotes');
        Result := fBaixarLotesWMS(pgbStatus);
      End
      Else If Result And fUsaRotinaWMS(VS_strCodEmp) And fUsaRotinaExpedicaoConferenciaRetiraCaixa And (strEspDoc <> 'PD') And (strOriF11 = 'S') Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando estoque dos lotes');
        Result := fBaixarLotesWMS(pgbStatus);
      End;

      //Pedido somente itens retira caixa marcados como ja pegou devem ir direto para conferencia
      //sem passar pela rotina de impressao e baixa da separacao Req: 153491.
      If Result Then
      Begin
        pLiberarPedidoDiretoParaConferencia(strNumDoc, strEspDoc, strEmpDoc);
      End;

      if Result and (strOriF11 = 'S') and (not blnRealizandoAdiantamentoPedidoPeloF11) and (not fEmptyStr(strBarCom)) then
        Result := fAjustaBarCom;

      If Result And (strTipOpe = 'B') And Assigned(cdsItensPromocaoBrindes) Then
      Begin
        Result := fBaixaDocumentosPromocaoBrindes(pgbStatus);
      End;

      If (Result) And (Pos(strOpcDoc,'VN_CP_CF_CI_') > 0) And
         (Pos(strEspDoc,'NF_EL_') > 0) And ((fCfgSis('DIFCTP', varBoolean)) Or (fCfgSis('FCPCTP', varBoolean))) Then
      Begin
        recMovIcdPar.strNumDoc := Self.strNumDoc;
        recMovIcdPar.strEspDoc := Self.strEspDoc;
        recMovIcdPar.strEmpDoc := Self.strEmpDoc;
        recMovIcdPar.strCodCli := Self.strCodCli;
        recMovIcdPar.strOpcDoc := Self.strOpcDoc;

        Result := TMovIcdGravaCtp.New
                    .SetGravador(fGravaCadPagICMSUFDestino)
                    .Add( TMovIcdSomaIcmsDifalDestino.New(recMovIcdPar, Not fCfgSis('DIFCTP', varBoolean), 'ICMS DIFAL (UF Destino)') )
                    .Add( TMovIcdSomaIcmsFCP.New(recMovIcdPar, Not fCfgSis('FCPCTP', varBoolean), 'FCP ICMS') )
                    .Gravar;
      End;

      If Assigned(fGravaInfoFora) Then
        Result := fGravaInfoFora();

      If Not Result Then
      Begin
        fCancelaTransac;
        Exit;
      End;

      {*****************************************}
      {* GRAVA O LOG DE ALTERAÇÃO DE DESCRIÇÃO.*}
      {**************************************MV*}
      pInfoStatusGravacao('Aguarde... Gerando Log de Alteração de Descrição');
      pGLogDes;

      If (Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') And (not blnConfirmacaoEspelho) Then
        pInfoStatusGravacao('Aguarde... Finalizando Gravação do Documento ' + strNumDoc + '-ES')
      Else If blnEspelhoDevolucaoCliente Then
        pInfoStatusGravacao('Aguarde... Finalizando Gravação do Documento ' + strNumDoc + '-ES')
      Else
        pInfoStatusGravacao('Aguarde... Finalizando Gravação do Documento ' + strNumDoc + '-' + strEspDoc);

      If blnImpPafEcf Then
        blnGerarNfePainel := False;

      If blnGerarNfePainel Then
      Begin
        {**********************************************************************}
        {* ANTES MESMO DE EMITIR A NFE JA VAI GRAVAR O LOGNFE PARA CASO       *}
        {* OCORRA QUALQUER ERRO JA ESTEJA GRAVADO E O USUARIO POSSA EXECUTAR  *}
        {* O ENVIO PELO F1 NO PAINEL...                                       *}
        {*******************************************************************JC*}
        If fDeveEmitirNotaEletronica(strEspDoc, strEmpDoc, blnPainelNfe) And blnPainelNfe Then
        Begin

          If fUsaIntegradorSatCitel And (strEspDoc = 'IF') Then
          Begin
            If not fGravarLogSat(strNumDoc, strEspDoc, strEmpDoc, strSerFsc,
                                 IIF(strNotImp = 'S', strCodFor, strCodCli),
                                 IIF(fDocumentoParaFornecedor Or (strNotImp = 'S'),'F','C'), 'EV', VS_NumSerSat, '', VS_ImpressoraSat) Then
            Begin
              Result := False;
              fCancelaTransac;
              Exit;
            End;
          End;

          if (Not blnEmitindoNFDaNotaEspecialFatorPorValorSeraEnviadoPainel) then
            pGravarLogNfe(strNumDoc, strEspDoc, strEmpDoc, strSerFsc,
                          IIF(strNotImp = 'S', strCodFor, strCodCli),
                          IIF(fDocumentoParaFornecedor Or (strNotImp = 'S'),'F','C'), 'EE', 'Utilize F1 do Painel para Reenviar...',
                          '',
                          0,
                          '',
                          Self.intViaNfe);

          if ((not fEmptyStr(strClaFis)) and (strToInt(strClaFis) >= 5000)) and (Pos(strClaFis, fCfgSis('CLADEV')) = 0) then
            pGravarArmFat(strNumDoc,
                          strEspDoc,
                          strEmpDoc,
                          IIF(strNotImp = 'S', strCodFor, strCodCli),
                          IIF(fDocumentoParaFornecedor Or (strNotImp = 'S'), 'F', 'C'),
                          strSerFsc);

        End;

      End;

      If Result And Not blnGravandoVariosDocumentos Then
      Begin
        {********************************************************************************}
        {* SE O PEDIDO POSSUIR CREDITO DE ADIANTAMENTOS DEVE BAIXAR ESTA SALDO E LANCAR *}
        {* NO CONTAS A RECEBER DO CLIENTE ATRAVES DE DOCUMENTO DE CREDITO "CC"          *}
        {*****************************************************************************JC*}
        If Not fGerarCreditoSaldoAdiantamento(fRetPedidosDosItens(arrMatItens)) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;
      End;

      {*******************************}
      {* ANALISA GRAVAÇÃO DO CAIXA   *}
      {*26/02/2015*REQ:22285*******AF*}
      If Not fAnalisaGravacaoCaixa Then
      Begin
        Result := False;
        fCancelaTransac;
        Exit;
      End;

      {
       Req: 102895:
       Se foi alterado o cliente no pedido e pedido originário do site,
       deve atualizar as tabelas ADTCLI e MOVCAR.
      }
      If (strEspDoc = 'PD') Then
      Begin
        If Not fEmptyStr(strNumPok) Then
        Begin
          If (strCliAnt <> strCodCli) Then
          Begin
            If Not(fAtualizaClienteADTCLI_MOVCAR) Then
            Begin
              Result := False;
              fCancelaTransac;
              Exit;
            End;
          End;
        End;
      End;

      If (blnConEqu) And (strOpcDoc = 'OU') and (lstMeqMerSai.Count > 0) Then
      Begin
        pCriarVinculoNotaSaidaOS();
      End;

      If (fCfgSis('OSPDVN', varBoolean)) And
         (( (fEmptyStr(strNumOrc)) And (strEspDoc = 'PD') ) Or
            ( (strEspOrc = 'OR') And (strEspDoc = 'PD') ) ) Then
      Begin
        objOrdSer.pImprimeOrdSerIndiv(strNumDoc, strEspDoc);
      End;

      pNFeInfAdicionaisNotaEspecialComplementarDeIPI;

      pNFeInfAdicionaisFCP_AMPARA;

      pNFeInfAdicionaisAKZ(strNumDoc, strEspDoc, VS_strCodEmp);

      if fProcessaCNF_NFE then
      begin
        pNfeInfAdicionaisMOVMOD(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicDocumentosCreditoUsados( strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicDocumentosOriginaisBaixaEntFutura( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicChaveNFeReferenciada( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicNumPedidoCompraNFRemessa( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicOcoHisComplementar( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicListaVendedorNF(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicPontosClubeFidelidade(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicRestanteAPagar( strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicVoucherClubeDoPintor( strNumDoc, strEspDoc, VS_strCodEmp);
      end;

      If (strEspDoc = 'PD') And Not blnDesmembramentoDePedidos Then
      Begin
        {*********************************}
        {* DISPARA ATUALIZAÇÃO DO STATUS *}
        {******************************FS*}
        TUpdateStatus.New(TParamStatus.New()
                            .NumDoc(strNumDoc)
                            .EspDoc(strEspDoc)
                            .CodEmp(strPedEmp)
                            .CodCli(strCodCli)
                            .blnImpSfa(blnImpSfa)).pExecute();

        {*******************************}
        {* ATUALIZA RESERVA DE ESTOQUE *}
        {****************************FS*}
        {Reprocessar Saldos}
        TReprocessarSaldoItem.New
          .AddItensDoDocumento(
            TItensReprocessarDoDocumento.New
              .Documento(strNumDoc)
              .Especie(strEspDoc)
              .Empresa(strPedEmp)
            ).NotificarRoboParaReprocessarSaldos;

        {***********************************}
        {* REPLICA DADOS DE BLOQUEIO PARA  *}
        {* OS PEDIDOS DE TRANSFERÊNCIA QUE *}
        {* FORAM GERADOS A PARTIR DESSE    *}
        {********************************FS*}
        TReplInfPDTransf.New()
          .NumDoc(strNumDoc)
          .EspDoc(strEspDoc)
          .CodEmp(strPedEmp)
          .Fields(friFatGor, ['FGO_OPELIB', 'FGO_DIGLIB', 'FGO_DTALIB', 'FGO_HORLIB',
                              'FGO_OBSL01', 'FGO_OBSL02', 'FGO_LIBERA', 'FGO_OPELIC',
                              'FGO_DIGLIC', 'FGO_DTALIC', 'FGO_HORLIC', 'FGO_OBSLC1',
                              'FGO_OBSLC2', 'FGO_LIBCOM'])
          .Fields(friExtGor, ['FGO_ENVLIB'])
          .pExecute();
      End;

      If (strOpcDoc = 'CP') And (strEspDoc = 'PD') And blnAgrupamentoPedidos And (Not fEmptyStr(strNumDocsPD)) And fCfgSis('F11PGR', varBoolean) Then
        pBaixaFormulacaoPedidoAgrupado(strNumDoc, strEspDoc, VS_strCodEmp);

      If (Result) And (blnComTansacao) And (Not blnEspelhoDevolucaoCliente) Then
      begin
        if not FAuditFaturamento.fValidouTodas(strCodErrosAuditoria) then
        begin
          Result := False;
          fCancelaTransac;
          pMostraErrosAuditoria(strCodErrosAuditoria);
          Exit;
        end;

        if not FAuditoriaSaldo.fValidouTodas(strCodErrosAuditoria) then
        begin
          Result := False;
          fCancelaTransac;
          pMostraErrosAuditoria(strCodErrosAuditoria);
          Exit;
        end;

        If (Not FAuditoriaResumoCaixa.ValidouTodas(strCodErrosAuditoria)) Then
        Begin
          Result := False;
          fCancelaTransac;
          pMostraErrosAuditoria(strCodErrosAuditoria);
          Exit;
        End;
      end;


      If Assigned(fTrataEnvioFornecedorGarantia) Then
      Begin
        If not(fTrataEnvioFornecedorGarantia(FNumDoc, FEspDoc, FSerFsc)) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

      End;

      If blnExpedi And (Pos(VS_strTipExp,  '3_4_5_') > 0) And fCfgSis('USABAC', varBoolean) Then
      Begin
        objBaixaDuplicataComCredito := TBaixaDuplicataComCredito.Create(Self);
        Try
          if not objBaixaDuplicataComCredito.fBaixaDuplicatas(strNumDoc,
                                                              strEspDoc,
                                                              VS_strCodEmp,
                                                              strCodCli,
                                                              strCliNom,
                                                              fGetOperadorDaBaixa,
                                                              strCodVen,
                                                              intSeqConRcxCredito) then
          Begin
            Result := False;
            fCancelaTransac;

            Exit;
          End;
        Finally
          FreeAndNil(objBaixaDuplicataComCredito);
        End;
      End;

      If not fGravouDocumentoComDifal Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;

      If not fValoresReformaTributariaGravadosConferem Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;

      If not fMarcaSeExisteGNRE(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli) Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;

      If fCfgSis('CUPDES') = 'S' Then
      Begin
        With TFatCupomDesconto.Create(Self) Do
        Begin
          GerarCupomDesconto;

          If (strEspDoc = 'PD') And (Not fEmptyStr(FCupDesAnt)) And (FCupDesAnt <> strCupDes) Then
            DesmarcarCupomUtilizado(strNumDoc, strEspDoc, strEmpDoc);

          If (strEspDoc = 'PD') And (Not fEmptyStr(strCupDes)) Then
            MarcarCupomUtilizado(strCupDes, strNumDoc, strEspDoc, strEmpDoc);

          If strOpcDoc = 'DV' Then
            pInativarCuponsDescontoDevolucao();
        End;
      End;

      If (Result) and (not fProcessarCnf_NfeCupomDeDesconto) Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;

      {*********************************************************}
      {* QUANDO FOR FATURAMENTO, REGISTRA O CASHBACK UTILIZADO *}
      {*******************************************************BL}
      if (strEspDoc = 'NF') and
         (fCfgSis('USAGRY') = 'S') then
      begin
        objGryncash := TGryncash.Create(Self);
        try
          if not objGryncash.fRegisterCashTransaction then
          begin
            fCancelaTransac;
            Result := False;
            Exit;
          end;
        finally
          FreeAndNil(objGryncash);
        end;
      end;

      If (blnGerOrc) Then
      Begin
        pInfoStatusGravacao('Aguarde... Gerando orçamento vinculado ao pedido!');
        If Not fGerarOrcamentoBaixadoVinculadoAoPedidoDeVenda(strGerOrc, pgbStatus) Then
        Begin
          Result := False;
          fCancelaTransac;
          fMensagem('ATENÇÃO!', 'Não foi possível gerar o orçamento vinculado ao pedido!', ['&OK']);
          Exit;
        End;
      End;

      If (blnColeta) And (strOpcDoc = 'DV') And (fCfgSis('COLGAR', varString) = 'S') Then
      Begin
        pInfoStatusGravacao('Aguarde... Gerando pedido de reserva da coleta!');
        If Not fGerarPedidoDeReservaDaDevolucaoDeColetaDeProdutosDeGarantia(pgbStatus) Then
        Begin
          Result := False;
          fCancelaTransac;
          fMensagem('ATENÇÃO!', 'Não foi possível gerar o pedido de reserva da coleta!', ['&OK']);
          Exit;
        End;
      End;

      pConfirmaNotaEspecialComplementarDeIPI;

      If (strOpcDoc = 'NE') And (fCfgSis('NESTIN', varString) = 'S') And
         (fTemItensTintaPorHerancaNFEspecial) Then
      Begin
        pCancelaCobrancaEletronica(API_PAGARME_CANCELADA, strNumDoc, strEspDoc);
        pGravarNesTin;
      End;

      if ((strOpcDoc = 'PD') or (strOpcDoc = 'OR')) and fCfgSis('PMEHAB', varBoolean) and
         (TFacadeCobrancaEletronica.fCondicaoPagamentoCobrancaEletronica(strCodCnd, tcPagarMe)) then
      begin
        pGravarCobrancaEletronica(API_PAGARME, strNumDoc, strEspDoc);
      end;

      {*************************************************}
      {* GRAVAR INFORMAÇÕES DE FRETE DA FRENET, QUALP, *}
      {* DATAFRETE, INTELIPOST OU MANUAL               *}
      {**********************************************WL*}

      if (Pos(strOpcDoc,'OR_PD_') > 0) and
         (fltVlrFreFat > 0) then
      begin
        pGravaFreFat(strNumDoc,
                     strEspDoc,
                     VS_strCodEmp,
                     strCodCli,
                     strCodVen,
                     strCodTra,
                     strQlpPlaVei,
                     fCadEmp('CODCID'),
                     IIF(Not fEmptyStr(strCidEnt), strCidEnt, strCodCid),
                     strFreTipApi,
                     fltQlpDist,
                     fltQlpVlrPed,
                     fltQlpVlrCmb,
                     fltVlrFreFat,
                     intCodTab,
                     strCotId_,
                     strAutIncEndPartida,
                     intDiasEnt);

        if (strFreTipApi = 'DATAFRETE') and (strEspDoc = 'PD') then
          pGravaProcessamentoDataFrete
        else if (strFreTipApi = 'INTELIPOST') and (strEspDoc = 'PD') then
          pGravaProcessamentoIntelipost;
      end;

      If (strOpcDoc = 'BR') or ( (Pos(strEspDoc, 'FF_DV_NF_IF_NS_BR_') > 0) And (Pos(RightStr(strClaFis, 3), fCfgSis('CLABRI', VarString)) > 0) ) Then
      Begin
        If fCfgSis('BCFDCP', VarBoolean) Then
        Begin
          If (Not fGCluFid) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;
        End;
      End;

      If (Result And TTecladoSEAT.fUtilizaIntegracaoComTecladoDeSatisfacaoSEAT) Then
      Begin
        For intPed := Low(arrPedidos) To High(arrPedidos) Do
        Begin

          If TTecladoSEAT.fDocumentoJaFoiAvaliado(arrPedidos[intPed].strNumPed,
                                                  arrPedidos[intPed].strEspPed,
                                                  arrPedidos[intPed].strEmpPed) Then
          Begin
            objTecladoSEAT := TTecladoSEAT.Create;
            Try
              If objTecladoSEAT.fSetDadosDocumentoJaFoiAvaliado(arrPedidos[intPed].strNumPed,
                                                                arrPedidos[intPed].strEspPed,
                                                                arrPedidos[intPed].strEmpPed) Then
              Begin
                objTecladoSEAT.pSetNumDoc(strNumDoc);
                objTecladoSEAT.pSetEspDoc(strEspDoc);
                objTecladoSEAT.pSetEmpDoc(strEmpDoc);
                If Not objTecladoSEAT.fGravarAvaliacao Then
                Begin
                  Result := False;
                  fCancelaTransac;
                  fMensagem('ATENÇÃO!', 'Não foi possível gravar a avaliação de atendimento!', ['&OK']);
                  Exit;
                End;
              End;
            Finally
              FreeAndNil(objTecladoSEAT);
            End;
          End;

        End;
      End;

      If (Pos(strOpcDoc, 'VN_CP_') > 0) And
         (blnTemTinta) And
         (fEmpresaUtilizaRegimeEspecial) Then
      Begin
        pAtualizaDocFatRegimeEspecial_ML;
      End;

      If Result Then
        Result := fGravaUtilizacaoCashback(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, strCodCnd, strCodVen);

      If Result Then
        Result := fGravaCashback(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, strCodCnd, strCodVen);

      If (Result) And
         ((strEspDoc = 'DV') Or
          (strOpcDoc = 'DV')) Then
        Result := fDevolucaoCashbackGerado(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, strCodCnd, strCodVen);

      If (Result) Then
        Result := fProcessarCupomPromocional;

      If (Result) And (blnExecutandoFaturadorAutomatico) Then
        pAtualizaDadosFaturamentoAutomatico;

      If Result Then
        Result := fPontuarClubeDoPintor(strOpcDoc, strNumDoc, strEspDoc, VS_strCodEmp);

      If (Not Result) Then
      Begin
        fCancelaTransac;
        Exit;
      End;

      If Result And
         fEhGravacaoSimplesVenda And
         fConfirmacaoCupomAgrupandoCadRecCupons Then
      Begin
        If Not fExisteBaixaBoletosDocumentos Then
          pAgruparDuplicatasEmitemBoleto;
      End;

      pInfoStatusGravacao('Aguarde... Finalizando');

      {COMITA}
      If (blnComTansacao) Then
      Begin
        fCommit(frmModulo.GetCurrentConnection, LSafeCommitID);
        Self.blnGravouDocumentos := True;
        pExibeMensagemErroAoCarregarPonImp;
      End;

      if Self.blnGravouDocumentos then
      begin
        If FblnDisparaMensagensCashback Then
          pDispararMensagensCashback(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, strCodCnd, strCodVen);

        If Not Self.DadosPixDaVenda.AutoIncremsPedidosPixGerar.IsEmpty Then
          GeraPixDoPedido(False)
        Else If Not DadosPixDaVenda.TxIdPixRemover.IsEmpty Then
          RemoverPixDoPedido;
        TPixDao.AtualizarMONPIX_LOG(DadosPixDaVenda.ListaPixGeradosNaTelaQRCode,
                                    Self.strCodCli,
                                    Concat(Self.strNumDoc, '-', Self.strEspDoc, '-A-', VS_strCodEmp),
                                    Self.fltTotGer);

        if blnDisparaEmailSmsWhatsappDePedidosFaturados then
          pDisparaEmailSmsWhatsappPedidosFaturados;

        pGravaNotificacaoPesquisaOpiniOne;

        pGravaBoschFun;

        pSimularGeracaoCashback(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli, strCodCnd, strCodVen);
      end;

      If Assigned(objControleCupomPromocao) Then
      Begin
        objControleCupomPromocao.pImprimirCuponsGerados(
                                   Self,
                                   (fCfgSis('CPPF11', varBoolean)) And ((strOriF11 = 'S')));
      End;

      pAddDocumentoParaDisparoDeGatilho;

      If Self.blnGravouDocumentos And (strOpcDoc = 'DV') Then
      Begin
        If fCfgSis('EXISTA', varBoolean) Then
          pAtualizaStatusPedidoDevolucao;
      End;

      If (Self.blnGravouDocumentos) And (strEspDoc = 'PD') And (fCfgSis('USAVBT', varString) = 'S') And
         ((blnFinali And fVendaMultiloja) Or (Not fVendaMultiloja)) Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando pendências de recebimento');
        pStepStatusGravacao;

        If fGravarPenRec Then
        Begin
          If fCfgSis('GFPVBT', varBoolean) Then
          Begin
            pCarregaTrocaRecebimento(Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, Self.strCodCli);
          End;
        End;
      End;

      If (Self.blnGravouDocumentos) And (fAjustarHistoricoAposDevolucao) Then
        pAjustarHistoricoDeOcorrenciaAposDevolucao;

      If ((blnGerOrc) And (Not fEmptyStr(strGerOrc)) And (Self.blnGravouDocumentos)) Then
        pNotificacaoSistemaSucesso('ATENÇÃO!', 'Orçamento Confirmado Nº '+strGerOrc+'-OR'+' e Pedido Nº '+strNumDoc+'-PD'+' gravados com sucesso!', Self.strOpcDoc);

      if Assigned(FobjTefRecebimento) then //'TEFVN_'
      Begin
        If (fltValCar > 0.0) And (fCfgSis('USACTC', varBoolean)) And Assigned(FobjTefRecebimento) Then
        Begin
          LblnErroConfirmacao := False;
          If (Not FobjTefRecebimento.fConfirmaCartoes(LMensagem)) Then
          Begin
            LblnErroConfirmacao := True;
          End;

          If (LblnErroConfirmacao) Then
          Begin
            fMensagem('Atenção!', 'Ocorreu um problema na confirmação do TEF.' + sLineBreak +
                                  'Favor verificar se os cartões foram confirmados.' + sLineBreak +
                                  LMensagem, ['&OK']);
          End;
        End;
      End;

      {Envia Mensagem - Somente se Alterando!}
      If (strOpcDoc = 'PD') And (strNumDoc = strNumOrc) Then
        pMensagemPedidoAlterado(strNumDoc, strEspDoc, VS_strCodEmp);

      If fEhGravacaoSimplesVenda And blnComTansacao And (strEspDoc = 'NF') Then
        pMensagemDocumentoGNRE(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);

      strConPagGrav := strConPag;

      TTestabilidade.fGetTestabilidade.NumeroDocumento  := strNumDoc;
      TTestabilidade.fGetTestabilidade.EspecieDocumento := strEspDoc;
      TTestabilidade.fGetTestabilidade.EmpresaDocumento := VS_strCodEmp;
      TTestabilidade.fGetTestabilidade.ClienteDocumento := strCodCli;
      TTestabilidade.fGetTestabilidade.SerieDocumento   := strSerFsc;
      TTestabilidade.fGetTestabilidade.DocumentoOriginal:= strNumDoc;

      If strEspDoc = 'NF' Then
        TTestabilidade.fGetTestabilidade.RomaneioNF := strNumDoc
      Else If strEspDoc = 'FF' Then
        TTestabilidade.fGetTestabilidade.RomaneioFF := strNumDoc;

      If (blnGerarNfePainel) and (Not blnEmitindoNFDaNotaEspecialFatorPorValorSeraEnviadoPainel) Then
      Begin
        fExecutarModal(fEnviarNotaEletronicaPainel, 'Aguarde ...', '');
        if Length(FDocumentosParaEnvioNaLibNfe) > 0 Then
        begin
          fExecutarModal(fEnviarDocumentosLibNfe, 'Aguarde ...', '');
          pLimparListaDeEnvioLibNfe;
        end;
      End;

      If strOpcDoc = 'CT' Then
        objLock.pDestravarTodos;

      If fCfgSis('UTLPRJ', varBoolean) And (Not blnEspelhoDevolucaoCliente) Then
      Begin
        If (strOpcDoc = 'DV') And TProjeto.fClienteTemProjetoAtivo(strCodCli) Then
          pRecalculaDevolucoesProjetos
        Else
        If Not fEmptyStr(Self.strCodPrj) Then
          TProjeto.pRecalculaProjeto(Self.strCodPrj);
      End;

      If (Not blnGravandoVariosDocumentos) Then
        pAtualizarDadosUltimaCompra;

      Try
        {******************************************}
        {* adiciona o documento para ser impresso *}
        {***************************************JC*}

        pAdicionaDocumentoParaImpressao;

        if Result then
        begin
          pAddNotificacao(objNotificacoes);
          if blnComTansacao then
            objNotificacoes.pGravaNotificacoes(blnExecutandoFaturadorAutomatico);
        end;

        If ((blnComTansacao) And (Not fDocumentoParaFornecedor) And (objNetpoints.fDesejaNetpoints(strEspDoc)) And
            (Not ((strOpcDoc = 'CI') And (blnConfirmandoUtiNps)))) Or
           (fDevolucaoComNetpoints) Then
        Begin
          objNetpoints.pTransmitirNetpoints(objNetpoints.strNumDoc,
                                            objNetpoints.strEspDoc,
                                            objNetpoints.strCodEmp,
                                            objNetpoints.strCodCli,
                                            objNetpoints.strSerie_);
        End;

        pStepStatusGravacao;

        If Assigned(pgbStatus) Then
        Begin
          If pgbStatus.Position < pgbStatus.Properties.Max Then
            pgbStatus.Position := pgbStatus.Properties.Max;
        End;
      Except
        On E: Exception Do
        Begin
          If (Not blnComTansacao) And (blnImpPafEcf) And (Not Self.blnGravouDocumentos) Then
          Begin
            Result := False;
          End;
          pMensagensErro(E.Message,'');    //Caso de erro, não pode resultar False, pois está fora da transação
        End;
      End;
    Except
      On E: Exception Do
      Begin
        If (Not Self.blnGravouDocumentos) Then
          Result := False;
        fCancelaTransac;

        If (E.ClassType = ExceptionAuditoria) Then
          pMostraErrosAuditoria(E.Message)
        Else If (E.ClassType = ExceptionAutCom) Or
           (E.ClassType = EBaixaOrdemProducao) Then
          fMensagem('', E.Message, ['&Ok'])
        Else
          pMensagensErro(E.Message, '[fGravaArquivos]');
      End;
    End;

    Try
      If Result And (Not fEmptyStr(strAutoEntTE)) Then
      Begin
        pInfoStatusGravacao('Aguarde... Gerando Pedidos de Compra para Transferência');
        fCriarProcesso(strAutoEntTE, False, tcpOculto);
      End;

      For intContador := 0 To stlAutoConEnt.Count -1 Do
      Begin
        pInfoStatusGravacao('Aguarde... Gerando Entradas de Estoque de Transferência');
        fCriarProcesso(stlAutoConEnt[intContador], False, tcpOculto);
      End;

      For intContador := 0 To stlAutoTransfEmpCar.Count -1 Do
      Begin
        pInfoStatusGravacao('Aguarde... Gerando Transferência da(s) Empresa(s) de Carregamento');
        fCriarProcesso(stlAutoTransfEmpCar[intContador], False, tcpOculto);
      End;

      If (blnFinali) Then
        Exit;

      If blnImprimeDocs Then
      Begin
        If Pos(strEspDoc, 'OR_PD_') > 0 Then
        Begin
          If (fCfgSis('PAFECF', varBoolean)) Then
          Begin
            blnImprimeDocs := fCfgSis('IMPPAF', varBoolean);
          End
          Else
          Begin
            blnImprimeDocs := True;
          End;
        End
        Else If blnImpPafEcf Then
        Begin
          blnImprimeDocs := False;
        End;
      End;

      If (Result) And (blnImprimeDocs) And (Not blnEmitindoFFDaNotaEspecialFatorPorValor) Then
      Begin
        Try        
          VS_ExibirMensagemStayOnTop := True;        
          
          If (not blnConfirmacaoEspelho) And (Pos(strOpcDoc,'OF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') Then
          Begin
            fMensagem('', 'A Nota Fiscal não foi emitida. Será emitido espelho para autorização do fornecedor.' + #13 +
                          'Após conferido pelo fornecedor, emitir a nota fiscal pela rotina' + #13 +
                          'de Efetivação de Outras Saídas / Garantia para Fornecedor.', ['&OK']);

            TfrmEspelhoImpressao.pImprimeEspelho(Self.fOpcDocClaSub, VS_strCodEmp, strNumDoc, '', Self);
          End
          Else If blnEspelhoDevolucaoCliente Then
          Begin
            TfrmEspelhoImpressao.pImprimeEspelho('', VS_strCodEmp, strNumDoc, '', Self);
          End
          Else
          Begin
            If (blnCliFil) And (Not blnGravaCtrTe) Then
              objFatVendaImp.blnImpBol := False;

            pSimularCondicoesPagamentoPedido;//Somente deve executar após comitar e antes de imprimir o documento

            {***********************************************}
            {* SETA PARA TRUE SE CASO FOR IMPRESSAO DE NF  *}
            {* ATRAVEZ DO RECEBIMENTO DE CLIENTE (GARANTA) *}
            {* PARA PODER IMPRIMIR A SEPARAÇÃO.            *}
            {*********************************************FC}
            objFatVendaImp.blnRecCliGar := fEhRecGarantia;

            objFatVendaImp.blnImpSfa := blnImpSfa;
            objFatVendaImp.sfaStsPagto := sfaStsPagto;
            objFatVendaImp.blnSfaPag := blnSfaPag;

            pColetarAssinaturaEmissaoDocumento;

            If Not Assigned(pgbStatus) Then
              objFatVendaImp.pImprimirDocumentos(nil, nil, Self.objPerguntasImpressaoDocumento, Self.objPerguntasImpressaoSeparacao)
            Else
            Begin

              If Not fImpContratoLocacao Then
                objFatVendaImp.pImprimirDocumentos(pgbStatus, TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')), Self.objPerguntasImpressaoDocumento, Self.objPerguntasImpressaoSeparacao);

            End;
          End;

          if fImprimeTermoTintaMaquina then
          begin
            if fMensagem('', 'Deseja Imprimir o Termo de Venda de Tinta de Máquina?', ['&Sim', '&Não']) = 1 then
            begin
              pImpressaoTermoTintaMaquina;
            end;
          end;
        Finally
          VS_ExibirMensagemStayOnTop := False;        
        End;  
      End;

      If (Result) and (Self.blnGravouDocumentos) and (Self.objDadosCte.blnGrava) and (Self.objDadosCte.blnImpBoleto) then
        Self.objDadosCte.pImprimirBoletoCTe(strCodCli);

      If Result And fEhFaturamentoVendaForaEstabelecimentoAVista() And (Not fCfgSis('VFECRQ', VarBoolean)) Then
        fMensagem('ATENÇÃO!', 'Foi utilizada no faturamento uma condição à vista. ' +
                              'Encaminhe uma solicitação ao setor financeiro ou ao caixa ' +
                              'para seja feita a baixa da duplicata seguindo o pagamento do cliente. ' +
                              'O financeiro está pendente de quitação.', ['&OK']);

      If Result Then
        pExibeMensagemNovoPedidoItensAbastecimentoTransReq(Self.arrMatItens);

      pInfoStatusGravacao('Aguarde... Gravação Concluída.');

      If (Self.intNumBox > 0) Then
      Begin
        fLock_Unlock(CONTROLE_BOX_MOVGER, False, False);
        If Not (blnComTansacao) Then
          pMensagemSonora('BOX DE ENTREGA DISPONÍVEL: ' + IntToStr(Self.intNumBox) + '.', True, 48);
      End;
    Except
      On E: Exception Do
      Begin
        If (Not blnComTansacao) And (blnImpPafEcf) And (Not Self.blnGravouDocumentos) Then
        Begin
          Result := False;
        End;
        pMensagensErro(E.Message,'');    //Caso de erro, não pode resultar False, pois está fora da transação
      End;
    End;
  Finally
    Self.pgbStatusGravacao := Nil;
    SetForcarProcessMessages(False);

    If Assigned(objControleCupomPromocao) Then
      FreeAndNil(objControleCupomPromocao);
  End;
end;

procedure TFatVenda.pGravaProcessamentoDataFrete;
var
  qryDtaFre: TUniQuery;
begin
  qryDtaFre := fCriaQuery;
  try
    qryDtaFre.Close;
    qryDtaFre.SQL.Text :=
    ' INSERT INTO DTAFRE '+
    '   (AUTOINCREM, '+
    '    DTF_SEQFGO, '+
    '    DTF_SALCOT, '+
    '    DTF_ENVXML, '+
    '    DTF_CODEMP, '+
    '    DTF_CODTAB, '+
    '    DTF_COTID_) '+
    ' VALUES '+
    '   (:AUTINC, '+
    '    :SEQFGO, '+
    '    :SALCOT, '+
    '    :ENVXML, '+
    '    :CODEMP, '+
    '    :CODTAB, '+
    '    :COTID_) ';

    qryDtaFre.ParamByName('AUTINC').AsString := fRetAutoIncrem('DTAFRE', VS_strCodEmp);
    qryDtaFre.ParamByName('SEQFGO').AsString := strAutIncFatGor;
    qryDtaFre.ParamByName('SALCOT').AsString := 'N';
    qryDtaFre.ParamByName('ENVXML').AsString := 'N';
    qryDtaFre.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryDtaFre.ParamByName('CODTAB').AsInteger := intCodTab;
    qryDtaFre.ParamByName('COTID_').AsString := strCotId_;
    qryDtaFre.ExecSQL;
  finally
    FreeAndNil(qryDtaFre);
  end;
end;

function TFatVenda.fRetorncaAcaFatCrm: TAcaoFatCRM;
Begin
  If strOpcDoc = 'OR' Then
  Begin
    If strEspDoc = 'PD' Then
    Begin
      If fEmptyStr(strOrcamentoPedidoHeranca) Then
        Result := afcOrcamentoEmPedido
      Else
        Result := afcPedido;
    End
    Else
     Result := afcOrcamentoFaturado
  End
  Else
    Result := afcPedido;
End;

procedure TFatVenda.pGravaProcessamentoIntelipost;
var
  qryIntPos: TUniQuery;
begin
  qryIntPos := fCriaQuery;
  try
    qryIntPos.Close;
    qryIntPos.SQL.Text :=
    ' INSERT INTO INTPOS '+
    '   (AUTOINCREM, '+
    '    ITP_CODEMP, '+
    '    ITP_SEQFGO, '+
    '    ITP_QUOTID, '+
    '    ITP_METHID, '+
    '    ITP_DIAENT) '+
    ' VALUES '+
    '   (:AUTINC, '+
    '    :CODEMP, '+
    '    :SEQFGO, '+
    '    :QUOTID, '+
    '    :METHID, '+
    '    :DIAENT) ';

    qryIntPos.ParamByName('AUTINC').AsString  := fRetAutoIncrem('INTPOS', VS_strCodEmp);
    qryIntPos.ParamByName('CODEMP').AsString  := VS_strCodEmp;
    qryIntPos.ParamByName('SEQFGO').AsString  := strAutIncFatGor;
    qryIntPos.ParamByName('QUOTID').AsString  := strCotId_;
    qryIntPos.ParamByName('METHID').AsInteger := intCodTab;
    qryIntPos.ParamByName('DIAENT').AsInteger := intDiasEnt;
    qryIntPos.ExecSQL;
  finally
    FreeAndNil(qryIntPos);
  end;
end;

function TFatVenda.fGravaFulfillment(pgbStatus                   : TcxProgressBar = Nil;
                                     AGerarPedidoDeEnderecamento : Boolean        = False;
                                     AGerarAjusteDeEstoque       : Boolean        = False): Boolean;
  Var
    intContador : Integer;

    reiReimpressao: TReimpressao;

    arrLivFis : TArrLivFis;

    blnPrcNumCmp: Boolean;

    strMsgAux: String;
    strCodEmpOri : String;

    strCodErrosAuditoria: String;

    LMensagemDeRetorno : string;

    blnSetouEmpOri : boolean;
    strMSGTravaCaixa : String;

    {*****************************************}
    {**************** ATENÇÃO ****************}
    {*****************************************}
    {* NÃO USAR O FROLLBACK NESSA FUNCÃO E   *}
    {* SIM ESSA                              *}
    {**************************************AF*}
    function fCancelaTransac: Boolean;
    Begin
      Result := fRollback;

      If Assigned(objOcoCrm) Then
        FreeAndNil(objOcoCrm);

      If (Pos(strEspDoc,'PD_OR_') > 0) And (cdsDadosPedBaixados.Active) Then
        If (cdsDadosPedBaixados.RecordCount > 0) And (Not fOrcamentoComoPedido) Then
          pRemovePedidosPendentes;

      If (Not strMsgCancelamento.IsEmpty) Then
        Raise Exception.Create(strMsgCancelamento);
    End;

begin

  Try
    blnSetouEmpOri := False;

    fAjustaDataSistema;

    Self.pgbStatusGravacao := pgbStatus;

    pInfoStatusGravacao('Aguarde... Iniciando Gravação');

    strSepImp := '0';

    strSerieGor := '';

    strNumDocPDCorte := '';

    strPedCmpTranf := '';

    blnComTansacao := False;

    strMsgErroAdicional := '';
    blnHouveBaixaAVista := False;
    FRespMsg := False;

    Result := False;
    strOriDoc := 'V';

    strDesFpg := fRetDesFpg(strCodFpg);

    intTemTri := IIF(Not fApenasSubstituicao, 1, 0);
    intTemSub := IIF(fVerificaSituacaoTributaria(Self), 1, 0);
    intInflam := IIF(fVerificaItemInflamavel(Self), 1, 0);
    strNomVe2 := fRetNomVendRep(strCodVe2);

    If Not blnGravandoVariosDocumentos Then
      intPrzMed := fCalculaPrazoMedioVenda;

    pCarregaResumoCfop(Self);
    pCarregaResumoCodFiscal(Self);

    pGeraMensagemAplicacao;

    pGeraStringCuponsDevolucao;
    pCalculaBaseIcmsRICMPR;
    pCalculaQtdCodFis;

    pAjustaCSTSimples;

    blnNotEsp := False;

    blnGravarCadRec := True;

    If (Not Assigned(qryConCit)) Then
      qryConCit := fCriarQuery('SELECT * FROM CADITE WHERE FALSE', Self);

    strEmpRec := '';

    strAutoEntTE := '';

    stlAutoConEnt.Clear;
    stlAutoTransfEmpCar.Clear;

    If fCaixaJaFoiFechado(strMSGTravaCaixa) Then
    Begin
      If fInTransaction Then
        fCancelaTransac;

      Result := False;

      fMensagem('', strMSGTravaCaixa, ['&OK']);
      Exit;
    End;

    If Assigned(pgbStatusGravacao) Then
      With pgbStatusGravacao.Properties Do
        Max := Max + Length(arrMatItens);


    pCalculaCadFis(arrLivFis, Self.strChaveAcesso);

    // Chave na NFEIMP: a trigger nao grava a REF, quem grava e o Delphi com os valores do documento
    FReformaGravadaPeloDelphi := Self.blnReformaDefinidaPeloDocumento And
                                 DocumentoDeImportacaoFulfillment(Self.strChaveAcesso);

    pCalculaQtdPecas;

    {*************************************************}
    {* DEVE SER CHAMADO ANTES DA TRANSACAO PRINCIPAL *}
    {*********************************************JC**}
    If blnCarregaSeqConRcx Then
      intSeqConRcx := StrToInt(fRetRcxCon(strEmpLog));

    {*************************************************}
    {* DEVE SER CHAMADO ANTES DA TRANSACAO PRINCIPAL *}
    {*********************************************JC**}
    If blnCarregarSeqMovCar Then
      fRetSequencialMovCar('MOVCAR', VS_strCodEmp, arrCartoes);

    If blnGravarDavPv And blnCliFil Then
    Begin
      blnGravarDavPv := False;
    End;

    FAuditFaturamento.Limpar;
    FAuditoriaSaldo.Limpar;
    FAuditoriaResumoCaixa.Limpar;

    If (blnComTansacao) Then
    Begin
      VS_strAllErrorsMessages := '';
      fStartTransaction;
    End;

    Try
      strEmpDoc := VS_strCodEmp;

      If (blnNovoSequencial) Then
      Begin

        If (strEspDoc = 'NF') Then
        Begin
          If (Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') And (Not blnConfirmacaoEspelho) Then
            strNumDoc := fRetSequencial('PROESP', VS_strCodEmp, 12)
          Else If blnEspelhoDevolucaoCliente Then
            strNumDoc := fRetSequencial('PROESP', VS_strCodEmp, 12)
          Else
            strNumDoc := fRetornaSeqNota;
        End;

        If (strEspDoc = 'NS') Then
          strNumDoc := fRetSequencial('PRO_NS', VS_strCodEmp, fTamDocCadRec);

        If (strEspDoc = 'EP') Then
          strNumDoc := fRetSequencial('PRO_EP', VS_strCodEmp, fTamDocCadRec);

      end;

      strHorSai := TimeToStr(fRetHoraServidor);

      pInfoStatusGravacao('Aguarde... Preparando para Gravação');
      pStepStatusGravacao;

      pDefineVariaveisSeGravaCaixa;

      {*****************************************}
      {* ATUALIZA OS DADOS DA MATRIZ PARA A    *}
      {* TEMPORARIA                            *}
      {**************************************MV*}
      pCarregaResumoCfop(Self);

      pInfoStatusGravacao('Aguarde... Retornando Sequencial ' + strEspDoc);
      pStepStatusGravacao;

      strNumDocPR := '';
      strEmpDocPR := '';

      pInfoStatusGravacao('Aguarde... Verificando Pedido/Orçamento');
      pStepStatusGravacao;

      strModificacoesItensPedido := '';
      strModificacoesItensPedidoHtml := '';

      If (fEmptyStr(strNumOrc)) And (FConEqu) Then
      Begin
        strSepImp := FSepImpPdOS;

        If strSepImp = '3' Then
          strSepImp := '2';
      End;

      If fCfgSis('OPCCOM') = 'T' Then
      Begin
        If fEmptyStr(strTabPre) Then
          strTabPre := '1';
      End;

      pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);
      pStepStatusGravacao;

      blnMsg000 := False;
      blnMsg060 := False;
      fltBasIcm060 := 0;
      fltValIcm060 := 0;
      blnMsg010 := False;
      fltBasIcm010 := 0;
      fltValIcm010 := 0;

      strResTotCfop := '';
      pCriaDataSetCfop;

      blnPrcNumCmp := fEmptyStr(strNumCmp);

      For intContador := 0 To Length(arrMatItens)-1 Do
      Begin
        If (Not fEmptyStr(arrMatItens[intContador].strNumOrc)) Then
        Begin
          strMsgAux:=arrMatItens[intContador].strNumOrc+'-'+
                     arrMatItens[intContador].strEspOrc+'-'+
                     arrMatItens[intContador].strEmpOrc;

          If (Pos(strMsgAux, strMsgNumPedOrc) <= 0) Then
          Begin
            strMsgNumPedOrc:=strMsgNumPedOrc+IIF(fEmptyStr(strMsgNumPedOrc),'',', ')+strMsgAux;
          End
        End;

        If (arrMatItens[intContador].strEntFut = 'S') Then
          If (Pos(arrMatItens[intContador].strMotFut, FstrMsgMotFutItens) <= 0) Then
            FstrMsgMotFutItens := FstrMsgMotFutItens + arrMatItens[intContador].strMotFut;

        If blnPrcNumCmp Then
        Begin
          If (Not fEmptyStr(arrMatItens[intContador].strNumCmp)) And
             (Not strNumCmp.Contains(arrMatItens[intContador].strNumCmp)) Then
          Begin
            If (fEmptyStr(strNumCmp)) Then
              strNumCmp := arrMatItens[intContador].strNumCmp
            Else
              strNumCmp := strNumCmp + ', ' + arrMatItens[intContador].strNumCmp;
          End;
        End;

        arrMatItens[intContador].stlDetMls := Nil;

        {**************************************************}
        {* VERIFICA SE EXISTE ALGUM ITEM COM CST 000, 060 *}
        {* SE HOUVER SETA AS VARIAVEIS PARA TRUE PARA     *}
        {* IMPRIMIR A MENSAGEM NA CNF_NFE                 *}
        {************************************************FC}
        If (arrMatItens[intContador].strCodFis = '000') Then
          blnMsg000 := True;

        If (arrMatItens[intContador].strCodFis = '060') Then
        Begin
          blnMsg060 := True;
          fltBasIcm060 := fltBasIcm060 + arrMatItens[intContador].fltBasIcm;
          fltValIcm060 := fltValIcm060 + arrMatItens[intContador].fltValIcm;
        End;

        If (arrMatItens[intContador].strCodFis = '010') Then
        Begin
          blnMsg010 := True;
          fltBasIcm010 := fltBasIcm010 + arrMatItens[intContador].fltBasIcm;
          fltValIcm010 := fltValIcm010 + arrMatItens[intContador].fltValIcm;
        End;

        {**************************************************}
        {* MONTA O RESUMO DA TOTALIZAÇÃO DO VALOR POR     *}
        {* CFOP SE CASO HOUVER MAIS DE UMA CFOP DIFERENTE *}
        {* NA NOTA PARA IMPRIMIR NO CNF_NFE               *}
        {***********************************************FC*}
        If cdsResTotCfop.Locate('CFOP', arrMatItens[intContador].strClaFis, []) Then
        Begin
          cdsResTotCfop.Edit;
          cdsResTotCfop.FieldByName('VALOR').AsFloat := cdsResTotCfop.FieldByName('VALOR').AsFloat +
                                                        (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp);
        End
        Else
        Begin
          cdsResTotCfop.Append;
          cdsResTotCfop.FieldByName('CFOP').AsString  := arrMatItens[intContador].strClaFis;
          cdsResTotCfop.FieldByName('VALOR').AsFloat := (arrMatItens[intContador].fltTotIte - arrMatItens[intContador].fltDesEsp);
        End;

        cdsResTotCfop.Post;
      End;

      cdsResTotCfop.First;
      While Not cdsResTotCfop.Eof Do
      Begin
        strResTotCfop := strResTotCfop + cdsResTotCfop.FieldByName('CFOP').AsString +
                         ' - R$' + FormatFloat('#,##0.00', cdsResTotCfop.FieldByName('VALOR').AsFloat) + fReplicatorStr(' ', 5);

        cdsResTotCfop.Next;
      End;

      FreeAndNil(cdsResTotCfop);

      {*****************************************}
      {* NF - Nota Fiscal                      *}
      {**************************************MV*}
      If Pos(strEspDoc, 'NF_EL_NS_') > 0 Then
      Begin

        If strEspDoc = 'NF' Then
          pCarregaConfImpr(qryCfgRel, strNomeForm + '_NOTA')
        Else
          pCarregaConfImpr(qryCfgRel, strNomeForm + '_NOTASERVICO');

        strNomImp := qryCfgRel.FieldByName('REL_NOMFIL').AsString;

        {*****************************************}
        {* SE NÃO FOR TESTE DE NOTA FISCAL       *}
        {**************************************MV*}
        If (Not blnLibCnf) Then
        Begin

          pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);
          pStepStatusGravacao;

          If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') and TFaturamentoMercadoLivre.NFeEmitidaPeloFaturador(Self.strChaveAcesso, Self.strFullNumPOK) Then
          Begin
            If Not TFaturamentoMercadoLivre.ValidarProdutosNFe(Self) Then
              Self.blnFullFilKar := True;

            If Not TFaturamentoMercadoLivre.ValidarClienteNFe(Self) Then
              Self.blnFullFilKar := True;

            If Not TFaturamentoMercadoLivre.ValidarTotalNFe(Self) Then
              Self.blnFullFilKar := True;

            If Self.blnFullFilKar Then
            Begin
              If (Not fGNotGer) Then
              Begin
                fCancelaTransac;
                Result := False;
                Raise Exception.Create('Documento já foi importado.');
              End;

              pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
              pStepStatusGravacao;

              If (Not fGNotDet) Then
              Begin
                fCancelaTransac;
                Result := False;
                Exit;
              End;
            End
            Else
            Begin
              If (Not fGMovGer) Then
              Begin
                fCancelaTransac;
                Result := False;
                Raise Exception.Create('Documento já foi importado.');
              End;

            pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
            pStepStatusGravacao;

            If (Not fGMovDet) Then
            Begin
              fCancelaTransac;
              Result := False;
                Exit;
              End;
            End;
          End
          Else
          Begin
            If (Not fGMovGer) Then
            Begin
              fCancelaTransac;
              Result := False;
              Raise Exception.Create('Documento já foi importado.');
            End;

            pInfoStatusGravacao('Aguarde... Gravando Produto(s)');
            pStepStatusGravacao;

            If (Not fGMovDet) Then
            Begin
              fCancelaTransac;
              Result := False;
              Exit;
            End;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Livro Fiscal');

          {*****************************************}
          {* GRAVAÇÃO DO LIVRO FISCAL              *}
          {**************************************MV*}
          Try

            If (Not fGCadFisRe(arrLivFis)) Then
            Begin
              fCancelaTransac;
              Exit(False);
            End;

          Except

            On E: Exception Do
            Begin
              Result := False;
              fCancelaTransac;
              Raise ExceptionImportacaoFulFillmentNaoGravouLivroFiscal.Create(E.Message);
            End;

          End;

          pStepStatusGravacao;

          If Self.Fulfillment.SiglaHubMarketPlace.Equals('MLB') and TFaturamentoMercadoLivre.NFeEmitidaPeloFaturador(Self.strChaveAcesso, Self.strFullNumPOK) Then
          Begin
            If Not TFaturamentoMercadoLivre.NFeAutorizadaFaturador(Self.strChaveAcesso) Then
              Raise Exception.Create('Status de autorização da NFe ainda não processado pelo Faturador "' +
                Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.AtualizarDadosNFe]');

            If Not TFaturamentoMercadoLivre.AtualizarDadosNFe(Self) Then
              Raise Exception.Create('Não foi possível atualizar os dados da NFe "' +
                Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.AtualizarDadosNFe]');

            If TFaturamentoMercadoLivre.ValidarTotalNFe(Self) Then
              If TFaturamentoMercadoLivre.ValidarClienteNFe(Self) Then
                If Not TFaturamentoMercadoLivre.AtualizarDocumentoFinanceiro(Self) Then
                  Raise Exception.Create('Não foi possível atualizar o financeiro da NFe "' +
                    Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.AtualizarDocumentoFinanceiro]');

            If Self.blnFullFilKar Then
            Begin
              If Not TFaturamentoMercadoLivre.FaturarDocumentoTransitorio(Self) Then
                Raise Exception.Create('Não foi possível faturar o documento transitório da NFe "' +
                  Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.FaturarDocumentoTransitorio]');
            End
            Else
            Begin
              If Not TFaturamentoMercadoLivre.ValidarProdutosNFe(Self) Then
                Raise Exception.Create('Não foi possível validar os produtos da NFe "' +
                  Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.ValidarProdutosNFe]');

              If Not TFaturamentoMercadoLivre.AlterarFaturamentoPedidoDeVenda(Self) Then
                Raise Exception.Create('Não foi possível alterar os dados de Faturamento do pedido - NFe "' +
                  Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.AlterarFaturamentoPedidoDeVenda]');

              If Not TFaturamentoMercadoLivre.DeletarDocumentoTransitorio(Self) Then
                Raise Exception.Create('Não foi possível excluir o documento transitório da NFe "' +
                  Self.strChaveAcesso + '" - [TFaturamentoMercadoLivre.DeletarDocumentoTransitorio]');
            End;

          End
          Else
          Begin
            {*****************************************}
            {* GRAVAÇÃO DO CONTAS A RECEBER / MOVBAN *}
            {**************************************MV*}
            If blnGravarCadRec And
               ((Pos(strClaFis, VS_strClaVen) > 0) Or (Pos(strClaFis, VS_strClaDev) > 0)) Then
            Begin
              pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

              {*****************************************}
              {* GRAVA CADREC                          *}
              {**************************************MV*}
              If (Not fGCadRec) Then
              Begin
                fCancelaTransac;
                Result := False;
                Raise Exception.Create('Documento já foi importado na CADREC');
                Exit;
              End;

              If (Not blnDevNota) And (fltTotGer > 0) Then
                If not fGravaFulfillCartoes(LMensagemDeRetorno) Then
                begin
                  fCancelaTransac;
                  Result := False;
                  Raise Exception.Create(LMensagemDeRetorno);
                end;

              For intContador := 1 To 4 Do
                pStepStatusGravacao;
            End;
          End;

          If strOpcDoc = 'TE' Then
          Begin
            blnSetouEmpOri := True;
            strCodEmpOri := VS_StrCodEmp;
            strCodForTe  := fGetFornecedorFilial(strCodEmpOri);

            pSetaEmpresaLogada(fCampoTabela('EMP_CODEMP', 'CADEMP', ['EMP_CLIFIL'], [strCodCli]));

            VS_ExibirMensagemAoUsuario := False;
            VS_ExibirMensagemDeErro    := False;
            VS_ExibirMensagemAguarde   := False;

            pGeraEntradaTransfEstoque(strNumDoc, strEspDoc, strCodEmpOri, strSerFsc, strCodForTe, False);
            pSetaEmpresaLogada(strCodEmpOri);
          End;
        End
        {*****************************************}
        {* CASO ESTEJA TESTANDO, NÃO CONFIRMA    *}
        {**************************************MV*}
        Else
        Begin

          fCancelaTransac;
          Result := False;

          strCliCgc := AnsiReplaceStr(strCliCgc,'.','');
          strCliCgc := AnsiReplaceStr(strCliCgc,'-','');
          strCliCgc := AnsiReplaceStr(strCliCgc,'/','');

          reiReimpressao := TReimpressao.Create(strNumDoc, strEspDoc, 0, 0, strCodCli, IIF(Not fOrcamentoOutraLojaF11, VS_strCodEmp, IIF(fEmptyStr(strEmpOri), VS_strCodEmp, IIF((strEspDoc <> strEspOrc),VS_strCodEmp, strEmpOri))),
                                                strCodVen,  True, IIF(fDocumentoParaFornecedor,'F','C'), False, True, False, '', '', False, 0, False, 'V');

          If strOpcDoc = 'NC' Then
          Begin
            reiReimpressao.fatVenda := Self;
            reiReimpressao.pImprimeNotaComp;
          End
          Else
            reiReimpressao.pReimprimeDocumento(True);

          FreeAndNil(reiReimpressao);
          Exit;
        End;

      End;

      If Self.GetEnviandoMercadoriaParaLoteEstoqueExterno And Not strNumOrc.IsEmpty Then
      Begin
        pInfoStatusGravacao('Aguarde... Baixando estoque dos lotes');

        For intContador := Low(arrMatItens) To High(arrMatItens) Do
        Begin
          With arrMatItens[intContador] Do
          If Not fEmptyStr(strNumOrc) And Not fAtualizaQtdBaiFatDor(strNumOrc, strEspOrc, strEmpOrc, strCodIte, intSeqInd,
            fltQtdIte, fltDesEsp, blnEntpCD, strIncFut) Then
          Begin
            Result := False;
            fCancelaTransac;
            Exit;
          End;
        End;

        If (Not fFaturaPedidosVenda(True)) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;

        If fUsaRotinaWMS And Not fBaixarLotesWMS(pgbStatus) Then
        Begin
          Result := False;
          fCancelaTransac;
          Exit;
        End;
      End;

      pStepStatusGravacao;

      Result := True;

      {*****************************************}
      {* GRAVA O LOG DE ALTERAÇÃO DE DESCRIÇÃO.*}
      {**************************************MV*}
      pInfoStatusGravacao('Aguarde... Gerando Log de Alteração de Descrição');
      pGLogDes;

      If (Pos(strOpcDoc,'OF_GF_') > 0) And (fCfgSis('OUSAFO', varString) = '2') And (not blnConfirmacaoEspelho) Then
        pInfoStatusGravacao('Aguarde... Finalizando Gravação do Documento ' + strNumDoc + '-ES')
      Else If blnEspelhoDevolucaoCliente Then
        pInfoStatusGravacao('Aguarde... Finalizando Gravação do Documento ' + strNumDoc + '-ES')
      Else
        pInfoStatusGravacao('Aguarde... Finalizando Gravação do Documento ' + strNumDoc + '-' + strEspDoc);

      pNFeInfAdicionaisFCP_AMPARA;

      pNFeInfAdicionaisAKZ(strNumDoc, strEspDoc, VS_strCodEmp);

      if fProcessaCNF_NFE then
      begin
        pNfeInfAdicionaisMOVMOD(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicDocumentosCreditoUsados( strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicDocumentosOriginaisBaixaEntFutura( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicChaveNFeReferenciada( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicNumPedidoCompraNFRemessa( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicListaVendedorNF(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicOcoHisComplementar( strNumDoc, strEspDoc, VS_strCodEmp);
        pNfeInfAdicPontosClubeFidelidade(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
        pNfeInfAdicRestanteAPagar( strNumDoc, strEspDoc, VS_strCodEmp, strCodCli);
      end;

      If (Result) Then
      begin
        if not FAuditFaturamento.fValidouTodas(strCodErrosAuditoria) then
        begin
          Result := False;
          fCancelaTransac;

          raise Exception.Create(fRetornaErrosAuditoria(strCodErrosAuditoria));
        end;

        if not FAuditoriaSaldo.fValidouTodas(strCodErrosAuditoria) then
        begin
          Result := False;
          fCancelaTransac;

          raise Exception.Create(fRetornaErrosAuditoria(strCodErrosAuditoria));
        end;

        If (Not FAuditoriaResumoCaixa.ValidouTodas(strCodErrosAuditoria)) Then
        Begin
          Result := False;
          fCancelaTransac;

          raise Exception.Create(fRetornaErrosAuditoria(strCodErrosAuditoria));
        End;
      end;

      If Not fGravouDocumentoComDifal Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;

      If Not fMarcaSeExisteGNRE(strNumDoc, strEspDoc, VS_strCodEmp, strCodCli) Then
      Begin
        fCancelaTransac;
        Result := False;
        Exit;
      End;

      Try
        If AGerarPedidoDeEnderecamento Then
          Result := fGerarPedidoReservaEstoqueParaEnderecamentoFulfillment;
      Except

        On E: Exception Do
        Begin
          Result := False;
          fCancelaTransac;
          Raise ExceptionImportacaoFulFillmentNaoGravouPedidoDeEnderecamento.Create(E.Message);
        End;

      End;

      Try
        If AGerarAjusteDeEstoque Then
          Result := fGerarAjusteDeEstoqueFulfillment;
      Except

        On E: Exception Do
        Begin
          Result := False;
          fCancelaTransac;
          Raise ExceptionImportacaoFulFillmentNaoGravouGeracaoAjusteDeEstoque.Create(E.Message);
        End;

      End;

      {COMITA}
      If (blnComTansacao) Then
        fCommit;

      If Result Then
        Self.blnGravouDocumentos := True;

      pAtualizarDadosUltimaCompra;

      strConPagGrav := strConPag;

      TTestabilidade.fGetTestabilidade.NumeroDocumento  := strNumDoc;
      TTestabilidade.fGetTestabilidade.EspecieDocumento := strEspDoc;
      TTestabilidade.fGetTestabilidade.EmpresaDocumento := VS_strCodEmp;
      TTestabilidade.fGetTestabilidade.ClienteDocumento := strCodCli;
      TTestabilidade.fGetTestabilidade.SerieDocumento   := strSerFsc;
      TTestabilidade.fGetTestabilidade.DocumentoOriginal:= strNumDoc;

      If strEspDoc = 'NF' Then
        TTestabilidade.fGetTestabilidade.RomaneioNF := strNumDoc
      Else If strEspDoc = 'FF' Then
        TTestabilidade.fGetTestabilidade.RomaneioFF := strNumDoc;

    Except

      On E: Exception Do
      Begin
        If (Not Self.blnGravouDocumentos) Then
          Result := False;
        fCancelaTransac;

        If blnSetouEmpOri Then
          pSetaEmpresaLogada(strCodEmpOri);

        Raise Exception.Create(E.Message);
      End;

    End;

  Finally
    Self.pgbStatusGravacao := Nil;
  End;
end;


procedure TFatVenda.pSimularCondicoesPagamentoPedido;
Var
  objAltCnd: TAlterarPedido;
  qryCadCnd: TUniQuery;

  oleItensBackup: OleVariant;
  strFilterBackup: String;
  blnFilterBackup: Boolean;
  intAutIncBackup: Integer;

  procedure pExecuteSimulacao(const strCodigoCondicaoPagamento: string; blnGravaSimulacao: Boolean);
  begin
    objAltCnd.pCarregaCondicao(strCodigoCondicaoPagamento);
    If objAltCnd.fCalculaTotalPedido Then
    Begin
      If blnGravaSimulacao Then
        pGravaSimulacaoCondPagtoPedido(strAutIncFatGor, objAltCnd.objVenda.strCodCnd, objAltCnd.objVenda.fltTotCadRec);
    End;
  end;

begin
  cdsVendaBackup := nil;
  strFilterBackup := '';
  blnFilterBackup := False;
  intAutIncBackup := 0;

  Try
    If fCfgSis('VLRCND', VarBoolean) And
       fCfgSis('USACND', VarBoolean) And (Pos(strEspDoc, 'PD_OR_') > 0) Then
    Begin
      If Assigned(Faturamento.Classes.TFatVendaBase.cdsVenda) Then
      Begin
        oleItensBackup  := Faturamento.Classes.TFatVendaBase.cdsVenda.Data;
        strFilterBackup := Faturamento.Classes.TFatVendaBase.cdsVenda.Filter;
        blnFilterBackup := Faturamento.Classes.TFatVendaBase.cdsVenda.Filtered;
        intAutIncBackup := Faturamento.Classes.TFatVendaBase.cdsVenda.FieldByName('AUTOINCREM').AsInteger;

        cdsVendaBackup := TUniClientDataSet.Create(nil);
        cdsVendaBackup.Data := Faturamento.Classes.TFatVendaBase.cdsVenda.Data;
      End;

      Try
        objAltCnd := TAlterarPedido.Create(Self);
        try
          objAltCnd.strNumPed := strNumDoc;
          objAltCnd.strEspPed := strEspDoc;
          objAltCnd.strEmpPed := strEmpDoc;
          If objAltCnd.fCarregarPedido() Then
          Begin
            objAltCnd.blnSimulandoVenda := True;
            objAltCnd.objVenda.blnTaxVpr := True;

            If (fCfgSis('CNDVEN') = 'I') Then
            Begin
              objAltCnd.blnRecalculaPrecos := objAltCnd.blnAtualizaTabPreCnd Or
                                              objAltCnd.blnRecalcularPrecosAoMudarCondicaoDePagamento;

              If objAltCnd.blnAtualizaTabPreCnd Then
                objAltCnd.blnAltTabelaPreco := True;
            End;

            qryCadCnd := fCriaQuery;
            Try
              qryCadCnd.Close;
              qryCadCnd.SQL.text := 'SELECT CND_CODIGO FROM CADCND WHERE CND_IMPFAT = "S"';
              qryCadCnd.Open;

              qryCadCnd.First;
              While Not qryCadCnd.Eof Do
              Begin
                pExecuteSimulacao(qryCadCnd.FieldByName('CND_CODIGO').AsString, True);
                qryCadCnd.Next;
              End;
            Finally
              FreeAndNil(qryCadCnd);
            End;
          End;
        finally
          FreeAndNil(objAltCnd);
        end;
      Finally
        if Assigned(cdsVendaBackup) then
        begin
          Faturamento.Classes.TFatVendaBase.cdsVenda := TUniClientDataSet.Create(Owner);

          Faturamento.Classes.TFatVendaBase.cdsVenda.Data       := oleItensBackup;
          Faturamento.Classes.TFatVendaBase.cdsVenda.LogChanges := False;
          Faturamento.Classes.TFatVendaBase.cdsVenda.Filter     := strFilterBackup;
          Faturamento.Classes.TFatVendaBase.cdsVenda.Filtered   := blnFilterBackup;

          pFormataDecimaisGrid(nil);

          Faturamento.Classes.TFatVendaBase.cdsVenda.Locate('AUTOINCREM', intAutIncBackup, []);

          if cdsVendaBackup.Active then
            cdsVendaBackup.Close;

          FreeAndNil(cdsVendaBackup);
        end;
      End;
    End;
  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '');
    End;
  End;
end;

function TFatVenda.fTemPraAtualizar(const strTabela, strSQLGer: String): Boolean;
  Var
    qryGen: TUniQuery;
Begin
  qryGen := fCriaQuery;
  Try
    With qryGen, SQL Do
    Begin
      Add('SELECT COUNT(*) AS QTDREG FROM ' + strTabela);
      Add(RightStr(strSQLGer, Length(strSQLGer) - Pos('WHERE',strSQLGer) + 1));
      Open;
      Result := FieldByName('QTDREG').AsInteger > 0;
      Close;
    End;
  Finally
    FreeAndNil(qryGen);
  End;
End;

function TFatVenda.fConfiguradoGerarPedidoOrcamentoOutraLoja: Boolean;
begin
  Result := ((fVerificaAcessoSistema('ALTORC') And (fCfgSis('ALTORC') = 'S')) Or ((fCfgSis('CRMCOP') = 'S') And FblnOrigemCRM));
end;

function TFatVenda.fConfirmacaoCFeCIComFator: Boolean;
begin
  Result := ((strOpcDoc = 'CF') Or (strOpcDoc = 'CI')) And
            ((blnMeiaNota) And (fltFatNot > 0));
end;

function TFatVenda.fRetDuplicatasDevolucaoSintetizadasConfDocs: String;
  Var
    strDocCtr: String;
    qryGen: TUniQuery;
    stlDocDev: TStringList;

    procedure pDesagrupaDevolu;
      Var
        intPos: Integer;
        intPosAnt: Integer;
    begin
      intPosAnt := 0;

      intPos := PosEx('/', qryGen.FieldByName('TMP_DEVOLU').AsString, intPosAnt+1);
      While intPos > 0 Do
      Begin
        stlDocDev.Add(QuotedStr(Copy(qryGen.FieldByName('TMP_DEVOLU').AsString, intPosAnt, 20)));
        intPosAnt := intPos+1;
        intPos := PosEx('/', qryGen.FieldByName('TMP_DEVOLU').AsString, intPosAnt+1);
      End;
    end;

begin
  Result := '';

  If (strOpcDoc = 'CF') And fCfgSis('SINCNF', varBoolean) Then
  Begin
    qryGen := fCriaQuery;
    stlDocDev := TStringList.Create;
    stlDocDev.Sorted := True;
    stlDocDev.Duplicates := dupIgnore;

    Try
      With qryGen Do
      Begin
        Close;
        SQL.Text := 'SELECT * FROM '+strTabelaConfMi;
        Open;
      End;

      qryGen.First;
      While (Not qryGen.Eof) Do
      Begin
        If (Not fEmptyStr(qryGen.FieldByName('TMP_DEVOLU').AsString)) Then
          pDesagrupaDevolu;

        qryGen.Next;
      End;

      If stlDocDev.Count > 0 Then
      Begin
        With qryGen Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add('SELECT  ');
          SQL.Add('  DET_NUMDOC, ');
          SQL.Add('  DET_ESPDOC, ');
          SQL.Add('  DET_CODEMP  ');
          SQL.Add('FROM  ');
          SQL.Add('  MOVDET  ');
          SQL.Add('WHERE ');
          SQL.Add('  AUTOINCREM IN (' + stlDocDev.CommaText + ') ');
          Open;

          strDocCtr := '';
          strDocCtr := strDocCtr + 'SELECT AUTOINCREM FROM ';
          strDocCtr := strDocCtr + '  CADREC ';
          strDocCtr := strDocCtr + 'WHERE  ';
          strDocCtr := strDocCtr + ' (  ';

          First;
          While Not Eof Do
          Begin
            strDocCtr := strDocCtr + ' ( CTR_NUMDUP = "' + FieldByName('DET_NUMDOC').AsString + '" AND ';
            strDocCtr := strDocCtr + '   CTR_ESPDOC = "' + FieldByName('DET_ESPDOC').AsString + '" AND ';
            strDocCtr := strDocCtr + '   CTR_CODEMP = "' + FieldByName('DET_CODEMP').AsString + '" AND ';
            strDocCtr := strDocCtr + '   CTR_CODCLI = "' + strCliFiltro + '" ) ';

            If RecNo < RecordCount Then
              strDocCtr := strDocCtr + ' OR ';

            Next;
          End;

          Close;
          SQL.Clear;
          SQL.Add(strDocCtr + ') AND (CTR_DTAREC IS NULL) ');
          Open;

          First;
          While Not Eof Do
          Begin
            pIncrementaListaStr(FieldByName('AUTOINCREM').AsString, Result, True);

            Next;
          End;
        End;
      End;
    Finally
      FreeAndNil(qryGen);
      FreeAndNil(stlDocDev);
    End;
  End;
end;

{********************************************************}
{* CASO A OPÇÃO SEJA 'CF' -> CONFIRMAÇÃO DE DOCUMENTOS: *}
{* -> TUDO SE REFERE  A CAIXA 2                         *}
{* CASO A OPÇÃO SEJA 'CT' -> CONFIRMAÇÃO DE TRANSF. EST.*}
{* -> TUDO SE REFERE  A CAIXA 2                         *}
{* CASO SEJA 'CI' -> CONFIRMAÇÃO DE CUPOM FISCAL        *}
{* -> TUDO SE REFERE A CAIXA 1                          *}
{*****************************************************MV*}
function TFatVenda.fFaturarDocumentos(strOpcDoc: String): Boolean;
  Var
    strSQL      : String;
    strSQLGer   : String;
    strSQLDet   : String;
    strDelCtr   : String;
    strDelCtrFil: String;
    strAutIncGer: String;

    qryGenTmp: TUniQuery;

    strTblCtrCnf: String;
    strTblMovGer: String;
    strTblMovDet: String;
    strTblNotGer: String;
    strTblNotDet: String;

    stlDevolu: TStringList;
    stlDDevol: TStringList;

    blnPorAutInc: Boolean;
    blnAtuMovGer: Boolean;
    blnAtuNotGer: Boolean;
    blnFilJafatu: Boolean;

    intContador: Integer;
    intQtdAberto: Integer;
    blnPrimeira: Boolean;

    dicDocsConfirmados: TDicionario;

    procedure pAddDocConfirmado(strNumDoc, strEspDoc, strCodEmp, strCodCli: String);
      Var
        strChave: String;
        documento: TDocumentoConf;
    begin
      strChave := Concat(strNumDoc, strEspDoc, strCodEmp, strCodCli);

      If dicDocsConfirmados.RetornaObjeto(strChave) = nil Then
      Begin
        documento := TDocumentoConf.Create;

        documento.strNumDoc := strNumDoc;
        documento.strEspDoc := strEspDoc;
        documento.strCodEmp := strCodEmp;
        documento.strCodCli := strCodCli;

        dicDocsConfirmados.AdicionarObjeto(strChave, documento);
      End;
    end;

    procedure pDesagrupaDevolu;
      Var
        intPos: Integer;
        intPosAnt: Integer;
    begin

      intPosAnt := 0;

      intPos := PosEx('/', qryGenTmp.FieldByName('TMP_DEVOLU').AsString, intPosAnt+1);
      While intPos > 0 Do
      Begin
        stlDevolu.Add(QuotedStr(Copy(qryGenTmp.FieldByName('TMP_DEVOLU').AsString, intPosAnt, 20)));
        intPosAnt := intPos+1;
        intPos := PosEx('/', qryGenTmp.FieldByName('TMP_DEVOLU').AsString, intPosAnt+1);
      End;

      intPosAnt := 0;

      intPos := PosEx('/', qryGenTmp.FieldByName('TMP_DDEVOL').AsString, intPosAnt+1);
      While intPos > 0 Do
      Begin
        stlDDevol.Add(Copy(qryGenTmp.FieldByName('TMP_DDEVOL').AsString, intPosAnt, IfThen(fTamDocCadRec = 6, 13, 19)));
        intPosAnt := intPos+1;
        intPos := PosEx('/', qryGenTmp.FieldByName('TMP_DDEVOL').AsString, intPosAnt+1);
      End;

    end;

    procedure pMarcarComoFaturado(intAutInc: Integer);
      Var
        qryUpd: TUniQuery;
    Begin
      qryUpd := fCriaQuery;
      Try
        qryUpd.Close;
        qryUpd.SQL.Text := 'UPDATE ' + strTabelaConfMi +
                           '   SET TMP_REGFAT = "S" '+
                           ' WHERE AUTOINCREM = :AUTINC';
        qryUpd.ParamByName('AUTINC').AsInteger := intAutInc;
        qryUpd.ExecSQL;
      Finally
        FreeAndNil(qryUpd)
      End;
    end;

    function fItensDocumento: String;
      Var
        intCont: Integer;
    begin
      Result := '';
      For intCont := Low(arrMatItens) To High(arrMatItens) Do
      Begin
        Result := Result + QuotedStr(arrMatItens[intCont].strSeqDet);
        If (intCont < High(arrMatItens)) Then
          Result := Result + ', ';
      End;
    end;


begin
  {******************************************************************************}
  {* Quando utilizar o fator na meia (nota/cupom) não deve faturar o documento! *}
  {* Req: 72902                                                                 *}
  {***************************************************************************RN*}
  If fConfirmacaoCFeCIComFator Then
  Begin
    Result := True;
    Exit;
  End;

  qryGenTmp := fCriaQuery;
  stlDevolu := TStringList.Create;
  stlDDevol := TStringList.Create;
  stlDDevol.Sorted := True;
  stlDDevol.Duplicates := dupIgnore;

  dicDocsConfirmados := TDicionario.Create;

  blnPrimeira := True;

  Result := True;

  strTblCtrCnf := 'CTRCNF';
  strTblMovGer := 'MOVGER';
  strTblMovDet := 'MOVDET';
  strTblNotGer := 'NOTGER';
  strTblNotDet := 'NOTDET';

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   *    ';
  strSQL := strSQL + ' FROM   ';
  strSQL := strSQL + strTabelaConfMi;
  strSQL := strSQL + ' LIMIT 1 ';

  qryGenTmp.Close;
  qryGenTmp.SQL.Text := strSQL;
  qryGenTmp.Open;

  blnPorAutInc := False;
  strAutIncGer := '';

  If Assigned(qryGenTmp.FindField('TMP_AUTINC')) Then
    blnPorAutInc := (fDesmembrarPorCFG_ITEDOC) And (Length(qryGenTmp.FieldByName('TMP_AUTINC').AsString) = 20);

  If blnPorAutInc And FFoiGravacaoPorDesmembramento Then
  Begin
    {************************************************************************}
    {* ATENÇÃO AO USAR ESSE MÉTODO DE EXCLUSÃO ATENTAR-SE PARA QUE A ROTINA *}
    {* QUE O CHAMOU "NÃO AGRUPE" DOCUMENTOS NA MATRIZ DE ITENS E            *}
    {* EVENTUALMENTE SE PERCA O strSeqGer QUE É O AUTOINCREMENTO DA         *}
    {* MOVGER/NOTEGER E ELE NÃO SEJA FATURADO EX.                           *}
    {* ORIGINAIS                                                            *}
    {* 000000000001-FF ITEM 00001 QTD 2                                     *}
    {* 000000000002-FF ITEM 00001 QTD 2                                     *}
    {* NA MATRIZ                                                            *}
    {*                 ITEM 00001 QTD 4                                     *}
    {* NESSE CASO TEREMOS 1 SÓ AUTOINCREM NA strSeqGer CASO A CONFIRMAÇÃO   *}
    {* TENHA SIDO QUEBRADA EM DOIS POR TER ATIGINDO A CFG_ITEDOC E AE UM DOS*}
    {* DOCUMENTOS NÃO SERÁ MARCADOS!                                        *}
    {*********************************L************************************VA*}
    For intContador := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If (Not fEmptyStr(arrMatItens[intContador].strSeqGer)) Then
      Begin
        pIncrementaListaStr(arrMatItens[intContador].strSeqGer, strAutIncGer, True, True, ',', False, False);

        If Not FAuditaGravacaoConfirmacao Then
          FAuditaGravacaoConfirmacao := True;
      End;
    End;
  End;

  qryGenTmp.Close;

  If (Not blnNotEsp) And (Not blnCupEsp) And (strOpcDoc <> 'CN') Then
  Begin

    If (fGerarCTR_CI) And (Not fGravaCtrCnf(strOpcDoc, strAutIncGer)) Then
    Begin
      Result := False;
      Exit;
    End;

    For intContador := 0 To Length(arrDesCffGer)-1 Do
    Begin
      If Not fEmptyStr(arrDesCffGer[intContador].strNumDoc) Then
      Begin
        qryGenTmp.Close;
        qryGenTmp.SQL.Clear;
        qryGenTmp.SQL.Add('UPDATE ' + strTblMovGer + ' SET GER_DESCFF = :DESCFF WHERE GER_NUMDOC = :NUMDOC AND GER_ESPDOC = :ESPDOC AND GER_CODEMP = :CODEMP AND GER_TIP_FC = "C"');
        qryGenTmp.ParamByName('DESCFF').AsFloat  := arrDesCffGer[intContador].fltValCff;
        qryGenTmp.ParamByName('NUMDOC').AsString := arrDesCffGer[intContador].strNumDoc;
        qryGenTmp.ParamByName('ESPDOC').AsString := arrDesCffGer[intContador].strEspDoc;
        qryGenTmp.ParamByName('CODEMP').AsString := arrDesCffGer[intContador].strCodEmp;
        qryGenTmp.ExecSQL;
        qryGenTmp.Close;
      End;
    End;

  End
  Else
    SetLength(arrDesCffGer,0);

  strSQL := '';
  strSQL := strSQL + ' SELECT ';
  strSQL := strSQL + '   *    ';
  strSQL := strSQL + ' FROM   ';
  strSQL := strSQL + strTabelaConfMi;
  If (strAutIncGer<>'') Then
    strSQL := strSQL + ' WHERE TMP_AUTINC IN ('+strAutIncGer+') ';

  qryGenTmp.Close;
  qryGenTmp.SQL.Text := strSQL;
  qryGenTmp.Open;

  strDelCtr := '';
  strDelCtr := strDelCtr + 'SELECT * FROM ';
  strDelCtr := strDelCtr + '  CADREC ';
  strDelCtr := strDelCtr + 'WHERE  ';
  strDelCtr := strDelCtr + ' (  ';

  strSQLGer := '';
  strSQLGer := strSQLGer + 'UPDATE ';
  strSQLGer := strSQLGer + '  ' + strTblMovGer + ' ';
  strSQLGer := strSQLGer + 'SET ';
  strSQLGer := strSQLGer + '  GER_JAFATU = 1, ';
  strSQLGer := strSQLGer + '  GER_TIPFAT = :TIPFAT, ';
  strSQLGer := strSQLGer + '  GER_NUMFAT = :NUMFAT, ';
  strSQLGer := strSQLGer + '  GER_EMPFAT = :EMPFAT, ';
  strSQLGer := strSQLGer + '  GER_DTAFAT = ' + fCurrentDate(Self.VS_Date) + ', ';
  strSQLGer := strSQLGer + '  GER_VENFAT = :VENFAT, ';
  strSQLGer := strSQLGer + '  GER_CNDFAT = :CNDFAT, ';
  strSQLGer := strSQLGer + '  GER_VALFAT = :VALFAT, ';
  strSQLGer := strSQLGer + '  GER_CLIFAT = :CLIFAT ';
  strSQLGer := strSQLGer + 'WHERE ';

  strSQLDet := '';
  strSQLDet := strSQLDet + 'UPDATE ';
  strSQLDet := strSQLDet + '  ' + strTblMovDet + ' ';
  strSQLDet := strSQLDet + 'SET ';
  strSQLDet := strSQLDet + '  DET_JAFATU = 1, ';
  strSQLDet := strSQLDet + '  DET_TIPFAT = :TIPFAT, ';
  strSQLDet := strSQLDet + '  DET_NUMFAT = :NUMFAT, ';
  strSQLDet := strSQLDet + '  DET_EMPFAT = :EMPFAT, ';
  strSQLDet := strSQLDet + '  DET_DTAFAT = ' + fCurrentDate(Self.VS_Date) + ', ';
  strSQLDet := strSQLDet + '  DET_VENFAT = :VENFAT, ';
  strSQLDet := strSQLDet + '  DET_CNDFAT = :CNDFAT, ';
  strSQLDet := strSQLDet + '  DET_VALFAT = :VALFAT, ';
  strSQLDet := strSQLDet + '  DET_CLIFAT = :CLIFAT ';
  strSQLDet := strSQLDet + 'WHERE ';

  With qryGenTmp Do
  Begin

    strDelCtrFil := EmptyStr;
    strAutIncGer := EmptyStr;

    blnAtuMovGer := False;
    blnAtuNotGer := False;
    blnFilJafatu := False;

    While (Not Eof) Do
    Begin
      If (fGerarCTR_CI) And
         (Not fEmptyStr(qryGenTmp.FieldByName('TMP_DEVOLU').AsString)) Then
      Begin
        pDesagrupaDevolu;
      End;

      If ((fCfgSis('SINCNF', varString) = 'S') And (Pos(qryGenTmp.FieldByName('TMP_ESPDOC').AsString, 'DV_PR_CR_') <= 0))                                            Or
         ((fCfgSis('SINCNF', varString) = 'S') And (Pos(qryGenTmp.FieldByName('TMP_ESPDOC').AsString,'DV_CR_') > 0) And (qryGenTmp.FieldByName('TMP_VLRCON').AsFloat <> 0)) Or
         (fCfgSis('SINCNF', varString) = 'N')                                                                                                                   Then
      Begin

        If blnPorAutInc Then
        Begin
          pIncrementaListaStr(qryGenTmp.FieldByName('TMP_AUTINC').AsString, strAutIncGer, True, True, ',', False);
          If (Not blnAtuMovGer) And ((qryGenTmp.FieldByName('TMP_NOMTAB').AsString = 'MOVGER') Or (Pos(qryGenTmp.FieldByName('TMP_NOMTAB').AsString, 'MOVGER_NOTGER_') = 0)) Then
            blnAtuMovGer := True;

          If (Not blnAtuNotGer) And ((qryGenTmp.FieldByName('TMP_NOMTAB').AsString = 'NOTGER') Or (Pos(qryGenTmp.FieldByName('TMP_NOMTAB').AsString, 'MOVGER_NOTGER_') = 0)) Then
            blnAtuNotGer := True;

          pMarcarComoFaturado(qryGenTmp.FieldByName('AUTOINCREM').AsInteger);
        End
        Else
        Begin
          If (Not blnPrimeira) Then
          Begin
            strSQLGer := strSQLGer + '  OR ';
            strSQLDet := strSQLDet + '  OR ';
          End;
          blnPrimeira := False;

          strSQLGer := strSQLGer + ' ( GER_NUMDOC = "' + FieldByName('TMP_NUMDOC').AsString + '" AND ';
          strSQLGer := strSQLGer + '   GER_ESPDOC = "' + FieldByName('TMP_ESPDOC').AsString + '" AND ';
          strSQLGer := strSQLGer + '   GER_CODEMP = "' + FieldByName('TMP_CODEMP').AsString + '" AND ';
          strSQLGer := strSQLGer + '   GER_CODCLI = "' + strCliFiltro + '" ) ';

          strSQLDet := strSQLDet + ' ( DET_NUMDOC = "' + FieldByName('TMP_NUMDOC').AsString + '" AND ';
          strSQLDet := strSQLDet + '   DET_ESPDOC = "' + FieldByName('TMP_ESPDOC').AsString + '" AND ';
          strSQLDet := strSQLDet + '   DET_CODEMP = "' + FieldByName('TMP_CODEMP').AsString + '" AND ';
          strSQLDet := strSQLDet + '   DET_CODCLI = "' + strCliFiltro + '" AND ';

          If (blnFormularioAvulso) Then
            strSQLDet := strSQLDet + ' AUTOINCREM IN ( ' + fItensDocumento + ' ) AND ';

          strSQLDet := strSQLDet + '   DET_JAFATU = 0 ) ';
        End;

        pAddDocConfirmado(FieldByName('TMP_NUMDOC').AsString,
                          FieldByName('TMP_ESPDOC').AsString,
                          FieldByName('TMP_CODEMP').AsString,
                          strCliFiltro);

      End;

      If (SameText(qryGenTmp.FieldByName('TMP_GCTRCI').AsString, 'T')) Then
      Begin
        If Not fEmptyStr(strDelCtrFil) Then
          strDelCtrFil := strDelCtrFil + '  OR ';

        strDelCtrFil := strDelCtrFil + ' ( CTR_NUMDUP = "' + FieldByName('TMP_NUMDOC').AsString + '" AND ';
        strDelCtrFil := strDelCtrFil + '   CTR_ESPDOC = "' + FieldByName('TMP_ESPDOC').AsString + '" AND ';
        strDelCtrFil := strDelCtrFil + '   CTR_CODEMP = "' + FieldByName('TMP_CODEMP').AsString + '" AND ';

        strDelCtrFil := strDelCtrFil + '   CTR_CODCLI = "' + strCliFiltro + '" ) ';
      End;

      Next;
    End;

  End;

  If blnPorAutInc Then
  Begin
    If (Not blnAtuMovGer) And (Not blnAtuNotGer) Then
    Begin
      qryGenTmp.Close;
      qryGenTmp.SQL.Text := 'SELECT COUNT(*) FROM MOVGER WHERE AUTOINCREM IN ('+strAutIncGer+')';
      qryGenTmp.Open;
      blnAtuMovGer := qryGenTmp.Fields[0].AsInteger > 0;
    End;

    If blnAtuMovGer Then
    Begin
      If (Not blnFilJafatu) Then
      Begin
        qryGenTmp.Close;
        If (blnFormularioAvulso) Then
          qryGenTmp.SQL.Text := 'SELECT IFNULL(DET_JAFATU, 0) FROM MOVDET WHERE DET_SEQGER IN (('+strAutIncGer+') OR AUTOINCREM IN ('+fItensDocumento+')) '
        Else
          qryGenTmp.SQL.Text := 'SELECT IFNULL(DET_JAFATU, 0) FROM MOVDET WHERE DET_SEQGER IN ('+strAutIncGer+')';
        qryGenTmp.Open;

        qryGenTmp.First;
        while Not qryGenTmp.Eof Do
        Begin
          If (qryGenTmp.Fields[0].AsInteger = 1) Then
          Begin
            blnFilJafatu := True;
            Break;
          End;

          qryGenTmp.Next;
        End;
      End;
    End;

    If (Not blnAtuMovGer) And (Not blnAtuNotGer) Then
    Begin
      qryGenTmp.Close;
      qryGenTmp.SQL.Text := 'SELECT COUNT(*) FROM NOTGER WHERE AUTOINCREM IN ('+strAutIncGer+')';
      qryGenTmp.Open;
      blnAtuNotGer := qryGenTmp.Fields[0].AsInteger > 0;
    End;

    If blnAtuNotGer Then
    Begin
      If (Not blnFilJafatu) Then
      Begin
        qryGenTmp.Close;
        If (blnFormularioAvulso) Then
          qryGenTmp.SQL.Text := 'SELECT IFNULL(DET_JAFATU, 0) FROM NOTDET WHERE DET_SEQGER IN (('+strAutIncGer+') OR AUTOINCREM IN ('+fItensDocumento+')) '
        Else
          qryGenTmp.SQL.Text := 'SELECT IFNULL(DET_JAFATU, 0) FROM NOTDET WHERE DET_SEQGER IN ('+strAutIncGer+')';
        qryGenTmp.Open;

        qryGenTmp.First;
        while Not qryGenTmp.Eof Do
        Begin
          If (qryGenTmp.Fields[0].AsInteger = 1) Then
          Begin
            blnFilJafatu := True;
            Break;
          End;

          qryGenTmp.Next;
        End;
      End;
    End;

    //MONTA CONDIÇÃO MOVGER/NOTGER...
    strSQLGer := strSQLGer + ' AUTOINCREM IN ('+strAutIncGer+') ';

    If (blnAtuMovGer And blnAtuNotGer) Then //SE EXISTE O MESMO AUTOINCREM NAS DUAS AUMENTA O FILTRO
      strSQLGer := strSQLGer + ' AND GER_CODCLI = "'+strCliFiltro+'" ';
    //...MONTA CONDIÇÃO MOVGER/NOTGER

    //...//

    //MONTA CONDIÇÃO MOVDET/NOTDET...
    If (blnFormularioAvulso) Then
      strSQLDet := strSQLDet + ' DET_SEQGER IN (('+strAutIncGer+') OR AUTOINCREM IN ('+fItensDocumento+')) '
    Else
      strSQLDet := strSQLDet + ' DET_SEQGER IN ('+strAutIncGer+') ';

    If (blnAtuMovGer And blnAtuNotGer) Then //SE EXISTE O MESMO AUTOINCREM NAS DUAS AUMENTA O FILTRO
      strSQLDet := strSQLDet + ' AND DET_CODCLI = "'+strCliFiltro+'" AND ';

    If blnFilJafatu Then
      strSQLDet := strSQLDet + ' AND DET_JAFATU = 0 ';
    //...MONTA CONDIÇÃO MOVDET/NOTDET
  End;

  strDelCtr := strDelCtr + strDelCtrFil + ' ) AND ((CTR_DTAREC IS NULL) '+IIF(fConfirmacaoComFFComBol,' AND NOT '+fRetSQLCadRecFFComBol,'')+') ';

  Try

    {*****************************************}
    {* ATUALIZA MOVGER                      *}
    {**************************************MV*}
    If (Not blnAtuMovGer) Then
      blnAtuMovGer := fTemPraAtualizar(strTblMovGer,strSQLGer);

    If blnAtuMovGer Then
    Begin
      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQLGer);
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('EMPFAT').AsString := VS_strCodEmp;
        ParamByName('VENFAT').AsString := strCodVen;
        ParamByName('CNDFAT').AsString := strConPag;
        ParamByName('VALFAT').AsFloat  := fltTotGer;
        If blnRegimeEspecialPorEmpresaComFaturamentoDuplo And fDocumentoParaFornecedor Then
          ParamByName('CLIFAT').Clear
        Else
          ParamByName('CLIFAT').AsString := strCodCli;

        ExecSQL;
        Close;
      End;

      {*****************************************}
      {* ATUALIZA MOVDET                       *}
      {**************************************MV*}
      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQLDet);
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('EMPFAT').AsString := VS_strCodEmp;
        ParamByName('VENFAT').AsString := strCodVen;
        ParamByName('CNDFAT').AsString := strConPag;
        ParamByName('VALFAT').AsFloat  := fltTotGer;
        If blnRegimeEspecialPorEmpresaComFaturamentoDuplo And fDocumentoParaFornecedor Then
          ParamByName('CLIFAT').Clear
        Else
          ParamByName('CLIFAT').AsString := strCodCli;

        ExecSQL;
        Close;
      End;
    End;

    {*****************************************}
    {* ATUALIZA NOTGER                       *}
    {**************************************MV*}
    strSQLGer := AnsiReplaceStr(strSQLGer, strTblMovGer, strTblNotGer);
    If (Not blnAtuNotGer) Then
      blnAtuNotGer := fTemPraAtualizar(strTblNotGer,strSQLGer);

    If blnAtuNotGer Then
    Begin
      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQLGer);
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('EMPFAT').AsString := VS_strCodEmp;
        ParamByName('VENFAT').AsString := strCodVen;
        ParamByName('CNDFAT').AsString := strConPag;
        ParamByName('VALFAT').AsFloat  := fltTotGer;
        ParamByName('CLIFAT').AsString := strCodCli;

        ExecSQL;
        Close;
      End;

      {*****************************************}
      {* ATUALIZA NOTDET                       *}
      {**************************************MV*}
      strSQLDet := AnsiReplaceStr(strSQLDet, strTblMovDet, strTblNotDet);
      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQLDet);
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('EMPFAT').AsString := VS_strCodEmp;
        ParamByName('VENFAT').AsString := strCodVen;
        ParamByName('CNDFAT').AsString := strConPag;
        ParamByName('VALFAT').AsFloat  := fltTotGer;
        ParamByName('CLIFAT').AsString := strCodCli;

        ExecSQL;
        Close;
      End;
    End;

    {****************************************}
    {* APAGA CADREC                         *}
    {*************************************MV*}
    If (fGerarCTR_CI) And (IIF(strOpcDoc = 'CI', Self.fConfirmacaoCupomGerandoNovoCadRec, True)) And
       (Not blnCupEsp) And (Not blnNotEsp) And (strOpcDoc <> 'CN') And
       (Not ((strOpcDoc = 'CF') And (blnMeiaNota))) Then
    Begin
      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strDelCtr);
        Open;

        While Not Eof Do
        Begin
          If Not fApagaDuplicataContasReceber(qryGenTmp, 'untFuncfat - ' + strOpcDoc) Then
          Begin
            Result := False;
            Exit;
          End;

          If VS_strHabilitarCRM And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
          Begin
            TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(FieldByName('CTR_NUMDUP').AsString,
                                                     FieldByName('CTR_ESPDOC').AsString,
                                                     FieldByName('CTR_CODEMP').AsString,
                                                     FieldByName('CTR_CODCLI').AsString,
                                                     FieldByName('CTR_PARCEL').AsString,
                                                     FieldByName('CTR_CODVEN').AsString,
                                                     fRetCgcCpf(FieldByName('CTR_CODCLI').AsString),
                                                     afcExcluiDuplicata, True);
          End;

          Next;
        End;

        Close;
      End;
    End;

    {*****************************************}
    {* FATURA AS DEVOLUÇÕES                  *}
    {**************************************MV*}
    If stlDevolu.Count > 0 Then
    Begin
      strSQLDet := '';
      strSQLDet := strSQLDet + 'UPDATE ';
      strSQLDet := strSQLDet + '  ' + strTblMovDet + ' ';
      strSQLDet := strSQLDet + 'SET ';
      strSQLDet := strSQLDet + '  DET_JAFATU = 1, ';
      strSQLDet := strSQLDet + '  DET_TIPFAT = :TIPFAT, ';
      strSQLDet := strSQLDet + '  DET_NUMFAT = :NUMFAT, ';
      strSQLDet := strSQLDet + '  DET_EMPFAT = :EMPFAT, ';
      strSQLDet := strSQLDet + '  DET_DTAFAT = ' + fCurrentDate(Self.VS_Date) + ', ';
      strSQLDet := strSQLDet + '  DET_VENFAT = :VENFAT, ';
      strSQLDet := strSQLDet + '  DET_CNDFAT = :CNDFAT, ';
      strSQLDet := strSQLDet + '  DET_VALFAT = :VALFAT, ';
      strSQLDet := strSQLDet + '  DET_CLIFAT = :CLIFAT ';
      strSQLDet := strSQLDet + 'WHERE ';
      strSQLDet := strSQLDet + '  AUTOINCREM IN (' + stlDevolu.CommaText + ') ';

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQLDet);
        ParamByName('TIPFAT').AsString := strEspDoc;
        ParamByName('NUMFAT').AsString := strNumDoc;
        ParamByName('EMPFAT').AsString := VS_strCodEmp;
        ParamByName('VENFAT').AsString := strCodVen;
        ParamByName('CNDFAT').AsString := strConPag;
        ParamByName('VALFAT').AsFloat  := fltTotGer;
        ParamByName('CLIFAT').AsString := strCodCli;
        ExecSQL;
        Close;
      End;

      If ((Not blnNotEsp) And (Not blnCupEsp) And (strOpcDoc <> 'CN')) And
         (Not ((strOpcDoc = 'CF') And (blnMeiaNota))) Then
      Begin
        {****************************************}
        {* APAGA CADREC  DAS DEVOLUCOES         *}
        {*************************************JB*}
        With qryGenTmp Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add('SELECT  ');
          SQL.Add('  DET_NUMDOC,  ');
          SQL.Add('  DET_ESPDOC,  ');
          SQL.Add('  DET_CODEMP   ');
          SQL.Add('FROM  ');
          SQL.Add('  ' + strTblMovDet + '  ');
          SQL.Add('WHERE ');
          SQL.Add('  AUTOINCREM IN (' + stlDevolu.CommaText + ') ');
          Open;

          strDelCtr := '';
          strDelCtr := strDelCtr + 'SELECT SQL_NO_CACHE * FROM ';
          strDelCtr := strDelCtr + '  CADREC ';
          strDelCtr := strDelCtr + 'WHERE  ';
          strDelCtr := strDelCtr + ' (  ';

          While Not Eof Do
          Begin
            strDelCtr := strDelCtr + ' ( CTR_NUMDUP = "' + FieldByName('DET_NUMDOC').AsString + '" AND ';
            strDelCtr := strDelCtr + '   CTR_ESPDOC = "' + FieldByName('DET_ESPDOC').AsString + '" AND ';
            strDelCtr := strDelCtr + '   CTR_CODEMP = "' + FieldByName('DET_CODEMP').AsString + '" AND ';
            strDelCtr := strDelCtr + '   CTR_CODCLI = "' + strCliFiltro + '" ) ';

            If RecNo < RecordCount Then
              strDelCtr := strDelCtr + '  OR ';

            Next;

            pAddDocConfirmado(FieldByName('DET_NUMDOC').AsString,
                              FieldByName('DET_ESPDOC').AsString,
                              FieldByName('DET_CODEMP').AsString,
                              strCliFiltro);

          End;

          Close;
          SQL.Clear;
          SQL.Add(strDelCtr + ') AND ((CTR_DTAREC IS NULL) '+IIF(fConfirmacaoComFFComBol,' AND NOT '+fRetSQLCadRecFFComBol,'')+') ');
          Open;

          While Not Eof Do
          Begin
            If Not fApagaDuplicataContasReceber(qryGenTmp, 'untFuncfat - ' + strOpcDoc) Then
            Begin
              Result := False;
              Exit;
            End;

            Next;
          End;

          Close;

        End;
      End;

      strSQLDet := '';
      strSQLDet := strSQLDet + 'SELECT ';
      strSQLDet := strSQLDet + '  COUNT(*) AS QTD ';
      strSQLDet := strSQLDet + 'FROM ';
      strSQLDet := strSQLDet + '  MOVDET  ';
      strSQLDet := strSQLDet + 'WHERE ';
      strSQLDet := strSQLDet + '  DET_NUMDOC = SUBSTR(:DOCDEV,01,' + IfThen(fTamDocCadRec = 6, '06', '12') + ') AND ';
      strSQLDet := strSQLDet + '  DET_ESPDOC = SUBSTR(:DOCDEV,' + IfThen(fTamDocCadRec = 6, '08', '14') + ',2) AND ';
      strSQLDet := strSQLDet + '  DET_CODEMP = SUBSTR(:DOCDEV,' + IfThen(fTamDocCadRec = 6, '11', '17') + ',3) AND ';
      strSQLDet := strSQLDet + '  DET_JAFATU = 0 ';

      strSQLGer := '';
      strSQLGer := strSQLGer + 'UPDATE ';
      strSQLGer := strSQLGer + '  ' + strTblMovGer + ' ';
      strSQLGer := strSQLGer + 'SET ';
      strSQLGer := strSQLGer + '  GER_JAFATU = 1, ';
      strSQLGer := strSQLGer + '  GER_TIPFAT = :TIPFAT, ';
      strSQLGer := strSQLGer + '  GER_NUMFAT = :NUMFAT, ';
      strSQLGer := strSQLGer + '  GER_EMPFAT = :EMPFAT, ';
      strSQLGer := strSQLGer + '  GER_DTAFAT = ' + fCurrentDate(Self.VS_Date) + ', ';
      strSQLGer := strSQLGer + '  GER_VENFAT = :VENFAT, ';
      strSQLGer := strSQLGer + '  GER_CNDFAT = :CNDFAT, ';
      strSQLGer := strSQLGer + '  GER_VALFAT = :VALFAT, ';
      strSQLGer := strSQLGer + '  GER_CLIFAT = :CLIFAT ';
      strSQLGer := strSQLGer + 'WHERE ';
      strSQLGer := strSQLGer + '  GER_NUMDOC = :NUMDOC AND ';
      strSQLGer := strSQLGer + '  GER_ESPDOC = :ESPDOC AND ';
      strSQLGer := strSQLGer + '  GER_CODEMP = :CODEMP ';

      For intContador := 0 To stlDDevol.Count-1 Do
      Begin

        With qryGenTmp Do
        Begin
          Close;
          SQL.Clear;
          SQL.Add(strSQLDet);
          ParamByName('DOCDEV').AsString := stlDDevol[intContador];
          Open;
          intQtdAberto := FieldByName('QTD').AsInteger;
          Close;
        End;

        If intQtdAberto <= 0 Then
        Begin
          With qryGenTmp Do
          Begin
            Close;
            SQL.Clear;
            SQL.Add(strSQLGer);
            ParamByName('TIPFAT').AsString := strEspDoc;
            ParamByName('NUMFAT').AsString := strNumDoc;
            ParamByName('EMPFAT').AsString := VS_strCodEmp;
            ParamByName('VENFAT').AsString := strCodVen;
            ParamByName('CNDFAT').AsString := strConPag;
            ParamByName('VALFAT').AsFloat  := fltTotGer;

            ParamByName('NUMDOC').AsString := Copy(stlDDevol[intContador], 1, IfThen(fTamDocCadRec = 6,  6, 12));
            ParamByName('ESPDOC').AsString := Copy(stlDDevol[intContador],    IfThen(fTamDocCadRec = 6,  8, 14), 2);
            ParamByName('CODEMP').AsString := Copy(stlDDevol[intContador],    IfThen(fTamDocCadRec = 6, 11, 17), 3);

            ParamByName('CLIFAT').AsString := strCodCli;
            ExecSQL;
            Close;
          End;

        End;

      End;

    End;

    If Result Then
    Begin
      Result := fGravaCadRecComProDocsConfirmados(dicDocsConfirmados);

      pAtualizaOcorrenciaCrmConfDoc(dicDocsConfirmados);
    End;

    If Result And ((strOpcDoc = 'CF') And (fCfgSis('GRAFCD', varBoolean))) Then
    Begin
      Result := fGravaLogConfirmacao;
    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fFaturarDocumentos]');
    End;
  End;

  FreeAndNil(qryGenTmp);
  FreeAndNil(stlDevolu);
  FreeAndNil(stlDDevol);

  dicDocsConfirmados.LimparObjetos;
  FreeAndNil(dicDocsConfirmados);
end;

procedure TFatVenda.pAtualizaOcorrenciaCrmConfDoc(dicDocsConf: TDicionario);
var
  intDocume: Integer;
  documento: TDocumentoConf;
  recDocCnf: TDocumentoCRM;
Begin
  If Not VS_strHabilitarCRM Then
    Exit;

  For intDocume := 0 To dicDocsConf.Chaves.Count -1 Do
  Begin
    documento := TDocumentoConf(dicDocsConf.RetornaObjeto(dicDocsConf.Chaves[intDocume]));

    recDocCnf.strCodCli := documento.strCodCli;
    recDocCnf.strCodEmp := documento.strCodEmp;
    recDocCnf.strEspDoc := documento.strEspDoc;
    recDocCnf.strNumDoc := documento.strNumDoc;

    pAtualizarOcorrenciaCrmConfDoc(recDocCnf,
                                   VS_strCodEmp,
                                   strNumDoc,
                                   strEspDoc,
                                   strCodVen);
  End;
End;

{************************************************}
{* GRAVA O ARQUIVO DE DUPLICATAS CONFIRMADAS    *}
{* (CTRCNF[X])                                  *}
{* strOpcDoc: 'CF' -> CAIXA 2 / 'CI' -> CAIXA 1 *}
{*********************************************MV*}
function TFatVenda.fGravaCtrCnf(strOpcDoc: String; strAutIncLisIn: String=''): Boolean;
  Var
    strSQL   : String;
    qryCtrCnf: TUniQuery;
    qryGenRec: TUniQuery;
    qryGenTmp: TUniQuery;

    fltTotDoc: Double;
    fltTotDup: Double;
  {********************************************}
  { PEGA AS DEVOLUCOES CONTIDAS NOS DOCUMENTOS }
  {*****************************************JB*}
  function fGetDevolucoes: String;
    Var
      intPos   : Integer;
      intPosAnt: Integer;
      qryGenTmp: TUniQuery;
      stlDDevol: TStringList;

  begin
    stlDDevol := Nil;

    Try
      qryGenTmp := fCriaQuery;
      stlDDevol := TStringList.Create;
      stlDDevol.Sorted := True;
      stlDDevol.Duplicates := dupIgnore;

      With qryGenTmp Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT  ');
        SQL.Add('  TMP_DEVOLU  ');
        SQL.Add('FROM  ');
        SQL.Add('  ' + strTabelaConfMi + '  ');
        Open;

        While Not Eof Do
        Begin

          intPosAnt := 0;

          intPos := PosEx('/', qryGenTmp.FieldByName('TMP_DEVOLU').AsString, intPosAnt+1);
          While intPos > 0 Do
          Begin
            stlDDevol.Add(QuotedStr(Copy(qryGenTmp.FieldByName('TMP_DEVOLU').AsString, intPosAnt, 20)));
            intPosAnt := intPos+1;
            intPos := PosEx('/', qryGenTmp.FieldByName('TMP_DEVOLU').AsString, intPosAnt+1);
          End;

          Next;
        End;

      End;

    Finally
      Result := IIF(stlDDevol.Count <= 0, 'FALSE', stlDDevol.CommaText);
      FreeAndNil(stlDDevol);
      FreeAndNil(qryGenTmp);
    End;

  end;
begin
  Result := True;

  {**********************************************}
  {* RETORNA O TOTAL DOS DOCUMENTOS CONFIRMADOS *}
  {*******************************************AC*}
  fltTotDoc := fSomaTotalDocsConfirmados(strTabelaConfMi, strAutIncLisIn);

  If (fltDupRec > 0) Then
  Begin
    {*******************************************************************************************}
    {* QUANDO ESTAVA CONFIRMADO DOCUMENTOS QUE JA FORAM QUITADOS ACONTECIA UMA DIFERENÇA       *}
    {* NO CAMPO CTRCNF/X.CTR_FATCO2, A SOMA DOS REGISTROS DESSE CAMPO DEVE SER SEMPRE = 1      *}
    {* OBS: NÃO UTILIZEI fltTotCadRec POIS SE OCORRER UM DESC. NA NF VAI CONTINUAR A DIFERENÇA *}
    {****************************************************************************************RN*}
    fltTotDoc := fltTotDoc - fltDupRec;
  End;

  fltVlrCom := 0;
  fltVlrExt := 0;

  {*****************************************************************}
  {* CONFIRMAÇÃO DE TRANSFERÊNCIA (QUANDO O CLIENTE EMPRESA FILIAL *}
  {* "NÃO" ESTÁ MARCADO PARA GERAR CADREC), NOTA ESPECIAL E CUPOM  *}
  {* ESPECIAL NÃO MEXE COM FINANCEIRO                              *}
  {********************************************************MV,RN,VA*}
  If ((strOpcDoc = 'CT') And (Not ((blnCliFil) And (blnGravaCtrTe)))) Or (blnNotEsp) Or (blnCupEsp) Or (strOpcDoc = 'CN') Then
    Exit;

  If (strOpcDoc = 'CI') And (fCfgSis('PROCTR') = '1') Then
    Exit;

  qryGenRec := fCriaQuery;
  qryGenTmp := fCriaQuery;
  qryCtrCnf := fCriaQuery;

  Try

    With qryCtrCnf Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT * FROM CTRCNF WHERE FALSE');
      Open;
    End;

    {***********************************}
    { CARREGA TODOS OS DOCUMENTOS,      }
    {********************************JB*}
    strSQL := '';
    strSQL := strSQL + 'SELECT    ';
    strSQL := strSQL + '  NUMDOC, ';
    strSQL := strSQL + '  ESPDOC, ';
    strSQL := strSQL + '  CODEMP  ';
    strSQL := strSQL + 'FROM      ';
    strSQL := strSQL + '  (       ';

    strSQL := strSQL + '    SELECT ';
    strSQL := strSQL + '      TMP_NUMDOC AS NUMDOC, ';
    strSQL := strSQL + '      TMP_ESPDOC AS ESPDOC, ';
    strSQL := strSQL + '      TMP_CODEMP AS CODEMP  ';
    strSQL := strSQL + '    FROM ';
    strSQL := strSQL +        strTabelaConfMi;
    strSQL := strSQL + '    WHERE ';
    strSQL := strSQL + '          TMP_GCTRCI = "T" ';
    If (strAutIncLisIn <> '') Then
      strSQL := strSQL + '    AND TMP_AUTINC IN ('+strAutIncLisIn+') ';

    If fGetDevolucoes <> 'FALSE' Then
    Begin
      {**************************************}
      { UNE OS DADOS ACIMA COM AS DEVOLUCOES }
      {***********************************JB*}
      strSQL := strSQL + '    UNION ALL  ';
      strSQL := strSQL + '    SELECT  ';
      strSQL := strSQL + '      DET_NUMDOC AS NUMDOC,  ';
      strSQL := strSQL + '      DET_ESPDOC AS ESPDOC,  ';
      strSQL := strSQL + '      DET_CODEMP AS CODEMP   ';
      strSQL := strSQL + '    FROM  ';
      strSQL := strSQL + '      MOVDET ';
      strSQL := strSQL + '    WHERE ';
      strSQL := strSQL + '      AUTOINCREM IN (' + fGetDevolucoes + ') ';
    End;

    strSQL := strSQL + ') AS TMP   ';
    strSQL := strSQL + 'GROUP BY   ';
    strSQL := strSQL + '  NUMDOC,  ';
    strSQL := strSQL + '  ESPDOC,  ';
    strSQL := strSQL + '  CODEMP   ';

    With qryGenTmp Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      Open;

      fltTotDup := 0;

      First;
      While (Not Eof) Do
      Begin
        fltTotDup := fltTotDup +
          fCalculaTotDupCtrCnf(FieldByName('NUMDOC').AsString,
                               FieldByName('ESPDOC').AsString,
                               FieldByName('CODEMP').AsString);
        Next;
      End;

      First;
      While (Not Eof) Do
      Begin
        pCopiaParaCtrCnf(FieldByName('NUMDOC').AsString,
                         FieldByName('ESPDOC').AsString,
                         FieldByName('CODEMP').AsString,
                         fltTotDoc,
                         fltTotDup,
                         qryCtrCnf);

        Next;
      End;

    End;

  Except
    On E: Exception Do
    Begin
      Result := False;
      pMensagensErro(E.Message, '[fGravaCtrCnf]');
    End;
  End;

  FreeAndNil(qryCtrCnf);
  FreeAndNil(qryGenRec);
  FreeAndNil(qryGenTmp);

end;

function TFatVenda.fGravaDespesasAduaneiras(strSeqFis: string;
                                            fltAduDem,
                                            fltAduTxa,
                                            fltAduDpc,
                                            fltAduFre,
                                            fltAduOdp,
                                            fltAduMul,
                                            fltAduFti,
                                            fltAdu500: Double): Boolean;
var
  qryDesAdu: TUniQuery;
  intIndice: integer;
begin
  Result := False;
  qryDesAdu := fCriaQuery;
  try
    try
      qryDesAdu.SQL.Text := 'SELECT * FROM DESADU WHERE FALSE';
      qryDesAdu.Open;

      for intIndice := 0 to 7 do
      begin
        qryDesAdu.Insert;
        qryDesAdu.FieldByName('AUTOINCREM').AsString := fRetAutoIncrem('DESADU', VS_strCodEmp);
        qryDesAdu.FieldByName('ADU_SEQFIS').AsString := strSeqFis;

        case intIndice of
          0:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'DEMURRAGE';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduDem;
            end;

          1:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'TAXA ARMAZENAGEM';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduTxa;
            end;

          2:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'DESPACHANTE';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduDpc;
            end;

          3:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'FRETE';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduFre;
            end;

          4:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'OUTRAS DESPESAS';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduOdp;
            end;

          5:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'MULTA SETOR ADUANEIRO';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduMul;
            end;

          6:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'FRETE INTERNO';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAduFti;
            end;

          7:begin
              qryDesAdu.FieldByName('ADU_DESCRI').AsString := 'F500';
              qryDesAdu.FieldByName('ADU_VALADU').AsFloat := fltAdu500;
            end;
        end;

        qryDesAdu.Post;
      end;

      Result := True;
    except
      on E: exception do
      begin
        pMensagensErro(E.Message, '[fGravaDEspesasAduaneiras]');
      end;
    end;
  finally
    FreeAndNil(qryDesAdu);
  end;
end;

