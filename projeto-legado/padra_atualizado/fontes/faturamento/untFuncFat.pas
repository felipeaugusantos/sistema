function TFatVenda.fValidaEmitenteDoDocumentoReferenciado(const strChvRef: String): Boolean;
Var
  cdsItens: TUniClientDataSet;
  strCnpjRef: String;
begin
  Result := True;

  If Not fCfgSis('DV_REF', varBoolean) Then
    Exit;

  strCnpjRef := Copy(strChvRef, 7, 14);

  If fEmptyStr(strCnpjRef) Then
    Exit;

  cdsItens := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsItens, cdsVenda);

  Try
    cdsItens.First;
    While Not cdsItens.Eof Do
    Begin
      If fEmptyStr(cdsItens.FieldByName('ITE_CHVREF').AsString) Then
      Begin
        cdsItens.Next;
        Continue;
      End;

      If not (strCnpjRef = Copy(cdsItens.FieldByName('ITE_CHVREF').AsString, 7, 14)) Then
      Begin
        Result := False;
        Break;
      End;

      cdsItens.Next;
    End;
  Finally
    FreeAndNil(cdsItens);
  End;
end;

function TFatVenda.fExisteDocumentoReferenciadoDoMesmoItem(const strChvRef, strIteRef: String): Boolean;
var
  cdsItens: TUniClientDataSet;
begin
  Result := False;

  If Not fCfgSis('DV_REF', varBoolean) Then
    Exit;

  If fEmptyStr(strChvRef) Then
    Exit;

  If fEmptyStr(strIteRef) Then
    Exit;

  cdsItens := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsItens, cdsVenda);

  Try
    cdsItens.First;
    While Not cdsItens.Eof Do
    Begin
      If fEmptyStr(cdsItens.FieldByName('ITE_CHVREF').AsString) Then
      Begin
        cdsItens.Next;
        Continue;
      End;

      If fEmptyStr(cdsItens.FieldByName('ITE_ITEREF').AsString) Then
      Begin
        cdsItens.Next;
        Continue;
      End;

      If (strChvRef = cdsItens.FieldByName('ITE_CHVREF').AsString) And (strIteRef = cdsItens.FieldByName('ITE_ITEREF').AsString) Then
      Begin
        Result := True;
        Break;
      End;

      cdsItens.Next;
    End;
  Finally
    FreeAndNil(cdsItens);
  End;
end;

