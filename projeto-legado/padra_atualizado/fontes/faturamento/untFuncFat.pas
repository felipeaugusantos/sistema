function TFatVenda.fRetornaInformacoesDaUltimaCompra: String;
var
  qryAux: TUniQuery;
  intContador: Integer;
  strCodIte: String;
  strNotCom: String;
  strNotAnt: String;
  strEmpCgc: String;
  strCliCgc: String;
  strClaNuc: String;
  fltValIcm: Double;
  fltValPis: Double;
  fltValCof: Double;

  function fRetornaQtdIte(strCodIte: String): Double;
  var
    intPosicao: Integer;
  begin
    Result := 0;

    For intPosicao := Low(arrMatItens) To High(arrMatItens) Do
    Begin
      If (fEhItemServico(arrMatItens[intPosicao].strCodIte)) Then
        Continue;

      If (arrMatItens[intPosicao].strCodIte = strCodIte) Then
      Begin
        Result := Result + arrMatItens[intPosicao].fltQtdIte;
      End;
    End;
  end;

begin

  If not (fCfgSis('INFNUC', varString) = 'S') Then
    Exit;

  If not (strOpcDoc = 'OU') Then
    Exit;

  strEmpCgc := fRetCGCEmpresa(VS_strCodEmp);
  strCliCgc := fRetCgcCpf(Self.strCodCli);

  If not (strCliCgc = strEmpCgc) Then
    Exit;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin
    If (fEhItemServico(arrMatItens[intContador].strCodIte)) Then
      Continue;

    If not (arrMatItens[intContador].strClaFis = '5927')Then
      Continue;

    If fEmptyStr(strCodIte) Then
      strCodIte := arrMatItens[intContador].strCodIte
    Else
      strCodIte := strCodIte + ',' + arrMatItens[intContador].strCodIte;
  End;

  If fEmptyStr(strCodIte) Then
    Exit;

  strClaNuc := fTransform(fCfgSis('CLANUC'), 4);

  qryAux := fCriaQuery(Self);

  Try
    qryAux.SQL.Clear;
    qryAux.SQL.Add('SELECT ');
    qryAux.SQL.Add('  MOVDET.DET_CODITE, ');
    qryAux.SQL.Add('  MOVDET.DET_NUMDOC, ');
    qryAux.SQL.Add('  SUM(ROUND(IFNULL(DETELE.N17_VICMS,  0) / MOVDET.DET_QTDITE, 2)) AS DET_VALICM, ');
    qryAux.SQL.Add('  SUM(ROUND(IFNULL(MOVTRI.DET_VALPIS, 0) / MOVDET.DET_QTDITE, 2)) AS DET_VALPIS, ');
    qryAux.SQL.Add('  SUM(ROUND(IFNULL(MOVTRI.DET_VALCOF, 0) / MOVDET.DET_QTDITE, 2)) AS DET_VALCOF ');
    qryAux.SQL.Add('FROM ITEGER ');
    qryAux.SQL.Add('  LEFT JOIN MOVDET ON MOVDET.DET_CODFOR = ITEGER.ITE_FORULT ');
    qryAux.SQL.Add('                  AND MOVDET.DET_CODITE = ITEGER.ITE_CODITE ');
    qryAux.SQL.Add('                  AND MOVDET.DET_NUMDOC = SUBSTR(ITEGER.ITE_NOTULT,01,12) ');
    qryAux.SQL.Add('                  AND MOVDET.DET_ESPDOC = SUBSTR(ITEGER.ITE_NOTULT,13,02) ');
    qryAux.SQL.Add('                  AND MOVDET.DET_CODEMP = SUBSTR(ITEGER.ITE_NOTULT,15,03) ');
    qryAux.SQL.Add('  LEFT JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ');
    qryAux.SQL.Add('  LEFT JOIN GERELE ON GERELE.GER_DOCENT = MOVDET.DET_NUMDOC ');
    qryAux.SQL.Add('                  AND GERELE.GER_ESPENT = MOVDET.DET_ESPDOC ');
    qryAux.SQL.Add('                  AND GERELE.GER_EMPENT = MOVDET.DET_CODEMP ');
    qryAux.SQL.Add('                  AND GERELE.GER_CODFOR = MOVDET.DET_CODFOR ');
    qryAux.SQL.Add('                  AND IFNULL(GERELE.B07_SERIE, "") = IFNULL(MOVDET.DET_SERIE_, "") ');
    qryAux.SQL.Add('  LEFT JOIN DETELE ON DETELE.DET_SEQGER = GERELE.AUTOINCREM ');
    qryAux.SQL.Add('                  AND DETELE.DET_CODITE = MOVDET.DET_CODITE ');
    qryAux.SQL.Add('WHERE ITE_NOTULT IS NOT NULL ');
    qryAux.SQL.Add('  AND ITE_CODITE IN ('+strCodIte+') ');
    qryAux.SQL.Add('  AND LOCATE(DET_CLAFIS, '+QuotedStr(strClaNuc)+') > 0 ');
    qryAux.SQL.Add('  AND ITE_CODEMP = :CODEMP ');
    qryAux.SQL.Add('GROUP BY MOVDET.DET_NUMDOC, MOVDET.DET_CODITE ');
    qryAux.SQL.Add('ORDER BY MOVDET.DET_NUMDOC ');
    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryAux.Open;

    fltValIcm := 0;
    fltValPis := 0;
    fltValCof := 0;

    While not qryAux.Eof Do
    Begin
      strNotCom := qryAux.FieldByName('DET_NUMDOC').AsString;

      If (strNotCom <> strNotAnt) Then
      Begin
        fltValIcm := (qryAux.FieldByName('DET_VALICM').AsFloat * fRetornaQtdIte(qryAux.FieldByName('DET_CODITE').AsString));
        fltValPis := (qryAux.FieldByName('DET_VALPIS').AsFloat * fRetornaQtdIte(qryAux.FieldByName('DET_CODITE').AsString));
        fltValCof := (qryAux.FieldByName('DET_VALCOF').AsFloat * fRetornaQtdIte(qryAux.FieldByName('DET_CODITE').AsString));
      End
      Else
      Begin
        fltValIcm := fltValIcm + (qryAux.FieldByName('DET_VALICM').AsFloat * fRetornaQtdIte(qryAux.FieldByName('DET_CODITE').AsString));
        fltValPis := fltValPis + (qryAux.FieldByName('DET_VALPIS').AsFloat * fRetornaQtdIte(qryAux.FieldByName('DET_CODITE').AsString));
        fltValCof := fltValCof + (qryAux.FieldByName('DET_VALCOF').AsFloat * fRetornaQtdIte(qryAux.FieldByName('DET_CODITE').AsString));
      End;

      strNotAnt := qryAux.FieldByName('DET_NUMDOC').AsString;

      qryAux.Next;

      If (qryAux.FieldByName('DET_NUMDOC').AsString <> strNotAnt) Or (qryAux.Eof And (Pos(strNotCom, Result) = 0)) Then
      Begin
        Result := Result + ' NF: '+strNotCom +
                           ' ICMS: '+FormatFloat('0.00', fltValIcm) +
                           ' PIS: ' +FormatFloat('0.00', fltValPis) +
                           ' COF: ' +FormatFloat('0.00', fltValCof);
      End;
    End;

  Finally
    FreeAndNil(qryAux);
  End;
end;

function TFatVenda.fGetClienteDaChaveASerDevolvida : String;
begin
  Result := EmptyStr;
  If Not fUtilizarRotinaDeOutrasEntradasParaAnulacaoDeVendas Then
    Exit;
  If (Not fEmptyStr(Self.strChaveNFeRefDevolucao)) Then
    Result := fCampoTabela('FIS_FORCLI', 'CADFIS', ['FIS_ACESSO', 'FIS_TIP_FC'], [Self.strChaveNFeRefDevolucao, 'C'], False)
  Else
  Begin
    If (fEmptyStr(Self.strNumCOONFeRefDevolucao + Self.strNumSerNFeRefDevolucao + Self.strNumUSUNFeRefDevolucao)) Then
      Exit;
    Result := fCampoTabela('GER_CODCLI', 'MOVGER INNER JOIN AUXMOV ON AUX_SEQGER = AUTOINCREM', ['AUX_NUMCOO', 'AUX_NUMSER', 'AUX_NUMUSU'], [Self.strNumCOONFeRefDevolucao, Self.strNumSerNFeRefDevolucao, Self.strNumUSUNFeRefDevolucao], False);
    If fEmptyStr(Result) Then
      Result := fCampoTabela('GER_CODCLI', 'NOTGER INNER JOIN AUXNOT ON AUX_SEQGER = AUTOINCREM', ['AUX_NUMCOO', 'AUX_NUMSER', 'AUX_NUMUSU'], [Self.strNumCOONFeRefDevolucao, Self.strNumSerNFeRefDevolucao, Self.strNumUSUNFeRefDevolucao], False);
  End;
end;

function TFatVenda.fVerificaGravacaoOrigemMesmoDocumento: Boolean;
  Var
    cdsDados: TUniClientDataSet;
begin
  If (fCfgSis('DMPPIX', varString) <> 'S') Then
    Exit(False);

  cdsDados := TUniClientDataSet.Create(Self);

  Try
    pCloneDataSet(cdsDados, cdsVenda);

    cdsDados.Filtered := False;

    cdsDados.Filter := '(ITE_ENTRET = ' + QuotedStr('E')+') OR (ITE_ENTRET = ' + QuotedStr('R')+ ' AND ITE_LOCRET <> '+ QuotedStr('E')+')';

    cdsDados.Filtered := True;

    Result := (cdsDados.IsEmpty);
  Finally
    cdsDados.Close;
    FreeAndNil(cdsDados);
  End;

end;

function TFatVenda.fRetornaTipoFretePermitidoTransportadora(const ACodTra: String): String;
var
  LQry: TUniQuery;
begin
  Result := '';

  If Not(fCfgSis('TRPPRM', varBoolean)) Then
    Exit;

  LQry := fCriaQuery;
  Try
    LQry.SQL.Add('SELECT FRE_TIPFRE FROM FREPRM');
    LQry.SQL.Add(' WHERE FRE_CODTRA =  :CODTRA');
    LQry.ParamByName('CODTRA').AsString := ACodTra;
    LQry.Open;
    If Not LQry.IsEmpty Then
    Begin
      While Not LQry.EOF Do
      Begin
        If LQry.FieldByName('FRE_TIPFRE').AsInteger > 0 Then
          Result := Result + IIF(Not fEmptyStr(Trim(Result)), ', ', '') + fDescricaoFrete(LQry.FieldByName('FRE_TIPFRE').AsString);

        LQry.Next;
      End;
    End
    Else
      Result := 'Nenhum tipo definido. Verifique o cadastro da transportadora.';
  Finally
    FreeAndNil(LQry);
  End;
end;

