class function TFatVenda.fGetSQLLeftJoinCadLotItensPedido(blnWMS: Boolean; strCodEmpParam: String = ':CODEMP'): String;

  function fSQLUtilizaADEFINIRParaTintasImobil: String;
    Var
      tintas: ITintasDeMaquina;
  begin
    Result := '';

    If (VS_strUsaTmq = 'S') Then
    Begin
      tintas := fGetTintasdeMaquina;

      Result := ' OR (IF(((SELECT IFNULL(SIS_VALCFG, "N") FROM CFGSIS WHERE SIS_CODCFG = "CFG_TINWMS" AND SIS_CODEMP = FDO_EMPITE LIMIT 1) = "S"), '+
                '       (LOCATE(FDO_IDEPRO,"' + tintas.fGetImobiliarias + '") > 0), ' +
                '        FALSE)) ';
    End;
  end;

begin
  Result := '';
  Result := Result + '  LEFT JOIN CADLOT ON  LOT_CODITE = FDO_CODITE AND ';

  If Not blnWMS Then
  Begin
    Result := Result + ' LOT_CODEMP = IF(IFNULL(FGO_EMP_CD, "") <> "", FGO_EMP_CD, IF(IFNULL(FDO_EMPITE,"") <> "", FDO_EMPITE, FDO_CODEMP) ) AND ';
    Result := Result + ' LOT_NUMLOT = FDO_NUMLOT     ';
  End
  Else
  Begin
    Result := Result + ' LOT_CODEMP = IF(IFNULL(FGO_EMP_TE, "") <> "", FGO_EMP_TE, IF(IFNULL(FGO_EMP_CD, "") <> "", FGO_EMP_CD, ' + strCodEmpParam + ')) AND ';

    If fUsaRotinaExpedicaoConferenciaRetiraCaixa Then
      Result := Result + ' IF(((FDO_IDEPRO = "NOR" AND FDO_PROACA <> "S") '+fSQLUtilizaADEFINIRParaTintasImobil+'), IF(FDO_NUMLOT <> "", LOT_NUMLOT = FDO_NUMLOT, LOT_NUMLOT = "A DEFINIR"), LOT_PRITIN = "S") '
    Else If fCfgSis('WMSLOT', varBoolean) Then
      Result := Result + ' IF(((FDO_IDEPRO = "NOR" AND FDO_PROACA <> "S") '+fSQLUtilizaADEFINIRParaTintasImobil+'), IF(I.ITE_LOTEPD = "S" AND FDO_NUMLOT <> "", LOT_NUMLOT = FDO_NUMLOT, LOT_NUMLOT = "A DEFINIR"), LOT_PRITIN = "S") '
    Else
      Result := Result + ' IF(((FDO_IDEPRO = "NOR" AND FDO_PROACA <> "S") '+fSQLUtilizaADEFINIRParaTintasImobil+'), LOT_NUMLOT = "A DEFINIR", LOT_PRITIN = "S") ';
  End;
end;

class function TFatVenda.fValidarDefinicaoLotesPedidoWMS(ANumDoc, AEspDoc, AEmpDoc: String; Out strMsgErro: String): Boolean;
var
  LQry: TUniQuery;
begin
  strMsgErro := '';
  If Not fUsaRotinaWMS Then
    Exit(True);

  LQry := fCriaQuery;
  Try
    LQry.SQL.Add(' SELECT SQL_NO_CACHE ');
    LQry.SQL.Add('   FDO_CODITE AS CODITE, ');
    LQry.SQL.Add('   LOT_NUMLOT AS NUMLOT, ');
    LQry.SQL.Add('   FDO_QTDITE - COALESCE(FDO_QTDBAI, 0) AS QTDITE, ');
    LQry.SQL.Add('   SUM(COALESCE(LDO_QTDITE, 0)) AS QTDLOT ');
    LQry.SQL.Add(' FROM ');
    LQry.SQL.Add('   FATDOR ');
    LQry.SQL.Add('   INNER JOIN FATGOR ');
    LQry.SQL.Add('     ON FATGOR.AUTOINCREM = FDO_SEQGER ');
    LQry.SQL.Add('   LEFT JOIN EXTGOR ');
    LQry.SQL.Add('     ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ');
    LQry.SQL.Add('   LEFT JOIN LOTDOR ');
    LQry.SQL.Add('     ON LDO_SEQFDO = FATDOR.AUTOINCREM ');
    LQry.SQL.Add('   JOIN CADITE I ON I.ITE_CODITE = FDO_CODITE ');
    LQry.SQL.Add(fGetSQLLeftJoinCadLotItensPedido(True, 'FGO_EMPEXP'));
    LQry.SQL.Add(' WHERE TRUE ');
    LQry.SQL.Add('   AND FDO_NUMDOC = "' + ANumDoc + '" ');
    LQry.SQL.Add('   AND FDO_ESPDOC = "' + AEspDoc + '" ');
    LQry.SQL.Add('   AND FDO_CODEMP = "' + AEmpDoc + '" ');
    LQry.SQL.Add('   AND FDO_JAFATU = 0 ');
    LQry.SQL.Add(' GROUP BY FATDOR.AUTOINCREM ');
    LQry.SQL.Add(' HAVING QTDITE > 0 ');
    LQry.SQL.Add('    AND NUMLOT = "A DEFINIR" ');
    LQry.Open;

    While Not LQry.Eof Do
    Begin
      If fFormataFloat(LQry.FieldByName('QTDLOT').AsFloat, 4) = 0 Then
      Begin
        strMsgErro := 'Pedido ' + Concat(ANumDoc, '-', AEspDoc, '-', AEmpDoc) +
                      ' possui itens sem realizar a separação/definição dos lotes (WMS).';
        Exit(False);
      End;

      If fFormataFloat(LQry.FieldByName('QTDITE').AsFloat, 4) <>
         fFormataFloat(LQry.FieldByName('QTDLOT').AsFloat, 4) Then
      Begin
        strMsgErro := 'Pedido ' + Concat(ANumDoc, '-', AEspDoc, '-', AEmpDoc) +
                      ' possui itens com separação/definição parcial dos lotes (WMS).';
        Exit(False);
      End;

      LQry.Next;
    End;

    Result := True;

  Finally
    FreeAndNil(LQry);
  End;
end;

function TFatVenda.fGetTipCarPorProporcionalidadeCredDeb(fltValor: Double; strTipCar : String) : String;
  var
    fltDifCredito, fltDifDebito : Double;
begin
  Result := strTipCar;

  if recTipCarMovMod.fltCredito = 0 then
  begin
    if recTipCarMovMod.fltDebito > 0 then
      Result := 'D';
    Exit;
  end;

  if recTipCarMovMod.fltDebito = 0 then
  begin
    if recTipCarMovMod.fltCredito > 0 then
      Result := 'C';
    Exit;
  end;

  fltDifCredito := fltValor - recTipCarMovMod.fltCredito;
  fltDifDebito  := fltValor - recTipCarMovMod.fltDebito;

  if fltDifCredito < fltDifDebito then
  begin
    Result := 'C';
    recTipCarMovMod.fltCredito := 0;
  end
  else
  begin
    Result := 'D';
    recTipCarMovMod.fltDebito := 0;
  end;
end;

function TFatVenda.fGetSerInativos(var strServicosInativos: String): Boolean;
Var
  intIndSer: Integer;
  strCodSer: String;
  strSerIna: String;
begin

  Result := False;
  strServicosInativos := '';

  For intIndSer := 1 To 30 Do
  Begin

    strCodSer := GetPropValue(Self, 'strCodS' + fStrZero(intToStr(intIndSer), 2));

    If fEmptyStr(strCodSer) Then
      Continue
    Else
    Begin

      strSerIna := '';
      If fGetServicoEstaInativo(strCodSer, strSerIna) Then
      Begin
        Result := True;
        strServicosInativos := strServicosInativos + #13#10 + strSerIna;
      End;

    End;

  End;

End;

function TFatVenda.fGetServicoEstaInativo(strCodSer: String; var strCodDes: String): Boolean;
var
  qryAux : TUniQuery;
Begin

  Result    := False;
  strCodDes := '';

  If Not fEmptyStr(strCodSer) Then
  Begin

    qryAux := fCriaQuery;

    Try

      qryAux.Close;
      qryAux.SQL.Clear;
      qryAux.SQL.Add('SELECT * FROM CADSER WHERE SER_ATIVO_ = "N" AND SER_CODSER = ' + QuotedStr(strCodSer));
      qryAux.Open;

      If Not qryAux.IsEmpty Then
      Begin
        Result    := True;
        strCodDes := qryAux.FieldByName('SER_CODSER').AsString + '-' +
                     qryAux.FieldByName('SER_DESSER').AsString;
      End;

    Finally;
      FreeAndNil(qryAux);
    End;

  End;

End;

procedure TFatVenda.pCarregarLotesItensDevolucaoAutomatizada;
  var
    intContador : Integer;

  function fRetLoteItemDevAut(strCodIte : String) : String;
  begin

    Result := 'A DEFINIR';

    If Not Assigned(qryTemporaria) Then
      Exit;

    If qryTemporaria.IsEmpty Then
      Exit;

    If qryTemporaria.Locate('DET_CODITE', strCodIte, []) Then
      Result := qryTemporaria.FieldByName('DET_NUMLOT').AsString;

  end;

begin

  If fPermiteGravarSemLotePreenchido Then
    Exit;

  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin

    If (fEhItemServico(arrMatItens[intContador].strCodIte)) Then
      Continue;

    If Not fEmptyStr(arrMatItens[intContador].strNumLot) Then
      Continue;

    If Not objCadLot.fExisteLote(arrMatItens[intContador].strCodIte, VS_strCodEmp) Then
      Continue;

    arrMatItens[intContador].strNumLot := fRetLoteItemDevAut(arrMatItens[intContador].strCodIte);

  End;

end;

procedure TFatVenda.pCarregarReprocessarSaldoItensRemovidos;
Var
  LCodigo: String;
  LEmpresa: String;
  LEmpresas: TArray<String>;
  LSubItem: String;
  LSubItens: TArray<String>;
begin
  objReprocessarSaldoItensRemovidos := TReprocessarSaldoItem.New();
  For LCodigo In stlItensRemovidos Do
  Begin
    LEmpresas := untFuncoesSimples.fGetEmpresasReprocessarItemPedido(strNumOrc, strEspOrc, strEmpOri, LCodigo);
    For LEmpresa In LEmpresas Do
    Begin
      objReprocessarSaldoItensRemovidos.AddItem(TItemReprocessarSaldo.New.Codigo(LCodigo).Empresa(LEmpresa));

      If (fCfgSis('BXSBIT') = '2') And (fCfgSis('EMOPPD') = 'N') Then
      Begin
        LSubItens := fGetSubItensEstrutura(LCodigo);
        For LSubItem In LSubItens Do
          objReprocessarSaldoItensRemovidos.AddItem(TItemReprocessarSaldo.New.Codigo(LSubItem).Empresa(LEmpresa));
      End;
    End;
  End;
end;

procedure TFatVenda.pCarregarServicosPedidoOrcamento(qryFatGor: TUniQuery; strFiltroBrindes: String = '');
  Var
    intIndSerPed, intIndSerInc: Integer;
    strIndSerPed, strIndSerInc: String;

  function fField(strName: String): TField;
  begin
    Result := qryFatGor.FindField(strName);
  end;

begin
  FillChar(Self.FRecSer, SizeOf(Self.FRecSer), #0);

  intIndSerInc := 0;

  For intIndSerPed := 1 To 30 Do
  Begin
    strIndSerPed := fStrZero(intIndSerPed.ToString, 2);

    Inc(intIndSerInc);
    strIndSerInc := fStrZero(intIndSerInc.ToString, 2);

    SetPropValue(Self, 'strCodS' + strIndSerInc, fField('FGO_CODS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strDesS' + strIndSerInc, fField('FGO_DESS' + strIndSerPed).AsString );
    SetPropValue(Self, 'fltUniS' + strIndSerInc, fField('FGO_UNIS' + strIndSerPed).AsFloat  );
    SetPropValue(Self, 'fltQtdS' + strIndSerInc, fField('FGO_QTDS' + strIndSerPed).AsFloat  );
    SetPropValue(Self, 'fltValS' + strIndSerInc, fField('FGO_VALS' + strIndSerPed).AsFloat  );
    SetPropValue(Self, 'fltCusS' + strIndSerInc, fField('FGO_CUSS' + strIndSerPed).AsFloat  );
    SetPropValue(Self, 'fltDecS' + strIndSerInc, fField('FGO_DECS' + strIndSerPed).AsFloat  );
    SetPropValue(Self, 'strStaS' + strIndSerInc, fField('FGO_STAS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strBriS' + strIndSerInc, fField('FGO_BRIS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strParS' + strIndSerInc, fField('FGO_PARS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strTBrS' + strIndSerInc, fField('FGO_TBRS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strPriS' + strIndSerInc, fField('FGO_PRIS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strIdeS' + strIndSerInc, fField('FGO_IDES' + strIndSerPed).AsString );
    SetPropValue(Self, 'strVenS' + strIndSerInc, fField('FGO_VENS' + strIndSerPed).AsString );
    SetPropValue(Self, 'strVe2S' + strIndSerInc, fField('FGO_VE2S' + strIndSerPed).AsString );

    SetPropValue(Self, 'strMecS' + strIndSerInc, fCarregarMecanicosServico (fField('AUTOINCREM').AsString, strIndSerPed));
    SetPropValue(Self, 'strObsS' + strIndSerInc, fCarregarObservacaoServico(fField('AUTOINCREM').AsString, strIndSerPed));
  End;

  If (fField('FGO_DISSER') <> Nil) Then
    strDisSer := fField('FGO_DISSER').AsString
  Else
    strDisSer := '';

  intNroPro := fField('FGO_NROPRO').AsInteger;
  strNroCEI := fField('FGO_NROCEI').AsString;
  dtaSerIni := fField('FGO_SERINI').AsDateTime;
  dtaSerFin := fField('FGO_SERFIN').AsDateTime;
  strSerObs := fField('FGO_SEROBS').AsString;

  intPraEnt := fField('FGO_PRAENT').AsInteger;

  fltTotSer := fField('FGO_TOTSER').AsFloat;
  fltBasIss := fField('FGO_BASISS').AsFloat;
  fltRedIss := fField('FGO_REDISS').AsFloat;
  fltDedIss := fField('FGO_DEDISS').AsFloat;
  fltPerIss := fField('FGO_PERISS').AsFloat;
  fltValIss := fField('FGO_VALISS').AsFloat;

  If (strFiltroBrindes = 'S') Then
  Begin
    fltTotSer := 0.00;
    fltBasIss := 0.00;
    fltRedIss := 0.00;
    fltPerIss := 0.00;
    fltValIss := 0.00;
  End;

  dtaDtAgeS  := fField('FGO_DTAGES').AsDateTime;
  horHrAgeS  := fField('FGO_HRAGES').AsDateTime;
  dtaDtEntS  := fField('FGO_DTENTS').AsDateTime;
  horHrEntS  := fField('FGO_HRENTS').AsDateTime;
  strMunPre  := fField('FGO_MUNPRE').AsString;
  strNatServ := fField('FGO_NATSER').AsString;

  Self.blnUsaEndEntregaServicosPedidoOrcamento := (strMunPre = '2');

end;

procedure TFatVenda.pCarregaStringListExcecoes(Const strCodIteLisOrc: String; Const strEmpIteLisOrc: String; Const stlCodIteCodEmp: TStringList);
  Var
    intIdx: Integer;
    strCodIteCodEmp,
    strCodIte,
    strCodIteLisOrcAux,
    strEmpIteLisOrcAux: String;

    ListCamVen,
    ListNegoci,
    ListQtdEmb,
    ListPromoc: TStringList;

    function fRetornaListaEmpresa: String;
      Var
        qryGen: TUniQuery;
    Begin
      qryGen := fCriaQuery;
      Try
        With qryGen, SQL Do
        Begin
          qryGen.SQL.Text := 'SELECT EMP_CODEMP FROM CADEMP ORDER BY EMP_CODEMP';
          Open;
          First;
          While Not Eof Do
          Begin
            pIncrementaListaStr(qryGen.Fields[0].AsString, Result, True, True, ',', False);
            Next;
          End;
          Close;
        End;
      Finally
        FreeAndNil(qryGen)
      End;
    End;

begin
  strCodIteLisOrcAux := fSafeSQLValue(strCodIteLisOrc);
  strEmpIteLisOrcAux := strEmpIteLisOrc;
  If fEmptyStr(strEmpIteLisOrcAux) Then
    strEmpIteLisOrcAux := fRetornaListaEmpresa;

  ListPromoc := fRetornaSomenteItensEmPromocaoDaLista(strCodIteLisOrcAux, strEmpIteLisOrcAux, Self.strCodCli);
  ListNegoci := TCadNegBussiness.fRetornaSomenteItensEmNegociacaoDaLista(strCodIteLisOrcAux);
  ListQtdEmb := fRetornaSomenteItensComQtdEmbalagemFechadaDaLista(strCodIteLisOrcAux);
  ListCamVen := objCamGer.objCamDet.fRetornaSomenteItensEmCampanhaDaLista(strCodIteLisOrcAux);

  Try
    Self.stlItensTemPromocao.Clear;
    Self.stlItensNaoTemPromocao.Clear;

    For intIdx:= 0 To stlCodIteCodEmp.Count-1 Do
    Begin
      strCodIte       := Copy(stlCodIteCodEmp[intIdx], 1, fTamCodIte);
      strCodIteCodEmp := stlCodIteCodEmp[intIdx];

      If (ListNegoci.IndexOf(strCodIte) = -1) Then //NÃO ESTÃO EM NEGOCIACAO
      Begin
        If (ListPromoc.IndexOf(strCodIteCodEmp) = -1) Then //NÃO ESTÃO EM PROMOCAO
        Begin
          If (Self.stlItensNaoTemPromocao.IndexOf(strCodIteCodEmp) = -1) Then
            Self.stlItensNaoTemPromocao.Add(strCodIteCodEmp);
        End
        Else
        Begin
          If (Self.stlItensTemPromocao.IndexOf(strCodIteCodEmp) = -1) Then //ESTÃO EM PROMOCAO
            Self.stlItensTemPromocao.Add(strCodIteCodEmp);
        End;
      End;
    End;

    For intIdx:= 0 To stlCodIteCodEmp.Count-1 Do
    Begin
      strCodIte := Copy(stlCodIteCodEmp[intIdx], 1, fTamCodIte);

      If (ListQtdEmb.IndexOf(strCodIte) = -1) Then //NÃO ESTÃO EM EMBALAGEM FECHADA
        If (stlItensNaoTemQtdeEmbFec.IndexOf(strCodIte) = -1) Then
          Self.stlItensNaoTemQtdeEmbFec.Add(strCodIte);
    End;

    For intIdx:= 0 To stlCodIteCodEmp.Count-1 Do
    Begin
      strCodIte := Copy(stlCodIteCodEmp[intIdx], 1, fTamCodIte);

      If (ListCamVen.IndexOf(strCodIte) = -1) Then //NÃO ESTÃO EM CAMPANHA
        Self.objCamGer.pAcrescentaExcecaoCampanha(strCodIte);
    End;
  Finally
    FreeAndNil(ListPromoc);
    FreeAndNil(ListNegoci);
    FreeAndNil(ListQtdEmb);
    FreeAndNil(ListCamVen);
  End;
end;

