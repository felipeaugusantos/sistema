function TFatVenda.AdiantamentoDoPedidoRecebidoPorPix: String;
  Var
    LConsulta: TUniQuery;

    LItem: TDadosFechamento;
begin
  If Length(arrMatItens) = 0 Then
    Exit;

  Result := 'N';

  LConsulta := fCriaQuery;

  Try
    LConsulta.SQL.Text := 'SELECT A.ADT_RECPIX ' +
                          'FROM ADTCLI A ' +
                          'WHERE A.ADT_NUMDOC=:NUMDOC ' +
                          '  AND A.ADT_ESPDOC=:ESPDOC ' +
                          '  AND A.ADT_CODEMP=:CODEMP ' +
                          '  AND A.ADT_CODCLI=:CODCLI ' +
                          '  AND A.ADT_TIPLAN="C" ' +
                          '  AND A.ADT_ESTORN="N" ' +
                          '  AND A.ADT_VALORD>0 ' +
                          'ORDER BY A.ADT_DTALAN, A.ADT_HORLAN ';

    For LItem In arrMatItens Do
    Begin
      LConsulta.ParamByName('NUMDOC').AsString := LItem.strNumOrc;
      LConsulta.ParamByName('ESPDOC').AsString := LItem.strEspOrc;
      LConsulta.ParamByName('CODEMP').AsString := LItem.strEmpOrc;
      LConsulta.ParamByName('CODCLI').AsString := Self.strCodCli;

      Break;
    End;

    If LConsulta.ParamByName('NUMDOC').AsString.IsEmpty Then
      Exit;

    LConsulta.Open;

    If Not LConsulta.IsEmpty Then
      Result := LConsulta.FieldByName('ADT_RECPIX').AsString;
  Finally
    LConsulta.Close;

    FreeAndNil(LConsulta);
  End;
end;

procedure TFatVenda.AtualizaCamposPixNaExtGorDosPedidos(
  ADadosPedidos: TFatVendaImp; ALimparCampos: Boolean = False);
  Var
    LContador: Integer;

    LAtualizacao: TUniQuery;
begin
  Try
    LAtualizacao := fCriaQuery;

    LAtualizacao.SQL.Text := 'UPDATE EXTGOR SET     ' +
                             '  FGO_TX_PIX=:TX_PIX, ' +
                             '  FGO_EMPPIX=:EMPPIX  ' +
                             'WHERE ' +
                             'FGO_SEQFGO=(SELECT AUTOINCREM        ' +
                             '            FROM FATGOR              ' +
                             '            WHERE FGO_NUMDOC=:NUMDOC ' +
                             '              AND FGO_ESPDOC=:ESPDOC ' +
                             '              AND FGO_CODEMP=:CODEMP)';

    For LContador := 0 To ADadosPedidos.ItemsCount - 1 Do
    Begin
      LAtualizacao.ParamByName('TX_PIX').Value := Null;
      LAtualizacao.ParamByName('EMPPIX').Value := Null;

      If Not ALimparCampos Then
      Begin
        LAtualizacao.ParamByName('TX_PIX').AsString := DadosPixDaVenda.TxIdPix;
        LAtualizacao.ParamByName('EMPPIX').AsString := DadosPixDaVenda.EmpresaDoPix;
      End;

      LAtualizacao.ParamByName('NUMDOC').AsString := ADadosPedidos[lContador].strNumDoc;
      LAtualizacao.ParamByName('ESPDOC').AsString := ADadosPedidos[lContador].strEspDoc;
      LAtualizacao.ParamByName('CODEMP').AsString := ADadosPedidos[lContador].strEmpDoc;

      LAtualizacao.ExecSQL;
    End;
  Finally
    FreeAndNil(LAtualizacao);
  End;
end;

