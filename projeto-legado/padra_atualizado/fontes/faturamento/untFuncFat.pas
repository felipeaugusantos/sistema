procedure TFatVenda.pSintetizaPedidosPagAnt;
  Var
    strChave : String;
    fltValRec: Double;
    fltAdtCli: Double;
    fltTotPed: Double;
    fltTotIte: Double;
    cdsDados: TUniClientDataSet;
begin
  If (Not fEmptyStr(strNumOrc)) And
     (Not fEmptyStr(strEspOrc)) And
     (Not fEmptyStr(strEmpOri)) And
     (Not fEmptyStr(strCodCli)) Then
  Begin
    strPorAdt  := TAdiantamento.fGetCodPorAdiantamento(strNumOrc, strEspOrc, strEmpOri, strCodCli);
    strCtaAdt  := TAdiantamento.fGetCodCtaAdiantamento(strNumOrc, strEspOrc, strEmpOri, strCodCli);
    strOpeAdt  := TAdiantamento.fGetOpeLanAdiantamento(strNumOrc, strEspOrc, strEmpOri, strCodCli);
  End;

  If (Not fProcessaPagamentoAntecipadoPedidos(Self.strOpcDoc)) Or (blnExpedi) Then
    Exit;

  cdsDados := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsDados, cdsVenda);
    pCriaDatasetPagAnt;

    cdsDados.First;
    While (Not cdsDados.Eof) Do
    Begin
      strChave := cdsDados.FieldByName('ITE_NUMORC').AsString +
                  cdsDados.FieldByName('ITE_ESPORC').AsString +
                  cdsDados.FieldByName('ITE_EMPORC').AsString;

      fltTotIte := 0;
      fltTotPed := cdsDados.FieldByName('ITE_TOTPED').AsFloat +
                   cdsDados.FieldByName('ITE_TOTDES').AsFloat -
                   cdsDados.FieldByName('ITE_TOTFRE').AsFloat;

      fltValRec := fTotalDuplicataQuitada(cdsDados.FieldByName('ITE_NUMORC').AsString,
                                          cdsDados.FieldByName('ITE_ESPORC').AsString,
                                          cdsDados.FieldByName('ITE_EMPORC').AsString,
                                          '');

      fltAdtCli  := TAdiantamento.fGetTotaisAdiantamento(
                                           cdsDados.FieldByName('ITE_NUMORC').AsString,
                                           cdsDados.FieldByName('ITE_ESPORC').AsString,
                                           cdsDados.FieldByName('ITE_EMPORC').AsString).fltValLan;

      strPorAdt  := TAdiantamento.fGetCodPorAdiantamento(
                                           cdsDados.FieldByName('ITE_NUMORC').AsString,
                                           cdsDados.FieldByName('ITE_ESPORC').AsString,
                                           cdsDados.FieldByName('ITE_EMPORC').AsString,
                                           strCodCli);

      strOpeAdt  := TAdiantamento.fGetOpeLanAdiantamento(
                                           cdsDados.FieldByName('ITE_NUMORC').AsString,
                                           cdsDados.FieldByName('ITE_ESPORC').AsString,
                                           cdsDados.FieldByName('ITE_EMPORC').AsString,
                                           strCodCli);

      strCtaAdt  := TAdiantamento.fGetCodCtaAdiantamento(
                                           cdsDados.FieldByName('ITE_NUMORC').AsString,
                                           cdsDados.FieldByName('ITE_ESPORC').AsString,
                                           cdsDados.FieldByName('ITE_EMPORC').AsString,
                                           strCodCli);

      While (Not cdsDados.Eof) And (strChave = cdsDados.FieldByName('ITE_NUMORC').AsString +
                                               cdsDados.FieldByName('ITE_ESPORC').AsString +
                                               cdsDados.FieldByName('ITE_EMPORC').AsString) Do
      Begin
        fltTotIte := fltTotIte + cdsDados.FieldByName('ITE_TOTITE').AsFloat + cdsDados.FieldByName('ITE_VALIPI').AsFloat;
        cdsDados.Next;
      End;

      cdsPagAnt.Append;

      cdsPagAnt.FieldByName('NUMDOC').AsString := cdsDados.FieldByName('ITE_NUMORC').AsString;
      cdsPagAnt.FieldByName('ESPDOC').AsString := cdsDados.FieldByName('ITE_ESPORC').AsString;
      cdsPagAnt.FieldByName('CODEMP').AsString := cdsDados.FieldByName('ITE_EMPORC').AsString;
      cdsPagAnt.FieldByName('BAIXAR').AsFloat  := fltTotIte;
      cdsPagAnt.FieldByName('TOTPED').AsFloat  := cdsDados.FieldByName('ITE_TOTPED').AsFloat;
      If fltTotPed > 0 Then
        cdsPagAnt.FieldByName('DUPREC').AsFloat  := fltValRec * (fltTotIte / fltTotPed)
      Else
        cdsPagAnt.FieldByName('DUPREC').AsFloat  := 0.00;
      cdsPagAnt.FieldByName('ADTCLI').AsFloat  := fltAdtCli;

      cdsPagAnt.Post;
    End;
  Finally
    FreeAndNil(cdsDados);
  End;
end;

procedure TFatVenda.pAtualizarDadosUltimaCompra;
begin
  If blnAlteraCliente Then//Evitar travamento do banco de dados (muitas vendas para consumidor)
    If (Pos('CONSUMIDOR', strCliOri) > 0) And (fDataUltimaCompraHoje) Then
      blnAlteraCliente := False;

  If Not blnAlteraCliente Then
    Exit;

  If fDocumentoParaFornecedor Then
    Exit;

  If blnImportacaoSpedPisCofins And Not Self.Fulfillment.EhOperacaoFulfillment Then
    Exit;

  //Tem que estar entre Try Except, pois essa função está fora da transação. (Duvidas falar com Alexandre)
  Try
    pAtualizaPriComCliente(Self.strCodCli, IIF(Self.Fulfillment.EhOperacaoFulfillment, Self.dtaDtaEnt, Self.VS_Date));
    pAtualizaUltComCliente(Self.strCodCli);
  Except
    On E: Exception Do
      If fInTransaction Then//Se esta em transacao lanca exception para tratar na funcao que invocou pAtualizarDadosUltimaCompra
        Raise
      Else
        pMensagensErro(E.Message, 'TFatVenda.pAtualizarDadosUltimaCompra');
  End;
end;

function TFatVenda.fExiDocUpdateTindorTindet(AExiDoc: String): Boolean;
Begin
  If (AExiDoc = 'OR') Or (AExiDoc = 'PD') Then
    Exit(False);

  If (AExiDoc = 'V') Or (AExiDoc = 'PA') Then
    Exit(False);

  Result := True;
End;

procedure TFatVenda.pAtualizarDevolucaoTindorTindet(strEspDoc: String;
                                                    strCodCli: String;
                                                    strNumDoc: String;
                                                    strCodEmp: String;
                                                    strCodItem: String;
                                                    strCodAca: String;
                                                    strEmpAca: String;
                                                    strCodVen: String;
                                                    blnProducaoForaDeLoja: Boolean);
var
  QryDev : TUniQuery;

  function fGetSQLTINDET():String;
  begin
    Result := 'UPDATE TINDET ' +
              '   SET DET_BAIXAD = ''1''   '+
              '     , DET_OPEBAI = :OPEBAI '+
              '     , DET_HORBAI = :HORBAI '+
              '     , DET_DTABAI = ' + fCurrentDate +
              ' WHERE DET_CODEMP = :CODEMP '+
              '   AND DET_ESPDOC = :ESPDOC '+
              '   AND DET_CODCLI = :CODCLI '+
              '   AND DET_NUMDOC = :NUMDOC '+
              '   AND DET_CODITE = :CODITE '+
              '   AND DET_EMPACA = :EMPACA '+
              '   AND DET_CODACA = :CODACA ';
  end;

  function fGetSQLTINDOR():String;
  begin
    Result := 'UPDATE TINDOR '+
              ' INNER JOIN FATDOR ON FATDOR.FDO_ESPDOC = TINDOR.FDO_ESPDOC '+
              '                  AND FATDOR.FDO_NUMDOC = TINDOR.FDO_NUMDOC '+
              '                  AND FATDOR.FDO_CODACA = TINDOR.FDO_CODACA '+
              '                  AND FATDOR.FDO_EMPACA = TINDOR.FDO_EMPACA '+
              '                  AND FATDOR.FDO_CODITE = TINDOR.FDO_CODITE '+
              '                  AND FATDOR.FDO_CODEMP = TINDOR.FDO_CODEMP '+
              '                  AND FATDOR.FDO_CODCLI = TINDOR.FDO_CODCLI '+
              '   SET FDO_BAIXAD =  ''1''  '+
              '     , FDO_OPEBAI = :OPEBAI '+
              '     , FDO_HORBAI = :HORBAI '+
              '     , FDO_DTABAI = ' + fCurrentDate +
              ' WHERE FATDOR.FDO_NUMFAT = :NUMDOC '+
              '   AND FATDOR.FDO_TIPFAT = :ESPDOC '+
              '   AND FATDOR.FDO_CODEMP = :CODEMP '+
              '   AND FATDOR.FDO_CODITE = :CODITE '+
              '   AND FATDOR.FDO_CODCLI = :CODCLI '+
              '   AND FATDOR.FDO_CODACA = :CODACA '+
              '   AND FATDOR.FDO_EMPACA = :EMPACA ';
  end;

  procedure pSetaParams();
  begin
    QryDev.ParamByName('NUMDOC').AsString := strNumDoc;
    QryDev.ParamByName('ESPDOC').AsString := strEspDoc;
    QryDev.ParamByName('CODEMP').AsString := strCodEmp;
    QryDev.ParamByName('CODITE').AsString := strCodItem;
    QryDev.ParamByName('CODCLI').AsString := strCodCli;
    QryDev.ParamByName('CODACA').AsString := strCodAca;
    QryDev.ParamByName('EMPACA').AsString := strEmpAca;

    QryDev.ParamByName('OPEBAI').AsString := strCodVen;
    QryDev.ParamByName('HORBAI').AsString := FormatDateTime('hh:mm:ss', fRetHoraServidor);
  end;

  procedure pExecSQL(strSQL:String);
  begin
    QryDev.Close;
    QryDev.SQL.Clear;
    QryDev.SQL.Add(strSQL);

    pSetaParams();

    Try
      QryDev.ExecSQL;
    Except On E: Exception Do
      pMensagensErro(E.Message, '');
    End;
  end;
begin
  QryDev := fCriaQuery;

  Try
    If (blnProducaoForaDeLoja) Or (fExiDocUpdateTindorTindet(fCfgSis('EXIDOC'))) Then
    Begin
      pExecSQL(fGetSQLTINDET);
      pExecSQL(fGetSQLTINDOR);
    End
    Else
    Begin
      If (fCfgSis('EXIDOC') = 'V') Or (fCfgSis('EXIDOC') = 'PA') Then
        pExecSQL(fGetSQLTINDET)
      Else
        pExecSQL(fGetSQLTINDOR);
    End;
  Finally
    FreeAndNil(QryDev);
  End;
end;

procedure TFatVenda.pAtualizarValorDuplicataBoletoAdiantamento(strNumDocPar, strEspDocPar, strCodEmpPar, strCodCliPar, strVlrDup: String);
Var
  qryAux: TUniQuery;
begin
  qryAux := fCriaQuery(Self);
  qryAux.SQL.Add('SELECT * FROM CADREC ');
  qryAux.SQL.Add('WHERE ');
  qryAux.SQL.Add('  CTR_NUMDUP = :NUMDUP AND ');
  qryAux.SQL.Add('  CTR_ESPDOC = :ESPDOC AND ');
  qryAux.SQL.Add('  CTR_CODEMP = :CODEMP AND ');

  If (Not fEmptyStr(strCodCliPar)) Then
    qryAux.SQL.Add('  CTR_CODCLI = :CODCLI AND ');

  qryAux.SQL.Add('  CTR_DTAREC IS NULL       ');

  qryAux.ParamByName('NUMDUP').AsString := strNumDocPar;
  qryAux.ParamByName('ESPDOC').AsString := strEspDocPar;
  qryAux.ParamByName('CODEMP').AsString := strCodEmpPar;

  If (Not fEmptyStr(strCodCliPar)) Then
    qryAux.ParamByName('CODCLI').AsString := strCodCliPar;

  qryAux.Open;

  qryAux.First;
  While Not qryAux.Eof Do
  Begin
    pGravaLogCtr(qryAux.FieldByName('CTR_NUMDUP').AsString,
                 qryAux.FieldByName('CTR_ESPDOC').AsString,
                 qryAux.FieldByName('CTR_CODCLI').AsString,
                 qryAux.FieldByName('CTR_CODEMP').AsString,
                 qryAux.FieldByName('CTR_PARCEL').AsString, 0,
                 'VALOR DUPLICATA ALTERADO PARA ' + strVlrDup,
                 strNomeForm);

    qryAux.Edit;
    qryAux.FieldByName('CTR_VALDUP').AsFloat := fStrToFloat(strVlrDup);
    qryAux.Post;

    pGravaLogCtr(qryAux.FieldByName('CTR_NUMDUP').AsString,
                 qryAux.FieldByName('CTR_ESPDOC').AsString,
                 qryAux.FieldByName('CTR_CODCLI').AsString,
                 qryAux.FieldByName('CTR_CODEMP').AsString,
                 qryAux.FieldByName('CTR_PARCEL').AsString, 0,
                 'ALTERACAO VALOR DA DUPLICATA ' + strVlrDup + ' ' +
                 strNumDocPar + '-' + strEspDocPar + '-' + strCodEmpPar, strNomeForm);

    qryAux.Next;
  End;

  FreeAndNil(qryAux);
end;

function TFatVenda.fRetConcretosDocMarcados(blnFiltrarSintetizados: Boolean = False): String;
  Var
    qryBusca: TUniQuery;
    strSql  : String;
begin

  Result := '';

  strSql := '';
  strSql := strSql + '                          ';
  strSql := strSql + '  SELECT                  ';
  strSql := strSql + '    DISTINCT TMP_TEMCCR   ';
  strSql := strSql + '  FROM                    ';
  strSql := strSql + '    '+ strTabelaConfMi +' ';
  strSql := strSql + '  WHERE                   ';
  strSql := strSql + '    TMP_MARDES = "M"      ';

  if blnFiltrarSintetizados then
    strSql := strSql + '  AND SAV_SINTET = "N"  ';

  strSql := strSql + '  ORDER BY                ';
  strSql := strSql + '    1                     ';

  qryBusca := fCriaQuery(Nil);

  With qryBusca Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSql);
    Open;

    While Not Eof Do
    Begin
      Result := Result + Fields[0].AsString;
      Next;
    End;

  End;

  FreeAndNil(qryBusca);

end;

