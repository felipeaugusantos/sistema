procedure TFatVenda.pGLogDes;
  Var
    intContador: Integer;
    objLogDes: TLogDes;
    strCodigoOperador: String;
begin
  objLogDes := TLogDes.Create;

  strCodigoOperador := strCodVen;
  For intContador := Low(arrMatItens) To High(arrMatItens) Do
  Begin

    If arrMatItens[intContador].strDesOri <> arrMatItens[intContador].strDesIte Then
    Begin
      If (strOpcDoc='EP') or
         (fEmptyStr(strCodigoOperador)) Then
        strCodigoOperador := strLoginUsuarioLogado;

      objLogDes.strCodOpe := strCodigoOperador;
      objLogDes.dtaDtaEnt := Self.VS_Date;
      objLogDes.horHorEnt := fTime();
      objLogDes.strNumDoc := strNumDoc;
      objLogDes.strEspDOc := strEspDoc;
      objLogDes.strCodEmp := VS_strCodEmp;
      objLogDes.strIdePro := arrMatItens[intContador].strIdePro;
      objLogDes.strCodIte := arrMatItens[intContador].strCodIte;
      objLogDes.strDesOri := arrMatItens[intContador].strDesOri;
      objLogDes.strDesNov := arrMatItens[intContador].strDesIte;

      objLogDes.pSalvar;
    End;

  End;

  FreeAndNil(objLogDes);

end;

