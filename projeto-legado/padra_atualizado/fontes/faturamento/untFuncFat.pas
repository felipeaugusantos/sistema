Procedure TFatVenda.pCriaCdsIteSin;
Begin
  If Assigned(cdsIteSin) Then
  Begin
    cdsIteSin.EmptyDataSet;
  End
  Else
  Begin  
    cdsIteSin := TUniClientDataSet.Create(Self);

    With cdsIteSin, FieldDefs Do
    Begin
      With AddFieldDef Do Begin Name := 'AUTINC'; DataType := ftInteger;            Required := False; End;
      With AddFieldDef Do Begin Name := 'INCCNF'; DataType := ftString; Size := 20; Required := False; End;
      With AddFieldDef Do Begin Name := 'ITECNF'; DataType := ftString; Size := 07; Required := False; End;
      With AddFieldDef Do Begin Name := 'DOCCNF'; DataType := ftString; Size := 12; Required := False; End;
      With AddFieldDef Do Begin Name := 'ESPCNF'; DataType := ftString; Size := 02; Required := False; End;
      With AddFieldDef Do Begin Name := 'EMPCNF'; DataType := ftString; Size := 03; Required := False; End;
      With AddFieldDef Do Begin Name := 'TOTITE'; DataType := ftFloat;              Required := False; End;      
      CreateDataSet;

      LogChanges := False;

      Open;
    End;
  End;
end;

Procedure TFatVenda.pCdsDocGerBeforePost(dtsDocGer: TDataSet);
Begin

  With dtsDocGer Do
  Begin
    If FieldByName('IMPSEP').AsBoolean And
       FieldByName('LIBPED').AsBoolean Then
    Begin
      pMensagemOk('É necessário liberar o pedido!');
      Cancel;
      Abort;
    End;
  End;
End;

Procedure TFatVenda.pIncluirDocumentoCdsDocGer(documento: TDadosImpressaoVenda);
Var  LstrPrgPor  : String;
Begin
  LstrPrgPor := fCfgSis('PRGPOR');
  With cdsDocGer Do
  Begin
    Insert;

    FieldByName('NUMDOC').AsString := documento.strNumDoc;
    FieldByName('ESPDOC').AsString := documento.strEspDoc;
    FieldByName('CODEMP').AsString := documento.strEmpDoc;
    FieldByName('VLRTOT').AsFloat  := documento.fltTotGer;
    FieldByName('SERIE_').AsString := documento.strSerFsc;
    FieldByName('CODCLI').AsString := documento.strCodCli;

    FieldByName('PRDAMO').AsBoolean := documento.blnImprimeAmostraVeiculo;

    If documento.strEspDoc = 'PD' Then
    Begin
      FieldByName('QTDVIA').AsInteger := fCfgSis('VIA_PD', varInteger, VS_strCodEmp);
      FieldByName('IMPRIM').AsBoolean := (FieldByName('QTDVIA').AsInteger > 0) And
                                         (Not documento.blnEntregaImediataEmNovoPedido) And
                                         (Not documento.blnRetiraOutraLojaEmNovoPedido) And
                                         (Not documento.blnRetiraMesmaLojaEmNovoPedido) And
                                         (Not documento.blnRetiraExpedicaoEmNovoPedido) And
                                         (Not documento.blnAbastecTransfReqEmNovoPedido) And
                                         (Not blnEmitirNovoPedidoEntregaCD);
    End
    Else If documento.strEspDoc = 'OR' Then
    Begin
      FieldByName('QTDVIA').AsInteger := 1;
      FieldByName('IMPRIM').AsBoolean := fCfgSis('IMPORC', varBoolean, VS_strCodEmp);
    End;

    If fCfgSis('ORCSPR', varBoolean, VS_strCodEmp) Then
    Begin
      FieldByName('IMPPRE').Visible := True;
      FieldByName('IMPTOT').Visible := True;
    End;

    If SameText('OR', documento.strEspDoc) Then
    Begin
      FieldByName('LIBPED').AsBoolean := False;
      FieldByName('IMPSEP').AsBoolean := objFatVendaImp.fVerificaSeImprimeSeparacao(documento);
      FieldByName('SEPVIA').AsInteger := 1;
      {*REQ.190889**********KM*}
      FieldByName('IMPTRM').Visible   := ((LstrPrgPor = '2') or (LstrPrgPor = '3'));
      FieldByName('IMPTRM').AsBoolean := FieldByName('IMPTRM').Visible;
    End
    Else If SameText('PD', documento.strEspDoc) Then
    Begin
      FieldByName('LIBPED').AsBoolean := fCfgSis('LIBPED', varBoolean, VS_strCodEmp);
      FieldByName('IMPSEP').AsBoolean := objFatVendaImp.fVerificaSeImprimeSeparacao(documento);
      FieldByName('SEPVIA').AsInteger := fCfgSis('QTDVSE', varInteger, VS_strCodEmp);
      {*REQ.190889**********KM*}
      FieldByName('IMPTRM').Visible   := ((LstrPrgPor = '1') or (LstrPrgPor = '3'));
      FieldByName('IMPTRM').AsBoolean := FieldByName('IMPTRM').Visible;
    End;

    FieldByName('IMPPRE').AsBoolean := True;
    FieldByName('IMPTOT').AsBoolean := True;

    Post;
  End;
End;

function TFatVenda.fExibirDocumentosGeradosOpcoesDeImpressao: Boolean;
begin
  Result := False;
  If (fExecutandoNovoFechamentoOrcamentoPedido) Then
    Exit;
  Result := True;
end;

procedure TFatVenda.pImprimePedidosDesmembrados;
  Var
    intCnt : Integer;
begin
  If (Not fExecutandoNovoFechamentoOrcamentoPedido) Then
    Exit;

  If (Not Assigned(Self.objPerguntasImpressaoDocumento)) And (Not Assigned(Self.objPerguntasImpressaoSeparacao)) Then
    Exit;

  For intCnt := 0 To Pred(objFatVendaImp.ItemsCount) Do
    objFatVendaImp.pImprimeDocumento(objFatVendaImp.Items[intCnt], Self.objPerguntasImpressaoDocumento, Self.objPerguntasImpressaoSeparacao);
end;

Procedure TFatVenda.pMostraDocumentosGerados;
  Var
    intIndex: Integer;
    imImpPdOr,
    imImpSep,
    imImpTermo : TDadosImprimePdOrSep;
    strDocumentos : String;
    strDocumento : String;
Begin
  If (Not fExibirDocumentosGeradosOpcoesDeImpressao) Then
  Begin
    strDocumentos := EmptyStr;
    cdsDocGer.First;
    While Not cdsDocGer.Eof Do
    Begin
      strDocumento := cdsDocGer.FieldByName('NUMDOC').AsString + '-' + cdsDocGer.FieldByName('ESPDOC').AsString + '-' + cdsDocGer.FieldByName('CODEMP').AsString;
      If fEmptyStr(strDocumentos) Then
        strDocumentos := strDocumento
      Else
        strDocumentos := strDocumentos + ', ' + strDocumento;
      cdsDocGer.Next;
    End;
    pNotificacaoSistemaSucesso(EmptyStr, 'Documentos Gerados:' + sLineBreak + strDocumentos, strOpcDoc);
    Exit;
  End;
  Try
    pCriarFormularios(TfrmFatPedidosImpr, frmFatPedidosImpr);

    With frmFatPedidosImpr Do
    Begin
      blnImprime := Pos(strOpcDoc,'PD_OR_') > 0;
      blnSepara  := blnImprime And cdsDocGer.Locate('IMPSEP', True, []);
      dtsDocumentos.DataSet := cdsDocGer;

      cdsDocGer.BeforePost := pCdsDocGerBeforePost;

      If ShowModal = mrOk Then
      Begin
        If (Not cdsDocGer.IsEmpty) And blnImprime Then
        Begin
          cdsDocGer.First;

          While Not cdsDocGer.Eof Do
          Begin
            For intIndex := 0 To objFatVendaImp.ItemsCount -1 Do
            Begin
              If (objFatVendaImp.Items[intIndex].strNumDoc = cdsDocGer.FieldByName('NUMDOC').AsString) And
                 (objFatVendaImp.Items[intIndex].strEspDoc = cdsDocGer.FieldByName('ESPDOC').AsString) And
                 (objFatVendaImp.Items[intIndex].strEmpDoc = cdsDocGer.FieldByName('CODEMP').AsString) And
                 (objFatVendaImp.Items[intIndex].strCodCli = strCodCli) Then
              Begin
                objFatVendaImp.blnPDORMultiLoja := True;

                {***************************************************************}
                {* ESSAS VARIAVEIS DEFINIE SE IRÁ OU NÃO IMPRIMIR O PD/OR/SEP  *}
                {* OBS: POR DEFAULT A FUNÇÃO pImprimeDocumento, JÁ VEM SETADO  *}
                {* imPerguntaSeImprime. AQUI NESTE CASO NÃO PRECISA PERGUNTAR, *}
                {* OU IMPRIME SE ESTIVER CONFIGURADO OU NÃO IMPRIME NADA.      *}
                {************************************************************FC*}
                imImpPdOr := TDadosImprimePdOrSep.Create;
                imImpPdOr.imImpDoc := imNaoImprime;
                imImpPdOr.intQtdVia := 0;

                imImpSep := TDadosImprimePdOrSep.Create;
                imImpSep.imImpDoc := imNaoImprime;
                imImpSep.intQtdVia := 0;

                imImpTermo := TDadosImprimePdOrSep.Create;
                imImpTermo.imImpDoc  := imNaoImprime;
                imImpTermo.intQtdVia := 0;

                If cdsDocGer.FieldByName('IMPRIM').AsBoolean And
                   (cdsDocGer.FieldByName('QTDVIA').AsInteger > 0) Then
                Begin
                  imImpPdOr.imImpDoc := imImprimeSemPergutar;
                  imImpPdOr.intQtdVia := cdsDocGer.FieldByName('QTDVIA').AsInteger;
                End;

                If cdsDocGer.FieldByName('IMPSEP').AsBoolean And
                   (cdsDocGer.FieldByName('SEPVIA').AsInteger > 0) Then
                Begin
                  imImpSep.imImpDoc := imImprimeSemPergutar;
                  imImpSep.intQtdVia := cdsDocGer.FieldByName('SEPVIA').AsInteger;
                End;

                If cdsDocGer.FieldByName('IMPTRM').AsBoolean Then
                Begin
                  imImpTermo.imImpDoc  := imImprimeSemPergutar;
                  imImpTermo.intQtdVia := 1;
                End;


                If (Not ((imImpPdOr.imImpDoc = imNaoImprime) And (imImpSep.imImpDoc = imNaoImprime) And (imImpTermo.imImpDoc = imNaoImprime))) Then
                  objFatVendaImp.pImprimeDocumento(objFatVendaImp.Items[intIndex], imImpPdOr, imImpSep, imImpTermo);

                FreeAndNil(imImpPdOr);
                FreeAndNil(imImpSep);
                FreeAndNil(imImpTermo);

                If Not cdsDocGer.FieldByName('PRDAMO').AsBoolean Then
                  Break;
              End;
            End;

            pProcessMessages;
            cdsDocGer.Next;
          End;
        End;
      End;

      cdsDocGer.BeforePost := nil;
    End;

    FreeAndNil(frmFatPedidosImpr);

  Except
    On E: Exception Do
    Begin
      pMensagensErro(E.Message, '[pMostraDocumentosGerados]');
    End;
  End;
End;

procedure TFatVenda.pExibirPanelFinalizacaoPedido(pnlEmpFat: TGroupBox; lblFinPed: TLabel;
  edtFinaliza: TEditFocus; strTipOpePar: String=''; blnEmitirBoletosAdt: Boolean = False);
  Var
    blnEntImediataPorGrupoProdutos: Boolean;
    blnEntImediataPorDataDeEntrega: Boolean;
    blnEntImediataPorDataDeEntregaComRotaPorPedido: Boolean;
    blnCliFilAux : Boolean;
    strTipOpeLoc: String;
begin
  pnlEmpFat.Visible := False;
  edtFinaliza.Enabled := True;
  edtFinaliza.Text    := '';

  blnFinaliEnabled := True;

  blnEntImediataPorGrupoProdutos := (Self.strCodFpg = '008') And (Not fConPagComEntrada(Self.strConPag)) And
                                    (Self.fSomenteItensEntregaImediata) And
                                    (Self.fEntregaImediataPorGrupoProdutos('S'));

  blnEntImediataPorDataDeEntrega := (fStatusCndPag(Self.strConPag) = A_PRAZO) And
                                    (Pos(Self.strCodFpg, '002_006_007') <= 0) And
                                    (Self.fSomenteItensEntregaImediata) And
                                    (Self.fEntregaImediataPorDataDeEntrega('S')) And
                                    (Self.fHaveraDesmembramentoPedidoPorDataDeEntrega);

  blnEntImediataPorDataDeEntregaComRotaPorPedido := (Self.fSomenteItensEntregaImediata) And
                                                    (Self.fEntregaImediataPorDataDeEntregaComRotaPorPedido) And
                                                    (Self.fHaveraDesmembramentoPedidoPorDataDeEntrega);

  pnlEmpFat.Caption := 'Finalização do ' + IIF(Self.strEspDoc = 'OR', 'Orçamento', 'Pedido') + ':';
  lblFinPed.Caption := 'Finalizar o ' + IIF(Self.strEspDoc = 'OR', 'orçamento', 'pedido') +
    ' e gerar ' + IIF(Self.strEspDoc = 'OR', 'orçamentos', 'pedidos') + ' para as lojas?';

  pnlEmpFat.Visible := Self.fPedidoMultiLoja(False, fEmptyStr(strTipOpePar));

  Self.blnDesmembraPedRegEsp := (Not blnCliFil) And (pnlEmpFat.Visible) And (fTemItemComEmpConfiguradaEmissaoRegimeEspecial);

  If Self.fPedidoMultiLoja(False, fEmptyStr(strTipOpePar)) And fCfgSis('EMPFVN', VarBoolean) Then
  Begin
    pnlEmpFat.Visible := False;

    If (blnCliFil) Then
    Begin
      pnlEmpFat.Visible   := True;
      edtFinaliza.Enabled := False;
      edtFinaliza.Text    := 'S';
    End
    Else
    If (Self.strEspDoc = 'OR') And (fCfgSis('ESPCFO', varString) = 'PD') Then
    Begin
      pnlEmpFat.Visible   := True;
      edtFinaliza.Enabled := (fCfgSis('FIOREN', varString) = 'S');
      edtFinaliza.Text    := '';
      If (fCfgSis('DSMBOR', varString) <> 'B') Then
        edtFinaliza.Text := fCfgSis('DSMBOR', varString);
    End
    Else
    //Caso nao desmembre pedidos automaticamente, deve desmembra os mesmos sempre pelo resumo de caixa
    If (Not fCfgSis('DESMPD', VarBoolean)) And (Not Self.blnCliFil) Then
    Begin
      pnlEmpFat.Visible   := True;
      edtFinaliza.Enabled := False;
      edtFinaliza.Text    := 'N';
    End
    //Imperio das tintas (utiliza replicacao)
    Else If Self.fSomenteItensParaEmpresasCD Then
    Begin
      If (Not fConPagComEntrada(Self.strConPag)) And (Pos(Self.strCodFpg, '008_010_012_014_015_') > 0) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := False;
        edtFinaliza.Text    := 'S';
      End;
    End
    //Hidromar (nao utiliza replicacao)
    Else If Self.fSomenteItensRetiraOutrasLojas Or
            Self.fSomenteItensEntregaImediataOutrasLojas Then
    Begin
      If (Not fConPagComEntrada(Self.strConPag)) And (Pos(Self.strCodFpg, '008_010_012_014_015_') > 0) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := (Not fCfgSis('SDESPD', varBoolean));
        edtFinaliza.Text    := 'S';
        If edtFinaliza.Enabled Then
        Begin
          If (fCfgSis('DSMBPD', varString) = 'B') Then
            edtFinaliza.Text := ''
          Else
            edtFinaliza.Text := fCfgSis('DSMBPD', varString);
        End;
      End
      Else If (fConPagComEntrada(Self.strConPag)) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := True;
        edtFinaliza.Text    := 'N';

        If Self.fSomenteItensRetiraOutrasLojas Then
          lblFinPed.Caption   := 'O pagamento será realizado na Emp. de Retira?'

        Else If Self.fSomenteItensEntregaImediataOutrasLojas Then
          lblFinPed.Caption   := 'O pagamento será realizado na Emp. de Entrega?';
      End;
    End                                         { Req: 132900 Hidromar }
    Else If Self.fSomenteItensOutrasLojas() And (Not Self.fTemEntregaFutura(Self.arrMatItens)) Then
    Begin
      If (Not fConPagComEntrada(Self.strConPag)) And (Pos(Self.strCodFpg, '008_014_015_') > 0) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := False;
        edtFinaliza.Text    := 'S';
      End
      Else If (fConPagComEntrada(Self.strConPag)) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := True;
        edtFinaliza.Text    := 'N';

        lblFinPed.Caption   := 'O pagamento será realizado na Emp. dos Itens?'
      End;
    End
    //Req 135091 Capifer
    Else If Self.fSomenteItensDeEmpresasCD Then
    Begin
      If (Not fConPagComEntrada(Self.strConPag)) And (Pos(Self.strCodFpg, '008_010_012_014_015_') > 0) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := False;
        edtFinaliza.Text    := 'S';
      End;
    End;
  End;

  If (Not pnlEmpFat.Visible) And (blnEntImediataPorGrupoProdutos Or blnEntImediataPorDataDeEntrega Or blnEntImediataPorDataDeEntregaComRotaPorPedido) Then
  Begin
    pnlEmpFat.Visible   := True;
    edtFinaliza.Enabled := True;
    edtFinaliza.Text    := 'S';

    If blnEntImediataPorDataDeEntrega Then
      lblFinPed.Caption   := 'Desmembrar o ' + IIF(Self.strEspDoc = 'PD', 'pedido', 'orçamento') + ' por data de entrega?'
    Else If blnEntImediataPorDataDeEntregaComRotaPorPedido Then
      lblFinPed.Caption   := 'Desmembrar o ' + IIF(Self.strEspDoc = 'PD', 'pedido', 'orçamento') + ' por data de entrega e informar as rotas?'
    Else
      lblFinPed.Caption   := 'Desmembrar o ' + IIF(Self.strEspDoc = 'PD', 'pedido', 'orçamento') + ' por grupo de produtos?';
  End;

  If (Not fEmptyStr(Self.strNumOrc)) And
     (Self.strEspOrc = 'PD') And
     (Self.strEspDoc = 'PD') And
     (fPedidoTemVinculo(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri)) Then
  Begin
    edtFinaliza.Text := 'N';
    edtFinaliza.Enabled := False;
  End;

  blnCliFilAux := False;
  If (blnCliFil) Then
  Begin
    //Cenário Baratão Req.: 162831
    If (Not fEmptyStr(Self.strEmp_TE)) And (VS_strCodEmp <> Self.strEmp_TE) And (Not pnlEmpFat.Visible) And (Not blnEnt_Cd) Then
    Begin
       If (Not Assigned(objSolColorantesTE)) And
          (Not Assigned(objSoliTE)) And
          (Not fRealizaGeracao_TE_RQ_MultiLoja) Then
       Begin
         If (fSomenteItensParaEmpresasCD) And (fTemItensEmpresaCD) Then
         Begin
           blnCliFilAux := True;
         End;
       End;
    End;
  End;

  If Self.fPedidoMultiLoja(blnCliFilAux, fEmptyStr(strTipOpePar)) And ((Self.strEspDoc = 'PD') Or (Self.strEspDoc = 'OR')) Then
  Begin

    If (blnCliFil) Then
    Begin
      pnlEmpFat.Visible   := True;
      edtFinaliza.Enabled := False;
      edtFinaliza.Text    := 'S';
    End
    {Req.: 91259}
    Else If fEhCondicaoAVistaParaDesmembramento Then
    Begin
      If fCfgSis('DESAVI', VarBoolean) Then
      Begin
        pnlEmpFat.Visible   := True;
        edtFinaliza.Enabled := True;

        If Self.strEspDoc = 'OR' Then
        Begin
          If (fCfgSis('DSMBOR', varString) = 'B') Then
            edtFinaliza.Text := ''
          Else
            edtFinaliza.Text := fCfgSis('DSMBOR', varString);
        End
        Else
        Begin
          If (fCfgSis('DSMBPD', varString) = 'B') Then
            edtFinaliza.Text := ''
          Else
            edtFinaliza.Text := fCfgSis('DSMBPD', varString);
        End;
      End
      Else
      Begin
        If (Not fEmptyStr(strTipOpePar)) Then
          strTipOpeLoc := strTipOpePar
        Else
          strTipOpeLoc := Self.strTipOpe;
          
        If (strTipOpeLoc = 'B') Then
        Begin
          pnlEmpFat.Visible   := True;
          edtFinaliza.Enabled := True;
          edtFinaliza.Text    := 'S';
        End
        Else
        Begin
          pnlEmpFat.Visible   := True;
          edtFinaliza.Enabled := False;
          edtFinaliza.Text    := 'N';
        End;
      End;
    End;
  End;

  {Req.: 115533}
  If Self.fPedidoMultiLoja(False, fEmptyStr(strTipOpePar)) And (Self.strEspDoc = 'OR') And fCfgSis('SLTFRC', varBoolean) Then
  Begin
    pnlEmpFat.Visible   := False;
    edtFinaliza.Enabled := False;
    edtFinaliza.Text    := 'N';
  End;

  If (pnlEmpFat.Visible) And
     (edtFinaliza.Enabled) And
     (fEmptyStr(edtFinaliza.Text)) And
     (fCfgSis('DSMBPD', varString) <> 'B') And
     (Self.strEspDoc = 'PD') Then
  Begin
    edtFinaliza.Text := fCfgSis('DSMBPD', varString);
  End;

  If (pnlEmpFat.Visible) And
     (edtFinaliza.Enabled) And
     (fEmptyStr(edtFinaliza.Text)) And
     (fCfgSis('DSMBOR', varString) <> 'B') And
     (Self.strEspDoc = 'OR') Then
  Begin
    edtFinaliza.Text := fCfgSis('DSMBOR', varString);
  End;

  If (Self.strEspDoc = 'PD') And
     (Not pnlEmpFat.Visible) And
     (fDesmembraAutomaticamentePedidoAPrazo(Self.strEspDoc)) Then
  Begin
    pnlEmpFat.Visible   := True;
    edtFinaliza.Enabled := True;

    If (fCfgSis('DSMBPD', varString) = 'B') Then
      edtFinaliza.Text := ''
    Else
      edtFinaliza.Text := fCfgSis('DSMBPD', varString);

    lblFinPed.Caption := 'Desmembrar o pedido?';
  End;

  if pnlEmpFat.Visible and fDesmembrarPedidoAPrazo then
  begin
    edtFinaliza.Enabled := False;
    edtFinaliza.Text := 'S';
  end
  Else If (pnlEmpFat.Visible)         And
          (fPedidoAPrazoComEntrada()) And
          (Not fUsaRotinaWMS())       Then
  Begin
    edtFinaliza.Enabled := False;
    edtFinaliza.Text := 'N';
  End;

  if ((blnAbastecimentoDeposito) And
      (fStatusCndPag(strConPag) = A_PRAZO) And
      (blnEmitirBoletosAdt)) or
     ((Pos(strEspDoc, 'PD_FF_IF_NF_') > 0) And
      (fCfgSis('CDTCLV', varBoolean)) And
      (pnlEmpFat.Visible)) Then
    edtFinaliza.Text := 'S';

  If (Self.strEspDoc = 'PD') And
     (pnlEmpFat.Visible) And
     (Self.fTemEntregaFutura(Self.arrMatItens)) Then
  Begin
    If fCfgSis('MLPDCX', varBoolean) Then
    Begin
      pnlEmpFat.Enabled := False;
      edtFinaliza.Text  := 'N';
    End;
  End;

  If (Self.fPedidoMultiLoja(False, fEmptyStr(strTipOpePar))) And
     (fCfgSis('EMPFVN', VarBoolean)) And
     (fCfgSis('DESAVI', VarBoolean)) And
     (fCfgSis('DMDTRT', VarBoolean)) And
     (fStatusCndPag(Self.strConPag) = A_VISTA) And
     (strEspDoc = 'PD') Then
  Begin
    If (Self.fSomenteItensRetiraOutrasLojas) Or
       (fPossuiItensEmpresaLogadaEMultiLojaApenasRetira) Then
      edtFinaliza.Enabled := pnlEmpFat.Visible

    Else If (Self.fSomenteItensEntregaImediataOutrasLojas) Or
            (fPossuiItensMultiLojaComDestinoEntrega) Then
    Begin
      edtFinaliza.Enabled := False;
      edtFinaliza.Text    := 'N';
    End;
  End;

  If (blnAbastecimentoDeposito) And
     (fCfgSis('ABADEP', VarBoolean)) And
     (strEspDoc = 'PD') Then
  Begin
    edtFinaliza.Enabled := False;
    edtFinaliza.Text    := 'S';
  End;

end;

function TFatVenda.fEnviarDocumentosLibNfe(pgbProgresso: TCxProgressBar = nil): Boolean;
  Var
    intCnt : Integer;
    lblProgresso: TLabel;
begin
  lblProgresso := nil;
  if Assigned(pgbProgresso) then
    lblProgresso := TLabel(GetParentForm(pgbProgresso).FindComponent('lblGravando'));

  pProgresso(0, 0, pgbProgresso);

  Result := True;

  If (Length(FDocumentosParaEnvioNaLibNfe) = 0) Then
    Exit;

  For intCnt := Low(FDocumentosParaEnvioNaLibNfe) To High(FDocumentosParaEnvioNaLibNfe) Do
  Begin
    fEnviarNotaLibNfe(FDocumentosParaEnvioNaLibNfe[intCnt].strNumDoc,
                      FDocumentosParaEnvioNaLibNfe[intCnt].strEspDoc,
                      FDocumentosParaEnvioNaLibNfe[intCnt].strCodEmp,
                      FDocumentosParaEnvioNaLibNfe[intCnt].strSerie_,
                      FDocumentosParaEnvioNaLibNfe[intCnt].strCodCli,
                      FDocumentosParaEnvioNaLibNfe[intCnt].strTip_FC,
                      lblProgresso);
  End;
end;

procedure TFatVenda.pAddDocumentoParaDisparoDeGatilho;
begin
  SetLength(arrDocDisparo, Length(arrDocDisparo)+1);
  arrDocDisparo[Length(arrDocDisparo)-1].strNumDoc := Self.strNumDoc;
  arrDocDisparo[Length(arrDocDisparo)-1].strEspDoc := Self.strEspDoc;
  arrDocDisparo[Length(arrDocDisparo)-1].strCodEmp := IIF(Self.blnFinali, Self.strPedEmp, IIF((Not fOrcamentoOutraLojaF11) Or (fEmpresaLogadaEhAEmpresaResponsavelPeloFaturamentoDosProdutos), Self.strPedEmp, IIF(fEmptyStr(Self.strEmpOri), Self.strPedEmp, IIF((Self.strEspDoc <> Self.strEspOrc), Self.strPedEmp, Self.strEmpOri))));
  arrDocDisparo[Length(arrDocDisparo)-1].strCodCli := Self.strCodCli;
  arrDocDisparo[Length(arrDocDisparo)-1].strOpcDoc := Self.strOpcDoc;
  arrDocDisparo[Length(arrDocDisparo)-1].strNumOrc := Self.strNumOrc;
  arrDocDisparo[Length(arrDocDisparo)-1].strEspOrc := Self.strEspOrc;
  arrDocDisparo[Length(arrDocDisparo)-1].QrCodePix := Self.DadosPixDaVenda.QrCodePix;
  arrDocDisparo[Length(arrDocDisparo)-1].LinkCitel := Self.DadosPixDaVenda.LinkCitel;
  arrDocDisparo[Length(arrDocDisparo)-1].strAutIncFatGor := Self.strAutIncFatGor;
end;

procedure TFatVenda.pAddDocumentosParaEnvioNaLibNfe(const strNumDoc, strEspDoc, strCodEmp, strCodCli, strSerie, strTipFc: String);
begin
  SetLength(FDocumentosParaEnvioNaLibNfe, Succ(Length(FDocumentosParaEnvioNaLibNfe)));
  FDocumentosParaEnvioNaLibNfe[Pred(Length(FDocumentosParaEnvioNaLibNfe))].strNumDoc := strNumDoc;
  FDocumentosParaEnvioNaLibNfe[Pred(Length(FDocumentosParaEnvioNaLibNfe))].strEspDoc := strEspDoc;
  FDocumentosParaEnvioNaLibNfe[Pred(Length(FDocumentosParaEnvioNaLibNfe))].strCodEmp := strCodEmp;
  FDocumentosParaEnvioNaLibNfe[Pred(Length(FDocumentosParaEnvioNaLibNfe))].strCodCli := strCodCli;
  FDocumentosParaEnvioNaLibNfe[Pred(Length(FDocumentosParaEnvioNaLibNfe))].strSerie_ := strSerie;
  FDocumentosParaEnvioNaLibNfe[Pred(Length(FDocumentosParaEnvioNaLibNfe))].strTip_FC := strTipFc;
end;

procedure TFatVenda.pLimparListaDeEnvioLibNfe;
begin
  SetLength(FDocumentosParaEnvioNaLibNfe, 0);
end;

function TFatVenda.fDesmembraAutomaticamentePedidoAPrazo(const AEspDoc: String): Boolean;
begin
  Result := False;

  If (AEspDoc <> 'PD') Then
    Exit;

  If (Not fCfgSis('DESMPD', VarBoolean)) Then
    Exit;

  If (fTemNecessidadeDePassarNoCaixaParaDesmembrarPedido) Then
    Exit;

  If (Not fHaveraDesmembramentoVenda(arrMatItens)) Then
    Exit;

  Result := True;
end;

function TFatVenda.fDesmembraAutomaticamentePedidoOrcamento(const AEspDoc: String): Boolean;
begin
  Result := False;

  If ((AEspDoc <> 'PD') And (AEspDoc <> 'OR')) Then
    Exit;

  If (Not fHaveraDesmembramentoVenda(arrMatItens)) Then
    Exit;

  Result := True;
end;


procedure TFatVenda.pExibirPanelLiberacaoPedido(pnlLiberacaoPedido: TWinControl;
  chkAgdLib: TCheckBox; edtMotLib: TEditFocus);
begin
  pnlLiberacaoPedido.Visible := False;

  If fCfgSis('LIBPED', varBoolean) And ((Self.strOpcDoc = 'PD') Or (Self.strOpcDoc = 'OR') And (Self.strEspDoc = 'PD')) Then
  Begin
    {**************************************************}
    { AGUARDAR LIBERAÇÃO DA GERÊNCIA PARA PEDIDOS BONS }
    {***********************************************RV*}
    If (fCfgSis('LPPDBL') = 'S') And (Not Self.fPedidoBloqueado) And ((Self.strOpcDoc = 'PD') Or (Self.strOpcDoc = 'OR') And (Self.strEspDoc = 'PD')) Then
    Begin
      pnlLiberacaoPedido.Visible := (fCfgSis('AGDLIB', VarBoolean));
    End;

    chkAgdLib.Checked := IIF(Not fEmptyStr(Self.strNumOrc) And Self.blnPedBlo And (Self.strTipOpe <> 'B') And pnlLiberacaoPedido.Visible, True, False);
    edtMotLib.Text    := Self.strMotBlo;

    {******************************************************}
    { AGUARDAR LIBERAÇÃO DA GERÊNCIA PARA TODOS OS PEDIDOS }
    {***************************************************RV*}
    If fCfgSis('AGDLBT', VarBoolean) Then
    Begin
      pnlLiberacaoPedido.Visible := True;
      pnlLiberacaoPedido.Enabled := False;
      edtMotLib.Enabled := False;
      edtMotLib.Text    := 'AGUARDANDO LIBERAÇÃO DA GERÊNCIA...';

      chkAgdLib.Checked := Not (fClienteConsumidor(Self.strCliOri, True, True) And (fStatusCndPag(Self.strConPag) = A_VISTA));
    End;

  End;

  If pnlLiberacaoPedido.Visible And Self.fTemProdutosComMargemEmDinheiroNegativa Then
  Begin
    chkAgdLib.Checked := True;
    chkAgdLib.Enabled := False;
    edtMotLib.Enabled := False;
    edtMotLib.Text    := 'MARGEM NEGATIVA';
  End;
end;

procedure TFatVenda.pDesmembrarMatrizItensProdutosRastreaveisWMS;
  Var
    itemPedido: TDadosFechamento;
    itensNovos: TMatrizFechamento;
    intIdxItem: Integer;
    qryLotDor : TUniQuery;

    fltTotIteAcu : Double;
    fltTotCusAcu : Double;
    fltTotCu2Acu : Double;
    fltTotMedAcu : Double;
    fltTotUltAcu : Double;
    fltTotImpAcu : Double;
    fltDesEspAcu : Double;
    fltValFreAcu : Double;
    fltDesAceAcu : Double;

    fltPercentual: Double;

    procedure pAddItemNovo;
    Begin
      SetLength(itensNovos, Length(itensNovos) + 1 );
      itensNovos[High(itensNovos)] := itemPedido;
      itensNovos[High(itensNovos)].intAutInc := High(itensNovos) + 1;
    End;

Begin
  If Not fUsaRotinaWMS Then
    Exit;

  qryLotDor := fCriaQuery(Self);
  Try
    With qryLotDor, SQL Do
    Begin
      Close;
      Clear;

      Add(' SELECT SQL_NO_CACHE        ');
      Add('        LDO_NUMLOT,         ');
      Add('        LDO_QTDITE          ');
      Add(' FROM LOTDOR                ');
      Add(' WHERE LDO_SEQFDO = :SEQFDO ');

    End;

    Self.blnExpedicaoTeveQuebraDeItensRastreaveis := False;
    SetLength(itensNovos,0);
    For itemPedido in Self.arrMatItens Do
    Begin

      If fProdutoRastreavel(itemPedido.strCodIte) Then
      Begin
        qryLotDor.Close;
        qryLotDor.ParamByName('SEQFDO').AsString := itemPedido.strSeqDet;
        qryLotDor.Open;

        If Not qryLotDor.IsEmpty Then
        Begin
          fltTotIteAcu := 0.00;
          fltTotCusAcu := 0.00;
          fltTotCu2Acu := 0.00;
          fltTotMedAcu := 0.00;
          fltTotUltAcu := 0.00;
          fltTotImpAcu := 0.00;
          fltDesEspAcu := 0.00;
          fltValFreAcu := 0.00;
          fltDesAceAcu := 0.00;

          qryLotDor.First;
          While Not qryLotDor.Eof Do
          Begin
            pAddItemNovo;
            itensNovos[High(itensNovos)].strNumLot := qryLotDor.FieldByName('LDO_NUMLOT').AsString;

            If qryLotDor.RecNo <> qryLotDor.RecordCount Then
            Begin
              Self.blnExpedicaoTeveQuebraDeItensRastreaveis := True;

              fltPercentual := qryLotDor.FieldByName('LDO_QTDITE').AsFloat / itensNovos[High(itensNovos)].fltQtdIte * 100;

              itensNovos[High(itensNovos)].fltQtdIte := qryLotDor.FieldByName('LDO_QTDITE').AsFloat;

              itensNovos[High(itensNovos)].fltTotIte := fFormataFloat( itensNovos[High(itensNovos)].fltTotIte * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltTotCus := fFormataFloat( itensNovos[High(itensNovos)].fltTotCus * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltTotCu2 := fFormataFloat( itensNovos[High(itensNovos)].fltTotCu2 * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltTotMed := fFormataFloat( itensNovos[High(itensNovos)].fltTotMed * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltTotUlt := fFormataFloat( itensNovos[High(itensNovos)].fltTotUlt * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltTotImp := fFormataFloat( itensNovos[High(itensNovos)].fltTotImp * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltDesEspExp := fFormataFloat( itensNovos[High(itensNovos)].fltDesEspExp * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltValFreExp := fFormataFloat( itensNovos[High(itensNovos)].fltValFreExp * fltPercentual / 100, 2);
              itensNovos[High(itensNovos)].fltDesAceExp := fFormataFloat( itensNovos[High(itensNovos)].fltDesAceExp * fltPercentual / 100, 2);

              fltTotIteAcu := fltTotIteAcu + itensNovos[High(itensNovos)].fltTotIte;
              fltTotCusAcu := fltTotCusAcu + itensNovos[High(itensNovos)].fltTotCus;
              fltTotCu2Acu := fltTotCu2Acu + itensNovos[High(itensNovos)].fltTotCu2;
              fltTotMedAcu := fltTotMedAcu + itensNovos[High(itensNovos)].fltTotMed;
              fltTotUltAcu := fltTotUltAcu + itensNovos[High(itensNovos)].fltTotUlt;
              fltTotImpAcu := fltTotImpAcu + itensNovos[High(itensNovos)].fltTotImp;
              fltDesEspAcu := fltDesEspAcu + itensNovos[High(itensNovos)].fltDesEspExp;
              fltValFreAcu := fltValFreAcu + itensNovos[High(itensNovos)].fltValFreExp;
              fltDesAceAcu := fltDesAceAcu + itensNovos[High(itensNovos)].fltDesAceExp;
            End
            Else
            Begin
              itensNovos[High(itensNovos)].fltQtdIte := qryLotDor.FieldByName('LDO_QTDITE').AsFloat;

              itensNovos[High(itensNovos)].fltTotIte := fFormataFloat( itensNovos[High(itensNovos)].fltTotIte - fltTotIteAcu, 2);
              itensNovos[High(itensNovos)].fltTotCus := fFormataFloat( itensNovos[High(itensNovos)].fltTotCus - fltTotCusAcu, 2);
              itensNovos[High(itensNovos)].fltTotCu2 := fFormataFloat( itensNovos[High(itensNovos)].fltTotCu2 - fltTotCu2Acu, 2);
              itensNovos[High(itensNovos)].fltTotMed := fFormataFloat( itensNovos[High(itensNovos)].fltTotMed - fltTotMedAcu, 2);
              itensNovos[High(itensNovos)].fltTotUlt := fFormataFloat( itensNovos[High(itensNovos)].fltTotUlt - fltTotUltAcu, 2);
              itensNovos[High(itensNovos)].fltTotImp := fFormataFloat( itensNovos[High(itensNovos)].fltTotImp - fltTotImpAcu, 2);
              itensNovos[High(itensNovos)].fltDesEspExp := fFormataFloat( itensNovos[High(itensNovos)].fltDesEspExp - fltDesEspAcu, 2);
              itensNovos[High(itensNovos)].fltValFreExp := fFormataFloat( itensNovos[High(itensNovos)].fltValFreExp - fltValFreAcu, 2);
              itensNovos[High(itensNovos)].fltDesAceExp := fFormataFloat( itensNovos[High(itensNovos)].fltDesAceExp - fltDesAceAcu, 2);
            End;

            qryLotDor.Next;
          End;

        End
        Else
        Begin
          pAddItemNovo;
        End;

      End
      Else
      Begin
        pAddItemNovo;
      End;

    End;

    //Copia o Array Novo para a Matriz do Self
    SetLength(Self.arrMatItens,0);
    SetLength(Self.arrMatItens, Length(itensNovos) );
    For intIdxItem := Low(itensNovos) To High(itensNovos) Do
      Self.arrMatItens[intIdxItem] := itensNovos[intIdxItem];

  Finally
    FreeAndNil(qryLotDor);
  End;
end;

procedure TFatVenda.pSintetizarElementosDoDesmembramento(var stlEmpresas : TStringList; var stlGrupoProdutos : TStringList; var stlDatasEntrega : TStringList);
  Var
    intIndice : Integer;
begin
  cdsVenda.First;
  While Not cdsVenda.Eof Do
  Begin
    If Not stlEmpresas.Find(cdsVenda.FieldByName('ITE_EMPITE').AsString, intIndice) Then
      stlEmpresas.Add(cdsVenda.FieldByName('ITE_EMPITE').AsString);

    If Not stlGrupoProdutos.Find(cdsVenda.FieldByName('ITE_PRDGRU').AsString, intIndice) Then
      stlGrupoProdutos.Add(cdsVenda.FieldByName('ITE_PRDGRU').AsString);

    If (cdsVenda.FieldByName('ITE_ENTRET').AsString = 'E') And (cdsVenda.FieldByName('ITE_ENTFUT').AsString = 'N') And (cdsVenda.FieldByName('ITE_DTENTR').AsDateTime <> 0) Then
    Begin
      If Not stlDatasEntrega.Find(DateToStr(cdsVenda.FieldByName('ITE_DTENTR').AsDateTime), intIndice) Then
        stlDatasEntrega.Add(DateToStr(cdsVenda.FieldByName('ITE_DTENTR').AsDateTime));
    End;

    cdsVenda.Next;
  End;
End;

procedure TFatVenda.pGerarMatrizesItensPorEmpresaCD(Var arrMatrizesFechamento : TMatrizesFechamento; Var blnMatrizComProdutoDeBrinde : Boolean);
  Var
    intIndMatriz : Integer;
    objDesmembrar : TDesmembrarMatrizItens;
begin
  objDesmembrar := TDesmembrarMatrizItens.Create(Self.arrMatItens, Self.FRecSer,
    fEntregaImediataPorGrupoProdutos('S'), fEntregaImediataPorDataDeEntrega('S'),
    fEntregaImediataPorDataDeEntregaComRotaPorPedido,
    False, Self.blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC);
  Try
    objDesmembrar.blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    objDesmembrar.pDesmembrarMatrizItens;

    SetLength(arrMatrizesFechamento, 0);

    For intIndMatriz := 0 To Length(objDesmembrar.MatrizesItens) -1 Do
      pAddMatrizFechamento(objDesmembrar.MatrizesItens[intIndMatriz], arrMatrizesFechamento);

    If (Not blnMatrizComProdutoDeBrinde) Then
      blnMatrizComProdutoDeBrinde := objDesmembrar.fTemMatrizDoTipo(matDesProdutoDeBrinde);
  Finally
    FreeAndNil(objDesmembrar);
  End;
end;

procedure TFatVenda.pGerarMatrizesDesmembramentoPadrao(Var arrMatrizesFechamento : TMatrizesFechamento; Var blnMatrizComProdutoDeBrinde : Boolean);
  Var
    blnEntImediataPorGrupoProdutos: Boolean;
    blnEntImediataPorDataDeEntrega: Boolean;
    blnEntImediataPorDataDeEntregaComRotaPorPedido: Boolean;
    intIndMatriz : Integer;
    objDesmembrar: TDesmembrarMatrizItens;
begin
  blnEntImediataPorGrupoProdutos := (Self.strCodFpg = '008') And (Not fConPagComEntrada(Self.strConPag)) And
                                    (fSomenteItensEntregaImediata) And
                                    (fEntregaImediataPorGrupoProdutos('S'));

  blnEntImediataPorDataDeEntrega := (fStatusCndPag(Self.strConPag) = A_PRAZO) And
                                    (Pos(Self.strCodFpg, '002_006_007') <= 0) And
                                      (fSomenteItensEntregaImediata) And
                                      (fEntregaImediataPorDataDeEntrega('S'));

  blnEntImediataPorDataDeEntregaComRotaPorPedido := (fSomenteItensEntregaImediata) And
                                                    (fEntregaImediataPorDataDeEntregaComRotaPorPedido);

  objDesmembrar := TDesmembrarMatrizItens.Create(Self.arrMatItens, Self.FRecSer,
    blnEntImediataPorGrupoProdutos, blnEntImediataPorDataDeEntrega,
    blnEntImediataPorDataDeEntregaComRotaPorPedido,
    False, Self.blnDesmembraPedRegEsp, EmptyStr, fDesmembrarPorCFG_ITEDOC);
  Try
    objDesmembrar.blnVerificaDesmembramentoLimiteExcedidoLivro := fPermiteDesmembramentoLimiteExcedidoLivro;
    objDesmembrar.pDesmembrarMatrizItens;

    SetLength(arrMatrizesFechamento, 0);

    For intIndMatriz := 0 To Length(objDesmembrar.MatrizesItens) -1 Do
      pAddMatrizFechamento(objDesmembrar.MatrizesItens[intIndMatriz], arrMatrizesFechamento);

    If (Not blnMatrizComProdutoDeBrinde) Then
      blnMatrizComProdutoDeBrinde := objDesmembrar.fTemMatrizDoTipo(matDesProdutoDeBrinde)
  Finally
    FreeAndNil(objDesmembrar);
  End;
end;

procedure TFatVenda.pGerarMatrizesItensPorEmpresa(Var arrMatrizesFechamento : TMatrizesFechamento; const stlDatasEntrega : TStringList; const stlGrupoProdutos : TStringList; const stlEmpresas : TStringList);
  Const
    arrSelAbastecimento: Array[0..1] Of Boolean = (True, False);
    arrRegimeEspecial: Array[0..1] Of Boolean = (True, False);
    arrCilindroVasilhame: Array[0..1] Of Boolean = (False, True);
    arrOpcoesAbastecimento: Array[0..3] Of TOpcaoAbastecimentoItem = (oaSolicitTransf, oaReqCompra, oaEstoque, oaTodos);
  Var
    intEmpresa: Integer;
    intCnt: Integer;
    objFilterMat: TFilterMatrizItens;
    objFiltersItem: TFiltersItem;
    blnEntImediataPorGrupoProdutos: Boolean;
    blnEntImediataPorDataDeEntrega: Boolean;
    blnRegimeEspecial: Boolean;
    blnCilindroVasilhame: Boolean;
    blnSelAbs: Boolean;
    opcTipAbs: TOpcaoAbastecimentoItem;
begin
  blnEntImediataPorGrupoProdutos := (Self.strCodFpg = '008') And (Not fConPagComEntrada(Self.strConPag)) And
                                    (fSomenteItensEntregaImediata) And
                                    (fEntregaImediataPorGrupoProdutos('S'));

  blnEntImediataPorDataDeEntrega := (fStatusCndPag(Self.strConPag) = A_PRAZO) And
                                    (Pos(Self.strCodFpg, '002_006_007') <= 0) And
                                    (fSomenteItensEntregaImediata) And
                                    (fEntregaImediataPorDataDeEntrega('S'));

  SetLength(arrMatrizesFechamento, 0);

  objFilterMat   := TFilterMatrizItens.Create(Self.arrMatItens);
  objFiltersItem := TFiltersItem.Create;

  For intEmpresa := 0 To stlEmpresas.Count - 1 Do
    For opcTipAbs In arrOpcoesAbastecimento Do
      For blnSelAbs In arrSelAbastecimento Do
        For blnRegimeEspecial In arrRegimeEspecial Do
          For blnCilindroVasilhame In arrCilindroVasilhame Do
            With objFilterMat, objFiltersItem Do
            Begin
              strEmpresaItem := stlEmpresas[intEmpresa];

              {******************************************************}
              {* Define se foi selecionado na tela de abastecimento *}
              {***************************************************JC*}
              blnSelAbastecimento := blnSelAbs;

              {***********************************}
              {* Define se é regime especial *}
              {********************************JC*}
              blnRegEsp := blnRegimeEspecial;
              blnDesmembraRegEsp := Self.blnDesmembraPedRegEsp;

              {**********************************}
              {* Define se é cilindro/vasilhame *}
              {*******************************WL*}
              blnCilVas := blnCilindroVasilhame;

              {*************************}
              {* Tipo de abastecimento *}
              {*************************}
              opcAbastecimento := opcTipAbs;

              If (blnEntImediataPorDataDeEntrega) And (stlDatasEntrega.Count > 1) Then
              Begin
                For intCnt := 0 To stlDatasEntrega.Count - 1 Do
                Begin
                  dtaDtEntr := StrToDateDef(stlDatasEntrega[intCnt], 0);

                  pDesfazerFiltros;

                  fFiltrar(fFiltraEmpresa).
                    fFiltrar(fFiltraSelAbastecimento).
                      fFiltrar(fFiltraOpcAbastecimento).
                        fFiltrar(fFiltraRegimeEspecial).
                          fFiltrar(fFiltraDataEntrega).
                            fFiltrar(fFiltraCilindroVasilhame);

                  pAddMatrizFechamento(MatrizItens, arrMatrizesFechamento);
                End;
              End
              Else If Not blnEntImediataPorGrupoProdutos Then
              Begin
                pDesfazerFiltros;

                fFiltrar(fFiltraEmpresa).
                  fFiltrar(fFiltraSelAbastecimento).
                    fFiltrar(fFiltraOpcAbastecimento).
                      fFiltrar(fFiltraRegimeEspecial).
                        fFiltrar(fFiltraCilindroVasilhame);

                pAddMatrizFechamento(MatrizItens, arrMatrizesFechamento);
              End
              Else
              Begin
                For intCnt := 0 To stlGrupoProdutos.Count - 1 Do
                Begin
                  strGrupoProdutos := stlGrupoProdutos[intCnt];

                  pDesfazerFiltros;

                  fFiltrar(fFiltraEmpresa).
                    fFiltrar(fFiltraSelAbastecimento).
                      fFiltrar(fFiltraOpcAbastecimento).
                        fFiltrar(fFiltraRegimeEspecial).
                          fFiltrar(fFiltraGrupoProdutos).
                            fFiltrar(fFiltraCilindroVasilhame);

                  pAddMatrizFechamento(MatrizItens, arrMatrizesFechamento);
                End;
              End;
            End;

  objFilterMat.Destroy;
  objFiltersItem.Destroy;
end;

procedure TFatVenda.pAddMatrizFechamento(const matriz: TMatrizFechamento; var arrMatrizesFechamento : TMatrizesFechamento);
begin
  If Length(matriz) <= 0 Then
    Exit;
  SetLength(arrMatrizesFechamento, Length(arrMatrizesFechamento) + 1);
  arrMatrizesFechamento[Length(arrMatrizesFechamento) - 1] := matriz;
end;

procedure TFatVenda.pGerarMatrizesPDOR(var arrMatrizesFechamento : TMatrizesFechamento; var blnMatrizComProdutoDeBrinde : Boolean; const strEspDocSav : String);
  Var
    stlDatasEntrega : TStringList;
    stlGrupoProdutos : TStringList;
    stlEmpresas : TStringList;
begin
  If (fCfgSis('LOCRET', varString) = 'S') Or (fSomenteItensParaEmpresasCD) Then
    pGerarMatrizesItensPorEmpresaCD(arrMatrizesFechamento, blnMatrizComProdutoDeBrinde)
  Else If (fDesmembraAutomaticamentePedidoAPrazo(strEspDocSav)) Then
    pGerarMatrizesDesmembramentoPadrao(arrMatrizesFechamento, blnMatrizComProdutoDeBrinde)
  Else If (fDesmembraAutomaticamentePedidoOrcamento(strEspDocSav)) Then
    pGerarMatrizesDesmembramentoPadrao(arrMatrizesFechamento, blnMatrizComProdutoDeBrinde)
  Else If ((fUtilizaEmpresaPrioridade) And (fCfgSis('SLDPED') = 'T')) Then
    pGerarMatrizesDesmembramentoPadrao(arrMatrizesFechamento, blnMatrizComProdutoDeBrinde)
  Else
  Begin
    stlEmpresas := TStringList.Create;
    stlGrupoProdutos := TStringList.Create;
    stlDatasEntrega := TStringList.Create;
    Try
      stlEmpresas.Sorted := True;
      stlGrupoProdutos.Sorted := True;
      stlDatasEntrega.Sorted := True;
      pSintetizarElementosDoDesmembramento(stlEmpresas, stlGrupoProdutos, stlDatasEntrega);
      pGerarMatrizesItensPorEmpresa(arrMatrizesFechamento, stlDatasEntrega, stlGrupoProdutos, stlEmpresas);
    Finally
      FreeAndNil(stlEmpresas);
      FreeAndNil(stlGrupoProdutos);
      FreeAndNil(stlDatasEntrega);
    End;
  End;
end;

function TFatVenda.fGerarTLLotes(item : TDadosFechamento) : Boolean;
  const
    SQL = 'SELECT          ' +
          '  F.FDO_CODITE AS CODITE, ' +
          '  E.FDO_ITEEST AS ITEEST, ' +
          '  F.FDO_NUMLOT AS NUMLOT  ' +
          'FROM            ' +
          '  FATDOR F      ' +
          '  INNER JOIN EXTDOR E ON (E.FDO_SEQFDO = F.AUTOINCREM) ' +
          'WHERE           ' +
          '  F.FDO_NUMDOC = :NUMDOC AND ' +
          '  F.FDO_ESPDOC = :ESPDOC AND ' +
          '  F.FDO_CODEMP = :CODEMP';

  var
    LItensTL : TUniClientDataSet;
    LTransf  : TTransferenciaArmazens;

    LEstrutura, LPedido : TUniQuery;

    LSubItem : String;
    LSubQtde : Double;

begin

  Result := False;

  CriaDataSetItensTL(LItensTL);

  LTransf := TTransferenciaArmazens.Create(nil, LItensTL, nil, nil);

  pCarregarDadosFulfillment;
  LTransf.Fulfillment.CopyFrom(Self.Fulfillment);

  LEstrutura := RetornaEstrutura(item.strCodIte);
  LPedido    := fCriaQuery;

  LPedido.SQL.Add(SQL);
  LPedido.ParamByName('NUMDOC').AsString := Self.strNumOrc;
  LPedido.ParamByName('ESPDOC').AsString := Self.strEspOrc;
  LPedido.ParamByName('CODEMP').AsString := Self.strEmpOri;
  LPedido.Open;

  try

    try

      LEstrutura.First;

      While Not LEstrutura.Eof Do
      Begin

        LSubItem := LEstrutura.FieldByName('DMT_ITESUB').AsString;
        LSubQtde := LEstrutura.FieldByName('DMT_QTDITE').AsFloat;

        If Not TCadLot.ProdutoTemLote(LSubItem) Then
        Begin
          LEstrutura.Next;
          Continue;
        End;

        LItensTL.Append;
        LItensTL.FieldByName('CODITE').AsString := LSubItem;
        LItensTL.FieldByName('ARMDES').AsString := item.strNumLot;
        LItensTL.FieldByName('ARMORI').AsString := IIF(LPedido.Locate('CODITE;ITEEST', VarArrayOf([LSubItem, item.strCodIte]), []), LPedido.FieldByName('NUMLOT').AsString, EmptyStr);
        LItensTL.FieldByName('QTDITE').AsFloat := (item.fltQtdIte * LSubQtde);
        LItensTL.Post;

        LEstrutura.Next;

      End;

      LTransf.strDocFat := Self.strNumDoc;
      LTransf.strEspFat := Self.strEspDoc;
      LTransf.strEmpFat := Self.strEmpDoc;
      LTransf.strCliFat := Self.strCodCli;

      If Not LItensTL.IsEmpty Then
        Result := LTransf.fGeraTransferencia(True, False);

    finally
      FreeAndNil(LItensTL);
      FreeAndNil(LTransf);
      FreeAndNil(LEstrutura);
      FreeAndNil(LPedido);
    end;

  except

    on E: Exception do
    begin
      raise;
    end;

  end;

end;

function TFatVenda.fSubItensDaEstruturaTemLotes(item : TDadosFechamento) : Boolean;
  Var
    LEstrutura : TUniQuery;
begin

  Result := True;

  If fUsaRotinaWMS Then
    Exit;

  If fItemEstrutura(item.strCodIte) Then
  Begin

    LEstrutura := RetornaEstrutura(item.strCodIte);

    LEstrutura.First;
    While Not LEstrutura.Eof Do
    Begin

      If TCadLot.ProdutoTemLote(LEstrutura.FieldByName('DMT_ITESUB').AsString) Then
        Exit;

      LEstrutura.Next;

    End;

  End;

  Result := False;

end;

function TFatVenda.fRetTotSer: Double;
begin
  Result := 0;
  If (Self.fltTotSer > 0) Then
    Result := Self.fltTotSer;
end;

function TFatVenda.fInstanciaObjTefRecebimentoVendaServico(AobjTefRecebimento : ITefRecebimento): Boolean ;
begin
  Result := False ;
  if Assigned(AobjTefRecebimento) then
    Exit ;

  if VS_strUsaTef <> 'S' then
    Exit ;

  if not ((strOpcDoc = 'VS') and (strEspDoc = 'NS')) then
    Exit ;

  Result := True ;
end ;

function TFatVenda.fDesmembraPDORMultiLoja(pgbStatus: TcxProgressBar = Nil): Boolean;
  Var
    intIdxPed: Integer;
    intIndice: Integer;
    intItens: Integer;
    strFilter: String;
    blnFiltered: Boolean;
    LInfRotasPedidos: Boolean;

    blnPedBloSav: Boolean;
    strEspDocSav,
    strEspSav,
    strDocSav,
    strEmpSav: String;

    fltTaxEntSav,
    fltFreRatSav,
    fltFreSugSav,
    fltFreCotSav,
    fltFreSav,
    fltAdtSav,
    fltAceSav,
    fltDesSav,
    fltTotSav,
    fltTotSavComDesconto,
    fltBolAdtSav,
    fltTotCad,
    fltTotCadRecIte,
    fltTotCadRecSer,
    fltTotGerLoc,
    fltPorDesSav: Double;

    blnMostraDigDuplic: Boolean;
    arrDatas: TDateArray;
    strAutEntSav : String;
    recEndereSav: TrecEnderecoEntrega;
    fltAdtDis : Double;
    fltBolAdtDis: Double;

    fltTotGerTmp: Double;

    recServicos: TDadosServicos;

    arrMatrizesFechamento: TMatrizesFechamento;

    blnManterNumeroPedidoNoDesmembramento: Boolean;
    intSeqManterNumeroPedidoNoDesmembramento: Integer;

    strCodErrosAuditoria: String;
    blnFalhouNaAuditoria : boolean;

    fltTotItensNaoRateiaFreteVendaPresencial : Double;
    fltTotBaseFrete : Double;
    blnMatrizComProdutoDeBrinde : Boolean;
    strCodTraSav: String;
    objCalculoTotalMatriz : TCalculoTotalMatriz;
    recInputCalculoMatriz : TCalculoTotalMatrizInput;
    recAcumuladores : TCalculoTotalMatrizAcumuladores;
    arrPedidosDesmembrados: TArrayPedidosDesmembrados;
    objAtuCrm: TAtuOcoCrm;

  procedure pDeletaItensOriginaisExcluidosAoFaturar(strNumDoc, strEspDoc, strCodEmp, strSeqDet: String);
    Var
     qryGen: TUniQuery;
  begin
    qryGen := fCriaQuery(nil);
    Try
      With qryGen Do
      Begin
        SQL.Text := ' DELETE FROM FATDOR '+
                    '  WHERE FDO_NUMDOC = :NUMDOC AND '+
                    '        FDO_ESPDOC = :ESPDOC AND '+
                    '        FDO_CODEMP = :CODEMP AND '+
                    '        AUTOINCREM IN ('+strSeqDet+') ';
        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        ExecSQL;
        Close;
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;

  function fOrcamentoEmPedido: Boolean;
  begin
    Result := (strEspSav = 'OR') And (strEspDocSav = 'PD');
  end;

  procedure pCarregaStatusLiberaoOriginal;
  begin
    If (fEnviarParaLiberacaoPedidoSemEstoque) Then
    Begin
      Self.blnPedBlo := blnPedBloSav;
    End;
  end;

  procedure pDefineSeMantemNumeroPedidoNoDesmembramento;
    Var
      intIndice: Integer;
  begin
    blnManterNumeroPedidoNoDesmembramento := False;

    If blnDesmembramentoDePedidosComAdiantamento Then
      Exit;

    //Define se mantem o documento original no desmembramento de pedido de venda.
    If fCfgSis('SLTFRC', varBoolean) And (Not fEmptyStr(strDocSav)) And (strEspSav = 'PD') Then
    Begin
      //Define que ira manter o numero do pedido nos produtos nao selecionados para faturamento parcial
      For intIndice := 0 To Length(arrMatrizesFechamento) -1 Do
        With arrMatrizesFechamento[intIndice][0] Do
        If (Not blnFatPar) And (strEmpIte = strEmpSav) And (strEmpSav = VS_strCodEmp) Then
        Begin
          blnManterNumeroPedidoNoDesmembramento := True;
          intSeqManterNumeroPedidoNoDesmembramento := intIndice;
          Break;
        End;

      //caso ainda difiniu onde ira manter o numero do pedido, tenta definir no primeiro desmembramento que seja da empresa
      If Not blnManterNumeroPedidoNoDesmembramento Then
        For intIndice := 0 To Length(arrMatrizesFechamento) -1 Do
          With arrMatrizesFechamento[intIndice][0] Do
          If (strEmpIte = strEmpSav) And (strEmpSav = VS_strCodEmp) Then
          Begin
            blnManterNumeroPedidoNoDesmembramento := True;
            intSeqManterNumeroPedidoNoDesmembramento := intIndice;
            Break;
          End;
    End;
  end;

Begin
  FErroCarregarPonImp := '';
  blnMatrizComProdutoDeBrinde := False;
  fltFreRatSav:= 0.0;
  fltFreSugSav:= 0.0;
  fltFreCotSav:= 0.0;
  fltTaxEntSav:= 0.0;
  fltFreSav   := 0.0;
  fltAdtSav   := 0.0;
  fltAceSav   := 0.0;
  fltDesSav   := 0.0;
  fltTotCad   := 0.0;
  fltTotItensNaoRateiaFreteVendaPresencial := 0;
  FAutIcv     := EmptyStr;

  blnFiltered := False;

  Result := false;

  If (strEspOrc = 'PD') Then
  Begin
    stlItensRemovidos.CommaText :=
      fGetItensRemovidos(strNumOrc, strEspOrc, strEmpOri, arrMatItens);

    stlReqItensRemovidos.CommaText :=
      fGetItensRemovidos(strNumOrc, strEspOrc, strEmpOri, arrMatItens, tirRequisicao);

    stlTraItensRemovidos.CommaText :=
      fGetItensRemovidos(strNumOrc, strEspOrc, strEmpOri, arrMatItens, tirTransferencia);

    pCarregarReprocessarSaldoItensRemovidos;
  End;

  Try
    Try
      cdsVenda.DisableControls;

      strFilter   := cdsVenda.Filter;
      blnFiltered := cdsVenda.Filtered;

      blnPedBloSav := Self.blnPedBlo;

      strEspDocSav := strEspDoc;
      strEspSav    := strEspOrc;
      strDocSav    := strNumOrc;
      strEmpSav    := strEmpOri;
      strCodTraSav := strCodTra;

      fltFreRatSav := fltFreRat;
      fltFreSugSav := fltFreSug;
      fltFreCotSav := fltFreCot;
      fltTaxEntSav := fltTaxEnt;
      fltFreSav    := fltValFre;
      fltAdtSav    := fltValAdt;
      fltAceSav    := fltDesAce;
      fltDesSav    := fltDesEsp;
      fltPorDesSav := fltPorDes;
      fltTotCadRecIte := Self.fltTotCadRec - fRetTotSer;
      fltTotCadRecSer := fRetTotSer;
      fltBolAdtSav := fltBolAdt;
      fltBolAdtDis := fltBolAdt;

      {*********************************}
      {* Salva os servicos digitados   *}
      {******************************JC*}
      recServicos  := Self.FRecSer;

      fltTotSavComDesconto := Self.fltTotGer - fRetTotSer;

      fltAdtDis    := fltValAdt;

      For intItens := Low(arrMatItens) To High(arrMatItens) Do
      Begin
        FillChar(arrMatItens[intItens].recBackup, SizeOf(arrMatItens[intItens].recBackup), #0);

        arrMatItens[intItens].recBackup.fltDesEsp := arrMatItens[intItens].fltDesEsp;
        arrMatItens[intItens].recBackup.fltDesAce := arrMatItens[intItens].fltDesAce;
        arrMatItens[intItens].recBackup.fltValFre := arrMatItens[intItens].fltValFre;
        arrMatItens[intItens].recBackup.fltFreRat := arrMatItens[intItens].fltFreRat;
        arrMatItens[intItens].recBackup.fltFreSug := arrMatItens[intItens].fltFreSug;
        arrMatItens[intItens].recBackup.fltFreCot := arrMatItens[intItens].fltFreCot;
        arrMatItens[intItens].recBackup.fltTaxEnt := arrMatItens[intItens].fltTaxEnt;
      End;

      cdsDocGer.EmptyDataSet;

      blnComTansacao := False;

      fltTotGerTmp := fltTotGer;

      If Assigned(objFinanc) Then
        fltTotGerTmp := fltTotGerTmp - objFinanc.fRetDespesasAcessorias;

      pCalculaTotGer(True);
      fltTotSav   := fltTotGer; // SEM DESCONTO
      If fRetTotSer > 0 Then
        fltTotSav := fltTotSav - fRetTotSer;

      strAutEntSav := Self.strAutEnt;
      recEndereSav := objEndEnt.recEndere;

      If fCfgSis('MLJNPD', varBoolean) And (not fEmptyStr(strDocSav)) Then
      Begin
        SetLength(FnpcNumCmp, Succ(Length(FnpcNumCmp)));
        FnpcNumCmp[High(FnpcNumCmp)].NumCmp := ShortString(LeftStr(strDocSav + '-' + strEspSav + '-' + strEmpSav, 15));
      End;

      pGerarMatrizesPDOR(arrMatrizesFechamento, blnMatrizComProdutoDeBrinde, strEspDocSav);

      If (fCfgSis('VENBRI') = 'N') And (blnMatrizComProdutoDeBrinde) Then
        fltTotSavComDesconto := fltTotSavComDesconto - Self.fltTotProBri;

      {*****************************************}
      {* Faz uma copia dos dados da Financeira *}
      {**************************************PZ*}
      If Assigned(objFinanc) Then
      Begin
        objFinanc.pCopiaSeguranca;
        objFinanc.pLimpaValoresDesmembrados;
      End;

      strSeqDmp := VS_strCodEmp + fRetSequencial('SEQDMP');
      strEmpDmp := VS_strCodEmp;
      blnDesmembramentoDePedidos := True;
      blnDesmembramentoDePedidosComAdiantamento := fltValAdt > 0;

      pDefineSeMantemNumeroPedidoNoDesmembramento;

      FAuditFaturamento.Limpar;
      FAuditoriaSaldo.Limpar;
      FAuditoriaResumoCaixa.Limpar;

      If blnValidarDadosNotaEletronica Then
        if not fValidaDadosNotaEletronica(arrMatrizesFechamento) then
          Exit;

      if (not Self.blnComTansacao) and (fCfgSis('TRAREM') = '1') then
      begin
        if not fVerificaFlexNegativo(arrMatrizesFechamento) then
        begin
          Result := False;
          Exit;
        end;
      end;

      if blnVendaPresencial then
        pTotalizaItensNaoRateiaFreteVendaPresencial(arrMatrizesFechamento, fltTotItensNaoRateiaFreteVendaPresencial);

      if fPedidoJaFaturado then
      begin
        Exit(False);
      end;

      If (Self.fEntregaImediataPorDataDeEntregaComRotaPorPedido) And
         (Self.fHaveraDesmembramentoPedidoPorDataDeEntrega) Then
      begin
        pCriarFormularios(TfrmRotasDesmPedidoDtEntrega,frmRotasDesmPedidoDtEntrega);
        frmRotasDesmPedidoDtEntrega.arrPedidos := arrMatrizesFechamento;
        frmRotasDesmPedidoDtEntrega.objVenda   := Self;
        frmRotasDesmPedidoDtEntrega.ShowModal;
        LInfRotasPedidos := frmRotasDesmPedidoDtEntrega.RotasPorEntregaOk;
        FreeAndNil(frmRotasDesmPedidoDtEntrega);
        if not LInfRotasPedidos then
          Exit(False);
      end;


      FillChar(recInputCalculoMatriz, SizeOf(recInputCalculoMatriz), #0);
      recInputCalculoMatriz.fltPorDesSav := fltPorDesSav;
      recInputCalculoMatriz.fltTotSav := fltTotSav;
      recInputCalculoMatriz.strEspDocSav := strEspDocSav;
      recInputCalculoMatriz.fltDesSav := fltDesSav;
      recInputCalculoMatriz.fltFreSav := fltFreSav;
      recInputCalculoMatriz.fltAdtSav := fltAdtSav;
      recInputCalculoMatriz.fltAceSav := fltAceSav;
      recInputCalculoMatriz.fltFreRatSav := fltFreRatSav;
      recInputCalculoMatriz.fltTaxEntSav := fltTaxEntSav;
      recInputCalculoMatriz.fltTotItensNaoRateiaFreteVendaPresencial := fltTotItensNaoRateiaFreteVendaPresencial;
      recInputCalculoMatriz.fltFreSugSav := fltFreSugSav;
      recInputCalculoMatriz.fltFreCotSav := fltFreCotSav;
      objCalculoTotalMatriz := TCalculoTotalMatriz.Create(recInputCalculoMatriz);

      VS_strAllErrorsMessages := '';
      FillChar(recAcumuladores, SizeOf(recAcumuladores), #0);
      SetLength(arrPedidosDesmembrados, 0);

      fStartTransaction;

      For intIndice := 0 To Length(arrMatrizesFechamento) - 1 Do
      Begin
        if fEmptyStr(Self.strNumOrigem) then
        begin
          Self.strNumOrigem := strNumDoc;
          Self.strEspOrigem := strEspDoc;
          Self.strEmpOrigem := strPedEmp;
        end;

        If (Not blnDesmembramentoDePedidosComAdiantamento) and (not blnAbastecimentoDeposito) and (not blnBolVen) Then
        Begin
          strEspOrc := '';
          strNumOrc := '';
        End;

        If blnManterNumeroPedidoNoDesmembramento And
          (intSeqManterNumeroPedidoNoDesmembramento = intIndice) Then
        Begin
          strEspOrc := strEspSav;
          strNumOrc := strDocSav;
        End;

        Self.arrMatItens := arrMatrizesFechamento[intIndice];

        If fTemItemServico Then
          Self.FRecSer := recServicos
        Else
          FillChar(Self.FRecSer, SizeOf(Self.FRecSer), #0);

        Self.strLisDet := '';
        For intItens := Low(Self.arrMatItens) To High(Self.arrMatItens) Do
        Begin
          pIncrementaListaStr(Self.arrMatItens[intItens].strSeqDet, Self.strLisDet, True);
        End;

        If fEhEmpresaCD(Self.arrMatItens[0].strEmpIte) And
           Not SameText(Self.arrMatItens[0].strEmpIte, VS_strCodEmp) Then
        Begin
          strPedEmp := VS_strCodEmp;
          blnEnt_CD := True;
          strEmp_CD := Self.arrMatItens[0].strEmpIte;
        End
        Else
        Begin
          strPedEmp := Self.arrMatItens[0].strEmpIte;
          blnEnt_CD := False;
          strEmp_CD := VS_strCodEmp;
        End;

        If (Self.strEntFut = 'N') And (arrMatItens[0].strEntRet = 'E') Then
        Begin
          Self.dtaDtEntr := arrMatItens[0].dtaDtEntr;
          If (Self.fEntregaImediataPorDataDeEntregaComRotaPorPedido) And (arrMatItens[0].strCodRot <> '') Then
            Self.strCodRot := arrMatItens[0].strCodRot;
        End;

        Self.strEntFat := IIF(fTemItensEntrega(Self.arrMatItens), 'S', 'N');
        Self.strEntFut := IIF(fTemEntregaFutura(Self.arrMatItens), 'S', 'N');

        If (fCfgSis('SLTFRC', varBoolean)) And (Not Self.blnFinali) Then
          Self.strFatTot := IIF(Self.arrMatItens[0].blnFatPar, 'N', 'S');

        If (Concat(strNumOrc, strEspOrc, strEmpOri) <> Concat(strDocSav, strEspSav, strEmpSav)) Or
           (Not blnManterNumeroPedidoNoDesmembramento) Then
          Self.strOrcamentoPedidoHeranca := Concat(strDocSav, strEspSav, strEmpSav);

        If (((strEspSav = 'OR') Or (Copy(strOrcamentoPedidoHeranca, 13, 02) = 'OR')) And (strEspDocSav = 'PD') And (Not (fCfgSis('DTORPD', varBoolean)))) Or
           ((Not fEmptyStr(strEspSav)) And (Not (fCfgSis('DTORPD', varBoolean)))) Then
        Begin
          Self.dtaGraPed := Self.VS_Date;
          Self.dtaHorPed := fRetHoraServidor;
        End
        Else
          Self.dtaGraPed := Self.dtaDtaEntOri;

        {**********************************************************************}
        {* NECESSITA RECARREGAR O ENDEREÇO DE ENTREGA, POIS O MESMO FOI LIMPO *}
        {* NO fGravaArquivos.                                                 *}
        {*******************************************************************RN*}
        If (fEmptyStr(Self.strAutEnt)) And (Self.strEntFat = 'S') And (Not fEmptyStr(strAutEntSav)) Then
        Begin
          Self.strAutEnt := strAutEntSav;
          objEndEnt.recEndere := recEndereSav;
          pEnderecoToFatVenda;
        End;

        If (fCfgSis('USATML', varBoolean)) Then
        Begin
          If (Not fEmptyStr(fCfgSis('TRASUG', varString, strPedEmp))) And (fEmptyStr(fRetTransportadoraEntregaPorCodigo(objEndEnt.recEndere.strIncrem))) Then
            strCodTra := fCfgSis('TRASUG', varString, strPedEmp);
        End;

        pCalculaPesBruLiq;

        objCalculoTotalMatriz.CalcularMatriz(Self, arrMatrizesFechamento, intIndice, recAcumuladores);

        If fSomenteItensDeServico(arrMatrizesFechamento[intIndice]) Then
        Begin
          fltTotCadRec := fltTotCadRecSer;
        End

        Else If Length(arrMatrizesFechamento) > 1 Then
        Begin
          If intIndice = Length(arrMatrizesFechamento) - 1 Then
          Begin
            fltTotCadRec := fltTotCadRecIte - fltTotCad;
          End Else
          Begin
            fltTotGerLoc := Self.fltTotGer - fRetTotSer;

            If (fCfgSis('VENBRI') = 'N') And (blnMatrizComProdutoDeBrinde) Then
              fltTotGerLoc := fltTotGerLoc - Self.fltTotProBri;

            fltTotCadRec := RoundTo(fltTotCadRecIte * (fltTotGerLoc / fltTotSavComDesconto), -2)
                                       // TOTAL DO PEDIDO COM DESCONTO / TOTAL DO PEDIDO ORIGINAL COM DESCONTO
                                       // TEM QUE PEGAR OS VALORES JA COM DESCONTO
                                       // POIS O DESCONTO É DADO SOMENTE PARA OS ITENS FORA DE PROMOCAO
          End;

          fltTotCad := fltTotCad + fltTotCadRec;

          fltTotCadRec := fltTotCadRec + fRetTotSer;
        End
        Else
        Begin
          fltTotCadRec := fltTotCadRecIte;

          fltTotCadRec := fltTotCadRec + fRetTotSer;
        End;

        fltValAdt := fValorAdiantamento(fltTotCadRec, fltAdtSav, fltAdtDis);
        fltBolAdt := fValorAdiantamento(fltTotCadRec, fltBolAdtSav, fltBolAdtDis);

        pRateiaValores;

        blnMostraDigDuplic := False;

        Result := fDigitaDuplicata(blnMostraDigDuplic,
                                   arrDatas,
                                   dtaPreAnt,
                                   True,
                                   arrDuplicCop);

        If fltValAdt + IIF(blnBolVen, 0, fltBolAdt) > 0 Then
        Begin
          Result := Result And fAdicionaAdiantamentoPrimeiraParcela;
        End;

        Result := Result And fAcertaValoresFinanceiraDesmembramento(fltTotGer - fltDesAce , fltTotGerTmp, (intIndice = Length(arrMatrizesFechamento) - 1));

        If Result Then
          pCarregaStatusLiberaoOriginal;

        Result := Result And fGravaArquivos(pgbStatus);

        If (fCfgSis('CDTCLV', varBoolean)) And
           (Pos(strEspDoc, 'PD_FF_IF_NF_') > 0) And
           (fExisteCilindroVasilhameFaturamento) Then
        Begin
          FAutIcv := strAutIncFatGor;
        End;

        If (fOrcamentoEmPedido Or blnDesmembramentoDePedidosComAdiantamento) And (Not fEmptyStr(strDocSav)) And
           (Not blnManterNumeroPedidoNoDesmembramento) Then
          Result := Result And fMarcaOrcPed(strNumDoc,
                                            strEspDoc,
                                            strDocSav,
                                            strEspSav,
                                            strCodVen,
                                            strConPag,
                                            fltTotGer,
                                            strEmpSav,
                                            True,
                                            strLisDet,
                                            Self.strPedEmp,
                                            '',
                                            '',
                                            '',
                                            False,
                                            blnGravarCadRec,
                                            strCodCli,
                                            IIF(Pos(strEspDoc, 'OR_PD_') > 0, strSerieGor, strSerFsc),
                                            blnExecutandoFaturadorAutomatico)
          Else
          Begin
            SetLength(arrPedidosDesmembrados, Length(arrPedidosDesmembrados)+1);

            intIdxPed := Length(arrPedidosDesmembrados)-1;

            FillChar(arrPedidosDesmembrados[intIdxPed], SizeOf(arrPedidosDesmembrados[intIdxPed]), #0);

            arrPedidosDesmembrados[intIdxPed].strNumDoc := strNumDoc;
            arrPedidosDesmembrados[intIdxPed].strEspDoc := strEspDoc;
            arrPedidosDesmembrados[intIdxPed].strNumOrc := strDocSav;
            arrPedidosDesmembrados[intIdxPed].strEspOrc := strEspSav;
            arrPedidosDesmembrados[intIdxPed].strVenFat := strCodVen;
            arrPedidosDesmembrados[intIdxPed].strCndFat := strConPag;
            arrPedidosDesmembrados[intIdxPed].fltValFat := fltTotGer;
            arrPedidosDesmembrados[intIdxPed].strEmpOrc := strEmpSav;
            arrPedidosDesmembrados[intIdxPed].blnAtuExp := True;
            arrPedidosDesmembrados[intIdxPed].strLisDet := strLisDet;
            arrPedidosDesmembrados[intIdxPed].strEmpFat := '';
            arrPedidosDesmembrados[intIdxPed].strLisCodIte :=  '';
            arrPedidosDesmembrados[intIdxPed].strLisFdoSeqGer := '';
            arrPedidosDesmembrados[intIdxPed].blnTinDor := False;
            arrPedidosDesmembrados[intIdxPed].blnValidaGorCndSeGravaCadRec := blnGravarCadRec;
            arrPedidosDesmembrados[intIdxPed].blnBaixaEntFutAbastecimentoDepositoItem := False;
            arrPedidosDesmembrados[intIdxPed].blnFaturamentoAutomatico := blnExecutandoFaturadorAutomatico;
          End;

        If Not Result Then
          Break;

        {***********************************************************************}
        {* Limpa as informacoes da Financeira para nao gravar em duplicidade   *}
        {*******************************************************************PZ**}
        If Assigned(objFinanc) Then
        Begin
          objFinanc.pLimpaDados;
          objFinanc.pRestaurarCopiaSeguranca;
        End;

      End;

      FreeAndNil(objCalculoTotalMatriz);

      pCarregaStatusLiberaoOriginal;

      strEspOrc := strEspSav;
      strNumOrc := strDocSav;
      strEmpOri := strEmpSav;

      GeracaoDoPixEmVendaDesmembrada;


      If Assigned(objReprocessarSaldoItensRemovidos) And Result Then
        objReprocessarSaldoItensRemovidos.NotificarRoboParaReprocessarSaldos;

      If (stlReqItensRemovidos.Count > 0) And Result Then
        pRemoveRequisicoes(stlReqItensRemovidos.CommaText);

      If (stlTraItensRemovidos.Count > 0) And Result Then
        pRemoveVinculoTransferencias(stlTraItensRemovidos.CommaText);

      If (Not fOrcamentoEmPedido) And (Not fEmptyStr(strDocSav)) And Result And
         (Not blnManterNumeroPedidoNoDesmembramento) And
         (Not blnDesmembramentoDePedidosComAdiantamento) and
         (not blnAbastecimentoDeposito) and
         (Not blnBolVen) And
         (Length(arrPedidosDesmembrados) > 0) Then
      Begin
        For intIdxPed := 0 To Length(arrPedidosDesmembrados) - 1 Do
        Begin
          Result := Result And fMarcaOrcPed(arrPedidosDesmembrados[intIdxPed].strNumDoc,
                                            arrPedidosDesmembrados[intIdxPed].strEspDoc,
                                            arrPedidosDesmembrados[intIdxPed].strNumOrc,
                                            arrPedidosDesmembrados[intIdxPed].strEspOrc,
                                            arrPedidosDesmembrados[intIdxPed].strVenFat,
                                            arrPedidosDesmembrados[intIdxPed].strCndFat,
                                            arrPedidosDesmembrados[intIdxPed].fltValFat,
                                            arrPedidosDesmembrados[intIdxPed].strEmpOrc,
                                            arrPedidosDesmembrados[intIdxPed].blnAtuExp,
                                            arrPedidosDesmembrados[intIdxPed].strLisDet,
                                            arrPedidosDesmembrados[intIdxPed].strEmpFat,
                                            arrPedidosDesmembrados[intIdxPed].strLisCodIte,
                                            arrPedidosDesmembrados[intIdxPed].strLisFdoSeqGer,
                                            arrPedidosDesmembrados[intIdxPed].strLisSeqIndFatGor,
                                            arrPedidosDesmembrados[intIdxPed].blnTinDor,
                                            arrPedidosDesmembrados[intIdxPed].blnValidaGorCndSeGravaCadRec);
        End;
      End;

      If (fOrcamentoEmPedido) And (Not fEmptyStr(Self.strAutIncIteDel)) And Result And
         (Not fEmptyStr(strDocSav)) And (Not blnManterNumeroPedidoNoDesmembramento) Then
      Begin
        pDeletaItensOriginaisExcluidosAoFaturar(strNumOrc, strEspOrc, strEmpSav, Self.strAutIncIteDel);
        pAtualizaTotalItensFatGor(strNumOrc, strEspOrc, strEmpSav);
      End;

      If (VS_strHabilitarCRM) Then
      Begin
        If (Length(arrPedidosDesmembrados) > 0) Then
        Begin
          For intIdxPed := 0 To Length(arrPedidosDesmembrados) - 1 Do
          Begin
            If SameText(arrPedidosDesmembrados[intIdxPed].strEspDoc, 'OR') Then
            Begin
              objAtuCrm := TAtuOcoCrm.Create(Nil);

              Try
                objAtuCrm.strNomFrm := '[TFatVenda.fDesmembraPDORMultiLoja]';
                objAtuCrm.pCarregaOcorrenciaCliente(arrPedidosDesmembrados[intIdxPed].strEmpOrc,
                                                    arrPedidosDesmembrados[intIdxPed].strEspOrc,
                                                    arrPedidosDesmembrados[intIdxPed].strNumOrc,
                                                    '');

                objAtuCrm.pFinalizaOcorrencia('Orçamento baixado desmembramento multiloja.');
              Finally
                FreeAndNil(objAtuCrm);
              End;
            End;
          End;
        End
        Else If (Not fEmptyStr(strDocSav)) And
                (Not fEmptyStr(strOrcamentoPedidoHeranca)) And
                (strEspSav = 'OR') Then
        Begin
          objAtuCrm := TAtuOcoCrm.Create(Nil);

          Try
            objAtuCrm.strNomFrm := '[TFatVenda.fDesmembraPDORMultiLoja]';
            objAtuCrm.pCarregaOcorrenciaCliente(strEmpSav, strEspSav, strDocSav, EmptyStr);
            objAtuCrm.pFinalizaOcorrencia('Orçamento baixado desmembramento multiloja.');
          Finally
            FreeAndNil(objAtuCrm);
          End;
        End;
      End;

      For intIndice := 0 To objFatVendaImp.ItemsCount -1 Do
      Begin
        If (objFatVendaImp[intIndice].strEspDoc = 'PD') And (Not (objFatVendaImp[intIndice].blnImprimeAmostraVeiculo)) And Result Then
        Begin
          {*********************************}
          {* DISPARA ATUALIZAÇÃO DO STATUS *}
          {******************************FS*}
          TUpdateStatus.New(TParamStatus.New()
                              .NumDoc(objFatVendaImp[intIndice].strNumDoc)
                              .EspDoc(objFatVendaImp[intIndice].strEspDoc)
                              .CodEmp(objFatVendaImp[intIndice].strEmpDoc)
                              .CodCli(objFatVendaImp[intIndice].strCodCli)).pExecute();

          {*******************************}
          {* ATUALIZA RESERVA DE ESTOQUE *}
          {****************************FS*}
          {Reprocessar Saldos}
          TReprocessarSaldoItem.New
            .AddItensDoDocumento(
              TItensReprocessarDoDocumento.New
                .Documento(objFatVendaImp[intIndice].strNumDoc)
                .Especie(objFatVendaImp[intIndice].strEspDoc)
                .Empresa(objFatVendaImp[intIndice].strEmpDoc)
              ).NotificarRoboParaReprocessarSaldos;

          {***********************************}
          {* REPLICA DADOS DE BLOQUEIO PARA  *}
          {* OS PEDIDOS DE TRANSFERÊNCIA QUE *}
          {* FORAM GERADOS A PARTIR DESSE    *}
          {********************************FS*}
          TReplInfPDTransf.New()
            .NumDoc(objFatVendaImp[intIndice].strNumDoc)
            .EspDoc(objFatVendaImp[intIndice].strEspDoc)
            .CodEmp(objFatVendaImp[intIndice].strEmpDoc)
            .Fields(friFatGor, ['FGO_OPELIB', 'FGO_DIGLIB', 'FGO_DTALIB', 'FGO_HORLIB',
                                'FGO_OBSL01', 'FGO_OBSL02', 'FGO_LIBERA', 'FGO_OPELIC',
                                'FGO_DIGLIC', 'FGO_DTALIC', 'FGO_HORLIC', 'FGO_OBSLC1',
                                'FGO_OBSLC2', 'FGO_LIBCOM'])
            .Fields(friExtGor, ['FGO_ENVLIB'])
            .pExecute();
        End;
      End;

      strSeqDmp := '';
      strEmpDmp := '';
      blnDesmembramentoDePedidos := False;
      blnDesmembramentoDePedidosComAdiantamento := False;

      blnFalhouNaAuditoria := False;

      If (Result) then
      begin
        if not FAuditFaturamento.fValidouTodas(strCodErrosAuditoria) then
        begin
          blnFalhouNaAuditoria := True;
          Result := False;
        end;

        if not FAuditoriaSaldo.fValidouTodas(strCodErrosAuditoria) then
        begin
          blnFalhouNaAuditoria := True;
          Result := False;
        end;

        If (Not FAuditoriaResumoCaixa.ValidouTodas(strCodErrosAuditoria)) Then
        Begin
          blnFalhouNaAuditoria := True;
          Result := False;
        End;
      end;

      If Result Then
      Begin
        fCommit;
        pExibeMensagemErroAoCarregarPonImp;
        If Not DadosPixDaVenda.AutoIncremsPedidosPixGerar.IsEmpty Then
          GeraPixDoPedido(True)
        Else If Not DadosPixDaVenda.TxIdPixRemover.IsEmpty Then
          RemoverPixDoPedido;
        TPixDao.AtualizarMONPIX_LOG(DadosPixDaVenda.ListaPixGeradosNaTelaQRCode,
                                    Self.strCodCli,
                                    Concat(Self.strNumDoc, '-', Self.strEspDoc, '-A-', VS_strCodEmp),
                                    Self.fltTotGer);

        if Assigned(objRomFusTarefas) then
          objRomFusTarefas.pProcessarTarefas;

        Self.blnGravouDocumentos := True;

        If (Result) And (strEspDoc = 'PD') And (fCfgSis('USAVBT', varString) = 'S') Then
        Begin
          If fGravarPenRecDesmembramento  Then
          Begin
            If fCfgSis('GFPVBT', varBoolean) Then
            Begin
              pCarregaTrocaRecebimento(Self.strNumDoc, Self.strEspDoc, Self.strEmpDoc, Self.strCodCli, True);
            End;
          End;
        End;

      End
      Else
      Begin
        fRollBack;

        fltValFre := fltFreSav;
        fltValAdt := fltAdtSav;
        fltDesAce := fltAceSav;
        fltFreRat := fltFreRatSav;
        fltFreSug := fltFreSugSav;
        fltFreCot := fltFreCotSav;
        fltTaxEnt := fltTaxEntSav;
        fltDesEsp := fltDesSav;

        pCarregaStatusLiberaoOriginal;

        Self.FRecSer := recServicos;

        cdsVenda.Filter    := strFilter;
        cdsVenda.Filtered  := blnFiltered;
        strPedEmp := VS_strCodEmp;
        blnEnt_CD := False;
        strEmp_CD := '';

        pCalculaTotGer;
      End;
    Finally
      cdsVenda.EnableControls;
    End;

    If Result Then
    Begin
      pMostraDocumentosGerados;
      pImprimePedidosDesmembrados;

      If Assigned(objFinanc) Then
        objFinanc.pRestaurarCopiaSeguranca;
    End
    else if (blnFalhouNaAuditoria) then
      pMostraErrosAuditoria(strCodErrosAuditoria);
  Except
    On E: Exception Do
    Begin
      Result := False;

      fRollBack;

      fltValFre := fltFreSav;
      fltValAdt := fltAdtSav;
      fltDesAce := fltAceSav;
      fltFreRat := fltFreRatSav;
      fltFreSug := fltFreSugSav;
      fltFreCot := fltFreCotSav;
      fltTaxEnt := fltTaxEntSav;
      fltDesEsp := fltDesSav;

      Self.FRecSer := recServicos;

      pCarregaStatusLiberaoOriginal;

      strEspOrc := strEspSav;
      strNumOrc := strDocSav;
      strEmpOri := strEmpSav;

      strPedEmp := VS_strCodEmp;
      blnEnt_CD := False;
      strEmp_CD := '';
      strCodTra := strCodTraSav;

      strSeqDmp := '';
      strEmpDmp := '';
      blnDesmembramentoDePedidos := False;
      blnDesmembramentoDePedidosComAdiantamento := False;

      cdsVenda.Filter   := strFilter;
      cdsVenda.Filtered := blnFiltered;
      pCalculaTotGer;
      cdsVenda.EnableControls;

      If Assigned(objCalculoTotalMatriz) Then
        FreeAndNil(objCalculoTotalMatriz);

      pMensagensErro(E.Message, '[fDesmembraPDORMultiLoja]');
    End;
  End;
End;

//Posteriormente isto deve ser inserido no cnf_nfe
