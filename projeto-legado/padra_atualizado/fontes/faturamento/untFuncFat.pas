{ TThreadCarregarSaldoEmpresasGrid }

procedure TThreadCarregarSaldoEmpresasGrid.AddItem(AAutInc: Integer; ACodIte, ANumLot, AEmpIte: string; AVenda: TFatVenda);
begin
  FSemaphore.Enter;
  try
    FItems.AddOrSetValue(AAutInc, TItem.Create(ACodIte, ANumLot, AEmpIte, AVenda));
  finally
    FSemaphore.Leave;
  end;
end;

class procedure TThreadCarregarSaldoEmpresasGrid.CalcularSaldoDisponivel(var AItem: TThreadCarregarSaldoEmpresasGrid.TItem);
var
  LEmpIdx: Integer;
  LCodEmp: string;
  LNumLot: string;
  LSalDis: Double;
begin
  AItem.fltEstFil := 0;

  for LEmpIdx := 0 to Length(AItem.arrEmpSal)-1 do
  begin
    LCodEmp := AItem.arrEmpSal[LEmpIdx].strCodEmp;

    LNumLot := AItem.strNumLot;

    If AItem.arrEmpSal[LEmpIdx].blnIgnorarLote Then
      LNumLot := EmptyStr;

    LSalDis := GetSaldoDisponivel(AItem.strCodIte,
                                  LNumLot,
                                  LCodEmp,
                                  AItem.strEmpIte,
                                  AItem.strNumOrc,
                                  AItem.strEspOrc,
                                  AItem.strEmpOrc);

    AItem.arrEmpSal[LEmpIdx].fltSalDis := LSalDis;

    if LCodEmp = AItem.strEmpIte then
      AItem.fltEstLoj := LSalDis
    else
      AItem.fltEstFil := AItem.fltEstFil + LSalDis;
  end;

  AItem.blnUpdated := True;
end;

constructor TThreadCarregarSaldoEmpresasGrid.Create(const ACreateSuspended: Boolean);
begin
  inherited Create(ACreateSuspended);
  Priority := tpHighest;
  FreeOnTerminate := False;
  FSemaphore := TCriticalSection.Create;
  FItems := TDictionary<Integer, TItem>.Create;
end;

destructor TThreadCarregarSaldoEmpresasGrid.Destroy;
begin
  FreeAndNil(FSemaphore);
  FreeAndNil(FItems);
  inherited;
end;

class function TThreadCarregarSaldoEmpresasGrid.GetSaldoDisponivel(ACodIte, ANumLot, ACodEmp, AEmpIte, ANumOrc, AEspOrc, AEmpOrc: String): Double;
begin
  Result := 0;
  if (ACodEmp = AEmpIte) Or (fPermiteTransfEntreEmps(ACodEmp, AEmpIte)) then
  begin
    If ANumLot.IsEmpty then
      Result := fCampoTabela(fSQLSaldoDisponivel('', True), 'ITEGER', ['ITE_CODITE', 'ITE_CODEMP'], [ACodIte, ACodEmp])
    else
      Result := fCampoTabela(fSQLSaldoDisponivel('', True, True), 'CADLOT', ['LOT_CODITE', 'LOT_CODEMP', 'LOT_NUMLOT'], [ACodIte, ACodEmp, ANumLot]);

    //Deve somar no saldo disponivel o saldo reservado do pedido sendo alterado
    if not ANumOrc.IsEmpty and AEspOrc.Equals('PD') then
      Result := Result + TSaldoReservado.New(
                           TReservaParametros.New()
                             .CodigoItem(ACodIte)
                             .EmpresaItem(ACodEmp)
                             .CodEmpresa(ACodEmp)
                             .NumeroLote(ANumLot)
                             .ConverterML(False)
                             .NumeroDocumento(ANumOrc)
                             .TipoFiltroDocumento(tfdFiltrarDocumento)
                             .DesconsideraPedidosCorte(False)
                             .DesconsideraPedidosEnderecamento(True)
                             .TipoReserva(trsPedidoVenda)
                           ).fGetQuantidade();
  end;
end;

function TThreadCarregarSaldoEmpresasGrid.GetItem(AAutInc: Integer): TThreadCarregarSaldoEmpresasGrid.TItem;
begin
  FSemaphore.Enter;
  try
    If FItems.ContainsKey(AAutInc) Then
      Result := FItems[AAutInc];
  finally
    FSemaphore.Leave;
  end;
end;

class function TThreadCarregarSaldoEmpresasGrid.GetSaldoLojas(ACodIte, ANumLot,
  AEmpIte: string; AVenda: TFatVenda): TThreadCarregarSaldoEmpresasGrid.TItem;
var
  LItem: TThreadCarregarSaldoEmpresasGrid.TItem;
begin
  LItem := TItem.Create(ACodIte, ANumLot, AEmpIte, AVenda);
  CalcularSaldoDisponivel(LItem);
  Result := LItem;
end;

function TThreadCarregarSaldoEmpresasGrid.GetProgress: Integer;
begin
  Result := Floor(FUpdatedCount / FItems.Count * 100);
end;

function TThreadCarregarSaldoEmpresasGrid.UpdatedAll: Boolean;
begin
  Result := FUpdatedCount = FItems.Count;
end;

procedure TThreadCarregarSaldoEmpresasGrid.Execute;
var
  LRecIte: TItem;
  LAutInc: Integer;
  LArrKey: TArray<Integer>;
begin
  inherited;
  try
    FUpdatedCount := 0;
    while not Terminated do
    begin
      FSemaphore.Enter;
      try
        LArrKey := FItems.Keys.ToArray;
      finally
        FSemaphore.Leave;
      end;

      for LAutInc in LArrKey do
      begin
        if Terminated then Break;

        FSemaphore.Enter;
        try
          LRecIte := FItems[LAutInc];
        finally
          FSemaphore.Leave;
        end;

        if LRecIte.blnUpdated then Continue;

        CalcularSaldoDisponivel(LRecIte);

        Inc(FUpdatedCount);

        FSemaphore.Enter;
        try
          FItems[LAutInc] := LRecIte;
        finally
          FSemaphore.Leave;
        end;
      end;
      Sleep(500);
    end;
  finally
  end;
end;

{ TThreadCarregarSaldoEmpresasGrid.TItem }

constructor TThreadCarregarSaldoEmpresasGrid.TItem.Create(ACodIte, ANumLot, AEmpIte: string; AVenda: TFatVenda);
var
  LEmpresas: TStringList;
  LIndex: Integer;
begin
  strCodIte := ACodIte;
  strNumLot := ANumLot;
  strEmpIte := AEmpIte;
  strNumOrc := AVenda.strNumOrc;
  strEspOrc := AVenda.strEspOrc;
  strEmpOrc := AVenda.strEmpOri;
  fltEstLoj := 0.0;
  fltEstFil := 0.0;
  blnUpdated := False;

  LEmpresas := TStringList.Create;
  try
    LEmpresas.CommaText := fRetListaEmpresas;
    SetLength(arrEmpSal, LEmpresas.Count);
    for LIndex := 0 to LEmpresas.Count -1 do
    begin
      arrEmpSal[LIndex].strCodEmp := LEmpresas[LIndex];
      arrEmpSal[LIndex].blnIgnorarLote := AVenda.fIgnorarLote(LEmpresas[LIndex], ACodIte);
      arrEmpSal[LIndex].fltSalDis := 0;
    end;
  finally
    LEmpresas.Free;
  end;
end;

function TThreadCarregarSaldoEmpresasGrid.TItem.GetSaldoLoja(ACodEmp: string): Double;
var
  LIndex: Integer;
begin
  Result := 0;
  for LIndex := 0 to Length(arrEmpSal) do
    if arrEmpSal[LIndex].strCodEmp = ACodEmp then
      Exit(arrEmpSal[LIndex].fltSalDis);
end;

end.
