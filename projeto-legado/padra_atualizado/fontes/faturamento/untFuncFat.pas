      {*********************************************************************************}
      {* CASO FOR DEVOLUCAO E TENHA SELECIONADO A OPCAO DE DEVOLVER PRODUTOS PIGMENTOS *}
      {******************************************************************************JC*}
      If (intOpcao = OPC_GRAVAMOVDET_PROD_NORMAL) And (arrMatItens[intPosMat].strIdeDev <> 'NOR') And (arrMatItens[intPosMat].strPigBas = 'S') Then
      Begin
        {**************************************}
        {* NAO DEVE GRAVAR O PRODUTO ACABADO  *}
        {***********************************JC*}
        blnGravarCodAca  := False;

        {*************************************************************}
        {* CASO FOR TINTA IMOBILIARIA MARCA COMO VISIVEL NO KARDEX   *}
        {* POIS O ITEM A SER GRAVADO E' A PROPRIA BASE DEVOLVIDA...  *}
        {**********************************************************JC*}
        If (Assigned(fTipoTinta)) and (not arrMatItens[intPosMat].blnProAca) then
        Begin
          if (fTipoTinta(arrMatItens[intPosMat].strIdeDev) = ttImobiliaria) then
            blnFilKar := False
          else if (fTipoTinta(arrMatItens[intPosMat].strIdeDev) = ttIndustrial) then
          begin
            if fEmptyStr(arrMatItens[intPosMat].strIteEmb) then // se nao tiver embalagem, então mostra no kardex
              blnFilKar := False;
          end;
        End;

        If (Assigned(fTipoTinta)) And
           (fTipoTinta(arrMatItens[intPosMat].strIdeDev) = ttAutomotiva)
