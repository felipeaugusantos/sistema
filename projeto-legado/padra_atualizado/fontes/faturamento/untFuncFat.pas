function TfatVenda.fEhDevolucaoAVista(strCndEdt: string): Boolean;
  Var
    strFiltro: String;
    blnFiltro: Boolean;
Begin
  If (fCfgSis('DVVORI', varBoolean)) Or (fEmptyStr(strCndEdt)) Then
  Begin
    With cdsVenda Do
    Begin
      DisableControls;

      strFiltro := Filter;
      blnFiltro := Filtered;

      Filter := 'ITE_CNDDEV <> ' + QuotedStr('01000');
      Filtered := True;

      Result := IsEmpty;

      Filter   := strFiltro;
      Filtered := blnFiltro;

      EnableControls;
    End;
  End
  Else
  Begin
    If strCndEdt  <> '01000' Then
      Result := False
    Else
      Result := True;
  End;

End;

