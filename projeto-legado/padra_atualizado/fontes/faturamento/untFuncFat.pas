function TFatVenda.fRetQtdDuplicatas(arrDuplic: Array Of TArrDigDuplic): Integer;
var
  intFor: Integer;
begin
  Result  := 0;
  intFor  := 0;
  While (intFor < Length(arrDuplicata)) do
  Begin
    If arrDuplic[intFor].curValor <> 0 Then
      Result := Result + 1;

    inc(intFor);
  End;
end;

function TFatVenda.fRetListaDuplicatas(arrDuplic: Array Of TArrDigDuplic): String;
var
  intDuplicata: Integer;
  strEntrada: String;
  strSaldoRestante: String;
begin

  strEntrada := '';
  strSaldoRestante := '';
  intDuplicata := 0;

  While (intDuplicata < Length(arrDuplicata)) do
  Begin
    if (arrDuplicata[intDuplicata].dtaDtaVen = DateToStr(Self.dtaDtaOri)) and
       (arrDuplicata[intDuplicata].curValor > 0) then
      strEntrada := 'ENTRADA: '+FormatFloat('#,##0.00', arrDuplicata[intDuplicata].curValor)+' - '+arrDuplicata[intDuplicata].dtaDtaVen
    else
    begin
      if (arrDuplicata[intDuplicata].curValor > 0) then
        strSaldoRestante := strSaldoRestante + ' VENCTO: '+arrDuplicata[intDuplicata].dtaDtaVen + ' NO VALOR:'+FormatFloat('#,##0.00', arrDuplicata[intDuplicata].curValor) + ' | ';
    end;
    Inc(intDuplicata);
  End;

  Result := strEntrada + iif(not fEmptyStr(strSaldoRestante), ' | SALDO RESTANTE: ' + strSaldoRestante, '');

end;

function TFatVenda.fRetDuplicataInfAdicionais: String;
begin
  Result := fRetListaDuplicatas(arrDuplicata);
end;

function TFatVenda.fGravaAgeTel(strCodCli, strCodVen : String): Boolean;
  Var
    qryAux: TUniQuery;
    strAutoIn: String;
begin
  If (fDocumentoParaFornecedor) Then
  Begin
    Result := True;
    Exit;
  End;

  Result := False;

  Try
    qryAux := fCriaQuery(Self);

    With qryAux,SQL Do
    Begin
      Close;
      Clear;

      Add('INSERT INTO AGETEL                                                                               ');
      Add('(AUTOINCREM, AGE_CODEMP, AGE_CODVEN, AGE_CODCLI, AGE_DTAAGE, AGE_DTABAI, AGE_HORBAI, AGE_OBSERV) ');
      Add('VALUES                                                                                           ');
      Add('(:AUTOIN, :CODEMP, :CODVEN, :CODCLI, :DTAAGE, NULL, NULL, NULL)                                  ');

      strAutoIn := fRetAutoIncrem('AGETEL', VS_strCodEmp);

      ParamByName('AUTOIN').AsString := strAutoIn;
      ParamByName('CODEMP').AsString := VS_strCodEmp;
      ParamByName('CODVEN').AsString := strCodVen;
      ParamByName('CODCLI').AsString := strCodCli;
      ParamByName('DTAAGE').AsDate   := IncDay(VS_Date, fCfgSis('PMEDIA',varInteger));

      ExecSQL;
    End;

    Result := True;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;

  FreeAndNil(qryAux);
end;

