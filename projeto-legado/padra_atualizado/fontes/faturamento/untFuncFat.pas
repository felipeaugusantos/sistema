function TFatVenda.fGerarCreditoValorRemovidoAposAlteracaoPedido: Boolean;
Var
  fltSaldoAdiantamentos: Double;
  fltValorCredito: Double;
begin
  Result := True;

  If fltTotCadRec <= 0 Then
    Exit;

  If Not blnEhTelaAltItensPed Then
    Exit;

  If TAdiantamento.fPermiteAlterarPedidoComAdiantamento <> papSimSomenteReduzindoAQuantidadeOuEliminandoProdutos Then
    Exit;

  If fCfgSis('ALPDAC') <> Gerar_credito_do_valor_removido_apos_a_alteracao_do_pedido Then
    Exit;

  fltSaldoAdiantamentos := TAdiantamento.fGetTotaisAdiantamento(strNumOrc, strEspOrc, strEmpOri).fltValLan;

  If fFormataFloat(fltSaldoAdiantamentos, 2) <= 0.00 Then
    Exit;

  If fFormataFloat(fltSaldoAdiantamentos, 2) <= fFormataFloat(fltTotCadRec, 2) Then
    Exit;

  fltValorCredito := fFormataFloat(fltSaldoAdiantamentos - fltTotCadRec, 2);

  If fFormataFloat(fltValorCredito, 2) <= 0.00 Then
    Exit;

  Result := TAdiantamento.fGerarCreditoSaldoAdiantamento(strNumOrc,
                                                         strEspOrc,
                                                         strEmpOri,
                                                         strNomeForm,
                                                         strLoginUsuarioLogado,
                                                         False,
                                                         strCodCli,
                                                         fltValorCredito);
end;

function TFatVenda.RetornaPortadorDeBaixaCadRec(AContadorAdiantamento: Integer;
  APortadorBaixa: String; AValOrd: Double=0): String;
  Var
    LValorOrdemPagamento: Double;
    LTotalModalidades: Double;
    LTotalDemaisModalidades: Double;
    LAutoIncremChavePix: String;
Begin
  If blnExecutandoFaturadorAutomatico And blnSmartPOS And (intSeqDupBaiAdtCli = AContadorAdiantamento) Then
  Begin
    Result := fCampoTabela('OPE_PORAPP', 'CADOPE', ['OPE_CODOPE'], [Self.strCodDig], False);
    If Not Result.IsEmpty Then
      Exit;
  End;

  Result := IIF(((Not fEmptyStr(FPorAdt)) Or (Not fEmptyStr(strPorNotaEspFator))) And (intSeqDupBaiAdtCli = AContadorAdiantamento),
                IIF(Not fEmptyStr(strPorNotaEspFator), strPorNotaEspFator, FPorAdt),
                APortadorBaixa);

  If (AValOrd > 0) Then
  Begin
    LValorOrdemPagamento := AValOrd;
    LTotalModalidades    := AValOrd;

    LTotalDemaisModalidades := fFormataFloat(Self.fltValCqP + Self.fltValCqV + Self.fltValCar + Self.fltValFin + Self.fltValDin + Self.fltValOrd, 2);
    If (fCfgSis('DESMRC', varString) = 'S') And (LTotalDemaisModalidades > 0) Then
      If (fFormataFloat(Abs(LTotalDemaisModalidades - Self.fltValOrd), 2) > 0) Then
        Exit;
  End
  Else
  Begin
    LValorOrdemPagamento := Self.fltValOrd;
    LTotalModalidades    := fltTotGer - Abs(fltCredUtilizados);
  End;

  If fFormataFloat(LValorOrdemPagamento, 2) = 0 Then
    Exit;

  If Not Assigned(objResumoDeCaixa) Then
    Exit;

  If Not blnValGravaResCai Then
  Begin
    If fFormataFloat(Self.fltValAdt, 2) > 0 Then
      Result := RetornaPortadorAdiantamentoOrdemPagamento(Result);

    Exit;
  End;

  If fFormataFloat(fltCredUtilizados, 2) > 0 Then
  Begin
    If Self.blnDesmembramentodePedidos Then
      Exit;
  End;

  LAutoIncremChavePix := EmptyStr;
  If Self.DadosPixDaVenda.RecebidoPorPix.Equals('S') Then
  Begin
    If Assigned(Self.DadosPixDaVenda.LstPixPago) Then
    Begin
      LAutoIncremChavePix := Self.DadosPixDaVenda.LstPixPago[0].AutoIncremChavePix;

      If Not Self.FPortadorTFAutomatica.IsEmpty Then
      Begin
        If Not Self.FPortadorTFAutomatica.Equals(TPixDao.Create.RetornaPortadorChavePix(LAutoIncremChavePix)) Then
          LValorOrdemPagamento := fFormataFloat(LValorOrdemPagamento - Self.FValorTFAutomatica, 2);
      End;
    End;
  End;

  Result := objResumoDeCaixa.RetornaPortadorCADRECNoResumoDeCaixa(LAutoIncremChavePix,
                                                                  Result,
                                                                  Self.FPortadorTFAutomatica,
                                                                  LValorOrdemPagamento,
                                                                  LTotalModalidades,
                                                                  Self.DadosPixDaVenda.RecebidoPorPix.Equals('S'),
                                                                  True);

  If (Result='') Then
    Result := APortadorBaixa;
End;

procedure TFatVenda.RetornaPortadorEValorAdiantamentoCredito(Var APortador : String; Var AValor : Double);
  Var
    LConsulta : TUniQuery;
begin
  LConsulta := fCriaQuery();
  Try
    APortador := '';
    AValor := 0;
    LConsulta.Close;
    LConsulta.SQL.Clear;
    LConsulta.SQL.Add(' SELECT ADT_CODPOR, ADT_VALCRE ');
    LConsulta.SQL.Add('   FROM ADTCLI ');
    LConsulta.SQL.Add('  WHERE ADT_NUMDOC=:NUMDOC ');
    LConsulta.SQL.Add('    AND ADT_ESPDOC=:ESPDOC ');
    LConsulta.SQL.Add('    AND ADT_CODEMP=:CODEMP ');
    LConsulta.SQL.Add('    AND ADT_CODCLI=:CODCLI ');
    LConsulta.SQL.Add('    AND ADT_TIPLAN="C" ');
    LConsulta.SQL.Add('    AND ADT_ESTORN="N" ');
    LConsulta.SQL.Add('    AND ADT_RESCAI=1 ');
    LConsulta.SQL.Add('    AND ADT_VALCRE > 0 ');
    LConsulta.ParamByName('NUMDOC').AsString := Self.strNumOrc;
    LConsulta.ParamByName('ESPDOC').AsString := Self.strEspOrc;
    LConsulta.ParamByName('CODEMP').AsString := Self.strEmpOri;
    LConsulta.ParamByName('CODCLI').AsString := Self.strCodCli;
    LConsulta.Open;
    If (LConsulta.IsEmpty) Then
      Exit;
    APortador := LConsulta.FieldByName('ADT_CODPOR').AsString;
    AValor := LConsulta.FieldByName('ADT_VALCRE').AsFloat;
  Finally
    FreeAndNil(LConsulta);
  End;
end;

function TFatVenda.RetornaPortadorAdiantamentoOrdemPagamento(APortadorAtual: String): String;
  Var
    LConsulta: TUniQuery;

  procedure pConsultaPortador(const AFiltrarOrdemPagto : Boolean);
  begin
    LConsulta.Close;
    LConsulta.SQL.Clear;
    LConsulta.SQL.Add(' SELECT ADT_CODPOR ');
    LConsulta.SQL.Add('   FROM ADTCLI ');
    LConsulta.SQL.Add('  WHERE ADT_NUMDOC=:NUMDOC ');
    LConsulta.SQL.Add('    AND ADT_ESPDOC=:ESPDOC ');
    LConsulta.SQL.Add('    AND ADT_CODEMP=:CODEMP ');
    LConsulta.SQL.Add('    AND ADT_CODCLI=:CODCLI ');
    LConsulta.SQL.Add('    AND ADT_TIPLAN="C" ');
    LConsulta.SQL.Add('    AND ADT_ESTORN="N" ');
    LConsulta.SQL.Add('    AND ADT_RESCAI=1 ');
    If (AFiltrarOrdemPagto) Then
      LConsulta.SQL.Add('  AND ADT_VALORD > 0 ');
    LConsulta.ParamByName('NUMDOC').AsString := Self.strNumOrc;
    LConsulta.ParamByName('ESPDOC').AsString := Self.strEspOrc;
    LConsulta.ParamByName('CODEMP').AsString := Self.strEmpOri;
    LConsulta.ParamByName('CODCLI').AsString := Self.strCodCli;
    LConsulta.Open;
  End;

Begin
  Result := APortadorAtual;

  LConsulta := fCriaQuery;

  Try
    pConsultaPortador(True);

    If (LConsulta.IsEmpty) Then
      pConsultaPortador(False);

    If Not LConsulta.IsEmpty Then
    Begin
      If Not LConsulta.FieldByName('ADT_CODPOR').AsString.IsEmpty Then
        Result := LConsulta.FieldByName('ADT_CODPOR').AsString;

      If LConsulta.RecordCount > 1 Then
        Result := fCfgSis('PORRCX');
    End;
  Finally
    LConsulta.Close;

    FreeAndNil(LConsulta);
  End;
End;

