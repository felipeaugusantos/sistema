                                 FieldByName('FIN_VALFIN').AsFloat,
                                 0.0,
                                 '',
                                 strHisCtr,
                                 '',
                                 strPorBai,
                                 strCtaBai,
                                 strOpeBai,
                                 strSeqLan,
                                 fltValRec,
                                 dtaDtaRec,
                                 'N',
                                 strCodEve,
                                 '',
                                 strTipFor,
                                 strCodCnd,
                                 blnConApr,
                                 strCodCta,
                                 0,
                                 FieldByName('FIN_VALFIN').AsFloat,
