function TFatVenda.fRetornaTipoTravaSeOrcamentoComPerfilCondicao(AstrCampo: String; AstrCodCnd: String=''): String;
begin
  Result := 'T';
  If ((Self.strOpcDoc = 'OR') And (Not Self.fOrcamentoComoPedido)) Or
     ((strOpcDoc = 'VN') And (strEspDoc = 'OR')) Then
    Result := IfEmptyStr(fCampoTabela(AstrCampo, 'CADCND', ['CND_CODIGO'], [IfEmptyStr(AstrCodCnd, Self.strCodCnd)]), 'T');
end;

function TFatVenda.fVerificaIntervaloMargemValorCndPagto: Boolean;
begin
  Result := True;
  If (fCfgSis('USACND', varBoolean)) And (fCfgSis('PFLCLI', varBoolean)) Then
    Result := fVerificaIntervaloMargemValorCndPagto(Self.strCodCnd);
end;

function TFatVenda.fVerificaIntervaloMargemValorCndPagto(strCodCnd: String): Boolean;
  Var
    qryTmp: TUniQuery;
    blnOriginadoPorDesmembramento: Boolean;

begin
  Result := True;

  If Not fCfgSis('USACND', varBoolean) Then
    Exit;

  If Not fCfgSis('PFLCLI', varBoolean) Then
    Exit;

  blnOriginadoPorDesmembramento := Not fEmptyStr(fCampoTabela('TRIM(IFNULL(FGO_SEQDMP,""))',
                                                              'FATGOR INNER JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM',
                                                              ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP','FGO_CODCLI'],
                                                              [Self.strNumOrc, Self.strEspOrc, Self.strEmpOri, Self.strCodCli]));


  If blnOriginadoPorDesmembramento And fPedidoOriginalJaFaturado(Self.strNumOrc, Self.strEspOrc, Self.strEmpOri, Self.strCodCli) Then
    Exit;

  Try
    qryTmp := fCriaQuery(Self);
    qryTmp.SQL.Add(' SELECT CND_CODIGO, CND_MARMAX, CND_MARMIN, CND_FATMIN, CND_FATMAX, CND_PARMIN, CND_PARMAX, CND_TRAFAT, CND_TRAMAR, CND_TRAPAR ');
    qryTmp.SQL.Add('   FROM CADCND ');
    qryTmp.SQL.Add('  WHERE CND_CODIGO = ' + QuotedStr(strCodCnd));
    qryTmp.Open;

    If (qryTmp.FieldByName('CND_MARMIN').AsFloat > 0) Or (qryTmp.FieldByName('CND_MARMAX'). AsFloat > 0) Then
    Begin
      If Not fVerificaIntervaloMargemDocumento(qryTmp.FieldByName('CND_MARMIN').AsFloat,
                                               qryTmp.FieldByName('CND_MARMAX').AsFloat,
                                               qryTmp.FieldByName('CND_TRAMAR').AsString,
                                               qryTmp.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
    If (qryTmp.FieldByName('CND_FATMIN').AsFloat > 0) Or (qryTmp.FieldByName('CND_FATMAX'). AsFloat > 0) Then
    Begin
      If Not fVerificaIntervaloValorDocumento(qryTmp.FieldByName('CND_FATMIN').AsFloat,
                                              qryTmp.FieldByName('CND_FATMAX').AsFloat,
                                              qryTmp.FieldByName('CND_TRAFAT').AsString,
                                              qryTmp.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;
    If (qryTmp.FieldByName('CND_PARMIN').AsFloat > 0) Or (qryTmp.FieldByName('CND_PARMAX'). AsFloat > 0) Then
    Begin
      If Not fVerificaCondPagtoParcelaMinima(qryTmp.FieldByName('CND_PARMIN').AsFloat,
                                             qryTmp.FieldByName('CND_PARMAX').AsFloat,
                                             qryTmp.FieldByName('CND_TRAPAR').AsString,
                                             qryTmp.FieldByName('CND_CODIGO').AsString) Then
      Begin
        Result := False;
        Exit;
      End;
    End;

    qryTmp.Close;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '');
  End;
  FreeAndNil(qryTmp);
end;

function TFatVenda.fJaFoiLiberadoAvisado(strDirAce: String; strDirAceAuxiliar: String=''): Boolean;
  Var
    strTpTrava: String;
    blnBuscaPorDirAceAuxliar: Boolean;
begin
  Result := False;

  If (Pos(Self.strOpcDoc, 'VN_PD_OR_NE_EP_') > 0) Then
  Begin
    blnBuscaPorDirAceAuxliar := IIF(fEmptyStr(strDirAceAuxiliar), False, True);

    If blnLiberacaoRemotaNoFinalVenda Then
    Begin
      Result := (fLogAviExists(strDirAceAuxiliar, blnBuscaPorDirAceAuxliar));
      If (Not Result) Then
      Begin
        If ((Self.strOpcDoc = 'OR') And (Not Self.fOrcamentoComoPedido)) Then
          Result := (fLogAviAuxExists(strDirAceAuxiliar, blnBuscaPorDirAceAuxliar));
      End;
    End
    Else
      Result := (fLogLibExists(strDirAceAuxiliar, arrLogLib, blnBuscaPorDirAceAuxliar));

    If (Pos(strDirAce, 'INTFAT_INTPAR_') > 0) Then
    Begin
      strTpTrava := fRetornaTipoTravaSeOrcamentoComPerfilCondicao(IIF((strDirAce = 'INTFAT'), 'CND_TRORFI', 'CND_TRORPF'));
      If (strTpTrava = 'N') Then
      Begin
        Result := True
      End
      Else If (strTpTrava = 'A') Then
      Begin
        If (Not Result) Then
          Result := (fLogAviExists(strDirAceAuxiliar, blnBuscaPorDirAceAuxliar)) Or
                    (fLogAviAuxExists(strDirAceAuxiliar, blnBuscaPorDirAceAuxliar));
      End;
    End;
  End;
end;

Function TFatVenda.fCalculaPrecosLote(const strCodIte, strNumLot, strTabPre, strCodEmp : String; const fltQtdIte: Double; Var fltUnitar: Double) : Boolean;
begin
  fltUnitar := 0;
  Result := False;
  If (Not Self.objCadLot.fExisteLote(strCodIte, strCodEmp, strNumLot)) Then
    Exit;
  Result := Self.fCalculaPrecosLote(fltQtdIte, fltUnitar, strTabPre);
end;

Function TFatVenda.fCalculaPrecosLote(fltQtdIte: Double; Var fltUnitar: Double; strTabPre: String): Boolean;
  Var
    fltPreVen: Double;
    strCamPre: String;
Begin
  Result := False;

  strTabPre := IIF(fEmptyStr(strTabPre), Self.strTabPre, strTabPre);

  objCadLot.strOpcDoc := Self.strOpcDoc;
  objCadLot.intIdxEntRetLot := Self.intIdxEntRetLot;

  fltPreLot := objCadLot.fRetPrecoVendaLote(fltQtdIte, strTabPre);
  fltCusLot := objCadLot.fRetPrecoCustoLote(fltQtdIte);

  If blnCliFil Then
  Begin

    If fCfgSis('ESCPTE', varBoolean) Then
    Begin
      If fEmptyStr(strPreETe) Then
      Begin
        If (strPromoc = 'S') Then
          strPreETe := strTEPPRO
        Else
          strPreETe := strTEPREV;
      End;

      strCamPre := strPreETe;
    End
    Else
    Begin
      If (strPromoc = 'S') Then
        strCamPre := strTEPPRO
      Else
        strCamPre := strTEPREV;
    End;

    fltPreVen := 0;

    If SameText(strCamPre,'CUS') Then
    Begin
      If (fltCusLot > 0) Then
        fltPreVen := fltCusLot;
    End

    Else If (fltPreLot > 0) then
      fltPreVen := fltPreLot;

    If fltFat_TE > 0 Then
    Begin
      If (strPromoc <> 'S') Then 
        fltPreVen := fltPreVen * fltFat_TE;
    End
    Else If fltFatTE2 > 0 Then
    Begin
      If (strPromoc <> 'S') Then 
        fltPreVen := fltPreVen * fltFatTE2;
    End;

    If fltPreVen > 0 then
    Begin
      fltUniOri := fltPreVen;
      fltUniVis := fltPreVen;
      fltTaxJur := 0;
      fltUnitar := fltPreVen;
      Result    := True;
    End;
  End Else
  Begin
    If (fltPreLot > 0) And (strPromoc <> 'S') then
    Begin
      fltUniOri := fltPreLot;
      fltUniVis := fltPreLot;
      fltTaxJur := 0;
      fltUnitar := fltPreLot;
      Result    := True;
    End;
  End;
End;

