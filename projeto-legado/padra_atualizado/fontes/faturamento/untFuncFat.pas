function TFatVenda.fDeveSerGeradoPedidoDeReservaEstoqueParaEnderecamento_RotinaDevolucao: Boolean;
  Var
    strAuxMsg: String;
begin

  Result := False;

  If blnDevAutomatizadaDocOutraEmpresa Then
    Exit;

  If blnEspelhoDevolucaoCliente Then
    Exit;

  If fEhRecGarantia Then
    Exit;

  If (Pos(strOpcDoc,'DV_CR_DD_OE_EF_') <= 0) Then
    Exit;

  If Self.GetDevolvendoMercadoriaDoEstoqueExterno Then
    Exit;

  If Self.blnEhDevolucaoAbastecimentoDeposito Then
    Exit;

  If Self.blnEhBaixaEntregaFuturaQtdBaixarDevolver Then
    Exit;

  If fUsaRotinaWMS Then
  Begin
    strAuxMsg := '';
    If (Not fCfgSis('DEVEND', varBoolean)) Then
      strAuxMsg := strAuxMsg + IIF(strAuxMsg.IsEmpty, '', ', ') + 'CFG_DEVEND';
    If (Not fCfgSis('ENTEND', varBoolean)) Then
      strAuxMsg := strAuxMsg + IIF(strAuxMsg.IsEmpty, '', ', ') + 'CFG_ENTEND';

    If (Not strAuxMsg.IsEmpty) Then
    Begin
      If fTemLoteADefinir Then
      Begin
        Raise ExceptionAutCom.Create('Atenção! Essa empresa utiliza WMS, no entanto, a(s) configuração(ões) de endereçamento ('+strAuxMsg+') '+
                                     'está(ão) desligada(s). Fale com o responsável ou habilite a(s) configuração(ões)');
      End;
    End;
  End;

  If Not fCfgSis('DEVEND', varBoolean) Then
    Exit;

  If Not fUsaEnderecamento Then
    Exit;

  Result := True;

end;

