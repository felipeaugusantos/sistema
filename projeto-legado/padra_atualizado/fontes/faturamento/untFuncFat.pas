procedure TFatVenda.pBackupExpRet(strNumDoc, strEspDoc, strCodEmp: String);
Var
  qryExpRet: TUniQuery;
begin
  If Assigned(Self.cdsExpRet) Then
    FreeAndNil(Self.cdsExpRet);

  qryExpRet := fCriaQuery(Nil);
  try
    With qryExpRet, SQL Do
    Begin
      Clear;
      Add('SELECT * FROM EXPRET');
      Add('INNER JOIN FATGOR ON EXP_SEQFGO = AUTOINCREM');
      Add('WHERE FGO_NUMDOC = :NUMDOC');
      Add('  AND FGO_ESPDOC = :ESPDOC');
      Add('  AND FGO_CODEMP = :CODEMP');
      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;

      cdsExpRet := fCriaClientDatset(qryExpRet);

      Close;

    End;
  finally
    FreeAndNil(qryExpRet);
  end;
End;

