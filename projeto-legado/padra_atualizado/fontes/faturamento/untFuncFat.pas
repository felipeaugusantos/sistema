function TFatVenda.fGravarPenRec: Boolean;
  Var
    objPendenciaRecebimento: TPenRecController;
    objItemFechamento      : TDadosFechamento;
    intTotItensGravados    : Integer;
begin

  intTotItensGravados := 0;

  objPendenciaRecebimento := TPenRecController.Create;

  Try

    For objItemFechamento in Self.arrMatItens Do
    Begin

      If fGravarPendenciaDeRecebimento(objItemFechamento) Then
      Begin

        If objPendenciaRecebimento.fGravar(strNumDoc,
                                           strEspDoc,
                                           VS_strCodEmp,
                                           strCodCli,
                                           objItemFechamento.strCodIte,
                                           'P',
                                           '',
                                           '',
                                           '',
                                           objItemFechamento.fltTotIte,
                                           VS_Date,
                                           fRetHoraServidor,
                                           objItemFechamento.fltQtdIte) Then
        Begin
          Inc(intTotItensGravados);
        End;

      End;

    End;

    Result := (intTotItensGravados > 0);

  Finally
    FreeAndNil(objPendenciaRecebimento);
  End;

end;

function TFatVenda.fRetornaValorFaturadoEntregaFuturaMultiplasFormasPagamento(strIncOrc: String): Double;
var
  qryFaturado: TUniQuery;
begin
  Result := 0;

  if fEmptyStr(strIncOrc) then
    Exit;

  qryFaturado := fCriaQuery;

  try
    qryFaturado.Close;
    qryFaturado.SQL.Clear;
    qryFaturado.SQL.Add('SELECT FPN_VALFPG');
    qryFaturado.SQL.Add('FROM FPGNEG');
    qryFaturado.SQL.Add('WHERE FPN_SEQFGO = :INCORC');
    qryFaturado.SQL.Add('AND FPN_CODFPG = "008"');

    qryFaturado.ParamByName('INCORC').AsString := strIncOrc;

    qryFaturado.Open;

    if qryFaturado.IsEmpty then
      Exit;

    while not qryFaturado.Eof do
    begin
      Result := Result + qryFaturado.FieldByName('FPN_VALFPG').AsFloat;
      qryFaturado.Next;
    end;
  finally
    FreeAndNil(qryFaturado);
  end;
end;

function TFatVenda.fGravarPendenciaDeRecebimento(objItem: TDadosFechamento) : Boolean;
begin

  Result := False;

  If Not fProdutoDeVendaABaseDeTroca(objItem.strCodIte) Then
    Exit;

  If (objItem.strBasTro.Equals('S')) Then
    Exit(True);

  If (fFechandoOREmPD) Then
    Exit(True);

end;

procedure TFatVenda.pBuscaItensDeRecebimentoABaseDeTroca(Var qryTabela: TUniQuery; dteInicial, dteFinal: TDate);
begin
  qryTabela.Close;
  qryTabela.SQL.Clear;
  qryTabela.SQL.Text := fSQLItensRecebimentoABaseDeTroca;
  qryTabela.ParamByName('DTAINI').AsDate := dteInicial;
  qryTabela.ParamByName('DTAFIN').AsDate := dteFinal;
  qryTabela.Open;
end;

function TFatVenda.fSQLItensRecebimentoABaseDeTroca: String;
begin
  Result := ' SELECT                                   '+
            '   MOVDET.*                               '+
            ' FROM                                     '+
            '   MOVDET                                 '+
            ' INNER JOIN CADITE                        '+
            '   ON ITE_CODITE = DET_CODITE             '+
            ' WHERE                                    '+
            '   DET_DTAENT BETWEEN :DTAINI AND :DTAFIN '+
            '   AND ITE_GERNTE = ''S''                 '+
            '   AND DET_ESPDOC = ''RB''                '+
            '   AND DET_CODEMP = ' + QuotedStr(VS_strCodEmp);
end;

function TFatVenda.fProdutoDeVendaABaseDeTroca(strCodIte: String): Boolean;
  Var
    qryTabela: TUniQuery;
begin
  qryTabela := fCriaQuery(Nil);

  Try
    qryTabela.Close;
    qryTabela.SQL.Clear;
    qryTabela.SQL.Text := fSQLProdutoDeVendaABaseDeTroca;
    qryTabela.ParamByName('CODITE').AsString := strCodIte;
    qryTabela.Open;

    Result := (Not qryTabela.IsEmpty);
  Finally
    FreeAndNil(qryTabela);
  End;
end;

function TFatVenda.fSQLProdutoDeVendaABaseDeTroca: String;
begin
  Result := ' SELECT                   '+
            '   ITE_CODITE             '+
            ' FROM                     '+
            '   CADITE                 '+
            ' WHERE                    '+
            '   ITE_BASTRO = ''S'' AND '+
            '   ITE_TPPROD = ''V'' AND '+
            '   ITE_CODITE = :CODITE   ';
end;

function TFatVenda.fEhServicoQuePermiteBrinde(const strCodSer: String): Boolean;
var
  qryDados: TUniQuery;
begin
  If (fEmptyStr(strCodSer)) Then
    Exit(False);

  qryDados := fCriaQuery;
  Try
    qryDados.SQL.Text := 'SELECT SER_CODSER FROM CADSER '
                       + ' WHERE SER_CODSER = :CODSER '
                       + '   AND SER_PERBRD = "S" ';

    qryDados.ParamByName('CODSER').AsString := strCodSer;
    qryDados.Open;

    Result := qryDados.RecordCount > 0;
  Finally
    FreeAndNil(qryDados);
  End;
end;

function TFatVenda.fGravarPenRecDesmembramento: Boolean;
Var
  objPendenciaRecebimento: TPenRecController;
  objItemFechamento      : TDadosFechamento;
  intContador,
  intTotItensGravados    : Integer;
  objDocumento           : TDadosImpressaoVenda;
begin

  intTotItensGravados := 0;
  objPendenciaRecebimento := TPenRecController.Create;

  Try

    For intContador := 0 To objFatVendaImp.ItemsCount -1 Do
    Begin

      objDocumento := objFatVendaImp[intContador];

      For objItemFechamento in objDocumento.arrMatItens Do
      Begin

        If fGravarPendenciaDeRecebimento(objItemFechamento) Then
        Begin

          If objPendenciaRecebimento.fGravar(objDocumento.strNumDoc,
                                             objDocumento.strEspDoc,
                                             objDocumento.strEmpDoc,
                                             objDocumento.strCodCli,
                                             objItemFechamento.strCodIte,
                                             'P',
                                             '',
                                             '',
                                             '',
                                             objItemFechamento.fltTotIte,
                                             VS_Date,
                                             fRetHoraServidor,
                                             objItemFechamento.fltQtdIte) Then
          Begin
            Inc(intTotItensGravados);
          End;

        End;

      End;

    End;

    Result := (intTotItensGravados > 0);

  Finally
    FreeAndNil(objPendenciaRecebimento);
  End;

end;

procedure TFatVenda.pCarregaTrocaRecebimento(strNumDoc, strEspDoc, strCodEmp, strCodCli: String; blnMultiplosDoc: Boolean = False);
var
  frmVendaBaseTrocaRecebimento: TfrmVendaBaseTrocaRecebimento;
  intCnt: Integer;
  documento: TDadosImpressaoVenda;
  objItem: TDadosFechamento;
begin
  pCriarFormularios(TfrmVendaBaseTrocaRecebimento, frmVendaBaseTrocaRecebimento);
  Try

    If blnMultiplosDoc Then
    Begin
      For intCnt := 0 To objFatVendaImp.ItemsCount -1 Do
      Begin
        documento := objFatVendaImp[intCnt];

        For objItem in documento.arrMatItens Do
        Begin

          If fGravarPendenciaDeRecebimento(objItem) Then
          Begin
            frmVendaBaseTrocaRecebimento.objVendaTrocaRec.fAddDocFinPen(documento.strNumDoc,
                                                                        documento.strEspDoc,
                                                                        documento.strEmpDoc,
                                                                        documento.strCodCli);
          End;

        End;
      End;

    End
    Else
    Begin
      frmVendaBaseTrocaRecebimento.objVendaTrocaRec.fAddDocFinPen(strNumDoc, strEspDoc, strCodEmp, strCodCli);
    End;

    frmVendaBaseTrocaRecebimento.blnEhFinaceiroPendente := True;
    frmVendaBaseTrocaRecebimento.ShowModal;
  Finally
    pFreeAndNil(frmVendaBaseTrocaRecebimento);
  End;
end;

