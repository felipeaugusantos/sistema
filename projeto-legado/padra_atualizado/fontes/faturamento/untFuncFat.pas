function TFatVenda.fAutorizarEmitirPedidoYapayValorMaiorCfgYAPSSR(
  const objLiberacao: TLiberacao; const strTiposEntrega: String): Boolean;
begin
  objLiberacao.Clear;
  objLiberacao.objMsgLibera.pAddTexto('YAPAY - Emitir Pedido com Itens Retira com valor acima do permitido');
  objLiberacao.objMsgLibera.pAddQuebra;
  objLiberacao.objMsgLibera.pAddTextoCaption('Valor Documento', FormatFloat('###,###,##0.00', fltTotGer)     , 16);
  objLiberacao.objMsgLibera.pAddTextoCaption('Cliente'        , strCodCli + ' - ' + strCliNom                , 16);
  objLiberacao.objMsgLibera.pAddTextoCaption('Nome Fantasia'  , fRetNomFantasia(strCodCli)                   , 16);
  objLiberacao.objMsgLibera.pAddTextoCaption('CPF/CNPJ'       , fFormataCpfCgc(strCliCgc, fSetaPais)         , 16);
  objLiberacao.objMsgLibera.pAddTextoCaption('Cond. Pagto'    , strCodCnd + '-' + fFormataCondPag(strCodCnd) + '-' + fRetDesConPag(strCodCnd), 16);
  objLiberacao.objMsgLibera.pAddTextoCaption('Forma Pagto'    , strCodFpg + '-' + strDesFpg, 16);

  pMontaMensagem(cdsVenda, objLiberacao.objMsgRemota, nil, False, True, nil, nil, True, nil, True, strTiposEntrega);

  objLiberacao.strDirAce := 'DIRYAPSSR';
  objLiberacao.blnMosMen := True;
  objLiberacao.strCodOpe := strCodVen;
  objLiberacao.strCodDig := strCodDig;

  Result := fFatMensagemLiberacao(objLiberacao);
end;

function TFatVenda.fLiberarEmitirPedidoYapayValorMaiorCfgYAPSSR(
  const objLiberacao: TLiberacao): Boolean;
var
  fltTotalPedidoRetira: Double;
begin
  Result := True;

  If ((Pos(strOpcDoc, 'PD_OR_VN_') > 0) And (Pos(strEspDoc, 'PD_') > 0)) And
     (TYapayFacade.fCondicaoPagamentoGeraCobranca(strCodCnd)) And
     (fCfgSis('YAPSSR', varDouble) > 0) Then
  Begin
    fltTotalPedidoRetira := fTotalProdutosTipoRetirada('R_');
    If fltTotalPedidoRetira > fCfgSis('YAPSSR', varDouble) Then
      Result := fAutorizarEmitirPedidoYapayValorMaiorCfgYAPSSR(objLiberacao, 'R_');
  End;
end;

