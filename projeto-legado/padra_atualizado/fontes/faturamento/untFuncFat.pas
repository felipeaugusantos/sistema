        Else
        Begin
          For intContador := 1 To 7 Do
            pStepStatusGravacao;
        End;
      End;

      {*****************************************}
      {* CR - Retorno de Consignação           *}
      {**************************************MM*}
      If (strEspDoc = 'CR') Then
      Begin
        pInfoStatusGravacao('Aguarde... Gravando Documento ' + strNumDoc + '-' + strEspDoc);

        {*****************************************}
        {* GRAVA MOVGER                          *}
        {**************************************MV*}
        If (Not fGMovGer) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA MOVDET                          *}
        {**************************************MV*}
        If (Not fGMovDet) Then
        Begin
          fCancelaTransac;
          Result := False;
          Exit;
        End;

        pStepStatusGravacao;

        {*****************************************}
        {* GRAVA CADREC                          *}
        {**************************************MV*}
        If (blnGravarCadRec) Then
        Begin
          pInfoStatusGravacao('Aguarde... Gravando Contas a Receber');

          If (Not fGCadRec) Then
          Begin
            fCancelaTransac;
            Result := False;
            Exit;
          End;

          pInfoStatusGravacao('Aguarde... Gravando Clube de Fidelidade');
          pStepStatusGravacao;

          {**************************************}
          {* GRAVA CLUBE DE FIDELIDADE :-)      *}
          {***********************************AF*}
          If (Not fGCluFid) Then
          Begin
