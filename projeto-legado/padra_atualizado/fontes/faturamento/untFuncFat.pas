Function TFatVenda.fClienteFilialVenda(strCodCli: String): Boolean;
  Var
    strEmpTmp : String;
Begin
  If strCodCli <> recDadCli.strCliFil Then
  Begin
    strEmpTmp := IIF(fEmptyStr(strEmp_TE), VS_strCodEmp, strEmp_TE);
    recDadCli.blnCliFil := fClienteFilial(strCodCli);
    recDadCli.strCliFil := strCodCli;
    recDadCli.fltFat_TE := fRetClienteFilialFatorTE(strEmpTmp, strCodCli);
    recDadCli.fltFatTE2 := fRetClienteFilialFatorTE_ST(strEmpTmp, strCodCli);
    recDadCli.strTEPREV := fGetTEPREV(strEmpTmp, strCodCli);
    recDadCli.strTEPPRO := fGetTEPPRO(strEmpTmp, strCodCli);
  End;

  Result := recDadCli.blnCliFil;
End;

