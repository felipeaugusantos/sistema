function TfrmFatRomaneio.fDefineLotesPedidos : Boolean;
  Var
    qryRomGer : TUniQuery;
    strSemPic : String;
    objMovimentacao : TMovimentacaoProgramada;
    intIndice: integer;
Begin

  Try

    Result := True;

    qryRomGer := fCriaQuery;

    With qryRomGer, SQL Do
    Begin

      //Antes verifica se existe algum item sem picking, se houver nem prosegue com a separaçao;
      Close;

      Clear;
      Add(' SELECT FDO_CODITE AS CODITE,                           ');
      Add('        ITE_DESITE AS DESITE                            ');
      Add(' FROM                                                    ');
      Add('   FATGOR G                                              ');
      Add('   INNER JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = G.AUTOINCREM ');
      Add('   INNER JOIN FATDOR ON FATDOR.FDO_SEQGER = G.AUTOINCREM ');
      Add('   INNER JOIN CADITE  ON ITE_CODITE = FDO_CODITE        ');
      Add('   INNER JOIN ROMGERX ON GER_NUMDOC = FDO_NUMDOC        ');
      Add('                     AND GER_ESPDOC = FDO_ESPDOC        ');
      Add('                     AND GER_CODEMP = FDO_CODEMP        ');
      Add('                     AND GER_CODCLI = FDO_CODCLI        ');
      Add(' WHERE GER_NUMROM = :NUMROM                             ');
      Add('   AND GER_EMPROM = :EMPROM                             ');
      Add('   AND ((SELECT                                         ');
      Add('          COUNT(0)                                      ');
      Add('        FROM                                            ');
      Add('          CADLOT                                        ');
      Add('          INNER JOIN CADLOC ON LOC_CODLOC = LOT_LOCFIS  ');
      Add('                           AND LOC_CODEMP = LOT_CODEMP  ');
      Add('        WHERE                                           ');
      Add('              LOT_CODEMP = GER_EMPROM                   ');
      Add('          AND LOT_CODITE = ITE_CODITE                   ');

      {Pedidos "Lote Crítico" FGO_LOTCRI = "S", os lotes serão definidos sem Picking!
       ou seja, não devem travar o processo aqui!}
      Add('          AND LOC_PICKIN = "S") = 0 ) ');

      ParamByName('NUMROM').AsString := strNumRomPrevia;
      ParamByName('EMPROM').AsString := VS_strCodEmp;

      Open;

      strSemPic := '';
      While not Eof Do
      Begin

        If not fEmptyStr(strSemPic) Then
          strSemPic := strSemPic + #13;

        strSemPic := strSemPic + FieldByName('CODITE').AsString + ' - ' + FieldByName('DESITE').AsString;

        Next;
      End;

      Close;
      Clear;

      If (Not fEmptyStr(strSemPic)) Then
      Begin
        Result := False;
        fMensagem('', 'Os itens abaixo não possuem picking ativo, verificar!' + #13 + strSemPic, ['&OK']);
        Exit;
      End;

      Add(' SELECT FGO_NUMDOC        AS NUMDOC,             ');
      Add('        FGO_ESPDOC        AS ESPDOC,             ');
      Add('        FGO_CODEMP        AS CODEMP,             ');
      Add('        FGO_CODCLI        AS CODCLI,             ');
      Add('        FGO_SEPIMP        AS SEPIMP,             ');
      Add('        FGO_SEPEXP        AS SEPEXP,             ');
      Add('        FATGOR.AUTOINCREM AS AUTINC              ');
      Add(' FROM FATGOR                                     ');
      Add('   INNER JOIN EXTGOR  ON FGO_SEQFGO = AUTOINCREM ');
      Add('   INNER JOIN ROMGERX ON GER_NUMDOC = FGO_NUMDOC ');
      Add('                     AND GER_ESPDOC = FGO_ESPDOC ');
      Add('                     AND GER_CODEMP = FGO_CODEMP ');
      Add('                     AND GER_CODCLI = FGO_CODCLI ');
      Add(' WHERE GER_NUMROM = :NUMROM                      ');
      Add('   AND GER_EMPROM = :EMPROM                      ');

      ParamByName('NUMROM').AsString := strNumRomPrevia;
      ParamByName('EMPROM').AsString := VS_strCodEmp;

      Open;

      TItensNaoAtendidosSeparacaoWMS.pLimpar;

      First;
      While Not Eof Do
      Begin

        Try
          pCriarFormularios(TfrmFatDefineLotesPedidoWMS, frmFatDefineLotesPedidoWMS);
          Try
            frmFatDefineLotesPedidoWMS.strNumPed := FieldByName('NUMDOC').AsString;
            frmFatDefineLotesPedidoWMS.strEmpPed := FieldByName('CODEMP').AsString;
            frmFatDefineLotesPedidoWMS.strCodCli := FieldByName('CODCLI').AsString;

            //O Separador nesse caso é por item definido no Coletor de Dados.
            frmFatDefineLotesPedidoWMS.strCodSep := FieldByName('SEPEXP').AsString;
            frmFatDefineLotesPedidoWMS.pAtuSepPed:= Nil;
            frmFatDefineLotesPedidoWMS.blnApenasImpressao := True;

            If (Length(arrDadosCodBarra) > 0) And fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis Then
            Begin
              SetLength(frmFatDefineLotesPedidoWMS.arrDadosCodBarra, Length(arrDadosCodBarra));
              for intIndice := Low(arrDadosCodBarra) to High(arrDadosCodBarra) do
                frmFatDefineLotesPedidoWMS.arrDadosCodBarra[intIndice] := arrDadosCodBarra[intIndice];
            End;

            if frmFatDefineLotesPedidoWMS.fCriarObjetos Then
            Begin

              frmFatDefineLotesPedidoWMS.btnConfirma.Click;

              Result := frmFatDefineLotesPedidoWMS.blnConfirma And
                        frmFatDefineLotesPedidoWMS.blnSepImp;

              RealizarMovimentacaoProgramadaPedido(FieldByName('AUTINC').AsString,
                                                   frmFatDefineLotesPedidoWMS.blnConfirma);
            End
            Else
              Result := False;
          Except
            On E: Exception Do
            Begin
              Result := False;
              pMensagensErro(E.Message, '');
            End;
          End;
        Finally
          pFreeAndNil(frmFatDefineLotesPedidoWMS);
        End;

        If Not Result Then
        Begin
          fMensagem('', 'Não foi possível selecionar os lotes para todos pedidos!', ['&Ok']);
          Break;
        End;

        Next;
      End;

      If Result and  fCfgSis('WMSMOV', varBoolean) Then
      begin
        objMovimentacao := TMovimentacaoProgramadaRomaneio.Create(strNumRomPrevia);
        try
          Try
            //Apos imprimir a separação verifica se tem algum item do pedido no qual precisa fazer movimentaçao programada;
            objMovimentacao.fRealizaMovimentos;
          Except
            On E : Exception Do
              fMensagem('', E.Message, ['&OK']);
          End;
        finally
          FreeAndNil(objMovimentacao);
        end;

      end;

      Result := TItensNaoAtendidosSeparacaoWMS.isEmpty;

      TItensNaoAtendidosSeparacaoWMS.pExibeItens;
    End;
  Finally
    qryRomGer.Close;
    FreeAndNil(qryRomGer);
  End;

End;

