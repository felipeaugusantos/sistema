                           ATransMot.strCodMot,   // Motorista
                           ATransMot.strCodAj1,   // Ajudante 1
                           ATransMot.strCodAj2,   // Ajudante 2
                           ATransMot.strCodAj3,   // Ajudante 3
                           ATransMot.strCodAj4,   // Ajudante 4
                           ATransMot.strObsFec,   // Observação do Fechamento Romaneio
                           ATransMot.strCodReg,   // Região
                           dtaDtaRom,   // Data do Romaneio
                           dtaHorRom,   // Hora do Romaneio
                           strLoginUsuarioLogado,  // Operador que realizou o romaneio
                           LRecRomGer.intOrdImp,   // Ordem de Impressao
                           LRecRomGer.fltVlrOri,   // Valor original do
                           strOpeSol,              // Operador Solicitante
                           LRecRomGer.strAutEnt,   // Ref de Endereco de Entrega
                           fltVlrFre,
                           fltVlrAdi,
                           fltPerFre,
                           LRecRomGer.strMsgExp,
                           LRecRomGer.strPalet,
                           LRecRomGer.strStatus,
                           ATransMot.strNumBox,
                           LRecRomGer.strNomTab,
                           strEntSai,
                           LRecRomGer.strAutIncGer,
                           LRecRomGer.strMenExp,
                           LRecRomGer.strMenEx2,
                           LRecRomGer.strMenEx3,
                           LRecRomGer.strMenEx4,
                           LRecRomGer.strLocali,
                           LRecRomGer.strLibApp,
                           LRecRomGer.strEvitar,
                           LRecRomGer.fltDistan,
                           LRecRomGer.fltTmpEnt,
                           LRecRomGer.strEndEnt,
                           LRecRomGer.strBaiEnt,
                           LRecRomGer.strCepEnt,
                           LRecRomGer.strCidEnt,
                           LRecRomGer.strRefEnt,
                           LRecRomGer.strFilial,
                           LRecRomGer.strIniPar,
                           IIF(strTipEnt = 'R', strCodFil, ''),
                           LRecRomGer.strSeqTra,
                           LRecRomGer.strAltEnd,
                           qryRomGerX,
                           LRecRomGer.strLatLon,
                           LRecRomGer.intPriori,
                           LRecRomGer.strIntFus,
                           LRecRomGer.strRomFus,
                           LRecRomGer.dtaDtaIni,
                           LRecRomGer.hraHorIni,
                           LRecRomGer.strFstSht,
                           LRecRomGer.strFinRot,
                           FInsertsInBatchRomGerX,
                           FInsertsInBatchAuxRomX,
                           FInsertsInBatchRomCnd,
                           AAutInc,
                           LRecRomGer.strDefCon);

    If (Not Result) Then
      Exit;

    objAuditRomaneio.Adicionar(strAutInc, 'ROMGERX');

    TTestabilidade.fGetTestabilidade.NumeroDocumento  := strNumRom;
    {*******************************************}
    {* GRAVA HISTÓRICO DO PEDIDO.              *}
    {****************************************MV*}
    If (Not fEmptyStr(strNumDocHis)) Then
    Begin
      If (Not fEmptyStr(ATransMot.strCodMot)) Or (fEhRomaneioSimplificado) Then
      begin
        if fGravacaoEmLote then
          FInsertsInBatchHisPed.AddCommand('(' + QuotedStr(strNumDocHis) + ', ' +
                                                 QuotedStr(strEspDocHis) + ', ' +
                                                 QuotedStr(strNumRom) + ', ' +
                                                 QuotedStr(FormatDateTime('YYYY-MM-DD hh:mm:ss', VS_Date)) + ', ' +
                                                 QuotedStr(FormatDateTime('YYYY-MM-DD hh:mm:ss', fTime())) + ', ' +
                                                 IIF(fEmptyStr(ATransMot.strCodMot), 'NULL', QuotedStr(ATransMot.strCodMot)) + ', ' +
                                                 IIF(fEmptyStr(ATransMot.strCodTra), 'NULL', QuotedStr(ATransMot.strCodTra)) + ', ' +
                                                 QuotedStr(strCodEmpHis) + ', ' +
                                                 '0, ' +
                                                 QuotedStr(fRetAutoIncrem('HISPED', VS_strCodEmp)) + ')')
        else
          Result := objHisPed.fGravarHistorico(strNumDocHis,
                                               strEspDocHis,
                                               strCodEmpHis,
                                               strNumRom,
                                               VS_Date,
                                               fTime(),
                                               ATransMot.strCodMot,
                                               ATransMot.strCodTra);
      end;

      If (VS_strHabilitarCRM) And (Not fEmptyStr(fCfgSis('VENORC', varString))) And
        (Not fEmptyStr(fCfgSis('VENPED', varString))) Then
      begin
        If (Pos(strOpcRom, '1_5_') > 0) And (blnPedOrc) Then
        Begin
          if fGravacaoEmLote then
            FTemporariaDocumentosRomaneio.fInserirDocumentoTmpCRM(FTabTmpCRM, 'FATGOR', LRecRomGer.strNumDoc, LRecRomGer.strEspDoc,
              LRecRomGer.strCodEmp, LRecRomGer.strAutIncGer, LRecRomGer.strCodCli, LRecRomGer.strCodVen, strEntSai, strNumRom)
          else
            fAtualizaInformacoesCRMLocal(LRecRomGer.strNumDoc,
                                         LRecRomGer.strEspDoc,
                                         LRecRomGer.strCodEmp,
                                         LRecRomGer.strAutIncGer,
                                         LRecRomGer.strCodCli,
                                         LRecRomGer.strCodVen,
                                         ATransMot.strCodMot,
                                         ATransMot.strCodTra,
                                         strNumRom,
                                         '',
                                         '',
                                         strEntSai);
        End
        Else
        Begin
          if fGravacaoEmLote then
            FTemporariaDocumentosRomaneio.fInserirDocumentoTmpCRM(FTabTmpCRM, 'MOVGER', LRecRomGer.strNumDoc, LRecRomGer.strEspDoc,
              LRecRomGer.strCodEmp, LRecRomGer.strAutIncGer, LRecRomGer.strCodCli, LRecRomGer.strCodVen, strEntSai, strNumRom)
          else
          begin
            qryPedido.Close;
            qryPedido.ParamByName('NUMDOC').AsString := LRecRomGer.strNumDoc;
            qryPedido.ParamByName('ESPDOC').AsString := LRecRomGer.strEspDoc;
            qryPedido.ParamByName('CODEMP').AsString := LRecRomGer.strCodEmp;
            qryPedido.Open;

            If Not qryPedido.IsEmpty Then
            Begin
              qryPedido.First;

              While Not qryPedido.Eof Do
              Begin
                fAtualizaInformacoesCRMLocal(LRecRomGer.strNumDoc,
                                             LRecRomGer.strEspDoc,
                                             qryPedido.FieldByName('FGO_CODEMP').AsString,
                                             qryPedido.FieldByName('AUTOINCREM').AsString,
                                             LRecRomGer.strCodCli,
                                             LRecRomGer.strCodVen,
                                             ATransMot.strCodMot,
                                             ATransMot.strCodTra,
                                             strNumRom,
                                             qryPedido.FieldByName('FGO_NUMDOC').AsString,
                                             qryPedido.FieldByName('FGO_ESPDOC').AsString,
                                             strEntSai);
                qryPedido.Next;
              End;
            End;
          end;
        End;
      end;
    End;

    If (Not Result) Then
      Exit;

    If (LRecRomGer.strEspDoc <> 'OX') Then
    Begin
      Result := fAtualizaQtdBaiDet(LRecRomGer.strNumDoc, LRecRomGer.strEspDoc, LRecRomGer.strCodCli, LRecRomGer.strCodEmp,
                                   blnPedOrc, strNumRom,
                                   qryMovGer.FieldByName('GER_NOMTBL').AsString,
                                   strAutInc,
                                   strEntSai,
                                   qryMovGer.FieldByName('GER_CLAFIS').AsString);

      if fGravacaoEmLote then
        FListaAutIncRom.Add(strAutInc)
      else
      begin
        blnGerouUmRomaneioOrfao := (fCampoTabela('COUNT(*)', 'ROMDETX', ['DET_SEQGER'], [strAutInc]) = 0);

        If blnGerouUmRomaneioOrfao Then
          Result := False;
      end;
    End; 

    If (Result) Then
    Begin
      pRetNumeroPedidoVenda(LRecRomGer.strNumDoc, LRecRomGer.strEspDoc, LRecRomGer.strCodEmp, LRecRomGer.strCodCli, strNumPedTmp, strEmpPedTmp);

      objDadosDisparoAutomatico := TDadosDisparoAutomatico.Create;
      objDadosDisparoAutomatico.strNumDoc := LRecRomGer.strNumDoc;
      objDadosDisparoAutomatico.strEspDoc := LRecRomGer.strEspDoc;
      objDadosDisparoAutomatico.strNumPed := strNumPedTmp;
      objDadosDisparoAutomatico.strEmpPed := strEmpPedTmp;
      objDadosDisparoAutomatico.strCodCli := LRecRomGer.strCodCli;

      objListDadosDisparoAutomatico.Add(objDadosDisparoAutomatico);

    End;

    if Result and (strTipEnt = 'B') and (LRecRomGer.strEspDoc <> 'OX') then
      Result := fGravaRomTra(strAutInc, strCodFil, FInsertsInBatchRomTraX);

    if (Result) and (not fEmptyStr(cdsTmpDoc.FieldByName('ROMTRA').AsString)) then
    begin
      FListRomTra.Add(cdsTmpDoc.FieldByName('ROMTRA').AsString);

      if (not fGravacaoEmLote) and (fTodosItensDoTransbordoForamRomaneados(cdsTmpDoc.FieldByName('ROMTRA').AsString)) then
        Result := fBaixaTransbordo(cdsTmpDoc.FieldByName('ROMTRA').AsString);
    end;
  Finally
    FreeAndNil(qryGenDet);
    FreeAndNil(qryPedido);
    FreeAndNil(objHisPed);
    FreeAndNil(stlTmp);
  End;
end;

procedure TfrmFatRomaneio.pImpEtiDespachoDocumentos;
var
  qryDocs: TDataSet;
begin
  qryDocs := dbgDocumentosDBView.DataController.DataSet;

  qryDocs.First;
  while not qryDocs.Eof do
  begin
    if fTransportadoraCorreio(qryDocs.FieldByName('GER_TRADOC').AsString) then
    begin
      while not fImpEtiDespacho(qryDocs) do
        pMensagemOk('Impressão não realizada, tente novamente!');
    end;

    qryDocs.Next;
  end;
end;

function TfrmFatRomaneio.fImpEtiDespacho(qryDocs: TDataSet): Boolean;
var
  frmImpEtiDespacho: TfrmImpEtiDespacho;
begin
  pCriarFormularios(TfrmImpEtiDespacho, frmImpEtiDespacho);
  try
    frmImpEtiDespacho.blnExpedi      := True;
    frmImpEtiDespacho.edtNumDoc.Text := qryDocs.FieldByName('GER_DOCORI').AsString;
    frmImpEtiDespacho.edtEspDoc.Text := qryDocs.FieldByName('GER_ESPDOC').AsString;
    frmImpEtiDespacho.edtCodEmp.Text := qryDocs.FieldByName('GER_CODEMP').AsString;
    frmImpEtiDespacho.edtQtdVol.Text := '0';
    frmImpEtiDespacho.strCodCli      := qryDocs.FieldByName('GER_CODCLI').AsString;
    frmImpEtiDespacho.blnImpEti      := True;
    frmImpEtiDespacho.edtQtdVol.Text := frmImpEtiDespacho.fCarregaVolume;
    frmImpEtiDespacho.ShowModal;

    Result := frmImpEtiDespacho.blnImprimiu;
  finally
    pFreeAndNil(frmImpEtiDespacho);
  end;
end;

function TfrmFatRomaneio.fImprimirRomaneioTIPEXP5: Boolean;
begin

  Result := False;

  If (fCfgSis('TIPEXP', varString) <> '5') Then
    Exit;

  If (Not fCfgSis('IMPROM', varBoolean)) Then
    Exit;

  Result := True;

end;

function TfrmFatRomaneio.fInformaNumeroVeiculo: integer;
var
  intIndice,
  intNumeroVeiculos: integer;
begin
  intNumeroVeiculos := 0;
  if (blnUtilizaMultiVeiculosRomaneio) and (Length(arrVeiculos) > 0) then
  begin
    for intIndice := Low(arrVeiculos) to High(arrVeiculos) do
    begin
      if arrVeiculos[intIndice].blnTemRom then
      begin
        Inc(intNumeroVeiculos);
      end;
    end;
  end;
  Result := intNumeroVeiculos
end;

function TfrmFatRomaneio.fIncluir(pgbStatus: TcxProgressBar): Boolean;
begin
  blnehRecuperacao := True;
  btnIncluir.Click();
  result := True;
end;

function TfrmFatRomaneio.fJoinFatGor_ExtGor(strNomTab: String): String;
var
  strSQL : String;
begin
  strSQL := '';

  If blnRegCid Then
  Begin
    strSQL := strSQL + ' LEFT JOIN FATGOR ON FATGOR.FGO_NUMDOC = '+strNomTab+'.DET_NUM_PD ';
    strSQL := strSQL + '                 AND FATGOR.FGO_ESPDOC = '+strNomTab+'.DET_ESP_PD ';
    strSQL := strSQL + '                 AND FATGOR.FGO_CODEMP = '+strNomTab+'.DET_EMP_PD ';

    strSQL := strSQL + ' LEFT JOIN EXTGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
  End;

  Result := strSQL;
end;

function TfrmFatRomaneio.fListaAutIncGer(ATmpTbl, ATabela: String): String;
var
  LQry: TUniQuery;
begin
  Result := ' "" ';

  LQry := fCriaQuery;

  try
    LQry.SQL.Add('SELECT G.AUTOINCREM');
    LQry.SQL.Add('FROM ' + ATabela + ' G');
    LQry.SQL.Add(FTemporariaDocumentosRomaneio.fGetJoinDocumentos(ATmpTbl, 'G.AUTOINCREM'));
    LQry.Open;

    if LQry.IsEmpty then
      Exit;

    Result := '';

    LQry.First;

    while not LQry.Eof do
    begin
      pIncrementaListaStr(LQry.Fields[0].Text, Result, True, True, ',', False, False);

      LQry.Next;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

function TfrmFatRomaneio.fLocalizarDocumentoViaCodigoDeBarras(strCodBar: String): Boolean;
Var
  strSQLLocaliza    : String;
  qryLocaliza       : TUniQuery;
  strNumDoc,
  strNumRom,
  strAcesso         : String;
  blnValidouEmpresa : Boolean;

  strDocDig : String;
  strEspDig : String;
  strEmpDig : String;
  intSeqVol : Integer;

  blnPermitirDevolucao : Boolean;
  blnEhDocumeDevolucao : Boolean;

  IncluirTransportadoraDiferente : TIncluirTransportadoraDiferente;

  procedure pAtualizaCampoApenasEste;
  begin

    If cdsTmpDoc.IsEmpty Then
      Exit;

    cdsTmpDoc.Edit;
    cdsTmpDoc.FieldByName('APENAS_ESTE').AsString := IIF(IncluirTransportadoraDiferente = itdApenasEste, 'S', 'N');
    cdsTmpDoc.Post;

  end;

  procedure pIncrementaVolumeBipado;
  begin

    If cdsTmpDoc.IsEmpty Then
      Exit;

    cdsTmpDoc.Edit;
    cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger := cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger +1;
    cdsTmpDoc.Post;

    If (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) Then
      ControleVolumesBipados.pAddVolume(strDocDig, strEspDig, strEmpDig, intSeqVol);

    pMensagemSonora('', msSucesso);

  end;

  procedure pObterCodigosEtiquetaDespacho;
  begin
    strDocDig := Copy(strCodBar, 1, fTamDocCadRec);
    strEspDig := fRetornaEspeciePeloCodigo(Copy(strCodBar, IfThen(fTamDocCadRec = 6, 7, 13), 2));
    strEmpDig := Copy(strCodBar, IfThen(fTamDocCadRec = 6, 9, 15), 3);
    intSeqVol := StrToIntDef(Copy(strCodBar, IfThen(fTamDocCadRec = 6, 12, 18), 3), -1);
  end;

begin

  Result := False;

  strAcesso := '';
  strDocDig := '';
  strEspDig := '';
  strEmpDig := '';

  strCodBar := Trim(strCodBar);

  If (ModeloBipagemCfg = mbChaveDeAcesso) Then
    strAcesso := strCodBar
  Else
  If (ModeloBipagemCfg = mbEtiquetaDeDespacho) Then
    pObterCodigosEtiquetaDespacho
  Else
  If (ModeloBipagemCfg = mbAutomatico) Then
  Begin
    If Length(strCodBar) = 44 Then
    Begin
      strAcesso := strCodBar;
      ModeloBipagemAut := mbChaveDeAcesso;
    End
    Else
    Begin
      pObterCodigosEtiquetaDespacho;
      ModeloBipagemAut := mbEtiquetaDeDespacho;
    End;
  End;

  If fEmptyStr(strCodBar) Then
    Exit;

  If (Pos(strOpcRom, '1_5_') > 0) Then
    Exit;

  If (strOpcRom = '2') Then
    strSQLLocaliza := fRetSQL_OPCROM2
  Else
  If (strOpcRom = '3') Then
    strSQLLocaliza := fRetSQL_OPCROM3
  Else
  If (strOpcRom = '4') Then
    strSQLLocaliza := fRetSQL_OPCROM4;

  blnPermitirDevolucao := (fEntraDevolucoes In [tdListaDevolucaoNFeDV, tdListaTodasDevolucoes, tdListaResidualDaDevolucaoNF, tdListaTodasDevolucoesAbatendoQtdDevolvida]);

  strSQLLocaliza := strSQLLocaliza + fRetSQLDevolucaoNFeDV;
  strSQLLocaliza := strSQLLocaliza + ' LIMIT 1'; {<<-- Devido a devolução que tem 2 documentos iguais E/S}

  qryLocaliza := fCriaQuery;

  Try

    qryLocaliza.Close;
    qryLocaliza.SQL.Clear;
    qryLocaliza.SQL.Add(strSQLLocaliza);

    If (ModeloBipagemCfg = mbChaveDeAcesso) Then
    Begin
      qryLocaliza.ParamByName('ACESSO').AsString := strAcesso;
    End
    Else
    If (ModeloBipagemCfg = mbEtiquetaDeDespacho) Then
    Begin
      qryLocaliza.ParamByName('NUMDOC').AsString := strDocDig;
      qryLocaliza.ParamByName('ESPDOC').AsString := strEspDig;
      qryLocaliza.ParamByName('CODEMP').AsString := strEmpDig;
    End
    Else
    If (ModeloBipagemCfg = mbAutomatico) Then
    Begin

      If (ModeloBipagemAut = mbChaveDeAcesso) Then
        qryLocaliza.ParamByName('ACESSO').AsString := strAcesso
      Else
      If (ModeloBipagemAut = mbEtiquetaDeDespacho) Then
      Begin
        qryLocaliza.ParamByName('NUMDOC').AsString := strDocDig;
        qryLocaliza.ParamByName('ESPDOC').AsString := strEspDig;
        qryLocaliza.ParamByName('CODEMP').AsString := strEmpDig;
      End;

    End;

    If Assigned(qryLocaliza.FindParam('ITESER')) Then
      qryLocaliza.ParamByName('ITESER').AsString := fCfgSis('ITESER');

    If Assigned(qryLocaliza.FindParam('SERTER')) Then
      qryLocaliza.ParamByName('SERTER').AsString := fCfgSis('SERTER');

    qryLocaliza.Open;

    If (qryLocaliza.IsEmpty) Then
    Begin
      pMensagemSonora('O documento não foi localizado!', msErro);
      Exit;
    End Else
    Begin

      strNumRom := qryLocaliza.FieldByName('GER_NROROM').AsString;
      strNumDoc := qryLocaliza.FieldByName('GER_NUMDOC').AsString + '-' + qryLocaliza.FieldByName('GER_CODEMP').AsString;

      {Validações}
      If Not fEmptyStr(strNumRom) Then
      Begin
        pMensagemSonora('O documento ' + strNumDoc + ' já está vinculado ao romaneio ' + strNumRom + '.', msErro);
        Exit;
      End;

      If (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) Then
      Begin
        If ControleVolumesBipados.fJahBipouVolume(strDocDig, strEspDig, strEmpDig, intSeqVol) Then
        Begin
          pMensagemSonora('O documento ' + strNumDoc + ', Volume: ' + intSeqVol.ToString + ' já foi bipado!', msErro);
          Exit;
        End;
      End;

      If (Not blnPermitirDevolucao) And (Pos(qryLocaliza.FieldByName('GER_CLAFIS').AsString, CLASSIFICACOES_DEVOLUCAO) > 0) Then
      Begin
        pMensagemSonora('Inclusão não permitida para documento de Devolução (DV).' + #13 +
                        'Verificar CFG_DEVROM - Quando utilizar romaneio por documento faturado, proceder com Devoluções na Entrada do Romaneio, da seguinte forma.', msErro);
        Exit;
      End;

      blnEhDocumeDevolucao := (blnPermitirDevolucao) And (Pos(qryLocaliza.FieldByName('GER_CLAFIS').AsString, CLASSIFICACOES_DEVOLUCAO) > 0);

      If (Not blnEhDocumeDevolucao) And (LeftStr(qryLocaliza.FieldByName('GER_CLAFIS').AsString, 1) < '5') Then
      Begin
        pMensagemSonora('O documento ' + strNumDoc + ' é entrada  e não pode ser inserido no romaneio.', msErro);
        Exit;
      End;

      If (Not fCfgSis('TE_ROM', varBoolean)) And (qryLocaliza.FieldByName('GER_ESPDOC').AsString = 'TE') Then
      Begin
        pMensagemSonora('Inclusão não permitida. Verificar CFG_TE_ROM - Entrar TE no Romaneio!', msErro);
        Exit;
      End;

      If (Not fCfgSis('TRBRRO', varBoolean)) And (qryLocaliza.FieldByName('GER_ESPDOC').AsString = 'TR') Then
      Begin
        pMensagemSonora('Inclusão não permitida para documento de Troca(TR). Verificar CFG_TRBRRO - Entrar TR e BR no Romaneio!', msErro);
        Exit;
      End;

      If (Not fCfgSis('TRBRRO', varBoolean)) And (qryLocaliza.FieldByName('GER_ESPDOC').AsString = 'BR') Then
      Begin
        pMensagemSonora('Inclusão não permitida para documento de Brinde(BR). Verificar CFG_TRBRRO - Entrar TR e BR no Romaneio!', msErro);
        Exit;
      End;

      If (qryLocaliza.FieldByName('GER_ENTFUT').AsString = 'S') Then
      Begin
        pMensagemSonora('O documento ' + strNumDoc + ' é de entrega futura e não pode ser inserido no romaneio.', msErro);
        Exit;
      End;

      If (qryLocaliza.FieldByName('GER_ENTFAT').AsString = 'N') Then
      Begin
        pMensagemSonora('O documento ' + strNumDoc + ' é retira e não pode ser inserido no romaneio.', msErro);
        Exit;
      End;

      If (qryLocaliza.FieldByName('GER_DTAENT').AsDateTime < (VS_Date - fCfgSis('DIAROM', varInteger))) Then
      Begin
        pMensagemSonora('O documento ' + strNumDoc + ' é anterior ao período permitido para inclusão no romaneio (CFG_DIAROM).' + #13 +
                        'Data do documento: ' + FormatDateTime('dd/mm/yyyy', qryLocaliza.FieldByName('GER_DTAENT').AsDateTime), msErro);
        Exit;
      End;

      blnValidouEmpresa := True;

      If (fCfgSis('CONENT', varBoolean)) and (fCfgSis('COENFI', varBoolean)) Then
      Begin
        If (fCfgSis('EMPGER', varBoolean)) Then
        Begin
          blnValidouEmpresa := (qryLocaliza.FieldByName('GER_CODEMP').AsString = fCfgSis('EMPMAT')) Or
                               (qryLocaliza.FieldByName('GER_CONENT').AsString = 'S');
        End
        Else
        Begin
          blnValidouEmpresa := (qryLocaliza.FieldByName('GER_CONENT').AsString = 'N') And
                               (qryLocaliza.FieldByName('GER_CODEMP').AsString = VS_strCodEmp);
        End;
      End;

      If Not blnValidouEmpresa Then
      Begin
        pMensagemSonora('O documento ' + strNumDoc + ' é da empresa ' + qryLocaliza.FieldByName('GER_CODEMP').AsString +
                        ' e conforme regras das configurações, não pode ser inserido no romaneio da empresa logada', msErro);
        Exit;
      End;

      If Not cdsTmpDoc.Active Then
        cdsTmpDoc.Open;

      If Not fDocumentoJahFoiBipado(strAcesso, strDocDig, strEspDig, strEmpDig) Then
      Begin
        IncluirTransportadoraDiferente := fPodeIncluirDocumentoTransportadoraDiferente(qryLocaliza.FieldByName('GER_TRADOC').AsString);
        If (IncluirTransportadoraDiferente = itdNao) Then
          Exit;
      End;

      If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
      Begin

        If Not cdsTmpDoc.Locate('FIS_ACESSO', strAcesso, []) Then
        Begin
          pCopiaParaTemporaria(qryLocaliza, cdsTmpDoc, tpcTmpDoc, True);
          pIncrementaVolumeBipado;
          pAtualizaCampoApenasEste;
        End
        Else
        Begin

          If (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger > cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger) Then
            pIncrementaVolumeBipado
          Else
          Begin
            pMensagemSonora('O documento ' + strNumDoc + ' já tem todos os volumes bipados.', msErro);
            edtCodBar.Clear;
            Exit;
          End;

        End;

        {Se bipou todos os volumes, marca o documento}
        If (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger <= cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger) Then
        Begin
          pMarcaDocDev(qryLocaliza, cdsTmpDoc);
          pMarcarNotaChaveAcessoCodigoBarra(strAcesso, True, False);
        End;

      End
      Else
      {Número, espécie e empresa}
      Begin

        If Not cdsTmpDoc.Locate('GER_NUMDOC;GER_CODEMP', VarArrayOf([strDocDig+'-'+strEspDig, strEmpDig]), []) Then
        Begin
          pCopiaParaTemporaria(qryLocaliza, cdsTmpDoc, tpcTmpDoc, True);
          pIncrementaVolumeBipado;
          pAtualizaCampoApenasEste;
        End
        Else
        Begin

          If (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger > cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger) Then
            pIncrementaVolumeBipado
          Else
          Begin
            pMensagemSonora('O documento ' + strNumDoc + ' já tem todos os volumes bipados.', msErro);
            edtCodBar.Clear;
            Exit;
          End;

        End;

        {Se bipou todos os volumes, marca o documento}
        If (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger <= cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger) Then
        Begin
          pMarcaDocDev(qryLocaliza, cdsTmpDoc);
          pMarcarNota_Documento_(strDocDig, strEspDig, strEmpDig, True, False);
        End;

      End;

      If Not btnCfgColRomaneio.Enabled Then
        pBotaoConfigurar;

      pCalculaTotal;

      Result := True;

    End;

  Finally
    FreeAndNil(qryLocaliza);
  End;

end;

