  strSQLGer := strSQLGer + '  0.00 GER_VALSEL, ';
  strSQLGer := strSQLGer + '  0.00 GER_VSEPRO, ';
  strSQLGer := strSQLGer + '  1    GER_ORDIMP, ';
  strSQLGer := strSQLGer + '  G.AUTOINCREM AS GER_AUTINC, ';
  strSQLGer := strSQLGer + '  IFNULL(AUX_ENTGER, "") AS AUX_ENTGER ';  // REFERENCIA DO ENDERECO DE ENTREGA
  strSQLGer := strSQLGer + 'FROM MOVGER G  ';
  strSQLGer := strSQLGer + FTemporariaDocumentosRomaneio.fGetJoinDocumentos(ATemporariaGER, 'G.AUTOINCREM');
  strSQLGer := strSQLGer + '  LEFT JOIN MOVDET D ON D.DET_SEQGER = G.AUTOINCREM ';
  strSQLGer := strSQLGer + '  LEFT JOIN ' + fRetNomTabAuxMov('MOVGER') + ' ON AUX_SEQGER = G.AUTOINCREM ';
  strSQLGer := strSQLGer + '  LEFT JOIN CADCLI ON  GER_CODCLI = CLI_CODCLI ';
  strSQLGer := strSQLGer + '  LEFT JOIN CADCID ON CADCID.CID_CODCID = IF(G.GER_CIDCON IS NULL, CLI_CODCID, G.GER_CIDCON)';
  strSQLGer := strSQLGer + 'GROUP BY ';
  strSQLGer := strSQLGer + ' G.GER_NUMDOC, ';
  strSQLGer := strSQLGer + ' G.GER_ESPDOC, ';
  strSQLGer := strSQLGer + ' G.GER_CODCLI, ';
  strSQLGer := strSQLGer + ' G.GER_CODEMP ';

  Result := '';

  if FTemporariaDocumentosRomaneio.fTemRegistrosTabela(ATemporariaFGO) then
    Result := strSQLFgo;

  if FTemporariaDocumentosRomaneio.fTemRegistrosTabela(ATemporariaGER) then
    Result := Result + IIF(not fEmptyStr(Result), ' UNION ALL ', '') + strSQLGer;
end;

function TfrmFatRomaneio.fRetSQLDocRetornadoRomaneio(strPrefix: String;
  blnOutrasSaidas: Boolean): String;
begin
  Result := ' (SELECT IF(COUNT(ROMDELX.AUTOINCREM > 0), "SIM", NULL) '+
            '         FROM ROMDELX ' +
            '         WHERE ROMDELX.DEL_NUMDOC = '+strPrefix+'_NUMDOC AND ' +
            '               ROMDELX.DEL_ESPDOC = '+strPrefix+'_ESPDOC AND ' +
            '               ROMDELX.DEL_CODEMP = '+strPrefix+'_CODEMP AND ' +
            '               ROMDELX.DEL_CODCLI '+IIF(blnOutrasSaidas, 'IS NULL',' = '+strPrefix+'_CODCLI') + ' ) ';
end;

function TfrmFatRomaneio.fRetTabelaDet(strNomTab: String): String;
begin

  Result := '';

  If (strNomTab = 'MOVGER') Then
    Result := 'MOVDET'
  Else If (strNomTab = 'NOTGER') Then
    Result := 'NOTDET';

end;

function TfrmFatRomaneio.fRetValSel(strNumDoc, strEspDoc, strCodEmp,
  strEntSai: String): Real;
  Var
    cdsTmp : TUniClientDataSet;
begin
  Result := 0;
  cdsTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsTmp, cdsTmpDoc);

  With cdsTmp Do
  Begin
    Filtered := False;
    Filter   :=                 '(GER_NUMDOC = ' + QuotedStr(strNumDoc+'-'+strEspDoc) + ') AND ';
    Filter   := cdsTmp.Filter + '(GER_CODEMP = ' + QuotedStr(strCodEmp) + ') AND ';
    Filter   := cdsTmp.Filter + '(GER_ENTSAI = ' + QuotedStr(strEntSai) + ')';
    Filtered := True;

    If Not IsEmpty Then
    Begin
      First;

      While Not cdsTmp.Eof Do
      Begin
        Result := Result + FieldByName('GER_VALSEL').AsFloat;
        Next;
      End;
    End;

    Close;
  End;

  FreeAndNil(cdsTmp);
end;

Function TfrmFatRomaneio.fPesoBrutoSelecionado(varTipVar: TVarType = varString; blnMovimentaVeiculo: Boolean = False; strNumVeiculo: string = ''): Variant;
  Var
    cdsPes : TUniClientDataSet;
    cdsDoc : TUniClientDataSet;
    fltPes : Double;
    fltPesRom : Double;
    blnRomaneioSelecionado: Boolean;
begin
  fltPes    := 0;
  fltPesRom := 0;

  cdsPes := TUniClientDataSet.Create(Nil);
  pCloneDataSet(cdsPes, cdsRomDet);

  cdsDoc := TUniClientDataSet.Create(Nil);
  pCloneDataSet(cdsDoc, cdsTmpDoc);
  
  cdsDoc.Filtered := False;
  cdsDoc.Filter   := '((GER_MARDES = ' + QuotedStr('M') + ') OR (GER_MARDES = ' + QuotedStr('P') + '))';
  cdsDoc.Filtered := True;
  cdsDoc.IndexFieldNames := 'GER_DOCORI;GER_ESPDOC;GER_CODEMP;GER_ENTSAI;GER_TIP_FC';
  
  blnRomaneioSelecionado := cdsDoc.Locate('GER_NROROM', edtNumRom.Text, []);

  if (blnUtilizaMultiVeiculosRomaneio) and (fEmptyStr(strNumVeiculo)) then
  begin
    pInicializaPesoVeiculo;
  end;

  Try
    cdsPes.Filtered := False;
    cdsPes.Filter   := '';

    cdsPes.First;
    While Not cdsPes.Eof Do
    Begin
      If (cdsDoc.FindKey([cdsPes.FieldByName('DET_NUMDOC').AsString, 
                          cdsPes.FieldByName('DET_ESPDOC').AsString,
                          cdsPes.FieldByName('DET_CODEMP').AsString,
                          cdsPes.FieldByName('DET_ENTSAI').AsString,
                          'C'])) Then
      Begin
        if (fEmptyStr(strNumVeiculo)) or ((blnUtilizaMultiVeiculosRomaneio) and (strNumVeiculo = cdsDoc.FieldByName('GER_VEICUL').AsString)) then
        begin
          If (cdsPes.FindField('DET_DELETA') <> Nil) And (cdsPes.FieldByName('DET_DELETA').AsString = 'N') Then
            fltPesRom := fltPesRom + ((cdsPes.FieldByName('DET_VLTOPE').AsFloat / cdsPes.FieldByName('DET_QTDTOT').AsFloat) * cdsPes.FieldByName('DET_QTDBAI').AsFloat)
          Else
            fltPes := fltPes + ((cdsPes.FieldByName('DET_VLTOPE').AsFloat / cdsPes.FieldByName('DET_QTDTOT').AsFloat) * cdsPes.FieldByName('DET_QTDBAI').AsFloat);
        end;

        if (blnUtilizaMultiVeiculosRomaneio) and (blnMovimentaVeiculo) then
        begin
          pPesoMovimentaVeiculo(((cdsPes.FieldByName('DET_VLTOPE').AsFloat / cdsPes.FieldByName('DET_QTDTOT').AsFloat) * cdsPes.FieldByName('DET_QTDBAI').AsFloat), cdsDoc.FieldByName('GER_VEICUL').AsString);
        end;
      End;

      cdsPes.Next;
    End;
  Finally
    FreeAndNil(cdsPes);
    FreeAndNil(cdsDoc);

    If blnRomaneioSelecionado Then
      fltPes := (fltPes + fltPesRom);

    Case varTipVar Of
      varString : Result := FloatToStrF(fltPes, ffFixed, 12, 2);
      varDouble : Result := fFormataFloat(fltPes, 2);
    End;
  End;
end;

Function TfrmFatRomaneio.fPesoLiquidoSelecionado(strNumVeiculo: string = ''): Double;
  Var
    cdsPes : TUniClientDataSet;
    cdsDoc : TUniClientDataSet;
    fltPes : Double;
    fltPesRom : Double;
    blnRomaneioSelecionado: Boolean;
begin
  fltPes    := 0;
  fltPesRom := 0;

  cdsPes := TUniClientDataSet.Create(Nil);
  pCloneDataSet(cdsPes, cdsRomDet);

  cdsDoc := TUniClientDataSet.Create(Nil);
  pCloneDataSet(cdsDoc, cdsTmpDoc);

  cdsDoc.Filtered := False;
  cdsDoc.Filter   := '((GER_MARDES = ' + QuotedStr('M') + ') OR (GER_MARDES = ' + QuotedStr('P') + '))';
  cdsDoc.Filtered := True;
  cdsDoc.IndexFieldNames := 'GER_DOCORI;GER_ESPDOC;GER_CODEMP;GER_ENTSAI;GER_TIP_FC';
  
  blnRomaneioSelecionado := cdsDoc.Locate('GER_NROROM', edtNumRom.Text, []);

  Try
    cdsPes.Filtered := False;
    cdsPes.Filter   := '';

    If (fCfgSis('PESLIQ') = 'SOMA') Then
    Begin
      cdsPes.First;
      While Not cdsPes.Eof Do
      Begin
        If (cdsDoc.FindKey([cdsPes.FieldByName('DET_NUMDOC').AsString, 
                            cdsPes.FieldByName('DET_ESPDOC').AsString,
                            cdsPes.FieldByName('DET_CODEMP').AsString,
                            cdsPes.FieldByName('DET_ENTSAI').AsString,
                            'C'])) Then
        Begin
          if (fEmptyStr(strNumVeiculo)) or ((blnUtilizaMultiVeiculosRomaneio) and (strNumVeiculo = cdsDoc.FieldByName('GER_VEICUL').AsString)) then
          begin
            If (cdsPes.FindField('DET_DELETA') <> Nil) And (cdsPes.FieldByName('DET_DELETA').AsString = 'N') Then
              fltPesRom := fltPesRom + ((cdsPes.FieldByName('DET_VLTOPE').AsFloat / cdsPes.FieldByName('DET_QTDTOT').AsFloat) * cdsPes.FieldByName('DET_QTDBAI').AsFloat)
            Else
              fltPes := fltPes + (fRetPesLiq(cdsPes.FieldByName('DET_CODITE').AsString) * cdsPes.FieldByName('DET_QTDBAI').AsFloat);
          end;
        End;

        cdsPes.Next;
      End;
    End
    Else
    Begin
      if (not fEmptyStr(strNumVeiculo)) and (blnUtilizaMultiVeiculosRomaneio) then
      begin
        fltPes := fFormataFloat(fPesoBrutoSelecionado(varDouble, False, strNumVeiculo) * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);
      end
      else
      begin
        fltPes := fFormataFloat(fPesoBrutoSelecionado(varDouble) * fStrToFloat(fCfgSis('FATPLI', varDouble)), 3);
      end;
    End;
  Finally
    FreeAndNil(cdsPes);
    FreeAndNil(cdsDoc);

    If blnRomaneioSelecionado Then
      fltPes := (fltPes + fltPesRom);

    Result := fltPes;
  End;
end;

function TfrmFatRomaneio.fSohTemOutrasEntregas: Boolean;
  Var
    cdsDoc : TUniClientDataSet;
begin
  cdsDoc := TUniClientDataSet.Create(Nil);
  Try
    pCloneDataSet(cdsDoc, cdsTmpDoc);
    
    cdsDoc.Filtered := False;
    cdsDoc.Filter   := '(((GER_MARDES = ' + QuotedStr('M') + ') OR (GER_MARDES = ' + QuotedStr('P') + ')) AND (GER_ESPDOC = ' +  QuotedStr('OX') + '))';
    cdsDoc.Filtered := True;

    Result := Not cdsDoc.IsEmpty;

    If Result Then
    Begin
      cdsDoc.Filtered := False;
      cdsDoc.Filter   := '(((GER_MARDES = ' + QuotedStr('M') + ') OR (GER_MARDES = ' + QuotedStr('P') + ')) AND (GER_ESPDOC <> ' +  QuotedStr('OX') + '))';
      cdsDoc.Filtered := True;

      Result := cdsDoc.IsEmpty;
    End;
  Finally
    FreeAndNil(cdsDoc);
  End;
end;

function TfrmFatRomaneio.fTemPedidosJaFaturadosEmPedidos: Boolean;
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
    strNumDoc,
    strEspDoc,
    strCodEmp,
    strMsg: String;
    intCount: Integer;
begin
  Result := False;

  If (fCfgSis('OPCROM') = '1') And (fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean)) Then
  Begin
    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;
    intCount := 0;
    Try
      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);

      cdsTmpDoc.First;
      While Not cdsTmpDoc.Eof Do
      Begin
        strNumDoc := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
        strEspDoc := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
        strCodEmp := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;

        If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'PD') And
           (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M')  And
           (fEmptyStr(cdsTmpDoc.FieldByName('GER_NROROM').AsString)) Then
        Begin
          If fPedidoFoiFaturado(strNumDoc, strEspDoc, strCodEmp) Then
          Begin
            If (fCampoTabela('FGO_TIPFAT','FATGOR',['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'],[strNumDoc, strEspDoc, strCodEmp]) = 'PD') Then
            Begin
              Inc(intCount);
              strMsg := strMsg +
                 'Ped. Ori.: ' + strNumDoc+'-'+strEspDoc+'-'+strCodEmp + ' / '+
                 'Doc. Fat.: ' + fCampoTabela('CONCAT(FGO_NUMFAT,"-",FGO_TIPFAT,"-",FGO_EMPFAT)','FATGOR',['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP'],[strNumDoc, strEspDoc, strCodEmp]) + #10#13;
            End;
          End;
        End;
        cdsTmpDoc.Next;
      End;
    Finally
      cdsTmpDoc.First;
      If blnWasEnabled Then
        pEnableControls(cdsTmpDoc, prcScroll);

      If (Not fEmptyStr(strMsg)) Then
      Begin
        fMensagem('Atenção!', 'Os documentos relacionados abaixo foram faturados em outros pedidos. '+
                              'Desmarque os documentos e recarregue o grid para fazer o romaneio dos novos pedidos:' + #10#13 + #10#13 + strMsg,
                              ['&Ok'], 1, False, 1, 0, False, 0, False, False, False, 200, 0, intCount);
        Result := True;
      End;
    End;
  End;
end;

function TfrmFatRomaneio.fValidaTodosDocumentosCorreios : boolean;
var
  bkmRegistroAtual: TBookmark;
  qryDocs: TDataset;
  blnTransportadoraCorreio : boolean;
  blnTransportadoraNormal  : boolean;
begin
  result     := True;
  blnTransportadoraCorreio := False;
  blnTransportadoraNormal  := False;
  qryDocs := dbgDocumentosDBView.DataController.DataSet;
  bkmRegistroAtual := qryDocs.GetBookmark;
  try
    qryDocs.first;
    while result and (not qryDocs.eof) do
    begin
      if Pos(qryDocs.FieldByName('GER_MARDES').AsString,  'MP') > 0 then
      begin
        if fTransportadoraCorreio(qryDocs.FieldByName('GER_TRADOC').AsString) then
          blnTransportadoraCorreio := True
        else
          blnTransportadoraNormal := True;
      end;

      Result := not (blnTransportadoraCorreio and  blnTransportadoraNormal);

      qryDocs.Next;
    end;
  finally
    qryDocs.GotoBookmark(bkmRegistroAtual);
    qryDocs.FreeBookmark(bkmRegistroAtual);
  end;
end;

function TfrmFatRomaneio.fValorMovimentaVeiculo(fltValor: Double;
  strVeiculo: string; blnMarcaRegistro: Boolean): string;
var
  intIndicePai,
  intIndiceFilho,
  intIndiceVeic: integer;
  objPai: TPanel;
  objFilho: TLabel;
begin
  if blnMarcaRegistro then
  begin
    for intIndicePai := 0 to flwpnlVeiculo.ControlCount - 1 do
    begin
      if (flwpnlVeiculo.Controls[intIndicePai] is TPanel) and
         (((TPanel(flwpnlVeiculo.Controls[intIndicePai]).Color = COR_SEL_VEICULO) and (TPanel(flwpnlVeiculo.Controls[intIndicePai]).Visible)) or
          ((intContVeiculo = 1) and (arrVeiculos[0].blnTemRom))) then
      begin
        objPai := TPanel(flwpnlVeiculo.Controls[intIndicePai]);
        Result := Copy(TPanel(objPai).Name, Pos('_', TPanel(objPai).Name) + 1, 1);

        for intIndiceFilho := 0 to objPai.ControlCount - 1 do
        begin
          if (objPai.Controls[intIndiceFilho] is TLabel) and (TLabel(objPai.Controls[intIndiceFilho]).Name = 'lblValorDesc_'+Result) then
          begin
            for intIndiceVeic := Low(arrVeiculos) to High(arrVeiculos) do
            begin
              if ((arrVeiculos[intIndiceVeic].blnTemRom) or (intContVeiculo = 1)) and (arrVeiculos[intIndiceVeic].strNumVeic = Result) then
              Begin
                objFilho := TLabel(objPai.Controls[intIndiceFilho]);
                TLabel(objFilho).Caption := FloatToStrF(StrToFloatDef(TLabel(objFilho).Caption,0) + fltValor, ffFixed, 12, 4);
                arrVeiculos[intIndiceVeic].fltTotVlr := arrVeiculos[intIndiceVeic].fltTotVlr + fltValor;
                if (not arrVeiculos[intIndiceVeic].blnTemRom) and (intContVeiculo = 1) then
                begin
                  arrVeiculos[intIndiceVeic].blnTemRom := True;
                end;
                Exit;
              End;
            end;

            if (intContVeiculo > 1) then
              fMensagem('ATENÇÃO!', 'As informações do veículo devem ser preenchidas!', ['&Ok']);

            Result := EmptyStr;
            Exit;
          end;
        end;
      end;
    end;
  end
  else
  begin
    for intIndicePai := 0 to flwpnlVeiculo.ControlCount - 1 do
    begin
      if (flwpnlVeiculo.Controls[intIndicePai] is TPanel) and (TPanel(flwpnlVeiculo.Controls[intIndicePai]).Name = 'pnlVeiculo_'+strVeiculo) then
      begin
        objPai := TPanel(flwpnlVeiculo.Controls[intIndicePai]);
        Result := Copy(TPanel(objPai).Name, Pos('_', TPanel(objPai).Name) + 1, 1);

        for intIndiceFilho := 0 to objPai.ControlCount - 1 do
        begin
          if (objPai.Controls[intIndiceFilho] is TLabel) and (TLabel(objPai.Controls[intIndiceFilho]).Name = 'lblValorDesc_'+Result) then
          begin
            for intIndiceVeic := Low(arrVeiculos) to High(arrVeiculos) do
            begin
              if (arrVeiculos[intIndiceVeic].blnTemRom) and (arrVeiculos[intIndiceVeic].strNumVeic = Result) then
              Begin
                objFilho := TLabel(objPai.Controls[intIndiceFilho]);
                TLabel(objFilho).Caption := FloatToStrF(StrToFloatDef(TLabel(objFilho).Caption,0) - fltValor, ffFixed, 12, 4);
                arrVeiculos[intIndiceVeic].fltTotVlr := arrVeiculos[intIndiceVeic].fltTotVlr - fltValor;
                Result := EmptyStr;
                Exit;
              End;
            end;
          end;
        end;
      end;
    end;
  end;
end;

function TfrmFatRomaneio.fValidaDocumentosCorreios(blnCorreio : boolean) : boolean;
var
  bkmRegistroAtual: TBookmark;
  qryDocs: TDataset;
begin
  result := True;
  qryDocs := dbgDocumentosDBView.DataController.DataSet;
  bkmRegistroAtual := qryDocs.GetBookmark;
  try
    qryDocs.first;
    while result and (not qryDocs.eof) do
    begin
      if Pos(qryDocs.FieldByName('GER_MARDES').AsString,  'MP') > 0 then
        Result := (blnCorreio = fTransportadoraCorreio(qryDocs.FieldByName('GER_TRADOC').AsString));

      qryDocs.Next;
    end;
  finally
    qryDocs.GotoBookmark(bkmRegistroAtual);
    qryDocs.FreeBookmark(bkmRegistroAtual);
  end;
end;

function TfrmFatRomaneio.fValidaSaldoDisponivelItensPed(Const strNumDoc, strEspDoc, strCodEmp, strCodCli: String): Boolean;
  Var
    qryAux: TUniQuery;
    fltSalFis, fltSalDis: Double;
    intDecQtd: Integer;
    objTabela: TRegistroMsgLiberaTabela;
    objLinha: TLinhaMsgLibera;
begin
  Result := True;

  qryAux := fCriaQuery;
  Try
    intDecQtd := fCfgSis('DECQTD', varInteger);

    objLiberacao.Clear;
    objLiberacao.blnTraTel := False;
    objLiberacao.strDirAce := '-';
    objLiberacao.objMsgLibera.pAddTexto('Pedido de transferência sem saldo de estoque disponível');

    objTabela := TRegistroMsgLiberaTabela.Create;

    qryAux.SQL.Add('SELECT FDO_CODITE, FDO_DESCRI, FDO_QTDITE, FDO_NUMLOT, UNI_SIGUNI');
    qryAux.SQL.Add('FROM FATDOR');
    qryAux.SQL.Add('JOIN CADUNI ON UNI_CODUNI = FDO_UNIDAD');
    qryAux.SQL.Add('WHERE FDO_NUMDOC = :NUMDOC');
    qryAux.SQL.Add('  AND FDO_ESPDOC = :ESPDOC');
    qryAux.SQL.Add('  AND FDO_CODEMP = :CODEMP');
    qryAux.SQL.Add('  AND FDO_CODCLI = :CODCLI');

    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.Open;

    qryAux.First;
    While Not qryAux.Eof Do
    Begin
      fltSalFis := fRetornaSaldoFisico(qryAux.FieldByName('FDO_CODITE').AsString,
                                       False,
                                       IIF(qryAux.FieldByName('FDO_NUMLOT').AsString = 'A DEFINIR', '', qryAux.FieldByName('FDO_NUMLOT').AsString),
                                       strCodEmp);

      fltSalDis := fRetornaSaldoDisponivel(qryAux.FieldByName('FDO_CODITE').AsString,
                                           False,
                                           False,
                                           IIF(qryAux.FieldByName('FDO_NUMLOT').AsString = 'A DEFINIR', '', qryAux.FieldByName('FDO_NUMLOT').AsString),
                                           False,
                                           strCodEmp);

      If fFormatafloat(fltSalDis, intDecQtd) < fFormatafloat(qryAux.FieldByName('FDO_QTDITE').AsFloat, intDecQtd) Then
      Begin
        Result := False;

        If objTabela.IsEmpty Then
        Begin
          objLinha  := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlCabecalho;
          objLinha.pAddColuna('', 'Código'      , 7 , alEsquerda);
          objLinha.pAddColuna('', 'Descrição'   , 60, alEsquerda);
          objLinha.pAddColuna('', 'UN'          , 4 , alEsquerda);
          objLinha.pAddColuna('', 'Qtd. Pedido' , 15, alDireita);
          objLinha.pAddColuna('', 'Saldo Físico', 15, alDireita);
          objLinha.pAddColuna('', 'Saldo Disp.' , 15, alDireita);
          objTabela.lstLinhas.Add(objLinha);
        End;

        objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlValor;
        objLinha.pAddColuna('Código'      , qryAux.FieldByName('FDO_CODITE').AsString, 7);
        objLinha.pAddColuna('Descrição'   , qryAux.FieldByName('FDO_DESCRI').AsString, 60);
        objLinha.pAddColuna('UN'          , qryAux.FieldByName('UNI_SIGUNI').AsString, 4);
        objLinha.pAddColuna('Qtd. Pedido' , FormatFloat(fMskDigitos(intDecQtd), qryAux.FieldByName('FDO_QTDITE').AsFloat), 15, alDireita);
        objLinha.pAddColuna('Saldo Físico', FormatFloat(fMskDigitos(intDecQtd), fltSalFis), 15, alDireita);
        objLinha.pAddColuna('Saldo Disp.' , FormatFloat(fMskDigitos(intDecQtd), fltSalDis), 15, alDireita);
        objTabela.lstLinhas.Add(objLinha);
      End;

      qryAux.Next;
    End;

    If objTabela.IsEmpty Then
      FreeAndNil(objTabela)
    Else
    Begin
      objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);
      objLiberacao.fLibera;
    End;
  Finally
    objLiberacao.Clear;
    FreeAndNil(qryAux);
  End;
end;

function TfrmFatRomaneio.fValidaSelecinarClienteComCargaExclusiva: Boolean;
Var
  qryDocs: TDataset;
  bkmRegAtu: TBookmark;
  strCodCli: String;
  strCliSel: String;
begin
  If Not fCfgSis('CAREXC', VarBoolean) Then
    Exit(True);

  qryDocs := dbgDocumentosDBView.DataController.DataSet;
  bkmRegAtu := qryDocs.GetBookmark;

  Try
    strCodCli := qryDocs.FieldByName('GER_CODCLI').AsString;
    If qryDocs.Locate('GER_MARDES', 'M', []) Or qryDocs.Locate('GER_MARDES', 'P', []) Then
      strCliSel := qryDocs.FieldByName('GER_CODCLI').AsString;
  Finally
    qryDocs.GotoBookmark(bkmRegAtu);
    FreeMemory(bkmRegAtu);
  End;

  If fEmptyStr(strCliSel) Then
    Exit(True);

  If strCodCli = strCliSel Then
    Exit(True);

  If fCampoTabela('CLI_CAREXC', 'CADCLI', ['CLI_CODCLI'], [strCodCli], False) = 'S' Then
  Begin
    pMensagemOk('Cliente com controle de carga e entrega exclusiva. '+
      'Somente é permitido selecionar documentos do mesmo cliente!');
    Exit(False);
  End;

  If fCampoTabela('CLI_CAREXC', 'CADCLI', ['CLI_CODCLI'], [strCliSel], False) = 'S' Then
  Begin
    pMensagemOk('Cliente com controle de carga e entrega exclusiva selecionado. '+
      'Somente é permitido selecionar documentos do mesmo cliente!');
    Exit(False);
  End;

  Result := True;
end;

function TfrmFatRomaneio.fRetornaDocumentosCorreiosSemObjeto: TarrayDadosDocumento;
var
  bkmRegistroAtual: TBookmark;
  qryDocs: TDataset;
  i : integer;
begin
  SetLength(Result,0);
  qryDocs := dbgDocumentosDBView.DataController.DataSet;
  bkmRegistroAtual := qryDocs.GetBookmark;
  try
    qryDocs.first;
    while (not qryDocs.eof) do
    begin
      if Pos(qryDocs.FieldByName('GER_MARDES').AsString,  'MP') > 0 then
      begin
        if fRetornaAutoincremPLPDOC(qryDocs.FieldByName('GER_DOCORI').AsString, qryDocs.FieldByName('GER_ESPDOC').AsString, qryDocs.FieldByName('GER_CODEMP').AsString)  = '' then
        begin
          i := Length(Result);
          SetLength(Result , i + 1);
          Result[i].strNumDoc := qryDocs.FieldByName('GER_DOCORI').AsString;
          Result[i].strEspDoc := qryDocs.FieldByName('GER_ESPDOC').AsString;
          Result[i].strCodEmp := qryDocs.FieldByName('GER_CODEMP').AsString;
        end;
      end;

      qryDocs.Next;
    end;
  finally
    qryDocs.GotoBookmark(bkmRegistroAtual);
    qryDocs.FreeBookmark(bkmRegistroAtual);
  end;
end;

function TfrmFatRomaneio.fRetornaOutrosRomaneiosComPLPEmAberto : TStringArray;
var
  qryAux : TUniQuery;
begin
  setLength(Result,0);

  qryAux := fCriaQuery(nil);
  try
    qryAux.SQL.Add('SELECT                     ');
    qryAux.SQL.Add('  PLP_NUMROM               ');
    qryAux.SQL.Add('FROM                       ');
    qryAux.SQL.Add('  CORPLP                   ');
    qryAux.SQL.Add('WHERE PLP_DTAENV IS NULL   ');
    qryAux.SQL.Add('  AND PLP_CODEMP = :CODEMP ');
    qryAux.SQL.Add('ORDER BY                   ');
    qryAux.SQL.Add('  PLP_NUMROM               ');

    qryAux.ParamByName('CODEMP').AsString := VS_strCodEmp;

    qryAux.Open;

    while not qryAux.eof do
    begin
      pAddDados(result, qryAux.FieldByName('PLP_NUMROM').AsString);
      qryAux.Next;
    end;

    qryAux.Close;
  finally
    FreeAndNil(qryAux);
  end;

end;

function TfrmFatRomaneio.fRetornarDocumentosSelecionadosConcatenados: String;
Var
  prcScroll: TprcScroll;
  blnWasEnabled: Boolean;
begin
  Result := '';

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  Try
    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    cdsTmpDoc.First;

    While Not cdsTmpDoc.Eof Do
    Begin
      If AnsiMatchStr(cdsTmpDoc.FieldByName('GER_MARDES').AsString, ['M', 'P']) Then
      Begin
         Result := Result +'"'+(cdsTmpDoc.FieldByName('GER_DOCORI').AsString + '-' +cdsTmpDoc.FieldByName('GER_ESPDOC').AsString + '-'+cdsTmpDoc.FieldByName('GER_CODEMP').AsString)+ '",';
      End;
      cdsTmpDoc.Next;
    End;

    Result := Copy(Result, 1, Length(Result) -1);

  Finally
    cdsTmpDoc.First;

    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;

end;

function TfrmFatRomaneio.fValidaSIGEPWeb: boolean;
var
  arrDadosDocumentos : TarrayDadosDocumento;
  arrMensagem: TStringArray;
  arrRomaneios : TStringArray;
  objTabela : TRegistroMsgLiberaTabela;
  objLinha  : TLinhaMsgLibera;
  i : integer;
begin
  Result := True;

  if fRomaneioParaCorreios then
  begin
    if not fValidaTodosDocumentosCorreios then
    begin
      result := False;
      pMensagemOk('Não é possível gravar o romaneio, pois existem documentos para os Correios e documentos para outras transportadoras marcados!');
      exit;
    end;

    if fEmptyStr(edtNumRom.Text) then
    begin
      arrRomaneios :=  fRetornaOutrosRomaneiosComPLPEmAberto;
      Result := Length(arrRomaneios) = 0;
      if not Result then
      begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Liberação para inclusão de um novo romaneio para os correios, com outros aguardando envio.');
        objLiberacao.objMsgLibera.pAddTexto('Romaneios aguardando envio:');

        objTabela := TRegistroMsgLiberaTabela.Create;

        objLinha  := TLinhaMsgLibera.Create;
        objLinha.enuTipoLinha := tlCabecalho;
        objLinha.pAddColuna('', 'ROMANEIO'       , 15  , alCentro, teAutcom);
        objTabela.lstLinhas.Add(objLinha);

        for i := 0 to High(arrRomaneios) do
        begin
          objLinha  := TLinhaMsgLibera.Create;
          objLinha.enuTipoLinha := tlValor;
          objLinha.pAddColuna('ROMANEIO'  , arrRomaneios[i], 15, alCentro);
          objTabela.lstLinhas.Add(objLinha);
        end;

        objLiberacao.objMsgLibera.lstRegistros.Add(objTabela);

        objLiberacao.strDirAce := 'PLPROE';
        objLiberacao.strMsgSen := 'Liberação para inclusão de um novo romaneio para os correios';
        objLiberacao.strCodOpe := strLoginUsuarioLogado;

        result := objLiberacao.fLibera;

        objLiberacao.Clear;

        if not result then
          exit;
      end;
    end;

    if fCfgSis('USIGEP') = 'A' then
      Exit;

    arrDadosDocumentos := fRetornaDocumentosCorreiosSemObjeto;
    Result := Length(arrDadosDocumentos) = 0;
    if not Result then
    begin
      SetLength(arrMensagem, 0);

      pAddDados(arrMensagem, '---------------------------------------------');
      pAddDados(arrMensagem, '| Documento         |  Espécie  |  Empresa  |');
      pAddDados(arrMensagem, '---------------------------------------------');

      for i := 0 to High(arrDadosDocumentos) do
      begin
        pAddDados(arrMensagem, '| ' + fPadR(arrDadosDocumentos[i].strNumDoc , 18, ' ') + '|' +
                               fPadC(arrDadosDocumentos[i].strEspDoc        , 11, ' ') + '|' +
                               fPadC(arrDadosDocumentos[i].strCodEmp        , 11, ' ') + '|');

      end;

      fMensagemTabela('ATENÇÃO!',
                      'Documentos',
                      arrMensagem,
                      'Não é possível gravar o romaneio, pois os documentos acima serão entregues pelos Correios e não possuem uma etiqueta gerada para envio. '+#13+'Para prosseguir, imprima a etiqueta de despacho destes documentos!',
                      ['&Ok'],
                      1,
                      False,
                      1,
                      0,
                      False,
                      0,
                      False,
                      False,
                      False,
                      0,
                      70);

    end;
  end;
end;

function TfrmFatRomaneio.fRomaneioParaCorreios : boolean;
var
  bkmRegistroAtual: TBookmark;
  qryDocs: TDataset;
begin
  result := false;
  qryDocs := dbgDocumentosDBView.DataController.DataSet;
  bkmRegistroAtual := qryDocs.GetBookmark;
  try
    qryDocs.first;
    while (not result) and (not qryDocs.eof) do
    begin
      if Pos(qryDocs.FieldByName('GER_MARDES').AsString,  'MP') > 0 then
        Result := fTransportadoraCorreio(qryDocs.FieldByName('GER_TRADOC').AsString);

      qryDocs.Next;
    end;
  finally
    qryDocs.GotoBookmark(bkmRegistroAtual);
    qryDocs.FreeBookmark(bkmRegistroAtual);
  end;
end;


function TfrmFatRomaneio.fPodeConfirmarRomaneioSimplificado: Boolean;
var
  strItens : String;

  strDocume,
  strVolume,
  strVolBip : String;

  prcScroll : TprcScroll;

  blnValidaDocumento : Boolean;

begin

  Result := True;

  If cdsTmpDoc.IsEmpty Then
    Exit;

  strItens := '';

  pDisableControls(cdsTmpDoc, prcScroll);

  Try

    cdsTmpDoc.First;
    While Not cdsTmpDoc.Eof Do
    Begin

      blnValidaDocumento := True;

      If (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger > 1) And (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) Then
        blnValidaDocumento := (ControleVolumesBipados.fRetornaQtdVolumesBipados(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                                                cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                                                cdsTmpDoc.FieldByName('GER_CODEMP').AsString) > 0);

      If (blnValidaDocumento) Then
      Begin

        strDocume := cdsTmpDoc.FieldByName('GER_NUMDOC').AsString + '-' + cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
        strVolume := fStrZero(cdsTmpDoc.FieldByName('GER_VOLUME').AsString, 2);
        strVolBip := fStrZero(cdsTmpDoc.FieldByName('GER_VOLBIP').AsString, 2);

        If (cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger < cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger) Then
          strItens := strItens + 'Doc.: '+strDocume+' - Vol.Doc: '+strVolume+' Vol.Bipado: ' + strVolBip + '.' + #13;

      End;

      cdsTmpDoc.Next;

    End;

  Finally
    pEnableControls(cdsTmpDoc, prcScroll);
  End;

  If Not fEmptyStr(strItens) Then
  Begin

    Try
      pCriarFormularios(TfrmObservacao, frmObservacao);
      frmObservacao.lblMensagem.Caption := 'Há documentos no grid que possuem volumes que não foram totalmente conferidos.' +
                                           'Finalize a conferência de todos os volumes antes de continuar.';
      frmObservacao.memObs.Texto := strItens;
      frmObservacao.ShowModal;
    Except
      On E: Exception Do
        pMensagensErro(E.Message, '[TfrmFatRomaneio.fPodeConfirmarRomaneioSimplificado]');
    End;

    pFreeAndNil(frmObservacao);

    Result := False;

  End;

end;

function TfrmFatRomaneio.fPodeIncluirDocumentoTransportadoraDiferente(strCodTra: String): TIncluirTransportadoraDiferente;
var
  prcScroll : TprcScroll;
  blnExiste : Boolean;
  strConfir : String;
  stlTransp : TStringList;
  strTransp : String;
  blnApenasEste : Boolean;
begin

  Result := itdSim;

  If fEmptyStr(strCodTra) then
    Exit;

  If cdsTmpDoc.IsEmpty Then
    Exit;

  pDisableControls(cdsTmpDoc, prcScroll);

  stlTransp := TStringList.Create;
  stlTransp.Clear;

  blnExiste := False;

  Try

    cdsTmpDoc.First;
    While Not cdsTmpDoc.Eof Do
    Begin

      blnApenasEste := cdsTmpDoc.FieldByName('APENAS_ESTE').AsString = 'S';
      strTransp     := cdsTmpDoc.FieldByName('GER_TRADOC').AsString + '-' + fRetNomTransportadora(cdsTmpDoc.FieldByName('GER_TRADOC').AsString);

      If (stlTransp.IndexOf(strTransp) <= -1) Then
        stlTransp.Add(strTransp);

      If (cdsTmpDoc.FieldByName('GER_TRADOC').AsString = strCodTra) And (Not blnApenasEste) Then
        blnExiste := True;

      cdsTmpDoc.Next;

    End;

    strConfir := '';
    If Not blnExiste Then
    Begin

      strConfir := 'O documento informado possui uma transportadora diferente dos que já foram incluídos no grid.'      + #13 +
                   'Transportadora do documento informado: ' + strCodTra + '-' + fRetNomTransportadora(strCodTra) + '.' + #13 +
                   'Transportadora do(s) documento(s) já inseridos no grid: ' + stlTransp.CommaText + '.'               + #13 +
                   'Deseja realmente continuar?';

      pMensagemSonora('', msTransportadoraDiferente);

      Result := TIncluirTransportadoraDiferente(fMensagem('Atenção!',
                                                          strConfir,
                                                          ['&Sim', '&Não', '&Apenas Este'],
                                                          2,
                                                          False,
                                                          1,
                                                          0,
                                                          True,
                                                          0,
                                                          False,
                                                          False,
                                                          False,
                                                          250,  {Altura}
                                                          500));

    End;

  Finally

    pEnableControls(cdsTmpDoc, prcScroll);

    If Assigned(stlTransp) Then
      FreeAndNil(stlTransp);

  End;

end;

function TfrmFatRomaneio.fPodeMarcarDocumento(var blnDeletaRegistro: Boolean): Boolean;
Var
  qryDocs             : TDataset;
  bkmRegAtu           : TBookmark;
  strNumFat           : String;
  strDocume           : String;
  strAutInc           : String;
  strPenFin           : String;
  strAutoincremPLPDOC : String;
  Smensagem           : String;
  blnDocumentoMultiVolumesSemBipagem : Boolean;
  blnTravarDocumento                 : Boolean;
  LblnUtilizarDataEmissaoCalcularDiaVencimento: boolean ;
begin
  Result := True;
  blnDeletaRegistro := False;
  try
    With cdsTmpDoc Do
    Begin

      If (FieldByName('GER_MARDES').AsString <> 'M') And
      (Not fEnderecoEntregaPreenchidoParaAppEntrega) Then
      Begin
        fMensagem('ATENÇÃO!', 'Não é possível selecionar o pedido.' + #13#10 +
                              'O endereço de entrega do documento não está preenchido!', ['&Ok']);
        Exit(False);
      End;

      If (fCfgSis('RTRASC', varBoolean)And (FieldByName('GER_MARDES').AsString <> 'M')) Then
      Begin
        If Not fValidaStatusCliente(FieldByName('GER_CODCLI').AsString) Then
        Begin
          Exit(False);
        End;
      End;

      If (cdsTmpDoc.FieldByName('GER_MARDES').AsString <> 'M') And
         fExisteCancelamentoPendentePorChaveAcesso(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                   cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                   cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                                                   cdsTmpDoc.FieldByName('GER_CODCLI').AsString) Then
        Exit(False);

      If (Not fEmptyStr(edtNumRom.Text) And (FieldByName('GER_MARDES').AsString = 'M')) Then
      Begin
        If fFoiIniciadoConferenciaDoRomaneioNoColetorDeDados(FieldByName('GER_NROROM').AsString,
                                                             FieldByName('GER_CODEMP').AsString) Then
        Begin
          fMensagem('ATENÇÃO!', 'Este romaneio esta em "Conferência de Carregamento" no coletor de dados!' + #13 +
                                'Desta forma, não é possível excluir este documento!', ['&Ok']);
          Exit(False);
        End;

        If fFoiFinalizadoConferenciaDoRomaneioNoColetorDeDados(FieldByName('GER_NROROM').AsString,
                                                               FieldByName('GER_CODEMP').AsString) Then
        Begin
          fMensagem('ATENÇÃO!', 'Este romaneio já foi finalizado em "Conferência de Carregamento" no coletor de dados!' + #13 +
                                'Desta forma, não é possível excluir este documento!', ['&Ok']);
          Exit(False);
        End;

        if fEntregaIniciadaPeloMotorista(FieldByName('GER_NROROM').AsString,
                                         FieldByName('GER_DOCORI').AsString,
                                         FieldByName('GER_ESPDOC').AsString,
                                         FieldByName('GER_CODEMP').AsString) then
        begin
          fMensagem('ATENÇÃO!', 'Não é permitido remover o documento "' + FieldByName('GER_NUMDOC').AsString + '" do romaneio pois o motorista já iniciou a entrega pelo APP Tá Entregue. ' +
                                'Entre em contato com o motorista para verificar a situação da entrega.' + #13 + 'Se for o caso, peça para o motorista ' +
                                'baixar o documento como não entregue através do APP e libere o documento pelo painel de entrega para que ele ' +
                                'possa ser inserido em um romaneio novo.', ['&Ok']);
          Result := False;
          Exit;
        end;
      End;

      if (FieldByName('GER_MARDES').AsString = 'M') and
         (TRomaneioRepository.fRomaneioVinculadoComDespesa(FieldByName('GER_NROROM').AsString,
                                                           Copy(FieldByName('GER_NUMDOC').AsString,1,
                                                           Pos('-', FieldByName('GER_NUMDOC').AsString)-1),
                                                           FieldByName('GER_CODEMP').AsString,
                                                           Smensagem)) then
      begin
        fMensagem('ATENÇÃO!',FieldByName('GER_NUMDOC').AsString + Smensagem, ['&Ok']);
        Result := False;
        Exit;
      end;

      If (FieldByName('GER_MARDES').AsString <> 'M') And
         fCfgSis('EMPFAT', varBoolean) And
         SameText(FieldByName('GER_ESPDOC').AsString, 'PD') Then
      Begin
        If fEhPedOrcMultiloja(FieldByName('GER_DOCORI').AsString,
                              FieldByName('GER_ESPDOC').AsString,
                              FieldByName('GER_CODEMP').AsString) Then
        Begin
          fMensagem('ATENÇÃO!', FieldByName('GER_NUMDOC').AsString + ' Pedido Multiloja. Desmembre-o antes de fazer o romaneio!', ['&Ok']);
          Result := False;
          Exit;
        End;
      End;

      If (FieldByName('GER_ESPDOC').AsString = 'PD') And
         (FieldByName('GER_MARDES').AsString = 'M') And
         (fCfgSis('OPCROM', varString) = '1') And
         (fCfgSis('TIPEXP', varString) = '5') And
         (Not fEmptyStr(edtNumRom.Text)) And
         ((Not fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean)) Or fCfgSis('USPRRO', varBoolean)) Then
      Begin
        If fPedidoFoiFaturado(FieldByName('GER_DOCORI').AsString,
                              FieldByName('GER_ESPDOC').AsString,
                              FieldByName('GER_CODEMP').AsString) Then
        Begin
          pMensagemOk(FieldByName('GER_NUMDOC').AsString + ' O pedido que está tentando remover já foi faturado! não será possível remove-lo do romaneio!');
          Result := False;
          Exit;
        End;
      End;

      If (FieldByName('GER_ESPDOC').AsString = 'PD') And
         (FieldByName('GER_MARDES').AsString <> 'M') And
         (fCfgSis('OPCROM') = '1') Then
      Begin
        If (fCfgSis('TIPEXP', VarString) = '5') Then
        Begin
          LblnUtilizarDataEmissaoCalcularDiaVencimento := TfatVenda.fUtilizarDataEmissaoCalcularDiaVencimento(FieldByName('GER_NUMDOC').AsString, FieldByName('GER_ESPDOC').AsString, FieldByName('GER_CODEMP').AsString) ;
          If (Not fPermiteClienteDiaFixoOuDiaSemana(FieldByName('GER_CODCLI').AsString, LblnUtilizarDataEmissaoCalcularDiaVencimento)) Then
          Begin
            Result := False;
            Exit;
          End;

          If (Not fPermiteUtilizarEstaCondPagamento(FieldByName('GER_CODCND').AsString, LblnUtilizarDataEmissaoCalcularDiaVencimento)) Then
          Begin
            Result := False;
            Exit;
          End;
        End;

        If fPedidoPossuiItensRetira(FieldByName('GER_DOCORI').AsString,
                                    FieldByName('GER_ESPDOC').AsString,
                                    FieldByName('GER_CODEMP').AsString) And

           fPedidoPossuiItensEntregaImediata(FieldByName('GER_DOCORI').AsString,
                                             FieldByName('GER_ESPDOC').AsString,
                                             FieldByName('GER_CODEMP').AsString) Then
        Begin
          pMensagemOk(FieldByName('GER_NUMDOC').AsString +
                      ' Não é possível selecionar este pedido para romaneio, ' +
                      'pois o mesmo possui itens de entrega e retira. ' +
                      'Será necessário passar no caixa para desmembrar este pedido!');
          Result := False;
          Exit;
        End;

        If not (fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean)) and
           fPedidoFoiFaturado(FieldByName('GER_DOCORI').AsString,
                              FieldByName('GER_ESPDOC').AsString,
                              FieldByName('GER_CODEMP').AsString) Then
        Begin
          blnDeletaRegistro := True;
          pMensagemOk(FieldByName('GER_NUMDOC').AsString + ' O pedido que está tentando selecionar já foi faturado por outra estação, e portanto, será removido da listagem!');
          Result := False;
          Exit;
        End;
      End;

      If fDocumentoFoiAlterado(FieldByName('GER_NOMTBL').AsString,
                               FieldByName('GER_DOCORI').AsString,
                               FieldByName('GER_ESPDOC').AsString,
                               FieldByName('GER_CODEMP').AsString,
                               FieldByName('GER_CODCLI').AsString,
                               FieldByName('GER_TIP_FC').AsString,
                               FieldByName('GER_VLRCON').AsFloat,
                               FieldByName('GER_ORIDOC').AsString,
                               FieldByName('GER_PERDEV').AsFloat) Then
      Begin
        fMensagem('', FieldByName('GER_NUMDOC').AsString + ' O documento que esta tentando selecionar sofreu alteração. ' + #13#10 +
                      'Você deve clicar novamente no botão consultar para recarregar os documentos com o valores atualizados!', ['&OK']);
        Result := False;
        Exit;
      End
      Else If (FieldByName('GER_MARDES').AsString <> 'M') And (Not fEmptyStr(edtNumRom.Text)) And (fDocumentoAdicionadoEmOutroRomaneio) Then
      Begin
        fMensagem('', 'Documento ' + FieldByName('GER_NUMDOC').AsString + ' já foi inserido em outro romaneio.' + #13#10 +
                      'Clique novamente no botão "Consultar" para que os documentos sejam recarregados!', ['&OK']);
        Result := False;
        Exit;
      End;

      If blnUsaPreRom Then
      Begin
        If (fCfgSis('TRFNRO', varBoolean)) Then
        Begin
          If Not fPedidoOriginalJaFaturado(FieldByName('GER_DOCORI').AsString, FieldByName('GER_ESPDOC').AsString, FieldByName('GER_CODEMP').AsString, FieldByName('GER_CODCLI').AsString, True) then
          Begin
            If Not fPedidoBaixaEntregaFutura(FieldByName('GER_DOCORI').AsString,
                                             FieldByName('GER_ESPDOC').AsString,
                                             FieldByName('GER_CODEMP').AsString) Then
            Begin
              If Not fValidaSituacaoFinanceiraPedido(FieldByName('GER_DOCORI').AsString,
                                                     FieldByName('GER_ESPDOC').AsString,
                                                     FieldByName('GER_CODEMP').AsString,
                                                     strPenFin) Then
              Begin
                pMensagemOk(strPenFin + '!');
                Result := False;
                Exit;
              End;
            End;
          End;
        End;

        strAutInc := fCampoTabela('AUTOINCREM', 'FATGOR',
                                  ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP','FGO_CODCLI'],
                                  [FieldByName('GER_DOCORI').AsString,
                                   FieldByName('GER_ESPDOC').AsString,
                                   FieldByName('GER_CODEMP').AsString,
                                   FieldByName('GER_CODCLI').AsString]);

        If (Not fEmptyStr(edtNumRom.Text)) And
           (fPedidoExpedido(strAutInc))    Then
        Begin
          If (FieldByName('GER_MARDES').AsString = 'M') Then
          Begin
            If (Not fVerificaAcessoSistema('EXPDEX', strLoginUsuarioLogado)) Then
            Begin
              pMensagemOk('Usuário não tem permissão para excluir do romaneio' + #13 +
                          'pedidos que já foram expedidos!');
              Result := False;
              Exit;
            End
            Else
              stlPedExp.Add(strAutInc);
          End
          Else
          Begin
            If (stlPedExp.IndexOf(strAutInc) > -1) Then
              stlPedExp.Delete(stlPedExp.IndexOf(strAutInc));
          End;
        End;
      End;

      If (Not fEmptyStr(FieldByName('TRA_EMPDES').AsString)) And
         (FieldByName('TRA_EMPDES').AsString <> VS_strCodEmp) Then
      Begin
        pMensagemOk(FieldByName('GER_NUMDOC').AsString +
                    ' Não é possível selecionar este pedido para romaneio, ' +
                    'pois o mesmo teve transbordo recebido na filial: ' + FieldByName('TRA_EMPDES').AsString);
        Result := False;
        Exit;
      End;

      If (FieldByName('GER_MARDES').AsString <> 'M') And
         (strOpcRom = '1') And
         (fCfgSis('ROMVSF', varBoolean)) And
         (fClienteFilial(FieldByName('GER_CODCLI').AsString)) Then
      Begin
        If Not fValidaSaldoDisponivelItensPed(FieldByName('GER_DOCORI').AsString,
                                              FieldByName('GER_ESPDOC').AsString,
                                              FieldByName('GER_CODEMP').AsString,
                                              FieldByName('GER_CODCLI').AsString) Then
        Begin
          Result := False;
          Exit;
        End;
      End;
    End;

    qryDocs := dbgDocumentosDBView.DataController.DataSet;
    bkmRegAtu := qryDocs.GetBookmark;

    strNumFat := qryDocs.FieldByName('GER_NUMFAT').AsString;
    strDocume := qryDocs.FieldByName('GER_DOCUME').AsString;

    If (Not fEmptyStr(strNumFat)) Then
    Begin
      If qryDocs.Locate('GER_DOCUME', strNumFat, []) Then
        Result := (qryDocs.FieldByName('GER_MARDES').AsString <> 'M');
    End
    Else If (Not fEmptyStr(strDocume)) Then
    Begin
      If qryDocs.Locate('GER_NUMFAT', strDocume, []) Then
        Result := (qryDocs.FieldByName('GER_MARDES').AsString <> 'M');
    End;

    qryDocs.GotoBookmark(bkmRegAtu);
    qryDocs.FreeBookmark(bkmRegAtu);

    If (Not Result) Then
    Begin
      fMensagem('ATENÇÃO!', 'Existe um documento relacionado a esse documento que já está marcado!', ['&Ok']);
    End;

    If (Result) And ( Not fCfgSis('ROMBCX', varBoolean) ) And (fCfgSis('CFVLCB', varBoolean)) And (qryDocs.FieldByName('GER_MARDES').AsString <> 'M') Then
    Begin
      Result := fSolicitaVerificacaoDeCodigoBarras;
    End;

    if Result and fUsaPLPPorRomaneio then
    begin
      if fTransportadoraCorreio(qryDocs.FieldByName('GER_TRADOC').AsString) then
      begin
        if Pos(qryDocs.FieldByName('GER_MARDES').AsString, 'MP') > 0 then
        begin
          if fPLPDocumentoJaEnviada(qryDocs.FieldByName('GER_DOCORI').AsString, qryDocs.FieldByName('GER_ESPDOC').AsString, qryDocs.FieldByName('GER_CODEMP').AsString) then
          begin
            pMensagemOk('Este documento está em uma Pré-Lista de postagem dos Correios já enviada, e não pode ser removido do Romaneio');
            Result := False;
          end;
        end
        else
        begin
          if not fValidaDocumentosCorreios(true) then
          begin
            pMensagemOk('Não é possível selecionar este documento, pois ele será entregue pelos correios e existem documentos de outras transportadoras selecionados!');
            result := false;
          end
          else
          begin
            if fCfgSis('USIGEP') <> 'A' then
            begin

              strAutoincremPLPDOC := fRetornaAutoincremPLPDOC(qryDocs.FieldByName('GER_DOCORI').AsString, qryDocs.FieldByName('GER_ESPDOC').AsString, qryDocs.FieldByName('GER_CODEMP').AsString);

              if fEmptyStr(strAutoincremPLPDOC) then
              begin
                Try
                  if fVerificaAcessoSistema('frmImpEtiquetasEst') then
                  begin
                    fImpEtiDespacho(qryDocs);

                    strAutoincremPLPDOC := fRetornaAutoincremPLPDOC(qryDocs.FieldByName('GER_DOCORI').AsString, qryDocs.FieldByName('GER_ESPDOC').AsString, qryDocs.FieldByName('GER_CODEMP').AsString);
                  end;

                Except
                  On E: Exception Do
                  begin
                    result := False;
                    pMensagensErro(E.Message, '[frmFatRomaneio.fPodeMarcarDocumento]');
                  end;
                End;

              end;

              if fEmptyStr(strAutoincremPLPDOC) then
              begin
                pMensagemOk('Não foi possível adicionar o documento ao romaneio, pois a etiqueta de despacho ainda não foi impressa');
                result := false;
              end;

            end;
          end;

        end;
      end
      else if Pos(qryDocs.FieldByName('GER_MARDES').AsString, 'MP') <= 0 then
      begin
        if not fValidaDocumentosCorreios(false) then
        begin
          pMensagemOk('Não é possível selecionar este documento, pois existem documentos que serão entregues pelos Correios selecionados e ele será entregue por outra transportadora!');
          result := false;
        end;
      end;
    end;

    if Result And  fCfgSis('MANUSA', varBoolean) then
    Begin

      if (FObjMandaeRepositorio.fTransportadoraIntegraComMandae(qryDocs.FieldByName('GER_TRADOC').AsString)) And
         (fEmptyStr(fCfgSis('MANESP')) or (Pos(qryDocs.FieldByName('GER_ESPDOC').AsString, fTransform(fCfgSis('MANESP'), 2)) > 0)) then
      Begin

        if Pos(qryDocs.FieldByName('GER_MARDES').AsString, 'MP') > 0 then
        begin
          if FObjMandaeRepositorio.fDocumentoJaIntegradoComMandae(qryDocs.FieldByName('GER_DOCORI').AsString,
                                                                  qryDocs.FieldByName('GER_ESPDOC').AsString,
                                                                  qryDocs.FieldByName('GER_CODEMP').AsString) then
          begin
            pMensagemOk('Já foi realizado o envio de encomenda à Mandaê deste documento e ele não pode ser removido do Romaneio!');
            Result := False;
          end;
        end
        Else
        Begin
          if not FObjMandaeRepositorio.fDocumentoJaPossuiEtiqueta(qryDocs.FieldByName('GER_DOCORI').AsString,
                                                                  qryDocs.FieldByName('GER_ESPDOC').AsString,
                                                                  qryDocs.FieldByName('GER_CODEMP').AsString) then
          Begin
            If (fMensagem('ATENÇÃO!', 'Não é possível adicionar este documento ao romaneio pois a etiqueta de despacho ainda não foi impressa. '+
              'Deseja imprimir a etiqueta ?' , ['&Sim', '&Não'], 2) = 1) Then
            Begin
              fImpEtiDespacho(qryDocs);

              if not FObjMandaeRepositorio.fDocumentoJaPossuiEtiqueta(qryDocs.FieldByName('GER_DOCORI').AsString,
                                                                      qryDocs.FieldByName('GER_ESPDOC').AsString,
                                                                      qryDocs.FieldByName('GER_CODEMP').AsString) then
              begin
                pMensagemOk('Não foi possível adicionar o documento ao romaneio pois a etiqueta de despacho ainda não foi impressa');
                result := false;
              end;

            End
            Else
            Begin
              pMensagemOk('Não foi possível adicionar o documento ao romaneio pois a etiqueta de despacho ainda não foi impressa');
              result := false;
            End;

          End;
        End;

      End;

    End;

    If (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') <= 0) And (Not fValidaSelecinarClienteComCargaExclusiva()) Then
    Begin
      Result := False;
    End;

    blnDocumentoMultiVolumesSemBipagem := (fEhRomaneioSimplificado)                            And
                                          (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) And
                                          (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger > 1)  And
                                          (ControleVolumesBipados.fRetornaQtdVolumesBipados(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                                                            cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                                                            cdsTmpDoc.FieldByName('GER_CODEMP').AsString) = 0);

    blnTravarDocumento := (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') <= 0) And
                          fEmptyStr(cdsTmpDoc.FieldByName('GER_NROROM').AsString)        And // <<-- Ja esta Travado nao precisa travar novamente
                          (Not blnDocumentoMultiVolumesSemBipagem);


    If (Result) And (blnTravarDocumento) Then
      Result := fTravaDocumento(qryDocs.FieldByName('GER_NOMTBL').AsString,
                                qryDocs.FieldByName('GER_NUMDOC').AsString,
                                qryDocs.FieldByName('GER_CODEMP').AsString,
                                qryDocs.FieldByName('GER_ENTSAI').AsString);

  except
    on E: Exception do
    begin
      Result := False;
      blnDeletaRegistro := False;
      pMensagensErro(E.Message, '[TfrmFatRomaneio.fPodeMarcarDocumento]');
    end;
  end;

end;

function TfrmFatRomaneio.fPossuiDocComPreviaImpressa: Boolean;
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  Try
    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    cdsTmpDoc.OnFilterRecord := Nil;
    cdsTmpDoc.Filtered := False;

    cdsTmpDoc.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+')) AND ';
    cdsTmpDoc.Filter := cdsTmpDoc.Filter + '(GER_ORIDOC <> ' + QuotedStr('D') + ')';
    If strOpcRom <> '3' Then
      cdsTmpDoc.Filter := cdsTmpDoc.Filter + ' AND ((GER_ESPDOC <> ' + QuotedStr('TR') + ') OR (GER_ESPDOC <> ' + QuotedStr('BR') + '))';
    cdsTmpDoc.Filter := cdsTmpDoc.Filter + ' AND (GER_PRVIMP = '+ QuotedStr('S') +') ';

    cdsTmpDoc.Filtered := True;

    Result := cdsTmpDoc.RecordCount > 0;

    cdsTmpDoc.Filter := '';
    cdsTmpDoc.Filtered := False;
  Finally
    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;
end;

function TfrmFatRomaneio.fSolicitaVerificacaoDeCodigoBarras: Boolean;
  Var
    qryDocs: TDataSet;
begin
  qryDocs := dbgDocumentosDBView.DataController.DataSet;
  
  If qryDocs.FieldByName('GER_VOLUME').AsFloat <= 0 Then
  Begin
    Result := True;
    Exit;
  End;

  pCriarFormularios(TfrmFatRomConferenciaVolumes, frmFatRomConferenciaVolumes);
  Try
    frmFatRomConferenciaVolumes.intQtdVolumes := fFloatToInt(qryDocs.FieldByName('GER_VOLUME').AsFloat);
    frmFatRomConferenciaVolumes.strNumDoc := qryDocs.FieldByName('GER_NUMDOC').AsString;
    frmFatRomConferenciaVolumes.strEspDoc := qryDocs.FieldByName('GER_ESPDOC').AsString;
    frmFatRomConferenciaVolumes.strCodEmp := qryDocs.FieldByName('GER_CODEMP').AsString;
    Result := (frmFatRomConferenciaVolumes.ShowModal = mrOk);
  Finally
    FreeAndNil(frmFatRomConferenciaVolumes);
  End;
end;

procedure TfrmFatRomaneio.btnLimparObsClick(Sender: TObject);
var
  intRemovidas: Integer;
begin
  inherited;

  If (Not cdsTmpDoc.Active) Or
     (cdsTmpDoc.IsEmpty)    Then
  Begin
    fMensagem('ATENÇÃO!', 'Nenhum documento está sendo listado no momento.' +#13
                         +'Verifique os parâmetros da consulta e tente novamente', ['&Ok']);
    Exit;
  End;

  If (fMensagem('ATENÇÃO!',
        Format('Esta opção removerá TODAS as observações do documento %s-%s-%s'
        +' exceto às geradas eventualmente em exclusões efetuadas pela rotina "Baixa de Romaneio"! ' + sLineBreak
        +'Deseja continuar?', [cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
            cdsTmpDoc.FieldByName('GER_CODEMP').AsString]), ['&Sim', '&Não'], 2) = 1)
  Then
  Begin
    Try
      intRemovidas := fRemoverObservacoes(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                          cdsTmpDoc.FieldByName('GER_CODEMP').AsString);

      If intRemovidas > 0 Then
      Begin
        fMensagem(Format('Obs. %s-%s-%s',
          [cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
           cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
           cdsTmpDoc.FieldByName('GER_CODEMP').AsString]),
           IntToStr(intRemovidas) +' observações removidas com sucesso!', ['&Ok']);

        stlDocSemLogRom.Clear;
        
        cdsTmpDoc.Edit;
        cdsTmpDoc.FieldByName('POSOBS').AsString := '';
        cdsTmpDoc.Post;
      End
      Else
        fMensagem('', 'Nenhuma observação encontrada', ['&Ok']);
    Finally
      pAfterScrollCdsTmpDoc(cdsTmpDoc);
    End;
  End;
end;

function TfrmFatRomaneio.fRetAutoIncremSelecionadosFmtIn: String;
  Var
    cdsTmp : TUniClientDataSet;
begin
  Result := '';

  cdsTmp := TUniClientDataSet.Create(Self);
  Try
    pCloneDataSet(cdsTmp, cdsTmpDoc);
    cdsTmp.First;
    While not cdsTmp.Eof Do
    Begin
      If cdsTmp.FieldByName('GER_MARDES').AsString = 'M' Then
      Begin
        If fEmptyStr(Result) Then
          Result := QuotedStr(cdsTmp.FieldByName('GER_AUTINC').AsString)
        Else
          Result := Result + ',' + QuotedStr(cdsTmp.FieldByName('GER_AUTINC').AsString);
      End;

      cdsTmp.Next;
    End;
  Finally
    FreeAndNil(cdsTmp);
  End;
end;

procedure TfrmFatRomaneio.btnLimpaSeparacaoClick(Sender: TObject);
var
  objSeparacaoFina : TSeparacaoFina;
  blnExcluirExtLar: Boolean;
begin
  inherited;

  if fMensagem( '', 'Deseja limpar a separação dos documentos marcados ?', ['&Sim', '&Não'], 2 ) = 2 Then
    Exit;

  blnExcluirExtLar := fValidaExcluiEXTLAR;

  If (fItensConferidosNaoFaturados(fRetAutoIncremSelecionadosFmtIn)) Then
  Begin
    If (fMensagem('', 'O(s) documento(s) selecionado(s) possui itens que já '+
                      'foram conferidos. Ao limpar a separação, a conferência '+
                      'também será zerada. '+ sLineBreak +
                      'Deseja limpar a separação dos documentos marcados?', ['&Sim', '&Não']) = 2) Then
    Begin
      Exit;
    End;
  End;

  Try
    Try
      fStartTransaction;

      cdsTmpDoc.DisableControls;
      cdsTmpDoc.First;
      While not cdsTmpDoc.Eof Do
      Begin
        If cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M' Then
          fLimpaExpedicaoPedido(cdsTmpDoc.FieldByName('GER_AUTINC').AsString, IIF(blnExcluirExtLar, eeloExcluir, eeloNaoExcluir));

        cdsTmpDoc.Next;
      End;

      objSeparacaoFina :=  TSeparacaoFina.Create(tdsRomaneio, VS_strCodEmp);
      objSeparacaoFina.strNumeroDocumento := edtNumRom.Text;
      objSeparacaoFina.pLimpaSeparacaoStatus;
      objSeparacaoFina.pLimpaConferenciaStatus;

      fCommit;

      fMensagem('', 'Separação limpa com sucesso!', ['&Ok']);
    Finally
      cdsTmpDoc.First;
      cdsTmpDoc.EnableControls;
    End;

  Except
    On E : Exception Do
    Begin
      fRollBack;
      pMensagensErro(E.Message,'btnLimpaSeparacaoClick');
    End;
  End;

end;

procedure TfrmFatRomaneio.btnOutEntClick(Sender: TObject);
Var
  dtaDtaUti                   : TDateTime;
  prcScroll                   : TprcScroll;
  blnWasEnabled               : Boolean;
  blnCarregarDocumentosOXGrid : Boolean;
begin

  if not btnOutEnt.Visible then
    Exit;

  inherited;
  Try

    pCriarFormularios(TFrmFatRomOutEntregas, frmFatRomOutEntregas);
    frmFatRomOutEntregas.ShowModal;

    blnCarregarDocumentosOXGrid := (Not frmFatRomOutEntregas.fcdsOutEnt.IsEmpty) And
                                   (fEmptyStr(edtNumRom.Text))                   And
                                   (Assigned(cdsTmpDoc))                         And
                                   (cdsTmpDoc.Active)                            And
                                   (Not cdsTmpDoc.IsEmpty);

    If Not(blnCarregarDocumentosOXGrid) Then
      blnCarregarDocumentosOXGrid := (fEhRomaneioSimplificado)                     And
                                     (Not frmFatRomOutEntregas.fcdsOutEnt.IsEmpty) And
                                     (Assigned(cdsTmpDoc))                         And
                                     (cdsTmpDoc.Active);

    If (blnCarregarDocumentosOXGrid) Then
    Begin
      blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);
      Try
        With frmFatRomOutEntregas Do
        Begin
          fcdsOutEnt.First;
          While Not fcdsOutEnt.Eof Do
          Begin
            If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) And
               (Not fEmptyStr(fTiraCaracEspeciais(mskDtaFin.Text))) Then
            Begin
              dtaDtaUti := IIF(rdbEntrada.Checked, fcdsOutEnt.FieldByName('DIG_DTAENT').AsDateTime,
                                                   fcdsOutEnt.FieldByName('DIG_DTAETR').AsDateTime);

              If (dtaDtaUti < StrToDate(mskDtaIni.Text)) Or
                 (dtaDtaUti > StrToDate(mskDtaFin.Text)) Then
              Begin
                fcdsOutEnt.Next;
                Continue;
              End;
            End;

            If (Not fEmptyStr(edtCodReg.Text)) Then
            Begin
              If (fcdsOutEnt.FieldByName('DIG_CODREG').AsString <> edtCodReg.Text) Then
              Begin
                fcdsOutEnt.Next;
                Continue;
              End;
            End;

            cdsTmpDoc.Append;
            cdsTmpDoc.FieldByName('GER_NUMDOC').AsString := fcdsOutEnt.FieldByName('DIG_NUMDOC').AsString + '-' + fcdsOutEnt.FieldByName('DIG_ESPDOC').AsString;
            cdsTmpDoc.FieldByName('GER_DOCORI').AsString := fcdsOutEnt.FieldByName('DIG_NUMDOC').AsString;
            cdsTmpDoc.FieldByName('GER_CODVEN').AsString := fcdsOutEnt.FieldByName('DIG_CODVEN').AsString;
            cdsTmpDoc.FieldByName('GER_ESPDOC').AsString := fcdsOutEnt.FieldByName('DIG_ESPDOC').AsString;
            cdsTmpDoc.FieldByName('GER_CODEMP').AsString := fcdsOutEnt.FieldByName('DIG_CODEMP').AsString;
            cdsTmpDoc.FieldByName('GER_CODCLI').AsString := fcdsOutEnt.FieldByName('DIG_CODCLI').AsString;
            cdsTmpDoc.FieldByName('GER_NOMCLI').AsString := Copy(fcdsOutEnt.FieldByName('DIG_DESCRI').AsString, 1, 60);
            cdsTmpDoc.FieldByName('GER_HORENT').AsDateTime := fcdsOutEnt.FieldByName('DIG_HORENT').AsDateTime;
            cdsTmpDoc.FieldByName('GER_DTAENT').AsDateTime := fcdsOutEnt.FieldByName('DIG_DTAENT').AsDateTime;
            cdsTmpDoc.FieldByName('GER_DTENTR').AsDateTime := fcdsOutEnt.FieldByName('DIG_DTAETR').AsDateTime;
            cdsTmpDoc.FieldByName('GER_ENTSAI').AsString := 'S';
            cdsTmpDoc.FieldByName('FIS_ACESSO').AsString := '';
            cdsTmpDoc.FieldByName('GER_VLRCON').AsFloat := fcdsOutEnt.FieldByName('DIG_VALDOC').AsFloat;
            cdsTmpDoc.FieldByName('GER_VALDOC').AsFloat := fcdsOutEnt.FieldByName('DIG_VALDOC').AsFloat;
            cdsTmpDoc.FieldByName('GER_VLRPRO').AsFloat := 0;
            cdsTmpDoc.FieldByName('GER_PESBRU').AsFloat := fcdsOutEnt.FieldByName('DIG_PESBRU').AsFloat;
            cdsTmpDoc.FieldByName('GER_MARDES').AsString := 'D';
            cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat := 0;
            cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat := 0;
            cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger := 0;
            cdsTmpDoc.FieldByName('INCREMENTO').AsInteger := 0;
            cdsTmpDoc.FieldByName('GER_NOMTBL').AsString := 'OUTDIGX';
            cdsTmpDoc.FieldByName('GER_TOTDET').AsFloat := 0;
            cdsTmpDoc.FieldByName('GER_ENDCON').AsString := fcdsOutEnt.FieldByName('DIG_ENDCON').AsString;
            cdsTmpDoc.FieldByName('GER_BAIRRO').AsString := fcdsOutEnt.FieldByName('DIG_BAIRRO').AsString;
            cdsTmpDoc.FieldByName('GER_CEPCON').AsString := fcdsOutEnt.FieldByName('DIG_CEPCON').AsString;
            cdsTmpDoc.FieldByName('CID_CODCID').AsString := fcdsOutEnt.FieldByName('DIG_CODCID').AsString;
            cdsTmpDoc.FieldByName('GER_NOMCID').AsString := fcdsOutEnt.FieldByName('DIG_NOMCID').AsString;
            cdsTmpDoc.FieldByName('GER_ESTADO').AsString := fcdsOutEnt.FieldByName('DIG_ESTADO').AsString;
            cdsTmpDoc.FieldByName('GER_REFCON').AsString := fcdsOutEnt.FieldByName('DIG_REFCON').AsString;
            if fCfgSis('MATDIS', varBoolean) then
            begin
              cdsTmpDoc.FieldByName('GER_LOCALI').AsString := '';
              cdsTmpDoc.FieldByName('GER_LIBAPP').AsString := 'N';
            end;

            cdsTmpDoc.Post;

            If (fEhRomaneioSimplificado) Then
              pMarcarNota_Documento_(fcdsOutEnt.FieldByName('DIG_NUMDOC').AsString,
                                     fcdsOutEnt.FieldByName('DIG_ESPDOC').AsString,
                                     fcdsOutEnt.FieldByName('DIG_CODEMP').AsString,
                                     False,
                                     True);
            fcdsOutEnt.Next;

          End;
        End;
      Finally
        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[TfrmFatRomaneio.btnOutEntClick]');
  End;
  pFreeAndNil(frmFatRomOutEntregas);
end;

function TfrmFatRomaneio.fGetChaveLayoutGrid: String;
begin
  Result := Self.Name + '.' + dbgDocumentosDBView.Name;
end;

function TfrmFatRomaneio.fGetFiltroTipoDocumento: String;
begin
  Result := '';

  if (not fExibeFiltroTipoDocumento) then
    Exit;

  if rdbTotalmenteConferido.Checked then
  begin
    Result := Result + ' AND (IFNULL((                                                ';
    Result := Result + '        SELECT SUM(T1.DET_QTDITE)                             ';
    Result := Result + '        FROM MOVDET T1                                        ';
    Result := Result + '        INNER JOIN MOVTRI T2 ON T1.AUTOINCREM = T2.DET_SEQGER ';
    Result := Result + '        WHERE T1.DET_SEQGER = MOVGER.AUTOINCREM), 0)          ';
    Result := Result + '      =                                                       ';
    Result := Result + '      IFNULL((                                                ';
    Result := Result + '        SELECT SUM(IFNULL(T2.DET_QTDEXP, 0))                  ';
    Result := Result + '        FROM MOVDET T1                                        ';
    Result := Result + '        INNER JOIN MOVTRI T2 ON T1.AUTOINCREM = T2.DET_SEQGER ';
    Result := Result + '        WHERE T1.DET_SEQGER = MOVGER.AUTOINCREM               ';
    Result := Result + '        ), 0)                                                 ';
    Result := Result + '      )                                                       ';
  end
  else if rdbParcialmenteConferido.Checked then
  begin
    Result := Result + ' AND (IFNULL((                                                ';
    Result := Result + '        SELECT SUM(T1.DET_QTDITE)                             ';
    Result := Result + '        FROM MOVDET T1                                        ';
    Result := Result + '        INNER JOIN MOVTRI T2 ON T1.AUTOINCREM = T2.DET_SEQGER ';
    Result := Result + '        WHERE T1.DET_SEQGER = MOVGER.AUTOINCREM               ';
    Result := Result + '        ), 0)                                                 ';
    Result := Result + '      <>                                                      ';
    Result := Result + '      IFNULL((                                                ';
    Result := Result + '        SELECT SUM(T2.DET_QTDEXP)                             ';
    Result := Result + '        FROM MOVDET T1                                        ';
    Result := Result + '        INNER JOIN MOVTRI T2 ON T1.AUTOINCREM = T2.DET_SEQGER ';
    Result := Result + '        WHERE T1.DET_SEQGER = MOVGER.AUTOINCREM               ';
    Result := Result + '        ), 0)                                                 ';
    Result := Result + '      OR                                                      ';
    Result := Result + '      IFNULL((                                                ';
    Result := Result + '        SELECT SUM(T2.DET_QTDEXP)                             ';
    Result := Result + '        FROM MOVDET T1                                        ';
    Result := Result + '        INNER JOIN MOVTRI T2 ON T1.AUTOINCREM = T2.DET_SEQGER ';
    Result := Result + '        WHERE T1.DET_SEQGER = MOVGER.AUTOINCREM               ';
    Result := Result + '        ), 0) = 0                                             ';
    Result := Result + '      )                                                       ';
  end;
end;

function TfrmFatRomaneio.fGetSQLDocumentos(ATmpTbl, ATabela: String): String;
begin
  Result := '';
  Result := Result + 'SELECT ';
  Result := Result + '  G.*, ';
  Result := Result + '  "' + ATabela + '" GER_NOMTBL, ';
  Result := Result + '  G.AUTOINCREM AS GER_AUTINC, ';
  Result := Result + '  IFNULL(AUX_ENTGER, "") AS AUX_ENTGER  ';  // REFERENCIA DO ENDERECO DE ENTREGA
  Result := Result + 'FROM ' + ATabela + ' G ';
  Result := Result + FTemporariaDocumentosRomaneio.fGetJoinDocumentos(ATmpTbl, 'G.AUTOINCREM');
  Result := Result + ' LEFT JOIN ' + fRetNomTabAuxMov(ATabela) + ' ON AUX_SEQGER = G.AUTOINCREM ';
  Result := Result + 'GROUP BY ';
  Result := Result + ' G.GER_NUMDOC, ';
  Result := Result + ' G.GER_ESPDOC, ';
  Result := Result + ' G.GER_CODCLI, ';
  Result := Result + ' G.GER_CODEMP ';
end;

function TfrmFatRomaneio.fGetSQLPosObs(strAlias, strCmpNumDoc, strCmpEspDoc, strCmpCodEmp: String): String;
begin
  Result := Result + ' (SELECT IF(COUNT(*) > 0, "S", " ")   ';
  Result := Result + '    FROM LOGROM L                     ';
  Result := Result + '   WHERE L.GER_NUMDOC = '+strAlias+'.'+strCmpNumDoc;
  Result := Result + '     AND L.GER_ESPDOC = '+strAlias+'.'+strCmpEspDoc;
  Result := Result + '     AND L.GER_EMPDOC = '+strAlias+'.'+strCmpCodEmp+' ) ';
end;

function TfrmFatRomaneio.fGetWhereDocsExpedidos(strAlias: String; blnUsarAnd: Boolean = False): String;
begin
  Result := '';

  If fUsaRomaneioDocsExpedidos Then
  Begin
    If (Not blnUsarAnd) Then
    Begin
      If (rdgTurno.ItemIndex = 3) Then
        Result := Result + ' HAVING '
      Else
        Result := Result + ' AND ';
    End
    Else
      Result := Result + ' AND ';

    Result := Result + ' IF((LOCATE(' + strAlias + '.GER_ESPDOC, "PD_DV_PR_OX_") > 0) OR (GER_ORIDOC = "D"), TRUE, ';
    Result := Result + '       (SELECT ';
    Result := Result + '          SUM(COALESCE(TMPTRI.DET_QTDEXP, 0)) AS QTDEXP ';
    Result := Result + '        FROM ';
    Result := Result + '          MOVDET TMPDET ';
    Result := Result + '        LEFT JOIN MOVTRI TMPTRI ON (TMPTRI.DET_SEQGER = TMPDET.AUTOINCREM) ';
    Result := Result + '        WHERE ';
    Result := Result + '          TMPDET.DET_NUMDOC = ' + strAlias + '.GER_NUMDOC AND   ';
    Result := Result + '          TMPDET.DET_ESPDOC = ' + strAlias + '.GER_ESPDOC AND   ';
    Result := Result + '          TMPDET.DET_CODEMP = ' + strAlias + '.GER_CODEMP AND   ';
    Result := Result + '          TMPDET.DET_CODCLI = ' + strAlias + '.GER_CODCLI) > 0) ';
  End;
end;

function TfrmFatRomaneio.fGravaDocRemovidosParaConferencia: Boolean;
begin
  Result := True;

  if fEmptyStr(edtNumRom.Text) then
    Exit;

  if (not fUtilizaConferenciaDocsRemovidosRomaneio) then
    Exit;

  try
    cdsTmpDoc.OnFilterRecord := Nil;
    cdsTmpDoc.Filtered := False;
    cdsTmpDoc.Filter := 'GER_MARDES = ' + QuotedStr('D');
    cdsTmpDoc.Filtered := True;

    cdsTmpDoc.First;

    while not cdsTmpDoc.Eof do
    begin
      if (not fEmptyStr(cdsTmpDoc.FieldByName('GER_NROROM').AsString)) then
        fInsereDocRemovidoRomaneioParaConferencia(
          cdsTmpDoc.FieldByName('GER_NROROM').AsString,
          VS_strCodEmp,
          cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
          cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
          cdsTmpDoc.FieldByName('GER_CODCLI').AsString,
          cdsTmpDoc.FieldByName('GER_DTAROM').AsDateTime,
          cdsTmpDoc.FieldByName('GER_DTAENT').AsDateTime,
          cdsTmpDoc.FieldByName('GER_VOLUME').AsFloat);

      cdsTmpDoc.Next;
    end;
  except on E: Exception do
    raise;
  end;
end;

function TfrmFatRomaneio.fGravaOutrasEntregas(strNumRom, strEmpRom: String): Boolean;
  Var
    strSQL : String;
    strInc : String;
    qryGen : TUniQuery;
begin
  Result := True;
  qryGen := fCriaQuery(Nil);

  strSQL := '';
  strSQL := strSQL + ' DELETE                    ';
  strSQL := strSQL + ' FROM                      ';
  strSQL := strSQL + '   ROMOUTX                 ';
  strSQL := strSQL + ' WHERE                     ';
  strSQL := strSQL + '   OUT_NUMROM =:NUMROM AND ';
  strSQL := strSQL + '   OUT_ROMEMP =:ROMEMP     ';

  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMROM').AsString := strNumRom;
    ParamByName('ROMEMP').AsString := strEmpRom;
    ExecSQL;
  End;

  pInsereDevolucoesOutEnt(strNumRom);

  cdsOutEnt.Close;
  cdsOutEnt.Open;  

  strSQL := '';
  strSQL := strSQL + ' INSERT INTO ROMOUTX ';
  strSQL := strSQL + '   (                 ';
  strSQL := strSQL + '   AUTOINCREM,       ';
  strSQL := strSQL + '   OUT_NUMROM,       ';
  strSQL := strSQL + '   OUT_ROMEMP,       ';
  strSQL := strSQL + '   OUT_DESCRI,       ';
  strSQL := strSQL + '   OUT_SEQDIG        ';
  strSQL := strSQL + '   )                 ';
  strSQL := strSQL + '   VALUES            ';
  strSQL := strSQL + '   (                 ';
  strSQL := strSQL + '   :INCREM,          ';
  strSQL := strSQL + '   :NUMROM,          ';
  strSQL := strSQL + '   :ROMEMP,          ';
  strSQL := strSQL + '   :DESCRI,          ';
  strSQL := strSQL + '   :SEQDIG           ';
  strSQL := strSQL + '   )                 ';

  If Not cdsOutEnt.IsEmpty Then
  Begin
    cdsOutEnt.First;
    While Not cdsOutEnt.Eof Do
    Begin
      strInc := fRetAutoIncrem('ROMOUTX', VS_strCodEmp);
      With qryGen Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('INCREM').AsString := strInc;
        ParamByName('NUMROM').AsString := strNumRom;
        ParamByName('ROMEMP').AsString := strEmpRom;
        ParamByName('DESCRI').AsString := cdsOutEnt.FieldByName('DESCRI').AsString;
        ParamByName('SEQDIG').AsString := cdsOutEnt.FieldByName('SEQDIG').AsString;
        ExecSQL;
      End;
      cdsOutEnt.Next;
    End;
  End;

  FreeAndNil(qryGen);
end;

procedure TfrmFatRomaneio.pCarregaOutrasSaidas(strNumRom, strCodEmp: String);
  Var
    qryGen : TUniQuery;
begin
  If fEmptyStr(strNumRom) Then
    Exit;

  qryGen := fCriaQuery(Nil);

  With qryGen Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT                     ');
    SQL.Add('   OUT_DESCRI               ');
    SQL.Add(' FROM                       ');
    SQL.Add('   ROMOUTX                  ');
    SQL.Add(' WHERE                      ');
    SQL.Add('   OUT_NUMROM =:NUMROM AND  ');
    SQL.Add('   OUT_ROMEMP =:ROMEMP AND  ');
    SQL.Add('   OUT_SEQDIG IS NULL  AND  ');
    SQL.Add('   OUT_DESCRI NOT LIKE "%DEV:%" ');
    SQL.Add(' ORDER BY                   ');
    SQL.Add('   AUTOINCREM               ');

    ParamByName('NUMROM').AsString := strNumRom;
    ParamByName('ROMEMP').AsString := strCodEmp;
    Open;

    If Not IsEmpty Then
    Begin
      First;
      While Not Eof Do
      Begin
        cdsOutEnt.Append;
        cdsOutEnt.FieldByName('DESCRI').AsString := FieldByName('OUT_DESCRI').AsString;
        cdsOutEnt.Post;
        Next;
      End;
    End;
  End;

  FreeAndNil(qryGen);
end;

procedure TfrmFatRomaneio.pFilterRecord(DataSet: TDataSet; var Accept: Boolean);
  Var
    blnFiltra : Boolean;
begin
  blnFiltra := True;

  If blnFiltra Then
    If strFiltroNumDoc <> '' Then
      blnFiltra := (Pos(strFiltroNumDoc, DataSet.FieldByName('GER_DOCORI').AsString) > 0);

  If blnFiltra Then
    If strFiltroEspDoc <> '' Then
      blnFiltra := (Pos(strFiltroEspDoc, DataSet.FieldByName('GER_ESPDOC').AsString) > 0);

  If blnFiltra Then
    If strFiltroEmpDoc <> '' Then
      blnFiltra := (Pos(strFiltroEmpDoc, DataSet.FieldByName('GER_CODEMP').AsString) > 0);

  If blnFiltra Then
    If strFiltroNomCli <> '' Then
      blnFiltra := (Pos(strFiltroNomCli, DataSet.FieldByName('GER_NOMCLI').AsString) > 0);

  If blnFiltra Then
    If strFiltroNomCid <> '' Then
      blnFiltra := (Pos(strFiltroNomCid, DataSet.FieldByName('GER_NOMCID').AsString) > 0);

  If blnFiltra Then
    If strFiltroCodCli <> '' Then
      blnFiltra := (Pos(strFiltroCodCli, DataSet.FieldByName('GER_CODCLI').AsString) > 0);

  If blnFiltra Then
    If strFiltroPedVen <> '' Then
      blnFiltra := (Pos(strFiltroPedVen, DataSet.FieldByName('GER_PEDVEN').AsString) > 0);

  If blnFiltra Then
    If strFiltroEndere <> '' Then
      blnFiltra := (Pos(strFiltroEndere, DataSet.FieldByName('GER_ENDCON').AsString) > 0);

  If blnFiltra Then
    If strFiltroBairro <> '' Then
      blnFiltra := (Pos(strFiltroBairro, DataSet.FieldByName('GER_BAIRRO').AsString) > 0);

  If blnFiltra Then
    If fltFiltroPesFin > 0.00 Then
      blnFiltra := ( (DataSet.FieldByName('GER_PESBRU').AsFloat >= fltFiltroPesIni) And
                     (DataSet.FieldByName('GER_PESBRU').AsFloat <= fltFiltroPesFin)
                    );

  If blnFiltra And ((Not fEmptyStr(strFiltroNumDoc + strFiltroEspDoc + strFiltroEmpDoc + strFiltroNomCid +
                                   strFiltroNomCli + strFiltroCodCli + strFiltroPedVen + strFiltroEndere +
                                   strFiltroBairro)) Or (fltFiltroPesFin > 0.00)) Then
    Accept := True
  Else
    Accept := False;
end;

procedure TfrmFatRomaneio.pGravaDadosRestauracao;
var
  LDadosFiltro: TDadosFiltro;
  LDadosDet: TDadosDet;
begin
  if rdbEntrada.Checked then
    LDadosFiltro.Periodo := 1
  else
  if rdbEntrega.Checked then
    LDadosFiltro.Periodo := 2;

  If Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text)) Then
    LDadosFiltro.DataInicial := StrToDate(mskDtaIni.Text);
  If Not fEmptyStr(fTiraCaracEspeciais(mskDtaFin.Text)) Then
    LDadosFiltro.DataFinal := StrToDate(mskDtaFin.Text);

  LDadosFiltro.Dias              := StrToIntDef(edtDiaRom.Text, 0);
  LDadosFiltro.CodCidade         := edtCodCid.Text;
  LDadosFiltro.CodRegiao         := edtCodReg.Text;
  LDadosFiltro.CodCliente        := edtCodCliente.Text;
  LDadosFiltro.CodProduto        := edtCodProduto.Text;
  LDadosFiltro.CodTransportadora := edtCodTra.Text;
  LDadosFiltro.CodRota           := edtCodRot.Text;
  LDadosFiltro.CodTransFat       := edtTraFat.Text;
  LDadosFiltro.CodVendedor       := edtCodVen.Text;
  LDadosFiltro.CodDepartamento   := edtCodDep.Text;
  LDadosFiltro.CodLinhaGrupo     := fTiraCaracEspeciais(edtLinGru.Text);
  LDadosFiltro.CodLote           := edtCodLot.Text;
  LDadosFiltro.Turno             := rdgTurno.ItemIndex;
  LDadosFiltro.CodigoBarras      := edtCodBar.Text;

  LDadosDet.NumeroDocumento  := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
  LDadosDet.EspecieDocumento := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
  LDadosDet.CodEmpresa       := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
  LDadosDet.CodCliente       := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
  LDadosDet.Tip_FC           := cdsTmpDoc.FieldByName('GER_TIP_FC').AsString;
  LDadosDet.Veicul           := cdsTmpDoc.FieldByName('GER_VEICUL').AsString;
  LDadosDet.MarDes           := cdsTmpDoc.FieldByName('GER_MARDES').AsString;
  LDadosDet.Palet            := cdsTmpDoc.FieldByName('GER_PALET_').AsString;
  LDadosDet.ValorSelecionado := cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat;
  LDadosDet.OrdemImpressao   := cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger;
  LDadosDet.VolumeBipado     := cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger;
  LDadosDet.cdsRomDet        := cdsRomDet;

  TRomaneioRecuperacaoGravar.Gravar(FIdRestauracao, edtNumRom.Text, LDadosFiltro, LDadosDet, fEhRomaneioSimplificado);
end;

