procedure TfrmFatRomaneio.btnPreviaRomaneioClick(Sender: TObject);
  Var
    strNumRom,
    strSQL: String;
    qryGenRom: TUniQuery;
    strOpeSol: String;
    blnIteDoc,
    blnImpVal,
    blnMenExp,
    blnEndEnt,
    blnProdutos,
    blnEmbalagens,
    blnDocumentos,
    blnFormas,
    blnItemCli,
    blnInfItem,
    blnTotEspDoc,
    blnMosMar,
    blnCarCar,
    blnImpKm,
    blnVolume,
    blnOrdLoc,
    blnEmbVolume,
    blnLocAssRec,
    blnRotaViagem,
    blnCliVolume,
    blnImprimiuPrevia: Boolean;
    strCliOrdUni,
    strOrdRel: String;
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;

    procedure pAdicionaDocsMensag;
      Var
        strPosQry: TBookMark;
        strDocs: String;
        intCount: Integer;
      Const
        DOCS_POR_LINHA = 6;
    Begin
      strPosQry := cdsTmpDoc.Bookmark;
      Try
        With cdsTmpDoc Do
        Begin
          intCount := 0;

          blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

          If blnWasEnabled Then
            pDisableControls(cdsTmpDoc, prcScroll);

          First;
          While Not Eof Do
          Begin
            If (FieldByName('GER_PRVIMP').AsString = 'S') And
               (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') > 0) Then
            Begin
              strDocs := strDocs + IIF(fEmptyStr(strDocs), '', ', ') + FieldByName('GER_NUMDOC').AsString;
              Inc(intCount);
            End;

            If (intCount = DOCS_POR_LINHA) Or (RecNo = RecordCount) Then
            Begin
              objLiberacao.objMsgLibera.pAddTexto(strDocs);
              strDocs := '';
            End;

            Next;
          End;
        End;
      Finally
        cdsTmpDoc.Bookmark := strPosQry;

        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;
    end;

    procedure pSetaOpcoesImpressao;
    Begin
      blnIteDoc     := False;
      blnImpVal     := False;
      blnMenExp     := False;
      blnEndEnt     := False;
      blnProdutos   := False;
      blnEmbalagens := False;
      blnDocumentos := False;
      blnFormas     := False;
      blnItemCli    := False;
      blnInfItem    := False;
      blnTotEspDoc  := False;
      blnMosMar     := False;
      blnCarCar     := False;
      blnImpKm      := False;
      blnVolume     := False;
      blnOrdLoc     := False;
      blnEmbVolume  := False;
      blnCliVolume  := False;
      blnLocAssRec  := False;
      blnRotaViagem := False;
      strCliOrdUni  := '';
      strOrdRel     := '';

      Try
        pCriarFormularios(TfrmFatRomaneioImpr, frmFatRomaneioImpr);
        frmFatRomaneioImpr.blnPreviaRom := True;
        frmFatRomaneioImpr.Show;
        frmFatRomaneioImpr.btnConfirmar.Click;
        blnProdutos   := frmFatRomaneioImpr.blnProdutos;
        blnEmbalagens := frmFatRomaneioImpr.blnEmbalagens;
        blnDocumentos := frmFatRomaneioImpr.blnDocumentos;
        blnFormas     := frmFatRomaneioImpr.blnFormas;
        blnItemCli    := frmFatRomaneioImpr.blnItemCli;
        blnInfItem    := frmFatRomaneioImpr.blnInfItem;
        blnTotEspDoc  := frmFatRomaneioImpr.blnTotEspDoc;
        blnMosMar     := frmFatRomaneioImpr.blnMosMar;
        blnCarCar     := frmFatRomaneioImpr.blnCarCar;
        blnImpKm      := frmFatRomaneioImpr.blnImpKm;
        blnVolume     := frmFatRomaneioImpr.edtQtdVol.Text = 'V';
        blnOrdLoc     := frmFatRomaneioImpr.edtDesLoc.Text = 'L';
        blnEmbVolume  := frmFatRomaneioImpr.edtEmbQV.Text  = 'V';
        blnCliVolume  := frmFatRomaneioImpr.edtCliQV.Text  = 'V';
        strCliOrdUni  := frmFatRomaneioImpr.edtCliOrd.Text;
        blnIteDoc     := frmFatRomaneioImpr.blnIteDoc;
        blnImpVal     := frmFatRomaneioImpr.blnImpVal;
        blnMenExp     := frmFatRomaneioImpr.blnMenExp;
        blnEndEnt     := frmFatRomaneioImpr.blnEndEnt;
        strOrdRel     := frmFatRomaneioImpr.edtDocEnd.Text;
        blnLocAssRec  := frmFatRomaneioImpr.chkLocAss.Checked;
        blnRotaViagem := frmFatRomaneioImpr.chkRotViagem.Checked;
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[pSetaOpcoesImpressao]');
        End;
      End;

      pFreeAndNil(frmFatRomaneioImpr);
    End;

    Procedure pImprimePrevia;
    Begin
      If fEmptyStr(strNumRom) Then
        strNumRom := strNumRomPrevia;

      pImprimeRomaneio(strNumRom,
                       True,
                       blnProdutos,
                       blnEmbalagens,
                       blnDocumentos,
                       blnFormas,
                       blnItemCli,
                       blnInfItem,
                       blnTotEspDoc,
                       blnMosMar,
                       blnCarCar,
                       blnImpKm,
                       blnVolume,
                       blnOrdLoc,
                       blnEmbVolume,
                       blnCliVolume,
                       strCliOrdUni,
                       blnIteDoc,
                       blnEndEnt,
                       strOrdRel,
                       blnLocAssRec,
                       blnRotaViagem,
                       blnImpVal,
                       blnMenExp);
    End;

begin
  inherited;
  blnImprimiuPrevia := False;

  Try
    If (Not btnPreviaRomaneio.Enabled) Or (Not btnPreviaRomaneio.Visible) Then
      Exit;

    If (fMensagem('', 'Confirma impressão da prévia do Romaneio?', ['&Sim', '&Não']) = 2) Then
      Exit;

    If blnUsaPreRom Then
    Begin
      pSetaOpcoesImpressao;
      pImprimePrevia;
      blnImprimiuPrevia := True;
    End
    Else
    Begin
      If (fPossuiDocComPreviaImpressa) Then
      Begin
        objLiberacao.Clear;
        objLiberacao.objMsgLibera.pAddTexto('Impressão de prévia de romaneio com documentos que já possuem prévia impressa.');

        If Not fEmptyStr(edtNumRom.Text) Then
          objLiberacao.objMsgLibera.pAddTextoCaption('Romaneio', edtNumRom.Text);

        objLiberacao.objMsgLibera.pAddTexto('Documentos com prévia já impressa: ');
        pAdicionaDocsMensag;

        objLiberacao.strDirAce := 'IMPRVIMP';
        objLiberacao.strSenLib := fCfgSis('SENPRV');
        objLiberacao.strMsgSen := 'Liberação de Impressão';
        objLiberacao.blnMosMen := True;
        objLiberacao.strCodOpe := strLoginUsuarioLogado;


        If Not objLiberacao.fLibera Then
          Exit;
      End;

      strOpeSol := fRetOperadorSolicitante;
      If fEmptyStr(strOpeSol) Then
        Exit;

      qryGenRom := fCriaQuery(Self);

      Screen.Cursor := crHourGlass;
      pnlInfo.Caption := 'Aguarde, gerando prévia...';
      Application.ProcessMessages;

      pSetaOpcoesImpressao;

      If (fTabelaExiste('TMP_RELROMANEIO')) Then
        fDropTable('TMP_RELROMANEIO');

      strSQL := '';
      strSQL := strSQL + 'CREATE TEMPORARY TABLE TMP_RELROMANEIO ( ';
      strSQL := strSQL + '  GER_MSGEXP TEXT,                       ';
      strSQL := strSQL + '  GER_MENSAG VARCHAR(190),               ';
      strSQL := strSQL + '  GER_ORDIMP INTEGER,                    ';
      strSQL := strSQL + '  DET_NUMROM VARCHAR(06),                ';
      strSQL := strSQL + '  DET_EMPROM CHAR(03),                   ';
      strSQL := strSQL + '  DET_CODCLI VARCHAR(08),                ';
      strSQL := strSQL + '  DET_NOMCLI VARCHAR(35),                ';
      strSQL := strSQL + '  DET_FANSOB VARCHAR(60),                ';
      strSQL := strSQL + '  GER_CODFIL CHAR(03),                   ';
      strSQL := strSQL + '  OBSFIL     VARCHAR(200),               ';
      strSQL := strSQL + '  GER_ENDCLI VARCHAR(35),                ';
      strSQL := strSQL + '  GER_BAICLI VARCHAR(35),                ';
      strSQL := strSQL + '  GER_CEPCLI VARCHAR(35),                ';
      strSQL := strSQL + '  GER_NOMCID VARCHAR(50),                ';
      strSQL := strSQL + '  GER_REFCLI VARCHAR(60),                ';
      strSQL := strSQL + '  GER_ENDREF VARCHAR(150),               ';
      strSQL := strSQL + '  GER_FONE   VARCHAR(35),                ';
      strSQL := strSQL + '  GER_FONES  VARCHAR(100),               ';
      strSQL := strSQL + '  DET_ITEM   VARCHAR(100),               ';

      If (fCfgSis('ROMIDO') = 2) Or (blnIteDoc And blnImpVal) Then
      Begin
        strSQL := strSQL + '  DET_UNITAR NUMERIC(12,4),            ';
        strSQL := strSQL + '  DET_TOTITE NUMERIC(12,4),            ';
        strSQL := strSQL + '  DET_DESESP NUMERIC(12,4),            ';
      End;

      If (blnIteDoc And blnImpVal) Then
      Begin
        strSQL := strSQL + '  GER_CODFPG CHAR(3),        ';
        strSQL := strSQL + '  FPG_DESCRI VARCHAR(30),    ';
        strSQL := strSQL + '  GER_CODCND CHAR(3),        ';
        strSQL := strSQL + '  CND_DESCRI VARCHAR(70),    ';
        strSQL := strSQL + '  GER_TOTMER NUMERIC(12,4),  ';
      End;

      strSQL := strSQL + '  DET_CODITE VARCHAR(05),                ';
      strSQL := strSQL + '  DET_AUTINC VARCHAR(20),                ';
      strSQL := strSQL + '  DET_DESCRI VARCHAR(87),                ';//Precisa ter o mesmo numero de caracteres do MOVDET, pois a descricao é usada como agrupamento
      strSQL := strSQL + '  DET_UNIDAD VARCHAR(02),                ';
      strSQL := strSQL + '  ITE_SALDOS NUMERIC(12,4),              ';
      strSQL := strSQL + '  DET_CLAFIS VARCHAR(04),                ';
      strSQL := strSQL + '  DET_TOTPES NUMERIC(12,4),              ';
      strSQL := strSQL + '  MAR_DESMAR VARCHAR(30),                ';
      strSQL := strSQL + '  DET_VOLUME NUMERIC(12,4),              ';
      strSQL := strSQL + '  DET_QTDITE NUMERIC(12,4),              ';
      strSQL := strSQL + '  DET_LOCFIS VARCHAR(20),                ';
      strSQL := strSQL + '  GER_NUMDOC VARCHAR(12),                ';
      strSQL := strSQL + '  GER_ESPDOC CHAR(2),                    ';
      strSQL := strSQL + '  GER_CODEMP CHAR(3),                    ';
      strSQL := strSQL + '  GER_CODVEN CHAR(3),                    ';
      strSQL := strSQL + '  GER_MEN001 VARCHAR(80),                ';
      strSQL := strSQL + '  GER_MEN002 VARCHAR(80),                ';
      strSQL := strSQL + '  GER_DTAENT DATE,                       ';
      strSQL := strSQL + '  GER_NUMFAT VARCHAR(14),                ';
      strSQL := strSQL + '  GER_TIPFAT CHAR(2),                    ';
      strSQL := strSQL + '  GER_EMPFAT CHAR(3),                    ';
      strSQL := strSQL + '  GER_CODCLI VARCHAR(08),                ';
      strSQL := strSQL + '  GER_SERIE_ CHAR(3),                    ';
      strSQL := strSQL + '  DOCQUEBRA  VARCHAR(22),                ';
      strSQL := strSQL + '  GER_NOMVEN VARCHAR(34),                ';

      If fImpressaoEspecificaDepCravinhos(blnIteDoc) Then
      Begin
        strSQL := strSQL + ' GER_CPFCGC VARCHAR(18), ';
        strSQL := strSQL + ' GER_RG_IES VARCHAR(18), ';
        strSQL := strSQL + ' DET_ENTSAI CHAR(1),     ';
        strSQL := strSQL + ' GER_MSGPED TEXT,        ';
      End;

      strSQL := strSQL + '  DET_NUMLOT VARCHAR(20),                ';
      strSQL := strSQL + '  ITE_MLTVEN decimal(12,4),              ';
      strSQL := strSQL + '  GER_PALET_ VARCHAR(15),                ';
      strSQL := strSQL + '  DET_TOTFRE NUMERIC(12,4),              ';
      strSQL := strSQL + '  GER_ENTSAI CHAR(1),                    ';
      strSQL := strSQL + '  GER_LISDIV VARCHAR(60)                 ';
      strSQL := strSQL + '  )                                      ';

      With qryGenRom Do
      Begin
        {**********************************************}
        {* CRIA ESTRUTURA DA TEMPORARIA REL. ROMANEIO *}
        {*******************************************JB*}
        If fTabelaExiste('TMP_RELROMANEIO') Then
          fDropTable('TMP_RELROMANEIO');
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ExecSQL;

        {***************************************************}
        {* CRIA ESTRUTURA DA TEMPORARIA P\ RESUMO DE ITENS *}
        {************************************************JB*}
        If fTabelaExiste('TMP_RELROMITECLI') Then
          fDropTable('TMP_RELROMITECLI');
        Close;
        SQL.Clear;
        strSQL := AnsiReplaceStr(strSQL, 'TMP_RELROMANEIO', 'TMP_RELROMITECLI');
        SQL.Add(strSQL);
        ExecSQL;

        {*****************************************************}
        {* CRIA ESTRUTURA DA TEMPORARIA P\ ITENS POR CLIENTE *}
        {**************************************************JB*}
        If fTabelaExiste('TMP_RELROMITEDOC') Then
          fDropTable('TMP_RELROMITEDOC');
        Close;
        SQL.Clear;
        strSQL := AnsiReplaceStr(strSQL, 'TMP_RELROMITECLI', 'TMP_RELROMITEDOC');
        SQL.Add(strSQL);
        ExecSQL;

      End;

      If (fConfirmaRomaneio(strNumRom, strOpeSol, False, Nil)) Then
      Begin
        pImprimePrevia;
        blnImprimiuPrevia := True;
      End;

      If Assigned(cdsOutEnt) And (cdsOutEnt.Active) Then
        cdsOutEnt.EmptyDataSet;
    End;

  Finally
    Screen.Cursor := crDefault;
    fRollBack;

    If blnImprimiuPrevia Then
      pMarcaPreviaImpressa;

    If Not blnUsaPreRom Then
      fDropTable('TMP_RELROMANEIO');

    pnlInfo.Caption := '';
    Application.ProcessMessages;
    FreeAndNil(qryGenRom);
    pSetFocus(dbgDocumentos);
  End;
end;

