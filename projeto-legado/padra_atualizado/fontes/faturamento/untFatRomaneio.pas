function TfrmFatRomaneio.fRemoverObservacoes(strNumDoc, strEspDoc, strCodEmp: String): Integer;
var
  qryLogRom: TUniQuery;
begin
  Result := 0;
  
  If (cdsTmpDoc.Active) And (Not cdsTmpDoc.IsEmpty) Then
  Begin
    qryLogRom := fCriaQuery;
    Try
      With qryLogRom, SQL Do
      Begin
        Close;
        Text := ' DELETE FROM LOGROM           '+
                '   WHERE GER_NUMDOC = :NUMDOC '+
                '     AND GER_ESPDOC = :ESPDOC '+
                '     AND GER_EMPDOC = :EMPDOC '+
                '     AND IFNULL(GER_OBSMAN, "S") = "S" ';

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('EMPDOC').AsString := strCodEmp;

        ExecSQL;
        Inc(Result, RowsAffected);
      End;
    Finally
      FreeAndNil(qryLogRom);
    End;
  End;
end;

