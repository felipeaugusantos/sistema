begin

  strSQLDV := '';
  strSQLDV := strSQLDV + ' UNION ALL ';

  strSQLDV := strSQLDV + 'SELECT SQL_NO_CACHE ';
  strSQLDV := strSQLDV + fRetSQLDocRetornadoRomaneio('FGO') + ' AS GER_RETROM, ';
  strSQLDV := strSQLDV + '  FGO_CONPAG AS GER_CONPAG, ';
