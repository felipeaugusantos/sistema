  strSQL := strSQL + '  R.GER_TIP_FC, ';
  strSQL := strSQL + '  0 AS GER_ORDIMP, ';
  strSQL := strSQL + '  " " AS GER_ALTERA,        ';
  strSQL := strSQL + '  0 INCREMENTO, ';
  strSQL := strSQL + '  IF((AUXMOV.AUX_ENTGER  IS NOT NULL OR ';
  strSQL := strSQL + '      AUXNOT.AUX_ENTGER  IS NOT NULL OR ';
  strSQL := strSQL + '      AUXGOR.AUX_ENTGER  IS NOT NULL), ';
  strSQL := strSQL + '     COALESCE( ';
  strSQL := strSQL + '      TRAMOV.TRA_CODTRA, ';
  strSQL := strSQL + '      TRANOT.TRA_CODTRA, ';
  strSQL := strSQL + '      TRAGOR.TRA_CODTRA), ';
  strSQL := strSQL + '      TRAROM.TRA_CODTRA) AS GER_CODTRA, ';
  strSQL := strSQL + '  IF((AUXMOV.AUX_ENTGER  IS NOT NULL OR ';
  strSQL := strSQL + '      AUXNOT.AUX_ENTGER  IS NOT NULL OR ';
  strSQL := strSQL + '      AUXGOR.AUX_ENTGER  IS NOT NULL OR ';
  strSQL := strSQL + '      PD.FGO_CODTRA      IS NOT NULL ), ';
  strSQL := strSQL + '     COALESCE( ';
  strSQL := strSQL + '      TRAMOV.TRA_NOMTRA, ';
  strSQL := strSQL + '      TRANOT.TRA_NOMTRA, ';
  strSQL := strSQL + '      CADTRA.TRA_NOMTRA,  ';
  strSQL := strSQL + '      TRAGOR.TRA_NOMTRA), ';
  strSQL := strSQL + '      TRAROM.TRA_NOMTRA) AS GER_TRANSP, ';
  strSQL := strSQL + '      IFNULL(TRAROM.TRA_NOMTRA, TRADOC.TRA_NOMTRA) AS GER_TRAFAT, ';
  strSQL := strSQL + '      TRADOC.TRA_CODTRA  AS GER_TRADOC, ';
  strSQL := strSQL + '  IFNULL(G.GER_PESBRU, IFNULL(N.GER_PESBRU, PD.FGO_PESBRU)) AS GER_PESBRU, ';
  strSQL := strSQL + '  IF(R.GER_ESPDOC = "OX", "OUTDIGX", IF(PD.FGO_NUMDOC IS NULL, IF(G.GER_NUMDOC IS NULL, "NOTGER", "MOVGER"),"FATGOR")) AS GER_NOMTBL, ';
  strSQL := strSQL + '  R.GER_AUTINC AS GER_AUTINC, ';
  strSQL := strSQL + '  IF((LOCATE(IFNULL(G.GER_CLAFIS, N.GER_CLAFIS), "1411_1202_1405_2411_2202_") OR ((IFNULL(G.GER_ESPDOC, N.GER_ESPDOC) IN ("DV","TR")) AND (LEFT(IFNULL(G.GER_CLAFIS, N.GER_CLAFIS), 1) <= 2))), "D", IFNULL(G.GER_ORIDOC, N.GER_ORIDOC)) AS GER_ORIDOC, ';
  strSQL := strSQL + '  CAST(0.0000 AS DECIMAL(15, 4)) GER_TOTDET, ';
  strSQL := strSQL + '  R.GER_NUMROM AS GER_NROROM, ';
  // ** GER_NUMFAT **
  strSQL := strSQL + '  IF(G.GER_NUMDOC IS NULL, ';
  strSQL := strSQL + '  CONCAT(N.GER_NUMFAT, N.GER_TIPFAT, N.GER_EMPFAT, N.GER_CLIFAT), ';
  strSQL := strSQL + '  CONCAT(G.GER_NUMFAT, G.GER_TIPFAT, G.GER_EMPFAT, G.GER_CLIFAT)) AS GER_NUMFAT, ';

  // ** GER_DOCUME **
  strSQL := strSQL + '  IF(G.GER_NUMDOC IS NULL,';
