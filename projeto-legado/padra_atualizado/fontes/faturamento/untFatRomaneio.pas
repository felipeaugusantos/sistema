    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQLDV := strSQLDV + ', CADCLI.CLI_CODRED ';
  strSQLDV := strSQLDV + ', CADCLI.CLI_CODCAC ';
  strSQLDV := strSQLDV + ', CADCLI.CLI_FANSOB ';
  strSQLDV := strSQLDV + ', CADCLI.CLI_ORIENT ';
  strSQLDV := strSQLDV + ', CAC.CAC_CORILP ';
  strSQLDV := strSQLDV + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSQLDV := strSQLDV + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQLDV := strSQLDV + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQLDV := strSQLDV + ', FDO_CLAFIS AS DET_CLAFIS ';
  strSQLDV := strSQLDV + ',  ' + fSQLBarDoc('FGO') + ' AS BARDOC ';

  strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQLDV := strSQLDV + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQLDV := strSQLDV + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQLDV := strSQLDV + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQLDV := strSQLDV + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQLDV := strSQLDV + 'FROM ';
  strSQLDV := strSQLDV + '  FATDOR ';
  strSQLDV := strSQLDV + '  INNER JOIN FATGOR   ON FATDOR.FDO_SEQGER = FATGOR.AUTOINCREM ';
  strSQLDV := strSQLDV + '  LEFT JOIN EXTGOR    ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
  strSQLDV := strSQLDV + '  INNER JOIN CADCLI   ON FGO_CODCLI        = CLI_CODCLI ';
  strSQLDV := strSQLDV + '  INNER JOIN CADCID   ON CADCID.CID_CODCID = IF(FGO_CIDCON IS NULL,CLI_CODCID,FGO_CIDCON) ';
  strSQLDV := strSQLDV + '  INNER JOIN CADITE I ON I.ITE_CODITE      = FDO_CODITE ';
  strSQLDV := strSQLDV + '  INNER JOIN EXTDOR   ON EXTDOR.FDO_SEQFDO = FATDOR.AUTOINCREM ';
  strSQLDV := strSQLDV + '   LEFT JOIN CADTRA   ON FGO_CODTRA        = CADTRA.TRA_CODTRA ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA FATGOR *}
  {************************************FC}
  strSQLDV := strSQLDV + 'LEFT JOIN AUXGOR        ON (AUXGOR.AUX_SEQGER = FATGOR.AUTOINCREM) ';
  strSQLDV := strSQLDV + 'LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXGOR.AUX_ENTGER) ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = ECMOV.ETC_CIDENT)  ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

  // ** CADREG REGIAO **
  strSQLDV := strSQLDV + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECMOV.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECMOV.ETC_CODREG) ) ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';
  strSQLDV := strSQLDV + ' LEFT JOIN CADFPG ON FGO_CODFPG = FPG_CODIGO ';

  // ** DEPARTAMENTO VENDEDOR **
  strSQLDV := strSQLDV + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = FATGOR.FGO_CODVEN ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSQLDV := strSQLDV + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = FATGOR.FGO_CODCND   ';

  //Entrega (Rota) selecionada
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSQLDV := strSQLDV + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSQLDV := strSQLDV + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;

  strSQLDV := strSQLDV + 'WHERE ';
  strSQLDV := strSQLDV + '  FGO_ESPDOC = "PR" AND ';
  strSQLDV := strSQLDV + '  FGO_JAFATU = 0    AND ';
  strSQLDV := strSQLDV + '  FGO_ENTFUT = "N"  AND ';
  strSQLDV := strSQLDV + '  FGO_ENTFAT = "S"  AND ';

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSQLDV := strSQLDV + '  NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSQLDV := strSQLDV + '               FROM ROMGERX GERX ';
    strSQLDV := strSQLDV + '              INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSQLDV := strSQLDV + '              WHERE GERX.GER_CODEMP = FGO_CODEMP ';
    strSQLDV := strSQLDV + '                AND GERX.GER_NUMDOC = FGO_NUMDOC ';
    strSQLDV := strSQLDV + '                AND GERX.GER_ESPDOC = FGO_ESPDOC ';
    strSQLDV := strSQLDV + '  ) AND  ';
  End;

  If fCfgSis('CLBUEF',varboolean) Then
    strSQLDV := strSQLDV + '  FDO_CLIBUS = "N" AND ';

  If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
    strSQLDV := strSQLDV + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT', True) + ' AND ';

  strSQLDV := strSQLDV + '  IF( FGO_CIDCON IS NULL, CLI_CODCID, FGO_CIDCON) = CADCID.CID_CODCID AND ';

  If (Not fEmptyStr(edtNumRom.Text)) Then
    strSQLDV := strSQLDV + '  ((FGO_NUMROM IS NULL) OR (FGO_NUMROM = '+QuotedStr(edtNumRom.Text)+')) '
  Else
    strSQLDV := strSQLDV + '  FGO_NUMROM IS NULL ';

  If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
    strSQLDV := strSQLDV + ' AND ' + IIF(rdbEntrega.Checked, 'FGO_DTENTR', 'FGO_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
  Else
    strSQLDV := strSQLDV + ' AND FGO_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

  If (chkSomenteCliFil.Checked) Then
    strSQLDV := strSQLDV + ' AND FGO_CODCLI IN ('+fRetClientesFilial+') ';

  strSQLDV := strSQLDV + fStrLocate(edtCodCid,arrCidade,'IF(FGO_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), FGO_CIDCON)','CODCID');

  strSQLDV := strSQLDV + fStrLocate(edtCodTra,arrTransp,'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", FGO_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
  strSQLDV := strSQLDV + fStrLocate(edtTraFat, arrTraFat, 'FGO_CODTRA', 'TRAFAT');

  strSQLDV := strSQLDV + fStrLocate(edtCodReg,arrRegiao,'ECMOV.ETC_CODREG', 'CODREG');
  strSQLDV := strSQLDV + fStrLocate(edtCodVen,arrVended,'FGO_CODVEN', 'CODVEN');
  strSQLDV := strSQLDV + fStrLocate(edtCodDep,arrDepVen,'DEP_CODIGO', 'CODDEP');
  strSQLDV := strSQLDV + fStrLocate(edtCodCliente,arrClientes,'FGO_CODCLI', 'CODCLI');
  strSQLDV := strSQLDV + fStrLocate(edtCodProduto,arrProdutos,'FDO_CODITE', 'CODITE');
  strSQLDV := strSQLDV + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

  strSQLDV := strSQLDV + ' AND (' + fRetSQLFiltroEmpresas('FGO_CODEMP') + ') ';

  {*****************************************}
  {* FILTRO DE LINHA E GRUPO               *}
  {**************************************MV*}
  strSQLDV := strSQLDV + fSQLFiltroLinGru('FDO');

  if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
  Begin
    strSQLDV := strSQLDV + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
    strSQLDV := strSQLDV + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
    strSQLDV := strSQLDV + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
    strSQLDV := strSQLDV + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
    strSQLDV := strSQLDV + '                AND RLD_NUMDOC = FGO_NUMDOC                        ';
    strSQLDV := strSQLDV + '                AND RLD_ESPDOC = FGO_ESPDOC                        ';
    strSQLDV := strSQLDV + '                AND RLD_CODEMP = FGO_CODEMP )                      ';
  End;

  strSQLDV := strSQLDV + fDocumentoRemovidoNaoConferidoVolume('FATGOR', 'FGO');

  strSQLDV := strSQLDV + ' AND FDO_CODITE <> :ITESER AND FDO_CODITE <> :SERTER ';

  strSQLDV := strSQLDV + ' GROUP BY FATDOR.FDO_SEQGER ';

  strSQLDV := strSQLDV + fRetornaWhereTurno();

  Result := strSQLDV;

end;

function TfrmFatRomaneio.fRetSqlVlrCon_OPCROM5: String;
begin
  Result := '';
  Result := Result + ' ((SELECT SUM((D.FDO_VLRCON / D.FDO_QTDITE) * (IF(D.FDO_JAFATU = 1, D.FDO_QTDBAI, (D.FDO_QTDITE - D.FDO_QTDBAI)))) ';
  Result := Result + '   FROM FATDOR D ';
  Result := Result + '   WHERE D.FDO_SEQGER = FATGOR.AUTOINCREM ';
  Result := Result + '     AND D.FDO_NUMDOC = FATGOR.FGO_NUMDOC ';
  Result := Result + '     AND D.FDO_ESPDOC = FATGOR.FGO_ESPDOC ';
  Result := Result + '     AND D.FDO_CODEMP = FATGOR.FGO_CODEMP ';
  Result := Result + '     AND ((IFNULL(D.FDO_NUMFAT,"") <> "" ';
  Result := Result + '     AND   IFNULL(D.FDO_TIPFAT,"") <> "" ';
  Result := Result + '     AND   IFNULL(D.FDO_EMPFAT,"") <> "" ';
  Result := Result + '     AND   D.FDO_JAFATU = 1) ';
  Result := Result + '      OR  (D.FDO_JAFATU = 0)) ';
  Result := Result + ' ) - IFNULL(FGO_VALROM, 0)) ';
end;

