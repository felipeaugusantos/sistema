procedure TfrmFatRomaneio.pAtualizarLogRom(Const stlAutoIncrem : TStringList; strNumRom: String);
Var
  QryAux        : TUniQuery;
  strAutoincrem : String;
  intCont       : Integer;
begin
  QryAux := fCriaQuery;

    for intCont := 0 to stlAutoIncrem.Count -1 do
    begin
      strAutoincrem := strAutoincrem + '"' + stlAutoIncrem[intCont]  + '",';
    end;

    strAutoincrem := Copy(strAutoincrem, 1, Length(strAutoincrem)-1);

  Try
    QryAux.SQL.Text := 'UPDATE LOGROM '+
                       '   SET GER_NUMROM  = :NUMROM '+
                       ' WHERE AUTOINCREM  IN ('+strAutoincrem+') '+
                       '    AND GER_CODEMP = :CODEMP';

    QryAux.ParambyName('NUMROM').AsString := strNumRom;
    QryAux.ParambyName('CODEMP').AsString := VS_strCodEmp;
    QryAux.ExecSQL;

  Finally
    FreeAndNil(QryAux);
  End;
end;

procedure TfrmFatRomaneio.btnManEndClick(Sender: TObject);
var
  frmFatRomManutencaoEndereco: TfrmFatRomManutencaoEndereco;
  strFilter: String;
  blnFiltered: Boolean;
begin
  inherited;

  strFilter := cdsTmpDoc.Filter;
  blnFiltered := cdsTmpDoc.Filtered;

  cdsTmpDoc.DisableControls;
  cdsTmpDoc.OnFilterRecord := nil;

  cdsTmpDoc.Filtered := False;
  cdsTmpDoc.Filter := 'GER_MARDES = '+QuotedStr('M')+' AND GER_ORDIMP > 0 ';
  cdsTmpDoc.Filtered := True;

  if not cdsTmpDoc.IsEmpty then
  begin
    pCriarFormularios(TfrmFatRomManutencaoEndereco, frmFatRomManutencaoEndereco);
    try
      frmFatRomManutencaoEndereco.pSetDados(cdsTmpDoc);
      if frmFatRomManutencaoEndereco.ShowModal = mrOk then
      begin
        cdsTmpDoc.Filtered := False;

        frmFatRomManutencaoEndereco.cdsDocs.First;
        while not frmFatRomManutencaoEndereco.cdsDocs.Eof do
        begin

          if cdsTmpDoc.Locate('GER_CODCLI;GER_NUMDOC;GER_ESPDOC;GER_CODEMP;GER_ENTSAI',
                              VarArrayOf([
                                frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_CODCLI').AsString,
                                frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_NUMDOC').AsString,
                                frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_ESPDOC').AsString,
                                frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_CODEMP').AsString,
                                frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_ENTSAI').AsString]),
                                []) then
          begin

            cdsTmpDoc.Edit;
            cdsTmpDoc.FieldByName('GER_CODFIL').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_CODFIL').AsString;
            cdsTmpDoc.FieldByName('GER_TIPENT').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_TIPENT').AsString;

            cdsTmpDoc.FieldByName('GER_ENDCON').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_ENDCON').AsString;
            cdsTmpDoc.FieldByName('GER_BAIRRO').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_BAIRRO').AsString;
            cdsTmpDoc.FieldByName('GER_CEPCON').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_CEPCON').AsString;
            cdsTmpDoc.FieldByName('CID_CODCID').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('CID_CODCID').AsString;
            cdsTmpDoc.FieldByName('GER_NOMCID').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_NOMCID').AsString;
            cdsTmpDoc.FieldByName('GER_ESTADO').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_ESTADO').AsString;
            cdsTmpDoc.FieldByName('GER_REFCON').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_REFCON').AsString;

            cdsTmpDoc.FieldByName('GER_ENDCON_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_ENDCON_BAK').AsString;
            cdsTmpDoc.FieldByName('GER_BAIRRO_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_BAIRRO_BAK').AsString;
            cdsTmpDoc.FieldByName('GER_CEPCON_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_CEPCON_BAK').AsString;
            cdsTmpDoc.FieldByName('CID_CODCID_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('CID_CODCID_BAK').AsString;
            cdsTmpDoc.FieldByName('GER_NOMCID_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_NOMCID_BAK').AsString;
            cdsTmpDoc.FieldByName('GER_ESTADO_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_ESTADO_BAK').AsString;
            cdsTmpDoc.FieldByName('GER_REFCON_BAK').AsString := frmFatRomManutencaoEndereco.cdsDocs.FieldByName('GER_REFCON_BAK').AsString;
            cdsTmpDoc.FieldByName('GER_ALTEND').AsString := 'S';

            cdsTmpDoc.Post;

            if cdsTmpMantemSelecionado.Locate('GER_CODCLI;GER_NUMDOC;GER_ESPDOC;GER_CODEMP;GER_ENTSAI',
                                              VarArrayOf([
                                              cdsTmpDoc.FieldByName('GER_CODCLI').AsString,
                                              cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                                              cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                              cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                                              cdsTmpDoc.FieldByName('GER_ENTSAI').AsString]),
                                              []) then
            begin
              cdsTmpMantemSelecionado.Edit;
              cdsTmpMantemSelecionado.FieldByName('GER_ENDCON').AsString := cdsTmpDoc.FieldByName('GER_ENDCON').AsString;
              cdsTmpMantemSelecionado.FieldByName('GER_BAIRRO').AsString := cdsTmpDoc.FieldByName('GER_BAIRRO').AsString;
              cdsTmpMantemSelecionado.FieldByName('GER_CEPCON').AsString := cdsTmpDoc.FieldByName('GER_CEPCON').AsString;
              cdsTmpMantemSelecionado.FieldByName('CID_CODCID').AsString := cdsTmpDoc.FieldByName('CID_CODCID').AsString;
              cdsTmpMantemSelecionado.FieldByName('GER_NOMCID').AsString := cdsTmpDoc.FieldByName('GER_NOMCID').AsString;
              cdsTmpMantemSelecionado.FieldByName('GER_ESTADO').AsString := cdsTmpDoc.FieldByName('GER_ESTADO').AsString;
              cdsTmpMantemSelecionado.FieldByName('GER_REFCON').AsString := cdsTmpDoc.FieldByName('GER_REFCON').AsString;
              cdsTmpMantemSelecionado.FieldByName('GER_ALTEND').AsString := 'S';
              cdsTmpMantemSelecionado.Post;
            end;
          end;

          frmFatRomManutencaoEndereco.cdsDocs.Next;
        end;
      end;

    finally
      pFreeAndNil(frmFatRomManutencaoEndereco);
    end;
  end
  else
    fMensagem('ATENÇÃO!', 'Nenhum documento selecionado!', ['&Ok']);

  cdsTmpDoc.Filtered := False;
  cdsTmpDoc.Filter := strFilter;
  cdsTmpDoc.Filtered := blnFiltered;
  cdsTmpDoc.OnFilterRecord := pFilterRecord;
  cdsTmpDoc.EnableControls;
end;

