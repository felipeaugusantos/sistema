function TfrmFatRomaneio.fExisteCarregaLogRom(strNumDoc, strEspDoc,
  strEmpDoc: String): Boolean;
  Var
    strSQL:string;
begin
  With qryLogRom Do
  Begin

    If SQL.Text = '' Then
    Begin
      strSQL := '';
      strSQL := strSQL + ' SELECT ';
      strSQL := strSQL + '   LOGROM.*, ';
      strSQL := strSQL + '   CONCAT(OPE_CODOPE,"-",OPE_NOMOPE) AS GER_OPENOM ';
      strSQL := strSQL + ' FROM ';
      strSQL := strSQL + '   LOGROM ';
      strSQL := strSQL + '   INNER JOIN CADOPE ON (OPE_CODOPE=GER_OPEALT) ';
      strSQL := strSQL + ' WHERE GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '   AND GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '   AND GER_EMPDOC = :EMPDOC ';
      strSQL := strSQL + ' ORDER BY GER_DTAALT DESC, GER_HORALT DESC ';

      SQL.Text := strSQL;
    End;

    ParamByName('NUMDOC').AsString:=strNumDoc;
    ParamByName('ESPDOC').AsString:=strEspDoc;
    ParamByName('EMPDOC').AsString:=strEmpDoc;

    cdsLogRom.Close;
    cdsLogRom.Open;

    Result := Not cdsLogRom.IsEmpty;
  End;
end;

procedure TfrmFatRomaneio.pAfterScrollCdsTmpDoc(DataSet: TDataSet);
  Var
    strLinAux : String;
    strLinha  : String;
    stlMsgExp : TStringList;
    intCount  : Integer;
    blnTemObsRom,
    blnTemObsExp : Boolean;
    strCodDiv    : String;
begin
  if (not FHabilitaAfterScroll) then
    Exit;

  pLimpaCamposObservacao;

  mnuExcluirOutEnt.Visible := False;

  If (DataSet.Active) And (Not DataSet.IsEmpty) Then
  Begin
    mnuExcluirOutEnt.Visible := DataSet.FieldByName('GER_ESPDOC').AsString = 'OX';

    strLinAux := DataSet.FieldByName('GER_DOCORI').AsString+
                 DataSet.FieldByName('GER_ESPDOC').AsString+
                 DataSet.FieldByName('GER_CODEMP').AsString;

    If (stlDocSemLogRom.IndexOf(strLinAux) = -1) Then
    Begin
      If fExisteCarregaLogRom(DataSet.FieldByName('GER_DOCORI').AsString,
                              DataSet.FieldByName('GER_ESPDOC').AsString,
                              DataSet.FieldByName('GER_CODEMP').AsString) Then
      Begin
        With cdsLogRom Do
        Begin
          First;
          While Not Eof Do
          Begin
            strLinha := 'Romaneio: '     + FieldByName('GER_NUMROM').AsString + ' ' +
                        'Vendedor: '     + FieldByName('GER_OPENOM').AsString + ' ' +
                        'Data/Hora: '    + FieldByName('GER_DTAALT').AsString + ' ' + FieldByName('GER_HORALT').AsString;

            strCodDiv := fRetornaCodProfissional(FieldByName('GER_NUMROM').AsString,
                                                 FieldByName('GER_CODEMP').AsString,
                                                 FieldByName('GER_NUMDOC').AsString,
                                                 FieldByName('GER_ESPDOC').AsString,
                                                 FieldByName('GER_EMPDOC').AsString);

            If Not fEmptyStr(strCodDiv) Then
              strLinha := strLinha + ' ' + 'Profissional: ' + strCodDiv + '-' + fRetNomProfissional(strCodDiv);

            dbmObs.Lines.Add(strLinha);
            dbmObs.Lines.Add(FieldByName('GER_OBSERV').AsString);
            dbmObs.Lines.Add('-------------------------------------------------------------------------');

            Next;
          End;
        End;
      End
      Else
      Begin
        stlDocSemLogRom.Add(strLinAux);
      End;
    End;

    If (Not fEmptyStr(DataSet.FieldByName('GER_NFEADC').AsString)) Then
    Begin
      memDadosAdicionais.Text := DataSet.FieldByName('GER_NFEADC').AsString.Replace('#', #13#10);
    End;

    If (Not fEmptyStr(DataSet.FieldByName('CLI_ORIENT').AsString)) Then
    Begin
      memOriEnt.Text := DataSet.FieldByName('CLI_ORIENT').AsString.Replace('<<csq>>', #13#10);
    End;

    pPreencheMemoFeriados(DataSet.FieldByName('CID_CODCID').AsString);
    
    With DataSet Do
    Begin
      //CARREGA MENSAGENS EXPEDIÇÃO DO PEDIDO
      If (Not fEmptyStr(FieldByName('GER_MENEXP').AsString)) Or
         (Not fEmptyStr(FieldByName('GER_MENEX2').AsString)) Or
         (Not fEmptyStr(FieldByName('GER_MENEX3').AsString)) Or
         (Not fEmptyStr(FieldByName('GER_MENEX4').AsString)) Then
      Begin
        mmoObsExp.Lines.Add(Trim(FieldByName('GER_MENEXP').AsString));
        mmoObsExp.Lines.Add(Trim(FieldByName('GER_MENEX2').AsString));
        mmoObsExp.Lines.Add(Trim(FieldByName('GER_MENEX3').AsString));
        mmoObsExp.Lines.Add(Trim(FieldByName('GER_MENEX4').AsString));
      End
      Else
      Begin
        strLinAux := FieldByName('GER_DOCORI').AsString+
                     FieldByName('GER_ESPDOC').AsString+
                     FieldByName('GER_CODEMP').AsString+
                     FieldByName('GER_NOMTBL').AsString;

        If (stlDocSemMsgExp.IndexOf(strLinAux) = -1) Then
        Begin
           stlMsgExp := TStringList.Create;
           Try
             fRetMensagemExpedicao(FieldByName('GER_DOCORI').AsString,
                                   FieldByName('GER_ESPDOC').AsString,
                                   FieldByName('GER_CODEMP').AsString,
                                   FieldByName('GER_NOMTBL').AsString,
                                   stlMsgExp,
                                   False);

             If fEmptyStr(stlMsgExp.Text) Then
             Begin  
               stlDocSemMsgExp.Add(strLinAux);
             End
             Else
             Begin
               For intCount := 0 To  stlMsgExp.Count -1 Do
                 mmoObsExp.Lines.Add(Trim(stlMsgExp[intCount]));
             End;
           Finally
             FreeAndNil(stlMsgExp);
           End;
        End;
      End;
    End;
  End;

  blnTemObsRom := blnObservacoes          And (Not fEmptyStr(dbmObs.Text));
  blnTemObsExp := blnObservacoesExpedicao And (Not fEmptyStr(mmoObsExp.Text));

  If (blnTemObsRom) Or (blnTemObsExp) Then
  Begin
    pnlRodape.Visible := True;

    If (blnTemObsExp) Then
    Begin
      SendMessage(mmoObsExp.Handle, WM_VSCROLL, SB_TOP, 0);
      SendMessage(mmoObsExp.Handle, WM_HSCROLL, SB_LEFT, 0);
      mmoObsExp.SelStart := 0;
      pnlObsExp.Visible := True;
    End;

    If (blnTemObsRom) Then
    Begin
      SendMessage(dbmObs.Handle, WM_VSCROLL, SB_TOP, 0);
      SendMessage(dbmObs.Handle, WM_HSCROLL, SB_LEFT, 0);
      dbmObs.SelStart := 0;
      pnlObserv.Visible := True;
    End;
  End;

  If blnDadosAdicionaisNF And (Not fEmptyStr(memDadosAdicionais.Text)) Then
  Begin
    SendMessage(memDadosAdicionais.Handle, WM_VSCROLL, SB_TOP, 0);
    SendMessage(memDadosAdicionais.Handle, WM_HSCROLL, SB_LEFT, 0);
    memDadosAdicionais.SelStart := 0;
    pnlDadosAdicionais.Visible := True;
  End;

  If (blnOrientacoes) And (Not fEmptyStr(memOriEnt.Text)) Then
  Begin
    SendMessage(memOriEnt.Handle, WM_VSCROLL, SB_TOP, 0);
    SendMessage(memOriEnt.Handle, WM_HSCROLL, SB_LEFT, 0);
    memOriEnt.SelStart := 0;
    pnlOrientacoes.Visible := True;
  End;

  If (blnFeriados) And (Not fEmptyStr(memFeriados.Text)) Then
  Begin
    SendMessage(memFeriados.Handle, WM_VSCROLL, SB_TOP, 0);
    SendMessage(memFeriados.Handle, WM_HSCROLL, SB_LEFT, 0);
    memFeriados.SelStart := 0;
    pnlFeriados.Visible := True;
  End;

  intCount := 0;

  If pnlObsExp.Visible Then
    Inc(intCount);

  If pnlObserv.Visible Then
    Inc(intCount);

  If pnlDadosAdicionais.Visible Then
    Inc(intCount);

  If (pnlFeriados.Visible) Then
    Inc(intCount);

  If (pnlOrientacoes.Visible) Then
    Inc(intCount);

  pnlInformacoes.Visible := intCount > 0;

  If pnlInformacoes.Visible Then
  Begin
    pnlObsExp.Width := pnlInformacoes.Width Div intCount;
    pnlObserv.Width := pnlInformacoes.Width Div intCount;
    pnlDadosAdicionais.Width := pnlInformacoes.Width Div intCount;
    pnlOrientacoes.Width := pnlInformacoes.Width Div intCount;
    pnlFeriados.Width := pnlInformacoes.Width Div intCount;
    splInformacoes.Visible  := True;
  End;

  dbgDocumentosTIPPED.Visible := (fCfgSis('OPCROM', varInteger) = 1) And
                                 (fCfgSis('TPDCEX', varInteger) = 1) And
                                 ( (VS_strTipExp = '3') Or (VS_strTipExp = '4') Or (VS_strTipExp = '5') ) And
                                 (DataSet.FieldByName('GER_ESPDOC').AsString = 'PD');

  If (Not DataSet.Active) Then
    btnLogRastreamento.Visible := False
  Else
    btnLogRastreamento.Visible := (fCfgSis('UTITDE', varBoolean))  And (Not fEmptyStr(DataSet.FieldByName('ROMTRA').AsString));
end;


procedure TfrmFatRomaneio.pAjustaItensEmpresaOri(cdsItens : TUniClientDataSet);
var
  intIndice: integer;
  blnEncontrou: Boolean;
begin
  if cdsItens.RecordCount <= 0 then
    Exit;

  cdsItens.First;
  //Feito dessa forma para não alterar a quantidade da baixa de itens com empresa original que foram pesquisadas.
  while not cdsItens.Eof do
  begin
    blnEncontrou := False;
    for intIndice := Low(arrEmpres) to High(arrEmpres) do
    begin
      if cdsItens.FieldByName('DET_EMPORI').AsString = arrEmpres[intIndice].strCodigo then
      begin
        blnEncontrou := True;
        Break;
      end;
    end;

    if not blnEncontrou then
    begin
      cdsItens.Edit;
      cdsItens.FieldByName('DET_QTDBAI').AsFloat := 0;
      cdsItens.Post;
    end;

    cdsItens.Next;
  end;
end;

function TfrmFatRomaneio.fRetornaCampoOrigemPedidoRetira(sAlias: String): String;
begin
  If fEmptyStr(sAlias) Then
  Begin
    Result := Result + ' " " AS GER_ORIPDR, '
  End
  Else
  Begin
    Result := Result + ' IF((SELECT COUNT(*) FROM FATDOR ';
    Result := Result + '                    WHERE FDO_ESPDOC = "PR" ';
    Result := Result + '                      AND FDO_DOCDEV='+sAlias+'.GER_NUMDOC ';
    Result := Result + '                      AND FDO_ESPDEV='+sAlias+'.GER_ESPDOC ';
    Result := Result + '                      AND FDO_EMPDEV='+sAlias+'.GER_CODEMP) > 0, "PR", "  ") AS GER_ORIPDR, ';
  End;
end;

function TfrmFatRomaneio.fRetornaCampoTurno(sCampo: String): String; begin
  Result := ' CONCAT( ';
  Result := Result + '    IF(LOCATE("MANHÃ", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0, "MAN", ""), ';
  Result := Result + '      IF(LOCATE("MANHÃ", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0 ';
  Result := Result + '        AND (LOCATE("TARDE", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0 ';
  Result := Result + '          OR LOCATE("NOITE", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0), " / ", ""), ';
  Result := Result + '    IF(LOCATE("TARDE", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0, "TAR", ""), "", ';
  Result := Result + '      IF(LOCATE("TARDE", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0 ';
  Result := Result + '        AND LOCATE("NOITE", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0, " / ", ""), ';
  Result := Result + '    IF(LOCATE("NOITE", GROUP_CONCAT(DISTINCT ' + sCampo + ')) > 0, "NOI", "") ';
  Result := Result + ' ) ';

  Result := ' CAST('+Result+' AS CHAR(15)) AS TURENT ';
end;

function TfrmFatRomaneio.fRetornaCodProfissional(strNumRom, strEmpRom, strNumDoc, strEspDoc, strEmpDoc : String): String;
Var
  qryAux : TUniQuery;
Const
  strSQL = 'SELECT       ' +
           '  DET_CODDIV ' +
           'FROM         ' +
           '  ROMDETX    ' +
           'WHERE        ' +
           '  DET_NUMROM = :NUMROM AND ' +
           '  DET_EMPROM = :EMPROM AND ' +
           '  DET_NUMDOC = :NUMDOC AND ' +
           '  DET_ESPDOC = :ESPDOC AND ' +
           '  DET_CODEMP = :EMPDOC';
begin

  Result := '';

  If fEmptyStr(strNumRom) Then
    Exit;

  If fEmptyStr(strEmpRom) Then
    Exit;

  If fEmptyStr(strNumDoc) Then
    Exit;

  If fEmptyStr(strEspDoc) Then
    Exit;

  If fEmptyStr(strEmpDoc) Then
    Exit;

  qryAux := fCriaQuery;

  Try

    qryAux.Close;
    qryAux.SQL.Clear;
    qryAux.SQL.Add(strSQL);

    qryAux.ParamByName('NUMROM').AsString := strNumRom;
    qryAux.ParamByName('EMPROM').AsString := strEmpRom;
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('EMPDOC').AsString := strEmpDoc;

    qryAux.Open;

    If Not qryAux.IsEmpty Then
      Result := qryAux.FieldByName('DET_CODDIV').AsString;

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TfrmFatRomaneio.fRetornaTemporariaDocumentosRomaneio(ATab: TTipoDocRom): String;
begin
  case ATab of
    tdrFGO:
      begin
        FTemporariaDocumentosRomaneio.pApagarTemporaria(FUltimaTemporariaDocsFGO);
        Result := FTemporariaDocumentosRomaneio.fGerarNovaTemporaria;
        FUltimaTemporariaDocsFGO := Result;
      end;
    tdrGER:
      begin
        FTemporariaDocumentosRomaneio.pApagarTemporaria(FUltimaTemporariaDocsGER);
        Result := FTemporariaDocumentosRomaneio.fGerarNovaTemporaria;
        FUltimaTemporariaDocsGER := Result;
      end;
    tdrCNF:
      begin
        FTemporariaDocumentosRomaneio.pApagarTemporaria(FUltimaTemporariaDocsCNF);
        Result := FTemporariaDocumentosRomaneio.fGerarNovaTemporaria;
        FUltimaTemporariaDocsCNF := Result;
      end;
    tdrCRM:
      begin
        FTemporariaDocumentosRomaneio.pApagarTemporaria(FTabTmpCRM);
        Result := FTemporariaDocumentosRomaneio.fGerarNovaTemporaria(tbCRM);
      end;
    tdrRomInvalido:
      begin
        FTemporariaDocumentosRomaneio.pApagarTemporaria(FTabTmpRomInvalido);
        Result := FTemporariaDocumentosRomaneio.fGerarNovaTemporaria(tbRomInvalido);
      end;
  end;
end;

function TfrmFatRomaneio.fRetornaTransportadoraSugestao: String;
  Var
    cdsTmp: TUniClientDataSet;
begin
  Result := '';

  cdsTmp := TUniClientDataSet.Create(nil);

  cdsTmp.Data := cdsTmpDoc.Data;

  cdsTmp.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+'))';
  cdsTmp.Filtered := True;

  cdsTmp.First;

  While Not cdsTmp.Eof Do
  Begin
    If Not fEmptyStr(cdsTmp.FieldByName('GER_CODTRA').AsString) Then
    Begin
      If fEmptyStr(Result) Then
      Begin
        Result := cdsTmp.FieldByName('GER_CODTRA').AsString;
      End
      //Se houverem transportadoras diferentes nao deve carregar nenhuma como sugestao
      Else If Result <> cdsTmp.FieldByName('GER_CODTRA').AsString Then
      Begin
        Result := '';
        Break;
      End;
    End;
    cdsTmp.Next;
  End;

  FreeAndNil(cdsTmp);
end;

