                        cdsTmpDoc.FieldByName('GER_CODEMP').AsString + ' pois ele possui produtos que não estão reservando estoque (OS).' + #13 +
                        'OS: ' + strNumOse + #13 +
                        'Acesse a rotina "Liberação de Reserva de Estoque Itens de Pedido de Venda - OS", ' +
                        'realize a liberação da reserva do estoque e depois, tente novamente.',
                      ['&Ok'],
                      1,
                      False,
                      1,
                      0,
                      False,
                      0,
                      False,
                      False,
                      False,
                      400,
                      100);
    end;
  finally
    FreeAndNil(stlItensOS);
  end;
end;

function TfrmFatRomaneio.fVerificaQtdeBaixadaInvalidaEmLote: Boolean;
var
  LSQL,
  LMsg: String;
  LQry: TUniQuery;
  LList: TStringList;
begin
  Result := False;

  LQry := fCriaQuery;
  LList := TStringList.Create;
  LList.Duplicates := dupIgnore;
  LList.Sorted := True;

  try
    try
      LSQL := '';
      LSQL := LSQL + ' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, FDO_QTDITE QTDITE, TMP_QTDBAI ';
      LSQL := LSQL + ' FROM ' + FTabTmpRomInvalido + ' I ';
      LSQL := LSQL + ' INNER JOIN FATDOR F ON F.AUTOINCREM = TMP_AUTINC ';
      LSQL := LSQL + '                    AND F.FDO_NUMDOC = TMP_NUMDOC ';
      LSQL := LSQL + '                    AND F.FDO_ESPDOC = TMP_ESPDOC ';
      LSQL := LSQL + '                    AND F.FDO_CODCLI = TMP_CODCLI ';
      LSQL := LSQL + '                    AND F.FDO_CODEMP = TMP_CODEMP ';
      LSQL := LSQL + ' WHERE TMP_TABELA = "FATDOR" ';
      LSQL := LSQL + '   AND TMP_QTDBAI > FDO_QTDITE ';
      LSQL := LSQL + ' UNION ';
      LSQL := LSQL + ' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, DET_QTDITE QTDITE, TMP_QTDBAI ';
      LSQL := LSQL + ' FROM ' + FTabTmpRomInvalido + ' I ';
      LSQL := LSQL + ' INNER JOIN MOVDET D ON D.AUTOINCREM = TMP_AUTINC ';
      LSQL := LSQL + '                    AND D.DET_NUMDOC = TMP_NUMDOC ';
      LSQL := LSQL + '                    AND D.DET_ESPDOC = TMP_ESPDOC ';
      LSQL := LSQL + '                    AND D.DET_CODCLI = TMP_CODCLI ';
      LSQL := LSQL + '                    AND D.DET_CODEMP = TMP_CODEMP ';
      LSQL := LSQL + ' WHERE TMP_TABELA = "MOVDET" ';
      LSQL := LSQL + '   AND TMP_QTDBAI > DET_QTDITE ';
      LSQL := LSQL + ' UNION ';
      LSQL := LSQL + ' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, DET_QTDITE QTDITE, TMP_QTDBAI ';
      LSQL := LSQL + ' FROM ' + FTabTmpRomInvalido + ' I ';
      LSQL := LSQL + ' INNER JOIN NOTDET D ON D.AUTOINCREM = TMP_AUTINC ';
      LSQL := LSQL + '                    AND D.DET_NUMDOC = TMP_NUMDOC ';
      LSQL := LSQL + '                    AND D.DET_ESPDOC = TMP_ESPDOC ';
      LSQL := LSQL + '                    AND D.DET_CODCLI = TMP_CODCLI ';
      LSQL := LSQL + '                    AND D.DET_CODEMP = TMP_CODEMP ';
      LSQL := LSQL + ' WHERE TMP_TABELA = "NOTDET" ';
      LSQL := LSQL + '   AND TMP_QTDBAI > DET_QTDITE ';

      LQry.SQL.Text := LSQL;
      LQry.Open;

      if LQry.IsEmpty then
        Exit;

      Result := True;

      while not LQry.Eof do
      begin
        LList.Add(LQry.FieldByName('TMP_NUMDOC').AsString + '-' +
                  LQry.FieldByName('TMP_ESPDOC').AsString + '-' +
                  LQry.FieldByName('TMP_CODEMP').AsString + ' | Item: ' +
                  LQry.FieldByName('TMP_CODITE').AsString + ' - Qtd Item: ' +
                  FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), LQry.FieldByName('QTDITE').AsFloat) + ' | Qtd baixada: ' +
                  FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), LQry.FieldByName('TMP_QTDBAI').AsFloat));

        LQry.Next;
      end;

      LMsg := 'Os Documentos abaixo possuem itens com quantidade baixada maior que a quantidade do item!' + sLineBreak +
              'Refaça os documentos e tente novamente.' + sLineBreak + LList.Text;

      raise ExceptionQtdRomaneio.Create(LMsg);
    except
      on e: ExceptionQtdRomaneio do
        raise;
      on e: Exception do
        raise;
    end;
  finally
    FreeAndNil(LQry);
    FreeAndNil(LList);
  end;
end;

function TfrmFatRomaneio.fVerificaQtdeRomInvalidoEmLote: Boolean;
var
  LSQL,
  LMsg: String;
  LQry: TUniQuery;
  LList: TStringList;
begin
  Result := False;

  LQry := fCriaQuery;
  LList := TStringList.Create;
  LList.Duplicates := dupIgnore;
  LList.Sorted := True;

  try
    try
      LSQL := '';
      LSQL := LSQL + ' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP ';
      LSQL := LSQL + ' FROM ' + FTabTmpRomInvalido + ' I ';
      LSQL := LSQL + ' INNER JOIN FATDOR F ON F.FDO_CODITE = TMP_CODITE ';
      LSQL := LSQL + '                    AND F.FDO_NUMDOC = TMP_NUMDOC ';
      LSQL := LSQL + '                    AND F.FDO_ESPDOC = TMP_ESPDOC ';
      LSQL := LSQL + '                    AND F.FDO_CODCLI = TMP_CODCLI ';
      LSQL := LSQL + '                    AND F.FDO_CODEMP = TMP_CODEMP ';
      LSQL := LSQL + ' LEFT JOIN ROMDETX R ON F.AUTOINCREM = R.DET_AUTINC ';
      LSQL := LSQL + '                    AND F.FDO_CODITE = R.DET_CODITE ';
      LSQL := LSQL + ' WHERE TMP_TABELA = "FATDOR" ';
      LSQL := LSQL + ' GROUP BY TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODITE ';
      LSQL := LSQL + ' HAVING (SUM(IFNULL(F.FDO_QTDROM, 0)) > SUM(F.FDO_QTDITE)) OR (IFNULL(SUM(R.DET_QTDITE), 0) > SUM(F.FDO_QTDITE)) ';
      LSQL := LSQL + ' UNION ';
      LSQL := LSQL + ' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP ';
      LSQL := LSQL + ' FROM ' + FTabTmpRomInvalido + ' I ';
      LSQL := LSQL + ' INNER JOIN MOVDET D ON D.DET_CODITE = TMP_CODITE ';
      LSQL := LSQL + '                    AND D.DET_NUMDOC = TMP_NUMDOC ';
      LSQL := LSQL + '                    AND D.DET_ESPDOC = TMP_ESPDOC ';
      LSQL := LSQL + '                    AND D.DET_CODCLI = TMP_CODCLI ';
      LSQL := LSQL + '                    AND D.DET_CODEMP = TMP_CODEMP ';
      LSQL := LSQL + ' LEFT JOIN ROMDETX R ON D.AUTOINCREM = R.DET_AUTINC ';
      LSQL := LSQL + '                    AND D.DET_CODITE = R.DET_CODITE ';
      LSQL := LSQL + ' WHERE TMP_TABELA = "MOVDET" ';
      LSQL := LSQL + ' GROUP BY TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODITE ';
      LSQL := LSQL + ' HAVING (SUM(IFNULL(D.DET_QTDROM, 0)) > SUM(D.DET_QTDITE)) OR (IFNULL(SUM(R.DET_QTDITE), 0) > SUM(D.DET_QTDITE)) ';
      LSQL := LSQL + ' UNION ';
      LSQL := LSQL + ' SELECT TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP ';
      LSQL := LSQL + ' FROM ' + FTabTmpRomInvalido + ' I ';
      LSQL := LSQL + ' INNER JOIN NOTDET D ON D.DET_CODITE = TMP_CODITE ';
      LSQL := LSQL + '                    AND D.DET_NUMDOC = TMP_NUMDOC ';
      LSQL := LSQL + '                    AND D.DET_ESPDOC = TMP_ESPDOC ';
      LSQL := LSQL + '                    AND D.DET_CODCLI = TMP_CODCLI ';
      LSQL := LSQL + '                    AND D.DET_CODEMP = TMP_CODEMP ';
      LSQL := LSQL + ' LEFT JOIN ROMDETX R ON D.AUTOINCREM = R.DET_AUTINC ';
      LSQL := LSQL + '                    AND D.DET_CODITE = R.DET_CODITE ';
      LSQL := LSQL + ' WHERE TMP_TABELA = "NOTDET" ';
      LSQL := LSQL + ' GROUP BY TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODITE ';
      LSQL := LSQL + ' HAVING (SUM(IFNULL(D.DET_QTDROM, 0)) > SUM(D.DET_QTDITE)) OR (IFNULL(SUM(R.DET_QTDITE), 0) > SUM(D.DET_QTDITE)) ';

      LQry.SQL.Text := LSQL;
      LQry.Open;

      if LQry.IsEmpty then
        Exit;

      Result := True;

      while not LQry.Eof do
      begin
        LList.Add(LQry.FieldByName('TMP_NUMDOC').AsString + '-' +
                  LQry.FieldByName('TMP_ESPDOC').AsString + '-' +
                  LQry.FieldByName('TMP_CODEMP').AsString);

        LQry.Next;
      end;

      LMsg := 'Os Documentos abaixo estão com quantidade inválida!' + sLineBreak +
              'Refaça os documentos e tente novamente.' + sLineBreak + LList.Text;

      raise ExceptionQtdRomaneio.Create(LMsg);
    except
      on e: ExceptionQtdRomaneio do
        raise;
      on e: Exception do
        raise;
    end;
  finally
    FreeAndNil(LQry);
    FreeAndNil(LList);
  end;
end;

function TfrmFatRomaneio.fVerificaSegurancaOrdImp: Integer;
  var
    intSegurancaOrdImp : Integer;
    ptnPos : Pointer;
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  //Result := 0;
  intSegurancaOrdImp := 0;

  with cdsTmpDoc do
  begin
    ptnPos := GetBookmark;

    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    First;

    while not EOF do
    begin
      if ( FieldByName('GER_ORDIMP').AsInteger > intSegurancaOrdImp ) and ( FieldByName('GER_MARDES').AsString = 'M' ) then
        intSegurancaOrdImp := FieldByName('GER_ORDIMP').AsInteger;

      Next;
    end;

    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);

    GotoBookmark(ptnPos);
    FreeBookmark(ptnPos);
  end;

  Result := intSegurancaOrdImp;
end;

procedure TfrmFatRomaneio.mnuExcluirOutEntClick(Sender: TObject);
begin
  inherited;

  If (Not fEmptyStr(cdsTmpDoc.FieldByName('GER_NROROM').AsString)) Then
  Begin 
    fMensagem('Atenção', cdsTmpDoc.FieldByName('GER_NUMDOC').AsString+' deve ser desvinculado do romaneio ' +
                         cdsTmpDoc.FieldByName('GER_NROROM').AsString +
                         ' antes de excluí-lo!', ['&Ok']);
  End
  Else If (cdsTmpDoc.FieldByName('GER_MARDES').AsString <> 'D') Then
  Begin
    fMensagem('Atenção', 'Desmarque '+cdsTmpDoc.FieldByName('GER_NUMDOC').AsString+' antes de excluí-lo!', ['&Ok']);
  End
  Else 
  Begin
    If (fTravaDocumento(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                        cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                        cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                        cdsTmpDoc.FieldByName('GER_ENTSAI').AsString)) Then
    Begin                   
       If (fDeletaOutDigX(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                          cdsTmpDoc.FieldByName('GER_CODEMP').AsString)) Then
       Begin
         fMensagem('', cdsTmpDoc.FieldByName('GER_NUMDOC').AsString+' excluído com sucesso!', ['&Ok']);
         cdsTmpDoc.Delete;
       End;
    End;
  End;
end;

function TfrmFatRomaneio.fPedidoExpedido(strAutInc: String): Boolean;
  Var
    qryGen: TUniQuery;
begin
  Try
    qryGen := fCriaQuery;

    With qryGen Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add('SELECT ');
      SQL.Add('  COUNT(*) ');
      SQL.Add('FROM ');
      SQL.Add('  FATDOR ');
      SQL.Add('   LEFT JOIN EXTDOR ON FDO_SEQFDO        = FATDOR.AUTOINCREM ');
      SQL.Add('  INNER JOIN FATGOR ON FATGOR.AUTOINCREM = FATDOR.FDO_SEQGER ');
      SQL.Add('WHERE ');
      SQL.Add('  FDO_SEQGER  = :AUTINC AND ');
      SQL.Add('  FDO_CODITE <> :ITESER AND ');
      SQL.Add('  FDO_CODITE <> :SERTER AND ');
      SQL.Add('  IFNULL(FDO_QTDEXP, 0) > 0 ');

      ParamByName('AUTINC').AsString := strAutInc;
      ParamByName('ITESER').AsString := fCfgSis('ITESER', varString);
      ParamByName('SERTER').AsString := fCfgSis('SERTER', varString);

      Open;

      Result := (Fields[0].AsInteger > 0);
    End;
  Finally
    FreeAndNil(qryGen);
  End;
end;

function TfrmFatRomaneio.fPedidoFoiFaturado(strNumDoc, strEspDoc,
  strCodEmp: String): Boolean;
begin
  If (fCampoTabela('FGO_JAFATU', 'FATGOR', ['FGO_NUMDOC', 'FGO_ESPDOC', 'FGO_CODEMP'], [strNumDoc, strEspDoc, strCodEmp]) = 1) Then
    Result := True
  Else
    Result := False;
end;

function TfrmFatRomaneio.fPermiteManterSelecao: Boolean;
begin
  Result := True;
  if not fEmptyStr(edtNumRom.Text) then
    Exit(False);

  if not fExistemRomaneiosSelecionados then
    Exit(False);
end;

function TfrmFatRomaneio.fPermiteRemoverDevolucao(const strClaFis,
  strEspDoc: String): Boolean;
begin
  Result := Not ((Pos(strOpcRom, '2_3_4_') > 0) And
                 (Pos(fCfgSis('DEVROM'), '5_6_') > 0) And
                 (fCfgSis('ZERBRI') = '1') And
                 ((strClaFis = fCfgSis('CLABRI')) Or
                  (strEspDoc = 'BR')));

  If (Result) And (fCfgSis('DEVROM') = '6') And (strEspDoc = 'PR') Then
    Result := False;
end;

