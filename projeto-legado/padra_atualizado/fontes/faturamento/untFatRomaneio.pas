procedure TfrmFatRomaneio.btnEditVeiculoClick(Sender: TObject);
var
  objPai: TWinControl;
  strVeiculo: string;
  frmFatRomTransMotLoc: TfrmFatRomTransMot;
  strFilter : String;
  blnFiltered : Boolean;

  procedure pPopulaInformacoesVetor;
  var
    intIndice: integer;
  begin
    arrVeiculos[StrToInt(strVeiculo)-1].blnTemRom    := True;
    arrVeiculos[StrToInt(strVeiculo)-1].strNumVeic   := strVeiculo;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodTRansp := frmFatRomTransMotLoc.edtCodTra.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strDesTransp := frmFatRomTransMotLoc.edtNomTra.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodMot    := frmFatRomTransMotLoc.edtCodMot.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strDesMot    := frmFatRomTransMotLoc.edtNomMot.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strPlaVeic   := frmFatRomTransMotLoc.mskPlaVei.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodReg    := frmFatRomTransMotLoc.edtCodReg.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodAj1    := frmFatRomTransMotLoc.edtCodAj1.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodAj2    := frmFatRomTransMotLoc.edtCodAj2.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodAj3    := frmFatRomTransMotLoc.edtCodAj3.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strCodAj4    := frmFatRomTransMotLoc.edtCodAj4.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].strObsFec    := frmFatRomTransMotLoc.mmoObsFec.Text;
    arrVeiculos[StrToInt(strVeiculo)-1].fltVlrFre    := fStrToFloat(frmFatRomTransMotLoc.edtVlrFrete.Text);
    arrVeiculos[StrToInt(strVeiculo)-1].fltVlrAdi    := fStrToFloat(frmFatRomTransMotLoc.edtVlrAdiant.Text);
    arrVeiculos[StrToInt(strVeiculo)-1].fltPerFre    := fStrToFloat(frmFatRomTransMotLoc.edtPercFrete.Text);

    for intIndice := 0 to objPai.ControlCount -1 do
    begin
      if (objPai.Controls[intIndice] is TLabel) then
      begin
        case AnsiIndexStr(objPai.Controls[intIndice].Name, ['lblTranspDesc_'+strVeiculo, 'lblVeicDesc_'+strVeiculo, 'lblMotorDesc_'+strVeiculo, 'lblPesoDesc_'+strVeiculo, 'lblValorDesc_'+strVeiculo]) of
          0: TLabel(objPai.Controls[intIndice]).Caption := arrVeiculos[StrToInt(strVeiculo)-1].strDesTransp;
          1: TLabel(objPai.Controls[intIndice]).Caption := Copy(arrVeiculos[StrToInt(strVeiculo)-1].strPlaVeic,1,3) + '-' + Copy(arrVeiculos[StrToInt(strVeiculo)-1].strPlaVeic,4,4);
          2: TLabel(objPai.Controls[intIndice]).Caption := arrVeiculos[StrToInt(strVeiculo)-1].strDesMot;
          3: TLabel(objPai.Controls[intIndice]).Caption := FloatToStrF(arrVeiculos[StrToInt(strVeiculo)-1].fltPeso, ffFixed, 12, 4);
          4: TLabel(objPai.Controls[intIndice]).Caption := FloatToStrF(arrVeiculos[StrToInt(strVeiculo)-1].fltTotVlr, ffFixed, 12, 4);
        end;
      end;
    end;
  end;

  function fPerguntarVincularDocumentos: boolean;
  begin
    result := fMensagem('ATENÇÃO!',
                        'Todos os documentos selecionados no grid serão vinculados a este veículo. ' +
                        'Deseja continuar?',
                        ['&Sim', '&Não'],
                        mrCancel) = mrOk;
  end;

  function fVincularDocumentosPreSelecionadosAnteriormente: boolean;
  var
    intRecNo: integer;
    blnConfirmouPergunta: boolean;
  begin
    if (arrVeiculos[StrToInt(strVeiculo)-1].blnTemRom) then
      Exit(False);

    if cdsTmpDoc.IsEmpty then
      Exit(False);

    result := False;
    blnConfirmouPergunta := False;
    intRecNo := cdsTmpDoc.RecNo;
    cdsTmpDoc.DisableControls;
    try
      cdsTmpDoc.First;
      while not cdsTmpDoc.Eof do
      begin
        if (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') = 0) then
        begin
          cdsTmpDoc.Next;
          Continue;
        end;

        if not fEmptyStr(cdsTmpDoc.FieldByName('GER_VEICUL').AsString) then
        begin
          cdsTmpDoc.Next;
          Continue;
        end;

        result := True;

        if (not blnConfirmouPergunta) and
           (not fPerguntarVincularDocumentos) then
        begin
          Break;
        end;

        if (not blnConfirmouPergunta) then
          pPopulaInformacoesVetor;

        blnConfirmouPergunta := True;

        while fEmptyStr(cdsTmpDoc.FieldByName('GER_VEICUL').AsString) do
        begin
          if (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'P') then
            pSelecionaDocumentoParcialVeiculo
          else
            pSelecionaDocumento;
        end;

        pAtualizaPainelVeiculos;
        cdsTmpDoc.Next;
      end;
    finally
      cdsTmpDoc.RecNo := intRecNo;
      cdsTmpDoc.EnableControls;
    end;
  end;
begin
  strFilter   := cdsTmpDoc.Filter;
  blnFiltered := cdsTmpDoc.Filtered;

  cdsTmpDoc.OnFilterRecord := Nil;
  cdsTmpDoc.AfterScroll    := Nil;
  Try
    objPai := TBitBtnLocked(Sender).Parent;

    if objPanelSelecionado <> objPai then
      TPanel(objPai).OnClick(objPai);

    strVeiculo := Copy(objPai.Name, Pos('_', objPai.Name)+1, 1);

    pCriarFormularios(TfrmFatRomTransMot, frmFatRomTransMotLoc);

    frmFatRomTransMotLoc.cdsTmpDoc          := cdsTmpDoc;
    frmFatRomTransMotLoc.cdsRomRet          := cdsRomRet;
    frmFatRomTransMotLoc.cdsOutDig          := FOutDig;
    frmFatRomTransMotLoc.btnRoteiro.Visible := False;

    frmFatRomTransMotLoc.edtCodTra.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodTRansp;
    frmFatRomTransMotLoc.edtNomTra.Text := arrVeiculos[StrToInt(strVeiculo)-1].strDesTransp;

    frmFatRomTransMotLoc.mskPlaVei.Text := arrVeiculos[StrToInt(strVeiculo)-1].strPlaVeic;
    frmFatRomTransMotLoc.edtDesVei.Text := fRetornaDescricaoVeic(fTiraCaracEspeciais(arrVeiculos[StrToInt(strVeiculo)-1].strPlaVeic));

    frmFatRomTransMotLoc.edtCodReg.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodReg;
    if not fEmptyStr(frmFatRomTransMotLoc.edtCodReg.Text) then
      frmFatRomTransMotLoc.pCarregaCadReg;

    frmFatRomTransMotLoc.edtCodMot.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodMot;
    frmFatRomTransMotLoc.edtNomMot.Text := arrVeiculos[StrToInt(strVeiculo)-1].strDesMot;

    frmFatRomTransMotLoc.edtCodAj1.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodAj1;
    if not fEmptyStr(frmFatRomTransMotLoc.edtCodAj1.Text) then
      frmFatRomTransMotLoc.edtNomAj1.Text := fCampoTabela('AJU_NOMAJU', 'CADAJU', ['AJU_CODAJU'],[frmFatRomTransMotLoc.edtCodAj1.Text], False);

    frmFatRomTransMotLoc.edtCodAj2.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodAj2;
    if not fEmptyStr(frmFatRomTransMotLoc.edtCodAj2.Text) then
      frmFatRomTransMotLoc.edtNomAj2.Text := fCampoTabela('AJU_NOMAJU', 'CADAJU', ['AJU_CODAJU'],[frmFatRomTransMotLoc.edtCodAj2.Text], False);

    frmFatRomTransMotLoc.edtCodAj3.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodAj3;
    if not fEmptyStr(frmFatRomTransMotLoc.edtCodAj3.Text) then
      frmFatRomTransMotLoc.edtNomAj3.Text := fCampoTabela('AJU_NOMAJU', 'CADAJU', ['AJU_CODAJU'],[frmFatRomTransMotLoc.edtCodAj3.Text], False);

    frmFatRomTransMotLoc.edtCodAj4.Text := arrVeiculos[StrToInt(strVeiculo)-1].strCodAj4;
    if not fEmptyStr(frmFatRomTransMotLoc.edtCodAj4.Text) then
      frmFatRomTransMotLoc.edtNomAj4.Text := fCampoTabela('AJU_NOMAJU', 'CADAJU', ['AJU_CODAJU'],[frmFatRomTransMotLoc.edtCodAj4.Text], False);

    frmFatRomTransMotLoc.mmoObsFec.Text := arrVeiculos[StrToInt(strVeiculo)-1].strObsFec;

    frmFatRomTransMotLoc.edtVlrFrete.Text := FloatToStrF(arrVeiculos[StrToInt(strVeiculo)-1].fltVlrFre, ffFixed, 12, 2);
    frmFatRomTransMotLoc.edtVlrAdiant.Text  := FloatToStrF(arrVeiculos[StrToInt(strVeiculo)-1].fltVlrAdi, ffFixed, 12, 2);

    frmFatRomTransMotLoc.strIntFus := FstrIntFus;

    frmFatRomTransMotLoc.pCalculaSaldoFrete;

    try
      if frmFatRomTransMotLoc.ShowModal = mrOk then
      begin
        cdsTmpDoc.OnFilterRecord := pFilterRecord;
        cdsTmpDoc.Filter   := strFilter;
        cdsTmpDoc.Filtered := blnFiltered;

        if not fVincularDocumentosPreSelecionadosAnteriormente then
          pPopulaInformacoesVetor;
      end;
    finally
      pFreeAndNil(frmFatRomTransMotLoc);
    end;
  Finally
    cdsTmpDoc.OnFilterRecord := pFilterRecord;
    cdsTmpDoc.Filter   := strFilter;
    cdsTmpDoc.Filtered := blnFiltered;

    pAfterScrollCdsTmpDoc(cdsTmpDoc);
  End;
end;

