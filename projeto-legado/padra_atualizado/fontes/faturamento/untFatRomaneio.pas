procedure TfrmFatRomaneio.pEsconderColunas;
begin
  //Esconde o Bairro e mostra o pedido de Venda
  If (fCfgSis('CFVLCB', varBoolean)) Then
  Begin
    dbgDocumentosGER_PEDVEN.Visible := True;
//    dbgDocumentosGER_PEDVEN.Width   := 60;
    dbgDocumentosGER_BAIRRO.Visible := False;
  End;

  dbgDocumentosENTURG.Visible        := (Pos(strOpcRom, '1_5_') > 0);

  dbgDocumentosDocFaturados.Visible  := (Pos(strOpcRom, '1_5_') > 0);

  If (fCfgSis('EXITUR', varstring) = 'S') Then
  Begin
    rdgTurno.Visible := True;
    dbgDocumentosTURENT.Visible := True;
  End
  Else
  Begin
    rdgTurno.Visible := False;
    dbgDocumentosTURENT.Visible := False;
  End;

  If (fCfgSis('NROPRO', varstring) <> '2') Then
  Begin
    dbgDocumentosGER_CODDIV.Visible := False;
    dbgDocumentosGER_NOMDIV.Visible := False;
  End;

  dbgDocumentosFIS_ACESSO.Visible := (fCfgSis('OPCROM', varstring) <> '1');
  dbgDocumentosROMLOT.Visible     := (fCfgSis('ROMLOT', varBoolean));
  dbgDocumentosGER_VOLBIP.Visible := fEhRomaneioSimplificado;
end;

procedure TfrmFatRomaneio.pExcluirPainelVeiculo(ACodigoVeiculoASerExcluido : String);
  var
    LobjPai         : TWinControl;
    LIdx,
    LIdy,
    Lidz            : Integer;
    LNomeTemporario : String;
    prcScroll       : TprcScroll;
    LblnWasEnabled  : Boolean;
begin
  if intContVeiculo > 1 then
  Begin
    for LIdx := 0 to flwpnlVeiculo.ControlCount - 1 do
    Begin
      if (flwpnlVeiculo.Controls[LIdx] is TPanel) and (TPanel(flwpnlVeiculo.Controls[LIdx]).Name = 'pnlVeiculo_'+ACodigoVeiculoASerExcluido) then
      Begin
        LNomeTemporario := AnsiReplaceStr(AnsiReplaceStr(AnsiReplaceStr(DateTimeToStr(VS_Date + fTime()),'/','_'),':','_'),' ','_');

        LobjPai         := TPanel(flwpnlVeiculo.Controls[LIdx]);
        LobjPai.Name    := LobjPai.Name+'_'+LNomeTemporario;
        LobjPai.Visible := False;

        for LIdy := 0 to LobjPai.ControlCount - 1 do
        begin
          LobjPai.Controls[LIdy].Name := LobjPai.Controls[LIdy].Name+'_'+LNomeTemporario;
        end;
      End;
    End;

    Lidz := 1;
    for LIdx := 0 to flwpnlVeiculo.ControlCount-1 do
    begin
      if flwpnlVeiculo.Controls[LIdx].Visible = False then
        continue;

      LobjPai := TPanel(flwpnlVeiculo.Controls[LIdx]);

      if cdsTmpDoc.Active  then
      Begin
        LblnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

        if LblnWasEnabled then
          pDisableControls(cdsTmpDoc, prcScroll);

        cdsTmpDoc.First;
        while not cdsTmpDoc.Eof do
        Begin
          if Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') > 0 then
          Begin
            if cdsTmpDoc.FieldByName('GER_VEICUL').AsString = Copy(LobjPai.Name, Pos('_', LobjPai.Name)+1, 1) then
            Begin
              cdsTmpDoc.Edit;
              cdsTmpDoc.FieldByName('GER_VEICUL').AsString := IntToStr(Lidz);
              cdsTmpDoc.Post;
            End;
          End;

          cdsTmpDoc.Next;
        End;

        if LblnWasEnabled then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;

      LobjPai.Name := Copy(LobjPai.Name, 1, Pos('_', LobjPai.Name))+IntToStr(Lidz);

      for LIdy := 0 to LobjPai.ControlCount - 1 do
      begin
        LobjPai.Controls[LIdy].Name :=
          Copy(LobjPai.Controls[LIdy].Name, 1, Pos('_', LobjPai.Controls[LIdy].Name))+IntToStr(Lidz);
      end;

      Inc(Lidz);
    end;

    for LIdx := StrToInt(ACodigoVeiculoASerExcluido)-1 to High(arrVeiculos)-1 do
    Begin
      arrVeiculos[LIdx].blnTemRom    := arrVeiculos[LIdx+1].blnTemRom;
      arrVeiculos[LIdx].strCodTRansp := arrVeiculos[LIdx+1].strCodTRansp;
      arrVeiculos[LIdx].strDesTransp := arrVeiculos[LIdx+1].strDesTransp;
      arrVeiculos[LIdx].strCodMot    := arrVeiculos[LIdx+1].strCodMot;
      arrVeiculos[LIdx].strDesMot    := arrVeiculos[LIdx+1].strDesMot;
      arrVeiculos[LIdx].strPlaVeic   := arrVeiculos[LIdx+1].strPlaVeic;
      arrVeiculos[LIdx].strCodReg    := arrVeiculos[LIdx+1].strCodReg;
      arrVeiculos[LIdx].strCodAj1    := arrVeiculos[LIdx+1].strCodAj1;
      arrVeiculos[LIdx].strCodAj2    := arrVeiculos[LIdx+1].strCodAj2;
      arrVeiculos[LIdx].strCodAj3    := arrVeiculos[LIdx+1].strCodAj3;
      arrVeiculos[LIdx].strCodAj4    := arrVeiculos[LIdx+1].strCodAj4;
      arrVeiculos[LIdx].strObsFec    := arrVeiculos[LIdx+1].strObsFec;
      arrVeiculos[LIdx].fltVlrFre    := arrVeiculos[LIdx+1].fltVlrFre;
      arrVeiculos[LIdx].fltVlrAdi    := arrVeiculos[LIdx+1].fltVlrAdi;
      arrVeiculos[LIdx].fltPerFre    := arrVeiculos[LIdx+1].fltPerFre;
      arrVeiculos[LIdx].fltPeso      := arrVeiculos[LIdx+1].fltPeso;
      arrVeiculos[LIdx].fltTotVlr    := arrVeiculos[LIdx+1].fltTotVlr;
    End;

    Dec(intContVeiculo);
    SetLength(arrVeiculos, intContVeiculo);
  End
  Else
  Begin
    for LIdx := 0 to flwpnlVeiculo.ControlCount - 1 do
    begin
      if (flwpnlVeiculo.Controls[LIdx] is TPanel) and (TPanel(flwpnlVeiculo.Controls[LIdx]).Name = 'pnlVeiculo_'+ACodigoVeiculoASerExcluido) then
      begin
        LobjPai := TPanel(flwpnlVeiculo.Controls[LIdx]);

        for LIdy := 0 to LobjPai.ControlCount - 1 do
        begin
          if (LobjPai.Controls[LIdy] is TLabel) then
          Begin
            if TLabel(LobjPai.Controls[LIdy]).Name = 'lblTransp_1' then
              TLabel(LobjPai.Controls[LIdy]).Caption := 'Transp:'
            Else
            if TLabel(LobjPai.Controls[LIdy]).Name = 'lblVeic_1' then
              TLabel(LobjPai.Controls[LIdy]).Caption := 'Veículo:'
            Else
            if TLabel(LobjPai.Controls[LIdy]).Name = 'lblMotor_1' then
              TLabel(LobjPai.Controls[LIdy]).Caption := 'Motorista:'
            Else
            if TLabel(LobjPai.Controls[LIdy]).Name = 'lblPeso_1' then
              TLabel(LobjPai.Controls[LIdy]).Caption := 'Peso:'
            Else
            if TLabel(LobjPai.Controls[LIdy]).Name = 'lblValor_1' then
              TLabel(LobjPai.Controls[LIdy]).Caption := 'Vr. Total:'
            Else
              TLabel(LobjPai.Controls[LIdy]).Caption := '';
          End;

        end;
      end;
    end;

    arrVeiculos[0].blnTemRom    := False;
    arrVeiculos[0].strNumVeic   := EmptyStr;
    arrVeiculos[0].strCodTRansp := EmptyStr;
    arrVeiculos[0].strDesTransp := EmptyStr;
    arrVeiculos[0].strCodMot    := EmptyStr;
    arrVeiculos[0].strDesMot    := EmptyStr;
    arrVeiculos[0].strPlaVeic   := EmptyStr;
    arrVeiculos[0].strCodReg    := EmptyStr;
    arrVeiculos[0].strCodAj1    := EmptyStr;
    arrVeiculos[0].strCodAj2    := EmptyStr;
    arrVeiculos[0].strCodAj3    := EmptyStr;
    arrVeiculos[0].strCodAj4    := EmptyStr;
    arrVeiculos[0].strObsFec    := EmptyStr;
    arrVeiculos[0].fltVlrFre    := 0;
    arrVeiculos[0].fltVlrAdi    := 0;
    arrVeiculos[0].fltPerFre    := 0;
    arrVeiculos[0].fltPeso      := 0;
    arrVeiculos[0].fltTotVlr    := 0;

    if cdsTmpDoc.Active  then
    Begin
      LblnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

      if LblnWasEnabled then
        pDisableControls(cdsTmpDoc, prcScroll);

      cdsTmpDoc.First;
      while not cdsTmpDoc.Eof do
      Begin
        if cdsTmpDoc.FieldByName('GER_VEICUL').AsString = '1' then
        Begin
          cdsTmpDoc.Edit;
          cdsTmpDoc.FieldByName('GER_VEICUL').AsString := EmptyStr;
          cdsTmpDoc.Post;
        End;

        cdsTmpDoc.Next;
      End;

      if LblnWasEnabled then
        pEnableControls(cdsTmpDoc, prcScroll);
    End;
  End;
end;

Function TfrmFatRomaneio.fTravaDocumento(strNomTbl, strNumDoc, strCodEmp, strEntSai: String): Boolean;
  Var
    strChaLck: String;
Begin
  strChaLck := strNomTbl + AnsiReplaceStr(strNumDoc,'-','') + strCodEmp;
