begin

  strSQLDV := '';
  strSQLDV := strSQLDV + 'UNION ALL ';

  strSQLDV := strSQLDV + 'SELECT SQL_NO_CACHE ';
  strSQLDV := strSQLDV + fRetSQLDocRetornadoRomaneio('GER') + ' AS GER_RETROM, ';
  strSQLDV := strSQLDV + '  GER_CONPAG   AS GER_CONPAG, ';
  strSQLDV := strSQLDV + '  GER_CODFPG   AS GER_CODFPG, ';
  strSQLDV := strSQLDV + '  " "          AS GER_TIPOPE, ';
  strSQLDV := strSQLDV + '  " "          AS GER_FPGNEG, ';
  strSQLDV := strSQLDV + '  "N"          AS GER_ORIF11, ';
  strSQLDV := strSQLDV + '  0.00         AS GER_TOTBRI, ';
  strSQLDV := strSQLDV + '  0.00         AS GER_VALREC, ';
  strSQLDV := strSQLDV + '  0.00         AS GER_BOLADT, ';
  strSQLDV := strSQLDV + '  "N"          AS GER_BOLVEN, ';
  strSQLDV := strSQLDV + '  0.00         AS GER_VALADT, ';
  strSQLDV := strSQLDV + '  GER_VLRCON   AS GER_CONORI, ';
  strSQLDV := strSQLDV + '  GER_DTAENT, ';
  strSQLDV := strSQLDV + '  GER_HORENT, ';
  strSQLDV := strSQLDV + '  GER_DTENTR, ';
  strSQLDV := strSQLDV + '  CONCAT( GER_NUMDOC, "-", GER_ESPDOC ), ';
  strSQLDV := strSQLDV + '  GER_NUMDOC, ';
  strSQLDV := strSQLDV + '  GER_ESPDOC, ';
  strSQLDV := strSQLDV + '  GER_CODEMP, ';
  strSQLDV := strSQLDV + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSQLDV := strSQLDV + '  GER_CODCLI, ';
  strSQLDV := strSQLDV + '  IF( GER_NOMCON IS NULL, CLI_NOMCLI, GER_NOMCON), ';
  strSQLDV := strSQLDV + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSQLDV := strSQLDV + '  GER_CLAFIS, ';

  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSQLDV := strSQLDV + '  GER_TIPFRE, ';

  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_BAIENT, COALESCE(GER_BAICON, CADCLI.CLI_BAIRRO)) AS GER_BAIRRO, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_ENDENT, COALESCE(GER_ENDCON, CADCLI.CLI_ENDERE)) AS GER_ENDCON, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_LATLON, " ") AS GER_LATLON, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_CEPENT, COALESCE(GER_CEPCON, CADCLI.CLI_C_E_P_)) AS GER_CEPCON, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_REFENT, CADCLI.CLI_REFENT) AS GER_REFCON, ';

  strSQLDV := strSQLDV + '  GER_CODVEN, ';
  strSQLDV := strSQLDV + '  CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
  strSQLDV := strSQLDV + '  IF(GER_ESPDOC = "TR", SUM((DET_UNITAR * (DET_QTDITE - IFNULL(DET_QTDROM, 0))) - ROUND(((DET_DESESP / DET_QTDITE) * (DET_QTDITE - IFNULL(DET_QTDROM, 0))),  2)), IFNULL(GER_VLRCON, 0) - IFNULL(GER_VALROM, 0)), ';
  strSQLDV := strSQLDV + '  IF(GER_ESPDOC = "TR", SUM((DET_UNITAR * (DET_QTDITE - IFNULL(DET_QTDROM, 0))) - ROUND(((DET_DESESP / DET_QTDITE) * (DET_QTDITE - IFNULL(DET_QTDROM, 0))),  2)), IFNULL(GER_VLRCON, 0) - IFNULL(GER_VALROM, 0)), ';
  strSQLDV := strSQLDV + '  (GER_TOTPRO - GER_DESESP) GER_VLRPRO, ';
  strSQLDV := strSQLDV + '  GER_ROMIMP, ';
  strSQLDV := strSQLDV + '  "D" AS GER_MARDES, ';
  strSQLDV := strSQLDV + '  " " AS GER_VEICUL, ';

  strSQLDV := strSQLDV + fGetSQLPosObs('MOVGER','GER_NUMDOC','GER_ESPDOC','GER_CODEMP') + ' AS POSOBS, ';

  strSQLDV := strSQLDV + '  LPAD("", 15, " ") AS GER_PALET_, ';
  strSQLDV := strSQLDV + '  0.00 GER_VALSEL, ';
  strSQLDV := strSQLDV + '  0.00 GER_VSEPRO, ';
  strSQLDV := strSQLDV + '  GER_TIP_FC, ';
  strSQLDV := strSQLDV + '  0 GER_ORDIMP, ';
  strSQLDV := strSQLDV + '  " " GER_ALTERA, ';
  strSQLDV := strSQLDV + '  0 INCREMENTO, ';
  strSQLDV := strSQLDV + '  IF(IFNULL(TRAMOV.TRA_CODTRA,"") = "", CADTRA.TRA_CODTRA, TRAMOV.TRA_CODTRA) AS GER_CODTRA, ';
  strSQLDV := strSQLDV + '  IF(IFNULL(TRAMOV.TRA_NOMTRA,"") = "", CADTRA.TRA_NOMTRA, TRAMOV.TRA_NOMTRA) AS GER_TRANSP, ';
  strSQLDV := strSQLDV + '  CADTRA.TRA_NOMTRA AS GER_TRAFAT, ';
  strSQLDV := strSQLDV + '  GER_CODTRA  AS GER_TRADOC, ';
  strSQLDV := strSQLDV + '  GER_PESBRU, ';
  strSQLDV := strSQLDV + '  "MOVGER" AS GER_NOMTBL, ';
  strSQLDv := strSQLDv + '  MOVGER.AUTOINCREM AS GER_AUTINC, ';

  If (Pos(strOpcRom,'2_3_') > 0) Then
  Begin
    strSQLDV := strSQLDV + '  "D" AS GER_ORIDOC, ';
    strSQLDV := strSQLDV + '  CAST(' + fSQLTotDet('DET') + ' AS DECIMAL(15, 4)) GER_TOTDET, ';
    strSQLDV := strSQLDV + '  GER_NUMROM,  ';
    strSQLDV := strSQLDV + '  "", ';
    strSQLDV := strSQLDV + '  "", ';
  End
  Else If (strOpcRom = '4') Then
  Begin
    strSQLDV := strSQLDV + '  "", ';
    strSQLDV := strSQLDV + '  "", ';
    strSQLDV := strSQLDV + '  "D" AS GER_ORIDOC, ';
    strSQLDV := strSQLDV + '  CAST(' + fSQLTotDet('DET') + ' AS DECIMAL(15, 4)) GER_TOTDET, ';
    strSQLDV := strSQLDV + '  GER_NUMROM,  ';
  End;

  strSQLDV := strSQLDV + '  (SELECT GROUP_CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC) FROM FATGOR WHERE FGO_NUMFAT = GER_NUMDOC AND FGO_TIPFAT = GER_ESPDOC AND FGO_EMPFAT = GER_CODEMP), ';
  strSQLDV := strSQLDV + '  GER_VOLUME, ';

  strSQLDV := strSQLDV + fSQLProfissionalCodigo('DET') + ' AS GER_CODDIV, ';
  strSQLDV := strSQLDV + fSQLProfissionalNome('DET')   + ' AS GER_NOMDIV, ';

  strSQLDV := strSQLDV + '  MOV_OBSERV AS GER_NFEADC, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEXP, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEX2, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEX3, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEX4, ';
  strSQLDV := strSQLDV + '  " " AS ENTURG, ';
  strSQLDV := strSQLDV + '  GER_PRVIMP,  ';
  strSQLDV := strSQLDV + '  "E" AS GER_ENTSAI, ';
  strSQLDV := strSQLDV + '  FIS_ACESSO, ';
  strSQLDV := strSQLDV + '  GER_ENTFUT, ';
  strSQLDV := strSQLDV + '  GER_ENTFAT, ';
  strSQLDV := strSQLDV + '  GER_CONENT, ';
  strSQLDV := strSQLDV + '  "N" AS APENAS_ESTE, ';
  strSQLDV := strSQLDV + '  0 AS GER_VOLBIP, ';
  strSQLDV := strSQLDV + fRetSQLDescrRegiao;
  strSQLDV := strSQLDV + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';
  strSQLDV := strSQLDV + fRetSQLSeqRotaRegiao('IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID)');
  strSQLDV := strSQLDV + '  GER_BASSIM, ';
  strSQLDV := strSQLDV + '  GER_BASIPI, ';
  strSQLDV := strSQLDV + '  GER_TOTIPI, ';
  strSQLDV := strSQLDV + '  GER_BASICM, ';
  strSQLDV := strSQLDV + '  GER_TOTICM, ';
  strSQLDV := strSQLDV + '  GER_TOTRET, ';
  strSQLDV := strSQLDV + '  GER_BASRET, ';
  strSQLDV := strSQLDV + '  GER_DESESP, ';
  strSQLDV := strSQLDV + '  GER_TOTCUS, ';
  strSQLDV := strSQLDV + '  GER_TOTMED, ';
  strSQLDV := strSQLDV + '  GER_TOTFRE, ';
  strSQLDV := strSQLDV + '  GER_VPAR01, ';
  strSQLDV := strSQLDV + '  GER_VPAR02, ';
  strSQLDV := strSQLDV + '  GER_VPAR03, ';
  strSQLDV := strSQLDV + '  GER_VPAR04, ';
  strSQLDV := strSQLDV + '  GER_VPAR05, ';
  strSQLDV := strSQLDV + '  GER_VPAR06, ';
  strSQLDV := strSQLDV + '  GER_VPAR07, ';
  strSQLDV := strSQLDV + '  GER_VPAR08, ';
  strSQLDV := strSQLDV + '  GER_VPAR09, ';
  strSQLDV := strSQLDV + '  GER_VPAR10, ';
  strSQLDV := strSQLDV + '  GER_VPAR11, ';
  strSQLDV := strSQLDV + '  GER_VPAR12, ';
  strSQLDV := strSQLDV + '  GER_TOTPRO, ';
  strSQLDV := strSQLDV + '  GER_CODCND, ';
  strSQLDV := strSQLDV + fRetornaCampoOrigemPedidoRetira('');
  strSQLDV := strSQLDV + '  " " AS GER_ORIDEV, ';
  strSQLDV := strSQLDV + fRetornaInformacoesRota;
  strSQLDV := strSQLDV + '  " " AS DOC_FATURADOS, ';
  strSQLDV := strSQLDV + '  " " AS GER_INCFUT, ';
  strSQLDV := strSQLDV + '  " " AS TIPPED, ';
  strSQLDV := strSQLDV + '  1.00 AS GER_PERDEV, ';
  strSQLDV := strSQLDV + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSQLDV := strSQLDV + '  FROM ROMLGE ';
  strSQLDV := strSQLDV + '  INNER JOIN ROMLDE ';
  strSQLDV := strSQLDV + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
  strSQLDV := strSQLDV + '  WHERE RLD_NUMDOC = GER_NUMDOC ';
  strSQLDV := strSQLDV + '  AND RLD_ESPDOC = GER_ESPDOC ';
