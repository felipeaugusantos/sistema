procedure TfrmFatRomaneio.pAtualizaDadosParaRomaneioBaseadoEmDevolucoes(AcdsRomaneio : TUniClientDataSet; AblnAtualizacaoDosItens : Boolean);
  Var
    LprcScroll     : TprcScroll;
    LblnWasEnabled : Boolean;
    LfltPercentual,
    LfltDevolvido,
    LfltDiponivel  : Double;
    LblnPermiteRemoverDevolucao: Boolean;
    strAutInc,
    strEspDoc: String;

    function fSQLQtdEmOutrosRomaneios: String;
    begin
      Result := Result +
          ' SELECT IFNULL(SUM(IFNULL(ROMDETX.DET_QTDBAI, 0)), 0) '+
          '    FROM ROMDETX '+
          ' WHERE ROMDETX.DET_AUTINC = MOVDET.AUTOINCREM '+
          '   AND ROMDETX.DET_NUMDOC = MOVDET.DET_NUMDOC '+
          '   AND ROMDETX.DET_ESPDOC = MOVDET.DET_ESPDOC '+
          '   AND ROMDETX.DET_CODEMP = MOVDET.DET_CODEMP ';


      If fCfgSis('UTITDE', varBoolean) Then
        Result := Result + ' AND NOT EXISTS( SELECT '+
                           '                   TRA.AUTOINCREM '+
                           '                 FROM '+
                           '                   ROMTRAX TRA '+
                           '                 WHERE '+
                           '                   TRA.TRA_SEQGER = ROMDETX.DET_SEQGER) ';

      If (Not fEmptyStr(edtNumRom.Text)) Then
      Begin
        Result := Result +
          '   AND (NOT (ROMDETX.DET_NUMROM = '+QuotedStr(edtNumRom.Text)+' AND ROMDETX.DET_EMPROM = '+QuotedStr(VS_strCodEmp)+')) ';
      End;

      Result := ' ('+Result+') ';
    end;

    function fProcessaDisponivel: Double;
      Var
        qryGen: TUniquery;
        fltQtdDisponivel: Double;
    begin
      Result := 0;
      qryGen := fCriaQuery;
      Try
        qryGen.Close;
        qryGen.SQL.Text :=
            ' SELECT AUTOINCREM, '+fSQLQtdEmOutrosRomaneios+' AS DET_QTDROM, DET_QTDITE, '+fSQLQtdDevolvida+' AS DET_QTDDEV, (DET_VLRCON/DET_QTDITE) AS DET_VLRCON '+
            '   FROM MOVDET '+
            '  WHERE '+IIF(AblnAtualizacaoDosItens,'AUTOINCREM','DET_SEQGER')+' = :AUTINC';

        If AblnAtualizacaoDosItens Then
          qryGen.ParamByName('AUTINC').AsString := AcdsRomaneio.FieldByName('DET_AUTINC').AsString
        Else
          qryGen.ParamByName('AUTINC').AsString := AcdsRomaneio.FieldByName('GER_AUTINC').AsString;

        qryGen.Open;
        qryGen.First;
        While Not qryGen.Eof Do
        Begin
          fltQtdDisponivel := qryGen.FieldByName('DET_QTDITE').AsFloat -
                              qryGen.FieldByName('DET_QTDDEV').AsFloat -
                              qryGen.FieldByName('DET_QTDROM').AsFloat;

          If (fltQtdDisponivel > 0) Then
          Begin
            If AblnAtualizacaoDosItens Then
              Result :=  Result + fltQtdDisponivel
            Else
              Result :=  Result + fFormataFloat(fltQtdDisponivel * qryGen.FieldByName('DET_VLRCON').AsFloat, 2)
          End;

          qryGen.Next;
        End;
      Finally
        FreeAndNil(qryGen);
      End;
    end;

begin
  LblnWasEnabled := Not AcdsRomaneio.ControlsDisabled;

  If LblnWasEnabled Then
    pDisableControls(AcdsRomaneio, LprcScroll);

  AcdsRomaneio.Filtered := False;
  AcdsRomaneio.Filter   := '';
  AcdsRomaneio.Filtered := True;

  AcdsRomaneio.First;
  Try
    While Not AcdsRomaneio.Eof Do
    Begin
      If AblnAtualizacaoDosItens Then
      begin
        strAutInc := AcdsRomaneio.FieldByName('DET_AUTINC').AsString;
        strEspDoc := AcdsRomaneio.FieldByName('DET_ESPDOC').AsString;
      end
      Else
      begin
        strAutInc := AcdsRomaneio.FieldByName('GER_AUTINC').AsString;
        strEspDoc := AcdsRomaneio.FieldByName('GER_ESPDOC').AsString;
      end;

      If ((fEhTransbordo(AcdsRomaneio, AblnAtualizacaoDosItens)) And
        (Not fPossuiDevolucao(AblnAtualizacaoDosItens, strAutInc))) Or
        (strEspDoc = 'OX') Then
      Begin
        AcdsRomaneio.Next;
        Continue;
      End;

      LfltDiponivel := fProcessaDisponivel;

      If LfltDiponivel <= 0 Then
      Begin
        LfltPercentual := 0
      End
      Else
      Begin
        if AblnAtualizacaoDosItens then
        Begin
          LfltPercentual := 1;
          If fFormataFloat(LfltDiponivel, 4) < fFormataFloat(AcdsRomaneio.FieldByName('DET_QTDITE').AsFloat, 4) Then
          Begin
            LfltDevolvido := AcdsRomaneio.FieldByName('DET_QTDITE').AsFloat - LfltDiponivel;
            LfltPercentual := 1 - (LfltDevolvido/AcdsRomaneio.FieldByName('DET_QTDITE').AsFloat)
          End
        End
        Else
        Begin
          LfltPercentual := 1;
          If fFormataFloat(LfltDiponivel, 4) < fFormataFloat(AcdsRomaneio.FieldByName('GER_VLRCON').AsFloat, 4) Then
          Begin
            LfltDevolvido := AcdsRomaneio.FieldByName('GER_VLRCON').AsFloat - LfltDiponivel;
            LfltPercentual := 1 - (LfltDevolvido/AcdsRomaneio.FieldByName('GER_VLRCON').AsFloat)
          End;
        End;
      End;

      if LfltPercentual = 1 then
      Begin
        AcdsRomaneio.Next;
        Continue;
      End;

      if LfltPercentual <= 0 then
      Begin
        If AblnAtualizacaoDosItens Then
          LblnPermiteRemoverDevolucao := fPermiteRemoverDevolucao(
             Copy(AcdsRomaneio.FieldByName('DET_CLAFIS').AsString,2,3),
             AcdsRomaneio.FieldByName('DET_ESPDOC').AsString)
        Else
          LblnPermiteRemoverDevolucao := fPermiteRemoverDevolucao(
             Copy(AcdsRomaneio.FieldByName('DET_CLAFIS').AsString,2,3),
             AcdsRomaneio.FieldByName('GER_ESPDOC').AsString);

        If LblnPermiteRemoverDevolucao Then
        Begin
          AcdsRomaneio.Edit;
          AcdsRomaneio.FieldByName('DELETA_DEVOLUCAO').AsString := 'S';
          AcdsRomaneio.Post;

          AcdsRomaneio.Next;

          Continue;
        End;
      End
      Else
      Begin
        if not AblnAtualizacaoDosItens then
        Begin
          AcdsRomaneio.Edit;
          AcdsRomaneio.FieldByName('GER_VLRCON').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VLRCON').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VALDOC').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VALDOC').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_PESBRU').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_PESBRU').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTDET').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTDET').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VOLUME').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VOLUME').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_BASSIM').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_BASSIM').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_BASIPI').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_BASIPI').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTIPI').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTIPI').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_BASICM').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_BASICM').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTICM').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTICM').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTRET').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTRET').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_BASRET').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_BASRET').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_DESESP').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_DESESP').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTCUS').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTCUS').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTMED').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTMED').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTFRE').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTFRE').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR01').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR01').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR02').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR02').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR03').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR03').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR04').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR04').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR05').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR05').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR06').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR06').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR07').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR07').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR08').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR08').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR09').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR09').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR10').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR10').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR11').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR11').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_VPAR12').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_VPAR12').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_TOTPRO').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('GER_TOTPRO').AsFloat * LfltPercentual, 2);
          AcdsRomaneio.FieldByName('GER_PERDEV').AsFloat := LfltPercentual;
          AcdsRomaneio.Post;
        End
        Else
        Begin
          AcdsRomaneio.Edit;
          AcdsRomaneio.FieldByName('DET_QTDITE').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('DET_QTDITE').AsFloat * LfltPercentual, 4);
          AcdsRomaneio.FieldByName('DET_QTDBAI').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('DET_QTDBAI').AsFloat * LfltPercentual, 4);
          AcdsRomaneio.FieldByName('DET_QTDTMP').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('DET_QTDTMP').AsFloat * LfltPercentual, 4);
          AcdsRomaneio.FieldByName('DET_QTDTOT').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('DET_QTDTOT').AsFloat * LfltPercentual, 4);
          AcdsRomaneio.FieldByName('DET_TOTPES').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('DET_TOTPES').AsFloat * LfltPercentual, 4);
          AcdsRomaneio.FieldByName('DET_VLTOPE').AsFloat := fFormataFloat(AcdsRomaneio.FieldByName('DET_VLTOPE').AsFloat * LfltPercentual, 4);
          AcdsRomaneio.Post;
        End;
      End;

      AcdsRomaneio.Next;
    End;

    AcdsRomaneio.First;
    while not AcdsRomaneio.Eof do
    begin
      if AcdsRomaneio.FieldByName('DELETA_DEVOLUCAO').AsString = 'S' then
        AcdsRomaneio.Delete
      else
        AcdsRomaneio.Next;
    end;
  Finally
    AcdsRomaneio.Filter   := '';
    AcdsRomaneio.Filtered := False;

    If LblnWasEnabled Then
      pEnableControls(AcdsRomaneio, LprcScroll);
  End;
end;

procedure TfrmFatRomaneio.pAtualizaInfoCRMLocalEmLote(ATransMot: TDadosTransMot; pgbStatus: TcxProgressBar);
var
  LSQL: String;
  LQry: TUniQuery;
begin
  pSetTextAguarde('Aguarde... Atualizando status e registrando ocorrências CRM.', pgbStatus);
  LQry := fCriaQuery;

  try
    LSQL := '';
    LSQL := LSQL + ' SELECT "" NUM_PD, TMP_NUMDOC NUMDOC, TMP_ESPDOC ESPDOC, TMP_CODEMP CODEMP, ';
    LSQL := LSQL + '   TMP_AUTINC AUTINC, TMP_CODCLI CODCLI, ';
    LSQL := LSQL + '   TMP_CODVEN CODVEN, TMP_NUMROM NUMROM, TMP_ENTSAI ENTSAI, "" ESP_PD ';
    LSQL := LSQL + ' FROM ' + FTabTmpCRM + ' T ';
    LSQL := LSQL + ' WHERE TMP_TABELA = "FATGOR" ';
    LSQL := LSQL + ' UNION ';
    LSQL := LSQL + ' SELECT DISTINCT FDO_NUMDOC NUM_PD, TMP_NUMDOC NUMDOC, TMP_ESPDOC ESPDOC, FDO_CODEMP CODEMP, ';
    LSQL := LSQL + '   G.AUTOINCREM AS AUTINC, TMP_CODCLI CODCLI, ';
    LSQL := LSQL + '   TMP_CODVEN CODVEN, TMP_NUMROM NUMROM, TMP_ENTSAI ENTSAI, FDO_ESPDOC ESP_PD ';
    LSQL := LSQL + ' FROM ' + FTabTmpCRM + ' T ';
    LSQL := LSQL + ' INNER JOIN FATDOR F ON FDO_NUMFAT = TMP_NUMDOC ';
    LSQL := LSQL + '                    AND FDO_TIPFAT = TMP_ESPDOC ';
    LSQL := LSQL + '                    AND FDO_EMPFAT = TMP_CODEMP ';
    LSQL := LSQL + ' INNER JOIN FATGOR G ON G.AUTOINCREM = F.FDO_SEQGER ';
    LSQL := LSQL + ' WHERE TMP_TABELA <> "FATGOR" ';
    LSQL := LSQL + ' ORDER BY NUMROM ';

    LQry.SQL.Text := LSQL;
    LQry.Open;

    if LQry.IsEmpty then
      Exit;

    If Assigned(objOcoCrm) Then
      FreeAndNil(objOcoCrm);

    while not LQry.Eof do
    begin
      fAtualizaInformacoesCRMLocal(
        LQry.FieldByName('NUMDOC').AsString,
        LQry.FieldByName('ESPDOC').AsString,
        LQry.FieldByName('CODEMP').AsString,
        LQry.FieldByName('AUTINC').AsString,
        LQry.FieldByName('CODCLI').AsString,
        LQry.FieldByName('CODVEN').AsString,
        ATransMot.strCodMot,
        ATransMot.strCodTra,
        LQry.FieldByName('NUMROM').AsString,
        LQry.FieldByName('NUM_PD').AsString,
        LQry.FieldByName('ESP_PD').AsString,
        LQry.FieldByName('ENTSAI').AsString,
        True);

      LQry.Next;
    end;

    If Assigned(objOcoCrm) Then
      objOcoCrm.pGravarLoteOcorrencias(False);
  finally
    FreeAndNil(LQry);
    If Assigned(objOcoCrm) Then
      FreeAndNil(objOcoCrm);
  end;
end;

procedure TfrmFatRomaneio.pAtualizaPainelVeiculos;
var
  intIndicePai, intIndiceFilho: integer;
  fltPeso, fltValor: Double;
  objPai: TWinControl;
  strPeso: string;
  strValor: string;
begin
  for intIndicePai := 0 to flwpnlVeiculo.ControlCount - 1 do
  begin
    pCalculaPesoValorVeiculo(IntToStr(intIndicePai + 1), fltPeso, fltValor);

    strPeso := 'lblPesoDesc_' + IntToStr(intIndicePai + 1);
    strValor := 'lblValorDesc_' + IntToStr(intIndicePai + 1);

    if (flwpnlVeiculo.Controls[intIndicePai] is TPanel) then
    begin
      objPai := TPanel(flwpnlVeiculo.Controls[intIndicePai]);
      for intIndiceFilho := 0 to objPai.ControlCount -1 do
      begin
        if (objPai.Controls[intIndiceFilho] is TLabel) then
        begin
          case AnsiIndexStr(objPai.Controls[intIndiceFilho].Name, [strPeso, strValor]) of
            0: TLabel(objPai.Controls[intIndiceFilho]).Caption := FloatToStrF(fltPeso, ffFixed, 12, 4);
            1: TLabel(objPai.Controls[intIndiceFilho]).Caption := FloatToStrF(fltValor, ffFixed, 12, 4);
          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmFatRomaneio.fAtualizaInformacoesCRMLocal(ANumDoc, AEspDoc, ACodEmp, AAutInc, ACodCli,
  ACodVen, ACodMot, ACodTra, ANumRom: String; ANumOrc: String = ''; AEspOrc: String = ''; AEntSai: String = '';
  AGravarOcorrenciasEmLote : Boolean = False);
var
  LIdx: Integer;
begin
  LIdx := StlDocsEdit.IndexOf(Concat(ANumDoc, '-',
                                     AEspDoc, '-',
                                     VS_strCodEmp, '-',
                                     AAutInc,
                                     AEntSai));

  If (Not Assigned(objOcoCrm)) Then
    objOcoCrm := TAtuOcoCrm.Create(nil);

  objOcoCrm.strNumDoc := ANumDoc;
  objOcoCrm.strEspDoc := AEspDoc;
  objOcoCrm.strCodEmp := ACodEmp;
  objOcoCrm.strCodCli := ACodCli;
  objOcoCrm.strNumOrc := ANumOrc;
  objOcoCrm.strEspOrc := AEspOrc;
  objOcoCrm.strEmpFat := '';
  objOcoCrm.strCodOpe := ACodVen;
  objOcoCrm.afcAcaFat := IIF(LIdx >= 0, afcRomaneioAlteracao, afcRomaneioInclusao);
  objOcoCrm.strCpfCli := '';
  objOcoCrm.strCodCliAnt := '';
  objOcoCrm.strCodFaz := '';

  if (not blnUsaPreRom) then
  begin
    objOcoCrm.strCodMot := ACodMot;
    objOcoCrm.strCodTra := ACodTra;
    objOcoCrm.strNumRom := ANumRom;
  end;

  objOcoCrm.strNomFrm := Self.Name;
  objOcoCrm.blnGravarOcorrenciasEmLote := AGravarOcorrenciasEmLote;
  TAtuOcoCrm(objOcoCrm).pProcessaFatOcorrenciasCRM;
end;

function TfrmFatRomaneio.fAtualizaQtdBaiDet(strNumDoc, strEspDoc, strCodCli,
  strCodEmp: String; blnPedOrc: Boolean; var strNumRom: String; strNomTab,
  strAutInc: String; strEntSai: String; strClaFis: String): Boolean;
Var
  cdsTmp : TUniClientDataSet;
  strIndice : String;
  strSQL : String;
  qryUpDate : TUniQuery;
  qryDet    : TUniQuery;
  strTabelaMovDet : String;
  strTabelaMovDetTri: String;
  dtaDtaDoc : TDate;
  blnJaFatu: Boolean;
  fltTotPes: Double;
  strQtdBai: String;
  fltQtdIte: Double;
  fltQtdBai: Double;
  fltPesLiq: Double;
  fltVolume: Double;
  blnChaveExiste: Boolean;
  blnDocTemItemRepetido: Boolean;
  strNumLot: string;
  strEmpOri: string;
  qryRomDetX: TUniQuery;

  strAutIncRomDetX  : String;
begin
  Result := True;

  cdsTmp     := TUniClientDataSet.Create(Self);
  qryUpDate  := fCriaQuery(Self);
  qryDet     := fCriaQuery(Self);
  qryRomDetX := fCriarQuery('SELECT * FROM ROMDETX WHERE FALSE');

  try
    qryRomDetX.Open;

    pCloneDataSet(cdsTmp, cdsRomDet);

    If (Pos(strOpcRom, '34') <= 0) Then
      strTabelaMovDet := fRetTabelaDet(strNomTab)
    Else
      strTabelaMovDet := AnsiReplaceStr(strNomTab, 'GER', 'DET');

    strTabelaMovDetTri := AnsiReplaceStr(strTabelaMovDet, 'DET', 'TRI');

    blnDocTemItemRepetido := fDocumentoTemItemRepetido(strNomTab, strNumDoc, strEspDoc, strCodEmp);

    cdsTmp.Filter   := '';
    cdsTmp.Filtered := False;
    cdsTmp.EmptyDataSet;

    strIndice := 'DET_CODITE;DET_DESITE;DET_NUMLOT';

    If fAgrupaPorAutoIncrem(strClaFis, blnDocTemItemRepetido) Then
      strIndice := strIndice + ';DET_AUTINC';

    cdsTmp.IndexFieldNames := strIndice;

    cdsRomDet.Filtered := False;
    cdsRomDet.Filter   :=                    '(DET_NUMDOC = ' + QuotedStr(strNumDoc) + ') AND ';
    cdsRomDet.Filter   := cdsRomDet.Filter + '(DET_ESPDOC = ' + QuotedStr(strEspDoc) + ') AND ';
    cdsRomDet.Filter   := cdsRomDet.Filter + '(DET_CODCLI = ' + QuotedStr(strCodCli) + ') AND ';
    cdsRomDet.Filter   := cdsRomDet.Filter + '(DET_CODEMP = ' + QuotedStr(strCodEmp) + ') AND ';
    cdsRomDet.Filter   := cdsRomDet.Filter + '(DET_ENTSAI = ' + QuotedStr(strEntSai) + ') ';
    cdsRomDet.Filtered := True;

    cdsRomDet.First;

    While Not cdsRomDet.Eof Do
    Begin
      If fAgrupaPorAutoIncrem(strClaFis, blnDocTemItemRepetido) Then
        blnChaveExiste := cdsTmp.FindKey([cdsRomDet.FieldByName('DET_CODITE').AsString, cdsRomDet.FieldByName('DET_DESITE').AsString, cdsRomDet.FieldByName('DET_NUMLOT').AsString, cdsRomDet.FieldByName('DET_AUTINC').AsString])
      Else
        blnChaveExiste := cdsTmp.FindKey([cdsRomDet.FieldByName('DET_CODITE').AsString, cdsRomDet.FieldByName('DET_DESITE').AsString, cdsRomDet.FieldByName('DET_NUMLOT').AsString]);

      If blnChaveExiste Then
      Begin
        cdsTmp.Edit;
        cdsTmp.FieldByName('DET_QTDBAI').AsFloat := cdsTmp.FieldByName('DET_QTDBAI').AsFloat + cdsRomDet.FieldByName('DET_QTDBAI').AsFloat;
        cdsTmp.FieldByName('DET_QTDITE').AsFloat := cdsTmp.FieldByName('DET_QTDITE').AsFloat + cdsRomDet.FieldByName('DET_QTDITE').AsFloat;
      End
      Else
      Begin
        cdsTmp.Append;
        cdsTmp.FieldByName('DET_CODITE').AsString := cdsRomDet.FieldByName('DET_CODITE').AsString;
        cdsTmp.FieldByName('DET_QTDBAI').AsFloat  := cdsRomDet.FieldByName('DET_QTDBAI').AsFloat;
        cdsTmp.FieldByName('DET_DESITE').AsString := cdsRomDet.FieldByName('DET_DESITE').AsString;
        cdsTmp.FieldByName('DET_NUMLOT').AsString := cdsRomDet.FieldByName('DET_NUMLOT').AsString;
        cdsTmp.FieldByName('DET_AUTINC').AsString := cdsRomDet.FieldByName('DET_AUTINC').AsString;
        cdsTmp.FieldByName('DET_AUTINC_DOCTRA').AsString := cdsRomDet.FieldByName('DET_AUTINC_DOCTRA').AsString;
        cdsTmp.FieldByName('DET_QTDITE').AsFloat  := cdsRomDet.FieldByName('DET_QTDITE').AsFloat;
        cdsTmp.FieldByName('DET_TOTPES').AsFloat  := cdsRomDet.FieldByName('DET_TOTPES').AsFloat;
        cdsTmp.FieldByName('DET_INFITE').AsString := cdsRomDet.FieldByName('DET_INFITE').AsString;
        cdsTmp.FieldByName('DET_SEPIMP').AsString := cdsRomDet.FieldByName('DET_SEPIMP').AsString;
        cdsTmp.FieldByName('DET_UNITAR').AsFloat  := cdsRomDet.FieldByName('DET_UNITAR').AsFloat;
      End;

      cdsTmp.Post;

      cdsRomDet.Next;
    End;

    strAutIncRomDetX := fRetAutoIncrem('ROMDETX', VS_strCodEmp, cdsTmp.RecordCount);

    qryUpDate.Close;
    qryUpDate.SQL.Clear;

    cdsTmp.First;

    While (Not cdsTmp.Eof) Do
    Begin
      If (cdsTmp.FieldByName('DET_QTDBAI').AsFloat <= 0) Then
      Begin
        cdsTmp.Next;
        Continue;
      End;

      If ((Pos(strOpcRom, '234') > 0) And (Not blnPedOrc)) Or (Not blnPedOrc) Then
      Begin
        strQtdBai := AnsiReplaceStr(FloatToStr(cdsTmp.FieldByName('DET_QTDBAI').AsFloat), ',', '.');

        qryDet.Close;
        qryDet.SQL.Clear;
        if not fEmptyStr(cdsTmpDoc.FieldByName('ROMTRA').AsString) then
        begin
          qryDet.SQL.Add(' SELECT ROMDETX.*, ');
          qryDet.SQL.Add('        I.ITE_EMBALA, ');
          qryDet.SQL.Add('        ROMDETX.DET_EMPORI AS DET_EMP_PD, ');
          qryDet.SQL.Add('        IFNULL(ROMDETX.DET_VALCBS, 0) AS REF_CBSVAL, IFNULL(ROMDETX.DET_VALIBS, 0) AS REF_VALIBS, IFNULL(ROMDETX.DET_VAL_IS, 0) AS REF_SELVAL ');
          qryDet.SQL.Add('   FROM ROMDETX ');
          qryDet.SQL.Add('   JOIN CADITE I ON I.ITE_CODITE = ROMDETX.DET_CODITE ');
          qryDet.SQL.Add('  WHERE ROMDETX.AUTOINCREM = :AUTINC ');
          qryDet.SQL.Add('    AND DET_NUMDOC = :NUMDOC ');
          qryDet.SQL.Add('    AND DET_ESPDOC = :ESPDOC ');
          qryDet.SQL.Add('    AND DET_CODCLI = :CODCLI ');
          qryDet.SQL.Add('    AND DET_CODEMP = :CODEMP ');
        end
        else
        begin
          qryDet.SQL.Add(' SELECT ');
          qryDet.SQL.Add('   ((DET_VLRCON / DET_QTDITE) * ' + strQtdBai + ') AS DET_VLRCON, ');
          qryDet.SQL.Add('   ((DET_TOTCUS / DET_QTDITE) * ' + strQtdBai + ') AS DET_TOTCUS, ');
          qryDet.SQL.Add('   ((DET_TOTMED / DET_QTDITE) * ' + strQtdBai + ') AS DET_TOTMED, ');
          qryDet.SQL.Add('   ((DET_TOTFRE / DET_QTDITE) * ' + strQtdBai + ') AS DET_TOTFRE, ');
          qryDet.SQL.Add('   ((DET_DESESP / DET_QTDITE) * ' + strQtdBai + ') AS DET_DESESP, ');
          qryDet.SQL.Add('   ((DET_VALIPI / DET_QTDITE) * ' + strQtdBai + ') AS DET_VALIPI, ');
          qryDet.SQL.Add('   ((DET_BASIPI / DET_QTDITE) * ' + strQtdBai + ') AS DET_BASIPI, ');
          qryDet.SQL.Add('   ((DET_VALICM / DET_QTDITE) * ' + strQtdBai + ') AS DET_VALICM, ');
          qryDet.SQL.Add('   ((DET_BASICM / DET_QTDITE) * ' + strQtdBai + ') AS DET_BASICM, ');
          qryDet.SQL.Add('   ((DET_VALRET / DET_QTDITE) * ' + strQtdBai + ') AS DET_VALRET, ');
          qryDet.SQL.Add('   ((DET_BASRET / DET_QTDITE) * ' + strQtdBai + ') AS DET_BASRET, ');
          qryDet.SQL.Add('   ((DET_TOTPES / DET_QTDITE) * ' + strQtdBai + ') AS DET_TOTPES, ');
          qryDet.SQL.Add('   ((DET_PESLIQ / DET_QTDITE) * ' + strQtdBai + ') AS DET_PESLIQ, ');
          qryDet.SQL.Add('   ((DET_DESACE / DET_QTDITE) * ' + strQtdBai + ') AS DET_DESACE, ');
          qryDet.SQL.Add(fSqlValoresReformaTributariaRomaneio(strTabelaMovDet, strTabelaMovDet, ' / ' + strTabelaMovDet + '.DET_QTDITE * ' + strQtdBai) + ', ');
          qryDet.SQL.Add(strTabelaMovDet + '.*, ');
          qryDet.SQL.Add('   I.ITE_EMBALA ');
          qryDet.SQL.Add('   FROM ' + strTabelaMovDet);
          qryDet.SQL.Add('   JOIN CADITE I ON I.ITE_CODITE = DET_CODITE ');
          qryDet.SQL.Add('   LEFT JOIN  ' + strTabelaMovDetTri + ' ON ' + strTabelaMovDet + '.AUTOINCREM = ' + strTabelaMovDetTri + '.DET_SEQGER');
          qryDet.SQL.Add('  WHERE ' + strTabelaMovDet + '.AUTOINCREM = :AUTINC ');
          qryDet.SQL.Add('    AND DET_NUMDOC = :NUMDOC ');
          qryDet.SQL.Add('    AND DET_ESPDOC = :ESPDOC ');
          qryDet.SQL.Add('    AND DET_CODCLI = :CODCLI ');
          qryDet.SQL.Add('    AND DET_CODEMP = :CODEMP ');
        end;

        qryDet.ParamByName('AUTINC').AsString := IIF(fEhTransbordo(cdsTmpDoc),
                                                     cdsTmp.FieldByName('DET_AUTINC_DOCTRA').AsString,
                                                     cdsTmp.FieldByName('DET_AUTINC').AsString);
        qryDet.ParamByName('NUMDOC').AsString := strNumDoc;
        qryDet.ParamByName('ESPDOC').AsString := strEspDoc;
        qryDet.ParamByName('CODCLI').AsString := strCodCli;
        qryDet.ParamByName('CODEMP').AsString := strCodEmp;

        qryDet.Open;

        If Assigned(qryDet.FindField('DET_EMP_PD')) Then
          strEmpOri := qryDet.FieldByName('DET_EMP_PD').AsString
        Else
          strEmpOri := fCampoTabela('DET_EMP_PD', 'MOVDET', ['DET_NUMDOC','DET_ESPDOC','DET_CODEMP','DET_CODCLI','DET_CODITE'], [qryDet.FieldByName('DET_NUMDOC').AsString, qryDet.FieldByName('DET_ESPDOC').AsString, qryDet.FieldByName('DET_CODEMP').AsString, qryDet.FieldByName('DET_CODCLI').AsString, qryDet.FieldByName('DET_CODITE').AsString], False);

        if fEmptyStr(cdsTmpDoc.FieldByName('ROMTRA').AsString) then
        begin
          strSQL := '';
          strSQL := strSQL + 'UPDATE  ';
          strSQL := strSQL + '  ' + strTabelaMovDet + ' ';
          strSQL := strSQL + 'SET ';
          strSQL := strSQL + '  DET_QTDROM = IFNULL(DET_QTDROM, 0) + ' + AnsiReplaceStr(FloatToStr(cdsTmp.FieldByName('DET_QTDBAI').AsFloat), ',', '.') + ' ';
          strSQL := strSQL + 'WHERE ';
          strSQL := strSQL + '  AUTOINCREM = ' + cdsTmp.FieldByName('DET_AUTINC').AsString.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_NUMDOC = ' + strNumDoc.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_ESPDOC = ' + strEspDoc.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_CODCLI = ' + strCodCli.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_CODEMP = ' + strCodEmp.QuotedString + '; ';

          qryUpDate.SQL.Add(strSQL);

          if fGravacaoEmLote then
            FTemporariaDocumentosRomaneio.fInserirDocRomInvalido(FTabTmpRomInvalido,
                                                                 strTabelaMovDet,
                                                                 strNumDoc,
                                                                 strEspDoc,
                                                                 strCodEmp,
                                                                 cdsTmp.FieldByName('DET_AUTINC').AsString,
                                                                 strCodCli,
                                                                 cdsTmp.FieldByName('DET_CODITE').AsString,
                                                                 cdsTmp.FieldByName('DET_QTDBAI').AsFloat)
          else if fQtdeRomInvalido(cdsTmp.FieldByName('DET_CODITE').AsString,
                                   strNumDoc,
                                   strEspDoc,
                                   strCodCli,
                                   strCodEmp,
                                   strTabelaMovDet,
                                   cdsTmp.FieldByName('DET_AUTINC').AsString,
                                   cdsTmp.FieldByName('DET_QTDBAI').AsFloat) Then
          Begin
            Result := False;
            Exit;
          End;
        end;

        If strOpcRom = '2' Then
          dtaDtaDoc := qryDet.FieldByName('DET_DTADOC').AsDateTime
        Else
          dtaDtaDoc := qryDet.FieldByName('DET_DTAENT').AsDateTime;

        If qryDet.FieldByName('DET_JAFATU').DataType = ftInteger Then
          blnJaFatu := IIF(qryDet.FieldByName('DET_JAFATU').AsInteger = 1, True, False)
        Else
          blnJaFatu := qryDet.FieldByName('DET_JAFATU').AsBoolean;

        fltVolume := fRetVolumeItem(qryDet.FieldByName('DET_CODITE').AsString, cdsTmp.FieldByName('DET_QTDITE').AsFloat, qryDet.FieldByName('ITE_EMBALA').AsFloat);

        If (qryDet.FieldByName('DET_NUMLOT').AsString = 'A DEFINIR') And fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis Then
        Begin
          strNumLot := fRetNumLotItemRastravel(qryDet.FieldByName('DET_CODITE').AsString,
                                               qryDet.FieldByName('DET_NUMLOT').AsString,
                                               qryDet.FieldByName('DET_CODEMP').AsString,
                                               cdsTmp.FieldByName('DET_QTDITE').AsFloat);
        End
        Else
          strNumLot := qryDet.FieldByName('DET_NUMLOT').AsString;

        Result := fGravaRomDet(strNumRom,                                   // Romaneio
                               strAutInc,                                   // Sequencial do Arquivo Geral
                               qryDet.FieldByName('DET_NUMDOC').AsString,   // Numero do Documento
                               qryDet.FieldByName('DET_ESPDOC').AsString,   // Espécie
                               qryDet.FieldByName('DET_CODEMP').AsString,   // Empresa
                               qryDet.FieldByName('DET_CODITE').AsString,   // Cód. Item
                               qryDet.FieldByName('DET_CODVEN').AsString,   // Vendedor
                               qryDet.FieldByName('DET_CODDIV').AsString,   // Código Diversos
                               qryDet.FieldByName('DET_CODMAR').AsString,   // Código da Marca
                               qryDet.FieldByName('DET_CODFOR').AsString,   // Fornecedor
                               qryDet.FieldByName('DET_CODCLI').AsString,   // Cliente
                               qryDet.FieldByName('DET_DTAENT').AsDateTime, // Data da Entrada
                               qryDet.FieldByName('DET_HORENT').AsDateTime, // Hora da Entrada
                               dtaDtaDoc,                                   // Data do Documento
                               qryDet.FieldByName('DET_CONPAG').AsString,   // Condição de Pagamento
                               qryDet.FieldByName('DET_TIP_FC').AsString,   // Tipo: (C)liente / (F) Fornecedor
                               qryDet.FieldByName('DET_ESTADO').AsString,   // Estado do Fornecedor
                               qryDet.FieldByName('DET_DESCRI').AsString,   // Descrição do Item
                               qryDet.FieldByName('DET_REFERE').AsString,   // Referência do Item
                               qryDet.FieldByName('DET_UNIDAD').AsString,   // Cód. Unidade
                               qryDet.FieldByName('DET_FORITE').AsString,   // Fornecedor Item
                               cdsTmp.FieldByName('DET_QTDITE').AsFloat,    // Quantidade do Item
                               qryDet.FieldByName('DET_UNITAR').AsFloat,    // Valor Unitario
                               qryDet.FieldByName('DET_UNIORI').AsFloat,    // Valor Unitário Original
                               fFormataFloat(cdsTmp.FieldByName('DET_UNITAR').AsFloat * cdsTmp.FieldByName('DET_QTDBAI').AsFloat, 2), // Total do Item
                               qryDet.FieldByName('DET_VLRCON').AsFloat,    // Valor Contábil do Item
                               qryDet.FieldByName('DET_TOTCUS').AsFloat,    // Valor Total de Custo
                               qryDet.FieldByName('DET_TOTMED').AsFloat,    // Valor Total Medio
                               qryDet.FieldByName('DET_DESCON').AsFloat,    // % Desconto do Item
                               qryDet.FieldByName('DET_TOTFRE').AsFloat,    // Valor do Frete
                               qryDet.FieldByName('DET_DESESP').AsFloat,    // Valor do Desconto Especial
                               qryDet.FieldByName('DET_CODREP').AsString,   // Código do Representante
                               qryDet.FieldByName('DET_PERCOM').AsFloat,    // Percentual de Comissão do Vendedor
                               qryDet.FieldByName('DET_TOTCOM').AsFloat,    // Total de Comissão do Vendedor
                               qryDet.FieldByName('DET_CLAFIS').AsString,   // Classificação Fiscal
                               qryDet.FieldByName('DET_CODFIS').AsString,   // Código Fiscal
                               qryDet.FieldByName('DET_VALIPI').AsFloat,    // Valor IPI
                               qryDet.FieldByName('DET_ALQIPI').AsFloat,    // Aliquota IPI
                               qryDet.FieldByName('DET_BASIPI').AsFloat,    // Base IPI
                               qryDet.FieldByName('DET_VALICM').AsFloat,    // Valor de ICMS
                               qryDet.FieldByName('DET_ALQICM').AsFloat,    // Aliquota de ICMS
                               qryDet.FieldByName('DET_BASICM').AsFloat,    // Base de ICMS
                               qryDet.FieldByName('DET_VALRET').AsFloat,    // Valor de Substituição
                               qryDet.FieldByName('DET_ALQRET').AsFloat,    // Aliquota de Substituição
                               qryDet.FieldByName('DET_BASRET').AsFloat,    // Base de Substituição
                               qryDet.FieldByName('DET_TOTPES').AsFloat,    // Total de Peso
                               qryDet.FieldByName('DET_PERBAS').AsFloat,    // Percentual de Base de ICMS
                               qryDet.FieldByName('DET_PERRED').AsFloat,    // Percentual de Redução de Base
                               blnJaFatu,  // Indica se ja esta Faturado
                               qryDet.FieldByName('DET_TIPFAT').AsString,   // Tipo de Faturamento
                               qryDet.FieldByName('DET_NUMFAT').AsString,   // Número do Faturamento
                               qryDet.FieldByName('DET_DTAFAT').AsDateTime, // Data do Faturamento
                               qryDet.FieldByName('DET_VENFAT').AsString,   // Vendedor do Faturamento
                               qryDet.FieldByName('DET_CNDFAT').AsString,   // Condição de Pagamento Faturamento
                               qryDet.FieldByName('DET_VALFAT').AsFloat,    // Valor do Faturamento
                               qryDet.FieldByName('DET_IDEPRO').AsString,   // Identificação Produto ( Normal / Outros )
                               qryDet.FieldByName('DET_INCPIS').AsString,   // Indice se incide Pis
                               qryDet.FieldByName('DET_SERIE_').AsString,   // Série
                               qryDet.FieldByName('DET_DESACE').AsFloat,    // Valor de Despesa Acessória
                               qryDet.FieldByName('DET_NOTESP').AsString,   // Nota Especial
                               qryDet.FieldByName('DET_DOCDEV').AsString,   // Documento da Devolução
                               qryDet.FieldByName('DET_ESPDEV').AsString,   // Espécie da Devolução
                               qryDet.FieldByName('DET_EMPDEV').AsString,   // Empresa da Devolução
                               qryDet.FieldByName('DET_ITECHA').AsString,   // Item de Chamada (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_ITETIN').AsString,   // Item da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_DESCOR').AsString,   // Descrição da Cor (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_TIPEMB').AsString,   // Tipo de Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_QTDEMB').AsFloat,    // Quantidade de Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_PREEMB').AsFloat,    // Preço da Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_TIPPRE').AsString,   // Tipo de Preço (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_PRVTIN').AsFloat,    // Preço de Venda da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_PRCTIN').AsFloat,    // Preço de Compra da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_FATTIN').AsFloat,    // Fator da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_PROEMB').AsString,   // Produto Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('DET_CODDIG').AsString,   // Código do Digitador
                               qryDet.FieldByName('DET_CODCND').AsString,   // Codigo da Condição
                               qryDet.FieldByName('DET_CODFPG').AsString,   // Forma de Pagamento
                               cdsTmp.FieldByName('DET_QTDBAI').AsFloat,    // Quantidade Baixada   ****
                               cdsTmp.FieldByName('DET_INFITE').AsString,   // Informações do item  ****
                               cdsTmp.FieldByName('DET_SEPIMP').AsString,   // Separacao Impressa (S/N)
                               cdsTmp.FieldByName('DET_AUTINC').AsString,   // Autoincremento do movdet ****
                               strNumLot,                                   // NUMERO DO LOTE
                               qryDet.FieldByName('DET_PESLIQ').AsFloat,    // Peso liquido
                               fltVolume,                                   // Volume do item
                               qryDet.FieldByName('REF_CBSVAL').AsFloat,    // Valor CBS
                               qryDet.FieldByName('REF_VALIBS').AsFloat,    // Valor IBS
                               qryDet.FieldByName('REF_SELVAL').AsFloat,    // Valor IS
                               strEmpOri,                                   // Empresa Origem
                               qryRomDetX,                                  // Query
                               FInsertsInBatchRomDetx,
                               strAutIncRomDetX);

        If Result Then
          objAuditRomaneio.Adicionar(strAutIncRomDetX, 'ROMDETX');
      End
      Else
      Begin
        qryDet.Close;
        qryDet.SQL.Clear;

        qryDet.SQL.Add(' SELECT FATDOR.*, EXTDOR.FDO_PESLIQ, I.ITE_EMBALA, ');
        qryDet.SQL.Add(fSqlValoresReformaTributariaRomaneio('FATDOR', 'FATDOR'));
        qryDet.SQL.Add('   FROM FATDOR ');
        qryDet.SQL.Add('   JOIN CADITE I ON I.ITE_CODITE = FDO_CODITE ');
        qryDet.SQL.Add('   LEFT JOIN EXTDOR ON FDO_SEQFDO = FATDOR.AUTOINCREM ');
        qryDet.SQL.Add('  WHERE FATDOR.AUTOINCREM = :AUTINC ');
        qryDet.SQL.Add('    AND FDO_NUMDOC = :NUMDOC ');
        qryDet.SQL.Add('    AND FDO_ESPDOC = :ESPDOC ');
        qryDet.SQL.Add('    AND FDO_CODCLI = :CODCLI ');
        qryDet.SQL.Add('    AND FDO_CODEMP = :CODEMP ');

        qryDet.ParamByName('AUTINC').AsString := IIF(fEhTransbordo(cdsTmpDoc),
                                                     cdsTmp.FieldByName('DET_AUTINC_DOCTRA').AsString,
                                                     cdsTmp.FieldByName('DET_AUTINC').AsString);
        qryDet.ParamByName('NUMDOC').AsString := strNumDoc;
        qryDet.ParamByName('ESPDOC').AsString := strEspDoc;
        qryDet.ParamByName('CODCLI').AsString := strCodCli;
        qryDet.ParamByName('CODEMP').AsString := strCodEmp;
        qryDet.Open;

        strSQL := '';
        strSQL := strSQL + 'UPDATE  ';
        strSQL := strSQL + '  FATDOR ';
        strSQL := strSQL + 'SET ';
        strSQL := strSQL + '  FDO_QTDROM = IFNULL(FDO_QTDROM, 0) + ' +  AnsiReplaceStr(FloatToStr(cdsTmp.FieldByName('DET_QTDBAI').AsFloat), ',', '.') + ' ';
        strSQL := strSQL + 'WHERE ';

        If fEhTransbordo(cdsTmpDoc) Then
          strSQL := strSQL + '  AUTOINCREM = ' + cdsTmp.FieldByName('DET_AUTINC_DOCTRA').AsString.QuotedString + ' AND '
        Else
          strSQL := strSQL + '  AUTOINCREM = ' + cdsTmp.FieldByName('DET_AUTINC').AsString.QuotedString + ' AND ';

        strSQL := strSQL + '  FDO_NUMDOC = ' + strNumDoc.QuotedString + ' AND ';
        strSQL := strSQL + '  FDO_ESPDOC = ' + strEspDoc.QuotedString + ' AND ';
        strSQL := strSQL + '  FDO_CODCLI = ' + strCodCli.QuotedString + ' AND ';
        strSQL := strSQL + '  FDO_CODEMP = ' + strCodEmp.QuotedString + '; ';

        qryUpDate.SQL.Add(strSQL);

        if fGravacaoEmLote then
            FTemporariaDocumentosRomaneio.fInserirDocRomInvalido(FTabTmpRomInvalido,
                                                                 strTabelaMovDet,
                                                                 strNumDoc,
                                                                 strEspDoc,
                                                                 strCodEmp,
                                                                 cdsTmp.FieldByName('DET_AUTINC').AsString,
                                                                 strCodCli,
                                                                 cdsTmp.FieldByName('DET_CODITE').AsString,
                                                                 cdsTmp.FieldByName('DET_QTDBAI').AsFloat)
        else if fQtdeRomInvalido(cdsTmp.FieldByName('DET_CODITE').AsString,
                                 strNumDoc,
                                 strEspDoc,
                                 strCodCli,
                                 strCodEmp,
                                 'FATDOR',
                                 cdsTmp.FieldByName('DET_AUTINC').AsString,
                                 cdsTmp.FieldByName('DET_QTDBAI').AsFloat) Then
        Begin
          Result := False;
          Exit;
        End;

        {***********************************************}
        {* SE ENTRA TROCA E BRINDE NO ROMANEIO EXECUTA *}
        {* UPDATE DO QTDROM NA MOVDET TAMBÉM          *}
        {********************************************AL*}
        If (fCfgSis('TRBRRO', varBoolean)) Then
        Begin
          strSQL := '';
          strSQL := strSQL + 'UPDATE  ';
          strSQL := strSQL + '  MOVDET ';
          strSQL := strSQL + 'SET ';
          strSQL := strSQL + '  DET_QTDROM = IFNULL(DET_QTDROM, 0) + ' + AnsiReplaceStr(FloatToStr(cdsTmp.FieldByName('DET_QTDBAI').AsFloat), ',', '.') + ' ';
          strSQL := strSQL + 'WHERE ';

          If fEhTransbordo(cdsTmpDoc) Then
            strSQL := strSQL + '  AUTOINCREM = ' + cdsTmp.FieldByName('DET_AUTINC_DOCTRA').AsString.QuotedString + ' AND '
          Else
            strSQL := strSQL + '  AUTOINCREM = ' + cdsTmp.FieldByName('DET_AUTINC').AsString.QuotedString + ' AND ';

          strSQL := strSQL + '  DET_NUMDOC = ' + strNumDoc.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_ESPDOC = ' + strEspDoc.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_CODCLI = ' + strCodCli.QuotedString + ' AND ';
          strSQL := strSQL + '  DET_CODEMP = ' + strCodEmp.QuotedString + '; ';

          qryUpDate.SQL.Add(strSQL);
        End;

        fltTotPes := qryDet.FieldByName('FDO_TOTPES').AsFloat / qryDet.FieldByName('FDO_QTDITE').AsFloat * cdsTmp.FieldByName('DET_QTDBAI').AsFloat;
        fltPesLiq := qryDet.FieldByName('FDO_PESLIQ').AsFloat / qryDet.FieldByName('FDO_QTDITE').AsFloat * cdsTmp.FieldByName('DET_QTDBAI').AsFloat;

        if fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean) then
        begin
          fltQtdIte := cdsTmp.FieldByName('DET_QTDBAI').AsFloat;
          fltQtdBai := 0;
        end
        else
        begin
          fltQtdIte := cdsTmp.FieldByName('DET_QTDITE').AsFloat;
          fltQtdBai := cdsTmp.FieldByName('DET_QTDBAI').AsFloat;
        end;

        If (qryDet.FieldByName('FDO_NUMLOT').AsString = 'A DEFINIR') And fQuandoWMSPermitirAlterarLoteDeProdutosRastreaveis Then
        Begin
          strNumLot := fRetNumLotItemRastravel(qryDet.FieldByName('FDO_CODITE').AsString,
                                               qryDet.FieldByName('FDO_NUMLOT').AsString,
                                               qryDet.FieldByName('FDO_CODEMP').AsString,
                                               fltQtdIte);

        End
        Else
          strNumLot := qryDet.FieldByName('FDO_NUMLOT').AsString;

        fltVolume := fRetVolumeItem(qryDet.FieldByName('FDO_CODITE').AsString, fltQtdIte, qryDet.FieldByName('ITE_EMBALA').AsFloat);

        Result := fGravaRomDet(strNumRom,                                   // Romaneio
                               strAutInc,                                   // Sequencial do Arquivo Geral
                               qryDet.FieldByName('FDO_NUMDOC').AsString,   // Numero do Documento
                               qryDet.FieldByName('FDO_ESPDOC').AsString,   // Espécie
                               qryDet.FieldByName('FDO_CODEMP').AsString,   // Empresa
                               qryDet.FieldByName('FDO_CODITE').AsString,   // Cód. Item
                               qryDet.FieldByName('FDO_CODVEN').AsString,   // Vendedor
                               qryDet.FieldByName('FDO_CODDIV').AsString,   // Código Diversos
                               qryDet.FieldByName('FDO_CODMAR').AsString,   // Código da Marca
                               '',                                          // Fornecedor
                               qryDet.FieldByName('FDO_CODCLI').AsString,   // Cliente
                               qryDet.FieldByName('FDO_DTAENT').AsDateTime, // Data da Entrada
                               qryDet.FieldByName('FDO_HORENT').AsDateTime, // Hora da Entrada
                               0,                                           // Data do Documento
                               qryDet.FieldByName('FDO_CONPAG').AsString,   // Condição de Pagamento
                               'C',                                         // Tipo: (C)liente / (F) Fornecedor
                               '',                                          // Estado do Fornecedor
                               qryDet.FieldByName('FDO_DESCRI').AsString,   // Descrição do Item
                               qryDet.FieldByName('FDO_REFERE').AsString,   // Referência do Item
                               qryDet.FieldByName('FDO_UNIDAD').AsString,   // Cód. Unidade
                               qryDet.FieldByName('FDO_FORITE').AsString,   // Fornecedor Item
                               fltQtdIte,                                   // Quantidade do Item
                               qryDet.FieldByName('FDO_UNITAR').AsFloat,    // Valor Unitario
                               qryDet.FieldByName('FDO_UNIORI').AsFloat,    // Valor Unitário Original
                               fFormataFloat(cdsTmp.FieldByName('DET_UNITAR').AsFloat * cdsTmp.FieldByName('DET_QTDBAI').AsFloat, 2), // Total do Item
                               qryDet.FieldByName('FDO_VLRCON').AsFloat,    // Valor Contábil do Item
                               qryDet.FieldByName('FDO_TOTCUS').AsFloat,    // Valor Total de Custo
                               qryDet.FieldByName('FDO_TOTMED').AsFloat,    // Valor Total Medio
                               qryDet.FieldByName('FDO_DESCON').AsFloat,    // % Desconto do Item
                               qryDet.FieldByName('FDO_TOTFRE').AsFloat,    // Valor do Frete
                               qryDet.FieldByName('FDO_DESESP').AsFloat,    // Valor do Desconto Especial
                               qryDet.FieldByName('FDO_CODREP').AsString,   // Código do Representante
                               qryDet.FieldByName('FDO_PERCOM').AsFloat,    // Percentual de Comissão do Vendedor
                               qryDet.FieldByName('FDO_TOTCOM').AsFloat,    // Total de Comissão do Vendedor
                               qryDet.FieldByName('FDO_CLAFIS').AsString,   // Classificação Fiscal
                               qryDet.FieldByName('FDO_CODFIS').AsString,   // Código Fiscal
                               qryDet.FieldByName('FDO_VALIPI').AsFloat,    // Valor IPI
                               qryDet.FieldByName('FDO_ALQIPI').AsFloat,    // Aliquota IPI
                               qryDet.FieldByName('FDO_BASIPI').AsFloat,    // Base IPI
                               qryDet.FieldByName('FDO_VALICM').AsFloat,    // Valor de ICMS
                               qryDet.FieldByName('FDO_ALQICM').AsFloat,    // Aliquota de ICMS
                               qryDet.FieldByName('FDO_BASICM').AsFloat,    // Base de ICMS
                               qryDet.FieldByName('FDO_VALRET').AsFloat,    // Valor de Substituição
                               qryDet.FieldByName('FDO_ALQRET').AsFloat,    // Aliquota de Substituição
                               qryDet.FieldByName('FDO_BASRET').AsFloat,    // Base de Substituição
                               fltTotPes,                                   // Total de Peso
                               qryDet.FieldByName('FDO_PERBAS').AsFloat,    // Percentual de Base de ICMS
                               qryDet.FieldByName('FDO_PERRED').AsFloat,    // Percentual de Redução de Base
                               IIF(qryDet.FieldByName('FDO_JAFATU').AsInteger = 1, True, False),  // Indica se ja esta Faturado
                               qryDet.FieldByName('FDO_TIPFAT').AsString,   // Tipo de Faturamento
                               qryDet.FieldByName('FDO_NUMFAT').AsString,   // Número do Faturamento
                               qryDet.FieldByName('FDO_DTAFAT').AsDateTime, // Data do Faturamento
                               qryDet.FieldByName('FDO_VENFAT').AsString,   // Vendedor do Faturamento
                               qryDet.FieldByName('FDO_CNDFAT').AsString,   // Condição de Pagamento Faturamento
                               qryDet.FieldByName('FDO_VALFAT').AsFloat,    // Valor do Faturamento
                               qryDet.FieldByName('FDO_IDEPRO').AsString,   // Identificação Produto ( Normal / Outros )
                               qryDet.FieldByName('FDO_INCPIS').AsString,   // Indice se incide Pis
                               qryDet.FieldByName('FDO_SERIE_').AsString,   // Série
                               qryDet.FieldByName('FDO_DESACE').AsFloat,    // Valor de Despesa Acessória
                               '',                                          // Nota Especial
                               '',                                          // Documento da Devolução
                               '',                                          // Espécie da Devolução
                               '',                                          // Empresa da Devolução
                               qryDet.FieldByName('FDO_ITECHA').AsString,   // Item de Chamada (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_ITETIN').AsString,   // Item da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_DESCOR').AsString,   // Descrição da Cor (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_TIPEMB').AsString,   // Tipo de Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_QTDEMB').AsFloat,    // Quantidade de Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_PREEMB').AsFloat,    // Preço da Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_TIPPRE').AsString,   // Tipo de Preço (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_PRVTIN').AsFloat,    // Preço de Venda da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_PRCTIN').AsFloat,    // Preço de Compra da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_FATTIN').AsFloat,    // Fator da Tinta (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_PROEMB').AsString,   // Produto Embalagem (TINTA DE MAQUINA)
                               qryDet.FieldByName('FDO_CODDIG').AsString,   // Código do Digitador
                               qryDet.FieldByName('FDO_CODCND').AsString,   // Codigo da Condição
                               qryDet.FieldByName('FDO_CODFPG').AsString,   // Forma de Pagamento
                               fltQtdBai,                                   // Quantidade de Baixa ********
                               cdsTmp.FieldByName('DET_INFITE').AsString,   // Informações do item ********
                               cdsTmp.FieldByName('DET_SEPIMP').AsString,   // Separacao Impressa (S/N)
                               cdsTmp.FieldByName('DET_AUTINC').AsString,   // Autoincremento do fatdor *******
                               strNumLot,                                   // NUMERO DO LOTE
                               fltPesLiq,                                   // Peso Liquido
                               fltVolume,                                   // Volume do item
                               qryDet.FieldByName('REF_CBSVAL').AsFloat,    // Valor CBS
                               qryDet.FieldByName('REF_VALIBS').AsFloat,    // Valor IBS
                               qryDet.FieldByName('REF_SELVAL').AsFloat,    // Valor IS
                               '',                                          // Empresa Origem
                               qryRomDetX,                                  // Query
                               FInsertsInBatchRomDetx,
                               strAutIncRomDetX);

        If Result Then
          objAuditRomaneio.Adicionar(strAutIncRomDetX, 'ROMDETX');

        If ((VS_strTipExp = '5') And (fCfgSis('USPRRO', varBoolean))) Then
        Begin
          qryDet.Close;
          qryDet.SQL.Clear;
          qryDet.SQL.Add(' SELECT FDO_CODITE, FDO_QTDITE, FDO_QTDROM ');
          qryDet.SQL.Add('   FROM FATDOR ');
          qryDet.SQL.Add('  WHERE AUTOINCREM = :AUTINC ');
          qryDet.SQL.Add('    AND FDO_NUMDOC = :NUMDOC ');
          qryDet.SQL.Add('    AND FDO_ESPDOC = :ESPDOC ');
          qryDet.SQL.Add('    AND FDO_CODCLI = :CODCLI ');
          qryDet.SQL.Add('    AND FDO_CODEMP = :CODEMP ');

          qryDet.ParamByName('AUTINC').AsString := IIF(fEhTransbordo(cdsTmpDoc),
                                                       cdsTmp.FieldByName('DET_AUTINC_DOCTRA').AsString,
                                                       cdsTmp.FieldByName('DET_AUTINC').AsString);;
          qryDet.ParamByName('NUMDOC').AsString := strNumDoc;
          qryDet.ParamByName('ESPDOC').AsString := strEspDoc;
          qryDet.ParamByName('CODCLI').AsString := strCodCli;
          qryDet.ParamByName('CODEMP').AsString := strCodEmp;
          qryDet.Open;

          If (fFormataFloat(qryDet.FieldByName('FDO_QTDROM').AsFloat,4) > fFormataFloat(qryDet.FieldByName('FDO_QTDITE').AsFloat,4)) Then
          Begin
            strDocFicouComFdoQtdRomMaiorFdoQtdIte := strNumDoc +'-'+ strEspDoc +'-'+ strCodEmp +', item: '+ qryDet.FieldByName('FDO_CODITE').AsString;
            Result := False;
          End;
        End;
      End;

      If (Not Result) Then
        Break;

      strAutIncRomDetX := fNextAutoIncrem(strAutIncRomDetX);
      cdsTmp.Next;
    End;

    If (qryUpDate.SQL.Count > 0) Then
      qryUpDate.ExecSQL;
  finally
    FreeAndNil(qryRomDetX);
    FreeAndNil(qryDet);
    FreeAndNil(qryUpDate);
    FreeAndNil(cdsTmp);
  end;
end;

function TfrmFatRomaneio.fBaixaTransbordoEmLote: Boolean;
var
  LAutInc: String;
begin
  Result := True;

  for LAutInc in FListRomTra do
  begin
    if (not Result) then
      Exit;

    if fTodosItensDoTransbordoForamRomaneados(LAutInc) then
      Result := fBaixaTransbordo(LAutInc);
  end;
end;

procedure TfrmFatRomaneio.pOnMarcaDesmarcaDocumento;
begin
  if (cdsTmpDoc.FieldByName('GER_MARDES').OldValue <> cdsTmpDoc.FieldByName('GER_MARDES').NewValue) then
  begin
    if AnsiMatchStr(cdsTmpDoc.FieldByName('GER_MARDES').NewValue, ['M', 'P']) then
    begin
      if (fCfgSis('RMPDAV', varInteger) > 0) then
      Begin
        If Not blnExibiuAvisoDocto Then
        Begin
          pVerificaDocumentosCliente;
          blnExibiuAvisoDocto := True;
        End;
      End;
    end;
  end;
end;

function TfrmFatRomaneio.fCarregaTransMot(ANumVeiculo: String; var LTransMot: TDadosTransMot): Boolean;
var
  frmFatRomTransMot: TfrmFatRomTransMot;
begin
  if (fEmptyStr(ANumVeiculo)) then
  Begin
    {************************************************************}
    {* SE USA PRÉ ROMANEIO, NÃO DEVE PEDIR DADOS DE TRANSPORTE, *}
    {* POIS SERÃO PREENCHIDOS SOMENTE NA ATIVAÇÃO DO ROMANEIO   *}
    {*********************************************************MM*}
    if (not blnUsaPreRom) and (not fEhRomaneioSimplificado) then
    begin
      {*******************************************}
      {* TELA DA TRANSPORTADORA / MOTORISTA      *}
      {****************************************MV*}
      pCriarFormularios(TfrmFatRomTransMot, frmFatRomTransMot);

      try
        try
          cdsTmpDoc.EnableControls;
          cdsTmpDoc.OnFilterRecord := nil;

          if fEmptyStr(LTransMot.strCodTra) then
            LTransMot.strCodTra := fRetornaTransportadoraSugestao;

          frmFatRomTransMot.cdsTmpDoc      := cdsTmpDoc;
          frmFatRomTransMot.cdsOutDig      := FOutDig;
          frmFatRomTransMot.edtCodTra.Text := IIF(fEmptyStr(recTranporte.strTransportadora), IIF( fEmptyStr(strDocCaixaTrans), LTransMot.strCodTra, strDocCaixaTrans ), recTranporte.strTransportadora);
          frmFatRomTransMot.edtCodMot.Text := IIF(fEmptyStr(recTranporte.strMotorista), LTransMot.strCodMot, recTranporte.strMotorista);
          frmFatRomTransMot.edtCodAj1.Text := LTransMot.strCodAj1;
          frmFatRomTransMot.edtCodAj2.Text := LTransMot.strCodAj2;
          frmFatRomTransMot.edtCodAj3.Text := LTransMot.strCodAj3;
          frmFatRomTransMot.edtCodAj4.Text := LTransMot.strCodAj4;
          frmFatRomTransMot.mmoObsFec.Text := LTransMot.strObsFec;
          frmFatRomTransMot.mskPlaVei.Text := IIF(fEmptyStr(recTranporte.strPlacaVeiculo), LTransMot.strPlaVei, recTranporte.strPlacaVeiculo);
          frmFatRomTransMot.edtDesVei.Text := IIF(fEmptyStr(recTranporte.strPlacaVeiculo), frmFatRomTransMot.edtDesVei.Text, fRetornaDescricaoVeic(recTranporte.strPlacaVeiculo));
          frmFatRomTransMot.edtCodReg.Text := LTransMot.strCodReg;
          frmFatRomTransMot.strCodRom      := edtNumRom.Text;
          frmFatRomTransMot.fltTotDoc      := fStrToFloat(edtTotSel.Text);
          frmFatRomTransMot.edtVlrFrete.Text  := FloatToStrF(fltVlrFre, ffFixed, 12, 2);
          frmFatRomTransMot.edtVlrAdiant.Text := FloatToStrF(fltVlrAdi, ffFixed, 12, 2);
          frmFatRomTransMot.edtPercFrete.Text := FloatToStrF(fltPerFre, ffFixed, 12, 4);
          frmFatRomTransMot.cdsRomRet := cdsRomRet;
          frmFatRomTransMot.strIntFus := FstrIntFus;

          if (not fEmptyStr(strDocCaixaTrans)) then
          begin
            frmFatRomTransMot.edtCodTra.Enabled := False;
            frmFatRomTransMot.edtCodTra.Color   := $00FFDFB8;
          end;

          Result := (frmFatRomTransMot.ShowModal = mrOk);

          cdsTmpDoc.DisableControls;

          if (Result) then
          begin
            LTransMot.strCodTra := frmFatRomTransMot.edtCodTra.Text;
            LTransMot.strCodMot := frmFatRomTransMot.edtCodMot.Text;
            LTransMot.strCodAj1 := frmFatRomTransMot.edtCodAj1.Text;
            LTransMot.strCodAj2 := frmFatRomTransMot.edtCodAj2.Text;
            LTransMot.strCodAj3 := frmFatRomTransMot.edtCodAj3.Text;
            LTransMot.strCodAj4 := frmFatRomTransMot.edtCodAj4.Text;
            LTransMot.strObsFec := frmFatRomTransMot.mmoObsFec.Text;
            LTransMot.strPlaVei := fTiraCaracEspeciais(frmFatRomTransMot.mskPlaVei.Text);
            LTransMot.strCodReg := frmFatRomTransMot.edtCodReg.Text;
            fltVlrFre := fStrToFloat(frmFatRomTransMot.edtVlrFrete.Text);
            fltVlrAdi := fStrToFloat(frmFatRomTransMot.edtVlrAdiant.Text);
            fltPerFre := fStrToFloat(frmFatRomTransMot.edtPercFrete.Text);
            strDefCon := frmFatRomTransMot.strDefCon;
          end
          else
          begin
            if fCfgSis('MATDIS', varBoolean) then
            begin
              try
                cdsTmpDoc.Filtered := False;

                cdsTmpDoc.Filter := 'TRIM(BKP_ENDCON) <> '+QuotedStr('')+' OR '+
                                    'TRIM(BKP_BAIRRO) <> '+QuotedStr('')+' OR '+
                                    'TRIM(BKP_NOMCID) <> '+QuotedStr('')+' OR '+
                                    'TRIM(BKP_ESTADO) <> '+QuotedStr('')+' OR '+
                                    'TRIM(BKP_CEPCON) <> '+QuotedStr('');

                cdsTmpDoc.Filtered := True;

                cdsTmpDoc.First;

                while not cdsTmpDoc.Eof do
                begin
                  cdsTmpDoc.Edit;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_ENDCON').AsString) then
                    cdsTmpDoc.FieldByName('GER_ENDCON').AsString := cdsTmpDoc.FieldByName('BKP_ENDCON').AsString;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_BAIRRO').AsString) then
                    cdsTmpDoc.FieldByName('GER_BAIRRO').AsString := cdsTmpDoc.FieldByName('BKP_BAIRRO').AsString;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_NOMCID').AsString) then
                    cdsTmpDoc.FieldByName('GER_NOMCID').AsString := cdsTmpDoc.FieldByName('BKP_NOMCID').AsString;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_ESTADO').AsString) then
                    cdsTmpDoc.FieldByName('GER_ESTADO').AsString := cdsTmpDoc.FieldByName('BKP_ESTADO').AsString;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_CEPCON').AsString) then
                    cdsTmpDoc.FieldByName('GER_CEPCON').AsString := cdsTmpDoc.FieldByName('BKP_CEPCON').AsString;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_CODCID').AsString) then
                    cdsTmpDoc.FieldByName('CID_CODCID').AsString := cdsTmpDoc.FieldByName('BKP_CODCID').AsString;

                  if not fEmptyStr(cdsTmpDoc.FieldByName('BKP_ALTEND').AsString) then
                    cdsTmpDoc.FieldByName('GER_ALTEND').AsString := cdsTmpDoc.FieldByName('BKP_ALTEND').AsString;

                  cdsTmpDoc.FieldByName('BKP_ENDCON').AsString := EmptyStr;
                  cdsTmpDoc.FieldByName('BKP_BAIRRO').AsString := EmptyStr;
                  cdsTmpDoc.FieldByName('BKP_NOMCID').AsString := EmptyStr;
                  cdsTmpDoc.FieldByName('BKP_ESTADO').AsString := EmptyStr;
                  cdsTmpDoc.FieldByName('BKP_CEPCON').AsString := EmptyStr;
                  cdsTmpDoc.FieldByName('BKP_ALTEND').AsString := EmptyStr;
                  cdsTmpDoc.FieldByName('GER_LOCALI').AsString := 'OK?';
                  cdsTmpDoc.Post;

                  cdsTmpDoc.Next;
                end;
              finally
                cdsTmpDoc.Filtered := False;
              end;
            end;
          end;
        except
          on E: Exception Do
            begin
              Result := False;
              pMensagensErro(E.Message, '[frmFatRomaneio.fConfirmaRomaneio]');
            end;
          end;
      finally
        pFreeAndNil(frmFatRomTransMot);
        cdsTmpDoc.OnFilterRecord := pFilterRecord;
      end;
    end
    else
      Result := fPedeNumeroBox(LTransMot.strNumBox);
  end
  else
  begin
    LTransMot.strCodTra := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodTRansp;
    LTransMot.strCodMot := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodMot;
    LTransMot.strCodAj1 := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodAj1;
    LTransMot.strCodAj2 := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodAj2;
    LTransMot.strCodAj3 := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodAj3;
    LTransMot.strCodAj4 := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodAj4;
    LTransMot.strObsFec := arrVeiculos[StrToInt(ANumVeiculo) - 1].strObsFec;
    LTransMot.strPlaVei := fTiraCaracEspeciais(arrVeiculos[StrToInt(ANumVeiculo) - 1].strPlaVeic);
    LTransMot.strCodReg := arrVeiculos[StrToInt(ANumVeiculo) - 1].strCodReg;
    fltVlrFre := arrVeiculos[StrToInt(ANumVeiculo) - 1].fltVlrFre;
    fltVlrAdi := arrVeiculos[StrToInt(ANumVeiculo) - 1].fltVlrAdi;

    if (arrVeiculos[StrToInt(ANumVeiculo) - 1].fltVlrFre > 0) and (arrVeiculos[StrToInt(ANumVeiculo) - 1].fltTotVlr > 0) then
      fltPerFre := (arrVeiculos[StrToInt(ANumVeiculo) - 1].fltVlrFre / arrVeiculos[StrToInt(ANumVeiculo) - 1].fltTotVlr) * 100
    else
      fltPerFre := arrVeiculos[StrToInt(ANumVeiculo) - 1].fltPerFre;

    cdsTmpDoc.OnFilterRecord := pFilterRecord;
    Result := True;
  End;
end;

function TfrmFatRomaneio.fConfirma(pgbStatus: TcxProgressBar): Boolean;
begin
  pProgresso(0, 4, pgbStatus);

  intQtdSel := 0;
  cdsTmpDoc.OnFilterRecord := Nil;
  cdsTmpDoc.AfterScroll    := Nil;
  dtsTmpDoc.DataSet := Nil;
  intIncremento := 0;
  btnReimprimeDocumento.Visible := (not blnUsaPreRom) and (fVerificaAcessoSistema('RIDCRM'));

  pDeletaTemporaria;
  If cdsTmpDoc.Active Then
    cdsTmpDoc.Close;

  pInformacao('Carregando Documentos...', pgbStatus);
  pAtualizaTemporaria(pgbStatus);
  pStep(pgbStatus);
  pProgresso(2, 4, pgbStatus);

  pVerificaSelecionados;

  pInformacao('Carregando Outras Saídas...', pgbStatus);
  pCarregaOutrasSaidas(edtNumRom.Text, VS_strCodEmp);
  pStep(pgbStatus);

  pInformacao('Calculando Totais...', pgbStatus);
  pCalculaTotal;
  pStep(pgbStatus);

  pProcessaClientMaster;

  cdsTmpDoc.OnFilterRecord := pFilterRecord;
//  cdsTmpDoc.AfterScroll    := pAfterScrollCdsTmpDoc;
  pAfterScrollCdsTmpDoc(cdsTmpDoc);
  Result := True;
end;

function TfrmFatRomaneio.fConfirmacaoRomaneioF10(pgbStatus: TcxProgressBar) : Boolean;
  Var
    blnImprimi,
    blnIteDoc,
    blnImpVal,
    blnMenExp,
    blnEndEnt,
    blnItemCli,
    blnInfItem,
    blnProdutos,
    blnEmbalagens,
    blnDocumentos,
    blnFormas,
    blnTotEspDoc,
    blnMosMar,
    blnCarCar,
    blnImpKm,
    blnVolume,
    blnOrdLoc,
    blnEmbVolume,
    blnCliVolume,
    blnLocAssRec,
    blnRotaViagem : Boolean;

    strCliOrdUni,
    strOrdem,
    strOpeSol, // Operador Solicitante
    strNumRom : String;
    frmMandaeEnvioEncomendas: TfrmMandaeEnvioEncomendas;

    blnRomaneioJahImpresso : Boolean;

    function fConfirmaRomaneioMultiplosVeiculos: Boolean;
    var
      arrRomaneio: array of string;
      intIndice: integer;
      strTodosRomaneios: string;
    begin
      Result := False;

      try
        fStartTransaction;
        strTodosRomaneios := EmptyStr;
        for intIndice := Low(arrVeiculos) to High(arrVeiculos) do
        begin
          if arrVeiculos[intIndice].blnTemRom then
          begin
            If (fConfirmaRomaneio(strNumRom, strOpeSol, True, pgbStatus, arrVeiculos[intIndice].strNumVeic)) Then
            Begin
              fGravaOutrasEntregas(strNumRom, VS_strCodEmp);

              SetLength(arrRomaneio, Length(arrRomaneio) + 1);
              arrRomaneio[Length(arrRomaneio) - 1] := strNumRom;

              strTodosRomaneios := strTodosRomaneios + ', ' +strNumRom;

              strNumRom := EmptyStr;
              edtNumRom.Text := EmptyStr;
            End;
          end;
        end;

        if (not fEmptyStr(strTodosRomaneios)) then
        begin
          fCommit;

          {********************************************************************}
          {* QUANDO UTILIZA "PRÉ ROMANEIO", DEVE-SE IMPRIMIR SOMENTE A PRÉVIA *}
          {* DO ROMANEIO EMITIDO. O DOCUMENTO FINAL SERÁ IMPRESSO SOMENTE NA  *}
          {* ATIVAÇÃO DO ROMANEIO                                             *}
          {*****************************************************************MM*}
          If blnUsaPreRom Then
          Begin
            for intIndice := Low(arrRomaneio) to High(arrRomaneio) do
            begin
              strNumRomPrevia := arrRomaneio[intIndice];

              If fCfgSis('PRESEP',varBoolean) Then
              Begin
                btnReimprimeDocumento.Visible := True;
                btnReimprimeDocumento.Click;
                btnReimprimeDocumento.Visible := False;
              End;
            end;

            pCancelaInclusao(False, False);

          End
          Else
          Begin

            pCancelaInclusao(False, False);

            If Not (fCfgSis('LIBROM', varBoolean)) And (fCfgSis('TIPROM') = '1') Then
            Begin
              Try
                if not fCfgSis('ROMEDI', varBoolean) then
                begin

                  pCriarFormularios(TfrmFatRomaneioImpr, frmFatRomaneioImpr);
                  frmFatRomaneioImpr.ShowModal;
                  blnImprimi    := frmFatRomaneioImpr.blnImprimi;
                  blnProdutos   := frmFatRomaneioImpr.blnProdutos;
                  blnEmbalagens := frmFatRomaneioImpr.blnEmbalagens;
                  blnDocumentos := frmFatRomaneioImpr.blnDocumentos;
                  blnFormas     := frmFatRomaneioImpr.blnFormas;
                  blnItemCli    := frmFatRomaneioImpr.blnItemCli;
                  blnInfItem    := frmFatRomaneioImpr.blnInfItem;
                  blnMosMar     := frmFatRomaneioImpr.blnMosMar;
                  blnTotEspDoc  := frmFatRomaneioImpr.blnTotEspDoc;
                  blnCarCar     := frmFatRomaneioImpr.blnCarCar;
                  blnImpKm      := frmFatRomaneioImpr.blnImpKm;
                  blnVolume     := frmFatRomaneioImpr.edtQtdVol.Text = 'V';
                  blnOrdLoc     := frmFatRomaneioImpr.edtDesLoc.Text = 'L';
                  blnEmbVolume  := frmFatRomaneioImpr.edtEmbQV.Text  = 'V';
                  blnCliVolume  := frmFatRomaneioImpr.edtCliQV.Text  = 'V';
                  strCliOrdUni  := frmFatRomaneioImpr.edtCliOrd.Text;
                  blnIteDoc     := frmFatRomaneioImpr.blnIteDoc;
                  blnImpVal     := frmFatRomaneioImpr.blnImpVal;
                  blnMenExp     := frmFatRomaneioImpr.blnMenExp;
                  blnEndEnt     := frmFatRomaneioImpr.blnEndEnt;
                  strOrdem      := frmFatRomaneioImpr.edtDocEnd.Text;
                  blnLocAssRec  := frmFatRomaneioImpr.chkLocAss.Checked;
                  blnRotaViagem := frmFatRomaneioImpr.chkRotViagem.Checked;
                  pFreeAndNil(frmFatRomaneioImpr);


                  If blnImprimi Or blnIteDoc Or blnEndEnt Or blnItemCli Then
                  Begin
                    for intIndice := Low(arrRomaneio) to High(arrRomaneio) do
                    begin
                      pImprimeRomaneio(arrRomaneio[intIndice],
                                       False,
                                       blnProdutos,
                                       blnEmbalagens,
                                       blnDocumentos,
                                       blnFormas,
                                       blnItemCli,
                                       blnInfItem,
                                       blnTotEspDoc,
                                       blnMosMar,
                                       blnCarCar,
                                       blnImpKm,
                                       blnVolume,
                                       blnOrdLoc,
                                       blnEmbVolume,
                                       blnCliVolume,
                                       strCliOrdUni,
                                       blnIteDoc,
                                       blnEndEnt,
                                       strOrdem,
                                       blnLocAssRec,
                                       blnRotaViagem,
                                       blnImpVal,
                                       blnMenExp);
                    end;

                  End;
                end
                else if Assigned(prcExecutaRelatorio) then
                begin
                  for intIndice := Low(arrRomaneio) to High(arrRomaneio) do
                  begin
                    prcExecutaRelatorio(13, 1356, [1356, 1367],
                                        ['NUMROM', 'EMPROM'],
                                        [arrRomaneio[intIndice], VS_strCodEmp],
                                        nil);
                  end;
                end;
              Except
                On E: Exception Do
                Begin
                  pMensagensErro(E.Message, '[frmFatRomaneio.btnConfirmaClick]');
                End;
              End;
            End;

          End;

          Delete(strTodosRomaneios,1,2);
          fMensagem('', 'Romaneio(s) Nº (' + strTodosRomaneios + ') gerado(s) com sucesso!', ['&Ok']);
          pLimpaVeículos;
          Result := True;
        end
        else
        begin
          pCancelaInclusao(False, False);
          fRollBack;
        end;
      Except
        On E: Exception Do
        Begin
          fRollBack;
          pMensagensErro(E.Message, '[frmFatRomaneio.fConfirmaRomaneioMultiplosVeiculos]');
        End;
      end;
    end;

    procedure pRomaneioImpressao;
    Begin

      Try

        if not fCfgSis('ROMEDI', varBoolean) then
        begin
          pCriarFormularios(TfrmFatRomaneioImpr, frmFatRomaneioImpr);
          frmFatRomaneioImpr.ShowModal;
          blnImprimi    := frmFatRomaneioImpr.blnImprimi;
          blnProdutos   := frmFatRomaneioImpr.blnProdutos;
          blnEmbalagens := frmFatRomaneioImpr.blnEmbalagens;
          blnDocumentos := frmFatRomaneioImpr.blnDocumentos;
          blnFormas     := frmFatRomaneioImpr.blnFormas;
          blnItemCli    := frmFatRomaneioImpr.blnItemCli;
          blnInfItem    := frmFatRomaneioImpr.blnInfItem;
          blnMosMar     := frmFatRomaneioImpr.blnMosMar;
          blnTotEspDoc  := frmFatRomaneioImpr.blnTotEspDoc;
          blnCarCar     := frmFatRomaneioImpr.blnCarCar;
          blnImpKm      := frmFatRomaneioImpr.blnImpKm;
          blnVolume     := frmFatRomaneioImpr.edtQtdVol.Text = 'V';
          blnOrdLoc     := frmFatRomaneioImpr.edtDesLoc.Text = 'L';
          blnEmbVolume  := frmFatRomaneioImpr.edtEmbQV.Text  = 'V';
          blnCliVolume  := frmFatRomaneioImpr.edtCliQV.Text  = 'V';
          strCliOrdUni  := frmFatRomaneioImpr.edtCliOrd.Text;
          blnIteDoc     := frmFatRomaneioImpr.blnIteDoc;
          blnImpVal     := frmFatRomaneioImpr.blnImpVal;
          blnMenExp     := frmFatRomaneioImpr.blnMenExp;
          blnEndEnt     := frmFatRomaneioImpr.blnEndEnt;
          strOrdem      := frmFatRomaneioImpr.edtDocEnd.Text;
          blnLocAssRec  := frmFatRomaneioImpr.chkLocAss.Checked;
          blnRotaViagem := frmFatRomaneioImpr.chkRotViagem.Checked;
          pFreeAndNil(frmFatRomaneioImpr);

          If blnImprimi Or blnIteDoc Or blnEndEnt Or blnItemCli Then
          Begin
            pImprimeRomaneio(strNumRom,
                             False,
                             blnProdutos,
                             blnEmbalagens,
                             blnDocumentos,
                             blnFormas,
                             blnItemCli,
                             blnInfItem,
                             blnTotEspDoc,
                             blnMosMar,
                             blnCarCar,
                             blnImpKm,
                             blnVolume,
                             blnOrdLoc,
                             blnEmbVolume,
                             blnCliVolume,
                             strCliOrdUni,
                             blnIteDoc,
                             blnEndEnt,
                             strOrdem,
                             blnLocAssRec,
                             blnRotaViagem,
                             blnImpVal,
                             blnMenExp,
                             fEhRomaneioSimplificado);

          End;
        end
        else if Assigned(prcExecutaRelatorio) then
          prcExecutaRelatorio(13, 1356, [1356, 1367],
                              ['NUMROM', 'EMPROM'],
                              [strNumRom, VS_strCodEmp],
                              nil);
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message, '[frmFatRomaneio.btnConfirmaClick]');
        End;
      End;

    End;

begin
  Result := False;
  pgbStatus.Position := 0;

  strNumRom := edtNumRom.Text;
  dtaDtaRom := fRetDataServidor;
  dtaHorRom := fRetHoraServidor;

  If fCfgSis('DTOROM', varBoolean) And (not fEmptyStr(strNumRom)) Then
  Begin
    If fMensagem('', 'Deseja manter a data e hora original do romaneio? ', ['&Sim', '&Não']) = 1 Then
    Begin
      dtaDtaRom := dtaDtaRomOri;
      dtaHorRom := dtaHorRomOri;
    End;
  End;

  If (fltTotSel > 0) Or (fPermiteProsseguirComValorZerado) Then
  Begin
    {**************************************}
    {* PEDE SENHA DO OPERADOR SOLICITANTE *}
    {***********************************JB*}

    If (fCfgSis('TIPROM') = '1') And Not blnUsaPreRom Then
      strOpeSol := fRetOperadorSolicitante
    Else
      strOpeSol := strLoginUsuarioLogado;

    If fEmptyStr(strOpeSol) Then
      Exit;

    If (Not fTodosPedidosQueSeraoIncluidosNoRomaneioEstaoEmAberto) Then
      Exit;

    If (fTemPedidosJaFaturadosEmPedidos) Then
      Exit;

    if fUsaPLPPorRomaneio and (not fValidaSIGEPWeb) then
      exit;

    If blnUsaPreRom Then
    Begin
      If cdsTmpDoc.Locate('GER_MARDES', 'M', []) Or cdsTmpDoc.Locate('GER_MARDES', 'P', []) Then
      Begin
        {***********************************************************}
        {* ESTE DOCUMENTO SERÁ UTILIZADO PARA FAZER A IMPRESSÃO DA *}
        {* SEPARAÇÃO DO ROMANEIO                                   *}
        {********************************************************MM*}
        recSepara.strNumDoc := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
        recSepara.strEspDoc := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
        recSepara.strCodCli := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
        recSepara.strEmpDoc := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
      End;
    End;

    If (Pos(strOpcRom, '1_5_') > 0) And (blnUsaPreRom) Then
    Begin
      If fSohTemOutrasEntregas Then
      Begin
        fMensagem('Atenção', 'Romaneios de documentos de "Outras Entregas" devem ser sempre gerados conjuntamente com um ou mais documentos normais.', ['&OK']);
        Exit;
      End;
    End;

    If (fInformaNumeroVeiculo > 0) Then
    Begin

      If fExisteRomaneioSelecionadoSemVeiculo Then
      Begin
        fMensagem('Atenção', 'Existe(m) documento(s) sem veículo vinculado.', ['&OK']);
        Exit;
      End
      Else
      Begin
        Result := fConfirmaRomaneioMultiplosVeiculos;
      End;

    End
    Else
    Begin

      If (fConfirmaRomaneio(strNumRom, strOpeSol, True, pgbStatus)) Then
      Begin

        fGravaOutrasEntregas(strNumRom, VS_strCodEmp);

        if (Pos(strOpcRom, '1_5_') <= 0) then
          fUpdateStatusDocsRom(strNumRom, VS_strCodEmp);

        if fUsaPLPPorRomaneio then
        begin
          pDeletaPLPEmAbertoSemObjetoRomaneio(strNumRom);

          if (fCfgSis('USIGEP') = 'A') and fRomaneioParaCorreios then
          begin
            pImpEtiDespachoDocumentos;

            pVinculaDocumentosPLPRomaneio(strNumRom, fRetSeqPreListaPostagem('', strNumRom));
          end;
        end;

        pRemoverRestauracao;

        fMensagem('', 'Romaneio Nº ' + strNumRom + ' gerado com sucesso!', ['&Ok']);

        pImprimeSeparacao;

        if stlAutoincremLogRom.count > 0 then
        begin
          pAtualizarLogRom(stlAutoincremLogRom, strNumRom);
          stlAutoincremLogRom.Clear;
        end;

        {********************************************************************}
        {* QUANDO UTILIZA "PRÉ ROMANEIO", DEVE-SE IMPRIMIR SOMENTE A PRÉVIA *}
        {* DO ROMANEIO EMITIDO. O DOCUMENTO FINAL SERÁ IMPRESSO SOMENTE NA  *}
        {* ATIVAÇÃO DO ROMANEIO                                             *}
        {*****************************************************************MM*}

        if Assigned(objRomFusTarefas) then
          objRomFusTarefas.pProcessarTarefas;

        blnRomaneioJahImpresso := False;

        If blnUsaPreRom Then
        Begin

          strNumRomPrevia := strNumRom;

          If fCfgSis('PRESEP',varBoolean) Then
          Begin
            btnReimprimeDocumento.Visible := True;
            btnReimprimeDocumento.Click;
            btnReimprimeDocumento.Visible := False;
          End;

          pCancelaInclusao(False, False);

        End
        Else
        Begin

          pCancelaInclusao(False, False);

          If Not (fCfgSis('LIBROM', varBoolean)) And (fCfgSis('TIPROM') = '1') Then
          Begin
            pRomaneioImpressao;
            blnRomaneioJahImpresso := True;
          End;

        End;

        If (Not blnRomaneioJahImpresso) And (fImprimirRomaneioTIPEXP5) Then
          If fMensagem('ATENÇÃO!', 'Deseja imprimir o Romaneio?', ['&Sim', '&Não'], 1) = 1 Then
            pRomaneioImpressao;

        if fCfgSis('MANUSA', varBoolean) and fVerificaAcessoSistema('frmMandaeEnvioEncomendas') and
          (FTemporariaDocumentosRomaneio.fTemRegistrosTabela(FUltimaTemporariaDocsFGO) or FTemporariaDocumentosRomaneio.fTemRegistrosTabela(FUltimaTemporariaDocsGER)) then
        Begin
          Try
            pCriarFormularios(TfrmMandaeEnvioEncomendas, frmMandaeEnvioEncomendas);

            frmMandaeEnvioEncomendas.cdsDocumentos :=
              FObjMandaeRepositorio.fListarDocumentosPendentes(FTemporariaDocumentosRomaneio.fGetJoinDocumentos(FUltimaTemporariaDocsFGO, 'G.AUTOINCREM'),
                                                               FTemporariaDocumentosRomaneio.fGetJoinDocumentos(FUltimaTemporariaDocsGER, 'G.AUTOINCREM'));

            if frmMandaeEnvioEncomendas.cdsDocumentos.Recordcount > 0 then
            Begin
              If (fMensagem('ATENÇÃO!', 'Existem documentos no romaneio de transportadoras que realizam integração com a Mandaê. Deseja fazer o '+
                'envio das encomendas?' , ['&Sim', '&Não'], 2) = 1) Then
              Begin
                frmMandaeEnvioEncomendas.blnIntegracaoPeloRomaneio := True;
                frmMandaeEnvioEncomendas.ShowModal;
              End;
            End;

          Except
            On E: Exception Do
            Begin
              pMensagensErro(E.Message, '[mnuMandaeEnvioEncomendasClick]');
              Exit;
            End;
          End;

          pFreeAndNil(frmMandaeEnvioEncomendas);
        End;

        Result := True;
        FillChar(recTranporte, SizeOf(recTranporte), #0);
      End;
    End;
  End
  Else
  Begin

    If (Not fEmptyStr(strNumRom)) Then
    Begin
      If blnDirDel And (fMensagem('', 'Confirma exclusão do romaneio ' + strNumRom + '?', ['&Sim', '&Não']) = 1) Then
      Begin
        pGravaTabelasDeleteRomaneio(Self.Name, strNumRom);

        If (Not fEmptyStr(edtNumRom.Text)) And
           (blnUsaPreRom) And
           (stlPedExp.Count > 0) Then
        Begin
          pLimparInformacoesExpedicao(Nil, strNumRom);
        End;

        pDeletaRomaneio(strNumRom, (fEntraDevolucoes <> tdNaoListaDevolucao), True);
        fMensagem('', 'Romaneio excluído com sucesso!', ['&Ok']);

        if Assigned(objRomFusTarefas) then
          objRomFusTarefas.pProcessarTarefas;

        pCancelaInclusao(False);

        Result := True;
      End;
    End
    Else
    Begin
      If Not fExistemRomaneiosSelecionados Then
        fMensagem('', 'Não existe nenhum documento selecionado!', ['&Ok'])
      Else
        fMensagem('', 'Não é possível confirmar um valor negativo!', ['&Ok']);
    End;
    
  End;
end;

function TfrmFatRomaneio.fConfirmaComTelaProgresso: Boolean;
var
  LfrmGravando : TfrmGravando;
begin
  pCriarFormularios(TfrmGravando,LfrmGravando);

  try
    blnJaBloqueouDocumentos := True;

    try
      LfrmGravando.lblGravando.Caption := 'Aguarde... Carregando.';
      LfrmGravando.strChave := 'PEDCOM';
      LfrmGravando.fExecutarAcao := fConfirma;
      LfrmGravando.ShowModal;
      Result := LfrmGravando.blnConfirma;
    Except
      On E: Exception Do
      Begin
        Result := False;
        pMensagensErro(E.Message,'[Consultar - untFatRomaneio]');
      End;
    End;
  finally
    blnJaBloqueouDocumentos := False;
    pFreeAndNil(LfrmGravando);
  end;
end;

{*******************************************}
{* PEDE DADOS DO ROMANEIO E PREPARA PARA   *}
{* GRAVAÇÃO                                *}
{****************************************MV*}
function TfrmFatRomaneio.fConfirmaRomaneio(Var strNumRom: String; strOpeSol: String; blnComita: Boolean = True; pgbStatus: TcxProgressBar = Nil; strNumVeiculo: string = ''): Boolean;
var
  LTransMot: TDadosTransMot;
  strSQLGer       : String;
  strTabTmp       : String;
  qryDocsSelecionados : TUniQuery;

  objAlteracaoItens : TAlteracaoItensRomaneio;
  cdsItensAlterados : TCdsItensLocalSeparacao;
  objSeparacaoFina  : TSeparacaoFina;

  strSQLCnf: String;
  intRecNo : Integer;
  intQtdDocs : Integer;

  cdsEntSai : TUniClientDataSet;
  intCnt : Integer;
  blnTemOutDigX : Boolean;
  cdsOutDigX : TUniClientDataSet;

  prcScroll: TprcScroll;
  blnWasEnabled: Boolean;

  idxBkp: Integer;

  blnProcessarStatusIndividualRomaneio: Boolean;
  strCodErrosAuditoria: String;
  blnFalhouNaAuditoria: Boolean;
  qryRomGerX: TUniQuery;

  strTemporariaDocsFGO: String;
  strTemporariaDocsGER: String;
  strTemporariaDocsCNF: String;

  LAutIncRomGer: String;
  LQtdInsert: Integer;
  LExecutar: Boolean;

  procedure pDisparaMensagemRomaneioInconsistente;
  begin
    If (blnGerouUmRomaneioOrfao) Then
    Begin
      fMensagem('Atenção', 'Um ou mais documentos envolvidos na geração desse romaneio sofreram alterações.' + #13#10 +
                           'Você deve clicar novamente no botão consultar para recarregar os mesmos com o valores e status atualizados!', ['&Ok']);
    End;

    If (Not strDocFicouComFdoQtdRomMaiorFdoQtdIte.IsEmpty) Then
    Begin
      fMensagem('Atenção', 'O documento: ' + strDocFicouComFdoQtdRomMaiorFdoQtdIte + ' ficou com uma quantidade para romaneio maior que a quantidade do item.' + #13#10 +
                           'Exclua esse documento do romaneio e inclua-o novamente. Se mesmo assim esse erro persistir, entre em contato com a Citel!', ['&Ok']);
    End;
  end;

  procedure pCriarCdsEntSai;
  begin
    cdsEntSai := TUniClientDataSet.Create(Self);
    cdsEntSai.FieldDefs.Add('CHADOC', ftString, 60);
    cdsEntSai.FieldDefs.Add('TABELA', ftString, 30);
    cdsEntSai.FieldDefs.Add('ENTSAI', ftString,  1);
    cdsEntSai.CreateDataSet;
  end;

  procedure pAddChaveEntSai(strChaDoc, strTabela, strEntSai: String);
  begin
    cdsEntSai.IndexFieldNames := 'CHADOC;TABELA;ENTSAI';
    If Not cdsEntSai.FindKey([strChaDoc, strTabela, strEntSai]) Then
    Begin
      cdsEntSai.Append;
      cdsEntSai.FieldByName('CHADOC').AsString := strChaDoc;
      cdsEntSai.FieldByName('ENTSAI').AsString := strEntSai;
      cdsEntSai.FieldByName('TABELA').AsString := strTabela;
      cdsEntSai.Post;
    End;
  end;

  function fRetEntSai(qryDocES: TUniQuery): String;
  begin
    cdsEntSai.IndexFieldNames := 'CHADOC;TABELA';

    Result := '';

    If cdsEntSai.FindKey([ qryDocES.FieldByName('GER_NUMDOC').AsString +
                           qryDocES.FieldByName('GER_ESPDOC').AsString +
                           qryDocES.FieldByName('GER_CODEMP').AsString +
                           qryDocES.FieldByName('GER_CODCLI').AsString,
                           qryDocES.FieldByName('GER_NOMTBL').AsString ]) Then
      Result := cdsEntSai.FieldByName('ENTSAI').AsString;
  end;

  function fTemTrocaEntSai(qryDocES: TUniQuery): Boolean;
  begin
    Try
      cdsEntSai.Filter := 'CHADOC = ' + QuotedStr(qryDocES.FieldByName('GER_NUMDOC').AsString  +
                                                  qryDocES.FieldByName('GER_ESPDOC').AsString  +
                                                  qryDocES.FieldByName('GER_CODEMP').AsString  +
                                                  qryDocES.FieldByName('GER_CODCLI').AsString) +
                          ' AND TABELA = ' + QuotedStr(qryDocES.FieldByName('GER_NOMTBL').AsString);
      cdsEntSai.Filtered := True;
      Result := (qryDocES.FieldByName('GER_ESPDOC').AsString = 'TR') And (cdsEntSai.RecordCount = 2);
    Finally
      cdsEntSai.Filtered := False;
      cdsEntSai.Filter := '';
    End;
  end;

  procedure pProximoAutoIncrem;
  begin
    if (LQtdInsert <= intQtdDocs) then
      LAutIncRomGer := fNextAutoIncrem(LAutIncRomGer)
    else
      LAutIncRomGer := fRetAutoIncrem('ROMGERX', VS_strCodEmp);
  end;

  function fEhDocumentoBR_TR: Boolean;
  begin
    Result := False;

    if (not fEntraTR_BR_Romaneio) then
      Exit;

    if (Pos(cdsTmpDoc.FieldByName('GER_ESPDOC').AsString, 'BR_TR_') <= 0) then
      Exit;

    Result := True;
  end;
begin
  objListDadosDisparoAutomatico.Clear;

  blnGerouUmRomaneioOrfao := False;
  strDocFicouComFdoQtdRomMaiorFdoQtdIte := '';
  fltPesLiqGrvRom := -1;
  fltPesBruGrvRom := -1;

  qryDocsSelecionados := fCriaQuery(Self);

  pRetornaTransMot(LTransMot, strNumRom);

  blnTemOutDigX := False;

  blnProcessarStatusIndividualRomaneio := (Pos(strOpcRom, '1_5_') > 0);

  Result := True;

  if (blnComita) then
    Result := fCarregaTransMot(strNumVeiculo, LTransMot);

  If (Not Result) Then
  Begin
    If Assigned(qryDocsSelecionados) Then
      FreeAndNil(qryDocsSelecionados);

    Exit;
  End;

  objAlteracaoItens := TAlteracaoItensRomaneio.Create(edtNumRom.Text);

  FInsertsInBatchRomGerX := nil;
  FInsertsInBatchAuxRomX := nil;
  FInsertsInBatchRomDetx := nil;
  FInsertsInBatchRomTraX := nil;
  FInsertsInBatchRomCnd  := nil;
  FInsertsInBatchHisPed  := nil;

  pCriaInsertsInBatch;

  FListRomTra := TStringList.Create;

  strTemporariaDocsFGO := fRetornaTemporariaDocumentosRomaneio(tdrFGO);
  strTemporariaDocsGER := fRetornaTemporariaDocumentosRomaneio(tdrGER);
  strTemporariaDocsCNF := fRetornaTemporariaDocumentosRomaneio(tdrCNF);
  FTabTmpCRM           := fRetornaTemporariaDocumentosRomaneio(tdrCRM);
  FTabTmpRomInvalido   := fRetornaTemporariaDocumentosRomaneio(tdrRomInvalido);

  FListaAutIncRom := TStringList.Create;

  qryRomGerX := fCriarQuery('SELECT * FROM ROMGERX WHERE FALSE');

  Try
    Try
      pCacheDadosRomaneio(cdsTmpDoc);

      if fEmptyStr(strNumVeiculo) then
        fStartTransaction;

      qryRomGerX.Open;

      if fCfgSis('GRUSEP', VarString) = 'S' then
      begin
        if not objAlteracaoItens.fAbreRomDetXOld then
          raise Exception.Create('Erro ao abrir itens do romaneio!');
      end;

      pInsereOutDigXDefinicaoRotas(FOutDig, cdsTmpDoc);

      pCriarCdsEntSai;

      pStep(pgbStatus);

      objAuditRomaneio.Limpar;

      If Not fEmptyStr(edtNumRom.Text) Then
        pDeletaRomaneio(edtNumRom.Text, (fEntraDevolucoes <> tdNaoListaDevolucao));

      blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

      Try
        If blnWasEnabled Then
          pDisableControls(cdsTmpDoc, prcScroll);

        intRecNo := cdsTmpDoc.RecNo;

        cdsTmpDoc.OnFilterRecord := Nil;
        cdsTmpDoc.Filtered := False;

        If strOpcRom <> '3' Then
        Begin
          cdsTmpDoc.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+')) AND ';
          cdsTmpDoc.Filter := cdsTmpDoc.Filter + '((GER_ESPDOC <> ' + QuotedStr('TR') + ') OR (GER_ESPDOC <> ' + QuotedStr('BR') + ')) ';
        End
        Else
          cdsTmpDoc.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+')) ';

        If (not fEmptyStr(strNumVeiculo)) Then
          cdsTmpDoc.Filter := cdsTmpDoc.Filter + ' AND (GER_VEICUL = '+QuotedStr(strNumVeiculo)+') ';

        cdsTmpDoc.Filtered := True;

        if cdsTmpDoc.IsEmpty then
        begin
          Result := False;
          Exit;
        end;
      Finally
        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;

      pStep(pgbStatus);
      pSetTextAguarde('Aguarde... Obtendo Documentos Selecionados...', pgbStatus);

      With cdsTmpDoc Do
      Begin
        cdsEntSai.EmptyDataSet;

        blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

        If blnWasEnabled Then
          pDisableControls(cdsTmpDoc, prcScroll);

        While (Not Eof) Do
        Begin
          If (FieldByName('GER_ESPDOC').AsString = 'OX') Then
          Begin
            blnTemOutDigX := True;
            Next;
            Continue;
          End;

          pAddChaveEntSai(FieldByName('GER_DOCORI').AsString +
                          FieldByName('GER_ESPDOC').AsString +
                          FieldByName('GER_CODEMP').AsString +
                          FieldByName('GER_CODCLI').AsString,
                          FieldByName('GER_NOMTBL').AsString,
                          FieldByName('GER_ENTSAI').AsString);

          {*********************************************}
          {* PREPARA WHERE PARA DOCUMENTOS DO ROMANEIO *}
          {******************************************MV*}
          If ((Pos(strOpcRom, '1_5_') > 0) and (not fEhDocumentoBR_TR)) Or (SameText(FieldByName('GER_NOMTBL').AsString, 'FATGOR')) Then
          Begin
            strTabTmp        := 'FATGOR';
            FTemporariaDocumentosRomaneio.pAddInserirDocumentoTemporaria(strTemporariaDocsFGO, FieldByName('GER_AUTINC').AsString, FieldByName('GER_ENTSAI').AsString);
          End
          Else If (strOpcRom = '2') Then
          Begin
            strTabTmp     := FieldByName('GER_NOMTBL').AsString;
            FTemporariaDocumentosRomaneio.pAddInserirDocumentoTemporaria(strTemporariaDocsGER, FieldByName('GER_AUTINC').AsString, FieldByName('GER_ENTSAI').AsString);
          End
          Else If (Pos(strOpcRom, '34') > 0) Then
          Begin
            If (Pos('MOVGER', FieldByName('GER_NOMTBL').AsString) > 0) Then
            Begin

              If FieldByName('GER_NOMTBL').AsString = 'MOVGER' Then
                strTabTmp    := 'MOVGER';

              FTemporariaDocumentosRomaneio.pAddInserirDocumentoTemporaria(strTemporariaDocsGER, FieldByName('GER_AUTINC').AsString, FieldByName('GER_ENTSAI').AsString);
            End
            Else
            Begin
              strTabTmp    := 'NOTGER';
              FTemporariaDocumentosRomaneio.pAddInserirDocumentoTemporaria(strTemporariaDocsCNF, FieldByName('GER_AUTINC').AsString, FieldByName('GER_ENTSAI').AsString);
            End;
          End;

          {*******************************************}
          {* DA UM UPDATE -> INDIVIDUAL <- NO FATGOR *}
          {* POIS É NECESSÁRIO GRAVAR O TOTAL DO DO- *}
          {* CUMENTO QUE ESTÁ EM ROMANEIOS           *}
          {****************************************MV*}
          if fEmptyStr(FieldByName('ROMTRA').AsString) and (not fEhDocumentoBR_TR) then
          begin
            If (Pos(strOpcRom, '1_5_') > 0) Or (SameText(strTabTmp, 'FATGOR')) Then
              pAtualizaValRomFGO(strTabTmp)
            {*******************************************}
            {* DA UM UPDATE -> INDIVIDUAL <- NO MOVGER *}
            {* POIS É NECESSÁRIO GRAVAR O TOTAL DO DO- *}
            {* CUMENTO QUE ESTÁ EM ROMANEIOS           *}
            {****************************************MV*}
            Else
              pAddUpdateValRomGER(strTabTmp);
          end;

          idxBkp := StlBkpDocs.IndexOf(Concat(FieldByName('GER_DOCORI').AsString, '-',
                                              FieldByName('GER_ESPDOC').AsString, '-',
                                              FieldByName('GER_CODEMP').AsString, '-',
                                              FieldByName('GER_AUTINC').AsString, '-',
                                              FieldByName('GER_ENTSAI').AsString));

          If (idxBkp >= 0) Then
          Begin
            StlDocsEdit.Add(StlBkpDocs[idxBkp]);
            StlBkpDocs.Delete(idxBkp);
          End;

          cdsTmpDoc.Next;

          If (cdsTmpDoc.Eof) Or (fEhMultiplo(cdsTmpDoc.RecNo, 100)) Then
          Begin
            FTemporariaDocumentosRomaneio.pExecutaInsertsTemporaria;
            FSQLCommandBatch.pExecute;
          End;
        End;

        FTemporariaDocumentosRomaneio.pExecutaInsertsTemporaria;
        FSQLCommandBatch.pExecute;

        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;

      strSQLCnf := fGetSQLDocumentos(strTemporariaDocsCNF, 'NOTGER');

      pStep(pgbStatus);

      if (FTemporariaDocumentosRomaneio.fTemRegistrosTabela(strTemporariaDocsGER)) or
         (FTemporariaDocumentosRomaneio.fTemRegistrosTabela(strTemporariaDocsFGO)) then
      begin
        {*********************************************}
        {* PROCESSA TODOS OS DOCUMENTOS SELECIONADOS *}
        {* GRAVANDO ROMGERX E ROMDETX                *}
        {******************************************MV*}
        qryDocsSelecionados.Close;
        qryDocsSelecionados.SQL.Clear;
        qryDocsSelecionados.SQL.Add(fRetSQLDoc(strTemporariaDocsFGO, strTemporariaDocsGER));
        qryDocsSelecionados.Open;

        pSetTextAguarde('Aguarde... Iniciando Gravação dos Romaneios...', pgbStatus);
        intQtdDocs := qryDocsSelecionados.RecordCount;

        LAutIncRomGer := fRetAutoIncrem('ROMGERX', VS_strCodEmp, intQtdDocs);
        LQtdInsert := 0;
        LExecutar := False;

        While (Not qryDocsSelecionados.Eof) Do
        Begin
          If (qryDocsSelecionados.FieldByName('GER_ESPDOC').AsString = 'OX') Then
          Begin
            qryDocsSelecionados.Next;
            Continue;
          End;

          pSetTextAguarde('Aguarde... Gravando Documento: ' + IntToStr(qryDocsSelecionados.RecNo) + ' / ' + IntToStr(intQtdDocs), pgbStatus);

          If fTemTrocaEntSai(qryDocsSelecionados) Then
          Begin
            For intCnt := 1 To 2 Do
            Begin
              Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, IIF(intCnt = 1, 'E', 'S'), LAutIncRomGer, qryRomGerX);
              LQtdInsert := LQtdInsert + 1;

              LExecutar := True;
              Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert);
              pProximoAutoIncrem;

              If (Not Result) Then
                Break;
            End;
          End
          Else
          begin
            Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, fRetEntSai(qryDocsSelecionados), LAutIncRomGer, qryRomGerX);
            LQtdInsert := LQtdInsert + 1;

            LExecutar := True;
            Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert);
            pProximoAutoIncrem;

            If (Not Result) Then
              Break;
          end;

          qryDocsSelecionados.Next;
        End;

        Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert, True);

        qryDocsSelecionados.Close;

        pAtualizaCamposRomaneioFGO(strTemporariaDocsFGO, strNumRom);
        pAtualizaCamposRomaneioGER(strTemporariaDocsGER, strNumRom);

        {**********************************************}
        {* SE TEM ALGUM DOCUMENTO COM PREVIA IMPRESSA *}
        {* EXECUTA UPDATE LIMPANDO A PREVIA           *}
        {*******************************************AL*}
        If fPossuiDocComPreviaImpressa Then
        Begin
          pLimpaPreviaImpressa(strTemporariaDocsFGO, 'FATGOR');
          pLimpaPreviaImpressa(strTemporariaDocsGER, 'MOVGER');
        End;
      End;

      pStep(pgbStatus);

      {*****************************************}
      {* GRAVAÇÃO DOS CONFIRMADOS              *}
      {**************************************MV*}
      if (FTemporariaDocumentosRomaneio.fTemRegistrosTabela(strTemporariaDocsCNF)) then
      begin
        {*********************************************}
        {* PROCESSA TODOS OS DOCUMENTOS SELECIONADOS *}
        {* GRAVANDO ROMGERX E ROMDETX                *}
        {******************************************MV*}
        qryDocsSelecionados.Close;
        qryDocsSelecionados.SQL.Clear;
        qryDocsSelecionados.SQL.Add(strSQLCnf);
        qryDocsSelecionados.Open;

        pSetTextAguarde('Aguarde... Iniciando Gravação dos Romaneios...', pgbStatus);
        intQtdDocs := qryDocsSelecionados.RecordCount;

        LAutIncRomGer := fRetAutoIncrem('ROMGERX', VS_strCodEmp, intQtdDocs);
        LQtdInsert := 0;
        LExecutar := False;

        While (Not qryDocsSelecionados.Eof) Do
        Begin
          If (qryDocsSelecionados.FieldByName('GER_ESPDOC').AsString = 'OX') Then
          Begin
            qryDocsSelecionados.Next;
            Continue;
          End;

          pSetTextAguarde('Aguarde... Gravando Documento: ' + IntToStr(qryDocsSelecionados.RecNo) + ' / ' + IntToStr(intQtdDocs), pgbStatus);

          If fTemTrocaEntSai(qryDocsSelecionados) Then
          Begin
            For intCnt := 1 To 2 Do
            Begin
              Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, IIF(intCnt = 1, 'E', 'S'), LAutIncRomGer, qryRomGerX);
              LQtdInsert := LQtdInsert + 1;

              LExecutar := True;
              Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert);
              pProximoAutoIncrem;

              If (Not Result) Then
                Break;
            End;
          End
          Else
          begin
            Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, fRetEntSai(qryDocsSelecionados), LAutIncRomGer, qryRomGerX);
            LQtdInsert := LQtdInsert + 1;

            LExecutar := True;
            Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert);
            pProximoAutoIncrem;

            If (Not Result) Then
              Break;
          end;

          qryDocsSelecionados.Next;
        End;

        Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert, True);

        qryDocsSelecionados.Close;

        pAtualizaCamposRomaneioCNF(strTemporariaDocsCNF, strNumRom);
      End;

      pStep(pgbStatus);

      {*******************************************}
      {* CASO USE TR/BR, E SEJA OPÇÃO POR PEDIDO,*}
      {* REPROCESSA A TEMPORARIA GRAVANDO AS TR/ *}
      {* BR                                      *}
      {****************************************MV*}
      If (fCfgSis('TRBRRO', varBoolean)) And (Pos(strOpcRom, '1_5_') > 0) Then
      Begin
        Try
          blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

          If blnWasEnabled Then
            pDisableControls(cdsTmpDoc, prcScroll);

          cdsTmpDoc.Filtered := False;
          cdsTmpDoc.Filter   := '((GER_MARDES = '+QuotedStr('M') + ') OR (GER_MARDES = '+QuotedStr('P') + ')) AND ';
          cdsTmpDoc.Filter   := cdsTmpDoc.Filter + '((GER_ESPDOC = '+QuotedStr('TR') + ') OR (GER_ESPDOC = ' + QuotedStr('BR') + '))';
          cdsTmpDoc.Filtered := True;
        Finally
          If blnWasEnabled Then
            pEnableControls(cdsTmpDoc, prcScroll);
        End;

        cdsEntSai.EmptyDataSet;

        cdsTmpDoc.First;
        FTemporariaDocumentosRomaneio.pLimparTemporaria(strTemporariaDocsGER);

        While (Not cdsTmpDoc.Eof) Do
        Begin
          If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'OX') Then
          Begin
            cdsTmpDoc.Next;
            Continue;
          End;

          pAddChaveEntSai(cdsTmpDoc.FieldByName('GER_DOCORI').AsString +
                          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString +
                          cdsTmpDoc.FieldByName('GER_CODEMP').AsString +
                          cdsTmpDoc.FieldByName('GER_CODCLI').AsString,
                          cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                          cdsTmpDoc.FieldByName('GER_ENTSAI').AsString);

          {*********************************************}
          {* PREPARA WHERE PARA DOCUMENTOS DO ROMANEIO *}
          {******************************************MV*}
          FTemporariaDocumentosRomaneio.fInserirDocumentoTemporaria(strTemporariaDocsGER, cdsTmpDoc.FieldByName('GER_AUTINC').AsString, cdsTmpDoc.FieldByName('GER_ENTSAI').AsString);

          {*******************************************}
          {* DA UM UPDATE -> INDIVIDUAL <- NO MOVGER *}
          {* POIS É NECESSÁRIO GRAVAR O TOTAL DO DO- *}
          {* CUMENTO QUE ESTÁ EM ROMANEIOS           *}
          {****************************************MV*}
          pAddUpdateValRomGER('MOVGER');

          cdsTmpDoc.Next;

          If (cdsTmpDoc.Eof) Or (fEhMultiplo(cdsTmpDoc.RecNo, 100)) Then
            FSQLCommandBatch.pExecute;
        End;

        FSQLCommandBatch.pExecute;

        {*********************************************}
        {* PROCESSA TODOS OS DOCUMENTOS SELECIONADOS *}
        {* GRAVANDO ROMGERX E ROMDETX                *}
        {******************************************MV*}
        if (FTemporariaDocumentosRomaneio.fTemRegistrosTabela(strTemporariaDocsGER)) then
        begin
          strSQLGer := fGetSQLDocumentos(strTemporariaDocsGER, 'MOVGER');
          
          qryDocsSelecionados.Close;
          qryDocsSelecionados.SQL.Clear;
          qryDocsSelecionados.SQL.Add(strSQLGer);
          qryDocsSelecionados.Open;

          pSetTextAguarde('Aguarde... Iniciando Gravação dos Romaneios...', pgbStatus);
          intQtdDocs := qryDocsSelecionados.RecordCount;

          LAutIncRomGer := fRetAutoIncrem('ROMGERX', VS_strCodEmp, intQtdDocs);
          LQtdInsert := 0;
          LExecutar := False;

          While (Not qryDocsSelecionados.Eof) Do
          Begin
            If (qryDocsSelecionados.FieldByName('GER_ESPDOC').AsString = 'OX') Then
            Begin
              qryDocsSelecionados.Next;
              Continue;
            End;

            pSetTextAguarde('Aguarde... Gravando Documento: ' + IntToStr(qryDocsSelecionados.RecNo) + ' / ' + IntToStr(intQtdDocs), pgbStatus);

            If fTemTrocaEntSai(qryDocsSelecionados) Then
            Begin
              For intCnt := 1 To 2 Do
              Begin
                Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, IIF(intCnt = 1, 'E', 'S'), LAutIncRomGer, qryRomGerX);
                LQtdInsert := LQtdInsert + 1;

                LExecutar := True;
                Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert);
                pProximoAutoIncrem;

                If (Not Result) Then
                  Break;
              End;
            End
            Else
            begin
              Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, fRetEntSai(qryDocsSelecionados), LAutIncRomGer, qryRomGerX);
              LQtdInsert := LQtdInsert + 1;

              LExecutar := True;
              Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert);
              pProximoAutoIncrem;

              If (Not Result) Then
                Break;
            end;

            qryDocsSelecionados.Next;
          End;

          Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert, True);

          qryDocsSelecionados.Close;

          pAtualizaCamposRomaneioGER(strTemporariaDocsGER, strNumRom, False, False);
        End;
      End;
      
      If (Result) And (blnTemOutDigX) Then
      Begin
        cdsOutDigX := TUniClientDataSet.Create(Self);

        try
          pCloneDataSet(cdsOutDigX, cdsTmpDoc);

          cdsOutDigX.Filtered := False;
          cdsOutDigX.Filter := '(GER_MARDES = '+QuotedStr('M') + ') AND (GER_ESPDOC = ' + QuotedStr('OX')+ ')';
          cdsOutDigX.Filtered := True;

          intQtdDocs := cdsOutDigX.RecordCount;

          cdsOutDigX.First;

          LAutIncRomGer := fRetAutoIncrem('ROMGERX', VS_strCodEmp, intQtdDocs);
          LQtdInsert := 0;
          LExecutar := False;

          While Not cdsOutDigX.Eof Do
          Begin
            qryDocsSelecionados.Close;
            qryDocsSelecionados.SQL.Clear;
            qryDocsSelecionados.SQL.Add( fSQLOutDigX(True) );
            qryDocsSelecionados.ParamByName('NUMDOC').AsString := cdsOutDigX.FieldByName('GER_DOCORI').AsString;
            qryDocsSelecionados.ParamByName('CODEMP').AsString := cdsOutDigX.FieldByName('GER_CODEMP').AsString;
            qryDocsSelecionados.Open;

            cdsOutEnt.Append;
            cdsOutEnt.FieldByName('DESCRI').AsString := qryDocsSelecionados.FieldByName('DESCRI').AsString;
            cdsOutEnt.FieldByName('SEQDIG').AsString := qryDocsSelecionados.FieldByName('SEQDIG').AsString;
            cdsOutEnt.Post;

            Result := Result And fGravaRomaneio(qryDocsSelecionados, LTransMot, strNumRom, strOpeSol, 'S', LAutIncRomGer, qryRomGerX);
            LQtdInsert := LQtdInsert + 1;

            If (Result) Then
            begin
              pAtualizaCamposRomaneioOutDigX(strNumRom, cdsOutDigX.FieldByName('GER_DOCORI').AsString, cdsOutDigX.FieldByName('GER_CODEMP').AsString);
              LExecutar := True;
              Result := fExecutaInsertsInBatch(LExecutar, LQtdInsert);
            end;

            pProximoAutoIncrem;
            cdsOutDigX.Next;
          End;

          Result := Result and fExecutaInsertsInBatch(LExecutar, LQtdInsert, True);
        finally
          FreeAndNil(cdsOutDigX);
        end;
      End;

      if Result and FTemporariaDocumentosRomaneio.fTemRegistrosTabela(FTabTmpCRM) then
        pAtualizaInfoCRMLocalEmLote(LTransMot, pgbStatus);

      If (Not fEmptyStr(edtNumRom.Text)) And
         (blnUsaPreRom) And
         (stlPedExp.Count > 0) Then
        pLimparInformacoesExpedicao(stlPedExp, strNumRom);

      If fCfgSis('EXISTA', varBoolean) Or VS_strHabilitarCRM Then
      Begin
        pStep(pgbStatus);
        pSetTextAguarde('Aguarde... Atualizando status e registrando ocorrências CRM.', pgbStatus);

        TProcessCRM.New()
          .DocumentsFgo(strTemporariaDocsFGO)
          .DocumentsGer(strTemporariaDocsGER)
          .objTemporariaDocsRomaneio(FTemporariaDocumentosRomaneio)
          .StlDocumentsBkp(StlBkpDocs)
          .ProcessaStatusIndividualRomaneio(blnProcessarStatusIndividualRomaneio)
        .pRun();
      End;

      if Result and fUsaPLPPorRomaneio then
      begin
        if (fCfgSis('USIGEP') <> 'A') and fRomaneioParaCorreios then
          pVinculaDocumentosPLPRomaneio(strNumRom, fRetSeqPreListaPostagem('', strNumRom));
      end;

      pStep(pgbStatus);
      pSetTextAguarde('Aguarde... Verificando Separação Coletor.', pgbStatus);
      
      if fCfgSis('GRUSEP', VarString) = 'S' then
      begin
        cdsItensAlterados := TCdsItensLocalSeparacao.Create(nil);
        
        try
          cdsItensAlterados := objAlteracaoItens.fGetItensAlterados(False);
          
          if not cdsItensAlterados.IsEmpty then
          begin
            objSeparacaoFina := TSeparacaoFina.Create(tdsRomaneio, VS_strCodEmp);
            
            try
              objSeparacaoFina.strNumeroDocumento := edtNumRom.Text;
              objSeparacaoFina.pLimpaSeparacaoEConferenciaItensAlterados(cdsItensAlterados);
            finally
              FreeAndNil(objSeparacaoFina);
            end;
          end;                     
        finally
          FreeAndNil(cdsItensAlterados);
        end;                       
      end;

      pStep(pgbStatus);

      if Result then
        Result := fGravaRomRet(cdsRomRet, strNumRom, VS_strCodEmp);

      Result := Result and fGravaDocRemovidosParaConferencia;

      pStep(pgbStatus);
      pSetTextAguarde('Aguarde... Confirmando.', pgbStatus);

      If fEmptyStr(strNumVeiculo) Then
      Begin
        If (blnComita) Then
        Begin
          blnFalhouNaAuditoria := False;

          If (Result) And (Not objAuditRomaneio.ValidouTodas(strCodErrosAuditoria)) Then
          Begin
            blnFalhouNaAuditoria := True;
            Result := False;
          End;

          If (Result) Then
            fCommit
          Else
            fRollBack;

          If blnFalhouNaAuditoria Then
            pMostraErrosAuditoria(strCodErrosAuditoria);
        End;
      End;

      pDisparaMensagemRomaneioInconsistente;

      Try
        if (blnComita) and (Result) and
           (objListDadosDisparoAutomatico.Count > 0) and
           (Pos(fCfgSis('TIPEXP', varString), '2_3_4_5_') > 0) then
          pDisparaMensagensAutomatico;
          
        blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

        If blnWasEnabled Then
          pDisableControls(cdsTmpDoc, prcScroll);

        cdsTmpDoc.Filtered := False;
        cdsTmpDoc.Filter   := '';
        cdsTmpDoc.RecNo    := intRecNo;
      Finally
        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;

    Except
      On E: ExceptionQtdRomaneio Do
      Begin
        if fEmptyStr(strNumVeiculo) then
          fRollBack;

        Result := False;
        fMensagem('ATENÇÃO!', E.Message, ['&Ok']);
        pDisparaMensagemRomaneioInconsistente;
      End;

      On E: Exception Do
      Begin
        If fEmptyStr(strNumVeiculo) Then
          fRollBack;
          
        Result := False;
        pMensagensErro(E.Message, '[fConfirmaRomaneio]');
        pDisparaMensagemRomaneioInconsistente;
      End;
    End;
  finally
    FreeAndNil(objAlteracaoItens);
    FreeAndNil(qryRomGerX);

    blnGerouUmRomaneioOrfao := False;
    strDocFicouComFdoQtdRomMaiorFdoQtdIte := '';
    fltPesLiqGrvRom := -1;
    fltPesBruGrvRom := -1;

    cdsTmpDoc.OnFilterRecord := pFilterRecord;
    
    If Assigned(qryDocsSelecionados) Then
      FreeAndNil(qryDocsSelecionados);

    If Assigned(cdsEntSai) Then
      FreeAndNil(cdsEntSai);

    FreeAndNil(FListaAutIncRom);
    FreeAndNil(FListRomTra);

    pDestroiInsertsInBatch;
    objCacheTablesRomaneio.ClearDocuments;
  end;
end;

function TfrmFatRomaneio.fDocumentoAdicionadoEmOutroRomaneio: Boolean;
var
  LQry: TUniQuery;
  LTabela,
  LPre: String;
begin
  Result := False;

  if (cdsTmpDoc.FieldByName('GER_NOMTBL').AsString = 'OUTDIGX') then
    Exit;

  LQry := fCriaQuery;

  Try
    LTabela := 'MOVDET';
    LPre    := 'DET';

    if (cdsTmpDoc.FieldByName('GER_NOMTBL').AsString = 'NOTGER') then
      LTabela := 'NOTDET'
    else if (cdsTmpDoc.FieldByName('GER_NOMTBL').AsString = 'FATGOR') then
    begin
      LTabela := 'FATDOR';
      LPre    := 'FDO';
    end;

    LQry.Close;
    LQry.SQL.Clear;
    LQry.SQL.Text := ' SELECT AUTOINCREM           '+
                     ' FROM ROMGERX R              '+
                     ' WHERE GER_NUMDOC =  :NUMDOC '+
                     '   AND GER_ESPDOC =  :ESPDOC '+
                     '   AND GER_CODEMP =  :CODEMP '+
                     '   AND GER_CODCLI =  :CODCLI '+
                     '   AND GER_NUMROM <> :NUMROM '+
                     '   AND (NOT EXISTS               '+
                     '     (SELECT ' + LPre + '_NUMDOC '+
                     '      FROM '   + LTabela          +
                     '      WHERE '  + LPre + '_SEQGER = R.GER_AUTINC '+
                     '        AND '  + LPre + '_QTDITE > IFNULL(' + LPre + '_QTDROM, 0))) ';

    LQry.ParamByName('NUMDOC').AsString := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
    LQry.ParamByName('ESPDOC').AsString := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
    LQry.ParamByName('CODEMP').AsString := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
    LQry.ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
    LQry.ParamByName('NUMROM').AsString := edtNumRom.Text;
    LQry.Open;

    If (LQry.IsEmpty) Or (fEmptyStr(LQry.FieldByName('AUTOINCREM').AsString)) Then
      Exit;

    Result := True;
  Finally
    FreeAndNil(LQry);
  End;
end;

function TfrmFatRomaneio.fDocumentoFoiAlterado(strNomTab, strNumDoc, strEspDoc, strCodEmp, strCodCli, strTip_Fc: String; fltVlrCon: Double;
  strOriDoc: String; AfltPercentualDevolucao : Double): Boolean;
  Var
    qryDoc : TUniQuery;
    strCal : String;
    strAbrGer,
    strVlrCon : String;
begin
  Result := False;

  If (strEspDoc = 'OX') Then
    Exit;

  if (not fEmptyStr(cdsTmpDoc.FieldByName('GER_NROROM').AsString)) or (not fEmptyStr(cdsTmpDoc.FieldByName('ROMTRA').AsString)) then
    Exit;

  qryDoc := fCriaQuery(Self);

  strAbrGer := IIF(strNomTab = 'FATGOR', 'FGO_', 'GER_');

  If fUsaRomaneioDocsExpedidos And (strNomTab <> 'FATGOR') And (strOriDoc <> 'D') Then
    strVlrCon := ' SUM((DET_VLRCON / DET_QTDITE) * (COALESCE(DET_QTDEXP, 0))) '
  else if SameText(strNomTab, 'FATGOR') then
    strVlrCon := 'SUM((FDO_VLRCON / FDO_QTDITE) * (FDO_QTDITE - FDO_QTDBAI))'
  Else
    strVlrCon := 'VLRCON';

  if (strOpcRom = '5') and (strNomTab = 'FATGOR') then
    strCal := fRetSqlVlrCon_OPCROM5 + ' AS VLRROM '
  else if (strOpcRom = '1') and fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean) and (not SameText(strEspDoc, 'PR')) and (strNomTab = 'FATGOR') then
    strCal := '  SUM((FDO_VLRCON / FDO_QTDITE) * (FDO_QTDITE - GREATEST(IFNULL(FDO_QTDROM, 0), FDO_QTDBAI))) AS VLRROM '
  else
  begin

    strCal := ' (IFNULL(' + IfThen((fUsaRomaneioDocsExpedidos And (strNomTab <> 'FATGOR') And (strOriDoc <> 'D'))
                                   or SameText(strNomTab, 'FATGOR'), '', strAbrGer) + strVlrCon + ',0) - IFNULL(' + strAbrGer + 'VALROM,0)) ';

    If (SameText(strEspDoc, 'PR')) Then
      strCal := strCal + ' + IFNULL(FGO_TOTFRE, 0) ';

    strCal := strCal + ' VLRROM ';

  end;

  With qryDoc Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(' SELECT ' + strCal );
    SQL.Add('   FROM ' + strNomTab );

    if SameText(strNomTab, 'FATGOR') then
      SQL.Add(' LEFT JOIN FATDOR ON (FATDOR.FDO_SEQGER = FATGOR.AUTOINCREM) ');

    If fUsaRomaneioDocsExpedidos And (strNomTab <> 'FATGOR') And (strOriDoc <> 'D') Then
    Begin
      SQL.Add(' LEFT JOIN MOVDET ON (MOVDET.DET_SEQGER = ' + strNomTab + '.AUTOINCREM) ');
      SQL.Add(' LEFT JOIN MOVTRI ON (MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM) ');
    End;

    SQL.Add('  WHERE ' + strAbrGer + 'NUMDOC = :NUMDOC ');
    SQL.Add('    AND ' + strAbrGer + 'ESPDOC = :ESPDOC ');
    SQL.Add('    AND ' + strAbrGer + 'CODEMP = :CODEMP ');
    SQL.Add('    AND ' + strAbrGer + 'CODCLI = :CODCLI ');

    If (Not (SameText(strNomTab, 'FATGOR'))) Then
      SQL.Add('    AND ' + strAbrGer + 'TIP_FC = :TIP_FC ');

    ParamByName('NUMDOC').AsString := strNumDoc;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;

    If (Not (SameText(strNomTab, 'FATGOR'))) Then
      ParamByName('TIP_FC').AsString := strTip_Fc;
    Open;

    If (Not SameText(strEspDoc, 'TR')) Then
      Result :=(Not (CompareValue(fFormataFloat(fltVlrCon,2),
                                  fFormataFloat(FieldByName('VLRROM').AsFloat * AfltPercentualDevolucao,2), 0.05) = EqualsValue))
    Else
      Result := False;

    Close;
  End;

  FreeAndNil(qryDoc);
end;

function TfrmFatRomaneio.fDocumentoJahFoiBipado(strAcesso, strDocDig, strEspDig, strEmpDig: String): Boolean;
var
  cdsTmp : TUniClientDataSet;
begin

  cdsTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsTmp, cdsTmpDoc);

  cdsTmp.Filtered := False;
  cdsTmp.Filter   := '';

  Try

    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
      Result := cdsTmp.Locate('FIS_ACESSO', strAcesso, [])
    Else
      Result := cdsTmp.Locate('GER_NUMDOC;GER_CODEMP', VarArrayOf([strDocDig+'-'+strEspDig, strEmpDig]), []);

  Finally
    FreeAndNil(cdsTmp);
  End;

end;

function TfrmFatRomaneio.fDocumentoRemovidoNaoConferidoVolume(ATabela, APrefix: String): String;
begin
  Result := '';

  if (not fUtilizaConferenciaDocsRemovidosRomaneio) then
    Exit;

  Result := '  AND NOT EXISTS (SELECT RCF_NUMROM FROM ROMCNF ' +
            '                  WHERE RCF_NUMDOC = ' + ATabela + '.' + APrefix + '_NUMDOC ' +
            '                    AND RCF_ESPDOC = ' + ATabela + '.' + APrefix + '_ESPDOC ' +
            '                    AND RCF_EMPDOC = ' + ATabela + '.' + APrefix + '_CODEMP ' +
            '                    AND RCF_DTACNF IS NULL) ';
end;

function TfrmFatRomaneio.fExistemRomaneiosSelecionados: Boolean;
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  Result := False;
  if not cdsTmpDoc.Active then
    Exit;

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  Try
    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    cdsTmpDoc.First;

    While Not cdsTmpDoc.Eof Do
    Begin
      If cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M' Then
      Begin
        Result := True;
        Break;
      End;
      cdsTmpDoc.Next;
    End;
  Finally
    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;
end;

function TfrmFatRomaneio.fExisteRomaneioSelecionadoSemVeiculo: Boolean;
var
  cdsVeiculoTmp: TUniClientDataSet;
begin
  cdsVeiculoTmp := TUniClientDataSet.Create(Self);
  try
    Result := False;
    pCloneDataSet(cdsVeiculoTmp, cdsTmpDoc);
    cdsVeiculoTmp.DisableControls;
    cdsVeiculoTmp.Filtered := False;
    cdsVeiculoTmp.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+')) ';
    cdsVeiculoTmp.Filter := cdsVeiculoTmp.Filter + ' AND (TRIM(GER_VEICUL) = '''') ';
    cdsVeiculoTmp.Filtered := True;
    Result := not cdsVeiculoTmp.IsEmpty;
  finally
    FreeAndNil(cdsVeiculoTmp);
  end;
end;

function TfrmFatRomaneio.fFoiFinalizadoConferenciaDoRomaneioNoColetorDeDados(strNumRom, strEmpRom: String): Boolean;
