  strSelect := strSelect + fSQLCampo('GER_VPAR11', '', 'NOTGER')           + ' AS GER_VPAR11, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR12', '', 'NOTGER')           + ' AS GER_VPAR12, ';
  strSelect := strSelect + fSQLCampo('DET_TOTITE', 'GER_TOTPRO', 'NOTGER') + ' AS GER_TOTPRO, ';
  strSelect := strSelect + '  GER_CODCND, ';
  strSelect := strSelect + fRetornaCampoOrigemPedidoRetira('NOTGER');
  strSelect := strSelect + '  " " AS GER_ORIDEV, ';
  strSelect := strSelect + fRetornaInformacoesRota;
  strSelect := strSelect + '  " " AS DOC_FATURADOS, ';
  strSelect := strSelect + '  " " AS GER_INCFUT, ';
  strSelect := strSelect + '  " " AS TIPPED, ';
  strSelect := strSelect + '  1.00 AS GER_PERDEV, ';
  strSelect := strSelect + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSelect := strSelect + '  FROM ROMLGE ';
  strSelect := strSelect + '  INNER JOIN ROMLDE ';
  strSelect := strSelect + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';

  if (fCfgSis('OPROSE', varString) = '2') and (fCfgSis('OPROML', varString) = '2') then
  begin
    strSelect := strSelect + '  WHERE RLD_NUMDOC = GER_NUMDOC ';
    strSelect := strSelect + '  AND RLD_ESPDOC = GER_ESPDOC ';
    strSelect := strSelect + '  AND RLD_CODEMP = GER_CODEMP LIMIT 1) AS ROMLOT, ';
  end
  else
  begin
    strSelect := strSelect + '  INNER JOIN FATGOR ';
    strSelect := strSelect + '  ON (RLD_NUMDOC = FGO_NUMDOC ';
    strSelect := strSelect + '  AND RLD_ESPDOC = FGO_ESPDOC ';
    strSelect := strSelect + '  AND RLD_CODEMP = FGO_CODEMP) ';
    strSelect := strSelect + '  WHERE FGO_NUMFAT = GER_NUMDOC ';
    strSelect := strSelect + '  AND FGO_TIPFAT = GER_ESPDOC ';
    strSelect := strSelect + '  AND FGO_EMPFAT = GER_CODEMP LIMIT 1) AS ROMLOT, ';
  end;

  strSelect := strSelect + fRetornaCampoTurno('DET_TURENT');
  strSelect := strSelect + ', "N" AS DELETA_DEVOLUCAO ';

  strSelect := strSelect + ', CAST(" " AS CHAR(20)) AS ROMTRA ';
  strSelect := strSelect + ', CAST(" " AS CHAR(3)) AS TRA_EMPDES ';

  if fCfgSis('MATDIS', varBoolean) then
  begin
    strSelect := strSelect + ', CAST(" " AS CHAR(30)) AS GER_LOCALI ';
    strSelect := strSelect + ', 0.00 AS GER_DISTAN ';
    strSelect := strSelect + ', 0.00 AS GER_TMPENT ';
    strSelect := strSelect + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
    strSelect := strSelect + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSelect := strSelect + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSelect := strSelect + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSelect := strSelect + ', 0 AS PRIORIDADE ';
    strSelect := strSelect + ', CAST("N" AS CHAR(1)) AS GER_LIBAPP ';
    strSelect := strSelect + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSelect := strSelect + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSelect := strSelect + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSelect := strSelect + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSelect := strSelect + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSelect := strSelect + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSelect := strSelect + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSelect := strSelect + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSelect := strSelect + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSelect := strSelect + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSelect := strSelect + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSelect := strSelect + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSelect := strSelect + ', CADCLI.CLI_CODRED ';
  strSelect := strSelect + ', CADCLI.CLI_CODCAC ';
  strSelect := strSelect + ', CADCLI.CLI_FANSOB ';
  strSelect := strSelect + ', CADCLI.CLI_ORIENT ';
  strSelect := strSelect + ', CAC.CAC_CORILP '   ;
  strSelect := strSelect + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSelect := strSelect + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSelect := strSelect + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSelect := strSelect + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSelect := strSelect + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSelect := strSelect + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSelect := strSelect + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSelect := strSelect + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSelect := strSelect + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSelect := strSelect + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSelect := strSelect + ', NOTDET.DET_CLAFIS ';
  strSelect := strSelect + ', ' + fSQLBarDoc('GER') + ' AS BARDOC ';

  strSelect := strSelect + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSelect := strSelect + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSelect := strSelect + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSelect := strSelect + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSelect := strSelect + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSelect := strSelect + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSelect := strSelect + 'FROM ';
  strSelect := strSelect + '  NOTGER ';
  strSelect := strSelect + '  INNER JOIN NOTDET   ON NOTDET.DET_SEQGER = NOTGER.AUTOINCREM ';
  strSelect := strSelect + '  INNER JOIN NOTTRI   ON NOTDET.AUTOINCREM = NOTTRI.DET_SEQGER ';
  strSelect := strSelect + '  INNER JOIN CADCLI   ON GER_CODCLI        = CLI_CODCLI ';
  strSelect := strSelect + '  INNER JOIN CADCID   ON CADCID.CID_CODCID = IF(GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) ';
  strSelect := strSelect + '  INNER JOIN CADITE I ON I.ITE_CODITE      = DET_CODITE ';
  strSelect := strSelect + '   LEFT JOIN CADTRA   ON GER_CODTRA        = TRA_CODTRA ';
  strSelect := strSelect + '   LEFT JOIN CADFPG   ON GER_CODFPG        = FPG_CODIGO ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA NOTGER *}
  {************************************FC}
  strSelect := strSelect + 'LEFT JOIN AUXNOT        ON (AUXNOT.AUX_SEQGER = NOTGER.AUTOINCREM) ';
  strSelect := strSelect + 'LEFT JOIN NOTOBS        ON (NOTOBS.MOV_SEQGER = NOTGER.AUTOINCREM) ';
  strSelect := strSelect + 'LEFT JOIN ENTCLI ECNOT  ON (ECNOT.AUTOINCREM  = AUXNOT.AUX_ENTGER) ';
  strSelect := strSelect + 'LEFT JOIN CADCID CIDNOT ON (CIDNOT.CID_CODCID = ECNOT.ETC_CIDENT)  ';
  strSelect := strSelect + 'LEFT JOIN CADTRA TRANOT ON (ECNOT.ETC_CODTRA  = TRANOT.TRA_CODTRA) ';

  strSelect := strSelect + ' LEFT JOIN CADFIS ON FIS_NUMDOC = GER_NUMDOC ';
  strSelect := strSelect + '                 AND FIS_ESPDOC = GER_ESPDOC ';
  strSelect := strSelect + '                 AND FIS_CODEMP = GER_CODEMP ';
  strSelect := strSelect + '                 AND FIS_FORCLI = GER_CODCLI ';
  strSelect := strSelect + '                 AND FIS_TIP_FC = GER_TIP_FC ';

  // ** CADREG REGIAO **
  strSelect := strSelect + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECNOT.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECNOT.ETC_CODREG) ) ';
  strSelect := strSelect + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  // ** DEPARTAMENTO VENDEDOR **
  strSelect := strSelect + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = NOTGER.GER_CODVEN ';
  strSelect := strSelect + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSelect := strSelect + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSelect := strSelect + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = NOTGER.GER_CODCND   ';

  strSelect := strSelect + fJoinFatGor_ExtGor('NOTDET');

  //Entrega (Rota) selecionada
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSelect := strSelect + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSelect := strSelect + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;

  strSelect := strSelect + 'WHERE ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
    Begin
      strSelect := strSelect + '  FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSelect := strSelect + '      GER_NUMDOC = :NUMDOC ';
      strSelect := strSelect + '  AND GER_ESPDOC = :ESPDOC ';
      strSelect := strSelect + '  AND GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin

    strSelect := strSelect + '      GER_ENTFAT = "S" ';

    strSelect := strSelect + '  AND ' + fRetCondicaoCFOP('GER_CLAFIS');
    strSelect := strSelect + '  AND GER_NUMROM IS NULL ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSelect := strSelect + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSelect := strSelect + ' AND ' + IIF(rdbEntrega.Checked, 'GER_DTENTR', 'GER_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
    Else
      strSelect := strSelect + ' AND GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

    If (chkSomenteCliFil.Checked) Then
      strSelect := strSelect + ' AND GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSelect := strSelect + fStrLocate(edtCodCid    , arrCidade  , 'IF(GER_CIDCON IS NULL, IF(IFNULL(ECNOT.ETC_CIDENT,"") <> "", ECNOT.ETC_CIDENT, CLI_CODCID), GER_CIDCON)','CODCID');
    strSelect := strSelect + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECNOT.ETC_CODTRA,"") = "", GER_CODTRA, ECNOT.ETC_CODTRA)','CODTRA');
    strSelect := strSelect + fStrLocate(edtTraFat    , arrTraFat  , 'GER_CODTRA', 'TRAFAT');
    strSelect := strSelect + fStrLocate(edtCodReg    , arrRegiao  , 'ECNOT.ETC_CODREG', 'CODREG');
    strSelect := strSelect + fStrLocate(edtCodVen    , arrVended  , 'GER_CODVEN', 'CODVEN');
    strSelect := strSelect + fStrLocate(edtCodDep    , arrDepVen  , 'DEP_CODIGO', 'CODDEP');
    strSelect := strSelect + fStrLocate(edtCodCliente, arrClientes, 'GER_CODCLI', 'CODCLI');
    strSelect := strSelect + fStrLocate(edtCodProduto, arrProdutos, 'DET_CODITE', 'CODITE');
    If blnRegCid Then
      strSelect := strSelect + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    {*****************************************}
    {* FILTRO DE LINHA E GRUPO               *}
    {**************************************MV*}
    strSelect := strSelect + fSQLFiltroLinGru('DET');

    if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
    Begin
      strSelect := strSelect + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
      strSelect := strSelect + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
      strSelect := strSelect + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
      strSelect := strSelect + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
      strSelect := strSelect + '                AND RLD_NUMDOC = DET_NUM_PD                        ';
      strSelect := strSelect + '                AND RLD_ESPDOC = DET_ESP_PD                        ';
      strSelect := strSelect + '                AND RLD_CODEMP = DET_EMP_PD )                      ';
    End;

  End;

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSelect := strSelect + '  AND NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSelect := strSelect + '                   FROM ROMGERX GERX ';
    strSelect := strSelect + '                  INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSelect := strSelect + '                  WHERE GERX.GER_CODEMP = NOTGER.GER_CODEMP ';
    strSelect := strSelect + '                    AND GERX.GER_NUMDOC = NOTGER.GER_NUMDOC ';
    strSelect := strSelect + '                    AND GERX.GER_ESPDOC = NOTGER.GER_ESPDOC ';
    strSelect := strSelect + '  ) ';
  End;

  strSelect := strSelect + '  AND GER_ESPDOC IN ("NF", "EL"' + IIF(fEntraEP_Romaneio, ', "EP"', '') + IIF(blnListGC, ', "GC"', '') + ') ';
  strSelect := strSelect + '  AND GER_JAFATU = 0 ';
  strSelect := strSelect + '  AND IF( GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) = CADCID.CID_CODCID ';

  If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
    strSelect := strSelect + '  AND DET_PROEMB <> "S" ';

  If fCfgSis('CLBUEF',varboolean) Then
    strSelect := strSelect + '  AND DET_CLIBUS = "N" ';

  if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) then
  begin
    strSelect := strSelect + ' AND (' + fRetSQLFiltroEmpresas('DET_EMP_PD') + ') ';
    strSelect := strSelect + ' AND GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';
  end
  else
    strSelect := strSelect + ' AND (' + fRetSQLFiltroEmpresas('GER_CODEMP') + ') ';

  strSelect := strSelect + fDocumentoRemovidoNaoConferidoVolume('NOTGER', 'GER');

  strSelect := strSelect + ' GROUP BY NOTDET.DET_SEQGER ';

  If fEmptyStr( strDocCaixa ) Then
  Begin
    strSelect := strSelect + fRetornaWhereTurno();
    strSelect := strSelect + fGetWhereDocsExpedidos('NOTGER');

    //UNION COM A MOVDET PARA RETORNAR OS REGISTROS COM ESPDOC = TR QUE SEJAM DE MOVIMENTAÇÃO DE SAÍDA ...
    If fEntraTR_BR_Romaneio Then
    Begin
      strSelect := strSelect + ' UNION ALL ';
      strSelect := strSelect + fSQLTrocasSaida(strOpcRom);
      strSelect := strSelect + ' UNION ALL ';
      strSelect := strSelect + fSQLBrindes;
    End;

    {*******************************************}
    {* CONFIGURAÇÃO PARA ENTRAR "TE"           *}
    {****************************************RN*}
    If fEntraTE_Romaneio Then
    Begin
      strSelect := strSelect + 'UNION ALL ';
      strSelect := strSelect + fSQLTE;
    End;
  End;

  If not fEmptyStr( strDocCaixa ) Then
    strSelect := AnsiReplaceStr(strSelect, 'DOC_CX_MOVGER', strDocCaixa);

  Result := strSelect;

end;

function TfrmFatRomaneio.fRetSQL_OPCROM4: String;
var
  strSQLGer : String;
  strSelect : String;
begin

  {*****************************************}
  {* MOVGER                                *}
  {**************************************MV*}
  strSQLGer := '';
  strSQLGer := strSQLGer + 'SELECT ';
  strSQLGer := strSQLGer + fRetSQLDocRetornadoRomaneio('G.GER') + ' AS GER_RETROM, ';
  strSQLGer := strSQLGer + '  G.GER_CONPAG AS GER_CONPAG, ';
  strSQLGer := strSQLGer + '  G.GER_CODFPG AS GER_CODFPG, ';
  strSQLGer := strSQLGer + '  " "          AS GER_TIPOPE, ';
  strSQLGer := strSQLGer + '  " "          AS GER_FPGNEG, ';
  strSQLGer := strSQLGer + '  "N"          AS GER_ORIF11, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_TOTBRI, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_VALREC, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_BOLADT, ';
  strSQLGer := strSQLGer + '  "N"          AS GER_BOLVEN, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_VALADT, ';
  strSQLGer := strSQLGer + '  G.GER_VLRCON AS GER_CONORI, ';
  strSQLGer := strSQLGer + '  G.GER_DTAENT, ';
  strSQLGer := strSQLGer + '  G.GER_HORENT, ';
  strSQLGer := strSQLGer + '  G.GER_DTENTR, ';
  strSQLGer := strSQLGer + '  CONCAT( G.GER_NUMDOC, "-", G.GER_ESPDOC ) AS GER_NUMDOC, ';
  strSQLGer := strSQLGer + '  G.GER_NUMDOC AS GER_DOCORI, ';
  strSQLGer := strSQLGer + '  G.GER_ESPDOC, ';
  strSQLGer := strSQLGer + '  G.GER_CODEMP, ';
  strSQLGer := strSQLGer + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSQLGer := strSQLGer + '  G.GER_CODCLI, ';
  strSQLGer := strSQLGer + '  IF( G.GER_NOMCON IS NULL, CLI_NOMCLI, G.GER_NOMCON) AS GER_NOMCLI, ';
  strSQLGer := strSQLGer + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSQLGer := strSQLGer + '  G.GER_CLAFIS, ';

  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', CIDGER.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', CIDGER.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', CIDGER.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSQLGer := strSQLGer + '  G.GER_TIPFRE, ';

  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', ECMOV.ETC_BAIENT, COALESCE(G.GER_BAICON, CADCLI.CLI_BAIRRO)) AS GER_BAIRRO, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', ECMOV.ETC_ENDENT, COALESCE(G.GER_ENDCON, CADCLI.CLI_ENDERE)) AS GER_ENDCON, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', ECMOV.ETC_LATLON, " ") AS GER_LATLON, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', ECMOV.ETC_CEPENT, COALESCE(G.GER_CEPCON, CADCLI.CLI_C_E_P_)) AS GER_CEPCON, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV','G')+', ECMOV.ETC_REFENT, CADCLI.CLI_REFENT) AS GER_REFCON, ';

  strSQLGer := strSQLGer + '  G.GER_CODVEN, ';
  strSQLGer := strSQLGer + '  CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
  strSQLGer := strSQLGer + fSQLVlrCon('DET', 'G') + ' - IFNULL(G.GER_VALROM, 0) AS GER_VLRCON, ';
  strSQLGer := strSQLGer + fSQLVlrCon('DET', 'G') + ' - IFNULL(G.GER_VALROM, 0) AS GER_VALDOC, ';
  strSQLGer := strSQLGer + '  (G.GER_TOTPRO - G.GER_DESESP) GER_VLRPRO, ';
  strSQLGer := strSQLGer + '  G.GER_ROMIMP, ';
  strSQLGer := strSQLGer + '  "D" AS GER_MARDES,        ';
  strSQLGer := strSQLGer + '  " " AS GER_VEICUL,        ';

  strSQLGer := strSQLGer + fGetSQLPosObs('G','GER_NUMDOC','GER_ESPDOC','GER_CODEMP') + ' AS POSOBS, ';

  strSQLGer := strSQLGer + '  LPAD("", 15, " ") AS GER_PALET_, ';
  strSQLGer := strSQLGer + '  0.00 GER_VALSEL, ';
  strSQLGer := strSQLGer + '  0.00 GER_VSEPRO, ';
  strSQLGer := strSQLGer + '  G.GER_TIP_FC, ';
  strSQLGer := strSQLGer + '  0 GER_ORDIMP, ';
  strSQLGer := strSQLGer + '  " " GER_ALTERA, ';
  strSQLGer := strSQLGer + '  0 INCREMENTO, ';
  strSQLGer := strSQLGer + '  IF(IFNULL(TRAMOV.TRA_CODTRA,"") = "", CADTRA.TRA_CODTRA, TRAMOV.TRA_CODTRA) AS GER_CODTRA, ';
  strSQLGer := strSQLGer + '  IF(IFNULL(TRAMOV.TRA_NOMTRA,"") = "", CADTRA.TRA_NOMTRA, TRAMOV.TRA_NOMTRA) AS GER_TRANSP, ';
  strSQLGer := strSQLGer + '  CADTRA.TRA_NOMTRA AS GER_TRAFAT, ';
  strSQLGer := strSQLGer + '  G.GER_CODTRA  AS GER_TRADOC, ';
  strSQLGer := strSQLGer + '  G.GER_PESBRU, ';
  strSQLGer := strSQLGer + '  "MOVGER" AS GER_NOMTBL, ';
  strSQLGer := strSQLGer + '  G.AUTOINCREM AS GER_AUTINC, ';
  strSQLGer := strSQLGer + '  CONCAT(G.GER_NUMFAT, G.GER_TIPFAT, G.GER_EMPFAT, G.GER_CLIFAT) AS GER_NUMFAT, ';
  strSQLGer := strSQLGer + '  CONCAT(G.GER_NUMDOC, G.GER_ESPDOC, G.GER_CODEMP, G.GER_CODCLI) AS GER_DOCUME, ';
  strSQLGer := strSQLGer + '  G.GER_ORIDOC, ';
  strSQLGer := strSQLGer + '  CAST(' + fSQLTotDet('DET') + ' AS DECIMAL(15, 4)) AS GER_TOTDET, ';
  strSQLGer := strSQLGer + '  G.GER_NUMROM AS GER_NROROM, ';
  strSQLGer := strSQLGer + '  CAST((SELECT IFNULL(GROUP_CONCAT(DISTINCT FDO_NUMDOC, "-", FDO_ESPDOC), " ") FROM FATDOR WHERE FDO_NUMFAT = G.GER_NUMDOC AND FDO_TIPFAT = G.GER_ESPDOC AND FDO_EMPFAT = G.GER_CODEMP) AS CHAR(255)) GER_PEDVEN, ';
  strSQLGer := strSQLGer + fSQLVolume('DET', 'G') + ' AS GER_VOLUME, ';
  strSQLGer := strSQLGer + fSQLProfissionalCodigo('DET')  + ' AS GER_CODDIV, ';
  strSQLGer := strSQLGer + fSQLProfissionalNome('DET')  + ' AS GER_NOMDIV, ';
  strSQLGer := strSQLGer + '  MOV_OBSERV AS GER_NFEADC, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEXP, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEX2, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEX3, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEX4, ';
  strSQLGer := strSQLGer + '  " " AS ENTURG, ';;
  strSQLGer := strSQLGer + '  G.GER_PRVIMP,  ';
  strSQLGer := strSQLGer + '  IF(LEFT(G.GER_CLAFIS, 1) >= "5", "S", "E") AS GER_ENTSAI, ';
  strSQLGer := strSQLGer + '  FIS_ACESSO, ';
  strSQLGer := strSQLGer + '  G.GER_ENTFUT, ';
  strSQLGer := strSQLGer + '  G.GER_ENTFAT, ';
  strSQLGer := strSQLGer + '  G.GER_CONENT, ';
  strSQLGer := strSQLGer + '  "N" AS APENAS_ESTE, ';
  strSQLGer := strSQLGer + '  0 AS GER_VOLBIP, ';
  strSQLGer := strSQLGer + fRetSQLDescrRegiao;
  strSQLGer := strSQLGer + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';
  strSQLGer := strSQLGer + fRetSQLSeqRotaRegiao('IF('+fEnderecoPelaEntCli('AUXMOV','G')+', CIDGER.CID_CODCID, CADCID.CID_CODCID)');
  strSQLGer := strSQLGer + fSQLCampo('GER_BASSIM', '', 'G')           + ' AS GER_BASSIM, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_BASIPI', 'GER_BASIPI', 'G') + ' AS GER_BASIPI, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_VALIPI', 'GER_TOTIPI', 'G') + ' AS GER_TOTIPI, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_BASICM', 'GER_BASICM', 'G') + ' AS GER_BASICM, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_VALICM', 'GER_TOTICM', 'G') + ' AS GER_TOTICM, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_VALRET', 'GER_TOTRET', 'G') + ' AS GER_TOTRET, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_BASRET', 'GER_BASRET', 'G') + ' AS GER_BASRET, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_DESESP', 'GER_DESESP', 'G') + ' AS GER_DESESP, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTCUS', 'GER_TOTCUS', 'G') + ' AS GER_TOTCUS, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTMED', 'GER_TOTMED', 'G') + ' AS GER_TOTMED, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTFRE', 'GER_TOTFRE', 'G') + ' AS GER_TOTFRE, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR01', '', 'G')           + ' AS GER_VPAR01, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR02', '', 'G')           + ' AS GER_VPAR02, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR03', '', 'G')           + ' AS GER_VPAR03, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR04', '', 'G')           + ' AS GER_VPAR04, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR05', '', 'G')           + ' AS GER_VPAR05, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR06', '', 'G')           + ' AS GER_VPAR06, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR07', '', 'G')           + ' AS GER_VPAR07, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR08', '', 'G')           + ' AS GER_VPAR08, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR09', '', 'G')           + ' AS GER_VPAR09, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR10', '', 'G')           + ' AS GER_VPAR10, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR11', '', 'G')           + ' AS GER_VPAR11, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR12', '', 'G')           + ' AS GER_VPAR12, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTITE', 'GER_TOTPRO', 'G') + ' AS GER_TOTPRO, ';
  strSQLGer := strSQLGer + '  G.GER_CODCND, ';
  strSQLGer := strSQLGer + fRetornaCampoOrigemPedidoRetira('G');
  strSQLGer := strSQLGer + '  " " AS GER_ORIDEV, ';
  strSQLGer := strSQLGer + fRetornaInformacoesRota;
  strSQLGer := strSQLGer + '  " " AS DOC_FATURADOS, ';
  strSQLGer := strSQLGer + '  " " AS GER_INCFUT, ';
  strSQLGer := strSQLGer + '  " " AS TIPPED, ';
  strSQLGer := strSQLGer + '  1.00 AS GER_PERDEV, ';
  strSQLGer := strSQLGer + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSQLGer := strSQLGer + '  FROM ROMLGE ';
  strSQLGer := strSQLGer + '  INNER JOIN ROMLDE ';
  strSQLGer := strSQLGer + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';

  if (fCfgSis('OPROSE', varString) = '2') and (fCfgSis('OPROML', varString) = '2') then
  begin
    strSQLGer := strSQLGer + '  WHERE RLD_NUMDOC = G.GER_NUMDOC ';
    strSQLGer := strSQLGer + '  AND RLD_ESPDOC = G.GER_ESPDOC ';
    strSQLGer := strSQLGer + '  AND RLD_CODEMP = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';
  end
  else
  begin
    strSQLGer := strSQLGer + '  INNER JOIN FATGOR ';
    strSQLGer := strSQLGer + '  ON (RLD_NUMDOC = FGO_NUMDOC ';
    strSQLGer := strSQLGer + '  AND RLD_ESPDOC = FGO_ESPDOC ';
    strSQLGer := strSQLGer + '  AND RLD_CODEMP = FGO_CODEMP) ';
    strSQLGer := strSQLGer + '  WHERE FGO_NUMFAT = G.GER_NUMDOC ';
    strSQLGer := strSQLGer + '  AND FGO_TIPFAT = G.GER_ESPDOC ';
    strSQLGer := strSQLGer + '  AND FGO_EMPFAT = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';
  end;

  strSQLGer := strSQLGer + fRetornaCampoTurno('DET_TURENT');
  strSQLGer := strSQLGer + ', "N" AS DELETA_DEVOLUCAO ';

  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(20)) AS ROMTRA ';
  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(3)) AS TRA_EMPDES ';

  if fCfgSis('MATDIS', varBoolean) then
  begin
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(30)) AS GER_LOCALI ';
    strSQLGer := strSQLGer + ', 0.00 AS GER_DISTAN ';
    strSQLGer := strSQLGer + ', 0.00 AS GER_TMPENT ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSQLGer := strSQLGer + ', 0 AS PRIORIDADE ';
    strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_LIBAPP ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQLGer := strSQLGer + ', CADCLI.CLI_CODRED ';
  strSQLGer := strSQLGer + ', CADCLI.CLI_CODCAC ';
  strSQLGer := strSQLGer + ', CADCLI.CLI_FANSOB ';
  strSQLGer := strSQLGer + ', CADCLI.CLI_ORIENT ';
  strSQLGer := strSQLGer + ', CAC.CAC_CORILP ';
  strSQLGer := strSQLGer + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSQLGer := strSQLGer + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQLGer := strSQLGer + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQLGer := strSQLGer + ', MOVDET.DET_CLAFIS ';
  strSQLGer := strSQLGer + ', ' +  fSQLBarDoc('G.GER') + ' AS BARDOC ';

  strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQLGer := strSQLGer + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQLGer := strSQLGer + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQLGer := strSQLGer + 'FROM ';
  strSQLGer := strSQLGer + '  MOVGER G ';
  strSQLGer := strSQLGer + '  INNER JOIN MOVDET ON MOVDET.DET_SEQGER = G.AUTOINCREM ';
  strSQLGer := strSQLGer + '  INNER JOIN MOVTRI ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ';
  strSQLGer := strSQLGer + '  INNER JOIN CADCLI ON G.GER_CODCLI      = CLI_CODCLI ';
  strSQLGer := strSQLGer + '  INNER JOIN CADCID ON CADCID.CID_CODCID = IF(G.GER_CIDCON IS NULL, CLI_CODCID, G.GER_CIDCON) ';
  strSQLGer := strSQLGer + '   LEFT JOIN CADTRA ON G.GER_CODTRA      = CADTRA.TRA_CODTRA ';
  strSQLGer := strSQLGer + '   LEFT JOIN CADFPG ON G.GER_CODFPG      = FPG_CODIGO ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA MOVGER *}
  {************************************FC}
  strSQLGer := strSQLGer + 'LEFT JOIN AUXMOV        ON (AUXMOV.AUX_SEQGER = G.AUTOINCREM)      ';
  strSQLGer := strSQLGer + 'LEFT JOIN MOVOBS        ON (MOVOBS.MOV_SEQGER = G.AUTOINCREM)      ';
  strSQLGer := strSQLGer + 'LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXMOV.AUX_ENTGER) ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = ECMOV.ETC_CIDENT)  ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

  strSQLGer := strSQLGer + ' LEFT JOIN CADFIS ON FIS_NUMDOC = G.GER_NUMDOC ';
  strSQLGer := strSQLGer + '                 AND FIS_ESPDOC = G.GER_ESPDOC ';
  strSQLGer := strSQLGer + '                 AND FIS_CODEMP = G.GER_CODEMP ';
  strSQLGer := strSQLGer + '                 AND FIS_FORCLI = G.GER_CODCLI ';
  strSQLGer := strSQLGer + '                 AND FIS_TIP_FC = G.GER_TIP_FC ';

  {*****************************************}
  {* VERIFICA SE O DOCUMENTO NÃO ESTÁ CON- *}
  {* FIRMADO (ATRAVÉS DO NOTGER).          *}
  {**************************************MV*}
  strSQLGer := strSQLGer + 'LEFT JOIN NOTGER N ON G.GER_NUMFAT = N.GER_NUMDOC AND ';
  strSQLGer := strSQLGer + '                      G.GER_TIPFAT = N.GER_ESPDOC AND ';
  strSQLGer := strSQLGer + '                      G.GER_EMPFAT = N.GER_CODEMP AND ';
  strSQLGer := strSQLGer + '                      G.GER_CLIFAT = N.GER_CODCLI ';

  strSQLGer := strSQLGer + 'JOIN CADITE I ON I.ITE_CODITE = DET_CODITE ';

  // ** CADREG REGIAO **
  strSQLGer := strSQLGer + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECMOV.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECMOV.ETC_CODREG) ) ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  // ** DEPARTAMENTO VENDEDOR **
  strSQLGer := strSQLGer + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = G.GER_CODVEN ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSQLGer := strSQLGer + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = G.GER_CODCND   ';

  strSQLGer := strSQLGer + fJoinFatGor_ExtGor('MOVDET');

  //Entrega (Rota) selecionada
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSQLGer := strSQLGer + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSQLGer := strSQLGer + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;

  strSQLGer := strSQLGer + 'WHERE ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
    Begin
      strSQLGer := strSQLGer + '  FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSQLGer := strSQLGer + '      G.GER_NUMDOC = :NUMDOC ';
      strSQLGer := strSQLGer + '  AND G.GER_ESPDOC = :ESPDOC ';
      strSQLGer := strSQLGer + '  AND G.GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin

    strSQLGer := strSQLGer + '      G.GER_ENTFUT = "N" ';

    strSQLGer := strSQLGer + '  AND G.GER_ENTFAT = "S" ';

    strSQLGer := strSQLGer + '  AND ' + fRetCondicaoCFOP('G.GER_CLAFIS');
    strSQLGer := strSQLGer + '  AND G.GER_NUMROM IS NULL ';
    strSQLGer := strSQLGer + '  AND IFNULL(DET_CODEXT,"") = "" ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSQLGer := strSQLGer + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSQLGer := strSQLGer + ' AND G.' + IIF(rdbEntrega.Checked, 'GER_DTENTR', 'GER_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
    Else
      strSQLGer := strSQLGer + ' AND G.GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

    If (chkSomenteCliFil.Checked) Then
      strSQLGer := strSQLGer + ' AND G.GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSQLGer := strSQLGer + fStrLocate(edtCodCid    , arrCidade  , 'IF(G.GER_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), G.GER_CIDCON)','CODCID');
    strSQLGer := strSQLGer + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", G.GER_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
    strSQLGer := strSQLGer + fStrLocate(edtTraFat    , arrTraFat  , 'G.GER_CODTRA', 'TRAFAT');
    strSQLGer := strSQLGer + fStrLocate(edtCodReg    , arrRegiao  , 'ECMOV.ETC_CODREG', 'CODREG');
    strSQLGer := strSQLGer + fStrLocate(edtCodVen    , arrVended  , 'G.GER_CODVEN', 'CODVEN');
    strSQLGer := strSQLGer + fStrLocate(edtCodDep    , arrDepVen  , 'DEP_CODIGO', 'CODDEP');
    strSQLGer := strSQLGer + fStrLocate(edtCodCliente, arrClientes, 'G.GER_CODCLI', 'CODCLI');
    strSQLGer := strSQLGer + fStrLocate(edtCodProduto, arrProdutos, 'MOVDET.DET_CODITE', 'CODITE');
    If blnRegCid Then
      strSQLGer := strSQLGer + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    If (fCfgSis('CONENT') = 'S') and (fCfgSis('COENFI', varBoolean)) Then
    Begin

      If (fCfgSis('EMPGER', varBoolean)) Then
      Begin
        strSQLGer := strSQLGer + ' AND (G.GER_CODEMP = ' + QuotedStr(fCfgSis('EMPMAT')) + ' OR ';
        strSQLGer := strSQLGer + '      G.GER_CONENT = "S") ';
      End
      Else
      Begin
        strSQLGer := strSQLGer + ' AND G.GER_CONENT = "N" ';
        strSQLGer := strSQLGer + ' AND G.GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
      End;

    End;

    {*****************************************}
    {* FILTRO DE LINHA E GRUPO               *}
    {**************************************MV*}
    strSQLGer := strSQLGer + fSQLFiltroLinGru('DET');

    if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
    Begin
      strSQLGer := strSQLGer + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
      strSQLGer := strSQLGer + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
      strSQLGer := strSQLGer + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
      strSQLGer := strSQLGer + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
      strSQLGer := strSQLGer + '                AND RLD_NUMDOC = DET_NUM_PD                        ';
      strSQLGer := strSQLGer + '                AND RLD_ESPDOC = DET_ESP_PD                        ';
      strSQLGer := strSQLGer + '                AND RLD_CODEMP = DET_EMP_PD )                      ';
    End;

  End;

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSQLGer := strSQLGer + '  AND NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSQLGer := strSQLGer + '                   FROM ROMGERX GERX ';
    strSQLGer := strSQLGer + '                  INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSQLGer := strSQLGer + '                  WHERE GERX.GER_CODEMP = G.GER_CODEMP ';
    strSQLGer := strSQLGer + '                    AND GERX.GER_NUMDOC = G.GER_NUMDOC ';
    strSQLGer := strSQLGer + '                    AND GERX.GER_ESPDOC = G.GER_ESPDOC ';
    strSQLGer := strSQLGer + '  ) ';
  End;

  If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
    strSQLGer := strSQLGer + '  AND DET_PROEMB <> "S" ';

  If fCfgSis('CLBUEF',varboolean) Then
    strSQLGer := strSQLGer + '  AND DET_CLIBUS = "N" ';

  strSQLGer := strSQLGer + '  AND G.GER_ESPDOC IN ("NF", "EL", "IF", "IV", "D1", "MI", "FF"' + IIF(fEntraTR_BR_Romaneio, ' ,"BR" ','') +
    IIF(fEntraEP_Romaneio, ', "EP"', '') + IIF(blnListGC, ', "GC"', '') + ') ';
  strSQLGer := strSQLGer + '  AND IF( G.GER_CIDCON IS NULL, CLI_CODCID, G.GER_CIDCON) = CADCID.CID_CODCID ';

  if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) then
  begin
    strSQLGer := strSQLGer + ' AND (' + fRetSQLFiltroEmpresas('DET_EMP_PD') + ') ';
    strSQLGer := strSQLGer + ' AND G.GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';
  end
  else
    strSQLGer := strSQLGer + ' AND (' + fRetSQLFiltroEmpresas('G.GER_CODEMP') + ') ';

  strSQLGer := strSQLGer + fDocumentoRemovidoNaoConferidoVolume('G', 'GER');

  strSQLGer := strSQLGer + ' AND DET_CODITE <> :ITESER AND DET_CODITE <> :SERTER ';

  strSQLGer := strSQLGer + 'GROUP BY ';
  strSQLGer := strSQLGer + '  G.GER_NUMDOC, G.GER_ESPDOC, G.GER_CODEMP, G.GER_CODCLI ';
  strSQLGer := strSQLGer + 'HAVING ';
  strSQLGer := strSQLGer + '  TRIM(REPLACE(GROUP_CONCAT(IFNULL( N.GER_NUMROM, "")), ",", "")) = "" ';

  If (rdgTurno.ItemIndex <> 3) Then
    strSQLGer := strSQLGer + ' AND ' + AnsiReplaceStr(fRetornaWhereTurno(), 'HAVING', '');

  strSQLGer := strSQLGer + fGetWhereDocsExpedidos('G', True);

  {NOTGER}
  strSelect := '';
  strSelect := strSelect + 'SELECT ';
  strSelect := strSelect + fRetSQLDocRetornadoRomaneio('NG.GER') + ' AS GER_RETROM, ';
  strSelect := strSelect + '  NG.GER_CONPAG AS GER_CONPAG, ';
  strSelect := strSelect + '  NG.GER_CODFPG AS GER_CODFPG, ';
  strSelect := strSelect + '  " "           AS GER_TIPOPE, ';
  strSelect := strSelect + '  " "           AS GER_FPGNEG, ';
  strSelect := strSelect + '  "N"           AS GER_ORIF11, ';
  strSelect := strSelect + '  0.00          AS GER_TOTBRI, ';
  strSelect := strSelect + '  0.00          AS GER_VALREC, ';
  strSelect := strSelect + '  0.00          AS GER_BOLADT, ';
  strSelect := strSelect + '  "N"           AS GER_BOLVEN, ';
  strSelect := strSelect + '  0.00          AS GER_VALADT, ';
  strSelect := strSelect + '  NG.GER_VLRCON AS GER_CONORI, ';
  strSelect := strSelect + '  NG.GER_DTAENT, ';
  strSelect := strSelect + '  NG.GER_HORENT, ';
  strSelect := strSelect + '  NG.GER_DTENTR, ';
  strSelect := strSelect + '  CONCAT( NG.GER_NUMDOC, "-", NG.GER_ESPDOC ), ';
  strSelect := strSelect + '  NG.GER_NUMDOC, ';
  strSelect := strSelect + '  NG.GER_ESPDOC, ';
  strSelect := strSelect + '  NG.GER_CODEMP, ';
  strSelect := strSelect + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSelect := strSelect + '  NG.GER_CODCLI, ';
  strSelect := strSelect + '  IF( NG.GER_NOMCON IS NULL, CLI_NOMCLI, NG.GER_NOMCON), ';
  strSelect := strSelect + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSelect := strSelect + '  NG.GER_CLAFIS, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXNOT','NG')+', CIDNOT.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXNOT','NG')+', CIDNOT.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXNOT','NG')+', CIDNOT.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSelect := strSelect + '  NG.GER_TIPFRE, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXNOT','NG')+', ECNOT.ETC_BAIENT, COALESCE(NG.GER_BAICON, CADCLI.CLI_BAIRRO)) AS GER_BAIRRO, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXNOT','NG')+', ECNOT.ETC_ENDENT, COALESCE(NG.GER_ENDCON, CADCLI.CLI_ENDERE)) AS GER_ENDCON, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXNOT','NG')+', ECNOT.ETC_LATLON, " ") AS GER_LATLON, ';
