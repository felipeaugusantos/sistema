procedure TfrmFatRomaneio.pDisparaMensagensAutomatico;
var
  objDadosDisparoAutomatico: TDadosDisparoAutomatico;
begin
  for objDadosDisparoAutomatico in objListDadosDisparoAutomatico do
  begin
    If (Pos(fCfgSis('TIPEXP', varString), '2_3_4_') > 0) Then
    Begin
      fDisparaWhatsappAutomatico(objDadosDisparoAutomatico.strNumDoc,
                                 'RI',
                                 objDadosDisparoAutomatico.strEspDoc,
                                 objDadosDisparoAutomatico.strNumPed,
                                 'PD',
                                 objDadosDisparoAutomatico.strEmpPed,
                                 objDadosDisparoAutomatico.strCodCli,
                                 '',
                                 False,
                                 '',
                                 nil,
                                 '',
                                 '',
                                 '',
                                 Self.UnitName);

      fDisparaEmailAutomatico(objDadosDisparoAutomatico.strNumDoc,
                              'RI',
                              objDadosDisparoAutomatico.strEspDoc,
                              objDadosDisparoAutomatico.strNumPed,
                              'PD',
                              objDadosDisparoAutomatico.strEmpPed,
                              objDadosDisparoAutomatico.strCodCli
                             );

      fDisparaSMSAutomatico(objDadosDisparoAutomatico.strNumDoc,
                            'RI',
                            objDadosDisparoAutomatico.strEspDoc,
                            objDadosDisparoAutomatico.strNumPed,
                            'PD',
                            objDadosDisparoAutomatico.strEmpPed,
                            objDadosDisparoAutomatico.strCodCli,
                            '',
                            False
                           );
    End
    Else If (Pos(fCfgSis('TIPEXP', varString), '5_') > 0) Then
    Begin
      fDisparaWhatsappAutomatico(objDadosDisparoAutomatico.strNumDoc,
                                 'E5',
                                 objDadosDisparoAutomatico.strEspDoc,
                                 '',
                                 'IN',
                                 '',
                                 objDadosDisparoAutomatico.strCodCli,
                                 '',
                                 False,
                                 '',
                                 nil,
                                 '',
                                 '',
                                 '',
                                 Self.UnitName);

      fDisparaEmailAutomatico(objDadosDisparoAutomatico.strNumDoc,
                              'E5',
                              objDadosDisparoAutomatico.strEspDoc,
                              '',
                              'IN',
                              '',
                              objDadosDisparoAutomatico.strCodCli
                             );

      fDisparaSMSAutomatico(objDadosDisparoAutomatico.strNumDoc,
                            'E5',
                            objDadosDisparoAutomatico.strEspDoc,
                            '',
                            'IN',
                            '',
                            objDadosDisparoAutomatico.strCodCli,
                            '',
                            False
                           );
    End
    Else
      Break;
  end;
  
  objListDadosDisparoAutomatico.Clear;
end;

