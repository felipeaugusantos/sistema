  pCriarFormularios(TfrmFatRomManutEntrega, frmFatRomManutEntrega);

  try
    frmFatRomManutEntrega.edtNumDoc.Enabled := False;
    frmFatRomManutEntrega.edtNumDoc.Text := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
    frmFatRomManutEntrega.edtEspDoc.Text := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
