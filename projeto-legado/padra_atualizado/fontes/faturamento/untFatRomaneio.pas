procedure TfrmFatRomaneio.pConsultar(blnManutEntrega: Boolean = False);
Var
  blnConfirma  : Boolean;
  intOpc       : Integer;
begin

  inherited;

  blnConfirma := False;

  If (fVerificaCampos) And
     (fTravaRomaneio)  And
     (fTravaDocsRomaneio(edtNumRom.Text, objLock)) Then
  Begin
    if blnManutEntrega then
      FManter := tmSelecionados
    else if fPermiteManterSelecao then
    begin
      intOpc := fMensagem(
        'ATENÇÃO',
        'Há documentos selecionados no grid. Selecione a operação desejada:',
        ['Carregar, mantendo a seleção atual', 'Carregar, limpando seleção atual'],
        1,      // intFocoBotao: Integer = 1;
        True,   // blnSaiComEsc: Boolean = False;
        1,      // intEstFon: Integer = 1;
        280,    // intWidBut: Integer = 0;
        False,  // blnAutosize: Boolean = False;
        0,      // intSomarTop: Integer=0;
        False,  // blnObrigaEsc: Boolean = False;
        False,  // blnOcultPainelBtn: Boolean = False;
        True,   // blnBtnSemImg : Boolean = False;
        0,      // intHeightOpc: Integer = 0;
        600,    // intFormWidth : Integer = 0;
        -1);    // intQtdLinha: Integer = -1;

      if intOpc = 0 then
        Exit;

      if intOpc = 1 then
        FManter := tmSelecionados
      else
      begin
        if Assigned(cdsTmpMantemSelecionado) then
          cdsTmpMantemSelecionado.EmptyDataSet;
        FManter := tmNenhum;
      end;
    end
    else
      FManter := tmNenhum;

    blnConfirma := fConfirmaComTelaProgresso;
  End;

  If Not blnConfirma Then
    pCancelaInclusao(False);

  pValidaConsulta;
end;

procedure TfrmFatRomaneio.pCopiaParaTemporaria(qryDados: TUniQuery; Var cdsDados: TUniClientDataSet; tpcTipCds: TTipoCds; blnDocsSemRom: Boolean);
  Var
    intCnt : Integer;
    fldTmp : TField;
    blnEditando : Boolean;
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
    strPenFin: String;
    strIncGor: String;
    arrFields: TArray<TRecSizeField>;

    //CAMPOS QUE MESMO PASSANDO CAST NÃO OBEDECEM A DEFINIÇÃO DE TAMANHO
    procedure pCarregaArrayTamanhoCampoPersonalizado(strName: String; intSize: Integer);
    begin
      SetLength(arrFields, Length(arrFields)+1);
      arrFields[Length(arrFields)-1].Name := strName;
      arrFields[Length(arrFields)-1].Size := intSize;
    end;
begin
  blnWasEnabled := Not cdsDados.ControlsDisabled;

  If blnWasEnabled Then
    pDisableControls(cdsDados, prcScroll);

  blnEditando := (Not fEmptyStr(edtNumRom.Text)) And (chbRomaneio.Checked);

  If (Not cdsDados.Active) Then
  Begin
    SetLength(arrFields, 0);
    pCarregaArrayTamanhoCampoPersonalizado('GER_PEDVEN', 255);

    cdsDados := fCriaClientDatset(qryDados, True, Nil, False, Nil, arrFields);
    pSetaClient(cdsDados);

    If cdsDados.FindField('GER_VLRCON') <> Nil Then
      TFloatField(cdsDados.FieldByName('GER_VLRCON')).DisplayFormat := '#,##0.00';

    If cdsDados.FindField('GER_VLRPRO') <> Nil Then
      TFloatField(cdsDados.FieldByName('GER_VLRPRO')).DisplayFormat := '#,##0.00';

    If cdsDados.FindField('GER_PESBRU') <> Nil Then
      TFloatField(cdsDados.FieldByName('GER_PESBRU')).DisplayFormat := '#,##0.000';

    If (cdsDados.FindField('GER_DTAENT') <> Nil) And
       (cdsDados.FieldByName('GER_DTAENT').DataType In [ftDate, ftDateTime]) Then
      TDateField(cdsDados.FieldByName('GER_DTAENT')).DisplayFormat := 'dd/mm/yyyy';

    If (cdsDados.FindField('GER_DTENTR') <> Nil) And
       (cdsDados.FieldByName('GER_DTENTR').DataType In [ftDate, ftDateTime]) Then
      TDateField(cdsDados.FieldByName('GER_DTENTR')).DisplayFormat := 'dd/mm/yyyy';

    If cdsDados.FindField('GER_TOTFRE') <> Nil Then
      TFloatField(cdsDados.FieldByName('GER_TOTFRE')).DisplayFormat := '#,##0.00';

    intIncremento := 0;
    intOrdImp     := 0;
  End;

  Screen.Cursor := crSQLWait;

  qryDados.First;
  While Not qryDados.Eof Do
  Begin

    If (blnEditando) And (tpcTipCds = tpcTmpDoc) Then
    Begin
      cdsDados.Filtered := False;
      cdsDados.Filter   :=                   '((GER_DOCORI = ' + QuotedStr(qryDados.FieldByName('GER_DOCORI').AsString) + ') AND ';
      cdsDados.Filter   := cdsDados.Filter + ' (GER_ESPDOC = ' + QuotedStr(qryDados.FieldByName('GER_ESPDOC').AsString) + ') AND ';
      cdsDados.Filter   := cdsDados.Filter + ' (GER_CODEMP = ' + QuotedStr(qryDados.FieldByName('GER_CODEMP').AsString) + ') AND ';
      cdsDados.Filter   := cdsDados.Filter + ' (GER_ENTSAI = ' + QuotedStr(qryDados.FieldByName('GER_ENTSAI').AsString) + '))';
      cdsDados.Filtered := True;

      Try
        If (cdsDados.RecordCount > 0) And (Not fUsaRomaneioDocsExpedidos) Then
        Begin
          qryDados.Next;
          Continue;
        End;
      Finally
        cdsDados.Filter   := '';
        cdsDados.Filtered := False;
      End;
    End;

    If (tpcTipCds = tpcTmpDoc) And (blnDocsSemRom)              And
       (qryDados.FieldByName('GER_ESPDOC').AsString = 'PD')     And
       (fEmptyStr(qryDados.FieldByName('GER_INCFUT').AsString)) And
       (Not fCfgSis('ROPDFI', varBoolean)) Then
    Begin
      If (qryDados.FieldByName('GER_CODFPG').AsString = '016') Then
        strIncGor := fCampoTabela('AUTOINCREM', 'FATGOR',
                                  ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP','FGO_CODCLI'],
                                  [qryDados.FieldByName('GER_DOCORI').AsString,
                                   qryDados.FieldByName('GER_ESPDOC').AsString,
                                   qryDados.FieldByName('GER_CODEMP').AsString,
                                   qryDados.FieldByName('GER_CODCLI').AsString])
      Else
        strIncGor := '';

      If Not fPedidoOriginalJaFaturado(qryDados.FieldByName('GER_DOCORI').AsString, qryDados.FieldByName('GER_ESPDOC').AsString, qryDados.FieldByName('GER_CODEMP').AsString, qryDados.FieldByName('GER_CODCLI').AsString, True) then
      Begin
        If Not fValidaSituacaoFinanceiraPedido(qryDados.FieldByName('GER_CODCLI').AsString,
                                               qryDados.FieldByName('GER_ESPDOC').AsString,
                                               qryDados.FieldByName('GER_CODFPG').AsString,
                                               qryDados.FieldByName('GER_CONPAG').AsString,
                                               qryDados.FieldByName('GER_FPGNEG').AsString,
                                               strIncGor,
                                               qryDados.FieldByName('GER_TIPOPE').AsString,
                                               qryDados.FieldByName('GER_ORIF11').AsString = 'S',
                                               qryDados.FieldByName('GER_CONORI').AsFloat - qryDados.FieldByName('GER_TOTBRI').AsFloat,
                                               fFormataFloat(qryDados.FieldByName('GER_VALADT').AsFloat + qryDados.FieldByName('GER_VALREC').AsFloat, 2),
                                               qryDados.FieldByName('GER_BOLADT').AsFloat,
                                               qryDados.FieldByName('GER_BOLVEN').AsString = 'S',
                                               False, // fEmptyStr(qryDados.FieldByName('GER_INCFUT').AsString)
                                               strPenFin) Then
        Begin
          qryDados.Next;
          Continue;
        End;
      End;
    End;

    intIncremento := intIncremento + 1;

    cdsDados.Append;
    For intCnt := 0 To qryDados.FieldCount -1 Do
    Begin
      If (Not qryDados.Fields[intCnt].IsNull) Then
      Begin
        fldTmp := cdsDados.FindField(qryDados.Fields[intCnt].FieldName);
        If fldTmp <> Nil Then
          cdsDados.FieldByName(fldTmp.FieldName).Value := qryDados.Fields[intCnt].Value;
      End;
    End;
    If tpcTipCds = tpcTmpDoc Then
      cdsDados.FieldByName('INCREMENTO').AsInteger := intIncremento;
    cdsDados.Post;

    If (tpcTipCds = tpcTmpDoc) And
       (qryDados.FieldByName('GER_MARDES').AsString = 'M') Then
    Begin
      If (StlBkpDocs.IndexOf(Concat(qryDados.FieldByName('GER_DOCORI').AsString, '-',
                                    qryDados.FieldByName('GER_ESPDOC').AsString, '-',
                                    qryDados.FieldByName('GER_CODEMP').AsString, '-',
                                    qryDados.FieldByName('GER_AUTINC').AsString, '-',
                                    qryDados.FieldByName('GER_ENTSAI').AsString)) < 0) Then
        StlBkpDocs.Add(Concat(qryDados.FieldByName('GER_DOCORI').AsString, '-',
                              qryDados.FieldByName('GER_ESPDOC').AsString, '-',
                              qryDados.FieldByName('GER_CODEMP').AsString, '-',
                              qryDados.FieldByName('GER_AUTINC').AsString, '-',
                              qryDados.FieldByName('GER_ENTSAI').AsString));
    End;

    if fCfgSis('FUSUSA', varBoolean) and (tpcTipCds = tpcTmpDoc) then
    begin
      SetLength(arrFusion, Length(arrFusion) + 1);

      arrFusion[Length(arrFusion) - 1].strNumDoc := qryDados.FieldByName('GER_DOCORI').AsString;
      arrFusion[Length(arrFusion) - 1].strEspDoc := qryDados.FieldByName('GER_ESPDOC').AsString;
      arrFusion[Length(arrFusion) - 1].strCodEmp := qryDados.FieldByName('GER_CODEMP').AsString;
      arrFusion[Length(arrFusion) - 1].strIntFus := qryDados.FieldByName('GER_INTFUS').AsString;
      arrFusion[Length(arrFusion) - 1].strRomFus := qryDados.FieldByName('GER_ROMFUS').AsString;
      arrFusion[Length(arrFusion) - 1].strLatLon := qryDados.FieldByName('GER_LATLON').AsString;

      if FstrIntFus = 'N' then
        FstrIntFus := qryDados.FieldByName('GER_INTFUS').AsString;
    end;

    qryDados.Next;
  End;

  Screen.Cursor         := crDefault;

  If blnWasEnabled Then
    pEnableControls(cdsDados, prcScroll);

  If tpcTipCds = tpcTmpDoc Then
    dtsTmpDoc.DataSet        := cdsTmpDoc;
end;

procedure TfrmFatRomaneio.pCriaClientOutEnt;
begin
  cdsOutEnt := TUniClientDataSet.Create(Self);

  With cdsOutEnt.FieldDefs.AddFieldDef Do
  Begin
    Name     := 'DESCRI';
    DataType := ftString;
    Size     := 4000;
  End;

  With cdsOutEnt.FieldDefs.AddFieldDef Do
  Begin
    Name     := 'SEQDIG';
    DataType := ftString;
    Size     := 20;
  End;

  cdsOutEnt.CreateDataSet;
  cdsOutEnt.Open;
end;

