  strSQL := strSQL + '  IF('+fEnderecoPelaEntCli('','R')+',';
  strSQL := strSQL + '     COALESCE(ECMOV.ETC_LATLON, ';
  strSQL := strSQL + '              ECNOT.ETC_LATLON, ';
  strSQL := strSQL + '              ECGOR.ETC_LATLON), " " ';
  strSQL := strSQL + '  ) AS GER_LATLON, ';

  strSQL := strSQL + '  IF('+fEnderecoPelaEntCli('','R')+',';
