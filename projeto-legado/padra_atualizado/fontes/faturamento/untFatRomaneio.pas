    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSQL := strSQL + ', 0 AS PRIORIDADE ';
    strSQL := strSQL + ', R.GER_LIBAPP ';
    strSQL := strSQL + ', R.GER_EVITAR ';
    strSQL := strSQL + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQL := strSQL + ', R.GER_FILIAL ';
    strSQL := strSQL + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQL := strSQL + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQL := strSQL + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQL := strSQL + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQL := strSQL + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQL := strSQL + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQL := strSQL + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQL := strSQL + ', CADCLI.CLI_CODRED ';
  strSQL := strSQL + ', CADCLI.CLI_CODCAC ';
  strSQL := strSQL + ', CADCLI.CLI_FANSOB ';
  strSQL := strSQL + ', CADCLI.CLI_ORIENT ';
  strSQL := strSQL + ', CAC.CAC_CORILP ';
  strSQL := strSQL + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSQL := strSQL + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQL := strSQL + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_REFCON_BAK ';

  If (Pos(strOpcRom, '1_5_') <= 0) Then
  Begin
    strSQL := strSQL + ', MOVDET.DET_CLAFIS ';
    strSQL := strSQL + ', ' +  fSQLBarDoc('G.GER') + ' AS BARDOC ';
  End
  Else
  Begin
    strSQL := strSQL + ', FATDOR.FDO_CLAFIS AS DET_CLAFIS ';
    strSQL := strSQL + ', ' +  fSQLBarDoc('PD.FGO') + ' AS BARDOC ';
  End;

  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQL := strSQL + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQL := strSQL + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  ROMTRAX  ';
  strSQL := strSQL + '  INNER JOIN ROMGERX R  ON R.AUTOINCREM      = ROMTRAX.TRA_SEQGER ';
  strSQL := strSQL + '  LEFT JOIN CADCLI      ON R.GER_CODCLI      = CLI_CODCLI ';
  strSQL := strSQL + '  LEFT JOIN CADCID      ON CADCID.CID_CODCID = IF(R.GER_CIDCON IS NULL, CLI_CODCID, R.GER_CIDCON) ';
  strSQL := strSQL + '  LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSQL := strSQL + '  LEFT JOIN CADTRA TRAROM ON R.GER_CODTRA    = TRAROM.TRA_CODTRA  ';
  strSQL := strSQL + '  LEFT JOIN CADFPG      ON R.GER_CODFPG      = FPG_CODIGO ';

  strSQL := strSQL + '  LEFT JOIN MOVGER G ON G.GER_NUMDOC = R.GER_NUMDOC AND ';
  strSQL := strSQL + '                        G.GER_ESPDOC = R.GER_ESPDOC AND ';
  strSQL := strSQL + '                        G.GER_CODEMP = R.GER_CODEMP AND ';
  strSQL := strSQL + '                        G.GER_CODCLI = R.GER_CODCLI ';

  strSQL := strSQL + '  LEFT JOIN MOVOBS   ON (MOVOBS.MOV_SEQGER = G.AUTOINCREM) ';

  strSQL := strSQL + '  LEFT JOIN CADFIS ON FIS_NUMDOC = G.GER_NUMDOC ';
  strSQL := strSQL + '                  AND FIS_ESPDOC = G.GER_ESPDOC ';
  strSQL := strSQL + '                  AND FIS_CODEMP = G.GER_CODEMP ';
  strSQL := strSQL + '                  AND FIS_FORCLI = G.GER_CODCLI ';
  strSQL := strSQL + '                  AND FIS_TIP_FC = G.GER_TIP_FC ';

  strSQL := strSQL + '  LEFT JOIN NOTGER N ON N.GER_NUMDOC = R.GER_NUMDOC AND ';
  strSQL := strSQL + '                        N.GER_ESPDOC = R.GER_ESPDOC AND ';
  strSQL := strSQL + '                        N.GER_CODEMP = R.GER_CODEMP AND ';
  strSQL := strSQL + '                        N.GER_CODCLI = R.GER_CODCLI ';

  strSQL := strSQL + '  LEFT JOIN FATGOR PD ON PD.FGO_NUMDOC = R.GER_NUMDOC AND ';
  strSQL := strSQL + '                         PD.FGO_ESPDOC = R.GER_ESPDOC AND   ';
  strSQL := strSQL + '                         PD.FGO_CODEMP = R.GER_CODEMP AND   ';
  strSQL := strSQL + '                         PD.FGO_CODCLI = R.GER_CODCLI       ';

  strSQL := strSQL + ' LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = R.GER_CODVEN ';

  If (Pos(strOpcRom, '1_5_') <= 0) Then Begin
    strSQL := strSQL + '  LEFT JOIN MOVDET    ON MOVDET.DET_SEQGER = G.AUTOINCREM ';
    strSQL := strSQL + '  LEFT JOIN MOVTRI    ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
  End Else Begin
    strSQL := strSQL + '  LEFT JOIN FATDOR   ON FDO_SEQGER = PD.AUTOINCREM ';
    strSQL := strSQL + '  LEFT JOIN EXTDOR   ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
  End;

  strSQL := strSQL + '  LEFT JOIN OUTDIGX   ON R.GER_EMPROM = OUTDIGX.DIG_EMPROM AND ';
  strSQL := strSQL + '                         R.GER_NUMROM = OUTDIGX.DIG_NUMROM     ';

  {***************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA ROMGERX *}
  {*************************************BL}
  strSQL := strSQL + 'LEFT JOIN CADCID CIDENT ON (R.GER_CIDENT = CIDENT.CID_CODCID) ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA MOVGER *}
  {************************************FC}
  strSQL := strSQL + 'LEFT JOIN AUXMOV        ON (AUXMOV.AUX_SEQGER = G.AUTOINCREM) ';
  strSQL := strSQL + 'LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXMOV.AUX_ENTGER) ';
  strSQL := strSQL + 'LEFT JOIN CADCID CIDCLI ON (CIDCLI.CID_CODCID = ECMOV.ETC_CIDENT) ';
  strSQL := strSQL + 'LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = G.GER_CIDCON) ';
  strSQL := strSQL + 'LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA NOTGER *}
  {************************************FC}
  strSQL := strSQL + 'LEFT JOIN AUXNOT         ON (AUXNOT.AUX_SEQGER  = N.AUTOINCREM) ';
  strSQL := strSQL + 'LEFT JOIN ENTCLI ECNOT   ON (ECNOT.AUTOINCREM   = AUXNOT.AUX_ENTGER) ';
  strSQL := strSQL + 'LEFT JOIN CADCID CIDCLIN ON (CIDCLIN.CID_CODCID = ECNOT.ETC_CIDENT) ';
  strSQL := strSQL + 'LEFT JOIN CADCID CIDNOT  ON (CIDNOT.CID_CODCID  = N.GER_CIDCON) ';
  strSQL := strSQL + 'LEFT JOIN CADTRA TRANOT  ON (ECNOT.ETC_CODTRA   = TRANOT.TRA_CODTRA) ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA FATGOR *}
  {************************************FC}
  strSQL := strSQL + 'LEFT JOIN AUXGOR         ON (AUXGOR.AUX_SEQGER  = PD.AUTOINCREM) ';
  strSQL := strSQL + 'LEFT JOIN ENTCLI ECGOR   ON (ECGOR.AUTOINCREM   = AUXGOR.AUX_ENTGER) ';
  strSQL := strSQL + 'LEFT JOIN CADCID CIDCLIG ON (CIDCLIG.CID_CODCID = ECGOR.ETC_CIDENT) ';
  strSQL := strSQL + 'LEFT JOIN CADCID CIDGOR  ON (CIDGOR.CID_CODCID  = PD.FGO_CIDCON) ';
  strSQL := strSQL + 'LEFT JOIN CADTRA         ON (PD.FGO_CODTRA      = CADTRA.TRA_CODTRA) ';
  strSQL := strSQL + 'LEFT JOIN CADTRA TRAGOR  ON (ECGOR.ETC_CODTRA   = TRAGOR.TRA_CODTRA) ';
  strSQL := strSQL + 'LEFT JOIN EXTGOR         ON (PD.AUTOINCREM = EXTGOR.FGO_SEQFGO) ';

  strSQL := strSQL + 'LEFT JOIN CADREG ON (REG_CODREG = IF((ECMOV.ETC_CODREG IS NOT NULL OR ' +
                                                          ' ECNOT.ETC_CODREG IS NOT NULL OR ' +
                                                          ' ECGOR.ETC_CODREG IS NOT NULL),  ' +
                                                          '   COALESCE(ECMOV.ETC_CODREG,    ' +
                                                          '            ECNOT.ETC_CODREG,    ' +
                                                          '            ECGOR.ETC_CODREG),   ' +
                                                          '   CADCLI.CLI_CODREG))           ';
  strSQL := strSQL + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  strSQL := strSQL + 'LEFT JOIN CADTRA TRADOC ON TRADOC.TRA_CODTRA = COALESCE(G.GER_CODTRA,        ' +
                                                                 '            N.GER_CODTRA,       ' +
                                                                 '            PD.FGO_CODTRA)       ';

  strSQL := strSQL + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = COALESCE(G.GER_CODCND,  ' +
                                                           '            N.GER_CODCND,  ' +
                                                           '            PD.FGO_CODCND) ';

  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSQL := strSQL + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSQL := strSQL + ' AND ENT_CODEMP = PD.FGO_CODEMP ';
  end;

  strSQL := strSQL + 'WHERE TRUE ';

  strSQL := strSQL + '  AND R.GER_TIPDOC = "E" ';

  strSQL := strSQL + '  AND TRA_DTAREC IS NOT NULL ';
  strSQL := strSQL + '  AND TRA_SEQ_BX IS NULL ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fCfgSis('MODROM', varString) = '1') Then
    Begin
      strSQL := strSQL + '  AND FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSQL := strSQL + '  AND R.GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '  AND R.GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '  AND R.GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin
    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSQL := strSQL + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
    Begin
      If rdbEntrega.Checked Then  //ROMGERX não tem data de entrega, então busca pelo documento
        strSQL := strSQL + ' AND IFNULL(PD.FGO_DTENTR, IFNULL(G.GER_DTENTR, N.GER_DTENTR)) BETWEEN :DTAINI AND :DTAFIN '
      Else
        strSQL := strSQL + ' AND R.GER_DTAENT BETWEEN :DTAINI AND :DTAFIN ';
    End
    Else
      strSQL := strSQL + ' AND R.GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

    If (chkSomenteCliFil.Checked) Then
      strSQL := strSQL + ' AND R.GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSQL := strSQL + fStrLocate(edtCodCid    , arrCidade  , 'IF(GER_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), GER_CIDCON)','CODCID');
    strSQL := strSQL + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", GER_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
    strSQL := strSQL + fStrLocate(edtTraFat    , arrTraFat  , 'COALESCE(TRAMOV.TRA_CODTRA, TRANOT.TRA_CODTRA, TRAGOR.TRA_CODTRA)', 'TRAFAT');
    strSQL := strSQL + fStrLocate(edtCodReg    , arrRegiao  , 'ECMOV.ETC_CODREG', 'CODREG');
    strSQL := strSQL + fStrLocate(edtCodVen    , arrVended  , 'R.GER_CODVEN', 'CODVEN');
    strSQL := strSQL + fStrLocate(edtCodCliente, arrClientes, 'R.GER_CODCLI', 'CODCLI');
    If blnRegCid Then
      strSQL := strSQL + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    If not fEmptyStr( strDocCaixa ) Then
      strSQL := strSQL + ' AND (LOCATE(MOVGER.AUTOINCREM, "'+strDocCaixa+'") > 0) ';
  End;

  If (Pos(strOpcRom, '1_5_') <= 0) Then
    strSQL := strSQL + ' AND DET_CODITE <> :ITESER AND DET_CODITE <> :SERTER '
  Else
    strSQL := strSQL + ' AND FDO_CODITE <> :ITESER AND FDO_CODITE <> :SERTER ';

  strSQL := strSQL + fDocumentoRemovidoNaoConferidoVolume('R', 'GER');

  If (Pos(strOpcRom, '1_5_') <= 0) Then
    strSQL := strSQL + '  GROUP BY MOVDET.DET_SEQGER '
  Else
    strSQL := strSQL + '  GROUP BY FATDOR.FDO_SEQGER ';

  Result := strSQL;
end;

function TfrmFatRomaneio.fSQLTrocasSaida(strOpcRom: String): String;
  Var
    strSQL : String;
begin
  strSQL := '';
  strSQL := strSQL + '  SELECT ';
  strSQL := strSQL + fRetSQLDocRetornadoRomaneio('GER') + ' AS GER_RETROM, ';
  strSQL := strSQL + '    GER_CONPAG   AS GER_CONPAG, ';
  strSQL := strSQL + '    GER_CODFPG   AS GER_CODFPG, ';
  strSQL := strSQL + '    " "          AS GER_TIPOPE, ';
  strSQL := strSQL + '    " "          AS GER_FPGNEG, ';
  strSQL := strSQL + '    "N"          AS GER_ORIF11, ';
  strSQL := strSQL + '    0.00         AS GER_TOTBRI, ';
  strSQL := strSQL + '    0.00         AS GER_VALREC, ';
  strSQL := strSQL + '    0.00         AS GER_BOLADT, ';
  strSQL := strSQL + '    "N"          AS GER_BOLVEN, ';
  strSQL := strSQL + '    0.00         AS GER_VALADT, ';
  strSQL := strSQL + '    GER_VLRCON   AS GER_CONORI, ';
  strSQL := strSQL + '    DET_DTAENT, ';
  strSQL := strSQL + '    DET_HORENT, ';
  strSQL := strSQL + '    GER_DTENTR, ';
  strSQL := strSQL + '    CONCAT(DET_NUMDOC, "-", DET_ESPDOC ), ';
  strSQL := strSQL + '    DET_NUMDOC, ';
  strSQL := strSQL + '    DET_ESPDOC, ';
  strSQL := strSQL + '    DET_CODEMP, ';
  strSQL := strSQL + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSQL := strSQL + '    GER_CODCLI, ';
  strSQL := strSQL + '    IF( GER_NOMCON IS NULL, CLI_NOMCLI, GER_NOMCON), ';
  strSQL := strSQL + '    CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSQL := strSQL + '    GER_CLAFIS, ';

  strSQL := strSQL + '    IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSQL := strSQL + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSQL := strSQL + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSQL := strSQL + '    GER_TIPFRE, ';

  strSQL := strSQL + '    IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_BAIENT, GER_BAICON) AS GER_BAIRRO, ';
  strSQL := strSQL + '    IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_ENDENT, GER_ENDCON) AS GER_ENDCON, ';
  strSQL := strSQL + '    IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_LATLON, " ") AS GER_LATLON, ';
  strSQL := strSQL + '    IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_CEPENT, GER_CEPCON) AS GER_CEPCON, ';
  strSQL := strSQL + '    IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_REFENT, CADCLI.CLI_REFENT) AS GER_REFCON, ';

  strSQL := strSQL + '    DET_CODVEN, ';
  strSQL := strSQL + '    CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
  strSQL := strSQL + '    SUM((DET_UNITAR * (DET_QTDITE - IFNULL(DET_QTDROM, 0))) - ROUND(((DET_DESESP/DET_QTDITE) * (DET_QTDITE - IFNULL(DET_QTDROM, 0))), 2)) DET_TOTPRO, '; //DETIN
  strSQL := strSQL + '    SUM((DET_UNITAR * (DET_QTDITE - IFNULL(DET_QTDROM, 0))) - ROUND(((DET_DESESP/DET_QTDITE) * (DET_QTDITE - IFNULL(DET_QTDROM, 0))), 2)) DET_TOTPRO, '; //DETIN
  strSQL := strSQL + '    (GER_TOTPRO - GER_DESESP) GER_VLRPRO, ';
  strSQL := strSQL + '    GER_ROMIMP, ';
  strSQL := strSQL + '    "D" AS GER_MARDES, ';
  strSQL := strSQL + '    " " AS GER_VEICUL, ';

  strSQL := strSQL + fGetSQLPosObs('MOVGER','GER_NUMDOC','GER_ESPDOC','GER_CODEMP') + ' AS POSOBS, ';

  strSQL := strSQL + '    LPAD("", 15, " ") AS GER_PALET_, ';
  strSQL := strSQL + '    0.00 GER_VALSEL, ';
  strSQL := strSQL + '    0.00 GER_VSEPRO, ';
  strSQL := strSQL + '    GER_TIP_FC, ';
  strSQL := strSQL + '    0 GER_ORDIMP, ';
  strSQL := strSQL + '    " " GER_ALTERA, ';
  strSQL := strSQL + '    0 INCREMENTO, ';
  strSQL := strSQL + '    IF(IFNULL(TRAMOV.TRA_CODTRA,"") = "", CADTRA.TRA_CODTRA, TRAMOV.TRA_CODTRA) AS GER_CODTRA, ';
  strSQL := strSQL + '    IF(IFNULL(TRAMOV.TRA_NOMTRA,"") = "", CADTRA.TRA_NOMTRA, TRAMOV.TRA_NOMTRA) AS GER_TRANSP, ';
  strSQL := strSQL + '    CADTRA.TRA_NOMTRA AS GER_TRAFAT, ';
  strSQL := strSQL + '    GER_CODTRA  AS GER_TRADOC, ';
  strSQL := strSQL + '    GER_PESBRU, ';
  strSQL := strSQL + '    "MOVGER" AS GER_NOMTBL, ';
  strSQL := strSQL + '    MOVGER.AUTOINCREM AS GER_AUTINC, ';

  If (strOpcRom = '4') Then
  Begin
    strSQL := strSQL + '  "", ';
    strSQL := strSQL + '  "", ';
  End;

  strSQL := strSQL + '         GER_ORIDOC, ';
  strSQL := strSQL + '         CAST(' + fSQLTotDet('DET') + ' AS DECIMAL(15, 4)) GER_TOTDET, ';
  strSQL := strSQL + '         GER_NUMROM,  ';

  If (strOpcRom = '4') Then
    strSQL := strSQL + '  (SELECT GROUP_CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC) FROM FATGOR WHERE FGO_NUMFAT = GER_NUMDOC AND FGO_TIPFAT = GER_ESPDOC AND FGO_EMPFAT = GER_CODEMP), '
  Else
  Begin
    strSQL := strSQL + '         CONCAT(GER_NUMFAT, GER_TIPFAT, GER_EMPFAT, GER_CLIFAT) AS GER_NUMFAT, ';
    strSQL := strSQL + '         CONCAT(GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI) AS GER_DOCUME, ';
    strSQL := strSQL + '         (SELECT GROUP_CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC) FROM FATGOR WHERE FGO_NUMFAT = GER_NUMDOC AND FGO_TIPFAT = GER_ESPDOC AND FGO_EMPFAT = GER_CODEMP), ';
  End;

  strSQL := strSQL + fSQLVolume('DET', 'MOVGER') + ' AS GER_VOLUME, ';
  strSQL := strSQL + fSQLProfissionalCodigo('DET')  + ' AS GER_CODDIV, ';
  strSQL := strSQL + fSQLProfissionalNome('DET')  + ' AS GER_NOMDIV, ';
  strSQL := strSQL + '         MOV_OBSERV AS GER_NFEADC, ';
  strSQL := strSQL + '         " " AS GER_MENEXP, ';
  strSQL := strSQL + '         " " AS GER_MENEX2, ';
  strSQL := strSQL + '         " " AS GER_MENEX3, ';
  strSQL := strSQL + '         " " AS GER_MENEX4, ';
  strSQL := strSQL + '         " " AS ENTURG, ';
  strSQL := strSQL + '         GER_PRVIMP,  ';
  strSQL := strSQL + '         "S" AS GER_ENTSAI, ';
  strSQL := strSQL + '         FIS_ACESSO, ';
  strSQL := strSQL + '         GER_ENTFUT, ';
  strSQL := strSQL + '         GER_ENTFAT, ';
  strSQL := strSQL + '         GER_CONENT, ';
  strSQL := strSQL + '  "N" AS APENAS_ESTE, ';
  strSQL := strSQL + '  0 AS GER_VOLBIP, ';
  strSQL := strSQL + fRetSQLDescrRegiao;
  strSQL := strSQL + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';
  strSQL := strSQL + fRetSQLSeqRotaRegiao('IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID)');
  strSQL := strSQL + fSQLCampo('GER_BASSIM', '', 'MOVGER')           + ' AS GER_BASSIM, ';
  strSQL := strSQL + fSQLCampo('DET_BASIPI', 'GER_BASIPI', 'MOVGER') + ' AS GER_BASIPI, ';
  strSQL := strSQL + fSQLCampo('DET_VALIPI', 'GER_TOTIPI', 'MOVGER') + ' AS GER_TOTIPI, ';
  strSQL := strSQL + fSQLCampo('DET_BASICM', 'GER_BASICM', 'MOVGER') + ' AS GER_BASICM, ';
  strSQL := strSQL + fSQLCampo('DET_VALICM', 'GER_TOTICM', 'MOVGER') + ' AS GER_TOTICM, ';
  strSQL := strSQL + fSQLCampo('DET_VALRET', 'GER_TOTRET', 'MOVGER') + ' AS GER_TOTRET, ';
  strSQL := strSQL + fSQLCampo('DET_BASRET', 'GER_BASRET', 'MOVGER') + ' AS GER_BASRET, ';
  strSQL := strSQL + fSQLCampo('DET_DESESP', 'GER_DESESP', 'MOVGER') + ' AS GER_DESESP, ';
  strSQL := strSQL + fSQLCampo('DET_TOTCUS', 'GER_TOTCUS', 'MOVGER') + ' AS GER_TOTCUS, ';
  strSQL := strSQL + fSQLCampo('DET_TOTMED', 'GER_TOTMED', 'MOVGER') + ' AS GER_TOTMED, ';
  strSQL := strSQL + fSQLCampo('DET_TOTFRE', 'GER_TOTFRE', 'MOVGER') + ' AS GER_TOTFRE, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR01', '', 'MOVGER')           + ' AS GER_VPAR01, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR02', '', 'MOVGER')           + ' AS GER_VPAR02, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR03', '', 'MOVGER')           + ' AS GER_VPAR03, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR04', '', 'MOVGER')           + ' AS GER_VPAR04, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR05', '', 'MOVGER')           + ' AS GER_VPAR05, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR06', '', 'MOVGER')           + ' AS GER_VPAR06, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR07', '', 'MOVGER')           + ' AS GER_VPAR07, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR08', '', 'MOVGER')           + ' AS GER_VPAR08, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR09', '', 'MOVGER')           + ' AS GER_VPAR09, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR10', '', 'MOVGER')           + ' AS GER_VPAR10, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR11', '', 'MOVGER')           + ' AS GER_VPAR11, ';
  strSQL := strSQL + fSQLCampo('GER_VPAR12', '', 'MOVGER')           + ' AS GER_VPAR12, ';
  strSQL := strSQL + fSQLCampo('DET_TOTITE', 'GER_TOTPRO', 'MOVGER') + ' AS GER_TOTPRO, ';
  strSQL := strSQL + '  GER_CODCND, ';
  strSQL := strSQL + fRetornaCampoOrigemPedidoRetira('MOVGER');
  strSQL := strSQL + '  " " AS GER_ORIDEV, ';
  strSQL := strSQL + fRetornaInformacoesRota;
  strSQL := strSQL + '  " " AS DOC_FATURADOS, ';
  strSQL := strSQL + '  " " AS GER_INCFUT, ';
  strSQL := strSQL + '  " " AS TIPPED, ';
  strSQL := strSQL + '  1.00 AS GER_PERDEV, ';
  strSQL := strSQL + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSQL := strSQL + '  FROM ROMLGE ';
  strSQL := strSQL + '  INNER JOIN ROMLDE ';
  strSQL := strSQL + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
  strSQL := strSQL + '  WHERE RLD_NUMDOC = GER_NUMDOC ';
  strSQL := strSQL + '  AND RLD_ESPDOC = GER_ESPDOC ';
  strSQL := strSQL + '  AND RLD_CODEMP = GER_CODEMP LIMIT 1) AS ROMLOT, ';

  strSQL := strSQL + fRetornaCampoTurno('DET_TURENT');
  strSQL := strSQL + ', "N" AS DELETA_DEVOLUCAO ';

  strSQL := strSQL + ', CAST(" " AS CHAR(20)) AS ROMTRA ';
  strSQL := strSQL + ', CAST(" " AS CHAR(3)) AS TRA_EMPDES ';

  if fCfgSis('MATDIS', varBoolean) then
  begin
    strSQL := strSQL + ', CAST(" " AS CHAR(30)) AS GER_LOCALI ';
    strSQL := strSQL + ', 0.00 AS GER_DISTAN ';
    strSQL := strSQL + ', 0.00 AS GER_TMPENT ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSQL := strSQL + ', 0 AS PRIORIDADE ';
    strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_LIBAPP ';
    strSQL := strSQL + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSQL := strSQL + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSQL := strSQL + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQL := strSQL + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQL := strSQL + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQL := strSQL + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQL := strSQL + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQL := strSQL + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQL := strSQL + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQL := strSQL + ', CADCLI.CLI_CODRED ';
  strSQL := strSQL + ', CADCLI.CLI_CODCAC ';
  strSQL := strSQL + ', CADCLI.CLI_FANSOB ';
  strSQL := strSQL + ', CADCLI.CLI_ORIENT ';
  strSQL := strSQL + ', CAC.CAC_CORILP ';
  strSQL := strSQL + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSQL := strSQL + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQL := strSQL + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQL := strSQL + ', MOVDET.DET_CLAFIS ';
  strSQL := strSQL + ', ' +  fSQLBarDoc('GER') + ' AS BARDOC ';

  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQL := strSQL + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQL := strSQL + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQL := strSQL + '    FROM MOVDET ';
  strSQL := strSQL + '         INNER JOIN MOVGER   ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
  strSQL := strSQL + '         INNER JOIN MOVTRI   ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ';
  strSQL := strSQL + '         INNER JOIN CADCLI   ON DET_CODCLI        = CLI_CODCLI ';
  strSQL := strSQL + '         INNER JOIN CADCID   ON CADCID.CID_CODCID = IF(GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) ';
  strSQL := strSQL + '         INNER JOIN CADITE I ON I.ITE_CODITE      = DET_CODITE ';
  strSQL := strSQL + '          LEFT JOIN CADTRA   ON GER_CODTRA        = CADTRA.TRA_CODTRA ';
  strSQL := strSQL + '          LEFT JOIN CADFPG   ON GER_CODFPG        = FPG_CODIGO ';

  strSQL := strSQL + '    LEFT JOIN AUXMOV        ON (AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM) ';
  strSQL := strSQL + '    LEFT JOIN MOVOBS        ON (MOVOBS.MOV_SEQGER = MOVGER.AUTOINCREM) ';
  strSQL := strSQL + '    LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXMOV.AUX_ENTGER) ';
  strSQL := strSQL + '    LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = ECMOV.ETC_CIDENT)  ';
  strSQL := strSQL + '    LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

  strSQL := strSQL + '    LEFT JOIN CADFIS ON FIS_NUMDOC = GER_NUMDOC ';
  strSQL := strSQL + '                    AND FIS_ESPDOC = GER_ESPDOC ';
  strSQL := strSQL + '                    AND FIS_CODEMP = GER_CODEMP ';
  strSQL := strSQL + '                    AND FIS_FORCLI = GER_CODCLI ';
  strSQL := strSQL + '                    AND FIS_TIP_FC = GER_TIP_FC ';

  // ** CADREG REGIAO **
  strSQL := strSQL + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECMOV.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECMOV.ETC_CODREG) ) ';
  strSQL := strSQL + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  // ** DEPARTAMENTO VENDEDOR **
  strSQL := strSQL + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = MOVGER.GER_CODVEN ';
  strSQL := strSQL + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSQL := strSQL + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSQL := strSQL + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = MOVGER.GER_CODCND   ';

  strSQL := strSQL + fJoinFatGor_ExtGor('MOVDET');

  //Entrega (Rota) selecionada
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSQL := strSQL + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSQL := strSQL + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;

  strSQL := strSQL + '   WHERE ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
    Begin
      strSQL := strSQL + '  FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSQL := strSQL + '      GER_NUMDOC = :NUMDOC ';
      strSQL := strSQL + '  AND GER_ESPDOC = :ESPDOC ';
      strSQL := strSQL + '  AND GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin

    strSQL := strSQL + '        GER_ENTFUT = "N" ';
    strSQL := strSQL + '    AND GER_ENTFAT = "S" ';
    strSQL := strSQL + '    AND ' + fRetCondicaoCFOP('DET_CLAFIS');
    strSQL := strSQL + '    AND GER_NUMROM IS NULL ';
    strSQL := strSQL + '    AND IFNULL(DET_CODEXT,"") = "" ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSQL := strSQL + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Pos(strOpcRom, '1_5_') > 0) Then
      strSQL := strSQL + '   AND DET_JAFATU = 0 ';

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSQL := strSQL + ' AND ' + IIF(rdbEntrega.Checked, 'GER_DTENTR', 'GER_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
    Else
    Begin
      If (Pos(strOpcRom, '1_5_') > 0) Then
        strSQL := strSQL + '   AND DET_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' '
      Else
        strSQL := strSQL + '   AND GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';
    End;

    If (chkSomenteCliFil.Checked) Then
      strSQL := strSQL + ' AND GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSQL := strSQL + fStrLocate(edtCodCid    , arrCidade  , 'IF(GER_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), GER_CIDCON)','CODCID');
    strSQL := strSQL + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", GER_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
    strSQL := strSQL + fStrLocate(edtTraFat    , arrTraFat  , 'GER_CODTRA', 'TRAFAT');
    strSQL := strSQL + fStrLocate(edtCodReg    , arrRegiao  , 'ECMOV.ETC_CODREG', 'CODREG');
    strSQL := strSQL + fStrLocate(edtCodVen    , arrVended  , 'GER_CODVEN', 'CODVEN');
    strSQL := strSQL + fStrLocate(edtCodDep    , arrDepVen  , 'DEP_CODIGO', 'CODDEP');
    strSQL := strSQL + fStrLocate(edtCodCliente, arrClientes, 'GER_CODCLI', 'CODCLI');
    strSQL := strSQL + fStrLocate(edtCodProduto, arrProdutos, 'DET_CODITE', 'CODITE');
    If blnRegCid Then
      strSQL := strSQL + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    If (fCfgSis('CONENT', varBoolean)) and (fCfgSis('COENFI', varBoolean)) Then
    Begin
      If ((fCfgSis('EMPGER', varBoolean))) Then
      Begin
        strSQL := strSQL + ' AND (GER_CODEMP = ' + QuotedStr(fCfgSis('EMPMAT')) + ' OR ';
        strSQL := strSQL + '      GER_CONENT = "S") ';
      End
      Else
      Begin
        strSQL := strSQL + ' AND GER_CONENT = "N" ';
        strSQL := strSQL + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
      End;
    End;

    strSQL := strSQL + fSQLFiltroLinGru('DET');

    if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
    Begin
      strSQL := strSQL + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
      strSQL := strSQL + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
      strSQL := strSQL + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
      strSQL := strSQL + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
      strSQL := strSQL + '                AND RLD_NUMDOC = DET_NUM_PD                        ';
      strSQL := strSQL + '                AND RLD_ESPDOC = DET_ESP_PD                        ';
      strSQL := strSQL + '                AND RLD_CODEMP = DET_EMP_PD )                      ';
    End;

  End;

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSQL := strSQL + '  AND NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSQL := strSQL + '                   FROM ROMGERX GERX ';
    strSQL := strSQL + '                  INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSQL := strSQL + '                  WHERE GERX.GER_CODEMP = MOVGER.GER_CODEMP ';
    strSQL := strSQL + '                    AND GERX.GER_NUMDOC = MOVGER.GER_NUMDOC ';
    strSQL := strSQL + '                    AND GERX.GER_ESPDOC = MOVGER.GER_ESPDOC ';
    strSQL := strSQL + '  ) ';
  End;

  If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
    strSQL := strSQL + '  AND DET_PROEMB <> "S" ';

  If fCfgSis('CLBUEF',varboolean) Then
    strSQL := strSQL + '   AND DET_CLIBUS = "N" ';

  strSQL := strSQL + ' AND RIGHT(DET_CLAFIS, 3) <> "999" ';
  strSQL := strSQL + ' AND GER_ESPDOC = "TR" ';
  strSQL := strSQL + ' AND IF( GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) = CADCID.CID_CODCID ';

  if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) then
  begin
    strSQL := strSQL + ' AND (' + fRetSQLFiltroEmpresas('DET_EMP_PD') + ') ';
    strSQL := strSQL + ' AND GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';
  end
  else
    strSQL := strSQL + ' AND (' + fRetSQLFiltroEmpresas('GER_CODEMP') + ') ';

  strSQL := strSQL + fDocumentoRemovidoNaoConferidoVolume('MOVGER', 'GER');

  strSQL := strSQL + ' GROUP BY MOVDET.DET_SEQGER ';
  strSQL := strSQL + fRetornaWhereTurno();

  If fUsaRomaneioDocsExpedidos Then
  Begin
    If rdgTurno.ItemIndex = 3 Then
      strSQL := strSQL + ' HAVING '
    Else
      strSQL := strSQL + ' AND ';

    strSQL := strSQL + ' SUM(COALESCE(DET_QTDEXP, 0)) > 0 ';
  End;

  Result := strSQL;

end;

function TfrmFatRomaneio.fSQLVlrCon(strPrefixo: String; strAlias: String): String;
begin
  If fUsaRomaneioDocsExpedidos Then
    Result := ' SUM(ROUND(((' + strPrefixo + '_VLRCON / ' + strPrefixo + '_QTDITE) * ' + strPrefixo + '_QTDEXP), 2)) '
  Else
  Begin
    If Not fEmptyStr(strAlias) Then
      strAlias := strAlias + '.';

    Result := ' ' + strAlias + 'GER_VLRCON ';
  End;
end;

function TfrmFatRomaneio.fSQLVolume(strPrefixo, strAlias: String): String;
begin
  If Not fEmptyStr(strAlias) Then
    strAlias := strAlias + '.';

  If fUsaRomaneioDocsExpedidos and (strOpcRom <> '5') Then
    Result := ' (' + strAlias + 'GER_VOLUME / SUM(' + strPrefixo + '_QTDITE)) * SUM(' + strPrefixo + '_QTDEXP - ' + strPrefixo + '_QTDROM) '
  Else
    Result := ' ' + strAlias + 'GER_VOLUME ';
end;

