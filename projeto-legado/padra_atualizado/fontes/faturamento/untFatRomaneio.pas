procedure TfrmFatRomaneio.pMensagemSonora(AMsg: String; ATipo: TTipoMsgSonora);
Var
  LPlaySoundExists: Boolean;
begin
  LPlaySoundExists := FileExists(ExtractFilePath(Application.ExeName) + 'PlaySound.exe');

  Case ATipo Of
    msSucesso:
      Begin
        If LPlaySoundExists And FileExists(strArqSomSucess) Then
          untFuncoesSimples.pMensagemSonora(AMsg, 'ALBROS')
        Else
          untFuncoesSimples.pMensagemSonora(AMsg, mmsArqSomSucess);
      End;

    msErro:
      Begin
        If LPlaySoundExists And FileExists(strArqSomNaoLoc) Then
          untFuncoesSimples.pMensagemSonora(AMsg, 'ALBROE')
        Else
          untFuncoesSimples.pMensagemSonora(AMsg, mmsArqSomNaoLoc, True);
      End;

    msTransportadoraDiferente:
      Begin
        If LPlaySoundExists And FileExists(strArqSomTraDif) Then
          untFuncoesSimples.pMensagemSonora(AMsg, 'ALBTRA')
        Else
          untFuncoesSimples.pMensagemSonora(AMsg, mmsArqSomTraDif, True);
      End;

  End;
end;

procedure TfrmFatRomaneio.pIniciarBusca;
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
    blnNovaPesquisa: Boolean;
    frmRomaneioBusca: TfrmRomaneioBusca;
begin
  inherited;
  If (Not cdsTmpDoc.Active) Or
     (cdsTmpDoc.IsEmpty)    Then
  Begin
    Exit;
  End;

  frmRomaneioBusca := nil;
  blnNovaPesquisa := true;
  While blnNovaPesquisa do
  Begin

    Try
      if frmRomaneioBusca = nil then
        pCriarFormularios(TfrmRomaneioBusca, frmRomaneioBusca);

      frmRomaneioBusca.ShowModal;
      strFiltroNumDoc := frmRomaneioBusca.strFiltroNumDoc;
      strFiltroEspDoc := frmRomaneioBusca.strFiltroEspDoc;
      strFiltroEmpDoc := frmRomaneioBusca.strFiltroEmpDoc;
      strFiltroNomCli := frmRomaneioBusca.strFiltroNomCli;
      strFiltroNomCid := frmRomaneioBusca.strFiltroNomCid;
      strFiltroCodCli := frmRomaneioBusca.strFiltroCodCli;
      strFiltroPedVen := frmRomaneioBusca.strFiltroPedVen;
      blnNovaPesquisa := frmRomaneioBusca.chkAutomatico.Checked;
      strFiltroNumLot := frmRomaneioBusca.strFiltroNumLot;
      strFiltroEmpLot := frmRomaneioBusca.strFiltroEmpLot;
      strFiltroEndere := frmRomaneioBusca.strFiltroEndere;
      strFiltroBairro := frmRomaneioBusca.strFiltroBairro;
      fltFiltroPesIni := frmRomaneioBusca.fltFiltroPesIni;
      fltFiltroPesFin := frmRomaneioBusca.fltFiltroPesFin;

      if frmRomaneioBusca.blnConfirma then
      begin

        If (not fEmptyStr(strFiltroNumLot)) And (Not fEmptyStr(strFiltroEmpLot)) Then
        Begin
          pSelecionaDocumentosLote;
        End;

        pSetFocus(dbgDocumentos);

        blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

        If blnWasEnabled Then
          pDisableControls(cdsTmpDoc, prcScroll);

        cdsTmpDoc.Filter := '';
        cdsTmpDoc.Filtered := False;
        cdsTmpDoc.OnFilterRecord := pFilterRecord;

        If cdsTmpDoc.FindFirst Then
        Begin
          if (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'D') > 0) then
          Begin
            pSelecionaDocumento;
            pMensagemSonora('', msSucesso);
          End
          else If fEmptyStr(strFiltroNumLot) And fEmptyStr(strFiltroEmpLot) Then
            pMensagemSonora('O documento já foi inserido no Romaneio!', msErro);
        End
        else If fEmptyStr(strFiltroNumLot) And fEmptyStr(strFiltroEmpLot) Then
          pMensagemSonora('O documento não foi localizado!', msErro);

        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      end;
    Except
      On E: Exception Do
      Begin
        blnNovaPesquisa := false;
        pMensagensErro(E.Message, '[frmRomaneio - Inicia Busca]');
      End;
    End;

  end;

  pFreeAndNil(frmRomaneioBusca);

  pSetFocus(dbgDocumentos);
end;

procedure TfrmFatRomaneio.btnLocProxClick(Sender: TObject);
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  inherited;
  If (cdsTmpDoc.Active) Then
