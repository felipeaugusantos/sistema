end;

procedure TfrmFatRomaneio.pProcessaClientMaster;
Var
  strIdxAux,
  strValAux: String;

  intIxdAux: Integer;

  stlCodRot,
  stlEndEnt,
  stlNumDoc: TStringList;

  fltTotPes,
  fltTotVol,
  fltTotRot: Double;

  cdsTmpAux: TUniClientDataSet;

  prcScrollMaster,
  prcScrollTmpDoc: TprcScroll;

  blnTemIteMarcado,
  blnEnabledMaster,
  blnEnabledTmpDoc: Boolean;

begin
  If Assigned(cdsMaster) Then
  Begin
    blnEnabledTmpDoc := Not cdsTmpDoc.ControlsDisabled;
    blnEnabledMaster := Not cdsMaster.ControlsDisabled;

    stlEndEnt := TStringList.Create;
    stlNumDoc := TStringList.Create;
    stlCodRot := TStringList.Create;

    cdsTmpAux := TUniClientDataSet.Create(Nil);

    If (cdsMaster.Active) Then
      cdsMaster.EmptyDataSet;

    pCloneDataSet(cdsTmpAux, cdsTmpDoc);

    If (cdsTmpDoc.Active) Then
      cdsTmpDoc.EmptyDataSet;

    strIdxAux := cdsTmpDoc.IndexFieldNames;

    cdsMaster.IndexFieldNames := 'GER_CODROT';
    cdsTmpAux.IndexFieldNames := 'GER_CODROT';
    cdsTmpDoc.IndexFieldNames := 'GER_CODROT';

    Try
      If blnEnabledMaster Then
        pDisableControls(cdsMaster, prcScrollMaster);

      If blnEnabledTmpDoc Then
        pDisableControls(cdsTmpDoc, prcScrollTmpDoc);

      cdsTmpAux.First;
      While Not cdsTmpAux.Eof Do
      Begin
        strValAux := cdsTmpAux.FieldByName('GER_CODROT').AsString;
        If (stlCodRot.IndexOf(strValAux) = -1) Then
           stlCodRot.Add(strValAux);

        cdsTmpAux.Next;
      End;

      For intIxdAux:=0 To stlCodRot.Count-1 Do
      Begin
        stlEndEnt.Clear;
        stlNumDoc.Clear;
        fltTotPes:=0;
        fltTotVol:=0;
        fltTotRot:=0;
        blnTemIteMarcado := False;

        cdsTmpAux.Filtered := False;
        cdsTmpAux.Filter   := 'GER_CODROT = ' + QuotedStr(stlCodRot[intIxdAux]);
        cdsTmpAux.Filtered := True;
        cdsTmpAux.First;
        While Not cdsTmpAux.Eof Do
        Begin
          strValAux := cdsTmpAux.FieldByName('GER_ENDCON').AsString + cdsTmpAux.FieldByName('GER_CEPCON').AsString;
          If (stlEndEnt.IndexOf(strValAux) = -1) Then
            stlEndEnt.Add(strValAux);

          strValAux := cdsTmpAux.FieldByName('GER_NUMDOC').AsString + cdsTmpAux.FieldByName('GER_CODEMP').AsString;
          If (stlNumDoc.IndexOf(strValAux) = -1) Then
           stlNumDoc.Add(strValAux);

          If (Not blnTemIteMarcado) And (cdsTmpAux.FieldByName('GER_MARDES').Value = 'M') Then
             blnTemIteMarcado := True;

          fltTotPes := fltTotPes + cdsTmpAux.FieldByName('GER_PESBRU').AsFloat;
          fltTotVol := fltTotVol + cdsTmpAux.FieldByName('GER_VOLUME').AsFloat;
          fltTotRot := fltTotRot + cdsTmpAux.FieldByName('GER_VLRCON').AsFloat;

          cdsTmpAux.Next;
        End;

        cdsMaster.Append;
        cdsMaster.FieldByName('GER_CODROT').AsString := cdsTmpAux.FieldByName('GER_CODROT').AsString;
        cdsMaster.FieldByName('ENT_CODREG').AsString := cdsTmpAux.FieldByName('ENT_CODREG').AsString;
        cdsMaster.FieldByName('GER_DESROT').AsString := fRetNomRotasRegiao(cdsTmpAux.FieldByName('GER_CODROT').AsString);
        cdsMaster.FieldByName('GER_MARDES').AsString := IIF(blnTemIteMarcado,'M','D');
        cdsMaster.FieldByName('GER_QTDENT').Value := stlEndEnt.Count;
        cdsMaster.FieldByName('GER_QTDDOC').Value := stlNumDoc.Count;
        cdsMaster.FieldByName('GER_TOTPES').Value := fltTotPes;
        cdsMaster.FieldByName('GER_TOTVOL').Value := fltTotVol;
        cdsMaster.FieldByName('GER_TOTROT').Value := fltTotRot;
        cdsMaster.Post;
      End;

      cdsMaster.First;
      While Not cdsMaster.Eof Do
      Begin
        cdsTmpAux.Filtered := False;
        cdsTmpAux.Filter   := 'GER_CODROT = ' + QuotedStr(cdsMaster.FieldByName('GER_CODROT').AsString);
        cdsTmpAux.Filtered := True;
        cdsTmpAux.First;
        While Not cdsTmpAux.Eof Do
        Begin
          cdsTmpDoc.Insert;
          For intIxdAux := 0 To cdsTmpDoc.Fields.Count -1 Do
            cdsTmpDoc.Fields[intIxdAux].Value := cdsTmpAux.Fields[intIxdAux].Value;
          cdsTmpDoc.Post;

          cdsTmpAux.Next;
        End;

        cdsMaster.Next;
      End;
    Finally
      If blnEnabledMaster Then
        pEnableControls(cdsMaster, prcScrollMaster);

      If blnEnabledTmpDoc Then
        pEnableControls(cdsTmpDoc, prcScrollTmpDoc);

      cdsTmpDoc.IndexFieldNames := strIdxAux;

      cdsTmpDoc.First;
      cdsMaster.First;

      FreeAndNil(cdsTmpAux);
      FreeAndNil(stlEndEnt);
      FreeAndNil(stlNumDoc);
      FreeAndNil(stlCodRot);

      dbgDocumentosDBViewMaster.ApplyBestFit;

//      dbgDocumentos.pCollapseExpandcxGrid(dbgDocumentos,tcxExpande);
//      dbgDocumentos.pCollapseExpandcxGrid(dbgDocumentos,tcxColapsa);
      dbgDocumentos.pCollapseExpandcxGrid(tcxExpande);
      dbgDocumentos.pCollapseExpandcxGrid(tcxColapsa);
    End;
  End;
end;

