  strSelect := strSelect + ', ' +  fSQLBarDoc('GER') + ' AS BARDOC ';

  strSelect := strSelect + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSelect := strSelect + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSelect := strSelect + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSelect := strSelect + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSelect := strSelect + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSelect := strSelect + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSelect := strSelect + 'FROM ';
  strSelect := strSelect + '  MOVGER ';
  strSelect := strSelect + '  INNER JOIN MOVDET   ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
  strSelect := strSelect + '  INNER JOIN MOVTRI   ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ';
  strSelect := strSelect + '  INNER JOIN CADCLI   ON GER_CODCLI        = CLI_CODCLI ';
  strSelect := strSelect + '  INNER JOIN CADCID   ON CADCID.CID_CODCID = IF(GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) ';
  strSelect := strSelect + '  INNER JOIN CADITE I ON I.ITE_CODITE      = DET_CODITE ';
  strSelect := strSelect + '   LEFT JOIN CADTRA   ON GER_CODTRA        = CADTRA.TRA_CODTRA ';
  strSelect := strSelect + '   LEFT JOIN CADFPG   ON GER_CODFPG        = FPG_CODIGO ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA MOVGER *}
  {************************************FC}
  strSelect := strSelect + ' LEFT JOIN AUXMOV        ON (AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM) ';
  strSelect := strSelect + ' LEFT JOIN MOVOBS        ON (MOVOBS.MOV_SEQGER = MOVGER.AUTOINCREM) ';
  strSelect := strSelect + ' LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXMOV.AUX_ENTGER) ';
  strSelect := strSelect + ' LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = ECMOV.ETC_CIDENT)  ';
  strSelect := strSelect + ' LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

  strSelect := strSelect + ' LEFT JOIN CADFIS ON FIS_NUMDOC = GER_NUMDOC ';
  strSelect := strSelect + '                 AND FIS_ESPDOC = GER_ESPDOC ';
  strSelect := strSelect + '                 AND FIS_CODEMP = GER_CODEMP ';
  strSelect := strSelect + '                 AND FIS_FORCLI = GER_CODCLI ';
  strSelect := strSelect + '                 AND FIS_TIP_FC = GER_TIP_FC ';

  // ** CADREG REGIAO **
  strSelect := strSelect + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECMOV.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECMOV.ETC_CODREG) ) ';
  strSelect := strSelect + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  // ** DEPARTAMENTO VENDEDOR **
  strSelect := strSelect + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = MOVGER.GER_CODVEN ';
  strSelect := strSelect + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';
  strSelect := strSelect + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = MOVGER.GER_CODCND   ';

  strSelect := strSelect + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';

  strSelect := strSelect + fJoinFatGor_ExtGor('MOVDET');

  //Entrega (Rota) selecionada
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSelect := strSelect + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSelect := strSelect + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;

  strSelect := strSelect + 'WHERE ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
    Begin
      strSelect := strSelect + '  FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSelect := strSelect + '      GER_NUMDOC = :NUMDOC ';
      strSelect := strSelect + '  AND GER_ESPDOC = :ESPDOC ';
      strSelect := strSelect + '  AND GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin

    strSelect := strSelect + '      GER_ENTFUT = "N" ';

    strSelect := strSelect + '  AND GER_ENTFAT = "S" ';

    strSelect := strSelect + '  AND ' + fRetCondicaoCFOP('GER_CLAFIS');
    strSelect := strSelect + '  AND GER_NUMROM IS NULL ';
    strSelect := strSelect + '  AND IFNULL(DET_CODEXT,"") = "" ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSelect := strSelect + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSelect := strSelect + ' AND ' + IIF(rdbEntrega.Checked, 'GER_DTENTR', 'GER_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
    Else
      strSelect := strSelect + ' AND GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

    If (chkSomenteCliFil.Checked) Then
      strSelect := strSelect + ' AND GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSelect := strSelect + ' AND DET_CODITE <> :ITESER AND DET_CODITE <> :SERTER ';

    strSelect := strSelect + fStrLocate(edtCodCid    , arrCidade  , 'IF(GER_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), GER_CIDCON)','CODCID');
    strSelect := strSelect + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", GER_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
    strSelect := strSelect + fStrLocate(edtTraFat    , arrTraFat  , 'GER_CODTRA', 'TRAFAT');
    strSelect := strSelect + fStrLocate(edtCodReg    , arrRegiao  , 'ECMOV.ETC_CODREG', 'CODREG');
    strSelect := strSelect + fStrLocate(edtCodVen    , arrVended  , 'GER_CODVEN', 'CODVEN');
    strSelect := strSelect + fStrLocate(edtCodDep    , arrDepVen  , 'DEP_CODIGO', 'CODDEP');
    strSelect := strSelect + fStrLocate(edtCodCliente, arrClientes, 'GER_CODCLI', 'CODCLI');
    strSelect := strSelect + fStrLocate(edtCodProduto, arrProdutos, 'DET_CODITE', 'CODITE');
    If blnRegCid Then
      strSelect := strSelect + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    If (fCfgSis('CONENT', varBoolean)) and (fCfgSis('COENFI', varBoolean)) Then
    Begin

      If ((fCfgSis('EMPGER', varBoolean))) Then
      Begin
        strSelect := strSelect + ' AND (GER_CODEMP = ' + QuotedStr(fCfgSis('EMPMAT')) + ' OR ';
        strSelect := strSelect + '      GER_CONENT = "S") ';
      End
      Else
      Begin
        strSelect := strSelect + ' AND GER_CONENT = "N" ';
        strSelect := strSelect + ' AND GER_CODEMP = ' + QuotedStr(VS_strCodEmp);
      End;

    End;

    {*****************************************}
    {* FILTRO DE LINHA E GRUPO               *}
    {**************************************MV*}
    strSelect := strSelect + fSQLFiltroLinGru('DET');

    If not fEmptyStr( strDocCaixa ) Then
      strSelect := strSelect + ' AND (LOCATE(MOVGER.AUTOINCREM, "'+strDocCaixa+'") > 0) ';

    if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
    Begin
      strSelect := strSelect + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
      strSelect := strSelect + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
      strSelect := strSelect + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
      strSelect := strSelect + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
      strSelect := strSelect + '                AND RLD_NUMDOC = DET_NUM_PD                        ';
      strSelect := strSelect + '                AND RLD_ESPDOC = DET_ESP_PD                        ';
      strSelect := strSelect + '                AND RLD_CODEMP = DET_EMP_PD )                      ';
    End;

  End;

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSelect := strSelect + '  AND NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSelect := strSelect + '                   FROM ROMGERX GERX ';
    strSelect := strSelect + '                  INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSelect := strSelect + '                  WHERE GERX.GER_CODEMP = MOVGER.GER_CODEMP ';
    strSelect := strSelect + '                    AND GERX.GER_NUMDOC = MOVGER.GER_NUMDOC ';
    strSelect := strSelect + '                    AND GERX.GER_ESPDOC = MOVGER.GER_ESPDOC ';
    strSelect := strSelect + '  ) ';
  End;

  If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
    strSelect := strSelect + '  AND DET_PROEMB <> "S" ';

  If fCfgSis('CLBUEF',varboolean) Then
    strSelect := strSelect + '  AND DET_CLIBUS = "N" ';

  strSelect := strSelect + '  AND GER_ESPDOC IN ("NF", "EL", "IF", "IV", "D1", "MI", "FF" ' + IIF(fEntraTR_BR_Romaneio, ', "BR"', '') +
    IIF(fEntraEP_Romaneio, ', "EP"', '') + IIF(blnListGC, ', "GC"', '') + ') ';

  strSelect := strSelect + '  AND IF( GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) = CADCID.CID_CODCID ';

  if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) then
  begin
    strSelect := strSelect + ' AND (' + fRetSQLFiltroEmpresas('DET_EMP_PD') + ') ';
    strSelect := strSelect + ' AND GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';
  end
  else
    strSelect := strSelect + ' AND (' + fRetSQLFiltroEmpresas('GER_CODEMP') + ') ';

  strSelect := strSelect + fDocumentoRemovidoNaoConferidoVolume('MOVGER', 'GER');

  strSelect := strSelect + fGetFiltroTipoDocumento;

  strSelect := strSelect + ' GROUP BY MOVDET.DET_SEQGER ';

  If fEmptyStr( strDocCaixa ) Then
  Begin
    strSelect := strSelect + fRetornaWhereTurno();
    strSelect := strSelect + fGetWhereDocsExpedidos('MOVGER');

    {*******************************************}
    {* CONFIGURAÇÃO PARA ENTRAR "TE"           *}
    {****************************************JC*}
    If fEntraTE_Romaneio Then
    Begin
      strSelect := strSelect + 'UNION ALL ';
      strSelect := strSelect + fSQLTE;
    End;

    If fEntraTR_BR_Romaneio Then
    Begin
      //UNION COM A MOVDET PARA RETORNAR OS REGISTROS COM ESPDOC = TR QUE SEJAM DE MOVIMENTAÇÃO DE SAÍDA ...
      strSelect := strSelect + ' UNION ALL ';
      strSelect := strSelect + fSQLTrocasSaida(strOpcRom);
    End;
  End;

  Result := strSelect;

end;

function TfrmFatRomaneio.fRetSQL_OPCROM3: String;
var
  strSelect : String;
begin

  {*****************************************}
  {* MOVGER                                *}
  {**************************************MV*}
  strSelect := strSelect + 'SELECT ';
  strSelect := strSelect + fRetSQLDocRetornadoRomaneio('GER') + ' AS GER_RETROM, ';
  strSelect := strSelect + '  GER_CONPAG   AS GER_CONPAG, ';
  strSelect := strSelect + '  GER_CODFPG   AS GER_CODFPG, ';
  strSelect := strSelect + '  " "          AS GER_TIPOPE, ';
  strSelect := strSelect + '  " "          AS GER_FPGNEG, ';
  strSelect := strSelect + '  "N"          AS GER_ORIF11, ';
  strSelect := strSelect + '  0.00         AS GER_TOTBRI, ';
  strSelect := strSelect + '  0.00         AS GER_VALREC, ';
  strSelect := strSelect + '  0.00         AS GER_BOLADT, ';
  strSelect := strSelect + '  "N"          AS GER_BOLVEN, ';
  strSelect := strSelect + '  0.00         AS GER_VALADT, ';
  strSelect := strSelect + '  GER_VLRCON   AS GER_CONORI, ';
  strSelect := strSelect + '  GER_DTAENT, ';
  strSelect := strSelect + '  GER_HORENT, ';
  strSelect := strSelect + '  GER_DTENTR, ';
  strSelect := strSelect + '  CONCAT( GER_NUMDOC, "-", GER_ESPDOC ) AS GER_NUMDOC, ';
  strSelect := strSelect + '  GER_NUMDOC AS GER_DOCORI, ';
  strSelect := strSelect + '  GER_ESPDOC, ';
  strSelect := strSelect + '  GER_CODEMP, ';
  strSelect := strSelect + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSelect := strSelect + '  GER_CODCLI, ';
  strSelect := strSelect + '  IF( GER_NOMCON IS NULL, CLI_NOMCLI, GER_NOMCON) AS GER_NOMCLI, ';
  strSelect := strSelect + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSelect := strSelect + '  GER_CLAFIS, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';

  strSelect := strSelect + '  GER_TIPFRE, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_BAIENT, COALESCE(GER_BAICON, CADCLI.CLI_BAIRRO)) AS GER_BAIRRO, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_ENDENT, COALESCE(GER_ENDCON, CADCLI.CLI_ENDERE)) AS GER_ENDCON, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_LATLON, " ") AS GER_LATLON, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_CEPENT, COALESCE(GER_CEPCON, CADCLI.CLI_C_E_P_)) AS GER_CEPCON, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_REFENT, CADCLI.CLI_REFENT) AS GER_REFCON, ';

  strSelect := strSelect + '  GER_CODVEN, ';
  strSelect := strSelect + '  CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
  strSelect := strSelect + fSQLVlrCon('DET', 'MOVGER') + ' - IFNULL(GER_VALROM, 0) AS GER_VLRCON, ';
  strSelect := strSelect + fSQLVlrCon('DET', 'MOVGER') + ' - IFNULL(GER_VALROM, 0) AS GER_VALDOC, ';
  strSelect := strSelect + '  (GER_TOTPRO - GER_DESESP) GER_VLRPRO, ';
  strSelect := strSelect + '  GER_ROMIMP, ';
  strSelect := strSelect + '  "D" AS GER_MARDES, ';
  strSelect := strSelect + '  " " AS GER_VEICUL, ';

  strSelect := strSelect + fGetSQLPosObs('MOVGER','GER_NUMDOC','GER_ESPDOC','GER_CODEMP') + ' AS POSOBS, ';

  strSelect := strSelect + '  LPAD("", 15, " ") AS GER_PALET_, ';
  strSelect := strSelect + '  0.00 GER_VALSEL, ';
  strSelect := strSelect + '  0.00 GER_VSEPRO, ';
  strSelect := strSelect + '  GER_TIP_FC, ';
  strSelect := strSelect + '  0 GER_ORDIMP, ';
  strSelect := strSelect + '  " " GER_ALTERA, ';
  strSelect := strSelect + '  0 INCREMENTO, ';
  strSelect := strSelect + '  IF(IFNULL(TRAMOV.TRA_CODTRA,"") = "", CADTRA.TRA_CODTRA, TRAMOV.TRA_CODTRA) AS GER_CODTRA, ';
  strSelect := strSelect + '  IF(IFNULL(TRAMOV.TRA_NOMTRA,"") = "", CADTRA.TRA_NOMTRA, TRAMOV.TRA_NOMTRA) AS GER_TRANSP, ';
  strSelect := strSelect + '  CADTRA.TRA_NOMTRA AS GER_TRAFAT, ';
  strSelect := strSelect + '  GER_CODTRA  AS GER_TRADOC, ';
  strSelect := strSelect + '  GER_PESBRU, ';
  strSelect := strSelect + '  "MOVGER" AS GER_NOMTBL, ';
  strSelect := strSelect + '  MOVGER.AUTOINCREM AS GER_AUTINC, ';
  strSelect := strSelect + '  GER_ORIDOC, ';
  strSelect := strSelect + '  CAST(' + fSQLTotDet('DET') + ' AS DECIMAL(15, 4)) AS GER_TOTDET, ';
  strSelect := strSelect + '  GER_NUMROM AS GER_NROROM,  ';
  strSelect := strSelect + '  CONCAT(GER_NUMFAT, GER_TIPFAT, GER_EMPFAT, GER_CLIFAT) AS GER_NUMFAT, ';
  strSelect := strSelect + '  CONCAT(GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI) AS GER_DOCUME, ';
  strSelect := strSelect + '  CAST((SELECT CAST(GROUP_CONCAT(DISTINCT FDO_NUMDOC, "-", FDO_ESPDOC) AS CHAR(255)) FROM FATDOR WHERE FDO_NUMFAT = GER_NUMDOC AND FDO_TIPFAT = GER_ESPDOC AND FDO_EMPFAT = GER_CODEMP)AS CHAR(255)) AS GER_PEDVEN, ';
  strSelect := strSelect + fSQLVolume('DET', 'MOVGER') + ' AS GER_VOLUME, ';
  strSelect := strSelect + fSQLProfissionalCodigo('DET')  + ' AS GER_CODDIV, ';
  strSelect := strSelect + fSQLProfissionalNome('DET')  + ' AS GER_NOMDIV, ';
  strSelect := strSelect + '  MOV_OBSERV AS GER_NFEADC, ';
  strSelect := strSelect + '  " " AS GER_MENEXP, ';
  strSelect := strSelect + '  " " AS GER_MENEX2, ';
  strSelect := strSelect + '  " " AS GER_MENEX3, ';
  strSelect := strSelect + '  " " AS GER_MENEX4, ';
  strSelect := strSelect + '  " " AS ENTURG, ';
  strSelect := strSelect + '  GER_PRVIMP,  ';
  strSelect := strSelect + '  IF(LEFT(GER_CLAFIS, 1) >= "5", "S", "E") AS GER_ENTSAI, ';
  strSelect := strSelect + '  FIS_ACESSO, ';
  strSelect := strSelect + '  GER_ENTFUT, ';
  strSelect := strSelect + '  GER_ENTFAT, ';
  strSelect := strSelect + '  GER_CONENT, ';
  strSelect := strSelect + '  "N" AS APENAS_ESTE, ';
  strSelect := strSelect + '  0 AS GER_VOLBIP, ';
  strSelect := strSelect + fRetSQLDescrRegiao;
  strSelect := strSelect + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';
  strSelect := strSelect + fRetSQLSeqRotaRegiao('IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID)');
  strSelect := strSelect + fSQLCampo('GER_BASSIM', '', 'MOVGER')           + ' AS GER_BASSIM, ';
  strSelect := strSelect + fSQLCampo('DET_BASIPI', 'GER_BASIPI', 'MOVGER') + ' AS GER_BASIPI, ';
  strSelect := strSelect + fSQLCampo('DET_VALIPI', 'GER_TOTIPI', 'MOVGER') + ' AS GER_TOTIPI, ';
  strSelect := strSelect + fSQLCampo('DET_BASICM', 'GER_BASICM', 'MOVGER') + ' AS GER_BASICM, ';
  strSelect := strSelect + fSQLCampo('DET_VALICM', 'GER_TOTICM', 'MOVGER') + ' AS GER_TOTICM, ';
  strSelect := strSelect + fSQLCampo('DET_VALRET', 'GER_TOTRET', 'MOVGER') + ' AS GER_TOTRET, ';
  strSelect := strSelect + fSQLCampo('DET_BASRET', 'GER_BASRET', 'MOVGER') + ' AS GER_BASRET, ';
  strSelect := strSelect + fSQLCampo('DET_DESESP', 'GER_DESESP', 'MOVGER') + ' AS GER_DESESP, ';
  strSelect := strSelect + fSQLCampo('DET_TOTCUS', 'GER_TOTCUS', 'MOVGER') + ' AS GER_TOTCUS, ';
  strSelect := strSelect + fSQLCampo('DET_TOTMED', 'GER_TOTMED', 'MOVGER') + ' AS GER_TOTMED, ';
  strSelect := strSelect + fSQLCampo('DET_TOTFRE', 'GER_TOTFRE', 'MOVGER') + ' AS GER_TOTFRE, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR01', '', 'MOVGER')           + ' AS GER_VPAR01, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR02', '', 'MOVGER')           + ' AS GER_VPAR02, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR03', '', 'MOVGER')           + ' AS GER_VPAR03, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR04', '', 'MOVGER')           + ' AS GER_VPAR04, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR05', '', 'MOVGER')           + ' AS GER_VPAR05, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR06', '', 'MOVGER')           + ' AS GER_VPAR06, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR07', '', 'MOVGER')           + ' AS GER_VPAR07, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR08', '', 'MOVGER')           + ' AS GER_VPAR08, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR09', '', 'MOVGER')           + ' AS GER_VPAR09, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR10', '', 'MOVGER')           + ' AS GER_VPAR10, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR11', '', 'MOVGER')           + ' AS GER_VPAR11, ';
  strSelect := strSelect + fSQLCampo('GER_VPAR12', '', 'MOVGER')           + ' AS GER_VPAR12, ';
  strSelect := strSelect + fSQLCampo('DET_TOTITE', 'GER_TOTPRO', 'MOVGER') + ' AS GER_TOTPRO, ';
  strSelect := strSelect + '  GER_CODCND, ';
  strSelect := strSelect + fRetornaCampoOrigemPedidoRetira('MOVGER');
  strSelect := strSelect + '  " " AS GER_ORIDEV, ';
  strSelect := strSelect + fRetornaInformacoesRota;
  strSelect := strSelect + '  " " AS DOC_FATURADOS, ';
  strSelect := strSelect + '  " " AS GER_INCFUT, ';
  strSelect := strSelect + '  " " AS TIPPED, ';
  strSelect := strSelect + '  1.00 AS GER_PERDEV, ';
  strSelect := strSelect + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSelect := strSelect + '  FROM ROMLGE ';
  strSelect := strSelect + '  INNER JOIN ROMLDE ';
  strSelect := strSelect + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';

  if (fCfgSis('OPROSE', varString) = '2') and (fCfgSis('OPROML', varString) = '2') then
  begin
    strSelect := strSelect + '  WHERE RLD_NUMDOC = GER_NUMDOC ';
    strSelect := strSelect + '  AND RLD_ESPDOC = GER_ESPDOC ';
    strSelect := strSelect + '  AND RLD_CODEMP = GER_CODEMP LIMIT 1) AS ROMLOT, ';
  end
  else
  begin
    strSelect := strSelect + '  INNER JOIN FATGOR ';
    strSelect := strSelect + '  ON (RLD_NUMDOC = FGO_NUMDOC ';
    strSelect := strSelect + '  AND RLD_ESPDOC = FGO_ESPDOC ';
    strSelect := strSelect + '  AND RLD_CODEMP = FGO_CODEMP) ';
    strSelect := strSelect + '  WHERE FGO_NUMFAT = GER_NUMDOC ';
    strSelect := strSelect + '  AND FGO_TIPFAT = GER_ESPDOC ';
    strSelect := strSelect + '  AND FGO_EMPFAT = GER_CODEMP LIMIT 1) AS ROMLOT, ';
  end;

  strSelect := strSelect + fRetornaCampoTurno('DET_TURENT');
  strSelect := strSelect + ', "N" AS DELETA_DEVOLUCAO ';

  strSelect := strSelect + ', CAST(" " AS CHAR(20)) AS ROMTRA ';
