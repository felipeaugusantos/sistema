  Else
  Begin
    strSQL := strSQL + '  " " AS GER_INCFUT, ';
    strSQL := strSQL + '  IF(PD.FGO_TIPPED = "A", "NF", IF(PD.FGO_TIPPED = "B", "FF", IF(PD.FGO_TIPPED = "C", "IF", ""))) AS TIPPED, ';
    strSQL := strSQL + '  1.00 AS GER_PERDEV, ';
    strSQL := strSQL + ' (SELECT ROMLGE.RLG_NUMLOT  ';
    strSQL := strSQL + '  FROM ROMLGE ';
    strSQL := strSQL + '  INNER JOIN ROMLDE ';
    strSQL := strSQL + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
    strSQL := strSQL + '  WHERE RLD_NUMDOC = G.GER_NUMDOC ';
    strSQL := strSQL + '  AND RLD_ESPDOC = G.GER_ESPDOC ';
    strSQL := strSQL + '  AND RLD_CODEMP = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';

    strSQL := strSQL + '  CAST(" " AS CHAR(15)) AS TURENT ';
  End;

  strSQL := strSQL + ', "N" AS DELETA_DEVOLUCAO ';

  strSQL := strSQL + ', ROMTRAX.AUTOINCREM AS ROMTRA ';
