procedure TfrmFatRomaneio.pCarregaRomRet;
var
  qryRomRet: TUniQuery;
begin
  if not fCfgSis('MATDIS', varBoolean) then
    Exit;

  qryRomRet := fCriaQuery;
  try
    qryRomRet.Close;
    qryRomRet.SQL.Text :=
    ' SELECT '+
    '   RET_DISTAN, '+
    '   RET_TMPRET  '+
    ' FROM '+
    '   ROMRET '+
    ' WHERE '+
    '   RET_NUMROM = :NUMROM AND '+
    '   RET_EMPROM = :EMPROM ';

    qryRomRet.ParamByName('NUMROM').AsString := edtNumRom.Text;
    qryRomRet.ParamByName('EMPROM').AsString := VS_strCodEmp;
    qryRomRet.Open;

    if not qryRomRet.IsEmpty then
    begin
      cdsRomRet.EmptyDataSet;
      cdsRomRet.Append;
      cdsRomRet.FieldByName('RET_DISTAN').AsFloat := qryRomRet.FieldByName('RET_DISTAN').AsFloat;
      cdsRomRet.FieldByName('RET_TMPRET').AsFloat := qryRomRet.FieldByName('RET_TMPRET').AsInteger;
      cdsRomRet.Post;
    end;
  finally
    FreeAndNil(qryRomRet);
  end;
end;

procedure TfrmFatRomaneio.pCarregaVeiculoParaAlteracaoRomaneio(strNumRom,
  strCodEmp: string);
var
  qryVeiculo: TUniQuery;
  intIndicePai,
  intIndiceFilho: integer;
  objPai: TWinControl;
begin
  qryVeiculo := fCriaQuery;

  try
    qryVeiculo.Close;
    qryVeiculo.SQL.Clear;
    qryVeiculo.SQL.Add('SELECT GER_CODTRA, GER_CODMOT, GER_PLAVEI, GER_CODREG, GER_CODAJ1, GER_CODAJ2, GER_CODAJ3, GER_CODAJ4, ');
    qryVeiculo.SQL.Add('       GER_OBSFEC, GER_FRETE_, GER_ADIFRE, GER_PERFRE, SUM(GER_VLRCON) AS VLRCON, GER_PESBRU');
    qryVeiculo.SQL.Add('FROM ROMGERX');
    qryVeiculo.SQL.Add('WHERE GER_NUMROM = :NUMROM');
    qryVeiculo.SQL.Add('AND GER_EMPROM = :EMPROM');

    qryVeiculo.ParamByName('NUMROM').AsString := strNumRom;
    qryVeiculo.ParamByName('EMPROM').AsString := strCodEmp;

    qryVeiculo.Open;

    if (not qryVeiculo.IsEmpty) and (Length(arrVeiculos) > 0) then
    begin
      pLimpaVeículos;
      arrVeiculos[0].blnTemRom    := True;
      arrVeiculos[0].strNumVeic   := '1';
      arrVeiculos[0].strCodTRansp := qryVeiculo.FieldByName('GER_CODTRA').AsString;
      arrVeiculos[0].strDesTransp := fRetNomTransportadora(qryVeiculo.FieldByName('GER_CODTRA').AsString);
      arrVeiculos[0].strCodMot    := qryVeiculo.FieldByName('GER_CODMOT').AsString;
      arrVeiculos[0].strDesMot    := fRetNomeMotorista(qryVeiculo.FieldByName('GER_CODMOT').AsString);
      arrVeiculos[0].strPlaVeic   := qryVeiculo.FieldByName('GER_PLAVEI').AsString;
      arrVeiculos[0].strCodReg    := qryVeiculo.FieldByName('GER_CODREG').AsString;
      arrVeiculos[0].strCodAj1    := qryVeiculo.FieldByName('GER_CODAJ1').AsString;
      arrVeiculos[0].strCodAj2    := qryVeiculo.FieldByName('GER_CODAJ2').AsString;
      arrVeiculos[0].strCodAj3    := qryVeiculo.FieldByName('GER_CODAJ3').AsString;
      arrVeiculos[0].strCodAj4    := qryVeiculo.FieldByName('GER_CODAJ4').AsString;
      arrVeiculos[0].strObsFec    := qryVeiculo.FieldByName('GER_OBSFEC').AsString;
      arrVeiculos[0].fltVlrFre    := qryVeiculo.FieldByName('GER_FRETE_').AsFloat;
      arrVeiculos[0].fltVlrAdi    := qryVeiculo.FieldByName('GER_ADIFRE').AsFloat;
      arrVeiculos[0].fltPerFre    := qryVeiculo.FieldByName('GER_PERFRE').AsFloat;
      arrVeiculos[0].fltPeso      := qryVeiculo.FieldByName('GER_PESBRU').AsFloat;
      arrVeiculos[0].fltTotVlr    := qryVeiculo.FieldByName('VLRCON').AsFloat;

      for intIndicePai := 0 to flwpnlVeiculo.ControlCount - 1 do
      begin
        if (flwpnlVeiculo.Controls[intIndicePai] is TPanel) then
        begin
          objPai := TPanel(flwpnlVeiculo.Controls[intIndicePai]);
          for intIndiceFilho := 0 to objPai.ControlCount -1 do
          begin
            if (objPai.Controls[intIndiceFilho] is TLabel) then
            begin
              case AnsiIndexStr(objPai.Controls[intIndiceFilho].Name, ['lblTranspDesc_1', 'lblVeicDesc_1', 'lblMotorDesc_1', 'lblPesoDesc_1', 'lblValorDesc_1']) of
                0: TLabel(objPai.Controls[intIndiceFilho]).Caption := arrVeiculos[0].strDesTransp;
                1: TLabel(objPai.Controls[intIndiceFilho]).Caption := Copy(arrVeiculos[0].strPlaVeic,1,3) + '-' + Copy(arrVeiculos[0].strPlaVeic,4,4);
                2: TLabel(objPai.Controls[intIndiceFilho]).Caption := arrVeiculos[0].strDesMot;
                3: TLabel(objPai.Controls[intIndiceFilho]).Caption := FloatToStrF(arrVeiculos[0].fltPeso, ffFixed, 12, 4);
                4: TLabel(objPai.Controls[intIndiceFilho]).Caption := FloatToStrF(arrVeiculos[0].fltTotVlr, ffFixed, 12, 4);
              end;
            end;
          end;
        end;
      end;

      dkpVeiculos.AutoHide := False;
    end;
  finally
    FreeAndNil(qryVeiculo);
  end;
end;

