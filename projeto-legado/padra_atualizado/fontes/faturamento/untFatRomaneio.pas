    strSQL := strSQL + fSQLProfissionalNome('FDO')  + ' AS GER_NOMDIV, ';
  End;

  strSQL := strSQL + '  MOV_OBSERV AS GER_NFEADC, ';
  strSQL := strSQL + '  PD.FGO_MENEXP AS GER_MENEXP, ';
  strSQL := strSQL + '  PD.FGO_MENEX2 AS GER_MENEX2, ';
  strSQL := strSQL + '  PD.FGO_MENEX3 AS GER_MENEX3, ';
  strSQL := strSQL + '  PD.FGO_MENEX4 AS GER_MENEX4, ';
  strSQL := strSQL + '  IF(IFNULL(EXTGOR.FGO_ENTURG, "") = "S", "SIM", "") AS ENTURG, ';

  strSQL := strSQL + '  "N" AS GER_PRVIMP, ';
  strSQL := strSQL + '  R.GER_ENTSAI, ';
  strSQL := strSQL + '  FIS_ACESSO, ';

  strSQL := strSQL + '  " " AS GER_ENTFUT, ';
  strSQL := strSQL + '  " " AS GER_ENTFAT, ';
  strSQL := strSQL + '  " " AS GER_CONENT, ';
  strSQL := strSQL + '  "N" AS APENAS_ESTE, ';
  strSQL := strSQL + fSQLVolume('DET', 'R')  + ' AS GER_VOLBIP, '; {<<-- Documento já pertence ao romaneio, então apresenta
                                                                         valor bipado igual ao volume do documento!}
  // ** CADREG REGIAO **
  strSQL := strSQL + fRetSQLDescrRegiao;
  strSQL := strSQL + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';

  strSQL := strSQL + '  R.GER_BASSIM, ';
  strSQL := strSQL + '  R.GER_BASIPI, ';
  strSQL := strSQL + '  R.GER_TOTIPI, ';
  strSQL := strSQL + '  R.GER_BASICM, ';
  strSQL := strSQL + '  R.GER_TOTICM, ';
  strSQL := strSQL + '  R.GER_TOTRET, ';
  strSQL := strSQL + '  R.GER_BASRET, ';
  strSQL := strSQL + '  R.GER_DESESP, ';
  strSQL := strSQL + '  R.GER_TOTCUS, ';
  strSQL := strSQL + '  R.GER_TOTMED, ';
  strSQL := strSQL + '  R.GER_TOTFRE, ';
  strSQL := strSQL + '  R.GER_VPAR01, ';
  strSQL := strSQL + '  R.GER_VPAR02, ';
  strSQL := strSQL + '  R.GER_VPAR03, ';
  strSQL := strSQL + '  R.GER_VPAR04, ';
  strSQL := strSQL + '  R.GER_VPAR05, ';
  strSQL := strSQL + '  R.GER_VPAR06, ';
  strSQL := strSQL + '  R.GER_VPAR07, ';
  strSQL := strSQL + '  R.GER_VPAR08, ';
  strSQL := strSQL + '  R.GER_VPAR09, ';
  strSQL := strSQL + '  R.GER_VPAR10, ';
  strSQL := strSQL + '  R.GER_VPAR11, ';
  strSQL := strSQL + '  R.GER_VPAR12, ';
  strSQL := strSQL + '  R.GER_TOTPRO, ';
  strSQL := strSQL + '  R.GER_CODCND, ';
  strSQL := strSQL + fRetornaCampoOrigemPedidoRetira('G');
  strSQL := strSQL + '  " " AS GER_ORIDEV, ';

  strSQL := strSQl + '  " " AS DOC_FATURADOS, ';

  If (Pos(strOpcRom, '1_5_') <= 0) Then
  Begin
    strSQL := strSQL + '  " " AS GER_INCFUT, ';
    strSQL := strSQL + '  " " AS TIPPED, ';
    strSQL := strSQL + '  1.00 AS GER_PERDEV, ';
    strSQL := strSQL + ' (SELECT ROMLGE.RLG_NUMLOT  ';
    strSQL := strSQL + '  FROM ROMLGE ';
    strSQL := strSQL + '  INNER JOIN ROMLDE ';
    strSQL := strSQL + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';

    if (fCfgSis('OPROSE', varString) = '2') and (fCfgSis('OPROML', varString) = '2') then
    begin
      strSQL := strSQL + '  WHERE RLD_NUMDOC = G.GER_NUMDOC ';
      strSQL := strSQL + '  AND RLD_ESPDOC = G.GER_ESPDOC ';
      strSQL := strSQL + '  AND RLD_CODEMP = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';
