Function TfrmFatRomaneio.fTravaRomaneio: Boolean;
Begin
  // DESTRAVA ANTERIOR SE HOUVER
  pDestravaRomaneio;

  If Not fEmptyStr(edtNumRom.Text) Then
  Begin
    //TRAVA O NOVO
    strChaRom := 'ROMANEIO_' + edtNumRom.Text + VS_strCodEmp;
    Result := objLock.fLock_Unlock(strChaRom, True, False);
    If Not Result Then
    Begin
      fMensagem('ATENÇÃO!', 'Este romaneio está sendo utilizado por outra estação: ' + fGetHostLock(strChaRom), ['&Ok']);
      strChaRom := '';
    End;
  End

  Else Result := True;
End;

function TfrmFatRomaneio.fUpdateStatusDocsRom(strNumRom, strCodEmp: String): Boolean;
var
  qryDocs: TUniQuery;
  strSql: String;
begin
  strSql := '';
  strSql := strSql + ' SELECT FDO_NUMDOC, FDO_ESPDOC, FDO_CODEMP';
  strSql := strSql + ' FROM ROMDETX';
  strSql := strSql + ' LEFT JOIN FATDOR ON FDO_NUMFAT = DET_NUMDOC AND FDO_TIPFAT = DET_ESPDOC AND FDO_EMPFAT = DET_CODEMP';
  strSql := strSql + ' WHERE DET_NUMROM = :NUMROM';
  strSql := strSql + '   AND DET_CODEMP = :CODEMP';
  strSql := strSql + ' GROUP BY FDO_NUMDOC, FDO_ESPDOC, FDO_CODEMP';

  if (strOpcRom = '3') then
  begin
    strSql := strSql + ' UNION ';

    strSql := strSql + ' SELECT FDO_NUMDOC, FDO_ESPDOC, FDO_CODEMP';
    strSql := strSql + ' FROM ROMDETX R ';
    strSql := strSql + ' INNER JOIN NOTDET N ON R.DET_NUMDOC = N.DET_NUMDOC ';
    strSql := strSql + '                    AND R.DET_ESPDOC = N.DET_ESPDOC ';
    strSql := strSql + '                    AND R.DET_CODEMP = N.DET_CODEMP ';
    strSql := strSql + ' INNER JOIN CNFMNO C ON N.DET_SEQGER = C.MNO_SEQGER ';
    strSql := strSql + ' INNER JOIN MOVDET D ON D.DET_NUMDOC = C.MNO_NUMFAT ';
    strSql := strSql + '                    AND D.DET_ESPDOC = C.MNO_ESPFAT ';
    strSql := strSql + '                    AND D.DET_CODEMP = C.MNO_EMPFAT ';
    strSql := strSql + ' LEFT JOIN FATDOR F  ON F.FDO_NUMFAT = D.DET_NUMDOC ';
    strSql := strSql + '                    AND F.FDO_TIPFAT = D.DET_ESPDOC ';
    strSql := strSql + '                    AND F.FDO_EMPFAT = D.DET_CODEMP ';
    strSql := strSql + ' WHERE R.DET_NUMROM = :NUMROM';
    strSql := strSql + '   AND R.DET_CODEMP = :CODEMP';
    strSql := strSql + ' GROUP BY FDO_NUMDOC, FDO_ESPDOC, FDO_CODEMP';
  end;

  qryDocs := fCriaQuery;

  try
    qryDocs.SQL.Text := strSql;
    qryDocs.ParamByName('NUMROM').AsString := strNumRom;
    qryDocs.ParamByName('CODEMP').AsString := strCodEmp;
    qryDocs.Open;

    while not qryDocs.Eof do
    begin
      TUpdateStatus.New(TParamStatus.New()
                          .NumDoc(qryDocs.FieldByName('FDO_NUMDOC').AsString)
                          .EspDoc(qryDocs.FieldByName('FDO_ESPDOC').AsString)
                          .CodEmp(qryDocs.FieldByName('FDO_CODEMP').AsString)).pExecute();

     qryDocs.Next;
    end;
    Result := True;
  finally
    FreeAndNil(qryDocs);
  end;

end;

function TfrmFatRomaneio.fUsaModeloOuFoiIdentificadoBipagemChaveAcesso: Boolean;
begin

  Result := True;

  If (ModeloBipagemCfg = mbChaveDeAcesso) Then
    Exit;

  If ((ModeloBipagemCfg = mbAutomatico) And (ModeloBipagemAut = mbChaveDeAcesso)) Then
    Exit;

  Result := False;

end;

function TfrmFatRomaneio.fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho: Boolean;
begin

  Result := True;

  If (ModeloBipagemCfg = mbEtiquetaDeDespacho) Then
    Exit;

  If ((ModeloBipagemCfg = mbAutomatico) And (ModeloBipagemAut = mbEtiquetaDeDespacho)) Then
    Exit;

  Result := False;

end;

Procedure TfrmFatRomaneio.pDestravaRomaneio;
Begin
  // DESTRAVA ANTERIOR SE HOUVER
  strChaRom := '';
  TFrmGravando.fExecutarModal(pDestravaTodasAsTravas, 'Aguarde... Desbloqueando Documentos!', '');
End;

procedure TfrmFatRomaneio.pDestravaTodasAsTravas;
Var
  intIndex: Integer;
  strChaLck: String;
  blnLibera: Boolean;
begin
  For intIndex := 0 To PRed(objLock.fRetornaTravas.Count) Do
  Begin
    strChaLck := objLock.fRetornaTravas[intIndex];

    blnLibera := (Not fVerificaLockAtivo(strChaLck + STR_TRAVA_CONFERENCIA));

    If blnLibera Then
      fLock_Unlock(strChaLck, False, False, False, '', True, '', False, False, True, True, True, False);
  End;

  objLock.fRetornaTravas.Clear;
end;

