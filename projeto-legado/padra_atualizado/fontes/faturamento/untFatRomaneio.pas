  strSQL := strSQL + '    DIG_ESTADO  AS GER_ESTADO, ';
  strSQL := strSQL + '    " "         AS GER_TIPFRE, ';
  strSQL := strSQL + '    DIG_BAIRRO  AS GER_BAIRRO, ';
  strSQL := strSQL + '    DIG_ENDCON  AS GER_ENDCON, ';
  strSQL := strSQL + '    " "         AS GER_LATLON, ';
  strSQL := strSQL + '    DIG_CEPCON  AS GER_CEPCON, ';
  strSQL := strSQL + '    DIG_REFCON  AS GER_REFCON, ';
  strSQL := strSQL + '    DIG_CODVEN  AS GER_CODVEN, ';
