procedure TfrmFatRomaneio.pGravaSelecionados;
begin
  If Not Assigned(cdsTmpMantemSelecionado) Then
    Exit;

  If (Not cdsTmpMantemSelecionado.Active) Then
    Exit;

  If (Not cdsTmpDoc.Active) Or(cdsTmpDoc.IsEmpty) Then
    Exit;

  if cdsTmpMantemSelecionado.Locate('GER_CODCLI;GER_NUMDOC;GER_ESPDOC;GER_CODEMP;GER_ENTSAI',
                                          VarArrayOf([
                                          cdsTmpDoc.FieldByName('GER_CODCLI').AsString,
                                          cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                                          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                          cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                                          cdsTmpDoc.FieldByName('GER_ENTSAI').AsString]),
                                          []) then
    cdsTmpMantemSelecionado.Delete
  else if cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M' Then
  Begin
    pVerificaEstruturaDoDataSet(cdsTmpDoc, cdsTmpMantemSelecionado);
    pCopiaRegistroDataSetIfNotNull(cdsTmpDoc, cdsTmpMantemSelecionado, False, False);
  End;
end;

procedure TfrmFatRomaneio.pVerificaSelecionados;
begin
  If (Not Assigned(cdsTmpMantemSelecionado)) Then
    Exit;

  if (FManter <> tmSelecionados) then
    Exit;

  cdsTmpMantemSelecionado.First;

  While Not cdsTmpMantemSelecionado.Eof Do
  begin
    if not cdsTmpDoc.Locate('GER_CODCLI;GER_NUMDOC;GER_ESPDOC;GER_CODEMP;GER_ENTSAI',
                            VarArrayOf([
                            cdsTmpMantemSelecionado.FieldByName('GER_CODCLI').AsString,
                            cdsTmpMantemSelecionado.FieldByName('GER_NUMDOC').AsString,
                            cdsTmpMantemSelecionado.FieldByName('GER_ESPDOC').AsString,
                            cdsTmpMantemSelecionado.FieldByName('GER_CODEMP').AsString,
                            cdsTmpMantemSelecionado.FieldByName('GER_ENTSAI').AsString]),
                            []) then
    begin
      pCopiaRegistroDataSet(cdsTmpMantemSelecionado, cdsTmpDoc);
      cdsTmpDoc.Edit;
      cdsTmpDoc.FieldByName('GER_MARDES').AsString:= 'D';
      cdsTmpDoc.Post;
      pSelecionaDocumento(False);
    end
    else
    begin
      cdsTmpDoc.Edit;
      cdsTmpDoc.FieldByName('GER_ENDCON').AsString := cdsTmpMantemSelecionado.FieldByName('GER_ENDCON').AsString;
      cdsTmpDoc.FieldByName('GER_BAIRRO').AsString := cdsTmpMantemSelecionado.FieldByName('GER_BAIRRO').AsString;
      cdsTmpDoc.FieldByName('GER_CEPCON').AsString := cdsTmpMantemSelecionado.FieldByName('GER_CEPCON').AsString;
      cdsTmpDoc.FieldByName('CID_CODCID').AsString := cdsTmpMantemSelecionado.FieldByName('CID_CODCID').AsString;
      cdsTmpDoc.FieldByName('GER_NOMCID').AsString := cdsTmpMantemSelecionado.FieldByName('GER_NOMCID').AsString;
      cdsTmpDoc.FieldByName('GER_ESTADO').AsString := cdsTmpMantemSelecionado.FieldByName('GER_ESTADO').AsString;
      cdsTmpDoc.FieldByName('GER_REFCON').AsString := cdsTmpMantemSelecionado.FieldByName('GER_REFCON').AsString;
      cdsTmpDoc.Post;

      pSelecionaDocumento(False);
    end;

    cdsTmpMantemSelecionado.next;
  end;
end;

