function TfrmFatRomaneio.fTodosItensDoTransbordoForamRomaneados(
  strAutInc: String): Boolean;
var
  qryTransb: TUniQuery;
  intQtdDec: Integer;
begin
  intQtdDec := fCfgSis('DECQTD', varInteger);

  qryTransb := fCriaQuery(Self);
  try
    qryTransb.Close;
    qryTransb.SQL.Text :=
    ' SELECT '+
    '   TOTAL_ROMANEADO,                                         '+
    '   TOTAL_ITENS                                              '+
    ' FROM                                                       '+
    '   (                                                        '+
    '     (SELECT                                                '+
    '       IFNULL(SUM(DET_QTDBAI), 0) AS TOTAL_ROMANEADO        '+
    '     FROM                                                   '+
    '       ROMTRAX                                              '+
    '       INNER JOIN ROMGERX                                   '+
    '         ON ROMTRAX.AUTOINCREM = GER_SEQTRA                 '+
    '       INNER JOIN ROMDETX DT                                '+
    '         ON ROMGERX.AUTOINCREM = DET_SEQGER                 '+
    '     WHERE ROMTRAX.AUTOINCREM = :AUTINC) AS TOTAL_ROMANEADO '+

    '    ,                                                       '+

    '     (SELECT                                                '+
    '       IFNULL(SUM(DET_QTDITE), 0) AS TOTAL_ITENS            '+
    '     FROM                                                   '+
    '       ROMTRAX                                              '+
    '       INNER JOIN ROMGERX                                   '+
    '         ON TRA_SEQGER = ROMGERX.AUTOINCREM                 '+
    '       INNER JOIN ROMDETX                                   '+
    '         ON ROMGERX.AUTOINCREM = DET_SEQGER                 '+
    '     WHERE ROMTRAX.AUTOINCREM = :AUTINC) AS TOTAL_ITENS     '+
    '   )                                                        ';

    qryTransb.ParamBYName('AUTINC').AsString := strAutInc;
    qryTransb.Open;

    Result := fFormataFloat(qryTransb.FieldByName('TOTAL_ROMANEADO').AsFloat, intQtdDec) = fFormataFloat(qryTransb.FieldByName('TOTAL_ITENS').AsFloat, intQtdDec);
  finally
    FreeAndNil(qryTransb);
  end;
end;

function TfrmFatRomaneio.fTodosPedidosQueSeraoIncluidosNoRomaneioEstaoEmAberto: Boolean;
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  Result := True;

  If (fCfgSis('OPCROM') = '1') Then
  Begin
    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;
    Try
      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);

      cdsTmpDoc.First;
      While Not cdsTmpDoc.Eof Do
      Begin
        If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'PD') And
           (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M')  And
           (fEmptyStr(cdsTmpDoc.FieldByName('GER_NROROM').AsString)) Then
        Begin
          If not (fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean)) and
             fPedidoFoiFaturado(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                cdsTmpDoc.FieldByName('GER_CODEMP').AsString) Then
          Begin
            pMensagemOk('O pedido '+cdsTmpDoc.FieldByName('GER_DOCORI').AsString+'-'+cdsTmpDoc.FieldByName('GER_CODEMP').AsString+
                        ' que está tentando selecionar já foi faturado por outra estação e não pode ser incluído mais em um romaneio.');
            Result := False;
          End;
        End;
        cdsTmpDoc.Next;
      End;
    Finally
      cdsTmpDoc.First;
      If blnWasEnabled Then
        pEnableControls(cdsTmpDoc, prcScroll);
    End;
  End;
end;

procedure TfrmFatRomaneio.pLimpaNomeFantasia;
  Var
    prcScroll: TPrcScroll;
begin
  pDisableControls(cdsTmpDoc, prcScroll);

  Try
    cdsTmpDoc.First;

    While (Not cdsTmpDoc.Eof) Do
    Begin
      If (Pos('CONSUMIDOR', fRetNomCliente(cdsTmpDoc.FieldByName('GER_CODCLI').AsString)) > 0) Or
         (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'OX') Then
      Begin
        cdsTmpDoc.Edit;
        cdsTmpDoc.FieldByName('CLI_FANSOB').AsString := '';
        cdsTmpDoc.Post;
      End;
      cdsTmpDoc.Next;
    End;

  Finally
    pEnableControls(cdsTmpDoc, prcScroll);
  End;
end;

procedure TfrmFatRomaneio.pLimpaPreviaImpressa(ATmpTbl, ATabela: String);
var
  LSQL: String;
  LQry: TUniQuery;
begin
  if (not FTemporariaDocumentosRomaneio.fTemRegistrosTabela(ATmpTbl)) then
    Exit;

  LQry := fCriaQuery;

  try
    LSQL := '';
    LSQL := LSQL + ' UPDATE ' + ATabela;
    LSQL := LSQL + ' SET ' + IIF(ATabela = 'FATGOR', 'FGO', 'GER') + '_PRVIMP = "N" ';
    LSQL := LSQL + ' WHERE AUTOINCREM IN (' + fListaAutIncGer(ATmpTbl, ATabela) + ') ';

    LQry.SQL.Text := LSQL;
    LQry.ExecSQL;
  finally
    FreeAndNil(LQry);
  end;
end;

function TfrmFatRomaneio.fRetMensagemExpedicao(strNumDoc, strEspDoc, strCodEmp: String; const strTabela: String;
  Var stlMsgExp: TStringList; const blnGravando : Boolean): String;
  Var
    qryPesqui:  TUniQuery;
    qryDocFut:  TUniQuery;
    stlMensag: TStringList;
    strTabTmp: String;
    
    Procedure pRelacionaDoc;
    Begin
      With qryPesqui, SQL Do
      Begin
        // PEGA OS PEDIDOS DOS DOCUMENTOS ORIGINAIS DE ENTREGA FUTURA
        Add('SELECT ');
        Add('  FGO_MENEXP, ');
        Add('  FGO_MENEX2, ');
        Add('  FGO_MENEX3, ');
        Add('  FGO_MENEX4  ');

        Add('FROM');
        Add('  FATGOR');

            // PEDIDOS DOS DOCUMENTOS ORIGINAIS DE ENTREGA FUTURA
        Add('INNER JOIN MOVGER ORI ON ');
        Add('   FGO_NUMFAT = ORI.GER_NUMDOC AND ');
        Add('   FGO_TIPFAT = ORI.GER_ESPDOC AND ');
        Add('   FGO_EMPFAT = ORI.GER_CODEMP     ');

        Add('INNER JOIN ( ');

            // DOCUMENTOS ORIGINAIS DE ENTREGA FUTURA RELACIONADOS COM OS ITENS DE BAIXA
        Add('SELECT DISTINCT');
        Add('  DET_DOCFUT, ');
        Add('  DET_ESPFUT, ');
        Add('  DET_EMPFUT  ');
        Add('FROM');

        Add('MOVDET ');

        Add('WHERE');
        Add('  DET_NUMDOC = :NUMDOC AND ');
        Add('  DET_ESPDOC = :ESPDOC AND ');
        Add('  DET_CODEMP = :CODEMP     ');

        Add(' ) BAI ON ');

                // RELACIONA COM O MOVGER ORIGINAL
        Add('   ORI.GER_NUMDOC = DET_DOCFUT AND ');
        Add('   ORI.GER_ESPDOC = DET_ESPFUT AND ');
        Add('   ORI.GER_CODEMP = DET_EMPFUT     ');
      End;
    End;

    {***************************************************************}
    {* QUANDO NA BAIXA DE ENTREGA FUTURA SELECIONAVA MAIS DE UM DOC*}
    {* GRAVAVA  SOMENTE O ULTIMO DOC SELECIONADO ENTAO FIZ ISSO    *}
    {*************************************************************LE}
    procedure pPegaMsgDocBaixaEntFut;
    Begin
      With qryDocFut, SQL Do
      Begin
        Close;
        SQL.Clear;
        Add(' SELECT ');
        Add(' MT.DET_INCFUT  ');
        Add(' FROM MOVGER ');
        Add(' INNER JOIN MOVDET MD ON MD.DET_SEQGER = MOVGER.AUTOINCREM ');
        Add(' INNER JOIN MOVTRI MT ON MT.DET_SEQGER = MD.AUTOINCREM     ');
        Add('  WHERE ');
        Add('  GER_NUMDOC = :NUMDOC AND ');
        Add('  GER_ESPDOC = :ESPDOC AND ');
        Add('  GER_CODEMP = :CODEMP AND ');
        Add('  DET_INCFUT IS NOT NULL   ');

        ParamByName('NUMDOC').AsString := strNumDoc;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODEMP').AsString := strCodEmp;
        Open;

        While Not Eof Do
        Begin
          Result := Result + QuotedStr(FieldByName('DET_INCFUT').AsString);

          If RecNo < RecordCount Then
            Result := Result + '_';

           Next;
        End;
      End;

      If (Not fEmptyStr(Result)) Then
      Begin
        Result := AnsiReplaceStr(Result,'_', ',');
        With  qryDocFut, SQL Do
        Begin
          Close;
          SQL.Clear;
          Add('SELECT ');
          Add('  GER_MENEXP,');
          Add('  GER_MENEX2,');
          Add('  GER_MENEX3,');
          Add('  GER_MENEX4 ');
          Add('  FROM ');
          Add('  MOVGER ');
          Add('  INNER JOIN MOVDET MD ON MD.DET_SEQGER = MOVGER.AUTOINCREM ');
          Add('  WHERE MD.AUTOINCREM IN ('+Result+')');
          Add('  GROUP BY MD.DET_SEQGER');
          Open;
          Result := '';
          While Not Eof Do
          Begin
            stlMsgExp.Add(FieldByName('GER_MENEXP').AsString);
            stlMsgExp.Add(FieldByName('GER_MENEX2').AsString);
            stlMsgExp.Add(FieldByName('GER_MENEX3').AsString);
            stlMsgExp.Add(FieldByName('GER_MENEX4').AsString);
            Next;
          End;
        End;
      End;
    End;

Begin
  Result := '';

  If (strTabela = 'MOVGER') And (blnGravando) And (Not fEhDocumentoBaixaEntregaFutura(strNumDoc, strEspDoc, strCodEmp, strTabela)) Then
  Begin
    If fPegouMensagensDocumento(strNumDoc, strEspDoc, strCodEmp, strTabela, stlMsgExp, Result) Then
      Exit;
  End;

  stlMensag  := TStringList.Create;
  qryPesqui  := fCriaQuery(Self);
  qryDocFut  := fCriaQuery(Self);

  Try
    If Assigned(stlMsgExp) Then
      stlMsgExp.Clear;

    With qryPesqui, SQL Do
    Begin
      Clear;

      If SameText(strTabela, 'FATGOR') Then
      Begin
        // PEDIDO FATURADO DIRETAMENTE
        Add('SELECT ');
        Add('  FGO_MENEXP AS MENEXP, ');
        Add('  FGO_MENEX2 AS MENEX2, ');
        Add('  FGO_MENEX3 AS MENEX3, ');
        Add('  FGO_MENEX4 AS MENEX4 ');
        Add('FROM');
        Add('  FATGOR F');
        Add('WHERE');
        if (Pos(strOpcRom, '1_5_') > 0) then
        begin
          Add('  FGO_NUMDOC = :NUMDOC AND');
          Add('  FGO_ESPDOC = :ESPDOC AND');
          Add('  FGO_CODEMP = :CODEMP     ');
        end
        else
        begin
          Add('  FGO_NUMFAT = :NUMDOC AND');
          Add('  FGO_TIPFAT = :ESPDOC AND');
          Add('  FGO_EMPFAT = :CODEMP     ');
        end;
        Add('UNION ALL');

        pRelacionaDoc;
      End
      Else
      Begin
        strTabTmp := 'MOVGER';
      
        Add('SELECT ');
        Add('  GER_MENEXP AS MENEXP, ');
        Add('  GER_MENEX2 AS MENEX2, ');
        Add('  GER_MENEX3 AS MENEX3, ');
        Add('  GER_MENEX4 AS MENEX4 ');
        Add('FROM');
        Add(strTabTmp);
        Add('WHERE');

        If SameText(strTabela, 'NOTGER') Then
        Begin
          Add('  GER_NUMFAT = :NUMDOC AND');
          Add('  GER_TIPFAT = :ESPDOC AND');
          Add('  GER_EMPFAT = :CODEMP    ');
        End
        Else
        Begin
          Add('  GER_NUMDOC = :NUMDOC AND');
          Add('  GER_ESPDOC = :ESPDOC AND');
          Add('  GER_CODEMP = :CODEMP    ');
        End;
      End;

      ParamByName('NUMDOC').AsString := strNumDoc;
      ParamByName('ESPDOC').AsString := strEspDoc;
      ParamByName('CODEMP').AsString := strCodEmp;

      Open;

      While Not Eof Do
      Begin
        stlMensag.Add(FieldByName('MENEXP').AsString);
        stlMensag.Add(FieldByName('MENEX2').AsString);
        stlMensag.Add(FieldByName('MENEX3').AsString);
        stlMensag.Add(FieldByName('MENEX4').AsString);

        If Assigned(stlMsgExp) Then
        Begin
          If(fEhDocumentoBaixaEntregaFutura(strNumDoc, strEspDoc, strCodEmp, strTabela)) Then
            pPegaMsgDocBaixaEntFut
          Else
          Begin
            stlMsgExp.Add(FieldByName('MENEXP').AsString);
            stlMsgExp.Add(FieldByName('MENEX2').AsString);
            stlMsgExp.Add(FieldByName('MENEX3').AsString);
            stlMsgExp.Add(FieldByName('MENEX4').AsString);
          End;
        End;

        Next;
      End;

      If Assigned(stlMsgExp) Then
        Result := AnsiReplaceStr(stlMsgExp.Text, #13#10, ' ')
      Else
        Result := AnsiReplaceStr(stlMensag.Text, #13#10, ' ');

      Close;                                                                     
    End;
  Finally
    FreeAndNil(qryPesqui);
    FreeAndNil(stlMensag);
    FreeAndNil(qryDocFut);
  End;
End;

function TfrmFatRomaneio.fRetNumLotItemRastravel(strCodIte, strNumLot,
  strCodEmp: string; fltQtdIte: Double): string;
var
  qryLote: TUniQuery;
  qryPickin: TUniQuery;
begin
  Result := strNumLot;
  qrylote := fCriaQuery;
  qryPickin := fCriaQuery;

  try
    qryLote.Close;
    qryLote.SQL.Clear;
    qryLote.SQL.Add('SELECT SUM(LOT_SALDOS) AS SALDOS, LOT_CODBAR');
    qryLote.SQL.Add(' FROM CADLOT');
    qryLote.SQL.Add('WHERE LOT_CODITE = :CODITE');
    qryLote.SQL.Add('AND LOT_CODEMP = :CODEMP');
    qryLote.SQL.Add('AND LOT_STATUS = "S"');
    qryLote.SQL.Add('AND :DTALOT BETWEEN LOT_DTAFAB AND LOT_DTAVAL');
    qryLote.SQL.Add('AND LOT_NUMLOT <> "A DEFINIR"');
    qryLote.SQL.Add('GROUP BY LOT_CODBAR');
    qryLote.SQL.Add('ORDER BY LOT_SALDOS');

    qryLote.ParamByName('CODITE').AsString := strCodIte;
    qryLote.ParamByName('CODEMP').AsString := strCodEmp;
    qryLote.ParamByName('DTALOT').AsDate   := VS_Date;

    qryLote.Open;
    qryLote.First;

    qryPickin.Close;
    qryPickin.SQL.Clear;
    qryPickin.SQL.Add('SELECT LOT_NUMLOT');
    qryPickin.SQL.Add('FROM CADLOT');
    qryPickin.SQL.Add('INNER JOIN CADLOC');
    qryPickin.SQL.Add('ON LOT_LOCFIS = LOC_CODLOC');
    qryPickin.SQL.Add('WHERE LOT_CODBAR = :CODBAR');

    while not qryLote.Eof do
    begin
      if (qryLote.FieldByName('SALDOS').AsFloat >= fltQtdIte)  then
      begin
        strCodBar := qryLote.FieldByName('LOT_CODBAR').AsString;

        if fCampoTabela('ITE_RASTRE', 'CADITE', ['ITE_CODITE'], [strCodIte]) = 'S' then
        begin
          qryPickin.Close;
          qryPickin.ParamByName('CODBAR').AsString := strCodBar;
          qryPickin.Open;

          if not qryPickin.IsEmpty then
          begin
            Result := qryPickin.FieldByName('LOT_NUMLOT').AsString;
            SetLength(arrDadosCodBarra, Length(arrDadosCodBarra) + 1);
            arrDadosCodBarra[Length(arrDadosCodBarra) - 1].strCodEmp := strCodEmp;
            arrDadosCodBarra[Length(arrDadosCodBarra) - 1].strCodIte := strCodIte;
            arrDadosCodBarra[Length(arrDadosCodBarra) - 1].strCodBar := strCodBar;
            Exit;
          end;
        end
        else
        begin
          SetLength(arrDadosCodBarra, Length(arrDadosCodBarra) + 1);
          arrDadosCodBarra[Length(arrDadosCodBarra) - 1].strCodEmp := strCodEmp;
          arrDadosCodBarra[Length(arrDadosCodBarra) - 1].strCodIte := strCodIte;
          arrDadosCodBarra[Length(arrDadosCodBarra) - 1].strCodBar := strCodBar;
        end;
      end;

      qryLote.Next;
    end;

  finally
    FreeAndNil(qrylote);
    FreeAndNil(qryPickin);
    strCodBar := EmptyStr;
  end;
end;

{*******************************************}
{* FAZ GRAVAÇÃO NO ROMGERX ROMDETX         *}
{****************************************MV*}
function TfrmFatRomaneio.fGravaRomaneio(qryMovGer: TUniQuery; ATransMot: TDadosTransMot; Var strNumRom: String;
  strOpeSol, strEntSai, AAutInc: String; qryRomGerX: TUniQuery = nil): Boolean;
var
  strAutInc: String;
  LRecRomGer: TDadosRomGer;

  blnPedOrc: Boolean;
  qryGenDet: TUniQuery;
  qryPedido: TUniQuery;

  objHisPed: THisPed;

  strNumDocHis: String;
  strEspDocHis: String;
  strCodEmpHis: String;

  strTabelaMovDet: String;

  stlTmp: TStringList;

  strNumPedTmp: String;
  strEmpPedTmp: String;

  prcScroll: TprcScroll;
  blnWasEnabled: Boolean;

  objDadosDisparoAutomatico: TDadosDisparoAutomatico;

  strTipEnt,
  strCodFil: String;

  arrDuplicataCND: TarrDuplicata;
begin
  qryGenDet := fCriaQuery(Self);
  objHisPed := THisPed.Create(Self);
  stlTmp    := TStringList.Create;
  qryPedido := fCriaQuery(Self);

  Try
    LRecRomGer.strMsgExp := '';
    LRecRomGer.strMenExp := '';
    LRecRomGer.strMenEx2 := '';
    LRecRomGer.strMenEx3 := '';
    LRecRomGer.strMenEx4 := '';
    LRecRomGer.strLocali := '';
    LRecRomGer.strLibApp := 'N';
    LRecRomGer.strEvitar := '';
    LRecRomGer.fltDistan := 0;
    LRecRomGer.fltTmpEnt := 0;
    LRecRomGer.intPriori := 0;
    LRecRomGer.dtaDtaIni := 0;
    LRecRomGer.hraHorIni := 0;
    LRecRomGer.strFstSht := '';
    LRecRomGer.strPalet  := '';

    qryPedido.SQL.Add('SELECT FGO_NUMDOC, FGO_ESPDOC, FGO_CODEMP, AUTOINCREM');
    qryPedido.SQL.Add('FROM FATGOR');
    qryPedido.SQL.Add('WHERE FGO_NUMFAT = :NUMDOC');
    qryPedido.SQL.Add('  AND FGO_TIPFAT = :ESPDOC');
    qryPedido.SQL.Add('  AND FGO_EMPFAT = :CODEMP');

    blnPedOrc := (qryMovGer.FieldByName('GER_NOMTBL').AsString = 'FATGOR');

    If (Pos(strOpcRom, '34') <= 0) Then
      strTabelaMovDet := 'MOVDET'
    Else
    Begin
      strTabelaMovDet := AnsiReplaceStr(qryMovGer.FieldByName('GER_NOMTBL').AsString, 'GER', 'DET');
    End;

    If (qryMovGer.FindField('GER_ESPDOC') <> Nil) And
       (qryMovGer.FieldByName('GER_ESPDOC').AsString = 'OX') Then
    Begin
      pSetaValOutasEntregas(LRecRomGer, qryMovGer);
      strNumDocHis := qryMovGer.FieldByName('GER_DOCORI').AsString;
      strEspDocHis := qryMovGer.FieldByName('GER_ESPDOC').AsString;
      strCodEmpHis := qryMovGer.FieldByName('GER_CODEMP').AsString;
      ATransMot.strCodReg := qryMovGer.FieldByName('CODREG').AsString;
    End
    Else If (Pos(strOpcRom, '1_5_') > 0) And (blnPedOrc) Then
    Begin
      pSetaValOpcRom1_5(LRecRomGer, qryMovGer, strEntSai);
      strNumDocHis := qryMovGer.FieldByName('GER_NUMDOC').AsString;
      strEspDocHis := qryMovGer.FieldByName('GER_ESPDOC').AsString;
      strCodEmpHis := qryMovGer.FieldByName('GER_CODEMP').AsString;

      LRecRomGer.strMsgExp := fRetMensagemExpedicao(LRecRomGer.strNumDoc,
                                                    LRecRomGer.strEspDoc,
                                                    LRecRomGer.strCodEmp,
                                                    qryMovGer.FieldByName('GER_NOMTBL').AsString,
                                                    stlTmp,
                                                    True);

      If (stlTmp.Count > 0) Then
      Begin
        LRecRomGer.strMenExp := stlTmp[0];
        LRecRomGer.strMenEx2 := stlTmp[1];
        LRecRomGer.strMenEx3 := stlTmp[2];
        LRecRomGer.strMenEx4 := stlTmp[3];
      End;

      LRecRomGer.strStatus := IfThen(blnUsaPreRom,'P','A');
    End
    Else
    Begin
      pRetNumeroPedido(qryMovGer.FieldByName('GER_NUMDOC').AsString,
                       qryMovGer.FieldByName('GER_ESPDOC').AsString,
                       qryMovGer.FieldByName('GER_CODEMP').AsString,
                       strNumDocHis,
                       strEspDocHis,
                       strCodEmpHis);

      pSetaValOpcRom2_3_4(LRecRomGer, qryMovGer, strEntSai);

      LRecRomGer.strMsgExp := fRetMensagemExpedicao(LRecRomGer.strNumDoc,
                                                    LRecRomGer.strEspDoc,
                                                    LRecRomGer.strCodEmp,
                                                    qryMovGer.FieldByName('GER_NOMTBL').AsString,
                                                    stlTmp,
                                                    True);

      If (stlTmp.Count > 0) Then
      Begin
        LRecRomGer.strMenExp := stlTmp[0];
        LRecRomGer.strMenEx2 := stlTmp[1];
        LRecRomGer.strMenEx3 := stlTmp[2];
        LRecRomGer.strMenEx4 := stlTmp[3];
      End;

      LRecRomGer.strStatus := 'A';
    End;

    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

    Try
      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);

      cdsTmpDoc.Filtered := False;
      cdsTmpDoc.Filter   :=                    '(GER_DOCORI = ' + QuotedStr(LRecRomGer.strNumDoc) + ') AND ';
      cdsTmpDoc.Filter   := cdsTmpDoc.Filter + '(GER_ESPDOC = ' + QuotedStr(LRecRomGer.strEspDoc) + ') AND ';
      cdsTmpDoc.Filter   := cdsTmpDoc.Filter + '(GER_CODCLI = ' + QuotedStr(LRecRomGer.strCodCli) + ') AND ';
      cdsTmpDoc.Filter   := cdsTmpDoc.Filter + '(GER_CODEMP = ' + QuotedStr(LRecRomGer.strCodEmp) + ') AND ';
      cdsTmpDoc.Filter   := cdsTmpDoc.Filter + '(GER_ENTSAI = ' + QuotedStr(strEntSai) + ')     ';
      cdsTmpDoc.Filtered := True;
    Finally
      If blnWasEnabled Then
        pEnableControls(cdsTmpDoc, prcScroll);
    End;

    LRecRomGer.strNomTab := cdsTmpDoc.FieldByName('GER_NOMTBL').AsString;
    LRecRomGer.intOrdImp := cdsTmpDoc.fieldbyname('GER_ORDIMP').AsInteger;
    LRecRomGer.strPalet  := cdsTmpDoc.fieldbyname('GER_PALET_').AsString;

    pSetaValApp(LRecRomGer);
    pSetaValEndereco(LRecRomGer);

    strTipEnt := cdsTmpDoc.FieldByName('GER_TIPENT').AsString;
    strCodFil := cdsTmpDoc.FieldByName('GER_CODFIL').AsString;

    If (fltPesBruGrvRom = -1) Then
    Begin
      If (blnUtilizaMultiVeiculosRomaneio) Then
        fltPesBruGrvRom := fPesoBrutoSelecionado(varDouble, False, cdsTmpDoc.fieldbyname('GER_VEICUL').AsString)
      Else
        fltPesBruGrvRom := fPesoBrutoSelecionado(varDouble);
    End;

    If (fltPesLiqGrvRom = -1) Then
    Begin
      If (blnUtilizaMultiVeiculosRomaneio) Then
        fltPesLiqGrvRom := fPesoLiquidoSelecionado(cdsTmpDoc.fieldbyname('GER_VEICUL').AsString)
      Else
        fltPesLiqGrvRom := fPesoLiquidoSelecionado;
    End;

    LRecRomGer.fltPesBru := fltPesBruGrvRom;
    LRecRomGer.fltPesLiq := fltPesLiqGrvRom;

    If (LRecRomGer.strNomTab = 'FATGOR') Then
      pCarregaDuplicatasCND(1, LRecRomGer.strAutIncGer, arrDuplicataCND)
    Else If (LRecRomGer.strNomTab = 'MOVGER') Then
      pCarregaDuplicatasCND(2, LRecRomGer.strAutIncGer, arrDuplicataCND)
    Else
      pCarregaDuplicatasCND(3, LRecRomGer.strAutIncGer, arrDuplicataCND);

    pCarregaDadosFusion(LRecRomGer.strIntFus, LRecRomGer.strRomFus, LRecRomGer.strLatLon, LRecRomGer.strNumDoc, LRecRomGer.strEspDoc, LRecRomGer.strCodEmp);

    If fEmptyStr(strDefCon) Then
    Begin
      If Not fCfgSis('MATDIS', varBoolean) then
        strDefCon := 'NAO'
      Else
        strDefCon := 'NF9';
    End;

    LRecRomGer.strDefCon := strDefCon;

    {*******************************************}
    {* GRAVA ARQUIVO GERAL                     *}
    {****************************************MV*}
    Result := fGravaRomGer(strNumRom,              // Número do Romaneio (Referencia)
                           strAutInc,              // Auto Incremento (Referência)
                           LRecRomGer.strNumDoc,   // Documento
                           LRecRomGer.strEspDoc,   // Espécie
                           LRecRomGer.strCodEmp,   // Empresa
                           ATransMot.strCodTra,    // Transportadora
                           LRecRomGer.strCodVen,   // Vendedor
                           LRecRomGer.strCodFor,   // Fornecedor
                           LRecRomGer.strCodCli,   // Cliente
                           LRecRomGer.strTip_fc,   // Tipo (Cliente / Fornecedor)
                           LRecRomGer.dtaDtaEnt,   // Data de Entrada
                           LRecRomGer.tmrHorEnt,   // Hora de Entrada
                           LRecRomGer.dtaDtaDoc,   // Data do Documento
                           LRecRomGer.strConPag,   // Condição de Pagamento
                           LRecRomGer.strEstAdo,   // Estado
                           LRecRomGer.strNomCon,   // Nome Cliente Consumidor
                           LRecRomGer.strEndCon,   // Endereço Cliente Consumidor
                           LRecRomGer.strBaiCon,   // Bairro Cliente Consumidor
                           LRecRomGer.strCepCon,   // CEP Cliente Consumidor
                           LRecRomGer.strCidCon,   // Cidade Cliente Consumidor
                           LRecRomGer.strEstCon,   // Estado Cliente Consumidor
                           LRecRomGer.strTelCon,   // Telefone Cliente Consumidor
                           LRecRomGer.strCgcCpf,   // CGC/CPF Cliente Consumidor
                           LRecRomGer.strCgcCon,   // CNPJ Cliente Consumidor
                           LRecRomGer.strIesCon,   // Inscrição Estadual Cliente Consumidor
                           LRecRomGer.strCli_Rg,   // RG Cliente Consumidor
                           LRecRomGer.strRomImp,   // Romaneio já impresso?
                           LRecRomGer.fltBasSim,   // Base Simples Paulista
                           LRecRomGer.fltBasIpi,   // Base IPI
                           LRecRomGer.fltAlqIpi,   // Aliquota IPI
                           LRecRomGer.fltTotIpi,   // Total de IPI
