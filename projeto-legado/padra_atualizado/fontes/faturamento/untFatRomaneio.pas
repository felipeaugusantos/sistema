      VK_F7:Begin
              If (Length(arrVeiculos) >= 7) Then
              begin
                pSelecionaPanelVeiculo(7);
              end;
            End;

      VK_F8:Begin
              If (Length(arrVeiculos) >= 8) Then
              begin
                pSelecionaPanelVeiculo(8);
              end;
            End;

      VK_F9:Begin
              If (Length(arrVeiculos) >= 9) Then
              begin
                pSelecionaPanelVeiculo(9);
              end;
            End;
    End;
  End
  Else If (Shift = [ssAlt]) Then
  Begin
    Case Key Of
      VK_F1: btnFeriados.Click;
      VK_F2: btnPedPendentes.Click;
      VK_F3: begin
               if btnAdicChaveAcesso.Visible then
                 btnAdicChaveAcesso.Click;
             end;
      VK_F5: btnManEnd.Click;
      VK_F6: btnResumoAberto.Click;
      VK_F7: btnManutRomaneio.Click;
      VK_F8: If btnLogRastreamento.Visible Then
               btnLogRastreamento.Click;
      VK_F9: btnPreviaRomaneio.Click;
      Else if (char(Key) = 'E') then
      begin
        if btnManutEntrega.Visible then
          btnManutEntrega.Click;
      end;
    End
  End
  Else
  Begin
    Case Key Of
      VK_F5:     btnVisualizarItensDocumentos.Click;
      VK_F6:     btnReimprimeRomaneio.Click;
      VK_F7:     btnReimprimeDocumento.Click;
      VK_F8:     btnEntrRealizadas.Click;
      VK_F9:     btnEntrPendentes.Click;
      VK_F2:     if btnNovoVeiculo.Visible then
                 begin
                   btnNovoVeiculo.Click;
                 end;

      VK_RETURN: If ActiveControl Is TCheckListBox Then
                   SelectNext(ActiveControl, True, True);

      VK_F10: btnConfirma.Click;
      VK_F11: btnOutEnt.Click;
      VK_F12: btnAcoEnt.Click;
    End;
  End;
end;

procedure TfrmFatRomaneio.edtNumRomKeyPress(Sender: TObject;
  var Key: Char);
  Var
    qryConGen: TUniQuery;
    arrSel   : TConsultasArray;
begin
  inherited;

  If (edtNumRom.ReadOnly) Then
    Exit;

  qryConGen := fCriaQuery(Self);

  Try

    If (fEhRomaneioSimplificado) And (fEmptyStr(edtNumRom.Text)) And (Key = #13) Then
      btnConsultarClick(Self) {<<-- Se o operador deu "Enter", com campo em branco, já coloca em modo de inserção!}
    Else
    If fPesqRomaneio(Self, edtNumRom, qryConGen, Key, arrSel, '', True, True, 'Consulta de Romaneios') Then
    Begin
      If (fValidaCampos(edtNumRom, True)) Then
      Begin
        SelectNext(ActiveControl, True, True);
      End;
    End;

  Finally
    FreeAndNil(qryConGen);
  End;

end;

procedure TfrmFatRomaneio.edtTraFatExit(Sender: TObject);
begin
  inherited;
  pEdtCodSelectExit(edtTraFat, edtNomTraFat, arrTraFat, fRetNomTransportadora, nil, 'da Transportadora');
end;

procedure TfrmFatRomaneio.edtTraFatKeyPress(Sender: TObject; var Key: Char);
begin
  inherited;
  If fPesqTransportadora(conTraSimples, Self, edtTraFat, edtNomTraFat, nil, Key, arrTraFat, False) Then
  Begin
    If fValidaCampos(edtTraFat, True) Then
      SelectNext(ActiveControl, True, True);
  End;
end;


function TfrmFatRomaneio.fExecutaInsertsInBatch(var AExecutar: Boolean; AQtd: Integer; AUltimaExec: Boolean): Boolean;
begin
  Result := True;

  if (not fGravacaoEmLote) or (not AExecutar) then
    Exit;

  if ((AQtd mod 200) <> 0) and (not AUltimaExec) then
    Exit;

  try
    FInsertsInBatchRomGerX.ExecSQL;
    FInsertsInBatchAuxRomX.ExecSQL;
    FInsertsInBatchRomDetX.ExecSQL;
    FInsertsInBatchRomTraX.ExecSQL;
    FInsertsInBatchRomCnd.ExecSQL;
    FInsertsInBatchHisPed.ExecSQL;

    blnGerouUmRomaneioOrfao := fVerificaGerouRomaneioOrfao;
    Result := (not blnGerouUmRomaneioOrfao);

    Result := Result and (not fVerificaQtdeRomInvalidoEmLote) and (not fVerificaQtdeBaixadaInvalidaEmLote);
    Result := Result and (fBaixaTransbordoEmLote);

    FTemporariaDocumentosRomaneio.pLimparTemporaria(FTabTmpRomInvalido);
    FListaAutIncRom.Clear;

    AExecutar := False;
    pCriaInsertsInBatch;
  except
    on e: ExceptionQtdRomaneio do
      raise;
    on e: Exception do
      raise;
  end;
end;

function TfrmFatRomaneio.fExibeFiltroTipoDocumento: Boolean;
begin
  Result := (Pos(strOpcRom, '1_5_2_') > 0);
end;

Function TfrmFatRomaneio.fRetListaEmpresas: String;
  Var
    intContad: Integer;
Begin
  Result := '';

  For intContad := Low(arrEmpres) To High(arrEmpres) Do
    Result := Result + arrEmpres[intContad].strCodigo + '_';

  If fEmptyStr(Result) Then
    Result := strAceRom;
End;

Function TfrmFatRomaneio.fRetSQLFiltroEmpresas(strAlias: String): String;
  Var
    intContad: Integer;
Begin
  Result := '';

  For intContad := Low(arrEmpres) To High(arrEmpres) Do
  Begin
    If Result <> '' Then
      Result := Result + ',';
    Result := Result + ' "' + arrEmpres[intContad].strCodigo + '" ';
  End;

  If Result = '' Then
  Begin
    Result := fGetSQLInEmpresasAcesso(strAlias, strAceRom);
    Exit;
  End;

  Result := ' ' + strAlias + ' IN (' + Result + ') ';
End;

function TfrmFatRomaneio.fRetSQLtdListaDevolucaoPR: String;
var
