  strSQL := strSQL + '    DIG_VALDOC  AS GER_VLRCON, ';
  strSQL := strSQL + '    DIG_VALDOC  AS GER_VALDOC, ';
  strSQL := strSQL + '    0.00        AS GER_VLRPRO, ';
  strSQL := strSQL + '    "   "       AS GER_ROMIMP, ';
  strSQL := strSQL + '    "D"         AS GER_MARDES, ';
  strSQL := strSQL + '    " "         AS GER_VEICUL, ';
  strSQL := strSQL + fGetSQLPosObs('OUTDIGX','DIG_NUMDOC','DIG_ESPDOC','DIG_CODEMP') + ' AS POSOBS, ';
  strSQL := strSQL + '    " "         AS GER_PALET_, ';
  strSQL := strSQL + '    0.00        AS GER_VALSEL, ';
  strSQL := strSQL + '    0.00        AS GER_VSEPRO, ';
  strSQL := strSQL + '    " "         AS GER_TIP_FC, ';
  strSQL := strSQL + '    0           AS GER_ORDIMP, ';
  strSQL := strSQL + '    " "         AS GER_ALTERA, ';
  strSQL := strSQL + '    0           AS INCREMENTO, ';
  strSQL := strSQL + '    " "         AS GER_CODTRA, ';
  strSQL := strSQL + '    " "         AS GER_TRANSP, ';
  strSQL := strSQL + '    " "         AS GER_TRAFAT, ';
  strSQL := strSQL + '    " "         AS GER_TRADOC, ';
  strSQL := strSQL + '    DIG_PESBRU  AS GER_PESBRU, ';
  strSQL := strSQL + '    "OUTDIGX"   AS GER_NOMTBL, ';
  strSQL := strSQL + '  OUTDIGX.AUTOINCREM AS GER_AUTINC, ';

  If (strOpcRom = '4') Then
  Begin
    strSQL := strSQL + '  " "         AS GER_NUMFAT, ';
