      strSelect := strSelect + ', CAST(NULL AS DATE) AS GER_DTAINI ';
      strSelect := strSelect + ', CAST(NULL AS DATE) AS GER_HORINI ';

      strSelect := strSelect + 'FROM ';
      strSelect := strSelect + '  FATGOR ';
      strSelect := strSelect + '  INNER JOIN FATDOR   ON FATDOR.FDO_SEQGER = FATGOR.AUTOINCREM ';
      strSelect := strSelect + '  INNER JOIN EXTDOR   ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
