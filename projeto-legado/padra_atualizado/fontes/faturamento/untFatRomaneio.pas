                           LRecRomGer.fltVpaR04,   // Valor da Parcela 04
                           LRecRomGer.fltVpaR05,   // Valor da Parcela 05
                           LRecRomGer.fltVpaR06,   // Valor da Parcela 06
                           LRecRomGer.fltVpaR07,   // Valor da Parcela 07
