      strSelect := strSelect + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = FATGOR.FGO_CODCND   ';

      strSelect := strSelect + 'WHERE ';

      strSelect := strSelect + ' NOT EXISTS (SELECT PRE_NUMDOC FROM PREPTE ';
      strSelect := strSelect + '             WHERE PRE_NUMDOC = FATGOR.FGO_NUMDOC ';
      strSelect := strSelect + '               AND PRE_ESPDOC = FATGOR.FGO_ESPDOC ';
      strSelect := strSelect + '               AND PRE_EMPDOC = FATGOR.FGO_CODEMP ';
