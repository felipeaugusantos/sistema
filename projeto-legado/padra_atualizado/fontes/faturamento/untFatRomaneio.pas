procedure TfrmFatRomaneio.btnExcluirVeiculoClick(Sender: TObject);
  var
    LobjPai         : TWinControl;
    LstrVeiculo     : string;
    prcScroll       : TprcScroll;
    LblnWasEnabled  : Boolean;
    LintRecNo       : Integer;

  function fVerificarPanelDadosPreenchidos: boolean;
  var
    objTransp: TLabel;
  begin
    objTransp := LobjPai.FindComponent('lblTranspDesc_' + LstrVeiculo) as TLabel;
    if not Assigned(objTransp) then
      Exit(False);
    result := not Trim(objTransp.Caption).IsEmpty;
  end;

  function fConfirmarExclusaoVeiculo: boolean;
  begin
    if not fVerificarPanelDadosPreenchidos then
      Exit(True);
    if (fMensagem('ATENÇÃO!',
                  'Ao excluir o veículo todos os documentos relacionados a ele serão desmarcados. '+
                  'Deseja continuar?',
                  ['&Sim', '&Não'],
                  mrCancel) = mrOk) then
    begin
      Exit(True);
    end;
    Result := False;
  end;

  procedure pDeselecionaTodosPaineis;
  var
    intIndex: integer;
  begin
    for intIndex := 0 to flwpnlVeiculo.ControlCount - 1 do
    begin
      if not (flwpnlVeiculo.Controls[intIndex] is TPanel) then
        continue;
      TPanel(flwpnlVeiculo.Controls[intIndex]).Color := $00FFE4D5;
    end;
    objPanelSelecionado := nil;
    dbgDocumentos.Invalidate;
    Application.ProcessMessages;
  end;

begin
  LintRecNo   := 0;
  LobjPai     := TBitBtnLocked(Sender).Parent;

  if objPanelSelecionado <> LobjPai then
    TPanel(LobjPai).OnClick(LobjPai);

  LstrVeiculo := Copy(LobjPai.Name, Pos('_', LobjPai.Name)+1, 1);

  if fConfirmarExclusaoVeiculo then
  Begin
    if cdsTmpDoc.Active  then
    Begin
      LblnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

      if LblnWasEnabled then
        pDisableControls(cdsTmpDoc, prcScroll);

      LintRecNo := cdsTmpDoc.RecNo;

      cdsTmpDoc.First;
      while not cdsTmpDoc.Eof do
      Begin
        if (cdsTmpDoc.FieldByName('GER_VEICUL').AsString = LstrVeiculo) and
           (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') > 0) then
          pSelecionaDocumento;

        cdsTmpDoc.Next;
      End;

      if LblnWasEnabled then
        pEnableControls(cdsTmpDoc, prcScroll);
    End;

    pExcluirPainelVeiculo(LstrVeiculo);

    if cdsTmpDoc.Active  then
      cdsTmpDoc.RecNo := LintRecNo;

    pDeselecionaTodosPaineis;
  end;
end;

procedure TfrmFatRomaneio.btnRelatorioVeiculoClick(Sender: TObject);
var
  LobjPai         : TWinControl;
  LstrVeiculo     : string;
  blnTemDados     : Boolean;
  qryVeiRom       : TUniQuery;

  function fVerificarPanelDadosPreenchidos: boolean;
  var
    objTransp: TLabel;
  begin
    objTransp := LobjPai.FindComponent('lblTranspDesc_' + LstrVeiculo) as TLabel;
    if not Assigned(objTransp) then
      Exit(False);
    result := not Trim(objTransp.Caption).IsEmpty;
  end;

begin
  LobjPai     := TBitBtnLocked(Sender).Parent;

  blnTemDados := False;

  if objPanelSelecionado <> LobjPai then
    TPanel(LobjPai).OnClick(LobjPai);

  LstrVeiculo := Copy(LobjPai.Name, Pos('_', LobjPai.Name)+1, 1);

  if not fVerificarPanelDadosPreenchidos then
    Exit;

  if cdsTmpDoc.Active  then
  Begin
    cdsTmpDoc.First;
    while not cdsTmpDoc.Eof do
    Begin
      if (cdsTmpDoc.FieldByName('GER_VEICUL').AsString = LstrVeiculo) and
         (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') > 0) then
      begin
        if not blnTemDados then
        begin
          qryVeiRom := fCriaQuery;
          qryVeiRom.SQL.Clear;
          qryVeiRom.SQL.Add('DROP TEMPORARY TABLE IF EXISTS TMP_VEIROM;');
          qryVeiRom.SQL.Add('CREATE TEMPORARY TABLE TMP_VEIROM(        ');
          qryVeiRom.SQL.Add('  TMP_NUMROM VARCHAR(6),                  ');
          qryVeiRom.SQL.Add('  TMP_PLAVEI VARCHAR(7),                  ');
          qryVeiRom.SQL.Add('  TMP_CODTRA VARCHAR(5),                  ');
          qryVeiRom.SQL.Add('  TMP_CODMOT VARCHAR(5),                  ');
          qryVeiRom.SQL.Add('  TMP_NUMDOC VARCHAR(12),                 ');
          qryVeiRom.SQL.Add('  TMP_ESPDOC CHAR(2),                     ');
          qryVeiRom.SQL.Add('  TMP_CODEMP CHAR(3),                     ');
          qryVeiRom.SQL.Add('  TMP_CODCLI VARCHAR(8),                  ');
          qryVeiRom.SQL.Add('  TMP_NOMCID VARCHAR(40),                 ');
          qryVeiRom.SQL.Add('  TMP_ESTADO CHAR(2)                      ');
          qryVeiRom.SQL.Add(');                                        ');
          qryVeiRom.ExecSQL;

          qryVeiRom.SQL.Clear;
          qryVeiRom.SQL.Add('DROP TEMPORARY TABLE IF EXISTS TMP_VEIDET;');
          qryVeiRom.SQL.Add('CREATE TEMPORARY TABLE TMP_VEIDET(        ');
          qryVeiRom.SQL.Add('  TMP_NUMROM VARCHAR(6),                  ');
          qryVeiRom.SQL.Add('  TMP_NUMDOC VARCHAR(12),                 ');
          qryVeiRom.SQL.Add('  TMP_ESPDOC CHAR(2),                     ');
          qryVeiRom.SQL.Add('  TMP_CODEMP CHAR(3),                     ');
          qryVeiRom.SQL.Add('  TMP_CODCLI VARCHAR(8),                  ');
          qryVeiRom.SQL.Add('  TMP_CODITE VARCHAR(5),                  ');
          qryVeiRom.SQL.Add('  TMP_QTDITE DECIMAL(12,4) DEFAULT NULL   ');
          qryVeiRom.SQL.Add(');                                        ');
          qryVeiRom.ExecSQL;

          blnTemDados := True;
        end;

        qryVeiRom.SQL.Clear;
        qryVeiRom.SQL.Add('INSERT INTO TMP_VEIROM(');
        qryVeiRom.SQL.Add('  TMP_NUMROM, TMP_PLAVEI, TMP_CODTRA, TMP_CODMOT, TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODCLI, TMP_NOMCID, TMP_ESTADO');
        qryVeiRom.SQL.Add(')VALUES(');
        qryVeiRom.SQL.Add('  :NUMROM, :PLAVEI, :CODTRA, :CODMOT, :NUMDOC, :ESPDOC, :CODEMP, :CODCLI, :NOMCID, :ESTADO');
        qryVeiRom.SQL.Add(');');
        qryVeiRom.ParamByName('NUMROM').AsString := edtNumRom.Text;
        qryVeiRom.ParamByName('PLAVEI').AsString := arrVeiculos[StrToInt(LstrVeiculo)-1].strPlaVeic;
        qryVeiRom.ParamByName('CODTRA').AsString := arrVeiculos[StrToInt(LstrVeiculo)-1].strCodTRansp;
        qryVeiRom.ParamByName('CODMOT').AsString := arrVeiculos[StrToInt(LstrVeiculo)-1].strCodMot;
        qryVeiRom.ParamByName('NUMDOC').AsString := Copy(cdsTmpDoc.FieldByName('GER_NUMDOC').AsString, 1, 12);
        qryVeiRom.ParamByName('ESPDOC').AsString := Copy(cdsTmpDoc.FieldByName('GER_NUMDOC').AsString, 14, 2);
        qryVeiRom.ParamByName('CODEMP').AsString := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
        qryVeiRom.ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
        qryVeiRom.ParamByName('NOMCID').AsString := cdsTmpDoc.FieldByName('GER_NOMCID').AsString;
        qryVeiRom.ParamByName('ESTADO').AsString := cdsTmpDoc.FieldByName('GER_ESTADO').AsString;
        qryVeiRom.ExecSQL;

        Try

          cdsRomDet.Filtered := False;
          cdsRomDet.Filter   := '(DET_QTDBAI > 0) AND DET_SEQGER = ' + QuotedStr(cdsTmpDoc.FieldByName('INCREMENTO').AsString);
          cdsRomDet.Filtered := True;

          If Not cdsRomDet.IsEmpty Then
          Begin
            cdsRomDet.First;
            While Not cdsRomDet.Eof Do
            Begin

              qryVeiRom.SQL.Clear;
              qryVeiRom.SQL.Add('INSERT INTO TMP_VEIDET(');
              qryVeiRom.SQL.Add('  TMP_NUMROM, TMP_NUMDOC, TMP_ESPDOC, TMP_CODEMP, TMP_CODCLI, TMP_CODITE, TMP_QTDITE');
              qryVeiRom.SQL.Add(')VALUES(');
              qryVeiRom.SQL.Add('  :NUMROM, :NUMDOC, :ESPDOC, :CODEMP, :CODCLI, :CODITE, :QTDITE');
              qryVeiRom.SQL.Add(');');
              qryVeiRom.ParamByName('NUMROM').AsString := edtNumRom.Text;
              qryVeiRom.ParamByName('NUMDOC').AsString := Copy(cdsTmpDoc.FieldByName('GER_NUMDOC').AsString, 1, 12);
              qryVeiRom.ParamByName('ESPDOC').AsString := Copy(cdsTmpDoc.FieldByName('GER_NUMDOC').AsString, 14, 2);
              qryVeiRom.ParamByName('CODEMP').AsString := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
              qryVeiRom.ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
              qryVeiRom.ParamByName('CODITE').AsString := cdsRomDet.FieldByName('DET_CODITE').AsString;
              qryVeiRom.ParamByName('QTDITE').AsFloat  := cdsRomDet.FieldByName('DET_QTDBAI').AsFloat;
              qryVeiRom.ExecSQL;

              cdsRomDet.Next;
            End;
          End;

        Finally
          cdsRomDet.Filter   := '';
          cdsRomDet.Filtered := False;
        End;

      end;

      cdsTmpDoc.Next;

    End;

  End;

  if blnTemDados then
  begin
    if Assigned(prcExecutaRelatorio) then
    begin
      prcExecutaRelatorio(235, 8034, [], [], [], Sender, nil, True);
    end;
    FreeAndNil(qryVeiRom);
  end;

end;

