procedure TfrmFatRomaneio.pRetornaTransMot(var ATransMot: TDadosTransMot; ANumRom: String);
var
  LSQL: String;
  LQry: TUniQuery;
begin
  LQry := fCriaQuery(nil);

  Try
    ATransMot.strCodTra := '';
    ATransMot.strCodMot := '';
    ATransMot.strNumBox := '';
    ATransMot.strPlaVei := '';

    LSQL := '';
    LSQL := LSQL + 'SELECT ';
    LSQL := LSQL + '  GER_PLAVEI, ';
    LSQL := LSQL + '  GER_CODMOT, ';
    LSQL := LSQL + '  GER_NUMBOX, ';
    LSQL := LSQL + '  GER_CODAJ1, ';
    LSQL := LSQL + '  GER_CODAJ2, ';
    LSQL := LSQL + '  GER_CODAJ3, ';
    LSQL := LSQL + '  GER_CODAJ4, ';
    LSQL := LSQL + '  GER_OBSFEC, ';
    LSQL := LSQL + '  GER_CODTRA, ';
    LSQL := LSQL + '  GER_CODREG, ';
    LSQL := LSQL + '  GER_FRETE_, ';
    LSQL := LSQL + '  GER_ADIFRE, ';
    LSQL := LSQL + '  GER_PERFRE  ';
    LSQL := LSQL + 'FROM ';
    LSQL := LSQL + '  ROMGERX ';
    LSQL := LSQL + 'WHERE ';
    LSQL := LSQL + '  GER_NUMROM = :NUMROM AND ';
    LSQL := LSQL + '  GER_EMPROM = :EMPROM ';

    LQry.Close;
    LQry.SQL.Clear;
    LQry.SQL.Add(LSQL);
    LQry.ParamByName('NUMROM').AsString := ANumRom;
    LQry.ParamByName('EMPROM').AsString := VS_strCodEmp;
    LQry.Open;

    ATransMot.strCodTra := LQry.FieldByName('GER_CODTRA').AsString;
    ATransMot.strCodMot := LQry.FieldByName('GER_CODMOT').AsString;
    ATransMot.strNumBox := LQry.FieldByName('GER_NUMBOX').AsString;
    ATransMot.strCodAj1 := LQry.FieldByName('GER_CODAJ1').AsString;
    ATransMot.strCodAj2 := LQry.FieldByName('GER_CODAJ2').AsString;
    ATransMot.strCodAj3 := LQry.FieldByName('GER_CODAJ3').AsString;
    ATransMot.strCodAj4 := LQry.FieldByName('GER_CODAJ4').AsString;
    ATransMot.strObsFec := LQry.FieldByName('GER_OBSFEC').AsString;
    ATransMot.strPlaVei := LQry.FieldByName('GER_PLAVEI').AsString;
    ATransMot.strCodReg := LQry.FieldByName('GER_CODREG').AsString;
    fltVlrFre := LQry.FieldByName('GER_FRETE_').AsFloat;
    fltVlrAdi := LQry.FieldByName('GER_ADIFRE').AsFloat;
    fltPerFre := LQry.FieldByName('GER_PERFRE').AsFloat;

    if (fEmptyStr(ATransMot.strPlaVei) or fEmptyStr(ATransMot.strCodTra) or fEmptyStr(ATransMot.strCodMot)) and
       ((not fEmptyStr(strFiltroNumLot)) And (Not fEmptyStr(strFiltroEmpLot))) then
    begin
      LQry.Close;
      LQry.SQL.Clear;
      LQry.SQL.Add(' SELECT RLG_CODTRA,         ');
      LQry.SQL.Add('        RLG_PLAVEI,         ');
      LQry.SQL.Add('        RLG_CODMOT          ');
      LQry.SQL.Add(' FROM ROMLGE                ');
      LQry.SQL.Add(' WHERE RLG_NUMLOT = :NUMLOT ');
      LQry.SQL.Add('   AND RLG_CODEMP = :CODEMP ');

      LQry.ParamByName('NUMLOT').AsString := strFiltroNumLot;
      LQry.ParamByName('CODEMP').AsString := strFiltroEmpLot;

      LQry.Open;

      If fEmptyStr(ATransMot.strPlaVei) Then
        ATransMot.strPlaVei := LQry.FieldByName('RLG_PLAVEI').AsString;

      If fEmptyStr(ATransMot.strCodTra) Then
        ATransMot.strCodTra := LQry.FieldByName('RLG_CODTRA').AsString;

      If fEmptyStr(ATransMot.strCodMot) Then
        ATransMot.strCodMot := LQry.FieldByName('RLG_CODMOT').AsString;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

procedure TfrmFatRomaneio.pRetValorByCampo(ANumDoc, AEspDoc, ACodEmp, AEntSai: String; var ARecRomGer: TDadosRomGer);
var
  LTmp : TUniClientDataSet;
begin
  ARecRomGer.fltBasSim := 0;
