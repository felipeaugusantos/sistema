function TfrmFatRomaneio.fSQLQtdDevolvida: String;
begin
  //DEVOLUÇÃO DIRETA
  Result := Result +
      ' (SELECT IFNULL(SUM(IFNULL(DETDEV.DET_QTDITE, 0)), 0) '+
      '    FROM MOVDET DETDEV                                '+
      '         INNER JOIN MOVTRI TRIDEV ON                  '+
      '           DETDEV.AUTOINCREM = TRIDEV.DET_SEQGER      '+
      '   WHERE TRIDEV.DET_INCDEV = MOVDET.AUTOINCREM        '+
      '     AND DETDEV.DET_DOCDEV = MOVDET.DET_NUMDOC        '+
      '     AND DETDEV.DET_ESPDEV = MOVDET.DET_ESPDOC)       ';

  Result := Result + ' + ';

  //DEVOLUÇÃO CONFIRMAÇÃO
  Result := Result +
      ' (SELECT IFNULL(SUM(IFNULL(DETDEV.DET_QTDITE, 0)), 0)                      '+
      '    FROM MOVDET DETDEV                                                     '+
      '         INNER JOIN MOVTRI TRIDEV ON TRIDEV.DET_SEQGER = DETDEV.AUTOINCREM '+ //DOC.DEV.
      '         INNER JOIN NOTDET DETCNF ON DETCNF.AUTOINCREM = TRIDEV.DET_INCDEV '+ //DOC.CNF. > DOC.DEV.
      '                                 AND DETCNF.DET_NUMDOC = DETDEV.DET_DOCDEV '+
      '                                 AND DETCNF.DET_ESPDOC = DETDEV.DET_ESPDEV '+
      '         INNER JOIN NOTTRI TRICNF ON DETCNF.AUTOINCREM = TRICNF.DET_SEQGER '+ //DOC.CNF.
      '         INNER JOIN MOVDET DETVEN ON DETVEN.AUTOINCREM = TRICNF.DET_SEQDET '+ //DOC.VEN. > DOC.CNF.
      ' WHERE DETVEN.AUTOINCREM = MOVDET.AUTOINCREM                               '+
      '   AND TRIDEV.DET_INCDEV IS NOT NULL)                                      ';

  Result := '('+Result+')';
end;

function TfrmFatRomaneio.fPossuiDevolucao(blnAtualizacaoDosItens: Boolean; strAutInc: String): Boolean;
  Var
    qryDados: TUniQuery;
begin
  qryDados := fCriaQuery;

  Try
    qryDados.Close;
    qryDados.SQL.Clear;
    qryDados.SQL.Text := 'SELECT SUM' + fSQLQtdDevolvida + ' AS QTDDEV FROM MOVDET WHERE ' +
      IIF(blnAtualizacaoDosItens, 'AUTOINCREM', 'DET_SEQGER') + ' = :AUTINC';

    qryDados.ParamByName('AUTINC').AsString := strAutInc;
    qryDados.Open;

    Result := (Not qryDados.IsEmpty) And (qryDados.FieldByName('QTDDEV').AsFloat > 0);
  Finally
    FreeAndNil(qryDados);
  End;
end;

procedure TfrmFatRomaneio.pSetaStatusRota(strCodRot: String);
Var
  cdsTmp : TUniClientDataSet;
begin

  If (Not blnDocumentosRotaEmSelecao) And Assigned(cdsMaster) Then
  Begin
    cdsTmp := TUniClientDataSet.Create(Nil);
    Try
      pCloneDataSet(cdsTmp, cdsTmpDoc);
      cdsTmp.Filter   := '(GER_MARDES = '+QuotedStr('M')+') AND (GER_CODROT = '+QuotedStr(strCodRot)+')';
      cdsTmp.Filtered := True;

      If ((cdsTmp.IsEmpty) And (cdsMaster.FieldByName('GER_MARDES').AsString='M')) Or
         ((Not cdsTmp.IsEmpty) And (cdsMaster.FieldByName('GER_MARDES').AsString='D')) Then
      Begin
        cdsMaster.Edit;
        cdsMaster.FieldByName('GER_MARDES').AsString := IIF(cdsTmp.IsEmpty, 'D', 'M');
        cdsMaster.Post;

        With TcxGridDBDataController(dbgDocumentosDBViewMaster.DataController).GridView.Controller.FocusedRecord As TcxGridMasterDataRow Do
        Begin
          If ActiveDetailGridViewExists Then
            ActiveDetailGridView.Focused := True;
        End;
      End;
    Finally
      FreeAndNil(cdsTmp);
    End;
  end;
end;

