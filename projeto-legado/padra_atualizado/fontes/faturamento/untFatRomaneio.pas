  ARecRomGer.fltVpaR12 := 0;
  ARecRomGer.fltVlrOri := 0;

  LTmp := TUniClientDataSet.Create(Self);

  try
    pCloneDataSet(LTmp, cdsTmpDoc);

    LTmp.Filtered := False;
    LTmp.Filter   :=               '(GER_NUMDOC = ' + QuotedStr(ANumDoc+'-'+AEspDoc) + ') AND ';
    LTmp.Filter   := LTmp.Filter + '(GER_CODEMP = ' + QuotedStr(ACodEmp) + ') AND ';
    LTmp.Filter   := LTmp.Filter + '(GER_ENTSAI = ' + QuotedStr(AEntSai) + ')';
    LTmp.Filtered := True;

    if (not LTmp.IsEmpty) then
    begin
      LTmp.First;

      while not LTmp.Eof do
      begin
        ARecRomGer.fltBasSim := ARecRomGer.fltBasSim + LTmp.FieldByName('GER_BASSIM').AsFloat;
        ARecRomGer.fltBasIpi := ARecRomGer.fltBasIpi + LTmp.FieldByName('GER_BASIPI').AsFloat;
        ARecRomGer.fltTotIpi := ARecRomGer.fltTotIpi + LTmp.FieldByName('GER_TOTIPI').AsFloat;
        ARecRomGer.fltBasIcm := ARecRomGer.fltBasIcm + LTmp.FieldByName('GER_BASICM').AsFloat;
        ARecRomGer.fltTotIcm := ARecRomGer.fltTotIcm + LTmp.FieldByName('GER_TOTICM').AsFloat;
        ARecRomGer.fltTotRet := ARecRomGer.fltTotRet + LTmp.FieldByName('GER_TOTRET').AsFloat;
        ARecRomGer.fltBasRet := ARecRomGer.fltBasRet + LTmp.FieldByName('GER_BASRET').AsFloat;
        ARecRomGer.fltDesEsp := ARecRomGer.fltDesEsp + LTmp.FieldByName('GER_DESESP').AsFloat;
        ARecRomGer.fltVlrCon := ARecRomGer.fltVlrCon + LTmp.FieldByName('GER_VALSEL').AsFloat;
        ARecRomGer.fltTotPro := ARecRomGer.fltTotPro + LTmp.FieldByName('GER_VALSEL').AsFloat;
        ARecRomGer.fltTotCus := ARecRomGer.fltTotCus + LTmp.FieldByName('GER_TOTCUS').AsFloat;
        ARecRomGer.fltTotMed := ARecRomGer.fltTotMed + LTmp.FieldByName('GER_TOTMED').AsFloat;
        ARecRomGer.fltTotFre := ARecRomGer.fltTotFre + LTmp.FieldByName('GER_TOTFRE').AsFloat;
        ARecRomGer.fltVolume := ARecRomGer.fltVolume + LTmp.FieldByName('GER_VOLUME').AsFloat;
        ARecRomGer.fltVpaR01 := ARecRomGer.fltVpaR01 + LTmp.FieldByName('GER_VPAR01').AsFloat;
        ARecRomGer.fltVpaR02 := ARecRomGer.fltVpaR02 + LTmp.FieldByName('GER_VPAR02').AsFloat;
        ARecRomGer.fltVpaR03 := ARecRomGer.fltVpaR03 + LTmp.FieldByName('GER_VPAR03').AsFloat;
        ARecRomGer.fltVpaR04 := ARecRomGer.fltVpaR04 + LTmp.FieldByName('GER_VPAR04').AsFloat;
        ARecRomGer.fltVpaR05 := ARecRomGer.fltVpaR05 + LTmp.FieldByName('GER_VPAR05').AsFloat;
        ARecRomGer.fltVpaR06 := ARecRomGer.fltVpaR06 + LTmp.FieldByName('GER_VPAR06').AsFloat;
        ARecRomGer.fltVpaR07 := ARecRomGer.fltVpaR07 + LTmp.FieldByName('GER_VPAR07').AsFloat;
        ARecRomGer.fltVpaR08 := ARecRomGer.fltVpaR08 + LTmp.FieldByName('GER_VPAR08').AsFloat;
        ARecRomGer.fltVpaR09 := ARecRomGer.fltVpaR09 + LTmp.FieldByName('GER_VPAR09').AsFloat;
        ARecRomGer.fltVpaR10 := ARecRomGer.fltVpaR10 + LTmp.FieldByName('GER_VPAR10').AsFloat;
        ARecRomGer.fltVpaR11 := ARecRomGer.fltVpaR11 + LTmp.FieldByName('GER_VPAR11').AsFloat;
        ARecRomGer.fltVpaR12 := ARecRomGer.fltVpaR12 + LTmp.FieldByName('GER_VPAR12').AsFloat;
        ARecRomGer.fltVlrOri := ARecRomGer.fltVlrOri + LTmp.FieldByName('GER_TOTPRO').AsFloat;

        LTmp.Next;
      end;
    end;

    LTmp.Close;
  finally
