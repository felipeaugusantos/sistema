    strSQL := strSQL + ', 0.00 AS GER_DISTAN ';
    strSQL := strSQL + ', 0.00 AS GER_TMPENT ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSQL := strSQL + ', 0 AS PRIORIDADE ';
    strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_LIBAPP ';
    strSQL := strSQL + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSQL := strSQL + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSQL := strSQL + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQL := strSQL + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQL := strSQL + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQL := strSQL + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQL := strSQL + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQL := strSQL + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQL := strSQL + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQL := strSQL + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQL := strSQL +  ',CAST("" AS CHAR(10))  AS CLI_CODRED ';
  strSQL := strSQL + ', CAST("" AS CHAR(10))  AS CLI_CODCAC ';
  strSQL := strSQL + ', CAST("" AS CHAR(10))  AS CLI_FANSOB ';
  strSQL := strSQL + ', CAST("" AS CHAR(10))  AS CLI_ORIENT ';
  strSQL := strSQL + ', CAST("" AS CHAR(10))  AS CAC_CORILP ';
  strSQL := strSQL + ', CAST("" AS CHAR(10))  AS CNDDESCRICAO ';

  strSQL := strSQL + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQL := strSQL + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQL := strSQL + ', CAST("" AS CHAR(4)) AS DET_CLAFIS ';
  strSQL := strSQL + ', CAST("" AS CHAR(18)) AS BARDOC ';

  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQL := strSQL + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQL := strSQL + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS  ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQL := strSQL + 'FROM ';
  strSQL := strSQL + '  ROMDETX LEFT JOIN CADUNI ON UNI_CODUNI = DET_UNIDAD ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + '  DET_NUMROM = :NUMROM AND ';
  strSQL := strSQL + '  DET_EMPROM = :EMPROM     ';

  With qryDados Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMROM').AsString := edtNumRom.Text;
    ParamByName('EMPROM').AsString := VS_strCodEmp;
    Open;

    pCopiaParaTemporaria(qryDados, cdsRomDet, tpcRomDet, False);
    pAtualizaSeqGerCdsRomDet(edtNumRom.Text, Vs_strCodEmp);

    Close;
  End;

  FreeAndNil(qryDados);

  If fUsaRomaneioDocsExpedidos Then
    pDeletaDocsZeradosNaoExpedido;

  if fEntraDevolucoes In [tdListaResidualDaDevolucaoNF, tdListaTodasDevolucoesAbatendoQtdDevolvida] then
    pAtualizaDadosParaRomaneioBaseadoEmDevolucoes(cdsTmpDoc, False);

  pLimpaNomeFantasia;

  cdsTmpDoc.First;
end;

procedure TfrmFatRomaneio.pAtualizaValRomFGO(ATabela: String);
var
  LSQL: String;
  LQry: TUniQuery;
begin
  LQry := fCriaQuery;

  try
    {*******************************************}
    {* DA UM UPDATE -> INDIVIDUAL <- NO FATGOR *}
    {* POIS É NECESSÁRIO GRAVAR O TOTAL DO DO- *}
    {* CUMENTO QUE ESTÁ EM ROMANEIOS           *}
    {****************************************MV*}
    LSQL := '';
    LSQL := LSQL + 'UPDATE ';
    LSQL := LSQL + '  ' + ATabela + ' ';
    LSQL := LSQL + 'SET ';
    LSQL := LSQL + '  FGO_VALROM = IFNULL(FGO_VALROM, 0) + :VALROM ';
    LSQL := LSQL + 'WHERE ';
    LSQL := LSQL + ' (FGO_NUMDOC = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_DOCORI').AsString) + ' AND ';
    LSQL := LSQL + '  FGO_ESPDOC = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_ESPDOC').AsString) + ' AND ';
    LSQL := LSQL + '  FGO_CODCLI = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_CODCLI').AsString) + ' AND ';
    LSQL := LSQL + '  FGO_CODEMP = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_CODEMP').AsString) + ') ';

    LQry.Close;
    LQry.SQL.Clear;
    LQry.SQL.Add(LSQL);
    LQry.ParamByName('VALROM').AsFloat := cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat;
    LQry.ExecSQL;
  finally
    FreeAndNil(LQry);
  end;
end;

procedure TfrmFatRomaneio.pAddUpdateValRomGER(const strTabela : String);
  Var
    strSQL: String;
begin
  strSQL := '';
  strSQL := strSQL + 'UPDATE ';
  strSQL := strSQL + '  ' + strTabela + ' ';
  strSQL := strSQL + 'SET ';
  strSQL := strSQL + '  GER_VALROM = IFNULL(GER_VALROM, 0) + ' + AnsiReplaceStr(FloatToStrF(cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat, ffFixed, 12, 2), ',', '.') + ' ';
  strSQL := strSQL + 'WHERE ';
  strSQL := strSQL + ' (GER_NUMDOC = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_DOCORI').AsString) + ' AND ';
  strSQL := strSQL + '  GER_ESPDOC = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_ESPDOC').AsString) + ' AND ';
  strSQL := strSQL + '  GER_CODEMP = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_CODEMP').AsString) + ' AND ';
  strSQL := strSQL + '  GER_CODCLI = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_CODCLI').AsString) + ' AND ';
  strSQL := strSQL + '  GER_TIP_FC = ' + QuotedStr(cdsTmpDoc.FieldByName('GER_TIP_FC').AsString) + ');';
  FSQLCommandBatch.pAddSQLCommand(strSQL);
end;

