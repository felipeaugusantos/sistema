procedure TfrmFatRomaneio.dbgDocumentosDBViewCustomDrawCell(
  Sender: TcxCustomGridTableView; ACanvas: TcxCanvas;
  AViewInfo: TcxGridTableDataCellViewInfo; var ADone: Boolean);

var
  blnDocumentoPossuiMaisVolumesNaoBipados : Boolean;


  function VerificarSeMesmoCodigoVeiculo: boolean;
  var
    strCodigoLinha: string;
    strCodigoPanelSelecionado: string;
  begin
    strCodigoLinha := VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_VEICUL.Index]);
    strCodigoPanelSelecionado := Copy(TPanel(objPanelSelecionado).Name, Pos('_', TPanel(objPanelSelecionado).Name) + 1, 1);
    result := strCodigoLinha = strCodigoPanelSelecionado;
  end;

  function VerificarSeMarcadoSemCodigoVeiculo: boolean;
  const
    strMARCADO = 'M';
  var
    blnLinhaMarcada: boolean;
    blnApenasUmPainelVeiculo: boolean;
  begin
    blnLinhaMarcada := VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_MARDES.Index]) = strMARCADO;
    if not blnLinhaMarcada then
      exit(False);

    blnApenasUmPainelVeiculo := (intContVeiculo = 1);
    if not blnApenasUmPainelVeiculo then
      exit(False);

    result := True;
  end;

begin
  If (Not Assigned(cdsTmpDoc)) Or (Not cdsTmpDoc.Active) Then
    Exit;

  inherited;

  With cdsTmpDoc Do
  Begin
    {*****************************************}
    {* CASO A TABELA ESTEJA FECHADA, SAI     *}
    {**************************************MV*}
    If Not Active Then
      Exit;

    If (FindField('GER_MARDES') = Nil) Then
    Begin
      Exit;
    End;

    blnDocumentoPossuiMaisVolumesNaoBipados := (fEhRomaneioSimplificado) And
                                               ((Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_VOLUME.Index]) >
                                                (Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_VOLBIP.Index]));

    If (blnDocumentoPossuiMaisVolumesNaoBipados) Then
    Begin
      If ACanvas.Brush.Color = clHighlight Then
        ACanvas.Font.Color := clLime
      Else
      begin
        ACanvas.Brush.Color := $00379BFF; {Laranja}
        ACanvas.Font.Color := clBlue;
      end;
    End
    Else
    If VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_MARDES.Index]) = 'M' Then
    Begin
      If ACanvas.Brush.Color = clHighlight Then
        ACanvas.Font.Color := clLime
      Else
      begin
        ACanvas.Brush.Color := clSkyBlue;
        ACanvas.Font.Color := clBlue;
      end;
    End
    Else If VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_MARDES.Index]) = 'P' Then
    Begin
      If ACanvas.Brush.Color = clHighlight Then
        ACanvas.Font.Color := clLime
      Else
        ACanvas.Font.Color := clGreen;
    End
    Else If VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_PRVIMP.Index]) = 'S' Then
    Begin
      If ACanvas.Brush.Color = clHighlight Then
        ACanvas.Font.Color := clYellow
      Else
        ACanvas.Font.Color := clRed;
    End;
  End;

  If (AViewInfo.Item.Index In [dbgDocumentosENTURG.Index]) Then
  Begin
    If (ACanvas.Brush.Color <> clHighlight) Then
    Begin
      If VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosENTURG.Index]) = 'SIM' Then
      Begin
        ACanvas.Font.Color := clRed;
        ACanvas.Font.Style := [fsBold];
      End
      Else
        ACanvas.Font.Color := clBlack;
    End
    Else
      ACanvas.Font.Color := clYellow;
  End;

  If (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_ORIDOC.Index]) = 'D') Then
  Begin
    If (ACanvas.Brush.Color <> clHighlight) Then
    Begin
      ACanvas.Brush.Color := clYellow;
    End;
  End;

  If (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_ORIDEV.Index]) = 'S') Then
  Begin
    If (ACanvas.Brush.Color <> clHighlight) Then
    Begin
      ACanvas.Brush.Color := clYellow;
    End;
  End;

  If (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosCLI_CODCAC.Index]) <> '') and
     (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosCORILP.Index]) <> '') and
     (AViewInfo.Item.Index In [dbgDocumentosCLI_CODCAC.Index]) Then
    ACanvas.Brush.Color := Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosCORILP.Index];


  If (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosCLI_CODRED.Index]) <> '') and
     (AViewInfo.Item.Index In [dbgDocumentosCLI_CODRED.Index]) Then
    ACanvas.Brush.Color := clMagenta;

  {***********************}
  {* PEDIDOS DE RETIRADA *}
  {********************PZ*}
  If ((SameText(VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_NOMTBL.Index]), 'FATGOR')) And
      (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_ESPDOC.Index]) = 'PR'))
  Or (VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, dbgDocumentosGER_ORIPDR.Index]) = 'PR') Then
  Begin
    If (ACanvas.Brush.Color <> clHighlight) Then
    Begin
      ACanvas.Brush.Color := pnlPedRet.Color;
    End;
  End;

  If (Assigned(objPanelSelecionado)) and
     (VerificarSeMesmoCodigoVeiculo or VerificarSeMarcadoSemCodigoVeiculo) and
     (ACanvas.Brush.Color <> COR_SEL_VEICULO) and
     (ACanvas.Brush.Color <> clHighlight) then
  Begin
    ACanvas.Brush.Color := COR_SEL_VEICULO;
  End;

end;

procedure TfrmFatRomaneio.dbgDocumentosDBViewDblClick(Sender: TObject);
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  inherited;

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;
  Try
    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    If (Not fCfgSis('CLIDOC', varBoolean)) Then
      pSelecionaDocumento
    Else
      pSelecionaTodosDocCliente;

    pGravaSelecionados;
  Finally
    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;
end;

