procedure TfrmFatRomaneio.btnReimprimeDocumentoClick(Sender: TObject);
  Var
    qryUpDate : TUniQuery;
    reiReimpressao: TReimpressao;
    impPreRomaneio: TFatVendaImp;
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;

  procedure pMarcaSeparacaoImpressaRomaneio;
  begin
    If (Pos(strOpcRom, '1_5_') > 0) And (blnUsaPreRom) And (Not fCfgSis('SEEXRO', varBoolean)) Then
    Begin
      fExecutaSQL(' UPDATE ROMDETX R ' +
                  '        INNER JOIN ITEGER I ON (R.DET_CODITE = I.ITE_CODITE) ' +
                  '                           AND (R.DET_CODEMP = I.ITE_CODEMP) ' +
                  '        INNER JOIN FATDOR F ON (R.DET_CODEMP = F.FDO_CODEMP) ' +
                  '                           AND (R.DET_NUMDOC = F.FDO_NUMDOC) ' +
                  '                           AND (R.DET_ESPDOC = F.FDO_ESPDOC) ' +
                  '                           AND (R.DET_CODCLI = F.FDO_CODCLI) ' +
                  '                           AND (I.ITE_CODITE = F.FDO_CODITE) ' +
                  '                           AND (I.ITE_CODEMP = F.FDO_CODEMP) ' +
                  '        INNER JOIN EXTDOR E ON (F.AUTOINCREM = E.FDO_SEQFDO) ' +
                  ' SET    R.DET_SEPIMP = "S", ' +
                  '        E.FDO_SEPEXP = "S" ' +
                  ' WHERE  R.DET_NUMROM = "' + strNumRomPrevia + '"' +
                  '  AND  R.DET_EMPROM = "' + VS_strCodEmp + '"');
    End
    Else
    Begin
      fExecutaSQL(' UPDATE ROMDETX  '+
                  ' SET    DET_SEPIMP = "S" ' +
                  ' WHERE  DET_NUMROM = "' + strNumRomPrevia + '"' +
                  '   AND  DET_EMPROM = "' + VS_strCodEmp + '"');
    End;
  end;

  Procedure pPreenchaMatItens(Var arrMatItens: TMatrizFechamento);
    Var
      i: Integer;
      qryAux: TUniQuery;
  Begin
    qryAux := fCriaQuery(Nil);
    SetLength(arrMatItens,0);

    With qryAux, SQL Do
    Begin
      Add('SELECT DISTINCT D.DET_CODITE, ');
      Add('   IF(GER_ESPDOC = "PD", (SELECT FGO_ENTFUT ');
      Add('                            FROM FATGOR ');
      Add('                           WHERE FGO_NUMDOC = R.GER_NUMDOC ');
      Add('                             AND FGO_ESPDOC = R.GER_ESPDOC ');
      Add('                             AND FGO_CODEMP = R.GER_CODEMP ');
      Add('                             AND FGO_CODCLI = R.GER_CODCLI) ,  ');
      Add('                          (SELECT GER_ENTFUT ');
      Add('                             FROM MOVGER ');
      Add('                            WHERE MOVGER.GER_NUMDOC = R.GER_NUMDOC ');
      Add('                              AND MOVGER.GER_ESPDOC = R.GER_ESPDOC ');
      Add('                              AND MOVGER.GER_CODEMP = R.GER_CODEMP ');
      Add('                              AND MOVGER.GER_CODCLI = R.GER_CODCLI ');
      Add('                            UNION ALL ');
      Add('                           SELECT GER_ENTFUT ');
      Add('                             FROM NOTGER ');
      Add('                            WHERE NOTGER.GER_NUMDOC = R.GER_NUMDOC ');
      Add('                        AND NOTGER.GER_ESPDOC = R.GER_ESPDOC ');
      Add('                        AND NOTGER.GER_CODEMP = R.GER_CODEMP ');
      Add('                        AND NOTGER.GER_CODCLI = R.GER_CODCLI)) AS ENTFUT ');
      Add('FROM ');
      Add('  ROMGERX R ');
      Add('  LEFT JOIN ROMDETX D ON D.DET_NUMROM = R.GER_NUMROM AND D.DET_EMPROM = GER_EMPROM ');
      Add('WHERE                  ');
      Add('  DET_NUMROM = :NUMROM ');
      Add('ORDER BY DET_CODITE    ');

      ParamByName('NUMROM').AsString := strNumRomPrevia;

      Open;
      First;
      While Not EOF Do
      Begin
        SetLength(arrMatItens, Length(arrMatItens) + 1);
        i := Length(arrMatItens) - 1;

        arrMatItens[i].strCodIte := FieldByName('DET_CODITE').AsString;
        arrMatItens[i].strEntRet := 'E';
        arrMatItens[i].strEntFut := FieldByName('ENTFUT').AsString;

        Next;
      End;
    End;

    FreeAndNil(qryAux);
  End;

begin
  inherited;
  If (Not btnReimprimeDocumento.Visible) Then
    Exit;

  If cdsTmpDoc.IsEmpty Then
  Begin
    fMensagem('ATENÇÃO!', 'Não existem documentos para serem impressos!', ['&Ok']);
    Exit;
  End;

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  Try
    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    If blnUsaPreRom Then
    Begin
      If fMensagem('ATENÇÃO!', 'Deseja imprimir a Separação?', ['&Sim', '&Não'], 1) = 1 Then
      Begin
        impPreRomaneio := TFatVendaImp.Create;

        pPreenchaMatItens(recSepara.arrMatItens);

        impPreRomaneio.blnPreRomaneio := True;

        impPreRomaneio.blnSomenteNaoImp := (fGetMenu('Impressão da Separação (Pré-Romaneio)',
                                                    ['Imprimir somente produtos novos (não impressos)',
                                                     'Imprimir todos os produtos do romaneio'], 1) = 1);

        If fUsaRotinaWMS Then
        Begin
          Try
            TfrmGravando.fExecutarModalA(pLockDefinicaoLotes, 'Definição de lotes ' +
              'já sendo realizada, aguarde ... ', '');

            If Not fDefineLotesPedidos Then
              Exit;
          Finally
            objLock.fLock_Unlock(STR_DEFINICAO_LOTES, False);
          End;
        End;

        recSepara.strNumRom := strNumRomPrevia;

        impPreRomaneio.Add(recSepara);

        If impPreRomaneio.fImprimeSeparacao(recSepara, '', '', False) Then
        Begin
          pMarcaSeparacaoImpressaRomaneio;

          If (Pos(fCfgSis('TIPEXP', varString), '5_') > 0) Then
          Begin
            fDisparaWhatsappAutomatico(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                       'E5',
                                       cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                       '',
                                       'SE',
                                       '',
                                       cdsTmpDoc.FieldByName('GER_CODCLI').AsString,
                                       '',
                                       True,
                                       '',
                                       nil,
                                       '',
                                       '',
                                       '',
                                       Self.UnitName);

            fDisparaEmailAutomatico(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                    'E5',
                                    cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                    '',
                                    'SE',
                                    '',
                                    cdsTmpDoc.FieldByName('GER_CODCLI').AsString
                                   );

            fDisparaSMSAutomatico(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                  'E5',
                                  cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                  '',
                                  'SE',
                                  '',
                                  cdsTmpDoc.FieldByName('GER_CODCLI').AsString
                                 );
          End;
        End;
      End
      Else
        Exit;
    End
    Else
    Begin

      TEditorFastImpressao.strEmpresaLayout := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
      try
        reiReimpressao := TReimpressao.Create(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                              cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                              0,
                                              0,
                                              cdsTmpDoc.FieldByName('GER_CODCLI').AsString,
                                              cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                                              '',
                                              True,
                                              'C',
                                              True,
                                              False,
                                              False,
                                              '',
                                              '',
                                              False,
                                              0,
                                              False,
                                              cdsTmpDoc.FieldByName('GER_ORIDOC').AsString,
                                              False,
                                              False,
                                              '',
                                              '',
                                              True);
        reiReimpressao.pReimprimeDocumento;
      finally
        TEditorFastImpressao.strEmpresaLayout := '';
        FreeAndNil(reiReimpressao);
      end;

    End;

    if (cdsTmpDoc.FieldByName('GER_NOMTBL').AsString <> 'OUTDIGX') then
    begin
      With cdsTmpDoc Do
      Begin
        Edit;
        FieldbyName('GER_ROMIMP').AsString := 'SIM';
        Post;
      End;

      If Not fEmptyStr(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString) Then
      Begin
        qryUpDate := fCriaQuery(Self);

        Try
          if cdsTmpDoc.FieldByName('GER_NOMTBL').AsString = 'FATGOR' then
          begin
            With qryUpDate do
            begin
              SQL.Clear;
              SQL.Add('UPDATE FATGOR SET FGO_ROMIMP = "SIM"');
              SQL.Add('WHERE FGO_NUMDOC = :NUMDOC        ');
              SQL.Add('  AND FGO_ESPDOC = :ESPDOC        ');
              SQL.Add('  AND FGO_CODCLI = :CODCLI        ');
              SQL.Add('  AND FGO_CODEMP = :CODEMP        ');
              ParamByName('NUMDOC').AsString := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
              ParamByName('ESPDOC').AsString := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
              ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
              ParamByName('CODEMP').AsString := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
              ExecSQL;
            end;
          end
          else
          begin
            With qryUpDate do
            begin
              SQL.Clear;
              SQL.Add('UPDATE '+cdsTmpDoc.FieldByName('GER_NOMTBL').AsString+' SET GER_ROMIMP = "SIM"');
              SQL.Add('WHERE GER_NUMDOC = :NUMDOC        ');
              SQL.Add('  AND GER_ESPDOC = :ESPDOC        ');
              SQL.Add('  AND GER_CODCLI = :CODCLI        ');
              SQL.Add('  AND GER_CODEMP = :CODEMP        ');
              ParamByName('NUMDOC').AsString := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
              ParamByName('ESPDOC').AsString := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
              ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
              ParamByName('CODEMP').AsString := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
              ExecSQL;
            end;
          end;
        finally
          FreeAndNil(qryUpDate);
        end;
      End;
    end;

    if fCfgSis('IMPTIN', varBoolean) then
    begin
      pImprimeOrdemProducaoTinta(cdsTmpDoc.FieldByName('GER_DOCORI').AsString, cdsTmpDoc.FieldByName('GER_ESPDOC').AsString, cdsTmpDoc.FieldByName('GER_CODEMP').AsString, cdsTmpDoc.FieldByName('GER_CODCLI').AsString);
    end;

  Finally
    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;

end;

procedure TfrmFatRomaneio.pSelecionaDocumentoParcial;
  Var
    blnConfirma: Boolean;
    strLetMar: String;
    fltTotDoc: Double;
    blnDeletaRegistro: Boolean;
begin
  If (Not cdsTmpDoc.Active) Or
     (cdsTmpDoc.IsEmpty)    Then
  Begin
    Exit;
  End;

  If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'OX') Then
    Exit;

  If (Not fPodeMarcarDocumento(blnDeletaRegistro)) Then
  Begin
    If (blnDeletaRegistro) Then
      cdsTmpDoc.Delete;

    Exit;
  End;

  fltTotDoc := 0;

  cdsRomDet.Filtered := False;
  cdsRomDet.Filter   := 'DET_SEQGER = ' + QuotedStr(cdsTmpDoc.FieldByName('INCREMENTO').AsString);
  cdsRomDet.Filtered := True;
  
  If (cdsRomDet.IsEmpty) Then
  Begin
    pAdicionaDadosRomDet;
  End;

  (cdsRomDet.FieldByName('DET_QTDITE') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', varInteger));
  (cdsRomDet.FieldByName('DET_QTDBAI') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', varInteger));

  If Not Assigned(dtsRomDet) Then
    dtsRomDet := fCriaDataSource(cdsRomDet);

  Try
    pCriarFormularios(TfrmFatItensRomaneio, frmFatItensRomaneio);
    frmFatItensRomaneio.dbgItensDBView.DataController.DataSource := dtsRomDet;
    frmFatItensRomaneio.blnMostraEmpOri := rdgEmpresa.Enabled;
    blnConfirma := (frmFatItensRomaneio.ShowModal = mrOk);
    strLetMar   := frmFatItensRomaneio.strLetMar;
    fltTotDoc   := frmFatItensRomaneio.fltTotDoc;
  Except
    On E: Exception Do
    Begin
      blnConfirma := False;
      pMensagensErro(E.Message, '[frmFatRomaneio.pSelecionaDocumentoParcial]');
    End;
  End;
  pFreeAndNil(frmFatItensRomaneio);

  cdsRomDet.Filter   := '';
  cdsRomDet.Filtered := False;

  If (blnConfirma) Then
  Begin
    Try
      cdsTmpDoc.Edit;

      cdsTmpDoc.FieldByName('GER_MARDES').AsString := strLetMar;
      pOnMarcaDesmarcaDocumento;

      fltTotSel := fltTotSel - cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat;
      fltTotSelPro := fltTotSelPro - cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat;

      If (strLetMar = 'D') Then
      Begin
        If (fltTotSel <= 0) Then
          fltTotSel := 0.0;

        cdsTmpDoc.FieldByName('GER_PALET_').AsString := '';
        cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat := 0.0;
        cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat := 0.0;

        pDeletaDadosRomDet;
        pDeletaDadosRestauracao;
      End
      Else
      Begin
        cdsTmpDoc.FieldByName('GER_PALET_').AsString := fPedeLocalMercadoriaPalet;
        cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat := fltTotDoc;
        cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat := fltTotDoc;

        intOrdImp := intOrdImp + 1;
        cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger := intOrdImp;

        fltTotSel := fltTotSel + fltTotDoc;
        fltTotSelPro := fltTotSelPro + fltTotDoc;

        pGravaDadosRestauracao;
      End;

      if blnUtilizaMultiVeiculosRomaneio then
        cdsTmpDoc.FieldByName('GER_VEICUL').AsString := fValorMovimentaVeiculo(fFormataFloat(cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat, 2), cdsTmpDoc.FieldByName('GER_VEICUL').AsString, True);

      cdsTmpDoc.Post;

      if blnUtilizaMultiVeiculosRomaneio then
        pAtualizaPainelVeiculos;

    Finally

    End;
  End
  Else
  Begin
    pDeletaDadosRomDet;
    {***************************************************************************}
    {* SE O DOCUMENTO ESTIVER MARCADO E ENTROU NA TELA DOS ITENS PELA BARRA DE *}
    {* ESPAÇO E CANCELOU ESSA TELA, DESMARCO O DOCUMENTO                       *}
    {************************************************************************RN*}
    If (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') > 0) Then
      pSelecionaDocumento;
  End;

  If (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'D') Then
  Begin
    pDestravaDocumento(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                       cdsTmpDoc.FieldByName('GER_NROROM').AsString,
                       cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                       cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                       cdsTmpDoc.FieldByName('GER_ENTSAI').AsString);
  End;

  fltTotSel := fFormataFloat(fltTotSel, 2);
  edtTotSel.Text := FloatToStrF(fltTotSel, ffFixed, 12, 2);

  fltTotSelPro := fFormataFloat(fltTotSelPro, 2);
  edtTotProdSel.Text := FloatToStrF(fltTotSelPro, ffFixed, 12, 2);

  if blnUtilizaMultiVeiculosRomaneio then
    edtTotPesSel.Text := fPesoBrutoSelecionado(varString, True)
  else
    edtTotPesSel.Text := fPesoBrutoSelecionado(varString);

//  pExibirPreviaDeRomaneio(fltTotSel);
end;

procedure TfrmFatRomaneio.pSelecionaDocumentoParcialVeiculo;
begin
  cdsTmpDoc.Edit;
  if blnUtilizaMultiVeiculosRomaneio then
  begin
    cdsTmpDoc.FieldByName('GER_VEICUL').AsString := fValorMovimentaVeiculo(fFormataFloat(cdsTmpDoc.FieldByName('GER_VALDOC').AsFloat, 2), '', True);
  end;

  cdsTmpDoc.Post;
end;

procedure TfrmFatRomaneio.pVisualizarItensDocumento;
Var
  blnAdicionouItens: Boolean;
  cdsVolumesBipados: TUniClientDataSet;
begin
  If (Not cdsTmpDoc.Active) Or
     (cdsTmpDoc.IsEmpty)    Then
  Begin
    Exit;
  End;

  If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'OX') Then
    Exit;

  cdsRomDet.Filtered := False;
  cdsRomDet.Filter   := 'DET_SEQGER = ' + QuotedStr(cdsTmpDoc.FieldByName('INCREMENTO').AsString);
  cdsRomDet.Filtered := True;

  blnAdicionouItens := False;

  If (cdsRomDet.IsEmpty) Then
  Begin
    blnAdicionouItens := True;
    pAdicionaDadosRomDet;
  End;

  (cdsRomDet.FieldByName('DET_QTDITE') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', varInteger));
  (cdsRomDet.FieldByName('DET_QTDBAI') As TFloatField).DisplayFormat := fMskDigitos(fCfgSis('DECQTD', varInteger));

  If Not Assigned(dtsRomDet) Then
    dtsRomDet := fCriaDataSource(cdsRomDet);

  Try
    pCriarFormularios(TfrmFatVerItensDocRom, frmFatVerItensDocRom);
    frmFatVerItensDocRom.dbgItens.DataSource := dtsRomDet;

    If (fEhRomaneioSimplificado) Then
    Begin

      cdsVolumesBipados := FControleVolumesBipados.fRetornaVolumesBipados(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                                          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                                          cdsTmpDoc.FieldByName('GER_CODEMP').AsString);

      If (cdsVolumesBipados.RecordCount <= 0) Then
        cdsVolumesBipados := Nil;

      Try

        frmFatVerItensDocRom.blnEhRomaneioSimplificado  := True;
        frmFatVerItensDocRom.intQuantidadeDeVolumes     := cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger;
        frmFatVerItensDocRom.blnDocumentoJahSelecionado := cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M';
        frmFatVerItensDocRom.cdsVolumesBipados          := cdsVolumesBipados;

        frmFatVerItensDocRom.ShowModal;

      Finally
        If Assigned(cdsVolumesBipados) Then
          FreeAndNil(cdsVolumesBipados);
      End;

    End;

  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[frmFatRomaneio.pSelecionaDocumentoParcial]');
  End;

  pFreeAndNil(frmFatVerItensDocRom);

  cdsRomDet.Filter   := '';
  cdsRomDet.Filtered := False;

  If blnAdicionouItens Then
    pDeletaDadosRomDet;
end;

procedure TfrmFatRomaneio.tmrLogRomTimer(Sender: TObject);
  Var
    intQtdLogRomAux: Integer;
begin
  If (intQtdLogRom > 0) And (stlDocSemLogRom.Count > 0) Then
  Begin
    intQtdLogRomAux := fCampoTabela('COUNT(*)', 'LOGROM', ['1'], ['1']);
    If (intQtdLogRomAux <> intQtdLogRom) Then
    Begin
      intQtdLogRom := intQtdLogRomAux;
      stlDocSemLogRom.Clear;
    End;
  End;
end;

procedure TfrmFatRomaneio.pSetTextAguarde(strText: String; pgbStatus: TcxProgressBar);
begin
  If Assigned(pgbStatus) And (GetParentForm(pgbStatus).FindComponent('lblGravando') <> Nil) Then
  Begin
    TLabel(GetParentForm(pgbStatus).FindComponent('lblGravando')).Caption := strText;
    Application.ProcessMessages;
  End;
end;

procedure TfrmFatRomaneio.pStep(pgbStatus: TcxProgressBar);
begin
  If Assigned(pgbStatus) Then
  Begin
    pgbStatus.Position := pgbStatus.Position + 1;
    Application.ProcessMessages;
  End;
end;

procedure TfrmFatRomaneio.pAdicionaDadosRomDet;
  Var
    strSQL   : String;
    qryGenDet: TUniQuery;
    blnDocTemItemRepetido: Boolean;
begin
  If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'OX') Then
  Begin
    Exit;
  End;

  blnDocTemItemRepetido := fDocumentoTemItemRepetido(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                                                     cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                     cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                     cdsTmpDoc.FieldByName('GER_CODEMP').AsString);

  qryGenDet := fCriaQuery(Self);
  Try
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + '  ' + cdsTmpDoc.FieldByName('INCREMENTO').AsString + ' DET_SEQGER, ';

    if not fEmptyStr(cdsTmpDoc.FieldByName('ROMTRA').AsString) then
    begin
      strSQL := strSQL + '       D.DET_NUMDOC,';
      strSQL := strSQL + '       D.DET_ESPDOC,';
      strSQL := strSQL + '       D.DET_CODEMP,';
      strSQL := strSQL + '       D.DET_CODITE,';
      strSQL := strSQL + '       D.DET_EMPORI,';
      strSQL := strSQL + '       D.DET_DESCRI AS DET_DESITE,';
      strSQL := strSQL + '       (D.DET_QTDITE - IFNULL(SUM(DT.DET_QTDBAI), 0)) AS DET_QTDITE,';
      strSQL := strSQL + '       (D.DET_QTDITE - IFNULL(SUM(DT.DET_QTDBAI), 0)) AS DET_QTDBAI,';
      strSQL := strSQL + '       (D.DET_QTDITE - IFNULL(SUM(DT.DET_QTDBAI), 0)) AS DET_QTDTMP,';
      strSQL := strSQL + '       (D.DET_QTDITE - IFNULL(SUM(DT.DET_QTDBAI), 0)) AS DET_QTDTOT,';
      strSQL := strSQL + '       (D.DET_QTDITE - IFNULL(SUM(DT.DET_QTDBAI), 0)) AS DET_QTDTOT_REAL,';
      strSQL := strSQL + '       D.DET_TOTFRE, ';
      strSQL := strSQL + '       D.DET_DESACE, ';
      strSQL := strSQL + '       D.DET_UNITAR,';
      strSQL := strSQL + '       D.DET_DESESP,';
      strSQL := strSQL + '       D.DET_AUTINC,';

      {************************************************}
      {*** DET_AUTINC PARA DOCUMENTOS DE TRANSBORDO ***}
      {*********************************************BL*}
      strSQL := strSQL + '       D.AUTOINCREM AS DET_AUTINC_DOCTRA,';

      strSQL := strSQL + '       " " AS DET_INFITE,';
      strSQL := strSQL + '       "N" AS DET_SEPIMP,';
      strSQL := strSQL + '       D.DET_NUMLOT AS DET_NUMLOT,';
      strSQL := strSQL + '       "C" AS DET_TIP_FC,';
      strSQL := strSQL + '       D.DET_CODCLI,';
      strSQL := strSQL + '       D.DET_TOTPES,';
      strSQL := strSQL + '       IF(LEFT(D.DET_CLAFIS,1) >= "5","S","E") AS DET_ENTSAI,';
      strSQL := strSQL + '       CAST(" " AS CHAR(15)) AS TURENT,';
      strSQL := strSQL + '       UNI_SIGUNI AS DET_UNIDAD,';
      strSQL := strSQL + '       D.DET_TOTPES AS DET_VLTOPE ';
      strSQL := strSQL + '  FROM ROMTRAX';
      strSQL := strSQL + ' INNER JOIN ROMGERX R ON R.AUTOINCREM = ROMTRAX.TRA_SEQGER';
      strSQL := strSQL + ' INNER JOIN ROMDETX D ON D.DET_SEQGER = R.AUTOINCREM';

      {********************************************************************************}
      {*** FAZENDO JOIN COM ROMANEIOS GERADOS DO TRANSBORDO PARA VERIFICAR SE AINDA ***}
      {*** EXISTEM QUANTIDADES DISPONÍVEIS PARA NOVOS ROMANEIOS                     ***}
      {*****************************************************************************BL*}
      strSQL := strSQL + ' LEFT JOIN ROMGERX RT ON RT.GER_SEQTRA = ROMTRAX.AUTOINCREM';
      strSQL := strSQL + ' LEFT JOIN ROMDETX DT ON DT.DET_SEQGER = RT.AUTOINCREM AND D.DET_AUTINC = DT.DET_AUTINC';

      strSQL := strSQL + '  LEFT JOIN CADUNI ON UNI_CODUNI = D.DET_UNIDAD';
      strSQL := strSQL + ' WHERE ROMTRAX.AUTOINCREM = :AUTINC';
      strSQL := strSQL + ' GROUP BY D.DET_AUTINC';
    end
    else
    If (Pos(strOpcRom, '1_5_') > 0) Or (SameText(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString, 'FATGOR')) Then
    Begin
      strSQL := strSQL + '  FDO_NUMDOC DET_NUMDOC, ';
      strSQL := strSQL + '  FDO_ESPDOC DET_ESPDOC, ';
      strSQL := strSQL + '  FDO_CODEMP DET_CODEMP, ';
      strSQL := strSQL + '  FDO_CODITE DET_CODITE, ';
      strSQL := strSQL + '  FDO_DESCRI DET_DESITE, ';

      if (strOpcRom = '5') then
      begin
        strSQL := strSQL + '  SUM((IF(FDO_JAFATU = 1, FDO_QTDBAI, (FDO_QTDITE - FDO_QTDBAI))) - IFNULL(FDO_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM((IF(FDO_JAFATU = 1, FDO_QTDBAI, (FDO_QTDITE - FDO_QTDBAI))) - IFNULL(FDO_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM((IF(FDO_JAFATU = 1, FDO_QTDBAI, (FDO_QTDITE - FDO_QTDBAI))) - IFNULL(FDO_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM((IF(FDO_JAFATU = 1, FDO_QTDBAI, (FDO_QTDITE - FDO_QTDBAI))))                         DET_QTDTOT, ';
        strSQL := strSQL + '  SUM((IF(FDO_JAFATU = 1, FDO_QTDBAI, (FDO_QTDITE - FDO_QTDBAI))))                         DET_QTDTOT_REAL, ';
      end
      else if fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean) then
      begin
        strSQL := strSQL + '  SUM(FDO_QTDITE - GREATEST(IFNULL(FDO_QTDROM, 0), FDO_QTDBAI)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - GREATEST(IFNULL(FDO_QTDROM, 0), FDO_QTDBAI)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - GREATEST(IFNULL(FDO_QTDROM, 0), FDO_QTDBAI)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI)                                  DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI)                                  DET_QTDTOT_REAL, ';
      end
      else
      begin
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI - IFNULL(FDO_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI - IFNULL(FDO_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI - IFNULL(FDO_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI)                         DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(FDO_QTDITE - FDO_QTDBAI)                         DET_QTDTOT_REAL, ';
      end;

      strSQL := strSQL + '  FDO_TOTFRE DET_TOTFRE, ';
      strSQL := strSQL + '  FDO_DESACE DET_DESACE, ';
      strSQL := strSQL + '  FDO_UNITAR DET_UNITAR, ';
      strSQL := strSQL + '  FDO_DESESP DET_DESESP, ';
      strSQL := strSQL + '  FATDOR.AUTOINCREM DET_AUTINC, ';
      strSQL := strSQL + '  CAST("" AS CHAR(20)) AS DET_AUTINC_DOCTRA, ';
      strSQL := strSQL + '  " " AS DET_INFITE, ';
      strSQL := strSQL + '  "N" AS DET_SEPIMP, ';
      strSQL := strSQL + '  FDO_NUMLOT DET_NUMLOT, ';
      strSQL := strSQL + '  "C" DET_TIP_FC,        ';
      strSQL := strSQL + '  FDO_CODCLI DET_CODCLI, ';
      strSQL := strSQL + '  SUM((FDO_TOTPES / FDO_QTDITE) * (FDO_QTDITE - FDO_QTDBAI)) AS DET_TOTPES, ';
      strSQL := strSQL + '  IF(LEFT(FDO_CLAFIS,1) >= "5", "S", "E") DET_ENTSAI, ';
      strSQL := strSQL + '  EXTDOR.FDO_TURENT AS TURENT, ';
      strSQL := strSQL + '  UNI_SIGUNI AS DET_UNIDAD, ';
      strSQL := strSQL + '  SUM((FDO_TOTPES / FDO_QTDITE) * (FDO_QTDITE - FDO_QTDBAI)) AS DET_VLTOPE ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  FATDOR ';
      strSQL := strSQL + '  JOIN CADITE I ON ITE_CODITE = FDO_CODITE ';
      strSQL := strSQL + '  LEFT JOIN EXTDOR ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
      strSQL := strSQL + '  LEFT JOIN CADUNI ON FATDOR.FDO_UNIDAD = CADUNI.UNI_CODUNI ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  FDO_CODITE <> :ITESER AND ';
      strSQL := strSQL + '  FDO_CODITE <> :SERTER AND ';
      strSQL := strSQL + '  FDO_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  FDO_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  FDO_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '  FDO_CODEMP = :CODEMP ';

      If (strOpcRom = '1') Then
        strSQL := strSQL + '  AND FDO_JAFATU = 0 ';

      if (strOpcRom = '5') then
      begin
        strSQL := strSQL + '  AND ((IFNULL(FDO_NUMFAT,"") <> "" ';
        strSQL := strSQL + '  AND IFNULL(FDO_TIPFAT,"") <> "" ';
        strSQL := strSQL + '  AND IFNULL(FDO_EMPFAT,"") <> "" ';
        strSQL := strSQL + '  AND FDO_JAFATU = 1) ';
        strSQL := strSQL + '  OR (FDO_JAFATU = 0)) ';
      end;

      strSQL := strSQL + fSQLFiltroLinGru('FDO');

      strSQL := strSQL + 'GROUP BY ';
      strSQL := strSQL + '  FDO_CODITE, FDO_DESCRI, IFNULL(FDO_NUMLOT, "") ';

      If fAgrupaPorAutoIncrem(cdsTmpDoc.FieldByName('GER_CLAFIS').AsString, blnDocTemItemRepetido) Then
        strSQL := strSQL + '  ,FATDOR.AUTOINCREM ';

      If (fCfgSis('TRBRRO', varBoolean)) Then
      Begin
        strSQL := strSQL + '  ';
        strSQL := strSQL + 'UNION ALL ';
        strSQL := strSQL + '  ';
        strSQL := strSQL + 'SELECT ';
        strSQL := strSQL + '  ' + cdsTmpDoc.FieldByName('INCREMENTO').AsString + ' DET_SEQGER, ';
        strSQL := strSQL + '  DET_NUMDOC, ';
        strSQL := strSQL + '  DET_ESPDOC, ';
        strSQL := strSQL + '  DET_CODEMP, ';
        strSQL := strSQL + '  DET_CODITE, ';
        strSQL := strSQL + '  DET_DESCRI DET_DESITE, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)              DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)              DET_QTDTOT_REAL, ';
        strSQL := strSQL + '  DET_TOTFRE, ';
        strSQL := strSQL + '  DET_DESACE, ';
        strSQL := strSQL + '  DET_UNITAR, ';
        strSQL := strSQL + '  DET_DESESP, ';
        strSQL := strSQL + '  MOVDET.AUTOINCREM DET_AUTINC, ';
        strSQL := strSQL + '  CAST("" AS CHAR(20)) AS DET_AUTINC_DOCTRA, ';
        strSQL := strSQL + '  " " AS DET_INFITE, ';
        strSQL := strSQL + '  "N" AS DET_SEPIMP, ';
        strSQL := strSQL + '  DET_NUMLOT, ';
        strSQL := strSQL + '  "C" DET_TIP_FC,   ';
        strSQL := strSQL + '  DET_CODCLI,       ';
        strSQL := strSQL + '  SUM(DET_TOTPES) AS DET_TOTPES, ';
        strSQL := strSQL + '  IF(LEFT(DET_CLAFIS,1) >= "5", "S", "E") DET_ENTSAI, ';
        strSQL := strSQL + '  DET_TURENT AS TURENT, ';
        strSQL := strSQL + '  UNI_SIGUNI AS DET_UNIDAD, ';
        strSQL := strSQL + '  SUM(DET_TOTPES) AS DET_VLTOPE ';
        strSQL := strSQL + 'FROM ';
        strSQL := strSQL + '  MOVDET ';
        strSQL := strSQL + '  JOIN CADITE I ON ITE_CODITE = DET_CODITE ';
        strSQL := strSQL + '  LEFT JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
        strSQL := strSQL + '  LEFT JOIN CADUNI ON MOVDET.DET_UNIDAD = CADUNI.UNI_CODUNI ';
        strSQL := strSQL + 'WHERE ';
        strSQL := strSQL + '  DET_CODITE <> :ITESER AND ';
        strSQL := strSQL + '  DET_CODITE <> :SERTER AND ';

        If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'TR') Then
        Begin
          If (cdsTmpDoc.FieldByName('GER_ENTSAI').AsString = 'E') Then
            strSQL := strSQL + '  LEFT(DET_CLAFIS, 1) < 5 AND '
          Else
            strSQL := strSQL + '  LEFT(DET_CLAFIS, 1) >= 5 AND ';
        End
        Else
          strSQL := strSQL + fRetCondicaoCFOP('DET_CLAFIS') + ' AND ';

        If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
          strSQL := strSQL + '  DET_PROEMB <> "S" AND ';

        strSQL := strSQL + '  RIGHT(DET_CLAFIS, 3) <> "999" AND ';
        strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
        strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
        strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
        strSQL := strSQL + '  DET_CODEMP = :CODEMP ';

        strSQL := strSQL + fSQLFiltroLinGru('DET');

        strSQL := strSQL + 'GROUP BY ';
        strSQL := strSQL + '  DET_CODITE, DET_DESCRI, IFNULL(DET_NUMLOT, "") ';

        If fAgrupaPorAutoIncrem(cdsTmpDoc.FieldByName('GER_CLAFIS').AsString, blnDocTemItemRepetido) Then
          strSQL := strSQL + '  ,MOVDET.AUTOINCREM ';

      End;

    End
    Else If (strOpcRom = '2') Then
    Begin

      strSQL := strSQL + '  DET_NUMDOC, ';
      strSQL := strSQL + '  DET_ESPDOC, ';
      strSQL := strSQL + '  DET_CODEMP, ';
      strSQL := strSQL + '  DET_CODITE, ';
      strSQL := strSQL + '  DET_EMP_PD AS DET_EMPORI, ';
      strSQL := strSQL + '  DET_DESCRI DET_DESITE, ';

      If fUsaRomaneioDocsExpedidos Then
      Begin
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0) - IFNULL(DET_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0) - IFNULL(DET_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0) - IFNULL(DET_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0))              DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)                           DET_QTDTOT_REAL, ';
      End
      Else
      Begin
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)              DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)              DET_QTDTOT_REAL, ';
      End;

      strSQL := strSQL + '  DET_TOTFRE, ';
      strSQL := strSQL + '  DET_DESACE, ';
      strSQL := strSQL + '  DET_UNITAR, ';
      strSQL := strSQL + '  DET_DESESP, ';
      strSQL := strSQL + '  MOVDET.AUTOINCREM DET_AUTINC, ';
      strSQL := strSQL + '  CAST("" AS CHAR(20)) AS DET_AUTINC_DOCTRA, ';
      strSQL := strSQL + '  " " AS DET_INFITE, ';
      strSQL := strSQL + '  "N" AS DET_SEPIMP, ';
      strSQL := strSQL + '  DET_NUMLOT DET_NUMLOT,   ';
      strSQL := strSQL + '  "C" DET_TIP_FC,          ';
      strSQL := strSQL + '  DET_CODCLI,              ';

      If fUsaRomaneioDocsExpedidos Then
        strSQL := strSQL + '  SUM((DET_TOTPES / DET_QTDITE) * (COALESCE(DET_QTDEXP, 0) - COALESCE(DET_QTDROM, 0))) AS DET_TOTPES, '
      Else
        strSQL := strSQL + '  SUM(DET_TOTPES) AS DET_TOTPES, ';

      strSQL := strSQL + '  IF(LEFT(DET_CLAFIS,1) >= "5", "S", "E") DET_ENTSAI, ';
      strSQL := strSQL + '  DET_TURENT AS TURENT, ';
      strSQL := strSQL + '  UNI_SIGUNI AS DET_UNIDAD, ';
      strSQL := strSQL + '  SUM(DET_TOTPES) AS DET_VLTOPE ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  MOVDET ';
      strSQL := strSQL + '  JOIN CADITE I ON ITE_CODITE = DET_CODITE ';
      strSQL := strSQL + '  LEFT JOIN MOVTRI ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
      strSQL := strSQL + '  LEFT JOIN CADUNI ON MOVDET.DET_UNIDAD = CADUNI.UNI_CODUNI ';

