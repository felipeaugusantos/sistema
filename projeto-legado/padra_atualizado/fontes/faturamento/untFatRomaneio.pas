function TfrmFatRomaneio.fQtdeRomInvalido(strCodIte, strNumDoc, strEspDoc, strCodCli, strCodEmp, strTabela, strAutInc: String; fltQtdBai: Double): Boolean;
var
  qryTmp : TUniQuery;
  strSQL, strMsg: String;
  fltQtdIte: Double;
begin
  Result := False;
  Try
    qryTmp := fCriaQuery(Self);

    If strTabela = 'FATDOR' Then
    Begin
      strSQL := ' SELECT IF((SUM(IFNULL(FDO_QTDROM, 0)) > SUM(FDO_QTDITE)) OR (IFNULL(SUM(R.DET_QTDITE), 0) > SUM(FDO_QTDITE)), "S", "N") AS INVALIDO '+
                ' FROM FATDOR '+
                ' LEFT JOIN ROMDETX R ON FATDOR.AUTOINCREM = R.DET_AUTINC AND FDO_CODITE = R.DET_CODITE '+
                ' WHERE FDO_CODITE = :CODITE '+
                '   AND FDO_NUMDOC = :NUMDOC '+
                '   AND FDO_ESPDOC = :ESPDOC '+
                '   AND FDO_CODCLI = :CODCLI '+
                '   AND FDO_CODEMP = :CODEMP ';
    End
    Else
    Begin
      strSQL := ' SELECT IF((SUM(IFNULL(M.DET_QTDROM, 0)) > SUM(M.DET_QTDITE)) OR (IFNULL(SUM(R.DET_QTDITE), 0) > SUM(M.DET_QTDITE)), "S", "N") AS INVALIDO '+
                ' FROM '+strTabela+ ' M '+
                ' LEFT JOIN ROMDETX R ON M.AUTOINCREM = R.DET_AUTINC AND M.DET_CODITE = R.DET_CODITE '+
                ' WHERE M.DET_CODITE = :CODITE '+
                '   AND M.DET_NUMDOC = :NUMDOC '+
                '   AND M.DET_ESPDOC = :ESPDOC '+
                '   AND M.DET_CODCLI = :CODCLI '+
                '   AND M.DET_CODEMP = :CODEMP ';
    End;

    qryTmp.SQL.Text := strSQL;
    qryTmp.ParamByName('CODITE').AsString := strCodIte;
    qryTmp.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTmp.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTmp.ParamByName('CODCLI').AsString := strCodCli;
    qryTmp.ParamByName('CODEMP').AsString := strCodEmp;
    qryTmp.Open;

    If (qryTmp.FieldByName('INVALIDO').AsString = 'S') Then
    Begin
      Result := True;
      strMsg := 'Documento ['+ strNumDoc +'-'+ strEspDoc +'-'+ strCodEmp +'] com quantidade inválida!'+ sLineBreak +
                'Refaça esse documento e tente novamente.';
    End
    Else
    Begin
      fltQtdIte := fGetQuantidadeItemDocumento(strAutInc,
                                               strNumDoc,
                                               strEspDoc,
                                               strCodCli,
                                               strCodEmp,
                                               strTabela);

      If fltQtdBai > fltQtdIte Then
      Begin
        Result := True;
        strMsg := 'Documento ['+ strNumDoc +'-'+ strEspDoc +'-'+ strCodEmp +'] com quantidade inválida!'+ sLineBreak +
                  'O Item '+ strCodIte +' possui quantidade baixada maior que a quantidade do item.'+ sLineBreak +
                  'Quantidade Baixada: '+ FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), fltQtdBai) + sLineBreak +
                  'Quantidade do Item: '+ FormatFloat(fMskDigitos(fCfgSis('DECQTD', varInteger)), fltQtdIte) + sLineBreak +
                  'Refaça esse documento e tente novamente.';
      End;
    End;

    If Result Then
    Begin
      raise ExceptionQtdRomaneio.Create(strMsg);
    End;

  Finally
    FreeAndNil(qryTmp);
  End;
end;

function TfrmFatRomaneio.fGetQuantidadeItemDocumento(strAutInc,
  strNumDoc, strEspDoc, strCodCli, strCodEmp, strTabela: String): Double;
var
  qryAux: TUniQuery;
  strAbrDet: String;
begin
  strAbrDet := IIF(strTabela = 'FATDOR', 'FDO_', 'DET_');

  qryAux := fCriaQuery(Self);
  try
    qryAux.Close;
    qryAux.SQL.Text :=
    ' SELECT '+
        strAbrDet+'QTDITE '+
    ' FROM '+
        strTabela+
    ' WHERE '+
        'AUTOINCREM = :AUTINC AND '+
        strAbrDet+'NUMDOC = :NUMDOC AND '+
        strAbrDet+'ESPDOC = :ESPDOC AND '+
        strAbrDet+'CODCLI = :CODCLI AND '+
        strAbrDet+'CODEMP = :CODEMP ';

    qryAux.ParamByName('AUTINC').AsString := strAutInc;
    qryAux.ParamByName('NUMDOC').AsString := strNumDoc;
    qryAux.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAux.ParamByName('CODCLI').AsString := strCodCli;
    qryAux.ParamByName('CODEMP').AsString := strCodEmp;
    qryAux.Open;

    Result := qryAux.FieldByName(strAbrDet+'QTDITE').AsFloat;

  finally
    FreeAndNil(qryAux);
  end;
end;

procedure TfrmFatRomaneio.pCriaClientMaster;
begin
  If Not Assigned(cdsMaster) Then
  Begin
    cdsMaster := TUniClientDataSet.Create(Self);
    dtsMaster := fCriaDataSource(cdsMaster);
    dbgDocumentosDBViewMaster.DataController.DataSource := dtsMaster;
    dbgDocumentosDBViewMaster.DataController.KeyFieldNames := 'GER_CODROT';

    dbgDocumentosDBView.DataController.DetailKeyFieldNames := 'GER_CODROT';
    dbgDocumentosDBView.DataController.KeyFieldNames := 'GER_AUTINC';
    dbgDocumentosDBView.DataController.MasterKeyFieldNames := 'GER_CODROT';

    With cdsMaster.FieldDefs.AddFieldDef Do
    Begin
      Name     := 'GER_MARDES';
      DataType := ftString;
      Size     := 1;
    End;

    With cdsMaster.FieldDefs.AddFieldDef Do
    Begin
      Name     := 'GER_CODROT';
      DataType := ftString;
      Size     := 8;
    End;

    With cdsMaster.FieldDefs.AddFieldDef Do
