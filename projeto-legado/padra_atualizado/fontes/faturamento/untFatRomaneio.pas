  ARecRomGer.fltTotIpi := 0;
  ARecRomGer.fltBasIcm := 0;
  ARecRomGer.fltTotIcm := 0;
  ARecRomGer.fltTotRet := 0;
  ARecRomGer.fltBasRet := 0;
  ARecRomGer.fltDesEsp := 0;
  ARecRomGer.fltVlrCon := 0;
  ARecRomGer.fltTotPro := 0;
  ARecRomGer.fltTotCus := 0;
  ARecRomGer.fltTotMed := 0;
  ARecRomGer.fltTotFre := 0;
  ARecRomGer.fltVolUme := 0;
  ARecRomGer.fltVpaR01 := 0;
  ARecRomGer.fltVpaR02 := 0;
  ARecRomGer.fltVpaR03 := 0;
  ARecRomGer.fltVpaR04 := 0;
  ARecRomGer.fltVpaR05 := 0;
  ARecRomGer.fltVpaR06 := 0;
  ARecRomGer.fltVpaR07 := 0;
  ARecRomGer.fltVpaR08 := 0;
  ARecRomGer.fltVpaR09 := 0;
