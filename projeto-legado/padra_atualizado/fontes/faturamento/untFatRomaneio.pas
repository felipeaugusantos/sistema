procedure TfrmFatRomaneio.pAtualizaTemporaria(pgbStatus: TcxProgressBar=Nil);
Var
  strSQL       : String;
  strSelect    : String;
  strSQLGer    : String;
  strLinReg    : String;
  strLinDep    : String;
  strLinVen    : String;
  strLinGru    : String;
  strLinCid    : String;
  strLinTra    : String;
  strLinTraFat : String;
  strLinCli    : String;
  strLinPro    : String;
  strLinAte    : String;
  strRotas     : String;
  qryDados     : TUniQuery;
begin
  strSelect := '';
  qryDados := fCriaQuery(Self);

  {*******************************************}
  {* CASO ESTEJA ALTERANDO, CARREGA OS DOCS  *}
  {* JA CADASTRADOS                          *}
  {****************************************MV*}
  If (Not fEmptyStr(edtNumRom.Text)) Or (fEhRomaneioSimplificado) Then {<<-- Se for romaneio simplificado,
                                                                             executa SQL (:NUMROM = vazio) para criar estrutura no client!}
  Begin
    strSQL := '';
    strSQL := strSQL + 'SELECT ';
    strSQL := strSQL + fRetSQLDocRetornadoRomaneio('R.GER') + ' AS GER_RETROM, ';
    strSQL := strSQL + '  R.GER_CONPAG AS GER_CONPAG, ';
    strSQL := strSQL + '  R.GER_CODFPG AS GER_CODFPG, ';
    strSQL := strSQL + '  " "          AS GER_TIPOPE, ';
    strSQL := strSQL + '  " "          AS GER_FPGNEG, ';
    strSQL := strSQL + '  "N"          AS GER_ORIF11, ';
    strSQL := strSQL + '  0.00         AS GER_TOTBRI, ';
    strSQL := strSQL + '  0.00         AS GER_VALREC, ';
    strSQL := strSQL + '  0.00         AS GER_BOLADT, ';
    strSQL := strSQL + '  "N"          AS GER_BOLVEN, ';
    strSQL := strSQL + '  0.00         AS GER_VALADT, ';
    strSQL := strSQL + '  R.GER_VLRCON AS GER_CONORI, ';
    strSQL := strSQL + '  R.GER_DTAROM, ';
    strSQL := strSQL + '  R.GER_HORROM, ';
    strSQL := strSQL + '  R.GER_DTAENT, ';
    strSQL := strSQL + '  R.GER_HORENT, ';
    strSQL := strSQL + '  DATE_FORMAT( ';
    strSQL := strSQL + '       IF(IFNULL(PD.FGO_DTENTR,0) = 0, ';
    strSQL := strSQL + '          IF(IFNULL(G.GER_DTENTR,0) = 0, ';
    strSQL := strSQL + '                   N.GER_DTENTR, ';
    strSQL := strSQL + '             G.GER_DTENTR), ';
    strSQL := strSQL + '          PD.FGO_DTENTR), ';
    strSQL := strSQL + '  "%d/%m/%Y") AS GER_DTENTR, ';
    strSQL := strSQL + '  CONCAT( R.GER_NUMDOC, "-", R.GER_ESPDOC ) AS GER_NUMDOC, ';
    strSQL := strSQL + '  R.GER_NUMDOC AS GER_DOCORI, ';
    strSQL := strSQL + '  R.GER_ESPDOC, ';
    strSQL := strSQL + '  R.GER_CODEMP, ';

    if (rdgEmpresa.Enabled) then
    begin
      strSQL := strSQL + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
    end
    else
    begin
      strSQL := strSQL + '  CAST(" " AS CHAR(255)) AS DET_EMPORI, ';
    end;

    strSQL := strSQL + '  R.GER_CODCLI, ';
    strSQL := strSQL + '  IF(R.GER_ESPDOC = "OX", R.GER_MEN001, IF( R.GER_NOMCON IS NULL, CLI_NOMCLI, R.GER_NOMCON)) AS GER_NOMCLI, ';
    strSQL := strSQL + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
    strSQL := strSQL + '  R.GER_CLAFIS, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_CIDENT, "") <> "", ';
    strSQL := strSQL + '     R.GER_CIDENT, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(CIDCLI.CID_CODCID, ';
    strSQL := strSQL + '                 CIDCLIN.CID_CODCID, ';
    strSQL := strSQL + '                 CIDCLIG.CID_CODCID), ';
    strSQL := strSQL + '        COALESCE(CIDGER.CID_CODCID, ';
    strSQL := strSQL + '                 CIDNOT.CID_CODCID, ';
    strSQL := strSQL + '                 CIDGOR.CID_CODCID,';
    strSQL := strSQL + '                 OUTDIGX.DIG_CODCID, ';
    strSQL := strSQL + '                 CADCID.CID_CODCID) ';
    strSQL := strSQL + '     )) AS CID_CODCID, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_CIDENT, "") <> "", ';
    strSQL := strSQL + '     CIDENT.CID_NOMCID, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(CIDCLI.CID_NOMCID, ';
    strSQL := strSQL + '                 CIDCLIN.CID_NOMCID, ';
    strSQL := strSQL + '                 CIDCLIG.CID_NOMCID), ';
    strSQL := strSQL + '        COALESCE(CIDGER.CID_NOMCID, ';
    strSQL := strSQL + '                 CIDNOT.CID_NOMCID, ';
    strSQL := strSQL + '                 CIDGOR.CID_NOMCID,';
    strSQL := strSQL + '                 OUTDIGX.DIG_NOMCID, ';
    strSQL := strSQL + '                 CADCID.CID_NOMCID) ';
    strSQL := strSQL + '     )) AS GER_NOMCID, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_CIDENT, "") <> "", ';
    strSQL := strSQL + '     CIDENT.CID_ESTADO, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '               COALESCE(CIDCLI.CID_ESTADO, ';
    strSQL := strSQL + '                        CIDCLIN.CID_ESTADO, ';
    strSQL := strSQL + '                        CIDCLIG.CID_ESTADO), ';
    strSQL := strSQL + '               COALESCE(CIDGER.CID_ESTADO, ';
    strSQL := strSQL + '                        CIDNOT.CID_ESTADO, ';
    strSQL := strSQL + '                        CIDGOR.CID_ESTADO,';
    strSQL := strSQL + '                        OUTDIGX.DIG_ESTADO, ';
    strSQL := strSQL + '                        CADCID.CID_ESTADO) ';
    strSQL := strSQL + '     )) AS GER_ESTADO, ';

    strSQL := strSQL + ' R.GER_TIPFRE, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_BAIENT, "") <> "", ';
    strSQL := strSQL + '     R.GER_BAIENT, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(ECMOV.ETC_BAIENT, ';
    strSQL := strSQL + '                 ECNOT.ETC_BAIENT, ';
    strSQL := strSQL + '                 ECGOR.ETC_BAIENT), ';
    strSQL := strSQL + '        COALESCE(G.GER_BAICON, ';
    strSQL := strSQL + '                 N.GER_BAICON, ';
    strSQL := strSQL + '                 PD.FGO_BAICON,';
    strSQL := strSQL + '                 OUTDIGX.DIG_BAIRRO, ';
    strSQL := strSQL + '                 CADCLI.CLI_BAIRRO) ';
    strSQL := strSQL + '     )) AS GER_BAIRRO, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_ENDENT, "") <> "", ';
    strSQL := strSQL + '     R.GER_ENDENT, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(ECMOV.ETC_ENDENT, ';
    strSQL := strSQL + '                 ECNOT.ETC_ENDENT, ';
    strSQL := strSQL + '                 ECGOR.ETC_ENDENT), ';
    strSQL := strSQL + '        COALESCE(G.GER_ENDCON, ';
    strSQL := strSQL + '                 N.GER_ENDCON, ';
    strSQL := strSQL + '                 PD.FGO_ENDCON,';
    strSQL := strSQL + '                 OUTDIGX.DIG_ENDCON, ';
    strSQL := strSQL + '                 CADCLI.CLI_ENDERE) ';
    strSQL := strSQL + '     )) AS GER_ENDCON, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_LATLON, "") <> "", ';
    strSQL := strSQL + '     R.GER_LATLON, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(ECMOV.ETC_LATLON, ';
    strSQL := strSQL + '                 ECNOT.ETC_LATLON, ';
    strSQL := strSQL + '                 ECGOR.ETC_LATLON), " ")) AS GER_LATLON, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_CEPENT, "") <> "", ';
    strSQL := strSQL + '     R.GER_CEPENT, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(ECMOV.ETC_CEPENT, ';
    strSQL := strSQL + '                 ECNOT.ETC_CEPENT, ';
    strSQL := strSQL + '                 ECGOR.ETC_CEPENT), ';
    strSQL := strSQL + '        COALESCE(G.GER_CEPCON, ';
    strSQL := strSQL + '                 N.GER_CEPCON, ';
    strSQL := strSQL + '                 PD.FGO_CEPCON,';
    strSQL := strSQL + '                 OUTDIGX.DIG_CEPCON, ';
    strSQL := strSQL + '                 CADCLI.CLI_C_E_P_) ';
    strSQL := strSQL + '     )) AS GER_CEPCON, ';

    strSQL := strSQL + '  IF(IFNULL(R.GER_REFENT, "") <> "", ';
    strSQL := strSQL + '     R.GER_REFENT, ';
    strSQL := strSQL + '     IF('+fEnderecoPelaEntCli('','R')+',';
    strSQL := strSQL + '        COALESCE(ECMOV.ETC_REFENT, ';
    strSQL := strSQL + '                 ECNOT.ETC_REFENT, ';
    strSQL := strSQL + '                 ECGOR.ETC_REFENT), ';
    strSQL := strSQL + '        COALESCE(CADCLI.CLI_REFENT, ';
    strSQL := strSQL + '                 OUTDIGX.DIG_REFCON) ';
    strSQL := strSQL + '     )) AS GER_REFCON, ';

    strSQL := strSQL + '  R.GER_CODVEN, ';
    strSQL := strSQL + '  CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
    strSQL := strSQL + '  R.GER_VLRCON, '; //DETIN
    strSQL := strSQL + '  R.GER_VLRCON AS GER_VALDOC, '; //DETIN
    strSQL := strSQL + '  (R.GER_TOTPRO - R.GER_DESESP) GER_VLRPRO, ';
    strSQL := strSQL + '  "M" AS GER_MARDES,        ';

    if blnUtilizaMultiVeiculosRomaneio then
    begin
      strSQL := strSQL + '  "1" AS GER_VEICUL,        ';
    end
    else
    begin
      strSQL := strSQL + '  " " AS GER_VEICUL,        ';
    end;

    strSQL := strSQL + fGetSQLPosObs('R','GER_NUMDOC','GER_ESPDOC','GER_CODEMP') + ' AS POSOBS, ';

    strSQL := strSQL + '  R.GER_PALET_,             ';
    strSQL := strSQL + '  R.GER_VLRCON AS GER_VALSEL, '; //DETIN
    strSQL := strSQL + '  (R.GER_TOTPRO - R.GER_DESESP) AS GER_VSEPRO, '; 
    strSQL := strSQL + '  R.GER_VLRORI AS GER_VLRORI, ';
    strSQL := strSQL + '  R.GER_ROMIMP, ';
    strSQL := strSQL + '  "S" AS GER_ALTERA,        ';
    strSQL := strSQL + '  0 INCREMENTO, ';
    strSQL := strSQL + '  R.GER_TIP_FC, ';
    strSQL := strSQL + '  R.GER_ORDIMP, ';
    strSQL := strSQL + '  IF((AUXMOV.AUX_ENTGER  IS NOT NULL OR ';
    strSQL := strSQL + '      AUXNOT.AUX_ENTGER  IS NOT NULL OR ';
    strSQL := strSQL + '      AUXGOR.AUX_ENTGER  IS NOT NULL), ';
    strSQL := strSQL + '     COALESCE( ';
    strSQL := strSQL + '      TRAMOV.TRA_CODTRA, ';
    strSQL := strSQL + '      TRANOT.TRA_CODTRA, ';
    strSQL := strSQL + '      TRAGOR.TRA_CODTRA), ';
    strSQL := strSQL + '      TRAROM.TRA_CODTRA) AS GER_CODTRA, ';
    strSQL := strSQL + '  IF((AUXMOV.AUX_ENTGER  IS NOT NULL OR ';
    strSQL := strSQL + '      AUXNOT.AUX_ENTGER  IS NOT NULL OR ';
    strSQL := strSQL + '      AUXGOR.AUX_ENTGER  IS NOT NULL OR ';
    strSQL := strSQL + '      PD.FGO_CODTRA      IS NOT NULL ), ';
    strSQL := strSQL + '     COALESCE( ';
    strSQL := strSQL + '      TRAMOV.TRA_NOMTRA, ';
    strSQL := strSQL + '      TRANOT.TRA_NOMTRA, ';
    strSQL := strSQL + '      CADTRA.TRA_NOMTRA,  ';
    strSQL := strSQL + '      TRAGOR.TRA_NOMTRA), ';
    strSQL := strSQL + '      TRAROM.TRA_NOMTRA) AS GER_TRANSP, ';
    strSQL := strSQL + '      IFNULL(TRADOC.TRA_NOMTRA, TRAROM.TRA_NOMTRA) AS GER_TRAFAT, ';
    strSQL := strSQL + '      TRADOC.TRA_CODTRA  AS GER_TRADOC, ';
    strSQL := strSQL + '  CAST((SELECT CAST(GROUP_CONCAT(DISTINCT FDO_NUMDOC, "-", FDO_ESPDOC) AS CHAR(255)) FROM FATDOR WHERE FDO_NUMFAT = R.GER_NUMDOC AND FDO_TIPFAT = R.GER_ESPDOC AND FDO_EMPFAT = R.GER_CODEMP)AS CHAR(255)) GER_PEDVEN, ';

    if (Pos(strOpcRom, '1_5_') <= 0) then
      strSQL := strSQL + '  IFNULL(G.GER_PESBRU, IFNULL(N.GER_PESBRU, PD.FGO_PESBRU)) AS GER_PESBRU, '
    else
      strSQL := strSQL + '  IFNULL(G.GER_PESBRU, IFNULL(N.GER_PESBRU, SUM((FDO_PESBRU / FDO_QTDITE) * (FDO_QTDITE - FDO_QTDBAI)))) AS GER_PESBRU, ';

    strSQL := strSQL + '  IF(R.GER_ESPDOC = "OX", "OUTDIGX", IF(PD.FGO_NUMDOC IS NULL, IF(G.GER_NUMDOC IS NULL, "NOTGER", "MOVGER"),"FATGOR")) AS GER_NOMTBL, ';
    strSQL := strSQL + '  R.GER_AUTINC AS GER_AUTINC, ';
    strSQL := strSQL + '  IF((LOCATE(IFNULL(G.GER_CLAFIS, N.GER_CLAFIS), "1411_1202_1405_2411_2202_") OR ((IFNULL(G.GER_ESPDOC, N.GER_ESPDOC) IN ("DV","TR")) AND (LEFT(IFNULL(G.GER_CLAFIS, N.GER_CLAFIS), 1) <= 2))), "D", IFNULL(G.GER_ORIDOC, N.GER_ORIDOC)) AS GER_ORIDOC, ';
    strSQL := strSQL + '  CAST(0.0000 AS DECIMAL(15, 4)) AS GER_TOTDET, ';
    strSQL := strSQL + '  R.GER_NUMROM AS GER_NROROM, ';
    strSQL := strSQL + fSQLVolume('DET', 'R')  + ' AS GER_VOLUME, ';

    If (Pos(strOpcRom, '1_5_') <= 0) Then
    Begin
      strSQL := strSQL + fSQLProfissionalCodigo('DET')  + ' AS GER_CODDIV, ';
      strSQL := strSQL + fSQLProfissionalNome('DET')  + ' AS GER_NOMDIV, ';
    End
    Else
    Begin
      strSQL := strSQL + fSQLProfissionalCodigo('FDO')  + ' AS GER_CODDIV, ';
      strSQL := strSQL + fSQLProfissionalNome('FDO')  + ' AS GER_NOMDIV, ';
    End;

    strSQL := strSQL + '  "N" AS GER_PRVIMP, ';
    strSQL := strSQL + '  MOV_OBSERV AS GER_NFEADC, ';
    strSQL := strSQL + '  PD.FGO_MENEXP AS GER_MENEXP, ';
    strSQL := strSQL + '  PD.FGO_MENEX2 AS GER_MENEX2, ';
    strSQL := strSQL + '  PD.FGO_MENEX3 AS GER_MENEX3, ';
    strSQL := strSQL + '  PD.FGO_MENEX4 AS GER_MENEX4, ';
    strSQL := strSQL + '  IF(IFNULL(EXTGOR.FGO_ENTURG, "") = "S", "SIM", "") AS ENTURG, ';

    // ** GER_NUMFAT **
    strSQL := strSQL + '  IF(G.GER_NUMDOC IS NULL, ';
    strSQL := strSQL + '  CONCAT(N.GER_NUMFAT, N.GER_TIPFAT, N.GER_EMPFAT, N.GER_CLIFAT), ';
    strSQL := strSQL + '  CONCAT(G.GER_NUMFAT, G.GER_TIPFAT, G.GER_EMPFAT, G.GER_CLIFAT)) AS GER_NUMFAT, ';

    // ** GER_DOCUME **
    strSQL := strSQL + '  IF(G.GER_NUMDOC IS NULL,';
    strSQL := strSQL + '  CONCAT(N.GER_NUMDOC,  N.GER_ESPDOC, N.GER_CODEMP, N.GER_CODCLI), ';
    strSQL := strSQL + '  CONCAT(G.GER_NUMDOC,  G.GER_ESPDOC, G.GER_CODEMP, G.GER_CODCLI)) AS GER_DOCUME, ';

    strSQL := strSQL + '  R.GER_ENTSAI, ';
    strSQL := strSQL + '  FIS_ACESSO, ';

    strSQL := strSQL + '  " " AS GER_ENTFUT, ';
    strSQL := strSQL + '  " " AS GER_ENTFAT, ';
    strSQL := strSQL + '  " " AS GER_CONENT, ';
    strSQL := strSQL + '  "N" AS APENAS_ESTE, ';
    strSQL := strSQL + fSQLVolume('DET', 'R')  + ' AS GER_VOLBIP, '; {<<-- Documento já pertence ao romaneio, então apresenta
                                                                           valor bipado igual ao volume do documento!}
    // ** CADREG REGIAO **
    strSQL := strSQL + fRetSQLDescrRegiao;

    strSQL := strSQL + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';

    strSQL := strSQL + fRetSQLSeqRotaRegiao(' IF('+fEnderecoPelaEntCli('','R')+',' +
                                            ' COALESCE(CIDCLI.CID_CODCID, '+
                                            '           CIDCLIN.CID_CODCID, '+
                                            '           CIDCLIG.CID_CODCID), '+
                                            '  COALESCE(CIDGER.CID_CODCID, '+
                                            '           CIDNOT.CID_CODCID, '+
                                            '           CIDGOR.CID_CODCID)) ');

    strSQL := strSQL + '  R.GER_BASSIM, ';
    strSQL := strSQL + '  R.GER_BASIPI, ';
    strSQL := strSQL + '  R.GER_TOTIPI, ';
    strSQL := strSQL + '  R.GER_BASICM, ';
    strSQL := strSQL + '  R.GER_TOTICM, ';
    strSQL := strSQL + '  R.GER_TOTRET, ';
    strSQL := strSQL + '  R.GER_BASRET, ';
    strSQL := strSQL + '  R.GER_DESESP, ';
    strSQL := strSQL + '  R.GER_TOTCUS, ';
    strSQL := strSQL + '  R.GER_TOTMED, ';
    strSQL := strSQL + '  R.GER_TOTFRE, ';
    strSQL := strSQL + '  R.GER_VPAR01, ';
    strSQL := strSQL + '  R.GER_VPAR02, ';
    strSQL := strSQL + '  R.GER_VPAR03, ';
    strSQL := strSQL + '  R.GER_VPAR04, ';
    strSQL := strSQL + '  R.GER_VPAR05, ';
    strSQL := strSQL + '  R.GER_VPAR06, ';
    strSQL := strSQL + '  R.GER_VPAR07, ';
    strSQL := strSQL + '  R.GER_VPAR08, ';
    strSQL := strSQL + '  R.GER_VPAR09, ';
    strSQL := strSQL + '  R.GER_VPAR10, ';
    strSQL := strSQL + '  R.GER_VPAR11, ';
    strSQL := strSQL + '  R.GER_VPAR12, ';
    strSQL := strSQL + '  R.GER_TOTPRO, ';
    strSQL := strSQL + '  R.GER_CODCND, ';
    strSQL := strSQL + fRetornaCampoOrigemPedidoRetira('G');
    strSQL := strSQL + '  " " AS GER_ORIDEV, ';

    strSQL := strSQL + fRetornaInformacoesRota;
    strSQL := strSQl + '  " " AS DOC_FATURADOS, ';

    If (Pos(strOpcRom, '1_5_') <= 0) Then
    Begin
      strSQL := strSQL + '  CAST(REPLACE(GROUP_CONCAT(MOVTRI.DET_INCFUT), ",", " ") AS CHAR(255)) AS GER_INCFUT, ';
      strSQL := strSQL + '  " " AS TIPPED, ';
      strSQL := strSQL + '  1.00 AS GER_PERDEV, ';
      strSQL := strSQL + ' (SELECT ROMLGE.RLG_NUMLOT  ';
      strSQL := strSQL + '  FROM ROMLGE ';
      strSQL := strSQL + '  INNER JOIN ROMLDE ';
      strSQL := strSQL + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';

      if (fCfgSis('OPROSE', varString) = '2') and (fCfgSis('OPROML', varString) = '2') then
      begin
        strSQL := strSQL + '  WHERE RLD_NUMDOC = G.GER_NUMDOC ';
        strSQL := strSQL + '  AND RLD_ESPDOC = G.GER_ESPDOC ';
        strSQL := strSQL + '  AND RLD_CODEMP = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';
      end
      else
      begin
        strSQL := strSQL + '  INNER JOIN FATGOR ';
        strSQL := strSQL + '  ON (RLD_NUMDOC = FGO_NUMDOC ';
        strSQL := strSQL + '  AND RLD_ESPDOC = FGO_ESPDOC ';
        strSQL := strSQL + '  AND RLD_CODEMP = FGO_CODEMP) ';
        strSQL := strSQL + '  WHERE FGO_NUMFAT = G.GER_NUMDOC ';
        strSQL := strSQL + '  AND FGO_TIPFAT = G.GER_ESPDOC ';
        strSQL := strSQL + '  AND FGO_EMPFAT = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';
      end;

      strSQL := strSQL + fRetornaCampoTurno('MOVTRI.DET_TURENT');
    End
    Else
    Begin
      strSQL := strSQL + '  CAST(REPLACE(GROUP_CONCAT(FDO_INCFUT), ",", " ") AS CHAR(255)) AS GER_INCFUT, ';
      strSQL := strSQL + '  IF(PD.FGO_TIPPED = "A", "NF", IF(PD.FGO_TIPPED = "B", "FF", IF(PD.FGO_TIPPED = "C", "IF", ""))) AS TIPPED, ';
      strSQL := strSQL + '  1.00 AS GER_PERDEV, ';
      strSQL := strSQL + ' (SELECT ROMLGE.RLG_NUMLOT  ';
      strSQL := strSQL + '  FROM ROMLGE ';
      strSQL := strSQL + '  INNER JOIN ROMLDE ';
      strSQL := strSQL + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
      strSQL := strSQL + '  WHERE RLD_NUMDOC = G.GER_NUMDOC ';
      strSQL := strSQL + '  AND RLD_ESPDOC = G.GER_ESPDOC ';
      strSQL := strSQL + '  AND RLD_CODEMP = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';

      strSQL := strSQL + fRetornaCampoTurno('FDO_TURENT');
    End;

    strSQL := strSQL + ', "N" AS DELETA_DEVOLUCAO ';

    strSQL := strSQL + ', CAST(IF(TRAORI.AUTOINCREM IS NOT NULL, " ", GER_SEQTRA) AS CHAR(20)) AS ROMTRA ';
    strSQL := strSQL + ', CAST(IF(TRAORI.AUTOINCREM IS NOT NULL, " ", TRAFIL.TRA_EMPDES) AS CHAR(3)) AS TRA_EMPDES ';

    if fCfgSis('MATDIS', varBoolean) then
    begin
      strSQL := strSQL + ', R.GER_LOCALI ';
      strSQL := strSQL + ', R.GER_DISTAN ';
      strSQL := strSQL + ', R.GER_TMPENT ';
      strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
      strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
      strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
      strSQL := strSQL + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
      strSQL := strSQL + ', R.GER_PRIORI AS PRIORIDADE ';
      strSQL := strSQL + ', R.GER_LIBAPP ';
      strSQL := strSQL + ', R.GER_EVITAR ';
      strSQL := strSQL + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
      strSQL := strSQL + ', R.GER_FILIAL ';
      strSQL := strSQL + ', R.GER_INIPAR ';
      strSQL := strSQL + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
      strSQL := strSQL + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
      strSQL := strSQL + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
      strSQL := strSQL + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
      strSQL := strSQL + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
      strSQL := strSQL + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
      strSQL := strSQL + ', R.GER_FSTSHT ';
      strSQL := strSQL + ', R.GER_FINROT ';
    end;

    strSQL := strSQL + ', CADCLI.CLI_CODRED ';
    strSQL := strSQL + ', CADCLI.CLI_CODCAC ';
    strSQL := strSQL + ', CADCLI.CLI_FANSOB ';
    strSQL := strSQL + ', CADCLI.CLI_ORIENT ';
    strSQL := strSQL + ', CAC.CAC_CORILP ';
    strSQL := strSQL + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

    strSQL := strSQL + ', IF(R.GER_CODFIL IS NOT NULL, "R", ';
    strSQL := strSQL + '    IF(TRAORI.AUTOINCREM IS NOT NULL, "B", ';
    strSQL := strSQL + '       CAST("" AS CHAR(1)))) AS GER_TIPENT ';
    strSQL := strSQL + ', IF(TRAORI.AUTOINCREM IS NOT NULL, TRAORI.TRA_EMPDES, R.GER_CODFIL) AS GER_CODFIL ';

    strSQL := strSQL + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
    strSQL := strSQL + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
    strSQL := strSQL + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
    strSQL := strSQL + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
    strSQL := strSQL + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
    strSQL := strSQL + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
    strSQL := strSQL + CAMPO_STRING_255 + 'GER_REFCON_BAK ';

    If (Pos(strOpcRom, '1_5_') <= 0) Then
      strSQL := strSQL + ', MOVDET.DET_CLAFIS '
    Else
      strSQL := strSQL + ', FATDOR.FDO_CLAFIS AS DET_CLAFIS ';

    strSQL := strSQL + ', ' + fSQLBarDoc('G.GER') + ' AS BARDOC ';

    strSQL := strSQL + ', R.GER_ALTEND ';
    strSQL := strSQL + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
    strSQL := strSQL + ', R.GER_INTFUS ';
    strSQL := strSQL + ', R.GER_ROMFUS ';
    strSQL := strSQL + ', R.GER_DTAINI ';
    strSQL := strSQL + ', R.GER_HORINI ';

    strSQL := strSQL + 'FROM ';
    strSQL := strSQL + '  ROMGERX R ';
    strSQL := strSQL + '  LEFT JOIN CADCLI      ON R.GER_CODCLI      = CLI_CODCLI ';
    strSQL := strSQL + '  LEFT JOIN CADCID      ON CADCID.CID_CODCID = IF(R.GER_CIDCON IS NULL, CLI_CODCID, R.GER_CIDCON) ';
    strSQL := strSQL + '  LEFT JOIN CADTRA TRAROM ON R.GER_CODTRA    = TRAROM.TRA_CODTRA  ';
    strSQL := strSQL + '  LEFT JOIN CADFPG      ON R.GER_CODFPG      = FPG_CODIGO ';

    strSQL := strSQL + '  LEFT JOIN MOVGER G ON G.GER_NUMDOC = R.GER_NUMDOC AND ';
    strSQL := strSQL + '                        G.GER_ESPDOC = R.GER_ESPDOC AND ';
    strSQL := strSQL + '                        G.GER_CODEMP = R.GER_CODEMP AND ';
    strSQL := strSQL + '                        G.GER_CODCLI = R.GER_CODCLI ';

    strSQL := strSQL + '  LEFT JOIN MOVOBS   ON (MOVOBS.MOV_SEQGER = G.AUTOINCREM) ';

    strSQL := strSQL + '  LEFT JOIN CADFIS ON FIS_NUMDOC = G.GER_NUMDOC ';
    strSQL := strSQL + '                  AND FIS_ESPDOC = G.GER_ESPDOC ';
    strSQL := strSQL + '                  AND FIS_CODEMP = G.GER_CODEMP ';
    strSQL := strSQL + '                  AND FIS_FORCLI = G.GER_CODCLI ';
    strSQL := strSQL + '                  AND FIS_TIP_FC = G.GER_TIP_FC ';

    strSQL := strSQL + '  LEFT JOIN NOTGER N ON N.GER_NUMDOC = R.GER_NUMDOC AND ';
    strSQL := strSQL + '                        N.GER_ESPDOC = R.GER_ESPDOC AND ';
    strSQL := strSQL + '                        N.GER_CODEMP = R.GER_CODEMP AND ';
    strSQL := strSQL + '                        N.GER_CODCLI = R.GER_CODCLI ';

    strSQL := strSQL + '  LEFT JOIN FATGOR PD ON PD.FGO_NUMDOC = R.GER_NUMDOC AND ';
    strSQL := strSQL + '                         PD.FGO_ESPDOC = R.GER_ESPDOC AND   ';
    strSQL := strSQL + '                         PD.FGO_CODEMP = R.GER_CODEMP AND   ';
    strSQL := strSQL + '                         PD.FGO_CODCLI = R.GER_CODCLI       ';

    strSQL := strSQL + ' LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = R.GER_CODVEN ';

    If (Pos(strOpcRom, '1_5_') <= 0) Then Begin
      strSQL := strSQL + '  LEFT JOIN MOVDET    ON MOVDET.DET_SEQGER = G.AUTOINCREM ';
      strSQL := strSQL + '  LEFT JOIN MOVTRI    ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
    End Else Begin
      strSQL := strSQL + '  LEFT JOIN FATDOR   ON FDO_SEQGER = PD.AUTOINCREM ';
      strSQL := strSQL + '  LEFT JOIN EXTDOR   ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
    End;

    strSQL := strSQL + '  LEFT JOIN OUTDIGX   ON R.GER_EMPROM = OUTDIGX.DIG_EMPROM AND ';
    strSQL := strSQL + '                         R.GER_NUMROM = OUTDIGX.DIG_NUMROM     ';
    strSQL := strSQL + '  LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
    strSQL := strSQL + '  LEFT JOIN CADCND CND ON CND.CND_CODIGO = R.GER_CODCND   ';

    {***************************************}
    {* OBTEM O ENDEREÇO DE ENTREGA ROMGERX *}
    {*************************************BL}
    strSQL := strSQL + 'LEFT JOIN CADCID CIDENT ON (R.GER_CIDENT = CIDENT.CID_CODCID) ';

    {**************************************}
    {* OBTEM O ENDEREÇO DE ENTREGA MOVGER *}
    {************************************FC}
    strSQL := strSQL + 'LEFT JOIN AUXMOV        ON (AUXMOV.AUX_SEQGER = G.AUTOINCREM) ';
    strSQL := strSQL + 'LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXMOV.AUX_ENTGER) ';
    strSQL := strSQL + 'LEFT JOIN CADCID CIDCLI ON (CIDCLI.CID_CODCID = ECMOV.ETC_CIDENT) ';
    strSQL := strSQL + 'LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = G.GER_CIDCON) ';
    strSQL := strSQL + 'LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

    {**************************************}
    {* OBTEM O ENDEREÇO DE ENTREGA NOTGER *}
    {************************************FC}
    strSQL := strSQL + 'LEFT JOIN AUXNOT         ON (AUXNOT.AUX_SEQGER  = N.AUTOINCREM) ';
    strSQL := strSQL + 'LEFT JOIN ENTCLI ECNOT   ON (ECNOT.AUTOINCREM   = AUXNOT.AUX_ENTGER) ';
    strSQL := strSQL + 'LEFT JOIN CADCID CIDCLIN ON (CIDCLIN.CID_CODCID = ECNOT.ETC_CIDENT) ';
    strSQL := strSQL + 'LEFT JOIN CADCID CIDNOT  ON (CIDNOT.CID_CODCID  = N.GER_CIDCON) ';
    strSQL := strSQL + 'LEFT JOIN CADTRA TRANOT  ON (ECNOT.ETC_CODTRA   = TRANOT.TRA_CODTRA) ';

    {**************************************}
    {* OBTEM O ENDEREÇO DE ENTREGA FATGOR *}
    {************************************FC}
    strSQL := strSQL + 'LEFT JOIN AUXGOR         ON (AUXGOR.AUX_SEQGER  = PD.AUTOINCREM) ';
    strSQL := strSQL + 'LEFT JOIN ENTCLI ECGOR   ON (ECGOR.AUTOINCREM   = AUXGOR.AUX_ENTGER) ';
    strSQL := strSQL + 'LEFT JOIN CADCID CIDCLIG ON (CIDCLIG.CID_CODCID = ECGOR.ETC_CIDENT) ';
    strSQL := strSQL + 'LEFT JOIN CADCID CIDGOR  ON (CIDGOR.CID_CODCID  = PD.FGO_CIDCON) ';
    strSQL := strSQL + 'LEFT JOIN CADTRA         ON (PD.FGO_CODTRA      = CADTRA.TRA_CODTRA) ';
    strSQL := strSQL + 'LEFT JOIN CADTRA TRAGOR  ON (ECGOR.ETC_CODTRA   = TRAGOR.TRA_CODTRA) ';
    strSQL := strSQL + 'LEFT JOIN EXTGOR         ON (PD.AUTOINCREM = EXTGOR.FGO_SEQFGO) ';

    strSQL := strSQL + 'LEFT JOIN ROMTRAX TRAORI ON (R.AUTOINCREM = TRAORI.TRA_SEQGER) ';
    strSQL := strSQL + 'LEFT JOIN ROMTRAX TRAFIL ON (R.GER_SEQTRA = TRAFIL.AUTOINCREM) ';

    strSQL := strSQL + 'LEFT JOIN CADREG ON (REG_CODREG = IF((ECMOV.ETC_CODREG IS NOT NULL OR ' +
                                                            ' ECNOT.ETC_CODREG IS NOT NULL OR ' +
                                                            ' ECGOR.ETC_CODREG IS NOT NULL),  ' +
                                                            '   COALESCE(ECMOV.ETC_CODREG,    ' +
                                                            '            ECNOT.ETC_CODREG,    ' +
                                                            '            ECGOR.ETC_CODREG),   ' +
                                                            '   CADCLI.CLI_CODREG))           ';
    strSQL := strSQL + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

    strSQL := strSQL + 'LEFT JOIN CADTRA TRADOC ON TRADOC.TRA_CODTRA = COALESCE(G.GER_CODTRA,        ' +
                                                                   '            N.GER_CODTRA,       ' +
                                                                   '            PD.FGO_CODTRA)       ';


    If fCfgSis('ROTROM', varString) = '2' Then
    begin
      strSQL := strSQL + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
      if fCfgSis('ROTEMP', varBoolean) then
        strSQL := strSQL + ' AND ENT_CODEMP = PD.FGO_CODEMP ';
    end;

    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  R.GER_NUMROM = :NUMROM AND ';
    strSQL := strSQL + '  R.GER_EMPROM = :EMPROM AND';
    strSQL := strSQL + '  R.GER_TIPDOC = "E" AND';
    strSQL := strSQL + '  IFNULL(EXTGOR.FGO_LOC_PD, "N") <> "S" AND ';
    strSQL := strSQL + '  IFNULL(EXTGOR.FGO_INTFUS, "N") <> "E" AND ';
    strSQL := strSQL + '  R.GER_ENTNOV = "N" ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSQL := strSQL + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (chkSomenteCliFil.Checked) Then
      strSQL := strSQL + '  AND R.GER_CODCLI IN ('+fRetClientesFilial+') ';

    {*************************************************************************}
    {* RETIREI AS CONDIÇÕES fStrLocate COM OS FILTROS QUE EXISTIAM AQUI POIS *}
    {* OS DOCUMENTOS JÁ EXISTENTES DENTRO DO ROMANEIO, SEMPRE DEVEM SER      *}
    {* EXIBIDOS NÃO IMPORTA O FILTRO REQ.: 85836                             *}
    {***********************************************************************VA}

    strSQL := strSQL + ' GROUP BY GER_DOCORI, GER_ESPDOC, GER_CODEMP, GER_CODCLI, GER_ENTSAI ';

    strSQL := strSQL + fRetornaWhereTurno();
    strSQL := strSQL + fGetWhereDocsExpedidos('R');

    With qryDados Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NUMROM').AsString := edtNumRom.Text;
      ParamByName('EMPROM').AsString := VS_strCodEmp;

      If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
        pSetaParam(edtCodRot.Text, arrRotReg, strRotas, 'CODROT', qryDados);

      Open;

      If not isEmpty Then
      Begin
        dtaDtaRomOri := FieldByName('GER_DTAROM').AsDateTime;
        dtaHorRomOri := FieldByName('GER_HORROM').AsDateTime;

        objRomFusTarefas.pClearDataSets;
        objRomFusTarefas.pLogAdd('ROMGERX', ['GER_NUMDOC', 'GER_ESPDOC', 'GER_CODEMP'],
            'GER_NUMROM = ' + QuotedStr(edtNumRom.Text) + ' AND GER_EMPROM = ' + QuotedStr(VS_strCodEmp) +
            ' AND EXISTS (SELECT R.AUTOINCREM FROM ROMGERX R WHERE R.GER_NUMROM = ROMGERX.GER_NUMROM ' +
            ' AND R.GER_EMPROM = ROMGERX.GER_EMPROM AND R.GER_INTFUS <> "N")');
      End;

      pCopiaParaTemporaria(qryDados, cdsTmpDoc, tpcTmpDoc, False);
      pMarcaDocDev(qryDados, cdsTmpDoc);
      Close;
    End;

    pTravaDocumentosRomaneio(pgbStatus);
    pTrataCasoRomaneiosAntigos;

    if blnUtilizaMultiVeiculosRomaneio then
    begin
