  strSQL := strSQL + '  CONCAT(G.GER_NUMDOC,  G.GER_ESPDOC, G.GER_CODEMP, G.GER_CODCLI)) AS GER_DOCUME, ';

  strSQL := strSQL + '  CAST((SELECT CAST(GROUP_CONCAT(DISTINCT FDO_NUMDOC, "-", FDO_ESPDOC) AS CHAR(255)) FROM FATDOR WHERE FDO_NUMFAT = R.GER_NUMDOC AND FDO_TIPFAT = R.GER_ESPDOC AND FDO_EMPFAT = R.GER_CODEMP)AS CHAR(255)) GER_PEDVEN, ';
  strSQL := strSQL + fSQLVolume('DET', 'R')  + ' AS GER_VOLUME, ';

  If (Pos(strOpcRom, '1_5_') <= 0) Then
  Begin
    strSQL := strSQL + fSQLProfissionalCodigo('DET')  + ' AS GER_CODDIV, ';
    strSQL := strSQL + fSQLProfissionalNome('DET')  + ' AS GER_NOMDIV, ';
