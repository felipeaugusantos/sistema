  strSQL := strSQL + '  IF('+fEnderecoPelaEntCli('','R')+',';
  strSQL := strSQL + '     COALESCE(ECMOV.ETC_ENDENT, ';
  strSQL := strSQL + '              ECNOT.ETC_ENDENT, ';
  strSQL := strSQL + '              ECGOR.ETC_ENDENT), ';
  strSQL := strSQL + '     COALESCE(G.GER_ENDCON, ';
  strSQL := strSQL + '              N.GER_ENDCON, ';
  strSQL := strSQL + '              PD.FGO_ENDCON,';
  strSQL := strSQL + '              OUTDIGX.DIG_ENDCON) ';
