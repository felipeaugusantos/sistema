procedure TfrmFatRomaneio.pSelecionaTodosDocCliente;
var
 intContador  : integer;
 strCodCliente: string;
begin
  blnExibiuAvisoDocto := False;
  strCodCliente := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;

  if (cdsTmpDoc.FieldByName('GER_MARDES').AsString <> 'M') and
     (fSelecionaDocumentosCliente(strCodCliente)) then
  begin
    cdsTmpDoc.First;

    for intContador := 0 to cdsTmpDoc.RecordCount - 1 do
    begin
      if (cdsTmpDoc.FieldByName('GER_CODCLI').AsString = strCodCliente) and
         (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'D') then
      begin
        pSelecionaDocumento;
        pGravaSelecionados;
      end;

      cdsTmpDoc.Next;
    end;
  end
  else
    pSelecionaDocumento;
end;

procedure TfrmFatRomaneio.pSelecionaDocumento(AValidaPodeMarcarDoc: Boolean = True);
Var
  intNumOrd  : Integer;
  intPosicao : Integer;
  intNovoOrd : Integer;
  prcScroll         : TprcScroll;
  blnWasEnabled     : Boolean;
  blnDeletaRegistro : Boolean;
  blnDesmarcarDocVariosVolumes : Boolean;
  blnEhDocVariosVolumes_NaoPodeMarcarManualmente : Boolean;
  LTotDet: Double;
begin

  If (Not cdsTmpDoc.Active) Or
     (cdsTmpDoc.IsEmpty)    Then
  Begin
    Exit;
  End;

  If AValidaPodeMarcarDoc and (Not fPodeMarcarDocumento(blnDeletaRegistro)) Then
  Begin
    If (blnDeletaRegistro) Then
      cdsTmpDoc.Delete;

    Exit;
  End;

  Try
    If (fEhRomaneioSimplificado) And (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger > 1) Then
    Begin

      blnDesmarcarDocVariosVolumes := True;

      If (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) Then
        blnDesmarcarDocVariosVolumes := (ControleVolumesBipados.fRetornaQtdVolumesBipados(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                                                          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                                                          cdsTmpDoc.FieldByName('GER_CODEMP').AsString) > 0);
      If blnDesmarcarDocVariosVolumes Then
        blnDesmarcarDocVariosVolumes := (cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger <> cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger) Or
                                        (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M');

      If blnDesmarcarDocVariosVolumes Then
      Begin

        If (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) Then
        Begin

          ControleVolumesBipados.pLimparVolumes;

          cdsTmpDoc.Edit;
          cdsTmpDoc.FieldByName('GER_VOLBIP').AsInteger := 0;
          cdsTmpDoc.Post;

        End;

        pDestravaDocumento(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                           cdsTmpDoc.FieldByName('GER_NROROM').AsString,
                           cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                           cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                           cdsTmpDoc.FieldByName('GER_ENTSAI').AsString);
      End;

    End;

    If (Pos(cdsTmpDoc.FieldByName('GER_MARDES').AsString, 'MP') > 0) Then
    Begin

      cdsTmpDoc.Edit;

      if blnUtilizaMultiVeiculosRomaneio then
      begin
        cdsTmpDoc.FieldByName('GER_VEICUL').AsString := fValorMovimentaVeiculo(fFormataFloat(cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat, 2), cdsTmpDoc.FieldByName('GER_VEICUL').AsString, False);
      end;

      cdsTmpDoc.FieldByName('GER_PALET_').AsString := '';
      cdsTmpDoc.FieldByName('GER_MARDES').AsString := 'D';
      pOnMarcaDesmarcaDocumento;

      fltTotSel := fltTotSel - fFormataFloat(cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat, 2);
      fltTotSelPro := fltTotSelPro - fFormataFloat(cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat, 2);

      cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat := 0;
      cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat := 0;

      If (fltTotSel < 0.0) Then
        fltTotSel := 0.0;

      if (fltTotSelPro < 0.0) then
        fltTotSelPro := 0.0;

      intQtdSel := intQtdSel - 1;   
      If (intQtdSel < 0) Then
        intQtdSel := 0;

      intPosicao := cdsTmpDoc.RecNo;
      intNumOrd := cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger;
      cdsTmpDoc.FieldByName('GER_ORDIMP').AsString := '';

      cdsTmpDoc.Post;

      If fCfgSis('ROTROM', varString) = '2' Then
        pSetaStatusRota(cdsTmpDoc.FieldByName('GER_CODROT').AsString);

      blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);

      cdsTmpDoc.First;

      While Not cdsTmpDoc.Eof Do
      Begin
        If cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M' Then
        Begin
          If cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger > intNumOrd Then
          Begin
            cdsTmpDoc.Edit;
            cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger := cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger - 1;
            cdsTmpDoc.Post;
          End;
        End;

        cdsTmpDoc.Next;
      End;

      if ( intOrdImp > 0 ) then
        intOrdImp := intOrdImp - 1;

      cdsTmpDoc.RecNo := intPosicao;

      If blnWasEnabled Then
        pEnableControls(cdsTmpDoc, prcScroll);

      pDeletaDadosRomDet;
      pDeletaDadosRestauracao;

      pDestravaDocumento(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                         cdsTmpDoc.FieldByName('GER_NROROM').AsString,
                         cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                         cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                         cdsTmpDoc.FieldByName('GER_ENTSAI').AsString);

    End
    Else
    Begin

      blnEhDocVariosVolumes_NaoPodeMarcarManualmente := (fEhRomaneioSimplificado) And
                                                        (fUsaModeloOuFoiIdentificadoBipagemEtiquetaDespacho) And
                                                        (cdsTmpDoc.FieldByName('GER_VOLUME').AsInteger > 1);

      If blnEhDocVariosVolumes_NaoPodeMarcarManualmente Then
        blnEhDocVariosVolumes_NaoPodeMarcarManualmente := (ControleVolumesBipados.fRetornaQtdVolumesBipados(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                                                                                                            cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                                                                                                            cdsTmpDoc.FieldByName('GER_CODEMP').AsString) = 0);
      If blnEhDocVariosVolumes_NaoPodeMarcarManualmente Then
        Exit;

      if fVerificaOSItemReserv then
        Exit;

      cdsTmpDoc.Edit;

      if blnUtilizaMultiVeiculosRomaneio then
      begin
        cdsTmpDoc.FieldByName('GER_VEICUL').AsString := fValorMovimentaVeiculo(fFormataFloat(cdsTmpDoc.FieldByName('GER_VALDOC').AsFloat, 2), '', True);
        if (fEmptyStr(cdsTmpDoc.FieldByName('GER_VEICUL').AsString)) and (intContVeiculo > 1) then
        Begin
          if not Assigned(objPanelSelecionado) then
            fMensagem('ATENÇÃO!', 'Selecione um veículo!', ['&Ok']);

          cdsTmpDoc.Cancel;
          pDestravaDocumento(cdsTmpDoc.FieldByName('GER_NOMTBL').AsString,
                             cdsTmpDoc.FieldByName('GER_NROROM').AsString,
                             cdsTmpDoc.FieldByName('GER_NUMDOC').AsString,
                             cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                             cdsTmpDoc.FieldByName('GER_ENTSAI').AsString);
          Exit;
        End;
      end;
      cdsTmpDoc.FieldByName('GER_MARDES').AsString := 'M';
      pOnMarcaDesmarcaDocumento;

      if (cdsTmpDoc.State <> dsEdit) then
        cdsTmpDoc.Edit;

      cdsTmpDoc.FieldByName('GER_PALET_').AsString := fPedeLocalMercadoriaPalet;
      cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat := cdsTmpDoc.FieldByName('GER_VLRPRO').AsFloat;

      if (cdsTmpDoc.FieldByName('GER_TOTDET').DataType = ftString) then
        LTotDet := StrToFloatDef(cdsTmpDoc.FieldByName('GER_TOTDET').AsString, 0)
      else
        LTotDet := cdsTmpDoc.FieldByName('GER_TOTDET').AsFloat;

      If LTotDet <= 0 Then
        cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat := cdsTmpDoc.FieldByName('GER_VALDOC').AsFloat
      Else
        cdsTmpDoc.FieldByName('GER_VALSEL').AsFloat := LTotDet;

      if ( intOrdImp = 0 ) then
      begin
        intNovoOrd := fVerificaSegurancaOrdImp;

        if ( intNovoOrd > 0 ) then
          intOrdImp := intNovoOrd + 1
        else
          intOrdImp := 1;
      end
      else
        intOrdImp := intOrdImp + 1;

      if ( cdsTmpDoc.State <> dsEdit ) then
        cdsTmpDoc.Edit;

      cdsTmpDoc.FieldByName('GER_ORDIMP').AsInteger := intOrdImp;

      fltTotSel := fltTotSel + fFormataFloat(cdsTmpDoc.FieldByName('GER_VALDOC').AsFloat, 2);
      fltTotSelPro := fltTotSelPro + fFormataFloat(cdsTmpDoc.FieldByName('GER_VSEPRO').AsFloat, 2);
      cdsTmpDoc.Post;

      If fCfgSis('ROTROM', varString) = '2' Then
        pSetaStatusRota(cdsTmpDoc.FieldByName('GER_CODROT').AsString);

      If (cdsTmpDoc.FieldByName('GER_ALTERA').AsString <> 'S') Then
        pAdicionaDadosRomDet;

      intQtdSel := intQtdSel + 1;

      pGravaDadosRestauracao;

      If fCfgSis('UTDTFE', VarBoolean) And fCfgSis('EXIDTE', VarBoolean) Then
        If Not fEmptyStr(fMsgFaixasHorariosEntregaCliente(cdsTmpDoc.FieldByName('GER_CODCLI').AsString)) Then
          untFuncoesSimples.pMensagemSonora(fMsgFaixasHorariosEntregaCliente(cdsTmpDoc.FieldByName('GER_CODCLI').AsString), False, 13);
    End;

    edtDocSelec.Text := IntToStr(intQtdSel);

    fltTotSel := fFormataFloat(fltTotSel, 2);
    edtTotSel.Text := FloatToStrF(fltTotSel, ffFixed, 12, 2);

    fltTotSelPro := fFormataFloat(fltTotSelPro, 2);
    edtTotProdSel.Text := FloatToStrF(fltTotSelPro, ffFixed, 12, 2);

    if blnUtilizaMultiVeiculosRomaneio then
      edtTotPesSel.Text := fPesoBrutoSelecionado(varString, True)
    else
      edtTotPesSel.Text := fPesoBrutoSelecionado(varString);

    pExibirPreviaDeRomaneio(fltTotSel);
    pCalculaTotaisDocumentosVolumes;

  Finally

  End;
end;

procedure TfrmFatRomaneio.pCalculaPesoValorVeiculo(strNumVeiculo: string;
  var fltPeso, fltValor: Double);
var
  cdsTmp: TUniClientDataSet;
begin
  fltPeso := 0;
  fltValor := 0;

  cdsTmp := TUniClientDataSet.Create(Self);
  try
    pCloneDataSet(cdsTmp, cdsTmpDoc);

    fltPeso := fPesoBrutoSelecionado(varDouble, False, strNumVeiculo);

    cdsTmp.Filter   := '(GER_MARDES = ' + QuotedStr('M') + ' OR GER_MARDES = ' + QuotedStr('P') + ')';
    cdsTmp.Filter   := cdsTmp.Filter + ' AND (GER_VEICUL = ' + QuotedStr(strNumVeiculo) + ')';
    cdsTmp.Filtered := True;

    cdsTmp.First;
    while not cdsTmp.Eof do
    begin
      fltValor := fltValor + cdsTmp.FieldByName('GER_VALSEL').AsFloat ;

      cdsTmp.Next;
    end;
  finally
    FreeAndNil(cdsTmp);
  end;
end;

procedure TfrmFatRomaneio.pCalculaTotaisDocumentosVolumes;
Var
  cdsTmp    : TUniClientDataSet;
  intTotDoc : Integer;
  intTotVol : Integer;
begin

  If Not Assigned(cdsTmpDoc) then
    Exit;

  If Not cdsTmpDoc.Active Then
    Exit;

  If cdsTmpDoc.IsEmpty Then
    Exit;

  If Not fEhRomaneioSimplificado Then
    Exit;

  intTotDoc := 0;
  intTotVol := 0;

  cdsTmp := TUniClientDataSet.Create(Self);

  Try

    pCloneDataSet(cdsTmp, cdsTmpDoc);

    With cdsTmp Do
    Begin
      First;
      While Not Eof Do
      Begin
        If (FieldByName('GER_MARDES').AsString = 'M') Then
        Begin
          Inc(intTotDoc);
          intTotVol := intTotVol + FieldByName('GER_VOLUME').AsInteger;
        End;
        Next;
      End;
    End;

    edtTotDoc.Text := intTotDoc.ToString();
    edtTotVol.Text := intTotVol.ToString();

  Finally
    FreeAndNil(cdsTmp);
  End;

end;

procedure TfrmFatRomaneio.pCalculaTotal;
var
  fltTotGer,
  fltTotPro,
  fltTotPes: Real;
  cdsTmp   : TUniClientDataSet;
begin
  fltTotGer := 0;
  fltTotPro := 0;
  fltTotPes := 0;

  cdsTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsTmp, cdsTmpDoc);

  cdsTmp.Filtered := False;
  cdsTmp.Filter   := '';

  cdsTmp.First;

  while not cdsTmp.Eof do
  begin
    fltTotGer := fltTotGer + cdsTmp.FieldByName('GER_VLRCON').AsFloat;
    fltTotPro := fltTotPro + cdsTmp.FieldByName('GER_VLRPRO').AsFloat;
    fltTotPes := fltTotPes + cdsTmp.FieldByName('GER_PESBRU').AsFloat;

    cdsTmp.Next;
  end;

  edtTotGer.Text     := FloatToStrF(fltTotGer, ffFixed, 12, 2);
  edtTotProd.Text := FloatToStrF(fltTotPro, ffFixed, 12, 2);
  edtTotPes.Text     := FloatToStrF(fltTotPes, ffFixed, 12, 2);
  edtDocsTot.Text    := IntToStr(cdsTmp.RecordCount);

  cdsTmp.Filter   := 'GER_MARDES = '+QuotedStr('M');
  cdsTmp.Filtered := True;

  fltTotGer := 0;
  fltTotSelPro := 0;

  cdsTmp.First;

  while not cdsTmp.Eof do
  begin
    fltTotGer := fltTotGer + cdsTmp.FieldByName('GER_VLRCON').AsFloat;
    fltTotSelPro := fltTotSelPro + cdsTmp.FieldByName('GER_VLRPRO').AsFloat;

    cdsTmp.Next;
  end;

  intQtdSel := cdsTmp.RecordCount;
  edtDocSelec.Text := IntToStr(intQtdSel);
  fltTotSel := fltTotGer;
  edtTotSel.Text := FloatToStrF(fltTotSel, ffFixed, 12, 2);
  edtTotProdSel.Text := FloatToStrF(fltTotSelPro, ffFixed, 12, 2);

  if blnUtilizaMultiVeiculosRomaneio then
    edtTotPesSel.Text := fPesoBrutoSelecionado(varString, True)
  else
    edtTotPesSel.Text := fPesoBrutoSelecionado;

  pCalculaTotaisDocumentosVolumes;

  FreeAndNil(cdsTmp);
end;

procedure TfrmFatRomaneio.pCancelaInclusao(blnMosMsg: Boolean; blnCloseDataSet: Boolean = True);
begin
  If (blnMosMsg) And (fMensagem('ATENÇÃO!', 'Deseja realmente cancelar a inclusão?', ['&S I M', '&N Ã O'], 2) = 2) Then
    Exit;

  edtNumRom.Clear;
  edtCodCid.Clear;
  edtNomCid.Clear;
  edtCodVen.Clear;
  edtNomVen.Clear;
  edtLinGru.Clear;
  edtCodReg.Clear;
  edtCodDep.Clear;
  edtNomReg.Clear;
  edtCodLot.Clear;
  edtDesLot.Clear;

  edtCodRot.Clear;
  edtCodTra.Clear;
  edtDesTra.Clear;
  edtTraFat.Clear;
  edtNomTraFat.Clear;

  edtCodCliente.Clear;
  edtDesCliente.Clear;
  edtCodProduto.Clear;
  edtDesProduto.Clear;

  edtCodBar.Clear;

  strDocCaixa      :=  '';
  strDocCaixaTrans :=  '';

  dtaDtaRomOri := 0;
  dtaHorRomOri := 0;

  FIdRestauracao := '';
  pDeletaTemporaria;

  {***************************************************************************}
  {* FOI ADICIONADO ESSA BOLEANA PARA VER SE FECHA O DATASET OU NÃO POIS     *}
  {* ACONTECIA ACCESS VIOLATION EXPORADICAMENTE AO FINALIZAR UM ROMANEIO.    *}
  {* NOS OUTROS LUGARES FORAM DEIXADOS POIS SE NÃO FECHAR O SISTEMA MOSTRA   *}
  {* AS INFORMAÇÕES ERRADAS. FIZ DESSA MANEIRA POIS NÃO ACHEI OUTRA SOLUÇÃO. *}
  {* SE HOUVER POR FAVOR IMPLEMENTAR E AVISAR POR FAVOR.                     *}
  {************************************************************************FC*}
  If blnCloseDataSet And cdsTmpDoc.Active Then
  Begin
    {**********************************************************************}
    {* O MOTIVO DO ACCESS VIOLATION É QUE ESTAVA FECHANDO O CLIENT COM OS *}
    {* CONTROLES DESABILITADOS, PORTANTO HABILITO ANTES DE FECHAR         *}
    {*******************************************************************RN*}
    If (cdsTmpDoc.ControlsDisabled) Then
      cdsTmpDoc.EnableControls;

    cdsTmpDoc.Close;
  End;

  TFrmGravando.fExecutarModal(pDestravaTodasAsTravas, 'Aguarde... Desbloqueando Documentos!', '');

  btnReimprimeRomaneio.Visible  := False;
  btnReimprimeDocumento.Visible := False;
  btnLimpaSeparacao.Visible     := False;
  btnPreviaRomaneio.Visible     := False;

  btnVisualizarItensDocumentos.Visible := False;

  pHabilitaNumRom(True);
  pSetFocus(edtNumRom);
  pLimpaCamposObservacao;
  StlBkpDocs.Clear();
  StlDocsEdit.Clear();
  pLimpaVeículos;

  SetLength(arrFusion, 0);
  FstrIntFus := 'N';

  if Assigned(objRomFusTarefas) then
    objRomFusTarefas.pClearDataSets;

  ControleVolumesBipados.pLimparVolumes;
  FillChar(recTranporte, SizeOf(recTranporte), #0);
end;

procedure TfrmFatRomaneio.pCarregaDadosFusion(var strIntFus, strRomFus,
  strLatLon: String; strNumDoc, strEspDoc, strCodEmp: String);
var
  fusion: TFusion;
begin
  strIntFus := 'N';
  strRomFus := '';

  if (not fCfgSis('FUSUSA', varBoolean)) then
    Exit;

  for fusion in arrFusion do
  begin
    if (fusion.strNumDoc = strNumDoc) and
       (fusion.strEspDoc = strEspDoc) and
       (fusion.strCodEmp = strCodEmp) then
    begin
      strIntFus := fusion.strIntFus;
      strRomFus := fusion.strRomFus;
      strLatLon := IIF(fusion.strIntFus <> 'N', fusion.strLatLon, '');

      Exit;
    end;
  end;
end;

procedure TfrmFatRomaneio.pCarregaObsRom;
Var
  qryTmp : TUniQuery;
Begin

  {Habilitado por padrão}
  blnDadosAdicionaisNF    := True;
  blnObservacoesExpedicao := True;
  blnObservacoes          := True;
  blnFeriados             := False;
  blnOrientacoes          := False;

  Try

    qryTmp := fCriaQuery;

    qryTmp.Close;
    qryTmp.SQL.Clear;
    qryTmp.SQL.Add('SELECT * FROM OBSROM         ');
    qryTmp.SQL.Add(' WHERE ROM_TIPROM = :TIPROM  ');
    qryTmp.SQL.Add('   AND ROM_CODEMP = :CODEMP  ');
    qryTmp.ParamByName('TIPROM').AsString := fCfgSis('OPCROM', varString);
    qryTmp.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryTmp.Open;

    If Not qryTmp.IsEmpty Then
    Begin

      qryTmp.First;
      While Not qryTmp.Eof Do
      Begin

        Case TTipoObservacoes(qryTmp.FieldByName('ROM_TIPOBS').AsInteger) Of
          tpoDadosAdicionaisNF    : blnDadosAdicionaisNF    := (qryTmp.FieldByName('ROM_MOSTRA').AsString = 'S');
          tpoObservacoesExpedicao : blnObservacoesExpedicao := (qryTmp.FieldByName('ROM_MOSTRA').AsString = 'S');
          tpoObservacoes          : blnObservacoes          := (qryTmp.FieldByName('ROM_MOSTRA').AsString = 'S');
          tpoFeriados             : blnFeriados             := (qryTmp.FieldByName('ROM_MOSTRA').AsString = 'S');
          tpoOrientacoes          : blnOrientacoes          := (qryTmp.FieldByName('ROM_MOSTRA').AsString = 'S');
        End;

        qryTmp.Next;

      End;

    End;

  Finally
    FreeAndNil(qryTmp);
  End;

end;

procedure TfrmFatRomaneio.pAtualizaCamposRomaneioCNF(ATmpTbl, ANumRom: String);
var
  LSQL: String;
  LQry: TUniQuery;
begin
  LQry := fCriaQuery;

  try
    LSQL := '';
    LSQL := LSQL + 'UPDATE NOTGER G ';
    LSQL := LSQL + 'SET ';
    LSQL := LSQL + '  G.GER_DTAROM = ' + fCurrentDate + ', ';
    LSQL := LSQL + '  G.GER_HORROM = ' + fCurrentTime + ', ';
    LSQL := LSQL + '  G.GER_OPEROM = :OPEROM, ';
    LSQL := LSQL + '  G.GER_NUMROM = :NUMROM, ';
    LSQL := LSQL + '  G.GER_EMPROM = :EMPROM, ';
    LSQL := LSQL + '  G.GER_PRVIMP = "N" ';
    LSQL := LSQL + 'WHERE ';
    LSQL := LSQL + '  G.AUTOINCREM IN (' + fListaAutIncGer(ATmpTbl, 'NOTGER') + ') AND ';
    LSQL := LSQL + '  (SELECT ';
    LSQL := LSQL + '    FORMAT(SUM(IFNULL(D.DET_QTDROM, 0)), 4) ';
    LSQL := LSQL + '   FROM ';
    LSQL := LSQL + '     NOTDET D ';
    LSQL := LSQL + '   WHERE ';
    LSQL := LSQL + '    ' + fRetCondicaoCFOP('D.DET_CLAFIS') + ' AND ';
    LSQL := LSQL + '    IF(D.DET_ESPDOC = "EP", TRUE, RIGHT(D.DET_CLAFIS, 3) <> "999") AND  ';

    If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
      LSQL := LSQL + '    D.DET_PROEMB <> "S" AND ';

    LSQL := LSQL + '    D.DET_SEQGER = G.AUTOINCREM) ';
    LSQL := LSQL + '     ';
    LSQL := LSQL + '   = ';
    LSQL := LSQL + '     ';
    LSQL := LSQL + ' FORMAT( ';
    LSQL := LSQL + '        (SELECT ';
    LSQL := LSQL + '          SUM(D.DET_QTDITE) ';
    LSQL := LSQL + '         FROM ';
    LSQL := LSQL + '          NOTDET D ';
    LSQL := LSQL + '         WHERE ';
    LSQL := LSQL + '          ' + fRetCondicaoCFOP('D.DET_CLAFIS') + ' AND ';
    LSQL := LSQL + '          IF(D.DET_ESPDOC = "EP", TRUE, RIGHT(D.DET_CLAFIS, 3) <> "999") AND  ';

    If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
      LSQL := LSQL + '        D.DET_PROEMB <> "S" AND ';

    LSQL := LSQL + '          D.DET_SEQGER = G.AUTOINCREM), 4) ';

    LQry.SQL.Add(LSQL);
    LQry.ParamByName('OPEROM').AsString := strLoginUsuarioLogado;
    LQry.ParamByName('NUMROM').AsString := ANumRom;
    LQry.ParamByName('EMPROM').AsString := VS_strCodEmp;
    LQry.ExecSQL;
  finally
    FreeAndNil(LQry);
  end;
end;

