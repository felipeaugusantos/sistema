procedure TfrmFatRomaneio.pMarcaDocDev(qryTmp: TUniQuery; cdsTmp: TUniClientDataSet);
var
  qryAux: TUniQuery;
Begin

  if (fCfgSis('DEVROM', VarString) <> '1') And (Pos(strOpcRom, '1_5_') <= 0) then
  begin
    qryAux := fCriaQuery(Self);
    Try
      With qryTmp do
      begin
        DisableControls;
        first;
        While not eof do
        begin
          If (FieldByName('GER_ORIDOC').AsString = 'D') Then
          begin
            qryAux.Close;
            qryAux.SQL.Clear;
            qryAux.SQL.Add('SELECT CONCAT(DET_DOCDEV , "-", DET_ESPDEV ) AS RESULTADO');
            qryAux.SQL.Add('FROM MOVDET                                              ');
            qryAux.SQL.Add('WHERE DET_NUMDOC = :NUMDOC                               ');
            qryAux.SQL.Add('  AND DET_ESPDOC = :ESPDOC                               ');
            qryAux.SQL.Add('  AND DET_CODEMP = :CODEMP                               ');
            qryAux.SQL.Add('  AND DET_DOCDEV IS NOT NULL                             ');
            qryAux.ParamByName('NUMDOC').AsString := FieldByName('GER_DOCORI').AsString ;
            qryAux.ParamByName('ESPDOC').AsString := FieldByName('GER_ESPDOC').AsString ;
            qryAux.ParamByName('CODEMP').AsString := FieldByName('GER_CODEMP').AsString ;
            qryAux.Open;

            While not qryAux.eof do
            Begin
              if cdsTmp.Locate('GER_NUMDOC', qryAux.FieldByName('RESULTADO').AsString, []) then
              begin
                cdsTmp.Edit;
                cdsTmp.FieldByName('GER_ORIDEV').AsString := 'S';
                cdsTmp.Post;
              end;

              qryAux.Next;
            end;
          end;

          next;
        end;
        EnableControls;
      end;
    Finally
      FreeAndNil(qryAux);
    end;
  end;

End;

procedure TfrmFatRomaneio.pMarcaImpressaoOrdemProducaoTinta(strNumDoc,
  strEspDoc, strCodEmp, strCodCli, strCodAca, strEmpAca: string);
var
  qryTinta: TUniQuery;
  strSQL: string;
begin
  strSQL := EmptyStr;
  qryTinta := fCriaQuery;

  try
    if Pos(strEspDoc, 'PD_OR_') > 0 then
    begin
      strSQL := strSQL + ' UPDATE TINDOR ' + sLineBreak;
      strSQL := strSQL + ' SET FDO_ORDIMP = TRUE ' + sLineBreak;
      strSQL := strSQL + ' WHERE FDO_NUMDOC = :NUMDOC ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_ESPDOC = :ESPDOC ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_CODEMP = :CODEMP ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_CODCLI = :CODCLI ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_CODACA = :CODACA ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_EMPACA = :EMPACA ';
    end
    else
    begin
      strSQL := strSQL + ' UPDATE TINDET ' + sLineBreak;
      strSQL := strSQL + ' SET DET_ORDIMP = TRUE ' + sLineBreak;
      strSQL := strSQL + ' WHERE DET_NUMDOC = :NUMDOC ' + sLineBreak;
      strSQL := strSQL + ' AND DET_ESPDOC = :ESPDOC ' + sLineBreak;
      strSQL := strSQL + ' AND DET_CODEMP = :CODEMP ' + sLineBreak;
      strSQL := strSQL + ' AND DET_CODCLI = :CODCLI ' + sLineBreak;
      strSQL := strSQL + ' AND DET_CODACA = :CODACA ' + sLineBreak;
      strSQL := strSQL + ' AND DET_EMPACA = :EMPACA ';
    end;

    qryTinta.Close;
    qryTinta.SQL.Clear;
    qryTinta.SQL.Add(strSQL);
    qryTinta.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTinta.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTinta.ParamByName('CODEMP').AsString := strCodEmp;
    qryTinta.ParamByName('CODCLI').AsString := strCodCli;
    qryTinta.ParamByName('CODACA').AsString := strCodAca;
    qryTinta.ParamByName('EMPACA').AsString := strEmpAca;
    qryTinta.ExecSQL;
  finally
    FreeAndNil(qryTinta);
  end;
end;

procedure TfrmFatRomaneio.pMarcaPreviaImpressa;
  Var
    strPosQry: TBookMark;
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  strPosQry := cdsTmpDoc.Bookmark;
  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  Try
    With cdsTmpDoc Do
    Begin
      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);

      First;
      While Not Eof Do
      Begin
        If (Pos(FieldByName('GER_MARDES').AsString, 'PM') > 0) And
           (FieldByName('GER_ORIDOC').AsString <> 'D') And
           ((strOpcRom <> '3') Or (Pos(FieldByName('GER_ESPDOC').AsString, 'TR_BR') = 0)) Then
        Begin
          Edit;
          FieldByName('GER_PRVIMP').AsString := 'S';
          Post;

          pMarcaRomImp(FieldByName('GER_DOCORI').AsString,
                       FieldByName('GER_ESPDOC').AsString,
                       FieldByName('GER_CODEMP').AsString,
                       FieldByName('GER_TIP_FC').AsString,
                       True);// Marcar prévia impressa
        End;

        Next;
      End;
    End;
  Finally
    cdsTmpDoc.Bookmark := strPosQry;

    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;
end;

procedure TfrmFatRomaneio.pMarcarNotaChaveAcessoCodigoBarra(strTextoPesquisa : String;
                                                            blnOcultarMSG    : Boolean = False;
                                                            blnEmitirSom     : Boolean = True);
Var
  prcScroll: TprcScroll;
  blnEncontrouChave :Boolean;
  blnAlterar :Boolean;
  blnMarcado :Boolean;
  blnPermitirPesquisarTexto: Boolean;
  blnPermitirMarcarDocumento: Boolean;
begin
  blnMarcado                := False;
  blnEncontrouChave         := False;
  blnPermitirPesquisarTexto := (length(strTextoPesquisa) = 44) Or
                               (length(strTextoPesquisa) = 18);

  If blnPermitirPesquisarTexto Then
  begin
    pDisableControls(cdsTmpDoc, prcScroll);

    with cdsTmpDoc do
    begin
      First;

      while not Eof do
      Begin
        blnPermitirMarcarDocumento := False;

        If (length(strTextoPesquisa) = 44) Then
        Begin
          If (fCfgSis('OPCROM',varString) <> '1') And
             (FieldByName('FIS_ACESSO').AsString = strTextoPesquisa) Then
            blnPermitirMarcarDocumento := True;

          If (FieldByName('GER_NOMTBL').AsString = 'MOVGER') And
             (fCfgSis('OPCROM',varString) = '1') And
             (FieldByName('FIS_ACESSO').AsString = strTextoPesquisa) Then
            blnPermitirMarcarDocumento := True;
        End
        Else If (length(strTextoPesquisa) = 18) Then
        Begin
          If (FieldByName('BARDOC').AsString = strTextoPesquisa) Then
            blnPermitirMarcarDocumento := True;
        End;

        If blnPermitirMarcarDocumento Then
        Begin
          blnEncontrouChave := True;

          blnMarcado := (FieldByName('GER_MARDES').AsString = 'M');

          If blnMarcado then
            Break;

          blnAlterar := (FieldByName('GER_MARDES').AsString = 'D');

          If blnAlterar Then
          Begin
            pSelecionaDocumento;
            pGravaSelecionados;
          End;

          If (blnEmitirSom) Then
            pMensagemSonora('', msSucesso);

          Break;
        End;

        Next;
      End;
    end;

    pEnableControls(cdsTmpDoc, prcScroll);
  End;

  If (not blnEncontrouChave) And (strTextoPesquisa <> '#27') And (Not blnOcultarMSG) Then
  begin
    pMensagemSonora('O documento informado não foi encontrado na lista.'+#13+
                    'Verifique a informação e tente novamente', msErro);
  end;

  If blnEncontrouChave And blnMarcado And (Not blnOcultarMSG) Then
  begin
    pMensagemSonora('Chave de acesso já incluida no romaneio', msErro);
  end;
end;

procedure TfrmFatRomaneio.pMarcarNota_Documento_(strNumDoc,
                                                 strEspDoc,
                                                 strCodEmp     : String;
                                                 blnOcultarMSG : Boolean = False;
                                                 blnEmitirSom  : Boolean = True);
Var
  prcScroll         : TprcScroll;
  blnEncontrouChave : Boolean;
  blnAlterar        : Boolean;
  blnMarcado        : Boolean;
begin

  blnMarcado        := False;
  blnEncontrouChave := False;

  If strNumDoc.IsEmpty Then
    Exit;

  If strEspDoc.IsEmpty Then
    Exit;

  If strCodEmp.IsEmpty Then
    Exit;

  pDisableControls(cdsTmpDoc, prcScroll);

  with cdsTmpDoc do
  begin
    First;

    while not Eof do
    Begin

      If (FieldByName('GER_NUMDOC').AsString = strNumDoc+'-'+strEspDoc) And
         (FieldByName('GER_CODEMP').AsString = strCodEmp) Then
      Begin
        blnEncontrouChave := True;

        blnMarcado := (FieldByName('GER_MARDES').AsString = 'M');

        If blnMarcado then
          Break;

        blnAlterar := (FieldByName('GER_MARDES').AsString = 'D');

        If blnAlterar Then
          pSelecionaDocumento;

        If (blnEmitirSom) Then
          pMensagemSonora('', msSucesso);

        Break;
      End;

      Next;
    End;
  end;

  pEnableControls(cdsTmpDoc, prcScroll);

  If (not blnEncontrouChave) And (strNumDoc <> '') And (Not blnOcultarMSG) Then
  begin
    pMensagemSonora('O documento informado não foi encontrado na lista.'+#13+
                    'Verifique a informação e tente novamente', msErro);
  end;

  If blnEncontrouChave And blnMarcado And (Not blnOcultarMSG) Then
  begin
    pMensagemSonora('Documento já incluido no romaneio', msErro);
  end;

end;

procedure TfrmFatRomaneio.imgVeiculoClick(Sender: TObject);
var
  objPai: TWinControl;
begin
  objPai := TImage(Sender).Parent;
  TPanel(objPai).OnClick(objPai);
end;

procedure TfrmFatRomaneio.imgVeiculoDragDrop(Sender, Source: TObject; X,
  Y: Integer);
var
  objPai: TWinControl;
  intIndiceVeiculo: integer;
begin
  objPai := TImage(Sender).Parent;
  TPanel(objPai).OnClick(objPai);
  if Source.ClassName = 'TcxDragControlObject' then
  begin
    intIndiceVeiculo := StrtoInt(Copy(TPanel(objPai).Name, Pos('_', TPanel(objPai).Name) + 1, 1));

    if (arrVeiculos[Pred(intIndiceVeiculo)].strNumVeic = '') then
    begin
      fMensagem('ATENÇÃO!', 'As informações do veículo devem ser preenchidas!', ['&Ok']);
      Exit;
    end;

    TPanel(objPai).Color := COR_SEL_VEICULO;
    cdsTmpDoc.RecNo := intRegistroVeiculo;
    if (fEmptyStr(cdsTmpDoc.FieldByName('GER_VEICUL').AsString)) then
    begin
      if (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'P') then
        pSelecionaDocumentoParcialVeiculo
      else
        pSelecionaDocumento;
    end
    else if (cdsTmpDoc.FieldByName('GER_VEICUL').AsString <> IntToStr(intIndiceVeiculo)) then
    begin
      if (fMensagem('', 'O documento selecionado está vinculado a outro veículo. ' + #13#10 +
                       'Deseja mudar o documento para esse veículo?', ['&Não','&Sim']) = 2) then
      begin
        cdsTmpDoc.Edit;
        cdsTmpDoc.FieldByName('GER_VEICUL').AsString := IntToStr(intIndiceVeiculo);
        cdsTmpDoc.Post;

        pAtualizaPainelVeiculos;
      end;
    end
    else
    begin
      pMensagemOk('Este documento já foi separado em um veículo!');
    end;
    objPanelSelecionado := TPanel(Sender);
    dbgDocumentos.Invalidate;
    Application.ProcessMessages;
  end;
end;

procedure TfrmFatRomaneio.imgVeiculoDragOver(Sender, Source: TObject; X,
  Y: Integer; State: TDragState; var Accept: Boolean);
begin
  if Source.ClassName = 'TcxDragControlObject' then
  begin
    Accept := True;
  end;
end;

procedure TfrmFatRomaneio.pnlVeiculoClick(Sender: TObject);
var
  objPai: TWinControl;
  intIndice: integer;
begin
  objPanelSelecionado := nil;

  if TPanel(Sender).Color = COR_SEL_VEICULO then
  begin
    TPanel(Sender).Color := $00FFE4D5;
  end
  else if (TPanel(Sender).Color = $00FFE4D5) or (TPanel(Sender).Color = 15854306) then
  begin
    objPai := TPanel(Sender).Parent;
    for intIndice := 0 to objPai.ControlCount - 1 do
    begin
      if objPai.Controls[intIndice] is TPanel then
      begin
        TPanel(objPai.Controls[intIndice]).Color := $00FFE4D5;
      end;
    end;
    TPanel(Sender).Color := COR_SEL_VEICULO;
    objPanelSelecionado := TPanel(Sender);
  end;
  dbgDocumentos.Invalidate;
  Application.ProcessMessages;
end;

procedure TfrmFatRomaneio.pPesoMovimentaVeiculo(fltPeso: Double;
  strVeiculo: string);
var
  intIndicePai,
  intIndiceFilho,
  intIndiceVeic: integer;
  objPai: TPanel;
  objFilho: TLabel;
  strNumVeic: string;
begin
  for intIndicePai := 0 to flwpnlVeiculo.ControlCount - 1 do
  begin
    if (flwpnlVeiculo.Controls[intIndicePai] is TPanel) and (TPanel(flwpnlVeiculo.Controls[intIndicePai]).Name = 'pnlVeiculo_'+strVeiculo) then
    begin
      objPai := TPanel(flwpnlVeiculo.Controls[intIndicePai]);
      strNumVeic := Copy(TPanel(objPai).Name, Pos('_', TPanel(objPai).Name) + 1, 1);

      if strNumVeic <> strVeiculo then
      Begin
        Exit;
      End;

      for intIndiceFilho := 0 to objPai.ControlCount - 1 do
      begin
        if (objPai.Controls[intIndiceFilho] is TLabel) and (TLabel(objPai.Controls[intIndiceFilho]).Name = 'lblPesoDesc_'+strNumVeic) then
        begin
          for intIndiceVeic := Low(arrVeiculos) to High(arrVeiculos) do
          begin
            if (arrVeiculos[intIndiceVeic].blnTemRom) and (arrVeiculos[intIndiceVeic].strNumVeic = strNumVeic) then
            Begin
              objFilho := TLabel(objPai.Controls[intIndiceFilho]);
              TLabel(objFilho).Caption := FloatToStrF(StrToFloatDef(TLabel(objFilho).Caption,0) + fltPeso, ffFixed, 12, 4);
              arrVeiculos[intIndiceVeic].fltPeso := arrVeiculos[intIndiceVeic].fltPeso + fltPeso;
            End;
          end;
        end;
      end;
    end;
  end;
end;

function TfrmFatRomaneio.ValidarDireitoDeAcessoAlteracao : Boolean;
Var
  qryConGen : TUniQuery;
begin
  Result := false;

  Try
    qryConGen := fCriaQuery;
    qryConGen.Close;
    qryConGen.SQL.Text :=  'SELECT GER_CODEMP,  '+
                           '        GER_NUMROM, '+
                           '        GER_DTAROM, '+
                           '        GER_STATUS  '+
                           '   FROM ROMGERX     '+
                           '   WHERE GER_NUMROM = :CODROM'+
                           '    AND  GER_EMPROM = :CODEMP ';
    qryConGen.ParamByName('CODROM').AsString := edtNumRom.Text;
    qryConGen.ParamByName('CODEMP').AsString := VS_strCodEmp;
    qryConGen.Open;

    if Not qryConGen.IsEmpty then
    begin
      objLiberacao.Clear;
      objLiberacao.strDirAce    := 'ALTROM';
      objLiberacao.strMsgSen    := 'Alteração de Romaneio'+#13+
                                   'Nº Romaneio:'+ qryConGen.FieldByName('GER_NUMROM').AsString +#13+
                                   'Empresa:'+ qryConGen.FieldByName('GER_CODEMP').AsString +#13+
                                   'Data do Romaneio:' + qryConGen.FieldByName('GER_DTAROM').AsString +#13+
                                   'Status:'+ IfThen(qryConGen.FieldByName('GER_STATUS').AsString = 'A','ATIVADO','PENDENTE PARA ATIVAÇÃO');

      objLiberacao.blnManterCompatibilidadeSenCfg := Not fEmptyStr(fCfgSis('SENROM'));
      objLiberacao.strSenLib    := fCfgSis('SENROM');
      objLiberacao.strCodOpe    := strLoginUsuarioLogado;
      objLiberacao.objMsgLibera.pAddTexto(objLiberacao.strMsgSen );

      Result := objLiberacao.fLibera;
    end;
  Finally
    If Assigned(qryConGen)Then
      FreeAndNil(qryConGen);
  End;
end;

procedure TfrmFatRomaneio.pRemoverRestauracao;
Var
  Lqry: TUniQuery;
begin
  if fEmptyStr(FIdRestauracao) then
    Exit;

  Try
    Lqry := fCriaQuery(Nil);

    with Lqry, SQL do
    begin
      Close;
      Clear;
      Add('DELETE FROM ROMGER_RES WHERE GER_CODGER = :CODGER');
      ParamByName('CODGER').AsString := FIdRestauracao;
      ExecSql;
    end;

    FIdRestauracao := '';
  Finally
    FreeAndNil(Lqry);
  End;
end;

