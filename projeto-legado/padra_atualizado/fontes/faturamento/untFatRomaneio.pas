function TfrmFatRomaneio.fRetObsRegiao(strCodReg: String): String;
Var
  qryAux : TUniQuery;
begin

  Try
    qryAux := fCriaQuery;

    With qryAux Do
    Begin

      Close;
      SQL.Clear;
      SQL.Add('SELECT REG_OBSERV FROM CADREG WHERE REG_CODREG = :CODREG');
      ParamByName('CODREG').AsString := strCodReg;
      Open;

      If Not IsEmpty Then
        Result := FieldByName('REG_OBSERV').AsString;

    End;

  Finally
    FreeAndNil(qryAux);
  End;

end;

function TfrmFatRomaneio.fRetOperadorSolicitante: String;
begin
  Result := '';
  While fEmptyStr(Result) Do
  Begin

    If (Not ffrmSenha(Result, 'Operador Solicitante')) Then
    Begin
      Exit;
    End;

    Result := fRetCodVendedor(Result);

    If fEmptyStr(Result) Then
    Begin
      fMensagem('', 'Operador não cadastrado.', ['&Ok']);
    End;

  End;
end;

