    strSelect := strSelect + fDocumentoRemovidoNaoConferidoVolume('MOVGER', 'GER');

    strSelect := strSelect + ' GROUP BY MOVTRI.DET_SEQGER ';

    strSelect := strSelect + fRetornaWhereTurno();
    strSelect := strSelect + fGetWhereDocsExpedidos('MOVGER');

  End;

  //UNION COM A MOVDET PARA RETORNAR OS REGISTROS COM ESPDOC = TR QUE SEJAM DE MOVIMENTAÇÃO DE SAÍDA ...
  If fEntraTR_BR_Romaneio Then
  Begin
    strSelect := strSelect + ' UNION ALL ';
    strSelect := strSelect + fSQLTrocasSaida(strOpcRom);
  End;

  Result := strSQLGer + ' UNION ALL ' + strSelect;

  pExibirPreviaDeRomaneio(fltTotSel);
end;

procedure TfrmFatRomaneio.pAtualizaSeqGerCdsRomDet(strNumRom,
  strCodEmp: String);
  Var
    cdsTmp : TUniClientDataSet;
begin
  cdsTmp := TUniClientDataSet.Create(Self);
  pCloneDataSet(cdsTmp, cdsTmpDoc);

  cdsRomDet.Filtered := False;
  cdsRomDet.Filter   :=                    '(DET_NUMROM = ' + QuotedStr(strNumRom) + ') AND ';
  cdsRomDet.Filter   := cdsRomDet.Filter + '(DET_EMPROM = ' + QuotedStr(strCodEmp) + ')';
  cdsRomDet.Filtered := True;

  With cdsRomDet Do
  Begin
    First;
    While Not Eof Do
    Begin

      cdsTmp.Filtered := False;
      cdsTmp.Filter   :=                 '(GER_DOCORI = ' + QuotedStr(FieldByName('DET_NUMDOC').AsString) + ') AND ';
      cdsTmp.Filter   := cdsTmp.Filter + '(GER_ESPDOC = ' + QuotedStr(FieldByName('DET_ESPDOC').AsString) + ') AND ';
      cdsTmp.Filter   := cdsTmp.Filter + '(GER_CODEMP = ' + QuotedStr(FieldByName('DET_CODEMP').AsString) + ') AND ';
      cdsTmp.Filter   := cdsTmp.Filter + '(GER_ENTSAI = ' + QuotedStr(FieldByName('DET_ENTSAI').AsString) + ') AND ';
      cdsTmp.Filter   := cdsTmp.Filter + '(GER_TIP_FC = ' + QuotedStr('C') + ') AND ';
      cdsTmp.Filter   := cdsTmp.Filter + '(GER_MARDES = ' + QuotedStr('M') + ') ';
      cdsTmp.Filtered := True;

      If cdsTmp.RecordCount > 0 Then
      Begin
        Edit;
        FieldByName('DET_SEQGER').AsString := cdsTmp.FieldByName('INCREMENTO').AsString;
        Post;
      End;

      Next;
    End;
  End;

  cdsRomDet.Filtered := False;
  cdsRomDet.Filter   := '';

  FreeAndNil(cdsTmp);
end;

