  strSQL := strSQL + ', CAST("" AS CHAR(10)) AS CLI_FANSOB ';
  strSQL := strSQL + ', CAST("" AS CHAR(10)) AS CLI_ORIENT ';
  strSQL := strSQL + ', CAST("" AS CHAR(10)) AS CAC_CORILP ';
  strSQL := strSQL + ', CAST("" AS CHAR(10)) AS CNDDESCRICAO ';

  strSQL := strSQL + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQL := strSQL + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQL := strSQL + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQL := strSQL + ', CAST(" " AS CHAR(4)) AS DET_CLAFIS ';
  strSQL := strSQL + ', CAST(" " AS CHAR(18)) AS BARDOC ';

  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQL := strSQL + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQL := strSQL + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQL := strSQL + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQL := strSQL + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQL := strSQL + '   FROM OUTDIGX ';
  strSQL := strSQL + '     LEFT JOIN CADREG  ON REG_CODREG = DIG_CODREG ';

  // ** DEPARTAMENTO VENDEDOR **
  strSQL := strSQL + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = OUTDIGX.DIG_CODVEN ';
  strSQL := strSQL + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSQL := strSQL + '   WHERE TRUE ';

  strSQL := strSQL + ' AND OUTDIGX.DIG_TIPDOC = "E" ';

  If (blnFiltraDocumento) Then
  Begin
    strSQL := strSQL + '     AND OUTDIGX.DIG_NUMDOC = :NUMDOC ';
    strSQL := strSQL + '     AND OUTDIGX.DIG_CODEMP = :CODEMP ';
  End
  Else
  Begin
    strSQL := strSQL + '     AND OUTDIGX.DIG_NUMROM IS NULL ';

    strSQL := strSQL + '     AND (' + fRetSQLFiltroEmpresas('OUTDIGX.DIG_CODEMP') + ') ';

    strSQL := strSQL + fStrLocate(edtCodReg,arrRegiao,'OUTDIGX.DIG_CODREG', 'CODREG');
    strSQL := strSQL + fStrLocate(edtCodVen,arrVended,'OUTDIGX.DIG_CODVEN', 'CODVEN');
    strSQL := strSQL + fStrLocate(edtCodDep,arrDepVen,'DEP_CODIGO', 'CODDEP');

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSQL := strSQL + '   AND OUTDIGX.' + IIF(rdbEntrega.Checked, 'DIG_DTAETR', 'DIG_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN ';
  End;

  Result := strSQL;
end;

function TfrmFatRomaneio.fSQLProfissionalCodigo(strPrefixo: String): String;
begin
  Result := ' ' + strPrefixo + '_CODDIV ';
end;

function TfrmFatRomaneio.fSQLProfissionalNome(strPrefixo: String): String;
begin
  Result := '(SELECT DIV_NOMDIV FROM CADDIV WHERE DIV_CODDIV = ' + fSQLProfissionalCodigo(strPrefixo) + ')';
end;

function TfrmFatRomaneio.fSQLTE: String;
  Var
    strSelect : String;
begin
  strSelect := '';
  strSelect := strSelect + 'SELECT SQL_NO_CACHE ';
  strSelect := strSelect + fRetSQLDocRetornadoRomaneio('GER') + ' AS GER_RETROM, ';
  strSelect := strSelect + '  GER_CONPAG   AS GER_CONPAG, ';
  strSelect := strSelect + '  GER_CODFPG   AS GER_CODFPG, ';
  strSelect := strSelect + '  " "          AS GER_TIPOPE, ';
  strSelect := strSelect + '  " "          AS GER_FPGNEG, ';
  strSelect := strSelect + '  "N"          AS GER_ORIF11, ';
  strSelect := strSelect + '  0.00         AS GER_TOTBRI, ';
  strSelect := strSelect + '  0.00         AS GER_VALREC, ';
  strSelect := strSelect + '  0.00         AS GER_BOLADT, ';
  strSelect := strSelect + '  "N"          AS GER_BOLVEN, ';
  strSelect := strSelect + '  0.00         AS GER_VALADT, ';
  strSelect := strSelect + '  GER_VLRCON   AS GER_CONORI, ';
  strSelect := strSelect + '  GER_DTAENT, ';
  strSelect := strSelect + '  GER_HORENT, ';
  strSelect := strSelect + '  GER_DTENTR, ';
  strSelect := strSelect + '  CONCAT( GER_NUMDOC, "-", GER_ESPDOC ), ';
  strSelect := strSelect + '  GER_NUMDOC, ';
  strSelect := strSelect + '  GER_ESPDOC, ';
  strSelect := strSelect + '  GER_CODEMP, ';
  strSelect := strSelect + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSelect := strSelect + '  GER_CODCLI, ';
  strSelect := strSelect + '  IF( GER_NOMCON IS NULL, CLI_NOMCLI, GER_NOMCON), ';
  strSelect := strSelect + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSelect := strSelect + '  GER_CLAFIS, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSelect := strSelect + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDGER.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSelect := strSelect + '  GER_TIPFRE, ';

