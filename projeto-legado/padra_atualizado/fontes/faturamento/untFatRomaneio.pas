procedure TfrmFatRomaneio.dbgDocumentosDBViewMouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  inherited;
  if (not cdsTmpDoc.IsEmpty) and (Button = mbLeft) then
  Begin
