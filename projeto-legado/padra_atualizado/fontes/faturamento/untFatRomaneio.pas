  strSQL := strSQL + '    CAST(0.0000 AS DECIMAL(15, 4)) AS GER_TOTDET, ';
  strSQL := strSQL + '    DIG_NUMROM  AS GER_NROROM, ';

  If (strOpcRom = '4') Then
