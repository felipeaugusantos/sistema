      strSelect := strSelect + '    AND DET_FAT.DET_ESP_PD = FATDOR.FDO_ESPDOC';
      strSelect := strSelect + '    AND DET_FAT.DET_EMP_PD = FATDOR.FDO_CODEMP';
      strSelect := strSelect + '    AND DET_FAT.DET_CODCLI = FATDOR.FDO_CODCLI';
      strSelect := strSelect + '    ) AS DOC_FATURADOS,';
