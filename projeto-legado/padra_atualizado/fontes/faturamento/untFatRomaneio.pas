{ TfrmFatRomaneio }


function TfrmFatRomaneio.fValidaCampos(Sender: TWinControl;
  blnBuscaPorChave: Boolean): Boolean;
begin
  Result := True;

  If (Sender = edtNumRom) Then
  Begin
    btnReimprimeRomaneio.Visible := False;
    If (Not fEmptyStr(edtNumRom.Text)) Then
    Begin

      If Not blnDirAlt Then
      Begin
        edtNumRom.Clear;
        fMensagem('ATENÇÃO!', 'Alteração não permitida!', ['&Ok']);
        Result := False;
      End

      Else If (Not fRomaneioExiste(edtNumRom.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse romaneio não está cadastrado!', ['&Ok']);
        Result := False;
      End

      Else If (fRomaneioBaixado(edtNumRom.Text, torRomaneioInclusao)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse romaneio já está baixado!', ['&Ok']);
        edtNumRom.Clear;        
        Result := False;
      End

      Else If (blnUsaPreRom) And (fRomaneioAtivo(edtNumRom.Text)) Then
      Begin
        fMensagem('ATENÇÃO!', 'Esse romaneio já foi ativado!' + #13 +
                              'Alteração não permitida.', ['&Ok']);
        edtNumRom.Clear;
        Result := False;
      End

      Else
      Begin
        {**************************************************************}
        {* QUANDO UTILIZAR PRÉ-ROMANEIO, A IMPRESSÃO DO ROMANEIO SERÁ *}
        {* FEITA SOMENTE NA ATIVAÇÃO DO MESMO (untFatAtivaPreRomaneio *}
        {***********************************************************MM*}
        If Not blnUsaPreRom Then
        Begin


          If (Not blnLiberado) And (Result) Then
          Begin

             blnLiberado := ValidarDireitoDeAcessoAlteracao;

            If (blnLiberado) Then
            Begin
              If (blnUtilizaMultiVeiculosRomaneio) Then
              Begin
                btnReimprimeRomaneio.Visible := False;
              End
              Else
              Begin
                btnReimprimeRomaneio.Visible := fVerificaAcessoSistema('IMPROM');
              End;
            End
            Else
              Result := False;
          End
          Else
          Begin
            If (blnUtilizaMultiVeiculosRomaneio) Then
            Begin
              btnReimprimeRomaneio.Visible := False;
            End
            Else
            Begin
              btnReimprimeRomaneio.Visible := fVerificaAcessoSistema('IMPROM');
            End;
          End;

          If (fCfgSis('LIBROM', varBoolean)) Then
          Begin
            If (blnUtilizaMultiVeiculosRomaneio) Then
            Begin
              btnReimprimeRomaneio.Visible := False;
            End
            Else
            Begin
              btnReimprimeRomaneio.Visible := False;
            End;
          End;

        End;
      End;

    End Else
    Begin

      If Not blnDirInc Then
      Begin
        edtNumRom.Clear;
        fMensagem('ATENÇÃO!', 'Inclusão não permitida!', ['&Ok']);
        Result := False;
      End;

    End;

  End

  Else If (Sender = mskDtaIni) Then
  Begin

    If (fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      mskDtaFin.Enabled := False
    Else
      mskDtaFin.Enabled := True;

  End

  Else If (Sender = mskDtaFin) Then
  Begin

    If Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text)) Then
    Begin
      If (fEmptyStr(fTiraCaracEspeciais(mskDtaFin.Text))) Then
      Begin
        fMensagem('', 'O campo Data Final deve ser preenchido!', ['&O k']);
        Result := False;
      End
      Else
      Begin
        If StrToDate(mskDtaIni.Text) > StrToDate(mskDtaFin.Text) Then
        Begin
          fMensagem('','A Data Inicial deve ser menor que a Data Final!',['&O K']);
          Result := False;
        End;
      End;
    End;

  End

  Else If Sender = edtCodEmp Then
  Begin
    If Not fEmptyStr(edtCodEmp.Text) And (Length(arrEmpres) <= 1) Then
    Begin
      If Pos(edtCodEmp.Text, strAceRom) <= 0 Then
      Begin
        fMensagem('','Usuário sem permissão de acesso à empresa!',['&O K']);
        Result := False;
      End;
    End;
  End

  Else If (Sender = edtCodDep) Then
    pDesmarcaLista(edtCodDep, arrDepVen)

  Else If (Sender = edtCodTra) Then
    pDesmarcaLista(edtCodTra, arrTransp)

  Else If (Sender = edtTraFat) Then
    pDesmarcaLista(edtTraFat, arrTraFat)

  Else If (Sender = edtCodRot) Then
    pDesmarcaLista(edtCodRot, arrRotReg)

  Else If (Sender = edtCodLot) Then
  Begin
    If not fEmptyStr(edtCodLot.Text) Then
    Begin
      edtDesLot.Text := fCampoTabela('IF(COUNT(RLG_NUMLOT) > 0, RLG_DESLOT, "EMPTY") ', 'ROMLGE', ['RLG_NUMLOT', 'RLG_CODEMP'], [edtCodLot.Text, VS_strCodEmp]);
      If edtDesLot.Text = 'EMPTY' Then
      Begin
        edtDesLot.Clear;
        fMensagem('ATENÇÃO!', 'Esse lote de separação para romaneio não está cadastrado!', ['&Ok']);
        Result := False;
      End;
    End
    Else
      edtDesLot.Text := 'TODOS';
  End;

  btnRomaneioPorVolumes.Enabled := fEmptyStr(edtNumRom.Text);

  If (Not Result) Then
    pSetFocus(Sender);
end;

function TfrmFatRomaneio.fVerificaGerouRomaneioOrfao: Boolean;
var
  LQry: TUniQuery;
begin
  if (FListaAutIncRom.Count = 0) then
    Exit(False);

  LQry := fCriaQuery;

  try
    LQry.SQL.Add('SELECT COUNT(1) QTD ');
    LQry.SQL.Add('FROM ROMGERX R ');
    LQry.SQL.Add('WHERE NOT EXISTS (SELECT DET_SEQGER FROM ROMDETX WHERE DET_SEQGER = R.AUTOINCREM) ');
    LQry.SQL.Add('  AND AUTOINCREM IN (' + fCommaText(FListaAutIncRom, True) + ') ');
    LQry.Open;

    Result := (LQry.FieldByName('QTD').AsInteger > 0);
  finally
    FreeAndNil(LQry);
  end;
end;

function TfrmFatRomaneio.fVerificaOSItemReserv: Boolean;
var
  strNumOse  : String;
  intCont    : Integer;
  stlItensOS : TStringList;
  arrMensagem: TStringArray;
begin
  Result := False;

  if fCfgSis('OPCROM') <> '1' then
    Exit;

  stlItensOS := TStringList.Create;

  try
    if (fOSItensNaoReservados(cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
                              cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
                              cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
                              '',
                              strNumOse,
                              stlItensOS)) then
    begin
      Result := True;
      SetLength(arrMensagem, 0);

      pAddDados(arrMensagem, fPadR('|Cód.Item|Descrição', 57) + '|');
      pAddDados(arrMensagem, fPadR('-', 58, '-'));

      for intCont := 0 to Pred(stlItensOS.Count) do
      begin
        pAddDados(arrMensagem, '|' + fPadR(Copy(stlItensOS[intCont], 1, 56), 56) + '|');
