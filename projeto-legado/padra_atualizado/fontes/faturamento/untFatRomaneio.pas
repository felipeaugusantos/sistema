  strSQLDV := strSQLDV + ', "N" AS DELETA_DEVOLUCAO ';

  strSQLDV := strSQLDV + ', CAST(" " AS CHAR(20)) AS ROMTRA ';
  strSQLDV := strSQLDV + ', CAST(" " AS CHAR(3)) AS TRA_EMPDES ';

  if fCfgSis('MATDIS', varBoolean) then
  begin
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(30)) AS GER_LOCALI ';
    strSQLDV := strSQLDV + ', 0.00 AS GER_DISTAN ';
    strSQLDV := strSQLDV + ', 0.00 AS GER_TMPENT ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSQLDV := strSQLDV + ', 0 AS PRIORIDADE ';
    strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_LIBAPP ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQLDV := strSQLDV + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQLDV := strSQLDV + ', CADCLI.CLI_CODRED ';
  strSQLDV := strSQLDV + ', CADCLI.CLI_CODCAC ';
  strSQLDV := strSQLDV + ', CADCLI.CLI_FANSOB ';
  strSQLDV := strSQLDV + ', CADCLI.CLI_ORIENT ';
  strSQLDV := strSQLDV + ', CAC.CAC_CORILP ';
  strSQLDV := strSQLDV + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSQLDV := strSQLDV + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQLDV := strSQLDV + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQLDV := strSQLDV + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQLDV := strSQLDV + ', MOVDET.DET_CLAFIS ';
  strSQLDV := strSQLDV + ',  ' + fSQLBarDoc('GER') + ' AS BARDOC ';

  strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQLDV := strSQLDV + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQLDV := strSQLDV + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQLDV := strSQLDV + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQLDV := strSQLDV + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQLDV := strSQLDV + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQLDV := strSQLDV + 'FROM ';
  strSQLDV := strSQLDV + '  MOVDET ';
  strSQLDV := strSQLDV + '  INNER JOIN MOVGER   ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';

  If (Pos(strOpcRom, '1_5_') <= 0) Then Begin
    strSQLDV := strSQLDV + '     LEFT JOIN MOVTRI    ON MOVTRI.DET_SEQGER = MOVDET.AUTOINCREM ';
  End Else Begin
    strSQLDV := strSQLDV + '     LEFT JOIN EXTDOR   ON FATDOR.AUTOINCREM = EXTDOR.FDO_SEQFDO ';
  End;

  strSQLDV := strSQLDV + '  INNER JOIN CADCLI   ON GER_CODCLI        = CLI_CODCLI ';
  strSQLDV := strSQLDV + '  INNER JOIN CADCID   ON CADCID.CID_CODCID = IF(GER_CIDCON IS NULL,CLI_CODCID,GER_CIDCON) ';
  strSQLDV := strSQLDV + '  INNER JOIN CADITE I ON I.ITE_CODITE      = DET_CODITE ';
  strSQLDV := strSQLDV + '   LEFT JOIN CADTRA   ON GER_CODTRA        = CADTRA.TRA_CODTRA ';
  strSQLDV := strSQLDV + '   LEFT JOIN CADFPG   ON GER_CODFPG        = FPG_CODIGO ';

  strSQLDV := strSQLDV + '  LEFT JOIN CADFIS  ON FIS_NUMDOC = GER_NUMDOC ';
  strSQLDV := strSQLDV + '                   AND FIS_ESPDOC = GER_ESPDOC ';
  strSQLDV := strSQLDV + '                   AND FIS_CODEMP = GER_CODEMP ';
  strSQLDV := strSQLDV + '                   AND FIS_FORCLI = GER_CODCLI ';
  strSQLDV := strSQLDV + '                   AND FIS_TIP_FC = GER_TIP_FC ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA MOVGER *}
  {************************************FC}
  strSQLDV := strSQLDV + 'LEFT JOIN AUXMOV        ON (AUXMOV.AUX_SEQGER = MOVGER.AUTOINCREM) ';
  strSQLDV := strSQLDV + 'LEFT JOIN MOVOBS        ON (MOVOBS.MOV_SEQGER = MOVGER.AUTOINCREM) ';
  strSQLDV := strSQLDV + 'LEFT JOIN ENTCLI ECMOV  ON (ECMOV.AUTOINCREM  = AUXMOV.AUX_ENTGER) ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADCID CIDGER ON (CIDGER.CID_CODCID = ECMOV.ETC_CIDENT)  ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADTRA TRAMOV ON (ECMOV.ETC_CODTRA  = TRAMOV.TRA_CODTRA) ';

  // ** CADREG REGIAO **
  strSQLDV := strSQLDV + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECMOV.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECMOV.ETC_CODREG) ) ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  // ** DEPARTAMENTO VENDEDOR **
  strSQLDV := strSQLDV + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = MOVGER.GER_CODVEN ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSQLDV := strSQLDV + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSQLDV := strSQLDV + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = MOVGER.GER_CODCND   ';

  {*****************************************************************}
  {* CARREGA AS DEVOLUÇÕES QUE ORIGINARAM DE UM PEDIDO DE RETIRADA *}
  {**************************************************************PZ*}
  strSQLDV := strSQLDV + 'LEFT JOIN FATGOR ON FGO_ESPDOC = "PR"       AND ';
  strSQLDV := strSQLDV + '                    FGO_NUMFAT = GER_NUMDOC AND ';
  strSQLDV := strSQLDV + '                    FGO_TIPFAT = GER_ESPDOC AND ';
  strSQLDV := strSQLDV + '                    FGO_EMPFAT = GER_CODEMP     ';
  strSQLDV := strSQLDV + 'LEFT JOIN EXTGOR ON EXTGOR.FGO_SEQFGO = FATGOR.AUTOINCREM ';

  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSQLDV := strSQLDV + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSQLDV := strSQLDV + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;
  strSQLDV := strSQLDV + 'WHERE ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
    Begin
      strSQLDV := strSQLDV + '  FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSQLDV := strSQLDV + '      GER_NUMDOC = :NUMDOC ';
      strSQLDV := strSQLDV + '  AND GER_ESPDOC = :ESPDOC ';
      strSQLDV := strSQLDV + '  AND GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin

    strSQLDV := strSQLDV + '      GER_ENTFUT = "N" ';
    strSQLDV := strSQLDV + '  AND GER_ENTFAT = "S" ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSQLDV := strSQLDV + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Not fEmptyStr(edtNumRom.Text)) Then
      strSQLDV := strSQLDV + '  AND ((GER_NUMROM IS NULL) OR (GER_NUMROM = '+QuotedStr(edtNumRom.Text)+')) '
    Else
      strSQLDV := strSQLDV + '  AND GER_NUMROM IS NULL ';

    If (Pos(strOpcRom, '1_5_') <= 0) Then
      strSQLDV := strSQLDV + ' AND IFNULL(DET_CODEXT,"") = "" ';

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSQLDV := strSQLDV + ' AND ' + IIF(rdbEntrega.Checked, 'GER_DTENTR', 'GER_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
    Else
      strSQLDV := strSQLDV + ' AND GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

    If (chkSomenteCliFil.Checked) Then
      strSQLDV := strSQLDV + ' AND GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSQLDV := strSQLDV + fStrLocate(edtCodCid    , arrCidade  , 'IF(GER_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), GER_CIDCON)','CODCID');
    strSQLDV := strSQLDV + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", GER_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
    strSQLDV := strSQLDV + fStrLocate(edtTraFat    , arrTraFat  , 'GER_CODTRA', 'TRAFAT');
    strSQLDV := strSQLDV + fStrLocate(edtCodReg    , arrRegiao  , 'ECMOV.ETC_CODREG', 'CODREG');
    strSQLDV := strSQLDV + fStrLocate(edtCodVen    , arrVended  , 'GER_CODVEN', 'CODVEN');
    strSQLDV := strSQLDV + fStrLocate(edtCodDep    , arrDepVen  , 'DEP_CODIGO', 'CODDEP');
    strSQLDV := strSQLDV + fStrLocate(edtCodCliente, arrClientes, 'GER_CODCLI', 'CODCLI');
    strSQLDV := strSQLDV + fStrLocate(edtCodProduto, arrProdutos, 'DET_CODITE', 'CODITE');
    strSQLDV := strSQLDV + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    {*****************************************}
    {* FILTRO DE LINHA E GRUPO               *}
    {**************************************MV*}
    strSQLDV := strSQLDV + fSQLFiltroLinGru('DET');

    if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
    Begin
      strSQLDV := strSQLDV + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
      strSQLDV := strSQLDV + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
      strSQLDV := strSQLDV + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
      strSQLDV := strSQLDV + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
      strSQLDV := strSQLDV + '                AND RLD_NUMDOC = DET_NUM_PD                        ';
      strSQLDV := strSQLDV + '                AND RLD_ESPDOC = DET_ESP_PD                        ';
      strSQLDV := strSQLDV + '                AND RLD_CODEMP = DET_EMP_PD )                      ';
    End;

  End;

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSQLDV := strSQLDV + '  AND NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSQLDV := strSQLDV + '                   FROM ROMGERX GERX ';
    strSQLDV := strSQLDV + '                  INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSQLDV := strSQLDV + '                  WHERE GERX.GER_CODEMP = MOVGER.GER_CODEMP ';
    strSQLDV := strSQLDV + '                    AND GERX.GER_NUMDOC = MOVGER.GER_NUMDOC ';
    strSQLDV := strSQLDV + '                    AND GERX.GER_ESPDOC = MOVGER.GER_ESPDOC ';
    strSQLDV := strSQLDV + '  ) ';
  End;

  If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
    strSQLDV := strSQLDV + '  AND DET_PROEMB <> "S" ';

  If fCfgSis('CLBUEF',varboolean) Then
    strSQLDV := strSQLDV + '  AND DET_CLIBUS = "N" ';

  strSQLDV := strSQLDV + '  AND (LOCATE(DET_CLAFIS, "'+CLASSIFICACOES_DEVOLUCAO+'") OR ((DET_ESPDOC IN ("DV","TR")) AND (LEFT(DET_CLAFIS, 1) <= 2))) ';
  strSQLDV := strSQLDV + '  AND IF( GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) = CADCID.CID_CODCID ';

  if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) then
  begin
    strSQLDV := strSQLDV + ' AND (' + fRetSQLFiltroEmpresas('DET_EMP_PD') + ') ';
    strSQLDV := strSQLDV + ' AND GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';
  end
  else
    strSQLDV := strSQLDV + ' AND (' + fRetSQLFiltroEmpresas('GER_CODEMP') + ') ';

  strSQLDV := strSQLDV + fDocumentoRemovidoNaoConferidoVolume('MOVGER', 'GER');

  strSQLDV := strSQLDV + ' AND DET_CODITE <> :ITESER AND DET_CODITE <> :SERTER ';

  strSQLDV := strSQLDV + ' GROUP BY MOVDET.DET_SEQGER ';
  strSQLDV := strSQLDV + fRetornaWhereTurno();

  Result := strSQLDV;

end;

