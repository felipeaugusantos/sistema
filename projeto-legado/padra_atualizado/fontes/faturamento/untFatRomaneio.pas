function TfrmFatRomaneio.fSelecionaDocumentosRota(cxProgressBar: TcxProgressBar=NIL): Boolean;
  Var
    prcScroll: TprcScroll;
    blnMarcarTodos: Boolean;
    blnWasEnabled: Boolean;
    strCodRot: String;
    strAutInc: String;

    strFiltro: String;
    blnFiltrado: Boolean;
begin
  Result := True;

  blnDocumentosRotaEmSelecao := True;

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  If blnWasEnabled Then
    pDisableControls(cdsTmpDoc, prcScroll);

  strCodRot := cdsMaster.FieldByName('GER_CODROT').AsString;

  cdsMaster.Edit;
  cdsMaster.FieldByName('GER_MARDES').AsString := IIF(cdsMaster.FieldByName('GER_MARDES').AsString='M','D','M');
  cdsMaster.Post;

  blnMarcarTodos := cdsMaster.FieldByName('GER_MARDES').AsString = 'M';

  strFiltro  := cdsTmpDoc.Filter;
  blnFiltrado:= cdsTmpDoc.Filtered;

  cdsTmpDoc.OnFilterRecord := Nil;

  cdsTmpDoc.Filtered := False;
  cdsTmpDoc.Filter   := 'GER_CODROT = ' + QuotedStr(strCodRot);
  cdsTmpDoc.Filtered := True;
  cdsTmpDoc.First;
  Try
    While Not cdsTmpDoc.Eof Do
    Begin
      If fEmptyStr(strAutInc) Then
        strAutInc := cdsTmpDoc.FieldByName('GER_AUTINC').AsString;

      If ((blnMarcarTodos) And (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'D')) Or
         ((Not blnMarcarTodos) And (cdsTmpDoc.FieldByName('GER_MARDES').AsString = 'M')) Then
        pSelecionandoDocumento(False);

      cdsTmpDoc.Next;
    End;


  Finally
    cdsTmpDoc.OnFilterRecord := pFilterRecord;

    cdsTmpDoc.Filter   := strFiltro;
    cdsTmpDoc.Filtered := blnFiltrado;

    cdsMaster.Locate('GER_CODROT', strCodRot, []);
    cdsTmpDoc.Locate('GER_AUTINC', strAutInc, []);

    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);

    blnDocumentosRotaEmSelecao := False;
  End;
end;

function TfrmFatRomaneio.fRetornaInformacoesRota(blnVazio: Boolean=False): String;
begin
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    If (blnVazio) Or (Not Assigned(cdsMaster)) Then
    Begin
      Result :=           ' "'+ID_COD_SEM_ROTA+'" AS GER_CODROT, ';
      Result := Result +  ' "'+ID_COD_ROTA_SEM_REGIAO+'" AS ENT_CODREG, ';
    End
    else
    begin
      Result :=          ' IFNULL(EXTGOR.FGO_CODROT, "'+ID_COD_SEM_ROTA+'") AS GER_CODROT, ';
      Result := Result + ' IFNULL(ENTREG.ENT_CODREG, "'+ID_COD_ROTA_SEM_REGIAO+'") AS ENT_CODREG, ';
    end;
  end;
end;

