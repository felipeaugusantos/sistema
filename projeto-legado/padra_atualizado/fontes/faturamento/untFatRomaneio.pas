  strSQLDV := strSQLDV + '  FGO_CODCLI AS GER_CODCLI, ';
  strSQLDV := strSQLDV + '  IF( FGO_NOMCON IS NULL, CLI_NOMCLI, FGO_NOMCON), ';
  strSQLDV := strSQLDV + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSQLDV := strSQLDV + '  CAST(" " AS CHAR(4)) AS GER_CLAFIS, ';

  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', CIDGER.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', CIDGER.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', CIDGER.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSQLDV := strSQLDV + '  FGO_TIPFRE AS GER_TIPFRE, ';

  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', ECMOV.ETC_BAIENT, COALESCE(FGO_BAICON, CADCLI.CLI_BAIRRO)) AS GER_BAIRRO, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', ECMOV.ETC_ENDENT, COALESCE(FGO_ENDCON, CADCLI.CLI_ENDERE)) AS GER_ENDCON, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', ECMOV.ETC_LATLON, " ") AS GER_LATLON, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', ECMOV.ETC_CEPENT, COALESCE(FGO_CEPCON, CADCLI.CLI_C_E_P_)) AS GER_CEPCON, ';
  strSQLDV := strSQLDV + '  IF('+fEnderecoPelaEntCli('AUXGOR')+', ECMOV.ETC_REFENT, CADCLI.CLI_REFENT) AS GER_REFCON, ';

  strSQLDV := strSQLDV + '  FGO_CODVEN AS GER_CODVEN, ';
  strSQLDV := strSQLDV + '  CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
  strSQLDV := strSQLDV + '  IF(FGO_ESPDOC = "TR", SUM((FDO_UNITAR * (FDO_QTDITE - IFNULL(FDO_QTDROM, 0))) - ROUND(((FDO_DESESP / FDO_QTDITE) * (FDO_QTDITE - IFNULL(FDO_QTDROM, 0))),  2)), IFNULL(FGO_VLRCON, 0) - IFNULL(FGO_VALROM, 0)) AS GER_VLRCON, ';
  strSQLDV := strSQLDV + '  IF(FGO_ESPDOC = "TR", SUM((FDO_UNITAR * (FDO_QTDITE - IFNULL(FDO_QTDROM, 0))) - ROUND(((FDO_DESESP / FDO_QTDITE) * (FDO_QTDITE - IFNULL(FDO_QTDROM, 0))),  2)), IFNULL(FGO_VLRCON, 0) - IFNULL(FGO_VALROM, 0)) AS GER_VALDOC, ';
  strSQLDV := strSQLDV + '  (FGO_TOTPRO - FGO_DESESP) GER_VLRPRO, ';
  strSQLDV := strSQLDV + '  FGO_ROMIMP AS GER_ROMIMP, ';
  strSQLDV := strSQLDV + '  "D"  AS GER_MARDES, ';
  strSQLDV := strSQLDV + '  " "  AS GER_VEICUL, ';

  strSQLDV := strSQLDV + fGetSQLPosObs('FATGOR','FGO_NUMDOC','FGO_ESPDOC','FGO_CODEMP') + ' AS POSOBS, ';

  strSQLDV := strSQLDV + '  LPAD("", 15, " ") AS GER_PALET_, ';
  strSQLDV := strSQLDV + '  0.00 AS GER_VALSEL, ';
  strSQLDV := strSQLDV + '  0.00 AS GER_VSEPRO, ';
  strSQLDV := strSQLDV + '  "C"  AS GER_TIP_FC, ';
  strSQLDV := strSQLDV + '  0    AS GER_ORDIMP, ';
  strSQLDV := strSQLDV + '  " "  AS GER_ALTERA, ';
  strSQLDV := strSQLDV + '  0    AS INCREMENTO, ';
  strSQLDV := strSQLDV + '  IF(IFNULL(TRAMOV.TRA_CODTRA,"") = "", CADTRA.TRA_CODTRA, TRAMOV.TRA_CODTRA) AS GER_CODTRA, ';
  strSQLDV := strSQLDV + '  IF(IFNULL(TRAMOV.TRA_NOMTRA,"") = "", CADTRA.TRA_NOMTRA, TRAMOV.TRA_NOMTRA) AS GER_TRANSP, ';
  strSQLDV := strSQLDV + '  CADTRA.TRA_NOMTRA AS GER_TRAFAT, ';
  strSQLDV := strSQLDV + '  FGO_CODTRA  AS GER_TRADOC, ';
  strSQLDV := strSQLDV + '  SUM((FDO_PESBRU / FDO_QTDITE) * (FDO_QTDITE - FDO_QTDBAI)) AS GER_PESBRU, ';
  strSQLDV := strSQLDV + '  "FATGOR" AS GER_NOMTBL, ';
  strSQLDV := strSQLDV + '  FATGOR.AUTOINCREM AS GER_AUTINC, ';

  If (Pos(strOpcRom,'2_3_') > 0) Then
  Begin
    strSQLDV := strSQLDV + '  "D" AS GER_ORIDOC, ';
    strSQLDV := strSQLDV + '  CAST(' + fSQLTotDet('FDO') + ' AS DECIMAL(15, 4)) GER_TOTDET, ';
    strSQLDV := strSQLDV + '  FGO_NUMROM AS GER_NUMROM,  ';
    strSQLDV := strSQLDV + '  "", ';
    strSQLDV := strSQLDV + '  "", ';
  End
  Else If (strOpcRom = '4') Then
  Begin
    strSQLDV := strSQLDV + '  "", ';
    strSQLDV := strSQLDV + '  "", ';
    strSQLDV := strSQLDV + '  "D" AS GER_ORIDOC, ';
    strSQLDV := strSQLDV + '  CAST(' + fSQLTotDet('FDO') + ' AS DECIMAL(15, 4)) GER_TOTDET, ';
    strSQLDV := strSQLDV + '  FGO_NUMROM AS GER_NUMROM,  ';
  End;

  strSQLDV := strSQLDV + '  (SELECT GROUP_CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC) FROM FATGOR WHERE FGO_NUMFAT = FGO_NUMDOC AND FGO_TIPFAT = FGO_ESPDOC AND FGO_EMPFAT = FGO_CODEMP), ';
  strSQLDV := strSQLDV + '  FGO_VOLUME AS GER_VOLUME, ';
  strSQLDV := strSQLDV + fSQLProfissionalCodigo('FDO')  + ' AS GER_CODDIV, ';
  strSQLDV := strSQLDV + fSQLProfissionalNome('FDO')  + ' AS GER_NOMDIV, ';
  strSQLDV := strSQLDV + '  " " AS GER_NFEADC, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEXP, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEX2, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEX3, ';
  strSQLDV := strSQLDV + '  " " AS GER_MENEX4, ';
  strSQLDV := strSQLDV + '  " " AS ENTURG, ';
  strSQLDV := strSQLDV + '  FGO_PRVIMP AS GER_PRVIMP,  ';
  strSQLDV := strSQLDV + '  "E" AS GER_ENTSAI, ';
  strSQLDV := strSQLDV + '  " " AS FIS_ACESSO, ';
  strSQLDV := strSQLDV + '  " " AS GER_ENTFUT, ';
  strSQLDV := strSQLDV + '  " " AS GER_ENTFAT, ';
  strSQLDV := strSQLDV + '  " " AS GER_CONENT, ';
  strSQLDV := strSQLDV + '  "N" AS APENAS_ESTE, ';
  strSQLDV := strSQLDV + '   0  AS GER_VOLBIP, ';
  strSQLDV := strSQLDV + fRetSQLDescrRegiao;
  strSQLDV := strSQLDV + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';
  strSQLDV := strSQLDV + fRetSQLSeqRotaRegiao('IF('+fEnderecoPelaEntCli('AUXGOR')+', CIDGER.CID_CODCID, CADCID.CID_CODCID)');
  strSQLDV := strSQLDV + '  FGO_BASSIM AS GER_BASSIM, ';
  strSQLDV := strSQLDV + '  FGO_BASIPI AS GER_BASIPI, ';
  strSQLDV := strSQLDV + '  FGO_TOTIPI AS GER_TOTIPI, ';
  strSQLDV := strSQLDV + '  FGO_BASICM AS GER_BASICM, ';
  strSQLDV := strSQLDV + '  FGO_TOTICM AS GER_TOTICM, ';
  strSQLDV := strSQLDV + '  FGO_TOTRET AS GER_TOTRET, ';
  strSQLDV := strSQLDV + '  FGO_BASRET AS GER_BASRET, ';
  strSQLDV := strSQLDV + '  FGO_DESESP AS GER_DESESP, ';
  strSQLDV := strSQLDV + '  FGO_TOTCUS AS GER_TOTCUS, ';
  strSQLDV := strSQLDV + '  FGO_TOTMED AS GER_TOTMED, ';
  strSQLDV := strSQLDV + '  FGO_TOTFRE AS GER_TOTFRE, ';
  strSQLDV := strSQLDV + '  FGO_VPAR01 AS GER_VPAR01, ';
  strSQLDV := strSQLDV + '  FGO_VPAR02 AS GER_VPAR02, ';
  strSQLDV := strSQLDV + '  FGO_VPAR03 AS GER_VPAR03, ';
  strSQLDV := strSQLDV + '  FGO_VPAR04 AS GER_VPAR04, ';
  strSQLDV := strSQLDV + '  FGO_VPAR05 AS GER_VPAR05, ';
  strSQLDV := strSQLDV + '  FGO_VPAR06 AS GER_VPAR06, ';
  strSQLDV := strSQLDV + '  FGO_VPAR07 AS GER_VPAR07, ';
  strSQLDV := strSQLDV + '  FGO_VPAR08 AS GER_VPAR08, ';
  strSQLDV := strSQLDV + '  FGO_VPAR09 AS GER_VPAR09, ';
  strSQLDV := strSQLDV + '  FGO_VPAR10 AS GER_VPAR10, ';
  strSQLDV := strSQLDV + '  FGO_VPAR11 AS GER_VPAR11, ';
  strSQLDV := strSQLDV + '  FGO_VPAR12 AS GER_VPAR12, ';
  strSQLDV := strSQLDV + '  FGO_TOTPRO AS GER_TOTPRO, ';
  strSQLDV := strSQLDV + '  FGO_CODCND AS GER_CODCND, ';
  strSQLDV := strSQLDV + fRetornaCampoOrigemPedidoRetira('');
  strSQLDV := strSQLDV + '  " " AS GER_ORIDEV, ';
  strSQLDV := strSQLDV + fRetornaInformacoesRota;
  strSQLDV := strSQLDV + '  " " AS DOC_FATURADOS, ';
  strSQLDV := strSQLDV + '  " " AS GER_INCFUT, ';
  strSQLDV := strSQLDV + '  " " AS TIPPED, ';
  strSQLDV := strSQLDV + '  1.00 AS GER_PERDEV, ';
  strSQLDV := strSQLDV + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSQLDV := strSQLDV + '  FROM ROMLGE ';
  strSQLDV := strSQLDV + '  INNER JOIN ROMLDE ';
  strSQLDV := strSQLDV + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
  strSQLDV := strSQLDV + '  WHERE RLD_NUMDOC = FGO_NUMDOC ';
  strSQLDV := strSQLDV + '  AND RLD_ESPDOC = FGO_ESPDOC ';
