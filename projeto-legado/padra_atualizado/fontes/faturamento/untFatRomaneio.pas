function TfrmFatRomaneio.fSelecionaDocumentosLoteProgresso(cxProgressBar : TcxProgressBar):Boolean;
  Var
    qryDocs : TUniQuery;
Begin
  Result := True;
  qryDocs := fCriaQuery;
  With qryDocs, SQL Do
  Begin
    Try
      Close;
      Clear;

      Add(' SELECT RLD_NUMDOC,                                  ');
      Add('        RLD_ESPDOC,                                  ');
      Add('        RLD_SERIE_,                                  ');
      Add('        RLD_CODEMP                                   ');
      Add(' FROM ROMLGE                                         ');
      Add(' INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM ');
      Add(' WHERE RLG_NUMLOT = :NUMLOT                          ');
      Add('   AND RLG_CODEMP = :CODEMP                          ');
      Add(' ORDER BY RLD_SEQUEN                                 ');

      ParamByName('NUMLOT').AsString := strFiltroNumLot;
      ParamByName('CODEMP').AsString := strFiltroEmpLot;

      Open;

      cxProgressBar.pSetMax(RecordCount);

      cdsTmpDoc.DisableControls;

      While Not Eof Do
      Begin
        if cdsTmpDoc.Locate('GER_NUMDOC', FieldByName('RLD_NUMDOC').AsString + '-' + FieldByName('RLD_ESPDOC').AsString, []) Then
          pSelecionaDocumento
        else
        if pos(FieldByName('RLD_ESPDOC').AsString,'PD_OR_') > 0 then
        begin
          cdsTmpDoc.first;
          While not cdsTmpDoc.eof do
          begin
            if Pos(Trim(cdsTmpDoc.FieldByName('GER_PEDVEN').AsString), FieldByName('RLD_NUMDOC').AsString + '-' + FieldByName('RLD_ESPDOC').AsString) > 0 then
            begin
               pSelecionaDocumento;
               qryDocs.Next;
            end;

            cdsTmpDoc.next;
          end;
          cdsTmpDoc.first;
        end;

        Next;

        cxProgressBar.pStep;
        Application.ProcessMessages;
      End;

    Finally
      cdsTmpDoc.EnableControls;
      FreeAndNil(qryDocs);
    End;
  End;

End;

