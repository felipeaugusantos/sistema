procedure TfrmFatRomaneio.dbgDocumentosROMTRACustomDrawCell(
  Sender: TcxCustomGridTableView; ACanvas: TcxCanvas;
  AViewInfo: TcxGridTableDataCellViewInfo; var ADone: Boolean);
Var
  APainter: TcxPainterAccess;
  strRomTra: String;
  strEmpTra: String;
  varData: Variant;
begin
  inherited;
  If AViewInfo.Item.Index <> dbgDocumentosROMTRA.Index Then
    Exit;

  If AViewInfo.GridRecord.Index < 0 Then
    Exit;


  varData := dbgDocumentosDBView.ViewData.Records[AViewInfo.GridRecord.Index].Values[ dbgDocumentosROMTRA.Index];
  strRomTra := VarAsType(IIF(varData = null, '', varData), varString);

  varData := dbgDocumentosDBView.ViewData.Records[AViewInfo.GridRecord.Index].Values[ dbgDocumentosTRA_EMPDES.Index];
  strEmpTra := VarAsType(IIF(varData = null, '', varData), varString);

  APainter := TcxPainterAccess(TcxViewInfoAcess(AViewInfo).GetPainterClass.Create(ACanvas, AViewInfo));
  With APainter Do
  Begin
    Try
      DrawBorders;
      If not fEmptyStr(VarToStr(Sender.DataController.Values[AViewInfo.GridRecord.RecordIndex, AViewInfo.Item.Index])) Then
      begin
        Canvas.Brush.Color := $00379BFF;
        With AViewInfo.ClientBounds Do
        Begin
          ACanvas.Canvas.Ellipse(Left + 2, Top, Left + 20, Top + 18);
          Canvas.Brush.Color := clWhite;
          Canvas.Font.Color := clBlack;
          ACanvas.Canvas.TextOut(Left + 22, Top + 2, 'Filial: ' + strEmpTra);

        End;
      end;
    Finally
      Free;
    End;

  End;

  ADone := True;
end;

procedure TfrmFatRomaneio.btnConfirmaClick(Sender: TObject);
Var
  blnConfirma   : Boolean;
  prcScroll     : TprcScroll;
  blnWasEnabled : Boolean;
  LfrmGravando  : TfrmGravando;
begin

  If Not btnConfirma.Visible Then
    Exit;

  If fEhRomaneioSimplificado Then
    If Not fPodeConfirmarRomaneioSimplificado Then
      Exit;

  inherited;

  If Not cdsTmpDoc.IsEmpty Then
  Begin

    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    blnConfirma := False;

    Try

      Try
        pCriarFormularios(TfrmGravando, LfrmGravando);
        LfrmGravando.lblGravando.Caption := 'Aguarde... Confirmando.';
        LfrmGravando.strChave := 'PEDCOM';
        LfrmGravando.fExecutarAcao := fConfirmacaoRomaneioF10;
        LfrmGravando.ShowModal;
        blnConfirma := True;
      Except
        On E: Exception Do
        Begin
          pMensagensErro(E.Message,'[Confirma [F10] - untFatRomaneio]');
        End;
      End;

      If blnWasEnabled Then
        pEnableControls(cdsTmpDoc, prcScroll);

      If blnConfirma Then
        pSetFocus(edtNumRom);

    finally
      pFreeAndNil(LfrmGravando);
    end;

  End;

end;

