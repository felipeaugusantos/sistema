procedure TfrmFatRomaneio.pHintSplitters(splSplitter: TcxSplitter; blnFechado: Boolean);
  var
    strArea : String;
    strAcao : String;
begin

  If Not Assigned(splSplitter) Then
    Exit;

  If Not (splSplitter Is TcxSplitter) Then
    Exit;

  Try

    TcxSplitter(splSplitter).ShowHint := False;

    strArea := IIF(TcxSplitter(splSplitter).Name = splInformacoes.Name, 'Observações', 'Filtros');
    strAcao := IIF(blnFechado, 'Expandir', 'Retrair');

    TcxSplitter(splSplitter).Hint := strAcao + ' ' + strArea;

  Finally
    TcxSplitter(splSplitter).ShowHint := True;
  End;

end;

procedure TfrmFatRomaneio.pImprimeOrdemProducaoTinta(strNumDoc, strEspDoc,
  strCodEmp, strCodCli: string);
var
  objImpOrdPro: IFatOrdProTintaMaquina;
  qryTintas: TUniQuery;
  strSQL: string;
begin
  objImpOrdPro := TFatOrdProTintaMaquina.Create;
  qryTintas := fCriaQuery;

  try
    strSQL := EmptyStr;

    if pos(strEspDoc, 'PD_OR_') > 0 then
    begin
      strSQL := strSQL + ' SELECT FDO_CODACA AS CODACA, FDO_EMPACA AS EMPACA, FDO_EMPPRD AS EMPPRD ' + sLineBreak;
      strSQL := strSQL + ' FROM FATDOR ' + sLineBreak;
      strSQL := strSQL + ' WHERE FDO_NUMDOC = :NUMDOC ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_ESPDOC = :ESPDOC ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_CODEMP = :CODEMP ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_CODCLI = :CODCLI ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_CODACA IS NOT NULL ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_EMPACA IS NOT NULL ' + sLineBreak;
      strSQL := strSQL + ' AND FDO_EMPPRD IS NOT NULL ';
    end
    else
    begin
      strSQL := strSQL + ' SELECT DET_CODACA AS CODACA, DET_EMPACA AS EMPACA, DET_EMPPRD AS EMPPRD ' + sLineBreak;
      strSQL := strSQL + ' FROM TINDET ' + sLineBreak;
      strSQL := strSQL + ' WHERE DET_NUMDOC = :NUMDOC ' + sLineBreak;
      strSQL := strSQL + ' AND DET_ESPDOC = :ESPDOC ' + sLineBreak;
      strSQL := strSQL + ' AND DET_CODEMP = :CODEMP ' + sLineBreak;
      strSQL := strSQL + ' AND DET_CODCLI = :CODCLI ' + sLineBreak;
      strSQL := strSQL + ' AND DET_CODACA IS NOT NULL ' + sLineBreak;
      strSQL := strSQL + ' AND DET_EMPACA IS NOT NULL ' + sLineBreak;
      strSQL := strSQL + ' AND DET_EMPPRD IS NOT NULL ';
    end;

    qryTintas.Close;
    qryTintas.SQL.Clear;
    qryTintas.SQL.Add(strSQL);
    qryTintas.ParamByName('NUMDOC').AsString := strNumDoc;
    qryTintas.ParamByName('ESPDOC').AsString := strEspDoc;
    qryTintas.ParamByName('CODEMP').AsString := strCodEmp;
    qryTintas.ParamByName('CODCLI').AsString := strCodCli;
    qryTintas.Open;

    while not qryTintas.Eof do
    begin
      objImpOrdPro.pSetaDocumento(strNumDoc, strEspDoc, strCodEmp, strCodCli, qryTintas.FieldByName('EMPPRD').AsString, qryTintas.FieldByName('CODACA').AsString, qryTintas.FieldByName('EMPACA').AsString);

      if objImpOrdPro.fGetTemFormula then
      begin
        objImpOrdPro.pImprimeOrdProdTmp(False, qryTintas.FieldByName('EMPPRD').AsString, qryTintas.FieldByName('CODACA').AsString);
        pMarcaImpressaoOrdemProducaoTinta(strNumDoc, strEspDoc, strCodEmp, strCodCli, qryTintas.FieldByName('CODACA').AsString, qryTintas.FieldByName('EMPACA').AsString);
      end;

      qryTintas.Next;
    end;
  finally
    FreeAndNil(qryTintas);
  end;
end;

procedure TfrmFatRomaneio.pImprimeSeparacao;
var
  cdsImpSep: TUniClientDataSet;
  strAutInc: string;
  stlPedidos: TStringList;
  objPedido: TPedidoVenda;
  intContador: integer;
  objImpSep: TReimpressao;
begin
  If (Pos(strOpcRom, '1_5_') <= 0) Then
    Exit;

  If Not fCfgSis('IMSERO', varBoolean) Then
    Exit;

  cdsImpSep := TUniClientDataSet.Create(Self);
  stlPedidos := TStringList.Create;

  Try
    pCloneDataSet(cdsImpSep, cdsTmpDoc);

    cdsImpSep.Filtered := False;
    cdsImpSep.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+')) ';
    cdsImpSep.Filtered := True;

    If cdsImpSep.IsEmpty Then
      Exit;

    cdsImpSep.First;

    While Not cdsImpSep.Eof Do
    Begin
      If cdsImpSep.FieldByName('GER_ESPDOC').AsString = 'PD' Then
      Begin
        strAutInc := fCampoTabela('AUTOINCREM', 'FATGOR', ['FGO_NUMDOC','FGO_ESPDOC','FGO_CODCLI','FGO_CODEMP'], [cdsImpSep.FieldByName('GER_DOCORI').AsString, cdsImpSep.FieldByName('GER_ESPDOC').AsString, cdsImpSep.FieldByName('GER_CODCLI').AsString, cdsImpSep.FieldByName('GER_CODEMP').AsString]);
        If Not fPedidoJahImpresso(strAutInc) Then
        Begin
          If (stlPedidos.IndexOf(strAutInc) = -1) Then
          Begin
            objPedido := TPedidoVenda.Create;
            objPedido.strNumDoc := cdsImpSep.FieldByName('GER_DOCORI').AsString;
            objPedido.strEspDoc := cdsImpSep.FieldByName('GER_ESPDOC').AsString;
            objPedido.strCodEmp := cdsImpSep.FieldByName('GER_CODEMP').AsString;
            objPedido.strCodCli := cdsImpSep.FieldByName('GER_CODCLI').AsString;
            objPedido.strCodVen := cdsImpSep.FieldByName('GER_CODVEN').AsString;
            objPedido.strSeqGer := strAutInc;

            stlPedidos.AddObject(strAutInc, objPedido);
          End;
        End;
      End;
      cdsImpSep.Next;
    End;

    If stlPedidos.Count = 0 Then
      Exit;

    If fMensagem('', 'Imprimir a separação dos pedidos selecionados?', ['&Sim', '&Não']) = 2 Then
      Exit;

    VS_ImprimeSepFaturados := True;

    For intContador := 0 To stlPedidos.Count - 1 Do
    Begin
      //Imprimir separação por filas configuradas
      //Ou
      //imprimir separação por setor
      If (fUtilizaFilasImpressaoSeparacaoConfiguradas(TPedidoVenda(stlPedidos.Objects[intContador]).strEspDoc)) Or
         (fImpressaoSeparacaoPorSetor) Then
        fImprimeSeparacaoFaturamento(TPedidoVenda(stlPedidos.Objects[intContador]).strNumDoc,
                                     TPedidoVenda(stlPedidos.Objects[intContador]).strEspDoc,
                                     TPedidoVenda(stlPedidos.Objects[intContador]).strCodEmp,
                                     TPedidoVenda(stlPedidos.Objects[intContador]).strCodCli)
      Else
      Begin
        //Cria objeto para imprimir o documento
        objImpSep := TReimpressao.Create(TPedidoVenda(stlPedidos.Objects[intContador]).strNumDoc,
                                         TPedidoVenda(stlPedidos.Objects[intContador]).strEspDoc,
                                         0,
                                         0,
                                         TPedidoVenda(stlPedidos.Objects[intContador]).strCodCli,
                                         TPedidoVenda(stlPedidos.Objects[intContador]).strCodEmp,
                                         TPedidoVenda(stlPedidos.Objects[intContador]).strCodVen,
                                         VS_strTipExp = '2',
                                         '',
                                         False,
                                         False,
                                         False,
                                         '',
                                         '',
                                         False,
                                         0,
                                         False,
                                         '');

        objImpSep.blnSeparacaoDireto := True;

        Try
          objImpSep.fImprimeSeparacao('', False, False, False, (VS_strTipExp <> '2'), False,
                                      opcNaoSolicitado, False, IIF(VS_strTipExp = '2',
                                      VS_strExpRetiraEntregaDocFat,VS_strExpRetiraEntrega));
        Finally
          FreeAndNil(objImpSep);
        End;
      End;

    End;

  Finally
    FreeAndNil(cdsImpSep);
    FreeAndNil(stlPedidos);
    VS_ImprimeSepFaturados := False;
  End
end;

procedure TfrmFatRomaneio.pInicializaPesoVeiculo;
var
  intIndicePai,
  intIndiceFilho,
  intIndiceVeic: integer;
  objPai: TPanel;
  objFilho: TLabel;
  strNumVeic: string;
begin
  for intIndicePai := 0 to flwpnlVeiculo.ControlCount - 1 do
  begin
    if (flwpnlVeiculo.Controls[intIndicePai] is TPanel) then
    begin
      objPai := TPanel(flwpnlVeiculo.Controls[intIndicePai]);
      strNumVeic := Copy(TPanel(objPai).Name, Pos('_', TPanel(objPai).Name) + 1, 1);

      for intIndiceFilho := 0 to objPai.ControlCount - 1 do
      begin
        if (objPai.Controls[intIndiceFilho] is TLabel) and (TLabel(objPai.Controls[intIndiceFilho]).Name = 'lblPesoDesc_'+strNumVeic) then
        begin
          for intIndiceVeic := Low(arrVeiculos) to High(arrVeiculos) do
          begin
            if (arrVeiculos[intIndiceVeic].blnTemRom) and (arrVeiculos[intIndiceVeic].strNumVeic = strNumVeic) then
            Begin
              objFilho := TLabel(objPai.Controls[intIndiceFilho]);
              TLabel(objFilho).Caption := FloatToStrF(0, ffFixed, 12, 4);
              arrVeiculos[intIndiceVeic].fltPeso := 0;
            End;
          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmFatRomaneio.pInsereDevolucoesOutEnt(strNumRom: String);
  Var
    qryAux : TUniQuery;
    strSQLAux,
    strTxtIte,
    strTxtCab : String;
    cdsTmp    : TUniClientDataSet;
    cdsDet    : TUniClientDataSet;
    qryCli : TUniQuery;
begin
  qryAux    := fCriaQuery(Self);
  cdsTmp    := TUniClientDataSet.Create(Self);
  cdsDet    := TUniClientDataSet.Create(Self);
  qryCli    := fCriaQuery(Self);
  pCloneDataSet(cdsTmp, cdsTmpDoc);
  pCloneDataSet(cdsDet, cdsRomDet);

  Try
    If (Pos(strOpcRom,'2_3_4') > 0) Then
    Begin
      cdsTmp.Filtered := False;
      cdsTmp.Filter   :=                 '((GER_MARDES = ' + QuotedStr('M') +') OR (GER_MARDES = ' + QuotedStr('P') + ')) AND ' ;
      cdsTmp.Filter   := cdsTmp.Filter + '((GER_ORIDOC = ' + QuotedStr('D') +') OR (GER_ENTSAI = ' + QuotedStr('E') + ')) ';
      cdsTmp.Filtered := True;

      With cdsTmp Do
      Begin
        If Not (IsEmpty) Then
        Begin
          strTxtCab := '';

          First;
          While (Not Eof) Do
          Begin
            qryCli.Close;
            qryCli.SQL.Clear;
            qryCli.SQL.Add(' SELECT CONCAT(C.CLI_ENDERE, " - BAIRRO: ", C.CLI_BAIRRO, ", CEP: ", C.CLI_C_E_P_) AS CLI_ENDCLI ');
            qryCli.SQL.Add('   FROM CADCLI C ');
            qryCli.SQL.Add('  WHERE CLI_CODCLI = ' + QuotedStr(FieldByName('GER_CODCLI').AsString));
            qryCli.Open;

            cdsDet.Filtered := False;
            cdsDet.Filter   := 'DET_SEQGER = ' + QuotedStr(cdsTmp.FieldByName('INCREMENTO').AsString);
            cdsDet.Filtered := True;

            strTxtCab := '';
            strTxtCab := strTxtCab + 'DEV: ' + FieldByName('GER_NUMDOC').AsString + '-' +
                                               FieldByName('GER_CODEMP').AsString;

            strTxtCab := strTxtCab + ' CLIENTE: ' + FieldByName('GER_CODCLI').AsString + '-' +
                                                    FieldByName('GER_NOMCLI').AsString + #13;

            strTxtCab := strTxtCab + qryCli.FieldByName('CLI_ENDCLI').AsString + #13;
            strTxtCab := strTxtCab + FieldByName('GER_NOMCID').AsString + #13;

            If (Not cdsDet.IsEmpty) Then
              strTxtIte := 'PRODUTOS: ' + #13;

            cdsDet.First;
            While (Not cdsDet.Eof) Do
            Begin
              strTxtIte := strTxtIte + fPadR(cdsDet.FieldByName('DET_CODITE').AsString,10) +
                                       fPadR(cdsDet.FieldByName('DET_DESITE').AsString,90) +
                                       fPadR(FormatFloat('#,##0.00', cdsDet.FieldByName('DET_QTDBAI').AsFloat), 15) +
                                       fPadR(fRetNomUnidade(fRetUnidadeItem(cdsDet.FieldByName('DET_CODITE').AsString)),fTamCodIte) + #13;
              cdsDet.Next;
            End;

            cdsOutEnt.Append;
            cdsOutEnt.FieldByName('DESCRI').AsString := strTxtCab + strTxtIte;
            cdsOutEnt.Post;

            With qryAux do
            Begin
              strSQLAux := '';

              If (SameText(cdsTmp.FieldByName('GER_NOMTBL').AsString, 'FATGOR')) Then
              Begin
                strSQLAux := strSQLAux + ' UPDATE ' + cdsTmp.FieldByName('GER_NOMTBL').AsString;
                strSQLAux := strSQLAux + ' SET ';
                strSQLAux := strSQLAux + '   FGO_DTAROM = ' + fCurrentDate + ', ';
                strSQLAux := strSQLAux + '   FGO_HORROM = ' + fCurrentTime + ', ';
                strSQLAux := strSQLAux + '   FGO_OPEROM = :OPEROM, ';
                strSQLAux := strSQLAux + '   FGO_NUMROM = :NUMROM, ';
                strSQLAux := strSQLAux + '   FGO_EMPROM = :EMPROM  ';
                strSQLAux := strSQLAux + ' WHERE ';
                strSQLAux := strSQLAux + '   FGO_CODEMP = :CODEMP AND ';
                strSQLAux := strSQLAux + '   FGO_NUMDOC = :NUMDOC AND ';
                strSQLAux := strSQLAux + '   FGO_ESPDOC = :ESPDOC ';
              End
              Else if MatchStr(cdsTmp.FieldByName('GER_NOMTBL').AsString, ['MOVGER', 'NOTGER']) then
              Begin
                strSQLAux := strSQLAux + ' UPDATE ' + cdsTmp.FieldByName('GER_NOMTBL').AsString;
                strSQLAux := strSQLAux + ' SET ';
                strSQLAux := strSQLAux + '   GER_DTAROM = ' + fCurrentDate + ', ';
                strSQLAux := strSQLAux + '   GER_HORROM = ' + fCurrentTime + ', ';
                strSQLAux := strSQLAux + '   GER_OPEROM = :OPEROM, ';
                strSQLAux := strSQLAux + '   GER_NUMROM = :NUMROM, ';
                strSQLAux := strSQLAux + '   GER_EMPROM = :EMPROM  ';
                strSQLAux := strSQLAux + ' WHERE ';
                strSQLAux := strSQLAux + '   GER_CODEMP = :CODEMP AND ';
                strSQLAux := strSQLAux + '   GER_NUMDOC = :NUMDOC AND ';
                strSQLAux := strSQLAux + '   GER_ESPDOC = :ESPDOC ';
              End;

              if (not fEmptyStr(strSQLAux)) then
              begin
                Close;
                SQL.Clear;
                SQL.Add(strSQLAux);
                ParamByName('OPEROM').AsString := strLoginUsuarioLogado;
                ParamByName('NUMROM').AsString := strNumRom;
                ParamByName('EMPROM').AsString := VS_strCodEmp;
                ParamByName('ESPDOC').AsString := cdsTmp.FieldByName('GER_ESPDOC').AsString;
                ParamByName('NUMDOC').AsString := Copy(cdsTmp.FieldByName('GER_NUMDOC').AsString,1,fTamDocCadRec);
                ParamByName('CODEMP').AsString := cdsTmp.FieldByName('GER_CODEMP').AsString;
                ExecSQL;
              end;
            End;

            Next;
          End;
        End;
      End;
    End;
  Except
    On E: Exception Do
      pMensagensErro(E.Message, '[frmFatRomaneio.pInsereDevolucoesOutEnt]');
  End;

  FreeAndNil(qryCli);
  FreeAndNil(cdsTmp);
  FreeAndNil(qryAux);
  FreeAndNil(cdsDet);
end;

