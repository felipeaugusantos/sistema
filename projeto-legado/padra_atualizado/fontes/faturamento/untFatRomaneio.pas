function TfrmFatRomaneio.fSQLBrindes: String;
  Var
    strSQLGer : String;
begin
  strSQLGer := '';
  strSQLGer := strSQLGer + 'SELECT ';
  strSQLGer := strSQLGer + fRetSQLDocRetornadoRomaneio('GER') + ' AS GER_RETROM, ';
  strSQLGer := strSQLGer + '  GER_CONPAG   AS GER_CONPAG, ';
  strSQLGer := strSQLGer + '  GER_CODFPG   AS GER_CODFPG, ';
  strSQLGer := strSQLGer + '  " "          AS GER_TIPOPE, ';
  strSQLGer := strSQLGer + '  " "          AS GER_FPGNEG, ';
  strSQLGer := strSQLGer + '  "N"          AS GER_ORIF11, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_TOTBRI, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_VALREC, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_BOLADT, ';
  strSQLGer := strSQLGer + '  "N"          AS GER_BOLVEN, ';
  strSQLGer := strSQLGer + '  0.00         AS GER_VALADT, ';
  strSQLGer := strSQLGer + '  GER_VLRCON   AS GER_CONORI, ';
  strSQLGer := strSQLGer + '  GER_DTAENT, ';
  strSQLGer := strSQLGer + '  GER_HORENT, ';
  strSQLGer := strSQLGer + '  GER_DTENTR, ';
  strSQLGer := strSQLGer + '  CONCAT( GER_NUMDOC, "-", GER_ESPDOC ), ';
  strSQLGer := strSQLGer + '  GER_NUMDOC, ';
  strSQLGer := strSQLGer + '  GER_ESPDOC, ';
  strSQLGer := strSQLGer + '  GER_CODEMP, ';
  strSQLGer := strSQLGer + '  CAST(GROUP_CONCAT(DET_EMP_PD) AS CHAR(255)) AS DET_EMPORI, ';
  strSQLGer := strSQLGer + '  GER_CODCLI, ';
  strSQLGer := strSQLGer + '  IF( GER_NOMCON IS NULL, CLI_NOMCLI, GER_NOMCON), ';
  strSQLGer := strSQLGer + '  CONCAT(FPG_CODIGO,"-",FPG_DESCRI) AS GER_FORPAG, ';
  strSQLGer := strSQLGer + '  GER_CLAFIS, ';

  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDCLIG.CID_CODCID, CADCID.CID_CODCID) AS CID_CODCID, ';

  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDCLIG.CID_NOMCID, CADCID.CID_NOMCID) AS GER_NOMCID, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDCLIG.CID_ESTADO, CADCID.CID_ESTADO) AS GER_ESTADO, ';
  strSQLGer := strSQLGer + '  GER_TIPFRE, ';

  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_BAIENT, COALESCE(GER_BAICON, CADCLI.CLI_BAIRRO)) AS GER_BAIRRO, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_ENDENT, COALESCE(GER_ENDCON, CADCLI.CLI_ENDERE)) AS GER_ENDCON, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_LATLON, " ") AS GER_LATLON, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_CEPENT, COALESCE(GER_CEPCON, CADCLI.CLI_C_E_P_)) AS GER_CEPCON, ';
  strSQLGer := strSQLGer + '  IF('+fEnderecoPelaEntCli('AUXMOV')+', ECMOV.ETC_REFENT, CADCLI.CLI_REFENT) AS GER_REFCON, ';

  strSQLGer := strSQLGer + '  GER_CODVEN, ';
  strSQLGer := strSQLGer + '  CADOPE.OPE_NOMOPE AS GER_NOMVEN, ';
  strSQLGer := strSQLGer + fSQLVlrCon('DET', 'MOVGER') + ' - IFNULL(GER_VALROM, 0), ';
  strSQLGer := strSQLGer + fSQLVlrCon('DET', 'MOVGER') + ' - IFNULL(GER_VALROM, 0), ';
  strSQLGer := strSQLGer + '  (GER_TOTPRO - GER_DESESP) GER_VLRPRO, ';
  strSQLGer := strSQLGer + '  GER_ROMIMP, ';
  strSQLGer := strSQLGer + '  "D" AS GER_MARDES,       ';
  strSQLGer := strSQLGer + '  " " AS GER_VEICUL,       ';

  strSQLGer := strSQLGer + fGetSQLPosObs('MOVGER','GER_NUMDOC','GER_ESPDOC','GER_CODEMP') + ' AS POSOBS, ';

  strSQLGer := strSQLGer + '  LPAD("", 15, " ") AS GER_PALET_, ';
  strSQLGer := strSQLGer + '  0.00 GER_VALSEL, ';
  strSQLGer := strSQLGer + '  0.00 GER_VSEPRO, ';
  strSQLGer := strSQLGer + '  GER_TIP_FC, ';
  strSQLGer := strSQLGer + '  0 GER_ORDIMP, ';
  strSQLGer := strSQLGer + '  " " GER_ALTERA, ';
  strSQLGer := strSQLGer + '  0 INCREMENTO, ';
  strSQLGer := strSQLGer + '  IF(IFNULL(TRAMOV.TRA_CODTRA,"") = "", CADTRA.TRA_CODTRA, TRAMOV.TRA_CODTRA) AS GER_CODTRA, ';
  strSQLGer := strSQLGer + '  IF(IFNULL(TRAMOV.TRA_NOMTRA,"") = "", CADTRA.TRA_NOMTRA, TRAMOV.TRA_NOMTRA) AS GER_TRANSP, ';
  strSQLGer := strSQLGer + '  CADTRA.TRA_NOMTRA AS GER_TRAFAT, ';
  strSQLGer := strSQLGer + '  GER_CODTRA  AS GER_TRADOC, ';
  strSQLGer := strSQLGer + '  GER_PESBRU, ';
  strSQLGer := strSQLGer + '  "MOVGER"  AS GER_NOMTBL, ';
  strSQLGer := strSQLGer + '  MOVGER.AUTOINCREM AS GER_AUTINC, ';
  strSQLGer := strSQLGer + '  GER_ORIDOC, ';
  strSQLGer := strSQLGer + '  CAST(' + fSQLTotDet('DET') + ' AS DECIMAL(15, 4)) GER_TOTDET, ';
  strSQLGer := strSQLGer + '  GER_NUMROM,  ';
  strSQLGer := strSQLGer + '  CONCAT(GER_NUMFAT, GER_TIPFAT, GER_EMPFAT, GER_CLIFAT) AS GER_NUMFAT, ';
  strSQLGer := strSQLGer + '  CONCAT(GER_NUMDOC, GER_ESPDOC, GER_CODEMP, GER_CODCLI) AS GER_DOCUME,  ';
  strSQLGer := strSQLGer + '  (SELECT GROUP_CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC) FROM FATGOR WHERE FGO_NUMFAT = GER_NUMDOC AND FGO_TIPFAT = GER_ESPDOC AND FGO_EMPFAT = GER_CODEMP), ';
  strSQLGer := strSQLGer + fSQLVolume('DET', 'MOVGER') + ' AS GER_VOLUME, ';
  strSQLGer := strSQLGer + fSQLProfissionalCodigo('DET')  + ' AS GER_CODDIV, ';
  strSQLGer := strSQLGer + fSQLProfissionalNome('DET')  + ' AS GER_NOMDIV, ';
  strSQLGer := strSQLGer + '  MOV_OBSERV AS GER_NFEADC, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEXP, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEX2, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEX3, ';
  strSQLGer := strSQLGer + '  " " AS GER_MENEX4, ';
  strSQLGer := strSQLGer + '  " " AS ENTURG, ';
  strSQLGer := strSQLGer + '  GER_PRVIMP, ';
  strSQLGer := strSQLGer + '  IF(LEFT(GER_CLAFIS, 1) >= "5", "S", "E") AS GER_ENTSAI, ';
  strSQLGer := strSQLGer + '  FIS_ACESSO, ';
  strSQLGer := strSQLGer + '  GER_ENTFUT, ';
  strSQLGer := strSQLGer + '  GER_ENTFAT, ';
  strSQLGer := strSQLGer + '  GER_CONENT, ';
  strSQLGer := strSQLGer + '  "N" AS APENAS_ESTE, ';
  strSQLGer := strSQLGer + '  0 AS GER_VOLBIP, ';
  strSQLGer := strSQLGer + fRetSQLDescrRegiao;
  strSQLGer := strSQLGer + '  CONCAT(SUB_CODSUB,"-",SUB_DESSUB) AS SUBREGIAO, ';
  strSQLGer := strSQLGer + fRetSQLSeqRotaRegiao('IF('+fEnderecoPelaEntCli('AUXMOV')+', CIDCLIG.CID_CODCID, CADCID.CID_CODCID)');
  strSQLGer := strSQLGer + fSQLCampo('GER_BASSIM', '', 'MOVGER')           + ' AS GER_BASSIM, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_BASIPI', 'GER_BASIPI', 'MOVGER') + ' AS GER_BASIPI, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_VALIPI', 'GER_TOTIPI', 'MOVGER') + ' AS GER_TOTIPI, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_BASICM', 'GER_BASICM', 'MOVGER') + ' AS GER_BASICM, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_VALICM', 'GER_TOTICM', 'MOVGER') + ' AS GER_TOTICM, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_VALRET', 'GER_TOTRET', 'MOVGER') + ' AS GER_TOTRET, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_BASRET', 'GER_BASRET', 'MOVGER') + ' AS GER_BASRET, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_DESESP', 'GER_DESESP', 'MOVGER') + ' AS GER_DESESP, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTCUS', 'GER_TOTCUS', 'MOVGER') + ' AS GER_TOTCUS, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTMED', 'GER_TOTMED', 'MOVGER') + ' AS GER_TOTMED, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTFRE', 'GER_TOTFRE', 'MOVGER') + ' AS GER_TOTFRE, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR01', '', 'MOVGER')           + ' AS GER_VPAR01, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR02', '', 'MOVGER')           + ' AS GER_VPAR02, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR03', '', 'MOVGER')           + ' AS GER_VPAR03, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR04', '', 'MOVGER')           + ' AS GER_VPAR04, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR05', '', 'MOVGER')           + ' AS GER_VPAR05, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR06', '', 'MOVGER')           + ' AS GER_VPAR06, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR07', '', 'MOVGER')           + ' AS GER_VPAR07, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR08', '', 'MOVGER')           + ' AS GER_VPAR08, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR09', '', 'MOVGER')           + ' AS GER_VPAR09, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR10', '', 'MOVGER')           + ' AS GER_VPAR10, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR11', '', 'MOVGER')           + ' AS GER_VPAR11, ';
  strSQLGer := strSQLGer + fSQLCampo('GER_VPAR12', '', 'MOVGER')           + ' AS GER_VPAR12, ';
  strSQLGer := strSQLGer + fSQLCampo('DET_TOTITE', 'GER_TOTPRO', 'MOVGER') + ' AS GER_TOTPRO, ';
  strSQLGer := strSQLGer + '  GER_CODCND, ';
  strSQLGer := strSQLGer + fRetornaCampoOrigemPedidoRetira('MOVGER');
  strSQLGer := strSQLGer + '  " " AS GER_ORIDEV, ';
  strSQLGer := strSQLGer + fRetornaInformacoesRota;
  strSQLGer := strSQLGer + '  " " AS DOC_FATURADOS, ';
  strSQLGer := strSQLGer + '  " " AS GER_INCFUT, ';
  strSQLGer := strSQLGer + '  " " AS TIPPED, ';
  strSQLGer := strSQLGer + '  1.00 AS GER_PERDEV, ';
  strSQLGer := strSQLGer + ' (SELECT ROMLGE.RLG_NUMLOT  ';
  strSQLGer := strSQLGer + '  FROM ROMLGE ';
  strSQLGer := strSQLGer + '  INNER JOIN ROMLDE ';
  strSQLGer := strSQLGer + '  ON RLD_SEQRLG = ROMLGE.AUTOINCREM ';
  strSQLGer := strSQLGer + '  WHERE RLD_NUMDOC = GER_NUMDOC ';
  strSQLGer := strSQLGer + '  AND RLD_ESPDOC = GER_ESPDOC ';
  strSQLGer := strSQLGer + '  AND RLD_CODEMP = GER_CODEMP LIMIT 1) AS ROMLOT, ';
  strSQLGer := strSQLGer + fRetornaCampoTurno('DET_TURENT');
  strSQLGer := strSQLGer + ', "N" AS DELETA_DEVOLUCAO ';

  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(20)) AS ROMTRA ';
  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(3)) AS TRA_EMPDES ';

  if fCfgSis('MATDIS', varBoolean) then
  begin
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(30)) AS GER_LOCALI ';
    strSQLGer := strSQLGer + ', 0.00 AS GER_DISTAN ';
    strSQLGer := strSQLGer + ', 0.00 AS GER_TMPENT ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS TEMPOENTREGA ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS DISTAENTREGA ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS TEMPOACUMULADO ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(50)) AS DISTACUMULADA ';
    strSQLGer := strSQLGer + ', 0 AS PRIORIDADE ';
    strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_LIBAPP ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(150)) AS GER_EVITAR ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(3)) AS CARGANAFILIAL ';
    strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_FILIAL ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(100)) AS GER_INIPAR ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(80)) AS BKP_ENDCON ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(30)) AS BKP_BAIRRO ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(40)) AS BKP_NOMCID ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(2))  AS BKP_ESTADO ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(8))  AS BKP_CEPCON ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(5))  AS BKP_CODCID ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(15)) AS GER_FSTSHT ';
    strSQLGer := strSQLGer + ', CAST(" " AS CHAR(100)) AS GER_FINROT ';
  end;

  strSQLGer := strSQLGer + ', CADCLI.CLI_CODRED ';
  strSQLGer := strSQLGer + ', CADCLI.CLI_CODCAC ';
  strSQLGer := strSQLGer + ', CADCLI.CLI_FANSOB ';
  strSQLGer := strSQLGer + ', CADCLI.CLI_ORIENT ';
  strSQLGer := strSQLGer + ', CAC.CAC_CORILP ';
  strSQLGer := strSQLGer + ', CONCAT(CND.CND_CODIGO,''-'',CND.CND_DESCRI) AS CNDDESCRICAO ';

  strSQLGer := strSQLGer + ', CAST("" AS CHAR(1)) AS GER_TIPENT ';
  strSQLGer := strSQLGer + ', CAST("" AS CHAR(3)) AS GER_CODFIL ';

  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_ENDCON_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_BAIRRO_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_CEPCON_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'CID_CODCID_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_NOMCID_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_ESTADO_BAK ';
  strSQLGer := strSQLGer + CAMPO_STRING_255 + 'GER_REFCON_BAK ';
  strSQLGer := strSQLGer + ', MOVDET.DET_CLAFIS ';
  strSQLGer := strSQLGer + ', ' + fSQLBarDoc('GER') + ' AS BARDOC ';

  strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_ALTEND ';
  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(1)) AS BKP_ALTEND ';
  strSQLGer := strSQLGer + ', CAST("N" AS CHAR(1)) AS GER_INTFUS ';
  strSQLGer := strSQLGer + ', CAST(" " AS CHAR(20)) AS GER_ROMFUS ';
  strSQLGer := strSQLGer + ', CAST(NULL AS DATE) AS GER_DTAINI ';
  strSQLGer := strSQLGer + ', CAST(NULL AS DATE) AS GER_HORINI ';

  strSQLGer := strSQLGer + 'FROM ';
  strSQLGer := strSQLGer + '  MOVGER ';
  strSQLGer := strSQLGer + '  INNER JOIN MOVDET   ON MOVDET.DET_SEQGER = MOVGER.AUTOINCREM ';
  strSQLGer := strSQLGer + '  INNER JOIN MOVTRI   ON MOVDET.AUTOINCREM = MOVTRI.DET_SEQGER ';
  strSQLGer := strSQLGer + '  INNER JOIN CADCLI   ON GER_CODCLI        = CLI_CODCLI ';
  strSQLGer := strSQLGer + '  INNER JOIN CADCID   ON CADCID.CID_CODCID = IF(GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) ';
  strSQLGer := strSQLGer + '  INNER JOIN CADITE I ON I.ITE_CODITE      = DET_CODITE ';
  strSQLGer := strSQLGer + '   LEFT JOIN CADTRA   ON GER_CODTRA        = CADTRA.TRA_CODTRA ';
  strSQLGer := strSQLGer + '   LEFT JOIN CADFPG   ON GER_CODFPG        = FPG_CODIGO ';

  strSQLGer := strSQLGer + '  LEFT JOIN CADFIS ON FIS_NUMDOC = GER_NUMDOC ';
  strSQLGer := strSQLGer + '                  AND FIS_ESPDOC = GER_ESPDOC ';
  strSQLGer := strSQLGer + '                  AND FIS_CODEMP = GER_CODEMP ';
  strSQLGer := strSQLGer + '                  AND FIS_FORCLI = GER_CODCLI ';
  strSQLGer := strSQLGer + '                  AND FIS_TIP_FC = GER_TIP_FC ';

  {**************************************}
  {* OBTEM O ENDEREÇO DE ENTREGA MOVGER *}
  {************************************FC}
  strSQLGer := strSQLGer + 'LEFT JOIN AUXMOV         ON (AUXMOV.AUX_SEQGER  = MOVGER.AUTOINCREM) ';
  strSQLGer := strSQLGer + 'LEFT JOIN MOVOBS         ON (MOVOBS.MOV_SEQGER  = MOVGER.AUTOINCREM) ';
  strSQLGer := strSQLGer + 'LEFT JOIN ENTCLI ECMOV   ON (ECMOV.AUTOINCREM   = AUXMOV.AUX_ENTGER) ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADCID CIDCLIG ON (CIDCLIG.CID_CODCID = ECMOV.ETC_CIDENT)  ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADTRA TRAMOV  ON (ECMOV.ETC_CODTRA   = TRAMOV.TRA_CODTRA) ';

  // ** CADREG REGIAO **
  strSQLGer := strSQLGer + 'LEFT JOIN CADREG ON  (REG_CODREG = IF( ECMOV.ETC_CODREG IS NULL, CADCLI.CLI_CODREG, ECMOV.ETC_CODREG) ) ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADSUB ON (SUB_CODSUB = CADCLI.CLI_CODSUB) ';

  // ** DEPARTAMENTO VENDEDOR **
  strSQLGer := strSQLGer + 'LEFT JOIN CADOPE ON CADOPE.OPE_CODOPE = MOVGER.GER_CODVEN ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADDEP ON CADDEP.DEP_CODIGO = CADOPE.OPE_CODDEP ';

  strSQLGer := strSQLGer + 'LEFT JOIN CADCAC CAC ON CAC.CAC_CODCAC = CLI_CODCAC   ';
  strSQLGer := strSQLGer + 'LEFT JOIN CADCND CND ON CND.CND_CODIGO = MOVGER.GER_CODCND   ';

  strSQLGer := strSQLGer + fJoinFatGor_ExtGor('MOVDET');

  //Entrega (Rota) selecionada
  If fCfgSis('ROTROM', varString) = '2' Then
  begin
    strSQLGer := strSQLGer + 'LEFT JOIN ENTREG         ON  (ENT_CODIGO = EXTGOR.FGO_CODROT)                      ';
    if fCfgSis('ROTEMP', varBoolean) then
      strSQLGer := strSQLGer + ' AND ENT_CODEMP = FATGOR.FGO_CODEMP ';
  end;

  strSQLGer := strSQLGer + 'WHERE ';

  If (fEhRomaneioSimplificado) Then
  Begin
    If (fUsaModeloOuFoiIdentificadoBipagemChaveAcesso) Then
    Begin
      strSQLGer := strSQLGer + '  FIS_ACESSO = :ACESSO ';
    End
    Else
    Begin
      strSQLGer := strSQLGer + '      GER_NUMDOC = :NUMDOC ';
      strSQLGer := strSQLGer + '  AND GER_ESPDOC = :ESPDOC ';
      strSQLGer := strSQLGer + '  AND GER_CODEMP = :CODEMP ';
    End;
  End
  Else
  Begin

    strSQLGer := strSQLGer + '      GER_ENTFUT = "N"   ';
    strSQLGer := strSQLGer + '  AND GER_ENTFAT = "S"   ';
    strSQLGer := strSQLGer + '  AND ' + fRetCondicaoCFOP('GER_CLAFIS');
    strSQLGer := strSQLGer + '  AND GER_NUMROM IS NULL ';
    strSQLGer := strSQLGer + '  AND IFNULL(DET_CODEXT,"") = "" ';

    If (blnRegCid) And (Not fEmptyStr(edtCodRot.Text)) Then
      strSQLGer := strSQLGer + fStrLocate(edtCodRot, arrRotReg, 'EXTGOR.FGO_CODROT','CODROT');

    If (Not fEmptyStr(fTiraCaracEspeciais(mskDtaIni.Text))) Then
      strSQLGer := strSQLGer + ' AND ' + IIF(rdbEntrega.Checked, 'GER_DTENTR', 'GER_DTAENT') + ' BETWEEN :DTAINI AND :DTAFIN '
    Else
      strSQLGer := strSQLGer + ' AND GER_DTAENT >= ' + fDateSql(VS_Date - fCfgSis('DIAROM', varInteger)) + ' ';

    If (chkSomenteCliFil.Checked) Then
      strSQLGer := strSQLGer + ' AND GER_CODCLI IN ('+fRetClientesFilial+') ';

    strSQLGer := strSQLGer + fStrLocate(edtCodCid    , arrCidade  , 'IF(GER_CIDCON IS NULL, IF(IFNULL(ECMOV.ETC_CIDENT,"") <> "", ECMOV.ETC_CIDENT, CLI_CODCID), GER_CIDCON)','CODCID');
    strSQLGer := strSQLGer + fStrLocate(edtCodTra    , arrTransp  , 'IF(IFNULL(ECMOV.ETC_CODTRA,"") = "", GER_CODTRA, ECMOV.ETC_CODTRA)','CODTRA');
    strSQLGer := strSQLGer + fStrLocate(edtTraFat    , arrTraFat  , 'GER_CODTRA', 'TRAFAT');
    strSQLGer := strSQLGer + fStrLocate(edtCodReg    , arrRegiao  , 'ECMOV.ETC_CODREG', 'CODREG');
    strSQLGer := strSQLGer + fStrLocate(edtCodVen    , arrVended  , 'GER_CODVEN', 'CODVEN');
    strSQLGer := strSQLGer + fStrLocate(edtCodDep    , arrDepVen  , 'DEP_CODIGO', 'CODDEP');
    strSQLGer := strSQLGer + fStrLocate(edtCodCliente, arrClientes, 'GER_CODCLI', 'CODCLI');
    strSQLGer := strSQLGer + fStrLocate(edtCodProduto, arrProdutos, 'DET_CODITE', 'CODITE');
    If blnRegCid Then
      strSQLGer := strSQLGer + fStrLocate(edtCodTip,arrTipAte,'FGO_CODTPA', 'CODTPA');

    {*****************************************}
    {* FILTRO DE LINHA E GRUPO               *}
    {**************************************MV*}
    strSQLGer := strSQLGer + fSQLFiltroLinGru('DET');

    if (pnlLoteSep.Visible) And  not fEmptyStr(edtCodLot.Text) then
    Begin
      strSQLGer := strSQLGer + ' AND EXISTS ( SELECT RLD_NUMDOC FROM ROMLGE                        ';
      strSQLGer := strSQLGer + '              INNER JOIN ROMLDE ON RLD_SEQRLG = ROMLGE.AUTOINCREM  ';
      strSQLGer := strSQLGer + '              WHERE RLG_NUMLOT = '+QuotedStr(edtCodLot.Text) ;
      strSQLGer := strSQLGer + '                AND RLG_CODEMP = '+QuotedStr(VS_strCodEmp);
      strSQLGer := strSQLGer + '                AND RLD_NUMDOC = DET_NUM_PD                        ';
      strSQLGer := strSQLGer + '                AND RLD_ESPDOC = DET_ESP_PD                        ';
      strSQLGer := strSQLGer + '                AND RLD_CODEMP = DET_EMP_PD )                      ';
    End;

  End;

  If fCfgSis('UTITDE', varBoolean) Then
  Begin
    strSQLGer := strSQLGer + '  AND NOT EXISTS(SELECT TRA.AUTOINCREM ';
    strSQLGer := strSQLGer + '                   FROM ROMGERX GERX ';
    strSQLGer := strSQLGer + '                  INNER JOIN ROMTRAX TRA ON TRA.TRA_SEQGER = GERX.AUTOINCREM ';
    strSQLGer := strSQLGer + '                  WHERE GERX.GER_CODEMP = MOVGER.GER_CODEMP ';
    strSQLGer := strSQLGer + '                    AND GERX.GER_NUMDOC = MOVGER.GER_NUMDOC ';
    strSQLGer := strSQLGer + '                    AND GERX.GER_ESPDOC = MOVGER.GER_ESPDOC ';
    strSQLGer := strSQLGer + '  ) ';
  End;

  If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
    strSQLGer := strSQLGer + '  AND DET_PROEMB <> "S" ';

  If fCfgSis('CLBUEF',varboolean) Then
    strSQLGer := strSQLGer + '  AND DET_CLIBUS = "N" ';

  strSQLGer := strSQLGer + '  AND GER_JAFATU = 0    ';
  strSQLGer := strSQLGer + '  AND GER_ESPDOC = "BR" ';
  strSQLGer := strSQLGer + '  AND IF( GER_CIDCON IS NULL, CLI_CODCID, GER_CIDCON) = CADCID.CID_CODCID ';

  if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) then
  begin
    strSQLGer := strSQLGer + ' AND (' + fRetSQLFiltroEmpresas('DET_EMP_PD') + ') ';
    strSQLGer := strSQLGer + ' AND GER_CODEMP = '+QuotedStr(VS_strCodEmp)+' ';
  end
  else
    strSQLGer := strSQLGer + ' AND (' + fRetSQLFiltroEmpresas('GER_CODEMP') + ') ';

  strSQLGer := strSQLGer + fDocumentoRemovidoNaoConferidoVolume('MOVGER', 'GER');

  strSQLGer := strSQLGer + ' GROUP BY MOVDET.DET_SEQGER ';

  strSQLGer := strSQLGer + fRetornaWhereTurno();
  strSQLGer := strSQLGer + fGetWhereDocsExpedidos('MOVGER');

  Result := strSQLGer;

end;

function TfrmFatRomaneio.fSQLCampo(strCampo1, strCampo2, strAlias: String): String;
begin
  If Not fEmptyStr(strAlias) Then
    strAlias := strAlias + '.';

  If fUsaRomaneioDocsExpedidos Then
  Begin
    If LeftStr(strCampo1, 3) = 'DET' Then
      Result := ' SUM((' + strCampo1 + ' / DET_QTDITE) * (DET_QTDEXP - IFNULL(DET_QTDROM, 0))) '
    Else
      Result := '((' + strAlias + strCampo1 + ' / SUM(DET_QTDITE)) * SUM(DET_QTDEXP - IFNULL(DET_QTDROM, 0))) ';
  End
  Else
  Begin
    If fEmptyStr(strCampo2) Then
      Result := ' ' + strAlias + strCampo1 + ' '
    Else
      Result := ' ' + strAlias + strCampo2 + ' ';
  End;
end;

function TfrmFatRomaneio.fSQLFiltroLinGru(strPrefixo: String): String;
begin
  Result := '';
  If (Not fEmptyStr(fTiraCaracEspeciais(edtLinGru.Text))) Then
  Begin
    Result := Result + fStrLocateLinGru(edtLinGru, arrLinGru, 'I.ITE_CODGRU', 'CODGRU');

    Result := Result + ' AND ' + strPrefixo + '_QTDITE > ' + strPrefixo + '_QTDROM ';
  End;
end;

