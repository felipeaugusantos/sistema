procedure TfrmFatRomaneio.btnRomaneioPorVolumesClick(Sender: TObject);
var
  blnResult: Boolean;
  blnConfirma: Boolean;
begin
  inherited;
  If (fMensagem('', 'Deseja gera romaneio usando código de barras de volumes?', ['&Sim', '&Não']) = 1) Then
  Begin
    pCancelaInclusao(False);

    frmFatRomaneioCaixas := TfrmFatRomaneioCaixas.Create(Self);
    blnResult        := (frmFatRomaneioCaixas.ShowModal = mrOK);
    strDocCaixa      :=  frmFatRomaneioCaixas.strDocumentos;
    strDocCaixaTrans :=  frmFatRomaneioCaixas.edtCodTra.Text;
    frmFatRomaneioCaixas.Free;

    If blnResult Then
    Begin
      If not fEmptyStr( strDocCaixa ) Then
      Begin
        btnFiltrar.Click;

        With cdsTmpDoc Do
        Begin
          DisableControls;
          While not eof do
          Begin
            pSelecionaDocumento;
            Next;
          End;
          EnableControls;
        End;
        blnConfirma := btnConfirma.Visible;
        btnConfirma.Visible := True;
        btnConfirma.Click;
        btnConfirma.Visible := blnConfirma;
      End;
    End
    Else
      pCancelaInclusao(False);
  End
  Else If rdbEntrada.Checked Then
    pSetFocus(rdbEntrada)
  Else
    pSetFocus(rdbEntrega);

end;

