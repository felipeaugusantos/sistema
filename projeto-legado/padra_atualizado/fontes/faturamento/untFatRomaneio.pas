      If (Pos(cdsTmpDoc.FieldByName('GER_ESPDOC').AsString, 'EP_GC_BR_') = 0) Then
        strSQL := strSQL + '  RIGHT(DET_CLAFIS, 3) <> "999" AND ';

      strSQL := strSQL + '  DET_TIP_FC = "C" AND ';
      strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '  DET_CODEMP = :CODEMP ';

      strSQL := strSQL + fSQLFiltroLinGru('DET');

      strSQL := strSQL + 'GROUP BY ';
      strSQL := strSQL + '  DET_CODITE, DET_DESCRI, IFNULL(DET_NUMLOT, "") ';

      If fAgrupaPorAutoIncrem(cdsTmpDoc.FieldByName('GER_CLAFIS').AsString, blnDocTemItemRepetido) Then
        strSQL := strSQL + '  ,MOVDET.AUTOINCREM ';

      strSQL := strSQL + '  ';
      strSQL := strSQL + 'UNION ALL ';
      strSQL := strSQL + '  ';
      strSQL := strSQL + 'SELECT ';
      strSQL := strSQL + '  ' + cdsTmpDoc.FieldByName('INCREMENTO').AsString + ' DET_SEQGER, ';

      strSQL := strSQL + '  DET_NUMDOC, ';
      strSQL := strSQL + '  DET_ESPDOC, ';
      strSQL := strSQL + '  DET_CODEMP, ';
      strSQL := strSQL + '  DET_CODITE, ';
      strSQL := strSQL + '  DET_EMP_PD AS DET_EMPORI, ';
      strSQL := strSQL + '  DET_DESCRI DET_DESITE, ';

      If fUsaRomaneioDocsExpedidos Then
      Begin
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0) - IFNULL(DET_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0) - IFNULL(DET_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0) - IFNULL(DET_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(COALESCE(DET_QTDEXP, 0))              DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)                           DET_QTDTOT_REAL, ';
      End
      Else
      Begin
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDITE, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDBAI, ';
        strSQL := strSQL + '  SUM(DET_QTDITE - IFNULL(DET_QTDROM, 0)) DET_QTDTMP, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)              DET_QTDTOT, ';
        strSQL := strSQL + '  SUM(DET_QTDITE)              DET_QTDTOT_REAL, ';
      End;

      strSQL := strSQL + '  DET_TOTFRE, ';
      strSQL := strSQL + '  DET_DESACE, ';
      strSQL := strSQL + '  DET_UNITAR, ';
      strSQL := strSQL + '  DET_DESESP, ';
      strSQL := strSQL + '  NOTDET.AUTOINCREM DET_AUTINC, ';
      strSQL := strSQL + '  CAST("" AS CHAR(20)) AS DET_AUTINC_DOCTRA, ';
      strSQL := strSQL + '  " " AS DET_INFITE, ';
      strSQL := strSQL + '  "N" AS DET_SEPIMP, ';
      strSQL := strSQL + '  DET_NUMLOT, ';
      strSQL := strSQL + '  "C" DET_TIP_FC,  ';
      strSQL := strSQL + '  DET_CODCLI,      ';

      If fUsaRomaneioDocsExpedidos Then
        strSQL := strSQL + '  SUM((DET_TOTPES / DET_QTDITE) * (COALESCE(DET_QTDEXP, 0) - COALESCE(DET_QTDROM, 0))) AS DET_TOTPES, '
      Else
        strSQL := strSQL + '  SUM(DET_TOTPES) AS DET_TOTPES, ';

      strSQL := strSQL + '  IF(LEFT(DET_CLAFIS,1) >= "5", "S", "E") DET_ENTSAI, ';
      strSQL := strSQL + '  DET_TURENT AS TURENT, ';
      strSQL := strSQL + '  UNI_SIGUNI AS DET_UNIDAD, ';
      strSQL := strSQL + '  SUM(DET_TOTPES) AS DET_VLTOPE ';
      strSQL := strSQL + 'FROM ';
      strSQL := strSQL + '  NOTDET ';
      strSQL := strSQL + '  JOIN CADITE I ON ITE_CODITE = DET_CODITE ';
      strSQL := strSQL + '  JOIN NOTTRI   ON NOTDET.AUTOINCREM = NOTTRI.DET_SEQGER ';
      strSQL := strSQL + '  LEFT JOIN CADUNI ON NOTDET.DET_UNIDAD = CADUNI.UNI_CODUNI ';
      strSQL := strSQL + 'WHERE ';
      strSQL := strSQL + '  DET_CODITE <> :ITESER AND ';
      strSQL := strSQL + '  DET_CODITE <> :SERTER AND ';
  //    strSQL := strSQL + '  LEFT(DET_CLAFIS, 1) >= 5 AND ';

      If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString = 'TR') Then
      Begin
        If (cdsTmpDoc.FieldByName('GER_ENTSAI').AsString = 'E') Then
          strSQL := strSQL + '  LEFT(DET_CLAFIS, 1) < 5 AND '
        Else
          strSQL := strSQL + '  LEFT(DET_CLAFIS, 1) >= 5 AND ';
      End;

      If (fCfgSis('EFTEST') = '2') And (fCfgSis('EFTESE') = '1') Then
        strSQL := strSQL + '  DET_PROEMB <> "S" AND ';

      If (Pos(cdsTmpDoc.FieldByName('GER_ESPDOC').AsString, 'EP_GC_BR_') = 0) Then
        strSQL := strSQL + '  RIGHT(DET_CLAFIS, 3) <> "999" AND ';

      strSQL := strSQL + '  DET_TIP_FC = "C" AND ';
      strSQL := strSQL + '  DET_NUMDOC = :NUMDOC AND ';
      strSQL := strSQL + '  DET_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '  DET_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '  DET_CODEMP = :CODEMP ';

      strSQL := strSQL + fSQLFiltroLinGru('DET');

      strSQL := strSQL + 'GROUP BY ';
      strSQL := strSQL + '  DET_CODITE, DET_DESCRI, IFNULL(DET_NUMLOT, "") ';

      If fAgrupaPorAutoIncrem(cdsTmpDoc.FieldByName('GER_CLAFIS').AsString, blnDocTemItemRepetido) Then
       strSQL := strSQL + '  ,NOTDET.AUTOINCREM ';
    End;

    With qryGenDet Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      if fEmptyStr(cdsTmpDoc.FieldByName('ROMTRA').AsString) then
      begin
        ParamByName('ITESER').AsString := fCfgSis('ITESER');
        ParamByName('SERTER').AsString := fCfgSis('SERTER');
        ParamByName('NUMDOC').AsString := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
        ParamByName('ESPDOC').AsString := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
        ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
        ParamByName('CODEMP').AsString := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
      end
      else
        ParamByName('AUTINC').AsString := cdsTmpDoc.FieldByName('ROMTRA').AsString;

      Open;

      pCopiaParaTemporaria(qryGenDet, cdsRomDet, tpcRomDet, False);

      Close;
    End;

    If (cdsTmpDoc.FieldByName('GER_ESPDOC').AsString <> 'GC') Then
      pDeletaCdsRomDetQtdBaiZerado;

    if (fEntraDevolucoes In [tdListaResidualDaDevolucaoNF,tdListaTodasDevolucoesAbatendoQtdDevolvida]) then
      pAtualizaDadosParaRomaneioBaseadoEmDevolucoes(cdsRomDet, True);

    if (rdgEmpresa.Enabled) and (rdgEmpresa.ItemIndex = 1) and (not fEmptyStr(edtCodEmp.Text)) then
      pAjustaItensEmpresaOri(cdsRomDet);
  Finally
    FreeAndNil(qryGenDet);

    cdsRomDet.Filtered := False;
    cdsRomDet.Filter   := 'DET_SEQGER = ' + QuotedStr(cdsTmpDoc.FieldByName('INCREMENTO').AsString);
    cdsRomDet.Filtered := True;
  End;
end;

procedure TfrmFatRomaneio.pDeletaCdsRomDetQtdBaiZerado;
  Var
    strFiltro   : String;
    blnFiltrado : Boolean;
begin
  strFiltro   := cdsRomDet.Filter;
  blnFiltrado := cdsRomDet.Filtered;

  cdsRomDet.DisableControls;

  cdsRomDet.Filter   := '';
  cdsRomDet.Filtered := False;

  With cdsRomDet Do
  Begin
    First;
    While Not Eof Do
    Begin

      If FieldByName('DET_QTDBAI').AsFloat <= 0.0 Then
      Begin
        Delete;
        Continue;
      End;
    
      Next;
    End;
  End;

  cdsRomDet.Filter   := strFiltro;
  cdsRomDet.Filtered := blnFiltrado;
  cdsRomDet.EnableControls;
end;

procedure TfrmFatRomaneio.pDeletaDadosRestauracao;
var
  LDadosDet: TDadosDet;
begin
  LDadosDet.NumeroDocumento  := cdsTmpDoc.FieldByName('GER_DOCORI').AsString;
  LDadosDet.EspecieDocumento := cdsTmpDoc.FieldByName('GER_ESPDOC').AsString;
  LDadosDet.CodEmpresa       := cdsTmpDoc.FieldByName('GER_CODEMP').AsString;
  LDadosDet.CodCliente       := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
  LDadosDet.Tip_FC           := cdsTmpDoc.FieldByName('GER_TIP_FC').AsString;

  TRomaneioRecuperacaoApagar.Apagar(FIdRestauracao, LDadosDet);
end;

procedure TfrmFatRomaneio.pDeletaDadosRomDet;
begin
  cdsRomDet.DisableControls;

  cdsRomDet.Filtered := False;
  cdsRomDet.Filter   := '';

  With cdsRomDet Do
  Begin
    First;
    While Not Eof Do
    Begin

      If (FieldByName('DET_SEQGER').AsString = cdsTmpDoc.FieldByName('INCREMENTO').AsString) And
         (FieldByName('DET_DELETA').IsNull) Then
      Begin
        Delete;
        Continue;
      End;
    
      Next;
    End;
  End;

  cdsRomDet.First;
  cdsRomDet.EnableControls;
end;

procedure TfrmFatRomaneio.pDeletaDocsZeradosNaoExpedido;
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  With cdsTmpDoc Do
  Begin
    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

    If blnWasEnabled Then
      pDisableControls(cdsTmpDoc, prcScroll);

    Filtered := False;
    Filter   := '';
    Filtered := True;

    First;
    While Not Eof Do
    Begin
      If (fFormataFloat(FieldByName('GER_VLRCON').AsFloat, 2) <= 0.00) And
         (Pos(FieldByName('GER_ESPDOC').AsString, 'OX_BR') <= 0) Then
      Begin
        Delete;
        Continue;
      End;

      Next;
    End;

    Filter   := '';
    Filtered := False;

    If blnWasEnabled Then
      pEnableControls(cdsTmpDoc, prcScroll);
  End;
end;

procedure TfrmFatRomaneio.pValidaConsulta;
begin
  If (Not Assigned(cdsTmpMantemSelecionado)) And (Assigned(cdsTmpDoc)) And (cdsTmpDoc.FieldDefs.Count > 0) Then
  Begin
    cdsTmpMantemSelecionado := TUniClientDataSet.Create(Self);
    cdsTmpMantemSelecionado.FieldDefs.Assign(cdsTmpDoc.FieldDefs);
    cdsTmpMantemSelecionado.CreateDataSet;
  End;

  If (cdsTmpDoc.IsEmpty) Then
  Begin
    If fEhRomaneioSimplificado And (fEmptyStr(edtNumRom.Text)) Then {<<-- Modo de inclusão no simplificado!}
    Begin
      pHabilitaNumRom(False);
      pSetFocus(edtCodBar);
    End
    Else
    Begin
      fMensagem('', 'Não há documentos com esses dados!', ['&OK']);
      pCancelaInclusao(False);
    End;

  End
  Else
  Begin
    pVerificaPedidosEmAndamento(edtNumRom.Text, VS_strCodEmp);
    pHabilitaNumRom(False);

    If (fEhRomaneioSimplificado) Then
      pSetFocus(edtCodBar)
    Else
      pSetFocus(dbgDocumentos);

    btnPadrao.Visible := fVerificaAcessoSistema('frmConsultaCxGridNova');

    If Not blnLoadView Then
      dbgDocumentosDBView.ApplyBestFit();
  End;

  pBotaoConfigurar;
  pEsconderColunas;
end;

procedure TfrmFatRomaneio.pVerificaDocumentosCliente;
var
  LQry: TUniQuery;
  frmAvisoDocumentoCliente: TfrmAvisoDocumentoCliente;
begin
  if (Pos('CONSUMIDOR', fRetNomCliente(cdsTmpDoc.FieldByName('GER_CODCLI').AsString)) > 0) then
    Exit;

  LQry := fCriaQuery;
  try
    // OUTRO PEDIDO DE VENDA, NAO FATURADO, FGO_EMPEXP = LOGADA, DO MESMO CLIENTE, PARA ENTREGA IMEDIATA, QUE NAO ESTA EM NENHUM ROMANEIO AINDA.
    LQry.SQL.Add('SELECT ');
    LQry.SQL.Add('  FGO_DTAENT AS DTAEMI,');
    LQry.SQL.Add('  FGO_DTENTR AS DTAENT,');
    LQry.SQL.Add('  CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC, "-", FGO_CODEMP) AS DOCUME,');
    LQry.SQL.Add('  FGO_EMPFAT AS EMPFAT,');
    LQry.SQL.Add('  FGO_CODVEN AS CODVEN,');
    LQry.SQL.Add('  FGO_PESBRU AS PESTOT,');
    LQry.SQL.Add('  IF(AUX_SEQGER IS NULL,');
    LQry.SQL.Add('    CONCAT(FGO_ENDCON, " - ", FGO_BAICON, " - ", CID_NOMCID, " - ", CID_ESTADO),');
    LQry.SQL.Add('    CONCAT(ETC_ENDENT, " - ", ETC_BAIENT, " - ", CID_NOMCID, " - ", CID_ESTADO)');
    LQry.SQL.Add('  ) AS ENDENT ');
    LQry.SQL.Add('FROM FATGOR');
    LQry.SQL.Add('LEFT JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM   ');
    LQry.SQL.Add('LEFT JOIN AUXGOR ON AUX_SEQGER = FATGOR.AUTOINCREM ');
    LQry.SQL.Add('LEFT JOIN ENTCLI ON ENTCLI.AUTOINCREM = AUX_ENTGER ');
    LQry.SQL.Add('LEFT JOIN CADCID ON CADCID.CID_CODCID = IFNULL(ETC_CIDENT, FGO_CIDCON)');
    LQry.SQL.Add('WHERE FGO_ESPDOC = "PD" ');
    LQry.SQL.Add('  AND FGO_JAFATU = 0 ');
    if (fCfgSis('RMPDAV', varInteger) = 1) then
      LQry.SQL.Add('  AND FGO_EMPEXP = :CODEMP ');
    LQry.SQL.Add('  AND FGO_CODCLI = :CODCLI ');
    LQry.SQL.Add('  AND IFNULL(FGO_ENTFUT, "N") = "N" ');
    LQry.SQL.Add('  AND FGO_ENTFAT = "S" ');
    LQry.SQL.Add('  AND IFNULL(FGO_NUMROM, "") = "" ');
    LQry.SQL.Add('  AND CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC, "-", FGO_CODEMP) <> :DOCUME');

    LQry.SQL.Add('  ');
    LQry.SQL.Add(' UNION ALL   ');
    LQry.SQL.Add(' ');

    // DOCUMENTO FATURADO, FGO_CODEMP = LOGADA, DO MESMO CLIENTE, PARA ENTREGA IMEDIATA, NA DATA DE HOJE.
    LQry.SQL.Add('SELECT ');
    LQry.SQL.Add('  GER_DTAENT AS DTAEMI,');
    LQry.SQL.Add('  GER_DTENTR AS DTAENT,');
    LQry.SQL.Add('  CONCAT(GER_NUMDOC, "-", GER_ESPDOC, "-", GER_CODEMP) AS DOCUME,');
    LQry.SQL.Add('  GER_EMPFAT AS EMPFAT,');
    LQry.SQL.Add('  GER_CODVEN AS CODVEN,');
    LQry.SQL.Add('  GER_PESBRU AS PESTOT,');
    LQry.SQL.Add('  IF(AUX_ENTGER IS NULL,');
    LQry.SQL.Add('    CONCAT(GER_ENDCON, " - ", GER_BAICON, " - ", CID_NOMCID, " - ", CID_ESTADO),');
    LQry.SQL.Add('    CONCAT(ETC_ENDENT, " - ", ETC_BAIENT, " - ", CID_NOMCID, " - ", CID_ESTADO)');
    LQry.SQL.Add('  ) AS ENDENT  ');
    LQry.SQL.Add('FROM MOVGER ');
    LQry.SQL.Add('LEFT JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM ');
    LQry.SQL.Add('LEFT JOIN ENTCLI ON ENTCLI.AUTOINCREM = AUX_ENTGER ');
    LQry.SQL.Add('LEFT JOIN CADCID ON CADCID.CID_CODCID = IFNULL(ETC_CIDENT, GER_CIDCON)');
    LQry.SQL.Add(' WHERE GER_CODCLI = :CODCLI ');
    if (fCfgSis('RMPDAV', varInteger) = 1) then
      LQry.SQL.Add('   AND GER_CODEMP = :CODEMP ');
    LQry.SQL.Add('   AND IFNULL(GER_ENTFUT, "N") = "N" ');
    LQry.SQL.Add('   AND GER_ENTFAT = "S" ');
    LQry.SQL.Add('   AND GER_DTAENT = CURRENT_DATE; ');

    if (fCfgSis('RMPDAV', varInteger) = 1) then
      LQry.ParamByName('CODEMP').AsString := VS_strCodEmp;

    LQry.ParamByName('CODCLI').AsString := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
    LQry.ParamByName('DOCUME').AsString :=
      cdsTmpDoc.FieldByName('GER_DOCORI').AsString + '-' +
      cdsTmpDoc.FieldByName('GER_ESPDOC').AsString + '-' +
      cdsTmpDoc.FieldByName('GER_CODEMP').AsString;

    LQry.Open;

    if LQry.RecordCount > 0 then
    begin
      TFloatField(LQry.FieldByName('PESTOT')).DisplayFormat := '#,##0.000';

      pCriarFormularios(TfrmAvisoDocumentoCliente, frmAvisoDocumentoCliente);
      try
        frmAvisoDocumentoCliente.edtCodCli.Text  := cdsTmpDoc.FieldByName('GER_CODCLI').AsString;
        frmAvisoDocumentoCliente.btnConfirma.Visible := fCfgSis('CLIDOC', varBoolean);
        frmAvisoDocumentoCliente.edtNomCli.Text :=  fRetNomCliente(cdsTmpDoc.FieldByName('GER_CODCLI').AsString);
        frmAvisoDocumentoCliente.dsDados.DataSet := LQry;
        frmAvisoDocumentoCliente.ShowModal;
      finally
        pFreeAndNil(frmAvisoDocumentoCliente);
      end;
    end;
  finally
    FreeAndNil(LQry);
  end;
end;

function TfrmFatRomaneio.fSelecionaDocumentosCliente(strCodCliente: string): boolean;
const
  DOCUME = 'CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC, "-", FGO_CODEMP, "-", IF(LEFT(FDO_CLAFIS, 1) >= "5", "S", "E"))';
var
  intContador : integer;
  strDocumento: String;
  LQry: TUniQuery;
  frmAvisoDocumentoCliente: TfrmAvisoDocumentoCliente;
  qryTempDocs: TUniClientDataset;
begin
  Result := False;

  if (Pos('CONSUMIDOR', fRetNomCliente(strCodCliente)) > 0) then
    Exit;

  try
    qryTempDocs := TUniClientDataSet.Create(nil);
    pCloneDataSet(qryTempDocs, cdsTmpDoc);
    strDocumento := EmptyStr;
    qryTempDocs.First;

    for intContador := 0 to qryTempDocs.RecordCount - 1 do
    begin
      if (qryTempDocs.FieldByName('GER_CODCLI').AsString = strCodCliente) and (qryTempDocs.FieldByName('GER_MARDES').AsString = 'D') then
      begin
        if strDocumento <> EmptyStr then
          strDocumento := strDocumento + ', ';
        strDocumento := strDocumento + QuotedStr(qryTempDocs.FieldByName('GER_DOCORI').AsString + '-' +
                                       qryTempDocs.FieldByName('GER_ESPDOC').AsString + '-' +
                                       qryTempDocs.FieldByName('GER_CODEMP').AsString+ '-' +
                                       qryTempDocs.FieldByName('GER_ENTSAI').AsString);
      end;
      qryTempDocs.Next;
    end;

    if strDocumento <> '' then
    begin
      LQry := fCriaQuery;
      LQry.SQL.Add('SELECT ');
      LQry.SQL.Add('  FGO_CODCLI AS CODCLI,');
      LQry.SQL.Add('  FGO_DTAENT AS DTAEMI,');
      LQry.SQL.Add('  FGO_DTENTR AS DTAENT,');
      LQry.SQL.Add('  ' + DOCUME + ' AS DOCUME,');
      LQry.SQL.Add('  FGO_EMPFAT AS EMPFAT,');
      LQry.SQL.Add('  FGO_CODVEN AS CODVEN,');
      LQry.SQL.Add('  FGO_PESBRU AS PESTOT,');
      LQry.SQL.Add('  IF(AUX_SEQGER IS NULL,');
      LQry.SQL.Add('    CONCAT(FGO_ENDCON, " - ", FGO_BAICON, " - ", CID_NOMCID, " - ", CID_ESTADO),');
      LQry.SQL.Add('    CONCAT(ETC_ENDENT, " - ", ETC_BAIENT, " - ", CID_NOMCID, " - ", CID_ESTADO)');
      LQry.SQL.Add('  ) AS ENDENT ');
      LQry.SQL.Add('FROM FATGOR');
      LQry.SQL.Add('LEFT JOIN EXTGOR ON FGO_SEQFGO = FATGOR.AUTOINCREM   ');
      LQry.SQL.Add('LEFT JOIN FATDOR ON FDO_SEQGER = FATGOR.AUTOINCREM ');
      LQry.SQL.Add('LEFT JOIN AUXGOR ON AUX_SEQGER = FATGOR.AUTOINCREM ');
      LQry.SQL.Add('LEFT JOIN ENTCLI ON ENTCLI.AUTOINCREM = AUX_ENTGER ');
      LQry.SQL.Add('LEFT JOIN CADCID ON CADCID.CID_CODCID = IFNULL(ETC_CIDENT, FGO_CIDCON)');
      LQry.SQL.Add('WHERE FGO_CODCLI = :CODCLI ');
      LQry.SQL.Add('  AND CONCAT(FGO_NUMDOC, "-", FGO_ESPDOC, "-", FGO_CODEMP, "-", IF(LEFT(FDO_CLAFIS, 1) >= "5", "S", "E")) IN ( ' + strDocumento + ' )');
      LQry.SQL.Add('GROUP BY ' + DOCUME);
      LQry.SQL.Add('  ');
      LQry.SQL.Add(' UNION ALL   ');
      LQry.SQL.Add(' ');
      LQry.SQL.Add('SELECT ');
      LQry.SQL.Add('  GER_CODCLI AS CODCLI,');
      LQry.SQL.Add('  GER_DTAENT AS DTAEMI,');
      LQry.SQL.Add('  GER_DTENTR AS DTAENT,');
      LQry.SQL.Add('  CONCAT(GER_NUMDOC, "-", GER_ESPDOC, "-", GER_CODEMP, "-", IF(LEFT(GER_CLAFIS, 1) >= "5", "S", "E")) AS DOCUME,');
      LQry.SQL.Add('  GER_EMPFAT AS EMPFAT,');
      LQry.SQL.Add('  GER_CODVEN AS CODVEN,');
      LQry.SQL.Add('  GER_PESBRU AS PESTOT,');
      LQry.SQL.Add('  IF(AUX_ENTGER IS NULL,');
      LQry.SQL.Add('    CONCAT(GER_ENDCON, " - ", GER_BAICON, " - ", CID_NOMCID, " - ", CID_ESTADO),');
      LQry.SQL.Add('    CONCAT(ETC_ENDENT, " - ", ETC_BAIENT, " - ", CID_NOMCID, " - ", CID_ESTADO)');
      LQry.SQL.Add('  ) AS ENDENT  ');
      LQry.SQL.Add('FROM MOVGER ');
      LQry.SQL.Add('LEFT JOIN AUXMOV ON AUX_SEQGER = MOVGER.AUTOINCREM ');
      LQry.SQL.Add('LEFT JOIN ENTCLI ON ENTCLI.AUTOINCREM = AUX_ENTGER ');
      LQry.SQL.Add('LEFT JOIN CADCID ON CADCID.CID_CODCID = IFNULL(ETC_CIDENT, GER_CIDCON)');
      LQry.SQL.Add(' WHERE GER_CODCLI = :CODCLI ');
      LQry.SQL.Add('   AND CONCAT(GER_NUMDOC, "-", GER_ESPDOC, "-", GER_CODEMP, "-", IF(LEFT(GER_CLAFIS, 1) >= "5", "S", "E"))  IN ( ' + strDocumento + ' )');
      LQry.SQL.Add('  ');
      LQry.SQL.Add(' UNION ALL   ');
      LQry.SQL.Add(' ');
      LQry.SQL.Add('SELECT');
      LQry.SQL.Add('  NG.GER_CODCLI AS CODCLI,');
      LQry.SQL.Add('  NG.GER_DTAENT AS DTAEMI,');
      LQry.SQL.Add('  NG.GER_DTENTR AS DTAENT,');
      LQry.SQL.Add('  CONCAT(NG.GER_NUMDOC, "-", NG.GER_ESPDOC, "-", NG.GER_CODEMP, "-", IF(LEFT(NG.GER_CLAFIS, 1) >= "5", "S", "E")) AS DOCUME,');
      LQry.SQL.Add('  NG.GER_EMPFAT,');
      LQry.SQL.Add('  NG.GER_CODVEN,');
      LQry.SQL.Add('  NG.GER_PESBRU AS PESTOT,');
      LQry.SQL.Add('  " " AS ENDENT');
      LQry.SQL.Add('FROM NOTGER NG');
      LQry.SQL.Add('INNER JOIN NOTDET ON NOTDET.DET_SEQGER = NG.AUTOINCREM');
      LQry.SQL.Add('INNER JOIN CADCLI ON NG.GER_CODCLI = CLI_CODCLI');
      LQry.SQL.Add('INNER JOIN CADCID ON CADCID.CID_CODCID =');
      LQry.SQL.Add('IF(NG.GER_CIDCON IS NULL,');
      LQry.SQL.Add('  CLI_CODCID,');
      LQry.SQL.Add('  NG.GER_CIDCON)');
      LQry.SQL.Add('WHERE NG.GER_CODCLI = :CODCLI');
      LQry.SQL.Add('AND CONCAT(NG.GER_NUMDOC, "-", NG.GER_ESPDOC, "-",NG.GER_CODEMP, "-", IF(LEFT(NG.GER_CLAFIS, 1) >= "5", "S", "E")) IN ( ' + strDocumento + ' )');
      LQry.ParamByName('CODCLI').AsString := strCodCliente;
      LQry.Open;

      if LQry.RecordCount > 1 then
      begin
        TFloatField(LQry.FieldByName('PESTOT')).DisplayFormat := '#,##0.000';
        pCriarFormularios(TfrmAvisoDocumentoCliente, frmAvisoDocumentoCliente);
        try
          frmAvisoDocumentoCliente.edtCodCli.Text := strCodCliente;
          frmAvisoDocumentoCliente.edtNomCli.Text := fRetNomCliente(strCodCliente);
          frmAvisoDocumentoCliente.btnConfirma.Visible := fCfgSis('CLIDOC', varBoolean);
          frmAvisoDocumentoCliente.dsDados.DataSet :=LQry;
          frmAvisoDocumentoCliente.ShowModal;
          if frmAvisoDocumentoCliente.ModalResult = mrOk then
            Result := True
          else
            Result := False;

          blnExibiuAvisoDocto := Result;
        finally
          pFreeAndNil(frmAvisoDocumentoCliente);
        end;
      end;
    end;
  finally
    FreeAndNil(LQry);
    FreeAndNil(qryTempDocs);
  end;
end;

procedure TfrmFatRomaneio.pVerificaDuplicados;
Var
  prcScroll: TprcScroll;
  blnWasEnabled: Boolean;
  cdsTmpLocal: TUniClientDataSet;
begin
  if not cdsTmpDoc.Active then
    Exit;

  cdsTmpLocal := TUniClientDataSet.Create(Self);
  try
    pCloneDataSet(cdsTmpLocal, cdsTmpDoc);
    cdsTmpLocal.DisableControls;

    blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

    Try
      If blnWasEnabled Then
        pDisableControls(cdsTmpDoc, prcScroll);

      cdsTmpLocal.First;

      While Not cdsTmpLocal.Eof Do
      Begin
        cdsTmpDoc.Filtered := False;
        cdsTmpDoc.Filter := '';
        cdsTmpDoc.Filter := cdsTmpDoc.Filter + 'GER_DOCORI = ' + QuotedStr(cdsTmpLocal.FieldByName('GER_DOCORI').AsString) + ' AND ';
        cdsTmpDoc.Filter := cdsTmpDoc.Filter + 'GER_ESPDOC = ' + QuotedStr(cdsTmpLocal.FieldByName('GER_ESPDOC').AsString) + ' AND ';
        cdsTmpDoc.Filter := cdsTmpDoc.Filter + 'GER_CODEMP = ' + QuotedStr(cdsTmpLocal.FieldByName('GER_CODEMP').AsString) + ' AND ';
        cdsTmpDoc.Filter := cdsTmpDoc.Filter + 'GER_CODCLI = ' + QuotedStr(cdsTmpLocal.FieldByName('GER_CODCLI').AsString) + ' AND ';
        cdsTmpDoc.Filter := cdsTmpDoc.Filter + 'GER_TIP_FC = ' + QuotedStr(cdsTmpLocal.FieldByName('GER_TIP_FC').AsString);
        cdsTmpDoc.Filtered := True;

        while cdsTmpDoc.RecordCount > 1 do
          cdsTmpDoc.Delete;

        cdsTmpLocal.Next;
      End;
      cdsTmpDoc.Filtered := False;
    Finally
      If blnWasEnabled Then
        pEnableControls(cdsTmpDoc, prcScroll);
    End;
  finally
    FreeAndNil(cdsTmpLocal);
  end;
end;

procedure TfrmFatRomaneio.pVerificaPedidosEmAndamento(strNumRom, strCodEmp: String);
 Var
   qryGen: TUniQuery;
   strMsg: String;
begin
  if fCfgSis('USPRRO', varBoolean) and fCfgSis('RMPDPA', varBoolean) then
    Exit;

  If Not strNumRom.IsEmpty Then
  Begin
    qryGen := fCriaQuery;
    Try
      qryGen.SQL.Text := 
        ' SELECT ' +
        '   FGO_NUMDOC                AS NUMDOC, ' +
        '   SUM(IFNULL(FDO_QTDSEP,0)) AS QTDSEP  ' +
        ' FROM ROMGERX R ' +
        '     INNER JOIN FATGOR G ON R.GER_CODEMP = G.FGO_CODEMP ' +
        '                        AND R.GER_NUMDOC = G.FGO_NUMDOC ' +
        '                        AND R.GER_ESPDOC = G.FGO_ESPDOC ' +
        '                        AND R.GER_CODCLI = G.FGO_CODCLI ' +
        '     INNER JOIN FATDOR D ON D.FDO_SEQGER = G.AUTOINCREM ' +
        '     INNER JOIN EXTDOR E ON E.FDO_SEQFDO = D.AUTOINCREM ' +
        ' WHERE ' +
        '    R.GER_STATUS = "P"     AND ' +
        '    R.GER_EMPROM = :EMPROM AND ' +
        '    R.GER_NUMROM = :NUMROM AND ' +
        '    G.FGO_JAFATU = 0           ' +
        ' GROUP BY FGO_NUMDOC ';  

      qryGen.ParamByName('NUMROM').AsString := strNumRom;
      qryGen.ParamByName('EMPROM').AsString := strCodEmp;
      qryGen.Open;
    
      If Not qryGen.IsEmpty Then
      Begin
        qryGen.First;
        While Not qryGen.Eof Do
        Begin
          If qryGen.FieldByName('QTDSEP').AsFloat > 0 Then
            strMsg := strMsg + #10#13 + 'PD ' + qryGen.FieldByName('NUMDOC').AsString + '   QTD.SEP.:' + fPadL(FormatFloat('#,####0.0000', qryGen.FieldByName('QTDSEP').AsFloat), 10);
          qryGen.Next;
        End;
      End;

      If Not strMsg.IsEmpty Then
      Begin
        fMensagem('Atenção!', 'Este romaneio tem pedidos com a separação em andamento/finalizada. '+
                              'Caso seja necessário alguma alteração no mesmo, entrar em contato '+
                              'com a equipe de separação.' + strMsg, ['&Ok'], 1, False, 1, 0, 
                              False, 0, False, False, False, 0, 0, qryGen.RecordCount);    
      End;
    Finally
      FreeAndNil(qryGen);
    End;
  End;
end;

