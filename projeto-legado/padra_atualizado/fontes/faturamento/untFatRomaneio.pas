procedure TfrmFatRomaneio.dbgDocumentosDBViewKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
  Var
    prcScroll: TprcScroll;
    blnWasEnabled: Boolean;
begin
  inherited;

 If (Shift <> [ssCtrl]) Then
  Begin
    If (Key = VK_ESCAPE) Then
    Begin
      If Assigned(cdsMaster) Then
        PostMessage(Handle, WM_MESSAGECANCELAINCLUSAO, 0, 0)
      Else
        pCancelaInclusao(True);
    End

    Else If (Key = VK_RETURN) Then
    Begin
      blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;
      Try
        If blnWasEnabled Then
          pDisableControls(cdsTmpDoc, prcScroll);

        If Assigned(cdsMaster) Then
        Begin
          If (Not blnDocumentoEmSelecao) Then
          Begin
            PostMessage(Handle, WM_MESSAGESELECIONADOCUMENTO, 0, 0);
          End;
        End
        Else If (Not fCfgSis('CLIDOC', varBoolean)) Then
        begin
          pSelecionaDocumento;
          pGravaSelecionados;
        end
        Else If (fCfgSis('CLIDOC', varBoolean)) Then
        begin
          pSelecionaTodosDocCliente;
        end;

      Finally
        If blnWasEnabled Then
          pEnableControls(cdsTmpDoc, prcScroll);
      End;
    End

    Else If (Key = VK_SPACE) Then
    Begin
      If (fCfgSis('ROMPAR', varBoolean)) Then
      Begin
        blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;
        Try
          If blnWasEnabled Then
            pDisableControls(cdsTmpDoc, prcScroll);

          pSelecionaDocumentoParcial;
          pGravaSelecionados;
        Finally
          If blnWasEnabled Then
            pEnableControls(cdsTmpDoc, prcScroll);
        End;
      End
      Else
        pVisualizarItensDocumento;
    End

    Else If (Key = VK_F10) Then
    Begin
      If Assigned(cdsMaster) Then
        PostMessage(Handle, WM_MESSAGECONFIRMAROM, 0, 0)
      Else
        btnConfirma.Click;
    End

    Else If (Key = VK_F12) Then
    Begin
      btnAcoEnt.Click;
    End

    Else If (not (Shift = [ssAlt])) And (Key = VK_F3) Then
    Begin
      btnIniBus.Click;
    End

    Else If (Key = VK_F4) Then
    Begin
      btnLocProx.Click;
    End;
  End
  Else
  begin
    If (Shift = [ssCtrl]) And (Key = VK_F3) Then
      btnMarcaTodos.Click
    Else If (Shift = [ssCtrl]) And (Key = VK_F4) Then
      btnDesmarcaTodos.Click;
  end;
end;

