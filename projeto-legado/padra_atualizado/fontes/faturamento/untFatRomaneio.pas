  Else
  Begin
    strSQL := strSQL + '  " "         AS GER_NUMFAT, ';
    strSQL := strSQL + '  " "         AS GER_DOCUME, ';
    strSQL := strSQL + '  " "         AS GER_PEDVEN, ';
  End;

  strSQL := strSQL + '    0.000       AS GER_VOLUME, ';
  strSQL := strSQL + '    " "         AS GER_CODDIV, ';
  strSQL := strSQL + '    " "         AS GER_NOMDIV, ';
  strSQL := strSQL + '    " "         AS GER_NFEADC, ';
  strSQL := strSQL + '    " "         AS GER_MENEXP, ';
  strSQL := strSQL + '    " "         AS GER_MENEX2, ';
  strSQL := strSQL + '    " "         AS GER_MENEX3, ';
  strSQL := strSQL + '    " "         AS GER_MENEX4, ';
  strSQL := strSQL + '    " "         AS GER_ENTURG, ';
  strSQL := strSQL + '    " "         AS GER_PRVIMP, ';
  strSQL := strSQL + '    "S"         AS GER_ENTSAI, ';
  strSQL := strSQL + '    " "         AS FIS_ACESSO, ';
  strSQL := strSQL + '    " "         AS GER_ENTFUT, ';
  strSQL := strSQL + '    " "         AS GER_ENTFAT, ';
  strSQL := strSQL + '    " "         AS GER_CONENT, ';
  strSQL := strSQL + '    "N"         AS APENAS_ESTE, ';
  strSQL := strSQL + '     0          AS GER_VOLBIP, ';
  strSQL := strSQL + fRetSQLDescrRegiao;
  strSQL := strSQL + '  CAST(" " AS CHAR(1)) AS SUBREGIAO, ';
  strSQL := strSQL + fRetSQLSeqRotaRegiao('');
  strSQL := strSQL + '    0.00        AS GER_BASSIM, ';
  strSQL := strSQL + '    0.00        AS GER_BASIPI, ';
  strSQL := strSQL + '    0.00        AS GER_TOTIPI, ';
  strSQL := strSQL + '    0.00        AS GER_BASICM, ';
  strSQL := strSQL + '    0.00        AS GER_TOTICM, ';
  strSQL := strSQL + '    0.00        AS GER_TOTRET, ';
  strSQL := strSQL + '    0.00        AS GER_BASRET, ';
  strSQL := strSQL + '    0.00        AS GER_DESESP, ';
  strSQL := strSQL + '    0.00        AS GER_TOTCUS, ';
  strSQL := strSQL + '    0.00        AS GER_TOTMED, ';
  strSQL := strSQL + '    0.00        AS GER_TOTFRE, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR01, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR02, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR03, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR04, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR05, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR06, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR07, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR08, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR09, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR10, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR11, ';
  strSQL := strSQL + '    0.00        AS GER_VPAR12, ';
  strSQL := strSQL + '    0.00        AS GER_TOTPRO, ';
  strSQL := strSQL + '    " "         AS GER_CODCND, ';
  strSQL := strSQL + fRetornaCampoOrigemPedidoRetira('');
  strSQL := strSQL + '    " "         AS GER_ORIDEV, ';
  strSQL := strSQL + fRetornaInformacoesRota(true);
  strSQL := strSQL+  '    " "         AS DOC_FATURADOS, ';
  strSQL := strSQL + '    " "         AS GER_INCFUT, ';
  strSQL := strSQL + '    " "         AS TIPPED, ';
  strSQL := strSQL + '    1.00        AS GER_PERDEV, ';
  strSQL := strSQL + ' CAST(" " AS CHAR(8)) AS ROMLOT, ';
  strSQL := strSQL + ' CAST(" " AS CHAR(15)) AS TURENT ';

  If (blnFiltraDocumento) Then
  Begin
    strSQL := strSQL + ' ,DIG_CODREG AS CODREG ';
    strSQL := strSQL + ' ,DIG_DESCRI AS DESCRI ';
    strSQL := strSQL + ' ,OUTDIGX.AUTOINCREM AS SEQDIG ';
  End;

  strSQL := strSQL + ', "N" AS DELETA_DEVOLUCAO ';

