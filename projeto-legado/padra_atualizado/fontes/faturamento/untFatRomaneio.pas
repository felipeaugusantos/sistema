function TfrmFatRomaneio.fDesmarcaTodos(pgbStatus: TcxProgressBar): Boolean;
begin
  Result := Assigned(cdsTmpDoc);
  if Result then
  begin
    cdsTmpDoc.First;
    While Not cdsTmpDoc.Eof Do
    begin
      if dsTmpDoc.FieldByName('GER_MARDES').AsString <> 'D' then
        pSelecionaDocumento;
      cdsTmpDoc.Next;
      pProgresso(cdsTmpDoc.RecNo, cdsTmpDoc.RecordCount, pgbStatus);
    end;
  end;
end;

function TfrmFatRomaneio.fMarcaTodos(pgbStatus: TcxProgressBar): Boolean;
begin
  Result := Assigned(cdsTmpDoc);
  if Result then
  begin
    cdsTmpDoc.First;
    While Not cdsTmpDoc.Eof Do
    begin
      if dsTmpDoc.FieldByName('GER_MARDES').AsString = 'D' then
        pSelecionaDocumento;
      cdsTmpDoc.Next;
      pProgresso(cdsTmpDoc.RecNo, cdsTmpDoc.RecordCount, pgbStatus);
    end;
  end;
end;

procedure TfrmFatRomaneio.btnNovaObservacaoClick(Sender: TObject);
var
  strObservacao: String;
  bkmRegAtu: TBookmark;
  strAutoincrem : String;
begin
  inherited;

  If (not cdsTmpDoc.Active) Or
     (cdsTmpDoc.IsEmpty) Then
  Begin
    fMensagem('ATENÇÃO!', 'Nenhum documento está sendo listado no momento.' +#13
                         +'Verifique os parâmetros da consulta e tente novamente', ['&Ok']);
    Exit;
  End;

  Try
    bkmRegAtu := cdsTmpDoc.GetBookmark;
    cdsTmpDoc.DisableControls;

    pCriarFormularios(TfrmDigOcorrencia, frmDigOcorrencia);
    frmDigOcorrencia.blnDigFatRomaneio := True;
    frmDigOcorrencia.ShowModal;
    If (frmDigOcorrencia.ModalResult = mrOk) Then
    Begin
      strObservacao := frmDigOcorrencia.strHisCom;
       fGravaLogRom(
          strAutoincrem,
          cdsTmpDoc.FieldByName('GER_NROROM').AsString,
          '',
          '',
          '',
          cdsTmpDoc.FieldByName('GER_DOCORI').AsString,
          cdsTmpDoc.FieldByName('GER_ESPDOC').AsString,
          cdsTmpDoc.FieldByName('GER_CODEMP').AsString,
          strObservacao,
          True);

      stlAutoincremLogRom.Add(strAutoincrem);

      stlDocSemLogRom.Clear;

      cdsTmpDoc.Edit;
      cdsTmpDoc.FieldByName('POSOBS').AsString := 'S';
      cdsTmpDoc.Post;
    End;
  Finally
    pFreeAndNil(frmDigOcorrencia);

    cdsTmpDoc.GotoBookmark(bkmRegAtu);
    cdsTmpDoc.FreeBookmark(bkmRegAtu);

    // Inverti AfterScroll e EnableControl < >
    cdsTmpDoc.EnableControls;
    pAfterScrollCdsTmpDoc(cdsTmpDoc);
  End;
end;

