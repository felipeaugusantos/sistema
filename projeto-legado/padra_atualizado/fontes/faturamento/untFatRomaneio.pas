    else
    begin
      strSQL := strSQL + '  INNER JOIN FATGOR ';
      strSQL := strSQL + '  ON (RLD_NUMDOC = FGO_NUMDOC ';
      strSQL := strSQL + '  AND RLD_ESPDOC = FGO_ESPDOC ';
      strSQL := strSQL + '  AND RLD_CODEMP = FGO_CODEMP) ';
      strSQL := strSQL + '  WHERE FGO_NUMFAT = G.GER_NUMDOC ';
      strSQL := strSQL + '  AND FGO_TIPFAT = G.GER_ESPDOC ';
      strSQL := strSQL + '  AND FGO_EMPFAT = G.GER_CODEMP LIMIT 1) AS ROMLOT, ';
    end;

    strSQL := strSQL + '  CAST(" " AS CHAR(15)) AS TURENT ';
