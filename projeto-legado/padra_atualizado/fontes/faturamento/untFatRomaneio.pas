End;

Procedure TfrmFatRomaneio.pDestravaDocumento(strNomTbl, strNumRom, strNumDoc, strCodEmp, strEntSai: String);
Var
  strChaLck: String;
Begin
  If fEmptyStr(strNumRom) Then // SE JA PERTENCER AO ROMANEIO NAO DESTRAVA
  Begin
    strChaLck := strNomTbl + AnsiReplaceStr(strNumDoc,'-','') + strCodEmp;
    fLock_Unlock_DocRomaneio(strChaLck,
                             RightStr(strNumDoc,2),
                             strEntSai,
                             False,
                             False,
                             objLock);
  End;
End;

procedure TfrmFatRomaneio.pTrataCasoRomaneiosAntigos;
  Var
    strFiltro    : String;
    blnFiltrado  : Boolean;
    strIndice    : String;
    prcScroll    : TprcScroll;
    blnWasEnabled: Boolean;
Begin
  strFiltro   := cdsTmpDoc.Filter;
  blnFiltrado := cdsTmpDoc.Filtered;
  strIndice   := cdsTmpDoc.IndexFieldNames;

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  If blnWasEnabled Then
    pDisableControls(cdsTmpDoc, prcScroll);

  cdsTmpDoc.Filtered        := False;
  cdsTmpDoc.Filter          := '';
  cdsTmpDoc.IndexFieldNames := 'GER_ORDIMP';

  With cdsTmpDoc Do
  Begin
    {************************************************************}
    {* BUSCANDO A ULTIMA POSICAO DO ORDIMP - ORDEM DE IMPRESSAO *}
    {******************************************************RN,LU*}
    Last;
    intOrdImp := FieldByName('GER_ORDIMP').AsInteger;

    {********************************************************************}
    {* TRATANDO OS CASOS DE ROMANEIOS ANTIGOS, SEM GER_ORDIMP DEFINIDOS *}
    {**************************************************************RN,LU*}
    If (intOrdImp = 0) Then
    Begin
      IndexFieldNames := 'GER_NUMDOC';
      First;
      
      While Not Eof Do
      Begin
        intOrdImp := intOrdImp + 1;

        Edit;
        FieldByName('GER_ORDIMP').AsString := IntToStr(intOrdImp);
        Post;

        Next;
      End;
    End;
  End;

  cdsTmpDoc.Filtered        := blnFiltrado;
  cdsTmpDoc.Filter          := strFiltro;
  cdsTmpDoc.IndexFieldNames := strIndice;

  If blnWasEnabled Then
    pEnableControls(cdsTmpDoc, prcScroll);
end;

function TfrmFatRomaneio.fPedeLocalMercadoriaPalet: String;
begin
  Result := '';
  While fCfgSis('PALROM', VarBoolean) And fEmptyStr(Result) Do
  Begin
    Result := fInputDialog('Local da Mercadoria - Palet',
                           'Digite o Local da Mercadoria - Palet (até 15 caracteres):', Result, 15);

    If fEmptyStr(Result) And (fMensagem('', 'Local da Mercadoria não foi informado! ' + #13#10 +
                                            'Deseja continuar sem informar?', ['&Não','&Sim']) = 2) Then
    Begin
      Break;
    End;
  End;
end;

function TfrmFatRomaneio.fPedeNumeroBox(Var strNumBox: String): Boolean;
begin
  Result := True;

  if (not fCfgSis('USABOX', varBoolean)) then
    Exit;

  Repeat
    strNumBox := fInputDialog('Nº BOX',
                              'Informe o Número do BOX (até 10 caracteres):', strNumBox, 10, 250);

    If fEmptyStr(strNumBox) And fPergunta('Número do BOX não foi informado. ' +
                                          'Deseja continuar sem informar?') Then
    Begin
      Break;
    End;
  Until Not fEmptyStr(strNumBox);
end;

procedure TfrmFatRomaneio.pTravaDocumentosRomaneio(pgbStatus: TcxProgressBar=Nil);
  Var
    strFiltro    : String;
    blnFiltrado  : Boolean;
    prcScroll    : TprcScroll;
    blnWasEnabled: Boolean;
    strChaLck: String;
begin
  If blnJaBloqueouDocumentos Then
    Exit;
    
  strFiltro   := cdsTmpDoc.Filter;
  blnFiltrado := cdsTmpDoc.Filtered;

  blnWasEnabled := Not cdsTmpDoc.ControlsDisabled;

  If blnWasEnabled Then
    pDisableControls(cdsTmpDoc, prcScroll);

  cdsTmpDoc.Filtered := False;
  cdsTmpDoc.Filter   := '';

  With cdsTmpDoc Do
  Begin
    First;
    While Not Eof Do
    Begin
      pInformacao('Bloqueando ' + FieldByName('GER_NUMDOC').AsString + ' para uso...', pgbStatus);
      pProgresso(RecNo, RecordCount, pgbStatus);

      strChaLck := FieldByName('GER_NOMTBL').AsString +
                   AnsiReplaceStr(FieldByName('GER_NUMDOC').AsString,'-','') +
                   FieldByName('GER_CODEMP').AsString;
      
      fLock_Unlock_DocRomaneio(strChaLck,
                               RightStr(FieldByName('GER_NUMDOC').AsString,2),
                               FieldByName('GER_ENTSAI').AsString,
                               True,
                               False,
                               objLock);
      Next;
    End;
  End;

  cdsTmpDoc.Filter   := strFiltro;
  cdsTmpDoc.Filtered := blnFiltrado;

  If blnWasEnabled Then
    pEnableControls(cdsTmpDoc, prcScroll);
end;

