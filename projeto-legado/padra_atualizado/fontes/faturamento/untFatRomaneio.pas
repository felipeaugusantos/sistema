procedure TfrmFatRomaneio.pPreencheMemoFeriados(strCodCid: String);
  Var
    qryDados: TUniQuery;
    strLinha: String;
begin
  qryDados := fCriaQuery;
  memFeriados.Text := '';

  Try
    pCarregaFeriadosCidade(qryDados, strCodCid);

    While (Not qryDados.Eof) Do
    Begin
      strLinha := (FormatDateTime('dd/mm/yyyy', qryDados.FieldByName('FCI_DTAFER').AsDateTime)) + ' - ' +
        qryDados.FieldByName('FCI_DESCRI').AsString;

      memFeriados.Lines.Add(strLinha);
      qryDados.Next;
    End;

  Finally
    FreeAndNil(qryDados);
  End;
end;

function TfrmFatRomaneio.fRetCondicaoCFOP(strCampoClaFis: String): String;
begin
  If (Not fEmptyStr(strCfoRom)) Then
    Result := '((LEFT('+strCampoClaFis+', 1) >= 5) OR ('+strCampoClaFis +' IN (' + fRetCfgCfoRom + '))) '
  Else
    Result := '(LEFT('+strCampoClaFis+', 1) >= 5) ';
end;

function TfrmFatRomaneio.fRetCfgCfoRom: String;
  Var
    stlCFOPs: TStringList;
    intIndex: Integer;
    strCfoOutEnt: String;
begin
  strCfoOutEnt := '';
  stlCFOPs := TStringList.Create;

  Try
    stlCFOPs.Delimiter := '_';
    stlCFOPs.DelimitedText := fTransform(strCfoRom, 3);

    For intIndex := 0 To Pred(stlCFOPs.Count - 1) Do
    Begin
      If (Not fEmptyStr(strCfoOutEnt)) Then
        strCfoOutEnt := strCfoOutEnt + ', ';

      strCfoOutEnt := strCfoOutEnt + QuotedStr('1' + stlCFOPs[intIndex]) + ', ' + QuotedStr('2' + stlCFOPs[intIndex]);
    End;

    Result := strCfoOutEnt;
  Finally
    FreeAndNil(stlCFOPs);
  End;
end;

function TfrmFatRomaneio.fPermiteProsseguirComValorZerado: Boolean;
  Var
    cdsClone : TUniClientDataSet;
begin
  Result := False;
  cdsClone := TUniClientDataSet.Create(Nil);

  Try
    pCloneDataSet(cdsClone, cdsTmpDoc);

    cdsClone.Filtered := False;
    cdsClone.Filter := '(GER_MARDES = '+QuotedStr('M')+')';
    cdsClone.Filtered := True;

    if (cdsClone.RecordCount = 0) then
      Exit;

    cdsClone.First;

    While (Not cdsClone.Eof) Do
    Begin
      If (Pos(cdsClone.FieldByName('GER_ESPDOC').AsString, 'BR_OX_GC_') = 0) Then
        Exit;

      cdsClone.Next;
    End;

    Result := True;
  Finally
    FreeAndNil(cdsClone);
  End;
end;

procedure TfrmFatRomaneio.pCacheDadosRomaneio(const cdsRomGer : TUniClientDataSet);
  Var
    cdsClone : TUniClientDataSet;
begin
  cdsClone := TUniClientDataSet.Create(Self);
  Try
    objCacheTablesRomaneio.ClearDocuments;

    pCloneDataSet(cdsClone, cdsRomGer);
    cdsClone.Filter := '((GER_MARDES = ' + QuotedStr('M')+') OR (GER_MARDES = '+QuotedStr('P')+'))';
    cdsClone.Filtered := True;
    cdsClone.First;
    While Not cdsClone.Eof Do
    Begin
      objCacheTablesRomaneio.AddDocument(cdsClone.FieldByName('GER_AUTINC').AsString, cdsClone.FieldByName('GER_NOMTBL').AsString);
      cdsClone.Next;
    End;

    objCacheTablesRomaneio.LoadCache;
  Finally
    FreeAndNil(cdsClone);
  End;
end;

function TfrmFatRomaneio.fEhDocumentoBaixaEntregaFutura(const strNumDoc, strEspDoc, strCodEmp, strTabela : String) : Boolean;
  Var
    objClient : TZClient;
begin
  If (objCacheTablesRomaneio.FindDocument(strNumDoc, strEspDoc, strCodEmp, strTabela, objClient)) And
     (Assigned(objClient.FindField('DOCBAIENTFUT'))) Then
    Result := objClient.FieldByName('DOCBAIENTFUT').AsInteger = 1
  Else
    Result := untFuncoesSimples.fEhDocumentoBaixaEntregaFutura(strNumDoc, strEspDoc, strCodEmp);
end;

function TfrmFatRomaneio.fPegouMensagensDocumento(const strNumDoc, strEspDoc, strCodEmp, strTabela : String; Var stlMsgExp: TStringList; Var strTodasMensagens : String) : Boolean;
  Var
    objClient : TZClient;
    stlMensag : TStringList;
begin
  strTodasMensagens := '';
  Result := False;
  If (Not objCacheTablesRomaneio.FindDocument(strNumDoc, strEspDoc, strCodEmp, strTabela, objClient)) Then
    Exit;
  If (strTabela = 'MOVGER') Or (strTabela = 'NOTGER') Then
  Begin
    stlMensag := TStringList.Create;
    Try
      If Assigned(stlMsgExp) Then
      Begin
        stlMsgExp.Clear;
        stlMsgExp.Add(objClient.FieldByName('GER_MENEXP').AsString);
        stlMsgExp.Add(objClient.FieldByName('GER_MENEX2').AsString);
        stlMsgExp.Add(objClient.FieldByName('GER_MENEX3').AsString);
        stlMsgExp.Add(objClient.FieldByName('GER_MENEX4').AsString);
      End
      Else
      Begin
        stlMensag.Add(objClient.FieldByName('GER_MENEXP').AsString);
        stlMensag.Add(objClient.FieldByName('GER_MENEX2').AsString);
        stlMensag.Add(objClient.FieldByName('GER_MENEX3').AsString);
        stlMensag.Add(objClient.FieldByName('GER_MENEX4').AsString);
      End;
      If Assigned(stlMsgExp) Then
        strTodasMensagens := AnsiReplaceStr(stlMsgExp.Text, #13#10, ' ')
      Else
        strTodasMensagens := AnsiReplaceStr(stlMensag.Text, #13#10, ' ');
    Finally
      FreeAndNil(stlMensag);
    End;
    Result := True;
  End;
end;

function TfrmFatRomaneio.fExisteCancelamentoPendentePorChaveAcesso(const strNumDoc, strEspDoc, strCodEmp, strCodCli : String): Boolean;
  Var
    strChave : String;
begin
  Result := False;

  If (Pos(strEspDoc, 'NF_EL_NV_IF_IV_') <= 0) Then
    Exit;

  strChave := fRetChaveAcesso(strNumDoc, strEspDoc, strCodCli, strCodEmp);

  If fEmptyStr(strChave) Then
    Exit;

  If FLogCancelamento.fExisteCancelamentoPendentePorChaveAcesso(strChave) Then
  Begin
    Result := True;
    pMensagemOK('Documento Fiscal se encontra em processo de cancelamento (LOGCAN)!');
  End;
end;

