    frmFatRomManutEntrega.blnChamouPeloRomaneioInclusao := True;
    frmFatRomManutEntrega.ShowModal;

    blnConfirma := frmFatRomManutEntrega.blnConfirma;
  finally
    pFreeAndNil(frmFatRomManutEntrega);
  end;

  if (not blnConfirma) then
    Exit;

  pConsultar(True);
end;

