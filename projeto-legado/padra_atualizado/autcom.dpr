begin
  pConfiguraOpcoesRegionais;

  untFuncoesSimples.fConsulta := untFuncoesGen.fConsulta;
  untFuncoesSimples.fGetFuncoesCxGrid := untFuncoesCxGrid.fGetFuncoesCxGrid;
  untFuncoesSimples.pIniciaDllFuncoes := untFuncoesGen.pIniciaDllFuncoes;
  untFuncoesSimples.pReassignConexaoLibFuncoes := untFuncoesGen.pReassignConexaoLibFuncoes;
  untFuncoesSimples.fGetFuncoesCitelGrid := untFuncoesCitelGrid.fGetFuncoesCitelGrid;
  If ParamCount > 1 Then
  Begin
    Application.ShowMainForm :=
      (ParamStr(1) <> 'IMPORTA-PDV') and
      (ParamStr(1) <> 'VENDA_ASSISTIDA') and
      (ParamStr(1) <> 'YAPAY');

    frmPrincipal.blnYapay := ParamStr(1) = 'YAPAY';
  End;

  blnTermina := False;
  If Not FileExists(ExtractFilePath(Application.ExeName) + 'libmysql41.dll') Then
  Begin
    pMensagemOk('Não encontrei a biblioteca libmysql41.dll na pasta ' + ExtractFilePath(Application.ExeName));
    blnTermina := True;
  End;

  If FileExists(ExtractFilePath(Application.ExeName) + 'BemaFI32.dll') Then
  Begin
    If Not FileExists(ExtractFilePath(Application.ExeName) + 'BemaFI32.ini') Then
    Begin
      pMensagemOk('Não encontrei o arquivo BemaFI32.ini na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'BemaFI32.ini') Then
    Begin
      pMensagemOk('Não encontrei o arquivo BemaFI32.ini na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'BemaMFD.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca BemaMFD.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'BemaMFD2.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca BemaMFD2.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'DAO350.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca DAO350.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'MSJET35.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca MSJET32.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'AX6R32.DLL') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca AX6R32.DLL na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'libeay32.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca libeay32.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'sign_bema.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca sign_bema.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

    If Not FileExists(ExtractFilePath(Application.ExeName) + 'DAO2535.tlb') Then
    Begin
      pMensagemOk('Não encontrei o arquivo DAO2535.tlb na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;

  End;

  If FileExists(ExtractFilePath(Application.ExeName) + 'SERSWEDA.DLL') Then
  Begin
    If Not FileExists(ExtractFilePath(Application.ExeName) + 'Swmfd.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca Swmfd.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;
  End;

//  If Not FileExists(ExtractFilePath(Application.ExeName) + 'DLLG2.dll') Then
//  Begin
//    pMensagemOk('Não encontrei a biblioteca DLLG2.dll na pasta ' + ExtractFilePath(Application.ExeName));
//    blnTermina := True;
//  End;

  If FileExists(ExtractFilePath(Application.ExeName) + 'Elgin.DLL') Then
  Begin
    If Not FileExists(ExtractFilePath(Application.ExeName) + 'Leitura.dll') Then
    Begin
      pMensagemOk('Não encontrei a biblioteca Leitura.dll na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;
  End;

  For LFile In ARR_BPL_FILE Do
  Begin
    If Not FileExists(ExtractFilePath(Application.ExeName) + LFile) Then
    Begin
      pMensagemOk('Não encontrei a biblioteca ' + LFile + ' na pasta ' + ExtractFilePath(Application.ExeName));
      blnTermina := True;
    End;
  End;

  If blnTermina Then
  Begin
    Application.Terminate;
    Exit;
  End;

  Application.Initialize;
  Application.Title := 'AutCom';

  RlConsts.SetVersion(3,71,'B');

  If ParamCount > 1 Then
  Begin
    Application.MainFormOnTaskbar :=
      (ParamStr(1) <> 'YAPAY') and
      (ParamStr(1) <> SPED_FISCAL_PARAM) and
      (ParamStr(1) <> SPED_PIS_COFINS_PARAM) and
      (ParamStr(1) <> MonitorConsultaPrecoTintaParam) and
      (ParamStr(1) <> FaturamentoAutomaticoMonitorExeParam) and
      (ParamStr(1) <> CanceladorAutomaticoMonitorExeParam);
  End;

  Application.CreateForm(TfrmPrincipal, frmPrincipal);
  Application.Run;
end.

