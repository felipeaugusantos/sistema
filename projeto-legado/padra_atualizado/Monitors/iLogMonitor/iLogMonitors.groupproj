<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{5114D0AA-CE2E-4E87-B044-2FCE491A6358}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Send\iLogMonitorSend.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Status\iLogMonitorStatus.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="iLogMonitorSend">
        <MSBuild Projects="Send\iLogMonitorSend.dproj"/>
    </Target>
    <Target Name="iLogMonitorSend:Clean">
        <MSBuild Projects="Send\iLogMonitorSend.dproj" Targets="Clean"/>
    </Target>
    <Target Name="iLogMonitorSend:Make">
        <MSBuild Projects="Send\iLogMonitorSend.dproj" Targets="Make"/>
    </Target>
    <Target Name="iLogMonitorStatus">
        <MSBuild Projects="Status\iLogMonitorStatus.dproj"/>
    </Target>
    <Target Name="iLogMonitorStatus:Clean">
        <MSBuild Projects="Status\iLogMonitorStatus.dproj" Targets="Clean"/>
    </Target>
    <Target Name="iLogMonitorStatus:Make">
        <MSBuild Projects="Status\iLogMonitorStatus.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="iLogMonitorSend;iLogMonitorStatus"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="iLogMonitorSend:Clean;iLogMonitorStatus:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="iLogMonitorSend:Make;iLogMonitorStatus:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
