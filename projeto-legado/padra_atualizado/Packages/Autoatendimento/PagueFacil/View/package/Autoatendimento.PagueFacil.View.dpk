package Autoatendimento.PagueFacil.View;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  fmx,
  dbrtl,
  AVPackD10;

contains
  Autoatendimento.PagueFacil.View.RecebimentoPedido in '..\source\Autoatendimento.PagueFacil.View.RecebimentoPedido.pas' {fmxRecebimentoPedido},
  Autoatendimento.PagueFacil.Frame.fmxItensPedido in '..\frames\Autoatendimento.PagueFacil.Frame.fmxItensPedido.pas' {frameItensPedido: TFrame},
  Autoatendimento.PagueFacil.Interfaces in '..\..\..\..\..\fontes\Autoatendimento\Autoatendimento.PagueFacil.Interfaces.pas',
  Autoatendimento.PagueFacil.View.InputBox in '..\source\Autoatendimento.PagueFacil.View.InputBox.pas' {fmxInputBox},
  Autoatendimento.PagueFacil.View.Pergunta in '..\source\Autoatendimento.PagueFacil.View.Pergunta.pas' {fmxPergunta},
  Autoatendimento.PagueFacil.View.Mensagem in '..\source\Autoatendimento.PagueFacil.View.Mensagem.pas' {fmxMensagem};

end.
