package Autoatendimento.ConsultaPreco.View;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  fmx,
  dbrtl,
  AVPackD10;

contains
  Autoatendimento.ConsultaPreco.View.BuscarPreco in '..\source\Autoatendimento.ConsultaPreco.View.BuscarPreco.pas' {fmxBuscarPreco},
  Autoatendimento.ConsultaPreco.Interfaces in '..\..\..\..\..\fontes\Autoatendimento\Autoatendimento.ConsultaPreco.Interfaces.pas',
  Autoatendimento.ConsultaPreco.View.ConsultarPreco in '..\source\Autoatendimento.ConsultaPreco.View.ConsultarPreco.pas' {fmxConsultaPreco},
  Autoatendimento.ConsultaPreco.Frame.DadosTecnicos in '..\frames\Autoatendimento.ConsultaPreco.Frame.DadosTecnicos.pas' {frameDadosTecnicos: TFrame},
  Autoatendimento.ConsultaPreco.Frame.ProdutosSimilares in '..\frames\Autoatendimento.ConsultaPreco.Frame.ProdutosSimilares.pas' {frameProdutosSimilares: TFrame},
  Autoatendimento.ConsultaPreco.Frame.ComprarJunto in '..\frames\Autoatendimento.ConsultaPreco.Frame.ComprarJunto.pas' {frameComprarJunto: TFrame},
  Autoatendimento.ConsultaPreco.View.Mensagem in '..\source\Autoatendimento.ConsultaPreco.View.Mensagem.pas' {fmxMensagem},
  Autoatendimento.ConsultaPreco.Frame.Precos in '..\frames\Autoatendimento.ConsultaPreco.Frame.Precos.pas' {framePrecos: TFrame};

end.

