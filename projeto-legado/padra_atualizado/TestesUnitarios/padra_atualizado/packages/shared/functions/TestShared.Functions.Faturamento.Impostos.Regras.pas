    .STAtribuidaPorAtoDeclaratorioDF('010', 'SP', 'DF', '_SAI_CNC', True, True, True);
  CheckFalse( ReturnValue );

  ReturnValue := TFunctionsRegrasImpostosFaturamento
    .STAtribuidaPorAtoDeclaratorioDF('010', 'SP', 'SP', '_SAI_CNC', True, True, True);
