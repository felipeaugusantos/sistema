procedure TestTFunctionsFuncoesFaturamento.DecodificaChaveNotaTamanhoCampo12;
Var
  LParametros : IParametrosDecodificaChaveNota;
  ReturnValue : IResultadoDecodificaChaveNota;
begin
  LParametros :=
    TParametrosDecodificaChaveNota.New
      .Chave('12345678901234567890')
      .TamanhoCampoDocumento(12);

  ReturnValue :=
    TFunctionFuncoesFaturamento
      .DecodificaChaveNota(LParametros);

  CheckTrue( (ReturnValue.NumeroDoDocumento = '123456789012') And
             (ReturnValue.Serie = '890')             And
             (ReturnValue.CodigoDoFornecedor = '34567890')And
             (ReturnValue.CodigoDaEmpresa = '567')   And
             (ReturnValue.EspecieDoDocumento = '34'));

end;

