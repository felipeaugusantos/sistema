  Var
    ReturnValue: IResultadoServicosClasseIcmsSt;
    AParametros: IParametrosServicoIcmsSt;
begin
  //Tipo abreviacao cliente
  objMyCampoTabelaAdd.Add('FISJUR', 'F');
