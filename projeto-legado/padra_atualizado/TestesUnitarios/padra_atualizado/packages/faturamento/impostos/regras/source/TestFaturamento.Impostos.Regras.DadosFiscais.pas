procedure TestTRegraImpostosDadosFiscaisClassificacaoItem.TestClienteNaoConsumidorDentroDoEstadoContribuinteIPIClienteConstrutora;
var
  ReturnValue: IResultadoDadosFiscaisClassificacaoItem;
begin
  FParametros.AtividadeConstrutora(True);
  FParametros.DentroDoEstadoCFOP(True);
  objConfiguracoes.fAtualizaValorConfiguracao(CFG_CONTRIBUINTE_IPI, 'S');
  ReturnValue := DadosFiscaisClassificacaoDoItem(FParametros);

  CheckTrue((ReturnValue.ClassificacaoFiscal1 = '5101') and
            (ReturnValue.ClassificacaoFiscal2 = EmptyStr)     and
            (ReturnValue.ClassificacaoFiscal3 = EmptyStr));
