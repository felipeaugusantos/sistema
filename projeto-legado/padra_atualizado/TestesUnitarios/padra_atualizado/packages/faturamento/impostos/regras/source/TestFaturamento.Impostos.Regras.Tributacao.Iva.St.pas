procedure TestTRegraCalculoIvaSt.TestCalcularValorIva;
var
  ReturnValue: IResultadoCalculoIva;

  LParametros: IParametrosCalculoIva;

  LModelClienteFornecedor: IResultadoFaturamentoImpostosModelClienteFornecedor;
  LModelProduto: IResultadoFaturamentoImpostosModelProduto;
  LModelEmpresa: IResultadoFaturamentoImpostosModelEmpresa;
begin
  objConfiguracoes.fAtualizaValorConfiguracao(CFG_IMPORTACAO_DIRETA_PRODUTOS, 'N');
  objConfiguracoes.fAtualizaValorConfiguracao(CFG_CLASSIFICACAO_EMPRESA_QUANTO_A_SUBSTITUICAO_TRIBUTARIA, '1');
  objConfiguracoes.fAtualizaValorConfiguracao(CFG_UTILIZA_IMPORTACAO_DIRETA, 'N');

  ModelCliente;
  LModelClienteFornecedor := TFaturamentoImpostosModelCliente.New.Consultar('', '', False, True);

  ModelProduto;
  LModelProduto := TFaturamentoImpostosModelProduto.New.Consultar('', '', '', EmptyStr, false);

  ModelEmpresa;
  LModelEmpresa := TFaturamentoImpostosModelEmpresa.New.Consultar('');

  LParametros :=
    TParametrosCalculoIva.New
      .PercentualDoIvaAbreviacao(2)
      .ModelClienteFornecedor(LModelClienteFornecedor)
      .ModelProduto(LModelProduto)
      .ModelEmpresa(LModelEmpresa)
      .CodigoDaSituacaoTributaria('000')
      .CodigoDaSubstituicaoTributaria('041')
      .TipoDaAbreviacaoFiscal('_SAI_CNC')
      .DentroDoEstado(True)
      .TotalGeralDoItem(100)
      .ValorDeIpiDoItem(50)
      .AliquotaDeIcmsDoItem(18)
      .AliquotaDaSubstituicaoTributariaDoItem(12)
      .DocumentoParaFornecedor(False);

  ReturnValue := TRegraCalculoIvaSt.New(LParametros).CalcularValorIva;

  // TODO: Validate method results
  CheckTrue((ReturnValue.ValorDoIva = 2) And
            (ReturnValue.ValorDoIvaMatriz = 0) And
            (ReturnValue.ValorDoIvaStMatriz = 0) And
            (ReturnValue.ClienteIVAEspMT = 0));
end;

