  LRecDifalFCP: TRecDifalFCP;
begin
  LRecDifalFCP.fltAlDifa := 1;
  LRecDifalFCP.fltDifDes := 2;
  LRecDifalFCP.fltDifOri := 3;
  LRecDifalFCP.fltValFcp := 4;
  LRecDifalFCP.fltPerFcp := 5;
  LRecDifalFCP.fltAlqIne := 6;
  LRecDifalFCP.fltAlqUfd := 7;
  LRecDifalFCP.fltBcuFde := 8;
  LRecDifalFCP.fltPerPar := 9;
  LRecDifalFCP.fltBasFcp := 10;
  LRecDifalFCP.blnGrvInf := True;

  ReturnValue := TParametrosServicoFcpDifal.New.RecordDifalFCP(LRecDifalFCP).RecordDifalFCP;
  CheckTrue((ReturnValue.fltAlDifa = 1)  and
            (ReturnValue.fltDifDes = 2)  and
            (ReturnValue.fltDifOri = 3)  and
            (ReturnValue.fltValFcp = 4)  and
            (ReturnValue.fltPerFcp = 5)  and
            (ReturnValue.fltAlqIne = 6)  and
            (ReturnValue.fltAlqUfd = 7)  and
            (ReturnValue.fltBcuFde = 8)  and
            (ReturnValue.fltPerPar = 9)  and
            (ReturnValue.fltBasFcp = 10) and
            (ReturnValue.blnGrvInf));
end;

