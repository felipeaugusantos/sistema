procedure TestTParametrosServicoIPI.TestParametrosCalculoIPI;
var
  ReturnValue: IResultadoServicosClasseIpi;
  AParametros: IParametrosCalculoIPI;
begin
  AParametros := TParametrosCalculoIPI.New
                   .ClienteZonaFranca(True)
                   .ClienteOrgaoPublico(True)
                   .VendaDentroDoEstado(True)
                   .ClienteDoExterior(True)
                   .SituacaoTributariaIPI('T')
                   .BaseDoIpi(33)
                   .AliquotaDeCalculoIPI(7);

  ReturnValue := TResultadoServicosClasseIpi.New()
                   .ParametrosCalculoIPI(AParametros);

  CheckTrue((ReturnValue.ParametrosCalculoIPI.ClienteZonaFranca = True) and
            (ReturnValue.ParametrosCalculoIPI.ClienteOrgaoPublico = True) and
            (ReturnValue.ParametrosCalculoIPI.VendaDentroDoEstado = True) and
            (ReturnValue.ParametrosCalculoIPI.ClienteDoExterior = True) and
            (ReturnValue.ParametrosCalculoIPI.SituacaoTributariaIPI = 'T') and
            (ReturnValue.ParametrosCalculoIPI.BaseDoIpi = 33) and
            (ReturnValue.ParametrosCalculoIPI.AliquotaDeCalculoIPI = 7));
end;

procedure TestTParametrosServicoIPI.TestParametrosClienteConsumidor;
Var
