procedure TestTFaturamentoImpostosModelProduto.TestConsultarAbreviacaoParaTodasAsEmpresas;
var
  ReturnValue: IResultadoFaturamentoImpostosModelProduto;
  ACodigoDaEmpresa: string;
  ACodigoDoProduto: string;
  ACodigoEmpresaTE: string;
begin
  objMyCampoTabelaAdd.Add('ITE_IPISAI', 18);
  objMyCampoTabelaAdd.Add('ITE_ITECCR', 'N');

  objMyCampoTabelaAdd.Add('CADITE_CODABF', '004');
  objMyCampoTabelaAdd.Add('ITEGER_CODABF', '004');

  objMyCampoTabelaAdd.Add('CADITE_IMPDIR', 'S');
  objMyCampoTabelaAdd.Add('ITEGER_IMPDIR', 'S');

  objMyCampoTabelaAdd.Add('ITE_UTIAMP', 'S');
  objMyCampoTabelaAdd.Add('ITE_CODFOR', '10101010');
  objMyCampoTabelaAdd.Add('ITE_IPIENT', 22);
  objMyCampoTabelaAdd.Add('ITE_FREENT', 33);

  ACodigoDaEmpresa := '001';
  ACodigoEmpresaTE := '002';
  objConfiguracoes.fAtualizaValorConfiguracao(CFG_CADASTRO_DE_ABREVIACAO_FISCAL, '1');
  objConfiguracoes.fAtualizaValorConfiguracao(CFG_UTILIZAR_DECRETO_REDUCAO_BASE_IMPOSTOS, 'N');

  // TODO: Setup method call parameters
  ReturnValue := TFaturamentoImpostosModelProduto.New.Consultar(ACodigoDoProduto,ACodigoDaEmpresa, ACodigoEmpresaTE, EmptyStr, false);

  // TODO: Validate method results
  CheckTrue((ReturnValue.IpiDeSaida = 18) And
            (ReturnValue.ItemConcreto = 'N') And
            (ReturnValue.CodigoDaAbreviacaoFiscal = '004') And
            (ReturnValue.ImportacaoDireta = 'S') And
            (ReturnValue.UtilizaAmpara = 'S') And
            (ReturnValue.CodigoDoFornecedor = '10101010') And
            (ReturnValue.IpiDeEntrada = 22) And
            (ReturnValue.FreteDeEntrada = 33));
end;

