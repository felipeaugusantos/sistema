  LParametrosClienteConsumidor : IParametrosFaturamentoImpostosClienteConsumidor;
  LMatrizResultado             : TMatrizFechamentoIcmsEfetivo;
  ReturnValue                  : TMatrizFechamentoIcmsEfetivo;
  FMatItens                    : TMatrizFechamento;
