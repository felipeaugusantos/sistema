procedure TestTValidacaoEspelhoXML.TestfRetornaSQLXml;
Const
  PARAMETRO_XML = 'AUTOINCREM_GERELE';
var
  sql : TStringList;
  ReturnValue: string;
begin

  sql := TStringList.Create();
  try
    sql.Add('SELECT'                                                 );
    sql.Add('  DETELE.*,'                                            );
    sql.Add('  B08_NNF,'                                             );
    sql.Add('  ITE_CODITE,'                                          );
    sql.Add('  ITE_DESITE,'                                          );
    sql.Add('  ITE_REFERE,'                                          );
    sql.Add('  ITE_CODFAB,'                                          );
    sql.Add('  UNI_SIGUNI'                                           );
    sql.Add('FROM'                                                   );
    sql.Add('  DETELE'                                               );
    sql.Add('  INNER JOIN GERELE ON GERELE.AUTOINCREM = DET_SEQGER'  );
    sql.Add('  INNER JOIN CADITE ON ITE_CODITE = DET_CODITE'         );
    sql.Add('  LEFT JOIN CADUNI ON UNI_CODUNI = ITE_CODUNI'          );
    sql.Add('WHERE'                                                  );
    sql.Add('  DET_SEQGER = :'+PARAMETRO_XML                         );

    ReturnValue := FValidacaoEspelhoXML.fRetornaSQLXml;

    CheckEqualsString(sql.Text, ReturnValue);

  finally
    FreeAndNil(sql);
  end;


end;

