  FValidacaoEspelhoXML.pCarregaEspelho(objEspelho.objItemEspelho);

  cdsXML.Append;
  cdsXML.FieldByName('DET_CODITE').AsString   := '005912';
  cdsXML.FieldByName('ITE_DESITE').AsString   := 'Produto Xml';
