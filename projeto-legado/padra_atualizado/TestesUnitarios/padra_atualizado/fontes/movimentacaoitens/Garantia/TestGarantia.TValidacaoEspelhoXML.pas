  FValidacaoEspelhoXML.pAlimentaCdsItens;
  
  FValidacaoEspelhoXML.pCarregaItens;

  ReturnValue := FValidacaoEspelhoXML.fExisteDivergencia;

  CheckTrue(ReturnValue);


