procedure TestTValidacaoEspelhoXML.TestfRetornaItemListaEspelho;
var
  ReturnValue: TItemValidacaoEspelhoXML;
  objItem : TItemValidacaoEspelhoXML;
  strCodigoItem: string;
  cdsXML: TUniClientDataSet;
  cdsEspelho: TUniClientDataSet;
  objEspelho: TItemValidacaoEspelhoXML;
begin
  objItem := TItemValidacaoEspelhoXML.Create();
  cdsXML:= TUniClientDataSet.Create(Nil);
  objItem := TItemValidacaoEspelhoXML.Create();
  cdsEspelho  := TUniClientDataSet.Create(nil);
  objEspelho  := TItemValidacaoEspelhoXML.Create();

  Try
    pFormataCDSEspelho(cdsEspelho);
    pFormataCDSXML(cdsXML);

    cdsEspelho.Append;
    cdsEspelho.FieldByName('DET_CODITE').AsString:= '005912';
    cdsEspelho.Post;

    FValidacaoEspelhoXML.dtsEspelho:= cdsEspelho;
    FValidacaoEspelhoXML.pCarregaEspelho(objEspelho.objItemEspelho);

    cdsXML.Append;
    cdsXML.FieldByName('DET_CODITE').AsString   := '005912';
    cdsXML.Post;

    strCodigoItem:= cdsEspelho.FieldByName('DET_CODITE').AsString;

    FValidacaoEspelhoXML.dtsXML:= cdsXML;
    FValidacaoEspelhoXML.pCarregaXML(objItem.objItemXML);

    FValidacaoEspelhoXML.pCarregaItens;

    ReturnValue := FValidacaoEspelhoXML.fRetornaItemListaEspelho(strCodigoItem);

    CheckTrue((ReturnValue.objItemXML.strCodigo = strCodigoItem));
    CheckTrue((ReturnValue.objItemEspelho.strCodigo = strCodigoItem));

  Finally
    FreeAndNil(cdsXML);
    FreeAndNil(objEspelho);
    FreeAndNil(objItem);
  End;

end;


