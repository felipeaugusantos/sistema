    CheckTrue(FItemValidacaoEspelhoXML.objValidacao.blnAliquotaFundoCombatePobrezaST = FValidacao.blnAliquotaFundoCombatePobrezaST);
    CheckTrue(FItemValidacaoEspelhoXML.objValidacao.blnValorFundoCombatePobrezaST = FValidacao.blnValorFundoCombatePobrezaST);
    CheckTrue(FItemValidacaoEspelhoXML.objValidacao.blnBaseCalculoFundoCombatePobreza = FValidacao.blnBaseCalculoFundoCombatePobreza);
    CheckTrue(FItemValidacaoEspelhoXML.objValidacao.blnAliquotaFundoCombatePobreza = FValidacao.blnAliquotaFundoCombatePobreza);
    CheckTrue(FItemValidacaoEspelhoXML.objValidacao.blnValorFundoCombatePobreza = FValidacao.blnValorFundoCombatePobreza);
