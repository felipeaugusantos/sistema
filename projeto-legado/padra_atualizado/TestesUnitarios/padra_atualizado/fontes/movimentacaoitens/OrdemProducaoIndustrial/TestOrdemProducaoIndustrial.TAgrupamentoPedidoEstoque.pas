procedure TestTAgrupamentoPedidoOrdProdIndustrialEstoque.TestfGetSQLFatDor;
  Var
    strSQL : String;
    ReturnValue : String;
begin
  strSQL := strSQL + ' SELECT FDO_CODITE,                                 ';
  strSQL := strSQL + '        FDO_DESCRI,                                 ';
  strSQL := strSQL + '        FDO_UNIDAD,                                 ';
  strSQL := strSQL + '        FDO_QTDITE,                                 ';
  strSQL := strSQL + '        FDO_UNITAR,                                 ';
  strSQL := strSQL + '        FDO_TOTITE,                                 ';
  strSQL := strSQL + '        FDO_COMPLE,                                 ';
  strSQL := strSQL + ' IF( IFNULL(FDO_ENTRET, "") =  "E" AND IFNULL(FDO_ENTFUT, "") <> "S", "Entrega Imediata",   ';
  strSQL := strSQL + ' IF( IFNULL(FDO_ENTRET, "") =  "E" AND IFNULL(FDO_ENTFUT, "") =  "S", "Entrega Futura",     ';
  strSQL := strSQL + ' IF( IFNULL(FDO_ENTRET, "") <> "E", "Retira", ""))) AS ENTRET,                              ';
  strSQL := strSQL + '        ITE_CODPAG,                                 ';
  strSQL := strSQL + '        ITE_CODCOR,                                 ';
  strSQL := strSQL + '        ITE_SALDOS,                                 ';
  strSQL := strSQL + ' (0.00) ITE_SALRES,                                 ';
  strSQL := strSQL + ' (0.00) ITE_SALDIS,                                 ';
  strSQL := strSQL + '        FDO_NUMLOT,                                 ';
  strSQL := strSQL + '        D.AUTOINCREM AS FDO_SEQFDO                  ';
  strSQL := strSQL + ' FROM FATDOR D                                      ';
  strSQL := strSQL + ' INNER JOIN EXTDOR   ON FDO_SEQFDO = D.AUTOINCREM   ';
  strSQL := strSQL + ' INNER JOIN CADITE I ON I.ITE_CODITE = D.FDO_CODITE ';
  strSQL := strSQL + ' INNER JOIN ITEGER G ON G.ITE_CODITE = D.FDO_CODITE ';
  strSQL := strSQL + '                    AND G.ITE_CODEMP = ' + QuotedStr(FAgrupamentoPedidoEstoque.strCodigoEmpresa);
  strSQL := strSQL + ' WHERE D.FDO_SEQGER = :AUTINC                       ';
  strSQL := strSQL + '   AND FDO_QTDITE > 0                               ';
  strSQL := strSQL + '   AND ITE_CODPAG IS NOT NULL                       ';
  strSQL := strSQL + '   AND FDO_BAIOPI = "N"                             ';
  strSQL := strSQL + '   AND FDO_SEQOPI IS NULL                           ';
  strSQL := strSQL + ' ORDER BY FDO_DESCRI                                ';

  ReturnValue := FAgrupamentoPedidoEstoque.fGetSQLFatDor;

  CheckEqualsString(strSQL, ReturnValue);
end;

