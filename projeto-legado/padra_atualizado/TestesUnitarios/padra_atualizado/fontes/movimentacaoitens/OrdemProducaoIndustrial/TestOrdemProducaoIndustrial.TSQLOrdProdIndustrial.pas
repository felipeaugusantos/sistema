function TestTSQLOrdProdIndustrial.TestfRetornaSQLCabecalhoImpr: String;
var
  strSQL,
  ReturnValue: string;
begin
  strSQL := '/* untOrdProIndustrial.fSQLCabecalhoImpr */ ';

  strSQL := strSQL + ' SELECT SQL_NO_CACHE ';

  strSQL := strSQL + ' G.AUTOINCREM AS AUTINC, ';
  strSQL := strSQL + '   FGO_NUMDOC AS NUMDOC, ';
  strSQL := strSQL + '   FGO_ESPDOC AS ESPDOC, ';
  strSQL := strSQL + '   ORD_PESREA AS PESREA, ';
  strSQL := strSQL + '   ORD_CODITE AS CODITE, ';
  strSQL := strSQL + '   ORD_CODCOR AS CODCOR, ';
  strSQL := strSQL + '   COR_DESCOR AS DESCOR, ';
  strSQL := strSQL + ' I.ITE_DESITE AS DESITE, ';
  strSQL := strSQL + ' I.ITE_REFERE AS REFERE, ';
  strSQL := strSQL + '   ORD_CODORD AS CODORD, ';
  strSQL := strSQL + '   ORD_CODBAR AS CODBAR, ';
  strSQL := strSQL + '   ORD_DTACAD AS DTACAD, ';
  strSQL := strSQL + '   ORD_HORCAD AS HORCAD, ';
  strSQL := strSQL + ' I.ITE_CODFAB AS CODFAB, ';
  strSQL := strSQL + '   ORD_DTAPRE AS DTAPRE, ';
  strSQL := strSQL + '   ORD_DTABAI AS DTABAI, ';
  strSQL := strSQL + ' G.AUTOINCREM AS AUTOIN, ';
  strSQL := strSQL + '   ORD_OBSERV AS OBSERV, ';
  strSQL := strSQL + ' G.ORD_OBSPRO AS OBSPRC, ';
  strSQL := strSQL + ' DATE_FORMAT(G.ORD_DTAVAL, "%m/%Y") AS DTAVAL, ';
  strSQL := strSQL + ' ORD_LOTEOP AS LOTEOP, ';

  strSQL := strSQL + '   CONCAT(IFNULL(GRU_DETLIN, ""), " ", ';
  strSQL := strSQL + '          IFNULL(GRU_DETGRU, ""), " ", ';
  strSQL := strSQL + '          IFNULL(COR_DETCOR, ""), " ", ';
  strSQL := strSQL + '          IFNULL(UNI_DETUNI, "")) AS DESETI,  ';

  strSQL := strSQL + '   CONCAT("OP-", ORD_CODORD, " ", DATE_FORMAT(ORD_DTACAD,"%d/%m/%y")) AS NUMOPE, ';
  strSQL := strSQL + '   CONCAT(DATE_FORMAT(ORD_DTACAD,"%d%m%y"), ORD_CODORD) AS NUMLOT,  ';
  strSQL := strSQL + '   ORD_QTDPAR AS QTDPAR, ';
  strSQL := strSQL + '   CONCAT(FATGOR.FGO_NUMDOC, "-", FATGOR.FGO_ESPDOC, "-", FATGOR.FGO_CODEMP) AS NUMRES, ';

  strSQL := strSQL + '   IFNULL((SELECT SUM(EST_ESTUTI) FROM ORDEST WHERE EST_SEQGER = G.AUTOINCREM),0) AS ESTUTI, ';

  strSQL := strSQL + ' IF(G.ORD_SEQCPN IS NULL, "", CONCAT(I.ITE_CODITB," - ",B.ITE_DESITE)) AS DESITE_B, ';
  strSQL := strSQL + ' CONCAT(I.ITE_CODITD," - ",D.ITE_DESITE) AS DESITE_DILUENTE, ';
  strSQL := strSQL + ' O.OPE_NOMOPE AS NOMOPE, ';
  strSQL := strSQL + ' IF(G.ORD_SEQCPN IS NULL, "", B.ITE_REFERE) AS ITE_REFERE_B, ';
  strSQL := strSQL + ' D.ITE_REFERE AS ITE_REFERE_DILUENTE, ';
  strSQL := strSQL + ' I.ITE_APLICA AS ITE_APLICACAO, ';
  strSQL := strSQL + ' I.ITE_VALCAT AS RELACAO_CATALISE,';
  strSQL := strSQL + ' (SELECT CONCAT(DATE_FORMAT(ORD_DTACAD,"%d%m%y"), "-", ORD_CODORD) AS NUMLOT ';
  strSQL := strSQL + '    FROM ORDGER                                                              ';
  strSQL := strSQL + '   WHERE ORD_CODITE = G.ORD_CODITE                                           ';
  strSQL := strSQL + '     AND ORD_CODEMP = G.ORD_CODEMP                                           ';
  strSQL := strSQL + '     AND ORD_DTACAD <= G.ORD_DTACAD                                          ';
  strSQL := strSQL + '     AND IF(ORD_DTACAD = G.ORD_DTACAD, ORD_HORCAD < G.ORD_HORCAD, TRUE)      ';
  strSQL := strSQL + '   ORDER BY ORD_DTACAD DESC, ORD_HORCAD DESC LIMIT 1) AS ULTLOT,             ';
  strSQL := strSQL + ' DATE_FORMAT(ORD_DTAPRE, "%d/%m/%Y") AS DTAPRV ';
  strSQL := strSQL + ' FROM ';

  strSQL := strSQL + '   ORDGER G ';

  strSQL := strSQL + ' INNER JOIN CADITE I ON ITE_CODITE = ORD_CODITE ';
  strSQL := strSQL + ' INNER JOIN CADGRU ON GRU_CODGRU = I.ITE_CODGRU ';
  strSQL := strSQL + ' INNER JOIN CADCOR ON COR_CODCOR = ORD_CODCOR ';
  strSQL := strSQL + ' INNER JOIN CADUNI ON UNI_CODUNI = I.ITE_CODUNI ';
  strSQL := strSQL + ' LEFT JOIN EXTGOR ON EXTGOR.FGO_ORDIND = G.AUTOINCREM      ';
  strSQL := strSQL + ' LEFT JOIN FATGOR ON FATGOR.AUTOINCREM = EXTGOR.FGO_SEQFGO ';
  strSQL := strSQL + ' LEFT JOIN CADITE B ON I.ITE_CODITB = B.ITE_CODITE ';
  strSQL := strSQL + ' LEFT JOIN CADITE D ON I.ITE_CODITD = D.ITE_CODITE ';
  strSQL := strSQL + ' LEFT JOIN CADOPE O ON O.OPE_CODOPE = ORD_CODOPE ';

  strSQL := strSQL + ' WHERE    ';
  strSQL := strSQL + '   G.AUTOINCREM = :AUTINC ';


  ReturnValue:= FSQLOrdProdIndustrial.fSQLCabecalhoImpr;

  CheckEqualsString(strSQL, ReturnValue);

end;

