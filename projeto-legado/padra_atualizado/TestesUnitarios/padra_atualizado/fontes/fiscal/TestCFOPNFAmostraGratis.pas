procedure TestTCFOPNFAmostraGratis.TestClassificacaoFiscal5911;
  Var
    LCFOPNFAmostraGratis : TCFOPNFAmostraGratis;
    LInputDefine: TInputDefineClassificacaoFiscal;
    LInputOutputClassificacao: TInputOutputClassificacaoFiscal;
begin
  FillChar(LInputDefine, SizeOf(LInputDefine), #0);
  FillChar(LInputOutputClassificacao, SizeOf(LInputOutputClassificacao), #0);
  LInputDefine.EntradaOuSaidaDoItem := 'S';
  LInputDefine.DentroDoEstado := True;
  LInputDefine.SituacaoTributaria := '000';
  LCFOPNFAmostraGratis := TCFOPNFAmostraGratis.Create(LInputDefine, objConfiguracoes, LInputOutputClassificacao);
  Try
    LInputOutputClassificacao := LCFOPNFAmostraGratis.GetClassificacao;
    CheckEqualsString(LInputOutputClassificacao.Classificacao, '5911');
    CheckEqualsString(LInputOutputClassificacao.PrefixoClassificacao, '5');
    CheckEqualsString(LInputOutputClassificacao.ClassificacaoDeServico, EmptyStr);
  Finally
    FreeAndNil(LCFOPNFAmostraGratis);
  End;
end;

