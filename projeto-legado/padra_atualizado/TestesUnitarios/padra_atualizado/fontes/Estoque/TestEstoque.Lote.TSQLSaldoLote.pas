  being tested.

}

interface

uses
  TestFramework, classes, Estoque.Lote.TSQLSaldoLote;

type
  // Test methods for class TSQLCadLote

  TestTSQLCadLote = class(TTestCase)
  strict private
    FSQLCadLote: TSQLSaldoLote;
  public
    procedure SetUp; override;
    procedure TearDown; override;
  published
    procedure TestfRetornaLoteComSaldo;
  end;

implementation

procedure TestTSQLCadLote.SetUp;
begin
  FSQLCadLote := TSQLSaldoLote.Create;
end;

procedure TestTSQLCadLote.TearDown;
begin
  FSQLCadLote.Free;
  FSQLCadLote := nil;
end;

procedure TestTSQLCadLote.TestfRetornaLoteComSaldo;
var
  strSQL,
  ReturnValue: string;
begin
  strSQL:= 'SELECT * FROM CADLOT                         '+
           '  WHERE LOT_CODITE = "'+FSQLCadLote.strCodigoItem+'"       '+
           '    AND LOT_CODEMP = "'+FSQLCadLote.strCodigoEmpresa+'"    '+
           '    AND LOCATE(LOT_NUMLOT, "A DEFINIR") <= 0 '+
           '    AND LOT_STATUS = "S"                     '+
           '    AND LOT_SALDOS > 0                       '+
           '  ORDER BY LOT_SALDOS DESC, LOT_ARMPRI DESC  '+
           '  LIMIT 1                                    ';

  ReturnValue := FSQLCadLote.fRetornaLoteComSaldo;

  CheckEqualsString(strSQL, ReturnValue);

end;

initialization
  // Register any test cases with the test runner
  RegisterTest(TestTSQLCadLote.Suite);
end.

