procedure TestTDicionario.TestDicionarioAdicionarDoisObjetosIguais;
Const
  CHAVE = 'TesteUnitario';
var
  LResultado: variant;
begin
  FDicionario.AdicionarObjeto(CHAVE, TObjectVariant.Create(5));
  FDicionario.AdicionarObjeto(CHAVE, TObjectVariant.Create(6));

  LResultado := FDicionario.Retorna(CHAVE);
  FDicionario.LimparObjetos;

  CheckTrue(LResultado = 6);
end;

procedure TestTDicionario.TestDicionarioAdicionarDuasChaves;
Const
  CHAVE1 = 'TesteUnitario1';
  VALOR1 = 'OK1';
  CHAVE2 = 'TesteUnitario2';
  VALOR2 = 'OK2';
var
  LResultado1: string;
  LResultado2: string;
begin
  FDicionario.Adicionar(CHAVE1, VALOR1);
  FDicionario.Adicionar(CHAVE2, VALOR2);

  LResultado1 := FDicionario.Retorna(CHAVE1);
  LResultado2 := FDicionario.Retorna(CHAVE2);

  FDicionario.Limpar;

  CheckTrue((LResultado1 = VALOR1) and
            (LResultado2 = VALOR2));
end;

