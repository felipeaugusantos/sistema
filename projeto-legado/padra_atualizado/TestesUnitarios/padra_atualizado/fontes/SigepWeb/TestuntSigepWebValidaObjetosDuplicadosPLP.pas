  strSQL := strSQL +' INNER JOIN CORPLP ON CORPLP.AUTOINCREM = PLD_SEQPLP  ';
  strSQL := strSQL +' INNER JOIN COROBJ ON COB_NUMOBJ        = PLD_NUMOBJ  ';
  strSQL := strSQL +' WHERE PLP_CODEMP = "'+FSigepWebValidaObjetosDuplicadosPLP.strCodEmpresa+'"                 ';
