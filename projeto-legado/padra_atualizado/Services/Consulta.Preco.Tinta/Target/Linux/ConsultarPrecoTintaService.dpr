procedure OnExitProcessSignal(SIGNUM: Integer);
begin
  WriteLog('Exit Process Signal (SIGNUM ' + IntToStr(SIGNUM) + ')...', True);
  VS_ExitProcessSignal := True;
end;

begin
  Signal(SIGINT, @OnExitProcessSignal);
  FormatSettings := TFormatSettings.Create('pt-BR');
  While True do
  Begin
    try
      WriteLog('Iniciando Consultar Preco Tinta Service ...', True);
      ExecutarConsultaPrecoTintaMonitor;
      WriteLog('Finalizando Consultar Preco Tinta Service ...', True);
      If VS_ExitProcessSignal Then
        Break;
    except
      on E: Exception do
      begin
        WriteError(E.ClassName + ': ' + E.Message);
      end;
    end;
    Sleep(10000);
  End;
end.
