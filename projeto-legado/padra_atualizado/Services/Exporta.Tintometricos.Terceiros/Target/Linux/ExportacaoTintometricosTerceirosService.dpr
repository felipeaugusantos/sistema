procedure OnExitProcessSignal(SIGNUM: Integer);
begin
  WriteLog('Exit Process Signal (SIGNUM ' + IntToStr(SIGNUM) + ')...', True);
  VS_ExitProcessSignal := True;
end;

begin
  Signal(SIGINT, @OnExitProcessSignal);
  FormatSettings := TFormatSettings.Create('pt-BR');
  try
    WriteLog('Iniciando Exportacao Tintometricos Terceiros Service ...  ', True, 60);
    ExportacaoTintometricosTerceiros;
    WriteLog('Exportacao Tintometricos Terceiros finalizado ... ', True, 60);
  except
    on E: Exception do
      WriteError(E.ClassName + ': ' + E.Message);
  end;
end.
