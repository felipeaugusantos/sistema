    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>true</DCC_RemoteDebug>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Linux64)'!=''">
        <Debugger_RunParams>-e002</Debugger_RunParams>
        <Debugger_Launcher>/usr/bin/xterm -e &quot;%debuggee%&quot;</Debugger_Launcher>
        <DCC_ExeOutput>..\..\..\bin</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\..\tmp</DCC_DcuOutput>
        <Manifest_File>..\..\..\Status.Pedido\Target\Linux\(None)</Manifest_File>
        <UsePackages>true</UsePackages>
        <DCC_UsePackage>faturamento.impostos.servicos;faturamento.impostos.regras;faturamento.model;faturamento.impostos.calculos;faturamento.impostos.tipos;faturamento.impostos.interfaces;Shared.Functions</DCC_UsePackage>
        <VerInfo_Keys>CFBundleVersion=1.0.0</VerInfo_Keys>
        <PreBuildEvent><![CDATA[copy "$(BDS)\redist\$(Platform)\bplfaturamento*.so" "$(PROJECTDIR)\..\..\..\bin"
copy "$(BDS)\redist\$(Platform)\bplShared*.so" "$(PROJECTDIR)\..\..\..\bin"
copy "$(BDS)\redist\$(Platform)\libmidas.so.2" "$(PROJECTDIR)\..\..\..\bin"
copy "$(BDS)\redist\$(Platform)\bplrtl260.so" "$(PROJECTDIR)\..\..\..\bin"
$(PreBuildEvent)]]></PreBuildEvent>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win32)'!=''">
        <DCC_RemoteDebug>false</DCC_RemoteDebug>
        <DCC_ExeOutput>..\..\bin</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\tmp</DCC_DcuOutput>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <Manifest_File>..\..\..\Status.Pedido\Target\Linux\(None)</Manifest_File>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Linux64)'!=''">
        <DCC_ExeOutput>..\..\..\bin</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\..\tmp</DCC_DcuOutput>
        <Debugger_Launcher>/usr/bin/xterm -e &quot;%debuggee%&quot;</Debugger_Launcher>
        <Manifest_File>..\..\..\Status.Pedido\Target\Linux\(None)</Manifest_File>
        <Debugger_RunParams>NEX -e002</Debugger_RunParams>
        <UsePackages>true</UsePackages>
        <DCC_UsePackage>faturamento.impostos.interfaces;faturamento.impostos.servicos;faturamento.impostos.regras;faturamento.model;faturamento.impostos.calculos;faturamento.impostos.tipos;Shared.Functions</DCC_UsePackage>
        <VerInfo_Keys>CFBundleVersion=1.0.0</VerInfo_Keys>
        <PreBuildEvent><![CDATA[copy "$(BDS)\redist\$(Platform)\bplfaturamento*.so" "$(PROJECTDIR)\..\..\..\bin"
copy "$(BDS)\redist\$(Platform)\bplShared*.so" "$(PROJECTDIR)\..\..\..\bin"
copy "$(BDS)\redist\$(Platform)\libmidas.so.2" "$(PROJECTDIR)\..\..\..\bin"
copy "$(BDS)\redist\$(Platform)\bplrtl260.so" "$(PROJECTDIR)\..\..\..\bin"
$(PreBuildEvent)]]></PreBuildEvent>
    </PropertyGroup>
