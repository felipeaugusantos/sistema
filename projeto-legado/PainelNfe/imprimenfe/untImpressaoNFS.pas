procedure TImpressaoNFS.pDanfeNFSRioBranco(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao, blnPDF_Banco: Boolean);
Var
  intContador,
  intQtdVias: Integer;
  strNomImp: string;
  LAnoComp,LMesComp: String;
  dtDataVenIss : TDate;
  wDia, wMes, wAno : Word;
  strLinkQrCode: string;
  frxQrCode: TfrxPictureView;
  bmpQrCode: TBitmap;
  intTentativas: integer;
  stream: TMemoryStream;
  LStreamDanfe: TStringStream;
begin
  Try
    cdsNFS.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    pConfigurarLogotipoDanfse;

    dtDataVenIss := StrToDate(cdsNFS.FieldByName('EMIRPS').AsString);
    DecodeDate(dtDataVenIss, wAno, wMes, wDia);
    If wMes = 12 Then
    Begin
      dtDataVenIss := EncodeDate(wAno + 1, 01, 15);
    End
    Else
    Begin
      dtDataVenIss := EncodeDate(wAno, wMes + 1, 15);
    End;

    LAnoComp := Copy(cdsNFS.FieldByName('COMPET').asString,7,4);
    LMesComp := Copy(cdsNFS.FieldByName('COMPET').asString,4,2);

    frxDanfe.Script.Variables['NUMNFS'] := cdsNFS.FieldByName('NUMNFS').AsString;
