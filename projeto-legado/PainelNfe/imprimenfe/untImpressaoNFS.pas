    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('TMSEND').AsString;
    frxDanfe.Script.Variables['NUENDE'] := cdsNFS.FieldByName('TMSNUM').AsString;
    frxDanfe.Script.Variables['COMPDE'] := cdsNFS.FieldByName('TMSCOMPL').AsString;
    frxDanfe.Script.Variables['CEPDES'] := fFormataCEP(cdsNFS.FieldByName('TMSCEP').AsString);
    frxDanfe.Script.Variables['FONDES'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('TMSFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['DOCDES'] := fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString);
    frxDanfe.Script.Variables['IMDEST'] := cdsNFS.FieldByName('TMSIM').AsString;
    frxDanfe.Script.Variables['IEDEST'] := cdsNFS.FieldByName('TMSIE').AsString;
    frxDanfe.Script.Variables['CDCNAE'] := cdsNFS.FieldByName('CDCNAE').AsString;
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('TMSBAIR').AsString;
    frxDanfe.Script.Variables['CIDDES'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TMSMUN').AsString]);
    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('TMSUF').AsString;
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('TMSEMAIL').AsString;
    frxDanfe.Script.Variables['NUMNFS'] := fStrZero(cdsNFS.FieldByName('NUMNFS').AsString, 8);
    frxDanfe.Script.Variables['SERIE']  := cdsNFS.FieldByName('SERIE').AsString;
    frxDanfe.Script.Variables['NUMRPS'] := cdsNFS.FieldByName('NUMRPS').AsString;
    frxDanfe.Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['VALLIQ'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRLIQ').AsFloat));
    frxDanfe.Script.Variables['CARTRI'] := FormatFloat('#,##0.00', fCalculaCargaTributaria((cdsNFS.FieldByName('VLRSER').AsFloat)));
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('ALIISS').AsFloat));
    frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRSER').AsFloat * ( cdsNFS.FieldByName('ALIISS').AsFloat / 100 ) ) );
    frxDanfe.Script.Variables['VALSER'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['DEDUCA'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['BC_PIS'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQPIS'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['BC_COF'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQCOF'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['BCCSLL'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQCSL'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);
    frxDanfe.Script.Variables['BCIRRF'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQIRR'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['BCINSS'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQINS'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['TOTIMP'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['DISCRI'] := AnsiReplaceStr(UpperCase(cdsNFS.FieldByName('DISCRI').AsString), '|', sLineBreak);
    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['CODTRI'] := cdsNFS.FieldByName('CODTRI').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(fStrZero(AnsiReplaceStr(cdsNFS.FieldByName('CODSER').AsString, '.', ''),4));
    frxDanfe.Script.Variables['IMPFED'] := '0,00';
    frxDanfe.Script.Variables['IMPEST'] := '0,00';
    frxDanfe.Script.Variables['IMPMUN'] := '0,00';
    frxDanfe.Script.Variables['LOCAL_RECOLHIMENTO'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('ORGMUN').AsString])+'-'+
                                                       cdsNFS.FieldByName('ORG_UF').AsString;
    frxDanfe.Script.Variables['TRIBUTACAO'] := 'Tributação por Faturamento (Variável)';
    frxDanfe.Script.Variables['MES_COMPETENCIA'] := cdsNFS.FieldByName('COMPET').asString;
    frxDanfe.Script.Variables['CNAE'] := cdsNFS.FieldByName('CDCNAE').AsString;
    frxDanfe.Script.Variables['DESCNAE'] := fCampoTabela('CNA_NOMCNA', 'CADCNA', ['CNA_CODCNA'], [cdsNFS.FieldByName('CDCNAE').AsString]);
    frxDanfe.Script.Variables['OBSERVACOES'] := '';
    frxDanfe.Script.Variables['VALNTRIB'] := '0,00';
    frxDanfe.Script.Variables['VALDESCINC'] := '0,00';
    frxDanfe.Script.Variables['VALDESCCON'] := '0,00';
    frxDanfe.Script.Variables['VALOUTRET'] := '0,00';
    frxDanfe.Script.Variables['VALRETFED'] :=  FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALPIS').AsFloat+
                                                                        cdsNFS.FieldByName('VALCOF').AsFloat+
                                                                        cdsNFS.FieldByName('VALIRR').AsFloat+
                                                                        cdsNFS.FieldByName('VALCSL').AsFloat));

    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(iif(length(cdsNFS.FieldByName('CODSER').AsString)=3,
                                                                           '0'+cdsNFS.FieldByName('CODSER').AsString,
                                                                           cdsNFS.FieldByName('CODSER').AsString));

    frxDanfe.Script.Variables['VALISSRET'] := '0,00';
    frxDanfe.Script.Variables['TOTTRIB']   := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRSER').AsFloat * ( cdsNFS.FieldByName('ALIISS').AsFloat / 100 ) ) );

    If cdsNFS.FieldByName('EMIOSN').AsString = 'S' Then
      frxDanfe.Script.Variables['OPCSN'] := 'OPTANTE'
    Else If cdsNFS.FieldByName('EMIOSN').AsString = 'N' Then
      frxDanfe.Script.Variables['OPCSN'] := 'NÃO OPTANTE';

    if (Assigned(frxDanfe.FindObject('imgQrCode'))) and (Not fEmptyStr(strTextoQRCode)) then
    begin

      bmpQrCode := TBitmap.Create;
      stream := TMemoryStream.Create;

      try

        frxQrCodeCorpo := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
        bmpQrCode      := fGerarQRCode(strTextoQRCode);

        bmpQrCode.SaveToStream(stream);
        frxQrCodeCorpo.Visible := Not fEmptyStr( strTextoQRCode );

      {$IF Defined(LINUX)}
        frxQrCodeCorpo.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCodeCorpo.LoadPictureFromStream(stream);
      {$IFEND}


      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;

    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For intContador := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;
        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSGuaruja(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao, blnPDF_Banco: Boolean);
Var
  strTextoQRCode: string;
  stream: TMemoryStream;
  bmpQrCode: TBitmap;
  intTentativas : Integer;
  LStreamDanfe: TStringStream;
begin
  Try
    cdsNFS.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    pConfigurarLogotipoDanfse;

    frxDanfe.Script.Variables['COMPET'] := Copy(cdsNFS.FieldByName('COMPET').AsString,9,2)+'/'+
                                           Copy(cdsNFS.FieldByName('COMPET').AsString,6,2)+'/'+
                                           Copy(cdsNFS.FieldByName('COMPET').AsString,1,4);

    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
    frxDanfe.Script.Variables['NOMFAN'] := cdsNFS.FieldByName('PSVFANT').AsString;
    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('PSVIM').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('PSVMUN').AsString]);
    frxDanfe.Script.Variables['UFPRES'] := cdsNFS.FieldByName('PSVUF').AsString;
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('PSVEND').AsString;
    frxDanfe.Script.Variables['NUENPR'] := cdsNFS.FieldByName('PSVNUM').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('PSVBAIR').AsString;
    frxDanfe.Script.Variables['CEPPRE'] := fFormataCEP(cdsNFS.FieldByName('PSVCEP').AsString);
    frxDanfe.Script.Variables['FONPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('PSVFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['EMAPRE'] := cdsNFS.FieldByName('PSVEMAIL').AsString;

    frxDanfe.Script.Variables['DOCDES'] := fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString);
    frxDanfe.Script.Variables['IMDEST'] := cdsNFS.FieldByName('TMSIM').AsString;
    frxDanfe.Script.Variables['CIDDES'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TMSMUN').AsString]);
    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('TMSUF').AsString;
    frxDanfe.Script.Variables['EMIRPS'] := cdsNFS.FieldByName('EMIRPS').AsString;
    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('TMSEND').AsString;
    frxDanfe.Script.Variables['NUENDE'] := cdsNFS.FieldByName('TMSNUM').AsString;
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('TMSBAIR').AsString;
    frxDanfe.Script.Variables['CEPDES'] := fFormataCEP(cdsNFS.FieldByName('TMSCEP').AsString);
    frxDanfe.Script.Variables['COMPDE'] := cdsNFS.FieldByName('TMSCOMPL').AsString;
    frxDanfe.Script.Variables['FONDES'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('TMSFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('TMSEMAIL').AsString;

    frxDanfe.Script.Variables['DESCRI'] := AnsiReplaceStr(AnsiReplaceStr(UpperCase(cdsNFS.FieldByName('DISCRI').AsString), '#', sLineBreak), '|', sLineBreak);

    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);
    frxDanfe.Script.Variables['CODTRI'] := cdsNFS.FieldByName('CODTRI').AsString;

    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);

    frxDanfe.Script.Variables['DEDUCA'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALDED').AsFloat);

    frxDanfe.Script.Variables['VALSER'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['VALDESCINC'] := '0,00';
    frxDanfe.Script.Variables['VALDESCCON'] := '0,00';
    frxDanfe.Script.Variables['VALRETFED'] :=  FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALPIS').AsFloat+
                                                  cdsNFS.FieldByName('VALCOF').AsFloat+
                                                  cdsNFS.FieldByName('VALIRR').AsFloat+
                                                  cdsNFS.FieldByName('VALCSL').AsFloat));
    frxDanfe.Script.Variables['VALISSRET'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat);
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRLIQ').AsFloat));

    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('ALIISS').AsFloat);

    frxDanfe.Script.Variables['VALOUTRET'] := '0,00';

    frxDanfe.Script.Variables['LOCAL_RECOLHIMENTO'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('ORGMUN').AsString])+'-'+
                                                       cdsNFS.FieldByName('ORG_UF').AsString;

    If cdsNFS.FieldByName('NATOPE').AsInteger = 1 Then
      frxDanfe.Script.Variables['NATOPE'] := '1 - Tributação no município'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 2 Then
      frxDanfe.Script.Variables['NATOPE'] := '2 - Tributação fora do município'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 3 Then
      frxDanfe.Script.Variables['NATOPE'] := '3 - Isenção'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 4 Then
      frxDanfe.Script.Variables['NATOPE'] := '4 - Imune'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 5 Then
      frxDanfe.Script.Variables['NATOPE'] := '5 - Exigibilidade suspensa'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 6 Then
      frxDanfe.Script.Variables['NATOPE'] := '6 - Exigibilidade suspensa'
    Else
      frxDanfe.Script.Variables['NATOPE'] := '0 - Nenhum';

    If cdsNFS.FieldByName('CODRET').AsInteger = 0 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '0 - Nenhum'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 1 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '1 - Microempresa municipal'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 2 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '2 - Estimativa'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 3 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '3 - Sociedade de profissionais'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 4 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '4 - Cooperativa'
    Else
      frxDanfe.Script.Variables['REGESPTRIB'] := '1 - Microempresa municipal';

    If cdsNFS.FieldByName('EMIOSN').AsInteger = 1 Then
      frxDanfe.Script.Variables['OPCSN'] := '1 - SIM'
    Else If cdsNFS.FieldByName('EMIOSN').AsInteger = 2 Then
      frxDanfe.Script.Variables['OPCSN'] := '2 - NÃO'
    Else
      frxDanfe.Script.Variables['OPCSN'] := '0 - Nenhum';

    If cdsNFS.FieldByName('EMIICC').AsInteger = 1 Then
      frxDanfe.Script.Variables['INCCULT'] := '1 - SIM'
    Else If cdsNFS.FieldByName('EMIICC').AsInteger = 2 Then
      frxDanfe.Script.Variables['INCCULT'] := '2 - NÃO'
    Else
      frxDanfe.Script.Variables['INCCULT'] := '0 - Nenhum';

    if (cdsNFS.FieldByName('VLRISS').AsFloat = 0) then
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat)
    else
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat);

    If Assigned(frxDanfe.FindObject('imgQrCodeCorpo')) Then
    begin
      strTextoQRCode := 'http://visualizar.ginfes.com.br/report/consultarNota?__report=nfs_ver4&cdVerificacao='+
                         cdsNFS.FieldByName('CODVER').AsString+
                         '&numNota='+
                         cdsNFS.FieldByName('NUMNFS').AsString+
                         '&cnpjPrestador=null';

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).Visible := True;

      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).LoadPictureFromStream(stream);
      {$IFEND}


      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    FillChar(recInputImpressao, SizeOf(recInputImpressao), #0);
    recInputImpressao.blnDesignReport := blnDesignReport;
    recInputImpressao.blnPDF_Gerar := blnPDF_Gerar;
    recInputImpressao.blnPDF_Banco := blnPDF_Banco;
    recInputImpressao.blnPDF_Apresentar := blnPDF_Apresentar;
    recInputImpressao.blnReimpressao := blnReimpressao;
    recInputImpressao.strImpressora := strImpressora;
    recInputImpressao.strPDF_Diretorio := strPDF_Diretorio;
    recInputImpressao.strChaveAcesso := strChaveAcesso;
    pConfigurarSaidaImpressao(recInputImpressao);

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSGurupi(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao,
  blnPDF_Banco: Boolean);
Var
  i,
  intQtdVias, intTentativas: Integer;
  strNomImp: string;
  LMesComp, LAnoComp : string;
  strVerQrCode, strTextoQRCode: string;
  stream: TMemoryStream;
  bmpQrCode: TBitmap;
  LStreamDanfe: TStringStream;
begin
  Try

    cdsNFS.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    strVerQrCode := iif(ConexaoBD.CarregarCFGSIS('NFSENO')='S', '4', '15');
    pConfigurarLogotipoDanfse;

    LAnoComp := Copy(cdsNFS.FieldByName('COMPET').asString,1,4);
    LMesComp := Copy(cdsNFS.FieldByName('COMPET').asString,6,2);

    frxDanfe.Script.Variables['ANOCPT'] := LAnoComp + StringOfChar('0', 8 - Length(LAnoComp));

    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
    frxDanfe.Script.Variables['NOMFAN'] := cdsNFS.FieldByName('PSVFANT').AsString;

    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('PSVIM').AsString;
    frxDanfe.Script.Variables['IEPRES'] := cdsNFS.FieldByName('IEPRES').AsString;
    frxDanfe.Script.Variables['FONPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('PSVFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('PSVEND').AsString;
    frxDanfe.Script.Variables['NUENPR'] := cdsNFS.FieldByName('PSVNUM').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('PSVBAIR').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('PSVMUN').AsString]);
    frxDanfe.Script.Variables['UFPRES'] := cdsNFS.FieldByName('PSVUF').AsString;
    frxDanfe.Script.Variables['CEPPRE'] := fFormataCEP(cdsNFS.FieldByName('PSVCEP').AsString);
    frxDanfe.Script.Variables['EMAPRE'] := cdsNFS.FieldByName('PSVEMAIL').AsString;

    frxDanfe.Script.Variables['EMIRPS'] := cdsNFS.FieldByName('EMIRPS').AsString;
    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('TMSEND').AsString;
    frxDanfe.Script.Variables['NUENDE'] := cdsNFS.FieldByName('TMSNUM').AsString;
    frxDanfe.Script.Variables['COMPDE'] := cdsNFS.FieldByName('TMSCOMPL').AsString;
    frxDanfe.Script.Variables['CEPDES'] := fFormataCEP(cdsNFS.FieldByName('TMSCEP').AsString);
    frxDanfe.Script.Variables['FONDES'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('TMSFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['DOCDES'] := fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString);
    frxDanfe.Script.Variables['IMDEST'] := cdsNFS.FieldByName('TMSIM').AsString;
    frxDanfe.Script.Variables['IEDEST'] := cdsNFS.FieldByName('TMSIE').AsString;
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('TMSBAIR').AsString;
    frxDanfe.Script.Variables['CIDDES'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TMSMUN').AsString]);
    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('TMSUF').AsString;
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('TMSEMAIL').AsString;
    frxDanfe.Script.Variables['NUMNFS'] := fStrZero(cdsNFS.FieldByName('NUMNFS').AsString, 8);
    frxDanfe.Script.Variables['SERIE']  := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['NUMRPS'] := cdsNFS.FieldByName('NUMRPS').AsString;
    frxDanfe.Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['VALLIQ'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRLIQ').AsFloat));
    frxDanfe.Script.Variables['CARTRI'] := FormatFloat('#,##0.00', fCalculaCargaTributaria((cdsNFS.FieldByName('VLRSER').AsFloat)));
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.0000', cdsNFS.FieldByName('ALIISS').AsFloat);

    if (cdsNFS.FieldByName('VLRISS').AsFloat = 0) then
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat)
    else
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat);

    frxDanfe.Script.Variables['VALSER'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['DEDUCA'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['BC_PIS'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQPIS'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['BC_COF'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQCOF'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['BCCSLL'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQCSL'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);
    frxDanfe.Script.Variables['BCIRRF'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQIRR'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['BCINSS'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQINS'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['TOTIMP'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['DESCRI'] := AnsiReplaceStr(AnsiReplaceStr(UpperCase(cdsNFS.FieldByName('DISCRI').AsString), '#', sLineBreak), '|', sLineBreak);
    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['CODTRI'] := cdsNFS.FieldByName('CODTRI').AsString;
    frxDanfe.Script.Variables['OUTINF'] := AnsiReplaceStr(cdsNFS.FieldByName('OUTINF').AsString, '|', sLineBreak);
    frxDanfe.Script.Variables['LOCPRE'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('CODMUN').AsString]);
    frxDanfe.Script.Variables['UFPRES'] := fCampoTabela('CID_ESTADO', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('CODMUN').AsString]);


    If Assigned(frxDanfe.FindObject('memCodServAtividade')) Then
    begin
      frxDanfe.Script.Variables['CODTRI_DESCRI'] := cdsNFS.FieldByName('CODTRI').AsString+' - '+
                                      fCampoTabela('CNA_NOMCNA', 'CADCNA', ['CNA_CODCNA'], [Copy(cdsNFS.FieldByName('CODTRI').AsString,1,7)] );
    end;

    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(iif(length(cdsNFS.FieldByName('CODSER').AsString)=3,
                                                                           '0'+cdsNFS.FieldByName('CODSER').AsString,
                                                                           cdsNFS.FieldByName('CODSER').AsString));
    frxDanfe.Script.Variables['IMPFED'] := '0,00';
    frxDanfe.Script.Variables['IMPEST'] := '0,00';
    frxDanfe.Script.Variables['IMPMUN'] := '0,00';
    frxDanfe.Script.Variables['LOCAL_RECOLHIMENTO'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('ORGMUN').AsString])+'-'+
                                                       cdsNFS.FieldByName('ORG_UF').AsString;
    frxDanfe.Script.Variables['TRIBUTACAO'] := 'Tributação por Faturamento (Variável)'; //Conforme Leandro da FIT, outro campo fixo.
    frxDanfe.Script.Variables['MES_COMPETENCIA'] := LMesComp+'/'+LAnoComp;
    frxDanfe.Script.Variables['DTACPT'] := cdsNFS.FieldByName('COMPET').asString;

    If (cdsNFS.FieldByName('ISS_RET').AsString = '2') Then
      frxDanfe.Script.Variables['RECOLHIMENTO'] := 'Sem Retenção';
    frxDanfe.Script.Variables['CNAE'] := cdsNFS.FieldByName('CDCNAE').AsString;
    frxDanfe.Script.Variables['OBSERVACOES'] := '';
    frxDanfe.Script.Variables['VALNTRIB'] := '0,00';
    frxDanfe.Script.Variables['VALDESCINC'] := '0,00';
    frxDanfe.Script.Variables['VALDESCCON'] := '0,00';
    frxDanfe.Script.Variables['VALOUTRET'] := '0,00';
    frxDanfe.Script.Variables['VALRETFED'] :=  FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALPIS').AsFloat+
                                                                     cdsNFS.FieldByName('VALCOF').AsFloat+
                                                                        cdsNFS.FieldByName('VALIRR').AsFloat+
                                                                        cdsNFS.FieldByName('VALCSL').AsFloat));
    frxDanfe.Script.Variables['VALISSRET'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat);

    If cdsNFS.FieldByName('NATOPE').AsInteger = 1 Then
      frxDanfe.Script.Variables['NATOPE'] := '1 - Tributação no município'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 2 Then
      frxDanfe.Script.Variables['NATOPE'] := '2 - Tributação fora do município'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 3 Then
      frxDanfe.Script.Variables['NATOPE'] := '3 - Isenção'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 4 Then
      frxDanfe.Script.Variables['NATOPE'] := '4 - Imune'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 5 Then
      frxDanfe.Script.Variables['NATOPE'] := '5 - Exigibilidade suspensa'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 6 Then
      frxDanfe.Script.Variables['NATOPE'] := '6 - Exigibilidade suspensa';

    If cdsNFS.FieldByName('CODRET').AsInteger = 0 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '0 - Nenhum'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 1 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '1 - Microempresa municipal'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 2 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '2 - Estimativa'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 3 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '3 - Sociedade de profissionais'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 4 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '4 - Cooperativa'
    Else
      frxDanfe.Script.Variables['REGESPTRIB'] := '1 - Microempresa municipal';

    If cdsNFS.FieldByName('EMIOSN').AsInteger = 1 Then
      frxDanfe.Script.Variables['OPCSN'] := 'Sim'
    Else If cdsNFS.FieldByName('EMIOSN').AsInteger = 2 Then
      frxDanfe.Script.Variables['OPCSN'] := 'Não';

    If cdsNFS.FieldByName('EMIICC').AsInteger = 1 Then
      frxDanfe.Script.Variables['INCCULT'] := 'Sim'
    Else If cdsNFS.FieldByName('EMIICC').AsInteger = 2 Then
      frxDanfe.Script.Variables['INCCULT'] := 'Não';

    If cdsNFS.FieldByName('EXIISS').AsInteger = 1 Then
      frxDanfe.Script.Variables['EXIISS'] := 'Exigível em Gurupi'
    Else If cdsNFS.FieldByName('EXIISS').AsInteger = 2 Then
      frxDanfe.Script.Variables['EXIISS'] := 'Não'
    Else
      frxDanfe.Script.Variables['EXIISS'] := '';

    if Assigned(frxDanfe.FindObject('barCode')) then
    begin
      TfrxBarCodeView(frxDanfe.FindObject('barCode')).Text := cdsNFS.FieldByName('CODVER').AsString;
    end;

    if Assigned(frxDanfe.FindObject('QRCode')) then
    begin
      TfrxBarcode2DView(frxDanfe.FindObject('QRCode')).Text := 'http://visualizar.ginfes.com.br/report/consultarNota?__report=nfs_ver'+strVerQrCode+'&cdVerificacao='+
                                                               cdsNFS.FieldByName('CODVER').AsString+
                                                               '&numNota='+
                                                               cdsNFS.FieldByName('NUMNFS').AsString+
                                                               '&cnpjPrestador=null';
    end;

    If Assigned(frxDanfe.FindObject('imgQrCode')) Then
    begin
      strTextoQRCode := 'https://gurupito.webiss.com.br/externo/nfse/visualizar/'+cdsNFS.FieldByName('PSVCNPJ').AsString+
                        '/'+cdsNFS.FieldByName('CODVER').AsString+'/'+cdsNFS.FieldByName('NUMNFS').AsString;

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Visible := True;

      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).LoadPictureFromStream(stream);
      {$IFEND}
      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For i := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

