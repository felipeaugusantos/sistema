            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
