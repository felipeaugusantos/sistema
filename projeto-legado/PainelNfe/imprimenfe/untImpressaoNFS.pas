                                           fRetDescCNAE(cdsNFS.FieldByName('CDCNAE').AsString);
    frxDanfe.Script.Variables['DESSER'] := cdsNFS.FieldByName('CODSER').AsString +' - '+
                                           fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);
    Case cdsNFS.FieldByName('ISS_RET').AsInteger Of
      1: frxDanfe.Script.Variables['ISSRET'] := 'SIM';
