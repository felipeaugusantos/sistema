    end
    else
    begin
      if cdsNFS.FindField('VALNFS') <> Nil then
      begin
        frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALNFS').AsFloat));
