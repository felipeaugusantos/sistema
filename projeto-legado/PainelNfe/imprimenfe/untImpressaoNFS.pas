function TImpressaoNFS.fRetCidade(strTomPre, strCnpj: string): string;
var
  LQuery: {$IF Defined(UNIDAC)} TUniQuery {$ELSE} TZQuery {$IFEND};
begin
  Result := EmptyStr;
  LQuery := fCriaQuery;

  try
    if (strTomPre='P') then
    begin

      LQuery.Close;
      LQuery.SQL.Clear;

      LQuery.SQL.Add('SELECT CONCAT(CD.CID_NOMCID, "-", CD.CID_ESTADO) AS CIDEMP FROM CADEMP EM ');
      LQuery.SQL.Add('LEFT JOIN CADCID CD ON CD.CID_CODCID = EM.EMP_CODCID ');
      LQuery.SQL.Add('WHERE EMP_C_G_C_ = :CNPJ');

      LQuery.ParamByName('CNPJ').AsString := strCnpj;

      LQuery.Open;

      if (not LQuery.IsEmpty) then
      begin
        Result := LQuery.FieldByName('CIDEMP').AsString;
      end;

    end
    else if (strTomPre='T') then
    begin
      LQuery.Close;
      LQuery.SQL.Clear;

      LQuery.SQL.Add('SELECT CONCAT(CD.CID_NOMCID, "-", CD.CID_ESTADO) AS CIDCLI FROM CADCLI CL ');
      LQuery.SQL.Add('LEFT JOIN CADCID CD ON CD.CID_CODCID = CL.CLI_CODCID ');
      LQuery.SQL.Add('WHERE CLI_C_G_C_ = :CNPJ ');

      LQuery.ParamByName('CNPJ').AsString := strCnpj;

      LQuery.Open;

      if (not LQuery.IsEmpty) then
      begin
        Result := LQuery.FieldByName('CIDCLI').AsString;
      end;
    end;

  finally
    FreeAndNil(LQuery);
  end;
end;

