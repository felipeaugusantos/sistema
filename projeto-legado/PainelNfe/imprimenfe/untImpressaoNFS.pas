    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('DOCPRE').AsString);
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('IMPRES').AsString;
    frxDanfe.Script.Variables['IEPRES'] := cdsNFS.FieldByName('IEPRES').AsString;
    frxDanfe.Script.Variables['FONPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('FONPRE').AsString, ' ', ''));
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('ENDPRE').AsString;
    frxDanfe.Script.Variables['NUENPR'] := cdsNFS.FieldByName('NUENPR').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('BAIPRE').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := cdsNFS.FieldByName('CIDPRE').AsString;
    frxDanfe.Script.Variables['UFPRES'] := cdsNFS.FieldByName('UFPRES').AsString;
    frxDanfe.Script.Variables['CEPPRE'] := fFormataCEP(cdsNFS.FieldByName('CEPPRE').AsString);
    frxDanfe.Script.Variables['EMAPRE'] := cdsNFS.FieldByName('EMAPRE').AsString;
    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('ENDDES').AsString;
    frxDanfe.Script.Variables['NUENDE'] := cdsNFS.FieldByName('NUENDE').AsString;
    frxDanfe.Script.Variables['COMPDE'] := cdsNFS.FieldByName('COMPDE').AsString;
    frxDanfe.Script.Variables['CEPDES'] := fFormataCEP(cdsNFS.FieldByName('CEPDES').AsString);
    frxDanfe.Script.Variables['FONDES'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('FONDES').AsString, ' ', ''));
    frxDanfe.Script.Variables['DOCDES'] := fFormataCpfCgc(cdsNFS.FieldByName('DOCDES').AsString);
    frxDanfe.Script.Variables['IEDEST'] := cdsNFS.FieldByName('IEDEST').AsString;
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('BAIDES').AsString;
    frxDanfe.Script.Variables['CIDDES'] := cdsNFS.FieldByName('CIDDES').AsString;
    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('UFDEST').AsString;
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('EMADES').AsString;
    frxDanfe.Script.Variables['NUMNFS'] := fStrZero(cdsNFS.FieldByName('NUMNFS').AsString, 8);
    frxDanfe.Script.Variables['SERIE']  := cdsNFS.FieldByName('SERIE').AsString;
    frxDanfe.Script.Variables['NUMRPS'] := cdsNFS.FieldByName('NUMRPS').AsString;
    frxDanfe.Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
    If (cdsNFS.FieldByName('ISSRET').AsString = 'S') Then
    begin
      frxDanfe.Script.Variables['VALLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALNFS').AsFloat-cdsNFS.FieldByName('VALISS').AsFloat));
      frxDanfe.Script.Variables['CARTRI'] := FormatFloat('#,##0.00', fCalculaCargaTributaria((cdsNFS.FieldByName('VALNFS').AsFloat-cdsNFS.FieldByName('VALISS').AsFloat)));
    end
    else If (cdsNFS.FieldByName('ISSRET').AsString = 'N') Then
    begin
      frxDanfe.Script.Variables['VALLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALNFS').AsFloat));
      frxDanfe.Script.Variables['CARTRI'] := FormatFloat('#,##0.00', fCalculaCargaTributaria(cdsNFS.FieldByName('VALNFS').AsFloat));
    end;
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('ALQISS').AsFloat);
    frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALISS').AsFloat);
    frxDanfe.Script.Variables['VALSER'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALSER').AsFloat);
    frxDanfe.Script.Variables['DEDUCA'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('DEDUCA').AsFloat);
    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALNFS').AsFloat);
    frxDanfe.Script.Variables['BC_PIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BC_PIS').AsFloat);
    frxDanfe.Script.Variables['ALQPIS'] := FormatFloat('#,##0.0000', cdsNFS.FieldByName('ALQPIS').AsFloat);
    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['BC_COF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BC_COF').AsFloat);
    frxDanfe.Script.Variables['ALQCOF'] := FormatFloat('#,##0.0000', cdsNFS.FieldByName('ALQCOF').AsFloat);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['BCCSLL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BCCSLL').AsFloat);
    frxDanfe.Script.Variables['ALQCSL'] := FormatFloat('#,##0.0000', cdsNFS.FieldByName('ALQCSL').AsFloat);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);
    frxDanfe.Script.Variables['BCIRRF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BCIRRF').AsFloat);
    frxDanfe.Script.Variables['ALQIRR'] := FormatFloat('#,##0.0000', cdsNFS.FieldByName('ALQIRR').AsFloat);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['BCINSS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BCINSS').AsFloat);
    frxDanfe.Script.Variables['ALQINS'] := FormatFloat('#,##0.0000', cdsNFS.FieldByName('ALQINS').AsFloat);
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['TOTIMP'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat +
                                                                   cdsNFS.FieldByName('VALCOF').AsFloat +
                                                                   cdsNFS.FieldByName('VALCSL').AsFloat +
                                                                   cdsNFS.FieldByName('VALIRR').AsFloat +
                                                                   cdsNFS.FieldByName('VALINS').AsFloat);

    frxDanfe.Script.Variables['VALEXT'] := fRetExtensoNumero(FloatToStr(cdsNFS.FieldByName('VALNFS').AsFloat));

    frxDanfe.Script.Variables['NFUTI'] := cdsNFS.FieldByName('NFUTI').AsString;
    frxDanfe.Script.Variables['NUMOS'] := cdsNFS.FieldByName('NUMOS').AsString;

    If (cdsNFS.FieldByName('ISSRET').AsString = 'N') Then
      frxDanfe.Script.Variables['INSRES'] := 'O ISS NÃO DEVE SER RETIDO'
    Else
      frxDanfe.Script.Variables['INSRES'] := '';

    strDescri := AnsiReplaceStr(AnsiReplaceStr(UpperCase(cdsNFS.FieldByName('DESCRI').AsString), '#', sLineBreak), '|', sLineBreak);
    If Pos('RRNRRN-RRNRPS', strDescri) > 0 Then
    Begin
      frxDanfe.Script.Variables['DESCRI'] := Copy(strDescri,0,(Pos('.RRNRRN-RRNRPS',strDescri))-1);
    End
    Else
      frxDanfe.Script.Variables['DESCRI'] := strDescri;

    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);
    frxDanfe.Script.Variables['MENRPS'] := strMensagemRPS;


  If Assigned(frxDanfe.FindObject('imgQrCodeCorpo')) Then
    begin
      strTextoQRCode := 'https://sumare.sigissweb.com/validarnfe?codigo=' + cdsNFS.FieldByName('NUMDAN').AsString ;

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).Visible := True;

      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).LoadPictureFromStream(stream);
      {$IFEND}

      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For intContador := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;


end;

