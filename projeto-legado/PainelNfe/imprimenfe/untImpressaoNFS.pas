    frxDanfe.Script.Variables['OUTINF'] := cdsNFS.FieldByName('OUTINF').AsString;

    frxDanfe.Script.Variables['NUMNFS'] := cdsNFS.FieldByName('NUMNFS').AsString;
    frxDanfe.Script.Variables['NUMRPS'] := cdsNFS.FieldByName('NUMRPS').AsString;
    frxDanfe.Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['DISCRI'] := cdsNFS.FieldByName('DISCRI').AsString;
    frxDanfe.Script.Variables['CODVER'] := cdsNFS.FieldByName('CODVER').AsString;
