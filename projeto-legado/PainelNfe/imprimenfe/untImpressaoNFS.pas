begin
  Result := False;

  If not (ConexaoBD.CarregarCFGSIS('NFSENO') = 'S') Then
    Exit;

  If (Pos('P-', strChaveAcesso) > 0) Then
    Exit;

  Result := True;
end;

procedure TImpressaoNFS.Imprimir(strCodEmp,
                                 strEspDoc,
                                 strChaveAcesso    : String;
                                 strImpressora     : String  = '';
                                 blnDesignReport   : Boolean = False;
                                 blnPDF_Gerar      : Boolean = False;
                                 strPDF_Diretorio  : String  = '';
                                 blnPDF_Apresentar : Boolean = False;
                                 blnReimpressao    : Boolean = False;
                                 blnPDF_Banco      : Boolean = False);

var
  qryAcesso: {$IF Defined(UNIDAC)} TUniQuery {$ELSE} TZQuery {$IFEND};
  objImpressaoNfs: untConexaoBD.TImpressaoNfs;
  strEmail,
  strFone,
  strFone2,
  strInsEst,
  strCNAE,
  strXML,
  strIM,
  strIE,
  strRazSoc,
  strEnder,
  strNume,
  srtBairro,
  strCidad,
  strCEP,
  strUF,
  strCompl,
  strCidadeNFSe,
  strTomadorI_E_S_,
  strTomadorEmail_,
  strTomadorFone01,
  strTomadorUF,
  strTomadorEmail2,
  strTomadorIM,
  strTomadorCidade,
  strTomadorComplEnder,
  strTomadorCelular,
  strDiscriminacaoServico,
  strCodSer,
  strDadosCndFpg,
  strCNPJ,
  strIteDes,
  strFant,
  strHomePage : String;
  dtaDtaAut: TDateTime;
  ATipoNFS : TTipoNFS;
  strSerOBS: string;
  fltVALDED: Double;
  strDtaDel: String;
  strHorDel: String;
  strMotDel: String;
  strEspNF: String;
  strEmpNF: String;
  strNumNF: String;
  strMunPre: String;
  strProvedor: String;
  strEdtPrv: String;
  strXmlObr, strDesPrv: String;

  fltVlrCofins: Double;
  fltVlrCsll  : Double;
  fltVlrPis   : Double;
  fltVlrIr    : Double;
  fltVlrInss  : Double;
  strParcelas : String;
  strSerMun   : String;
  strCNFNFE   : String;
  strMsgFis   : String;
  strMovObs   : String;
  strIndOpe   : String;
  strCodNBS   : String;

begin
  VS_Desativa_eNotas := fDesativa_eNotas(strChaveAcesso);
  qryAcesso := fCriaQuery;
  try

    strCidadeNFSe := ConexaoBD.CarregarCFGSIS('CIDNFS');
    if fEmptyStr(strCidadeNFSe) then
      strCidadeNFSe := ConexaoBD.CarregarCFGSIS('EMPSER');

    qryAcesso.Close;
    qryAcesso.SQL.Clear;
    qryAcesso.SQL.Add(' SELECT DISTINCT');
    qryAcesso.SQL.Add('    FIS_NUMDOC AS NFE_NUMDOC, ');
    qryAcesso.SQL.Add('    FIS_ESPDOC AS NFE_ESPDOC, ');
    qryAcesso.SQL.Add('    FIS_SERIE_ AS NFE_SERIE_, ');
    qryAcesso.SQL.Add('    FIS_CODEMP AS NFE_CODEMP, ');
    qryAcesso.SQL.Add('    FIS_ACESSO AS NFE_ACESSO, ');
    qryAcesso.SQL.Add('    FIS_TIP_FC AS NFE_TIP_FC, ');
    qryAcesso.SQL.Add('    FIS_DTADOC AS NFE_DTAAUT  ');
    qryAcesso.SQL.Add(' FROM              ');
    qryAcesso.SQL.Add('    CADFIS         ');
    qryAcesso.SQL.Add('  WHERE FIS_ACESSO = :ACESSO');
    qryAcesso.SQL.Add('    AND FIS_ESPDOC = :ESPDOC');
    qryAcesso.SQL.Add('    AND FIS_CODEMP = :CODEMP');

    qryAcesso.ParamByName('ACESSO').AsString := strChaveAcesso;
    qryAcesso.ParamByName('ESPDOC').AsString := strEspDoc;
    qryAcesso.ParamByName('CODEMP').AsString := strCodEmp;
    qryAcesso.Open;

    if (not qryAcesso.IsEmpty) then
    begin

      If (ConexaoBD.CarregarCFGSIS('NFSENO') = 'S') And Not ConexaoBD.fPrefeituraComLayoutNfse(strCidadeNFSe) Then
      begin

        If blnPDF_Gerar Then
        Begin
          pLogImp('NfeImpressao - blnPDF_Gerar = True');
          ConexaoBD.CarregarPDF(strChaveAcesso, strPDF_Diretorio, false);

          pLogImp('NfeImpressao - blnPDF_Apresentar = ' + IIF(blnPDF_Apresentar, 'True', 'False'));

          If blnPDF_Apresentar Then
          Begin
          {$IF Defined(LINUX)}
          {$ELSE}
            If FileExists(strPDF_Diretorio) Then
            Begin
              pLogImp('NfeImpressao - Apresenta PDF - Comando a ser executado no ShellExecute: ' + strPDF_Diretorio);
              ShellExecute(0, 'open', PChar(strPDF_Diretorio), '' , '' , SW_HIDE);
              pLogImp('NfeImpressao - Apresenta PDF - Executou ShellExecute');
            End;
          {$IFEND}
          End;

          Exit;
        End;

        If SameText(fTiraCaracEspeciais(strImpressora), fTiraCaracEspeciais(PontoNaoImprimir)) then
        Begin
          pLogImp('NfeImpressao - PontoNaoImprimir');
          Exit;
        End;

        if (strImpressora = PontoExportarPDF) then
        Begin
          pLogImp('NfeImpressao - PontoExportarPDF');
          pEnotasExportarPDF(strChaveAcesso, strImpressora);
          pLogImp('NfeImpressao - Executou pEnotasExportarPDF');
        End
        {$IFDEF UNIDAC}
        Else If fUtilizaSpoolImpressaoCitel(strCodEmp) Then
        Begin
          pLogImp('NfeImpressao - pEnotasSpoolImpressao na impressora: ' + strImpressora);
          pEnotasSpoolImpressao(strChaveAcesso, strImpressora);
          pLogImp('NfeImpressao - Executou pEnotasSpoolImpressao');
        End
        {$ENDIF}
        Else
        Begin
          pLogImp('NfeImpressao - pEnotasImpressaoDireta na impressora: ' + strImpressora);
          pEnotasImpressaoDireta(strChaveAcesso, strImpressora);
          pLogImp('NfeImpressao - Executou pEnotasImpressaoDireta');
        End;

        Exit;
      end;

      strChaveAcesso := qryAcesso.FieldByName('NFE_ACESSO').AsString;
      dtaDtaAut      := qryAcesso.FieldByName('NFE_DTAAUT').AsDateTime;
      strXML         := ConexaoBD.CarregarXML(strChaveAcesso);

      // Liga por CFG_EDTIMS='S' e, por cidade, CIDNFS.NFS_EDTPRV apontando um provedor em
      // IMPNFE_PRV com dataset cadastrado. Fora disso segue o fluxo normal, sem alteracao.
      If (ConexaoBD.CarregarCFGSIS('EDTIMS') = 'S') Then
      Begin
        strEdtPrv := '';
        If fCampoExiste('CIDNFS', 'NFS_EDTPRV') Then
          strEdtPrv := fCampoTabela('NFS_EDTPRV', 'CIDNFS', ['NFS_CIDADE'], [strCidadeNFSe])
        Else
