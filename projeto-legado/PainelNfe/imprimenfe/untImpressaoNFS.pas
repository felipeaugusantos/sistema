    frxDanfe.Script.Variables['FONDES'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('TMSFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['DOCDES'] := fFormataCpfCgc(cdsNFS.FieldByName('TOMCNPJ').AsString);
    frxDanfe.Script.Variables['IMDEST'] := cdsNFS.FieldByName('TMSIM').AsString;
    frxDanfe.Script.Variables['IEDEST'] := '';
    frxDanfe.Script.Variables['CDCNAE'] := cdsNFS.FieldByName('CDCNAE').AsString;
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('TOMBAI').AsString;
    frxDanfe.Script.Variables['CIDDES'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TOMCID').AsString]);
    frxDanfe.Script.Variables['UFDEST'] := fCampoTabela('CID_ESTADO', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TOMCID').AsString]);
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('TOMEMA').AsString;
    frxDanfe.Script.Variables['NUMNFS'] := fStrZero(cdsNFS.FieldByName('NUMNFS').AsString, 8);
    frxDanfe.Script.Variables['SERIE']  := cdsNFS.FieldByName('SERRPS').AsString;
