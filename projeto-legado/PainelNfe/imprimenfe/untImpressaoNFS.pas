                         '&numero='+cdsNFS.FieldByName('NUMNFS').AsString+
                         '&chave='+cdsNFS.FieldByName('CODVER').AsString;

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
