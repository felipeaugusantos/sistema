    end;

    If (Pos('Informacoes:', cdsNFS.FieldByName('DISCRI').AsString) > 0) And (Assigned(frxDanfe.FindObject('mmObservacoes'))) Then
    begin
      frxDanfe.Script.Variables['DESCRI'] := AnsiReplaceStr(
