function TImpressaoNFS.fDefineViasDeImpressao(const blnPDF_Gerar: Boolean; const blnReimpressao: Boolean): Integer;
begin
  Result := 1;

  If (blnPDF_Gerar) Then
    Exit;

  If (blnReimpressao) Then
    Exit;

  // Permitir informar quantidade zero para clientes que não querem imprimir notas
  Result := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);
end;

procedure TImpressaoNFS.pConfigurarSaidaImpressao(recInput: TInputImpressao);
var
  strNomImp : String;
  intQtdVias : Integer;
  intContador : Integer;
begin
  If recInput.blnDesignReport Then
  Begin
    frxDanfe.DesignReport;
    Exit;
  End;

  strNomImp := recInput.strImpressora;
  intQtdVias := fDefineViasDeImpressao(recInput.blnPDF_Gerar, recInput.blnReimpressao);

  If (not recInput.blnPDF_Banco) Then
  Begin
    For intContador := 1 To intQtdVias Do
    Begin
      If (recInput.blnPDF_Gerar) Then
      Begin

        frxDanfe.EngineOptions.NewSilentMode := simReThrow;
        frxPDFExport.FileName   := recInput.strPDF_Diretorio;
        frxPDFExport.ShowDialog := False;

        frxDanfe.PrintOptions.ShowDialog := False;
        frxDanfe.PrepareReport();

      {$IF Defined(LINUX)}
        frxPDFExport.EmbeddedFonts := True;
      {$IFEND}

        frxDanfe.Export(frxPDFExport);

        If (recInput.blnPDF_Apresentar) Then
        Begin
          if FileExists(frxPDFExport.FileName) then
          begin
           {$IF not defined(LINUX)}
            ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
           {$IFEND}
          end
          else
          begin
            frxPDFExport.ShowDialog := True;
            pPreviewReport('NFeImpressao', 'NFS-e '+ recInput.strChaveAcesso, frxDanfe);
          end;
        End;
      End
      Else
      Begin
        frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
        frxDanfe.PrintOptions.ShowDialog := False;
        If (frxDanfe.PrepareReport) Then
          pPrintReport('NFeImpressao', 'NFS-e '+ recInput.strChaveAcesso, strNomImp, frxDanfe);
        If (intQtdVias > 1) Then
          Sleep(1000);
      End;
    End;
  End;

  If Assigned(ConexaoBD) Then
  Begin
    ConexaoBD.pSalvarDFePDF(frxDanfe, recInput.strChaveAcesso);
  End;
End;

procedure TImpressaoNFS.pConfigurarLogotipoDanfse;
var
{$IF Defined(LINUX)}
  imgLogotipo : FMX.Graphics.TBitmap;
{$ELSE}
  imgLogotipo : TPicture;
{$IFEND}
  vStreamLogotipo : TMemoryStream;
begin
  if NaoEstaVazio(ConexaoBD.FConfiguracao.Logo) then
  begin
    if Assigned(frxDanfe.FindObject('picLogo')) then
    begin
    {$IF Defined(LINUX)}
      imgLogotipo := FMX.Graphics.TBitmap.Create;
    {$ELSE}
      imgLogotipo := TPicture.Create;
    {$IFEND}
      vStreamLogotipo := TMemoryStream.Create;
      try
      {$IF Defined(LINUX)}
        ConverterBase64ParaImagem(ConexaoBD.FConfiguracao.Logo, imgLogotipo);
        imgLogotipo.SaveToStream(vStreamLogotipo);
      {$ELSE}
        ConverterBase64ParaImagem(ConexaoBD.FConfiguracao.Logo, imgLogotipo);
        imgLogotipo.Bitmap.SaveToStream(vStreamLogotipo);
      {$IFEND}
        vStreamLogotipo.position := 0;
      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('picLogo')).Picture.LoadFromStream(vStreamLogotipo);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('picLogo')).LoadPictureFromStream(vStreamLogotipo);
      {$IFEND}
      finally
        freeandnil(imgLogotipo);
        freeandnil(vStreamLogotipo);
      end;
    end;
  end;
end;

