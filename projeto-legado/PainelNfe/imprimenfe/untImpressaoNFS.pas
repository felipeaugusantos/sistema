    frxDanfe.Script.Variables['INSPORCENTO'] := FormatFloat('#,##0.00', ((cdsNFS.FieldByName('VLRINS').AsFloat * 100)/ cdsNFS.FieldByName('VLRSER').AsFloat));
    frxDanfe.Script.Variables['IRRPORCENTO'] := FormatFloat('#,##0.00', ((cdsNFS.FieldByName('VLRIR_').AsFloat * 100)/ cdsNFS.FieldByName('VLRSER').AsFloat));

    if Assigned(frxDanfe.FindObject('imgQrCode')) then
    begin
      If (strCidadeNFSe = 'PREFEITURA DE ITUVERAVA-SP') Then
      Begin
        strCnpjCid := '46.710.422/0001-51';
      End
      Else
      Begin
        strCnpjCid := '45.228.319/0001-07';
      End;
      strTextoQRCode :=
                        'CNPJ Prefeitura: '+ strCnpjCid + #13 +
                        'N.Fiscal N/: ' + fStrZero(cdsNFS.FieldByName('NUMNFS').AsString, 8) + #13 +
                        'CNPJ/CPF Emitente: ' + fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString) + #13 +
                        'CNPJ/CPF Destinatario: ' + fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString) + #13 +
                        'Data Emissao: ' + cdsNFS.FieldByName('DTAEMI').AsString + #13 +
                        'Valor da Nota: ' + FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);

	    frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
