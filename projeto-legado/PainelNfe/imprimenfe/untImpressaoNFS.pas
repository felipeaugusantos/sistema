    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRSER').AsFloat));
    frxDanfe.Script.Variables['VALDED'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRDED').AsFloat));
    frxDanfe.Script.Variables['BASCAL'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('BSCISS').AsFloat));
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('ALIISS').AsFloat));
    frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRISS').AsFloat));
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRLIQ').AsFloat));
    frxDanfe.Script.Variables['DESINC'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('DESCONI').AsFloat));

    frxDanfe.Script.Variables['DESCON'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('DESCONC').AsFloat));
    frxDanfe.Script.Variables['VLRPIS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALPIS').AsFloat));
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALCOF').AsFloat));
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALINS').AsFloat));
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALIRR').AsFloat));
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALCSL').AsFloat));
    frxDanfe.Script.Variables['OUTRET'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('OUT_RET').AsFloat));
    frxDanfe.Script.Variables['ISSRET'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('ISS_RET').AsFloat));

    frxDanfe.Script.Variables['TOTDED'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRDED').AsFloat +
                                                                    cdsNFS.FieldByName('DESCONI').AsFloat));

    frxDanfe.Script.Variables['CIDINC'] := cdsNFS.FieldByName('PSVMUN').AsString + ' - ' + cdsNFS.FieldByName('PSVUF').AsString;

    If cdsNFS.FieldByName('EXIGIB').AsInteger = 1 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'Exigível'
    Else If cdsNFS.FieldByName('EXIGIB').AsInteger = 2 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'Não Exigível';

    If cdsNFS.FieldByName('CODRET').AsString = '1' Then
      frxDanfe.Script.Variables['REGTRI'] := 'Microempresa municipal'
    Else If cdsNFS.FieldByName('CODRET').AsString = '2' Then
      frxDanfe.Script.Variables['REGTRI'] := 'Estimativa'
    Else If cdsNFS.FieldByName('CODRET').AsString = '3' Then
      frxDanfe.Script.Variables['REGTRI'] := 'Sociedade de profissionais'
    Else If cdsNFS.FieldByName('CODRET').AsString = '4' Then
      frxDanfe.Script.Variables['REGTRI'] := 'Cooperativa'
    Else If cdsNFS.FieldByName('CODRET').AsString = '5' Then
      frxDanfe.Script.Variables['REGTRI'] := 'Microempresário Individual (MEI)'
    Else If cdsNFS.FieldByName('CODRET').AsString = '6' Then
      frxDanfe.Script.Variables['REGTRI'] := 'Microempresa ou Empresa de Pequeno Porte (ME-EPP)';

    dtDataVenIss := StrToDate(cdsNFS.FieldByName('DTAEMI').AsString);
    DecodeDate(dtDataVenIss, wAno, wMes, wDia);
    If wMes = 12 Then
    Begin
      dtDataVenIss := EncodeDate(wAno + 1, 01, 20);
    End
    Else
    Begin
      dtDataVenIss := EncodeDate(wAno, wMes + 1, 20);
    End;
    frxDanfe.Script.Variables['DTAVENC'] := DateToStr(dtDataVenIss);

    If Assigned(frxDanfe.FindObject('imgQrCode')) Then
    begin
      strLinkQrCode := 'https://ssparaiso.ereceita.net.br';

	    frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strLinkQrCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    FillChar(recInputImpressao, SizeOf(recInputImpressao), #0);
    recInputImpressao.blnDesignReport := blnDesignReport;
    recInputImpressao.blnPDF_Gerar := blnPDF_Gerar;
    recInputImpressao.blnPDF_Banco := blnPDF_Banco;
    recInputImpressao.blnPDF_Apresentar := blnPDF_Apresentar;
    recInputImpressao.blnReimpressao := blnReimpressao;
    recInputImpressao.strImpressora := strImpressora;
    recInputImpressao.strPDF_Diretorio := strPDF_Diretorio;
    recInputImpressao.strChaveAcesso := strChaveAcesso;
    pConfigurarSaidaImpressao(recInputImpressao);

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

