    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);
    frxDanfe.Script.Variables['CDCNAE'] := cdsNFS.FieldByName('CDCNAE').AsString;
    frxDanfe.Script.Variables['DISCRI'] := cdsNFS.FieldByName('DISCRI').AsString;

    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('ALIISS').AsFloat);
    frxDanfe.Script.Variables['DESCONI'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('DESCONI').AsFloat);
    frxDanfe.Script.Variables['DESCONC'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('DESCONC').AsFloat);
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRLIQ').AsFloat);
    frxDanfe.Script.Variables['BASCALC'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BSCISS').AsFloat);
    frxDanfe.Script.Variables['TOTRIB'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('TOTRIB').AsFloat);

    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['OUTRET'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('OUT_RET').AsFloat);
    frxDanfe.Script.Variables['VALDED'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRDED').AsFloat);

    If cdsNFS.FieldByName('EXIGIB').AsString <> '' Then
    Begin
    If cdsNFS.FieldByName('EXIGIB').AsInteger = 1 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'EXIGIVEL'
    Else If cdsNFS.FieldByName('EXIGIB').AsInteger = 2 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'NÃO EXIGIVEL';
    End
    Else
      frxDanfe.Script.Variables['EXIGIB'] := '';

    If cdsNFS.FieldByName('ISSRET').AsString = '1' Then
    Begin
      frxDanfe.Script.Variables['ISS_RET'] := 'SIM';
      frxDanfe.Script.Variables['VLRISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat);
      frxDanfe.Script.Variables['VALISS'] :=  '0,00';
      blnIssRet := True;
    End
    Else
    Begin
      frxDanfe.Script.Variables['ISS_RET'] := 'NÃO';
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat);
      frxDanfe.Script.Variables['VLRISS'] :=  '0,00';
      blnIssRet := False;
    End;

    if (Assigned(frxDanfe.FindObject('imgQrCode')) And Assigned(frxDanfe.FindObject('imgQrCode2'))And Assigned(frxDanfe.FindObject('imgQrCode3'))And Assigned(frxDanfe.FindObject('imgQrCode4'))) then
    begin
      strLinkQrCode := 'https://www.gp.srv.br/tributario/barradogarcas/portal_autenticacao?1';
      frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
      frxQrCode2 := TfrxPictureView(frxDanfe.FindObject('imgQrCode2'));
      frxQrCode3 := TfrxPictureView(frxDanfe.FindObject('imgQrCode3'));
      frxQrCode4 := TfrxPictureView(frxDanfe.FindObject('imgQrCode4'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strLinkQrCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode.LoadPictureFromStream(stream);
      {$IFEND}

        frxQrCode2.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode2.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode2.LoadPictureFromStream(stream);
      {$IFEND}

        frxQrCode3.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode3.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode3.LoadPictureFromStream(stream);
      {$IFEND}

        frxQrCode4.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode4.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode4.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If blnIssRet Then
        frxDanfe.PrintOptions.PageNumbers := '';

      If not blnPDF_Banco Then
      Begin
        For intContador := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

