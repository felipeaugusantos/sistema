                                          strPDF_Diretorio  : String  = '';
                                          blnReimpressao    : Boolean = False;
                                          blnPDF_Apresentar : Boolean = False);
Var
  intContador,
  intQtdVias: Integer;
  strNomImp: string;
  LMesComp, LAnoComp : string;
  LStreamDanfe: TStringStream;
begin
  Try

    cdsNFS.First;
    cdsItens.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDbItens := TfrxDBDataset.Create(nil);
    frxDbItens.UserName := 'frxITENS';
    frxDbItens.DataSet := cdsItens;

    frxDanfe := TfrxReport.Create(nil);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    frxDanfe.DataSets.Add(frxDbItens);

    If Assigned(frxDanfe.FindObject('msdItens')) Then
    Begin
      TfrxMasterData(frxDanfe.FindObject('msdItens')).DataSet := frxDbItens;
      TfrxMasterData(frxDanfe.FindObject('msdItens')).DataSetName := 'frxITENS';
    End;

    pConfigurarLogotipoDanfse;

    LAnoComp := Copy(cdsNFS.FieldByName('DTAEMI').asString,7,4);
    LMesComp := Copy(cdsNFS.FieldByName('DTAEMI').asString,4,2);

    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
