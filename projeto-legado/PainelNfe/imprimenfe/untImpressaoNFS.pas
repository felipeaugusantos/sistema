  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSJarinu(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao,
  blnPDF_Banco: Boolean);
Var
  i,
  intQtdVias: Integer;
  strNomImp,
  strCodigoBarrras: string;

  strLinkQrCode: string;
  frxQrCode: TfrxPictureView;
  bmpQrCode: TBitmap;
  intTentativas: integer;
  stream: TMemoryStream;
  LStreamDanfe: TStringStream;
begin
  Try
    cdsNFS.First;
    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);
    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    frxDanfe.DataSets.Add(frxDbDanfe);
    pConfigurarLogotipoDanfse;

    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
    frxDanfe.Script.Variables['DOCTOM'] := fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString);
    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(fStrZero(AnsiReplaceStr(cdsNFS.FieldByName('CODSER').AsString, '.', ''),4));
    frxDanfe.Script.Variables['ISSRET'] := '';
    Case cdsNFS.FieldByName('ISS_RET').AsInteger Of
      1: frxDanfe.Script.Variables['ISSRET'] := 'SIM';
      2: frxDanfe.Script.Variables['ISSRET'] := 'NÃO';
    End;

    if Assigned(frxDanfe.FindObject('imgQrCodeTop')) then
    begin
      strLinkQrCode := 'http://jarinu.govbr.cloud/NFSe.Portal/AutenticidadeNota';
      frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCodeTop'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strLinkQrCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    if Assigned(frxDanfe.FindObject('imgQrCodeBot')) then
    begin
      strLinkQrCode := cdsNFS.FieldByName('NUMNFS').AsString+
                       Copy(cdsNFS.FieldByName('DTAEMI').AsString,1,2)+
                       Copy(cdsNFS.FieldByName('DTAEMI').AsString,4,2)+
                       Copy(cdsNFS.FieldByName('DTAEMI').AsString,7,4)+
                       PadLeft(AnsiReplaceStr(cdsNFS.FieldByName('VLRSER').AsString,',',''),19,'0')+
                       PadLeft(AnsiReplaceStr(cdsNFS.FieldByName('VLRSER').AsString,',',''),19,'0')+
                       Copy(cdsNFS.FieldByName('CODSER').AsString,1,2)+
                       Copy(cdsNFS.FieldByName('CODSER').AsString,4,2)+
                       PadLeft(AnsiReplaceStr(cdsNFS.FieldByName('ALIISS').AsString,',',''), 7,'0')+
                       PadLeft(AnsiReplaceStr(cdsNFS.FieldByName('VLRISS').AsString,',',''),19,'0')+
                       PadLeft(cdsNFS.FieldByName('PSVCNPJ').AsString,14,'0')+
                       PadLeft(cdsNFS.FieldByName('TMSCNPJ').AsString,14,'0');
      frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCodeBot'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strLinkQrCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    if Assigned(frxDanfe.FindObject('cbbNFs')) then
    begin
      strCodigoBarrras := cdsNFS.FieldByName('NUMNFS').AsString+
                          cdsNFS.FieldByName('CODVER').AsString+
                          cdsNFS.FieldByName('PSVCNPJ').AsString;
      TfrxBarCodeView(frxDanfe.FindObject('cbbNFs')).Text := strCodigoBarrras;
    end;

    If not blnDesignReport Then
    Begin
      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For i := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;
    End
    Else
      frxDanfe.DesignReport;
  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSPederneiras(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao,
  blnPDF_Banco: Boolean);
Var
  i,
  intQtdVias: Integer;
  strNomImp,
  strLinkQrCode: string;
  frxQrCode: TfrxPictureView;
  bmpQrCode: TBitmap;
  intTentativas: integer;
  stream: TMemoryStream;
  LStreamDanfe: TStringStream;
begin
  Try
    cdsNFS.First;
    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);
    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    frxDanfe.DataSets.Add(frxDbDanfe);
    pConfigurarLogotipoDanfse;

    frxDanfe.Script.Variables['DTACPT'] := cdsNFS.FieldByName('COMPET').AsString;
    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
    frxDanfe.Script.Variables['DOCPRE'] := cdsNFS.FieldByName('PSVCNPJ').AsString;
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('PSVEND').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := cdsNFS.FieldByName('PSVMUN').AsString;
    frxDanfe.Script.Variables['EMAPRE'] := cdsNFS.FieldByName('PSVEMAIL').AsString;
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('PSVIM').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('PSVBAIR').AsString;
    frxDanfe.Script.Variables['UFPRES'] := cdsNFS.FieldByName('PSVUF').AsString;
    frxDanfe.Script.Variables['IEPRES'] := '';
    frxDanfe.Script.Variables['CEPPRE'] := cdsNFS.FieldByName('PSVCEP').AsString;
    frxDanfe.Script.Variables['FONPRE'] := cdsNFS.FieldByName('PSVFONE').AsString;

    frxDanfe.Script.Variables['TMSRAZAO'] := cdsNFS.FieldByName('TMSRAZAO').AsString;
    frxDanfe.Script.Variables['DOCDES'] := cdsNFS.FieldByName('TMSCNPJ').AsString;
    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('TMSEND').AsString;
    frxDanfe.Script.Variables['CIDDES'] := cdsNFS.FieldByName('TMSMUN').AsString;
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('TMSEMAIL').AsString;
    frxDanfe.Script.Variables['IMDEST'] := '';
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('TMSBAIR').AsString;
    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('TMSUF').AsString;
    frxDanfe.Script.Variables['IEDEST'] := '';
    frxDanfe.Script.Variables['CEPDES'] := cdsNFS.FieldByName('TMSCEP').AsString;
    frxDanfe.Script.Variables['FONPRE'] := '';
    frxDanfe.Script.Variables['DESCRI'] := cdsNFS.FieldByName('DISCRI').AsString;
    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(fStrZero(AnsiReplaceStr(cdsNFS.FieldByName('CODSER').AsString, '.', ''),4));
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);
    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['DEDUCA'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRDED').AsFloat);
    frxDanfe.Script.Variables['VALOUTRET'] := '0,00';
    frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat);
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRLIQ').AsFloat);
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('ALIISS').AsFloat);

    if Assigned(frxDanfe.FindObject('imgQrCode')) then
    begin
      strLinkQrCode := 'https://pederneiras.obaratec.com.br/ords/pmp/f?p=1816:71';
      frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strLinkQrCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    If not blnDesignReport Then
    Begin
      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For i := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;
    End
    Else
      frxDanfe.DesignReport;
  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

end.
