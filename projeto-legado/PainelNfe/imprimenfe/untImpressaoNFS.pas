    frxDanfe.Script.Variables['DESCNAE']     := fCampoTabela('CNA_NOMCNA', 'CADCNA', ['CNA_CODCNA'], [cdsNFS.FieldByName('CDCNAE').AsString]);
    frxDanfe.Script.Variables['OBSERVACOES'] := '';
    frxDanfe.Script.Variables['VALNTRIB']    := '0,00';
    frxDanfe.Script.Variables['VALDESCINC']  := FormatFloat('#,##0.00', cdsNFS.FieldByName('DESCONI').AsFloat);
    frxDanfe.Script.Variables['VALDESCCON']  := FormatFloat('#,##0.00', cdsNFS.FieldByName('DESCONC').AsFloat);
    frxDanfe.Script.Variables['VALOUTRET']   := FormatFloat('#,##0.00', cdsNFS.FieldByName('OUT_RET').AsFloat);
    frxDanfe.Script.Variables['VALRETFED']   := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALPIS').AsFloat+
                                                                         cdsNFS.FieldByName('VALCOF').AsFloat+
                                                                         cdsNFS.FieldByName('VALIRR').AsFloat+
                                                                         cdsNFS.FieldByName('VALCSL').AsFloat));
    frxDanfe.Script.Variables['VLRDED'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRDED').AsFloat);
    frxDanfe.Script.Variables['BSCISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BSCISS').AsFloat);

    frxDanfe.Script.Variables['VALISSRET'] := '0,00';
    frxDanfe.Script.Variables['TOTTRIB']   := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRSER').AsFloat * ( cdsNFS.FieldByName('ALIISS').AsFloat / 100 ) ) );

    If cdsNFS.FieldByName('EMIOSN').AsInteger = 1 Then
      frxDanfe.Script.Variables['OPCSN'] := 'SIM'
    Else If cdsNFS.FieldByName('EMIOSN').AsInteger = 2 Then
      frxDanfe.Script.Variables['OPCSN'] := 'NÃO';

    frxDanfe.Script.Variables['STSRPS'] := '';
    If (cdsNFS.FieldByName('STSRPS').AsString = '1') Then
      frxDanfe.Script.Variables['STSRPS'] := 'Normal';

    If cdsNFS.FieldByName('EXIGIB').AsInteger = 1 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'EXIGÍVEL'
    Else If cdsNFS.FieldByName('EXIGIB').AsInteger = 2 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'NÃO EXIGÍVEL';

    frxDanfe.Script.Variables['CODVER'] := cdsNFS.FieldByName('CODVER').AsString;

    frxDanfe.Script.Variables['MUNINC'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('MUNINC').AsString]);
    frxDanfe.Script.Variables['UF_INC'] := fCampoTabela('CID_ESTADO', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('MUNINC').AsString]);
    frxDanfe.Script.Variables['MUNPRE'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('MUNPRE').AsString]);
    frxDanfe.Script.Variables['UF_PRE'] := fCampoTabela('CID_ESTADO', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('MUNPRE').AsString]);

    If (Assigned(frxDanfe.FindObject('imgQrCode'))) and (Not fEmptyStr(strTextoQRCode)) Then
    Begin
      bmpQrCode := TBitmap.Create;
      stream := TMemoryStream.Create;

      Try
        frxQrCodeCorpo := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
        bmpQrCode      := fGerarQRCode(strTextoQRCode);

        bmpQrCode.SaveToStream(stream);
        frxQrCodeCorpo.Visible := Not fEmptyStr( strTextoQRCode );

      {$IF Defined(LINUX)}
        frxQrCodeCorpo.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCodeCorpo.LoadPictureFromStream(stream);
      {$IFEND}


      Finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      End;
    End;

    If (Assigned(frxDanfe.FindObject('BarCodeCodVer'))) and (Not fEmptyStr(cdsNFS.FieldByName('CODVER').AsString)) Then
    Begin
      TfrxBarCodeView(frxDanfe.FindObject('BarCodeCodVer')).Visible := True;
      TfrxBarCodeView(frxDanfe.FindObject('BarCodeCodVer')).Text    := cdsNFS.FieldByName('CODVER').AsString;
    End;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For intContador := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;
        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSBragancaPaulista(strCodigoEmpresa,
  strChaveAcesso, strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnPDF_Banco: Boolean);
Var
  intTentativas : integer;
  strTextoQRCode : string;
  bmpQrCode: TBitmap;
  stream: TMemoryStream;
  frxQrCodeCorpo,
  frxQrCodeCanhoto : TfrxPictureView;
  frxQrCodeCorpo2d,
  frxQrCodeCanhoto2d : TfrxBarcode2dView;
  LStreamDanfe: TStringStream;
begin
  Try

    cdsNFS.First;
    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    cdsNFS.First;

    frxDanfe := TfrxReport.Create(nil);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    pConfigurarLogotipoDanfse;

    frxDanfe.Script.Variables['DTAVENC'] := cdsNFS.FieldByName('DTVENISS').AsString;

    frxDanfe.Script.Variables['NUMNFS'] := cdsNFS.FieldByName('NUMNFS').AsString;
    frxDanfe.Script.Variables['SERNFS'] := cdsNFS.FieldByName('SERNFE').AsString;
    frxDanfe.Script.Variables['CODVER'] := cdsNFS.FieldByName('CODVER').AsString;
    frxDanfe.Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['NUMRPS'] := cdsNFS.FieldByName('NUMRPS').AsString;
    frxDanfe.Script.Variables['EMIRPS'] := cdsNFS.FieldByName('EMIRPS').AsString;

    //prestador
    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('PSVEND').AsString;
    frxDanfe.Script.Variables['NUMPRE'] := cdsNFS.FieldByName('PSVNUM').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('PSVBAI').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := cdsNFS.FieldByName('PSVCID').AsString;
    frxDanfe.Script.Variables['UF_PRE'] := cdsNFS.FieldByName('PSVUF').AsString;
    frxDanfe.Script.Variables['CEPPRE'] := fFormataCEP(cdsNFS.FieldByName('PSVCEP').AsString);
    frxDanfe.Script.Variables['FONPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('PSVFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['IEPRES'] := cdsNFS.FieldByName('PSVIE_').AsString;
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('PSVIM').AsString;


    //tomador
    frxDanfe.Script.Variables['DOCTOM'] := fFormataCpfCgc(cdsNFS.FieldByName('TOMCNPJ').AsString);
    frxDanfe.Script.Variables['NOMTOM'] := cdsNFS.FieldByName('TOMRAZAO').AsString;
    frxDanfe.Script.Variables['ENDTOM'] := cdsNFS.FieldByName('TOMEND').AsString;
    frxDanfe.Script.Variables['NUMTOM'] := cdsNFS.FieldByName('TOMNUM').AsString;
    frxDanfe.Script.Variables['TOMCOM'] := cdsNFS.FieldByName('TOMCOM').AsString;
    frxDanfe.Script.Variables['TOMBAI'] := cdsNFS.FieldByName('TOMBAI').AsString;
    frxDanfe.Script.Variables['TOMCID'] := cdsNFS.FieldByName('TOMCID').AsString;
    frxDanfe.Script.Variables['TOM_UF'] := cdsNFS.FieldByName('TOMUF').AsString;
    frxDanfe.Script.Variables['TOMCEP'] := fFormataCEP(cdsNFS.FieldByName('TOMCEP').AsString);
    frxDanfe.Script.Variables['TOMEMA'] := cdsNFS.FieldByName('TOMEMA').AsString;
    frxDanfe.Script.Variables['IESTOM'] := cdsNFS.FieldByName('TMSIE').AsString;
    frxDanfe.Script.Variables['IMUTOM'] := cdsNFS.FieldByName('TMSIM').AsString;

    frxDanfe.Script.Variables['DESCRI'] := AnsiReplaceStr(UpperCase(cdsNFS.FieldByName('DISSER').AsString), '|', sLineBreak);
    frxDanfe.Script.Variables['CODSER'] := cdsNFS.FieldByName('CODSER').AsString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);
    frxDanfe.Script.Variables['DISCRDED'] := cdsNFS.FieldByName('DISCRDED').AsString;

    //valores
    frxDanfe.Script.Variables['VLRSER'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['VLRDED'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRDED').AsFloat);
    frxDanfe.Script.Variables['BASCAL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('BASCAL').AsFloat);
    frxDanfe.Script.Variables['ALIQUOTA'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('ALISER').AsFloat);
    frxDanfe.Script.Variables['VLRISS'] := FormatFloat('#,##0.00', IIF(cdsNFS.FieldByName('VLRISS').AsFloat>0,cdsNFS.FieldByName('VLRISS').AsFloat,cdsNFS.FieldByName('VLISSR').AsFloat));
    frxDanfe.Script.Variables['VLRISSRET'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat);
    frxDanfe.Script.Variables['DESCINC'] := '0.00';

    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRSER').AsFloat - (cdsNFS.FieldByName('TRIVAL').AsFloat + cdsNFS.FieldByName('VLISSR').AsFloat)));
    frxDanfe.Script.Variables['TRISIG'] := cdsNFS.FieldByName('TRISIG').AsString;
    frxDanfe.Script.Variables['TRIALI'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('TRIALI').AsFloat);
    frxDanfe.Script.Variables['TRIVAL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('TRIVAL').AsFloat);
    frxDanfe.Script.Variables['TOTTRI'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('TRIVAL').AsFloat + cdsNFS.FieldByName('VLISSR').AsFloat));
    frxDanfe.Script.Variables['VALEXT'] := fRetExtensoNumero(FloatToStr((cdsNFS.FieldByName('VLRSER').AsFloat - cdsNFS.FieldByName('TRIVAL').AsFloat)));

    //local prestacao
    frxDanfe.Script.Variables['LOCEND'] := cdsNFS.FieldByName('LOCPRE').AsString;
    frxDanfe.Script.Variables['LOCNUN'] := cdsNFS.FieldByName('LOCNUM').AsString;
    frxDanfe.Script.Variables['LOCBAI'] := cdsNFS.FieldByName('LOCBAI').AsString;
    frxDanfe.Script.Variables['LOCMUN'] := cdsNFS.FieldByName('LOCMUN').AsString;
    frxDanfe.Script.Variables['LOC_UF'] := cdsNFS.FieldByName('LOC_UF').AsString;
    frxDanfe.Script.Variables['LOCCEP'] := fFormataCEP(cdsNFS.FieldByName('LOCCEP').AsString);

    If cdsNFS.FieldByName('VLISSR').AsFloat = 0 Then
      frxDanfe.Script.Variables['ISSRET'] := 'Não'
    Else If cdsNFS.FieldByName('VLISSR').AsFloat > 0 Then
      frxDanfe.Script.Variables['ISSRET'] := 'Sim';

    if Assigned(frxDanfe.FindObject('mmSerObs')) then
      frxDanfe.Script.Variables['SEROBS'] := cdsNFS.FieldByName('SEROBS').AsString;

    if Assigned(frxDanfe.FindObject('imgQrCodeCorpo')) and
       Assigned(frxDanfe.FindObject('imgQrCodeCanhoto')) then
    begin
      strTextoQRCode := 'Nota: ' + cdsNFS.FieldByName('NUMNFS').AsString + ' / ' + cdsNFS.FieldByName('SERNFE').AsString +', ' +
                        'Emissão: ' + Copy(cdsNFS.FieldByName('DTAEMI').AsString,1,10) + ', ' +
                        'Cod.Verif: ' + cdsNFS.FieldByName('CODVER').AsString+', Prestador: ' + fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString) + ' - ' +
                        cdsNFS.FieldByName('PSVRAZAO').AsString+', Tomador: ' + fFormataCpfCgc(cdsNFS.FieldByName('TOMCNPJ').AsString) + ' - ' +
                        cdsNFS.FieldByName('TOMRAZAO').AsString + ', Valor NFES: ' + FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat) + ', ' +
                        'Valor ISS: ' + FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat) + ', Obs:(), CheckCode:';

      frxQrCodeCorpo   := TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo'));
      frxQrCodeCanhoto := TfrxPictureView(frxDanfe.FindObject('imgQrCodeCanhoto'));
      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCodeCorpo.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCodeCorpo.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCodeCorpo.LoadPictureFromStream(stream);
      {$IFEND}

        frxQrCodeCanhoto.Visible := True;

      {$IF Defined(LINUX)}
        frxQrCodeCanhoto.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCodeCanhoto.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    if Assigned(frxDanfe.FindObject('QrCodeCorpo')) and
       Assigned(frxDanfe.FindObject('QrCodeCanhoto')) then
    begin
      strTextoQRCode := 'Nota: ' + cdsNFS.FieldByName('NUMNFS').AsString + ' / ' + cdsNFS.FieldByName('SERNFE').AsString +', ' +
                        'Emissão: ' + Copy(cdsNFS.FieldByName('DTAEMI').AsString,1,10) + ', ' +
                        'Cod.Verif: ' + cdsNFS.FieldByName('CODVER').AsString+', Prestador: ' + fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString) + ' - ' +
                        cdsNFS.FieldByName('PSVRAZAO').AsString+', Tomador: ' + fFormataCpfCgc(cdsNFS.FieldByName('TOMCNPJ').AsString) + ' - ' +
                        cdsNFS.FieldByName('TOMRAZAO').AsString + ', Valor NFES: ' + FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat) + ', ' +
                        'Valor ISS: ' + FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat) + ', Obs:(), CheckCode:';

      frxQrCodeCorpo2d   := TfrxBarcode2dView(frxDanfe.FindObject('QrCodeCorpo'));
      frxQrCodeCorpo2d.Expression := '';
      frxQrCodeCorpo2d.Text := strTextoQRCode;

      frxQrCodeCanhoto2d := TfrxBarcode2dView(frxDanfe.FindObject('QrCodeCanhoto'));
      frxQrCodeCanhoto2d.Expression := '';
      frxQrCodeCanhoto2d.Text := strTextoQRCode;

    end;

    FillChar(recInputImpressao, SizeOf(recInputImpressao), #0);
    recInputImpressao.blnDesignReport := blnDesignReport;
    recInputImpressao.blnPDF_Gerar := blnPDF_Gerar;
    recInputImpressao.blnPDF_Banco := blnPDF_Banco;
    recInputImpressao.blnPDF_Apresentar := blnPDF_Apresentar;
    recInputImpressao.strImpressora := strImpressora;
    recInputImpressao.strPDF_Diretorio := strPDF_Diretorio;
    recInputImpressao.strChaveAcesso := strChaveAcesso;
    pConfigurarSaidaImpressao(recInputImpressao);

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

