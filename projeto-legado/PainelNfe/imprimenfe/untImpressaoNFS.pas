constructor TImpressaoNFS.Create;
begin

  ConexaoBD := TConexaoBD.Create(frmModulo.Database);

  frxPDFExport := TfrxPDFExport.Create(nil);
  frxPDFExport.Background    := True;
  frxPDFExport.EmbeddedFonts := True;
  frxPDFExport.Subject       := 'Exportando DANFE para PDF';
  frxPDFExport.ShowProgress  := False;

  FillChar(recInputImpressao, SizeOf(recInputImpressao), #0);
end;

destructor TImpressaoNFS.Destroy;
begin
  ConexaoBD.Free();

  If Assigned(frxPDFExport) Then
    frxPDFExport.Free;

end;

function TImpressaoNFS.fCalculaCargaTributaria(fltValLiq: Double): Double;
var
  fltImpFederal,
  fltImpMunicipal: Double;
begin
  fltImpFederal := (fltValLiq * 13.45) / 100;
  fltImpMunicipal := (fltValLiq * 4) / 100;
  Result := fltImpFederal + fltImpMunicipal;
end;

function TImpressaoNFS.fCriaCdsFaturas: TUniClientDataSet;
begin
  Result := TUniClientDataSet.Create(nil);

  With Result.FieldDefs.AddFieldDef Do Begin Name := 'NUMNFS'; DataType := ftString; Size := 15; End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'FATNUM'; DataType := ftString; Size := 5;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'VALFAT'; DataType := ftFloat;              End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'DTAVEN'; DataType := ftString; Size := 10; End;

  Result.CreateDataSet;
  Result.LogChanges := False;
  Result.Open;
end;

function TImpressaoNFS.fCriaCdsItens: TUniClientDataSet;
begin

  Result := TUniClientDataSet.Create(nil);

  With Result.FieldDefs.AddFieldDef Do Begin Name := 'CODSER'; DataType := ftString; Size := 5;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'NUMNFS'; DataType := ftString; Size := 15;  End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'ITEDES'; DataType := ftString; Size := 500; End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'ITEQTD'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'VLRUNT'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'VLRTOT'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'UNIDAD'; DataType := ftString; Size := 2;   End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'VLRSRV'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'BASCAL'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'ALIISS'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'VLRISS'; DataType := ftFloat;               End;
  With Result.FieldDefs.AddFieldDef Do Begin Name := 'VLRDES'; DataType := ftFloat;               End;

  Result.CreateDataSet;
  Result.LogChanges := False;
  Result.Open;
end;

function TImpressaoNFS.fCriaCdsNFS(strCidadeNFSe: string): TUniClientDataSet;
begin
  Result := TUniClientDataSet.Create(nil);

  If ((strCidadeNFSe='PREFEITURA DE ARARAS') Or
      (strCidadeNFSe='PREFEITURA DE VALINHOS-SP') Or
      ((strCidadeNFSe='PREFEITURA DE SUMARÉ-SP'))) Then
  Begin
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'DOCPRE'; DataType := ftString; Size := 18;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'PESPRE'; DataType := ftString; Size := 1;   End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'IEPRES'; DataType := ftString; Size := 15;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'IMPRES'; DataType := ftString; Size := 10;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'NOMPRE'; DataType := ftString; Size := 80;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'ENDPRE'; DataType := ftString; Size := 80;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'NUENPR'; DataType := ftString; Size := 8;   End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'BAIPRE'; DataType := ftString; Size := 20;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'CEPPRE'; DataType := ftString; Size := 8;   End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'CIDPRE'; DataType := ftString; Size := 50;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'UFPRES'; DataType := ftString; Size := 2;   End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'EXTDES'; DataType := ftString; Size := 1;   End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'DOCDES'; DataType := ftString; Size := 18;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'PESDES'; DataType := ftString; Size := 1;   End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'IEDEST'; DataType := ftString; Size := 15;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'IMDEST'; DataType := ftString; Size := 10;  End;
    With Result.FieldDefs.AddFieldDef Do Begin Name := 'NOMDES'; DataType := ftString; Size := 80;  End;
