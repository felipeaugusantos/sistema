    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('TMSUF').AsString;
    frxDanfe.Script.Variables['SIMNAC'] := IfThen(cdsNFS.FieldByName('EMIOSN').AsString = '1', '1 - Sim', '2 - Não');
    frxDanfe.Script.Variables['RESRET'] := cdsNFS.FieldByName('RESRET').AsString;
    frxDanfe.Script.Variables['DTAHRA'] := cdsNFS.FieldByName('DTAHRA').asString;
    frxDanfe.Script.Variables['DESSER'] := fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);

    If cdsNFS.FieldByName('EMIICC').AsInteger = 1 Then
      frxDanfe.Script.Variables['INCCULT'] := '1 - Sim'
    Else If cdsNFS.FieldByName('EMIICC').AsInteger = 2 Then
      frxDanfe.Script.Variables['INCCULT'] := '2 - Não';

    If cdsNFS.FieldByName('EXIGIB').AsInteger = 1 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'Exigível'
    Else If cdsNFS.FieldByName('EXIGIB').AsInteger = 2 Then
      frxDanfe.Script.Variables['EXIGIB'] := 'Não Exigível';

    IF cdsNFS.FieldByName('TPORPS').AsString = '1' Then
      frxDanfe.Script.Variables['TPORPS'] := 'RPS'
    Else
      frxDanfe.Script.Variables['TPORPS'] := '';

    IF cdsNFS.FieldByName('CODRET').AsString = '0' Then
      frxDanfe.Script.Variables['CODRET'] := 'Não Possui'
    Else
      frxDanfe.Script.Variables['CODRET'] := '';

    If not fEmptyStr(cdsNFS.FieldByName('ISS_RET').AsString) Then
    begin
      If (cdsNFS.FieldByName('ISS_RET').AsString = '1') Then
        frxDanfe.Script.Variables['RETIDO'] := '1-Sim'
      Else If (cdsNFS.FieldByName('ISS_RET').AsString = '2') Then
        frxDanfe.Script.Variables['RETIDO'] := '2-Não';
    end;

    if Assigned(frxDanfe.FindObject('barCode')) then
    begin
      TfrxBarCodeView(frxDanfe.FindObject('barCode')).Text := cdsNFS.FieldByName('CHANFS').AsString;
    end;

    if Assigned(frxDanfe.FindObject('imgQrCode')) then
    begin
      strLinkQrCode := 'http://servicos.pmsaposse.sp.gov.br:8080/issweb/consultarautenticidade.jsf?hash=' + cdsNFS.FieldByName('CHANFS').AsString;
      frxQrCode := TfrxPictureView(frxDanfe.FindObject('imgQrCode'));
      intTentativas := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strLinkQrCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      try
        stream := TMemoryStream.Create;
        bmpQrCode.SaveToStream(stream);

        frxQrCode.Visible := True;
      {$IF Defined(LINUX)}
        frxQrCode.Picture.LoadFromStream(stream);
      {$ELSE}
        frxQrCode.LoadPictureFromStream(stream);
      {$IFEND}

      finally
        begin
          FreeAndNil(stream);
          FreeAndNil(bmpQrCode);
        end;
      end;
    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For intContador := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;

          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

