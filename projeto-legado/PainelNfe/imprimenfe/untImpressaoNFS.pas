      TfrxBarCodeView(frxDanfe.FindObject('barCode')).Text := cdsNFS.FieldByName('NUMNFS').AsString+
                                                              cdsNFS.FieldByName('CODVER').AsString+
                                                              cdsNFS.FieldByName('PSVCNPJ').AsString;
    end;

    If Assigned(frxDanfe.FindObject('imgQrCode')) Then
    begin
      strTextoQRCode := 'https://itabira.govbr.cloud/NFSe.Portal/AutenticidadeNota';

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Visible := True;
      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).LoadPictureFromStream(stream);
      {$IFEND}
      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    If Assigned(frxDanfe.FindObject('imgQrCodeCorpo')) Then
    begin
      strTextoQRCode := 'https://itabira.govbr.cloud/NFSe.Portal/AutenticidadeNota';

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).Visible := True;
      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCodeCorpo')).LoadPictureFromStream(stream);
      {$IFEND}
      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For i := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSItajai(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao, blnPDF_Banco: Boolean);
Var
  i,
  intTentativas,
  intQtdVias: Integer;
  strNomImp: string;
  stream : TMemoryStream;
  bmpQrCode : TBitmap;
  LStreamDanfe: TStringStream;
begin
  Try
    cdsNFS.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);
    frxDanfe.DataSets.Add(frxDbDanfe);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    with frxDanfe do
    begin
      //DADOS DA NOTA FISCAO DE SERVIÇO ELETRÔNICA E RPS
      Script.Variables['DTARPS'] := cdsNFS.FieldByName('DTARPS').AsString;
      Script.Variables['NUMRPS'] := fStrZero(cdsNFS.FieldByName('NUMRPS').AsString, 10);
      Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
      Script.Variables['SERIE']  := cdsNFS.FieldByName('SERIE_').AsString;
      Script.Variables['DTAHRA'] := cdsNFS.FieldByName('DTAHRA').AsString;
      Script.Variables['DTAEMI'] := cdsNFS.FieldByName('DTAEMI').AsString;
      Script.Variables['DTACMP'] := cdsNFS.FieldByName('DTACMP').AsString;
      Script.Variables['CODVER'] := cdsNFS.FieldByName('CODVER').AsString;

      Case cdsNFS.FieldByName('NATOPE').AsInteger Of
        101: Script.Variables['NATOPE'] := '101 - ISS devido para Itajaí';
        111: Script.Variables['NATOPE'] := '111 - ISS devido para outro município';
        121: Script.Variables['NATOPE'] := '121 - ISS Fixo (Soc. Profissionais)';
        201: Script.Variables['NATOPE'] := '201 - ISS retido pelo tomador/intermediário';
        301: Script.Variables['NATOPE'] := '301 - Operação imune, isenta ou não tributada';
        501: Script.Variables['NATOPE'] := '501 - ISS devido para Itajaí (Simples Nacional)';
        511: Script.Variables['NATOPE'] := '511 - ISS devido para outro município (Simples Nacional)';
        541: Script.Variables['NATOPE'] := '541 - MEI (Simples Nacional)';
        551: Script.Variables['NATOPE'] := '551 - Escritório Contábil (Simples Nacional)';
        601: Script.Variables['NATOPE'] := '601 - ISS retido pelo tomador/intermediário (Simples Nacional)';
        701: Script.Variables['NATOPE'] := '701 - Operação imune, isenta ou não tributada (Simples Nacional)';
      End;
      Script.Variables['OUTINF'] := AnsiReplaceStr(
                                    AnsiReplaceStr(
                                      cdsNFS.FieldByName('OUTINF').AsString, 'n-', sLineBreak + '-')
                                      , ' /n ', sLineBreak);

      Script.Variables['LOCPRESTSERV'] :=
        fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('ORGMUN').AsString])
        + ' / ' + fCampoTabela('CID_ESTADO', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('ORGMUN').AsString]) + ' - '
        +fCampoTabela('IBG_NOMPAI', 'IBG_CADPAI', ['IBG_CODPAI'], [cdsNFS.FieldByName('TMSCDPAIS').AsString]);

      //Serviço
      Script.Variables['VLRSER']  := cdsNFS.FieldByName('VLRSER').AsString;
      Script.Variables['VLRDED']  := cdsNFS.FieldByName('VLRDED').AsString;
      Script.Variables['VALPIS']  := cdsNFS.FieldByName('VALPIS').AsString;
      Script.Variables['VALCOF']  := cdsNFS.FieldByName('VALCOF').AsString;
      Script.Variables['VALINS']  := cdsNFS.FieldByName('VALINS').AsString;
      Script.Variables['VALIRR']  := cdsNFS.FieldByName('VALIRR').AsString;
      Script.Variables['VALCSL']  := cdsNFS.FieldByName('VALCSL').AsString;
      Script.Variables['VLRISS']  := cdsNFS.FieldByName('VLRISS').AsString;
      Script.Variables['BSCISS']  := cdsNFS.FieldByName('BSCISS').AsString;
      Script.Variables['ALIISS']  := cdsNFS.FieldByName('ALIISS').AsString;
      Script.Variables['VLRLIQ']  := cdsNFS.FieldByName('VLRLIQ').AsString;
      Script.Variables['DESCONI'] := cdsNFS.FieldByName('DESCONI').AsString;
      Script.Variables['OUT_RET'] := cdsNFS.FieldByName('OUT_RET').AsString;
      Script.Variables['DESCONC'] := cdsNFS.FieldByName('DESCONC').AsString;
      Script.Variables['VLISRT']  := cdsNFS.FieldByName('VLISRT').AsString;

      Script.Variables['CODSER']  := cdsNFS.FieldByName('CODSER').AsString + ' - ' +
        fRetDescClassificacaoServico(cdsNFS.FieldByName('CODSER').AsString);

      Script.Variables['ORGMUN']  := cdsNFS.FieldByName('ORGMUN').AsString;

      Script.Variables['DISCRI']  := AnsiReplaceStr(
                                    AnsiReplaceStr(
                                      cdsNFS.FieldByName('DISCRI').AsString,'n', sLineBreak),
                                      ' | ', sLineBreak);

      Script.Variables['INFCOM']   := cdsNFS.FieldByName('INFCOM').AsString;
      // Prestador
      Script.Variables['PSVCNPJ']  := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
      Script.Variables['PSVIM']    := cdsNFS.FieldByName('PSVIM').AsString;
      Script.Variables['PSVRAZAO'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
      Script.Variables['PSVNMFA']  := cdsNFS.FieldByName('PSVNMFA').AsString;

      Script.Variables['PSVEND']   := cdsNFS.FieldByName('PSVEND').AsString +
        IIF(fEmptyStr(cdsNFS.FieldByName('PSVNUM').AsString),' ', ', ' + cdsNFS.FieldByName('PSVNUM').AsString)
        + ' ' +
        IIF(fEmptyStr(cdsNFS.FieldByName('PSVCOMPL').AsString), ' ', ' - ' + cdsNFS.FieldByName('PSVCOMPL').AsString);

      Script.Variables['PSVNUM']   := cdsNFS.FieldByName('PSVNUM').AsString;
      Script.Variables['PSVBAIR']  := cdsNFS.FieldByName('PSVBAIR').AsString;
      Script.Variables['PSVMUN']   := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('PSVMUN').AsString]);
      Script.Variables['PSVUF']    := cdsNFS.FieldByName('PSVUF').AsString;
      Script.Variables['PSVCEP']   := fFormataCEP(cdsNFS.FieldByName('PSVCEP').AsString);
      Script.Variables['PSVCOMPL'] := cdsNFS.FieldByName('PSVCOMPL').AsString;
      Script.Variables['PSVEMAIL'] := cdsNFS.FieldByName('PSVEMAIL').AsString;

      Script.Variables['PSVFONE']  := fFormataFone(cdsNFS.FieldByName('PSVFONE').AsString);

      // Tomador
      Script.Variables['TMSCNPJ']  := fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString);
      Script.Variables['TMSRAZAO'] := cdsNFS.FieldByName('TMSRAZAO').AsString;
      Script.Variables['TMSNMFA']  := cdsNFS.FieldByName('TMSNMFA').AsString;

      Script.Variables['TMSEND']   := cdsNFS.FieldByName('TMSEND').AsString +
        IIF(fEmptyStr(cdsNFS.FieldByName('TMSNUM').AsString),' ', ', ' + cdsNFS.FieldByName('TMSNUM').AsString);

      Script.Variables['TMSNUM']   := cdsNFS.FieldByName('TMSNUM').AsString;
      Script.Variables['TMSBAIR']  := cdsNFS.FieldByName('TMSBAIR').AsString;
      Script.Variables['TMSMUN']   := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TMSMUN').AsString]);
      Script.Variables['TMSUF']    := cdsNFS.FieldByName('TMSUF').AsString;
      Script.Variables['TMSCEP']   := fFormataCEP(cdsNFS.FieldByName('TMSCEP').AsString);
      Script.Variables['TMSCDPAIS'] := cdsNFS.FieldByName('TMSCDPAIS').AsString;
      Script.Variables['TMSEMAIL']  := cdsNFS.FieldByName('TMSEMAIL').AsString;
      Script.Variables['TMSFONE']   := fFormataFone(cdsNFS.FieldByName('TMSFONE').AsString);
      Script.Variables['TMSIM']     := cdsNFS.FieldByName('TMSIM').AsString;
      end;

    If Assigned(frxDanfe.FindObject('imgQrCode')) Then
    begin
      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(
            Format('https://nfse.itajai.sc.gov.br/jsp/nfs/nfp/externo/resumo.jsp?cnpj_cpf=%s&numero=%s&chave_validacao=%s'
              ,[cdsNFS.FieldByName('PSVCNPJ').AsString,
                cdsNFS.FieldByName('NUMRPS').AsString,
                cdsNFS.FieldByName('CODVER').AsString]));
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Visible := True;

      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).LoadPictureFromStream(stream);
      {$IFEND}
      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    pConfigurarLogotipoDanfse;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For i := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

procedure TImpressaoNFS.pDanfeNFSItajuba(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao,
  blnPDF_Banco: Boolean);
Var
  i,
  intQtdVias: Integer;
  strNomImp: string;
  LMesComp, LAnoComp : string;
  strVerQrCode: string;
  LStreamDanfe: TStringStream;
begin
  Try

    cdsNFS.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDanfe := TfrxReport.Create(nil);

    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    strVerQrCode := iif(ConexaoBD.CarregarCFGSIS('NFSENO')='S', '4', '15');
    pConfigurarLogotipoDanfse;

    LAnoComp := Copy(cdsNFS.FieldByName('COMPET').asString,1,4);
    LMesComp := Copy(cdsNFS.FieldByName('COMPET').asString,6,2);

    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('PSVIM').AsString;
    frxDanfe.Script.Variables['IEPRES'] := cdsNFS.FieldByName('IEPRES').AsString;
    frxDanfe.Script.Variables['FONPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('PSVFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('PSVEND').AsString;
    frxDanfe.Script.Variables['NUENPR'] := cdsNFS.FieldByName('PSVNUM').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('PSVBAIR').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('PSVMUN').AsString]);
    frxDanfe.Script.Variables['UFPRES'] := cdsNFS.FieldByName('PSVUF').AsString;
    frxDanfe.Script.Variables['CEPPRE'] := fFormataCEP(cdsNFS.FieldByName('PSVCEP').AsString);
    frxDanfe.Script.Variables['EMAPRE'] := cdsNFS.FieldByName('PSVEMAIL').AsString;

    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('TMSEND').AsString;
    frxDanfe.Script.Variables['NUENDE'] := cdsNFS.FieldByName('TMSNUM').AsString;
    frxDanfe.Script.Variables['COMPDE'] := cdsNFS.FieldByName('TMSCOMPL').AsString;
    frxDanfe.Script.Variables['CEPDES'] := fFormataCEP(cdsNFS.FieldByName('TMSCEP').AsString);
    frxDanfe.Script.Variables['FONDES'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('TMSFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['DOCDES'] := fFormataCpfCgc(cdsNFS.FieldByName('TMSCNPJ').AsString);
    frxDanfe.Script.Variables['IMDEST'] := cdsNFS.FieldByName('TMSIM').AsString;
    frxDanfe.Script.Variables['IEDEST'] := '';
    frxDanfe.Script.Variables['BAIDES'] := cdsNFS.FieldByName('TMSBAIR').AsString;
    frxDanfe.Script.Variables['CIDDES'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('TMSMUN').AsString]);
    frxDanfe.Script.Variables['UFDEST'] := cdsNFS.FieldByName('TMSUF').AsString;
    frxDanfe.Script.Variables['EMADES'] := cdsNFS.FieldByName('TMSEMAIL').AsString;
    frxDanfe.Script.Variables['NUMNFS'] := fStrZero(cdsNFS.FieldByName('NUMNFS').AsString, 8);
    frxDanfe.Script.Variables['SERIE']  := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['NUMRPS'] := cdsNFS.FieldByName('NUMRPS').AsString;
    frxDanfe.Script.Variables['SERRPS'] := cdsNFS.FieldByName('SERRPS').AsString;
    frxDanfe.Script.Variables['VALLIQ'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['VLRLIQ'] := FormatFloat('#,##0.00', (cdsNFS.FieldByName('VLRLIQ').AsFloat));
    frxDanfe.Script.Variables['CARTRI'] := FormatFloat('#,##0.00', fCalculaCargaTributaria((cdsNFS.FieldByName('VLRSER').AsFloat)));
    frxDanfe.Script.Variables['ALQISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('ALIISS').AsFloat);

    if (cdsNFS.FieldByName('VLRISS').AsFloat = 0) then
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat)
    else
      frxDanfe.Script.Variables['VALISS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRISS').AsFloat);

    frxDanfe.Script.Variables['VALSER'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['DEDUCA'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['VALNFS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLRSER').AsFloat);
    frxDanfe.Script.Variables['BC_PIS'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQPIS'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALPIS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALPIS').AsFloat);
    frxDanfe.Script.Variables['BC_COF'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQCOF'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALCOF'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCOF').AsFloat);
    frxDanfe.Script.Variables['BCCSLL'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQCSL'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALCSL'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALCSL').AsFloat);
    frxDanfe.Script.Variables['BCIRRF'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQIRR'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALIRR'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALIRR').AsFloat);
    frxDanfe.Script.Variables['BCINSS'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['ALQINS'] := FormatFloat('#,##0.0000', 0);
    frxDanfe.Script.Variables['VALINS'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VALINS').AsFloat);
    frxDanfe.Script.Variables['TOTIMP'] := FormatFloat('#,##0.00', 0);
    frxDanfe.Script.Variables['DESCRI'] := AnsiReplaceStr(AnsiReplaceStr(UpperCase(cdsNFS.FieldByName('DISCRI').AsString), '#', sLineBreak), '|', sLineBreak);
