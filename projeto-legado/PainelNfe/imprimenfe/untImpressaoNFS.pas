procedure TImpressaoNFS.pDanfeNFSSaoRoque(strCodigoEmpresa, strChaveAcesso,
  strImpressora: String; blnDesignReport, blnPDF_Gerar: Boolean;
  strPDF_Diretorio: String; blnPDF_Apresentar, blnReimpressao, blnPDF_Banco: Boolean);
Var
  intContador,
  intQtdVias : Integer;
  strNomImp,
  strTextoQRCode : string;
  bmpQrCode: TBitmap;
  stream: TMemoryStream;
  frxQrCodeCorpo : TfrxPictureView;
  LStreamDanfe: TStringStream;
begin

  Try

    cdsNFS.First;
    cdsItens.First;

    frxDbDanfe := TfrxDBDataset.Create(nil);
    frxDbDanfe.UserName := 'frxNFS';
    frxDbDanfe.DataSet := cdsNFS;

    frxDbItens := TfrxDBDataset.Create(nil);
    frxDbItens.UserName := 'frxITENS';
    frxDbItens.DataSet := cdsItens;

    frxDanfe := TfrxReport.Create(nil);
    ConexaoBD.CarregarConfiguracao(strChaveAcesso, strCodigoEmpresa, 'NFS', 4.00);

    LStreamDanfe := fStringToStreamDanfe(ConexaoBD.FConfiguracao.LayoutRetrato);
    frxDanfe.LoadFromStream(LStreamDanfe);
    LStreamDanfe.Free;

    frxDanfe.DataSets.Add(frxDbItens);

    If Assigned(frxDanfe.FindObject('msdItens')) Then
    Begin
      TfrxMasterData(frxDanfe.FindObject('msdItens')).DataSet := frxDbItens;
      TfrxMasterData(frxDanfe.FindObject('msdItens')).DataSetName := 'frxITENS';
    End;

    strTextoQRCode := 'https://www.nfe-cidades.com.br/documentos.action?senha='+cdsNFS.FieldByName('CODVER').AsString;

    pConfigurarLogotipoDanfse;

    frxDanfe.Script.Variables['NOMPRE'] := cdsNFS.FieldByName('PSVRAZAO').AsString;
    frxDanfe.Script.Variables['DOCPRE'] := fFormataCpfCgc(cdsNFS.FieldByName('PSVCNPJ').AsString);
    frxDanfe.Script.Variables['IMPRES'] := cdsNFS.FieldByName('PSVIM').AsString;
    frxDanfe.Script.Variables['IEPRES'] := cdsNFS.FieldByName('IEPRES').AsString;
    frxDanfe.Script.Variables['FONPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('FONPRE').AsString, ' ', ''));
    frxDanfe.Script.Variables['ENDPRE'] := cdsNFS.FieldByName('PSVEND').AsString;
    frxDanfe.Script.Variables['NUENPR'] := cdsNFS.FieldByName('PSVNUM').AsString;
    frxDanfe.Script.Variables['BAIPRE'] := cdsNFS.FieldByName('PSVBAIR').AsString;
    frxDanfe.Script.Variables['CIDPRE'] := fCampoTabela('CID_NOMCID', 'CADCID', ['CID_COIBGE'], [cdsNFS.FieldByName('PSVMUN').AsString]);
    frxDanfe.Script.Variables['UFPRES'] := cdsNFS.FieldByName('PSVUF').AsString;
    frxDanfe.Script.Variables['CEPPRE'] := fFormataCEP(cdsNFS.FieldByName('PSVCEP').AsString);
    frxDanfe.Script.Variables['EMAPRE'] := cdsNFS.FieldByName('PSVEMAIL').AsString;
    frxDanfe.Script.Variables['TELPRE'] := fFormataFone(AnsiReplaceStr(cdsNFS.FieldByName('PSVFONE').AsString, ' ', ''));
    frxDanfe.Script.Variables['ENDDES'] := cdsNFS.FieldByName('TMSEND').AsString;
    frxDanfe.Script.Variables['NUENDE'] := cdsNFS.FieldByName('TMSNUM').AsString;
    frxDanfe.Script.Variables['COMPDE'] := cdsNFS.FieldByName('TMSCOMPL').AsString;
