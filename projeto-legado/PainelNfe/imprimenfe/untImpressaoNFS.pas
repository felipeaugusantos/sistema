    frxDanfe.Script.Variables['MES_COMPETENCIA'] := LMesComp+'/'+LAnoComp;
    frxDanfe.Script.Variables['DTACPT'] := cdsNFS.FieldByName('COMPET').asString;

    If (cdsNFS.FieldByName('ISS_RET').AsString = '2') Then
      frxDanfe.Script.Variables['RECOLHIMENTO'] := 'Sem Retenção';
    frxDanfe.Script.Variables['CNAE'] := cdsNFS.FieldByName('CDCNAE').AsString;
    frxDanfe.Script.Variables['OBSERVACOES'] := '';
    frxDanfe.Script.Variables['VALNTRIB'] := '0,00';
    frxDanfe.Script.Variables['VALDESCINC'] := '0,00';
    frxDanfe.Script.Variables['VALDESCCON'] := '0,00';
    frxDanfe.Script.Variables['VALOUTRET'] := '0,00';
    frxDanfe.Script.Variables['VALRETFED'] :=  FormatFloat('#,##0.00', (cdsNFS.FieldByName('VALPIS').AsFloat+
                                                                     cdsNFS.FieldByName('VALCOF').AsFloat+
                                                                        cdsNFS.FieldByName('VALIRR').AsFloat+
                                                                        cdsNFS.FieldByName('VALCSL').AsFloat));
    frxDanfe.Script.Variables['VALISSRET'] := FormatFloat('#,##0.00', cdsNFS.FieldByName('VLISSR').AsFloat);

    If cdsNFS.FieldByName('NATOPE').AsInteger = 1 Then
      frxDanfe.Script.Variables['NATOPE'] := '1 - Tributação no município'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 2 Then
      frxDanfe.Script.Variables['NATOPE'] := '2 - Tributação fora do município'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 3 Then
      frxDanfe.Script.Variables['NATOPE'] := '3 - Isenção'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 4 Then
      frxDanfe.Script.Variables['NATOPE'] := '4 - Imune'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 5 Then
      frxDanfe.Script.Variables['NATOPE'] := '5 - Exigibilidade suspensa'
    Else If cdsNFS.FieldByName('NATOPE').AsInteger = 6 Then
      frxDanfe.Script.Variables['NATOPE'] := '6 - Exigibilidade suspensa';

    If cdsNFS.FieldByName('CODRET').AsInteger = 0 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '0 - Nenhum'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 1 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '1 - Microempresa municipal'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 2 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '2 - Estimativa'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 3 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '3 - Sociedade de profissionais'
    Else If cdsNFS.FieldByName('CODRET').AsInteger = 4 Then
      frxDanfe.Script.Variables['REGESPTRIB'] := '4 - Cooperativa'
    Else
      frxDanfe.Script.Variables['REGESPTRIB'] := '1 - Microempresa municipal';

    If cdsNFS.FieldByName('EMIOSN').AsInteger = 1 Then
      frxDanfe.Script.Variables['OPCSN'] := 'Sim'
    Else If cdsNFS.FieldByName('EMIOSN').AsInteger = 2 Then
      frxDanfe.Script.Variables['OPCSN'] := 'Não';

    If cdsNFS.FieldByName('EMIICC').AsInteger = 1 Then
      frxDanfe.Script.Variables['INCCULT'] := 'Sim'
    Else If cdsNFS.FieldByName('EMIICC').AsInteger = 2 Then
      frxDanfe.Script.Variables['INCCULT'] := 'Não';

    If cdsNFS.FieldByName('EXIISS').AsInteger = 1 Then
      frxDanfe.Script.Variables['EXIISS'] := 'Exigível em Palmas'
    Else If cdsNFS.FieldByName('EXIISS').AsInteger = 2 Then
      frxDanfe.Script.Variables['EXIISS'] := 'Não'
    Else
      frxDanfe.Script.Variables['EXIISS'] := '';

    if Assigned(frxDanfe.FindObject('barCode')) then
    begin
      TfrxBarCodeView(frxDanfe.FindObject('barCode')).Text := cdsNFS.FieldByName('CODVER').AsString;
    end;

    if Assigned(frxDanfe.FindObject('QRCode')) then
    begin
      TfrxBarcode2DView(frxDanfe.FindObject('QRCode')).Text := 'http://visualizar.ginfes.com.br/report/consultarNota?__report=nfs_ver'+strVerQrCode+'&cdVerificacao='+
                                                               cdsNFS.FieldByName('CODVER').AsString+
                                                               '&numNota='+
                                                               cdsNFS.FieldByName('NUMNFS').AsString+
                                                               '&cnpjPrestador=null';
    end;

    If Assigned(frxDanfe.FindObject('imgQrCode')) Then
    begin
      strTextoQRCode := 'https://palmasto.webiss.com.br/externo/nfse/visualizar/'+cdsNFS.FieldByName('PSVCNPJ').AsString+
                        '/'+cdsNFS.FieldByName('CODVER').AsString+'/'+cdsNFS.FieldByName('NUMNFS').AsString;

      intTentativas    := 0;

      While True Do
      Begin
        bmpQrCode := TBitmap.Create;
        Try
          bmpQrCode := fGerarQRCode(strTextoQRCode);
          Sleep(100);
          Break;
        Except
          On E: Exception Do
          Begin
            Inc(intTentativas);
            If intTentativas > 30 Then
            Begin
              Raise;
            End;
            Sleep(500);
            Application.ProcessMessages;
          End;
        End;
      End;

      stream := TMemoryStream.Create;
      try
        bmpQrCode.SaveToStream(stream);

        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Visible := True;
      {$IF Defined(LINUX)}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).Picture.LoadFromStream(stream);
      {$ELSE}
        TfrxPictureView(frxDanfe.FindObject('imgQrCode')).LoadPictureFromStream(stream);
      {$IFEND}

      finally
        FreeAndNil(stream);
        FreeAndNil(bmpQrCode);
      end;
    end;

    If not blnDesignReport Then
    Begin

      strNomImp  := strImpressora;
      intQtdVias := StrToIntDef(ConexaoBD.CarregarCFGSIS('QTDNFS'),1);

      If (intQtdVias < 0) Or (blnPDF_Gerar) Or (blnReimpressao) Then
        intQtdVias := 1;

      If not blnPDF_Banco Then
      Begin
        For i := 1 To intQtdVias Do
        Begin

          {PDF}
          If (blnPDF_Gerar) Then
          Begin

            frxDanfe.EngineOptions.NewSilentMode := simReThrow;
            frxPDFExport.FileName   := strPDF_Diretorio;
            frxPDFExport.ShowDialog := False;

            frxDanfe.PrintOptions.ShowDialog := False;
            frxDanfe.PrepareReport();

          {$IF Defined(LINUX)}
            frxPDFExport.EmbeddedFonts := True;
          {$IFEND}

            frxDanfe.Export(frxPDFExport);

            If (blnPDF_Apresentar) Then
            Begin
              if FileExists(frxPDFExport.FileName) then
              begin
               {$IF not defined(LINUX)}
                ShellExecute(0, nil, PChar(frxPDFExport.FileName), nil, nil, SW_SHOWNORMAL);
               {$IFEND}
              end
              else
              begin
                frxPDFExport.ShowDialog := True;
                pPreviewReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, frxDanfe);
              end;
            End;
          End
          Else
          Begin

            frxDanfe.PrintOptions.Printer    := AnsiReplaceStr(strNomImp, '\\' + fRetNomeRede + '\', '');
            frxDanfe.PrintOptions.ShowDialog := False;

            If (frxDanfe.PrepareReport) Then
              pPrintReport('NFeImpressao', 'NFS-e '+ strChaveAcesso, strNomImp, frxDanfe);

            If (intQtdVias > 1) Then
              Sleep(1000);

          End;

        End;
      End;

      If Assigned(ConexaoBD) Then
      Begin
        ConexaoBD.pSalvarDFePDF(frxDanfe, strChaveAcesso);
      End;

    End
    Else
      frxDanfe.DesignReport;

  Finally
    FreeAndNil(frxDanfe);
    FreeAndNil(frxDbDanfe);
  End;
end;

