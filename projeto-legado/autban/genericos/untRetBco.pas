function TfrmRetBco.fGeraRetornoBancoNordeste(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    intQtdDup: Integer;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG004-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************KP*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '004') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Nordeste ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************JU*}
          If Eof(txtTexto) Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************LB*}
          strNomArq := lstArquivo.Items.Strings[intContador];
          strNumCtr := Copy(strLinha, 38, 25);

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            Else
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03), 3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08), 8);
          End;

          strDtaOco := Copy(strLinha,111,06);

          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;
          strDtaPag := strDtaOco;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strDesCon := Copy(strLinha,241,13);
          strValDup := Copy(strLinha,153,13);
          strValPag := Copy(strLinha,254,13);
          strJurMor := Copy(strLinha,267,13);
          strCodBco := '004';
          strCodOco := Copy(strLinha,109,02);
          strNosNum := Copy(strLinha,063,08);
          strCodRej := '';
          strMotOco := '';

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);
              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;
        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('Banco do Nordeste');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);
      End;
    End;// fim do For
  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

function TfrmRetBco.fGeraRetornoBanestesPagar(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste   : Boolean;
    strLinha    : String;
    strParcel   : String;
    strDtaOco   : String;
    strDtaVen   : String;
    strDtaPag   : String;
    strNumDup   : String;
    strCodFor   : String;
    strCodEmp   : String;
    strNomArq   : String;
    strCodBco   : String;
    strDesCon   : String;
    strCodOco   : String;
    strValDup   : String;
    strValPag   : String;
    strJurMor   : String;
    strNosNum   : String;
    strMotOco   : String;
    strAutInc   : String;
    strBcoFav   : String;
    strSeqBai   : String;
    strSerie_   : String;
    dtaDtaArq   : TDateTime;
    strVenCtp   : String;
    intLinha    : Integer;
    intLinhas   : Integer;
begin

  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetCtp.qryRetCtp);

  blnExiste := False;

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        strNomArq := lstArquivo.Items.Strings[intContador];
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + strNomArq, dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + strNomArq);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinha  := 0;
        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + strNomArq);

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          {*****************************************}
          {* VERIFICA SE NAO FOR DETALHE ELE PULA  *}
          {**************************************AC*}
          If (Copy(strLinha,01,01) <> '1') Then
            Continue;

          strCodBco := '021';
          strAutInc := Trim(Copy(strLinha,34,20));
          strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
          strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
          strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
          strParcel := '';  //Passar na funcao como variavel para poder grava-lo
          strSerie_ := '';  //Passar na funcao como variavel para poder grava-lo
          strSeqBai := '';  //Passar na funcao como variavel para poder grava-lo
          strBcoFav := '';
          strNosNum := '';

          strDtaOco := Copy(strLinha,371,08);

          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;

          strDtaPag := strDtaOco;

          strDtaVen := Copy(strLinha,097,08);

          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strDesCon := '';
          strValDup := '';
          strValPag := Copy(strLinha,105,13);
          strJurMor := Copy(strLinha,358,13);

          // 01 - INCLUSÃO
          // 11 - INCLUSÃO REJEITADA
          strCodOco := Copy(strLinha,085,2);

          If (Pos('RT3',UpperCase(strNomArq)) > 0) Then
          Begin
            If Copy(strLinha,231,2)='01' Then
            Begin
              strCodOco := '11';
              strMotOco := 'Transação recusada!';
            End
            Else
            Begin
              strCodOco := '00';
              strMotOco := '';
            End;
          End;

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplicContasPagar(strAutInc, strCodFor, strNumDup, strParcel, strCodEmp, strSeqBai, strSerie_, strVenCtp) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBcoContasPagar;

            pGravaArqBcoContasPagar(strParcel, strNumDup, strCodFor, strCodEmp, strSeqBai, strSerie_,
                                    strCodBco, strBcoFav, strNosNum, strCodOco, strMotOco, strValDup,
                                    strDesCon, strJurMor, strValPag, strDtaVen, strDtaPag, strNomArq,
                                    strAutInc, dtaDtaArq);

            pGravaLogCtp(strCodBco, strAutInc);

            blnExiste := True;

          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodFor, strNumDup, '', strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BANESTES');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;

        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno Contas a Pagar]');
    End;
  End;

  frmRetBco.Close;

end;

//RetornoBanrisulPagar; //240p
function TfrmRetBco.fGeraRetornoBanrisulPagar(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste   : Boolean;
    strLinha    : String;
    strParcel   : String;
    strDtaOco   : String;
    strDtaVen   : String;
    strDtaPag   : String;
    strNumDup   : String;
    strCodFor   : String;
    strCodEmp   : String;
    strNomArq   : String;
    strCodBco   : String;
    strDesCon   : String;
    strCodOco   : String;
    strValDup   : String;
    strValPag   : String;
    strJurMor   : String;
    strNosNum   : String;
    strMotOco   : String;
    strAutInc   : String;
    strBcoFav   : String;
    strSeqBai   : String;
    strSerie_   : String;
    dtaDtaArq   : TDateTime;
    strVenCtp   : String;
    strVersao   : String;
    strOutEnt   : String;
    intLinhas   : Integer;
    strDocumentoBanco : String;
begin

  pnlInfo.Caption := 'Importando Arquivo de Retorno...';
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetCtp.qryRetCtp);

  blnExiste := False;

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin

        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        strNomArq := lstArquivo.Items.Strings[intContador];
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + strNomArq, dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + strNomArq);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinha  := 0;
        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + strNomArq);


        While Not Eof(txtTexto) Do
        Begin

          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          {*****************************************}
          {* VERIFICA SE NAO FOR DETALHE ELE PULA  *}
          {**************************************AC*}
          If (Not (Copy(strLinha,08,01) = '3')) and (Copy(strLinha, 09, 01) <> 'C') Then
            Continue;

          {*****************************************}
          {* VERIFICA SE FOR REGISTRO 'Z' ELE PULA *}
          {**************************************JS*}
          if (Copy(strLinha, 14, 01) = 'Z') then
            Continue;

          {************************************************************************************}
          {* VERIFICA SE FOR REGISTRO 'C' NO HEADER PARA IDENTIFICAR QUAL O TIPO DO REIGISTRO *}
          {************************************************************************************}
          if (Copy(strLinha, 09, 01) = 'C') then
          begin
            // 045 - Pagamento Através de Crédito em Conta, Cheque, OP, DOC, TED ou Pagamento com Autenticação
            // 040 - Pagamento de Títulos de Cobrança
            // 012 - Pagamento de Tributos
            // 022 - Bloqueto Eletrônico – (Captura de Títulos em Cobrança)
            // 010 - Alegação do Sacado

            strVersao := Copy(strLinha,014,03);
            Continue;
          end;

          //Limpa a versão apenas se estiver no trailer do lote
          if (Copy(strLinha,08,01) = '5') Then
             strVersao := '';

          {******************************************************************************************}
          {* SE TRAILER DE LOTE OU SE FOR DETALHE E O SEGMENTO FOR 'B' OU 'Z' ***********************}
          {* LIMPA AS VARIÁVEIS E PULA DE LINHA PARA NÃO CORRER O RISCO DE BUSCAR A MESMA DUPLICATA *}
          {******************************************************************************************}
          If (Not (Copy(strLinha,08,01) = '3')) Or
             ((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'J') And (Copy(strLinha,15,05) = ' 0052')) Or
             ((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'J') And (Copy(strLinha,15,05) = ' 0152')) Or
             ((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'B')) Or
             (Copy(strLinha,14,01) = 'Z') Then
          begin
            strAutInc := '';
            Continue;
          end;

          strOutEnt := '';
          strDtaVen := '';

          // Segmento O – Pagamento de Contas e Tributos com Código de Barras
          if (Copy(strLinha, 14, 01) = 'O') then
          begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,123,20);
            strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
            strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
            strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
            strBcoFav := '';
            strNosNum := Copy(strLinha, 143,20);  // Nosso numero atribuido pelo banco

            strDtaOco := Copy(strLinha, 100,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,092,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := '';
            strValDup := Copy(strLinha,108,15);
            strValPag := Copy(strLinha,108,15);
            strJurMor := '';
            strCodBco := '041';
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          end
          else

          // Segmento N – Pagamento de Tributos e Impostos sem Código de Barras
          if (Copy(strLinha, 14, 01) = 'N') then
          begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,018,20).Trim;

            strNumDup := '';
            strCodEmp := '';
            strCodFor := '';
            strSerie_ := '';

            If (Length(strAutInc) >= 8) And (Length(strAutInc) < 20) Then
            Begin
              strDocumentoBanco := Copy(strLinha,038,20).Trim;

              strSerie_ := StringReplace(RightStr(strDocumentoBanco, 3), '_', EmptyStr, [rfReplaceAll]);
              strCodEmp := Copy(strDocumentoBanco, Length(strDocumentoBanco) - 5, 3);
              strParcel := Copy(strDocumentoBanco, Length(strDocumentoBanco) - 6, 1);
              strNumDup := LeftStr(strDocumentoBanco, Length(strDocumentoBanco) - 7);
              strCodFor := fCampoTabela('CTP_CODFOR', 'CADPAG',
                                        ['CTP_NUMDUP', 'CTP_PARCEL', 'CTP_CODEMP', 'CTP_SERIE_'],
                                        [strNumDup, strParcel, strCodEmp, strSerie_]);
            End;
            strBcoFav := '';

            strDtaOco := Copy(strLinha, 088,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            //strDtaVen := Copy(strLinha,092,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := '';
            strValDup := '';
            If Copy(strLinha, 133, 02) = '17' Then //GPS
            Begin
              strValDup := Copy(strLinha, 141, 15);
              strOutEnt := Copy(strLinha, 156, 15);
            End
            Else If Copy(strLinha, 133, 02) = '16' Then //DARF NORMAL
              strValDup := Copy(strLinha, 160, 15)
            Else If Copy(strLinha, 133, 02) = '18' Then //DARF SIMPLES
              strValDup := Copy(strLinha, 165, 15)
            Else If Pos(Copy(strLinha, 133, 02), '22_23_24_') > 0 Then //GARES
              strValDup := Copy(strLinha, 187, 15);

            strValPag := Copy(strLinha,096,15);
            strJurMor := '';
            strCodBco := '041';
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          end
          else

          // 045 - Pagamento Através de Crédito em Conta, Cheque, OP, DOC, TED ou Pagamento com Autenticação
          if (strVersao = '105') And (Copy(strLinha, 14, 01) = 'A') then
          begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,074,20); // numero do documento atribuido pela empresa;
            strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
            strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
            strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
            strBcoFav := Copy(strLinha,021,03);  // Codigo do banco favorecido;
            strNosNum := '';

            strDtaOco := Copy(strLinha,155,08);  // Data da efetivaçãodo crédito

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            //strDtaVen := Copy(strLinha,092,08);

            //If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            //Begin
            //  System.Insert('/',strDtaVen,3);
            //  System.Insert('/',strDtaVen,6);
            //End;

            strDesCon := '';
            strValDup := Copy(strLinha,120,15);
            strValPag := Copy(strLinha,163,15);
            strJurMor := '';
            strCodBco := '041';
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          end
          else
          Begin
            strAutInc := Copy(strLinha,183,20);
            strNumDup := '';
            strCodEmp := '';
            strCodFor := '';
            strBcoFav := Copy(strLinha,018,03);
            strNosNum := Copy(strLinha,216,15);

            strDtaOco := Copy(strLinha,145,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,092,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strCodBco := '041';
            strDesCon := Copy(strLinha,115,15);
            strValDup := Copy(strLinha,100,15);
            strValPag := Copy(strLinha,153,15);
            strJurMor := Copy(strLinha,130,15);
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          End;

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplicContasPagar(strAutInc, strCodFor, strNumDup, strParcel, strCodEmp, strSeqBai, strSerie_, strVenCtp) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBcoContasPagar;

            if (fEmptyStr(strDtaVen)) Or (strDtaVen='01/01/0001') Then
              strDtaVen := strVenCtp;

            pGravaArqBcoContasPagar(strParcel, strNumDup, strCodFor, strCodEmp, strSeqBai, strSerie_,
                                    strCodBco, strBcoFav, strNosNum, strCodOco, strMotOco, strValDup,
                                    strDesCon, strJurMor, strValPag, strDtaVen, strDtaPag, strNomArq,
                                    strAutInc, dtaDtaArq, strOutEnt);

            pGravaLogCtp(strCodBco, strAutInc);

            blnExiste := True;

          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodFor, strNumDup, '', strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BANRISUL');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;

        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          pnlInfo.Caption := '';
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno Contas a Pagar]');
    End;
  End;

  pnlInfo.Caption := '';
  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBcoSBCredito_988(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strValLan: String;
    strTarifa: String;
    fltTarifa: Double;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strOutVal: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strDtaCre: String;
    dtaDtaArq: TDateTime;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;
    intQtdDup: Integer;
    strComPer: String;
    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strCodAge,
    strCodCco,
    strNumCar,
    strCodCar: String;

    strTipLay: String;
    stlNaoBai: TStringList;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;

    intContGeral: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;
    strCusCar: String;
    strCodLiq: String;
    intIndex : Integer;
    strIofDes: String;
    strTxaDes: String;
    blnDescon: Boolean;
    strJurOpe: String;

    blnUsaTarifa: Boolean;

    function fCorrigeDataDeCreditoPorCodigoDeLiquidacao(const strCodLiq: String;
    const dteDtaCre: TDate): TDate;
      const
        CodigosPgtoDisponivel = 'AA_AO_BC_BF_BL_CI_CK_CP_DG_EA_Q0_RA_ST_';
        CodigosPgtoACompensar = 'AC_B0_B1_B2_B3_B4_B5_B6_B7_CC_LC_';
    Begin
      Result := dteDtaCre;

      If Pos(strCodLiq, CodigosPgtoDisponivel) > 0 Then
        Exit;

      If Pos(strCodLiq, CodigosPgtoACompensar) > 0 Then
      Begin
        Result := fAcertaDataParaDiaUtil(IncDay(dteDtaCre));;
        Exit;
      End;

    End;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnUsaTarifa := fCfgSis('ENCBAN', varBoolean);
  blnExiste := False;

  strCartei := 'CONFIG988-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strCodAge := fGetBancoConfig(0, 'CONFIG988-' + IntToStr(intCartei), 'CODAGEN', '');
  strCodCco := fGetBancoConfig(0, 'CONFIG988-' + IntToStr(intCartei), 'NUMCTAC', '');
  strNumCar := fGetBancoConfig(0, 'CONFIG988-' + IntToStr(intCartei), 'NUMCART', '');
  strCodCar := fGetBancoConfig(0, 'CONFIG988-' + IntToStr(intCartei), 'CODCART', '');

  stlNaoBai := TStringList.Create;
  stlNaoBai.Add('Duplicatas com Juros e Descontos inconsistentes ou com Comissão de Permanência debitadas devem ser avaliadas e feita a baixa manual.');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '341') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Itaú ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        {***********************************}
        {* LÊ O HEADER PARA SABER O LAYOUT *}
        {********************************AJ*}
        If LeftStr(strLinha, 1) = '0' Then
          strTipLay := Trim(Copy(strLinha,012,15));

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          blnAtualizaRet := fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                                          '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1;

          If Not blnAtualizaRet Then
          begin
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          {*****************************************************}
          {* IDENTIFICACAO DE DUPLICATA, CASO NAO FOR ELE PULA *}
          {**************************************************JC*}
          If LeftStr(strLinha, 1) <> '1' Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************LB*}
          strNomArq := lstArquivo.Items.Strings[intContador];
          strNumCtr := Copy(strLinha,038,25);

          //If Pos('341', String(Copy(strCartei, 01, 11))) > 0 Then
          //Begin
            intCartei := Copy(strCartei, 11, 01).ToInteger;

            If ((strNumCar <> Copy(strLinha,083,03)) Or
                (strCodCar <> Copy(strLinha,108,01)) Or
                (fStrZero(RightStr(strCodCco, 05), 05) <> Copy(strLinha,024,05)) Or
                (fStrZero(RightStr(strCodAge, 04), 04) <> Copy(strLinha,018,04))) Then
              intCartei := fRetornaCarteiraDuplicataRetBco('341',
                                                           VS_strCodEmp,
                                                           Copy(strCartei, 11, 01),
                                                           ['NUMCART', 'CODCART', 'NUMCTAC', 'CODAGEN'],
                                                           [Copy(strLinha,083,03), Copy(strLinha,108,01),
                                                            Copy(strLinha,024,05), Copy(strLinha,018,04)]).ToInteger;
          //End;

          strNumDupVel := '';
          strParcelVel := '';
          strEspDocVel := '';
          strCodEmpVel := '';
          strCodCliVel := '';

          strCodLiq    := '';

          If Length( Trim( strNumCtr ) ) = 11 Then  //SHX
          Begin

            strNumDup := Copy(strNumCtr,004,08);
            strParcel := '';
            strEspDoc := '';
            strCodEmp := fStrZero(Copy(strNumCtr,001,03),3);
            strCodCli := '';

          End
          Else
          Begin
            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              Try
                {*****************************************}
                {* ESSE NÃO PODE SER fStrToFloat         *}
                {**************************************AF*}
                fStrToFloat(fStrZero(Copy(strNumCtr,013,08),8));

                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              Except
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strCodCli := fStrZero(Copy(strNumCtr,008,08),8);
                strCodEmp := fStrZero(Copy(strNumCtr,016,03),3);
                strEspDoc := Copy(strNumCtr,019,02);
              End;
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel, strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) And (Not fEmptyStr(strNumCtr)) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

          End;

          strDtaOco := Copy(strLinha,111,06);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;
          strDtaPag := strDtaOco;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

          strCodLiq := Copy(strLinha,393,02);
          strDtaCre := Copy(strLinha,296,06);
          If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
          Begin
            System.Insert('/',strDtaCre,3);
            System.Insert('/',strDtaCre,6);

            If (Not fEmptyStr(strCodLiq)) And
               (fGetBancoConfig(0, 'CONFIG341-' + IntToStr(intCartei), 'CODLIQU', 'N') = 'S') Then
              strDtaCre := FormatDateTime('dd/mm/yy', fCorrigeDataDeCreditoPorCodigoDeLiquidacao(strCodLiq, StrToDate(strDtaCre)));
          End;

          strComPer := IIF(strTipLay = 'EMPRESTIMO', Copy(strLinha,280,13), '0000000000000');
          strDesCon := Copy(strLinha,241,13);
          strValDup := Copy(strLinha,153,13);
          strJurMor := Copy(strLinha,267,13);
          strOutVal := Copy(strLinha,202,13);

          //Req 159748
          If (strTipLay = 'EMPRESTIMO') And (Not strOutVal.Trim.IsEmpty) And (strOutVal <> '0000000000000') And
             (Not blnUsaTarifa) Then
            strJurMor := strOutVal;

          strCodBco := '988';
          strCodOco := Copy(strLinha,109,02);
          {*****************************************}
          {* PASSOU A PEGAR O NOSSO NUMERO COM O   *}
          {* DIGITO.                               *}
          {*************************21/07/2009***MV*}
          strNosNum := Copy(strLinha,086,09);
          strCodRej := '';
          strMotOco := '';
          strCodOco := IIF((strTipLay = 'EMPRESTIMO') Or (strCodOco <> '02') Or (Trim(Copy(strLinha,378,02)) <> '03'),  strCodOco, '99');

          strValPag := '';
          strValLan := '';
          strTarifa := '';
          fltTarifa := 0;
          strCusCar := '';
          strIofDes := '';
          strTxaDes := '';

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          If (Not fEmptyStr(strDtaPag))                    And
             (strDtaPag <> '000000')                       And
             (strDtaPag <> '00000000')                     And
             ((strCodOco <> '02') And (strCodOco <> '32')  And
              (strCodOco <> '09'))                         Then
          Begin
            {*****************************************}
            {* SOLICITADO SOMAR TAXA BANCARIA COM O  *}
            {* VALOR PAGO CONFORME ALTERA...         *}
            {*************************24/11/2009***IV*}
            strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) +
                                               IIF(strTipLay = 'EMPRESTIMO', 0,
                                               fStrToFloat(Copy(strLinha,176,13))) +
                                               IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)  ), 13 );
          End
          Else
            strValPag := Copy(strLinha, 254, 13);

          if blnUsaTarifa then
            fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG988-' + IntToStr(intCartei), 'VALOTAR', '0'));

          if ((Pos(strCodOco,  '06_08_') > 0) and (fltTarifa > 0) and (blnUsaTarifa))  then
          begin
            strTarifa := Copy(strLinha,176,13);
            if Trim(strTipLay) = 'EMPRESTIMO' then
            begin
              strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) -
                                                 fStrToFloat(strTarifa) +
                                                 IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)  ), 13 );
            end
            else
            begin
              strValPag := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13))+
                                                 IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)  ), 13 );
            end;

            strValLan := fStrZero( FloatToStr( fStrToFloat(Copy(strLinha,254,13)) +
                                               IIF(Not fEmptyStr(strOutVal), fStrToFloat(strOutVal), 0)), 13 );
          end;

          // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
          If blnUsaTarifa Then
          Begin
            pDesmembraCarteira('CONFIG341-' + IntToStr(intCartei) + '-' +
              VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
              strOcoEmp, intOcoCar);

            objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
              strOcoEsp, strOcoEmp, intOcoCar);

            objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
            If Assigned(objCnfOco) Then
            Begin
              If objCnfOco.blnCusCar Then
                strCusCar := Copy(strLinha, 176, 13)
              Else
                strTarifa := Copy(strLinha, 176, 13);

              strValPag := '0000000000000';

              objCnfOco.Free;
            End;

            objCnfDao.Free;

            strValLan := Copy(strLinha, 202, 13);

            If fltTarifa > 0 Then
            Begin
              strIofDes := Copy(strLinha, 215, 13);
              strTarifa := Copy(strLinha, 176, 13);
              If Trim(strTipLay) = 'EMPRESTIMO' Then
                strTxaDes := Copy(strLinha, 095, 13)
              Else
                strTxaDes := fStrZero(FloatToStr(fStrToFloat(strValDup) - fStrToFloat(strValLan) - fStrToFloat(strTarifa) - fStrToFloat(strIofDes)),13);
            End;

            If strCodOco = '02' Then
              strValLan := '0';

          End;

          blnDescon := (blnUsaTarifa) And ((strCodOco = '02') or (strCodOco = '06')) And (Trim(strTipLay) = 'EMPRESTIMO');
          If blnDescon Then
          Begin
            strValLan := Copy(strLinha, 202, 13);
            strTarifa := Copy(strLinha, 176, 13);
            strIofDes := Copy(strLinha, 215, 13);
            strJurOpe := Copy(strLinha, 095, 13);
            strTxaDes := fStrZero(FloatToStr(fStrToFloat(strValDup) -
                                             fStrToFloat(strValLan) -
                                             fStrToFloat(strTarifa) -
                                             fStrToFloat(strIofDes) -
                                             fStrToFloat(strJurOpe)),13);
          End;

          //GRAVAR NA RETBCO DESCON = S QUANDO EMPRESTIMO E OCORRÊNCIA 48
          if (strCodOco = '48') And (Trim(strTipLay) = 'EMPRESTIMO') then
          Begin
            blnDescon := True;
            strTxaDes := Copy(strLinha, 280, 13);
          end
          else
          begin
            blnDescon := blnDescon;
            strTxaDes := strTxaDes;
          end;

          If strCodOco <> '04' Then
          Begin
            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If ((((fStrtoFloat(strValPag) + IIF(fEmptyStr(strTarifa), 0, fStrToFloat(strTarifa))) > (fStrtoFloat(strValDup))) And (fStrtoFloat(strDesCon) > 0)) Or (fStrtoFloat(strComPer) > 0)) And
                      (strTipLay = 'EMPRESTIMO') And (strCodOco = '06') Then
              Begin
                stlNaoBai.Add('Duplicata: ' + strNumDup + '-' +
                                              strEspDoc + '-' +
                                              strCodEmp +
                                              ' Cliente: ' + strCodCli +
                                              ' Nosso Número: ' + strNosNum);

                stlNaoBai.Add('--Valor Duplicata: ' + FormatFloat('#,##0.00', fStrtoFloat(strValDup) / 100) +
                              ' Valor Pago: ' + FormatFloat('#,##0.00', fStrtoFloat(strValPag) / 100) +
                              IIF(StrtoFloat(strDescon) > 0, ' Desconto: ' + FormatFloat('#,##0.00', fStrtoFloat(strDescon) / 100), '') +
                              IIF(StrtoFloat(strComPer) > 0, ' Com. Permanência Debitada: ' + FormatFloat('#,##0.00', fStrtoFloat(strComPer) / 100), ''));
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                             False,            '',        '', strDtaCre, strTarifa,
                             strValLan, strCusCar,        '', strIofDes, strTxaDes,
                             blnDescon, strJurOpe);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End

            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If ((((fStrtoFloat(strValPag) + IIF(fEmptyStr(strTarifa), 0, fStrToFloat(strTarifa))) > (fStrtoFloat(strValDup))) And (fStrtoFloat(strDesCon) > 0)) Or (fStrtoFloat(strComPer) > 0)) And
                      (strTipLay = 'EMPRESTIMO') And (strCodOco = '06') Then
              Begin
                stlNaoBai.Add('Duplicata: ' + strNumDupVel + '-' +
                                              strEspDocVel + '-' +
                                              strCodEmpVel +
                                              ' Cliente: ' + strCodCliVel +
                                              ' Nosso Número: ' + strNosNum);

                stlNaoBai.Add('--Valor Duplicata: ' + FormatFloat('#,##0.00', fStrtoFloat(strValDup) / 100) +
                              ' Valor Pago: ' + FormatFloat('#,##0.00', fStrtoFloat(strValPag) / 100) +
                              IIF(StrtoFloat(strDescon) > 0, ' Desconto: ' + FormatFloat('#,##0.00', fStrtoFloat(strDescon) / 100), '') +
                              IIF(StrtoFloat(strComPer) > 0, ' Com. Permanência Debitada: ' + FormatFloat('#,##0.00', fStrtoFloat(strComPer) / 100), ''));

              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                             strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                             strValDup,    strValPag,    strJurMor,           '',    strCodBco,
                             strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                             False,               '',           '',    strDtaCre,    strTarifa,
                             strValLan,    strCusCar,           '',    strIofDes,    strTxaDes,
                             blnDescon, strJurOpe);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDupVel,
                                                           strEspDocVel,
                                                           strCodEmpVel,
                                                           strCodCliVel,
                                                           strParcelVel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCliVel),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End

            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       fStrtoFloat(strTarifa)/100,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArqRet,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;
        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
        begin
          //if fEmptyStr(strBancoIEPTBSP) then
            pMostraArqNaoBaixa('ITAÚ');
          //else
          //  pMostraArqNaoBaixa(strBancoIEPTBSP);
        end;

        If stlNaoBai.Count > 1 Then
        Begin
          For strNomArq in stlNaoBai Do
            lstArqNaoGravados.Add(strNomArq);
        End;
        pMostraDupNaoBaixa(lstArqNaoGravados, lstArqNaoGravados.Count > stlNaoBai.Count);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador];
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  If Assigned(stlNaoBai) Then
    FreeAndNil(stlNaoBai);
  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoSBCredito_Bradesco987(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG987-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG987-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '987'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,127,15);
            strCodRej := '';
            //strCodMot := Copy(strLinha,319,10);
            strMotoco := '';
            //strCarBco := Copy(strLinha,022,03);

            //if strCodOco = '28' then
            // strCusCar := Copy(strLinha,189,13) //Custos de cartório
            //else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;


            strCodBcoReceb := '';//Copy(strLinha,166,03);
            strAgeReceb    := '';//Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           strValLan, strCusCar, strCarBco, '',               '',
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           strValLan,    strCusCar,    '',           '',                  '',
                           blnDescon);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('SB Crédito Bradesco');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;

// RetornoABCBrasilPagar; //240p
function TfrmRetBco.fGeraRetornoABCBrasilPagar(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste   : Boolean;
    strLinha    : String;
    strParcel   : String;
    strDtaOco   : String;
    strDtaVen   : String;
    strDtaPag   : String;
    strNumDup   : String;
    strCodFor   : String;
    strCodEmp   : String;
    strNomArq   : String;
    strCodBco   : String;
    strDesCon   : String;
    strCodOco   : String;
    strValDup   : String;
    strValPag   : String;
    strJurMor   : String;
    strNosNum   : String;
    strMotOco   : String;
    strAutInc   : String;
    strBcoFav   : String;
    strSeqBai   : String;
    strSerie_   : String;
    dtaDtaArq   : TDateTime;
    strVenCtp   : String;
    strVersao   : String;
    strOutEnt   : String;
    intLinhas   : Integer;
    strDocumentoBanco : String;
begin

  pnlInfo.Caption := 'Importando Arquivo de Retorno...';
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetCtp.qryRetCtp);

  blnExiste := False;

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin

        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        strNomArq := lstArquivo.Items.Strings[intContador];
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + strNomArq, dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + strNomArq);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinha  := 0;
        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + strNomArq);


        While Not Eof(txtTexto) Do
        Begin

          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          {*****************************************}
          {* VERIFICA SE NAO FOR DETALHE ELE PULA  *}
          {**************************************AC*}
          If (Not (Copy(strLinha,08,01) = '3')) and (Copy(strLinha, 09, 01) <> 'C') Then
            Continue;

          {*****************************************}
          {* VERIFICA SE FOR REGISTRO 'Z' ELE PULA *}
          {**************************************JS*}
          if (Copy(strLinha, 14, 01) = 'Z') then
            Continue;

          {************************************************************************************}
          {* VERIFICA SE FOR REGISTRO 'C' NO HEADER PARA IDENTIFICAR QUAL O TIPO DO REIGISTRO *}
          {************************************************************************************}
          if (Copy(strLinha, 09, 01) = 'C') then
          begin
            // 045 - Pagamento Através de Crédito em Conta, Cheque, OP, DOC, TED ou Pagamento com Autenticação
            // 040 - Pagamento de Títulos de Cobrança
            // 012 - Pagamento de Tributos
            // 022 - Bloqueto Eletrônico – (Captura de Títulos em Cobrança)
            // 010 - Alegação do Sacado

            strVersao := Copy(strLinha,014,03);
            Continue;
          end;

          //Limpa a versão apenas se estiver no trailer do lote
          if (Copy(strLinha,08,01) = '5') Then
             strVersao := '';

          {******************************************************************************************}
          {* SE TRAILER DE LOTE OU SE FOR DETALHE E O SEGMENTO FOR 'B' OU 'Z' ***********************}
          {* LIMPA AS VARIÁVEIS E PULA DE LINHA PARA NÃO CORRER O RISCO DE BUSCAR A MESMA DUPLICATA *}
          {******************************************************************************************}
          If (Not (Copy(strLinha,08,01) = '3')) Or
             //((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'J') And (Copy(strLinha,15,05) = ' 0052')) Or
             //((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'J') And (Copy(strLinha,15,05) = ' 0152')) Or
             //((Copy(strLinha,08,01) = '3') And (Copy(strLinha,14,01) = 'B')) Or
             (Copy(strLinha,14,01) = 'Z') Then
          begin
            strAutInc := '';
            Continue;
          end;

          strOutEnt := '';
          strDtaVen := '';

          // Segmento O – Pagamento de Contas e Tributos com Código de Barras
          if (Copy(strLinha, 14, 01) = 'O') then
          begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,175,20);
            strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
            strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
            strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
            strBcoFav := '';
            strNosNum := Copy(strLinha, 216,15);  // Nosso numero atribuido pelo banco

            strDtaOco := Copy(strLinha, 137,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,096,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := '';
            strValDup := Copy(strLinha,122,15);
            strValPag := Copy(strLinha,145,15);
            strJurMor := '';
            strCodBco := '246';
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          end
          else

          // Pagamento Através de Crédito em Conta, TED;
          if (Copy(strLinha, 14, 01) = 'A') then
          begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];

            strAutInc := Copy(strLinha,074,20); // numero do documento atribuido pela empresa;
            strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
            strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
            strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
            strBcoFav := Copy(strLinha,021,03);  // Codigo do banco favorecido;
            strNosNum := Copy(strLinha,135,15);  // Nosso numero atribuido pelo banco

            strDtaOco := Copy(strLinha,155,08);  // Data da efetivaçãodo crédito

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDesCon := '';
            strValDup := Copy(strLinha,120,15);
            strValPag := Copy(strLinha,163,15);
            strJurMor := '';
            strCodBco := '246';
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          End
          else

          // Pagamento de Documentos do banco ABC Brasil e outros Bancos
          // if (Copy(strLinha, 14, 01) = 'J') then
          Begin
            strAutInc := Copy(strLinha,183,20);
            strNumDup := '';
            strCodEmp := '';
            strCodFor := '';
            strBcoFav := Copy(strLinha,018,03);
            strNosNum := Copy(strLinha,216,15);

            strDtaOco := Copy(strLinha,145,08);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,092,08);

            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strCodBco := '246';
            strDesCon := Copy(strLinha,115,15);
            strValDup := Copy(strLinha,100,15);
            strValPag := Copy(strLinha,153,15);
            strJurMor := Copy(strLinha,130,15);
            strCodOco := Copy(strLinha,231,10);
            strMotOco := '';
          End;

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADPAG *}
          {*****************************************LB*}
          If fVerificaExisteDuplicContasPagar(strAutInc, strCodFor, strNumDup, strParcel, strCodEmp, strSeqBai, strSerie_, strVenCtp) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBcoContasPagar;

            if (fEmptyStr(strDtaVen)) Or (strDtaVen='01/01/0001') Then
               strDtaVen := strVenCtp;

            pGravaArqBcoContasPagar(strParcel, strNumDup, strCodFor, strCodEmp, strSeqBai, strSerie_,
                                    strCodBco, strBcoFav, strNosNum, strCodOco, strMotOco, strValDup,
                                    strDesCon, strJurMor, strValPag, strDtaVen, strDtaPag, strNomArq,
                                    strAutInc, dtaDtaArq, strOutEnt);

            pGravaLogCtp(strCodBco, strAutInc);

            blnExiste := True;

          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodFor, strNumDup, '', strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

        End;

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('ABC BRASIL');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;

        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          pnlInfo.Caption := '';
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;

    End;

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno Contas a Pagar]');
    End;
  End;

  pnlInfo.Caption := '';
  frmRetBco.Close;

end;

