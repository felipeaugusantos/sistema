  strLinha : String;
  strParcel: String;
  strNumCtr: String;
  strDtaOco: String;
  strDtaVen: String;
  strDtaPag: String;
  strNumDup: String;
  strCodCli: String;
  strCodEmp: String;
  strEspDoc: String;
  strNomArq: String;
  strCodBco: String;
  strDesCon: String;
  strCodOco: String;
  strValDup: String;
  strValPag: String;
  strJurMor: String;
  strNosNum: String;
  strCodRej: String;
  strMotOco: String;
  strCodMot: String;
  intAplica: Integer;
  dtaDtaArq: TDateTime;
  intQtdDup: Integer;
  strDtaArqRet: String;
  dtaDtaArqRet: TDateTime;

  strNumDupVel: String;
  strParcelVel: String;
  strEspDocVel: String;
  strCodEmpVel: String;
  strCodCliVel: String;

  strAutoIncremRet: String;
  strCodBcoReceb: String;
  strAgeReceb: String;
  strCusCar: String;
  strUtilizaDtaCre,
  strDtaCre: String;
  strCarBco: String;

  intContGeral: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Caption := 'Importando Arquivo de Retorno...';
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
