              // Estorno de duplicata descontada para cobrança simples
              {If TransferenciaParaCobrancaSimples Then
              Begin
                // Adicionado o valor da duplicata, pois não vem valor de pagto nesse retorno;
                strValPag := FloatToStr(fStrToFloat(strValDup));
