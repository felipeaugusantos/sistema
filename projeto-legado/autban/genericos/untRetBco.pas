    Begin

      Result := False;
      If fGetBancoConfig(0,'CONFIG977-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S' Then
         If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
             Result := True;

    End;

