            End

            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec, 'CONFIG001D7-' + IntToStr(intCartei), strDtaVen)) Then
            Begin

