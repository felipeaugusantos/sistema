procedure TfrmRetBco.pDeletaRetMot;
  Var
    strSQL: String;
    qryDelete: TUniQuery;
Begin
  Try
    qryDelete := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'DELETE FROM ';
    strSQL := strSQL + '  RETMOT ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  MOT_CODBCO = :CODBCO ';

    With qryDelete Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      IF strNomBanco = 'IEPTB-SP' then
        ParamByName('CODBCO').AsString := '341'
      else
        ParamByName('CODBCO').AsString := LeftStr(strNomBanco,3);

      ExecSQL;
      Close;
    End;

  Finally
    FreeAndNil(qryDelete);
  End;
End;

procedure TfrmRetBco.pDeletaArqBco;
  Var
    strSQL: String;
    qryDelete: TUniQuery;
begin
  Try
    qryDelete := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'DELETE FROM ';
    strSQL := strSQL + '  RETBCO ';
    strSQL := strSQL + 'WHERE ';
    strSQL := strSQL + '  RET_CODBCO = :CODBCO ';

    If fCfgSis('EMPIMP', varBoolean) Then
      strSQL := strSQL + ' AND RET_EMPIMP = ' + VS_strCodEmp.QuotedString;

    With qryDelete Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);

      IF strNomBanco = 'IEPTB-SP' then
        ParamByName('CODBCO').AsString := '341'
      else
        ParamByName('CODBCO').AsString := LeftStr(strNomBanco,3);

      ExecSQL;

      // Apaga registros da tabela RETMOT que registra os motivos de entrada rejeitada
      pDeletaRetMot;

      Close;
    End;

  Finally
    FreeAndNil(qryDelete);
  End;

end;

function TfrmRetBco.fGeraRetornoBancoBrasilPGGContasPagar(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste   : Boolean;
    strLinha    : String;
    strParcel   : String;
    strDtaOco   : String;
    strDtaVen   : String;
    strDtaPag   : String;
    strNumDup   : String;
    strCodFor   : String;
    strCodEmp   : String;
//    strEspDoc   : String;
    strNomArq   : String;
    strCodBco   : String;
    strDesCon   : String;
    strCodOco   : String;
    strValDup   : String;
    strValPag   : String;
    strJurMor   : String;
    strNosNum   : String;
//    strCodRej   : String;
    strMotOco   : String;
    strAutInc   : String;
    strBcoFav   : String;
    strSeqBai   : String;
    strSerie_   : String;
    dtaDtaArq   : TDateTime;
    strVenCtp   : String;
    intLinha    : Integer;
    intLinhas   : Integer;
begin

  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetCtp.qryRetCtp);

  blnExiste := False;

  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinha  := 0;
        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          {*****************************************}
          {* VERIFICA SE NAO FOR DETALHE ELE PULA  *}
          {**************************************AC*}
          If (Not (Copy(strLinha,01,01) = 'G')) Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************LB*}
          strNomArq := lstArquivo.Items.Strings[intContador];

          strAutInc := Copy(strLinha,005,20);
          strNumDup := '';  //Passar na funcao como variavel para poder grava-lo
          strCodEmp := '';  //Passar na funcao como variavel para poder grava-lo
          strCodFor := '';  //Passar na funcao como variavel para poder grava-lo
          strBcoFav := '';
          strNosNum := Copy(strLinha,051,15);

          strDtaOco := Copy(strLinha,135,08);

          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            strDtaOco := Copy(strDtaOco, 7, 2) + '/' + Copy(strDtaOco, 5, 2) + '/' + Copy(strDtaOco, 1, 4);
          End;

          strDtaPag := strDtaOco;

          strDtaVen := Copy(strLinha,127,08);

          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            strDtaVen := Copy(strDtaVen, 7, 2) + '/' + Copy(strDtaVen, 5, 2) + '/' + Copy(strDtaVen, 1, 4);
          End;

          strDesCon := '';
          strValDup := Copy(strLinha,072,11);
          strValPag := Copy(strLinha,277,11);
          strJurMor := Copy(strLinha,094,11);
          strCodBco := '001';
          strCodOco := Copy(strLinha,301,17);

          If fEmptyStr(strCodOco) Then
            strCodOco := '00';

          strMotOco := '';

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplicContasPagar(strAutInc, strCodFor, strNumDup, strParcel, strCodEmp, strSeqBai, strSerie_, strVenCtp) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBcoContasPagar;

            pGravaArqBcoContasPagar(strParcel, strNumDup, strCodFor, strCodEmp, strSeqBai, strSerie_,
                                    strCodBco, strBcoFav, strNosNum, strCodOco, strMotOco, strValDup,
                                    strDesCon, strJurMor, strValPag, strDtaVen, strDtaPag, strNomArq,
                                    strAutInc, dtaDtaArq);

            pGravaLogCtp(strCodBco, strAutInc);

            blnExiste := True;

          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodFor, strNumDup, '', strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BANCO DO BRASIL');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;

        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno Contas a Pagar]');
    End;
  End;

  frmRetBco.Close;

end;

procedure TfrmRetBco.pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                      strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                      strValDup, strValPag, strJurMor, strOutVal, strCodBco, strCodOco,
                      strNosNum, strCodRej, strMotOco: String; dtaDtaArq: TDateTime; blnSomaJur: Boolean = False;
                      strConRet: String = ''; strOutCob: String = ''; strDtaCre: String = ''; strTarifa: String = '';
                      strValLan: String = ''; strCusCar: String = ''; strCarBco: String = ''; strIofDes: String = '';
                      strTxaDes: String = ''; blnDescon: Boolean = False; strJurOpe: String = ''; ACnab: String = '';
                      ATarifaTed: Double = 0.00; ADeveGravarOutVal: Boolean = False; AEmvQrCode : String = ''; ACodigoErroPix : String = '');
  Var
    strDupBai : String;

  Const
    OCORRENCIAS_IGNORADAS: Array of String = ['02', '32', '09'];
Begin

  If stlChave.IndexOf(strCodBco + strCodEmp + strCodCli + strCodOco + strMotOco + strNumDup + strParcel + strEspDoc) >= 0 Then
    Exit;

  Try

    If fVerificaDuplicataBaixada(strNumDup, strParcel, strEspDoc, strCodEmp, strCodCli, strNosNum) Then
      strDupBai := 'S'
    Else
      strDupBai := 'N';

    With frmModuloRetBco.qryRetBco Do
    Begin

      stlChave.Add(strCodBco + strCodEmp + strCodCli + strCodOco + strMotOco + strNumDup + strParcel + strEspDoc);

      Insert;
      intContDup := intContDup + 1;

      If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') And (strDtaOco <> '00000000') Then
        FieldByName('RET_DTAOCO').AsDateTime := StrToDate(strDtaOco) ;//Data Ocorrencia

      If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') And (strDtaVen <> '00000000') Then
        FieldByName('RET_DTAVEN').AsDateTime := StrToDate(strDtaVen); //Data Vencimento

      If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') And (strDtaCre <> '00000000') Then
        FieldByName('RET_DTACRE').AsDateTime := StrToDate(strDtaCre); //Data Crédito

      If (Not fEmptyStr(strDtaPag))                    And
         (strDtaPag <> '000000')                       And
         (strDtaPag <> '00000000')                     And
         (Not MatchStr(strCodOco, OCORRENCIAS_IGNORADAS)) Then
      Begin
        FieldByName('RET_DTAPAG').AsDateTime := StrToDate(strDtaPag); //Data Credito/Pgto
      End;

      If strCodBco = '979' Then
      Begin
        If (Not fEmptyStr(strDtaPag)) And
           (strDtaPag <> '000000')    And
           (strDtaPag <> '00000000') and
           ((strCodOco = '02') or (strCodOco = '06')) Then
        Begin
          FieldByName('RET_DTAPAG').AsDateTime := StrToDate(strDtaPag); //Data Credito/Pgto
        End;
      End;

      If Not fEmptyStr(strDesCon) Then
        FieldByName('RET_DESCON').AsFloat := fStrToFloat(strDesCon)/100; //Valor Desconto

      If Not fEmptyStr(strValDup) Then
        FieldByName('RET_VALDUP').AsFloat := fStrToFloat(strValDup)/100; // Valor Duplicata

      If Not fEmptyStr(strValPag) Then
        FieldByName('RET_VALPAG').AsFloat := fStrToFloat(strValPag)/100;  //Valor Pago

      If Not fEmptyStr(strOutCob) Then
        FieldByName('RET_OUTCOB').AsFloat := fStrToFloat(strOutCob)/100;  //Outros valores (somado no valrec apenas. no movban não)

      If Not fEmptyStr(strTarifa) Then
        FieldByName('RET_TARIFA').AsFloat := fStrToFloat(strTarifa)/100  //Valor da Tarifa Bancária.
      else
        FieldByName('RET_TARIFA').AsFloat := 0;

      If Not fEmptyStr(strValLan) Then
        FieldByName('RET_VALLAN').AsFloat := fStrToFloat(strValLan)/100;  //Valor Rebido - Deduções + Acréscimos.

      If blnSomaJur Then
      Begin

        If (Not fEmptyStr(strJurMor)) And (Not MatchStr(strCodOco, OCORRENCIAS_IGNORADAS)) Then
          FieldByName('RET_VALPAG').AsFloat := FieldByName('RET_VALPAG').AsFloat + fStrToFloat(strJurMor)/100
        Else
          FieldByName('RET_VALPAG').AsFloat := 0;

      End;

      If (Not fEmptyStr(strJurMor)) And (Not MatchStr(strCodOco, OCORRENCIAS_IGNORADAS)) Then
        FieldByName('RET_JURMOR').AsFloat := fStrToFloat(strJurMor)/100 //Juros de Mora
      Else
        FieldByName('RET_JURMOR').AsFloat := 0;

      If (Not fEmptyStr(strOutVal)) And (Not MatchStr(strCodOco, OCORRENCIAS_IGNORADAS)) Then
        FieldByName('RET_OUTVAL').AsFloat := fStrToFloat(strOutVal)/100 //Outros Valores (Despesas de Cobrança)
      Else If ADeveGravarOutVal Then
      Begin
        FieldByName('RET_OUTVAL').AsFloat := fStrToFloat(strOutVal)/100;
        FieldByName('RET_VALPAG').AsFloat := FieldByName('RET_VALPAG').AsFloat - FieldByName('RET_OUTVAL').AsFloat;
      End
      Else
        FieldByName('RET_OUTVAL').AsFloat := 0;

      if ((strCodBco = '041') and  (strCodOco = '30')) then
         FieldByName('RET_DTAPAG').Value := Null;

      if ((strCodBco = '041') and (strCodOco = '09') and (ACnab = '240')) Then
        FieldByName('RET_DTAPAG').Value := StrToDate(strDtaPag); //Data Credito/Pgto

      FieldByName('RET_CODBCO').AsString := strCodBco; //Banco Cobrador
      FieldByName('RET_CODOCO').AsString := strCodOco; //Cód. Ocorrencia
      FieldByName('RET_NOSNUM').AsString := strNosNum; //Nosso Numero
      FieldByName('RET_NUMDUP').AsString := strNumDup; //Nº Duplicata
      FieldByName('RET_PARCEL').AsString := strParcel; //Parcela da Duplicata
      FieldByName('RET_ESPDOC').AsString := strEspDoc; //Especie do Documento
      FieldByName('RET_CODEMP').AsString := strCodEmp; //Código Empresa
      FieldByName('RET_CODCLI').AsString := strCodCli; //Código Cliente
      FieldByName('RET_NOMARQ').AsString := strNomArq; //Nome do Arquivo
      FieldByName('RET_DUPDES').AsString := IIF(blnDescon, 'S', 'N');
      If Not fEmptyStr(AEmvQrCode) Then
        FieldByName('RET_QRCODE').AsString := AEmvQrCode; //QRCODE PIX

      If Not fEmptyStr(ACodigoErroPix) Then
        FieldByName('RET_ERRPIX').AsString := ACodigoErroPix; //CODIGO ERRO PIX - QRCODE

      FieldByName('RET_TARTED').AsFloat := ATarifaTed;

      If dtaDtaArq <> 0 Then
        FieldByName('RET_DTAARQ').AsDateTime := dtaDtaArq; //Data do Arquivo

      If dtaDtaArq <> 0 Then
        FieldByName('RET_HORARQ').AsDateTime := dtaDtaArq; //Hora do Arquivo

      If Not fEmptyStr(strCodRej) Then
        FieldByName('RET_CODREJ').AsString := strCodRej; //Código de Rejeição

      If Not fEmptyStr(strMotOco) Then
        FieldByName('RET_MOTOCO').AsString := strMotOco; //Motivo da Ocorrencia

      FieldByName('RET_CARTEI').AsInteger  := intCartei; // Código da Carteira

      If Not fEmptyStr(strConRet) Then
        FieldByName('RET_CONRET').AsString := strConRet; //Conta de Retorno para Baixa

      If Not fEmptyStr(strCusCar) Then
        FieldByName('RET_CUSCAR').AsFloat := fStrToFloat(strCusCar)/100; //Valor de Custas de cartório

      If Not fEmptyStr(strCarBco) Then
        FieldByName('RET_CARBCO').AsString := strCarBco; //Código da Carteira do banco

      If Not fEmptyStr(strIofDes) Then
        FieldByName('RET_IOFDES').AsFloat := fStrToFloat(strIofDes)/100; //Valor Iof duplicata descontada

      If Not fEmptyStr(strTxaDes) Then
        FieldByName('RET_TXADES').AsFloat := fStrToFloat(strTxaDes)/100; //Taxa de desconto duplicata descontada

      If Not fEmptyStr(strJurOpe) Then
        FieldByName('RET_JUROPE').AsFloat := fStrToFloat(strJurOpe)/100; //Juros da operação sobre desconto de duplicatas

      FieldByName('RET_DUPBAI').AsString := strDupBai;
      FieldByName('RET_EMPIMP').AsString := VS_strCodEmp;

      If strCodBco = '422' Then
      Begin
        If Not fEmptyStr(ACnab) Then
          FieldByName('RET_CNAB__').AsString := ACnab;
      End;

      Post;

    End;

  Except
    On E: EUniError Do
    Begin
      If E.ErrorCode = ERROR_PRIMARY_KEY_INSERT Then
      Begin
        pMensagensErro('O arquivo de retorno tem linhas duplicadas, favor verificar junto ao banco. Linha: ' + IntToStr(intLinha) + #13#10 + E.Message, '[ Gravar registro ]');
      End;
    End;

    On E: Exception Do
    Begin
      Raise Exception.Create(E.Message);
    End;
  End;

End;

procedure TfrmRetBco.pMostraDupNaoBaixa(lstArqNaoGravados: TStringList; blnImpDes: Boolean = True);
  Var
    intContador2: Integer;
Begin

  If lstArqNaoGravados.Count > 0 Then
  Begin
    Try
      pCriarFormularios(TfrmArqNaoGravados,frmArqNaoGravados);
      If blnImpDes Then
      Begin
        frmArqNaoGravados.memResumo.Lines.Add('As Duplicatas abaixo foram encontradas no sistema, porém, estão com a chave de busca duplicada ou incorreta. Necessário realizar a baixa/atualização manual. ');
        frmArqNaoGravados.memResumo.Lines.Add('');
      End;

      For intContador2 := 0 To lstArqNaoGravados.Count-1 Do
      Begin
        frmArqNaoGravados.memResumo.Lines.Add(lstArqNaoGravados[intContador2]);
      End;
      frmArqNaoGravados.ShowModal;

    Finally
      FreeAndNil(frmArqNaoGravados);
      lstArqNaoGravados.Clear;
    End;
  End;

End;

function TfrmRetBco.fRenomeiaArquivo(strNomArq: String): Boolean;
  Var
    strNomArqNovo: String;
    intNumOld    : Integer;

Begin
  intNumOld := 1;

  Repeat

    Result := True;

    If intNumOld = 1 Then
      strNomArqNovo := ChangeFileExt(strNomArq,'.old')
    Else
      strNomArqNovo := ChangeFileExt(strNomArq,'.old' + IntToStr(intNumOld));

    Inc(intNumOld);
  Until Not FileExists(strNomArqNovo);

  If Not RenameFile(strNomArq,strNomArqNovo) Then
  Begin
    fMensagem('','Não foi possível Renomear do arquivo!',['&Ok']);
    Result := False;
  End;

End;

