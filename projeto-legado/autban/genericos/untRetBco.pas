function TfrmRetBco.fVerificaDuplicataBaixada(strNumDup, strParcel, strEspDoc,
  strCodEmp, strCodCli: String; strNosNum: String = ''): Boolean;
  Var
    qryDupBai: TUniQuery;
    strSQL   : String;

begin

  If Not Assigned(stlDupBai) Then
    stlDupBai := TStringList.Create;

  qryDupBai := fCriaQuery(Nil);

  strSQL := '';
  strSQL := strSQL + ' SELECT                     ';
  strSQL := strSQL + '   CTR_NOSNUM               ';
  strSQL := strSQL + ' FROM                       ';
  strSQL := strSQL + '   CADREC                   ';
  strSQL := strSQL + ' WHERE                      ';
  strSQL := strSQL + '   CTR_NUMDUP = :NUMDUP AND ';
  strSQL := strSQL + '   CTR_PARCEL = :PARCEL AND ';
  strSQL := strSQL + '   CTR_ESPDOC = :ESPDOC AND ';
  strSQL := strSQL + '   CTR_CODEMP = :CODEMP AND ';
  strSQL := strSQL + '   CTR_CODCLI = :CODCLI AND ';
  strSQL := strSQL + '   CTR_SEQBAI = 0 AND       ';
  strSQL := strSQL + '   CTR_DTAREC IS NOT NULL   ';

  With qryDupBai Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    ParamByName('NUMDUP').AsString := strNumDup;
    ParamByName('PARCEL').AsString := strParcel;
    ParamByName('ESPDOC').AsString := strEspDoc;
    ParamByName('CODEMP').AsString := strCodEmp;
    ParamByName('CODCLI').AsString := strCodCli;
    Open;

    If Not IsEmpty Then
    Begin
      stlDupBai.Add(IIF(FieldByName('CTR_NOSNUM').AsString  = '', strNosNum, FieldByName('CTR_NOSNUM').AsString));

      Result := True;
    End
    Else
      Result := False;

  End;

  FreeAndNil(qryDupBai);

end;

function TfrmRetBco.fVerificaNosNumDuplicado(strNosNum, strCodBco,
  strCodEmp, strCartei: String; Var intQtdReg: Integer; strChaveCadRec: String): Boolean;
Var
  strSQL : String;
  qryDup : TUniQuery;
begin
  Try
    qryDup := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + ' SELECT ';
    strSQL := strSQL + '   CTR_CARTEI, COUNT(CTR_NOSNUM) REGDUP ';
    strSQL := strSQL + ' FROM CADREC ';
    strSQL := strSQL + ' WHERE CTR_NOSNUM = :NOSNUM ';
    strSQL := strSQL + '  AND (CTR_BCOBOL = :CODBCO OR CTR_BCOENV = :CODBCO) ';
    strSQL := strSQL + '  AND IF(COALESCE(CTR_CARTEI, "") = "", CTR_CODEMP = :CODEMP, TRUE) ';
    strSQL := strSQL + '  AND CTR_SEQBAI = 0 ';
    strSQL := strSQL + ' GROUP BY ';
    strSQL := strSQL + '   CTR_CARTEI ';
    strSQL := strSQL + ' HAVING ';
    strSQL := strSQL + '   COUNT(CTR_NOSNUM) > 1 ';

    With qryDup Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('NOSNUM').AsString := strNosNum;
      ParamByName('CODBCO').AsString := strCodBco;
      ParamByName('CODEMP').AsString := strCodEmp;
      Open;
    End;

    intQtdReg := qryDup.RecordCount;
    Result := qryDup.FieldByName('REGDUP').AsInteger > 1;

    //Se possuir o nosso número na cadrec, verifica se é da duplicata selecionada
    If (Not Result) And (Not fEmptyStr(strCartei)) Then
    Begin
      strSQL := '';
      strSQL := strSQL + ' SELECT ';
      strSQL := strSQL + '   CTR_NOSNUM, ';
      strSQL := strSQL + '   IF(IFNULL(CTR_CARTEI, "") <> "", RIGHT(CTR_CARTEI, 3), CTR_CODEMP) AS EMPCAR ';
      strSQL := strSQL + ' FROM CADREC ';
      strSQL := strSQL + ' WHERE AUTOINCREM <> :AUTINC ';
      strSQL := strSQL + '  AND CTR_NOSNUM = :NOSNUM ';
      strSQL := strSQL + '  AND (CTR_BCOBOL = :CODBCO OR CTR_BCOENV = :CODBCO) ';
      strSQL := strSQL + '  AND CTR_SEQBAI = 0 ';

      qryDup.Close;
      qryDup.SQL.Clear;
      qryDup.SQL.Add(strSQL);
      qryDup.ParamByName('NOSNUM').AsString := strNosNum;
      qryDup.ParamByName('CODBCO').AsString := strCodBco;
      qryDup.ParamByName('AUTINC').AsString := strChaveCadRec;
      qryDup.Open;

      qryDup.Filter   := 'EMPCAR=' + RightStr(strCartei, 3).QuotedString;
      qryDup.Filtered := True;

      Result := (Not qryDup.IsEmpty);
    End;
  Finally
    FreeAndNil(qryDup);
  End;
end;

