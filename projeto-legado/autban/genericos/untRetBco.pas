            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           '',           strCusCar);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BRADESCO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          pnlInfo.Caption := '';
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  pnlInfo.Caption := '';
  frmRetBco.Close;
end;

procedure TfrmRetBco.pGravaArqBcoContasPagar(strParcel, strNumDup, strCodFor, strCodEmp, strSeqBai, strSerie_,
                                             strCodBco, strBcoFav, strNosNum, strCodOco, strMotOco, strValDup,
                                             strDesCon, strJurMor, strValPag, strDtaVen, strDtaPag, strNomArq,
                                             strAutInc: String;
                                             dtaDtaArq: TDateTime;
                                             strOutEnt: String = '');
  Var
    strDtaOco: String;
Begin

  strDtaOco := strDtaPag;

  Try

    With frmModuloRetCtp.qryRetCtp Do
    Begin

      Insert;
      intContDup := intContDup + 1;

      If (Not fEmptyStr(strDtaOco)) And
         (AnsiReplaceStr(strDtaOco, '/', EmptyStr) <> '000000') And
         (AnsiReplaceStr(strDtaOco, '/', EmptyStr) <> '00000000') Then
        FieldByName('RET_DTAOCO').AsDateTime := StrToDate(strDtaOco) ;//Data Ocorrencia

      If (Not fEmptyStr(strDtaVen)) And
         (AnsiReplaceStr(strDtaVen, '/', EmptyStr) <> '000000') And
         (AnsiReplaceStr(strDtaVen, '/', EmptyStr) <> '00000000') Then
        FieldByName('RET_DTAVEN').AsDateTime := StrToDate(strDtaVen); //Data Vencimento

      If (Not fEmptyStr(strDtaPag)) And
         (AnsiReplaceStr(strDtaPag, '/', EmptyStr) <> '000000') And
         (AnsiReplaceStr(strDtaPag, '/', EmptyStr) <> '00000000') Then
        FieldByName('RET_DTAPAG').AsDateTime := StrToDate(strDtaPag); //Data Credito/Pgto

      If Not fEmptyStr(strDesCon) Then
        FieldByName('RET_VALDES').AsFloat := fStrToFloat(strDesCon)/100; //Valor Desconto

      If Not fEmptyStr(strValDup) Then
        FieldByName('RET_VALDUP').AsFloat := fStrToFloat(strValDup)/100; // Valor Duplicata

      If Not fEmptyStr(strValPag) Then
        FieldByName('RET_VALPAG').AsFloat := fStrToFloat(strValPag)/100;  //Valor Pago

      If Not fEmptyStr(strJurMor) Then
        FieldByName('RET_VALJUR').AsFloat := fStrToFloat(strJurMor)/100; //Juros de Mora

      If Not fEmptyStr(strOutEnt) Then
        FieldByName('RET_OUTENT').AsFloat := fStrToFloat(strOutEnt)/100; //Outras Entidades

      FieldByName('RET_CODBCO').AsString := strCodBco; //Banco Cobrador

      IF blnPGG Then
        FieldByName('RET_BCOPGG').AsString := strCodBco; //Banco Cobrador (pagamento guias gnre)

      FieldByName('RET_BCOFAV').AsString := strBcoFav; //Banco Favorecido
      FieldByName('RET_CODOCO').AsString := strCodOco; //Cód. Ocorrencia
      FieldByName('RET_NOSNUM').AsString := strNosNum; //Nosso Numero
      FieldByName('RET_NUMDUP').AsString := strNumDup; //Nº Duplicata
      FieldByName('RET_PARCEL').AsString := strParcel; //Parcela da Duplicata
      FieldByName('RET_SEQBAI').AsString := strSeqBai; //Sequência da Baixa
      FieldByName('RET_SERIE_').AsString := strSerie_; //Serie
      FieldByName('RET_CODEMP').AsString := strCodEmp; //Código Empresa
      FieldByName('RET_CODFOR').AsString := strCodFor; //Código Cliente
      FieldByName('RET_NOMARQ').AsString := strNomArq; //Nome do Arquivo
      FieldByName('RET_AUTOIN').AsString := strAutInc; //Auto-Incremento

      If dtaDtaArq <> 0 Then
        FieldByName('RET_DTAARQ').AsDateTime := dtaDtaArq; //Data do Arquivo

      If dtaDtaArq <> 0 Then
        FieldByName('RET_HORARQ').AsDateTime := dtaDtaArq; //Hora do Arquivo

      If Not fEmptyStr(strMotOco) Then
        FieldByName('RET_MOTOCO').AsString   := strMotOco; //Motivo da Ocorrencia

      Post;
    End;

  Except
    On E: Exception Do
    Begin
      Raise Exception.Create(E.Message);
    End;
  End;

End;

procedure TfrmRetBco.pGravaNossoNumeroBancoAmazonia;
  Var
    strSQL : String;
    qryRet : TUniQuery;
    qryRec : TUniQuery;
begin

  qryRet := fCriaQuery(Self);
  qryRec := fCriaQuery(Self);

  strSQL := '';
  strSQL := strSQL + ' SELECT                ';
  strSQL := strSQL + '   RET_NUMDUP,         ';
  strSQL := strSQL + '   RET_PARCEL,         ';
  strSQL := strSQL + '   RET_ESPDOC,         ';
  strSQL := strSQL + '   RET_CODEMP,         ';
  strSQL := strSQL + '   RET_CODCLI,         ';
  strSQL := strSQL + '   RET_NOSNUM          ';
  strSQL := strSQL + ' FROM                  ';
  strSQL := strSQL + '   RETBCO              ';
  strSQL := strSQL + ' WHERE                 ';
  strSQL := strSQL + '   RET_CODBCO = "003"  ';

  With qryRet Do
  Begin
    Close;
    SQL.Clear;
    SQL.Add(strSQL);
    Open;
    First;
  End;

  Try
    fStartTransaction;

    While Not qryRet.Eof Do
    Begin
      strSQL := '';
      strSQL := strSQL + ' UPDATE                     ';
      strSQL := strSQL + '   CADREC                   ';
      strSQL := strSQL + ' SET                        ';
      strSQL := strSQL + '   CTR_NOSNUM = :NOSNUM     ';
      strSQL := strSQL + ' WHERE                      ';
      strSQL := strSQL + '   CTR_NUMDUP = :NUMDUP AND ';
      strSQL := strSQL + '   CTR_PARCEL = :PARCEL AND ';
      strSQL := strSQL + '   CTR_ESPDOC = :ESPDOC AND ';
      strSQL := strSQL + '   CTR_CODEMP = :CODEMP AND ';
      strSQL := strSQL + '   CTR_CODCLI = :CODCLI AND ';
      strSQL := strSQL + '   CTR_BCOENV = "003"       ';

      With qryRec Do
      Begin
        Close;
        SQL.Clear;
        SQL.Add(strSQL);
        ParamByName('NOSNUM').AsString := qryRet.FieldByName('RET_NOSNUM').AsString;
        ParamByName('NUMDUP').AsString := qryRet.FieldByName('RET_NUMDUP').AsString;
        ParamByName('PARCEL').AsString := qryRet.FieldByName('RET_PARCEL').AsString;
        ParamByName('ESPDOC').AsString := qryRet.FieldByName('RET_ESPDOC').AsString;
        ParamByName('CODEMP').AsString := qryRet.FieldByName('RET_CODEMP').AsString;
        ParamByName('CODCLI').AsString := qryRet.FieldByName('RET_CODCLI').AsString;
        ExecSQL;
      End;

      qryRet.Next;
    End;

    fCommit;
  Except
    On E: Exception Do
    Begin
      fRollBack;
      Raise Exception.Create(E.Message);
    End;
  End;

  FreeAndNil(qryRet);
  FreeAndNil(qryRec);

end;

procedure TfrmRetBco.pDeletaArqBcoContasPagar;
  Var
    strSQL: String;
    qryDelete: TUniQuery;
begin

  Try

    qryDelete := fCriaQuery(Self);

    strSQL := '';
    strSQL := strSQL + 'DELETE FROM ';
    strSQL := strSQL + '  RETCTP ';
    strSQL := strSQL + 'WHERE ';

    If blnPGG Then
      strSQL := strSQL + '  RET_BCOPGG = RET_CODBCO AND '
    Else
      strSQL := strSQL + '  RET_BCOPGG IS NULL AND ';

    strSQL := strSQL + '  RET_CODBCO = :CODBCO ';

    With qryDelete Do
    Begin
      Close;
      SQL.Clear;
      SQL.Add(strSQL);
      ParamByName('CODBCO').AsString := LeftStr(strNomBanco,3);
      ExecSQL;
      Close;
    End;

  Finally
    FreeAndNil(qryDelete);
  End;

end;

