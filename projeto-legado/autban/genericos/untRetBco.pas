            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '997'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            strMotoco := '';
            strCarBco := Copy(strLinha,022,03);

            if strCodOco = '28' then
              strCusCar := Copy(strLinha,189,13) //Custos de cartório
            else
              strCusCar := '';

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              strDesCon := '0000000000000';
              strJurMor := '0000000000000';
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            blnDescon := (strCodOco = '10') And fConfirmaMotivoOcorrencia('20', strCodMot);
            If blnDescon Then
              strValLan := strValDup;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre,        '',
                           strValLan, strCusCar, strCarBco, '',               '',
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,           '',
                           strValLan,    strCusCar,    '',           '',                  '',
                           blnDescon);
                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('GARSON CRÉDITO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;
end;


function TfrmRetBco.fGeraRetornoRibPreto(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
//    strTipReg: String;
//    strTipIns: String;
    strMotOco: String;
    intQtdDup: Integer;
    dtaDtaArq: TDateTime;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG741-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try
    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************LB*}
          strNomArq := lstArquivo.Items.Strings[intContador];

          strNumCtr := Copy(strLinha,038,25);

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
          End;

          strDtaOco := Copy(strLinha,111,06);
          If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
          Begin
            System.Insert('/',strDtaOco,3);
            System.Insert('/',strDtaOco,6);
          End;

          strDtaVen := Copy(strLinha,147,06);
          If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
          Begin
            System.Insert('/',strDtaVen,3);
            System.Insert('/',strDtaVen,6);
          End;

        { strDtaPag := Copy(strLinha,176,06);
          If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
          Begin
            System.Insert('/',strDtaPag,3);
            System.Insert('/',strDtaPag,6);
          End;
        }

          strCodOco := Copy(strLinha,109,02);
          strNosNum := Copy(strLinha,127,08);
          strCodBco := '741';  //Copy(strLinha,166,03);
          strDesCon := Copy(strLinha,241,13);
          strJurMor := Copy(strLinha,267,13);
          strValDup := Copy(strLinha,153,13);
          strValPag := Copy(strLinha,254,13);
          strCodRej := '';
          strMotOco := '';

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArq,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('RIBEIRÃO PRETO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;



