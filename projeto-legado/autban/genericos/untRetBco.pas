procedure TfrmRetBco.pTodosArquivos;
  Var
    intCont: Integer;
begin

  lstArquivo.FileType := [ftReadOnly, ftArchive];

  lstArquivo.Mask := '*.*';

  If lstArquivo.Count = 0 Then
    Exit;

  intCont := 0;

  Repeat

    If SameText(ExtractFileExt(lstArquivo.Items[intCont]), '.old') Then
    Begin
      lstArquivo.Items.Delete(intCont);
      intCont := 0;
    End
    Else
      Inc(intCont);

  Until (intCont = lstArquivo.Count);

end;

procedure TfrmRetBco.pGravaLogCtp(strCodBco, strAutoIncrem : String);
Var
    objPag: TCadPag;
    objRep: TCadPagRepository;
    strGetCodFor: String;
Begin
  {****************}
  {* GRAVA LOGCTP *}
  {*************JS*}
  objRep := TCadPagRepository.Create;
  objPag := objRep.fRetDuplicata(strAutoIncrem);

  If Assigned(objPag) Then
  begin
    strGetCodFor := objPag.objCodFor.FOR_CODFOR;
    untLogCtp.pGravaLogCtp(objPag, 'IMPORTACAO DO ARQUIVO DE RETORNO - ' + strCodBco, Self.Name);
  end;

  If Assigned(objRep) Then
    FreeAndNil(objRep);
End;

procedure TfrmRetBco.pGravaLogCtr(strCodBco, strAutoIncrem : String);
Begin
  {****************}
  {* GRAVA LOGCTR *}
  {*************JS*}
  untLogCtr.GravaLogCtr(strAutoIncrem, 'IMPORTAÇÃO DO ARQUIVO DE RETORNO - ' + strCodBco, Self.Name);
End;

procedure TfrmRetBco.pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                                  strCodEmp, strCodMot, strCodOco: String);
  Var
    qryRetMot: TUniQuery;
    strLinha : String;
    intTamStr: Integer;
    intCont  : Integer;
  procedure pLimpaRetMotSemAutoIncrem;
    var
      qryConsReg: TUniQuery;
  begin
    qryConsReg := fCriaQuery();
    with qryConsReg do
    begin
      Sql.Clear;
      Sql.Text := ' SELECT * FROM RETMOT WHERE AUTOINCREM = "" OR AUTOINCREM IS NULL ';
      Open;

      if not IsEmpty then
      begin
        Close;
        Sql.Clear;
        Sql.Text := ' TRUNCATE TABLE RETMOT ';
        ExecSQL;
      end;

      Close;
    end;

    FreeAndNil(qryConsReg);
  end;
begin

  If fEmptyStr(strCodMot) Then
    Exit;

  pLimpaRetMotSemAutoIncrem;

  strLinha  := strCodMot;
  intTamStr := Length(strLinha);

  qryRetMot := fCriaQuery(Self);

  With qryRetMot, Sql Do
  Begin
    Clear;
    Add('INSERT RETMOT (MOT_CODBCO, MOT_NUMDUP, MOT_PARCEL, MOT_ESPDOC, ');
    Add('MOT_CODCLI, MOT_CODEMP, MOT_CODOCO, MOT_CODMOT, MOT_DESMOT, AUTOINCREM) VALUES ');
    Add('(:CODBCO, :NUMDUP, :PARCEL, :ESPDOC, :CODCLI, :CODEMP, :CODOCO, :CODMOT, :DESMOT, :AUTOIN)');
  End;

  For intCont := 1 To intTamStr Do
  Begin
    if Length(strLinha)<=0 Then
      Break;

      strCodMot := Copy(strLinha, 1, 2);

      If (strCodBco = '422') Then
        strCodMot := Copy(strLinha, 1, 3);

      With qryRetMot, Sql Do
      Begin
        ParamByName('CODBCO').AsString := strCodBco;
        ParamByName('NUMDUP').AsString := strNumDup;
        ParamByName('PARCEL').AsString := strParcel;
        ParamByName('ESPDOC').AsString := strEspDoc;
        ParamByName('CODCLI').AsString := strCodCli;
        ParamByName('CODEMP').AsString := strCodEmp;
        ParamByName('CODOCO').AsString := strCodOco;
        ParamByName('CODMOT').AsString := strCodMot;
        ParamByName('DESMOT').AsString := fRetMotOcorrencia(strCodBco, strCodMot);
        ParamByName('AUTOIN').AsString := fRetAutoIncrem('RETMOT', strCodEmp);

        If Not fEmptyStr(ParamByName('DESMOT').AsString) Then
          ExecSQL;

      End;

      Delete(strLinha, 1, 2);
  End;

  FreeAndNil(qryRetMot);
End;

function TfrmRetBco.fValidaDiretorio : Boolean;
begin
  Result := False;
  lblCaminhoMsg.Caption := 'Diretório não encontrado!';

  Try
    If TryDirectoryExists(fraPathRetornoBco.edtDirectory.text) Then
    Begin
      lstArquivo.ApplyFilePath(fraPathRetornoBco.edtDirectory.text);
      Result := True;

      If strCodBco = '637' Then
        pTodosArquivos;

      if (strCodBco = '041') And (strTipGer = 'P') then
         lstArquivo.Mask := '*.txt;*.ret;*.dat;*.rst;*.html;*.bat;*.bar;*.crt;*.rt1;*.rt3;*.ced;*.144;*.tst';

    End;
  Except
    lblCaminhoMsg.Caption := 'Sem permissão de acesso ao diretório!';
  End;

end;

function TfrmRetBco.fValidaArquivos : Boolean;
var
  intContador : integer;
begin

  Result := True;

  For intContador := 0 To lstArquivo.Count-1 Do
  Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        If Not SysUtils.FileExists(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]) Then
        Begin
         Result := False;
         Break;
        End;
      End;
  End;

end;

