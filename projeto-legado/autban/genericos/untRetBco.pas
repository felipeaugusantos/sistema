            {* DA OCORRENCIA. SE FOR <> 06 RECEBE VAZIO        *}
            {************************************************LB*}
            If (strCodOco = '06') Then
              strDtaPag := strDtaOco;

            strNosNum := Copy(strLinha,063,11);
            strCodBco := '409';  //Copy(strLinha,166,03);
            strDesCon := Copy(strLinha,241,13);
            strJurMor := Copy(strLinha,267,13);
            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strCodRej := '';
            strMotOco := '';
          End
          Else
          Begin
            strNumCtr := Copy(strLinha,038,25);

            strDtaOco := Copy(strLinha,293,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strCodOco := Copy(strLinha,109,02);

            {***************************************************}
            {* SE COD. OCORRENCIA = 06 PAGAMENTO RECEBE A DTA  *}
            {* DA OCORRENCIA. SE FOR <> 06 RECEBE VAZIO        *}
            {************************************************LB*}
            If (strCodOco = '06') Then
              strDtaPag := strDtaOco;

            strNosNum := Copy(strLinha,063,15);
            strCodBco := '409';  //Copy(strLinha,166,03);
            strDesCon := Copy(strLinha,241,13);
            strJurMor := Copy(strLinha,267,13);
            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strCodRej := Copy(strLinha,378,08);
            strMotOco := '';
          End;

          strNumDup := '';
          strParcel := '';
          strEspDoc := '';
          strCodEmp := '';
          strCodCli := '';

          {********************************************************************************************}
          {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
          {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
          {*****************************************************************************************MO*}
          if EhNumero(Copy(strNumCtr,006,02)) then
          begin
            //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
            If (Length(Trim(strNumCtr)) = 20) then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Trim(Copy(strNumCtr,013,03));
              strEspDoc := Copy(strNumCtr,016,02);
              strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
              strCodCli := '';
            End
            //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
            Else If Length(Trim(strNumCtr)) = 25 Then
            Begin
              strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
              strParcel := Copy(strNumCtr,013,01);
              strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
              strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
            End;
          End
          Else
          Begin
            //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
            strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
            strParcel := Copy(strNumCtr,007,01);
            strEspDoc := Copy(strNumCtr,008,02);
            strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
            strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
          End;

          If (fEmptyStr(strCodCli)) Or (strCodCli = '00000000') Then
            strCodCli := '';

          strCodBcoReceb := Copy(strLinha,166,03);
          strAgeReceb    := Copy(strLinha,169,05);

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************LB*}
          If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
          Begin

            If Not blnExiste Then
              pDeletaArqBco;

            If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else If intQtdDup > 1 Then
            Begin
              lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                    strEspDoc + '-' +
                                                    strCodEmp +
                                                    ' Cliente: ' + strCodCli +
                                                    ' Nosso Número: ' + strNosNum);
            End
            Else
            Begin
              pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

              pGravaLogCtr(strCodBco, strAutoIncremCadRec);

              blnExiste := True;
            End;
          End
          Else
          Begin
            pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                        StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                        fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
          End;

          {*****************************}
          {* GRAVAÇÃO DA TABELA REMGER *}
          {** DADOS GERAIS DA REMESSA **}
          {**************************MO*}

          //GRAVA SOMENTE UMA VEZ
          if intContGeral = 0 then
          begin
            pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
            Inc(intContGeral);
          end;

          {*****************************}
          {* GRAVAÇÃO DA TABELA RETDET *}
          {**** DETALHES DA RETORNO ****}
          {**************************MO*}
          pGravaRetDet(strAutoIncremRet,
                       strAutoIncremCadRec,
                       strNosNum,
                       fStrToFloat(strValPag)/100,
                       fStrtoFloat(strJurMor)/100,
                       fStrtoFloat(strDescon)/100,
                       0,
                       StrToDateDef(strDtaPag, 0),
                       strCodBcoReceb,
                       strAgeReceb,
                       dtaDtaArq,
                       strLoginUsuarioLogado,
                       '',
                       strCodOco,
                       blnAtualizaRet);
          blnAtualizaRet := False;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('UNIBANCO');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoUnicred(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG090-' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************JU*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If Pos('_400p', strNomBanco) > 0 Then
        Begin
          strDtaArqRet := Copy(strLinha, 095, 6);
          If ((Copy(strLinha, 077, 03)) <> '090') And ((Copy(strLinha, 077, 03)) <> '237') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Unicred ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;
        End
        Else
        Begin
          strDtaArqRet := Copy(strLinha, 144, 8);
          If ((Copy(strLinha, 01, 03)) <> '090') And ((Copy(strLinha, 01, 03)) <> '237') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Unicred ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;
        End;
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        blnLeuDta := False;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************JU*}
          If Eof(txtTexto) Then
            Continue;

          If Pos('_400p', strNomBanco) <= 0 Then
          Begin

            {****************}
            {* SEGMENTO "T" *}
            {*************JU*}
            If Copy(strLinha, 14, 1) = 'T' Then
            Begin
              {*************************************************}
              {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
              {**********************************************JU*}
              strNomArq := lstArquivo.Items.Strings[intContador];
              strNumCtr := Copy(strLinha,106,25);

              strNumDup := '';
              strParcel := '';
              strEspDoc := '';
              strCodEmp := '';
              strCodCli := '';

              {********************************************************************************************}
              {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
              {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
              {*****************************************************************************************MO*}
              if EhNumero(Copy(strNumCtr,006,02)) then
              begin
                //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
                If (Length(Trim(strNumCtr)) = 20) then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Trim(Copy(strNumCtr,013,03));
                  strEspDoc := Copy(strNumCtr,016,02);
                  strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                  strCodCli := '';
                End
                //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
                Else If Length(Trim(strNumCtr)) = 25 Then
                Begin
                  strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                  strParcel := Copy(strNumCtr,013,01);
                  strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                  strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                  strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
                End;
              End
              Else
              Begin
                //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              End;

              strDtaVen := Copy(strLinha,74,08);
              If Not fEmptyStr(strDtaVen) And (strDtaVen <> '00000000') Then
              Begin
                System.Insert('/',strDtaVen,3);
                System.Insert('/',strDtaVen,6);
              End;

              strValDup := Copy(strLinha,82,15);
              strCodBco := '090';
              strCodOco := Copy(strLinha,16,02);
              strNosNum := Copy(strLinha,038,11);
              strNosNum := RightStr(strNosNum, 08);
              strCodRej := '';
              strMotOco := '';

              strCodBcoReceb := Copy(strLinha,097,03);
              strAgeReceb    := Copy(strLinha,100,05);
            End;

            {****************}
            {* SEGMENTO "U" *}
            {*************JU*}
            If Copy(strLinha, 14, 1) = 'U' Then
            Begin
              strDtaOco := Copy(strLinha,138,08);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '00000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := strDtaOco;

              strDesCon := Copy(strLinha,33,15);
              strValPag := Copy(strLinha,78,15);

              blnLeuDta := True;
            End;
          End
          Else
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha, 38, 25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03), 3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08), 8);
            End;

            strDtaOco := Copy(strLinha,111,06);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;
            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := Copy(strLinha,241,13);
            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strJurMor := Copy(strLinha,267,13);
            strCodBco := '090';
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,068,15);
            strCodRej := '';
            strMotOco := '';

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);
          End;

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If blnLeuDta Or (Pos('_400p', strNomBanco) > 0) Then
          Begin
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            blnLeuDta := False;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;
        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('UNICRED');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoUnicred136(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    blnLeuDta: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;
begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG136_400p' + IntToStr(intCartei) + '-' + VS_strCodEmp;
  Try

    For intContador := 0 To lstArquivo.Count-1 Do
    Begin
      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************JU*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If Pos('400p', strNomBanco) > 0 Then
        Begin
          strDtaArqRet := Copy(strLinha, 095, 6);
          If ((Copy(strLinha, 077, 03)) <> '136') And ((Copy(strLinha, 077, 03)) <> '237') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Unicred ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;
        End
        Else
        Begin
          strDtaArqRet := Copy(strLinha, 144, 8);
          If ((Copy(strLinha, 01, 03)) <> '136') And ((Copy(strLinha, 01, 03)) <> '237') Then
          Begin
            fMensagem('', 'Não é um arquivo de retorno do Banco Unicred ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
            CloseFile(txtTexto);
            Exit;
          End;
        End;
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        blnLeuDta := False;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************JU*}
          If Eof(txtTexto) Then
            Continue;

          If Pos('400p', strNomBanco) > 0 Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha, 280, 26);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03), 3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08), 8);
            End;

            strDtaOco := Copy(strLinha,111,06);

            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;
            strDtaPag := strDtaOco;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDesCon := Copy(strLinha,241,13);
            strValDup := Copy(strLinha,153,13);
            strValPag := Copy(strLinha,254,13);
            strJurMor := Copy(strLinha,267,13);
            strCodBco := '136';
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,052,11);
            strCodRej := '';
            strMotOco := '';

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,04);
          End;

          {********************************************}
          {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
          {*****************************************JU*}
          If blnLeuDta Or (Pos('400p', strNomBanco) > 0) Then
          Begin
            If fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum, strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec) Then
            Begin

              If Not blnExiste Then
                pDeletaArqBco;

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                             strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                             strValDup, strValPag, strJurMor, '',        strCodBco,
                             strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            blnLeuDta := False;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, lstArquivo.Items.Strings[intContador], 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;
        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('UNICRED');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! Portanto ficará em aberto para análise!',['&OK']);
          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;

    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;


function TfrmRetBco.fConfirmaMotivoOcorrencia(strCodMot, strLinha: String): Boolean;
var
  intSeq: Integer;
begin
  Result := False;

  For intSeq := 0 To Length(strLinha) Do
  Begin
    If (Copy(strLinha, 1, 2) = strCodMot) Then
    Begin
      Result := True;
      Break;
    End
    Else
      Delete(strLinha, 1, 2);
  End;
end;

function TfrmRetBco.fEhRegistroJ52BradescoPagar(AVersao,
  ALinha: string): Boolean;
begin
  Result := False;

  If (AVersao <> '040') Then
    Exit;

  If (Copy(ALinha, 14, 01) <> 'J') Then
    Exit;

  If Trim(Copy(ALinha, 15, 01)) <> '' Then
    Exit;

  Result := True;
end;

