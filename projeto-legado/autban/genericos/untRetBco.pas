function TfrmRetBco.fGeraRetornoBcoBrasil(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strTipCob: String;
    strDesCon: String;
    strValLan: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strJurMor: String;
    strTarifa: String;
    strOutVal: String;
    strOutDes: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strValOco: String;
    strDtaCre: String;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strIofDes,
    strTxaDes,
    strOcoBco,
    strOcoLay,
    strNumPos,
    strOcoEsp,
    strCusCar,
    strOcoEmp: String;
    intOcoCar: Integer;

    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    fltTarifa: Double;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;
    stlNaoBai   : TStringList;
    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    intIndex: Integer;

    intContGeral: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LAtualizarDesCob: Boolean;

    LOcorrenciasDeProtestoECartorio: String;

    function DuplicataDescontada(ATipCob: String): Boolean;
    Begin
      Result :=  (ATipCob = '4');

      {Utiliza duplicata descontada para cobranças vinculadas (2) Req: 212601 MT}
      If fGetBancoConfig(0, 'CONFIG001D7-' + IntToStr(intCartei), 'UTLDESCOBVINC', '') = 'S' Then
      Begin
        Result := (Pos(ATipCob,'4_2_') > 0);
      End;

    End;

begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  blnExiste := False;
  strCartei := 'CONFIG001' + strDigito + IntToStr(intCartei) + '-' + VS_strCodEmp;
  stlNaoBai := TStringList.Create;
  stlNaoBai.Add('Duplicatas com Juros e Descontos inconsistentes ou com Comissão de Permanência debitadas devem ser avaliadas e feita a baixa manual.');

  LAtualizarDesCob := False;

  LOcorrenciasDeProtestoECartorio := EmptyStr;

  Try
    For intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador],dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '001') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco do Brasil ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;

          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          {*************************************************}
          {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
          {**********************************************LB*}
          {**************************************************}
          {* SE O NOME DO BANCO CONTER 7D IRA PEGAR AS CFG. *}
          {* REFERENTE AO BANCO DO BRASIL DE 7 DIGITOS      *}
          {* SENAO IRA PEGAR O DE 6 DIGITOS                 *}
          {***********************************************LB*}
          If RightStr(strNomBanco,2) = '7d' Then
          Begin

            LAtualizarDesCob := fGetBancoConfig(0, 'CONFIG001D7-' + IntToStr(intCartei), 'ATUALIZA_DESPCOB', '').Equals('S');
            CarregaOcorrenciasProtestoCartorio('001', LOcorrenciasDeProtestoECartorio);

            If (Copy(strLinha, 1, 3) = '501') Then
              Continue;

            {***********************************}
            {* TIPO DE COBRANÇA - NOME ARQUIVO *}
            {********************************AF*}
            strNomArq := Copy(strLinha,081,1) + '-' + lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha,039,25);
            strValOco := fGetBancoConfig(0, 'CONFIG001D7-' + IntToStr(intCartei), 'VALOCO5', '');

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              Try
                {*****************************************}
                {* ESSE NÃO PODE SER fStrToFloat         *}
                {**************************************AF*}
                fStrToFloat(fStrZero(Copy(strNumCtr,013,08),8));

                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strEspDoc := Copy(strNumCtr,008,02);
                strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
              Except
                strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
                strParcel := Copy(strNumCtr,007,01);
                strCodCli := fStrZero(Copy(strNumCtr,008,08),8);
                strCodEmp := fStrZero(Copy(strNumCtr,016,03),3);
                strEspDoc := Copy(strNumCtr,019,02);
              End;
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) And Not fEmptyStr(strNumCtr) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDtaCre := Copy(strLinha,176,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            strDtaPag := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
            Begin
              System.Insert('/',strDtaPag,3);
              System.Insert('/',strDtaPag,6);
            End;

            {**********************************}
            {* DATA DE PAGTO EH A MESMA QUE A *}
            {* DATA DE OCORRENCIA             *}
            {*******************************JB*}
            strCodOco := Copy(strLinha,109,02);
            strTipCob := Copy(strLinha,081,01);

            strDesCon := Copy(strLinha,241,13);
            strValDup := Copy(strLinha,153,13);
            strJurMor := Copy(strLinha,267,13);
            strOutDes := Copy(strLinha,189,13);
            strOutVal := Copy(strLinha,280,13);

            strValPag := '';
            strValLan := '';
            strTarifa := '';
            fltTarifa := 0;
            strTxaDes := '';
            strIofDes := '';

            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG001D7-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if (strCodOco = '06')  And
               (fltTarifa > 0) and
               (fCfgSis('ENCBAN', varBoolean))  then
            begin
              strTarifa := Copy(strLinha,182,07);
              strValPag := IIF(MatchStr(strTipCob, ['4', '7', '2']),
                               InttoStr(StrToInt64(Copy(strLinha,254,13)) - StrToInt(strTarifa)),
                               Copy(strLinha,306,13));
              strValLan := Copy(strLinha,254,13);
            end
            else
            begin
              strValPag := Copy(strLinha,254,13);
              strValLan := '';
            end;

            strOutVal := AnsiReplaceStr(AnsiReplaceStr(FloatToStrF((fStrToFloat(strOutVal)/100) + (fStrToFloat(strOutDes)/100), ffFixed, 12,2),'.',''),',','');
            strJurMor := AnsiReplaceStr(AnsiReplaceStr(FloatToStrF((fStrToFloat(strJurMor)/100), ffFixed, 12,2),'.',''),',','');
            strCodBco := '001'; //Copy(strLinha,166,03);
            strCusCar := '';

            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG001' + strDigito + IntToStr(intCartei) + '-' +
                                 VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                                 strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                                             strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco, fStrZero(strTipCob, 2));
              If (Assigned(objCnfOco)) Then
              Begin
                If objCnfOco.blnCusCar Then
                  strCusCar := Copy(strLinha, 182, 07)
                Else
                  strTarifa := Copy(strLinha, 182, 07);

                objCnfOco.Free;
              End;

              objCnfDao.Free;

              strValLan := Copy(strLinha, 306, 13);
              strIofDes := Copy(strLinha, 215, 13);
              strTxaDes := Copy(strLinha, 202, 13);

              If (fltTarifa > 0) And (fEmptyStr(strCusCar)) Then
                strTarifa := Copy(strLinha, 182, 07);

              If strCodOco = '02' Then
                strValLan := '0';
            End;

            If Pos(strCodOco, LOcorrenciasDeProtestoECartorio) > 0 then
            Begin
              if LAtualizarDesCob then
              begin
                strOutVal := AnsiReplaceStr(AnsiReplaceStr(FloatToStrF((fStrToFloat(strOutVal)/100) + (fStrToFloat(strOutDes)/100) + (fStrToFloat(Copy(strLinha,182,07))/100), ffFixed, 12,2),'.',''),',','');
                strTarifa := '0000000';
              end
              else
                strOutVal := '0000000';
            End;

            {*****************************************}
            {* FEITO PARA A RR PARAFUSOS POR CONTA DA*}
            {* DUPLICIDADE DE NOSSO NÚMERO.          *}
            {**************************************MV*}
            If (strCodOco = '05') And
               (strValOco = 'S') Then
            Begin
              Continue;
            End;

            strNosNum := Copy(strLinha,064,17);
            strNosNum := RightStr(strNosNum,10);

            strCodRej := '';
            strMotOco := '';

          End
          Else
          Begin
            strNomArq := lstArquivo.Items.Strings[intContador];
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';

            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            End
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := fStrZero(Copy(strNumCtr,001,06),6);
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strDtaCre := Copy(strLinha,176,06);
