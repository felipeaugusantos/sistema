procedure TfrmRetBco.FormShow(Sender: TObject);
begin

  If LUtilizaAlpe Then
  Begin
    If (fMensagem('ATENÇÃO','Deseja realizar o download do(s) arquivo(s) retorno disponibilizados pela Alpe?',['&SIM', '&NÃO'], 1) = 1) Then
    Begin
      TfrmGravando.fExecutarModalA(ImportarRetornoAlpe,'Aguarde, Realizando download do(s) arquivo(s).', '');
    End;
  End;

  inherited;
  strCodBco := LeftStr(strNomBanco,3);

  pHabilitaSelecao(fValidaDiretorio);
end;

function TfrmRetBco.PossuiOcoConfigurada(ACodigoBanco: String; ACarteira: Integer; ACodigoOco: String): Boolean;
Var
  objCnfOco: TCnfOco;
  objCnfDao: TCnfOcoDao;
  LOcoBco: String;
  LOcoLay: String;
  LNumPos: String;
  LOcoEsp: String;
  LOcoEmp: String;
begin
  Result := False;

  If (ACarteira > -1) Then
  Begin
    pDesmembraCarteira('CONFIG' + ACodigoBanco + '-' + IntToStr(ACarteira) + '-' +
                VS_strCodEmp, LOcoBco, LOcoLay, LNumPos, LOcoEsp,
                LOcoEmp, ACarteira);

    objCnfDao := TCnfOcoDao.Create(LOcoBco, LOcoLay, LNumPos,
                  LOcoEsp, LOcoEmp, ACarteira);

    objCnfOco := objCnfDao.fBuscaPorOcorrencia(ACodigoOco);
    If Assigned(objCnfOco) Then
    Begin
      Result := True;

      objCnfOco.Free;
    End
    Else
      Result := False;

    objCnfDao.Free;
  End;
end;

procedure TfrmRetBco.CarregaOcorrenciasProtestoCartorio(ACodigoBanco: String;
  out AOcorrencias: String; ACarteira: Integer = -1);
begin
  AOcorrencias := EmptyStr;

  If Not MatchStr(ACodigoBanco, ['341', '001']) Then
    Exit;

  If ACodigoBanco.Equals('341') Then
  Begin
    If (PossuiOcoConfigurada(ACodigoBanco, ACarteira, '35')) Then
      AOcorrencias := '23_32_33_34_36_'
    Else
      AOcorrencias := '23_32_33_34_35_36_';
  End
  Else If ACodigoBanco.Equals('001') Then
    AOcorrencias := '98_';
end;

procedure TfrmRetBco.edtArqRetornoBcoPropertiesChange(Sender: TObject);
begin
  inherited;
  lstArquivo.Clear;
  lstArquivo.Items.Add(ExtractFileName(edtArqRetornoBco.Text));
  lstArquivo.Selected[0] := True;
  fraPathRetornoBco.edtDirectory.text := ExtractFilePath(edtArqRetornoBco.Text);
end;

procedure TfrmRetBco.fraPathRetornoBcoFocusChanged(Sender: TObject);
begin
  inherited;
  pHabilitaSelecao(fValidaDiretorio);
end;

procedure TfrmRetBco.btnGravarClick(Sender: TObject);
  Var
    frmProcessando: TfrmGravando;
begin
  inherited;
  If Not TryDirectoryExists(fraPathRetornoBco.edtDirectory.text) Then
  Begin
    fMensagem('ATENÇÃO','Caminho não existe!',['&OK']);
    pSetFocus(fraPathRetornoBco.edtDirectory);
    Exit;
  End;

  stlChave.Clear;

  If Not fValidaArquivos Then
  Begin
    fMensagem('ATENÇÃO','Os arquivos selecionados não estão no caminho indicado. Favor verificar!',['&OK']);
    Exit;
  End;

  If lstArquivo.SelCount <= 0 Then
  Begin
    fMensagem('ATENÇÃO','Selecione o arquivo que deseja importar!',['&OK']);
  End
  Else
  Begin
    If fMensagem('ATENÇÃO','Confirma a Importação do Arquivo de Retorno?',['&Sim', '&Não']) = 1 Then
    Begin
      pDeletaCadRecBol;

      If strCodBco = '001' Then
      Begin
        If (strTipGer = 'P') And blnPGG Then
          TfrmGravando.fExecuta(fGeraRetornoBancoBrasilPGGContasPagar, frmProcessando, 'Importando Arquivo de Retorno...')
        Else
          TfrmGravando.fExecuta(fGeraRetornoBcoBrasil, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '041' Then
      Begin

         If strTipGer = 'P' Then
            TfrmGravando.fExecuta(fGeraRetornoBanrisulPagar, frmProcessando, 'Importando Arquivo de Retorno...')
         Else
            TfrmGravando.fExecuta(fGeraRetornoBanrisul, frmProcessando, 'Importando Arquivo de Retorno...');

      End
      Else
      If (strCodBco = '341') or (strCodBco = 'IEP') Then
      Begin
        if strCodBco = 'IEP' then
          strBancoIEPTBSP := 'IEPTB-SP - CENTRAL DE PROTESTO'
        else
          strBancoIEPTBSP := '';

        If strTipGer = 'P' Then
          TfrmGravando.fExecuta(fGeraRetornoBcoItauContasPagar, frmProcessando, 'Importando Arquivo de Retorno...')
        Else
          TfrmGravando.fExecuta(fGeraRetornoBcoItau, frmProcessando, 'Importando Arquivo de Retorno...');

      End
      Else
      If strCodBco = '237' Then
      Begin
        If strTipGer = 'P' Then
          TfrmGravando.fExecuta(fGeraRetornoBradescoPagar, frmProcessando, 'Importando Arquivo de Retorno...')
        else
        begin
          if strNomBanco = '237 - Bradesco_240p_Vendor' then
            TfrmGravando.fExecuta(fGeraRetornoBradescoVendor, frmProcessando, 'Importando Arquivo de Retorno...')
          else
            TfrmGravando.fExecuta(fGeraRetornoBradesco, frmProcessando, 'Importando Arquivo de Retorno...');
        end;
      End
      Else
      If strCodBco = '033' Then
      Begin

        If Pos('Santander',strNomBanco) > 0 Then
        Begin
          If strTipGer = 'P' Then
            TfrmGravando.fExecuta(fGeraRetornoSantanderContasPagar, frmProcessando, 'Importando Arquivo de Retorno...')
          Else
          Begin
           If Pos('240p',strNomBanco) > 0 Then
              TfrmGravando.fExecuta(fGeraRetornoSantander240p, frmProcessando, 'Importando Arquivo de Retorno...')
            Else
              TfrmGravando.fExecuta(fGeraRetornoSantanderBan, frmProcessando, 'Importando Arquivo de Retorno...');
          End;
        End
        Else
          TfrmGravando.fExecuta(fGeraRetornoBcoBanespa, frmProcessando, 'Importando Arquivo de Retorno...');

      End
      Else
      If strCodBco = '021' Then
      Begin

        If strTipGer = 'P' Then
          TfrmGravando.fExecuta(fGeraRetornoBanestesPagar, frmProcessando, 'Importando Arquivo de Retorno...')
        Else
          TfrmGravando.fExecuta(fGeraRetornoBanestes, frmProcessando, 'Importando Arquivo de Retorno...');

      End
      Else
      If strCodBco = '389' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoMercantil, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '399' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoHsbc, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '151' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoNossaCx, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '104' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoCxFederal, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '741' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoRibPreto, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '409' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoUnibanco, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '356' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoReal, frmProcessando, 'Importando Arquivo de Retorno...');
      End
      Else
      If strCodBco = '070' Then
      Begin
        TfrmGravando.fExecuta(fGeraRetornoBRB, frmProcessando, 'Importando Arquivo de Retorno...');
