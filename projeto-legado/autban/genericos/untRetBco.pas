              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '977'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            //strMotoco := '';
            //Alterado conforme Sicredi e Banco Brasil;
            strMotOco := Copy(strLinha,319,02);
            strCarBco := Copy(strLinha,022,03);
            strCusCar := ' ';
            strTarifa := ' ';

            LTarifaTed := 0;

            if Not fCfgSis('ENCBAN', varBoolean) Then
            Begin
              if strCodOco = '28' then
                strCusCar := Copy(strLinha,189,13) //Custos de cartório
              else
                strCusCar := '';
            End;

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              // tratativa para quando for tipo de arquivo = 'DS' porem tem configuração trasnferencia de cob. para simples;
              If VerificaConfigTransfCobrancaSimples Then
              Begin
                 strDesCon := Copy(strLinha,241,13);
                 strJurMor := Copy(strLinha,267,13);
              End
              Else
              Begin
                 strDesCon := '0000000000000';
                 strJurMor := '0000000000000';
              End;
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            blnDescon := (strCodOco = '10') And fConfirmaMotivoOcorrencia('20', strCodMot);
            If blnDescon Then
              strValLan := strValDup;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            fltTarifa := 0;
            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG977-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if ((MatchStr(strCodOco, ['06', '02'])) and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
              strTarifa := Copy(strLinha,176,13);

            //MF: 284336 - 18/05/2023 - INI
            If (strCodOco = '28') and
               (fltTarifa > 0) and
               (fCfgSis('ENCBAN', varBoolean) )  then
            Begin
               strTarifa := Copy(strLinha,176,13);
               strValLan := Copy(strLinha,254,13);
               strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
               strCusCar := Copy(strLinha,189,13)
            End ;
            //MF: 284336 - 18/05/2023 - FIM

            strIofDes := '';
            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG237-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                Begin
                  If (strMotOco = '08') Then
                      strCusCar := Copy(strLinha, 189, 13)
                  Else
                      strCusCar := Copy(strLinha, 176, 13)
                End
                Else
                  strTarifa := Copy(strLinha, 176, 13);

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;

              If  (strCodOco = '06') And (fGetBancoConfig(0, 'CONFIG977-' + IntToStr(intCartei), 'UTILIZA_ALPE', '') = 'S')  Then
              Begin
                strIofDes := Copy(strLinha, 215, 13);
                If (((fStrToFloat(strIofDes)/100)  > 0)) Then
                Begin
                  strDesCon := fStrZero(FloatToStrF((fStrToFloat(strDesCon)/100) + (fStrToFloat(strIofDes)/100), ffFixed, 12,2),13);
                End;

                If Not TryStrToFloat(Copy(strLinha, 189, 13), LTarifaTed) Then
                  LTarifaTed := 0.00
                Else
                  LTarifaTed := LTarifaTed / 100;
              End;

            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco,
                                      strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec,
                                      'CONFIG977-' + IntToStr(intCartei))) Then
            Begin

              // Estorno de duplicata descontada para cobrança simples
              If TransferenciaParaCobrancaSimples Then
              Begin
                // Adicionado o valor da duplicata, pois não vem valor de pagto nesse retorno;
                strValPag := FloatToStr(fStrToFloat(strValDup));
                strTxaDes := strJurMor;
                strIofDes := Copy(strLinha,215,13);
                strJurMor := '';
                //strValPag := FloatToStr(fStrToFloat(strValPag) - (fStrToFloat(strTxaDes) + fStrToFloat(strIofDes)));
                blnDescon := True;
              End;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre, strTarifa,
                           strValLan, strCusCar, strCarBco, strIofDes, strTxaDes,
                           blnDescon, '',        '',        LTarifaTed);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,    strTarifa,
                           strValLan,    strCusCar,    '',           strIofDes,    strTxaDes,
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDupVel,
                                                           strEspDocVel,
                                                           strCodEmpVel,
                                                           strCodCliVel,
                                                           strParcelVel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCliVel),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('LAKE BANK');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoLotus(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strIofDes: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LRegistrosRemovidosDaRetBco: Boolean;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;

    strTarifa: String;
    fltTarifa: Double;

    LTarifaTed: Double;

    strTxaDes: String;

    strTipLay: String;

    function VerificaConfigTransfCobrancaSimples : Boolean;
    Begin

      Result := False;
      If fGetBancoConfig(0,'CONFIG976-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S' Then
         If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
             Result := True;

    End;

    function TransferenciaParaCobrancaSimples : Boolean;
    Begin
      Result := False;
      If fGetBancoConfig(0,'CONFIG976-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S'Then
      Begin
        If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
          Result := Not fEmptyStr(fCampoTabela('CTR_MOVDES', 'CADREC', ['AUTOINCREM'], [strAutoIncremCadRec], False));
      End;
    End;

begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  LRegistrosRemovidosDaRetBco := False;

  blnExiste := False;
  strCartei := 'CONFIG976-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG976-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '237') and ((Copy(strLinha, 077, 03)) <> '399') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Bradesco ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        If fLockBaixaAutomatica(LeftStr(strNomBanco,3),True,False) Then
        Begin
          CloseFile(txtTexto);
          Exit;
        End;

        //Remove registros de importações anteriores da RETBCO e RETMOT
        If Not LRegistrosRemovidosDaRetBco Then
        Begin
          pDeletaArqBco;

          LRegistrosRemovidosDaRetBco := True;
        End;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';
            strTxaDes := '';
            strIofDes := '';


            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '976'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            //strMotoco := '';
            //Alterado conforme Sicredi e Banco Brasil;
            strMotOco := Copy(strLinha,319,02);
            strCarBco := Copy(strLinha,022,03);
            strCusCar := ' ';
            strTarifa := ' ';

            LTarifaTed := 0;

            if Not fCfgSis('ENCBAN', varBoolean) Then
            Begin
              if strCodOco = '28' then
                strCusCar := Copy(strLinha,189,13) //Custos de cartório
              else
                strCusCar := '';
            End;

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              // tratativa para quando for tipo de arquivo = 'DS' porem tem configuração trasnferencia de cob. para simples;
              If VerificaConfigTransfCobrancaSimples Then
              Begin
                 strDesCon := Copy(strLinha,241,13);
                 strJurMor := Copy(strLinha,267,13);
              End
              Else
              Begin
                 strDesCon := '0000000000000';
                 strJurMor := '0000000000000';
              End;
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            blnDescon := (strCodOco = '10') And fConfirmaMotivoOcorrencia('20', strCodMot);
            If blnDescon Then
              strValLan := strValDup;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            fltTarifa := 0;
            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG976-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if ((MatchStr(strCodOco, ['06', '02'])) and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
              strTarifa := Copy(strLinha,176,13);

            //MF: 284336 - 18/05/2023 - INI
            If (strCodOco = '28') and
               (fltTarifa > 0) and
               (fCfgSis('ENCBAN', varBoolean) )  then
            Begin
               strTarifa := Copy(strLinha,176,13);
               strValLan := Copy(strLinha,254,13);
               strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
               strCusCar := Copy(strLinha,189,13)
            End ;
            //MF: 284336 - 18/05/2023 - FIM

            strIofDes := '';
            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG237-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                Begin
                  If (strMotOco = '08') Then
                      strCusCar := Copy(strLinha, 189, 13)
                  Else
                      strCusCar := Copy(strLinha, 176, 13)
                End
                Else
                  strTarifa := Copy(strLinha, 176, 13);

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;

              If  (strCodOco = '06') And (fGetBancoConfig(0, 'CONFIG976-' + IntToStr(intCartei), 'UTILIZA_ALPE', '') = 'S')  Then
              Begin
                strIofDes := Copy(strLinha, 215, 13);
                If (((fStrToFloat(strIofDes)/100)  > 0)) Then
                Begin
                  strDesCon := fStrZero(FloatToStrF((fStrToFloat(strDesCon)/100) + (fStrToFloat(strIofDes)/100), ffFixed, 12,2),13);
                End;

                If Not TryStrToFloat(Copy(strLinha, 189, 13), LTarifaTed) Then
                  LTarifaTed := 0.00
                Else
                  LTarifaTed := LTarifaTed / 100;
              End;

            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco,
                                      strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec,
                                      'CONFIG976-' + IntToStr(intCartei))) Then
            Begin

              // Estorno de duplicata descontada para cobrança simples
              If TransferenciaParaCobrancaSimples Then
              Begin
                // Adicionado o valor da duplicata, pois não vem valor de pagto nesse retorno;
                strValPag := FloatToStr(fStrToFloat(strValDup));
                strTxaDes := strJurMor;
                strIofDes := Copy(strLinha,215,13);
                strJurMor := '';
                //strValPag := FloatToStr(fStrToFloat(strValPag) - (fStrToFloat(strTxaDes) + fStrToFloat(strIofDes)));
                blnDescon := True;
              End;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre, strTarifa,
                           strValLan, strCusCar, strCarBco, strIofDes, strTxaDes,
                           blnDescon, '',        '',        LTarifaTed);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,    strTarifa,
                           strValLan,    strCusCar,    '',           strIofDes,    strTxaDes,
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDupVel,
                                                           strEspDocVel,
                                                           strCodEmpVel,
                                                           strCodCliVel,
                                                           strParcelVel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCliVel),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('LOTUS');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoJPCapital(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strIofDes: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LRegistrosRemovidosDaRetBco: Boolean;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;

    strTarifa: String;
    fltTarifa: Double;

    LTarifaTed: Double;

    strTxaDes: String;

    strTipLay: String;

    function VerificaConfigTransfCobrancaSimples : Boolean;
    Begin

      Result := False;
      If fGetBancoConfig(0,'CONFIG975-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S' Then
         If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
             Result := True;

    End;

    function TransferenciaParaCobrancaSimples : Boolean;
    Begin
      Result := False;
      If fGetBancoConfig(0,'CONFIG975-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S'Then
      Begin
        If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
          Result := Not fEmptyStr(fCampoTabela('CTR_MOVDES', 'CADREC', ['AUTOINCREM'], [strAutoIncremCadRec], False));
      End;
    End;

begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  LRegistrosRemovidosDaRetBco := False;

  blnExiste := False;
  strCartei := 'CONFIG975-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG975-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '237') and ((Copy(strLinha, 077, 03)) <> '399') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Bradesco ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        If fLockBaixaAutomatica(LeftStr(strNomBanco,3),True,False) Then
        Begin
          CloseFile(txtTexto);
          Exit;
        End;

        //Remove registros de importações anteriores da RETBCO e RETMOT
        If Not LRegistrosRemovidosDaRetBco Then
        Begin
          pDeletaArqBco;

          LRegistrosRemovidosDaRetBco := True;
        End;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';
            strTxaDes := '';
            strIofDes := '';


            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '975'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            //strMotoco := '';
            //Alterado conforme Sicredi e Banco Brasil;
            strMotOco := Copy(strLinha,319,02);
            strCarBco := Copy(strLinha,022,03);
            strCusCar := ' ';
            strTarifa := ' ';

            LTarifaTed := 0;

            if Not fCfgSis('ENCBAN', varBoolean) Then
            Begin
              if strCodOco = '28' then
                strCusCar := Copy(strLinha,189,13) //Custos de cartório
              else
                strCusCar := '';
            End;

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              // tratativa para quando for tipo de arquivo = 'DS' porem tem configuração trasnferencia de cob. para simples;
              If VerificaConfigTransfCobrancaSimples Then
              Begin
                 strDesCon := Copy(strLinha,241,13);
                 strJurMor := Copy(strLinha,267,13);
              End
              Else
              Begin
                 strDesCon := '0000000000000';
                 strJurMor := '0000000000000';
              End;
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            blnDescon := (strCodOco = '10') And fConfirmaMotivoOcorrencia('20', strCodMot);
            If blnDescon Then
              strValLan := strValDup;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            fltTarifa := 0;
            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG975-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if ((MatchStr(strCodOco, ['06', '02'])) and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
              strTarifa := Copy(strLinha,176,13);

            //MF: 284336 - 18/05/2023 - INI
            If (strCodOco = '28') and
               (fltTarifa > 0) and
               (fCfgSis('ENCBAN', varBoolean) )  then
            Begin
               strTarifa := Copy(strLinha,176,13);
               strValLan := Copy(strLinha,254,13);
               strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
               strCusCar := Copy(strLinha,189,13)
            End ;
            //MF: 284336 - 18/05/2023 - FIM

            strIofDes := '';
            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG237-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                Begin
                  If (strMotOco = '08') Then
                      strCusCar := Copy(strLinha, 189, 13)
                  Else
                      strCusCar := Copy(strLinha, 176, 13)
                End
                Else
                  strTarifa := Copy(strLinha, 176, 13);

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;

              If  (strCodOco = '06') And (fGetBancoConfig(0, 'CONFIG975-' + IntToStr(intCartei), 'UTILIZA_ALPE', '') = 'S')  Then
              Begin
                strIofDes := Copy(strLinha, 215, 13);
                If (((fStrToFloat(strIofDes)/100)  > 0)) Then
                Begin
                  strDesCon := fStrZero(FloatToStrF((fStrToFloat(strDesCon)/100) + (fStrToFloat(strIofDes)/100), ffFixed, 12,2),13);
                End;

                If Not TryStrToFloat(Copy(strLinha, 189, 13), LTarifaTed) Then
                  LTarifaTed := 0.00
                Else
                  LTarifaTed := LTarifaTed / 100;
              End;

            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco,
                                      strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec,
                                      'CONFIG975-' + IntToStr(intCartei))) Then
            Begin

              // Estorno de duplicata descontada para cobrança simples
              If TransferenciaParaCobrancaSimples Then
              Begin
                // Adicionado o valor da duplicata, pois não vem valor de pagto nesse retorno;
                strValPag := FloatToStr(fStrToFloat(strValDup));
                strTxaDes := strJurMor;
                strIofDes := Copy(strLinha,215,13);
                strJurMor := '';
                //strValPag := FloatToStr(fStrToFloat(strValPag) - (fStrToFloat(strTxaDes) + fStrToFloat(strIofDes)));
                blnDescon := True;
              End;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre, strTarifa,
                           strValLan, strCusCar, strCarBco, strIofDes, strTxaDes,
                           blnDescon, '',        '',        LTarifaTed);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,    strTarifa,
                           strValLan,    strCusCar,    '',           strIofDes,    strTxaDes,
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDupVel,
                                                           strEspDocVel,
                                                           strCodEmpVel,
                                                           strCodCliVel,
                                                           strParcelVel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCliVel),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('JP CAPITAL');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoOlam(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strIofDes: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LRegistrosRemovidosDaRetBco: Boolean;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;

    strTarifa: String;
    fltTarifa: Double;

    LTarifaTed: Double;

    strTxaDes: String;

    strTipLay: String;

    function VerificaConfigTransfCobrancaSimples : Boolean;
    Begin

      Result := False;
      If fGetBancoConfig(0,'CONFIG974-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S' Then
         If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
             Result := True;

    End;

    function TransferenciaParaCobrancaSimples : Boolean;
    Begin
      Result := False;
      If fGetBancoConfig(0,'CONFIG974-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S'Then
      Begin
        If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
          Result := Not fEmptyStr(fCampoTabela('CTR_MOVDES', 'CADREC', ['AUTOINCREM'], [strAutoIncremCadRec], False));
      End;
    End;

begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  LRegistrosRemovidosDaRetBco := False;

  blnExiste := False;
  strCartei := 'CONFIG974-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG974-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '237') and ((Copy(strLinha, 077, 03)) <> '399') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Bradesco ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        If fLockBaixaAutomatica(LeftStr(strNomBanco,3),True,False) Then
        Begin
          CloseFile(txtTexto);
          Exit;
        End;

        //Remove registros de importações anteriores da RETBCO e RETMOT
        If Not LRegistrosRemovidosDaRetBco Then
        Begin
          pDeletaArqBco;

          LRegistrosRemovidosDaRetBco := True;
        End;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';
            strTxaDes := '';
            strIofDes := '';


            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '974'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            //strMotoco := '';
            //Alterado conforme Sicredi e Banco Brasil;
            strMotOco := Copy(strLinha,319,02);
            strCarBco := Copy(strLinha,022,03);
            strCusCar := ' ';
            strTarifa := ' ';

            LTarifaTed := 0;

            if Not fCfgSis('ENCBAN', varBoolean) Then
            Begin
              if strCodOco = '28' then
                strCusCar := Copy(strLinha,189,13) //Custos de cartório
              else
                strCusCar := '';
            End;

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              // tratativa para quando for tipo de arquivo = 'DS' porem tem configuração trasnferencia de cob. para simples;
              If VerificaConfigTransfCobrancaSimples Then
              Begin
                 strDesCon := Copy(strLinha,241,13);
                 strJurMor := Copy(strLinha,267,13);
              End
              Else
              Begin
                 strDesCon := '0000000000000';
                 strJurMor := '0000000000000';
              End;
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            blnDescon := (strCodOco = '10') And fConfirmaMotivoOcorrencia('20', strCodMot);
            If blnDescon Then
              strValLan := strValDup;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            fltTarifa := 0;
            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG974-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if ((MatchStr(strCodOco, ['06', '02'])) and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
              strTarifa := Copy(strLinha,176,13);

            //MF: 284336 - 18/05/2023 - INI
            If (strCodOco = '28') and
               (fltTarifa > 0) and
               (fCfgSis('ENCBAN', varBoolean) )  then
            Begin
               strTarifa := Copy(strLinha,176,13);
               strValLan := Copy(strLinha,254,13);
               strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
               strCusCar := Copy(strLinha,189,13)
            End ;
            //MF: 284336 - 18/05/2023 - FIM

            strIofDes := '';
            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG237-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                Begin
                  If (strMotOco = '08') Then
                      strCusCar := Copy(strLinha, 189, 13)
                  Else
                      strCusCar := Copy(strLinha, 176, 13)
                End
                Else
                  strTarifa := Copy(strLinha, 176, 13);

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;

              If  (strCodOco = '06') And (fGetBancoConfig(0, 'CONFIG974-' + IntToStr(intCartei), 'UTILIZA_ALPE', '') = 'S')  Then
              Begin
                strIofDes := Copy(strLinha, 215, 13);
                If (((fStrToFloat(strIofDes)/100)  > 0)) Then
                Begin
                  strDesCon := fStrZero(FloatToStrF((fStrToFloat(strDesCon)/100) + (fStrToFloat(strIofDes)/100), ffFixed, 12,2),13);
                End;

                If Not TryStrToFloat(Copy(strLinha, 189, 13), LTarifaTed) Then
                  LTarifaTed := 0.00
                Else
                  LTarifaTed := LTarifaTed / 100;
              End;

            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco,
                                      strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec,
                                      'CONFIG974-' + IntToStr(intCartei))) Then
            Begin

              // Estorno de duplicata descontada para cobrança simples
              If TransferenciaParaCobrancaSimples Then
              Begin
                // Adicionado o valor da duplicata, pois não vem valor de pagto nesse retorno;
                strValPag := FloatToStr(fStrToFloat(strValDup));
                strTxaDes := strJurMor;
                strIofDes := Copy(strLinha,215,13);
                strJurMor := '';
                //strValPag := FloatToStr(fStrToFloat(strValPag) - (fStrToFloat(strTxaDes) + fStrToFloat(strIofDes)));
                blnDescon := True;
              End;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre, strTarifa,
                           strValLan, strCusCar, strCarBco, strIofDes, strTxaDes,
                           blnDescon, '',        '',        LTarifaTed);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,    strTarifa,
                           strValLan,    strCusCar,    '',           strIofDes,    strTxaDes,
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDupVel,
                                                           strEspDocVel,
                                                           strCodEmpVel,
                                                           strCodCliVel,
                                                           strParcelVel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCliVel),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('OLAM');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBelaVista(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strIofDes: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LRegistrosRemovidosDaRetBco: Boolean;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;

    strTarifa: String;
    fltTarifa: Double;

    LTarifaTed: Double;

    strTxaDes: String;

    strTipLay: String;

    function VerificaConfigTransfCobrancaSimples : Boolean;
    Begin

      Result := False;
      If fGetBancoConfig(0,'CONFIG973-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S' Then
         If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
             Result := True;

    End;

    function TransferenciaParaCobrancaSimples : Boolean;
    Begin
      Result := False;
      If fGetBancoConfig(0,'CONFIG973-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S'Then
      Begin
        If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
          Result := Not fEmptyStr(fCampoTabela('CTR_MOVDES', 'CADREC', ['AUTOINCREM'], [strAutoIncremCadRec], False));
      End;
    End;

begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  LRegistrosRemovidosDaRetBco := False;

  blnExiste := False;
  strCartei := 'CONFIG973-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG973-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '237') and ((Copy(strLinha, 077, 03)) <> '399') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco Bradesco ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        If fLockBaixaAutomatica(LeftStr(strNomBanco,3),True,False) Then
        Begin
          CloseFile(txtTexto);
          Exit;
        End;

        //Remove registros de importações anteriores da RETBCO e RETMOT
        If Not LRegistrosRemovidosDaRetBco Then
        Begin
          pDeletaArqBco;

          LRegistrosRemovidosDaRetBco := True;
        End;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';
            strTxaDes := '';
            strIofDes := '';


            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

            strDtaPag := fStrZero('0',6);
            If (fStrToFloat(strValPag)/100) > 0 Then
            Begin
              strDtaPag := Copy(strLinha,111,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            strDtaCre := Copy(strLinha, 296,06);
            If Not fEmptyStr(strDtaCre) And (strDtaCre <> '000000') Then
            Begin
              System.Insert('/',strDtaCre,3);
              System.Insert('/',strDtaCre,6);
            End;

            if strUtilizaDtaCre = 'N' Then
              strDtaCre := '';

            strValDup := Copy(strLinha,153,13);
            strValLan := '';

            strCodBco := '973'; //Copy(strLinha,166,03);
            strCodOco := Copy(strLinha,109,02);
            strNosNum := Copy(strLinha,071,12);
            strCodRej := '';
            strCodMot := Copy(strLinha,319,10);
            //strMotoco := '';
            //Alterado conforme Sicredi e Banco Brasil;
            strMotOco := Copy(strLinha,319,02);
            strCarBco := Copy(strLinha,022,03);
            strCusCar := ' ';
            strTarifa := ' ';

            LTarifaTed := 0;

            if Not fCfgSis('ENCBAN', varBoolean) Then
            Begin
              if strCodOco = '28' then
                strCusCar := Copy(strLinha,189,13) //Custos de cartório
              else
                strCusCar := '';
            End;

            //Altera data de ocorrência no cado de Ocorrência  = 15
            If (strCodOco = '15') and (strUtilizaDtaCre = 'N') Then
            Begin
              strDtaOco := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
              Begin
                System.Insert('/',strDtaOco,3);
                System.Insert('/',strDtaOco,6);
              End;

              strDtaPag := Copy(strLinha,296,06);
              If Not fEmptyStr(strDtaPag) And (strDtaPag <> '000000') Then
              Begin
                System.Insert('/',strDtaPag,3);
                System.Insert('/',strDtaPag,6);
              End;
            End;

            {********************}
            {* RETORNO DESCONTO *}
            {*****************LB*}
            If strVerNomArq = 'DS' Then
            Begin
              // tratativa para quando for tipo de arquivo = 'DS' porem tem configuração trasnferencia de cob. para simples;
              If VerificaConfigTransfCobrancaSimples Then
              Begin
                 strDesCon := Copy(strLinha,241,13);
                 strJurMor := Copy(strLinha,267,13);
              End
              Else
              Begin
                 strDesCon := '0000000000000';
                 strJurMor := '0000000000000';
              End;
            End
            {*******************}
            {* RETORNO SIMPLES *}
            {****************LB*}
            Else
            Begin
              strDesCon := Copy(strLinha,241,13);
              strJurMor := Copy(strLinha,267,13);
            End;

            blnDescon := (strCodOco = '10') And fConfirmaMotivoOcorrencia('20', strCodMot);
            If blnDescon Then
              strValLan := strValDup;

            strCodBcoReceb := Copy(strLinha,166,03);
            strAgeReceb    := Copy(strLinha,169,05);

            fltTarifa := 0;
            if fCfgSis('ENCBAN', varBoolean) then
              fltTarifa := fStrToFloat(fGetBancoConfig(0, 'CONFIG973-' + IntToStr(intCartei), 'VALOTAR', '0'));

            if ((MatchStr(strCodOco, ['06', '02'])) and (fltTarifa > 0) and (fCfgSis('ENCBAN', varBoolean)))  then
              strTarifa := Copy(strLinha,176,13);

            //MF: 284336 - 18/05/2023 - INI
            If (strCodOco = '28') and
               (fltTarifa > 0) and
               (fCfgSis('ENCBAN', varBoolean) )  then
            Begin
               strTarifa := Copy(strLinha,176,13);
               strValLan := Copy(strLinha,254,13);
               strValPag := FloatToStr(fStrToFloat(strValLan) - fStrToFloat(strTarifa));
               strCusCar := Copy(strLinha,189,13)
            End ;
            //MF: 284336 - 18/05/2023 - FIM

            strIofDes := '';
            // Lançamentos para tarifas auxiliares da duplicata(Baixa Simples, Cartório...)
            If fCfgSis('ENCBAN', varBoolean) Then
            Begin
              pDesmembraCarteira('CONFIG237-' + IntToStr(intCartei) + '-' +
                VS_strCodEmp, strOcoBco, strOcoLay, strNumPos, strOcoEsp,
                strOcoEmp, intOcoCar);

              objCnfDao := TCnfOcoDao.Create(strOcoBco, strOcoLay, strNumPos,
                strOcoEsp, strOcoEmp, intOcoCar);

              objCnfOco := objCnfDao.fBuscaPorOcorrencia(strCodOco);
              If Assigned(objCnfOco) Then
              Begin
                If objCnfOco.blnCusCar Then
                Begin
                  If (strMotOco = '08') Then
                      strCusCar := Copy(strLinha, 189, 13)
                  Else
                      strCusCar := Copy(strLinha, 176, 13)
                End
                Else
                  strTarifa := Copy(strLinha, 176, 13);

                strValPag := '0000000000000';

                objCnfOco.Free;

              End;

              objCnfDao.Free;

              If  (strCodOco = '06') And (fGetBancoConfig(0, 'CONFIG973-' + IntToStr(intCartei), 'UTILIZA_ALPE', '') = 'S')  Then
              Begin
                strIofDes := Copy(strLinha, 215, 13);
                If (((fStrToFloat(strIofDes)/100)  > 0)) Then
                Begin
                  strDesCon := fStrZero(FloatToStrF((fStrToFloat(strDesCon)/100) + (fStrToFloat(strIofDes)/100), ffFixed, 12,2),13);
                End;

                If Not TryStrToFloat(Copy(strLinha, 189, 13), LTarifaTed) Then
                  LTarifaTed := 0.00
                Else
                  LTarifaTed := LTarifaTed / 100;
              End;

            End;

            {********************************************}
            {* VERIFICA SE A DUPLICATA EXISTE NO CADREC *}
            {*****************************************LB*}
            {********************************************}
            {* VERIFICA O FORMATO NOVO E VELHO DO AUTCOM*}
            {* OBS: FOI FEITO USANDO O LAYOUT DA GUAÇU  *}
            {***xx/xx/xxxx****************************MV*}
            If (fVerificaExisteDuplic(strNumDup,strParcel,strEspDoc,strCodEmp,strCodCli,strNosNum,strCodBco,
                                      strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec,
                                      'CONFIG973-' + IntToStr(intCartei))) Then
            Begin

              // Estorno de duplicata descontada para cobrança simples
              If TransferenciaParaCobrancaSimples Then
              Begin
                // Adicionado o valor da duplicata, pois não vem valor de pagto nesse retorno;
                strValPag := FloatToStr(fStrToFloat(strValDup));
                strTxaDes := strJurMor;
                strIofDes := Copy(strLinha,215,13);
                strJurMor := '';
                //strValPag := FloatToStr(fStrToFloat(strValPag) - (fStrToFloat(strTxaDes) + fStrToFloat(strIofDes)));
                blnDescon := True;
              End;

              If (strCodOco = '03') Then
                pGravaRetMot(strCodBco, strNumDup, strParcel, strEspDoc, strCodCli,
                             strCodEmp, strCodMot, strCodOco);

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcel, strNumDup, strCodCli, strCodEmp, strEspDoc,
                           strDtaOco, strDtaVen, strDtaPag, strNomArq, strDesCon,
                           strValDup, strValPag, strJurMor, '',        strCodBco,
                           strCodOco, strNosNum, strCodRej, strMotOco, dtaDtaArq,
                           False,     '',        '',        strDtaCre, strTarifa,
                           strValLan, strCusCar, strCarBco, strIofDes, strTxaDes,
                           blnDescon, '',        '',        LTarifaTed);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDup,
                                                           strEspDoc,
                                                           strCodEmp,
                                                           strCodCli,
                                                           strParcel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCli),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else If (fVerificaExisteDuplic(strNumDupVel,strParcelVel,strEspDocVel,strCodEmpVel,strCodCliVel,strNosNum,strCodBco, strTipCob, intQtdDup, strAutoIncremCadRec, strCarteiraCadRec)) Then
            Begin

              If fVerificaNosNumDuplicado(strNosNum, strCodBco, strCodEmp, strCarteiraCadRec, intQtdDup, strAutoIncremCadRec) Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDup + '-' +
                                                      strEspDoc + '-' +
                                                      strCodEmp +
                                                      ' Cliente: ' + strCodCli +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else If intQtdDup > 1 Then
              Begin
                lstArqNaoGravados.Add('Duplicata: ' + strNumDupVel + '-' +
                                                      strEspDocVel + '-' +
                                                      strCodEmpVel +
                                                      ' Cliente: ' + strCodCliVel +
                                                      ' Nosso Número: ' + strNosNum);
              End
              Else
              Begin
                pGravaArqBco(strParcelVel, strNumDupVel, strCodCliVel, strCodEmpVel, strEspDocVel,
                           strDtaOco,    strDtaVen,    strDtaPag,    strNomArq,    strDesCon,
                           strValDup,    strValPag,    strJurMor,    '',           strCodBco,
                           strCodOco,    strNosNum,    strCodRej,    strMotOco,    dtaDtaArq,
                           False,        '',           '',           strDtaCre,    strTarifa,
                           strValLan,    strCusCar,    '',           strIofDes,    strTxaDes,
                           blnDescon);

                pGravaLogCtr(strCodBco, strAutoIncremCadRec);

                If fCfgSis('UTICRM', varBoolean) And (Not fEmptyStr(fCfgSis('OCOFIN', varString)))  Then
                Begin
                  TAtuOcoCrm.pAtualizaOcorrenciaFinanceiro(strNumDupVel,
                                                           strEspDocVel,
                                                           strCodEmpVel,
                                                           strCodCliVel,
                                                           strParcelVel,
                                                           strLoginUsuarioLogado,
                                                           fRetCgcCpf(strCodCliVel),
                                                           afcImportaRetornoBancario);
                End;

                blnExiste := True;
              End;
            End
            Else
            Begin
              pIncluiOcor(strNosNum, strCodCli, strNumDup + strParcel, strEspDoc, strCodEmp,
                          StrToDateDef(strDtaVen, 0), StrToDateDef(strDtaPag, 0),
                          fStrToFloat(strValDup)/100, fStrToFloat(strValPag)/100);
            End;

            inc( intAplica );

            If ( intAplica Mod 10 ) = 0 Then
              Application.ProcessMessages;

            {*****************************}
            {* GRAVAÇÃO DA TABELA REMGER *}
            {** DADOS GERAIS DA REMESSA **}
            {**************************MO*}

            //GRAVA SOMENTE UMA VEZ
            if intContGeral = 0 then
            begin
              pGravaRetGer(VS_strCodEmp, strCodBco, StrCartei, strNomArq, 0, blnAtualizaRet, strAutoIncremRet);
              Inc(intContGeral);
            end;

            {*****************************}
            {* GRAVAÇÃO DA TABELA RETDET *}
            {**** DETALHES DA RETORNO ****}
            {**************************MO*}
            pGravaRetDet(strAutoIncremRet,
                         strAutoIncremCadRec,
                         strNosNum,
                         fStrToFloat(strValPag)/100,
                         fStrtoFloat(strJurMor)/100,
                         fStrtoFloat(strDescon)/100,
                         0,
                         StrToDateDef(strDtaPag, 0),
                         strCodBcoReceb,
                         strAgeReceb,
                         dtaDtaArqRet,
                         strLoginUsuarioLogado,
                         '',
                         strCodOco,
                         blnAtualizaRet);
            blnAtualizaRet := False;
          End;

        End;// fim do while

        CloseFile(txtTexto);

        If Not cdsNaoGra.IsEmpty Then
          pMostraArqNaoBaixa('BELA VISTA');

        pMostraDupNaoBaixa(lstArqNaoGravados);

        If Not blnExiste Then
        Begin
          If fMensagem('ALERTA','Não foi encontrada nenhuma duplicata referente ao Arquivo de Retorno! ' +
          'Manter em aberto para análise ou Apagar o arquivo "' + lstArquivo.Items.Strings[intContador] + '" da pasta?', ['&Análise', 'A&pagar']) = 2 Then
            DeleteFile(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

          Continue;
        End;

        strNomArq := fraPathRetornoBco.edtDirectory.text + '\' + strNomArq;
        If Not fRenomeiaArquivo(strNomArq) Then
        Begin
          Exit;
        End;

        fMensagem('','Arquivo de retorno importado com sucesso!',['&OK']);

      End;// Fim do If
    End;// fim do For

  Except
    On E: Exception Do
    Begin
      pMensagensErro('Ocorreu um erro na gravação dos arquivos!' + E.Message ,'[Gravação do Arquivo de Retorno]');
    End;
  End;

  frmRetBco.Close;

end;

function TfrmRetBco.fGeraRetornoBMPMoneyPlus_LP_444p(cxgProgresso: TcxProgressBar): Boolean;
  Var
    txtTexto    : TextFile;
    intContador : Integer;
    blnExiste: Boolean;
    strVerNomArq: String;
    strLinha : String;
    strParcel: String;
    strNumCtr: String;
    strDtaOco: String;
    strDtaVen: String;
    strDtaPag: String;
    strNumDup: String;
    strCodCli: String;
    strCodEmp: String;
    strEspDoc: String;
    strNomArq: String;
    strCodBco: String;
    strDesCon: String;
    strCodOco: String;
    strValDup: String;
    strValPag: String;
    strIofDes: String;
    strValLan: String;
    strJurMor: String;
    strNosNum: String;
    strCodRej: String;
    strMotOco: String;
    strCodMot: String;
    intAplica: Integer;
    dtaDtaArq: TDateTime;
    intQtdDup: Integer;
    strDtaArqRet: String;
    dtaDtaArqRet: TDateTime;

    strNumDupVel: String;
    strParcelVel: String;
    strEspDocVel: String;
    strCodEmpVel: String;
    strCodCliVel: String;

    strAutoIncremRet: String;
    strCodBcoReceb: String;
    strAgeReceb: String;
    strCusCar: String;
    strUtilizaDtaCre,
    strDtaCre: String;
    strCarBco: String;
    blnDescon: Boolean;

    intContGeral: Integer;
    intIndex: Integer;
    intLinha : Integer;
    intLinhas: Integer;

    LRegistrosRemovidosDaRetBco: Boolean;

    objCnfOco: TCnfOco;
    objCnfDao: TCnfOcoDao;
    strOcoBco: String;
    strOcoLay: String;
    strNumPos: String;
    strOcoEsp: String;
    strOcoEmp: String;
    intOcoCar: Integer;

    strTarifa: String;
    fltTarifa: Double;

    LTarifaTed: Double;

    strTxaDes: String;

    strTipLay: String;

    {function VerificaConfigTransfCobrancaSimples : Boolean;
    Begin

      Result := False;
      If fGetBancoConfig(0,'CONFIG274-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S' Then
         If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
             Result := True;

    End;

    function TransferenciaParaCobrancaSimples : Boolean;
    Begin
      Result := False;
      If fGetBancoConfig(0,'CONFIG274-' + IntToStr(intCartei),'UTLDESDUP', 'N') = 'S'Then
      Begin
        If (strCodOco = '09') And fConfirmaMotivoOcorrencia('10', strCodMot) Then
          Result := Not fEmptyStr(fCampoTabela('CTR_MOVDES', 'CADREC', ['AUTOINCREM'], [strAutoIncremCadRec], False));
      End;
    End;}

begin
  intContGeral := 0;
  dtaDtaArqRet := 0;
  pnlInfo.Repaint;

  fAbrirTabela(frmModuloRetBco.qryRetBco);

  LRegistrosRemovidosDaRetBco := False;

  blnExiste := False;
  strCartei := 'CONFIG274LP400p-' + IntToStr(intCartei) + '-' + VS_strCodEmp;

  strUtilizaDtaCre := fGetBancoConfig(0,'CONFIG274LP400p-' + IntToStr(intCartei),'DTACRED', 'N');
  Try
    For   intContador := 0 To lstArquivo.Count-1 Do
    Begin

      If lstArquivo.Selected[intContador] Then
      Begin
        {************************}
        {* PEGA DATA DO ARQUIVO *}
        {*********************AF*}
        FileAge(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador], dtaDtaArq);

        AssignFile(txtTexto,fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);
        Reset(txtTexto);
        Readln(txtTexto,strLinha);

        intLinhas := fContaLinhasArq(fraPathRetornoBco.edtDirectory.text + '\' + lstArquivo.Items.Strings[intContador]);

        If ((Copy(strLinha, 077, 03)) <> '274') Then
        Begin
          fMensagem('', 'Não é um arquivo de retorno do Banco BMP Money Plus ou o conteúdo do arquivo não corresponde ao layout.', ['&OK']);
          CloseFile(txtTexto);
          Exit;
        End;
        strDtaArqRet := Copy(strLinha, 095, 6);
        strDtaArqRet := Copy(strDtaArqRet, 1, 2) + '/' + Copy(strDtaArqRet, 3, 2) + '/' + Copy(strDtaArqRet, 5, Length(strDtaArqRet) );
        If fEmptyStr(AnsiReplaceStr(strDtaArqRet, '/', '')) Or (Not fValidaDataStr(strDtaArqRet)) Then
        Begin
          fMensagem('ALERTA','O conteúdo do arquivo não corresponde ao layout do banco ou o arquivo está corrompido.',['&OK']);
          CloseFile(txtTexto);
          Exit;
        End
        Else dtaDtaArqRet := StrToDateTime(strDtaArqRet);

        intAplica := 0;

        If fRetornoDuplicado(lstArquivo.Items.Strings[intContador], strCartei) then
        begin
          if fMensagem('', 'Já existe um arquivo de retorno importado para essa carteira com o mesmo nome' +
                           '. Deseja sobrescreve-lo?', ['&Sim', '&Não']) = 1 Then
          begin
            blnAtualizaRet := True;
          end
          else
          begin
            blnAtualizaRet := False;
            CloseFile(txtTexto);
            Exit;
          end;
        end;

        If fLockBaixaAutomatica(LeftStr(strNomBanco,3),True,False) Then
        Begin
          CloseFile(txtTexto);
          Exit;
        End;

        //Remove registros de importações anteriores da RETBCO e RETMOT
        If Not LRegistrosRemovidosDaRetBco Then
        Begin
          pDeletaArqBco;

          LRegistrosRemovidosDaRetBco := True;
        End;

        intLinha := 0;

        While Not Eof(txtTexto) Do
        Begin
          Readln(txtTexto,strLinha);

          pProgresso(fInc(intLinha), intLinhas -1, cxgProgresso);

          If (Copy(strLinha, 1, 1) = '9') Or
             (fEmptyStr(Trim(strLinha)))  Then
            Continue;
          {*****************************************}
          {* VERIFICA SE FOR ULTIMA LINHA ELE PULA *}
          {**************************************LB*}
          If Eof(txtTexto) Then
            Continue;

          If Copy(strLinha, 1, 1) = '1' Then
          Begin
            {*************************************************}
            {* ATRIBUI OS CAMPOS DO TXT NA STRING RESPECTIVA *}
            {**********************************************LB*}
            strNomArq := lstArquivo.Items.Strings[intContador];
            strVerNomArq := UpperCase(LeftStr(strNomArq,2));
            strNumCtr := Copy(strLinha,038,25);

            strNumDup := '';
            strParcel := '';
            strEspDoc := '';
            strCodEmp := '';
            strCodCli := '';
            strTxaDes := '';
            strIofDes := '';


            {********************************************************************************************}
            {* SE A 6ª E A 7ª POSIÇÃO DA CHAVE FOR NÚMERO, TRATAMOS AS CHAVES COM NUMDUP DE 12 DIGITOS. *}
            {* CASO CONTRÁRIO O NUMDUP TERÁ 6 DIGITOS, OU SEJA, A 7ª POSIÇÃO SERÁ A PARCELA  ************}
            {*****************************************************************************************MO*}
            if EhNumero(Copy(strNumCtr,006,02)) then
            begin
              //duplicata com 12 digitos / parcela com 3 digitos / sem enviar o cliente
              If (Length(Trim(strNumCtr)) = 20) then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Trim(Copy(strNumCtr,013,03));
                strEspDoc := Copy(strNumCtr,016,02);
                strCodEmp := fStrZero(Copy(strNumCtr,018,03),3);
                strCodCli := '';
              End
              //duplicata com 12 digitos / parcela com um digitos / com cód. cliente
              Else If Length(Trim(strNumCtr)) = 25 Then
              Begin
                strNumDup := fStrZero(Copy(strNumCtr,001,12),12);
                strParcel := Copy(strNumCtr,013,01);
                strEspDoc := TEspecieParaArquivoRemessa.New.fRetornaEspecieDoIndice(Copy(strNumCtr,014,01));
                strCodEmp := fStrZero(Copy(strNumCtr,015,03),3);
                strCodCli := fStrZero(Copy(strNumCtr,018,08),8);
              End;
            end
            Else
            Begin
              //duplicata com 6 digitos / parcela com uma letra / com cod. cliente
              strNumDup := Trim(Copy(strNumCtr,001,06));
              strParcel := Copy(strNumCtr,007,01);
              strEspDoc := Copy(strNumCtr,008,02);
              strCodEmp := fStrZero(Copy(strNumCtr,010,03),3);
              strCodCli := fStrZero(Copy(strNumCtr,013,08),8);
            End;

            pDadosDuplicataVel(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
              strCodEmpVel, strCodCliVel);

            If fEmptyStr(strEspDocVel) And fEmptyStr(strCodEmpVel) Then
            Begin
              pDadosDuplicataOutros(strNumCtr, strNumDupVel, strParcelVel, strEspDocVel,
                strCodEmpVel, strCodCliVel);

              If Not fEmptyStr(strCodCliVel) Then
              Begin
                strNumDup := strNumDupVel;
                strParcel := strParcelVel;
                strEspDoc := strEspDocVel;
                strCodEmp := strCodEmpVel;
                strCodCli := strCodCliVel;
              End;

            End;

            strDtaOco := Copy(strLinha,111,06);
            If Not fEmptyStr(strDtaOco) And (strDtaOco <> '000000') Then
            Begin
              System.Insert('/',strDtaOco,3);
              System.Insert('/',strDtaOco,6);
            End;

            strDtaVen := Copy(strLinha,147,06);
            If Not fEmptyStr(strDtaVen) And (strDtaVen <> '000000') Then
            Begin
              System.Insert('/',strDtaVen,3);
              System.Insert('/',strDtaVen,6);
            End;

            strValPag := Copy(strLinha,254,13);

